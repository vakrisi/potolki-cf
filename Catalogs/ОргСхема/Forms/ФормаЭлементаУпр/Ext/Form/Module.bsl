	//|				ГДЕ
	//|					НЕ Пользователи.<ФизЛицо> ЕСТЬ NULL )";
	//
	//Запрос.Текст = СтрЗаменить(Запрос.Текст, "<ФизЛицо>", ТекстФизЛицо);
