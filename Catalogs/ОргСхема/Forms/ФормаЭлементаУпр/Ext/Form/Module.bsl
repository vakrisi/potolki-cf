	АдресКартинки = ПолучитьНавигационнуюСсылку(ТекущийОбъект.Ссылка, "Логотип");	
	
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Объект.Ссылка.Пустая() Тогда
		Параметры.Свойство("Родитель",Объект.Родитель);
		Параметры.Свойство("ТипТерминала",Объект.ТипТерминала);
	КонецЕсли;
	//
	Если Объект.Ссылка.Пустая() Тогда
		ПолеЦвет = Новый Цвет(255,255,255);
		ЦветИзменен = истина;
	Иначе
		Спр = РеквизитФормыВЗначение("Объект");
		ПолеЦвет  = Спр.ЦветФона.Получить();
		ПолеШрифт = Спр.Шрифт.Получить();
	КонецЕсли;
	АдресКартинки = ПолучитьНавигационнуюСсылку(Объект.Ссылка, "Логотип");
	
	// 
	
	Для каждого стр из Объект.Сотрудники Цикл
		Новстр = ТЗ_Сотрудники.Добавить();
		Новстр.ФизЛицо = стр.ФизЛицо;
		
		детали = ЕстьФотоПользователь(стр.ФизЛицо);
		ЗаполнитьЗначенияСвойств(Новстр, детали);
	КонецЦикла;
	
	ИА_КСУОбщийСервер.СделатьКнопкуОсновной(Элементы.ГруппаКП);
	
	Если Объект.ТипТерминала = ПредопределенноеЗначение("Перечисление.ТипТерминалаОргСхемы.Секция") или Объект.ТипТерминала = ПредопределенноеЗначение("Перечисление.ТипТерминалаОргСхемы.Отдел") тогда
		Элементы.НаименованиеДолжности.Видимость = Истина;
	Иначе
		Элементы.НаименованиеДолжности.Видимость = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ЕстьФотоПользователь(ФизЛицо)
	Рез = Новый Структура("ЕстьПользователь,ЕстьФото", ложь, ложь);
	
	мен = РегистрыСведений.ИА_ДанныеФизЛиц.СоздатьМенеджерЗаписи();
	мен.ФизЛицо = ФизЛицо;
	мен.Прочитать();
	Если мен.Выбран() Тогда
		Рез.ЕстьПользователь = не мен.Пользователь.Пустая();
		Рез.ЕстьФото = мен.Фото.Получить() <> Неопределено;
	КонецЕсли;
	
	возврат рез;
КонецФункции

&НаСервере
Процедура УстановитьШиринуИЦвет()
	об = РеквизитФормыВЗначение("Объект");
	Белый = Новый Цвет(255,255,255);
	
	Если об.Ширина = 0 Тогда
		об.Ширина = 40;
	КонецЕсли;
	
	Если (не об.Родитель.Пустая()) и (об.ТипТерминала = Перечисления.ТипТерминалаОргСхемы.Секция ИЛИ об.ТипТерминала = Перечисления.ТипТерминалаОргСхемы.Сектор или об.ТипТерминала = Перечисления.ТипТерминалаОргСхемы.Сотрудник
		или об.ТипТерминала = Перечисления.ТипТерминалаОргСхемы.Отдел) Тогда
		
		Если об.ТипТерминала = Перечисления.ТипТерминалаОргСхемы.Секция ИЛИ об.ТипТерминала = Перечисления.ТипТерминалаОргСхемы.Сектор или об.ТипТерминала = Перечисления.ТипТерминалаОргСхемы.Сотрудник тогда
			об.Ширина = об.Родитель.Ширина;
		КонецЕсли;
		
		ЦвРод = об.Родитель.ЦветФона.Получить();
		Если ЦвРод = Неопределено Тогда
			ЦвРод = Белый;
		КонецЕсли;
		об.ЦветФона = Новый ХранилищеЗначения(ЦвРод);
		ПолеЦвет  = ЦвРод;
		ЦветИзменен = Истина;
		Модифицированность = Истина;
	КонецЕсли;
	
	Если об.ЦветФона.Получить() = Неопределено Тогда
		об.ЦветФона = Новый ХранилищеЗначения(Белый);
		ПолеЦвет  = Белый;
		ЦветИзменен = Истина;
		Модифицированность = Истина;
	КонецЕсли;
	
	ЗначениеВРеквизитФормы(об, "Объект");
КонецПроцедуры

&НаКлиенте
Процедура ПрименитьОформление(Команда)
	
	парам = Новый Структура("Родитель", Объект.Ссылка);
	ОпОп = Новый ОписаниеОповещения("ПрименитьОформлениеОбработчик", ЭтаФорма);
	ОткрытьФорму("Справочник.ОргСхема.Форма.ФормаОформленияУпр",парам,ЭтаФорма,,,,опОп);
	
КонецПроцедуры

&НаКлиенте
Процедура ПрименитьОформлениеОбработчик(Рез,ДопПарам) Экспорт
	Если ТипЗнч(рез) = тип("Структура") Тогда
		Записать(); // записываем т.к. дочерние объекты могут изменить этот и потом мы пересчитываем объект
		ПрименитьОформлениеНаСервере(рез.Родитель, рез.флЦвет, рез.флШрифт, рез.флШирина, рез.флВысота);
		Прочитать();
		Оповестить("ИзменениеОС", Объект.Ссылка);
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ПрименитьОформлениеНаСервере(ЭлРодитель, Цвет, Шрифт, Ширина, Высота)
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ОргСхема.Ссылка
	|ИЗ
	|	Справочник.ОргСхема КАК ОргСхема
	|ГДЕ
	|	ОргСхема.Ссылка В ИЕРАРХИИ(&Родитель)
	|	И ОргСхема.Ссылка <> &Ссылка
	|	И ОргСхема.Ссылка <> &Родитель";
	Запрос.УстановитьПараметр("Родитель", ЭлРодитель);
	Запрос.УстановитьПараметр("Ссылка", Объект.Ссылка);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Об = Выборка.Ссылка.ПолучитьОБъект();
		
		Если Ширина Тогда
			об.Ширина = Объект.Ширина;
		КонецЕсли;
		
		Если Высота Тогда
			об.Высота = Объект.Высота;
		КонецЕсли;
		
		Если Шрифт Тогда
			об.Шрифт = Новый ХранилищеЗначения(ПолеШрифт);
		КонецЕсли;
		
		Если Цвет Тогда
			об.ЦветФона = Новый ХранилищеЗначения(ПолеЦвет);
		КонецЕсли;
		
		об.Записать();
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)	
	Объект.Наименование = СтрЗаменить(Объект.НаименованиеДляОргсхемы, Символы.ПС , " ");
	Если Модифицированность Тогда
		Модиф = истина;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НастройкаСтатистикНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	//
	фв = ПолучитьФорму("Справочник.ИА_НастройкиРабочегоСтолаСтатистик.ФормаВыбора");
	фв.Служебные = истина;
	
	Если фв.Список.Отбор.Элементы.Количество() > 0 Тогда
		ЭлементыОтбора = фв.Список.Отбор.Элементы;
	Иначе
		ЭлементыОтбора = фв.Список.КомпоновщикНастроек.ПользовательскиеНастройки.Элементы[0].Элементы;
	КонецЕсли;
	
	Для каждого стр из ЭлементыОтбора Цикл
		Если ТипЗнч(стр) = Тип("ЭлементОтбораКомпоновкиДанных") Тогда
			Если строка(стр.ЛевоеЗначение) = "СлужебнаяНастройка" Тогда
				стр.ПравоеЗначение = Истина;
				Прервать;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	выбЗн = фв.ОткрытьМодально();
	Если ЗначениеЗаполнено(выбЗн) Тогда
		Объект.НастройкаСтатистик = выбЗн;
		Модифицированность = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НастройкаСтатистикОткрытие(Элемент, СтандартнаяОбработка)
	Если Объект.НастройкаСтатистик.Пустая() Тогда
		СтандартнаяОбработка = Ложь;
		
		ф = ПолучитьФорму("Справочник.ИА_НастройкиРабочегоСтолаСтатистик.ФормаОбъекта");
		ф.Объект.СлужебнаяНастройка = Истина;
		ф.ОткрытьМодально();
		
		Если не ф.Объект.Ссылка.Пустая() Тогда
			НастройкаСтатистик = ф.Объект.Ссылка;
			Записать();
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТипТерминалаПриИзменении(Элемент)
	Если Элемент <> Неопределено Тогда
		УстановитьШиринуИЦвет();
	КонецЕсли;
	
	Если Объект.ТипТерминала = ПредопределенноеЗначение("Перечисление.ТипТерминалаОргСхемы.Организация") Тогда
		Элементы.АдресКартинки.Видимость = Истина;
		Элементы.Организация.Видимость   = Истина;
		Элементы.Родитель.Видимость      = Ложь;
		Элементы.ПорядокВСхеме.Видимость = Ложь;
		//Элементы.ЭтоВложеннаяОргсхема.Видимость = истина;
	ИначеЕсли Объект.ТипТерминала = ПредопределенноеЗначение("Перечисление.ТипТерминалаОргСхемы.Учредитель") Тогда
		Элементы.ПорядокВСхеме.Видимость = Ложь;
	Иначе
		Элементы.АдресКартинки.Видимость = Ложь;
		Элементы.Организация.Видимость   = Ложь;    
		Элементы.Родитель.Видимость      = истина;
		Элементы.ПорядокВСхеме.Видимость = истина;
		Элементы.ЭтоВложеннаяОргсхема.Видимость = Ложь;
	КонецЕсли;
	
	Элементы.КраткоеНаименование.Видимость = Объект.ТипТерминала = ПредопределенноеЗначение("Перечисление.ТипТерминалаОргСхемы.Департамент") ИЛИ Объект.ТипТерминала = ПредопределенноеЗначение("Перечисление.ТипТерминалаОргСхемы.Отдел");
	Элементы.СсылкаНаВложеннуюОргсхему.Видимость = Объект.ТипТерминала = ПредопределенноеЗначение("Перечисление.ТипТерминалаОргСхемы.Секция");
КонецПроцедуры

&НаКлиенте
Процедура ПолеШрифтПриИзменении(Элемент)
	Модифицированность = Истина;
КонецПроцедуры

&НаКлиенте
Процедура СотрудникиОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	Объект.Сотрудники.Добавить().ФизЛицо = ВыбранноеЗначение;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	// проанализируем ширину подчиненных элементов
	Если Объект.ТипТерминала = ПредопределенноеЗначение("Перечисление.ТипТерминалаОргСхемы.Отдел") ИЛИ Объект.ТипТерминала = ПредопределенноеЗначение("Перечисление.ТипТерминалаОргСхемы.Секция") ИЛИ Объект.ТипТерминала = ПредопределенноеЗначение("Перечисление.ТипТерминалаОргСхемы.Сектор") Тогда
		МассивСсылок = ПолучитьДочерниеЭлементыСДругойШириной(Объект.Ссылка);
		Если МассивСсылок.Количество() > 0 Тогда
			ТекстВорпоса = "Изменить ширину у подчиненнных элементов оргсхемы?";
			ПоказатьВопрос(Новый ОписаниеОповещения("ПослеЗаписиЗавершение", ЭтотОбъект), ТекстВорпоса, РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Да);
            Возврат;
		КонецЕсли;
	КонецЕсли;
	
	// Права на ДИ
	ПослеЗаписиФрагмент();
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписиЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		
		УстановитьШиринуПодчиненныхНаСервере(Объект.Ссылка);
		
	КонецЕсли;
	
	ПослеЗаписиФрагмент();

КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписиФрагмент()
	
	Попытка // возможно нет прав на ДИ
		Выполнить("ИА_ОбщиеПроцедуры_Технология.ПроверитьПраваПоста(Объект.Ссылка)");
