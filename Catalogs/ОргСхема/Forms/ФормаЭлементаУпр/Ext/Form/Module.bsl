Процедура ПользовательФото(Команда)
	тд = Элементы.Сотрудники.ТекущиеДанные;
	Если тд=Неопределено или тд.ФизЛицо.Пустая() Тогда
		возврат;
	КонецЕсли;
	
	ПроверитьЗаписьПоФизЛицу(тд.ФизЛицо);
	
	оповещЗакр = Новый ОписаниеОповещения("ЗакрытиеФизЛицПользФото", ЭтаФорма);

	ЗначениеКлюча = Новый Структура("ФизЛицо", тд.ФизЛицо);
    МассивКл = Новый Массив;
    МассивКл.Добавить(ЗначениеКлюча);
	КлючЗаписи =  Новый("РегистрСведенийКлючЗаписи.ИА_ДанныеФизЛиц", МассивКл);
    ОткрытьФорму( "РегистрСведений.ИА_ДанныеФизЛиц.ФормаЗаписи", Новый Структура("Ключ", КлючЗаписи),,,,,оповещЗакр);
КонецПроцедуры

