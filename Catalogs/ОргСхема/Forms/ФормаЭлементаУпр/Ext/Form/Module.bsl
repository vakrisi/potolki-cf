&НаСервере
Процедура ЗаполнитьНастройкуНаСервере()
	
	Если Объект.Ссылка.Пустая() Тогда
		Записать();
	КонецЕсли;
	
	Если Объект.НастройкаСтатистик.Пустая() Тогда
		
		НастройкаОбъект = Справочники.ИА_НастройкиРабочегоСтолаСтатистик.СоздатьЭлемент();
		НастройкаОбъект.Наименование       = Объект.Наименование;
		НастройкаОбъект.КоличествоВСтроке  = 4;
		НастройкаОбъект.КоличествоПериодов = 6;
		НастройкаОбъект.ОсновнойПериод     = Перечисления.ИА_ПериодыДетализации.Неделя;
		НастройкаОбъект.СлужебнаяНастройка = истина;
		
	Иначе
		
		НастройкаОбъект = Объект.НастройкаСтатистик.ПолучитьОбъект();
		
	КонецЕсли;
	
	НастройкаОбъект.Статистики.Очистить();
	
	Если НастройкаОбъект.ОсновнойПериодДетализации.Пустая() Тогда
		НастройкаОбъект.ОсновнойПериодДетализации = Перечисления.ИА_ПериодыДетализации.Неделя;
	КонецЕсли;
	
	Для каждого Стр из Объект.Статистики Цикл
		
		НоваяСтрока                        = НастройкаОбъект.Статистики.Добавить();
		НоваяСтрока.ВидСтатистики          = Стр.Статистика;
		НоваяСтрока.ЗаголовокДиаграммы     = Строка(Стр.Статистика);
		НоваяСтрока.НаименованиеДляЛегенды = Строка(Стр.Статистика); 
		НоваяСтрока.ПериодДетализации      = Перечисления.ИА_ПериодыДетализации.Неделя;
		НоваяСтрока.ПоказыватьВИЦО         = Истина;
		
	КонецЦикла;
	
	НастройкаОбъект.Записать();
	
	Объект.НастройкаСтатистик = НастройкаОбъект.Ссылка;
	Записать();
	
КонецПроцедуры


&НаКлиенте
