&НаСервереБезКонтекста
Функция ПолучитьДочерниеЭлементыСДругойШириной(Ссылка)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ОргСхема.Ссылка
	|ИЗ
	|	Справочник.ОргСхема КАК ОргСхема
	|ГДЕ
	|	ОргСхема.Ссылка В ИЕРАРХИИ(&Ссылка)
	|	И ОргСхема.Ширина <> &Ширина";
	
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.УстановитьПараметр("Ширина", Ссылка.Ширина);
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
КонецФункции

&НаСервереБезКонтекста
Процедура УстановитьШиринуПодчиненныхНаСервере(Ссылка)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ОргСхема.Ссылка
	|ИЗ
	|	Справочник.ОргСхема КАК ОргСхема
	|ГДЕ
	|	ОргСхема.Ссылка В ИЕРАРХИИ(&Ссылка)
	|	И ОргСхема.Ширина <> &Ширина";
	
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.УстановитьПараметр("Ширина", Ссылка.Ширина);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Спр = Выборка.Ссылка.ПолучитьОбъект();
		Спр.Ширина = Ссылка.Ширина;
		Спр.Записать();
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	#Если ВебКлиент Тогда
		ПодключитьРасширениеРаботыСФайлами();
	#КонецЕсли
	
	Если Объект.Ссылка.Пустая() Тогда
		УстановитьШиринуИЦвет();
		
		//определим тип терминала
		ТипТерминалаПоРодителю();		
	КонецЕсли;
	
	Если Объект.ТипТерминала = ПредопределенноеЗначение("Перечисление.ТипТерминалаОргСхемы.Секция") 
		ИЛИ Объект.ТипТерминала = ПредопределенноеЗначение("Перечисление.ТипТерминалаОргСхемы.Сектор")
		ИЛИ Объект.ТипТерминала = ПредопределенноеЗначение("Перечисление.ТипТерминалаОргСхемы.Сотрудник") 
		ИЛИ Объект.ТипТерминала = ПредопределенноеЗначение("Перечисление.ТипТерминалаОргСхемы.Департамент")
		ИЛИ Объект.ТипТерминала = ПредопределенноеЗначение("Перечисление.ТипТерминалаОргСхемы.Организация")Тогда
		Элементы.Ширина.Видимость = ложь;
	КонецЕсли;
	
	ТипТерминалаПриИзменении(Неопределено);
	
	Если Объект.ТипТерминала <> ПредопределенноеЗначение("Перечисление.ТипТерминалаОргСхемы.Департамент") Тогда
		Элементы.ПоднятьВверх.Видимость = ложь;
		Если Объект.ТипТерминала <> ПредопределенноеЗначение("Перечисление.ТипТерминалаОргСхемы.Отдел") Тогда
			Элементы.КраткоеНаименование.Видимость = ложь;
		КонецЕсли;
	КонецЕсли;
	
	Если Объект.ТипТерминала = ПредопределенноеЗначение("Перечисление.ТипТерминалаОргСхемы.Секция") или Объект.ТипТерминала = ПредопределенноеЗначение("Перечисление.ТипТерминалаОргСхемы.Отдел") тогда
		Элементы.НаименованиеДолжности.Видимость = Истина;
	Иначе
		Элементы.НаименованиеДолжности.Видимость = Ложь;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ТипТерминалаПоРодителю()
	Если НЕ ЗначениеЗаполнено(Объект.Родитель) Тогда 
		ТипТерминала = Перечисления.ТипТерминалаОргСхемы.Организация;
	Иначе	
		ТипТерминалаРодителя = Объект.Родитель.ТипТерминала;
		Если ЗначениеЗаполнено(ТипТерминалаРодителя) Тогда
			
			Если ТипТерминалаРодителя = Перечисления.ТипТерминалаОргСхемы.Организация Тогда
				ТипТерминала = Перечисления.ТипТерминалаОргСхемы.Учредитель;				
				
			ИначеЕсли ТипТерминалаРодителя = Перечисления.ТипТерминалаОргСхемы.Учредитель Тогда
				ТипТерминала = Перечисления.ТипТерминалаОргСхемы.РуководящийСостав;
				
			ИначеЕсли ТипТерминалаРодителя = Перечисления.ТипТерминалаОргСхемы.РуководящийСостав Тогда
				ТипТерминала = Перечисления.ТипТерминалаОргСхемы.Департамент;
				
			ИначеЕсли ТипТерминалаРодителя = Перечисления.ТипТерминалаОргСхемы.Департамент Тогда
				ТипТерминала = Перечисления.ТипТерминалаОргСхемы.Отдел;
				
			ИначеЕсли ТипТерминалаРодителя = Перечисления.ТипТерминалаОргСхемы.Отдел Тогда
				ТипТерминала = Перечисления.ТипТерминалаОргСхемы.Секция;
		
			ИначеЕсли ТипТерминалаРодителя = Перечисления.ТипТерминалаОргСхемы.Секция Тогда
				ТипТерминала = Перечисления.ТипТерминалаОргСхемы.Сектор;				
				
			ИначеЕсли ТипТерминалаРодителя = Перечисления.ТипТерминалаОргСхемы.Сектор Тогда
				ТипТерминала = Перечисления.ТипТерминалаОргСхемы.Сотрудник;				
			КонецЕсли;	
		Иначе
			ТипТерминала = Перечисления.ТипТерминалаОргСхемы.ПустаяСсылка();
		КонецЕсли;
	КонецЕсли;
	Объект.ТипТерминала = ТипТерминала;	
	
КонецПроцедуры

