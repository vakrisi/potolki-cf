
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Параметры.Свойство("Родитель",Родитель);
	ИА_КСУОбщийСервер.СделатьКнопкуОсновной(Элементы.ГруппаКП);
КонецПроцедуры

&НаКлиенте
Процедура КомандаОК(Команда)
	Рез = Новый Структура("Родитель,флЦвет,флШрифт,флШирина,флВысота");
	ЗаполнитьЗначенияСвойств(рез,ЭтаФорма);
	Закрыть(Рез);
КонецПроцедуры
