
&НаКлиенте
Процедура ОткрытьАдресацию(Команда)
	ф = ПолучитьФорму("РегистрСведений.ИА_АдресацияЗадачПланаДействий.ФормаСписка");
	ф.Открыть();
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если Параметры.Свойство("ОтборПользователь") Тогда
		м = ИА_ОбщиеПроцедуры_Технология_КоммЦентр.ПолучитьМассивПостов(Параметры.ОтборПользователь, Параметры.ОтборИерархия);

		Список.Параметры.УстановитьЗначениеПараметра("ОтборВыкл", ложь);
		Список.Параметры.УстановитьЗначениеПараметра("Отбор", м);
	Иначе
		Список.Параметры.УстановитьЗначениеПараметра("ОтборВыкл", истина);
		Список.Параметры.УстановитьЗначениеПараметра("Отбор", Неопределено);
	КонецЕсли;
КонецПроцедуры
