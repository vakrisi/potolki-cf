
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
    // Костыль для отбора по "владельцу"
    Если Параметры.Свойство("Реквизит")
        И ТипЗнч(Параметры.Реквизит) = Тип("ПланВидовХарактеристикСсылка.ИА_БПРеквизиты")
        Тогда
        ЭлементыОтбора = Список.КомпоновщикНастроек.ФиксированныеНастройки.Отбор.Элементы;
        
        ЭлементыОтбора.Очистить();
        Список.КомпоновщикНастроек.Настройки.Отбор.Элементы.Очистить();
        
        Элемент = ЭлементыОтбора.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
        Элемент.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Владелец");
        Элемент.ПравоеЗначение = Параметры.Реквизит;
    КонецЕсли; 
КонецПроцедуры
