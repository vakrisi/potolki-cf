
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)	
	
	Если Параметры.Свойство("Владелец") Тогда 
		Объект.Владелец = Параметры.Владелец;
	КонецЕсли; 
	ВидимостьОтветов();
	
КонецПроцедуры

&НаСервере
Процедура ВидимостьОтветов()
	
	Если Объект.ВариантныйОтвет Тогда
		Элементы.Группа3.Видимость      = Истина;
		Элементы.ОтветВопроса.Видимость = Ложь;
		Элементы.БаллВопроса.Видимость  = Ложь;
		Объект.ОтветВопроса             = 0;
	Иначе
		Элементы.Группа3.Видимость      = Ложь;
		Элементы.ОтветВопроса.Видимость = Истина;
		Элементы.БаллВопроса.Видимость  = Истина;
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура ТипВопросаПриИзменении(Элемент)
	
	ВидимостьОтветов();	
	
КонецПроцедуры


&НаКлиенте
Процедура ВариантыОтветовПриАктивизацииЯчейки(Элемент)
	
	ТекущийЭлемент = Элемент.ТекущийЭлемент;
	Если ТекущийЭлемент.Имя = "ВариантыОтветовОтвет" Тогда
		ТекущиеДанные = Элементы.ВариантыОтветов.ТекущиеДанные;
		Если ТекущиеДанные = Неопределено Или ТекущиеДанные.Ответ = Неопределено Тогда
			ТекущийЭлемент.ВыбиратьТип = Истина;
		Иначе
			ТекущийЭлемент.ВыбиратьТип = Ложь;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СкопироватьОтвет(Команда)
	тд = Элементы.ВариантыОтветов.ТекущиеДанные;
	Если тд<>Неопределено Тогда
		Новстр = Объект.ВариантыОтветов.Добавить();
		ЗаполнитьЗначенияСвойств(Новстр, тд);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	Если СтрДлина(Объект.Вопрос)>150 Тогда
		Объект.Наименование = лев(Объект.Вопрос,150);
	Иначе
		Объект.Наименование = Объект.Вопрос;
	КонецЕсли;
КонецПроцедуры





