#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
	
#Область Печать

// Заполняет список команд печати.
// 
// Параметры:
//   КомандыПечати - ТаблицаЗначений - состав полей см. в функции УправлениеПечатью.СоздатьКоллекциюКомандПечати.
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт
	
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.Идентификатор = "РеквизитыОрганизации";
	КомандаПечати.Представление = НСтр("ru = 'Реквизиты'");
	//КомандаПечати.СписокФорм = "ФормаЭлемента,ФормаСписка";
	КомандаПечати.ЗаголовокФормы = НСтр("ru = 'Печать реквизитов организации'");
	КомандаПечати.Порядок = 1;
	
КонецПроцедуры

// Сформировать печатные формы объектов
//
// ВХОДЯЩИЕ:
//   МассивОбъектов  - Массив    - Массив ссылок на объекты которые нужно распечатать
//   ПараметрыПечати - Структура - Структура дополнительных параметров печати
//
// ИСХОДЯЩИЕ:
//   КоллекцияПечатныхФорм - Таблица значений - Сформированные табличные документы
//   ОбъектыПечати         – СписокЗначений   – значение – ссылка на объект
//                                            - представление – имя области в которой был выведен объект
//   ПараметрыВывода       - Структура        - Параметры сформированных табличных документов
//
Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "РеквизитыОрганизации") Тогда
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
			КоллекцияПечатныхФорм,
			"РеквизитыОрганизации",
			НСтр("ru='Реквизиты организации'"),
			ПечатьКарточкиОрганизации(МассивОбъектов, ОбъектыПечати));
		
	КонецЕсли;

КонецПроцедуры

// Процедура формирования табличного документа с реквизитами организаций
//
Функция ПечатьКарточкиОрганизации(МассивОбъектов, ОбъектыПечати)
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.КлючПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_Организация_КарточкаОрганизации";
	
	Макет = УправлениеПечатью.МакетПечатнойФормы("Справочник.Организации.РеквизитыОрганизации");
	Разделитель = Макет.ПолучитьОбласть("Разделитель");
	
	ТекДата = ТекущаяДатаСеанса();
	ПервыйДокумент = Истина;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Организации.Ссылка КАК Ссылка,
	|	Организации.Код КАК Код,
	|	Организации.Наименование КАК Наименование,
	|	Организации.ГлавныйБухгалтер КАК ГлавныйБухгалтер,
	|	Организации.ИНН КАК ИНН,
	|	Организации.Кассир КАК Кассир,
	|	Организации.КодПоОКТМО КАК КодПоОКТМО,
	|	Организации.КПП КАК КПП,
	|	Организации.ОсновнойБанковскийСчет КАК ОсновнойБанковскийСчет,
	|	ВЫБОР
	|		КОГДА Организации.ПолноеНаименование = """"
	|			ТОГДА Организации.Наименование
	|		ИНАЧЕ Организации.ПолноеНаименование
	|	КОНЕЦ КАК ПолноеНаименование,
	|	Организации.ПрефиксОрганизации КАК ПрефиксОрганизации,
	|	Организации.Руководитель КАК ПодписьРуководителя,
	|	Организации.СистемаНалогообложения КАК СистемаНалогообложения,
	|	Организации.СтавкаНДСПоУмолчанию КАК СтавкаНДСПоУмолчанию,
	|	Организации.ЯвляетсяПлательщикомНДС КАК ЯвляетсяПлательщикомНДС,
	|	Организации.ИдентификационныйНомерПлательщикаЕвропейскогоНДС КАК ИдентификационныйНомерПлательщикаЕвропейскогоНДС,
	|	Организации.ОсновнаяНастройкаИнтеркампани КАК ОсновнаяНастройкаИнтеркампани,
	|	Организации.ОсновнойБанковскийСчет.БИК КАК БИК,
	|	Организации.ОсновнойБанковскийСчет.КоррСчет КАК КоррСчет,
	|	Организации.ОсновнойБанковскийСчет.НаименованиеБанка КАК Банк,
	|	Организации.ОсновнойБанковскийСчет.Код КАК ОсновнойБанковскийСчетКод,
	|	Организации.ОсновнойБанковскийСчет.НомерСчета КАК НомерСчета,
	|	ВЫБОР
	|		КОГДА Организации.Руководитель.Должность = ЗНАЧЕНИЕ(Справочник.Должности.ПустаяСсылка)
	|			ТОГДА ""Руководитель""
	|		ИНАЧЕ ПРЕДСТАВЛЕНИЕ(Организации.Руководитель.Должность)
	|	КОНЕЦ КАК ДолжностьРуководителя
	|ИЗ
	|	Справочник.Организации КАК Организации
	|ГДЕ
	|	Организации.Ссылка В(&МассивОбъектов)";
	
	
	СведенияОбОрганизации = Запрос.Выполнить().Выбрать();
	
	Пока СведенияОбОрганизации.Следующий() Цикл
		
		Если НЕ ПервыйДокумент Тогда
			ТабличныйДокумент.Вывести(Разделитель);
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		ПервыйДокумент = Ложь;
		НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы + 1;
		ЭтоЮрЛицо = СтрДлина(СведенияОбОрганизации.ИНН) <> 12;//Организация.ЮридическоеФизическоеЛицо = Перечисления.ЮридическоеФизическоеЛицо.ЮридическоеЛицо;
		
		Область = Макет.ПолучитьОбласть("Наименование");
		Область.Параметры.ПолноеНаименование = СведенияОбОрганизации.ПолноеНаименование;
		ТабличныйДокумент.Вывести(Область);
		
		Если ЗначениеЗаполнено(СведенияОбОрганизации.ИНН) Тогда
			Область = Макет.ПолучитьОбласть("ИНН");
			Область.Параметры.ИНН = СведенияОбОрганизации.ИНН;
			ТабличныйДокумент.Вывести(Область);
		КонецЕсли;
		
		Если ЭтоЮрЛицо И ЗначениеЗаполнено(СведенияОбОрганизации.КПП) Тогда
			Область = Макет.ПолучитьОбласть("КПП");
			Область.Параметры.КПП = СведенияОбОрганизации.КПП;
			ТабличныйДокумент.Вывести(Область);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СведенияОбОрганизации.КодПоОКТМО) Тогда
			Область = Макет.ПолучитьОбласть("ОКТМО");
			Область.Параметры.КодПоОКТМО = СведенияОбОрганизации.КодПоОКТМО;
			ТабличныйДокумент.Вывести(Область);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СведенияОбОрганизации.НомерСчета) 
			И ЗначениеЗаполнено(СведенияОбОрганизации.БИК) 
			И ЗначениеЗаполнено(СведенияОбОрганизации.КоррСчет) 
			И ЗначениеЗаполнено(СведенияОбОрганизации.Банк) Тогда
			
			Область = Макет.ПолучитьОбласть("РасчетныйСчет");
			Область.Параметры.НомерСчета = СведенияОбОрганизации.НомерСчета;
			Область.Параметры.БИК = СведенияОбОрганизации.БИК;
			Область.Параметры.КоррСчет = СведенияОбОрганизации.КоррСчет;
			Область.Параметры.Банк = СведенияОбОрганизации.Банк;
			ТабличныйДокумент.Вывести(Область);
		КонецЕсли;
		
		ЮридическийАдрес = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(СведенияОбОрганизации.Ссылка, Справочники.ВидыКонтактнойИнформации.ЮрАдресОрганизации);
		Телефон = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(СведенияОбОрганизации.Ссылка, Справочники.ВидыКонтактнойИнформации.ТелефонОрганизации);
		Сайт = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(СведенияОбОрганизации.Ссылка, Справочники.ВидыКонтактнойИнформации.СайтОрганизации);
		Почта = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(СведенияОбОрганизации.Ссылка, Справочники.ВидыКонтактнойИнформации.EmailОрганизации);
		
		Если ЗначениеЗаполнено(ЮридическийАдрес) 
			ИЛИ ЗначениеЗаполнено(Телефон) 
			Тогда
			ТабличныйДокумент.Вывести(Разделитель);
		КонецЕсли;
		
		Если ЭтоЮрЛицо И ЗначениеЗаполнено(ЮридическийАдрес) Тогда
			Область = Макет.ПолучитьОбласть("ЮридическийАдрес");
			Область.Параметры.ЮридическийАдрес = ЮридическийАдрес;
			ТабличныйДокумент.Вывести(Область);
		КонецЕсли;
			
		Если Не ЭтоЮрЛицо И ЗначениеЗаполнено(ЮридическийАдрес) Тогда
			Область = Макет.ПолучитьОбласть("АдресИП");
			Область.Параметры.АдресИП = ЮридическийАдрес;
			ТабличныйДокумент.Вывести(Область);
		КонецЕсли;
			
		Если ЗначениеЗаполнено(Телефон) Тогда
			Область = Макет.ПолучитьОбласть("Телефон");
			Область.Параметры.Телефон = Телефон;
			ТабличныйДокумент.Вывести(Область);
		КонецЕсли;
		
		
		Если ЗначениеЗаполнено(Сайт) Тогда
			Область = Макет.ПолучитьОбласть("Сайт");
			Область.Параметры.Сайт = Сайт;
			ТабличныйДокумент.Вывести(Область);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Почта) Тогда
			Область = Макет.ПолучитьОбласть("Почта");
			Область.Параметры.Почта = Почта;
			ТабличныйДокумент.Вывести(Область);
		КонецЕсли;
		
		//Если Не ЭтоЮрЛицо
		//	И СведенияОбОрганизации.Свойство("СвидетельствоСерияНомер") И ЗначениеЗаполнено(СведенияОбОрганизации.СвидетельствоСерияНомер)
		//	И СведенияОбОрганизации.Свойство("СвидетельствоДатаВыдачи") И ЗначениеЗаполнено(СведенияОбОрганизации.СвидетельствоДатаВыдачи) Тогда
		//	
		//	Область = Макет.ПолучитьОбласть("Свидетельство");
		//	Область.Параметры.СвидетельствоСерияНомер = СведенияОбОрганизации.СвидетельствоСерияНомер;
		//	Область.Параметры.СвидетельствоДатаВыдачи = Формат(СведенияОбОрганизации.СвидетельствоДатаВыдачи, "ДЛФ=D");
		//	ТабличныйДокумент.Вывести(Область);
		//КонецЕсли;
		
		Если ЭтоЮрЛицо 
			И ЗначениеЗаполнено(СведенияОбОрганизации.ПодписьРуководителя) Тогда
			
			Область = Макет.ПолучитьОбласть("Руководитель");
			Область.Параметры.Должность = СведенияОбОрганизации.ДолжностьРуководителя;
			Область.Параметры.РасшифровкаПодписи = СведенияОбОрганизации.ПодписьРуководителя;
			
			ТабличныйДокумент.Вывести(Область);
			
		КонецЕсли;
		
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабличныйДокумент, НомерСтрокиНачало, ОбъектыПечати, СведенияОбОрганизации.Ссылка);
		
	КонецЦикла;
	
	Возврат ТабличныйДокумент;
	
КонецФункции

#КонецОбласти

Функция ПолучитьОрганизациюПоКонтрагенту(Контрагент, Знач НастройкаИнтеркампани = Неопределено) Экспорт
	
	Результат = Справочники.Организации.ПустаяСсылка();
	
	Если НастройкаИнтеркампани = Неопределено Тогда
		
		Если Контрагент = Константы.ОсновнаяНастройкаИнтеркампани.Получить().КонтрагентПроизводствоПотолков Тогда			
			//Результат = Константы.ОсновнаяНастройкаИнтеркампани.Получить().ОрганизацияПроизводствоПотолков;
			Результат = Константы.ОсновнаяНастройкаИнтеркампани.Получить().ОрганизацияРозничныеПродажи;
		ИначеЕсли Контрагент = Константы.ОсновнаяНастройкаИнтеркампани.Получить().КонтрагентРозничныеПродажи Тогда
			//Результат = Константы.ОсновнаяНастройкаИнтеркампани.Получить().ОрганизацияРозничныеПродажи;
			Результат = Константы.ОсновнаяНастройкаИнтеркампани.Получить().ОрганизацияПроизводствоПотолков;
		КонецЕсли;
		
	Иначе
		
		Если Контрагент = НастройкаИнтеркампани.КонтрагентПроизводствоПотолков Тогда
			//Результат = НастройкаИнтеркампани.ОрганизацияПроизводствоПотолков;  - в этом случае по интеркампани нужно вернуть организацию розница
			Результат = НастройкаИнтеркампани.ОрганизацияРозничныеПродажи;
		ИначеЕсли Контрагент = НастройкаИнтеркампани.КонтрагентРозничныеПродажи Тогда
			//Результат = НастройкаИнтеркампани.ОрганизацияРозничныеПродажи; - в этом случае по интеркампани нужно вернуть организацию производство
			Результат = НастройкаИнтеркампани.ОрганизацияПроизводствоПотолков;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьКонтрагентаПоОрганизации(Организация, Знач НастройкаИнтеркампани = Неопределено) Экспорт
	
	Результат = Справочники.Контрагенты.ПустаяСсылка();
	
	Если НастройкаИнтеркампани = Неопределено Тогда
		
		Если Организация = Константы.ОсновнаяНастройкаИнтеркампани.Получить().ОрганизацияПроизводствоПотолков Тогда
			//Результат = Константы.ОсновнаяНастройкаИнтеркампани.Получить().КонтрагентПроизводствоПотолков;
			Результат = Константы.ОсновнаяНастройкаИнтеркампани.Получить().КонтрагентРозничныеПродажи;
		ИначеЕсли Организация = Константы.ОсновнаяНастройкаИнтеркампани.Получить().ОрганизацияРозничныеПродажи Тогда
			//Результат = Константы.ОсновнаяНастройкаИнтеркампани.Получить().КонтрагентРозничныеПродажи;
			Результат = Константы.ОсновнаяНастройкаИнтеркампани.Получить().КонтрагентПроизводствоПотолков;			
		КонецЕсли;
		
	Иначе 
		
		Если Организация = НастройкаИнтеркампани.ОрганизацияПроизводствоПотолков Тогда
			//Результат = НастройкаИнтеркампани.КонтрагентПроизводствоПотолков;
			Результат = НастройкаИнтеркампани.КонтрагентРозничныеПродажи;
		ИначеЕсли Организация = НастройкаИнтеркампани.ОрганизацияРозничныеПродажи Тогда
			//Результат = НастройкаИнтеркампани.КонтрагентРозничныеПродажи;
			Результат = НастройкаИнтеркампани.КонтрагентПроизводствоПотолков;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ИспользуетсяНесколькоОрганизаций() Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	КОЛИЧЕСТВО(Организации.Ссылка) КАК КолвоЭлементов
	|ИЗ
	|	Справочник.Организации КАК Организации
	|ГДЕ
	|	НЕ Организации.ПометкаУдаления";
	
	РезультатЗапроса = Запрос.Выполнить();	
	Выборка = РезультатЗапроса.Выбрать();
	
	Если Выборка.Следующий() Тогда
		Если Выборка.КолвоЭлементов > 1 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Ложь;
КонецФункции

#КонецЕсли