Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ЭлОтбора = Список.Отбор.Элементы;
	ЭлОтбора.Очистить();
	Владелец = Неопределено;
	Параметры.Свойство("Владелец",Владелец);
	Если Владелец <> Неопределено Тогда 
		НовОтбор = ЭлОтбора.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		НовОтбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Владелец");
		НовОтбор.Использование = Истина;
		НовОтбор.ПравоеЗначение = Владелец;
	КонецЕсли;  
КонецПроцедуры

