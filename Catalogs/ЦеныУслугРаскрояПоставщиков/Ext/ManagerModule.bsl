	//			НоваяСтрока.Количество = КоличествоУслуги-КоличествоБесплатнойУслуги;
	//			ЦенаВПрайсе = ТекущаяСтрока.Цена;
	//			
	//			Если ПересчитыватьВВалютуПараметра Тогда
	//				НоваяСтрока.Цена = РаботаСВалютой.ПересчитатьИзВалютыВВалюту(ВидЦен.Валюта, Валюта, Дата, ЦенаВПрайсе);
	//			Иначе
	//				НоваяСтрока.Цена = ЦенаВПрайсе
	//			КонецЕсли;
	//			НоваяСтрока.Номенклатура = ТекущаяСтрока.Номенклатура;
	//		КонецЕсли;
	//	КонецЦикла;
	//КонецЕсли;
	#КонецОбласти
	
	//#11866
	// определим настройку стоимости услуги и её номенклатуру (по общему количеству услуги в заказе)
	Для Каждого ТекущаяСтрока Из ВидЦен[ТабличнаяЧасть] Цикл
		Если ТекущаяСтрока.НеУчитывать Тогда
			Продолжить;
		КонецЕсли;
		КоличествоВхожденияВДиапазон = 0;
		Если (КоличествоУслуги >= ТекущаяСтрока.КоличествоОт) 
			И (КоличествоУслуги >= ТекущаяСтрока.КоличествоДо) 
			И (ТекущаяСтрока.КоличествоОт <= ТекущаяСтрока.КоличествоДо) Тогда
			КоличествоВхожденияВДиапазон = Мин(ТекущаяСтрока.КоличествоДо, ТекущаяСтрока.КоличествоДо - ТекущаяСтрока.КоличествоОт + 1);
			
		ИначеЕсли (КоличествоУслуги >= ТекущаяСтрока.КоличествоОт) 
			И (КоличествоУслуги < ТекущаяСтрока.КоличествоДо) 
			И (ТекущаяСтрока.КоличествоОт <= ТекущаяСтрока.КоличествоДо) Тогда
			КоличествоВхожденияВДиапазон = КоличествоУслуги - ТекущаяСтрока.КоличествоОт + 1;
		КонецЕсли;
		
		Если КоличествоВхожденияВДиапазон > 0 Тогда		
			НоваяСтрока = ТаблицаРезультата.Добавить();
			НоваяСтрока.Номенклатура = ТекущаяСтрока.Номенклатура;
			НоваяСтрока.Количество = КоличествоВхожденияВДиапазон;
			ЦенаВПрайсе = ТекущаяСтрока.Цена;			
			
			Если ПересчитыватьВВалютуПараметра Тогда
				НоваяСтрока.Цена = РаботаСВалютой.ПересчитатьИзВалютыВВалюту(ВидЦен.Валюта, Валюта, Дата, ЦенаВПрайсе);
			Иначе
				НоваяСтрока.Цена = ЦенаВПрайсе;
			КонецЕсли;
			
		КонецЕсли;
	КонецЦикла;
	
	//проверим, для всех ли элементов нашлись настройки, если нет - добавим пустую номенклатуру
	Если ТаблицаРезультата.Итог("Количество") < КоличествоУслуги Тогда
		НоваяСтрока = ТаблицаРезультата.Добавить();
		НоваяСтрока.Количество = КоличествоУслуги - ТаблицаРезультата.Итог("Количество");
	КонецЕсли;
	
	Возврат ТаблицаРезультата;
	
КонецФункции

Функция ПолучитьТаблицуНоменклатурИЦенУглов(Знач ВидЦен, Знач КоличествоУслуги, Знач Валюта, Знач Дата) Экспорт
	
	Возврат ПолучитьТаблицуНоменклатурИЦен(ВидЦен, КоличествоУслуги, "Углы", Валюта, Дата);
	
КонецФункции

