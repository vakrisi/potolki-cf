
Функция ПолучитьТаблицуНоменклатурИЦен(Знач ВидЦен, Знач КоличествоУслуги, Знач ТабличнаяЧасть, Знач Валюта, Знач Дата)
	
	ТаблицаРезультата = Новый ТаблицаЗначений;
	ТаблицаРезультата.Колонки.Добавить("Номенклатура");
	ТаблицаРезультата.Колонки.Добавить("Количество");
	ТаблицаРезультата.Колонки.Добавить("Цена");
	
	//++ №7926 Проверим может установлен флаг не учитывать на всю ТЧ
	Если ВидЦен["НеУчитывать" + ТабличнаяЧасть] Тогда
		Возврат ТаблицаРезультата;
	КонецЕсли;
	//-- №7926
	
	Если КоличествоУслуги = 0 Тогда
		Возврат ТаблицаРезультата;
	КонецЕсли;
	
	ПересчитыватьВВалютуПараметра = Ложь;
	Если НЕ ВидЦен.Валюта = Валюта Тогда
		ПересчитыватьВВалютуПараметра = Истина;
	КонецЕсли;
	
	#Область ДоЗаявки11866
	//КоличествоБесплатнойУслуги = 0;
	//
	////определим количество бесплатных элементов, заданные в прайсе
	//Для Каждого ТекущаяСтрока Из ВидЦен[ТабличнаяЧасть] Цикл
	//	
	//	//++ №7926 проверка на флаг "Не учитывать"
	//	Если ТекущаяСтрока.НеУчитывать Тогда
	//		Продолжить;
	//	КонецЕсли;
	//	//-- №7926
	//	
	//	//Если ТекущаяСтрока.КоличествоОт = 0 И ТекущаяСтрока.Цена = 0 Тогда
	//	Если ТекущаяСтрока.Цена = 0 Тогда
	//		
	//		НоваяСтрока = ТаблицаРезультата.Добавить();
	//		
	//		Если КоличествоУслуги <= ТекущаяСтрока.КоличествоДо Тогда
	//			НоваяСтрока.Количество = КоличествоУслуги;
	//			КоличествоБесплатнойУслуги = КоличествоУслуги;
	//		Иначе
	//			НоваяСтрока.Количество = ТекущаяСтрока.КоличествоДо;
	//			КоличествоБесплатнойУслуги = ТекущаяСтрока.КоличествоДо;
	//		КонецЕсли;
	//		
	//		
	//		НоваяСтрока.Цена = ТекущаяСтрока.Цена;
	//		НоваяСтрока.Номенклатура = ТекущаяСтрока.Номенклатура;
	//		Прервать;
	//	КонецЕсли;
	//КонецЦикла;
	//
	////теперь определим настройку стоимости углов и её номенклатуру (по общему количеству углов в заказе)
	//Если (КоличествоУслуги - КоличествоБесплатнойУслуги) > 0 Тогда
	//	Для Каждого ТекущаяСтрока Из ВидЦен[ТабличнаяЧасть] Цикл
	//		
	//		//++ №7926 проверка на флаг "Не учитывать"
	//		Если ТекущаяСтрока.НеУчитывать Тогда
	//			Продолжить;
	//		КонецЕсли;
	//		//-- №7926
	//		
	//		Если (КоличествоУслуги >= ТекущаяСтрока.КоличествоОт ) и (КоличествоУслуги <= ТекущаяСтрока.КоличествоДо) Тогда
