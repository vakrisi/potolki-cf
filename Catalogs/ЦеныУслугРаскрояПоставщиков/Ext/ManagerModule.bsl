Функция ПолучитьДействующийПрайсПоставщикаНаУслугиПроизводства(Знач ВидЦеныПоставщика, Знач Дата) Экспорт
//Функция ПолучитьДействующийПрайсПоставщикаНаУслугиПроизводства(Знач Поставщик, Знач Дата) Экспорт
	
	Если Дата = Неопределено Тогда
		Дата = ТекущаяДатаСеанса();
	ИначеЕсли Дата = Дата(1,1,1) Тогда
		Дата = ТекущаяДатаСеанса();
	КонецЕсли;
	
	Результат = Справочники.ЦеныУслугРаскрояПоставщиков.ПустаяСсылка();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СоответствиеВидовЦенПоставщиковЦенамУслугРаскрояСрезПоследних.ЦеныУслугРаскрояПоставщика КАК ВидЦен
	|ИЗ
	|	РегистрСведений.СоответствиеВидовЦенПоставщиковЦенамУслугРаскроя.СрезПоследних(&Дата, ВидЦеныПоставщика = &ВидЦен) КАК СоответствиеВидовЦенПоставщиковЦенамУслугРаскрояСрезПоследних";
	Запрос.УстановитьПараметр("Дата", КонецДня(Дата));
	Запрос.УстановитьПараметр("ВидЦен", ВидЦеныПоставщика);
	
	//"ВЫБРАТЬ
	//|	ЦеныУслугРаскрояПоставщиков.Ссылка
	//|ИЗ
	//|	Справочник.ЦеныУслугРаскрояПоставщиков КАК ЦеныУслугРаскрояПоставщиков
	//|ГДЕ
	//|	ЦеныУслугРаскрояПоставщиков.Контрагент = &Контрагент
	//|	И НЕ ЦеныУслугРаскрояПоставщиков.ПометкаУдаления
	//|	И ЦеныУслугРаскрояПоставщиков.Дата <= &Дата
	//|
	//|УПОРЯДОЧИТЬ ПО
	//|	ЦеныУслугРаскрояПоставщиков.Дата УБЫВ";
		
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат = Выборка.ВидЦен;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

