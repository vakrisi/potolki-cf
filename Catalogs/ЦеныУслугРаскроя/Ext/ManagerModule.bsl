#Область ОбработчикиСобытий

Процедура ОбработкаПолученияПолейПредставления(Поля, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	Поля.Добавить("Дата");
	Поля.Добавить("ВидОперации");
КонецПроцедуры

Процедура ОбработкаПолученияПредставления(Данные, Представление, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	Представление = "Установка цен на услуги производства от " + Формат(Данные.Дата, "ДЛФ=Д");
	Если Данные.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийУстановкиЦенНаУслугиПроизводства.ПоИнтеркампани") Тогда
		Представление = Представление + " (интеркампани)";
	ИначеЕсли Данные.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийУстановкиЦенНаУслугиПроизводства.ДляВнутреннихЗаказов") Тогда
		Представление = Представление + " (для внутренних заказов)";
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

Функция ПодобратьДокументЦенНаУслугиПроизводства(Знач Дата, Знач Валюта, Знач ВидНоменклатуры, Знач ВидОперации = Неопределено,
												 Знач ВидЦенНастройкаИнтеркампани = Неопределено, Знач ДоговорКонтрагента = Неопределено, 
												 ПересчитыватьВВалютуПараметра)
	
	ВалютаУчета = Константы.ВалютаУчета.Получить();
	ОсновнаяВалютаПересчетаЦены = Константы.ОсновнаяВалютаПересчетаЦены.Получить();
	
	ДокументУЦНУП = ПолучитьВидЦенНаУслугиПроизводства(Дата, Валюта, ВидНоменклатуры, ВидОперации, ВидЦенНастройкаИнтеркампани, ДоговорКонтрагента);
	
	ПересчитыватьВВалютуПараметра = Ложь;
	Если ДокументУЦНУП = Справочники.ЦеныУслугРаскроя.ПустаяСсылка() Тогда
		
		ПересчитыватьВВалютуПараметра = Истина;
		
		//++ №12971 комментируем
		//Если (Валюта = ВалютаУчета) И (НЕ Валюта = ОсновнаяВалютаПересчетаЦены) Тогда
		// 	// пробуем получить документ УЦ по основной валюте пересчета цен, если валюта документа = валюта учета
		//	ДокументУЦНУП = ПолучитьВидЦенНаУслугиПроизводства(ВидОперации, ВидЦенНастройкаИнтеркампани, Дата, ОсновнаяВалютаПересчетаЦены, ДоговорКонтрагента);
		//Иначе
		//	// №12930 пробуем получить документ УЦ по валюте учета и пересчитать по курсу валюты документа
		//	ДокументУЦНУП = ПолучитьВидЦенНаУслугиПроизводства(ВидОперации, ВидЦенНастройкаИнтеркампани, Дата, ВалютаУчета, ДоговорКонтрагента);
		//КонецЕсли;
		//-- №12971 комментируем
		
		//++ №12971 по новому
		// 1. Если не нашли документ УЦ по валюте документа и задана валюта пересчета, ищем прайс в валюте пересчета
		//	(если нашли, то ставим цену в валюте документа по курсу к валюте пересчета)
		Если ЗначениеЗаполнено(ОсновнаяВалютаПересчетаЦены) Тогда
			ДокументУЦНУП = ПолучитьВидЦенНаУслугиПроизводства(Дата, ОсновнаяВалютаПересчетаЦены, ВидНоменклатуры, ВидОперации, ВидЦенНастройкаИнтеркампани, ДоговорКонтрагента);
		КонецЕсли;
		
		// 2. Если не нашли документ УЦ по валюте пересчета, то ищем прайс в валюте учета (если валюта документа отличается от валюты учёта)
		//	(если нашли, то ставим цену в валюте документа по курсу к валюте учета)
		Если ДокументУЦНУП = Справочники.ЦеныУслугРаскроя.ПустаяСсылка() И НЕ Валюта = ВалютаУчета Тогда
			ДокументУЦНУП = ПолучитьВидЦенНаУслугиПроизводства(Дата, ВалютаУчета, ВидНоменклатуры, ВидОперации, ВидЦенНастройкаИнтеркампани, ДоговорКонтрагента);
		КонецЕсли;
		//-- №12971 по новому
	
	КонецЕсли;
	
	Возврат ДокументУЦНУП;
	
КонецФункции

Функция ПолучитьВидЦенНаУслугиПроизводства(Знач Дата, Знач Валюта, Знач ВидНоменклатуры, Знач ВидОперации = Неопределено, 
										   Знач ВидЦенНастройкаИнтеркампани = Неопределено,  
										   Знач ДоговорКонтрагента = Неопределено) Экспорт
										   
//Функция ПолучитьВидЦенРаскрояПоВидуЦен(Знач ВидЦенНастройкаИнтеркампани, Знач Дата, Знач Валюта, Знач ДоговорКонтрагента = Неопределено) Экспорт	
	Если Дата = Дата(1,1,1) Тогда
		Дата = ТекущаяДатаСеанса();
	КонецЕсли;
	Если ВидОперации = Неопределено Тогда
		ВидОперации = Перечисления.ВидыОперацийУстановкиЦенНаУслугиПроизводства.ПустаяСсылка();
	КонецЕсли;
	Если ДоговорКонтрагента = Неопределено Тогда
		ДоговорКонтрагента = Справочники.ДоговорыКонтрагентов.ПустаяСсылка();
	КонецЕсли;
	//#7256
	Если ТипЗнч(ВидЦенНастройкаИнтеркампани) = Тип("СправочникСсылка.ВидыЦен") И ЗначениеЗаполнено(ВидЦенНастройкаИнтеркампани) Тогда
		РеквизитыВидаЦен = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ВидЦенНастройкаИнтеркампани, "СсылочныйВидЦены, ВидЦеныНаУслугиПроизводства");
		Если РеквизитыВидаЦен.СсылочныйВидЦены Тогда
			ВидЦенНастройкаИнтеркампани = РеквизитыВидаЦен.ВидЦеныНаУслугиПроизводства;
		КонецЕсли;	
	КонецЕсли;

	Результат = Справочники.ЦеныУслугРаскроя.ПустаяСсылка();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СоответствиеВидовЦенЦенамУслугРаскрояСрезПоследних.ЦеныУслугРаскроя КАК ЦеныУслугРаскроя
	|ИЗ
	|	РегистрСведений.СоответствиеВидовЦенЦенамУслугРаскроя.СрезПоследних(
	|			&Дата,
	|			Валюта = &Валюта
	|				И ВидНоменклатуры = &ВидНоменклатуры
	|				И ВидОперации = &ВидОперации
	|				И ВидЦен = &ВидЦенНастройкаИнтеркампани) КАК СоответствиеВидовЦенЦенамУслугРаскрояСрезПоследних
	|";
	Запрос.УстановитьПараметр("Дата", КонецДня(Дата));
	Запрос.УстановитьПараметр("Валюта", Валюта);
	Запрос.УстановитьПараметр("ВидНоменклатуры", ВидНоменклатуры);
	Запрос.УстановитьПараметр("ВидОперации", ВидОперации);
	Запрос.УстановитьПараметр("ВидЦенНастройкаИнтеркампани", ВидЦенНастройкаИнтеркампани);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат = Выборка.ЦеныУслугРаскроя;
	КонецЦикла;
	
	Если ПолучитьФункциональнуюОпцию("ИспользоватьИндивидуальныеЦены") И НЕ ДоговорКонтрагента.Пустая() Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВЫБОР
		|		КОГДА НЕ СоответствиеИндивидуальныхЦен.ВидЦеныНаУслугиПроизводства = ЗНАЧЕНИЕ(Справочник.ВидыЦен.ПустаяСсылка)
		|			ТОГДА СоответствиеВидовЦен.ЦеныУслугРаскроя
		|		ИНАЧЕ СоответствиеИндивидуальныхЦен.Документ
		|	КОНЕЦ КАК ЦеныУслугРаскроя,
		|	СоответствиеИндивидуальныхЦен.Отменена КАК Отменена
		|ИЗ
		|	РегистрСведений.СоответствиеИндивидуальныхЦенЦенамУслугРаскроя.СрезПоследних(
		|			&Дата,
		|			Валюта = &Валюта
		|				И ВидНоменклатуры = &ВидНоменклатуры
		|				И ДоговорКонтрагента = &ДоговорКонтрагента) КАК СоответствиеИндивидуальныхЦен
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СоответствиеВидовЦенЦенамУслугРаскроя.СрезПоследних(&Дата, Валюта = &Валюта И ВидНоменклатуры = &ВидНоменклатуры) КАК СоответствиеВидовЦен
		|		ПО (СоответствиеВидовЦен.ВидЦен = СоответствиеИндивидуальныхЦен.ВидЦеныНаУслугиПроизводства)";
		
		Запрос.УстановитьПараметр("Дата", КонецДня(Дата));
		Запрос.УстановитьПараметр("Валюта", Валюта);
		Запрос.УстановитьПараметр("ВидНоменклатуры", ВидНоменклатуры);
		Запрос.УстановитьПараметр("ДоговорКонтрагента", ДоговорКонтрагента);		
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Если НЕ Выборка.Отменена Тогда
				Результат = Выборка.ЦеныУслугРаскроя;
			КонецЕсли;
		КонецЕсли;		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

