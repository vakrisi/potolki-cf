				И (КоличествоУслуги < ТекущаяСтрока.КоличествоДо) 
				И (ТекущаяСтрока.КоличествоОт <= ТекущаяСтрока.КоличествоДо) Тогда
				КоличествоВхожденияВДиапазон = КоличествоУслуги - ТекущаяСтрока.КоличествоОт + ?(ТекущаяСтрока.КоличествоОт > 0, 1, 0);
			КонецЕсли;
			
			Если КоличествоВхожденияВДиапазон > 0 Тогда	
				
				//++ #15959
				УслугаОбработана = Истина;
				Если ТекущаяСтрока.НеУчитывать Тогда
					Продолжить;
				КонецЕсли;
			    //-- #15959
				
				НоваяСтрока = ТаблицаРезультата.Добавить();
				НоваяСтрока.Номенклатура = ТекущаяСтрока.Номенклатура;
				НоваяСтрока.Количество = КоличествоВхожденияВДиапазон;
				ЦенаВПрайсе = ТекущаяСтрока.Цена;
				
				Если НулевыеЦены Тогда
					НоваяСтрока.Цена = 0;
				Иначе
					Если ПересчитыватьВВалютуПараметра Тогда
						НоваяСтрока.Цена = РаботаСВалютой.ПересчитатьИзВалютыВВалюту(ЦеныУслугРаскроя.Валюта, Валюта, Дата, ЦенаВПрайсе);
					Иначе
						НоваяСтрока.Цена = ЦенаВПрайсе;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		
	Иначе
		
		// новый вариант "Оценка по каждому заданному диапазону", добавляем каждую услугу которая подходит по диапазону с соответствуюшей ценой и номенклатурой
		Для Каждого ТекущаяСтрока Из ЦеныУслугРаскроя[ТабличнаяЧасть] Цикл
			
			// #15959 здесь закомментировано, перенесено ниже
			//Если ТекущаяСтрока.НеУчитывать Тогда
			//	Продолжить;
			//КонецЕсли;
			
			Если (КоличествоУслуги >= ТекущаяСтрока.КоличествоОт) И (КоличествоУслуги <= ТекущаяСтрока.КоличествоДо) Тогда
				
				//++ #15959
				УслугаОбработана = Истина;
				Если ТекущаяСтрока.НеУчитывать Тогда
					Продолжить;
				КонецЕсли;
			    //-- #15959
				
				НоваяСтрока = ТаблицаРезультата.Добавить();
				НоваяСтрока.Номенклатура = ТекущаяСтрока.Номенклатура;
				НоваяСтрока.Количество = КоличествоУслуги;
				ЦенаВПрайсе = ТекущаяСтрока.Цена;
				
				Если НулевыеЦены Тогда
					НоваяСтрока.Цена = 0;
				Иначе
					Если ПересчитыватьВВалютуПараметра Тогда
						НоваяСтрока.Цена = РаботаСВалютой.ПересчитатьИзВалютыВВалюту(ЦеныУслугРаскроя.Валюта, Валюта, Дата, ЦенаВПрайсе);
					Иначе
						НоваяСтрока.Цена = ЦенаВПрайсе;
					КонецЕсли;
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;

	//++ №14059 комментируем
	// #15959 раскомментировано
	//проверим, для всех ли элементов нашлись настройки, если нет - добавим пустую номенклатуру
	Если НЕ УслугаОбработана И ТаблицаРезультата.Итог("Количество") < КоличествоУслуги Тогда
		НоваяСтрока = ТаблицаРезультата.Добавить();
		НоваяСтрока.Количество = КоличествоУслуги - ТаблицаРезультата.Итог("Количество");
	КонецЕсли;
	//-- №14059 комментируем
	
	Возврат ТаблицаРезультата;
	
КонецФункции

