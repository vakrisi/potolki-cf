	ТаблицаРезультата.Колонки.Добавить("КоличествоКВыработке", новый ОписаниеТипов("число"));
	
	//Проверим может установлен флаг не учитывать на всю ТЧ
	Если ЦеныУслугРаскроя["НеУчитывать" + ТабличнаяЧасть] Тогда
