&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	УстановитьУсловноеОформление();
	
	Если Параметры.Ключ.Пустая() Тогда
		Объект.Дата = ТекущаяДатаСеанса();
	КонецЕсли;
	
	УстановитьЗначениеНастроекИнтеркампани();
	УстановитьВидимостьЭлементов();
	
	ОтображатьЦеныВоВнутреннихЗаказах = Константы.ОтображатьЦеныВоВнутреннихЗаказах.Получить();
	
	//#12301
	Элементы.ВариантОценкиВнутренниеВырезы.Доступность = Ложь;
	Элементы.ВариантОценкиВырезыApply.Доступность = Ложь;
	Элементы.ВариантОценкиДлинаПользовательскихШвов.Доступность = Ложь;
	Элементы.ВариантОценкиДлинаШвов.Доступность = Ложь;
	Элементы.ВариантОценкиДлинаШвовМногофактурный.Доступность = Ложь;
	Элементы.ВариантОценкиКривые.Доступность = Ложь;
	Элементы.ВариантОценкиУглы.Доступность = Ложь;
	Элементы.ВариантОценкиФотопечать.Доступность = Ложь;
	
	ОбщийМодульКлиентСервер.ЗаполнитьПризнакПересеченияИнтерваловВЦенахНаУслугиПроизводства(Объект.Углы);
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	// принудительно пропишем последнее значение как самое большое, чтобы избежать ошибок, если пользователь этого не сделал сам
	ПроверитьИУстановитьПоследнееЗначение("Углы");
	ПроверитьИУстановитьПоследнееЗначение("ВырезыApply");
	ПроверитьИУстановитьПоследнееЗначение("Фотопечать");
	ПроверитьИУстановитьПоследнееЗначение("ДлинаШвов");
	ПроверитьИУстановитьПоследнееЗначение("ДлинаПользовательскихШвов");
	ПроверитьИУстановитьПоследнееЗначение("ВнутренниеВырезы");
	ПроверитьИУстановитьПоследнееЗначение("Кривые");
	ПроверитьИУстановитьПоследнееЗначение("ДлинаШвовМногофактурный");
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	//проверим уникальность
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЦеныУслугРаскроя.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ЦеныУслугРаскроя КАК ЦеныУслугРаскроя
	|ГДЕ
	|	ЦеныУслугРаскроя.Дата = &Дата
	|	И ЦеныУслугРаскроя.Ссылка <> &Ссылка
	|	И ВЫБОР
	|			КОГДА &ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийУстановкиЦенНаУслугиПроизводства.ПоВидуЦен)
	|				ТОГДА ЦеныУслугРаскроя.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийУстановкиЦенНаУслугиПроизводства.ПоВидуЦен)
	|						И ЦеныУслугРаскроя.ВидЦен = &ВидЦен
	|			КОГДА &ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийУстановкиЦенНаУслугиПроизводства.ПоИнтеркампани)
	|				ТОГДА ЦеныУслугРаскроя.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийУстановкиЦенНаУслугиПроизводства.ПоИнтеркампани)
	|						И ЦеныУслугРаскроя.НастройкаИнтеркампани = &НастройкаИнтеркампани
	|			КОГДА &ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийУстановкиЦенНаУслугиПроизводства.ДляВнутреннихЗаказов)
	|				ТОГДА ЦеныУслугРаскроя.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийУстановкиЦенНаУслугиПроизводства.ДляВнутреннихЗаказов)
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ";
	Запрос.УстановитьПараметр("Дата", Объект.Дата);
	Запрос.УстановитьПараметр("ВидОперации", Объект.ВидОперации);
	Запрос.УстановитьПараметр("ВидЦен", Объект.ВидЦен);
	Запрос.УстановитьПараметр("НастройкаИнтеркампани", Объект.НастройкаИнтеркампани);
	Запрос.УстановитьПараметр("Ссылка", Объект.Ссылка);
	
	Если Запрос.Выполнить().Выбрать().Количество() > 0 Тогда
		Отказ = Истина;
		Сообщить("На дату " + Формат(Объект.Дата,"ДЛФ=Д") + " уже имеется запись с видом операции """ + Объект.ВидОперации + """. Запись отменена");
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	ОбщийМодульКлиентСервер.ЗаполнитьПризнакПересеченияИнтерваловВЦенахНаУслугиПроизводства(Объект.Углы);
	
КонецПроцедуры

&НаСервере
Процедура ПроверитьИУстановитьПоследнееЗначение(ИмяТаблицы)
	
	КоличествоЗаписейВТаблице = Объект[ИмяТаблицы].Количество();
	Если КоличествоЗаписейВТаблице > 0 Тогда
		Если НЕ Объект[ИмяТаблицы][КоличествоЗаписейВТаблице-1].КоличествоДо = 999999 Тогда
			Объект[ИмяТаблицы][КоличествоЗаписейВТаблице-1].КоличествоДо = 999999;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПоУмолчанию(Команда)
	
	//Определим вкладку
	ТекущаяВкладка = Элементы.Страницы.ТекущаяСтраница.Имя;
	
	//"ГруппаУглы" - "Углы"
	ТЧ = Прав(ТекущаяВкладка, СтрДлина(ТекущаяВкладка)-6);
	
	Если НЕ ЗначениеЗаполнено(ТЧ) Тогда
		Возврат;
	КонецЕсли;
	
	Если Объект[ТЧ].Количество() = 0 Тогда
		ДобавитьУслугиПоУмолчанию(ТЧ);
	Иначе
		ОП = новый ОписаниеОповещения("ПослеВопросаОбОчисткеТабличнойЧасти", ЭтотОбъект, новый Структура("ТЧ", ТЧ));
		ПоказатьВопрос(ОП, "Табличная часть " + ТЧ + " будет очищена, продолжить?", РежимДиалогаВопрос.ДаНет);
	КонецЕсли;		
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВопросаОбОчисткеТабличнойЧасти(Ответ, ДопПараметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Да Тогда
		Объект[ДопПараметры.ТЧ].Очистить();
		ДобавитьУслугиПоУмолчанию(ДопПараметры.ТЧ);
	КонецЕсли;	
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьУслугиПоУмолчанию(ТЧ)
	
	Если ТЧ = "Углы" Тогда
		Номенклатура1 = Справочники.Номенклатура.НайтиПоНаименованию("Углы (раскрой)");
		Номенклатура2 = Справочники.Номенклатура.НайтиПоНаименованию("Угол бесплатный (раскрой)");		
	ИначеЕсли ТЧ = "ВырезыApply" Тогда
		Номенклатура1 = Справочники.Номенклатура.НайтиПоНаименованию("Apply вырез");
	ИначеЕсли ТЧ = "Фотопечать" Тогда
		Номенклатура1 = Справочники.Номенклатура.НайтиПоНаименованию("Фотопечать");
	ИначеЕсли ТЧ = "ДлинаШвов" Тогда
		Номенклатура1 = Справочники.Номенклатура.НайтиПоНаименованию("Прямолинейный шов");
	ИначеЕсли ТЧ = "ДлинаШвовМногофактурный" Тогда
		Номенклатура1 = Справочники.Номенклатура.НайтиПоНаименованию("Прямолинейный шов");
	ИначеЕсли ТЧ = "ДлинаПользовательскихШвов" Тогда
		Номенклатура1 = Справочники.Номенклатура.НайтиПоНаименованию("Криволинейный шов");
	ИначеЕсли ТЧ = "ВнутренниеВырезы" Тогда
		Номенклатура1 = Справочники.Номенклатура.НайтиПоНаименованию("Внутренний вырез (раскрой)");
	ИначеЕсли ТЧ = "Кривые" Тогда
		Номенклатура1 = Справочники.Номенклатура.НайтиПоНаименованию("Криволинейный участок (раскрой)");	
	КонецЕсли;
	
	Если ТЧ = "Углы" И Номенклатура2 <> Неопределено И НЕ Номенклатура2.Пустая() Тогда
		НоваяСтрока = Объект[ТЧ].Добавить();
		НоваяСтрока.Номенклатура = Номенклатура2;
		НоваяСтрока.КоличествоДо = 4;
	КонецЕсли;
	
	Если Номенклатура1 <> Неопределено И НЕ Номенклатура1.Пустая() Тогда
		НоваяСтрока = Объект[ТЧ].Добавить();
		НоваяСтрока.Номенклатура = Номенклатура1;
		НоваяСтрока.КоличествоДо = 999999;
		Если ТЧ = "Углы" Тогда
			НоваяСтрока.КоличествоОт = 5;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьЭлементов()
	
	Элементы.НастройкаИнтеркампани.Видимость = (Объект.ВидОперации = Перечисления.ВидыОперацийУстановкиЦенНаУслугиПроизводства.ПоИнтеркампани);
	Элементы.ВидЦен.Видимость 				 = (Объект.ВидОперации = Перечисления.ВидыОперацийУстановкиЦенНаУслугиПроизводства.ПоВидуЦен);
	
	Элементы.СтоимостьУслугиЦентровкиШва.Видимость = Истина;
	Элементы.СтоимостьЦентровкиШваНеВключаетСтоимостьУслуг.Видимость = Истина;
	Если Объект.ВидОперации = Перечисления.ВидыОперацийУстановкиЦенНаУслугиПроизводства.ПоИнтеркампани Тогда
		Если Объект.НастройкаИнтеркампани.ОднаОрганизацияПроизводстваИПродажиПотолков Тогда
			Элементы.СтоимостьУслугиЦентровкиШва.Видимость = Ложь;
			Элементы.СтоимостьЦентровкиШваНеВключаетСтоимостьУслуг.Видимость = Ложь;
		КонецЕсли;

	ИначеЕсли Объект.ВидОперации = Перечисления.ВидыОперацийУстановкиЦенНаУслугиПроизводства.ДляВнутреннихЗаказов И НЕ ОтображатьЦеныВоВнутреннихЗаказах Тогда
		Элементы.СтоимостьУслугиЦентровкиШва.Видимость = Ложь;
		Элементы.СтоимостьЦентровкиШваНеВключаетСтоимостьУслуг.Видимость = Ложь;

	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВидОперацииПриИзменении(Элемент)
	
	УстановитьЗначениеНастроекИнтеркампани();
	УстановитьВидимостьЭлементов();
	
КонецПроцедуры

&НаСервере
Процедура УстановитьЗначениеНастроекИнтеркампани()
	
	Если Объект.ВидОперации = Перечисления.ВидыОперацийУстановкиЦенНаУслугиПроизводства.ПоИнтеркампани Тогда
		НастройкаИнтеркампаниОднаОрганизацияПроизводстваИПродажиПотолков = Объект.НастройкаИнтеркампани.ОднаОрганизацияПроизводстваИПродажиПотолков;
	Иначе
		НастройкаИнтеркампаниОднаОрганизацияПроизводстваИПродажиПотолков = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформление()

	УсловноеОформление.Элементы.Очистить();
	
	//ДляИнтеркампани И НастройкаИнтеркампани.ОднаОрганизацияПроизводстваИПродажиПотолков
	Элемент = УсловноеОформление.Элементы.Добавить();
	Элемент.Представление = "Цены по интеркампани";
	
	Для каждого ТабличнаяЧасть из Метаданные.Справочники.ЦеныУслугРаскроя.ТабличныеЧасти Цикл
		Если ТабличнаяЧасть.Реквизиты.Найти("Цена") <> Неопределено Тогда
			ИмяПоля = ТабличнаяЧасть.Имя + "Цена";
			ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
			ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(ИмяПоля);
		КонецЕсли;
	КонецЦикла;
			
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных("УглыЦена");
	
	ГруппаОтбора1 = Элемент.Отбор.Элементы.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
	ГруппаОтбора1.ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИЛИ;
	
	ГруппаОтбора2 = ГруппаОтбора1.Элементы.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
	ГруппаОтбора2.ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИ;
	
	ОтборЭлемента = ГруппаОтбора2.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.ВидОперации");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Перечисления.ВидыОперацийУстановкиЦенНаУслугиПроизводства.ПоИнтеркампани;
	
	ОтборЭлемента = ГруппаОтбора2.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("НастройкаИнтеркампаниОднаОрганизацияПроизводстваИПродажиПотолков");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Истина;
	
	ГруппаОтбора3 = ГруппаОтбора1.Элементы.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
	ГруппаОтбора3.ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИ;
	
	ОтборЭлемента = ГруппаОтбора3.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.ВидОперации");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Перечисления.ВидыОперацийУстановкиЦенНаУслугиПроизводства.ДляВнутреннихЗаказов;
	
	ОтборЭлемента = ГруппаОтбора3.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ОтображатьЦеныВоВнутреннихЗаказах");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Ложь;
	
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", WebЦвета.Серый);
	Элемент.Оформление.УстановитьЗначениеПараметра("Текст", "(не требуется)");
	Элемент.Оформление.УстановитьЗначениеПараметра("Доступность", Ложь);

	// подсветка пересекающихся диапазонов
	Элемент = УсловноеОформление.Элементы.Добавить();
	Элемент.Представление = "Пересекающиеся диапазоны";
	
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных("Углы");
	
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.Углы.ЕстьПересечение");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Истина;
	
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветФона", WebЦвета.ЛососьСветлый);
	
КонецПроцедуры		

&НаКлиенте
Процедура НастройкаИнтеркампаниПриИзменении(Элемент)
	НастройкаИнтеркампаниПриИзмененииНаСервере();
КонецПроцедуры

&НаСервере
Процедура НастройкаИнтеркампаниПриИзмененииНаСервере()
	НастройкаИнтеркампаниОднаОрганизацияПроизводстваИПродажиПотолков = Объект.НастройкаИнтеркампани.ОднаОрганизацияПроизводстваИПродажиПотолков;
КонецПроцедуры

&НаКлиенте
Процедура УглыПриИзменении(Элемент)
	
	ОбщийМодульКлиентСервер.ЗаполнитьПризнакПересеченияИнтерваловВЦенахНаУслугиПроизводства(Объект.Углы);
	
КонецПроцедуры



