&НаСервере
Функция ОткрытьФотоНаСервере()
	ТекОбъект = РеквизитФормыВЗначение("Объект");
	Хранилище = ТекОбъект.Фото.Получить();
	Если Не Хранилище = Неопределено Тогда
		Возврат ПоместитьВоВременноеХранилище(Хранилище, ЭтаФорма.УникальныйИдентификатор);
	КонецЕсли;
КонецФункции

&НаКлиенте
Процедура ФотоНажатие(Элемент, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	АдресФайла = ОткрытьФотоНаСервере();
	Если Не АдресФайла = Неопределено Тогда
		ПолучитьФайл(АдресФайла, СокрЛП(Объект.Наименование) + ".jpg");
	Иначе
		Если Вопрос("Изображение отсутствует. Загрузить?", РежимДиалогаВопрос.ДаНет) = КодВозвратаДиалога.Да Тогда
			ИзменитьФото(Неопределено);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаСервереБезКонтекста
Функция НавигационнаяСсылкаКартинки(Данные, ИдентификаторФормы)
	Хранилище = Новый ХранилищеЗначения(Данные);
	АдресКартинки = ПоместитьВоВременноеХранилище(Хранилище.Получить(), ИдентификаторФормы);
	Возврат АдресКартинки;
КонецФункции

&НаКлиенте
Процедура ИзменитьФото(Команда)
	Режим = РежимДиалогаВыбораФайла.Открытие;
	ДиалогОткрытияФайла = Новый ДиалогВыбораФайла(Режим);
	ДиалогОткрытияФайла.ПолноеИмяФайла = "";
	ДиалогОткрытияФайла.МножественныйВыбор = Ложь;
	ДиалогОткрытияФайла.Фильтр = "Все картинки (*.bmp;*.gif;*.png;*.jpeg;*.dib;*.rle;*.tif;*.jpg;*.ico;*.wmf;*.emf)|*.bmp;*.gif;*.png;*.jpeg;*.dib;*.rle;*.tif;*.jpg;*.ico;*.wmf;*.emf"
		                            + "|Все файлы(*.*)|*.*"
		                            + "|Формат bmp(*.bmp*;*.dib;*.rle)|*.bmp;*.dib;*.rle"
		                            + "|Формат GIF(*.gif*)|*.gif"
		                            + "|Формат JPEG(*.jpeg;*.jpg)|*.jpeg;*.jpg"
		                            + "|Формат PNG(*.png*)|*.png"
		                            + "|Формат TIFF(*.tif)|*.tif"
		                            + "|Формат icon(*.ico)|*.ico"
		                            + "|Формат метафайл(*.wmf;*.emf)|*.wmf;*.emf";
	ДиалогОткрытияФайла.Заголовок = "Выберите изображение";
	Если ДиалогОткрытияФайла.Выбрать() Тогда
		МассивФайлов = ДиалогОткрытияФайла.ВыбранныеФайлы;
		Для Каждого ИмяФайла Из МассивФайлов Цикл
			Попытка
				Фото = НавигационнаяСсылкаКартинки(Новый ДвоичныеДанные(ИмяФайла), УникальныйИдентификатор);
				Модифицированность = Истина;
			Исключение
				Сообщить("Не удалось прикрепить изображение! " + ОписаниеОшибки(), СтатусСообщения.Важное);
			КонецПопытки;
		КонецЦикла;
	Иначе
		Предупреждение("Изображение не выбрано!");
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьФото(Команда)
	Если ЗначениеЗаполнено(Фото) Тогда
		Фото = "";
		Модифицированность = Истина;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ВыполняетЗамерыПриИзменении(Элемент)
