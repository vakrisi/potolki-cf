&НаСервере
Процедура ЗаполнитьРасшифровкуПодписиНаСервере()
	
	Перем РасшифровкаПодписи, ОснованиеПраваПодписи;
	
	Если ЗначениеЗаполнено(Объект.Наименование) Тогда
		РасшифровкаПодписи = Объект.Наименование; //ОбщийМодуль.ФамилияИнициалы(Объект.Наименование);		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(РасшифровкаПодписи)
		И ЗначениеЗаполнено(Объект.ДокументПраваПодписи) Тогда
		
		ОснованиеПраваПодписи =
			Объект.ДокументПраваПодписи 
			+ ?(ПустаяСтрока(Объект.НомерДокументаПраваПодписи), "", " № " + Объект.НомерДокументаПраваПодписи)
			+ ?(НЕ ЗначениеЗаполнено(Объект.ДатаДокументаПраваПодписи),  "", " " + НСтр("ru = 'от'") + " " + Формат(Объект.ДатаДокументаПраваПодписи, "ДЛФ=D") + " " + НСтр("ru = 'г.'"));

			
		ШаблонСтроки = НСтр("ru ='%1 (%2)'");
		РасшифровкаПодписи = СтрШаблон(ШаблонСтроки, РасшифровкаПодписи, ОснованиеПраваПодписи);
		
	КонецЕсли;
	
	Объект.РасшифровкаПодписи = РасшифровкаПодписи;
	
КонецПроцедуры	
