КонецПроцедуры

&НаСервереБезКонтекста
Процедура СохранитьВАрхивНаСервере(программа)
	АрхивПрограммы = Справочники.ИА_СтратегическоеУправление.СоздатьЭлемент();
	ЗаполнитьЗначенияСвойств(АрхивПрограммы, программа, ,"Код, Ссылка, Владелец");
	АрхивПрограммы.ЭтоАрхив = истина;
	АрхивПрограммы.СсылкаНаКоррЭлемент = программа; 
	АрхивПрограммы.ДатаАрхива = ТекущаяДата();
	АрхивПрограммы.Наименование = "[Архив от "+ТекущаяДата()+"] " + АрхивПрограммы.Наименование;
	АрхивПрограммы.Содержание = "[Архив от "+ТекущаяДата()+"] " + АрхивПрограммы.Содержание;
	АрхивПрограммы.Права.Загрузить(программа.Права.Выгрузить());
	АрхивПрограммы.Записать();
	
	СкопироватьЭлементы(программа, АрхивПрограммы.Ссылка);
КонецПроцедуры

&НаСервереБезКонтекста
Процедура СкопироватьЭлементы(изПрограммы, вПрограмму)
	Выборка = Справочники.ИА_СтратегическоеУправление.Выбрать(изПрограммы);
	Пока Выборка.Следующий() Цикл
		НовЭлемент = Справочники.ИА_СтратегическоеУправление.СоздатьЭлемент();
		ЗаполнитьЗначенияСвойств(НовЭлемент, Выборка, ,"Код, Ссылка, Родитель, Владелец");
		НовЭлемент.ЭтоАрхив = истина;
		НовЭлемент.Родитель = вПрограмму;
		НовЭлемент.Права.Загрузить(Выборка.Права.Выгрузить());
		НовЭлемент.Записать();	
		
		СкопироватьЭлементы(Выборка.Ссылка, НовЭлемент.Ссылка);
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура СохранитьВАрхив(Команда)
	СохранитьВАрхивНаСервере(Объект.Ссылка);
КонецПроцедуры

