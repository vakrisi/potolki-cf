Процедура НайтиАвтоПодбор(Элемент, Текст, ДанныеВыбора, ПараметрыПолученияДанных, Ожидание, СтандартнаяОбработка)

	ТекстПоиска = ?(ПустаяСтрока(Текст), Найти, Текст);
	ПодключитьОбработчикОжидания("НайтиИЗаполнитьСписокГородов", 0.2, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура НайтиОчистка(Элемент, СтандартнаяОбработка)
	
	ЗаполнитьСписок();
	
	СтрокиСубъектов = СписокГородов.ПолучитьЭлементы();
	Для каждого СтрокаСубъекта из СтрокиСубъектов Цикл
		Элементы.СписокГородов.Свернуть(СтрокаСубъекта.ПолучитьИдентификатор());
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура НайтиИЗаполнитьСписокГородов()
	
	ЗаполнитьСписок(ТекстПоиска);
	
	СтрокиСубъектов = СписокГородов.ПолучитьЭлементы();
	Для каждого СтрокаСубъекта из СтрокиСубъектов Цикл
		Элементы.СписокГородов.Развернуть(СтрокаСубъекта.ПолучитьИдентификатор(), Истина);
	КонецЦикла;
	
КонецПроцедуры

