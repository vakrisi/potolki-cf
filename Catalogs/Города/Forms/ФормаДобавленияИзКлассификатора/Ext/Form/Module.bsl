&НаКлиенте
Процедура ВыбратьКлиент()
	
	Результат = Новый Массив;
	
	СтрокиСубъектов = СписокГородовИсходный.ПолучитьЭлементы();
	Для каждого СтрокаСубъекта из СтрокиСубъектов Цикл
		СтрокиГородов = СтрокаСубъекта.ПолучитьЭлементы();
		Для каждого СтрокаГорода из СтрокиГородов Цикл
			Если СтрокаГорода.Пометка Тогда
				Результат.Добавить(Новый Структура("Город, КодКЛАДР", СтрокаГорода.Город, СтрокаГорода.КодКЛАДР));
			КонецЕсли;
			
			СтрокиПодчиненных = СтрокаГорода.ПолучитьЭлементы();
			Для каждого СтрокаПодчиненная из СтрокиПодчиненных Цикл
				Если СтрокаПодчиненная.Пометка Тогда
					Результат.Добавить(Новый Структура("Город, КодКЛАДР", СтрокаПодчиненная.Город, СтрокаПодчиненная.КодКЛАДР));
				КонецЕсли;
			КонецЦикла;
		
		КонецЦикла;
	КонецЦикла;
	
	Закрыть(Новый Структура("Города, ИспользуетсяВРознице, ИспользуетсяВПроизводстве", Результат, ИспользуетсяВРознице, ИспользуетсяВПроизводстве));
	
КонецПроцедуры

