&НаСервере
Процедура УстановитьУсловноеОформление()
	
	УсловноеОформление.Элементы.Очистить();
	
	// оформление строки 
	Элемент = УсловноеОформление.Элементы.Добавить();

	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.СписокГородовГород.Имя);
	
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("СписокГородов.Уровень");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = 1;

	Элемент.Оформление.УстановитьЗначениеПараметра("Видимость", Ложь);
	
	// оформление строки 
	Элемент = УсловноеОформление.Элементы.Добавить();

	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.СписокГородовСубъектРФ.Имя);
	
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("СписокГородов.Уровень");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.НеРавно;
	ОтборЭлемента.ПравоеЗначение = 1;

	Элемент.Оформление.УстановитьЗначениеПараметра("Видимость", Ложь);

	// оформление строки 
	Элемент = УсловноеОформление.Элементы.Добавить();

	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.СписокГородовПометка.Имя);
	
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("СписокГородов.Уровень");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = 1;

	Элемент.Оформление.УстановитьЗначениеПараметра("Доступность", Ложь);
	Элемент.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
	
	// оформление строки 
	Элемент = УсловноеОформление.Элементы.Добавить();

	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.СписокГородовСубъектРФ.Имя);
	
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("СписокГородов.Уровень");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = 1;

	Элемент.Оформление.УстановитьЗначениеПараметра("Шрифт", Новый Шрифт(, , Истина)); // жирным
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСписокГородовОбработчикОжидания()
	
	//ОбновитьСписокГородовСервер();
	
	Элементы.ГруппаФоновоеЗаполнение.Видимость = Истина;
	
	ПараметрыОбмена = Новый Структура;
	
	ДлительнаяОперация = ВыполнитьЗаполнениеНаСервере(ПараметрыОбмена);
	ИдентификаторЗадания = ДлительнаяОперация.ИдентификаторЗадания;
	
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ВыводитьОкноОжидания = Ложь;
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ПриЗавершенииОперацииЗаполнения", ЭтотОбъект);
	ДлительныеОперацииКлиент.ОжидатьЗавершение(ДлительнаяОперация, ОписаниеОповещения, ПараметрыОжидания);
		
КонецПроцедуры

&НаСервере
Функция ВыполнитьЗаполнениеНаСервере(ПараметрыОбмена)
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = НСтр("ru = 'Заполнение списка городов'");
	
	Результат = ДлительныеОперации.ВыполнитьВФоне("Справочники.Города.ЗаполнитьСписокГородовИнтерактивно", ПараметрыОбмена, ПараметрыВыполнения);
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ПриЗавершенииОперацииЗаполнения(Результат, ДополнительныеПараметры) Экспорт
	
	Элементы.ГруппаФоновоеЗаполнение.Видимость = Ложь;
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Результат.Статус = "Ошибка" Тогда
			
		ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Заполнение прервано по причине:
				|%1'"),
			Результат.КраткоеПредставлениеОшибки);
			
		Сообщить(ТекстОшибки);
		
		Возврат;
	КонецЕсли;

	ОбработатьРезультатЗаполненияГородовНаСервере(Результат.АдресРезультата);
	
КонецПроцедуры

&НаСервере
Процедура ОбработатьРезультатЗаполненияГородовНаСервере(АдресРезультата)
	
	Данные = ПолучитьИзВременногоХранилища(АдресРезультата);
	
	Если НЕ ЗначениеЗаполнено(Данные) Тогда
		Возврат;
	КонецЕсли;
	
	ЗначениеВРеквизитФормы(Данные.ДеревоГородов, "СписокГородов");
	ЗначениеВРеквизитФормы(Данные.ДеревоГородов, "СписокГородовИсходный");
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписок(ТекстПоиска = "")
	
	ДеревоОригинал = РеквизитФормыВЗначение("СписокГородовИсходный");
	ДеревоГородов = РеквизитФормыВЗначение("СписокГородов");
	// Замещаем основное дерево, данными из оригинала
	ДеревоГородов = ДеревоОригинал.Скопировать(); 
	
	Если ТекстПоиска = "" Тогда		
		ЗначениеВРеквизитФормы(ДеревоГородов, "СписокГородов");
		Возврат;		
	КонецЕсли;
	
	// Надо поставить отбор
	СтрокиСубъектов = ДеревоГородов.Строки;
		
	Для Каждого СтрокаСубъекта Из СтрокиСубъектов Цикл
		
		СтрокиКУдалению = Новый Массив;
		
		СтрокиГНП = СтрокаСубъекта.Строки;
		Для каждого СтрокаГНП из СтрокиГНП Цикл
			
			ЕстьВПодчиненных = Ложь;
			СтрокиКУдалениюПодч = Новый Массив;
			СтрокиПодчиненных = СтрокаГНП.Строки;
			Для каждого СтрокаПодчиненных из СтрокиПодчиненных Цикл			
				Если СтрНайти(НРег(СтрокаПодчиненных.Город), НРег(ТекстПоиска)) = 0 Тогда				
					СтрокиКУдалениюПодч.Добавить(СтрокаПодчиненных);
				Иначе
					ЕстьВПодчиненных = Истина;
				КонецЕсли;		
			КонецЦикла;
			Для Каждого СтрокаКУдалению Из СтрокиКУдалениюПодч Цикл				
				СтрокиПодчиненных.Удалить(СтрокаКУдалению);				
			КонецЦикла;
			
			Если ЕстьВПодчиненных Тогда
				Продолжить;
			КонецЕсли;
			
			Если СтрНайти(НРег(СтрокаГНП.Город), НРег(ТекстПоиска)) = 0 Тогда				
				СтрокиКУдалению.Добавить(СтрокаГНП);
			КонецЕсли;		
		КонецЦикла;			
			
		Для Каждого СтрокаКУдалению Из СтрокиКУдалению Цикл				
			СтрокиГНП.Удалить(СтрокаКУдалению);				
		КонецЦикла;
			
	КонецЦикла;
	
	// Передаем на форму, наше обновленное дерево
	ЗначениеВРеквизитФормы(ДеревоГородов, "СписокГородов");
	
КонецПроцедуры

#КонецОбласти



