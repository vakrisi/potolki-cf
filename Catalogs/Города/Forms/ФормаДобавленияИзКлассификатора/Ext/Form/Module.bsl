&НаКлиенте
Процедура СписокГородовПометкаПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.СписокГородов.ТекущиеДанные;
	
	ВыбранныеГорода = "";
	// запоминаем состояние пометок
	СтрокиСубъектов = СписокГородовИсходный.ПолучитьЭлементы();
	Для каждого СтрокаСубъекта из СтрокиСубъектов Цикл
		СтрокиГНП = СтрокаСубъекта.ПолучитьЭлементы();
		Для каждого СтрокаГНП из СтрокиГНП Цикл
			Если СтрокаГНП.Город = ТекущиеДанные.Город И СтрокаГНП.УИ = ТекущиеДанные.УИ Тогда
				СтрокаГНП.Пометка = ТекущиеДанные.Пометка;
			КонецЕсли;
			Если СтрокаГНП.Пометка Тогда
				ВыбранныеГорода = ВыбранныеГорода + ?(ПустаяСтрока(ВыбранныеГорода), "", "; ") + СтрокаГНП.Город;
			КонецЕсли;
			
			СтрокиПодчиненныхГНП = СтрокаГНП.ПолучитьЭлементы();
			Для каждого СтрокаПГНП из СтрокиПодчиненныхГНП Цикл
				Если СтрокаПГНП.Город = ТекущиеДанные.Город И СтрокаПГНП.УИ = ТекущиеДанные.УИ Тогда
					СтрокаПГНП.Пометка = ТекущиеДанные.Пометка;
				КонецЕсли;
				Если СтрокаПГНП.Пометка Тогда
					ВыбранныеГорода = ВыбранныеГорода + ?(ПустаяСтрока(ВыбранныеГорода), "", "; ") + СтрокаПГНП.Город;
				КонецЕсли;
			КонецЦикла;			
		КонецЦикла;	
	КонецЦикла;
	
КонецПроцедуры

