				<QueryText>ВЫБРАТЬ
	ИА_БПКартыМаршрутов.Ссылка,
	ИА_БПКартыМаршрутов.ВерсияДанных,
	ИА_БПКартыМаршрутов.ПометкаУдаления,
	ИА_БПКартыМаршрутов.Предопределенный,
	ИА_БПКартыМаршрутов.Родитель,
	ИА_БПКартыМаршрутов.ЭтоГруппа,
	ИА_БПКартыМаршрутов.Код,
	ИА_БПКартыМаршрутов.Наименование,
	ИА_БПКартыМаршрутов.Карта,
	ИА_БПКартыМаршрутов.Описание,
	ИА_БПКартыМаршрутов.МаршрутЗадач,
	ИА_БПКартыМаршрутов.Версия,
	ВложенныйЗапрос.Записан,
	ВложенныйЗапрос.Выполняется,
	ВложенныйЗапрос.Завершен
ИЗ
	Справочник.ИА_БПКартыМаршрутов КАК ИА_БПКартыМаршрутов
		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			ИА_БПНоситель.ИА_КартаМаршрутаБП КАК ИА_КартаМаршрутаБП,
			ИА_БПНоситель.ИА_МаршрутЗадачБП КАК ИА_МаршрутЗадачБП,
			КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВЫБОР
					КОГДА НЕ ИА_БПНоситель.Стартован
						ТОГДА ИА_БПНоситель.Ссылка
					ИНАЧЕ NULL
				КОНЕЦ) КАК Записан,
			КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВЫБОР
					КОГДА ИА_БПНоситель.Стартован
							И НЕ ИА_БПНоситель.Завершен
						ТОГДА ИА_БПНоситель.Ссылка
					ИНАЧЕ NULL
				КОНЕЦ) КАК Выполняется,
			КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВЫБОР
					КОГДА ИА_БПНоситель.Стартован
							И ИА_БПНоситель.Завершен
						ТОГДА ИА_БПНоситель.Ссылка
					ИНАЧЕ NULL
				КОНЕЦ) КАК Завершен
		ИЗ
			БизнесПроцесс.ИА_БПНоситель КАК ИА_БПНоситель
		ГДЕ
			ИА_БПНоситель.ИА_МаршрутЗадачБП = &amp;МаршрутЗадач
			И НЕ ИА_БПНоситель.ПометкаУдаления
		
		СГРУППИРОВАТЬ ПО
			ИА_БПНоситель.ИА_КартаМаршрутаБП,
			ИА_БПНоситель.ИА_МаршрутЗадачБП) КАК ВложенныйЗапрос
		ПО ИА_БПКартыМаршрутов.Ссылка = ВложенныйЗапрос.ИА_КартаМаршрутаБП
			И ИА_БПКартыМаршрутов.МаршрутЗадач = ВложенныйЗапрос.ИА_МаршрутЗадачБП
ГДЕ
	ИА_БПКартыМаршрутов.МаршрутЗадач = &amp;МаршрутЗадач</QueryText>
