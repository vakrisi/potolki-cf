&НаКлиенте
Процедура ГрупповаяУстановкаРеквизитовТочек(Команда)
    РежимПакетнойУстановкиРеквизитовТочек     = НЕ РежимПакетнойУстановкиРеквизитовТочек;
    Если РежимПакетнойУстановкиРеквизитовТочек Тогда
    	Пакет_Ответственный = Истина;
        Пакет_ДлительностьВыполнения = Истина;
    КонецЕсли; 
    
    Элементы.ФормаГрупповаяУстановкаРеквизитовТочек.Пометка = РежимПакетнойУстановкиРеквизитовТочек;
    УстановитьВидимостьДоступность();
КонецПроцедуры

&НаКлиенте
Процедура УстановитьРеквизиты(Команда)
    Пакет_ПроверитьТаблицуНаСервере();
    Если ТаблицаТочек.Количество() = 0 Тогда
    	ИА_БФКС.СообщениеОбОшибке("Нет точек для установки!"); 
        Возврат;
    КонецЕсли; 
    Если НЕ Пакет_Ответственный
        И НЕ Пакет_ДлительностьВыполнения
        Тогда
        ИА_БФКС.СообщениеОбОшибке("Не заданы устанавливаемые реквизиты!"); 
    	Возврат
    КонецЕсли; 
    
    ПерваяТочка = ТаблицаТочек[0].Точка;
    СписокТочек = Новый Массив;
    Для каждого Стр Из ТаблицаТочек Цикл
    	СписокТочек.Добавить(Стр.Точка);
    КонецЦикла; 
    ДанныеПакета = Новый Структура("СписокТочек, Пакет_Ответственный, Пакет_ДлительностьВыполнения"
    , СписокТочек
    , Пакет_Ответственный
    , Пакет_ДлительностьВыполнения);
    
    
    П = Новый Структура("Ключ, РежимПакета, ДанныеПакета", ПерваяТочка, Истина, ДанныеПакета);
    ОткрытьФорму("Справочник.ИА_БПТочкиМаршрута.ФормаОбъекта", П
    , ЭтаФорма,,,,, РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);    
КонецПроцедуры

&НаСервере
Процедура УстановитьРеквизитыТочек(ДанныеПакета)
	СписокТочек                  = ДанныеПакета.СписокТочек;
    Пакет_Ответственный          = ДанныеПакета.Пакет_Ответственный;
    Пакет_ДлительностьВыполнения = ДанныеПакета.Пакет_ДлительностьВыполнения;
    
    ПерваяТочка = Неопределено;
    
    Для каждого Точка Из  СписокТочек Цикл
    	Если ПерваяТочка = Неопределено Тогда
        	ПерваяТочка = Точка;
        Иначе
            Спр = Точка.ПолучитьОбъект();
            #ЕСЛИ НЕ( Клиент или Сервер или ВнешнееСоединение ) Тогда
                Спр = Справочники.ИА_БПТочкиМаршрута.СоздатьЭлемент(); ПерваяТочка = Спр.Ссылка;
            #КОНЕЦЕСЛИ
            
            Если Пакет_Ответственный Тогда
                Спр.Ответственный = ПерваяТочка.Ответственный;
                
                Отбор = Новый Структура("Событие", Перечисления.ИА_БПСобытияТочекБП.УстановкаОтветственного);
                ТабСобытие = ИА_БФС.ТЗ_ФильтрПоОтбору(ПерваяТочка.Обработчики.Выгрузить(), Отбор);
                
                Таб = Спр.Обработчики.Выгрузить();
                ИА_БФС.ТЗ_ВставитьТЗПоИзмерениямВДругую(ТабСобытие, Таб, Отбор);
                Спр.Обработчики.Загрузить(Таб);
            КонецЕсли; 
            
            Если Пакет_ДлительностьВыполнения Тогда
                ЗаполнитьЗначенияСвойств(Спр, ПерваяТочка
                , "ВариантДлительности, ДлительностьВыполнения");
            КонецЕсли; 
            
            Спр.Записать();
        КонецЕсли; 
    КонецЦикла; 
    
КонецПроцедуры
 