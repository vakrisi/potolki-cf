&НаКлиенте
Процедура ГрафСхемаВыбор(Элемент)
    Если Элемент.ТекущийЭлемент <> Неопределено Тогда
        
        Если РежимПакетнойУстановкиРеквизитовТочек Тогда
            Точка = ПолучитьТочкуНаСервере(Элемент.ТекущийЭлемент.Имя);
            Если ЗначениеЗаполнено(Точка) Тогда
                Пакет_ДобавитьТочку(Точка);
            КонецЕсли;            
        Иначе
            ОткрытьТочку(Элемент.ТекущийЭлемент.Имя);
        КонецЕсли; 
        
        
    КонецЕсли;     
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьТочку(ИмяТочки)
    Если Объект.Ссылка.Пустая() ИЛИ Модифицированность Тогда
    	ЭтаФорма.Записать();
    КонецЕсли; 
    
    Если НЕ Объект.Ссылка.Пустая() Тогда
        Точка = ПолучитьТочкуНаСервере(ИмяТочки);
        Если ЗначениеЗаполнено(Точка) Тогда
            П = Новый Структура("Ключ, ТолькоПросмотр", Точка, НЕ РежимРедактирования);
            ОткрытьФорму("Справочник.ИА_БПТочкиМаршрута.ФормаОбъекта", П);
        КонецЕсли; 
    КонецЕсли;
КонецПроцедуры

&НаСервере
Функция ПолучитьТочкуНаСервере(ИмяТочки)
    Точка = Справочники.ИА_БПКартыМаршрутов.ПолучитьТочку(Объект.ТекущаяКартаМаршрута, ИмяТочки);
    Возврат Точка;    
КонецФункции

&НаКлиенте
Процедура ТекущаяКартаМаршрутаПриИзменении(Элемент)
    ВывестиСхему();
    ОбновлениеГрафСхемыНачать();
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
    Если НЕ ИА_Защита_Общий.ЛицензияДоступна("НФ", Отказ) Тогда Возврат КонецЕсли; 
    
    ЭтоНовый = Объект.Ссылка.Пустая();
    ВывестиСхему();
    
    Если ЭтоНовый Тогда
        Элементы.странцаВерсииМаршрута.Видимость = Ложь;
    Иначе        
        УстановитьПараметрДС(СписокКарт.Параметры.Элементы, "МаршрутЗадач", Объект.Ссылка);	
    КонецЕсли; 
    СформироватьКоличествоБП();
    ТипыВладельцев_Загрузить();
    
    Контекст = Новый Структура("Параметры, Объект, Форма", Параметры, Объект, ЭтаФорма);
    ИА_БПСПереопределяемый.Формы_Точка_Маршрут_ПриСозданииНаСервере(Контекст);
КонецПроцедуры

&НаКлиенте
Процедура Редактировать(Команда)
    РежимПакетнойУстановкиРеквизитовТочек = Ложь;
    
    Если РежимРедактирования Тогда
        ЭтаФорма.Записать(); // Запишем всё и карту
        РежимРедактирования = Ложь; // Отключим режим
        Элементы.ФормаРедактировать.Пометка = РежимРедактирования;
        
        УстановитьВидимостьДоступность();
        Возврат;
    КонецЕсли; 
    
    
    
    Если НЕ ЗначениеЗаполнено(Объект.ТекущаяКартаМаршрута) Тогда
        НачатьРедактирование(Истина);
    Иначе
        Режим = РежимДиалогаВопрос.ОКОтмена;  
        СЗ = Новый СписокЗначений;
        СЗ.Добавить(КодВозвратаДиалога.Да, "Текущую");
        СЗ.Добавить(КодВозвратаДиалога.Нет, "Создать новую");
        СЗ.Добавить(КодВозвратаДиалога.Отмена, "Отмена");
        Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопроса", ЭтаФорма, Параметры);
        ПоказатьВопрос(Оповещение, "Вы хотите отредактировать текущую карту маршрута или создать новую ?
        |ВНИМАНИЕ! Редактирование текущей карты может привести к неработоспособности уже запущенных по ней процессов", СЗ, 0, КодВозвратаДиалога.Да);
    КонецЕсли; 
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияВопроса(Результат, Параметры) Экспорт
    Если Результат = КодВозвратаДиалога.Да Тогда
        НачатьРедактирование(Ложь);
    ИначеЕсли Результат = КодВозвратаДиалога.Нет Тогда
        НачатьРедактирование(Истина);
    КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
    Если ИмяСобытия = "ОбновитьКарты" И Объект.ТекущаяКартаМаршрута = Параметр Тогда
        ВывестиСхему();
        ОбновлениеГрафСхемыНачать();
        СформироватьКоличествоБП();
    ИначеЕсли ИмяСобытия = "ИА_ТочкаКМИзменена" И Параметр.ВладелецФормы = ЭтаФорма Тогда
        УстановитьРеквизитыТочек(Параметр.ДанныеПакета);
        ТаблицаТочек.Очистить();
        Оповестить("ОбновитьКарты", Объект.ТекущаяКартаМаршрута);
    КонецЕсли; 
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьВсеДанные(Команда)
    Элементы.ГруппаСлужебные.ТолькоПросмотр = Ложь;     
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
    Элементы.странцаВерсииМаршрута.Видимость = Истина;
    УстановитьПараметрДС(СписокКарт.Параметры.Элементы, "МаршрутЗадач", Объект.Ссылка);	
КонецПроцедуры

&НаКлиенте
Процедура НадписьБПНажатие(Элемент)
    Если НЕ Объект.Ссылка.Пустая() Тогда
        Отбор = Новый Структура("ИА_МаршрутЗадачБП, Стартован, Завершен"
        , Объект.Ссылка, Истина, Ложь);
        
        П = Новый Структура("Отбор, ", Отбор);
