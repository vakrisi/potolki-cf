&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьПараметрДС(Элементы, Имя, Значение)
    Эл = Элементы.Найти(Имя);
    Если Эл <> Неопределено Тогда
        Эл.Значение = Значение;
        Эл.Использование = Истина;
    КонецЕсли; 
КонецПроцедуры


&НаКлиенте
Процедура УстановитьВидимостьДоступность()
    Элементы.ГрафСхема.ТолькоПросмотр = НЕ РежимРедактирования;
    
    ////Элементы.кпГрафСхема.Видимость = РежимРедактирования;
    
    Элементы.ФормаГрупповаяУстановкаРеквизитовТочек.Видимость = НЕ РежимРедактирования;
    Элементы.ГруппаПакетнаяОбработка.Видимость = НЕ РежимРедактирования И РежимПакетнойУстановкиРеквизитовТочек;
    
    Элементы.ГруппаРеквизиты.Видимость = НЕ РежимПакетнойУстановкиРеквизитовТочек;
КонецПроцедуры


&НаСервере
Процедура ВывестиСхему()
    Если НЕ РежимРедактирования Тогда
        Карта = Справочники.ИА_БПКартыМаршрутов.ПолучитьКартуМаршрута(Объект.ТекущаяКартаМаршрута);
        ГрафСхема = Карта;
    Иначе
        // Тут заполним "Ответственных"
        Карта = ИА_БФС.КопияОбъекта(ГрафСхема);
        Справочники.ИА_БПКартыМаршрутов.ЗаполнитьВКартеСвязанныеДанные(Карта, Объект.ТекущаяКартаМаршрута);
        ГрафСхема = Карта;
    КонецЕсли; 
КонецПроцедуры

&НаСервере
Процедура СоздатьВерсию()
    Справочники.ИА_БПМаршрутЗадач.СоздатьНовуюВерсиюДляМаршрутаЗадач(Объект.Ссылка);
КонецПроцедуры


&НаКлиенте
Процедура НачатьРедактирование(СоздаватьНовуюВерсию)
    Если Объект.Ссылка.Пустая() ИЛИ Модифицированность Тогда
        ЭтаФорма.Записать();
    КонецЕсли; 
    
    Если НЕ Объект.Ссылка.Пустая()  Тогда
        Если СоздаватьНовуюВерсию Тогда
            СоздатьВерсию();    
            ОповеститьОбИзменении(Объект.Ссылка);
            ЭтаФорма.Прочитать();
            ЭтаФорма.ОбновитьОтображениеДанных();
            ВывестиСхему();
        КонецЕсли; 
        // ИА_Аврамов 15.04.2015  ПоказатьЗначение(,Объект.ТекущаяКартаМаршрута);
        
        Элементы.ФормаРедактировать.Пометка = НЕ Элементы.ФормаРедактировать.Пометка;
        РежимРедактирования = Элементы.ФормаРедактировать.Пометка;
        УстановитьВидимостьДоступность();
    КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура СформироватьКоличествоБП()
    Колво = 0;
    Если НЕ Объект.Ссылка.Пустая() Тогда
        М = Справочники.ИА_БПКартыМаршрутов.ПолучитьСписокБППоКартеМаршрута(Объект.Ссылка, "Стартован И НЕ Завершен");
        Колво = М.Количество();
    КонецЕсли;
    
    Если Колво = 0 Тогда
        Элементы.НадписьБП.Заголовок = "Выполняемых процессов нет";
    Иначе
        Элементы.НадписьБП.Заголовок = "Выполняемых процессов: " + Колво;
    КонецЕсли; 
КонецПроцедуры

&НаКлиенте
Процедура Пакет_ДобавитьТочку(Точка)
	НовСтрока = ТаблицаТочек.Добавить();
    НовСтрока.Точка = Точка;
    
    Пакет_ПроверитьТаблицуНаСервере();
КонецПроцедуры

&НаСервере
Процедура Пакет_ПроверитьТаблицуНаСервере()
    СписокТипов = ИА_БФКС.Массив_Новый(
    Перечисления.ИА_БПТипыТочекМаршрута.Действие
    ,Перечисления.ИА_БПТипыТочекМаршрута.Условие);
    
	ТЗ = ТаблицаТочек.Выгрузить();
    ИА_БФС.ТЗ_УдалитьДубликаты(ТЗ, "Точка");    
    ИА_БФС.ТЗ_УдалитьСтрокиПоУсловию(ТЗ, "НЕ ИА_БФКС.Массив_Содержит(Контекст, СтрокаТЗ.Точка.Тип)", СписокТипов);    
    
    ТаблицаТочек.Загрузить(ТЗ);
КонецПроцедуры
 
 
