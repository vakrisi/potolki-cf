&НаКлиенте
Процедура ШагиПриАктивизацииСтроки(Элемент)
	тд = Элементы.Шаги.ТекущиеДанные;
	Если тд<>Неопределено Тогда
		можноДвигать = ТипЗнч(тд.Содержание)=тип("Строка");
		Элементы.ШагиКнопкаПереместитьВверх.Доступность = можноДвигать;
		Элементы.ШагиКнопкаПереместитьВниз.Доступность = можноДвигать;
	КонецЕсли;
КонецПроцедуры


&НаКлиенте
Процедура ОбновитьСтатистики(Команда)
	ОбновитьСтатистикиСервер();	
КонецПроцедуры

&НаСервере
Процедура ОбновитьСтатистикиСервер()
	для каждого Новстр из Объект.План Цикл
		Новстр.ТекущееЗначениеСтатистики = ИА_Планы.ПолучитьЗначениеСтатистики(Новстр.ВидСтатистики,Новстр.Аналитика1,Новстр.Аналитика2,Новстр.Аналитика3, Объект.ДатаНачала, Объект.Родитель);			
	КонецЦикла;
КонецПроцедуры

