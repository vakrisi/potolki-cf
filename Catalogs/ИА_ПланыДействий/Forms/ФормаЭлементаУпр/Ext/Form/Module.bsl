&НаСервере
Процедура ЗагрузитьСтатистики(МоиПосты)
	Объект.План.Очистить();
	
	Запрос = новый запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ОргСхема.НастройкаСтатистик,
	               |	ОргСхема.Ссылка КАК Пост,
	               |	ОргСхема.ТипТерминала.Порядок КАК Порядок
	               |ПОМЕСТИТЬ Настройки
	               |ИЗ
	               |	Справочник.ОргСхема КАК ОргСхема
	               |ГДЕ
	               |	ОргСхема.Ссылка В(&Ссылка)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ИА_НастройкиРабочегоСтолаСтатистикСтатистики.ВидСтатистики,
	               |	ИА_НастройкиРабочегоСтолаСтатистикСтатистики.Аналитика1,
	               |	ИА_НастройкиРабочегоСтолаСтатистикСтатистики.Аналитика2,
	               |	ИА_НастройкиРабочегоСтолаСтатистикСтатистики.Аналитика3,
	               |	МАКСИМУМ(Настройки.Порядок) КАК Порядок,
	               |	МАКСИМУМ(Настройки.Пост) КАК Пост,
	               |	МИНИМУМ(ИА_НастройкиРабочегоСтолаСтатистикСтатистики.НомерСтроки) КАК НомерСтроки
	               |ПОМЕСТИТЬ РезТЗ
	               |ИЗ
	               |	Справочник.ИА_НастройкиРабочегоСтолаСтатистик.Статистики КАК ИА_НастройкиРабочегоСтолаСтатистикСтатистики
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Настройки КАК Настройки
	               |		ПО (Настройки.НастройкаСтатистик = ИА_НастройкиРабочегоСтолаСтатистикСтатистики.Ссылка)
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ИА_НастройкиРабочегоСтолаСтатистикСтатистики.ВидСтатистики,
	               |	ИА_НастройкиРабочегоСтолаСтатистикСтатистики.Аналитика1,
	               |	ИА_НастройкиРабочегоСтолаСтатистикСтатистики.Аналитика2,
	               |	ИА_НастройкиРабочегоСтолаСтатистикСтатистики.Аналитика3
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ИА_НастройкиРабочегоСтолаСтатистикСтатистики.Пост,
	               |	ИА_НастройкиРабочегоСтолаСтатистикСтатистики.ВидСтатистики,
	               |	ИА_НастройкиРабочегоСтолаСтатистикСтатистики.Аналитика1,
	               |	ИА_НастройкиРабочегоСтолаСтатистикСтатистики.Аналитика2,
	               |	ИА_НастройкиРабочегоСтолаСтатистикСтатистики.Аналитика3,
	               |	ИА_НастройкиРабочегоСтолаСтатистикСтатистики.Порядок КАК Порядок
	               |ИЗ
	               |	РезТЗ КАК ИА_НастройкиРабочегоСтолаСтатистикСтатистики
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Порядок,
	               |	ИА_НастройкиРабочегоСтолаСтатистикСтатистики.НомерСтроки";
	
	Запрос.УстановитьПараметр("Ссылка", МоиПосты);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Новстр = Объект.План.Добавить();
		Новстр.ВидСтатистики = Выборка.ВидСтатистики;
		Новстр.Аналитика1 = Выборка.Аналитика1;
		Новстр.Аналитика2 = Выборка.Аналитика2;
		Новстр.Аналитика3 = Выборка.Аналитика3;
		Новстр.Пост = Выборка.Пост;
		Новстр.ПредыдущийПлан = ИА_Планы.ПолучитьПредыдущуюКвоту(Выборка.ВидСтатистики,Объект.Ответственный,Объект.Родитель, Объект.ДатаНачала);
		Новстр.ТекущееЗначениеСтатистики = ИА_Планы.ПолучитьЗначениеСтатистики(Новстр.ВидСтатистики,Новстр.Аналитика1,Новстр.Аналитика2,Новстр.Аналитика3, Объект.ДатаНачала, Объект.Родитель);			
	КонецЦикла;
	
КонецПроцедуры

