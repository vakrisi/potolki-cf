&НаКлиенте
Процедура СформироватьНаименование()
	объект.Наименование = Строка(Объект.Ответственный)+ " " +  формат(Объект.ДатаНачала,"ДФ=dd.MM.yyyy");
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьНастройкуСтатистики(пПост)
	Возврат пПост.НастройкаСтатистик;
КонецФункции


&НаСервере
Процедура ДобавитьСобытияГугл()
	Если Объект.ДатаНачала = Дата(1,1,1) или Объект.ДатаКонца = Дата(1,1,1) Тогда
		Возврат;
	КонецЕсли;
	
	тд = ПолучитьСтрокуДляДобавления(Перечисления.ИА_ТипыЗадачБП.Задачи);
	
	Если тд = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	КСУ_СобытияКалендаряGoogle.Пользователь,
	               |	КСУ_СобытияКалендаряGoogle.идСобытия КАК идСобытияГугл,
	               |	КСУ_СобытияКалендаряGoogle.ДатаНачала,
	               |	КСУ_СобытияКалендаряGoogle.ДатаКонца,
	               |	КСУ_СобытияКалендаряGoogle.Описание,
	               |	КСУ_СобытияКалендаряGoogle.БезВремени
	               |ИЗ
	               |	РегистрСведений.КСУ_СобытияКалендаряGoogle КАК КСУ_СобытияКалендаряGoogle
	               |ГДЕ
	               |	КСУ_СобытияКалендаряGoogle.Пользователь = &Пользователь
	               |	И КСУ_СобытияКалендаряGoogle.ДатаНачала <= &ДатаКонца
	               |	И КСУ_СобытияКалендаряGoogle.ДатаКонца >= &ДатаНачала";
	Запрос.УстановитьПараметр("Пользователь",объект.Ответственный);
	Запрос.УстановитьПараметр("ДатаНачала", Объект.ДатаНачала);
	Запрос.УстановитьПараметр("ДатаКонца", КонецДня(Объект.ДатаКонца));
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	текСтроки = тд.ПолучитьЭлементы();	
	Новстр = Неопределено;
	Пока Выборка.Следующий() Цикл
		Прерв = ложь;
		для каждого стр1 из текСтроки Цикл
			если стр1.идСобытияГугл = Выборка.идСобытияГугл Тогда
				прерв = истина;
				прервать;
			КонецЕсли;
		КонецЦикла;
		Если прерв Тогда
			продолжить;
		КонецЕсли;
		
		Новстр = текСтроки.Добавить();
		Новстр.идСобытияГугл = Выборка.идСобытияГугл;
		Если ВидГруппировки = Перечисления.КСУ_ГруппировкаЗадачПлана.ПоВидуЗадач Тогда
			Новстр.Группировка = Перечисления.ИА_ТипыЗадачБП.Задачи;
		КонецЕсли;
		Новстр.Содержание = Выборка.Описание;
		Новстр.СрокИсполнения = Выборка.ДатаКонца;
		Новстр.Пост = Объект.Пост;
		Если Выборка.БезВремени тогда
			Новстр.ВремяПлан = Дата(1,1,1,1,0,0);
		Иначе
			Новстр.ВремяПлан =  Дата(1,1,1,0,0,0) + (Выборка.ДатаКонца - Выборка.ДатаНачала);
		КонецЕсли;
	КонецЦикла;
	
	Если Новстр <> Неопределено Тогда 
		Элементы.Шаги.ТекущаяСтрока = Новстр.ПолучитьИдентификатор();
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ДобавитьВсеЗадачи()
	Если Объект.ДатаНачала = Дата(1,1,1) или Объект.ДатаКонца = Дата(1,1,1) Тогда
		Возврат;
	КонецЕсли;
	
	тд = ПолучитьСтрокуДляДобавления(Перечисления.ИА_ТипыЗадачБП.Задачи);
	
	Если тд = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	РегистрСведенийИА_ЗадачиКЦ.ПользовательКЦ,
	               |	РегистрСведенийИА_ЗадачиКЦ.Корзина,
	               |	РегистрСведенийИА_ЗадачиКЦ.Ссылка,
	               |	РегистрСведенийИА_ЗадачиКЦ.Автор,
	               |	РегистрСведенийИА_ЗадачиКЦ.Наименование,
	               |	РегистрСведенийИА_ЗадачиКЦ.Дата,
	               |	РегистрСведенийИА_ЗадачиКЦ.СрокИсполнения,
	               |	РегистрСведенийИА_ЗадачиКЦ.Пользователь,
	               |	РегистрСведенийИА_ЗадачиКЦ.Исполнитель,
	               |	РегистрСведенийИА_ЗадачиКЦ.Пост
	               |ИЗ
	               |	РегистрСведений.ИА_ЗадачиКЦ КАК РегистрСведенийИА_ЗадачиКЦ
	               |ГДЕ
	               |	РегистрСведенийИА_ЗадачиКЦ.ПользовательКЦ = &ПользовательКЦ
	               |	И (РегистрСведенийИА_ЗадачиКЦ.Корзина = &КорзинаВх
	               |			ИЛИ РегистрСведенийИА_ЗадачиКЦ.Корзина = &КорзинаВработе)
	               |	И РегистрСведенийИА_ЗадачиКЦ.СрокИсполнения МЕЖДУ &ДатаНачала И &ДатаКонца";
	Запрос.УстановитьПараметр("ПользовательКЦ",объект.Ответственный);
	Запрос.УстановитьПараметр("КорзинаВх", Справочники.ИА_РасширенияКомцентра.Входящие);
	Запрос.УстановитьПараметр("КорзинаВработе", Справочники.ИА_РасширенияКомцентра.ВРаботе);
	Запрос.УстановитьПараметр("ДатаНачала", Объект.ДатаНачала);
	Запрос.УстановитьПараметр("ДатаКонца", КонецДня(Объект.ДатаКонца));
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	текСтроки = тд.ПолучитьЭлементы();	
	Новстр = Неопределено;
	Пока Выборка.Следующий() Цикл
		Прерв = ложь;
		для каждого стр1 из текСтроки Цикл
			если стр1.ЗадачаОснование = Выборка.ссылка Тогда
				прерв = истина;
				прервать;
			КонецЕсли;
		КонецЦикла;
		Если прерв Тогда
			продолжить;
		КонецЕсли;
		
		Новстр = текСтроки.Добавить();
		Если ВидГруппировки = Перечисления.КСУ_ГруппировкаЗадачПлана.ПоВидуЗадач Тогда
			Новстр.Группировка = Перечисления.ИА_ТипыЗадачБП.Задачи;
		КонецЕсли;
		Новстр.Содержание = Выборка.Наименование;
		Новстр.СрокИсполнения = Выборка.СрокИсполнения;
		Новстр.ЗадачаОснование = Выборка.ссылка;
		Новстр.Пост = Объект.Пост;
		Новстр.ВремяПлан = Дата(1,1,1,1,0,0);
		Новстр.индКартинки = 1;
	КонецЦикла;
	
	Если Новстр <> Неопределено Тогда 
		Элементы.Шаги.ТекущаяСтрока = Новстр.ПолучитьИдентификатор();
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	СокрВид = Константы.КСУ_СокращенныйВидПлана.Получить();
	ВидГруппировки = константы.КСУ_ГруппировкаЗадачПлана.Получить();
	
	Если Объект.Ссылка.Пустая() Тогда
		Объект.Ответственный = ПараметрыСеанса.ТекущийПользователь;
		Если ЗначениеЗаполнено(Параметры.ЗначениеКопирования) Тогда
			Если Параметры.Свойство("Начало") Тогда
				Объект.ДатаНачала = Параметры.Начало;
			Иначе
				Объект.ДатаНачала = Параметры.ЗначениеКопирования.ДатаКонца + 60*60*24 + 1;
			КонецЕсли;
			Объект.ДатаКонца = Объект.ДатаНачала+ 60*60*24 * ?(Параметры.ЗначениеКопирования.Родитель.Пустая(),6,0);
			Объект.Родитель = Параметры.ЗначениеКопирования.Родитель;
			
			Если не Объект.Родитель.Пустая() И Объект.ДатаНачала > Объект.Родитель.ДатаКонца Тогда
				Сообщить("Нельзя создавать дневной план датой больше даты конца недельного.");
				Отказ = Истина;
				Возврат;
			КонецЕсли;
			Объект.Пост = Параметры.ЗначениеКопирования.Пост;
			
			обновитьДерево(Параметры.ЗначениеКопирования, истина,Параметры.ЗадачаОснование);	
			
			Объект.План.Очистить();
		ИначеЕсли ЗначениеЗаполнено(Параметры.Родитель) Тогда
			// если выбрали дневной, то родитель - недельный
			род = ?(Параметры.Родитель.Родитель.Пустая(), Параметры.Родитель, Параметры.Родитель.Родитель); 
			Объект.Родитель = род;
			Если ЗначениеЗаполнено(Параметры.ДатаДневногоПлана) Тогда
				Объект.ДатаНачала = Параметры.ДатаДневногоПлана;
			Иначе
				Объект.ДатаНачала = ПолучитьДатуДневногоПлана(Объект.Родитель);
			КонецЕсли;
			Объект.Пост = Параметры.Родитель.Пост;
			
			Если Объект.ДатаНачала > род.ДатаКонца Тогда
				Сообщить("Нельзя создавать дневной план датой больше даты конца недельного.");
				Отказ = Истина;
				Возврат;
			КонецЕсли;
			
			предПлан = ИА_Планы.ПолучитьДневнойПлан(Объект.Родитель, Объект.ДатаНачала - 60*60*24);
			Если предПлан<>Неопределено Тогда
				обновитьДерево(предПлан, истина,Параметры.ЗадачаОснование);	
			КонецЕсли;
			
			Объект.ДатаКонца = Объект.ДатаНачала;
		ИначеЕсли Параметры.Свойство("Начало") Тогда
				Объект.ДатаНачала = Параметры.Начало;
				Объект.ДатаКонца = Объект.ДатаНачала+ 60*60*24 * ?(Параметры.ЗначениеКопирования.Родитель.Пустая(),6,0);
		КонецЕсли;
		
		Объект.Утверждено = Ложь;
		Объект.ДатаУтверждения = Дата(1,1,1);
		Объект.Утвердил = Справочники.Пользователи.ПустаяСсылка();
		
		Если Дерево.ПолучитьЭлементы().Количество()=0 Тогда
			обновитьДерево(объект.Ссылка);	
		КонецЕсли;
		
		ДобавитьВсеСтратегическиеЗадачи();
		ДобавитьВсеЗадачи();		
		ДобавитьСобытияГугл();
	КонецЕсли;
	
	Если Дерево.ПолучитьЭлементы().Количество()=0 Тогда
		обновитьДерево(объект.Ссылка);	
	КонецЕсли;
	
	МоиПосты = МоиПолучитьПосты(объект.Ответственный);
	Если Объект.План.Количество() = 0 Тогда
		ЗагрузитьСтатистики(МоиПосты);
	КонецЕсли;

	//
	зОсн = Параметры.ЗадачаОснование;
	Если ЗначениеЗаполнено(зОсн) Тогда
		тд = Неопределено;
		Если ТипЗнч(зОсн) = тип("СправочникСсылка.ИА_ЗадачиПлана") ТОгда
			Если ВидГруппировки = Перечисления.КСУ_ГруппировкаЗадачПлана.НеГруппировать или ВидГруппировки = Перечисления.КСУ_ГруппировкаЗадачПлана.ПоШагамСостояния Тогда
				тд = Дерево;
			Иначе
				Для каждого стр из Дерево.ПолучитьЭлементы() Цикл
					Если стр.Группировка = зОсн.Группировка Тогда
						тд = стр;
						Прервать;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
			Новстр = тд.ПолучитьЭлементы().Добавить();
			ЗаполнитьЗначенияСвойств(новстр,зОсн);
			Если ВидГруппировки = Перечисления.КСУ_ГруппировкаЗадачПлана.ПоШагамСостояния Тогда
				Новстр.Группировка = Неопределено;
			КонецЕсли;
			Новстр.Выполнено = ложь;
			Новстр.ВремяПлан = Дата(1,1,1,1,0,0);
			Новстр.ВремяФакт = Дата(1,1,1,0,0,0);
			
			Если ЗначениеЗаполнено(Новстр.ЗадачаОснование) ТОгда
				Если ТипЗнч(Новстр.ЗадачаОснование)  = тип("ЗадачаСсылка.ИА_ЗадачаПланаДействий") ТОгда
					Новстр.индКартинки = 1;
				ИначеЕсли ТипЗнч(Новстр.ЗадачаОснование)  = тип("СправочникСсылка.ИА_СтратегическоеУправление") ТОгда
					Новстр.индКартинки = 2;
				КонецЕсли;
			КонецЕсли;
			Новстр.Ссылка = Справочники.ИА_ЗадачиПлана.ПустаяСсылка();
		ИначеЕсли ТипЗнч(зОсн) = тип("ЗадачаСсылка.ИА_ЗадачаПланаДействий") ТОгда
			тд = ПолучитьСтрокуДляДобавления(Перечисления.ИА_ТипыЗадачБП.Задачи);
			
			Новстр = тд.ПолучитьЭлементы().Добавить();
			Новстр.ЗадачаОснование = зОсн;
			Новстр.Пост = зОсн.Пост;
			Если Новстр.Пост.Пустая() ТОгда
				Новстр.Пост = Объект.Пост;
			КонецЕсли;
			
			Если ВидГруппировки = Перечисления.КСУ_ГруппировкаЗадачПлана.ПоВидуЗадач Тогда
				Новстр.Группировка = Перечисления.ИА_ТипыЗадачБП.Задачи;
			КонецЕсли;
			Новстр.Содержание = зОсн.Наименование;
			Новстр.ВремяПлан = Дата(1,1,1,1,0,0);
			Новстр.ВремяФакт = Дата(1,1,1,0,0,0);
			Новстр.индКартинки = 1;
			Новстр.Ссылка = Справочники.ИА_ЗадачиПлана.ПустаяСсылка();
		КонецЕсли;
	КонецЕсли;
	
	// добавление задачи из программы доступно только при установленной админшкале
	Попытка
		прогр = Справочники["ИА_СтратегическоеУправление"].ПустаяСсылка();
	Исключение
		Элементы.ШагиДобавитьЗадачуИзПрограммы.Видимость = ложь;
	КонецПопытки;
	
	ОбновитьЗаголовкиВидимость();

	ИА_КСУОбщийСервер.СделатьКнопкуОсновной(Элементы.ГруппаКП);
	
	Элементы.ШагиПост.СписокВыбора.ЗагрузитьЗначения(МоиПосты);
	Элементы.ПланПост.СписокВыбора.ЗагрузитьЗначения(МоиПосты);
	Элементы.Пост.СписокВыбора.ЗагрузитьЗначения(МоиПосты);
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьДатуДневногоПлана(недельный)
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	МАКСИМУМ(ИА_ПланыДействий.ДатаНачала) КАК ДатаНачала
	               |ИЗ
	               |	Справочник.ИА_ПланыДействий КАК ИА_ПланыДействий
	               |ГДЕ
	               |	ИА_ПланыДействий.Родитель = &Родитель
	               |	И ИА_ПланыДействий.ПометкаУдаления = ложь";
	Запрос.УстановитьПараметр("Родитель", недельный);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() и ЗначениеЗаполнено(Выборка.ДатаНачала) Тогда
		тд = Выборка.ДатаНачала+ 60*60*24+1;;
	Иначе
		тд = недельный.ДатаНачала;
	КонецЕсли;
	
	Возврат тд;
КонецФункции

&НаСервере
Процедура обновитьДерево(план, ЭтоКопирование = ложь, ИсключитьЗадачу = Неопределено)
	
	ДерРез = РеквизитФормыВЗначение("Дерево");
	
	ИА_Защита_БП.ПолучитьДеревоПлана(ДерРез, план, Объект.Состояние, ЭтоКопирование, ,ИсключитьЗадачу);
			
	ЗначениеВРеквизитФормы(ДерРез, "Дерево");
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	Если не ИА_Защита_Общий.ЛицензияДоступна("БП") Тогда
		Отказ = Истина;
		возврат;
	КонецЕсли;
	
	// доступность статистики
	Попытка
		ф = ПолучитьФорму("Обработка.ИА_РабочийСтолСтатистик_Упр_HTML.Форма.Форма");
	Исключение
		Элементы.ПланПоказатьСтатистику.Видимость = ложь;
	КонецПопытки;
	//
	
	// если скопировали
	ЭтоНовый = Объект.Ссылка.Пустая();
	
	Если ЭтоНовый Тогда
		СформироватьНаименование();
	КонецЕсли;
	
	
	ОбновитьДоступность();
	ВывестиИтогВремени();
	
	Если Объект.ДатаКонца = Дата(1,1,1) Тогда
		ДневникПериодС =  ТекущаяДата() - 60*60*24*14;
	Иначе
		ДневникПериодС =  Объект.ДатаКонца - 60*60*24*14;
	КонецЕсли;
	ОбновитьДневник(Неопределено);
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьДоступность()
КонецПроцедуры

