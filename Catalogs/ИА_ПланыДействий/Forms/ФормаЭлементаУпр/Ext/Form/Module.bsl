&НаКлиенте
Процедура ДобавитьЗадачуИзПрограммы(Команда)
	тд = Элементы.План.ТекущиеДанные;
	Если тд<>Неопределено и не тд.пост.пустая() Тогда
		Парам = Новый Структура("Отбор_ЗадачиПоста,РежимВыбора,Отбор_ТолькоНезавершенные",тд.пост,истина,истина);
		ОткрытьФорму("Обработка.ИА_РабочийСтолСтратегическогоУправления.Форма.Форма",Парам,,УникальныйИдентификатор,,, Новый ОписаниеОповещения("ДобавитьЗадачуИзПрограммыЗавершение", ЭтотОбъект), РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);
	КонецЕсли;
	Сообщить("Не заполнен пост! Добавление задачи из программы невозможно!");
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьЗадачуИзПрограммыЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	рез = Результат;
	
	Если ЗначениеЗаполнено(рез) тогда
		
		
		Если ВидГруппировки = ПредопределенноеЗначение("Перечисление.КСУ_ГруппировкаЗадачПлана.НеГруппировать") или ВидГруппировки = ПредопределенноеЗначение("Перечисление.КСУ_ГруппировкаЗадачПлана.ПоШагамСостояния") Тогда
			тд = Дерево;
		Иначе	
			тд = Неопределено;
			Для каждого стр из Дерево.ПолучитьЭлементы() Цикл
				Если стр.Группировка = ПредопределенноеЗначение("Перечисление.ИА_ТипыЗадачБП.Стратегические") Тогда
					тд = стр;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			Если тд = Неопределено Тогда 
				Возврат;
			КонецЕсли;
		КонецЕсли;
		
		текСтроки = тд.ПолучитьЭлементы();
		Новстр = текСтроки.Добавить();
		Если ВидГруппировки = ПредопределенноеЗначение("Перечисление.КСУ_ГруппировкаЗадачПлана.ПоВидуЗадач") Тогда
			Новстр.Группировка = ПредопределенноеЗначение("Перечисление.ИА_ТипыЗадачБП.Стратегические");
		КонецЕсли;
		Новстр.Содержание = рез.Содержание;
		
		Если ВидГруппировки <> ПредопределенноеЗначение("Перечисление.КСУ_ГруппировкаЗадачПлана.НеГруппировать") Тогда
			тс = Элементы.Шаги.ТекущаяСтрока;
			Если не Элементы.Шаги.Развернут(тс) Тогда
				Элементы.Шаги.Развернуть(тс);
			КонецЕсли;	
		КонецЕсли;
		
		Новстр.ВремяПлан = Дата(1,1,1);
		Новстр.ВремяФакт = Дата(1,1,1);
		
		Новстр.ЗадачаОснование = рез.ссылка;
		Новстр.Пост = рез.Ответственный;
		Новстр.индКартинки = 2;
		
		Элементы.Шаги.ТекущаяСтрока = Новстр.ПолучитьИдентификатор();
	КонецЕсли;

КонецПроцедуры

