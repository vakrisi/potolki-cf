&НаСервере
Функция ПечатьДневника_Сервер()
	ТабДок = Новый ТабличныйДокумент;
	Макет = Справочники.ИА_ПланыДействий.ПолучитьМакет("Дневник");
	
	ОблШапка = Макет.ПолучитьОбласть("Шапка");
	ОблШапка.Параметры.Должность = Объект.Пост;
	Если Объект.План.Количество()>0 Тогда
		ОблШапка.Параметры.Статистика = Объект.План[0].ВидСтатистики;
	КонецЕсли;
	
	ТабДок.Вывести(ОблШапка);
	
	// Посты
	Для каждого стр из Дневник Цикл
		Если стр.НовоеСостояние Тогда
			ОблСтрока = Макет.ПолучитьОбласть("СтрокаРазрыв");
			ТабДок.Вывести(ОблСтрока);
		КонецЕсли;
		
		Если стр.Наклон.Пустая() Тогда
			ОблСтрока = Макет.ПолучитьОбласть("Строка");
		Иначе
			порядок = ИА_Планы.ПолучитьПорядок(стр.Наклон) + 1;
			ОблСтрока = Макет.ПолучитьОбласть("Строка"+порядок);
		КонецЕсли;
		ОблСтрока.Параметры.Заполнить(стр);
		ТабДок.Вывести(ОблСтрока);
	КонецЦикла;
	
	ТабДок.АвтоМасштаб = Истина;
	ТабДок.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	ТабДок.ОтображатьЗаголовки = Ложь;
	ТабДок.ОтображатьСетку = Ложь;
	
	Возврат ТабДок;
КонецФункции

