&НаКлиенте
Процедура ДобавитьСтрокуВДневникКлиент(Задача = "")
	Если Объект.пост.Пустая() Тогда
		Сообщить("Укажите пост!");
		Возврат;
	КонецЕсли;
		
	новстр = Дневник.Вставить(0);
	новстр.ИД = новый УникальныйИдентификатор;
	новстр.Период = ТекущаяДата();
	новстр.пост = Объект.Пост;
	новстр.Задача =  Задача;
	
	Если Дневник.Количество()>1 Тогда
		ПредСтрока = Дневник[Дневник.Количество()-2];
		новстр.Шаг = ПредСтрока.Шаг;
		новстр.Состояние = ПредСтрока.Состояние;
	КонецЕсли;
	
	Элементы.Дневник.ТекущаяСтрока = новстр.ПолучитьИдентификатор();
КонецПроцедуры


