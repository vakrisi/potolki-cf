&НаСервере
Функция Печать_Сервер_Сокр()
	дер = РеквизитФормыВЗначение("Дерево");
	
	ТабДок = Новый ТабличныйДокумент;
	Макет = Справочники.ИА_ПланыДействий.ПолучитьМакет("БоевойПланСокр");
	
	ОблШапка = Макет.ПолучитьОбласть("Шапка");
	ОблШапка.Параметры.Заполнить(Объект);
	ОблШапка.Параметры.Start = Объект.ДатаНачала;
	ОблШапка.Параметры.End = Объект.ДатаКонца;
	ОблШапка.Параметры.Пост = Объект.Пост.НаименованиеДляОргсхемы;
	ТабДок.Вывести(ОблШапка);
	
	// Статистики
	Для каждого стр из Объект.План Цикл
		ОблШапка = Макет.ПолучитьОбласть("СтрокаСтат");
		ОблШапка.Параметры.Заполнить(стр);
		ТабДок.Вывести(ОблШапка);
	КонецЦикла;
	
	ОблШапка = Макет.ПолучитьОбласть("Шапка2");
	ТабДок.Вывести(ОблШапка);
	

	// Задачи
	ИтВр = Дата(1,1,1);
	сч = 1;
	Для каждого стр из Дер.Строки Цикл
		ОблСтрока = Макет.ПолучитьОбласть("СтрокаПлан");
		ОблСтрока.Параметры.нпп = строка(сч)+".";
		ОблСтрока.Параметры.Содержание = стр.Содержание;
		ОблСтрока.Параметры.Время = стр.ВремяПлан;
		ОблСтрока.Параметры.Выполнено = стр.Выполнено;
		ИтВр = СложитьВремя(ИтВр, стр.ВремяПлан);
		ТабДок.Вывести(ОблСтрока);
		
		сч = сч + 1;
	КонецЦикла;
	
	ОблСтрока = Макет.ПолучитьОбласть("СтрокаИтогПлан");	
	ОблСтрока.Параметры.Время = ФорматИтога(ИтВр);
	ТабДок.Вывести(ОблСтрока);
	
	// 
	ОблПодпись = Макет.ПолучитьОбласть("Подвал");
	Если не Объект.Пост.Родитель.Пустая() и Объект.Пост.Родитель.Сотрудники.Количество()>0 Тогда
		ОблПодпись.Параметры.Утвердил = Объект.Пост.Родитель.Сотрудники[0].ФизЛицо;
	Иначе
		ОблПодпись.Параметры.Утвердил = Объект.Утвердил;
	КонецЕсли;
	ТабДок.Вывести(ОблПодпись);
	//

	ТабДок.АвтоМасштаб = Истина;
	ТабДок.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	ТабДок.ОтображатьЗаголовки = Ложь;
	ТабДок.ОтображатьСетку = Ложь;
	
	Возврат ТабДок;
КонецФункции


&НаСервере
Функция Печать_Сервер()
	дер = РеквизитФормыВЗначение("Дерево");
	
	ТабДок = Новый ТабличныйДокумент;
	Если СокрВид Тогда
		Макет = Справочники.ИА_ПланыДействий.ПолучитьМакет("БоевойПланСокр");
	Иначе
		Макет = Справочники.ИА_ПланыДействий.ПолучитьМакет("БоевойПлан");
	КонецЕсли;
	
	Если Объект.Родитель.Пустая() Тогда
		ОблШапка = Макет.ПолучитьОбласть("Шапка");
		ОблШапка.Параметры.End = Объект.ДатаКонца;
	ИНаче
		ОблШапка = Макет.ПолучитьОбласть("ШапкаДень");
	КонецЕсли;
	
	ОблШапка.Параметры.Заполнить(Объект);
	ОблШапка.Параметры.Start = Объект.ДатаНачала;
	ОблШапка.Параметры.Пост = Объект.Пост.НаименованиеДляОргсхемы;
	ТабДок.Вывести(ОблШапка);
	
	// Статистики
	Для каждого стр из Объект.План Цикл
		ОблШапка = Макет.ПолучитьОбласть("СтрокаСтат");
		ОблШапка.Параметры.Заполнить(стр);
		ТабДок.Вывести(ОблШапка);
	КонецЦикла;
	
	ОблШапка = Макет.ПолучитьОбласть("Шапка2");
	ТабДок.Вывести(ОблШапка);
	

	// Задачи
	ИтВр = Дата(1,1,1);
	ИтВрФакт = Дата(1,1,1);
	
	Если ВидГруппировки = ПредопределенноеЗначение("Перечисление.КСУ_ГруппировкаЗадачПлана.НеГруппировать") Тогда
		сч = 1;
		Для каждого стр из Дер.Строки Цикл
			ОблСтрока = Макет.ПолучитьОбласть("СтрокаПлан");
			ОблСтрока.Параметры.нпп = строка(сч)+".";
			ОблСтрока.Параметры.Содержание = стр.Содержание;
			ОблСтрока.Параметры.Время = стр.ВремяПлан;
			ОблСтрока.Параметры.Выполнено = стр.Выполнено;
			ИтВр = СложитьВремя(ИтВр, стр.ВремяПлан);
			ИтВрФакт = СложитьВремя(ИтВрФакт, стр.ВремяФакт);
			ТабДок.Вывести(ОблСтрока);
			
			сч = сч + 1;
		КонецЦикла;
	Иначе
		сч = 1;
		Для каждого стрШаг из Дер.Строки Цикл
			Если стрШаг.Группировка = Неопределено Тогда
				ОблСтрока = Макет.ПолучитьОбласть("СтрокаПлан");
				ЗаполнитьЗначенияСвойств(ОблСтрока.Параметры, стрШаг);
				ОблСтрока.Параметры.нпп = строка(сч)+".";
				
				ИтВр = СложитьВремя(ИтВр, стрШаг.ВремяПлан);
				ИтВрФакт = СложитьВремя(ИтВрФакт, стрШаг.ВремяФакт);
				
				сч = сч + 1;
			Иначе
				ОблСтрока = Макет.ПолучитьОбласть("СтрокаШаг");
				ЗаполнитьЗначенияСвойств(ОблСтрока.Параметры, стрШаг);
			КонецЕсли;
			ТабДок.Вывести(ОблСтрока);			
			
			для каждого стр из стрШаг.Строки Цикл
				ОблСтрока = Макет.ПолучитьОбласть("СтрокаПлан");
				ЗаполнитьЗначенияСвойств(ОблСтрока.Параметры, стр);
				ОблСтрока.Параметры.нпп = строка(сч)+".";
				
				ИтВр = СложитьВремя(ИтВр, стр.ВремяПлан);
				ИтВрФакт = СложитьВремя(ИтВрФакт, стр.ВремяФакт);
				ТабДок.Вывести(ОблСтрока);
				
				сч = сч + 1;
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;
	
	ОблСтрока = Макет.ПолучитьОбласть("СтрокаИтогПлан");	
	ОблСтрока.Параметры.Время = ФорматИтога(ИтВр);
	если не СокрВид Тогда
		ОблСтрока.Параметры.ВремяФакт = ФорматИтога(ИтВрФакт);
	КонецЕсли;
	ТабДок.Вывести(ОблСтрока);
	
	// 
	ОблПодпись = Макет.ПолучитьОбласть("Подвал");
	Если не Объект.Пост.Родитель.Пустая() и Объект.Пост.Родитель.Сотрудники.Количество()>0 Тогда
		ОблПодпись.Параметры.Утвердил = Объект.Пост.Родитель.Сотрудники[0].ФизЛицо;
	Иначе
		ОблПодпись.Параметры.Утвердил = Объект.Утвердил;
	КонецЕсли;
	ТабДок.Вывести(ОблПодпись);
	//

	ТабДок.АвтоМасштаб = Истина;
	ТабДок.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	ТабДок.ОтображатьЗаголовки = Ложь;
	ТабДок.ОтображатьСетку = Ложь;
	
	Возврат ТабДок;

КонецФункции

