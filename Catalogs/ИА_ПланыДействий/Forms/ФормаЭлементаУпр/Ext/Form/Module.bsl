КонецПроцедуры


&НаКлиенте
Процедура ПроверитьЗаполнениеСтроки(стрДанных, отказ)
	Если стрДанных.ВремяПлан = дата(1,1,1) Тогда
		ПоказатьПредупреждение(,"Укажите время!");
		Отказ = Истина;
		возврат;
	КонецЕсли;
	
	Если стрДанных.Пост.Пустая() Тогда
		ПоказатьПредупреждение(,"Укажите пост!");
