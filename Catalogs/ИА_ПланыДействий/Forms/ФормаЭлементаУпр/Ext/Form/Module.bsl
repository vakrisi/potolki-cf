		возврат;
	КонецЕсли;

КонецПроцедуры	
	
	
&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	Если ВидГруппировки = ПредопределенноеЗначение("Перечисление.КСУ_ГруппировкаЗадачПлана.НеГруппировать") Тогда
		для каждого стр из Дерево.ПолучитьЭлементы() Цикл
			ПроверитьЗаполнениеСтроки(стр, отказ);		
		КонецЦикла;
	Иначе
		для каждого стр из Дерево.ПолучитьЭлементы() Цикл
			если стр.Группировка = Неопределено ТОгда
				ПроверитьЗаполнениеСтроки(стр, отказ);		
			КонецЕсли;
			Для каждого стр1 из стр.ПолучитьЭлементы() Цикл
				ПроверитьЗаполнениеСтроки(стр1, отказ);		
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ШагиВыполненоПриИзменении(Элемент)
	
	тдП = Элементы.Шаги.ТекущиеДанные;

	Если тдП.Выполнено и тдП.ВремяФакт = Дата(1,1,1) Тогда
		тдП.ВремяФакт = тдП.ВремяПлан;
	КонецЕсли;
	
	Если тдП.Выполнено И ЗначениеЗаполнено(тдП.ЗадачаОснование) Тогда
		структЗадача = Новый Структура("ЗадачаОснование,Выполнено", тдП.ЗадачаОснование, тдП.Выполнено); 
		ИА_Планы_Клиент.ЗавершитьЗадачуОснование(структЗадача);
	КонецЕсли;
	
	ВывестиИтогВремени();
	
КонецПроцедуры

&НаКлиенте
Процедура ШагиВремяФактПриИзменении(Элемент)
	тд = Элементы.Шаги.ТекущиеДанные;
	Если тд.Выполнено и тд.ВремяФакт = Дата(1,1,1) Тогда
		тд.ВремяФакт = тд.ВремяПлан;
	КонецЕсли;
	ВывестиИтогВремени();
КонецПроцедуры

&НаСервере
Функция ПолучитьСтрокуДляДобавления(Группировка)
	Если ВидГруппировки <> Перечисления.КСУ_ГруппировкаЗадачПлана.ПоВидуЗадач Тогда
		тд = Дерево;
	Иначе
		тд = Неопределено;
		Для каждого стр из Дерево.ПолучитьЭлементы() Цикл
			Если стр.Группировка = Группировка Тогда
				тд = стр;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	возврат тд;
КонецФункции

&НаСервере
Процедура ДобавитьВсеСтратегическиеЗадачи()
	Если Объект.ДатаНачала = Дата(1,1,1) или Объект.ДатаКонца = Дата(1,1,1) Тогда
		Возврат;
	КонецЕсли;
	
	задачиС = ПолучитьЗадачиСтратегии(Объект.Ответственный, объект.ДатаНачала, объект.ДатаКонца);
	
	Если задачиС.Количество()=0 Тогда
		Возврат;
	КонецЕсли;

	Если ВидГруппировки = Перечисления.КСУ_ГруппировкаЗадачПлана.НеГруппировать Тогда
		тд = Дерево;
	Иначе		
		тд = ПолучитьСтрокуДляДобавления(Перечисления.ИА_ТипыЗадачБП.Стратегические);
	
		Если тд = Неопределено Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;
			
	текСтроки = тд.ПолучитьЭлементы();
	
	Новстр = Неопределено;
	Для каждого стр из задачиС Цикл
		Прерв = ложь;
		для каждого стр1 из текСтроки Цикл
			если стр1.ЗадачаОснование = стр.ссылка Тогда
				прерв = истина;
				прервать;
			КонецЕсли;
		КонецЦикла;
		Если прерв Тогда
			продолжить;
		КонецЕсли;
		
		Новстр = текСтроки.Добавить();
		Новстр.Группировка = ПредопределенноеЗначение("Перечисление.ИА_ТипыЗадачБП.Стратегические");
		Новстр.Содержание = стр.Содержание;
		Новстр.СрокИсполнения = стр.СрокИсполнения;
		Новстр.ВремяПлан = Дата(1,1,1,1,0,0);
		Новстр.ВремяФакт = Дата(1,1,1);
		Новстр.ЗадачаОснование = стр.ссылка;
		Новстр.Пост = Объект.Пост;
		Новстр.индКартинки = 2;
	КонецЦикла;
	
	Если Новстр <> Неопределено Тогда 
		Элементы.Шаги.ТекущаяСтрока = Новстр.ПолучитьИдентификатор();
	КонецЕсли;
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьЗадачиСтратегии(ответственный, ДатаНачала, ДатаКонца)
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	ИА_СтратегическоеУправление.Содержание,
	               |	ИА_СтратегическоеУправление.Срок КАК СрокИсполнения,
	               |	ИА_СтратегическоеУправление.ЧасовНаВыполнение КАК ВремяЧасы,
	               |	ИА_СтратегическоеУправление.Ссылка
	               |ИЗ
	               |	Справочник.ИА_СтратегическоеУправление КАК ИА_СтратегическоеУправление
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ИА_АдресацияЗадачПланаДействий КАК ИА_АдресацияЗадачПланаДействий
	               |		ПО ИА_СтратегическоеУправление.Ответственный = ИА_АдресацияЗадачПланаДействий.Пост И ИА_АдресацияЗадачПланаДействий.Пользователь = &Пользователь
	               |ГДЕ
	               |	ИА_СтратегическоеУправление.ДатаНачала <= &ДатаКонца
	               |	И ИА_СтратегическоеУправление.ДатаНачала <> ДАТАВРЕМЯ(1, 1, 1)
	               |	И ИА_СтратегическоеУправление.Срок >= &ДатаНачала
	               |	И ИА_СтратегическоеУправление.Выполнено = ЛОЖЬ
	               |	И ИА_СтратегическоеУправление.ТипЭлемента = ЗНАЧЕНИЕ(Перечисление.ИА_ТипыЭлементовСтратегическогоУправления.Задача)
	               |	И ИА_СтратегическоеУправление.ЭтоКоррекция = ЛОЖЬ
				   |	И ИА_СтратегическоеУправление.ПометкаУдаления = ЛОЖЬ";
	
	Запрос.УстановитьПараметр("Пользователь", ответственный);
	Запрос.УстановитьПараметр("ДатаНачала",ДатаНачала);
	Запрос.УстановитьПараметр("ДатаКонца",ДатаКонца);
	
	рез = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		рез.Добавить(Новый Структура("Содержание,СрокИсполнения,ВремяЧасы,Ссылка",Выборка.Содержание,Выборка.СрокИсполнения,Выборка.ВремяЧасы,Выборка.Ссылка  ));
	КонецЦикла;
	
	Возврат Рез;
КонецФункции

&НаСервере
Процедура УтвержденоПриИзмененииНаСервере()
	Если Объект.Утверждено Тогда
		Объект.ДатаУтверждения = ТекущаяДата();
		Объект.Утвердил = ПараметрыСеанса.ТекущийПользователь;
	Иначе
		Объект.ДатаУтверждения = Дата(1,1,1);
		Объект.Утвердил = Справочники.Пользователи.ПустаяСсылка();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура УтвержденоПриИзменении(Элемент)
	УтвержденоПриИзмененииНаСервере();
КонецПроцедуры

&НаСервере
Процедура ПриЗаписиНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	Попытка
		НачатьТранзакцию();
			ЗаписатьШаги(ТекущийОбъект.Ссылка);
		ЗафиксироватьТранзакцию();
		
		Если не ТекущийОбъект.Родитель.Пустая() Тогда // дневной
			ИА_Планы.РаспределитьЗадачиДневногоПлана(ТекущийОбъект.Ссылка);
		КонецЕсли;
	Исключение
		отказ = Истина;
		сообщить(ОписаниеОшибки());
	КонецПопытки;
КонецПроцедуры

&НаСервере
Процедура ЗаписатьСтрокуШага(стрЗадача, Владелец,ссылкиШаг, Порядок)
	Если стрЗадача.ссылка.Пустая() ТОгда
		ЗадачаОб = Справочники.ИА_ЗадачиПлана.СоздатьЭлемент();
		ЗадачаОб.Владелец = Владелец;
		
		Если ТипЗнч(стрЗадача.ЗадачаОснование) = тип("ЗадачаСсылка.ИА_ЗадачаПланаДействий") и стрЗадача.ЗадачаОснование.Отложена = ложь Тогда
			обЗадача = стрЗадача.ЗадачаОснование.получитьобъект();
			обЗадача.Отложена = истина;
			обЗадача.записать();
		КонецЕсли;
	Иначе
		ЗадачаОб = стрЗадача.ссылка.ПолучитьОбъект(); 
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(ЗадачаОб, стрЗадача,,"Родитель");
	ЗадачаОб.СформироватьНаименование();
	
	ЗадачаОб.Порядок = Порядок;
	
	ЗадачаОб.Записать();
	стрЗадача.Ссылка = ЗадачаОб.Ссылка; 
	ссылкиШаг.Добавить(стрЗадача.ссылка);
	Порядок = Порядок + 1;
КонецПроцедуры

&НаСервере
Процедура ЗаписатьШаги(Владелец)
	Дер = РеквизитФормыВЗначение("Дерево");
	ссылкиШаг = новый Массив;
	
	Порядок = 1;
	Если ВидГруппировки = Перечисления.КСУ_ГруппировкаЗадачПлана.НеГруппировать Тогда
		Для каждого стр из Дер.Строки Цикл
			ЗаписатьСтрокуШага(стр, Владелец,ссылкиШаг, Порядок);
		КонецЦикла;
	Иначе
		Для каждого стр из Дер.Строки Цикл
			если стр.Группировка = Неопределено Тогда
				ЗаписатьСтрокуШага(стр, Владелец,ссылкиШаг, Порядок);
			КонецЕсли;
			Для каждого стрЗадача из стр.Строки Цикл
				ЗаписатьСтрокуШага(стрЗадача, Владелец,ссылкиШаг, Порядок);
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;
	ЗначениеВРеквизитФормы(дер,"Дерево");
	
	// удалим лишнее
	Запрос = Новый запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ИА_ЗадачиПлана.Ссылка
	               |ИЗ
	               |	Справочник.ИА_ЗадачиПлана КАК ИА_ЗадачиПлана
	               |ГДЕ
	               |	ИА_ЗадачиПлана.Владелец = &Владелец
	               |	И НЕ ИА_ЗадачиПлана.Ссылка В (&Ссылка)
	               |	И ИА_ЗадачиПлана.ПометкаУдаления = ложь";
	Запрос.УстановитьПараметр("Владелец", Владелец);
	Запрос.УстановитьПараметр("Ссылка", ссылкиШаг);
	Выборка = запрос.Выполнить().Выбрать();
	
	Пока выборка.Следующий() Цикл
		об = Выборка.ссылка.ПолучитьОбъект();
		об.УстановитьПометкуУдаления(истина);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ШагиВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	Если поле = Элементы.ШагииндКартинки Тогда
		задачаОснование = Дерево.НайтиПоИдентификатору(ВыбраннаяСтрока).задачаОснование;
		ПоказатьЗначение(,задачаОснование);
	КонецЕсли;
КонецПроцедуры


