&НаСервере
Функция МоиПолучитьПосты(Польз = Неопределено)
	
	Если Польз = Неопределено Тогда
		 Польз = ПараметрыСеанса.ТекущийПользователь;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ИА_АдресацияЗадачПланаДействий.Пост,
	               |	ИА_АдресацияЗадачПланаДействий.Пост.ТипТерминала.Порядок КАК Порядок
	               |ИЗ
	               |	РегистрСведений.ИА_АдресацияЗадачПланаДействий КАК ИА_АдресацияЗадачПланаДействий
	               |ГДЕ
	               |	ИА_АдресацияЗадачПланаДействий.Пользователь = &Пользователь
	               |	И ИА_АдресацияЗадачПланаДействий.Пост.ПометкаУдаления = ЛОЖЬ
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ИА_АдресацияЗадачПланаДействий.Пост.ТипТерминала.Порядок";
	Запрос.УстановитьПараметр("Пользователь", польз);
	
	ТЗ = Запрос.Выполнить().Выгрузить();

	Если ТЗ.Количество() > 0 Тогда
		Возврат ТЗ.ВыгрузитьКолонку("Пост");
	Иначе
		Возврат новый Массив;
	КонецЕсли;
КонецФункции

&НаКлиенте
Процедура ШагиПередУдалением(Элемент, Отказ)
	Если Элемент.ТекущиеДанные.ПолучитьРодителя() = Неопределено 
		и ВидГруппировки <> ПредопределенноеЗначение("Перечисление.КСУ_ГруппировкаЗадачПлана.НеГруппировать") 
		и Элемент.ТекущиеДанные.Группировка<>Неопределено Тогда
		Отказ = Истина;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьЗадачуБезФормулы(Команда)
	Новстр = Дерево.ПолучитьЭлементы().Добавить();
	Новстр.Содержание = "";
	Новстр.Пост = ?(ПоследнийВыбПост.Пустая(), Объект.Пост, ПоследнийВыбПост);	
	Новстр.ВремяПлан = Дата(1,1,1);
	Новстр.ВремяФакт = Дата(1,1,1);

	Элементы.Шаги.ТекущаяСтрока = Новстр.ПолучитьИдентификатор();
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьЗадачуПоФормуле(Команда)
	Если ВидГруппировки = ПредопределенноеЗначение("Перечисление.КСУ_ГруппировкаЗадачПлана.НеГруппировать") Тогда
		Новстр = Дерево.ПолучитьЭлементы().Добавить();
		Если ВидГруппировки = ПредопределенноеЗначение("Перечисление.КСУ_ГруппировкаЗадачПлана.ПоВидуЗадач") Тогда
			Новстр.Группировка = ПредопределенноеЗначение("Перечисление.ИА_ТипыЗадачБП.Задачи");
		КонецЕсли;
	Иначе
		тд = Элементы.Шаги.ТекущиеДанные;
		Если тд = Неопределено ИЛИ (не ЗначениеЗаполнено(тд.Группировка)) Тогда
			возврат;
		КонецЕсли;
		Если тд.ПолучитьРодителя() <> Неопределено Тогда
			тд = тд.ПолучитьРодителя();
		КонецЕсли;
			
		Новстр = тд.ПолучитьЭлементы().Добавить();
		Новстр.Группировка = тд.Группировка;
	КонецЕсли;
	
	Новстр.Содержание = "";
	Новстр.Пост = ?(ПоследнийВыбПост.Пустая(), Объект.Пост, ПоследнийВыбПост);
	
	Новстр.ВремяПлан = Дата(1,1,1);
	Новстр.ВремяФакт = Дата(1,1,1);
	
	Если ВидГруппировки <> ПредопределенноеЗначение("Перечисление.КСУ_ГруппировкаЗадачПлана.НеГруппировать") Тогда
		тс = Элементы.Шаги.ТекущаяСтрока;
		Если не Элементы.Шаги.Развернут(тс) Тогда
			Элементы.Шаги.Развернуть(тс);
		КонецЕсли;
	КонецЕсли;
	
	Элементы.Шаги.ТекущаяСтрока = Новстр.ПолучитьИдентификатор();
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	ТекущийОбъект.Шаги.очистить(); // для старых планов
	
	Если не ТекущийОбъект.Родитель.Пустая() ТОгда // это дневной
		Если ТекущийОбъект.ДатаКонца > ТекущийОбъект.Родитель.ДатаКонца или ТекущийОбъект.ДатаНачала < ТекущийОбъект.Родитель.ДатаНачала Тогда
			Сообщить("Дата плана не совпадает с недельным планом!");
			Отказ = истина;
			Возврат;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры


&НаКлиентеНаСервереБезКонтекста
Функция СложитьВремя(в1, в2)
	Если не ЗначениеЗаполнено(в2) Тогда
		возврат в1;
	КонецЕсли;
	
	возврат в1 + (в2 - Дата(1,1,1));
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ФорматИтога(д1)
	
	Если д1 = дата(1,1,1) Тогда
		возврат "";
	КонецЕсли;
	
	КолЧасов = (День(д1)-1)*24 + Час(д1);
	возврат формат(КолЧасов,"ЧЦ=2; ЧН=; ЧВН=")+":"+формат(Минута(д1),"ЧЦ=2; ЧН=; ЧВН=");
КонецФункции

&НаКлиенте
Процедура ВывестиИтогВремени()
	
	ВремяИтого = Дата(1,1,1);
	ВремяИтогоФакт = Дата(1,1,1);
	Выполнено1 = Дата(1,1,1);
	
	Если ВидГруппировки = ПредопределенноеЗначение("Перечисление.КСУ_ГруппировкаЗадачПлана.НеГруппировать") Тогда
		Для каждого стр1 из Дерево.ПолучитьЭлементы() Цикл // задачи
			ВремяИтого = СложитьВремя(ВремяИтого , стр1.ВремяПлан);  
			ВремяИтогоФакт = СложитьВремя(ВремяИтогоФакт , стр1.ВремяФакт);  
			Если стр1.Выполнено Тогда
				Выполнено1 = СложитьВремя(Выполнено1 , стр1.ВремяПлан);
			КонецЕсли;
		КонецЦикла;
	Иначе
		Для каждого стр из Дерево.ПолучитьЭлементы() Цикл  // шаги, типы		
			Если стр.Группировка = Неопределено Тогда
				ВремяИтого = СложитьВремя(ВремяИтого , стр.ВремяПлан);  
				ВремяИтогоФакт = СложитьВремя(ВремяИтогоФакт , стр.ВремяФакт);  
				Если стр.Выполнено Тогда
					Выполнено1 = СложитьВремя(Выполнено1 , стр.ВремяПлан);
				КонецЕсли;
			Иначе
				Итог11 = Дата(1,1,1);
				Итог11Ф = Дата(1,1,1);
				Для каждого стр1 из стр.ПолучитьЭлементы() Цикл // задачи
					ВремяИтого = СложитьВремя(ВремяИтого , стр1.ВремяПлан);  
					ВремяИтогоФакт = СложитьВремя(ВремяИтогоФакт , стр1.ВремяФакт);  
					
					Итог11 = СложитьВремя(Итог11 , стр1.ВремяПлан);
					Итог11Ф = СложитьВремя(Итог11Ф , стр1.ВремяФакт);
					Если стр1.Выполнено Тогда
						Выполнено1 = СложитьВремя(Выполнено1 , стр1.ВремяПлан);
					КонецЕсли;
				КонецЦикла;
				стр.ВремяПлан = ФорматИтога(Итог11);
				стр.ВремяФакт = ФорматИтога(Итог11Ф);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	время = ФорматИтога(ВремяИтого);
	ВремяФакт = ФорматИтога(ВремяИтогоФакт);

	Выполнено = ФорматИтога(Выполнено1);;
КонецПроцедуры

&НаКлиенте
Процедура ШагиВремяПриИзменении(Элемент)
	ВывестиИтогВремени();
КонецПроцедуры

&НаКлиенте
Процедура ПланВидСтатистикиПриИзменении(Элемент)
	тд = Элементы.План.ТекущиеДанные;
	тд.ПредыдущийПлан = ИА_Планы.ПолучитьПредыдущуюКвоту(тд.ВидСтатистики,Объект.Ответственный,Объект.Родитель, Объект.ДатаНачала); 
	тд.Аналитика1 = Неопределено;
	тд.Аналитика2 = Неопределено;
	тд.Аналитика3 = Неопределено;
	тд.ТекущееЗначениеСтатистики = ИА_Планы.ПолучитьЗначениеСтатистики(тд.ВидСтатистики, Неопределено, Неопределено, Неопределено, Объект.ДатаНачала, Объект.Родитель);
	СформироватьНаименование()
КонецПроцедуры


&НаСервере
Процедура ОбновитьДатыПриИзмДатыНачала()
	Если ЗначениеЗаполнено(Объект.Родитель) Тогда
		Если Объект.ДатаНачала < Объект.Родитель.ДатаНачала Тогда
			Объект.ДатаНачала = Объект.Родитель.ДатаНачала;
		ИначеЕсли Объект.ДатаНачала > Объект.Родитель.ДатаКонца Тогда
			Объект.ДатаНачала = Объект.Родитель.ДатаКонца;
		КонецЕсли;	
		Объект.ДатаКонца = Объект.ДатаНачала;
	КонецЕсли;	
	
	Если ЗначениеЗаполнено(Объект.Родитель) Тогда // дневной
		Объект.ДатаКонца = Объект.ДатаНачала;
	Иначе // недельный
		Если ЗначениеЗаполнено(Объект.ДатаНачала) Тогда
			Объект.ДатаКонца = Объект.ДатаНачала + 6*60*60*24; 
		Иначе
			Объект.ДатаКонца = Дата(1,1,1);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры


&НаКлиенте
Процедура ДатаНачалаПриИзменении(Элемент)
	
	ОбновитьДатыПриИзмДатыНачала();
	
	ОбновитьЗначенияСтатистик();
	ОбновитьДневник(Неопределено);
	СформироватьНаименование();
КонецПроцедуры

&НаСервере
Процедура ПроверкаДат()
	Если ЗначениеЗаполнено(Объект.Родитель) Тогда // дневной
		Объект.ДатаНачала = Объект.Родитель.ДатаНачала;
		Объект.ДатаКонца = Объект.Родитель.ДатаНачала;
	Иначе // недельный
		Если ЗначениеЗаполнено(Объект.ДатаНачала) Тогда
			Объект.ДатаКонца = Объект.ДатаНачала + 6*60*60*24; 
		Иначе
			Объект.ДатаКонца = Дата(1,1,1);
		КонецЕсли;		
	КонецЕсли;

	ОбновитьЗаголовкиВидимость();
КонецПроцедуры

&НаСервере
Процедура ОбновитьЗаголовкиВидимость()
	
	Если ЗначениеЗаполнено(Объект.Родитель) Тогда // дневной		
		Элементы.ДатаКонца.Видимость = Ложь;
		Элементы.ДатаНачала.Заголовок = "день";		
		Элементы.ДекорацияБП.Заголовок  = "БОЕВОЙ ПЛАН НА ДЕНЬ";
		Элементы.Родитель.Видимость = истина;
		
		Элементы.ПланПредыдущийПлан.Заголовок  = "Квота прошлого дня";
		Элементы.ПланТекущееЗначениеСтатистики.Заголовок  = "Факт прошлого дня";
		Элементы.ПланКвотаПлан.Заголовок  = "Квота на следующий день";
	Иначе // недельный		
		Элементы.ДатаКонца.Видимость = Истина;
		Элементы.ДатаНачала.Заголовок = "начало недели";
		
		Элементы.ДекорацияБП.Заголовок  = "БОЕВОЙ ПЛАН НА НЕДЕЛЮ";
		Элементы.Родитель.Видимость = ложь;
		
		Элементы.ПланПредыдущийПлан.Заголовок  = "Квота прошлой недели";
		Элементы.ПланТекущееЗначениеСтатистики.Заголовок  = "Факт прошлой недели";
		Элементы.ПланКвотаПлан.Заголовок  = "Квота на следующую неделю";
	КонецЕсли;
	
	Если СокрВид Тогда
		Элементы.ШагиПродукт.Видимость = ложь;
		Элементы.ШагиСрокИсполнения.Видимость = ложь;
		Элементы.ШагиВремяФакт.Видимость = ложь;
		Элементы.ШагиСодержание.Заголовок = "Задача";
	КонецЕсли;
	
	Если ВидГруппировки = Перечисления.КСУ_ГруппировкаЗадачПлана.НеГруппировать Тогда
		Элементы.Шаги.Отображение = ОтображениеТаблицы.Список;
	КонецЕсли;
	Элементы.ШагиДобавитьЗадачуБезФормулы.Видимость = ВидГруппировки = Перечисления.КСУ_ГруппировкаЗадачПлана.ПоШагамСостояния;
	Элементы.Состояние.Видимость = ВидГруппировки = Перечисления.КСУ_ГруппировкаЗадачПлана.ПоШагамСостояния;
	Элементы.Ситуация.Видимость = ВидГруппировки = Перечисления.КСУ_ГруппировкаЗадачПлана.ПоШагамСостояния;
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьЗначенияСтатистик()
	Для каждого стр из Объект.План Цикл
		стр.ТекущееЗначениеСтатистики = ИА_Планы.ПолучитьЗначениеСтатистики(стр.ВидСтатистики, стр.Аналитика1, стр.Аналитика2, стр.Аналитика3, Объект.ДатаНачала, Объект.Родитель);
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьСтатистику(Команда)	
	Если не Объект.Пост.Пустая() Тогда
		настр = ПолучитьНастройкуСтатистики(Объект.Пост);
		Если ЗначениеЗаполнено(настр) Тогда
			ф = ПолучитьФорму("Обработка.ИА_РабочийСтолСтатистик_Упр_HTML.Форма.Форма");
			ф.Объект.Настройка = настр;
			Если ЗначениеЗаполнено(Объект.Родитель) Тогда  // дневной
				ф.Объект.ДатаКонца = Объект.ДатаНачала - 60*60*24;    // 6 дней назад
				ф.Объект.ДатаНачала = Объект.ДатаНачала - 60*60*24*6;
			Иначе // недельный
				ф.Объект.ДатаКонца = Объект.ДатаНачала - 60*60*24;
				ф.Объект.ДатаНачала = Объект.ДатаНачала - 60*60*24*7*6; // 6 недель назад
			КонецЕсли;
			
			ф.Открыть();
			ф.ЗагрузитьНастройкуБезПериодов();
		Иначе
			Сообщить("У поста не указана настройка статистик!");
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

