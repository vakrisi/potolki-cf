&НаКлиенте
Процедура ШагиПеретаскивание(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка, Строка, Поле) 
	СтандартнаяОбработка = Ложь;
	Если ВидГруппировки = ПредопределенноеЗначение("Перечисление.КСУ_ГруппировкаЗадачПлана.НеГруппировать") Тогда
		возврат;
	КонецЕсли;
	
	ПараметрыПеретаскивания.Действие = ДействиеПеретаскивания.Перемещение;
	МассивВыбора = ПараметрыПеретаскивания.Значение;
	Если ТипЗнч(МассивВыбора) = Тип("Массив") Тогда
		Выбор = МассивВыбора[0];
	Иначе
		Выбор = МассивВыбора;
	КонецЕсли;

	ИсхСтрока = Дерево.НайтиПоИдентификатору(Выбор);
	РезСтрока = Дерево.НайтиПоИдентификатору(Строка);

	Если РезСтрока.ПолучитьРодителя() = Неопределено Тогда
		Если РезСтрока.УО = 0 Тогда   
			ПараметрыПеретаскивания.Действие = ДействиеПеретаскивания.Отмена;
			Возврат;
		КонецЕсли;
		Новстр = РезСтрока.ПолучитьЭлементы().Добавить();
		ЗаполнитьЗначенияСвойств(Новстр, ИсхСтрока);
		Новстр.Группировка = РезСтрока.Группировка;
	Иначе // строка плана 
		Новстр = РезСтрока.ПолучитьРодителя().ПолучитьЭлементы().Добавить();
		ЗаполнитьЗначенияСвойств(Новстр, ИсхСтрока);
		Новстр.Группировка = РезСтрока.Группировка;
	КонецЕсли;
	
	Если РезСтрока = Неопределено и Новстр<>Неопределено Тогда 
			Элементы["Шаги"].Развернуть(Новстр.ПолучитьИдентификатор(), Истина); 
	КонецЕсли;

	Родитель = ИсхСтрока.ПолучитьРодителя(); 
	Если Не Родитель = Неопределено Тогда
		Родитель.ПолучитьЭлементы().Удалить(ИсхСтрока);
	Иначе //нету родителя
		Дерево.ПолучитьЭлементы().Удалить(ИсхСтрока);
	КонецЕсли;  
	// Для "красоты" развернем ветвь-родителя 
	Если НЕ РезСтрока = Неопределено Тогда 
		Элементы["Шаги"].Развернуть(Строка, Истина); 
	КонецЕсли;
	Модифицированность = Истина;

КонецПроцедуры

&НаКлиенте    
Функция ПроверитьВозможностьПереноса(ПереносимыйЭлемент, Знач НовыйРодитель) 
	
	Пока НЕ НовыйРодитель = Неопределено Цикл 
		Если ПереносимыйЭлемент = НовыйРодитель Тогда 
			Возврат Ложь; 
		КонецЕсли; 
		НовыйРодитель = НовыйРодитель.ПолучитьРодителя(); 
	КонецЦикла; 

	Возврат Истина; 

КонецФункции

&НаКлиенте
Процедура ШагиПроверкаПеретаскивания(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка, Строка, Поле)
	СтандартнаяОбработка = Ложь;
	Если ТипЗнч(Элемент.ТекущиеДанные.Содержание) <> тип("Строка") 
		или ВидГруппировки = ПредопределенноеЗначение("Перечисление.КСУ_ГруппировкаЗадачПлана.НеГруппировать") Тогда
		ПараметрыПеретаскивания.Действие=ДействиеПеретаскивания.Отмена;
		Возврат;
	КонецЕсли;
		
	НовыйРодитель = ?(Строка = Неопределено, Неопределено,	Дерево.НайтиПоИдентификатору(Строка));
	
	Если НовыйРодитель = Неопределено или НовыйРодитель.Группировка = Неопределено Тогда 
		ПараметрыПеретаскивания.Действие=ДействиеПеретаскивания.Отмена; 
		Возврат;
	КонецЕсли;
	 
	МассивИДПереносимыхЭлементов = ПараметрыПеретаскивания.Значение; 
	Для каждого ИДПереносимыйЭлемент из МассивИДПереносимыхЭлементов Цикл 
		ПереносимыйЭлемент = Дерево.НайтиПоИдентификатору(ИДПереносимыйЭлемент); 
		Если НЕ ПроверитьВозможностьПереноса(ПереносимыйЭлемент, НовыйРодитель) Тогда 
			ПараметрыПеретаскивания.Действие=ДействиеПеретаскивания.Отмена; 
			Прервать; 
		КонецЕсли; 
	КонецЦикла; 
КонецПроцедуры

&НаКлиенте
Процедура ШагиНачалоПеретаскивания(Элемент, ПараметрыПеретаскивания, Выполнение)
	Если ТипЗнч(Элемент.ТекущиеДанные.Содержание) <> тип("Строка") Тогда
		ПараметрыПеретаскивания.Действие=ДействиеПеретаскивания.Отмена;
		Возврат;
	КонецЕсли;
