&НаКлиенте
Процедура обновитьНовыеСостояния()
	ПредСост = Неопределено;
	инд = Дневник.Количество()-1;
	
	Пока инд >= 0 Цикл
		стр = Дневник[инд];
		Стр.НовоеСостояние = стр.Состояние <> ПредСост и ПредСост<>Неопределено;
		ПредСост = стр.Состояние;
		
		инд = инд - 1;
	КонецЦикла;
КонецПроцедуры

