
&НаКлиенте
Процедура ПорядокВверх(Команда)
    ИзменитьПорядокНаСервере(Элементы.Список.ТекущаяСтрока, -1);
КонецПроцедуры

&НаКлиенте
Процедура ПорядокВниз(Команда)
    ИзменитьПорядокНаСервере(Элементы.Список.ТекущаяСтрока, 1);
КонецПроцедуры

&НаСервере
Процедура ИзменитьПорядокНаСервере(Реквизит, Направление)
	Справочники.ИА_БПТипыЗадач.ИзменитьПорядокРеквизита(Реквизит, Направление);
    Элементы.Список.Обновить();
КонецПроцедуры
 
