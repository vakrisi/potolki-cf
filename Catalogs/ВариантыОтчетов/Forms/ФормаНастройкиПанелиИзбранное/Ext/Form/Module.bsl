&НаКлиенте
Процедура ДобавитьВариантОтчетаКлиент(НовыйВариант, Строка = Неопределено)
	
	НайденныеСтроки = ТаблицаОтчетовПанели.НайтиСтроки(Новый Структура("Вариант", НовыйВариант));
	Если НайденныеСтроки.Количество() = 0 Тогда
		Если Строка = Неопределено Тогда
			НоваяСтрока = ТаблицаОтчетовПанели.Добавить();
			НоваяСтрока.Вариант = НовыйВариант;
		Иначе
			ТекущийВариант = ТаблицаОтчетовПанели.НайтиПоИдентификатору(Строка);
			
			НоваяСтрока = ТаблицаОтчетовПанели.Вставить(ТаблицаОтчетовПанели.Индекс(ТекущийВариант));
			НоваяСтрока.Вариант = НовыйВариант;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры
			
