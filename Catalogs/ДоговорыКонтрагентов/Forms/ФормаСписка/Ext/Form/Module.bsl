
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ОтборОпределен = Параметры.Отбор.Свойство("Владелец") И ЗначениеЗаполнено(Параметры.Отбор.Владелец);
	Элементы.ФормаОсновнойДоговор.Доступность = ОтборОпределен;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийКомандФормы

&НаКлиенте
Процедура ОсновнойДоговор(Команда)
	
	//#16679 
	ТекущиеДанные = Элементы.Список.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ОсновнойДоговорНаСервере(ТекущиеДанные.Ссылка, ТекущиеДанные.Владелец, Истина);
	Элементы.Список.Обновить();
	Оповестить("ИзменилсяОсновнойДоговор", ТекущиеДанные.Владелец);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыФункции

&НаСервере
Процедура ОсновнойДоговорНаСервере(ДоговорСсылка, КонтрагентСсылка, СбросДоговора)
	
	ИмяРеквизитаОД = "ОсновнойДоговор";
	
	Попытка
		СпрОбъект = КонтрагентСсылка.ПолучитьОбъект();
		СпрОбъектМодифицирован = Ложь;
		Если НЕ СпрОбъект[ИмяРеквизитаОД] = ДоговорСсылка Тогда
			СпрОбъект[ИмяРеквизитаОД] = ДоговорСсылка;
			СпрОбъектМодифицирован = Истина;
		Иначе
			Если СбросДоговора Тогда
				// нажали кнопку "Основной договор" на основном договоре - снимаем признак
				СпрОбъект[ИмяРеквизитаОД] = Справочники.Договоры.ПустаяСсылка();
				СпрОбъектМодифицирован = Истина;
			КонецЕсли;
		КонецЕсли;
		Если СпрОбъектМодифицирован Тогда
			СпрОбъект.Записать();
		КонецЕсли;
	Исключение
		Сообщить("Ошибка смены основного договора: " + ОписаниеОшибки());
	КонецПопытки;
	
КонецПроцедуры

#КонецОбласти
