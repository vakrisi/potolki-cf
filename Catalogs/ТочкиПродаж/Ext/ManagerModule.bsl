
#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

Функция ПолучитьЭлементПоНаименованию(Наименование) Экспорт
	
	Результат = Справочники.ТочкиПродаж.ПустаяСсылка();
	
	Если ПустаяСтрока(Наименование) Тогда
		Возврат Результат;	
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	ТочкиПродаж.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ТочкиПродаж КАК ТочкиПродаж
	|ГДЕ
	|	НЕ ТочкиПродаж.ЭтоГруппа
	|	И ТочкиПродаж.Наименование ПОДОБНО &Наименование";
	
	Запрос.УстановитьПараметр("Наименование", Наименование);
		
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Результат = Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

