Функция ПричинаПоУмолчанию() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 2
	|	ПричиныОтказа.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ПричиныОтказа КАК ПричиныОтказа
	|ГДЕ
	|	НЕ ПричиныОтказа.ПометкаУдаления";
	
	РезультатЗапроса = Запрос.Выполнить();	
	Выборка = РезультатЗапроса.Выбрать();
	Если Выборка.Количество() = 1 Тогда	
		Выборка.Следующий();
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Справочники.ПричиныОтказа.ПустаяСсылка();
	
КонецФункции