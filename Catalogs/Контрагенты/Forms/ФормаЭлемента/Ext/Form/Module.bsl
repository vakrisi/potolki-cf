Функция ОтправитьДанныеЧерезСМСНаСервере()
	
	ПочтаКлиента = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(Объект.Ссылка, Справочники.ВидыКонтактнойИнформации.EmailКонтрагента);
	НомерТелефона = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(Объект.Ссылка, Справочники.ВидыКонтактнойИнформации.ТелефонКонтрагента);

	НДок = Документы.ОтправкаСМС.СоздатьДокумент();
	НДок.Дата = ТекущаяДатаСеанса();
	НДок.ТекстСообщения = "Доступ в онлайн-потолки. Адрес: " + Константы.АдресДилерскогоСайта.Получить() + ", Логин: " 
						+ ПочтаКлиента + ", Пароль: " + Объект.ПотолкиОнлайн_Пароль;
	НС = НДок.Получатели.Добавить();
	НС.Контрагент = Объект.Ссылка;
	НС.НомерТелефона = РаботаССМС.УбратьСимволыИзНомераТелефона(НомерТелефона);
	НДок.Записать();
	Возврат НДок.Ссылка;
	
КонецФункции

