&НаКлиенте
Процедура СгенерироватьПарольПотолкиОнлайн(Команда)
	Пароль="";
	ГСЧ=Новый ГенераторСлучайныхЧисел();
	Для сч=1 по 8 Цикл
		слч=ГСЧ.СлучайноеЧисло(97,122);
		Если ((слч % 2) = 0 ) Тогда
			слч=ГСЧ.СлучайноеЧисло(0,9);
			Пароль=Пароль+слч;
			Продолжить;
		КонецЕсли;
		Пароль=Пароль+Символ(слч);
	КонецЦикла;
	Объект.ПотолкиОнлайн_Пароль = Пароль;
КонецПроцедуры

