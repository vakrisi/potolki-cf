
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Ключ.Пустая() И НЕ значениеЗаполнено(Параметры.ЗначениеКопирования) Тогда
		Объект.ВидКонтрагента = Перечисления.ВидКонтрагента.ФизЛицо;
	КонецЕсли;
		
	Если Параметры.Ключ.Пустая() Тогда		
		Объект.ОсновнойДоговор = Неопределено;
		//nva 	
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ГруппыПользователейСостав.Пользователь КАК Пользователь
		|ИЗ
		|	Справочник.ГруппыПользователей.Состав КАК ГруппыПользователейСостав
		|ГДЕ
		|	ГруппыПользователейСостав.Ссылка В (&ГруппаПользователей)
		|	И ГруппыПользователейСостав.Пользователь.Ссылка = &Пользователь";
		
		МассивГруппПользователей = новый Массив;
		МассивГруппПользователей.Добавить(Справочники.ГруппыПользователей.НайтиПоНаименованию("Отдел продаж"));	
		МассивГруппПользователей.Добавить(Справочники.ГруппыПользователей.НайтиПоНаименованию("ПВЗ"));
		
		Запрос.УстановитьПараметр("ГруппаПользователей", МассивГруппПользователей);
		Запрос.УстановитьПараметр("Пользователь", ПараметрыСеанса.Пользователь);
		
		
		Если НЕ Запрос.Выполнить().Пустой() Тогда
			Объект.Родитель = Справочники.Контрагенты.НайтиПоКоду("000000069");
		КонецЕсли;	
	КонецЕсли;
	
	Параметры.Контрагент = Объект.Ссылка;
	СписокЗаказДоговоры.Параметры.УстановитьЗначениеПараметра("Контрагент", Параметры.Контрагент);	
	СписокЗаказыПокупателей.Параметры.УстановитьЗначениеПараметра("Контрагент", Параметры.Контрагент);	
	СписокПлатежныхДокументов.Параметры.УстановитьЗначениеПараметра("Контрагент", Параметры.Контрагент);	
	
	// СтандартныеПодсистемы.Свойства
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ИмяЭлементаДляРазмещения", "ГруппаДополнительныеРеквизиты");
	ДополнительныеПараметры.Вставить("ОтложеннаяИнициализация", Ложь);
	УправлениеСвойствами.ПриСозданииНаСервере(ЭтотОбъект, ДополнительныеПараметры);
	// Конец СтандартныеПодсистемы.Свойства
	
	// СтандартныеПодсистемы.КонтактнаяИнформация
	УправлениеКонтактнойИнформацией.ПриСозданииНаСервере(ЭтотОбъект, Объект, "ГруппаКонтактнаяИнформация", ПоложениеЗаголовкаЭлементаФормы.Лево);
	// Конец СтандартныеПодсистемы.КонтактнаяИнформация
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды

	УправлениеФормойНаСервере();
	
	КонтрольЗаполненияРеквизитов.ПриСозданииНаСервере(ЭтотОбъект, Объект);
	
	ПолФизЛицаОбязателенКЗаполнению = Константы.ПолФизЛицаОбязателенКЗаполнению.Получить();
	Если ПолФизЛицаОбязателенКЗаполнению Тогда
		Элементы.Пол.АвтоОтметкаНезаполненного = Истина;
	Иначе
		Элементы.Пол.АвтоОтметкаНезаполненного = Ложь;
	КонецЕсли;
	
	ВыборНового = Параметры.ВыборНового;
	
	//#5401
	Элементы.ГруппаИсторияЗвонков.Видимость = СофтФон.ИспользуетсяИнтеграцияСIPАТС();
	РазрешеноИспользованиеIPТелефонии = СофтФон.ТекущемуПользователюРазрешеноИспользованиеIPТелефонии();
	Элементы.ИсторияЗвонковАТСПрослушатьЗвонок.Видимость = РазрешеноИспользованиеIPТелефонии;
	Элементы.ИсторияЗвонковАТССкачатьЗаписьЗвонка.Видимость = РазрешеноИспользованиеIPТелефонии;
	
	НомерТелефона = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(Объект.Ссылка, Справочники.ВидыКонтактнойИнформации.ТелефонКонтрагента);
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(ИсторияЗвонковАТС, "НомерФормат", СофтФон.ПолучитьНомерТелефонаВМеждународномФорматеПользователя(НомерТелефона));
	
	//СофтФонСервер.ПриСозданииНаСервере(ЭтотОбъект);
	ВывестиДопЭлементыДляКонтактнойИнформации();
	
	ПредыдущееНаименование = Объект.Наименование;
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	// СтандартныеПодсистемы.Свойства
	УправлениеСвойствами.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	// Конец СтандартныеПодсистемы.Свойства
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	// СтандартныеПодсистемы.КонтактнаяИнформация
	УправлениеКонтактнойИнформацией.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	// Конец СтандартныеПодсистемы.КонтактнаяИнформация

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	// СтандартныеПодсистемы.Свойства
    УправлениеСвойствамиКлиент.ПослеЗагрузкиДополнительныхРеквизитов(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.Свойства
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)	
	
	//Объект.ОсновнойТелефон_ТолькоЦифры = СофтФон.ОставитьТолькоЦифры(Объект.ОсновнойТелефон);
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	//проверяем на существование контрагента с таким наименованием	
	Если Объект.Ссылка.Пустая() Тогда
		Запрос = Новый Запрос;
		УстановитьПривилегированныйРежим(Истина);
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Контрагенты.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Контрагенты КАК Контрагенты
		|ГДЕ
		|	Контрагенты.Наименование = &Наименование
		|	И НЕ Контрагенты.ЭтоГруппа";
		Запрос.УстановитьПараметр("Наименование", СокрЛП(Объект.Наименование));
		
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Контрагент не создан, в справочнике уже существует контрагент с таким наименованием!",,,,Отказ);
			УстановитьПривилегированныйРежим(Ложь);
			Возврат;
		КонецЕсли;	
	КонецЕсли;
	
	// проверяем условие уникальности по ИНН
	Если  Объект.Ссылка.Пустая()
		И (Объект.ВидКонтрагента = Перечисления.ВидКонтрагента.ЮрЛицо
			ИЛИ Объект.ВидКонтрагента = Перечисления.ВидКонтрагента.ИндивидуальныйПредприниматель)
		И ЗначениеЗаполнено(ТекущийОбъект.ИНН)
	Тогда
		
		Запрос = Новый Запрос;
		УстановитьПривилегированныйРежим(Истина);
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Контрагенты.ИНН,
		|	Контрагенты.КПП,
		|	Контрагенты.Наименование
		|ИЗ
		|	Справочник.Контрагенты КАК Контрагенты
		|ГДЕ
		|	Контрагенты.Ссылка <> &Ссылка
		|	И Контрагенты.ИНН = &ИНН
		|	" + ?(НЕ ЗначениеЗаполнено(ТекущийОбъект.КПП), "", " И (Контрагенты.КПП = &КПП ИЛИ Контрагенты.КПП = """")");
		
		Запрос.УстановитьПараметр("ИНН", ТекущийОбъект.ИНН);
		Запрос.УстановитьПараметр("КПП", ТекущийОбъект.КПП);
		Запрос.УстановитьПараметр("Ссылка", ТекущийОбъект.Ссылка);
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Следующий() Тогда
			Сообщить("Контрагент с ИНН существует: " + Выборка.Наименование + "!");
			УстановитьПривилегированныйРежим(Ложь);
			Отказ = Истина;
		КонецЕсли;
		
	КонецЕсли;
	
	Если ПолФизЛицаОбязателенКЗаполнению Тогда
		Если ТекущийОбъект.ВидКонтрагента= Перечисления.ВидКонтрагента.ФизЛицо И НЕ ЗначениеЗаполнено(ТекущийОбъект.Пол) Тогда
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = "Укажите пол физ.лица";
			Сообщение.Поле = "Пол";
			Сообщение.УстановитьДанные(ТекущийОбъект);
			Сообщение.Сообщить();
			Отказ = Истина;
		КонецЕсли;
	КонецЕсли;
		
	// СтандартныеПодсистемы.Свойства
	УправлениеСвойствами.ПередЗаписьюНаСервере(ЭтотОбъект, ТекущийОбъект);
	// Конец СтандартныеПодсистемы.Свойства
	
	// СтандартныеПодсистемы.КонтактнаяИнформация
	УправлениеКонтактнойИнформацией.ПередЗаписьюНаСервере(ЭтотОбъект, ТекущийОбъект);
	// Конец СтандартныеПодсистемы.КонтактнаяИнформация

КонецПроцедуры

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	
	// СтандартныеПодсистемы.Свойства
	УправлениеСвойствами.ОбработкаПроверкиЗаполнения(ЭтотОбъект, Отказ, ПроверяемыеРеквизиты);
	// Конец СтандартныеПодсистемы.Свойства
	
	// СтандартныеПодсистемы.КонтактнаяИнформация
	УправлениеКонтактнойИнформацией.ОбработкаПроверкиЗаполненияНаСервере(ЭтотОбъект, Объект, Отказ);
	// Конец СтандартныеПодсистемы.КонтактнаяИнформация
	
	КонтрольЗаполненияРеквизитов.ОбработкаПроверкиЗаполнения(ЭтотОбъект, Объект, Отказ);
	
КонецПроцедуры

