&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)
	Если НЕ ЗавершениеРаботы И ЗначениеЗаполнено(Объект.Ссылка) И ВыборНового Тогда
		ОповеститьОВыборе(Объект.Ссылка);	
	КонецЕсли;
КонецПроцедуры


&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "УстановкаКонтактногоЛицаПодписанта" И Параметр.Контрагент = Объект.Ссылка Тогда
		
		Объект.КонтактноеЛицоПодписант = Параметр.КонтактноеЛицо;
		Если НЕ Модифицированность Тогда
			Записать();
		КонецЕсли;
		Оповестить("УстановкаКонтактногоЛицаПодписантаВыполнена", Параметр.КонтактноеЛицо);
		
	ИначеЕсли ИмяСобытия = "УстановкаДУЛ" И Параметр.Контрагент = Объект.Ссылка Тогда
		
		Объект.ДокументУдостоверяющийЛичность = Параметр.ДУЛ;
		Если НЕ Модифицированность Тогда
			Записать();
		КонецЕсли;
		Оповестить("УстановкаДУЛВыполнена", Параметр.ДУЛ);
		
	ИначеЕсли ИмяСобытия = "ИзменилсяОсновнойДоговор" И Параметр = Объект.Ссылка Тогда
		Прочитать();
		
	ИначеЕсли ИмяСобытия = "ИзменилсяОсновнойСчет" И Параметр = Объект.Ссылка Тогда
		Прочитать();
		
	КонецЕсли;
	
	// СтандартныеПодсистемы.Свойства 
	Если УправлениеСвойствамиКлиент.ОбрабатыватьОповещения(ЭтотОбъект, ИмяСобытия, Параметр) Тогда
		ОбновитьЭлементыДополнительныхРеквизитов();
		УправлениеСвойствамиКлиент.ПослеЗагрузкиДополнительныхРеквизитов(ЭтотОбъект);
	КонецЕсли;
	// Конец СтандартныеПодсистемы.Свойства
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура НаименованиеПриИзменении(Элемент)
	
	Если ПустаяСтрока(Объект.НаименованиеПолное) ИЛИ Объект.НаименованиеПолное = ПредыдущееНаименование Тогда
		Объект.НаименованиеПолное = Объект.Наименование;
	КонецЕсли;
 
	ПредыдущееНаименование = Объект.Наименование;
	
КонецПроцедуры

&НаКлиенте
Процедура КатегорияПриИзменении(Элемент)
	ОбновитьЭлементыДополнительныхРеквизитов();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Подключаемый_ВыполнитьИсходящийЗвонок(Команда)
	
	ИмяКоманды = Команда.Имя; //ВыполнитьИсходящийЗвонокКонтактнаяИнформацияПоле96e149bexee77x11eax80c9x04d9f5cee27d3
	ИмяКоманды = СтрЗаменить(ИмяКоманды, "ВыполнитьИсходящийЗвонок", "");
	
	НайденныеСтроки = ЭтаФорма.КонтактнаяИнформацияОписаниеДополнительныхРеквизитов.НайтиСтроки(Новый Структура("ИмяРеквизита", ИмяКоманды));
	Если НайденныеСтроки.Количество() > 0 Тогда	
		СофтфонКлиент.ВыполнитьИсходящийЗвонок(Команда, ЭтаФорма, НайденныеСтроки[0].Представление);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ВыполнитьКомандуОтправитьСообщениеМессенджер(Команда)
	
	ИмяКоманды = Команда.Имя;
	ИмяКоманды = СтрЗаменить(ИмяКоманды, "ОтправитьСообщениеTelegram", "");
	ИмяКоманды = СтрЗаменить(ИмяКоманды, "ОтправитьСообщениеViber", "");
	ИмяКоманды = СтрЗаменить(ИмяКоманды, "ОтправитьСообщениеWhatsApp", "");
	
	НайденныеСтроки = ЭтаФорма.КонтактнаяИнформацияОписаниеДополнительныхРеквизитов.НайтиСтроки(Новый Структура("ИмяРеквизита", ИмяКоманды));
	Если НайденныеСтроки.Количество() > 0 Тогда	
		МессенджерыКлиент.ВыполнитьКомандуОтправитьСообщениеМессенджер(Команда, ЭтаФорма, НайденныеСтроки[0].Представление);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

&НаСервере
Процедура УправлениеФормойНаСервере()
	
	ЭтоСтранаЕС = (Константы.ТелефонияСтрана.Получить() = Справочники.СтраныМира.Литва);
	Элементы.ИдентификационныйНомерПлательщикаЕвропейскогоНДС.Видимость = Ложь;
	
	//#15976
	НайденныеСтроки = ЭтотОбъект.КонтактнаяИнформацияОписаниеДополнительныхРеквизитов.НайтиСтроки(Новый Структура("Вид", Справочники.ВидыКонтактнойИнформации.ЮрАдресКонтрагента));
	Если НайденныеСтроки.Количество() > 0 Тогда
		ИмяРеквизитаЮА = НайденныеСтроки[0].ИмяРеквизита;		
		Если НЕ Элементы.Найти(ИмяРеквизитаЮА) = Неопределено Тогда
			ЭлементЮА = Элементы[ИмяРеквизитаЮА];
			Если Объект.ВидКонтрагента = Перечисления.ВидКонтрагента.ФизЛицо
				ИЛИ Объект.ВидКонтрагента = Перечисления.ВидКонтрагента.ИндивидуальныйПредприниматель Тогда
				ЭлементЮА.Заголовок = "Адрес регистрации";
			Иначе
				ЭлементЮА.Заголовок = "";
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Если Объект.ВидКонтрагента = Перечисления.ВидКонтрагента.ФизЛицо Тогда
		Элементы.Наименование.Заголовок = "ФИО";
		//Элементы.НаименованиеПолное.Видимость = Ложь;
		Элементы.Пол.Видимость = Истина;
		Элементы.ИНН.Видимость = Ложь;
		Элементы.КПП.Видимость = Ложь;
		Элементы.ОГРН.Видимость = Ложь;
		Элементы.ДатаРождения.Видимость = Истина;
		Элементы.ДокументУдостоверяющийЛичность.Видимость = Истина;
