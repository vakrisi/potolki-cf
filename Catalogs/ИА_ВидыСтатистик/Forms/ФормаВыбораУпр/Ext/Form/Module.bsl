
&НаКлиенте
Процедура СписокПриАктивизацииСтроки(Элемент)
	тд = Элементы.Список.ТекущиеДанные;
	Если тд = Неопределено или тд.ЭтоГруппа ТОгда
		Описание = "";
		Возврат;
	КонецЕсли;
	
	Описание = тд.Описание;
	
	Если ЗначениеЗаполнено(тд.Аналитика1) Тогда
		Описание = Описание + Символы.ПС + Символы.ПС + "Статистика содержит следующие детализации:" + Символы.ПС + тд.Аналитика1;
		Если ЗначениеЗаполнено(тд.Аналитика2) Тогда
			Описание = Описание +Символы.ПС+ тд.Аналитика2;
		КонецЕсли;
		Если ЗначениеЗаполнено(тд.Аналитика3) Тогда
			Описание = Описание +Символы.ПС+ тд.Аналитика3;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры
