&НаКлиенте
Процедура КомандаПоказатьПомеченные(Команда)
	Элементы.КомандаПоказатьПомеченные.Пометка = не Элементы.КомандаПоказатьПомеченные.Пометка;
	
	УстОтборПомеченных(Элементы.КомандаПоказатьПомеченные.Пометка);
КонецПроцедуры

&НаСервере
Процедура УстОтборПомеченных(ТекЗн)
	Список.Параметры.УстановитьЗначениеПараметра("ПоказатьПомеченные", ТекЗн);
КонецПроцедуры


&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Список.Параметры.УстановитьЗначениеПараметра("ПоказатьПомеченные", ложь);
КонецПроцедуры


&НаСервереБезКонтекста
Процедура ПереместитьВверхНаСервере(пВидСт, СПомеченными)
	ИА_ФПСервер.ИзменитьПорядокВидаСтатистики(пВидСт, -1, СПомеченными);
КонецПроцедуры


&НаКлиенте
Процедура ПереместитьВверх(Команда)
	тд = Элементы.Список.ТекущиеДанные;
	если тд = Неопределено Тогда
		возврат;
	КонецЕсли;
	
	ПереместитьВверхНаСервере(тд.ссылка, Элементы.КомандаПоказатьПомеченные.Пометка);
	Элементы.Список.Обновить();
КонецПроцедуры


&НаСервереБезКонтекста
Процедура ПереместитьВнизНаСервере(пВидСт, СПомеченными)
	ИА_ФПСервер.ИзменитьПорядокВидаСтатистики(пВидСт, 1, СПомеченными);
КонецПроцедуры


&НаКлиенте
Процедура ПереместитьВниз(Команда)
	тд = Элементы.Список.ТекущиеДанные;
	если тд = Неопределено Тогда
		возврат;
	КонецЕсли;
	
	ПереместитьВнизНаСервере(тд.ссылка, Элементы.КомандаПоказатьПомеченные.Пометка);
	Элементы.Список.Обновить();

КонецПроцедуры

