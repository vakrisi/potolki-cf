&НаСервере
Процедура ОбработкаПроверкиЗаполнения(Отказ)
	
	Если Не ЗначениеЗаполнено(Объект.ИА_Источник) Тогда
		Сообщить("Не заполнен <Источник данных>", СтатусСообщения.Внимание);
		Отказ = Истина;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.ИА_СоответствиеКоличество) Тогда
		Сообщить("Не заполнено <Количество>", СтатусСообщения.Внимание);
		Отказ = Истина;
	КонецЕсли;	                  
	
	Если Не ЗначениеЗаполнено(Объект.ИА_СоответствиеПериод) Тогда
		Сообщить("Не заполнен <Период>", СтатусСообщения.Внимание);
		Отказ = Истина;
	КонецЕсли;	
	
КонецПроцедуры

