&НаКлиенте
Процедура СписокПараметровПараметрПриИзменении(Элемент)
	тд = Элементы.СписокПараметров.ТекущиеДанные;
	Если ЛЕВ(ВРЕГ(тд.ИмяПараметра),8) = "ПАРАМЕТР" Тогда
		тд.ИмяПараметра = "неопределено";
		Сообщить("Переметры нельзя называть в виде ""Параметр...""");
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция ПолучитьНастройкиXML()
	
	об = РеквизитФормыВЗначение("Объект");
	Настройки = об.ИА_НастройкаОтбораХранилище.Получить();
	Возврат Настройки;
	
КонецФункции

&НаСервере
Процедура УстановитьНастройкиКомпоновщика(ИА_КомпоновщикНастроек, уид) 
		
	СКД = Справочники.ИА_ВидыСтатистик.ПолучитьМакет("МакетСКД");
	Если ЗначениеЗаполнено(Объект.ИА_Источник) Тогда
		СКД.НаборыДанных.НаборДанных1.Запрос = "ВЫБРАТЬ * ИЗ " + Объект.ИА_Источник;
	Иначе
		Возврат;
	КонецЕсли;

	АдресСКД = ПоместитьВоВременноеХранилище(СКД,уид);
	ИА_КомпоновщикНастроек.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(АдресСКД)); //отвечает за доступность полей выбора
	ИА_КомпоновщикНастроек.ЗагрузитьНастройки(СКД.НастройкиПоУмолчанию);
		   	
КонецПроцедуры 

&НаСервере
Процедура ВосстановитьНастройки(ИА_КомпоновщикНастроек, уид) 
	
	об = РеквизитФормыВЗначение("Объект");
	УстановитьНастройкиКомпоновщика(ИА_КомпоновщикНастроек, уид);
	Если об.ИА_НастройкаОтбораХранилище.Получить()<>Неопределено Тогда
		ИА_КомпоновщикНастроек.ЗагрузитьНастройки(ПолучитьНастройкиXML());
	КонецЕсли; 
		
КонецПроцедуры



&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	//
	ПроверитьКорректностьВидаСтатистики(Отказ);
	
	Если ТекущийОбъект.Ссылка.Пустая() Тогда
		ТекущийОбъект.УстановитьСсылкуНового(Справочники.ИА_ВидыСтатистик.ПолучитьСсылку(Новый УникальныйИдентификатор));
	КонецЕсли;
	
	// 
	Если Объект.ВариантПолученияДанных <> Перечисления.ИА_ВариантыПолученияДанныхСтатистик.ИзЗапроса Тогда 
		Объект.ВидИтоговЗаОдинПериод = Перечисления.ИА_ВидыИтоговЗаОдинПериод.Сумма;
	КонецЕсли;
	
	// сохраним отборы в конструкторе
	ТекущийОбъект.ИА_НастройкаОтбораХранилище = Новый ХранилищеЗначения(ИА_КомпоновщикНастроек.Настройки);
	
	//
	Запрос = ПолучитьЗапросСтатистики(ТекущийОбъект);
	ТекущийОбъект.ТекстЗапросаИтоговый = Запрос.Текст;
	//		
	тзПараметры = Новый ТаблицаЗначений;
	тзПараметры.Колонки.Добавить("ИмяПараметра");
	тзПараметры.Колонки.Добавить("Значение");
	Для каждого Параметр из Запрос.Параметры Цикл
		стр = тзПараметры.Добавить();
		стр.ИмяПараметра = Параметр.Ключ;
		стр.Значение = Параметр.Значение;
	КонецЦикла;
	Хранилище = Новый ХранилищеЗначения(тзПараметры);
	ТекущийОбъект.ТабПараметровЗапроса = Хранилище;
	//
	
	//Формула
	Если ТекущийОбъект.ВариантПолученияДанных = Перечисления.ИА_ВариантыПолученияДанныхСтатистик.Формула Тогда 
		ТекущийОбъект.СтатистикиФормулы.Очистить();
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	ИА_ВидыСтатистик.Ссылка КАК Статистика,
		               |	ИА_ВидыСтатистик.КраткоеНаименование КАК КраткоеНаименование
		               |ИЗ
		               |	Справочник.ИА_ВидыСтатистик КАК ИА_ВидыСтатистик
		               |ГДЕ
		               |	ИА_ВидыСтатистик.КраткоеНаименование <> """"";
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Если найти(ТекущийОбъект.ФормулаРасчета,  "["+Выборка.КраткоеНаименование+"]") > 0 Тогда
				Новстр = ТекущийОбъект.СтатистикиФормулы.Добавить();
				Новстр.Статистика = Выборка.Статистика;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьСтатистику(Команда)
	
	//-> Григорьева
	Если Не ЗначениеЗаполнено(ПериодПроверкиСтатистики.ДатаНачала)
		ИЛИ НЕ ЗначениеЗаполнено(ПериодПроверкиСтатистики.ДатаОкончания)
		ИЛИ ПериодПроверкиСтатистики.ДатаНачала > ПериодПроверкиСтатистики.ДатаОкончания
		Тогда
			ИА_КСУОбщийКлиентСервер.СообщитьПользователю("Некорректно задан период",, "ПериодПроверкиСтатистики");
			Возврат;
	КонецЕсли; 
	//<- Григорьева
	
	Если Модифицированность Тогда
		ПоказатьВопрос(Новый ОписаниеОповещения("ПроверитьСтатистикуЗавершение", ЭтотОбъект), "Для проверки необходимо записать изменения. Продолжить?",РежимДиалогаВопрос.ДаНет);
        Возврат;
	КонецЕсли;
	
	ПроверитьСтатистикуФрагмент();
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьСтатистикуЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса=КодВозвратаДиалога.Да Тогда
		Записать();
	Иначе
		возврат;
	КонецЕсли;
	
	ПроверитьСтатистикуФрагмент();

КонецПроцедуры

&НаКлиенте
Процедура ПроверитьСтатистикуФрагмент()
	
	Перем ТабДок;
	
	ТабДок = ПечатьСтатистики_Сервер();
	ТабДок.Показать();

КонецПроцедуры

&НаСервере
Функция ПечатьСтатистики_Сервер()
	ТабДок = Новый ТабличныйДокумент;
	Макет = Справочники.ИА_ВидыСтатистик.ПолучитьМакет("ПроверкаСтатистики");
	
	ОблШапка = Макет.ПолучитьОбласть("Шапка");
	ТабДок.Вывести(ОблШапка);
	
	Если Объект.ВариантПолученияДанных=Перечисления.ИА_ВариантыПолученияДанныхСтатистик.Формула Тогда
		РезТЗ_Данные = Новый ТаблицаЗначений;
		РезТЗ_Данные.Колонки.Добавить("Период", Новый ОписаниеТипов("Дата"));
		РезТЗ_Данные.Колонки.Добавить("ДатаНачала", Новый ОписаниеТипов("Дата"));
		РезТЗ_Данные.Колонки.Добавить("ДатаКонца", Новый ОписаниеТипов("Дата"));
		РезТЗ_Данные.Колонки.Добавить("Аналитика1", Новый ОписаниеТипов(Объект.Аналитика1.ТипАналитикиПолный));
		РезТЗ_Данные.Колонки.Добавить("Аналитика2", Новый ОписаниеТипов(Объект.Аналитика2.ТипАналитикиПолный));
		РезТЗ_Данные.Колонки.Добавить("Аналитика3", Новый ОписаниеТипов(Объект.Аналитика3.ТипАналитикиПолный));		
		РезТЗ_Данные.Колонки.Добавить("Значение", Новый ОписаниеТипов("Число"));
		
		РезТЗ_Данные.Колонки.Добавить("РеальныеДанные", Новый ОписаниеТипов("Булево"));
		РезТЗ_Данные.Колонки.Добавить("ЕстьЗначение", Новый ОписаниеТипов("Булево"));
		РезТЗ_Данные.Колонки.Добавить("ДанныеВведены", Новый ОписаниеТипов("Булево"));
		
		СтруктСтрСтат = Новый Структура("ВидСтатистики,Аналитика1,Аналитика2,Аналитика3,Данные,ПериодДетализации", объект.Ссылка,Неопределено,Неопределено,Неопределено,РезТЗ_Данные, Перечисления.ИА_ПериодыДетализации.День);
		
		ИА_Статистики.ПолучитьТаблицуПериодов(ПериодПроверкиСтатистики.ДатаНачала, ПериодПроверкиСтатистики.ДатаОкончания,СтруктСтрСтат,Неопределено);		
		тз = ИА_Защита_Статистика.ПолучитьТЗДанныеСтатистики(СтруктСтрСтат,ПериодПроверкиСтатистики.ДатаНачала, ПериодПроверкиСтатистики.ДатаОкончания);
		
		Для каждого стр из тз Цикл
			ОблСтрока = Макет.ПолучитьОбласть("Строка");
			ОблСтрока.Параметры.Заполнить(стр);
			ТабДок.Вывести(ОблСтрока);
		КонецЦикла;
	Иначе
		об = РеквизитФормыВЗначение("Объект");
		об.ИА_НастройкаОтбораХранилище = Новый ХранилищеЗначения(ИА_КомпоновщикНастроек.Настройки);
		Запрос = ПолучитьЗапросСтатистики(об);
		
		Запрос.УстановитьПараметр("ДатаНачала", ПериодПроверкиСтатистики.ДатаНачала);
		Запрос.УстановитьПараметр("ДатаКонца", ПериодПроверкиСтатистики.ДатаОкончания);
		Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДата());
		
		Запрос.УстановитьПараметр("Аналитика1", Неопределено);
		Запрос.УстановитьПараметр("Аналитика2", Неопределено);
		Запрос.УстановитьПараметр("Аналитика3", Неопределено);
		
		Выборка = Запрос.выполнить().Выбрать();
		
		Пока Выборка.Следующий() Цикл
			ОблСтрока = Макет.ПолучитьОбласть("Строка");
			ОблСтрока.Параметры.Заполнить(Выборка);
			ТабДок.Вывести(ОблСтрока);
		КонецЦикла;
	КонецЕсли;
	
	ТабДок.АвтоМасштаб = Истина;
	ТабДок.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	ТабДок.ОтображатьЗаголовки = Ложь;
	ТабДок.ОтображатьСетку = Ложь;
	
	Возврат ТабДок;
КонецФункции

