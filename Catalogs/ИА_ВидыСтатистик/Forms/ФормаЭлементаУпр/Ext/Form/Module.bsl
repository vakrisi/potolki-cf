&НаСервере
Процедура ЗаполнитьПараметрыНаСервере()
    Запрос = Новый Запрос(Объект.ТекстЗапроса);	
	
	Попытка
		мПараметрыЗапроса = Запрос.НайтиПараметры();
    Исключение
        ИА_БФКС.СообщениеОбОшибке(ОписаниеОшибки());
		Возврат;
	КонецПопытки;
	
	Для Каждого ПараметрЗапроса Из мПараметрыЗапроса Цикл
		
		//ИА_ 18.09.2015 Отсекаем предопределенные параметры
		Если ПараметрЗапроса.Имя = "ДатаНачала" ИЛИ ПараметрЗапроса.Имя = "ДатаКонца" Тогда 
			Продолжить;
		КонецЕсли;
		//
		
		ИмяПараметра =  ПараметрЗапроса.Имя;
		М = СписокПараметров.НайтиСтроки(Новый Структура("ИмяПараметра", ИмяПараметра));
        Если М.Количество() > 0 Тогда
            СтрокаПараметров = М[0];
        Иначе
        	СтрокаПараметров = СписокПараметров.Добавить();
            СтрокаПараметров.ИмяПараметра = ИмяПараметра;
        КонецЕсли; 
		СтрокаПараметров.Значение = ПараметрЗапроса.ТипЗначения.ПривестиЗначение(СтрокаПараметров.Значение);
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПараметры(Команда)
    ЗаполнитьПараметрыНаСервере();
КонецПроцедуры

&НаСервере
Процедура ПроверитьКорректностьВидаСтатистики(Отказ = Неопределено, СоздаватьИсключение = Ложь)
    Если Объект.ВариантПолученияДанных = Перечисления.ИА_ВариантыПолученияДанныхСтатистик.ИзЗапроса
        И ПустаяСтрока(СокрЛП(Объект.ТекстЗапроса))
        Тогда
        Сообщение = Новый СообщениеПользователю;
        Сообщение.Текст = "Не заполнен ""Текст запроса""";
        Сообщение.Сообщить(); 
    	Отказ = Истина;
        
        Если СоздаватьИсключение Тогда
        	ВызватьИсключение Сообщение.Текст; 
        КонецЕсли; 
	КонецЕсли;  
	
	Если Объект.ВариантПолученияДанных = Перечисления.ИА_ВариантыПолученияДанныхСтатистик.Формула
        И ПустаяСтрока(СокрЛП(Объект.ФормулаРасчета))
        Тогда
        Сообщение = Новый СообщениеПользователю;
        Сообщение.Текст = "Не заполнена ""Формула""";
        Сообщение.Сообщить(); 
    	Отказ = Истина;
        
        Если СоздаватьИсключение Тогда
        	ВызватьИсключение Сообщение.Текст; 
        КонецЕсли; 
    КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура СписокПараметровЗначениеНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	тд = Элементы.СписокПараметров.ТекущиеДанные;
	Если тд.Значение = Неопределено Тогда
		Элемент.ВыбиратьТип = Истина;
	Иначе
		Элемент.ВыбиратьТип = Ложь;
	КонецЕсли;
	
КонецПроцедуры


&НаКлиенте
