&НаКлиенте
Процедура ИспользоватьКуб1ПриИзменении(Элемент)
	Если Объект.ИспользоватьКуб Тогда
		ПроверитьВариантПолученияДанных();
	КонецЕсли;
КонецПроцедуры
	
&НаСервере
Процедура ПроверитьВариантПолученияДанных()
	Если Объект.ВариантПолученияДанных <> Перечисления.ИА_ВариантыПолученияДанныхСтатистик.ИзЗапроса Тогда
		Сообщить("Кубы можно использовать только для статистик с получением данных из запроса.");
		Объект.ИспользоватьКуб = Ложь;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ПроверитьПроизвВыражение(Отказ)
	Если Объект.ВидИтоговЗаОдинПериод = Перечисления.ИА_ВидыИтоговЗаОдинПериод.ПроизвольноеВыражение И Сокрлп(Объект.ИтогПроизвольноеВыражение)="" Тогда
		Сообщить("Укажите выражение для получения итогов за один период.");
		Отказ = истина;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	ПроверитьПроизвВыражение(Отказ);
	
	Если Объект.ИспользоватьКуб и Объект.НомерКуба.Пустая() Тогда
		Сообщить("Укажите номер куба!");
		Отказ = истина;
	КонецЕсли;
	
	Если Объект.ВариантПолученияДанных = ПредопределенноеЗначение("Перечисление.ИА_ВариантыПолученияДанныхСтатистик.Конструктором") Тогда
		ОбработкаПроверкиЗаполнения(Отказ);
	КонецЕсли;	
	//СохранитьНастройки();

КонецПроцедуры

&НаКлиенте
Процедура ВариантПолученияДанныхПриИзменении(Элемент)
	
	УстановитьДоступностьЭлементов();
	
КонецПроцедуры


&НаКлиенте
Процедура УстановитьДоступностьЭлементов()
	
	ИзЗапроса = (Объект.ВариантПолученияДанных = ПредопределенноеЗначение("Перечисление.ИА_ВариантыПолученияДанныхСтатистик.ИзЗапроса"));
	ИзКонструктора = (Объект.ВариантПолученияДанных = ПредопределенноеЗначение("Перечисление.ИА_ВариантыПолученияДанныхСтатистик.Конструктором"));
	ИзДокумента = (Объект.ВариантПолученияДанных = ПредопределенноеЗначение("Перечисление.ИА_ВариантыПолученияДанныхСтатистик.ДокументомСтатистика"));
	Формулой = (Объект.ВариантПолученияДанных = ПредопределенноеЗначение("Перечисление.ИА_ВариантыПолученияДанныхСтатистик.Формула"));
	
	Элементы.ГруппаСКД.Видимость = ИзКонструктора;
	Элементы.ГруппаНастройкиДляЗапроса.Видимость = ИзЗапроса;
	Элементы.ГруппаВопросы.Видимость = ИзДокумента;
	Элементы.ГруппаФормула.Видимость = Формулой;

		
	Если ИзЗапроса Тогда
		Элементы.ВидИтоговЗаОдинПериод.Видимость = Не Объект.ЗапросОтображаетСостояние;			
	ИначеЕсли ИзКонструктора Тогда
		Элементы.ИА_СоответствиеАналитика1.Доступность = ЗначениеЗаполнено(Объект.ИА_Источник);
		Элементы.ИА_СоответствиеАналитика2.Доступность = ЗначениеЗаполнено(Объект.ИА_Источник);
		Элементы.ИА_СоответствиеАналитика3.Доступность = ЗначениеЗаполнено(Объект.ИА_Источник);
		Элементы.ИА_СоответствиеКоличество.Доступность = ЗначениеЗаполнено(Объект.ИА_Источник);
		
		Элементы.ИА_СоответствиеПериод.Доступность = ЗначениеЗаполнено(Объект.ИА_Источник);
		
		Если ЗначениеЗаполнено(Объект.ИА_Источник) И (Найти(Объект.ИА_Источник, ".СрезПоследних") <> 0
			Или Найти(Объект.ИА_Источник, ".СрезПервых") <> 0 Или Найти(Объект.ИА_Источник, ".Остатки") <> 0) Тогда
			Объект.ИА_СоответствиеПериод = "&ДатаКонца";
			Элементы.ИА_СоответствиеПериод.Доступность = Ложь;
		Иначе
			Элементы.ИА_СоответствиеПериод.Доступность = Истина;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПрочитатьПараметрыЗапросаНаСервере()
	
	Об = РеквизитФормыВЗначение("Объект");
	Хранилище = Об.ТабПараметровЗапроса;
	Знч = Хранилище.Получить();
	Если НЕ Знч = Неопределено Тогда
		ЗначениеВРеквизитФормы(Знч,"СписокПараметров");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если не ИА_Защита_Общий.ЛицензияДоступна("Статистика") Тогда
		Отказ = Истина;
		возврат;
	КонецЕсли;
	
	УстановитьДоступностьЭлементов();
	ВосстановитьНастройки(ИА_КомпоновщикНастроек,ЭтаФорма.УникальныйИдентификатор);
	ПрочитатьПараметрыЗапросаНаСервере();
	
	//-> Григорьева
	ПериодПроверкиСтатистики.ДатаНачала = НачалоДня(ТекущаяДата() - 60*60*24*10);
	ПериодПроверкиСтатистики.ДатаОкончания = КонецДня(ТекущаяДата());
	//<- Григорьева
	
КонецПроцедуры

&НаСервере
Процедура УстановитьНастройкиКомпоновщикаСервер()  
	
	Об = РеквизитФормыВЗначение("Объект");
	Об.УстановитьНастройкиКомпоновщика(ИА_КомпоновщикНастроек);
	
КонецПроцедуры 

&НаКлиенте
Процедура ИА_ИсточникНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	Структура = Новый Структура("ЭтоАналитика", Ложь);

	ОткрытьФорму("Справочник.ИА_ВидыСтатистик.Форма.ИА_ФормаВыбораИсточника", Структура, ЭтаФорма,,,, Новый ОписаниеОповещения("ИА_ИсточникНачалоВыбораЗавершение", ЭтотОбъект), РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);
	  
КонецПроцедуры

&НаКлиенте
Процедура ИА_ИсточникНачалоВыбораЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Рез = Результат;
	
	СбросСоответствий();
	
	Если ЗначениеЗаполнено(Рез) Тогда 
		Объект.ИА_Источник = Рез.Имя;
	КонецЕсли;
	
	УстановитьДоступностьЭлементов(); 
	СбросНастроекОтборов();

КонецПроцедуры 

