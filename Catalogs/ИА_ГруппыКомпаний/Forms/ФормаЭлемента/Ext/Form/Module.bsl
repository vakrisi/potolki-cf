&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если НЕ Параметры.ЗначениеКопирования.Пустая() Тогда
		Сообщить("Группы компаний нельзя копировать");
    	Отказ = Истина; 
		СтандартнаяОбработка = Ложь;
		возврат;
	КонецЕсли;
	
	Если не объект.ГоловнаяОрганизация.Пустая() тогда
		Элементы.ГоловнаяОрганизация.СписокВыбора.Добавить(объект.ГоловнаяОрганизация);	
	КонецЕсли;
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьДоступныеОрганизации(ОбъектСсылка)
	Запрос = новый запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	Организации.Ссылка КАК Ссылка
	               |ИЗ
	               |	Справочник.Организации КАК Организации
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ИА_ГруппыКомпаний.ДочерниеОрганизации КАК ИА_ГруппыКомпанийДочерниеОрганизации
	               |		ПО (Организации.Ссылка = ИА_ГруппыКомпанийДочерниеОрганизации.Организация
	               |				ИЛИ Организации.Ссылка = ИА_ГруппыКомпанийДочерниеОрганизации.Ссылка.ГоловнаяОрганизация)
	               |			И (ИА_ГруппыКомпанийДочерниеОрганизации.Ссылка <> &ОбъектСсылка)
	               |ГДЕ
	               |	Организации.ПометкаУдаления = ЛОЖЬ
	               |	И ИА_ГруппыКомпанийДочерниеОрганизации.Ссылка ЕСТЬ NULL";
	
	Запрос.УстановитьПараметр("ОбъектСсылка", ОбъектСсылка);
	Рез = запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
	возврат рез;
КонецФункции
	
