&НаКлиенте
Процедура ПриОткрытии(Отказ)
	оргМ = ПолучитьДоступныеОрганизации(Объект.Ссылка);
	Если оргМ.Количество() = 0 и объект.Ссылка.Пустая() Тогда
		ОпОп = новый ОписаниеОповещения("ЗакрытиеПредупреждения", ЭтотОбъект);
		ПоказатьПредупреждение(,"Новую группу компаний сформировать невозможно. 
		|Нет организаций, свободных для формирования группы. 
		|Если у вас есть организации, не вошедшие в группы компаний, 
		|убедитесь в том, что они не помечены на удаление (такие 
		|организации игнорируются при формировании групп компаний).");
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ДочерниеОрганизацииПриАктивизацииСтроки(Элемент)
	тд = Элементы.ДочерниеОрганизации.ТекущиеДанные;
	Если тд = Неопределено тогда
		Возврат;
	КонецЕсли;
	
	оргМ = ПолучитьДоступныеОрганизации(Объект.Ссылка);
	инд = оргМ.Найти(объект.ГоловнаяОрганизация);
	Если инд <> Неопределено тогда
		оргМ.удалить(инд);
	КонецЕсли;
	
	для каждого стр из объект.ДочерниеОрганизации цикл
		если стр<>тд тогда
			инд = оргМ.Найти(стр.Организация);
			Если инд <> Неопределено тогда
				оргМ.удалить(инд);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Элементы.ДочерниеОрганизацииОрганизация.СписокВыбора.ЗагрузитьЗначения(оргМ);
КонецПроцедуры

&НаКлиенте
Процедура ГоловнаяОрганизацияНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	оргМ = ПолучитьДоступныеОрганизации(Объект.Ссылка);
	Если объект.ГоловнаяОрганизация.Пустая() = ложь и оргМ.Найти(объект.ГоловнаяОрганизация) = Неопределено тогда
		оргМ.Добавить(объект.ГоловнаяОрганизация);
	КонецЕсли;
	для каждого стр из объект.ДочерниеОрганизации цикл
		инд = оргМ.Найти(стр.Организация);
		Если инд <> Неопределено тогда
			оргМ.удалить(инд);
		КонецЕсли;
	КонецЦикла;
	Элементы.ГоловнаяОрганизация.СписокВыбора.ЗагрузитьЗначения(оргМ);
КонецПроцедуры
