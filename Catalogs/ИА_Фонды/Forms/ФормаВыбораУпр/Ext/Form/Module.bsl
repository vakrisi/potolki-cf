
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("ИсключитьФонды") Тогда
		Список.Параметры.УстановитьЗначениеПараметра("ИсключитьФонды", Параметры.ИсключитьФонды);
		Список.Параметры.УстановитьЗначениеПараметра("ПрИсключатьФонды", истина);
	Иначе
		Список.Параметры.УстановитьЗначениеПараметра("ИсключитьФонды", новый Массив);
		Список.Параметры.УстановитьЗначениеПараметра("ПрИсключатьФонды", ложь);
	КонецЕсли;
	Список.Параметры.УстановитьЗначениеПараметра("ПоказатьПомеченные", ложь);
КонецПроцедуры

&НаСервереБезКонтекста
Процедура СписокПриПолученииДанныхНаСервере(ИмяЭлемента, Настройки, Строки)
	Для каждого стр из Строки Цикл
		стрД = стр.Значение.Данные;
		стрД.Наименование = ВРЕГ(стрД.Наименование);
	КонецЦикла;
КонецПроцедуры


&НаКлиенте
Процедура КомандаПоказатьПомеченные(Команда)
	Элементы.КомандаПоказатьПомеченные.Пометка = не Элементы.КомандаПоказатьПомеченные.Пометка;
	
	УстОтборПомеченных(Элементы.КомандаПоказатьПомеченные.Пометка);
КонецПроцедуры

&НаСервере
Процедура УстОтборПомеченных(ТекЗн)
	Список.Параметры.УстановитьЗначениеПараметра("ПоказатьПомеченные", ТекЗн);
КонецПроцедуры
