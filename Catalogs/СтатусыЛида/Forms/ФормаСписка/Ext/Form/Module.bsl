
&НаКлиенте
Процедура ИзменитьПорядок(Команда)
	
	Вверх = (Команда.Имя = "ПереместитьВверх");
	
	ТекущиеДанные = Элементы.Список.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;	
	
	ИзменитьПорядокНаСервере(ТекущиеДанные.Ссылка, Вверх);
	
	Элементы.Список.Обновить();
	
КонецПроцедуры

Процедура ИзменитьПорядокНаСервере(ТекСтатус, Вверх)
	
	ОбщийМодульСервер.ИзменитьРеквизитДопУпорядочивания("СтатусыЛида", ТекСтатус, Вверх);
		
КонецПроцедуры
