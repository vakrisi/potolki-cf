
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если НЕ Параметры.Свойство("НастройкаСинхронизации") Тогда
		Возврат;	
	КонецЕсли;
	
	ЗаполнитьСопоставлениеВидовКонтрагентовПоУмолчанию();
	
	НастройкаСинхронизации = Параметры.НастройкаСинхронизации;	
	
	НастройкиКомпоновкиДанныхКонтрагентов = Неопределено;
	
	ХранилищеНастроек = НастройкаСинхронизации.ХранилищеНастроек.Получить();
	Если ТипЗнч(ХранилищеНастроек) = Тип("Структура") И ХранилищеНастроек.Свойство("НастройкиСинхронизацииКонтрагентов") Тогда
		
		НастройкиСинхронизацииКонтрагентов = ХранилищеНастроек.НастройкиСинхронизацииКонтрагентов;
		
		НастройкиСинхронизацииКонтрагентов.Свойство("НастройкиКомпоновкиДанныхКонтрагентов", НастройкиКомпоновкиДанныхКонтрагентов);
		
		ЗаполнитьСопоставлениеВидовКонтрагентов(НастройкиСинхронизацииКонтрагентов, "ВидыКонтрагентовКакКомпании", "Компания");
		ЗаполнитьСопоставлениеВидовКонтрагентов(НастройкиСинхронизацииКонтрагентов, "ВидыКонтрагентовКакКонтакты", "Контакт");
		
	КонецЕсли;
	
	СхемаКД = Справочники.НастройкиСинхронизацииСБитрикс24.ПолучитьМакет("СхемаВыгрузкиКонтрагентов");
	
	АдресСхемы = ПоместитьВоВременноеХранилище(СхемаКД, УникальныйИдентификатор);
	КомпоновщикНастроекКомпоновкиДанныхКонтрагентов.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(АдресСхемы)); 
	
	Если НастройкиКомпоновкиДанныхКонтрагентов = Неопределено Тогда
		
		КомпоновщикНастроекКомпоновкиДанныхКонтрагентов.ЗагрузитьНастройки(СхемаКД.НастройкиПоУмолчанию);
		
	Иначе
		
		КомпоновщикНастроекКомпоновкиДанныхКонтрагентов.ЗагрузитьНастройки(НастройкиКомпоновкиДанныхКонтрагентов);
		КомпоновщикНастроекКомпоновкиДанныхКонтрагентов.Восстановить(СпособВосстановленияНастроекКомпоновкиДанных.ПроверятьДоступность);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
		
	Если Модифицированность И НЕ НужноЗакрытьОкно Тогда
		Отказ = Истина; 
		
		Если ЗавершениеРаботы Тогда 
			ТекстПредупреждения = "Настройки не будут сохранены. Закрыть?"; 
		Иначе
			Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопросаОЗакрытииОкна", ЭтаФорма, Параметры);
			ПоказатьВопрос(Оповещение, "Настройки были изменены. Сохранить изменения перед закрытием?", РежимДиалогаВопрос.ДаНетОтмена, 0);
		КонецЕсли;
	КонецЕсли;
	

КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияВопросаОЗакрытииОкна(Результат, Параметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		НужноЗакрытьОкно = Истина;
		СохранениеНастроек();
        Закрыть();
	ИначеЕсли Результат = КодВозвратаДиалога.Нет Тогда
		НужноЗакрытьОкно = Истина;
		Закрыть();
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура РегистрацияКСинхронизации(Команда)
	
	ПараметрыФормы = новый Структура;
	ПараметрыФормы.Вставить("АдресКомпоновки", ПолучитьТекущиеНастройкиКомпоновкиДанных());
	ПараметрыФормы.Вставить("НастройкаСинхронизации", НастройкаСинхронизации);
	
	ОткрытьФорму("Справочник.НастройкиСинхронизацииСБитрикс24.Форма.РегистрацияКСинхронизации", ПараметрыФормы);
	
КонецПроцедуры

&НаКлиенте
Процедура Применить(Команда)
	
	СохранениеНастроек();
	Закрыть();
	
КонецПроцедуры

&НаСервере
Процедура СохранениеНастроек()

	НастройкиОбмена = НастройкаСинхронизации.ХранилищеНастроек.Получить();
	
	Если НЕ ТипЗнч(НастройкиОбмена) = Тип("Структура") Тогда
		НастройкиОбмена = новый Структура;
	КонецЕсли;
		
	Если НЕ НастройкиОбмена.Свойство("НастройкиСинхронизацииКонтрагентов") Тогда
		СтруктураНастроек = Новый Структура;	
	Иначе
		СтруктураНастроек = НастройкиОбмена.НастройкиСинхронизацииКонтрагентов;	
	КонецЕсли;
	
	Справочники.НастройкиСинхронизацииСБитрикс24.ДобавитьНастройкуВСтруктуру(СтруктураНастроек, "НастройкиКомпоновкиДанныхКонтрагентов", КомпоновщикНастроекКомпоновкиДанныхКонтрагентов.ПолучитьНастройки());
	
	Справочники.НастройкиСинхронизацииСБитрикс24.ДобавитьНастройкуВСтруктуру(СтруктураНастроек, "ВидыКонтрагентовКакКомпании", ПолучитьМассивВидовКонтрагентов("Компания"));
	Справочники.НастройкиСинхронизацииСБитрикс24.ДобавитьНастройкуВСтруктуру(СтруктураНастроек, "ВидыКонтрагентовКакКонтакты", ПолучитьМассивВидовКонтрагентов("Контакт"));
	
	Если НЕ НастройкиОбмена.Свойство("НастройкиСинхронизацииКонтрагентов") Тогда
		НастройкиОбмена.Вставить("НастройкиСинхронизацииКонтрагентов", СтруктураНастроек); 	
	Иначе
		НастройкиОбмена.НастройкиСинхронизацииКонтрагентов = СтруктураНастроек;
	КонецЕсли;
	
	ТекущаяНастройкаСинхронизации = НастройкаСинхронизации.ПолучитьОбъект();
	ТекущаяНастройкаСинхронизации.СинхронизацияКонтрагентов = Истина;
	ТекущаяНастройкаСинхронизации.ХранилищеНастроек = Новый ХранилищеЗначения(НастройкиОбмена);
	ТекущаяНастройкаСинхронизации.Записать();	
	
	ОбновитьПовторноИспользуемыеЗначения();	
	
	Модифицированность = Ложь;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция ПолучитьТекущиеНастройкиКомпоновкиДанных()
	
	Возврат ПоместитьВоВременноеХранилище(КомпоновщикНастроекКомпоновкиДанныхКонтрагентов.ПолучитьНастройки(), УникальныйИдентификатор);
	
КонецФункции

&НаСервере
Процедура ЗаполнитьСопоставлениеВидовКонтрагентовПоУмолчанию()
	
	// По умолчанию
	НоваяСтрока = СопоставлениеВидовКонтрагентов.Добавить();
	НоваяСтрока.ВидКонтрагента = Перечисления.ВидКонтрагента.ЮрЛицо;
	НоваяСтрока.СущностьБ24 = "Компания";
	
	НоваяСтрока = СопоставлениеВидовКонтрагентов.Добавить();
	НоваяСтрока.ВидКонтрагента = Перечисления.ВидКонтрагента.ИндивидуальныйПредприниматель;
	НоваяСтрока.СущностьБ24 = "Компания";
	
	НоваяСтрока = СопоставлениеВидовКонтрагентов.Добавить();
	НоваяСтрока.ВидКонтрагента = Перечисления.ВидКонтрагента.ФизЛицо;
	НоваяСтрока.СущностьБ24 = "Контакт";
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСопоставлениеВидовКонтрагентов(НастройкиСинхронизацииКонтрагентов, СвойствоНастройки, Сущность)
	
	Если НастройкиСинхронизацииКонтрагентов.Свойство(СвойствоНастройки) И ТипЗнч(НастройкиСинхронизацииКонтрагентов[СвойствоНастройки]) = Тип("Массив") Тогда
	
		Для Каждого ТекущийВид Из НастройкиСинхронизацииКонтрагентов[СвойствоНастройки] Цикл
			
			НайденнаяСтрока = СопоставлениеВидовКонтрагентов.НайтиСтроки(новый Структура("ВидКонтрагента", ТекущийВид));
			Если НайденнаяСтрока.Количество() > 0 Тогда
				НайденнаяСтрока[0].СущностьБ24 = Сущность;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьМассивВидовКонтрагентов(Сущность)
	
	Массив = новый Массив;
	
	НайденныеСтроки = СопоставлениеВидовКонтрагентов.НайтиСтроки(новый Структура("СущностьБ24", Сущность));
	
	Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
		Массив.Добавить(НайденнаяСтрока.ВидКонтрагента);
	КонецЦикла;
	
	Возврат Массив;
	
КонецФункции

#КонецОбласти

