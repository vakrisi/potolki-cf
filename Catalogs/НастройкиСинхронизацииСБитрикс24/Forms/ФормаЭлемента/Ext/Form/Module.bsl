&НаКлиенте
Процедура УстановитьДоступностьКнопок()
	
	ДоступностьЭлементов = (ЗначениеЗаполнено(Объект.Портал) И ЗначениеЗаполнено(Токен));
	
	Элементы.ГруппаНастройкиЗагрузкиДанных.Доступность = ДоступностьЭлементов;
	Элементы.ГруппаЛогирование.Доступность = ДоступностьЭлементов;
	
КонецПроцедуры

&НаСервере
Функция СохранитьНастройки()
	
	Попытка
		Записать();
	Исключение
		Возврат Ложь;
	КонецПопытки;
	
	Возврат Истина
	
КонецФункции

&НаКлиенте
Процедура ВыполнитьСинхронизацию(Команда)
	
	Если НЕ ЗначениеЗаполнено(Токен) ИЛИ НЕ ЗначениеЗаполнено(Объект.Портал) Тогда	
		ПоказатьПредупреждение(, "Необходимо ввести ключ и адрес портала");
	ИначеЕсли Модифицированность ИЛИ НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
		ПоказатьВопрос(новый ОписаниеОповещения("ПослеВопросаОЗаписи", ЭтотОбъект), "Данные изменены или ещё не записаны, для продолжения, необходимо записать настройку, продолжить?", РежимДиалогаВопрос.ДаНет);
	Иначе
		ВыполнитьСинхронизациюПродолжение();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВопросаОЗаписи(Ответ, ДопПараметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Да Тогда
		Попытка
			Записать();
			ВыполнитьСинхронизациюПродолжение();
		Исключение
			ПоказатьПредупреждение(, "Не удалось записать настройки: " + ОписаниеОшибки());
		КонецПопытки;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьСинхронизациюПродолжение()
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("НастройкаСинхронизации", Объект.Ссылка);
	ПараметрыФормы.Вставить("ВидСинхронизации"		, 2);
	
	ОткрытьФорму("Справочник.НастройкиСинхронизацииСБитрикс24.Форма.ФормаВыполнениеСинхронизации", ПараметрыФормы,, Объект.Ссылка);
	
КонецПроцедуры	

&НаСервере
Процедура УстановкаБазовыхНастроекПоУмолчанию()
	
	Объект.ОбрезатьИсториюОбменов = Истина;
	Объект.ЧислоДнейХраненияИстории = 7;
	Объект.КоличествоДнейЗагрузки = 1;
	Объект.СпособСинхронизацииДанных = "Только ручной режим";
	
КонецПроцедуры	

&НаКлиенте
Процедура ОткрытьЛог(Команда)
	
	ОткрытьФорму("РегистрСведений.ЛогированиеОбменаСБитрикс24.ФормаСписка");
	
КонецПроцедуры

&НаКлиенте
Процедура ДетальнаяНастройкаСинхронизацииЛидов(Команда)
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("НастройкаСинхронизации", Объект.Ссылка);
	
	ОП = новый ОписаниеОповещения("ПослеДетальнаяНастройкаСинхронизацииЛидов", ЭтотОбъект);
	ОткрытьФорму("Справочник.НастройкиСинхронизацииСБитрикс24.Форма.ДетальнаяНастройкаСинхронизацииЛидов", ПараметрыФормы, ЭтаФорма, ,,, ОП, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеДетальнаяНастройкаСинхронизацииЛидов(ВозвращенноеЗначение, ДопПараметры) Экспорт
	
	Прочитать();
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьПользователейСПортала(Команда)
	
	Если НЕ СохранитьНастройки() Тогда
		Возврат;
	КонецЕсли;
	
	ЗагрузитьОбновитьПользователей();
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьОбновитьПользователей()

	СтруктураНастроек = ОбменСБитрикс24ВызовСервера.СформироватьСтруктуруНастроек(Объект.Ссылка);  
	
	Если СтруктураНастроек = Неопределено Тогда
		ПоказатьПредупреждение(, "Не удалось подключиться к Битрикс24");
		Возврат;
	КонецЕсли;
		
	СтруктураНастроек.Логирование.Измерение2 = "Получение списка пользователей Б24";
	                                   
	Метод = "/rest/user.get.json";
	
	Фильтр = "&ACTIVE=Y";
		
	СтруктураОтвета = ОбменСБитрикс24ВызовСервера.ОтправкаДанныхНаПортал(СтруктураНастроек, Метод, Фильтр); 
	
	Если СтруктураОтвета = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если СтруктураОтвета.Получить("result") <> неопределено Тогда
		
		Для каждого ТекЭлемент Из СтруктураОтвета.Получить("result") Цикл
			
			//Если ТекЭлемент.Получить("ACTIVE") <> Истина Тогда
			//	Продолжить;
			//КонецЕсли;
			
			НайденныеСтроки = Объект.СопоставлениеПользователей.НайтиСтроки(Новый Структура("ИдПользователя", ТекЭлемент.Получить("ID")));
			
			Если НайденныеСтроки.Количество() = 0 Тогда
				НоваяСтрока = Объект.СопоставлениеПользователей.Добавить();
				НоваяСтрока.ФИО = Строка(ТекЭлемент.Получить("NAME")) + " " + Строка(ТекЭлемент.Получить("LAST_NAME"));
				НоваяСтрока.ИдПользователя =  Формат(ТекЭлемент.Получить("ID"), "ЧГ=0");
			Иначе
				Для каждого ТекСотрудник Из НайденныеСтроки Цикл
					ТекСотрудник.ФИО = Строка(ТекЭлемент.Получить("NAME")) + " " + Строка(ТекЭлемент.Получить("LAST_NAME"));
				КонецЦикла;
			КонецЕсли;
			
		КонецЦикла;
	
	КонецЕсли;
	
	Следующие = СтруктураОтвета.Получить("next"); 
	
	Пока ЗначениеЗаполнено(Следующие) Цикл
		
		Следующие = Формат(Следующие, "ЧГ=0");

		ТелоHTTPЗапроса = "&start="+Следующие + Фильтр;	
		
		СтруктураОтвета = ОбменСБитрикс24ВызовСервера.ОтправкаДанныхНаПортал(СтруктураНастроек, Метод, ТелоHTTPЗапроса); 
		
		Если СтруктураОтвета = Неопределено Тогда
			Прервать;
		КонецЕсли;
		
		Если СтруктураОтвета.Получить("result") <> Неопределено Тогда
			
			Для каждого ТекЭлемент Из СтруктураОтвета.Получить("result") Цикл
				
				Если ТекЭлемент.Получить("ACTIVE") <> Истина Тогда
					Продолжить;
				КонецЕсли;
				
				НайденныеСтроки = Объект.СопоставлениеПользователей.НайтиСтроки(Новый Структура("ИдПользователя", ТекЭлемент.Получить("ID")));
				
				Если НайденныеСтроки.Количество() = 0 Тогда
					НоваяСтрока = Объект.СопоставлениеПользователей.Добавить();
					НоваяСтрока.ФИО = Строка(ТекЭлемент.Получить("NAME")) + " " + Строка(ТекЭлемент.Получить("LAST_NAME"));
					НоваяСтрока.ИдПользователя = Формат(ТекЭлемент.Получить("ID"), "ЧГ=0");
				Иначе
					Для каждого ТекСотрудник Из НайденныеСтроки Цикл
						ТекСотрудник.ФИО = Строка(ТекЭлемент.Получить("NAME")) + " " + Строка(ТекЭлемент.Получить("LAST_NAME"));
					КонецЦикла;
				КонецЕсли;
				
			КонецЦикла;
		КонецЕсли;
		
	   Следующие = СтруктураОтвета.Получить("next");
	   
	КонецЦикла;

	Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура СпособСинхронизацииДанныхПриИзменении(Элемент)
	
	Если НЕ СохранитьНастройки() Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось сохранить настройку");
		Возврат;
	КонецЕсли;
	
	ОбновитьОтображениеЭлементовФормы();

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьОтображениеЭлементовФормы()
	
	Элементы.ГруппаНастройкаОбменаПоРасписанию.Видимость = (Объект.СпособСинхронизацииДанных = "ПоРасписанию");
	
	//++ №14571
	Элементы.ДетальнаяНастройкаСинхронизацииЛидов.Доступность = (Объект.СинхронизацияСделок);
	Элементы.ДетальнаяНастройкаСинхронизацииКонтрагентов.Доступность = (Объект.СинхронизацияКонтрагентов);
	//-- №14571
	
КонецПроцедуры

&НаКлиенте
Процедура НастроитьРасписаниеОбмена(Команда)

	Если РасписаниеРегламентногоЗадания = НеОпределено Тогда
		РасписаниеРегламентногоЗадания = Новый РасписаниеРегламентногоЗадания;
	КонецЕсли;
	
	Диалог = Новый ДиалогРасписанияРегламентногоЗадания(РасписаниеРегламентногоЗадания);
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ЗавершитьИзменятьРасписание", ЭтотОбъект);
	
	Диалог.Показать(ОписаниеОповещения);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьИзменятьРасписание(РасписаниеЗадания, ДополнительныеПараметры) Экспорт
	
	Если РасписаниеЗадания = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	РасписаниеРегламентногоЗадания = РасписаниеЗадания;
	
	УстановитьНадписьРасписанияОбмена();
	Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьНадписьРасписанияОбмена()
	
	Если РасписаниеРегламентногоЗадания = НеОпределено Тогда
		ТекстЗаголовка = НСтр("ru='Настроить расписание обмена'");
	Иначе
		ТекстЗаголовка = РасписаниеРегламентногоЗадания;
	КонецЕсли;
	
	Элементы.НастроитьРасписаниеОбмена.Заголовок = ТекстЗаголовка;
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	Если Модифицированность Тогда
		
		УстановитьПривилегированныйРежим(Истина); //Для возможности всем пользователям с правами устанавливать расписания		
		Если ТекущийОбъект.СпособСинхронизацииДанных = "ПоРасписанию" Тогда

			ИмяИспользуемогоРеглЗадания = "Синхронизация с Битрикс24: ";
			
			ПараметрыЗапуска = Новый Массив();
			ПараметрыЗапуска.Добавить(Объект.Ссылка);

			Задание = РегламентныеЗаданияСервер.Задание(ТекущийОбъект.ИдентификаторРегламентногоЗадания);
			Если Задание <> Неопределено Тогда

				ПараметрыИзмененияЗадания = Новый Структура();
				ПараметрыИзмененияЗадания.Вставить("Использование", Истина);
				ПараметрыИзмененияЗадания.Вставить("Параметры", ПараметрыЗапуска);
				ПараметрыИзмененияЗадания.Вставить("Расписание", РасписаниеРегламентногоЗадания);
				ПараметрыИзмененияЗадания.Вставить("ИнтервалПовтораПриАварийномЗавершении", 0);
				ПараметрыИзмененияЗадания.Вставить("КоличествоПовторовПриАварийномЗавершении", 0);

				РегламентныеЗаданияСервер.ИзменитьЗадание(ТекущийОбъект.ИдентификаторРегламентногоЗадания, ПараметрыИзмененияЗадания);

			Иначе

				ПараметрыЗадания = Новый Структура();
				ПараметрыЗадания.Вставить("Метаданные", Метаданные.РегламентныеЗадания.ОбменСБитрикс24);
				ПараметрыЗадания.Вставить("Наименование", ИмяИспользуемогоРеглЗадания
					+ ТекущийОбъект.Наименование);
				ПараметрыЗадания.Вставить("Ключ", ИмяИспользуемогоРеглЗадания
					+ ТекущийОбъект.Наименование);
				ПараметрыЗадания.Вставить("Использование", Истина);
				ПараметрыЗадания.Вставить("ЭксклюзивноеВыполнение", Ложь);
				ПараметрыЗадания.Вставить("Параметры", ПараметрыЗапуска);
				ПараметрыЗадания.Вставить("ИнтервалПовтораПриАварийномЗавершении", 0);
				ПараметрыЗадания.Вставить("КоличествоПовторовПриАварийномЗавершении", 0);
				ПараметрыЗадания.Вставить("Расписание", РасписаниеРегламентногоЗадания);

				Задание = РегламентныеЗаданияСервер.ДобавитьЗадание(ПараметрыЗадания);
				ТекущийОбъект.ИдентификаторРегламентногоЗадания = Задание.УникальныйИдентификатор;
				
			КонецЕсли;

			Если Задание = Неопределено Тогда
				ИдентификаторРегламентногоЗадания = Неопределено;
			КонецЕсли;

		Иначе
			РегламентныеЗаданияСервер.УдалитьЗадание(ТекущийОбъект.ИдентификаторРегламентногоЗадания);
			ТекущийОбъект.ИдентификаторРегламентногоЗадания = Неопределено;
		КонецЕсли;		
	
		УстановитьПривилегированныйРежим(Ложь);	
		
		Модифицированность = Ложь;

	КонецЕсли;
	
КонецПроцедуры

