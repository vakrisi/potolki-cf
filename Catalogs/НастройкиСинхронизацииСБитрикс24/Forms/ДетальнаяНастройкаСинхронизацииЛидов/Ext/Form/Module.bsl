#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗагрузитьСтатусыСПортала(Команда)
	
	ОбщиеНастройки =  ОбменСБитрикс24ВызовСервера.СформироватьСтруктуруНастроек(НастройкаСинхронизации);
	
	Если ОбщиеНастройки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	                                                                                             
	ОбщиеНастройки.Логирование.Измерение2 = "Получение списка статусов лидов.";
	
	//++ №9040 статусы делим по направлениям (воронкам)
	Направления.Очистить();
	
	СтруктураОтвета = ОбменСБитрикс24ВызовСервера.ОтправкаДанныхНаПортал(ОбщиеНастройки, "/rest/crm.dealcategory.list", "");
	Если СтруктураОтвета <> Неопределено Тогда
		
		Если СтруктураОтвета.Получить("result") <> Неопределено Тогда
			
			Для каждого ТекЭлемент Из СтруктураОтвета.Получить("result") Цикл
				
				НовоеНаправление = Направления.Добавить();
				НовоеНаправление.ID = Формат(ТекЭлемент.Получить("ID"), "ЧГ=0");
				НовоеНаправление.NAME = ТекЭлемент.Получить("NAME");
				НовоеНаправление.STAGE = "DEAL_STAGE_" + НовоеНаправление.ID;
				
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЕсли;
	//-- №9040
	
	СтруктураОтвета = ОбменСБитрикс24ВызовСервера.ОтправкаДанныхНаПортал(ОбщиеНастройки, "/rest/crm.status.list", "");
	
	Если СтруктураОтвета <> Неопределено Тогда
		
		Если СтруктураОтвета.Получить("result") <> Неопределено Тогда
			
			// №9655 статусы, которые будут удалены если их не было при запросе
			МассивУдаляемыхСтатусов = новый Массив;
			Для Каждого ТекущаяСтрока Из СтатусыСписок Цикл
				МассивУдаляемыхСтатусов.Добавить(ТекущаяСтрока.ИдСтатуса);
			КонецЦикла;
			
			Для каждого ТекЭлемент Из СтруктураОтвета.Получить("result") Цикл
				
				//++ №9040 теперь загружаем только те статусы, у которых в ENTITY_ID есть DEAL_STAGE
				//Если ТекЭлемент.Получить("ENTITY_ID") = "INVOICE_STATUS" Тогда
				//	Продолжить;
				//КонецЕсли;
				Если СтрНайти(НРег(ТекЭлемент.Получить("ENTITY_ID")), "deal_stage") = 0 Тогда
					Продолжить;
				КонецЕсли;
				
				Направление_ID = "";
				Направление_NAME = "";
				НайденноеНаправление = Направления.НайтиСтроки(новый Структура("STAGE", ТекЭлемент.Получить("ENTITY_ID")));
				Если НайденноеНаправление.Количество() > 0 Тогда
					Направление_ID = НайденноеНаправление[0].ID;
					Направление_NAME = НайденноеНаправление[0].NAME;
				КонецЕсли;
				//-- №9040
				                       
				ИдСтатуса 			= Формат(ТекЭлемент.Получить("STATUS_ID"), "ЧГ=0");
				НаименованиеСтатуса = ТекЭлемент.Получить("NAME"); 
				
				//++ №9040 поиск статуса теперь делаем с направлением
				//НайденныеСтроки = СтатусыСписок.НайтиСтроки(Новый Структура("ИдСтатуса", ИдСтатуса));
				НайденныеСтроки = СтатусыСписок.НайтиСтроки(Новый Структура("ИдСтатуса, Направление_ID", ИдСтатуса, Направление_ID));
				//-- №9040
				
				Если НайденныеСтроки.Количество() = 0 Тогда
					НоваяСтрока = СтатусыСписок.Добавить();
					НоваяСтрока.НазваниеСтатуса 	= НаименованиеСтатуса;
					НоваяСтрока.ИдСтатуса 			= ИдСтатуса;
					//++ №9040
					НоваяСтрока.Направление_ID		= Направление_ID;
					НоваяСтрока.Направление_NAME	= Направление_NAME;
					//-- №9040
				Иначе
					
					Для Каждого ТекСтрокаТаблицы Из СтатусыСписок Цикл
						//++ №9040
						//Если ТекСтрокаТаблицы.ИдСтатуса = ИдСтатуса Тогда
						Если ТекСтрокаТаблицы.ИдСтатуса = ИдСтатуса И ТекСтрокаТаблицы.Направление_ID = Направление_ID Тогда
						//-- №9040
							ТекСтрокаТаблицы.НазваниеСтатуса 	= НаименованиеСтатуса; 
							ТекСтрокаТаблицы.Направление_NAME 	= Направление_NAME; // №9040
							Прервать;
						КонецЕсли;
					КонецЦикла;
					
				КонецЕсли;
				
				//++ №9655
				// Уберем пришедший статус из массива к удалению (если он там есть)
				Если НЕ МассивУдаляемыхСтатусов.Найти(ИдСтатуса) = Неопределено Тогда
					МассивУдаляемыхСтатусов.Удалить(МассивУдаляемыхСтатусов.Найти(ИдСтатуса));
				КонецЕсли;
				//-- №9655
				
			КонецЦикла;
			
			//++ №9655
			// Удаляем из списка статусы, которых теперь нет
			КоличествоЭлементов = СтатусыСписок.Количество()-1;
			Для Сч = 0 По КоличествоЭлементов Цикл
				Если НЕ МассивУдаляемыхСтатусов.Найти(СтатусыСписок[КоличествоЭлементов-Сч].ИдСтатуса) = Неопределено Тогда
					СтатусыСписок.Удалить(КоличествоЭлементов-Сч);
				КонецЕсли;
			КонецЦикла;
			//-- №9655
			
		КонецЕсли;	
	КонецЕсли;
	
	ПостроитьДеревоСтатусов(); // №9040
	
КонецПроцедуры

&НаКлиенте
Процедура Применить(Команда)
	
	Если Не ПроверитьЗаполнениеСтатусов1С() Тогда
		Сообщить("В соответствии статусов установлена галочка загружать, но не указан статус в 1С, действие отменено.");
		Возврат;
	КонецЕсли;
	
	СохранениеНастроек();
	Закрыть();
	
КонецПроцедуры

#КонецОбласти

&НаКлиенте
Функция ПроверитьЗаполнениеСтатусов1С()
	
	Для Каждого Родитель Из СтатусыДерево.ПолучитьЭлементы() Цикл
		Для Каждого ТекущаяСтрока Из Родитель.ПолучитьЭлементы() Цикл
			
			Если ТекущаяСтрока.Загружать И Не ЗначениеЗаполнено(ТекущаяСтрока.Статус) Тогда
				Возврат Ложь;
			КонецЕсли;
			
		КонецЦикла;
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьТаблицуПолей()
	
	//++ №9655 по старому
	//// Определяем состав полей
	//ДобавитьПолеВТаблицу("Вид контакта", Неопределено, "", Справочники.ВидыКонтактов.ПустаяСсылка());
	//ДобавитьПолеВТаблицу("Рекламная акция", Неопределено, "", Справочники.РекламнаяАкция.ПустаяСсылка());
	//ДобавитьПолеВТаблицу("Рекламный источник", Неопределено, "", Справочники.РекламныеИсточники.ПустаяСсылка());
	//ДобавитьПолеВТаблицу("Точка продаж", Неопределено, "", Справочники.ТочкиПродаж.ПустаяСсылка());
	////ДобавитьПолеВТаблицу("Исполнитель замера", Неопределено, "", Справочники.Сотрудники.ПустаяСсылка());
	//-- №9655 
	
	//++ №9655 по новому
	МассивПолей = ОбщийМодульСервер.ПолучитьМассивВозможныхОбязательныхПолейКЗаполнениюЛида();
	ЛидСсылка = Документы.Лид.ПустаяСсылка();
	МетаданныеЛида = Метаданные.Документы.Лид;
	
	Для Каждого ТекущаяСтрока Из МассивПолей Цикл
		
		ПустоеЗначение = "";
		Если СтрНайти(ТекущаяСтрока.ИмяПоля, "КонтактнаяИнформация.") = 0 Тогда
			// проверка наличия реквизита
			Если ОбщегоНазначения.ЕстьРеквизитОбъекта(ТекущаяСтрока.ИмяПоля, МетаданныеЛида) Тогда			
				ПустоеЗначение = ЛидСсылка[ТекущаяСтрока.ИмяПоля];
			Иначе
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		
		ДобавитьПолеВТаблицу(ТекущаяСтрока.ИмяПоля, ТекущаяСтрока.Синоним, Неопределено, "", ПустоеЗначение);
		
	КонецЦикла;
	//-- №9655
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьПолеВТаблицу(ИмяПоля, Имя, Режим, Значение, ПустоеЗначение)
	
	Если Режим = Неопределено Тогда
		Режим = "Не заполнять";
	КонецЕсли;	
	
	НоваяСтрока = ТаблицаПолей.Добавить();
	НоваяСтрока.ИмяПоля = ИмяПоля;
	НоваяСтрока.Имя = Имя;
	НоваяСтрока.Режим = Режим;
	НоваяСтрока.Значение = Значение;
	НоваяСтрока.ПустоеЗначение = ПустоеЗначение;
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаПолейРежимПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ТаблицаПолей.ТекущиеДанные;
	
	// Приведем к типу
	Если ТекущиеДанные.Режим = "Не заполнять" Или ТекущиеДанные.Режим = "Пользовательское поле" Или ТекущиеДанные.Режим = "Автоматически" Тогда
		ТекущиеДанные.Значение = ""; // Строка
	Иначе
		ТекущиеДанные.Значение = ТекущиеДанные.ПустоеЗначение; // Конкретный тип
	КонецЕсли;
	
КонецПроцедуры

