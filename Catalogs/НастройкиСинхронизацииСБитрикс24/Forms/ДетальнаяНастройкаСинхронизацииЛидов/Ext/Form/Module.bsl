&НаКлиенте
Процедура ПостроитьДеревоСтатусов()
	
	СтатусыДерево.ПолучитьЭлементы().Очистить();
	
	РодителиДерева = ПолучитьМассивРодителейДерева();
	
	Для Каждого Родитель Из РодителиДерева Цикл
		
		НовыйРодитель = СтатусыДерево.ПолучитьЭлементы().Добавить();
		НовыйРодитель.Направление_ID = Родитель.Направление_ID;
		НовыйРодитель.Направление_NAME = Родитель.Направление_NAME;
		
		Загружать = Истина;
		НайденныеСтроки = СтатусыСписок.НайтиСтроки(новый Структура("Направление_ID", Родитель.Направление_ID));
		Для Каждого ТекущаяСтрока Из НайденныеСтроки Цикл
			
			НовыйЭлемент = НовыйРодитель.ПолучитьЭлементы().Добавить();
			ЗаполнитьЗначенияСвойств(НовыйЭлемент, ТекущаяСтрока);
			Если НЕ НовыйЭлемент.Загружать Тогда
				Загружать = Ложь;
			КонецЕсли;
			
		КонецЦикла;
		
		НовыйРодитель.Загружать = Загружать;
		
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьМассивРодителейДерева()
	
	РодителиДерева = СтатусыСписок.Выгрузить(, "Направление_ID, Направление_NAME");
	РодителиДерева.Свернуть("Направление_ID, Направление_NAME");
	
	Возврат ОбщегоНазначения.ТаблицаЗначенийВМассив(РодителиДерева);
	
КонецФункции

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ПостроитьДеревоСтатусов();
	
КонецПроцедуры

&НаКлиенте
Процедура СтатусыДеревоЗагружатьПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.СтатусыДерево.ТекущиеДанные;
	
	// Поменяли в корне, нужно все подчиненные изменить
	Если ТекущиеДанные.ПолучитьРодителя() = Неопределено Тогда
		
		Для Каждого Родитель Из СтатусыДерево.ПолучитьЭлементы() Цикл
			Если Родитель.Направление_NAME = ТекущиеДанные.Направление_NAME Тогда
				Для Каждого ТекущаяСтрока Из Родитель.ПолучитьЭлементы() Цикл
					ТекущаяСтрока.Загружать = ТекущиеДанные.Загружать;
				КонецЦикла;
			КонецЕсли;
		КонецЦикла;
		
	Иначе
		
		// Поменяли подчиненный корню элемент, если у всех подчиненных элементов один признак, установим его корню
		ПризнакиРавны = Истина;
	    Для Каждого ПодчиненныйЭлемент Из ТекущиеДанные.ПолучитьРодителя().ПолучитьЭлементы() Цикл
			Если НЕ ПодчиненныйЭлемент.Загружать = ТекущиеДанные.Загружать Тогда
				ПризнакиРавны = Ложь;
			КонецЕсли;
		КонецЦикла;
		
		Если ПризнакиРавны Тогда
			ТекущиеДанные.ПолучитьРодителя().Загружать = ТекущиеДанные.Загружать;
		Иначе
			ТекущиеДанные.ПолучитьРодителя().Загружать = Ложь;
		КонецЕсли;
	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьСтатусы(Команда)
	
	Если СтатусыСписок.Количество() > 0 Тогда
		ПоказатьВопрос(новый ОписаниеОповещения("ПослеВопросаОбОчисткеСтатусов", ЭтотОбъект), "Вы действительно хотите очистить таблицу статусов?", РежимДиалогаВопрос.ДаНетОтмена);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВопросаОбОчисткеСтатусов(Ответ, ДопПараметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Да Тогда
		
		ОчиститьСтатусыПродолжение();
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьСтатусыПродолжение()
	
	СтатусыСписок.Очистить();
	СтатусыДерево.ПолучитьЭлементы().Очистить();
	
КонецПроцедуры
