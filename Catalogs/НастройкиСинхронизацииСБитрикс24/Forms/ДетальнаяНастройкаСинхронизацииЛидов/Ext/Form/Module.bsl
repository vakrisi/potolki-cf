

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если НЕ Параметры.Свойство("НастройкаСинхронизации") Тогда
		Возврат;	
	КонецЕсли;
	
	НастройкаСинхронизации = Параметры.НастройкаСинхронизации;	
	
	// Заполнение таблицы полей
	ЗаполнитьТаблицуПолей();
	
	ХранилищеНастроек = НастройкаСинхронизации.ХранилищеНастроек.Получить();
	Если НЕ ТипЗнч(ХранилищеНастроек) = Тип("Структура") Тогда
		
		// Заполним стандартными полями
		ЗаполнитьСтандартнымиПараметрами();
		
	Иначе	
		
		Если ХранилищеНастроек.Свойство("НастройкиСинхронизацииЛидов") Тогда
			
			НастройкиСинхронизацииЛидов = ХранилищеНастроек.НастройкиСинхронизацииЛидов;
			
			Если НастройкиСинхронизацииЛидов.Свойство("ИнформацияОСтатусах") Тогда
				
				Если НастройкиСинхронизацииЛидов.ИнформацияОСтатусах.Свойство("СтатусыСписок") Тогда
					СтатусыСписок.Загрузить(НастройкиСинхронизацииЛидов.ИнформацияОСтатусах.СтатусыСписок);
				КонецЕсли;
				
				//++ №9655 комментируем ЗапрещенныеСтатусыЛида.Загрузить(НастройкиСинхронизацииЛидов.ИнформацияОСтатусах.ЗапрещенныеСтатусыЛида);
				
			КонецЕсли;
			
			//++ №9655 комментируем, т.к. меняем на таблицу
			//Если НастройкиСинхронизацииЛидов.Свойство("ИнформацияОПолях") Тогда
			//	
			//	ПолеДатаЗамера  = "";
			//	ПолеАдресЗамера	= "";
			//	
			//	НастройкиСинхронизацииЛидов.ИнформацияОПолях.Свойство("ПолеДатаЗамера", ПолеДатаЗамера);
			//	НастройкиСинхронизацииЛидов.ИнформацияОПолях.Свойство("ПолеАдресЗамера", ПолеАдресЗамера);
			//	
			//КонецЕсли;
			//-- №9655
			
			//++ №9655 таблица полей замера
			Если НастройкиСинхронизацииЛидов.Свойство("ТаблицаПолейЗамера") Тогда
				
				ТаблицаПолейЗамера.Загрузить(НастройкиСинхронизацииЛидов.ТаблицаПолейЗамера);
				
			КонецЕсли;
			//-- №9655
			
			Если НастройкиСинхронизацииЛидов.Свойство("ТаблицаПолей") Тогда
				
				Для Каждого ПолеНастройки Из НастройкиСинхронизацииЛидов.ТаблицаПолей Цикл
					
					НайденноеПоле = ТаблицаПолей.НайтиСтроки(Новый Структура("Имя", ПолеНастройки.Имя));
					Если НайденноеПоле.Количество() > 0 Тогда
						НайденноеПоле[0].Режим = ПолеНастройки.Режим;
						НайденноеПоле[0].Значение = ПолеНастройки.Значение;
						
					//#17179 
					ИначеЕсли ПолеНастройки.Имя = "ОсновнойТелефонКлиента" Тогда
						НайденноеПоле = ТаблицаПолей.НайтиСтроки(Новый Структура("Имя", "КонтактнаяИнформация.Телефон"));
						Если НайденноеПоле.Количество() > 0 Тогда
							НайденноеПоле[0].Режим = ПолеНастройки.Режим;
							НайденноеПоле[0].Значение = ПолеНастройки.Значение;
						КонецЕсли;
					ИначеЕсли ПолеНастройки.Имя = "ЭлектроннаяПочтаКлиента" Тогда
						НайденноеПоле = ТаблицаПолей.НайтиСтроки(Новый Структура("Имя", "КонтактнаяИнформация.ЭлектроннаяПочта"));
						Если НайденноеПоле.Количество() > 0 Тогда
							НайденноеПоле[0].Режим = ПолеНастройки.Режим;
							НайденноеПоле[0].Значение = ПолеНастройки.Значение;
						КонецЕсли;
						
					КонецЕсли;
					
				КонецЦикла;
				
			КонецЕсли;
			
			Если НастройкиСинхронизацииЛидов.Свойство("ДатаНачалаЗагрузкиЛидов") Тогда
				
				ДатаНачалаЗагрузкиЛидов = НастройкиСинхронизацииЛидов.ДатаНачалаЗагрузкиЛидов;
				
			КонецЕсли;
			
			НастройкиСинхронизацииЛидов.Свойство("ИсточникДатыДокумента", ИсточникДатыДокумента);
			
			//++ №9700
			Если НастройкиСинхронизацииЛидов.Свойство("ВыгружатьИнформациюПоЛидам") Тогда
				
				ВыгружатьИнформациюПоЛидам = НастройкиСинхронизацииЛидов.ВыгружатьИнформациюПоЛидам;
				
			КонецЕсли;
			
			Если НастройкиСинхронизацииЛидов.Свойство("ДатаНачалаВыгрузкиИнформацииПоЛидам") Тогда
				
				ДатаНачалаВыгрузкиИнформацииПоЛидам = НастройкиСинхронизацииЛидов.ДатаНачалаВыгрузкиИнформацииПоЛидам;
				
			КонецЕсли;
			//-- №9700
			
		КонецЕсли;
		
	КонецЕсли;
	
	ОбновитьВидимостьЭлементов(); // №9700
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
		
	Если Модифицированность И НЕ НужноЗакрытьОкно Тогда
		Отказ = Истина; 
		
		Если ЗавершениеРаботы Тогда 
			ТекстПредупреждения = "Настройки не будут сохранены. Закрыть?"; 
		Иначе
			Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопросаОЗакрытииОкна", ЭтаФорма, Параметры);
			ПоказатьВопрос(Оповещение, "Настройки были изменены. Сохранить изменения перед закрытием?", РежимДиалогаВопрос.ДаНетОтмена, 0);
		КонецЕсли;
	КонецЕсли;
	

КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияВопросаОЗакрытииОкна(Результат, Параметры) Экспорт
	Если Результат = КодВозвратаДиалога.Да Тогда
		НужноЗакрытьОкно = Истина;
		СохранениеНастроек();
        Закрыть();
	ИначеЕсли Результат = КодВозвратаДиалога.Нет Тогда
		НужноЗакрытьОкно = Истина;
		Закрыть();
    КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура СохранениеНастроек()

	НастройкиОбмена = НастройкаСинхронизации.ХранилищеНастроек.Получить();
	
	Если НЕ ТипЗнч(НастройкиОбмена) = Тип("Структура") Тогда
		НастройкиОбмена = новый Структура;
	КонецЕсли;
		
	Если НЕ НастройкиОбмена.Свойство("НастройкиСинхронизацииЛидов") Тогда
		СтруктураНастроек = Новый Структура;	
	Иначе
		СтруктураНастроек = НастройкиОбмена.НастройкиСинхронизацииЛидов;	
	КонецЕсли;
	
	//++ №9040 перенесем статусы из дерева в список
	СтатусыСписок.Очистить();
	Дерево = ДанныеФормыВЗначение(СтатусыДерево, Тип("ДеревоЗначений"));
	Для Каждого Родитель Из Дерево.Строки Цикл
		Для Каждого Строка Из Родитель.Строки Цикл
			НоваяСтрока = СтатусыСписок.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
		КонецЦикла;
	КонецЦикла;
	//-- №9040
	
	СтруктураИнформацииОСтатусах = Новый Структура;
	//++ №9655 комментируем СтруктураИнформацииОСтатусах.Вставить("ЗапрещенныеСтатусыЛида"		, ЗапрещенныеСтатусыЛида.Выгрузить());
	СтруктураИнформацииОСтатусах.Вставить("СтатусыСписок"				, СтатусыСписок.Выгрузить());
	
	//++ №9655 комментируем, т.к. теперь таблица
	//СтруктураИнформацииОПолях = новый Структура;
	//СтруктураИнформацииОПолях.Вставить("ПолеДатаЗамера", ПолеДатаЗамера);
	//СтруктураИнформацииОПолях.Вставить("ПолеАдресЗамера", ПолеАдресЗамера);
	//-- №9655
	
	Справочники.НастройкиСинхронизацииСБитрикс24.ДобавитьНастройкуВСтруктуру(СтруктураНастроек, "ИнформацияОСтатусах"	  , СтруктураИнформацииОСтатусах);
	// №9655 Справочники.НастройкиСинхронизацииСБитрикс24.ДобавитьНастройкуВСтруктуру(СтруктураНастроек, "ИнформацияОПолях"		  , СтруктураИнформацииОПолях);
	Справочники.НастройкиСинхронизацииСБитрикс24.ДобавитьНастройкуВСтруктуру(СтруктураНастроек, "ДатаНачалаЗагрузкиЛидов" , ДатаНачалаЗагрузкиЛидов);
	Справочники.НастройкиСинхронизацииСБитрикс24.ДобавитьНастройкуВСтруктуру(СтруктураНастроек, "ТаблицаПолей"			  , ТаблицаПолей.Выгрузить());
	Справочники.НастройкиСинхронизацииСБитрикс24.ДобавитьНастройкуВСтруктуру(СтруктураНастроек, "ТаблицаПолейЗамера"	  , ТаблицаПолейЗамера.Выгрузить()); // №9655
	Справочники.НастройкиСинхронизацииСБитрикс24.ДобавитьНастройкуВСтруктуру(СтруктураНастроек, "ИсточникДатыДокумента"	  , ИсточникДатыДокумента);
	
	//++ №9700
	Справочники.НастройкиСинхронизацииСБитрикс24.ДобавитьНастройкуВСтруктуру(СтруктураНастроек, "ВыгружатьИнформациюПоЛидам", ВыгружатьИнформациюПоЛидам);
	Справочники.НастройкиСинхронизацииСБитрикс24.ДобавитьНастройкуВСтруктуру(СтруктураНастроек, "ДатаНачалаВыгрузкиИнформацииПоЛидам", ДатаНачалаВыгрузкиИнформацииПоЛидам);
	//-- №9700
		
	Если НЕ НастройкиОбмена.Свойство("НастройкиСинхронизацииЛидов") Тогда
		НастройкиОбмена.Вставить("НастройкиСинхронизацииЛидов", СтруктураНастроек); 	
	Иначе
		НастройкиОбмена.НастройкиСинхронизацииЛидов = СтруктураНастроек;
	КонецЕсли;
	
	ТекущаяНастройкаСинхронизации = НастройкаСинхронизации.ПолучитьОбъект();
	ТекущаяНастройкаСинхронизации.СинхронизацияСделок = Истина;
	ТекущаяНастройкаСинхронизации.ХранилищеНастроек = Новый ХранилищеЗначения(НастройкиОбмена);
	ТекущаяНастройкаСинхронизации.Записать();	
	
	ОбновитьПовторноИспользуемыеЗначения();	
	
	Модифицированность = Ложь;
	
КонецПроцедуры

