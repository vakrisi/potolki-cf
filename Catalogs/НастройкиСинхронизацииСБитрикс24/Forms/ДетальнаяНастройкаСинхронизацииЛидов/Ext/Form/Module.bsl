&НаКлиенте
Процедура УстановитьВсеСтатусыЗагружать(Команда)
	
	Для Каждого Родитель Из СтатусыДерево.ПолучитьЭлементы() Цикл
		Родитель.Загружать = Истина;
		Для Каждого ТекущаяСтрока Из Родитель.ПолучитьЭлементы() Цикл
			ТекущаяСтрока.Загружать = Истина;
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура СнятьВсеСтатусыЗагружать(Команда)
	
	Для Каждого Родитель Из СтатусыДерево.ПолучитьЭлементы() Цикл
		Родитель.Загружать = Ложь;
		Для Каждого ТекущаяСтрока Из Родитель.ПолучитьЭлементы() Цикл
			ТекущаяСтрока.Загружать = Ложь;
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаПолейПриАктивизацииСтроки(Элемент)
	
	// №12128 режим "Автоматически" доступен для некоторых полей
	ТекущиеДанные = Элементы.ТаблицаПолей.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
		
	МассивПолей = новый Массив;
	МассивПолей.Добавить("ИмяКлиента");
	МассивПолей.Добавить("КонтактнаяИнформация.Телефон");
	МассивПолей.Добавить("КонтактнаяИнформация.ЭлектроннаяПочта");
	МассивПолей.Добавить("Комментарий");
	
	ДанныеВыбора = новый Массив;
	
	Если НЕ МассивПолей.Найти(ТекущиеДанные.ИмяПоля) = Неопределено Тогда
		ДанныеВыбора.Добавить("Автоматически");
	КонецЕсли;
	
	ДанныеВыбора.Добавить("Не заполнять");
	ДанныеВыбора.Добавить("Пользовательское поле");
	ДанныеВыбора.Добавить("Указывать");
	
	Элементы.ТаблицаПолейРежим.СписокВыбора.ЗагрузитьЗначения(ДанныеВыбора);
	
КонецПроцедуры

