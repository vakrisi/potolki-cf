	КонецЕсли;
	
	
	ПользовательДляКопирования = ПредопределенноеЗначение("Справочник.Пользователи.ПустаяСсылка");
	
	ПослеВыбораПользователяДляКопирования = Новый ОписаниеОповещения("ПослеВыбораПользователяДляКопирования",ЭтаФорма);
	ПоказатьВводЗначения(ПослеВыбораПользователяДляКопирования,ПользовательДляКопирования,"Выберите пользователя для копирования");
	
