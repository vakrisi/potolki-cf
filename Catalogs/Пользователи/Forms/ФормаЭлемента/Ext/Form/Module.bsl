// №9422 ограничения постоянно добавляются, поэтому реализуем универсальное копирование
&НаСервере
Процедура СкопироватьОграничения(мЭлемент, ПользовательОснование)
	
	Для Каждого ПодчиненныйЭлемент Из мЭлемент.ПодчиненныеЭлементы Цикл
		
		Если ТипЗнч(ПодчиненныйЭлемент) = Тип("ГруппаФормы") И ПодчиненныйЭлемент.ПодчиненныеЭлементы.Количество() > 0 Тогда
			
			СкопироватьОграничения(ПодчиненныйЭлемент, ПользовательОснование);
			
		ИначеЕсли ТипЗнч(ПодчиненныйЭлемент) = Тип("ПолеФормы") И ЗначениеЗаполнено(ПодчиненныйЭлемент.ПутьКДанным) И Лев(ПодчиненныйЭлемент.ПутьКДанным, 7) = "Объект." Тогда
			
			ИмяРеквизита = Прав(ПодчиненныйЭлемент.ПутьКДанным, СтрДлина(ПодчиненныйЭлемент.ПутьКДанным)-7);
			Объект[ИмяРеквизита] = ПользовательОснование[ИмяРеквизита];
			
		ИначеЕсли ТипЗнч(ПодчиненныйЭлемент) = Тип("ТаблицаФормы") И ЗначениеЗаполнено(ПодчиненныйЭлемент.ПутьКДанным) И Лев(ПодчиненныйЭлемент.ПутьКДанным, 7) = "Объект." Тогда
			
			ИмяРеквизита = Прав(ПодчиненныйЭлемент.ПутьКДанным, СтрДлина(ПодчиненныйЭлемент.ПутьКДанным)-7);
			Объект[ИмяРеквизита].Загрузить(ПользовательОснование[ИмяРеквизита].Выгрузить());
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриВходящемЗвонкеСоздаватьЛидПриИзменении(Элемент)
	ПриВходящемЗвонкеОткрыватьКарточкуКонтрагента = НЕ ПриВходящемЗвонкеСоздаватьЛид;
	ОбновитьВидимостьЭлементов();
КонецПроцедуры

&НаКлиенте
