&НаКлиенте
Процедура СнятьОтметкуРолиИнтерактивноеОткрытиеВнешнихОтчетовИОбработок()
	
	Для каждого СтрокаПодсистемы из Роли.ПолучитьЭлементы() Цикл
		Если СтрокаПодсистемы.Имя = "ДополнительныеПрава" Тогда
			Для каждого СтрокаРоли из СтрокаПодсистемы.ПолучитьЭлементы() Цикл
				Если СтрокаРоли.Имя = "ИнтерактивноеОткрытиеВнешнихОтчетовИОбработок" Тогда
					СтрокаРоли.Пометка = Ложь;
					СтрокаПодсистемы.Пометка = Ложь;
					
					НайденныеРоли = ПользовательИБРоли.НайтиСтроки(Новый Структура("Роль", "ИнтерактивноеОткрытиеВнешнихОтчетовИОбработок"));
					Если НайденныеРоли.Количество() > 0 Тогда
						ПользовательИБРоли.Удалить(НайденныеРоли[0]);
					КонецЕсли;
					
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

