&НаКлиенте
Процедура УдалитьФайлыВКаталоге(Путь)
	
	Попытка
		Если НЕ ПустаяСтрока(Путь) Тогда
			МассивНайденныхФайлов = НайтиФайлы(Путь,"*", Ложь);
			Для Каждого Файл Из МассивНайденныхФайлов Цикл
				Если НЕ Файл.ЭтоКаталог() Тогда
					УдалитьФайлы(Путь,Файл.Имя);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		ПоказатьПредупреждение(,"Все файлы в папке " + Путь + " удалены");
	Исключение
		ПоказатьПредупреждение(,"Ошибка удаления файлов: " + ОписаниеОшибки());
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияВопросаОбУдаленииФайловВКаталоге(Результат, Параметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
        УдалитьФайлыВКаталоге(Параметры.Путь);
    КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ЗапроситьПодтверждениеУдаленияФайловВКаталоге(Путь)
	
	Парам = Новый Структура;
	Парам.Вставить("Путь", Путь);
	
	Режим = РежимДиалогаВопрос.ДаНет;
	Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопросаОбУдаленииФайловВКаталоге", ЭтаФорма, Парам);
	ПоказатьВопрос(Оповещение, "Удалить все файлы в папке " 
	+ Символы.ПС
	+ Символы.ПС
	+ Путь + " ?"
	+ Символы.ПС
	+ Символы.ПС + "ВНИМАНИЕ! Файлы будут удалены безвозвратно!", Режим, 0);
	
КонецПроцедуры

