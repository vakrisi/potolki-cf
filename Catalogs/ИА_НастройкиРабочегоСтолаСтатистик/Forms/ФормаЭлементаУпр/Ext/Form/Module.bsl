
&НаКлиенте
Процедура СтатистикиВидСтатистикиПриИзменении(Элемент)
	
	ДанныеСтроки = Элементы.Статистики.ТекущиеДанные;
	ДанныеСтроки.Аналитика1 = Неопределено;
	ДанныеСтроки.Аналитика2 = Неопределено;
	ДанныеСтроки.Аналитика3 = Неопределено;
	
	структДанных = Новый Структура("ВидСтатистики,Аналитика1,Аналитика2,Аналитика3,ЕстьАналитика1,ЕстьАналитика2,ЕстьАналитика3");
	ЗаполнитьЗначенияСвойств(структДанных,ДанныеСтроки);
	СтатистикиВидСтатистикиПриИзменении_Сервер(структДанных);
	ЗаполнитьЗначенияСвойств(ДанныеСтроки,структДанных);
	
	ЗаполнитьНаименованиеДляЛегенды(ДанныеСтроки);
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура СтатистикиВидСтатистикиПриИзменении_Сервер(структДанных)
	структДанных.ЕстьАналитика1 = Ложь;
	структДанных.ЕстьАналитика2 = Ложь;
	структДанных.ЕстьАналитика3 = Ложь;
	
	Если не структДанных.ВидСтатистики.Пустая() Тогда
 		Если не структДанных.ВидСтатистики.Аналитика1.Пустая() Тогда
			УстановитьТип1(структДанных.ВидСтатистики.Аналитика1.ТипАналитикиПолный,структДанных.Аналитика1);	
			структДанных.ЕстьАналитика1 = истина;
		Конецесли;
		
		Если не структДанных.ВидСтатистики.Аналитика2.Пустая() Тогда
			УстановитьТип1(структДанных.ВидСтатистики.Аналитика2.ТипАналитикиПолный,структДанных.Аналитика2);
			структДанных.ЕстьАналитика2 = истина;
		Конецесли;
		
		Если не структДанных.ВидСтатистики.Аналитика3.Пустая() Тогда
			УстановитьТип1(структДанных.ВидСтатистики.Аналитика3.ТипАналитикиПолный,структДанных.Аналитика3);
			структДанных.ЕстьАналитика3 = истина;
		Конецесли;
	КонецЕсли;
КонецПроцедуры

&НаСервереБезКонтекста
Процедура УстановитьТип1(ЗначТип, ЗначСтр)	
	ЗначТип1 = ЗначТип;
	ЗначТип1 = СтрЗаменить(ЗначТип1, "СправочникСсылка", "Справочник");
	ЗначТип1 = СтрЗаменить(ЗначТип1, "ДокументСсылка", "Документ");
	ЗначТип1 = СтрЗаменить(ЗначТип1, "ПеречислениеСсылка", "Перечисление");
	ЗначТип1 = СтрЗаменить(ЗначТип1, "ЗадачаСсылка", "Задача");
	
	Если ЗначТип1 = "" Тогда 		
		ЗначСтр = ПредопределенноеЗначение("Справочник.ИА_ЗначениеАналитики.ПустаяСсылка");
	ИначеЕсли ЗначТип1 = "Булево" тогда 
		 ЗначСтр = Ложь;
	ИначеЕсли  ЗначТип1 = "Строка" тогда	
		ЗначСтр = "";
	ИначеЕсли ЗначТип1 = "Число" тогда
		ЗначСтр = 0;
	ИначеЕсли ЗначТип1 = "Дата" тогда
		ЗначСтр = Дата("01010001");
	Иначе
		ЗначСтр = ПредопределенноеЗначение(""+ЗначТип1+".ПустаяСсылка");
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура НачалоВыбораАналитики(номерАналитики, Элемент, тд, СтандартнаяОбработка)
	пт = ПолучитьПолныйТип(тд.ВидСтатистики, номерАналитики);
	Если пт = "СправочникСсылка.ИА_ЗначениеАналитики" или пт = "" Тогда
		СтандартнаяОбработка = Ложь;
		
		СтруктураОтбора = Новый Структура("Владелец", ПолучитьЗначениеАналитики(тд.ВидСтатистики,номерАналитики));
		ПараметрыВыбора1 = Новый Структура("Отбор", СтруктураОтбора);
		
		зн = Неопределено;

		
		ОткрытьФорму("Справочник.ИА_ЗначениеАналитики.Форма.ФормаВыбораУпр", ПараметрыВыбора1,,,,, Новый ОписаниеОповещения("НачалоВыбораАналитикиЗавершение", ЭтотОбъект, Новый Структура("номерАналитики, тд", номерАналитики, тд)), РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура НачалоВыбораАналитикиЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	номерАналитики = ДополнительныеПараметры.номерАналитики;
	тд = ДополнительныеПараметры.тд;
	
	
	зн = Результат;
	
	Если ЗначениеЗаполнено(зн) Тогда
		тд["Аналитика"+номерАналитики] = зн;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ПолучитьПолныйТип(ВидСтатистики, номерАналитики)
	Возврат ВидСтатистики["Аналитика"+номерАналитики].ТипАналитикиПолный;
КонецФункции

&НаСервере
Функция ПолучитьЗначениеАналитики(ВидСтатистики, номерАналитики)
	Возврат ВидСтатистики["Аналитика"+номерАналитики];
КонецФункции

&НаКлиенте
Процедура СтатистикиАналитика1НачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	тд = Элементы.Статистики.ТекущиеДанные;
	НачалоВыбораАналитики(1, Элемент, тд, СтандартнаяОбработка);
КонецПроцедуры


&НаКлиенте
Процедура СтатистикиАналитика2НачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	тд = Элементы.Статистики.ТекущиеДанные;
	НачалоВыбораАналитики(2, Элемент, тд, СтандартнаяОбработка);
КонецПроцедуры


&НаКлиенте
Процедура СтатистикиАналитика3НачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	тд = Элементы.Статистики.ТекущиеДанные;
	НачалоВыбораАналитики(3, Элемент, тд, СтандартнаяОбработка);
КонецПроцедуры


&НаСервереБезКонтекста
Процедура УстановитьПустыеТипы(стр)
	Если (не стр.ВидСтатистики.Аналитика1.Пустая()) и (не ЗначениеЗаполнено(стр.Аналитика1)) Тогда
		УстановитьТип1(стр.ВидСтатистики.Аналитика1.ТипАналитикиПолный,стр.Аналитика1);	
	Конецесли;
	
	Если (не стр.ВидСтатистики.Аналитика2.Пустая()) и (не ЗначениеЗаполнено(стр.Аналитика2)) Тогда
		УстановитьТип1(стр.ВидСтатистики.Аналитика2.ТипАналитикиПолный,стр.Аналитика2);
	Конецесли;
	
	Если (не стр.ВидСтатистики.Аналитика3.Пустая()) и (не ЗначениеЗаполнено(стр.Аналитика3)) Тогда
		УстановитьТип1(стр.ВидСтатистики.Аналитика3.ТипАналитикиПолный,стр.Аналитика3);
	Конецесли;
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЗаполнитьДерево();
		
	Если Объект.Ссылка.Пустая() Тогда
		Объект.РазмерШрифта = 12;
	КонецЕсли;
	
	ВидимостьИДоступностьЭлементов();
	
	ИА_КСУОбщийСервер.СделатьКнопкуОсновной(Элементы.ГруппаКП);
КонецПроцедуры

