&НаСервереБезКонтекста
Функция ПолучитьАбсолютныйЦвет(ИсходныйЦвет)
    
    Если ИсходныйЦвет.Вид = ВидЦвета.Абсолютный Тогда
        Возврат ИсходныйЦвет;
    КонецЕсли;
	
	путь = ПолучитьИмяВременногоФайла("mxl");
	
    ТабДок = Новый ТабличныйДокумент;
    ТабДок.Область("R1C1").ЦветФона = ИсходныйЦвет;
    ТабДок.Записать(путь, ТипФайлаТабличногоДокумента.MXL7); 
    ТабДок.Прочитать(путь);
    
    АЦвет = ТабДок.Область("R1C1").ЦветФона;
    
    Возврат АЦвет;
    
КонецФункции 

&НаСервере
Процедура ЗаполнитьДерево()
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда 
		Запрос.Текст = "ВЫБРАТЬ
		|	ИА_НастройкиРабочегоСтолаСтатистикСтатистики.НомерСтроки,
		|	ИА_НастройкиРабочегоСтолаСтатистикСтатистики.ВидСтатистики,
		|	ИА_НастройкиРабочегоСтолаСтатистикСтатистики.Аналитика1,
		|	ИА_НастройкиРабочегоСтолаСтатистикСтатистики.Аналитика2,
		|	ИА_НастройкиРабочегоСтолаСтатистикСтатистики.Аналитика3,
		|	ИА_НастройкиРабочегоСтолаСтатистикСтатистики.ПериодДетализации,
		|	ИА_НастройкиРабочегоСтолаСтатистикСтатистики.ЗаголовокДиаграммы,
		|	ИА_НастройкиРабочегоСтолаСтатистикСтатистики.ЦветГрафика,
		|	ИА_НастройкиРабочегоСтолаСтатистикСтатистики.НаименованиеДляЛегенды,
		|	ИА_НастройкиРабочегоСтолаСтатистикСтатистики.ПоказыватьВИЦО,
		|	ИА_НастройкиРабочегоСтолаСтатистикСтатистики.ИА_ПериодКвоты,
		|	ИА_НастройкиРабочегоСтолаСтатистикСтатистики.ИА_НеОтображатьНаРабочемСтоле,
		|	ИА_НастройкиРабочегоСтолаСтатистикСтатистики.ИА_ТипКвоты,
		|	ИА_НастройкиРабочегоСтолаСтатистикСтатистики.ЦветГрафикаНарастающейКвоты,
		|	ИА_НастройкиРабочегоСтолаСтатистикСтатистики.ЦветГрафикаХран,
		|	ИА_НастройкиРабочегоСтолаСтатистикСтатистики.ЦветГрафикаНарастающейКвотыХран,
		|	ИА_НастройкиРабочегоСтолаСтатистикСтатистики.УзорТочки,
		|	ИА_НастройкиРабочегоСтолаСтатистикСтатистики.МаштабМинимум,
		|	ИА_НастройкиРабочегоСтолаСтатистикСтатистики.МаштабМаксимум,
		|	ИА_НастройкиРабочегоСтолаСтатистикСтатистики.СдвигПериода,
		|	ИА_НастройкиРабочегоСтолаСтатистикСтатистики.ВидСдвигаПериода
		|ПОМЕСТИТЬ ВТ
		|ИЗ
		|	Справочник.ИА_НастройкиРабочегоСтолаСтатистик.Статистики КАК ИА_НастройкиРабочегоСтолаСтатистикСтатистики
		|ГДЕ
		|	ИА_НастройкиРабочегоСтолаСтатистикСтатистики.Ссылка = &Ссылка";
		Запрос.УстановитьПараметр("Ссылка", Объект.Ссылка);
	Иначе
		//при копировании данные берутся из ТЧ		   
		Запрос.Текст = "ВЫБРАТЬ	    
		|	ВремТаблица.НомерСтроки,
		|	ВремТаблица.ВидСтатистики,
		|	ВремТаблица.Аналитика1,
		|	ВремТаблица.Аналитика2,
		|	ВремТаблица.Аналитика3,
		|	ВремТаблица.ПериодДетализации,
		|	ВремТаблица.ЗаголовокДиаграммы,
		|	ВремТаблица.ЦветГрафика,
		|	ВремТаблица.НаименованиеДляЛегенды,
		|	ВремТаблица.ПоказыватьВИЦО,
		|	ВремТаблица.ИА_ПериодКвоты,
		|	ВремТаблица.ИА_НеОтображатьНаРабочемСтоле,
		|	ВремТаблица.ИА_ТипКвоты,
		|	ВремТаблица.ЦветГрафикаНарастающейКвоты,
		|	ВремТаблица.ЦветГрафикаХран,
		|	ВремТаблица.ЦветГрафикаНарастающейКвотыХран,
		|	ВремТаблица.УзорТочки,
		|	ВремТаблица.МаштабМинимум,
		|	ВремТаблица.МаштабМаксимум,
		|	ВремТаблица.СдвигПериода,
		|	ВремТаблица.ВидСдвигаПериода
		|ПОМЕСТИТЬ ВТ
		|ИЗ
		|	&ВремТаблица КАК ВремТаблица";
		Запрос.УстановитьПараметр("ВремТаблица",Объект.Статистики.Выгрузить());
	КонецЕсли;	   
	Запрос.Выполнить();
	Запрос.Текст = "ВЫБРАТЬ
	               |	ВТ.НомерСтроки,
	               |	ВТ.ВидСтатистики,
	               |	ВТ.Аналитика1,
	               |	ВТ.Аналитика2,
	               |	ВТ.Аналитика3,
	               |	ВТ.ПериодДетализации,
	               |	ВТ.ЗаголовокДиаграммы КАК ЗаголовокДиаграммы,
	               |	ВТ.ЦветГрафикаХран,
	               |	ВТ.НаименованиеДляЛегенды,
	               |	ВТ.ПоказыватьВИЦО,
	               |	ВТ.ИА_ПериодКвоты,
	               |	ВТ.ИА_НеОтображатьНаРабочемСтоле,
	               |	ВТ.ИА_ТипКвоты,
	               |	ВТ.ЦветГрафикаНарастающейКвотыХран,
	               |	ИСТИНА КАК ЭтоПодчиненная,
	               |	ВЫБОР
	               |		КОГДА ВТ.ВидСтатистики.Аналитика1 = ЗНАЧЕНИЕ(Справочник.ИА_ВидыАналитикиСтатистики.ПустаяСсылка)
	               |			ТОГДА ЛОЖЬ
	               |		ИНАЧЕ ИСТИНА
	               |	КОНЕЦ КАК ЕстьАналитика1,
	               |	ВЫБОР
	               |		КОГДА ВТ.ВидСтатистики.Аналитика2 = ЗНАЧЕНИЕ(Справочник.ИА_ВидыАналитикиСтатистики.ПустаяСсылка)
	               |			ТОГДА ЛОЖЬ
	               |		ИНАЧЕ ИСТИНА
	               |	КОНЕЦ КАК ЕстьАналитика2,
	               |	ВЫБОР
	               |		КОГДА ВТ.ВидСтатистики.Аналитика3 = ЗНАЧЕНИЕ(Справочник.ИА_ВидыАналитикиСтатистики.ПустаяСсылка)
	               |			ТОГДА ЛОЖЬ
	               |		ИНАЧЕ ИСТИНА
	               |	КОНЕЦ КАК ЕстьАналитика3,
	               |	ВТ.УзорТочки,
	               |	ВЫБОР
	               |		КОГДА ВТ.ЦветГрафикаХран = """"
	               |			ТОГДА ИСТИНА
	               |		ИНАЧЕ ЛОЖЬ
	               |	КОНЕЦ КАК ЦветОчищен,
	               |	ВЫБОР
	               |		КОГДА ВТ.ЦветГрафикаНарастающейКвотыХран = """"
	               |			ТОГДА ИСТИНА
	               |		ИНАЧЕ ЛОЖЬ
	               |	КОНЕЦ КАК ЦветНКОчищен,
	               |	ВТ.МаштабМинимум,
	               |	ВТ.МаштабМаксимум,
	               |	ВТ.СдвигПериода,
	               |	ВТ.ВидСдвигаПериода
	               |ИЗ
	               |	ВТ КАК ВТ
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ВТ.НомерСтроки
	               |ИТОГИ ПО
	               |	ЗаголовокДиаграммы
	               |АВТОУПОРЯДОЧИВАНИЕ";
				    
	Дер = Запрос.Выполнить().Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам);
	Дер.Колонки.Добавить("ЦветГрафика", Новый ОписаниеТипов("Цвет"));
	Дер.Колонки.Добавить("ЦветГрафикаНарастающейКвоты", Новый ОписаниеТипов("Цвет"));
	
	Для каждого стр из Дер.Строки Цикл
		ЗаполнитьЗначенияСвойств(стр, стр.Строки[0]);
		ЗаполнитьЦвета(стр);
		Если стр.Строки.Количество() = 1 Тогда
			стр.Строки.Очистить();
		ИначеЕсли стр.Строки.Количество() >= 2 Тогда
			стр.Строки.Удалить(стр.Строки[0]);
		КонецЕсли;
		
		стр.ЭтоПодчиненная = ложь;
		
		УстановитьПустыеТипы(стр);		
		Для каждого стр1 из стр.Строки Цикл
			ЗаполнитьЦвета(стр1);
			УстановитьПустыеТипы(стр1);		
		КонецЦикла;
	КонецЦикла;
	
	Дер.Колонки.Удалить("ЦветГрафикаХран");
	Дер.Колонки.Удалить("ЦветГрафикаНарастающейКвотыХран");

	ЗначениеВРеквизитФормы(дер, "Дерево");
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ЗаполнитьЦвета(Стр)
	Если стр.ЦветГрафикаХран<>"" Тогда
		стр.ЦветГрафика = Вычислить("Новый Цвет("+стр.ЦветГрафикаХран+")");
	КонецЕсли;
	Если стр.ЦветГрафикаНарастающейКвотыХран<>"" Тогда
		стр.ЦветГрафикаНарастающейКвоты = Вычислить("Новый Цвет("+стр.ЦветГрафикаНарастающейКвотыХран+")");
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	Если не ИА_Защита_Общий.ЛицензияДоступна("Статистика") Тогда
		Отказ = Истина;
		возврат;
	КонецЕсли;
	
	Если Объект.Ссылка.Пустая() Тогда
		Попытка
			объект.СлужебнаяНастройка = этаформа.ВладелецФормы.Родитель.Служебные;
		Исключение
		КонецПопытки;
	КонецЕсли;
КонецПроцедуры


&НаКлиенте
Процедура ТипКвотыПриИзменении(Элемент)
	
	Если Элементы.Статистики.ТекущиеДанные.ИА_ТипКвоты = ПредопределенноеЗначение("Перечисление.ИА_ТипыКвот.Нарастающая") Тогда
		Если не ЗначениеЗаполнено(Элементы.Статистики.ТекущиеДанные.ПериодДетализации) Тогда
			возврат;
		КонецЕсли;
		
		Структура = ПолучитьСтруктуруПериодов();
		Зн = Структура.Получить(Элементы.Статистики.ТекущиеДанные.ПериодДетализации);
		Для каждого элем из Структура Цикл
			Если Элем.Значение = Зн + 1 Тогда
				Элементы.Статистики.ТекущиеДанные.ИА_ПериодКвоты = Элем.Ключ;
				Прервать;
			КонецЕсли;	
		КонецЦикла;
	ИначеЕсли Элементы.Статистики.ТекущиеДанные.ИА_ТипКвоты = ПредопределенноеЗначение("Перечисление.ИА_ТипыКвот.Обычная") Тогда
		Элементы.Статистики.ТекущиеДанные.ИА_ПериодКвоты = Элементы.Статистики.ТекущиеДанные.ПериодДетализации;
	Иначе
		Элементы.Статистики.ТекущиеДанные.ИА_ПериодКвоты = Неопределено; 		
	КонецЕсли;	
	
	УстановитьВидимостьДоступность();
	
КонецПроцедуры


&НаКлиенте
Процедура ПериодКвотыПриИзменении(Элемент)
	
	Если ЗначениеЗаполнено(Элементы.Статистики.ТекущиеДанные.ИА_ПериодКвоты) Тогда
		Структура = ПолучитьСтруктуруПериодов();
		ПериодКвоты = Элементы.Статистики.ТекущиеДанные.ИА_ПериодКвоты;
		ПериодДетализации = Элементы.Статистики.ТекущиеДанные.ПериодДетализации;
		
		Если Структура.Получить(ПериодДетализации) - Структура.Получить(ПериодКвоты) > 0 Тогда
			Сообщить("Период квоты не может быть меньше периода детализации", СтатусСообщения.Информация); 
			Элементы.Статистики.ТекущиеДанные.ИА_ПериодКвоты = Неопределено;
			Возврат;
		КонецЕсли;
			
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьСтруктуруПериодов()  
	
	Структура = Новый Соответствие;
	Структура.Вставить(ПредопределенноеЗначение("Перечисление.ИА_ПериодыДетализации.День"), 1);
	Структура.Вставить(ПредопределенноеЗначение("Перечисление.ИА_ПериодыДетализации.Неделя"), 2);
	Структура.Вставить(ПредопределенноеЗначение("Перечисление.ИА_ПериодыДетализации.Месяц"), 3);
	Структура.Вставить(ПредопределенноеЗначение("Перечисление.ИА_ПериодыДетализации.Квартал"), 4);
	Структура.Вставить(ПредопределенноеЗначение("Перечисление.ИА_ПериодыДетализации.Год"), 5);
	
	Возврат Структура;
	
КонецФункции // ПолучитьСтруктуруПериодов()

&НаКлиенте
Функция УстановитьВидимостьДоступность()

	ТекДанные = Элементы.Статистики.ТекущиеДанные;
	Если ТекДанные <> Неопределено Тогда
		Если ТекДанные.ИА_ТипКвоты = ПредопределенноеЗначение("Перечисление.ИА_ТипыКвот.Нарастающая") Тогда
			Элементы.СтатистикиИА_ПериодКвоты.Доступность = Истина;
			Элементы.СтатистикиИА_ЦветГрафикаНарастающейКвоты.Доступность = Истина;
		ИначеЕсли ТекДанные.ИА_ТипКвоты = ПредопределенноеЗначение("Перечисление.ИА_ТипыКвот.Обычная") Тогда
			Элементы.СтатистикиИА_ПериодКвоты.Доступность = Ложь; 
			Элементы.СтатистикиИА_ЦветГрафикаНарастающейКвоты.Доступность = Ложь;
		Иначе
			Элементы.СтатистикиИА_ПериодКвоты.Доступность = Ложь; 		
			Элементы.СтатистикиИА_ЦветГрафикаНарастающейКвоты.Доступность = Ложь;
		КонецЕсли;	
		
		Элементы.СтатистикиДобавитьВторуюСтатистику.Доступность = ТекДанные.ПолучитьРодителя() = Неопределено; 
	КонецЕсли;

КонецФункции // УстановитьВидимостьДоступность()

&НаКлиенте
Процедура СтатистикиПриАктивизацииСтроки(Элемент)
	УстановитьВидимостьДоступность();
КонецПроцедуры

&НаКлиенте
Процедура СтатистикиПериодДетализацииПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.Статистики.ТекущиеДанные;
	
	Если ТекущиеДанные.ИА_ТипКвоты = ПредопределенноеЗначение("Перечисление.ИА_ТипыКвот.Обычная") Тогда
		ТекущиеДанные.ИА_ПериодКвоты = ТекущиеДанные.ПериодДетализации;
	Иначе
		ТекущиеДанные.ИА_ПериодКвоты = Неопределено;
	КонецЕсли;
	
	Для каждого ПодСтрокаТекущиеДанные из ТекущиеДанные.ПолучитьЭлементы() Цикл
		
		ПодСтрокаТекущиеДанные.ПериодДетализации = ТекущиеДанные.ПериодДетализации;
		Если Не ПроверитьСовместимостьПериодов(ПодСтрокаТекущиеДанные) Тогда
			ПодСтрокаТекущиеДанные.ВидСдвигаПериода = ТекущиеДанные.ПериодДетализации;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ПроверитьПеревернутыеСтатистики(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	Для каждого СтрокаДерева из Дерево.ПолучитьЭлементы() Цикл
		
		СтрокиГрафика = СтрокаДерева.ПолучитьЭлементы();
		КоличествоГрафиков = СтрокиГрафика.Количество()+ 1;
		КоличествоПеревернутыхГрафиков = 0;
		
		ПеревернутаяСтатистика = СтрокаДерева.ВидСтатистики.ПеревернутаяСтатистика;
		Если ПеревернутаяСтатистика Тогда
			КоличествоПеревернутыхГрафиков = КоличествоПеревернутыхГрафиков + 1;
			ПеревернутыйГрафик = СтрокаДерева;
		КонецЕсли;
		
		Для каждого СтрокаГрафика из СтрокиГрафика Цикл
			ПеревернутаяСтатистика = СтрокаГрафика.ВидСтатистики.ПеревернутаяСтатистика;
			Если ПеревернутаяСтатистика Тогда
				КоличествоПеревернутыхГрафиков = КоличествоПеревернутыхГрафиков + 1;
				ПеревернутыйГрафик = СтрокаГрафика;
			КонецЕсли;
		КонецЦикла;
		
		Если (КоличествоПеревернутыхГрафиков <> 0) и (КоличествоПеревернутыхГрафиков <> КоличествоГрафиков) Тогда
			
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = "Перевернутая статистика: "+ ПеревернутыйГрафик.ВидСтатистики + "! На одном поле, должны быть либо все прямые, либо все перевернутые.";
			Сообщение.Сообщить(); 
			
			Отказ = Истина;
			
			Возврат;

		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюСервер(Отказ, ПараметрыЗаписи)
	
	ПроверитьПеревернутыеСтатистики(Отказ, Объект, ПараметрыЗаписи);
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	Объект.Статистики.Очистить();
	
	Для каждого стр из Дерево.ПолучитьЭлементы() Цикл
		Если стр.ПериодДетализации.Пустая() Тогда
			Сообщить("Заполните периодичность графика!");
			Отказ = Истина;
			Возврат;
		КонецЕсли;
		
		Новстр = Объект.Статистики.Добавить();
		ЗаполнитьЗначенияСвойств(Новстр, стр);
		//
		Новстр.ЦветГрафикаХран = ?(стр.ЦветОчищен,"",ИА_Статистики.ПолучитьПредставлениеЦвета(стр.ЦветГрафика));
		Новстр.ЦветГрафикаНарастающейКвотыХран = ?(стр.ЦветНКОчищен,"",ИА_Статистики.ПолучитьПредставлениеЦвета(стр.ЦветГрафикаНарастающейКвоты));
		//
		Заголовок = стр.НаименованиеДляЛегенды;
		Если стр.ПолучитьЭлементы().Количество()>0 Тогда
			Для каждого стр1 из стр.ПолучитьЭлементы() Цикл
				Заголовок = Заголовок + " / " + стр1.НаименованиеДляЛегенды;
			КонецЦикла;
		КонецЕсли;
		Новстр.ЗаголовокДиаграммы = Заголовок;
		
		Для каждого стр1 из стр.ПолучитьЭлементы() Цикл
			Новстр = Объект.Статистики.Добавить();
			ЗаполнитьЗначенияСвойств(Новстр, стр1);
			Новстр.ЗаголовокДиаграммы = Заголовок;
			Новстр.ПериодДетализации = стр.ПериодДетализации;
			//
			Новстр.ЦветГрафикаХран = ?(стр1.ЦветОчищен,"",ИА_Статистики.ПолучитьПредставлениеЦвета(стр1.ЦветГрафика));
			Новстр.ЦветГрафикаНарастающейКвотыХран = ?(стр1.ЦветНКОчищен,"",ИА_Статистики.ПолучитьПредставлениеЦвета(стр1.ЦветГрафикаНарастающейКвоты));
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьСтатистику(Команда)
	Новстр = Дерево.ПолучитьЭлементы().Добавить();
	Новстр.ПериодДетализации = Объект.ОсновнойПериодДетализации;
	Новстр.ЦветОчищен = истина;
	Новстр.ЦветНКОчищен = истина;
	
	ОткрытьФорму("Справочник.ИА_ВидыСтатистик.ФормаВыбора",,,,,, Новый ОписаниеОповещения("ДобавитьСтатистикуЗавершение", ЭтотОбъект, Новый Структура("Новстр", Новстр)), РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьСтатистикуЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Новстр = ДополнительныеПараметры.Новстр;	
	Новстр.ВидСтатистики = Результат;
	
	Элементы.Статистики.ТекущаяСтрока = Новстр.ПолучитьИдентификатор();
	СтатистикиВидСтатистикиПриИзменении(Неопределено);

КонецПроцедуры

&НаКлиенте
Процедура ДобавитьВторуюСтатистику(Команда)
	тс = Элементы.Статистики.ТекущаяСтрока;
	Новстр = Дерево.НайтиПоИдентификатору(тс).ПолучитьЭлементы().Добавить();
	Новстр.ПериодДетализации = Элементы.Статистики.ТекущиеДанные.ПериодДетализации;
	Новстр.ЭтоПодчиненная = истина;
	Новстр.ЦветОчищен = истина;
	Новстр.ЦветНКОчищен = истина;
	
	ОткрытьФорму("Справочник.ИА_ВидыСтатистик.ФормаВыбора",,,,,, Новый ОписаниеОповещения("ДобавитьВторуюСтатистикуЗавершение", ЭтотОбъект, Новый Структура("Новстр", Новстр)), РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьВторуюСтатистикуЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Новстр = ДополнительныеПараметры.Новстр;
	
	
	Новстр.ВидСтатистики = Результат;
	
	Элементы.Статистики.ТекущаяСтрока = Новстр.ПолучитьИдентификатор();
	СтатистикиВидСтатистикиПриИзменении(Неопределено);

КонецПроцедуры

&НаКлиенте
Процедура СтатистикиПриИзменении(Элемент)
	Модифицированность = истина;
КонецПроцедуры

&НаКлиенте
Процедура ДопПараметрыГрафика(Команда)
	Элементы.СтатистикиДопПараметрыГрафика.Пометка = не Элементы.СтатистикиДопПараметрыГрафика.Пометка;
	Элементы.СтатистикиГруппаДоп.Видимость = Элементы.СтатистикиДопПараметрыГрафика.Пометка;
КонецПроцедуры

&НаКлиенте
Процедура СтатистикиЦветГрафикаПриИзменении(Элемент)
	тд = Элементы.Статистики.ТекущиеДанные;
	Если тд.ЦветОчищен Тогда
		возврат;
	КонецЕсли;
	
	тд.ЦветГрафика = ПолучитьАбсолютныйЦвет(тд.ЦветГрафика);
КонецПроцедуры

&НаКлиенте
Процедура СтатистикиИА_ЦветГрафикаНарастающейКвотыПриИзменении(Элемент)
	тд = Элементы.Статистики.ТекущиеДанные;
	Если тд.ЦветНКОчищен Тогда
		возврат;
	КонецЕсли;

	тд.ЦветГрафикаНарастающейКвоты = ПолучитьАбсолютныйЦвет(тд.ЦветГрафикаНарастающейКвоты);
КонецПроцедуры

