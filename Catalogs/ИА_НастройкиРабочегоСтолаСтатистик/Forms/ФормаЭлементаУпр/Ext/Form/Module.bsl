&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	ПередЗаписьюКлиент(Отказ, ПараметрыЗаписи);
	
	Если не Отказ Тогда
		ПередЗаписьюСервер(Отказ, ПараметрыЗаписи);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписьюКлиент(Отказ, ПараметрыЗаписи)
	
	Для каждого стрСтатистики Из Объект.Статистики Цикл
		Если стрСтатистики.СдвигПериода <> 0 и Не ЗначениеЗаполнено(стрСтатистики.ВидСдвигаПериода) Тогда
			
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = "В статистике "+ стрСтатистики.НаименованиеДляЛегенды +" указан сдвиг, но не заполнен вид сдвига!";
			Сообщение.Сообщить();
			
			Отказ = Истина;
			
		КонецЕсли;
		
		Если НЕ ПроверитьСовместимостьПериодов(стрСтатистики) Тогда
			
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = """Вид сдвига периода"" не может быть меньше ""Периода детализации""!";
			Сообщение.Сообщить();
			
			Возврат;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура СтатистикиСдвигПериодаПриИзменении(Элемент)
	
	ДанныеСтроки = Элементы.Статистики.ТекущиеДанные;
	ЗаполнитьНаименованиеДляЛегенды(ДанныеСтроки);
	
КонецПроцедуры

&НаКлиенте
Процедура СтатистикиВидСдвигаПериодаПриИзменении(Элемент)
	
	ДанныеСтроки = Элементы.Статистики.ТекущиеДанные;
	
	Если НЕ ПроверитьСовместимостьПериодов(ДанныеСтроки) Тогда
		
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = """Вид сдвига периода"" не может быть меньше ""Периода детализации""!";
		Сообщение.Сообщить();
		
		ДанныеСтроки.ВидСдвигаПериода = ПредопределенноеЗначение("Перечисление.ИА_ПериодыДетализации.ПустаяСсылка");
		
		Возврат;
		
	КонецЕсли;
	
	ЗаполнитьНаименованиеДляЛегенды(ДанныеСтроки);
	
КонецПроцедуры

&НаКлиенте
Функция ПроверитьСовместимостьПериодов(ДанныеСтроки)
	
	Если ИА_Статистики.ТиповыеПериоды_БольшеИлиРавно(ДанныеСтроки.ВидСдвигаПериода, ДанныеСтроки.ПериодДетализации) Тогда
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Процедура ЗаполнитьНаименованиеДляЛегенды(ДанныеСтроки)
	
	НаименованиеДляЛегенды = Строка(ДанныеСтроки.ВидСтатистики);
	
	Если ЗначениеЗаполнено(ДанныеСтроки.СдвигПериода) Тогда
		НаименованиеДляЛегенды =  НаименованиеДляЛегенды + " (сдвиг "+ ДанныеСтроки.СдвигПериода + " "+ ИА_Статистики.ПолучитьПредставениеПериодаДетализации(ДанныеСтроки.СдвигПериода, ДанныеСтроки.ВидСдвигаПериода)+")";  
	КонецЕсли;
	
	ДанныеСтроки.НаименованиеДляЛегенды = НаименованиеДляЛегенды;

КонецПроцедуры

&НаКлиенте
Процедура СтатистикиВидСдвигаПериодаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ДанныеСтроки = Элементы.Статистики.ТекущиеДанные;

	ДанныеВыбора = Новый СписокЗначений;

	СтатистикиВидСдвигаПериодаНачалоВыбораНаКлиенте(ДанныеВыбора, ДанныеСтроки);
	
КонецПроцедуры

&НаКлиенте
Процедура СтатистикиВидСдвигаПериодаНачалоВыбораНаКлиенте(ДанныеВыбора, ДанныеСтроки)
	
	СтруктураВыбора = СтатистикиВидСдвигаПериодаПолучитьСтруктуруВыбораНаСервере();
	
	ПериодДетализации = ДанныеСтроки.ПериодДетализации;
	Для каждого СтрокаПериодов Из СтруктураВыбора Цикл
		Если Не ЗначениеЗаполнено(ПериодДетализации) ИЛИ ТиповыеПериоды_БольшеИлиРавно(СтрокаПериодов.Значение, ДанныеСтроки.ПериодДетализации) Тогда
			ДанныеВыбора.Добавить(СтрокаПериодов.Значение);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ТиповыеПериоды_БольшеИлиРавно(ТиповойПериод1, ТиповойПериод2)
	Возврат ИА_Статистики.ТиповыеПериоды_БольшеИлиРавно(ТиповойПериод1, ТиповойПериод2);
КонецФункции

&НаСервереБезКонтекста
Функция СтатистикиВидСдвигаПериодаПолучитьСтруктуруВыбораНаСервере()
	
	СтруктураВыбора = Новый Структура;
	
	Для каждого СтрокаПериодов Из Перечисления.ИА_ПериодыДетализации Цикл
		СтруктураВыбора.Вставить(СтрокаПериодов, СтрокаПериодов);
	КонецЦикла;
	
	Возврат СтруктураВыбора; 
	
КонецФункции

