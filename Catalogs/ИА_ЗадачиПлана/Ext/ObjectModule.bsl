
Процедура ПередЗаписью(Отказ)
	Время = Час(ВремяПлан)+Минута(ВремяПлан)/60;
КонецПроцедуры

Процедура СформироватьНаименование() Экспорт
	Содержание = СокрЛП(Содержание);
	Наименование = лев(Содержание,100); 
КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	Если идСобытияГугл = "" и не Владелец.Родитель.Пустая() и ЗначениеЗаполнено(ВремяНачала) и ЗначениеЗаполнено(ВремяКонца) Тогда // дневной
		мен = РегистрыСведений.КСУ_ВыгрузкаЗадачВГуглКалендарь.СоздатьМенеджерЗаписи();
		мен.Задача = Ссылка;
		мен.Прочитать();
		мен.Задача = Ссылка;
		мен.Содержание = Содержание;
		мен.ВремяНачала = ВремяНачала;
		мен.ВремяКонца = ВремяКонца;
		мен.Дата = Владелец.ДатаНачала;
		мен.Пользователь = Владелец.Ответственный;
		мен.ТребуетсяВыгрузка = истина;
		мен.Записать();
	КонецЕсли;
	
	Если идСобытияГугл = "" и Владелец.Родитель.Пустая() И Порядок = 0 Тогда // Недельный
		Запрос = новый запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	ЕСТЬNULL(МАКСИМУМ(ИА_ЗадачиПлана.Порядок), 0) КАК Порядок
		               |ИЗ
		               |	Справочник.ИА_ЗадачиПлана КАК ИА_ЗадачиПлана
		               |ГДЕ
		               |	ИА_ЗадачиПлана.Владелец = &Владелец";
		Запрос.УстановитьПараметр("Владелец", Владелец);
		Выборка = запрос.Выполнить().Выбрать();
		Выборка.Следующий();
		
		Порядок = Выборка.Порядок + 1;
	КонецЕсли;

	///// задачи в плане
	мен = РегистрыСведений.КСУ_ЗадачиВПлане.СоздатьМенеджерЗаписи();
	мен.ЗадачаПлана = Ссылка;
	мен.Прочитать();
	мен.ЗадачаПлана = Ссылка;
	
	Если ЗначениеЗаполнено(ЗадачаОснование) и ТипЗнч(ЗадачаОснование) = тип("ЗадачаСсылка.ИА_ЗадачаПланаДействий") и не ПометкаУдаления Тогда
		мен.Задача = ЗадачаОснование;
		мен.Пользователь = Владелец.Ответственный;
		мен.Записать();
	ИначеЕсли мен.Выбран() Тогда
		мен.Удалить();
	КонецЕсли;
КонецПроцедуры

