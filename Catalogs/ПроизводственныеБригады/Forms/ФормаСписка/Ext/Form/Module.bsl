&НаСервере
Процедура УстановитьОтборПоНеактивная()
	ЭО = Список.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭО.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ЭО.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Неактивная");
	ЭО.ПравоеЗначение = Ложь;
	ЭО.Использование = Истина;	
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	УстановитьОтборПоНеактивная();			
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьВсехПриИзменении(Элемент)
	Если ПоказатьВсех Тогда
		Список.Отбор.Элементы.Очистить();
	Иначе
		УстановитьОтборПоНеактивная();
	КонецЕсли;
КонецПроцедуры
