&НаСервере
Процедура ЗаполнитьВходящие()
    ТабВходящие.Очистить();
    М = Справочники.ИА_БПТочкиМаршрута.ПолучитьВходящиеТочки(Объект.Ссылка);	
    Для каждого Точка Из М Цикл
        ТабВходящие.Добавить().Адрес = Точка;
    КонецЦикла; 
КонецПроцедуры


&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
    Если НЕ ИА_Защита_Общий.ЛицензияДоступна("НФ", Отказ) Тогда Возврат КонецЕсли; 
    
    Если НЕ ЗначениеЗаполнено(Объект.Ответственный) Тогда
    	Объект.Ответственный = Перечисления.ИА_БПТипыАдресацииЗадач.ОтветственныйЗаБП;        
    КонецЕсли; 
    
    УстановитьНеизменяемыеПараметры();

    
    МаршрутЗадач = Объект.Владелец.МаршрутЗадач;
    
    Элементы.ДеревоРеквизитов.ТолькоПросмотр = ЭтаФорма.ТолькоПросмотр;
    ЗагрузитьДанныеХранилищ();
    
    ЗаполнитьВходящие();
    ЗаполнитьСобытия();
    
    мен = Перечисления.ИА_БПТипыТочекМаршрута;
    МассивЗаполняемыхТочек = Новый Массив;
    МассивЗаполняемыхТочек.Добавить(мен.Действие);
    МассивЗаполняемыхТочек.Добавить(мен.Условие);
    МассивЗаполняемыхТочек.Добавить(мен.ВложенныйБизнесПроцесс);
    
    
    Элементы.ГруппаРеквизитыТочки.Видимость = МассивЗаполняемыхТочек.Найти(Объект.Тип) <> Неопределено;
    
    Если Объект.Тип = мен.ВложенныйБизнесПроцесс Тогда
    	Элементы.ЭтоУведомление.Видимость       = Ложь;
        Элементы.ГруппаДлительность.Видимость   = Ложь;
        Элементы.ГруппаВложенныйБП.Видимость    = Истина;
        Элементы.МаршрутЗадачВложенногоБП.Заголовок = "Запуск БП с " + Метаданные.Справочники.ИА_БПМаршрутЗадач.ПредставлениеОбъекта;
        ЗаполнитьДеревоРеквизитов_ИзМД();
    Иначе
        Элементы.ГруппаВложенныйБП.Видимость = Ложь;
    КонецЕсли; 
    
    Параметры.Свойство("РежимПакета",  РежимПакета);
    Параметры.Свойство("ДанныеПакета", ДанныеПакета);
    
    Контекст = Новый Структура("Параметры, Объект, Форма", Параметры, Объект, ЭтаФорма);
