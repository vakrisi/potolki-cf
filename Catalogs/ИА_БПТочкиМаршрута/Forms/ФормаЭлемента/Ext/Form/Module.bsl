&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
    
    Таб = ИА_БФС.ДЗ2ТЗ(РеквизитФормыВЗначение("ДеревоРеквизитов"));
    ИА_БФС.ТЗ_УдалитьСтрокиПоУсловию(Таб, "СтрокаТЗ.ЭтоГруппа");
    
    ТекущийОбъект.РеквизитыВложенногоБП.Загрузить(Таб);
    
    Для каждого СтрокаТЗ Из ТаблицаХранилищ Цикл
        НайдСтрока = ТекущийОбъект.Обработчики.Найти(СтрокаТЗ.Событие, "Событие");
        Если НайдСтрока <> Неопределено Тогда
            Данные = ПолучитьИзВременногоХранилища(СтрокаТЗ.Адрес);
            НайдСтрока.ХранилищеДанных = Новый ХранилищеЗначения(Данные);
        КонецЕсли; 
    КонецЦикла; 
    
    Для каждого СтрокаТЗ Из ХранилищеДопРеквизиты Цикл
        НайдСтрока = ТекущийОбъект.РеквизитыВложенногоБП.Найти(СтрокаТЗ.Реквизит, "Реквизит");
        Если НайдСтрока <> Неопределено Тогда
            Данные = ПолучитьИзВременногоХранилища(СтрокаТЗ.Адрес);
            НайдСтрока.ХранилищеДанных = Новый ХранилищеЗначения(Данные);
        КонецЕсли; 
    КонецЦикла; 
КонецПроцедуры

