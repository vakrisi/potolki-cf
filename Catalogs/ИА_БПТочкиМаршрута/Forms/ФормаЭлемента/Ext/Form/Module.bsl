&НаКлиенте
Процедура ОбработчикиПредставлениеНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
    СтандартнаяОбработка = Истина;
    
    ТекСтрока = Элементы.Обработчики.ТекущиеДанные;
    Если ТекСтрока <> Неопределено Тогда
        Если ТекСтрока.Событие = ПредопределенноеЗначение("Перечисление.ИА_БПСобытияТочекБП.Действие_ПриВыполнении")
            ИЛИ ТекСтрока.Событие = ПредопределенноеЗначение("Перечисление.ИА_БПСобытияТочекБП.Условие_ПроверкаУсловия")
            Тогда
            
            Если ТекСтрока.Обработчик = ПредопределенноеЗначение("Перечисление.ИА_БПВариантыОбработчиков.ПрограммныйОбработчик") Тогда
                ИА_БФК.РедакторТекста_Открыть(ПодготовитьДанныеДляРедатора(ТекСтрока.Событие), ЭтаФорма);
            ИначеЕсли ТекСтрока.Обработчик = ПредопределенноеЗначение("Перечисление.ИА_БПВариантыОбработчиков.КонструкторУсловия") Тогда
                ИА_БФК.ОтборСКД_ОткрытьРедакторСКД(ПодготовитьДаныеДляСпецРедактора(ТекСтрока.Событие), ЭтаФорма);
            КонецЕсли; 
            
        ИначеЕсли ТекСтрока.Событие = ПредопределенноеЗначение("Перечисление.ИА_БПСобытияТочекБП.ФормированиеНаименования")
            ИЛИ ТекСтрока.Событие = ПредопределенноеЗначение("Перечисление.ИА_БПСобытияТочекБП.ФормированиеСодержания")
            Тогда
            
            Если ТекСтрока.Обработчик = ПредопределенноеЗначение("Перечисление.ИА_БПВариантыОбработчиков.ПрограммныйОбработчик") Тогда
                ИА_БФК.РедакторТекста_Открыть(ПодготовитьДанныеДляРедатора(ТекСтрока.Событие), ЭтаФорма);
            ИначеЕсли ТекСтрока.Обработчик = ПредопределенноеЗначение("Перечисление.ИА_БПВариантыОбработчиков.КонструкторУсловия") Тогда
                ИА_БФК.РедакторФормул_Открыть(ПодготовитьДаныеДляСпецРедактора(ТекСтрока.Событие), ЭтаФорма);
            КонецЕсли; 
        ИначеЕсли ТекСтрока.Событие = ПредопределенноеЗначение("Перечисление.ИА_БПСобытияТочекБП.УстановкаОтветственного") Тогда
            
            Если ТекСтрока.Обработчик = ПредопределенноеЗначение("Перечисление.ИА_БПВариантыОбработчиков.ПрограммныйОбработчик") Тогда
                ИА_БФК.РедакторТекста_Открыть(ПодготовитьДанныеДляРедатора(ТекСтрока.Событие), ЭтаФорма);
            ИначеЕсли ТекСтрока.Обработчик = ПредопределенноеЗначение("Перечисление.ИА_БПВариантыОбработчиков.КонструкторУсловия") Тогда
                ИА_БФК.РедакторФормул_Открыть(ПодготовитьДаныеДляСпецРедактора(ТекСтрока.Событие), ЭтаФорма);
            КонецЕсли; 
        КонецЕсли; 
    КонецЕсли; 
КонецПроцедуры

