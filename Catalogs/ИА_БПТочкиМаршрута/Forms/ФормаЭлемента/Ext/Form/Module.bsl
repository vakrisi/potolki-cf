&НаКлиенте
Процедура ДеревоРеквизитовПриАктивизацииЯчейки(Элемент)
    ТекСтрока = Элемент.ТекущиеДанные;
    Если ТекСтрока <> Неопределено Тогда
        ПодчЭлементы = Элементы.ДеревоРеквизитов.ПодчиненныеЭлементы;
        ПодчЭлементы.ДеревоРеквизитовСпособЗаполнения.ТолькоПросмотр     = ТекСтрока.ЭтоГруппа;
        ПодчЭлементы.ДеревоРеквизитовЗначение.ТолькоПросмотр             = ТекСтрока.ЭтоГруппа;
        
        Если НЕ ТекСтрока.ЭтоГруппа Тогда
            Мен = "Перечисление.ИА_БПСпособыЗаполненияДопРеквизитов.";
            Если ТекСтрока.СпособЗаполнения = ПредопределенноеЗначение(мен + "НеИзменять") Тогда
                ПодчЭлементы.ДеревоРеквизитовЗначение.ТолькоПросмотр             = Истина;
            ИначеЕсли ТекСтрока.СпособЗаполнения = ПредопределенноеЗначение(мен + "Установить") Тогда
                ПодчЭлементы.ДеревоРеквизитовЗначение.ФорматРедактирования       = "";
            ИначеЕсли ТекСтрока.СпособЗаполнения = ПредопределенноеЗначение(мен + "Перенести") Тогда
                ПодчЭлементы.ДеревоРеквизитовЗначение.ФорматРедактирования       = "ДФ=''; БЛ=''; БИ=''";
            КонецЕсли; 
        КонецЕсли; 
        
    КонецЕсли; 
КонецПроцедуры

&НаКлиенте
Процедура ДеревоРеквизитовСпособЗаполненияПриИзменении(Элемент)
    ТекСтрока = Элементы.ДеревоРеквизитов.ТекущиеДанные;
    Если ТекСтрока <> Неопределено Тогда
        мен = "Перечисление.ИА_БПСпособыЗаполненияДопРеквизитов.";
        Если ТекСтрока.СпособЗаполнения = ПредопределенноеЗначение(мен + "ПустаяСсылка") Тогда
        	ТекСтрока.СпособЗаполнения = ПредопределенноеЗначение(мен + "НеИзменять");
        КонецЕсли; 
    	Если ТекСтрока.СпособЗаполнения = ПредопределенноеЗначение(мен + "НеИзменять") Тогда
            ТекСтрока.Значение = Неопределено;
    	ИначеЕсли ТекСтрока.СпособЗаполнения = ПредопределенноеЗначение(мен + "Установить") Тогда
    	ИначеЕсли ТекСтрока.СпособЗаполнения = ПредопределенноеЗначение(мен + "Перенести") Тогда
            ТекСтрока.Значение = Неопределено;
        КонецЕсли; 
    КонецЕсли; 
     
КонецПроцедуры

