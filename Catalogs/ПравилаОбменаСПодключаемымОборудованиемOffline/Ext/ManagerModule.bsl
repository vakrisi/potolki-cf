		ДанныеОтчета.Свернуть("SKU, Группа, КоличествоОстаток, Номенклатура, ВидНоменклатуры, ЕдиницаИзмерения, Характеристика, ЭтоГруппа, Цена");
		
	КонецЕсли;
		
	Запрос = Новый Запрос;
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	Товары.Номенклатура КАК Номенклатура,
