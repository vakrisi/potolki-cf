
#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	
	Если ЭтоГруппа Тогда
		Возврат;
	КонецЕсли;
	
	Если ЭтоНовый() Тогда
		Автор = Пользователи.ТекущийПользователь(); //ПараметрыСеанса.ТекущийПользователь; //#12465	
	КонецЕсли;
	
	// места использования:
	//Справочник.ЦветФактуры.ФормаСозданияУслугУстановкиПродукции
	Если ТипЗнч(ДанныеЗаполнения) = Тип("Структура") Тогда
		ЗаполнитьЗначенияСвойств(ЭтотОбъект, ДанныеЗаполнения);	
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	//#2792	
	Для Индекс = 1 по Кратность.Количество() Цикл
		СтрокаТЧ = Кратность[Индекс-1];
		Для Индекс2 = Индекс + 1 по Кратность.Количество() Цикл
			СтрокаТЧ2 = Кратность[Индекс2-1];
			Если СтрокаТЧ.ВидДокумента = СтрокаТЧ2.ВидДокумента 
				И СтрокаТЧ.ЕдиницаИзмерения = СтрокаТЧ2.ЕдиницаИзмерения Тогда
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку("В таблице ""Кратность"" дублируются значения в строках %1 и %2", Индекс, Индекс2);
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, ЭтотОбъект, "Кратность[" + (Индекс2-1) + "].ВидДокумента", , Отказ);
			КонецЕсли;
		КонецЦикла;	
	КонецЦикла;
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ)	

	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Если (ЭтоГруппа ИЛИ НЕ Справочники.ВидыНоменклатуры.ЭтоНоменклатураПотолкаИлиОтреза(ЭтотОбъект)) 
		И РольДоступна("ДобавлениеИзменениеНоменклатурыПотолков") 
		И НЕ РольДоступна("АдминистраторСистемы")
		И НЕ РольДоступна("ПолныеПрава")
		И НЕ РольДоступна("РедактированиеНоменклатуры") 
		И НЕ РольДоступна("СправочникиРедактирование") ТОГДА
		Сообщить("Нарушение прав доступа: отсутствуют права на создание/изменение номенклатуры, отличной от номенклатуры потолков");
		Отказ = Истина;
	КонецЕсли;

	// последующие проверки только для элементов справочника
	Если ЭтоГруппа Тогда
		Возврат;
	КонецЕсли;
	
	//++ №12909 если наименование для печати пустое, заполним его
	Если ПустаяСтрока(НаименованиеДляПечати) Тогда
		НаименованиеДляПечати = Наименование;
	КонецЕсли;
	//-- №12909
	
	//++ №12232 типовой отрез больше не используется
	Если ЭтоНовый() И ВидНоменклатуры = Справочники.ВидыНоменклатуры.ТиповойОтрез Тогда
		Сообщить("Вид номенклатуры ""Типовой отрез"" не используется.");
		Отказ = Истина;
	КонецЕсли;
	//-- №12232
	
	Если НЕ ВидНоменклатуры = Справочники.ВидыНоменклатуры.Продукция И ЗначениеЗаполнено(Шаблон) Тогда
		Шаблон = Справочники.Номенклатура.ПустаяСсылка();
	КонецЕсли;
	Если НЕ ВидНоменклатуры = Справочники.ВидыНоменклатуры.Продукция И ЗначениеЗаполнено(ВидПродукции) Тогда
		ВидПродукции = Справочники.ВидыПродукции.ПустаяСсылка();
	КонецЕсли;

	// проверяем условие уникальности наименования номенклатуры
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Номенклатура.Наименование
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	Номенклатура.Наименование = &НоменклатураНаименование
	|	И Номенклатура.Ссылка <> &Ссылка
	|	И НЕ Номенклатура.ЭтоГруппа
	|	И НЕ Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Справочник.ВидыНоменклатуры.Потолок)
	|	И НЕ Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Справочник.ВидыНоменклатуры.Отрез)";
	Запрос.УстановитьПараметр("НоменклатураНаименование", Наименование);
	Запрос.УстановитьПараметр("Ссылка", Ссылка);

	Результат = Запрос.Выполнить();
	
	Если НЕ Результат.Пустой() Тогда
	    Сообщить("Номенклатура с таким наименованием уже существует. Введите другое наименование.");
		Отказ = Истина;
	КонецЕсли;
		
КонецПроцедуры

Процедура ПриКопировании(Источник)
	
	ФайлКартинки = Справочники.НоменклатураПрисоединенныеФайлы.ПустаяСсылка();
	
	Если НЕ ЭтоГруппа Тогда
		
		ОсновнаяСпецификация = Справочники.Спецификации.ПустаяСсылка();
		
		//++ №14604
		ОсновнаяСпецификацияКомплектация = Справочники.Спецификации.ПустаяСсылка();
		ОсновнаяСпецификацияСопутствующиеМатериалы = Справочники.Спецификации.ПустаяСсылка();
		//-- №14604
		
		АльтернативнаяЕдиницаИзмерения = Справочники.ЕдиницыИзмерений.ПустаяСсылка();
		
		Потолок_Фактура.Очистить(); 
		
		//nva+++
		ДополнительныеРеквизиты.Очистить();
		//nva---
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриЗаписи(Отказ)

	Если НЕ Отказ Тогда
		ПланыОбмена.Портал.ЗарегистрироватьОбъектКОбмену(Ссылка);
	КонецЕсли;
	
	//++ №8266 если пользователь вручную укажет в карточке ширину нужно исключить из регистра ОбъектыКОбработкеПослеОбновленияРекомендуемые с версией 2.5.0.0
	Если НЕ Отказ И ВидНоменклатуры = Справочники.ВидыНоменклатуры.Полотно И НЕ ШиринаПолотна = 0 Тогда
		
		НаборЗаписей = РегистрыСведений.ОбъектыКОбработкеПослеОбновленияРекомендуемые.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.ВерсияПрограммы.Установить("2.5.0.0");
		НаборЗаписей.Отбор.Документ.Установить(Ссылка); 
		
		НаборЗаписей.Записать();
		
	КонецЕсли;
	//-- №8266
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли
