				<DynamicDataRead>true</DynamicDataRead>
				<QueryText>ВЫБРАТЬ
	СправочникНоменклатура.Ссылка КАК Ссылка,
	СправочникНоменклатура.Архивная КАК Архивная,	
	СправочникНоменклатура.Артикул КАК Артикул,
	СправочникНоменклатура.ПометкаУдаления КАК ПометкаУдаления,
	СправочникНоменклатура.Родитель КАК Родитель,
	СправочникНоменклатура.ЭтоГруппа КАК ЭтоГруппа,
	СправочникНоменклатура.Код КАК Код,
	СправочникНоменклатура.Наименование КАК Наименование,
	СправочникНоменклатура.БазоваяЕдиницаИзмерения КАК БазоваяЕдиницаИзмерения,
	СправочникНоменклатура.ОсновнаяСпецификация КАК ОсновнаяСпецификация,
	СправочникНоменклатура.Предопределенный КАК Предопределенный,
	СправочникНоменклатура.ИмяПредопределенныхДанных КАК ИмяПредопределенныхДанных,
	ЦеныНоменклатурыСрезПоследних.Цена КАК Цена,
	СправочникНоменклатура.ВидНоменклатуры КАК ВидНоменклатуры,
	//++ №9160
	ВЫБОР
		КОГДА СправочникНоменклатура.ФайлКартинки = Значение(Справочник.НоменклатураПрисоединенныеФайлы.ПустаяСсылка)
			ТОГДА -1
		ИНАЧЕ 0
	КОНЕЦ КАК ЕстьОсновноеИзображение
	//-- №9160
ИЗ
	Справочник.Номенклатура КАК СправочникНоменклатура
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЦеныНоменклатуры.СрезПоследних(
				,
