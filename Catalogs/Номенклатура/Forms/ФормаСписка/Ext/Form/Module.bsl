
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	УстановитьУсловноеОформление();
	
	КодФормы = "Справочник_Номенклатура_ФормаСписка";
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды

	ВидЦен = ОбщийМодульСервер.НастройкаПользователя("ВидЦен");
	Если ВидЦен.Пустая() Тогда
		ВидЦен = Справочники.ВидыЦен.ОсновнаяЦенаПродажи;
	КонецЕсли;
	
	ВалютаЦен = Константы.ВалютаУчета.Получить();
	
	Список.Параметры.УстановитьЗначениеПараметра("ВидЦены",ВидЦен);
	Список.Параметры.УстановитьЗначениеПараметра("Валюта", ВалютаЦен);
	Элементы.Цена.Подсказка = "Цена [" + ВидЦен + "," + ВалютаЦен + "]";
	
	ПоказыватьТаблицуЦенВСправочникеНоменклатуры = ПараметрыСеанса.ПоказыватьТаблицуЦенВСправочникеНоменклатуры;
	Элементы.ЦеныНоменклатуры.Видимость = ПоказыватьТаблицуЦенВСправочникеНоменклатуры;
	
	УстановитьЗначенияПоНастройкамФормы();
	Элементы.ПоказыватьОстатки.Пометка = ПоказыватьОстатки;
	Элементы.ОстаткиНоменклатуры.Видимость = ПоказыватьОстатки;
	Элементы.ОстаткиНоменклатурыОрганизация.Видимость = НЕ Константы.ОбщиеСклады.Получить();
	
	УстановитьОтборАрхивнаяНоменклатура(ЭтотОбъект); // №6744
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ОбновитьВидимостьГруппыПредпросмотрИзображения();
	ОбновитьДоступностьКнопокЗагрузкиВыгрузкиИзЭксель();
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьДоступностьКнопокЗагрузкиВыгрузкиИзЭксель()
	
	РеквизитыПользователя = ОбщийМодульСервер.НастройкиПользователя("РазрешеноВыгружатьИЗагружатьНоменклатуруИзФайловXLS");
	
	Если РеквизитыПользователя.РазрешеноВыгружатьИЗагружатьНоменклатуруИзФайловXLS Тогда 
		Элементы.ФормаЗагрузкаИзФайла.Доступность = Истина;
		Элементы.ФормаСохранитьВФайл.Доступность = Истина;
	Иначе
		Элементы.ФормаЗагрузкаИзФайла.Доступность = Ложь;
		Элементы.ФормаСохранитьВФайл.Доступность = Ложь;
	КонецЕсли;
КонецПроцедуры


&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)
	Если Не ЗавершениеРаботы Тогда
		СохранитьНастройкиФормыНаСервере();
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область СтандартныеПодсистемы

// СтандартныеПодсистемы.ПодключаемыеКоманды
&НаКлиенте
Процедура Подключаемый_ВыполнитьКоманду(Команда)
	ОчиститьСообщения();
	ПодключаемыеКомандыКлиент.ВыполнитьКоманду(ЭтотОбъект, Команда, Элементы.Список);
КонецПроцедуры

&НаСервере
Процедура Подключаемый_ВыполнитьКомандуНаСервере(Контекст, Результат) Экспорт
	ПодключаемыеКоманды.ВыполнитьКоманду(ЭтотОбъект, Контекст, Элементы.Список, Результат);
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ОбновитьКоманды()
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Элементы.Список);
КонецПроцедуры
// Конец СтандартныеПодсистемы.ПодключаемыеКоманды

#КонецОбласти

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	УсловноеОформление.Элементы.Очистить();
	
	// Оформление архивной номенклатуры
	ОбщийМодульСервер.УстановитьУсловноеОформлениеЦветТекста(
		УсловноеОформление.Элементы, "Список", 
		Новый ПолеКомпоновкиДанных("Список.Архивная"), ВидСравненияКомпоновкиДанных.Равно, Истина,
		ЦветаСтиля.ТекстЗапрещеннойЯчейкиЦвет);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузкаИзФайла(Команда)
	ОткрытьФорму("Обработка.ЗагрузкаНоменклатурыИзExcel.Форма.Форма");
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьОтчет1(Команда)	
	ПараметрыФормы = Новый Структура("Отбор, КлючНазначенияИспользования, СформироватьПриОткрытии", 
                                    Новый Структура("Номенклатура", СформироватьМассивСсылок()), 
                                    "ВедомостьПоТоварамНаСкладах", 
                                    Истина);

	ОткрытьФорму("Отчет.ВедомостьПоТоварамНаСкладах.Форма", 
				 ПараметрыФормы, 
				 ЭтаФорма, 
				 Новый УникальныйИдентификатор);
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьОтчет2(Команда)
	ПараметрыФормы = Новый Структура("Отбор, КлючНазначенияИспользования, СформироватьПриОткрытии", 
                                    Новый Структура("Номенклатура", СформироватьМассивСсылок()), 
                                    "ВедомостьПоТоварамНаСкладахССебестоимостью", 
                                    Истина);

	ОткрытьФорму("Отчет.ВедомостьПоТоварамНаСкладахССебестоимостью.Форма", 
				 ПараметрыФормы, 
				 ЭтаФорма, 
				 Новый УникальныйИдентификатор);
	
КонецПроцедуры

&НаСервере
Функция СформироватьМассивСсылок()
	МассивНоменклатуры = Новый Массив;
	Для каждого ЭлементСписка Из Элементы.Список.ВыделенныеСтроки Цикл	
		Если ЭлементСписка.ЭтоГруппа Тогда
			// выбираем все элементы группы и добавляем в массив
			Выборка = Справочники.Номенклатура.ВыбратьИерархически(ЭлементСписка.Ссылка); 
			Пока Выборка.Следующий() Цикл 
				МассивНоменклатуры.Добавить(Выборка.Ссылка);
			КонецЦикла; 
		Иначе
			МассивНоменклатуры.Добавить(ЭлементСписка.Ссылка);
		КонецЕсли;
	КонецЦикла;	
	
	Возврат МассивНоменклатуры;
КонецФункции

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	Если ИмяСобытия <> Неопределено Тогда
		Если ИмяСобытия = "ОбновитьФорму" Тогда			
			Элементы.Список.Обновить();
		КонецЕсли;	
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура СохранитьВФайл(Команда)
	ОткрытьФорму("Обработка.ЗагрузкаНоменклатурыИзExcel.Форма.ФормаВыгрузки");
КонецПроцедуры

&НаКлиенте
Процедура СписокПриАктивизацииСтроки(Элемент)
	
	ПодключитьОбработчикОжидания("СписокПриАктивизацииСтрокиОбработчикОжидания", 0.1, Истина);
		
КонецПроцедуры

&НаКлиенте
Процедура СписокПриАктивизацииСтрокиОбработчикОжидания()
	
	ТекущиеДанные = Элементы.Список.ТекущиеДанные;
	Если НЕ ТекущиеДанные = Неопределено Тогда 
		
		Если НЕ ТекущиеДанные.Ссылка = ТекущаяНоменклатура Тогда
			ТекущаяНоменклатура = ТекущиеДанные.Ссылка;
			
			Если ПоказыватьТаблицуЦенВСправочникеНоменклатуры Тогда
				ПоказатьЦеныНоменклатурыТекущегоПользователя(ТекущиеДанные.Ссылка);			
			КонецЕсли;
			Если ПоказыватьОстатки Тогда
				ПоказатьОстаткиНоменклатуры(ТекущиеДанные.Ссылка);			
			КонецЕсли;
			
			//++ №9160
			Если ПоказыватьИзображенияНоменклатуры Тогда
				ПодключитьОбработчикОжидания("ОбработчикОжиданияФайлыПриАктивизацииСтроки", 0.1, Истина);
			КонецЕсли;	
			//-- №9160
			
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ПоказатьЦеныНоменклатурыТекущегоПользователя(Номенклатура)
	
	ЦеныНоменклатуры.Очистить();
	
	Если НЕ Номенклатура.ЭтоГруппа Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ПользователиВидыЦенОтображаемыеВСправочникеНоменклатуры.ВидЦены КАК ВидЦены,
		|	ПользователиВидыЦенОтображаемыеВСправочникеНоменклатуры.Валюта КАК Валюта,
		|	ЦеныНоменклатурыСрезПоследних.Период КАК Дата,
		|	ЦеныНоменклатурыСрезПоследних.Цена КАК Цена,
		|	ЦеныНоменклатурыСрезПоследних.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
		|	ЦеныНоменклатурыСрезПоследних.ЕдиницаИзмерения КАК ЕдиницаИзмерения
		|ИЗ
		|	Справочник.Пользователи.ВидыЦенОтображаемыеВСправочникеНоменклатуры КАК ПользователиВидыЦенОтображаемыеВСправочникеНоменклатуры
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЦеныНоменклатуры.СрезПоследних(, Номенклатура = &Номенклатура) КАК ЦеныНоменклатурыСрезПоследних
		|		ПО ПользователиВидыЦенОтображаемыеВСправочникеНоменклатуры.ВидЦены = ЦеныНоменклатурыСрезПоследних.ВидЦены
		|			И ПользователиВидыЦенОтображаемыеВСправочникеНоменклатуры.Валюта = ЦеныНоменклатурыСрезПоследних.Валюта
		|ГДЕ
		|	ПользователиВидыЦенОтображаемыеВСправочникеНоменклатуры.Ссылка = &Пользователь
		|
		|УПОРЯДОЧИТЬ ПО
		|	ВидЦены";
		Запрос.УстановитьПараметр("Пользователь", Пользователи.ТекущийПользователь());
		Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
		
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			НоваяСтрока = ЦеныНоменклатуры.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПоказатьОстаткиНоменклатуры(Номенклатура)
	
	ОстаткиНоменклатуры.Очистить();
	
	Если Номенклатура.ЭтоГруппа Тогда
		Возврат;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Склады.Ссылка КАК Склад,
	|	Организации.Ссылка КАК Организация,
	|	ВЫБОР
	|		КОГДА Склады.Код = ""000000017""
	|			ТОГДА 0
	|		КОГДА Склады.Код = ""000000001""
	|			ТОГДА 1
	|		КОГДА Склады.Код = ""000000004""
	|			ТОГДА 2
	|		КОГДА Склады.Код = ""000000005""
	|			ТОГДА 3
	|		КОГДА Склады.Код = ""000000007""
	|			ТОГДА 4
	|		ИНАЧЕ 5
	|	КОНЕЦ КАК Порядок
	|ПОМЕСТИТЬ ВТ_СкладыИОрганизации
	|ИЗ
	|	Справочник.Склады КАК Склады,
	|	Справочник.Организации КАК Организации
	|ГДЕ
	|	(Склады.Код = ""000000017""
	|			ИЛИ Склады.Код = ""000000001""
	|			ИЛИ Склады.Код = ""000000004""
	|			ИЛИ Склады.Код = ""000000005""
	|			ИЛИ Склады.Код = ""000000007"")
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТоварыВРезервеНаСкладахОстатки.Номенклатура КАК Номенклатура,
	|	ТоварыВРезервеНаСкладахОстатки.КоличествоОстаток КАК Резерв,
	|	ТоварыВРезервеНаСкладахОстатки.Организация КАК Организация,
	|	ТоварыВРезервеНаСкладахОстатки.Склад КАК Склад
	|ПОМЕСТИТЬ ВТРезерв
	|ИЗ
	|	РегистрНакопления.ТоварыВРезервеНаСкладах.Остатки(, Номенклатура = &Номенклатура) КАК ТоварыВРезервеНаСкладахОстатки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	МинимальныеОстаткиНоменклатуры.Склад КАК Склад,
	|	МинимальныеОстаткиНоменклатуры.Номенклатура КАК Номенклатура,
	|	МинимальныеОстаткиНоменклатуры.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	|	МИНИМУМ(МинимальныеОстаткиНоменклатуры.Количество) КАК Количество,
	|	МАКСИМУМ(МинимальныеОстаткиНоменклатуры.КоличествоМаксимум) КАК КоличествоМаксимум
	|ПОМЕСТИТЬ ВТ_МинМаксОстаток
	|ИЗ
	|	РегистрСведений.МинимальныеОстаткиНоменклатуры КАК МинимальныеОстаткиНоменклатуры
	|
	|СГРУППИРОВАТЬ ПО
	|	МинимальныеОстаткиНоменклатуры.ХарактеристикаНоменклатуры,
	|	МинимальныеОстаткиНоменклатуры.Номенклатура,
	|	МинимальныеОстаткиНоменклатуры.Склад
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВТ_СкладыИОрганизации.Организация КАК Организация,
	|	ВТ_СкладыИОрганизации.Склад КАК Склад,
	|	&Номенклатура КАК Номенклатура,
	|	ЕСТЬNULL(ТоварыНаСкладахОстатки.ХарактеристикаНоменклатуры, ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)) КАК ХарактеристикаНоменклатуры,
	|	ТоварыНаСкладахОстатки.СерияНоменклатуры КАК СерияНоменклатуры,
	|	ТоварыНаСкладахОстатки.КоличествоОстаток КАК Остаток,
	|	ТоварыНаСкладахОстатки.СуммаОстаток КАК СуммаОстаток,
	|	ВТРезерв.Резерв КАК Резерв,
	|	ТоварыНаСкладахОстатки.КоличествоОстаток - ВТРезерв.Резерв КАК СвободныйОстаток,
	|	НоменклатураСкладскиеЯчейки.Ячейка КАК Ячейка,
	|	ВТ_МинМаксОстаток.Количество КАК МинимальныйОстаток,
	|	ВТ_МинМаксОстаток.КоличествоМаксимум КАК МаксимальныйОстаток,
	|	ВТ_СкладыИОрганизации.Порядок КАК Порядок
	|ИЗ
	|	ВТ_СкладыИОрганизации КАК ВТ_СкладыИОрганизации
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыНаСкладах.Остатки(, Номенклатура = &Номенклатура) КАК ТоварыНаСкладахОстатки
	|			ЛЕВОЕ СОЕДИНЕНИЕ ВТРезерв КАК ВТРезерв
	|			ПО ТоварыНаСкладахОстатки.Организация = ВТРезерв.Организация
	|				И ТоварыНаСкладахОстатки.Склад = ВТРезерв.Склад
	|				И ТоварыНаСкладахОстатки.Номенклатура = ВТРезерв.Номенклатура
	|		ПО ВТ_СкладыИОрганизации.Склад = ТоварыНаСкладахОстатки.Склад
	|			И ВТ_СкладыИОрганизации.Организация = ТоварыНаСкладахОстатки.Организация
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_МинМаксОстаток КАК ВТ_МинМаксОстаток
	|		ПО ВТ_СкладыИОрганизации.Склад = ВТ_МинМаксОстаток.Склад
	|			И (&Номенклатура = ВТ_МинМаксОстаток.Номенклатура)
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура.СкладскиеЯчейки КАК НоменклатураСкладскиеЯчейки
	|		ПО (&Номенклатура = НоменклатураСкладскиеЯчейки.Ссылка)
	|			И ВТ_СкладыИОрганизации.Склад = НоменклатураСкладскиеЯчейки.Склад
	|
	|УПОРЯДОЧИТЬ ПО
	|	Порядок";
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура); 
	
	
	
	//nva+++
	//получим плановые поставки
	ТЗРезультат = Запрос.Выполнить().Выгрузить();
	ТЗРезультат.Колонки.Добавить("СрокПоставки", Новый ОписаниеТипов("Дата", , , Новый КвалификаторыДаты(ЧастиДаты.Дата)));
	ТЗРезультат.Колонки.Добавить("ОжидаемоеКоличество", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2)));
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ОжидаемыеПоставкиТоваров.ЗаказПоставщику.Организация КАК Организация,
	               |	ОжидаемыеПоставкиТоваров.Склад КАК Склад,
	               |	ОжидаемыеПоставкиТоваров.Номенклатура КАК Номенклатура,
	               |	ОжидаемыеПоставкиТоваров.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	               |	НЕОПРЕДЕЛЕНО КАК СерияНоменклатуры,
	               |	0 КАК Остаток,
	               |	0 КАК СуммаОстаток,
	               |	0 КАК Резерв,
	               |	0 КАК СвободныйОстаток,
	               |	ОжидаемыеПоставкиТоваров.ЗаказПоставщику.СрокПоставкиC КАК СрокПоставки,
	               |	ОжидаемыеПоставкиТоваров.ОсталосьПолучить КАК ОжидаемоеКоличество,
	               |	ОжидаемыеПоставкиТоваров.ЗаказПоставщику КАК ЗаказПоставщику
	               |ИЗ
	               |	РегистрСведений.ОжидаемыеПоставкиТоваров КАК ОжидаемыеПоставкиТоваров
	               |ГДЕ
	               |	ОжидаемыеПоставкиТоваров.Номенклатура = &Номенклатура
	               |	И ОжидаемыеПоставкиТоваров.ОсталосьПолучить > 0
	               |	И (ОжидаемыеПоставкиТоваров.Склад.Код = ""000000017""
	               |			ИЛИ ОжидаемыеПоставкиТоваров.Склад.Код = ""000000001""
	               |			ИЛИ ОжидаемыеПоставкиТоваров.Склад.Код = ""000000004""
	               |			ИЛИ ОжидаемыеПоставкиТоваров.Склад.Код = ""000000005""
	               |			ИЛИ ОжидаемыеПоставкиТоваров.Склад.Код = ""000000007"")
	               |	И ОжидаемыеПоставкиТоваров.ЗаказПоставщику.ТекущийСтатус <> ЗНАЧЕНИЕ(Справочник.СтатусыЗаказовПоставщику.Отменен)
	               |	И ОжидаемыеПоставкиТоваров.ЗаказПоставщику.СрокПоставкиC >= &ТекДата
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Организация,
	               |	Склад,
	               |	Номенклатура,
	               |	ХарактеристикаНоменклатуры,
	               |	СрокПоставки";
	
	
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура); 
	Запрос.УстановитьПараметр("ТекДата", НачалоДня(ТекущаяДатаСеанса()));
	
	ТЗРезультатПлановыхПоставок = Запрос.Выполнить().Выгрузить();
	ТЗРезультатПлановыхПоставокТолькоБлижайшиеПоставки = ТЗРезультатПлановыхПоставок.СкопироватьКолонки();
	
	//Оставим только самые ближайшие поставки 
	ПредыдущаяОрганизация = Неопределено;
	ПредыдущийСклад = Неопределено;
	ПредыдущаяНоменклатура = Неопределено;
	ПредыдущаяХарактеристикаНоменклатуры = Неопределено;
	ПредыдущаяСерияНоменклатуры = Неопределено;

	Для Каждого СтрокаТЗ Из ТЗРезультатПлановыхПоставок Цикл
		Если СтрокаТЗ.Организация = ПредыдущаяОрганизация И СтрокаТЗ.Склад = ПредыдущийСклад И СтрокаТЗ.Номенклатура = ПредыдущаяНоменклатура 
			И СтрокаТЗ.ХарактеристикаНоменклатуры = ПредыдущаяХарактеристикаНоменклатуры И СтрокаТЗ.СерияНоменклатуры = ПредыдущаяСерияНоменклатуры Тогда
			Продолжить;
		КонецЕсли; 
		НайденныеСтроки = ТЗРезультат.НайтиСтроки(Новый Структура("Организация, Склад, Номенклатура, ХарактеристикаНоменклатуры",СтрокаТЗ.Организация, СтрокаТЗ.Склад, СтрокаТЗ.Номенклатура, СтрокаТЗ.ХарактеристикаНоменклатуры));
		Если НайденныеСтроки.Количество() > 0 Тогда
			Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
				ЗаполнитьЗначенияСвойств(НайденнаяСтрока, СтрокаТЗ, "СрокПоставки, ОжидаемоеКоличество");
			КонецЦикла;
		Иначе
			Если ЗначениеЗаполнено(СтрокаТЗ.СрокПоставки) И ЗначениеЗаполнено(СтрокаТЗ.ОжидаемоеКоличество) Тогда 
				ЗаполнитьЗначенияСвойств(ТЗРезультат.Добавить(), СтрокаТЗ);
			КонецЕсли;	
		КонецЕсли;	
		//ЗаполнитьЗначенияСвойств(ТЗРезультатПлановыхПоставокТолькоБлижайшиеПоставки.Добавить(), СтрокаТЗ);
		ПредыдущаяОрганизация = СтрокаТЗ.Организация;
		ПредыдущийСклад = СтрокаТЗ.Склад;
		ПредыдущаяНоменклатура = СтрокаТЗ.Номенклатура;
		ПредыдущаяХарактеристикаНоменклатуры = СтрокаТЗ.ХарактеристикаНоменклатуры;
		ПредыдущаяСерияНоменклатуры = СтрокаТЗ.СерияНоменклатуры;
	КонецЦикла;
	
	//ОбщегоНазначенияКлиентСервер.ДополнитьТаблицу(ТЗРезультатПлановыхПоставокТолькоБлижайшиеПоставки, ТЗРезультат);
	//
	//ТЗРезультат.Свернуть(Организация, Склад, Номенклатура,  ХарактеристикаНоменклатуры, СерияНоменклатуры
	
	ОстаткиНоменклатуры.Загрузить(ТЗРезультат);
	
КонецПроцедуры

