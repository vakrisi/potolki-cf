&НаСервере
Процедура СохранитьНастройкиФормыНаСервере()
	
	НастройкиФормы = НастройкиФормы();
	ОбщегоНазначения.ХранилищеОбщихНастроекСохранить(КодФормы, "", НастройкиФормы);
	
КонецПроцедуры

&НаСервере
Функция НастройкиФормы()
	
	НастройкиФормы = Новый Структура;	
	НастройкиФормы.Вставить("ПоказыватьОстатки", ПоказыватьОстатки);	
	Возврат НастройкиФормы;
	
КонецФункции

&НаСервере
Процедура УстановитьЗначенияПоНастройкамФормы();
	// Если есть сохраненные настройки, то установить значения по настройкам.
	Настройки = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить(КодФормы,  "");
	
	Если Настройки <> Неопределено Тогда
		
		Если Настройки.Свойство("ПоказыватьОстатки") Тогда
			ПоказыватьОстатки = Настройки.ПоказыватьОстатки;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказыватьОстатки(Команда)
	
	ПоказыватьОстатки = НЕ ПоказыватьОстатки;
	Элементы.ПоказыватьОстатки.Пометка = ПоказыватьОстатки;
	Элементы.ОстаткиНоменклатуры.Видимость = ПоказыватьОстатки;
	
	ТекущиеДанные = Элементы.Список.ТекущиеДанные;
	Если ПоказыватьОстатки И НЕ ТекущиеДанные = Неопределено Тогда 
		ПоказатьОстаткиНоменклатуры(ТекущиеДанные.Ссылка);			
	КонецЕсли;
	
КонецПроцедуры

