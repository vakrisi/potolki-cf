КонецПроцедуры

&НаКлиенте
Процедура ОбработчикОжиданияФайлыПриАктивизацииСтроки()
	
	ТекущиеДанные = Элементы.Список.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;	
	ИзображениеСтруктура = ПоместитьДанныеВХранилище(ТекущиеДанные);
	Если ИзображениеСтруктура.ЕстьИзображение Тогда
		ОбщийМодульКлиент.ПредпросмотрФайла(ИзображениеСтруктура.Хранилище, ИзображениеСтруктура.Расширение, Предпросмотр, Элементы.Предпросмотр);
	Иначе	
		Предпросмотр = "";
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПоместитьДанныеВХранилище(ТекущиеДанные)
	
	Данные = новый Структура();
	Данные.Вставить("ЕстьИзображение", (НЕ ТекущиеДанные.Ссылка.ФайлКартинки.ФайлХранилище.Получить() = Неопределено));
	Данные.Вставить("Хранилище", ПоместитьВоВременноеХранилище(ТекущиеДанные.Ссылка.ФайлКартинки.ФайлХранилище.Получить(), ЭтаФорма.УникальныйИдентификатор));
	Данные.Вставить("Расширение", ТекущиеДанные.Ссылка.ФайлКартинки.Расширение);
	
	Возврат Данные;
	
КонецФункции
