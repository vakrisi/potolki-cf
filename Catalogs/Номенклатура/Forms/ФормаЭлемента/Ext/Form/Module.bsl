&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	УстановитьУсловноеОформление();
	
	УправлениеФормой();
	
	//++ №9160
	ОбновитьСписокИзображений();
	Если ЗначениеЗаполнено(Объект.ФайлКартинки) И СписокИзображений.НайтиПоЗначению(Объект.ФайлКартинки) = Неопределено Тогда
		// в текущем изображении - изображение не от данной номенклатуры
		Объект.ФайлКартинки = ПредопределенноеЗначение("Справочник.НоменклатураПрисоединенныеФайлы.ПустаяСсылка");
		Модифицированность = Истина;
	КонецЕсли;
	ТекущееИзображение = Объект.ФайлКартинки;
	ОбновитьНадписьТекущегоИзображения();
	//-- №9160
	
	// №7722 изображение теперь хранится в справочнике
	//ТекОб = РеквизитФормыВЗначение("Объект");
	//Фото = ПоместитьВоВременноеХранилище(ТекОб.Фото.Получить(),УникальныйИдентификатор);
	Если НЕ Объект.ФайлКартинки.Пустая() Тогда
		
		Фото = ПоместитьВоВременноеХранилище(Объект.ФайлКартинки.ФайлХранилище.Получить(), УникальныйИдентификатор);
		
	КонецЕсли;
	
	СтараяПлощадьПотолка = Объект.Потолок_КоличествоПродукция;
	
	// СтандартныеПодсистемы.Свойства
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ИмяЭлементаДляРазмещения", "ГруппаДополнительныеРеквизиты");
	ДополнительныеПараметры.Вставить("ОтложеннаяИнициализация", Истина);
	УправлениеСвойствами.ПриСозданииНаСервере(ЭтотОбъект, ДополнительныеПараметры);
	// Конец СтандартныеПодсистемы.Свойства
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	КонтрольЗаполненияРеквизитов.ПриСозданииНаСервере(ЭтотОбъект, Объект);
	
	Элементы.СтраницаКратность.Видимость = ПолучитьФункциональнуюОпцию("ИспользоватьКонтрольКратностиЕдиницИзмерения");
	
	Файлы.Параметры.УстановитьЗначениеПараметра("ВладелецФайла", Объект.Ссылка);
	
	ОбновитьВычисляемыеПоляПараметровПродукцииСервер(); 
	
	//nva+++
	НаборРГМинимальныеОстатки = ДанныеФормыВЗначение(МинимальныеОстатки, Тип("РегистрСведенийНаборЗаписей.МинимальныеОстаткиНоменклатуры"));
    НаборРГМинимальныеОстатки.Отбор.Номенклатура.Использование = Истина;
    НаборРГМинимальныеОстатки.Отбор.Номенклатура.ВидСравнения = ВидСравнения.Равно;
    НаборРГМинимальныеОстатки.Отбор.Номенклатура.Значение = Объект.Ссылка;
    НаборРГМинимальныеОстатки.Прочитать();   
    ЗначениеВДанныеФормы(НаборРГМинимальныеОстатки,МинимальныеОстатки);
	//nva---	
	
КонецПроцедуры

