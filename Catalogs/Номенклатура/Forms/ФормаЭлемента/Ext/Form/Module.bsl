&НаСервере
Функция ПолучитьНазваниеМесяца(НомерМесяца) 
	
	Результат = "";
	
	Если НомерМесяца = 1 Тогда
		Результат = "Январь";
	ИначеЕсли НомерМесяца = 2 Тогда
		Результат = "Февраль";
	ИначеЕсли НомерМесяца = 3 Тогда
		Результат = "Март";
	ИначеЕсли НомерМесяца = 4 Тогда
		Результат = "Апрель";
	ИначеЕсли НомерМесяца = 5 Тогда
		Результат = "Май";
	ИначеЕсли НомерМесяца = 6 Тогда
		Результат = "Июнь";
	ИначеЕсли НомерМесяца = 7 Тогда
		Результат = "Июль";
	ИначеЕсли НомерМесяца = 8 Тогда
		Результат = "Август";
	ИначеЕсли НомерМесяца = 9 Тогда
		Результат = "Сентябрь";
	ИначеЕсли НомерМесяца = 10 Тогда
		Результат = "Октябрь";
	ИначеЕсли НомерМесяца = 11 Тогда
		Результат = "Ноябрь";
	ИначеЕсли НомерМесяца = 12 Тогда
		Результат = "Декабрь";
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура ПолучитьДанныеПоЗакупкамИПостроитьГрафик()
	
	//Если Элементы.ГруппаДанныеПоЗакупкам.Видимость Тогда
	Если Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.ГруппаЗакупки Тогда
		
		ДокументыЗакупок.Очистить();
		
		//собираем данные
		ТаблицаДанных = Новый ТаблицаЗначений;
		ТаблицаДанных.Колонки.Добавить("Год", Новый ОписаниеТипов("число"));
		ТаблицаДанных.Колонки.Добавить("НомерМесяца", Новый ОписаниеТипов("число"));
		ТаблицаДанных.Колонки.Добавить("КоличествоОборот", Новый ОписаниеТипов("число"));
		ТаблицаДанных.Колонки.Добавить("СуммаОборот", Новый ОписаниеТипов("число"));
		
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЗакупкиОбороты.Регистратор КАК Ссылка,
		|	ЗакупкиОбороты.Контрагент КАК Поставщик,
		|	ЗакупкиОбороты.КоличествоОборот,
		|	ЗакупкиОбороты.СуммаОборот,
		|	ЗакупкиОбороты.Период КАК Дата,
		|	ВЫБОР
		|		КОГДА ЗакупкиОбороты.КоличествоОборот <> 0
		|			ТОГДА ЗакупкиОбороты.СуммаОборот / ЗакупкиОбороты.КоличествоОборот
		|		ИНАЧЕ ЗакупкиОбороты.СуммаОборот
		|	КОНЕЦ КАК Цена
		|ИЗ
		|	РегистрНакопления.Закупки.Обороты(, , Регистратор, 
		|		Номенклатура = &Номенклатура
		//++ №9914
		|		И ВЫБОР
		|			КОГДА &Организация = Значение(Справочник.Организации.ПустаяСсылка)
		|				ТОГДА ИСТИНА
		|			ИНАЧЕ Организация = &Организация
		|		КОНЕЦ
		//-- №9914
		|	) КАК ЗакупкиОбороты
		|
		|УПОРЯДОЧИТЬ ПО
		|	Период УБЫВ";
		Запрос.УстановитьПараметр("Номенклатура",Объект.Ссылка);
		Запрос.УстановитьПараметр("Организация", ОтборОрганизация); //++ №9914
		
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			НоваяСтрока = ДокументыЗакупок.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
			
			НоваяСтрока = ТаблицаДанных.Добавить();
			НоваяСтрока.Год = Год(Выборка.Дата);
			НоваяСтрока.НомерМесяца = Месяц(Выборка.Дата);
			НоваяСтрока.КоличествоОборот = Выборка.КоличествоОборот;
			НоваяСтрока.СуммаОборот = Выборка.СуммаОборот;
		КонецЦикла;
		
		ТаблицаДанных.Свернуть("Год, НомерМесяца","КоличествоОборот, СуммаОборот");
		ТаблицаДанных.Колонки.Добавить("Цена");
		Для Каждого ТекущаяСтрока Из ТаблицаДанных Цикл
			Если НЕ ТекущаяСтрока.КоличествоОборот = 0 Тогда
				ТекущаяСтрока.Цена = Окр(ТекущаяСтрока.СуммаОборот / ТекущаяСтрока.КоличествоОборот,2);
			КонецЕсли;
		КонецЦикла;
		
		//строим диаграмму
		
		Диаграмма = ДиаграммаЗакупочныхЦен;
		Диаграмма.Очистить();
		
		Диаграмма.Обновление = Ложь;
		
		Диаграмма.Рамка = Новый Рамка(ТипРамкиЭлементаУправления.БезРамки, -1);
		Диаграмма.ОтображатьЛегенду = Ложь;
		
		Серия1 = Диаграмма.Серии.Добавить("СредняяЦена");
		Если Выборка.Количество() = 0 Тогда
			Серия1.Цвет = Новый Цвет(192, 192, 192);
			Диаграмма.Точки.Добавить("Январь");
			Диаграмма.Точки.Добавить("Февраль");
			Диаграмма.Точки.Добавить("Март");
			Диаграмма.Точки.Добавить("Апрель");
			Диаграмма.Точки.Добавить("Май");
			Диаграмма.Точки.Добавить("Июнь");
			Диаграмма.Точки.Добавить("Июль");
			Диаграмма.Точки.Добавить("Август");
			Диаграмма.Точки.Добавить("Сентябрь");
			Диаграмма.Точки.Добавить("Октябрь");
			Диаграмма.Точки.Добавить("Ноябрь");
			Диаграмма.Точки.Добавить("Декабрь");
		Иначе
			Диаграмма.ОтображатьЗаголовок = Ложь;
			ВсегоСтрок = ТаблицаДанных.Количество();
			Если ВсегоСтрок > 12 Тогда
				ВсегоСтрок = 12;
			КонецЕсли;
			ТекущаяСтрока = ВсегоСтрок;
			Для НомерСтроки=0 По ВсегоСтрок-1 Цикл
				Точка = Диаграмма.Точки.Добавить(ПолучитьНазваниеМесяца(ТаблицаДанных[ТекущаяСтрока-1].НомерМесяца) + " " +  СтрЗаменить(ТаблицаДанных[ТекущаяСтрока-1].Год,Символ(160),""));
				Диаграмма.УстановитьЗначение(Точка, Серия1,ТаблицаДанных[ТекущаяСтрока-1].Цена,, " ");
				ТекущаяСтрока = ТекущаяСтрока - 1;
			КонецЦикла;
		КонецЕсли;
		Серия1.Маркер = ТипМаркераДиаграммы.Нет;
		
		Диаграмма.Обновление = Истина;
		
	КонецЕсли;
	
КонецПроцедуры

