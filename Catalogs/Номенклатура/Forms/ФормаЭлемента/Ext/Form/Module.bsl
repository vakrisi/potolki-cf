Функция ОбработатьВыборФайлаEasyCeilingНаСервере(СтруктураФайла, СписокДвоичныхДанныхФайлов)
	
	//Об = РеквизитФормыВЗначение("Объект");        	
	Результат = ОбменСEasyCeiling.ПолучитьСтруктуруПотолка(СтруктураФайла, СписокДвоичныхДанныхФайлов, Объект, Ложь);
	Если НЕ Результат = Неопределено Тогда
		//#12982
		//Если Объект.ВидНоменклатуры = Справочники.ВидыНоменклатуры.Потолок Тогда
		//	Объект.Наименование = ОбменСEasyCeiling.ПолучитьНаименованиеПотолка(
		//									Объект.Потолок_НомерРасчета, Объект.Потолок_МатериалЦвет, Объект.Потолок_МатериалМатериал,
		//									?(Объект.Потолок_Фактура.Количество() > 1, Истина, Ложь), 
		//									?(Объект.Потолок_ПлощадьФотопечати > 0, Истина, Ложь),Объект.Потолок_ШиринаПолотна);
		//ИначеЕсли Объект.ВидНоменклатуры = Справочники.ВидыНоменклатуры.Отрез Тогда
		//	Объект.Наименование = ОбменСEasyCeiling.ПолучитьНаименованиеОтреза(Объект.Потолок_НомерРасчета, Объект.Потолок_МатериалЦвет, Объект.Потолок_МатериалМатериал);
		////ИначеЕсли Объект.ВидНоменклатуры = Справочники.ВидыНоменклатуры.ТиповойОтрез Тогда
		////	Объект.Наименование = ОбменСEasyCeiling.ПолучитьНаименованиеТиповогоОтреза(Объект.Потолок_НомерРасчета, Объект.Потолок_МатериалЦвет, Объект.Потолок_МатериалМатериал);
		//КонецЕсли;
		
		Если Объект.Потолок_Фактура.Количество() > 0 Тогда
			ДанныеФактуры = Объект.Потолок_Фактура[0];
			Если Объект.ВидНоменклатуры = Справочники.ВидыНоменклатуры.Потолок Тогда
				Объект.Наименование = ОбменСEasyCeiling.ПолучитьНаименованиеПотолка(
				Объект.Потолок_НомерРасчета, ДанныеФактуры.Фактура_МатериалЦвет, ДанныеФактуры.Фактура_МатериалМатериал,
				?(Объект.Потолок_Фактура.Количество() > 1, Истина, Ложь), 
				?(Объект.Потолок_ПлощадьФотопечати > 0, Истина, Ложь),ДанныеФактуры.Фактура_ШиринаПолотна);
			ИначеЕсли Объект.ВидНоменклатуры = Справочники.ВидыНоменклатуры.Отрез Тогда
				Объект.Наименование = ОбменСEasyCeiling.ПолучитьНаименованиеОтреза(Объект.Потолок_НомерРасчета, ДанныеФактуры.Фактура_МатериалЦвет, ДанныеФактуры.Фактура_МатериалМатериал);
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;	
	//ЗначениеВРеквизитФормы(Об, "Объект");
	Возврат Результат;	
	
КонецФункции

&НаСервере
Функция СодержитсяВСпецификациях()
	Если Объект.Архивная Тогда
		СписокСпецификаций = "";
		ОбъектСохраненный = Объект.Ссылка.ПолучитьОбъект();
		Если НЕ ОбъектСохраненный.Архивная Тогда
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ
			|	СпецификацииСостав.Номенклатура КАК Номенклатура,
			|	СпецификацииСостав.Ссылка.Владелец КАК Владелец,
			|	СпецификацииСостав.Ссылка.ВидСпецификации КАК ВидСпецификации,
			|	СпецификацииСостав.Ссылка.Наименование КАК НаименованиеСпецификации
			|ИЗ
			|	Справочник.Спецификации.Состав КАК СпецификацииСостав
			|ГДЕ
			|	СпецификацииСостав.Номенклатура = &Номенклатура
			|
			|УПОРЯДОЧИТЬ ПО
			|	ВидСпецификации";
			Запрос.УстановитьПараметр("Номенклатура", Объект.Ссылка);
			Выборка = Запрос.Выполнить().Выбрать();
			
			// Формируем список спецификаций
			Пока Выборка.Следующий() Цикл
				СписокСпецификаций = СписокСпецификаций + "- " + Выборка.Владелец + ", " + Выборка.ВидСпецификации + ": " + Выборка.НаименованиеСпецификации + Символы.ПС;
			КонецЦикла;
			СписокСпецификаций = СтрЗаменить(СписокСпецификаций," ", Символы.НПП);
			Возврат СписокСпецификаций; 
		КонецЕсли;	
	КонецЕсли;
КонецФункции	

