&НаСервере
Процедура ОбновитьСписокИзображений()
	
	Запрос = новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СправочникНоменклатураПрисоединенныеФайлы.Ссылка
	|ИЗ
	|	Справочник.НоменклатураПрисоединенныеФайлы КАК СправочникНоменклатураПрисоединенныеФайлы
	|ГДЕ
	|	СправочникНоменклатураПрисоединенныеФайлы.ВладелецФайла = &ВладелецФайла
	|
	|УПОРЯДОЧИТЬ ПО
	|	СправочникНоменклатураПрисоединенныеФайлы.ДатаСоздания";
	Запрос.УстановитьПараметр("ВладелецФайла", Объект.Ссылка);
	
	СписокИзображений.Очистить();
	СписокИзображений.ЗагрузитьЗначения(Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка"));
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьНадписьТекущегоИзображения()
	
	Элементы.ДекорацияИзображение.Заголовок = "";
	Элементы.ОсновноеИзображение.Доступность = Ложь;
	
	Если Не ТекущееИзображение.Пустая() Тогда
		
		Элементы.ДекорацияИзображение.Заголовок = СтрШаблон("%1 (%2 из %3)", ТекущееИзображение.Наименование, СписокИзображений.Индекс(СписокИзображений.НайтиПоЗначению(ТекущееИзображение))+1, СписокИзображений.Количество());
		Фото = ПоместитьВоВременноеХранилище(ТекущееИзображение.ФайлХранилище.Получить(), УникальныйИдентификатор);
		
		ОсновноеИзображение = (ТекущееИзображение = Объект.ФайлКартинки);
		Элементы.ОсновноеИзображение.Доступность = НЕ ОсновноеИзображение;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СледующееИзображение(Команда)
	
	Если НЕ ТекущееИзображение.Пустая() Тогда
		
		НомерТекущего = СписокИзображений.Индекс(СписокИзображений.НайтиПоЗначению(ТекущееИзображение))+1;
		НовыйНомер = Мин(НомерТекущего+1, СписокИзображений.Количество());
		ТекущееИзображение = СписокИзображений.Получить(НовыйНомер-1).Значение;
		
		ОбновитьНадписьТекущегоИзображения();
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПредыдущееИзображение(Команда)
	
	Если НЕ ТекущееИзображение.Пустая() Тогда
		
		НомерТекущего = СписокИзображений.Индекс(СписокИзображений.НайтиПоЗначению(ТекущееИзображение))+1;
		НовыйНомер = Макс(НомерТекущего-1, 1);
		ТекущееИзображение = СписокИзображений.Получить(НовыйНомер-1).Значение;
		
		ОбновитьНадписьТекущегоИзображения();
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОсновноеИзображениеПриИзменении(Элемент)
	
	Если Не ТекущееИзображение.Пустая() Тогда
		Объект.ФайлКартинки = ТекущееИзображение;
		Модифицированность = Истина;
	КонецЕсли;
	
КонецПроцедуры
