&НаСервере
Процедура ОбновитьПараметрыПродукцииНаСервере()
		
	Если Не ЗначениеЗаполнено(Объект.ВидПродукции) Тогда
		Возврат;
	КонецЕсли;
	
	ТекущиеПараметрыПродукции = Объект.ПараметрыПродукции.Выгрузить();
	ТекущийМассивПараметров = ТекущиеПараметрыПродукции.ВыгрузитьКолонку("ПараметрПродукции");
	
	Объект.ПараметрыПродукции.Загрузить(Объект.ВидПродукции.УчитываемыеПараметрыПродукции.Выгрузить());
	ЕстьИзменения = НЕ Объект.ПараметрыПродукции.Количество() = ТекущиеПараметрыПродукции.Количество();
	
	Для каждого СтрокаТЧ из Объект.ПараметрыПродукции Цикл
		СтрокаТЗ = ТекущиеПараметрыПродукции.Найти(СтрокаТЧ.ПараметрПродукции, "ПараметрПродукции");
		Если СтрокаТЗ = Неопределено Тогда
			ЕстьИзменения = Истина;	
		Иначе
			СтрокаТЧ.Значение = СтрокаТЗ.Значение;	
		КонецЕсли;
	КонецЦикла;
	
	Если ЕстьИзменения Тогда
		Модифицированность = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьВычисляемыеПоляПараметровПродукцииСервер()
		
	Для каждого СтрокаТЧ из Объект.ПараметрыПродукции Цикл
		КЧ = СтрокаТЧ.ПараметрПродукции.ТипЗначения.КвалификаторыЧисла;
		Если КЧ.Разрядность > 0 Тогда
			СтрокаТЧ.Точность = КЧ.РазрядностьДробнойЧасти;
		Иначе
			СтрокаТЧ.Точность = -1;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

