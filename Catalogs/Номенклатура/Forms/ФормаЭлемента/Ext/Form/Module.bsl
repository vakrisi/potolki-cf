&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	//++ Латыпов Р.Р. 2023-03-13  №14456
	// проверка номенклатуры на значение реквизита "Архивная"
	СписокСпецификаций = СодержитсяВСпецификациях();
	Если СписокСпецификаций <> "" И СписокСпецификаций <> Неопределено Тогда // Требуется разрешение на запись
		// Проверка разрешения на запись
		Если НЕ ПараметрыЗаписи.Свойство("ОтказЗаписи") Тогда
			ДиалогСВопросом("ВНИМАНИЕ!" + Символы.ПС +  "Данная номенклатура используется в следующих спецификациях:" + Символы.ПС + Символы.ПС + СписокСпецификаций + Символы.ПС);
			Отказ=Истина; // Отказ, так как запись не подверждена
		Иначе 
			Отказ=ПараметрыЗаписи.ОтказЗаписи; // Устанавливаем статус записи
		КонецЕсли;
	КонецЕсли;
	//-- Латыпов Р.Р. 2023-03-13  №14456
	
	//nva+++
	МассивСкладов = Новый Массив;
	Если НЕ Отказ Тогда
		Для Каждого СтрокаЯчейки Из Объект.СкладскиеЯчейки Цикл
			Если МассивСкладов.Найти(СтрокаЯчейки.Склад) = Неопределено Тогда 
				МассивСкладов.Добавить(СтрокаЯчейки.Склад);
			Иначе
				ОбщегоНазначенияКлиент.СообщитьПользователю("Имеются повторяющиеся склады в ""Складских ячейках""!",Объект.Ссылка,"СкладскиеЯчейки",,Отказ); 
				Прервать;
			КонецЕсли;	
		КонецЦикла;	
	КонецЕсли;
	//nva---
КонецПроцедуры

&НаКлиенте
Процедура ДиалогСВопросом(ТестВопроса)
    Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопроса",ЭтотОбъект); 
    ПоказатьВопрос(Оповещение,ТестВопроса, РежимДиалогаВопрос.ДаНет,0,КодВозвратаДиалога.Да,"Сохранить номенклатуру с признаком АРХИВНЫЙ?");    
КонецПроцедуры
 
&НаКлиенте
Процедура ПослеЗакрытияВопроса(Результат, Параметры) Экспорт
    ПараметрыЗаписи=Новый Структура;
    ПараметрыЗаписи.Вставить("ОтказЗаписи", ?(Результат = КодВозвратаДиалога.Да, Ложь, Истина));
    Записать(ПараметрыЗаписи);
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	// №7722 по новому пишем вырбанную картинку
	Если ЗначениеЗаполнено(ДанныеФайлаКартинки) Тогда
		
		ПрисоединенныйФайл = Справочники.НоменклатураПрисоединенныеФайлы.ПустаяСсылка();
		Если ОбщийМодульВызовСервера.СохранитьПрикрепленныеДанные(Объект.Ссылка, ДанныеФайлаКартинки.ИмяБезРасширения, ДанныеФайлаКартинки.Расширение, ОбщийМодуль.Сериализовать(ПолучитьИзВременногоХранилища(Фото)), новый Структура("НоменклатураПрисоединенныеФайлы", Истина), ПрисоединенныйФайл) Тогда
			ТекущийОбъект.ФайлКартинки = ПрисоединенныйФайл;
		КонецЕсли;
		
		ДанныеФайлаКартинки = Неопределено;
		
		ТекущийОбъект.Записать();
		Прочитать();
		
	КонецЕсли;
	
	Файлы.Параметры.УстановитьЗначениеПараметра("ВладелецФайла", Объект.Ссылка);
	
	УправлениеФормой();
	
	ОбновитьВычисляемыеПоляПараметровПродукцииСервер();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии()
	Если НЕ СтараяПлощадьПотолка = Объект.Потолок_КоличествоПродукция Тогда
		Парам = Новый Структура;
		Парам.Вставить("Номенклатура", Объект.Ссылка);
		Парам.Вставить("НоваяПлощадьПотолка", Объект.Потолок_КоличествоПродукция);
		Оповестить("ИзменениеПлощадиПотолкаВКарточкеНоменклатуры", Парам, "Номенклатура");
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "ИзмениласьОсновнаяСпецификация" и Источник = "СпецификацииНоменклатуры" Тогда
		Прочитать();
		// №7722 назначение основного изображения теперь происходит через оповещение
		// форма, которая оповещает блокирует весь интерфейс, поэтому без проверки на владельца
	ИначеЕсли ИмяСобытия = "УстановкаОсновногоИзображенияТовара" Тогда
		Фото = УстановитьОсновноеИзображениеНоменклатуры(Параметр);
		Модифицированность = Истина;
		
		//++ №9160
		ОбновитьСписокИзображений();
		ОбновитьНадписьТекущегоИзображения();
		//-- №9160
		
	//++ #16971
	ИначеЕсли ИмяСобытия = "Запись_ВидыПродукции" И Источник = Объект.ВидПродукции Тогда
		ОбновитьПараметрыПродукцииКлиент();
	//-- #16971
	
	КонецЕсли;
	
	// СтандартныеПодсистемы.Свойства 
	Если УправлениеСвойствамиКлиент.ОбрабатыватьОповещения(ЭтотОбъект, ИмяСобытия, Параметр) Тогда
		ОбновитьЭлементыДополнительныхРеквизитов();
		УправлениеСвойствамиКлиент.ПослеЗагрузкиДополнительныхРеквизитов(ЭтотОбъект);
	КонецЕсли;
	// Конец СтандартныеПодсистемы.Свойства
	
КонецПроцедуры

#КонецОбласти

