Процедура УстановитьУсловноеОформление()
	
	УсловноеОформление.Элементы.Очистить();
		
	//
	Для Индекс = 0 По 7 Цикл
		Элемент = УсловноеОформление.Элементы.Добавить();
		
		ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
		ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.ПараметрыПродукцииЗначение.Имя);
		
		ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.ПараметрыПродукции.Точность");
		ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		ОтборЭлемента.ПравоеЗначение = Индекс;
		
		Элемент.Оформление.УстановитьЗначениеПараметра("Формат", СтрШаблон("ЧДЦ=%1", Формат(Индекс, "ЧГ=")));		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура УправлениеФормой()
	
	Если Параметры.Ключ.Пустая() Тогда
		Элементы.АльтернативнаяЕдиницаИзмерения.Доступность = Ложь;
	Иначе
		Элементы.АльтернативнаяЕдиницаИзмерения.Доступность = Истина;
	КонецЕсли;	
	
	Если (Объект.ВидНоменклатуры = Справочники.ВидыНоменклатуры.Потолок)
		или (Объект.ВидНоменклатуры = Справочники.ВидыНоменклатуры.Отрез)
		или (Объект.ВидНоменклатуры = Справочники.ВидыНоменклатуры.ТиповойОтрез) Тогда
		Элементы.ГруппаПотолок.Видимость = Истина;
	Иначе
		Элементы.ГруппаПотолок.Видимость = Ложь;
	КонецЕсли;
		
	//данные по закупкам
	ПолучитьДанныеПоЗакупкамИПостроитьГрафик();
	
	Если Константы.ВсяНоменклатураПоУмолчаниюВСреднемЧеке.Получить() Тогда
		Элементы.УчитыватьВСреднемЧеке.Заголовок = "НЕ учитывать в среднем чеке";
	Иначе
		Элементы.УчитыватьВСреднемЧеке.Заголовок = "Учитывать в среднем чеке";
	КонецЕсли;
	
	Если Объект.ДанныеПотолкаИзменены Тогда
		Элементы.ГруппаХарактеристикиПотолка.ТолькоПросмотр = Ложь;
		Элементы.ДанныеПотолкаИзменены.ТолькоПросмотр = Истина;
	Иначе
		Элементы.ГруппаХарактеристикиПотолка.ТолькоПросмотр = Истина;
	КонецЕсли;
	
	Элементы.ГруппаДоходовРасходов.Видимость = ПараметрыСеанса.ФинРезультатНекассовыйМетодВеденияУчетаДоходовРасходов;
	
	// №7722 определенные кнопки для работы с изображениями
	Элементы.ВыбратьИзображениеИзПрикрепленныхФайлов.Видимость = ЗначениеЗаполнено(Объект.Ссылка);
	
	Элементы.ШиринаПолотна.Видимость = (Объект.ВидНоменклатуры = Справочники.ВидыНоменклатуры.Полотно); // №8266
	
	// #6265
	Если Объект.ВидНоменклатуры = Справочники.ВидыНоменклатуры.Продукция Тогда
		Элементы.СтраницаПродукция.Видимость = Истина;
		ЭтоУникальнаяПродукция = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.ВидПродукции, "УникальнаяПродукция");
		//ЭтоУникальнаяПродукция = Неопределено, если   Объект.ВидПродукции - пустой
		Элементы.ГруппаДанныеПродукции.Видимость = (ЭтоУникальнаяПродукция = Истина);
		Элементы.ГруппаПараметрыПродукции.Видимость = (ЭтоУникальнаяПродукция = Ложь);
	Иначе
		Элементы.СтраницаПродукция.Видимость = Ложь;
	КонецЕсли;
	
	// №13889 заголовок вкладки "Потолок"
	Элементы.ГруппаПотолок.Заголовок = ?(Объект.ВидНоменклатуры = Справочники.ВидыНоменклатуры.Отрез, "Отрез", "Потолок");
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьИзПостроителяПослеВыбораФайлов(ВыбранныеФайлы, ДополнительныеПараметры) Экспорт
	
	Если ВыбранныеФайлы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ВыбранныеФайлы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ВыбранноеИмяФайла = ВыбранныеФайлы[0];
	
	//СписокПутейКФайлам = Новый СписокЗначений;
	СписокПутейКФайламКУдалению = Новый СписокЗначений;
	СписокДвоичныхДанныхФайлов = Новый СписокЗначений;
	
	СтруктураФайла = ОбменСПостроителемКлиентСервер.ПрочитатьФайлПостроителя(ВыбранноеИмяФайла);	
	ОбменСПостроителемКлиентСервер.СформироватьСписокПутейКФайлам(СтруктураФайла, СписокПутейКФайламКУдалению, СписокДвоичныхДанныхФайлов);
	
	Если НЕ ОбработатьВыборФайлаEasyCeilingНаСервере(СтруктураФайла, СписокДвоичныхДанныхФайлов) = Неопределено Тогда
		Состояние("Данные загружены");
		Модифицированность = Истина;
	КонецЕсли;
	
КонецПроцедуры

