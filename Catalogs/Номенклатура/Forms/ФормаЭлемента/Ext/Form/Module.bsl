//++ 15627 2023-04-04
&НаКлиенте
Процедура ПрикрепитьФайл(Команда)
	
	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
		ПоказатьПредупреждение(, "Объект не сохранен!");
		Возврат;
	КонецЕсли;
	
	СсылкаНаОбъект = Объект.Ссылка;
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ПослеПрикрепленияФайлаВРегистрЗавершение", ЭтотОбъект);
	ДопПараметры = Новый Структура("ДействиеПослеПрикрепления", ОписаниеОповещения);
	
	ОбщийМодульКлиент.ПослеВыбораСсылкиДляПрикрепленияФайла(СсылкаНаОбъект, ДопПараметры);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеПрикрепленияФайлаВРегистрЗавершение(СтруктураРезультата, ДополнительныеПараметры) Экспорт
	Если СтруктураРезультата.Результат Тогда
		Элементы.Файлы.Обновить();
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФайл(Команда)
	
	ТекущиеДанные = Элементы.Файлы.ТекущиеДанные;
	// Ищем расширение Файла из полного имени файла
	МС = СтрРазделить(ТекущиеДанные.ПолноеИмяФайла, ".", Ложь);
	Расширение = МС[МС.Количество()-1];
	
	Если НЕ ТекущиеДанные = Неопределено Тогда
		АдресФайла = ПолучитьДанные(ТекущиеДанные.СсылкаНаОбъект, ТекущиеДанные.ИмяФайла);
		Если НЕ АдресФайла = Неопределено Тогда // №7253
			ВременноеИмя = ПолучитьИмяВременногоФайла(Расширение);
	    	ПолучитьФайл(АдресФайла, ВременноеИмя, Истина);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

