&НаСервере
Процедура Заполнить_ТабКэшДанных()
    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ
    |   Т.Ссылка КАК Точка,
    |   Т.Тип,
    |   Т.Имя,
    |   Т.Ответственный,
    |   Т.ВариантДлительности,
    |   Т.ДлительностьВыполнения,
    |   Т.Описание,
    |   Т.Ответственный КАК Пояснение
    |ИЗ
    |   Справочник.ИА_БПТочкиМаршрута КАК Т
    |ГДЕ
    |   Т.Владелец = &Владелец";
    Запрос.УстановитьПараметр("Владелец", Объект.Ссылка);
    ТЗ = Запрос.Выполнить().Выгрузить();
    ТабКэшДанных.Загрузить(ТЗ);    
КонецПроцедуры

&НаСервере
Процедура СформироватьКоличествоБП()
    Колво = 0;
	Если НЕ Объект.Ссылка.Пустая() Тогда
    	М = Справочники.ИА_БПКартыМаршрутов.ПолучитьСписокБППоКартеМаршрута(Объект.Ссылка, "Стартован И НЕ Завершен");
        Колво = М.Количество();
    КонецЕсли;
    
    Если Колво = 0 Тогда
    	Элементы.НадписьБП.Заголовок = "Выполняемых процессов нет";
    Иначе
        Элементы.НадписьБП.Заголовок = "Выполняемых процессов: " + Колво;
    КонецЕсли; 
    
КонецПроцедуры
 

