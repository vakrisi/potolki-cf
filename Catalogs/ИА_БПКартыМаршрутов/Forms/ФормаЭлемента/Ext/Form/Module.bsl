&НаКлиенте
Процедура УстановитьВидимостьДоступность()
	Элементы.ПолеГрафСхема.ТолькоПросмотр = НЕ РежимРедактирования;
    Элементы.ГруппаНастройкиБлока.Видимость = НЕ РежимРедактирования;
    
    ////ГрафСхема.РежимОтрисовкиСетки = ?(РежимРедактирования
    ////, РежимОтрисовкиСеткиГрафическойСхемы.ШахматнаяСетка
    ////, РежимОтрисовкиСеткиГрафическойСхемы.Точки
    ////);
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьСвязанныеРеквизиты(ИмяЭлемента)
    Если РежимРедактирования Тогда
    	Возврат;
    КонецЕсли;
    АктивныйЭлемент = ИмяЭлемента;
    Ответственный = Неопределено;
	Подсказка = "";
    
    Эл = ГрафСхема.ЭлементыГрафическойСхемы.Найти(АктивныйЭлемент);
    Если Эл = Неопределено
        ИЛИ НЕ ЗначениеЗаполнено(ИмяЭлемента)
        Тогда
    	Возврат;
    КонецЕсли; 
    
    М = ТабКэшДанных.НайтиСтроки(Новый Структура("Имя", ИмяЭлемента));
    Если М.Количество() = 0 Тогда
    	Заполнить_ТабКэшДанных();
        М = ТабКэшДанных.НайтиСтроки(Новый Структура("Имя", ИмяЭлемента));
    КонецЕсли; 
    
    Если М.Количество() > 0 Тогда
    	СтрокаК = М[0];
        ТочкаМаршрута = СтрокаК.Точка;
    //    Ответственный = СтрокаК.Ответственный;        
    //	Подсказка = СтрокаК.Описание;
    КонецЕсли; 
    
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьТочку(ИмяТочки)
    Если Объект.Ссылка.Пустая() ИЛИ Модифицированность Тогда
    	ЭтаФорма.Записать();
    КонецЕсли; 
    
    Если НЕ Объект.Ссылка.Пустая() Тогда
        Точка = ПолучитьТочкуНаСервере(ИмяТочки);
        П = Новый Структура("ТолькоПросмотр, Ключ", ЭтаФорма.ТолькоПросмотр, Точка);
        ОткрытьФорму("Справочник.ИА_БПТочкиМаршрута.ФормаОбъекта", П);
    КонецЕсли; 
КонецПроцедуры

&НаСервере
Функция ПолучитьТочкуНаСервере(ИмяТочки)
    Точка = Справочники.ИА_БПКартыМаршрутов.ПолучитьТочку(Объект.Ссылка, ИмяТочки);
    Возврат Точка;    
КонецФункции
 
&НаСервере
Процедура ЗаполнитьГрафСхему()
    Для каждого Эл Из ГрафСхема.ЭлементыГрафическойСхемы Цикл
        Если ИА_БФКС.РеквизитЕсть(Эл, "Пояснение") Тогда
            М = ТабКэшДанных.НайтиСтроки(Новый Структура("Имя", Эл.Имя) );
            Если М.Количество() > 0 Тогда
                Эл.Пояснение = М[0].Пояснение;
            КонецЕсли; 
        КонецЕсли; 
    КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ОбновлениеГрафСхемыНачать()
    ГрафСхемаКопия = ГрафСхема;
    ГрафСхема = Неопределено;
    ПодключитьОбработчикОжидания("ОбновлениеГрафСхемыЗакончить", 0.1, Истина);
КонецПроцедуры

&НаКлиенте
Процедура ОбновлениеГрафСхемыЗакончить()
    ГрафСхема = ГрафСхемаКопия;
КонецПроцедуры

