Процедура ПройтиПоКартеМаршрутаДоКонцаСРасчетомДат(Точка, ДатаЗапуска, ДатаСтарта, Таб, МассивТочекВЦиклах)
    Если Таб = Неопределено Тогда
        Таб = ИА_БФС.ТЗ_НоваяТаблицаЗначений("Точка, Порядок, ДатаНачала, ДатаОкончания, ВариантДлительности, ДлительностьВыполнения");	
    КонецЕсли;
    
    СтрокаТаб = Таб.Найти(Точка, "Точка");
    
    Если СтрокаТаб <> неопределено Тогда
        // Зашли в точку не в первый раз! 
        Если МассивТочекВЦиклах.Найти(Точка) <> Неопределено Тогда
            // Циклы пропускаем безусловно.
            Возврат;
        КонецЕсли; 
    Иначе
        СтрокаТаб = Таб.Добавить();
        СтрокаТаб.Точка = Точка;
        СтрокаТаб.Порядок = Точка.ПорядокВКарте;
    КонецЕсли; 
    
    Если ИА_БФКС.РеквизитЕсть(Точка, "СтартЧерез") Тогда
        Если ЗначениеЗаполнено(Точка.ВариантДлительности) Тогда
            ДатаНачала = ИА_БПС.ДобавитьКДате(ДатаСтарта, Точка.ВариантДлительности, Точка.СтартЧерез);
            ДатаКонца  = ИА_БПС.ДобавитьКДате(ДатаНачала, Точка.ВариантДлительности, Точка.ДлительностьВыполнения);
        Иначе
            ДатаНачала = НачалоДня(ДатаЗапуска);           
            ДатаКонца  = ДатаНачала;
        КонецЕсли; 
    Иначе
        ДатаНачала = НачалоДня(ДатаЗапуска);
        
        Если ЗначениеЗаполнено(Точка.ВариантДлительности) Тогда
            ДатаКонца = ИА_БПС.ДобавитьКДате(ДатаНачала, Точка.ВариантДлительности, Точка.ДлительностьВыполнения);
        Иначе
            ДатаКонца = ДатаНачала;
        КонецЕсли; 
    КонецЕсли;
    
    Если СтрокаТаб.ДатаОкончания = Неопределено ИЛИ ДатаКонца > СтрокаТаб.ДатаОкончания Тогда
        СтрокаТаб.ДатаНачала = ДатаНачала;
        СтрокаТаб.ВариантДлительности = Точка.ВариантДлительности;
        СтрокаТаб.ДлительностьВыполнения = Точка.ДлительностьВыполнения;
        СтрокаТаб.ДатаОкончания = ДатаКонца;
    КонецЕсли; 
    
    // Обойдем план дальше
    ИсходящиеТочки = Справочники.ИА_БПТочкиМаршрута.ПолучитьИсходящиеТочки(Точка);
    Для каждого СледующаяТочка Из ИсходящиеТочки Цикл
        ПройтиПоКартеМаршрутаДоКонцаСРасчетомДат(СледующаяТочка, СтрокаТаб.ДатаОкончания, ДатаСтарта, Таб, МассивТочекВЦиклах);
    КонецЦикла; 
КонецПроцедуры



