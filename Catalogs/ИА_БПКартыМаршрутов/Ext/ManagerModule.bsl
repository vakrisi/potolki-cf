
Функция ПолучитьКартуМаршрута(КартаМаршрута) Экспорт
    Карта = КартаМаршрута.Карта.Получить();
    Если Карта = Неопределено Тогда
    	Карта = Новый ГрафическаяСхема;
    КонецЕсли;
    ЗаполнитьВКартеСвязанныеДанные(Карта, КартаМаршрута);
    
    Возврат Карта;
КонецФункции

Процедура ЗаполнитьВКартеСвязанныеДанные(Карта, КартаМаршрута) Экспорт
    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ  разрешенные
    |   ИА_БПТочкиМаршрута.Ссылка,
    |   ИА_БПТочкиМаршрута.Имя,
    |   ИА_БПТочкиМаршрута.Ответственный,
    |   ИА_БПТочкиМаршрута.ЭтоУведомление
    |ИЗ
    |   Справочник.ИА_БПТочкиМаршрута КАК ИА_БПТочкиМаршрута
    |ГДЕ
    |   ИА_БПТочкиМаршрута.Владелец = &Владелец
    |   И НЕ ИА_БПТочкиМаршрута.ПометкаУдаления";
    Запрос.УстановитьПараметр("Владелец", КартаМаршрута);
    Результат = Запрос.Выполнить();
    Выборка = Результат.Выбрать();
    
    ЦветУведомлений   = WebЦвета.Льняной;
    ЦветОбычнойЗадачи = Новый Цвет(254, 253, 214);
    
    Пока Выборка.Следующий() Цикл
        Эл = Карта.ЭлементыГрафическойСхемы.Найти(Выборка.Имя);
        Если Эл <> Неопределено Тогда
            Если ИА_БФКС.РеквизитЕсть(Эл, "Пояснение") Тогда
            	Эл.Пояснение = Выборка.Ответственный;
            КонецЕсли; 
            Если ИА_БФКС.РеквизитЕсть(Эл, "ЦветФона") Тогда
                Если Выборка.ЭтоУведомление Тогда
                	Эл.ЦветФона = ЦветУведомлений;
                ИначеЕсли Эл.ЦветФона = WebЦвета.Льняной И НЕ Выборка.ЭтоУведомление Тогда
                    Эл.ЦветФона = ЦветОбычнойЗадачи;
                КонецЕсли; 
            	
            КонецЕсли; 
        КонецЕсли; 
    КонецЦикла;
КонецПроцедуры

Функция ПолучитьТипТочкиПоТипуЭлемента(ЭлементГрафСхемы) Экспорт
    Возврат ИА_Защита_НФ.КМ_ПолучитьТипТочкиПоТипуЭлемента(ЭлементГрафСхемы);
КонецФункции

Функция ПолучитьТочку(Карта, Имя, Тип = Неопределено, Наименование =  Неопределено) Экспорт
    ТолькоПоиск = Тип = Неопределено;
    Запрос = Новый Запрос(
    "ВЫБРАТЬ  разрешенные
    |   ИА_БПТочкиМаршрута.Ссылка
    |ИЗ
    |   Справочник.ИА_БПТочкиМаршрута КАК ИА_БПТочкиМаршрута
    |ГДЕ
    |   ИА_БПТочкиМаршрута.Владелец = &Владелец
    |   И ИА_БПТочкиМаршрута.Имя = &Имя");
    Запрос.УстановитьПараметр("Имя", Имя);
    Запрос.УстановитьПараметр("Владелец", Карта);
    Выборка = Запрос.Выполнить().Выбрать();
    Если Выборка.Следующий() Тогда
        Если ТолькоПоиск Тогда
            Возврат Выборка.Ссылка;
        КонецЕсли; 
        Спр = Выборка.Ссылка.ПолучитьОбъект();    
        Спр.ПометкаУдаления = Ложь;
    ИначеЕсли ТолькоПоиск Тогда
        ВызватьИсключение "Нет точки в системе """ + Карта + """  """ + Имя + """ !!!";
    Иначе
        Спр = Справочники.ИА_БПТочкиМаршрута.СоздатьЭлемент();
        Спр.Владелец        = Карта;
        Спр.Имя             = Имя;
    КонецЕсли; 
    Спр.Тип             = Тип;
    Спр.Наименование    = Наименование;
    
    Спр.ИсходящиеЛинии.Очистить();
    Спр.Записать();
    
    Возврат Спр.Ссылка;
КонецФункции

Функция ПолучитьТочкуСтарта(КартаМаршрута, ТочкаЗапуска = Неопределено, ВызыватьИсключение = Истина) Экспорт
    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ  разрешенные
    |   ИА_БПТочкиМаршрута.Ссылка
    |ИЗ
    |   Справочник.ИА_БПТочкиМаршрута КАК ИА_БПТочкиМаршрута
    |ГДЕ
    |   ИА_БПТочкиМаршрута.Владелец = &Владелец
    |   И ИА_БПТочкиМаршрута.Тип = &Тип
    |   И (&ТочкаЗапуска_НО
    |           ИЛИ ИА_БПТочкиМаршрута.Ссылка = &ТочкаЗапуска)
    |   И НЕ ИА_БПТочкиМаршрута.ПометкаУдаления";
    Запрос.УстановитьПараметр("Владелец", КартаМаршрута);
    Запрос.УстановитьПараметр("Тип", Перечисления.ИА_БПТипыТочекМаршрута.Старт);
    Запрос.УстановитьПараметр("ТочкаЗапуска", ТочкаЗапуска);
    Запрос.УстановитьПараметр("ТочкаЗапуска_НО", НЕ ЗначениеЗаполнено(ТочкаЗапуска));
    Результат = Запрос.Выполнить();
    Выборка = Результат.Выбрать();
    Если Выборка.Количество() = 0 Тогда
        Если ВызыватьИсключение Тогда
            ВызватьИсключение "Нет стартовых точек в """ + КартаМаршрута + " !";
        Иначе
            Возврат Неопределено
        КонецЕсли; 
        
    ИначеЕсли Выборка.Количество() > 1 И НЕ ЗначениеЗаполнено(ТочкаЗапуска) Тогда
        Если ВызыватьИсключение Тогда
            ВызватьИсключение "Стартовых точек " + Выборка.Количество() + " в """ + КартаМаршрута + ", и не передано, с чего начинать !";
        Иначе
            Возврат Неопределено
        КонецЕсли;        
    Иначе
         Выборка.Следующий();
         Возврат Выборка.Ссылка;
    КонецЕсли; 
КонецФункции

Функция РассчитатьПлановыеДатыВыполненияЗадач(Карта, ДатаЗапуска, ТочкаСтарта = Неопределено, НачальнаяТочка = Неопределено) Экспорт
    Если НачальнаяТочка = Неопределено Тогда
    	ТочкаСтарта = Справочники.ИА_БПКартыМаршрутов.ПолучитьТочкуСтарта(Карта, ТочкаСтарта);	
    Иначе
        ТочкаСтарта = НачальнаяТочка;
    КонецЕсли; 
    
    
    МассивТочекВЦиклах  = Справочники.ИА_БПКартыМаршрутов.ПолучитьТочкиЦиклов(Карта);
    
    Таб = Неопределено;
    ПройтиПоКартеМаршрутаДоКонцаСРасчетомДат(ТочкаСтарта
    , НачалоДня(ДатаЗапуска), НачалоДня(ДатаЗапуска), Таб, МассивТочекВЦиклах);
    
    ИА_БФС.ТЗ_УдалитьСтрокиПоУсловию(Таб, "НЕ ЗначениеЗаполнено(СтрокаТЗ.ВариантДлительности)");
    Таб.Сортировать("Порядок, ДатаНачала, ДатаОкончания");
    Возврат Таб;
КонецФункции



Функция ПолучитьТаблицуТочекКарты(КартаМаршрута) Экспорт
    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ  разрешенные *, Ссылка как Точка ИЗ
    |	Справочник.ИА_БПТочкиМаршрута КАК Т
    |ГДЕ
    |	НЕ Т.ПометкаУдаления
    |	И Т.Владелец = &Карта";
    Запрос.УстановитьПараметр("Карта", КартаМаршрута);
    Результат = Запрос.Выполнить().Выгрузить();
    Возврат Результат;
КонецФункции

Функция ПолучитьТочкиЦиклов(КартаМаршрута) Экспорт
    Возврат ИА_Защита_НФ.КМ_ПолучитьТочкиЦиклов(КартаМаршрута);
КонецФункции

Функция ПолучитьСписокБППоКартеМаршрута(КартаМаршрута, УсловиеГде = "") Экспорт
    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ  разрешенные
    |   ИА_БПНоситель.Ссылка
    |ИЗ
    |   БизнесПроцесс.ИА_БПНоситель КАК ИА_БПНоситель
    |ГДЕ
    |   НЕ ИА_БПНоситель.ПометкаУдаления
    |   ";
    
    Если ТипЗнч(КартаМаршрута) = Тип("СправочникСсылка.ИА_БПКартыМаршрутов") Тогда
        Запрос.Текст = Запрос.Текст + " И ИА_БПНоситель.ИА_КартаМаршрутаБП = &Об";
    ИначеЕсли ТипЗнч(КартаМаршрута) = Тип("СправочникСсылка.ИА_БПМаршрутЗадач") Тогда
        Запрос.Текст = Запрос.Текст + " И ИА_БПНоситель.ИА_МаршрутЗадачБП = &Об";
    КонецЕсли; 
    
    Запрос.УстановитьПараметр("Об", КартаМаршрута);
    Если ЗначениеЗаполнено(УсловиеГде) Тогда
    	Запрос.Текст = Запрос.Текст + Символы.ПС + " И ( " + УсловиеГде+ " ) ";
    КонецЕсли; 
    
    Результат = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
    Возврат Результат;
КонецФункции

Процедура ПроизвестиУдалениеНеиспользуемыхТочек(КартаМаршрута = Неопределено, ВыводитьСообщения = Истина) Экспорт
    МассивТочек = ИА_БФС.Запрос_ВыполнитьВТЗ(
    "ВЫБРАТЬ   разрешенные
    |   ИА_БПТочкиМаршрута.Ссылка
    |ИЗ
    |   Справочник.ИА_БПТочкиМаршрута КАК ИА_БПТочкиМаршрута
    |ГДЕ
    |   ИА_БПТочкиМаршрута.ПометкаУдаления
    |   И (&КМ_НО
    |           ИЛИ ИА_БПТочкиМаршрута.Владелец = &КМ)"
    ,Новый Структура("КМ, КМ_НО", КартаМаршрута, НЕ ЗначениеЗаполнено(КартаМаршрута))).ВыгрузитьКолонку("Ссылка");
	
	УстановитьПривилегированныйРежим(истина);
	
    Таб = НайтиПоСсылкам(МассивТочек);
    
    Счетчик = 0;
    Для каждого Точка Из МассивТочек Цикл
    	М = Таб.НайтиСтроки(Новый Структура("Ссылка", Точка));
        Если М.Количество() = 0 Тогда
            Об = Точка.ПолучитьОбъект();
            Об.Удалить();
        	Счетчик = Счетчик + 1;
        КонецЕсли; 
    КонецЦикла; 
	
	УстановитьПривилегированныйРежим(ложь);
	
    Если ВыводитьСообщения Тогда
        ИА_БФКС.СообщениеОбОшибке("Удалено " + Счетчик + " точек."); 	
    КонецЕсли;     
КонецПроцедуры
 

