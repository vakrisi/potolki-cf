&НаКлиенте
Процедура РекламныйИсточник_ЗависитОтЭлектроннойПочтыОтправителяПриИзменении(Элемент)
	УстановитьСпособЗаполненияРекламногоИсточника(Истина, Ложь, Ложь);
КонецПроцедуры

&НаКлиенте
Процедура РекламныйИсточник_СтатичныйПриИзменении(Элемент)
	УстановитьСпособЗаполненияРекламногоИсточника(Ложь, Истина, Ложь);
КонецПроцедуры

&НаКлиенте
Процедура РекламныйИсточник_ПоискПоНаименованиюИзСоответствующегоПоляПисьмаПриИзменении(Элемент)
	УстановитьСпособЗаполненияРекламногоИсточника(Ложь, Ложь, Истина);
КонецПроцедуры

&НаКлиенте
Процедура ЗначениеНаСледующейСтрокеПриИзменении(Элемент)
	
	ТекущиеДанные = Элемент.Родитель.ТекущиеДанные;
	Если ТекущиеДанные.ЗначениеНаСледующейСтроке Тогда
		ТекущиеДанные.ЗначениеНаСледующейНепустойСтроке = Ложь;	
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ЗначениеНаСледующейНепустойСтрокеПриИзменении(Элемент)
	
	ТекущиеДанные = Элемент.Родитель.ТекущиеДанные;
	Если ТекущиеДанные.ЗначениеНаСледующейНепустойСтроке Тогда
		ТекущиеДанные.ЗначениеНаСледующейСтроке = Ложь;	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЭлектронныеАдресаОтправителейПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
		
	УдалитьПодсказкуВводаДляТабличнойЧасти("ЭлектронныеАдресаОтправителей");
		
КонецПроцедуры

&НаКлиенте
Процедура ЭлектронныеАдресаОтправителейПослеУдаления(Элемент)

	ДобавитьПодсказкуВводаДляТабличнойЧасти("ЭлектронныеАдресаОтправителей");
	
КонецПроцедуры

&НаКлиенте
Процедура ТекстПисьмаСЗаявкойПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
		
	УдалитьПодсказкуВводаДляТабличнойЧасти("ТекстПисьмаСЗаявкой");
		
КонецПроцедуры

&НаКлиенте
Процедура ТекстПисьмаСЗаявкойПослеУдаления(Элемент)

	ДобавитьПодсказкуВводаДляТабличнойЧасти("ТекстПисьмаСЗаявкой");
	
КонецПроцедуры

&НаКлиенте
Процедура ТемаПисьмаСЗаявкойПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
		
	УдалитьПодсказкуВводаДляТабличнойЧасти("ТемаПисьмаСЗаявкой");
		
КонецПроцедуры

&НаКлиенте
Процедура ТемаПисьмаСЗаявкойПослеУдаления(Элемент)

	ДобавитьПодсказкуВводаДляТабличнойЧасти("ТемаПисьмаСЗаявкой");
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура УстановитьУсловноеОформление()

	УсловноеОформление.Элементы.Очистить();
	
	//
	Элемент = УсловноеОформление.Элементы.Добавить();

	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.ЭлектронныеАдресаОтправителей.Имя);

	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("Объект.ЭлектронныеАдресаОтправителей.СтрокаПодсказкиВвода");
	ОтборЭлемента.ВидСравнения   = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Истина;

	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", Новый Цвет(153, 153, 153)); // серый
	Элемент.Оформление.УстановитьЗначениеПараметра("Доступность", Ложь);
	
	//
	Элемент = УсловноеОформление.Элементы.Добавить();

	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.ТемаПисьмаСЗаявкой.Имя);

	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("Объект.ТемаПисьмаСЗаявкой.СтрокаПодсказкиВвода");
	ОтборЭлемента.ВидСравнения   = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Истина;

	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", Новый Цвет(153, 153, 153)); // серый
	Элемент.Оформление.УстановитьЗначениеПараметра("Доступность", Ложь);
	
	//
	Элемент = УсловноеОформление.Элементы.Добавить();

	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.ТекстПисьмаСЗаявкой.Имя);

	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("Объект.ТекстПисьмаСЗаявкой.СтрокаПодсказкиВвода");
	ОтборЭлемента.ВидСравнения   = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Истина;

	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", Новый Цвет(153, 153, 153)); // серый
	Элемент.Оформление.УстановитьЗначениеПараметра("Доступность", Ложь);
		
КонецПроцедуры

&НаКлиенте
Процедура УправлениеФормой()
	
	Элементы.ПриоритетТекста.Видимость = Истина; //Объект.АвтоматическиАнализироватьТекстПисьмаСЗаявкой;
	Элементы.ГруппаПравилаРазбораПисьмаСтраницы.Видимость = Истина; //Объект.АвтоматическиАнализироватьТекстПисьмаСЗаявкой;

	Элементы.ГруппаРИПоНаименованиюПоПолюПисьма.Видимость = Ложь;
	Элементы.ГруппаРИПоЭлектроннойПочтеОтправителя.Видимость = Ложь;
	Элементы.ГруппаРИСтатичный.Видимость = Ложь;
	Если Объект.РекламныйИсточник_ЗависитОтЭлектроннойПочтыОтправителя Тогда
		Элементы.ГруппаРИПоЭлектроннойПочтеОтправителя.Видимость = Истина;
	ИначеЕсли Объект.РекламныйИсточник_Статичный Тогда
		Элементы.ГруппаРИСтатичный.Видимость = Истина;
	ИначеЕсли Объект.РекламныйИсточник_ПоискПоНаименованиюИзСоответствующегоПоляПисьма Тогда
		Элементы.ГруппаРИПоНаименованиюПоПолюПисьма.Видимость = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьСпособЗаполненияРекламногоИсточника(Знач РекламныйИсточник_ЗависитОтЭлектроннойПочтыОтправителя = Ложь, Знач РекламныйИсточник_Статичный = Ложь, Знач РекламныйИсточник_ПоискПоНаименованиюИзСоответствующегоПоляПисьма = Ложь)
	
	Если НЕ РекламныйИсточник_ЗависитОтЭлектроннойПочтыОтправителя
		И НЕ РекламныйИсточник_Статичный
		И НЕ РекламныйИсточник_ПоискПоНаименованиюИзСоответствующегоПоляПисьма
	Тогда
		Объект.РекламныйИсточник_ЗависитОтЭлектроннойПочтыОтправителя = Ложь;
		Объект.РекламныйИсточник_Статичный = Ложь;
		Объект.РекламныйИсточник_ПоискПоНаименованиюИзСоответствующегоПоляПисьма = Истина;
	ИначеЕсли РекламныйИсточник_ЗависитОтЭлектроннойПочтыОтправителя Тогда
		Объект.РекламныйИсточник_ЗависитОтЭлектроннойПочтыОтправителя = Истина;
		Объект.РекламныйИсточник_Статичный = Ложь;
		Объект.РекламныйИсточник_ПоискПоНаименованиюИзСоответствующегоПоляПисьма = Ложь;
	ИначеЕсли  РекламныйИсточник_Статичный Тогда
		Объект.РекламныйИсточник_ЗависитОтЭлектроннойПочтыОтправителя = Ложь;
		Объект.РекламныйИсточник_Статичный = Истина;
		Объект.РекламныйИсточник_ПоискПоНаименованиюИзСоответствующегоПоляПисьма = Ложь;
	ИначеЕсли  РекламныйИсточник_ПоискПоНаименованиюИзСоответствующегоПоляПисьма Тогда
		Объект.РекламныйИсточник_ЗависитОтЭлектроннойПочтыОтправителя = Ложь;
		Объект.РекламныйИсточник_Статичный = Ложь;
		Объект.РекламныйИсточник_ПоискПоНаименованиюИзСоответствующегоПоляПисьма = Истина;
	КонецЕсли;
	
	УправлениеФормой();
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьПодсказкуВводаДляТабличнойЧасти(ИмяТЧ)
	
	Если ИмяТЧ = "ЭлектронныеАдресаОтправителей" Тогда
		ИмяРеквизита = "ЭлектроннаяПочтаОтправителя";
		ТекстПодсказки = "Все получатели";
	ИначеЕсли ИмяТЧ = "ТемаПисьмаСЗаявкой" Тогда
		ИмяРеквизита = "Текст";
		ТекстПодсказки = "Любая тема письма";
	ИначеЕсли ИмяТЧ = "ТекстПисьмаСЗаявкой" Тогда
		ИмяРеквизита = "Текст";
		ТекстПодсказки = "Любой текст письма";
	КонецЕсли;
	
	Если Объект[ИмяТЧ].Количество() = 0 Тогда
		НоваяСтрока = Объект[ИмяТЧ].Добавить();	
		НоваяСтрока[ИмяРеквизита] = ТекстПодсказки;
		НоваяСтрока.СтрокаПодсказкиВвода = Истина;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура УдалитьПодсказкуВводаДляТабличнойЧасти(ИмяТЧ)
	
	Если Объект[ИмяТЧ].Количество() > 0 Тогда
		Если Объект[ИмяТЧ][0].СтрокаПодсказкиВвода Тогда
			Объект[ИмяТЧ].Удалить(0);
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти


