			<Title>
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Список номенклатуры</v8:content>
				</v8:item>
			</Title>
			<Type>
				<v8:Type>cfg:DynamicList</v8:Type>
			</Type>
			<Settings xsi:type="DynamicList">
				<ManualQuery>true</ManualQuery>
				<DynamicDataRead>true</DynamicDataRead>
				<QueryText>ВЫБРАТЬ
	Номенклатура.Ссылка КАК Номенклатура
ИЗ
	Справочник.Номенклатура КАК Номенклатура
ГДЕ
	ВЫБОР
			КОГДА &amp;Фактура &lt;&gt; ЗНАЧЕНИЕ(Справочник.Фактура.ПустаяСсылка)
				ТОГДА Номенклатура.Ссылка В
						(ВЫБРАТЬ РАЗЛИЧНЫЕ
							ЦветФактуры.УслугаУстановкиПотолка КАК Номенклатура
						ИЗ
							Справочник.ЦветФактуры КАК ЦветФактуры
						ГДЕ
							ЦветФактуры.Владелец = &amp;Фактура
							И ВЫБОР
								КОГДА &amp;Цвет &lt;&gt; ЗНАЧЕНИЕ(Справочник.ЦветФактуры.ПустаяСсылка)
									ТОГДА ЦветФактуры.Ссылка = &amp;Цвет
								ИНАЧЕ ИСТИНА
							КОНЕЦ
							И НЕ ЦветФактуры.УслугаУстановкиПотолка = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
		
						ОБЪЕДИНИТЬ
		
						ВЫБРАТЬ РАЗЛИЧНЫЕ
							НоменклатураСФактурой.Ссылка КАК Номенклатура
						ИЗ
							Справочник.Номенклатура.Потолок_Фактура КАК НоменклатураСФактурой
						ГДЕ
							НоменклатураСФактурой.ПродукцияФактура = &amp;Фактура
							И ВЫБОР
								КОГДА &amp;Цвет &lt;&gt; ЗНАЧЕНИЕ(Справочник.ЦветФактуры.ПустаяСсылка)
									ТОГДА НоменклатураСФактурой.ПродукцияЦвет = &amp;Цвет
								ИНАЧЕ ИСТИНА
							КОНЕЦ)
			ИНАЧЕ ИСТИНА
		КОНЕЦ
	И Номенклатура.УчитыватьКакПотолокВОтчетахПоЭффективности</QueryText>
				<MainTable>Catalog.Номенклатура</MainTable>
				<ListSettings>
					<dcsset:filter>
						<dcsset:viewMode>Normal</dcsset:viewMode>
					</dcsset:filter>
					<dcsset:order>
						<dcsset:viewMode>Normal</dcsset:viewMode>
						<dcsset:userSettingID>88619765-ccb3-46c6-ac52-38e9c992ebd4</dcsset:userSettingID>
					</dcsset:order>
					<dcsset:conditionalAppearance>
						<dcsset:viewMode>Normal</dcsset:viewMode>
						<dcsset:userSettingID>b75fecce-942b-4aed-abc9-e6a02e460fb3</dcsset:userSettingID>
					</dcsset:conditionalAppearance>
					<dcsset:itemsViewMode>Normal</dcsset:itemsViewMode>
					<dcsset:itemsUserSettingID>911b6018-f537-43e8-a417-da56b22f9aec</dcsset:itemsUserSettingID>
				</ListSettings>
			</Settings>
