
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ИмяЭтапа = Параметры.ИмяЭтапа;
	
	Имя = Константы.ЗадатьВопросИмя.Получить();
	Город = Константы.ЗадатьВопросГород.Получить();
	Скайп = Константы.ЗадатьВопросСкайп.Получить();
	НазваниеКомпании = Константы.ЗадатьВопросНазваниеКомпании.Получить();
	
	Если СтрНайти(Параметры.ИмяЭлемента, "ПРОИЗВОДСТВО") > 0 Тогда
		ВопросПоПроизводству = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьСостояниеЭтапов()
	
	МассивРезультата = Новый Массив;
	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЭтапыВнедрения.Наименование,
	|	ЭтапыВнедрения.Выполнен,
	|	ЭтапыВнедрения.ИмяПредопределенныхДанных КАК ИмяПредопределенныхДанных
	|ИЗ
	|	Справочник.ЭтапыВнедрения КАК ЭтапыВнедрения
	|
	|УПОРЯДОЧИТЬ ПО
	|	Наименование";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если ВопросПоПроизводству Тогда
			Если СтрНайти(Выборка.ИмяПредопределенныхДанных, "ПРОИЗВОДСТВО") > 0 Тогда
				СтруктураЭтапа = Новый Структура;
				СтруктураЭтапа.Вставить("Этап", Выборка.Наименование);
				СтруктураЭтапа.Вставить("Выполнен", Выборка.Выполнен);
				
				МассивРезультата.Добавить(СтруктураЭтапа);
			КонецЕсли;
		Иначе
			Если СтрНайти(Выборка.ИмяПредопределенныхДанных, "ПРОИЗВОДСТВО") = 0 Тогда
				СтруктураЭтапа = Новый Структура;
				СтруктураЭтапа.Вставить("Этап", Выборка.Наименование);
				СтруктураЭтапа.Вставить("Выполнен", Выборка.Выполнен);
				
				МассивРезультата.Добавить(СтруктураЭтапа);
			КонецЕсли;
		КонецЕсли;	
	КонецЦикла;
	
	Возврат МассивРезультата;
	
КонецФункции

&НаКлиенте
Процедура Отправить(Команда)
	
	Если ПустаяСтрока(Вопрос) Тогда
		ПоказатьПредупреждение(,"Не указан текст вопроса");
		Возврат;
	КонецЕсли;
	Если ПустаяСтрока(Имя) Тогда
		ПоказатьПредупреждение(,"Пожалуйста, укажите Ваше имя");
		Возврат;
	КонецЕсли;
	Если ПустаяСтрока(Скайп) Тогда
		ПоказатьПредупреждение(,"Пожалуйста, укажите Ваш Skype");
		Возврат;
	КонецЕсли;
	Если ПустаяСтрока(Город) Тогда
		ПоказатьПредупреждение(,"Пожалуйста, укажите Ваш город");
		Возврат;
	КонецЕсли;
	Если ПустаяСтрока(НазваниеКомпании) Тогда
		ПоказатьПредупреждение(,"Пожалуйста, укажите название Вашей компании");
		Возврат;
	КонецЕсли;
	
	СохранитьПараметрыВопроса();
	
	МассивДляЗаписи = Новый Массив;
	СтруктураЗапроса = Новый Структура;
	СтруктураЗапроса.Вставить("Имя",Имя);
	СтруктураЗапроса.Вставить("Скайп",Скайп);
	СтруктураЗапроса.Вставить("Город",Город);
	СтруктураЗапроса.Вставить("НазваниеКомпании",НазваниеКомпании);
	СтруктураЗапроса.Вставить("ИмяЭтапа",ИмяЭтапа);
	СтруктураЗапроса.Вставить("Вопрос",Вопрос);
	
	СтруктураЗапроса.Вставить("СостояниеЭтапов",ПолучитьСостояниеЭтапов());
	
	
	МассивДляЗаписи.Добавить(СтруктураЗапроса);
	
	АдресСервера = "1c.crm-potolki.ru";
	РесурсНаСервере = "/intro_set.php";
	
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	
	ЗаписатьJSON(ЗаписьJSON, МассивДляЗаписи);
	
	СтрокаДляОтвета = ЗаписьJSON.Закрыть();
	
	ФайлСообщения = Новый Файл(ПолучитьИмяВременногоФайла("out"));
	Текст = Новый ТекстовыйДокумент;
	Текст.ДобавитьСтроку(СтрокаДляОтвета);
	Текст.Записать(ФайлСообщения.ПолноеИмя);
	
	ФайлОтвета = Новый Файл(ПолучитьИмяВременногоФайла("in"));
	
	Соединение = Новый HTTPСоединение(АдресСервера);
	
	HTTPЗапрос = Новый HTTPЗапрос(РесурсНаСервере);
	HTTPЗапрос.УстановитьИмяФайлаТела(ФайлСообщения.ПолноеИмя);
	Результат  = Соединение.ОтправитьДляОбработки(HTTPЗапрос, ФайлОтвета.ПолноеИмя);
	Соединение = Неопределено;
	Если Результат.КодСостояния > 299 Тогда
		Возврат;
	КонецЕсли;
	Ответ = Новый ТекстовыйДокумент();
	Ответ.Прочитать(ФайлОтвета.ПолноеИмя, КодировкаТекста.UTF8);
	ТекстОтвета = Ответ.ПолучитьТекст();
	
	Если НЕ СокрЛП(ТекстОтвета) = "ok" Тогда
		ПоказатьПредупреждение(,"Ошибка отправки вопроса. Проверьте наличие соединения с Интернет.");
	Иначе
		ПоказатьПредупреждение(,"Ваш вопрос отправлен в службу внедрения. Мы свяжемся с Вами в ближайшее время.");
	КонецЕсли;
	
	ЭтаФорма.Закрыть();
	
КонецПроцедуры

&НаСервере
Процедура СохранитьПараметрыВопроса()
	
	Константы.ЗадатьВопросИмя.Установить(Имя);
	Константы.ЗадатьВопросГород.Установить(Город);
	Константы.ЗадатьВопросСкайп.Установить(Скайп);
	Константы.ЗадатьВопросНазваниеКомпании.Установить(НазваниеКомпании);
	
КонецПроцедуры
