&НаСервере
Функция ПолучитьИмяЭлементаСпарвочникаПоИмениЭлементаФормы(ИмяЭлементаФормы)
	
	//ПРОИЗВОДСТВО
	Если ИмяЭлементаФормы = "Декорация2" Тогда Возврат "ПРОИЗВОДСТВО_ПросмотрСтартовогоВидео";
	ИначеЕсли ИмяЭлементаФормы = "Декорация4" Тогда Возврат "ПРОИЗВОДСТВО_СозданиеУчетныхЗаписей";
	ИначеЕсли ИмяЭлементаФормы = "Декорация6" Тогда Возврат "ПРОИЗВОДСТВО_СозданиеНоменклатуры";
	ИначеЕсли ИмяЭлементаФормы = "Декорация8" Тогда Возврат "ПРОИЗВОДСТВО_ЗагрузкаФактурыИзПостроителя";
	ИначеЕсли ИмяЭлементаФормы = "Декорация10" Тогда Возврат "ПРОИЗВОДСТВО_СозданиеИНазначениеЦенНоменклатуры";
	ИначеЕсли ИмяЭлементаФормы = "Декорация12" Тогда Возврат "ПРОИЗВОДСТВО_УстановкаЦенМатериаловДляРасчетаСтоимостиПотолка";
	ИначеЕсли ИмяЭлементаФормы = "Декорация14" Тогда Возврат "ПРОИЗВОДСТВО_УстановкаЦенНаУслугиПроизводства";
	ИначеЕсли ИмяЭлементаФормы = "Декорация16" Тогда Возврат "ПРОИЗВОДСТВО_АудитБизнесПроцессовВыборВариантаУчета";
	ИначеЕсли ИмяЭлементаФормы = "Декорация18" Тогда Возврат "ПРОИЗВОДСТВО_ТестоваяЗагрузкаПотолков";
	ИначеЕсли ИмяЭлементаФормы = "Декорация20" Тогда Возврат "ПРОИЗВОДСТВО_ОчисткаБазыОтТестовыхДокументов";
	ИначеЕсли ИмяЭлементаФормы = "Декорация22" Тогда Возврат "ПРОИЗВОДСТВО_ВводНачальныхОстатковПоСкладу";
	ИначеЕсли ИмяЭлементаФормы = "Декорация24" Тогда Возврат "ПРОИЗВОДСТВО_ВводНачальныхВзаиморасчетовСКонтрагентами";
	ИначеЕсли ИмяЭлементаФормы = "Декорация26" Тогда Возврат "ПРОИЗВОДСТВО_ВводНачальныхОстатковПоКассе";
	ИначеЕсли ИмяЭлементаФормы = "Декорация28" Тогда Возврат "ПРОИЗВОДСТВО_НачалоРаботы";
	ИначеЕсли ИмяЭлементаФормы = "Декорация94" Тогда Возврат "ПРОИЗВОДСТВО_ПерезаказОтреза";
	ИначеЕсли ИмяЭлементаФормы = "Декорация96" Тогда Возврат "ПРОИЗВОДСТВО_ПерезаказПотолка";
	ИначеЕсли ИмяЭлементаФормы = "Декорация98" Тогда Возврат "ПРОИЗВОДСТВО_Перераскрой";
	ИначеЕсли ИмяЭлементаФормы = "Декорация100" Тогда Возврат "ПРОИЗВОДСТВО_ИзменениеФактурыИлиПотолка";
	ИначеЕсли ИмяЭлементаФормы = "Декорация102" Тогда Возврат "ПРОИЗВОДСТВО_ВозвратПродукции";
	ИначеЕсли ИмяЭлементаФормы = "Декорация104" Тогда Возврат "ПРОИЗВОДСТВО_ВозвратТовараПокупателем";
	ИначеЕсли ИмяЭлементаФормы = "Декорация106" Тогда Возврат "ПРОИЗВОДСТВО_ОбучениеСотрудников";
		
	ИначеЕсли ИмяЭлементаФормы = "Декорация110" Тогда Возврат "ПРОИЗВОДСТВО_СозданиеКонтрагентов";
	ИначеЕсли ИмяЭлементаФормы = "Декорация112" Тогда Возврат "ПРОИЗВОДСТВО_НастройкаПравПользователей";
	//РОЗНИЦА
	ИначеЕсли ИмяЭлементаФормы = "Декорация30" Тогда Возврат "РОЗНИЦА_ПросмотрСтартовогоВидео";
	ИначеЕсли ИмяЭлементаФормы = "Декорация32" Тогда Возврат "РОЗНИЦА_СозданиеУчетныхЗаписей";
	ИначеЕсли ИмяЭлементаФормы = "Декорация34" Тогда Возврат "РОЗНИЦА_СозданиеНоменклатурыДляРозницы";
	ИначеЕсли ИмяЭлементаФормы = "Декорация36" Тогда Возврат "РОЗНИЦА_СозданиеНоменклатурыМатериалов";
	ИначеЕсли ИмяЭлементаФормы = "Декорация38" Тогда Возврат "РОЗНИЦА_ИмпортИлиСозданиеФактур";
	ИначеЕсли ИмяЭлементаФормы = "Декорация40" Тогда Возврат "РОЗНИЦА_СозданиеИУстановкаЦенНоменклатуры";
	ИначеЕсли ИмяЭлементаФормы = "Декорация42" Тогда Возврат "РОЗНИЦА_УстановкаЦенДляРасчетаСтоимостиПотолка";
	ИначеЕсли ИмяЭлементаФормы = "Декорация44" Тогда Возврат "РОЗНИЦА_ОзнакомлениеСВариантомУчетаБизнесПроцессов";
	ИначеЕсли ИмяЭлементаФормы = "Декорация46" Тогда Возврат "РОЗНИЦА_ТестирвоаниеЦепочкиДокументовЛидДоговорМонтаж";
	ИначеЕсли ИмяЭлементаФормы = "Декорация48" Тогда Возврат "РОЗНИЦА_УдалениеТестовыхДокументов";
	ИначеЕсли ИмяЭлементаФормы = "Декорация50" Тогда Возврат "РОЗНИЦА_ВводНачальныхОстатковПоСкладу";
	ИначеЕсли ИмяЭлементаФормы = "Декорация52" Тогда Возврат "РОЗНИЦА_ВводНачальныхВзаиморасчетовСКонтрагентами";
	ИначеЕсли ИмяЭлементаФормы = "Декорация54" Тогда Возврат "РОЗНИЦА_ВводНачальныхОстатковПоКассе";
	ИначеЕсли ИмяЭлементаФормы = "Декорация56" Тогда Возврат "РОЗНИЦА_НачалоРаботы";
	ИначеЕсли ИмяЭлементаФормы = "Декорация58" Тогда Возврат "РОЗНИЦА_СозданиеСпецификацийДляУслуг";
	ИначеЕсли ИмяЭлементаФормы = "Декорация60" Тогда Возврат "РОЗНИЦА_УстановкаМобильногоПриложения";
	ИначеЕсли ИмяЭлементаФормы = "Декорация62" Тогда Возврат "РОЗНИЦА_НастройкаПравПользователей";
	ИначеЕсли ИмяЭлементаФормы = "Декорация108" Тогда Возврат "РОЗНИЦА_ОбучениеСотрудников";
	//НЕИЗВЕСТНЫЙ ЭЛМЕНТ
	Иначе Возврат Неопределено; КонецЕсли;
	
КонецФункции

&НаСервере
Процедура УстановитьЗначениеГалочки(ИмяЭлементаФормы)
	
	ИмяЭлементаСправочника = ПолучитьИмяЭлементаСпарвочникаПоИмениЭлементаФормы(ИмяЭлементаФормы);
	
	Если Справочники.ЭтапыВнедрения[ИмяЭлементаСправочника].Выполнен Тогда
		Элементы[ИмяЭлементаФормы].Картинка = БиблиотекаКартинок.Успешно16;
	Иначе
		Элементы[ИмяЭлементаФормы].Картинка = БиблиотекаКартинок.Пустая;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ИзменитьЗначениеГалочки(ИмяЭлементаФормы)
	
	ИмяЭлементаСправочника = ПолучитьИмяЭлементаСпарвочникаПоИмениЭлементаФормы(ИмяЭлементаФормы);
	
	ЭлОб = Справочники.ЭтапыВнедрения[ИмяЭлементаСправочника].ПолучитьОбъект();
	ЭлОб.Выполнен = НЕ ЭлОб.Выполнен;
	Если ЭлОб.Выполнен Тогда
		ЭлОб.ДатаВыполнения = ТекущаяДатаСеанса();
		ЭлОб.КтоВыполнил = Пользователи.ТекущийПользователь();
	КонецЕсли;
	ЭлОб.Записать();
	УстановитьЗначениеГалочки(ИмяЭлементаФормы);
	
	ОбновитьДоступнстьГалочек();
	
КонецПроцедуры

&НаКлиенте
Процедура ПерейтиКПроизводству(Команда)
	Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.ГруппаПроизводство;
КонецПроцедуры

&НаКлиенте
Процедура ПерейтиКРознице(Команда)
	Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.ГруппаРозница;
КонецПроцедуры

&НаСервере
Процедура ОбновитьДоступнстьГалочек()
	
	//производство
	НомерПервойГалочки = 0;
	ТекущаяГалочка = 0;
	Для Каждого ТекГалочка Из ГалочкиПроизводства Цикл
		//определяем доступность по значению реквизита элемента справочника
		Если ТекущаяГалочка = НомерПервойГалочки Тогда
			//первая доступна всегда
			ТекГалочка.Доступность = Истина;
		Иначе
			Если Справочники.ЭтапыВнедрения[ПолучитьИмяЭлементаСпарвочникаПоИмениЭлементаФормы(ГалочкиПроизводства[ТекущаяГалочка-1].Галочка)].Выполнен Тогда
				ТекГалочка.Доступность = Истина;
			Иначе
				ТекГалочка.Доступность = Ложь;
			КонецЕсли;
		КонецЕсли;
		ТекущаяГалочка = ТекущаяГалочка + 1;
		
		//делаем доступными элементы формы
		Элементы[ТекГалочка.Галочка].Доступность = ТекГалочка.Доступность;
		Элементы[ТекГалочка.Надпись].Доступность = ТекГалочка.Доступность;
		//Элементы[ТекГалочка.КнопкаВопрос].Доступность = ТекГалочка.Доступность;
	КонецЦикла;
	
	//розница
	НомерПервойГалочки = 0;
	ТекущаяГалочка = 0;
	Для Каждого ТекГалочка Из ГалочкиРозницы Цикл
		//определяем доступность по значению реквизита элемента справочника
		Если ТекущаяГалочка = НомерПервойГалочки Тогда
			//первая доступна всегда
			ТекГалочка.Доступность = Истина;
		Иначе
			Если Справочники.ЭтапыВнедрения[ПолучитьИмяЭлементаСпарвочникаПоИмениЭлементаФормы(ГалочкиРозницы[ТекущаяГалочка-1].Галочка)].Выполнен Тогда
				ТекГалочка.Доступность = Истина;
			Иначе
				ТекГалочка.Доступность = Ложь;
			КонецЕсли;
		КонецЕсли;
		ТекущаяГалочка = ТекущаяГалочка + 1;
		
		//делаем доступными элементы формы
		Элементы[ТекГалочка.Галочка].Доступность = ТекГалочка.Доступность;
		Элементы[ТекГалочка.Надпись].Доступность = ТекГалочка.Доступность;
		//Элементы[ТекГалочка.КнопкаВопрос].Доступность = ТекГалочка.Доступность;
	КонецЦикла;
	
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьОписаниеГалочкиПроизводство(ИмяГалочки, ИмяНадписи, Доступно, ИмяКнопкиВопрос = "")
	
	НоваяСтрока = ГалочкиПроизводства.Добавить();
	НоваяСтрока.Галочка = ИмяГалочки;
	НоваяСтрока.Надпись = ИмяНадписи;
	НоваяСтрока.Доступность = Доступно;
	//НоваяСтрока.КнопкаВопрос = ИмяКнопкиВопрос;
	
КонецПроцедуры

