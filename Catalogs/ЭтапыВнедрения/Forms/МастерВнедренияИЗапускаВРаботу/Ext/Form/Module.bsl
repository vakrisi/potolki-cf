&НаСервере
Функция ПолучитьИмяГалочкиПоИмениКнопкиВопрос(ИмяКнопкиВопрос)
	
	Отбор = Новый Структура;
	Отбор.Вставить("КнопкаВопрос", ИмяКнопкиВопрос);
	НайденныеСтроки = ГалочкиПроизводства.НайтиСтроки(Отбор);
	Если НайденныеСтроки.Количество() > 0 Тогда
		Возврат НайденныеСтроки[0].Галочка;
	Иначе
		НайденныеСтроки = ГалочкиРозницы.НайтиСтроки(Отбор);
		Если НайденныеСтроки.Количество() > 0 Тогда
			Возврат НайденныеСтроки[0].Галочка;
		Иначе
			Возврат "";
		КонецЕсли;
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

&НаСервере
Функция ПолучитьНазваниеЭтапаИзПредопределенногоЭлемента(ИмяЭлемента)
	Возврат Справочники.ЭтапыВнедрения[ИмяЭлемента].Наименование;
КонецФункции

&НаКлиенте
Процедура Декорация63Нажатие(Элемент)
	
	СтруктураВопроса = Новый Структура;
	СтруктураВопроса.Вставить("Галочка", ПолучитьИмяГалочкиПоИмениКнопкиВопрос(Элемент.Имя));
	СтруктураВопроса.Вставить("ИмяЭлемента", ПолучитьИмяЭлементаСпарвочникаПоИмениЭлементаФормы(СтруктураВопроса.Галочка));
	СтруктураВопроса.Вставить("ИмяЭтапа", ПолучитьНазваниеЭтапаИзПредопределенногоЭлемента(СтруктураВопроса.ИмяЭлемента));
	ОткрытьФорму("Справочник.ЭтапыВнедрения.Форма.ОтправкаВопросаПоЭтапуВнедрения", СтруктураВопроса);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьЗаметки(Команда)
	
	ОткрытьФорму("Справочник.ЭтапыВнедрения.Форма.ФормаЗаметок",,ЭтаФорма,,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры
