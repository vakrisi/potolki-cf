#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ)	
	
	// проверяем условие уникальности наименования кассы в разрезе Организации
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Кассы.Наименование
	|ИЗ
	|	Справочник.Кассы КАК Кассы
	|ГДЕ
	|	Кассы.Наименование = &КассаНаименование
	|	И Кассы.Владелец =  &КассаВладелец
	|	И Кассы.Ссылка <> &Ссылка";
	Запрос.УстановитьПараметр("КассаНаименование", Наименование);
	Запрос.УстановитьПараметр("КассаВладелец", Владелец);
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Результат = Запрос.Выполнить();
	
	Если НЕ Результат.Пустой() Тогда
	    Сообщить("Касса организации с таким наименованием уже существует. Введите другое наименование кассы!");
		Отказ = Истина;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли

