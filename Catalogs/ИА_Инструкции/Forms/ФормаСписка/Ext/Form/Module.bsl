


&НаКлиенте
Процедура ОтборПоПостуПриИзменении(Элемент)
	Эл = Список.Параметры.Элементы.Найти("Пост");
	Эл.Значение = ОтборПоПосту;
	Эл.Использование = Истина;
	
	Эл = Список.Параметры.Элементы.Найти("НО_Пост");
	Эл.Значение = ОтборПоПосту.Пустая();
	Эл.Использование = Истина;
КонецПроцедуры

