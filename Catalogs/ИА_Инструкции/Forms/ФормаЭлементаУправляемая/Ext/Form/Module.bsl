&НаСервере
Функция СохранитьВХТМЛ(ДДИсхФ,ИмяИсхФ)
	ВременныйКаталог = КаталогВременныхФайлов()+Строка(Новый УникальныйИдентификатор);	
	СоздатьКаталог(ВременныйКаталог);
	ПолныйПутьДокФайл = ВременныйКаталог+"\"+ИмяИсхФ;
	
	ДДИсхФ.Записать(ПолныйПутьДокФайл);
	
	Word = новый COMОбъект("Word.Application");
	Попытка 
		Word.Documents.Add(ПолныйПутьДокФайл);
	Исключение
		Сообщить("Не могу открыть файл "+ПолныйПутьДокФайл);
		Возврат Неопределено;
	КонецПопытки;
	
	Document=Word.ActiveDocument;
	
	wdFormatHTML = 8;
	wdFormatWebArchive = 9;
	wdFormatFilteredHTML = 10;
	Document.SaveAs(ВременныйКаталог+"\"+"data.html", wdFormatFilteredHTML);
	Document.Close(0);
	
	Word.Quit();
	Word = 0;
	
	//рез = новый ДвоичныеДанные(ВременныйКаталог+"data.html");
	
	
	//
	//ДД_резХТМЛ.Записать(ВременныйКаталог+"data.html");
				
	Файлы = Новый Соответствие;
	МассивФайлов = НайтиФайлы(ВременныйКаталог,"*",Истина);
	
	Для Каждого Файл из МассивФайлов Цикл
		Если не Файл.Этокаталог() Тогда
			ДанныеФайла = Новый ДвоичныеДанные(Файл.ПолноеИмя);
			Файлы.Вставить(Файл.Имя, ДанныеФайла);
		КонецЕсли;
	КонецЦикла;

	Попытка
		УдалитьФайлы(ВременныйКаталог);
	Исключение
	КонецПопытки;
	
	возврат файлы; 
КонецФункции

&НаКлиенте
Процедура ПрочитатьДокФайлДДЗавершение(ДанныеФайла, ДополнительныеПараметры) Экспорт
	
	ВременныйКаталог = ДополнительныеПараметры.ВременныйКаталог;
	ЕстьВорд = ДополнительныеПараметры.ЕстьВорд;
	ПолныйПутьДокФайл = ДополнительныеПараметры.ПолныйПутьДокФайл;
	
	Если ИА_ДИ_ИспользоватьGoogleДокументыДляКонвертации Тогда
		врИмя = ИмяФайла;
		РезХТМЛ = ИА_Защита_ДИ.ПолучитьХТМЛЧерезGoogle(ДанныеФайла, врИмя);
	
		Если РезХТМЛ <> Неопределено Тогда
			Объект.Текст = РезХТМЛ;
			УстановитьТекстHTML("ПолеHTML_Просмотр",Объект.Текст);

			ДокФайл = Base64Строка(ДанныеФайла);		
			Модифицированность = Истина;
			БылоИзменениеТекста = истина;
		КонецЕсли;
		возврат;
	КонецЕсли;

	
	
	//Пересохраним в HTML. Обработаем прикрепленные изображения
	Если ЕстьВорд Тогда
		
		ИсхФ = Новый Файл(ПолныйПутьДокФайл);
		ИмяИсхФ = ИсхФ.Имя;
		
		Файлы = СохранитьВХТМЛ(ДанныеФайла,ИмяИсхФ);
		
		Если Файлы = Неопределено Тогда
			возврат;
		КонецЕсли;
							
		Объект.Текст = ИА_Защита_ДИ.СформироватьНТМЛДокументИзВордНаСервере(Файлы, ЕстьВорд);
		УстановитьТекстHTML("ПолеHTML_Просмотр",Объект.Текст);			
		
	иначе
		РезХТМЛ = ИА_Защита_ДИ.ПолучитьХТМЛЧерезВеб(ДанныеФайла, ИмяФайла);
		Если ЛЕВ(РезХТМЛ,6) = "ОШИБКА" Тогда
			Сообщить(РезХТМЛ);
			Возврат;
		Иначе
			Объект.Текст = РезХТМЛ;
			УстановитьТекстHTML("ПолеHTML_Просмотр",Объект.Текст);
		КонецЕсли;
	КонецЕсли;
	
	ДокФайл = Base64Строка(ДанныеФайла);
	
	// Сохранение результата
	Модифицированность = Истина;
	БылоИзменениеТекста = истина;
	
	Попытка
		УдалитьФайлы(ВременныйКаталог);
	Исключение
	КонецПопытки;
КонецПроцедуры

