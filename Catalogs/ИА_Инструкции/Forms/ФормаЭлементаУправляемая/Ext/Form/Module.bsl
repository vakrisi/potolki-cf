&НаСервере
Функция ЗаписатьФайлВКаталогВременныхФайлов(Версия)	
	ТекДок = РеквизитФормыВЗначение("Объект");
	ВерсииДокументов = ТекДок.ВерсииДокументов;
	СтрокаВерсии = ВерсииДокументов.Найти(Версия,"Версия");
	ДанныеДокФайла = СтрокаВерсии.Файл.Получить(); 
	Возврат ДанныеДокФайла;
КонецФункции

&НаКлиенте
Процедура ОткрытьВерсию(Команда)
	тд = Элементы.ВерсииДокументов.ТекущиеДанные;
	Если НЕ тд = Неопределено Тогда
		ДанныеДокФайла = ЗаписатьФайлВКаталогВременныхФайлов(тд.Версия);
		ВрКат = КаталогВременныхФайлов();
		ИмяФайла = "instruction_history.doc";
		ПолныйПутьДокФайл = ВрКат + ИмяФайла; 
		
		ОпОп = Новый ОписаниеОповещения("ОткрытьВерсиюЗавершение", ЭтотОбъект, новый Структура("ПолныйПутьДокФайл",ПолныйПутьДокФайл));
		ДанныеДокФайла.НачатьЗапись(ОпОп,ПолныйПутьДокФайл);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьВерсиюЗавершение(дп) Экспорт	
	ИА_ОбщиеПроцедуры_Технология.ОткрытьДокФайл(дп.ПолныйПутьДокФайл)
КонецПроцедуры

&НаКлиенте 
Процедура ВводПользователейЗавершение(Результат, ДополнительныеПараметры) Экспорт 
	Если НЕ Результат = Неопределено Тогда 
		
		ДополнительныеПараметры.Вставить("СписокПользователей",Результат);
		Оповещение = Новый ОписаниеОповещения("ВводЗаголовкаЗадачиЗавершение", ЭтаФорма, ДополнительныеПараметры); 
		ПоказатьВводСтроки(Оповещение, ДополнительныеПараметры.ЗаголовокЗадачи, "Введите заголовок задачи", 150);
		
	КонецЕсли;
КонецПроцедуры

&НаКлиенте 
Процедура ВводЗаголовкаЗадачиЗавершение(Результат, ДополнительныеПараметры) Экспорт 
	Если НЕ Результат = Неопределено Тогда 
		
		ДополнительныеПараметры.Вставить("ЗаголовокЗадачи",Результат);
		Оповещение = Новый ОписаниеОповещения("ВводСрокаИсполненияЗадачи", ЭтаФорма, ДополнительныеПараметры); 
		ПоказатьВводДаты(Оповещение, ДополнительныеПараметры.СрокИсполнения, "Введите срок исполнения задачи", ЧастиДаты.Дата);
		
	КонецЕсли;
КонецПроцедуры

&НаКлиенте 
Процедура ВводСрокаИсполненияЗадачи(Результат, ДополнительныеПараметры) Экспорт 
	Если НЕ Результат = Неопределено Тогда 
		
		ДополнительныеПараметры.Вставить("СрокИсполнения",Результат);
		
		ОбновитьСписокЗадач = Истина;
		Если ДополнительныеПараметры.СрокИсполнения < ТекущаяДата()+1800 Тогда
			
			ОбновитьСписокЗадач  = ложь;
			ПоказатьПредупреждение(,"Дата текущего срока исполнения не может быть меньше текущей времени!");
			
			Возврат;  
			
		КонецЕсли;
		СоздатьЗадачиОзнакомление(ДополнительныеПараметры.СписокПользователей, 
								  ДополнительныеПараметры.ЗаголовокЗадачи, 
								  ДополнительныеПараметры.СрокИсполнения);
		
		Если ОбновитьСписокЗадач Тогда	
			УстановитьОтборЗадач(); 
			Элементы.ЗадачиОзнакомления.Обновить();
		КонецЕсли;
		
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура СсылкаГуглДокНажатие(Элемент, СтандартнаяОбработка)
	СтандартнаяОбработка = ложь;
	ЗапуститьПриложение(Объект.СсылкаГуглДок);
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьСсылку(Команда)
	Подсказка = "Введите ссылку на Google документ";
	Оповещение = Новый ОписаниеОповещения("ПослеВводаСсылки",ЭтотОбъект, Параметры);
	ПоказатьВводСтроки(Оповещение, "", Подсказка, 0, ложь);
КонецПроцедуры

&НаКлиенте
Процедура ПослеВводаСсылки(Строка, Параметры) Экспорт
	Если Строка <> Неопределено Тогда
		Объект.СсылкаГуглДок = Строка;
		
		ОбновитьГуглДок();
    КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьГуглДок() 
	Объект.Текст = ИА_Инструкции.ПолучитьТекстИнструкцииГугл(Объект.СсылкаГуглДок);
	Объект.ДатаОбновленияГугл = УниверсальноеВремя(ТекущаяДата());	
	ПолеHTML_Просмотр = Объект.Текст;
	Модифицированность = истина;
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьИзGoogle(Команда)
	Если Объект.СсылкаГуглДок = "" Тогда
		Возврат;
	КонецЕсли;
	ОбновитьГуглДок();
КонецПроцедуры

