&НаСервере
Процедура СоздатьМакрос(ЕстьВорд, ВременныйКаталог)
	Если ЕстьВорд Тогда
		Wsh = Новый COMОбъект("WScript.Shell");
	    Wsh.RegWrite("HKEY_CURRENT_USER\SOFTWARE\Microsoft\Office\10.0\Word\Security\AccessVBOM", 1, "REG_DWORD");
	    Wsh.RegWrite("HKEY_CURRENT_USER\SOFTWARE\Microsoft\Office\11.0\Word\Security\AccessVBOM", 1, "REG_DWORD");
		Wsh.RegWrite("HKEY_CURRENT_USER\SOFTWARE\Microsoft\Office\12.0\Word\Security\AccessVBOM", 1, "REG_DWORD");
		Wsh.RegWrite("HKEY_CURRENT_USER\SOFTWARE\Microsoft\Office\13.0\Word\Security\AccessVBOM", 1, "REG_DWORD");
		Wsh.RegWrite("HKEY_CURRENT_USER\SOFTWARE\Microsoft\Office\14.0\Word\Security\AccessVBOM", 1, "REG_DWORD");
		Wsh.RegWrite("HKEY_CURRENT_USER\SOFTWARE\Microsoft\Office\15.0\Word\Security\AccessVBOM", 1, "REG_DWORD");
		Wsh.RegWrite("HKEY_CURRENT_USER\SOFTWARE\Microsoft\Office\16.0\Word\Security\AccessVBOM", 1, "REG_DWORD");
		Wsh.RegWrite("HKEY_CURRENT_USER\SOFTWARE\Microsoft\Office\17.0\Word\Security\AccessVBOM", 1, "REG_DWORD");
		Wsh.RegWrite("HKEY_CURRENT_USER\SOFTWARE\Microsoft\Office\18.0\Word\Security\AccessVBOM", 1, "REG_DWORD");
		Wsh.RegWrite("HKEY_CURRENT_USER\SOFTWARE\Microsoft\Office\19.0\Word\Security\AccessVBOM", 1, "REG_DWORD");
		Wsh.RegWrite("HKEY_CURRENT_USER\SOFTWARE\Microsoft\Office\20.0\Word\Security\AccessVBOM", 1, "REG_DWORD");
	    Wsh = "";
		
		Word = новый COMОбъект("Word.Application");
		WordDoc = Word.Documents.Add();
		
		// проверим на существование макроса
		Для каждого проект из Word.VBE.VBProjects Цикл
			для каждого макрос из проект.VBComponents Цикл
				Если макрос.Name = "AddLinkToInstruction" Тогда
					WordDoc.Close();
					Word.Quit();
					WordDoc = 0;
					Word = 0;
					Возврат;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
		
		// создадим макрос
		strCode = ПолучитьТекстМакроса(Истина);
		module = Word.VBE.VBProjects("Normal").VBComponents.Add(1);
		module.CodeModule.AddFromString(strCode);
		module.Name = "AddLinkToInstruction";
		
		// создадим форму
		//   извлечение
		Архив = ПолучитьФормуМакроса();
		Архив.Записать(ВременныйКаталог+"form.zip");
		ЧтениеАхива = Новый ЧтениеZipФайла(ВременныйКаталог+"form.zip");
		ЧтениеАхива.ИзвлечьВсе(ВременныйКаталог);
		//   создание формы
		form = Word.VBE.VBProjects("Normal").VBComponents.Import(ВременныйКаталог + "Instructions_ksu.frm");
	   
	   	WordDoc.Close();
		Word.Quit();
		WordDoc = 0;
		Word = 0;
	Иначе
		Word = новый COMОбъект("com.sun.star.ServiceManager");
		
		Container = Word.createInstance("com.sun.star.script.ApplicationDialogLibraryContainer");
		Если Container.hasByName("KSU") Тогда
			Word = 0;
			Container = 0;
			Возврат;
		КонецЕсли;
		
		// создадим библиотеку
		Архив = ПолучитьБиблиотекуОО(); 
		
		Попытка // возможно 8.2
			Выполнить("катБибл =  КаталогДокументов();");
		Исключение
			Shell = Новый COMОбъект("WScript.Shell");
			катБибл = Shell.SpecialFolders.Item("MyDocuments")+"\";
		КонецПопытки;
		
		катБибл = катБибл +"KSU\OO_bibl\";
		СоздатьКаталог(катБибл);
		
		Архив.Записать(катБибл+"bibl.zip");
		ЧтениеАхива = Новый ЧтениеZipФайла(катБибл+"bibl.zip");
		ЧтениеАхива.ИзвлечьВсе(катБибл);
		
		Container.CreateLibraryLink("KSU", ИА_ОбщиеПроцедуры_Технология_Сервер.convertToURL(катБибл + "KSU"), False);
	   	Container.LoadLibrary("KSU");
		
		// загрузим макрос
		Word = новый COMОбъект("com.sun.star.ServiceManager");
		KSU_Lib = Word.createInstance("com.sun.star.script.ApplicationScriptLibraryContainer").GetByName("Standard");
		Если KSU_Lib.hasByName("KSU") Тогда
			Word = 0;
			KSU_Lib = 0;
			Возврат;
		КонецЕсли;
		
		ТекстМодуля = ПолучитьТекстМакроса(ложь);
		KSU_Lib.InsertByName("KSU", ТекстМодуля);
		
		Word = 0;
		Container = 0;
		KSU_Lib = 0;
	КонецЕсли;
КонецПроцедуры

