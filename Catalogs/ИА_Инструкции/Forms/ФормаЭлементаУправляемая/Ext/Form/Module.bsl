&НаКлиенте
Процедура ЗагрузитьИзWord(Команда)
	редактор = ИА_ОбщиеПроцедуры_Технология_Сервер.ПолучитьРедакторИнструкций();
	Если редактор = ПредопределенноеЗначение("Перечисление.ИА_РедакторИнструкций.ПустаяСсылка") Тогда
		ПоказатьПредупреждение(,"На Вашем компьютере не установлен MS Office или OpenOffice. Для корректной работы необходимо установить один из этих продуктов!");
		Возврат;
	КонецЕсли;
	
	#Если ВебКлиент Тогда
		ПолноеИмяФайла = "";
		НачатьПомещениеФайла(Новый ОписаниеОповещения("ЗагрузитьИзWordЗавершение", ЭтотОбъект, Новый Структура("редактор", редактор)),  , , Истина);
        Возврат;
	#Иначе
		Режим = РежимДиалогаВыбораФайла.Открытие;
		ДиалогОткрытияФайла = Новый ДиалогВыбораФайла(Режим);
		ДиалогОткрытияФайла.ПолноеИмяФайла = "";
		Фильтр = "MS Word(*.doc*)|*.doc*|OpenOffice Writer(*.odt)|*.odt";
		ДиалогОткрытияФайла.Фильтр = Фильтр;
		ДиалогОткрытияФайла.МножественныйВыбор = Ложь;
		ДиалогОткрытияФайла.Заголовок = "Выберите файл с инструкцией";
		Если Не ДиалогОткрытияФайла.Выбрать() Тогда
			Возврат;	
		КонецЕсли;
		
		ПолноеИмяФайла = ДиалогОткрытияФайла.ПолноеИмяФайла;
	#КонецЕсли	
	
	ЗагрузитьИзWordФрагмент(ПолноеИмяФайла, редактор);
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьИзWordЗавершение(Результат, Адрес, ПолноеИмяФайла, ДополнительныеПараметры) Экспорт
	
	Если Не Результат Тогда
		Возврат;
	КонецЕсли;
	
	ЗагрузитьИзWordФрагмент(ПолноеИмяФайла, ДополнительныеПараметры.редактор);

КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьИзWordФрагмент(ПолноеИмяФайла, Знач редактор)
	
	Файл = Новый Файл(ПолноеИмяФайла);
	ИмяФайла = Файл.Имя;
	
	ОпОп = Новый ОписаниеОповещения("ЗагрузитьИзWordФрагментЗавершение", ЭтотОбъект,Новый Структура("ИмяФайла,редактор",ИмяФайла,редактор));
	НачатьСозданиеДвоичныхДанныхИзФайла(ОпОп, ПолноеИмяФайла) ;
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьИзWordФрагментЗавершение(ДДИсхДок, дп) Экспорт	
	ЗагрузитьИзWordСервер(дп.ИмяФайла, дп.редактор, ДДИсхДок);
	УстановитьТекстHTML("ПолеHTML_Просмотр",Объект.Текст);
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьИзWordСервер(ИмяФайлаИсх, редактор, ДДИсхДок)
	Если ИА_ДИ_ИспользоватьGoogleДокументыДляКонвертации Тогда
		РезХТМЛ = ИА_Защита_ДИ.ПолучитьХТМЛЧерезGoogle(ДДИсхДок,ИмяФайлаИсх);
		Если РезХТМЛ <> Неопределено Тогда
			Объект.Текст = РезХТМЛ;

			ДокФайл = Base64Строка(ДДИсхДок);		
			Модифицированность = Истина;
			БылоИзменениеТекста = истина;
		КонецЕсли;
		возврат;
	КонецЕсли;
	
	
	ЕстьВорд = редактор = Перечисления.ИА_РедакторИнструкций.Word;
	ЕстьВрайтер = редактор = Перечисления.ИА_РедакторИнструкций.Writer;
	
	Если ЕстьВорд Тогда
		Word = новый COMОбъект("Word.Application");
	иначе
		Word = новый COMОбъект("com.sun.star.ServiceManager");
	КонецЕсли;	
	
	
	//---------------------------------------
	
	ВременныйКаталог = КаталогВременныхФайлов()+Строка(Новый УникальныйИдентификатор);	
	СоздатьКаталог(ВременныйКаталог);
	
	ПолноеИмяФайла = ВременныйКаталог+"\"+ИмяФайлаИсх;
	ДДИсхДок.Записать(ПолноеИмяФайла);
	
	Файл = Новый Файл(ПолноеИмяФайла);
	ИмяФайла = Файл.Имя;
	
	// сконвертируем в ХТМЛ
	
	Если ЕстьВорд Тогда
		Попытка 
			Word.Documents.Add(ПолноеИмяФайла);
		Исключение
			Сообщить("Не могу открыть файл "+ПолноеИмяФайла);
			Возврат;
		КонецПопытки;
		
		Document=Word.ActiveDocument;
		
		wdFormatHTML = 8;
		wdFormatWebArchive = 9;
		wdFormatFilteredHTML = 10;
		
		Попытка // убираем комменты
			Document.DeleteAllComments();
			Document.DeleteAllInkAnnotations();
			Document.SaveAs(ВременныйКаталог+"\data.doc");
			Document.Close();
			Word.Quit();
			Word = 0;
			
			//////////////////////////////////
			
			Word = новый COMОбъект("Word.Application");
			Word.Documents.Add(ВременныйКаталог+"\data.doc");
			Document=Word.ActiveDocument;
		Исключение
		КонецПопытки;
		
		
		Document.SaveAs(ВременныйКаталог+"\data.html", wdFormatFilteredHTML);
		Document.Close();
		Word.Quit();
		Word = 0;
		
		// сформируем структуру файлов и отдадим на сервер
		Файлы = Новый Соответствие;
		МассивФайлов = НайтиФайлы(ВременныйКаталог+"\","*",Истина);
		
		Для Каждого Файл из МассивФайлов Цикл
			Если не Файл.Этокаталог() Тогда
				ДанныеФайла = Новый ДвоичныеДанные(Файл.ПолноеИмя);
				Файлы.Вставить(Файл.Имя, ДанныеФайла);
			КонецЕсли;
		КонецЦикла;
		Объект.Текст = ИА_Защита_ДИ.СформироватьНТМЛДокументИзВордНаСервере(Файлы, ЕстьВорд);
		//УстановитьТекстHTML("ПолеHTML_Просмотр",Объект.Текст);
	Иначе
		//если это DOCX пересохраним в DOC т.к. ОО не умеет сохранять в DOCX
		Если НРЕГ(прав(ПолноеИмяФайла,4)) = "docx" Тогда
			Desktop = Word.createInstance("com.sun.star.frame.Desktop");
			
			Args = Новый COMSafeArray("VT_VARIANT", 1);
			lProp1       = Word.Bridge_GetStruct("com.sun.star.beans.PropertyValue"); 
			lProp1.Name  = "Hidden"; 
			lProp1.Value = true; 
			Args.SetValue(0, lProp1);
			
			Документ = Desktop.LoadComponentFromURL("file:///"+ПолноеИмяФайла, "_hidden", 0, Args);
			
			lProperties = Новый COMSafeArray("VT_VARIANT", 1);		
			lProp       = Word.Bridge_GetStruct("com.sun.star.beans.PropertyValue"); 
			lProp.Name  = "FilterName"; 
			lProp.Value = "MS Word 97"; 
			lProperties.SetValue(0, lProp);
			
			ПолноеИмяФайла = ВременныйКаталог+"\data.doc";
			Путь = СтрЗаменить(ПолноеИмяФайла, "\", "/");
			Документ.storeToURL("file:///" + Путь, lProperties);
			Документ.Close(Истина);
			//
			ИмяФайла = "data.doc";
			//
			Документ = 0;
			Args = 0;
			lProperties = 0;
			lProp = 0;
			Desktop = 0;
			Word = 0;
		КонецЕсли;
		
		ДанныеФайла = Новый ДвоичныеДанные(ПолноеИмяФайла);
		РезХТМЛ = ИА_Защита_ДИ.ПолучитьХТМЛЧерезВеб(ДанныеФайла, ИмяФайла);
		Если ЛЕВ(РезХТМЛ,6) = "ОШИБКА" Тогда
			ИмяФайла = "";
			Сообщить(РезХТМЛ);
			Возврат;
		Иначе
			Объект.Текст = РезХТМЛ;
			//УстановитьТекстHTML("ПолеHTML_Просмотр",Объект.Текст);
		КонецЕсли;
	КонецЕсли;
	
	// сохраним док файл
	ДвДанныеФайла = Новый ДвоичныеДанные(ПолноеИмяФайла);
	ДокФайл = Base64Строка(ДвДанныеФайла);
	
	УдалитьФайлы(ВременныйКаталог);
	
	Модифицированность = Истина;
	БылоИзменениеТекста = истина;

КонецПроцедуры


&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Гугл = Константы.ИА_ДИ_ИспользоватьGoogleДокументы.Получить();
	ИА_ДИ_ИспользоватьGoogleДокументыДляКонвертации = Константы.ИА_ДИ_ИспользоватьGoogleДокументыДляКонвертации.Получить();
	ЭтоАдмин = ИА_ОбщиеПроцедуры_Технология_Сервер.ИА_ОбъектДоступен(ПредопределенноеЗначение("Справочник.ОргСхема.ПустаяСсылка"));
	УстановитьОтборЗадач();
	
	Если Гугл и Объект.СсылкаГуглДок <> "" Тогда
		ОбновитьИсторию();
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ОбновитьИсторию()
	Попытка 
		датыИзм = ИА_Инструкции.ПолучитьДатыИзменений(Объект.СсылкаГуглДок);
		Для каждого датаИзм из датыИзм Цикл
			Новстр = История.Добавить();
			ЗаполнитьЗначенияСвойств(новстр, датаИзм);
		КонецЦикла;
	Исключение
		Сообщить(ОписаниеОшибки());
	КонецПопытки;
КонецПроцедуры

&НаСервере
Функция УстановитьОтборЗадач()
	
	ЭлементыОтбора = ЗадачиОзнакомления.Отбор.Элементы;
	ЭлементыОтбора.Очистить();
	ИА_КСУОбщийСервер.ДобавитьЭлементОтбора(ЭлементыОтбора, "Инструкция",ВидСравненияКомпоновкиДанных.Равно, Объект.Ссылка, Истина);
	
КонецФункции

&НаКлиенте
Процедура СоздатьЗадачиНаОзнакомление(Команда)
	
	Записать();
	ОбновитьСписокЗадач = Ложь;
	
	ЗаголовокЗадачи = "Ознакомиться с должностной инструкцией";
	СрокИсполнения = НачалоДня(ТекущаяДата() + 7*60*60*24); //дается неделя

	СтрукПараметров = Новый Структура;
	СтрукПараметров.Вставить("Инструкция",Объект.Ссылка);
	СтрукПараметров.Вставить("ЗаголовокЗадачи",ЗаголовокЗадачи);
	СтрукПараметров.Вставить("СрокИсполнения",СрокИсполнения);
	
	Оповещение = Новый ОписаниеОповещения("ВводПользователейЗавершение", ЭтаФорма, СтрукПараметров);
	ОткрытьФорму("Справочник.ИА_Инструкции.Форма.СписокСотрудников",СтрукПараметров,,,,,Оповещение);

КонецПроцедуры

&НаСервере
Процедура СоздатьЗадачиОзнакомление(рез, заголовокЗадачи, СрокИсполнения)
	Для Каждого Стр Из Рез Цикл
		НоваяЗадача = Задачи.ИА_ЗадачаПланаДействий.СоздатьЗадачу();
		НоваяЗадача.Автор = ПараметрыСеанса.ТекущийПользователь;
		НоваяЗадача.ПостАвтора = ИА_ОбщиеПроцедуры_Технология_КоммЦентр.ПолучитьВысокийПостПользователя(НоваяЗадача.Автор);
		НоваяЗадача.Дата = ТекущаяДата();
		НоваяЗадача.Наименование = заголовокЗадачи;
		НоваяЗадача.Содержание = Объект.Наименование + ". Задание находится в прикрепленном объекте.";
		НоваяЗадача.Пользователь = Стр.Значение;
		
		СписокДИ = новый массив;
		СписокДИ.Добавить(Объект.Ссылка);
		задание = ИА_ОбщиеПроцедуры_Технология_Сервер.ПолучитьЗадачуНаОзнакомление(НоваяЗадача.Пользователь,СписокДИ, СрокИсполнения);
		НоваяЗадача.ПрикрепленныйОбъект = задание;
		//НоваяЗадача.ПрикрепленныйОбъект = Объект.Ссылка;
		НоваяЗадача.Отправлена = истина;
		Если Не СрокИсполнения = Дата(1,1,1) тогда
			НоваяЗадача.СрокИсполнения = СрокИсполнения;
		КонецЕсли;
		НоваяЗадача.Записать();
	КонецЦикла;
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьСписокИнструкций()
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ИА_Инструкции.Ссылка,
	               |	ИА_Инструкции.Наименование КАК Наименование
	               |ИЗ
	               |	Справочник.ИА_Инструкции КАК ИА_Инструкции
	               |ГДЕ
	               |	ИА_Инструкции.ЭтоГруппа = ложь
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Наименование";
	Выборка = Запрос.Выполнить().Выбрать();
	
	рез = Новый Массив;
	Пока Выборка.Следующий() Цикл
		рез.Добавить(Выборка.Наименование+"|^|"+"1CRefInst"+Выборка.Ссылка.УникальныйИдентификатор());
	КонецЦикла;
	Возврат Рез;
КонецФункции

&НаКлиенте
Процедура РедактироватьВWord(Команда)
    
    редактор = ИА_ОбщиеПроцедуры_Технология_Сервер.ПолучитьРедакторИнструкций();
    Если редактор = ПредопределенноеЗначение("Перечисление.ИА_РедакторИнструкций.ПустаяСсылка") Тогда
    	ПоказатьПредупреждение(,"На Вашем компьютере не установлен MS Office или OpenOffice. Для корректной работы необходимо установить один из этих продуктов!");
    	Возврат;
    КонецЕсли;
    
    ЕстьВорд = редактор = ПредопределенноеЗначение("Перечисление.ИА_РедакторИнструкций.Word");
    
    ВременныйКаталог = КаталогВременныхФайлов()+Строка(Новый УникальныйИдентификатор)+ "\";
    СоздатьКаталог(ВременныйКаталог);
    
    //ворд файл
    Если ДокФайл = "" Тогда
    	СтрРез = ИА_ОбщиеПроцедуры_Технология_Сервер.ПолучитьДанныеДокФайла(Объект.Ссылка);
    	Если СтрРез = Неопределено Тогда
			Если ЗначениеЗаполнено(Объект.ТипИнструкции) Тогда                       
                ДанныеДокФайла = ПолучитьШаблонДИПоТипу(Объект.ТипИнструкции);
                Если ДанныеДокФайла = Неопределено тогда
                    ДанныеДокФайла = ПолучитьШаблонДИ();
                    Если ДанныеДокФайла = Неопределено тогда
                        Сообщить("Укажите константу ""Шаблон интрукций""!");
                        Возврат;
                    КонецЕсли; 
                КонецЕсли;                  
            Иначе
                ДанныеДокФайла = ПолучитьШаблонДИ();
                Если ДанныеДокФайла = Неопределено тогда
                    Сообщить("Укажите константу ""Шаблон интрукций""!");
                    Возврат;
                КонецЕсли;
            КонецЕсли;
            ИмяФайла = "instruction.doc";
    	Иначе
    		ДанныеДокФайла = СтрРез.Данные; 
    		ИмяФайла = СтрРез.Имя;
    	КонецЕсли;
	Иначе
		//ИмяФайла = "instruction.doc";
    	ДанныеДокФайла = Base64Значение(ДокФайл);
    КонецЕсли;
    
    ПолныйПутьДокФайл = ВременныйКаталог + ИмяФайла; 
	ОпОп = Новый ОписаниеОповещения("ЗаписьДокЗавершение", ЭтотОбъект, Новый Структура("ВременныйКаталог,ЕстьВорд,ПолныйПутьДокФайл",ВременныйКаталог,ЕстьВорд,ПолныйПутьДокФайл));
    ДанныеДокФайла.НачатьЗапись(ОпОп,ПолныйПутьДокФайл);
    // /ворд
КонецПроцедуры

