
&НаКлиенте
Процедура УстановитьТекстHTML(ИмяРеквизита, Знач ИсходныйТекст)
		
	#Если ВебКлиент Тогда
		ЭтаФорма[ИмяРеквизита] = ИсходныйТекст;
	#Иначе
		Если Элементы[ИмяРеквизита].Документ <> Неопределено Тогда 
			Элементы[ИмяРеквизита].Документ.open  ("text/html","replace");
			Элементы[ИмяРеквизита].Документ.write (ИсходныйТекст);
			Элементы[ИмяРеквизита].Документ.close ();
		КонецЕсли;
	#КонецЕсли
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если не ИА_Защита_Общий.ЛицензияДоступна("ДИ") Тогда
		Отказ = Истина;
		возврат;
	КонецЕсли;
	
    ТекущаяСсылка = Объект.Ссылка;
    
	#Если ВебКлиент Тогда		
		ПодключитьРасширениеРаботыСФайлами();
	#КонецЕсли
	
	Если ТекущаяСсылка.Пустая() Тогда
		Если не ЭтоАдмин  Тогда
			ПоказатьПредупреждение(,"Создавать элементы может только пользователь с уровнем доступа к должностным инструкциям - Администратор!");
			Закрыть();
		КонецЕсли;
		Объект.ДатаСоздания = ТекущаяДата();
	КонецЕсли;
		
	ОбновитьВидимостьДоступность();
	
	ПодключитьОбработчикОжидания("ЗагрузитьПолеHTML_Просмотр",0.1,Истина);
	
	Элементы.СоздатьЗадачиНаОзнакомление.Доступность = ИА_КСУОбщийСервер.РедактированиеКомцентраДоступно();
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьВидимостьДоступность()
	Элементы.ЗагрузитьИзWord.Видимость = не Гугл;
	Элементы.РедактироватьВWord.Видимость = не Гугл;
	Элементы.ФормаОткрыть.Видимость = не Гугл;
	Элементы.ВерсииДокументов.Видимость = не Гугл;
	
	Элементы.ГруппаГуглСсылка.Видимость = Гугл;
	Элементы.История.Видимость = Гугл;
	
	Элементы.ЗагрузитьИзWord.Доступность                        = ЭтоАдмин;
	Элементы.РедактироватьВWord.Доступность                     = ЭтоАдмин;
	Элементы.КнопкаИзменитьСсылку.Доступность                     = ЭтоАдмин;
	Элементы.ГруппаРедактированиеОсновныеДанные.ТолькоПросмотр  = не ЭтоАдмин;	
	Элементы.ГруппаОзнакомление.ТолькоПросмотр                  = не ЭтоАдмин;	
	Элементы.ГруппаВопросы.ТолькоПросмотр                  = не ЭтоАдмин;	
КонецПроцедуры
	
	
&НаКлиенте
Процедура ЗагрузитьПолеHTML_Просмотр()
	УстановитьТекстHTML("ПолеHTML_Просмотр", Объект.Текст);
КонецПроцедуры

&НаСервереБезКонтекста
Процедура СоздатьКопию(пСсылка)
	НовыйОбъект = пСсылка.Скопировать();
	НовыйОбъект.Статус = Перечисления.ИА_СтатусИнструкции.НеДействует;
	НовыйОбъект.Записать();
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	Перем АдресВременногоХранилища;
	Если не ЭтоАдмин Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;	
	
    
     Если БылоИзменениеТекста и (Объект.Статус = ПредопределенноеЗначение("Перечисление.ИА_СтатусИнструкции.Действует"))
		Тогда
		Если Объект.Ссылка.Пустая() Тогда
			Если Объект.Версия = 0 Тогда
				Объект.Версия = 1;
			КонецЕсли;
			Объект.ДатаОбновления = ТекущаяДата();
		Иначе
			//отв = Вопрос("Изменить версию и дату обновления?", РежимДиалогаВопрос.ДаНет);
			//Если отв = КодВозвратаДиалога.Да Тогда
			Объект.Версия = Объект.Версия + 1;
		    ИзменитьВерсию = Истина;
			Объект.ДатаОбновления = ТекущаяДата();
			//КонецЕсли;
		КонецЕсли;
	КонецЕсли;

	Объект.Наименование = Объект.НаименованиеИнструкции + " от " + Формат(Объект.ДатаСоздания,"ДФ=dd.MM.yyyy")+ " ("+"R"+Объект.Версия + ", пересм. " + Формат(Объект.ДатаОбновления,"ДФ=dd.MM.yyyy")+")";
	
	БылоИзменениеТекста = Ложь;	
	
	//Рафаэль - 19.11.14 - проверка заполнения типа инструкции
	Если НЕ ЗначениеЗаполнено(Объект.ТипИнструкции) Тогда
		Сообщить("Не указан тип инструкции!", СтатусСообщения.Внимание);
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
    
    Если ИзменитьВерсию Тогда
        ИзменитьВерсию = ЗаписьФайлаВХранилище(Объект.Ссылка, ТекущийОбъект);
    КонецЕсли;
    
   // Объект.ДатаОбновления = ДатаОбновления;
    
КонецПроцедуры

&НаСервереБезКонтекста
Функция ЗаписьФайлаВХранилище(Ссылка, ТекущийОбъект)	Экспорт
    
    СтрРез = ИА_ОбщиеПроцедуры_Технология_Сервер.ПолучитьДанныеДокФайла(Ссылка);	
	Если НЕ СтрРез = Неопределено Тогда
       
        СтрокаВерсии              = ТекущийОбъект.ВерсииДокументов.Добавить();
		СтрокаВерсии.Версия       = Ссылка.Версия;
		СтрокаВерсии.ДатаСоздания = Ссылка.ДатаОбновления;
		СтрокаВерсии.Файл         = Новый ХранилищеЗначения(СтрРез.Данные);
        
    КонецЕсли;
    
    Возврат Ложь;
    
КонецФункции

&НаКлиенте
Процедура ПолеHTML_ПросмотрДокументСформирован(Элемент)
	Если Элемент.Документ <> Неопределено Тогда
		Элемент.Документ.Body.ContentEditable = "false";
