	</message>
	<portType name="ConvertDocPortType">
		<operation name="ConvertDoc">
			<input name="ConvertDocRequest"
					message="tns:ConvertDocRequestMessage"/>
			<output name="ConvertDocResponse"
					message="tns:ConvertDocResponseMessage"/>
		</operation>
		<operation name="GetDocFromHTML">
			<input name="GetDocFromHTMLRequest"
					message="tns:GetDocFromHTMLRequestMessage"/>
			<output name="GetDocFromHTMLResponse"
					message="tns:GetDocFromHTMLResponseMessage"/>
		</operation>
	</portType>
	<binding name="ConvertDocSoapBinding"
			type="tns:ConvertDocPortType">
		<soapbind:binding style="document"
				transport="http://schemas.xmlsoap.org/soap/http"/>
		<operation name="ConvertDoc">
			<soapbind:operation style="document"
					soapAction="http://localhost/ConvertDoc#ConvertDoc:ConvertDoc"/>
			<input>
				<soapbind:body use="literal"/>
