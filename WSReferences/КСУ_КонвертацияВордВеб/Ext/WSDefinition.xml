				<xs:complexType>
					<xs:sequence>
						<xs:element name="DocData"
								type="xs:base64Binary"
								nillable="true"/>
						<xs:element name="DocName"
								type="xs:string"
								nillable="true"/>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
			<xs:element name="ConvertDocResponse">
				<xs:complexType>
