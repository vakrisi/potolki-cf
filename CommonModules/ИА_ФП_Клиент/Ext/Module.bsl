Процедура ФондыСпецдоход(ДокОбъект) Экспорт
	
	ОпОп = Новый ОписаниеОповещения("ФондыСпецдоходОбработчик",ИА_ФП_Клиент,Новый Структура("ДокОбъект",ДокОбъект));
	Парам = Новый Структура("Док,Только1,Организация,ДатаОстатков",ДокОбъект.Ссылка,истина,иа_ФП.ПолучитьГоловнуюОрганизацию(ДокОбъект.Организация), ДокОбъект.Дата);
	
	ОткрытьФорму("Документ.ИА_ФинансовоеПланирование.Форма.ФормаПодбораДБПУпр",Парам,,,,,ОпОп,РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);
	
КонецПроцедуры

Процедура ФондыСпецдоходОбработчик(рез, дп) Экспорт	
	Если ТипЗнч(рез)<>Тип("Массив") Тогда
		возврат;
	КонецЕсли;
	
	Для каждого стр из рез Цикл
		УжеЕсть = ложь;
		для каждого стрСущ из дп.ДокОбъект.ИА_Фонды цикл
			Если стрСущ.Источник = стр.Источник и ЗначениеЗаполнено(стр.Источник) тогда
				УжеЕсть = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Если УжеЕсть тогда
			ИдИсточникаСтр = ИА_ФПСервер.ИдИсточника(стр.Источник);
			Сообщить("Отложенный доход "+ИдИсточникаСтр+" уже добавлен в документ!");
			Продолжить;
		КонецЕсли;

		Новстр = дп.ДокОбъект.ИА_Фонды.Добавить();
		Новстр.ВидДохода = стр.ВидДохода;
		Новстр.Источник = стр.Источник;
		Новстр.ПодразделениеДохода = стр.Подразделение;
		Новстр.Сумма = стр.СуммаБезнал;
		
		Если ИА_ФП.ПолучитьКонстантыДляФП("КСУ_ДоходыПоПодразделениям") Тогда
			Новстр.Подразделение = стр.Подразделение;
		Иначе
        	Новстр.Подразделение = ИА_ФП.ПолучитьКонстантыДляФП("ИА_ФП_ПодразделениеДоходовБП");
		КонецЕсли;

		Новстр.Фонд = ИА_ФП.ПолучитьКонстантыДляФП("ИА_ФП_ФондДоходовБП");
	КонецЦикла; 
КонецПроцедуры

Функция ПолучитьУточнениеПоВалюте(ДокОбъект) Экспорт
	СуммаДокумента = 0;	
	Попытка 
		СуммаДокумента = ДокОбъект.СуммаДокумента;
	Исключение
		Возврат "";
	КонецПопытки;
	
	Если СуммаДокумента = 0 ИЛИ ДокОбъект.ИА_ЗаказыНаПриобретение.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;

	СтруктураНастройкиРеквизитов = ИА_ФП_ПовторИсп.ПолучитьЗначениеКонстанты_ФП_НастройкиРеквизитов(); 
	
	Попытка
		ВалютаУПР = ИА_ФП_ПовторИсп.ПолучитьЗначениеКонстанты_ФП(СтруктураНастройкиРеквизитов.ИмяРеквизитаВалютаУПР);
		ВалютаДокумента = ДокОбъект[СтруктураНастройкиРеквизитов.ИмяРеквизитаВалютаДокумента];
	Исключение
		возврат "";
	КонецПопытки;
		
	Если ВалютаДокумента = ВалютаУПР Тогда
		Возврат "";
	КонецЕсли;
	СтрокаКурсыВалют = ИА_ФП.ПолучитьКурсКратностьВалют(ДокОбъект.Дата,ВалютаУПР, ВалютаДокумента);
		
	//СуммаДокумента = ПересчитатьИзВалютыВВалюту1(СуммаДокумента, ВалютаДокумента, ВалютаУПР, СтрокаКурсыВалют.КурсДокумента, СтрокаКурсыВалют.КурсУпрУчета, СтрокаКурсыВалют.КратностьДокумента, СтрокаКурсыВалют.КратностьУпрУчета);
	
	заказы = новый массив;
	Для каждого стр из ДокОбъект.ИА_ЗаказыНаПриобретение Цикл
		заказы.Добавить(стр.зп);
	КонецЦикла;
	
	СуммаПоФондам1 = 0;
	Для каждого стр из ДокОбъект.ИА_Фонды Цикл
		СуммаПоФондам1 = СуммаПоФондам1 + стр.сумма;
	КонецЦикла;
	
	СуммаПоЗаказам1 = ИА_ФП.ПолучитьОдобренныеСуммыПоЗаказам(заказы, ДокОбъект.ссылка, ДокОбъект.Дата);
	СуммаПоЗаказам = ПересчитатьИзВалютыВВалюту1(СуммаПоЗаказам1, ВалютаУПР, ВалютаДокумента ,  СтрокаКурсыВалют.КурсУпрУчета,СтрокаКурсыВалют.КурсДокумента, СтрокаКурсыВалют.КратностьУпрУчета, СтрокаКурсыВалют.КратностьДокумента, Истина);
	СуммаПоФондам = ПересчитатьИзВалютыВВалюту1(СуммаПоФондам1, ВалютаДокумента, ВалютаУПР, СтрокаКурсыВалют.КурсДокумента, СтрокаКурсыВалют.КурсУпрУчета, СтрокаКурсыВалют.КратностьДокумента, СтрокаКурсыВалют.КратностьУпрУчета);
	//СуммаПоФондам = СуммаПоФондам1;
	
	недостача = СуммаДокумента -  СуммаПоЗаказам - СуммаПоФондам;
	Если недостача <= 0 Тогда
		возврат "";
	КонецЕсли;
	
	СтрокаОшибки = ". По ЗП одобрено: "+ формат(СуммаПоЗаказам,"ЧДЦ=2; ЧН=") + ". Возьмите с фондов: "+ формат(недостача,"ЧДЦ=2; ЧН=");
	Возврат СтрокаОшибки;
КонецФункции

Функция ПересчитатьИзВалютыВВалюту1(Сумма, ВалютаНач, ВалютаКон, ПоКурсуНач, ПоКурсуКон, ПоКратностьНач =1, ПоКратностьКон = 1 , ОбрезатьДробь = ложь) Экспорт
	
	Если (ВалютаНач = ВалютаКон) Тогда
		
		// Считаем, что пересчет не нужен.
		Возврат Сумма;
	КонецЕсли;
	
	Если (ПоКурсуНач = ПоКурсуКон) 
		и (ПоКратностьНач = ПоКратностьКон) Тогда
		
		// пересчет суммы не требуется
		Возврат Сумма;
	КонецЕсли;
	
	Если ПоКурсуНач     = 0 
		или ПоКурсуКон     = 0 
		или ПоКратностьНач = 0 
		или ПоКратностьКон = 0 Тогда
		Сообщить("При пересчете из валюты '"+ВалютаНач+"' в валюту '"+ВалютаКон+"' обнаружен нулевой курс. Пересчет не произведен!");
		Возврат 0;
	КонецЕсли;
	
	рез = (Сумма * ПоКурсуНач * ПоКратностьКон) / (ПоКурсуКон * ПоКратностьНач);
	
	Если ОбрезатьДробь Тогда
		Возврат Цел(рез*100)/100;
	Иначе
		Возврат Окр(рез, 2);
	КонецЕсли;
	
КонецФункции //ПересчитатьИзВалютыВВалюту1()

Процедура ИА_КСУДействие1() Экспорт
	ПараметрыФормы = Новый Структура("", );
	ОткрытьФорму("Справочник.ИА_ВидыСтатистик.Форма.ФормаСпискаФинПоказателей", ПараметрыФормы);
КонецПроцедуры
