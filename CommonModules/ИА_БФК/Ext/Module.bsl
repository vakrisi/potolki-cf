////#Область ОтборСКД

Процедура ОтборСКД_ОткрытьРедакторСКД(Данные, ФормаВладелец) Экспорт
    П = Новый Структура("ДанныеНастроек", Данные);
    ОткрытьФорму("ОбщаяФорма.ИА_БФРедакторОтбораСКД", П, ФормаВладелец);
КонецПроцедуры


Функция   ОтборСКД_ВыбраноЗначение(ВыбранноеЗначение) Экспорт
    Если ТипЗнч(ВыбранноеЗначение) = Тип("Структура")
        И ВыбранноеЗначение.Свойство("Вид")
        И ВыбранноеЗначение.Вид = "РедакторОтбораСКД"
        Тогда
        Возврат Истина;
    Иначе
        Возврат Ложь;
    КонецЕсли; 
КонецФункции

////#КонецОбласти 


////#Область РедакторТекста

Процедура РедакторТекста_Открыть(Параметры, Форма) Экспорт
    Владелец = Форма;
    Если Параметры.Свойство("Уникальность") Тогда
        Уникальность = Параметры.Уникальность;
    Иначе
        Уникальность = Владелец;
    КонецЕсли; 
    ОткрытьФорму("ОбщаяФорма.ИА_БФРедакторТекста"
    , Параметры, Владелец, Уникальность);
КонецПроцедуры

Функция   РедакторТекста_ВыбраноЗначение(ВыбранноеЗначение) Экспорт
    Если ТипЗнч(ВыбранноеЗначение) = Тип("Структура")
        И ВыбранноеЗначение.Свойство("Вид")
        И ВыбранноеЗначение.Вид = "РедакторТекста"
        Тогда
        Возврат Истина;
    Иначе
        Возврат Ложь;
    КонецЕсли; 
КонецФункции

Функция   РедакторТекста_ПолучитьРезультат(ВыбранноеЗначение) Экспорт
    Результат = Новый Структура("Текст, ИД", "", "");
    Если ТипЗнч(ВыбранноеЗначение) = Тип("Структура")
        И ВыбранноеЗначение.Свойство("Вид")
        И ВыбранноеЗначение.Вид = "РедакторТекста"
        Тогда
        ЗаполнитьЗначенияСвойств(Результат, ВыбранноеЗначение);
        Возврат Результат;
    Иначе
        Возврат Неопределено;
    КонецЕсли; 
КонецФункции

////#КонецОбласти 

