////#Область ДеревоФормы

Процедура ДФ_РазвернутьВсеВетки(ДеревоФормы, ЭлементДеревоФормы) Экспорт
    Для каждого Стр Из ДеревоФормы.ПолучитьЭлементы() Цикл
        ЭлементДеревоФормы.Развернуть(Стр.ПолучитьИдентификатор(), Истина);
    КонецЦикла;  
КонецПроцедуры
 

////#КонецОбласти 


//#Область УФ_СортировкаЭлементовДанных

Процедура УФ_СортировкаЭлементовДанных_Нажатие(Форма, Команда) Экспорт
    Настройки = Форма.УФ_СЭД_Настройки;
    ЭФСписок = Форма.Элементы [Настройки.ИмяЭФСписка];
    ТекСтрока = ЭФСписок.ТекущиеДанные;
    Если ТекСтрока <> Неопределено Тогда
    	Элемент = ТекСтрока[Настройки.ИмяПоля];
        Направление = ?(Найти(Команда.Имя, "Вниз"), 1, -1);
        ИА_БФС.УФ_СортировкаЭлементовДанных_ИзменитьПорядок(Настройки, Элемент, Направление);
        ЭФСписок.Обновить();
    КонецЕсли; 
КонецПроцедуры
 	
