Процедура ИА_ИнициализацияКЦ() Экспорт
	Если ИА_КСУОбщийСервер.ЭтоПользовательКомцентра() Тогда
		ИА_ПроверитьНаличиеЗадачПоБоевымПланам1();
		
		иа_ПериодНапоминания = ИА_ОбщиеПроцедуры_Технология_КоммЦентр_Сервер.ИА_ПериодНапоминания();
		Если иа_ПериодНапоминания = 0 Тогда
			иа_ПериодНапоминания = 300;
		КонецЕсли;
		ПодключитьОбработчикОжидания("ИА_ПроверитьНаличиеЗадачПоБоевымПланам1", иа_ПериодНапоминания);
		ОткрытьФорму("Обработка.ИА_КСУ_РабочийСтол.Форма");
	КонецЕсли;
	ПодключитьОбработчикОжидания("КСУ_ПроверитьНапоминания", 60);
КонецПроцедуры

Процедура ИА_ПроверитьНаличиеЗадачПоБоевымПланам1() Экспорт
	задача = ИА_ОбщиеПроцедуры_Технология_КоммЦентр_Сервер.ИА_ПолучитьЗадачуВх();
	Если задача<>Неопределено Тогда
		ПоказатьОповещениеПользователя("У вас есть активные задачи!",ПолучитьНавигационнуюСсылку(Задача.Ссылка),Задача.Наименование); 
	КонецЕсли;
КонецПроцедуры

Процедура КСУ_ПроверитьНапоминания() Экспорт
	Напминания = ИА_Планы.ПолучитьНапоминания();
	Для каждого стр из Напминания Цикл
		ПоказатьОповещениеПользователя(стр.Тема, ,стр.Текст,БиблиотекаКартинок.КСУ_Напоминание,СтатусОповещенияПользователя.Важное);
	КонецЦикла;
КонецПроцедуры


