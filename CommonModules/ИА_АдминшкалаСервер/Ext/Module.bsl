Функция СоздатьЗадачуСервер(Ответственный, НаименованиеЗадачи, Срок, Содержание, Программа) Экспорт
	Если Ответственный.Пустая() Тогда
		Сообщить("Укажите ответственного за задачу: " + НаименованиеЗадачи);
		Возврат Задачи.ИА_ЗадачаПланаДействий.ПустаяСсылка();
	КонецЕсли;
	Если сокрлп(НаименованиеЗадачи)="" Тогда
		Сообщить("Укажите наименование задачи!");
		Возврат Задачи.ИА_ЗадачаПланаДействий.ПустаяСсылка();
	КонецЕсли;

	НоваяЗадача = Задачи.ИА_ЗадачаПланаДействий.СоздатьЗадачу();
	НоваяЗадача.Автор = ПараметрыСеанса.ТекущийПользователь;
	НоваяЗадача.Дата = ТекущаяДата();
	НоваяЗадача.Наименование = НаименованиеЗадачи;
	НоваяЗадача.Пост = Ответственный;
	НоваяЗадача.Содержание = Содержание + Символы.ПС;
	
	Текрод = Программа.Родитель;
	пока не Текрод.Пустая() Цикл
		если Текрод.ТипЭлемента <> Перечисления.ИА_ТипыЭлементовСтратегическогоУправления.ТипЗадачи Тогда
			НоваяЗадача.Содержание = НоваяЗадача.Содержание + Символы.ПС + Текрод.ТипЭлемента + ": " + Текрод.Наименование;
		КонецЕсли;
		
		Текрод = Текрод.Родитель;
	КонецЦикла;
	НоваяЗадача.СрокИсполнения = Срок;
	НоваяЗадача.ПрикрепленныйОбъект = Программа;
	НоваяЗадача.Отправлена= истина;
	НоваяЗадача.Записать();

	Возврат НоваяЗадача.Ссылка;
КонецФункции

Процедура СоздатьПосланиеОВыполнении(Программа, НаименованиеЗадачи) Экспорт
	Отв = Константы.ИА_ОтветственныйЗаВсеПрограммы.Получить();
	Если отв.Пустая() Тогда
		Сообщить("В настройках не задан ответственный за программы! Отчет не отправлен!");
		Возврат;
	КонецЕсли;
	
	НоваяЗадача = Задачи.ИА_ЗадачаПланаДействий.СоздатьЗадачу();
	НоваяЗадача.ЭтоПослание = Истина;
	НоваяЗадача.Автор = ПараметрыСеанса.ТекущийПользователь;
	НоваяЗадача.Дата = ТекущаяДата();
	НоваяЗадача.Наименование = "Задача """+НаименованиеЗадачи+""" выполнена.";
	//НоваяЗадача.Пост = отв;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ИА_АдресацияЗадачПланаДействий.Пользователь
	|ИЗ
	|	РегистрСведений.ИА_АдресацияЗадачПланаДействий КАК ИА_АдресацияЗадачПланаДействий
	|ГДЕ
	|	ИА_АдресацияЗадачПланаДействий.Пост = &Пост";
	Запрос.УстановитьПараметр("Пост", Отв);
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	ПользовательПоста = Выборка.Пользователь;	
	
	НоваяЗадача.Пользователь = ПользовательПоста;	
	НоваяЗадача.Содержание = "Задача """+НаименованиеЗадачи+""" из программы """+Программа+""" выполнена.";
	НоваяЗадача.ПрикрепленныйОбъект = Программа;
	НоваяЗадача.Отправлена = истина;
	НоваяЗадача.Записать();
КонецПроцедуры

Функция ПолучитьПрограммуЗадачи(пЗадача) Экспорт
	Программа = Неопределено;
	Если Не пЗадача.Родитель.Пустая() Тогда
		ТекРод = пЗадача.Родитель;
		
		Пока ЗначениеЗаполнено(ТекРод) Цикл
			Если ТекРод.ТипЭлемента = Перечисления.ИА_ТипыЭлементовСтратегическогоУправления.Программа Тогда
				Программа = ТекРод;
				Прервать;
			КонецЕсли;
			ТекРод = ТекРод.Родитель;
		КонецЦикла;
	КонецЕсли;
	
	Возврат Программа;
КонецФункции

Функция СоздатьПосланиеОВыполненииСтратегЗадачи(пЗадача) Экспорт
	
	Программа = ПолучитьПрограммуЗадачи(пЗадача);
		
	Если Программа = Неопределено тогда
		Сообщить("Неверная структура данных. Задача не в программе!");
		Возврат ложь;
	КонецЕсли;
	
	Отв = Программа.УведомлятьОВыполнении;
	Если отв.Пустая() Тогда
		Сообщить("В программе не указано кого уведомлять! Отчет не отправлен!");
		Возврат ложь;
	КонецЕсли;
	
	НаименованиеЗадачи = пЗадача.Наименование;
	Если СтрДлина(НаименованиеЗадачи)>70 Тогда
		НаименованиеЗадачи = лев(НаименованиеЗадачи,70)+"...";
	КонецЕсли;
	НаименованиеЗадачи = СтрЗаменить(НаименованиеЗадачи,"<","&lt;");
	НаименованиеЗадачи = СтрЗаменить(НаименованиеЗадачи,">","&gt;");
	
	НаименованиеПрограммы = Программа.наименование;
	НаименованиеПрограммы = СтрЗаменить(НаименованиеПрограммы,"<","&lt;");
	НаименованиеПрограммы = СтрЗаменить(НаименованиеПрограммы,">","&gt;");
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ИА_АдресацияЗадачПланаДействий.Пользователь
	|ИЗ
	|	РегистрСведений.ИА_АдресацияЗадачПланаДействий КАК ИА_АдресацияЗадачПланаДействий
	|ГДЕ
	|	ИА_АдресацияЗадачПланаДействий.Пост = &Пост";
	Запрос.УстановитьПараметр("Пост", Отв);
	Выборка = Запрос.Выполнить().Выбрать();
	Отправлено = ложь;
	Пока Выборка.Следующий() Цикл	
		НоваяЗадача = Задачи.ИА_ЗадачаПланаДействий.СоздатьЗадачу();
		НоваяЗадача.ЭтоПослание = Истина;
		НоваяЗадача.Автор = ПараметрыСеанса.ТекущийПользователь;
		НоваяЗадача.Дата = ТекущаяДата();
		НоваяЗадача.Наименование = "Задача """+НаименованиеЗадачи+""" выполнена.";
			
		НоваяЗадача.Пользователь = Выборка.Пользователь;	
		НоваяЗадача.Содержание = "Задача """+НаименованиеЗадачи+""" из программы """+НаименованиеПрограммы+""" выполнена.";
		//НоваяЗадача.ПрикрепленныйОбъект = пЗадача;
		НоваяЗадача.Отправлена = истина;
		НоваяЗадача.Записать();
		Отправлено = истина;
	КонецЦикла;
	
	Если Отправлено Тогда 
		об = пЗадача.ПолучитьОбъект();
		об.ОтчетОтправлен = истина;
		об.Записать();
	КонецЕсли;

	Возврат Отправлено;
КонецФункции

Функция МожноВыполнитьЗадачу(пСсылка) Экспорт
	программа = ИА_АдминшкалаСервер.ПолучитьПрограммуЗадачи(пСсылка);
	Если программа = Неопределено Тогда 
		Возврат истина;
	КонецЕсли;
	
	Если программа.УведомлятьОВыполнении.Пустая() Тогда 
		Возврат истина;
	КонецЕсли;
	
	Возврат ИА_ОбщиеПроцедуры_Технология_КоммЦентр.ПользовательНаПосту(ПараметрыСеанса.ТекущийПользователь, программа.УведомлятьОВыполнении); 
КонецФункции

Процедура ВыполнитьЗадачуВПрограмме(Программа, НомерСтроки) Экспорт
	ПрОбъект = Программа.ПолучитьОбъект();
	ПрОбъект.Задачи[НомерСтроки-1].Выполнено = истина;
	ПрОбъект.Задачи[НомерСтроки-1].ДатаВыполнения = ТекущаяДата();
	ПрОбъект.Записать();
	
	Если (не ПрОбъект.Задачи[НомерСтроки-1].Задача.Пустая()) и не ПрОбъект.Задачи[НомерСтроки-1].Задача.Выполнена Тогда
		ЗавершитьЗадачу(ПрОбъект.Задачи[НомерСтроки-1].Задача);
	КонецЕсли;
КонецПроцедуры

Процедура ЗавершитьЗадачу(пЗадача) Экспорт
	зОбъект = пЗадача.ПолучитьОбъект();
	зОбъект.ДатаВыполнения = ТекущаяДата();
	Новстр = зОбъект.ХодВыполнения.Вставить(0);
	Новстр.Дата = ТекущаяДата();
	Новстр.Комментарий = "Задача завершена";
	Новстр.Пользователь = ПараметрыСеанса.ТекущийПользователь;
	зОбъект.Отложена = Ложь;

	зОбъект.ВыполнитьЗадачу();
КонецПроцедуры

Функция ПолучитьПравоНаОбъект(пСсылка) Экспорт
	ТекПольз = ПараметрыСеанса.ТекущийПользователь;
	
	Если пСсылка.Права.Количество() = 0 или пСсылка.Автор = ТекПольз Тогда 
		Возврат Перечисления.ИА_ПраваНаОбъекты.Редактирование;
	КонецЕсли;
	
	Нстр = пСсылка.Права.найти(ТекПольз);
	Если Нстр <> Неопределено Тогда
		Если НСтр.Редактирование Тогда
			возврат Перечисления.ИА_ПраваНаОбъекты.Редактирование;
		ИначеЕсли НСтр.Просмотр Тогда 
			возврат Перечисления.ИА_ПраваНаОбъекты.Просмотр;
		КонецЕсли;
	КонецЕсли;
		
	Возврат Неопределено;
КонецФункции

Функция ЕстьПравоЧтения(пСсылка) Экспорт
	Право = ПолучитьПравоНаОбъект(пСсылка);
	возврат Право<>Неопределено;
КонецФункции

Функция ПолучитьТаблицуИерархииСУ() Экспорт
	рез = Новый ТаблицаЗначений;
	рез.Колонки.Добавить("ТипЭлемента");
	рез.Колонки.Добавить("ПодчиненныйТип");
	
	макет = ПолучитьОбщийМакет("ИА_ИерархияСтрУправления");
	сч = 1;
	ИмяТипа = СокрЛП(Макет.Область(сч,1,сч,1).Текст);
	ДостЭл = СокрЛП(Макет.Область(сч,2,сч,2).Текст);
	Пока ИмяТипа <> "" Цикл
		Если ДостЭл <> "" Тогда
			тд = Новый ТекстовыйДокумент;
			тд.УстановитьТекст(ДостЭл);
			
			для счЭл = 1 По тд.КоличествоСтрок() Цикл
				текСтрока = СокрЛП(тд.ПолучитьСтроку(счЭл));
				Если текСтрока <> "" Тогда
					Новстр = рез.Добавить();
					Если ИмяТипа = "Пустой" Тогда
						Новстр.ТипЭлемента = Перечисления.ИА_ТипыЭлементовСтратегическогоУправления.ПустаяСсылка();
					Иначе
						Новстр.ТипЭлемента = Перечисления.ИА_ТипыЭлементовСтратегическогоУправления[ИмяТипа];
					КонецЕсли;
					Новстр.ПодчиненныйТип = Перечисления.ИА_ТипыЭлементовСтратегическогоУправления[текСтрока];;
				КонецЕсли;
			КонецЦикла;	
		КонецЕсли;
		
		сч = сч + 1;
		ИмяТипа = СокрЛП(Макет.Область(сч,1,сч,1).Текст);
		ДостЭл = СокрЛП(Макет.Область(сч,2,сч,2).Текст);
	КонецЦикла;
	
	возврат рез;
КонецФункции

Функция ПолучитьВозможныхПодчиненныхТипов(пЭлементСУ) Экспорт
	тз = ПолучитьТаблицуИерархииСУ();
	Отбор = Новый Структура("ТипЭлемента", пЭлементСУ.ТипЭлемента);
	резСтр = тз.НайтиСтроки(Отбор);
	Рез = Новый массив;
	Для каждого стр из резСтр Цикл
		если ЗначениеЗаполнено(стр.ПодчиненныйТип) ТОгда
			рез.Добавить(стр.ПодчиненныйТип);
		КонецЕсли;
	КонецЦикла;
	
	возврат рез;
КонецФункции

