Процедура ЗавершитьЗадачуАШ(пЗадача) Экспорт
	пЗадачаОб = пЗадача.ПолучитьОбъект();
	пЗадачаОб.Выполнено = истина;
	пЗадачаОб.ДатаВыполнения = ТекущаяДата();
	пЗадачаОб.Записать();
	
	Если (не пЗадачаОб.Задача.Пустая()) и не пЗадачаОб.Задача.Выполнена Тогда
		ЗавершитьЗадачу(пЗадачаОб.Задача);
	КонецЕсли;
КонецПроцедуры

