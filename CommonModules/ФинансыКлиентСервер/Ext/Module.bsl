Процедура ПересчитатьСуммуНДС(Объект, УчитыватьНДС) Экспорт
	
	СтруктураСтроки = Новый Структура("Сумма, СтавкаНДС, СуммаНДС", Объект.Сумма, Объект.СтавкаНДС, 0);	
	ОбработкаТабличныхЧастейКлиентСервер.ПересчитатьСуммуНДСВСтрокеТЧ(СтруктураСтроки, УчитыватьНДС);	
	Объект.СуммаНДС = СтруктураСтроки.СуммаНДС;
	
