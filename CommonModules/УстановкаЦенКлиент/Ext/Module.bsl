Процедура ЗаполнитьМатериалыПоСправочникуФактур(Форма, ТабличнаяЧасть, ДополнительныеПараметрыЗаполнения = Неопределено) Экспорт
	
	ТекстВопроса = "Заполнить всеми элементами из справочника фактур?";
	ТребуетсяОчистка = ТабличнаяЧасть.Количество() > 0;
	
	Если НЕ ДополнительныеПараметрыЗаполнения = Неопределено И ДополнительныеПараметрыЗаполнения.Свойство("КлючСвязи") Тогда
		НайденныеСтроки = ТабличнаяЧасть.НайтиСтроки(Новый Структура("КлючСвязи", ДополнительныеПараметрыЗаполнения.КлючСвязи)); 
		Если НайденныеСтроки.Количество() = 0 Тогда
			ТребуетсяОчистка = Ложь;
		КонецЕсли;
	КонецЕсли;
	
	Если ТребуетсяОчистка Тогда
		ТекстВопроса = "Очистить таблицу и заполнить всеми элементами из справочника фактур?";
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура("ДополнительныеПараметрыЗаполнения", Неопределено);
	Если НЕ ДополнительныеПараметрыЗаполнения = Неопределено Тогда
		ДополнительныеПараметры.Вставить("ДополнительныеПараметрыЗаполнения", ДополнительныеПараметрыЗаполнения);	
	КонецЕсли;
	ОписаниеОповещенияВопрос = Новый ОписаниеОповещения("ЗаполнитьМатериалыПоСправочникуФактурЗавершение", Форма, ДополнительныеПараметры);
	ПоказатьВопрос(ОписаниеОповещенияВопрос, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры

Процедура ЗаполнитьМатериалыПоСправочникуШаблонов(Форма, ТабличнаяЧасть, ДополнительныеПараметрыЗаполнения = Неопределено) Экспорт
	
	ТекстВопроса = "Заполнить элементами из справочника шаблонов по виду продукции?";
	ТребуетсяОчистка = ТабличнаяЧасть.Количество() > 0;
	
	Если НЕ ДополнительныеПараметрыЗаполнения = Неопределено И ДополнительныеПараметрыЗаполнения.Свойство("КлючСвязи") Тогда
		НайденныеСтроки = ТабличнаяЧасть.НайтиСтроки(Новый Структура("КлючСвязи", ДополнительныеПараметрыЗаполнения.КлючСвязи)); 
		Если НайденныеСтроки.Количество() = 0 Тогда
			ТребуетсяОчистка = Ложь;
		КонецЕсли;
	КонецЕсли;
	
	Если ТребуетсяОчистка Тогда
		ТекстВопроса = "Очистить таблицу и заполнить элементами из справочника шаблонов по виду продукции?";
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура("ДополнительныеПараметрыЗаполнения", Неопределено);
	Если НЕ ДополнительныеПараметрыЗаполнения = Неопределено Тогда
		ДополнительныеПараметры.Вставить("ДополнительныеПараметрыЗаполнения", ДополнительныеПараметрыЗаполнения);	
	КонецЕсли;
	ОписаниеОповещенияВопрос = Новый ОписаниеОповещения("ЗаполнитьМатериалыПоСправочникуШаблоновЗавершение", Форма, ДополнительныеПараметры);
	ПоказатьВопрос(ОписаниеОповещенияВопрос, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры

Процедура ЗаполнитьМатериалыПоГруппеФактур(Форма, ТабличнаяЧасть, ДополнительныеПараметрыЗаполнения = Неопределено) Экспорт
	
	ТекстВопроса = "Заполнить элементами из справочника фактур по выбранной группе?";
	ТребуетсяОчистка = ТабличнаяЧасть.Количество() > 0;
	
	Если НЕ ДополнительныеПараметрыЗаполнения = Неопределено И ДополнительныеПараметрыЗаполнения.Свойство("КлючСвязи") Тогда
		НайденныеСтроки = ТабличнаяЧасть.НайтиСтроки(Новый Структура("КлючСвязи", ДополнительныеПараметрыЗаполнения.КлючСвязи)); 
		Если НайденныеСтроки.Количество() = 0 Тогда
			ТребуетсяОчистка = Ложь;
		КонецЕсли;
	КонецЕсли;
	
	Если ТребуетсяОчистка Тогда
		ТекстВопроса = "Очистить таблицу и заполнить элементами из справочника фактур по выбранной группе?";
	КонецЕсли;

	ДополнительныеПараметры = Новый Структура("Форма, ДополнительныеПараметрыЗаполнения", Форма, Неопределено);
	Если НЕ ДополнительныеПараметрыЗаполнения = Неопределено Тогда
		ДополнительныеПараметры.Вставить("ДополнительныеПараметрыЗаполнения", ДополнительныеПараметрыЗаполнения);	
	КонецЕсли;
	ОписаниеОповещенияВопрос = Новый ОписаниеОповещения("ЗаполнитьМатериалыПоГруппеФактурФрагмент", ЭтотОбъект, ДополнительныеПараметры);
	ПоказатьВопрос(ОписаниеОповещенияВопрос, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры

Процедура ЗаполнитьМатериалыПоГруппеФактурФрагмент(Результат, ДополнительныеПараметры) Экспорт
	
    Если НЕ Результат = КодВозвратаДиалога.Да Тогда
        Возврат;
