
#Область УстановкаЦенОбщее

Процедура ДеревоВидовЦенУстанавливатьПриИзменении(Дерево, СтрокаДерева, ТаблицаВидовЦен=Неопределено) Экспорт
	
	Если НЕ СтрокаДерева.ЭтоГруппа Тогда
		// отметим в таблице цен
		Если НЕ ТаблицаВидовЦен=Неопределено Тогда
			НайденныеСтроки = ТаблицаВидовЦен.НайтиСтроки(Новый Структура("ВидЦены", СтрокаДерева.ВидЦены));
			Если НайденныеСтроки.Количество() > 0 Тогда
				НайденныеСтроки[0].Устанавливать = СтрокаДерева.Устанавливать;
			КонецЕсли;
		КонецЕсли;
	Иначе	
		// если выделена группа, то выделим незапрещенные подчиненные элементы
		ИзменитьПризнакУстанавливатьРекурсивно(СтрокаДерева.ПолучитьЭлементы(), СтрокаДерева.Устанавливать, ТаблицаВидовЦен);
	КонецЕсли;
	
	ИзменитьПризнакУстанавливатьДляГрупп(Дерево);	
		
КонецПроцедуры

Процедура ДеревоВидовЦенИзменитьПризнакУстанавливать(Дерево, ПризнакУстанавливать, ТаблицаВидовЦен=Неопределено) Экспорт

	ИзменитьПризнакУстанавливатьРекурсивно(Дерево.ПолучитьЭлементы(), ПризнакУстанавливать, ТаблицаВидовЦен);
	
	ИзменитьПризнакУстанавливатьДляГрупп(Дерево);
	
КонецПроцедуры

// есть схожая процедура в УстановкаЦенСервер
Процедура ИзменитьПризнакУстанавливатьДляГрупп(Дерево) 
	
	// проверим необходимость установки галки на родительские группы
	// 1. получим все группы, начиная с "нижних"
	МассивГрупп = Новый Массив;
	НайтиГруппыРекурсивно(Дерево.ПолучитьЭлементы(), МассивГрупп);
	
	Для каждого ЭлементДерева из Дерево.ПолучитьЭлементы() Цикл
		Если ЭлементДерева.ЭтоГруппа Тогда
			МассивГрупп.Вставить(0, ЭлементДерева);
			НайтиГруппыРекурсивно(Дерево.ПолучитьЭлементы(), МассивГрупп);
		КонецЕсли;
	КонецЦикла;
	
	// 2. проверим галки каждой группы
	Для каждого ЭлементГруппа из МассивГрупп Цикл
		ВсеУстановлены = Истина;
		Для каждого ЭлементДерева из ЭлементГруппа.ПолучитьЭлементы() Цикл
			Если НЕ ЭлементДерева.Устанавливать Тогда
				ВсеУстановлены = Ложь;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		ЭлементГруппа.Устанавливать = ВсеУстановлены;
	КонецЦикла;
	
КонецПроцедуры

Процедура НайтиГруппыРекурсивно(ЭлементыДерева, МассивГрупп)
	
	Для каждого ЭлементДерева из ЭлементыДерева Цикл
		Если ЭлементДерева.ЭтоГруппа Тогда
			МассивГрупп.Вставить(0, ЭлементДерева);
			НайтиГруппыРекурсивно(ЭлементДерева.ПолучитьЭлементы(), МассивГрупп);
		КонецЕсли;
	КонецЦикла;
		
КонецПроцедуры

Процедура НайтиВыбранныеВидыЦенРекурсивно(Дерево, МассивЭлементов) Экспорт
	
	Для каждого ЭлементДерева из Дерево.ПолучитьЭлементы() Цикл
		Если НЕ ЭлементДерева.ЭтоГруппа И ЭлементДерева.Устанавливать Тогда
			МассивЭлементов.Добавить(ЭлементДерева.ВидЦены);
		КонецЕсли;
		Если ЭлементДерева.ЭтоГруппа Тогда
			НайтиВыбранныеВидыЦенРекурсивно(ЭлементДерева, МассивЭлементов);
		КонецЕсли;
	КонецЦикла;
		
КонецПроцедуры

// изменяет признак для нижестоящих видов цен
Процедура ИзменитьПризнакУстанавливатьРекурсивно(ЭлементыДерева, ПризнакУстанавливать, ТаблицаВидовЦен) Экспорт
	
	Для каждого ЭлементДерева из ЭлементыДерева Цикл
		Если НЕ ЭлементДерева.Запрещенный Тогда
			ЭлементДерева.Устанавливать = ПризнакУстанавливать;
			Если НЕ ТаблицаВидовЦен=Неопределено Тогда
				НайденныеСтроки = ТаблицаВидовЦен.НайтиСтроки(Новый Структура("ВидЦены", ЭлементДерева.ВидЦены));
				Если НайденныеСтроки.Количество() > 0 Тогда
					НайденныеСтроки[0].Устанавливать = ПризнакУстанавливать;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		ИзменитьПризнакУстанавливатьРекурсивно(ЭлементДерева.ПолучитьЭлементы(), ПризнакУстанавливать, ТаблицаВидовЦен);
	КонецЦикла;
	
КонецПроцедуры

Процедура ПризнакУстанавливатьДляГруппРекурсивно(ЭлементыДерева)
	
	Для каждого СтрокаДерева из ЭлементыДерева Цикл
		Если СтрокаДерева.ЭтоГруппа Тогда
			ПризнакУстанавливатьДляГруппРекурсивно(СтрокаДерева.ПолучитьЭлементы());
			
			ПризнакУстанавливать = Истина;
			Для каждого СтрокаГруппы из СтрокаДерева.ПолучитьЭлементы() Цикл
				Если НЕ СтрокаГруппы.Устанавливать Тогда	
			    	ПризнакУстанавливать = Ложь;
				КонецЕсли;
			КонецЦикла;
			СтрокаДерева.Устанавливать = ПризнакУстанавливать;			
		КонецЕсли;		
	КонецЦикла;
	
КонецПроцедуры

Функция ПроверитьДоступностьСдвигаВидаЦены(ДеревоВидовЦен, ЭлементДеревоВидовЦен, ТаблицаВидыЦен = Неопределено, Направление = Неопределено) Экспорт
	
	СтруктураРезультата = Новый Структура("Вверх, Вниз", Ложь, Ложь);	
	
	ТекущиеДанные = ЭлементДеревоВидовЦен.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат СтруктураРезультата;	
	КонецЕсли;
	
	Если ТекущиеДанные.ЭтоГруппа Тогда
		Возврат СтруктураРезультата;
	КонецЕсли;
	
	РодительТД = ТекущиеДанные.ПолучитьРодителя();
	Если НЕ РодительТД = Неопределено Тогда
		СтрокиДерева = РодительТД.ПолучитьЭлементы();
	Иначе
		СтрокиДерева = ДеревоВидовЦен.ПолучитьЭлементы();
	КонецЕсли;
	
	ТекИндекс = СтрокиДерева.Индекс(ТекущиеДанные);
	
	НовыйИндексВверх = ТекИндекс - 1;
	НовыйИндексВниз  = ТекИндекс + 1;
	КоличествоЭлементов = СтрокиДерева.Количество();
	
	СтруктураРезультата.Вверх = Истина; 
	СтруктураРезультата.Вниз = Истина;
	
	Если НовыйИндексВверх < 0 Тогда
		// элемент первый в коллекции
		СтруктураРезультата.Вверх = Ложь;		
	КонецЕсли;
	
	Если НовыйИндексВниз >= КоличествоЭлементов Тогда
		// элемент последний в коллекции
		СтруктураРезультата.Вниз = Ложь;
	КонецЕсли;
	
	Если СтруктураРезультата.Вверх Тогда
		ЗаменяемаяСтрока = СтрокиДерева.Получить(НовыйИндексВверх);
		Если ЗаменяемаяСтрока.ЭтоГруппа Тогда
			СтруктураРезультата.Вверх = Ложь;
		КонецЕсли;
	КонецЕсли;
	
	// сдвиг при необходимости
	Если (Направление = -1 И СтруктураРезультата.Вверх) 
		ИЛИ (Направление = 1 И СтруктураРезультата.Вниз) Тогда
		
		СтрокиДерева.Сдвинуть(ТекИндекс, Направление);
		
		// таблица, по которой строятся колонки в дереве номенклатуры
		НайденныеВидыЦен = ТаблицаВидыЦен.НайтиСтроки(Новый Структура("ВидЦены", ТекущиеДанные.ВидЦены));
		ТаблицаВидыЦен.Сдвинуть(ТаблицаВидыЦен.Индекс(НайденныеВидыЦен[0]), Направление);
	КонецЕсли;
	
	Возврат СтруктураРезультата;
	
КонецФункции

#КонецОбласти 

#Область УстановкаЦенНоменклатуры

Процедура РазвернутьДерево(Элементы, Дерево, ИмяЭлементаФормы = "ДеревоЦен") Экспорт
	
	КоллекцияЭлементовДерева = Дерево.ПолучитьЭлементы();
	Для Каждого Строка Из КоллекцияЭлементовДерева Цикл       
		ИдентификаторСтроки = Строка.ПолучитьИдентификатор();     
		Элементы[ИмяЭлементаФормы].Развернуть(ИдентификаторСтроки, Истина);      
	КонецЦикла;
	
КонецПроцедуры

Процедура СвернутьДерево(Элементы, Дерево, ИмяЭлементаФормы = "ДеревоЦен") Экспорт
	
	КоллекцияЭлементовДерева = Дерево.ПолучитьЭлементы();
	Для Каждого Строка Из КоллекцияЭлементовДерева Цикл       
		ИдентификаторСтроки = Строка.ПолучитьИдентификатор();      
		Элементы[ИмяЭлементаФормы].Свернуть(ИдентификаторСтроки);
	КонецЦикла;
	
КонецПроцедуры

