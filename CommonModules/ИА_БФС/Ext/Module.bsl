Процедура ТабДок_ЗадатьФорматСтрок(ТабДок) Экспорт
	// задает индивидуальный формат строк для табличного документа, сохраняя ширину колонок при выводе его в другой табличный документ
	ТабДок.Область(1,,ТабДок.ВысотаТаблицы).СоздатьФорматСтрок();
КонецПроцедуры

Функция   ТабДок_ПрисоединитьТабДок(ТабличныйДокументОсновной, ТабличныйДокументПрисоединяемый) Экспорт
	// идея взята с форума: http://forum.infostart.ru/forum86/topic157420/message1610993/#message1610993
	ТабличныйДокументОбъединенный = Новый ТабличныйДокумент;
	
	Область = ТабличныйДокументОсновной.ПолучитьОбласть(1,1, ТабличныйДокументОсновной.ВысотаТаблицы, ТабличныйДокументОсновной.ШиринаТаблицы);
	
	ТабличныйДокументОбъединенный.Вывести(Область);
	ТабличныйДокументОбъединенный.Присоединить(ТабличныйДокументПрисоединяемый);
	
	Возврат ТабличныйДокументОбъединенный;
КонецФункции

Процедура ТабДок_ОбъединитьЯчейкиПоМаркеру(ТабличныйДокумент, МаркерОбъединения) Экспорт
	// Находит ячейки, содержащие в тексте МаркерОбъединения
	// Объединяет ячейки, располагающиеся рядом, содержащие одинаковый текст и маркер объединения 
	
	ОбъединяемыеЯчейки = ТабДок_внутр_НайтиОбластиПоВхождениюПодстроки(ТабличныйДокумент, МаркерОбъединения);
	ОбъединяемыеЯчейки.Колонки.Добавить("Диапазон");
	ОбъединяемыеЯчейки.Сортировать("Верх,Лево");
	
	Для Каждого Строка из ОбъединяемыеЯчейки Цикл
		Отбор = Новый Структура("Текст,Верх,Лево", Строка.Текст, Строка.Верх-1, Строка.Лево);
		НайденныеСтроки = ОбъединяемыеЯчейки.НайтиСтроки(Отбор);
		Если НайденныеСтроки.Количество() Тогда
			Строка.Диапазон = НайденныеСтроки[0].Диапазон;
			Строка.Диапазон.Низ = Макс(Строка.Диапазон.Низ, Строка.Верх);
			Продолжить;
		КонецЕсли;
		
		Отбор = Новый Структура("Текст,Верх,Лево", Строка.Текст, Строка.Верх, Строка.Лево-1);
		НайденныеСтроки = ОбъединяемыеЯчейки.НайтиСтроки(Отбор);
		Если НайденныеСтроки.Количество() Тогда
			Строка.Диапазон = НайденныеСтроки[0].Диапазон;
			Строка.Диапазон.Право = Макс(Строка.Диапазон.Право, Строка.Лево);
			Продолжить;
		КонецЕсли;
		
		Строка.Диапазон = Новый Структура("Текст,Верх,Лево,Низ,Право", Строка.Текст, Строка.Верх, Строка.Лево, Строка.Верх, Строка.Лево);
	КонецЦикла;
	
	ОбъединяемыеЯчейки.Свернуть("Диапазон");
	Для Каждого Строка Из ОбъединяемыеЯчейки Цикл
		Диапазон = Строка.Диапазон;
		Область = ТабличныйДокумент.Область(Диапазон.Верх, Диапазон.Лево, Диапазон.Низ, Диапазон.Право);
		Область.Объединить();
	КонецЦикла;
	
КонецПроцедуры

Процедура ТабДок_СкрытьСтрокиПоМаркеру(ТабличныйДокумент, МаркерУдаления) Экспорт
	
	НайденныеОбласти = ТабДок_внутр_НайтиОбластиПоВхождениюПодстроки(ТабличныйДокумент, МаркерУдаления);
	НайденныеОбласти.Свернуть("Верх");
	
	Для каждого Строка из НайденныеОбласти Цикл
		Область = ТабличныйДокумент.Область(Строка.Верх, , Строка.Верх, );
		Область.Видимость = Ложь;
	КонецЦикла;
	
КонецПроцедуры

Функция   ТабДок_внутр_НайтиОбластиПоВхождениюПодстроки(ТабличныйДокумент, ПодстрокаПоиска)
	
	НайденныеОбласти = Новый ТаблицаЗначений;
	НайденныеОбласти.Колонки.Добавить("Область");
	НайденныеОбласти.Колонки.Добавить("Текст");
	НайденныеОбласти.Колонки.Добавить("Верх");
	НайденныеОбласти.Колонки.Добавить("Лево");
	
	НайденнаяОбласть = ТабличныйДокумент.НайтиТекст(ПодстрокаПоиска);
	
	Пока НЕ НайденнаяОбласть = Неопределено Цикл
		
		НоваяСтрока = НайденныеОбласти.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, НайденнаяОбласть);
		НоваяСтрока.Область = НайденнаяОбласть;
		
		НайденнаяОбласть = ТабличныйДокумент.НайтиТекст(ПодстрокаПоиска, НайденнаяОбласть);
		
	КонецЦикла;
	
	Возврат НайденныеОбласти;
	
КонецФункции

Процедура ТабДок_ЗаменитьТекст(ТабличныйДокумент, ПодстрокаПоиска, ПодстрокаЗамены) Экспорт
	НайденныеОбласти = ТабДок_внутр_НайтиОбластиПоВхождениюПодстроки(ТабличныйДокумент, ПодстрокаПоиска);
	Для каждого Строка из НайденныеОбласти Цикл
		Строка.Область.Текст = СтрЗаменить(Строка.Область.Текст, ПодстрокаПоиска, ПодстрокаЗамены);
	КонецЦикла;
КонецПроцедуры

//}

////#КонецОбласти 


////#Область РаботаСФормами

Процедура ФормаУпр_ПриСозданииНаСервере(Отказ, СтандартнаяОбработка, Объект, Форма) Экспорт
    ЭФ          = Форма.Элементы;
    Параметры   = Форма.Параметры;
    
    // Включение режима выбора в "формах списка"
    Если  ИА_БФКС.РеквизитЕсть(ЭФ,          "Список")
        И ИА_БФКС.РеквизитЕсть(ЭФ.Список,   "РежимВыбора")
        И ИА_БФКС.РеквизитЕсть(Параметры,   "РежимВыбора")
        И НЕ ЭФ.Список.РежимВыбора
        И Параметры.РежимВыбора = Истина
        Тогда
        ЭФ.Список.РежимВыбора = Параметры.РежимВыбора; 
        
        Если ИА_БФКС.РеквизитЕсть(Параметры, "МножественныйВыбор")
            И Параметры.МножественныйВыбор <> Неопределено
            Тогда
            ЭФ.Список.МножественныйВыбор = Параметры.МножественныйВыбор;
        КонецЕсли; 
    КонецЕсли; 
КонецПроцедуры



////#Область Теги

Процедура Теги_УстановитьОтбор(ИмяОбъектаМД, СписокОбъектов, ОтборТеги, Условие_ИЛИ) Экспорт
    Список = ОтборТеги.ВыгрузитьЗначения();
    
    СписокСсылок = Теги_СформироватьСписокОбъектовПоСпискуТегов(ИмяОбъектаМД, Список, Условие_ИЛИ);
    
    СКД_УстановитьПараметр(СписокОбъектов.Параметры, "Теги_Условие_ИЛИ", Условие_ИЛИ);
    СКД_УстановитьПараметр(СписокОбъектов.Параметры, "Теги_СписокТегов", Список);
    СКД_УстановитьПараметр(СписокОбъектов.Параметры, "Теги_СписокСсылок", СписокСсылок);
    СКД_УстановитьПараметр(СписокОбъектов.Параметры, "Теги_НетОтбора",   Список.Количество() = 0);
КонецПроцедуры

Функция   Теги_СформироватьСписокОбъектовПоСпискуТегов(ИмяОбъектаМД, СписокТегов, Условие_ИЛИ) Экспорт
    Таб = ИА_БФС.Запрос_ВыполнитьВТЗ(
    СтрЗаменить("ВЫБРАТЬ
    |   Т.Ссылка,
    |   КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Т.Тег) КАК КоличествоТегов
    |ПОМЕСТИТЬ Таб
    |ИЗ
    |   Задача.ИА_БПЗадачаНосителя.Теги КАК Т
    |ГДЕ
    |   Т.Тег В(&СписокТегов)
    |
    |СГРУППИРОВАТЬ ПО
    |   Т.Ссылка
    |;
    |
    |////////////////////////////////////////////////////////////////////////////////
    |ВЫБРАТЬ
    |   Таб.Ссылка
    |ИЗ
    |   Таб КАК Таб
    |ГДЕ
    |   ВЫБОР
    |           КОГДА &Условие_ИЛИ
    |               ТОГДА ИСТИНА
    |           ИНАЧЕ Таб.КоличествоТегов = &КоличествоТегов
    |       КОНЕЦ", "Задача.ИА_БПЗадачаНосителя", ИмяОбъектаМД)
    , Новый Структура("СписокТегов, Условие_ИЛИ, КоличествоТегов"
    , СписокТегов
    , Условие_ИЛИ
    , СписокТегов.Количество())); 
    
    Результат = Таб.ВыгрузитьКолонку("Ссылка");
    Возврат Результат;
КонецФункции
 
