Функция   ТЗФ_Создать(ТЗ) Экспорт
    СтруктураКолонок = "";
    Для каждого Колонка Из ТЗ.Колонки Цикл
        СтруктураКолонок = СтруктураКолонок + ", " + Колонка.Имя;
    КонецЦикла; 
    СтруктураКолонок = Сред(СтруктураКолонок, 3);
    
    Результат = Новый Массив;
    Для каждого СтрокаТЗ Из ТЗ Цикл
        Эл = Новый Структура(СтруктураКолонок);
        ЗаполнитьЗначенияСвойств(Эл, СтрокаТЗ);
        Результат.Добавить(Эл);
    КонецЦикла; 
    
    Возврат Результат;
КонецФункции

Функция   ТЗФ_ПолучитьТЗ(ТЗФ) Экспорт
    Результат = Новый ТаблицаЗначений;
    Если ТЗФ.Количество() > 0 Тогда
        СтруктураКолонок = ТЗФ[0];
        
        Для каждого КиЗ Из ТЗФ[0] Цикл
            Результат.Колонки.Добавить(КиЗ.Ключ);
        КонецЦикла; 
        
        Для каждого СтрокаТЗФ Из ТЗФ Цикл
            ЗаполнитьЗначенияСвойств(Результат.Добавить(), СтрокаТЗФ);
        КонецЦикла; 
    КонецЕсли;
    
    Возврат Результат;
КонецФункции

Функция   ТЗФ2ТЗ(ТЗФ) Экспорт
    Возврат ТЗФ_ПолучитьТЗ(ТЗФ);
КонецФункции
 
Функция   ТЗ2ТЗФ(ТЗ) Экспорт
    Возврат ТЗФ_Создать(ТЗ);
КонецФункции

Функция   ТЗФ_ВывестиВТабДок(ТЗФ) Экспорт
    ТЗ = ТЗФ2ТЗ(ТЗФ);
    ТабДок = ТЗ_ВывестиВТабДок(ТЗ);
    Возврат ТабДок;
КонецФункции

