////#Область РедакторФормул

Функция   РедакторФормул_Выполнить(ДанныеФормулы, Контекст) Экспорт
    Результат = Новый Структура("Результат");
    ТЗФ = КопияОбъекта(ДанныеФормулы.СоставФормулы);
    
    Если ДанныеФормулы.Вид = Перечисления.ИА_БФФормулыТип.Строка Тогда
        Для каждого Стр Из ТЗФ Цикл
            Попытка
                Если Стр.Вид = 0 Тогда
                	Значение = Вычислить(Стр.ПутьДанных);
                Иначе
                    Значение = Стр.Данные;
                КонецЕсли; 
            Исключение
                ТекстОшибки = ОписаниеОшибки();
                Значение = "{Ошибка: " + ТекстОшибки + "}"
            КонецПопытки; 
            
            Стр.Вставить("Значение", "" + Значение);
        КонецЦикла; 
        
        Текст = "";
        Для каждого Стр Из ТЗФ Цикл
            Текст = Текст + Стр.Значение;
        КонецЦикла;
        
        Результат.Результат = Текст;
    ИначеЕсли ДанныеФормулы.Вид = Перечисления.ИА_БФФормулыТип.ОдноЗначение Тогда
        Если ТЗФ.Количество() = 0 Тогда
        	Значение = Неопределено;
        Иначе
            Стр = ТЗФ[0];
            Попытка
                Если Стр.Вид = 0 Тогда
                	Значение = Вычислить(Стр.ПутьДанных);
                Иначе
                    Значение = Стр.Данные;
                КонецЕсли; 
            Исключение
                ТекстОшибки = ОписаниеОшибки();
                Значение = "{Ошибка: " + ТекстОшибки + "}"
            КонецПопытки; 
        КонецЕсли; 
               
        Результат.Результат = Значение;
    КонецЕсли; 
    
    Возврат Результат;
КонецФункции

