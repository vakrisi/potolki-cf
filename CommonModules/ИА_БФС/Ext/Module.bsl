КонецФункции

Функция   Запрос_ВыполнитьПакетСИменами(ТекстЗапроса
    , СтруктураПараметров = Неопределено
    , ВыгрузитьВТЗ = Ложь
    , УдалятьПустыеТипы = Истина) Экспорт
    
    Маркер = "БФ_ИмяТаб";
    Запрос = Новый Запрос(ТекстЗапроса);
    Если СтруктураПараметров <> Неопределено Тогда
        Для каждого КиЗ Из СтруктураПараметров Цикл
            Запрос.УстановитьПараметр(КиЗ.Ключ, КиЗ.Значение);	
        КонецЦикла; 
    КонецЕсли; 
    
    ТабИмен = ТЗ_НоваяТаблицаЗначений("Номер, Имя");
    МассивЗапросов = иа_бфкс.Строка2Массив(ТекстЗапроса + ";", ";", """");
    
    НомерЗапроса = 0;
    Для каждого ТекстПодзапроса Из МассивЗапросов Цикл                
        ПозицияИмени = Найти(Врег(ТекстПодзапроса), Врег(" КАК " + Маркер));
    	Если ПозицияИмени > 0 Тогда
        	// "" как БФ_ИмяТаб 
            Счетчик             = ПозицияИмени;
            ПозицияНачала       = 0;
            ПозицияКонца        = 0;
            
            Пока Счетчик >= 0 Цикл
                Если Сред(ТекстПодзапроса, Счетчик, 1) = """" Тогда
                	Если ПозицияКонца = 0 Тогда
                    	ПозицияКонца  = Счетчик;
                    Иначе
                        ПозицияНачала = Счетчик + 1;
                        Прервать;
                    КонецЕсли; 
                КонецЕсли; 
                
            	Счетчик = Счетчик - 1;
            КонецЦикла; 
            
            ИмяТаблицы = Сред(ТекстПодзапроса, ПозицияНачала, ПозицияКонца - ПозицияНачала);
            
            НовСтрока = ТабИмен.Добавить();
            НовСтрока.Номер = НомерЗапроса;
            НовСтрока.Имя   = ИмяТаблицы;
        КонецЕсли; 
        НомерЗапроса = НомерЗапроса + 1;
    КонецЦикла;  
    
    Пакет = Запрос.ВыполнитьПакет();
    
    Результат = Новый Структура;
    Для каждого Стр Из ТабИмен Цикл
        Данные = Пакет[Стр.Номер];
        
        Если ВыгрузитьВТЗ Тогда
        	Данные = Данные.Выгрузить();
            
            Если УдалятьПустыеТипы Тогда
    	        Данные = ТЗ_УдалитьПустыеТипы(Данные);
            КонецЕсли; 
        КонецЕсли; 
        
    	Результат.Вставить(Стр.Имя, Данные);
    КонецЦикла;  
    
    Возврат Результат;
КонецФункции



Функция   Запрос_ВыполнитьСкалярный(ТекстЗапроса, СтруктураПараметров = Неопределено, ИмяПоля = "Результат", ЗначениеПоУмолчанию = Неопределено) Экспорт
    Результат = ЗначениеПоУмолчанию;
    Запрос = Новый Запрос(ТекстЗапроса);
    
    Если СтруктураПараметров <> Неопределено Тогда
        Для каждого КиЗ Из СтруктураПараметров Цикл
            Запрос.УстановитьПараметр(КиЗ.Ключ, КиЗ.Значение);	
        КонецЦикла; 
    КонецЕсли; 
    
    РезультатЗапроса = Запрос.Выполнить();
    Выборка = РезультатЗапроса.Выбрать();
    Если Выборка.Следующий() Тогда
        Результат = Выборка[ИмяПоля];
    Иначе
        ТЗ = РезультатЗапроса.Выгрузить();
        ТЗ = ТЗ_УдалитьПустыеТипы(ТЗ);
        Результат = ТЗ.Добавить().Результат;
    КонецЕсли; 
    Возврат Результат;
КонецФункции

Функция   Запрос_ВыполнитьВСтруктуру(ТекстЗапроса, СтруктураПараметров= Неопределено) Экспорт
    Результат = Новый Структура;
    Запрос = Новый Запрос(ТекстЗапроса);
    
    Если СтруктураПараметров <> Неопределено Тогда
        Для каждого КиЗ Из СтруктураПараметров Цикл
            Запрос.УстановитьПараметр(КиЗ.Ключ, КиЗ.Значение);	
        КонецЦикла; 
    КонецЕсли;
    
    РезультатЗапроса = Запрос.Выполнить();
    Для каждого Колонка Из РезультатЗапроса.Колонки Цикл
        М = Колонка.ТипЗначения.Типы();
        Ц = 0;
        Пока Ц < М.Количество() Цикл
            Если М[Ц] = Тип("Null") Тогда
                М.Удалить(Ц);
            Иначе
                Ц = Ц + 1;
            КонецЕсли; 
        КонецЦикла; 
        
        ОписаниеТипа = Новый ОписаниеТипов(М); 
        ПустоеЗначение = ОписаниеТипа.ПривестиЗначение(Неопределено);
    	Результат.Вставить(Колонка.Имя, ПустоеЗначение);
    КонецЦикла; 
    
    Если НЕ РезультатЗапроса.Пустой() Тогда
        Выборка = РезультатЗапроса.Выбрать();
        Выборка.Следующий();
        ЗаполнитьЗначенияСвойств(Результат, Выборка);
    КонецЕсли; 
    
    Возврат Результат;
КонецФункции

Функция   Запрос_ВыполнитьВТЗ(ТекстЗапроса, СтруктураПараметров = Неопределено, УдалятьПустыеТипы = Истина) Экспорт
    Результат = Новый Структура;
    Запрос = Новый Запрос(ТекстЗапроса);
    Если СтруктураПараметров <> Неопределено Тогда
        Для каждого КиЗ Из СтруктураПараметров Цикл
            Запрос.УстановитьПараметр(КиЗ.Ключ, КиЗ.Значение);	
        КонецЦикла; 
    КонецЕсли; 
    
    Результат = Запрос.Выполнить().Выгрузить();
    
    Если УдалятьПустыеТипы Тогда
    	Результат = ТЗ_УдалитьПустыеТипы(Результат);
    КонецЕсли; 
    
    Возврат Результат;
КонецФункции

