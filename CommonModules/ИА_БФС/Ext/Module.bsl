// Выполняет удаление строк из ТЗ(Или другой коллекции, для которой возможно обращение к строкам и удаление через индекс)
// Параметры:
// Таб - ТаблицаЗначений, ТабличнаяЧасть - То, откуда надо удалить строки
//                                         Или другая коллекция, для которой возможно обращение к строкам и удаление через индекс.
// Условие - Строка - Фрагмент кода, который будет выполнен через "Вычислить".
//                    Обращаться к строке надо через "СтрокаТЗ."
//                    Должен вернуть ИСТИНА, если надо удалить строку, иначе ЛОЖЬ.
// Контекст - Произвольный - Для передачи любых данных. Обычно удобно использовать структуру.
Процедура ТЗ_УдалитьСтрокиПоУсловию(Таб, Условие, Контекст=Неопределено) Экспорт
    Ц = 0;
    Пока Ц < Таб.Количество() Цикл
        СтрокаТЗ = Таб[Ц];
        УдалитьСтроку = Вычислить(Условие);
        Если УдалитьСтроку Тогда
            Таб.Удалить(Ц);
        Иначе
            Ц = Ц + 1;
        КонецЕсли;
    КонецЦикла;
КонецПроцедуры

// Создаёт отфильтрованную копию ТЗ или ТЧ, с помощью "ТЗ_УдалитьСтрокиПоУсловию"
// Пример:  ТЗ_ФильтрПоУсловию(ТЗ, "СтрокаТЗ.Количество >  0 ИЛИ СтрокаТЗ.Номенклатура=Контекст", ВыбНоменклатура);
// Параметры:
// ТЗ - ТаблицаЗначений, ТабличнаяЧасть - Источник. Должен поддерживать получение копии через "Скопировать" или "Выгрузить".
// Условие - Строка - Фрагмент кода, который будет выполнен через "Вычислить".
//                    Обращаться к строке надо через "СтрокаТЗ."
//                    Должен вернуть ИСТИНА, если надо удалить строку, иначе ЛОЖЬ.
// Контекст - Произвольный - Для передачи любых данных. Обычно удобно использовать структуру.
Функция   ТЗ_ФильтрПоУсловию(ТЗ, Условие, Контекст=Неопределено) Экспорт
    Попытка
        Таб = ТЗ.Выгрузить();
    Исключение
        Таб = ТЗ.Скопировать();
    КонецПопытки;
    ТЗ_УдалитьСтрокиПоУсловию(Таб, "НЕ (" + Условие + ") ", Контекст);
    Возврат Таб;
КонецФункции

// Создаёт отфильтрованную копию ТЗ или ТЧ, с помощью "НайтиСтроки"
// Параметры:
// ТЗ - ТаблицаЗначений, ТабличнаяЧасть - Источник. Должен поддерживать получение копии через "Скопировать" или "Выгрузить".
// Отбор - Структура - Структура для поиска через "НайтиСтроки"
Функция   ТЗ_ФильтрПоОтбору(ИсходнаяТЗ, Отбор) Экспорт
    Попытка
        Таб = ИсходнаяТЗ.Выгрузить();
    Исключение
        Таб = ИсходнаяТЗ.Скопировать();
    КонецПопытки;
    Возврат Таб.Скопировать(Таб.НайтиСтроки(Отбор));
КонецФункции

//   Выполняет вычитание таблицы из "ТЗ1" "ТЗ2" значений в разрезе "измерений" по суммовым колонкам "Ресурсы"
// и если "УдалятьСтрокиСРесурсами0" = ИСТИНЕ удаляет строки со всеми нулевыми ресурсами
// ПРИМЕР
// ТЗ1:______________________________________
// |Код |Контрагент|Договор|Количество|Сумма|
// |0001|Молоко    |Дог1   |      1   | 1500|
// |0002|Молоко    |Дог1   |      2   | 1500|
// |0002|Молоко    |Дог1   |      2   | 1500|
// |0003|Второй    |Дог1   |      0   |    0|
//
// ТЗ2:______________________________________
// |Код |Контрагент|Договор|Количество|Сумма|
// |0001|Молоко    |Дог1   |      1   | 1500|
// |0002|Молоко    |Дог1   |      2   | 1500|
// |0003|Второй    |Дог1   |      1   |   10|
// 
// ВЫПОЛНЕНИЕ: ТЗ_Вычесть(ТЗ1, ТЗ2, "Код, Договор", "Количество, Сумма")
// |0002|Молоко    |Дог1   |      2   | 1500|
// |0003|Второй    |Дог1   |     -1   |  -10|
// 
// Параметры:
// {НаименованиеПараметра} - % (тип параметра) - % (описание параметра)
// {НаименованиеПараметра} - % (описание параметра) 
Функция   ТЗ_Вычесть(ТЗ1, ТЗ2, Измерения, Ресурсы, УдалятьСтрокиСРесурсами0 = Истина) Экспорт
    КолонкиРесурсы = Новый Структура(Ресурсы);
    //{ Колонки-"ресурсы" м.б. с типом "неотрицательное"
    Таб = ТЗ1.СкопироватьКолонки();
    Для каждого Эл Из КолонкиРесурсы Цикл
        Таб.Колонки.Удалить(Эл.Ключ);
        Таб.Колонки.Добавить(Эл.Ключ);
    КонецЦикла;
    //}
    
    //{ Заполнение временной таблицы
    Для каждого СтрокаТЗ Из ТЗ1 Цикл
        ЗаполнитьЗначенияСвойств(Таб.Добавить(), СтрокаТЗ);
    КонецЦикла;
    
    Для каждого СтрокаТЗ Из ТЗ2 Цикл
        НовСтрока = Таб.Добавить();
        ЗаполнитьЗначенияСвойств(НовСтрока, СтрокаТЗ);
        Для каждого Эл Из КолонкиРесурсы Цикл
            НовСтрока[Эл.Ключ] = -НовСтрока[Эл.Ключ];
        КонецЦикла;
    КонецЦикла;
    Таб.Свернуть(Измерения, Ресурсы);
    //}
    
    //{ Удалим строки с ресурсами =0
    Если УдалятьСтрокиСРесурсами0 Тогда
        Ц = 0;
        Пока Ц < Таб.Количество() Цикл
            НадоУдалить = Истина;
            СтрокаТЗ = Таб[Ц];
            Для каждого Эл Из КолонкиРесурсы Цикл
                Если СтрокаТЗ[Эл.Ключ] <> 0 Тогда
                    НадоУдалить = Ложь;
                    Прервать;
                КонецЕсли;
            КонецЦикла;
            Если НадоУдалить Тогда
                Таб.Удалить(Ц);
            Иначе
                Ц = Ц + 1;
            КонецЕсли;
        КонецЦикла;
    КонецЕсли;
    //}
    Возврат Таб;
КонецФункции

Процедура ТЗ_ЗаполнитьПоТаблице(ТЗИсточник, ТЗПриемник, ОчиститьПриемник = Истина) Экспорт
    Если ОчиститьПриемник Тогда
        ТЗПриемник.Очистить();
    КонецЕсли; 
    Для каждого СтрокаТЗ Из ТЗИсточник Цикл
        ЗаполнитьЗначенияСвойств(ТЗПриемник.Добавить(), СтрокаТЗ);
    КонецЦикла; 
КонецПроцедуры

Процедура ТЗ_ВыполнитьПоСтроке(ТЗ, Код, Контекст = Неопределено) Экспорт
    ОбщийКод = "Для каждого СтрокаТЗ Из ТЗ Цикл " + Код + " КонецЦикла;";
	УстановитьБезопасныйРежим(Истина);
    Выполнить(ОбщийКод);
	УстановитьБезопасныйРежим(Ложь);
КонецПроцедуры

Функция   ТЗ_ПредставлениеСтроки(ДанныеСтроки, КолонкиТаблицы = Неопределено, ПорядокСледования="", ИсключенныеКолонки="", СписокОбъектовМДДляСинонимов=Неопределено, Кэш = Неопределено) Экспорт
    Если КолонкиТаблицы = Неопределено Тогда
    	КолонкиТаблицы = ДанныеСтроки.Владелец().Колонки;
    КонецЕсли; 
    
    Если Кэш <> Неопределено Тогда
        СписокКолонок = Кэш;
    Иначе
        Стр = СтрЗаменить("," + ПорядокСледования + ",", ",", Символы.ПС);
        
        СписокКолонок = Новый ТаблицаЗначений;
        СписокКолонок.Колонки.Добавить("Имя");
        СписокКолонок.Колонки.Добавить("Синоним");
        СписокКолонок.Колонки.Добавить("Значение");
        
        Для Ц = 1 По СтрЧислоВхождений(Стр, Символы.ПС) Цикл
            ПодСтрока = СокрЛП(Врег(СтрПолучитьСтроку(Стр, Ц)));
             Если ЗначениеЗаполнено(ПодСтрока) И СписокКолонок.Найти(ПодСтрока, "Имя") = Неопределено Тогда
                НовСтрока = СписокКолонок.Добавить();
				НовСтрока.Имя = ПодСтрока;
				НовСтрока.Синоним = СокрЛП(СтрПолучитьСтроку(Стр, Ц));
            КонецЕсли; 
        КонецЦикла; 
        
        СтрИсключенныеКолонки = Новый Структура(Врег(ИсключенныеКолонки));
        Для каждого Колонка Из КолонкиТаблицы Цикл
            Имя = Врег(Колонка.Имя);
            Если СписокКолонок.Найти(Имя, "Имя") = Неопределено
                И НЕ СтрИсключенныеКолонки.Свойство(Имя)
                Тогда
                НовСтрока = СписокКолонок.Добавить();
                НовСтрока.Имя = Имя;
                НовСтрока.Синоним = Колонка.Имя;
            КонецЕсли; 
        КонецЦикла; 
        
        Если СписокОбъектовМДДляСинонимов <> Неопределено Тогда
            Для каждого СтрокаТЗ Из СписокКолонок Цикл
                Для каждого Эл Из СписокОбъектовМДДляСинонимов Цикл
                    Элемент = Эл.Найти(СтрокаТЗ.Имя);
                    Если Элемент <> Неопределено Тогда
                        СтрокаТЗ.Синоним = Элемент.Синоним;
                        Прервать;
                    КонецЕсли; 
                КонецЦикла; 
                Если НЕ ЗначениеЗаполнено(СтрокаТЗ.Синоним) Тогда
                    СтрокаТЗ.Синоним = Трег(СтрокаТЗ.Имя);
                КонецЕсли; 
            КонецЦикла; 
        КонецЕсли; 
        Для каждого СтрокаТЗ Из СписокКолонок Цикл
            Если НЕ ЗначениеЗаполнено(СтрокаТЗ.Синоним) Тогда
            	СтрокаТЗ.Синоним = СтрокаТЗ.Имя;
            КонецЕсли; 
        КонецЦикла;
        Кэш = СписокКолонок;
    КонецЕсли; 
    Результат = "";
    
    Для каждого СтрокаТЗ Из СписокКолонок Цикл
        Попытка
            Значение = ДанныеСтроки[СтрокаТЗ.Имя];
            Если НЕ ЗначениеЗаполнено(Значение) Тогда
                Значение = "<пусто>";
            КонецЕсли; 
            Результат = Результат + "; " + СтрокаТЗ.Синоним + " = " + Значение;
        Исключение
            Ошибка = ОписаниеОшибки();
        КонецПопытки; 
    КонецЦикла; 
    
    Результат = Сред(Результат, 3);
    Возврат Результат;
КонецФункции

Функция   ТЗ_ВыгрузитьУникальныеЗначенияКолонки(ТЗ, ИмяКолонки) Экспорт
    ВремТаб = ТЗ.Скопировать(,ИмяКолонки);
    ВремТаб.Свернуть(ИмяКолонки);
    Возврат ВремТаб.ВыгрузитьКолонку(ИмяКолонки);
КонецФункции

Функция   ТЗ_ПоПолюМакс(ТЗ, ИмяПоля) Экспорт
    Если ТЗ.Количество() = 0 Тогда
        ВремТЗ = ТЗ.СкопироватьКолонки();
        ТЗ_УдалитьПустыеТипы(ВремТЗ);
        Результат = ВремТЗ.Добавить()[ИмяПоля];
    Иначе
        Результат = ТЗ[0][ИмяПоля];
        Для каждого СтрокаТЗ Из ТЗ Цикл
            Значение = СтрокаТЗ[ИмяПоля];
            Если Результат < Значение Тогда
                Результат = Значение;
            КонецЕсли; 
        КонецЦикла; 
    КонецЕсли; 
    Возврат Результат;
КонецФункции

Функция   ТЗ_ПоПолюМин(ТЗ, ИмяПоля) Экспорт
    Если ТЗ.Количество() = 0 Тогда
        ВремТЗ = ТЗ.СкопироватьКолонки();
        ТЗ_УдалитьПустыеТипы(ВремТЗ);
        Результат = ВремТЗ.Добавить()[ИмяПоля];
    Иначе
        Результат = ТЗ[0][ИмяПоля];
        Для каждого СтрокаТЗ Из ТЗ Цикл
            Значение = СтрокаТЗ[ИмяПоля];
            Если Результат > Значение Тогда
                Результат = Значение;
            КонецЕсли; 
        КонецЦикла; 
    КонецЕсли; 
    Возврат Результат;
КонецФункции

Функция   ТЗ_ВывестиВТабДок(ТЗ
    , Заголовок = Неопределено
    , ВыводитьНПП = Истина
    , СоздатьФорматСтрок = Ложь
    , СгруппироватьСтроки = Ложь
    , НастройкиОформления = Неопределено
    ) Экспорт
    
    ТабНастройкиПолей = Новый ТаблицаЗначений;
    ТабНастройкиПолей.Колонки.Добавить("Имя");
    ТабНастройкиПолей.Колонки.Добавить("Заголовок");
    ТабНастройкиПолей.Колонки.Добавить("ТипЗначения");
    ТабНастройкиПолей.Колонки.Добавить("Ресурс");
    
    Если ТипЗнч(НастройкиОформления) = Тип("Структура") Тогда
        Если НастройкиОформления.Свойство("Поля") Тогда
            Для каждого Стр Из НастройкиОформления.Поля Цикл
                НовСтрока = ТабНастройкиПолей.Добавить();
            	ЗаполнитьЗначенияСвойств(НовСтрока, Стр);
                НовСтрока.Ресурс = НовСтрока.Ресурс = Истина;
            КонецЦикла;  
        КонецЕсли; 
    Иначе
        НастройкиОформления = Новый Структура;
    КонецЕсли; 
    
    ИмяКолонкиНПП = "__НПП__";
    Результат = ТЗ.Скопировать();	
    Если ВыводитьНПП Тогда
        Результат.Колонки.Вставить(0, ИмяКолонкиНПП);
        Ц = 1;
        Для каждого СтрокаТЗ Из Результат Цикл
            СтрокаТЗ[ИмяКолонкиНПП] = Ц;
            Ц = Ц + 1;
        КонецЦикла; 
    КонецЕсли; 
    
    СхемаКомпоновкиДанных = Новый СхемаКомпоновкиДанных;
    ДанныеРасшифровки = Новый ДанныеРасшифровкиКомпоновкиДанных;
    
    Источник = СхемаКомпоновкиДанных.ИсточникиДанных.Добавить();
    Источник.Имя = "ЛокальнаяБаза";
    Источник.СтрокаСоединения = "";
    Источник.ТипИсточникаДанных = "Local";
    
    НаборДанных = СхемаКомпоновкиДанных.НаборыДанных.Добавить(Тип("НаборДанныхОбъектСхемыКомпоновкиДанных"));
    НаборДанных.Имя = "Реестр";
    НаборДанных.ИсточникДанных = "ЛокальнаяБаза";
    НаборДанных.ИмяОбъекта = "Реестр";
    ЕстьСумма = Ложь;
    Для каждого ТекКолонка Из Результат.Колонки Цикл
        ПолеНабораДанных = НаборДанных.Поля.Добавить(Тип("ПолеНабораДанныхСхемыКомпоновкиДанных") );
        ПолеНабораДанных.Поле = ТекКолонка.Имя;
        ПолеНабораДанных.ПутьКДанным = ТекКолонка.Имя;
        
        
        СтрокаОформления = ТабНастройкиПолей.Найти(ТекКолонка.Имя, "Имя");
        Если СтрокаОформления = Неопределено Тогда
        	ПолеНабораДанных.Заголовок = ТекКолонка.Имя;
        Иначе
            ПолеНабораДанных.Заголовок   = СтрокаОформления.Заголовок;
            Если СтрокаОформления.ТипЗначения <> Неопределено Тогда
            	ПолеНабораДанных.ТипЗначения = СтрокаОформления.ТипЗначения;
            КонецЕсли; 
        КонецЕсли; 
    КонецЦикла;
    
    Настройки = СхемаКомпоновкиДанных.ВариантыНастроек[0].Настройки;
    
    // Общие настройки СКД
    Для каждого Эл Из Настройки.ПараметрыВывода.Элементы Цикл
        Если Эл.Параметр = Новый ПараметрКомпоновкиДанных("МакетОформления")
            И НастройкиОформления.Свойство("МакетОформления") Тогда
            Эл.Значение = НастройкиОформления.МакетОформления;
            Эл.Использование =Истина;
        ИначеЕсли Эл.Параметр = Новый ПараметрКомпоновкиДанных("АвтоПозицияРесурсов") Тогда
            Эл.Значение = АвтоПозицияРесурсовКомпоновкиДанных.НеИспользовать;
            Эл.Использование = Истина;
        КонецЕсли; 
    КонецЦикла;  

    // Ресурсы
    Для каждого Стр Из ТабНастройкиПолей Цикл
    	Если Стр.Ресурс Тогда
        	Эл                  = СхемаКомпоновкиДанных.ПоляИтога.Добавить();
            Эл.ПутьКДанным      = Стр.Имя;
            Эл.Выражение        = "Сумма(" + Стр.Имя + ")";
        КонецЕсли; 
    КонецЦикла;  
    
    
    НоваяГруппировка = Настройки.Структура.Добавить(Тип("ГруппировкаКомпоновкиДанных"));
    ////ЭлементУсловногоОформления = НоваяГруппировка.УсловноеОформление.Элементы.Добавить();
    ////ЭлементУсловногоОформления.Использование = Истина;
    
    НоваяГруппировка.Выбор.Элементы.Добавить(Тип("АвтоВыбранноеПолеКомпоновкиДанных"));
    НоваяГруппировка.Порядок.Элементы.Добавить(Тип("АвтоЭлементПорядкаКомпоновкиДанных"));
    
    
    Для каждого ТекКолонка Из Результат.Колонки Цикл
        ВыбПоле = Настройки.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
        ВыбПоле.Использование = Истина;
        Если ТекКолонка.Имя = ИмяКолонкиНПП Тогда
            ВыбПоле.Заголовок = "№ п/п";
        Иначе
            СтрокаОформления = ТабНастройкиПолей.Найти(ТекКолонка.Имя, "Имя");
            Если СтрокаОформления = Неопределено Тогда
                ВыбПоле.Заголовок = ТекКолонка.Заголовок;
            Иначе
                ВыбПоле.Заголовок   = СтрокаОформления.Заголовок;
            КонецЕсли; 
        КонецЕсли; 
        ВыбПоле.Поле = Новый ПолеКомпоновкиДанных(ТекКолонка.Имя);
    КонецЦикла;
    
    // СКД_СохранитьВФайл(СхемаКомпоновкиДанных, "C:\temp\схема.xml"); // Отладка с записью в файл
    
    КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
    Макет = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, Настройки, ДанныеРасшифровки);
    
    ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
    ПроцессорКомпоновки.Инициализировать(Макет, Новый Структура("Реестр", Результат), ДанныеРасшифровки);
    
    ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
    
    ТабДок = Новый ТабличныйДокумент;
    
    Если Заголовок <> Неопределено Тогда
        Макет = Новый ТабличныйДокумент;
        Обл = Макет.Область(2, 1, 2, 1);
        Обл.Текст = "" + Заголовок;
        Обл.Шрифт = Новый Шрифт(,,Истина);
        ТабДок.Вывести(Макет);
    КонецЕсли; 
    
    ПроцессорВывода.УстановитьДокумент(ТабДок);
    Если СгруппироватьСтроки  Тогда
        ТабДок.НачатьГруппуСтрок();
    КонецЕсли; 
    
    ПроцессорВывода.НачатьВывод();
    ЭлементРезультата = ПроцессорКомпоновки.Следующий();
    Пока НЕ ЭлементРезультата = Неопределено Цикл
        #Если Клиент Тогда
            ОбработкаПрерыванияПользователя();
        #КонецЕсли 
        ПроцессорВывода.ВывестиЭлемент(ЭлементРезультата);
        Если ЭлементРезультата.ЗначенияПараметров.Количество() > 0 Тогда
            Для счКол = 1 по ТабДок.ШиринаТаблицы Цикл
                ТекРасшифровкаИдентификатор = ТабДок.Область(ТабДок.ВысотаТаблицы,счКол).Расшифровка;
                Попытка
                    ТабДок.Область(ТабДок.ВысотаТаблицы,счКол).Расшифровка = ДанныеРасшифровки.Элементы[ТекРасшифровкаИдентификатор].ПолучитьПоля()[0].Значение
                Исключение
                КонецПопытки; 
            КонецЦикла;
        КонецЕсли;
        ЭлементРезультата = ПроцессорКомпоновки.Следующий();
    КонецЦикла;
    ПроцессорВывода.ЗакончитьВывод();
    
    Если СгруппироватьСтроки  Тогда
        ТабДок.ЗакончитьГруппуСтрок();
    КонецЕсли;
    
    Если НастройкиОформления.Свойство("СкрытьШапку") Тогда
        ТабДок.УдалитьОбласть(
        ТабДок.Область(?(Заголовок <> Неопределено, 3, 1), 1, ТабДок.ФиксацияСверху, ТабДок.ШиринаСтраницы)
        , ТипСмещенияТабличногоДокумента.ПоВертикали);
    КонецЕсли; 

    Если СоздатьФорматСтрок Тогда
    	ТабДок.Область().СоздатьФорматСтрок();
    КонецЕсли; 
    
    ТабДок.ОтображатьСетку = Ложь;
    ТабДок.ТолькоПросмотр = Истина;
    Возврат ТабДок; 
КонецФункции

Процедура ТЗ_УдалитьДубликаты(ТЗ, Измерения) Экспорт
    Отбор = Новый Структура(Измерения);
    
    Ц = 0;
    Пока Ц < ТЗ.Количество() Цикл
        СтрокаТЗ = ТЗ[Ц];
        ЗаполнитьЗначенияСвойств(Отбор, СтрокаТЗ);
        Удалять = ТЗ.НайтиСтроки(Отбор).Количество() > 1;
        Если Удалять Тогда
            ТЗ.Удалить(Ц);
        Иначе
            Ц = Ц + 1;
        КонецЕсли; 
    КонецЦикла; 
КонецПроцедуры

Процедура ТЗ_ДобавитьСтроку(ТЗ
    , Значение1 = Неопределено
    , Значение2 = Неопределено
    , Значение3 = Неопределено
    , Значение4 = Неопределено
    , Значение5 = Неопределено
    , Значение6 = Неопределено
    , Значение7 = Неопределено
    , Значение8 = Неопределено
    , Значение9 = Неопределено) Экспорт
    
    М = Новый Массив;
    М.Добавить(Значение1);
    М.Добавить(Значение2);
    М.Добавить(Значение3);
    М.Добавить(Значение4);
    М.Добавить(Значение5);
    М.Добавить(Значение6);
    М.Добавить(Значение7);
    М.Добавить(Значение8);
    М.Добавить(Значение9);
    
    НовСтрока = ТЗ.Добавить();
    
    Для Счетчик = 1 По 9 Цикл
        Значение = М[Счетчик - 1];
        Если Значение = Неопределено ИЛИ ТЗ.Колонки.Количество() < Счетчик Тогда
            Прервать;
        КонецЕсли;
        ИмяКолонки = ТЗ.Колонки[Счетчик - 1].Имя;
        НовСтрока[ИмяКолонки] = Значение;
    КонецЦикла;
КонецПроцедуры

Функция   ТЗ_СвернутьСДопКолонками(ТЗ, Измерения, Ресурсы, ДопКолонки = Неопределено, ИсключаемыеДопКолонки = "") Экспорт
    струкИзмерения = Новый Структура(Измерения);
    струкРесурсы   = Новый Структура(Ресурсы);
    струкИсключаемыеДопКолонки = Новый Структура(ИсключаемыеДопКолонки);
    Если ДопКолонки = Неопределено Тогда
        ДопКолонки = "";
        Для каждого Колонка Из ТЗ.Колонки Цикл
            Если НЕ струкИзмерения.Свойство(Колонка.Имя)
                И НЕ струкРесурсы.Свойство(Колонка.Имя)
                И Не струкИсключаемыеДопКолонки.Свойство(Колонка.Имя)
                Тогда
                ДопКолонки = ДопКолонки + "," + Колонка.Имя;
            КонецЕсли; 
        КонецЦикла;
        ДопКолонки = Сред(ДопКолонки, 2);
    КонецЕсли; 
    струкДопКолонки = Новый Структура(ДопКолонки);
    
    СтрокаКолонокИзмеренийРесурсов = Сред(?(ЗначениеЗаполнено(Измерения), "," + Измерения, "")
    + ?(ЗначениеЗаполнено(Ресурсы), "," + Ресурсы, ""), 2);
    
    СтрокаКолонокВсех = Сред(
    ?(ЗначениеЗаполнено(СтрокаКолонокИзмеренийРесурсов), "," + СтрокаКолонокИзмеренийРесурсов, "")
    + ?(ЗначениеЗаполнено(ДопКолонки), "," + ДопКолонки, ""), 2);
    
    ТабРезультат = ТЗ.СкопироватьКолонки(СтрокаКолонокВсех);
    Для каждого КиЗ Из струкИсключаемыеДопКолонки Цикл
        Если ТабРезультат.Колонки.Найти(КиЗ.Ключ) <> Неопределено Тогда
            ТабРезультат.Колонки.Удалить(КиЗ.Ключ);
        КонецЕсли; 
    КонецЦикла; 
    
    Таб = ТЗ.Скопировать(, СтрокаКолонокИзмеренийРесурсов);
    Таб.Свернуть(Измерения, Ресурсы);
    
    Для каждого СтрокаТЗ Из Таб Цикл
        НовСтрока = ТабРезультат.Добавить();
        
        ЗаполнитьЗначенияСвойств(струкИзмерения, СтрокаТЗ);
        М = ТЗ.НайтиСтроки(струкИзмерения);
        Если М.Количество() > 0 Тогда
            СтрокаИсточник = М[0];
            ЗаполнитьЗначенияСвойств(НовСтрока, СтрокаИсточник);	
        КонецЕсли; 
        
        ЗаполнитьЗначенияСвойств(НовСтрока, СтрокаТЗ);
    КонецЦикла; 
    
    Возврат ТабРезультат;
КонецФункции

Процедура ТЗ_ВставитьТЗПоИзмерениямВДругую(ТЗ, ТЗПриемник, Отбор) Экспорт
    // Удалим старое
    М = ТЗПриемник.НайтиСтроки(Отбор);
    Для каждого СтрокаТЗ Из М Цикл
        ТЗПриемник.Удалить(СтрокаТЗ);
    КонецЦикла;
    
    // Добавим новое
    Для каждого СтрокаТЗ Из ТЗ Цикл
        ЗаполнитьЗначенияСвойств(ТЗПриемник.Добавить(), СтрокаТЗ);
    КонецЦикла; 
КонецПроцедуры

Процедура ТЗ_ВставитьСтрокиТаблицуВДругуюПоКлючевымРеквзитам(ТЗИсточник, ТЗПриемник
    , Измерения, Дополнить = Истина, УдалитьЛишнее = Ложь) Экспорт
    
    Отбор = Новый Структура(Измерения);
    Для каждого Стр Из ТЗИсточник Цикл
    	ЗаполнитьЗначенияСвойств(Отбор, Стр);
        М = ТЗПриемник.НайтиСтроки(Отбор);
        Если      М.Количество() = 0 Тогда
            Если НЕ Дополнить Тогда
            	Продолжить;
            КонецЕсли; 
            СтрокаПриемник = ТЗПриемник.Добавить();
            ЗаполнитьЗначенияСвойств(СтрокаПриемник, Отбор);
        ИначеЕсли М.Количество() > 1 Тогда
            СтрокаПриемник = М[0];
            Для Ц = 1 По М.Количество() - 1 Цикл
            	ТЗПриемник.Удалить(М[Ц]);
            КонецЦикла;             
        Иначе
            СтрокаПриемник = М[0];
        КонецЕсли; 
        ЗаполнитьЗначенияСвойств(СтрокаПриемник, Стр);
    КонецЦикла; 
    
    Если УдалитьЛишнее Тогда
    	Ц = 0;
        Пока Ц < ТЗПриемник.Количество() Цикл
        	Стр = ТЗПриемник[Ц];
            ЗаполнитьЗначенияСвойств(Отбор, Стр);
            М = ТЗИсточник.НайтиСтроки(Отбор);
            Если М.Количество() > 0 Тогда
            	Ц= Ц + 1;
            Иначе
                ТЗПриемник.Удалить(Ц);
            КонецЕсли; 
        КонецЦикла; 
    КонецЕсли; 
    
КонецПроцедуры

Функция   ТЗ_ПровестиСписаниеПоПартиям(ТабДляСписания, ТаблицаПартий, Измерения, Ресурс, КолонкиПартий, КолонкиСортировки = "") Экспорт
    ТЗ  = ИА_БФС.ТЗ_СвернутьСДопКолонками(ТабДляСписания, Измерения, Ресурс);
    ТЗ.Колонки.Добавить("__Списано"  , Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(25, 8)));
    ТЗ.Колонки.Добавить("__НеХватает", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(25, 8)));
    
    СтрукКолонкиПартий = Новый Структура(КолонкиПартий);
    Для каждого КиЗ Из СтрукКолонкиПартий Цикл
        ТЗ.Колонки.Добавить(КиЗ.Ключ);
    КонецЦикла; 
    
    ТабРез = ТЗ.СкопироватьКолонки();
    
    ТабПартий = ТаблицаПартий.Скопировать();
    Если ЗначениеЗаполнено(КолонкиСортировки) Тогда
    	ТабПартий.Сортировать(КолонкиСортировки);
    КонецЕсли; 
    
    
    Отбор = Новый Структура(Измерения);
    Для каждого СтрокаСписания Из ТЗ Цикл
        ЗаполнитьЗначенияСвойств(Отбор, СтрокаСписания);
        М = ТабПартий.НайтиСтроки(Отбор);
        Если М.Количество() = 0 Тогда
            НовСтрока = ТабРез.Добавить();
            ЗаполнитьЗначенияСвойств(НовСтрока, СтрокаСписания);
            НовСтрока.__НеХватает = СтрокаСписания[Ресурс];
        Иначе
            ОсталосьСписать = СтрокаСписания[Ресурс];
            
            Ц =  0;
            Пока ОсталосьСписать > 0 И Ц < М.Количество() Цикл
                СтрокаТЗ = М[Ц];
                Если СтрокаТЗ[Ресурс] > 0 Тогда
                    Списываем = Мин(СтрокаТЗ[Ресурс], ОсталосьСписать);
                    СтрокаТЗ[Ресурс] = СтрокаТЗ[Ресурс] - Списываем;
                    ОсталосьСписать = ОсталосьСписать - Списываем;
                    
                    НовСтрока = ТабРез.Добавить();
                    ЗаполнитьЗначенияСвойств(НовСтрока, СтрокаСписания);
                    ЗаполнитьЗначенияСвойств(НовСтрока, СтрокаТЗ, КолонкиПартий);
                    НовСтрока.__Списано   = Списываем;
                    НовСтрока.__НеХватает = 0;
                КонецЕсли; 
                Ц =  Ц + 1;
            КонецЦикла; 
            
            Если НовСтрока = Неопределено Тогда
				НовСтрока = ТабРез.Добавить();
				ЗаполнитьЗначенияСвойств(НовСтрока, СтрокаСписания);
            КонецЕсли;
            НовСтрока.__НеХватает = ОсталосьСписать;
        КонецЕсли; 
    КонецЦикла; 
    Возврат ТабРез
КонецФункции

Функция   ТЗ_СтрокаТЗ2Структура(СтрокаТЗ) Экспорт
    Результат = Новый Структура;
    
    ТЗ = СтрокаТЗ.Владелец();
    Для каждого Колонка Из ТЗ.Колонки Цикл
        М = Колонка.ТипЗначения.Типы();
        Ц = 0;
        Пока Ц < М.Количество() Цикл
            Если М[Ц] = Тип("Null") Тогда
                М.Удалить(Ц);
            Иначе
                Ц = Ц + 1;
            КонецЕсли; 
        КонецЦикла; 
        
        ОписаниеТипа = Новый ОписаниеТипов(М); 
        ПустоеЗначение = ОписаниеТипа.ПривестиЗначение(Неопределено);
    	Результат.Вставить(Колонка.Имя, ПустоеЗначение);
    КонецЦикла; 
    
    ЗаполнитьЗначенияСвойств(Результат, СтрокаТЗ);
    Возврат Результат
КонецФункции

Функция   ТЗ_УдалитьПустыеТипы(ТЗ, ДобавитьПустойТипЕслиТиповНет = Ложь, ДляСтрокНеограниченнойДлиныЗадатьДлину = Ложь) Экспорт
    Результат = Новый ТаблицаЗначений;
	Для каждого Колонка Из ТЗ.Колонки Цикл
        М = Колонка.ТипЗначения.Типы();
        Если ДобавитьПустойТипЕслиТиповНет И М.Количество() = 0 Тогда
            ТипДанных = Новый ОписаниеТипов("Строка",,Новый КвалификаторыСтроки(150));
        Иначе
            Ц = 0;
            Пока Ц < М.Количество() Цикл
                Если М[Ц] = Тип("Null") Тогда
                    М.Удалить(Ц);
                Иначе
                    Ц = Ц + 1;
                КонецЕсли; 
            КонецЦикла; 
            
            ДлинаСтроки = Колонка.ТипЗначения.КвалификаторыСтроки.Длина;
            Если ДлинаСтроки = 0
                И ДляСтрокНеограниченнойДлиныЗадатьДлину
                И М.Найти(Тип("Строка")) <> Неопределено
                Тогда
                Для каждого СтрокаТЗ Из ТЗ Цикл
            	    ДлинаСтроки = Макс(ДлинаСтроки, СтрДлина(СтрокаТЗ[Колонка.Имя]));
                КонецЦикла;
                Если ДлинаСтроки = 0 Тогда
                	ДлинаСтроки = 1;
                КонецЕсли; 
            КонецЕсли; 
            ТипДанных = Новый ОписаниеТипов(М,,Новый КвалификаторыСтроки(ДлинаСтроки));
        КонецЕсли; 
        
        Результат.Колонки.Добавить(Колонка.Имя, ТипДанных);
    КонецЦикла; 
    
    Для каждого СтрокаТЗ Из ТЗ Цикл
    	ЗаполнитьЗначенияСвойств(Результат.Добавить(), СтрокаТЗ);
    КонецЦикла; 
    
    Возврат Результат;
КонецФункции

Функция   ТЗ_РазностьТаблиц(ТЗ1, ТЗ2, Измерения = "") Экспорт
    ИмяКолонки = "__Сравнение__";
    
    Если Измерения = "" Тогда
        Для каждого Колонка Из ТЗ1.Колонки Цикл
            Измерения = Измерения + ", " + Колонка.Имя;
        КонецЦикла; 
        Измерения = Сред(Измерения, 3);
    КонецЕсли; 
    
    Таб1 = ТЗ1.Скопировать();
    Таб1.Колонки.Добавить(ИмяКолонки);
    Таб1.ЗаполнитьЗначения(1, ИмяКолонки);
    
    
    Таб2 = ТЗ2.Скопировать();
    Таб2.Колонки.Добавить(ИмяКолонки);
    Таб2.ЗаполнитьЗначения(1, ИмяКолонки);
    
    Результат = ТЗ_Вычесть(Таб1, Таб2, Измерения, ИмяКолонки, Истина);
    Результат.Сортировать(Измерения);
    Возврат Результат;
КонецФункции

Функция   ТЗ_ПолучитьТипизированнуюТаблицу(ТЗ) Экспорт
    Таб = Новый ТаблицаЗначений;
    
    Для Ц = 1 По ТЗ.Количество() Цикл Таб.Добавить() КонецЦикла; 
    
    Для каждого Колонка Из ТЗ.Колонки Цикл
        МассивЗначений = ТЗ.ВыгрузитьКолонку(Колонка);
        
        // Получаем типы значений, которые используются в колонке
        Соответствие = Новый Соответствие;
        СтТипЗначения = ТипЗнч(Неопределено);
        Для каждого Значение Из МассивЗначений Цикл
            ТипЗначения = ТипЗнч(Значение);
            Если СтТипЗначения <> ТипЗначения Тогда
                СтТипЗначения = ТипЗначения;
                Соответствие.Вставить(ТипЗначения);
            КонецЕсли;
        КонецЦикла;
        
         // Преобразуем соответствие в массив типов значений
        МассивТипов = Новый Массив;
        Для каждого КлючИЗначение Из Соответствие Цикл
            МассивТипов.Добавить(КлючИЗначение.Ключ);
        КонецЦикла;
        
        Если МассивТипов.Количество() = 0 или МассивТипов.Количество() = 1 и МассивТипов[0] = ТипЗнч(Неопределено) Тогда
            ОпТипов = Новый ОписаниеТипов("Строка")
        Иначе
            ОпТипов = Новый ОписаниеТипов(МассивТипов);
        КонецЕсли;    
        Таб.Колонки.Добавить(Колонка.Имя, ОпТипов);
        Таб.ЗагрузитьКолонку(МассивЗначений, Колонка.Имя);
    КонецЦикла; 
    
    Возврат Таб
КонецФункции

Функция   ТЗ_ОтсортироватьПоДругойТЗ(ТЗДляСортировки, ТЗДляПорядкаСортировки, СтруктураКлючей) Экспорт
	ВремТЗ    = ТЗДляСортировки.Скопировать();
    Результат = ТЗДляСортировки.СкопироватьКолонки();
    Отбор = Новый Структура(СтруктураКлючей);
    Для каждого Стр Из ТЗДляПорядкаСортировки Цикл
        ЗаполнитьЗначенияСвойств(Отбор, Стр);
    	М = ВремТЗ.НайтиСтроки(Отбор);
        Для каждого СтрТЗ Из М Цикл
        	ЗаполнитьЗначенияСвойств(Результат.Добавить(), СтрТЗ);
            ВремТЗ.Удалить(СтрТЗ);
        КонецЦикла;        
    КонецЦикла;  
    
    Для каждого СтрТЗ Из ВремТЗ Цикл
    	ЗаполнитьЗначенияСвойств(Результат.Добавить(), СтрТЗ);
    КонецЦикла; 
    
    Возврат Результат;
КонецФункции

Процедура ТЗ_УдалитьТипыДанныхКолонок(ТЗ, ИменаКолонок = Неопределено) Экспорт
    #ЕСЛИ НЕ( Клиент или Сервер или ВнешнееСоединение ) Тогда
        ТЗ = Новый ТаблицаЗначений;
    #КОНЕЦЕСЛИ
    
    Если ИменаКолонок = Неопределено Тогда
        ИменаКолонок = "";
    	Для каждого Колонка Из ТЗ.Колонки Цикл
        	ИменаКолонок = ИменаКолонок + "," + Колонка.Имя;
        КонецЦикла; 
        ИменаКолонок = Сред(ИменаКолонок, 2);
    КонецЕсли; 
    
    СтрукКолонок = Новый Структура(ИменаКолонок);
    Для каждого КиЗ Из СтрукКолонок Цикл
        ИмяКолонки = КиЗ.Ключ;
        ИмяВремКолонки = "__ВРЕМ_" + ИмяКолонки;
        Колонка = ТЗ.Колонки[ИмяКолонки]; 
        ВремКолонка = ТЗ.Колонки.Вставить(ТЗ.Колонки.Индекс(Колонка), ИмяВремКолонки, , Колонка.Заголовок, Колонка.Ширина);
        МассивЗначений = ТЗ.ВыгрузитьКолонку(ИмяКолонки);
        ТЗ.ЗагрузитьКолонку(МассивЗначений, ВремКолонка);
        ТЗ.Колонки.Удалить(ИмяКолонки);
        ВремКолонка.Имя = ИмяКолонки;
    КонецЦикла; 
    
КонецПроцедуры

Функция   ТЗ_Свернуть(ТЗ, Измерения, КолонкиСумма = "", КолонкиМинимум = "", КолонкиМаксимум = "") Экспорт
	Результат = Новый ТаблицаЗначений;
    
    // Создадим колонки
    СтрукКолонок = Новый Структура(Измерения);
    Для каждого КиЗ Из СтрукКолонок Цикл
        Колонка = ТЗ.Колонки[КиЗ.Ключ];
    	Результат.Колонки.Добавить(Колонка.Имя, Колонка.ТипЗначения, Колонка.Заголовок, Колонка.Ширина);
    КонецЦикла; 
    
    отЧисло = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(20, 10, ДопустимыйЗнак.Любой));
    
    СтрукКолонок = Новый Структура(КолонкиСумма
    + ?(ЗначениеЗаполнено(КолонкиМинимум),  "," + КолонкиМинимум, "")
    + ?(ЗначениеЗаполнено(КолонкиМаксимум), "," + КолонкиМаксимум, ""));
    Для каждого КиЗ Из СтрукКолонок Цикл
        Колонка = ТЗ.Колонки[КиЗ.Ключ];
        Результат.Колонки.Добавить(Колонка.Имя, отЧисло, Колонка.Заголовок, Колонка.Ширина);
    КонецЦикла; 
    
    ВремТЗ = ТЗ.Скопировать();
    ВремТЗ.Колонки.Добавить("__Сорт__");
    СтрукКолонокИзмерения = Новый Структура(Измерения);
    Для каждого Стр Из ВремТЗ Цикл
    	Стр.__Сорт__ = "";
        Для каждого КиЗ Из СтрукКолонокИзмерения Цикл
        	Если ИА_БФКС.РеквизитЕсть(Стр [КиЗ.Ключ] , "Ссылка") Тогда
            	Стр.__Сорт__ = Стр.__Сорт__ + "|" + Стр [КиЗ.Ключ].УникальныйИдентификатор();
            КонецЕсли; 
        КонецЦикла;  
    КонецЦикла;  
    
    ВремТЗ.Сортировать(Измерения + ?(ЗначениеЗаполнено(Измерения), ",", "") + " __Сорт__");
    ВремТЗ.Добавить();
    
    ПредСтрока = Новый Структура(Измерения);
    СтрукМин   = Неопределено;
    СтрукМакс  = Неопределено;
    СтрукСумма = Неопределено;
    НовСтрока  = Неопределено;
    
    Для каждого Стр Из ВремТЗ Цикл
        ТекСтрока = ИА_БФКС.Струк_Новый(Измерения, Стр);
        Если ИА_БФКС.Струк_Равны(ПредСтрока, ТекСтрока) Тогда
            Для каждого КиЗ Из СтрукМин Цикл
                ТекущееЗначение = Стр [КиЗ.Ключ];
            	Если КиЗ.Значение > ТекущееЗначение Тогда
                	СтрукМин.Вставить(КиЗ.Ключ, ТекущееЗначение);
                КонецЕсли; 
            КонецЦикла; 
            
            Для каждого КиЗ Из СтрукМакс Цикл
                ТекущееЗначение = Стр [КиЗ.Ключ];
            	Если КиЗ.Значение < ТекущееЗначение Тогда
                	СтрукМакс.Вставить(КиЗ.Ключ, ТекущееЗначение);
                КонецЕсли; 
            КонецЦикла; 
            
            Для каждого КиЗ Из СтрукСумма Цикл
                ТекущееЗначение = Стр [КиЗ.Ключ];
                СтрукСумма[КиЗ.Ключ] = СтрукСумма[КиЗ.Ключ] + ТекущееЗначение;
            КонецЦикла; 
        Иначе // Изменились "измерения", надо добавить строку
            Если НовСтрока <> Неопределено Тогда // Исключим первый вход
                ЗаполнитьЗначенияСвойств(НовСтрока, СтрукМин);
                ЗаполнитьЗначенияСвойств(НовСтрока, СтрукМакс);
                ЗаполнитьЗначенияСвойств(НовСтрока, СтрукСумма);
            КонецЕсли; 
            
            // Добавим в результат новую строку
            НовСтрока = Результат.Добавить();
            ЗаполнитьЗначенияСвойств(НовСтрока, Стр, Измерения);
            
            
            СтрукМин   = ИА_БФКС.Струк_Новый(КолонкиМинимум, Стр);
            СтрукМакс  = ИА_БФКС.Струк_Новый(КолонкиМаксимум, Стр);
            СтрукСумма = ИА_БФКС.Струк_Новый(КолонкиСумма, Стр);
            ПредСтрока = ТекСтрока;
        КонецЕсли; 
    КонецЦикла; 
    
    Возврат Результат;
КонецФункции

Функция   ТЗ_ПреобразоватьВСтруктуру(ТЗ, ИмяПоляКлюч, ИмяПоляЗначение = Неопределено) Экспорт
	Результат = Новый Структура;
    
    ИменаКолонокЗначений = "";
    Если ИмяПоляЗначение = Неопределено Тогда
        Для каждого Колонка Из ТЗ.Колонки Цикл
            ИменаКолонокЗначений = ИменаКолонокЗначений + "," + Колонка.Имя;
        КонецЦикла; 
        ИменаКолонокЗначений = Сред(ИменаКолонокЗначений, 2);
    КонецЕсли;
    
    Для каждого Стр Из ТЗ Цикл        
        Если ИмяПоляЗначение = Неопределено Тогда
        	Значение = Новый Структура(ИменаКолонокЗначений);
            ЗаполнитьЗначенияСвойств(Значение, Стр);
        Иначе
            Значение = Стр [ИмяПоляЗначение];
        КонецЕсли; 
    	Результат.Вставить(Стр[ИмяПоляКлюч], Значение);
    КонецЦикла;  
    
    Возврат Результат;
КонецФункции

Функция   ТЗ_РаспределитьСумму(ТЗ, ИмяКолонкиБазы, СуммаКРаспределению, ЗнаковПослеЗапятой = 2, ИмяКолонкиРезультат = "__Сумма") Экспорт
    
    отЧисло = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(20, ЗнаковПослеЗапятой));
    
	Таб = ТЗ.Скопировать();
    Таб.Колонки.Добавить(ИмяКолонкиРезультат, отЧисло);
    
    СуммаНакопленная        = 0;
    МаксЗначение            = 0;
    МаксЗначениеИндекс      = 0;
    Счетчик                 = 0;
    
    
    База = Таб.Итог(ИмяКолонкиБазы);
    Для каждого Стр Из Таб Цикл
        ЗначениеПоМодулю = Макс (Стр [ИмяКолонкиБазы], -Стр [ИмяКолонкиБазы]);
        
        Если ЗначениеПоМодулю > МаксЗначение Тогда
        	МаксЗначение       = ЗначениеПоМодулю;
            МаксЗначениеИндекс = Счетчик;
        КонецЕсли; 
        
        Если База = 0 Тогда
        	Доля = 0;
        Иначе
            Доля = Стр [ИмяКолонкиБазы] / База;
        КонецЕсли; 
    	
        Стр [ИмяКолонкиРезультат]  = СуммаКРаспределению * Доля;
        СуммаНакопленная = СуммаНакопленная + Стр [ИмяКолонкиРезультат];
        Счетчик = Счетчик + 1;
    КонецЦикла;  
    
    Дельта = СуммаКРаспределению - СуммаНакопленная;
    Если Дельта <> 0 Тогда
        Стр                         = Таб[МаксЗначениеИндекс];
        ЗначениеКорректировки       = Стр[ИмяКолонкиРезультат] + Дельта;
        Стр[ИмяКолонкиРезультат]    = ЗначениеКорректировки;
    КонецЕсли; 
    
    Возврат Таб;
КонецФункции

Функция   ТЗ_НайтиСтроку(ТЗ, Значение, Колонки = Неопределено, НеопределеноЕслиНеНайдено = Ложь) Экспорт
    ВремТаб = ТЗ.СкопироватьКолонки();
    НайдСтрока = Неопределено;
    
    Если ТипЗнч(Значение) = Тип("Структура") И Колонки = Неопределено Тогда        
        М = ТЗ.НайтиСтроки(Значение);
        Если М.Количество() >  0 Тогда
            НайдСтрока = М [0];
        КонецЕсли; 
    Иначе
        НайдСтрока = ТЗ.Найти(Значение, Колонки);
    КонецЕсли; 
    Если НайдСтрока <> Неопределено Тогда
        НовСтрока = ВремТаб.Добавить();
        ЗаполнитьЗначенияСвойств(НовСтрока, НайдСтрока);
    КонецЕсли; 
    
    Если ВремТаб.Количество() = 0 Тогда
        Если НеопределеноЕслиНеНайдено Тогда
            Возврат Неопределено;
        Иначе
            ВремТаб.Добавить();
        КонецЕсли; 
    КонецЕсли; 
    
    СтрокаТЗ = ВремТаб[0]; 
    Результат = Новый Структура;
    Для каждого Колонка Из ВремТаб.Колонки Цикл
        Результат.Вставить(Колонка.Имя, СтрокаТЗ[Колонка.Имя]);
    КонецЦикла;  
    Возврат Результат;
КонецФункции

Функция   ТЗ_СгруппироватьСДеталями(ТЗ, Измерения, КолонкиСумма = "", ИмяКолонкиДетали = "__Детали") Экспорт
    ВсеКолонки = Измерения + ?(КолонкиСумма = "", "", ", " + КолонкиСумма);
	Результат = ТЗ.Скопировать(, ВсеКолонки);
    Результат.Свернуть(Измерения, КолонкиСумма);
    Результат.Колонки.Добавить(ИмяКолонкиДетали);
    
    Отбор = Новый Структура(Измерения);
    Для каждого Стр Из Результат Цикл
    	ЗаполнитьЗначенияСвойств(Отбор, Стр);
        Стр[ИмяКолонкиДетали] = ИА_БФС.ТЗ_ФильтрПоОтбору(ТЗ, Отбор);
    КонецЦикла;  
    
    Возврат Результат;
КонецФункции

