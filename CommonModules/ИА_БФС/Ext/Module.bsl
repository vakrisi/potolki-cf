// Функция создает новую таблицу значений на основе строкового списка колонок или структуры вида "ИмяКолонки" - "ОписаниеТипа"
// Параметры:
// Колонки - Строки, Структура - Список колонок ИЛИ структура вида "ИмяКолонки" - "ОписаниеТипа"
Функция   ТЗ_НоваяТаблицаЗначений(Колонки) Экспорт
    ТЗ = Новый ТаблицаЗначений;
    СтрКолонки = ?(ТипЗнч(Колонки) = Тип("Строка"), Новый Структура(Колонки), Колонки);
    Для каждого Эл Из СтрКолонки Цикл
        ТЗ.Колонки.Добавить(Эл.Ключ, Эл.Значение);
    КонецЦикла;      
    Возврат ТЗ;
КонецФункции

