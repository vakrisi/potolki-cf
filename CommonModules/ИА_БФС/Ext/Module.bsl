Функция   МД_ПолучитьРегистраторов(НаборЗаписей, ТолькоСПроведением = Ложь) Экспорт
    Результат = Новый Массив;
    Для Ц = 0 по НаборЗаписей.Отбор.Регистратор.ТипЗначения.Типы().Количество() - 1 цикл
        Тип = НаборЗаписей.Отбор.Регистратор.ТипЗначения.Типы()[Ц];
        МД = Метаданные.НайтиПоТипу(Тип);
        Если МД <> Неопределено тогда
            Если НЕ ТолькоСПроведением
                ИЛИ 
                МД.Проведение = Метаданные.СвойстваОбъектов.Проведение.Разрешить Тогда
                Результат.Добавить(МД);
            КонецЕсли; 
        КонецЕсли;
    КонецЦикла;
    Возврат Результат;
КонецФункции

Функция   Перечисление_Имя(ЗначениеПеречисления) Экспорт
    ИмяПеречисления = ЗначениеПеречисления.Метаданные().Имя;
    ИндексЗначенияПеречисления = Перечисления[ИмяПеречисления].Индекс(ЗначениеПеречисления);
    ИмяЗначенияПеречисления = Метаданные.Перечисления[ИмяПеречисления].ЗначенияПеречисления[ИндексЗначенияПеречисления].Имя;
    Возврат ИмяЗначенияПеречисления;
КонецФункции
 
