////#Область КэшСтроковыхКонстант

Функция   КэшСтр_Получить(ИсходнаяСтрока) Экспорт
    Хеш = Хеш_MD5(ИсходнаяСтрока);
    
    Данные = ИА_БФС.Запрос_ВыполнитьВСтруктуру(
    "ВЫБРАТЬ
    |   Т.Хеш,
    |   Т.Значение,
    |   Т.ДатаСоздания,
    |   Т.ОбъектСвязи
    |ИЗ
    |   РегистрСведений.ИА_КэшСтроковыхКонстант КАК Т
    |ГДЕ
    |   Т.Хеш = &Хеш"
    , Новый Структура("Хеш", Хеш)); 
    
    Данные.Вставить("Найдено", Данные.Хеш = Хеш);
    
    Возврат Данные;
КонецФункции

Процедура КэшСтр_Вставить(ИсходнаяСтрока, Текст, ОбъектСвязи = Неопределено) Экспорт
	Хеш = Хеш_MD5(ИсходнаяСтрока);
    
    МЗ              = РегистрыСведений.ИА_КэшСтроковыхКонстант.СоздатьМенеджерЗаписи();
    МЗ.Хеш          = Хеш;
    МЗ.ДатаСоздания = ТекущаяДата();
    МЗ.Значение     = Текст;
    МЗ.ОбъектСвязи  = ОбъектСвязи;
    МЗ.Записать();
КонецПроцедуры

Процедура КэшСтр_Удалить(ИсходнаяСтрока = Неопределено, ОбъектСвязи = Неопределено) Экспорт
	Если ИсходнаяСтрока <> Неопределено Тогда
        Хеш = Хеш_MD5(ИсходнаяСтрока);
        МЗ              = РегистрыСведений.ИА_КэшСтроковыхКонстант.СоздатьМенеджерЗаписи();
        МЗ.Хеш          = Хеш;
        МЗ.Удалить();
    Иначе // Удаление пакетное записей
        Таб = ИА_БФС.Запрос_ВыполнитьВТЗ(
        "ВЫБРАТЬ
        |   Т.Хеш
        |ИЗ
        |   РегистрСведений.ИА_КэшСтроковыхКонстант КАК Т"
        + ?(ОбъектСвязи = Неопределено, "", " ГДЕ Т.ОбъектСвязи = &ОбъектСвязи")
        , Новый Структура("ОбъектСвязи", ОбъектСвязи)); 
        Для каждого Стр Из Таб Цикл
            МЗ              = РегистрыСведений.ИА_КэшСтроковыхКонстант.СоздатьМенеджерЗаписи();
            МЗ.Хеш          = Стр.Хеш;
            МЗ.Удалить();
        КонецЦикла;  
    КонецЕсли; 
КонецПроцедуры
 
 
////#КонецОбласти 

////#Область УниОтчет

Функция   УниОтчет_ПодготовитьДанные(ОтчетОбъект, УИД = Неопределено, ПараметрыФормы = Неопределено) Экспорт
    Если УИД = Неопределено Тогда
    	УИД = новый УникальныйИдентификатор;
    КонецЕсли; 
        
    Данные = Новый Структура("СКД, Настройки, НаименованиеОтчета, ПолноеНаименованиеОтчета, СформироватьПриОткрытии, ПользовательскиеНастройки"
    , ОтчетОбъект.ПолучитьМакет("ОсновнаяСхемаКомпоновкиДанных")
    , ОтчетОбъект.КомпоновщикНастроек.ПолучитьНастройки()
    , ОтчетОбъект.Метаданные().ПолноеИмя()
    , ОтчетОбъект.Метаданные().Представление()
    , Ложь
    , Неопределено
    );
    
    Если ПараметрыФормы <> Неопределено Тогда
        Если ПараметрыФормы.Свойство("СформироватьПриОткрытии") Тогда
        	Данные.СформироватьПриОткрытии = ПараметрыФормы.СформироватьПриОткрытии;
        КонецЕсли; 
        Если ПараметрыФормы.Свойство("ПользовательскиеНастройки") Тогда
        	Данные.ПользовательскиеНастройки = ПараметрыФормы.ПользовательскиеНастройки;
        КонецЕсли; 
    КонецЕсли; 
    
    ВремХран = ПоместитьВоВременноеХранилище(Данные, УИД);
    
    Возврат Новый Структура("ИА_ПараметрыУниОтчета", ВремХран);
КонецФункции

Процедура УниОтчет_ПриСозданииНаСервере(Форма) Экспорт
    РеквизитХранения = Вычислить("Новый РеквизитФормы(""ИА_ПараметрыУниОтчета"",Новый ОписаниеТипов())");
    М = Новый Массив;
    М.Добавить(РеквизитХранения);
    Форма.ИзменитьРеквизиты(М);
    
    Форма.ИА_ПараметрыУниОтчета = УниОтчет_ПодготовитьДанные(
    Форма.РеквизитФормыВЗначение("Отчет")
    , Форма.УникальныйИдентификатор
    , Форма.Параметры);
КонецПроцедуры
 
