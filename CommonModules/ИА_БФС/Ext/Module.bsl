Процедура УО_УстановитьИспользование(Строки, ИменаДляВключения) Экспорт
    Имена = Врег("/" + ИменаДляВключения + "/");
    Для каждого Строка Из Строки Цикл
        ЭтоРазрешеннаяСтрока =  Найти(Имена, "/" + Врег(Строка.Имя) + "/");
        Строка.Использование = ЭтоРазрешеннаяСтрока;
        УО_УстановитьИспользование(Строка.Строки, ИменаДляВключения);
    КонецЦикла; 
КонецПроцедуры

