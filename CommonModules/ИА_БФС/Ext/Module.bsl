Функция   Типы_ОписаниеТипов2ТаблицаСтроковыхТипов(ОписаниеТипов) Экспорт
    Таб = ТЗ_НоваяТаблицаЗначений(Новый Структура("Имя, ИмяДляЗапроса, МенеджерМД, ИмяМД, Ссылочный"
    , Новый ОписаниеТипов("Строка",,Новый КвалификаторыСтроки(1024))
    , Новый ОписаниеТипов("Строка",,Новый КвалификаторыСтроки(1024))
    , Новый ОписаниеТипов("Строка",,Новый КвалификаторыСтроки(1024))
    , Новый ОписаниеТипов("Строка",,Новый КвалификаторыСтроки(1024))
    , Новый ОписаниеТипов("Булево")));
    
    Если ОписаниеТипов.СодержитТип(Тип("Булево")) Тогда
        ТЗ_ДобавитьСтроку(Таб, "Булево");
    КонецЕсли; 
    
    Если ОписаниеТипов.СодержитТип(Тип("Строка")) Тогда
        ТЗ_ДобавитьСтроку(Таб, "Строка");
    КонецЕсли; 
    
    Если ОписаниеТипов.СодержитТип(Тип("Число")) Тогда
        ТЗ_ДобавитьСтроку(Таб, "Число");
    КонецЕсли; 
    
    Если ОписаниеТипов.СодержитТип(Тип("Дата")) Тогда
        ТЗ_ДобавитьСтроку(Таб, "Дата");
    КонецЕсли; 
    
    Если ОписаниеТипов.СодержитТип(Тип("ТаблицаЗначений")) Тогда
        ТЗ_ДобавитьСтроку(Таб, "ТаблицаЗначений");
    КонецЕсли; 
    
    Для каждого ЭлМД из Метаданные.Справочники Цикл
        Имя = "СправочникСсылка." + ЭлМД.Имя;
        Если ОписаниеТипов.СодержитТип(Тип(Имя))  Тогда
            ТЗ_ДобавитьСтроку(Таб, Имя, "Справочник." + ЭлМД.Имя, "Справочники", ЭлМД.Имя, Истина);
        КонецЕсли;
    КонецЦикла;
    
    Для каждого ЭлМД из Метаданные.Документы Цикл
        Имя = "ДокументСсылка." + ЭлМД.Имя;
        Если ОписаниеТипов.СодержитТип(Тип(Имя)) Тогда
            ТЗ_ДобавитьСтроку(Таб, Имя, "Документ." + ЭлМД.Имя, "Документы", ЭлМД.Имя, Истина);
        КонецЕсли;
    КонецЦикла;
    
    Для каждого ЭлМД из Метаданные.Перечисления Цикл
        Имя = "ПеречислениеСсылка." + ЭлМД.Имя;
        Если ОписаниеТипов.СодержитТип(Тип(Имя)) Тогда
            НС = Таб.Добавить(); НС.Имя = Имя;
            ТЗ_ДобавитьСтроку(Таб, Имя, "Перечисление." + ЭлМД.Имя, "Перечисления", ЭлМД.Имя, Истина);
        КонецЕсли;
    КонецЦикла;
    
    Для каждого ЭлМД из Метаданные.ПланыВидовХарактеристик Цикл
        Имя = "ПланВидовХарактеристикСсылка." + ЭлМД.Имя;
        Если ОписаниеТипов.СодержитТип(Тип(Имя)) Тогда
            ТЗ_ДобавитьСтроку(Таб, Имя, "ПланВидовХарактеристик." + ЭлМД.Имя, "ПланыВидовХарактеристик", ЭлМД.Имя, Истина);
        КонецЕсли;
    КонецЦикла;
    
    Для каждого ЭлМД из Метаданные.ПланыВидовРасчета Цикл
        Имя = "ПланВидовРасчетаСсылка." + ЭлМД.Имя;
        Если ОписаниеТипов.СодержитТип(Тип(Имя)) Тогда
            ТЗ_ДобавитьСтроку(Таб, Имя, "ПланВидовРасчета." + ЭлМД.Имя, "ПланыВидовРасчета", ЭлМД.Имя, Истина);
        КонецЕсли;
    КонецЦикла;
    
    Для каждого ЭлМД из Метаданные.ПланыСчетов Цикл
        Имя = "ПланСчетовСсылка." + ЭлМД.Имя;
        Если ОписаниеТипов.СодержитТип(Тип(Имя)) Тогда
            ТЗ_ДобавитьСтроку(Таб, Имя, "ПланСчетов." + ЭлМД.Имя, "ПланыСчетов", ЭлМД.Имя, Истина);
        КонецЕсли;
    КонецЦикла;
    
    Для каждого ЭлМД из Метаданные.БизнесПроцессы Цикл
        Имя = "БизнесПроцессСсылка." + ЭлМД.Имя;
        Если ОписаниеТипов.СодержитТип(Тип(Имя)) Тогда
            ТЗ_ДобавитьСтроку(Таб, Имя, "БизнесПроцесс." + ЭлМД.Имя, "БизнесПроцессы", ЭлМД.Имя, Истина);
        КонецЕсли;
    КонецЦикла;
    
    Для каждого ЭлМД из Метаданные.Задачи Цикл
        Имя = "ЗадачаСсылка." + ЭлМД.Имя;
        Если ОписаниеТипов.СодержитТип(Тип(Имя)) Тогда
            ТЗ_ДобавитьСтроку(Таб, Имя, "Задача." + ЭлМД.Имя, "Задачи", ЭлМД.Имя, Истина);
        КонецЕсли;
    КонецЦикла;
    
    Для каждого ЭлМД из Метаданные.ПланыОбмена Цикл
        Имя = "ПланОбменаСсылка." + ЭлМД.Имя;
        Если ОписаниеТипов.СодержитТип(Тип(Имя)) Тогда
            ТЗ_ДобавитьСтроку(Таб, Имя, "ПланОбмена." + ЭлМД.Имя, "ПланыОбмена", ЭлМД.Имя, Истина);
        КонецЕсли;
    КонецЦикла;
    
    Возврат Таб;
КонецФункции


Функция   Типы_ТаблицаСтроковыхТипов2ОписаниеТипов(Таблица) Экспорт
    М = Новый Массив;
    Для каждого СтрокаТЗ Из Таблица Цикл
        М.Добавить(Тип(СтрокаТЗ.Имя));
    КонецЦикла; 
    
    Результат = Новый ОписаниеТипов(М);
    Возврат Результат;
КонецФункции

