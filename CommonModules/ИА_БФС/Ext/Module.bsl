////#Область НаборыЗаписей

Процедура ТЗ_В_НаборЗаписей(ТЗ, Менеджер, Регистратор, ОбменДаннымиЗагрузка = Ложь, Замещать = Истина) Экспорт
    НЗ = Менеджер.СоздатьНаборЗаписей();
    НЗ.Отбор.Регистратор.Установить(Регистратор);
    НЗ.ОбменДанными.Загрузка = ОбменДаннымиЗагрузка;
    НЗ.Загрузить(ТЗ);
	НЗ.Записать(Замещать);
КонецПроцедуры

Функция   НаборЗаписей_В_ТЗ(Менеджер, Регистратор) Экспорт
    НЗ = Менеджер.СоздатьНаборЗаписей();
    НЗ.Отбор.Регистратор.Установить(Регистратор);
    НЗ.Прочитать();
    Возврат НЗ.Выгрузить();
КонецФункции

Процедура Проводки_ПоменятьМестамиСчетаИСубконто(Проводка, СторноСуммы = Ложь) Экспорт
    ЗначенияДт = Новый Соответствие;
    СчетДт     = Проводка.СчетДт;
    
    Для каждого СтрокаВидаСубконто Из Проводка.СчетДт.ВидыСубконто Цикл
        ВидСубконто = СтрокаВидаСубконто.ВидСубконто;
        
    	ЗначенияДт.Вставить(ВидСубконто, Проводка.СубконтоДт[ВидСубконто]);
        Проводка.СубконтоДт.Удалить(ВидСубконто);
    КонецЦикла;  
    
    Проводка.СчетДт = Проводка.СчетКт;
    Для каждого СтрокаВидаСубконто Из Проводка.СчетКт.ВидыСубконто Цикл
        ВидСубконто = СтрокаВидаСубконто.ВидСубконто;

        Проводка.СубконтоДт.Вставить(ВидСубконто, Проводка.СубконтоКт[ВидСубконто]);
        Проводка.СубконтоКт.Удалить(ВидСубконто);
    КонецЦикла;  
    
    Проводка.СчетКт = СчетДт;
    Для каждого КиЗ Из ЗначенияДт Цикл
        Проводка.СубконтоКт.Вставить(КиЗ.Ключ, КиЗ.Значение);
    КонецЦикла;  
    
    Если СторноСуммы Тогда
    	Проводка.Сумма = -Проводка.Сумма;
    КонецЕсли; 
    
КонецПроцедуры

////#КонецОбласти 

//#Область УФ_СортировкаЭлементовДанных
// Встраивание:
// 1) Добавить в МД реквизит сортировки "число" "ИА_ПорядокСортировки" (либо передать имя)
// 2) Вывести его на форму в список и установить по нему сортировку
// 3) В модуль формы добавить обработчик и вызов инициализации:
// Код:
//       &НаКлиенте
//       Процедура ИА_СортировщикСтрок_Нажатие(Команда)
//           ИА_БФК.УФ_СортировкаЭлементовДанных_Нажатие(ЭтаФорма, Команда);
//       КонецПроцедуры
//
//       &НаСервере
//       Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
//           ИА_БФС.УФ_СортировкаЭлементовДанных_Инициализация(ЭтаФорма
//           , "Справочник.Контрагенты"
//           , "Список"
//           , "Список"
//           , "Ссылка");
//       КонецПроцедуры
Процедура УФ_СортировкаЭлементовДанных_Инициализация(Форма
    , ГруппаКнопокПриемник
    , ИмяОбъектаМД
    , ИмяСписка = "Список"
    , ИмяЭФСписка = "Список"
    , ИмяПоля = "Ссылка"
    , ИмяПоляПорядка = "ИА_ПорядокСортировки"
    , Иерархия = Неопределено) Экспорт
    Форма[ИмяСписка].УстановитьОбязательноеИспользование(ИмяПоля, Истина);
    
    /////   РЕКВИЗИТЫ   //////////
    
    МассивДобавляемыхРеквизитов = Новый Массив;
    
    // ******   Реквизит формы "УФ_СЭД_Настройки"    ***********
    
    НовыйРеквизит = Новый РеквизитФормы("УФ_СЭД_Настройки", Новый ОписаниеТипов());
    НовыйРеквизит.Заголовок = "Сортировщик строк данные";
    НовыйРеквизит.СохраняемыеДанные = Ложь;
    МассивДобавляемыхРеквизитов.Добавить(НовыйРеквизит);
    
    Форма.ИзменитьРеквизиты(МассивДобавляемыхРеквизитов);
    
    Форма.УФ_СЭД_Настройки = Новый Структура("ИмяОбъектаМД, ИмяЭФСписка, ИмяПоля, ИмяПоляПорядка, Иерархия"
    , ИмяОбъектаМД
    , ИмяЭФСписка
    , ИмяПоля
    , ИмяПоляПорядка
    , Иерархия);
    
    Если Иерархия = Неопределено Тогда
        СтруктураМД = ИА_БФС.Запрос_ВыполнитьВСтруктуру("ВЫБРАТЬ * ИЗ " + ИмяОбъектаМД + " КАК Т ГДЕ ЛОЖЬ");
        Иерархия = ИА_БФКС.РеквизитЕсть(СтруктураМД, "Родитель");
        Форма.УФ_СЭД_Настройки.Вставить("Иерархия", Иерархия);
    КонецЕсли; 
    
    /////   КОМАНДЫ   //////////
    
    // ******   Команда формы "ИА_СортировщикСтрок_Вверх"    ***********
    
    НоваяКоманда = Форма.Команды.Добавить("ИА_СортировщикСтрок_Вверх");
    НоваяКоманда.Действие = "ИА_СортировщикСтрок_Нажатие";
    НоваяКоманда.Заголовок = "Переместить вверх";
    НоваяКоманда.Подсказка = "Переместить вверх";
    //НоваяКоманда.ИзменяетСохраняемыеДанные = Ложь;
    НоваяКоманда.Отображение = ОтображениеКнопки.Картинка;
    НоваяКоманда.Картинка = БиблиотекаКартинок.ПереместитьВверх;
    
    // ******   Команда формы "ИА_СортировщикСтрок_Вниз"    ***********
    
    НоваяКоманда = Форма.Команды.Добавить("ИА_СортировщикСтрок_Вниз");
    НоваяКоманда.Действие = "ИА_СортировщикСтрок_Нажатие";
    НоваяКоманда.Заголовок = "Переместить Вниз";
    //НоваяКоманда.ИзменяетСохраняемыеДанные = Ложь;
    НоваяКоманда.Отображение = ОтображениеКнопки.Картинка;
    НоваяКоманда.Подсказка = "Переместить вниз";
    НоваяКоманда.Картинка = БиблиотекаКартинок.ПереместитьВниз;
    
    /////   ЭЛЕМЕНТЫ   //////////
    
    
    // ******   Кнопка формы "ФормаИА_СортировщикСтрок_Вниз"    ***********
    
    НовыйЭлемент = Форма.Элементы.Вставить("ФормаИА_СортировщикСтрок_Вниз",Тип("КнопкаФормы")
    , ГруппаКнопокПриемник
    , );
    НовыйЭлемент.Вид = ВидКнопкиФормы.КнопкаКоманднойПанели;
    НовыйЭлемент.ИмяКоманды = "ИА_СортировщикСтрок_Вниз";
    
    // ******   Кнопка формы "ФормаИА_СортировщикСтрок_Вверх"    ***********
    
    НовыйЭлемент = Форма.Элементы.Вставить("ФормаИА_СортировщикСтрок_Вверх",Тип("КнопкаФормы")
    , ГруппаКнопокПриемник);
    НовыйЭлемент.Вид = ВидКнопкиФормы.КнопкаКоманднойПанели;
    НовыйЭлемент.ИмяКоманды = "ИА_СортировщикСтрок_Вверх";
КонецПроцедуры

Процедура УФ_СортировкаЭлементовДанных_ИзменитьПорядок(Настройки, Реквизит, Направление) Экспорт
	Если Не ЗначениеЗаполнено(Реквизит) Тогда
    	Возврат
    КонецЕсли;
    
    ТекстЗапроса =
    "ВЫБРАТЬ
    |   Т.Ссылка КАК Спр,
    |   Т.ИА_ПорядокСортировки КАК ПорядокСтарый,
    |   Т.ИА_ПорядокСортировки КАК ПорядокНовый,
    |   ВЫБОР
    |       КОГДА Т.Ссылка = &Спр
    |           ТОГДА ИСТИНА
    |       ИНАЧЕ ЛОЖЬ
    |   КОНЕЦ КАК Изменяемый
    |ИЗ
    |   Справочник.Контрагенты КАК Т
    |ГДЕ
    |   НЕ Т.ЭтоГруппа
    |   И Т.Родитель = &Родитель
    |
    |УПОРЯДОЧИТЬ ПО
    |   ПорядокСтарый,
    |   Т.Наименование";
    
    ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "Справочник.Контрагенты", Настройки.ИмяОбъектаМД);
    ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ИА_ПорядокСортировки",   Настройки.ИмяПоляПорядка);
    
    Если НЕ Настройки.Иерархия Тогда
        ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "НЕ Т.ЭтоГруппа",   "истина");
        ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "И Т.Родитель = &Родитель",   "");
    КонецЕсли; 
    
    Таб = ИА_БФС.Запрос_ВыполнитьВТЗ(ТекстЗапроса, Новый Структура("Спр, Родитель", Реквизит, Реквизит.Родитель));
    
    Ц =  0;
    Для каждого Стр Из Таб Цикл
        Ц = Ц + 1;
        Стр.ПорядокНовый = Ц;
    КонецЦикла;
    
    СтрокаИзменяемого = Таб.Найти(Истина, "Изменяемый");
    Если СтрокаИзменяемого = Неопределено Тогда
        Возврат;
    КонецЕсли; 
    
    СтрокаИзменяемого.ПорядокНовый = СтрокаИзменяемого.ПорядокНовый + Направление;
    
    Если СтрокаИзменяемого.ПорядокНовый = 0 И СтрокаИзменяемого.ПорядокСтарый = 1 Тогда
        // В конец
    	СтрокаИзменяемого.ПорядокНовый = Таб.Количество() + 1;
    ИначеЕсли СтрокаИзменяемого.ПорядокНовый = Таб.Количество() + 1 И СтрокаИзменяемого.ПорядокСтарый = Таб.Количество() Тогда
        // В начало
    	СтрокаИзменяемого.ПорядокНовый = 0;
    КонецЕсли;
    
    Таб.Сортировать("ПорядокНовый, Изменяемый " + ?(Направление > 0, "", "УБЫВ"));
    
    Ц =  0;
    Для каждого Стр Из Таб Цикл
        Ц = Ц + 1;
        Стр.ПорядокНовый = Ц;
    КонецЦикла;
    
    // Изменим в базе
    НачатьТранзакцию();
    Для каждого Стр Из Таб Цикл
    	Если Стр.ПорядокНовый <> Стр.ПорядокСтарый Тогда
        	Спр = Стр.Спр.ПолучитьОбъект();
            Спр [Настройки.ИмяПоляПорядка]  = Стр.ПорядокНовый;
            Спр.Записать();
        КонецЕсли; 
    КонецЦикла; 
    ЗафиксироватьТранзакцию();
КонецПроцедуры

//#КонецОбласти 