////#Область Кэш

Процедура Кэш_Вставить(Кэш, СтруктураКлючей, Значение) Экспорт
    Если Кэш = Неопределено Тогда
        Кэш = ТЗ_НоваяТаблицаЗначений("__Значение__");
        Для каждого КиЗ Из СтруктураКлючей Цикл
            Кэш.Колонки.Добавить(КиЗ.Ключ);
        КонецЦикла;
    КонецЕсли; 
    
    М = Кэш.НайтиСтроки(СтруктураКлючей);
    КоличествоСтрок = М.Количество();
    Если КоличествоСтрок = 1 Тогда
        СтрокаКэша = М[0];
    ИначеЕсли КоличествоСтрок = 0 Тогда
        СтрокаКэша = Кэш.Добавить();
        ЗаполнитьЗначенияСвойств(СтрокаКэша, СтруктураКлючей);
    ИначеЕсли КоличествоСтрок > 1 Тогда
        // Удалим дубли
        Для Ц = 1 По КоличествоСтрок - 1 Цикл
            СтрокаКэша = М[Ц];
            Кэш.Удалить(СтрокаКэша);
        КонецЦикла; 
        СтрокаКэша = М[0];
    КонецЕсли; 
    
    СтрокаКэша.__Значение__ = Значение;
КонецПроцедуры

Функция   Кэш_Получить(Кэш, СтруктураКлючей, ЗначениеЕслиНеНайдено = Неопределено) Экспорт
    Если Кэш = Неопределено Тогда
        Возврат ЗначениеЕслиНеНайдено;
    КонецЕсли; 
    
    М = Кэш.НайтиСтроки(СтруктураКлючей);
    Если М.Количество() = 0 Тогда
        Возврат ЗначениеЕслиНеНайдено;
    Иначе
        Возврат М[0].__Значение__;
    КонецЕсли; 
КонецФункции

Функция   Кэш_СформироватьИзТЗ(ТЗ, СтруктураКлючей, ИмяПоляЗначения = "Значение", Оптимизировать = Ложь) Экспорт
    Кэш = ТЗ_НоваяТаблицаЗначений("__Значение__");
    Для каждого КиЗ Из СтруктураКлючей Цикл
        Кэш.Колонки.Добавить(КиЗ.Ключ);
    КонецЦикла;
    
    Для каждого Стр Из ТЗ Цикл
        НовСтрока = Кэш.Добавить();
        ЗаполнитьЗначенияСвойств(НовСтрока, Стр);
        
        Если ИмяПоляЗначения = Истина Тогда
        	НовСтрока.__Значение__ = ТЗ_СтрокаТЗ2Структура(Стр);
        Иначе
            НовСтрока.__Значение__ = Стр[ИмяПоляЗначения];
        КонецЕсли; 
    КонецЦикла;
    
    Если Оптимизировать Тогда
    	Кэш_Оптимизация(Кэш);
    КонецЕсли; 
    
    Возврат Кэш
КонецФункции

Процедура Кэш_Оптимизация(Кэш, Оптимизировать = Истина) Экспорт
    Если Кэш <> Неопределено Тогда
        Если Оптимизировать  Тогда
            ИменаКлючей = "";
            Для каждого Колонка Из Кэш.Колонки Цикл
                Если Колонка.Имя <> "__Значение__" Тогда
                    ИменаКлючей = ИменаКлючей + ", " + Колонка.Имя;
                КонецЕсли;         	
            КонецЦикла;
            ИменаКлючей  = Сред(ИменаКлючей, 3);
            Кэш.Индексы.Добавить(ИменаКлючей);
        Иначе
            Кэш.Индексы.Очистить();
        КонецЕсли; 
    КонецЕсли;
КонецПроцедуры

