////#Область РегистрацияСообщений

Функция   РегистрацияСообщений_Активно() Экспорт
    Попытка
        Текст = ПараметрыСеанса.ИА_БуферСообщений;
    Исключение
        Текст = "";
        ПараметрыСеанса.ИА_БуферСообщений = "";
        ТекстОшибки = ОписаниеОшибки();
    КонецПопытки; 
    
    Возврат Текст <> "";
КонецФункции

Процедура РегистрацияСообщений_Начать() Экспорт
    Если НЕ РегистрацияСообщений_Активно() Тогда
    	ПараметрыСеанса.ИА_БуферСообщений = "!";
        ОбновитьПовторноИспользуемыеЗначения();
    КонецЕсли; 
КонецПроцедуры

Процедура РегистрацияСообщений_Зафиксировать(Сообщение) Экспорт
    Если РегистрацияСообщений_Активно() Тогда
        ПараметрыСеанса.ИА_БуферСообщений = ПараметрыСеанса.ИА_БуферСообщений + Символы.ПС  + Сообщение;
    КонецЕсли; 
КонецПроцедуры

Функция   РегистрацияСообщений_Закончить() Экспорт
    Если РегистрацияСообщений_Активно() Тогда
        Результат = ПараметрыСеанса.ИА_БуферСообщений;
        Результат = Сред(Результат, 3);
        ПараметрыСеанса.ИА_БуферСообщений = "";
    Иначе
        Результат = "";
    КонецЕсли;
    
    Возврат Результат;
КонецФункции

