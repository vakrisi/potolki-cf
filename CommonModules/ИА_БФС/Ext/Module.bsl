////#Область ДеревоЗначений

Функция   ДЗ2ДЗФ(ДЗ) Экспорт
    // Массив из структур: <Строки> - массив, ссылка на ветку, <НаименованиеКолонок>
    Результат = Новый Структура("Колонки, Строки", Новый Структура, Новый Массив);
    
    ИменаКолонок = "";
    Для каждого Колонка Из ДЗ.Колонки Цикл
    	ИменаКолонок = ИменаКолонок + "," + Колонка.Имя;
        Результат.Колонки.Вставить(Колонка.Имя, Колонка.ТипЗначения);
    КонецЦикла; 
    ИменаКолонок = Сред(ИменаКолонок, 2);
    
    Результат.Строки = ДЗ2ДЗФ_Итератор(ИменаКолонок, ДЗ.Строки);
    
    Возврат Результат;
КонецФункции

Функция   ДЗ2ДЗФ_Итератор(ИменаКолонок, СтрокиДерева)
    М = Новый Массив;
	Для каждого Стр Из СтрокиДерева Цикл
    	Данные = Новый Структура(ИменаКолонок);
        ЗаполнитьЗначенияСвойств(Данные, Стр);
        
      	Ветки = ДЗ2ДЗФ_Итератор(ИменаКолонок, Стр.Строки);
        Данные.Вставить("Строки", Ветки);
        
        М.Добавить(Данные);
    КонецЦикла; 
    Возврат М;
КонецФункции

Функция   ДЗФ2ДЗ(ДЗФ) Экспорт
	ДЗ = Новый ДеревоЗначений;
    Для каждого КиЗ Из ДЗФ.Колонки Цикл
    	ДЗ.Колонки.Добавить(КиЗ.Ключ, КиЗ.Значение);
    КонецЦикла; 
    ДЗФ2ДЗ_Итератор(ДЗ.Строки, ДЗФ.Строки);
    Возврат ДЗ;
КонецФункции

Процедура ДЗФ2ДЗ_Итератор(ДЗСтроки, Ветки)
    Для каждого Ветвь Из Ветки Цикл
        Ветка = ДЗСтроки.Добавить();
        ЗаполнитьЗначенияСвойств(Ветка, Ветвь); 
        ДЗФ2ДЗ_Итератор(Ветка.Строки, Ветвь.Строки);
    КонецЦикла;	
КонецПроцедуры

Функция   ДЗ2ТЗ(ДеревоЗначений) Экспорт
    #ЕСЛИ НЕ( Клиент или Сервер или ВнешнееСоединение ) Тогда
        ДеревоЗначений = Новый ДеревоЗначений;
    #КОНЕЦЕСЛИ
    
    Результат = Новый ТаблицаЗначений;
    Для каждого Колонка Из ДеревоЗначений.Колонки Цикл
    	Результат.Колонки.Добавить(Колонка.Имя, Колонка.ТипЗначения, Колонка.Заголовок, Колонка.Ширина);
    КонецЦикла; 
    
    Результат.Колонки.Добавить("ДеревоИдентификаторСтроки",   Новый ОписаниеТипов("Строка",,Новый КвалификаторыСтроки(40)));
    Результат.Колонки.Добавить("ДеревоИдентификаторРодителя", Новый ОписаниеТипов("Строка",,Новый КвалификаторыСтроки(40)));
    
    ДЗ2ТЗ_Итератор(ДеревоЗначений.Строки, Результат, "");
    
    Возврат Результат
КонецФункции

Процедура ДЗ2ТЗ_Итератор(СтрокиДерева, ТЗ, ИДРодителя)
    #ЕСЛИ НЕ( Клиент или Сервер или ВнешнееСоединение ) Тогда
        СтрокиДерева = Новый ДеревоЗначений; СтрокиДерева = СтрокиДерева.Строки;
    #КОНЕЦЕСЛИ
    
    Для каждого Стр Из СтрокиДерева Цикл
        НовСтрока                       = ТЗ.Добавить();
        ЗаполнитьЗначенияСвойств(НовСтрока, Стр);
        НовСтрока.ДеревоИдентификаторСтроки   = ИА_БФКС.СформироватьУИД();
        НовСтрока.ДеревоИдентификаторРодителя = ИДРодителя; 
        ДЗ2ТЗ_Итератор(Стр.Строки, ТЗ, НовСтрока.ДеревоИдентификаторСтроки)
    КонецЦикла; 
КонецПроцедуры

Функция   ТЗ2ДЗ(ТЗ, ИсходноеДерево = Неопределено, ПростаяКонвертация = Ложь) Экспорт
    #ЕСЛИ НЕ( Клиент или Сервер или ВнешнееСоединение ) Тогда
        ТЗ = Новый ТаблицаЗначений;
    #КОНЕЦЕСЛИ
    
    Если ИсходноеДерево = Неопределено Тогда
        Результат = Новый ДеревоЗначений;
        СписокИсключенных = ИА_БФКС.Массив_Новый(ВРЕГ("ДеревоИдентификаторСтроки"), ВРЕГ("ДеревоИдентификаторРодителя"));
        Для каждого Колонка Из ТЗ.Колонки Цикл
            Если НЕ ИА_БФКС.Массив_Содержит(СписокИсключенных, ВРЕГ(Колонка.Имя)) Тогда
                Результат.Колонки.Добавить(Колонка.Имя, Колонка.ТипЗначения, Колонка.Заголовок, Колонка.Ширина);
            КонецЕсли; 
        КонецЦикла; 
    Иначе
        Результат = ИсходноеДерево;
        Результат.Строки.Очистить();
    КонецЕсли; 
    
    Если ПростаяКонвертация Тогда
        // Перенесём строки ТЗ в строки ДЗ без иерархии
        Для каждого Стр Из ТЗ Цикл
        	НовСтрока = Результат.Строки.Добавить();
            ЗаполнитьЗначенияСвойств(НовСтрока, Стр);
        КонецЦикла;  
    Иначе
    	ТЗ2ДЗ_Итератор(ТЗ, Результат.Строки, "");
    КонецЕсли; 
    
    Возврат Результат;
КонецФункции

Процедура ТЗ2ДЗ_Итератор(ТЗ, СтрокиДерева, ИДРодителя)
    М = ТЗ.НайтиСтроки(Новый Структура("ДеревоИдентификаторРодителя", ИДРодителя));
    
    Для каждого Стр Из М Цикл
    	НовСтрока = СтрокиДерева.Добавить();
        ЗаполнитьЗначенияСвойств(НовСтрока, Стр);
        ТЗ2ДЗ_Итератор(ТЗ, НовСтрока.Строки, Стр.ДеревоИдентификаторСтроки)
    КонецЦикла; 
    
КонецПроцедуры
 
  
