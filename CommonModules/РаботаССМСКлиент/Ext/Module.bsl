Процедура ПослеЗакрытияВопросаСМСПовторно(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		РаботаССМС.ПоставитьСМСВОчередь(ДополнительныеПараметры.Ссылка, ДополнительныеПараметры.Кому, ДополнительныеПараметры.НомерТелефона, ДополнительныеПараметры.ТекстСМС);
	КонецЕсли;
	
КонецПроцедуры

Функция ЗаполнитьПараметрыШаблонаСМСПриПланированииЗамера(ТекстСМС, РеквизитыЛида)
	
	ТекстСМС = СтрЗаменить(ТекстСМС, "%НомерТелефона", РеквизитыЛида.ОсновнойТелефонКлиента);
	ТекстСМС = СтрЗаменить(ТекстСМС, "%Контрагент", РеквизитыЛида.ИмяКлиента);
	ТекстСМС = СтрЗаменить(ТекстСМС, "%Адрес", РеквизитыЛида.Адрес);
	
	ТекстСМС = СтрЗаменить(ТекстСМС, "%Дата", Формат(РеквизитыЛида.ПоследняяДатаЗамера,"ДЛФ=D"));
	ТекстСМС = СтрЗаменить(ТекстСМС, "%Время", Формат(РеквизитыЛида.ПоследнееВремяНачалаЗамера,"ДФ=ЧЧ:мм"));
	ТекстСМС = СтрЗаменить(ТекстСМС, "%ВремяОкончания", Формат(РеквизитыЛида.ПоследнееВремяОкончанияЗамера,"ДФ=ЧЧ:мм")); // #15188
		
КонецФункции
