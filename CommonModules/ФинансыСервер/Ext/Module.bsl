Процедура ПроверитьВозможностьВводаНаОснованииЗаявки(ДокументЗаявка, ПлатежНаличные = Неопределено) Экспорт
	
	Если НЕ ДокументЗаявка.Проведен Тогда				
		ТекстОшибки = НСтр("ru='Документ %Документ% не проведен. Ввод на основании разрешен только в проведенном состоянии'");
		ТекстОшибки = СтрЗаменить(ТекстОшибки, "%Документ%", ДокументЗаявка);	
		ВызватьИсключение ТекстОшибки;
	КонецЕсли;

	Если НЕ ДокументЗаявка.СтатусУтвержденияПлатежа = Перечисления.СтатусыУтвержденияПлатежей.Утвержден Тогда				
		ТекстОшибки = НСтр("ru='Документ %Документ% находится в статусе ""%Статус%"". Ввод на основании разрешен только в статусе ""Утвержден""'");
		ТекстОшибки = СтрЗаменить(ТекстОшибки, "%Документ%", ДокументЗаявка);
		ТекстОшибки = СтрЗаменить(ТекстОшибки, "%Статус%",   ДокументЗаявка.СтатусУтвержденияПлатежа);	
		ВызватьИсключение ТекстОшибки;
	КонецЕсли;
	
	Если ТипЗнч(ДокументЗаявка) = Тип("ДокументСсылка.ЗаявкаНаРасходованиеДенежныхСредств")
		И НЕ ПлатежНаличные = Неопределено Тогда
		Если ДокументЗаявка.ТипДенежныхСредств = Перечисления.ТипыДенежныхСредств.Наличные И НЕ ПлатежНаличные Тогда
			ТекстОшибки = НСтр("ru='По документу с типом ДС ""Наличные"" разрешен ввод только расходного кассового ордера'");
			ВызватьИсключение ТекстОшибки;			
		КонецЕсли;
		Если ДокументЗаявка.ТипДенежныхСредств = Перечисления.ТипыДенежныхСредств.Безналичные И ПлатежНаличные Тогда
			ТекстОшибки = НСтр("ru='По документу с типом ДС ""Безналичные"" разрешен ввод только списания с расчетного счета'");
			ВызватьИсключение ТекстОшибки;		
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПроверитьЗаполнениеНаОснованииЗаявкиНаПеремещение(ДокументОбъект, Отказ, РежимЗаписи) Экспорт
	
	Если ДокументОбъект.СлужебныйКонтролироватьЗаполнениеЗаявки
		И ПолучитьФункциональнуюОпцию("ИспользоватьЗаявкиНаРасходованиеДенежныхСредств") Тогда
		Если НЕ ЗначениеЗаполнено(ДокументОбъект.Основание) ИЛИ ТипЗнч(ДокументОбъект.Основание) <> Тип("ДокументСсылка.ЗаявкаНаПеремещениеДенежныхСредств") Тогда
			ТекстОшибки = "Сохранение/изменение документа разрешено только на основании заявки на перемещение ДС";
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки, ДокументОбъект, , , Отказ);		
		Иначе
			Если ТипЗнч(ДокументОбъект.Основание) = Тип("ДокументСсылка.ЗаявкаНаПеремещениеДенежныхСредств") Тогда
				Если ДокументОбъект.Основание.СтатусУтвержденияПлатежа <> Перечисления.СтатусыУтвержденияПлатежей.Утвержден Тогда				
					ТекстОшибки = НСтр("ru='Документ %Документ% находится в статусе ""%Статус%"". Ввод на основании разрешен только в статусе ""Утвержден""'");
					ТекстОшибки = СтрЗаменить(ТекстОшибки, "%Документ%", ДокументОбъект.Основание);
					ТекстОшибки = СтрЗаменить(ТекстОшибки, "%Статус%",   ДокументОбъект.Основание.СтатусУтвержденияПлатежа);	
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки,,,, Отказ);
				КонецЕсли;
				
				Если ДокументОбъект.Основание.ЖелательнаяДатаПлатежа <> Дата(1, 1, 1) 
					И НачалоДня(ДокументОбъект.Основание.ЖелательнаяДатаПлатежа) <> НачалоДня(ДокументОбъект.Дата) Тогда
					ТекстОшибки = "Дата документа не совпадает с желательной датой заявки на перемещение ДС";
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки, ДокументОбъект, , , Отказ);
				КонецЕсли;
				
				ОстатокКВыплате = РегистрыНакопления.ДенежныеСредстваКВыплате.ОпределитьОстатокКВыплате(ДокументОбъект.Основание, ДокументОбъект.Ссылка);
				Если РежимЗаписи = РежимЗаписиДокумента.Проведение 
					И ОстатокКВыплате - ДокументОбъект.Сумма < 0 Тогда
					ТекстОшибки = НСтр("ru='Сумма перемещений на основании %Документ% превышает сумму заявки'");
					ТекстОшибки = СтрЗаменить(ТекстОшибки, "%Документ%", ДокументОбъект.Основание);					
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки, ДокументОбъект, , , Отказ);	
				КонецЕсли;
				
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Процедура ПроверитьЗаполнениеНаОснованииЗаявкиНаРасходование(ДокументОбъект, Отказ, РежимЗаписи) Экспорт
	
	Если ДокументОбъект.СлужебныйКонтролироватьЗаполнениеЗаявки
		И ПолучитьФункциональнуюОпцию("ИспользоватьЗаявкиНаРасходованиеДенежныхСредств") 
		И РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
		
		Если (НЕ ЗначениеЗаполнено(ДокументОбъект.Основание) ИЛИ ТипЗнч(ДокументОбъект.Основание) <> Тип("ДокументСсылка.ЗаявкаНаРасходованиеДенежныхСредств")) Тогда
			ТекстОшибки = "Проведение документа разрешено только на основании заявки на расходование ДС";
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки, ДокументОбъект, , , Отказ);		
		Иначе
			Если ТипЗнч(ДокументОбъект.Основание) = Тип("ДокументСсылка.ЗаявкаНаРасходованиеДенежныхСредств") Тогда
				Если ДокументОбъект.Основание.СтатусУтвержденияПлатежа <> Перечисления.СтатусыУтвержденияПлатежей.Утвержден Тогда				
					ТекстОшибки = НСтр("ru='Документ %Документ% находится в статусе ""%Статус%"". Ввод на основании разрешен только в статусе ""Утвержден""'");
					ТекстОшибки = СтрЗаменить(ТекстОшибки, "%Документ%", ДокументОбъект.Основание);
					ТекстОшибки = СтрЗаменить(ТекстОшибки, "%Статус%",   ДокументОбъект.Основание.СтатусУтвержденияПлатежа);	
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки,,,, Отказ);
				КонецЕсли;
				
				Если ДокументОбъект.Основание.ЖелательнаяДатаПлатежа <> Дата(1, 1, 1) 
					И НачалоДня(ДокументОбъект.Основание.ЖелательнаяДатаПлатежа) <> НачалоДня(ДокументОбъект.Дата) Тогда
					ТекстОшибки = "Дата документа не совпадает с желательной датой заявки на перемещение ДС";
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки, ДокументОбъект, , , Отказ);
				КонецЕсли;
				
				ОстатокКВыплате = РегистрыНакопления.ДенежныеСредстваКВыплате.ОпределитьОстатокКВыплате(ДокументОбъект.Основание, ДокументОбъект.Ссылка);
				Если РежимЗаписи = РежимЗаписиДокумента.Проведение 
					И ОстатокКВыплате - ДокументОбъект.Сумма < 0 Тогда
					ТекстОшибки = НСтр("ru='Сумма расхода на основании %Документ% превышает сумму заявки'");
					ТекстОшибки = СтрЗаменить(ТекстОшибки, "%Документ%", ДокументОбъект.Основание);					
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки, ДокументОбъект, , , Отказ);	
				КонецЕсли;
				
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

//проверяем, что распределяемая сумма по типам документов не превышает суммы документа (ПКО, ОБК, ПнРС) (РКО, СсРС, ППИ)
Процедура ПроверитьСуммуРаспределенияПоТипамДокументов(ДокументОбъект, ИмяТЧ = "РаспределениеПлатежа", СуммаРаспределения, Отказ, РежимЗаписи, ЭтоПКО = Ложь) Экспорт
	
	Если РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
		
		ТаблицаПроверки = Новый ТаблицаЗначений;
		ТаблицаПроверки.Колонки.Добавить("ТипДокумента", Новый ОписаниеТипов("Строка"));
		ТаблицаПроверки.Колонки.Добавить("Сумма", Новый ОписаниеТипов("Число"));
		
		//++ №7928
		ПроверитьСуммуЗарплатыСотрудникамПоСуммеДокумента(ДокументОбъект, Отказ, РежимЗаписи);
		//-- №7928
		
		Для Каждого ТекущаяСтрока Из ДокументОбъект[ИмяТЧ] Цикл
			ПредставлениеТипа = Строка(ТипЗнч(ТекущаяСтрока.Документ));
			
			Если НЕ ПустаяСтрока(ПредставлениеТипа) Тогда
				НоваяСтрока = ТаблицаПроверки.Добавить();
				НоваяСтрока.ТипДокумента = ПредставлениеТипа;
				НоваяСтрока.Сумма 		 = ТекущаяСтрока.Сумма;
			КонецЕсли;
		КонецЦикла;
		
		ЗапретитьПроводитьПКОПриНеПолномРаспределенииСуммыПоВидуЗаказа = Константы.ЗапретитьПроводитьПКОПриНеПолномРаспределенииСуммыПоВидуЗаказа.Получить();
		
		ТаблицаПроверки.Свернуть("ТипДокумента", "Сумма");
		Для Каждого ТекущаяСтрока Из ТаблицаПроверки Цикл
			Если ТекущаяСтрока.Сумма > СуммаРаспределения Тогда
				ТекстСообщения = "По типам документов """ + ТекущаяСтрока.ТипДокумента + """ распределяется сумма " + ТекущаяСтрока.Сумма + " " + ДокументОбъект.Валюта + ", что больше суммы поступления денег: " + Формат(СуммаРаспределения, "ЧДЦ=2; ЧГ=0") + " . Проведение отменено";
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,,,Отказ);
			КонецЕсли;
			Если ЭтоПКО И ЗапретитьПроводитьПКОПриНеПолномРаспределенииСуммыПоВидуЗаказа И ТекущаяСтрока.Сумма < ДокументОбъект.Сумма Тогда
				ТекстСообщения = "По видам документов """ + ТекущаяСтрока.ТипДокумента + """ распределяется сумма " + ТекущаяСтрока.Сумма + " " + ДокументОбъект.Валюта + ", что меньше самого документа поступления денег. Проведение отменено";
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,,,Отказ);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбновитьНадписиРаспеределениеПлатежа(УправляемаяФорма, Объект, ИмяТЧ = "РаспределениеПлатежа", ВалютаУчета, ВалютаЗаказаРавнаВалютеДокумента = Истина) Экспорт
	
	//Нужно сначало занулить на форме все надписи, т.к. могли удалить один тип документа и по нему сумма останется
	МассивТипов = новый Массив;
	МассивТипов.Добавить("ЗаказПокупателя");
	МассивТипов.Добавить("ЗаказДоговор");
	МассивТипов.Добавить("СчетНаОплату");
	МассивТипов.Добавить("РеализацияТоваровИУслуг");
	МассивТипов.Добавить("Монтаж");
	
	Для Каждого ТекущаяСтрока Из МассивТипов Цикл
		ИмяЭлемента = "НадписьРаспределение"+ТекущаяСтрока;
		ЭлементФормы = УправляемаяФорма.Элементы.Найти(ИмяЭлемента);
		Если НЕ ЭлементФормы = Неопределено Тогда
			ЭлементФормы.Заголовок = Формат(0, "ЧДЦ=2; ЧРГ=; ЧН=0,00");
		КонецЕсли;
	КонецЦикла;	
	
	ТаблицаПроверки = Новый ТаблицаЗначений;
	ТаблицаПроверки.Колонки.Добавить("ВидДокумента", новый ОписаниеТипов("строка"));
	ТаблицаПроверки.Колонки.Добавить("Сумма", новый ОписаниеТипов("число"));
	Для Каждого ТекущаяСтрока Из Объект[ИмяТЧ] Цикл
		ПредставлениеТипа = "";
		Если ТипЗнч(ТекущаяСтрока.Документ) = Тип("ДокументСсылка.ЗаказПокупателя") Тогда
			ПредставлениеТипа = "ЗаказПокупателя";
		ИначеЕсли ТипЗнч(ТекущаяСтрока.Документ) = Тип("ДокументСсылка.ЗаказДоговор") Тогда
			ПредставлениеТипа = "ЗаказДоговор";		
		ИначеЕсли ТипЗнч(ТекущаяСтрока.Документ) = Тип("ДокументСсылка.СчетНаОплату") Тогда
			ПредставлениеТипа = "СчетНаОплату";
		ИначеЕсли ТипЗнч(ТекущаяСтрока.Документ) = Тип("ДокументСсылка.РеализацияТоваровИУслуг") Тогда
			ПредставлениеТипа = "РеализацияТоваровИУслуг";			
		ИначеЕсли ТипЗнч(ТекущаяСтрока.Документ) = Тип("ДокументСсылка.Монтаж") Тогда
			ПредставлениеТипа = "Монтаж";	
		КонецЕсли;
		Если НЕ ПустаяСтрока(ПредставлениеТипа) Тогда
			НоваяСтрока = ТаблицаПроверки.Добавить();
			НоваяСтрока.ВидДокумента = ПредставлениеТипа;
			НоваяСтрока.Сумма = ТекущаяСтрока.Сумма;
		КонецЕсли;
	КонецЦикла;
	
	ТаблицаПроверки.Свернуть("ВидДокумента","Сумма");
	Для Каждого ТекущаяСтрока Из ТаблицаПроверки Цикл
		ИмяЭлемента = "НадписьРаспределение" + ТекущаяСтрока.ВидДокумента;
		ЭлементФормы = УправляемаяФорма.Элементы.Найти(ИмяЭлемента);
		Если НЕ ЭлементФормы = Неопределено Тогда
			ЭлементФормы.Заголовок = Формат(ТекущаяСтрока.Сумма, "ЧДЦ=2; ЧРГ=; ЧН=0,00");
		КонецЕсли;
	КонецЦикла;
	
	//в случае, если валюта поступления ДС отличается от валюты учета
	Если НЕ (Объект.Валюта = ВалютаУчета И ВалютаЗаказаРавнаВалютеДокумента) Тогда
		УправляемаяФорма.Элементы[ИмяТЧ + "СуммаДокумента"].Заголовок = "Сумма документа, в " + Объект.Валюта.Наименование;
		УправляемаяФорма.Элементы[ИмяТЧ + "ОсталосьРаспределить"].Заголовок = "Осталось распределить, в " + Объект.Валюта.Наименование;
		УправляемаяФорма.Элементы[ИмяТЧ + "Сумма"].Заголовок = "Сумма распределения, в " + Объект.Валюта.Наименование;
		УправляемаяФорма.Элементы[ИмяТЧ + "СуммаДокументаВВалютеДокумента"].Видимость = Истина;
		УправляемаяФорма.Элементы[ИмяТЧ + "ВалютаДокумента"].Видимость = Истина;
		УправляемаяФорма.Элементы[ИмяТЧ + "СуммаВВалютеДокумента"].Видимость = Истина;
	Иначе
		УправляемаяФорма.Элементы[ИмяТЧ + "СуммаДокумента"].Заголовок = "Сумма документа";
		УправляемаяФорма.Элементы[ИмяТЧ + "ОсталосьРаспределить"].Заголовок = "Осталось распределить";
		УправляемаяФорма.Элементы[ИмяТЧ + "Сумма"].Заголовок = "Сумма распределения";
		УправляемаяФорма.Элементы[ИмяТЧ + "СуммаДокументаВВалютеДокумента"].Видимость = Ложь;
		УправляемаяФорма.Элементы[ИмяТЧ + "ВалютаДокумента"].Видимость = Ложь;
		УправляемаяФорма.Элементы[ИмяТЧ + "СуммаВВалютеДокумента"].Видимость = Ложь;
	КонецЕсли;
	
КонецПроцедуры	

Функция ОпределитьРазличиеВалютыЗаказаИВалютыДокумента(Объект, ИмяТЧ = "РаспределениеПлатежа") Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	ВалютаЗаказаРавнаВалютеДокумента = Истина;
	Для Каждого СтрокаРаспределения Из Объект[ИмяТЧ] Цикл
		Если НЕ ЗначениеЗаполнено(СтрокаРаспределения.Документ) Тогда
			Продолжить;
		КонецЕсли;
		Если НЕ СтрокаРаспределения.Документ.Валюта = Объект.Валюта Тогда
			ВалютаЗаказаРавнаВалютеДокумента = Ложь
		КонецЕсли;
	КонецЦикла;
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат ВалютаЗаказаРавнаВалютеДокумента;
	
КонецФункции

Процедура КонтрольОстатковДС(ДокументОбъект, ВКассе = Истина, Отказ) Экспорт
	
	Если НЕ Константы.НеКонтролироватьОстатокДенежныхСредств.Получить() Тогда
		//контроль остатка денежных средств
		ДатаДокумента = ДокументОбъект.Дата;
		СчетКасса = ?(ВКассе, ДокументОбъект.Касса, ДокументОбъект.Счет);
		Если ДатаДокумента = Дата(1,1,1) Тогда
			ДатаДокумента = ТекущаяДатаСеанса();
		КонецЕсли;
		Сумма = 0;
		Если ОбщегоНазначения.ЕстьРеквизитОбъекта("СуммаДокумента", ДокументОбъект.Метаданные()) Тогда
			Сумма = ДокументОбъект.СуммаДокумента;
