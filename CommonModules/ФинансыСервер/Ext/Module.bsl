			СуммаОстаток = Выборка.СуммаОстаток;
		КонецЦикла;
		Если СуммаОстаток < Сумма Тогда
			ТекстСообщения = "" + ?(ВКассе, "В кассе ", "На расчетном счете ") + СчетКасса + " организации " + ДокументОбъект.Организация + " остаток средств = " + СуммаОстаток + " " + ДокументОбъект.Валюта + 
							 ". Не хватает " + (Сумма - СуммаОстаток)+ " " + ДокументОбъект.Валюта;
