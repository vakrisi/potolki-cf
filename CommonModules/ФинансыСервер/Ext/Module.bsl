		Если ВидОперации = Перечисления.ВидыОперацийРасходныйКассовыйОрдер.Инкассация Тогда
			ДокументОбъект.СтатьяРасходов = Справочники.СтатьиДоходовИРасходов.ПустаяСсылка();
		КонецЕсли;
		
		Если НЕ ВидОперации = Перечисления.ВидыОперацийРасходныйКассовыйОрдер.ЗарплатаСотрудникам Тогда
			ДокументОбъект.ПериодРегистрации = Дата(1,1,1);
			ДокументОбъект.ЗарплатаСотрудникам.Очистить();
		КонецЕсли;
		
	Иначе
		Если НЕ ВидОперации = Перечисления.ВидыОперацийСписаниеСРасчетногоСчета.ОплатаПоставщику 
			И НЕ ВидОперации = Перечисления.ВидыОперацийСписаниеСРасчетногоСчета.ВозвратПокупателю Тогда
			ДокументОбъект.РаспределениеПлатежа.Очистить();
		КонецЕсли;
		
		Если Не (ВидОперации = Перечисления.ВидыОперацийСписаниеСРасчетногоСчета.ЗарплатаСотруднику
			Или ВидОперации = Перечисления.ВидыОперацийСписаниеСРасчетногоСчета.ЗарплатаСотрудникам
			Или ВидОперации = Перечисления.ВидыОперацийСписаниеСРасчетногоСчета.ВыдачаПодотчетнику) Тогда
			ДокументОбъект.КодВидаДохода = "";
		КонецЕсли;
		
		Если НЕ ВидОперации = Перечисления.ВидыОперацийСписаниеСРасчетногоСчета.ЗарплатаСотруднику 
			И НЕ ВидОперации = Перечисления.ВидыОперацийСписаниеСРасчетногоСчета.ЗарплатаСотрудникам Тогда
			ДокументОбъект.ПериодРегистрации = Дата(1,1,1);
		КонецЕсли;
		
		//#12545
		Если ВидОперации = Перечисления.ВидыОперацийСписаниеСРасчетногоСчета.ИнкассацияИзБанка Тогда
			ДокументОбъект.СтатьяРасходов = Справочники.СтатьиДоходовИРасходов.ПустаяСсылка();
		КонецЕсли;
		
		//#13333
		Если ВидОперации = Перечисления.ВидыОперацийСписаниеСРасчетногоСчета.ЗарплатаСотрудникам Тогда
			ДокументОбъект.Контрагент = Неопределено;
		Иначе
			ДокументОбъект.ЗарплатаСотрудникам.Очистить();
		КонецЕсли;
	
	КонецЕсли;
	
КонецПроцедуры

Процедура ДокументПриходаПередЗаписью(ДокументОбъект, КассовыйДокумент = Истина, ВидОперации, Отказ, РежимЗаписи, РежимПроведения) Экспорт
	
	Если КассовыйДокумент Тогда		
		Если НЕ ВидОперации = Перечисления.ВидыОперацийПриходныйКассовыйОрдер.ОплатаОтПокупателя 
			И НЕ ВидОперации = Перечисления.ВидыОперацийПриходныйКассовыйОрдер.ВозвратОтПоставщика
			И НЕ ВидОперации = Перечисления.ВидыОперацийПриходныйКассовыйОрдер.ПолучениеКредита
			И НЕ ВидОперации = Перечисления.ВидыОперацийПриходныйКассовыйОрдер.ВозвратЗайма Тогда
			ДокументОбъект.Контрагент = Справочники.Контрагенты.ПустаяСсылка();
			ДокументОбъект.Договор = Справочники.ДоговорыКонтрагентов.ПустаяСсылка();
			
			ДокументОбъект.РаспределениеПлатежа.Очистить();
		КонецЕсли;
		
		Если НЕ ВидОперации = Перечисления.ВидыОперацийПриходныйКассовыйОрдер.ВозвратОтПодотчетника Тогда
			ДокументОбъект.Сотрудник = Справочники.Сотрудники.ПустаяСсылка();
		КонецЕсли;
		
		//#12545
		Если ВидОперации = Перечисления.ВидыОперацийПриходныйКассовыйОрдер.ПолучениеНаличныхИзБанка Тогда
			ДокументОбъект.СтатьяДоходов = Справочники.СтатьиДоходовИРасходов.ПустаяСсылка();
		КонецЕсли;
	Иначе		
		//#12545
		Если ВидОперации = Перечисления.ВидыОперацийПоступлениеНаРасчетныйСчет.ИнкассацияВБанк Тогда
			ДокументОбъект.СтатьяДоходов = Справочники.СтатьиДоходовИРасходов.ПустаяСсылка();
		КонецЕсли;
	
	КонецЕсли;
	
КонецПроцедуры

Функция ЗаголовокНадписиОстатковДС(СчетКасса, Организация, ОстатокДенежныхСредств = 0, Знач Валюта = Неопределено) Экспорт
	
	КрупныйШрифт = Новый Шрифт(,11);
	МелкийШрифт  = Новый Шрифт(,8);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("СчетКасса", СчетКасса);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ПоВсемВалютам", Валюта = Неопределено);
	Запрос.УстановитьПараметр("Валюта", Валюта);
	
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ДенежныеСредстваОстатки.Валюта КАК Валюта,
	|	ДенежныеСредстваОстатки.СуммаОстаток КАК Сумма
	|ИЗ
	|	РегистрНакопления.ДенежныеСредства.Остатки(
	|			,
	|			Организация = &Организация
	|				И СчетКасса = &СчетКасса
	|				И (&ПоВсемВалютам
	|					ИЛИ Валюта = &Валюта)) КАК ДенежныеСредстваОстатки";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Сумма = Выборка.Сумма;
		Валюта = Выборка.Валюта;
	Иначе
		Сумма = 0;
		Если ТипЗнч(СчетКасса) = Тип("СправочникСсылка.Кассы") Тогда
			Валюта = СчетКасса.Валюта;
		ИначеЕсли ТипЗнч(СчетКасса) = Тип("СправочникСсылка.БанковскиеСчета") Тогда
			Валюта = СчетКасса.Валюта;
		КонецЕсли;
	КонецЕсли;
	
	ОстатокДенежныхСредств = Сумма;
	
	КомпонентыФС = Новый Массив;
	КомпонентыФС.Добавить(Новый ФорматированнаяСтрока(НСтр("ru='Остаток'") + " ", КрупныйШрифт));
	
	СуммаСтрокой = Формат(Сумма, "ЧДЦ=2; ЧРД=,; ЧРГ=' '; ЧН=0,00");
	ПозицияРазделителя = СтрНайти(СуммаСтрокой, ",");
	КомпонентыЧисла = Новый Массив;
	КомпонентыЧисла.Добавить(Новый ФорматированнаяСтрока(Лев(СуммаСтрокой, ПозицияРазделителя), КрупныйШрифт));
	КомпонентыЧисла.Добавить(Новый ФорматированнаяСтрока(Сред(СуммаСтрокой, ПозицияРазделителя+1), МелкийШрифт));
	КомпонентыФС.Добавить(Новый ФорматированнаяСтрока(КомпонентыЧисла));
	
	КомпонентыФС.Добавить(" " + Валюта.Наименование);
	
	Возврат Новый ФорматированнаяСтрока(КомпонентыФС, , WebЦвета.ТусклоСерый);
	
КонецФункции

Процедура ОбновитьВидимостьИКурсВалюты(Форма, РеквизитВалюта = "Валюта") Экспорт
	
	Объект = Форма.Объект;
	Элементы = Форма.Элементы;
	
	Если Элементы.Найти("ПредставлениеКурсаВалюты") = Неопределено Тогда
		Возврат;
	КонецЕсли;
	 
	КрупныйШрифт = Новый Шрифт(,11);
	МелкийШрифт  = Новый Шрифт(,8);

	ВалютаУчета = ПолучитьФункциональнуюОпцию("ВалютаУчета");
	ВалютаДокумента = Объект[РеквизитВалюта];
	Если ВалютаДокумента = ВалютаУчета Тогда
		Элементы.ПредставлениеКурсаВалюты.Видимость = Ложь;
	Иначе
		Элементы.ПредставлениеКурсаВалюты.Видимость = Истина;
		ДатаКурса = ?(ЗначениеЗаполнено(Объект.Дата), Объект.Дата, ТекущаяДатаСеанса());
		Курс = РаботаСВалютой.ПересчитатьИзВалютыВВалюту(ВалютаДокумента, ВалютаУчета, ДатаКурса, 1);
		
		КомпонентыФС = Новый Массив;
		КомпонентыФС.Добавить(Новый ФорматированнаяСтрока(НСтр("ru='Курс'") + " ", КрупныйШрифт));
		
		//СуммаСтрокой = Формат(Курс, "ЧДЦ=4; ЧРД=,; ЧРГ=' '; ЧН=0,0000");
		//ПозицияРазделителя = СтрНайти(СуммаСтрокой, ",");
		//КомпонентыЧисла = Новый Массив;
		//КомпонентыЧисла.Добавить(Новый ФорматированнаяСтрока(Лев(СуммаСтрокой, ПозицияРазделителя), КрупныйШрифт));
		//КомпонентыЧисла.Добавить(Новый ФорматированнаяСтрока(Сред(СуммаСтрокой, ПозицияРазделителя+1), МелкийШрифт));
		//КомпонентыФС.Добавить(Новый ФорматированнаяСтрока(КомпонентыЧисла));
		//
		//КомпонентыФС.Добавить(" " + ВалютаУчета.Наименование);
		//
		//Элементы.ПредставлениеКурсаВалюты.Заголовок = Новый ФорматированнаяСтрока(КомпонентыФС, , WebЦвета.ЗеленыйЛес);
		
		СуммаСтрокой = Формат(Курс, "ЧДЦ=4; ЧРД=,; ЧРГ=' '; ЧН=0,0000");		
		Элементы.ПредставлениеКурсаВалюты.Заголовок = "1 " + ВалютаДокумента.Наименование + " = " + СуммаСтрокой + " " + ВалютаУчета.Наименование;
	КонецЕсли;
	
КонецПроцедуры

Процедура ДобавитьОснование(ДокументОбъект, ДанныеЗаполнения) Экспорт
	
	Если ОбщегоНазначения.ЕстьРеквизитОбъекта("Основание", ДокументОбъект.Метаданные()) Тогда
		ДокументОбъект.Основание = ДанныеЗаполнения;
		
	ИначеЕсли НЕ ДокументОбъект.Метаданные().ТабличныеЧасти.Найти("Основания") = Неопределено Тогда
		НоваяСтрока = ДокументОбъект.Основания.Добавить();
		НоваяСтрока.Основание = ДанныеЗаполнения;
		
	КонецЕсли;
	
КонецПроцедуры
	
#Область СтатьяДоходовРасходов

Процедура УстановитьВидимостьКолонокСтатейДиРВТабличнойЧасти(Форма, МассивЭлементов, УчитыватьНекассовыйМетод = Ложь, УчитыватьКассовыйМетод = Ложь) Экспорт
	
	ВыводитьСтатью = ПолучитьФункциональнуюОпцию("ИспользоватьВедениеУчетаДоходовРасходовПострочно");
	Если ВыводитьСтатью И УчитыватьНекассовыйМетод И НЕ ПараметрыСеанса.ФинРезультатНекассовыйМетодВеденияУчетаДоходовРасходов Тогда 
		ВыводитьСтатью = Ложь;
	КонецЕсли;
	Если ВыводитьСтатью И УчитыватьКассовыйМетод И НЕ ПараметрыСеанса.ФинРезультатКассовыйМетодВеденияУчетаДоходовРасходов Тогда 
		ВыводитьСтатью = Ложь;
	КонецЕсли;
		
	Для Каждого ТекущийЭлемент Из МассивЭлементов Цикл
		Попытка
			Форма.Элементы[ТекущийЭлемент].Видимость = ВыводитьСтатью;
		Исключение
		КонецПопытки;
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьСтатьюДоходовРасходов(Знач ФормаОбъект, Знач ВидОперации = Неопределено, ЭтоДоход = Истина, Знач Организация = Неопределено, Знач Подразделение = Неопределено) Экспорт
	
	Если НЕ ПараметрыСеанса.ФинРезультатИспользоватьВедениеУчетаДоходовРасходов Тогда
		Возврат Справочники.СтатьиДоходовИРасходов.ПустаяСсылка();
	КонецЕсли;
	
	//НаборЗаписей = РегистрыСведений.НастройкиСтатейДоходовРасходовПоУмолчанию.СоздатьНаборЗаписей();
	//НаборЗаписей.Отбор.ТипДокумента.Установить(ИмяДокумента);
	//НаборЗаписей.Отбор.ВидОперации.Установить(ВидОперации);
	//НаборЗаписей.Прочитать();
	//МассивРезультата = НаборЗаписей.ВыгрузитьКолонку("СтатьяДоходовРасходов"); 
	//Если МассивРезультата.Количество() > 0 Тогда
	//	//ВыбСтатья = МассивРезультата[0];
	//	Для каждого ВыбСтатья из МассивРезультата Цикл
	//		Если (ЭтоДоход И ВыбСтатья.ИспользуетсяВУчетеДоходов)
	//			ИЛИ (НЕ ЭтоДоход И ВыбСтатья.ИспользуетсяВУчетеРасходов) Тогда
	//			Возврат ВыбСтатья;
	//		КонецЕсли;
	//	КонецЦикла;
	//КонецЕсли;
	
	Если ТипЗнч(ФормаОбъект) = Тип("ДанныеФормыСтруктура") Тогда
		МетаданныеОбъекта = ФормаОбъект.Ссылка.Метаданные();
	Иначе
		МетаданныеОбъекта = ФормаОбъект.Метаданные();
	КонецЕсли;
	ИмяДокумента = МетаданныеОбъекта.Имя;
	
	Если Организация = Неопределено Тогда
		Организация = Справочники.Организации.ПустаяСсылка();
		Если ОбщегоНазначения.ЕстьРеквизитОбъекта("Организация", МетаданныеОбъекта) Тогда
			Организация = ФормаОбъект["Организация"];	
		КонецЕсли;
	КонецЕсли;
	Если Подразделение = Неопределено Тогда
		Подразделение = Справочники.Подразделения.ПустаяСсылка();
		Если ОбщегоНазначения.ЕстьРеквизитОбъекта("Подразделение", МетаданныеОбъекта) Тогда
			Подразделение = ФормаОбъект["Подразделение"];	
		КонецЕсли;
	КонецЕсли;
	
	ТипСтатьи = ?(ЭтоДоход, Перечисления.ТипыСтатейДоходовРасходов.Доход, Перечисления.ТипыСтатейДоходовРасходов.Расход); 
	
	Если ОбщегоНазначения.ЕстьРеквизитОбъекта("Контрагент", МетаданныеОбъекта) Тогда
		Контрагент = ФормаОбъект["Контрагент"];	
		Если НЕ ЭтоДоход И Контрагент <> Неопределено И ЗначениеЗаполнено(Контрагент.СтатьяРасходов) Тогда
			Возврат Контрагент.СтатьяРасходов;
		КонецЕсли;
	КонецЕсли;	
		
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТипДокумента", ИмяДокумента);
	Запрос.УстановитьПараметр("ВидОперации", ВидОперации);
	Запрос.УстановитьПараметр("ТипСтатьи", ТипСтатьи);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Подразделение", Подразделение);
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	1 КАК Приоритет,
	|	ДанныеРегистра.СтатьяДоходовРасходов КАК СтатьяДоходовРасходов
	|ПОМЕСТИТЬ ВТ
	|ИЗ
	|	РегистрСведений.НастройкиСтатейДоходовРасходовПоУмолчанию КАК ДанныеРегистра
	|ГДЕ
	|	ДанныеРегистра.ТипДокумента = &ТипДокумента
	|	И (ДанныеРегистра.ВидОперации = &ВидОперации ИЛИ &ВидОперации = Неопределено)
	|	И ДанныеРегистра.ТипСтатьи = &ТипСтатьи
	|	И НЕ ДанныеРегистра.Организация = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
	|	И НЕ ДанныеРегистра.Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	|	И ДанныеРегистра.Организация = &Организация
	|	И ДанныеРегистра.Подразделение = &Подразделение
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	2,
	|	ДанныеРегистра.СтатьяДоходовРасходов
	|ИЗ
	|	РегистрСведений.НастройкиСтатейДоходовРасходовПоУмолчанию КАК ДанныеРегистра
	|ГДЕ
	|	ДанныеРегистра.ТипДокумента = &ТипДокумента
	|	И (ДанныеРегистра.ВидОперации = &ВидОперации ИЛИ &ВидОперации = Неопределено)
	|	И ДанныеРегистра.ТипСтатьи = &ТипСтатьи
	|	И ДанныеРегистра.Организация = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
	|	И НЕ ДанныеРегистра.Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	|	И ДанныеРегистра.Подразделение = &Подразделение
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	3,
	|	ДанныеРегистра.СтатьяДоходовРасходов
	|ИЗ
	|	РегистрСведений.НастройкиСтатейДоходовРасходовПоУмолчанию КАК ДанныеРегистра
	|ГДЕ
	|	ДанныеРегистра.ТипДокумента = &ТипДокумента
	|	И (ДанныеРегистра.ВидОперации = &ВидОперации ИЛИ &ВидОперации = Неопределено)
	|	И ДанныеРегистра.ТипСтатьи = &ТипСтатьи
	|	И НЕ ДанныеРегистра.Организация = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
	|	И ДанныеРегистра.Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	|	И ДанныеРегистра.Организация = &Организация
	|
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	4,
	|	ДанныеРегистра.СтатьяДоходовРасходов
	|ИЗ
	|	РегистрСведений.НастройкиСтатейДоходовРасходовПоУмолчанию КАК ДанныеРегистра
	|ГДЕ
	|	ДанныеРегистра.ТипДокумента = &ТипДокумента
	|	И (ДанныеРегистра.ВидОперации = &ВидОперации ИЛИ &ВидОперации = Неопределено)
	|	И ДанныеРегистра.ТипСтатьи = &ТипСтатьи
	|	И ДанныеРегистра.Организация = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
	|	И ДанныеРегистра.Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ.СтатьяДоходовРасходов КАК СтатьяДоходовРасходов
	|ИЗ
	|	ВТ КАК ВТ
	|
	|УПОРЯДОЧИТЬ ПО
	|	ВТ.Приоритет";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.СтатьяДоходовРасходов;
	КонецЕсли;
	
	Возврат Справочники.СтатьиДоходовИРасходов.ПустаяСсылка();
	
КонецФункции

// Процедура устанавливает отметку незаполненности в зависимости от настроек системы.
//
// Параметры:
// 		ЭлементыФормы - ВсеЭлементыФормы - элементы формы документа
// 		ИмяЭлемента - Строка - имя элемента формы договора.
//
Процедура УстановитьОтметкуНезаполненныхСтатейДоходовРасходов(ЭлементыФормы) Экспорт
	
	//ЗаполнениеОбязательно = ПолучитьФункциональнуюОпцию("ИспользоватьВедениеУчетаДоходовРасходов") И ПолучитьФункциональнуюОпцию("НекассовыйМетодВеденияУчетаДоходовРасходов");
	ЗаполнениеОбязательно = ПараметрыСеанса.ФинРезультатНекассовыйМетодВеденияУчетаДоходовРасходов;
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(ЭлементыФормы, "СтатьяДоходов",  "АвтоОтметкаНезаполненного", ЗаполнениеОбязательно);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(ЭлементыФормы, "СтатьяРасходов", "АвтоОтметкаНезаполненного", ЗаполнениеОбязательно);
	Если Не ЗаполнениеОбязательно Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(ЭлементыФормы, "СтатьяДоходов",  "ОтметкаНезаполненного", Ложь);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(ЭлементыФормы, "СтатьяРасходов", "ОтметкаНезаполненного", Ложь);
	КонецЕсли;
	
КонецПроцедуры

// Проверяет заполнение статей доходов/расходов.
// Вызывается из обработчика ПередЗаписьюНаСервере формы объекта.
//
// Параметры:
//  Форма         - УправляемаяФорма 
//  ТекущийОбъект - Объект 
//
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи, ПроверятьСтатьюДоходов = Истина, ПроверятьСтатьюРасходов = Истина) Экспорт
	
	Если ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда		
		Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ТекущийОбъект, "СтатьяДоходов") И ПроверятьСтатьюДоходов Тогда
			Если ТекущийОбъект.СтатьяДоходов.Пустая() 
				И ПараметрыСеанса.ФинРезультатНекассовыйМетодВеденияУчетаДоходовРасходов Тогда
				ТекстОшибки = "Поле ""Статья доходов"" не заполнено, в проведении отказано!";
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки, , "Объект.СтатьяДоходов", , Отказ);			
			КонецЕсли;
		КонецЕсли;
		
		Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ТекущийОбъект, "СтатьяРасходов") И ПроверятьСтатьюРасходов Тогда
			Если ТекущийОбъект.СтатьяРасходов.Пустая() 
				И ПараметрыСеанса.ФинРезультатНекассовыйМетодВеденияУчетаДоходовРасходов Тогда
				ТекстОшибки = "Поле ""Статья расходов"" не заполнено, в проведении отказано!";
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки, , "Объект.СтатьяРасходов", , Отказ);			
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

