Функция СформироватьПечатнуюФормуПриложения(МассивОбъектов, ОбъектыПечати) Экспорт
	
	Макет = УправлениеПечатью.МакетПечатнойФормы("ОбщийМакет.ПриложениеСписокСотрудников");

	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.АвтоМасштаб         = Истина; //#14053
	ТабличныйДокумент.ИмяПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_ПлатежноеПоручение_Приложение";
	
	МенеджерОбъекта = ОбщегоНазначения.МенеджерОбъектаПоСсылке(МассивОбъектов[0]);
	
	СтруктураДанныхДляПечати = МенеджерОбъекта.ПолучитьДанныеДляПечатныхФорм(МассивОбъектов);
	ТаблицаДанныеПечати      = СтруктураДанныхДляПечати.РезультатПоШапке.Выгрузить();
	ВыборкаПоЗарплате 		 = СтруктураДанныхДляПечати.РезультатПоТабличнойЧастиЗарплата.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	МенеджерОбъекта.ДополнитьДанныеДляПечатныхФорм(ТаблицаДанныеПечати);
	
	ПервыйДокумент = Истина;
    Для Каждого ДанныеПечати Из ТаблицаДанныеПечати Цикл
        Если Не ПервыйДокумент Тогда
            // Все документы нужно выводить на разных страницах.
            ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
        КонецЕсли;
        ПервыйДокумент = Ложь;
        // Запомним номер строки, с которой начали выводить текущий документ.
        НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы + 1;	
	
		Если НЕ ДанныеПечати.ВидОперации = Перечисления.ВидыОперацийСписаниеСРасчетногоСчета.ЗарплатаСотрудникам Тогда
			ОбластьМакета = Макет.ПолучитьОбласть("Ошибка");
			ТабличныйДокумент.Вывести(ОбластьМакета);
			Продолжить;
			//Возврат ТабличныйДокумент;
		КонецЕсли;
		
		Попытка
			ОбластьМакета = Макет.ПолучитьОбласть("Шапка");
			ОбластьМакета.Параметры.Заполнить(ДанныеПечати);
			//ОбластьМакета.Параметры.Номер = ПрефиксацияОбъектовКлиентСервер.ПолучитьНомерНаПечать(Объект.Номер);
			ОбластьМакета.Параметры.Дата = Формат(ДанныеПечати.Дата, "ДЛФ=Д");
			ТабличныйДокумент.Вывести(ОбластьМакета);
		Исключение
		КонецПопытки;
	
		Попытка
			ОбластьМакета = Макет.ПолучитьОбласть("Заголовок");
			ОбластьМакета.Параметры.Заполнить(ДанныеПечати);
			ТабличныйДокумент.Вывести(ОбластьМакета);
		Исключение
		КонецПопытки;
		
		СтруктураПоиска = Новый Структура("Ссылка", ДанныеПечати.Ссылка);		
		ВыборкаПоЗарплате.Сбросить();
		Если ВыборкаПоЗарплате.НайтиСледующий(СтруктураПоиска) Тогда			
			Выборка = ВыборкаПоЗарплате.Выбрать();			
			Пока Выборка.Следующий() Цикл				
				Попытка
					ОбластьМакета = Макет.ПолучитьОбласть("Строка");
					ОбластьМакета.Параметры.Заполнить(ДанныеПечати);
					ОбластьМакета.Параметры.Заполнить(Выборка);	
					ТабличныйДокумент.Вывести(ОбластьМакета);
				Исключение
				КонецПопытки;
			КонецЦикла;		
		КонецЕсли;
		
		// В табличном документе необходимо задать имя области, в которую был 
        // выведен объект. Нужно для возможности печати комплектов документов.
        УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабличныйДокумент, 
            НомерСтрокиНачало, ОбъектыПечати, ДанныеПечати.Ссылка);
	КонецЦикла;
		
	ТабличныйДокумент.ОтображатьЗаголовки = Ложь;
	ТабличныйДокумент.ОтображатьСетку = Ложь;
	
	Возврат ТабличныйДокумент;
	
КонецФункции

#КонецОбласти

// №7928 осуществляет сверку суммы таблицы ЗапралатаСотрудникам с суммой документа (РКО, Списание с р/с, Заявка на расходование ДС, Платежное поручение исх.)
Процедура ПроверитьСуммуЗарплатыСотрудникамПоСуммеДокумента(ДокументОбъект, Отказ, РежимЗаписи) Экспорт
	
	Если РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
		
		Если (ТипЗнч(ДокументОбъект.Ссылка) = Тип("ДокументСсылка.РасходныйКассовыйОрдер") И ДокументОбъект.ВидОперации = Перечисления.ВидыОперацийРасходныйКассовыйОрдер.ЗарплатаСотрудникам)
			ИЛИ (ТипЗнч(ДокументОбъект.Ссылка) = Тип("ДокументСсылка.СписаниеСРасчетногоСчета") И ДокументОбъект.ВидОперации = Перечисления.ВидыОперацийСписаниеСРасчетногоСчета.ЗарплатаСотрудникам)
			ИЛИ (ТипЗнч(ДокументОбъект.Ссылка) = Тип("ДокументСсылка.ЗаявкаНаРасходованиеДенежныхСредств") И (ДокументОбъект.ВидОперацииРКО = Перечисления.ВидыОперацийРасходныйКассовыйОрдер.ЗарплатаСотрудникам ИЛИ ДокументОбъект.ВидОперацииСРС = Перечисления.ВидыОперацийСписаниеСРасчетногоСчета.ЗарплатаСотрудникам))
			ИЛИ (ТипЗнч(ДокументОбъект.Ссылка) = Тип("ДокументСсылка.ПлатежноеПоручениеИсходящее") И ДокументОбъект.ВидОперации = Перечисления.ВидыОперацийСписаниеСРасчетногоСчета.ЗарплатаСотрудникам)
		Тогда	
		
			СуммаДокумента = 0;
			Если ТипЗнч(ДокументОбъект.Ссылка) = Тип("ДокументСсылка.ЗаявкаНаРасходованиеДенежныхСредств") Тогда
				СуммаДокумента = ДокументОбъект.СуммаДокумента;
			Иначе
				СуммаДокумента = ДокументОбъект.Сумма;
			КонецЕсли;	
				
			СуммаЗарплаты = ДокументОбъект.ЗарплатаСотрудникам.Итог("Сумма");
			
			Если НЕ СуммаЗарплаты = СуммаДокумента Тогда
				ТекстСообщения = "Распределенная сумма зарплаты по сотрудникам " + СуммаЗарплаты + " " + ДокументОбъект.Валюта + ", не равняется сумме самого документа. Проведение отменено.";
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,,, Отказ);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

#Область ОбщиеПроцедурыДляДокументовПоступленияОплат

Процедура ДобавитьОснованиеЗаказаВРаспределениеПлатежа(Знач ДокументЗаказ, ТабличнаяЧасть_РаспределениеПлатежа, СуммаДокумента) Экспорт
	
	СписокДокументовКДобавлению = Новый ТаблицаЗначений;
	СписокДокументовКДобавлению.Колонки.Добавить("Документ");
	СписокДокументовКДобавлению.Колонки.Добавить("СуммаДокумента");
	
	Если ТипЗнч(ДокументЗаказ) = Тип("ДокументСсылка.СчетНаОплату")
		или ТипЗнч(ДокументЗаказ) = Тип("ДокументСсылка.ЗаказДоговор")
		или ТипЗнч(ДокументЗаказ) = Тип("ДокументСсылка.ЗаказПокупателя") 
		или ТипЗнч(ДокументЗаказ) = Тип("ДокументСсылка.Монтаж")
		или ТипЗнч(ДокументЗаказ) = Тип("ДокументСсылка.РеализацияТоваровИУслуг") 
		Тогда
		НоваяСтрока = СписокДокументовКДобавлению.Добавить();
		НоваяСтрока.Документ = ДокументЗаказ;
		НоваяСтрока.СуммаДокумента = ДокументЗаказ.СуммаДокумента;
	ИначеЕсли ТипЗнч(ДокументЗаказ) = Тип("ДокументСсылка.Замена") Тогда
		НоваяСтрока = СписокДокументовКДобавлению.Добавить();
		НоваяСтрока.Документ = ДокументЗаказ.Основание;
		НоваяСтрока.СуммаДокумента = ДокументЗаказ.СуммаДокумента;
		ДокументЗаказ = ДокументЗаказ.Основание;
	КонецЕсли;
	
	Если ТипЗнч(ДокументЗаказ) = Тип("ДокументСсылка.СчетНаОплату") Тогда
		Если ТипЗнч(ДокументЗаказ.Основание) = Тип("ДокументСсылка.СчетНаОплату")
			или ТипЗнч(ДокументЗаказ.Основание) = Тип("ДокументСсылка.ЗаказДоговор")
			или ТипЗнч(ДокументЗаказ.Основание) = Тип("ДокументСсылка.ЗаказПокупателя") Тогда
			
			Если НЕ ДокументЗаказ.Основание.Пустая() Тогда
				НоваяСтрока = СписокДокументовКДобавлению.Добавить();
				НоваяСтрока.Документ = ДокументЗаказ.Основание;
				НоваяСтрока.СуммаДокумента = ДокументЗаказ.Основание.СуммаДокумента;
			КонецЕсли;
			Для Каждого СтрокаОснований Из ДокументЗаказ.ДокументыОснования Цикл
				Если ТипЗнч(СтрокаОснований.Документ) = Тип("ДокументСсылка.СчетНаОплату")
					или ТипЗнч(СтрокаОснований.Документ) = Тип("ДокументСсылка.ЗаказДоговор")
					или ТипЗнч(СтрокаОснований.Документ) = Тип("ДокументСсылка.ЗаказПокупателя") Тогда
					
					Если НЕ СтрокаОснований.Документ.Пустая() Тогда
						НоваяСтрока = СписокДокументовКДобавлению.Добавить();
						НоваяСтрока.Документ = СтрокаОснований.Документ;
						НоваяСтрока.СуммаДокумента = СтрокаОснований.Документ.СуммаДокумента;
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	ИначеЕсли ТипЗнч(ДокументЗаказ) = Тип("ДокументСсылка.ЗаказНаПроизводство") Тогда
		Если ТипЗнч(ДокументЗаказ.ДокументОснование) = Тип("ДокументСсылка.СчетНаОплату")
			или ТипЗнч(ДокументЗаказ.ДокументОснование) = Тип("ДокументСсылка.ЗаказДоговор")
			или ТипЗнч(ДокументЗаказ.ДокументОснование) = Тип("ДокументСсылка.ЗаказПокупателя") Тогда
			
			Если НЕ ДокументЗаказ.ДокументОснование.Пустая() Тогда
				НоваяСтрока = СписокДокументовКДобавлению.Добавить();
				НоваяСтрока.Документ = ДокументЗаказ.ДокументОснование;
				НоваяСтрока.СуммаДокумента = ДокументЗаказ.ДокументОснование.СуммаДокумента;
			КонецЕсли;
		КонецЕсли;
	ИначеЕсли ТипЗнч(ДокументЗаказ) = Тип("ДокументСсылка.Монтаж") Тогда
		Если НЕ ДокументЗаказ.Основание = Неопределено Тогда
			Если ТипЗНЧ(ДокументЗаказ.Основание) = Тип("ДокументСсылка.ЗаказДоговор") И НЕ ДокументЗаказ.Основание.Пустая() Тогда
				НоваяСтрока = СписокДокументовКДобавлению.Добавить();
				НоваяСтрока.Документ = ДокументЗаказ.Основание;
				НоваяСтрока.СуммаДокумента = ДокументЗаказ.Основание.СуммаДокумента;
			КонецЕсли;	
		КонецЕсли;
	ИначеЕсли ТипЗнч(ДокументЗаказ) = Тип("ДокументСсылка.РеализацияТоваровИУслуг") Тогда
		Если ТипЗнч(ДокументЗаказ.Основание) = Тип("ДокументСсылка.СчетНаОплату")
			или ТипЗнч(ДокументЗаказ.Основание) = Тип("ДокументСсылка.ЗаказДоговор")
			или ТипЗнч(ДокументЗаказ.Основание) = Тип("ДокументСсылка.ЗаказПокупателя") Тогда
			
			Если НЕ ДокументЗаказ.Основание.Пустая() Тогда
				НоваяСтрока = СписокДокументовКДобавлению.Добавить();
				НоваяСтрока.Документ = ДокументЗаказ.Основание;
				НоваяСтрока.СуммаДокумента = ДокументЗаказ.Основание.СуммаДокумента;
			КонецЕсли;
			
			Для Каждого ТекСтрокаТЧ Из ДокументЗаказ.Товары Цикл
				Если ТипЗнч(ТекСтрокаТЧ.Заказ) = Тип("ДокументСсылка.СчетНаОплату")
					или ТипЗнч(ТекСтрокаТЧ.Заказ) = Тип("ДокументСсылка.ЗаказДоговор")
					или ТипЗнч(ТекСтрокаТЧ.Заказ) = Тип("ДокументСсылка.ЗаказПокупателя") Тогда
					
					Если НЕ ТекСтрокаТЧ.Заказ.Пустая() Тогда
						НоваяСтрока = СписокДокументовКДобавлению.Добавить();
						НоваяСтрока.Документ = ТекСтрокаТЧ.Заказ;
						НоваяСтрока.СуммаДокумента = НоваяСтрока.Документ.СуммаДокумента;
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
			Для Каждого ТекСтрокаТЧ Из ДокументЗаказ.Услуги Цикл
				Если ТипЗнч(ТекСтрокаТЧ.Заказ) = Тип("ДокументСсылка.СчетНаОплату")
					или ТипЗнч(ТекСтрокаТЧ.Заказ) = Тип("ДокументСсылка.ЗаказДоговор")
					или ТипЗнч(ТекСтрокаТЧ.Заказ) = Тип("ДокументСсылка.ЗаказПокупателя") Тогда
					
					Если НЕ ТекСтрокаТЧ.Заказ.Пустая() Тогда
						НоваяСтрока = СписокДокументовКДобавлению.Добавить();
						НоваяСтрока.Документ = ТекСтрокаТЧ.Заказ;
						НоваяСтрока.СуммаДокумента = НоваяСтрока.Документ.СуммаДокумента;
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	
	СписокДокументовКДобавлению.Свернуть("Документ, СуммаДокумента",);
	
	СписокПоВидамДокументов = СписокДокументовКДобавлению.Скопировать();
	СписокПоВидамДокументов.Колонки.Добавить("Вид", Новый ОписаниеТипов("строка"));
	Для Каждого ТекСтрокаВида Из СписокПоВидамДокументов Цикл
		ТекСтрокаВида.Вид = ТипЗнч(ТекСтрокаВида.Документ);
		ТекСтрокаВида.СуммаДокумента = СуммаДокумента;
	КонецЦикла;
	СписокПоВидамДокументов.Свернуть("Вид,СуммаДокумента");
	
	Для Каждого ДокументКДобавлению Из СписокДокументовКДобавлению Цикл
		ПараметрыПоиска = Новый Структура;
		ПараметрыПоиска.Вставить("Документ",ДокументКДобавлению.Документ);
		Если ТабличнаяЧасть_РаспределениеПлатежа.НайтиСтроки(ПараметрыПоиска).Количество() = 0 Тогда
			НоваяСтрока = ТабличнаяЧасть_РаспределениеПлатежа.Добавить();
			НоваяСтрока.Документ = ДокументКДобавлению.Документ;
			
			Отбор = Новый Структура;
			Отбор.Вставить("Вид", Строка(ТипЗнч(НоваяСтрока.Документ)));
			СтрокаПоВиду = СписокПоВидамДокументов.НайтиСтроки(Отбор);
			Если СтрокаПоВиду.Количество() > 0 Тогда
				СуммаДолга = РегистрыНакопления.РасчетыПоЗаказам.ПолучитьОстатокДолгаПоЗаказу(НоваяСтрока.Документ);
				Если СтрокаПоВиду[0].СуммаДокумента > 0 Тогда
					НоваяСтрока.Сумма = Мин(СтрокаПоВиду[0].СуммаДокумента, СуммаДолга);
					НоваяСтрока.СуммаВВалютеДокумента = НоваяСтрока.Сумма;
					СтрокаПоВиду[0].СуммаДокумента = СтрокаПоВиду[0].СуммаДокумента - НоваяСтрока.Сумма;
				Иначе
					//нечего распределять
				КонецЕсли;
			Иначе
				НоваяСтрока.Сумма = СуммаДокумента;
				НоваяСтрока.СуммаВВалютеДокумента = НоваяСтрока.Сумма;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла
	
КонецПроцедуры

Функция ПолучитьДатыОплатыПоДоговоруРассрочки(СсылкаНаЗаказ) Экспорт
	
	Результат = Новый СписокЗначений;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ДолгиПоРассрочкамОстаткиИОбороты.ЗаказДоговор КАК ЗаказДоговор,
	|	ДолгиПоРассрочкамОстаткиИОбороты.СрокПлатежа КАК ДатаПлатежа,
	|	СУММА(ДолгиПоРассрочкамОстаткиИОбороты.СуммаПриход) КАК Долг,
	|	СУММА(ДолгиПоРассрочкамОстаткиИОбороты.СуммаРасход) КАК Оплата,
	|	СУММА(ДолгиПоРассрочкамОстаткиИОбороты.СуммаПриход - ДолгиПоРассрочкамОстаткиИОбороты.СуммаРасход) КАК ОстатокДолга
	|ИЗ
	|	РегистрНакопления.ДолгиПоРассрочкам.ОстаткиИОбороты(, , Авто, , ЗаказДоговор = &Ссылка) КАК ДолгиПоРассрочкамОстаткиИОбороты
	|
	|СГРУППИРОВАТЬ ПО
	|	ДолгиПоРассрочкамОстаткиИОбороты.ЗаказДоговор,
	|	ДолгиПоРассрочкамОстаткиИОбороты.СрокПлатежа
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДатаПлатежа";

	Запрос.УстановитьПараметр("Ссылка", СсылкаНаЗаказ);
		
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Выборка.ОстатокДолга <= 0 Тогда
			Результат.Добавить(Выборка.ДатаПлатежа, Формат(Выборка.ДатаПлатежа,"ДЛФ=Д"),,БиблиотекаКартинок.ЗеленыйПолный);
		ИначеЕсли Выборка.Оплата = 0 Тогда 
			Результат.Добавить(Выборка.ДатаПлатежа, Формат(Выборка.ДатаПлатежа,"ДЛФ=Д"),,БиблиотекаКартинок.ЗеленыйПустой);
		Иначе
			Результат.Добавить(Выборка.ДатаПлатежа, Формат(Выборка.ДатаПлатежа,"ДЛФ=Д"),,БиблиотекаКартинок.ЗеленыйЧастичный);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

Функция ПолучитьОстатокДолгаПоЗаказу(Документ) Экспорт
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	РасчетыПоЗаказамОстатки.СуммаОстаток
	|ИЗ
	|	РегистрНакопления.РасчетыПоЗаказам.Остатки(, Заказ = &Заказ) КАК РасчетыПоЗаказамОстатки";
	Запрос.УстановитьПараметр("Заказ", Документ);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Возврат Выборка.СуммаОстаток;
	КонецЦикла;
	
	Возврат 0;
		
КонецФункции

//#7709
Процедура ДобавитьДокументыПродажиПоЗаказам(ДокументОбъект, Знач ДокументЗаказ) Экспорт
	
	СписокДокументовКДобавлению = Новый ТаблицаЗначений;
	СписокДокументовКДобавлению.Колонки.Добавить("Документ");
	СписокДокументовКДобавлению.Колонки.Добавить("СуммаДокумента");
	
	Если ТипЗнч(ДокументЗаказ) = Тип("ДокументСсылка.ЗаказДоговор") Тогда
		
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("Основание", ДокументЗаказ);
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Монтаж.Ссылка КАК Ссылка,
		|	Монтаж.СуммаДокумента КАК СуммаДокумента
		|ИЗ
		|	Документ.Монтаж КАК Монтаж
		|ГДЕ
		|	Монтаж.Основание = &Основание";
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл		
			НоваяСтрока = СписокДокументовКДобавлению.Добавить();
			НоваяСтрока.Документ = Выборка.Ссылка;
			НоваяСтрока.СуммаДокумента = Выборка.СуммаДокумента;
		КонецЦикла;
		
	ИначеЕсли ТипЗнч(ДокументЗаказ) = Тип("ДокументСсылка.ЗаказПокупателя") Тогда
		
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("Основание", ДокументЗаказ);
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РеализацияТоваровИУслуг.Ссылка КАК Ссылка,
		|	РеализацияТоваровИУслуг.СуммаДокумента КАК СуммаДокумента
		|ПОМЕСТИТЬ ВТ_Документы
		|ИЗ
		|	Документ.РеализацияТоваровИУслуг КАК РеализацияТоваровИУслуг
		|ГДЕ
		|	РеализацияТоваровИУслуг.Основание = &Основание
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	РеализацияТоваровИУслугОснования.Ссылка,
		|	РеализацияТоваровИУслугОснования.Ссылка.СуммаДокумента
		|ИЗ
		|	Документ.РеализацияТоваровИУслуг.Основания КАК РеализацияТоваровИУслугОснования
		|ГДЕ
		|	РеализацияТоваровИУслугОснования.Основание = &Основание
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ВТ_Документы.Ссылка КАК Ссылка,
		|	ВТ_Документы.СуммаДокумента КАК СуммаДокумента
		|ИЗ
		|	ВТ_Документы КАК ВТ_Документы";
		
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл		
			НоваяСтрока = СписокДокументовКДобавлению.Добавить();
			НоваяСтрока.Документ = Выборка.Ссылка;
			НоваяСтрока.СуммаДокумента = Выборка.СуммаДокумента;
		КонецЦикла;

	Иначе
		Возврат;
	КонецЕсли;
		
	СписокПоВидамДокументов = СписокДокументовКДобавлению.Скопировать();
	СписокПоВидамДокументов.Колонки.Добавить("Вид", Новый ОписаниеТипов("Строка"));
	Для Каждого ТекСтрокаВида Из СписокПоВидамДокументов Цикл
		ТекСтрокаВида.Вид = Строка(ТипЗнч(ТекСтрокаВида.Документ));
		ТекСтрокаВида.СуммаДокумента = ДокументОбъект.Сумма;
	КонецЦикла;
	СписокПоВидамДокументов.Свернуть("Вид,СуммаДокумента");
	
	Для Каждого ДокументКДобавлению Из СписокДокументовКДобавлению Цикл
		ПараметрыПоиска = Новый Структура;
		ПараметрыПоиска.Вставить("Документ",ДокументКДобавлению.Документ);
		Если ДокументОбъект.РаспределениеПлатежа.НайтиСтроки(ПараметрыПоиска).Количество() = 0 Тогда
			НоваяСтрока = ДокументОбъект.РаспределениеПлатежа.Добавить();
			НоваяСтрока.Документ = ДокументКДобавлению.Документ;
			
			Отбор = Новый Структура;
			Отбор.Вставить("Вид", Строка(ТипЗнч(НоваяСтрока.Документ)));
			СтрокаПоВиду = СписокПоВидамДокументов.НайтиСтроки(Отбор);
			Если СтрокаПоВиду.Количество() > 0 Тогда
				СуммаДолга = ПолучитьОстатокДолгаПоЗаказу(НоваяСтрока.Документ);
				Если СтрокаПоВиду[0].СуммаДокумента > 0 Тогда
					НоваяСтрока.Сумма = Мин(СтрокаПоВиду[0].СуммаДокумента, СуммаДолга);
					НоваяСтрока.СуммаВВалютеДокумента = НоваяСтрока.Сумма;
					СтрокаПоВиду[0].СуммаДокумента = СтрокаПоВиду[0].СуммаДокумента - НоваяСтрока.Сумма;
					
				Иначе
					//нечего распределять
				КонецЕсли;
			Иначе
				НоваяСтрока.Сумма = ДокументОбъект.Сумма;
				НоваяСтрока.СуммаВВалютеДокумента = НоваяСтрока.Сумма;
			КонецЕсли;
			
			//добавим в основания
			НайденныеСтрокиОснования = ДокументОбъект.Основания.НайтиСтроки(Новый Структура("Основание", ДокументКДобавлению.Документ));
			Если НайденныеСтрокиОснования.Количество() = 0 Тогда
				НоваяСтрокаОснования = ДокументОбъект.Основания.Добавить();
				НоваяСтрокаОснования.Основание = ДокументКДобавлению.Документ;
			КонецЕсли;
			
		КонецЕсли;
	КонецЦикла
	
КонецПроцедуры

// Определяет дату начала действия указания Банка России 5286-У
//
// Возвращаемое значение:
//    Дата - Дата начала действия указания
//
Функция НачалоДействияУказания2019_5286У() Экспорт
	
	// Указание ЦБ РФ N 5286-У от 14 октября 2019 г
	Возврат '20200601';
	
КонецФункции

// Определяет перечень кодов видов дохода согласно указанию Банка России 5286-У
//
// Параметры:
//     ВыплатаЗарплаты - Булево - Признак выплаты зарплаты
//
// Возвращаемое значение:
//    СписокЗначений - Коды видов дохода
//
Функция КодыВидовДохода(ВыплатаЗарплаты = Ложь) Экспорт
	
	Коды = Новый СписокЗначений;
	
	Если Не ВыплатаЗарплаты Тогда
		Коды.Добавить("", НСтр("ru = '(не заполняется) Не является доходом физического лица, взыскания не ограничиваются'"));
	КонецЕсли;
	Коды.Добавить("1", НСтр("ru = '1 - Разрешено удержание по исполнительному листу с ограничением по сумме'"));
	Коды.Добавить("2", НСтр("ru = '2 - Запрещено удержание по исполнительному листу'"));
	Коды.Добавить("3", НСтр("ru = '3 - Запрещено удержание по исполнительному листу с оговорками для алиментов'"));
	
	Возврат Коды;
	
КонецФункции

Процедура ЗаполнитьСписокКодовВидаДохода(ЭлементКодВидаДохода, ВидОперации) Экспорт
	
	ЭлементКодВидаДохода.СписокВыбора.Очистить();
	Для каждого ЭлементСписка Из КодыВидовДохода(
		ВидОперации = Перечисления.ВидыОперацийСписаниеСРасчетногоСчета.ЗарплатаСотруднику
		Или ВидОперации = Перечисления.ВидыОперацийСписаниеСРасчетногоСчета.ЗарплатаСотрудникам) Цикл
		ЭлементКодВидаДохода.СписокВыбора.Добавить(ЭлементСписка.Значение, ЭлементСписка.Представление);
	КонецЦикла;
	
КонецПроцедуры

Функция ВозможноВзысканиеСПеречисленияФизлицу(Дата, ВидОперации) Экспорт
	
	ПрименяетсяКодВидаДохода = (Дата >= НачалоДействияУказания2019_5286У());
	
	ВозможноПеречислениеСотруднику = (ВидОперации = Перечисления.ВидыОперацийСписаниеСРасчетногоСчета.ЗарплатаСотруднику
		Или ВидОперации = Перечисления.ВидыОперацийСписаниеСРасчетногоСчета.ЗарплатаСотрудникам
		Или ВидОперации = Перечисления.ВидыОперацийСписаниеСРасчетногоСчета.ВыдачаПодотчетнику);
	
	Возврат ПрименяетсяКодВидаДохода И ВозможноПеречислениеСотруднику;
	
КонецФункции
