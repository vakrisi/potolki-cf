		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДенежныеСредстваОстатки.СуммаОстаток
		|ИЗ
		|	РегистрНакопления.ДенежныеСредства.Остатки(
		|			&ДатаОстатков,
		|			Валюта = &Валюта
		|				И Организация = &Организация
		|				И СчетКасса = &СчетКасса) КАК ДенежныеСредстваОстатки";
		Запрос.УстановитьПараметр("ДатаОстатков",	ДатаДокумента);
		Запрос.УстановитьПараметр("Валюта",			ДокументОбъект.Валюта);
