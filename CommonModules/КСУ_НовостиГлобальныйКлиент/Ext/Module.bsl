Процедура КСУ_ПроверитьНовости() Экспорт
	ПодключитьОбработчикОжидания("КСУ_ОткрытьФормуНовостей", 10, истина);
КонецПроцедуры

Процедура КСУ_ОткрытьФормуНовостей() Экспорт
	новость = КСУ_Новости.ПолучитьНовостьКСУ();
	Если новость<>Неопределено Тогда
		ОткрытьФорму("ОбщаяФорма.КСУ_Новости", Новый структура("новость", новость));	
	КонецЕсли;
КонецПроцедуры