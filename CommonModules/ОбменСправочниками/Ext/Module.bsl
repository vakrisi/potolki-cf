// Модуль управляет регистрацией изменений в плане обмена ПланОбменаСправочники.
// Вызывается из подписок на события записи справочников Контрагенты и Номенклатура.

#Область ПрограммныйИнтерфейс

// Регистрирует изменение контрагента в плане обмена ПланОбменаСправочники
// с учётом фильтров, настроенных на каждом узле.
//
// Параметры:
//  Источник - СправочникОбъект.Контрагенты - записываемый объект.
//
Процедура ЗарегистрироватьИзменениеКонтрагента(Источник, Отказ) Экспорт

	Если Источник.ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	Если Источник.ЭтоГруппа Тогда
		Возврат;
	КонецЕсли;

	Если Источник.Предопределенный Тогда
		Возврат;
	КонецЕсли;

	ВыборкаУзлов = ПланыОбмена.ПланОбменаСправочники.Выбрать();
	Пока ВыборкаУзлов.Следующий() Цикл
		УзелОбмена = ВыборкаУзлов.Ссылка;

		Если ПланыОбмена.ПланОбменаСправочники.ЭтотУзел() = УзелОбмена Тогда
			Продолжить;
		КонецЕсли;

		Если СоответствуетФильтруКонтрагентов(Источник.Ссылка, УзелОбмена) Тогда
			ПланыОбмена.ЗарегистрироватьИзменения(УзелОбмена, Источник.Ссылка);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Регистрирует изменение номенклатуры в плане обмена ПланОбменаСправочники
// с учётом фильтров, настроенных на каждом узле.
//
// Параметры:
//  Источник - СправочникОбъект.Номенклатура - записываемый объект.
//
Процедура ЗарегистрироватьИзменениеНоменклатуры(Источник, Отказ) Экспорт

	Если Источник.ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	Если Источник.ЭтоГруппа Тогда
		Возврат;
	КонецЕсли;

	Если Источник.Предопределенный Тогда
		Возврат;
	КонецЕсли;

	ВыборкаУзлов = ПланыОбмена.ПланОбменаСправочники.Выбрать();
	Пока ВыборкаУзлов.Следующий() Цикл
		УзелОбмена = ВыборкаУзлов.Ссылка;

		Если ПланыОбмена.ПланОбменаСправочники.ЭтотУзел() = УзелОбмена Тогда
			Продолжить;
		КонецЕсли;

		Если СоответствуетФильтруНоменклатуры(Источник.Ссылка, УзелОбмена) Тогда
			ПланыОбмена.ЗарегистрироватьИзменения(УзелОбмена, Источник.Ссылка);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Проверяет соответствие контрагента фильтрам, заданным на узле плана обмена.
//
// Параметры:
//  СсылкаКонтрагента - СправочникСсылка.Контрагенты.
//  УзелОбмена        - ПланОбменаСсылка.ПланОбменаСправочники.
//
// Возвращаемое значение:
//  Булево - Истина, если объект соответствует фильтру или фильтр не задан.
//
Функция СоответствуетФильтруКонтрагентов(СсылкаКонтрагента, УзелОбмена)

	УзелОбъект = УзелОбмена.ПолучитьОбъект();

	Если НЕ УзелОбъект.ИспользоватьОтборКонтрагентов Тогда
		Возврат Истина;
	КонецЕсли;

	Если УзелОбъект.ОтборыКонтрагентов.Количество() = 0 Тогда
		Возврат Истина;
	КонецЕсли;

	РодительКонтрагента = СсылкаКонтрагента.Родитель;
	Для Каждого СтрокаОтбора Из УзелОбъект.ОтборыКонтрагентов Цикл
		ГруппаОтбора = СтрокаОтбора.Группа;
		Если РодительКонтрагента = ГруппаОтбора
			ИЛИ ЯвляетсяПодчиненным(РодительКонтрагента, ГруппаОтбора) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Проверяет соответствие номенклатуры фильтрам, заданным на узле плана обмена.
//
// Параметры:
//  СсылкаНоменклатуры - СправочникСсылка.Номенклатура.
//  УзелОбмена         - ПланОбменаСсылка.ПланОбменаСправочники.
//
// Возвращаемое значение:
//  Булево - Истина, если объект соответствует фильтру или фильтр не задан.
//
Функция СоответствуетФильтруНоменклатуры(СсылкаНоменклатуры, УзелОбмена)

	УзелОбъект = УзелОбмена.ПолучитьОбъект();

	Если НЕ УзелОбъект.ИспользоватьОтборНоменклатуры Тогда
		Возврат Истина;
	КонецЕсли;

	Если УзелОбъект.ОтборыНоменклатуры.Количество() = 0 Тогда
		Возврат Истина;
	КонецЕсли;

	РодительНоменклатуры = СсылкаНоменклатуры.Родитель;
	Для Каждого СтрокаОтбора Из УзелОбъект.ОтборыНоменклатуры Цикл
		ГруппаОтбора = СтрокаОтбора.Группа;
		Если РодительНоменклатуры = ГруппаОтбора
			ИЛИ ЯвляетсяПодчиненным(РодительНоменклатуры, ГруппаОтбора) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Проверяет, входит ли Элемент в иерархию ВозможногоРодителя.
//
// Параметры:
//  Элемент          - ссылка на элемент справочника с реквизитом Родитель.
//  ВозможныйРодитель - ссылка на группу справочника.
//
// Возвращаемое значение:
//  Булево.
//
Функция ЯвляетсяПодчиненным(Элемент, ВозможныйРодитель)

	ТекущийЭлемент = Элемент;
	Пока НЕ ТекущийЭлемент.Пустая() Цикл
		Если ТекущийЭлемент = ВозможныйРодитель Тогда
			Возврат Истина;
		КонецЕсли;
		ТекущийЭлемент = ТекущийЭлемент.Родитель;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

#КонецОбласти