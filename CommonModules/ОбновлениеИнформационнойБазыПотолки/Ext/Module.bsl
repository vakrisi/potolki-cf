			НоваяСтрока = ДокОбъект.ФактураПотолка.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущаяСтрока);
		КонецЦикла;
		
		ДокОбъект.УДАЛИТЬ_ПродукцияКоличество = 0;
		ДокОбъект.УДАЛИТЬ_ПродукцияФактура = Справочники.Фактура.ПустаяСсылка();
		ДокОбъект.УДАЛИТЬ_ПродукцияЦвет = Справочники.ЦветФактуры.ПустаяСсылка();
		
		Попытка
			ДокОбъект.Записать();
		Исключение
		КонецПопытки;
		
	КонецЦикла;
	
	//номенклатура
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Номенклатура.Ссылка
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
