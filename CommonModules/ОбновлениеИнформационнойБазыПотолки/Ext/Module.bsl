#Область Обновление_0_8_4_0

Процедура ОбработкаОбновления_0_8_4_0() Экспорт
	
	ВидНоменклатуры = Новый СписокЗначений;
	ВидНоменклатуры.Добавить(Справочники.ВидыНоменклатуры.Услуга);
	//ВидНоменклатуры.Добавить(Справочники.ВидыНоменклатуры.УслугаРаскрояКривых);
	//ВидНоменклатуры.Добавить(Справочники.ВидыНоменклатуры.УслугаРаскрояУглов);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПродажиОбороты.Регистратор
	|ИЗ
	|	РегистрНакопления.Продажи.Обороты(, , Регистратор, ) КАК ПродажиОбороты
	|ГДЕ
	|	ПродажиОбороты.Номенклатура.ВидНоменклатуры В(&ВидНоменклатуры)
	|	И ПродажиОбороты.Подразделение = &ПустоеПодразделение
	|	И ПродажиОбороты.Регистратор.Подразделение <> &ПустоеПодразделение";
	Запрос.УстановитьПараметр("ВидНоменклатуры",ВидНоменклатуры);
	Запрос.УстановитьПараметр("ПустоеПодразделение",Справочники.Подразделения.ПустаяСсылка());
	ТаблицаДокументов = Запрос.Выполнить().Выгрузить();
	ТаблицаДокументов.Свернуть("Регистратор",);
	Для Каждого ТекущаяСтрока Из ТаблицаДокументов Цикл
		Попытка
			ДокОбъект = ТекущаяСтрока.Регистратор.ПолучитьОбъект();
			ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
		Исключение
		КонецПопытки
	КонецЦикла;
				
КонецПроцедуры

