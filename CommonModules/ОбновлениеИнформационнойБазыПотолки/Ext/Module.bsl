Процедура ОбработкаОбновления_0_9_3_0() Экспорт
	
	ВремВалюта = Константы.ВалютаУчета.Получить();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЗаказНаПроизводство.Ссылка,
	|	ЗаказНаПроизводство.Дата КАК Дата
	|ИЗ
	|	Документ.ЗаказНаПроизводство КАК ЗаказНаПроизводство
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВыпускПродукции.Ссылка,
	|	ВыпускПродукции.Дата
	|ИЗ
	|	Документ.ВыпускПродукции КАК ВыпускПродукции
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ЗаказДоговор.Ссылка,
	|	ЗаказДоговор.Дата
	|ИЗ
	|	Документ.ЗаказДоговор КАК ЗаказДоговор
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата";
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Если ТипЗнч(Выборка.ССылка) = Тип("ДокументСсылка.ЗаказНаПроизводство") Тогда
			Если Выборка.ССылка.ВидЗаказа.Пустая() Тогда
				ДокОбъект = Выборка.ССылка.ПолучитьОбъект();
				Если ДокОбъект.ЗаказНаПродажу Тогда
					ДокОбъект.ВидЗаказа = Перечисления.ВидыЗаказовНаПроизводство.ЗаказНаПродажу;
				Иначе
					ДокОбъект.ВидЗаказа = Перечисления.ВидыЗаказовНаПроизводство.ПроизводствоПотолка;
				КонецЕсли;
				Попытка
					ДокОбъект.Записать();
				Исключение
				КонецПопытки;
			КонецЕсли;
		ИначеЕсли ТипЗнч(Выборка.ССылка) = Тип("ДокументСсылка.ВыпускПродукции") Тогда
			Если Выборка.ССылка.Проведен Тогда
				ДокОбъект = Выборка.ССылка.ПолучитьОбъект();
				Попытка
					ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
				Исключение
				КонецПопытки;
			КонецЕсли;
		ИначеЕсли ТипЗнч(Выборка.ССылка) = Тип("ДокументСсылка.ЗаказДоговор") Тогда
			Если Выборка.ССылка.СуммаДокументаПоПрайсу = 0 Тогда
				ДокОбъект = Выборка.ССылка.ПолучитьОбъект();
				Для Каждого ТекущаяСтрока Из ДокОбъект.ТоварыУслуги Цикл
					ТекущаяСтрока.ЦенаПоПрайсу = ЦеныКомпании.ПолучитьЦенуНоменклатуры(ТекущаяСтрока.Номенклатура, ТекущаяСтрока.ХарактеристикаНоменклатуры, ТекущаяСтрока.ЕдиницаИзмерения, ТекущаяСтрока.Количество,
																					   ДокОбъект.Дата, ДокОбъект.ВидЦен, ДокОбъект.Валюта);
					ТекущаяСтрока.СуммаПоПрайсу = ТекущаяСтрока.ЦенаПоПрайсу * ТекущаяСтрока.Количество;
				КонецЦикла;
				ДокОбъект.СуммаДокументаПоПрайсу = ДокОбъект.ТоварыУслуги.Итог("СуммаПоПрайсу");
				Попытка
					ДокОбъект.Записать();
				Исключение
				КонецПопытки;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

