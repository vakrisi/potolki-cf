	|	ЦветФактуры.Владелец КАК Фактура,
	|	ЦветФактуры.Номенклатура,
	|	ЦветФактуры.Владелец.ШиринаПолотна КАК ШиринаПолотна
	|ИЗ
	|	Справочник.ЦветФактуры КАК ЦветФактуры";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		Если НЕ Выборка.Номенклатура.Пустая() Тогда
			НомОбъект = Выборка.Номенклатура.ПолучитьОбъект();
			НомОбъект.Наименование = ОбменСEasyCeiling.ПолучитьНаименованиеПленки(Выборка.Цвет, Выборка.Фактура, Выборка.ШиринаПолотна);
			Попытка
				НомОбъект.Записать();
			Исключение
				ЗаписьЖурналаРегистрации("Обновление_1_0_2_0",УровеньЖурналаРегистрации.Ошибка,,,"Не удалось изменить наименование для номенклатуры пленки ["+Выборка.Номенклатура+"] : " +ОписаниеОшибки());
			КонецПопытки;
		КонецЕсли;
		
	КонецЦикла;
	
	//переименовываем номенклатуру потолка
	Если Константы.ПорядокФормированияНаименованияПотолка.Получить() = 1 Тогда
		//только для варианта ["Потолок " + НомерПотолка + " " + Цвет + " " + Фактура]
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	Номенклатура.Ссылка,
		|	Номенклатура.Потолок_Многфактурный,
		|	Номенклатура.Потолок_Фактура.(
		|		Ссылка,
		|		НомерСтроки,
		|		ПродукцияФактура,
		|		ПродукцияЦвет,
		|		ПродукцияКоличество,
		|		Основная
		|	),
		|	Номенклатура.Потолок_НомерРасчета,
		|	Номенклатура.Потолок_ПлощадьФотопечати
		|ИЗ
		|	Справочник.Номенклатура КАК Номенклатура
		|ГДЕ
		|	Номенклатура.ВидНоменклатуры = &ВидНоменклатуры";
		Запрос.УстановитьПараметр("ВидНоменклатуры", Справочники.ВидыНоменклатуры.Потолок);
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			ВремФактура = Неопределено;
			ВремЦвет = Неопределено;
			СтрокаФактура = Выборка.Потолок_Фактура.Выбрать();
			Пока СтрокаФактура.Следующий() Цикл
				Если СтрокаФактура.Основная Тогда
					ВремФактура = СтрокаФактура.ПродукцияФактура;
					ВремЦвет = СтрокаФактура.ПродукцияЦвет;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			Если НЕ ВремФактура = Неопределено И НЕ ВремЦвет = Неопределено Тогда
				НомОб = Выборка.Ссылка.ПолучитьОбъект();
				НомОб.Наименование = ОбменСEasyCeiling.ПолучитьНаименованиеПотолка(Выборка.Потолок_НомерРасчета, ВремЦвет, ВремФактура, Выборка.Потолок_Многфактурный,?(Выборка.Потолок_ПлощадьФотопечати > 0 ,Истина, Ложь)); 
				Попытка
					НомОб.Записать();
				Исключение
					ЗаписьЖурналаРегистрации("Обновление_1_0_2_0",УровеньЖурналаРегистрации.Ошибка,,,"Не удалось изменить наименование для элемента номенклатуры потолка ["+Выборка.Ссылка+"] : " +ОписаниеОшибки());
				КонецПопытки;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	ВерсияПрограммы = "1.0.2.0";
	
	//запоминаем заказы на производство - их нужно будет перезаполнить
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЗаказНаПроизводство.Ссылка,
	|	ЗаказНаПроизводство.Дата
	|ИЗ
	|	Документ.ЗаказНаПроизводство КАК ЗаказНаПроизводство";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		НаборЗаписей = РегистрыСведений.ОбъектыКОбработкеПослеОбновленияРекомендуемые.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.ВерсияПрограммы.Установить(ВерсияПрограммы); 
		НаборЗаписей.Отбор.Документ.Установить(Выборка.Ссылка); 
			
		НоваяЗапись = НаборЗаписей.Добавить(); 
		НоваяЗапись.ВерсияПрограммы = ВерсияПрограммы; 
		НоваяЗапись.Документ = Выборка.Ссылка; 
		НоваяЗапись.ДокументДата = Выборка.Дата; 
		
		НаборЗаписей.Записать(Истина);
	КонецЦикла;
	
	//запоминаем выпуски продукции - их нужно будет перезаполнить
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ВыпускПродукции.Ссылка,
	|	ВыпускПродукции.Дата
	|ИЗ
	|	Документ.ВыпускПродукции КАК ВыпускПродукции";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		НаборЗаписей = РегистрыСведений.ОбъектыКОбработкеПослеОбновленияРекомендуемые.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.ВерсияПрограммы.Установить(ВерсияПрограммы); 
		НаборЗаписей.Отбор.Документ.Установить(Выборка.Ссылка); 
			
		НоваяЗапись = НаборЗаписей.Добавить(); 
		НоваяЗапись.ВерсияПрограммы = ВерсияПрограммы; 
		НоваяЗапись.Документ = Выборка.Ссылка; 
		НоваяЗапись.ДокументДата = Выборка.Дата; 
		
		НаборЗаписей.Записать(Истина);
	КонецЦикла;

	
		
КонецПроцедуры

#КонецОбласти


#Область Обновление_1_0_3_0

Процедура ОбработкаОбновления_1_0_3_0() Экспорт
	
	ВерсияПрограммы = "1.0.3.0";
	
	//переименовываем наименование материала в элементах справочника "Фактуры"
	Запрос = новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ 
	|	Ссылка
	|ИЗ
	|	Справочник.Фактура";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		СсылкаНаОбъект = Выборка.Ссылка;
		ТекОбъект = СсылкаНаОбъект.ПолучитьОбъект();
		Если Не ТекОбъект.ЭтоГруппа Тогда
			ТекОбъект.Материал = ОбщийМодуль.ПолучитьНаименованиеМатериалаВФактуре(ТекОбъект.Наименование);
			Попытка
				ТекОбъект.Записать();
			Исключение
				ЗаписьЖурналаРегистрации("Обновление_1_0_3_0",УровеньЖурналаРегистрации.Ошибка,,,"Не удалось изменить наименование материала для элемента справочника Фактуры ["+Выборка.Ссылка+"] : " +ОписаниеОшибки());
			КонецПопытки;
		КонецЕсли;				
	КонецЦикла;
	
	
	//удаление из регистра сведений ПрикрепленныеДанные записи с пустыми СсылкамиНаОбъект документа ЗаявкаНаДоставку
	Запрос = новый Запрос;
	Запрос.Текст = "Выбрать
	|	Период,
	|	СсылкаНаОбъект,
	|	ИмяФайла
	|ИЗ РегистрСведений.ПрикрепленныеДанные
	|ГДЕ СсылкаНаОбъект = &ПустаяСсылка
	|";
	Запрос.УстановитьПараметр("ПустаяСсылка", Документы.ЗаявкаНаДоставку.ПустаяСсылка());
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл		
		Попытка
			НаборЗаписей = РегистрыСведений.ПрикрепленныеДанные.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.СсылкаНаОбъект.Установить(Выборка.СсылкаНаОбъект);
			НаборЗаписей.Записать();
		Исключение
			ЗаписьЖурналаРегистрации("Обновление_1_0_3_0",УровеньЖурналаРегистрации.Ошибка,,,"Не удалось удалить запись из регистра сведений ПрикрепленныеФайлы с пустой ссылкой ["+Строка(Выборка.Период)+" "+Строка(Выборка.ИмяФайла)+"] : " +ОписаниеОшибки());
		КонецПопытки;	
	КонецЦикла;
	
	//перезаполняем справочник "НастройкаИнтеркампани" (константы в будущем будут удалены)
	НастройкиИнтеркампани = Справочники.НастройкиИнтеркампани.Выбрать();
	Пока НастройкиИнтеркампани.Следующий() Цикл
		Если НЕ НастройкиИнтеркампани.ЭтоГруппа Тогда
			СпрОб = НастройкиИнтеркампани.ПолучитьОбъект();
			СпрОб.ОрганизацияПроизводствоПотолков = Константы.УДАЛИТЬ_ОрганизацияПроизводствоПотолков.Получить();
			СпрОб.ОрганизацияРозничныеПродажи = Константы.УДАЛИТЬ_ОрганизацияРозничныеПродажи.Получить();
			СпрОб.КонтрагентПроизводствоПотолков = Константы.УДАЛИТЬ_КонтрагентПроизводствоПотолков.Получить();
			СпрОб.КонтрагентРозничныеПродажи = Константы.УДАЛИТЬ_КонтрагентРозничныеПродажи.Получить();
			//СпрОб.НеУчитыватьСтоимостьВЗаказахНаПроизводство = Константы.УДАЛИТЬ_НеУчитыватьСтоимостьВЗаказахНаПроизводство.Получить();
			//СпрОб.УДАЛИТЬ_ПередачаПотолковВРозницуБезПродажи = Константы.УДАЛИТЬ_ПередачаПотолковВРозницуБезПродажи.Получить();
			СпрОб.Записать();
		КонецЕсли;
	КонецЦикла;
	
	//запоминаем заказы на производство - их нужно будет перезаполнить
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЗаказНаПроизводство.Ссылка,
	|	ЗаказНаПроизводство.Дата
	|ИЗ
	|	Документ.ЗаказНаПроизводство КАК ЗаказНаПроизводство
	|ГДЕ
	|	ЗаказНаПроизводство.ДокументОснование ССЫЛКА Документ.ЗаказДоговор
	|	И ЗаказНаПроизводство.НастройкаИнтеркампани = &ПустаяНастройкаИнтеркампани";
	Запрос.УстановитьПараметр("ПустаяНастройкаИнтеркампани", Справочники.НастройкиИнтеркампани.ПустаяСсылка());
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		НаборЗаписей = РегистрыСведений.ОбъектыКОбработкеПослеОбновленияРекомендуемые.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.ВерсияПрограммы.Установить(ВерсияПрограммы); 
		НаборЗаписей.Отбор.Документ.Установить(Выборка.Ссылка); 
			
		НоваяЗапись = НаборЗаписей.Добавить(); 
		НоваяЗапись.ВерсияПрограммы = ВерсияПрограммы; 
		НоваяЗапись.Документ = Выборка.Ссылка; 
		НоваяЗапись.ДокументДата = Выборка.Дата; 
		
		НаборЗаписей.Записать(Истина);
	КонецЦикла;
	
	//если стоит галочка "Общие склады" - все документы что двигают РН "ТоварыНаСкладах" нужно пеерпровести - изменилась логика движения по этому регистру
	Если Константы.ОбщиеСклады.Получить() Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТоварыНаСкладахОбороты.Регистратор КАК Ссылка,
		|	ТоварыНаСкладахОбороты.Регистратор.Дата КАК Дата
		|ИЗ
		|	РегистрНакопления.ТоварыНаСкладах.Обороты(, , Регистратор, ) КАК ТоварыНаСкладахОбороты
		|
		|УПОРЯДОЧИТЬ ПО
		|	ТоварыНаСкладахОбороты.Период";
		
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			
			НаборЗаписей = РегистрыСведений.ОбъектыКОбработкеПослеОбновленияРекомендуемые.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.ВерсияПрограммы.Установить(ВерсияПрограммы); 
			НаборЗаписей.Отбор.Документ.Установить(Выборка.Ссылка); 
			
			НоваяЗапись = НаборЗаписей.Добавить(); 
			НоваяЗапись.ВерсияПрограммы = ВерсияПрограммы; 
			НоваяЗапись.Документ = Выборка.Ссылка; 
			НоваяЗапись.ДокументДата = Выборка.Дата; 
			
			НаборЗаписей.Записать(Истина);
		КонецЦикла;
		
	КонецЕсли;
		
КонецПроцедуры

