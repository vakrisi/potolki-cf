		НоваяЗапись.Документ = Выборка.Ссылка; 
		НоваяЗапись.ДокументДата = Выборка.Дата; 
		
		НаборЗаписей.Записать(Истина);
	КонецЦикла;
	
	//////////////////////////////////////////////
	//#4450 Константы.СоздаватьНовыйЛидЕслиПоТекущемуЛидуУжеЕстьДоговор.Установить(Истина);
	//////////////////////////////////////////////
	
	//возвраты товаров от покупателя
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ВозвратТовараОтПокупателя.Ссылка,
	|	ВозвратТовараОтПокупателя.Дата
	|ИЗ
	|	Документ.ВозвратТовараОтПокупателя КАК ВозвратТовараОтПокупателя
	|ГДЕ
