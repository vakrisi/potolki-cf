			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущаяСтрока);
		КонецЦикла;
		
		ДокОбъект.УДАЛИТЬ_Фактура = Справочники.Фактура.ПустаяСсылка();
		ДокОбъект.УДАЛИТЬ_ЦветФактуры = Справочники.ЦветФактуры.ПустаяСсылка();
		
