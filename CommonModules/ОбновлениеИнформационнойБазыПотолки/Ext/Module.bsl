	//заполнение валюты в документах "УсановкаЦенПоставщика"
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	УстановкаЦенПоставщика.Ссылка
	|ИЗ
	|	Документ.УстановкаЦенПоставщика КАК УстановкаЦенПоставщика
	|ГДЕ
	|	УстановкаЦенПоставщика.Валюта = &Валюта";
	Запрос.УстановитьПараметр("Валюта",Справочники.Валюты.ПустаяСсылка());
	Выборка = Запрос.Выполнить().Выбрать();
	ВалютаУчета = Константы.ВалютаУчета.Получить();
	Пока Выборка.Следующий() Цикл
		ДокОбъект = Выборка.Ссылка.ПолучитьОбъект();
		ДокОбъект.Валюта = ВалютаУчета;
		ДокОбъект.Записать();
	КонецЦикла;
	
	//заполняем розничную организацию пользователей
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Пользователи.Ссылка
	|ИЗ
	|	Справочник.Пользователи КАК Пользователи
	|ГДЕ
	|	Пользователи.ОрганизацияРозницы = &ОрганизацияРозницы";
	Запрос.УстановитьПараметр("ОрганизацияРозницы",Справочники.Организации.ПустаяСсылка());
	
	ОрганизацияРозницы = Константы.УДАЛИТЬ_ОрганизацияРозничныеПродажи.Получить();
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ДокОбъект = Выборка.Ссылка.ПолучитьОбъект();
		ДокОбъект.ОрганизацияРозницы = ОрганизацияРозницы;
		ДокОбъект.Записать();
	КонецЦикла;
	
	//настраиваем документы "Возврат продукции"
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ВозвратПродукции.Ссылка
	|ИЗ
	|	Документ.ВозвратПродукции КАК ВозвратПродукции
	|ГДЕ
	|	ВозвратПродукции.БракПроизводства";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ДокОбъект = Выборка.Ссылка.ПолучитьОбъект();
		ДокОбъект.УменьшитьДолгКонтрагента = ДокОбъект.БракПроизводства;
		ДокОбъект.Записать();
	КонецЦикла;

	
	
КонецПроцедуры

#КонецОбласти

