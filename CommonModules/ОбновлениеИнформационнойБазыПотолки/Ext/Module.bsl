				ТекЗапись.СсылкаНаОбъект = Выборка.Ссылка;
				ТекЗапись.ИмяФайла = Выборка.ИмяФайла;
				ТекЗапись.Период = Выборка.Период;
				ТекЗапись.Прочитать();
				
				ТекЗапись.СсылкаНаОбъект  = ДокОбъект.ПродукцияНоменклатура;
				Попытка
					ТекЗапись.Записать();
