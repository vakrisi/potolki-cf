Процедура ОбработкаОбновления_0_8_3_0() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЦеныУслугРаскроя.Ссылка
	|ИЗ
	|	Справочник.ЦеныУслугРаскроя КАК ЦеныУслугРаскроя";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Выборка.Ссылка.ДлинаШвовМногофактурный.Количество() = 0 Тогда
			ЭлементОбъект = Выборка.Ссылка.ПолучитьОбъект();
			Для Каждого ТекущаяСтрока Из ЭлементОбъект.ДлинаШвов Цикл
				НоваяСтрока = ЭлементОбъект.ДлинаШвовМногофактурный.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущаяСтрока);
			КонецЦикла;
			ЭлементОбъект.Записать();
		КонецЕсли;
	КонецЦикла;
				
КонецПроцедуры

