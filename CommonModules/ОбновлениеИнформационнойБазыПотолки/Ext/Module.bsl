	|	ДанныеРегистра.Регистратор.Дата КАК Дата
	|ИЗ
	|	РегистрНакопления.РасчетыПоЗаказам КАК ДанныеРегистра
	|ГДЕ
	|	ДанныеРегистра.Контрагент.Ссылка ЕСТЬ NULL";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл		
		ПоместитьВРегистрКОбработке(ВерсияПрограммы, Выборка.Ссылка, Выборка.Дата,, 1);
	КонецЦикла;
	
	// №6303 статья доходов для нового документа "СоглашениеОРасторженииДоговора"
	МенеджерЗаписи = РегистрыСведений.НастройкиСтатейДоходовРасходовПоУмолчанию.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.ТипДокумента = "СоглашениеОРасторженииДоговора"; 
	МенеджерЗаписи.ВидОперации 	= Неопределено; 
	МенеджерЗаписи.ТипСтатьи    = Перечисления.ТипыСтатейДоходовРасходов.Доход;
	МенеджерЗаписи.СтатьяДоходовРасходов = Справочники.СтатьиДоходовИРасходов.ПрочиеДоходы;
	МенеджерЗаписи.Записать();
	
	МенеджерЗаписи = РегистрыСведений.НастройкиСтатейДоходовРасходовПоУмолчанию.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.ТипДокумента = "СоглашениеОРасторженииДоговора"; 
	МенеджерЗаписи.ВидОперации 	= Неопределено; 
	МенеджерЗаписи.ТипСтатьи    = Перечисления.ТипыСтатейДоходовРасходов.Расход;
	МенеджерЗаписи.СтатьяДоходовРасходов = Справочники.СтатьиДоходовИРасходов.ПрочиеРасходы;
	МенеджерЗаписи.Записать();
	
	// №6627 новая константа
	Константы.ПриВходящемЗвонкеОткрыватьКарточкуЛидаВРаботе.Установить(Истина);
	
	// №6761 если включено использование ведения учета доходов и расходов и кассовый метод, необходимо документы ОБК с заполненной статьей доходов перепровести, чтобы они сформировали движения в регистр ДоходыРасходы
	Если Константы.ИспользоватьВедениеУчетаДоходовРасходов.Получить() И Константы.КассовыйМетодВеденияУчетаДоходовРасходов.Получить() Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ОплатаБанковскойКартой.Ссылка КАК Ссылка,
		|	ОплатаБанковскойКартой.Дата КАК Дата
		|ИЗ
		|	Документ.ОплатаБанковскойКартой КАК ОплатаБанковскойКартой
		|ГДЕ
		|	ОплатаБанковскойКартой.Проведен
		|	И НЕ ОплатаБанковскойКартой.СтатьяДоходов = Значение(Справочник.СтатьиДоходовИРасходов.ПустаяСсылка)";
		
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл		
			ПоместитьВРегистрКОбработке(ВерсияПрограммы, Выборка.Ссылка, Выборка.Дата,, 1);
		КонецЦикла;
	КонецЕсли;
	
	// №6819 нужно у всех пользователей снять помеченные на удаление роли
	Запрос = новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СправочникПользователи.Ссылка,
		|	СправочникПользователи.ИдентификаторПользователяИБ КАК ИдентификаторПользователяИБ
		|ИЗ
		|	Справочник.Пользователи КАК СправочникПользователи";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
	
		СвойстваПользователя = Неопределено;
		Если Пользователи.ПрочитатьПользователяИБ(Выборка.ИдентификаторПользователяИБ, СвойстваПользователя) Тогда
			
			ТребуетсяЗапись = Ложь;
			КоличествоРолей = СвойстваПользователя.Роли.Количество()-1;
			Для Сч = 0 По КоличествоРолей Цикл
				Если Врег(Лев(СвойстваПользователя.Роли[КоличествоРолей-Сч], 7)) = Врег("Удалить") Тогда
					СвойстваПользователя.Роли.Удалить(КоличествоРолей-Сч);
					ТребуетсяЗапись = Истина;
				КонецЕсли;	
			КонецЦикла;
			
			Если ТребуетсяЗапись Тогда
				Пользователи.ЗаписатьПользователяИБ(Выборка.ИдентификаторПользователяИБ, СвойстваПользователя);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	//#7042
	// При обновлении на версию в документе "Установка стоимости выработки" не заполнилась "Вид начисления"
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	УстановкаСтоимостиВыработкиПоНоменклатуре.Ссылка КАК Ссылка,
	|	УстановкаСтоимостиВыработкиПоНоменклатуре.Дата КАК Дата
	|ИЗ
	|	Документ.УстановкаСтоимостиВыработкиПоНоменклатуре КАК УстановкаСтоимостиВыработкиПоНоменклатуре
	|ГДЕ
	|	УстановкаСтоимостиВыработкиПоНоменклатуре.ВидНачисления = ЗНАЧЕНИЕ(Справочник.ВидыНачислений.ПустаяСсылка)
	|	И НЕ УстановкаСтоимостиВыработкиПоНоменклатуре.ВидИсполнителя = ЗНАЧЕНИЕ(Справочник.ВидыИсполнителей.ПустаяСсылка)";

	Выборка = Запрос.Выполнить().Выбрать();	
	Пока Выборка.Следующий() Цикл
		ПоместитьВРегистрКОбработке("2.0.3.2", Выборка.Ссылка, Выборка.Дата,, 3); //в обработку с спец.номером версии
	КонецЦикла;
	
	// №4742 перенумерация Лидов, теперь периодчиность номера "Непериодический"
	Если Метаданные.Документы.Лид.ПериодичностьНомера = Метаданные.СвойстваОбъектов.ПериодичностьНомераДокумента.Непериодический Тогда
		
		Запрос = новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Лид.Ссылка КАК Ссылка,
		|	Лид.Номер КАК Номер,
		|	Лид.Дата КАК Дата
		|ИЗ
		|	Документ.Лид КАК Лид
		|ГДЕ
		|	ВЫРАЗИТЬ(ГОД(Лид.Дата) КАК Число(4)) = 2020
		|
		|УПОРЯДОЧИТЬ ПО
		|	Лид.Номер";
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Пока Выборка.Следующий() Цикл
			
			ДокументОбъект = Выборка.Ссылка.ПолучитьОбъект();
			ДокументОбъект.УстановитьНовыйНомер();
			
			ДокументОбъект.Записать();
			
		КонецЦикла;
		
		ОбновитьНумерациюОбъектов(Метаданные.Документы.Лид);
		
	КонецЕсли;
	
	// №6952 в регистр "Замеры" добавлено новое измерение "НазначилЗамер" и ресурс "ПричинаОтказа", нужно перепровести Лиды
	Запрос = новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	Замеры.Регистратор КАК Ссылка,
		|	Замеры.Регистратор.Дата КАК Дата
		|ИЗ
		|	РегистрСведений.Замеры КАК Замеры
		|ГДЕ
		|   НЕ Замеры.ЭтоВыезд
		|   И Замеры.Регистратор ССЫЛКА Документ.Лид";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл		
		ПоместитьВРегистрКОбработке(ВерсияПрограммы, Выборка.Ссылка, Выборка.Дата,, 1);
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область Обновление_2_4_0_0

Процедура ОбработкаОбновления_2_4_0_0() Экспорт
	
	ВерсияПрограммы = "2.4.0.0";
	
	// №6876 при начислении бонусов по ОБК изменился принцип получения настройки начисления с кассы на эквайринговый терминал
	// Получим список документов ОБК у которых:
	//  - сумма бонусов к начислению больше 0
	//	- заполнена касса
	//	- установлена галочка НачислятьБонусы
	//	- вид операции "ОБК"
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ОплатаБанковскойКартой.Ссылка КАК Ссылка,
		|	ОплатаБанковскойКартой.Организация КАК Организация,
		|	ОплатаБанковскойКартой.Контрагент.Категория КАК КатегорияКонтрагента,
		|	ОплатаБанковскойКартой.Дата КАК Дата,
		|	ОплатаБанковскойКартой.Касса КАК Касса,
		|	ОплатаБанковскойКартой.ЭквайринговыйТерминал КАК ЭквайринговыйТерминал
		|ИЗ
		|	Документ.ОплатаБанковскойКартой КАК ОплатаБанковскойКартой
		|ГДЕ
		|	ОплатаБанковскойКартой.СуммаБонусовКНачислениюПоДисконтнойКарте > 0
		|	И НЕ ОплатаБанковскойКартой.Касса = Значение(Справочник.Кассы.ПустаяСсылка)
		|	И ОплатаБанковскойКартой.НачислятьБонусы
		|	И ОплатаБанковскойКартой.ВидОперации = Значение(Перечисление.ВидыОперацийОплатаБанковскойКартой.ОплатаБанковскойКартой)";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		// Необходимо найти настройку срезом последних и дополнить документ эквайрингом
		подЗапрос = новый Запрос;
		подЗапрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НастройкиНачисленияБонусовПоПродажамСрезПоследних.Регистратор,
		|	НастройкиНачисленияБонусовПоПродажамСрезПоследних.Организация,
		|	НастройкиНачисленияБонусовПоПродажамСрезПоследних.КатегорияКонтрагента,	
		|	НастройкиНачисленияБонусовПоПродажамСрезПоследних.БонусПроцентом
		|ИЗ
		|	РегистрСведений.НастройкиНачисленияБонусовПоПродажам.СрезПоследних(&Дата, ) КАК НастройкиНачисленияБонусовПоПродажамСрезПоследних
		|ГДЕ
		|	НастройкиНачисленияБонусовПоПродажамСрезПоследних.Организация = &Организация
		|	И НастройкиНачисленияБонусовПоПродажамСрезПоследних.КатегорияКонтрагента = &КатегорияКонтрагента
		|	И НастройкиНачисленияБонусовПоПродажамСрезПоследних.ВидДокумента = Значение(Справочник.ВидыДокументовНачисленияБонусов.ОплатаБанковскойКартой)
		|	И НастройкиНачисленияБонусовПоПродажамСрезПоследних.СчетКасса = &СчетКасса";
		подЗапрос.УстановитьПараметр("Дата", Выборка.Дата);
		подЗапрос.УстановитьПараметр("Организация", Выборка.Организация);
		подЗапрос.УстановитьПараметр("КатегорияКонтрагента", Выборка.КатегорияКонтрагента);
		подЗапрос.УстановитьПараметр("СчетКасса", Выборка.Касса);
			
		подВыборка = подЗапрос.Выполнить().Выбрать();
		Если подВыборка.Следующий() Тогда
			
			ДокументОбъект = подВыборка.Регистратор.ПолучитьОбъект();
			
			// В документе попробуем сперва найти Эквайринг, может он уже задан
			НайденныеСтроки = ДокументОбъект.СчетаИКассы.НайтиСтроки(новый Структура("СчетКасса", Выборка.ЭквайринговыйТерминал));
			Если НайденныеСтроки.Количество() = 0 Тогда
				НоваяСтрока = ДокументОбъект.СчетаИКассы.Добавить();
				НоваяСтрока.СчетКасса = Выборка.ЭквайринговыйТерминал;
				
				Попытка
					ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
				Исключение
				КонецПопытки;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;	
	
	//#7052
	Если Константы.ПереноситьВАрхивРасчетыПостроителяПроизводство.Получить() И Константы.ИндивидуальныеКаталогиЗагрузкиЧертежейИзEasyCeiling.Получить() Тогда
		//всем пользователям, у кого указан каталог резервных копий для файлов построителя (производство) взведем галочку необходимости выполнять это резервное копирование
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	Пользователи.Ссылка КАК Ссылка,
		|	Пользователи.КаталогДляРезеврныхКопийВыгрузокИзИзиСилинг КАК КаталогДляРезеврныхКопийВыгрузокИзИзиСилинг
		|ИЗ
		|	Справочник.Пользователи КАК Пользователи
		|ГДЕ
		|	НЕ Пользователи.ПометкаУдаления
		|	И НЕ Пользователи.Недействителен";
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Если НЕ ПустаяСтрока(Выборка.КаталогДляРезеврныхКопийВыгрузокИзИзиСилинг) Тогда
				ПользовательОбъект = Выборка.Ссылка.ПолучитьОбъект();
				ПользовательОбъект.ПереноситьВАрхивРасчетыПостроителяПроизводство = Истина;
				ПользовательОбъект.Записать();
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Если Константы.ПереноситьФайлыВАрхивПриЗагрузкеПотолкаИзПостроителяВРознице.Получить() И Константы.ПапкиОпределяютсяВКарточкеПользователяРозница.Получить() Тогда
		//всем пользователям, у кого указан каталог резервных копий для файлов построителя (розница) взведем галочку необходимости выполнять это резервное копирование
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	Пользователи.Ссылка КАК Ссылка,
		|	Пользователи.КаталогДляРезеврныхКопийВыгрузокИзИзиСилингРозница КАК КаталогДляРезеврныхКопийВыгрузокИзИзиСилингРозница
		|ИЗ
		|	Справочник.Пользователи КАК Пользователи
		|ГДЕ
		|	НЕ Пользователи.ПометкаУдаления
		|	И НЕ Пользователи.Недействителен";
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Если НЕ ПустаяСтрока(Выборка.КаталогДляРезеврныхКопийВыгрузокИзИзиСилингРозница) Тогда
				ПользовательОбъект = Выборка.Ссылка.ПолучитьОбъект();
				ПользовательОбъект.ПереноситьФайлыВАрхивПриЗагрузкеПотолкаИзПостроителяВРознице = Истина;
				ПользовательОбъект.Записать();
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	//#7342
	Запрос = новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ДанныеДокумента.Ссылка КАК Ссылка,
	|	ДанныеДокумента.Дата КАК Дата
	|ИЗ
	|	Документ.ОплатаБанковскойКартой КАК ДанныеДокумента
	|ГДЕ
	|	ДанныеДокумента.Проведен
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ДанныеДокумента.Ссылка,
	|	ДанныеДокумента.Дата
	|ИЗ
	|	Документ.ПоступлениеНаРасчетныйСчет КАК ДанныеДокумента
	|ГДЕ
	|	ДанныеДокумента.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийПоступлениеНаРасчетныйСчет.ПоступлениеПоБанковскимКартам)
	|	И ДанныеДокумента.Проведен
	|";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл		
		ПоместитьВРегистрКОбработке(ВерсияПрограммы, Выборка.Ссылка, Выборка.Дата);
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область Обновление_2_4_2_0

Процедура ОбработкаОбновления_2_4_2_0() Экспорт
	
	ВерсияПрограммы = "2.4.2.0";
	
	// №1083
	//!!! Внимание документы Монтаж и Заказы покупателей не добавлять в обработку версии 2.4.2.0, чтобы они не пересеклись с документами по другим датам
	// В монтаже и заказе покупателя добавлена галочка "СозданПриИспользованииСтатусаЗакрыт"
	// При обновлении на версию, если используется статус «Закрыт» в настройках программы, 
	// находить самый первый документ в этом статусе и ему и всем последующим документам ставить галочку «Создан при использовании статуса закрыт».
		
	Если Константы.ИспользоватьСтатусЗакрытВЗаказеПокупателя.Получить() Тогда
		
		Запрос = новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	ДанныеДокумента.Ссылка КАК Ссылка,
		|	ДанныеДокумента.Дата КАК Дата
		|
