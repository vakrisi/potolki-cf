Процедура ОбработкаОбновления_2_0_3_0() Экспорт
	
	ВерсияПрограммы = "2.0.3.0";
	
	// Порядки для версии
	//1 2.0.3.0
	//2 2.0.3.1
	//3 2.0.3.2
	//4 2.0.3.6
	//5 2.0.3.7
	
	Константы.РазрешитьРезервированиеОтсутствующегоТовара.Установить(Ложь);
	
	// #4645
	ПричинаНетДома = Справочники.ПричиныОтказаЗамера.НайтиПоНаименованию("Нет дома", Истина);
	Если ПричинаНетДома.Пустая() Тогда
		НовыйЭлемент = Справочники.ПричиныОтказаЗамера.СоздатьЭлемент();
		НовыйЭлемент.Наименование = "Нет дома";
