	// + №6293 добавлен новый предопределенный элемент "Общие"	
	Запрос = новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ГруппыДоступаККонтрагентам.Ссылка				  
	               |ИЗ
	               |	Справочник.ГруппыДоступаККонтрагентам КАК ГруппыДоступаККонтрагентам
	               |ГДЕ
	               |	НЕ ГруппыДоступаККонтрагентам.Предопределенный
				   |	И (ГруппыДоступаККонтрагентам.Код = ""000000001""
				   |		ИЛИ ГруппыДоступаККонтрагентам.Код = ""000000002""
				   |		ИЛИ ГруппыДоступаККонтрагентам.Код = ""000000003"")
				   |";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Попытка
			СпрОбъект = Выборка.Ссылка.ПолучитьОбъект();			
			СпрОбъект.УстановитьНовыйКод();			
			СпрОбъект.Записать();
		Исключение
			//
		КонецПопытки;
	КонецЦикла;
	
	// №1842 нужно у существующих документов установки стоимости выработки с видом Выпуск продукции и Вид потолка = Потолок
	// проставить галочки "ОднофактурныйПотолок" и "МногофактурныйПотолок"
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	УстановкаСтоимостиВыработкиПоНоменклатуре.Ссылка,
	|	УстановкаСтоимостиВыработкиПоНоменклатуре.Дата
	|ИЗ
	|	Документ.УстановкаСтоимостиВыработкиПоНоменклатуре КАК УстановкаСтоимостиВыработкиПоНоменклатуре
	|ГДЕ
	|	УстановкаСтоимостиВыработкиПоНоменклатуре.ВидДокументаРасчета = Значение(Справочник.ВидыДокументовРасчетаВыработки.ВыпускПродукции)
	|	И УстановкаСтоимостиВыработкиПоНоменклатуре.ВидНоменклатурыПотолка = Значение(Справочник.ВидыНоменклатуры.Потолок)
	|   И УстановкаСтоимостиВыработкиПоНоменклатуре.Проведен";

	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		ПоместитьВРегистрКОбработке(ВерсияПрограммы, Выборка.Ссылка, Выборка.Дата,, 1);
	КонецЦикла;
	
	// №1842 нужно из справочника ПроизводственныеОперации перенести данные в документ Установка стоимости выработки
	ОбщийМодульСервер.ПереводСправочникаПроизводственныеОперацииВДокумент(ВерсияПрограммы);
	
	//#5263
	Запрос = новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ДанныеСправочника.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Пользователи КАК ДанныеСправочника
	|ГДЕ
	|	ДанныеСправочника.ВидЦенПроизводство = ЗНАЧЕНИЕ(Справочник.ВидыЦен.ПустаяСсылка)
	|	И НЕ ДанныеСправочника.ВидЦен = ЗНАЧЕНИЕ(Справочник.ВидыЦен.ПустаяСсылка)";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл	
			СпрОбъект = Выборка.Ссылка.ПолучитьОбъект();
			СпрОбъект.ВидЦенПроизводство = СпрОбъект.ВидЦен;
		Попытка			
			СпрОбъект.Записать();
		Исключение
		КонецПопытки;
	КонецЦикла;
		
	// #3762
	// распроведение документов "Поступление на расчетный счет" и "Списание с расчетного счета", у которых не стояла галочка "Оплачено".
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТекущийГод", Год(ТекущаяДатаСеанса()));
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ДанныеДокумента.Ссылка КАК Ссылка,
	|	ДанныеДокумента.Дата КАК Дата
	|ИЗ
	|	Документ.ПоступлениеНаРасчетныйСчет КАК ДанныеДокумента
	|ГДЕ
	|	НЕ ДанныеДокумента.УДАЛИТЬ_Оплачено
	|	И ДанныеДокумента.Проведен
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ДанныеДокумента.Ссылка,
	|	ДанныеДокумента.Дата
	|ИЗ
	|	Документ.СписаниеСРасчетногоСчета КАК ДанныеДокумента
	|ГДЕ
	|	(НЕ ДанныеДокумента.УДАЛИТЬ_Оплачено
	|	 И ДанныеДокумента.Проведен)
	|	ИЛИ НАЧАЛОПЕРИОДА(ДанныеДокумента.Дата, ГОД) = &ТекущийГод"; // На основе найденных документов за текущий год создаются документы «Платежные поручения (исходящие)» (для сохранения сквозной нумерации при обмене с банком).

	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		ПоместитьВРегистрКОбработке(ВерсияПрограммы, Выборка.Ссылка, Выборка.Дата,, 1);
	КонецЦикла;
	
	//#6233  в имени файла только имя, в расширении - только расширение, в расширении не должно быть точки.
	ЗапросМенеджер = Новый Запрос;
	ЗапросМенеджер.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	//|	ПрикрепленныеДанные.Период КАК Период,
	//|	ПрикрепленныеДанные.ВидФайлаПрограммыПостроителя КАК ВидФайлаПрограммыПостроителя,
	|	ПрикрепленныеДанные.СсылкаНаОбъект КАК СсылкаНаОбъект
	//,
	//|	ПрикрепленныеДанные.ИмяФайла КАК ИмяФайла,
	//|	ПрикрепленныеДанные.Расширение КАК Расширение
	|ИЗ
	|	РегистрСведений.ПрикрепленныеДанные КАК ПрикрепленныеДанные
	|
	//|УПОРЯДОЧИТЬ ПО
	//|	Период
