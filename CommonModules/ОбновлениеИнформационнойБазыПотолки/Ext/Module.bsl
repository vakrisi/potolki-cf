	ОбъектНастройкаБ24ЗагрузкаЛидов = Справочники.НастройкиСинхронизацииСБитрикс24.Основная.ПолучитьОбъект();
	ХранилищеНастроек = ОбъектНастройкаБ24ЗагрузкаЛидов.ХранилищеНастроек.Получить();
	
	Если ТипЗнч(ХранилищеНастроек) = Тип("Структура") И ХранилищеНастроек.Свойство("НастройкиСинхронизацииЛидов") Тогда
		
		НастройкиСинхронизацииЛидов = ХранилищеНастроек.НастройкиСинхронизацииЛидов;
			
		Если НастройкиСинхронизацииЛидов.Свойство("ИнформацияОСтатусах") И НастройкиСинхронизацииЛидов.ИнформацияОСтатусах.Свойство("СтатусыСписок") Тогда
			
			СтатусыСписок = НастройкиСинхронизацииЛидов.ИнформацияОСтатусах.СтатусыСписок;
			
			Если НЕ СтатусыСписок.Колонки.Найти("НеЗагружать") = Неопределено Тогда
			
				// Сначала просто инвертируем значение
				Для Каждого ТекущийСтатус Из СтатусыСписок Цикл
					ТекущийСтатус.НеЗагружать = НЕ ТекущийСтатус.НеЗагружать;
				КонецЦикла;
				
				// Переименуем колонку
				СтатусыСписок.Колонки.Найти("НеЗагружать").Заголовок = "Загружать";
				СтатусыСписок.Колонки.Найти("НеЗагружать").Имя = "Загружать";
				
				ОбъектНастройкаБ24ЗагрузкаЛидов.ХранилищеНастроек = Новый ХранилищеЗначения(ХранилищеНастроек);
				ОбъектНастройкаБ24ЗагрузкаЛидов.Записать();
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	//-- №10263
	
КонецПроцедуры

