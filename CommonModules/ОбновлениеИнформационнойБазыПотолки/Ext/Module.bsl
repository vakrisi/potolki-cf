// на базе процедуры  ДатыЗапретаИзмененияСлужебный.ОчиститьПредопределенныеЭлементыРазделовДатЗапрета
// при обновлении почему-то не отработало заполнение поля "УдалитьНоваяСсылка"
Процедура ОчиститьПредопределенныеЭлементыРазделовДатЗапрета() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ИСТИНА КАК ЗначениеИстина
	|ИЗ
	|	ПланВидовХарактеристик.РазделыДатЗапретаИзменения КАК Разделы
	|ГДЕ
	//|	Разделы.ИмяПредопределенныхДанных <> """"";
	|	Разделы.ПометкаУдаления <> Ложь";
	
	Если Запрос.Выполнить().Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	СвойстваРазделов = ДатыЗапретаИзмененияСлужебный.СвойстваРазделов();
	ИменаПредопределенных =
		Метаданные.ПланыВидовХарактеристик.РазделыДатЗапретаИзменения.ПолучитьИменаПредопределенных();
	
	Блокировка = Новый БлокировкаДанных;
	Блокировка.Добавить("ПланВидовХарактеристик.РазделыДатЗапретаИзменения");
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Разделы.Ссылка КАК Ссылка,
	|	Разделы.ИмяПредопределенныхДанных КАК ИмяПредопределенныхДанных
	|ИЗ
	|	ПланВидовХарактеристик.РазделыДатЗапретаИзменения КАК Разделы
	|ГДЕ
	//|	Разделы.ИмяПредопределенныхДанных <> """"";
	|	Разделы.ПометкаУдаления <> Ложь";
	
	НачатьТранзакцию();
	Попытка
		Блокировка.Заблокировать();
		//ОбновитьРазделыДатЗапретаИзменения();
		
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			ПВХОбъект = Выборка.Ссылка.ПолучитьОбъект();
			//Если ИменаПредопределенных.Найти(Выборка.ИмяПредопределенныхДанных) <> Неопределено Тогда
			//	Приставка = "Удалить";
			//	Если Не СтрНачинаетсяС(Выборка.ИмяПредопределенныхДанных, Приставка) Тогда
			//		Объект.ПометкаУдаления = Истина;
			//	Иначе
					ИскомоеИмя = СтрЗаменить(Строка(Выборка.Ссылка), " ", "");
					ИскомоеИмя = СтрЗаменить(ИскомоеИмя, "-", "");
					МД = Метаданные.Документы.Найти(ИскомоеИмя);
					Если МД = Неопределено ТОгда
						//Сообщить("Не найден МД: " + ИскомоеИмя);
					Иначе					
						СвойстваРаздела = СвойстваРазделов.Разделы.Получить(МД.Имя); 
					
						Если СвойстваРаздела = Неопределено Тогда
				        	//Сообщить("Не найден раздел: " + МД.Имя);
							//Объект.ПометкаУдаления = Истина;
						
						ИначеЕсли Выборка.Ссылка <> СвойстваРаздела.Ссылка Тогда
							ПВХОбъект.УдалитьНоваяСсылка = СвойстваРаздела.Ссылка;
							ПВХОбъект.Наименование = "(" + НСтр("ru = 'не используется'") + ") " + СвойстваРаздела.Представление;
						КонецЕсли;
					КонецЕсли;
			//ИначеЕсли СвойстваРазделов.Разделы.Получить(Выборка.Ссылка) = Неопределено Тогда
			//	Объект.ПометкаУдаления = Истина;
			//КонецЕсли;
			//Объект.ИмяПредопределенныхДанных = "";
			ОбновлениеИнформационнойБазы.ЗаписатьДанные(ПВХОбъект, Ложь);
		КонецЦикла;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

#КонецОбласти

