Процедура ОбработатьРеквизитыПорядокОкругления() Экспорт
	
	// константы
	Если ЗначениеЗаполнено(Константы.УДАЛИТЬ_ПорядокОкругленияСтоимостиПотолков.Получить()) Тогда			
		Порядок = Число(Строка(Константы.УДАЛИТЬ_ПорядокОкругленияСтоимостиПотолков.Получить()));				
		Константы.ПорядокОкругленияЧисломСтоимостиПотолков.Установить(Порядок);
	КонецЕсли;	
	Если ЗначениеЗаполнено(Константы.УДАЛИТЬ_ПорядокОкругленияСтоимостиПотолковРозница.Получить()) Тогда			
		Порядок = Число(Строка(Константы.УДАЛИТЬ_ПорядокОкругленияСтоимостиПотолковРозница.Получить()));				
		Константы.ПорядокОкругленияЧисломСтоимостиПотолковРозница.Установить(Порядок);
	КонецЕсли;
	
	//переделаем расширенные правила загрузки из построителя
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ДанныеРегистра.ПараметрФайла КАК ПараметрФайла,
	|	ДанныеРегистра.Номенклатура КАК Номенклатура,
	|	ДанныеРегистра.ВидЗаказа КАК ВидЗаказа,
	|	ДанныеРегистра.ТабличнаяЧастьЗаказа КАК ТабличнаяЧастьЗаказа,
	|	ДанныеРегистра.ПараметрФайлаДляОбработкиЗначения КАК ПараметрФайлаДляОбработкиЗначения,
	|	ДанныеРегистра.ЗначениеПараметраДляОбработки КАК ЗначениеПараметраДляОбработки,
	|	ДанныеРегистра.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	ДанныеРегистра.ЭтоПравилоБезПараметра КАК ЭтоПравилоБезПараметра
	|ИЗ
	|	РегистрСведений.ПравилаОбработкиФайлаПрограммыПостроителя КАК ДанныеРегистра
	|ГДЕ
	|	ДанныеРегистра.УДАЛИТЬ_ПорядокОкругления <> ЗНАЧЕНИЕ(Перечисление.ПорядкиОкругления.ПустаяСсылка)";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		НаборЗаписей = РегистрыСведений.ПравилаОбработкиФайлаПрограммыПостроителя.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.ПараметрФайла.Установить(Выборка.ПараметрФайла);
		НаборЗаписей.Отбор.Номенклатура.Установить(Выборка.Номенклатура);
		НаборЗаписей.Отбор.ВидЗаказа.Установить(Выборка.ВидЗаказа);
		НаборЗаписей.Отбор.ТабличнаяЧастьЗаказа.Установить(Выборка.ТабличнаяЧастьЗаказа);
		НаборЗаписей.Отбор.ПараметрФайлаДляОбработкиЗначения.Установить(Выборка.ПараметрФайлаДляОбработкиЗначения);
		НаборЗаписей.Отбор.ЗначениеПараметраДляОбработки.Установить(Выборка.ЗначениеПараметраДляОбработки);
		НаборЗаписей.Отбор.ЕдиницаИзмерения.Установить(Выборка.ЕдиницаИзмерения);
		НаборЗаписей.Отбор.ЭтоПравилоБезПараметра.Установить(Выборка.ЭтоПравилоБезПараметра);
		НаборЗаписей.Прочитать();
		
		Для каждого Запись из НаборЗаписей Цикл		
			Если ЗначениеЗаполнено(Запись.УДАЛИТЬ_ПорядокОкругления) Тогда			
				Порядок = Число(Строка(Запись.УДАЛИТЬ_ПорядокОкругления));				
				Запись.ПорядокОкругленияЧислом = Порядок;
			КонецЕсли;
		КонецЦикла;
		
		НаборЗаписей.Записать();
		
	КонецЦикла;
	
	// спецификации
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ДанныеСправочника.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Спецификации.Состав КАК ДанныеСправочника
	|ГДЕ
	|	ДанныеСправочника.УДАЛИТЬ_ПорядокОкругления <> ЗНАЧЕНИЕ(Перечисление.ПорядкиОкругления.ПустаяСсылка)";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		СпрОбъект = Выборка.Ссылка.ПолучитьОбъект();
		Для каждого СтрокаТЧ из СпрОбъект.Состав Цикл		
			Если ЗначениеЗаполнено(СтрокаТЧ.УДАЛИТЬ_ПорядокОкругления) Тогда			
				Порядок = Число(Строка(СтрокаТЧ.УДАЛИТЬ_ПорядокОкругления));				
				СтрокаТЧ.ПорядокОкругленияЧислом = Порядок;
			КонецЕсли;
		КонецЦикла;
		
		Попытка
			СпрОбъект.Записать();
		Исключение
			Сообщить(ОписаниеОшибки());
		КонецПопытки;
		
	КонецЦикла;
	
