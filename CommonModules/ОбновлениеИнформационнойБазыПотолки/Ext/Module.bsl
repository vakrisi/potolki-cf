Процедура ОбработкаОбновления_2_8_35_0() Экспорт

	ВерсияПрограммы = "2.8.35.0";
		
КонецПроцедуры

#КонецОбласти

#Область Обновление_2_8_36_0

Процедура ОбработкаОбновления_2_8_36_0() Экспорт

	ВерсияПрограммы = "2.8.36.0";
	
	// #13763 заполнение новых измерений и ресурсов
	// #14216 при обновлении не включены изменения ОбработкаПроведения, поэтому повторно в очередь с номром версии "2.8.31.0", для нее есть обработчик
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ДанныеРегистра.Регистратор КАК Ссылка,
	|	ДанныеРегистра.Регистратор.Дата КАК Дата
	|ИЗ
	|	РегистрНакопления.РасходМатериаловНаПроизводстве КАК ДанныеРегистра
	|ГДЕ
	|	(ДанныеРегистра.КоличествоВБазовыхЕдиницах = 0
	|			ИЛИ ДанныеРегистра.Организация = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка))";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл		
		ПоместитьВРегистрКОбработке("2.8.31.0", Выборка.Ссылка, Выборка.Дата);
	КонецЦикла;
	
	// в БонусыКонтрагентов добавлен реквизит "КатегорияКонтрагента" 
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ДанныеРегистра.Регистратор КАК Ссылка,
	|	ДанныеРегистра.Регистратор.Дата КАК Дата
	|ИЗ
	|	РегистрНакопления.БонусыКонтрагентов КАК ДанныеРегистра
	|ГДЕ
	|	НЕ ДанныеРегистра.ДокументНАНБ = ЗНАЧЕНИЕ(Документ.НастройкаАвтоматическихНачисленийБонусов.ПустаяСсылка)
	|";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл		
		ПоместитьВРегистрКОбработке(ВерсияПрограммы, Выборка.Ссылка, Выборка.Дата);
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область Обновление_2_8_37_0

Процедура ОбработкаОбновления_2_8_37_0() Экспорт

	ВерсияПрограммы = "2.8.37.0";
	
	//версия "2.8.31.0" - был баг с помещением объектов к обработке: именно у тех, у кого устанавливалась эта версия. с 2.8.32 было исправлено
	МенеджерЗаписи = РегистрыСведений.ИсторияВерсий.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Версия = "2.8.31.0";
	МенеджерЗаписи.Прочитать();
	Если МенеджерЗаписи.Выбран() Тогда
		ОбработкаОбновления_2_8_31_0();
	КонецЕсли;
	
	// №14262 в документе "Состав производственной смены" появился реквизит "Организация"
	Документы.СоставПроизводственнойСмены.ЗаполнитьНовоеПолеОрганизация(ВерсияПрограммы);
	
	// нужно очистить измерение "Документ" 
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	ВзаиморасчетыСКонтрагентами.Регистратор КАК Ссылка,
	|	ВзаиморасчетыСКонтрагентами.Период КАК Дата
	|ИЗ
	|	РегистрНакопления.ВзаиморасчетыСКонтрагентами КАК ВзаиморасчетыСКонтрагентами
	|";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ПоместитьВРегистрКОбработке(ВерсияПрограммы, Выборка.Ссылка, Выборка.Дата);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти
	
#Область Обновление_3_0_0_0

Процедура ОбработкаОбновления_3_0_0_0() Экспорт
	
	ВерсияПрограммы = "3.0.0.0";
	
	//++ №13851 Слияние нумераторов расчета в один регистр
	// 1. В регистре "НомераРасчетов" удалены измерения "НомерРасчета", "НомерМесяца", "НомерГода", которые были строковым
	// вместо них добавлены числовые измерения "НомерЧислом", "Месяц" и "Год" (по аналогии с регистром "Номера конструкций") + добавлен признак вида номенклатуры
	// поэтому сначала перенесем из строки в число, потом по номеру расчета попытаемся найти номенклатуру для определения её вида
	Запрос = новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ЕСТЬNULL(НомераРасчетов.УДАЛИТЬ_НомерМесяца,0) КАК УДАЛИТЬ_НомерМесяца,
	|	ЕСТЬNULL(НомераРасчетов.УДАЛИТЬ_НомерГода,0) КАК УДАЛИТЬ_НомерГода,
	|	ЕСТЬNULL(НомераРасчетов.УДАЛИТЬ_НомерРасчета,0) КАК УДАЛИТЬ_НомерРасчета,
	|	НомераРасчетов.Дата КАК Дата,
	|	НомераРасчетов.Ответственный КАК Ответственный,
	|	Номенклатура.Ссылка КАК Номенклатура,
	|	Номенклатура.Потолок_НомерРасчета КАК Потолок_НомерРасчета,
	|	ЕСТЬNULL(Номенклатура.ВидНоменклатуры, Значение(Справочник.ВидыНоменклатуры.ПустаяСсылка)) КАК ВидНоменклатуры
	|ИЗ
	|	РегистрСведений.НомераРасчетов КАК НомераРасчетов
	|		
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Номенклатура
	|		ПО ((ВЫРАЗИТЬ(НомераРасчетов.УДАЛИТЬ_НомерМесяца + НомераРасчетов.УДАЛИТЬ_НомерГода + ""-"" + НомераРасчетов.УДАЛИТЬ_НомерРасчета КАК СТРОКА(30))) = Номенклатура.Потолок_НомерРасчета)
	|			И (Номенклатура.ВидНоменклатуры = Значение(Справочник.ВидыНоменклатуры.Потолок) Или Номенклатура.ВидНоменклатуры = Значение(Справочник.ВидыНоменклатуры.Отрез))
	|";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Попытка
			
			НаборЗаписей = РегистрыСведений.НомераРасчетов.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.УДАЛИТЬ_НомерМесяца.Установить(Выборка.УДАЛИТЬ_НомерМесяца);
			НаборЗаписей.Отбор.УДАЛИТЬ_НомерГода.Установить(Выборка.УДАЛИТЬ_НомерГода);
			НаборЗаписей.Отбор.УДАЛИТЬ_НомерРасчета.Установить(Выборка.УДАЛИТЬ_НомерРасчета);
			
			НаборЗаписей.Прочитать();
			
			Для Каждого Запись Из НаборЗаписей Цикл
				
				Запись.Месяц = Число(Запись.УДАЛИТЬ_НомерМесяца);
				Запись.Год = 2000 + Число(Запись.УДАЛИТЬ_НомерГода);
				Запись.НомерЧислом = Число(Запись.УДАЛИТЬ_НомерРасчета);
				Запись.ВидНоменклатуры = Выборка.ВидНоменклатуры;
				
			КонецЦикла;
			
			НаборЗаписей.Записать();
			
		Исключение
			ЗаписьЖурналаРегистрации("ОбработкаОбновления_3_0_0_0", УровеньЖурналаРегистрации.Ошибка, РегистрыСведений.НомераРасчетов,,
			"Ошибка преобразования номера расчета в число." 
			+ Символы.ПС + "Месяц = " + Выборка.УДАЛИТЬ_НомерМесяца
			+ Символы.ПС + "Год = " + Выборка.УДАЛИТЬ_НомерГода
			+ Символы.ПС + "НомерЧислом = " + Выборка.УДАЛИТЬ_НомерРасчета
			+ Символы.ПС + "ВидНоменклатуры = " + Выборка.ВидНоменклатуры
			+ Символы.ПС + ОписаниеОшибки());
		КонецПопытки;
		
		
	КонецЦикла;
	
	// 2. Переносим данные из регистра "Номера конструкций" в "Номера расчетов"
	Запрос = новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	НомераКонструкций.Месяц КАК Месяц,
	|	НомераКонструкций.Год КАК Год,
	|	НомераКонструкций.НомерЧислом КАК НомерЧислом,
	|	НомераКонструкций.Дата КАК Дата,
	|	НомераКонструкций.Ответственный КАК Ответственный,
	|	Значение(Справочник.ВидыНоменклатуры.Продукция) КАК ВидНоменклатуры
	|ИЗ
	|	РегистрСведений.УДАЛИТЬ_НомераКонструкций КАК НомераКонструкций";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		МенеджерЗаписи = РегистрыСведений.НомераРасчетов.СоздатьМенеджерЗаписи();
		ЗаполнитьЗначенияСвойств(МенеджерЗаписи, Выборка);
		
		МенеджерЗаписи.Записать();
		
	КонецЦикла;
	
	// 3. Помещаем дубли номенклатур по номерам расчетов (исключая типовые отрезы) для ручного исправления
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Номенклатура.Потолок_НомерРасчета КАК НомерРасчета,
	|	Номенклатура.Потолок_ИндексПотолка КАК ИндексПотолка,
	|	СУММА(1) КАК Количество
	|ПОМЕСТИТЬ ВТ_ДублиНомеров
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	(НЕ Номенклатура.Потолок_НомерРасчета = """" Или НЕ Номенклатура.Потолок_ИндексПотолка = """")
	|	И НЕ Номенклатура.ВидНоменклатуры = Значение(Справочник.ВидыНоменклатуры.ТиповойОтрез)
	|	
	|СГРУППИРОВАТЬ ПО
	|	Номенклатура.Потолок_НомерРасчета,
	|	Номенклатура.Потолок_ИндексПотолка
	|ИМЕЮЩИЕ
	|	СУММА(1) > 1
	|	
	|;
	|////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Номенклатура.Ссылка КАК Ссылка,
	|	Номенклатура.Потолок_НомерРасчета КАК НомерРасчета,
	|	Номенклатура.Потолок_ИндексПотолка КАК ИндексПотолка,
	|	ДублиНомеров.Количество КАК КоличествоНоменклатур
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ДублиНомеров КАК ДублиНомеров
	|		ПО Номенклатура.Потолок_НомерРасчета = ДублиНомеров.НомерРасчета
	|			И Номенклатура.Потолок_ИндексПотолка = ДублиНомеров.ИндексПотолка
	|";
	
	РезультатЗапроса = Запрос.Выполнить();	
	Выборка = РезультатЗапроса.Выбрать();	
	
	Пока Выборка.Следующий() Цикл
		
		ОписаниеОшибки = СтрШаблон("В справочнике ""Номенклатура"" имеется %1 карточки с одинаковым номером расчета %2%3",
			Выборка.КоличествоНоменклатур,
			Выборка.НомерРасчета,
			?(ЗначениеЗаполнено(Выборка.ИндексПотолка), " и индексом " + Выборка.ИндексПотолка, "")
		);
		
		ПоместитьВРегистрКОбработке(ВерсияПрограммы, Выборка.Ссылка, ТекущаяДатаСеанса(), ОписаниеОшибки);
		
	КонецЦикла;
	//-- №13851
	
	//++ №13930 в документе "Ввод остатков" для операций "Товары на складах" и "Материалы в эксплуатации" добавлена колонка "Цена"
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВводОстатков.Ссылка КАК Ссылка,
	|	ВводОстатков.Дата КАК Дата
	|ИЗ
	|	Документ.ВводОстатков КАК ВводОстатков
	|ГДЕ
	|	ВводОстатков.ТипОперации В (Значение(Перечисление.ТипыОперацийВводаОстатков.ТоварыНаСкладах), Значение(Перечисление.ТипыОперацийВводаОстатков.МатериалыВЭксплуатации))
	|";
	
	РезультатЗапроса = Запрос.Выполнить();	
	Выборка = РезультатЗапроса.Выбрать();	
	Пока Выборка.Следующий() Цикл
		ПоместитьВРегистрОбязательныеКОбработке(ВерсияПрограммы, Выборка.Ссылка, Выборка.Дата);
	КонецЦикла;
	//-- №13930
	
	//++ #13943 для заполнения нового реквизита Менеджер
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ДанныеДокумента.Ссылка КАК Ссылка,
	|	ДанныеДокумента.Дата КАК Дата
	|ИЗ
	|	Документ.Лид КАК ДанныеДокумента
	|ГДЕ
	|	ДанныеДокумента.Менеджер = ЗНАЧЕНИЕ(Справочник.Сотрудники.ПустаяСсылка)
	|	И НЕ ДанныеДокумента.Автор = ЗНАЧЕНИЕ(Справочник.Пользователи.ПустаяСсылка)";
	
	РезультатЗапроса = Запрос.Выполнить();	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		ПоместитьВРегистрКОбработке(ВерсияПрограммы, Выборка.Ссылка, Выборка.Дата);
	КонецЦикла;
	
	//#13943
	Константы.СпособЗаполненияМенеджераВЛиде.Установить(Перечисления.ВариантыЗаполненияМенеджера.ЗаполнятьСотрудникомПользователя);
	Константы.СпособЗаполненияМенеджераВЗаказДоговоре.Установить(Перечисления.ВариантыЗаполненияМенеджера.ЗаполнятьСотрудникомПользователя);
	Константы.СпособЗаполненияМенеджераВЗаказеПокупателя.Установить(Перечисления.ВариантыЗаполненияМенеджера.ЗаполнятьСотрудникомПользователя);
	Константы.СпособЗаполненияМенеджераВРеализации.Установить(Перечисления.ВариантыЗаполненияМенеджера.ЗаполнятьМенеджеромДокументаОснования);
	
	//++ #13943 для заполнения нового реквизита ОтветственныйМенеджер
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ДанныеСправочника.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.УчетныеЗаписиЭлектроннойПочты КАК ДанныеСправочника
	|ГДЕ
	|	ДанныеСправочника.УДАЛИТЬ_ОтветственныйМенеджер = ЗНАЧЕНИЕ(Справочник.Сотрудники.ПустаяСсылка)
	|	И НЕ ДанныеСправочника.УДАЛИТЬ_ОтветственныйПользователь = ЗНАЧЕНИЕ(Справочник.Пользователи.ПустаяСсылка)";
	
	РезультатЗапроса = Запрос.Выполнить();	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		ПоместитьВРегистрОбязательныеКОбработке(ВерсияПрограммы, Выборка.Ссылка, ТекущаяДатаСеанса());
	КонецЦикла;
	
	// №13942 пока УБРАНО заполнение при обновлении
	// в РС Замеры добавлено измерение "НазначилЗамерПользователь"
	//Запрос = новый Запрос;
	//Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	//|	Замеры.ДокументЗамер КАК Ссылка,
	//|	Замеры.ДокументЗамер.Дата КАК Дата
	//|ИЗ
	//|	РегистрСведений.Замеры КАК Замеры
	//|ГДЕ
	//|	Замеры.ДокументЗамер ССЫЛКА Документ.Лид
	//|	И НЕ Замеры.НазначилЗамер = Значение(Справочник.Сотрудники.ПустаяСсылка)
	//|";
	//
	//РезультатЗапроса = Запрос.Выполнить();	
	//Выборка = РезультатЗапроса.Выбрать();	
	//
	//Пока Выборка.Следующий() Цикл
	//	ПоместитьВРегистрКОбработке(ВерсияПрограммы, Выборка.Ссылка, Выборка.Дата,, 100);
	//КонецЦикла;
	
	// №14311 на каждую организацию, у которой есть хотя бы один документ ЗП, ЗНП или Выпуск продукции создается новый документ "Настройка контроля материалов в производстве"
	Документы.НастройкаКонтроляМатериаловВПроизводстве.СоздатьНовыеДокументы();
	
	// В документах "Начисление и списание бонусов" если у всех записей указана дисконтная карта
	// и снят флаг "(служебный) Учет бонусов по дисконтным картам" - нужно его установить
	Запрос = новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	НачислениеБонусовКонтрагентамБонусы.Ссылка КАК Ссылка,
