#Область Обновление_3_0_2_0

Процедура ОбработкаОбновления_3_0_2_0() Экспорт
	
	ВерсияПрограммы = "3.0.2.0";
	
	// №14604 при копировании номенклатуры, реквизиты "ОсновнаяСпецификацияКомплектация" и "ОсновнаяСпецификацияСопутствующиеМатериалы" не очищались
	Запрос = новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	Номенклатура.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	(НЕ Номенклатура.ОсновнаяСпецификацияКомплектация = Значение(Справочник.Спецификации.ПустаяСсылка)
	|		ИЛИ НЕ Номенклатура.ОсновнаяСпецификацияСопутствующиеМатериалы = Значение(Справочник.Спецификации.ПустаяСсылка))
	|	И (НЕ Номенклатура.ОсновнаяСпецификацияКомплектация.Владелец = Номенклатура.Ссылка
	|		ИЛИ НЕ Номенклатура.ОсновнаяСпецификацияСопутствующиеМатериалы.Владелец = Номенклатура.Ссылка)
	|";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		НоменклатураОбъект = Выборка.Ссылка.ПолучитьОбъект();
		
		Если ЗначениеЗаполнено(НоменклатураОбъект.ОсновнаяСпецификацияКомплектация) И НЕ НоменклатураОбъект.ОсновнаяСпецификацияКомплектация.Владелец = НоменклатураОбъект.Ссылка Тогда
			НоменклатураОбъект.ОсновнаяСпецификацияКомплектация = Справочники.Спецификации.ПустаяСсылка();
		КонецЕсли;
		
		Если ЗначениеЗаполнено(НоменклатураОбъект.ОсновнаяСпецификацияСопутствующиеМатериалы) И НЕ НоменклатураОбъект.ОсновнаяСпецификацияСопутствующиеМатериалы.Владелец = НоменклатураОбъект.Ссылка Тогда
			НоменклатураОбъект.ОсновнаяСпецификацияСопутствующиеМатериалы = Справочники.Спецификации.ПустаяСсылка();
		КонецЕсли;
		
		НоменклатураОбъект.ОбменДанными.Загрузка = Истина;
		
		НоменклатураОбъект.Записать();
		
	КонецЦикла;
	
	// №14608 создаём группы в справочнике "Виды файлов программы построителя" и раскидываем предопределенные элементы по группам
	Справочники.ВидыФайловПрограммыПостроителя.РазместитьПреопределенныеЭлементыПоГруппам();
			
КонецПроцедуры

#КонецОбласти

#Область Обновление_3_0_3_0

Процедура ОбработкаОбновления_3_0_3_0() Экспорт
	
	ВерсияПрограммы = "3.0.3.0";
	
	//#14642
	Константы.СрокАктуальностиСМСВДнях.Установить(3);
	
	// №14649 у всех выездов лида:
	// а) у которых стоит галочка "ЗамерВыполнен" поставить результат = РезультатыВыездаЛида.ВыездВыполнен
	// б) заполнить новый реквизит дата назначения
	Запрос = новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	ЛидВыезды.Ссылка КАК Ссылка,
	|	ЛидВыезды.Ссылка.Дата КАК Дата
	|ИЗ
	|	Документ.Лид.Выезды КАК ЛидВыезды";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл		
		ПоместитьВРегистрКОбработке(ВерсияПрограммы, Выборка.Ссылка, Выборка.Дата);		
	КонецЦикла;
	
	// №14649
	Константы.ВариантИзмененияОтветственногоВЛиде.Установить(Перечисления.ВариантыИзмененияОтветственногоВЛиде.НеЗаполнять);
			
КонецПроцедуры

