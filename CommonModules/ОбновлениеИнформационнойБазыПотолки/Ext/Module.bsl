		КонецЦикла;
		
		ДокументОбъект.Записать();
		
	КонецЦикла;
	
	//#14544
	Если НЕ Константы.ОтражатьДвиженияПоРасчетуСПерсоналомПоПериодуРегистрации.Получить() Тогда
