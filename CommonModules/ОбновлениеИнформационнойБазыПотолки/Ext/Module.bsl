#Область Обновление_0_8_1_0

Процедура ОбработкаОбновления_0_8_1_0() Экспорт
	
	//поступление на расчетный счет
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПоступлениеНаРасчетныйСчет.Ссылка,
	|	ПоступлениеНаРасчетныйСчет.Проведен
	|ИЗ
	|	Документ.ПоступлениеНаРасчетныйСчет КАК ПоступлениеНаРасчетныйСчет";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ДокументОбъект = Выборка.ССылка.ПолучитьОбъект();
		ДокументОбъект.РаспределениеПлатежа.Очистить();
		Если НЕ ДокументОбъект.УДАЛИТЬЗаказДоговор = Неопределено Тогда
			Если НЕ ДокументОбъект.УДАЛИТЬЗаказДоговор.Пустая() Тогда
				НоваяСтрока = ДокументОбъект.РаспределениеПлатежа.Добавить();
				НоваяСтрока.Документ = ДокументОбъект.УДАЛИТЬЗаказДоговор;
				НоваяСтрока.Сумма = ДокументОбъект.Сумма;
			КонецЕсли;
		КонецЕсли;
		Если НЕ ДокументОбъект.УДАЛИТЬСчетНаОплату = Неопределено Тогда
			Если НЕ ДокументОбъект.УДАЛИТЬСчетНаОплату.Пустая() Тогда
				НоваяСтрока = ДокументОбъект.РаспределениеПлатежа.Добавить();
				НоваяСтрока.Документ = ДокументОбъект.УДАЛИТЬСчетНаОплату;
				НоваяСтрока.Сумма = ДокументОбъект.Сумма;
			КонецЕсли;
		КонецЕсли;
		Для Каждого ТекущаяСтрока Из ДокументОбъект.УДАЛИТЬЗаказыНаПроизводство Цикл
			НоваяСтрока = ДокументОбъект.РаспределениеПлатежа.Добавить();
			НоваяСтрока.Документ = ТекущаяСтрока.Документ;
			НоваяСтрока.Сумма = ТекущаяСтрока.Сумма;
		КонецЦикла;
		ДокументОбъект.РаспределениеПлатежа.Свернуть("Документ,Сумма");
		
		Если Выборка.Проведен Тогда
			ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
		Иначе
			ДокументОбъект.Записать();
		КонецЕсли;
	КонецЦикла;
	
	//оплата наличными
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПриходныйКассовыйОрдер.Ссылка,
	|	ПриходныйКассовыйОрдер.Проведен
	|ИЗ
	|	Документ.ПриходныйКассовыйОрдер КАК ПриходныйКассовыйОрдер";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ДокументОбъект = Выборка.ССылка.ПолучитьОбъект();
		ДокументОбъект.РаспределениеПлатежа.Очистить();
		Если НЕ ДокументОбъект.УДАЛИТЬЗаказДоговор = Неопределено Тогда
			Если НЕ ДокументОбъект.УДАЛИТЬЗаказДоговор.Пустая() Тогда
				НоваяСтрока = ДокументОбъект.РаспределениеПлатежа.Добавить();
				НоваяСтрока.Документ = ДокументОбъект.УДАЛИТЬЗаказДоговор;
				НоваяСтрока.Сумма = ДокументОбъект.Сумма;
				Если НЕ ДокументОбъект.УДАЛИТЬДатаПлатежаПоРассрочке = Дата(1,1,1) Тогда
					НоваяСтрока.ДатаПлатежаПоРассрочке = ДокументОбъект.УДАЛИТЬДатаПлатежаПоРассрочке;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		Если НЕ ДокументОбъект.УДАЛИТЬСчетНаОплату = Неопределено Тогда
			Если НЕ ДокументОбъект.УДАЛИТЬСчетНаОплату.Пустая() Тогда
				НоваяСтрока = ДокументОбъект.РаспределениеПлатежа.Добавить();
				НоваяСтрока.Документ = ДокументОбъект.УДАЛИТЬСчетНаОплату;
				НоваяСтрока.Сумма = ДокументОбъект.Сумма;
			КонецЕсли;
		КонецЕсли;
		Если НЕ ДокументОбъект.Основание = Неопределено Тогда
			Если НЕ ДокументОбъект.Основание.Пустая() Тогда
				НоваяСтрока = ДокументОбъект.РаспределениеПлатежа.Добавить();
				НоваяСтрока.Документ = ДокументОбъект.Основание;
				НоваяСтрока.Сумма = ДокументОбъект.Сумма;
			КонецЕсли;
		КонецЕсли;
		ДокументОбъект.РаспределениеПлатежа.Свернуть("Документ,Сумма,ДатаПлатежаПоРассрочке");
		
		
		Если Выборка.Проведен Тогда
			ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
		Иначе
			ДокументОбъект.Записать();
		КонецЕсли;
	КонецЦикла;

	
	//оплата банковской картой
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ОплатаБанковскойКартой.Ссылка,
	|	ОплатаБанковскойКартой.Проведен
	|ИЗ
	|	Документ.ОплатаБанковскойКартой КАК ОплатаБанковскойКартой";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ДокументОбъект = Выборка.ССылка.ПолучитьОбъект();
		ДокументОбъект.РаспределениеПлатежа.Очистить();
		Если ТипЗнч(ДокументОбъект.Договор) = Тип("ДокументСсылка.ЗаказДоговор") Тогда
			Если НЕ ДокументОбъект.Договор.Пустая() Тогда
				НоваяСтрока = ДокументОбъект.РаспределениеПлатежа.Добавить();
				НоваяСтрока.Документ = ДокументОбъект.Договор;
				НоваяСтрока.Сумма = ДокументОбъект.Сумма;
				Если НЕ ДокументОбъект.УДАЛИТЬДатаПлатежаПоРассрочке = Дата(1,1,1) Тогда
					НоваяСтрока.ДатаПлатежаПоРассрочке = ДокументОбъект.УДАЛИТЬДатаПлатежаПоРассрочке;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		Если НЕ ДокументОбъект.УДАЛИТЬСчетНаОплату = Неопределено Тогда
			Если НЕ ДокументОбъект.УДАЛИТЬСчетНаОплату.Пустая() Тогда
				НоваяСтрока = ДокументОбъект.РаспределениеПлатежа.Добавить();
				НоваяСтрока.Документ = ДокументОбъект.УДАЛИТЬСчетНаОплату;
				НоваяСтрока.Сумма = ДокументОбъект.Сумма;
			КонецЕсли;
		КонецЕсли;
		Если НЕ ДокументОбъект.Основание = Неопределено Тогда
			Если НЕ ДокументОбъект.Основание.Пустая() Тогда
				НоваяСтрока = ДокументОбъект.РаспределениеПлатежа.Добавить();
				НоваяСтрока.Документ = ДокументОбъект.Основание;
				НоваяСтрока.Сумма = ДокументОбъект.Сумма;
			КонецЕсли;
		КонецЕсли;
		ДокументОбъект.РаспределениеПлатежа.Свернуть("Документ,Сумма,ДатаПлатежаПоРассрочке");
		
		
		Если Выборка.Проведен Тогда
			ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
		Иначе
			ДокументОбъект.Записать();
		КонецЕсли;
	КонецЦикла;
			
КонецПроцедуры

