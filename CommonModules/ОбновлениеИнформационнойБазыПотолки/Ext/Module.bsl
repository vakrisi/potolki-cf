	|	И ДанныеДокумента.Номенклатура В (ЗНАЧЕНИЕ(Справочник.Номенклатура.ОстаткиПленки), ЗНАЧЕНИЕ(Справочник.Номенклатура.ПолотноЗаказчика))";

	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		ПоместитьВРегистрКОбработке(ВерсияПрограммы, Выборка.Ссылка, Выборка.Дата);
	КонецЦикла;
	
	// №5793
	НаборЗаписей = РегистрыСведений.ПравилаОбработкиФайлаПрограммыПостроителя.СоздатьНаборЗаписей();
