	Запрос.УстановитьПараметр("УДАЛИТЬ_Фактура",Справочники.Фактура.ПустаяСсылка());
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		ДокОбъект = Выборка.Ссылка.ПолучитьОбъект();
		
		ТаблицаФактур = Новый ТаблицаЗначений;
		ТаблицаФактур = ДокОбъект.Потолок_Фактура.Выгрузить();
		
		ДокОбъект.Потолок_Фактура.Очистить();
		
		НоваяСтрока = ДокОбъект.Потолок_Фактура.Добавить();
		НоваяСтрока.Основная = Истина;
		НоваяСтрока.ПродукцияФактура = ДокОбъект.УДАЛИТЬ_Фактура;
		НоваяСтрока.ПродукцияЦвет = ДокОбъект.УДАЛИТЬ_ЦветФактуры;
		НоваяСтрока.ПродукцияКоличество = ДокОбъект.Потолок_КоличествоРасход;
		
		Для Каждого ТекущаяСтрока Из ТаблицаФактур Цикл
