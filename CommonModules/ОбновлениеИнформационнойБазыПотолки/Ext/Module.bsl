Процедура ОбработкаОбновления_1_0_5_0() Экспорт
	
	ВерсияПрограммы = "1.0.5.0";
	
	// отбор документов для заполнения нового реквизита "ЗаказНаПроизводство" в ТЧ заказ-договора
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЗаказДоговорТоварыУслуги.Ссылка КАК Ссылка,
		|	ЗаказДоговорТоварыУслуги.Ссылка.Дата КАК Дата
		|ИЗ
		|	Документ.ЗаказДоговор.ТоварыУслуги КАК ЗаказДоговорТоварыУслуги
		|ГДЕ
		|	ЗаказДоговорТоварыУслуги.НомерПотолка <> """"
		|	И ЗаказДоговорТоварыУслуги.ЗаказНаПроизводство = ЗНАЧЕНИЕ(Документ.ЗаказНаПроизводство.ПустаяСсылка)
		|	И (ЗаказДоговорТоварыУслуги.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Справочник.ВидыНоменклатуры.Отрез)
		|			ИЛИ ЗаказДоговорТоварыУслуги.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Справочник.ВидыНоменклатуры.Потолок))
		|	И ЗаказДоговорТоварыУслуги.Ссылка.Проведен
		|
		|СГРУППИРОВАТЬ ПО
		|	ЗаказДоговорТоварыУслуги.Ссылка,
		|	ЗаказДоговорТоварыУслуги.Ссылка.Дата";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		НаборЗаписей = РегистрыСведений.ОбъектыКОбработкеПослеОбновленияРекомендуемые.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.ВерсияПрограммы.Установить(ВерсияПрограммы); 
		НаборЗаписей.Отбор.Документ.Установить(Выборка.Ссылка); 
			
