		ТаблицаФактур = ДокОбъект.ФактураПотолка.Выгрузить();
		
		ДокОбъект.ФактураПотолка.Очистить();
		
		НоваяСтрока = ДокОбъект.ФактураПотолка.Добавить();
		НоваяСтрока.Основная = Истина;
		НоваяСтрока.ПродукцияФактура = ДокОбъект.УДАЛИТЬ_ПродукцияФактура;
