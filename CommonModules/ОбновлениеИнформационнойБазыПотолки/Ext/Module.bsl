		НаборЗаписей.Записать(Истина);
	КонецЦикла;
	
	//монтажи 
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Монтаж.Ссылка,
	|	Монтаж.Дата
	|ИЗ
	|	Документ.Монтаж КАК Монтаж
	|ГДЕ
	|	Монтаж.Проведен
	|	И Монтаж.Результат = ЗНАЧЕНИЕ(Справочник.РезультатыМонтажа.Выполнен)
	|	И Монтаж.Склад <> Монтаж.СкладТоваров";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		НаборЗаписей = РегистрыСведений.ОбъектыКОбработкеПослеОбновленияРекомендуемые.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.ВерсияПрограммы.Установить(ВерсияПрограммы); 
		НаборЗаписей.Отбор.Документ.Установить(Выборка.Ссылка); 
			
		НоваяЗапись = НаборЗаписей.Добавить(); 
		НоваяЗапись.ВерсияПрограммы = ВерсияПрограммы; 
		НоваяЗапись.Документ = Выборка.Ссылка; 
		НоваяЗапись.ДокументДата = Выборка.Дата; 
		
		НаборЗаписей.Записать(Истина);
	КонецЦикла;
	
	//добавление категорий номенклатукры в доступные группы свойств
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	КатегорияНоменклатуры.Ссылка
	|ИЗ
	|	Справочник.КатегорияНоменклатуры КАК КатегорияНоменклатуры";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ЭлОбъект = Выборка.Ссылка.ПолучитьОбъект();
		Если ЭлОбъект.НаборСвойств.Пустая() Тогда
			УправлениеСвойствами.ПередЗаписьюВидаОбъекта(ЭлОбъект, "Справочник_Номенклатура");
			ЭлОбъект.Записать();
		КонецЕсли;
	КонецЦикла;
	
	//добавление категорий контрагентов в доступные группы свойств
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	КатегорииКонтрагентов.Ссылка
	|ИЗ
	|	Справочник.КатегорииКонтрагентов КАК КатегорииКонтрагентов";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ЭлОбъект = Выборка.Ссылка.ПолучитьОбъект();
		Если ЭлОбъект.НаборСвойств.Пустая() Тогда
			УправлениеСвойствами.ПередЗаписьюВидаОбъекта(ЭлОбъект, "Справочник_Контрагенты");
			ЭлОбъект.Записать();
		КонецЕсли;
	КонецЦикла;
	
	//////////////////////////////////////////////
	Константы.ЗарплатныйПроект.Установить(Ложь);
	//////////////////////////////////////////////
	
	//Замена "Услуга раскроя кривых" и "Услуга раскроя углов" на "Услуга"
	УслугаРаскрояКривых = Справочники.ВидыНоменклатуры.НайтиПоКоду("000000006");
	УслугаРаскрояУглов = Справочники.ВидыНоменклатуры.НайтиПоКоду("000000005");
	Услуга = Справочники.ВидыНоменклатуры.НайтиПоКоду("000000004");
	
	Если НЕ УслугаРаскрояКривых.ПометкаУдаления Тогда
		СпрОбъект = УслугаРаскрояКривых.ПолучитьОбъект();
		СпрОбъект.УстановитьПометкуУдаления(Истина);
		Попытка
			СпрОбъект.Записать();
		Исключение
		КонецПопытки;
	КонецЕсли;
	Если НЕ УслугаРаскрояУглов.ПометкаУдаления Тогда
		СпрОбъект = УслугаРаскрояУглов.ПолучитьОбъект();
		СпрОбъект.УстановитьПометкуУдаления(Истина);
		Попытка
			СпрОбъект.Записать();
		Исключение
		КонецПопытки;
	КонецЕсли;
	
	Если НЕ УслугаРаскрояКривых.Пустая() И НЕ УслугаРаскрояУглов.Пустая() И НЕ Услуга.Пустая() Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	Номенклатура.Ссылка
		|ИЗ
		|	Справочник.Номенклатура КАК Номенклатура
		|ГДЕ
		|	Номенклатура.ВидНоменклатуры = &УслугаРаскрояКривых
		|	ИЛИ Номенклатура.ВидНоменклатуры = &УслугаРаскрояУглов";
		Запрос.УстановитьПараметр("УслугаРаскрояКривых",УслугаРаскрояКривых);
		Запрос.УстановитьПараметр("УслугаРаскрояУглов",УслугаРаскрояУглов);
		
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			СпрОбъект = Выборка.Ссылка.ПолучитьОбъект();
			Если СпрОбъект.ВидНоменклатуры = УслугаРаскрояКривых Тогда
				СпрОбъект.ВидПроизводственнойУслуги = Справочники.ВидыПроизводственныхУслуг.КриволинейныйУчасток;
			ИначеЕсли СпрОбъект.ВидНоменклатуры = УслугаРаскрояУглов Тогда
				СпрОбъект.ВидПроизводственнойУслуги = Справочники.ВидыПроизводственныхУслуг.Углы;
			КонецЕсли;
			СпрОбъект.ВидНоменклатуры = Услуга;
			Попытка
				СпрОбъект.Записать();
			Исключение
				ЗаписьЖурналаРегистрации("Обновление_1_0_6_0",УровеньЖурналаРегистрации.Ошибка,,,"Не удалось изменить вид для номенклатуры ["+Выборка.Ссылка+"] : " +ОписаниеОшибки());
			КонецПопытки;
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

