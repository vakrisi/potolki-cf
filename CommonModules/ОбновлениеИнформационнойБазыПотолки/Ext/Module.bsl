	|ИМЕЮЩИЕ СУММА(ВТ.КоличествоПусто) = 0
	|	И СУММА(ВТ.КоличествоЗаполнено) > 0
	|	И НЕ ВТ.СлужебныйУчетБонусовПоДисконтнымКартам
	|";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		ПоместитьВРегистрКОбработке(ВерсияПрограммы, Выборка.Ссылка, Выборка.Дата);
	КонецЦикла;
	
	// #14300 нужно заполнить новое измерение "ЕдиницаИзмерения" и ресурс "КоличествоВЕдиницахДокумента" в регистре накопления "Продажи"
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	Продажи.Регистратор КАК Ссылка,
