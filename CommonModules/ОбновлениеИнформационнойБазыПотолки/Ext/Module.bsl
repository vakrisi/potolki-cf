#Область Обновление_0_8_6_0

Процедура ОбработкаОбновления_0_8_6_0() Экспорт
	
	//перепроводим все выполненные монтажи
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Монтаж.Ссылка
	|ИЗ
	|	Документ.Монтаж КАК Монтаж
	|ГДЕ
	|	Монтаж.Результат = &Результат
	|	И Монтаж.Проведен
	|
	|УПОРЯДОЧИТЬ ПО
	|	Монтаж.Дата";
	Запрос.УстановитьПараметр("Результат",Справочники.РезультатыМонтажа.Выполнен);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Попытка
			ДокОбъект = Выборка.Ссылка.ПолучитьОбъект();
			ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
		Исключение
		КонецПопытки
	КонецЦикла;
	
	//перепроводим все документы, что должны быть регистраторами регистра "РасчетыПоЗаказам"
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СчетНаОплату.Ссылка,
	|	СчетНаОплату.Дата КАК Дата
	|ИЗ
