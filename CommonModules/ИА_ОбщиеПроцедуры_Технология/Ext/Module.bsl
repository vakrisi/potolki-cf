Функция ИА_ПолучитьСсылкуOnClickПоляHTML(Элемент, pEvtObj) Экспорт

	СтандартнаяОбработка = Ложь;
	
	Узел = pEvtObj.srcElement;
	
	href = "";
	
	Пока Истина Цикл
		
		Попытка
			ИмяЦели = Узел.tagName
		Исключение
			Прервать;
		КонецПопытки;
		
		Если ИмяЦели = "HTML" Тогда
			Прервать;
		КонецЕсли;

		
		Если ИмяЦели = "A" Тогда
			Попытка
				//href = Узел.href;
				href = Узел.outerHTML;
			Исключение
			КонецПопытки;
			Прервать;
		КонецЕсли; 
		
		Узел = Узел.parentElement;
		
	КонецЦикла;
	
	Если НЕ ПустаяСтрока(href) Тогда
		Если СтрЧислоВхождений(href, "1CRefInst") > 0 Тогда
			
			НайденаСсылка = Ложь;
			// -- Погарцев, исправлено извелчение УИДа
			ПозицияНачалаСсылки = Найти(href, "1CRefInst");
			//Копияhref = Прав(href, СтрДлина(href) - ПозицияНачалаСсылки - СтрДлина("1CRefInst")+1);
			Копияhref = "";
			
			// бежим до первой кавычки после ПозицияНачалаСсылки + СтрДлина("1CRefInst")
			Для Позиция = ПозицияНачалаСсылки + СтрДлина("1CRefInst") по СтрДлина(href) Цикл
				СимволНаПозиции = Сред(href, Позиция, 1);
				Если СимволНаПозиции = """" Тогда
					Прервать;
				КонецЕсли;
				Копияhref = Копияhref + СимволНаПозиции;
			КонецЦикла;
			
			
			// -- Погарцев
			
			// СТАРЫЙ КОД
			//НайденаСсылка = Истина;
			//Копияhref = СтрЗаменить(href, "about:1CRefInst", "");
			// КОНЕЦ
			
			Попытка
				Если не стрдлина(Копияhref)=36 ТОгда
					ВызватьИсключение 1;
				КонецЕсли;
				
				UUID = Новый УникальныйИдентификатор(Копияhref);
				Ссылка = ИА_ОбщиеПроцедуры_Технология_Сервер.ПолучитьСсылкуСправочника("ИА_Инструкции",UUID); 				 
				НайденаСсылка = Истина;
			Исключение
				НайденаСсылка = Ложь;
			КонецПопытки;
			
			Если ЗначениеЗаполнено(Ссылка) И НайденаСсылка Тогда
				
				pEvtObj.returnValue  = Ложь;
				Возврат Ссылка;
			КонецЕсли; 
		КонецЕсли;		
	КонецЕсли; 
	Возврат ПредопределенноеЗначение("Справочник.ИА_Инструкции.ПустаяСсылка");	
КонецФункции

Функция ИА_ПолучитьСсылкуНаГлоссарийOnClickПоляHTML(Элемент, pEvtObj) Экспорт

	СтандартнаяОбработка = Ложь;
	
	Узел = pEvtObj.srcElement;
	
	href = "";
	UUID = "";
	
	Попытка
		UUID = pEvtObj.srcElement.innerText;
	Исключение
		Возврат ПредопределенноеЗначение("Справочник.ИА_Инструкции.ПустаяСсылка");
	КонецПопытки;
	
	Пока Истина Цикл
		
		Попытка
			ИмяЦели = Узел.tagName
		Исключение
			Прервать;
		КонецПопытки;
		
		Если ИмяЦели = "A" Тогда
			Попытка
				//href = Узел.href;
				href = Узел.outerHTML;
			Исключение
			КонецПопытки;
			Прервать;
		КонецЕсли; 
		
		Узел = Узел.parentElement;
		
	КонецЦикла;
	
	Если НЕ ПустаяСтрока(href) Тогда
		Если СтрЧислоВхождений(href, "1CRefInstGlossary") > 0 Тогда
			Копияhref = СтрЗаменить(href, "about:1CRefInstGlossary", "");
			
			Ссылка = ИА_ОбщиеПроцедуры_Технология_Сервер.СсылкаПоСлову(UUID);
						
			Если ЗначениеЗаполнено(Ссылка) Тогда
				pEvtObj.returnValue  = Ложь;
				Возврат Ссылка;
			КонецЕсли; 
		КонецЕсли;		
	КонецЕсли; 
	Возврат ПредопределенноеЗначение("Справочник.ИА_Инструкции.ПустаяСсылка");	
КонецФункции

