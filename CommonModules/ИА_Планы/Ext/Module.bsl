Функция ПолучитьНапоминания() Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	КСУ_Напоминания.Период,
	               |	КСУ_Напоминания.Пользователь,
	               |	КСУ_Напоминания.Объект,
	               |	КСУ_Напоминания.Тема,
	               |	КСУ_Напоминания.Текст
	               |ИЗ
	               |	РегистрСведений.КСУ_Напоминания КАК КСУ_Напоминания
	               |ГДЕ
	               |	КСУ_Напоминания.Пользователь = &Пользователь
	               |	И КСУ_Напоминания.Период <= &Период";
	Запрос.УстановитьПараметр("Пользователь", ПараметрыСеанса.ТекущийПользователь);
	Запрос.УстановитьПараметр("Период", ТекущаяДата() + 30);
	резТЗ = запрос.Выполнить().Выгрузить();
	
	рез = новый Массив;
	для каждого стр из резТЗ Цикл
		Новстр = Новый Структура("Тема,Текст",стр.Тема,стр.Текст);
		рез.Добавить(Новстр);
		
		наб = РегистрыСведений.КСУ_Напоминания.СоздатьНаборЗаписей();
		наб.Отбор.Пользователь.Установить(стр.Пользователь);
		наб.Отбор.Объект.Установить(стр.Объект);

		наб.Записать(истина);
	КонецЦикла;
	
	Возврат рез;
КонецФункции

