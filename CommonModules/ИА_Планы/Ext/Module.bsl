

// Обрабатываает структуру с боевыми планами.
// Удаляет старые недельны планы (у которых родитель ПОСТ) по каждому постe, оставляет не более чем КоличествоПланов по каждому посту
Процедура УдалитьСтарыеПланы(ДеревоПланов, КоличествоПланов = 1) Экспорт
	
	// удаляем планы с конца, до тех пор их колчисево не станет меньше или равным КоличествоПланов
	Пока ДеревоПланов.Планы.Количество() > КоличествоПланов Цикл
		ДеревоПланов.Планы.Удалить(ДеревоПланов.Планы.Количество()-1);
	КонецЦикла;
	
	// идем по дочерним постам
	Для Каждого ДочернийПост Из ДеревоПланов.Посты Цикл
		УдалитьСтарыеПланы(ДочернийПост, КоличествоПланов);
	КонецЦикла;
	
КонецПроцедуры


Процедура ЗаменитьПостыНаСотрудников(ДеревоПланов, ПостСОтвевенным = Неопределено) Экспорт
	
	// проанализируем, чьи планы есть на посту
	МассивОтвественных = Новый Массив;
	Для Каждого План Из ДеревоПланов.Планы Цикл
		Если МассивОтвественных.Найти(План.Отвественный) = Неопределено Тогда
			МассивОтвественных.Добавить(План.Отвественный);
		КонецЕсли;
	КонецЦикла;
	
	Если МассивОтвественных.Количество() > 0 Тогда
		ДеревоПланов.Пост = МассивОтвественных[0];
	КонецЕсли;
	
	// идем по дочерним постам
	Для Каждого ДочернийПост Из ДеревоПланов.Посты Цикл
		ЗаменитьПостыНаСотрудников(ДочернийПост);
	КонецЦикла;
	
КонецПроцедуры


// в процедура передаем верхний пост
// далее бежим рекурсивно по всем подчиненным постам
// если у текущего поста, пост = пользователь, то ничего не делаем, если = оргсхема, то поднимаем все планы на уровень родителя



// нам надо чтобы не было секуций без планов
// если есть секция без планов, то всее ее планы надо засунуть в родителя

Процедура СвернутьПоСотрудникам(ДеревоПланов) Экспорт
	
	//Сообщить("ПОСТ: "+ДеревоПланов.Пост+". РОДИТЕЛЬ:"+?(Родитель=Неопределено,"нан",Родитель.Пост));
	
	// просмотрим все посты которые у меня есть в подчинении, если надйем пост с ОРГСХЕМОЙ, то забираем из него все посты в себя, и так до тех пор пока есть хоть один пост с оргсхемой
	
	
	
	Если ТипЗнч(ДеревоПланов.Пост) = Тип("СправочникСсылка.Пользователи") Тогда
		
		ТребутсяПроверка = Истина;
		
		Пока ТребутсяПроверка Цикл
			ТребутсяПроверка = Ложь;
			
			СписокУдаляемыхПостов = Новый Массив;
			
			Для Каждого МойДочернийПост из ДеревоПланов.Посты Цикл
				
				Если ТипЗнч(МойДочернийПост.Пост) = Тип("СправочникСсылка.ОргСхема") Тогда
					
					ТребутсяПроверка = Истина;
					
					// забираем все посты
					Для Каждого ПереносимыйПост Из МойДочернийПост.Посты Цикл
						ДеревоПланов.Посты.Добавить(ПереносимыйПост);
					КонецЦикла;
					
					СписокУдаляемыхПостов.Добавить(МойДочернийПост);
					
				КонецЕсли;
				
			КонецЦикла;
			
			Для Каждого УдаляемыйПост из СписокУдаляемыхПостов Цикл
				
				ИндексПоста = ДеревоПланов.Посты.Найти(УдаляемыйПост);
				ДеревоПланов.Посты.Удалить(ИндексПоста);
				
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;
	
	
	// на дном уровне могут быть записи с одинаковым знаечние пост, надо планы собрать в один пост
	СписокУдаляемыхПостов = Новый Массив;
	
	ПервыеПосты = Новый Соответствие; // Пост, СтруктураПост
	
	Для Каждого СтруктураПост Из  ДеревоПланов.Посты Цикл
		
		СтруктураНазанчение = ПервыеПосты.Получить(СтруктураПост.Пост);
		
		Если СтруктураНазанчение = Неопределено Тогда
			
			ПервыеПосты.Вставить(СтруктураПост.Пост, СтруктураПост);
			
		Иначе
			
			Для Каждого План из СтруктураПост.Планы Цикл
				СтруктураНазанчение.Планы.Добавить(План);
			КонецЦикла;
			
			СписокУдаляемыхПостов.Добавить(СтруктураПост);
			
		КонецЕсли;
		
	КонецЦикла;
	
	Для Каждого УдаляемыйПост из СписокУдаляемыхПостов Цикл
				
		ИндексПоста = ДеревоПланов.Посты.Найти(УдаляемыйПост);
		ДеревоПланов.Посты.Удалить(ИндексПоста);
		
	КонецЦикла;
			
	
	
	Для Каждого СтруктураПост из ДеревоПланов.Посты Цикл
		СвернутьПоСотрудникам(СтруктураПост); //, ДеревоПланов, ?(ТипЗнч(ДеревоПланов.Пост) = Тип("СправочникСсылка.ОргСхема"),Родитель,ДеревоПланов));
	КонецЦикла;
	
		
КонецПроцедуры
	
