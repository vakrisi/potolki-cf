Процедура СинхронизироватьКалендариГугл(ПолноеОбновление = ложь) Экспорт
	
	Запрос = Новый запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	КСУ_ВыгрузкаЗадачВГуглКалендарь.ид
	               |ИЗ
	               |	РегистрСведений.КСУ_ВыгрузкаЗадачВГуглКалендарь КАК КСУ_ВыгрузкаЗадачВГуглКалендарь";
	идЗадачКСУ = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("ид");
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	КСУ_ДоступКGoogleКалендарю.Пользователь,
	               |	КСУ_ДоступКGoogleКалендарю.Токен,
	               |	КСУ_ДоступКGoogleКалендарю.Календари,
	               |	КСУ_ДоступКGoogleКалендарю.ТокенОбновления,
	               |	КСУ_ДоступКGoogleКалендарю.КалендарьВыгрузки
	               |ИЗ
	               |	РегистрСведений.КСУ_ДоступКGoogleКалендарю КАК КСУ_ДоступКGoogleКалендарю
	               |ГДЕ
	               |	КСУ_ДоступКGoogleКалендарю.Токен <> """"";
	Юзеры = запрос.Выполнить().Выгрузить();
	
	Соединение = Новый HTTPСоединение("www.googleapis.com", ,,,,, Новый ЗащищенноеСоединениеOpenSSL());
	Для каждого польз из Юзеры цикл
		Календари = ЗначениеИзСтрокиВнутр(польз.Календари);
		//		
		access_token = ИА_КСУОбщийСервер.ПолучитьAccessTokenИзRefresh(Соединение, польз.токен);
		
		ЗапросHTTP = Новый HTTPЗапрос;
		ЗапросHTTP.Заголовки["Content-Type"] = "application/x-www-form-urlencoded";
		ЗапросHTTP.Заголовки["Authorization"] = "Bearer " + access_token;
		
		Для каждого идКалендаря из Календари Цикл			
			адресбезТокена = "calendar/v3/calendars/"+идКалендаря+"/events?singleEvents=true";
			Если польз.ТокенОбновления = "" или ПолноеОбновление Тогда
				ЗапросHTTP.АдресРесурса = адресбезТокена;
			Иначе
				ЗапросHTTP.АдресРесурса = адресбезТокена+"&syncToken="+польз.ТокенОбновления;
			КонецЕсли;
			
			ОтветHTTP = Соединение.Получить(ЗапросHTTP);
			Если ОтветHTTP.КодСостояния = 401 Тогда
				ЗапросHTTP.АдресРесурса = адресбезТокена;
				ОтветHTTP = Соединение.Получить(ЗапросHTTP);
			КонецЕсли;
			
			ТекстОтвета = ОтветHTTP.ПолучитьТелоКакСтроку();
			Если ОтветHTTP.КодСостояния = 200 Тогда		
				JSonИт = Новый ЧтениеJSON;
				JSonИт.УстановитьСтроку(ТекстОтвета);
				резИт = ПрочитатьJSON(JSonИт);
				
				
				ЗагрузитьСобытия(резИт.items, польз.Пользователь, идКалендаря,идЗадачКСУ);
				Пока резИт.Свойство("nextPageToken") и резИт.nextPageToken<>"" Цикл
					ЗапросHTTP.АдресРесурса = адресбезТокена+"&pageToken="+резИт.nextPageToken;
					ОтветHTTP = Соединение.Получить(ЗапросHTTP);
					ТекстОтвета = ОтветHTTP.ПолучитьТелоКакСтроку();
					JSonИт.УстановитьСтроку(ТекстОтвета);
					резИт = ПрочитатьJSON(JSonИт);								
					ЗагрузитьСобытия(резИт.items, польз.Пользователь, идКалендаря,идЗадачКСУ);
				КонецЦикла;
				
				
				мен = РегистрыСведений.КСУ_ДоступКGoogleКалендарю.СоздатьМенеджерЗаписи();
				ЗаполнитьЗначенияСвойств(мен, польз);
				мен.ТокенОбновления = резИт.nextSyncToken;
				мен.Записать(истина);
			Иначе
				ЗаписьЖурналаРегистрации("КСУ ошибка гугл",,,,"Ошибка получения списка событий "+ ТекстОтвета);
			КонецЕсли;
		КонецЦикла;			
	КонецЦикла;
КонецПроцедуры

Процедура ЗагрузитьСобытия(События, Пользователь, идКалендаря,идЗадачКСУ)
	Для каждого Задача из События Цикл
		Если идЗадачКСУ.найти(Задача.id)<>Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		МенСобытия = РегистрыСведений.КСУ_СобытияКалендаряGoogle.СоздатьМенеджерЗаписи();
		МенСобытия.Пользователь = Пользователь;
		МенСобытия.идСобытия = Задача.id;					
		МенСобытия.идКалендаря = идКалендаря;					
		
		Если Задача.status = "cancelled" или не Задача.свойство("summary") тогда
			МенСобытия.Прочитать();
			Если МенСобытия.Выбран() Тогда
				МенСобытия.Пользователь = Пользователь;
				МенСобытия.идСобытия = Задача.id;					
				МенСобытия.Удалить();
			КонецЕсли;
			Продолжить;
		КонецЕсли;
		
		Если Задача.start.Свойство("date") Тогда
			МенСобытия.ДатаНачала = ПолучитьДатуИзУниверс(Задача.start.date);
			МенСобытия.ДатаКонца = ПолучитьДатуИзУниверс(Задача.end.date);
			МенСобытия.БезВремени = истина;
		Иначе
			МенСобытия.ДатаНачала = ПолучитьДатуИзУниверс(Задача.start.dateTime);
			МенСобытия.ДатаКонца = ПолучитьДатуИзУниверс(Задача.end.dateTime);
			
			Если НачалоДня(МенСобытия.ДатаНачала)<>НачалоДня(МенСобытия.ДатаКонца) Тогда
				МенСобытия.БезВремени = истина;
			КонецЕсли;
		КонецЕсли;
		МенСобытия.Описание = Задача.summary;
		МенСобытия.Записать(истина);
	КонецЦикла;
КонецПроцедуры

Функция ПолучитьДатуИзУниверс(знач универс) Экспорт
	универс = лев(универс,19);
	универс= СтрЗаменить(универс,"-","");
	универс= СтрЗаменить(универс,":","");
	универс= СтрЗаменить(универс,"T","");
	Возврат дата(универс);
КонецФункции

