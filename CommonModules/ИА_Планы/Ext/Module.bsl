Функция ПолучитьДневникСервер(ПериодС,ПериодПо,Пост) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ИА_ДневникСостояний.Период КАК Период,
	               |	ИА_ДневникСостояний.ИД,
	               |	ИА_ДневникСостояний.Пост,
	               |	ИА_ДневникСостояний.Наклон,
	               |	ИА_ДневникСостояний.Состояние,
	               |	ИА_ДневникСостояний.Шаг,
	               |	ИА_ДневникСостояний.Задача,
	               |	ИА_ДневникСостояний.Выполнено,
	               |	ИА_ДневникСостояний.ДатаВыполнения,
	               |	ВЫБОР
	               |		КОГДА ИА_ДневникСостояний.Наклон = ЗНАЧЕНИЕ(Перечисление.ИА_НаклонГрафика.ПустаяСсылка)
	               |			ТОГДА -1
	               |		ИНАЧЕ ИА_ДневникСостояний.Наклон.Порядок
	               |	КОНЕЦ КАК ИндексКартинки,
	               |	ЛОЖЬ КАК НовоеСостояние
	               |ИЗ
	               |	РегистрСведений.ИА_ДневникСостояний КАК ИА_ДневникСостояний
	               |ГДЕ
	               |	ИА_ДневникСостояний.Период МЕЖДУ &ДатаНачала И &ДатаКонца
	               |	И ИА_ДневникСостояний.Пост = &Пост
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Период УБЫВ";
	Запрос.УстановитьПараметр("ДатаНачала", ПериодС);
	Запрос.УстановитьПараметр("ДатаКонца", ПериодПо);
	Запрос.УстановитьПараметр("Пост", Пост);
	
	тз = Запрос.Выполнить().Выгрузить();
	Возврат тз;
КонецФункции

Процедура СохранитьИзмененияДневника(СтрокаДн) Экспорт
	УдалитьСтрокуДневника(СтрокаДн.ИД);
	
	мен = РегистрыСведений.ИА_ДневникСостояний.СоздатьМенеджерЗаписи();
	ЗаполнитьЗначенияСвойств(мен, СтрокаДн);
	мен.Записать(истина);
КонецПроцедуры

Процедура УдалитьСтрокуДневника(ид) Экспорт
	мен = РегистрыСведений.ИА_ДневникСостояний.СоздатьНаборЗаписей();
	мен.Отбор.ИД.Значение = ид;
	мен.Отбор.ИД.Использование = истина;
	мен.Записать(истина);
КонецПроцедуры

Функция ПолучитьРодителя(пШаг) Экспорт
	возврат пШаг.Родитель;
КонецФункции

Функция ПолучитьПервыйШаг(пСостояние) Экспорт
	выборка = Справочники.ИА_Состояния.Выбрать(пСостояние,,,"Код");
	
	Пока выборка.Следующий() Цикл
		Если не выборка.ПометкаУдаления Тогда
			возврат выборка.Ссылка;              	
		КонецЕсли;
	КонецЦикла;
	
	возврат Справочники.ИА_Состояния.ПустаяСсылка();
КонецФункции

Функция ПолучитьПорядок(пНаклон) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ИА_НаклонГрафика.Порядок
	               |ИЗ
	               |	Перечисление.ИА_НаклонГрафика КАК ИА_НаклонГрафика
	               |ГДЕ
	               |	ИА_НаклонГрафика.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", пНаклон);
	Выборка = Запрос.Выполнить().Выбрать();
	выборка.Следующий();
	возврат Выборка.Порядок;
КонецФункции

Функция ПолучитьСледующийШаг(пШаг) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ИА_Состояния.Ссылка
	               |ИЗ
	               |	Справочник.ИА_Состояния КАК ИА_Состояния
	               |ГДЕ
	               |	ИА_Состояния.Родитель = &Родитель
	               |	И ИА_Состояния.Код > &Код
	               |	И ИА_Состояния.ПометкаУдаления = ЛОЖЬ
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ИА_Состояния.Код";
	Запрос.УстановитьПараметр("Родитель", пШаг.Родитель);
	Запрос.УстановитьПараметр("Код", пШаг.Код);
	Выборка = Запрос.Выполнить().Выбрать();
	Если выборка.Следующий() Тогда // найден шаг в рамках текущего состояния
		возврат Выборка.Ссылка;
	Иначе // переходим на следующее состояние
		следСост = Неопределено;
		Если пШаг.Родитель = Справочники.ИА_Состояния.Несуществование Тогда	
			следСост = Справочники.ИА_Состояния.Опасность;
		ИначеЕсли пШаг.Родитель = Справочники.ИА_Состояния.Опасность Тогда	
			следСост = Справочники.ИА_Состояния.ЧрезвычайноеПоложение;
		ИначеЕсли пШаг.Родитель = Справочники.ИА_Состояния.ЧрезвычайноеПоложение Тогда	
			следСост = Справочники.ИА_Состояния.НормальнаяДеятельность;
		ИначеЕсли пШаг.Родитель = Справочники.ИА_Состояния.НормальнаяДеятельность Тогда	
			следСост = Справочники.ИА_Состояния.Изобилие;
		ИначеЕсли пШаг.Родитель = Справочники.ИА_Состояния.Изобилие Тогда	
			следСост = Справочники.ИА_Состояния.Могущество;
		КонецЕсли;
		
		Если следСост = Неопределено Тогда
			возврат Справочники.ИА_Состояния.ПустаяСсылка();
		КонецЕсли;
		
		Запрос.УстановитьПараметр("Родитель", следСост);
		Запрос.УстановитьПараметр("Код", "000");
		Выборка = Запрос.Выполнить().Выбрать();
		Если выборка.Следующий() Тогда 
			возврат Выборка.Ссылка;
		Иначе
			возврат Справочники.ИА_Состояния.ПустаяСсылка();
		КонецЕсли;
	КонецЕсли;
КонецФункции

Функция ПолучитьШагиСостояния(пСостояние) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ИА_Состояния.Ссылка
	               |ИЗ
	               |	Справочник.ИА_Состояния КАК ИА_Состояния
	               |ГДЕ
	               |	ИА_Состояния.Родитель = &Родитель
	               |	И ИА_Состояния.ПометкаУдаления = ЛОЖЬ
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ИА_Состояния.Код";
	Запрос.УстановитьПараметр("Родитель", пСостояние);
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
КонецФункции

Функция	ПолучитьПредыдущуюКвоту(пВидСтатистики, Ответственный, Родитель, ДатаНачала) Экспорт
	Если Не ЗначениеЗаполнено(Ответственный) ИЛИ Не ЗначениеЗаполнено(пВидСтатистики) Тогда
		Возврат 0;
	Иначе
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		               |	ИА_ПланыДействийПлан.КвотаПлан
		               |ИЗ
		               |	Справочник.ИА_ПланыДействий.План КАК ИА_ПланыДействийПлан
		               |ГДЕ
		               |	ИА_ПланыДействийПлан.Ссылка.Ответственный = &Ответственный
		               |	И ИА_ПланыДействийПлан.ВидСтатистики = &ВидСтатистики
		               |	И ИА_ПланыДействийПлан.Ссылка.ДатаНачала < &ДатаНачала
		               |	И ИА_ПланыДействийПлан.Ссылка.Родитель = &Родитель
		               |	И ИА_ПланыДействийПлан.Ссылка.ПометкаУдаления = ЛОЖЬ
		               |
		               |УПОРЯДОЧИТЬ ПО
		               |	ИА_ПланыДействийПлан.Ссылка.ДатаНачала УБЫВ";
		Запрос.УстановитьПараметр("Ответственный",Ответственный);
		Запрос.УстановитьПараметр("Родитель",Родитель);
		Запрос.УстановитьПараметр("ВидСтатистики",пВидСтатистики);
		Запрос.УстановитьПараметр("ДатаНачала",?(ЗначениеЗаполнено(ДатаНачала), ДатаНачала, ТекущаяДата()));
		
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Возврат Выборка.КвотаПлан 
		Иначе
			Возврат 0;
		КонецЕсли;
	КонецЕсли;
КонецФункции

Функция ПолучитьЗначениеСтатистики(пВидСтатистики, пАналитика1, пАналитика2, пАналитика3, пДатаНачала, пРодитель) Экспорт
	Если ЗначениеЗаполнено(пРодитель) Тогда // дневной
		ДатаНач = НачалоДня(пДатаНачала) - 60*60*24;
		ДатаКон = КонецДня(ДатаНач);
	Иначе
		ДатаНач = НачалоДня(пДатаНачала) - 60*60*24*7;
		ДатаКон = НачалоДня(пДатаНачала) - 1;
	КонецЕсли;
	
	Данные = Новый ТаблицаЗначений;
	Данные.Колонки.Добавить("ДатаНачала");
	Данные.Колонки.Добавить("ДатаКонца");
	Новстр = Данные.Добавить();
	Новстр.ДатаНачала = ДатаНач;
	Новстр.ДатаКонца = ДатаКон;
	СтрокаСтатистик = Новый Структура("ВидСтатистики,Аналитика1,Аналитика2,Аналитика3,Данные",пВидСтатистики, пАналитика1, пАналитика2, пАналитика3,Данные);
	
	ТЗ = ИА_Защита_Статистика.ПолучитьТЗДанныеСтатистики(СтрокаСтатистик,ДатаНач,ДатаКон);
	
	возврат тз.Итог("Количество");
КонецФункции

