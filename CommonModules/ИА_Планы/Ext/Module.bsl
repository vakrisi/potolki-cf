Процедура РаспределитьЗадачиДневногоПлана(план) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	ИА_ЗадачиПлана.Ссылка КАК Ссылка,
	               |	ИА_ЗадачиПлана.ВремяПлан КАК ВремяПлан,
	               |	ИА_ЗадачиПлана.ВремяФакт КАК ВремяФакт,
	               |	ИА_ЗадачиПлана.ВремяНачала КАК ВремяНачала,
	               |	ИА_ЗадачиПлана.ВремяКонца КАК ВремяКонца,
	               |	ИА_ЗадачиПлана.Код КАК Код,
	               |	ВЫБОР
	               |		КОГДА ИА_ЗадачиПлана.ВремяНачала = ДАТАВРЕМЯ(1, 1, 1)
	               |			ТОГДА 1
	               |		ИНАЧЕ 0
	               |	КОНЕЦ КАК УказанаДатаНачала
	               |ИЗ
	               |	Справочник.ИА_ЗадачиПлана КАК ИА_ЗадачиПлана
	               |ГДЕ
	               |	ИА_ЗадачиПлана.Владелец = &Владелец
	               |	И ИА_ЗадачиПлана.ПометкаУдаления = ЛОЖЬ
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	УказанаДатаНачала,
	               |	ВремяНачала,
	               |	ВремяПлан УБЫВ";
	Запрос.УстановитьПараметр("Владелец",план);
	тз = Запрос.Выполнить().Выгрузить();
	Если тз.Количество() = 0 Тогда
		возврат;
	КонецЕсли;
	
	рабВремя = ПолучитьРабочееВремя();
	
	Если тз.Количество()>0 И не ЗначениеЗаполнено(тз[0].ВремяНачала) Тогда // первое распределение сделаем по исходному плану
		тз.Сортировать("Код");	
	КонецЕсли;
	
	ВсеОбработаны = ложь;
	Пока не ВсеОбработаны Цикл
		Для каждого стр из ТЗ Цикл
			ВсеОбработаны = истина;
			если не ЗначениеЗаполнено(стр.ВремяНачала) Тогда
				ВсеОбработаны = ложь;
				
				сч = 0;
				кол = тз.Количество();
				
				СтрокаДобавлена = ложь;
				послЗапДК = рабВремя.ВремяНачалаДня;
				ПослИндекс = 0;
				
				Пока сч<кол Цикл
					
					Если ЗначениеЗаполнено(тз[сч].ВремяКонца) ТОгда
						послЗапДК = тз[сч].ВремяКонца + 1;
						ПослИндекс = сч + 1;
					Иначе 
						Прервать;
					КонецЕсли;
					
					Если сч<кол-1 И ЗначениеЗаполнено(тз[сч].ВремяКонца) И ЗначениеЗаполнено(тз[сч+1].ВремяНачала) 
						И ВремяВЧисло(тз[сч+1].ВремяНачала) - ВремяВЧисло(тз[сч].ВремяКонца) > ВремяВЧисло(тз[сч].ВремяПлан) Тогда
						Новстр = тз.Вставить(сч+1);
						ЗаполнитьЗначенияСвойств(Новстр, стр);
						Новстр.ВремяНачала = тз[сч].ВремяКонца + 1;
						Новстр.ВремяКонца = Новстр.ВремяНачала + ВремяВЧисло(Новстр.ВремяПлан);
						
						СтрокаДобавлена = Истина;
						Прервать;
					КонецЕсли;
					
					сч = сч + 1;
				КонецЦикла;
				
				Если не СтрокаДобавлена Тогда
					Новстр = тз.Вставить(ПослИндекс);
					ЗаполнитьЗначенияСвойств(Новстр, стр);
					Новстр.ВремяНачала = послЗапДК;
					Новстр.ВремяКонца = Новстр.ВремяНачала + ВремяВЧисло(Новстр.ВремяПлан);										
				КонецЕсли;
				
				об = стр.ссылка.получитьОбъект();
				ЗаполнитьЗначенияСвойств(об,новстр,"ВремяНачала,ВремяКонца");
				об.записать();
				
				тз.Удалить(стр);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры

функция ВремяВЧисло(пВр) Экспорт
	возврат 60*60*час(пВр) + 60*Минута(пвр);
КонецФункции

Функция ПолучитьРабочееВремя(Пользователь = Неопределено) Экспорт
	
	текюзер = Пользователь;
	Если текюзер = Неопределено Тогда
		текюзер =  ПараметрыСеанса.ТекущийПользователь;
	КонецЕсли;
	
	ВремяНачалаДня = Дата(1,1,1,8,0,0);
	ВремяКонцаДня = Дата(1,1,1,19,0,0);
	
	ВремяНачалаДня1 = Константы.КСУ_НачалоРабочегоДня.Получить();
	ВремяКонцаДня1 = Константы.КСУ_КонецРабочегоДня.Получить();
	Если ЗначениеЗаполнено(ВремяНачалаДня1) и ЗначениеЗаполнено(ВремяКонцаДня1) Тогда
		ВремяНачалаДня = ВремяНачалаДня1;
		ВремяКонцаДня = ВремяКонцаДня1;
	КонецЕсли;
	ВремяНачалаДня1 = ИА_НастройкиСПИ.ЗначениеНастройки(текюзер,ПланыВидовХарактеристик.ИА_НастройкиПользователей.НачалоРабочегоДня);
	ВремяКонцаДня1 = ИА_НастройкиСПИ.ЗначениеНастройки(текюзер,ПланыВидовХарактеристик.ИА_НастройкиПользователей.КонецРабочегоДня);
	Если ЗначениеЗаполнено(ВремяНачалаДня1) и ЗначениеЗаполнено(ВремяКонцаДня1) Тогда
		ВремяНачалаДня = ВремяНачалаДня1;
		ВремяКонцаДня = ВремяКонцаДня1;
	КонецЕсли;

	Возврат новый Структура("ВремяНачалаДня,ВремяКонцаДня",ВремяНачалаДня,ВремяКонцаДня);
КонецФункции

Функция ПолучитьДневнойПлан(недельный, ДатаНачала) Экспорт
	Запрос = Новый запрос;
	запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	ИА_ПланыДействий.Ссылка
	               |ИЗ
	               |	Справочник.ИА_ПланыДействий КАК ИА_ПланыДействий
	               |ГДЕ
	               |	ИА_ПланыДействий.Родитель = &Родитель
	               |	И ИА_ПланыДействий.ДатаНачала = &ДатаНачала
	               |	И ИА_ПланыДействий.ПометкаУдаления = ложь";
	Запрос.УстановитьПараметр("ДатаНачала", ДатаНачала);
	Запрос.УстановитьПараметр("Родитель", недельный);
	
	Выборка = запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() тогда
		возврат Выборка.Ссылка;
	Иначе
		возврат Неопределено;
	КонецЕсли;
КонецФункции

