Процедура ВыгрузитьЗадачиВГугл() Экспорт
	
	Запрос = Новый запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	КСУ_ВыгрузкаЗадачВГуглКалендарь.Задача,
	               |	КСУ_ВыгрузкаЗадачВГуглКалендарь.ид,
	               |	КСУ_ВыгрузкаЗадачВГуглКалендарь.ТребуетсяВыгрузка,
	               |	КСУ_ВыгрузкаЗадачВГуглКалендарь.Содержание,
	               |	КСУ_ВыгрузкаЗадачВГуглКалендарь.ВремяНачала,
	               |	КСУ_ВыгрузкаЗадачВГуглКалендарь.ВремяКонца,
	               |	КСУ_ВыгрузкаЗадачВГуглКалендарь.Дата,
	               |	КСУ_ВыгрузкаЗадачВГуглКалендарь.Пользователь КАК Пользователь,
	               |	КСУ_ДоступКGoogleКалендарю.Токен,
	               |	КСУ_ДоступКGoogleКалендарю.КалендарьВыгрузки
	               |ИЗ
	               |	РегистрСведений.КСУ_ВыгрузкаЗадачВГуглКалендарь КАК КСУ_ВыгрузкаЗадачВГуглКалендарь
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КСУ_ДоступКGoogleКалендарю КАК КСУ_ДоступКGoogleКалендарю
	               |		ПО КСУ_ВыгрузкаЗадачВГуглКалендарь.Пользователь = КСУ_ДоступКGoogleКалендарю.Пользователь
	               |			И (КСУ_ДоступКGoogleКалендарю.Токен <> """")
	               |			И (КСУ_ДоступКGoogleКалендарю.КалендарьВыгрузки <> """")
	               |ГДЕ
	               |	КСУ_ВыгрузкаЗадачВГуглКалендарь.ТребуетсяВыгрузка
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Пользователь";
	События = запрос.Выполнить().Выгрузить();
	Если События.Количество() = 0 Тогда
		возврат;
	КонецЕсли;
		
	Соединение = Новый HTTPСоединение("www.googleapis.com", ,,,,, Новый ЗащищенноеСоединениеOpenSSL());
	ЗапросHTTP = Новый HTTPЗапрос;
	ТекПользователь = Неопределено;
	Для каждого ТекСобытие из События цикл
		Если ТекСобытие.Пользователь <> ТекПользователь Тогда
			access_token = ИА_КСУОбщийСервер.ПолучитьAccessTokenИзRefresh(Соединение, ТекСобытие.токен);
			ЗапросHTTP.Заголовки["Content-Type"] = "application/json";
			ЗапросHTTP.Заголовки["Authorization"] = "Bearer " + access_token;
			ТекПользователь = ТекСобытие.Пользователь;			
		КонецЕсли;
		
		идКалендаря = ТекСобытие.КалендарьВыгрузки;
		идСобытия = ТекСобытие.ид;
		
		ЗапросHTTP.АдресРесурса = "calendar/v3/calendars/"+идКалендаря+"/events";
		ТелоЗапроса = 
		"{
		|		""summary"": ""%Заголовок"",	  
		|		""start"": {
		|			""dateTime"": ""%ДатаНачала""
		|			},
		|		""end"": {
		|			""dateTime"": ""%ДатаКонца""
		|			}
		|	}";
		                           
		ДатаНачала = ЗаписатьДатуJSON(ТекСобытие.Дата + ВремяВЧисло(ТекСобытие.ВремяНачала),ФорматДатыJSON.ISO, ВариантЗаписиДатыJSON.УниверсальнаяДата);
		ДатаКонца = ЗаписатьДатуJSON(ТекСобытие.Дата + ВремяВЧисло(ТекСобытие.ВремяКонца),ФорматДатыJSON.ISO, ВариантЗаписиДатыJSON.УниверсальнаяДата);
		
		ТелоЗапроса = СтрЗаменить(ТелоЗапроса,"%Заголовок",ТекСобытие.Содержание);
		ТелоЗапроса = СтрЗаменить(ТелоЗапроса,"%ДатаНачала",ДатаНачала);
		ТелоЗапроса = СтрЗаменить(ТелоЗапроса,"%ДатаКонца",ДатаКонца);
		
		ЗапросHTTP.УстановитьТелоИзСтроки(ТелоЗапроса);
			
		Если идСобытия = "" Тогда // новое событие, еще не выгружали в гугл			
			ОтветHTTP = Соединение.ОтправитьДляОбработки(ЗапросHTTP);					
		Иначе
			ЗапросHTTP.АдресРесурса = ЗапросHTTP.АдресРесурса + "/" + идСобытия;
			ОтветHTTP = Соединение.Изменить(ЗапросHTTP);					
		КонецЕсли;
		
		ТекстОтвета = ОтветHTTP.ПолучитьТелоКакСтроку();
		Если ОтветHTTP.КодСостояния = 200 Тогда		
			JSonИт = Новый ЧтениеJSON;
			JSonИт.УстановитьСтроку(ТекстОтвета);
			резИт = ПрочитатьJSON(JSonИт);							
			
			мен = РегистрыСведений.КСУ_ВыгрузкаЗадачВГуглКалендарь.СоздатьМенеджерЗаписи();
			мен.Задача = ТекСобытие.Задача;
			мен.Прочитать();
			мен.Задача = ТекСобытие.Задача;
			мен.ид = резИт.id;
			мен.ТребуетсяВыгрузка = ложь;
			мен.Записать();
		Иначе
			ЗаписьЖурналаРегистрации("КСУ ошибка гугл",,,,"Ошибка выгрузки списка событий "+ ТекстОтвета);
		КонецЕсли;
		
	КонецЦикла;
КонецПроцедуры

Процедура ЗаполнитьТаблицуПлановВЗапросе(Запрос, дНачала, дКонца, Пользователь = Неопределено) Экспорт
	Мен = Новый МенеджерВременныхТаблиц;
	Запрос.МенеджерВременныхТаблиц = мен;
	Если Пользователь = Неопределено ТОгда
		Запрос.УстановитьПараметр("ТекПользователь", ПараметрыСеанса.ТекущийПользователь);
	Иначе
		Запрос.УстановитьПараметр("ТекПользователь", Пользователь);
	КонецЕсли;
	Запрос.УстановитьПараметр("ДатаНачала", дНачала);
	Запрос.УстановитьПараметр("ДатаКонца", дКонца);
	
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	ИА_ПланыДействий.Ссылка КАК План,
	               |	ИА_ПланыДействий.ДатаНачала,
	               |	ИА_ПланыДействий.ДатаКонца
	               |ПОМЕСТИТЬ НедельныеПланы
	               |ИЗ
	               |	Справочник.ИА_ПланыДействий КАК ИА_ПланыДействий
	               |ГДЕ
	               |	ИА_ПланыДействий.ПометкаУдаления = ЛОЖЬ
	               |	И ИА_ПланыДействий.Ответственный = &ТекПользователь
	               |	И ИА_ПланыДействий.Родитель = ЗНАЧЕНИЕ(справочник.ИА_ПланыДействий.ПустаяСсылка)
	               |	И ИА_ПланыДействий.ДатаНачала <= &ДатаКонца
	               |	И ИА_ПланыДействий.ДатаКонца >= &ДатаНачала";
	Запрос.Выполнить();

КонецПроцедуры

Процедура ОбновитьДневныеПланы(ПланировщикДень, ДатаНачалаДневныхПланов,ДатаКонцаДневныхПланов, Пользователь = Неопределено) Экспорт
	Запрос = Новый Запрос;
	ЗаполнитьТаблицуПлановВЗапросе(Запрос,ДатаНачалаДневныхПланов,ДатаКонцаДневныхПланов, Пользователь);
		               
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	ИА_ПланыДействий.Ссылка КАК План,
	               |	ИА_ПланыДействий.ДатаНачала
	               |ПОМЕСТИТЬ ДневныеПланы
	               |ИЗ
	               |	Справочник.ИА_ПланыДействий КАК ИА_ПланыДействий
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ НедельныеПланы КАК НедельныеПланы
	               |		ПО ИА_ПланыДействий.Родитель = НедельныеПланы.План
	               |ГДЕ
	               |	ИА_ПланыДействий.ПометкаУдаления = ЛОЖЬ
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	ИА_ЗадачиПлана.Ссылка,
	               |	ИА_ЗадачиПлана.Группировка,
	               |	ИА_ЗадачиПлана.Содержание,
	               |	ИА_ЗадачиПлана.Продукт,
	               |	ИА_ЗадачиПлана.Выполнено,
	               |	ДневныеПланы.ДатаНачала КАК ДатаНачала,
	               |	ИА_ЗадачиПлана.ВремяНачала КАК ВремяНачала,
	               |	ИА_ЗадачиПлана.ВремяКонца,
	               |	ЛОЖЬ КАК Гугл,
				   |	ИА_ЗадачиПлана.СрокИсполнения
	               |ИЗ
	               |	Справочник.ИА_ЗадачиПлана КАК ИА_ЗадачиПлана
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ДневныеПланы КАК ДневныеПланы
	               |		ПО (ДневныеПланы.План = ИА_ЗадачиПлана.Владелец)
	               |ГДЕ
	               |	ИА_ЗадачиПлана.ПометкаУдаления = ЛОЖЬ
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	гугл.идСобытия,
	               |	ЗНАЧЕНИЕ(Перечисление.ИА_ТипыЗадачБП.Задачи),
	               |	гугл.Описание,
	               |	"""",
	               |	ЛОЖЬ,
	               |	НАЧАЛОПЕРИОДА(гугл.ДатаНачала, ДЕНЬ),
	               |	гугл.ДатаНачала,
	               |	гугл.ДатаКонца,
	               |	ИСТИНА,
				   |	&ПустаяДата
	               |ИЗ
	               |	РегистрСведений.КСУ_СобытияКалендаряGoogle КАК гугл
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ДневныеПланы КАК ДневныеПланы
	               |		ПО (НАЧАЛОПЕРИОДА(гугл.ДатаНачала, ДЕНЬ) = ДневныеПланы.ДатаНачала)
	               |ГДЕ
				   |	гугл.ДатаНачала МЕЖДУ &ДатаНачала И &ДатаКонца
	               |	И ДневныеПланы.План ЕСТЬ NULL
				   |	И гугл.Пользователь = &ТекПользователь
	               |	И гугл.БезВремени = ЛОЖЬ";
	
	Запрос.УстановитьПараметр("ПустаяДата", дата(1,1,1));
	ПланировщикДень.Элементы.Очистить();
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Выборка.гугл тогда
			ДатаНачала    = Выборка.ВремяНачала;
			ДатаОкончания = Выборка.ВремяКонца;
		Иначе
			ДатаНачала    = Выборка.ДатаНачала + ИА_Планы.ВремяВЧисло(Выборка.ВремяНачала);
			ДатаОкончания = Выборка.ДатаНачала + ИА_Планы.ВремяВЧисло(Выборка.ВремяКонца);
		КонецЕсли;
		НовыйЭлемент = ПланировщикДень.Элементы.Добавить(ДатаНачала, ДатаОкончания);
		НовыйЭлемент.Текст = Выборка.Содержание; 
		Если ЗначениеЗаполнено(Выборка.Продукт) Тогда
			НовыйЭлемент.Текст = НовыйЭлемент.Текст + ". Продукт: "+ Выборка.Продукт;
		КонецЕсли;
		
		НовыйЭлемент.Значение = выборка.ссылка;
		
		ПрименитьОформлениеСтроки(Выборка, НовыйЭлемент);		
	КонецЦикла;
	
КонецПроцедуры


Процедура ПрименитьОформлениеСтроки(Данные, элемент) Экспорт
	ЦветЗадача = Новый Цвет(237,245,248);
	ЦветСтратегЗадача = Новый Цвет(237,245,248);
	ЦветРегЗадача = Новый Цвет(237,245,248);	
	ЦветВыпЗадача = Новый Цвет(210,255,210);
	ЦветПросрЗадача = Новый Цвет(255,235,235);
	
	
	Если Данные.Группировка = Перечисления.ИА_ТипыЗадачБП.Регулярные Тогда
		элемент.ЦветФона = ЦветРегЗадача;
		элемент.Картинка = БиблиотекаКартинок.КСУ_РегулярнаяЗадача;
	ИначеЕсли Данные.гугл Тогда
		элемент.ЦветФона = ЦветЗадача;
		элемент.Картинка = БиблиотекаКартинок.КСУ_ЗадачаГугл;
	ИначеЕсли Данные.Группировка = Перечисления.ИА_ТипыЗадачБП.Стратегические Тогда
		элемент.ЦветФона = ЦветСтратегЗадача;
		элемент.Картинка = БиблиотекаКартинок.КСУ_СтратегическаяЗадача;
	ИначеЕсли Данные.Группировка = Перечисления.ИА_ТипыЗадачБП.Задачи или Данные.Группировка = Неопределено Тогда
		Если ЗначениеЗаполнено(Данные.СрокИсполнения) и Данные.СрокИсполнения < НачалоДня(ТекущаяДата()) Тогда
			элемент.ЦветФона = ЦветПросрЗадача;
		Иначе
			элемент.ЦветФона = ЦветЗадача;
		КонецЕсли;
		элемент.Картинка = БиблиотекаКартинок.КСУ_Задача;
	КонецЕсли;
	
	Если Данные.Выполнено Тогда
		элемент.ЦветФона = ЦветВыпЗадача;
	КонецЕсли;
КонецПроцедуры

Процедура УстановитьРабочееВремя(ПланировщикДень, Пользователь = Неопределено) Экспорт
	РабВр = ИА_Планы.ПолучитьРабочееВремя(Пользователь);
	ВремяНачалаДня = РабВр.ВремяНачалаДня;
	ВремяКонцаДня = РабВр.ВремяКонцаДня; 
	
	ПланировщикДень.ОтступСНачалаПереносаШкалыВремени = Час(ВремяНачалаДня);
	ПланировщикДень.ОтступСКонцаПереносаШкалыВремени = 24-Час(ВремяКонцаДня);
КонецПроцедуры