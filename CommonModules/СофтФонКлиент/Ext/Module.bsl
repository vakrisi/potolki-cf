Процедура ПослеЗаписиФайла(ДополнительныеПараметры) Экспорт
	
	Если ДополнительныеПараметры.Свойство("ЗапуститьПослеСкачивания") И ДополнительныеПараметры.ЗапуститьПослеСкачивания Тогда
		НачатьЗапускПриложения(Новый ОписаниеОповещения("ЗавершитьЗапускПриложения", ЭтотОбъект), ДополнительныеПараметры.ПолныйПутьКФайлу);
	Иначе
		ПоказатьОповещениеПользователя("Файл скачан", , ДополнительныеПараметры.ПолныйПутьКФайлу);
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗавершитьЗапускПриложения(КодВозврата, ДополнительныеПараметры) Экспорт
	//не удалять
	
	// "uis" - попеременное открытие ссылок или открытие скачанных файлов 
	Если ТипЗнч(ДополнительныеПараметры) = Тип("Структура") Тогда
		Если ДополнительныеПараметры.Свойство("ИДВАТС") И ДополнительныеПараметры.ИДВАТС = "uis" Тогда			
			Если ДополнительныеПараметры.НомерТекущейЗаписи < ДополнительныеПараметры.МассивЗаписей.Количество() Тогда
				НомерТекущейЗаписи = ДополнительныеПараметры.НомерТекущейЗаписи;
				ДополнительныеПараметры.НомерТекущейЗаписи = НомерТекущейЗаписи + 1;
				Если ДополнительныеПараметры.Свойство("ЗапуститьПослеСкачивания") Тогда 
					Если ДополнительныеПараметры.ЗапуститьПослеСкачивания Тогда
						НачатьЗапускПриложения(Новый ОписаниеОповещения("ЗавершитьЗапускПриложения", ЭтотОбъект, ДополнительныеПараметры), ДополнительныеПараметры.МассивЗаписей[НомерТекущейЗаписи], , ДополнительныеПараметры.ДождатьсяЗавершения);
					Иначе
						ПоказатьОповещениеПользователя("Файл скачан", , ДополнительныеПараметры.МассивЗаписей[НомерТекущейЗаписи]);
					КонецЕсли;
				Иначе
					НачатьЗапускПриложения(Новый ОписаниеОповещения("ЗавершитьЗапускПриложения", ЭтотОбъект, ДополнительныеПараметры), ДополнительныеПараметры.МассивЗаписей[НомерТекущейЗаписи], , ДополнительныеПараметры.ДождатьсяЗавершения);					
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

// функция нужна на клиенте при разных часовых поясах
