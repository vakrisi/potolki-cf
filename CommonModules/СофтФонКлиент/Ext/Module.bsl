Функция ДатаИзUT(UT) Экспорт
	
	// UnixTime -> Дата
	ДатаЧисло=0;
	Попытка
		ДатаЧисло=Число(UT);
	Исключение
	КонецПопытки;
	
	Возврат МестноеВремя(Дата('19700101000000')+ДатаЧисло);
	
КонецФункции

// Обработчик динамически подключаемой команды звонка
//
// Команда  - КомандаФормы - подключаемая команда формы.
// Источник - ТаблицаФормы, ДанныеФормыСтруктура - источник объектов печати (Форма.Объект, Форма.Элементы.Список)
Процедура ВыполнитьИсходящийЗвонок(Знач Команда, Знач Форма, Знач Источник) Экспорт
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ПозвонитьЗавершение", ЭтотОбъект);
	
	ПараметрыФормы = Новый Структура;
	Если ТипЗнч(Источник) = Тип("ДанныеФормыСтруктура") Тогда
		ПараметрыФормы.Вставить("СсылкаОбъект", Источник.Ссылка);        // с формы объекта
		Если Источник.Свойство("Контрагент") Тогда
			ПараметрыФормы.Вставить("СсылкаОбъект", Источник.Контрагент);	
		КонецЕсли;
	ИначеЕсли ТипЗнч(Источник) = Тип("ТаблицаФормы") Тогда
		ПараметрыФормы.Вставить("СсылкаОбъект", Источник.ТекущаяСтрока); // с формы списка
	ИначеЕсли ТипЗнч(Источник) = Тип("Строка") Тогда	
		ВыполнитьОбработкуОповещения(ОписаниеОповещения, Источник);		 // передан номер телефона
		Возврат;
	ИначеЕсли ТипЗнч(Источник) = Тип("СправочникСсылка.Сотрудники") Тогда	
		ПараметрыФормы.Вставить("СсылкаОбъект", Источник);		 		 // замерщик с формы заказ-договора
	Иначе
		Возврат;
	КонецЕсли;	
 	
	ОткрытьФорму("Обработка.ПанельСофтФонУниверсальная.Форма.ФормаВыбораКонтакта", ПараметрыФормы, ,,,, ОписаниеОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

Процедура ПозвонитьЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	НомерТелефона = Результат;
	Если ЗначениеЗаполнено(НомерТелефона) Тогда
		ПозвонитьПоНомеру(НомерТелефона); 
