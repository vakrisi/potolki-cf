Процедура ФормаЗадачи_ЗаполнитьРеквизитыБП(ОбъектЗадача, ТабБПРеквизиты) Экспорт
	#ЕСЛИ НЕ( Клиент или Сервер или ВнешнееСоединение ) Тогда
        ОбъектЗадача = Задачи.ИА_БПЗадачаНосителя.СоздатьЗадачу();
    #КОНЕЦЕСЛИ
    
    ТабБПРеквизиты.Очистить();
    Если ЗначениеЗаполнено(ОбъектЗадача.БизнесПроцесс)
        И ЗначениеЗаполнено(ОбъектЗадача.ИА_ТочкаБП)
        И ОбъектЗадача.ИА_ТочкаБП.ВыводимыеРеквизиты.Количество() > 0
        Тогда
    	Для каждого Стр Из ОбъектЗадача.ИА_ТочкаБП.ВыводимыеРеквизиты Цикл
        	НовСтрока = ТабБПРеквизиты.Добавить();
            ЗаполнитьЗначенияСвойств(НовСтрока, Стр);
            
            НайдСтрока = ОбъектЗадача.БизнесПроцесс.ИА_Реквизиты.Найти(НовСтрока.Реквизит, "Реквизит");
            Если НайдСтрока = Неопределено Тогда
            	НовСтрока.Значение = НовСтрока.Реквизит.ТипЗначения.ПривестиЗначение(Неопределено);
            Иначе
                НовСтрока.Значение = НайдСтрока.Значение;
            КонецЕсли; 
        КонецЦикла;
    КонецЕсли; 
    
КонецПроцедуры
 
Процедура ФормаЗадачи_ЗаписатьСвязанныеДанныеБП(ОбъектЗадача, ТабБПРеквизиты) Экспорт
	#ЕСЛИ НЕ( Клиент или Сервер или ВнешнееСоединение ) Тогда
        ОбъектЗадача = Задачи.ИА_БПЗадачаНосителя.СоздатьЗадачу();
    #КОНЕЦЕСЛИ
     
	Если ТабБПРеквизиты.Количество() > 0 Тогда
    	БП = ОбъектЗадача.БизнесПроцесс.ПолучитьОбъект();
        Для каждого Стр Из ТабБПРеквизиты Цикл
        	НайдСтрока = БП.ИА_Реквизиты.Найти(Стр.Реквизит, "Реквизит");
            Если НайдСтрока = Неопределено Тогда
                НайдСтрока = БП.ИА_Реквизиты.Добавить();
            	НайдСтрока.Реквизит = Стр.Реквизит;
            КонецЕсли; 
            НайдСтрока.Значение = Стр.Значение;
        КонецЦикла;  
        БП.Записать();
    КонецЕсли;     
КонецПроцедуры
 
