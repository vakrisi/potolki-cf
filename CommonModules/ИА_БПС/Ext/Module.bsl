Функция ОбщиеНастройкиБП() Экспорт
	Результат = Новый Структура;
    Результат.Вставить("КСУ",                       Ложь);
    Результат.Вставить("ТипыЗадач",                 Истина);
    Результат.Вставить("ДлительностьЗадач",         Истина);
    Результат.Вставить("ЭтоАдмин",                  РольДоступна("ПолныеПрава"));
    
    ИА_БПСПереопределяемый.ЗаполнитьОбщиеНастройкиБП(Результат);
    
    Возврат Результат;
КонецФункции
 

Процедура Обработчик_БП_ПередСтартом(Объект, Отказ) Экспорт
    Если НЕ ЗначениеЗаполнено(Объект.ИА_КартаМаршрутаБП)
        ИЛИ Объект.ИА_КартаМаршрутаБП.Карта.Получить() = Неопределено
        Тогда
    	Сообщение = Новый СообщениеПользователю;
        Сообщение.Текст = "Не задана карта маршрута БП, старт невозможен !";
        Сообщение.Сообщить();
        Отказ = Истина
    КонецЕсли;
    
    Менеджер = Обработки.ИА_БПМенеджер.Создать();
    Менеджер.Инициализировать(Объект.Ссылка, , Объект);
    Менеджер.БП_Старт(Отказ);
КонецПроцедуры

Функция ДобавитьКДате(Дата, Вариант, КоличествоДней) Экспорт
    Контекст = Новый Структура("Дата, Вариант, КоличествоДней"
    , Дата, Вариант, КоличествоДней);
    Результат = ИА_БПСПереопределяемый.ДобавитьКДате(Контекст);
    Если Результат <> Неопределено Тогда
    	Возврат Результат;
    КонецЕсли; 
    
    Если      Вариант = Перечисления.ИА_БПВариантыДней.Календарные Тогда
    	Результат = Дата + КоличествоДней * 86400;
    ИначеЕсли Вариант = Перечисления.ИА_БПВариантыДней.Рабочие Тогда
        
        СчетчикДат  = НачалоДня(Дата);
        СчетчикДней = 0;
        
        Пока СчетчикДней < Окр(КоличествоДней, 0) Цикл
            СчетчикДат  = СчетчикДат  + 86400;
            Если ДеньНедели(СчетчикДат) < 6 Тогда
                СчетчикДней = СчетчикДней + 1;	
            КонецЕсли; 
        КонецЦикла; 
        
        Результат = СчетчикДат;
    Иначе
        Результат = '00010101';
    КонецЕсли; 
    Возврат Результат;
КонецФункции

