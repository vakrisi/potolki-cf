Процедура ИА_БФБППриВыполненииЗадачПриВыполнении(Источник, Отказ) Экспорт
    #ЕСЛИ НЕ( Клиент или Сервер или ВнешнееСоединение ) Тогда
        Источник = Задачи.ИА_БПЗадачаНосителя.СоздатьЗадачу();
    #КОНЕЦЕСЛИ
     
	Если ИА_БФКС.РеквизитЕсть(Источник, "БизнесПроцесс")
		И ЗначениеЗаполнено(Источник.БизнесПроцесс)
        И ПравоДоступа("Изменение",Метаданные.БизнесПроцессы.ИА_БПНоситель)
        И ИА_БФКС.РеквизитЕсть(Источник, "ИА_ТочкаБП")
        И ИА_БФКС.РеквизитЕсть(Источник.БизнесПроцесс, "ИА_КартаМаршрутаБП")
        И ЗначениеЗаполнено(Источник.БизнесПроцесс.ИА_КартаМаршрутаБП)
        Тогда
        
        Если НЕ ИА_Защита_Общий.ЛицензияДоступна("НФ", Отказ) Тогда Возврат КонецЕсли; 
        
        ТочкаБП = Источник.ИА_ТочкаБП;
        менТипы = Перечисления.ИА_БПТипыТочекМаршрута;
        
        ПропуститьОбработку = Источник.ИА_ИсключенаИзОбработки;
        Контекст = Новый Структура("Задача, БП, Отказ, ПропуститьОбработку"
        , Источник, Источник.БизнесПроцесс, Отказ, ПропуститьОбработку); 
        ИА_БПСПереопределяемый.Задачи_ПередВыполнением(Контекст);
        
        //{ Обработка влож. БП
        ПрограммноеЗавершение = Ложь;
        Если Источник.ДополнительныеСвойства.Свойство("ИА_ПрограммноеЗавершение") Тогда
        	ПрограммноеЗавершение = Источник.ДополнительныеСвойства.ИА_ПрограммноеЗавершение;
        КонецЕсли; 
        
        Если Источник.ИА_ТочкаБП.Тип = менТипы.ВложенныйБизнесПроцесс
            И НЕ ПрограммноеЗавершение
            Тогда
            
            Список = ПолучитьСписокПодчиненныхБП(Источник.Ссылка, Истина);
            
            ИА_БФКС.СообщениеОбОшибке(ИА_БФКС.Стр_ПодставитьПараметрыВСтроку(
            "Задача ""%1"" завершится автоматически при выполнении подчиненного бизнес-процесса ""%2"" !"
            ,Источник.Ссылка, ИА_БФКС.Массив_Представление(Список))
            ,  Контекст.Отказ); 
        КонецЕсли; 
        //}
        
        Если Контекст.ПропуститьОбработку ИЛИ Контекст.Отказ Тогда
            Отказ = Контекст.Отказ;
        	Возврат
        КонецЕсли; 
        
        СписокКонтролируемыхРеквизитов = ИА_БФС.ТЗ_ФильтрПоОтбору(ТочкаБП.ВыводимыеРеквизиты
        , Новый Структура("КонтролироватьЗаполнение", Истина)).ВыгрузитьКолонку("Реквизит");
        Если СписокКонтролируемыхРеквизитов.Количество() > 0 Тогда
            ТабРеквизиты = БизнесПроцессы.ИА_БПНоситель.ПолучитьРеквизиты(Источник.БизнесПроцесс
            , СписокКонтролируемыхРеквизитов); 
            ТекстОшибки = "";
            Для каждого Стр Из ТабРеквизиты Цикл
            	Если НЕ ЗначениеЗаполнено(Стр.Значение) Тогда
                	ТекстОшибки = ТекстОшибки + Символы.ПС + " — " + Стр.Реквизит;
                КонецЕсли; 
            КонецЦикла;  
            Если ЗначениеЗаполнено(ТекстОшибки) Тогда
            	ТекстОшибки = "Не заполнены реквизиты бизнес-процесса:" + ТекстОшибки;
                ИА_БФКС.СообщениеОбОшибке(ТекстОшибки, Контекст.Отказ); 
            КонецЕсли; 
            
            Если Контекст.ПропуститьОбработку ИЛИ Контекст.Отказ Тогда
                Отказ = Контекст.Отказ;
                Возврат
            КонецЕсли; 
        КонецЕсли; 
        
        
        Если ТочкаБП.Тип = менТипы.Действие Тогда
            Обработчик = Обработчики_Получить(Источник, Перечисления.ИА_БПСобытияТочекБП.Действие_ПриВыполнении);
            Обработчики_Выполнить(Обработчик, Контекст,,"Отказ", Истина);
        КонецЕсли; 
        
        Если Контекст.ПропуститьОбработку ИЛИ Контекст.Отказ Тогда
            Отказ = Контекст.Отказ;
            Возврат
        КонецЕсли; 
        
        
        // Наш клиент!
        БП = Источник.БизнесПроцесс;
        Точка = Источник.ИА_ТочкаБП;
        
        Если НЕ ЗначениеЗаполнено(Точка) Тогда
            Сообщение = Новый СообщениеПользователю;
            Сообщение.Текст = "Данные задачи выполняются автоматически ! " + Источник;
            Сообщение.Сообщить(); 
            Отказ = Истина;
        ИначеЕсли Точка.Тип = менТипы.Условие
            И НЕ ЗначениеЗаполнено(Источник.ИА_ВариантУсловияБП)
            Тогда
            Сообщение = Новый СообщениеПользователю;
            Сообщение.Текст = "Не указан вариант условия в задаче! " + Источник;
            Сообщение.Сообщить(); 
            Отказ = Истина;
        Иначе
            // Надо создать следующие задачи!
            Источник.ИА_БПДатаЗавершения = ТекущаяДата();
            
            Обр = Обработки.ИА_БПМенеджер.Создать();
            Обр.Инициализировать(Источник.БизнесПроцесс);
            Обр.Задачи_Выполнить(Источник, Отказ);
        КонецЕсли; 
    КонецЕсли; 
КонецПроцедуры

Процедура ИА_БФБППередЗаписьюБППередЗаписью(Источник, Отказ) Экспорт
	#ЕСЛИ НЕ( Клиент или Сервер или ВнешнееСоединение ) Тогда
	    Источник = БизнесПроцессы.ИА_БПНоситель.СоздатьБизнесПроцесс();
	#КОНЕЦЕСЛИ
	
	Если Источник.ОбменДанными.Загрузка Тогда Возврат КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Источник.ИА_БПДатаЗавершения)
		И Источник.Завершен И Источник.Завершен <> Источник.Ссылка.Завершен
		Тогда // Теперь он завершен
		Источник.ИА_БПДатаЗавершения = ТекущаяДата();
	КонецЕсли;  
	
	Если НЕ Источник.Завершен Тогда
		Источник.ИА_БПДатаЗавершения = Неопределено;
	КонецЕсли; 
	
	Если НЕ ЗначениеЗаполнено(Источник.ИА_Ответственный) Тогда
		Источник.ИА_Ответственный = ИА_БПСПереопределяемый.ТекущийПользователь();
	КонецЕсли;
КонецПроцедуры
 