Функция   Обработчики_ПолучитьСписокДоступныхВариантовДляТипаТочки(Тип, Событие = Неопределено) Экспорт
    #ЕСЛИ НЕ( Клиент или Сервер или ВнешнееСоединение ) Тогда
        Тип = Перечисления.ИА_БПТипыТочекМаршрута.ПустаяСсылка();
    #КОНЕЦЕСЛИ
    Результат = Новый Массив;
    
    Если Тип = Перечисления.ИА_БПТипыТочекМаршрута.Условие Тогда
        Если Событие = Перечисления.ИА_БПСобытияТочекБП.Условие_ПроверкаУсловия Тогда
            Результат.Добавить(Перечисления.ИА_БПВариантыОбработчиков.Интерактивно);
            Результат.Добавить(Перечисления.ИА_БПВариантыОбработчиков.КонструкторУсловия);
            Результат.Добавить(Перечисления.ИА_БПВариантыОбработчиков.ПрограммныйОбработчик);
        ИначеЕсли Событие = Перечисления.ИА_БПСобытияТочекБП.ФормированиеНаименования
            ИЛИ Событие = Перечисления.ИА_БПСобытияТочекБП.ФормированиеСодержания
			ИЛИ Событие = Перечисления.ИА_БПСобытияТочекБП.УстановкаОтветственного
            Тогда
            Результат.Добавить(Перечисления.ИА_БПВариантыОбработчиков.Нет);
            Результат.Добавить(Перечисления.ИА_БПВариантыОбработчиков.КонструкторУсловия);
            Результат.Добавить(Перечисления.ИА_БПВариантыОбработчиков.ПрограммныйОбработчик);
        КонецЕсли; 
    ИначеЕсли Тип = Перечисления.ИА_БПТипыТочекМаршрута.Действие
        ИЛИ Тип = Перечисления.ИА_БПТипыТочекМаршрута.ВложенныйБизнесПроцесс
        Тогда
        Если Событие = Перечисления.ИА_БПСобытияТочекБП.Действие_ПриВыполнении
            ИЛИ Событие = Перечисления.ИА_БПСобытияТочекБП.ФормированиеНаименования
            ИЛИ Событие = Перечисления.ИА_БПСобытияТочекБП.ФормированиеСодержания
            ИЛИ Событие = Перечисления.ИА_БПСобытияТочекБП.УстановкаОтветственного
            Тогда
            Результат.Добавить(Перечисления.ИА_БПВариантыОбработчиков.Нет);
            Результат.Добавить(Перечисления.ИА_БПВариантыОбработчиков.КонструкторУсловия);
            Результат.Добавить(Перечисления.ИА_БПВариантыОбработчиков.ПрограммныйОбработчик);
        КонецЕсли;
    //ИначеЕсли Тип = Перечисления.ИА_БПТипыТочекМаршрута.ВложенныйБизнесПроцесс Тогда
    КонецЕсли; 
    
    Возврат Результат;
КонецФункции

Функция   Обработчики_Получить(Объект, СобытиеОбработки) Экспорт
    Результат = Новый Структура("Событие, Код, Обработчик, ХранилищеДанных"
    , СобытиеОбработки, "", Перечисления.ИА_БПВариантыОбработчиков.ПустаяСсылка());
                                                
    ТипОбъекта = ТипЗнч(Объект);
	Если ТипОбъекта = Тип("СправочникСсылка.ИА_БПТочкиМаршрута") Тогда
        ТочкаБП = Объект;
    ИначеЕсли ИА_БФКС.РеквизитЕсть(Объект, "ИА_ТочкаБП") Тогда	
        ТочкаБП = Объект.ИА_ТочкаБП;
    КонецЕсли;
    #ЕСЛИ НЕ( Клиент или Сервер или ВнешнееСоединение ) Тогда
        ТочкаБП = Справочники.ИА_БПТочкиМаршрута.ПустаяСсылка();
    #КОНЕЦЕСЛИ
    
    НайдСтрока = ТочкаБП.Обработчики.Найти(СобытиеОбработки, "Событие");
    Если НайдСтрока <> Неопределено Тогда
        ЗаполнитьЗначенияСвойств(Результат, НайдСтрока);
    КонецЕсли; 
    Возврат Результат;
КонецФункции
 
Процедура Обработчики_Выполнить(Обработчик, Контекст, ПриОшибкеВызыватьИсключение = Истина
    , ПолеДляСохраненияРезультата = "", ПолеРезультатаЭтоОтказПроверка = Ложь
    , ИнвертироватьПолеРезультата = Ложь) Экспорт
    мен = Перечисления.ИА_БПВариантыОбработчиков;
    Если Обработчик.Обработчик = мен.ПрограммныйОбработчик Тогда
		Попытка
			УстановитьБезопасныйРежим(Истина);
        	Выполнить(Обработчик.Код);
			УстановитьБезопасныйРежим(Ложь);
        Исключение
            Ошибка = ОписаниеОшибки();
            ТекстСообщения =  "При выполнении обработчика """ + Обработчик.Событие + """ возникла ошибка!" + Символы.ПС
            + "  Описание: " + Ошибка + Символы.ПС
            + "  Контекст: " + ИА_БФКС.Струк_Представление(Контекст)  + Символы.ПС
            + "  Код обработчика: " + Обработчик.Код;
            
            СообщениеВЖурнал("ОшибкаОбработчика", ТекстСообщения);
            
            Если ПриОшибкеВызыватьИсключение Тогда
            	ВызватьИсключение ТекстСообщения;
            КонецЕсли; 
        КонецПопытки; 
    ИначеЕсли Обработчик.Обработчик = мен.КонструкторУсловия Тогда        
        Опции = Обработчик.ХранилищеДанных.Получить();
        
        Если Обработчик.Событие = Перечисления.ИА_БПСобытияТочекБП.Действие_ПриВыполнении
            ИЛИ Обработчик.Событие = Перечисления.ИА_БПСобытияТочекБП.Условие_ПроверкаУсловия
            Тогда
            
            Если Опции <> Неопределено Тогда
                СКД = Справочники.ИА_БПТочкиМаршрута.ПолучитьМакет("СКДДляОбработчиков");
                Данные = Новый Структура("СКД, Настройки, СообщениеЕслиУсловиеНеВыполнено"
                ,СКД, Неопределено, "Условие выполнения задачи не выполнено!");
                ЗаполнитьЗначенияСвойств(Данные, Опции);
                
                //{ 2015/10/13
                Если Контекст.Задача <> Неопределено И ЗначениеЗаполнено(Контекст.Задача.Ссылка) Тогда
                    ПараметрыДанных = Новый Структура("Задача, ВладелецРеквизитов"
                    , Контекст.Задача.Ссылка, Контекст.Задача.ИА_ТочкаБП.Владелец.МаршрутЗадач);
                Иначе
                    ПараметрыДанных = Новый Структура("Задача, ВладелецРеквизитов"
                    , Задачи[ПолучитьИмяЗадачи()].ПустаяСсылка(), Контекст.БП.ИА_МаршрутЗадачБП);
                КонецЕсли;
                //} 2015/10/13
                Параметры = Новый Структура("ПараметрыДанных", ПараметрыДанных);
                
                Таб = ИА_БФС.ОтборСКД_Выполнить(Данные, Параметры);
                Контекст[ПолеДляСохраненияРезультата] = Таб.Количество() = 0;
            Иначе // Если почему-то нет настроек СКД
                Контекст[ПолеДляСохраненияРезультата] = Ложь;
            КонецЕсли; 
            
        ИначеЕсли Обработчик.Событие = Перечисления.ИА_БПСобытияТочекБП.ФормированиеНаименования
            ИЛИ Обработчик.Событие = Перечисления.ИА_БПСобытияТочекБП.ФормированиеСодержания
            ИЛИ Обработчик.Событие = Перечисления.ИА_БПСобытияТочекБП.УстановкаОтветственного
            Тогда	
            Если Опции <> Неопределено Тогда
                Данные = ИА_БФС.РедакторФормул_Выполнить(Опции, Контекст);
                Контекст.Результат = Данные.Результат;
            КонецЕсли;
        КонецЕсли; 
        
        Если ИнвертироватьПолеРезультата Тогда
            Контекст[ПолеДляСохраненияРезультата] = Не Контекст[ПолеДляСохраненияРезультата];
        КонецЕсли; 
        
        Если ПолеРезультатаЭтоОтказПроверка И Контекст[ПолеДляСохраненияРезультата] Тогда
            Сообщение = Новый СообщениеПользователю;
            Сообщение.Текст = Данные.СообщениеЕслиУсловиеНеВыполнено;
            Сообщение.Сообщить(); 
        КонецЕсли; 
    КонецЕсли; 		
КонецПроцедуры

Функция   Обработчики_ПолучитьСправку(Событие) Экспорт
	мен = Перечисления.ИА_БПСобытияТочекБП;
    
    Если Событие = мен.Действие_ПриВыполнении Тогда
    	Результат = 
        "В обработчике """ + Событие + """ доступна структура ""Контекст"":
        |  - БП - ссылка на выполняемый бизнес-процесс;
        |  - Задача - ""ЗадачаОбъект"" - выполняемая задача;
        |  - Отказ  - будет передано в системную переменную ""Отказ"";
        |  - ПропуститьОбработку - выполнение данной задачи не будет никаким специальным образом обработано";
    ИначеЕсли Событие = мен.Условие_ПроверкаУсловия Тогда
    	Результат = 
        "В обработчике """ + Событие + """ доступна структура ""Контекст"":
        |  - БП - ссылка на выполняемый бизнес-процесс;
        |  - Задача - ""ЗадачаОбъект"" - задача, выполнение которой вызвало переход в блок условия;
        |  - Точка - ссылка на точку маршрута, условие которой сейчас проверяется;
        |  - Результат  - должно быть возвращено через эту переменную Истина или Ложь, соответственно для веток условия ""Да"" и ""Нет""."
        +" По умолчанию равно Неопределено и при данном значении выполнение условия не будет произведено, породившая задача останется невыполненной ";
    ИначеЕсли Событие = мен.ФормированиеНаименования ИЛИ Событие = мен.ФормированиеСодержания Тогда
    	Результат = 
        "В обработчике """ + Событие + """ доступна структура ""Контекст"":
        |  - БП - ссылка на выполняемый бизнес-процесс;
        |  - Задача - задача-объект: текущая создаваемая задача;
        |  - ТабРеквизиты - содержит доп.реквизиты: массив структур с полями ""Реквизит"" и ""Значение"";
        |  - Результат  - должна быть возвращена строка";
    ИначеЕсли Событие = мен.УстановкаОтветственного Тогда
    	Результат = 
        "В обработчике """ + Событие + """ доступна структура ""Контекст"":
        |  - БП - ссылка на выполняемый бизнес-процесс;
        |  - Задача - задача-объект: текущая создаваемая задача;
        |  - ТабРеквизиты - содержит доп.реквизиты: массив структур с полями ""Реквизит"" и ""Значение"";
        |  - Результат  - возвращаемое значение";
    Иначе
        Результат = "<<Справки нет!!!>>";
    КонецЕсли; 
    
    Возврат Результат;
КонецФункции

