Функция ПолучитьИнформациюОЗадачахПоИмениТочки(БП, ИмяТочки, ВключатьИсключенные = Ложь) Экспорт
    Обр = Обработки.ИА_БПМенеджер.СоздатьПоБизнесПроцессу(БП);
	Точка = Обр.Точки_ПолучитьПоИмениТочки(ИмяТочки);
    Таб = Обр.Задачи_ПолучитьЗадачиПоИмениТочки(ИмяТочки);
    
    ВложенныеБП = Новый Массив;
    ТипТочки = Обр.Точки_ПолучитьИнформацию(Точка).Тип;
    Если ТипТочки = Перечисления.ИА_БПТипыТочекМаршрута.ВложенныйБизнесПроцесс Тогда
        Для каждого Стр Из Таб Цикл
        	ВложенныеБП.Добавить(ИА_БПС.ПолучитьПодчиненныйБП(Стр.Ссылка));
        КонецЦикла;  
    КонецЕсли; 
    
    Результат = Новый Структура("СписокЗадач, Точка, Тип, ВложенныеБП"
    , Таб.ВыгрузитьКолонку("Ссылка")
    , Точка
    , ТипТочки
    , ВложенныеБП);
    Возврат Результат;
КонецФункции

Процедура СообщениеВЖурнал(ИмяСобытия, ТекстСообщения, Уровень=Неопределено) Экспорт
    Если Уровень = Неопределено Тогда
    	Уровень = УровеньЖурналаРегистрации.Ошибка;
    КонецЕсли; 		
    
    ЗаписьЖурналаРегистрации("БП." + ИмяСобытия, Уровень,,, ТекстСообщения);
КонецПроцедуры

Функция СформироватьТаблицуПеременных(МаршрутЗадач) Экспорт
    ДЗ = Новый ДеревоЗначений;
    ДЗ.Колонки.Добавить("Представление");
    ДЗ.Колонки.Добавить("ПутьДанных");
    ДЗ.Колонки.Добавить("ОписаниеТипа");
    ДЗ.Колонки.Добавить("Данные");
    ДЗ.Колонки.Добавить("Вид");
    
    Стр = ДЗ.Строки.Добавить();
    Стр.Представление   = "БизнесПроцесс";
    Стр.ПутьДанных      = "Контекст.БП";
    Стр.ОписаниеТипа    = Новый ОписаниеТипов("БизнесПроцессСсылка.ИА_БПНоситель");
    Стр.Строки.Добавить().Представление = "стаб";
    
    Стр = ДЗ.Строки.Добавить();
    Стр.Представление   = "Задача";
    Стр.ПутьДанных      = "Контекст.Задача";
    Стр.ОписаниеТипа    = Новый ОписаниеТипов("ЗадачаСсылка." + ИА_БПС.ПолучитьИмяЗадачи());
    Стр.Строки.Добавить().Представление = "стаб";
    
    Ветка = ДЗ.Строки.Добавить();
    Ветка.Представление = "Доп. реквизиты";
    Ветка.Вид = 1;
    
    Таб = Справочники.ИА_БПМаршрутЗадач.ПолучитьТаблицуДопРеквизитов(МаршрутЗадач);
    Для каждого стр Из Таб Цикл
        ДочВетка = Ветка.Строки.Добавить();
        ДочВетка.Представление   = Стр.Наименование;
        ДочВетка.ПутьДанных      = "Контекст.ДопРеквизиты[""" + Стр.Реквизит.УникальныйИдентификатор() + """]";
        ДочВетка.ОписаниеТипа    = Стр.Реквизит.ТипЗначения;
        
        Таб  = ИА_БФС.Типы_ОписаниеТипов2ТаблицаСтроковыхТипов(Стр.Реквизит.ТипЗначения);
        ЭтоСсылочныйТип = ИА_БФС.ТЗ_ФильтрПоОтбору(Таб, Новый Структура("Ссылочный", Истина)).Количество() > 0;
        Если ЭтоСсылочныйТип Тогда
            ДочВетка.Строки.Добавить().Представление = "стаб";
        КонецЕсли; 
    КонецЦикла; 
    
    Переменные = ИА_БФС.ДЗ2ДЗФ(ДЗ);
    Возврат Переменные;
КонецФункции

Функция СформироватьКонтекстВыполненияДляЗадачи(Задача) Экспорт
    #ЕСЛИ НЕ( Клиент или Сервер или ВнешнееСоединение ) Тогда
        Задача = задачи.ИА_БПЗадачаНосителя.СоздатьЗадачу();
    #КОНЕЦЕСЛИ
    БизнесПроцесс  = Задача.БизнесПроцесс;
    
    Контекст = Новый Структура;
    Контекст.Вставить("БП", БизнесПроцесс);
    Контекст.Вставить("Задача", Задача);
    
    ТабДР = Справочники.ИА_БПМаршрутЗадач.ПолучитьТаблицуДопРеквизитов(БизнесПроцесс.ИА_МаршрутЗадачБП);
    ТабРеквизитов = Новый Массив;
    
    ДопРеквизиты = Новый Соответствие;
    Для каждого стр Из ТабДР Цикл
        НайдСтрока = БизнесПроцесс.ИА_Реквизиты.Найти(Стр.Реквизит, "Реквизит");
        
        Если НайдСтрока <> Неопределено Тогда
            Значение = НайдСтрока.Значение;
        Иначе
            Значение = Стр.Реквизит.ЗначениеПоУмолчанию;
        КонецЕсли; 
        ДопРеквизиты.Вставить(""+Стр.Реквизит.УникальныйИдентификатор(), Значение);
        
        ТабРеквизитов.Добавить(Новый Структура("Реквизит, Значение", Стр.Реквизит, Значение));
    КонецЦикла; 
    
    Контекст.Вставить("ДопРеквизиты", ДопРеквизиты);
    Контекст.Вставить("ТабРеквизиты", ТабРеквизитов);
    
    Возврат Контекст;
КонецФункции

Функция ПолучитьСписокПодчиненныхБП(ВедущаяЗадача, ТолькоНезавершенные = Ложь) Экспорт
    Таб = ИА_БФС.Запрос_ВыполнитьВТЗ(
    //#Область ТекстЗапроса
    "ВЫБРАТЬ  разрешенные
    |   ИА_БПНоситель.Ссылка
    |ИЗ
    |   БизнесПроцесс.ИА_БПНоситель КАК ИА_БПНоситель
    |ГДЕ
    |   ИА_БПНоситель.ВедущаяЗадача = &ВедущаяЗадача
    |   И НЕ ИА_БПНоситель.ПометкаУдаления
    |   И ИА_БПНоситель.Стартован
    |   И (НЕ &ТолькоНезавершенные
    |           ИЛИ НЕ ИА_БПНоситель.Завершен)"
    //#КонецОбласти 
    , Новый Структура("ВедущаяЗадача, ТолькоНезавершенные", ВедущаяЗадача, ТолькоНезавершенные)); 
    
    Результат = Таб.ВыгрузитьКолонку("Ссылка");
    Возврат Результат
КонецФункции

Функция ПолучитьРодительскиеБП(БП) Экспорт
	#ЕСЛИ НЕ( Клиент или Сервер или ВнешнееСоединение ) Тогда
        БП = БизнесПроцессы.ИА_БПНоситель.ПустаяСсылка();
    #КОНЕЦЕСЛИ
    
    Результат = Новый Массив;
    Если ЗначениеЗаполнено(БП) Тогда
        ТекЗадача = БП.ВедущаяЗадача;
        Пока ЗначениеЗаполнено(ТекЗадача) Цикл
            ИА_БФКС.Массив_ДобавитьЕслиНет(Результат, ТекЗадача.БизнесПроцесс);
            ТекЗадача = ТекЗадача.БизнесПроцесс.ВедущаяЗадача;
        КонецЦикла;     
    КонецЕсли; 
    
    Возврат Результат;
КонецФункции

Функция ПолучитьПодчиненныйБП(ВедущаяЗадача) Экспорт
    #ЕСЛИ НЕ( Клиент или Сервер или ВнешнееСоединение ) Тогда
        ВедущаяЗадача = Задачи.ИА_БПЗадачаНосителя.ПустаяСсылка();
    #КОНЕЦЕСЛИ
    Результат = БизнесПроцессы.ИА_БПНоситель.ПустаяСсылка();
    Если ВедущаяЗадача.ИА_ТочкаБП.Тип = Перечисления.ИА_БПТипыТочекМаршрута.ВложенныйБизнесПроцесс
        И ЗначениеЗаполнено(ВедущаяЗадача)
        Тогда
        Результат = ИА_БФС.Запрос_ВыполнитьСкалярный(
        "ВЫБРАТЬ  разрешенные
        |   ИА_БПНоситель.Ссылка Результат
        |ИЗ
        |   БизнесПроцесс.ИА_БПНоситель КАК ИА_БПНоситель
        |ГДЕ
        |   НЕ ИА_БПНоситель.ПометкаУдаления
        |   И ИА_БПНоситель.ВедущаяЗадача = &ВедущаяЗадача"
        , Новый Структура("ВедущаяЗадача", ВедущаяЗадача));
    КонецЕсли; 
    Возврат Результат;
КонецФункции

Функция ПроверкаФормулыДляУстановкиОтветственного(Формула) Экспорт
    Отказ = Ложь;
    Если Формула.СоставФормулы.Количество() <> 1 Тогда        
    	ИА_БФКС.СообщениеОбОшибке("Формула должна содержать одно поле", Отказ); 
    Иначе
        Стр = Формула.СоставФормулы[0];
        Попытка
            Отказ = НЕ Стр.ОписаниеТипа.СодержитТип(Тип("СправочникСсылка.Пользователи"));
            ЕстьОргСхема = Метаданные.Справочники.Найти("ОргСхема") <> Неопределено;
            Если Отказ И ЕстьОргСхема Тогда
                Отказ = НЕ Стр.ОписаниеТипа.СодержитТип(Тип("СправочникСсылка.ОргСхема"));
            КонецЕсли; 
            
            Если Отказ Тогда
            	ИА_БФКС.СообщениеОбОшибке("Формула должна содержать ссылку на справочник пользователей "
                + ?(ЕстьОргСхема, " или на орг.схему","") + "!"); 
            КонецЕсли; 
        Исключение
            ТекстОшибки = ОписаниеОшибки();
            ИА_БФКС.СообщениеОбОшибке("Состав формулы не содержит описания типов! " + ТекстОшибки, Отказ); 
        КонецПопытки; 
    КонецЕсли;
    
    Возврат НЕ Отказ;
КонецФункции

Функция ПроверкаФормулыДляУстановкиЗначенияРеквизита(Формула) Экспорт
    Отказ = Ложь;
