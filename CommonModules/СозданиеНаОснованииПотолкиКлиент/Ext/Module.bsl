Процедура ВозвратПродукцииСоздатьНаОснованииЗаказаПокупателя(ЗаказСсылка, ПараметрыВыполнения) Экспорт
	
	// возврат на основании одного заказа	
	ПараметрыОткрытия = Новый Структура;
	ДопПараметры = СозданиеНаОснованииПотолкиВызовСервера.ПодготовитьСписокТоваровДляВыбораКВозвратуПродукции(ЗаказСсылка);
	ПараметрыОткрытия.Вставить("СписокПотолков", ДопПараметры.СписокПотолков);
	ПараметрыОткрытия.Вставить("СписокУслуг",    ДопПараметры.СписокУслуг);

	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ДокументОснование", ЗаказСсылка);
	ДополнительныеПараметры.Вставить("ПараметрыВыполнения", ПараметрыВыполнения);
	ОписаниеОповещения = Новый ОписаниеОповещения("ВозвратПродукцииСоздатьНаОснованииЗаказаПокупателяЗавершение", ЭтотОбъект, ДополнительныеПараметры);
	
	ОткрытьФорму("Документ.ВозвратПродукции.Форма.ФормаВыбораПотолковКВозврату", ПараметрыОткрытия,,,ВариантОткрытияОкна.ОтдельноеОкно,,ОписаниеОповещения);
	
КонецПроцедуры

Процедура ВозвратПродукцииСоздатьНаОснованииЗаказаПокупателяЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если НЕ ТипЗнч(Результат) = Тип("Массив") Тогда
		Возврат;
	КонецЕсли;
		
	Если Результат.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ДополнительныеПараметрыОткрытия = Новый Структура;
	ДополнительныеПараметрыОткрытия.Вставить("ДокументОснование", ДополнительныеПараметры.ДокументОснование);
	ДополнительныеПараметрыОткрытия.Вставить("МассивТоваров", Результат);
	
	СоздатьНаОснованииМножественныйВыбор("Документ.ВозвратПродукции.ФормаОбъекта", ДополнительныеПараметры.ДокументОснование, ДополнительныеПараметры.ПараметрыВыполнения, ДополнительныеПараметрыОткрытия);
	
КонецПроцедуры

Процедура ЗаказНаПроизводствоСоздатьНаОснованииЗаказаПокупателя(МассивСсылок, ПараметрыВыполнения) Экспорт
	
	СозданиеНаОснованииПотолкиВызовСервера.ПроверитьВозможностьВводаНаОснованииЗаказа(МассивСсылок, "ЗаказНаПроизводство");
	
	МассивПотолков = Новый Массив;
	МассивУслуг = Новый Массив;
	МассивМатериалов = Новый Массив;
	
	Для каждого ЗаказСсылка из МассивСсылок Цикл		
		ПараметрыСписокТоваров = СозданиеНаОснованииПотолкиВызовСервера.ПодготовитьСписокТоваровДляВыбораПользователемКПроизводству(ЗаказСсылка);	
		Для каждого ЭлементМассива из ПараметрыСписокТоваров.СписокПотолков Цикл
			МассивПотолков.Добавить(ЭлементМассива);
		КонецЦикла;
		Для каждого ЭлементМассива из ПараметрыСписокТоваров.СписокУслуг Цикл
			МассивУслуг.Добавить(ЭлементМассива);
		КонецЦикла;
		Для каждого ЭлементМассива из ПараметрыСписокТоваров.СписокМатериалов Цикл
			МассивМатериалов.Добавить(ЭлементМассива);
		КонецЦикла;
	КонецЦикла;
		
	ПараметрыФормыПроизводства = Новый Структура;
	ПараметрыФормыПроизводства.Вставить("СписокПотолков",   		МассивПотолков);		
	ПараметрыФормыПроизводства.Вставить("СписокУслуг",      		МассивУслуг);
	ПараметрыФормыПроизводства.Вставить("СписокМатериалов", 		МассивМатериалов);
	ПараметрыФормыПроизводства.Вставить("НастройкаИнтеркампани", 	ПараметрыСписокТоваров.НастройкаИнтеркампани);
		
	ДопПараметры = Новый Структура("МассивЗаказов", МассивСсылок);
	ОбщегоНазначенияКлиентСервер.ДополнитьСтруктуру(ДопПараметры, ПараметрыВыполнения);
	ОповещениеОЗакрытии = Новый ОписаниеОповещения("ЗаказНаПроизводствоСоздатьНаОснованииЗаказаПокупателяЗавершение", ЭтотОбъект, ДопПараметры);
		
	ОткрытьФорму("Документ.ЗаказПокупателя.Форма.ФормаЗаказаНаПроизводство",ПараметрыФормыПроизводства,,,ВариантОткрытияОкна.ОтдельноеОкно,,ОповещениеОЗакрытии);
	
КонецПроцедуры

