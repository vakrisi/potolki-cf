Процедура ЗаказПокупателяСоздатьНаОснованииДокументаРозницы(ДокументСсылка, ПараметрыВыполнения) Экспорт
	
	ЭтоЗаказДоговор = ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.ЗаказДоговор");
	
	РеквизитыДокумента = ОбщийМодульВызовСервера.ЗначенияРеквизитовОбъекта(ДокументСсылка, "Организация, Подразделение, ТочкаПродаж");
	
	НастройкаИнтеркампани = ОбщийМодуль.ПолучитьНастройкуИнтеркампани(РеквизитыДокумента.ТочкаПродаж, РеквизитыДокумента.Подразделение, РеквизитыДокумента.Организация);
	Если НастройкаИнтеркампани.Пустая() Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не включено использование интеркампани или в настройках программы / текущего пользователя / точке продаж не заданы настройки интеркампани по умолчанию. Заказы не могут быть созданы.");
		Возврат;
	КонецЕсли;
	
	СписокТоваров = СозданиеНаОснованииПотолкиВызовСервера.ПодготовитьСписокТоваровДляВыбораПользователемКПроизводствуРозница(ДокументСсылка);
	Если СписокТоваров = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ДокументСсылка", ДокументСсылка);
	ДополнительныеПараметры.Вставить("НастройкаИнтеркампани", НастройкаИнтеркампани);
	ДополнительныеПараметры.Вставить("ЭтоЗаказДоговор", ЭтоЗаказДоговор);
	ДополнительныеПараметры.Вставить("ЭтоМонтаж", НЕ ЭтоЗаказДоговор);
	ДополнительныеПараметры.Вставить("СписокТоваров", СписокТоваров);
	ДоступныАналогиМатериалов = Истина;
	Если НЕ ЭтоЗаказДоговор Тогда
		// монтаж
		ОснованиеДокумента = ОбщийМодульВызовСервера.ЗначениеРеквизитаОбъекта(ДокументСсылка, "Основание");		
		ДоступныАналогиМатериалов = НЕ ЗначениеЗаполнено(ОснованиеДокумента) 
									ИЛИ ( ЗначениеЗаполнено(ОснованиеДокумента) И НЕ ТипЗнч(ОснованиеДокумента) = Тип("ДокументСсылка.ЗаказДоговор") );
	КонецЕсли;
	ДополнительныеПараметры.Вставить("ДоступныАналогиМатериалов", ДоступныАналогиМатериалов);
	
	ОповещениеОЗакрытии = Новый ОписаниеОповещения("ЗаказПокупателяСоздатьНаОснованииДокументаРозницыЗавершение", ЭтотОбъект, ДополнительныеПараметры);
	ОткрытьФорму("ОбщаяФорма.ФормаЗаказаНаПроизводствоИзРозницы", ДополнительныеПараметры, , , ВариантОткрытияОкна.ОтдельноеОкно, , ОповещениеОЗакрытии);
	
КонецПроцедуры

Процедура ЗаказПокупателяСоздатьНаОснованииДокументаРозницыЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	// Результат = структура("СписокЗаказать, ОжидаемаяДатаОтгрузки, ОжидаемоеВремяОтгрузки")
	
	Если НЕ ТипЗнч(Результат) = Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
		
	Если Результат.СписокЗаказать.Количество() = 0 Тогда
		ПоказатьПредупреждение(,"Товар к заказу не был выбран");
		Возврат;
	КонецЕсли;
	
	СтруктураВозврата = ОбщийМодульВызовСервера.СоздатьЗаказыПокупателейНаПроизводствоРозница(Результат, ДополнительныеПараметры);
	Если СтруктураВозврата = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПоказатьПредупреждение(,"Создание заказов покупателя на производство завершено" 
				+ Символы.ПС + "Создано новых заказов: " + СтруктураВозврата.СозданоНовых
				+ Символы.ПС + "Обновлено ранее оформленных заказов: " + СтруктураВозврата.Обновлено,, "Выполнено");
				
	Оповестить("ЗаказПокупателяСоздатьНаОснованииДокументаРозницыЗавершение", Результат, ДополнительныеПараметры.ДокументСсылка);
		
КонецПроцедуры

