Процедура СоздатьНаОснованииМножественныйВыбор(ИмяФормы, МассивСсылок, ПараметрыВыполнения, ДополнительныеПараметрыОткрытия=Неопределено)
	
	ПараметрыВыполненияКоманды = Новый Структура("Источник,Уникальность,Окно,НавигационнаяСсылка");
	Если НЕ ПараметрыВыполнения = Неопределено Тогда
		ЗаполнитьЗначенияСвойств(ПараметрыВыполненияКоманды, ПараметрыВыполнения.ОписаниеКоманды.ДополнительныеПараметры);
	КонецЕсли;	
	ПараметрыОткрытия = Новый Структура("ЗначенияЗаполнения", Новый Структура("МассивДокументов", МассивСсылок));
	Если НЕ ДополнительныеПараметрыОткрытия = Неопределено Тогда
		ОбщегоНазначенияКлиентСервер.ДополнитьСтруктуру(ПараметрыОткрытия.ЗначенияЗаполнения, ДополнительныеПараметрыОткрытия);
	КонецЕсли;
	
	ОткрытьФорму(
		ИмяФормы,
		ПараметрыОткрытия,
		ПараметрыВыполненияКоманды.Источник,
		ПараметрыВыполненияКоманды.Уникальность,
		ПараметрыВыполненияКоманды.Окно,
		ПараметрыВыполненияКоманды.НавигационнаяСсылка);
		
КонецПроцедуры

