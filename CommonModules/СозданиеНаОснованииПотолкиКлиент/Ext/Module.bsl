Процедура РеализацияТоваровИУслугСоздатьНаОснованииЗаказаПокупателя(МассивСсылок, ПараметрыВыполнения) Экспорт
	
	//#5610 проверка из обработки заполнения Ртиу вынесена на клиента
	Для каждого ЗаказСсылка из МассивСсылок Цикл
		СтруктураПроверки = ОбщийМодульВызовСервера.ЭтоЗаказИнтеркампаниСОднойОрганизацией(ЗаказСсылка);
		Если СтруктураПроверки.Результат Тогда
			ПоказатьПредупреждение(, СтруктураПроверки.ТекстОшибки);
			Возврат;
		КонецЕсли;
	КонецЦикла;
	
	СозданиеНаОснованииПотолкиВызовСервера.ПроверитьВозможностьВводаНаОснованииЗаказа(МассивСсылок, "Реализация");
	
	Если МассивСсылок.Количество() = 1 Тогда
		СсылкаНаРеализацию = ОбщийМодульВызовСервера.ПолучитьРеализациюПоЗаказу(МассивСсылок[0]);
		
		ПараметрыНовогоДокумента = Новый Структура("Основание", МассивСсылок[0]);		
		Если СсылкаНаРеализацию = Неопределено Тогда
			ОткрытьФорму("Документ.РеализацияТоваровИУслуг.ФормаОбъекта", ПараметрыНовогоДокумента);
		Иначе
			ОписаниеОповещения = Новый ОписаниеОповещения("РеализацияТоваровИУслугСоздатьНаОснованииЗаказаПокупателяПослеВопроса", ЭтотОбъект, ПараметрыНовогоДокумента);
			ПоказатьВопрос(ОписаниеОповещения,"По документу уже оформлена реализация: " + СсылкаНаРеализацию + ". Создать новую реализацию?", РежимДиалогаВопрос.ДаНет);
		КонецЕсли;
		
	Иначе
		// множественное создание
		ПараметрыНовогоДокумента = Новый Структура("ЗначенияЗаполнения", Новый Структура("МассивДокументов", МассивСсылок));
		ОткрытьФорму("Документ.РеализацияТоваровИУслуг.ФормаОбъекта", ПараметрыНовогоДокумента);
	КонецЕсли;
	
КонецПроцедуры

Процедура РеализацияТоваровИУслугСоздатьНаОснованииЗаказаПокупателяПослеВопроса(Результат, ДополнительныеПараметры) Экспорт
	Если Результат = КодВозвратаДиалога.Да Тогда
		ПараметрыНовогоДокумента = Новый Структура;
		ПараметрыНовогоДокумента.Вставить("Основание", ДополнительныеПараметры.Основание);
		ОткрытьФорму("Документ.РеализацияТоваровИУслуг.ФормаОбъекта", ПараметрыНовогоДокумента);
	КонецЕсли;
КонецПроцедуры

Процедура ВыпускПродукцииСоздатьНаОснованииЗаказаНаПроизводство(ДанныеЗаполнения, ПараметрыВыполнения) Экспорт
	
	//ДанныеЗаполнения - ссылка на документ, создание одиночного выпуска	
	ЗаказСсылка = ДанныеЗаполнения;
	
	// общие проверки: проведенность, статус
	СозданиеНаОснованииПотолкиВызовСервера.ПроверитьВозможностьОформленияВыпускаНаОснованииЗаказовНаПроизводство(ЗаказСсылка, Ложь);
	
	ПараметрыОперации = Новый Структура;
	ПараметрыОперации.Вставить("ПараметрыВыполнения", ПараметрыВыполнения);
	ПараметрыОперации.Вставить("Заказ", ЗаказСсылка);
	ПараметрыОперации.Вставить("ЗначениеЗаполнения", ЗаказСсылка);
	// при вызове с
	// - РабочееМестоСотрудникаПроизводства (ШК)
	// - ФормаМассовогоВыпуска
	Если ТипЗнч(ПараметрыВыполнения) = Тип("Структура") И ПараметрыВыполнения.Свойство("ЗначениеЗаполнения") Тогда
		ПараметрыОперации.Вставить("ЗначениеЗаполнения", ПараметрыВыполнения.ЗначениеЗаполнения);
		ПараметрыОперации.Вставить("Неинтерактивно", Истина);
	КонецЕсли;	
	
	// проверка на соответствие ЗП и ЗНП
	//#14923 проверка расширена
	//Если ОбщийМодульВызовСервера.ОснованимЗаказаНаПроизводствоЯвляетсяЗаказПокупателя(ЗаказСсылка) Тогда	
	Если ОбщийМодульВызовСервера.ЗаказНаПроизводствоСвязанСЗаказомПокупателя(ЗаказСсылка) Тогда
		
		ЗаказПокупателяСсылка = ОбщийМодульВызовСервера.ПолучитьСсылкуНаОснование(ЗаказСсылка);
		ЭтоПроизводствоУникальнойПродукции = ОбщийМодульВызовСервера.ЭтоПроизводствоУникальнойПродукции(ЗаказСсылка);
		
		ТребуетсяПерезаполнениеЗнП = Ложь;
		
		СтруктураПроверки = ОбщийМодуль.ЗаказНаПроизводствоСоответствуетЗаказуПокупателя(ЗаказСсылка, ЗаказПокупателяСсылка);
		Если НЕ СтруктураПроверки.Результат Тогда
			
			Если ЭтоПроизводствоУникальнойПродукции Тогда 
				Если СтруктураПроверки.ЕстьПотолок Тогда
					ТребуетсяПерезаполнениеЗнП = Истина;
					
				Иначе
					ТекстОшибки = СтрШаблон("В основании ""%1"" отсутствует продукция документа ""%2""!", ЗаказПокупателяСсылка, ЗаказСсылка);
					ВызватьИсключение ТекстОшибки;
				КонецЕсли;
			Иначе
				ТребуетсяПерезаполнениеЗнП = Истина;
			КонецЕсли;
			
		КонецЕсли;	
		
		Если ТребуетсяПерезаполнениеЗнП Тогда
			
			ТекстВопроса = "Сведения по продукции%Дополнительно% в заказе покупателя, являющемся основанием, отличаются от данных в " + ЗаказСсылка + ".
							|Необходимо предварительно перезаполнить текущий заказ на производство по документу-основанию.
							|Выполнить перезаполнение заказа на производство (документ будет автоматически записан)?";
			
			Если ЭтоПроизводствоУникальнойПродукции Тогда							
				ТекстВопроса = СтрЗаменить(ТекстВопроса, "%Дополнительно%", " и её производственным услугам");
			Иначе
				ТекстВопроса = СтрЗаменить(ТекстВопроса, "%Дополнительно%", "");				
			КонецЕсли;
			
			ДополнительныеПараметры = Новый Структура;
			ДополнительныеПараметры.Вставить("ЭтоПроизводствоУникальнойПродукции", ЭтоПроизводствоУникальнойПродукции);
			ДополнительныеПараметры.Вставить("ЗаказНаПроизводство", ЗаказСсылка);
			ДополнительныеПараметры.Вставить("ЗаказНаПроизводствоОснование", ЗаказПокупателяСсылка);
			ДополнительныеПараметры.Вставить("ДоступноИзменениеПриНаличииВыпуска", СтруктураПроверки.ДоступноИзменениеПриНаличииВыпуска); // #13200	
			ДополнительныеПараметры.Вставить("ПараметрыОперации", ПараметрыОперации);
			
			ОписаниеОповещенияПослеВопроса = Новый ОписаниеОповещения("НачалоПерезаполненияЗаказаНаПроизводствоПоОснованию", ЭтотОбъект, ДополнительныеПараметры);
			
			ПоказатьВопрос(ОписаниеОповещенияПослеВопроса, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
			
			// дальнейшая обработка после вопроса
			Возврат;	
		КонецЕсли;
	КонецЕсли;

	ВыпускПродукцииСоздатьНаОснованииЗаказаНаПроизводствоФрагмент(ПараметрыОперации);

КонецПроцедуры

Процедура НачалоПерезаполненияЗаказаНаПроизводствоПоОснованию(Результат, ДополнительныеПараметры) Экспорт
	
	Если НЕ Результат = КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	ЗнПУспешноПерезаполнен = Истина;
	ДоступноИзменениеПриНаличииВыпуска = ДополнительныеПараметры.ДоступноИзменениеПриНаличииВыпуска; // #13200
	//#14923 вызываем единую функцию перезаполнения ЗНП
	//Если ДополнительныеПараметры.ЭтоПроизводствоУникальнойПродукции Тогда
	//	СтруктураПотолка = ОбщийМодульВызовСервера.ПолучитьПотолокЗаказаНаПроизводство(ДополнительныеПараметры.ЗаказНаПроизводство);
	//	ОбщийМодуль.ОбновитьЗаказНаПроизводствоПоПотолкуПоЗаказуПокупателя(ДополнительныеПараметры.ЗаказНаПроизводство, СтруктураПотолка.Потолок, ДополнительныеПараметры.ЗаказНаПроизводствоОснование,,СтруктураПотолка.УИстроки, ДоступноИзменениеПриНаличииВыпуска);
	//Иначе
	//	ОбщийМодуль.ОбновитьЗаказНаТиповоеПроизводствоПоЗаказуПокупателя(ДополнительныеПараметры.ЗаказНаПроизводство, ДополнительныеПараметры.ЗаказНаПроизводствоОснование, , ДоступноИзменениеПриНаличииВыпуска);
	//КонецЕсли;
	ЗнПУспешноПерезаполнен = ОбщийМодуль.ОбновитьЗаказНаПроизводствоПоЗаказуПокупателя(ДополнительныеПараметры.ЗаказНаПроизводство, ДоступноИзменениеПриНаличииВыпуска);
	
	Если ЗнПУспешноПерезаполнен Тогда
		ПоказатьПредупреждение(, "Заказ на производство перезаполнен");
		ВыпускПродукцииСоздатьНаОснованииЗаказаНаПроизводствоФрагмент(ДополнительныеПараметры.ПараметрыОперации);
	КонецЕсли;	
	
КонецПроцедуры

Процедура ВыпускПродукцииСоздатьНаОснованииЗаказаНаПроизводствоФрагмент(ПараметрыОперации)
	
	// продолжаем создание выпуска
	ЗаказСсылка = ПараметрыОперации.Заказ;
	ВыпускСсылка = ОбщийМодульВызовСервера.НайтиДокументВыпускаПродукции(ЗаказСсылка);
	
	ОснованиеВыпуска = Новый Структура;
	ОснованиеВыпуска.Вставить("Заказ", ЗаказСсылка);
	
	ПараметрыОповещенияПослеЗакрытияВыпуска = Новый Структура;
	ПараметрыОповещенияПослеЗакрытияВыпуска.Вставить("Заказ", ЗаказСсылка);
	
	// если из ИзАРМСотрудникаПроизводства, то форму выпуска не показываем 
	Интерактивно = НЕ (ПараметрыОперации.Свойство("Неинтерактивно") И ПараметрыОперации.Неинтерактивно);
	
	Если ВыпускСсылка = ПредопределенноеЗначение("Документ.ВыпускПродукции.ПустаяСсылка") Тогда
		//если не нашли проведенный документ выпуска, попробуем найти созданный, но не проведенный.
		// #14923 - не ищем 
		//ВыпускСсылка = ОбщийМодульВызовСервера.ЕстьНеПроведенныйДокументВыпускаПоЭтомуЗаказу(ЗаказСсылка); 
		
		ПараметрыНовогоДокумента = Новый Структура;
		ПараметрыНовогоДокумента.Вставить("Перезаполнить", ЗначениеЗаполнено(ВыпускСсылка)); //!
		ПараметрыНовогоДокумента.Вставить("ЗначенияЗаполнения", ОснованиеВыпуска);
		ПараметрыНовогоДокумента.Вставить("Основание", ЗаказСсылка); //ОснованиеВыпуска);
		ПараметрыНовогоДокумента.Вставить("Ключ", ВыпускСсылка);
			 
		Если Интерактивно Тогда
			ОписаниеОповещения = Новый ОписаниеОповещения("ПослеСозданияДокументаВыпуска", ЭтотОбъект, ПараметрыОповещенияПослеЗакрытияВыпуска);
			ОткрытьФорму("Документ.ВыпускПродукции.Форма.ФормаДокумента", ПараметрыНовогоДокумента,, Новый УникальныйИдентификатор(),,, ОписаниеОповещения);
		Иначе
			ОписаниеОшибки = ВыпускПродукцииСоздатьОбновитьНеинтерактивно(ПараметрыОперации.ЗначениеЗаполнения, ВыпускСсылка, ПараметрыОповещенияПослеЗакрытияВыпуска);
			Если ПараметрыОперации.Свойство("ПараметрыВыполнения")
				И ПараметрыОперации.ПараметрыВыполнения.Свойство("ОписаниеОшибки") Тогда
				ПараметрыОперации.ПараметрыВыполнения.ОписаниеОшибки = ОписаниеОшибки;
			КонецЕсли;
		КонецЕсли;	
	
	Иначе
		//предлагаем перезаполнить выпуск
		ДополнительныеПараметры = Новый Структура;
		ДополнительныеПараметры.Вставить("Заказ", ЗаказСсылка);
		ДополнительныеПараметры.Вставить("Выпуск", ВыпускСсылка);
		ДополнительныеПараметры.Вставить("ЗначениеЗаполнения", ПараметрыОперации.ЗначениеЗаполнения);
		ДополнительныеПараметры.Вставить("Интерактивно", Интерактивно);
		
		ПослеВопросаОПерезаполнении = Новый ОписаниеОповещения("ПослеВопросаОПерезаполненииВыпуска", ЭтотОбъект, ДополнительныеПараметры);
		ТекстВопроса = СтрШаблон("На основании заказа ""%1"" уже оформлен выпуск продукции. Перезаполнить существующий выпуск?", ЗаказСсылка);
		ПоказатьВопрос(ПослеВопросаОПерезаполнении, ТекстВопроса, РежимДиалогаВопрос.ДаНет);			
	КонецЕсли;
	
КонецПроцедуры

Процедура ПослеВопросаОПерезаполненииВыпуска(Результат, ДополнительныеПараметры) Экспорт
	
	ПараметрыОповещенияПослеЗакрытияВыпуска = Новый Структура;
	ПараметрыОповещенияПослеЗакрытияВыпуска.Вставить("Заказ", ДополнительныеПараметры.Заказ);
		
	Если Результат = КодВозвратаДиалога.Да Тогда		
		//пользователь согласился с перезаполнением документа		
		ОснованиеВыпуска = Новый Структура;
		ОснованиеВыпуска.Вставить("Заказ", ДополнительныеПараметры.Заказ);
		
		Если ДополнительныеПараметры.Интерактивно Тогда			
			ПараметрыНовогоДокумента = Новый Структура;
			ПараметрыНовогоДокумента.Вставить("Перезаполнить", Истина); //!
			ПараметрыНовогоДокумента.Вставить("ЗначенияЗаполнения", ОснованиеВыпуска);
			ПараметрыНовогоДокумента.Вставить("Основание", ДополнительныеПараметры.Заказ);
			ПараметрыНовогоДокумента.Вставить("Ключ", ДополнительныеПараметры.Выпуск);
			
			ОписаниеОповещения = Новый ОписаниеОповещения("ПослеСозданияДокументаВыпуска", ЭтотОбъект, ПараметрыОповещенияПослеЗакрытияВыпуска);
			ОткрытьФорму("Документ.ВыпускПродукции.Форма.ФормаДокумента", ПараметрыНовогоДокумента,,,,,ОписаниеОповещения);			
		Иначе
			ВыпускПродукцииСоздатьОбновитьНеинтерактивно(ДополнительныеПараметры.ЗначениеЗаполнения, ДополнительныеПараметры.Выпуск, ПараметрыОповещенияПослеЗакрытияВыпуска);
		КонецЕсли;
		
	ИначеЕсли Результат = КодВозвратаДиалога.Нет Тогда		
		//пользователь отказался от перезаполнения - просто открываем выпуск		
		Если ДополнительныеПараметры.Интерактивно Тогда			
			ПараметрыНовогоДокумента = Новый Структура;
			ПараметрыНовогоДокумента.Вставить("Ключ", ДополнительныеПараметры.Выпуск);
			
			ОписаниеОповещения = Новый ОписаниеОповещения("ПослеСозданияДокументаВыпуска", ЭтотОбъект, ПараметрыОповещенияПослеЗакрытияВыпуска);
			ОткрытьФорму("Документ.ВыпускПродукции.Форма.ФормаДокумента", ПараметрыНовогоДокумента,,,,,ОписаниеОповещения);			
		Иначе
			ПослеСозданияДокументаВыпуска(Неопределено, ПараметрыОповещенияПослеЗакрытияВыпуска);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Функция ВыпускПродукцииСоздатьОбновитьНеинтерактивно(ЗначениеЗаполнения, ВыпускСсылка, ПараметрыОповещенияПослеЗакрытияВыпуска)
	
	ОписаниеОшибки = "";
	//#13345
	СозданныйВыпускПродукции = ОбщийМодульВызовСервера.СоздатьОбновитьВыпускПродукции(ЗначениеЗаполнения, ВыпускСсылка, ОписаниеОшибки);
	
	Если СозданныйВыпускПродукции <> Неопределено
		И НЕ СозданныйВыпускПродукции.Пустая() Тогда
		ПослеСозданияДокументаВыпуска(Неопределено, ПараметрыОповещенияПослеЗакрытияВыпуска);
	КонецЕсли;
	
	Возврат ОписаниеОшибки;
	
КонецФункции

Процедура ПослеСозданияДокументаВыпуска(Результат, ДополнительныеПараметры) Экспорт
	
	ЗаказСсылка = ДополнительныеПараметры.Заказ;
	ВыпускСсылка = ОбщийМодульВызовСервера.НайтиДокументВыпускаПродукции(ЗаказСсылка);
	
	Если ВыпускСсылка = ПредопределенноеЗначение("Документ.ВыпускПродукции.ПустаяСсылка") Тогда
		ПоказатьПредупреждение(,"Перевод в статус ""Произведен"" отменен - нет документа выпуска");
		
	ИначеЕсли ОбщийМодульВызовСервера.ВыпускСоответствуетЗаказу(ВыпускСсылка, ЗаказСсылка) Тогда
		Результат = ОбщийМодульВызовСервера.ИзменитьСтатусЗаказаНаПроизводствоНаПроизведен(ЗаказСсылка);
		Если Результат Тогда
			Оповестить("ИзмененСтатусЗаказаНаПроизводство", ЗаказСсылка, "ЗаказНаПроизводство");	
		КонецЕсли;
		
	Иначе
		ПоказатьПредупреждение(,"Заказ на производство не может быть переведен в статус ""Произведен"", т.к. выпуск не полностью соответствует заказу");
	КонецЕсли;
	
	Оповестить("ЗаписанЗаказНаПроизводство", ЗаказСсылка, "ЗаказНаПроизводство");
	Оповестить("ОбновитьАРМПроизводства",,"ЗаказНаПроизводство");
	Оповестить("ОбновитьАРМПроизводства",,"ЗаказПокупателя");
	
КонецПроцедуры

//#10995
Процедура ВыпускПродукцииМассовыйСоздатьНаОснованииЗаказаНаПроизводство(МассивСсылок, ПараметрыВыполнения = Неопределено) Экспорт
	
	СозданиеНаОснованииПотолкиВызовСервера.ПроверитьВозможностьОформленияВыпускаНаОснованииЗаказовНаПроизводство(МассивСсылок, Истина);
		
	ПараметрыФормыПроизводства = Новый Структура;
	ПараметрыФормыПроизводства.Вставить("СписокЗаказов", МассивСсылок);		
	
	ДопПараметры = Новый Структура;		
	ОткрытьФорму("Документ.ВыпускПродукции.Форма.ФормаМассовогоВыпуска", ПараметрыФормыПроизводства, , , ВариантОткрытияОкна.ОтдельноеОкно);
	
КонецПроцедуры

Процедура МонтажСоздатьНаОснованииВидОперацииРекламация(МассивСсылок, ПараметрыВыполнения) Экспорт
	
	Если МассивСсылок.Количество() > 0 Тогда
		ПараметрыНовогоДокумента = Новый Структура("ЗначенияЗаполнения", Новый Структура("Основание, ВидОперации", МассивСсылок[0], ПредопределенноеЗначение("Справочник.ВидыМонтажа.Рекламация")));				
		ОткрытьФорму("Документ.Монтаж.ФормаОбъекта", ПараметрыНовогоДокумента);
	КонецЕсли;
	
КонецПроцедуры

Процедура МонтажСоздатьНаОснованииВидОперацииСервиснаяЗаявка(МассивСсылок, ПараметрыВыполнения) Экспорт
	
