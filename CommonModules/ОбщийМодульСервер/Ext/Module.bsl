// Возвращает представление номенклатуры для печати.
//
Функция ПредставлениеНоменклатурыДляПечати(Номенклатура, Характеристика = Неопределено) Экспорт
	
	//++ №12909 входные параметры переделаны на ссылки
	НаименованиеХарактеристикиДляПечати = "";
	
	Если ТипЗнч(Характеристика) = Тип("СправочникСсылка.ХарактеристикиНоменклатуры") Тогда
		НаименованиеХарактеристикиДляПечати = Характеристика.Наименование;
	КонецЕсли;
	
	Если ПустаяСтрока(Номенклатура.НаименованиеДляПечати) Тогда
		НаименованиеНоменклатурыДляПечати = Номенклатура.Наименование;
	Иначе
		НаименованиеНоменклатурыДляПечати = Номенклатура.НаименованиеДляПечати;
	КонецЕсли;
	//-- №12909
	
	ТекстВСкобкахСтрока = НаименованиеХарактеристикиДляПечати;
	
	Если ЗначениеЗаполнено(ТекстВСкобкахСтрока) Тогда
		ПредставлениеНоменклатуры = НСтр("ru = '%НаименованиеНоменклатурыДляПечати% (%ТекстВСкобках%)'");
		ПредставлениеНоменклатуры = СтрЗаменить(ПредставлениеНоменклатуры, "%ТекстВСкобках%", СокрЛП(ТекстВСкобкахСтрока));
	Иначе
		ПредставлениеНоменклатуры = НСтр("ru = '%НаименованиеНоменклатурыДляПечати%'");
	КонецЕсли;
	
	ПредставлениеНоменклатуры = СтрЗаменить(ПредставлениеНоменклатуры, "%НаименованиеНоменклатурыДляПечати%", СокрЛП(НаименованиеНоменклатурыДляПечати));
	
	Возврат ПредставлениеНоменклатуры;
	
КонецФункции

Функция ПредставлениеДокументаФизлица(ДанныеДокумента) Экспорт
	
	ПаспортПредставление = "";
	Если НЕ ПустаяСтрока(ДанныеДокумента.ПаспортНомер) Тогда
		ПаспортПредставление = "Документ: " + ДанныеДокумента.ПаспортВид + " серия: " + ДанныеДокумента.ПаспортСерия
		+ " номер: " + ДанныеДокумента.ПаспортНомер + ", выдан: " + ДанныеДокумента.ПаспортКемВыдан + " " + Формат(ДанныеДокумента.ПаспортДатаВыдачи, "ДЛФ=Д");
	КонецЕсли;
	Возврат ПаспортПредставление;
	
КонецФункции

Функция ДобавитьКолонкиКонтактнойИнформации(РезультатЗапроса) Экспорт
	
	РезультатЗапроса.Колонки.Добавить("ОрганизацияОсновнойТелефон");
	РезультатЗапроса.Колонки.Добавить("ОрганизацияСайт");
	РезультатЗапроса.Колонки.Добавить("ОрганизацияЭлектроннаяПочта");
	РезультатЗапроса.Колонки.Добавить("ОрганизацияАдрес");
	РезультатЗапроса.Колонки.Добавить("ОрганизацияТелефон");
	РезультатЗапроса.Колонки.Добавить("ОрганизацияЮридическийАдрес");
	РезультатЗапроса.Колонки.Добавить("ОрганизацияФактическийАдрес");	
	
	РезультатЗапроса.Колонки.Добавить("КонтрагентОсновнойТелефон");
	РезультатЗапроса.Колонки.Добавить("КонтрагентОсновнойEMail");
	РезультатЗапроса.Колонки.Добавить("КонтрагентЮридическийАдрес");
	РезультатЗапроса.Колонки.Добавить("КонтрагентФактическийАдрес");
	
КонецФункции

Функция ДополнитьДанныеДляПечатныхФормКонтактнойИнформацией(ТекущаяСтрока, Организация, Контрагент=Неопределено) Экспорт
	
	ТекущаяСтрока.ОрганизацияСайт 				= УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(Организация, Справочники.ВидыКонтактнойИнформации.СайтОрганизации);
	ТекущаяСтрока.ОрганизацияЭлектроннаяПочта   = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(Организация, Справочники.ВидыКонтактнойИнформации.EmailОрганизации);
	ТекущаяСтрока.ОрганизацияАдрес 				= УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(Организация, Справочники.ВидыКонтактнойИнформации.ЮрАдресОрганизации);
	ТекущаяСтрока.ОрганизацияТелефон     		= УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(Организация, Справочники.ВидыКонтактнойИнформации.ТелефонОрганизации);
	ТекущаяСтрока.ОрганизацияЮридическийАдрес 	= ТекущаяСтрока.ОрганизацияАдрес;
	ТекущаяСтрока.ОрганизацияФактическийАдрес 	= УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(Организация, Справочники.ВидыКонтактнойИнформации.ФактАдресОрганизации);
	ТекущаяСтрока.ОрганизацияОсновнойТелефон  	= ТекущаяСтрока.ОрганизацияТелефон; 
	
	Если НЕ Контрагент = Неопределено Тогда
		ТекущаяСтрока.КонтрагентОсновнойТелефон 	= УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(Контрагент, Справочники.ВидыКонтактнойИнформации.ТелефонКонтрагента);
		ТекущаяСтрока.КонтрагентОсновнойEMail   	= УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(Контрагент, Справочники.ВидыКонтактнойИнформации.EmailКонтрагента);
		ТекущаяСтрока.КонтрагентЮридическийАдрес 	= УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(Контрагент, Справочники.ВидыКонтактнойИнформации.ЮрАдресКонтрагента);
		ТекущаяСтрока.КонтрагентФактическийАдрес    = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(Контрагент, Справочники.ВидыКонтактнойИнформации.ФактАдресКонтрагента);
	КонецЕсли;
	
КонецФункции

Функция ПечатьТОРГ12(МассивОбъектов, ОбъектыПечати) Экспорт
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.АвтоМасштаб         = Истина;                       //#14053
	ТабличныйДокумент.ОриентацияСтраницы  = ОриентацияСтраницы.Ландшафт;  //#14053
	ТабличныйДокумент.ИмяПараметровПечати = "ПараметрыПечати_ТОРГ12";
	Макет = УправлениеПечатью.МакетПечатнойФормы("ОбщийМакет.ПФ_MXL_ТОРГ12");
	
	МенеджерОбъекта = ОбщегоНазначения.МенеджерОбъектаПоСсылке(МассивОбъектов[0]);
	
	СтруктураДанныхДляПечати = МенеджерОбъекта.ПолучитьДанныеДляПечатныхФорм(МассивОбъектов);
	ДанныеПечати      	     = СтруктураДанныхДляПечати.РезультатПоШапке.Выбрать();
	ВыборкаПоДокументам 	 = СтруктураДанныхДляПечати.РезультатПоТабличнойЧасти.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	
	ПервыйДокумент = Истина;
	Пока ДанныеПечати.Следующий() Цикл
		
		//++ 16289 Латыпов Р.Р.
		//Если ТипЗнч(ДанныеПечати.Ссылка) = Тип("ДокументСсылка.Монтаж") Тогда
		//	ДатаДокумента = ОбщийМодульСервер.ПолучитьДатуПодписанияДокументаМонтажа(ДанныеПечати.Ссылка);
		//Иначе
		//	ДатаДокумента = ДанныеПечати.Дата;
		//КонецЕсли;	
		//-- 16289 Латыпов Р.Р.
		
		СтруктураПоиска = Новый Структура("Ссылка", ДанныеПечати.Ссылка);
		ВыборкаПоДокументам.Сбросить();
		Если НЕ ВыборкаПоДокументам.НайтиСледующий(СтруктураПоиска) Тогда
			Продолжить;
		КонецЕсли;
		
		Если Не ПервыйДокумент Тогда
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		ПервыйДокумент = Ложь;
		НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы + 1;
		
		ОбластьМакета = Макет.ПолучитьОбласть("Шапка");
		ЗаполнитьЗначенияСвойств(ОбластьМакета.Параметры, ДанныеПечати);
		
		СтруктураПараметров = Новый Структура;
		СтруктураПараметров.Вставить("НомерДокумента", ПрефиксацияОбъектовКлиентСервер.НомерНаПечать(ДанныеПечати.Номер));
		// СтруктураПараметров.Вставить("ДатаДокумента",  Формат(ДанныеПечати.ДатаДокумента, "ДЛФ=Д"));  // 17077
		Если ТипЗнч(ДанныеПечати.Ссылка) = Тип("ДокументСсылка.ПоступлениеТоваровИУслуг") Тогда
			Если ЗначениеЗаполнено(ДанныеПечати.ВхНомер) Тогда
				СтруктураПараметров.Вставить("НомерДокумента", ДанныеПечати.ВхНомер);
			КонецЕсли;
			Если ЗначениеЗаполнено(ДанныеПечати.ВхДата) Тогда
				СтруктураПараметров.Вставить("ДатаДокумента",  Формат(ДанныеПечати.ВхДата, "ДЛФ=Д"));
			КонецЕсли;
			
		ИначеЕсли ТипЗнч(ДанныеПечати.Ссылка) = Тип("ДокументСсылка.Монтаж") Тогда
			СтруктураПараметров.Вставить("ДатаДокумента", ОбщийМодульСервер.ПолучитьДатуПодписанияДокументаМонтажа(ДанныеПечати.Ссылка));
			//Если НЕ ДанныеПечати.Ссылка.Результат = Справочники.РезультатыМонтажа.Закрыт
			//	И НЕ ДанныеПечати.Ссылка.Результат = Справочники.РезультатыМонтажа.Выполнен Тогда
			//	СтруктураПараметров.Вставить("ДатаДокумента", ДатаДокумента);
			//КонецЕсли;	
		Иначе
				СтруктураПараметров.Вставить("ДатаДокумента",  Формат(ДанныеПечати.Дата, "ДЛФ=Д"));
		КонецЕсли;
		ОбластьМакета.Параметры.Заполнить(СтруктураПараметров);
		
		СведенияОбОрганизации = ОбщийМодульСервер.СведенияОбОрганизации(ДанныеПечати.Организация);
		СведенияОКонтрагенте = ОбщийМодульСервер.СведенияОКонтрагенте(ДанныеПечати.Контрагент);
		
		Если ТипЗнч(ДанныеПечати.Ссылка) = Тип("ДокументСсылка.ПоступлениеТоваровИУслуг") Тогда
			ОбластьМакета.Параметры.ПредставлениеОрганизации 		= ОбщийМодульСервер.ОписаниеОрганизации(СведенияОКонтрагенте, 		"ПолноеНаименование,ИНН,Свидетельство,ЮридическийАдрес,Телефоны,Факс,НомерСчета,Банк,БИК,КоррСчет");
			ОбластьМакета.Параметры.ПредставлениеПлательщика	  	= ОбщийМодульСервер.ОписаниеОрганизации(СведенияОбОрганизации,		"ПолноеНаименование,ИНН,Свидетельство,ЮридическийАдрес,Телефоны,Факс,НомерСчета,Банк,БИК,КоррСчет");
			ОбластьМакета.Параметры.ПредставлениеГрузополучателя	= ОбщийМодульСервер.ОписаниеОрганизации(СведенияОбОрганизации, 		"ПолноеНаименование,ИНН,ФактическийАдрес,Телефоны,Факс,НомерСчета,Банк,БИК,КоррСчет");
		Иначе			
			ОбластьМакета.Параметры.ПредставлениеОрганизации 		= ОбщийМодульСервер.ОписаниеОрганизации(СведенияОбОрганизации, 		"ПолноеНаименование,ИНН,Свидетельство,ЮридическийАдрес,Телефоны,Факс,НомерСчета,Банк,БИК,КоррСчет");
			ОбластьМакета.Параметры.ПредставлениеПлательщика	  	= ОбщийМодульСервер.ОписаниеОрганизации(СведенияОКонтрагенте,		"ПолноеНаименование,ИНН,Свидетельство,ЮридическийАдрес,Телефоны,Факс,НомерСчета,Банк,БИК,КоррСчет");
			ОбластьМакета.Параметры.ПредставлениеГрузополучателя	= ОбщийМодульСервер.ОписаниеОрганизации(СведенияОКонтрагенте, 		"ПолноеНаименование,ИНН,ФактическийАдрес,Телефоны,Факс,НомерСчета,Банк,БИК,КоррСчет");		
		КонецЕсли;
		ТабличныйДокумент.Вывести(ОбластьМакета);
		
		НомерСтраницы = 1;
		ИтоговыеСуммы = СтруктураИтоговыеСуммы();
		
		// Создаем массив для проверки вывода
		МассивВыводимыхОбластей = Новый Массив;
		
		// Выводим многострочную часть документа
		ОбластьЗаголовокТаблицы = Макет.ПолучитьОбласть("ЗаголовокТаб");
		ОбластьМакетаСтандарт   = Макет.ПолучитьОбласть("Строка");
		ОбластьИтоговПоСтранице = Макет.ПолучитьОбласть("ИтогоПоСтранице");
		ОбластьВсего            = Макет.ПолучитьОбласть("Всего");
		
		ВыводШапки = 0;
		
		СтрокаТовары = ВыборкаПоДокументам.Выбрать();
		КоличествоСтрок = СтрокаТовары.Количество();
		НомерСтроки = 0;
		Пока СтрокаТовары.Следующий() Цикл
			
			ОбластьМакета = ОбластьМакетаСтандарт;
			НомерСтроки = НомерСтроки + 1;
			ЗаполнитьЗначенияСвойств(ОбластьМакета.Параметры, СтрокаТовары);
			ОбластьМакета.Параметры.НомерСтроки = НомерСтроки;
			
			//++ №12909
			//ПредставлениеНоменклатуры = Строка(СтрокаТовары.Номенклатура) + Строка(УправлениеПечатью.ПредставлениеХарактеристики(СтрокаТовары.ХарактеристикаНоменклатуры));
			ПредставлениеНоменклатуры = ОбщийМодульСервер.ПредставлениеНоменклатурыДляПечати(СтрокаТовары.Номенклатура, СтрокаТовары.ХарактеристикаНоменклатуры);
			//-- №12909
			
			ОбластьМакета.Параметры.ПредставлениеНоменклатуры = ПредставлениеНоменклатуры;
			
			Если НомерСтроки = 0 И ВыводШапки <> 2 Тогда
				ВыводШапки = 1;
			КонецЕсли;
			
			Если (НомерСтроки = 1 И ВыводШапки = 0) ИЛИ (НомерСтроки = 0 И ВыводШапки = 1) Тогда
				
				ВыводШапки = 2;
				
				СтруктураПараметров = Новый Структура;
				СтруктураПараметров.Вставить("НомерСтраницы", "Страница " + НомерСтраницы);
				ОбластьЗаголовокТаблицы.Параметры.Заполнить(СтруктураПараметров);
				ТабличныйДокумент.Вывести(ОбластьЗаголовокТаблицы);
				
			КонецЕсли;
			
			МассивВыводимыхОбластей.Очистить();
			МассивВыводимыхОбластей.Добавить(ОбластьМакета);
			МассивВыводимыхОбластей.Добавить(ОбластьИтоговПоСтранице);
			Если НомерСтроки = КоличествоСтрок Тогда
				ДобавитьИтоговыеДанныеПодвала(ИтоговыеСуммы, НомерСтроки, ДанныеПечати.Валюта);
				ОбластьПодвала = ЗаполнитьРеквизитыПодвалаТОРГ12(ДанныеПечати, ИтоговыеСуммы, Макет);
				МассивВыводимыхОбластей.Добавить(ОбластьВсего);
				МассивВыводимыхОбластей.Добавить(ОбластьПодвала);
			КонецЕсли;
			
			Если НЕ ТабличныйДокумент.ПроверитьВывод(МассивВыводимыхОбластей) Тогда
				ОбластьИтоговПоСтранице.Параметры.Заполнить(ИтоговыеСуммы);
				ТабличныйДокумент.Вывести(ОбластьИтоговПоСтранице);
				
				ОбнулитьИтогиПоСтранице(ИтоговыеСуммы);
				
				НомерСтраницы = НомерСтраницы + 1;
				ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
				
				СтруктураПараметров = Новый Структура;
				СтруктураПараметров.Вставить("НомерСтраницы", "Страница " + НомерСтраницы);
				ОбластьЗаголовокТаблицы.Параметры.Заполнить(СтруктураПараметров);
				ТабличныйДокумент.Вывести(ОбластьЗаголовокТаблицы);
				
			КонецЕсли;
			
			ТабличныйДокумент.Вывести(ОбластьМакета);
			
			РассчитатьИтоговыеСуммы(ИтоговыеСуммы, СтрокаТовары);
			
		КонецЦикла;
		
		// Выводим итоги по последней странице
		ОбластьИтоговПоСтранице = Макет.ПолучитьОбласть("ИтогоПоСтранице");
		ОбластьИтоговПоСтранице.Параметры.Заполнить(ИтоговыеСуммы);
		
		ТабличныйДокумент.Вывести(ОбластьИтоговПоСтранице);
		
		// Выводим итоги по документу в целом
		ОбластьМакета = Макет.ПолучитьОбласть("Всего");
		ОбластьМакета.Параметры.Заполнить(ИтоговыеСуммы);	
		ТабличныйДокумент.Вывести(ОбластьМакета);
		
		// Выводим подвал документа
		ДобавитьИтоговыеДанныеПодвала(ИтоговыеСуммы, НомерСтроки, ДанныеПечати.Валюта);
		ОбластьПодвала = ЗаполнитьРеквизитыПодвалаТОРГ12(ДанныеПечати, ИтоговыеСуммы, Макет);
		ТабличныйДокумент.Вывести(ОбластьПодвала);
		
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабличныйДокумент, НомерСтрокиНачало, ОбъектыПечати, ДанныеПечати.Ссылка);
	КонецЦикла;
	
	Возврат ТабличныйДокумент;
	
КонецФункции

Функция ЗаполнитьРеквизитыПодвалаТОРГ12(ДанныеПечати, ИтоговыеСуммы, Макет)
	
	ОбластьМакета = Макет.ПолучитьОбласть("Подвал");
	
	Если НЕ ТипЗнч(ДанныеПечати.Ссылка) = Тип("ДокументСсылка.ПоступлениеТоваровИУслуг") Тогда
