// Возвращает таблицу со списком видов прочих исполнителей и выбранными пользователем видами
Функция ПолучитьНастройкуОтображатьПрочихИсполнителей() Экспорт
	
	// Получим поля, которые могут быть выбраны как обязательные к заполнению
	ПрочиеИсполнители = ПолучитьМассивВозможныхПрочихИсполнителей();
	
	// Получим поля, которые уже выбраны пользователем
	ВыбранныеИсполнители = Константы.ОтображатьПрочихИсполнителей.Получить().Получить();
	Если ВыбранныеИсполнители = Неопределено Тогда
		ВыбранныеИсполнители = новый Массив;
	КонецЕсли;
	
	// Сформируем таблицу значений с возможными и выбранными полями
	ТаблицаНастройки = новый ТаблицаЗначений;
	ТаблицаНастройки.Колонки.Добавить("ВидИсполнителя", 	новый ОписаниеТипов("Строка",,,, новый КвалификаторыСтроки(80)));
	ТаблицаНастройки.Колонки.Добавить("Синоним", 	новый ОписаниеТипов("Строка",,,, новый КвалификаторыСтроки(0)));
	ТаблицаНастройки.Колонки.Добавить("Отображать", 	новый ОписаниеТипов("Булево"));
	
	Для Каждого Исполнитель Из ПрочиеИсполнители Цикл
		НоваяСтрока = ТаблицаНастройки.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Исполнитель);
		НоваяСтрока.Отображать = (НЕ ВыбранныеИсполнители.Найти(Исполнитель.ВидИсполнителя) = Неопределено);
	КонецЦикла;
	
	Возврат ТаблицаНастройки;
	
КонецФункции

Процедура СохранитьНастройкуОтображатьПрочихИсполнителей(ОтображатьПрочихИсполнителей) Экспорт
	
	ОтображаемыеПрочиеИсполнители = новый Массив;
	
	Для Каждого ТекущаяСтрока Из ОтображатьПрочихИсполнителей Цикл
		
		Если ТекущаяСтрока.Отображать Тогда
			ОтображаемыеПрочиеИсполнители.Добавить(ТекущаяСтрока.ВидИсполнителя);
		КонецЕсли;
		
	КонецЦикла;
	
	Константы.ОтображатьПрочихИсполнителей.Установить(новый ХранилищеЗначения(ОтображаемыеПрочиеИсполнители));
	
КонецПроцедуры

#КонецОбласти
