//++ #12484
Функция ПолучитьСписокЗаказовПокупателейКОтгрузке() Экспорт
	
	МассивЗаказов = Новый Массив;
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ОбщиеСклады", Константы.ОбщиеСклады.Получить());
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЗаказПокупателя.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ ВТ_ЗаказыВработе
	|ИЗ
	|	Документ.ЗаказПокупателя КАК ЗаказПокупателя
	|ГДЕ
	|	ЗаказПокупателя.ТекущийСтатус = ЗНАЧЕНИЕ(Справочник.СтатусыЗаказовПокупателей.ВРаботе)
	|	И ЗаказПокупателя.Проведен
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВЫРАЗИТЬ(ЗаказыПокупателейОбороты.ЗаказНаПроизводство КАК Документ.ЗаказПокупателя) КАК ЗаказПокупателя,
	|	ЗаказыПокупателейОбороты.Номенклатура КАК Номенклатура,
	|	ЗаказыПокупателейОбороты.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	|	ЗаказыПокупателейОбороты.СерияНоменклатуры КАК СерияНоменклатуры,
	|	ЗаказыПокупателейОбороты.КоличествоПриход КАК КоличествоПриход,
	|	ЗаказыПокупателейОбороты.КоличествоРасход КАК КоличествоРасход,
	|	ЗаказыПокупателейОбороты.КоличествоПриход - ЗаказыПокупателейОбороты.КоличествоРасход КАК Потребность
	|ПОМЕСТИТЬ ВТ
	|ИЗ
	|	РегистрНакопления.ЗаказыПокупателей.Обороты(
	|			,
	|			,
	|			,
	|			ЗаказНаПроизводство В
	|				(ВЫБРАТЬ
	|					ВТ_ЗаказыВработе.Ссылка
	|				ИЗ
	|					ВТ_ЗаказыВработе)) КАК ЗаказыПокупателейОбороты
	|ГДЕ
	|	ЗаказыПокупателейОбороты.ЗаказНаПроизводство ССЫЛКА Документ.ЗаказПокупателя
	|	И ЗаказыПокупателейОбороты.КоличествоПриход - ЗаказыПокупателейОбороты.КоличествоРасход > 0
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ.ЗаказПокупателя КАК ЗаказПокупателя,
	|	ВТ.Номенклатура КАК Номенклатура,
	|	ВТ.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	|	ВТ.СерияНоменклатуры КАК СерияНоменклатуры,
	|	ВТ.Потребность КАК Потребность,
	|	ЕСТЬNULL(ТоварыНаСкладахОстатки.КоличествоОстаток, 0) КАК КоличествоОстаток,
	|	ЕСТЬNULL(ТоварыВРезервеПоЗаказуОстатки.КоличествоОстаток, 0) КАК ВРезервеПодЗаказ,
	|	ЕСТЬNULL(ТоварыВРезервеПоЗаказамОстатки.КоличествоОстаток, 0) КАК ВРезервеОбщее
	|ИЗ
	|	ВТ КАК ВТ
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыНаСкладах.Остатки КАК ТоварыНаСкладахОстатки
	|		ПО (ТоварыНаСкладахОстатки.Номенклатура = ВТ.Номенклатура)
	|			И (ТоварыНаСкладахОстатки.ХарактеристикаНоменклатуры = ВТ.ХарактеристикаНоменклатуры)
	|			И (ТоварыНаСкладахОстатки.СерияНоменклатуры = ВТ.СерияНоменклатуры)
	|			И (ТоварыНаСкладахОстатки.Склад = ВТ.ЗаказПокупателя.Склад)
	|			И (ВЫБОР
	|				КОГДА &ОбщиеСклады
	|					ТОГДА ИСТИНА
	|				ИНАЧЕ ТоварыНаСкладахОстатки.Организация = ВТ.ЗаказПокупателя.Организация
	|			КОНЕЦ)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыВРезервеНаСкладах.Остатки КАК ТоварыВРезервеПоЗаказуОстатки
	|		ПО (ТоварыВРезервеПоЗаказуОстатки.Номенклатура = ВТ.Номенклатура)
	|			И (ТоварыВРезервеПоЗаказуОстатки.ХарактеристикаНоменклатуры = ВТ.ХарактеристикаНоменклатуры)
	|			И (ТоварыВРезервеПоЗаказуОстатки.СерияНоменклатуры = ВТ.СерияНоменклатуры)
	|			И (ТоварыВРезервеПоЗаказуОстатки.ДокументРезерва = ВТ.ЗаказПокупателя)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыВРезервеНаСкладах.Остатки КАК ТоварыВРезервеПоЗаказамОстатки
	|		ПО (ТоварыВРезервеПоЗаказамОстатки.Номенклатура = ВТ.Номенклатура)
	|			И (ТоварыВРезервеПоЗаказамОстатки.ХарактеристикаНоменклатуры = ВТ.ХарактеристикаНоменклатуры)
	|			И (ТоварыВРезервеПоЗаказамОстатки.СерияНоменклатуры = ВТ.СерияНоменклатуры)
	|ИТОГИ ПО
	|	ЗаказПокупателя";
	
	
	ВыборкаЗаказов = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаЗаказов.Следующий() Цикл
		ЗаказГотовКотгрузке = Истина;
		Выборка = ВыборкаЗаказов.Выбрать();
		Пока Выборка.Следующий() Цикл
			// требуется больше, чем есть
			Если Выборка.Потребность > Выборка.КоличествоОстаток
				// остаток за минусом резервов на другие заказы покрывается потребность
				ИЛИ Выборка.Потребность > Выборка.КоличествоОстаток - (Выборка.ВРезервеОбщее - Выборка.ВРезервеПодЗаказ) Тогда
				ЗаказГотовКотгрузке = Ложь;
			КонецЕсли;
		КонецЦикла;
		
		Если ЗаказГотовКотгрузке Тогда
			МассивЗаказов.Добавить(ВыборкаЗаказов.ЗаказПокупателя);
		КонецЕсли;
	КонецЦикла;
	
	Возврат МассивЗаказов;
	
КонецФункции
//-- #12484

// Функция преобразует Массив из структур в ТаблицуЗначений.
//
Функция ПреобразоватьМассивВТаблицуЗначений(МассивСтруктур, ПривестиТипы = Ложь) Экспорт
	
	ТаблицаДанных = Новый ТаблицаЗначений;
	
	Для Каждого ЭлементМассива Из МассивСтруктур Цикл
		// Рисуем колонки для таблицы
		Если ТаблицаДанных.Колонки.Количество() = 0 Тогда
			Для Каждого ЗначениеСтруктуры Из ЭлементМассива Цикл
				ТаблицаДанных.Колонки.Добавить(ЗначениеСтруктуры.Ключ);
			КонецЦикла;
		КонецЕсли;
		
		// Добавляем данные в таблицу
		НоваяСтрока = ТаблицаДанных.Добавить();
		Для Каждого ЗначениеСтруктуры Из ЭлементМассива Цикл
			НоваяСтрока[ЗначениеСтруктуры.Ключ] = ЗначениеСтруктуры.Значение;
		КонецЦикла;
	КонецЦикла;
	
	Если ПривестиТипы Тогда
		ИндексКолонки = 0;
		Для каждого КолонкаТЗ из ТаблицаДанных.Колонки Цикл
			
			МассивТиповКолонки = новый Массив;
			НачальноеИмяКолонки = КолонкаТЗ.Имя;
			Для каждого СтрокаТЗ из ТаблицаДанных Цикл
				Тип = ТипЗнч(СтрокаТЗ[НачальноеИмяКолонки]);
				Если МассивТиповКолонки.Найти(Тип) = Неопределено Тогда
					МассивТиповКолонки.Добавить(Тип);	
				КонецЕсли;
			КонецЦикла;
			
			ДопустимыеТипы = Новый ОписаниеТипов(МассивТиповКолонки);
			
			ТаблицаДанных.Колонки.Вставить(ИндексКолонки, НачальноеИмяКолонки + "_", ДопустимыеТипы);
			ТаблицаДанных.ЗагрузитьКолонку(ТаблицаДанных.ВыгрузитьКолонку(НачальноеИмяКолонки), НачальноеИмяКолонки + "_");
			ТаблицаДанных.Колонки.Удалить(ИндексКолонки+1);
			ТаблицаДанных.Колонки[ИндексКолонки].Имя = НачальноеИмяКолонки;
			
			ИндексКолонки = ИндексКолонки + 1;
		КонецЦикла;		
	КонецЕсли;
	
	Возврат ТаблицаДанных;
	
КонецФункции // ПреобразоватьМассивВТаблицуЗначений()

//++ №12464
Процедура ВыполнитьПроверкуПоследнегоАдминистратораПользователя(ПользовательОбъект) Экспорт
	
	// Пользователь "<Не указан>"
	Если ПользовательОбъект.Служебный Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ ПользовательОбъект.ЭтоНовый() Тогда
		
		ТекущийПользовательИБ = ПользователиИнформационнойБазы.НайтиПоУникальномуИдентификатору(ПользовательОбъект.ИдентификаторПользователяИБ);
		
		Если ТекущийПользовательИБ.Роли.Содержит(Метаданные.Роли.АдминистраторСистемы)
			И (ПользовательОбъект.ПометкаУдаления Или ПользовательОбъект.Недействителен
			Или НЕ ТекущийПользовательИБ.АутентификацияСтандартная) Тогда
			
			// В случаях, если:
			// - установлена галочка "Недействителен"
			// - сняты галочки "Вход в программу разрешен" или "Аутентификация 1С:Предприятие"
			// - производится пометка на удаление
			// Если это был пользователь с ролью "Администратор системы", проверять что не остается ни одного пользователя с ролью "Администратор системы" (кроме "Службы поддержки SmartCeilings")
			УстановитьПривилегированныйРежим(Истина);
			
			Выборка = Справочники.Пользователи.Выбрать();
			
			ЕстьАктивныйАдминистратор = Ложь;
			Пока Выборка.Следующий() Цикл
				
				Если НЕ ЗначениеЗаполнено(Выборка.ИдентификаторПользователяИБ) Или Выборка.Ссылка = ПользовательОбъект.Ссылка Тогда
					Продолжить;
				КонецЕсли;
				
				ПользовательИБ = ПользователиИнформационнойБазы.НайтиПоУникальномуИдентификатору(Выборка.ИдентификаторПользователяИБ);
				
				Если НРег(ПользовательИБ.Имя) = "support" Тогда
					Продолжить;
				КонецЕсли;
				
				Если ПользовательИБ.Роли.Содержит(Метаданные.Роли.АдминистраторСистемы)
					И ПользовательИБ.АутентификацияСтандартная // это галочка Аутентификация 1С:Предприятие
					// Вход в программу разрешен регулируется выбором одной из трёх галочек Аутетификация
					И НЕ Выборка.Недействителен
					И НЕ Выборка.ПометкаУдаления
					Тогда
					ЕстьАктивныйАдминистратор = Истина;
					Прервать;
				КонецЕсли;
				
			КонецЦикла;
			
			Если НЕ ЕстьАктивныйАдминистратор Тогда
				
				ТекстОшибки = "ВНИМАНИЕ! После данного действия в системе не останется ни одного администратора. Действие отменено";
				ВызватьИсключение ТекстОшибки;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры
//-- №12464

//++ #12364
Процедура ДополнительнаяИнформацияПоКонтрагентуНаФорме(Контрагент, ЭлементФормы) Экспорт
	
	ТекстПодсказки = "";
	Если ЗначениеЗаполнено(Контрагент) Тогда
		ДанныеКонтрагента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Контрагент, "Дополнительно, ПоказыватьДопИнформацию");
		ЭлементФормы.Видимость = ДанныеКонтрагента.ПоказыватьДопИнформацию;
		ЭлементФормы.РасширеннаяПодсказка.Заголовок = ДанныеКонтрагента.Дополнительно;
	Иначе
		ЭлементФормы.Видимость = Ложь;
		ЭлементФормы.РасширеннаяПодсказка.Заголовок = "";
	КонецЕсли;
	
КонецПроцедуры

Процедура ЕстьИндивидуальныеЦеныКонтрагентаНаФорме(Дата, Контрагент, Договор, ЭлементФормы) Экспорт
	
	Если ПолучитьФункциональнуюОпцию("ИспользоватьИндивидуальныеЦены") И ЗначениеЗаполнено(Контрагент) Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	ЦеныСрезПоследних.Период КАК Период
		|ИЗ
		|	РегистрСведений.ЦеныНоменклатурыИндивидуальные.СрезПоследних(
		|			&Период,
		|			Контрагент = &Контрагент
		|				И ДоговорКонтрагента = &ДоговорКонтрагента) КАК ЦеныСрезПоследних";
		
		Запрос.УстановитьПараметр("ДоговорКонтрагента", Договор);
		Запрос.УстановитьПараметр("Контрагент", Контрагент);
		Запрос.УстановитьПараметр("Период", ?(ЗначениеЗаполнено(Дата), Дата, ТекущаяДатаСеанса()));
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ЭлементФормы.Видимость = НЕ РезультатЗапроса.Пустой();
	Иначе
		ЭлементФормы.Видимость = Ложь;
	КонецЕсли;
	
КонецПроцедуры

Процедура РегулировкаШириныПоляКонтрагента(ЭлементыФормы, ЭлементКонтрагент, ЭлементПоказатьДополнительнуюИнформацию, ЭлементЕстьИндивидуальныеЦены = Неопределено, ШиринаПоУмолчанию=40) Экспорт
	
	НоваяШирина = ШиринаПоУмолчанию;
	Если ЭлементПоказатьДополнительнуюИнформацию.Видимость Тогда
		НоваяШирина = НоваяШирина - 4;	
	КонецЕсли;
	Если НЕ ЭлементЕстьИндивидуальныеЦены = Неопределено И ЭлементЕстьИндивидуальныеЦены.Видимость Тогда
		НоваяШирина = НоваяШирина - 4;	
	КонецЕсли;
	
	//#13754
	ГруппаКнопокМессенджеры = ЭлементыФормы.Найти("ГруппаКонтрагентКПМессенджеры");
	Если НЕ ГруппаКнопокМессенджеры = Неопределено Тогда
		КоличествоКнопокМессенджеров = ГруппаКнопокМессенджеры.ПодчиненныеЭлементы.Количество();
		
		Если КоличествоКнопокМессенджеров > 0 Тогда
			НоваяШирина = НоваяШирина - 1 - 3*КоличествоКнопокМессенджеров;	
		КонецЕсли;			
	КонецЕсли;
	
	ЭлементКонтрагент.АвтомаксимальнаяШирина = Ложь;
	ЭлементКонтрагент.МаксимальнаяШирина = НоваяШирина;
	
КонецПроцедуры
