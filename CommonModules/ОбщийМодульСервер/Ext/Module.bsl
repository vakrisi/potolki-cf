		Элемент.Заголовок = НастройкаЦвета.Подсказка;
		Элемент.АвтоМаксимальнаяШирина = Ложь;
	КонецЦикла;
	
КонецПроцедуры

//ДокументСсылка - Заказ-договор или Монтаж
//
Функция ПодготовитьСписокТоваровДляВыбораПользователемКПроизводствуИзРозницы(ДокументСсылка) Экспорт
	
	НастройкаИнтеркампани = ОбщийМодуль.ПолучитьНастройкуИнтеркампани(ДокументСсылка.ТочкаПродаж, ДокументСсылка.Подразделение, ДокументСсылка.Организация);
	
	СписокТоваров = Новый Массив;
	
	МенеджерВТ = Новый МенеджерВременныхТаблиц;
	РегистрыНакопления.ОбеспечениеЗаказовРозницы.ПолучитьОстаткиКОбеспечению(МенеджерВТ, ДокументСсылка, , Константы.УчетОбеспеченностиРозницыПоКомнатам.Получить());
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВТ_Товары.НомерСтроки КАК НомерСтроки,
	|	ВТ_Товары.Комната КАК Комната,
	|	ВТ_Товары.Номенклатура КАК Номенклатура,
	|	ВТ_Товары.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	|	ВТ_Товары.Номенклатура.ВидНоменклатуры КАК ВидНоменклатуры,
	|	ВТ_Товары.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	ВТ_Товары.Коэффициент КАК Коэффициент,
	|	ВТ_Товары.Количество КАК Количество,
	|	ВТ_Товары.Назначение КАК Назначение,
	|	ВТ_Товары.НомерПотолка КАК НомерПотолка,
	//|	ВТ_Товары.Цена КАК Цена,
	//|	ВТ_Товары.Сумма КАК Сумма,
	//|	ВТ_Товары.ПроцентСкидки КАК ПроцентСкидки,
	//|	ВТ_Товары.СуммаСкидки КАК СуммаСкидки,
	|	ВТ_Товары.КоличествоКОбеспечению КАК КоличествоКОбеспечению,
	|	ВТ_Товары.ОбеспеченоПроизводством КАК ОбеспеченоПроизводством
	|ИЗ
	|	ВТ_ТоварыКОбеспечению КАК ВТ_Товары
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВТ_Материалы.НомерСтроки КАК НомерСтроки,
	|	ВТ_Материалы.Комната КАК Комната,
	|	ВТ_Материалы.Номенклатура КАК Номенклатура,
	|	ВТ_Материалы.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	|	ВТ_Материалы.Номенклатура.ВидНоменклатуры КАК ВидНоменклатуры,
	|	ВТ_Материалы.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	ВТ_Материалы.Коэффициент КАК Коэффициент,
	|	ВТ_Материалы.Количество КАК Количество,
	|	ВТ_Материалы.Назначение КАК Назначение,
	|	ВТ_Материалы.КоличествоКОбеспечению КАК КоличествоКОбеспечению,
	|	ВТ_Материалы.ОбеспеченоПроизводством КАК ОбеспеченоПроизводством
	|ИЗ
	|	ВТ_МатериалыКОбеспечению КАК ВТ_Материалы";
	
	РезультатЗапроса 	= Запрос.ВыполнитьПакет();
	ТаблицаТоваров 		= РезультатЗапроса[0].Выгрузить();
	ТаблицаМатериалов 	= РезультатЗапроса[1].Выгрузить();
	
	Для Каждого ТекущаяСтрока Из ТаблицаТоваров Цикл
		
		//#12535
		Если ТекущаяСтрока.КоличествоКОбеспечению <= 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Добавлять = Ложь;		
		Если Справочники.ВидыНоменклатуры.ЭтоНоменклатураПотолкаИлиОтреза(ТекущаяСтрока.Номенклатура) Тогда
			Добавлять = Истина;
		ИначеЕсли НЕ Справочники.ВидыНоменклатуры.ЭтоНоменклатураУслуга(ТекущаяСтрока.Номенклатура) И НастройкаИнтеркампани.ЗаказПоставщикуЗаказыватьТовары Тогда 
			Добавлять = Истина;
		КонецЕсли;
		
		//#4686
		Если ТекущаяСтрока.КоличествоКОбеспечению = 0 И ТекущаяСтрока.ОбеспеченоПроизводством = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Если Добавлять Тогда
			СтруктураТовара = Новый Структура;
			СтруктураТовара.Вставить("Комната", 					ТекущаяСтрока.Комната);
			СтруктураТовара.Вставить("Номенклатура", 				ТекущаяСтрока.Номенклатура);
			СтруктураТовара.Вставить("ХарактеристикаНоменклатуры", 	ТекущаяСтрока.ХарактеристикаНоменклатуры);
			СтруктураТовара.Вставить("ВидНоменклатуры", 			ТекущаяСтрока.ВидНоменклатуры);
			СтруктураТовара.Вставить("Количество", 					ТекущаяСтрока.Количество);
			СтруктураТовара.Вставить("КоличествоКОбеспечению", 		ТекущаяСтрока.КоличествоКОбеспечению);
			СтруктураТовара.Вставить("ЕдиницаИзмерения", 			ТекущаяСтрока.ЕдиницаИзмерения);
			СтруктураТовара.Вставить("НомерСтроки", 				ТекущаяСтрока.НомерСтроки);
			СтруктураТовара.Вставить("НомерПотолка", 				ТекущаяСтрока.НомерПотолка);
			СтруктураТовара.Вставить("Коэффициент", 				ТекущаяСтрока.Коэффициент);
			//СтруктураТовара.Вставить("ПроцентСкидки", 				ТекущаяСтрока.ПроцентСкидки);
			//СтруктураТовара.Вставить("Цена", 						ТекущаяСтрока.Цена);
			//СтруктураТовара.Вставить("СуммаСкидки", 				ТекущаяСтрока.СуммаСкидки);
			//СтруктураТовара.Вставить("Сумма", 						ТекущаяСтрока.Сумма);
			СтруктураТовара.Вставить("Назначение", 					ТекущаяСтрока.Назначение);
			СписокТоваров.Добавить(СтруктураТовара);
		КонецЕсли;
		
	КонецЦикла;
	
	Если НастройкаИнтеркампани.ЗаказПоставщикуЗаказыватьМатериалы Тогда
		Для Каждого ТекущаяСтрока Из ТаблицаМатериалов Цикл
			
			Если НЕ ЗначениеЗаполнено(ТекущаяСтрока.Номенклатура) Тогда
				// строка комнаты
				Продолжить;
			КонецЕсли;
			
			//#4686
			Если ТекущаяСтрока.КоличествоКОбеспечению = 0 И ТекущаяСтрока.ОбеспеченоПроизводством = 0 Тогда
				Продолжить;
			КонецЕсли;
			
			Добавлять = Ложь;			
			Если НЕ Справочники.ВидыНоменклатуры.ЭтоНоменклатураУслуга(ТекущаяСтрока.Номенклатура) Тогда 
				Добавлять = Истина;
			КонецЕсли;
			
			Если Добавлять Тогда
				СтруктураТовара = Новый Структура;
				СтруктураТовара.Вставить("Комната", 					ТекущаяСтрока.Комната);
				СтруктураТовара.Вставить("Номенклатура", 				ТекущаяСтрока.Номенклатура);
				СтруктураТовара.Вставить("ХарактеристикаНоменклатуры", 	ТекущаяСтрока.ХарактеристикаНоменклатуры);
				СтруктураТовара.Вставить("ВидНоменклатуры", 			ТекущаяСтрока.ВидНоменклатуры);
				СтруктураТовара.Вставить("Количество", 					ТекущаяСтрока.Количество);
				СтруктураТовара.Вставить("КоличествоКОбеспечению", 		ТекущаяСтрока.КоличествоКОбеспечению);
				СтруктураТовара.Вставить("ЕдиницаИзмерения", 			ТекущаяСтрока.ЕдиницаИзмерения);
				СтруктураТовара.Вставить("НомерСтроки", 				ТекущаяСтрока.НомерСтроки);
				СтруктураТовара.Вставить("НомерПотолка", 				"");
				СтруктураТовара.Вставить("Коэффициент", 				ТекущаяСтрока.Коэффициент);
				//СтруктураТовара.Вставить("ПроцентСкидки", 				0); 
				//СтруктураТовара.Вставить("Цена", 						0); 
				//СтруктураТовара.Вставить("СуммаСкидки", 				0); 
				//СтруктураТовара.Вставить("Сумма", 						0);
				СтруктураТовара.Вставить("Назначение", 					ТекущаяСтрока.Назначение);
				СписокТоваров.Добавить(СтруктураТовара);
			КонецЕсли;
			
		КонецЦикла;	
	КонецЕсли;
	
	//++16864  Сворачиваем таблицу товаров и материалов по номенклатуре и характеристике
	Если Константы.ИспользоватьИнтеркампани.Получить() И НЕ Константы.УчетОбеспеченностиРозницыПоКомнатам.Получить() Тогда
		Яндекс =0;
		Пока Яндекс<СписокТоваров.Количество() Цикл
			Индекс = Яндекс+1;
			Пока Индекс<СписокТоваров.Количество() Цикл
					Если СписокТоваров[Яндекс].Номенклатура = СписокТоваров[Индекс].Номенклатура И СписокТоваров[Яндекс].ХарактеристикаНоменклатуры = СписокТоваров[Индекс].ХарактеристикаНоменклатуры И СписокТоваров[Яндекс].ВидНоменклатуры = Справочники.ВидыНоменклатуры.Материал Тогда
						СписокТоваров[Яндекс].Количество=СписокТоваров[Яндекс].Количество + СписокТоваров[Индекс].Количество;
						СписокТоваров[Яндекс].КоличествоКОбеспечению=СписокТоваров[Яндекс].КоличествоКОбеспечению + СписокТоваров[Индекс].КоличествоКОбеспечению;
						СписокТоваров.Удалить(Индекс);
						Индекс = Индекс-1;	
					КонецЕсли;	
				Индекс = Индекс+1;	
			КонецЦикла;	
			Яндекс = Яндекс+1;
		КонецЦикла;
	КонецЕсли;	
	//--16864
	
	Возврат СписокТоваров;
	
КонецФункции

Функция ПроверитьСписокТоваровКПроизводствуИзРозницы(СписокТоваров, МассивСообщений) Экспорт
	
	Результат = Истина;
	
	//++ #15176
	Для каждого СтрокаТовара из СписокТоваров Цикл
		Если Справочники.ВидыНоменклатуры.ЭтоНоменклатураУникальнойПродукции(СтрокаТовара.Номенклатура) Тогда
			Для каждого СтрокаТовараДубль из СписокТоваров Цикл
				Если СтрокаТовара.Номенклатура = СтрокаТовараДубль.Номенклатура 
					И НЕ СтрокаТовара.НомерСтроки = СтрокаТовараДубль.НомерСтроки Тогда
					МассивСообщений.Добавить(СтрШаблон("Дублируется продукция ""%1"".", СтрокаТовара.Номенклатура));
					Результат = Ложь;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция РеквизитыЗаказаПоИнтеркампани(НастройкаИнтеркампани, ДополнительныеПараметры = Неопределено) Экспорт
	
	СтруктураРеквизитов = Новый Структура("Дата, Валюта,
	| НастройкаИнтеркампани, ТекущийСтатус, Организация, Подразделение, Склад,
	| Контрагент, ДоговорКонтрагента, ВидЦен, 
	| УчитыватьНДС,
	| ОднаОрганизацияПроизводстваИПродажиПотолков");
	
	СтруктураРеквизитов.НастройкаИнтеркампани = НастройкаИнтеркампани;	
	СтруктураРеквизитов.ТекущийСтатус 		= Справочники.СтатусыЗаказовПокупателей.НачальныйСтатусПоИнтеркампани(НастройкаИнтеркампани);		
	СтруктураРеквизитов.Организация 		= НастройкаИнтеркампани.ОрганизацияПроизводствоПотолков;
	//++ 16340
	Если Константы.ИспользоватьПодразделения.Получить() Тогда
		СтруктураРеквизитов.Подразделение 		= НастройкаИнтеркампани.ПроизводствоПодразделение;
	КонецЕсли;
	//-- 16340
	СтруктураРеквизитов.Склад 				= НастройкаИнтеркампани.ПроизводствоСкладОтгрузкиИзПроизводства;
	СтруктураРеквизитов.Валюта 				= Константы.ВалютаУчета.Получить();
	СтруктураРеквизитов.Дата 				= ТекущаяДатаСеанса();
	СтруктураРеквизитов.УчитыватьНДС 		= УчетНДС.ОрганизацияЯвляетсяПлательщикомНДС(СтруктураРеквизитов.Организация);
	
	Если НЕ НастройкаИнтеркампани.ОднаОрганизацияПроизводстваИПродажиПотолков Тогда
		СтруктураРеквизитов.Контрагент = НастройкаИнтеркампани.КонтрагентПроизводствоПотолков;
		СтруктураРеквизитов.ДоговорКонтрагента = СтруктураРеквизитов.Контрагент.ОсновнойДоговор;
	Иначе
		//++ №7908 если одна организация продажи и потолков, устанавливаем контрагента по соответствующей настройке
		Если НастройкаИнтеркампани.УказыватьКонтрагентаРозницыВЗаказахНаПроизводство Тогда
			СтруктураРеквизитов.Контрагент = НастройкаИнтеркампани.КонтрагентРозничныеПродажи;
			СтруктураРеквизитов.ДоговорКонтрагента = СтруктураРеквизитов.Контрагент.ОсновнойДоговор;
		Иначе
			//-- №7908
			СтруктураРеквизитов.Контрагент = Справочники.Контрагенты.ПустаяСсылка();
			СтруктураРеквизитов.ДоговорКонтрагента = Справочники.ДоговорыКонтрагентов.ПустаяСсылка();
		КонецЕсли;	
	КонецЕсли;
	
	Если НЕ НастройкаИнтеркампани.ОднаОрганизацияПроизводстваИПродажиПотолков Тогда
		СтруктураРеквизитов.ВидЦен = НастройкаИнтеркампани.ПроизводствоВидЦенТовары;
	Иначе
		СтруктураРеквизитов.ВидЦен = Справочники.ВидыЦен.ПустаяСсылка();
	КонецЕсли;
	
	СтруктураРеквизитов.ОднаОрганизацияПроизводстваИПродажиПотолков = НастройкаИнтеркампани.ОднаОрганизацияПроизводстваИПродажиПотолков;
	
	Если НЕ ДополнительныеПараметры = Неопределено Тогда
		Для каждого ЭлементСтруктуры из ДополнительныеПараметры Цикл
			СтруктураРеквизитов.Вставить(ЭлементСтруктуры.Ключ, ЭлементСтруктуры.Значение);	
		КонецЦикла;
	КонецЕсли;
	
	Возврат СтруктураРеквизитов;
	
КонецФункции

// Подготовка / заполнение таблицы товаров и материалов
// НастройкаИнтеркампани - настройка, по которой создается Заказ покупателя из документа розницы
// МассивПотолков - массив потолков к заказу
// СоответствиеНомеровИПотолков - для получения потолка по номеру расчета
// РеквизитыШапки - реквзиты заказ покупателя (Дата, Валюта, Организация и прочее)
// ПозицииКЗаказу - выбранные строки к заказу: табличная часть или массив строк (найденный через НайтиСтроки)
// ТаблицаТоваров - табличная часть Заказа покупателя или Таблица значений с соответствующими колонками
// ТаблицаМатериалов - табличная часть Заказа покупателя
Функция ПодготовитьТаблицыЗаказаПоИнтеркампани(НастройкаИнтеркампани,
	МассивПотолков, СоответствиеНомеровИПотолков,
	РеквизитыШапки, ПозицииКЗаказу, ТаблицаТоваров, ТаблицаМатериалов=Неопределено, ВозвратПриОшибке = Ложь) Экспорт
	// ВозвратПриОшибке - параметр добавлен в рамках заявки #7909
	
	Для Каждого ТекущаяСтрока Из ПозицииКЗаказу Цикл
		Если Справочники.ВидыНоменклатуры.ЭтоНоменклатураПотолкаИлиОтреза(ТекущаяСтрока.Номенклатура) Тогда
			//потолок
			ОписаниеОшибки = "";
			СтруктураПотолка = ОбменСEasyCeiling.ПолучитьСтруктуруПотолка(ТекущаяСтрока.Номенклатура,,,,,,, ОписаниеОшибки);
			Если СтруктураПотолка = Неопределено Тогда
				Если ВозвратПриОшибке Тогда
					Возврат Ложь;
				Иначе
					Продолжить;
				КонецЕсли;
			КонецЕсли;
			Если ЗначениеЗаполнено(ОписаниеОшибки) Тогда
				Сообщить(ОписаниеОшибки);
				Если ВозвратПриОшибке Тогда
					Возврат Ложь;
				Иначе
					Продолжить;
				КонецЕсли;
			КонецЕсли;
			ДанныеЗаказа = ОбменСEasyCeiling.СтруктураДанныхЗаказа(РеквизитыШапки.Организация, РеквизитыШапки.Подразделение, НастройкаИнтеркампани,
											РеквизитыШапки.ВидЦен, РеквизитыШапки.Валюта, РеквизитыШапки.Дата, 
											РеквизитыШапки.УчитыватьНДС, , РеквизитыШапки.ДоговорКонтрагента);
			СтруктураЗаказа = ОбменСEasyCeiling.ПолучитьСтруктуруЗаказа(СтруктураПотолка, Перечисления.ВидыЗаказов.ЗаказПокупателя, ДанныеЗаказа);				
			//СтруктураЗаказа = ОбменСEasyCeiling.ПолучитьСтруктуруЗаказа(СтруктураПотолка, НастройкаИнтеркампани, РеквизитыШапки.ВидЦен, 
			//										РеквизитыШапки.Валюта, РеквизитыШапки.Дата, 
			//										Перечисления.ВидыЗаказов.ЗаказПокупателя, 
			//										РеквизитыШапки.УчитыватьНДС, , РеквизитыШапки.ДоговорКонтрагента);
			
			НоваяСтрока = ТаблицаТоваров.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущаяСтрока);
			УИСПродукция = Новый УникальныйИдентификатор;
			НоваяСтрока.УИСтроки = УИСПродукция;
			НоваяСтрока.УИСтрокиРодителя = УИСПродукция;
			Если РеквизитыШапки.Свойство("АдресМонтажа") Тогда
				НоваяСтрока.АдресМонтажа = РеквизитыШапки.АдресМонтажа;
			КонецЕсли;
			НоваяСтрока.КоличествоКВыработке = СтруктураЗаказа.КоличествоВыработка;
			
			//#4679
			Если ПолучитьФункциональнуюОпцию("КоличествоТоваровКСписаниюВРозницеНеСоответствуетКоличествуПроданногоТовара") Тогда
				НоваяСтрока.Количество = НоваяСтрока.Номенклатура.Потолок_КоличествоПродукция;
				НоваяСтрока.Сумма = НоваяСтрока.Цена * НоваяСтрока.Количество;
			КонецЕсли;
			
			НоваяСтрока.Сумма = СтруктураЗаказа.Сумма;
			СуммаБезСкидки = НоваяСтрока.Сумма;						
			
			НоваяСтрока.Сумма = СуммаБезСкидки - НоваяСтрока.СуммаРучнойСкидки;
			Если НЕ НоваяСтрока.Количество = 0 Тогда
				НоваяСтрока.Цена = СуммаБезСкидки / НоваяСтрока.Количество;
			КонецЕсли;
			
			//услуги раскроя
			Для Каждого ТекУслуга Из СтруктураЗаказа.Услуги Цикл
				Если ТекУслуга.ЭтоУслугаРаскроя Тогда							
					//#5466
					//ДанныеСтроки = Новый Структура("Потолок,ЗагруженоИзПостроителя,Комната,Назначение,УИСтроки,УИСтрокиРодителя",
					//СтруктураЗаказа.ПродукцияНоменклатура, Истина, ТекущаяСтрока.Комната, ТекущаяСтрока.Назначение, новый УникальныйИдентификатор, УИСПродукция);
					ДанныеСтроки = Новый Структура("Потолок,ЗагруженоИзПостроителя,Комната,Назначение,УИСтроки,УИСтрокиРодителя,ЭтоУслугаРаскроя,УслугаРаскроя",
					СтруктураЗаказа.ПродукцияНоменклатура, Истина, ТекущаяСтрока.Комната, ТекущаяСтрока.Назначение, новый УникальныйИдентификатор, УИСПродукция,Истина,ТекУслуга.УслугаРаскроя);								
					НоваяСтрокаТовары = ОбработкаТабличныхЧастейСервер.ДобавитьОбновитьСтрокуВТЧЗаказПокупателя(ТаблицаТоваров, ТекУслуга, ДанныеСтроки);
				КонецЕсли;
			КонецЦикла;
			
			//товары
			Для Каждого ТекУслуга Из СтруктураЗаказа.Товары Цикл
				Если ТекУслуга.ЭтоУслугаРаскроя Тогда							
					//#5466
					//ДанныеСтроки = Новый Структура("Потолок,ЗагруженоИзПостроителя,Комната,Назначение,УИСтроки,УИСтрокиРодителя",
					//СтруктураЗаказа.ПродукцияНоменклатура, Истина, ТекущаяСтрока.Комната, ТекущаяСтрока.Назначение, Новый УникальныйИдентификатор, УИСПродукция);
					ДанныеСтроки = Новый Структура("Потолок,ЗагруженоИзПостроителя,Комната,Назначение,УИСтроки,УИСтрокиРодителя,ЭтоУслугаРаскроя,УслугаРаскроя",
					СтруктураЗаказа.ПродукцияНоменклатура, Истина, ТекущаяСтрока.Комната, ТекущаяСтрока.Назначение, новый УникальныйИдентификатор, УИСПродукция,Истина,ТекУслуга.УслугаРаскроя);
					НоваяСтрокаТЧ = ОбработкаТабличныхЧастейСервер.ДобавитьОбновитьСтрокуВТЧЗаказПокупателя(ТаблицаТоваров, ТекУслуга, ДанныеСтроки);												
				КонецЕсли;
			КонецЦикла;				
			
			//прочие товары и услуги (не услуги раскроя), в частности по расширенным правилам
			Для Каждого ТекУслуга Из СтруктураЗаказа.Товары Цикл
				Если НЕ ТекУслуга.ЭтоУслугаРаскроя Тогда
					ДанныеСтроки = Новый Структура("Потолок,ЗагруженоИзПостроителя,Комната,Назначение,УИСтроки,УИСтрокиРодителя",
					СтруктураЗаказа.ПродукцияНоменклатура, Истина, ТекущаяСтрока.Комната, ТекущаяСтрока.Назначение, Новый УникальныйИдентификатор, УИСПродукция);								
					НоваяСтрокаТЧ = ОбработкаТабличныхЧастейСервер.ДобавитьОбновитьСтрокуВТЧЗаказПокупателя(ТаблицаТоваров, ТекУслуга, ДанныеСтроки);
					
				КонецЕсли;
			КонецЦикла;
			Для Каждого ТекУслуга Из СтруктураЗаказа.Услуги Цикл
				Если НЕ ТекУслуга.ЭтоУслугаРаскроя Тогда
					ДанныеСтроки = Новый Структура("Потолок,ЗагруженоИзПостроителя,Комната,Назначение,УИСтроки,УИСтрокиРодителя",
					СтруктураЗаказа.ПродукцияНоменклатура, Истина, ТекущаяСтрока.Комната, ТекущаяСтрока.Назначение, Новый УникальныйИдентификатор, УИСПродукция);								
					НоваяСтрокаТЧ = ОбработкаТабличныхЧастейСервер.ДобавитьОбновитьСтрокуВТЧЗаказПокупателя(ТаблицаТоваров, ТекУслуга, ДанныеСтроки);
					
				КонецЕсли;
			КонецЦикла;
			
			// добавлено 2019-01-21
			Если НЕ ТаблицаМатериалов=Неопределено Тогда
				Для Каждого ТекущаяСтрока Из СтруктураЗаказа.Материалы Цикл
					ДопДанныеСтроки = Новый Структура("Потолок,ЗагруженоИзПостроителя,УИСтроки", СтруктураЗаказа.ПродукцияНоменклатура, Истина, УИСПродукция);								
					НоваяСтрокаТЧ = ОбработкаТабличныхЧастейСервер.ДобавитьОбновитьСтрокуВТЧЗаказПокупателя(ТаблицаМатериалов, ТекущаяСтрока, ДопДанныеСтроки);
				КонецЦикла;
			КонецЕсли;
			
		Иначе
			//товар или услуга
			НоваяСтрока = ТаблицаТоваров.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущаяСтрока);
			
			НоваяСтрока.Цена = РегистрыСведений.ЦеныНоменклатуры.ПолучитьЦенуНоменклатуры(НоваяСтрока.Номенклатура, НоваяСтрока.ХарактеристикаНоменклатуры, 
										НоваяСтрока.ЕдиницаИзмерения, 
										РеквизитыШапки.Дата, РеквизитыШапки.ВидЦен, РеквизитыШапки.Валюта, 
										РеквизитыШапки.Контрагент, РеквизитыШапки.ДоговорКонтрагента);
			
			СуммаБезСкидки = НоваяСтрока.Цена * НоваяСтрока.Количество;												
			Если НЕ РеквизитыШапки.ДоговорКонтрагента.СкидкаНаТовары = 0 Тогда
				НоваяСтрока.ПроцентРучнойСкидки = РеквизитыШапки.ДоговорКонтрагента.СкидкаНаТовары;
				НоваяСтрока.СуммаРучнойСкидки = СуммаБезСкидки * НоваяСтрока.ПроцентРучнойСкидки / 100; 
			Иначе
				НоваяСтрока.ПроцентРучнойСкидки = 0;
				НоваяСтрока.СуммаРучнойСкидки = 0; 														
			КонецЕсли;	
			НоваяСтрока.Сумма = СуммаБезСкидки - НоваяСтрока.СуммаРучнойСкидки;
			
			Если РеквизитыШапки.Свойство("АдресМонтажа") Тогда
				НоваяСтрока.АдресМонтажа = РеквизитыШапки.АдресМонтажа;
			КонецЕсли;
			НоваяСтрока.УИСтроки = Новый УникальныйИдентификатор;
			НоваяСтрока.Спецификация = ОбщийМодульВызовСервера.ПолучитьОсновнуюСпецификациюНоменклатуры(НоваяСтрока.Номенклатура, Перечисления.ВидыСпецификации.СпецификацияПродукции);
			
			ПолучитьПотолок = СоответствиеНомеровИПотолков.Получить(ТекущаяСтрока.НомерПотолка);
			ПолучитьПотолок = Неопределено; // №11099 к потолку привязываем только его производственные услуги (выше где формируется потолок)
			
			Если НЕ ПолучитьПотолок = Неопределено Тогда
				НоваяСтрока.Потолок = ПолучитьПотолок;
				//НоваяСтрока.УИСтрокиРодителя = ; //потолка еще может не быть, УИС проставим ниже
			Иначе
				НоваяСтрока.УИСтрокиРодителя = НоваяСтрока.УИСтроки;
			КонецЕсли;
			
			//++ №12667 по конструкции добавляем материалы
			Если НЕ ТаблицаМатериалов = Неопределено
				И Справочники.ВидыНоменклатуры.ЭтоНоменклатураПродукция(НоваяСтрока.Номенклатура)
				И ЗначениеЗаполнено(НоваяСтрока.Спецификация)
				Тогда
				
				Для Каждого СтрокаСпецификации Из НоваяСтрока.Спецификация.Состав Цикл
					
					ДопДанныеСтроки = Новый Структура("Потолок, УИСтроки", НоваяСтрока.Номенклатура, НоваяСтрока.УИСтроки);								
					НоваяСтрокаТЧ = ОбработкаТабличныхЧастейСервер.ДобавитьОбновитьСтрокуВТЧЗаказПокупателя(ТаблицаМатериалов, СтрокаСпецификации, ДопДанныеСтроки);
					
					КоэффициентИзменения = ?(СтрокаСпецификации.ФиксированноеКоличество, 1, НоваяСтрока.Количество * НоваяСтрока.Коэффициент);
					КоличествоКДобавлению = ОбщийМодуль.ОкруглитьЧисло(КоэффициентИзменения * СтрокаСпецификации.Количество, СтрокаСпецификации.ПорядокОкругленияЧислом, СтрокаСпецификации.ОкруглятьВБольшуюСторону); 
					
					НоваяСтрокаТЧ.Количество = КоличествоКДобавлению;
					НоваяСтрокаТЧ.КоличествоКВыработке = КоличествоКДобавлению;
					
				КонецЦикла;
				
			КонецЕсли;
			//-- №12667
			
		КонецЕсли;
		
	КонецЦикла; //заполняем табличную часть
	
	// округляем 
	ПорядокОкругления = Константы.ПорядокОкругленияЧисломСтоимостиПотолков.Получить();
	//ТребуетсяОкругление = (ПорядокОкругления > 0);
	ТребуетсяОкругление = Константы.ОкруглятьСтоимостьПотолка.Получить() И (ПорядокОкругления > 0);
	Если ТребуетсяОкругление Тогда
		
		ОкруглятьВБольшуюСторону = Константы.ОкруглятьВБольшуюСторонуСтоимостьПотолков.Получить();
		СпособОкругления = Константы.СпособОкругленияСтоимостиПотолков.Получить();
		ВариантОкругления = Константы.СпособОкругленияСтоимостиПотолков.Получить();
		ТребуетсяОкруглениеСоставляющих = (СпособОкругления = 1);
		ТребуетсяОкруглениеПотолка      = (СпособОкругления = 0);
		
		Для каждого ЭлементПотолок из МассивПотолков Цикл
			Если ТребуетсяОкруглениеСоставляющих Тогда
				Для каждого СтрокаТЧ из ТаблицаТоваров Цикл
					Если СтрокаТЧ.Номенклатура = ЭлементПотолок ИЛИ СтрокаТЧ.Потолок = ЭлементПотолок Тогда
						ОбработкаТабличныхЧастейСервер.ОкруглитьСтрокуТЧ(СтрокаТЧ, ПорядокОкругления, ОкруглятьВБольшуюСторону, ВариантОкругления);
					КонецЕсли;
					
				КонецЦикла;
			ИначеЕсли ТребуетсяОкруглениеПотолка Тогда	
				
				ИтоговаяСуммаПотолка = 0;
				Для каждого СтрокаТЧ из ТаблицаТоваров Цикл
					Если СтрокаТЧ.Номенклатура = ЭлементПотолок ИЛИ СтрокаТЧ.Потолок = ЭлементПотолок Тогда
						ИтоговаяСуммаПотолка = ИтоговаяСуммаПотолка + СтрокаТЧ.Сумма;
					КонецЕсли;
				КонецЦикла;
				ОкругленнаяИтоговаяСуммаПотолка = ОбщийМодуль.ОкруглитьЧисло(ИтоговаяСуммаПотолка, ПорядокОкругления, ОкруглятьВБольшуюСторону);
				НайденнаяСтрокаПотолка = ТаблицаТоваров.НайтиСтроки(Новый Структура("Номенклатура", ЭлементПотолок));
				Если НайденнаяСтрокаПотолка.Количество() > 0  Тогда
					НайденнаяСтрокаПотолка[0].Сумма = НайденнаяСтрокаПотолка[0].Сумма - (ИтоговаяСуммаПотолка - ОкругленнаяИтоговаяСуммаПотолка); 
					
					Если ВариантОкругления = 0 Тогда
						//изменять цену после округления
						Если НЕ НайденнаяСтрокаПотолка[0].Количество = 0 Тогда
							СуммаБезСкидки = НайденнаяСтрокаПотолка[0].Сумма + НайденнаяСтрокаПотолка[0].СуммаРучнойСкидки;
							НайденнаяСтрокаПотолка[0].Цена = Окр(СуммаБезСкидки / НайденнаяСтрокаПотолка[0].Количество, 2);
						КонецЕсли;
					Иначе
						//изменять сумму ручной скидки
						НайденнаяСтрокаПотолка[0].СуммаСкидки = НайденнаяСтрокаПотолка[0].СуммаСкидки + (ИтоговаяСуммаПотолка - ОкругленнаяИтоговаяСуммаПотолка);
						ОбработкаТабличныхЧастейСервер.ПересчитатьПроцентРучнойСкидкиВСтрокеТЧ(НайденнаяСтрокаПотолка[0]);					
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

Функция ПустаяТаблицаКЗаказу()
	
	ТаблицаКЗаказу = Новый ТаблицаЗначений;
	ТаблицаКЗаказу.Колонки.Добавить("Комната", Новый ОписаниеТипов("строка"));
	ТаблицаКЗаказу.Колонки.Добавить("Номенклатура");
	ТаблицаКЗаказу.Колонки.Добавить("ХарактеристикаНоменклатуры");
	ТаблицаКЗаказу.Колонки.Добавить("Количество");
	ТаблицаКЗаказу.Колонки.Добавить("ЕдиницаИзмерения");
	ТаблицаКЗаказу.Колонки.Добавить("НомерСтроки");
	ТаблицаКЗаказу.Колонки.Добавить("ВидНоменклатуры");
	ТаблицаКЗаказу.Колонки.Добавить("НомерПотолка");
	ТаблицаКЗаказу.Колонки.Добавить("ЗаказПокупателяНаПроизводство");
	ТаблицаКЗаказу.Колонки.Добавить("Коэффициент");
	ТаблицаКЗаказу.Колонки.Добавить("Назначение", новый ОписаниеТипов("Строка",, новый КвалификаторыСтроки(25)));
	
	ТаблицаКЗаказу.Колонки.Добавить("ПроцентРучнойСкидки", Новый ОписаниеТипов("Число"));
	ТаблицаКЗаказу.Колонки.Добавить("Цена", Новый ОписаниеТипов("Число"));
	ТаблицаКЗаказу.Колонки.Добавить("СуммаРучнойСкидки", Новый ОписаниеТипов("Число"));
	ТаблицаКЗаказу.Колонки.Добавить("Сумма", Новый ОписаниеТипов("Число"));
	
	Возврат ТаблицаКЗаказу;
	
КонецФункции

Функция СоздатьЗаказыПокупателейНаПроизводствоИзРозницы(ДокументСсылка, МассивНоменклатуры, НастройкаИнтеркампани, СтруктураДанных) Экспорт
	
	ТаблицаКЗаказу = ПустаяТаблицаКЗаказу();
	
	Для каждого ЭлементМассива из МассивНоменклатуры Цикл				
		НоваяСтрока = ТаблицаКЗаказу.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ЭлементМассива, 
		"НомерСтроки, Комната, Номенклатура, ХарактеристикаНоменклатуры, 
		| Количество, ЕдиницаИзмерения, НомерПотолка, Коэффициент, 
		//| ПроцентСкидки, СуммаСкидки, Цена, Сумма, 
		| Назначение");
		
		НоваяСтрока.ВидНоменклатуры = НоваяСтрока.Номенклатура.ВидНоменклатуры;
		Если НоваяСтрока.ВидНоменклатуры = Справочники.ВидыНоменклатуры.ТиповойОтрез
			ИЛИ НоваяСтрока.ВидНоменклатуры = Справочники.ВидыНоменклатуры.Потолок Тогда
			СоздаватьЗаказыНаЕдиничноеПроизводство = Истина;
		ИначеЕсли НоваяСтрока.ВидНоменклатуры = Справочники.ВидыНоменклатуры.Материал
			ИЛИ НоваяСтрока.ВидНоменклатуры = Справочники.ВидыНоменклатуры.Полотно Тогда
			СоздаватьЗаказыНаТиповоеПроизводство = Истина;
		КонецЕсли;
	КонецЦикла;
	
	ПотолокПоНомеруРасчета = Новый Соответствие;
	ЗаказПоНомеруРасчета   = Новый Соответствие;
	МассивПотолков = Новый Массив;
	Для Каждого ТекущаяСтрока Из ТаблицаКЗаказу Цикл
		Если Справочники.ВидыНоменклатуры.ЭтоНоменклатураПотолкаИлиОтреза(ТекущаяСтрока.Номенклатура) Тогда
			ПотолокПоНомеруРасчета.Вставить(ТекущаяСтрока.НомерПотолка, ТекущаяСтрока.Номенклатура);						
			МассивПотолков.Добавить(ТекущаяСтрока.Номенклатура);
		КонецЕсли;
	КонецЦикла;
	
	// получим заказы покупателя (на производство по потолкам)
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("МассивПотолков", МассивПотолков);
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЗаказыПоПотолкам.ЗаказНаПроизводство КАК ЗаказПокупателяНаПроизводство,
	|	ЗаказыПоПотолкам.Номенклатура КАК Номенклатура,
	|	ЗаказыПоПотолкам.Номенклатура.Потолок_НомерРасчета КАК НомерПотолка
	|ИЗ
	|	РегистрНакопления.ЗаказыПокупателей.Обороты(
	|			,
	|			,
	|			,
	|			ТИПЗНАЧЕНИЯ(ЗаказНаПроизводство) = ТИП(Документ.ЗаказПокупателя)
	|				И номенклатура В (&МассивПотолков)) КАК ЗаказыПоПотолкам";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ЗаказПоНомеруРасчета.Вставить(Выборка.НомерПотолка, Выборка.ЗаказПокупателяНаПроизводство);
	КонецЦикла;
	
	Для каждого СтрокаЗаказа из ТаблицаКЗаказу Цикл
		СтрокаЗаказа.ЗаказПокупателяНаПроизводство = ЗаказПоНомеруРасчета.Получить(СтрокаЗаказа.НомерПотолка);
	КонецЦикла;
	
	ТаблицаЗаказов = ТаблицаКЗаказу.Скопировать();
	ТаблицаЗаказов.Свернуть("ЗаказПокупателяНаПроизводство");
	
	СтруктураРезультата = Новый Структура;
	СтруктураРезультата.Вставить("СозданоНовых",0);
	СтруктураРезультата.Вставить("Обновлено",0);
	
	СсылкаНаНовыйЗаказ = Документы.ЗаказПокупателя.ПустаяСсылка();
	
	Для Каждого ТекущийЗаказ Из ТаблицаЗаказов Цикл
		
		//определяем - создаватьдокумент или перезаполнять существующий
		СоздатьЗаказ = Ложь;
		Если НЕ ТекущийЗаказ.ЗаказПокупателяНаПроизводство = Неопределено Тогда
			Если ТекущийЗаказ.ЗаказПокупателяНаПроизводство.Пустая() Тогда
				СоздатьЗаказ = Истина;
			КонецЕсли;
		Иначе
			СоздатьЗаказ = Истина;
		КонецЕсли;
		Если НЕ СоздатьЗаказ Тогда
			ЗаказПокупателя = ТекущийЗаказ.ЗаказПокупателяНаПроизводство.ПолучитьОбъект();
		Иначе
			ЗаказПокупателя = Документы.ЗаказПокупателя.СоздатьДокумент();
			ЗаказПокупателя.Заполнить(Неопределено);
			ЗаказПокупателя.Дата = ТекущаяДатаСеанса();			
		КонецЕсли;
		
		//заполняем шапку
		ОбщийМодуль.ЗаполнитьШапкуДокумента(ЗаказПокупателя);
		ДопПараметры = Новый Структура;
		ДопПараметры.Вставить("АдресМонтажа", 		ДокументСсылка.Адрес);
		ДопПараметры.Вставить("Основание", 			ДокументСсылка);
		ДопПараметры.Вставить("ЭтоЗаказОтРозницы", 	Истина);
		// №7688 могут создавать на основании монтажа, поэтому номер договора определим по типу документа
		//ДопПараметры.Вставить("НомерРозничногоДоговора", ДокументСсылка.НомерДоговора); // #7381
		НомерДоговора = "";
		Если ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.ЗаказДоговор") Тогда
			НомерДоговора = ДокументСсылка.НомерДоговора;
		ИначеЕсли ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.Монтаж") И ТипЗнч(ДокументСсылка.Основание) = Тип("ДокументСсылка.ЗаказДоговор") Тогда
			НомерДоговора = ДокументСсылка.Основание.НомерДоговора;
		КонецЕсли;
		ДопПараметры.Вставить("НомерРозничногоДоговора", НомерДоговора);
		
		СтруктураШапки = РеквизитыЗаказаПоИнтеркампани(НастройкаИнтеркампани, ДопПараметры);
		ЗаполнитьЗначенияСвойств(ЗаказПокупателя, СтруктураШапки, , "Дата");
		
		// №7908 Теперь из формы, передаются дополнительные параметры в структуре
		ЗаполнитьЗначенияСвойств(ЗаказПокупателя, СтруктураДанных, "ОжидаемаяДатаОтгрузки, ОжидаемоеВремяОтгрузки");
		
		//заполняем табличную часть
		ЗаказПокупателя.Товары.Очистить();
		ПозицииКЗаказу = ТаблицаКЗаказу.НайтиСтроки(Новый Структура("ЗаказПокупателяНаПроизводство", ТекущийЗаказ.ЗаказПокупателяНаПроизводство));
		РезультатПодготовкиТЧ = ПодготовитьТаблицыЗаказаПоИнтеркампани(НастройкаИнтеркампани,
																		МассивПотолков, ПотолокПоНомеруРасчета,
																		СтруктураШапки, ПозицииКЗаказу, 
																		ЗаказПокупателя.Товары, ЗаказПокупателя.Материалы, Истина);
		
		Если НЕ РезультатПодготовкиТЧ Тогда
			Возврат Неопределено;
		КонецЕсли;
		
		ЗаказПокупателя.СуммаДокумента = ЗаказПокупателя.Товары.Итог("Сумма");
		
		//заполним номера потолков, если это заказ покупателя
		Если ТипЗнч(ЗаказПокупателя) = Тип("ДокументОбъект.ЗаказПокупателя") Тогда
			ТаблицаНомеров = Новый ТаблицаЗначений;
			ТаблицаНомеров.Колонки.Добавить("Номер");
			
			Для Каждого ВерхняяСтрока Из ЗаказПокупателя.Товары Цикл
				НомерПотолка = ВерхняяСтрока.Номенклатура.Потолок_НомерРасчета;
				Если НЕ ПустаяСтрока(НомерПотолка) Тогда
					НоваяСтрока = ТаблицаНомеров.Добавить();
					НоваяСтрока.Номер = НомерПотолка;
				КонецЕсли;
				
				//проставим УИС родителя
				Если ЗначениеЗаполнено(ВерхняяСтрока.Потолок) И ПустаяСтрока(ВерхняяСтрока.УИСтрокиРодителя) Тогда
					НайденныеСтроки = ЗаказПокупателя.Товары.НайтиСтроки(Новый Структура("Номенклатура", ВерхняяСтрока.Потолок));
					Если НайденныеСтроки.Количество() > 0 Тогда
						ВерхняяСтрока.УИСтрокиРодителя = НайденныеСтроки[0].УИСтроки;
					КонецЕсли;
				КонецЕсли;
				
			КонецЦикла;
			
			ТаблицаНомеров.Свернуть("Номер");
			ЗаказПокупателя.НомераПотолков = "";
			Ном = 0;
			Для Каждого СтрокаНомер Из ТаблицаНомеров Цикл
				Если Ном > 0 Тогда
					ЗаказПокупателя.НомераПотолков = ЗаказПокупателя.НомераПотолков + "; ";
				КонецЕсли;
				ЗаказПокупателя.НомераПотолков = ЗаказПокупателя.НомераПотолков + СтрокаНомер.Номер;
				Ном = Ном + 1;
			КонецЦикла;
		КонецЕсли;
		
		ЗаказПокупателя.Записать();
		Если НЕ СоздатьЗаказ Тогда
			СтруктураРезультата.Обновлено = СтруктураРезультата.Обновлено + 1;
		Иначе
			СтруктураРезультата.СозданоНовых = СтруктураРезультата.СозданоНовых + 1;
			СсылкаНаНовыйЗаказ = ЗаказПокупателя.Ссылка;
		КонецЕсли;
		Попытка
			ЗаказПокупателя.Записать(РежимЗаписиДокумента.Проведение);
		Исключение
			Сообщить("Не удалось провести " + ЗаказПокупателя.Ссылка + ". Ошибка: " + ОписаниеОшибки());
		КонецПопытки;
		
	КонецЦикла; //заказ
	
	Возврат СтруктураРезультата;
	
КонецФункции

Процедура РозницаПриПолученииДанныхНаСервере(Строки, ТипДокумента, КэшКолонок) Экспорт //ИмяЭлемента, Настройки, Строки)
	
	// ПРИ ИЗМЕНЕНИИ ЗАПРОСОВ ИЗМЕНЯТЬ ПРОЦЕДУРУ ОбщийМодульСервер.ЗаказДоговорОсобыйОтборПриИзменении
	//                                           ОбщийМодульСервер.МонтажиОсобыйОтборПриИзменении
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("МассивСсылок",Строки.ПолучитьКлючи());
	
	ТекстЗапроса = "";	
	
	Если КэшКолонок.Свойство("ЕстьКолонкаСтатусЗаказаРозницыНаПроизводство") И КэшКолонок.ЕстьКолонкаСтатусЗаказаРозницыНаПроизводство Тогда
		
		ТекстЗапроса = ТекстЗапроса + 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ОбеспечениеЗаказовРозницыОбороты.Заказ КАК Заказ,
		|	ВЫБОР
		|		КОГДА ОбеспечениеЗаказовРозницыОбороты.Регистратор.ТекущийСтатус = ЗНАЧЕНИЕ(справочник.СтатусыЗаказовПокупателей.ВРаботе)
		|			ТОГДА 1
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК КоличествоЗаказовПокупателейВРаботе,
		|	ВЫБОР
		|		КОГДА ОбеспечениеЗаказовРозницыОбороты.Регистратор.ТекущийСтатус = ЗНАЧЕНИЕ(справочник.СтатусыЗаказовПокупателей.Выполнен)
		|			ТОГДА 1
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК КоличествоЗаказовПокупателейВыполненных
		|ПОМЕСТИТЬ ВТ_ЗаказыПокупателейВрем
		|ИЗ
		|	РегистрНакопления.ОбеспечениеЗаказовРозницы.Обороты(, , Авто, Заказ В (&МассивСсылок)) КАК ОбеспечениеЗаказовРозницыОбороты
		|ГДЕ
		|	ТИПЗНАЧЕНИЯ(ОбеспечениеЗаказовРозницыОбороты.Регистратор) = ТИП(Документ.ЗаказПокупателя)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВТ_ЗаказыПокупателейВрем.Заказ КАК ДокументРозницы,
		|	СУММА(ВТ_ЗаказыПокупателейВрем.КоличествоЗаказовПокупателейВРаботе) КАК КоличествоВРаботе,
		|	СУММА(ВТ_ЗаказыПокупателейВрем.КоличествоЗаказовПокупателейВыполненных) КАК КоличествоВыполненных
		|ПОМЕСТИТЬ ВТ_ЗаказыПокупателейВрем2
		|ИЗ
		|	ВТ_ЗаказыПокупателейВрем КАК ВТ_ЗаказыПокупателейВрем
		|
		|СГРУППИРОВАТЬ ПО
		|	ВТ_ЗаказыПокупателейВрем.Заказ
		|
		|;
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВТ_ЗаказыПокупателейВрем2.ДокументРозницы КАК ДокументРозницы,
		|	ВЫБОР
		|		КОГДА ВТ_ЗаказыПокупателейВрем2.КоличествоВРаботе = 0 И ВТ_ЗаказыПокупателейВрем2.КоличествоВыполненных = 0 
		|			ТОГДА -1 // нет ЗП (пусто)
		|		КОГДА ВТ_ЗаказыПокупателейВрем2.КоличествоВРаботе > 0 И ВТ_ЗаказыПокупателейВрем2.КоличествоВыполненных = 0 
		|			ТОГДА 2 // все в работе (пустой кружок)
		|		КОГДА ВТ_ЗаказыПокупателейВрем2.КоличествоВРаботе > 0 И ВТ_ЗаказыПокупателейВрем2.КоличествоВыполненных > 0 
		|			ТОГДА 1 // есть и в работе и выполненные (частично закрашен)
		|		КОГДА ВТ_ЗаказыПокупателейВрем2.КоличествоВРаботе = 0 И ВТ_ЗаказыПокупателейВрем2.КоличествоВыполненных > 0 
		|			ТОГДА 0 // все выполнены работе (полностью закрашен)
		|		ИНАЧЕ -1
		|	КОНЕЦ КАК СтатусЗаказаРозницыНаПроизводство
		|ИЗ
		|	ВТ_ЗаказыПокупателейВрем2 КАК ВТ_ЗаказыПокупателейВрем2
		|;
		|////////////////////////////////////////////////////////////////////////////////
		|";
		
	КонецЕсли;
	
	//СТАТУС ЗАКАЗА РОЗНИЦЫ ПОСТАВЩИКУ
	Если КэшКолонок.Свойство("ЕстьКолонкаСтатусЗаказаРозницыПоставщикам") И КэшКолонок.ЕстьКолонкаСтатусЗаказаРозницыПоставщикам Тогда
		
		//#16544 переделка запроса для возможности отбора
		
		//ТекстЗапроса = ТекстЗапроса + 
		//"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		//|	ЗаказыРозницыПоставщикамОбороты.ЗаказДоговор КАК ДокументРозницы,
		//|	ЗаказыРозницыПоставщикамОбороты.Номенклатура КАК Номенклатура,
		//|	ЗаказыРозницыПоставщикамОбороты.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
		//|	ЗаказыРозницыПоставщикамОбороты.ЗаказанОборот КАК ЗаказанОборот,
		//|	ЗаказыРозницыПоставщикамОбороты.ПолученОборот КАК ПолученОборот,
		//|	1 КАК КоличествоПозиций,
		//|	ВЫБОР
		//|		КОГДА ЗаказыРозницыПоставщикамОбороты.ЗаказанОборот > 0
		//|				И ЗаказыРозницыПоставщикамОбороты.ПолученОборот >= ЗаказыРозницыПоставщикамОбороты.ЗаказанОборот
		//|			ТОГДА 1
		//|		ИНАЧЕ 0
		//|	КОНЕЦ КАК ПозицияПолучена,
		//|	ВЫБОР
		//|		КОГДА ЗаказыРозницыПоставщикамОбороты.ЗаказанОборот > 0
		//|				И ЗаказыРозницыПоставщикамОбороты.ПолученОборот < ЗаказыРозницыПоставщикамОбороты.ЗаказанОборот
		//|			ТОГДА 1
		//|		ИНАЧЕ 0
		//|	КОНЕЦ КАК ПозицияНеполучена
		//|ПОМЕСТИТЬ ВТ_ЗаказыПоставщикамВрем
		//|ИЗ
		//|	РегистрНакопления.ЗаказыРозницыПоставщикам.Обороты(, , Авто, ЗаказДоговор В (&МассивСсылок)) КАК ЗаказыРозницыПоставщикамОбороты
		//|;
		//|
		//|////////////////////////////////////////////////////////////////////////////////
		//|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		//|	ВТ_ЗаказыПоставщикамВрем.ДокументРозницы КАК ДокументРозницы,
		//|	СУММА(ВТ_ЗаказыПоставщикамВрем.КоличествоПозиций) КАК КоличествоПозиций,
		//|	СУММА(ВТ_ЗаказыПоставщикамВрем.ПозицияПолучена) КАК ПозицияПолучена,
		//|	СУММА(ВТ_ЗаказыПоставщикамВрем.ПозицияНеполучена) КАК ПозицияНеполучена
		//|ПОМЕСТИТЬ ВТ_ЗаказыПоставщикам
		//|ИЗ
		//|	ВТ_ЗаказыПоставщикамВрем КАК ВТ_ЗаказыПоставщикамВрем
		//|
		//|СГРУППИРОВАТЬ ПО
		//|	ВТ_ЗаказыПоставщикамВрем.ДокументРозницы
		//|;
		//|
		//|////////////////////////////////////////////////////////////////////////////////
		//|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		//|	ВТ_ЗаказыПоставщикам.ДокументРозницы КАК ДокументРозницы,
		//|	ВЫБОР
		//|		КОГДА ВТ_ЗаказыПоставщикам.ПозицияПолучена > 0
		//|				И ВТ_ЗаказыПоставщикам.ПозицияНеполучена = 0
		//|			ТОГДА 0 // полностью закрашен
		//|		КОГДА ВТ_ЗаказыПоставщикам.КоличествоПозиций > 0
		//|				И ВТ_ЗаказыПоставщикам.ПозицияПолучена > 0
		//|				И ВТ_ЗаказыПоставщикам.ПозицияНеполучена > 0
		//|			ТОГДА 1 // частично закрашен
		//|		КОГДА ВТ_ЗаказыПоставщикам.КоличествоПозиций > 0
		//|				И ВТ_ЗаказыПоставщикам.ПозицияПолучена = 0
		//|			ТОГДА 2 // пустой кружок
		//|		ИНАЧЕ -1 // пусто
		//|	КОНЕЦ КАК СтатусЗаказаРозницыПоставщикам
		//|ИЗ
		//|	ВТ_ЗаказыПоставщикам КАК ВТ_ЗаказыПоставщикам
		//|;
		//|////////////////////////////////////////////////////////////////////////////////
		//|";
		
		ТекстЗапроса = ТекстЗапроса + 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ДанныеРегистра.ЗаказДоговор КАК Документрозницы,
			|	СУММА(ДанныеРегистра.ЗаказанОборот) КАК ЗаказанОборот,
			|	СУММА(ДанныеРегистра.ПолученОборот) КАК ПолученОборот
			|ПОМЕСТИТЬ ВТ_ЗаказыРозницыПоставщикам
			|ИЗ
			|	РегистрНакопления.ЗаказыРозницыПоставщикам.Обороты(, , Авто, ЗаказДоговор В (&МассивСсылок)) КАК ДанныеРегистра
			|
			|СГРУППИРОВАТЬ ПО
			|	ДанныеРегистра.ЗаказДоговор
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ВТ_ЗаказыПоставщикам.ДокументРозницы КАК ДокументРозницы,
			|	ВЫБОР
			|		КОГДА ЕСТЬNULL(ВТ_ЗаказыПоставщикам.ЗаказанОборот, 0) > 0
			|			И ЕСТЬNULL(ВТ_ЗаказыПоставщикам.ПолученОборот, 0) = 0
			|			ТОГДА 2 // пустой кружок
			|		КОГДА ЕСТЬNULL(ВТ_ЗаказыПоставщикам.ЗаказанОборот, 0) > 0
			|			И ЕСТЬNULL(ВТ_ЗаказыПоставщикам.ПолученОборот, 0) < ЕСТЬNULL(ВТ_ЗаказыПоставщикам.ЗаказанОборот, 0)
			|			ТОГДА 1  // частично закрашен
			|		КОГДА (ЕСТЬNULL(ВТ_ЗаказыПоставщикам.ЗаказанОборот, 0) > 0
			|				И ЕСТЬNULL(ВТ_ЗаказыПоставщикам.ПолученОборот, 0) >= ЕСТЬNULL(ВТ_ЗаказыПоставщикам.ЗаказанОборот, 0))		
			|			ИЛИ (ЕСТЬNULL(ВТ_ЗаказыПоставщикам.ЗаказанОборот, 0) = 0
			|				И ЕСТЬNULL(ВТ_ЗаказыПоставщикам.ПолученОборот, 0) > 0)
			|			ТОГДА 0 // полностью закрашен
			|		ИНАЧЕ -1  // пусто
			|	КОНЕЦ КАК СтатусЗаказаРозницыПоставщикам
			|ИЗ
			|	ВТ_ЗаказыРозницыПоставщикам КАК ВТ_ЗаказыПоставщикам
			|;
			|////////////////////////////////////////////////////////////////////////////////
			|";
	КонецЕсли;
	
	Если ТипДокумента = "ЗаказДоговор" Тогда
		
		Если КэшКолонок.Свойство("ЕстьКолонкаСостояниеВыполненияМонтажей") И КэшКолонок.ЕстьКолонкаСостояниеВыполненияМонтажей Тогда
			
			//ТекстЗапроса = ТекстЗапроса + 
			//"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			//|	ЗаказыПокупателейОбороты.ЗаказНаПроизводство КАК ЗаказДоговор,
			//|	1 КАК КоличествоПозиций,
			//|	ЗаказыПокупателейОбороты.Номенклатура КАК Номенклатура,
			//|	ЗаказыПокупателейОбороты.ХарактеристикаНоменклатуры КАК Характеристика,
			//|	ВЫБОР
			//|			КОГДА ЗаказыПокупателейОбороты.КоличествоПриход = ЗаказыПокупателейОбороты.КоличествоРасход
			//|				ТОГДА 1
			//|			ИНАЧЕ 0
			//|		КОНЕЦ КАК ПозицияИсполнена,
			//|	ВЫБОР
			//|			КОГДА ЗаказыПокупателейОбороты.КоличествоПриход < ЗаказыПокупателейОбороты.КоличествоРасход
			//|				ТОГДА 1
			//|			ИНАЧЕ 0
			//|		КОНЕЦ КАК ПозицияПеревыполнена
			//|ПОМЕСТИТЬ ВТ_ИсполнениеЗаказовВрем
			//|ИЗ
			//|	РегистрНакопления.ЗаказыПокупателей.Обороты(, , Авто, ЗаказНаПроизводство В (&МассивСсылок)) КАК ЗаказыПокупателейОбороты
			//|ГДЕ
			//|	ЗаказыПокупателейОбороты.ЗаказНаПроизводство ССЫЛКА Документ.ЗаказДоговор
			//|
			//|;
			//|
			//|////////////////////////////////////////////////////////////////////////////////
			//|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			//|	ВТ_ИсполнениеЗаказовВрем.ЗаказДоговор КАК ЗаказДоговор,
			//|	СУММА(ВТ_ИсполнениеЗаказовВрем.КоличествоПозиций) КАК КоличествоПозиций,
			//|	СУММА(ВТ_ИсполнениеЗаказовВрем.ПозицияИсполнена) КАК ПозицияИсполнена,
			//|	СУММА(ВТ_ИсполнениеЗаказовВрем.ПозицияПеревыполнена) КАК ПозицияПеревыполнена
			//|ПОМЕСТИТЬ ВТ_ИсполнениеЗаказов
			//|ИЗ
			//|	ВТ_ИсполнениеЗаказовВрем КАК ВТ_ИсполнениеЗаказовВрем
			//|
			//|СГРУППИРОВАТЬ ПО
			//|	ВТ_ИсполнениеЗаказовВрем.ЗаказДоговор
			//|;
			//|
			//|////////////////////////////////////////////////////////////////////////////////
			//|ВЫБРАТЬ
			//|	ВТ_ИсполнениеЗаказов.ЗаказДоговор КАК ЗаказДоговор,
			//|	ВЫБОР
			//|		КОГДА ЕСТЬNULL(ВТ_ИсполнениеЗаказов.КоличествоПозиций, 0) > 0
			//|				И ЕСТЬNULL(ВТ_ИсполнениеЗаказов.КоличествоПозиций, 0) = ЕСТЬNULL(ВТ_ИсполнениеЗаказов.ПозицияИсполнена, 0)
			//|				И ЕСТЬNULL(ВТ_ИсполнениеЗаказов.ПозицияПеревыполнена, 0) = 0
			//|			ТОГДА 0
			//|		КОГДА ЕСТЬNULL(ВТ_ИсполнениеЗаказов.КоличествоПозиций, 0) > ЕСТЬNULL(ВТ_ИсполнениеЗаказов.ПозицияИсполнена, 0)
			//|				И ЕСТЬNULL(ВТ_ИсполнениеЗаказов.ПозицияИсполнена, 0) > 0
			//|			ТОГДА 1
			//|		ИНАЧЕ -1
			//|	КОНЕЦ КАК СостояниеВыполненияМонтажей
			//|ИЗ
			//|	ВТ_ИсполнениеЗаказов КАК ВТ_ИсполнениеЗаказов
			//|;
			//|////////////////////////////////////////////////////////////////////////////////
			//|";
			
			ТекстЗапроса = ТекстЗапроса + 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ДанныеРегистра.ЗаказНаПроизводство КАК ЗаказДоговор,
			|	СУММА(ДанныеРегистра.КоличествоПриход) КАК КоличествоЗаказано,
			|	СУММА(ДанныеРегистра.КоличествоРасход) КАК КоличествоВыполнено
			|ПОМЕСТИТЬ ВТ_ИсполнениеЗаказов
			|ИЗ
			|	РегистрНакопления.ЗаказыПокупателей.Обороты(, , Авто, ЗаказНаПроизводство В (&МассивСсылок)) КАК ДанныеРегистра
			|ГДЕ
			|	ДанныеРегистра.ЗаказНаПроизводство ССЫЛКА Документ.ЗаказДоговор
			|
			|СГРУППИРОВАТЬ ПО
			|	ДанныеРегистра.ЗаказНаПроизводство
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ВТ_ИсполнениеЗаказов.ЗаказДоговор КАК ЗаказДоговор,
			|	ВЫБОР
			|		КОГДА ЕСТЬNULL(ВТ_ИсполнениеЗаказов.КоличествоЗаказано, 0) > 0
			|				И ЕСТЬNULL(ВТ_ИсполнениеЗаказов.КоличествоЗаказано, 0) = ЕСТЬNULL(ВТ_ИсполнениеЗаказов.КоличествоВыполнено, 0)
			|			ТОГДА 0
			|		КОГДА ЕСТЬNULL(ВТ_ИсполнениеЗаказов.КоличествоЗаказано, 0) > ЕСТЬNULL(ВТ_ИсполнениеЗаказов.КоличествоВыполнено, 0)
			|				И ЕСТЬNULL(ВТ_ИсполнениеЗаказов.КоличествоВыполнено, 0) > 0
			|			ТОГДА 1
			|		ИНАЧЕ -1
			|	КОНЕЦ КАК СостояниеВыполненияМонтажей
			|ИЗ
			|	ВТ_ИсполнениеЗаказов КАК ВТ_ИсполнениеЗаказов
			|;
			|////////////////////////////////////////////////////////////////////////////////
			|";
			
		КонецЕсли;
		
		Если КэшКолонок.Свойство("ЕстьКолонкаСостояниеПозицийВМонтажах") И КэшКолонок.ЕстьКолонкаСостояниеПозицийВМонтажах Тогда
			
			ТекстЗапроса = ТекстЗапроса + 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ЗаказДоговорТоварыУслуги.Ссылка КАК ЗаказДоговор,
			|	ЗаказДоговорТоварыУслуги.Номенклатура КАК Номенклатура,
			|	ЗаказДоговорТоварыУслуги.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
			|	1 КАК КоличествоПозиций,
			|	ВЫБОР
			|		КОГДА ЗаказДоговорТоварыУслуги.Количество <= ЕСТЬNULL(МонтажТоварыУслуги.Количество, 0)
			|			ТОГДА 1
			|		ИНАЧЕ 0
			|	КОНЕЦ КАК ПозицияМонтирована,
			|	ВЫБОР
			|		КОГДА ЗаказДоговорТоварыУслуги.Количество > ЕСТЬNULL(МонтажТоварыУслуги.Количество, 0)
			|			ТОГДА 1
			|		ИНАЧЕ 0
			|	КОНЕЦ КАК ПозицияНемонтирована
			|ПОМЕСТИТЬ ВТ_ПозицииВМонтажахВрем
			|ИЗ
			|	Документ.ЗаказДоговор.ТоварыУслуги КАК ЗаказДоговорТоварыУслуги
			|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Монтаж.ТоварыУслуги КАК МонтажТоварыУслуги
			//|		ПО (ЗаказДоговорТоварыУслуги.Ссылка = МонтажТоварыУслуги.Ссылка.ЗаказДоговор) //поле "ЗаказДоговор" теперь не является привязкой, теперь привязка по основанию
			|		ПО (ЗаказДоговорТоварыУслуги.Ссылка = МонтажТоварыУслуги.Ссылка.Основание)
			|			И (ЗаказДоговорТоварыУслуги.Номенклатура = МонтажТоварыУслуги.Номенклатура)
			|			И (ЗаказДоговорТоварыУслуги.ХарактеристикаНоменклатуры = МонтажТоварыУслуги.ХарактеристикаНоменклатуры)
			|			И (ЗаказДоговорТоварыУслуги.УИСтроки = МонтажТоварыУслуги.УИСтроки)
			|			И (НЕ МонтажТоварыУслуги.Ссылка.ПометкаУдаления)
			|ГДЕ
			|	ЗаказДоговорТоварыУслуги.Ссылка В (&МассивСсылок)
			|	И ЗаказДоговорТоварыУслуги.Ссылка.Проведен
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ВТ_ПозицииВМонтажахВрем.ЗаказДоговор КАК ЗаказДоговор,
			|	СУММА(ВТ_ПозицииВМонтажахВрем.КоличествоПозиций) КАК КоличествоПозиций,
			|	СУММА(ВТ_ПозицииВМонтажахВрем.ПозицияМонтирована) КАК ПозицияМонтирована,
			|	СУММА(ВТ_ПозицииВМонтажахВрем.ПозицияНемонтирована) КАК ПозицияНемонтирована
			|ПОМЕСТИТЬ ВТ_ПозицииВМонтажах
			|ИЗ
			|	ВТ_ПозицииВМонтажахВрем КАК ВТ_ПозицииВМонтажахВрем
			|
			|СГРУППИРОВАТЬ ПО
			|	ВТ_ПозицииВМонтажахВрем.ЗаказДоговор
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ДокументЗаказ.Ссылка КАК ЗаказДоговор,
			|	ВЫБОР
			|		КОГДА МАКСИМУМ(ДокументМонтаж.Ссылка) ЕСТЬ NULL
			|			ТОГДА ЛОЖЬ
			|		ИНАЧЕ ИСТИНА
			|	КОНЕЦ КАК ЕстьМонтаж
			|ПОМЕСТИТЬ ВТ_НаличиеМонтажей
			|ИЗ
			|	Документ.ЗаказДоговор КАК ДокументЗаказ
			|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Монтаж КАК ДокументМонтаж
			|		ПО (ДокументМонтаж.ЗаказДоговор = ДокументЗаказ.Ссылка)
			|ГДЕ
			|	ДокументЗаказ.Ссылка В (&МассивСсылок)
			|	И ДокументЗаказ.Проведен
			|
			|СГРУППИРОВАТЬ ПО
			|	ДокументЗаказ.Ссылка
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ВТ_ПозицииВМонтажах.ЗаказДоговор КАК ЗаказДоговор,
			|	ВЫБОР
			|		КОГДА ЕСТЬNULL(ВТ_ПозицииВМонтажах.КоличествоПозиций, 0) > 0
			|				И ЕСТЬNULL(ВТ_ПозицииВМонтажах.КоличествоПозиций, 0) <= ЕСТЬNULL(ВТ_ПозицииВМонтажах.ПозицияМонтирована, 0)
			|			ТОГДА 0
			|		КОГДА ЕСТЬNULL(ВТ_ПозицииВМонтажах.КоличествоПозиций, 0) > ЕСТЬNULL(ВТ_ПозицииВМонтажах.ПозицияМонтирована, 0)
			|				И ЕСТЬNULL(ВТ_ПозицииВМонтажах.ПозицияМонтирована, 0) > 0
			|				И ЕСТЬNULL(ВТ_ПозицииВМонтажах.ПозицияНемонтирована, 0) > 0
			|			ТОГДА 1
			|		КОГДА ЕСТЬNULL(ВТ_ПозицииВМонтажах.КоличествоПозиций, 0) > 0
			|				И ЕСТЬNULL(ВТ_ПозицииВМонтажах.ПозицияМонтирована, 0) = 0
			|				И ВТ_НаличиеМонтажей.ЕстьМонтаж = ИСТИНА
			|			ТОГДА 2
			|		ИНАЧЕ -1
			|	КОНЕЦ КАК СостояниеПозицийВМонтажах
			|ИЗ
			|	ВТ_ПозицииВМонтажах КАК ВТ_ПозицииВМонтажах
			|
			|	ЛЕВОЕ СОЕДИНЕНИЕ ВТ_НаличиеМонтажей КАК ВТ_НаличиеМонтажей
			|	ПО ВТ_ПозицииВМонтажах.ЗаказДоговор = ВТ_НаличиеМонтажей.ЗаказДоговор
			|;
			|////////////////////////////////////////////////////////////////////////////////
			|";
			
		КонецЕсли;
		
	КонецЕсли;
	
	// выполняем запросы
	Если ПустаяСтрока(ТекстЗапроса) Тогда
		Возврат;
	КонецЕсли;
	
	Запрос.Текст = ТекстЗапроса;
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	УказательЗапроса = 0;
	
	// выводим значения 
	Если КэшКолонок.Свойство("ЕстьКолонкаСтатусЗаказаРозницыНаПроизводство") И КэшКолонок.ЕстьКолонкаСтатусЗаказаРозницыНаПроизводство Тогда
		
		УказательЗапроса = УказательЗапроса + 2; // из-за наличия ВТ
		Выборка = РезультатЗапроса[УказательЗапроса].Выбрать();
		Пока Выборка.Следующий() Цикл
			СтрокаСписка = Строки[Выборка.ДокументРозницы];
			СтрокаСписка.Данные["СтатусЗаказаРозницыНаПроизводство"] = Выборка.СтатусЗаказаРозницыНаПроизводство;
		КонецЦикла;
		
		УказательЗапроса = УказательЗапроса + 1;
	КонецЕсли;
	
	Если КэшКолонок.Свойство("ЕстьКолонкаСтатусЗаказаРозницыПоставщикам") И КэшКолонок.ЕстьКолонкаСтатусЗаказаРозницыПоставщикам Тогда
		
		//#16544 осталась одна ВТ
		//УказательЗапроса = УказательЗапроса + 2; // из-за наличия ВТ
		УказательЗапроса = УказательЗапроса + 1; // из-за наличия ВТ
		
		Выборка = РезультатЗапроса[УказательЗапроса].Выбрать();
		Пока Выборка.Следующий() Цикл
			СтрокаСписка = Строки[Выборка.ДокументРозницы];
			СтрокаСписка.Данные["СтатусЗаказаРозницыПоставщикам"] = Выборка.СтатусЗаказаРозницыПоставщикам;
		КонецЦикла;
		
		УказательЗапроса = УказательЗапроса + 1;
	КонецЕсли;
	
	Если КэшКолонок.Свойство("ЕстьКолонкаСостояниеВыполненияМонтажей") И КэшКолонок.ЕстьКолонкаСостояниеВыполненияМонтажей Тогда
		
		УказательЗапроса = УказательЗапроса + 1; // из-за наличия ВТ
		Выборка = РезультатЗапроса[УказательЗапроса].Выбрать();
		Пока Выборка.Следующий() Цикл
			СтрокаСписка = Строки[Выборка.ЗаказДоговор];
			СтрокаСписка.Данные["СостояниеВыполненияМонтажей"] = Выборка.СостояниеВыполненияМонтажей;
		КонецЦикла;
		
		УказательЗапроса = УказательЗапроса + 1;
	КонецЕсли;
	
	Если КэшКолонок.Свойство("ЕстьКолонкаСостояниеПозицийВМонтажах") И КэшКолонок.ЕстьКолонкаСостояниеПозицийВМонтажах Тогда
		
		УказательЗапроса = УказательЗапроса + 3; // из-за наличия ВТ
		Выборка = РезультатЗапроса[УказательЗапроса].Выбрать();
		Пока Выборка.Следующий() Цикл
			СтрокаСписка = Строки[Выборка.ЗаказДоговор];
			СтрокаСписка.Данные["СостояниеПозицийВМонтажах"] = Выборка.СостояниеПозицийВМонтажах;
		КонецЦикла;
		
		УказательЗапроса = УказательЗапроса + 1;
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаказДоговорОсобыйОтборПриИзменении(СписокЗаказДоговоры, СтандартныйТекстЗапросаСписка, ПоляОтбора) Экспорт
	
	// ПРИ ИЗМЕНЕНИИ ЗАПРОСОВ ИЗМЕНЯТЬ ПРОЦЕДУРУ ОбщийМодульСервер.РозницаПриПолученииДанныхНаСервере()
	
	// применяем стандартный текст запроса
	ТекстЗапроса = СтандартныйТекстЗапросаСписка;
	
	ЗаказДоговорОтборПоВыполнениюМонтажей  = -9;
	ЗаказДоговорОтборПоПозициямВМонтажах   = -9;
	ЗаказДоговорОтборПоСтатусуПроизводства = -9;
	ЗаказДоговорОтборПоСтатусуЗакупки      = -9;
	ПоляОтбора.Свойство("ЗаказДоговорОтборПоВыполнениюМонтажей",  ЗаказДоговорОтборПоВыполнениюМонтажей);
	ПоляОтбора.Свойство("ЗаказДоговорОтборПоПозициямВМонтажах",   ЗаказДоговорОтборПоПозициямВМонтажах);
	ПоляОтбора.Свойство("ЗаказДоговорОтборПоСтатусуПроизводства", ЗаказДоговорОтборПоСтатусуПроизводства);
	ПоляОтбора.Свойство("ЗаказДоговорОтборПоСтатусуЗакупки",      ЗаказДоговорОтборПоСтатусуЗакупки);
	
	СписокЗаказДоговоры.КомпоновщикНастроек.Настройки.ДополнительныеСвойства.Вставить("ОтборПоСостояниюВыполненияМонтажей", ЗаказДоговорОтборПоВыполнениюМонтажей);
	СписокЗаказДоговоры.КомпоновщикНастроек.Настройки.ДополнительныеСвойства.Вставить("ОтборПоСостояниюПозицийВМонтажах",   ЗаказДоговорОтборПоПозициямВМонтажах);
	СписокЗаказДоговоры.КомпоновщикНастроек.Настройки.ДополнительныеСвойства.Вставить("ОтборПоСтатусуПроизводства",   		ЗаказДоговорОтборПоСтатусуПроизводства);
	СписокЗаказДоговоры.КомпоновщикНастроек.Настройки.ДополнительныеСвойства.Вставить("ОтборПоСтатусуЗакупки",   			ЗаказДоговорОтборПоСтатусуЗакупки);
	
	// если задан отбор по состоянию позиций в монтаже
	Если НЕ ЗаказДоговорОтборПоПозициямВМонтажах = -9 Тогда
		
		ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЗаказДоговорТоварыУслуги.Ссылка КАК ЗаказДоговор,
		|	ЗаказДоговорТоварыУслуги.Номенклатура КАК Номенклатура,
		|	ЗаказДоговорТоварыУслуги.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
		|	1 КАК КоличествоПозиций,
		|	ВЫБОР
		|		КОГДА ЗаказДоговорТоварыУслуги.Количество <= ЕСТЬNULL(МонтажТоварыУслуги.Количество, 0)
		|			ТОГДА 1
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК ПозицияМонтирована,
		|	ВЫБОР
		|		КОГДА ЗаказДоговорТоварыУслуги.Количество > ЕСТЬNULL(МонтажТоварыУслуги.Количество, 0)
		|			ТОГДА 1
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК ПозицияНемонтирована
		|ПОМЕСТИТЬ ВТ_ПозицииВМонтажахВрем
		|ИЗ
		|	Документ.ЗаказДоговор.ТоварыУслуги КАК ЗаказДоговорТоварыУслуги
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Монтаж.ТоварыУслуги КАК МонтажТоварыУслуги
		|		ПО (ЗаказДоговорТоварыУслуги.Ссылка = МонтажТоварыУслуги.Ссылка.ЗаказДоговор)
		|			И (ЗаказДоговорТоварыУслуги.Номенклатура = МонтажТоварыУслуги.Номенклатура)
		|			И (ЗаказДоговорТоварыУслуги.ХарактеристикаНоменклатуры = МонтажТоварыУслуги.ХарактеристикаНоменклатуры)
		|			И (ЗаказДоговорТоварыУслуги.УИСтроки = МонтажТоварыУслуги.УИСтроки)
		|			И (НЕ МонтажТоварыУслуги.Ссылка.ПометкаУдаления)
		|ГДЕ
		|	ЗаказДоговорТоварыУслуги.Ссылка.Проведен
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
