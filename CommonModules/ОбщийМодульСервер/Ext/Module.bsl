	КомандаФормы.ИзменяетСохраняемыеДанные = Ложь;
	// создаем кнопку и привязываем к ней команду	
	КнопкаФормы = Форма.Элементы.Добавить(ИмяКоманды, Тип("КнопкаФормы"), Форма.КоманднаяПанель);
