//++ #14380 от 11.08.2022
// Процедура регламентного задания 
Процедура ОчисткаБазыПометитьВсеНаУдаление(НеУдалятьДокументыУстановкиЦен,НеУдалятьДокументыУстановкиСтоимостиВыработки, УдалитьНепосредственно) Экспорт
	
	//++ №13931 делаем через массив, т.к. несколько галочек исключений
	
	МассивНеУдаляемыхМетаданных = новый Массив;
	
	Если НеУдалятьДокументыУстановкиЦен Тогда
		МассивНеУдаляемыхМетаданных.Добавить("УстановкаЦенМатериалов");
		МассивНеУдаляемыхМетаданных.Добавить("УстановкаЦенМатериаловПоставщиков");
		МассивНеУдаляемыхМетаданных.Добавить("УстановкаЦенНоменклатуры");
		МассивНеУдаляемыхМетаданных.Добавить("УстановкаЦенПоставщика");
		МассивНеУдаляемыхМетаданных.Добавить("УстановкаИндивидуальныхЦенМатериалов");
		МассивНеУдаляемыхМетаданных.Добавить("УстановкаИндивидуальныхЦенНаУслугиПроизводства");
		МассивНеУдаляемыхМетаданных.Добавить("УстановкаИндивидуальныхЦенНоменклатуры");
	КонецЕсли;
	
	Если НеУдалятьДокументыУстановкиСтоимостиВыработки Тогда
		МассивНеУдаляемыхМетаданных.Добавить("УстановкаСтоимостиВыработкиПоНоменклатуре");
	КонецЕсли;
	//-- №13931
	
	//++ №6270
	ЧастьСообщения = "пометить на удаление";
	Если УдалитьНепосредственно Тогда
		ЧастьСообщения = "удалить непосредствено";
	КонецЕсли;
	//-- №6270
	
	// ЗАДАЧИ И БИЗНЕС-ПРОЦЕССЫ
	ТекущийПроцесс="Пометка на удаление бизнес-процессов";
	Если УдалитьНепосредственно Тогда
		ТекущийПроцесс = "Удаление бизнес-процессов";
	КонецЕсли;
	
	Счетчик=0;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Задание.Ссылка КАК Ссылка
	|ИЗ
	|	БизнесПроцесс.Задание КАК Задание";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Количество() > 0 Тогда 
		ШагСчетчика=100/Выборка.Количество();
	Иначе	
		ШагСчетчика=0;
	КонецЕсли;
	
	Пока  Выборка.Следующий() Цикл
		
		Об = Выборка.Ссылка.ПолучитьОбъект();
		
		Попытка

			Если УдалитьНепосредственно Тогда
				Об.Удалить();
			Иначе
				Об.УстановитьПометкуУдаления(Истина);
			КонецЕсли;
		Исключение
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = СтрШаблон("%1 не удалось %2: %3|%4", Об, ЧастьСообщения, ОписаниеОшибки(), Строка(Окр(Счетчик,0)));
			Сообщение.Сообщить();
		КонецПопытки;
		Счетчик = Счетчик+ШагСчетчика;
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = ТекущийПроцесс + "|" + Строка(Окр(Счетчик,0));
		Сообщение.Сообщить();
	КонецЦикла;
	
	ТекущийПроцесс="Пометка на удаление задач";
	Если УдалитьНепосредственно Тогда
		ТекущийПроцесс = "Удаление задач";
	КонецЕсли;
	
	
	Счетчик=0;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Задачи.Ссылка
	|ИЗ
	|	Задача.Задачи КАК Задачи";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Количество() > 0 Тогда 
		ШагСчетчика=100/Выборка.Количество();
	Иначе	
		ШагСчетчика=0;
	КонецЕсли;
	
	Пока  Выборка.Следующий() Цикл
		
		Об = Выборка.Ссылка.ПолучитьОбъект();
		
		Попытка
			//++ №6270
			Если УдалитьНепосредственно Тогда
				Об.Удалить();
			Иначе
				//-- №6270
				Об.УстановитьПометкуУдаления(Истина);
			КонецЕсли;
		Исключение
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = СтрШаблон("%1 не удалось %2: %3|%4", Об, ЧастьСообщения, ОписаниеОшибки(), Строка(Окр(Счетчик,0)));
			Сообщение.Сообщить();
		КонецПопытки;
		Счетчик = Счетчик+ШагСчетчика;
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = ТекущийПроцесс + "|" + Строка(Окр(Счетчик,0));
		Сообщение.Сообщить();
	КонецЦикла;
	
	
	
	Счетчик=0;
	КоличествоДокументов=0;
	// Подсчет общего количества документов
	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = "Подсчет количества документов для обработки.|0";
	Сообщение.Сообщить();	
	Для Каждого ТекМД из Метаданные.Документы Цикл 
		Если НЕ МассивНеУдаляемыхМетаданных.Найти(ТекМД.Имя) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	КОЛИЧЕСТВО(Документ.Ссылка) КАК Количество
		|ИЗ
		|	Документ."+ТекМД.Имя+" КАК Документ
		|ГДЕ
		|   Документ.ПометкаУдаления = ЛОЖЬ";
		
		Результат = Запрос.Выполнить().Выбрать();
		Если Результат.Следующий() Тогда
			КоличествоДокументов = КоличествоДокументов + Результат.Количество;
		КонецЕсли;
	КонецЦикла;
	
	ТекущийПроцесс="Пометка документов на удаление";
	Если УдалитьНепосредственно Тогда
		ТекущийПроцесс = "Удаление документов";
	КонецЕсли;
	
	Если КоличествоДокументов > 0 Тогда 
		ШагСчетчика=100/КоличествоДокументов;
		
		Для Каждого ТекМД из Метаданные.Документы Цикл 
			Если НЕ МассивНеУдаляемыхМетаданных.Найти(ТекМД.Имя) = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ ПЕРВЫЕ 100
			|	Документ.Ссылка КАК Ссылка
			|ИЗ
			|	Документ."+ТекМД.Имя+" КАК Документ
			|ГДЕ
			|   Документ.ПометкаУдаления = ЛОЖЬ";
			
			Результат = Запрос.Выполнить().Выбрать();
			КоличествоДокументовДляОбработки = Результат.Количество();
			
			Пока КоличествоДокументовДляОбработки > 0 Цикл
				Запрос = Новый Запрос;
				Запрос.Текст = 
				"ВЫБРАТЬ ПЕРВЫЕ 100
				|	Документ.Ссылка КАК Ссылка
				|ИЗ
				|	Документ."+ТекМД.Имя+" КАК Документ
				|ГДЕ
				|   Документ.ПометкаУдаления = ЛОЖЬ";
				
				Результат = Запрос.Выполнить().Выбрать();
				КоличествоДокументовДляОбработки = Результат.Количество();
				Пока Результат.Следующий() Цикл
					ТекОб = Результат.Ссылка.ПолучитьОбъект(); 	
					
					Попытка 
						Если УдалитьНепосредственно Тогда
							ТекОб.Удалить();
						Иначе
							Если ТекОб.ПометкаУдаления Тогда 
								Продолжить; 
							КонецЕсли; 
							ТекОб.УстановитьПометкуУдаления(Истина);
						КонецЕсли;
					Исключение 
						Сообщение = Новый СообщениеПользователю;
						Сообщение.Текст = СтрШаблон("%1 не удалось %2: %3|%4", Об, ЧастьСообщения, ОписаниеОшибки(), Строка(Окр(Счетчик,0)));
						Сообщение.Сообщить();
					КонецПопытки;
				Счетчик = Счетчик+ШагСчетчика;
				Сообщение = Новый СообщениеПользователю;
				Сообщение.Текст = ТекущийПроцесс + ": " + ТекМД.Имя +  "|" + Строка(Окр(Счетчик,0));
				Сообщение.Сообщить();		
				КонецЦикла;
			КонецЦикла;
		КонецЦикла;
		
	Иначе
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Документов для обработки не обнаружено.|50";
		Сообщение.Сообщить();	
	КонецЕсли;
	
	ЧастьСообщения = "Обработка пометки на удаление завершена.";
	Если УдалитьНепосредственно Тогда
		ЧастьСообщения = "Обработка непосредственного удаления завершена.";
	КонецЕсли;
	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = ЧастьСообщения+"|100";
	Сообщение.Сообщить();	
	
	// Задержка для получения формой обработки последнего сообщения
	Дата=ТекущаяДата();
	Пока ТекущаяДата()-Дата < 3 Цикл 
	КонецЦикла;	
	
КонецПроцедуры
//-- #14380 от 11.08.2022

Процедура ИзменитьРеквизитДопУпорядочивания(ИмяТаблицы, ТекущееЗначение, Вверх) Экспорт
	
	Если Вверх Тогда
		ТекстЗапроса = 
		"ВЫБРАТЬ ПЕРВЫЕ 2
		|	ДанныеСправочника.Ссылка КАК Ссылка,
		|	ДанныеСправочника.РеквизитДопУпорядочивания КАК РеквизитДопУпорядочивания
		|ИЗ
		|	Справочник.%Таблица КАК ДанныеСправочника
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.%Таблица КАК ТекущиеДанныеСправочника
		|		ПО (ТекущиеДанныеСправочника.Ссылка = &ТекущееЗначение)
		|ГДЕ
		|	ДанныеСправочника.РеквизитДопУпорядочивания <= ТекущиеДанныеСправочника.РеквизитДопУпорядочивания
		|
		|УПОРЯДОЧИТЬ ПО
		|	ДанныеСправочника.РеквизитДопУпорядочивания УБЫВ";	
	Иначе
		ТекстЗапроса = 
		"ВЫБРАТЬ ПЕРВЫЕ 2
		|	ДанныеСправочника.Ссылка КАК Ссылка,
		|	ДанныеСправочника.РеквизитДопУпорядочивания КАК РеквизитДопУпорядочивания
		|ИЗ
		|	Справочник.%Таблица КАК ДанныеСправочника
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.%Таблица КАК ТекущиеДанныеСправочника
		|		ПО (ТекущиеДанныеСправочника.Ссылка = &ТекущееЗначение)
		|ГДЕ
		|	ДанныеСправочника.РеквизитДопУпорядочивания >= ТекущиеДанныеСправочника.РеквизитДопУпорядочивания
		|
		|УПОРЯДОЧИТЬ ПО
		|	ДанныеСправочника.РеквизитДопУпорядочивания";
	КонецЕсли;	 
	 
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТекущееЗначение", ТекущееЗначение);
	Запрос.Текст = СтрЗаменить(ТекстЗапроса, "%Таблица", ИмяТаблицы);
	
	Выборка = Запрос.Выполнить().Выбрать();	
	Если НЕ Выборка.Количество() = 2 Тогда
		Возврат;
	КонецЕсли;
	
	Выборка.Следующий();
	СпрОбъект1 = Выборка.Ссылка.ПолучитьОбъект();	
	Порядок1 = Выборка.РеквизитДопУпорядочивания;
	
	Выборка.Следующий();
	СпрОбъект2 = Выборка.Ссылка.ПолучитьОбъект();
	Порядок2 = Выборка.РеквизитДопУпорядочивания;
	
	СпрОбъект1.РеквизитДопУпорядочивания = Порядок2;
	СпрОбъект2.РеквизитДопУпорядочивания = Порядок1;
	
	Попытка
		СпрОбъект1.Записать();	
		СпрОбъект2.Записать();
	Исключение
		Сообщить(ОписаниеОшибки());
	КонецПопытки;
	
КонецПроцедуры
