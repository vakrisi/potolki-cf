//++ #11632
Функция ПолучитьВремяСдвигаДатыСледующегоКонтактаЛида(Событие) Экспорт
	
	ИндексЗначения = Перечисления.СобытияИзмененияДатыСледующегоКонтактаЛида.Индекс(Событие);
	ИмяСобытия = Метаданные.Перечисления.СобытияИзмененияДатыСледующегоКонтактаЛида.ЗначенияПеречисления[ИндексЗначения].Имя;
	
	НастройкаИзмененияДатыСледующегоКонтактаЛида = Константы.НастройкаИзмененияДатыСледующегоКонтактаЛида.Получить().Получить();
	Если НЕ НастройкаИзмененияДатыСледующегоКонтактаЛида = Неопределено Тогда	
		НайденныеСтроки = НастройкаИзмененияДатыСледующегоКонтактаЛида.НайтиСтроки(Новый Структура("ИмяСобытия", ИмяСобытия));
		Если НайденныеСтроки.Количество() > 0 Тогда
			Возврат Час(НайденныеСтроки[0].Сдвиг) * 60 * 60 + Минута(НайденныеСтроки[0].Сдвиг) * 60;
		КонецЕсли;
	КонецЕсли;
	
	Возврат 0;
	
КонецФункции	
