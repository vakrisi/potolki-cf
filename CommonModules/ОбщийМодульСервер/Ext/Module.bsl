#Область Доставка

//++ №10663
Процедура ЗаполнитьСсылкиНаДоставки(Форма) Экспорт
	
	Форма.Доставки.Очистить();
	
	Если Не ПолучитьФункциональнуюОпцию("УчитыватьДоставкуТовара") Тогда
		Возврат;
	КонецЕсли;
	
	Если Форма.Объект.Ссылка.Пустая() Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	               |	ЗаявкаНаДоставкуОснования.Ссылка КАК Ссылка 
	               |ИЗ
	               |	Документ.ЗаявкаНаДоставку.Основания КАК ЗаявкаНаДоставкуОснования
	               |ГДЕ
	               |	ЗаявкаНаДоставкуОснования.Основание = &Основание
	               |	И НЕ ЗаявкаНаДоставкуОснования.Ссылка.ПометкаУдаления
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ЗаявкаНаДоставкуОснования.Ссылка.Дата";
	Запрос.УстановитьПараметр("Основание", Форма.Объект.Ссылка);
	
	Форма.Доставки.ЗагрузитьЗначения(Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка"));
	
	// Если документов нет, выводим декорацию
	Форма.Элементы.ДекорацияСоздатьДоставку.Видимость = (Форма.Доставки.Количество() = 0);
	
	// Существующие элементы декорации скроем (если они есть уже)
	Для Каждого ТекущаяСтрока Из Форма.Элементы.ГруппаСсылкиНаДоставки.ПодчиненныеЭлементы Цикл
		
		Если СтрНайти(ТекущаяСтрока.Имя, "ДекорацияСсылкаНаДоставкуНомер") > 0 Тогда
			ТекущаяСтрока.Видимость = Ложь;
		КонецЕсли;
		
	КонецЦикла;
	
	// Прорисуем элементы формы
	Сч = 0;
	УстановитьПривилегированныйРежим(Истина);
	Для Каждого ТекущаяСтрока Из Форма.Доставки Цикл
		
		ИмяЭлемента = "ДекорацияСсылкаНаДоставкуНомер_" + Сч;
		
		Если Форма.Элементы.Найти(ИмяЭлемента) = Неопределено Тогда
			НовыйЭлемент = Форма.Элементы.Вставить(ИмяЭлемента, Тип("ДекорацияФормы"), Форма.Элементы.ГруппаСсылкиНаДоставки);
		Иначе
			НовыйЭлемент = Форма.Элементы[ИмяЭлемента];
		КонецЕсли;
		
		Дата = Дата(1,1,1);
		Если ЗначениеЗаполнено(ТекущаяСтрока.Значение.ОжидаемаяДатаОтправки) Тогда
			Дата = ТекущаяСтрока.Значение.ОжидаемаяДатаОтправки;
		Иначе
			Дата = ТекущаяСтрока.Значение.Дата;
		КонецЕсли;
		
		НовыйЭлемент.Видимость = Истина;
		НовыйЭлемент.Заголовок = "Доставка на " + Формат(Дата, "ДФ=dd.MM.yyyy") + " (" + ТекущаяСтрока.Значение.Результат.Наименование + ")"; //nva
		НовыйЭлемент.Гиперссылка = Истина;
		//nva+++
		Если ТекущаяСтрока.Значение.Результат = Справочники.СтатусыЗаявокНаДоставку.Доставлено ИЛИ ТекущаяСтрока.Значение.Результат = Справочники.СтатусыЗаявокНаДоставку.Отправлено Тогда
			НовыйЭлемент.ЦветТекста = ЦветаСтиля.ЦветОсобогоТекста;
		КонецЕсли;	
		//nva---
		НовыйЭлемент.УстановитьДействие("Нажатие", "ДекорацияСсылкаНаДоставкуНажатие");
		
		Сч = Сч + 1;
		
	КонецЦикла;
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры
//-- №10663

// Устанавливает свойства форм документов, в которых имеются реквизиты доставки при чтении, создании
// Параметры
//		ЭлементыФормы - все элементы формы для управления свойствами и переключения закладок
//		ДокОбъект - объект, реквизиты которого используются при заполнении свойств
//
Процедура ПриЧтенииСозданииДокументовСДоставкойНаСервере(ЭлементыФормы, ДокОбъект) Экспорт
	
	Если НЕ ПолучитьФункциональнуюОпцию("УчитыватьДоставкуТовара") Тогда
		//И (НЕ ЗначениеЗаполнено(ДокОбъект.СпособДоставки) ИЛИ ДокОбъект.СпособДоставки = Справочники.СпособыДоставкиТовара.Самовывоз) 
		Если ЭлементыФормы.Найти("СтраницаДоставка") <> Неопределено Тогда
			ЭлементыФормы.СтраницаДоставка.Видимость = Ложь;
		КонецЕсли;									
		Возврат;
	КонецЕсли;
	
	ЗаполнитьСпискиВыбораАдресовПолучателя(ЭлементыФормы, ДокОбъект);
	
КонецПроцедуры

Функция СтруктураВыбора()
	
	СтруктураВыбора = Новый Структура;
	СтруктураВыбора.Вставить("АдресДоставки", "");
	СтруктураВыбора.Вставить("АдресДоставкиЗначенияПолей", "");
	СтруктураВыбора.Вставить("ГородДоставки", Справочники.Города.ПустаяСсылка());
	//СтруктураВыбора.Вставить("ВремяДоставкиС", Дата(1,1,1));
	//СтруктураВыбора.Вставить("ВремяДоставкиПо", Дата(1,1,1));
	СтруктураВыбора.Вставить("ДополнительнаяИнформацияПоДоставке", "");
	
	Возврат СтруктураВыбора;
	
КонецФункции

Процедура СкопироватьСписокЗначений(СписокПриемник, СписокИсточник)
	
	СписокПриемник.Очистить();
	Для Каждого Элемент Из СписокИсточник Цикл
		СписокПриемник.Добавить(Элемент.Значение, Элемент.Представление);
	КонецЦикла;
	
КонецПроцедуры

Процедура ДозаполнитьПустыеСвойства(СтруктураПриемник, Источник);
	
	СтруктураЗаполнения = Новый Структура;
	Для Каждого Элемент Из СтруктураПриемник Цикл
		Если Не ЗначениеЗаполнено(Элемент.Значение) Тогда
			СтруктураЗаполнения.Вставить(Элемент.Ключ);
		КонецЕсли;
	КонецЦикла;
	ЗаполнитьЗначенияСвойств(СтруктураЗаполнения, Источник);
	ЗаполнитьЗначенияСвойств(СтруктураПриемник, СтруктураЗаполнения);
	
КонецПроцедуры

Функция ПоследниеРеквизитыДоставкиИзДокументов(ОбъектСсылка, Получатель = Неопределено)
	
	ТекстЗапроса =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 3
	|	Док.АдресДоставки КАК АдресДоставки,
	|	МАКСИМУМ(Док.Дата) КАК Дата
	|ПОМЕСТИТЬ ВТ_ПоследниеАдреса
	|ИЗ
	|	Документ.РеализацияТоваровИУслуг КАК Док
	|ГДЕ
	|	Док.Проведен
	|	И Док.Контрагент = &Получатель
	|	И Док.АдресДоставки <> """"
	|
	|СГРУППИРОВАТЬ ПО
	|	Док.АдресДоставки
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ ПЕРВЫЕ 3
	|	Док.АдресДоставки,
	|	МАКСИМУМ(Док.Дата)
	|ИЗ
	|	Документ.ЗаказПокупателя КАК Док
	|ГДЕ
	|	Док.Проведен
	|	И Док.Контрагент = &Получатель
	|	И Док.АдресДоставки <> """"
	|
	|СГРУППИРОВАТЬ ПО
	|	Док.АдресДоставки
	|
	|УПОРЯДОЧИТЬ ПО
	|	МАКСИМУМ(Док.Дата) УБЫВ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	МАКСИМУМ(ЕСТЬNULL(Реализация.Ссылка, Заказ.Ссылка)) КАК Ссылка,
	|	ВТ_ПоследниеАдреса.АдресДоставки КАК АдресДоставки
	|ПОМЕСТИТЬ ВТ_СсылкиПоАдресам
	|ИЗ
	|	ВТ_ПоследниеАдреса КАК ВТ_ПоследниеАдреса
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РеализацияТоваровИУслуг КАК Реализация
	|		ПО ВТ_ПоследниеАдреса.Дата = Реализация.Дата
	|			И ВТ_ПоследниеАдреса.АдресДоставки = Реализация.АдресДоставки
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаказПокупателя КАК Заказ
	|		ПО ВТ_ПоследниеАдреса.Дата = Заказ.Дата
	|			И ВТ_ПоследниеАдреса.АдресДоставки = Заказ.АдресДоставки
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_ПоследниеАдреса.АдресДоставки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВТ_ПоследниеАдреса.АдресДоставки КАК АдресДоставки,
	|	ВТ_СсылкиПоАдресам.Ссылка.АдресДоставкиЗначенияПолей КАК АдресДоставкиЗначенияПолей,
	|	ВТ_СсылкиПоАдресам.Ссылка.ДополнительнаяИнформацияПоДоставке КАК ДополнительнаяИнформацияПоДоставке,
	|	ВТ_СсылкиПоАдресам.Ссылка.ГородДоставки КАК ГородДоставки
	|ИЗ
	|	ВТ_ПоследниеАдреса КАК ВТ_ПоследниеАдреса
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_СсылкиПоАдресам КАК ВТ_СсылкиПоАдресам
	|		ПО (ВТ_СсылкиПоАдресам.АдресДоставки = ВТ_ПоследниеАдреса.АдресДоставки)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ВТ_ПоследниеАдреса.Дата УБЫВ";
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	
	Запрос.УстановитьПараметр("Получатель",Получатель);
	УстановитьПривилегированныйРежим(Истина);
	Результат = Запрос.Выполнить().Выгрузить();
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат Результат;
	
КонецФункции

Функция АдресаПолучателяИзКонтактнойИнформации(Получатель)
	
	// Адрес доставки + фактический адрес
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	КонтактнаяИнформация.Представление КАК АдресДоставки,
	|	КонтактнаяИнформация.Вид.Представление КАК Вид,
	|	КонтактнаяИнформация.ЗначенияПолей КАК АдресДоставкиЗначенияПолей,
	|	ЗНАЧЕНИЕ(Справочник.Города.ПустаяСсылка) КАК ГородДоставки
	|ИЗ
	|	Справочник.Контрагенты.КонтактнаяИнформация КАК КонтактнаяИнформация
	|ГДЕ
	|	КонтактнаяИнформация.Ссылка = &Получатель
	|	И КонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Адрес)
	|	И КонтактнаяИнформация.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.АдресДоставкиКонтрагента)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	КонтактнаяИнформация.Представление,
	|	КонтактнаяИнформация.Вид.Представление,
	|	КонтактнаяИнформация.ЗначенияПолей,
	|	ЗНАЧЕНИЕ(Справочник.Города.ПустаяСсылка)
	|ИЗ
	|	Справочник.Контрагенты.КонтактнаяИнформация КАК КонтактнаяИнформация
	|ГДЕ
	|	КонтактнаяИнформация.Ссылка = &Получатель
	|	И КонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Адрес)
	|	И КонтактнаяИнформация.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.ФактАдресКонтрагента)";
	
	Запрос.УстановитьПараметр("Получатель", Получатель);
	
	УстановитьПривилегированныйРежим(Истина);
	Результат = Запрос.Выполнить().Выгрузить();
	
	СсылкаНаРоссию = Справочники.СтраныМира.Россия;
	
	Для каждого СтрокаТЗ из Результат Цикл
		Если ЗначениеЗаполнено(СтрокаТЗ.АдресДоставкиЗначенияПолей) Тогда
			Если УправлениеКонтактнойИнформациейКлиентСервер.ЭтоКонтактнаяИнформацияВXML(СтрокаТЗ.АдресДоставкиЗначенияПолей) Тогда
				РезультатыЧтения = Новый Структура;
				XDTOКонтактная = УправлениеКонтактнойИнформациейСлужебный.КонтактнаяИнформацияИзXML(СтрокаТЗ.АдресДоставкиЗначенияПолей, Перечисления.ТипыКонтактнойИнформации.Адрес, РезультатыЧтения);
				Если РезультатыЧтения.Свойство("ТекстОшибки") Тогда
					Продолжить;
				КонецЕсли;			
				
				ДанныеАдреса = XDTOКонтактная.Состав;
				
				НаименованиеСтраны = СокрЛП(ДанныеАдреса.Страна);
				Если ВРЕГ(НаименованиеСтраны) = ВРЕГ(СокрЛП(СсылкаНаРоссию.Наименование))
					//И УправлениеКонтактнойИнформациейСлужебный.ЭтоРоссийскийАдрес(ДанныеАдреса) 
					Тогда
					НаименованиеГорода = ДанныеАдреса.Состав.Город;
					Если Прав(НаименованиеГорода, 2) = " г" Тогда
						НаименованиеГорода = Лев(НаименованиеГорода, СтрДлина(НаименованиеГорода)-2);						
					КонецЕсли;
					СтрокаТЗ.ГородДоставки = Справочники.Города.НайтиПоНаименованию(НаименованиеГорода, Истина);
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
	КонецЦикла;
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат Результат;
	
КонецФункции

Процедура ЗаполнитьСпискиВыбораАдресовПолучателя(ЭлементыФормы, ДокОбъект) Экспорт
	
	Получатель = ДокОбъект.Контрагент;
	
	Если Не ЗначениеЗаполнено(Получатель) Тогда
		ОбщийМодульКлиентСервер.ОчиститьСпискиВыбораАдресовПолучателя(ЭлементыФормы);
		Возврат;
	КонецЕсли;
	
	СписокВыбора = Новый СписокЗначений;
	
	Для Каждого Стр Из АдресаПолучателяИзКонтактнойИнформации(Получатель) Цикл
		НайденныйЭлементСЗ = ОбщийМодульКлиентСервер.НайтиВСпискеСтруктур(СписокВыбора,"АдресДоставки",Стр.АдресДоставки);
		Если НайденныйЭлементСЗ = Неопределено Тогда
			СтруктураВыбора = СтруктураВыбора();
			ЗаполнитьЗначенияСвойств(СтруктураВыбора, Стр);
			СписокВыбора.Добавить(СтруктураВыбора, Стр.Вид + ": " + Стр.АдресДоставки);
		Иначе
			ДозаполнитьПустыеСвойства(НайденныйЭлементСЗ.Значение, Стр);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого Стр Из ПоследниеРеквизитыДоставкиИзДокументов(ДокОбъект.Ссылка, Получатель) Цикл
		НайденныйЭлементСЗ = ОбщийМодульКлиентСервер.НайтиВСпискеСтруктур(СписокВыбора,"АдресДоставки",Стр.АдресДоставки);
		Если НайденныйЭлементСЗ = Неопределено Тогда
			СтруктураВыбора = СтруктураВыбора();
			ЗаполнитьЗначенияСвойств(СтруктураВыбора, Стр);
			СписокВыбора.Добавить(СтруктураВыбора, Стр.АдресДоставки);
		Иначе
			ДозаполнитьПустыеСвойства(НайденныйЭлементСЗ.Значение, Стр);
		КонецЕсли;
		
	КонецЦикла;
	
	СкопироватьСписокЗначений(ЭлементыФормы.АдресДоставки.СписокВыбора, СписокВыбора);
	
КонецПроцедуры

// Заполняет реквизиты доставки в зависимости от элемента формы, в котором производятся изменения
// Параметры:
//		ЭлементыФормы - ВсеЭлементыФормы - все элементы формы, в которой производятся изменения,
//		ИмяЭлементаФормы - Строка - имя элемента формы, в котором произошли изменения,
//		ДокОбъект - ДанныеФормыСтруктура - объект, реквизиты которого используются при заполнении
//
Процедура ЗаполнитьРеквизитыДоставки(ЭлементыФормы, ДокОбъект) Экспорт
	
	Если НЕ ПолучитьФункциональнуюОпцию("УчитыватьДоставкуТовара") Тогда
		Возврат;
	КонецЕсли;
	
	Получатель = Новый Структура("ИмяПоля, Значение", "Контрагент", ДокОбъект.Контрагент);
	РеквизитыДоставки = ОбщийМодульКлиентСервер.ПолучитьПустуюСтруктуруРеквизитовДоставки();
	РеквизитыДоставки.Вставить(Получатель.ИмяПоля, Получатель.Значение);
	РеквизитыДоставки.Вставить("Ссылка");
	ЗаполнитьЗначенияСвойств(РеквизитыДоставки, ДокОбъект);
	
	// ИмяЭлементаФормы = "Контрагент"
	
	ОбщийМодульКлиентСервер.ОчиститьРеквизитыДоставки(ЭлементыФормы, РеквизитыДоставки);
	Если ЗначениеЗаполнено(Получатель.Значение) Тогда
		
		ЗаполнитьСпискиВыбораАдресовПолучателя(ЭлементыФормы, РеквизитыДоставки);
		Если ЭлементыФормы.АдресДоставки.СписокВыбора.Количество() > 0 Тогда
			ПерваяСтруктураВСписке = ЭлементыФормы.АдресДоставки.СписокВыбора[0].Значение;
			РеквизитыДоставки.АдресДоставки = ПерваяСтруктураВСписке.АдресДоставки;
			РеквизитыДоставки.АдресДоставкиЗначенияПолей = ПерваяСтруктураВСписке.АдресДоставкиЗначенияПолей;
		КонецЕсли;
		
		РеквизитыДоставки.СпособДоставки = ДокОбъект.СпособДоставки;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДокОбъект.СпособДоставки) И НЕ ДокОбъект.СпособДоставки = Справочники.СпособыДоставкиТовара.Самовывоз Тогда
		ЗаполнитьЗначенияСвойств(ДокОбъект, РеквизитыДоставки);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область Производство

//#13345
Процедура ИзменитьПолотнаВМатериалах(ДокОбъект, ЗаменитьПолотна = Ложь, Знач ЭтоОстаток = Истина) Экспорт
	
	Если ЭтоОстаток Тогда
		НоваяНоменклатура = Справочники.Номенклатура.ОстаткиПленки;
	Иначе
		НоваяНоменклатура = Справочники.Номенклатура.ПолотноЗаказчика;
	КонецЕсли;
	
	Если ЗаменитьПолотна Тогда
		Для Каждого ТекущаяСтрока Из ДокОбъект.Материалы Цикл
			Если ТекущаяСтрока.Номенклатура.ВидНоменклатуры = Справочники.ВидыНоменклатуры.Полотно Тогда
				СтараяНоменклатура = ТекущаяСтрока.Номенклатура;
				ТекущаяСтрока.Номенклатура = НоваяНоменклатура;
				ТекущаяСтрока.СерияНоменклатуры = Справочники.СерииНоменклатуры.ПустаяСсылка();
				ТекущаяСтрока.ХарактеристикаНоменклатуры = Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка();
				
				// У остатка / материала заказчика всегда базовая единица измерения
				// и коэффициент 1, старое количество переумножаем на коэффициент
				ТекущаяСтрока.ЕдиницаИзмерения = ТекущаяСтрока.Номенклатура.БазоваяЕдиницаИзмерения;
				ТекущаяСтрока.Количество = ТекущаяСтрока.Количество * ТекущаяСтрока.Коэффициент;
				ТекущаяСтрока.Коэффициент = 1;				
			КонецЕсли;
		КонецЦикла;
	Иначе
		НоваяСтрока = ДокОбъект.Материалы.Добавить();
		НоваяСтрока.Номенклатура = НоваяНоменклатура;
		НоваяСтрока.ЕдиницаИзмерения = НоваяСтрока.Номенклатура.БазоваяЕдиницаИзмерения;
		НоваяСтрока.Коэффициент = 1;
	КонецЕсли;
	
КонецПроцедуры


#КонецОбласти

#Область РаботаСЗаказами

Процедура ЗаполнитьТоварыЗаказаПокупателя(ТоварыЗаказаПокупателя, СсылкаНаЗаказ) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	ТоварыЗаказаПокупателя.Очистить();
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", СсылкаНаЗаказ);
	Запрос.Текст = 
	"ВЫБРАТЬ разрешенные
	|	ЗаказПокупателяТовары.НомерСтроки КАК НомерСтроки,
	|	ЗаказПокупателяТовары.АдресМонтажа КАК АдресМонтажа,
	|	ЗаказПокупателяТовары.Бесплатно КАК Бесплатно,
	|	ЗаказПокупателяТовары.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	ЗаказПокупателяТовары.ЗагруженоИзПостроителя КАК ЗагруженоИзПостроителя,
	|	ЗаказПокупателяТовары.ЗаказНаПроизводство КАК ЗаказНаПроизводство,
	|	ЗаказПокупателяТовары.Количество КАК Количество,
	|	ЗаказПокупателяТовары.КоличествоКВыработке КАК КоличествоКВыработке,
	|	ЗаказПокупателяТовары.Комната КАК Комната,
	|	ЗаказПокупателяТовары.Коэффициент КАК Коэффициент,
	|	ЗаказПокупателяТовары.Назначение КАК Назначение,
	|	ЗаказПокупателяТовары.Номенклатура КАК Номенклатура,
	|	ЗаказПокупателяТовары.НомерУпаковки КАК НомерУпаковки,
	|	ЗаказПокупателяТовары.Потолок КАК Потолок,
	|	ЗаказПокупателяТовары.ПроцентРучнойСкидки КАК ПроцентРучнойСкидки,
	|	ЗаказПокупателяТовары.СерияНоменклатуры КАК СерияНоменклатуры,
	|	ЗаказПокупателяТовары.Спецификация КАК Спецификация,
	|	ЗаказПокупателяТовары.Сумма КАК Сумма,
	|	ЗаказПокупателяТовары.СуммаРучнойСкидки КАК СуммаРучнойСкидки,
	|	ЗаказПокупателяТовары.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	|	ЗаказПокупателяТовары.Цена КАК Цена,
	|	ЗаказПокупателяТовары.ЦенаВал КАК ЦенаВал,
	|	ЗаказПокупателяТовары.УИСтроки КАК УИСтроки,
	|	ЗаказПокупателяТовары.УИСтрокиРодителя КАК УИСтрокиРодителя,
	|	ЗаказПокупателяТовары.СтавкаНДС КАК СтавкаНДС,
	|	ЗаказПокупателяТовары.СуммаНДС КАК СуммаНДС,
	|	ЗаказПокупателяТовары.СкидкаБонусами КАК СкидкаБонусами,
	|	ЗаказПокупателяТовары.БонусыКНачислению КАК БонусыКНачислению
	|ИЗ
	|	Документ.ЗаказПокупателя.Товары КАК ЗаказПокупателяТовары
	|ГДЕ
	|	ЗаказПокупателяТовары.Ссылка = &Ссылка";
	
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = ТоварыЗаказаПокупателя.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
	КонецЦикла;
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

#КонецОбласти

#Область РаботаСВозвратами

Функция ТаблицаСебестоимостиПродаж(МассивДокументовПродажи) Экспорт
	
	ТаблицаСебестоимости = Новый ТаблицаЗначений;
	Если МассивДокументовПродажи.Количество() > 0 Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТоварыНаСкладахОбороты.Номенклатура КАК Номенклатура,
		|	ТоварыНаСкладахОбороты.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
		|	ТоварыНаСкладахОбороты.СерияНоменклатуры КАК СерияНоменклатуры,
		|	ТоварыНаСкладахОбороты.Регистратор КАК Регистратор,
		|	ТоварыНаСкладахОбороты.КоличествоРасход КАК Количество,
		|	ТоварыНаСкладахОбороты.СуммаРасход КАК Сумма,
		|	ТоварыНаСкладахОбороты.СуммаРасход КАК СуммаВал,
		|	ВЫБОР
		|		КОГДА НЕ ТоварыНаСкладахОбороты.КоличествоРасход = 0
		|			ТОГДА ТоварыНаСкладахОбороты.СуммаРасход / ТоварыНаСкладахОбороты.КоличествоРасход
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК Цена,
		|	ВЫБОР
		|		КОГДА НЕ ТоварыНаСкладахОбороты.КоличествоРасход = 0
		|			ТОГДА ТоварыНаСкладахОбороты.СуммаВалРасход / ТоварыНаСкладахОбороты.КоличествоРасход
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК ЦенаВал
		|ИЗ
		|	РегистрНакопления.ТоварыНаСкладах.Обороты(, , Регистратор, ) КАК ТоварыНаСкладахОбороты
		|ГДЕ
		|	ТоварыНаСкладахОбороты.Регистратор В(&МассивДокументовПродажи)";
		
		Запрос.УстановитьПараметр("МассивДокументовПродажи", МассивДокументовПродажи);
		ТаблицаСебестоимости = Запрос.Выполнить().Выгрузить();
	КонецЕсли;
	
	Возврат ТаблицаСебестоимости;
	
КонецФункции

Функция МассивЗаказовПоРеализациям(ВозвратСсылка, ДокументПродажи, Номенклатура, ХарактеристикаНоменклатуры, СерияНоменклатуры) Экспорт 
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ПродажиОбороты.Номенклатура КАК Номенклатура,
	|	ПродажиОбороты.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	|	ПродажиОбороты.СерияНоменклатуры КАК СерияНоменклатуры,
	|	ПродажиОбороты.ДокументПродажи КАК ДокументПродажи,
	|	ПродажиОбороты.ЗаказПокупателя КАК ЗаказПокупателя,
	|	СУММА(ПродажиОбороты.КоличествоОборот) КАК Количество
	|ПОМЕСТИТЬ ВТ
	|ИЗ
	|	РегистрНакопления.Продажи.Обороты(, , Регистратор, ) КАК ПродажиОбороты
	|ГДЕ
	|	ПродажиОбороты.Регистратор <> &Регистратор
	|	И ПродажиОбороты.ДокументПродажи = &ДокументПродажи
	|	И ПродажиОбороты.Номенклатура = &Номенклатура
	|	И ПродажиОбороты.ХарактеристикаНоменклатуры = &ХарактеристикаНоменклатуры
	|	И ПродажиОбороты.СерияНоменклатуры = &СерияНоменклатуры
	|
	|СГРУППИРОВАТЬ ПО
	|	ПродажиОбороты.Номенклатура,
	|	ПродажиОбороты.ХарактеристикаНоменклатуры,
	|	ПродажиОбороты.СерияНоменклатуры,
	|	ПродажиОбороты.ДокументПродажи,
	|	ПродажиОбороты.ЗаказПокупателя
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ.ЗаказПокупателя КАК ЗаказПокупателя
	|ИЗ
	|	ВТ КАК ВТ
	|ГДЕ
	|	ВТ.Количество > 0
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ.ЗаказПокупателя";
	
	Запрос.УстановитьПараметр("Регистратор", ВозвратСсылка);
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("ХарактеристикаНоменклатуры", ХарактеристикаНоменклатуры);
	Запрос.УстановитьПараметр("СерияНоменклатуры", СерияНоменклатуры);
	Запрос.УстановитьПараметр("ДокументПродажи", ДокументПродажи);
	ТаблицаПродаж = Запрос.Выполнить().Выгрузить();
	
	Возврат ТаблицаПродаж.ВыгрузитьКолонку("ЗаказПокупателя");
	
КонецФункции

Функция МассивРеализацийПоЗаказуИНоменклатуре(ВозвратСсылка, ЗаказПокупателя, Номенклатура, ХарактеристикаНоменклатуры, СерияНоменклатуры) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Регистратор", ВозвратСсылка);
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("ХарактеристикаНоменклатуры", ХарактеристикаНоменклатуры);
	Запрос.УстановитьПараметр("СерияНоменклатуры", СерияНоменклатуры);
	Запрос.УстановитьПараметр("ЗаказПокупателя", ЗаказПокупателя);
	Запрос.УстановитьПараметр("ОтборПоЗаказу", ЗначениеЗаполнено(ЗаказПокупателя));
	
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ПродажиОбороты.Номенклатура КАК Номенклатура,
	|	ПродажиОбороты.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	|	ПродажиОбороты.СерияНоменклатуры КАК СерияНоменклатуры,
	|	ПродажиОбороты.ДокументПродажи КАК ДокументПродажи,
	|	ПродажиОбороты.ЗаказПокупателя КАК ЗаказПокупателя,
	|	СУММА(ПродажиОбороты.КоличествоОборот) КАК Количество
	|ПОМЕСТИТЬ ВТ
	|ИЗ
	|	РегистрНакопления.Продажи.Обороты(, , Регистратор, ) КАК ПродажиОбороты
	|ГДЕ
	|	ПродажиОбороты.Регистратор <> &Регистратор
	|	И ВЫБОР КОГДА &ОтборПоЗаказу ТОГДА ПродажиОбороты.ЗаказПокупателя = &ЗаказПокупателя ИНАЧЕ ИСТИНА КОНЕЦ
	|	И ПродажиОбороты.Номенклатура = &Номенклатура
	|	И ПродажиОбороты.ХарактеристикаНоменклатуры = &ХарактеристикаНоменклатуры
	|	И ПродажиОбороты.СерияНоменклатуры = &СерияНоменклатуры
	|
	|СГРУППИРОВАТЬ ПО
	|	ПродажиОбороты.Номенклатура,
	|	ПродажиОбороты.ХарактеристикаНоменклатуры,
	|	ПродажиОбороты.СерияНоменклатуры,
	|	ПродажиОбороты.ДокументПродажи,
	|	ПродажиОбороты.ЗаказПокупателя
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ.ДокументПродажи КАК ДокументПродажи
	|ИЗ
	|	ВТ КАК ВТ
	|ГДЕ
	|	ВТ.Количество > 0
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ.ДокументПродажи";
	
	ТаблицаПродаж = Запрос.Выполнить().Выгрузить();
	Возврат ТаблицаПродаж.ВыгрузитьКолонку("ДокументПродажи");	
	
КонецФункции

#КонецОбласти

#Область РаботаСРозницей

Процедура ЗаполнитьПодчиненныеДокументыПоПотолкам(ДокументСсылка, МассивПотолков, ПодчиненныеДокументыПоПотолку) Экспорт
	
	ПодчиненныеДокументыПоПотолку.Очистить();
	
	УстановитьПривилегированныйРежим(Истина);
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("МассивПотолков", МассивПотолков);
	Запрос.УстановитьПараметр("Основание", ДокументСсылка);
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЗаказПоставщикуТовары.Ссылка КАК Документ,
	|	ЗаказПоставщикуТовары.Номенклатура КАК Потолок
	|ИЗ
	|	Документ.ЗаказПоставщику.Товары КАК ЗаказПоставщикуТовары
	|ГДЕ
	|	ЗаказПоставщикуТовары.Номенклатура В(&МассивПотолков)
	|	И ЗаказПоставщикуТовары.Ссылка.Проведен
	|	И ЗаказПоставщикуТовары.Ссылка.Основание = &Основание
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ПоступлениеТоваровИУслуг.Ссылка,
	|	ПоступлениеТоваровИУслуг.Номенклатура
	|ИЗ
	|	Документ.ПоступлениеТоваровИУслуг.Товары КАК ПоступлениеТоваровИУслуг
	|ГДЕ
	|	ПоступлениеТоваровИУслуг.Номенклатура В(&МассивПотолков)
	|	И ПоступлениеТоваровИУслуг.Ссылка.Проведен
	|	И ПоступлениеТоваровИУслуг.Ссылка.Основание = &Основание";
	//|
	//|ОБЪЕДИНИТЬ ВСЕ
	//|
	//|ВЫБРАТЬ
	//|	ЗаказНаПроизводство.Ссылка КАК Документ,
	//|	ЗаказНаПроизводство.ПродукцияНоменклатура
	//|ИЗ
	//|	Документ.ЗаказНаПроизводство КАК ЗаказНаПроизводство
	//|ГДЕ
	//|	ЗаказНаПроизводство.Проведен
	//|	И ЗаказНаПроизводство.ПродукцияНоменклатура В(&МассивПотолков)";
		
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = ПодчиненныеДокументыПоПотолку.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
	КонецЦикла;
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

Функция ВидОперацииМонтажаПоВидуЗаказа(ВидЗаказа) Экспорт
	
	СоответствиеВидов = Новый Соответствие;
	СоответствиеВидов.Вставить(Справочники.ВидыЗаказДоговоров.Договор, Справочники.ВидыМонтажа.Монтаж);
	СоответствиеВидов.Вставить(Справочники.ВидыЗаказДоговоров.Рекламация, Справочники.ВидыМонтажа.Рекламация);
	СоответствиеВидов.Вставить(Справочники.ВидыЗаказДоговоров.СервиснаяЗаявка, Справочники.ВидыМонтажа.СервиснаяЗаявка);
	СоответствиеВидов.Вставить(Справочники.ВидыЗаказДоговоров.Продажа, Справочники.ВидыМонтажа.Продажа);
	
	Возврат СоответствиеВидов.Получить(ВидЗаказа);
	
КонецФункции

Функция ПроверитьНаличиеМонтажейПоВиду(ВидОперацииМонтажа, Основание, ТолькоВыполненные, ИсключитьПродажи) Экспорт
	
	Если НЕ ЗначениеЗаполнено(Основание) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	ДанныеДокумента.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.Монтаж КАК ДанныеДокумента
	|ГДЕ
	|	ДанныеДокумента.Проведен
	|	И ДанныеДокумента.Основание = &Основание
	|	И ДанныеДокумента.ВидОперации = &ВидОперации
	|	И ВЫБОР
	|			КОГДА &ТолькоВыполненные
	|				ТОГДА ДанныеДокумента.Результат В (ЗНАЧЕНИЕ(Справочник.РезультатыМонтажа.Выполнен), ЗНАЧЕНИЕ(Справочник.РезультатыМонтажа.Закрыт))
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|	И ВЫБОР
	|			КОГДА &ИсключитьПродажи
	|				ТОГДА НЕ ДанныеДокумента.ВидОперации В (ЗНАЧЕНИЕ(Справочник.ВидыМонтажа.Продажа))
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ";
	
	Запрос.УстановитьПараметр("Основание", Основание);
	Запрос.УстановитьПараметр("ВидОперации", ВидОперацииМонтажа);
	Запрос.УстановитьПараметр("ТолькоВыполненные", ТолькоВыполненные);
	Запрос.УстановитьПараметр("ИсключитьПродажи", ИсключитьПродажи);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат НЕ РезультатЗапроса.Пустой();
	
КонецФункции

Функция ПолучитьДатуПодписанияДокументаМонтажа(СсылкаНаОбъект)  Экспорт
	
	РеквизитыДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СсылкаНаОбъект, "ВариантЗаполненияДатыПодписания, СрокМонтажа, Дата, ДатаМонтажа, ДатаПодписанияДокументов, ДатаВыполнения");
	
	Если РеквизитыДокумента.ВариантЗаполненияДатыПодписания = Перечисления.ВариантыЗаполненияДатыПодписанияВМонтаже.НеЗаполнять Тогда
		Возврат Дата(1,1,1);
	КонецЕсли;
	
	Если РеквизитыДокумента.ВариантЗаполненияДатыПодписания = Перечисления.ВариантыЗаполненияДатыПодписанияВМонтаже.ДатойДокумента Тогда
		Возврат РеквизитыДокумента.Дата;
	КонецЕсли;	
		
	Если РеквизитыДокумента.ВариантЗаполненияДатыПодписания = Перечисления.ВариантыЗаполненияДатыПодписанияВМонтаже.ДатойВыполненияМонтажа Тогда
		Возврат РеквизитыДокумента.ДатаВыполнения;
	КонецЕсли;	
		
	Если РеквизитыДокумента.ВариантЗаполненияДатыПодписания = Перечисления.ВариантыЗаполненияДатыПодписанияВМонтаже.ПлановойДатойНачалаМонтажа Тогда
		Возврат РеквизитыДокумента.ДатаМонтажа;
	КонецЕсли;		
		
	Если РеквизитыДокумента.ВариантЗаполненияДатыПодписания = Перечисления.ВариантыЗаполненияДатыПодписанияВМонтаже.ПлановойДатойЗавершенияМонтажа Тогда
		Если РеквизитыДокумента.СрокМонтажа = Перечисления.СрокиМонтажа.МонтажНаНесколькоДней Тогда
			РасчетнаяДатаПечати = Дата(1,1,1);
			Для каждого Запись из СсылкаНаОбъект.ГрафикМонтажей Цикл
				РасчетнаяДатаПечати = ?(РасчетнаяДатаПечати < Запись.ДатаМонтажа, Запись.ДатаМонтажа, РасчетнаяДатаПечати);
			КонецЦикла;
			Возврат РасчетнаяДатаПечати;
		Иначе	
			Возврат РеквизитыДокумента.ДатаВыполнения;
		КонецЕсли;
	КонецЕсли;		
		
	Если РеквизитыДокумента.ВариантЗаполненияДатыПодписания = Перечисления.ВариантыЗаполненияДатыПодписанияВМонтаже.ПроизвольнаяДата Тогда
		Возврат РеквизитыДокумента.ДатаПодписанияДокументов;
	КонецЕсли;	
	
КонецФункции	

Функция ПолучитьИнтервалыВремениСледующегоКонтакта() Экспорт

	Интервалы = Новый СписокЗначений;
	
	//#16861
	ВремяНачала = Константы.ВремяНачалаСледующегоКонтакта.Получить();
	ВремяОкончания = Константы.ВремяОкончанияСледующегоКонтакта.Получить();
	Шаг = Константы.ШагВремениВыбораСледующегоКонтакта.Получить();
	
	Если ЗначениеЗаполнено(ВремяНачала) И ЗначениеЗаполнено(ВремяОкончания) 
		И ЗначениеЗаполнено(Шаг)
		И ВремяНачала <= ВремяОкончания Тогда 		
		
		Пока ВремяНачала <= ВремяОкончания Цикл
			Интервалы.Добавить(ВремяНачала, Формат(ВремяНачала, "ДФ=HH:mm"));
			ВремяНачала = ВремяНачала + Шаг*60*60;
		КонецЦикла;
	КонецЕсли;		
		
	Возврат Интервалы;
	
КонецФункции

#КонецОбласти

