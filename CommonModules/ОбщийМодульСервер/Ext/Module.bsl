Функция СтруктураПолейЛидаПриАвтоматическомСоздании() Экспорт
	
	//#14718
	СтруктураВозврата = Новый Структура;
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ПорядокЗаполненияПолейЛида.ИмяПредопределенныхДанных КАК ИмяПредопределенныхДанных
	|ИЗ
	|	Справочник.ПорядокЗаполненияПолейЛида КАК ПорядокЗаполненияПолейЛида
	|
	|УПОРЯДОЧИТЬ ПО
	|	ПорядокЗаполненияПолейЛида.РеквизитДопУпорядочивания";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		СтруктураВозврата.Вставить(Выборка.ИмяПредопределенныхДанных, Неопределено);
	КонецЦикла;
	
	Возврат СтруктураВозврата;
	
КонецФункции

Функция ЗаполнитьПоляЛидаПриАвтоматическомСоздании(ЛидОбъект, СтруктураПолей) Экспорт
	
	//#14718
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ПорядокЗаполненияПолейЛида.Ссылка КАК Ссылка,
	|	ПорядокЗаполненияПолейЛида.Наименование КАК Наименование,
	|	ПорядокЗаполненияПолейЛида.ИмяПредопределенныхДанных КАК ИмяПредопределенныхДанных
	|ИЗ
	|	Справочник.ПорядокЗаполненияПолейЛида КАК ПорядокЗаполненияПолейЛида
	|
	|УПОРЯДОЧИТЬ ПО
	|	ПорядокЗаполненияПолейЛида.РеквизитДопУпорядочивания";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		ИмяПоля = Выборка.ИмяПредопределенныхДанных;
		
		// поле в рамках данного способа создания лида не заполняется
		Если СтруктураПолей[ИмяПоля] = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Если ИмяПоля = "ТелефонКлиента" Тогда
			 УправлениеКонтактнойИнформациейПотолки.ЗаписатьКонтактнуюИнформацию(ЛидОбъект, СтруктураПолей[ИмяПоля], 
			 																	 Справочники.ВидыКонтактнойИнформации.ТелефонКонтрагента, 
																				 Перечисления.ТипыКонтактнойИнформации.Телефон, Новый УникальныйИдентификатор);
		Иначе			
			ЛидОбъект[ИмяПоля] = СтруктураПолей[ИмяПоля];
		КонецЕсли;
	
		Если ИмяПоля = "РекламнаяАкция" И ЗначениеЗаполнено(ЛидОбъект.РекламнаяАкция) Тогда
			РеквизитыРА = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ЛидОбъект.РекламнаяАкция, 
					"Организация, Подразделение, Город,
					|РекламныйИсточник"); //, ОчищатьРанееУстановленныеРеквизитыВЛидеПриУстановкеНовыхЗначений");		
			Если ЗначениеЗаполнено(РеквизитыРА.Подразделение) И НЕ Константы.ИспользоватьПодразделения.Получить() Тогда
				РеквизитыРА.Подразделение = Справочники.Подразделения.ПустаяСсылка();	
			КонецЕсли;
			
			// изменено в рамках той же заявки: заполняем реквизит лида если только заполнено значение в рекламном источнике / акции
			//Если НЕ ЗначениеЗаполнено(ЛидОбъект.Организация) 
			//	ИЛИ РеквизитыРА.ОчищатьРанееУстановленныеРеквизитыВЛидеПриУстановкеНовыхЗначений Тогда
			Если ЗначениеЗаполнено(РеквизитыРА.Организация) Тогда
				ЛидОбъект.Организация = РеквизитыРА.Организация;
			КонецЕсли;
			//Если НЕ ЗначениеЗаполнено(ЛидОбъект.Подразделение) 
			//	ИЛИ РеквизитыРА.ОчищатьРанееУстановленныеРеквизитыВЛидеПриУстановкеНовыхЗначений Тогда
			Если ЗначениеЗаполнено(РеквизитыРА.Подразделение) Тогда
				ЛидОбъект.Подразделение = РеквизитыРА.Подразделение;
			КонецЕсли;
			//Если НЕ ЗначениеЗаполнено(ЛидОбъект.Город) 
			//	ИЛИ РеквизитыРА.ОчищатьРанееУстановленныеРеквизитыВЛидеПриУстановкеНовыхЗначений Тогда
			Если ЗначениеЗаполнено(РеквизитыРА.Город) Тогда
				ЛидОбъект.Город = РеквизитыРА.Город;
			КонецЕсли;
			//Если НЕ ЗначениеЗаполнено(ЛидОбъект.РекламныйИсточник) 
			//	ИЛИ РеквизитыРА.ОчищатьРанееУстановленныеРеквизитыВЛидеПриУстановкеНовыхЗначений Тогда
			Если ЗначениеЗаполнено(РеквизитыРА.РекламныйИсточник) Тогда
				ЛидОбъект.РекламныйИсточник = РеквизитыРА.РекламныйИсточник;
			КонецЕсли;
			
		ИначеЕсли ИмяПоля = "РекламныйИсточник" И ЗначениеЗаполнено(ЛидОбъект.РекламныйИсточник) Тогда			
			РеквизитыРИ = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ЛидОбъект.РекламныйИсточник, 
					"Организация, Подразделение, Город,
					|РекламнаяАкция"); //, ОчищатьРанееУстановленныеРеквизитыВЛидеПриУстановкеНовыхЗначений");	
			Если ЗначениеЗаполнено(РеквизитыРИ.Подразделение) И НЕ Константы.ИспользоватьПодразделения.Получить() Тогда
				РеквизитыРИ.Подразделение = Справочники.Подразделения.ПустаяСсылка();	
			КонецЕсли;
			
			//Если НЕ ЗначениеЗаполнено(ЛидОбъект.Организация) 
			//	ИЛИ РеквизитыРИ.ОчищатьРанееУстановленныеРеквизитыВЛидеПриУстановкеНовыхЗначений Тогда
			Если ЗначениеЗаполнено(РеквизитыРИ.Организация) Тогда
				ЛидОбъект.Организация = РеквизитыРИ.Организация;
			КонецЕсли;
			//Если НЕ ЗначениеЗаполнено(ЛидОбъект.Подразделение) 
			//	ИЛИ РеквизитыРИ.ОчищатьРанееУстановленныеРеквизитыВЛидеПриУстановкеНовыхЗначений Тогда
			Если ЗначениеЗаполнено(РеквизитыРИ.Подразделение) Тогда
				ЛидОбъект.Подразделение = РеквизитыРИ.Подразделение;
			КонецЕсли;
			//Если НЕ ЗначениеЗаполнено(ЛидОбъект.Город) 
			//	ИЛИ РеквизитыРИ.ОчищатьРанееУстановленныеРеквизитыВЛидеПриУстановкеНовыхЗначений Тогда
			Если ЗначениеЗаполнено(РеквизитыРИ.Город) Тогда
				ЛидОбъект.Город = РеквизитыРИ.Город;
			КонецЕсли;
			//Если НЕ ЗначениеЗаполнено(ЛидОбъект.РекламнаяАкция) 
			//	ИЛИ РеквизитыРИ.ОчищатьРанееУстановленныеРеквизитыВЛидеПриУстановкеНовыхЗначений Тогда
			Если ЗначениеЗаполнено(РеквизитыРИ.РекламнаяАкция) Тогда
				ЛидОбъект.РекламнаяАкция = РеквизитыРИ.РекламнаяАкция;
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
КонецФункции

#Область КонтрольМатериаловВПроизводстве

//++ №14311 контроль материалов в производстве
Процедура ВыполнитьКонтрольМатериаловВПроизводстве(Дата, Организация, Материалы1, Материалы2, Отказ, ВидДокументаКонтроля) Экспорт
	
	// Сначала нужно найти документ настройки контроля, если нет подходящего выводим сообщение и контроль не выполняем
	Запрос = новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	НастройкаКонтроляМатериаловВПроизводстве.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.НастройкаКонтроляМатериаловВПроизводстве КАК НастройкаКонтроляМатериаловВПроизводстве
	|ГДЕ
	|	НастройкаКонтроляМатериаловВПроизводстве.Организация = &Организация
	|	И НастройкаКонтроляМатериаловВПроизводстве.ВидДокументаКонтроля = &ВидДокументаКонтроля
	|	И НастройкаКонтроляМатериаловВПроизводстве.Дата <= &Дата
	|
	|УПОРЯДОЧИТЬ ПО
	|	НастройкаКонтроляМатериаловВПроизводстве.Дата УБЫВ
	|";
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ВидДокументаКонтроля", ВидДокументаКонтроля);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		ДокументКонтроля = Выборка.Ссылка;
		
	Иначе
		
		Сообщить(СтрШаблон("По организации %1, на дату %2 не найден документ настройки контроля материалов в производстве.", Организация, Дата));
		Возврат;
		
	КонецЕсли;
	
	Материалы1.Колонки.Добавить("ГруппаНоменклатуры", новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	Материалы1.Колонки.Добавить("ВидНоменклатуры", новый ОписаниеТипов("СправочникСсылка.ВидыНоменклатуры"));
	Материалы1.Колонки.Добавить("КонтролироватьКоличество", новый ОписаниеТипов("Булево"));
	Материалы1.Колонки.Добавить("КонтролироватьВыработку", новый ОписаниеТипов("Булево"));
	Материалы1.Колонки.Добавить("ПопозиционныйКонтроль", новый ОписаниеТипов("Булево"));
	
	МассивНоменклатур = Материалы1.ВыгрузитьКолонку("Номенклатура");
	
	ПривестиВидыНоменклатурыКСоответствиюПроверкиМатериалов(Материалы1);
	
	Материалы2.Колонки.Добавить("ГруппаНоменклатуры", новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	Материалы2.Колонки.Добавить("ВидНоменклатуры", новый ОписаниеТипов("СправочникСсылка.ВидыНоменклатуры"));
	Материалы2.Колонки.Добавить("КонтролироватьКоличество", новый ОписаниеТипов("Булево"));
	Материалы2.Колонки.Добавить("КонтролироватьВыработку", новый ОписаниеТипов("Булево"));
	Материалы2.Колонки.Добавить("ПопозиционныйКонтроль", новый ОписаниеТипов("Булево"));
	
	Для Каждого ТекущаяСтрока Из Материалы2 Цикл
		МассивНоменклатур.Добавить(ТекущаяСтрока.Номенклатура);
	КонецЦикла;
	
	ПривестиВидыНоменклатурыКСоответствиюПроверкиМатериалов(Материалы2);
	
	// Сначала получим данные для контроля по "Группам номенклатуры" т.к. это сложный контроль с учётом иерархии
	Запрос = новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	НастройкаКонтроляМатериаловВПроизводствеНоменклатура.Номенклатура КАК ГруппаНоменклатуры,
	|	НастройкаКонтроляМатериаловВПроизводствеНоменклатура.КонтролироватьКоличество КАК КонтролироватьКоличество,
	|	НастройкаКонтроляМатериаловВПроизводствеНоменклатура.КонтролироватьВыработку КАК КонтролироватьВыработку,
	|	НастройкаКонтроляМатериаловВПроизводствеНоменклатура.ПопозиционныйКонтроль КАК ПопозиционныйКонтроль,
	|	0 КАК Уровень
	|ИЗ
	|	Документ.НастройкаКонтроляМатериаловВПроизводстве.Номенклатура КАК НастройкаКонтроляМатериаловВПроизводствеНоменклатура
	|ГДЕ
	|	НастройкаКонтроляМатериаловВПроизводствеНоменклатура.Номенклатура.ЭтоГруппа
	|	И НастройкаКонтроляМатериаловВПроизводствеНоменклатура.Ссылка = &ДокументКонтроля
	|";
	Запрос.УстановитьПараметр("ДокументКонтроля", ДокументКонтроля);
	
	НастройкиКонтроляПоГруппам = Запрос.Выполнить().Выгрузить();
	
	// Сделаем сортировку по уровням, чтобы если например выбрали и основную группу и ещё подгруппу из этой группы
	// тогда подгруппа будет более высокая по приоритету (обработается в конце)
	Для Каждого ТекущаяСтрока Из НастройкиКонтроляПоГруппам Цикл
		ТекущаяСтрока.Уровень = ТекущаяСтрока.ГруппаНоменклатуры.Уровень();
	КонецЦикла;
	
	НастройкиКонтроляПоГруппам.Сортировать("Уровень");
	
	// Делаем в цикле по кажой группе номенклатуры, т.к. в ИЕРАРХИИ и нам нужно знать по какой конечной группе идёт контроль
	Для Каждого НастройкаКонтроляПоГруппам Из НастройкиКонтроляПоГруппам Цикл
		
		Запрос = новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Номенклатура.Ссылка КАК Номенклатура
		|ИЗ
		|	Справочник.Номенклатура КАК Номенклатура
		|ГДЕ
		|	Номенклатура.Ссылка В (&МассивНоменклатур)
		|	И Номенклатура.Ссылка В ИЕРАРХИИ (&ГруппаНоменклатуры)
		|";
		Запрос.УстановитьПараметр("МассивНоменклатур", МассивНоменклатур);
		Запрос.УстановитьПараметр("ГруппаНоменклатуры", НастройкаКонтроляПоГруппам.ГруппаНоменклатуры);
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Пока Выборка.Следующий() Цикл
			
			// Заполняем в ТЧ №1
			НайденныеСтроки = Материалы1.НайтиСтроки(новый Структура("Номенклатура", Выборка.Номенклатура));
			
			Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
				ЗаполнитьЗначенияСвойств(НайденнаяСтрока, НастройкаКонтроляПоГруппам);
			КонецЦикла;
			
			// Заполняем в ТЧ №2
			НайденныеСтроки = Материалы2.НайтиСтроки(новый Структура("Номенклатура", Выборка.Номенклатура));
			
			Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
				ЗаполнитьЗначенияСвойств(НайденнаяСтрока, НастройкаКонтроляПоГруппам);
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Запрос = новый Запрос;
	Запрос.Текст = "
	// Настройки контроля "Вид номенклатуры"
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	НастройкаКонтроляМатериаловВПроизводствеВидНоменклатуры.ВидНоменклатуры КАК ВидНоменклатуры,
	|	НастройкаКонтроляМатериаловВПроизводствеВидНоменклатуры.КонтролироватьКоличество КАК КонтролироватьКоличество,
	|	НастройкаКонтроляМатериаловВПроизводствеВидНоменклатуры.КонтролироватьВыработку КАК КонтролироватьВыработку,
	|	НастройкаКонтроляМатериаловВПроизводствеВидНоменклатуры.ПопозиционныйКонтроль КАК ПопозиционныйКонтроль
	|ПОМЕСТИТЬ ВТ_НастройкаКонтроляПоВидуНоменклатуры
	|ИЗ
	|	Документ.НастройкаКонтроляМатериаловВПроизводстве.ВидНоменклатуры КАК НастройкаКонтроляМатериаловВПроизводствеВидНоменклатуры
	|ГДЕ
	|	НастройкаКонтроляМатериаловВПроизводствеВидНоменклатуры.Ссылка = &ДокументКонтроля
	|
	|;
	|///////////////////////////////////////
	// Настройки контроля "Номенклатура" (только элементы)
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	НастройкаКонтроляМатериаловВПроизводствеНоменклатура.Номенклатура.ЭтоГруппа КАК ЭтоГруппа,
	|	НастройкаКонтроляМатериаловВПроизводствеНоменклатура.Номенклатура КАК Номенклатура,
	|	НастройкаКонтроляМатериаловВПроизводствеНоменклатура.КонтролироватьКоличество КАК КонтролироватьКоличество,
	|	НастройкаКонтроляМатериаловВПроизводствеНоменклатура.КонтролироватьВыработку КАК КонтролироватьВыработку,
	|	НастройкаКонтроляМатериаловВПроизводствеНоменклатура.ПопозиционныйКонтроль КАК ПопозиционныйКонтроль
	|ПОМЕСТИТЬ ВТ_НастройкаКонтроляПоНоменклатуре
	|ИЗ
	|	Документ.НастройкаКонтроляМатериаловВПроизводстве.Номенклатура КАК НастройкаКонтроляМатериаловВПроизводствеНоменклатура
	|ГДЕ
	|	НЕ НастройкаКонтроляМатериаловВПроизводствеНоменклатура.Номенклатура.ЭтоГруппа
	|	И НастройкаКонтроляМатериаловВПроизводствеНоменклатура.Ссылка = &ДокументКонтроля
	|
	|;
	|///////////////////////////////////////
	// Исходная "Материалы ТЧ №1"
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Материалы1.Номенклатура КАК Номенклатура,
	|	Материалы1.ВидНоменклатуры КАК ВидНоменклатуры,
	|	ЕСТЬNULL(Материалы1.КоличествоКВыработке, 0) КАК КоличествоКВыработке,
	|	ЕСТЬNULL(Материалы1.Количество, 0)  * ЕСТЬNULL(Материалы1.Коэффициент, 0) КАК Количество
	|ПОМЕСТИТЬ ВТ_Материалы1_Исходная
	|ИЗ
	|	&Материалы1 КАК Материалы1
	|;
	|////////////////////////////////////////////////////////////////////////////////
	// Материалы ТЧ №1 с настройкой "Номенклатура" (только элементы)
