		|			ТОГДА 2 // пустой кружок
		|		КОГДА ЕСТЬNULL(ВТ_ЗаказыПоставщикам.ЗаказанОборот, 0) > 0
		|			И ЕСТЬNULL(ВТ_ЗаказыПоставщикам.ПолученОборот, 0) < ЕСТЬNULL(ВТ_ЗаказыПоставщикам.ЗаказанОборот, 0)
		|			ТОГДА 1  // частично закрашен
		|		КОГДА (ЕСТЬNULL(ВТ_ЗаказыПоставщикам.ЗаказанОборот, 0) > 0
		|				И ЕСТЬNULL(ВТ_ЗаказыПоставщикам.ПолученОборот, 0) >= ЕСТЬNULL(ВТ_ЗаказыПоставщикам.ЗаказанОборот, 0))		
		|			ИЛИ (ЕСТЬNULL(ВТ_ЗаказыПоставщикам.ЗаказанОборот, 0) = 0
		|				И ЕСТЬNULL(ВТ_ЗаказыПоставщикам.ПолученОборот, 0) > 0)
		|			ТОГДА 0 // полностью закрашен
		|		ИНАЧЕ -1  // пусто
		|	КОНЕЦ КАК СтатусЗаказаРозницыПоставщикам");
		
		ТекстЗапроса = ТекстЗапроса + 
		"
		|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ЗаказыРозницыПоставщикам.Обороты(, , Авто, ЗаказДоговор ССЫЛКА Документ.ЗаказДоговор) КАК ВТ_ЗаказыПоставщикам
		|	ПО ДокументЗаказДоговор.Ссылка = ВТ_ЗаказыПоставщикам.ЗаказДоговор
		|";
		
	КонецЕсли;
	
	СписокЗаказДоговоры.ТекстЗапроса = ТекстЗапроса;
	
КонецПроцедуры

Процедура МонтажиОсобыйОтборПриИзменении(СписокМонтажи, СтандартныйТекстЗапросаСписка, ПоляОтбора) Экспорт
	
	// ПРИ ИЗМЕНЕНИИ ЗАПРОСОВ ИЗМЕНЯТЬ ПРОЦЕДУРУ ОбщийМодульСервер.РозницаПриПолученииДанныхНаСервере()
	
	// применяем стандартный текст запроса
	ТекстЗапроса = СтандартныйТекстЗапросаСписка;
	
	МонтажиОтборПоСтатусуПроизводства = -9;
	МонтажиОтборПоСтатусуЗакупки      = -9;
	ПоляОтбора.Свойство("МонтажиОтборПоСтатусуПроизводства", МонтажиОтборПоСтатусуПроизводства);
	ПоляОтбора.Свойство("МонтажиОтборПоСтатусуЗакупки",      МонтажиОтборПоСтатусуЗакупки);
	
	СписокМонтажи.КомпоновщикНастроек.Настройки.ДополнительныеСвойства.Вставить("ОтборПоСтатусуПроизводства",   		МонтажиОтборПоСтатусуПроизводства);
	СписокМонтажи.КомпоновщикНастроек.Настройки.ДополнительныеСвойства.Вставить("ОтборПоСтатусуЗакупки",   				МонтажиОтборПоСтатусуЗакупки);
	
	Если НЕ МонтажиОтборПоСтатусуПроизводства = -9 Тогда
		
		ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ОбеспечениеЗаказовРозницыОбороты.Заказ КАК Заказ,
		|	ВЫБОР
		|		КОГДА ОбеспечениеЗаказовРозницыОбороты.Регистратор.ТекущийСтатус = ЗНАЧЕНИЕ(справочник.СтатусыЗаказовПокупателей.ВРаботе)
		|			ТОГДА 1
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК КоличествоЗаказовПокупателейВРаботе,
		|	ВЫБОР
		|		КОГДА ОбеспечениеЗаказовРозницыОбороты.Регистратор.ТекущийСтатус = ЗНАЧЕНИЕ(справочник.СтатусыЗаказовПокупателей.Выполнен)
		|			ТОГДА 1
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК КоличествоЗаказовПокупателейВыполненных
		|ПОМЕСТИТЬ ВТ_ЗаказыПокупателейВрем
		|ИЗ
		|	РегистрНакопления.ОбеспечениеЗаказовРозницы.Обороты(, , Авто, Заказ ССЫЛКА Документ.Монтаж) КАК ОбеспечениеЗаказовРозницыОбороты
		|ГДЕ
		|	ТИПЗНАЧЕНИЯ(ОбеспечениеЗаказовРозницыОбороты.Регистратор) = ТИП(Документ.ЗаказПокупателя)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВТ_ЗаказыПокупателейВрем.Заказ КАК ДокументРозницы,
		|	СУММА(ВТ_ЗаказыПокупателейВрем.КоличествоЗаказовПокупателейВРаботе) КАК КоличествоВРаботе,
		|	СУММА(ВТ_ЗаказыПокупателейВрем.КоличествоЗаказовПокупателейВыполненных) КАК КоличествоВыполненных
		|ПОМЕСТИТЬ ВТ_ЗаказыПокупателейВрем2
		|ИЗ
		|	ВТ_ЗаказыПокупателейВрем КАК ВТ_ЗаказыПокупателейВрем
		|
		|СГРУППИРОВАТЬ ПО
		|	ВТ_ЗаказыПокупателейВрем.Заказ
		|
		|;
		|////////////////////////////////////////////////////////////////////////////////
		|" + ТекстЗапроса;
		
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "-1 КАК СтатусЗаказаРозницыНаПроизводство", 
		"	ВЫБОР
		|		КОГДА ЕСТЬNULL(ВТ_ЗаказыПокупателейВрем2.КоличествоВРаботе, 0) = 0 И ЕСТЬNULL(ВТ_ЗаказыПокупателейВрем2.КоличествоВыполненных, 0) = 0 
		|			ТОГДА -1 // нет ЗП (пусто)
		|		КОГДА ЕСТЬNULL(ВТ_ЗаказыПокупателейВрем2.КоличествоВРаботе, 0) > 0 И ЕСТЬNULL(ВТ_ЗаказыПокупателейВрем2.КоличествоВыполненных, 0) = 0 
		|			ТОГДА 2 // все в работе (пустой кружок)
		|		КОГДА ЕСТЬNULL(ВТ_ЗаказыПокупателейВрем2.КоличествоВРаботе, 0) > 0 И ЕСТЬNULL(ВТ_ЗаказыПокупателейВрем2.КоличествоВыполненных, 0) > 0 
		|			ТОГДА 1 // есть и в работе и выполненные (частично закрашен)
		|		КОГДА ЕСТЬNULL(ВТ_ЗаказыПокупателейВрем2.КоличествоВРаботе, 0) = 0 И ЕСТЬNULL(ВТ_ЗаказыПокупателейВрем2.КоличествоВыполненных, 0) > 0 
		|			ТОГДА 0 // все выполнены работе (полностью закрашен)
		|		ИНАЧЕ -1
		|	КОНЕЦ КАК СтатусЗаказаРозницыНаПроизводство");
		
		ТекстЗапроса = ТекстЗапроса + 
		"
		|	ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ЗаказыПокупателейВрем2 КАК ВТ_ЗаказыПокупателейВрем2
		|	ПО ДокМонтаж.Ссылка = ВТ_ЗаказыПокупателейВрем2.ДокументРозницы
		|";
		
	КонецЕсли;
	
	Если НЕ МонтажиОтборПоСтатусуЗакупки = -9 Тогда
		
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "-1 КАК СтатусЗаказаРозницыПоставщикам", 
		"	ВЫБОР
		|		КОГДА ЕСТЬNULL(ВТ_ЗаказыПоставщикам.ЗаказанОборот, 0) > 0
		|			И ЕСТЬNULL(ВТ_ЗаказыПоставщикам.ПолученОборот, 0) = 0
		|			ТОГДА 2 // пустой кружок
		|		КОГДА ЕСТЬNULL(ВТ_ЗаказыПоставщикам.ЗаказанОборот, 0) > 0
		|			И ЕСТЬNULL(ВТ_ЗаказыПоставщикам.ПолученОборот, 0) < ЕСТЬNULL(ВТ_ЗаказыПоставщикам.ЗаказанОборот, 0)
		|			ТОГДА 1  // частично закрашен
		|		КОГДА (ЕСТЬNULL(ВТ_ЗаказыПоставщикам.ЗаказанОборот, 0) > 0
		|				И ЕСТЬNULL(ВТ_ЗаказыПоставщикам.ПолученОборот, 0) >= ЕСТЬNULL(ВТ_ЗаказыПоставщикам.ЗаказанОборот, 0))		
		|			ИЛИ (ЕСТЬNULL(ВТ_ЗаказыПоставщикам.ЗаказанОборот, 0) = 0
		|				И ЕСТЬNULL(ВТ_ЗаказыПоставщикам.ПолученОборот, 0) > 0)
		|			ТОГДА 0 // полностью закрашен
		|		ИНАЧЕ -1  // пусто
		|	КОНЕЦ КАК СтатусЗаказаРозницыПоставщикам");
		
		ТекстЗапроса = ТекстЗапроса + 
		"
		|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ЗаказыРозницыПоставщикам.Обороты(, , Авто, ЗаказДоговор ССЫЛКА Документ.Монтаж) КАК ВТ_ЗаказыПоставщикам
		|	ПО ДокМонтаж.Ссылка = ВТ_ЗаказыПоставщикам.ЗаказДоговор
		|";
	КонецЕсли;
	
	СписокМонтажи.ТекстЗапроса = ТекстЗапроса;
	
КонецПроцедуры

Процедура ЗагрузитьВТаблицуЗначений(ТаблицаИсточник, ТаблицаПриемник, ОчищатьПриемник = Ложь) Экспорт
	
	Если ОчищатьПриемник Тогда
		ТаблицаПриемник.Очистить();
	КонецЕсли;
	
	// Заполним значения в совпадающих колонках.
	Для Каждого СтрокаТаблицыИсточника Из ТаблицаИсточник Цикл
		
		СтрокаТаблицыПриемника = ТаблицаПриемник.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаТаблицыПриемника, СтрокаТаблицыИсточника);
		
	КонецЦикла;
	
КонецПроцедуры

Функция ВидОперацииПоЭквайрингуПоВидуОперацииЧека(ВидОперацииЧекаККМ) Экспорт
	
	СоответствиеВидовОпераций = Новый Соответствие;
	СоответствиеВидовОпераций.Вставить(Перечисления.ВидыОперацийЧекККМ.Продажа, Перечисления.ВидыОперацийОплатаБанковскойКартой.ОплатаБанковскойКартой);	
	СоответствиеВидовОпераций.Вставить(Перечисления.ВидыОперацийЧекККМ.Возврат, Перечисления.ВидыОперацийОплатаБанковскойКартой.ВозвратОплатыКлиенту);
	Возврат СоответствиеВидовОпераций.Получить(ВидОперацииЧекаККМ);
	
КонецФункции

#Область Выработка

Процедура УстановитьВидимостьГруппыВыработки(Элементы, ОбъектСсылка) Экспорт
	
	ЭтоТехподдержка = ОбщийМодуль.ЭтоПользовательТехПоддержки();
	
	ИмяНастройки = "РазрешенПросмотрВыработкиВДокументе" + ОбъектСсылка.Метаданные().Имя;
	Элементы.ГруппаВыработка.Видимость = НастройкаПользователя(ИмяНастройки) ИЛИ ЭтоТехподдержка; // #14811 ЭтоТехподдержка
	
	//№ 1083 доступность галочки "Ручная корректировка" и ТЧ Выработка
	ИмяНастройки = "РазрешенаРучнаяКорректировкаВыработкиВДокументе" + ОбъектСсылка.Метаданные().Имя;
	Элементы.РучнаяКорректировкаВыработки.Доступность = НастройкаПользователя(ИмяНастройки);
	Элементы.ОбъектВыработка.ТолькоПросмотр = НЕ НастройкаПользователя(ИмяНастройки);
	
КонецПроцедуры

Процедура ОпределитьВидимостьТаблицыВыработкиИРассчитатьИтог(Форма) Экспорт
	
	Объект = Форма.Объект;
	Элементы = Форма.Элементы;
	
	Элементы.ОбъектВыработка.Видимость = Объект.РучнаяКорректировкаВыработки;
	Элементы.ВыработкаПлановая.Видимость = НЕ Объект.РучнаяКорректировкаВыработки И (НЕ Объект.Проведен ИЛИ ОпределитьНеобходимостьВыводаПлановойВыработкиПоДокументу(Объект));
	Элементы.Выработка.Видимость = НЕ Объект.РучнаяКорректировкаВыработки И НЕ Элементы.ВыработкаПлановая.Видимость;
	
	// Именование вкладки в зависимости План / Факт
	ЗаголовокГруппыВыработка = "Выработка - Факт";
	Если Элементы.ВыработкаПлановая.Видимость Тогда
		ЗаголовокГруппыВыработка = "Выработка - План";
	КонецЕсли;
	Элементы.ГруппаВыработка.Заголовок = ЗаголовокГруппыВыработка;
	
	// Расчет плановой выработки
	Если Элементы.ГруппаВыработка.Видимость И Элементы.ВыработкаПлановая.Видимость Тогда
		
		Форма.ВыработкаПлановая.Очистить();
		
		// Дата выработки по определенным документам: по аналогии модуля объекта при проведении
		// Если останется Неопределено, в функции РассчитатьВыработкуПоДокументу будет взята дата из документа, либо текущая дата (смотрит по заполненности)
		ДатаВыработки = Неопределено;
		Если ТипЗнч(Объект.Ссылка) = Тип("ДокументСсылка.ЗаказПокупателя") Тогда
			Если //ПолучитьФункциональнуюОпцию("ИспользоватьСтатусЗакрытВЗаказеПокупателя") 
				Объект.СозданПриИспользованииСтатусаЗакрыт И Объект.ТекущийСтатус = Справочники.СтатусыЗаказовПокупателей.Закрыт Тогда
				ДатаВыработки = Объект.ДатаЗакрытия; //Расчёт по дате закрытия
			КонецЕсли;
			
		ИначеЕсли ТипЗнч(Объект.Ссылка) = Тип("ДокументСсылка.Монтаж") Тогда
			Если //Константы.ИспользоватьСтатусЗакрытВМонтаже.Получить()
				Объект.СозданПриИспользованииСтатусаЗакрыт И Объект.Результат = Справочники.РезультатыМонтажа.Закрыт Тогда
				ДатаВыработки = Объект.ДатаЗакрытия;
			КонецЕсли;
		КонецЕсли;
		
		НаборЗаписейПоВыработке = Зарплата.РассчитатьВыработкуПоДокументу(Объект.Ссылка, ДатаВыработки);
		
		Для Каждого СтрокаВыработки Из НаборЗаписейПоВыработке Цикл
			НоваяСтрока = Форма.ВыработкаПлановая.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаВыработки);
		КонецЦикла;
		
	КонецЕсли;
	
	//#9777
	Если Элементы.ГруппаВыработка.Видимость И НЕ Элементы.ВыработкаПлановая.Видимость Тогда
		Если ТипЗнч(Объект.Ссылка) = Тип("ДокументСсылка.ЗаказПокупателя") Тогда
			Если Объект.РучнаяКорректировкаВыработки Тогда
				Если (Объект.СозданПриИспользованииСтатусаЗакрыт И Объект.ТекущийСтатус = Справочники.СтатусыЗаказовПокупателей.Закрыт)
					ИЛИ (НЕ Объект.СозданПриИспользованииСтатусаЗакрыт И Объект.ТекущийСтатус = Справочники.СтатусыЗаказовПокупателей.Выполнен)				
					Тогда
					//	
				Иначе
					Элементы.ГруппаВыработка.Заголовок = "Выработка - План";
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	// Рассчитаем итог суммы выработки в зависимости от отображаемой таблицы
	СуммаВыработки = 0;
	Если Элементы.ГруппаВыработка.Видимость Тогда
		Если Элементы.ВыработкаПлановая.Видимость Тогда
			СуммаВыработки = Форма.ВыработкаПлановая.Итог("Стоимость");
		ИначеЕсли Элементы.Выработка.Видимость Тогда
			СуммаВыработки = РассчитатьСуммуВыработкиИтого(Объект.Ссылка);
		Иначе
			СуммаВыработки = Объект.Выработка.Итог("Стоимость");
		КонецЕсли;
	КонецЕсли;
	Форма.СуммаВыработки = СуммаВыработки;
	
КонецПроцедуры

Функция РассчитатьСуммуВыработкиИтого(ДокументСсылка)
	
	КВозврату = 0;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ОбъектВыработки", ДокументСсылка);
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЕСТЬNULL(СУММА(Выработка.Стоимость), 0) КАК Сумма
	|ИЗ
	|	РегистрНакопления.ВыработкаИсполнителейПроизводства КАК Выработка
	|ГДЕ
	//++ #16535
	//|	Выработка.ОбъектВыработки = &ОбъектВыработки
	|	Выработка.Регистратор = &ОбъектВыработки
	//-- #16535
	|
	|СГРУППИРОВАТЬ ПО
	|	Выработка.ОбъектВыработки
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ЕСТЬNULL(СУММА(ВыработкаРозницы.Стоимость), 0)
	|ИЗ
	|	РегистрНакопления.ВыработкаИсполнителейРозницы КАК ВыработкаРозницы
	|ГДЕ
	//++ #16535
	//|	ВыработкаРозницы.ОбъектВыработки = &ОбъектВыработки
	|	ВыработкаРозницы.Регистратор = &ОбъектВыработки
	//-- #16535
	|
	|СГРУППИРОВАТЬ ПО
	|	ВыработкаРозницы.ОбъектВыработки";	
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		КВозврату = Выборка.Сумма;
	КонецЕсли;
	
	Возврат КВозврату;
	
КонецФункции

Функция ОпределитьНеобходимостьВыводаПлановойВыработкиПоДокументу(Объект)
	
	КВозврату = Ложь;
	
	Если Объект.Проведен Тогда
		// по монтажу и заказу плановую выработку в проведенном документе показываем в не закрытых статусах (если используется закрыт, тогда в не закрытом, иначе в не выполненном)
		Если ТипЗнч(Объект.Ссылка) = Тип("ДокументСсылка.Монтаж") Тогда
			Если Объект.ВидОперации = Справочники.ВидыМонтажа.Продажа Тогда //#16346
				КВозврату = Ложь;
			Иначе
				ИспользоватьСтатусЗакрытВМонтаже = Объект.СозданПриИспользованииСтатусаЗакрыт;
				Если (ИспользоватьСтатусЗакрытВМонтаже И НЕ Объект.Результат = Справочники.РезультатыМонтажа.Закрыт)
					ИЛИ (НЕ ИспользоватьСтатусЗакрытВМонтаже И НЕ Объект.Результат = Справочники.РезультатыМонтажа.Выполнен)					
					Тогда
					КВозврату = Истина;
				КонецЕсли;
			КонецЕсли;
		ИначеЕсли ТипЗнч(Объект.Ссылка) = Тип("ДокументСсылка.ЗаказПокупателя") Тогда
			ИспользоватьСтатусЗакрытВЗаказе = Объект.СозданПриИспользованииСтатусаЗакрыт;
			Если (ИспользоватьСтатусЗакрытВЗаказе И НЕ Объект.ТекущийСтатус = Справочники.СтатусыЗаказовПокупателей.Закрыт)
				ИЛИ (НЕ ИспользоватьСтатусЗакрытВЗаказе И НЕ Объект.ТекущийСтатус = Справочники.СтатусыЗаказовПокупателей.Выполнен)
				Тогда
				КВозврату = Истина;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Возврат КВозврату;
	
КонецФункции

Функция ВыработкаРасчетнаяИНачисленнаяСовпадают(ДокументСсылка, ДатаРасчетаВыработки) Экспорт
		
	СуммаНачисленная = РассчитатьСуммуВыработкиИтого(ДокументСсылка);

	НаборЗаписейПоВыработке = Зарплата.РассчитатьВыработкуПоДокументу(ДокументСсылка, ДатаРасчетаВыработки);	
	
	СуммаРасчетная = 0;
	Для Каждого СтрокаВыработки Из НаборЗаписейПоВыработке Цикл
		СуммаРасчетная = СуммаРасчетная + СтрокаВыработки.Стоимость;			
	КонецЦикла;
	
	Возврат Новый Структура("Результат, СуммаНачисленная, СуммаРасчетная", (СуммаНачисленная = СуммаРасчетная), СуммаНачисленная, СуммаРасчетная);
	
КонецФункции

#КонецОбласти		
		
#Область ПроцедурыИФункцииОбновленияИнформационнойБазы

Процедура ПереводСправочникаПроизводственныеОперацииВДокумент(ВерсияПрограммы) Экспорт
	
	// Сначала нужно подготовить список организаций, по которым будет установка выработки
	// Попробуем найти существующие с видом расчёта "Выпуск продукции"
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	УстановкаСтоимостиВыработкиПоНоменклатуре.Организация КАК Организация
	|ИЗ
	|	Документ.УстановкаСтоимостиВыработкиПоНоменклатуре КАК УстановкаСтоимостиВыработкиПоНоменклатуре
	|ГДЕ
	|	НЕ УстановкаСтоимостиВыработкиПоНоменклатуре.ПометкаУдаления
	|   И УстановкаСтоимостиВыработкиПоНоменклатуре.ВидДокументаРасчета = Значение(Справочник.ВидыДокументовРасчетаВыработки.ВыпускПродукции)";
	
	СписокОрганизаций = Запрос.Выполнить().Выгрузить();
	
	// Если документов с видом расчета выпуск не нашлось, возьмем все организации
	Если СписокОрганизаций.Количество() = 0 Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Организации.Ссылка КАК Организация
		|ИЗ
		|	Справочник.Организации КАК Организации
		|ГДЕ
		|	НЕ Организации.ПометкаУдаления";
		СписокОрганизаций = Запрос.Выполнить().Выгрузить();
		
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ПроизводственныеОперации.Ссылка
	|ИЗ
	|	Справочник.ПроизводственныеОперации КАК ПроизводственныеОперации
	|ГДЕ
	|	НЕ ПроизводственныеОперации.ПометкаУдаления";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	// На каждую производственную операцию
	Пока Выборка.Следующий() Цикл
		
		// Нужно разделить:
		//	- на потолок:
		//		- однофактурный
		//		- многофактурный
		//		(если цены различаются)
		//  - на отрез
		
		МассивПотолковОдинаковыеЦены = новый Массив;
		МассивПотолковОднофактурныеЦены = новый Массив;
		МассивПотолковМногофактурныеЦены = новый Массив;
		МассивОтрезовЦены = новый Массив;
		
		Для Каждого ТекущаяСтрока Из Выборка.Ссылка.УДАЛИТЬ_СписокНоменклатуры Цикл
			
			// Потолок
			// Смотрим что заполнена одна из цен
			Если НЕ ТекущаяСтрока.СтоимостьВыработкиПотолок = 0 ИЛИ НЕ ТекущаяСтрока.СтоимостьВыработкиМногофактурныйПотолок = 0 Тогда
				
				// Цены одинаковые
				Если ТекущаяСтрока.СтоимостьВыработкиПотолок = ТекущаяСтрока.СтоимостьВыработкиМногофактурныйПотолок Тогда
					НоваяСтрока = новый Структура("ВидНоменклатуры, Номенклатура, ПоВыработке, СтоимостьСуммой"); // на каждую строку переопределяем новую строку
					ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущаяСтрока);
					НоваяСтрока.ПоВыработке = ТекущаяСтрока.КоличествоПоВыработке;
					НоваяСтрока.СтоимостьСуммой = ТекущаяСтрока.СтоимостьВыработкиПотолок;
					МассивПотолковОдинаковыеЦены.Добавить(НоваяСтрока);
				Иначе	
					Если ТекущаяСтрока.СтоимостьВыработкиПотолок > 0 Тогда
						НоваяСтрока = новый Структура("ВидНоменклатуры, Номенклатура, ПоВыработке, СтоимостьСуммой"); // на каждую строку переопределяем новую строку
						ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущаяСтрока);
						НоваяСтрока.ПоВыработке = ТекущаяСтрока.КоличествоПоВыработке;
						НоваяСтрока.СтоимостьСуммой = ТекущаяСтрока.СтоимостьВыработкиПотолок;
						МассивПотолковОднофактурныеЦены.Добавить(НоваяСтрока);
					КонецЕсли;	
					Если ТекущаяСтрока.СтоимостьВыработкиМногофактурныйПотолок > 0 Тогда
						НоваяСтрока = новый Структура("ВидНоменклатуры, Номенклатура, ПоВыработке, СтоимостьСуммой"); // на каждую строку переопределяем новую строку
						ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущаяСтрока);
						НоваяСтрока.ПоВыработке = ТекущаяСтрока.КоличествоПоВыработке;
						НоваяСтрока.СтоимостьСуммой = ТекущаяСтрока.СтоимостьВыработкиМногофактурныйПотолок;
						МассивПотолковМногофактурныеЦены.Добавить(НоваяСтрока);
					КонецЕсли;
				КонецЕсли;	
				
			КонецЕсли;
			
			// Отрез
			// Смотрим что заполнена цена
			Если НЕ ТекущаяСтрока.СтоимостьВыработкиОтрез = 0 Тогда
				
				НоваяСтрока = новый Структура("ВидНоменклатуры, Номенклатура, ПоВыработке, СтоимостьСуммой");
				ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущаяСтрока);
				НоваяСтрока.ПоВыработке = ТекущаяСтрока.КоличествоПоВыработке;
				НоваяСтрока.СтоимостьСуммой = ТекущаяСтрока.СтоимостьВыработкиОтрез;
				
				МассивОтрезовЦены.Добавить(НоваяСтрока);
				
			КонецЕсли;
			
		КонецЦикла;
		
		МассивДокументовКСозданию = новый Массив;
		
		// Если были одинаковые цены на одно и много фактурные потолки
		Если МассивПотолковОдинаковыеЦены.Количество() > 0 Тогда
			// Два случая:
			//	- если все позиции по потолкам были одинаковыми, то по ним будет создан один документ
			//  - если были разные цены, то с массива одинаковых цен, нужно перенести позиции в массивы Однофактурный и Многофактурный, потому что на массив одинаковых цен документа уже не будет
			Если МассивПотолковОднофактурныеЦены.Количество() = 0 И МассивПотолковМногофактурныеЦены.Количество() = 0 Тогда
				МассивДокументовКСозданию.Добавить(новый Структура("ОднофактурныйПотолок, МногофактурныйПотолок, ВидНоменклатурыПотолка, Позиции", Истина, Истина, Справочники.ВидыНоменклатуры.Потолок, МассивПотолковОдинаковыеЦены));
			Иначе
				Для Каждого Позиция Из МассивПотолковОдинаковыеЦены Цикл
					МассивПотолковОднофактурныеЦены.Добавить(Позиция);
					МассивПотолковМногофактурныеЦены.Добавить(Позиция);
				КонецЦикла;
			КонецЕсли;	
		КонецЕсли;
		
		Если МассивПотолковОднофактурныеЦены.Количество() > 0 Тогда
			МассивДокументовКСозданию.Добавить(новый Структура("ОднофактурныйПотолок, ВидНоменклатурыПотолка, Позиции", Истина, Справочники.ВидыНоменклатуры.Потолок, МассивПотолковОднофактурныеЦены));
		КонецЕсли;
		
		Если МассивПотолковМногофактурныеЦены.Количество() > 0 Тогда
			МассивДокументовКСозданию.Добавить(новый Структура("МногофактурныйПотолок, ВидНоменклатурыПотолка, Позиции", Истина, Справочники.ВидыНоменклатуры.Потолок, МассивПотолковМногофактурныеЦены));
		КонецЕсли;
		
		Если МассивОтрезовЦены.Количество() > 0 Тогда
			МассивДокументовКСозданию.Добавить(новый Структура("ВидНоменклатурыПотолка, Позиции", Справочники.ВидыНоменклатуры.Отрез, МассивОтрезовЦены));
		КонецЕсли;
		
		// Создаем документы установки выработки
		// На каждую организацию
		Для Каждого ТекущаяОрганизация Из СписокОрганизаций Цикл
			
			Для Каждого ТекущаяСтрока Из МассивДокументовКСозданию Цикл
				
				ШаблонКомментария = "#Создан при обновлении на 2.0.3.0 по справочнику производственная операция %1 %2 #";
				
				ДокументОбъект = Документы.УстановкаСтоимостиВыработкиПоНоменклатуре.СоздатьДокумент();
				ДокументОбъект.Дата = Дата(2001, 01, 01);
				ЗаполнитьЗначенияСвойств(ДокументОбъект, ТекущаяСтрока);
				ДокументОбъект.ПроизводственнаяОперация = Выборка.Ссылка;
				ДокументОбъект.ВидДокументаРасчета = Справочники.ВидыДокументовРасчетаВыработки.ВыпускПродукции;
				ДокументОбъект.ВидИсполнителя = Справочники.ВидыИсполнителей.СотрудникПроизводства;
				ДокументОбъект.Комментарий = СтрШаблон(ШаблонКомментария, Выборка.Ссылка.Наименование, Выборка.Ссылка.Код);
				ДокументОбъект.Организация = ТекущаяОрганизация.Организация;
				
				Для Каждого СтрокаЦены Из ТекущаяСтрока.Позиции Цикл
					
					// Возможно два варианта, только номенклатура либо только вид номенклатуры
					
					// Это только вид номенклатуры
					Если СтрокаЦены.Номенклатура.Пустая() Тогда
						
						НоваяСтрокаТЧ = ДокументОбъект.ВыработкаПоВидамНоменклатуры.Добавить();
						ЗаполнитьЗначенияСвойств(НоваяСтрокаТЧ, СтрокаЦены);
						
					Иначе // Только номенклатура
						
						НоваяСтрокаТЧ = ДокументОбъект.ВыработкаПоНоменклатуре.Добавить();
						ЗаполнитьЗначенияСвойств(НоваяСтрокаТЧ, СтрокаЦены);
						
					КонецЕсли;
					
				КонецЦикла;	
				
				Попытка
					ДокументОбъект.Записать();
					ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
				Исключение
					ОбновлениеИнформационнойБазыПотолки.ПоместитьВРегистрКОбработке(ВерсияПрограммы, ДокументОбъект.Ссылка, ДокументОбъект.Дата);
				КонецПопытки;
				
			КонецЦикла;
			
		КонецЦикла;	
		
	КонецЦикла;
	
КонецПроцедуры	

//++ №14932
Процедура ОпределитьНастройкиВидовНоменклатурыКакПродукция(УчитыватьНастройкуМатериалов = Ложь) Экспорт
	
	СхемаКД = ПолучитьОбщийМакет("СхемаНастроекПоНоменклатуреКПроизводству");
	
	КомпоновщикНастроек = Новый КомпоновщикНастроекКомпоновкиДанных;
	КомпоновщикНастроек.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(СхемаКД)); 
	
	КомпоновщикНастроек.ЗагрузитьНастройки(СхемаКД.НастройкиПоУмолчанию);
	
	СписокВидовНоменклатуры = новый СписокЗначений;
	СписокВидовНоменклатуры.Добавить(Справочники.ВидыНоменклатуры.Потолок);
	СписокВидовНоменклатуры.Добавить(Справочники.ВидыНоменклатуры.Отрез);
	СписокВидовНоменклатуры.Добавить(Справочники.ВидыНоменклатуры.Продукция);
	
	// при обновлении учитываем настройку по товарам и материалам
	Если УчитыватьНастройкуМатериалов И Константы.УДАЛИТЬ_ЗаказыватьТоварыПриОформленииЗаказаНаПроизводствоНаОснованииЗаказаПокупа.Получить() Тогда
		СписокВидовНоменклатуры.Добавить(Справочники.ВидыНоменклатуры.Материал);
	КонецЕсли;
	
	ИдентификаторПользовательскойНастройки = "";
	Для Каждого ТекущийОтбор Из КомпоновщикНастроек.Настройки.Отбор.Элементы Цикл
		
		Если ТипЗнч(ТекущийОтбор) = Тип("ГруппаЭлементовОтбораКомпоновкиДанных") Тогда
			Продолжить;
		КонецЕсли;
		
		Если ТекущийОтбор.ЛевоеЗначение = новый ПолеКомпоновкиДанных("ВидНоменклатуры") Тогда
			ИдентификаторПользовательскойНастройки = ТекущийОтбор.ИдентификаторПользовательскойНастройки;
		КонецЕсли;
		
	КонецЦикла;
	
	Если ЗначениеЗаполнено(ИдентификаторПользовательскойНастройки) Тогда
		
		ПользовательскийОтбор = КомпоновщикНастроек.ПользовательскиеНастройки.Элементы.Найти(ИдентификаторПользовательскойНастройки);
		
		Если НЕ ПользовательскийОтбор = Неопределено Тогда
			
			ПользовательскийОтбор.Использование 	= Истина;
			ПользовательскийОтбор.ВидСравнения 		= ВидСравненияКомпоновкиДанных.ВСпискеПоИерархии;
			ПользовательскийОтбор.ПравоеЗначение 	= СписокВидовНоменклатуры;
			
			Константы.НастройкиКомпоновкиПоНоменклатуреКПроизводству.Установить(новый ХранилищеЗначения(КомпоновщикНастроек.ПолучитьНастройки()));
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры
