	|	КОНЕЦ КАК ПопозиционныйКонтроль,
	|	ВЫБОР
	|		КОГДА Материалы2_ПоНоменклатуре.Номенклатура ЕСТЬ НЕ NULL
	|			ТОГДА Материалы2_ПоНоменклатуре.КонтролироватьКоличество
	|		КОГДА Материалы2_ПоГруппеНоменклатуры.Номенклатура ЕСТЬ НЕ NULL
	|			ТОГДА Материалы2_ПоГруппеНоменклатуры.КонтролироватьКоличество
	|		КОГДА Материалы2_ПоВидуНоменклатуры.Номенклатура ЕСТЬ НЕ NULL
	|			ТОГДА Материалы2_ПоВидуНоменклатуры.КонтролироватьКоличество
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК КонтролироватьКоличество,
	|	ВЫБОР
	|		КОГДА Материалы2_ПоНоменклатуре.Номенклатура ЕСТЬ НЕ NULL
	|			ТОГДА Материалы2_ПоНоменклатуре.КонтролироватьВыработку
	|		КОГДА Материалы2_ПоГруппеНоменклатуры.Номенклатура ЕСТЬ НЕ NULL
	|			ТОГДА Материалы2_ПоГруппеНоменклатуры.КонтролироватьВыработку
	|		КОГДА Материалы2_ПоВидуНоменклатуры.Номенклатура ЕСТЬ НЕ NULL
	|			ТОГДА Материалы2_ПоВидуНоменклатуры.КонтролироватьВыработку
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК КонтролироватьВыработку,
	|	ЕСТЬNULL(Материалы2.КоличествоКВыработке, 0) КАК КоличествоКВыработке,
	|	ЕСТЬNULL(Материалы2.Количество, 0) КАК Количество
	|ПОМЕСТИТЬ ВТ_Материалы2СНастройками
	|ИЗ
	|	ВТ_Материалы2_Исходная КАК Материалы2	
	|
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Материалы2_ПоНоменклатуре КАК Материалы2_ПоНоменклатуре
	|		ПО Материалы2.Номенклатура = Материалы2_ПоНоменклатуре.Номенклатура
	|
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Материалы2_ПоГруппеНоменклатуры КАК Материалы2_ПоГруппеНоменклатуры
	|		ПО Материалы2.Номенклатура = Материалы2_ПоГруппеНоменклатуры.Номенклатура
	|
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Материалы2_ПоВидуНоменклатуры КАК Материалы2_ПоВидуНоменклатуры
	|		ПО Материалы2.Номенклатура = Материалы2_ПоВидуНоменклатуры.Номенклатура
	|
	|ГДЕ
	|	(Материалы2_ПоНоменклатуре.Номенклатура ЕСТЬ НЕ NULL
	|		ИЛИ Материалы2_ПоВидуНоменклатуры.Номенклатура ЕСТЬ НЕ NULL
	|		ИЛИ Материалы2_ПоГруппеНоменклатуры.Номенклатура ЕСТЬ НЕ NULL)
	|
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	// Материалы ТЧ №2 свернутая с настройками
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Материалы2СНастройками.Номенклатура КАК Номенклатура,
	|	Материалы2СНастройками.ГруппаНоменклатуры КАК ГруппаНоменклатуры,
	|	Материалы2СНастройками.ВидНоменклатуры КАК ВидНоменклатуры,
	|	Материалы2СНастройками.ПопозиционныйКонтроль КАК ПопозиционныйКонтроль,
	|	Материалы2СНастройками.КонтролироватьКоличество КАК КонтролироватьКоличество,
	|	Материалы2СНастройками.КонтролироватьВыработку КАК КонтролироватьВыработку,
	|	СУММА(Материалы2СНастройками.КоличествоКВыработке) КАК КоличествоКВыработке,
	|	СУММА(Материалы2СНастройками.Количество) КАК Количество
	|ПОМЕСТИТЬ ВТ_Материалы2Итоговая
	|ИЗ
	|	ВТ_Материалы2СНастройками КАК Материалы2СНастройками
	|
	|СГРУППИРОВАТЬ ПО
	|	Материалы2СНастройками.Номенклатура,
	|	Материалы2СНастройками.ГруппаНоменклатуры,
	|	Материалы2СНастройками.ВидНоменклатуры,
	|	Материалы2СНастройками.ПопозиционныйКонтроль,
	|	Материалы2СНастройками.КонтролироватьКоличество,
	|	Материалы2СНастройками.КонтролироватьВыработку
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	// Итоговый запрос соединение двух ТЧ Материалы №1 и №2
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЕСТЬNULL(Материалы1.Номенклатура, Материалы2.Номенклатура) КАК Номенклатура,
	|	ЕСТЬNULL(Материалы1.ГруппаНоменклатуры, Материалы2.ГруппаНоменклатуры) КАК ГруппаНоменклатуры,
	|	ЕСТЬNULL(Материалы1.ВидНоменклатуры, Материалы2.ВидНоменклатуры) КАК ВидНоменклатуры,
	|	ЕСТЬNULL(Материалы1.ПопозиционныйКонтроль, Материалы2.ПопозиционныйКонтроль) КАК ПопозиционныйКонтроль,
	|	ЕСТЬNULL(Материалы1.КонтролироватьКоличество, Материалы2.КонтролироватьКоличество) КАК КонтролироватьКоличество,
	|	ЕСТЬNULL(Материалы1.КонтролироватьВыработку, Материалы2.КонтролироватьВыработку) КАК КонтролироватьВыработку,
	|	ЕСТЬNULL(Материалы1.КоличествоКВыработке, 0) КАК КоличествоКВыработке1,
	|	ЕСТЬNULL(Материалы2.КоличествоКВыработке, 0) КАК КоличествоКВыработке2,
	|	ЕСТЬNULL(Материалы1.Количество, 0) КАК Количество1,
	|	ЕСТЬNULL(Материалы2.Количество, 0) КАК Количество2
	|ИЗ
	|	ВТ_Материалы1Итоговая КАК Материалы1
	|
	|		ПОЛНОЕ СОЕДИНЕНИЕ ВТ_Материалы2Итоговая КАК Материалы2
	|		ПО Материалы1.Номенклатура = Материалы2.Номенклатура
	|			И Материалы1.ГруппаНоменклатуры = Материалы2.ГруппаНоменклатуры
	|			И Материалы1.ВидНоменклатуры = Материалы2.ВидНоменклатуры
	|
	|ГДЕ
	|	(
	|	(ЕСТЬNULL(Материалы1.КонтролироватьКоличество, Материалы2.КонтролироватьКоличество) И ЕСТЬNULL(Материалы1.Количество, 0) <> ЕСТЬNULL(Материалы2.Количество, 0))
	|	ИЛИ
	|	(ЕСТЬNULL(Материалы1.КонтролироватьВыработку, Материалы2.КонтролироватьВыработку) И ЕСТЬNULL(Материалы1.КоличествоКВыработке, 0) <> ЕСТЬNULL(Материалы2.КоличествоКВыработке, 0))
	|	)
	|";
	Запрос.УстановитьПараметр("ДокументКонтроля", ДокументКонтроля);
	Запрос.УстановитьПараметр("Материалы1", Материалы1);
	Запрос.УстановитьПараметр("Материалы2", Материалы2);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	НазваниеДокумента1 = "выпуске";
	НазваниеДокумента2 = "заказе на производство";
	
	Если ВидДокументаКонтроля = Перечисления.ВидыДокументовКонтроляМатериаловВПроизводстве.ЗаказНаПроизводство Тогда
		
		НазваниеДокумента1 = "заказе на производство";
		НазваниеДокумента2 = "заказе покупателя";
		
	КонецЕсли;
	
	Если Выборка.Количество() > 0 Тогда
		Сообщить("При выполнении контроля материалов в производстве выявлены различия:" + Символы.ПС);
	КонецЕсли;
	
	Пока Выборка.Следующий() Цикл
		
		Отказ = Истина;
		
		ОписаниеВидНоменклатуры = ?(ЗначениеЗаполнено(Выборка.ВидНоменклатуры), "по виду номенклатуры """
		+ ?(Выборка.ВидНоменклатуры = Справочники.ВидыНоменклатуры.Полотно, ОбщийМодульСервер.ПолучитьПредствлениеВидаНоменклатурыПолотноДляКонтроляМатериалов(), Выборка.ВидНоменклатуры)
		+ """", ""
		);
		ОписаниеГруппаНоменклатуры = ?(ЗначениеЗаполнено(Выборка.ГруппаНоменклатуры), "по группе номенклатуры """ + Выборка.ГруппаНоменклатуры + """", "");
		ОписаниеНоменклатура = ?(ЗначениеЗаполнено(Выборка.Номенклатура), "по номенклатуре """ + Выборка.Номенклатура + """", "");
		
		// Различия по количеству к выработке
		ОписаниеКоличествоКВыработке = "";
		Если Выборка.КонтролироватьВыработку И НЕ Выборка.КоличествоКВыработке1 = Выборка.КоличествоКВыработке2 Тогда
			
			ОписаниеКоличествоКВыработке = СтрШаблон("- в %1 указано количество к выработке %2, в %3 указано количество к выработке %4",
			НазваниеДокумента1,
			Выборка.КоличествоКВыработке1,
			НазваниеДокумента2,
			Выборка.КоличествоКВыработке2);
			
		КонецЕсли;
		
		// Различия по количество * коэффициент
		ОписаниеКоличество = "";
		Если Выборка.КонтролироватьКоличество И НЕ Выборка.Количество1 = Выборка.Количество2 Тогда
			
			ОписаниеКоличество = СтрШаблон("- в %1 указано количество %2, в %3 указано количество %4",
			НазваниеДокумента1,
			Выборка.Количество1,
			НазваниеДокумента2,
			Выборка.Количество2);
			
		КонецЕсли;
		
		ТекстОшибкиСтрока = СтрШаблон("%1%2%3%4%5%6%7%8",
		ОписаниеВидНоменклатуры,
		ОписаниеГруппаНоменклатуры,
		?((ЗначениеЗаполнено(ОписаниеВидНоменклатуры) Или ЗначениеЗаполнено(ОписаниеГруппаНоменклатуры)) И ЗначениеЗаполнено(ОписаниеНоменклатура), ", ", ""),
		ОписаниеНоменклатура,
		":" + Символы.ПС,
		ОписаниеКоличествоКВыработке,
		?(ЗначениеЗаполнено(ОписаниеКоличествоКВыработке), Символы.ПС, ""),
		ОписаниеКоличество
		);
		
		Сообщить(ТекстОшибкиСтрока);
		
	КонецЦикла;
	//-- №14311
	
КонецПроцедуры

Процедура ПривестиВидыНоменклатурыКСоответствиюПроверкиМатериалов(ТаблицаМатериалы) Экспорт
	
	Для Каждого ТекущаяСтрока Из ТаблицаМатериалы Цикл
		
		ВидНоменклатуры = ТекущаяСтрока.Номенклатура.ВидНоменклатуры;
		
		// Полотно, потолок, отрез и остаток пленки сводим к одному виду
		Если ВидНоменклатуры = Справочники.ВидыНоменклатуры.Полотно
			Или ВидНоменклатуры = Справочники.ВидыНоменклатуры.Потолок
			Или ВидНоменклатуры = Справочники.ВидыНоменклатуры.Отрез
			Или ВидНоменклатуры = Справочники.ВидыНоменклатуры.ОстатокПленки
			Тогда
			ВидНоменклатуры = Справочники.ВидыНоменклатуры.Полотно;
		КонецЕсли;
		
		ТекущаяСтрока.ВидНоменклатуры = ВидНоменклатуры;
		
	КонецЦикла;
	
КонецПроцедуры

