Функция СтруктураРесурсовДляИтогов()
	
	Структура = Новый Структура;
	
	Структура.Вставить("СуммаБезНДС",       0);
	Структура.Вставить("СуммаНДС",          0);
	Структура.Вставить("СуммаСНДС",         0);
	Структура.Вставить("Количество",        0);
	
	Структура.Вставить("Сумма",             0);
	
	Структура.Вставить("РазницаБезНДСУвеличение", 0);
	Структура.Вставить("РазницаБезНДСУменьшение", 0);
	Структура.Вставить("РазницаНДСУвеличение",    0);
	Структура.Вставить("РазницаНДСУменьшение",    0);
	Структура.Вставить("РазницаСНДСУвеличение",   0);
	Структура.Вставить("РазницаСНДСУменьшение",   0);
	
	Возврат Структура;
	
КонецФункции

Функция СтруктураИтоговыеСуммы()
	
	Структура = Новый Структура;
	
	СтруктураРесурсовДляИтогов = СтруктураРесурсовДляИтогов();
	
	Для Каждого Элемент Из СтруктураРесурсовДляИтогов Цикл
		Структура.Вставить("Итого"+Элемент.Ключ+"НаСтранице", 0);
		Структура.Вставить("Итого"+Элемент.Ключ, 0);
	КонецЦикла;
	
	Возврат Структура;
	
КонецФункции

Процедура ОбнулитьИтогиПоСтранице(ИтоговыеСуммы)
	
	СтруктураРесурсовДляИтогов = СтруктураРесурсовДляИтогов();
	
	Для Каждого Элемент Из СтруктураРесурсовДляИтогов Цикл
		ИтоговыеСуммы.Вставить("Итого"+Элемент.Ключ+"НаСтранице", 0);
	КонецЦикла;
	
КонецПроцедуры

Процедура РассчитатьИтоговыеСуммы(ИтоговыеСуммы, СтрокаТовары)
	
	СтруктураСуммПоСтроке = СтруктураРесурсовДляИтогов();
	
	ЗаполнитьЗначенияСвойств(СтруктураСуммПоСтроке, СтрокаТовары);
	Для Каждого Элемент Из СтруктураСуммПоСтроке Цикл
		Если ЗначениеЗаполнено(Элемент.Значение) Тогда
			ИтоговыеСуммы["Итого"+Элемент.Ключ+"НаСтранице"] = ИтоговыеСуммы["Итого"+Элемент.Ключ+"НаСтранице"] + Элемент.Значение;
			ИтоговыеСуммы["Итого"+Элемент.Ключ] = ИтоговыеСуммы["Итого"+Элемент.Ключ] + Элемент.Значение;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ДобавитьИтоговыеДанныеПодвала(ИтоговыеСуммы, ВсегоНомеров, Валюта)
	
	ИтоговыеСуммы.Вставить("КоличествоПорядковыхНомеровЗаписейПрописью", ЧислоПрописью(ВсегоНомеров, ,",,,,,,,,0"));
	ИтоговыеСуммы.Вставить("СуммаПрописью", РаботаСВалютой.СформироватьЧислоПрописью(ИтоговыеСуммы.ИтогоСуммаСНДС, Валюта, Ложь));
	
КонецПроцедуры

Функция ПолучитьТаблицуВыработкиПоМонтажуДляПФ(МонтажСсылка) Экспорт
	
	РеквизитыМонтажа = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(МонтажСсылка, "Дата, Проведен, Результат, РучнаяКорректировкаВыработки, 
	|СозданПриИспользованииСтатусаЗакрыт, ДатаВыполнения, ДатаЗакрытия");
	
	РезультатМонтажа = РеквизитыМонтажа.Результат;
	МонтажЗакрыт = (РезультатМонтажа = Справочники.РезультатыМонтажа.Выполнен И НЕ РеквизитыМонтажа.СозданПриИспользованииСтатусаЗакрыт)
	ИЛИ (РезультатМонтажа = Справочники.РезультатыМонтажа.Закрыт И РеквизитыМонтажа.СозданПриИспользованииСтатусаЗакрыт);
	
	Плановая = Ложь;
	// Если введена ручная корректировка выработки - берем её
	Если РеквизитыМонтажа.РучнаяКорректировкаВыработки Тогда
		
		ТаблицаВыработки = МонтажСсылка.Выработка.Выгрузить();
		
		// Если монтаж проведен и закрыт - берем из движений документа
	ИначеЕсли МонтажЗакрыт И РеквизитыМонтажа.Проведен Тогда
		
		ЗапросВыработка = новый Запрос;
		ЗапросВыработка.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВыработкаИсполнителейРозницыОбороты.Сотрудник КАК Сотрудник,
		|	ВыработкаИсполнителейРозницыОбороты.ВидНачисления КАК ВидНачисления,
		|	ВыработкаИсполнителейРозницыОбороты.Номенклатура КАК Номенклатура,
		|   ВыработкаИсполнителейРозницыОбороты.КоличествоОборот КАК Количество,
		|	ВыработкаИсполнителейРозницыОбороты.СтоимостьОборот КАК Стоимость
		|ИЗ
		|	РегистрНакопления.ВыработкаИсполнителейРозницы.Обороты(,, Регистратор) КАК ВыработкаИсполнителейРозницыОбороты
		|ГДЕ
		|	ВыработкаИсполнителейРозницыОбороты.Регистратор = &Ссылка
		|";
		ЗапросВыработка.УстановитьПараметр("Ссылка", МонтажСсылка);
		
		ТаблицаВыработки = ЗапросВыработка.Выполнить().Выгрузить();
		
		
	Иначе
		// Рассчитываем плановую выработку	
		ДатаРасчетаВыработки = РеквизитыМонтажа.Дата;
		
		Если МонтажЗакрыт Тогда
			
			ДатаРасчетаВыработки = РеквизитыМонтажа.ДатаВыполнения;
			Если (РезультатМонтажа = Справочники.РезультатыМонтажа.Закрыт И РеквизитыМонтажа.СозданПриИспользованииСтатусаЗакрыт) Тогда
				ДатаРасчетаВыработки = РеквизитыМонтажа.ДатаЗакрытия;
			КонецЕсли;
			
		КонецЕсли;
		
		ТаблицаВыработки = Зарплата.РассчитатьВыработкуПоДокументу(МонтажСсылка, ДатаРасчетаВыработки);
		Плановая = Истина;
		
	КонецЕсли;
	
	Возврат Новый Структура("ТаблицаВыработки, Плановая", ТаблицаВыработки, Плановая);
	
КонецФункции

Функция ПечатьРозницаГарантийныйТалон(МассивОбъектов, ОбъектыПечати) Экспорт
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.АвтоМасштаб         = Истина; //#14053
	ТабличныйДокумент.ИмяПараметровПечати = "ПараметрыПечати_ГарантийныйТалон";
	Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.Монтаж.ПФ_MXL_ГарантийныйТалон");
	
	МенеджерОбъекта = ОбщегоНазначения.МенеджерОбъектаПоСсылке(МассивОбъектов[0]);
	
	СтруктураДанныхДляПечати = МенеджерОбъекта.ПолучитьДанныеДляПечатныхФорм(МассивОбъектов);
	ТаблицаДанныеПечати      = СтруктураДанныхДляПечати.РезультатПоШапке.Выгрузить();
	МенеджерОбъекта.ДополнитьДанныеДляПечатныхФорм(ТаблицаДанныеПечати);
	//ВыборкаПоДокументам 	 = СтруктураДанныхДляПечати.РезультатПоТабличнойЧасти.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	ПервыйДокумент = Истина;
	Для каждого ДанныеПечати из ТаблицаДанныеПечати Цикл		
		Если Не ПервыйДокумент Тогда
			// Все документы нужно выводить на разных страницах.
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		ПервыйДокумент = Ложь;
		// Запомним номер строки, с которой начали выводить текущий документ.
		НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы + 1;
		
		ОбластьМакета = Макет.ПолучитьОбласть("Шапка");		
		ЗаполнитьЗначенияСвойств(ОбластьМакета.Параметры, ДанныеПечати);
		ТабличныйДокумент.Вывести(ОбластьМакета);
		
		// В табличном документе необходимо задать имя области, в которую был 
		// выведен объект. Нужно для возможности печати комплектов документов.
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабличныйДокумент, НомерСтрокиНачало, ОбъектыПечати, ДанныеПечати.Ссылка);
		
	КонецЦикла;
	
	Возврат ТабличныйДокумент;
	
КонецФункции

Функция ПечатьРозницаАктВыполненныхРабот(МассивОбъектов, ОбъектыПечати, ПересчетЦеныПоСкидке = Ложь, СБланкомОПлаты = Ложь) Экспорт
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.АвтоМасштаб         = Истина; //#14053
	ТабличныйДокумент.ИмяПараметровПечати = "ПараметрыПечати_АктВыполненныхРабот";
	Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.Монтаж.ПФ_MXL_АктВыполненныхРабот");
	ВыводитьАртикул = Константы.ВыводитьАртикулНоменклатурыВПечатныхФормах.Получить();
	
	МенеджерОбъекта = ОбщегоНазначения.МенеджерОбъектаПоСсылке(МассивОбъектов[0]);
	
	ИмяОбъекта = МассивОбъектов[0].Метаданные().Имя;
	ИмяОбластиПодвал = "Подвал";
	Если НЕ Макет.Области.Найти(ИмяОбластиПодвал + ИмяОбъекта) = Неопределено Тогда
		ИмяОбластиПодвал = ИмяОбластиПодвал + ИмяОбъекта;
	КонецЕсли;
	
	СтруктураДанныхДляПечати = МенеджерОбъекта.ПолучитьДанныеДляПечатныхФорм(МассивОбъектов);
	ТаблицаДанныеПечати      = СтруктураДанныхДляПечати.РезультатПоШапке.Выгрузить();	
	ВыборкаПоТоварам 	 = СтруктураДанныхДляПечати.РезультатПоТабличнойЧасти.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	МенеджерОбъекта.ДополнитьДанныеДляПечатныхФорм(ТаблицаДанныеПечати, ВыборкаПоТоварам);
	
	ПервыйДокумент = Истина;
	Для каждого ДанныеПечати из ТаблицаДанныеПечати Цикл
		Если Не ПервыйДокумент Тогда
			// Все документы нужно выводить на разных страницах.
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		ПервыйДокумент = Ложь;
		// Запомним номер строки, с которой начали выводить текущий документ.
		НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы + 1;		
		
		ЕстьСкидкиВДокументе = ДанныеПечати.ИтогоСуммаСкидки > 0;
		ЕстьСкидки = ЕстьСкидкиВДокументе И НЕ ПересчетЦеныПоСкидке;
		ЕстьНДС    = ДанныеПечати.ЯвляетсяПлательщикомНДС;
		
		СуффиксОбластиСтроки = ?(ЕстьНДС, "СНДС", "") + ?(ЕстьСкидки, "СоСкидкой", "");
		СуффиксОбластиКолонки = ?(ЕстьСкидки И ЕстьНДС, "СоСкидкойСНДС", ?(ЕстьСкидки Или ЕстьНДС, "СоСкидкойИлиСНДС", ""));
		
		//шапка
		СтруктураДанныхШапки = Новый Структура;
		СведенияОбОрганизации = ОбщийМодульСервер.СведенияОбОрганизации(ДанныеПечати.Организация);
		СведенияОКонтрагенте  = ОбщийМодульСервер.СведенияОКонтрагенте(ДанныеПечати.Контрагент);
		
		ПредставлениеОрганизации = ОбщийМодульСервер.ОписаниеОрганизации(СведенияОбОрганизации, "ПолноеНаименование,ЮридическийАдрес,Телефоны");
		ПредставлениеЗаказчика	 = ОбщийМодульСервер.ОписаниеОрганизации(СведенияОКонтрагенте,	"ПолноеНаименование");
		ПредставлениеЗаказчика  = ПредставлениеЗаказчика + ?(ПустаяСтрока(ДанныеПечати.ПредставлениеРеквизитов), "", ", " + ДанныеПечати.ПредставлениеРеквизитов);
		СтруктураДанныхШапки.Вставить("ПредставлениеОрганизации", ПредставлениеОрганизации);
		СтруктураДанныхШапки.Вставить("ПредставлениеЗаказчика",  ПредставлениеЗаказчика);
		
		ОбластьМакета = Макет.ПолучитьОбласть("Шапка");
		ОбластьМакета.Параметры.Заполнить(ДанныеПечати);
		ОбластьМакета.Параметры.Заполнить(СтруктураДанныхШапки);
		
		//если номер договора заполнен подставим его
		Если ЗначениеЗаполнено(ДанныеПечати.НомерДоговора) Тогда
			Попытка
				ОбластьМакета.Параметры.Номер = ДанныеПечати.НомерДоговора;
			Исключение
			КонецПопытки;
		КонецЕсли;
		ТабличныйДокумент.Вывести(ОбластьМакета);
		
		
		// Изменения размера колонки, в зависимости от вывода Артикула
		Если Не ВыводитьАртикул Тогда
			Попытка
				Макет.Область("ПерваяКолонкаТовара").ШиринаКолонки = Макет.Область("ПерваяКолонкаТовара").ШиринаКолонки + Макет.Область("КолонкаАртикул").ШиринаКолонки;
			Исключение
			КонецПопытки;
		КонецЕсли;
		
		Попытка
			ОбластьНомера  = Макет.ПолучитьОбласть("ШапкаТаблицы" + СуффиксОбластиСтроки + "|НомерСтроки");
			ОбластьАртикул = Макет.ПолучитьОбласть("ШапкаТаблицы" + СуффиксОбластиСтроки + "|КолонкаАртикул");
			ОбластьТовар   = Макет.ПолучитьОбласть("ШапкаТаблицы" + СуффиксОбластиСтроки + "|Товар" + СуффиксОбластиКолонки);
			ОбластьДанных  = Макет.ПолучитьОбласть("ШапкаТаблицы" + СуффиксОбластиСтроки + "|Данные" + СуффиксОбластиКолонки);
			
			ОбластьНомераСтроки = Макет.ПолучитьОбласть("СтрокаТаблицы" + СуффиксОбластиСтроки + "|НомерСтроки");
			ОбластьАртикулСтроки= Макет.ПолучитьОбласть("СтрокаТаблицы" + СуффиксОбластиСтроки + "|КолонкаАртикул");
			ОбластьТоварСтроки  = Макет.ПолучитьОбласть("СтрокаТаблицы" + СуффиксОбластиСтроки + "|Товар" + СуффиксОбластиКолонки);
			ОбластьДанныхСтроки = Макет.ПолучитьОбласть("СтрокаТаблицы" + СуффиксОбластиСтроки + "|Данные" + СуффиксОбластиКолонки);
			
			ОбластьНомераКомната = Макет.ПолучитьОбласть("СтрокаТаблицы" + СуффиксОбластиСтроки + "|НомерСтроки");
			ОбластьАртикулКомната= Макет.ПолучитьОбласть("СтрокаТаблицы" + СуффиксОбластиСтроки + "|КолонкаАртикул");
			ОбластьТоварКомната  = Макет.ПолучитьОбласть("СтрокаТаблицы" + СуффиксОбластиСтроки + "|Товар" + СуффиксОбластиКолонки);
			ОбластьДанныхКомната = Макет.ПолучитьОбласть("СтрокаТаблицы" + СуффиксОбластиСтроки + "|Данные" + СуффиксОбластиКолонки);
			
		Исключение
			Возврат новый ТабличныйДокумент;
		КонецПопытки;
		
		//шапка таблицы
		ОбластьНомера.Параметры.Заполнить(ДанныеПечати);
		ТабличныйДокумент.Вывести(ОбластьНомера);
		
		Если ВыводитьАртикул Тогда
			ОбластьАртикул.Параметры.Заполнить(ДанныеПечати);
			ТабличныйДокумент.Присоединить(ОбластьАртикул);
		КонецЕсли;
		
		ОбластьТовар.Параметры.Заполнить(ДанныеПечати);
		ТабличныйДокумент.Присоединить(ОбластьТовар);
		
		ОбластьДанных.Параметры.Заполнить(ДанныеПечати);
		ТабличныйДокумент.Присоединить(ОбластьДанных);	
		
		СтруктураПоиска = Новый Структура("Ссылка", ДанныеПечати.Ссылка);
		ВыборкаПоТоварам.Сбросить();
		
		Если ВыборкаПоТоварам.НайтиСледующий(СтруктураПоиска) Тогда
			
			ИмяКомната = "";
			//выводим секцию с табличной частью
			ВыборкаТоваровУслуг = ВыборкаПоТоварам.Выбрать();
			Пока ВыборкаТоваровУслуг.Следующий() Цикл			                                         	
				
				Если ИмяКомната <> ВыборкаТоваровУслуг.Комната Тогда
					
					ТабличныйДокумент.Вывести(ОбластьНомераКомната);
					
					Если ВыводитьАртикул Тогда
						ТабличныйДокумент.Присоединить(ОбластьАртикулКомната);
					КонецЕсли;						
					
					ИмяКомната = ВыборкаТоваровУслуг.Комната;
					ОбластьТоварКомната.Область().Шрифт = Новый Шрифт (ОбластьМакета.Область().Шрифт,,,Истина,Истина);  // жирный наклонный шрифт						
					ОбластьТоварКомната.Параметры.ПредставлениеНоменклатуры = ИмяКомната;
					ТабличныйДокумент.Присоединить(ОбластьТоварКомната);						
					
					ТабличныйДокумент.Присоединить(ОбластьДанныхКомната);
					
				КонецЕсли;
				
				//товары в комнате
				ОбластьНомераСтроки.Параметры.Заполнить(ВыборкаТоваровУслуг);
				ТабличныйДокумент.Вывести(ОбластьНомераСтроки);
				
				Если ВыводитьАртикул Тогда
					ОбластьАртикулСтроки.Параметры.Заполнить(ВыборкаТоваровУслуг);
					ТабличныйДокумент.Присоединить(ОбластьАртикулСтроки);
				КонецЕсли;
				
				ДопДанныеСтроки = Новый Структура;
				//++ №12909
				//ДопДанныеСтроки.Вставить("ПредставлениеНоменклатуры", 
				//						ОбщийМодульСервер.ПредставлениеНоменклатурыДляПечати(Строка(ВыборкаТоваровУслуг.Номенклатура), Строка(ВыборкаТоваровУслуг.ХарактеристикаНоменклатуры)));
				ДопДанныеСтроки.Вставить("ПредставлениеНоменклатуры", 
				ОбщийМодульСервер.ПредставлениеНоменклатурыДляПечати(ВыборкаТоваровУслуг.Номенклатура, ВыборкаТоваровУслуг.ХарактеристикаНоменклатуры));
				//-- №12909
				
				ОбластьТоварСтроки.Параметры.Заполнить(ВыборкаТоваровУслуг);
				ОбластьТоварСтроки.Параметры.Заполнить(ДопДанныеСтроки);
				ТабличныйДокумент.Присоединить(ОбластьТоварСтроки);
				
				ОбластьДанныхСтроки.Параметры.Заполнить(ВыборкаТоваровУслуг);
				//#10947
				Если ЕстьСкидкиВДокументе И ПересчетЦеныПоСкидке Тогда
					ДопДанныеСтроки = Новый Структура;
					ДопДанныеСтроки.Вставить("Цена", ?(ВыборкаТоваровУслуг.Количество = 0, 0, ВыборкаТоваровУслуг.Сумма / ВыборкаТоваровУслуг.Количество));
					ОбластьДанныхСтроки.Параметры.Заполнить(ДопДанныеСтроки);
				КонецЕсли;
				ТабличныйДокумент.Присоединить(ОбластьДанныхСтроки);
				
			КонецЦикла;
		КонецЕсли;
		
		// подвал таблицы 
		ОбластьНомера  = Макет.ПолучитьОбласть("ПодвалТаблицы" + СуффиксОбластиСтроки + "|НомерСтроки");
		ОбластьАртикул = Макет.ПолучитьОбласть("ПодвалТаблицы" + СуффиксОбластиСтроки + "|КолонкаАртикул");
		ОбластьТовар   = Макет.ПолучитьОбласть("ПодвалТаблицы" + СуффиксОбластиСтроки + "|Товар" + СуффиксОбластиКолонки);
		ОбластьДанных  = Макет.ПолучитьОбласть("ПодвалТаблицы" + СуффиксОбластиСтроки + "|Данные" + СуффиксОбластиКолонки);
		
		ТабличныйДокумент.Вывести(ОбластьНомера);
		
		Если ВыводитьАртикул Тогда
			ТабличныйДокумент.Присоединить(ОбластьАртикул);
		КонецЕсли;
		
		ТабличныйДокумент.Присоединить(ОбластьТовар);
		
		ОбластьДанных.Параметры.Заполнить(ДанныеПечати);
		ТабличныйДокумент.Присоединить(ОбластьДанных);
		
		// Выводим ИтогоНДС
		Попытка
			ЦенаВключаетНДС = Истина;
			Область = Макет.ПолучитьОбласть("ПодвалНДС");
			СтруктураДанныхПодвалНДС = Новый Структура;
			СтруктураДанныхПодвалНДС.Вставить("ИтогоСуммаНДС", ДанныеПечати.ИтогоСуммаНДС);
			Если ЕстьНДС Тогда
				СтруктураДанныхПодвалНДС.Вставить("НДС", ?(ЦенаВключаетНДС, НСтр("ru='В том числе НДС:'"), НСтр("ru='Сумма НДС:'")));
			Иначе
				СтруктураДанныхПодвалНДС.Вставить("НДС", НСтр("ru='Без налога (НДС)'"));
			КонецЕсли;
			Область.Параметры.Заполнить(СтруктураДанныхПодвалНДС);
			ТабличныйДокумент.Присоединить(Область);
		Исключение
		КонецПопытки;
		
		// Выводим подвал с подписями			
		Попытка 
			ОбластьМакета = Макет.ПолучитьОбласть(ИмяОбластиПодвал);
			ОбластьМакета.Параметры.Заполнить(ДанныеПечати);
			ТабличныйДокумент.Вывести(ОбластьМакета);
		Исключение
		КонецПопытки;
		
		//#14460
		Если СБланкомОПлаты Тогда
			Попытка
				ДанныеОплаты = Новый Структура;				
				ДанныеОплаты.Вставить("ПредставлениеОрганизации", ДанныеПечати.Организация);
				ДанныеОплаты.Вставить("ПредставлениеСтруктурногоПодразделения", ДанныеПечати.Подразделение);
				ДанныеОплаты.Вставить("ПринятоОт", ДанныеПечати.Контрагент);
				ДанныеОплаты.Вставить("Основание", ДанныеПечати.Ссылка);
				//СуммаКОплате = ?(ДанныеПечати.СуммаКПолучениюНаМонтаже = 0, ДанныеПечати.Сумма, ДанныеПечати.СуммаКПолучениюНаМонтаже);
				СуммаКОплате = ДанныеПечати.СуммаКПолучениюНаМонтаже;
				Если СуммаКОплате > 0 Тогда
					ДанныеОплаты.Вставить("СуммаРубКоп", СуммаКОплате);
					ДанныеОплаты.Вставить("Сумма", СуммаКОплате);
					ДанныеОплаты.Вставить("СуммаПрописью", РаботаСВалютой.СформироватьЧислоПрописью(СуммаКОплате, ДанныеПечати.Валюта, Ложь));				
				КонецЕсли;
				
				МакетОплаты = Документы.ПриходныйКассовыйОрдер.ПолучитьМакет("ПКО");
				
				ТДОплаты = Новый ТабличныйДокумент;
				ОбластьМакета = МакетОплаты.ПолучитьОбласть("Шапка");
				ОбластьМакета.Параметры.Заполнить(ДанныеОплаты);
				ОбластьВывода = ТДОплаты.Вывести(ОбластьМакета);
				ОбластьВывода.СоздатьФорматСтрок();
				
				ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
				ТабличныйДокумент.Вывести(ТДОплаты);
			Исключение
			КонецПопытки;
		КонецЕсли;
		
		// В табличном документе необходимо задать имя области, в которую был 
		// выведен объект. Нужно для возможности печати комплектов документов.
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабличныйДокумент, НомерСтрокиНачало, ОбъектыПечати, ДанныеПечати.Ссылка);
	КонецЦикла;
	Возврат ТабличныйДокумент;
	
КонецФункции

Функция ПечатьРозницаКомплектДляМонтажников(МассивОбъектов, ОбъектыПечати, ПересчетЦеныПоСкидке = Ложь) Экспорт
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.АвтоМасштаб         = Истина; //#14053
	ТабличныйДокумент.ИмяПараметровПечати = "ПараметрыПечати_КомплектДляМонтажников";
	Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.Монтаж.ПФ_MXL_КомплектДляМонтажниковСоСкидкой");
	ВыводитьАртикул = Константы.ВыводитьАртикулНоменклатурыВПечатныхФормах.Получить();
	
	МенеджерОбъекта = ОбщегоНазначения.МенеджерОбъектаПоСсылке(МассивОбъектов[0]);
	
	СтруктураДанныхДляПечати = МенеджерОбъекта.ПолучитьДанныеДляПечатныхФорм(МассивОбъектов);
	ТаблицаДанныеПечати      = СтруктураДанныхДляПечати.РезультатПоШапке.Выгрузить();
	МенеджерОбъекта.ДополнитьДанныеДляПечатныхФорм(ТаблицаДанныеПечати);
	ВыборкаПоТоварам 	 = СтруктураДанныхДляПечати.РезультатПоТабличнойЧасти.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	//ТаблицаПоТоварам 	 = СтруктураДанныхДляПечати.РезультатПоТабличнойЧасти.Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	ТаблицаКомнат = СтруктураДанныхДляПечати.РезультатПоТабличнойЧасти.Выгрузить();
	ТаблицаКомнат.Свернуть("Ссылка, Комната", "Сумма");
	
	ПервыйДокумент = Истина;
	Для каждого ДанныеПечати из ТаблицаДанныеПечати Цикл
		Если Не ПервыйДокумент Тогда
			// Все документы нужно выводить на разных страницах.
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		ПервыйДокумент = Ложь;
		// Запомним номер строки, с которой начали выводить текущий документ.
		НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы + 1;
		
		ЕстьСкидкиВДокументе = ДанныеПечати.ИтогоСуммаСкидки > 0;
		ЕстьСкидки = ЕстьСкидкиВДокументе И НЕ ПересчетЦеныПоСкидке;
		ЕстьНДС    = ДанныеПечати.ЯвляетсяПлательщикомНДС;
		
		СуффиксОбластиСтроки = ?(ЕстьНДС, "СНДС", "") + ?(ЕстьСкидки, "СоСкидкой", "");
		СуффиксОбластиКолонки = ?(ЕстьСкидки И ЕстьНДС, "СоСкидкойСНДС", ?(ЕстьСкидки Или ЕстьНДС, "СоСкидкойИлиСНДС", ""));
		
		СтруктураДанныхШапки = Новый Структура;
		СведенияОбОрганизации = ОбщийМодульСервер.СведенияОбОрганизации(ДанныеПечати.Организация);
		СведенияОКонтрагенте  = ОбщийМодульСервер.СведенияОКонтрагенте(ДанныеПечати.Контрагент);
		
		ПредставлениеОрганизации = ОбщийМодульСервер.ОписаниеОрганизации(СведенияОбОрганизации, "ПолноеНаименование,ЮридическийАдрес,Телефоны");
		ПредставлениеКонтрагента	 = ОбщийМодульСервер.ОписаниеОрганизации(СведенияОКонтрагенте,	"ПолноеНаименование");
		ПредставлениеКонтрагента  = ПредставлениеКонтрагента + ?(ПустаяСтрока(ДанныеПечати.ПредставлениеРеквизитов), "", ", " + ДанныеПечати.ПредставлениеРеквизитов);
		СтруктураДанныхШапки.Вставить("ПредставлениеОрганизации", ПредставлениеОрганизации);
		СтруктураДанныхШапки.Вставить("ПредставлениеКонтрагента",  ПредставлениеКонтрагента);
		
		//шапка 
		Попытка
			ОбластьМакета = Макет.ПолучитьОбласть("Шапка");
			ОбластьМакета.Параметры.Заполнить(ДанныеПечати);
			ОбластьМакета.Параметры.Заполнить(СтруктураДанныхШапки);
			ТабличныйДокумент.Вывести(ОбластьМакета);
		Исключение
		КонецПопытки;
		
		//заголовок			
		Попытка
			ОбластьМакета = Макет.ПолучитьОбласть("Заголовок");
			ОбластьМакета.Параметры.Заполнить(ДанныеПечати);
			Попытка			
				ТекстЗаголовка = ДанныеПечати.Ссылка.Метаданные().Синоним + " №" + ПрефиксацияОбъектовКлиентСервер.НомерНаПечать(ДанныеПечати.Номер) + " от " + ДанныеПечати.ДатаФормат;
				ОбластьМакета.Параметры.ТекстЗаголовка = ТекстЗаголовка;
			Исключение
			КонецПопытки;
			ТабличныйДокумент.Вывести(ОбластьМакета);
		Исключение
		КонецПопытки;		
		
		Попытка
			ОбластьМакета = Макет.ПолучитьОбласть("Организация");
			ОбластьМакета.Параметры.Заполнить(ДанныеПечати);
			ОбластьМакета.Параметры.Заполнить(СтруктураДанныхШапки);
			ТабличныйДокумент.Вывести(ОбластьМакета);
		Исключение
		КонецПопытки;
		
		//Дата монтажа
		Если ТипЗнч(ДанныеПечати.Ссылка) = Тип("ДокументСсылка.Монтаж") Тогда
			Если НЕ ДанныеПечати.СрокМонтажа = ПредопределенноеЗначение("Перечисление.СрокиМонтажа.ДатаМонтажаНеОпределена") Тогда
				Попытка			
					ОбластьМакета = Макет.ПолучитьОбласть("ДатаМонтажа");					
					ДатаМонтажа = ДанныеПечати.ДатаМонтажаФормат + " с " + ДанныеПечати.ВремяНачалаФормат + " по " + ДанныеПечати.ВремяОкончанияФормат;					
					ОбластьМакета.Параметры.ДатаМонтажа = ДатаМонтажа;
					ТабличныйДокумент.Вывести(ОбластьМакета);
				Исключение
				КонецПопытки;
			КонецЕсли;	
		КонецЕсли;
		
		Попытка
			ОбластьМакета = Макет.ПолучитьОбласть("Покупатель");
			ОбластьМакета.Параметры.Заполнить(ДанныеПечати);
			ОбластьМакета.Параметры.Заполнить(СтруктураДанныхШапки);
			ТабличныйДокумент.Вывести(ОбластьМакета);
		Исключение
		КонецПопытки;
		
		// Изменения размера колонки, в зависимости от вывода Артикула
		Если Не ВыводитьАртикул Тогда
			Попытка
				Макет.Область("ПерваяКолонкаТовара").ШиринаКолонки = Макет.Область("ПерваяКолонкаТовара").ШиринаКолонки + Макет.Область("КолонкаАртикул").ШиринаКолонки;
			Исключение
			КонецПопытки;
		КонецЕсли;
		
		Попытка
			ОбластьНомера  = Макет.ПолучитьОбласть("ШапкаТаблицы" + СуффиксОбластиСтроки + "|НомерСтроки");
			ОбластьАртикул = Макет.ПолучитьОбласть("ШапкаТаблицы" + СуффиксОбластиСтроки + "|КолонкаАртикул");
			ОбластьТовар   = Макет.ПолучитьОбласть("ШапкаТаблицы" + СуффиксОбластиСтроки + "|Товар" + СуффиксОбластиКолонки);
			ОбластьДанных  = Макет.ПолучитьОбласть("ШапкаТаблицы" + СуффиксОбластиСтроки + "|Данные" + СуффиксОбластиКолонки);
			
			ОбластьНомераСтроки = Макет.ПолучитьОбласть("СтрокаТаблицы" + СуффиксОбластиСтроки + "|НомерСтроки");
			ОбластьАртикулСтроки= Макет.ПолучитьОбласть("СтрокаТаблицы" + СуффиксОбластиСтроки + "|КолонкаАртикул");
			ОбластьТоварСтроки  = Макет.ПолучитьОбласть("СтрокаТаблицы" + СуффиксОбластиСтроки + "|Товар" + СуффиксОбластиКолонки);
			ОбластьДанныхСтроки = Макет.ПолучитьОбласть("СтрокаТаблицы" + СуффиксОбластиСтроки + "|Данные" + СуффиксОбластиКолонки);
			
			ОбластьНомераКомната = Макет.ПолучитьОбласть("СтрокаКомнаты" + СуффиксОбластиСтроки + "|НомерСтроки");
			ОбластьАртикулКомната= Макет.ПолучитьОбласть("СтрокаКомнаты" + СуффиксОбластиСтроки + "|КолонкаАртикул");
			ОбластьТоварКомната  = Макет.ПолучитьОбласть("СтрокаКомнаты" + СуффиксОбластиСтроки + "|Товар" + СуффиксОбластиКолонки);
			ОбластьДанныхКомната = Макет.ПолучитьОбласть("СтрокаКомнаты" + СуффиксОбластиСтроки + "|Данные" + СуффиксОбластиКолонки);
			
		Исключение
			Возврат Новый ТабличныйДокумент;
		КонецПопытки;	
		
		Попытка
			//шапка таблицы
			ОбластьНомера.Параметры.Заполнить(ДанныеПечати);
			ТабличныйДокумент.Вывести(ОбластьНомера);
			
			Если ВыводитьАртикул Тогда
				ОбластьАртикул.Параметры.Заполнить(ДанныеПечати);
				ТабличныйДокумент.Присоединить(ОбластьАртикул);
			КонецЕсли;
			
			ОбластьТовар.Параметры.Заполнить(ДанныеПечати);
			ТабличныйДокумент.Присоединить(ОбластьТовар);
			
			ОбластьДанных.Параметры.Заполнить(ДанныеПечати);
			ТабличныйДокумент.Присоединить(ОбластьДанных);
		Исключение
		КонецПопытки;
		
		ИмяКомната = "";
		НомерСтроки = 1;
		Попытка
			СтруктураПоиска = Новый Структура("Ссылка", ДанныеПечати.Ссылка);
			ВыборкаПоТоварам.Сбросить();
			
			Если ВыборкаПоТоварам.НайтиСледующий(СтруктураПоиска) Тогда
				
				ИмяКомната = "";
				//выводим секцию с табличной частью				
				ВыборкаТоваровУслуг = ВыборкаПоТоварам.Выбрать();
				Пока ВыборкаТоваровУслуг.Следующий() Цикл					 
					Если ИмяКомната <> ВыборкаТоваровУслуг.Комната Тогда
						
						//Комнаты
						НайденныеКомнаты = ТаблицаКомнат.НайтиСтроки(Новый Структура("Ссылка, Комната", ДанныеПечати.Ссылка, ВыборкаТоваровУслуг.Комната));
						ТекущаяКомната = НайденныеКомнаты[0];					
						
						ОбластьНомераКомната.Параметры.Заполнить(ТекущаяКомната);
						ТабличныйДокумент.Вывести(ОбластьНомераКомната);
						
						Если ВыводитьАртикул Тогда
							ОбластьАртикулКомната.Параметры.Заполнить(ТекущаяКомната);
							ТабличныйДокумент.Присоединить(ОбластьАртикулКомната);
						КонецЕсли;
						
						ОбластьТоварКомната.Параметры.Заполнить(ТекущаяКомната);
						ТабличныйДокумент.Присоединить(ОбластьТоварКомната);
						
						ОбластьДанныхКомната.Параметры.Заполнить(ТекущаяКомната);
						ТабличныйДокумент.Присоединить(ОбластьДанныхКомната);
						
						ИмяКомната = ВыборкаТоваровУслуг.Комната;
						
					КонецЕсли;
					
					//товары в комнате
					ОбластьНомераСтроки.Параметры.Заполнить(ВыборкаТоваровУслуг);
					ТабличныйДокумент.Вывести(ОбластьНомераСтроки);
					
					Если ВыводитьАртикул Тогда
						ОбластьАртикулСтроки.Параметры.Заполнить(ВыборкаТоваровУслуг);
						ТабличныйДокумент.Присоединить(ОбластьАртикулСтроки);
					КонецЕсли;
					
					ДопДанныеСтроки = Новый Структура;
					//++ №12909
					//ДопДанныеСтроки.Вставить("ПредставлениеНоменклатуры", 
					//	ОбщийМодульСервер.ПредставлениеНоменклатурыДляПечати(Строка(ВыборкаТоваровУслуг.Номенклатура), Строка(ВыборкаТоваровУслуг.ХарактеристикаНоменклатуры)));
					ДопДанныеСтроки.Вставить("ПредставлениеНоменклатуры", 
					ОбщийМодульСервер.ПредставлениеНоменклатурыДляПечати(ВыборкаТоваровУслуг.Номенклатура, ВыборкаТоваровУслуг.ХарактеристикаНоменклатуры));
					//-- №12909
					
					ОбластьТоварСтроки.Параметры.Заполнить(ВыборкаТоваровУслуг);
					ОбластьТоварСтроки.Параметры.Заполнить(ДопДанныеСтроки);
					ТабличныйДокумент.Присоединить(ОбластьТоварСтроки);
					
					ОбластьДанныхСтроки.Параметры.Заполнить(ВыборкаТоваровУслуг);
					//#10947
					Если ЕстьСкидкиВДокументе И ПересчетЦеныПоСкидке Тогда
						ДопДанныеСтроки = Новый Структура;
						ДопДанныеСтроки.Вставить("Цена", ?(ВыборкаТоваровУслуг.Количество = 0, 0, ВыборкаТоваровУслуг.Сумма / ВыборкаТоваровУслуг.Количество));
						ОбластьДанныхСтроки.Параметры.Заполнить(ДопДанныеСтроки);
					КонецЕсли;
					ТабличныйДокумент.Присоединить(ОбластьДанныхСтроки);
					
				КонецЦикла;
			КонецЕсли;			
			
		Исключение
		КонецПопытки;
		
		Попытка
			// подвал таблицы 
			ОбластьНомера  = Макет.ПолучитьОбласть("ПодвалТаблицы" + СуффиксОбластиСтроки + "|НомерСтроки");
			ОбластьАртикул = Макет.ПолучитьОбласть("ПодвалТаблицы" + СуффиксОбластиСтроки + "|КолонкаАртикул");
			ОбластьТовар   = Макет.ПолучитьОбласть("ПодвалТаблицы" + СуффиксОбластиСтроки + "|Товар" + СуффиксОбластиКолонки);
			ОбластьДанных  = Макет.ПолучитьОбласть("ПодвалТаблицы" + СуффиксОбластиСтроки + "|Данные" + СуффиксОбластиКолонки);
			
			ТабличныйДокумент.Вывести(ОбластьНомера);
			
			Если ВыводитьАртикул Тогда
				ТабличныйДокумент.Присоединить(ОбластьАртикул);
			КонецЕсли;
			
			ТабличныйДокумент.Присоединить(ОбластьТовар);
			
			ОбластьДанных.Параметры.Заполнить(ДанныеПечати);
			ТабличныйДокумент.Присоединить(ОбластьДанных);
		Исключение
		КонецПопытки;
		
		// Выводим ИтогоНДС
		Попытка
			ЦенаВключаетНДС = Истина;
			Область = Макет.ПолучитьОбласть("ПодвалНДС");
			СтруктураДанныхПодвалНДС = Новый Структура;
			СтруктураДанныхПодвалНДС.Вставить("ИтогоСуммаНДС", ДанныеПечати.ИтогоСуммаНДС);
			Если ЕстьНДС Тогда
				СтруктураДанныхПодвалНДС.Вставить("НДС", ?(ЦенаВключаетНДС, НСтр("ru='В том числе НДС:'"), НСтр("ru='Сумма НДС:'")));
			Иначе
				СтруктураДанныхПодвалНДС.Вставить("НДС", НСтр("ru='Без налога (НДС)'"));
			КонецЕсли;
			Область.Параметры.Заполнить(СтруктураДанныхПодвалНДС);
			ТабличныйДокумент.Присоединить(Область);
		Исключение
		КонецПопытки;
		
		// Выводим Сумму прописью
		Попытка
			ОбластьМакета = Макет.ПолучитьОбласть("СуммаПрописью");
			ОбластьМакета.Параметры.Заполнить(ДанныеПечати);
			ТабличныйДокумент.Вывести(ОбластьМакета);
		Исключение
		КонецПопытки;
		
		// Выводим подвал с подписями
		ОбластьМакета = Макет.ПолучитьОбласть("Подвал");
		ОбластьМакета.Параметры.Заполнить(ДанныеПечати);		
		ТабличныйДокумент.Вывести(ОбластьМакета);
		
		ВидНомен = "";
		Попытка
			//объединяем Товары и Материалы 
			тзТоварыМатериалы = ДанныеПечати.Ссылка.ТоварыУслуги.Выгрузить();
			Для каждого Материалы Из ДанныеПечати.Ссылка.Материалы Цикл 
				Если ЗначениеЗаполнено(Материалы.Номенклатура) Тогда		
					НоваяСтрокаМатериала = тзТоварыМатериалы.Добавить();
					ЗаполнитьЗначенияСвойств(НоваяСтрокаМатериала, Материалы);
					Попытка
						НоваяСтрокаМатериала.Артикул = Материалы.Номенклатура.Артикул;
					Исключение
					КонецПопытки;
				КонецЕсли;
			КонецЦикла;
			тзТоварыМатериалы.Колонки.Добавить("ВидНоменклатуры");
			тзТоварыМатериалы.Колонки.Добавить("Артикул");
			Для каждого СтрокаТЗ Из тзТоварыМатериалы Цикл
				СтрокаТЗ.ВидНоменклатуры = СтрокаТЗ.Номенклатура.ВидНоменклатуры;
				СтрокаТЗ.Артикул = СтрокаТЗ.Номенклатура.Артикул;
			КонецЦикла;
			тзТоварыМатериалы.Сортировать("ВидНоменклатуры Возр");
			тзТоварыМатериалы.Свернуть("ВидНоменклатуры,Артикул,Номенклатура,ХарактеристикаНоменклатуры,ЕдиницаИзмерения,Коэффициент", "Количество"); 
			
			ОбластьМакета = Макет.ПолучитьОбласть("ШапкаМатериалы|НомерСтроки");
			ТабличныйДокумент.Вывести(ОбластьМакета);
			
			Если ВыводитьАртикул Тогда
				ОбластьМакета = Макет.ПолучитьОбласть("ШапкаМатериалы|КолонкаАртикул");
				ТабличныйДокумент.Присоединить(ОбластьМакета);
			КонецЕсли;
			
			ОбластьМакета = Макет.ПолучитьОбласть("ШапкаМатериалы|Материал");
			ТабличныйДокумент.Присоединить(ОбластьМакета);
			
			ОбластьМакета = Макет.ПолучитьОбласть("ШапкаМатериалы|МатериалДанные");
			ТабличныйДокумент.Присоединить(ОбластьМакета);
			
			НомерСтроки = 1;
			Для Каждого Материалы Из тзТоварыМатериалы Цикл
				
				Если НЕ Материалы.Номенклатура.Пустая() 
					И Материалы.ВидНоменклатуры <> Справочники.ВидыНоменклатуры.Услуга Тогда
					
					
					Если ВидНомен <> Материалы.ВидНоменклатуры Тогда
						
						ВидНомен = Материалы.ВидНоменклатуры;
						ОбластьМакета = Макет.ПолучитьОбласть("СтрокаМатериалы|НомерСтроки");
						ТабличныйДокумент.Вывести(ОбластьМакета);
						
						Если ВыводитьАртикул Тогда
							ОбластьМакета = Макет.ПолучитьОбласть("СтрокаМатериалы|КолонкаАртикул");
							ТабличныйДокумент.Присоединить(ОбластьМакета);
						КонецЕсли;
						
						ОбластьМакета = Макет.ПолучитьОбласть("СтрокаМатериалы|Материал");
						// жирный наклонный шрифт
						ШрифтВидНомен = Новый Шрифт (ОбластьМакета.Область().Шрифт,,,Истина,Истина);
						ОбластьМакета.Область().Шрифт = ШрифтВидНомен;
						ОбластьМакета.Параметры.ПредставлениеНоменклатуры = ВидНомен;
						ТабличныйДокумент.Присоединить(ОбластьМакета);
						
						ОбластьМакета = Макет.ПолучитьОбласть("СтрокаМатериалы|МатериалДанные");
						ТабличныйДокумент.Присоединить(ОбластьМакета);
					КонецЕсли;
					
					ОбластьМакета = Макет.ПолучитьОбласть("СтрокаМатериалы|НомерСтроки");
					ЗаполнитьЗначенияСвойств(ОбластьМакета.Параметры, Материалы);
					ОбластьМакета.Параметры.НомерСтроки = НомерСтроки;
					ТабличныйДокумент.Вывести(ОбластьМакета);
					
					Если ВыводитьАртикул Тогда
						ОбластьМакета = Макет.ПолучитьОбласть("СтрокаМатериалы|КолонкаАртикул");
						ЗаполнитьЗначенияСвойств(ОбластьМакета.Параметры, Материалы);
						ТабличныйДокумент.Присоединить(ОбластьМакета);
					КонецЕсли;
					
					ОбластьМакета = Макет.ПолучитьОбласть("СтрокаМатериалы|Материал");
					ЗаполнитьЗначенияСвойств(ОбластьМакета.Параметры, Материалы);
					
					//++ №12909
					//ПредставлениеНоменклатуры = Строка(Материалы.Номенклатура) + Строка(УправлениеПечатью.ПредставлениеХарактеристики(Материалы.ХарактеристикаНоменклатуры));
					ПредставлениеНоменклатуры = ОбщийМодульСервер.ПредставлениеНоменклатурыДляПечати(Материалы.Номенклатура, Материалы.ХарактеристикаНоменклатуры);
					//-- №12909
					
					ОбластьМакета.Параметры.ПредставлениеНоменклатуры = ПредставлениеНоменклатуры;	
					ТабличныйДокумент.Присоединить(ОбластьМакета);
					
					ОбластьМакета = Макет.ПолучитьОбласть("СтрокаМатериалы|МатериалДанные");
					ЗаполнитьЗначенияСвойств(ОбластьМакета.Параметры, Материалы);	
					ТабличныйДокумент.Присоединить(ОбластьМакета);
					
					НомерСтроки = НомерСтроки + 1;
				КонецЕсли;
			КонецЦикла;
			
			ОбластьМакета = Макет.ПолучитьОбласть("ПодвалМатериалы|НомерСтроки");
			ТабличныйДокумент.Вывести(ОбластьМакета);
			
			Если ВыводитьАртикул Тогда
				ОбластьМакета = Макет.ПолучитьОбласть("ПодвалМатериалы|КолонкаАртикул");
				ТабличныйДокумент.Присоединить(ОбластьМакета);
			КонецЕсли;	
			
			ОбластьМакета = Макет.ПолучитьОбласть("ПодвалМатериалы|Материал");
			ТабличныйДокумент.Присоединить(ОбластьМакета);
			
			ОбластьМакета = Макет.ПолучитьОбласть("ПодвалМатериалы|МатериалДанные");
			ТабличныйДокумент.Присоединить(ОбластьМакета);
			
		Исключение
		КонецПопытки;
		
		Попытка
			Если НЕ ПустаяСтрока(ДанныеПечати.КомментарийКМонтажу) Тогда
				ОбластьМакета = Макет.ПолучитьОбласть("КомментарийКМонтажу");
				ЗаполнитьЗначенияСвойств(ОбластьМакета.Параметры, ДанныеПечати);
				ТабличныйДокумент.Вывести(ОбластьМакета);
			КонецЕсли;
		Исключение
		КонецПопытки;
		
		//Исполнители
		Если ТипЗнч(ДанныеПечати.Ссылка) = Тип("ДокументСсылка.Монтаж") Тогда
			
			Попытка
				Если ДанныеПечати.Ссылка.Исполнители.Количество() > 0 Тогда
					ОбластьМакета = Макет.ПолучитьОбласть("ШапкаИсполнители");				
					ТабличныйДокумент.Вывести(ОбластьМакета);
					
					Для Каждого Исполнитель Из ДанныеПечати.Ссылка.Исполнители Цикл
						ОбластьМакета = Макет.ПолучитьОбласть("СтрокаИсполнители");				
						ЗаполнитьЗначенияСвойств(ОбластьМакета.Параметры, Исполнитель);
						ТабличныйДокумент.Вывести(ОбластьМакета);
					КонецЦикла;
					
					ОбластьМакета = Макет.ПолучитьОбласть("ПодвалИсполнители");				
					ТабличныйДокумент.Вывести(ОбластьМакета);
				КонецЕсли;				
			Исключение
			КонецПопытки;
			
			//2017-10-24 Добавлена печать планируемой выработки по монтажникам
			ЕстьСекцияВыработкиМонтажников = Ложь;
			Попытка
				ОбластьМакета  = Макет.ПолучитьОбласть("СтрокаВыработки");
				ЕстьСекцияВыработкиМонтажников = Истина;
			Исключение
			КонецПопытки;
			
			ЕстьСекцияВыработкиМонтажниковОбщая = Ложь;
			Попытка
				ОбластьМакета  = Макет.ПолучитьОбласть("СтрокаВыработкиОбщая");
				ЕстьСекцияВыработкиМонтажниковОбщая = Истина;
			Исключение
			КонецПопытки;
			
			//++ №13368 выработку получаем так, как она отображается на форме (план, факт)
			Если ЕстьСекцияВыработкиМонтажников Или ЕстьСекцияВыработкиМонтажниковОбщая Тогда
				
				ТаблицаВыработки = ПолучитьТаблицуВыработкиПоМонтажуДляПФ(ДанныеПечати.Ссылка).ТаблицаВыработки;
				
			КонецЕсли;
			//-- №13368 выработку получаем так, как она отображается на форме (план, факт)
			
			ВыведенаШапка = Ложь;
			
			Если ЕстьСекцияВыработкиМонтажников Тогда
				
				///ТЗ_Выработки_Врем = Новый ТаблицаЗначений;
				//ТЗ_Выработки_Врем = Зарплата.ПолучитьЗаписиРегистраВыработки(Шапка.Ссылка);  #6347
				//ТЗ_Выработки_Врем.Свернуть("Сотрудник, ВидНачисления, Номенклатура, НеНачислятьВыработку", "Количество, Стоимость"); #6347 заменено на нижнюю конструкцию
				
				//++ №13368 выработка получается один раз выше
				//ТЗ_Выработки_Врем = Зарплата.РассчитатьВыработкуПоДокументу(ДанныеПечати.Ссылка);
				ТЗ_Выработки_Врем = ТаблицаВыработки.Скопировать();
				//++ №13368
				
				ТЗ_Выработки_Врем.Свернуть("Сотрудник, ВидНачисления, Номенклатура", "Количество, Стоимость");
				
				//оставим только исполнителей монтажа
				ТЗ_Выработки = ТЗ_Выработки_Врем.Скопировать();			
				ТЗ_Выработки.Очистить();
				Для Каждого ТекущийИсполнитель Из ТЗ_Выработки_Врем Цикл
					Если НЕ ДанныеПечати.Ссылка.Исполнители.Найти(ТекущийИсполнитель.Сотрудник, "Сотрудник") = Неопределено Тогда
						НоваяСтрока = ТЗ_Выработки.Добавить();
						ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущийИсполнитель);
					КонецЕсли;
				КонецЦикла;
				
				СуммаСотрудникИтог = 0;
				СотрудникИтог = Неопределено;
				Для каждого Исполнитель Из ДанныеПечати.Ссылка.Исполнители Цикл
					
					НайденныеСтроки = ТЗ_Выработки.НайтиСтроки(Новый Структура("Сотрудник", Исполнитель.Сотрудник));
					Если НайденныеСтроки.Количество() > 0 Тогда
						Если НЕ ВыведенаШапка Тогда
							ОбластьМакета = Макет.ПолучитьОбласть("ШапкаВыработки");
							ЗаполнитьЗначенияСвойств(ОбластьМакета.Параметры, ДанныеПечати);
							ТабличныйДокумент.Вывести(ОбластьМакета);
							ВыведенаШапка = Истина;
						КонецЕсли;
						
						СуммаСотрудникИтог = 0;
						Для каждого НайденнаяСтрока Из НайденныеСтроки Цикл
							ОбластьМакета = Макет.ПолучитьОбласть("СтрокаВыработки");
							ЗаполнитьЗначенияСвойств(ОбластьМакета.Параметры, НайденнаяСтрока);
							ТабличныйДокумент.Вывести(ОбластьМакета);
							СуммаСотрудникИтог = СуммаСотрудникИтог + НайденнаяСтрока.Стоимость;
						КонецЦикла;
						Попытка
							ОбластьМакета = Макет.ПолучитьОбласть("СтрокаВыработкиИтог");
							ОбластьМакета.Параметры.Стоимость = СуммаСотрудникИтог;
							ТабличныйДокумент.Вывести(ОбластьМакета);							
						Исключение							
						КонецПопытки;
					КонецЕсли;
				КонецЦикла;
				
				Если ВыведенаШапка Тогда
					ОбластьМакета = Макет.ПолучитьОбласть("ИтогоВыработки");
					ЗаполнитьЗначенияСвойств(ОбластьМакета.Параметры, ДанныеПечати);
					ТабличныйДокумент.Вывести(ОбластьМакета);
				КонецЕсли;
				
			КонецЕсли;
			// Конец 2017-10-24
			
			//Выработка общая в разрезе Сотрудник - Вид начисления
			//По персональной заявке №2262
			
			ВыведенаШапкаОбщая = Ложь;
			
			Если ЕстьСекцияВыработкиМонтажниковОбщая Тогда
				
				//++ №13368 выработка получается один раз выше
				//ТЗ_Выработки_Врем = Новый ТаблицаЗначений;
				//ТЗ_Выработки_Врем = Зарплата.РассчитатьВыработкуПоДокументу(ДанныеПечати.Ссылка);
				ТЗ_Выработки_Врем = ТаблицаВыработки.Скопировать();
				//++ №13368
				
				ТЗ_Выработки_Врем.Свернуть("Сотрудник, ВидНачисления", "Стоимость");
				
				//оставим только исполнителей монтажа
				ТЗ_Выработки = ТЗ_Выработки_Врем.Скопировать();			
				ТЗ_Выработки.Очистить();
				Для Каждого ТекущийИсполнитель Из ТЗ_Выработки_Врем Цикл
					Если НЕ ДанныеПечати.Ссылка.Исполнители.Найти(ТекущийИсполнитель.Сотрудник, "Сотрудник") = Неопределено Тогда
						НоваяСтрока = ТЗ_Выработки.Добавить();
						ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущийИсполнитель);
					КонецЕсли;
				КонецЦикла;
				
				СуммаСотрудникИтог = 0;
				СотрудникИтог = Неопределено;
				Для каждого Исполнитель Из ДанныеПечати.Ссылка.Исполнители Цикл
					
					НайденныеСтроки = ТЗ_Выработки.НайтиСтроки(Новый Структура("Сотрудник", Исполнитель.Сотрудник));
					Если НайденныеСтроки.Количество() > 0 Тогда
						Если НЕ ВыведенаШапкаОбщая Тогда
							ОбластьМакета = Макет.ПолучитьОбласть("ШапкаВыработкиОбщая");
							ЗаполнитьЗначенияСвойств(ОбластьМакета.Параметры, ДанныеПечати);
							ТабличныйДокумент.Вывести(ОбластьМакета);
							ВыведенаШапкаОбщая = Истина;
						КонецЕсли;
						
						СуммаСотрудникИтог = 0;
						Для каждого НайденнаяСтрока Из НайденныеСтроки Цикл
							ОбластьМакета = Макет.ПолучитьОбласть("СтрокаВыработкиОбщая");
							ЗаполнитьЗначенияСвойств(ОбластьМакета.Параметры, НайденнаяСтрока);
							ТабличныйДокумент.Вывести(ОбластьМакета);
							СуммаСотрудникИтог = СуммаСотрудникИтог + НайденнаяСтрока.Стоимость;
						КонецЦикла;
						Попытка
							ОбластьМакета = Макет.ПолучитьОбласть("СтрокаВыработкиИтогОбщая");
							ОбластьМакета.Параметры.Стоимость = СуммаСотрудникИтог;
							ТабличныйДокумент.Вывести(ОбластьМакета);							
						Исключение							
						КонецПопытки;
					КонецЕсли;
				КонецЦикла;
				
				Если ВыведенаШапкаОбщая Тогда
					ОбластьМакета = Макет.ПолучитьОбласть("ИтогоВыработкиОбщая");
					ЗаполнитьЗначенияСвойств(ОбластьМакета.Параметры, ДанныеПечати);
					ТабличныйДокумент.Вывести(ОбластьМакета);
				КонецЕсли;
				
			КонецЕсли;
			//Конец Выработка общая
		КонецЕсли;
		
		// В табличном документе необходимо задать имя области, в которую был 
		// выведен объект. Нужно для возможности печати комплектов документов.
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабличныйДокумент, НомерСтрокиНачало, ОбъектыПечати, ДанныеПечати.Ссылка);
		
	КонецЦикла;
	
	Возврат ТабличныйДокумент;
	
КонецФункции

// Функция - Печать розница материалы
//
// Параметры:
//  МассивОбъектов	 - 	 - 
//  ОбъектыПечати	 - 	 - 
//  ИмяМакета		 - 	 - 
// 
// Возвращаемое значение:
//   - 
//
Функция ПечатьРозницаМатериалы(МассивОбъектов, ОбъектыПечати, ИмяМакета) Экспорт
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.АвтоМасштаб         = Истина;
	ТабличныйДокумент.ИмяПараметровПечати = "ПараметрыПечати_Материалы";
	//Макет = УправлениеПечатью.МакетПечатнойФормы("ОбщийМакет.ПФ_MXL_МатериалыРозница");
	Макет = УправлениеПечатью.МакетПечатнойФормы(ИмяМакета);
	ВыводитьАртикул = Константы.ВыводитьАртикулНоменклатурыВПечатныхФормах.Получить();
	
	ВариантВывода = 0;
	Если ТипЗнч(МассивОбъектов[0]) = Тип("ДокументСсылка.ЗаказДоговор") Тогда
		ВариантВывода = Константы.ВариантФормированияПФМатериалыЗаказДоговора.Получить();
	Иначе
		ВариантВывода = Константы.ВариантФормированияПФМатериалыМонтажа.Получить();
	КонецЕсли;
	
	МенеджерОбъекта = ОбщегоНазначения.МенеджерОбъектаПоСсылке(МассивОбъектов[0]);
	
	СтруктураДанныхДляПечати = МенеджерОбъекта.ПолучитьДанныеДляПечатныхФорм(МассивОбъектов);
	ТаблицаДанныеПечати      = СтруктураДанныхДляПечати.РезультатПоШапке.Выгрузить();
	МенеджерОбъекта.ДополнитьДанныеДляПечатныхФорм(ТаблицаДанныеПечати);
	ВыборкаПоМатериалам = СтруктураДанныхДляПечати.РезультатПоТабличнойЧастиМатериалы.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	ПервыйДокумент = Истина;
	Для каждого ДанныеПечати из ТаблицаДанныеПечати Цикл		
		Если Не ПервыйДокумент Тогда
			// Все документы нужно выводить на разных страницах.
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		ПервыйДокумент = Ложь;
		// Запомним номер строки, с которой начали выводить текущий документ.
		НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы + 1;
		
		СтруктураПоиска = Новый Структура("Ссылка", ДанныеПечати.Ссылка);
		ВыборкаПоМатериалам.Сбросить();
		
		МассивДопРеквизитов = Новый Массив;
		МассивДопРеквизитов.Добавить(Новый Структура("Имя, Тип", "Артикул", 			Новый ОписаниеТипов("Строка")));
		ТаблицаМатериалов = ОбщийМодульСервер.ТаблицаЗначенийПоТабличнойЧастиОбъекта("ЗаказДоговор", "Материалы", МассивДопРеквизитов);
		
		Если ВыборкаПоМатериалам.НайтиСледующий(СтруктураПоиска) Тогда			
			Выборка = ВыборкаПоМатериалам.Выбрать();			
			Пока Выборка.Следующий() Цикл
				ТекущаяСтрока = ТаблицаМатериалов.Добавить();
				ЗаполнитьЗначенияСвойств(ТекущаяСтрока, Выборка);
			КонецЦикла;		
		КонецЕсли;	
		
		Попытка
			ОбластьНомера   		= Макет.ПолучитьОбласть("Шапка|НомерСтроки");
			ОбластьАртикул 		 	= Макет.ПолучитьОбласть("Шапка|КолонкаАртикул");
			ОбластьМатериал 		= Макет.ПолучитьОбласть("Шапка|Материал");
			ОбластьДанных   		= Макет.ПолучитьОбласть("Шапка|МатериалДанные");
			
			ОбластьНомераСтроки 	= Макет.ПолучитьОбласть("Строка|НомерСтроки");
			ОбластьАртикулСтроки	= Макет.ПолучитьОбласть("Строка|КолонкаАртикул");
			ОбластьМатериалСтроки  	= Макет.ПолучитьОбласть("Строка|Материал");
			ОбластьДанныхСтроки 	= Макет.ПолучитьОбласть("Строка|МатериалДанные");
			
			ОбластьНомераКомната   	= Макет.ПолучитьОбласть("СтрокаКомнаты|НомерСтроки");
			ОбластьАртикулКомната  	= Макет.ПолучитьОбласть("СтрокаКомнаты|КолонкаАртикул");
			ОбластьМатериалКомната 	= Макет.ПолучитьОбласть("СтрокаКомнаты|Материал");
			ОбластьДанныхКомната   	= Макет.ПолучитьОбласть("СтрокаКомнаты|МатериалДанные");
			
			ОбластьНомераПодвал  	= Макет.ПолучитьОбласть("Подвал|НомерСтроки");
			ОбластьАртикулПодвал 	= Макет.ПолучитьОбласть("Подвал|КолонкаАртикул");
			ОбластьМатериалПодвал   = Макет.ПолучитьОбласть("Подвал|Материал");
			ОбластьДанныхПодвал  	= Макет.ПолучитьОбласть("Подвал|МатериалДанные"); 			
		Исключение
			Возврат ТабличныйДокумент;
		КонецПопытки;
		
		// 1. вывод в развернутом виде
		Если ВариантВывода = 0 ИЛИ ВариантВывода = 1 Тогда
			// заголовок			
			Попытка	
				ОбластьМакета = Макет.ПолучитьОбласть("Заголовок");
				ОбластьМакета.Параметры.Заполнить(ДанныеПечати);
				Попытка			
					ТекстЗаголовка = ДанныеПечати.Ссылка.Метаданные().Синоним + " №" + ПрефиксацияОбъектовКлиентСервер.НомерНаПечать(ДанныеПечати.Номер) + " от " + ДанныеПечати.ДатаДокументаФормат;
					ОбластьМакета.Параметры.ТекстЗаголовка = ТекстЗаголовка;
				Исключение
				КонецПопытки;
				ТабличныйДокумент.Вывести(ОбластьМакета);
			Исключение
			КонецПопытки;
			
			//ЗаголовокТаблицы
			Попытка
				ОбластьМакета = Макет.ПолучитьОбласть("ЗаголовокТаблицы");
				ОбластьМакета.Параметры.Заполнить(ДанныеПечати);
				Попытка			
					ОбластьМакета.Параметры.ЗаголовокТаблицы = "Материалы";
				Исключение
				КонецПопытки;
				ТабличныйДокумент.Вывести(ОбластьМакета);
			Исключение
			КонецПопытки;
			
			//таблица
			ОбластьНомера.Параметры.Заполнить(ДанныеПечати);
			ТабличныйДокумент.Вывести(ОбластьНомера); 		
			Если ВыводитьАртикул Тогда
				ОбластьАртикул.Параметры.Заполнить(ДанныеПечати);
				ТабличныйДокумент.Присоединить(ОбластьАртикул);
			КонецЕсли;		
			ОбластьМатериал.Параметры.Заполнить(ДанныеПечати);
			ТабличныйДокумент.Присоединить(ОбластьМатериал);		
			ОбластьДанных.Параметры.Заполнить(ДанныеПечати);
			ТабличныйДокумент.Присоединить(ОбластьДанных);		
			
			ИмяКомната = "";
			Для каждого СтрокаТЧ из ТаблицаМатериалов Цикл
				
				Если ИмяКомната <> СтрокаТЧ.Комната Тогда				
					ТабличныйДокумент.Вывести(ОбластьНомераКомната);
					
					Если ВыводитьАртикул Тогда
						ТабличныйДокумент.Присоединить(ОбластьАртикулКомната);
					КонецЕсли;
					
					ОбластьМатериалКомната.Параметры.ПредставлениеКомнаты = СтрокаТЧ.Комната;
					ТабличныйДокумент.Присоединить(ОбластьМатериалКомната);
					ТабличныйДокумент.Присоединить(ОбластьДанныхКомната);
					
					ИмяКомната = СтрокаТЧ.Комната;				
				КонецЕсли;
				
				ОбластьНомераСтроки.Параметры.Заполнить(СтрокаТЧ);
				ТабличныйДокумент.Вывести(ОбластьНомераСтроки);
				
				Если ВыводитьАртикул Тогда
					ОбластьАртикулСтроки.Параметры.Заполнить(СтрокаТЧ);
					ТабличныйДокумент.Присоединить(ОбластьАртикулСтроки);
				КонецЕсли;
				
				ДопДанныеСтроки = Новый Структура;
				ДопДанныеСтроки.Вставить("ПредставлениеНоменклатуры", 
				ОбщийМодульСервер.ПредставлениеНоменклатурыДляПечати(СтрокаТЧ.Номенклатура, СтрокаТЧ.ХарактеристикаНоменклатуры));				                                                      				
				ОбластьМатериалСтроки.Параметры.Заполнить(СтрокаТЧ);
				ОбластьМатериалСтроки.Параметры.Заполнить(ДопДанныеСтроки);
				ТабличныйДокумент.Присоединить(ОбластьМатериалСтроки);
				
				ОбластьДанныхСтроки.Параметры.Заполнить(СтрокаТЧ);
				ТабличныйДокумент.Присоединить(ОбластьДанныхСтроки);
				
			КонецЦикла;
			
			// подвал таблицы		
			ТабличныйДокумент.Вывести(ОбластьНомераПодвал); 		
			Если ВыводитьАртикул Тогда
				ТабличныйДокумент.Присоединить(ОбластьАртикулПодвал);
			КонецЕсли;		
			ТабличныйДокумент.Присоединить(ОбластьМатериалПодвал);		
			ОбластьДанныхПодвал.Параметры.Заполнить(ДанныеПечати);
			ТабличныйДокумент.Присоединить(ОбластьДанныхПодвал);
			
		КонецЕсли; // Если ВариантВывода = 0 ИЛИ ВариантВывода = 1 Тогда
		
		///////////////////////////////////////////////////////////////////////////////////////////////////////
		
		Если ВариантВывода = 0 Тогда			
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		// 2. вывод в свернутом виде
		Если ВариантВывода = 0 ИЛИ ВариантВывода = 2 Тогда
			ТаблицаМатериалов.Свернуть("Артикул, Номенклатура, ХарактеристикаНоменклатуры, ЕдиницаИзмерения", "Количество");
			
			//заголовок			
			Попытка
				ОбластьМакета = Макет.ПолучитьОбласть("Заголовок");
				ОбластьМакета.Параметры.Заполнить(ДанныеПечати);
				Попытка			
					ТекстЗаголовка = ДанныеПечати.Ссылка.Метаданные().Синоним + " №" + ПрефиксацияОбъектовКлиентСервер.НомерНаПечать(ДанныеПечати.Номер) + " от " + ДанныеПечати.ДатаДокументаФормат;
					ОбластьМакета.Параметры.ТекстЗаголовка = ТекстЗаголовка;
				Исключение
				КонецПопытки;
				ТабличныйДокумент.Вывести(ОбластьМакета);
			Исключение
			КонецПопытки;
			
			//ЗаголовокТаблицы
			Попытка
				ОбластьМакета = Макет.ПолучитьОбласть("ЗаголовокТаблицы");
				ОбластьМакета.Параметры.Заполнить(ДанныеПечати);
				Попытка			
					ОбластьМакета.Параметры.ЗаголовокТаблицы = "Материалы (свернуто, без комнат)";
				Исключение
				КонецПопытки;
				ТабличныйДокумент.Вывести(ОбластьМакета);
			Исключение
			КонецПопытки;
			
			//шапка таблицы
			ОбластьНомера.Параметры.Заполнить(ДанныеПечати);
			ТабличныйДокумент.Вывести(ОбластьНомера); 		
			Если ВыводитьАртикул Тогда
				ОбластьАртикул.Параметры.Заполнить(ДанныеПечати);
				ТабличныйДокумент.Присоединить(ОбластьАртикул);
			КонецЕсли;		
			ОбластьМатериал.Параметры.Заполнить(ДанныеПечати);
			ТабличныйДокумент.Присоединить(ОбластьМатериал);		
			ОбластьДанных.Параметры.Заполнить(ДанныеПечати);
			ТабличныйДокумент.Присоединить(ОбластьДанных);		
			
			НомерСтроки = 1;
			Для каждого СтрокаТЧ из ТаблицаМатериалов Цикл			
				ДопДанныеСтроки = Новый Структура;
				ДопДанныеСтроки.Вставить("НомерСтроки", НомерСтроки);
				ДопДанныеСтроки.Вставить("ПредставлениеНоменклатуры", ОбщийМодульСервер.ПредставлениеНоменклатурыДляПечати(СтрокаТЧ.Номенклатура, СтрокаТЧ.ХарактеристикаНоменклатуры));				                                                      				
				
				ОбластьНомераСтроки.Параметры.Заполнить(СтрокаТЧ);
				ОбластьНомераСтроки.Параметры.Заполнить(ДопДанныеСтроки);
				ТабличныйДокумент.Вывести(ОбластьНомераСтроки);
				
				Если ВыводитьАртикул Тогда
					ОбластьАртикулСтроки.Параметры.Заполнить(СтрокаТЧ);
					ТабличныйДокумент.Присоединить(ОбластьАртикулСтроки);
				КонецЕсли;
				
				ОбластьМатериалСтроки.Параметры.Заполнить(СтрокаТЧ);
				ОбластьМатериалСтроки.Параметры.Заполнить(ДопДанныеСтроки);
				ТабличныйДокумент.Присоединить(ОбластьМатериалСтроки);
				
				ОбластьДанныхСтроки.Параметры.Заполнить(СтрокаТЧ);
				ТабличныйДокумент.Присоединить(ОбластьДанныхСтроки);
				
				НомерСтроки = НомерСтроки + 1;
			КонецЦикла;
			
			// подвал таблицы		
			ТабличныйДокумент.Вывести(ОбластьНомераПодвал); 		
			Если ВыводитьАртикул Тогда
				ТабличныйДокумент.Присоединить(ОбластьАртикулПодвал);
			КонецЕсли;		
			ТабличныйДокумент.Присоединить(ОбластьМатериалПодвал);		
			ОбластьДанныхПодвал.Параметры.Заполнить(ДанныеПечати);
			ТабличныйДокумент.Присоединить(ОбластьДанныхПодвал);
		КонецЕсли;
		
		// В табличном документе необходимо задать имя области, в которую был 
		// выведен объект. Нужно для возможности печати комплектов документов.
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабличныйДокумент, НомерСтрокиНачало, ОбъектыПечати, ДанныеПечати.Ссылка);
		
	КонецЦикла;
	
	Возврат ТабличныйДокумент;
	
КонецФункции

Функция QRКодРеквизитыПлатежа(ДанныеПечати) Экспорт
	
	РеквизитыПлатежа = УправлениеПечатьюРФ.НовыйРеквизитыПлатежаУФЭБС();
	
	РеквизитыПлатежа.ТекстПолучателя             = ДанныеПечати.ПредставлениеОрганизации;
	РеквизитыПлатежа.НомерСчетаПолучателя        = ДанныеПечати.БанковскийСчетНомерСчета;
	РеквизитыПлатежа.НаименованиеБанкаПолучателя = ДанныеПечати.БанковскийСчетНаименованиеБанка;
	РеквизитыПлатежа.БИКБанкаПолучателя          = ДанныеПечати.БанковскийСчетБИК;
	РеквизитыПлатежа.СчетБанкаПолучателя         = ДанныеПечати.БанковскийСчетКоррСчет;
	
	РеквизитыПлатежа.ИННПолучателя               = ДанныеПечати.ИНН;
	РеквизитыПлатежа.КПППолучателя               = ДанныеПечати.КПП;
	
	РеквизитыПлатежа.СуммаЧислом = ДанныеПечати.СуммаДокумента;
	
	Если ДанныеПечати.ИтогоСуммаНДС > 0 Тогда
		ТекстПроНДС = НСтр("ru = 'В том числе НДС'");
	Иначе
		ТекстПроНДС = НСтр("ru = 'Без налога (НДС)'");
	КонецЕсли;
	
	РеквизитыПлатежа.НазначениеПлатежа = СтрШаблон(НСтр("ru = 'Оплата по счету № %1 от %2. Сумма %3. %4.'"), 
	ДанныеПечати.Номер, 
	Формат(ДанныеПечати.ДатаДокумента, "ДФ=dd.MM.yyyy"), 
	Формат(ДанныеПечати.СуммаДокумента, "ЧЦ=15; ЧДЦ=2; ЧРД=-; ЧН=0-00; ЧГ="), 
	ТекстПроНДС);	
	
	// QR-код
	QRСтрока = УправлениеПечатьюРФ.ФорматнаяСтрокаУФЭБС(РеквизитыПлатежа);
	Если ПустаяСтрока(QRСтрока) Тогда
		Возврат Неопределено; // Возникли ошибки
	КонецЕсли;
	
	ДанныеQRКода = ГенерацияШтрихкодаВызовСервера.ДанныеQRКода(QRСтрока, 0, 190);
	Если НЕ ТипЗнч(ДанныеQRКода) = Тип("ДвоичныеДанные") Тогда
		Шаблон = Нстр("ru = 'Не удалось сформировать QR-код для документа %1.
		|Технические подробности см. в журнале регистрации.'");
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Шаблон, ДанныеПечати.Ссылка);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат ДанныеQRКода;
КонецФункции

Функция ПечатьСчетНаОплату(МассивОбъектов, ОбъектыПечати, СПечатью = Ложь, ВВалюте = Ложь) Экспорт
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.ИмяПараметровПечати 	= "ПараметрыПечати_ЗаказПокупателя_СчетНаОплату";
	ТабличныйДокумент.АвтоМасштаб			= Истина;
	
	ВыводитьАртикул = Константы.ВыводитьАртикулНоменклатурыВПечатныхФормах.Получить();
	НеВыводитьБанковскиеРеквизиты = Константы.НеВыводитьБанковскиеРеквизитыВСчетеНаОплатуБанковскойКартой.Получить();
	ВариантФормированияПФСчетаНаОплату = Константы.ВариантФормированияПФСчетаНаОплату.Получить();
	
	МенеджерОбъекта = ОбщегоНазначения.МенеджерОбъектаПоСсылке(МассивОбъектов[0]);
	
	СтруктураДанныхДляПечати = МенеджерОбъекта.ПолучитьДанныеДляПечатныхФорм(МассивОбъектов);
	ТаблицаДанныеПечати      = СтруктураДанныхДляПечати.РезультатПоШапке.Выгрузить();	
	ВыборкаПоТоварам 	 	 = СтруктураДанныхДляПечати.РезультатПоТабличнойЧастиТовары.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	МенеджерОбъекта.ДополнитьДанныеДляПечатныхФорм(ТаблицаДанныеПечати, ВыборкаПоТоварам);
	
	ПервыйДокумент = Истина;
	МакетИзменен = Ложь;
	Для Каждого ДанныеПечати Из ТаблицаДанныеПечати Цикл
		Если Не ПервыйДокумент Тогда
			// Все документы нужно выводить на разных страницах.
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		ПервыйДокумент = Ложь;
		// Запомним номер строки, с которой начали выводить текущий документ.
		НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы + 1;
		
		Макет = УправлениеПечатью.МакетПечатнойФормы("ОбщийМакет.ПФ_MXL_СчетНаОплату");
		
		//ЕстьСекция_СтрокаТабличнойЧастиТовары = Ложь;
		//ЕстьСекция_СтрокаТабличнойЧастиПредставители = Ложь;
		//ЕстьСекция_СтрокаТабличнойЧастиГрафикПлатежей = Ложь;
		
		ОбластьОтступ = Макет.ПолучитьОбласть("ОтступЗаголовка");
		ТабличныйДокумент.Вывести(ОбластьОтступ);
		
		Попытка		
			
			НачалоНовогоФормата = ТабличныйДокумент.ВысотаТаблицы;
			
			ОбластьМакета = Макет.ПолучитьОбласть("Заглавие|ЛоготипСчета");
			ОбластьМакета.Параметры.Заполнить(ДанныеПечати);
			
			ДвоичныеДанныеПодписи = ДанныеПечати.Организация.ФайлЛоготип.Файл.Получить();
			Если ЗначениеЗаполнено(ДвоичныеДанныеПодписи) Тогда
				ОбластьМакета.Рисунки.Логотип.Картинка = Новый Картинка(ДвоичныеДанныеПодписи);
			КонецЕсли;
			ТабличныйДокумент.Вывести(ОбластьМакета);			
			
			ОбластьМакета = Макет.ПолучитьОбласть("Заглавие|Информация");
			ОбластьМакета.Параметры.Заполнить(ДанныеПечати);
			
			//#11230
			ДвоичныеДанныеQRКода = Неопределено;
			ВидКонтрагента = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДанныеПечати.Контрагент, "ВидКонтрагента");
			БанкПринимаетПлатежиСБП = Ложь;
			Если ЗначениеЗаполнено(ДанныеПечати.БанковскийСчет) Тогда 
				БанкПринимаетПлатежиСБП = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДанныеПечати.БанковскийСчет, "БанкПринимаетПлатежиСБП");
			КонецЕсли;
			
			//#15702
			//Если ВидКонтрагента = Перечисления.ВидКонтрагента.ФизЛицо И БанкПринимаетПлатежиСБП Тогда
			//	ДвоичныеДанныеQRКода = QRКодРеквизитыПлатежа(ДанныеПечати);
			//КонецЕсли;			
			Если БанкПринимаетПлатежиСБП Тогда
				ДвоичныеДанныеQRКода = QRКодРеквизитыПлатежа(ДанныеПечати);
			КонецЕсли;			
			//#15702
			
			ЕстьQR = ЗначениеЗаполнено(ДвоичныеДанныеQRКода);
			
			Если Макет.Области.Найти("QRКод") <> Неопределено Тогда
				НачалоНовогоФормата = ТабличныйДокумент.ВысотаТаблицы;
				
				ОбластьИнформация = Макет.Область("Информация");
				Если НЕ ЕстьQR Тогда
					ОбластьИнформация.ШиринаКолонки = ОбластьИнформация.ШиринаКолонки + 15; //Макет.Область("QRКод").ШиринаКолонки;
				КонецЕсли;
				
				ОбластьМакета = Макет.ПолучитьОбласть("Заглавие|Информация");
				ОбластьМакета.Параметры.Заполнить(ДанныеПечати);
				
				ОбластьQR      = Макет.ПолучитьОбласть("Заглавие|QRКод");
				ОбластьРисунка = ОбластьQR.Области.Найти("РисунокQR");				
				ТабличныйДокумент.Присоединить(ОбластьМакета);				
				Если ЕстьQR И ОбластьРисунка <> Неопределено Тогда					
					ОбластьРисунка.Картинка = Новый Картинка(ДвоичныеДанныеQRКода);					
					ТабличныйДокумент.Присоединить(ОбластьQR);
				КонецЕсли;				
				//ТабличныйДокумент.Область(НачалоНовогоФормата+1,,ТабличныйДокумент.ВысотаТаблицы).СоздатьФорматСтрок();
			Иначе				
				ТабличныйДокумент.Присоединить(ОбластьМакета);				
				//ТабличныйДокумент.Область(НачалоНовогоФормата+1,,ТабличныйДокумент.ВысотаТаблицы).СоздатьФорматСтрок();
			КонецЕсли;
		Исключение
		КонецПопытки;
		
		Если НеВыводитьБанковскиеРеквизиты И НЕ ПустаяСтрока(ДанныеПечати.ИнтернетОплатаСсылка) Тогда
			//не выводим область
		Иначе
			Попытка
				ОбластьМакета = Макет.ПолучитьОбласть("ЗаголовокСчета");
				ОбластьМакета.Параметры.Заполнить(ДанныеПечати);
				ТабличныйДокумент.Вывести(ОбластьМакета);
			Исключение
			КонецПопытки;
		КонецЕсли;
		Если НЕ ПустаяСтрока(ДанныеПечати.ИнтернетОплатаСсылка) Тогда
			Попытка
				ОбластьМакета = Макет.ПолучитьОбласть("СсылкаОплатыКартой");
				ОбластьМакета.Параметры.Заполнить(ДанныеПечати);
				ТабличныйДокумент.Вывести(ОбластьМакета);
			Исключение
			КонецПопытки;
		КонецЕсли;
		Попытка
			ОбластьМакета = Макет.ПолучитьОбласть("Заголовок");
			ОбластьМакета.Параметры.Заполнить(ДанныеПечати);
			ТабличныйДокумент.Вывести(ОбластьМакета);
		Исключение
		КонецПопытки;
		Попытка
			ОбластьМакета = Макет.ПолучитьОбласть("Поставщик");
			ОбластьМакета.Параметры.Заполнить(ДанныеПечати);
			ТабличныйДокумент.Вывести(ОбластьМакета);
		Исключение
		КонецПопытки;
		Попытка
			ОбластьМакета = Макет.ПолучитьОбласть("Покупатель");
			ОбластьМакета.Параметры.Заполнить(ДанныеПечати);
			ТабличныйДокумент.Вывести(ОбластьМакета);
		Исключение
		КонецПопытки;
		
		// подготовим табличную часть в зависимости от варианта формирования ПФ счета на оплату		
		МассивДопРеквизитов = Новый Массив;
		МассивДопРеквизитов.Добавить(Новый Структура("Имя, Тип", "Артикул", 			Новый ОписаниеТипов("Строка")));
		МассивДопРеквизитов.Добавить(Новый Структура("Имя, Тип", "Вес", 				Новый ОписаниеТипов("Число")));
		МассивДопРеквизитов.Добавить(Новый Структура("Имя, Тип", "Скидка", 				Новый ОписаниеТипов("Число")));
		МассивДопРеквизитов.Добавить(Новый Структура("Имя, Тип", "СуммаБезСкидки", 		Новый ОписаниеТипов("Число")));
		МассивДопРеквизитов.Добавить(Новый Структура("Имя, Тип", "ВидНоменклатуры", 	Новый ОписаниеТипов("Число")));
		МассивДопРеквизитов.Добавить(Новый Структура("Имя, Тип", "ЕстьПотолок", 		Новый ОписаниеТипов("Число")));		
		
		ТаблицаТоварыИУслуги = ОбщийМодульСервер.ТаблицаЗначенийПоТабличнойЧастиОбъекта("ЗаказПокупателя", "Товары", МассивДопРеквизитов);
		СтруктураПоиска = Новый Структура("Ссылка", ДанныеПечати.Ссылка);		
		ВыборкаПоТоварам.Сбросить();
		
		Если ВыборкаПоТоварам.НайтиСледующий(СтруктураПоиска) Тогда			
			Выборка = ВыборкаПоТоварам.Выбрать();			
			Пока Выборка.Следующий() Цикл
				ТекущаяСтрока = ТаблицаТоварыИУслуги.Добавить();
				ЗаполнитьЗначенияСвойств(ТекущаяСтрока, Выборка);
				
				Если Справочники.ВидыНоменклатуры.ЭтоНоменклатураПотолкаИлиОтреза(ТекущаяСтрока.Номенклатура) Тогда
					ТекущаяСтрока.ВидНоменклатуры = 1;
					ТекущаяСтрока.Потолок = ТекущаяСтрока.Номенклатура;
				ИначеЕсли Справочники.ВидыНоменклатуры.ЭтоНоменклатураУслуга(ТекущаяСтрока.Номенклатура) Тогда
					ТекущаяСтрока.ВидНоменклатуры = 3;
				Иначе
					ТекущаяСтрока.ВидНоменклатуры = 2;
				КонецЕсли;
				Если ТекущаяСтрока.Потолок.Пустая() Тогда
					ТекущаяСтрока.ЕстьПотолок = 2;
				Иначе
					ТекущаяСтрока.ЕстьПотолок = 1;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
		//0. Потолок - товар - услуга - потолок - товар - услуга
		//1. Потолок, Потолок, Товары, Товары, услуги, услуги
		//2. Потолок - потолок - товар (все одинаковые позиции сворачиваются). - услуга (все одинаковые позиции сворачиваются) 
		//3. Без группировок
		Если ВариантФормированияПФСчетаНаОплату = 0 Тогда
			ТаблицаТоварыИУслуги.Сортировать("ЕстьПотолок, Потолок, ВидНоменклатуры");		
		ИначеЕсли ВариантФормированияПФСчетаНаОплату = 1 Тогда
			ТаблицаТоварыИУслуги.Сортировать("ВидНоменклатуры");
		ИначеЕсли ВариантФормированияПФСчетаНаОплату = 2 Тогда
			ТаблицаТоварыИУслуги.Свернуть("Артикул, Номенклатура, ЕдиницаИзмерения, Коэффициент, Цена, ПроцентРучнойСкидки, Скидка, ВидНоменклатуры, ХарактеристикаНоменклатуры", "Количество, Сумма, СуммаБезСкидки");
			ТаблицаТоварыИУслуги.Сортировать("ВидНоменклатуры")
		ИначеЕсли ВариантФормированияПФСчетаНаОплату = 3 Тогда
			//не сортируем
		КонецЕсли;
		
		//Вычислим есть ли скидки, наценки нас не интересуют
		ЕстьСкидки = Ложь;
		Для Каждого ТекущаяСтрока Из ТаблицаТоварыИУслуги Цикл
			Если ТекущаяСтрока.Сумма < ТекущаяСтрока.СуммаБезСкидки Тогда
				ЕстьСкидки = Истина;
				Прервать; //Дальше идти нет смысла
			КонецЕсли;	
		КонецЦикла;
		
		Если НЕ МакетИзменен Тогда
			Если НЕ ЕстьСкидки Тогда
				//без скидки
				// уменьшим
				Если НЕ ВВалюте Тогда
					Макет.Область("Товар").ШиринаКолонки = Макет.Область("Товар").ШиринаКолонки + 24;
					Макет.Область("Сумма").ШиринаКолонки = 4;
					МакетИзменен = Истина;
				КонецЕсли
			КонецЕсли;
			
			// увеличим колонку товар, если не выводим артикул
			Если НЕ ВыводитьАртикул Тогда
				Макет.Область("Товар").ШиринаКолонки = Макет.Область("Товар").ШиринаКолонки + 8;
				МакетИзменен = Истина;
			КонецЕсли;
		КонецЕсли;
		
		Суффикс = "";
		Если ДанныеПечати.ОрганизацияЯвляетсяПлательщикомНДС Тогда
			Суффикс = "НДС";	
		КонецЕсли;
		Если ЕстьСкидки Тогда
			Суффикс = Суффикс + "СоСкидкой";
		КонецЕсли;
		
		Попытка
			
			ОбластьМакета = ?(ВВалюте, Макет.ПолучитьОбласть("ШапкаТаблицыВалюта|НомерСтроки"), ?(ЕстьСкидки, Макет.ПолучитьОбласть("ШапкаТаблицыСоСкидкой|НомерСтроки"), Макет.ПолучитьОбласть("ШапкаТаблицы|НомерСтроки")));
			ОбластьМакета.Параметры.Заполнить(ДанныеПечати);
			ТабличныйДокумент.Вывести(ОбластьМакета);
			
			Если ВыводитьАртикул Тогда
				ОбластьМакета = ?(ВВалюте, Макет.ПолучитьОбласть("ШапкаТаблицыВалюта|Артикул"), ?(ЕстьСкидки, Макет.ПолучитьОбласть("ШапкаТаблицыСоСкидкой|Артикул"), Макет.ПолучитьОбласть("ШапкаТаблицы|Артикул")));
				ОбластьМакета.Параметры.Заполнить(ДанныеПечати);
				ТабличныйДокумент.Присоединить(ОбластьМакета);
			КонецЕсли;
			
			ОбластьМакета = ?(ВВалюте, Макет.ПолучитьОбласть("ШапкаТаблицыВалюта|Данные"), ?(ЕстьСкидки, Макет.ПолучитьОбласть("ШапкаТаблицыСоСкидкой|Данные"), Макет.ПолучитьОбласть("ШапкаТаблицы|Данные")));
			ОбластьМакета.Параметры.Заполнить(ДанныеПечати);
			ТабличныйДокумент.Присоединить(ОбластьМакета);
			
			ОбластьМакета = ?(ВВалюте, Макет.ПолучитьОбласть("ШапкаТаблицыВалюта|Сумма"), ?(ЕстьСкидки, Макет.ПолучитьОбласть("ШапкаТаблицыСоСкидкой|Сумма"), Макет.ПолучитьОбласть("ШапкаТаблицы|Сумма")));
			ОбластьМакета.Параметры.Заполнить(ДанныеПечати);
			ТабличныйДокумент.Присоединить(ОбластьМакета);
			
		Исключение
		КонецПопытки;
		
		НомерСтроки = 1;
		Попытка
			Для Каждого ТекущаяСтрока Из ТаблицаТоварыИУслуги Цикл
				
				ОбластьМакета = ?(ВВалюте, Макет.ПолучитьОбласть("СтрокаВалюта|НомерСтроки"), ?(ЕстьСкидки, Макет.ПолучитьОбласть("СтрокаСоСкидкой|НомерСтроки"), Макет.ПолучитьОбласть("Строка|НомерСтроки")));
				ОбластьМакета.Параметры.Заполнить(ДанныеПечати);
				ОбластьМакета.Параметры.Заполнить(ТекущаяСтрока);
				ОбластьМакета.Параметры.НомерСтроки = НомерСтроки;
				ТабличныйДокумент.Вывести(ОбластьМакета);
				
				Если ВыводитьАртикул Тогда
					ОбластьМакета = ?(ВВалюте, Макет.ПолучитьОбласть("СтрокаВалюта|Артикул"), ?(ЕстьСкидки, Макет.ПолучитьОбласть("СтрокаСоСкидкой|Артикул"), Макет.ПолучитьОбласть("Строка|Артикул")));
					ОбластьМакета.Параметры.Заполнить(ДанныеПечати);
					ОбластьМакета.Параметры.Заполнить(ТекущаяСтрока);
					ТабличныйДокумент.Присоединить(ОбластьМакета);
				КонецЕсли;	
				
				ОбластьМакета = ?(ВВалюте, Макет.ПолучитьОбласть("СтрокаВалюта|Данные"), ?(ЕстьСкидки, Макет.ПолучитьОбласть("СтрокаСоСкидкой|Данные"), Макет.ПолучитьОбласть("Строка|Данные")));
				ОбластьМакета.Параметры.Заполнить(ДанныеПечати);
				ОбластьМакета.Параметры.Заполнить(ТекущаяСтрока);
				//++ №12909
				//ПредставлениеНоменклатуры = Строка(ТекущаяСтрока.Номенклатура) + Строка(УправлениеПечатью.ПредставлениеХарактеристики(ТекущаяСтрока.ХарактеристикаНоменклатуры));
				ПредставлениеНоменклатуры = ОбщийМодульСервер.ПредставлениеНоменклатурыДляПечати(ТекущаяСтрока.Номенклатура, ТекущаяСтрока.ХарактеристикаНоменклатуры);
				//-- №12909
				ОбластьМакета.Параметры.ПредставлениеНоменклатуры = ПредставлениеНоменклатуры;
				//Наценки не отражаем в ПФ
				Если ТекущаяСтрока.СуммаБезСкидки < ТекущаяСтрока.Сумма Тогда						
					ОбластьМакета.Параметры.Цена = Окр(ТекущаяСтрока.Сумма / ?(ТекущаяСтрока.Количество > 0, ТекущаяСтрока.Количество, 1), 2);
				КонецЕсли;
				
				Если ВариантФормированияПФСчетаНаОплату = 0 И ТекущаяСтрока.ВидНоменклатуры = 1 Тогда
					ОбластьМакета.ТекущаяОбласть = ОбластьМакета.Область(1,1,1,1);
					ШрифтПотолка = Новый Шрифт (ОбластьМакета.ТекущаяОбласть.Шрифт,,,Истина);
					ОбластьМакета.ТекущаяОбласть.Шрифт = ШрифтПотолка;
				КонецЕсли;
				ТабличныйДокумент.Присоединить(ОбластьМакета);
				
				ОбластьМакета = ?(ВВалюте, Макет.ПолучитьОбласть("СтрокаВалюта|Сумма"), ?(ЕстьСкидки, Макет.ПолучитьОбласть("СтрокаСоСкидкой|Сумма"), Макет.ПолучитьОбласть("Строка|Сумма")));
				ОбластьМакета.Параметры.Заполнить(ДанныеПечати);
				ОбластьМакета.Параметры.Заполнить(ТекущаяСтрока);
				
				Если ТекущаяСтрока.СуммаБезСкидки < ТекущаяСтрока.Сумма И ЕстьСкидки Тогда
					ОбластьМакета.Параметры.СуммаБезСкидки = ТекущаяСтрока.Сумма;
					ОбластьМакета.Параметры.Скидка = 0;
				КонецЕсли;
				ТабличныйДокумент.Присоединить(ОбластьМакета);
				
				НомерСтроки = НомерСтроки + 1;
			КонецЦикла;
		Исключение
		КонецПопытки;
		
		//подвал
		Попытка
			ОбластьМакета = Макет.ПолучитьОбласть("ИтогоКОплате" + Суффикс + "|НомерСтроки");
			ОбластьМакета.Параметры.Заполнить(ДанныеПечати);
			ТабличныйДокумент.Вывести(ОбластьМакета);
			
			Если ВыводитьАртикул Тогда
				ОбластьМакета = Макет.ПолучитьОбласть("ИтогоКОплате" + Суффикс + "|Артикул");
				ОбластьМакета.Параметры.Заполнить(ДанныеПечати);
				ТабличныйДокумент.Присоединить(ОбластьМакета);
			КонецЕсли;
			
			ОбластьМакета = Макет.ПолучитьОбласть("ИтогоКОплате" + Суффикс + "|Данные");
			ОбластьМакета.Параметры.Заполнить(ДанныеПечати);
			ТабличныйДокумент.Присоединить(ОбластьМакета);
			
			ОбластьМакета = Макет.ПолучитьОбласть("ИтогоКОплате" + Суффикс + "|Сумма");
			ОбластьМакета.Параметры.Заполнить(ДанныеПечати);
			Попытка
				Если ДанныеПечати.ОрганизацияЯвляетсяПлательщикомНДС И ДанныеПечати.ИтогоСуммаНДС = 0 Тогда			
					ОбластьМакета.Параметры.ИтогоСуммаНДС = "-";
				КонецЕсли;
			Исключение
			КонецПопытки;
			ТабличныйДокумент.Присоединить(ОбластьМакета);
		Исключение
		КонецПопытки;
		
		Попытка 
			ОбластьМакета = Макет.ПолучитьОбласть("СтрокаВсегоИПрописью");
			ОбластьМакета.Параметры.Заполнить(ДанныеПечати);
			Попытка
				ОбластьМакета.Параметры.КолвоПозиций = НомерСтроки - 1;
				ОбластьМакета.Параметры.СуммаДокументаПрописью = 
				РаботаСВалютой.СформироватьЧислоПрописьюВсп(ДанныеПечати.СуммаДокумента, ДанныеПечати.Валюта, "Л=ru_RU;ДП=Ложь");
			Исключение
			КонецПопытки;		
			ТабличныйДокумент.Вывести(ОбластьМакета);
		Исключение
		КонецПопытки;
		Если НЕ СПечатью Тогда
			Попытка 
				ОбластьМакета = Макет.ПолучитьОбласть("ПодвалСчета");
				ОбластьМакета.Параметры.Заполнить(ДанныеПечати);
				ТабличныйДокумент.Вывести(ОбластьМакета);
			Исключение
			КонецПопытки;
		Иначе
			
			Попытка 
				Если Макет.Области.Найти("ПодвалСчетаСПечатью") <> Неопределено Тогда
					ОбластьМакета = Макет.ПолучитьОбласть("ПодвалСчетаСПечатью");
					ОбластьМакета.Параметры.Заполнить(ДанныеПечати);
					
					ДвоичныеДанныеПодписи = ДанныеПечати.Организация.ФайлПечать.Файл.Получить();
					Если ЗначениеЗаполнено(ДвоичныеДанныеПодписи) Тогда
						ОбластьМакета.Рисунки.Печать.Картинка = Новый Картинка(ДвоичныеДанныеПодписи);
					КонецЕсли;	
					ДвоичныеДанныеПодписи = ДанныеПечати.Организация.ФайлПодписьРуководителя.Файл.Получить();
					Если ЗначениеЗаполнено(ДвоичныеДанныеПодписи) Тогда
						ОбластьМакета.Рисунки.ПодписьРуководителя.Картинка = Новый Картинка(ДвоичныеДанныеПодписи);
					КонецЕсли;
					ДвоичныеДанныеПодписи = ДанныеПечати.Организация.ФайлПодписьГлавногоБухгалтера.Файл.Получить();
					Если ЗначениеЗаполнено(ДвоичныеДанныеПодписи) Тогда
						ОбластьМакета.Рисунки.ПодписьГлавногоБухгалтера.Картинка = Новый Картинка(ДвоичныеДанныеПодписи);
					КонецЕсли;
					
					ТабличныйДокумент.Вывести(ОбластьМакета);				
				КонецЕсли;	
			Исключение
			КонецПопытки;
		КонецЕсли;
		
		// В табличном документе необходимо задать имя области, в которую был 
		// выведен объект. Нужно для возможности печати комплектов документов.
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабличныйДокумент, 
		НомерСтрокиНачало, ОбъектыПечати, ДанныеПечати.Ссылка);
	КонецЦикла;
	Возврат ТабличныйДокумент;
	
КонецФункции

// в валюте учета
Функция ПолучитьТекущийДолгКлиента(Знач Период=Неопределено, Знач Организация=Неопределено, Знач Контрагент=Неопределено, Знач Договор=Неопределено) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Период",			?(Период=Неопределено, ТекущаяДатаСеанса(), Период));
	Запрос.УстановитьПараметр("Организация",	Организация);
	Запрос.УстановитьПараметр("Контрагент",		Контрагент);
	Запрос.УстановитьПараметр("Договор",		Договор);
	
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВзаиморасчетыСКонтрагентамиОстатки.СуммаОстаток КАК СуммаОстаток
	|ИЗ
	|	РегистрНакопления.ВзаиморасчетыСКонтрагентами.Остатки(
	|			&Период,
	|			ВЫБОР
	|					КОГДА НЕ &Организация = НЕОПРЕДЕЛЕНО
	|						ТОГДА Организация = &Организация
	|					ИНАЧЕ ИСТИНА
	|				КОНЕЦ
	|				И ВЫБОР
	|					КОГДА НЕ &Контрагент = НЕОПРЕДЕЛЕНО
	|						ТОГДА Контрагент = &Контрагент
	|					ИНАЧЕ ИСТИНА
	|				КОНЕЦ
	|				И ВЫБОР
	|					КОГДА НЕ &Договор = Договор
	|						ТОГДА Договор = &Договор
	|					ИНАЧЕ ИСТИНА
	|				КОНЕЦ) КАК ВзаиморасчетыСКонтрагентамиОстатки";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.СуммаОстаток;
	КонецЕсли;
	
	Возврат 0;
	
КонецФункции

// в валюте учета
Функция ПолучитьОстатокПоЗаказамПокупателей(Знач Период, Знач Организация=Неопределено, Знач Контрагент=Неопределено) Экспорт
	
	ВалютаУчета = ПолучитьФункциональнуюОпцию("ВалютаУчета");	
	Период = ?(Период=Неопределено, ТекущаяДатаСеанса(), Период);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Период",			Период);
	Запрос.УстановитьПараметр("Организация",	Организация);
	Запрос.УстановитьПараметр("Контрагент",		Контрагент);
	
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СУММА(ЗаказыПокупателейОстатки.СуммаОстаток) КАК СуммаОстаток,
	|	ВЫРАЗИТЬ(ЗаказыПокупателейОстатки.ЗаказНаПроизводство КАК Документ.ЗаказПокупателя).Валюта КАК Валюта
	|ИЗ
	|	РегистрНакопления.ЗаказыПокупателей.Остатки(
	|			&Период,
	|			ЗаказНаПроизводство ССЫЛКА Документ.ЗаказПокупателя
	|				И НЕ ВЫРАЗИТЬ(ЗаказНаПроизводство КАК Документ.ЗаказПокупателя).ТекущийСтатус = ЗНАЧЕНИЕ(Справочник.СтатусыЗаказовПокупателей.Новый)
	|				И ВЫБОР
	|					КОГДА НЕ &Организация = НЕОПРЕДЕЛЕНО
	|						ТОГДА Организация = &Организация
	|					ИНАЧЕ ИСТИНА
	|				КОНЕЦ
	|				И ВЫБОР
	|					КОГДА НЕ &Контрагент = НЕОПРЕДЕЛЕНО
	|						ТОГДА Контрагент = &Контрагент
	|					ИНАЧЕ ИСТИНА
	|				КОНЕЦ) КАК ЗаказыПокупателейОстатки
	|
	|СГРУППИРОВАТЬ ПО
	|	ВЫРАЗИТЬ(ЗаказыПокупателейОстатки.ЗаказНаПроизводство КАК Документ.ЗаказПокупателя).Валюта";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Результат = 0;
	Пока Выборка.Следующий() Цикл
		Результат = Результат + РаботаСВалютой.ПересчитатьИзВалютыВВалюту(Выборка.Валюта, ВалютаУчета, Период, Выборка.СуммаОстаток);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьВариантыФормированияПФЗаказаПокупателя() Экспорт
	ВариантыФормирования = Новый СписокЗначений;
	
	//0. Потолок - товар - услуга - потолок - товар - услуга
	//1. Потолок, Потолок, Товары, Товары, услуги, услуги
	//2. Потолок - потолок - товар (все одинаковые позиции сворачиваются). - услуга (все одинаковые позиции сворачиваются) 	
	//3. Без группировок
	ВариантыФормирования.Добавить(0, "Группировка товаров по потолкам");
