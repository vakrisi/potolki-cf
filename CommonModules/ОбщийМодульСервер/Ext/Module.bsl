#Область ПроверкаКратности

//#2792, 16345 
Процедура ПроверитьКратностьЕдиницИзмерения(Отказ, ДокументОбъектСтруктураСтроки, ВидДокумента, ИмяПоляКоличество="") Экспорт
	
	Если НЕ НастройкаПользователя("РазрешитьНесоответствиеКратностиЕдиницИзмерения") Тогда
		
		ПредставлениеТаблицы = "";
		ПолеДанныхПрефикс = "Объект.";
		
		Если ТипЗнч(ДокументОбъектСтруктураСтроки) = Тип("ДанныеФормыСтруктура") Тогда
			// вызывается из ОбработкаПроверкиЗаполненияНаСервере, когда передается Объект
			ДокументОбъект = ДокументОбъектСтруктураСтроки;
			
			ИмяТЧ = "Товары";
			ПредставлениеТаблицы = "Товары";
			//#16345
			Если ВидДокумента = Перечисления.ВидыДокументовПроверкиКратности.ПредварительныйРасчет
				ИЛИ ВидДокумента = Перечисления.ВидыДокументовПроверкиКратности.ЗаказКлиента
				ИЛИ ВидДокумента = Перечисления.ВидыДокументовПроверкиКратности.РеализацияКлиенту Тогда
				ИмяТЧ = "ТоварыУслуги";
				ПредставлениеТаблицы = "Товары и услуги";
			КонецЕсли;
			//nva+++
			Если ИмяПоляКоличество <> "" Тогда
				ТаблицаТоваров = ДокументОбъект[ИмяТЧ].Выгрузить(, "НомерСтроки, Номенклатура, ЕдиницаИзмерения, " + ИмяПоляКоличество);
				ТаблицаТоваров.Колонки[ИмяПоляКоличество].Имя = "Количество";
			Иначе
				ТаблицаТоваров = ДокументОбъект[ИмяТЧ].Выгрузить(, "НомерСтроки, Номенклатура, ЕдиницаИзмерения, Количество");
			КонецЕсли;	
			//nva---
			ТаблицаТоваров.Колонки.Добавить("ИмяТаблицы", Новый ОписаниеТипов("Строка"));
			ТаблицаТоваров.ЗаполнитьЗначения("Товары", "ИмяТаблицы");
			
			Если ВидДокумента = Перечисления.ВидыДокументовПроверкиКратности.РеализацияТоваровИУслуг Тогда
				Для каждого СтрокаТЧ из ДокументОбъект.Услуги Цикл
					НоваяСтрока = ТаблицаТоваров.Добавить();
					ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТЧ);
					НоваяСтрока.ИмяТаблицы = "Услуги";
				КонецЦикла;
			КонецЕсли;
		Иначе
			// вызывается из КоличествоПриИзмененииНаСервере, когда передается структура со данным строки
			ТаблицаТоваров = Новый ТаблицаЗначений;
			ТаблицаТоваров.Колонки.Добавить("НомерСтроки", Новый ОписаниеТипов("Число"));
			ТаблицаТоваров.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
			МассивТипов = Новый Массив;
			МассивТипов.Добавить(Тип("СправочникСсылка.ЕдиницыИзмерений"));
			МассивТипов.Добавить(Тип("СправочникСсылка.КлассификаторЕдиницИзмерения"));
			ТаблицаТоваров.Колонки.Добавить("ЕдиницаИзмерения", Новый ОписаниеТипов(МассивТипов));
			ТаблицаТоваров.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число"));
			ТаблицаТоваров.Колонки.Добавить("ИмяТаблицы", Новый ОписаниеТипов("Строка"));
			НоваяСтрока = ТаблицаТоваров.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ДокументОбъектСтруктураСтроки);
			
			ПредставлениеТаблицы = ?(ДокументОбъектСтруктураСтроки.Свойство("ПредставлениеТаблицы"), ДокументОбъектСтруктураСтроки.ПредставлениеТаблицы, ДокументОбъектСтруктураСтроки.ИмяТаблицы);
			ПолеДанныхПрефикс = ?(ДокументОбъектСтруктураСтроки.Свойство("ПолеДанныхПрефикс"), ДокументОбъектСтруктураСтроки.ПолеДанныхПрефикс, ПолеДанныхПрефикс);
			
		КонецЕсли;
		
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("ТаблицаТоваров", ТаблицаТоваров);
		Запрос.УстановитьПараметр("ВидДокумента", ВидДокумента);
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТаблицаТоваров.ИмяТаблицы КАК ИмяТаблицы,
		|	ТаблицаТоваров.НомерСтроки КАК НомерСтроки,
		|	ТаблицаТоваров.Номенклатура КАК Номенклатура,
		|	ТаблицаТоваров.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
		|	ТаблицаТоваров.Количество КАК Количество
		|ПОМЕСТИТЬ ВТ_ТаблицаТоваров
		|ИЗ
		|	&ТаблицаТоваров КАК ТаблицаТоваров
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВТ.ИмяТаблицы КАК ИмяТаблицы,
		|	ВТ.НомерСтроки КАК НомерСтроки,
		|	ВТ.Номенклатура КАК Номенклатура,
		|	ВТ.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
		|	ВТ.Количество КАК Количество,
		|	ВТ.Количество / Кратности.Кратность КАК Частное,
		|	Кратности.Кратность КАК Кратность,
		|	ВЫБОР
		|		КОГДА ВТ.Количество / Кратности.Кратность = (ВЫРАЗИТЬ(ВТ.Количество / Кратности.Кратность - 0.5 КАК ЧИСЛО(15, 0)))
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК КратностьСоответствует
		|ИЗ
		|	ВТ_ТаблицаТоваров КАК ВТ
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Номенклатура.Кратность КАК Кратности
		|		ПО (Кратности.Ссылка = ВТ.Номенклатура)
		|			И (Кратности.ЕдиницаИзмерения = ВТ.ЕдиницаИзмерения)
		|			И (Кратности.ВидДокумента = &ВидДокумента)
		|ГДЕ
		|	НЕ ВТ.Количество / Кратности.Кратность = (ВЫРАЗИТЬ(ВТ.Количество / Кратности.Кратность - 0.5 КАК ЧИСЛО(15, 0)))
		|	И ВТ.Количество <> 0";
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Пока Выборка.Следующий() Цикл
			ПредставлениеТаблицыВСообщении = ?(ПустаяСтрока(ПредставлениеТаблицы), Выборка.ИмяТаблицы, ПредставлениеТаблицы);
			ТекстСообщения = СтрШаблон("В таблице ""%1"" в строке %2(%3) выбранное количество не соответствует заданной кратности.", 
										ПредставлениеТаблицыВСообщении, 
										?(Выборка.НомерСтроки = 0, "", Выборка.НомерСтроки), 
										Выборка.Номенклатура); 
			
			МинКратное = Цел(Выборка.Частное);
			МаксКратное = Окр(Выборка.Частное + 0.5, 0, 0);
			Если МинКратное = 0 Тогда
				ТекстСообщения = ТекстСообщения + СтрШаблон(" Рекомендуемое значение: %1 (%2)", Формат(МаксКратное * Выборка.Кратность, "ЧДЦ=2"), МаксКратное);	
			Иначе
				ТекстСообщения = ТекстСообщения + СтрШаблон(" Рекомендуемые значения: %1 (%2) или %3 (%4)", Формат(МинКратное * Выборка.Кратность, "ЧДЦ=2"), МинКратное, Формат(МаксКратное * Выборка.Кратность, "ЧДЦ=2"), МаксКратное);
			КонецЕсли;
			
			//ПолеДанных = "Объект." + Выборка.ИмяТаблицы + "[" + Формат(Выборка.НомерСтроки - 1, "ЧГ=") + "].Количество";
			Если ЗначениеЗаполнено(ИмяПоляКоличество) Тогда //nva
				ПолеДанных = ПолеДанныхПрефикс + Выборка.ИмяТаблицы + "[" + Формат(Выборка.НомерСтроки - 1, "ЧГ=") + "]." + ИмяПоляКоличество;//nva	
			Иначе	//nva
				ПолеДанных = ПолеДанныхПрефикс + Выборка.ИмяТаблицы + "[" + Формат(Выборка.НомерСтроки - 1, "ЧГ=") + "].Количество";
			КонецЕсли;//nva	
			
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, , ПолеДанных, , Отказ);
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

// Функция создает пустую таблицу значений по метаданным табличной части объекта
//    ИмяОбъекта - строка
//    ИмяТабличнойЧасти - строка
//    МассивДополнительныхРеквизитов - массив структур вида "Новый Структура("Имя, Тип", "ИмяДобавляемогоПоля", Новый ОписаниеТипов("Число"))"
Функция ТаблицаЗначенийПоТабличнойЧастиОбъекта(ИмяОбъекта, ИмяТабличнойЧасти, МассивДополнительныхРеквизитов = Неопределено) Экспорт
	
	Таблица = Новый ТаблицаЗначений;
	Для Каждого Реквизит Из Метаданные.Документы[ИмяОбъекта].ТабличныеЧасти[ИмяТабличнойЧасти].Реквизиты Цикл
		Таблица.Колонки.Добавить(Реквизит.Имя, Реквизит.Тип);	
	КонецЦикла;
	Таблица.Колонки.Добавить("НомерСтроки", Новый ОписаниеТипов("Число"));
	
	Если НЕ МассивДополнительныхРеквизитов = Неопределено Тогда
		Для Каждого Реквизит Из МассивДополнительныхРеквизитов Цикл
			Таблица.Колонки.Добавить(Реквизит.Имя, Реквизит.Тип);	
		КонецЦикла;
	КонецЕсли;
	
	Возврат Таблица;
	
КонецФункции

Функция ПроверитьНаличиеДругихЗаказовПоЛиду(ЛидСсылка, ЗаказСсылка) Экспорт
	
	Если НЕ ЗначениеЗаполнено(ЛидСсылка) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	ЗаказДоговор.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ЗаказДоговор КАК ЗаказДоговор
	|ГДЕ
	|	НЕ ЗаказДоговор.ПометкаУдаления
	|	И ЗаказДоговор.Основание = &Лид
	|	И ЗаказДоговор.Основание ССЫЛКА Документ.Лид
	|	И НЕ ЗаказДоговор.Ссылка = &Заказ";
	
	Запрос.УстановитьПараметр("Лид", ЛидСсылка);
	Запрос.УстановитьПараметр("Заказ", ЗаказСсылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат НЕ РезультатЗапроса.Пустой();
	
КонецФункции

//++ №11556
Процедура УстановитьВидимостьКомандыВывестиСписокВСпискахЛидов(Форма, ЭтоАРМ = Ложь) Экспорт
	
	// Убираем видимость только если нет роли "АРМ менеджера розницы (вывод списка лидов в табличный документ)"
	Если РольДоступна("АРММенеджераРозницыВыводСпискаЛидов") Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого Элемент Из Форма.Элементы Цикл
		
		ИмяЭлемента = НРег(Элемент.Имя);
		
		// У списков отключаем множественный выбор
		Если ТипЗнч(Элемент) = Тип("ТаблицаФормы")
			И (СтрНайти(ИмяЭлемента, "лиды") > 0 Или Не ЭтоАРМ) // из основных списков не нужно проверять имя элемента "Лиды"
			Тогда
			Элемент.РежимВыделения = РежимВыделенияТаблицы.Одиночный;
		КонецЕсли;
		
		// Отключаем кнопку "Вывести список"
		Если ТипЗнч(Элемент) = Тип("КнопкаФормы")
			И СтрНайти(ИмяЭлемента, "вывестисписок") > 0
			И (СтрНайти(ИмяЭлемента, "лиды") > 0 Или Не ЭтоАРМ) // из основных списков не нужно проверять имя элемента "Лиды"
			Тогда
			Элемент.Видимость = Ложь;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры
