Функция ПараметрыЗаданияРасчетаКоличестваСтатусаЛидов(ЭтоНовый, 
													  ПредыдущийАвтор, ТекущийАвтор,
													  ПредыдущийСтатус, ТекущийСтатус,
													  ПредыдущаяДатаСледующегоКонтакта, ДатаСледующегоКонтакта
													  ) Экспорт
													  
	ПараметрыЗадания = Новый Структура;
	ПараметрыЗадания.Вставить("ЭтоНовый", ЭтоНовый);
	ПараметрыЗадания.Вставить("ПредыдущийАвтор", ПредыдущийАвтор);
	ПараметрыЗадания.Вставить("ТекущийАвтор", ТекущийАвтор);
	ПараметрыЗадания.Вставить("ПредыдущийСтатус", ПредыдущийСтатус);
	ПараметрыЗадания.Вставить("ТекущийСтатус", ТекущийСтатус);
	ПараметрыЗадания.Вставить("ПредыдущаяДатаСледующегоКонтакта", ПредыдущаяДатаСледующегоКонтакта);
	ПараметрыЗадания.Вставить("ДатаСледующегоКонтакта", ДатаСледующегоКонтакта);

	Возврат ПараметрыЗадания;
	
КонецФункции													 
																		 
Процедура РасчетКоличестваЛидовРегламентноеЗадание() Экспорт
	
	ОбщегоНазначения.ПриНачалеВыполненияРегламентногоЗадания(Метаданные.РегламентныеЗадания.РасчетКоличестваЛидов);
	
	Отбор = Новый Структура;
	Отбор.Вставить("Ключ", Метаданные.РегламентныеЗадания.РасчетКоличестваЛидов.Ключ);
	Отбор.Вставить("Состояние", СостояниеФоновогоЗадания.Активно);
	ТекущиеФоновыеЗадания = ФоновыеЗадания.ПолучитьФоновыеЗадания(Отбор);
	
	Если ТекущиеФоновыеЗадания.Количество() < 2 Тогда // РЗ имеет такой же ключ как и ФЗ, поэтому тоже учитывается.
		
		ФоновыеЗадания.Выполнить(
			"ОбщийМодульСервер.РасчетКоличестваЛидовВФоне",
			Новый Массив(),
			Метаданные.РегламентныеЗадания.РасчетКоличестваЛидов.Ключ,
			НСтр("ru = 'Выполняется расчет количества лидов'"));
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПроверитьЗапуститьФоновоеЗаданиеРасчетаКоличестваЛидов(ПараметрыЗадания) Экспорт

	//Если БлокироватьРасчетКоличестваЛидов() Тогда
	//	Возврат;
	//КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	
	Отбор = Новый Структура;
	Отбор.Вставить("Ключ", Метаданные.РегламентныеЗадания.РасчетКоличестваЛидов.Ключ);
	Отбор.Вставить("Состояние", СостояниеФоновогоЗадания.Активно);
	ТекущиеФоновыеЗадания = ФоновыеЗадания.ПолучитьФоновыеЗадания(Отбор);
	
	Если ТекущиеФоновыеЗадания.Количество() = 0 Тогда
		
		Попытка
			
			ПараметрыЗаданияМассив = Новый Массив;
			ПараметрыЗаданияМассив.Добавить(ПараметрыЗадания);
			 
			ФоновыеЗадания.Выполнить(
				"ОбщийМодульСервер.РасчетКоличестваЛидовВФоне",
				ПараметрыЗаданияМассив,
				Метаданные.РегламентныеЗадания.РасчетКоличестваЛидов.Ключ,
				НСтр("ru = 'Выполняется расчет количества лидов'"));
		Исключение
			// Если задание уже запущено.
		КонецПопытки;
		
	КонецЕсли;
	
КонецПроцедуры

// для кнопок в РМ менеджера розницы
Процедура РасчетКоличестваЛидовВФоне(ПараметрыЗадания) Экспорт
	
	Если ТипЗнч(ПараметрыЗадания) = Тип("Структура") Тогда
		Если ПараметрыЗадания.ЭтоНовый Тогда
			РасчетКоличестваЛидовПоАвтору(Справочники.Пользователи.ПустаяСсылка());
			РасчетКоличестваЛидовПоАвтору(ПараметрыЗадания.ТекущийАвтор);
			
		ИначеЕсли НЕ ПараметрыЗадания.ПредыдущийАвтор = ПараметрыЗадания.ТекущийАвтор Тогда
			РасчетКоличестваЛидовПоАвтору(Справочники.Пользователи.ПустаяСсылка());
			РасчетКоличестваЛидовПоАвтору(ПараметрыЗадания.ПредыдущийАвтор);
			РасчетКоличестваЛидовПоАвтору(ПараметрыЗадания.ТекущийАвтор);
			
		Иначе
			РасчетКоличестваЛидовПоАвтору(Справочники.Пользователи.ПустаяСсылка());
			РасчетКоличестваЛидовПоАвтору(ПараметрыЗадания.ТекущийАвтор);
			
		КонецЕсли;
	Иначе
		// общие показатели
		РасчетКоличестваЛидовПоАвтору(Справочники.Пользователи.ПустаяСсылка());
		ВыборкаПользователей = Справочники.Пользователи.Выбрать();
		Пока ВыборкаПользователей.Следующий() Цикл
			Если ВыборкаПользователей.ПометкаУдаления 
				ИЛИ ВыборкаПользователей.Недействителен	Тогда
				Продолжить;
			КонецЕсли;
			
			Если ВыборкаПользователей.ОтображатьТолькоСвоиЛидыВСписке 
				ИЛИ ВыборкаПользователей.ОграничитьВидимостьЛидовПоТочкамПродаж				
				ИЛИ ВыборкаПользователей.ОграничиватьДоступПоОрганизациям
				ИЛИ ВыборкаПользователей.ОграничениеДоступаКЛидамДляЗамерщика
				ИЛИ ВыборкаПользователей.ОграничитьДоступКЛидамПоСтатусуЛида													  
				Тогда
				РасчетКоличестваЛидовПоАвтору(ВыборкаПользователей.Ссылка);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

Процедура РасчетКоличестваЛидовПоАвтору(Автор)

	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц; //дл отладки
	Запрос.УстановитьПараметр("Сегодня", НачалоДня(ТекущаяДатаСеанса()));
	Запрос.УстановитьПараметр("Завтра", НачалоДня(ТекущаяДатаСеанса()+60*60*24));
	Запрос.УстановитьПараметр("ФильтрПоАвтору", ЗначениеЗаполнено(Автор));
	Запрос.УстановитьПараметр("Автор", Автор);
	Если ЗначениеЗаполнено(Автор) Тогда
		// надо учесть все ограничения из RLS
		РеквизитыПользователя = НастройкиПользователя("ОтображатьТолькоСвоиЛидыВСписке, ОграничитьВидимостьЛидовПоТочкамПродаж, ОграничиватьДоступПоОрганизациям,
													  |ОграничениеДоступаКЛидамДляЗамерщика, ОграничитьДоступКЛидамПоСтатусуЛида, Сотрудник", 
													  Автор);
		
		Запрос.УстановитьПараметр("ОграничиватьПоАвтору", 		РеквизитыПользователя.ОтображатьТолькоСвоиЛидыВСписке);
		Запрос.УстановитьПараметр("ОграничиватьПоОрганизации", 	РеквизитыПользователя.ОграничиватьДоступПоОрганизациям);
		Запрос.УстановитьПараметр("ОграничиватьПоТП", 			РеквизитыПользователя.ОграничитьВидимостьЛидовПоТочкамПродаж);
		Запрос.УстановитьПараметр("ОграничиватьПоСтатусу", 		РеквизитыПользователя.ОграничитьДоступКЛидамПоСтатусуЛида);
		Запрос.УстановитьПараметр("ОграничиватьДляЗамерщика", 	РеквизитыПользователя.ОграничениеДоступаКЛидамДляЗамерщика);
		Запрос.УстановитьПараметр("Сотрудник", 					РеквизитыПользователя.Сотрудник);
		
	Иначе
		Запрос.УстановитьПараметр("ОграничиватьПоАвтору", 		Ложь);
		Запрос.УстановитьПараметр("ОграничиватьПоОрганизации", 	Ложь);
		Запрос.УстановитьПараметр("ОграничиватьПоТП", 			Ложь);
		Запрос.УстановитьПараметр("ОграничиватьПоСтатусу", 		Ложь);
		Запрос.УстановитьПараметр("ОграничиватьДляЗамерщика", 	Ложь);
		Запрос.УстановитьПараметр("Сотрудник", 					Неопределено);
	КонецЕсли;

	Запрос.Текст = 	
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЛидыВыездыЗамеры.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ ВТ_ЗамерыВыезды
	|ИЗ
	|	(ВЫБРАТЬ
	|		ЛидВыезды.Ссылка КАК Ссылка
	|	ИЗ
	|		Документ.Лид.Выезды КАК ЛидВыезды
	|	ГДЕ
	|		ЛидВыезды.Ссылка.Проведен
	|		И НАЧАЛОПЕРИОДА(ЛидВыезды.Дата, ДЕНЬ) = &Сегодня
	|		И ЛидВыезды.Результат = ЗНАЧЕНИЕ(Справочник.РезультатыВыездаЛида.пустаяСсылка)
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		ЛидЗамеры.Ссылка
	|	ИЗ
	|		Документ.Лид.Замеры КАК ЛидЗамеры
	|	ГДЕ
	|		ЛидЗамеры.Ссылка.Проведен
	|		И НАЧАЛОПЕРИОДА(ЛидЗамеры.ДатаЗамера, ДЕНЬ) = &Сегодня
	|		И ЛидЗамеры.РезультатЗамера = ЗНАЧЕНИЕ(Справочник.РезультатЗамераЛида.пустаяСсылка)) КАК ЛидыВыездыЗамеры
	|
