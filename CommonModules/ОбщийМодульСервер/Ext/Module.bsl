//++ №13455
Функция ПолучитьНомерВерсииЧислом(Версия, Порядок = 999) Экспорт
	
	// Числовое значение версии, формируется как:
	// НОМЕР_ВЕРСИИ+XXX_НОМЕР_ПОДВЕРСИИ+YYY_НОМЕР_РЕЛИЗА+ZZZ_ВНУТРЕННИЙ_ПОРЯДОК_ОБЪЕКТА
	// где:
	//	- XXX_НОМЕР_ПОДВЕРСИИ - дополненная нулями до трёх знаков номер подверсии
	//	- YYY_НОМЕР_РЕЛИЗА - дополненная нулями до трёх знаков номер релиза, примеры:
	//	- ZZZ_ВНУТРЕННИЙ_ПОРЯДОК_ОБЪЕКТА - дополненная нулями до трёх знаков очередь, если она вдруг нужна, внутри релиза
	//	  (например внутри релиза обязательно сначала надо обработать ЗД, а потом монтажи, тогда для ЗД ZZZ_ВНУТРЕННИЙ_ПОРЯДОК_ОБЪЕКТА = 001,
	//	  а для монтажей ZZZ_ВНУТРЕННИЙ_ПОРЯДОК_ОБЪЕКТА = 002. Если для объекта внутри релиза порядок обработки не важен, обязательно присваивать ZZZ_ВНУТРЕННИЙ_ПОРЯДОК_ОБЪЕКТА = 999
	
	// На входе ожидаем версию в формате 2.8.12.0
	МассивЧисел = СтрРазделить(Версия, ".", Ложь);
	
	Если НЕ МассивЧисел.Количество() = 4 Тогда
		Возврат 0;
	КонецЕсли;
	
	// Первые три числа используем для формирования версии числом
	
	Попытка
		ВерсияЧислом = Число(СтрШаблон("%1%2%3%4",
		МассивЧисел[0], 									// номер версии
		Формат(Число(МассивЧисел[1]), 	"ЧЦ=3; ЧН=; ЧВН="), // номер подверсии
		Формат(Число(МассивЧисел[2]), 	"ЧЦ=3; ЧН=; ЧВН="), // номер релиза
		Формат(Порядок, 				"ЧЦ=3; ЧН=; ЧВН=") 	// порядок
		));
	Исключение
		ВерсияЧислом = 0;
	КонецПопытки;
	
	Возврат ВерсияЧислом;
	
КонецФункции
//-- №13455

//++ #13710
Процедура ПроверитьИзменениеВзаиморасчетовПередЗаписью(ДокументОбъект, РежимЗаписи) Экспорт
	
	ИмяРеквизитаСумма = "СуммаДокумента";
	Если ТипЗнч(ДокументОбъект) = Тип("ДокументОбъект.ОплатаБанковскойКартой") 
		ИЛИ ТипЗнч(ДокументОбъект) = Тип("ДокументОбъект.ПриходныйКассовыйОрдер")	
		ИЛИ ТипЗнч(ДокументОбъект) = Тип("ДокументОбъект.РасходныйКассовыйОрдер")
		ИЛИ ТипЗнч(ДокументОбъект) = Тип("ДокументОбъект.ПоступлениеНаРасчетныйСчет")
		ИЛИ ТипЗнч(ДокументОбъект) = Тип("ДокументОбъект.СписаниеСРасчетногоСчета")
		Тогда
		ИмяРеквизитаСумма = "Сумма";	
	КонецЕсли;
	ПоляДокумента = "Дата, Проведен, ПометкаУдаления, " + ИмяРеквизитаСумма;
	
	ПредыдущиеДанныеДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументОбъект.Ссылка, ПоляДокумента); // если документ новый, то данные будут = Неопределено
	
	ДокументОбъект.ДополнительныеСвойства.Вставить("Дата",  	ПредыдущиеДанныеДокумента.Дата);
	ДокументОбъект.ДополнительныеСвойства.Вставить("Проведен",  ПредыдущиеДанныеДокумента.Проведен);
	ДокументОбъект.ДополнительныеСвойства.Вставить("ПометкаУдаления",  ПредыдущиеДанныеДокумента.ПометкаУдаления);
	ДокументОбъект.ДополнительныеСвойства.Вставить("Сумма", 	ПредыдущиеДанныеДокумента[ИмяРеквизитаСумма]);
	ДокументОбъект.ДополнительныеСвойства.Вставить("ИмяРеквизитаСумма", 	ИмяРеквизитаСумма);
	
	Если ТипЗнч(ДокументОбъект) = Тип("ДокументОбъект.СоглашениеОРасторженииДоговора") Тогда
		ДокументОбъект.ДополнительныеСвойства.Вставить("Контрагент", ДокументОбъект.ЗаказДоговор.Контрагент);	
	КонецЕсли;
	
КонецПроцедуры

Процедура ПроверитьИзменениеВзаиморасчетовПриЗаписи(Знач ДокументОбъект, Отказ) Экспорт
	
	//#9989
	Если НЕ Отказ И ПолучитьФункциональнуюОпцию("ОтправлятьДетализациюВзаиморасчетовПриИзмененииВзаиморасчетов") Тогда
		
		ДополнительныеСвойства = ДокументОбъект.ДополнительныеСвойства;
		
		ПредыдущийПериод = Неопределено;
		ПредыдущаяСумма = 0;
		ПредыдущееСостояниеПроведен = Неопределено;
		//ПредыдущаяПометкаУдаления = Неопределено;
		ИмяРеквизитаСумма = "СуммаДокумента";
		Если НЕ ДополнительныеСвойства.Свойство("Дата", ПредыдущийПериод) 
			ИЛИ НЕ ДополнительныеСвойства.Свойство("Сумма", ПредыдущаяСумма) 
			ИЛИ НЕ ДополнительныеСвойства.Свойство("Проведен", ПредыдущееСостояниеПроведен)
			//ИЛИ НЕ ДополнительныеСвойства.Свойство("ПометкаУдаления", ПредыдущаяПометкаУдаления)
			ИЛИ НЕ ДополнительныеСвойства.Свойство("ИмяРеквизитаСумма", ИмяРеквизитаСумма)
			Тогда
			Возврат;
		КонецЕсли;
		
		// для новых документов
		ПредыдущееСостояниеПроведен = ?(ПредыдущееСостояниеПроведен = Неопределено, Ложь, ПредыдущееСостояниеПроведен);
		//ПредыдущаяПометкаУдаления = ?(ПредыдущаяПометкаУдаления = Неопределено, Ложь, ПредыдущаяПометкаУдаления);
		
		ИзменилсяРежимПроведения = (ПредыдущееСостояниеПроведен И НЕ ДополнительныеСвойства.РежимЗаписи = РежимЗаписиДокумента.Проведение) 
		ИЛИ (НЕ ПредыдущееСостояниеПроведен И ДополнительныеСвойства.РежимЗаписи = РежимЗаписиДокумента.Проведение);
		
		ИзменилисьРеквизиты = НЕ ДокументОбъект.Дата = ПредыдущийПериод ИЛИ НЕ ДокументОбъект[ИмяРеквизитаСумма] = ПредыдущаяСумма; 		
		
		Контрагент = ?(ДополнительныеСвойства.Свойство("Контрагент"), ДополнительныеСвойства.Контрагент, ДокументОбъект.Контрагент);
		
		Если ИзменилсяРежимПроведения
			ИЛИ (ДополнительныеСвойства.РежимЗаписи = РежимЗаписиДокумента.Проведение И ИзменилисьРеквизиты)
			Тогда
			
			МенеджерЗаписи = РегистрыСведений.ЗаданияНаОтправкуЭлектронныхПисем.СоздатьМенеджерЗаписи();
			МенеджерЗаписи.Документ 	= ДокументОбъект.Ссылка;
			МенеджерЗаписи.ВидЗадания 	= Перечисления.ВидыЗаданийНаОтправкуЭлектронныхПисем.ОтправкаДетализацииВзаиморасчетов;
			МенеджерЗаписи.Прочитать();
			Если НЕ МенеджерЗаписи.Выбран() Тогда
				МенеджерЗаписи.Документ 	= ДокументОбъект.Ссылка;
				МенеджерЗаписи.ВидЗадания 	= Перечисления.ВидыЗаданийНаОтправкуЭлектронныхПисем.ОтправкаДетализацииВзаиморасчетов;
				МенеджерЗаписи.Организация 	= ДокументОбъект.Организация;
				МенеджерЗаписи.Контрагент 	= Контрагент;
				МенеджерЗаписи.Записать();
			КонецЕсли;
			
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры
