//++ №11160
Функция ПолучитьТекстЗапросаРазрешеннаяНоменклатураРозницы() Экспорт
	
	ТекстЗапроса = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	РазрешеннаяНоменклатураРозницы.Номенклатура КАК Группа
	|ПОМЕСТИТЬ ВТ_РазрешенныеГруппы
	|ИЗ
	|	РегистрСведений.РазрешеннаяНоменклатураРозницы КАК РазрешеннаяНоменклатураРозницы
	|ГДЕ
	|	РазрешеннаяНоменклатураРозницы.Номенклатура.ЭтоГруппа
	|	И РазрешеннаяНоменклатураРозницы.Назначение = &Назначение
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ДанныеСправочника.Ссылка КАК Номенклатура
	|ПОМЕСТИТЬ ВТ_РазрешеннаяНоменклатураРозницы
	|ИЗ
	|	Справочник.Номенклатура КАК ДанныеСправочника
	|ГДЕ
	|	ДанныеСправочника.Ссылка В ИЕРАРХИИ
	|			(ВЫБРАТЬ
	|				РазрешенныеГруппы.Группа
	|			ИЗ
	|				ВТ_РазрешенныеГруппы КАК РазрешенныеГруппы)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	РазрешеннаяНоменклатураРозницы.Номенклатура
	|ИЗ
	|	РегистрСведений.РазрешеннаяНоменклатураРозницы КАК РазрешеннаяНоменклатураРозницы
	|ГДЕ
	|	НЕ РазрешеннаяНоменклатураРозницы.Номенклатура.ЭтоГруппа
	|	И РазрешеннаяНоменклатураРозницы.Назначение = &Назначение
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ДанныеСправочника.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Номенклатура КАК ДанныеСправочника
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_РазрешеннаяНоменклатураРозницы КАК РазрешеннаяНоменклатураРозницы
	|		ПО ДанныеСправочника.Ссылка = РазрешеннаяНоменклатураРозницы.Номенклатура
	|ГДЕ
	|	ДанныеСправочника.Ссылка В(&МассивНоменклатуры)
	|	И ДанныеСправочника.ВидНоменклатуры В (ЗНАЧЕНИЕ(Справочник.ВидыНоменклатуры.Материал), ЗНАЧЕНИЕ(Справочник.ВидыНоменклатуры.Услуга))
	|	И РазрешеннаяНоменклатураРозницы.Номенклатура ЕСТЬ NULL";
	
	Возврат ТекстЗапроса;
	
КонецФункции
