#Область ПроцедурыИФункцииПриРаботеСФайлами

Процедура ОбновитьСписокФайлов(Форма, СписокСсылок) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ПрикрепленныеДанные.Период КАК Период,
	|	ПрикрепленныеДанные.ВидФайлаПрограммыПостроителя КАК ВидФайлаПрограммыПостроителя,
	|	ПрикрепленныеДанные.СсылкаНаОбъект КАК ТекущаяСсылка,
	//|	ВЫБОР
	//|		КОГДА ПрикрепленныеДанные.СсылкаНаОбъект ССЫЛКА Справочник.Номенклатура
	//|			ТОГДА &ЭтотДокумент
	//|		ИНАЧЕ ПрикрепленныеДанные.СсылкаНаОбъект
	//|	КОНЕЦ КАК СсылкаНаОбъект,
	|	ПрикрепленныеДанные.СсылкаНаОбъект КАК СсылкаНаОбъект,
	|	ВЫБОР
	|		КОГДА ПрикрепленныеДанные.СсылкаНаОбъект ССЫЛКА Справочник.Номенклатура
	|			ТОГДА ПрикрепленныеДанные.СсылкаНаОбъект
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	|	КОНЕЦ КАК Номенклатура,
	|	ПрикрепленныеДанные.ИмяФайла КАК ИмяФайла,
	|	ПрикрепленныеДанные.Расширение КАК Расширение,
	|	ПрикрепленныеДанные.ИмяФайла + ""."" + ПрикрепленныеДанные.Расширение КАК НаименованиеФайла,
	|	ПрикрепленныеДанные.Период КАК ДатаПрикрепления,
	|	ВЫБОР
	|		КОГДА ПрикрепленныеДанные.СсылкаНаОбъект ССЫЛКА Документ.Лид
	|			ТОГДА 1
	|		КОГДА ПрикрепленныеДанные.СсылкаНаОбъект ССЫЛКА Документ.ЗаказДоговор
	|			ТОГДА 2
	|		КОГДА ПрикрепленныеДанные.СсылкаНаОбъект ССЫЛКА Документ.Монтаж
	|			ТОГДА 3
	|		ИНАЧЕ 4
	|	КОНЕЦ КАК Сортировка,
	|	ВЫБОР
	|		КОГДА ПрикрепленныеДанные.Расширение = ""txt""
	|			ТОГДА 10
	|		КОГДА ПрикрепленныеДанные.Расширение = ""doc""
	|			ТОГДА 18
	|		КОГДА ПрикрепленныеДанные.Расширение = ""xls""
	|			ТОГДА 20
	|		КОГДА ПрикрепленныеДанные.Расширение = ""jpg""
	|				ИЛИ ПрикрепленныеДанные.Расширение = "".jpeg""
	|			ТОГДА 42
	|		КОГДА ПрикрепленныеДанные.Расширение = ""bmp""
	|			ТОГДА 44
	|		КОГДА ПрикрепленныеДанные.Расширение = ""gif""
	|			ТОГДА 48
	|		КОГДА ПрикрепленныеДанные.Расширение = ""png""
	|			ТОГДА 50
	|		КОГДА ПрикрепленныеДанные.Расширение = ""pdf""
	|			ТОГДА 52
	|		КОГДА ПрикрепленныеДанные.Расширение = ""docx""
	|			ТОГДА 68
	|		КОГДА ПрикрепленныеДанные.Расширение = ""xlsx""
	|			ТОГДА 70
	|		ИНАЧЕ 76
	|	КОНЕЦ КАК Картинка
	|ИЗ
	|	РегистрСведений.ПрикрепленныеДанные КАК ПрикрепленныеДанные
	|ГДЕ
	|	ПрикрепленныеДанные.СсылкаНаОбъект В(&СписокСсылок)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Сортировка";
	Запрос.УстановитьПараметр("СписокСсылок", СписокСсылок);
	//Запрос.УстановитьПараметр("ЭтотДокумент", ЭтотОбъект.Объект.Ссылка);
	
	ТаблицаФайлов = Запрос.Выполнить().Выгрузить();
	ТаблицаДокументов = ТаблицаФайлов.Скопировать(, "СсылкаНаОбъект");
	ТаблицаДокументов.Свернуть("СсылкаНаОбъект");	
	
	КоличествоФайлов = 0;	
	Дерево = ДанныеФормыВЗначение(Форма.ФайлыДерево, Тип("ДеревоЗначений"));
	Для Каждого ТекущийДокумент из ТаблицаДокументов Цикл
		
		КореньДерева = Дерево.Строки.Добавить();
		КореньДерева.Документ = ТекущийДокумент.СсылкаНаОбъект;
		КореньДерева.СинонимОбъекта = ТекущийДокумент.СсылкаНаОбъект.Метаданные().Синоним;
		Если Метаданные.Документы.Содержит(ТекущийДокумент.СсылкаНаОбъект.Метаданные()) Тогда
			КореньДерева.СинонимОбъекта = КореньДерева.СинонимОбъекта + " " + ТекущийДокумент.СсылкаНаОбъект.Номер;
		КонецЕсли;
		КореньДерева.Картинка = 2;
		Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Форма, "Объект")
			И ТекущийДокумент.СсылкаНаОбъект = Форма.Объект.Ссылка Тогда
			КореньДерева.ЭтотДокумент = Истина;
		КонецЕсли;
		
		//Найдем все файлы по текущему документу
		НайденныеФайлы = ТаблицаФайлов.НайтиСтроки(Новый Структура("СсылкаНаОбъект", ТекущийДокумент.СсылкаНаОбъект));
		Для Каждого ТекущаяСтрока Из НайденныеФайлы Цикл
			ПодчиненнаяСтрока = КореньДерева.Строки.Добавить();
			ЗаполнитьЗначенияСвойств(ПодчиненнаяСтрока, ТекущаяСтрока);
			ПодчиненнаяСтрока.Документ = ТекущийДокумент.СсылкаНаОбъект;
			ПодчиненнаяСтрока.ПодчиненнаяСтрока = Истина;
			ПодчиненнаяСтрока.СсылкаНаОбъект = ТекущаяСтрока.ТекущаяСсылка;
			
			КоличествоФайлов = КоличествоФайлов + 1;
		КонецЦикла;
		
	КонецЦикла;	
	ЗначениеВДанныеФормы(Дерево, Форма.ФайлыДерево);
	
	Если НЕ Форма.Элементы.Найти("ТаблицаФайлы") = Неопределено Тогда
		Если КоличествоФайлов > 0 Тогда
			Форма.Элементы.ТаблицаФайлы.Заголовок = "Файлы (" + КоличествоФайлов + ")";
		Иначе
			Форма.Элементы.ТаблицаФайлы.Заголовок = "Файлы";
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры	

Функция ПолучитьИмяФайлаПрикрепленныхДанных(СсылкаНаОбъект, Знач ЗагружаемоеИмяФайла, Знач Расширение) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ПрикрепленныеДанные.ИмяФайла КАК ИмяФайла
	|ИЗ
	|	РегистрСведений.ПрикрепленныеДанные КАК ПрикрепленныеДанные
	|ГДЕ
	|	ПрикрепленныеДанные.СсылкаНаОбъект = &СсылкаНаОбъект
	|	И ПрикрепленныеДанные.Расширение = &Расширение
	|	И ПрикрепленныеДанные.ИмяФайла ПОДОБНО &ИмяФайла
	|
	|УПОРЯДОЧИТЬ ПО
	|	ПрикрепленныеДанные.Период УБЫВ";
	
	Запрос.УстановитьПараметр("СсылкаНаОбъект", СсылкаНаОбъект);
	Запрос.УстановитьПараметр("ИмяФайла", 		ЗагружаемоеИмяФайла + "%");
	Запрос.УстановитьПараметр("Расширение", 	Расширение);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	//Если таких имен нет для файла, сразу возвращаем и дальше не идем
	Если Выборка.Количество() = 0 Тогда
		Возврат ЗагружаемоеИмяФайла;
	КонецЕсли;
	
	//присваиваем новый номер	
	//Если имя одно, то сразу присваиваем номер 1
	Если Выборка.Количество() = 1 Тогда
		Возврат ЗагружаемоеИмяФайла + "-1";
	КонецЕсли;
	
	//Если несколько выбираем последнее по дате и пытаемся нарастить
	МассивНомеров = Новый Массив;
	Пока Выборка.Следующий() Цикл	
		ПозДефис = СтрНайти(Выборка.ИмяФайла, "-", НаправлениеПоиска.СКонца);
		ДлинаСтроки = СтрДлина(Выборка.ИмяФайла);
		Если ПозДефис > 0 И ПозДефис < ДлинаСтроки Тогда
			ЧислоСтрокой = Прав(Выборка.ИмяФайла, ДлинаСтроки - ПозДефис);
			нЧисло = -1;
			Попытка
				нЧисло = Число(ЧислоСтрокой);
			Исключение
			КонецПопытки;
			Если НЕ нЧисло = -1 Тогда
				МассивНомеров.Добавить(нЧисло);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Если МассивНомеров.Количество() = 0 Тогда
		Возврат ЗагружаемоеИмяФайла + "-1";	
	КонецЕсли;
	
	ЗначениеМаксимальногоЭлемента = 0;
	Для Индекс = 0 По МассивНомеров.Количество() - 1 Цикл
		Если МассивНомеров[Индекс] > ЗначениеМаксимальногоЭлемента Тогда
			ЗначениеМаксимальногоЭлемента = МассивНомеров[Индекс];
		КонецЕсли;
	КонецЦикла;
	
	Возврат ЗагружаемоеИмяФайла + "-" + Формат(ЗначениеМаксимальногоЭлемента+1, "ЧДЦ=; ЧГ=");
	
КонецФункции

