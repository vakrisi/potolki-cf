//#16643
Процедура ОжидаемыеПоставки_УдалитьЗаписиПоЗаказу(ЗаказПоставщику) Экспорт
		
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ЗаказПоставщику", ЗаказПоставщику);
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ДанныеРегистра.ЗаказПоставщику КАК ЗаказПоставщику,
	|	ДанныеРегистра.Склад КАК Склад,
	|	ДанныеРегистра.Номенклатура КАК Номенклатура,
	|	ДанныеРегистра.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры
	|ИЗ
	|	РегистрСведений.ОжидаемыеПоставкиТоваров КАК ДанныеРегистра
	|ГДЕ
	|	ДанныеРегистра.ЗаказПоставщику = &ЗаказПоставщику";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		МенеджерЗаписи = РегистрыСведений.ОжидаемыеПоставкиТоваров.СоздатьМенеджерЗаписи();
		ЗаполнитьЗначенияСвойств(МенеджерЗаписи, Выборка);
		МенеджерЗаписи.Прочитать();
		МенеджерЗаписи.Удалить();
	КонецЦикла;
	
КонецПроцедуры

Процедура ОжидаемыеПоставки_Рассчитать(ЗаказПоставщику) Экспорт

	// Заказ поставщику: Приход +
	// Поступление:      Расход +
	// Возврат:          Расход -

	УстановитьПривилегированныйРежим(Истина);
	
	// удаляем все записи, будем формирвать новые
	ОжидаемыеПоставки_УдалитьЗаписиПоЗаказу(ЗаказПоставщику);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ЗаказПоставщику", ЗаказПоставщику);
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЗаказыПоставщикам.ЗаказПоставщику КАК ЗаказПоставщику,
	|	ЗаказыПоставщикам.ЗаказПоставщику.Склад КАК Склад,
	|	ЗаказыПоставщикам.Номенклатура КАК Номенклатура,
	|	ЗаказыПоставщикам.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	|	ЗаказыПоставщикам.КоличествоПриход КАК Заказано
	|ПОМЕСТИТЬ ВТ_Заказано
	|ИЗ
	|	РегистрНакопления.ЗаказыПоставщикам.Обороты(, , Авто, ЗаказПоставщику = &ЗаказПоставщику) КАК ЗаказыПоставщикам
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЗаказыПоставщикам.ЗаказПоставщику КАК ЗаказПоставщику,
	|	ЗаказыПоставщикам.Регистратор.Склад КАК Склад,
	|	ЗаказыПоставщикам.Номенклатура КАК Номенклатура,
	|	ЗаказыПоставщикам.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	|	ЗаказыПоставщикам.КоличествоРасход КАК Получено
	|ПОМЕСТИТЬ ВТ_Получено
	|ИЗ
	|	РегистрНакопления.ЗаказыПоставщикам.Обороты(, , Регистратор, ЗаказПоставщику = &ЗаказПоставщику) КАК ЗаказыПоставщикам
	|ГДЕ
	|	НЕ ЗаказыПоставщикам.КоличествоРасход = 0
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВТ_Заказано.ЗаказПоставщику КАК ЗаказПоставщику,
	|	ВТ_Заказано.Склад КАК Склад,
	|	ВТ_Заказано.Номенклатура КАК Номенклатура,
	|	ВТ_Заказано.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	|	ЛОЖЬ КАК Обработано,
	|	СУММА(ВТ_Заказано.Заказано) КАК Заказано
	|ИЗ
	|	ВТ_Заказано КАК ВТ_Заказано
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_Заказано.ЗаказПоставщику,
	|	ВТ_Заказано.Склад,
	|	ВТ_Заказано.Номенклатура,
	|	ВТ_Заказано.ХарактеристикаНоменклатуры
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВТ_Получено.ЗаказПоставщику КАК ЗаказПоставщику,
	|	ВТ_Получено.Склад КАК Склад,
	|	ВТ_Получено.Номенклатура КАК Номенклатура,
	|	ВТ_Получено.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	|	ЛОЖЬ КАК Обработано,
	|	СУММА(ВТ_Получено.Получено) КАК Получено
	|ИЗ
	|	ВТ_Получено КАК ВТ_Получено
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_Получено.ЗаказПоставщику,
	|	ВТ_Получено.Склад,
	|	ВТ_Получено.Номенклатура,
	|	ВТ_Получено.ХарактеристикаНоменклатуры";
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	// при проведении записи уже будут
	ТаблицаЗаказано = РезультатЗапроса[2].Выгрузить();
	ТаблицаПолучено = РезультатЗапроса[3].Выгрузить();
	
	ТаблицаРезультата = Новый ТаблицаЗначений;
	ТаблицаРезультата.Колонки.Добавить("ЗаказПоставщику", 			 Новый ОписаниеТипов("ДокументСсылка.ЗаказПоставщику"));
	ТаблицаРезультата.Колонки.Добавить("Склад", 					 Новый ОписаниеТипов("СправочникСсылка.Склады"));
	ТаблицаРезультата.Колонки.Добавить("Номенклатура", 				 Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ТаблицаРезультата.Колонки.Добавить("ХарактеристикаНоменклатуры", Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры"));
	
	ТаблицаРезультата.Колонки.Добавить("Заказано", 					 Новый ОписаниеТипов("Число", , , Новый КвалификаторыЧисла(15, 2)));
	ТаблицаРезультата.Колонки.Добавить("ОсталосьПолучить", 			 Новый ОписаниеТипов("Число", , , Новый КвалификаторыЧисла(15, 2)));
	
	Для каждого СтрокаТЗ из ТаблицаПолучено Цикл
		СтруктураПоиска = Новый Структура("ЗаказПоставщику, Склад, Номенклатура, ХарактеристикаНоменклатуры, Обработано");
		ЗаполнитьЗначенияСвойств(СтруктураПоиска, СтрокаТЗ);
		//СтруктураПоиска.Обработано = Ложь;
		
		НС = ТаблицаЗаказано.НайтиСтроки(СтруктураПоиска);
		Если НС.Количество() > 0 Тогда
			НоваяСтрока = ТаблицаРезультата.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТЗ);
			НоваяСтрока.Заказано         = НС[0].Заказано;
			НоваяСтрока.ОсталосьПолучить = НоваяСтрока.Заказано - СтрокаТЗ.Получено;
			
			НС[0].Обработано = Истина;
		Иначе
			// попробуем найти без склада
			СтруктураПоиска.Склад = Справочники.Склады.ПустаяСсылка();
			НС = ТаблицаЗаказано.НайтиСтроки(СтруктураПоиска);
			Если НС.Количество() > 0 Тогда
				НоваяСтрока = ТаблицаРезультата.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТЗ);
				НоваяСтрока.Заказано         = НС[0].Заказано;
				НоваяСтрока.ОсталосьПолучить = НоваяСтрока.Заказано - СтрокаТЗ.Получено;
				
				// если заказ без склада, то поступление может быть на разные склады
				// в заказе оставляем остаток, в регистр пишем часть полученного
				Если НоваяСтрока.ОсталосьПолучить > 0 И СтрокаТЗ.Получено > 0 Тогда
					НС[0].Заказано 		 = НоваяСтрока.ОсталосьПолучить; 					
					НоваяСтрока.Заказано = СтрокаТЗ.Получено;
					НоваяСтрока.ОсталосьПолучить = 0;
				Иначе
					НС[0].Обработано = Истина;
				КонецЕсли;
			Иначе
				// строки, у которых измерения различаются
				НоваяСтрока = ТаблицаРезультата.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТЗ);
				НоваяСтрока.Заказано         = 0;
				НоваяСтрока.ОсталосьПолучить = НоваяСтрока.Заказано - СтрокаТЗ.Получено;				
			КонецЕсли;
		КонецЕсли;		
	КонецЦикла;
	
	// строки заказа, по которым нет поступлений
	Для каждого СтрокаТЗ из ТаблицаЗаказано Цикл
		Если СтрокаТЗ.Обработано Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока = ТаблицаРезультата.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТЗ);
		НоваяСтрока.Заказано         = СтрокаТЗ.Заказано;
		НоваяСтрока.ОсталосьПолучить = НоваяСтрока.Заказано;
	КонецЦикла;
	
	// делаем записи
	Для каждого СтрокаТЗ из ТаблицаРезультата Цикл		
		МенеджерЗаписи = РегистрыСведений.ОжидаемыеПоставкиТоваров.СоздатьМенеджерЗаписи();
		ЗаполнитьЗначенияСвойств(МенеджерЗаписи, СтрокаТЗ);
		МенеджерЗаписи.Записать();
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ОбработкаЗаполненияМенеджера(Форма, МетаданныеДокумента, Менеджер) Экспорт
	
	Если МетаданныеДокумента = Метаданные.Документы.Лид Тогда
		//#5596
		ЗначениеНастройки = Константы.АвтоматическиЗаполнятьМенеджераВЛиде.Получить();
	ИначеЕсли МетаданныеДокумента = Метаданные.Документы.ЗаказПокупателя Тогда
		//#16334
		ЗначениеНастройки = Константы.АвтоматическиЗаполнятьМенеджераВЗаказеПокупателя.Получить();
	ИначеЕсли МетаданныеДокумента = Метаданные.Документы.Монтаж Тогда
		//#16334
		ЗначениеНастройки = Константы.АвтоматическиЗаполнятьМенеджераВМонтаже.Получить();
	Иначе
		Возврат;		
	КонецЕсли;
		
	Если ЗначениеНастройки
		И НЕ Форма.Параметры.Ключ.Пустая()
		И НЕ Форма.ТолькоПросмотр
		И ПравоДоступа("Изменение", МетаданныеДокумента)
		И НЕ ЗначениеЗаполнено(Форма.Объект.Менеджер)
		И ЗначениеЗаполнено(Менеджер)
		Тогда
		Форма.Объект.Менеджер = Менеджер;
		Форма.ИзмененМенеджер = Истина;		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

Функция ЕстьЗапретИзмененияДанных(ДатаДокумента) Экспорт
	
	ДействующиеДаты = ДатыЗапретаИзмененияСлужебный.ДействующиеДатыЗапрета();
	
	ДанныеДляПроверки = Новый ТаблицаЗначений;	
	ДанныеДляПроверки.Колонки.Добавить("Раздел");
	ДанныеДляПроверки.Колонки.Добавить("Объект");
	ДанныеДляПроверки.Колонки.Добавить("Дата", Новый ОписаниеТипов("Дата", , , Новый КвалификаторыДаты(ЧастиДаты.Дата)));
	
	Для каждого Строка из ДействующиеДаты.ИсточникиДанных Цикл 
		Для каждого СтрокаРаздела из Строка.Значение.Состав Цикл			
			НоваяСтрока = ДанныеДляПроверки.Добавить();
			НоваяСтрока.Раздел = СтрокаРаздела.Раздел;
			НоваяСтрока.Объект = НоваяСтрока.Раздел;
			НоваяСтрока.Дата = ДатаДокумента; 		
		КонецЦикла;		
	КонецЦикла;
	ДанныеДляПроверки.Свернуть("Раздел,Объект,Дата");	
	
	ДанныеИДаты = Новый Структура;
	ДанныеИДаты.Вставить("ДействующиеДаты",   ДействующиеДаты);
	ДанныеИДаты.Вставить("ДанныеДляПроверки", ДанныеДляПроверки);
	
	Возврат ДатыЗапретаИзменения.НайденЗапретИзмененияДанных(ДанныеДляПроверки);
	
КонецФункции

Функция ОбновитьЭлементыФормыПоследовательностьСебестоимости(Форма, Знач ВыводитьТекстОшибкиВосстановления = Ложь, МоментВремениДокумента = Неопределено, ИспользуютсяЭлементыВПорядке = Истина) Экспорт
	
	Результат = Ложь;
	
	Если ОбщийМодуль.ПоследовательностьПоСебестоимостиНарушена() Тогда
		ГраницаПоследовательности = ОбщийМодуль.ПолучитьГраницуПоследовательностиПоСебестоимости();
		
		//#9062 переделано на форматированную строку
		
		//ТекстОшибки = "Для корректного расчёта себестоимости все документы должны проводиться строго в хронологическом порядке." + Символы.ПС 
		//+ "В базе имеются документы, которые были проведены или изменены задним числом, что привело к нарушению хронологии последовательности." + Символы.ПС 
		//+ "Последний документ, до которого себестоимость посчитана правильно: " + Символы.ПС + ГраницаПоследовательности + Символы.ПС 
		//+ "Для перепроведения документов в хронологическом порядке (для пересчета себестоимости) нажмите на кнопку ""Восстановить""."+ Символы.ПС 
		//+ "Если система не сможет какой-то документ провести автоматически, восстановление последовательности будет остановлено." + Символы.ПС 
		//+ "Необходимо такой документ исправить, провести вручную и повторно запустить восстановление последовательности.";
		
		//Если ВыводитьТекстОшибкиВосстановления Тогда
		//	УстановитьПривилегированныйРежим(Истина);
		//	ТекстОшибкиВосстановления = РегламентныеЗаданияСлужебный.СообщенияИОписанияОшибокРегламентногоЗадания(РегламентныеЗадания.НайтиПредопределенное(Метаданные.РегламентныеЗадания.ВосстановлениеПоследовательностиПоСебестоимостиТоваров));
		//	ТекстОшибки = ТекстОшибки + Символы.ПС + Символы.ПС
		//	+ ?(ПустаяСтрока(ТекстОшибкиВосстановления),"", "Ошибка, полученная в результате последнего автоматического запуска восстановления последовательности: " + ТекстОшибкиВосстановления);
		//КонецЕсли;
		
		//Форма.Элементы.ДекорацияНарушенаПоследовательность.Заголовок = ТекстОшибки;
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	СебестоимостьЗапасов.Регистратор КАК ПроблемныйРегистратор,
		|	СебестоимостьЗапасовГраницы.Регистратор КАК УспешныйРегистратор
		|ИЗ
		|	Последовательность.СебестоимостьЗапасов КАК СебестоимостьЗапасов
		|		ЛЕВОЕ СОЕДИНЕНИЕ Последовательность.СебестоимостьЗапасов.Границы КАК СебестоимостьЗапасовГраницы
		|		ПО (ИСТИНА)
		|ГДЕ
		|	СебестоимостьЗапасов.МоментВремени > СебестоимостьЗапасовГраницы.МоментВремени
		//#14513
		|	И СебестоимостьЗапасов.Регистратор.Проведен
		|
		|УПОРЯДОЧИТЬ ПО
		|	СебестоимостьЗапасов.МоментВремени";
		
		Выборка = Запрос.Выполнить().Выбрать();
		ПроблемныйРегистратор = Неопределено;
		УспешныйРегистратор = ГраницаПоследовательности.Ссылка;
		Если Выборка.Следующий() Тогда
			ПроблемныйРегистратор = Выборка.ПроблемныйРегистратор;
			УспешныйРегистратор   = Выборка.УспешныйРегистратор;	
		КонецЕсли;
		
		ШрифтСообщения = Новый Шрифт(,,Истина);
		ЦветСообщения = WebЦвета.Красный;
		ЦветУспешногоДокумента = WebЦвета.ЗеленыйЛес;
		ЦветПроблемногоДокумента = WebЦвета.ТемноКрасный;
		ФормСтрока1 = Новый ФорматированнаяСтрока("Для корректного расчёта себестоимости все документы должны проводиться строго в хронологическом порядке. 
		|В базе имеются документы, которые были проведены или изменены задним числом, что привело к нарушению хронологии последовательности.", ШрифтСообщения, ЦветСообщения);  
		ФормСтрока2 = Новый ФорматированнаяСтрока("Последний документ, до которого себестоимость посчитана правильно: ", ШрифтСообщения, ЦветСообщения);
		ФормСтрока3 = Новый ФорматированнаяСтрока(Строка(УспешныйРегистратор), ШрифтСообщения, ЦветУспешногоДокумента, , ПолучитьНавигационнуюСсылку(УспешныйРегистратор));
		ФормСтрока4 = Новый ФорматированнаяСтрока("Документ, на котором остановилось восстановление последовательности: ", ШрифтСообщения, ЦветСообщения);
		ФормСтрока5 = Новый ФорматированнаяСтрока(Строка(ПроблемныйРегистратор), ШрифтСообщения, ЦветПроблемногоДокумента, , ПолучитьНавигационнуюСсылку(ПроблемныйРегистратор));
		ФормСтрока6 = Новый ФорматированнаяСтрока("Для перепроведения документов в хронологическом порядке (для пересчета себестоимости) нажмите на кнопку ""Восстановить"". 
		|Если система не сможет какой-то документ провести автоматически, восстановление последовательности будет остановлено. 
		|Необходимо такой документ исправить, провести вручную и повторно запустить восстановление последовательности.", ШрифтСообщения, ЦветСообщения);
		
		СтрокОшибок = 0;
		Если ВыводитьТекстОшибкиВосстановления Тогда
			УстановитьПривилегированныйРежим(Истина);
			ТекстОшибкиВосстановления = РегламентныеЗаданияСлужебный.СообщенияИОписанияОшибокРегламентногоЗадания(РегламентныеЗадания.НайтиПредопределенное(Метаданные.РегламентныеЗадания.ВосстановлениеПоследовательностиПоСебестоимостиТоваров));
			ВыводитьТекстОшибкиВосстановления = НЕ ПустаяСтрока(ТекстОшибкиВосстановления); 
			Если ВыводитьТекстОшибкиВосстановления Тогда
				ФормСтрока7 = Новый ФорматированнаяСтрока("Ошибка, полученная в результате последнего автоматического запуска восстановления последовательности: " + ТекстОшибкиВосстановления, ШрифтСообщения, ЦветСообщения);		
				
				МассивСтрокОшибки = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ТекстОшибкиВосстановления, Символы.ПС, Ложь, Ложь);
				СтрокОшибок = МассивСтрокОшибки.Количество() + 1;
			КонецЕсли;
		КонецЕсли;
		
		МассивСтрокСообщения = Новый Массив;
		МассивСтрокСообщения.Добавить(ФормСтрока1);
		МассивСтрокСообщения.Добавить(Символы.ПС);
		МассивСтрокСообщения.Добавить(ФормСтрока2);
		МассивСтрокСообщения.Добавить(ФормСтрока3);
		МассивСтрокСообщения.Добавить(Символы.ПС);
		МассивСтрокСообщения.Добавить(ФормСтрока4);
		МассивСтрокСообщения.Добавить(ФормСтрока5);
		МассивСтрокСообщения.Добавить(Символы.ПС);
		МассивСтрокСообщения.Добавить(ФормСтрока6);
		Если ВыводитьТекстОшибкиВосстановления Тогда
			МассивСтрокСообщения.Добавить(Символы.ПС);
			МассивСтрокСообщения.Добавить(Символы.ПС);
			МассивСтрокСообщения.Добавить(ФормСтрока7);
		КонецЕсли;
		
		Форма.НарушенаПоследовательностьСебестоимость = Новый ФорматированнаяСтрока(МассивСтрокСообщения);
		Форма.Элементы.НарушенаПоследовательностьСебестоимость.Высота = 7 + СтрокОшибок;
		
		Если МоментВремениДокумента = Неопределено Тогда
			Форма.Элементы.ГруппаПоследовательность.Видимость = Истина;
			Если ИспользуютсяЭлементыВПорядке Тогда
				Форма.Элементы.ДекорацияПоследовательностьВПорядке.Видимость = Ложь;
			КонецЕсли;
			Результат = Истина;
		Иначе
			Если МоментВремениДокумента.Сравнить(ГраницаПоследовательности) = 1 Тогда			
				Форма.Элементы.ГруппаПоследовательность.Видимость = Истина;
				Если ИспользуютсяЭлементыВПорядке Тогда
					Форма.Элементы.ДекорацияПоследовательностьВПорядке.Видимость = Ложь;
				КонецЕсли;
				Результат = Истина;
			Иначе
				Форма.Элементы.ГруппаПоследовательность.Видимость = Ложь;
				Если ИспользуютсяЭлементыВПорядке Тогда
					Форма.Элементы.ДекорацияПоследовательностьВПорядке.Видимость = Истина;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	Иначе
		Форма.Элементы.ГруппаПоследовательность.Видимость = Ложь;
		Если ИспользуютсяЭлементыВПорядке Тогда
			Форма.Элементы.ДекорацияПоследовательностьВПорядке.Видимость = Истина;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура ДобавитьИндикаторРаботыСоСканерамиШК(Форма) Экспорт
	
	//создаем команду
	ИмяКоманды = "ДоступнаРаботаСоСканеромШтрихкодов";
	//Команда.Действие = Неопределено;
	КомандаФормы = Форма.Команды.Добавить(ИмяКоманды);
