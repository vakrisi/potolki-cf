Функция ЕстьГородаВСправочнике() Экспорт
	
	//проверим наличие городов
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Города.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Города КАК Города";
	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат НЕ РезультатЗапроса.Пустой();
	
КонецФункции

Функция ПолучитьПредставленияНаселенныхПунктовПоНаименованию(Наименование, КодКЛАДР = 0, ИсключитьМунициальные = Истина) Экспорт
	
	Если ПустаяСтрока(Наименование) Тогда
		Возврат Неопределено;
	КонецЕсли;	
	
	Результат = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("НачалоФразы", Наименование);
	Запрос.УстановитьПараметр("КодКЛАДР", КодКЛАДР);	
	Запрос.УстановитьПараметр("ПоискПоКодуКЛАДР", НЕ КодКЛАДР=0);
	
	ЭтоГородФедеральногоЗначения = Ложь;			
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	АдресныеОбъекты.КодКЛАДР КАК КодКЛАДР,
	|	АдресныеОбъекты.Наименование КАК Наименование,
	|	АдресныеОбъекты.КодСубъектаРФ КАК КодСубъектаРФ,
	|	АдресныеОбъекты.Идентификатор КАК Идентификатор,
	|	АдресныеОбъекты.Наименование + "" "" + АдресныеОбъекты.Сокращение КАК Представление
	|ИЗ
	|	РегистрСведений.АдресныеОбъекты КАК АдресныеОбъекты
	|ГДЕ
	|	ВЫБОР
	|			КОГДА &ПоискПоКодуКЛАДР
	|				ТОГДА АдресныеОбъекты.КодКЛАДР = &КодКЛАДР
	|			ИНАЧЕ АдресныеОбъекты.Наименование = &НачалоФразы
	|		КОНЕЦ
	|	И АдресныеОбъекты.Уровень = 1";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		ЭтоГородФедеральногоЗначения = Истина;
		
		СтруктураАдреса = Новый Структура;
		
		СтруктураАдреса.Вставить("Адрес", "");
		СтруктураАдреса.Вставить("ЗагруженныеДанные", Истина);	
		СтруктураАдреса.Вставить("Идентификатор", Выборка.Идентификатор);
		СтруктураАдреса.Вставить("КодКЛАДР", Выборка.КодКЛАДР);
		СтруктураАдреса.Вставить("Муниципальный", Ложь);
		СтруктураАдреса.Вставить("Отказ", Ложь);
		СтруктураАдреса.Вставить("ПредлагатьЗагрузкуКлассификатора", Ложь);
		СтруктураАдреса.Вставить("Представление", Выборка.Представление);
		
		Результат.Добавить(СтруктураАдреса);			
	КонецЕсли;	
	
	Если НЕ ЭтоГородФедеральногоЗначения
		ИЛИ КодКЛАДР = 0 // подбор кода в справочнике Города
		Тогда
		// запрос на основе функции АдресныйКлассификаторСлужебный.КаскадныйСписокАвтоподбораНаселенногоПункта()
		
		Запрос.Текст = КаскадныйСписокАвтоподбораНаселенногоПункта();
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Пока Выборка.Следующий() Цикл
			
			Если ИсключитьМунициальные И Выборка.Муниципальный Тогда
				Продолжить;
			КонецЕсли;		
			
			СтруктураАдреса = Новый Структура;
			
			СтруктураАдреса.Вставить("Адрес", "");
			СтруктураАдреса.Вставить("ЗагруженныеДанные", Истина);	
			СтруктураАдреса.Вставить("Идентификатор", Выборка.Идентификатор);
			СтруктураАдреса.Вставить("КодКЛАДР", Выборка.КодКЛАДР);
			СтруктураАдреса.Вставить("Муниципальный", Выборка.Муниципальный); //Ложь);
			СтруктураАдреса.Вставить("Отказ", Ложь);
			СтруктураАдреса.Вставить("ПредлагатьЗагрузкуКлассификатора", Ложь);
			СтруктураАдреса.Вставить("Представление", Выборка.Представление);
			
			Результат.Добавить(СтруктураАдреса);			
		КонецЦикла;
	КонецЕсли;	
	
	Возврат Результат;
		
КонецФункции 

Функция ПредставлениеАдреса(Город, Адрес) Экспорт
	
	ПредставлениеАдреса = "";
	ПредставлениеГорода = "";
	Если ЗначениеЗаполнено(Город) Тогда
		// разворачиваем адрес по городу
		РеквизитыГорода = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Город, "КодКЛАДР, Наименование");
		Если ЗначениеЗаполнено(РеквизитыГорода.КодКЛАДР) Тогда
			МассивГородов = ОбщийМодульСервер.ПолучитьПредставленияНаселенныхПунктовПоНаименованию(РеквизитыГорода.Наименование, РеквизитыГорода.КодКЛАДР);
			Если МассивГородов.Количество() = 1 Тогда
				СтруктураАдресаДетально = Обработки.РасширенныйВводКонтактнойИнформации.СписокРеквизитовНаселенныйПункт(МассивГородов[0]);
				ПредставлениеГорода = ОбщийМодульСервер.ПредставлениеНаселенногоПунктаАдреса(СтруктураАдресаДетально);
			КонецЕсли;	
		КонецЕсли;
	КонецЕсли;
	
	ПредставлениеАдреса = ПредставлениеГорода;
	
	Если ЗначениеЗаполнено(Адрес) Тогда
		ПредставлениеАдреса = ПредставлениеАдреса + ?(ЗначениеЗаполнено(ПредставлениеАдреса), ", ", "") + Адрес;	
	КонецЕсли;
	
	Возврат ПредставлениеАдреса;
	
КонецФункции

