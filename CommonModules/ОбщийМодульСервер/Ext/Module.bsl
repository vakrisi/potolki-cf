// Проверяет заполнение табличных частей перед началом оплаты.
//
// Параметры:
//  Отказ - Булево.
//  ПараметрыИнформации - Структура.
//  СтруктураДанных - Структура.
//  Объект - ДанныеФормаКоллекция.
//  ОплатаТолькоНаличными - Булево.
//
Процедура ПроверитьЗаполнениеТабличнойЧасти(Отказ, ПараметрыИнформации, Объект) Экспорт 
	
	ПараметрыИнформации = ОбщийМодульКлиентСервер.ВыводимаяВРМКИнформация();
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВЫРАЗИТЬ(Товары.Номенклатура КАК Справочник.Номенклатура) КАК Номенклатура,
	|	Товары.ХарактеристикаНоменклатуры КАК Характеристика,
	|	Товары.Количество,
	|	Товары.Сумма,
	|	Товары.НомерСтроки,
	|	Товары.Склад
	|ПОМЕСТИТЬ ТаблицаВЗапросе
	|ИЗ
	|	&Товары КАК Товары
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТаблицаВЗапросе.НомерСтроки,
	|	ТаблицаВЗапросе.Номенклатура,
	|	ТаблицаВЗапросе.Характеристика,
	|	ТаблицаВЗапросе.Количество,
	|	ТаблицаВЗапросе.Сумма,
	|	ТаблицаВЗапросе.Склад,
	|	ВЫБОР
	|		КОГДА ТаблицаВЗапросе.Номенклатура = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ОшибкаНоменклатуры,
	|	ВЫБОР
	|		КОГДА ТаблицаВЗапросе.Количество = 0
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ОшибкаКоличество,
	|	ВЫБОР
	|		КОГДА ТаблицаВЗапросе.Склад = ЗНАЧЕНИЕ(Справочник.Склады.ПустаяСсылка) И (ТаблицаВЗапросе.Номенклатура.ВидНоменклатуры <> ЗНАЧЕНИЕ(Справочник.ВидыНоменклатуры.Услуга))
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ОшибкаСклада
	|ПОМЕСТИТЬ ТаблицаСОшибками
	|ИЗ
	|	ТаблицаВЗапросе КАК ТаблицаВЗапросе
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТаблицаСОшибками.Номенклатура,
	|	ТаблицаСОшибками.Характеристика,
	|	ТаблицаСОшибками.Количество,
	|	ТаблицаСОшибками.Сумма,
	|	ТаблицаСОшибками.НомерСтроки,
	|	ТаблицаСОшибками.ОшибкаНоменклатуры,
	|	ТаблицаСОшибками.ОшибкаКоличество,
	|	ТаблицаСОшибками.Склад,
	|	ТаблицаСОшибками.ОшибкаСклада
	|ИЗ
	|	ТаблицаСОшибками КАК ТаблицаСОшибками
	|ГДЕ
	|	(ТаблицаСОшибками.ОшибкаНоменклатуры
	|			ИЛИ ТаблицаСОшибками.ОшибкаКоличество
	|			ИЛИ ТаблицаСОшибками.ОшибкаСклада)";
	
	Запрос.УстановитьПараметр("Товары", Объект.Товары.Выгрузить());
	
	Результат = Запрос.Выполнить();
	ТаблицаЗапроса = Результат.Выгрузить();
	
	Если ТаблицаЗапроса.Количество() > 0 Тогда
		Отказ = Истина;
		ПараметрыИнформации.ЗаголовокИнформации = НСтр("ru = 'Есть ошибки заполнения табличной части'");
		ПараметрыИнформации.ТекстИнформации     = "";
		Для каждого СтрокаТаблицы Из ТаблицаЗапроса Цикл
			
			Если СтрокаТаблицы.ОшибкаНоменклатуры Тогда
				
				Текст = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'В строке №%1 табличной части не заполнена номенклатура'"),
				СтрокаТаблицы.НомерСтроки);
				ПараметрыИнформации.ТекстИнформации = ПараметрыИнформации.ТекстИнформации + Символы.ПС + Текст;
				
			ИначеЕсли СтрокаТаблицы.ОшибкаСклада Тогда
				
				Текст = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'В строке №%1 табличной части не смогли заполнить склад'"),
				СтрокаТаблицы.НомерСтроки);
				ПараметрыИнформации.ТекстИнформации = ПараметрыИнформации.ТекстИнформации + Символы.ПС + Текст;
				
			ИначеЕсли СтрокаТаблицы.ОшибкаКоличество Тогда
				
				Текст = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'В строке №%1 табличной части не заполнено количество'"),
				СтрокаТаблицы.НомерСтроки);
				ПараметрыИнформации.ТекстИнформации = ПараметрыИнформации.ТекстИнформации + Символы.ПС + Текст;
				
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	ПроверитьНаличиеТоваров(Отказ, ПараметрыИнформации, Объект);
	
КонецПроцедуры

// Проверяет наличие товаров на складе.
//
// Параметры:
//  Отказ - Булево.
//  ПараметрыИнформации - Структура.
//  Объект - ДанныеФормаКоллекция.
//  КонтролироватьОстаткиТоваровПриЗакрытииЧека - Булево.
//
Процедура ПроверитьНаличиеТоваров(Отказ, ПараметрыИнформации, Объект) Экспорт
	
	ОрганизацияТоваров = Объект.Организация;
	Если Константы.ОбщиеСклады.Получить() Тогда
		ОрганизацияТоваров = Справочники.Организации.ПустаяСсылка();
	КонецЕсли;
	
	ТекстСообщения = "";
	
	МодульНабораЗаписей = РегистрыНакопления.ТоварыНаСкладах.СоздатьНаборЗаписей();
	Отказ = НЕ МодульНабораЗаписей.КонтрольОстатков(Объект, ОрганизацияТоваров, Объект.Магазин.Склад, Объект.Товары, Объект.Дата,, Истина, ТекстСообщения);
	
	ПараметрыИнформации.ЗаголовокИнформации = НСтр("ru = 'Отрицательные остатки'");
	ПараметрыИнформации.ТекстИнформации = ТекстСообщения;
	
КонецПроцедуры

#КонецОбласти

#Область ПроцедурыИФункцииУправлениеВидимостьюНаФорме

Процедура УстановитьВидимостьКолонкиАртикулВТабличнойЧасти(Форма, Элементы = Неопределено) Экспорт
	
	ВыводитьАртикул = ПолучитьФункциональнуюОпцию("ВыводитьАртикулНоменклатурыВТабличныхЧастяхДокументов");
	
	МассивЭлементов = новый Массив;
	
	Если Элементы = Неопределено Тогда
		МассивЭлементов.Добавить("ТоварыНоменклатураАртикул");
	ИначеЕсли ТипЗнч(Элементы) = Тип("Строка") Тогда
		МассивЭлементов.Добавить(Элементы);
	ИначеЕсли ТипЗнч(Элементы) = Тип("Массив") Тогда
		МассивЭлементов = Элементы;
	КонецЕсли;
	
	Для Каждого ТекущийЭлемент Из МассивЭлементов Цикл
		Попытка
			Форма.Элементы[ТекущийЭлемент].Видимость = ВыводитьАртикул;
		Исключение
		КонецПопытки;
	КонецЦикла;
	
КонецПроцедуры

// Устанавливает видимость элементов формы по массиву имен.
//
// Параметры:
//  Элементы - ЭлементыФормы - элементы формы видимость которых изменяется.
//  МассивВсехРеквизитов - Массив - Массив имен реквизитов, для которых устанавливается видимость.
//  МассивВидимыхРеквизитов - Массив - Массив имен реквизитов, которые должны быть видны на форме.
//
Процедура УстановитьВидимостьЭлементовПоМассиву(Элементы, Знач МассивВсехРеквизитов, Знач МассивВидимыхРеквизитов) Экспорт
	
	Если ТипЗнч(МассивВидимыхРеквизитов) <> ТипЗнч(Новый Массив) Тогда
		МассивВидимыхРеквизитов = Новый Массив;
	КонецЕсли;
	
	Для Каждого ЭлементМассива Из МассивВсехРеквизитов Цикл
		
		Позиция = Найти(ЭлементМассива, ".");
		Если Позиция <> 0 Тогда
			ИмяРеквизита = СтрЗаменить(ЭлементМассива, ".", "");
		Иначе
			ИмяРеквизита = ЭлементМассива;
		КонецЕсли;
		
		// Если реквизита нет в массиве видимых реквизитов, снимаем видимость элемента формы.
		ВидимостьРеквизита = (МассивВидимыхРеквизитов.Найти(ЭлементМассива) <> Неопределено);
		Если Элементы.Найти(ИмяРеквизита) <> Неопределено
			И Элементы[ИмяРеквизита].Видимость <> ВидимостьРеквизита Тогда
			Элементы[ИмяРеквизита].Видимость = ВидимостьРеквизита;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

//++ №6283
Процедура УстановитьВидимостьКолонокВТабличнойЧастиИсполнителиПоОперациям(Форма) Экспорт
	
	//++ №6687 теперь способ определяется в документе
	//Если НЕ Константы.РасчетЗарплатыПроизводстваПоОперациям.Получить() Тогда
	Если НЕ Форма.Объект.СпособНачисленияВыработки = Перечисления.СпособыНачисленияВыработки.ПроизводственныеОперации Тогда
		//-- №6687
		Возврат;
	КонецЕсли;
	
	// №6283 дополнительно смотрим сколько в документе колонок заполнено, если глобально включено меньше 4-х
	
	МаксимальноеКоличествоСотрудниковВВыпускеНаОперацию = Константы.МаксимальноеКоличествоСотрудниковВВыпускеНаОперацию.Получить();
	
	Если МаксимальноеКоличествоСотрудниковВВыпускеНаОперацию < 4 Тогда
		
		ИмяТЧ = ?(ТипЗнч(Форма.Объект.Ссылка) = Тип("ДокументСсылка.СоставПроизводственнойСмены"), "СотрудникиПоОперациям", "ИсполнителиПоОперациям");
		Для Каждого ТекущаяСтрокаОперация Из Форма.Объект[ИмяТЧ] Цикл
			
			КоличествоИсполнителейПоОперации = 0;
			Для НомерСотрудника = 1 По 4 Цикл
				Если НЕ ТекущаяСтрокаОперация["Сотрудник" + НомерСотрудника].Пустая() Тогда
					КоличествоИсполнителейПоОперации = КоличествоИсполнителейПоОперации + 1;
				КонецЕсли;
			КонецЦИкла;
			
			// Определяем максимальное число колонок
			МаксимальноеКоличествоСотрудниковВВыпускеНаОперацию	= Макс(МаксимальноеКоличествоСотрудниковВВыпускеНаОперацию, КоличествоИсполнителейПоОперации);
			
		КонецЦикла;
		
	КонецЕсли;
	Форма.МаксимальноеКоличествоСотрудниковВВыпускеНаОперацию = МаксимальноеКоличествоСотрудниковВВыпускеНаОперацию;
	
	// №6283 поменяли на реквизит документа ИспользоватьКТУВПроизводственныхОперациях = Константы.ИспользоватьКТУВПроизводственныхОперациях.Получить();
	ИспользоватьКТУВПроизводственныхОперациях = Форма.Объект.ИспользоватьКТУВПроизводственныхОперациях;
	
	Для Сч = 1 По 4 Цикл
		
		Форма.Элементы["ИсполнителиПоУчасткамКоэффициент" + Сч].Видимость 	= ИспользоватьКТУВПроизводственныхОперациях;
		Форма.Элементы["ИсполнителиПоУчасткамГруппа" + Сч].Видимость 		= (Сч <= Форма.МаксимальноеКоличествоСотрудниковВВыпускеНаОперацию);
		
		//++ №6283 дополнительно колонку "% участия" во всех документах так же не показывать, если не исопльзуется учет КТУ в производственных операция
		Форма.Элементы["ИсполнителиПоУчасткамПроцентУчастия" + Сч].Видимость = ИспользоватьКТУВПроизводственныхОперациях;
		
	КонецЦикла;
	
КонецПроцедуры
//-- №6283

Процедура УстановитьВидимостьПодразделения(Форма) Экспорт
	
	Видимость = Форма.Объект.СозданПриИспользованииПодразделений;
	Если Видимость Тогда
		Возврат;
	КонецЕсли;
	
	ТекущийЭлемент = "Подразделение";	
	Если НЕ Форма.Элементы.Найти(ТекущийЭлемент) = Неопределено Тогда
		Форма.Элементы[ТекущийЭлемент].Видимость = Видимость;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

Функция ДобавитьГруппуФормы(Форма,
	Имя,
	Заголовок,
	ОтображатьВШапке,
	КартинкаШапки,
	ГруппировкаКолонок,
	Родитель) Экспорт
	
	НоваяГруппа                  = Форма.Элементы.Добавить(Имя, Тип("ГруппаФормы"), ?(Родитель = Неопределено, Форма, Родитель));
	НоваяГруппа.Заголовок        = ?(ЗначениеЗаполнено(Заголовок), Заголовок, Имя);
	НоваяГруппа.Вид              = ВидГруппыФормы.ГруппаКолонок;
	НоваяГруппа.Группировка      = ГруппировкаКолонок;
	НоваяГруппа.ОтображатьВШапке = ОтображатьВШапке;	
	
	Если ОтображатьВШапке И КартинкаШапки <> Неопределено Тогда
		НоваяГруппа.КартинкаШапки = КартинкаШапки;
	КонецЕсли;
	
	Возврат НоваяГруппа;
	
КонецФункции

Функция ДобавитьПолеФормы(Форма, Имя, ДополнительныеПараметры) Экспорт
	
	СтруктураПараметров = Новый Структура();
	СтруктураПараметров.Вставить("Заголовок",              Неопределено);
	СтруктураПараметров.Вставить("ОбработчикПриИзменении", "");
	СтруктураПараметров.Вставить("ОбработчикНачалоВыбора", "");
	СтруктураПараметров.Вставить("ШиринаПоля",             0);
	СтруктураПараметров.Вставить("ЦветФона",               Неопределено);
	СтруктураПараметров.Вставить("ЦветФонаЗаголовка",      Неопределено);
	СтруктураПараметров.Вставить("Родитель",               Неопределено);
	СтруктураПараметров.Вставить("КартинкаШапки",          Неопределено);
	СтруктураПараметров.Вставить("ПутьКДанным",            Неопределено);
	СтруктураПараметров.Вставить("ТолькоПросмотрПоля",     Ложь);
	СтруктураПараметров.Вставить("СвязиПараметровВыбора",  Неопределено);
	СтруктураПараметров.Вставить("ОтображатьВШапке",       Истина);
	
	ЗаполнитьЗначенияСвойств(СтруктураПараметров, ДополнительныеПараметры);
	
	НовоеПоле                     = Форма.Элементы.Добавить(Имя, Тип("ПолеФормы"), ?(СтруктураПараметров.Родитель = Неопределено, Форма, СтруктураПараметров.Родитель));
	НовоеПоле.ПутьКДанным         = СтруктураПараметров.ПутьКДанным;
	НовоеПоле.Заголовок           = ?(ЗначениеЗаполнено(СтруктураПараметров.Заголовок), СтруктураПараметров.Заголовок, Имя);
	НовоеПоле.РежимРедактирования = РежимРедактированияКолонки.ВходПриВводе;
	НовоеПоле.Вид                 = ВидПоляФормы.ПолеВвода;
	НовоеПоле.ТолькоПросмотр      = СтруктураПараметров.ТолькоПросмотрПоля;
	НовоеПоле.Ширина              = СтруктураПараметров.ШиринаПоля;
	НовоеПоле.ОтображатьВШапке    = СтруктураПараметров.ОтображатьВШапке;
	
	НовоеПоле.РастягиватьПоГоризонтали = Ложь;
	
	Если СтруктураПараметров.СвязиПараметровВыбора <> Неопределено Тогда
		НовоеПоле.СвязиПараметровВыбора = СтруктураПараметров.СвязиПараметровВыбора;
	КонецЕсли;
	
	Если СтруктураПараметров.ЦветФонаЗаголовка <> Неопределено Тогда
		НовоеПоле.ЦветФонаЗаголовка = СтруктураПараметров.ЦветФонаЗаголовка;
	КонецЕсли;
	
	Если СтруктураПараметров.ЦветФона <> Неопределено Тогда
		НовоеПоле.ЦветФона = СтруктураПараметров.ЦветФона;
	КонецЕсли;
	
	Если СтруктураПараметров.КартинкаШапки <> Неопределено Тогда
		НовоеПоле.КартинкаШапки = СтруктураПараметров.КартинкаШапки;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтруктураПараметров.ОбработчикПриИзменении) Тогда
		НовоеПоле.УстановитьДействие("ПриИзменении", СтруктураПараметров.ОбработчикПриИзменении);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтруктураПараметров.ОбработчикНачалоВыбора) Тогда
		НовоеПоле.УстановитьДействие("НачалоВыбора", СтруктураПараметров.ОбработчикНачалоВыбора);
	КонецЕсли;
	
	Возврат НовоеПоле;
	
КонецФункции

//++ №8495
#Область ОбязательныеПоляКЗаполнению

Функция ПолучитьМассивВозможныхОбязательныхПолейКЗаполнениюЛида() Экспорт
	
	МассивПолей = новый Массив;
	ДобавитьПолеВМассивОбязательныхПолейКЗаполнениюЛида(МассивПолей, "ИмяКлиента", "Имя клиента");
	ДобавитьПолеВМассивОбязательныхПолейКЗаполнениюЛида(МассивПолей, "КонтактнаяИнформация.Телефон", "Телефон");
	ДобавитьПолеВМассивОбязательныхПолейКЗаполнениюЛида(МассивПолей, "КонтактнаяИнформация.ЭлектроннаяПочта", "Электронная почта");
	ДобавитьПолеВМассивОбязательныхПолейКЗаполнениюЛида(МассивПолей, "ВидКонтакта", "Вид контакта");
	ДобавитьПолеВМассивОбязательныхПолейКЗаполнениюЛида(МассивПолей, "РекламнаяАкция", "Рекламная акция");
	ДобавитьПолеВМассивОбязательныхПолейКЗаполнениюЛида(МассивПолей, "РекламныйИсточник", "Рекламный источник");
	ДобавитьПолеВМассивОбязательныхПолейКЗаполнениюЛида(МассивПолей, "ТочкаПродаж", "Точка продаж");
	ДобавитьПолеВМассивОбязательныхПолейКЗаполнениюЛида(МассивПолей, "Город");
	ДобавитьПолеВМассивОбязательныхПолейКЗаполнениюЛида(МассивПолей, "Адрес");
	ДобавитьПолеВМассивОбязательныхПолейКЗаполнениюЛида(МассивПолей, "Комментарий");
	ДобавитьПолеВМассивОбязательныхПолейКЗаполнениюЛида(МассивПолей, "Подразделение");
	
	Возврат МассивПолей;
	
КонецФункции

Процедура ДобавитьПолеВМассивОбязательныхПолейКЗаполнениюЛида(МассивПолей, Знач ИмяПоля, Знач Синоним = Неопределено)
	
	Если Синоним = Неопределено Тогда
		
		Синоним = ИмяПоля;
		
	КонецЕсли;
	
	МассивПолей.Добавить(новый Структура("ИмяПоля, Синоним", ИмяПоля, Синоним));
	
КонецПроцедуры

// Возвращает таблицу с возможными и выбранными пользователем полями
Функция ПолучитьНастройкуОбязательныхПолейКЗаполнениюЛида() Экспорт
	
	// Получим поля, которые могут быть выбраны как обязательные к заполнению
	ДоступныеПоля = ПолучитьМассивВозможныхОбязательныхПолейКЗаполнениюЛида();
	
	// Получим поля, которые уже выбраны пользователем
	ВыбранныеПоляПользователем = Константы.ОбязательныеПоляКЗаполнениюЛида.Получить().Получить();
	Если ВыбранныеПоляПользователем = Неопределено Тогда
		ВыбранныеПоляПользователем = Новый Массив;
	КонецЕсли;
	
	// Сформируем таблицу значений с возможными и выбранными полями
	ТаблицаНастройки = новый ТаблицаЗначений;
	ТаблицаНастройки.Колонки.Добавить("ИмяПоля", 	новый ОписаниеТипов("Строка",,,, новый КвалификаторыСтроки(80)));
	ТаблицаНастройки.Колонки.Добавить("Синоним", 	новый ОписаниеТипов("Строка",,,, новый КвалификаторыСтроки(80)));
	ТаблицаНастройки.Колонки.Добавить("Заполнять", 	новый ОписаниеТипов("Булево"));
	
	Для Каждого ДоступноеПоле Из ДоступныеПоля Цикл
		
		НоваяСтрока = ТаблицаНастройки.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ДоступноеПоле);
		НоваяСтрока.Заполнять = (НЕ ВыбранныеПоляПользователем.Найти(ДоступноеПоле.ИмяПоля) = Неопределено);
		
		// #17179 обратная совместимость после изменения полей
		Если НЕ НоваяСтрока.Заполнять И ДоступноеПоле.ИмяПоля = "КонтактнаяИнформация.Телефон" Тогда
			НоваяСтрока.Заполнять = (НЕ ВыбранныеПоляПользователем.Найти("ОсновнойТелефонКлиента") = Неопределено);
		ИначеЕсли НЕ НоваяСтрока.Заполнять И ДоступноеПоле.ИмяПоля = "КонтактнаяИнформация.ЭлектроннаяПочта" Тогда
			НоваяСтрока.Заполнять = (НЕ ВыбранныеПоляПользователем.Найти("ЭлектроннаяПочтаКлиента") = Неопределено);	
		КонецЕсли;
		
	КонецЦикла;
	
	ТаблицаНастройки.Сортировать("ИмяПоля");
	
	Возврат ТаблицаНастройки;
	
КонецФункции

Процедура СохранитьНастройкуОбязательныхПолейКЗаполнениюЛида(ОбязательныеПоляКЗаполнениюЛида) Экспорт
	
	ВыбранныеПоляПользователем = новый Массив;
	
	Для Каждого ТекущаяСтрока Из ОбязательныеПоляКЗаполнениюЛида Цикл
		
		Если ТекущаяСтрока.Заполнять Тогда
			ВыбранныеПоляПользователем.Добавить(ТекущаяСтрока.ИмяПоля);
		КонецЕсли;
		
	КонецЦикла;
	
	Константы.ОбязательныеПоляКЗаполнениюЛида.Установить(новый ХранилищеЗначения(ВыбранныеПоляПользователем));
	
КонецПроцедуры

