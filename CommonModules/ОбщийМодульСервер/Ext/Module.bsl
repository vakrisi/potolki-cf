Функция ПолучитьТаблицуПоДатеДоговора(МенеджерВТ, НачалоПериода, КонецПериода) Экспорт
	
	Запрос = новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.Текст = 
	//#12914 1. для всех "Видов" четвертую таблицу строить по заказ-договорам, дата которых попадает в период отчета. 
	// Если заказ-договор не привязан к замеру (лиду), то значение его показателя брать как = "Неопределено". 
	// Порядок, состав и наименования колонок сделать таким же как в третьей таблице отчета "Эффективность замерщиков".
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	//|	КонверсияВходящихКонтактовОбороты.Контакт КАК Контакт,
	|	ВЫРАЗИТЬ(КонверсияВходящихКонтактовОбороты.Основание КАК Документ.Лид) КАК Контакт,
	
	//|	СУММА(КонверсияВходящихКонтактовОбороты.КоличествоДоговоровОборот) КАК КоличествоДоговоров,
	//|	СУММА(ВЫБОР
	//|			КОГДА КонверсияВходящихКонтактовОбороты.КоличествоДоговоровОборот > 0
	//|				ТОГДА КонверсияВходящихКонтактовОбороты.Регистратор.СуммаДокумента
	//|			ИНАЧЕ 0
	//|		КОНЕЦ) КАК СуммаДоговоров,
	//|	СУММА(ВЫБОР
	//|			КОГДА КонверсияВходящихКонтактовОбороты.КоличествоДоговоровОборот > 0
	//|				ТОГДА КонверсияВходящихКонтактовОбороты.Регистратор.СуммаСкидки
	//|			ИНАЧЕ 0
	//|		КОНЕЦ) КАК СуммаСкидкиДоговоров,
	//|	СУММА(ВЫБОР
	//|			КОГДА КонверсияВходящихКонтактовОбороты.КоличествоДоговоровОборот > 0
	//|				ТОГДА КонверсияВходящихКонтактовОбороты.Регистратор.СуммаДокументаПоПрайсу
	//|			ИНАЧЕ 0
	//|		КОНЕЦ) КАК СуммаДоговоровПоПрайсу,	
	|	СУММА(1) КАК КоличествоДоговоров,
	|	СУММА(КонверсияВходящихКонтактовОбороты.СуммаДокумента) КАК СуммаДоговоров,
	|	СУММА(КонверсияВходящихКонтактовОбороты.СуммаСкидки) КАК СуммаСкидкиДоговоров,
	|	СУММА(КонверсияВходящихКонтактовОбороты.СуммаДокументаПоПрайсу) КАК СуммаДоговоровПоПрайсу,	
	
	|	СУММА(ВТ_ПлощадиПоЗаказам.Площадь) КАК Площадь,
	|	СУММА(ВТ_ОбщиеПродажи.СреднийЧекСумма) КАК СреднийЧекСумма
	|ПОМЕСТИТЬ ВТ_ПоДоговорам
	|ИЗ
	//|	РегистрНакопления.КонверсияВходящихКонтактов.Обороты(&НачалоПериода, &КонецПериода, Регистратор, ) КАК КонверсияВходящихКонтактовОбороты
	|	Документ.ЗаказДоговор КАК КонверсияВходящихКонтактовОбороты
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ПлощадиПоЗаказам КАК ВТ_ПлощадиПоЗаказам
	//|		ПО КонверсияВходящихКонтактовОбороты.Регистратор = ВТ_ПлощадиПоЗаказам.ЗаказДоговор
	//|			И КонверсияВходящихКонтактовОбороты.Контакт = ВТ_ПлощадиПоЗаказам.Основание
	|		ПО КонверсияВходящихКонтактовОбороты.Ссылка = ВТ_ПлощадиПоЗаказам.ЗаказДоговор
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ОбщиеПродажи КАК ВТ_ОбщиеПродажи
	//|		ПО КонверсияВходящихКонтактовОбороты.Регистратор = ВТ_ОбщиеПродажи.ЗаказДоговор
	//|			И КонверсияВходящихКонтактовОбороты.Контакт = ВТ_ОбщиеПродажи.Основание
	|		ПО КонверсияВходящихКонтактовОбороты.Ссылка = ВТ_ОбщиеПродажи.ЗаказДоговор
	|ГДЕ
	|	КонверсияВходящихКонтактовОбороты.Проведен	
	|	И КонверсияВходящихКонтактовОбороты.Дата МЕЖДУ &НачалоПериода И &КонецПериода
	//|	ТИПЗНАЧЕНИЯ(КонверсияВходящихКонтактовОбороты.Регистратор) = ТИП(Документ.ЗаказДоговор)
	|
	|СГРУППИРОВАТЬ ПО
	//|	КонверсияВходящихКонтактовОбороты.Контакт
	|	КонверсияВходящихКонтактовОбороты.Ссылка
	|;
	|
	//|////////////////////////////////////////////////////////////////////////////////
	//|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	//|	КонверсияВходящихКонтактовОбороты.Контакт КАК Контакт,
	//|	СУММА(КонверсияВходящихКонтактовОбороты.КоличествоМонтажейУспехОборот) КАК КоличествоВыполненныхМонтажей,
	//|	СУММА(ВЫБОР
	//|			КОГДА КонверсияВходящихКонтактовОбороты.КоличествоМонтажейУспехОборот > 0
	//|				ТОГДА КонверсияВходящихКонтактовОбороты.Регистратор.СуммаДокумента
	//|			ИНАЧЕ 0
	//|		КОНЕЦ) КАК СуммаВыполненныхМонтажей
	//|ПОМЕСТИТЬ ВТ_ПоМонтажам
	//|ИЗ
	//|	РегистрНакопления.КонверсияВходящихКонтактов.Обороты(&НачалоПериода, &КонецПериода, Регистратор, ) КАК КонверсияВходящихКонтактовОбороты
	//|ГДЕ
	//|	ТИПЗНАЧЕНИЯ(КонверсияВходящихКонтактовОбороты.Регистратор) = ТИП(Документ.Монтаж)
	//|
	//|СГРУППИРОВАТЬ ПО
	//|	КонверсияВходящихКонтактовОбороты.Контакт
	//|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ПоДоговорам.Контакт КАК Контакт,
	//|	ВТ_ПоказательЛиды.Показатель КАК Показатель,
	|	ЕСТЬNULL(ВТ_ПоказательЛиды.Показатель, ""(неопределено)"") КАК Показатель,
	//|	ЕСТЬNULL(ВТ_ПоказательЛиды.Показатель, -1) КАК Показатель,
	
	|	СУММА(ВТ_ПоДоговорам.КоличествоДоговоров) КАК КоличествоДоговоровПоДоговорам,
	|	СУММА(ВТ_ПоДоговорам.СуммаДоговоров) КАК СуммаДоговоровПоДоговорам,
	|	СУММА(ВТ_ПоДоговорам.Площадь) КАК ПлощадьПоДоговорам,
	|	СУММА(ВТ_ПоДоговорам.СреднийЧекСумма) КАК СреднийЧекСуммаПоДоговорам,
	|	СУММА(ВТ_ПоДоговорам.СуммаСкидкиДоговоров) КАК СуммаСкидкиДоговоровПоДоговорам,
	|	СУММА(ВТ_ПоДоговорам.СуммаДоговоровПоПрайсу) КАК СуммаДоговоровПоПрайсуПоДоговорам,
	// в этой группе не используются, пока обнуляем
	//|	СУММА(ВТ_ПоМонтажам.КоличествоВыполненныхМонтажей) КАК КоличествоВыполненныхМонтажей,
	//|	СУММА(ВТ_ПоМонтажам.СуммаВыполненныхМонтажей) КАК СуммаВыполненныхМонтажей
	|	0 КАК КоличествоВыполненныхМонтажей,
	|	0 КАК СуммаВыполненныхМонтажей
	|ИЗ
	//|	ВТ_ПоказательЛиды КАК ВТ_ПоказательЛиды
	//|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ПоДоговорам КАК ВТ_ПоДоговорам
	|	ВТ_ПоДоговорам КАК ВТ_ПоДоговорам
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ПоказательЛиды КАК ВТ_ПоказательЛиды
	|		ПО ВТ_ПоказательЛиды.Контакт = ВТ_ПоДоговорам.Контакт
	//|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ПоМонтажам КАК ВТ_ПоМонтажам
	//|		ПО ВТ_ПоказательЛиды.Контакт = ВТ_ПоМонтажам.Контакт
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_ПоДоговорам.Контакт,
	//|	ВТ_ПоказательЛиды.Показатель
	|	ЕСТЬNULL(ВТ_ПоказательЛиды.Показатель, ""(неопределено)"")
	//|	ЕСТЬNULL(ВТ_ПоказательЛиды.Показатель, -1)
	|";
	
	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", ?(ЗначениеЗаполнено(КонецПериода), КонецДня(КонецПериода), ТекущаяДатаСеанса()));
	
	ТаблицаРезультат = Запрос.Выполнить().Выгрузить();
	
	Возврат ТаблицаРезультат;
	
КонецФункции

Функция ПолучитьТаблицуПоМонтажам(МенеджерВТ, НачалоПериода, КонецПериода) Экспорт
	
	Запрос = новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	МонтажТоварыУслуги.Ссылка КАК Монтаж,
	//|	МонтажТоварыУслуги.Ссылка.Дата КАК ДатаМонтажа,
	|	МонтажТоварыУслуги.Ссылка.ДатаВыполнения КАК ДатаМонтажа,
	|	МонтажТоварыУслуги.Ссылка.Основание КАК ЗаказДоговор,
	|	МонтажТоварыУслуги.Ссылка.Основание.Дата КАК ДатаДоговора,
	|	МонтажТоварыУслуги.Ссылка.Основание.Основание КАК Лид,
	|	МонтажТоварыУслуги.Ссылка.Основание.Основание.Дата КАК ДатаЛида,
	|	СРЕДНЕЕ(МонтажТоварыУслуги.Ссылка.СуммаДокумента) КАК СуммаМонтажа,
	|	СУММА(ВЫБОР
	|			КОГДА МонтажТоварыУслуги.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Справочник.ВидыНоменклатуры.Потолок)
	|					ИЛИ МонтажТоварыУслуги.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Справочник.ВидыНоменклатуры.Отрез)
	|					ИЛИ МонтажТоварыУслуги.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Справочник.ВидыНоменклатуры.ТиповойОтрез)
	|					ИЛИ МонтажТоварыУслуги.Номенклатура.УчитыватьКакПотолокВОтчетахПоЭффективности
	|				ТОГДА 1
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК КоличествоПотолков,
	|	СУММА(ВЫБОР
	|			КОГДА МонтажТоварыУслуги.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Справочник.ВидыНоменклатуры.Потолок)
	|					ИЛИ МонтажТоварыУслуги.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Справочник.ВидыНоменклатуры.Отрез)
	|					ИЛИ МонтажТоварыУслуги.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Справочник.ВидыНоменклатуры.ТиповойОтрез)
	|					ИЛИ МонтажТоварыУслуги.Номенклатура.УчитыватьКакПотолокВОтчетахПоЭффективности
	|				ТОГДА МонтажТоварыУслуги.Количество * МонтажТоварыУслуги.Коэффициент
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК ПлощадьПотолков
	|ПОМЕСТИТЬ ВТ_ДанныеПоМонтажам
	|ИЗ
	|	Документ.Монтаж.ТоварыУслуги КАК МонтажТоварыУслуги
	|ГДЕ
	|	МонтажТоварыУслуги.Ссылка.Проведен
	//#13654 
	|	И МонтажТоварыУслуги.Ссылка.ВидОперации = ЗНАЧЕНИЕ(Справочник.ВидыМонтажа.Монтаж)
	|	И МонтажТоварыУслуги.Ссылка.Результат В (ЗНАЧЕНИЕ(Справочник.РезультатыМонтажа.Выполнен), ЗНАЧЕНИЕ(Справочник.РезультатыМонтажа.Закрыт))
	
	//#12853 закомментировано: в отчете "Эффективность по лидам" в таблице "Монтажи за период по дате монтажа" должны попадать все монтажи, не важно привязаны они к лидам\договорам или нет. 
	//если не привязаны, то показатель = неопределено	
	//|	И МонтажТоварыУслуги.Ссылка.Основание ССЫЛКА Документ.ЗаказДоговор
	// заказ-договор
	|	И (МонтажТоварыУслуги.Ссылка.Основание.Дата >= &НачалоПериода
	|				И МонтажТоварыУслуги.Ссылка.Основание.Дата <= &КонецПериода
	// монтаж
	//#12853 монтажи в отчеты должны попадать не по дате документа, а по дате выполнения
	//		ИЛИ МонтажТоварыУслуги.Ссылка.Дата >= &НачалоПериода
	//			И МонтажТоварыУслуги.Ссылка.Дата <= &КонецПериода
	|			ИЛИ МонтажТоварыУслуги.Ссылка.ДатаВыполнения >= &НачалоПериода
	|				И МонтажТоварыУслуги.Ссылка.ДатаВыполнения <= &КонецПериода
	// лид
	|			ИЛИ МонтажТоварыУслуги.Ссылка.Основание.Основание.Дата >= &НачалоПериода
	|				И МонтажТоварыУслуги.Ссылка.Основание.Основание.Дата <= &КонецПериода)
	|
	|СГРУППИРОВАТЬ ПО
	|	МонтажТоварыУслуги.Ссылка,
	|	МонтажТоварыУслуги.Ссылка.Дата,
	|	МонтажТоварыУслуги.Ссылка.Основание,
	|	МонтажТоварыУслуги.Ссылка.Основание.Дата,
	|	МонтажТоварыУслуги.Ссылка.Основание.Основание,
	|	МонтажТоварыУслуги.Ссылка.Основание.Основание.Дата
	|;
	|
	|///////////////////////////////////////////////////////////	
	// область "По дате лида за период"
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВТ_ДанныеПоМонтажам.Лид КАК Контакт,
	|	ЕСТЬNULL(ВТ_ПоказательЛиды.Показатель, ""(неопределено)"") КАК Показатель,
	//|	ЕСТЬNULL(ВТ_ПоказательЛиды.Показатель, -1) КАК Показатель,
	|	ВТ_ДанныеПоМонтажам.ПлощадьПотолков КАК ПлощадьПотолковМонтажейПоЛидам,
	|	ВТ_ДанныеПоМонтажам.СуммаМонтажа КАК СуммаМонтажейПоЛидам,
	|	0 КАК ПлощадьПотолковМонтажейПоДоговорам,
	|	0 КАК СуммаМонтажейПоДоговорам,
	|	0 КАК ПлощадьПотолковМонтажейПоМонтажам,
	|	0 КАК СуммаМонтажейПоМонтажам
	|ПОМЕСТИТЬ ВТ_ПоМонтажам
	|ИЗ
	|	ВТ_ДанныеПоМонтажам КАК ВТ_ДанныеПоМонтажам
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ПоказательЛиды КАК ВТ_ПоказательЛиды
	|		ПО ВТ_ПоказательЛиды.Контакт = ВТ_ДанныеПоМонтажам.Лид
	|ГДЕ
	|	ВТ_ДанныеПоМонтажам.ДатаЛида МЕЖДУ &НачалоПериода И &КонецПериода
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	// область "По дате договора за период"
	|ВЫБРАТЬ
	|	ВТ_ДанныеПоМонтажам.Лид КАК Контакт,
	|	ЕСТЬNULL(ВТ_ПоказательЛиды.Показатель, ""(неопределено)"") КАК Показатель,
	//|	ЕСТЬNULL(ВТ_ПоказательЛиды.Показатель, -1) КАК Показатель,
	|	0 КАК ПлощадьПотолковМонтажейПоЛидам,
	|	0 КАК СуммаМонтажейПоЛидам,
	|	ВТ_ДанныеПоМонтажам.ПлощадьПотолков КАК ПлощадьПотолковМонтажейПоДоговорам,
	|	ВТ_ДанныеПоМонтажам.СуммаМонтажа КАК СуммаМонтажейПоДоговорам,
	|	0 КАК ПлощадьПотолковМонтажейПоМонтажам,
	|	0 КАК СуммаМонтажейПоМонтажам
	|ИЗ
	|	ВТ_ДанныеПоМонтажам КАК ВТ_ДанныеПоМонтажам
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ПоказательЛиды КАК ВТ_ПоказательЛиды
	|		ПО ВТ_ПоказательЛиды.Контакт = ВТ_ДанныеПоМонтажам.Лид
	|ГДЕ
	|	ВТ_ДанныеПоМонтажам.ДатаДоговора МЕЖДУ &НачалоПериода И &КонецПериода
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	// область "По дате монтажа за период"
	|ВЫБРАТЬ
	|	ВТ_ДанныеПоМонтажам.Лид КАК Контакт,
	|	ЕСТЬNULL(ВТ_ПоказательЛиды.Показатель, ""(неопределено)"") КАК Показатель,
	//|	ЕСТЬNULL(ВТ_ПоказательЛиды.Показатель, -1) КАК Показатель,
	|	0 КАК ПлощадьПотолковМонтажейПоЛидам,
	|	0 КАК СуммаМонтажейПоЛидам,
	|	0 КАК ПлощадьПотолковМонтажейПоДоговорам,
	|	0 КАК СуммаМонтажейПоДоговорам,
	|	ВТ_ДанныеПоМонтажам.ПлощадьПотолков КАК ПлощадьПотолковМонтажейПоМонтажам,
	|	ВТ_ДанныеПоМонтажам.СуммаМонтажа КАК СуммаМонтажейПоМонтажам
	|ИЗ
	|	ВТ_ДанныеПоМонтажам КАК ВТ_ДанныеПоМонтажам
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ПоказательЛиды КАК ВТ_ПоказательЛиды
	|		ПО ВТ_ПоказательЛиды.Контакт = ВТ_ДанныеПоМонтажам.Лид
	|ГДЕ
	|	ВТ_ДанныеПоМонтажам.ДатаМонтажа МЕЖДУ &НачалоПериода И &КонецПериода
	|;
	|
	|///////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВТ_ПоМонтажам.Контакт КАК Контакт,
	|	ВТ_ПоМонтажам.Показатель КАК Показатель,
	|	СУММА(ВТ_ПоМонтажам.ПлощадьПотолковМонтажейПоЛидам) КАК ПлощадьПотолковМонтажейПоЛидам,
	|	СУММА(ВТ_ПоМонтажам.СуммаМонтажейПоЛидам) КАК СуммаМонтажейПоЛидам,
	|	СУММА(ВТ_ПоМонтажам.ПлощадьПотолковМонтажейПоДоговорам) КАК ПлощадьПотолковМонтажейПоДоговорам,
	|	СУММА(ВТ_ПоМонтажам.СуммаМонтажейПоДоговорам) КАК СуммаМонтажейПоДоговорам,
	|	СУММА(ВТ_ПоМонтажам.ПлощадьПотолковМонтажейПоМонтажам) КАК ПлощадьПотолковМонтажейПоМонтажам,
	|	СУММА(ВТ_ПоМонтажам.СуммаМонтажейПоМонтажам) КАК СуммаМонтажейПоМонтажам
	|ИЗ
	|	ВТ_ПоМонтажам КАК ВТ_ПоМонтажам
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_ПоМонтажам.Контакт,
	|	ВТ_ПоМонтажам.Показатель
	|";
	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", ?(ЗначениеЗаполнено(КонецПериода), КонецДня(КонецПериода), ТекущаяДатаСеанса()));
	
	ТаблицаРезультат = Запрос.Выполнить().Выгрузить();
	
	Возврат ТаблицаРезультат;
	
КонецФункции

Функция ОбъединитьТаблицыНаборовДанных(СтруктураТаблиц) Экспорт
	
	// Сначала создадим основную таблицу данных, по колонкам, которые есть в таблице
	ТаблицаДанных = новый ТаблицаЗначений;
	
	Для Каждого ТекущаяТаблица Из СтруктураТаблиц Цикл
		
		Для Каждого ТекущаяКолонка Из ТекущаяТаблица.Значение.Колонки Цикл
			
			Если ТаблицаДанных.Колонки.Найти(НРег(ТекущаяКолонка.Имя)) = Неопределено Тогда
				ТаблицаДанных.Колонки.Добавить(НРег(ТекущаяКолонка.Имя), ТекущаяКолонка.ТипЗначения);
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
	// Заполняем основную таблицу
	Для Каждого ТекущаяТаблица Из СтруктураТаблиц Цикл
		
		Для Каждого ТекущаяСтрока Из ТекущаяТаблица.Значение Цикл
			
			НоваяСтрока = ТаблицаДанных.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущаяСтрока, , "Показатель");
			
			Если ТипЗнч(ТекущаяСтрока.Показатель) = Тип("СправочникСсылка.Пользователи") Тогда				
				ОписаниеТипов = Новый ОписаниеТипов("СправочникСсылка.Пользователи");
				ОписаниеТипов.ПривестиЗначение(НоваяСтрока.Показатель);
				//++ №13645 отчёт "Эффективность менеджеров" формируется по сотрудникам
			ИначеЕсли ТипЗнч(ТекущаяСтрока.Показатель) = Тип("СправочникСсылка.Сотрудники") Тогда				
				ОписаниеТипов = Новый ОписаниеТипов("СправочникСсылка.Сотрудники");
				ОписаниеТипов.ПривестиЗначение(НоваяСтрока.Показатель);
				//-- №13645 отчёт "Эффективность менеджеров" формируется по сотрудникам
			КонецЕсли;
			
			
			НоваяСтрока.Показатель = ТекущаяСтрока.Показатель;
			
		КонецЦикла;
	КонецЦикла;
	
	
	// свертка по измерениям "Контакт, показатель" осуществляется для корректного вычисления средней в подвале каждой таблицы
	КолонкиСуммирования = "";
	
	Для Каждого ТекущаяКолонка Из ТаблицаДанных.Колонки Цикл
		
		Если НРег(ТекущаяКолонка.Имя) = "контакт" Или НРег(ТекущаяКолонка.Имя) = "показатель" Тогда
			Продолжить;
		КонецЕсли;
		
		КолонкиСуммирования = КолонкиСуммирования + ?(ЗначениеЗаполнено(КолонкиСуммирования), ", ", "") + ТекущаяКолонка.Имя;
		
	КонецЦикла;
	
	ТаблицаДанных.Свернуть("Контакт, Показатель", КолонкиСуммирования);
	
	Возврат ТаблицаДанных;
	
КонецФункции
