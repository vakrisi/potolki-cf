	|		ИНАЧЕ """"
	|	КОНЕЦ + ВЫБОР
	|		КОГДА НЕ АдресныеОбъектыУровень5.Наименование ЕСТЬ NULL
	|			ТОГДА "", "" + АдресныеОбъектыУровень5.Наименование + "" "" + АдресныеОбъектыУровень5.Сокращение
	|		ИНАЧЕ """"
	|	КОНЕЦ КАК Представление,
	|	АдресныеОбъекты.Идентификатор КАК Идентификатор,
	//++
	|	АдресныеОбъекты.КодКЛАДР КАК КодКЛАДР,
	//--
	|	ЛОЖЬ КАК Муниципальный,
	|	АдресныеОбъекты.ДополнительныеАдресныеСведения КАК ДополнительныеАдресныеСведения,
	|	ВЫБОР
	|		КОГДА АдресныеОбъекты.Уровень < 10
	|			ТОГДА АдресныеОбъекты.Уровень * 10
	|		ИНАЧЕ АдресныеОбъекты.Уровень
	|	КОНЕЦ КАК Уровень
	|ПОМЕСТИТЬ АдминистративныеАдреса
	|ИЗ
	|	РегистрСведений.АдресныеОбъекты КАК АдресныеОбъекты
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.АдресныеОбъекты КАК АдресныеОбъектыУровень1
	|		ПО АдресныеОбъекты.РодительскийИдентификатор = АдресныеОбъектыУровень1.Идентификатор
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.АдресныеОбъекты КАК АдресныеОбъектыУровень2
	|		ПО (АдресныеОбъектыУровень1.РодительскийИдентификатор = АдресныеОбъектыУровень2.Идентификатор)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.АдресныеОбъекты КАК АдресныеОбъектыУровень3
	|		ПО (АдресныеОбъектыУровень2.РодительскийИдентификатор = АдресныеОбъектыУровень3.Идентификатор)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.АдресныеОбъекты КАК АдресныеОбъектыУровень4
	|		ПО (АдресныеОбъектыУровень3.РодительскийИдентификатор = АдресныеОбъектыУровень4.Идентификатор)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.АдресныеОбъекты КАК АдресныеОбъектыУровень5
	|		ПО (АдресныеОбъектыУровень4.РодительскийИдентификатор = АдресныеОбъектыУровень5.Идентификатор)
	|ГДЕ
	//|	АдресныеОбъекты.Наименование ПОДОБНО &НачалоФразы
	|	ВЫБОР
	|			КОГДА &ПоискПоКодуКЛАДР
	|				ТОГДА АдресныеОбъекты.КодКЛАДР = &КодКЛАДР
	|			ИНАЧЕ АдресныеОбъекты.Наименование = &НачалоФразы
	|		КОНЕЦ
	|	И АдресныеОбъекты.Уровень <> 7
	|	И АдресныеОбъекты.Уровень <> 41
	|	И АдресныеОбъекты.Уровень <> 31
	//++
	|	И АдресныеОбъекты.Уровень В (4, 6)
	//--
	|
	|УПОРЯДОЧИТЬ ПО
	|	АдресныеОбъекты.Уровень
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	МуниципальныеАдреса.Представление КАК Представление,
	|	МуниципальныеАдреса.Идентификатор КАК Идентификатор,
	//++
	|	МуниципальныеАдреса.КодКЛАДР КАК КодКЛАДР,
	//--
	|	МуниципальныеАдреса.Муниципальный КАК Муниципальный,
	|	МуниципальныеАдреса.ДополнительныеАдресныеСведения КАК ДополнительныеАдресныеСведения,
	|	ДополнительныеСведения.ПочтовыйИндекс КАК ПочтовыйИндекс,
	|	МуниципальныеАдреса.Уровень КАК Уровень
	|ИЗ
	|	МуниципальныеАдреса КАК МуниципальныеАдреса
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДополнительныеАдресныеСведения КАК ДополнительныеСведения
	|		ПО МуниципальныеАдреса.ДополнительныеАдресныеСведения = ДополнительныеСведения.Идентификатор
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	АдминистративныеАдреса.Представление,
	|	АдминистративныеАдреса.Идентификатор,
	//++
	|	АдминистративныеАдреса.КодКЛАДР КАК КодКЛАДР,
	//--
	|	АдминистративныеАдреса.Муниципальный,
	|	АдминистративныеАдреса.ДополнительныеАдресныеСведения,
	|	ДополнительныеСведения.ПочтовыйИндекс,
	|	АдминистративныеАдреса.Уровень
	|ИЗ
	|	АдминистративныеАдреса КАК АдминистративныеАдреса
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДополнительныеАдресныеСведения КАК ДополнительныеСведения
	|		ПО АдминистративныеАдреса.ДополнительныеАдресныеСведения = ДополнительныеСведения.Идентификатор
	|
	|УПОРЯДОЧИТЬ ПО
	|	Уровень";
	
КонецФункции

// полная копия Обработка.РасширенныйВводКонтактнойИнформации.Форма.ВводАдреса.Функция.ПредставлениеНаселенногоПунктаАдреса
Функция ПредставлениеНаселенногоПунктаАдреса(Адрес) Экспорт
	
	СписокЗаполненныхУровней = Новый Массив;
	
	Для каждого ИмяУровня Из РаботаСАдресамиКлиентСервер.ИменаУровнейАдреса(Адрес.AddressType, Ложь) Цикл
		
		Если СтрСравнить(ИмяУровня, "locality") = 0
			И РаботаСАдресамиКлиентСервер.ЭтоМуниципальныйАдрес(Адрес.AddressType)
			И ЗначениеЗаполнено(Адрес.city)
			И ПустаяСтрока(Адрес.locality) Тогда
				СписокЗаполненныхУровней.Добавить(Адрес["city"] + " " + Адрес["cityType"]);
			ИначеЕсли ЗначениеЗаполнено(Адрес[ИмяУровня]) Тогда
			
			Если НЕ РаботаСАдресамиКлиентСервер.ПредставлениеУровняБезСокращения(ИмяУровня) Тогда
				СписокЗаполненныхУровней.Добавить(Адрес[ИмяУровня] + " " + Адрес[ИмяУровня + "Type"]);
			Иначе
				СписокЗаполненныхУровней.Добавить(Адрес[ИмяУровня]);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Возврат СтрСоединить(СписокЗаполненныхУровней, ", ");
	
КонецФункции

Функция ИдентификаторГородаНаселенногоПункта(Город) Экспорт
	
	Если Не ЗначениеЗаполнено(Город) Тогда
		Возврат ОбщегоНазначенияКлиентСервер.ПустойУникальныйИдентификатор();
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	АдресныеОбъекты.Идентификатор КАК Идентификатор
	|ИЗ
	|	РегистрСведений.АдресныеОбъекты КАК АдресныеОбъекты
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Города КАК СправочникГорода
	|		ПО (СправочникГорода.Ссылка = &Город)
	|			И АдресныеОбъекты.КодКЛАДР = СправочникГорода.КодКЛАДР
	|			И НЕ СправочникГорода.КодКЛАДР = 0
	|ГДЕ
	|	АдресныеОбъекты.Уровень В (1, 4, 6)";
	
	Запрос.УстановитьПараметр("Город", Город);
	
	РезультатЗапроса = Запрос.Выполнить();		
	Если НЕ РезультатЗапроса.Пустой() Тогда			
		Возврат РезультатЗапроса.Выгрузить()[0].Идентификатор;
	КонецЕсли;
	
	Возврат ОбщегоНазначенияКлиентСервер.ПустойУникальныйИдентификатор();
	
КонецФункции	
				
Процедура ЗаполнитьКодыАдреса(Город, КодГорода, КодНасПункта, КодСубъектаРФ, ИдентификаторРодителя = Неопределено) Экспорт
	
	КодГорода = 0;
	КодНасПункта = 0;
	КодСубъектаРФ = 0;
	
	// №14051
	Если Не ИдентификаторРодителя = Неопределено Тогда
		ИдентификаторРодителя = Новый УникальныйИдентификатор("00000000-0000-0000-0000-000000000000");
	КонецЕсли;
	
	Если НЕ ПустаяСтрока(Город) Тогда
		
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("ЭтоМосква", ВРег(СокрЛП(Город)) = "МОСКВА");
		Запрос.УстановитьПараметр("Наименование", Строка(Город));
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	ВЫБОР
		|		КОГДА АдресныеОбъекты.Уровень = 4
		|				ИЛИ &ЭтоМосква
		|			ТОГДА АдресныеОбъекты.КодКЛАДР
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК КодГорода,
		|	ВЫБОР
		|		КОГДА АдресныеОбъекты.Уровень = 6
		|			ТОГДА АдресныеОбъекты.КодКЛАДР
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК КодНасПункта,
		|	АдресныеОбъекты.КодСубъектаРФ КАК КодСубъектаРФ,
		|	АдресныеОбъекты.Идентификатор КАК Идентификатор
		|ИЗ
		|	РегистрСведений.АдресныеОбъекты КАК АдресныеОбъекты
		|ГДЕ
		|	АдресныеОбъекты.Наименование = &Наименование
		|	И ВЫБОР
		|			КОГДА &ЭтоМосква
		|				ТОГДА АдресныеОбъекты.Уровень = 1
		|			ИНАЧЕ АдресныеОбъекты.Уровень В (4, 6)
		|		КОНЕЦ";
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Следующий() Тогда
			
			КодГорода = Выборка.КодГорода;
			КодНасПункта = Выборка.КодНасПункта;
			КодСубъектаРФ = Выборка.КодСубъектаРФ;
			
			Если Не ИдентификаторРодителя = Неопределено Тогда
				//Идентификатор города как ИдентификаторРодителя при поиске улиц
				ИдентификаторРодителя = Выборка.Идентификатор;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗагрузитьАдресаРегионаФиас2(КодСубъектаСтрокой) Экспорт
	
	ИДСубъекта = КодСубъектаСтрокой;
	Если Лев(КодСубъектаСтрокой, 1) = "0" Тогда
		ИДСубъекта = Сред(ИДСубъекта, 2);	
	КонецЕсли;
	
	ИмяФайлаZIP = КаталогВременныхФайлов() + КодСубъектаСтрокой + ".zip";
	Хост = "its.1c.ru";
	Ресурс = "/download/fias/download2?id=" + ИДСубъекта;
	
	Попытка
		
		HTTP =  Новый HTTPСоединение(Хост,,,,, 30, Новый ЗащищенноеСоединениеOpenSSL());		
		HTTPЗапрос = Новый HTTPЗапрос(Ресурс);	
		РезультатЗапроса = HTTP.Получить(HTTPЗапрос, ИмяФайлаZIP);
		
		Если РезультатЗапроса.КодСостояния = 200 Тогда
			
			Коды = Новый Массив;
			Коды.Добавить(Число(ИДСубъекта));
			
			ПараметрыЗагрузки = АдресныйКлассификаторСлужебный.ПараметрыЗагрузкиКлассификатораАдресов();
			ПараметрыЗагрузки.ОповещатьОПрогрессе = Ложь;
			
			ПараметрыМетода = Новый Массив;
			ПараметрыМетода.Добавить(Коды);			
			
			ОписаниеФайлов = Новый Массив;
			
			ДанныеФайла = Новый Структура("Имя, ВремяИзменения", ИмяФайлаZIP, ТекущаяДатаСеанса());
			
			ДвоичныеДанные = Новый ДвоичныеДанные(ИмяФайлаZIP);
			
			ДанныеФайла.Вставить("Хранение", ДвоичныеДанные); 
			ОписаниеФайлов.Добавить(ДанныеФайла);
			
			ПараметрыМетода.Добавить(ОписаниеФайлов);
			ПараметрыМетода.Добавить(ПараметрыЗагрузки);			
			
			АдресныйКлассификаторСлужебный.ФоновоеЗаданиеЗагрузкиКлассификатораАдресов(ПараметрыМетода, Неопределено); //ПараметрыВыполнения);
			
			УдалитьФайлы(ИмяФайлаZIP);
		КонецЕсли;
		
	Исключение
	КонецПопытки;
	
КонецПроцедуры 

Процедура ОбработкаВыбораАдресаИзКлассификатора(АдресJSON, Город, Адрес, ИдентификаторНаселенногоПункта) Экспорт
	
	АдресСтруктура = АдресныйКлассификаторСлужебный.JSONВКонтактнуюИнформациюПоПолям(АдресJSON);
	
	Регион = СокрЛП(АдресСтруктура.Area + " " + АдресСтруктура.AreaType);
	
	ГородНП = "";
	ИдентификаторНаселенногоПункта = Новый УникальныйИдентификатор("00000000-0000-0000-0000-000000000000");
		
	Если РаботаСАдресами.ЭтоГородФедеральногоЗначения(Регион) Тогда
		ГородНП = Регион;
		ИдентификаторНаселенногоПункта = АдресСтруктура.areaId;
		
	ИначеЕсли ЗначениеЗаполнено(АдресСтруктура.City) Тогда
		ГородНП = СокрЛП(АдресСтруктура.City + " " + АдресСтруктура.CityType);
		ИдентификаторНаселенногоПункта = АдресСтруктура.cityId;
		
	ИначеЕсли ЗначениеЗаполнено(АдресСтруктура.locality) Тогда    //если не указан город, ищем населенный пункт 
		ГородНП = СокрЛП(АдресСтруктура.locality + " " + АдресСтруктура.localityType);
		ИдентификаторНаселенногоПункта = АдресСтруктура.localityId;
	КонецЕсли;
		
	АдресПредставление = АдресСтруктура.value;
		
	// проверим не изменился ли город
	Если НЕ ИдентификаторНаселенногоПункта = Новый УникальныйИдентификатор("00000000-0000-0000-0000-000000000000") Тогда
		КодКЛАДРТекущий = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Город, "КодКЛАДР");
		Если НЕ КодКЛАДРТекущий = 0 Тогда
			Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1
			|	АдресныеОбъекты.КодКЛАДР КАК КодКЛАДР
			|ИЗ
			|	РегистрСведений.АдресныеОбъекты КАК АдресныеОбъекты
			|ГДЕ
			|	АдресныеОбъекты.Идентификатор = &Идентификатор");
			
			Запрос.УстановитьПараметр("Идентификатор", ИдентификаторНаселенногоПункта);
			
			РезультатЗапроса = Запрос.Выполнить();		
			Если НЕ РезультатЗапроса.Пустой() Тогда			
				КодКЛАДР = РезультатЗапроса.Выгрузить()[0].КодКЛАДР;
				
				Если НЕ КодКЛАДРТекущий = КодКЛАДР И НЕ КодКЛАДР = 0 Тогда
					Город = Справочники.Города.НайтиПоРеквизиту("КодКЛАДР", КодКЛАДР);				
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	ГородНПОпределен = ЗначениеЗаполнено(Город);
	
	Если НЕ ПустаяСтрока(ГородНП) И ГородНПОпределен Тогда
		// обрезаем адрес в части города / населенного пункта
		ПозГНП = СтрНайти(АдресПредставление, ГородНП);
		АдресПредставление = Сред(АдресПредставление, ПозГНП + СтрДлина(ГородНП) + 2);	// 2 это запятая + пробел			
	КонецЕсли;	
	Адрес = АдресПредставление;
		
КонецПроцедуры

#КонецОбласти

Функция ТекущееСостояниеФоновогоЗадания(КлючИлиИдентификаторЗадания) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("Наименование", "");
	Результат.Вставить("НеНайдено", Ложь);
	Результат.Вставить("Активно", Ложь);
	Результат.Вставить("Завершено", Ложь);
	Результат.Вставить("ЗавершеноАварийно", Ложь);
	Результат.Вставить("Отменено", Ложь);
	Результат.Вставить("Начало");
	Результат.Вставить("Конец");
	Результат.Вставить("ТекстОшибки", "");
	Результат.Вставить("Задание");
	
	Если ТипЗнч(КлючИлиИдентификаторЗадания) = Тип("Строка") Тогда
		
		ОтборЗаданий = Новый Структура("Ключ", КлючИлиИдентификаторЗадания);
		Задания      = ФоновыеЗадания.ПолучитьФоновыеЗадания(ОтборЗаданий);
		
		Если Задания.Количество() = 0 Тогда
			Задание = Неопределено;
		Иначе
			Задание = Задания[0];
		КонецЕсли;
		
	Иначе
		Задание = ФоновыеЗадания.НайтиПоУникальномуИдентификатору(КлючИлиИдентификаторЗадания);
	КонецЕсли;
	
	Если Задание = Неопределено Тогда
		
		Результат.НеНайдено = Истина;
		
		Если ТипЗнч(КлючИлиИдентификаторЗадания) = Тип("Строка") Тогда
			Результат.ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru='Фоновое задание с ключом ""%1"" не найдено.'"),
			СокрЛП(КлючИлиИдентификаторЗадания));
		Иначе
			Результат.ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru='Фоновое задание с идентификатором ""%1"" не найдено.'"),
			СокрЛП(КлючИлиИдентификаторЗадания));
		КонецЕсли;
		
		Возврат Результат;
		
	КонецЕсли;
	
	Результат.Задание 	   = Задание;
	Результат.Наименование = Задание.Наименование;
	Результат.Начало 	   = Задание.Начало;
	Результат.Конец 	   = Задание.Конец;
	
	Если Задание.Состояние = СостояниеФоновогоЗадания.Активно Тогда
		Результат.Активно = Истина;
	ИначеЕсли Задание.Состояние = СостояниеФоновогоЗадания.Завершено Тогда
		Результат.Завершено = Истина;
	ИначеЕсли Задание.Состояние = СостояниеФоновогоЗадания.ЗавершеноАварийно Тогда
		Результат.ЗавершеноАварийно = Истина;
		Результат.ТекстОшибки = ПодробноеПредставлениеОшибки(Задание.ИнформацияОбОшибке);
	ИначеЕсли Задание.Состояние = СостояниеФоновогоЗадания.Отменено Тогда
		Результат.Отменено = Истина;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура СозданиеЗаказаНаПроизводствоПоФоновомуЗаданию(ПараметрыЗадания, АдресРезультата = Неопределено) Экспорт
	
	ЗаказСсылка  = ПараметрыЗадания.Заказ;
	МассивНоменклатуры = Новый Массив;
	МассивНоменклатуры.Добавить(ПараметрыЗадания.Продукция);
	
	СтруктураВозврата = ОбщийМодуль.СоздатьЗаказыНаПроизводствоПоЗаказам(ЗаказСсылка, МассивНоменклатуры);	
	СтруктураВозврата.Вставить("МассивСообщений", ПолучитьСообщенияПользователю(Истина));
	
	ПоместитьВоВременноеХранилище(СтруктураВозврата, АдресРезультата);	
	
КонецПроцедуры

#Область РасширенныеСервисы

Функция ИспользуютсяРасширенныеСервисы() Экспорт
	
	ТаблицаРасширенныхСервисов = ОбщийМодуль.ТаблицаРасширенныхСервисов();
	Результат = Ложь;
	Для Каждого ТекСтрока Из ТаблицаРасширенныхСервисов Цикл
		Результат = Результат ИЛИ (ЗначениеЗаполнено(ТекСтрока.ИмяКонстанты) И Константы[ТекСтрока.ИмяКонстанты].Получить());
	КонецЦикла;
	
	// Сервис IP телефонии зависит от нескольких констант (Когда включен Коннектор и включена телефония)
	//Результат = Результат Или (Константы.ВариантБиблиотекиТелефонии.Получить() = 0 И СофтФон.ИспользуетсяИнтеграцияСIPАТС());
	
	Возврат Результат;
	
КонецФункции		

Процедура ПроверкаРасширенныхСервисовПоФоновомуЗаданию(ПараметрыЗадания, АдресРезультата = Неопределено) Экспорт
	
	СтруктураВозврата = Новый Структура("ЕстьОшибкаПроверки, Сообщения", Ложь, Новый Массив);
	ХЗ = Константы.НаличиеПодпискиНаРасширенныеСервисы.Получить();
	СтруктураСервисы = ХЗ.Получить();
	Если ТипЗнч(СтруктураСервисы) = Тип("Структура") Тогда
		СоответствиеСервисов = Новый Соответствие;
		ТаблицаСервисы = СтруктураСервисы.Сервисы; // ТаблицаСервисы( Ид - строка, ДоступенДо - Дата)
	Иначе
		ТаблицаСервисы = Неопределено;
		СтруктураВозврата.ЕстьОшибкаПроверки = Истина;
	КонецЕсли;
	
	ТаблицаРасширенныхСервисов = ОбщийМодуль.ТаблицаРасширенныхСервисов();
	Для Каждого ТекСтрока Из ТаблицаРасширенныхСервисов Цикл
		//Если ТекСтрока.ИдСервиса = "16" Тогда
		//использование данного сервиса ("Коннектор") определяется по двум условиям - ИспользуетсяТелефония+ВариантБиблиотекиТелефонии
		// переделано на константу ИспользоватьСервисSmartConnector
		//	НастройкаВключена = (СофтФон.ИспользуетсяИнтеграцияСIPАТС()) И (Константы.ВариантБиблиотекиТелефонии.Получить()=0)
		//Иначе
		НастройкаВключена = Константы[ТекСтрока.ИмяКонстанты].Получить();
		//КонецЕсли;
		Если НастройкаВключена Тогда
			Если ТаблицаСервисы = Неопределено Тогда
				ТекстСообщения = "Сервис """ + ТекСтрока.НаименованиеСервиса + """ неактивен: отключите в настройках программы или подключите в личном кабинете";
				ЦветСообщения = WebЦвета.Красный;
				СтруктураВозврата.ЕстьОшибкаПроверки = Истина;
			Иначе
				СтрокаТЗ = ТаблицаСервисы.Найти(ТекСтрока.ИдСервиса, "Ид");
				Если НЕ СтрокаТЗ = Неопределено Тогда
					ДоступенДо = НачалоДня(СтрокаТЗ.ДоступенДо);
					ТекДата = НачалоДня(ТекущаяДатаСеанса());
					РазницаВДнях = (ДоступенДо - ТекДата) / 86400; 
					
					Если РазницаВДнях < 0 Тогда
						ТекстСообщения = "Сервис """ + ТекСтрока.НаименованиеСервиса + """ неактивен: отключите в настройках программы или подключите в личном кабинете";
						ЦветСообщения = WebЦвета.Красный;
						СтруктураВозврата.ЕстьОшибкаПроверки = Истина;
					ИначеЕсли РазницаВДнях < 30 Тогда
						ТекстСообщения = "Срок подписки на сервис """ + ТекСтрока.НаименованиеСервиса + """ истекает через " + РазницаВДнях + " дней. Вам нужно продлить действие сервиса в личном кабинете";
						ЦветСообщения = WebЦвета.Оранжевый;
						СтруктураВозврата.ЕстьОшибкаПроверки = Истина;
					ИначеЕсли РазницаВДнях >= 30 Тогда
						ТекстСообщения = "Сервис """ + ТекСтрока.НаименованиеСервиса + """ активен. Срок действия до " + Формат(ДоступенДо,"ДЛФ=DD" );
						ЦветСообщения = WebЦвета.Зеленый;
						СтруктураВозврата.ЕстьОшибкаПроверки = Истина;	
					Иначе
						Продолжить; // №11718 если всё ок, нужно продолжить, чтобы не добавлялась предыдущая ошибка
					КонецЕсли;
				Иначе
					ТекстСообщения = "Сервис """ + ТекСтрока.НаименованиеСервиса + """ неактивен: отключите в настройках программы или подключите в личном кабинете";
					ЦветСообщения = WebЦвета.Красный;
					СтруктураВозврата.ЕстьОшибкаПроверки = Истина;
				КонецЕсли;				
			КонецЕсли;
			СтруктураВозврата.Сообщения.Добавить(Новый Структура("ТекстСообщения, ЦветСообщения", ТекстСообщения, ЦветСообщения));	
		КонецЕсли;
	КонецЦикла;
	
	ПоместитьВоВременноеХранилище(СтруктураВозврата, АдресРезультата);
	
КонецПроцедуры

#КонецОбласти

#Область ЦеныНаУслугиПроизводства

//#11866
Процедура ПроверитьПересечениеИнтерваловВЦенахНаУслугиПроизводства(Источник, МетаданныеИсточника, Отказ, ВыводСообщения = Истина) Экспорт
	
	Для каждого ТабличнаяЧасть из МетаданныеИсточника.ТабличныеЧасти Цикл
		
		ИмяТЧ = ТабличнаяЧасть.Имя;		
		КоличествоСтрок = Источник[ИмяТЧ].Количество();
		
		// №12223 для установки цен услуг раскроя (типовых и индивидуальных) для варианта "Оценка по каждому заданному диапазону" проверка пересечения не требуется
		Если (МетаданныеИсточника = Метаданные.Справочники.ЦеныУслугРаскроя ИЛИ МетаданныеИсточника = Метаданные.Документы.УстановкаИндивидуальныхЦенНаУслугиПроизводства)
			И Источник["ВариантОценки" + ИмяТЧ] = Перечисления.ВариантыОценкиСтоимостиУслугПроизводства.ОценкаПоКаждомуЗаданномуДиапазону Тогда
			Продолжить;
		КонецЕсли;
		
		Для Индекс1 = 1 по КоличествоСтрок Цикл
			Для Индекс2 = 1 по КоличествоСтрок Цикл
				Если Индекс1 >= Индекс2 Тогда
					Продолжить;
				КонецЕсли;
				СтрокаТЧ1 = Источник[ИмяТЧ][Индекс1-1];
				СтрокаТЧ2 = Источник[ИмяТЧ][Индекс2-1];
				Если ОбщийМодульКлиентСервер.ПроверитьПересечениеИнтервалов(СтрокаТЧ1.КоличествоОт, СтрокаТЧ1.КоличествоДо, СтрокаТЧ2.КоличествоОт, СтрокаТЧ2.КоличествоДо) Тогда
					//#12301 не отказываем
					//#12345 возвращаем Отказ
					Если ВыводСообщения Тогда
						ТекстСообщения = СтрШаблон("В таблице %1 пересекаются диапазоны значений в строках %2 и %3", ТабличнаяЧасть.Синоним, Индекс1, Индекс2);						
						ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, , , , Отказ);
					Иначе
						Отказ = Истина;	
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область Отчеты

Функция ПолучитьДатуПоПараметру(ПараметрСКД, ЗначениеПоУмолчанию = Неопределено) Экспорт
	
	Если ЗначениеПоУмолчанию = Неопределено Тогда
		ЗначениеПоУмолчанию = Дата(1,1,1);
	КонецЕсли;
	
	ЗначениеДаты = ЗначениеПоУмолчанию;
	Если Не ПараметрСКД = Неопределено Тогда
		Если ТипЗнч(ПараметрСКД) = Тип("Дата") Тогда
			ЗначениеДаты = ПараметрСКД;
		ИначеЕсли ТипЗнч(ПараметрСКД.Значение) = Тип("Дата") Тогда
			ЗначениеДаты = ПараметрСКД.Значение;
		ИначеЕсли ТипЗнч(ПараметрСКД.Значение) = Тип("СтандартнаяДатаНачала") Тогда
			ЗначениеДаты = ПараметрСКД.Значение.Дата;
		КонецЕсли;
	КонецЕсли;
	
	Возврат ЗначениеДаты;
	
КонецФункции

#Область Эффективности

//++ №11768 "Эффективность по лидам" формируем запрос используя внешние наборы данных
Функция СформироватьДанныеВоВременныеТаблицы(МенеджерВТ, НачалоПериода, КонецПериода, Вид) Экспорт
	
	Запрос = новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	КонверсияВходящихКонтактовОбороты.Контакт КАК Контакт,
	|	ВЫБОР
	|		КОГДА &Вид = ""Менеджер""
	//++ №13645 формируем по сотрудникам
	//|			ТОГДА КонверсияВходящихКонтактовОбороты.Контакт.Автор
	|			ТОГДА КонверсияВходящихКонтактовОбороты.Контакт.Автор.Сотрудник
	//-- №13645
	|		КОГДА &Вид = ""ВидКонтакта""
	|			ТОГДА КонверсияВходящихКонтактовОбороты.Контакт.ВидКонтакта
	|		КОГДА &Вид = ""РекламнаяАкция""
	|			ТОГДА КонверсияВходящихКонтактовОбороты.Контакт.РекламнаяАкция
	|		КОГДА &Вид = ""РекламныйИсточник""
	|			ТОГДА КонверсияВходящихКонтактовОбороты.Контакт.РекламныйИсточник
	|		КОГДА &Вид = ""ТочкаПродаж""
	|			ТОГДА КонверсияВходящихКонтактовОбороты.Контакт.ТочкаПродаж
	|		КОГДА &Вид = ""Розница""
	|			ТОГДА ЗНАЧЕНИЕ(Документ.Лид.ПустаяСсылка)
	|		ИНАЧЕ NULL
	|	КОНЕЦ КАК Показатель
	|ПОМЕСТИТЬ ВТ_ПоказательЛиды
	|ИЗ
	|	РегистрНакопления.КонверсияВходящихКонтактов.Обороты(,, Регистратор, ) КАК КонверсияВходящихКонтактовОбороты
	|ГДЕ
	|	(КонверсияВходящихКонтактовОбороты.Контакт.Дата МЕЖДУ &НачалоПериода И &КонецПериода
	|			ИЛИ КонверсияВходящихКонтактовОбороты.Регистратор.Дата МЕЖДУ &НачалоПериода И &КонецПериода
	//#13654 дата выполнения и закрытия по монтажу перенесены в отдельные реквизиты
	|			ИЛИ ВЫБОР КОГДА КонверсияВходящихКонтактовОбороты.Регистратор ССЫЛКА Документ.Монтаж 
	|					ТОГДА ВЫРАЗИТЬ(КонверсияВходящихКонтактовОбороты.Регистратор КАК Документ.Монтаж).ДатаВыполнения МЕЖДУ &НачалоПериода И &КонецПериода
	|						ИЛИ ВЫРАЗИТЬ(КонверсияВходящихКонтактовОбороты.Регистратор КАК Документ.Монтаж).ДатаЗакрытия МЕЖДУ &НачалоПериода И &КонецПериода
	|					ИНАЧЕ ЛОЖЬ
	|				КОНЕЦ)
	|
	|СГРУППИРОВАТЬ ПО
	|	КонверсияВходящихКонтактовОбороты.Контакт,
	|	ВЫБОР
	|		КОГДА &Вид = ""Менеджер""
	//++ №13645 формируем по сотрудникам
	//|			ТОГДА КонверсияВходящихКонтактовОбороты.Контакт.Автор
	|			ТОГДА КонверсияВходящихКонтактовОбороты.Контакт.Автор.Сотрудник
	//-- №13645
	|		КОГДА &Вид = ""ВидКонтакта""
	|			ТОГДА КонверсияВходящихКонтактовОбороты.Контакт.ВидКонтакта
	|		КОГДА &Вид = ""РекламнаяАкция""
	|			ТОГДА КонверсияВходящихКонтактовОбороты.Контакт.РекламнаяАкция
	|		КОГДА &Вид = ""РекламныйИсточник""
	|			ТОГДА КонверсияВходящихКонтактовОбороты.Контакт.РекламныйИсточник
	|		КОГДА &Вид = ""ТочкаПродаж""
	|			ТОГДА КонверсияВходящихКонтактовОбороты.Контакт.ТочкаПродаж
	|		КОГДА &Вид = ""Розница""
	|			ТОГДА ЗНАЧЕНИЕ(Документ.Лид.ПустаяСсылка)
	|		ИНАЧЕ NULL
	|	КОНЕЦ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЗаказДоговорТоварыУслуги.Ссылка КАК ЗаказДоговор,
	|	ЗаказДоговорТоварыУслуги.Ссылка.Основание КАК Основание,
	|	СУММА(ЗаказДоговорТоварыУслуги.Количество * ЗаказДоговорТоварыУслуги.Коэффициент) КАК Площадь
	|ПОМЕСТИТЬ ВТ_ПлощадиПоЗаказам
	|ИЗ
	|	Документ.ЗаказДоговор.ТоварыУслуги КАК ЗаказДоговорТоварыУслуги
	|ГДЕ
	|	(ЗаказДоговорТоварыУслуги.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Справочник.ВидыНоменклатуры.Потолок)
	|			ИЛИ ЗаказДоговорТоварыУслуги.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Справочник.ВидыНоменклатуры.Отрез)
	|			ИЛИ ЗаказДоговорТоварыУслуги.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Справочник.ВидыНоменклатуры.ТиповойОтрез)
	|			ИЛИ ЗаказДоговорТоварыУслуги.Номенклатура.УчитыватьКакПотолокВОтчетахПоЭффективности)
	|	И ЗаказДоговорТоварыУслуги.Ссылка.Проведен
	|	И НЕ ЗаказДоговорТоварыУслуги.Ссылка.ПометкаУдаления
	|{ГДЕ
	|	(ЗаказДоговорТоварыУслуги.Ссылка.Основание.Дата >= &НачалоПериода
	|				И ЗаказДоговорТоварыУслуги.Ссылка.Основание.Дата <= &КонецПериода
	|			ИЛИ ЗаказДоговорТоварыУслуги.Ссылка.Дата >= &НачалоПериода
	|				И ЗаказДоговорТоварыУслуги.Ссылка.Дата <= &КонецПериода) КАК Поле2}
	|
	|СГРУППИРОВАТЬ ПО
	|	ЗаказДоговорТоварыУслуги.Ссылка,
	|	ЗаказДоговорТоварыУслуги.Ссылка.Основание
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ПродажиПоЗаказДоговорамОбороты.Регистратор КАК ЗаказДоговор,
	|	ПродажиПоЗаказДоговорамОбороты.Регистратор.Основание КАК Основание,
	|	СУММА(ПродажиПоЗаказДоговорамОбороты.СуммаОборот) КАК СреднийЧекСумма
	|ПОМЕСТИТЬ ВТ_ОбщиеПродажи
	|ИЗ
	|	РегистрНакопления.ПродажиПоЗаказДоговорам.Обороты(, , Регистратор, ) КАК ПродажиПоЗаказДоговорамОбороты,
	|	Константа.ВсяНоменклатураПоУмолчаниюВСреднемЧеке КАК ВсяНоменклатураПоУмолчаниюВСреднемЧеке
	|ГДЕ
	|	ВЫБОР
	|			КОГДА ВсяНоменклатураПоУмолчаниюВСреднемЧеке.Значение
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ПродажиПоЗаказДоговорамОбороты.Номенклатура.УчитыватьВСреднемЧеке = ИСТИНА
	|		КОНЕЦ
	|
	|СГРУППИРОВАТЬ ПО
	|	ПродажиПоЗаказДоговорамОбороты.Регистратор,
	|	ПродажиПоЗаказДоговорамОбороты.Регистратор.Основание
	|";
	
	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", ?(ЗначениеЗаполнено(КонецПериода), КонецДня(КонецПериода), ТекущаяДатаСеанса()));
	Запрос.УстановитьПараметр("Вид", Вид);
	
	Возврат Запрос.Выполнить();
	
КонецФункции

Функция ПолучитьТаблицуПоДатеЛида(МенеджерВТ, НачалоПериода, КонецПериода, РасширятьТипПоляПоказатель= Истина) Экспорт
	
	Запрос = новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Замеры.ДокументЗамер КАК Лид,
	|	СУММА(1) КАК КоличествоЗамеров,
	|	СУММА(ВЫБОР
	|			КОГДА Замеры.ЗамерВыполнен
	|				ТОГДА 1
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК КоличествоВыполненныхЗамеров,
	|	СУММА(ВЫБОР
	|			КОГДА Замеры.Результат = ЗНАЧЕНИЕ(Справочник.РезультатЗамераЛида.ЗаключенДоговор)
	|				ТОГДА 1
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК КоличествоЗамеровУспех,
	|	СУММА(ВЫБОР
	|			КОГДА Замеры.Результат = ЗНАЧЕНИЕ(Справочник.РезультатЗамераЛида.ДоговорНеЗаключен)
	|				ТОГДА 1
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК КоличествоЗамеровОтказ,
	|	СУММА(ВЫБОР
	|			КОГДА Замеры.Результат = ЗНАЧЕНИЕ(Справочник.РезультатЗамераЛида.ЗамерНеПроизводился)
	|				ТОГДА 1
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК КоличествоЗамеровНевыполнен,
	|	СУММА(ВЫБОР
	|			КОГДА Замеры.Результат = ЗНАЧЕНИЕ(Справочник.РезультатЗамераЛида.ЗаключенДоговор)
	|				ТОГДА 1
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК КоличествоДоговоровНаЗамерах
	|ПОМЕСТИТЬ ВТ_ПоказателиЗамеровЛида
	|ИЗ
	|	РегистрСведений.Замеры КАК Замеры
	|ГДЕ
	|	НЕ Замеры.Результат = ЗНАЧЕНИЕ(Справочник.РезультатЗамераЛида.ЗамерОтменен)
	|	И Замеры.ДокументЗамер.Дата МЕЖДУ &НачалоПериода И &КонецПериода
	|	И НЕ Замеры.ЭтоВыезд
	|
	|СГРУППИРОВАТЬ ПО
	|	Замеры.ДокументЗамер
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	КонверсияВходящихКонтактовОбороты.Контакт КАК Контакт,
	|	СУММА(ВЫБОР
	|			КОГДА НЕ КонверсияВходящихКонтактовОбороты.Контакт.ТекущийСтатус В (ЗНАЧЕНИЕ(Справочник.СтатусыЛида.НеЦелевой), ЗНАЧЕНИЕ(Справочник.СтатусыЛида.Обращение))
	|				ТОГДА КонверсияВходящихКонтактовОбороты.КоличествоЛидовОборот
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК КоличествоЦелевыхКонтактов,
	|	СУММА(ВЫБОР
	|			КОГДА КонверсияВходящихКонтактовОбороты.Регистратор = КонверсияВходящихКонтактовОбороты.Контакт
	|				ТОГДА КонверсияВходящихКонтактовОбороты.КоличествоЛидовОборот
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК КоличествоКонтактов,
	|	СУММА(ВЫБОР
	|			КОГДА ТИПЗНАЧЕНИЯ(КонверсияВходящихКонтактовОбороты.Регистратор) = ТИП(Документ.ЗаказДоговор)
	|				ТОГДА КонверсияВходящихКонтактовОбороты.КоличествоДоговоровОборот
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК КоличествоДоговоров
	|ПОМЕСТИТЬ ВТ_ПоЛидам
	|ИЗ
	|	РегистрНакопления.КонверсияВходящихКонтактов.Обороты(, , Регистратор, Контакт.Дата МЕЖДУ &НачалоПериода И &КонецПериода) КАК КонверсияВходящихКонтактовОбороты
	|
	|СГРУППИРОВАТЬ ПО
	|	КонверсияВходящихКонтактовОбороты.Контакт
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ПоказательЛиды.Контакт КАК Контакт,
	//++ №13645
	//|	ВТ_ПоказательЛиды.Показатель КАК Показатель,
	|	ЕСТЬNULL(ВТ_ПоказательЛиды.Показатель, ""(неопределено)"") КАК Показатель,
	//-- №13645
	|	СУММА(ВТ_ПоЛидам.КоличествоЦелевыхКонтактов) КАК КоличествоЦелевыхКонтактов,
	|	СУММА(ВТ_ПоЛидам.КоличествоКонтактов) КАК КоличествоКонтактов,
	|	СУММА(ВТ_ПоЛидам.КоличествоДоговоров) КАК КоличествоДоговоров,
	|	СУММА(ЕСТЬNULL(ВТ_ПоказателиЗамеровЛида.КоличествоЗамеров, 0)) КАК КоличествоЗамеров,
	|	СУММА(ЕСТЬNULL(ВТ_ПоказателиЗамеровЛида.КоличествоВыполненныхЗамеров, 0)) КАК КоличествоВыполненныхЗамеров,
	|	СУММА(ЕСТЬNULL(ВТ_ПоказателиЗамеровЛида.КоличествоЗамеровУспех, 0)) КАК КоличествоЗамеровУспех,
	|	СУММА(ЕСТЬNULL(ВТ_ПоказателиЗамеровЛида.КоличествоЗамеровОтказ, 0)) КАК КоличествоЗамеровОтказ,
	|	СУММА(ЕСТЬNULL(ВТ_ПоказателиЗамеровЛида.КоличествоЗамеровНевыполнен, 0)) КАК КоличествоЗамеровНевыполнен,
	|	СУММА(ЕСТЬNULL(ВТ_ПоказателиЗамеровЛида.КоличествоДоговоровНаЗамерах, 0)) КАК КоличествоДоговоровНаЗамерах
	|ИЗ
	|	ВТ_ПоказательЛиды КАК ВТ_ПоказательЛиды
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ПоЛидам КАК ВТ_ПоЛидам
	|		ПО ВТ_ПоказательЛиды.Контакт = ВТ_ПоЛидам.Контакт
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ПоказателиЗамеровЛида КАК ВТ_ПоказателиЗамеровЛида
	|		ПО ВТ_ПоказательЛиды.Контакт = ВТ_ПоказателиЗамеровЛида.Лид
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_ПоказательЛиды.Контакт,
	|	ВТ_ПоказательЛиды.Показатель";
	
	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", ?(ЗначениеЗаполнено(КонецПериода), КонецДня(КонецПериода), ТекущаяДатаСеанса()));
	
	ТаблицаРезультат = Запрос.Выполнить().Выгрузить();
	
	Если РасширятьТипПоляПоказатель Тогда
		//++ в колонке показатель кроме показателя еще может быть текст
		КС = Новый КвалификаторыСтроки(20);
		//КЧ = Новый КвалификаторыЧисла(1, 0, ДопустимыйЗнак.Любой);		
		МассивТипов = ТаблицаРезультат.Колонки.Показатель.ТипЗначения.Типы();
		МассивТипов.Добавить(Тип("Строка"));
		//МассивТипов.Добавить(Тип("Число"));
		ОписаниеТиповС = Новый ОписаниеТипов(МассивТипов, , КС);
		ТаблицаРезультат.Колонки.Добавить("Показатель1", ОписаниеТиповС);
		Для каждого СтрокаТЧ из ТаблицаРезультат Цикл
			СтрокаТЧ.Показатель1 = СтрокаТЧ.Показатель; 	
		КонецЦикла;
		ТаблицаРезультат.Колонки.Показатель.Имя = "Показатель_Врем";
		ТаблицаРезультат.Колонки.Показатель1.Имя = "Показатель";
		ТаблицаРезультат.Колонки.Удалить("Показатель_Врем"); 
	КонецЕсли;
	
	Возврат ТаблицаРезультат;
	
КонецФункции

Функция ПолучитьТаблицуПоДатеЛидаПродолжение(МенеджерВТ, НачалоПериода, КонецПериода) Экспорт
	
	Запрос = новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ПредварительныйРасчет.Основание КАК Лид,
	|	СУММА(1) КАК КоличествоРасчетов,
	|	СУММА(ПредварительныйРасчет.СуммаДокумента) КАК Сумма,
