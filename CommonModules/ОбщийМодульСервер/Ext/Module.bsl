		РезультатЗапроса = Запрос.ВыполнитьПакет();
		ВыборкаВсего = РезультатЗапроса[2].Выбрать();
	Иначе
		РезультатЗапроса = Запрос.ВыполнитьПакет();
		ВыборкаВсего = РезультатЗапроса[3].Выбрать();
	КонецЕсли;
	
	//ФлагАктуальности = "";
	ТребуетсяЗапись = Ложь;
	МенеджерЗаписи = РегистрыСведений.КоличествоЛидов.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Автор = Автор;
	МенеджерЗаписи.Прочитать();
	//Если МенеджерЗаписи.Выбран() Тогда
	//	ФлагАктуальности = МенеджерЗаписи.ФлагАктуальности;		
	//КонецЕсли;
	
	Если ВыборкаВсего.Следующий() Тогда
		Если НЕ МенеджерЗаписи.ЛидыНовыеВсего = ВыборкаВсего.ЛидыНовыеВсего
			ИЛИ НЕ МенеджерЗаписи.ЛидыНовыеВРаботе = ВыборкаВсего.ЛидыНовыеВРаботе
			
			ИЛИ НЕ МенеджерЗаписи.ЛидыЗаявкаНаЗамерВсего = ВыборкаВсего.ЛидыЗаявкаНаЗамерВсего
			ИЛИ НЕ МенеджерЗаписи.ЛидыЗаявкаНаЗамерВРаботе = ВыборкаВсего.ЛидыЗаявкаНаЗамерВРаботе
			
			ИЛИ НЕ МенеджерЗаписи.ЛидыОтложенныеЗамерыВсего = ВыборкаВсего.ЛидыОтложенныеЗамерыВсего
			ИЛИ НЕ МенеджерЗаписи.ЛидыОтложенныеЗамерыВРаботе = ВыборкаВсего.ЛидыОтложенныеЗамерыВРаботе
			
			ИЛИ НЕ МенеджерЗаписи.ЛидыРасчетДоЗамераВРаботе = ВыборкаВсего.ЛидыРасчетДоЗамераВРаботе
			ИЛИ НЕ МенеджерЗаписи.ЛидыРасчетДоЗамераВсего = ВыборкаВсего.ЛидыРасчетДоЗамераВсего
			
			ИЛИ НЕ МенеджерЗаписи.ЛидыОбработкаПослеЗамераВРаботе = ВыборкаВсего.ЛидыОбработкаПослеЗамераВРаботе
			ИЛИ НЕ МенеджерЗаписи.ЛидыОбработкаПослеЗамераВсего = ВыборкаВсего.ЛидыОбработкаПослеЗамераВсего
			
			ИЛИ НЕ МенеджерЗаписи.ЛидыОтложенныеДоговорыВсего = ВыборкаВсего.ЛидыОтложенныеДоговорыВсего
			ИЛИ НЕ МенеджерЗаписи.ЛидыОтложенныеДоговорыВРаботе = ВыборкаВсего.ЛидыОтложенныеДоговорыВРаботе
			
			ИЛИ НЕ МенеджерЗаписи.ЛидыОформитьДоговорВсего = ВыборкаВсего.ЛидыОформитьДоговорВсего
			ИЛИ НЕ МенеджерЗаписи.ЛидыДоговорОформленВсего = ВыборкаВсего.ЛидыДоговорОформленВсего

			ИЛИ НЕ МенеджерЗаписи.ЛидыОтказныеВсего = ВыборкаВсего.ЛидыОтказныеВсего
			ИЛИ НЕ МенеджерЗаписи.ЛидыНецелевыеВсего = ВыборкаВсего.ЛидыНецелевыеВсего
			
			ИЛИ НЕ МенеджерЗаписи.ЛидыОбращениеВсего = ВыборкаВсего.ЛидыОбращениеВсего
			ИЛИ НЕ МенеджерЗаписи.ЛидыОбращениеВРаботе = ВыборкаВсего.ЛидыОбращениеВРаботе

			ИЛИ НЕ МенеджерЗаписи.ЛидыВсеВсего = ВыборкаВсего.ЛидыВсеВсего
			Тогда
			
			МенеджерЗаписи.ЛидыНовыеВсего = ВыборкаВсего.ЛидыНовыеВсего;
			МенеджерЗаписи.ЛидыНовыеВРаботе = ВыборкаВсего.ЛидыНовыеВРаботе;
			
			МенеджерЗаписи.ЛидыЗаявкаНаЗамерВсего = ВыборкаВсего.ЛидыЗаявкаНаЗамерВсего;
			МенеджерЗаписи.ЛидыЗаявкаНаЗамерВРаботе = ВыборкаВсего.ЛидыЗаявкаНаЗамерВРаботе;

			МенеджерЗаписи.ЛидыОтложенныеЗамерыВсего = ВыборкаВсего.ЛидыОтложенныеЗамерыВсего;
			МенеджерЗаписи.ЛидыОтложенныеЗамерыВРаботе = ВыборкаВсего.ЛидыОтложенныеЗамерыВРаботе;
			
			МенеджерЗаписи.ЛидыРасчетДоЗамераВРаботе = ВыборкаВсего.ЛидыРасчетДоЗамераВРаботе;
			МенеджерЗаписи.ЛидыРасчетДоЗамераВсего = ВыборкаВсего.ЛидыРасчетДоЗамераВсего;
			
			МенеджерЗаписи.ЛидыОбработкаПослеЗамераВРаботе = ВыборкаВсего.ЛидыОбработкаПослеЗамераВРаботе;
			МенеджерЗаписи.ЛидыОбработкаПослеЗамераВсего = ВыборкаВсего.ЛидыОбработкаПослеЗамераВсего;
			
			МенеджерЗаписи.ЛидыОтложенныеДоговорыВсего = ВыборкаВсего.ЛидыОтложенныеДоговорыВсего;
			МенеджерЗаписи.ЛидыОтложенныеДоговорыВРаботе = ВыборкаВсего.ЛидыОтложенныеДоговорыВРаботе;
			
			МенеджерЗаписи.ЛидыОформитьДоговорВсего = ВыборкаВсего.ЛидыОформитьДоговорВсего;
			МенеджерЗаписи.ЛидыДоговорОформленВсего = ВыборкаВсего.ЛидыДоговорОформленВсего;
			
			МенеджерЗаписи.ЛидыОбращениеВсего = ВыборкаВсего.ЛидыОбращениеВсего;
			МенеджерЗаписи.ЛидыОбращениеВРаботе = ВыборкаВсего.ЛидыОбращениеВРаботе;
			
			МенеджерЗаписи.ЛидыОтказныеВсего = ВыборкаВсего.ЛидыОтказныеВсего;
			МенеджерЗаписи.ЛидыНецелевыеВсего = ВыборкаВсего.ЛидыНецелевыеВсего;
			
			МенеджерЗаписи.ЛидыВсеВсего = ВыборкаВсего.ЛидыВсеВсего;
			ТребуетсяЗапись = Истина;
		КонецЕсли;
	КонецЕсли;
	
	Если ТребуетсяЗапись Тогда
		МенеджерЗаписи.Автор = Автор;
		МенеджерЗаписи.ФлагАктуальности = Строка(Новый УникальныйИдентификатор);
		
		НачатьТранзакцию();
		Попытка
			МенеджерЗаписи.Записать();
			ЗафиксироватьТранзакцию();
			
			//СообщитьОРасчетеКоличестваЛидов(МенеджерЗаписи);
		Исключение
			ОтменитьТранзакцию();
			СообщитьОНеудачномРасчетеКоличестваЛидов();
		КонецПопытки;
		
	КонецЕсли;

КонецПроцедуры

Процедура СообщитьОНеудачномРасчетеКоличестваЛидов()
	
	ТекстСообщения = НСтр("ru = 'Задание расчет количества лидов завершилось неудачно по причине: %Причина%'");
	ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Причина%", ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	СобытиеЖурнала = НСтр("ru = 'Расчет количества лидов'", ОбщегоНазначения.КодОсновногоЯзыка());
	ЗаписьЖурналаРегистрации(СобытиеЖурнала,
		УровеньЖурналаРегистрации.Ошибка, Метаданные.РегистрыСведений.КоличествоЛидов,, ТекстСообщения);
	
КонецПроцедуры

Процедура СообщитьОРасчетеКоличестваЛидов(МенеджерЗаписи)
			
	// для отладки при необходимости
	ТекстСообщения = СтрШаблон("%1 - %2 | %3 | %4 | %5 | %6 | %7 | %8 | %9", 
																МенеджерЗаписи.Автор, МенеджерЗаписи.ЛидыВсеВсего,
																СтрШаблон("%1/%2", МенеджерЗаписи.ЛидыНовыеВсего, МенеджерЗаписи.ЛидыНовыеВРаботе),
																СтрШаблон("%1/%2", МенеджерЗаписи.ЛидыЗаявкаНаЗамерВсего, МенеджерЗаписи.ЛидыЗаявкаНаЗамерВРаботе),
																СтрШаблон("%1/%2", МенеджерЗаписи.ЛидыОтложенныеЗамерыВсего, МенеджерЗаписи.ЛидыОтложенныеЗамерыВРаботе),
																СтрШаблон("%1/%2", МенеджерЗаписи.ЛидыОтложенныеДоговорыВсего, МенеджерЗаписи.ЛидыОтложенныеДоговорыВРаботе),
																СтрШаблон("%1/%2", МенеджерЗаписи.ЛидыОформитьДоговорВсего, МенеджерЗаписи.ЛидыДоговорОформленВсего),
																СтрШаблон("%1/%2", МенеджерЗаписи.ЛидыОбращениеВсего, МенеджерЗаписи.ЛидыОбращениеВРаботе),
																СтрШаблон("%1/%2", МенеджерЗаписи.ЛидыОтказныеВсего, МенеджерЗаписи.ЛидыНецелевыеВсего)
																);
	СобытиеЖурнала = НСтр("ru = 'Расчет количества лидов'", ОбщегоНазначения.КодОсновногоЯзыка());													
	ЗаписьЖурналаРегистрации(СобытиеЖурнала,
				УровеньЖурналаРегистрации.Предупреждение, Метаданные.РегистрыСведений.КоличествоЛидов,, ТекстСообщения);

КонецПроцедуры
			
