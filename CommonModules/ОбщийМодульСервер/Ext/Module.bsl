	КонецЕсли;
	
	СтруктураПараметров = Новый Структура;
	Если ТипЗнч(ДанныеПечати.Ссылка) = Тип("ДокументСсылка.Монтаж") Тогда
			СтруктураПараметров.Вставить("ДатаДокумента", Формат(ОбщийМодульСервер.ПолучитьДатуПодписанияДокументаМонтажа(ДанныеПечати.Ссылка), "ДЛФ=Д"));
	Иначе
			СтруктураПараметров.Вставить("ДатаДокумента", Формат(ДанныеПечати.Дата, "ДЛФ=Д"));
