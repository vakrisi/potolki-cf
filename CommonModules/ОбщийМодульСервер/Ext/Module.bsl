Функция ПолучитьДатуПоследнегоЗапускаОтчетаЭкспрессПроверки() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЕСТЬNULL(МАКСИМУМ(ЗапускиЭкспрессПроверки.ДатаПоследнегоЗапуска), ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаПоследнегоЗапуска
	|ИЗ
	|	РегистрСведений.ЗапускиЭкспрессПроверки КАК ЗапускиЭкспрессПроверки";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.ДатаПоследнегоЗапуска;
	КонецЕсли;
	
	Возврат Дата(1,1,1);	
	
КонецФункции

Функция ПолучитьНастройкуОформленияЗаказов() Экспорт
	
	НастройкаОформленияЗаказовПокупателей = Константы.ОформлениеЗаказовПокупателей.Получить().Получить();
	Если НЕ НастройкаОформленияЗаказовПокупателей = Неопределено 
		И ТипЗнч(НастройкаОформленияЗаказовПокупателей) = Тип("Структура") Тогда
		Возврат НастройкаОформленияЗаказовПокупателей;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

Функция ПолучитьНастройкиОформленияЗаказов(ОформлениеЗаказовПокупателей = Неопределено) Экспорт
	
	// цвета умолчанию по заказам покупателей
	РезультатЗП = Новый Массив;
	РезультатЗП.Добавить(Новый Структура("Настройка, Цвет, Подсказка, Использовать", "Новый", WebЦвета.Золотой, "Заказы в статусе ""Новый""", Истина));			
	РезультатЗП.Добавить(Новый Структура("Настройка, Цвет, Подсказка, Использовать", "Выполнен", Новый Цвет(150,150,150), "Заказы в статусе ""Выполнен""", Истина));
	РезультатЗП.Добавить(Новый Структура("Настройка, Цвет, Подсказка, Использовать", "Закрыт", Новый Цвет(150,150,150), "Заказы в статусе ""Закрыт""", Истина));
	//#12778 не используется
	//РезультатЗП.Добавить(Новый Структура("Настройка, Цвет, Подсказка, Использовать", "КОтгрузке", WebЦвета.БледноЗеленый, "Заказы в статусе ""В работе"", готовые к отгрузке", Истина));
	РезультатЗП.Добавить(Новый Структура("Настройка, Цвет, Подсказка, Использовать", "ОжидаетОтгрузку", WebЦвета.Оранжевый, "Заказы, ожидающие отгрузку", Истина));
	РезультатЗП.Добавить(Новый Структура("Настройка, Цвет, Подсказка, Использовать", "ПросроченПоОтгрузке", WebЦвета.Красный, "Просроченные заказы", Истина));
	
	// цвета умолчанию по заказам на производство
	РезультатЗНП = Новый Массив;
	РезультатЗНП.Добавить(Новый Структура("Настройка, Цвет, Подсказка, Использовать", "ОжидаетОтгрузку", WebЦвета.Оранжевый, "Заказы, ожидающие отгрузку", Истина));
	РезультатЗНП.Добавить(Новый Структура("Настройка, Цвет, Подсказка, Использовать", "ПросроченПоОтгрузке", WebЦвета.Красный, "Просроченные заказы", Истина));
	
	Результат = Новый Структура("ЗП, ЗНП", РезультатЗП, РезультатЗНП);
	
	// переопределяем цвета по умолчанию цветами из настроек, если они там имеются
	Если НЕ ОформлениеЗаказовПокупателей = Неопределено Тогда
		
		Для каждого ЭлементМассива из ОформлениеЗаказовПокупателей.ЗП Цикл
			Настройка = ЭлементМассива.Настройка; 
			Для каждого ЭлементМассиваПоУмолчанию из РезультатЗП Цикл
				Если ЭлементМассиваПоУмолчанию.Настройка = Настройка Тогда
					ЗаполнитьЗначенияСвойств(ЭлементМассиваПоУмолчанию, ЭлементМассива);
					Прервать;
				КонецЕсли;
