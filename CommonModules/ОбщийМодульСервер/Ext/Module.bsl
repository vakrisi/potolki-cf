#Область ИсполнителиПоПроизводственнымОперациям

// Процедура - Заполнить исполнителей по смене
//
// Параметры:
//  Объект	 - 	 Документ-объект (ЗНП или выпуск) или Объект формы 
//
Процедура ЗаполнитьИсполнителейПроизводстваПоСмене(Объект) Экспорт
	
	//заполним бригаду только если включена настройка использовать производственные бригады
	Если Константы.ИспользоватьПроизводственныеБригады.Получить() Тогда
		Если Объект.Бригада.Пустая() Тогда
			ЗапросБригад = Новый Запрос;
			ЗапросБригад.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ПроизводственныеБригады.Ссылка
			|ИЗ
			|	Справочник.ПроизводственныеБригады КАК ПроизводственныеБригады
			|ГДЕ
			|	НЕ ПроизводственныеБригады.ПометкаУдаления
			|	И НЕ ПроизводственныеБригады.Неактивная";
			Выборка = ЗапросБригад.Выполнить().Выгрузить();
			Если Выборка.Количество() = 1 Тогда
				Объект.Бригада = Выборка[0].Ссылка;
			КонецЕсли;
		КонецЕсли;
		
		//++ 1526
		//если бригаду не получилось заполнить, исполнителей заполнять не нужно
		Если Объект.Бригада.Пустая() Тогда
			Возврат;
		КонецЕсли;	
		//-- 1526 
		
	КонецЕсли;
	
	ДатаЗаполнения = КонецДня(?(ЗначениеЗаполнено(Объект.Дата), Объект.Дата, ТекущаяДатаСеанса()));
	
	ВидПроизводства = Перечисления.ВидыПроизводства.ПустаяСсылка();
	ВидПродукции = Справочники.ВидыПродукции.ПустаяСсылка();
	
	Если Объект.ВидЗаказа = Перечисления.ВидыЗаказовНаПроизводство.ТиповоеПроизводство Тогда
		ВидПроизводства = Перечисления.ВидыПроизводства.ТиповоеПроизводство;
		Если Объект.Продукция.Количество() > 0 Тогда
			// продукция без галки "Уникальная продукция"
			ВидПродукции = Объект.Продукция[0].Номенклатура.ВидПродукции;
			Если ЗначениеЗаполнено(ВидПродукции) Тогда
				ВидПроизводства = Перечисления.ВидыПроизводства.Продукция;	
			КонецЕсли;
		КонецЕсли;
		
	ИначеЕсли Объект.ВидЗаказа = Перечисления.ВидыЗаказовНаПроизводство.ПроизводствоПотолка
		И ЗначениеЗаполнено(Объект.ПродукцияНоменклатура) Тогда		
		ВидНоменклатуры = Объект.ПродукцияНоменклатура.ВидНоменклатуры;
		Если ВидНоменклатуры = Справочники.ВидыНоменклатуры.Потолок Тогда
			ВидПроизводства = Перечисления.ВидыПроизводства.Потолок;
		ИначеЕсли ВидНоменклатуры = Справочники.ВидыНоменклатуры.Отрез Тогда
			ВидПроизводства = Перечисления.ВидыПроизводства.Отрез;	
		ИначеЕсли ВидНоменклатуры = Справочники.ВидыНоменклатуры.Продукция Тогда
			// продукция с галкой "Уникальная продукция"
			ВидПроизводства = Перечисления.ВидыПроизводства.Продукция;
			ВидПродукции = Объект.ПродукцияНоменклатура.ВидПродукции;
		КонецЕсли;	
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Дата",ДатаЗаполнения);
	Запрос.УстановитьПараметр("Организация", Объект.Организация); // №14262
	Запрос.УстановитьПараметр("ВидПроизводства", ВидПроизводства); 
	Запрос.УстановитьПараметр("ВидПродукции", ВидПродукции); 
	Запрос.УстановитьПараметр("ОтборПоБригаде", ЗначениеЗаполнено(Объект.Бригада));
	Запрос.УстановитьПараметр("Бригада", Объект.Бригада);
	Запрос.УстановитьПараметр("НесколькоТочекПроизводства", Объект.НесколькоТочекПроизводства);
	Запрос.УстановитьПараметр("Цех", Объект.Цех);
	Запрос.УстановитьПараметр("СпособНачисленияВыработки", Объект.СпособНачисленияВыработки); // №6687
	
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	СоставПроизводственнойСмены.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.СоставПроизводственнойСмены.ВидыПродукции КАК СоставПроизводственнойСменыВидыПродукции
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.СоставПроизводственнойСмены КАК СоставПроизводственнойСмены
	|		ПО СоставПроизводственнойСменыВидыПродукции.Ссылка = СоставПроизводственнойСмены.Ссылка
	|ГДЕ
	|	СоставПроизводственнойСмены.Проведен
	|	И СоставПроизводственнойСмены.Дата <= &Дата
	|	И СоставПроизводственнойСмены.Организация = &Организация
	|	И СоставПроизводственнойСменыВидыПродукции.ВидПроизводства = &ВидПроизводства
	|	И СоставПроизводственнойСменыВидыПродукции.ВидПродукции = &ВидПродукции
	|	И СоставПроизводственнойСмены.СпособНачисленияВыработки = &СпособНачисленияВыработки
	|	И ВЫБОР
	|			КОГДА &ОтборПоБригаде
	|				ТОГДА СоставПроизводственнойСмены.Бригада = &Бригада
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|	И ВЫБОР
	|			КОГДА &НесколькоТочекПроизводства
	|				ТОГДА СоставПроизводственнойСмены.Цех = &Цех
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|
	|УПОРЯДОЧИТЬ ПО
	|	СоставПроизводственнойСмены.Дата УБЫВ";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		//++ №6687 теперь способ определяется в документе
		//Если НЕ Константы.РасчетЗарплатыПроизводстваПоОперациям.Получить() Тогда
		Если Объект.СпособНачисленияВыработки = Перечисления.СпособыНачисленияВыработки.Бригадная Тогда
			//-- №6687
			
			Для Каждого ТекущийСотрудник Из Выборка.Ссылка.Сотрудники Цикл
				
				НоваяСтрока = Объект.Исполнители.Добавить();
				НоваяСтрока.Сотрудник = ТекущийСотрудник.Сотрудник;
				//НоваяСтрока.Коэффициент = 1;
				НоваяСтрока.Коэффициент = ТекущийСотрудник.Коэффициент;
				
			КонецЦикла;
			
		Иначе
			
			Для Каждого ТекущаяСтрока Из Выборка.Ссылка.СотрудникиПоОперациям Цикл
				
				НоваяСтрока = Объект.ИсполнителиПоОперациям.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущаяСтрока);
				
			КонецЦикла;
			
		КонецЕсли;
		
	Иначе	
		ТекстСообщения = СтрШаблон("На текущую дату нет заполненного и проведенного документа ""Состав производственной смены"", подходящего под критерии документа:
			|%1%2%3%4%5%6", 
			СтрШаблон("Организация: ""%1"", ", Объект.Организация),
			СтрШаблон("вид производства: ""%1"", ", ВидПроизводства),
			СтрШаблон("вид продукции: ""%1"", ", ВидПродукции),
			?(ЗначениеЗаполнено(Объект.Бригада), СтрШаблон("бригада: ""%1"", ", Объект.Бригада), ""),
			?(Объект.НесколькоТочекПроизводства, СтрШаблон("цех: ""%1"", ", Объект.Цех), ""),
			СтрШаблон("способ: ""%1""", Объект.СпособНачисленияВыработки)
		);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
	КонецЕсли;
	
КонецПроцедуры

//++ №6283
Процедура ПересчитатьПроцентУчастияИсполнителейПоОперациям(Форма, Объект) Экспорт
	
	ТабличнаяЧасть = "ИсполнителиПоОперациям";
	Если ТипЗнч(Объект.Ссылка) = Тип("ДокументСсылка.СоставПроизводственнойСмены") Тогда
		ТабличнаяЧасть = "СотрудникиПоОперациям";
	КонецЕсли;
	
	Для Каждого ТекущаяСтрока Из Объект[ТабличнаяЧасть] Цикл
		
		СуммаКоэффициентов = 0;
		Для Сч = 1 По Форма.МаксимальноеКоличествоСотрудниковВВыпускеНаОперацию Цикл
			Если ЗначениеЗаполнено(ТекущаяСтрока["Сотрудник" + Сч]) Тогда
				Коэффициент = ?(Объект.ИспользоватьКТУВПроизводственныхОперациях, ТекущаяСтрока["Коэффициент" + Сч], 1);
				СуммаКоэффициентов = СуммаКоэффициентов + Коэффициент;
			КонецЕсли;
		КонецЦикла;
		
		Для Сч = 1 По Форма.МаксимальноеКоличествоСотрудниковВВыпускеНаОперацию Цикл
			Если ЗначениеЗаполнено(ТекущаяСтрока["Сотрудник" + Сч]) Тогда
				Коэффициент = ?(Объект.ИспользоватьКТУВПроизводственныхОперациях, ТекущаяСтрока["Коэффициент" + Сч], 1);
				ТекущаяСтрока["ПроцентУчастия" + Сч] = ?(СуммаКоэффициентов = 0, 0, Окр(Коэффициент / СуммаКоэффициентов, 4)*100);
			Иначе
				ТекущаяСтрока["ПроцентУчастия" + Сч] = 0;
			КонецЕсли;
		КонецЦикла;
		
	КонецЦикла;	
	
КонецПроцедуры
//-- №6283

Процедура ПересчитатьПроцентУчастияКТУИсполнителей(Объект) Экспорт
	
	// по аналогии с модулем зарплаты
	СуммаКоэффициентов = Объект.Исполнители.Итог("Коэффициент");
	
	Для Каждого ТекущаяСтрока Из Объект.Исполнители Цикл
		ТекущаяСтрока.ПроцентУчастия = ?(СуммаКоэффициентов = 0, 0, Окр(ТекущаяСтрока.Коэффициент / СуммаКоэффициентов, 4)*100);
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

Функция ПолучитьПодчиненныйСчетФактуру(ДокументОснование) Экспорт
	
	Если Не ЗначениеЗаполнено(ДокументОснование) Тогда		
		Возврат Неопределено;		
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	СчетФактураВыданный.Ссылка
	|ИЗ
	|	Документ.СчетФактураВыданный КАК СчетФактураВыданный
	|ГДЕ
	|	СчетФактураВыданный.Основание = &ДокументОснование";
	
	Запрос.УстановитьПараметр("ДокументОснование", ДокументОснование);
	РезультатЗапроса = Запрос.Выполнить();		
	Выборка = РезультатЗапроса.Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;		
	
	Возврат Неопределено;
	
КонецФункции

#Область АрхивацияПрикрепленныхДанных

Процедура АрхивацияПрикрепленныхДанныхПоРегламентномуЗаданию() Экспорт
	
	ОбщегоНазначения.ПриНачалеВыполненияРегламентногоЗадания(
	Метаданные.РегламентныеЗадания.АрхивацияПрикрепленныхДанных);
	
	// Константа теперь регулирует запуск по регламентному заданию
	Если НЕ Константы.ВыполнятьАрхивациюПрикрепленныхДанных.Получить() Тогда
		ВызватьИсключение "В настройках архивации отключена настройка автоматической архивации.";
	КонецЕсли;
	
	АрхивацияПрикрепленныхДанных();
	
КонецПроцедуры

// №7253
Процедура АрхивацияПрикрепленныхДанных(ТаблицаДанных = Неопределено) Экспорт
	
	ВариантАрхивации = Константы.ВариантАрхивацииПрикрепленныхДанных.Получить();
	Если ВариантАрхивации.Пустая() Тогда
		ВызватьИсключение "Не задан вариант архивации";
	КонецЕсли;
	
	ИмяСобытия = "Архивация прикрепленных данных (" + ВариантАрхивации + ").";
	
	НаЛокальныйДиск = (ВариантАрхивации = Перечисления.ВариантыАрхивацииПрикрепленныхДанных.ЛокальныйДиск);
	НаGoogleDrive = (ВариантАрхивации = Перечисления.ВариантыАрхивацииПрикрепленныхДанных.GoogleDrive);
	НаЯндексДиск = (ВариантАрхивации = Перечисления.ВариантыАрхивацииПрикрепленныхДанных.ЯндексДиск);
	
	ПутьАрхивации = Константы.ПутьАрхивацииПрикрепленныхДанных.Получить();
	
	ЭтоОблако = (ОбщийМодуль.ОпределитьМассивПеременныхСеанса().Коробка = 1);
	
	Если НаЛокальныйДиск И ЭтоОблако Тогда
		ВызватьИсключение "В облачной версии использование варианта архивации ""На локальный диск на сервере"" запрещено!.";
	КонецЕсли;
	
	Если НаЛокальныйДиск И НЕ ЗначениеЗаполнено(ПутьАрхивации) Тогда
		ВызватьИсключение "Не задан путь архивации";
	КонецЕсли;
	
	Если НаЛокальныйДиск Тогда
		
		СистемнаяИнформация = Новый СистемнаяИнформация;
		ПлатформаWindows = СистемнаяИнформация.ТипПлатформы = ТипПлатформы.Windows_x86
		ИЛИ СистемнаяИнформация.ТипПлатформы = ТипПлатформы.Windows_x86_64;
		
		// Проверка существования пути
		Каталог = новый Файл(ПутьАрхивации);
		Если НЕ Каталог.Существует() Тогда
			ВызватьИсключение "Каталог выгрузки архивации """ + ПутьАрхивации + """ не обнаружен.";
		КонецЕсли;
		
	ИначеЕсли НаGoogleDrive Тогда
		
		ПараметрыАвторизацииGoogleAPI = РаботаСGoogleAPIВызовСервера.ПолучитьПараметрыАвторизации();
		
		Если ПараметрыАвторизацииGoogleAPI = Неопределено Тогда
			ВызватьИсключение "Необходимо выполнить настройки авторизации Google API.";
		КонецЕсли;
		
		// Проверим заполненность названия папки для архивации
		Если Не ЗначениеЗаполнено(ПараметрыАвторизацииGoogleAPI.ПутьАрхивации) Тогда
			ВызватьИсключение "Необходимо указать имя папки для архивации в Google Drive.";
		КонецЕсли;
		
		// Проверим наличие папки на самом GDrive
		СписокПапок = РаботаСGoogleAPIВызовСервера.ПолучитьПапкиИзДиска(ПараметрыАвторизацииGoogleAPI);
		
		idПапкиGD = "";
		Если Не СписокПапок = Неопределено Тогда
			Для Каждого ПапкаGD Из СписокПапок Цикл
				Если НРег(ПапкаGD.name) = НРег(ПараметрыАвторизацииGoogleAPI.ПутьАрхивации) Тогда
					idПапкиGD = ПапкаGD.id;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(idПапкиGD) Тогда
			ВызватьИсключение "Не удалось найти папку с наименованием """ + ПараметрыАвторизацииGoogleAPI.ПутьАрхивации + """ в Google Drive.";
		КонецЕсли;
		
	ИначеЕсли НаЯндексДиск Тогда
		
		ПараметрыАвторизацииЯндексAPI = РаботаСЯндексAPIВызовСервера.ПолучитьПараметрыАвторизации();
		
		Если ПараметрыАвторизацииЯндексAPI = Неопределено Тогда
			ВызватьИсключение "Необходимо выполнить настройки авторизации Яндекс API.";
		КонецЕсли;
		
		// Проверим заполненность названия папки для архивации
		Если Не ЗначениеЗаполнено(ПараметрыАвторизацииЯндексAPI.ПутьАрхивации) Тогда
			ВызватьИсключение "Необходимо указать имя папки для архивации на Яндекс.Диск.";
		КонецЕсли;
		
		// Проверим наличие папки на самом Я.Д (если папка есть, в ней сразу будут все вложенные подпапки)
		МассивПапокЯД = РаботаСЯндексAPIВызовСервера.ПолучитьПапкиИзДиска(ПараметрыАвторизацииЯндексAPI, ПараметрыАвторизацииЯндексAPI.ПутьАрхивации);
		
		Если МассивПапокЯд = Неопределено Тогда
			ВызватьИсключение "Не удалось найти папку с наименованием """ + ПараметрыАвторизацииЯндексAPI.ПутьАрхивации + """ на Яндекс.Диск.";
		КонецЕсли;
		
	КонецЕсли;
	
	Если ТаблицаДанных = Неопределено Тогда
		
		// Получим записи из регистра, которые нужно архивировать
		Запрос = новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ПрикрепленныеДанные.Период КАК Период,
		|	ПрикрепленныеДанные.СсылкаНаОбъект КАК СсылкаНаОбъект,
		|	ПрикрепленныеДанные.ВидФайлаПрограммыПостроителя КАК ВидФайлаПрограммыПостроителя,
		|	ПрикрепленныеДанные.ИмяФайла КАК ИмяФайла,
		|	ПрикрепленныеДанные.Расширение КАК Расширение,
		|	ПрикрепленныеДанные.Данные КАК Данные
		|ИЗ
		|	РегистрСведений.ПрикрепленныеДанные КАК ПрикрепленныеДанные
		|ГДЕ
		|	НЕ ПрикрепленныеДанные.Архивирован
		|	И ПрикрепленныеДанные.Период < &ДатаДо
		// для отладки сделаем наоборот только свежие
		//|	И ПрикрепленныеДанные.Период > &ДатаДо
		|ИТОГИ ПО
		|	СсылкаНаОбъект";
		Запрос.УстановитьПараметр("ДатаДо", НачалоДня(ДобавитьМесяц(ТекущаяДатаСеанса(), -Константы.АрхивироватьПрикрепленныеДанныеСтарше.Получить())));
		
	Иначе
		
		// Если передана таблица данных, то архивацию производим только по этим данным
		Запрос = новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТаблицаДанных.Период,
		|	ТаблицаДанных.СсылкаНаОбъект,
		|	ТаблицаДанных.ВидФайлаПрограммыПостроителя,
		|	ТаблицаДанных.ИмяФайла,
		|	ТаблицаДанных.ИдентификаторСтроки
		|
		|ПОМЕСТИТЬ ВТ_ТаблицаДанных
		|
		|ИЗ
		|	&ТаблицаДанных КАК ТаблицаДанных
		|
		|;
		|/////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ПрикрепленныеДанные.Период КАК Период,
		|	ПрикрепленныеДанные.СсылкаНаОбъект КАК СсылкаНаОбъект,
		|	ПрикрепленныеДанные.ВидФайлаПрограммыПостроителя КАК ВидФайлаПрограммыПостроителя,
		|	ПрикрепленныеДанные.ИмяФайла КАК ИмяФайла,
		|	ПрикрепленныеДанные.Расширение КАК Расширение,
		|	ПрикрепленныеДанные.Данные КАК Данные,
		|	ТаблицаДанных.ИдентификаторСтроки КАК ИдентификаторСтроки
		|ИЗ
		|	РегистрСведений.ПрикрепленныеДанные КАК ПрикрепленныеДанные
		|
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ТаблицаДанных КАК ТаблицаДанных
		|		ПО ПрикрепленныеДанные.Период = ТаблицаДанных.Период
		|			И ПрикрепленныеДанные.СсылкаНаОбъект = ТаблицаДанных.СсылкаНаОбъект
		|			И ПрикрепленныеДанные.ВидФайлаПрограммыПостроителя = ТаблицаДанных.ВидФайлаПрограммыПостроителя
		|			И ПрикрепленныеДанные.ИмяФайла = ТаблицаДанных.ИмяФайла
		|
		|ГДЕ
		|	НЕ ПрикрепленныеДанные.Архивирован
		|ИТОГИ ПО
		|	СсылкаНаОбъект";
		Запрос.УстановитьПараметр("ТаблицаДанных", ТаблицаДанных);
		
	КонецЕсли;
	
	ВыборкаОбъект = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам, "СсылкаНаОбъект");
	
	// Выборка по объектам-каталогам (ГУИДы объектов используются для именование папки, которые складываются в основную папку архивации)
	Пока ВыборкаОбъект.Следующий() Цикл
		
		// Архивация на локальный диск
		Если НаЛокальныйДиск Тогда
			
			// Проверим есть ли подкаталог по ГУИДу объекта
			ПутьПодкаталог = ПутьАрхивации + "\" + Строка(ВыборкаОбъект.СсылкаНаОбъект.УникальныйИдентификатор());
			Подкаталог = новый Файл(ПутьПодкаталог);
			
			Если НЕ Подкаталог.Существует() Тогда
				
				Попытка
					СоздатьКаталог(ПутьПодкаталог);
				Исключение
					ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка,,, "Не удалось создать каталог: " + ПутьПодкаталог + Символы.ПС + ОписаниеОшибки());
					Продолжить;
				КонецПопытки;
				
			КонецЕсли;
			
			ВыборкаФайлы = ВыборкаОбъект.Выбрать();
			
			Пока ВыборкаФайлы.Следующий() Цикл
				
				ИмяФайлаСРасширением = ВыборкаФайлы.ИмяФайла + "." + ВыборкаФайлы.Расширение;
				ПутьФайла = ПутьПодкаталог + "\" + ИмяФайлаСРасширением;
				ПутьФайла = ПодготовитьПутьДляПлатформы(ПлатформаWindows, ПутьФайла);
				
				Попытка
					ВыборкаФайлы.Данные.Получить().Записать(ПутьФайла);
					ЗафиксироватьУспешнуюАрхивациюФайла(ИмяСобытия, ВыборкаФайлы, ВариантАрхивации, ПутьАрхивации);
					УстановитьПризнакАрхивацииВТаблицеДанных(ТаблицаДанных, ВыборкаФайлы);
				Исключение
					ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка,,, "Не удалось выгрузить файл для объекта """ + ВыборкаФайлы.СсылкаНаОбъект + """ с наименованием: " + ИмяФайлаСРасширением + Символы.ПС + ОписаниеОшибки());
					Продолжить;
				КонецПопытки;
				
			КонецЦикла;
			
		ИначеЕсли НаGoogleDrive Тогда
			
			// Архивация на Google Drive
			ВыборкаФайлы = ВыборкаОбъект.Выбрать();
			ИмяПапки = Строка(ВыборкаОбъект.СсылкаНаОбъект.УникальныйИдентификатор());
			
			Если ВыборкаФайлы.Количество() > 0 Тогда
				
				// Проверим наличие папки на самом GDrive
				СписокПапок = РаботаСGoogleAPIВызовСервера.ПолучитьПапкиИзДиска(ПараметрыАвторизацииGoogleAPI,, idПапкиGD);
				
				Если СписокПапок = Неопределено Тогда
					Продолжить;
				КонецЕсли;
				
				idПапкиОбъектаGD = "";
				Для Каждого ПапкаGD Из СписокПапок Цикл
					Если НРег(ПапкаGD.name) = НРег(ИмяПапки) Тогда
						idПапкиОбъектаGD = ПапкаGD.id;
					КонецЕсли;
				КонецЦикла;
				
				// Если папки нет, нужно её сначала создать
				Если Не ЗначениеЗаполнено(idПапкиОбъектаGD) И НЕ РаботаСGoogleAPIВызовСервера.СоздатьПапкуНаДиске(ИмяСобытия, ИмяПапки, ПараметрыАвторизацииGoogleAPI, idПапкиGD, idПапкиОбъектаGD) Тогда
					Продолжить;
				КонецЕсли;
				
			КонецЕсли;
			
			Пока ВыборкаФайлы.Следующий() Цикл
				
				idФайлаGD = "";
				Если РаботаСGoogleAPIВызовСервера.СохранитьФайлНаДиск(ИмяСобытия, ВыборкаФайлы, ПараметрыАвторизацииGoogleAPI, idПапкиОбъектаGD, idФайлаGD) Тогда
					ЗафиксироватьУспешнуюАрхивациюФайла(ИмяСобытия, ВыборкаФайлы, ВариантАрхивации, ПараметрыАвторизацииGoogleAPI.ПутьАрхивации + "/" + ИмяПапки, idФайлаGD, idПапкиОбъектаGD);
					УстановитьПризнакАрхивацииВТаблицеДанных(ТаблицаДанных, ВыборкаФайлы);
				КонецЕсли;
				
			КонецЦикла;
			
		ИначеЕсли НаЯндексДиск Тогда
			
			// Архивация на Яндекс.Диск
			ВыборкаФайлы = ВыборкаОбъект.Выбрать();
			ИмяПапки = Строка(ВыборкаОбъект.СсылкаНаОбъект.УникальныйИдентификатор());
			
			Если ВыборкаФайлы.Количество() > 0 Тогда
				
				// Проверим наличие папки на самом Я.Д
				ЕстьПапка = Ложь;
				Для Каждого ПапкаЯд Из МассивПапокЯД Цикл
					
					Если НЕ НРег(ПапкаЯД.type) = "dir" Тогда
						Продолжить;
					КонецЕсли;
					
					Если НРег(ПапкаЯд.name) = НРег(ИмяПапки) Тогда
						ЕстьПапка = Истина;
						Прервать;
					КонецЕсли;
					
				КонецЦикла;
				
				// Если папки нет, нужно её сначала создать
				Если Не ЕстьПапка И НЕ РаботаСЯндексAPIВызовСервера.СоздатьПапкуНаДиске(ИмяСобытия, ИмяПапки, ПараметрыАвторизацииЯндексAPI, МассивПапокЯД) Тогда
					Продолжить;
				КонецЕсли;
				
			КонецЕсли;
			
			Пока ВыборкаФайлы.Следующий() Цикл
				
				Если РаботаСЯндексAPIВызовСервера.СохранитьФайлНаДиск(ИмяСобытия, ВыборкаФайлы, ПараметрыАвторизацииЯндексAPI, ИмяПапки) Тогда
					ЗафиксироватьУспешнуюАрхивациюФайла(ИмяСобытия, ВыборкаФайлы, ВариантАрхивации, ПараметрыАвторизацииЯндексAPI.ПутьАрхивации + "/" + ИмяПапки);
					УстановитьПризнакАрхивацииВТаблицеДанных(ТаблицаДанных, ВыборкаФайлы);
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗафиксироватьУспешнуюАрхивациюФайла(ИмяСобытия, ВыборкаФайлы, ВариантАрхивации, ПутьАрхивации, idФайлаGD = "", idПапкиGD = "")
	
	// Устанавливаем признаки в ИБ и зануляем данные
	МенеджерЗаписи = РегистрыСведений.ПрикрепленныеДанные.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Период						= ВыборкаФайлы.Период;
	МенеджерЗаписи.ВидФайлаПрограммыПостроителя = ВыборкаФайлы.ВидФайлаПрограммыПостроителя;
	МенеджерЗаписи.СсылкаНаОбъект 				= ВыборкаФайлы.СсылкаНаОбъект;
	МенеджерЗаписи.ИмяФайла 					= ВыборкаФайлы.ИмяФайла;						
	Попытка
		МенеджерЗаписи.Прочитать();
		МенеджерЗаписи.Архивирован = Истина;
		МенеджерЗаписи.ВариантАрхивации = ВариантАрхивации;
		МенеджерЗаписи.ПутьАрхивации = ПутьАрхивации;
		МенеджерЗаписи.ДатаАрхивации = ТекущаяДатаСеанса();
		МенеджерЗаписи.Данные = новый ХранилищеЗначения(Неопределено);
		МенеджерЗаписи.ИдентификаторФайлаGD = idФайлаGD;
		МенеджерЗаписи.ИдентификаторПапкиGD = idПапкиGD;
		МенеджерЗаписи.Записать();
	Исключение
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка,,, "Не удалось зафиксировать архивацию в регистре: " + ОписаниеОшибки());
	КонецПопытки;
	
КонецПроцедуры

Процедура УстановитьПризнакАрхивацииВТаблицеДанных(ТаблицаДанных, ВыборкаФайлы)
	
	Если ТаблицаДанных = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	НайденныеСтроки = ТаблицаДанных.НайтиСтроки(новый Структура("ИдентификаторСтроки", ВыборкаФайлы.ИдентификаторСтроки));
	
	Если НайденныеСтроки.Количество() > 0 Тогда
		
		НайденныеСтроки[0].Успешно = Истина;
		
	КонецЕсли;
	
КонецПроцедуры

Функция ПодготовитьПутьДляПлатформы(ПлатформаWindows, Путь) Экспорт
	
	Если ПлатформаWindows Тогда
		ЧтоМенять = "/";
		НаЧтоМенять = "\";
	Иначе
		ЧтоМенять = "\";
		НаЧтоМенять = "/";
	КонецЕсли;
	
	Путь = СтрЗаменить(Путь, ЧтоМенять, НаЧтоМенять);
	Возврат Путь;
	
КонецФункции

#КонецОбласти

Функция ПроверкаCOMПодключения(СтрокаПодключения, ИмяПользователя, ПарольПользователя, ИмяСобытия = Неопределено) Экспорт
	
	мСоединение = Неопределено;
	Соединение = Неопределено;
	Попытка		
		мСоединение = Новый COMObject("V83.COMConnector");
	Исключение
		Сообщить("Не обнаружена библиотека comcntr.dll, попробуйте зарегистрировать её " + ОписаниеОшибки());
		мСоединение = Неопределено;
		Возврат Неопределено;
	КонецПопытки;
	
	Попытка
		Соединение = мСоединение.Connect(СтрокаПодключения+"usr="""+ИмяПользователя+""";pwd="""+ПарольПользователя+"""");
	Исключение
		ТекстОшибки = ИнформацияОбОшибке().Описание;
		Сообщить(ТекстОшибки);
		ОписаниеОшибки = ОписаниеОшибки();
		Сообщить(ОписаниеОшибки);
		
		Если НЕ ИмяСобытия = Неопределено Тогда
			ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка,,, ТекстОшибки);
			ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка,,, ОписаниеОшибки);
		КонецЕсли;
		
		Соединение = Неопределено;
		Возврат Неопределено;
	КонецПопытки;
	
	Возврат Соединение;
	
КонецФункции

Процедура СозданиеПоступленийТоваровОтПроизводстваПоУдаленнойБазеРегламентноеЗадание() Экспорт
	
	// Если идет обновление конфигурации, то все регламентные задания блокируются.
	ОбщегоНазначения.ПриНачалеВыполненияРегламентногоЗадания();
	
	СозданиеПоступленийТоваровОтПроизводстваПоУдаленнойБазе();
	
КонецПроцедуры

Функция СозданиеПоступленийТоваровОтПроизводстваПоУдаленнойБазе() Экспорт
	
	Если НЕ Константы.СоздаватьДокументыПоступленийПоУдаленнойБазе.Получить() Тогда
		Возврат 0;
	КонецЕсли;
	
	ИмяСобытия = "Создание поступлений товаров от производства (удаленное подключение)";
	
	КоличествоСозданныхДокументов = 0;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ШапкаПланаОбмена.Код КАК Код,
	|	ШапкаПланаОбмена.Ссылка КАК Узел,
	|	НастройкиТранспортаОбмена.COMАутентификацияОперационнойСистемы КАК COMАутентификацияОперационнойСистемы,
	|	НастройкиТранспортаОбмена.COMВариантРаботыИнформационнойБазы КАК COMВариантРаботыИнформационнойБазы,
	|	НастройкиТранспортаОбмена.COMИмяИнформационнойБазыНаСервере1СПредприятия КАК COMИмяИнформационнойБазыНаСервере1СПредприятия,
	|	НастройкиТранспортаОбмена.COMИмяПользователя КАК COMИмяПользователя,
	|	НастройкиТранспортаОбмена.COMИмяСервера1СПредприятия КАК COMИмяСервера1СПредприятия,
	|	НастройкиТранспортаОбмена.COMКаталогИнформационнойБазы КАК COMКаталогИнформационнойБазы,
	|	ШапкаПланаОбмена.НомерПринятого КАК НомерПринятого,
	|	ШапкаПланаОбмена.ОрганизацияПоступления КАК ОрганизацияПоступления,
	|	ШапкаПланаОбмена.КонтрагентПоступления КАК КонтрагентПоступления,
	|	ШапкаПланаОбмена.СкладПоступления КАК СкладПоступления,
	|	ШапкаПланаОбмена.ГруппаНовойНоменклатурыИзУдаленнойБазы КАК ГруппаНовойНоменклатуры,
	|	ШапкаПланаОбмена.ЗаполнятьАдресМонтажаВШапкеДокумента КАК ЗаполнятьАдресМонтажаВШапкеДокумента
	|ИЗ
	|	ПланОбмена.ОбменБазаПроизводстваБазаРозницы КАК ШапкаПланаОбмена
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.НастройкиТранспортаОбмена КАК НастройкиТранспортаОбмена
	|		ПО (НастройкиТранспортаОбмена.Узел = ШапкаПланаОбмена.Ссылка)
	|ГДЕ
	|	НЕ ШапкаПланаОбмена.ЭтоБазаПроизводства
	|	И НЕ ШапкаПланаОбмена.ПометкаУдаления";		
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		СтруктураНастроек = Новый Структура;
		СтруктураНастроек.Вставить("Узел");
		СтруктураНастроек.Вставить("COMАутентификацияОперационнойСистемы");
		СтруктураНастроек.Вставить("COMВариантРаботыИнформационнойБазы");
		СтруктураНастроек.Вставить("COMИмяИнформационнойБазыНаСервере1СПредприятия");
		СтруктураНастроек.Вставить("COMИмяПользователя");
		СтруктураНастроек.Вставить("COMИмяСервера1СПредприятия");
		СтруктураНастроек.Вставить("COMКаталогИнформационнойБазы");
		СтруктураНастроек.Вставить("COMПарольПользователя");
		ЗаполнитьЗначенияСвойств(СтруктураНастроек, Выборка);
		
		УстановитьПривилегированныйРежим(Истина);
		СтруктураНастроек.COMПарольПользователя = ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища(Выборка.Узел, "COMПарольПользователя", Истина);
		УстановитьПривилегированныйРежим(Ложь);
		
		Результат = ОбменДаннымиСервер.УстановитьВнешнееСоединениеСБазой(СтруктураНастроек);
		Если Результат.Соединение = Неопределено Тогда
			ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка,,, Результат.КраткоеОписаниеОшибки);
			Продолжить; //Прервать; // #12849
		КонецЕсли;
		
		ВнешнееСоединение = Результат.Соединение;
		
		Если ВнешнееСоединение.Метаданные.ПланыОбмена.Найти("ОбменБазаПроизводстваБазаРозницы") = Неопределено Тогда
			ТекстОшибки = "В удаленной базе отсутствует план обмена ""Обмен База производства и База розницы"". Возможно требуется обновление базы.";
			ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка,,, ТекстОшибки);
			Продолжить; //Прервать; // #12849 
		КонецЕсли;
		
		комУзелОбмена = ВнешнееСоединение.ПланыОбмена.ОбменБазаПроизводстваБазаРозницы.НайтиПоКоду(Выборка.Код);
		Если комУзелОбмена.Ссылка.Пустая() Тогда
			ТекстОшибки = "В удаленной базе отсутствует узел обмена ""Обмен База производства и База розницы"" с кодом " + Выборка.Код;
			ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка,,, ТекстОшибки);
			Продолжить; //Прервать; // #12849	
		КонецЕсли;
		
		ТаблицаТоваров = Новый ТаблицаЗначений;
		Для Каждого Реквизит Из Метаданные.Документы.РеализацияТоваровИУслуг.ТабличныеЧасти.Товары.Реквизиты Цикл
			ТаблицаТоваров.Колонки.Добавить(Реквизит.Имя, Реквизит.Тип);	
		КонецЦикла;
		ТаблицаУслуг = Новый ТаблицаЗначений;
		Для Каждого Реквизит Из Метаданные.Документы.РеализацияТоваровИУслуг.ТабличныеЧасти.Услуги.Реквизиты Цикл
			ТаблицаУслуг.Колонки.Добавить(Реквизит.Имя, Реквизит.Тип);	
		КонецЦикла;
		
		комВыборка = ВнешнееСоединение.ПланыОбмена.ВыбратьИзменения(комУзелОбмена.Ссылка, Выборка.НомерПринятого);
		Пока комВыборка.Следующий() Цикл
			комОбъект = комВыборка.Получить(); 
			комСсылка = комОбъект.Ссылка;
			
			//#16447 проверка на битую ссылку
			Если ПустаяСтрока(комСсылка.ВерсияДанных) Тогда				
				Попытка		
					ВнешнееСоединение.ПланыОбмена.УдалитьРегистрациюИзменений(комУзелОбмена, комОбъект);
				Исключение
				КонецПопытки;
				
				Продолжить;				
			КонецЕсли;
			
			ТипСтрокой = комОбъект.Метаданные().Имя;
			СтроковыйГУИД = ВнешнееСоединение.String(комСсылка.UUID());
			
			Если ТипСтрокой = "РеализацияТоваровИУслуг" Тогда
				
				СсылкаНаОбъект = ОбменДаннымиСобытияПотолки.НайтиСсылкуНаОбъектПоГуид(Выборка.Узел, СтроковыйГУИД);
				Если СсылкаНаОбъект = Неопределено Тогда				
					ДокОбъект = Документы.ПоступлениеТоваровИУслуг.СоздатьДокумент();
					ДокОбъект.Заполнить(Неопределено);
					ДокОбъект.Дата = ТекущаяДатаСеанса();
				Иначе
					ДокОбъект = СсылкаНаОбъект.ПолучитьОбъект();
				КонецЕсли;
				
				ДокОбъект.ПоступлениеОтПроизводстваУИБ = Истина;				
				ДокОбъект.Организация = Выборка.ОрганизацияПоступления;
				ДокОбъект.Контрагент  = Выборка.КонтрагентПоступления;
				ДокОбъект.ДоговорКонтрагента = ДокОбъект.Контрагент.ОсновнойДоговор;
				ДокОбъект.ВидЦеныПоставщика = ДокОбъект.ДоговорКонтрагента.ВидЦеныПоставщика;
				ДокОбъект.Склад       = Выборка.СкладПоступления;
				ДокОбъект.НомерРозничногоДоговора = комОбъект.НомерРозничногоДоговора;
				Если Выборка.ЗаполнятьАдресМонтажаВШапкеДокумента Тогда
					ДокОбъект.АдресМонтажа = комОбъект.АдресМонтажа;
				КонецЕсли;
				ДокОбъект.ВхДата = комОбъект.Дата;
				ДокОбъект.ВхНомер = комОбъект.Номер;
				Если НЕ комОбъект.Валюта.Пустая() Тогда
					ВалютаДокумента = Справочники.Валюты.НайтиПоКоду(комОбъект.Валюта.Код);
					Если НЕ ВалютаДокумента.Пустая() Тогда
						ДокОбъект.Валюта = ВалютаДокумента;
					КонецЕсли;
				КонецЕсли;
				
				ТаблицаТоваров.Очистить();
				Отказ = Ложь;
				Для каждого комСтрокаТовары из комОбъект.Товары Цикл
					НоваяСтрока = ТаблицаТоваров.Добавить();	
					ЗаполнитьЗначенияСвойств(НоваяСтрока, комСтрокаТовары, "Коэффициент, Количество, Цена, СуммаРучнойСкидки, Сумма, СуммаНДС, ПроцентРучнойСкидки, Бесплатно");
					НоваяСтрока.СтавкаНДС = ОбменДаннымиСобытияПотолки.ПолучитьСтавкуНДСУИБ(ВнешнееСоединение, комСтрокаТовары.СтавкаНДС);
					
					ТекстОшибки = "";
					НоваяСтрока.Номенклатура = ОбменДаннымиСобытияПотолки.ПолучитьНоменклатуруУИБ(ВнешнееСоединение, комСтрокаТовары.Номенклатура, Выборка.ГруппаНовойНоменклатуры, ТекстОшибки);
					Если НЕ ПустаяСтрока(ТекстОшибки) Тогда
						Отказ = Истина;
						ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка,,, ТекстОшибки);
						Прервать;	
					КонецЕсли;
					НоваяСтрока.ХарактеристикаНоменклатуры = ОбменДаннымиСобытияПотолки.ПолучитьХарактеристикуУИБ(ВнешнееСоединение, комСтрокаТовары.ХарактеристикаНоменклатуры, НоваяСтрока.Номенклатура);
					НоваяСтрока.ЕдиницаИзмерения = ОбменДаннымиСобытияПотолки.ПолучитьЕдиницуИзмеренияУИБ(ВнешнееСоединение, комСтрокаТовары.ЕдиницаИзмерения, НоваяСтрока.Номенклатура);
					
					ТекстОшибки = "";
					НоваяСтрока.Потолок = ОбменДаннымиСобытияПотолки.ПолучитьНоменклатуруУИБ(ВнешнееСоединение, комСтрокаТовары.Потолок, Выборка.ГруппаНовойНоменклатуры, ТекстОшибки);
					Если НЕ ПустаяСтрока(ТекстОшибки) Тогда
						Отказ = Истина;
						ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка,,, ТекстОшибки);
						Прервать;	
					КонецЕсли;
				КонецЦикла;
				
				Если Отказ Тогда
					Прервать;	
				КонецЕсли;
				
				ТаблицаУслуг.Очистить();
				Для каждого комСтрокаУслуг из комОбъект.Услуги Цикл
					НоваяСтрока = ТаблицаУслуг.Добавить();	
					ЗаполнитьЗначенияСвойств(НоваяСтрока, комСтрокаУслуг, "Коэффициент, Количество, Цена, СуммаРучнойСкидки, Сумма, СуммаНДС, ПроцентРучнойСкидки, Бесплатно");
					НоваяСтрока.СтавкаНДС = ОбменДаннымиСобытияПотолки.ПолучитьСтавкуНДСУИБ(ВнешнееСоединение, комСтрокаУслуг.СтавкаНДС);
					
					ТекстОшибки = "";
					НоваяСтрока.Номенклатура = ОбменДаннымиСобытияПотолки.ПолучитьНоменклатуруУИБ(ВнешнееСоединение, комСтрокаУслуг.Номенклатура, Выборка.ГруппаНовойНоменклатуры, ТекстОшибки);
					Если НЕ ПустаяСтрока(ТекстОшибки) Тогда
						Отказ = Истина;
						ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка,,, ТекстОшибки);
						Прервать;	
					КонецЕсли;
					НоваяСтрока.ХарактеристикаНоменклатуры = ОбменДаннымиСобытияПотолки.ПолучитьХарактеристикуУИБ(ВнешнееСоединение, комСтрокаТовары.ХарактеристикаНоменклатуры, НоваяСтрока.Номенклатура);
					НоваяСтрока.ЕдиницаИзмерения = ОбменДаннымиСобытияПотолки.ПолучитьЕдиницуИзмеренияУИБ(ВнешнееСоединение, комСтрокаТовары.ЕдиницаИзмерения, НоваяСтрока.Номенклатура);
					
					ТекстОшибки = "";
					НоваяСтрока.Потолок = ОбменДаннымиСобытияПотолки.ПолучитьНоменклатуруУИБ(ВнешнееСоединение, комСтрокаУслуг.Потолок, Выборка.ГруппаНовойНоменклатуры, ТекстОшибки);
					Если НЕ ПустаяСтрока(ТекстОшибки) Тогда
						Отказ = Истина;
						ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка,,, ТекстОшибки);
						Прервать;	
					КонецЕсли;
				КонецЦикла;
				
				Если Отказ Тогда
					Прервать;	
				КонецЕсли;
				
				ДанныеЗаполнения = Новый Структура("УИБ");
				ДанныеЗаполнения.Вставить("Товары", ТаблицаТоваров);
				ДанныеЗаполнения.Вставить("Услуги", ТаблицаУслуг);
				ДанныеЗаполнения.Вставить("СуммаДокумента", ТаблицаТоваров.Итог("Сумма") + ТаблицаУслуг.Итог("Сумма"));
				ДокОбъект.Товары.Очистить();
				ДокОбъект.Услуги.Очистить();
				ДокОбъект.ЗаполнитьТаблицыТоваровИУслугПоИнтеркампани(ДанныеЗаполнения);
				
				ДокОбъект.СуммаДокумента = ДокОбъект.Товары.Итог("Сумма") + ДокОбъект.Услуги.Итог("Сумма");
				
				Попытка
					ДокОбъект.Записать(РежимЗаписиДокумента.Запись);					
					ОбменДаннымиСобытияПотолки.ЗаписатьСоответствиеОбъектов(Выборка.Узел, ДокОбъект.Ссылка, СтроковыйГУИД, ТипСтрокой);
					
					ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
					КоличествоСозданныхДокументов = КоличествоСозданныхДокументов + 1;
					
					ВнешнееСоединение.ПланыОбмена.УдалитьРегистрациюИзменений(комУзелОбмена, комОбъект);
				Исключение
					ТекстОшибки = ОписаниеОшибки();
					ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка,,, ТекстОшибки);
					Сообщить(ТекстОшибки);
				КонецПопытки;
				
			КонецЕсли;
			
		КонецЦикла;
	КонецЦикла;
	
	Возврат КоличествоСозданныхДокументов;
	
КонецФункции

Процедура ЗаполнитьДополнительноеСвойствоЛида(ДокументОбъект, Свойство, Значение="", ПерезаполнитьПринудительно = Ложь) Экспорт
	
	НайденнаяСтрока = ДокументОбъект.ДополнительныеСвойстваЛида.Найти(Свойство, "Свойство");
	Если НайденнаяСтрока = Неопределено Тогда
		НайденнаяСтрока = ДокументОбъект.ДополнительныеСвойстваЛида.Добавить();
		НайденнаяСтрока.Свойство = Свойство;
	КонецЕсли;
	Если ЗначениеЗаполнено(Значение) ИЛИ ПерезаполнитьПринудительно Тогда
		НайденнаяСтрока.Значение = Значение;
	КонецЕсли;
	
КонецПроцедуры

Функция ЗначениеДополнительногоСвойстваЛида(ДокументСсылкаОбъект, Свойство, ЗначениеПоУмолчанию="") Экспорт
	
	НайденныеСтроки = ДокументСсылкаОбъект.ДополнительныеСвойстваЛида.НайтиСтроки(Новый Структура("Свойство", Свойство));
	Если НайденныеСтроки.Количество() = 0 Тогда
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;
	
	Возврат НайденныеСтроки[0].Значение;
	
КонецФункции

Процедура УстановитьУсловноеОформлениеЦветТекста(ЭлементыУО, ИмяПоляУО, УО_ЛевоеЗначение, УО_ВидСравнения, УО_ПравоеЗначение, ЦветТекста) Экспорт
	
	Элемент = ЭлементыУО.Добавить();
	
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(ИмяПоляУО);
	
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение  = УО_ЛевоеЗначение;
	ОтборЭлемента.ВидСравнения   = УО_ВидСравнения;
	ОтборЭлемента.ПравоеЗначение = УО_ПравоеЗначение;
	
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветТекста);
	
КонецПроцедуры

Процедура УстановитьУсловноеОформлениеЦветФона(ЭлементыУО, ИмяПоляУО, УО_ЛевоеЗначение, УО_ВидСравнения, УО_ПравоеЗначение, ЦветФона) Экспорт
	
	Элемент = ЭлементыУО.Добавить();
	
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(ИмяПоляУО);
	
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение  = УО_ЛевоеЗначение;
	ОтборЭлемента.ВидСравнения   = УО_ВидСравнения;
	ОтборЭлемента.ПравоеЗначение = УО_ПравоеЗначение;
	
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветФона", ЦветФона);
	
КонецПроцедуры

//#9470
Процедура ЗаполнитьЦеныПредыдущегоПоступления(Объект, ИмяТабличнойЧасти, Отбор = Неопределено) Экспорт
	
	ВариантОтображения = ПолучитьФункциональнуюОпцию("ВариантОтображенияПредыдущейЦеныВДокументахЗакупки");
	
	ТаблицаДанных = Объект[ИмяТабличнойЧасти].Выгрузить(,"Номенклатура,ХарактеристикаНоменклатуры,ЕдиницаИзмерения");
	
	Если НЕ Отбор = Неопределено Тогда
		ТаблицаДанных.Очистить();
		НоваяСтрока = ТаблицаДанных.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Отбор);
		
		НайденныеСтроки = Объект[ИмяТабличнойЧасти].НайтиСтроки(Отбор);
		Для каждого НайденнаяСтрока Из НайденныеСтроки Цикл
			НайденнаяСтрока.ЦенаПредыдущегоПоступления = 0;
		КонецЦикла;
		
	Иначе
		Для каждого НайденнаяСтрока Из Объект[ИмяТабличнойЧасти] Цикл
			НайденнаяСтрока.ЦенаПредыдущегоПоступления = 0;
		КонецЦикла;
		
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТаблицаДанных", ТаблицаДанных);
	Запрос.УстановитьПараметр("ВариантОтбора", ВариантОтображения);
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	Запрос.УстановитьПараметр("Контрагент", Объект.Контрагент);		
	Запрос.УстановитьПараметр("Договор", Объект.ДоговорКонтрагента);
	Запрос.УстановитьПараметр("Валюта", Объект.Валюта);
	Запрос.УстановитьПараметр("Дата", ?(Объект.Дата = Дата(1,1,1), ТекущаяДатаСеанса(), Объект.Дата));
	
	Запрос.Текст =	
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТаблицаДанных.Номенклатура КАК Номенклатура,
	|	ТаблицаДанных.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	|	ТаблицаДанных.ЕдиницаИзмерения КАК ЕдиницаИзмерения
	|ПОМЕСТИТЬ ТЗ_Товары
	|ИЗ
	|	&ТаблицаДанных КАК ТаблицаДанных
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ПоступлениеТоваров.Ссылка.Дата КАК Дата,
	|	ПоступлениеТоваров.Номенклатура КАК Номенклатура,
	|	ПоступлениеТоваров.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	|	ПоступлениеТоваров.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	ПоступлениеТоваров.Цена КАК Цена
	|ПОМЕСТИТЬ ВТ_Поступления
	|ИЗ
	|	Документ.ПоступлениеТоваровИУслуг.Товары КАК ПоступлениеТоваров
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТЗ_Товары КАК ТЗ_Товары
	|		ПО (ТЗ_Товары.Номенклатура = ПоступлениеТоваров.Номенклатура)
	|			И (ТЗ_Товары.ХарактеристикаНоменклатуры = ПоступлениеТоваров.ХарактеристикаНоменклатуры)
	|			И (ТЗ_Товары.ЕдиницаИзмерения = ПоступлениеТоваров.ЕдиницаИзмерения)
	|ГДЕ
	|	ПоступлениеТоваров.Ссылка.Проведен
	|	И ВЫБОР
	|			КОГДА &ВариантОтбора = 0
	|				ТОГДА ПоступлениеТоваров.Ссылка.Контрагент = &Контрагент
	|						И ПоступлениеТоваров.Ссылка.ДоговорКонтрагента = &Договор
	|			КОГДА &ВариантОтбора = 1
	|				ТОГДА ПоступлениеТоваров.Ссылка.Организация = &Организация
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|	И ПоступлениеТоваров.Ссылка.Валюта = &Валюта
	|	И ПоступлениеТоваров.Ссылка.Проведен
	|	И ПоступлениеТоваров.Ссылка.Дата < &Дата
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ПоступлениеУслуг.Ссылка.Дата,
	|	ПоступлениеУслуг.Номенклатура,
	|	ПоступлениеУслуг.ХарактеристикаНоменклатуры,
	|	ПоступлениеУслуг.ЕдиницаИзмерения,
	|	ПоступлениеУслуг.Цена
	|ИЗ
	|	Документ.ПоступлениеТоваровИУслуг.Товары КАК ПоступлениеУслуг
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТЗ_Товары КАК ТЗ_Товары
	|		ПО (ТЗ_Товары.Номенклатура = ПоступлениеУслуг.Номенклатура)
	|			И (ТЗ_Товары.ХарактеристикаНоменклатуры = ПоступлениеУслуг.ХарактеристикаНоменклатуры)
	|			И (ТЗ_Товары.ЕдиницаИзмерения = ПоступлениеУслуг.ЕдиницаИзмерения)
	|ГДЕ
	|	ПоступлениеУслуг.Ссылка.Проведен
	|	И ВЫБОР
	|			КОГДА &ВариантОтбора = 0
	|				ТОГДА ПоступлениеУслуг.Ссылка.Контрагент = &Контрагент
	|						И ПоступлениеУслуг.Ссылка.ДоговорКонтрагента = &Договор
	|			КОГДА &ВариантОтбора = 1
	|				ТОГДА ПоступлениеУслуг.Ссылка.Организация = &Организация
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|	И ПоступлениеУслуг.Ссылка.Валюта = &Валюта
	|	И ПоступлениеУслуг.Ссылка.Проведен
	|	И ПоступлениеУслуг.Ссылка.Дата < &Дата
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	НоменклатураМаксДата.Номенклатура КАК Номенклатура,
	|	ВТ_Поступления.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	|	ВТ_Поступления.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	ВТ_Поступления.Цена КАК ЦенаПредыдущегоПоступления
	|ИЗ
	|	(ВЫБРАТЬ
	|		ВТ_Поступления.Номенклатура КАК Номенклатура,
	|		МАКСИМУМ(ВТ_Поступления.Дата) КАК Дата,
	|		ВТ_Поступления.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	|		ВТ_Поступления.ЕдиницаИзмерения КАК ЕдиницаИзмерения
	|	ИЗ
	|		ТЗ_Товары КАК ТЗ_Товары
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_Поступления КАК ВТ_Поступления
	|			ПО ТЗ_Товары.Номенклатура = ВТ_Поступления.Номенклатура
	|				И ТЗ_Товары.ХарактеристикаНоменклатуры = ВТ_Поступления.ХарактеристикаНоменклатуры
	|				И ТЗ_Товары.ЕдиницаИзмерения = ВТ_Поступления.ЕдиницаИзмерения
	|	
	|	СГРУППИРОВАТЬ ПО
	|		ВТ_Поступления.Номенклатура,
	|		ВТ_Поступления.ХарактеристикаНоменклатуры,
	|		ВТ_Поступления.ЕдиницаИзмерения) КАК НоменклатураМаксДата
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_Поступления КАК ВТ_Поступления
	|		ПО НоменклатураМаксДата.Номенклатура = ВТ_Поступления.Номенклатура
	|			И НоменклатураМаксДата.Дата = ВТ_Поступления.Дата
	|			И НоменклатураМаксДата.ХарактеристикаНоменклатуры = ВТ_Поступления.ХарактеристикаНоменклатуры
	|			И НоменклатураМаксДата.ЕдиницаИзмерения = ВТ_Поступления.ЕдиницаИзмерения";
	
	РезультатЗапроса = Запрос.Выполнить();	
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		Отбор = Новый Структура("Номенклатура, ХарактеристикаНоменклатуры, ЕдиницаИзмерения");
		ЗаполнитьЗначенияСвойств(Отбор, Выборка);
		
		НайденныеСтроки = Объект[ИмяТабличнойЧасти].НайтиСтроки(Отбор);
		Для каждого НайденнаяСтрока Из НайденныеСтроки Цикл
			НайденнаяСтрока.ЦенаПредыдущегоПоступления = Выборка.ЦенаПредыдущегоПоступления;
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

Процедура ОтправкаПисемПоЗаданиям() Экспорт
	
	ОбщегоНазначения.ПриНачалеВыполненияРегламентногоЗадания(
	Метаданные.РегламентныеЗадания.ОтправкаПисемПоЗаданиям);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЗаданияНаОтправкуЭлектронныхПисем.Документ КАК Документ,
	|	ЗаданияНаОтправкуЭлектронныхПисем.ВидЗадания КАК ВидЗадания,
	|	ЗаданияНаОтправкуЭлектронныхПисем.Организация КАК Организация,
	|	ЗаданияНаОтправкуЭлектронныхПисем.Контрагент КАК Контрагент
	|ИЗ
	|	РегистрСведений.ЗаданияНаОтправкуЭлектронныхПисем КАК ЗаданияНаОтправкуЭлектронныхПисем
	|ИТОГИ ПО
	|	ВидЗадания";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаВидЗадания = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаВидЗадания.Следующий() Цикл
		
		//#9194
		Если ВыборкаВидЗадания.ВидЗадания = Перечисления.ВидыЗаданийНаОтправкуЭлектронныхПисем.ОтправкаДетализацииВзаиморасчетов Тогда
			
			//#13710
			Если НЕ Константы.ОтправлятьДетализациюВзаиморасчетовПриИзмененииВзаиморасчетов.Получить() Тогда
				Продолжить;
			КонецЕсли;
			
			ВариантОтчета = Константы.ИмяВариантаОтчетаДетализацииВзаиморасчетовДляОтправки.Получить();
			Если НЕ ЗначениеЗаполнено(ВариантОтчета) Тогда
				ЗаписьЖурналаРегистрации("ФоновоеЗадание.ОтправкаПисемПоЗаданиям", УровеньЖурналаРегистрации.Ошибка, , , "Не задан вариант отчета детализации взаиморасчетов");
				Возврат;	
			КонецЕсли;
			ПериодОтчета = Константы.ПериодОтчетаДетализацииВзаиморасчетовДляОтправки.Получить();
			//Если НЕ ЗначениеЗаполнено(ПериодОтчета) Тогда
			//	ЗаписьЖурналаРегистрации("ФоновоеЗадание.ОтправкаПисемПоЗаданиям", УровеньЖурналаРегистрации.Ошибка, , , "Не задан период отчета детализации взаиморасчетов");
			//	Возврат;	
			//КонецЕсли;
			
			ТаблицаДанных = Новый ТаблицаЗначений;
			ТаблицаДанных.Колонки.Добавить("Контрагент", Новый ОписаниеТипов("СправочникСсылка.Контрагенты"));
			Выборка = ВыборкаВидЗадания.Выбрать();
			Пока Выборка.Следующий() Цикл
				НоваяСтрока = ТаблицаДанных.Добавить();
				НоваяСтрока.Контрагент = Выборка.Контрагент;
			КонецЦикла;
			ТаблицаДанных.Свернуть("Контрагент");
			
			Для каждого СтрокаТЗ из ТаблицаДанных Цикл				
				ПочтаКлиента = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(СтрокаТЗ.Контрагент, Справочники.ВидыКонтактнойИнформации.EmailКонтрагента);
				Если НЕ ПустаяСтрока(ПочтаКлиента) Тогда
					РезультатОтправки = СформироватьИОтправитьОтчетДетализацииВзаиморасчетов(ВариантОтчета, ПериодОтчета, СтрокаТЗ.Контрагент);
					Если НЕ РезультатОтправки = Истина Тогда
						ЗаписьЖурналаРегистрации("ФоновоеЗадание.ОтправкаПисемПоЗаданиям", УровеньЖурналаРегистрации.Ошибка, , , "Ошибка отправки письма");
					Иначе
						ОбработатьОчередьЗаданийНаОтправкуЭлектронныхПисем(ВыборкаВидЗадания.ВидЗадания, СтрокаТЗ.Контрагент);
					КонецЕсли;
				Иначе
					// возможно пометить такие заказы обработанными					
				КонецЕсли;
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЦикла;		
	
КонецПроцедуры

Функция СформироватьИОтправитьОтчетДетализацииВзаиморасчетов(ИмяВариантаОтчета, ПериодОтчета, Контрагент, ТолькоСформироватьОтчет = Ложь) Экспорт
	
	Если ТипЗнч(ИмяВариантаОтчета) = Тип("Строка") Тогда
		СхемаКомпоновкиДанных = Отчеты.ДетализацияВзаиморасчетовСКонтрагентом.ПолучитьМакет("ОсновнаяСхемаКомпоновкиДанных");
		МакетОформления = Отчеты.ДетализацияВзаиморасчетовСКонтрагентом.ПолучитьМакет("МакетОформления");
		
		ВариантОтчета = Неопределено;
		Для каждого ВариантОтчетаСКД из СхемаКомпоновкиДанных.ВариантыНастроек Цикл
			Если ВариантОтчетаСКД.Имя = ИмяВариантаОтчета Тогда
				ВариантОтчета = ВариантОтчетаСКД;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	Иначе
		//#14300 использование дополнительного отчета		
		МакетОформления = Неопределено;
		Попытка
			ВнешнийОбъект = ДополнительныеОтчетыИОбработки.ОбъектВнешнейОбработки(ИмяВариантаОтчета);
		Исключение
			Возврат Неопределено;
		КонецПопытки;
		
		ОтчетМетаданные = ВнешнийОбъект.Метаданные();
		СхемаКДМетаданные = ОтчетМетаданные.ОсновнаяСхемаКомпоновкиДанных;
		Если СхемаКДМетаданные <> Неопределено Тогда
			СхемаКомпоновкиДанных = ВнешнийОбъект.ПолучитьМакет(СхемаКДМетаданные.Имя);
			Для каждого ВариантОтчетаСКД из СхемаКомпоновкиДанных.ВариантыНастроек Цикл
				Если ВариантОтчетаСКД.Имя = "Основной" Тогда
					ВариантОтчета = ВариантОтчетаСКД;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			Если ВариантОтчета = Неопределено Тогда
				Возврат Неопределено;	
			КонецЕсли;
		Иначе
			Возврат Неопределено;
		КонецЕсли;
		
	КонецЕсли; 	
	
	НастройкиОСКД = ВариантОтчета.Настройки;
	
	ПараметрыДанныхОСКД = НастройкиОСКД.ПараметрыДанных.Элементы;
	
	ЭлементНачалоПериода = ПараметрыДанныхОСКД.Найти("НачалоПериода"); // должен быть в отчете
	ЭлементНачалоПериода.Использование = Истина;
	ЭлементНачалоПериода.Значение = НачалоДня(ТекущаяДата() - ПериодОтчета*86400);	
	
	ЭлементКонецПериода = ПараметрыДанныхОСКД.Найти("КонецПериода"); // должен быть в отчете	
	ЭлементКонецПериода.Использование = Истина;	
	ЭлементКонецПериода.Значение = КонецДня(ТекущаяДата());
	
	ПолеКомпоновкиКонтрагент = Новый ПолеКомпоновкиДанных("Контрагент"); // должен быть в отчете	
	Для каждого ЭлементОтбора Из НастройкиОСКД.Отбор.Элементы Цикл
		Если ТипЗнч(ЭлементОтбора) = Тип("ЭлементОтбораКомпоновкиДанных") И ЭлементОтбора.ЛевоеЗначение = ПолеКомпоновкиКонтрагент Тогда
			ЭлементОтбора.Использование = Истина;
			ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
			ЭлементОтбора.ПравоеЗначение = Контрагент;
			Прервать;
		КонецЕсли;	
	КонецЦикла;
	
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, НастройкиОСКД, , МакетОформления);
	
	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;	
	ПроцессорКомпоновки.Инициализировать(МакетКомпоновки);
	
	ДокументРезультат = Новый ТабличныйДокумент;
	
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
	ПроцессорВывода.УстановитьДокумент(ДокументРезультат);
	ПроцессорВывода.Вывести(ПроцессорКомпоновки);
	
	// дополнительная обработка результата отчета
	Если ТипЗнч(ИмяВариантаОтчета) = Тип("Строка") Тогда
		ОтчетОбъект = Отчеты.ДетализацияВзаиморасчетовСКонтрагентом.Создать();
		ОтчетОбъект.ПослеКомпоновкиРезультата(ДокументРезультат);
	КонецЕсли;
	
	Если ТолькоСформироватьОтчет Тогда
		// при вызове с формы настроек программы для проверки
		Возврат ДокументРезультат;
	КонецЕсли;
	
	ПисьмоСсылка = РаботаСЭлектроннойПочтой.СформироватьЭлектронноеПисьмоСОтчетом(ДокументРезультат, "Детализация взаиморасчетов", Контрагент, "xls", Истина);
	Если ЗначениеЗаполнено(ПисьмоСсылка) Тогда
		ТекстОтправки = Документы.ЭлектронноеПисьмо.ОтправитьЭлектронноеПисьмо(ПисьмоСсылка);
		Возврат ПустаяСтрока(ТекстОтправки);
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции

Процедура ОбработатьОчередьЗаданийНаОтправкуЭлектронныхПисем(ВидЗадания, Контрагент)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ВидЗадания", ВидЗадания);
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЗаданияНаОтправкуЭлектронныхПисем.Документ КАК Документ,
	|	ЗаданияНаОтправкуЭлектронныхПисем.ВидЗадания КАК ВидЗадания,
	|	ЗаданияНаОтправкуЭлектронныхПисем.Организация КАК Организация,
	|	ЗаданияНаОтправкуЭлектронныхПисем.Контрагент КАК Контрагент
	|ИЗ
	|	РегистрСведений.ЗаданияНаОтправкуЭлектронныхПисем КАК ЗаданияНаОтправкуЭлектронныхПисем
	|ГДЕ
	|	ЗаданияНаОтправкуЭлектронныхПисем.ВидЗадания = &ВидЗадания
	|	И ЗаданияНаОтправкуЭлектронныхПисем.Контрагент = &Контрагент";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл	
		НаборЗаписей = РегистрыСведений.ЗаданияНаОтправкуЭлектронныхПисем.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Документ.Установить(Выборка.Документ); 
		НаборЗаписей.Отбор.ВидЗадания.Установить(Выборка.ВидЗадания);
		НаборЗаписей.Прочитать();
		НаборЗаписей.Очистить();
		НаборЗаписей.Записать(Истина);
	КонецЦикла;	
	
КонецПроцедуры

Процедура ДополнитьОписаниеДатыЗапрета(ЭлементОписаниеДатыЗапрета) Экспорт
	
	ЭлементОписаниеДатыЗапрета.СписокВыбора.Добавить("СтаршеУказанныхДней",    "Старше указанного количества дней");	
	ЭлементОписаниеДатыЗапрета.СписокВыбора.Добавить("СтаршеУказанныхМесяцев", "Старше указанного количества месяцев");
	
	//#16658
	ЭлементОписаниеДатыЗапрета.СписокВыбора.Вставить(1, "БезЗапрета",    		"Без запрета");
	
КонецПроцедуры

Функция ТипВМассиве(ТипИлиОписаниеТипов, МассивТипов) Экспорт
	Если ТипЗнч(ТипИлиОписаниеТипов) = Тип("ОписаниеТипов") Тогда
		Для Каждого Тип Из ТипИлиОписаниеТипов.Типы() Цикл
			Если МассивТипов.Найти(Тип) <> Неопределено Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЦикла;
		Возврат Ложь
	Иначе
		Возврат МассивТипов.Найти(ТипИлиОписаниеТипов) <> Неопределено;
	КонецЕсли;
КонецФункции

Функция ОбъединитьТипы(Тип1, Тип2) Экспорт
	Тип1ЭтоОписаниеТипов = ТипЗнч(Тип1) = Тип("ОписаниеТипов");
	Тип2ЭтоОписаниеТипов = ТипЗнч(Тип2) = Тип("ОписаниеТипов");
	Если Тип1ЭтоОписаниеТипов И Тип1.Типы().Количество() > 0 Тогда
		ИсходноеОписаниеТипов = Тип1;
		ДобавляемыеТипы = ?(Тип2ЭтоОписаниеТипов, Тип2.Типы(), ЗначениеВМассив(Тип2));
	ИначеЕсли Тип2ЭтоОписаниеТипов И Тип2.Типы().Количество() > 0 Тогда
		ИсходноеОписаниеТипов = Тип2;
		ДобавляемыеТипы = ЗначениеВМассив(Тип1);
	ИначеЕсли ТипЗнч(Тип1) <> Тип("Тип") Тогда
		Возврат Тип2;
	ИначеЕсли ТипЗнч(Тип2) <> Тип("Тип") Тогда
		Возврат Тип1;
	Иначе
		Типы = Новый Массив;
		Типы.Добавить(Тип1);
		Типы.Добавить(Тип2);
		Возврат Новый ОписаниеТипов(Типы);
	КонецЕсли;
	Если ДобавляемыеТипы.Количество() = 0 Тогда
		Возврат ИсходноеОписаниеТипов;
	Иначе
		Возврат Новый ОписаниеТипов(ИсходноеОписаниеТипов, ДобавляемыеТипы);
	КонецЕсли;
КонецФункции

Функция ЗначениеВМассив(Значение) Экспорт
	Результат = Новый Массив;
	Результат.Добавить(Значение);
	Возврат Результат;
КонецФункции

