	//++ №13645
	//|	ВТ_ПоказательЛиды.Показатель КАК Показатель,
	|	ЕСТЬNULL(ВТ_ПоказательЛиды.Показатель, ""(неопределено)"") КАК Показатель,
	//-- №13645
	|	СУММА(ВТ_ПоЛидам.КоличествоДоговоров) КАК КоличествоДоговоров2,
	|	СУММА(ВТ_ПоЛидам.СуммаДоговоров) КАК СуммаДоговоров,
	|	СУММА(ВТ_ПоЛидам.Площадь) КАК Площадь,
	|	СУММА(ВТ_ПоЛидам.СреднийЧекСумма) КАК СреднийЧекСумма,
	|	СУММА(ВТ_ПоЛидам.СуммаПредварительногоРасчета) КАК СуммаПредварительногоРасчета,
	|	СУММА(ВТ_ПоЛидам.СуммаСкидки) КАК СуммаСкидкиДоговоров,
	|	СУММА(ВТ_ПоЛидам.СуммаДоговоровПоПрайсу) КАК СуммаДоговоровПоПрайсу
	|ИЗ
	|	ВТ_ПоказательЛиды КАК ВТ_ПоказательЛиды
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ПоЛидамПродолжение КАК ВТ_ПоЛидам
	|		ПО ВТ_ПоказательЛиды.Контакт = ВТ_ПоЛидам.Контакт
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_ПоказательЛиды.Контакт,
	|	ВТ_ПоказательЛиды.Показатель";
	
	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
