
Процедура ЗаполнитьОбщиеРеквизиты(ДокументСсылка, ОбщиеПараметры, ЭкземплярПодключаемогоОборудования = Неопределено) Экспорт
	
	//ОбщиеПараметры определяемые функцией
	//МенеджерОборудованияКлиентСервер.ПараметрыОперацииФискализацииЧека();
	
	ОбщиеПараметры.Вставить("ДокументОснование" , ДокументСсылка); // Ссылка,Обязательно. Документ по которому пробивается чек. 
	ОбщиеПараметры.Вставить("Организация"       , ДокументСсылка.Организация); // Ссылка,Обязательно. Организация по которому пробивается чек.
	
	ОбщиеПараметры.ТипРасчета          = ПредопределенноеЗначение("Перечисление.ТипыРасчетаДенежнымиСредствами.ПриходДенежныхСредств");
	Если ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.ЧекККМ") 
		ИЛИ ТипЗнч(ДокументСсылка) = Тип("Структура") Тогда
		Если ДокументСсылка.ВидОперации = Перечисления.ВидыОперацийЧекККМ.Возврат Тогда			
			ОбщиеПараметры.ТипРасчета = ПредопределенноеЗначение("Перечисление.ТипыРасчетаДенежнымиСредствами.ВозвратДенежныхСредств");
		КонецЕсли;
	
	ИначеЕсли ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.РасходныйКассовыйОрдер") Тогда
		ОбщиеПараметры.ТипРасчета      = ПредопределенноеЗначение("Перечисление.ТипыРасчетаДенежнымиСредствами.ВозвратДенежныхСредств");
		
	ИначеЕсли ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.ОплатаБанковскойКартой") Тогда
		Если ДокументСсылка.ВидОперации = Перечисления.ВидыОперацийОплатаБанковскойКартой.ВозвратОплатыКлиенту Тогда			
			ОбщиеПараметры.ТипРасчета = ПредопределенноеЗначение("Перечисление.ТипыРасчетаДенежнымиСредствами.ВозвратДенежныхСредств");
		КонецЕсли;
	КонецЕсли;
	
	РеквизитыОрганизации = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументСсылка.Организация, "Наименование,ПолноеНаименование,ИНН,КПП");
	
	ОбщиеПараметры.ОрганизацияНазвание = ?(ПустаяСтрока(РеквизитыОрганизации.ПолноеНаименование), РеквизитыОрганизации.Наименование, РеквизитыОрганизации.ПолноеНаименование);
	ОбщиеПараметры.ОрганизацияИНН      = РеквизитыОрганизации.ИНН;
	ОбщиеПараметры.ОрганизацияКПП      = РеквизитыОрганизации.КПП;
	ОбщиеПараметры.АдресРасчетов   	   = ПолучитьАдресРасчетов(ДокументСсылка);	
	ОбщиеПараметры.МестоРасчетов       = "";
	
	ОбщиеПараметры.СистемаНалогообложения = ПолучитьСистемуНалогообложения(ДокументСсылка.Организация, ДокументСсылка.Подразделение); // #14195 добавлено Подразделение
	
	РеквизитыКассира = ПотолкиКассыОнлайн.РеквизитыКассира(ДокументСсылка.Автор);
	ОбщиеПараметры.Кассир    = РеквизитыКассира.Наименование;
	ОбщиеПараметры.КассирИНН = РеквизитыКассира.ИНН;
	
	СведенияОКонтрагенте = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументСсылка.Контрагент, "НаименованиеПолное,ИНН,ВидКонтрагента");
	Если СведенияОКонтрагенте.ВидКонтрагента = Перечисления.ВидКонтрагента.ЮрЛицо 
		ИЛИ ЗначениеЗаполнено(СведенияОКонтрагенте.ИНН) Тогда			
		ОбщиеПараметры.Получатель    = СведенияОКонтрагенте.НаименованиеПолное;
		ОбщиеПараметры.ПолучательИНН = СведенияОКонтрагенте.ИНН;		
	КонецЕсли;
	
	Если НЕ ЭкземплярПодключаемогоОборудования = Неопределено Тогда
		РеквизитыККТ = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ЭкземплярПодключаемогоОборудования, "ТипОборудования,СпособФорматноЛогическогоКонтроля");
		Если РеквизитыККТ.ТипОборудования = Перечисления.ТипыПодключаемогоОборудования.ККТ Тогда
			ОбщиеПараметры.СпособФорматноЛогическогоКонтроля = РеквизитыККТ.СпособФорматноЛогическогоКонтроля;
		КонецЕсли;
	КонецЕсли;
	
	// Параметры необходимые для чека ЕНВД на принтере чеков
	ОбщиеПараметры.НомерКассы = 1;
	Если НЕ ТипЗнч(ДокументСсылка) = Тип("Структура") И ОбщегоНазначения.ЕстьРеквизитОбъекта("Касса", ДокументСсылка.Метаданные()) Тогда		
		ОбщиеПараметры.НомерКассы = ДокументСсылка.Касса.НомерКассы; 
	КонецЕсли;
	ОбщиеПараметры.НомерЧека  = ДокументСсылка.Номер;
	ОбщиеПараметры.НомерСмены = 1;
	
КонецПроцедуры

Процедура ДополнитьТоварамиПараметрыПриПробитииЧека(ДокументОбъект, ОбщиеПараметры) Экспорт
	
	ТаблицаДокумента = ДокументОбъект.РаспределениеПлатежа.Выгрузить(,"Документ,Сумма");	
	ТаблицаДокумента.Свернуть("Документ", "Сумма");
	ТаблицаДокумента.Колонки.Добавить("ТипДокумента");
	ТаблицаДокумента.Колонки.Добавить("СуммаДокумента");
	ЕстьДокументыПродажи 	 = Ложь;
	ЕстьЗаказДоговоры 		 = Ложь;
	ЕстьЗаказыПокупателей 	 = Ложь;
	ЕстьЗаказыНаПроизводство = Ложь;
	ЕстьВозвраты 			 = Ложь;
	Для каждого ТекСтрока Из ТаблицаДокумента Цикл
		ТекСтрока.ТипДокумента = ТипЗнч(ТекСтрока.Документ);
		ТекСтрока.СуммаДокумента = ТекСтрока.Документ.СуммаДокумента;
		
		Если ТипЗнч(ТекСтрока.Документ) = Тип("ДокументСсылка.Монтаж")
			ИЛИ ТипЗнч(ТекСтрока.Документ) = Тип("ДокументСсылка.РеализацияТоваровИУслуг") Тогда
			ЕстьДокументыПродажи = Истина;
		ИначеЕсли ТипЗнч(ТекСтрока.Документ) = Тип("ДокументСсылка.ЗаказДоговор") Тогда	
			ЕстьЗаказДоговоры = Истина;
		ИначеЕсли ТипЗнч(ТекСтрока.Документ) = Тип("ДокументСсылка.ЗаказПокупателя") Тогда	
			ЕстьЗаказыПокупателей = Истина;
		ИначеЕсли ТипЗнч(ТекСтрока.Документ) = Тип("ДокументСсылка.ЗаказНаПроизводство") Тогда	
			ЕстьЗаказыНаПроизводство = Истина;
		КонецЕсли;		
	КонецЦикла;
	
	НомерСтрокиТовара = 0;
	
	ТребуетсяЗачетАванса = Истина;
	// Таблица оплат
	Если ТипЗнч(ДокументОбъект) = Тип("ДокументСсылка.ПриходныйКассовыйОрдер") ИЛИ ТипЗнч(ДокументОбъект) = Тип("ДокументСсылка.РасходныйКассовыйОрдер") Тогда
		СтрокаОплаты  = МенеджерОборудованияКлиентСервер.ПараметрыСтрокиОплаты();
		СтрокаОплаты.ТипОплаты = ПредопределенноеЗначение("Перечисление.ТипыОплатыККТ.Наличные"); 
		СтрокаОплаты.Сумма = ДокументОбъект.Сумма;
		ОбщиеПараметры.ТаблицаОплат.Добавить(СтрокаОплаты);
	ИначеЕсли ТипЗнч(ДокументОбъект) = Тип("ДокументСсылка.ОплатаБанковскойКартой") ИЛИ ТипЗнч(ДокументОбъект) = Тип("ДокументСсылка.ПоступлениеНаРасчетныйСчет") Тогда
		СтрокаОплаты  = МенеджерОборудованияКлиентСервер.ПараметрыСтрокиОплаты();
		СтрокаОплаты.ТипОплаты = ПредопределенноеЗначение("Перечисление.ТипыОплатыККТ.Электронно"); 
		СтрокаОплаты.Сумма = ДокументОбъект.Сумма;
		ОбщиеПараметры.ТаблицаОплат.Добавить(СтрокаОплаты);
	КонецЕсли;
	
	// документ без распределения
	Если ТаблицаДокумента.Количество() = 0 Тогда
		ДобавитьСтрокуАванса(ОбщиеПараметры, НомерСтрокиТовара, ДокументОбъект.Контрагент, ДокументОбъект.Сумма);
		Возврат;
	КонецЕсли;
	
	Если НЕ ЕстьДокументыПродажи Тогда
		//распределение по заказам
		СуммаРаспределенияПоЗаказам = 0;
		СуммаПоЗаказам = 0;
		СуммаСтрокиАванса = 0;
		ЗачетАванса = 0;
		МассивЗаказов = Новый Массив;
		Если ЕстьЗаказДоговоры Тогда
			РассчитатьСуммы(ТаблицаДокумента, Тип("ДокументСсылка.ЗаказДоговор"), МассивЗаказов, СуммаРаспределенияПоЗаказам, СуммаПоЗаказам);
		ИначеЕсли ЕстьЗаказыПокупателей Тогда
			РассчитатьСуммы(ТаблицаДокумента, Тип("ДокументСсылка.ЗаказПокупателя"), МассивЗаказов, СуммаРаспределенияПоЗаказам, СуммаПоЗаказам);
		ИначеЕсли ЕстьЗаказыНаПроизводство Тогда	
			РассчитатьСуммы(ТаблицаДокумента, Тип("ДокументСсылка.ЗаказНаПроизводство"), МассивЗаказов, СуммаРаспределенияПоЗаказам, СуммаПоЗаказам);
		КонецЕсли;
		
		ПризнакСпособаРасчета = Перечисления.ПризнакиСпособаРасчета.ПредоплатаПолная;
		Если СуммаПоЗаказам > СуммаРаспределенияПоЗаказам Тогда
			ПризнакСпособаРасчета = Перечисления.ПризнакиСпособаРасчета.ПредоплатаЧастичная;	
		//ИначеЕсли ДокументОбъект.Сумма > СуммаРаспределенияПоЗаказам Тогда
		КонецЕсли;	
		Если ДокументОбъект.Сумма > СуммаРаспределенияПоЗаказам Тогда
			СуммаСтрокиАванса = ДокументОбъект.Сумма - СуммаРаспределенияПоЗаказам
		КонецЕсли;
		ПризнакПредметаРасчета = Перечисления.ПризнакиПредметаРасчета.ПлатежВыплата;
			
		// Позиции по заказам
		Если МассивЗаказов.Количество() > 0 Тогда
			ДобавитьПозицииЧекаПоДокументамРасчетов(МассивЗаказов, ОбщиеПараметры, НомерСтрокиТовара, ПризнакСпособаРасчета, ПризнакПредметаРасчета); 			
		КонецЕсли;
		
		Если СуммаСтрокиАванса > 0 Тогда
			ДобавитьСтрокуАванса(ОбщиеПараметры, НомерСтрокиТовара, ДокументОбъект.Контрагент, СуммаСтрокиАванса);
		КонецЕсли;			
		
		Если НЕ ОбщиеПараметры.ТипРасчета = Перечисления.ТипыРасчетаДенежнымиСредствами.ВозвратДенежныхСредств Тогда //++ 2021-04-14 если возврат аванса, то не добавляем дополнительные строки оплат		
			//Сумма ПКО меньше суммы документов		
			ЗачетАванса = РассчитатьЗачетАванса(МассивЗаказов, СуммаПоЗаказам, ДокументОбъект.МоментВремени().Дата);	
			Если ЗачетАванса > 0 Тогда
				СтрокаОплаты  = МенеджерОборудованияКлиентСервер.ПараметрыСтрокиОплаты();
				СтрокаОплаты.ТипОплаты = ПредопределенноеЗначение("Перечисление.ТипыОплатыККТ.Предоплата");
				СтрокаОплаты.Сумма = ЗачетАванса;
				ОбщиеПараметры.ТаблицаОплат.Добавить(СтрокаОплаты);
			КонецЕсли;
		КонецЕсли;
		
		Постоплата = СуммаПоЗаказам - ЗачетАванса - ДокументОбъект.Сумма;
		Если Постоплата > 0 Тогда
			СтрокаОплаты  = МенеджерОборудованияКлиентСервер.ПараметрыСтрокиОплаты();
			СтрокаОплаты.ТипОплаты = ПредопределенноеЗначение("Перечисление.ТипыОплатыККТ.Постоплата");
			СтрокаОплаты.Сумма = Постоплата;
			ОбщиеПараметры.ТаблицаОплат.Добавить(СтрокаОплаты);
		КонецЕсли;		 

	Иначе
		// распределение по документам продажи
		СуммаРаспределенияПоДокументам = 0;
		СуммаПоДокументам = 0;
		СуммаСтрокиАванса = 0;
		ЗачетАванса = 0;
		МассивДокументов = Новый Массив;
		
		РассчитатьСуммы(ТаблицаДокумента, Тип("ДокументСсылка.РеализацияТоваровИУслуг"), МассивДокументов, СуммаРаспределенияПоДокументам, СуммаПоДокументам);
		Если МассивДокументов.Количество() = 0 Тогда
			РассчитатьСуммы(ТаблицаДокумента, Тип("ДокументСсылка.Монтаж"), МассивДокументов, СуммаРаспределенияПоДокументам, СуммаПоДокументам);	
		КонецЕсли;
		
		ПризнакСпособаРасчета = Перечисления.ПризнакиСпособаРасчета.ОплатаКредита;
		
		Если ДокументОбъект.Сумма > СуммаРаспределенияПоДокументам Тогда
			СуммаСтрокиАванса = ДокументОбъект.Сумма - СуммаРаспределенияПоДокументам;
		КонецЕсли;

		Если СуммаПоДокументам > ДокументОбъект.Сумма Тогда
			//Сумма ПКО меньше суммы документов
			
		КонецЕсли;
		
		// Позиции по документам
		Если МассивДокументов.Количество() > 0 Тогда
			ДобавитьПозицииЧекаПоДокументамРасчетов(МассивДокументов, ОбщиеПараметры, НомерСтрокиТовара, ПризнакСпособаРасчета);
		КонецЕсли;
		
		Если СуммаСтрокиАванса > 0 Тогда
			ДобавитьСтрокуАванса(ОбщиеПараметры, НомерСтрокиТовара, ДокументОбъект.Контрагент, СуммаСтрокиАванса);
		КонецЕсли;
				
		//Если СуммаПоДокументам > ДокументОбъект.Сумма Тогда
			//Сумма ПКО меньше суммы документов
		Если НЕ ОбщиеПараметры.ТипРасчета = Перечисления.ТипыРасчетаДенежнымиСредствами.ВозвратДенежныхСредств Тогда // #13445 продублировано условие как по заказам	
			ЗачетАванса = РассчитатьЗачетАванса(МассивДокументов, СуммаПоДокументам, ДокументОбъект.МоментВремени().Дата);
			Если ЗачетАванса > 0 Тогда
				СтрокаОплаты  = МенеджерОборудованияКлиентСервер.ПараметрыСтрокиОплаты();
				СтрокаОплаты.ТипОплаты = ПредопределенноеЗначение("Перечисление.ТипыОплатыККТ.Предоплата");
				СтрокаОплаты.Сумма = ЗачетАванса;
				ОбщиеПараметры.ТаблицаОплат.Добавить(СтрокаОплаты);
			КонецЕсли;			
		КонецЕсли;
		
		Постоплата = СуммаПоДокументам - ЗачетАванса - ДокументОбъект.Сумма;
		Если Постоплата > 0 Тогда
			СтрокаОплаты  = МенеджерОборудованияКлиентСервер.ПараметрыСтрокиОплаты();
			СтрокаОплаты.ТипОплаты = ПредопределенноеЗначение("Перечисление.ТипыОплатыККТ.Постоплата");
			СтрокаОплаты.Сумма = Постоплата;
			ОбщиеПараметры.ТаблицаОплат.Добавить(СтрокаОплаты);
		КонецЕсли;
		//КонецЕсли;

	КонецЕсли;
	
	// #11287 СпособФорматноЛогическогоКонтроля - заполняем при заполнении общих параметров
	Если НЕ ОбщиеПараметры.СпособФорматноЛогическогоКонтроля = Неопределено Тогда
		Отказ = Ложь;
		МенеджерОборудованияВызовСервера.ПривестиДанныеКТребуемомуФормату(ОбщиеПараметры, Отказ, "", Ложь);
	КонецЕсли;
	
КонецПроцедуры

Процедура ДополнитьТоварамиПараметрыПриПробитииЧекаПоДокументуПродажи(ДокументСсылка, ОбщиеПараметры) Экспорт
	
	// процедура для РТиУ и монтаж
	СуммаДокумента = ДокументСсылка.СуммаДокумента;
	МассивДокументов = Новый Массив;
	//МассивДокументов.Добавить(ДокументСсылка);
	МассивДокументов.Добавить(Новый Структура("Документ, СуммаДокумента, СуммаРаспределения", ДокументСсылка, СуммаДокумента, СуммаДокумента));
	
	ЗачетАванса = РассчитатьЗачетАванса(МассивДокументов, СуммаДокумента, ДокументСсылка.МоментВремени().Дата + 1);
	Постоплата = СуммаДокумента - ЗачетАванса;
	
	НомерСтрокиТовара = 0;
	ПризнакСпособаРасчета = Неопределено;
					
	Если ЗачетАванса = 0 Тогда
		ПризнакСпособаРасчета = Перечисления.ПризнакиСпособаРасчета.ПередачаБезОплаты; 
	ИначеЕсли ЗачетАванса >= СуммаДокумента Тогда
		ПризнакСпособаРасчета = Перечисления.ПризнакиСпособаРасчета.ПередачаСПолнойОплатой;
	ИначеЕсли ЗачетАванса < СуммаДокумента Тогда
		ПризнакСпособаРасчета = Перечисления.ПризнакиСпособаРасчета.ПередачаСЧастичнойОплатой;
	КонецЕсли;
	
	ДобавитьПозицииЧекаПоДокументамРасчетов(МассивДокументов, ОбщиеПараметры, НомерСтрокиТовара, ПризнакСпособаРасчета);
	
	// Таблица оплат
	Если ЗачетАванса > 0 Тогда
		СтрокаОплаты  = МенеджерОборудованияКлиентСервер.ПараметрыСтрокиОплаты();
		СтрокаОплаты.ТипОплаты = ПредопределенноеЗначение("Перечисление.ТипыОплатыККТ.Предоплата");
		СтрокаОплаты.Сумма = ЗачетАванса;
		ОбщиеПараметры.ТаблицаОплат.Добавить(СтрокаОплаты);
	КонецЕсли;
	
	Если Постоплата > 0 Тогда
		СтрокаОплаты  = МенеджерОборудованияКлиентСервер.ПараметрыСтрокиОплаты();
		СтрокаОплаты.ТипОплаты = ПредопределенноеЗначение("Перечисление.ТипыОплатыККТ.Постоплата");
		СтрокаОплаты.Сумма = Постоплата;
		ОбщиеПараметры.ТаблицаОплат.Добавить(СтрокаОплаты);
	КонецЕсли;
		
КонецПроцедуры

Процедура ДополнитьТоварамиПараметрыПриПробитииЧекаПоЧекуККМ(СтруктураДанных, ОбщиеПараметры) Экспорт
	// процедура для ЧекККМ
	ДокументСсылка = СтруктураДанных.ЧекККМСсылка;
	МассивДокументов = Новый Массив;
	МассивДокументов.Добавить(новый Структура("Документ, СуммаДокумента, СуммаРаспределения", ДокументСсылка, ДокументСсылка.СуммаДокумента, ДокументСсылка.СуммаДокумента));
	//СуммаДокумента = ДокументСсылка.СуммаДокумента;
	//ЗачетАванса = РассчитатьЗачетАванса(МассивДокументов, СуммаДокумента, ДокументСсылка.МоментВремени().Дата + 1);
	//Постоплата = СуммаДокумента - ЗачетАванса;
	
	НомерСтрокиТовара = 0;
	ПризнакСпособаРасчета = Неопределено;
					
	ПризнакСпособаРасчета = Перечисления.ПризнакиСпособаРасчета.ПередачаСПолнойОплатой;
	
	ДобавитьПозицииЧекаПоДокументамРасчетов(МассивДокументов, ОбщиеПараметры, НомерСтрокиТовара, ПризнакСпособаРасчета);
	
	// Таблица оплат
	Если НЕ СтруктураДанных.Свойство("ТаблицаОплат") Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЧекККМОплата.Сумма,
		|	ВЫРАЗИТЬ(ЧекККМОплата.ВидОплаты КАК Перечисление.ВидыОплатЧекаККМ) КАК ВидОплаты
		|ПОМЕСТИТЬ ТаблицаВЗапросе
		|ИЗ
		|	&Оплата КАК ЧекККМОплата
		|ГДЕ
		|	НЕ ЧекККМОплата.ВидОплаты = ЗНАЧЕНИЕ(Перечисление.ВидыОплатЧекаККМ.ПустаяСсылка)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ТаблицаВЗапросе.Сумма,
		//|	ТаблицаВЗапросе.ВидОплаты.ТипОплаты КАК ТипОплаты
		|	ВЫБОР 
		|		КОГДА ТаблицаВЗапросе.ВидОплаты = ЗНАЧЕНИЕ(Перечисление.ВидыОплатЧекаККМ.Наличные)
		|		ТОГДА ЗНАЧЕНИЕ(Перечисление.ТипыОплатыККТ.Наличные)
		|		КОГДА ТаблицаВЗапросе.ВидОплаты = ЗНАЧЕНИЕ(Перечисление.ВидыОплатЧекаККМ.ПлатежнаяКарта)
		|		ТОГДА ЗНАЧЕНИЕ(Перечисление.ТипыОплатыККТ.Электронно)
		|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.ТипыОплатыККТ.Наличные)
		|	КОНЕЦ КАК ТипОплаты
		|ПОМЕСТИТЬ ТаблицаСТипамиОплат
		|ИЗ
		|	ТаблицаВЗапросе КАК ТаблицаВЗапросе
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СУММА(ТаблицаСТипамиОплат.Сумма) КАК Сумма,
		|	ТаблицаСТипамиОплат.ТипОплаты
		|ИЗ
		|	ТаблицаСТипамиОплат КАК ТаблицаСТипамиОплат
		|
		|СГРУППИРОВАТЬ ПО
		|	ТаблицаСТипамиОплат.ТипОплаты
		|
		|ИМЕЮЩИЕ
		|	СУММА(ТаблицаСТипамиОплат.Сумма) >= 0";
		
		Запрос.УстановитьПараметр("Оплата", ДокументСсылка.Оплата.Выгрузить());
		
		Результат = Запрос.Выполнить();
		ТаблицаПоТипамОплат = Результат.Выгрузить();
	Иначе
