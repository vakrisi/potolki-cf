Функция РеквизитыКассира(Кассир = Неопределено) Экспорт
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	ЕСТЬNULL(Пользователи.Сотрудник.ИНН, """") КАК ИНН,
	|	ЕСТЬNULL(Пользователи.Сотрудник.Наименование, """") КАК Наименование
	|ИЗ
	|	Справочник.Пользователи КАК Пользователи
	|ГДЕ
	|	Пользователи.Ссылка = &Кассир");
	Запрос.УстановитьПараметр("Кассир", ?(Кассир = Неопределено, Пользователи.ТекущийПользователь(), Кассир));
	
	РеквизитыКассира = Новый Структура;
	РеквизитыКассира.Вставить("ИНН", "");
	РеквизитыКассира.Вставить("Наименование", НСтр("ru = 'Администратор'"));
	
	ВыборкаРеквизитыКассира = Запрос.Выполнить().Выбрать();
	Если ВыборкаРеквизитыКассира.Следующий() Тогда
		
		Если ЗначениеЗаполнено(ВыборкаРеквизитыКассира.Наименование) Тогда
			РеквизитыКассира.Наименование = ВыборкаРеквизитыКассира.Наименование;
		КонецЕсли;
		
		РеквизитыКассира.ИНН = ВыборкаРеквизитыКассира.ИНН;
		
	КонецЕсли;
	
	Возврат РеквизитыКассира;
	
КонецФункции

Процедура ЗаполнитьПараметрыОтправкиЭлектронногоЧекаПоПартнеру(Форма) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Если Не ЗначениеЗаполнено(Форма.Партнер) Тогда
		
		ВариантОтправкиЭлектронногоЧекаПартнера = Перечисления.ВариантыОтправкиЭлектронногоЧекаПокупателю.ПустаяСсылка();
		ВариантОтправкиЭлектронногоЧека = Перечисления.ВариантыОтправкиЭлектронногоЧекаПокупателю.НеОтправлять;
		
	Иначе
		
		ВариантОтправкиЭлектронногоЧека = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Форма.Партнер, "ВариантОтправкиЭлектронногоЧека");
		
		Форма.ВариантОтправкиЭлектронногоЧекаПартнера = ВариантОтправкиЭлектронногоЧека;
		Если Не ЗначениеЗаполнено(ВариантОтправкиЭлектронногоЧека) Тогда
			ВариантОтправкиЭлектронногоЧека = Перечисления.ВариантыОтправкиЭлектронногоЧекаПокупателю.НеОтправлять;
		КонецЕсли;
		
		// телефоны контрагента
		ТелефонКлиента = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(Форма.Партнер, Справочники.ВидыКонтактнойИнформации.ТелефонКонтрагента);
		Форма.Телефон10Знаков = НомерТелефонаВФормате10Знаков(ТелефонКлиента);
		Форма.Телефон = СофтФон.ПолучитьНомерТелефонаВМеждународномФорматеПользователя(ТелефонКлиента); //"+7" + Форма.Телефон10Знаков;  //#6074 изменено на вызов функции из модуля Софтфон 
		Форма.Элементы.Телефон.СписокВыбора.Добавить(Форма.Телефон);
		
		//электронные адреса контрагента
		ПочтаКлиента = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(Форма.Партнер, Справочники.ВидыКонтактнойИнформации.EmailКонтрагента);
		Форма.Email = ПочтаКлиента;
		Форма.Элементы.Email.СписокВыбора.Добавить(Форма.Email);	
		
		Если Форма.Элементы.Телефон.СписокВыбора.Количество() > 0 Тогда
			Форма.Элементы.Телефон.КнопкаВыпадающегоСписка = Истина;
		КонецЕсли;
		
		Если Форма.Элементы.Email.СписокВыбора.Количество() > 0 Тогда
			Форма.Элементы.Email.КнопкаВыпадающегоСписка = Истина;
		КонецЕсли;
		
	КонецЕсли;
	
	УстановитьВариантОтправкиЭлектронногоЧека(Форма, ВариантОтправкиЭлектронногоЧека);
	
КонецПроцедуры

Процедура УстановитьВариантОтправкиЭлектронногоЧека(Форма, ВариантОтправкиЭлектронногоЧека) Экспорт
	
	Если Форма.ВариантОтправкиЭлектронногоЧека = ВариантОтправкиЭлектронногоЧека Тогда
		Возврат;
	КонецЕсли;
	
	Форма.ВариантОтправкиЭлектронногоЧека = ВариантОтправкиЭлектронногоЧека;
	
КонецПроцедуры

// Получить 10 знаков номера телефона по переданному представлению.
//
// Параметры:
//  Телефон - Строка - Представление номера телефона.
// 
// Возвращаемое значение:
//  Строка - 10 знаков номера телефона.
//
Функция НомерТелефонаВФормате10Знаков(Телефон) Экспорт
	
	Телефон10Знаков = "";
	Числа = "0123456789";
	
	ДлинаПредставленияТелефона = СтрДлина(Телефон);
	Для Индекс = 1 По ДлинаПредставленияТелефона Цикл
		
		Символ = Сред(Телефон, Индекс, 1);
		Если СтрНайти(Числа, Символ) > 0 Тогда
			Телефон10Знаков = Телефон10Знаков + Символ;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Прав(Телефон10Знаков, 10);
	
КонецФункции

Функция ПолучитьАдресРасчетов(ДокументСсылка)
	
	АдресРасчетов = "";
	
	ОбъектМетаданныхПоТипу = Метаданные.НайтиПоТипу(ТипЗнч(ДокументСсылка));
	
	Если НЕ ОбъектМетаданныхПоТипу = Неопределено Тогда
		
		Если ОбщегоНазначения.ЕстьРеквизитОбъекта("Касса", ДокументСсылка.Метаданные()) Тогда		
			АдресРасчетов = ДокументСсылка.Касса.АдресПринятияОплаты; 
		КонецЕсли;
		Если ПустаяСтрока(АдресРасчетов) И ОбщегоНазначения.ЕстьРеквизитОбъекта("ТочкаПродаж", ДокументСсылка.Метаданные()) Тогда
			АдресРасчетов = ДокументСсылка.ТочкаПродаж.ФактическийАдрес;
		КонецЕсли;
		Если ПустаяСтрока(АдресРасчетов) И ОбщегоНазначения.ЕстьРеквизитОбъекта("Подразделение", ДокументСсылка.Метаданные()) Тогда
			АдресРасчетов = ДокументСсылка.Подразделение.ФактическийАдрес;
		КонецЕсли;
		Если ПустаяСтрока(АдресРасчетов) И ОбщегоНазначения.ЕстьРеквизитОбъекта("Организация", ДокументСсылка.Метаданные()) Тогда
			АдресРасчетов = ОбщийМодульСервер.ПолучитьАдресИзКонтактнойИнформации(ДокументСсылка.Организация, "Фактический");		
			Если ПустаяСтрока(АдресРасчетов) Тогда
				АдресРасчетов = ОбщийМодульСервер.ПолучитьАдресИзКонтактнойИнформации(ДокументСсылка.Организация, "Юридический");
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат АдресРасчетов;
	
КонецФункции

Функция РеквизитыАдресаМестаРасчетов(Знач ФискальноеУстройство) Экспорт
	
	РеквизитыАдресаМестаРасчетов = Новый Структура;
	РеквизитыАдресаМестаРасчетов.Вставить("АдресРасчетов", "");
	РеквизитыАдресаМестаРасчетов.Вставить("МестоРасчетов", "");
	
	Возврат РеквизитыАдресаМестаРасчетов;
	
КонецФункции

Функция СтавкаНДСФискальнойОперации(СтавкаНДС) Экспорт
	
	Если СтавкаНДС = ПредопределенноеЗначение("Перечисление.СтавкиНДС.БезНДС")
		Или СтавкаНДС = ПредопределенноеЗначение("Перечисление.СтавкиНДС.ПустаяСсылка") Тогда
		Возврат Неопределено;
	//ИначеЕсли СтавкаНДС = ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС20_120") Тогда
	//	Возврат 120;
	//ИначеЕсли СтавкаНДС = ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС18_118") Тогда
	//	Возврат 118;
	//ИначеЕсли СтавкаНДС = ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС10_110") Тогда
	//	Возврат 110;
	Иначе
		Возврат УчетНДС.ПолучитьСтавкуНДС(СтавкаНДС);
	КонецЕсли;
	
КонецФункции

