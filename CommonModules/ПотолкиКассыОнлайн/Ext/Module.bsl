Функция РассчитатьСуммы(ТаблицаДокумента, ТипДокумента, МассивЗаказов, СуммаРаспределенияПоЗаказам, СуммаПоЗаказам)
	
	МассивЗаказовДокумента = ТаблицаДокумента.НайтиСтроки(Новый Структура("ТипДокумента", ТипДокумента));			
	Для каждого ЭлементМассива из МассивЗаказовДокумента Цикл
		СуммаРаспределенияПоЗаказам = СуммаРаспределенияПоЗаказам + Мин(ЭлементМассива.Сумма, ЭлементМассива.СуммаДокумента);
		СуммаПоЗаказам = СуммаПоЗаказам + ЭлементМассива.СуммаДокумента;
		МассивЗаказов.Добавить(Новый Структура("Документ, СуммаДокумента, СуммаРаспределения", ЭлементМассива.Документ, ЭлементМассива.СуммаДокумента, Мин(ЭлементМассива.Сумма, ЭлементМассива.СуммаДокумента)));
	КонецЦикла;
	
	Возврат СуммаРаспределенияПоЗаказам;
	
КонецФункции

Процедура ДобавитьПозицииЧекаПоДокументамРасчетов(МассивДокументовРасчетов, ОбщиеПараметры, НомерСтрокиТовара = 0, ПризнакСпособаРасчета, ПризнакПредметаРасчета=Неопределено, ПересчитыватьСуммуСтроки = Ложь) Экспорт
	
	//ТипДокументаРасчета = ТипЗнч(МассивДокументовРасчетов[0]);
	ТипДокументаРасчета = ТипЗнч(МассивДокументовРасчетов[0].Документ);
	
	// Определим табличные части
	ИмяТабличнойЧасти = Новый Массив;
	Если ТипДокументаРасчета = Тип("ДокументСсылка.ЗаказНаПроизводство") Тогда
		ИмяТабличнойЧасти.Добавить("Товары");
		ИмяТабличнойЧасти.Добавить("Услуги");
		ИмяТабличнойЧасти.Добавить("Продукция");
	ИначеЕсли ТипДокументаРасчета = Тип("ДокументСсылка.ЗаказДоговор") Тогда
		ИмяТабличнойЧасти.Добавить("ТоварыУслуги");
	ИначеЕсли ТипДокументаРасчета = Тип("ДокументСсылка.РеализацияТоваровИУслуг")
		ИЛИ ТипДокументаРасчета = Тип("ДокументСсылка.СчетНаОплату") Тогда
		ИмяТабличнойЧасти.Добавить("Товары");
		ИмяТабличнойЧасти.Добавить("Услуги");
	ИначеЕсли ТипДокументаРасчета = Тип("ДокументСсылка.Монтаж") Тогда
		ИмяТабличнойЧасти.Добавить("ТоварыУслуги");
		ИмяТабличнойЧасти.Добавить("Материалы");		
	ИначеЕсли ТипДокументаРасчета = Тип("ДокументСсылка.ЗаказПокупателя") Тогда 
		ИмяТабличнойЧасти.Добавить("Товары");
	ИначеЕсли ТипДокументаРасчета = Тип("ДокументСсылка.ВозвратТовараОтПокупателя") Тогда 
		ИмяТабличнойЧасти.Добавить("Товары");
	ИначеЕсли ТипДокументаРасчета = Тип("ДокументСсылка.ЧекККМ") Тогда 
		ИмяТабличнойЧасти.Добавить("Товары");
	ИначеЕсли ТипДокументаРасчета = Тип("Структура") Тогда 
		ИмяТабличнойЧасти.Добавить("ТаблицаТоваров");	
	КонецЕсли;
	
	Если ИмяТабличнойЧасти.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ДополнитьТоварамиПоДокументам(МассивДокументовРасчетов, ИмяТабличнойЧасти, ОбщиеПараметры, НомерСтрокиТовара, ПризнакСпособаРасчета, ПризнакПредметаРасчета, ПересчитыватьСуммуСтроки);
	
КонецПроцедуры //Функции

Процедура ДополнитьТоварамиПоДокументам(МассивДокументовРасчетов, МассивТабличныхЧастей, ОбщиеПараметры, НомерСтрокиТовара, ПризнакСпособаРасчета, ПризнакПредметаРасчета, ПересчитыватьСуммуСтроки = Ложь)
	
	ТипДокументаРасчета = ТипЗнч(МассивДокументовРасчетов[0].Документ);	
	
	Для каждого ЭлементМассива из МассивДокументовРасчетов Цикл
		ОстатокСуммыРаспределения = ЭлементМассива.СуммаРаспределения;
		// Для Заказа на производство нужно добавить сам потолок
		Если ТипДокументаРасчета = Тип("ДокументСсылка.ЗаказНаПроизводство") Тогда
			Если НЕ ЭлементМассива.Документ.ПродукцияНоменклатура = Справочники.Номенклатура.ПустаяСсылка() Тогда
				НоваяСтрока = Новый Структура;
				//Заполним только теми реквизитами, которые нужны для ККТ
				НоваяСтрока.Вставить("Номенклатура", ЭлементМассива.Документ.ПродукцияНоменклатура);
				НоваяСтрока.Вставить("Количество", ЭлементМассива.Документ.ПродукцияНоменклатураКоличество);
				НоваяСтрока.Вставить("Цена", ЭлементМассива.Документ.ПродукцияЦена);
				НоваяСтрока.Вставить("Сумма", ЭлементМассива.Документ.ПродукцияСумма);
				ДобавитьПозициюЧека(НоваяСтрока, ОбщиеПараметры, НомерСтрокиТовара, ПризнакСпособаРасчета, ПризнакПредметаРасчета);
				Если ПересчитыватьСуммуСтроки Тогда
					СтрокаЧека = ОбщиеПараметры.ПозицииЧека[НомерСтрокиТовара-1];
					ПересчитатьСуммыФискальнойСтроки(СтрокаЧека, ЭлементМассива.СуммаДокумента, ЭлементМассива.СуммаРаспределения);
					ОстатокСуммыРаспределения = ОстатокСуммыРаспределения - СтрокаЧека.Сумма;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		Для каждого ТабличнаяЧасть Из МассивТабличныхЧастей Цикл
			Для каждого СтрокаТЧ Из ЭлементМассива.Документ[ТабличнаяЧасть] Цикл		
				ИспользуетсяХарактеристика = Ложь;
				ОбъектМетаданныхПоТипу = Метаданные.НайтиПоТипу(ТипЗнч(ЭлементМассива.Документ));
				Если НЕ ОбъектМетаданныхПоТипу = Неопределено Тогда
					ИспользуетсяХарактеристика = ОбщийМодуль.ЕстьРеквизитТабЧастиОбъекта("ХарактеристикаНоменклатуры", ЭлементМассива.Документ.Метаданные(), ТабличнаяЧасть);
				КонецЕсли;
				ДобавитьПозициюЧека(СтрокаТЧ, ОбщиеПараметры, НомерСтрокиТовара, ПризнакСпособаРасчета, ПризнакПредметаРасчета, ИспользуетсяХарактеристика);
				
				Если ПересчитыватьСуммуСтроки Тогда
					ЭтоПоследняяСтрока = (СтрокаТЧ.НомерСтроки = ЭлементМассива.Документ[ТабличнаяЧасть].Количество());	
					СтрокаЧека = ОбщиеПараметры.ПозицииЧека[НомерСтрокиТовара-1];
					ПересчитатьСуммыФискальнойСтроки(СтрокаЧека, ЭлементМассива.СуммаДокумента, ЭлементМассива.СуммаРаспределения, ЭтоПоследняяСтрока, ОстатокСуммыРаспределения);
					ОстатокСуммыРаспределения = ОстатокСуммыРаспределения - СтрокаЧека.Сумма;
				КонецЕсли;

			КонецЦикла;
		КонецЦикла;	
	КонецЦикла;
	
КонецПроцедуры

Процедура ДобавитьПозициюЧека(ДанныеСтроки, ОбщиеПараметры, НомерСтрокиТовара, ПризнакСпособаРасчета, ПризнакПредметаРасчета, ИспользуетсяХарактеристика = Ложь)
	
	СтрокаПозицииЧека = МенеджерОборудованияКлиентСервер.ПараметрыФискальнойСтрокиЧека();
	СтрокаПозицииЧека.ПризнакСпособаРасчета  = ПризнакСпособаРасчета;						
	СтрокаПозицииЧека.ПризнакПредметаРасчета = ?(НЕ ПризнакПредметаРасчета = Неопределено, ПризнакПредметаРасчета, ПолучитьПризнакПредметаРасчета(ДанныеСтроки.Номенклатура));
	
	//++ №12909
	Если ТипЗнч(ДанныеСтроки.Номенклатура) = Тип("СправочникСсылка.Номенклатура") Тогда
		ПредставлениеНоменклатуры = ОбщийМодульСервер.ПредставлениеНоменклатурыДляПечати(ДанныеСтроки.Номенклатура, ?(ИспользуетсяХарактеристика, ДанныеСтроки.ХарактеристикаНоменклатуры, ""));
	//-- №12909
	Иначе
		ПредставлениеНоменклатуры = "" + ДанныеСтроки.Номенклатура + ?(ИспользуетсяХарактеристика, ОбщийМодульСервер.ПредставлениеХарактеристики(ДанныеСтроки.ХарактеристикаНоменклатуры), "");
	КонецЕсли;
	
	СтрокаПозицииЧека.Наименование = ПредставлениеНоменклатуры;
	СтрокаПозицииЧека.Количество = ДанныеСтроки.Количество;			
	//ЦенаСтроки = СтрокаТЧ.Цена + ?(ДокументОбъект.СуммаВключаетНДС, 0, СтрокаТЧ.СуммаНДС / ?(СтрокаПозицииЧека.Количество = 0, 1, СтрокаПозицииЧека.Количество));
	Если ДанныеСтроки.Количество = 0 Тогда
		ЦенаСтроки = ДанныеСтроки.Цена;
	Иначе
		ЦенаСтроки = ДанныеСтроки.Сумма / ДанныеСтроки.Количество;
	КонецЕсли;
	СтрокаПозицииЧека.Цена = Окр(ЦенаСтроки, 2);
	
	//++ №12344 расскомментировано
	
	//16467 СтрокаПозицииЧека заменено на ДанныеСтроки, иначе сумма скидки не считалась
	//СуммаСкидки = СтрокаПозицииЧека.Цена * СтрокаПозицииЧека.Количество - ДанныеСтроки.Сумма;
	//ЦенаСоСкидкамиСтроки = СтрокаПозицииЧека.Цена - СуммаСкидки / ?(СтрокаПозицииЧека.Количество = 0, 1, СтрокаПозицииЧека.Количество);
	
	СуммаСкидки = ДанныеСтроки.Цена * ДанныеСтроки.Количество - ДанныеСтроки.Сумма;
	ЦенаСоСкидкамиСтроки = ДанныеСтроки.Цена - СуммаСкидки / ?(ДанныеСтроки.Количество = 0, 1, ДанныеСтроки.Количество);
	
	СтрокаПозицииЧека.ЦенаСоСкидками = Окр(ЦенаСоСкидкамиСтроки, 2);
	СтрокаПозицииЧека.СуммаСкидок = СуммаСкидки;
	//-- №12344 расскомментировано
	
	//СтрокаПозицииЧека.ПризнакПредметаРасчета = ?(
	//		ТипЗНЧ(ДокументОбъект) = Тип("ДокументСсылка.РеализацияТоваровИУслуг") 
	//		ИЛИ ТипЗНЧ(ДокументОбъект) = Тип("ДокументСсылка.Монтаж"),             //условие
	//		?(Справочники.ВидыНоменклатуры.ЭтоНоменклатураУслуга(ДанныеСтроки.Номенклатура), Перечисления.ПризнакиПредметаРасчета.Услуга, Перечисления.ПризнакиПредметаРасчета.Товар),
	//		Перечисления.ПризнакиПредметаРасчета.ПлатежВыплата);
	
	СтрокаПозицииЧека.Сумма        = ДанныеСтроки.Сумма;
	СтрокаПозицииЧека.НомерСекции  = 1;
	СтрокаПозицииЧека.СтавкаНДС    = СтавкаНДСФискальнойОперации(ПредопределенноеЗначение("Перечисление.СтавкиНДС.БезНДС"));
	Попытка
		СтрокаПозицииЧека.СтавкаНДС    = СтавкаНДСФискальнойОперации(ДанныеСтроки.СтавкаНДС);
	Исключение
	КонецПопытки;
	СтрокаПозицииЧека.НомерСтрокиТовара = НомерСтрокиТовара;
	НомерСтрокиТовара = НомерСтрокиТовара + 1;
	ОбщиеПараметры.ПозицииЧека.Добавить(СтрокаПозицииЧека);
	
КонецПроцедуры

Процедура ПересчитатьСуммыФискальнойСтроки(СтрокаЧека, СуммаДокумента, СуммаРаспределения, ЭтоПоследняяСтрока = Ложь, ОстатокСуммыРаспределения = 0)
	
	Если СуммаДокумента > СуммаРаспределения Тогда
		Коэффициент = СуммаРаспределения / СуммаДокумента;
		СтрокаЧека.Сумма = Окр(СтрокаЧека.Сумма * Коэффициент, 2);
		Если ЭтоПоследняяСтрока Тогда
			СтрокаЧека.Сумма = ОстатокСуммыРаспределения;
		КонецЕсли;
		Если СтрокаЧека.Количество = 0 Тогда
			ЦенаСтроки = СтрокаЧека.Цена;
		Иначе
			ЦенаСтроки = СтрокаЧека.Сумма / СтрокаЧека.Количество;
		КонецЕсли;
		СтрокаЧека.Цена = Окр(ЦенаСтроки, 2);	
	КонецЕсли;
	
КонецПроцедуры

Процедура ДобавитьСтрокуАванса(ОбщиеПараметры, НомерСтрокиТовара, Контрагент, СуммаАванса, Знач ПризнакСпособаРасчета=Неопределено) Экспорт
	
	СтрокаПозицииЧека = МенеджерОборудованияКлиентСервер.ПараметрыФискальнойСтрокиЧека();
	СтрокаПозицииЧека.Наименование = НСтр("ru = 'Аванс от: '") + Контрагент; 
	
	СтрокаПозицииЧека.Количество   = 1;
	СтрокаПозицииЧека.ЕдиницаИзмерения = "Платеж"; //++ 2021-04-13
	СтрокаПозицииЧека.Цена         = СуммаАванса;		
	СтрокаПозицииЧека.Сумма        = СуммаАванса;
	СтрокаПозицииЧека.СтавкаНДС    = СтавкаНДСФискальнойОперации(ПредопределенноеЗначение("Перечисление.СтавкиНДС.БезНДС"));
	СтрокаПозицииЧека.НомерСекции  = 1;
	СтрокаПозицииЧека.ПризнакСпособаРасчета  = ?(ПризнакСпособаРасчета = Неопределено, Перечисления.ПризнакиСпособаРасчета.Аванс, ПризнакСпособаРасчета);
	СтрокаПозицииЧека.ПризнакПредметаРасчета = Перечисления.ПризнакиПредметаРасчета.ПлатежВыплата;
	СтрокаПозицииЧека.НомерСтрокиТовара = НомерСтрокиТовара;
	НомерСтрокиТовара = НомерСтрокиТовара + 1;
	ОбщиеПараметры.ПозицииЧека.Добавить(СтрокаПозицииЧека);
	
КонецПроцедуры

Функция РассчитатьЗачетАванса(МассивЗаказов, СуммаПоЗаказам, Период)
	
	УстановитьПривилегированныйРежим(Истина);
	Оплачено = 0;
	МассивДокументов = Новый Массив;
	Для каждого ЭлементМассива из МассивЗаказов Цикл
		 МассивДокументов.Добавить(ЭлементМассива.Документ);
	КонецЦикла;	
		
	Запрос = Новый Запрос;
	// #13445 изменен запрос
	//Запрос.Текст = 
	//"ВЫБРАТЬ 
	//|	РасчетыПоЗаказамОбороты.СуммаРасход КАК СуммаАванса
	//|ИЗ
	//|	РегистрНакопления.РасчетыПоЗаказам.Обороты(, &Период, , Заказ В (&Заказ)) КАК РасчетыПоЗаказамОбороты";
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	-1 * ЕСТЬNULL(СУММА(РасчетыПоЗаказамОбороты.СуммаОборот), 0) КАК СуммаАванса
	|ИЗ
	|	РегистрНакопления.РасчетыПоЗаказам.Обороты(, &Период, Регистратор, Заказ В (&Заказ)) КАК РасчетыПоЗаказамОбороты
	|ГДЕ
	|	НЕ РасчетыПоЗаказамОбороты.Регистратор В (&Заказ)";
	
	Запрос.УстановитьПараметр("Заказ", МассивДокументов);
	Запрос.УстановитьПараметр("Период", Новый Граница(Период, ВидГраницы.Исключая));
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Если Выборка.Следующий() Тогда
		Оплачено = Выборка.СуммаАванса; 
	КонецЕсли;
	
	Оплачено = Мин(СуммаПоЗаказам, Оплачено);
	
	Возврат Оплачено;
	
КонецФункции

