//ИА_Арчил Тваладзе 2016.05.30
Функция ПолучитьПредставениеПериодаДетализации(КоличествоПериодов, ЗначениеПериода, ВНижнемРегистре = Истина) Экспорт
	
	ПредставлениеПериодаСтрока =  Строка(ЗначениеПериода);
	
	Если ЗначениеПериода = Перечисления.ИА_ПериодыДетализации.День тогда
		
		Если КоличествоПериодов%100 = 11 или КоличествоПериодов%100 = 12 или КоличествоПериодов%100 = 13 или КоличествоПериодов%100 = 14 Тогда
			ПредставлениеПериодаСтрока =  "Дней";
		ИначеЕсли КоличествоПериодов%10 = 1 Тогда
			ПредставлениеПериодаСтрока =  "День";
		ИначеЕсли КоличествоПериодов%10 = 2 или КоличествоПериодов%10 = 3 или КоличествоПериодов%10 = 4 Тогда
			ПредставлениеПериодаСтрока =  "Дня";
		ИначеЕсли КоличествоПериодов%10 = 0 или КоличествоПериодов%10 = 5 или КоличествоПериодов%10 = 6 или КоличествоПериодов%10 = 7 или КоличествоПериодов%10 = 8 или КоличествоПериодов%10 = 9 или КоличествоПериодов%10 = 9 Тогда
			ПредставлениеПериодаСтрока =  "Дней";
		КонецЕсли;
		
	ИначеЕсли ЗначениеПериода = Перечисления.ИА_ПериодыДетализации.Неделя  тогда
		
		Если КоличествоПериодов%100 = 11 или КоличествоПериодов%100 = 12 или КоличествоПериодов%100 = 13 или КоличествоПериодов%100 = 14 Тогда
			ПредставлениеПериодаСтрока =  "Недель";
