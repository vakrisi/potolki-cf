Функция ПолучитьСдвинутыеДатыНачалаКонца(Объект, СтрокаСтатистик, СдвинутыеДатыНачалаКонца = Неопределено) Экспорт
	
	ДатаНачала = НачалоДня(Объект.ДатаНачала);
	ДатаКонца  = КонецДня(Объект.ДатаКонца);
	
	Если СдвинутыеДатыНачалаКонца = Неопределено Тогда
		СдвинутыеДатыНачалаКонца = Новый Структура("ДатаНачала, ДатаКонца", ДатаНачала, ДатаКонца);	
	КонецЕсли;
	
	
	СдвигПериода      = СтрокаСтатистик.СдвигПериода; 
	ВидСдвигаПериода  = СтрокаСтатистик.ВидСдвигаПериода;
	ПериодДетализации = СтрокаСтатистик.ПериодДетализации;
	
	Если НЕ ТиповыеПериоды_БольшеИлиРавно(ВидСдвигаПериода, ПериодДетализации) Тогда
		//здесь надо обработать ошибку если детализация графика больше вида сдвига
		Возврат Ложь;
	КонецЕсли;
	
	ВидПериода = ПолучитьТиповойПериод(ДатаНачала, ДатаКонца);
	
	//ошибка
	Если ВидПериода = Неопределено Тогда 
		//здесь надо обаработать ошибку если дата начала больше даты конца, по идее сюда не должно попадать. 
		Возврат Ложь;
	КонецЕсли;
	
	////если период не типовой
	//Если ВидПериода = Перечисления.ИА_ПериодыДетализации.ПустаяСсылка() Тогда
		ПолучитьСдвинутыеДатыНачалаКонцаНеТиповойПериод(ДатаНачала, ДатаКонца, СдвинутыеДатыНачалаКонца, ПериодДетализации, СдвигПериода, ВидСдвигаПериода);
	//	
	////если период типовой
	//иначе
	//	ПолучитьСдвинутыеДатыНачалаКонцаТиповойПериод(ДатаНачала, ДатаКонца, ВидПериода, СдвинутыеДатыНачалаКонца, СдвигПериода, ВидСдвигаПериода);
	//КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

Процедура ПолучитьСдвинутыеДатыНачалаКонцаНеТиповойПериод(ДатаНачала, ДатаКонца, СдвинутыеДатыНачалаКонца, ПериодДетализации, СдвигПериода, ВидСдвигаПериода)
	
	Если ВидСдвигаПериода = ПредопределенноеЗначение("Перечисление.ИА_ПериодыДетализации.День") Тогда
		
		СдвинутыеДатыНачалаКонца.ДатаНачала = ДобавитьДень(ДатаНачала, -СдвигПериода);
		СдвинутыеДатыНачалаКонца.ДатаКонца  = ДобавитьДень(ДатаКонца,  -СдвигПериода);
		
	ИначеЕсли ВидСдвигаПериода = ПредопределенноеЗначение("Перечисление.ИА_ПериодыДетализации.Неделя") Тогда
		
		Если ПериодДетализации = ПредопределенноеЗначение("Перечисление.ИА_ПериодыДетализации.Неделя") Тогда
			
			СдвинутаяДатаНачала =  ДобавитьДень(ДатаНачала, -СдвигПериода * 7);
			
			СдвинутыеДатыНачалаКонца.ДатаНачала = ИА_НачалоНеделиСУчетомРаспределения(СдвинутаяДатаНачала);
			СдвинутыеДатыНачалаКонца.ДатаКонца  = ИА_КонецНеделиСУчетомРаспределения(ДобавитьДень(ДатаКонца,  -СдвигПериода * 7));
			
			Если ДатаНачала = ИА_НачалоНеделиСУчетомРаспределения(ДатаНачала) Тогда
				Если Месяц(СдвинутыеДатыНачалаКонца.ДатаНачала) < Месяц(СдвинутаяДатаНачала) Тогда
					СдвинутыеДатыНачалаКонца.ДатаНачала = НачалоМесяца(СдвинутаяДатаНачала);
				КонецЕсли;
			КонецЕсли;

			
		иначе
			
			СдвинутыеДатыНачалаКонца.ДатаНачала = ДобавитьДень(ДатаНачала, -СдвигПериода * 7);
			СдвинутыеДатыНачалаКонца.ДатаКонца  = ДобавитьДень(ДатаКонца,  -СдвигПериода * 7);
			
		КонецЕсли;
		
	ИначеЕсли ВидСдвигаПериода =ПредопределенноеЗначение("Перечисление.ИА_ПериодыДетализации.Месяц") Тогда
		
		Если ПериодДетализации = ПредопределенноеЗначение("Перечисление.ИА_ПериодыДетализации.Неделя") Тогда
			
			Если ДатаНачала = ИА_НачалоНеделиСУчетомРаспределения(ДатаНачала) Тогда
				
				СдвинутаяДатаНачала =  ДобавитьМесяц(ДатаНачала, -СдвигПериода);
				СдвинутыеДатыНачалаКонца.ДатаНачала = ИА_НачалоНеделиСУчетомРаспределения(СдвинутаяДатаНачала);
				Если Месяц(СдвинутыеДатыНачалаКонца.ДатаНачала) < Месяц(СдвинутаяДатаНачала) Тогда
					СдвинутыеДатыНачалаКонца.ДатаНачала = НачалоМесяца(СдвинутаяДатаНачала);
				КонецЕсли;
			иначе	
				СдвинутыеДатыНачалаКонца.ДатаНачала = ДобавитьМесяц(ДатаНачала, -СдвигПериода);
			КонецЕсли;
			
			СдвинутыеДатыНачалаКонца.ДатаКонца  = ИА_КонецНеделиСУчетомРаспределения(ДобавитьМесяц(ДатаКонца,  -СдвигПериода));
			
		Иначе
			
			СдвинутыеДатыНачалаКонца.ДатаНачала = ДобавитьМесяц(ДатаНачала, -СдвигПериода);
			СдвинутыеДатыНачалаКонца.ДатаКонца  = ДобавитьМесяц(ДатаКонца,  -СдвигПериода);
			
		КонецЕсли;
		
	ИначеЕсли ВидСдвигаПериода =ПредопределенноеЗначение("Перечисление.ИА_ПериодыДетализации.Квартал") Тогда
		
		СдвинутыеДатыНачалаКонца.ДатаНачала = ДобавитьМесяц(ДатаНачала, -СдвигПериода * 3);
		СдвинутыеДатыНачалаКонца.ДатаКонца  = ДобавитьМесяц(ДатаКонца,  -СдвигПериода * 3);
		
	ИначеЕсли ВидСдвигаПериода =ПредопределенноеЗначение("Перечисление.ИА_ПериодыДетализации.Год") Тогда
		
		СдвинутыеДатыНачалаКонца.ДатаНачала = ДобавитьМесяц(ДатаНачала, -СдвигПериода * 12);
		СдвинутыеДатыНачалаКонца.ДатаКонца  = ДобавитьМесяц(ДатаКонца,  -СдвигПериода * 12);
		
	Иначе
		//ошибка
	КонецЕсли;
	
КонецПроцедуры

