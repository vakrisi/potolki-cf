	КонецЕсли;
	
	Если ВНижнемРегистре Тогда
		ПредставлениеПериодаСтрока = НРег(ПредставлениеПериодаСтрока);
	КонецЕсли;
	
	Возврат ПредставлениеПериодаСтрока;
	
