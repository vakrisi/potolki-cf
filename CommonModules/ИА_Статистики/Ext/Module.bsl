//ИА_Арчил Тваладзе 2016.10.05
Функция  ПолучитьПараметрПериодДляСводнойТаблицыРасшифровки(ПараметрыПериод, Знач ЕстьСдвигиПериода, Знач КоличествоТаблиц, Знач ПериодДетализации, Знач стрПериод)  Экспорт
	
	Перем ЗначениеПериода, ИмяКолонкиДатаНачала, НомерТаблицы;
	
	Если ЕстьСдвигиПериода Тогда
		//если сдвиги есть, собираем представление периода, даже если они повторяются, пользователь должен знат в каком столбце какой период. 
		Для НомерТаблицы =1 по КоличествоТаблиц Цикл
			
			ИмяКолонкиДатаНачала = "ДатаНачала_" + НомерТаблицы;
			
			ЗначениеПериода = стрПериод[ИмяКолонкиДатаНачала];
			Если ЗначениеПериода = null Тогда
				ЗначениеПериода = " ~ ";
			Иначе
				ЗначениеПериода = ПолучитьПредставлениеТочкиПериода(ПериодДетализации, стрПериод[ИмяКолонкиДатаНачала]);
			КонецЕсли;
			
			ПараметрыПериод = ПараметрыПериод + ЗначениеПериода + " / ";
			
		КонецЦикла;
		
		ПараметрыПериод = Лев(ПараметрыПериод,СтрДлина(ПараметрыПериод)-3);
	Иначе 
		//если сдвигов нет то периоды все одинковые, и незачем их повторять, берем первый. 
		НомерТаблицы =1;
		ИмяКолонкиДатаНачала = "ДатаНачала_" + НомерТаблицы;
		ЗначениеПериода = стрПериод[ИмяКолонкиДатаНачала];
		ЗначениеПериода = ПолучитьПредставлениеТочкиПериода(ПериодДетализации, стрПериод[ИмяКолонкиДатаНачала]);
		ПараметрыПериод = СокрЛП(ЗначениеПериода);
		
	КонецЕсли;
	
	Возврат ПараметрыПериод;

КонецФункции

Функция ПолучитьПредставлениеТочкиПериода(ПериодДет, ДатаНач) Экспорт 
	
	Если ПериодДет = Перечисления.ИА_ПериодыДетализации.День тогда
		Возврат Формат(ДатаНач,"ДФ=dd.MM.yy");
	ИначеЕсли ПериодДет = Перечисления.ИА_ПериодыДетализации.Неделя тогда
		Возврат Формат(ДатаНач,"ДФ=dd.MM.yy")+"-" + Формат(ДатаНач + 60*60*24*6,"ДФ=dd.MM.yy");
	ИначеЕсли ПериодДет = Перечисления.ИА_ПериодыДетализации.Месяц тогда
		Возврат Формат(ДатаНач,"ДФ=MM.yyyy");
	ИначеЕсли ПериодДет = Перечисления.ИА_ПериодыДетализации.Квартал тогда
		Возврат Формат(ДатаНач,"ДФ=MM.yyyy");
	ИначеЕсли ПериодДет = Перечисления.ИА_ПериодыДетализации.Год тогда
		Возврат Формат(ДатаНач,"ДФ=yyyy");
	КонецЕсли;
	
КонецФункции
