			СдвинутыеДатыНачалаКонца.ДатаНачала = ДобавитьМесяц(ДатаНачала, -СдвигПериода * 3);
			СдвинутыеДатыНачалаКонца.ДатаКонца  = ДобавитьМесяц(ДатаКонца,  -СдвигПериода * 3);
			
		ИначеЕсли ВидСдвигаПериода =ПредопределенноеЗначение("Перечисление.ИА_ПериодыДетализации.Год") Тогда
			
			СдвинутыеДатыНачалаКонца.ДатаНачала = ДобавитьМесяц(ДатаНачала, -СдвигПериода * 12);
			СдвинутыеДатыНачалаКонца.ДатаКонца  = ДобавитьМесяц(ДатаКонца,  -СдвигПериода * 12);
			
		Иначе
			//ошибка
		КонецЕсли;
	Иначе
		//ошибка
	КонецЕсли;
	
КонецПроцедуры

Функция ДобавитьДень(ИсходнаяДата, ЧислоДней) Экспорт
	
	Возврат ИсходнаяДата + 60*60*24*ЧислоДней;
	
КонецФункции

//возвращает если ТиповойПериод1 >= ТиповойПериод, и ложь если это не так 
//ТиповойПериод1, ТиповойПериод2 - тип Перечисление.ИА_ПериодыДетализации
Функция ТиповыеПериоды_БольшеИлиРавно(ТиповойПериод1, ТиповойПериод2) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ИА_ПериодыДетализации.Ссылка,
	|	ИА_ПериодыДетализации.Порядок
	|ИЗ
	|	Перечисление.ИА_ПериодыДетализации КАК ИА_ПериодыДетализации
	|ГДЕ
	|	ИА_ПериодыДетализации.Ссылка = &ТиповойПериод1
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ИА_ПериодыДетализации.Ссылка,
	|	ИА_ПериодыДетализации.Порядок
	|ИЗ
	|	Перечисление.ИА_ПериодыДетализации КАК ИА_ПериодыДетализации
	|ГДЕ
	|	ИА_ПериодыДетализации.Ссылка = &ТиповойПериод2";
	
	Запрос.УстановитьПараметр("ТиповойПериод1", ТиповойПериод1);
	Запрос.УстановитьПараметр("ТиповойПериод2", ТиповойПериод2);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	ВыборкаДетальныеЗаписи.Следующий();
	Порядок1 =  ВыборкаДетальныеЗаписи.Порядок;
	
	ВыборкаДетальныеЗаписи.Следующий();
	Порядок2 =  ВыборкаДетальныеЗаписи.Порядок;
	
	Порядок1 =?(ЗначениеЗаполнено(Порядок1), Порядок1, 0);  
	Порядок2 =?(ЗначениеЗаполнено(Порядок2), Порядок2, 0);  
	
	Возврат  Порядок1 >= Порядок2;
	
КонецФункции

Функция ЭтоТиповойПериод(ДатаНачала, ДатаОкончания) Экспорт
	
	ТиповойПериод = ПолучитьТиповойПериод(ДатаНачала, ДатаОкончания);
	
	Если Не ЗначениеЗаполнено(ТиповойПериод) Тогда
		Возврат Ложь;
	Иначе
		Возврат Истина;
	КонецЕсли;
	
КонецФункции

Функция ПолучитьТиповойПериод(ДатаНачала, ДатаОкончания) Экспорт
	
	РазницаДатВДнях =(КонецДня(ДатаОкончания) - НачалоДня(ДатаНачала))/(24*60*60);
	РазницаДатВДнях = Окр(РазницаДатВДнях, 0);
	
	Если РазницаДатВДнях < 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если РазницаДатВДнях <= 1 и (ДатаНачала = НачалоДня(ДатаНачала) и ДатаОкончания = КонецДня(ДатаОкончания))  Тогда
		Возврат Перечисления.ИА_ПериодыДетализации.День;
	ИначеЕсли РазницаДатВДнях = 7 и (ДатаНачала = ИА_НачалоНедели(ДатаНачала) и ДатаОкончания = ИА_КонецНедели(ДатаОкончания)) Тогда
		Возврат Перечисления.ИА_ПериодыДетализации.Неделя;
	ИначеЕсли (РазницаДатВДнях >= 28 И РазницаДатВДнях <= 31) и (ДатаНачала = НачалоМесяца(ДатаНачала) и ДатаОкончания = КонецМесяца(ДатаОкончания)) Тогда
		Возврат Перечисления.ИА_ПериодыДетализации.Месяц;
	ИначеЕсли (РазницаДатВДнях >= 90 И РазницаДатВДнях <= 92) и (ДатаНачала = НачалоКвартала(ДатаНачала) и ДатаОкончания = КонецКвартала(ДатаОкончания)) Тогда
		Возврат Перечисления.ИА_ПериодыДетализации.Квартал;
	ИначеЕсли (РазницаДатВДнях >= 365 И РазницаДатВДнях <= 366) и (ДатаНачала = НачалоГода(ДатаНачала) и ДатаОкончания = КонецГода(ДатаОкончания)) Тогда
		Возврат Перечисления.ИА_ПериодыДетализации.Год;
	Иначе
		Возврат Перечисления.ИА_ПериодыДетализации.ПустаяСсылка(); //произвольный
	КонецЕсли;
	
КонецФункции

Функция ЗаполнитьКлючиСравненияВТаблице(ТаблицаДанные, ПериодДетализации) Экспорт 
	
	ТаблицаДанные.Колонки.Добавить("Ключ1", Новый ОписаниеТипов("Число"));
	ТаблицаДанные.Колонки.Добавить("Ключ2", Новый ОписаниеТипов("Число"));
	ТаблицаДанные.Колонки.Добавить("Ключ",  Новый ОписаниеТипов("Строка"));
	
	Если ПериодДетализации =ПредопределенноеЗначение("Перечисление.ИА_ПериодыДетализации.День") Тогда
		
		Для каждого СтрокаДанные Из ТаблицаДанные  Цикл
			СтрокаДанные.Ключ  = Строка(ФЧ(Год(СтрокаДанные.ДатаНачала))) + Строка(Формат(Месяц(СтрокаДанные.ДатаНачала), "ЧЦ=2; ЧВН=")); 
			СтрокаДанные.Ключ2 = День(СтрокаДанные.ДатаНачала); 
		КонецЦикла;
		
	ИначеЕсли ПериодДетализации =ПредопределенноеЗначение("Перечисление.ИА_ПериодыДетализации.Неделя") Тогда
		
		Для каждого СтрокаДанные Из ТаблицаДанные  Цикл
			ДатаКлюча = СтрокаДанные.ДатаНачала;
			Если ДеньГода(КонецГода(ДатаКлюча)) = 366 И ДеньГода(ДатаКлюча) >=60 Тогда // высокосный год и начало недели больше или равно 29 февраля
				ДатаКлюча = ДатаКлюча + 60*60*24;
			КонецЕсли;
			
			СтрокаДанные.Ключ  = Строка(ФЧ(Год(ДатаКлюча))) + Строка(Формат(Месяц(ДатаКлюча), "ЧЦ=2; ЧВН=")); 
			СтрокаДанные.Ключ2 = День(ДатаКлюча);
			
			//СтрокаДанные.Ключ  = Строка(ФЧ(Год(СтрокаДанные.ДатаНачала))) + Строка(Формат(Месяц(СтрокаДанные.ДатаНачала), "ЧЦ=2; ЧВН=")); 
			////СтрокаДанные.Ключ2 = ПолучитьНомерНеделиВМесяце(СтрокаДанные.ДатаНачала); 
			//СтрокаДанные.Ключ2 = День(СтрокаДанные.ДатаНачала); 
		КонецЦикла;
		
	ИначеЕсли ПериодДетализации =ПредопределенноеЗначение("Перечисление.ИА_ПериодыДетализации.Месяц") Тогда
		
		Для каждого СтрокаДанные Из ТаблицаДанные  Цикл
			СтрокаДанные.Ключ  = Строка(ФЧ(Год(СтрокаДанные.ДатаНачала))) + Строка(Формат(Месяц(СтрокаДанные.ДатаНачала), "ЧЦ=2; ЧВН=")); 
			СтрокаДанные.Ключ2 = СтрокаДанные.Ключ; 
		КонецЦикла;
		
	ИначеЕсли ПериодДетализации =ПредопределенноеЗначение("Перечисление.ИА_ПериодыДетализации.Квартал") Тогда
		
		Для каждого СтрокаДанные Из ТаблицаДанные  Цикл
			СтрокаДанные.Ключ  = Строка(ФЧ(Год(СтрокаДанные.ДатаНачала))) + Строка(Формат(Квартал(СтрокаДанные.ДатаНачала), "ЧЦ=2; ЧВН=")); 
			СтрокаДанные.Ключ2 = СтрокаДанные.Ключ; 
		КонецЦикла;
		
	ИначеЕсли ПериодДетализации =ПредопределенноеЗначение("Перечисление.ИА_ПериодыДетализации.год") Тогда
		
		Для каждого СтрокаДанные Из ТаблицаДанные  Цикл
			СтрокаДанные.Ключ  = Строка(ФЧ(Год(СтрокаДанные.ДатаНачала))); 
			СтрокаДанные.Ключ2 = СтрокаДанные.Ключ; 
		КонецЦикла;
		
	КонецЕсли;                        
	
	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТаблицаДанные.ДатаНачала,
	|	ТаблицаДанные.ДатаКонца,
	|	ТаблицаДанные.Значение,
	|	ТаблицаДанные.ЕстьЗначение,
	|	ТаблицаДанные.РеальныеДанные,
	|	ТаблицаДанные.Квота,
	|	ТаблицаДанные.Ключ,
	|	ТаблицаДанные.Ключ2,
	|	ТаблицаДанные.ДанныеВведены
	|ПОМЕСТИТЬ ТаблицаДанные
	|ИЗ
	|	&ТаблицаДанные КАК ТаблицаДанные
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаДанные.ДатаНачала,
	|	ТаблицаДанные.ДатаКонца,
	|	ТаблицаДанные.Значение,
	|	ТаблицаДанные.ЕстьЗначение,
	|	ТаблицаДанные.РеальныеДанные,
	|	ТаблицаДанные.Квота,
	|	ТаблицаДанные.Ключ2 КАК Ключ2,
	|	ВЫРАЗИТЬ(ТаблицаДанные.Ключ КАК СТРОКА(6)) КАК Ключ
	|ПОМЕСТИТЬ ТаблицаДанные1
	|ИЗ
	|	ТаблицаДанные КАК ТаблицаДанные
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаДанные1.Ключ
	|ПОМЕСТИТЬ ТаблицаДанные2
	|ИЗ
	|	ТаблицаДанные1 КАК ТаблицаДанные1
	|
	|СГРУППИРОВАТЬ ПО
	|	ТаблицаДанные1.Ключ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаДанные21.Ключ,
	|	КОЛИЧЕСТВО(ТаблицаДанные22.Ключ) КАК Ключ1
	|ПОМЕСТИТЬ ТаблицаДанные3
	|ИЗ
	|	ТаблицаДанные2 КАК ТаблицаДанные21
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТаблицаДанные2 КАК ТаблицаДанные22
	|		ПО ТаблицаДанные21.Ключ >= ТаблицаДанные22.Ключ
	|
	|СГРУППИРОВАТЬ ПО
	|	ТаблицаДанные21.Ключ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаДанные1.ДатаНачала,
	|	ТаблицаДанные1.ДатаКонца,
	|	ТаблицаДанные1.Значение,
	|	ТаблицаДанные1.ЕстьЗначение,
	|	ТаблицаДанные1.РеальныеДанные,
	|	ТаблицаДанные1.Квота,
	|	ТаблицаДанные1.Ключ,
	|	ТаблицаДанные3.Ключ1,
	|	ТаблицаДанные1.Ключ2
	|ПОМЕСТИТЬ ТаблицаДанные4
	|ИЗ
	|	ТаблицаДанные1 КАК ТаблицаДанные1
	|		ЛЕВОЕ СОЕДИНЕНИЕ ТаблицаДанные3 КАК ТаблицаДанные3
	|		ПО ТаблицаДанные1.Ключ = ТаблицаДанные3.Ключ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаДанные4.ДатаНачала,
	|	ТаблицаДанные4.ДатаКонца,
	|	ТаблицаДанные4.Значение,
	|	ТаблицаДанные4.ЕстьЗначение,
	|	ТаблицаДанные4.РеальныеДанные,
	|	ТаблицаДанные4.Квота,
	|	ТаблицаДанные4.Ключ,
	|	ТаблицаДанные4.Ключ1,
	|	ТаблицаДанные4.Ключ2,
	|	isnull(ТаблицаДанные.ДанныеВведены, Ложь) как ДанныеВведены
	|ИЗ
	|	ТаблицаДанные4 КАК ТаблицаДанные4
	|		ЛЕВОЕ СОЕДИНЕНИЕ ТаблицаДанные КАК ТаблицаДанные
	|		ПО ТаблицаДанные4.ДатаНачала = ТаблицаДанные.ДатаНачала
	|			И ТаблицаДанные4.ДатаКонца = ТаблицаДанные.ДатаКонца";

	
	Запрос.УстановитьПараметр("ТаблицаДанные",ТаблицаДанные);
	РезультатЗапроса = Запрос.Выполнить();
	
	ТаблицаДанные = РезультатЗапроса.Выгрузить();
	
КонецФункции //

Функция СоеденитьТаблицы(СтрПоле) Экспорт
	
	СхемаЗапроса = Новый СхемаЗапроса;
	
	Запрос = Новый Запрос;
	
	ЗапросыПакета    = СхемаЗапроса.ПакетЗапросов;
	ЗапросыПакета.Очистить();
	
	СчетГрафиков = 1;
	Для каждого стрГрафик из стрПоле.Строки  Цикл
		
		ТаблицаДанных = стрГрафик.Данные;
		
		ИмяИсточника = "ТаблицаДанных" + СчетГрафиков;
		
		Запрос.УстановитьПараметр(ИмяИсточника, ТаблицаДанных); 
		
		ЗапросПакета = ЗапросыПакета.Добавить();
		ОператорЗапроса = ЗапросПакета.Операторы[0];
		
		ОператорЗапроса.Источники.Добавить(Тип("ОписаниеВременнойТаблицыСхемыЗапроса"), "&"+ИмяИсточника, ИмяИсточника);
		
		Для каждого КолонкаТаблицыДанных Из ТаблицаДанных.Колонки Цикл
			ОператорЗапроса.ВыбираемыеПоля.Добавить(ИмяИсточника+"."+КолонкаТаблицыДанных.Имя);
		КонецЦикла;
		
		ЗапросПакета.ТаблицаДляПомещения = ИмяИсточника;
		//-------------------------------------------------
		ЗапросПакета = ЗапросыПакета.Добавить();
		
		ОператорЗапроса = ЗапросПакета.Операторы[0];
		ОператорЗапроса.Источники.Добавить(ИмяИсточника, "ВТ"+ИмяИсточника);
		Для каждого КолонкаТаблицыДанных Из ТаблицаДанных.Колонки Цикл
			ОператорЗапроса.ВыбираемыеПоля.Добавить("ВТ"+ИмяИсточника+"."+КолонкаТаблицыДанных.Имя);
		КонецЦикла;
		
		
		ЗапросПакета.ТаблицаДляПомещения = "ВТ"+ИмяИсточника;
		
		СчетГрафиков = СчетГрафиков + 1;
		
	КонецЦикла;
	
	КоличествоГрафиков = СчетГрафиков-1;
	
	ЗапросПакета = ЗапросыПакета.Добавить();
	ОператорЗапроса = ЗапросПакета.Операторы[0];
	
	СчетГрафиков = 1;
	СчетКолонокЗапроса = 0;
	
    ПериодДетализации = СтрПоле.ПериодДетализации;	
	
	Для СчетГрафиков = 1 По КоличествоГрафиков  Цикл
		
		ТаблицаДанных = стрГрафик.Данные;
		ИмяИсточника = "ТаблицаДанных" + СчетГрафиков;
		
		
		Источник = ОператорЗапроса.Источники.Добавить("ВТ"+ИмяИсточника, "ВТ"+ИмяИсточника);
		Если СчетГрафиков = 1 Тогда
			ПервыйИсточник = Источник; 
		Иначе 
			
			ПервыйИсточник.Соединения.Добавить(Источник.Источник.ИмяТаблицы, ПервыйИсточник.Источник.ИмяТаблицы+".Ключ1 = "+Источник.Источник.ИмяТаблицы+".Ключ1");
			
			//Если ПериодДетализации больше недели, то достаточно олного ключа сравнения
			Если ПериодДетализации = ПредопределенноеЗначение("Перечисление.ИА_ПериодыДетализации.День") 
				Или ПериодДетализации  = ПредопределенноеЗначение("Перечисление.ИА_ПериодыДетализации.Неделя") Тогда
				ПервыйИсточник.Соединения.Добавить(Источник.Источник.ИмяТаблицы, ПервыйИсточник.Источник.ИмяТаблицы+".Ключ2 = "+Источник.Источник.ИмяТаблицы+".Ключ2");
			КонецЕсли;
			
		КонецЕсли;
		
		Для каждого КолонкаТаблицыДанных Из ТаблицаДанных.Колонки Цикл
			
			ОператорЗапроса.ВыбираемыеПоля.Добавить("ВТ"+ИмяИсточника+"."+КолонкаТаблицыДанных.Имя);
			ЗапросПакета.Колонки[СчетКолонокЗапроса].Псевдоним = КолонкаТаблицыДанных.Имя+"_"+СчетГрафиков;
			
			СчетКолонокЗапроса = СчетКолонокЗапроса + 1;
			
		КонецЦикла;
	КонецЦикла;
	
	Для каждого СоединениеИсточника Из ПервыйИсточник.Соединения Цикл
		СоединениеИсточника.ТипСоединения = ТипСоединенияСхемыЗапроса.ПолноеВнешнее;
	КонецЦикла;
	
	Для СчетГрафиков = 1 По КоличествоГрафиков  Цикл
		ИмяИсточника = "ВТТаблицаДанных" + СчетГрафиков;
		Если СчетГрафиков = 1 Тогда
			ВыражениеКлюч1 = "Выбор Когда не "+ ИмяИсточника +".Ключ1 есть null тогда "+ ИмяИсточника +".Ключ1 "; 
			ВыражениеКлюч2 = "Выбор Когда не "+ ИмяИсточника +".Ключ2 есть null тогда "+ ИмяИсточника +".Ключ2 "; 
		Иначе 
			ВыражениеКлюч1 = ВыражениеКлюч1 + "Когда не "+ ИмяИсточника +".Ключ1 есть null тогда "+ ИмяИсточника +".Ключ1 ";
			ВыражениеКлюч2 = ВыражениеКлюч2 + "Когда не "+ ИмяИсточника +".Ключ2 есть null тогда "+ ИмяИсточника +".Ключ2 ";
		КонецЕсли;
	КонецЦикла;
	
	ВыражениеКлюч1 =ВыражениеКлюч1 + "Иначе ДАТАВРЕМЯ(1,1,1) Конец"; 
	ВыражениеКлюч2 =ВыражениеКлюч2 + "Иначе ДАТАВРЕМЯ(1,1,1) Конец"; 
	
	ОператорЗапроса.ВыбираемыеПоля.Добавить(ВыражениеКлюч1);
	ОператорЗапроса.ВыбираемыеПоля.Добавить(ВыражениеКлюч2);
	
	//!нужно поменять если изменится состав полей 
	НомерКолонкиКлюч1 = ЗапросПакета.Колонки.Количество()-2;
	НомерКолонкиКлюч2 = ЗапросПакета.Колонки.Количество()-1;
	
	ЗапросПакета.Колонки[НомерКолонкиКлюч1].Псевдоним = "Ключ1";
	ЗапросПакета.Колонки[НомерКолонкиКлюч2].Псевдоним = "Ключ2";
	
	ЗапросПакета.Порядок.Добавить(ЗапросПакета.Колонки[НомерКолонкиКлюч1]);
	ЗапросПакета.Порядок.Добавить(ЗапросПакета.Колонки[НомерКолонкиКлюч2]);
	
	Запрос.Текст = СхемаЗапроса.ПолучитьТекстЗапроса();
	
	СводнаяТаблица = Запрос.Выполнить().Выгрузить();
	
	Возврат СводнаяТаблица;
	
КонецФункции

Функция ПолучитьЗначениеИзСводнойТаблицы(СтрокаТаблицы, ИмяКолонки, НомерГрафика, ЗначениеПоУмолчанию) Экспорт
	
	Значение = СтрокаТаблицы[ИмяКолонки + "_"+НомерГрафика];	
	
	Если Не ЗначениеЗаполнено(Значение) и Значение <> 0 Тогда
		Значение = ЗначениеПоУмолчанию;
	КонецЕсли;
	
	Возврат Значение;
	
КонецФункции

Функция УстановитьЗначениеСводнойТаблицы(СтрокаТаблицы, ИмяКолонки, НомерГрафика, Значение) Экспорт
	
	СтрокаТаблицы[ИмяКолонки + "_"+НомерГрафика] = Значение;	

КонецФункции

Функция Квартал(ДатаСреза)
	
	НомерКвартала = 0;
	
	НомерМесяца = Месяц(ДатаСреза);
	Если НомерМесяца >= 1 И НомерМесяца <= 3 Тогда
		НомерКвартала = 1;
	ИначеЕсли	НомерМесяца >= 4 И НомерМесяца <= 6 Тогда
		НомерКвартала = 2;
	ИначеЕсли	НомерМесяца >= 7 И НомерМесяца <= 9 Тогда
		НомерКвартала = 3;
	ИначеЕсли	НомерМесяца >= 10 И НомерМесяца <= 12 Тогда
		НомерКвартала = 4;
	КонецЕсли;
	
	Возврат НомерКвартала;
	
КонецФункции

//возвращает начало недели по данным константы ИА_НачалоНедели
Функция ИА_НачалоНедели(_Дата) Экспорт 
	
	ДатаНачалаНедели = _Дата;
	
	НомерНачалаНедели = Константы.ИА_НачалоНедели.Получить();
	
	//если константа не заполнена, началонедели понедельник
	Если Не ЗначениеЗаполнено(НомерНачалаНедели) Тогда
		НомерНачалаНедели = 1;
	КонецЕсли;
	НомерДняНедели_Даты = ДеньНедели(_Дата);
	
	Если НомерНачалаНедели = НомерДняНедели_Даты  Тогда
		ДатаНачалаНедели = НачалоДня(_Дата);
	ИначеЕсли НомерНачалаНедели < НомерДняНедели_Даты  Тогда
		РазницаДней = (НомерДняНедели_Даты - НомерНачалаНедели);
		ДатаНачалаНедели = НачалоДня(ДобавитьДень(_Дата, -РазницаДней));
	Иначе
		РазницаДней = НомерДняНедели_Даты + (7 - НомерНачалаНедели);
		ДатаНачалаНедели = НачалоДня(ДобавитьДень(_Дата, -РазницаДней));
	КонецЕсли;
	
	Возврат ДатаНачалаНедели;
	
КонецФункции

//возвращает конец недели по данным константы ИА_НачалоНедели
Функция ИА_КонецНедели(_Дата) Экспорт 
	
	ДатаКонцаНедели = _Дата;
	
	НомерНачалаНедели = Константы.ИА_НачалоНедели.Получить();
	
	//если константа не заполнена, началонедели понедельник
	Если Не ЗначениеЗаполнено(НомерНачалаНедели) Тогда
		НомерНачалаНедели = 1;
	КонецЕсли;
	НомерДняНедели_Даты = ДеньНедели(_Дата);
	
	Если НомерНачалаНедели = НомерДняНедели_Даты  Тогда
		ДатаКонцаНедели = КонецДня(ДобавитьДень(_Дата, 6));
	ИначеЕсли НомерНачалаНедели < НомерДняНедели_Даты  Тогда
		РазницаДней = НомерНачалаНедели + (6 - НомерДняНедели_Даты);
		ДатаКонцаНедели = КонецДня(ДобавитьДень(_Дата, РазницаДней));
	Иначе
		РазницаДней = (НомерНачалаНедели - НомерДняНедели_Даты)-1;
		ДатаКонцаНедели = КонецДня(ДобавитьДень(_Дата, РазницаДней));
	КонецЕсли;
	
	Возврат ДатаКонцаНедели;
	
КонецФункции	

//возвращает ближайшее начало недели по данным константы ИА_НачалоНедели
//если от _Дата до конца недели ближе чем до начала, то началом недели является начало следующей недели 
Функция ИА_БлижнийНачалоНедели(_Дата) Экспорт 
	
	ДатаНачалаНедели = ИА_НачалоНедели(_Дата);
	ДатаКонцаНедели  = ИА_КонецНедели(_Дата);
	
	Если Абс(_Дата - ДатаНачалаНедели) <= Абс(_Дата - ДатаКонцаНедели) Тогда
		ДатаБлижнийНачалоНедели = ДатаНачалаНедели;
	иначе
		ДатаБлижнийНачалоНедели = НачалоДня(ДобавитьДень(ДатаКонцаНедели, 1));
	КонецЕсли;
	
	Возврат ДатаБлижнийНачалоНедели;
	
КонецФункции

//возвращает ближайший конец недели по данным константы ИА_НачалоНедели
//если от _Дата до начала  недели ближе чем до конца, то концом недели является конец предидущей недели 
Функция ИА_БлижнийКонецНедели(_Дата)	
	
	ДатаНачалаНедели = ИА_НачалоНедели(_Дата);
	ДатаКонцаНедели  = ИА_КонецНедели(_Дата);
	
	Если Абс(_Дата - ДатаНачалаНедели) >= Абс(_Дата - ДатаКонцаНедели) Тогда
		ДатаБлижнийКонцаНедели = ДатаКонцаНедели;
	иначе
		ДатаБлижнийКонцаНедели = КонецДня(ДобавитьДень(ДатаНачалаНедели, -1));
	КонецЕсли;
	
	Возврат ДатаБлижнийКонцаНедели;
	
КонецФункции

Функция ИА_НачалоНеделиСУчетомРаспределения(_Дата) Экспорт 
	
	ОтображатьНедельныеСтатистикиПоРаспределениюНедель = Константы.ИА_ОтображатьНедельныеСтатистикиПоРаспределениюНедель.Получить();
	
	Если ОтображатьНедельныеСтатистикиПоРаспределениюНедель Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	НАЧАЛОПЕРИОДА(ИА_РаспределениеНедель.Период, ДЕНЬ) КАК НачалоНедели,
		|	КОНЕЦПЕРИОДА(ИА_РаспределениеНедель.КонецНедели, ДЕНЬ) КАК КонецНедели
		|ИЗ
		|	РегистрСведений.ИА_РаспределениеНедель КАК ИА_РаспределениеНедель
		|ГДЕ
		|	ИА_РаспределениеНедель.Период <= &Период
		|	И ИА_РаспределениеНедель.КонецНедели >= &Период";
		
		Запрос.УстановитьПараметр("Период", _Дата);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Если ВыборкаДетальныеЗаписи.Следующий() Тогда
			ДатаНачалаНедели = ВыборкаДетальныеЗаписи.НачалоНедели;
		иначе
			ДатаНачалаНедели = ИА_БлижнийНачалоНедели(_Дата);
		КонецЕсли; 	
		
	иначе	
		ДатаНачалаНедели = ИА_БлижнийНачалоНедели(_Дата);
	КонецЕсли;
	
	Возврат ДатаНачалаНедели;
	
КонецФункции

Функция ИА_КонецНеделиСУчетомРаспределения(_Дата) Экспорт 
	
	ОтображатьНедельныеСтатистикиПоРаспределениюНедель = Константы.ИА_ОтображатьНедельныеСтатистикиПоРаспределениюНедель.Получить();
	
	Если ОтображатьНедельныеСтатистикиПоРаспределениюНедель Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	НАЧАЛОПЕРИОДА(ИА_РаспределениеНедель.Период, ДЕНЬ) КАК НачалоНедели,
		|	КОНЕЦПЕРИОДА(ИА_РаспределениеНедель.КонецНедели, ДЕНЬ) КАК КонецНедели
		|ИЗ
		|	РегистрСведений.ИА_РаспределениеНедель КАК ИА_РаспределениеНедель
		|ГДЕ
		|	ИА_РаспределениеНедель.Период <= &Период
		|	И ИА_РаспределениеНедель.КонецНедели >= &Период";
		
		Запрос.УстановитьПараметр("Период", _Дата);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Если ВыборкаДетальныеЗаписи.Следующий() Тогда
			ДатаКонцаНедели = ВыборкаДетальныеЗаписи.КонецНедели;
		иначе
			ДатаКонцаНедели = ИА_БлижнийКонецНедели(_Дата);
		КонецЕсли; 	
		
	иначе	
		ДатаКонцаНедели = ИА_БлижнийКонецНедели(_Дата);
	КонецЕсли;
	
	Возврат ДатаКонцаНедели;
	
КонецФункции	

Функция ЕстьСдвигиПериода(СтрокаГрафика) Экспорт
	
	СтрокиДетализации = СтрокаГрафика.Строки;
	Для каждого СтрДетализации Из СтрокиДетализации Цикл
		Если СтрДетализации.СдвигПериода > 0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

