						ОтменитьТранзакцию();
						Отказ = Истина;
					КонецПопытки;
					
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		
		Если НЕ Отказ Тогда
			ЗафиксироватьТранзакцию();
			
			РезультатОбработки.Успешно = Истина;
		КонецЕсли;
		
	КонецЕсли;
	
