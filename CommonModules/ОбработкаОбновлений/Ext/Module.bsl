#Область Обработка_3_1_1_0

Функция Обработка_3_1_1_0(СсылкаНаОбъект, ОбработкаОбязательныхОбъектов, ВерсияПрограммыЧисло) Экспорт
	
	Если ОбработкаОбязательныхОбъектов Тогда
		Возврат Обработка_3_1_1_0_Обязательные(СсылкаНаОбъект);
	КонецЕсли;
	
	РезультатОбработки = Новый Структура;
	РезультатОбработки.Вставить("Успешно", Ложь);
	РезультатОбработки.Вставить("ОписаниеОшибки", "");
		
	Если ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.ЗаказДоговор") Тогда
		//#16242
		Обработка_3_1_1_0_ЗаказДоговор(СсылкаНаОбъект, РезультатОбработки);
		
	ИначеЕсли ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.Монтаж") Тогда
		//#16242
		// 14.2 Для всех монтажей в базе на момент обновления, у которых вид "Сервисная заявка" или "Рекламация" создать и заполнить документ "Заказ договор" в котором:
		// - дата ЗД = дата документа монтаж
		// - все поля и значения ТЧ брать из монтажа
		// - вид ЗД равен виду монтажа. 
		// - Если монтаж закрыт, то статус ЗД "выполнен". Если монтаж "частично выполнен", то ЗД "в работе". Если монтаж отменен то ЗД "отменен".
		// - в ранее созданных по лидам "обращения" монтажах с видом "Сервисная заявка" и "Рекламация" основание лид заменить на созданный ЗД. 
		//   у самих ЗД основанием указать лид по котором ранее был создан монтаж сервисная заявка или рекламация
		//- найти все полученные оплаты по сервисным заявкам и рекламациям (ПКО, ППВ) и добавить распределение оплаты точно такое же как было на этот монтаж на созданный ЗД

		ДокОбъект = СсылкаНаОбъект.ПолучитьОбъект();
		
		ДокЗаказОбъект = Документы.ЗаказДоговор.СоздатьДокумент();
		ДокЗаказОбъект.Заполнить(Неопределено);
		ЗаполнитьЗначенияСвойств(ДокЗаказОбъект, ДокОбъект, "Дата, Автор, Адрес, Валюта, ВидСкидки, ВидЦен, Геометка, 
															|Основание, СуммаДокумента, СозданПриИспользованииПодразделений,
															|ТочкаПродаж, Подразделение, Организация,
															|Контрагент, ДоговорКонтрагента, ДисконтнаяКарта");
		Если ДокОбъект.ВидОперации = Справочники.ВидыМонтажа.СервиснаяЗаявка Тогда
			ДокЗаказОбъект.ВидЗаказа = Справочники.ВидыЗаказДоговоров.СервиснаяЗаявка;
			ДокЗаказОбъект.ЗаказДоговорОснование = ДокОбъект.ЗаказДоговор;
		ИначеЕсли ДокОбъект.ВидОперации = Справочники.ВидыМонтажа.Рекламация Тогда
			ДокЗаказОбъект.ВидЗаказа = Справочники.ВидыЗаказДоговоров.Рекламация;
			ДокЗаказОбъект.ЗаказДоговорОснование = ДокОбъект.ЗаказДоговор;
		КонецЕсли;
		ДокЗаказОбъект.ДоговорБезЗамера = Истина;
		ДокЗаказОбъект.СтавкаНДС = УчетНДС.СтавкаНДСПоУмолчанию(ДокЗаказОбъект.Организация);
		
		ДокЗаказОбъект.ТекущийСтатус = Справочники.СтатусыЗаказДоговоров.ВРаботе;
		Если ДокОбъект.Результат = Справочники.РезультатыМонтажа.Закрыт Тогда
			ДокЗаказОбъект.ТекущийСтатус = Справочники.СтатусыЗаказДоговоров.Выполнен; 
		ИначеЕсли ДокОбъект.Результат = Справочники.РезультатыМонтажа.Выполнен Тогда
			ДокЗаказОбъект.ТекущийСтатус = Справочники.СтатусыЗаказДоговоров.Выполнен;			
		ИначеЕсли ДокОбъект.Результат = Справочники.РезультатыМонтажа.Отменен Тогда
			ДокЗаказОбъект.ТекущийСтатус = Справочники.СтатусыЗаказДоговоров.Отменен;			
		КонецЕсли;

		МассивКомнат = Новый Массив;
		ИтогСуммаБезСкидки = 0;
		
		ДокЗаказОбъект.ТоварыУслуги.Очистить(); // 2023-09-01 очищаем результат обработки константы "ИспользоватьСправочникКомнатВРознице"

		Для каждого СтрокаТЧ из ДокОбъект.ТоварыУслуги Цикл
			НоваяСтрока = ДокЗаказОбъект.ТоварыУслуги.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТЧ);
			//++
			Если НЕ ЗначениеЗаполнено(СтрокаТЧ.УИСтроки) Тогда
				СтрокаТЧ.УИСтроки = Строка(Новый УникальныйИдентификатор);
				НоваяСтрока.УИСтроки = СтрокаТЧ.УИСтроки;
			КонецЕсли;
			
			//++
			Если НЕ ЗначениеЗаполнено(СтрокаТЧ.Комната) Тогда
				НоваяСтрока.Комната = "Комната";
				СтрокаТЧ.Комната = "Комната"; // 2023-09-01
			КонецЕсли;
			
			//++
			ИтогСуммаБезСкидки = ИтогСуммаБезСкидки + НоваяСтрока.Количество * НоваяСтрока.Цена;
			Если МассивКомнат.Найти(НоваяСтрока.Комната) = Неопределено Тогда
				МассивКомнат.Добавить(НоваяСтрока.Комната);	
			КонецЕсли;
		КонецЦикла;
		
		Для каждого СтрокаТЧ из ДокОбъект.Материалы Цикл
			НоваяСтрока = ДокЗаказОбъект.Материалы.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТЧ);
			//++
			Если НЕ ЗначениеЗаполнено(СтрокаТЧ.УИСтроки) Тогда
				СтрокаТЧ.УИСтроки = Строка(Новый УникальныйИдентификатор);
				НоваяСтрока.УИСтроки = СтрокаТЧ.УИСтроки;
			КонецЕсли;
			
			//++
			Если НЕ ЗначениеЗаполнено(СтрокаТЧ.Комната) Тогда
				НоваяСтрока.Комната = "Комната";
				СтрокаТЧ.Комната = "Комната"; // 2023-09-01
			КонецЕсли;
			Если МассивКомнат.Найти(НоваяСтрока.Комната) = Неопределено Тогда
				МассивКомнат.Добавить(НоваяСтрока.Комната);	
			КонецЕсли;
		КонецЦикла;
		
		ДокЗаказОбъект.Комментарий = "#Создан автоматически при обновлении на версию 3.1.1";
		
		//++		
		ДокЗаказОбъект.СуммаДокумента = ДокЗаказОбъект.ТоварыУслуги.Итог("Сумма");
		ДокЗаказОбъект.СуммаДокументаПоПрайсу = ДокЗаказОбъект.ТоварыУслуги.Итог("СуммаПоПрайсу");
		ДокЗаказОбъект.ОтклонениеОтПрайса = ДокЗаказОбъект.СуммаДокумента - ДокЗаказОбъект.СуммаДокументаПоПрайсу;		
		ДокЗаказОбъект.СуммаСкидки = ДокЗаказОбъект.ТоварыУслуги.Итог("СуммаСкидки");		
		Если НЕ ДокЗаказОбъект.СуммаСкидки = 0
			И НЕ ИтогСуммаБезСкидки = 0
			Тогда
			ДокЗаказОбъект.ПроцентСкидки = Окр(100 * ДокЗаказОбъект.СуммаСкидки / (ИтогСуммаБезСкидки), 2);
		Иначе
			ДокЗаказОбъект.ПроцентСкидки = 0;
		КонецЕсли;
		ДокЗаказОбъект.КоличествоКомнат = МассивКомнат.Количество();
		//--
		
		РежимЗаписи = ?(ДокОбъект.Проведен, РежимЗаписиДокумента.Проведение, РежимЗаписиДокумента.Запись); 
		
		Попытка
			ДокЗаказОбъект.ДополнительныеСвойства.Вставить("ПропуститьПроверкуЗапретаИзменения", Истина);
			ДокЗаказОбъект.Записать(РежимЗаписи);
			
			Комментарий = СтрШаблон("%1: при обновлении на версию 3.1.1 основание с %2 изменено на %3", ДокОбъект.Ссылка, ДокОбъект.Основание, ДокЗаказОбъект.Ссылка);
			РегистрыСведений.ТехнологическийЖурнал.ЗаписатьСобытие("Изменение основания монтажа (СЗ и Р)", Комментарий);
			
			//ДокОбъект.ЗаказДоговор = ДокЗаказОбъект.Ссылка; // 2023-10-31 не трогаем это поле
			ДокОбъект.Основание = ДокЗаказОбъект.Ссылка;
			
			ДокОбъект.ОбменДанными.Загрузка = Истина;			
			ДокОбъект.ДополнительныеСвойства.Вставить("ПропуститьПроверкуЗапретаИзменения", Истина);
			ДокОбъект.Записать();			
			
			//Если Константы.ВестиРасчетыПоЗаказамПоЗаказДоговору.Получить() 
			//	И Константы.ВестиРасчетыПоЗаказамПоМонтажу.Получить() Тогда     // 2023-08-09 Ильнур: не проверяем настройки, пишем всегда
				
				ЗапросОплат = Новый запрос;
				ЗапросОплат.УстановитьПараметр("Заказ", СсылкаНаОбъект);
				ЗапросОплат.Текст = 
				"ВЫБРАТЬ РАЗЛИЧНЫЕ
				|	РасчетыПоЗаказамОбороты.Регистратор КАК Регистратор,
				|	РасчетыПоЗаказамОбороты.СуммаРасход КАК СуммаРасход
				|ИЗ
				|	РегистрНакопления.РасчетыПоЗаказам.Обороты(, , Регистратор, Заказ = &Заказ) КАК РасчетыПоЗаказамОбороты
				|ГДЕ
				|	РасчетыПоЗаказамОбороты.СуммаРасход > 0";
				
				ВыборкаОплат = ЗапросОплат.Выполнить().Выбрать();
				Пока ВыборкаОплат.Следующий() Цикл
					Если ТипЗнч(ВыборкаОплат.Регистратор) = Тип("ДокументСсылка.ОплатаБанковскойКартой") 
						ИЛИ ТипЗнч(ВыборкаОплат.Регистратор) = Тип("ДокументСсылка.ПриходныйКассовыйОрдер")	
						ИЛИ ТипЗнч(ВыборкаОплат.Регистратор) = Тип("ДокументСсылка.ПоступлениеНаРасчетныйСчет")
						Тогда
						
						ДокОплатыОбъект = ВыборкаОплат.Регистратор.ПолучитьОбъект();
						НС = ДокОплатыОбъект.РаспределениеПлатежа.НайтиСтроки(Новый Структура("Документ", СсылкаНаОбъект));
						Для каждого НСтрока из НС Цикл
							НоваяСтрока = ДокОплатыОбъект.РаспределениеПлатежа.Добавить();
							ЗаполнитьЗначенияСвойств(НоваяСтрока, НСтрока);
							НоваяСтрока.Документ = ДокЗаказОбъект.Ссылка;
							
							Комментарий = СтрШаблон("%1: при обновлении на версию 3.1.1 в распределение добавлен документ %2", ВыборкаОплат.Регистратор, ДокЗаказОбъект.Ссылка);
							РегистрыСведений.ТехнологическийЖурнал.ЗаписатьСобытие("Изменение документа оплаты", Комментарий);
							
						КонецЦикла;
						
						ДокОплатыОбъект.ДополнительныеСвойства.Вставить("ПропуститьПроверкуЗапретаИзменения", Истина);
						ДокОплатыОбъект.Записать(РежимЗаписиДокумента.Проведение);
						
					КонецЕсли;
					
				КонецЦикла;
	
			//КонецЕсли;
			
			РезультатОбработки.Успешно = Истина;				
		Исключение				
			РезультатОбработки.Успешно = Ложь;
			РезультатОбработки.ОписаниеОшибки = ОписаниеОшибки();
		КонецПопытки;			
		
	КонецЕсли;
	
	Возврат РезультатОбработки;
	
КонецФункции

Функция Обработка_3_1_1_0_Обязательные(СсылкаНаОбъект) Экспорт
	
	РезультатОбработки = Новый Структура;
	РезультатОбработки.Вставить("Успешно", Ложь);
	РезультатОбработки.Вставить("ОписаниеОшибки", "");
	
	//#16242
	Если ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.ЗаказДоговор") Тогда
		Обработка_3_1_1_0_ЗаказДоговор(СсылкаНаОбъект, РезультатОбработки);	
	КонецЕсли;
	
	Возврат РезультатОбработки;
	
КонецФункции

Процедура Обработка_3_1_1_0_ЗаказДоговор(СсылкаНаОбъект, РезультатОбработки) Экспорт
	
	ДокОбъект = СсылкаНаОбъект.ПолучитьОбъект();	
	ДокОбъект.ВидЗаказа = Справочники.ВидыЗаказДоговоров.Договор;
	
	Попытка
		ДокОбъект.ОбменДанными.Загрузка = Истина;			
		ДокОбъект.ДополнительныеСвойства.Вставить("ПропуститьПроверкуЗапретаИзменения", Истина);
		ДокОбъект.Записать();
		
		РезультатОбработки.Успешно = Истина;				
	Исключение				
		РезультатОбработки.Успешно = Ложь;
		РезультатОбработки.ОписаниеОшибки = ОписаниеОшибки();				
	КонецПопытки;
	
КонецПроцедуры

