		Спробъект.ДатаЗавершения = Спробъект.ДатаИсполнения;
		Спробъект.РезультатИсполнения = Спробъект.ИсторияВыполнения;
		
		Попытка
			Спробъект.Записать(); 
			РезультатОбработки.Успешно = Истина;
		Исключение
			РезультатОбработки.Успешно = Ложь;
			РезультатОбработки.ОписаниеОшибки = ОписаниеОшибки();
		КонецПопытки;
		
		// отмененные заказы покупателей с движениями в регистре "Заказы покупателей"
	ИначеЕсли ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.ЗаказПокупателя") Тогда	
		
		ДокОбъект = СсылкаНаОбъект.ПолучитьОбъект();
		
