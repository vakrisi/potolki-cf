Функция Обработка_2_0_0_S7(СсылкаДокумент) Экспорт
	
	РезультатОбработки = Новый Структура;
	РезультатОбработки.Вставить("Успешно", Ложь);
	РезультатОбработки.Вставить("ОписаниеОшибки", "");
	
	ТипЗначенияДокумента = ТипЗнч(СсылкаДокумент);
	
	Если ТипЗначенияДокумента = Тип("ДокументСсылка.РеализацияТоваровИУслуг") Тогда
		
		ДокОбъект = СсылкаДокумент.ПолучитьОбъект();
		ДокОбъект.НачислятьБонусы  						 = ДокОбъект.СуммаБонусовКНачислениюПоДисконтнойКарте > 0;
		ДокОбъект.СлужебныйУчитыватьБонусы 				 = ДокОбъект.СуммаБонусовКСписаниюПоДисконтнойКарте > 0;
		ДокОбъект.СлужебныйУчетБонусовПоДисконтнымКартам = ЗначениеЗаполнено(ДокОбъект.ДисконтнаяКарта);
		
		//Попытка
		//	ДокОбъект.Записать();
		//Исключение
		//	Сообщить(ОписаниеОшибки());
		//КонецПопытки;
		
		Попытка
			ДокОбъект.Записать();
		Исключение
			РезультатОбработки.Успешно = Ложь;
			РезультатОбработки.ОписаниеОшибки = "Ошибка записи документа: " + ОписаниеОшибки();
			Возврат РезультатОбработки;
		КонецПопытки;
		
		Если ДокОбъект.Проведен Тогда
			Попытка
				ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
			Исключение
				РезультатОбработки.Успешно = Ложь;
				РезультатОбработки.ОписаниеОшибки = "Ошибка проведения документа: " +  ОписаниеОшибки();
				Возврат РезультатОбработки;
			КонецПопытки		
		КонецЕсли;
		
		
	ИначеЕсли ТипЗначенияДокумента = Тип("ДокументСсылка.ПриходныйКассовыйОрдер") 
		ИЛИ ТипЗначенияДокумента = Тип("ДокументСсылка.ПоступлениеНаРасчетныйСчет")
		ИЛИ ТипЗначенияДокумента = Тип("ДокументСсылка.ОплатаБанковскойКартой") Тогда
		
		ДокОбъект = СсылкаДокумент.ПолучитьОбъект();
		Для каждого СтрокаТЧ из ДокОбъект.РаспределениеПлатежа Цикл
			СтрокаТЧ.СуммаВВалютеДокумента  = ДокОбъект.Сумма;
		КонецЦикла;
		
		Если ТипЗначенияДокумента = Тип("ДокументСсылка.ОплатаБанковскойКартой") Тогда
			ДокОбъект.Валюта = Константы.ВалютаУчета.Получить();	
		КонецЕсли;
		
		Попытка
			ДокОбъект.Записать();
		Исключение
			РезультатОбработки.Успешно = Ложь;
			РезультатОбработки.ОписаниеОшибки = "Ошибка записи документа: " + ОписаниеОшибки();
			Возврат РезультатОбработки;
		КонецПопытки;
		
	ИначеЕсли ТипЗначенияДокумента = Тип("ДокументСсылка.ВнутреннееПеремещениеДенежныхСредств") 
		ИЛИ ТипЗначенияДокумента = Тип("ДокументСсылка.РасходныйКассовыйОрдер") 
		ИЛИ ТипЗначенияДокумента = Тип("ДокументСсылка.СписаниеСРасчетногоСчета") 
		Тогда
		
		ДокОбъект = СсылкаДокумент.ПолучитьОбъект();
		ДокОбъект.СлужебныйКонтролироватьЗаполнениеЗаявки  = Истина;
		
		Попытка
			ДокОбъект.Записать();
		Исключение
			РезультатОбработки.Успешно = Ложь;
			РезультатОбработки.ОписаниеОшибки = "Ошибка записи документа: " + ОписаниеОшибки();
			Возврат РезультатОбработки;
		КонецПопытки;
		
	КонецЕсли;
	
	РезультатОбработки.Успешно = Истина;
	Возврат РезультатОбработки;
	
КонецФункции

#КонецОбласти

#Область Обработка_2_0_0_S_переход

Функция Обработка_2_0_0_S(СсылкаДокумент) Экспорт
	
	РезультатОбработки = Новый Структура;
	РезультатОбработки.Вставить("Успешно", Ложь);
	РезультатОбработки.Вставить("ОписаниеОшибки", "");
	
	Если ТипЗнч(СсылкаДокумент) = Тип("ДокументСсылка.ЗаказНаПроизводство") Тогда
		МассивЗНП = Новый Массив;
		МассивЗНП.Добавить(СсылкаДокумент);
		
		//предварительно заполним УИСтрок в самом ЗНП
		РезультатОбработкиЗНП = ЗаполнитьУИСтрокВЗНП(СсылкаДокумент);
		Если НЕ РезультатОбработкиЗНП.Успешно Тогда
			РезультатОбработки.Успешно = Ложь;
			РезультатОбработки.ОписаниеОшибки = РезультатОбработкиЗНП.ОписаниеОшибки;
			Возврат РезультатОбработки;
		КонецЕсли;
		
		СозданЗП = СоздатьЗаказыПокупателейПоСпискуНаСервере(МассивЗНП);
		Если НЕ СозданЗП Тогда
			РезультатОбработки.Успешно = Ложь;
			РезультатОбработки.ОписаниеОшибки = "См. Журнал регистрации";
			Возврат РезультатОбработки;
		КонецЕсли;
		
		//если ЗП создали выполняем корректировки документов
		Для Инд = 2 По 9 Цикл
			ШагКорректировки = ВыполнитьКорректировкиНаСервере(Инд, МассивЗНП);
			Если НЕ ШагКорректировки.Успешно Тогда
				РезультатОбработки.Успешно = Ложь;
				РезультатОбработки.ОписаниеОшибки = ШагКорректировки.ОписаниеОшибки;
				Возврат РезультатОбработки;
			КонецЕсли;
		КонецЦикла;	
		
	КонецЕсли;
	
	РезультатОбработки.Успешно = Истина;
	Возврат РезультатОбработки;
	
КонецФункции

//Вспомогательные функции процедуры для перехода на 2.0
Процедура ПолучитьЗНПКОбработке(МенВремТаб) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенВремТаб;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Док.Ссылка КАК Ссылка,
	|	Док.ТекущийСтатус КАК СтатусЗНП,
	|	Док.ДокументОснование КАК ДокументОснование,
	|	ВЫБОР
	|		КОГДА Док.ПометкаУдаления
	|			ТОГДА 2
	|		КОГДА Док.Проведен
	|			ТОГДА 1
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК Состояние
	|ПОМЕСТИТЬ ВТ_ЗНП_КОбработке
	|ИЗ
	|	Документ.ЗаказНаПроизводство КАК Док
	|ГДЕ
	|	(Док.ДокументОснование = НЕОПРЕДЕЛЕНО
	|			ИЛИ Док.ДокументОснование ССЫЛКА Документ.ЗаказПокупателя
	|				И Док.ДокументОснование = ЗНАЧЕНИЕ(Документ.ЗаказПокупателя.ПустаяСсылка)
	|			ИЛИ Док.ДокументОснование ССЫЛКА Документ.ЗаказДоговор
	|			ИЛИ Док.ДокументОснование ССЫЛКА Документ.ЗаказНаПроизводство)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ДанныеТаблицы.Ссылка КАК Ссылка,
	|	ДанныеТаблицы.Заказ КАК Заказ,
	|	ДанныеТаблицы.Сумма КАК СуммаРТИУ
	|ПОМЕСТИТЬ ВТ_ГрупповыеОтгрузкиВрем
	|ИЗ
	|	Документ.РеализацияТоваровИУслуг.Товары КАК ДанныеТаблицы
	|ГДЕ
	|	ДанныеТаблицы.Ссылка.ГрупповаяОтгрузка
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ДанныеТаблицы.Ссылка,
	|	ДанныеТаблицы.Заказ,
	|	ДанныеТаблицы.Сумма
	|ИЗ
	|	Документ.РеализацияТоваровИУслуг.Услуги КАК ДанныеТаблицы
	|ГДЕ
	|	ДанныеТаблицы.Ссылка.ГрупповаяОтгрузка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ГрупповыеОтгрузкиВрем.Ссылка КАК Ссылка,
	|	ВТ_ГрупповыеОтгрузкиВрем.Заказ КАК Заказ,
	|	СУММА(ВТ_ГрупповыеОтгрузкиВрем.СуммаРТИУ) КАК СуммаРТИУ
	|ПОМЕСТИТЬ ВТ_ГрупповыеОтгрузки
	|ИЗ
	|	ВТ_ГрупповыеОтгрузкиВрем КАК ВТ_ГрупповыеОтгрузкиВрем
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_ГрупповыеОтгрузкиВрем.Ссылка,
	|	ВТ_ГрупповыеОтгрузкиВрем.Заказ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	РеализацияТоваровИУслуг.Ссылка КАК ДокРтиу,
	|	РеализацияТоваровИУслуг.Основание КАК ДокОснование,
	|	РеализацияТоваровИУслуг.СуммаДокумента КАК СуммаРТИУ
	|ПОМЕСТИТЬ ВТ_ДокументыРеализацииВрем
	|ИЗ
	|	Документ.РеализацияТоваровИУслуг КАК РеализацияТоваровИУслуг
	|ГДЕ
	|	НЕ РеализацияТоваровИУслуг.ГрупповаяОтгрузка
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	ВТ_ГрупповыеОтгрузки.Ссылка,
	|	ВТ_ГрупповыеОтгрузки.Заказ,
	|	ВТ_ГрупповыеОтгрузки.СуммаРТИУ
	|ИЗ
	|	ВТ_ГрупповыеОтгрузки КАК ВТ_ГрупповыеОтгрузки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ДокументыРеализацииВрем.ДокОснование КАК ДокОснование,
	|	КОЛИЧЕСТВО(ВТ_ДокументыРеализацииВрем.ДокРтиу) КАК КоличествоРеализаций,
	|	СУММА(ВТ_ДокументыРеализацииВрем.СуммаРТИУ) КАК СуммаРтиу
	|ПОМЕСТИТЬ ВТ_ДокументыРеализации
	|ИЗ
	|	ВТ_ДокументыРеализацииВрем КАК ВТ_ДокументыРеализацииВрем
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_ДокументыРеализацииВрем.ДокОснование";
	
	Запрос.Выполнить();
	
КонецПроцедуры 

Процедура ЗаписатьОшибкуВЖурнал(ТекстОшибки, ДокументСсылка)
	
	ЗаписьЖурналаРегистрации("Переход на 2.0", УровеньЖурналаРегистрации.Ошибка,, ДокументСсылка, ТекстОшибки);
	
КонецПроцедуры

Функция СоздатьЗаказыПокупателейПоСпискуНаСервере(МассивЗНП)
	
	Для Каждого ЗаказНаПроизводство Из МассивЗНП Цикл
		
		Если ТипЗнч(ЗаказНаПроизводство.ДокументОснование) = Тип("ДокументСсылка.ЗаказПокупателя")
			И НЕ ЗаказНаПроизводство.ДокументОснование.Пустая() Тогда
			//уже есть заказ покупателя, являющийся основанием заказа на производство, возможно обработку 
			//запустили второй раз после остановки и ЗП был создан ранее
			//перезаполним этот ЗП
			ЗаказПокупателя = ЗаказНаПроизводство.ДокументОснование.ПолучитьОбъект();
		Иначе
			//создаем ЗП
			ЗаказПокупателя = Документы.ЗаказПокупателя.СоздатьДокумент();
			Если ТипЗнч(ЗаказНаПроизводство.ДокументОснование) = Тип("ДокументСсылка.ЗаказДоговор") Тогда
				//если основанием ЗНП был ЗД, то у нового ЗП основанием сделаем тот же ЗД
				ЗаказПокупателя.Основание = ЗаказНаПроизводство.ДокументОснование; 
			КонецЕсли;
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(ЗаказПокупателя, ЗаказНаПроизводство,, "Номер, Комментарий, ПометкаУдаления");
		//++ заявка 4249 2019-03-27
		Если НЕ ЗаказПокупателя.ЭтоЗаказОтРозницы Тогда
			ЗаказПокупателя.НастройкаИнтеркампани = Справочники.НастройкиИнтеркампани.ПустаяСсылка();
		КонецЕсли;
		//--
		Если НЕ ЗаказНаПроизводство.ТекущийСтатус = Справочники.СтатусыЗаказовНаПроизводство.Отменен Тогда 
			ЗаказПокупателя.ТекущийСтатус = Справочники.СтатусыЗаказовПокупателей.ВРаботе;
		Иначе
			ЗаказПокупателя.ТекущийСтатус = Справочники.СтатусыЗаказовПокупателей.Отменен;
		КонецЕсли;	
		ЗаказПокупателя.Комментарий = "Создан при переходе на версию 2.0" + " из ЗНП " + ЗаказНаПроизводство.Номер + ". " + ЗаказНаПроизводство.Комментарий;
		//Если ЗаказПокупателя.Контрагент.Пустая() Тогда
		//	ЗаказПокупателя.Контрагент = Контрагент;
		//КонецЕсли;	
		
		//Табличные части
		ЗаказПокупателя.Товары.Очистить();
		ЗаказПокупателя.Материалы.Очистить();
		
		Потолок = Справочники.Номенклатура.ПустаяСсылка();
		УИСтрокиПотолка = "";
		Если ЗаказНаПроизводство.ВидЗаказа = Перечисления.ВидыЗаказовНаПроизводство.ПроизводствоПотолка Тогда
			
			НовСтрока = ЗаказПокупателя.Товары.Добавить();
			НовСтрока.Номенклатура = ЗаказНаПроизводство.ПродукцияНоменклатура;
			НовСтрока.ЕдиницаИзмерения = ЗаказНаПроизводство.ПродукцияНоменклатураЕдиницаИзмерения;
			НовСтрока.Количество = ЗаказНаПроизводство.ПродукцияНоменклатураКоличество;
			НовСтрока.Коэффициент = ЗаказНаПроизводство.ПродукцияНоменклатураКоэффициент;
			НовСтрока.ПроцентРучнойСкидки = ЗаказНаПроизводство.ПродукцияПроцентРучнойСкидки;
			НовСтрока.Сумма = ЗаказНаПроизводство.ПродукцияСумма;
			НовСтрока.СуммаРучнойСкидки = ЗаказНаПроизводство.ПродукцияСуммаРучнойСкидки;
			НовСтрока.Цена = ЗаказНаПроизводство.ПродукцияЦена;
			НовСтрока.ЗаказНаПроизводство = ЗаказНаПроизводство;
			
			УИСтрокиПотолка = ЗаказНаПроизводство.ПродукцияУИСтроки;
			
			НовСтрока.УИСтроки = УИСтрокиПотолка;
			НовСтрока.УИСтрокиРодителя = УИСтрокиПотолка;			
			
			Потолок = ЗаказНаПроизводство.ПродукцияНоменклатура;
			
		ИначеЕсли ЗаказНаПроизводство.ВидЗаказа = Перечисления.ВидыЗаказовНаПроизводство.ТиповоеПроизводство Тогда
			
			Для Каждого Продукция Из ЗаказНаПроизводство.Продукция Цикл
				
				НовСтрока = ЗаказПокупателя.Товары.Добавить();
				ЗаполнитьЗначенияСвойств(НовСтрока, Продукция);
				НовСтрока.ЗаказНаПроизводство = ЗаказНаПроизводство;
				НовСтрока.УИСтрокиРодителя = НовСтрока.УИСтроки;
				
			КонецЦикла;	
			
		КонецЕсли;
		
		Для Каждого Товар Из ЗаказНаПроизводство.Товары Цикл
			
			НовСтрока = ЗаказПокупателя.Товары.Добавить();
			ЗаполнитьЗначенияСвойств(НовСтрока, Товар);				
			НовСтрока.Потолок = Потолок;
			НовСтрока.УИСтроки = Новый УникальныйИдентификатор; //у строк товаров в ЗП свой УИС
			Если НЕ ПустаяСтрока(УИСтрокиПотолка) Тогда
				НовСтрока.УИСтрокиРодителя = УИСтрокиПотолка;
			Иначе
				НовСтрока.УИСтрокиРодителя = НовСтрока.УИСтроки;
			КонецЕсли;
			
		КонецЦикла;	
		
		Для Каждого Услуга Из ЗаказНаПроизводство.Услуги Цикл
			
			НовСтрока = ЗаказПокупателя.Товары.Добавить();
			ЗаполнитьЗначенияСвойств(НовСтрока, Услуга);
			НовСтрока.Потолок = Потолок;
			НовСтрока.УИСтроки = Новый УникальныйИдентификатор; //у строк товаров в ЗП свой УИС
			Если НЕ ПустаяСтрока(УИСтрокиПотолка) Тогда
				НовСтрока.УИСтрокиРодителя = УИСтрокиПотолка;
			Иначе
				НовСтрока.УИСтрокиРодителя = НовСтрока.УИСтроки;
			КонецЕсли;
			
		КонецЦикла;
		
		Для Каждого Материал Из ЗаказНаПроизводство.Материалы Цикл
			
			НовСтрока = ЗаказПокупателя.Материалы.Добавить();
			ЗаполнитьЗначенияСвойств(НовСтрока, Материал);
			НовСтрока.Потолок = Потолок;
			НовСтрока.УИСтроки = УИСтрокиПотолка; //у строк материалов указывается УИС продукции
			
		КонецЦикла;
		
		ЗаполнитьНомераПотолковВЗП(ЗаказПокупателя); //2019-02-04
		СозданЗП = Ложь;
		
		Попытка
			НачатьТранзакцию(); //открываем транзакцию, чтобы если в ЗнП не проставится ссылка на ЗП, ЗП - в базе не создается
			ЗаказПокупателя.Записать();
			
			//ТаблицаРезультат[ТекСтрока.ИндексИсходнойТаблицы].СсылкаЗаказПокупателя = ЗаказПокупателя.Ссылка;
			
			//ЗаписатьВИсторию("Создан заказ покупателя " + ЗаказПокупателя.Ссылка + ", для ЗнП " + ЗаказНаПроизводство);
			
			//Проставим основание в ЗнП
			ОбъектЗнП = ЗаказНаПроизводство.ПолучитьОбъект();
			ОбъектЗнП.ДокументОснование = ЗаказПокупателя.Ссылка;
			// запись в режиме обмена
			ОбъектЗнП.ОбменДанными.Загрузка = Истина;
			//Попытка
			ОбъектЗнП.Записать();
			ЗафиксироватьТранзакцию();
			СозданЗП = Истина;
			//Исключение
			//	//В принципе не должно быть таких ситуаций
			//	ЗаписатьВИсторию("Ошибка обновления " + ЗаказНаПроизводство + ": " + ОписаниеОшибки(), Истина);
			//	// распроводим заказ покупателя, если не смогли сохранить ЗНП
			//	ЗаказПокупателя.Записать(РежимЗаписиДокумента.ОтменаПроведения);
			//КонецПопытки;
		Исключение
			ОтменитьТранзакцию();
			ТекстОшибки = "Не удалось создать заказ покупателя для ЗнП " + ЗаказНаПроизводство + ": " + ОписаниеОшибки();
			ЗаписатьОшибкуВЖурнал(ТекстОшибки, ЗаказНаПроизводство);
			//ЗаписатьВИсторию("Не удалось создать заказ покупателя для ЗнП " + ЗаказНаПроизводство + ": " + ОписаниеОшибки(), Истина);
		КонецПопытки;
		
		Если ЗаказНаПроизводство.Проведен И СозданЗП Тогда
			Попытка
				ЗаказПокупателя.Записать(РежимЗаписиДокумента.Проведение);
				//ЗаписатьВИсторию("Проведен заказ покупателя " + ЗаказПокупателя.Ссылка + ", для ЗнП " + ЗаказНаПроизводство);	
				
				//дополнительная обработка для обновления статуса В работе на Выполнен
				ОбновлениеИнформационнойБазыПотолки.ПоместитьВРегистрКОбработке("2.0.0.1", ЗаказПокупателя.Ссылка, ЗаказПокупателя.Дата);
			Исключение
				ТекстОшибки = "Ошибка проведения заказа покупателя " + ЗаказПокупателя.Ссылка + ", для ЗнП " + ЗаказНаПроизводство;
				ЗаписатьОшибкуВЖурнал(ТекстОшибки, ЗаказПокупателя.Ссылка);
				//ЗаписатьВИсторию(ТекстОшибки, Истина);				
			КонецПопытки;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат СозданЗП;
	
КонецФункции

Процедура ЗаменитьОснованиеНаЗаказПокупателя(РеквизитОснование, ЗаказПокупателя)
	Если ЗначениеЗаполнено(ЗаказПокупателя) 
		И ТипЗнч(ЗаказПокупателя) = Тип("ДокументСсылка.ЗаказПокупателя") Тогда 
		РеквизитОснование = ЗаказПокупателя;
	КонецЕсли;
КонецПроцедуры

Функция ВыполнитьКорректировкиНаСервере(ШагКорректировки, МассивЗНП)
	//https://help.smartceilings.ru/ru/ticket_list/detail/3058/list/open/department/5#/
	//
	//Процедура КОРРЕКТИРОВКА, 
	//(выполняется Оставляя их состояние прежним (проведен,записан, помечен на удаление))
	
	СтруктураОтвета = Новый Структура;
	СтруктураОтвета.Вставить("Успешно", Ложь);
	СтруктураОтвета.Вставить("ОписаниеОшибки", "");
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("МассивОснований", МассивЗНП);
	Запрос.УстановитьПараметр("КорректировкаПоСписку", Истина);
	
	Если ШагКорректировки = 2 Тогда
		//КОРРЕКТИРОВКА РТИУ
		//в РТИУ меняем основание на ЗП, в табличной части ссылки
		МенеджерВТ = Новый МенеджерВременныхТаблиц;
		ПолучитьЗНПКОбработке(МенеджерВТ);
		Запрос.МенеджерВременныхТаблиц = МенеджерВТ;	
