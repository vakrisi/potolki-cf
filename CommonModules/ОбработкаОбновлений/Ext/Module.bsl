Функция Обработка_2_0_0_S3(СсылкаДокумент) Экспорт
	
	РезультатОбработки = Новый Структура;
	РезультатОбработки.Вставить("Успешно", Истина);
	РезультатОбработки.Вставить("ОписаниеОшибки", "");
	
	Если ТипЗнч(СсылкаДокумент) = Тип("ДокументСсылка.ЗаказПокупателя") Тогда	
		
		ДокОбъект = СсылкаДокумент.ПолучитьОбъект();
		ТоварыДокумента = ДокОбъект.Товары.Выгрузить();
		ТоварыРаспределение = ТоварыДокумента.СкопироватьКолонки();
		
		СтруктураПараметров = Новый Структура;
		СтруктураПараметров.Вставить("Основание", ДокОбъект.Основание);
		СтруктураПараметров.Вставить("Ссылка", ДокОбъект.Ссылка);
		СтруктураПараметров.Вставить("УчетОбеспеченностиРозницыПоКомнатам", ДокОбъект.СозданПриИспользованииНастройкиУчетОбеспеченностиРозницыПоКомнатам);
		
		ОбработкаТабличныхЧастейСервер.РаспределитьПоПотребностиЗаказДоговора(ТоварыДокумента, ТоварыРаспределение, СтруктураПараметров);
		ДокОбъект.Товары.Очистить();
		Для каждого СтрокаТЗ из ТоварыРаспределение Цикл
			НоваяСтрока = ДокОбъект.Товары.Добавить();
