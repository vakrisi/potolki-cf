Функция Обработка_2_0_0_S5(СсылкаДокумент) Экспорт
	
	РезультатОбработки = Новый Структура;
	РезультатОбработки.Вставить("Успешно", Ложь);
	РезультатОбработки.Вставить("ОписаниеОшибки", "");
	
	Если ТипЗнч(СсылкаДокумент) = Тип("ДокументСсылка.ЗаказНаПроизводство") Тогда
		
		Если СсылкаДокумент.ВидЗаказа = Перечисления.ВидыЗаказовНаПроизводство.ПроизводствоПотолка Тогда
			
			Если ТипЗнч(СсылкаДокумент.ДокументОснование) = Тип("ДокументСсылка.ЗаказПокупателя") И ЗначениеЗаполнено(СсылкаДокумент.ДокументОснование) Тогда
				
				//в самом ЗНП заполним ПродукцияУИСтроки и УИСтрокиМатериалов, если они не заполнены
				РезультатОбработкиЗНП = ЗаполнитьУИСтрокВЗНП(СсылкаДокумент);
				Если НЕ РезультатОбработкиЗНП.Успешно Тогда
					РезультатОбработки.Успешно = Ложь;
					РезультатОбработки.ОписаниеОшибки = РезультатОбработкиЗНП.ОписаниеОшибки;
					Возврат РезультатОбработки;
				КонецЕсли;
				
				//Нужно проверить наличие потолка в ЗП
				ЕстьПотолок = Ложь;
				Для Каждого ТекСтр Из СсылкаДокумент.ДокументОснование.Товары Цикл
					Если ТекСтр.Номенклатура = СсылкаДокумент.ПродукцияНоменклатура Тогда
						ЕстьПотолок = Истина;
						Прервать;
					КонецЕсли;	
				КонецЦикла;
				
				Если ЕстьПотолок Тогда
					ЗП = СсылкаДокумент.ДокументОснование.ПолучитьОбъект();
					//Если есть перенесем материалы
					Для Каждого Материал Из СсылкаДокумент.Материалы Цикл
						НоваяСтрока = ЗП.Материалы.Добавить();
						ЗаполнитьЗначенияСвойств(НоваяСтрока, Материал);
						НоваяСтрока.Потолок = СсылкаДокумент.ПродукцияНоменклатура;
						НоваяСтрока.ЗагруженоИзПостроителя = Истина;
					КонецЦикла;
					
					//так же укажем УИСТроки и УИСТрокиРодителя самого потолка в товарах ЗаказаПокупателя
					Для Каждого Товар Из ЗП.Товары Цикл
						Если Товар.Номенклатура = СсылкаДокумент.ПродукцияНоменклатура Тогда
							Товар.УИСтроки = СсылкаДокумент.ПродукцияУИСтроки;
							Товар.УИСтрокиРодителя = Товар.УИСтроки;
						КонецЕсли;
					КонецЦикла;
					
					Попытка
						ЗП.ОбменДанными.Загрузка = Истина;
						ЗП.Записать();
					Исключение
						РезультатОбработки.Успешно = Ложь;
						РезультатОбработки.ОписаниеОшибки = "При заполнении материалов в ЗП по ЗнП: " + ОписаниеОшибки();
						Возврат РезультатОбработки;
					КонецПопытки;	
				КонецЕсли;	
				
			КонецЕсли;
			
		ИначеЕсли СсылкаДокумент.ВидЗаказа = Перечисления.ВидыЗаказовНаПроизводство.ТиповоеПроизводство Тогда
			
			Если ТипЗнч(СсылкаДокумент.ДокументОснование) = Тип("ДокументСсылка.ЗаказПокупателя") И ЗначениеЗаполнено(СсылкаДокумент.ДокументОснование) Тогда
				
				//в самом ЗНП заполним ПродукцияУИСтроки и УИСтрокиМатериалов, если они не заполнены
				РезультатОбработкиЗНП = ЗаполнитьУИСтрокВЗНП(СсылкаДокумент);
				Если НЕ РезультатОбработкиЗНП.Успешно Тогда
					РезультатОбработки.Успешно = Ложь;
					РезультатОбработки.ОписаниеОшибки = РезультатОбработкиЗНП.ОписаниеОшибки;
					Возврат РезультатОбработки;
				КонецЕсли;
				
				ЗП = СсылкаДокумент.ДокументОснование.ПолучитьОбъект();
				
				//заполним УИСТроки и УИСТрокиРодителя товаров из продукции типового производства
				Для Каждого Товар Из ЗП.Товары Цикл
					Если ПустаяСтрока(Товар.УИСтроки) и ПустаяСтрока(Товар.УИСтрокиРодителя) Тогда 
						
						Отбор = Новый Структура;
						Отбор.Вставить("Номенклатура", Товар.Номенклатура);
						НайденныеСтрокиПродукции = СсылкаДокумент.Продукция.НайтиСтроки(Отбор);
						Если НайденныеСтрокиПродукции.Количество() > 0 Тогда
							Товар.УИСтроки = НайденныеСтрокиПродукции[0].УИСтроки;
							Товар.УИСтрокиРодителя = Товар.УИСтроки;
						КонецЕсли;
						
					КонецЕсли;
				КонецЦикла;
				
				//перенесем материалы
				Для Каждого Материал Из СсылкаДокумент.Материалы Цикл
					НоваяСтрока = ЗП.Материалы.Добавить();
					ЗаполнитьЗначенияСвойств(НоваяСтрока, Материал);
					
					Отбор = Новый Структура;
					Отбор.Вставить("УИСтроки",НоваяСтрока.УИСтроки);
					СтрокаПродукцииВЗП = ЗП.Товары.НайтиСтроки(Отбор);
					Если СтрокаПродукцииВЗП.Количество() > 0 Тогда
						НоваяСтрока.Потолок = СтрокаПродукцииВЗП[0].Номенклатура;
					КонецЕсли;
					НоваяСтрока.ЗагруженоИзПостроителя = Истина;
					
				КонецЦикла;
				
				Попытка
					ЗП.ОбменДанными.Загрузка = Истина;
					ЗП.Записать();
				Исключение
					РезультатОбработки.Успешно = Ложь;
					РезультатОбработки.ОписаниеОшибки = "При заполнении материалов в ЗП по ЗнП: " + ОписаниеОшибки();
					Возврат РезультатОбработки;
				КонецПопытки;	
				
			КонецЕсли;	
			
		КонецЕсли;		
		
	КонецЕсли;
	
	РезультатОбработки.Успешно = Истина;
	Возврат РезультатОбработки;
	
КонецФункции

