				СтрокаТЧ.ВариантОпределенияОтветственности = Перечисления.ВариантыОпределенияОтветственностиПоВозвратам.РучноеУказание;
				ТребуетсяЗаписьДокумента = Истина;
			КонецЕсли;
			
			// ПередЗаписью отработает очистка полей
			Если НЕ ДокОбъект.БракПроизводства 
				И (ЗначениеЗаполнено(СтрокаТЧ.ВариантОпределенияОтветственности)
				ИЛИ ЗначениеЗаполнено(СтрокаТЧ.Ответственность)) 
				Тогда
				ТребуетсяЗаписьДокумента = Истина;
			КонецЕсли;
			
			// ПередЗаписью отработает очистка полей
			Если НЕ ДокОбъект.ПриходоватьТоварНаСклад 
				И (ЗначениеЗаполнено(СтрокаТЧ.ВариантОпределенияСебестоимости)
				ИЛИ ЗначениеЗаполнено(СтрокаТЧ.Себестоимость)) 
				Тогда
				ТребуетсяЗаписьДокумента = Истина;
			КонецЕсли;
			
		КонецЦикла;
		
		Если ТребуетсяЗаписьДокумента Тогда
			
			Попытка				
				ДокОбъект.ДополнительныеСвойства.Вставить("ПропуститьПроверкуЗапретаИзменения", Истина);
				ДокОбъект.Записать();
				
