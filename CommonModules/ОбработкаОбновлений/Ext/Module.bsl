#Область Обработка_2_0_1_0

Функция Обработка_2_0_1_0(СсылкаДокумент) Экспорт
	
	РезультатОбработки = Новый Структура;
	РезультатОбработки.Вставить("Успешно", Ложь);
	РезультатОбработки.Вставить("ОписаниеОшибки", "");
	
	//Нужно заполнить новое измерение Документ начисления в 2х Регистрах накопления
	
	Если ТипЗнч(СсылкаДокумент) = Тип("ДокументСсылка.Монтаж") 
		ИЛИ ТипЗнч(СсылкаДокумент) = Тип("ДокументСсылка.ЗаказПокупателя")
		ИЛИ ТипЗнч(СсылкаДокумент) = Тип("ДокументСсылка.Лид")
		ИЛИ ТипЗнч(СсылкаДокумент) = Тип("ДокументСсылка.РеализацияТоваровИУслуг")
		ИЛИ ТипЗнч(СсылкаДокумент) = Тип("ДокументСсылка.Штраф") 
		Тогда
		
		НаборЗаписей = РегистрыНакопления.ВыработкаИсполнителейРозницы.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Регистратор.Установить(СсылкаДокумент);
		НаборЗаписей.Прочитать();
		Если НаборЗаписей.Количество() Тогда
			Для каждого Движение из НаборЗаписей Цикл
				Движение.ОбъектВыработки	= СсылкаДокумент;
			КонецЦикла;
			
			Попытка
				НаборЗаписей.Записать();
				РезультатОбработки.Успешно = Истина;
			Исключение
				РезультатОбработки.Успешно = Ложь;
				РезультатОбработки.ОписаниеОшибки = ОписаниеОшибки();
			КонецПопытки;
			
		Иначе
			РезультатОбработки.Успешно = Истина;
		КонецЕсли;
		
	КонецЕсли;
	
	// не помещать в ИначеЕсли
	// потому что есть пересекающиеся виды документов
	Если ТипЗнч(СсылкаДокумент) = Тип("ДокументСсылка.ЗаказПокупателя") 
		ИЛИ ТипЗнч(СсылкаДокумент) = Тип("ДокументСсылка.ВыпускПродукции")
		ИЛИ ТипЗнч(СсылкаДокумент) = Тип("ДокументСсылка.РеализацияТоваровИУслуг") 
		ИЛИ ТипЗнч(СсылкаДокумент) = Тип("ДокументСсылка.Штраф")
		Тогда
		
		НаборЗаписей = РегистрыНакопления.ВыработкаИсполнителейПроизводства.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Регистратор.Установить(СсылкаДокумент);
		НаборЗаписей.Прочитать();
		Если НаборЗаписей.Количество() Тогда
			Для каждого Движение из НаборЗаписей Цикл
				Движение.ОбъектВыработки	= СсылкаДокумент;
			КонецЦикла;
			
			Попытка
				НаборЗаписей.Записать();
				РезультатОбработки.Успешно = Истина;
			Исключение
				РезультатОбработки.Успешно = Ложь;
				РезультатОбработки.ОписаниеОшибки = ОписаниеОшибки();
			КонецПопытки;
			
		Иначе
			РезультатОбработки.Успешно = Истина;
		КонецЕсли;	
	КонецЕсли;
	
	
	Если ТипЗнч(СсылкаДокумент) = Тип("ДокументСсылка.УстановкаСтоимостиВыработкиПоНоменклатуре") Тогда
		
		ДокОбъект = СсылкаДокумент.ПолучитьОбъект();		
		
		Для Каждого ТекущаяСтрока Из ДокОбъект.ВыработкаПоВидамНоменклатуры Цикл
			Если ТекущаяСтрока.ОтПрибыли Тогда
				ТекущаяСтрока.ОтПрибыли = Ложь;				
			КонецЕсли;	
		КонецЦикла;	
		Для Каждого ТекущаяСтрока Из ДокОбъект.ВыработкаПоНоменклатуре Цикл
			Если ТекущаяСтрока.ОтПрибыли Тогда
				ТекущаяСтрока.ОтПрибыли = Ложь;				
			КонецЕсли;	
		КонецЦикла;		
		
		Попытка		
			ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);		
			РезультатОбработки.Успешно = Истина;
		Исключение
			РезультатОбработки.Успешно = Ложь;
			РезультатОбработки.ОписаниеОшибки = ОписаниеОшибки();
		КонецПопытки;		
		
	ИначеЕсли ТипЗнч(СсылкаДокумент) = Тип("ДокументСсылка.Лид") Тогда
		
		// Замеры в документе Лид у которых реквизит Отменен был = ИСТИНА и результат замера был пустой, проставить значение реквизита "РезультатЗамера" = "Замер отменен"
		// UPD: + Все лиды, по которым есть замеры
		ДокОбъект = СсылкаДокумент.ПолучитьОбъект();		
		
		Для Каждого ТекущаяСтрока Из ДокОбъект.Замеры Цикл
			Если ТекущаяСтрока.УДАЛИТЬ_Отменен И ТекущаяСтрока.РезультатЗамера = Справочники.РезультатЗамераЛида.ПустаяСсылка() Тогда
				ТекущаяСтрока.РезультатЗамера = Справочники.РезультатЗамераЛида.ЗамерОтменен;
			КонецЕсли;	
		КонецЦикла;		
		
		Попытка		
			ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);		
			РезультатОбработки.Успешно = Истина;
		Исключение
			РезультатОбработки.Успешно = Ложь;
			РезультатОбработки.ОписаниеОшибки = ОписаниеОшибки();
		КонецПопытки;
		
	ИначеЕсли ТипЗнч(СсылкаДокумент) = Тип("ДокументСсылка.ВозвратТовараПоставщику")
		ИЛИ ТипЗнч(СсылкаДокумент) = Тип("ДокументСсылка.ЗаказПокупателя")
		ИЛИ ТипЗнч(СсылкаДокумент) = Тип("ДокументСсылка.ЗаказПоставщику")
		ИЛИ ТипЗнч(СсылкаДокумент) = Тип("ДокументСсылка.ПоступлениеТоваровИУслуг")
		Тогда		
		
		// Новое измерение "КоличествоПоФакту" в РН ОбеспечениеЗаказовРозницы
		// Перепроводим
		
		ДокОбъект = СсылкаДокумент.ПолучитьОбъект();
		
		// Отдельно для Заказа покупателя
		Если ТипЗнч(СсылкаДокумент) = Тип("ДокументСсылка.ЗаказПокупателя") Тогда
			Если СсылкаДокумент.ТекущийСтатус = Справочники.СтатусыЗаказовПокупателей.Закрыт И СсылкаДокумент.ДатаЗакрытия = Дата(1,1,1) Тогда
				СсылкаДокумент.ДатаЗакрытия = СсылкаДокумент.Дата;
			КонецЕсли;
		КонецЕсли;
		
		Попытка		
			ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);		
			РезультатОбработки.Успешно = Истина;
		Исключение
			РезультатОбработки.Успешно = Ложь;
			РезультатОбработки.ОписаниеОшибки = ОписаниеОшибки();
		КонецПопытки;	
		
	ИначеЕсли ТипЗнч(СсылкаДокумент) = Тип("ДокументСсылка.Монтаж") Тогда
		
		// заполнение реквизита СлужебныйКоличествоКСписаниюНеСоответствуетКоличествуПроданного для документа Монтаж
		// #4679 При обновлении программы на данную версию проверять движения монтажей по складам. 
		// Если движения по складам у монтажа делалось по колонке "КоличествоКСписанию", то таким монтажам взводить флаг. 
		// Если у монтажа нет движений, но константа включена, то таким монтажам тоже взводить флаг.
		
		ДокОбъект = СсылкаДокумент.ПолучитьОбъект();
		ТребуетсяЗаписьДокумента = Ложь;
		
		НаборЗаписей = РегистрыНакопления.ТоварыНаСкладах.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Регистратор.Установить(СсылкаДокумент);
		НаборЗаписей.Прочитать();
		Если НаборЗаписей.Количество() = 0 Тогда
			Если ПолучитьФункциональнуюОпцию("КоличествоТоваровКСписаниюВРозницеНеСоответствуетКоличествуПроданногоТовара") Тогда
				ДокОбъект.СлужебныйКоличествоКСписаниюНеСоответствуетКоличествуПроданного = Истина;
				ТребуетсяЗаписьДокумента = Истина;
			Иначе
				//обработка документа не требуется, убираем из очереди
				РезультатОбработки.Успешно = Истина; 			
			КонецЕсли;
			
		Иначе
			Для каждого Движение из НаборЗаписей Цикл
				СтруктураОтбора = Новый Структура("Номенклатура, ХарактеристикаНоменклатуры, СерияНоменклатуры", Движение.Номенклатура, Движение.ХарактеристикаНоменклатуры, Движение.СерияНоменклатуры);
				НайденныеСтроки = ДокОбъект.ТоварыУслуги.НайтиСтроки(СтруктураОтбора);
				Для каждого СтрокаТЧ из НайденныеСтроки Цикл
					ПланКоличество = СтрокаТЧ.Количество * СтрокаТЧ.Коэффициент;	
					ПланКоличествоКСписанию = СтрокаТЧ.КоличествоКСписанию * СтрокаТЧ.Коэффициент;
					Если Движение.Количество = ПланКоличествоКСписанию И НЕ Движение.Количество = ПланКоличество Тогда
						ДокОбъект.СлужебныйКоличествоКСписаниюНеСоответствуетКоличествуПроданного = Истина;
						ТребуетсяЗаписьДокумента = Истина;
						Прервать;
					КонецЕсли;
				КонецЦикла;
				
				Если ТребуетсяЗаписьДокумента Тогда
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;		
		
		Если ТребуетсяЗаписьДокумента Тогда
			Попытка		
				ДокОбъект.Записать();		
				РезультатОбработки.Успешно = Истина;
			Исключение
				РезультатОбработки.Успешно = Ложь;
				РезультатОбработки.ОписаниеОшибки = ОписаниеОшибки();
			КонецПопытки;
		Иначе
			//обработка документа не требуется, убираем из очереди
			РезультатОбработки.Успешно = Истина;
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(СсылкаДокумент) = Тип("ДокументСсылка.ВозвратТовараОтПокупателя") Тогда
		
		// #4425 
		//При обновлении клиента на задачу проверить все возвраты и заполнить в них колонку "Вариант распределения". 
		//Если в строке указана РТиУ, то ставить вариант "По реализации", если не указана то вариант - "Ручное указание".
		
		//При обновлении на задачу проверить все возвраты от покупателя, у которых есть строки с указанным ЗП но пустой РТиУ. 
		//В таких возвратах подставить РТИУ как в п. 8. А если не получилось найти РтИУ, документ так и должен болтаться в очереди к обработке после обновления.
		
		ДокОбъект = СсылкаДокумент.ПолучитьОбъект();
		Для Каждого СтрокаТабличнойЧасти Из ДокОбъект.Товары Цикл
			СтрокаТабличнойЧасти.ВариантОпределенияСебестоимости = ?(ЗначениеЗаполнено(СтрокаТабличнойЧасти.ДокументПродажи), Перечисления.ВариантыОпределенияСебестоимостиПоВозвратам.ПоДокументуПродажи, Перечисления.ВариантыОпределенияСебестоимостиПоВозвратам.РучноеУказание);
		КонецЦикла;
		Попытка		
			ДокОбъект.Записать();		
			РезультатОбработки.Успешно = Истина;
		Исключение
			РезультатОбработки.Успешно = Ложь;
			РезультатОбработки.ОписаниеОшибки = ОписаниеОшибки();
		КонецПопытки;
		
		ТребуетсяЗаписьДокумента = Ложь;
		Для Каждого СтрокаТабличнойЧасти Из ДокОбъект.Товары Цикл
			Если ЗначениеЗаполнено(СтрокаТабличнойЧасти.ЗаказПокупателя) И НЕ ЗначениеЗаполнено(СтрокаТабличнойЧасти.ДокументПродажи) Тогда
				СписокРеализацийПоЗаказу = Новый СписокЗначений;
				ПодготовитьСписокРеализацийПоЗаказуДляВозврата(СсылкаДокумент, СтрокаТабличнойЧасти.ЗаказПокупателя, СтрокаТабличнойЧасти.Номенклатура, СтрокаТабличнойЧасти.ХарактеристикаНоменклатуры, СтрокаТабличнойЧасти.СерияНоменклатуры, СписокРеализацийПоЗаказу);	
				Если СписокРеализацийПоЗаказу.Количество() > 0 Тогда
					СтрокаТабличнойЧасти.ДокументПродажи = СписокРеализацийПоЗаказу.Получить(0);
					ТребуетсяЗаписьДокумента = Истина;
				Иначе
					РезультатОбработки.Успешно = Ложь;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		
		Если ТребуетсяЗаписьДокумента Тогда
			Попытка		
				ДокОбъект.Записать();		
				РезультатОбработки.Успешно = Истина;
			Исключение
				РезультатОбработки.Успешно = Ложь;
				РезультатОбработки.ОписаниеОшибки = ОписаниеОшибки();
			КонецПопытки;
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(СсылкаДокумент) = Тип("ДокументСсылка.ВозвратТовараОтПокупателя") Тогда
		
		ДокОбъект = СсылкаДокумент.ПолучитьОбъект();
		Для каждого СтрокаМатериалов из ДокОбъект.Материалы Цикл
			Если СтрокаМатериалов.Номенклатура = Справочники.Номенклатура.ОстаткиПленки
				И СтрокаМатериалов.ЕдиницаИзмерения = Справочники.ЕдиницыИзмерений.ПустаяСсылка() Тогда
				
				СтрокаМатериалов.ЕдиницаИзмерения = СтрокаМатериалов.Номенклатура.БазоваяЕдиницаИзмерения;
				СтрокаМатериалов.Количество = СтрокаМатериалов.Количество * СтрокаМатериалов.Коэффициент;
				СтрокаМатериалов.Коэффициент = 1;
				
			КонецЕсли;
		КонецЦикла;
		Попытка		
			ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);		
			РезультатОбработки.Успешно = Истина;
		Исключение
			РезультатОбработки.Успешно = Ложь;
			РезультатОбработки.ОписаниеОшибки = ОписаниеОшибки();
		КонецПопытки;
		
		// выпуски с ОстатокПленки
	ИначеЕсли ТипЗнч(СсылкаДокумент) = Тип("ДокументСсылка.ВыпускПродукции") Тогда
		РезВыпуск = Отчеты.ЭкспрессПроверкаУчета.ИсправитьОбъект_КорректировкаИспользованияОстатковПленкиМатериалаЗаказчика(СсылкаДокумент);
		ЗаполнитьЗначенияСвойств(РезультатОбработки, РезВыпуск);  		 
		
		// документы оплаты для переноса реквизита "УДАЛИТЬ_Основание"	
	ИначеЕсли ТипЗнч(СсылкаДокумент) = Тип("ДокументСсылка.ПриходныйКассовыйОрдер") 
		ИЛИ ТипЗнч(СсылкаДокумент) = Тип("ДокументСсылка.ОплатаБанковскойКартой") Тогда
		
		ДокОбъект = СсылкаДокумент.ПолучитьОбъект();
		Если ЗначениеЗаполнено(ДокОбъект.УДАЛИТЬ_Основание) Тогда
			ДокОбъект.ДобавитьОснование(ДокОбъект.УДАЛИТЬ_Основание); // вызываем процедуру из модуля объекта
			ДокОбъект.УДАЛИТЬ_Основание = Неопределено;
			Попытка		
				ДокОбъект.Записать();		
				РезультатОбработки.Успешно = Истина;
			Исключение
				РезультатОбработки.Успешно = Ложь;
				РезультатОбработки.ОписаниеОшибки = ОписаниеОшибки();
			КонецПопытки;
		Иначе
			РезультатОбработки.Успешно = Истина;
		КонецЕсли;
		
	КонецЕсли;
	
	// отдельная обработка: в документе "Оплата банковской картой" заполняем новый реквизит ВидОперации
	Если ТипЗнч(СсылкаДокумент) = Тип("ДокументСсылка.ОплатаБанковскойКартой") Тогда
		
		ДокОбъект = СсылкаДокумент.ПолучитьОбъект();	
		
		Попытка
			ДокОбъект.ВидОперации = Перечисления.ВидыОперацийОплатаБанковскойКартой.ОплатаБанковскойКартой;
			ДокОбъект.Записать();
			РезультатОбработки.Успешно = Истина;
		Исключение
			РезультатОбработки.Успешно = Ложь;
			РезультатОбработки.ОписаниеОшибки = ОписаниеОшибки();
		КонецПопытки;		
		
	КонецЕсли;
	
	Возврат РезультатОбработки;
	
КонецФункции

Процедура ПодготовитьСписокРеализацийПоЗаказуДляВозврата(ВозвратСсылка, ЗаказПокупателя, Номенклатура, ХарактеристикаНоменклатуры, СерияНоменклатуры, СписокРеализацийПоЗаказу) 
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ПродажиОбороты.Номенклатура КАК Номенклатура,
	|	ПродажиОбороты.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	|	ПродажиОбороты.СерияНоменклатуры КАК СерияНоменклатуры,
	|	ПродажиОбороты.ДокументПродажи КАК ДокументПродажи,
	|	ПродажиОбороты.ЗаказПокупателя КАК ЗаказПокупателя,
	|	СУММА(ПродажиОбороты.КоличествоОборот) КАК Количество
	|ПОМЕСТИТЬ ВТ
	|ИЗ
	|	РегистрНакопления.Продажи.Обороты(, , Регистратор, ) КАК ПродажиОбороты
	|ГДЕ
	|	ПродажиОбороты.Регистратор <> &Регистратор
	|	И ПродажиОбороты.ЗаказПокупателя = &ЗаказПокупателя
	|	И ПродажиОбороты.Номенклатура = &Номенклатура
	|	И ПродажиОбороты.ХарактеристикаНоменклатуры = &ХарактеристикаНоменклатуры
	|	И ПродажиОбороты.СерияНоменклатуры = &СерияНоменклатуры
	|
	|СГРУППИРОВАТЬ ПО
	|	ПродажиОбороты.Номенклатура,
	|	ПродажиОбороты.ХарактеристикаНоменклатуры,
	|	ПродажиОбороты.СерияНоменклатуры,
	|	ПродажиОбороты.ДокументПродажи,
	|	ПродажиОбороты.ЗаказПокупателя
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ.ДокументПродажи КАК ДокументПродажи
	|ИЗ
	|	ВТ КАК ВТ
	|ГДЕ
	|	ВТ.Количество > 0
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ.ДокументПродажи";
	
	Запрос.УстановитьПараметр("Регистратор", ВозвратСсылка);
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("ХарактеристикаНоменклатуры", ХарактеристикаНоменклатуры);
	Запрос.УстановитьПараметр("СерияНоменклатуры", СерияНоменклатуры);
	Запрос.УстановитьПараметр("ЗаказПокупателя", ЗаказПокупателя);
	ТаблицаПродаж = Запрос.Выполнить().Выгрузить();
	СписокРеализацийПоЗаказу.ЗагрузитьЗначения(ТаблицаПродаж.ВыгрузитьКолонку("ДокументПродажи"));	
	
КонецПроцедуры

#КонецОбласти

#Область Обработка_2_0_2_0

Функция Обработка_2_0_2_0(СсылкаДокумент) Экспорт
	
	РезультатОбработки = Новый Структура;
	РезультатОбработки.Вставить("Успешно", Ложь);
	РезультатОбработки.Вставить("ОписаниеОшибки", "");
	
	//#5768
	Если ТипЗнч(СсылкаДокумент) = Тип("ДокументСсылка.ЗаказПокупателя") 
		ИЛИ ТипЗнч(СсылкаДокумент) = Тип("ДокументСсылка.ЗаказНаПроизводство") Тогда
		
		ДокОбъект = СсылкаДокумент.ПолучитьОбъект();		
		ТребуетсяЗапись = Ложь;
		
		Для Каждого ТекущаяСтрока Из ДокОбъект.Материалы Цикл
			Если (ТекущаяСтрока.Номенклатура = Справочники.Номенклатура.ОстаткиПленки
				ИЛИ ТекущаяСтрока.Номенклатура = Справочники.Номенклатура.ПолотноЗаказчика)
				И НЕ ТекущаяСтрока.ЕдиницаИзмерения = ТекущаяСтрока.Номенклатура.БазоваяЕдиницаИзмерения
				Тогда
				ТекущаяСтрока.ЕдиницаИзмерения = ТекущаяСтрока.Номенклатура.БазоваяЕдиницаИзмерения;
				ТекущаяСтрока.Количество = ТекущаяСтрока.Количество * ТекущаяСтрока.Коэффициент;
				ТекущаяСтрока.Коэффициент = 1;
				ТребуетсяЗапись = Истина;
			КонецЕсли;	
		КонецЦикла;		
		
		Если ТребуетсяЗапись Тогда
			Попытка	
				Если ДокОбъект.Проведен Тогда
					ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);		
					РезультатОбработки.Успешно = Истина;
				Иначе
					ДокОбъект.Записать();		
					РезультатОбработки.Успешно = Истина;
				КонецЕсли;
			Исключение
				РезультатОбработки.Успешно = Ложь;
				РезультатОбработки.ОписаниеОшибки = ОписаниеОшибки();
			КонецПопытки;
		Иначе
			РезультатОбработки.Успешно = Истина;
		КонецЕсли;
	КонецЕсли;
	
	//#5456
	Если ТипЗнч(СсылкаДокумент) = Тип("ДокументСсылка.ЗаказДоговор") Тогда
		
		//ДокОбъект = СсылкаДокумент.ПолучитьОбъект();		
		//ДокОбъект.СлужебныйОбеспечениеПоДокументу = Истина;
		//		
		//Попытка	
		//	ДокОбъект.Записать();		
		//	РезультатОбработки.Успешно = Истина;
		//Исключение
		//	РезультатОбработки.Успешно = Ложь;
		//	РезультатОбработки.ОписаниеОшибки = ОписаниеОшибки();
		//КонецПопытки;
		
	КонецЕсли;
	
	Возврат РезультатОбработки;
	
КонецФункции

#КонецОбласти

#Область Обработка_2_0_3_0

Функция Обработка_2_0_3_0(СсылкаДокумент) Экспорт
	
	РезультатОбработки = Новый Структура;
	РезультатОбработки.Вставить("Успешно", Ложь);
	РезультатОбработки.Вставить("ОписаниеОшибки", "");
	
	// ВНИМАНИЕ!!! не помещать в ИначеЕсли
	// потому что есть пересекающиеся виды документов
	//Нужно заполнить новое измерение "Контрагент" в регистре накопления "РасчетыПоЗаказам"
	МонтажОбработанУспешно = Истина;
	РеализацияОбработанаУспешно = Истина;
	ПоступлениеОбработаноУспешно = Истина;
	Если ТипЗнч(СсылкаДокумент) = Тип("ДокументСсылка.ЗаказДоговор")
		ИЛИ ТипЗнч(СсылкаДокумент) = Тип("ДокументСсылка.ЗаказНаПроизводство")
		ИЛИ ТипЗнч(СсылкаДокумент) = Тип("ДокументСсылка.ЗаказПокупателя")
		ИЛИ ТипЗнч(СсылкаДокумент) = Тип("ДокументСсылка.Замена")
		ИЛИ ТипЗнч(СсылкаДокумент) = Тип("ДокументСсылка.Монтаж")
		ИЛИ ТипЗнч(СсылкаДокумент) = Тип("ДокументСсылка.ОплатаБанковскойКартой")
		ИЛИ ТипЗнч(СсылкаДокумент) = Тип("ДокументСсылка.ПоступлениеНаРасчетныйСчет")
		ИЛИ ТипЗнч(СсылкаДокумент) = Тип("ДокументСсылка.ПриходныйКассовыйОрдер")
		ИЛИ ТипЗнч(СсылкаДокумент) = Тип("ДокументСсылка.РасходныйКассовыйОрдер")
		ИЛИ ТипЗнч(СсылкаДокумент) = Тип("ДокументСсылка.РеализацияТоваровИУслуг")
		ИЛИ ТипЗнч(СсылкаДокумент) = Тип("ДокументСсылка.СоглашениеОРасторженииДоговора")
		ИЛИ ТипЗнч(СсылкаДокумент) = Тип("ДокументСсылка.СписаниеСРасчетногоСчета")
		ИЛИ ТипЗнч(СсылкаДокумент) = Тип("ДокументСсылка.СчетНаОплату")
		Тогда
		
		НаборЗаписей = РегистрыНакопления.РасчетыПоЗаказам.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Регистратор.Установить(СсылкаДокумент);
		НаборЗаписей.Прочитать();
		Если НаборЗаписей.Количество() Тогда
			
			// Заполнение поля Контрагент зависит от типа документа
			Если ТипЗнч(СсылкаДокумент) = Тип("ДокументСсылка.Замена") Тогда
				КонтрагентВДокумент = СсылкаДокумент.Основание.Контрагент;
			ИначеЕсли ТипЗнч(СсылкаДокумент) = Тип("ДокументСсылка.СоглашениеОРасторженииДоговора") Тогда
				КонтрагентВДокумент = СсылкаДокумент.ЗаказДоговор.Контрагент;
			Иначе
				КонтрагентВДокумент = СсылкаДокумент.Контрагент;
			КонецЕсли;	
			
			Для каждого Движение из НаборЗаписей Цикл
				Движение.Контрагент	= КонтрагентВДокумент;
			КонецЦикла;
			
			Попытка
				НаборЗаписей.Записать();
				РезультатОбработки.Успешно = Истина;
			Исключение
				РезультатОбработки.Успешно = Ложь;
				РезультатОбработки.ОписаниеОшибки = ОписаниеОшибки();
				Если ТипЗнч(СсылкаДокумент) = Тип("ДокументСсылка.Монтаж") Тогда
					МонтажОбработанУспешно = Ложь;
				ИначеЕсли ТипЗнч(СсылкаДокумент) = Тип("ДокументСсылка.РеализацияТоваровИУслуг") Тогда
					РеализацияОбработанаУспешно = Ложь;
				ИначеЕсли ТипЗнч(СсылкаДокумент) = Тип("ДокументСсылка.ПоступлениеНаРасчетныйСчет") Тогда
					ПоступлениеОбработаноУспешно = Ложь;
				КонецЕсли;
			КонецПопытки;
			
		Иначе
			РезультатОбработки.Успешно = Истина;
		КонецЕсли;
		
	КонецЕсли;
	
	// №1842
	Если ТипЗнч(СсылкаДокумент) = Тип("ДокументСсылка.УстановкаСтоимостиВыработкиПоНоменклатуре") Тогда
		
		ДокОбъект = СсылкаДокумент.ПолучитьОбъект();
		
		// Галочки однофактурный и многофактурный
		Если ДокОбъект.ВидДокументаРасчета = Справочники.ВидыДокументовРасчетаВыработки.ВыпускПродукции
			И ДокОбъект.ВидНоменклатурыПотолка = Справочники.ВидыНоменклатуры.Потолок
			Тогда			
			ДокОбъект.ОднофактурныйПотолок = Истина;
			ДокОбъект.МногофактурныйПотолок = Истина;
		КонецЕсли;	
		
		Попытка	
			ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);		
			РезультатОбработки.Успешно = Истина;
		Исключение
			РезультатОбработки.Успешно = Ложь;
			РезультатОбработки.ОписаниеОшибки = ОписаниеОшибки();
		КонецПопытки;
		
	КонецЕсли;
	
	Поступление2ОбработаноУспешно = Истина;
	Если ТипЗнч(СсылкаДокумент) = Тип("ДокументСсылка.ПоступлениеНаРасчетныйСчет") Тогда
		
		Если НЕ СсылкаДокумент.УДАЛИТЬ_Оплачено Тогда
			
			// распроведение документов, у которых не стояла галочка "Оплачено".
			ДокОбъект = СсылкаДокумент.ПолучитьОбъект();
			Попытка	
				ДокОбъект.Записать(РежимЗаписиДокумента.ОтменаПроведения);		
				РезультатОбработки.Успешно = Истина;
			Исключение
				РезультатОбработки.Успешно = Ложь;
				Поступление2ОбработаноУспешно = Ложь;
				РезультатОбработки.ОписаниеОшибки = ОписаниеОшибки();
			КонецПопытки;
			
		КонецЕсли;	
		
	КонецЕсли;
	
	СписаниеОбработаноУспешно = Истина;
	Если ТипЗнч(СсылкаДокумент) = Тип("ДокументСсылка.СписаниеСРасчетногоСчета") Тогда
		
		// распроведение документов, у которых не стояла галочка "Оплачено".
		ДокОбъект = СсылкаДокумент.ПолучитьОбъект();
		Попытка
			РезультатОбработки.Успешно = Истина;
			Если НЕ ДокОбъект.УДАЛИТЬ_Оплачено Тогда
				ДокОбъект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
			КонецЕсли;
			
			// создадим документ ПлатежноеПоручениеИсходящее
			Если Год(ДокОбъект.Дата) = Год(ТекущаяДатаСеанса()) Тогда
				УстановитьПривилегированныйРежим(Истина);
				// в текущем обновлении документ "ДокументСсылка.СписаниеСРасчетногоСчета" обрабатывается по нескольким условиям
				// поэтому при нескольких неуспешных попытках, чтобы не было созданий нескольких ППИ, проверим наличие такого ППИ 
				ЗапросППИ = Новый Запрос; 
				ЗапросППИ.Текст = 
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	ПлатежноеПоручениеИсходящее.Ссылка КАК Ссылка
				|ИЗ
				|	Документ.ПлатежноеПоручениеИсходящее КАК ПлатежноеПоручениеИсходящее
				|ГДЕ
				|	ПлатежноеПоручениеИсходящее.Дата = &Дата
				|	И ПлатежноеПоручениеИсходящее.Номер = &Номер";
				
				ЗапросППИ.УстановитьПараметр("Дата",  ДокОбъект.Дата);
				ЗапросППИ.УстановитьПараметр("Номер", ДокОбъект.Номер);				
				Выборка = ЗапросППИ.Выполнить().Выбрать();
				ЕстьППИ = Ложь;
				Если Выборка.Следующий() Тогда
					ЕстьППИ = Истина;
				КонецЕсли;
				УстановитьПривилегированныйРежим(Ложь);
				
				Если НЕ ЕстьППИ Тогда
					ПлатежОбъект = Документы.ПлатежноеПоручениеИсходящее.СоздатьДокумент();
					ЗаполнитьЗначенияСвойств(ПлатежОбъект, ДокОбъект,
					"Дата, Номер, ПометкаУдаления, Валюта, ВидОперации, Договор, ИсхДата, ИсхНомер, Контрагент, НазначениеПлатежа, Организация, Подразделение, 
					| Статья, СтатьяРасходов, Сумма, Счет, СчетКонтрагента, 
					| ИдентификаторПлатежа, ПеречислениеВБюджет, СтатусСоставителя, КодБК, КодОКАТО, 
					| ПоказательОснования, ПоказательПериода, ПоказательНомера, ПоказательДаты, ПоказательТипа,
					| ТипПлатежногоДокумента, ОчередностьПлатежа,
					| СтавкаНДС, СуммаНДС, ПериодРегистрации"); //, ВидНачисления"); #6576 
					
					Для каждого ЭлементТЗ из ДокОбъект.ЗарплатаСотрудникам Цикл
						НоваяСтрока = ПлатежОбъект.ЗарплатаСотрудникам.Добавить();
						ЗаполнитьЗначенияСвойств(НоваяСтрока, ЭлементТЗ);
					КонецЦикла;
					Для каждого ЭлементТЗ из ДокОбъект.РаспределениеПлатежа Цикл
						НоваяСтрока = ПлатежОбъект.РаспределениеПлатежа.Добавить();
						ЗаполнитьЗначенияСвойств(НоваяСтрока, ЭлементТЗ);
					КонецЦикла;
					ПлатежОбъект.Записать();
					Если ДокОбъект.Проведен Тогда 
						Попытка	
							ПлатежОбъект.Записать(РежимЗаписиДокумента.Проведение);		
						Исключение
						КонецПопытки;
					КонецЕсли;
					
					ОбновитьНумерациюОбъектов(Метаданные.Документы.ПлатежноеПоручениеИсходящее);
				КонецЕсли;
			КонецЕсли;
			
		Исключение
			СписаниеОбработаноУспешно = Ложь;
			РезультатОбработки.Успешно = Ложь;
			РезультатОбработки.ОписаниеОшибки = ОписаниеОшибки();
		КонецПопытки;
	КонецЕсли;
	
	// #6361
	// перепроведение документов "РКО", у которых основание - заказ-договор с добавлением заказа в таблицу распределения.
	РКООбработаноУспешно = Истина;
	Если ТипЗнч(СсылкаДокумент) = Тип("ДокументСсылка.РасходныйКассовыйОрдер") Тогда		
		ДокОбъект = СсылкаДокумент.ПолучитьОбъект();
		РезультатОбработки.Успешно = Истина;
		Если ЗначениеЗаполнено(ДокОбъект.Основание) Тогда
			НайденныеСтроки = ДокОбъект.РаспределениеПлатежа.НайтиСтроки(Новый Структура("Документ", ДокОбъект.Основание));
			Если НайденныеСтроки.Количество() = 0 Тогда				
				НоваяСтрока = ДокОбъект.РаспределениеПлатежа.Добавить();	
				НоваяСтрока.Документ = ДокОбъект.Основание;
				НоваяСтрока.Сумма    = ДокОбъект.Сумма;				
				Попытка	
					ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);				
				Исключение
					РезультатОбработки.Успешно = Ложь;
					РезультатОбработки.ОписаниеОшибки = ОписаниеОшибки();
				КонецПопытки;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	// №6388 в ТЧ Услуги документа РТиУ добавлен реквизит "Характеристика номенклатуры"
	Реализация2ОбработанаУспешно = Истина;
	Если ТипЗнч(СсылкаДокумент) = Тип("ДокументСсылка.РеализацияТоваровИУслуг") Тогда
		
		ДокументОбъект = СсылкаДокумент.ПолучитьОбъект();
		
		РезультатОбработки.Успешно = Истина;
		
		ТребуетсяЗапись = Ложь;
		Для Каждого ТекущаяСтрока Из ДокументОбъект.Услуги Цикл
			Если ТипЗнч(ТекущаяСтрока.Заказ) = Тип("ДокументСсылка.ЗаказПокупателя") И НЕ ТекущаяСтрока.Заказ.Пустая() Тогда
				// Найдем позицию в ЗП
				НайденныеПозиции = ТекущаяСтрока.Заказ.Товары.НайтиСтроки(новый Структура("Номенклатура, Количество, Цена", ТекущаяСтрока.Номенклатура, ТекущаяСтрока.Количество, ТекущаяСтрока.Цена));
				Если НайденныеПозиции.Количество() > 0 Тогда
					Если НЕ НайденныеПозиции[0].ХарактеристикаНоменклатуры = Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка() Тогда
						ТекущаяСтрока.ХарактеристикаНоменклатуры = НайденныеПозиции[0].ХарактеристикаНоменклатуры;
						ТребуетсяЗапись = Истина;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;	
		КонецЦикла;
		
		Если ТребуетсяЗапись Тогда
			Попытка
				мРежимЗаписиДокумента = ?(ДокументОбъект.Проведен, РежимЗаписиДокумента.Проведение, РежимЗаписиДокумента.Запись);
				ДокументОбъект.Записать(мРежимЗаписиДокумента);
			Исключение
				РезультатОбработки.Успешно = Ложь;
				РезультатОбработки.ОписаниеОшибки = ОписаниеОшибки();
				Реализация2ОбработанаУспешно = Ложь;
			КонецПопытки;
		КонецЕсли;
		
	КонецЕсли;
	
	//#6576
	Списание2ОбработаноУспешно = Истина;
	РКО2ОбработаноУспешно = Истина;
	Если ТипЗнч(СсылкаДокумент) = Тип("ДокументСсылка.НачислениеЗарплаты") 
		ИЛИ ТипЗнч(СсылкаДокумент) = Тип("ДокументСсылка.РасходныйКассовыйОрдер")
		ИЛИ ТипЗнч(СсылкаДокумент) = Тип("ДокументСсылка.СписаниеСРасчетногоСчета") Тогда
		
		НаборЗаписей = РегистрыНакопления.РасчетыСПерсоналом.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Регистратор.Установить(СсылкаДокумент);
		НаборЗаписей.Прочитать();
		Для каждого Движение из НаборЗаписей Цикл
			Движение.ВидНачисления			= Движение.УДАЛИТЬ_ВидНачисления;
			Движение.УДАЛИТЬ_ВидНачисления	= Справочники.ВидыНачислений.ПустаяСсылка();
		КонецЦикла;
		
		Попытка
			НаборЗаписей.Записать();
			РезультатОбработки.Успешно = Истина;
		Исключение
			РезультатОбработки.Успешно = Ложь;
			РезультатОбработки.ОписаниеОшибки = ОписаниеОшибки();
			Если ТипЗнч(СсылкаДокумент) = Тип("ДокументСсылка.СписаниеСРасчетногоСчета") Тогда
				Списание2ОбработаноУспешно = Ложь;
			КонецЕсли;
			Если ТипЗнч(СсылкаДокумент) = Тип("ДокументСсылка.РасходныйКассовыйОрдер") Тогда
				РКО2ОбработаноУспешно = Ложь;
			КонецЕсли;
		КонецПопытки;
		
	КонецЕсли;
	
	// №6303 по ЗД в статусе "Расторгнут" нужно создать документ Расторжения
	Если ТипЗнч(СсылкаДокумент) = Тип("ДокументСсылка.ЗаказДоговор") И СсылкаДокумент.ТекущийСтатус = Справочники.СтатусыЗаказДоговоров.Отменен Тогда
		
		ДокументОбъект = СсылкаДокумент.ПолучитьОбъект();
		
		РезультатОбработки.Успешно = Истина;
		
		// всё делаем в одной транзакции, т.к. мы отменяем проведение ЗД, чтобы два раза не списывать один товар/материал и т.п.
		НачатьТранзакцию(РежимУправленияБлокировкойДанных.Автоматический);
		
		// Сначала получим сумму, которая ранее делала движения по расторгнутому ЗД
		СуммаВДвижениях = 0;
		Запрос = новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Оплаты.Заказ КАК Заказ,
		|	СУММА(ЕСТЬNULL(Оплаты.СуммаРасход, 0)) КАК Оплачено
		|ИЗ
		|	РегистрНакопления.РасчетыПоЗаказам.Обороты(, , Авто, Заказ = &ЗаказДоговор) КАК Оплаты
		|ГДЕ
		|	НЕ Оплаты.Регистратор = &ЗаказДоговор
		|
		|СГРУППИРОВАТЬ ПО
		|	Оплаты.Заказ";
		Запрос.УстановитьПараметр("ЗаказДоговор", СсылкаДокумент);
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Следующий() Тогда
			СуммаВДвижениях = Выборка.Оплачено;
		КонецЕсли;
		
		// Перепроведем ЗД, чтобы сформировались движения по новой логике, при этом статус установим "В работе"
		// Т.к. при проведении соглашения о расторжении, он по этим джиженияем, сделает обратные движения
		Попытка
			ДокументОбъект.ТекущийСтатус = Справочники.СтатусыЗаказДоговоров.ВРаботе;
			ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
		Исключение
			РезультатОбработки.Успешно = Ложь;
			РезультатОбработки.ОписаниеОшибки = ОписаниеОшибки();
			ОтменитьТранзакцию();
			Возврат РезультатОбработки;
		КонецПопытки;
		
		// предварительно по ЗД попробуем найти существующий документ расторжения
		Запрос = новый Запрос;		
		Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СоглашениеОРасторженииДоговора.Ссылка
		|ИЗ
		|   Документ.СоглашениеОРасторженииДоговора КАК СоглашениеОРасторженииДоговора
		|ГДЕ
		|	СоглашениеОРасторженииДоговора.ЗаказДоговор = &ЗаказДоговор
		|	И НЕ СоглашениеОРасторженииДоговора.ПометкаУдаления";
		Запрос.УстановитьПараметр("ЗаказДоговор", ДокументОбъект.Ссылка);
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Следующий() Тогда
			РасторжениеОбъект = Выборка.Ссылка.ПолучитьОбъект();
		Иначе
			РасторжениеОбъект = Документы.СоглашениеОРасторженииДоговора.СоздатьДокумент();
		КонецЕсли;
		
		РасторжениеОбъект.Дата = ДокументОбъект.Дата;
		РасторжениеОбъект.Заполнить(ДокументОбъект.Ссылка);
		
		// Заполним поля из ЗД
		//РасторжениеОбъект.УДАЛИТЬ_
		БезВозвратаДенегКлиенту 	  				  = (ДокументОбъект.УДАЛИТЬ_РасторжениеБезВозвратаДенегКлиенту);
		//РасторжениеОбъект.УДАЛИТЬ_
		СписатьТовары 		  	 					  = (ДокументОбъект.УДАЛИТЬ_РасторжениеСписатьТовары И НЕ ДокументОбъект.УДАЛИТЬ_РасторжениеСкладСписанияТоваров.Пустая());
		Если НЕ СписатьТовары Тогда
			РасторжениеОбъект.ТоварыУслуги.Очистить();
		КонецЕсли;
		//РасторжениеОбъект.УДАЛИТЬ_
		СписатьМатериалы 		  	  				  = (ДокументОбъект.УДАЛИТЬ_РасторжениеСписатьМатериалы И НЕ ДокументОбъект.УДАЛИТЬ_РасторжениеСкладСписанияМатериалов.Пустая());
		Если НЕ СписатьМатериалы Тогда
			РасторжениеОбъект.Материалы.Очистить();
		КонецЕсли;
		РасторжениеОбъект.СкладСписанияТоваров 	  	  = ДокументОбъект.УДАЛИТЬ_РасторжениеСкладСписанияТоваров;
		РасторжениеОбъект.СкладСписанияМатериалов 	  = ДокументОбъект.УДАЛИТЬ_РасторжениеСкладСписанияМатериалов;
		РасторжениеОбъект.ПричинаРасторженияДоговора  = ДокументОбъект.УДАЛИТЬ_ПричинаРассторженияДоговора;
		
		// Получим разницу по сумме документа и суммы старых движений по расторгнутому ЗД
		// если сумма разницы больше 0 добавим в соглашение услугу или раскидаем сумму по позициям в соглашении (при их наличии)
		СуммаРазницы = СуммаВДвижениях - РасторжениеОбъект.ТоварыУслуги.Итог("Сумма");
		
		Если НЕ БезВозвратаДенегКлиенту Тогда
			РасторжениеОбъект.ТоварыУслуги.Очистить();
			РасторжениеОбъект.Материалы.Очистить();
			СуммаРазницы = 0;
		КонецЕсли;	
		
		Если СуммаРазницы > 0 Тогда
			КоличествоСтрок = РасторжениеОбъект.ТоварыУслуги.Количество();
			// Раскидываем разницу на позиции
			Если КоличествоСтрок > 0 Тогда
				СуммаНаОднуСтроку = СуммаРазницы / КоличествоСтрок;
				Для Каждого ТекущаяСтрока Из РасторжениеОбъект.ТоварыУслуги Цикл
					ТекущаяСтрока.Сумма = ТекущаяСтрока.Сумма + СуммаНаОднуСтроку;
				КонецЦикла;
				// Добавляем услугу	
			Иначе
				УслугаПоРасторжению = Справочники.Номенклатура.ПолучитьУслугуПоРасторжениюДоговора();
				НоваяСтрока = РасторжениеОбъект.ТоварыУслуги.Добавить();
				НоваяСтрока.Номенклатура = УслугаПоРасторжению;
				НоваяСтрока.ЕдиницаИзмерения = НоваяСтрока.Номенклатура.БазоваяЕдиницаИзмерения;
				НоваяСтрока.Коэффициент = 1;
				НоваяСтрока.Количество = 1;
				НоваяСтрока.Цена = СуммаРазницы;
				НоваяСтрока.Сумма = СуммаРазницы;
				
				// Комнату попробуем найти в ЗД заполненную
				Комната = "";
				// Сначал ищем в товарах
				Для Каждого ТекКомната Из ДокументОбъект.ТоварыУслуги Цикл
					Если ЗначениеЗаполнено(ТекКомната.Комната) Тогда
						Комната = ТекКомната.Комната;
						Прервать;
					КонецЕсли;
				КонецЦикла;
				// если не нашли, попруем найти в Материалах
				Если НЕ ЗначениеЗаполнено(Комната) Тогда
					Для Каждого ТекКомната Из ДокументОбъект.Материалы Цикл
						Если ЗначениеЗаполнено(ТекКомната.Комната) Тогда
							Комната = ТекКомната.Комната;
							Прервать;
						КонецЕсли;
					КонецЦикла;
				КонецЕсли;	
				
				Если НЕ ЗначениеЗаполнено(Комната) Тогда
					Комната = "Комната 1";
				КонецЕсли;	
				НоваяСтрока.Комната = Комната;
			КонецЕсли;
		КонецЕсли;
		
		// Проводим документ Расторжение
		Попытка
			РасторжениеОбъект.Записать(РежимЗаписиДокумента.Проведение);
			ЗафиксироватьТранзакцию();
		Исключение
			РезультатОбработки.Успешно = Ложь;
			РезультатОбработки.ОписаниеОшибки = ОписаниеОшибки();
			ОтменитьТранзакцию();
			Возврат РезультатОбработки;
		КонецПопытки;
		
		// Проводим ЗД - это "сделает" документ расторжения
		//Попытка
		//	// Сумма соглашения в сумму договора будет перенесена перед записью
		//	// вернем обратно статус Отменен
		//	ДокументОбъект.ТекущийСтатус = Справочники.СтатусыЗаказДоговоров.Отменен;
		//	ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
		//	// Фиксируем транзацию
		//	ЗафиксироватьТранзакцию();
		//Исключение
		//	РезультатОбработки.Успешно = Ложь;
		//	РезультатОбработки.ОписаниеОшибки = ОписаниеОшибки();
		//	ОтменитьТранзакцию();
		//	Возврат РезультатОбработки;
		//КонецПопытки;
		
	КонецЕсли;
	
	//#6347
	Монтаж2ОбработанУспешно = Истина;
	Если ТипЗнч(СсылкаДокумент) = Тип("ДокументСсылка.Монтаж") Тогда
		
		ДокументОбъект = СсылкаДокумент.ПолучитьОбъект();
		
		РезультатОбработки.Успешно = Истина;
		
		ТребуетсяЗапись = Ложь;
		Если ДокументОбъект.СпособРаспределенияВыработки = Перечисления.СпособыРаспределенияВыработкиПоМонтажникам.ПустаяСсылка() Тогда
			ДокументОбъект.СпособРаспределенияВыработки = Перечисления.СпособыРаспределенияВыработкиПоМонтажникам.ПоКоэффициентам;
			ТребуетсяЗапись = Истина;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ДокументОбъект.Бригада) Тогда
			Если ЗначениеЗаполнено(ДокументОбъект.Бригада.ВидБригады) Тогда
				Если НЕ ДокументОбъект.ВидБригады = ДокументОбъект.Бригада.ВидБригады Тогда
					ДокументОбъект.ВидБригады = ДокументОбъект.Бригада.ВидБригады;
					ТребуетсяЗапись = Истина;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		Если ТребуетсяЗапись Тогда
			Попытка
				// записать монтаж без перепроведения
				ДокументОбъект.Записать();
			Исключение
				РезультатОбработки.Успешно = Ложь;
				РезультатОбработки.ОписаниеОшибки = ОписаниеОшибки();
				Монтаж2ОбработанУспешно = Ложь;
			КонецПопытки;
		КонецЕсли;		
	КонецЕсли;
	
	// №6761 документы ОБК с заполненной статьей доходов перепровести, чтобы они сформировали движения в регистр ДоходыРасходы
	Если ТипЗнч(СсылкаДокумент) = Тип("ДокументСсылка.ОплатаБанковскойКартой") Тогда
		
		ДокОбъект = СсылкаДокумент.ПолучитьОбъект();
		РезультатОбработки.Успешно = Истина;
		
		Попытка
			ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
		Исключение
			РезультатОбработки.Успешно = Ложь;
			РезультатОбработки.ОписаниеОшибки = ОписаниеОшибки();
		КонецПопытки;
		
	КонецЕсли;
	
	// №6952 в регистр "Замеры" добавлено новое измерение "НазначилЗамер" и ресурс "ПричинаОтказа", нужно перепровести Лиды
	Если ТипЗнч(СсылкаДокумент) = Тип("ДокументСсылка.Лид") Тогда
		
		ДокОбъект = СсылкаДокумент.ПолучитьОбъект();
		РезультатОбработки.Успешно = Истина;
		
		Попытка
			ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
		Исключение
			РезультатОбработки.Успешно = Ложь;
			РезультатОбработки.ОписаниеОшибки = ОписаниеОшибки();
		КонецПопытки;
		
	КонецЕсли;
	
	// по отдельным видам документов обработку считаем успешной, если все обработки успешны
	Если ТипЗнч(СсылкаДокумент) = Тип("ДокументСсылка.СписаниеСРасчетногоСчета") Тогда
		РезультатОбработки.Успешно = СписаниеОбработаноУспешно И Списание2ОбработаноУспешно;
	КонецЕсли; 
	Если ТипЗнч(СсылкаДокумент) = Тип("ДокументСсылка.РасходныйКассовыйОрдер") Тогда
		РезультатОбработки.Успешно = РКООбработаноУспешно И РКО2ОбработаноУспешно;
	КонецЕсли;
	Если ТипЗнч(СсылкаДокумент) = Тип("ДокументСсылка.Монтаж") Тогда
		РезультатОбработки.Успешно = МонтажОбработанУспешно И Монтаж2ОбработанУспешно;
	КонецЕсли;
	Если ТипЗнч(СсылкаДокумент) = Тип("ДокументСсылка.РеализацияТоваровИУслуг") Тогда
		РезультатОбработки.Успешно = РеализацияОбработанаУспешно И Реализация2ОбработанаУспешно;
	КонецЕсли;
	Если ТипЗнч(СсылкаДокумент) = Тип("ДокументСсылка.ПоступлениеНаРасчетныйСчет") Тогда
		РезультатОбработки.Успешно = ПоступлениеОбработаноУспешно И Поступление2ОбработаноУспешно;
	КонецЕсли;
	
	Возврат РезультатОбработки;
	
КонецФункции

Функция Обработка_2_0_3_1(СсылкаДокумент) Экспорт
	
	РезультатОбработки = Новый Структура;
	РезультатОбработки.Вставить("Успешно", Ложь);
	РезультатОбработки.Вставить("ОписаниеОшибки", "");
	
	Если ТипЗнч(СсылкаДокумент) = Тип("ДокументСсылка.УстановкаСтоимостиВыработкиПоНоменклатуре") Тогда
		ДокОбъект = СсылкаДокумент.ПолучитьОбъект();
		ДокОбъект.ПометкаУдаления = истина;
		ДокОбъект.Комментарий = ДокОбъект.Комментарий + "#Помечен на удаление при обновлении на версию 2.0.3";
		Попытка	
			ДокОбъект.Записать();		
			РезультатОбработки.Успешно = Истина;
		Исключение
			РезультатОбработки.Успешно = Ложь;
			РезультатОбработки.ОписаниеОшибки = ОписаниеОшибки();
		КонецПопытки;
	КонецЕсли;
	
	// иначе документы, которые пишут в регистры выработки
	МассивРегистров = Новый Массив;
	МассивРегистров.Добавить("ВыработкаИсполнителейПроизводства");	
	МассивРегистров.Добавить("ВыработкаИсполнителейРозницы");
	Для каждого ИмяРегистраВыработки из МассивРегистров Цикл
		НаборЗаписей = РегистрыНакопления[ИмяРегистраВыработки].СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Регистратор.Установить(СсылкаДокумент);
		НаборЗаписей.Прочитать();
		Если НаборЗаписей.Количество() Тогда		
			Для каждого Движение из НаборЗаписей Цикл
				Если Движение.ВидНачисления.Наименование = "Бригадир" Тогда
					Движение.ВидНачисления = Справочники.ВидыНачислений.Бригадир;
				ИначеЕсли Движение.ВидНачисления.Наименование = "Замерщик" Тогда
					Движение.ВидНачисления = Справочники.ВидыНачислений.ЗамерщикЗаказДоговора;
				ИначеЕсли Движение.ВидНачисления.Наименование = "Менеджер заказ-договора" Тогда
					Движение.ВидНачисления = Справочники.ВидыНачислений.МенеджерЗаказДоговора;
				ИначеЕсли Движение.ВидНачисления.Наименование = "Раскройщики" Тогда
					Движение.ВидНачисления = Справочники.ВидыНачислений.СотрудникПроизводства;	
				ИначеЕсли Движение.ВидНачисления.Наименование = "Монтажник" ИЛИ Движение.ВидНачисления.Наименование = "Монтажники" Тогда
					Движение.ВидНачисления = Справочники.ВидыНачислений.Монтажник;
				ИначеЕсли Движение.ВидНачисления.Наименование = "Назначил замер в лиде" Тогда
					Движение.ВидНачисления = Справочники.ВидыНачислений.НазначилЗамерВЛиде;
				ИначеЕсли Движение.ВидНачисления.Наименование = "Менеджер контрагента" Тогда
					Движение.ВидНачисления = Справочники.ВидыНачислений.МенеджерКонтрагента; 
					
				ИначеЕсли Движение.ВидНачисления.Наименование = "Ответственный в документе" Тогда
					Если ТипЗнч(Движение.ОбъектВыработки) = Тип("ДокументСсылка.Монтаж") Тогда
						Движение.ВидНачисления = Справочники.ВидыНачислений.АвторВМонтаже;
					ИначеЕсли ТипЗнч(Движение.ОбъектВыработки) = Тип("ДокументСсылка.Лид") Тогда
						Движение.ВидНачисления = Справочники.ВидыНачислений.АвторВЛиде;
					ИначеЕсли ТипЗнч(Движение.ОбъектВыработки) = Тип("ДокументСсылка.ЗаказПокупателя") Тогда
						Движение.ВидНачисления = Справочники.ВидыНачислений.АвторВЗаказеПокупателя; 
					ИначеЕсли ТипЗнч(Движение.ОбъектВыработки) = Тип("ДокументСсылка.РеализацияТоваровИУслуг") Тогда
						Движение.ВидНачисления = Справочники.ВидыНачислений.АвторВРеализации;
					КонецЕсли;
					
				ИначеЕсли Движение.ВидНачисления.Наименование = "Ответственный в документе заказа" Тогда	
					Если ТипЗнч(Движение.ОбъектВыработки) = Тип("ДокументСсылка.Монтаж") Тогда
						Движение.ВидНачисления = Справочники.ВидыНачислений.АвторВЗаказДоговоре;
					ИначеЕсли ТипЗнч(Движение.ОбъектВыработки) = Тип("ДокументСсылка.РеализацияТоваровИУслуг") Тогда
						Движение.ВидНачисления = Справочники.ВидыНачислений.АвторВЗаказеПокупателя;
					ИначеЕсли ТипЗнч(Движение.ОбъектВыработки) = Тип("ДокументСсылка.ВыпускПродукции") Тогда
						Движение.ВидНачисления = Справочники.ВидыНачислений.АвторВЗаказеПокупателя;
					КонецЕсли;
					
				ИначеЕсли Движение.ВидНачисления.Наименование = "Ответственный в основании" Тогда
					Если ТипЗнч(Движение.ОбъектВыработки) = Тип("ДокументСсылка.Монтаж") Тогда
						Движение.ВидНачисления = Справочники.ВидыНачислений.АвторВЗаказДоговоре;
					КонецЕсли;
				КонецЕсли;
				
			КонецЦикла;
			
			Попытка
				НаборЗаписей.Записать();
				РезультатОбработки.Успешно = Истина;
			Исключение
				РезультатОбработки.Успешно = Ложь;
				РезультатОбработки.ОписаниеОшибки = ОписаниеОшибки();
			КонецПопытки;		
		Иначе
			РезультатОбработки.Успешно = Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат РезультатОбработки;
	
КонецФункции

Функция Обработка_2_0_3_2(СсылкаДокумент) Экспорт
	
