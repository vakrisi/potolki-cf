					РезультатОбработки.ОписаниеОшибки = ОписаниеОшибки();
				КонецПопытки;
				
			ИначеЕсли ТаблицаВД[0].ВидДокумента = 3 Тогда
				СпрОбъект = СсылкаНаОбъект.ПолучитьОбъект();
				СпрОбъект.ВидСпецификации = Перечисления.ВидыСпецификации.Комплектация;
