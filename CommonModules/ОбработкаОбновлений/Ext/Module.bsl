Функция Обработка_2_8_34_0_Обязательные(СсылкаНаОбъект, ВерсияПрограммыЧисло) Экспорт
	
	РезультатОбработки = Новый Структура;
	РезультатОбработки.Вставить("Успешно", Ложь);
	РезультатОбработки.Вставить("ОписаниеОшибки", "");
	
	// №13196 исправляем наименование для печати у потолков и отрезов
	Если ТипЗнч(СсылкаНаОбъект) = Тип("СправочникСсылка.Номенклатура")
		И (СсылкаНаОбъект.ВидНоменклатуры = Справочники.ВидыНоменклатуры.Потолок
		Или СсылкаНаОбъект.ВидНоменклатуры = Справочники.ВидыНоменклатуры.Отрез) Тогда
		
		НоменклатураОбъект = СсылкаНаОбъект.ПолучитьОбъект();
		
		НоменклатураОбъект.НаименованиеДляПечати = НоменклатураОбъект.Наименование;
		
		Попытка
			НоменклатураОбъект.ОбменДанными.Загрузка = Истина;
			НоменклатураОбъект.Записать();
			РезультатОбработки.Успешно = Истина;
		Исключение
			РезультатОбработки.Успешно = Ложь;
			РезультатОбработки.ОписаниеОшибки = ОписаниеОшибки();
		КонецПопытки;
		
		// №14125 для всех документов "Возврат уникальной продукции" скопировать движения из РН "Ответственность за браки" в РН "Выработка исполнителей производства"
	ИначеЕсли ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.ВозвратПродукции") И ВерсияПрограммыЧисло = 2008034100 Тогда
		
		ВалютаУчета = ПолучитьФункциональнуюОпцию("ВалютаУчета");
		
		НачатьТранзакцию();
		
		// 1. Сначала сделаем новые движения в РН "Выработка исполнителей производства"
		НаборЗаписей = РегистрыНакопления.ВыработкаИсполнителейПроизводства.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Регистратор.Установить(СсылкаНаОбъект);
		
		НаборЗаписей.Прочитать();
		НаборЗаписей.Очистить();
		
		ОбщийКоэффициент = СсылкаНаОбъект.Ответственные.Итог("Коэффициент");
		
		Если НЕ ОбщийКоэффициент = 0 Тогда
			
			Для Каждого ТекущийТовар Из СсылкаНаОбъект.Товары Цикл
				
				Для Каждого ТекущийОтветсвенный Из СсылкаНаОбъект.Ответственные Цикл
					
					Движение = НаборЗаписей.Добавить();
					Движение.Период = СсылкаНаОбъект.Дата;
					Движение.ВидНачисления = Справочники.ВидыНачислений.ШтрафЗаБрак;
					Движение.Подразделение = СсылкаНаОбъект.Подразделение;
					Движение.Сотрудник = ТекущийОтветсвенный.Сотрудник;
					Движение.Номенклатура = ТекущийТовар.Номенклатура;
					Движение.ЕдиницаИзмерения = ТекущийТовар.ЕдиницаИзмерения;
					Движение.Количество = -(ТекущийТовар.Количество * ТекущийТовар.Коэффициент);
					
					СуммаОтветственности = ?(СсылкаНаОбъект.УДАЛИТЬ_ОтветственностьИсполнителейПоСебестоимости, ТекущийТовар.Себестоимость, ТекущийТовар.Сумма);
					
					Движение.Стоимость = -РаботаСВалютой.ПересчитатьИзВалютыВВалюту(СсылкаНаОбъект.Валюта, ВалютаУчета, СсылкаНаОбъект.Дата, СуммаОтветственности * (ТекущийОтветсвенный.Коэффициент / ОбщийКоэффициент));
					Движение.Цена = ?(НЕ Движение.Количество = 0, Движение.Стоимость / -Движение.Количество, Движение.Стоимость);
					
					Движение.ОбъектВыработки = СсылкаНаОбъект;
					
				КонецЦикла;
				
			КонецЦикла;
			
		КонецЕсли;
		
		Попытка
			
			НаборЗаписей.Записать();
			
		Исключение
			
			ОтменитьТранзакцию();
			
			РезультатОбработки.Успешно = Ложь;
			РезультатОбработки.ОписаниеОшибки = ОписаниеОшибки();
			
			Возврат РезультатОбработки;
			
		КонецПопытки;
		
		// 2. Очищаем РН "Ответственность за браки"
		НаборЗаписей = РегистрыНакопления.УДАЛИТЬ_ОтветственностьЗаБракиНаПроизводстве.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Регистратор.Установить(СсылкаНаОбъект);
		
		НаборЗаписей.Прочитать();
		НаборЗаписей.Очистить();
		
		Попытка
			
			НаборЗаписей.Записать();
			
			ЗафиксироватьТранзакцию();
			
			РезультатОбработки.Успешно = Истина;
			
		Исключение
			
			ОтменитьТранзакцию();
			
			РезультатОбработки.Успешно = Ложь;
			РезультатОбработки.ОписаниеОшибки = ОписаниеОшибки();
			
		КонецПопытки;
		
	КонецЕсли;
	
	Возврат РезультатОбработки;
	
КонецФункции

#КонецОбласти

