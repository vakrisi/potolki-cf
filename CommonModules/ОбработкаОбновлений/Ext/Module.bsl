				ОбработаноУспешно2 = Ложь;
			КонецПопытки;
		Иначе
			РезультатОбработки.Успешно = Истина; // Обработка не требуется
			ОбработаноУспешно2 = Истина;
		КонецЕсли;
		
		//#7806 обработка ЗНП: для внутренних заказов очистить настройку интеркампани
	ИначеЕсли ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.ЗаказНаПроизводство") Тогда
		
		ДокОбъект = СсылкаНаОбъект.ПолучитьОбъект();
		Если ЗначениеЗаполнено(ДокОбъект.ДокументОснование) 
			И ТипЗнч(ДокОбъект.ДокументОснование) = Тип("ДокументСсылка.ЗаказПокупателя")
			И ДокОбъект.ДокументОснование.ВнутреннийЗаказ Тогда
			
			ДокОбъект.ВнутреннийЗаказ = Истина;
			ДокОбъект.ЭтоЗаказОтРозницы = Ложь;
			ДокОбъект.НастройкаИнтеркампани = Справочники.НастройкиИнтеркампани.ПустаяСсылка();
			Попытка
				ДокОбъект.Записать();
				РезультатОбработки.Успешно = Истина;
			Исключение
				РезультатОбработки.Успешно = Ложь;
				РезультатОбработки.ОписаниеОшибки = ОписаниеОшибки();
			КонецПопытки;
			
		Иначе
			РезультатОбработки.Успешно = Истина;
			
		КонецЕсли;
		
		Если РезультатОбработки.Успешно Тогда
			// Заказы на производство - выпуск продукции
			// Сначала ищем по ЗнП выпуск, устанавливаем по выпуску, далее переносим способ в ЗнП
			// если у ЗнП нет выпусков, ставим согласно текущей настройке
			//Логика определения способа в выпуске:
			//- Если в документе есть заполненная таблица "Исполнители по операциям" и при этом пустая таблица "Исполнители", то реквизит = по операциям
			//- Если в документе есть пустая таблица "Исполнители по операциям" и при этом заполнена таблица "Исполнители", то способ начисления выработки ставим =  бригадная
			
			// №6687 поменяли логику
			//Было:
			//- Если обе таблицы пустые - то ставим согласно текущим настроек программы
			//- Если по какой-то причине обе таблицы полные - то ставим согласно текущим настроек программы
			//Стало:
			//- если у выпуска заполнено обе таблицы или ни одной, то ставить вид начисления выработки = пустой
			
			НачатьТранзакцию();
			
			ДокОбъект = СсылкаНаОбъект.ПолучитьОбъект();
			
			// способ по умолчанию
			СпособНачисленияВыработки = ?(Константы.РасчетЗарплатыПроизводстваПоОперациям.Получить(), Перечисления.СпособыНачисленияВыработки.ПроизводственныеОперации, Перечисления.СпособыНачисленияВыработки.Бригадная);
			
			// сначала найдем Выпуск по ЗнП
			Запрос = новый Запрос;
			Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ВыпускПродукции.Ссылка
			|ИЗ
			|	Документ.ВыпускПродукции КАК ВыпускПродукции
			|ГДЕ
			|	ВыпускПродукции.Основание = &ЗаказаНаПроизводство
			//++ №6687 только проведенные выпуски
			|	И ВыпускПродукции.Проведен
			|";
			Запрос.УстановитьПараметр("ЗаказаНаПроизводство", СсылкаНаОбъект);
			
			Выборка = Запрос.Выполнить().Выбрать();
			
			ЕстьВыпускПродукции = Ложь;
			Пока Выборка.Следующий() Цикл
				
				ЕстьВыпускПродукции = Истина;
				ВыпускОбъект = Выборка.Ссылка.ПолучитьОбъект();
				
				Если ВыпускОбъект.Исполнители.Количество() > 0 И ВыпускОбъект.ИсполнителиПоОперациям.Количество() = 0 Тогда
					ВыпускОбъект.СпособНачисленияВыработки = Перечисления.СпособыНачисленияВыработки.Бригадная;
				ИначеЕсли ВыпускОбъект.Исполнители.Количество() = 0 И ВыпускОбъект.ИсполнителиПоОперациям.Количество() > 0 Тогда
					ВыпускОбъект.СпособНачисленияВыработки = Перечисления.СпособыНачисленияВыработки.ПроизводственныеОперации;
				Иначе
					ВыпускОбъект.СпособНачисленияВыработки = Перечисления.СпособыНачисленияВыработки.ПустаяСсылка(); // №6687 поменяли логику СпособНачисленияВыработки;
				КонецЕсли;
				
				Попытка
					ВыпускОбъект.Записать(РежимЗаписиДокумента.Запись);
					СпособНачисленияВыработки = ВыпускОбъект.СпособНачисленияВыработки;
				Исключение
					РезультатОбработки.Успешно = Ложь;
					РезультатОбработки.ОписаниеОшибки = ОписаниеОшибки();
					ОтменитьТранзакцию();
					Возврат РезультатОбработки;
				КонецПопытки;
				
			КонецЦикла;
			
			// №6687 дополнительно смотрим:
			// если у заказа на производство выпуска нет, то заказу на производство в статусе "Отменен" ставим пустое значение вида выработки,
			// а если статус "в производстве" или "произведен", то согласно текущему значению константы.
			Если ДокОбъект.ТекущийСтатус = Справочники.СтатусыЗаказовНаПроизводство.Отменен И НЕ ЕстьВыпускПродукции Тогда
				ДокОбъект.СпособНачисленияВыработки = Перечисления.СпособыНачисленияВыработки.ПустаяСсылка();
			Иначе
				ДокОбъект.СпособНачисленияВыработки = СпособНачисленияВыработки;
			КонецЕсли;
			
			Попытка
				ДокОбъект.Записать(РежимЗаписиДокумента.Запись);
				РезультатОбработки.Успешно = Истина;
				ЗафиксироватьТранзакцию();
			Исключение
				РезультатОбработки.Успешно = Ложь;
				РезультатОбработки.ОписаниеОшибки = ОписаниеОшибки();
				ОтменитьТранзакцию();
			КонецПопытки;
		КонецЕсли;
		//-- №6687
		
		//#9168 заполнить новый реквизит "ИдентификаторСтрокой" в регистрах Монтажи и Замеры
	ИначеЕсли ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.Монтаж") Тогда
		
		НаборЗаписей = РегистрыСведений.Монтажи.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Регистратор.Установить(СсылкаНаОбъект);
		НаборЗаписей.Прочитать();
		Для Каждого Движение Из НаборЗаписей Цикл
			Движение.ИдентификаторСтрокой = Строка(Движение.ИДМонтажа);
			Движение.ТочкаПродаж = СсылкаНаОбъект.ТочкаПродаж;
		КонецЦикла;
		
		Попытка
			НаборЗаписей.Записать();
			РезультатОбработки.Успешно = Истина;
			ОбработаноУспешно2 = Истина;
		Исключение
			РезультатОбработки.Успешно = Ложь;
			РезультатОбработки.ОписаниеОшибки = "Не удалось записать движения в регистр ""Монтажи"": " + ОписаниеОшибки();
			ОбработаноУспешно2 = Ложь;
		КонецПопытки;
		
		//#9168 заполнить новый реквизит "ИдентификаторСтрокой" в регистрах Монтажи и Замеры
	ИначеЕсли ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.Лид") 
		ИЛИ ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.УДАЛИТЬ_Замер")
		Тогда
		
		НаборЗаписей = РегистрыСведений.Замеры.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Регистратор.Установить(СсылкаНаОбъект);
		НаборЗаписей.Прочитать();
		Для Каждого Движение Из НаборЗаписей Цикл
			Движение.ИдентификаторСтрокой = Строка(Движение.ИДЗамера);				
		КонецЦикла;
		
		Попытка
			НаборЗаписей.Записать();
			РезультатОбработки.Успешно = Истина;
		Исключение
			РезультатОбработки.Успешно = Ложь;
			РезультатОбработки.ОписаниеОшибки = "Не удалось записать движения в регистр ""Замеры"": " + ОписаниеОшибки();
		КонецПопытки;
		
		//#9320 заполняем новый реквизит Валюта и движения по Продажам при проведении
	ИначеЕсли ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.ЧекККМ") Тогда
		
		ДокОбъект = СсылкаНаОбъект.ПолучитьОбъект();
		ДокОбъект.Валюта = ПолучитьФункциональнуюОпцию("ВалютаУчета");
		Режим = РежимЗаписиДокумента.Запись;
		Если ДокОбъект.Проведен Тогда
			Режим = РежимЗаписиДокумента.Проведение;
		КонецЕсли;
		Попытка
			ДокОбъект.ДополнительныеСвойства.Вставить("ПропуститьПроверкуПередЗаписью", Истина);
			ДокОбъект.Записать(Режим);
			РезультатОбработки.Успешно = Истина;
		Исключение
			РезультатОбработки.Успешно = Ложь;
			РезультатОбработки.ОписаниеОшибки = ОписаниеОшибки();
		КонецПопытки;		
		
		//++ №6687 добавлен реквит Способ начисления выработки
		// документы: ВыпускПродукции, ЗаказНаПроизводство, СоставПроизводственнойСмены, УстановкаСтоимостиВыработкиПоНоменклатуре
		// если поле "Производственная операция" заполнено, то служебный реквизит ставим "По операциям", если нет, то "Бригадный".
	ИначеЕсли ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.УстановкаСтоимостиВыработкиПоНоменклатуре") Тогда
		
		ДокОбъект = СсылкаНаОбъект.ПолучитьОбъект();
		
		Если ДокОбъект.ПроизводственнаяОперация.Пустая() Тогда
			ДокОбъект.СпособНачисленияВыработки = Перечисления.СпособыНачисленияВыработки.Бригадная;
		Иначе
			ДокОбъект.СпособНачисленияВыработки = Перечисления.СпособыНачисленияВыработки.ПроизводственныеОперации;
		КонецЕсли;
		
		Попытка
			ДокОбъект.Записать(РежимЗаписиДокумента.Запись);
			РезультатОбработки.Успешно = Истина;
		Исключение
			РезультатОбработки.Успешно = Ложь;
			РезультатОбработки.ОписаниеОшибки = ОписаниеОшибки();
		КонецПопытки;
		
		// Если заполнена только одна ТЧ, то служебный реквизит ставим в соответствующее значение.
		// Если не заполнена ни одна ТЧ либо обе, то ставим согласно текущему значению константы.
	ИначеЕсли ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.СоставПроизводственнойСмены") Тогда
		
		ДокОбъект = СсылкаНаОбъект.ПолучитьОбъект();
		
		Если ДокОбъект.Сотрудники.Количество() > 0 И ДокОбъект.СотрудникиПоОперациям.Количество() = 0 Тогда
			ДокОбъект.СпособНачисленияВыработки = Перечисления.СпособыНачисленияВыработки.Бригадная;
		ИначеЕсли ДокОбъект.Сотрудники.Количество() = 0 И ДокОбъект.СотрудникиПоОперациям.Количество() > 0 Тогда
			ДокОбъект.СпособНачисленияВыработки = Перечисления.СпособыНачисленияВыработки.ПроизводственныеОперации;
		Иначе
			ДокОбъект.СпособНачисленияВыработки = ?(Константы.РасчетЗарплатыПроизводстваПоОперациям.Получить(), Перечисления.СпособыНачисленияВыработки.ПроизводственныеОперации, Перечисления.СпособыНачисленияВыработки.Бригадная);
		КонецЕсли;
		
		Попытка
			ДокОбъект.Записать(РежимЗаписиДокумента.Запись);
			РезультатОбработки.Успешно = Истина;
		Исключение
			РезультатОбработки.Успешно = Ложь;
			РезультатОбработки.ОписаниеОшибки = ОписаниеОшибки();
		КонецПопытки;
		
		// Выпуски без ЗнП
	ИначеЕсли ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.ВыпускПродукции") И СсылкаНаОбъект.Основание.Пустая() Тогда
		
		ДокОбъект = СсылкаНаОбъект.ПолучитьОбъект();
		
		ДокОбъект.СпособНачисленияВыработки = ?(Константы.РасчетЗарплатыПроизводстваПоОперациям.Получить(), Перечисления.СпособыНачисленияВыработки.ПроизводственныеОперации, Перечисления.СпособыНачисленияВыработки.Бригадная);
		
		Попытка
			ДокОбъект.Записать(РежимЗаписиДокумента.Запись);
			РезультатОбработки.Успешно = Истина;
		Исключение
			РезультатОбработки.Успешно = Ложь;
			РезультатОбработки.ОписаниеОшибки = ОписаниеОшибки();
		КонецПопытки;
		
	КонецЕсли;
	
	Если ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.ЗаказПокупателя") ИЛИ ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.Монтаж") Тогда
		РезультатОбработки.Успешно = ОбработаноУспешно1 И ОбработаноУспешно2;	
	КонецЕсли;
	
	Возврат РезультатОбработки;
	
КонецФункции

#КонецОбласти

#Область Обработка_2_6_0_1

Функция Обработка_2_6_0_1(СсылкаНаОбъект) Экспорт
	
	РезультатОбработки = Новый Структура;
	РезультатОбработки.Вставить("Успешно", Ложь);
	РезультатОбработки.Вставить("ОписаниеОшибки", "");
	
	// №9396 расчет размера файлов (Перед записью в модуле набора записей)
	Попытка
		//НаборЗаписей = РегистрыСведений.ПрикрепленныеДанные.СоздатьНаборЗаписей();
		//НаборЗаписей.Прочитать();
		//НаборЗаписей.Записать();
		
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("СсылкаНаОбъект", СсылкаНаОбъект);
		Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ПрикрепленныеДанные.СсылкаНаОбъект КАК СсылкаНаОбъект,
		|	ПрикрепленныеДанные.ВидФайлаПрограммыПостроителя КАК ВидФайлаПрограммыПостроителя,
		|	ПрикрепленныеДанные.ИмяФайла КАК ИмяФайла,
		|	ПрикрепленныеДанные.Период КАК Период,
		|	ПрикрепленныеДанные.Размер КАК Размер
		|ИЗ
		|	РегистрСведений.ПрикрепленныеДанные КАК ПрикрепленныеДанные
		|ГДЕ
		|	ПрикрепленныеДанные.СсылкаНаОбъект = &СсылкаНаОбъект";
		
		Выборка = Запрос.Выполнить().Выбрать();	
		Пока Выборка.Следующий() Цикл
			Если НЕ Выборка.Размер = 0 Тогда
				Продолжить;
			КонецЕсли;
			МенеджерЗаписи = РегистрыСведений.ПрикрепленныеДанные.СоздатьМенеджерЗаписи();	
			ЗаполнитьЗначенияСвойств(МенеджерЗаписи, Выборка, "Период, ВидФайлаПрограммыПостроителя, СсылкаНаОбъект, ИмяФайла");
			МенеджерЗаписи.Прочитать();
			МенеджерЗаписи.Записать();
		КонецЦикла;
		
		РезультатОбработки.Успешно = Истина; //++ 2020-11-05
	Исключение
		РезультатОбработки.ОписаниеОшибки = ОписаниеОшибки(); //++ 2020-11-05
	КонецПопытки;
	
	
	Возврат РезультатОбработки;
	
КонецФункции

