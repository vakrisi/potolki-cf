#Область Обработка_2_6_0_0_Обязательные

Функция Обработка_2_6_0_0_Обязательные(СсылкаНаОбъект) Экспорт
	
	РезультатОбработки = Новый Структура;
	РезультатОбработки.Вставить("Успешно", Ложь);
	РезультатОбработки.Вставить("ОписаниеОшибки", "");
	
	// №7256
	Если ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.УДАЛИТЬ_УстановкаИндивидуальныхЦен") Тогда
		
		НачатьТранзакцию();
		
		ДокОбъект = СсылкаНаОбъект.ПолучитьОбъект();
		Если ДокОбъект.ИндивидуальныеЦеныНоменклатуры Тогда
			ДокУИЦН = Документы.УстановкаИндивидуальныхЦенНоменклатуры.СоздатьДокумент();
			ЗаполнитьЗначенияСвойств(ДокУИЦН, ДокОбъект, "Дата, Валюта, ВидОперации, Контрагент, ДоговорКонтрагента, Комментарий, НеРегистрироватьНулевыеЦены,
			|Основание"); //, Ответственный");
			ДокУИЦН.УстановитьНовыйНомер();
			ДокУИЦН.Товары.Загрузить(ДокОбъект.Товары.Выгрузить());
			ДокУИЦН.Комментарий = "#Создан автоматически при обновлении на версию 2.6";  //++ 2020-11-05
			
			Попытка
				ДокУИЦН.Записать(РежимЗаписиДокумента.Проведение);
				РезультатОбработки.Успешно = Истина;
			Исключение
				ОтменитьТранзакцию();
				
				РезультатОбработки.Успешно = Ложь;
				РезультатОбработки.ОписаниеОшибки = ОписаниеОшибки();
				Возврат РезультатОбработки;
			КонецПопытки;
		КонецЕсли;
		
		Если ДокОбъект.ИндивидуальныеЦеныНаПродукцию Тогда
			Для каждого СтрокаТЧ из ДокОбъект.ВидыНоменклатурыПотолка Цикл
				
				НайденныеСтроки = ДокОбъект.Материалы.НайтиСтроки(Новый Структура("КлючСвязи", СтрокаТЧ.КлючСвязи));
				Если НайденныеСтроки.Количество() = 0 тогда
					Продолжить;
				КонецЕсли;
				
				ДокУИЦН = Документы.УстановкаИндивидуальныхЦенМатериалов.СоздатьДокумент();
				ЗаполнитьЗначенияСвойств(ДокУИЦН, ДокОбъект, "Дата, Валюта, ВидОперации, Контрагент, ДоговорКонтрагента, Комментарий,
				|Основание"); //, Ответственный");
				ДокУИЦН.УстановитьНовыйНомер();
				ДокУИЦН.ВидНоменклатуры = СтрокаТЧ.ВидНоменклатуры;
				//ДокУИЦН.ВидыНоменклатурыПотолка.Загрузить(ДокОбъект.ВидыНоменклатурыПотолка.Выгрузить());
				//ДокУИЦН.Материалы.Загрузить(ДокОбъект.Материалы.Выгрузить());
				
				ДокУИЦН.Комментарий = "#Создан автоматически при обновлении на версию 2.6";  //++ 2020-11-05
				
				Для каждого СтрокаМатериалов из НайденныеСтроки Цикл
					НоваяСтрока = ДокУИЦН.Материалы.Добавить();
					ЗаполнитьЗначенияСвойств(новаяСтрока, СтрокаМатериалов);
				КонецЦикла;
				
				Попытка
					ДокУИЦН.Записать(РежимЗаписиДокумента.Проведение);
					РезультатОбработки.Успешно = Истина;
				Исключение
					ОтменитьТранзакцию();
					
					РезультатОбработки.Успешно = Ложь;
					РезультатОбработки.ОписаниеОшибки = ОписаниеОшибки();
					Возврат РезультатОбработки;
				КонецПопытки;
			КонецЦикла;
		КонецЕсли;
		
		Если ДокОбъект.ИндивидуальныеЦеныРаскроя Тогда
			ДокУИЦН = Документы.УстановкаИндивидуальныхЦенНаУслугиПроизводства.СоздатьДокумент();
			ЗаполнитьЗначенияСвойств(ДокУИЦН, ДокОбъект, "Дата, Валюта, ВидОперации, Контрагент, ДоговорКонтрагента, Комментарий,
			|Основание,
			|НеУчитыватьВнутренниеВырезы, НеУчитыватьВырезыApply, НеУчитыватьДлинаПользовательскихШвов, НеУчитыватьДлинаШвов,
			|НеУчитыватьДлинаШвовМногофактурный, НеУчитыватьКривые, НеУчитыватьУглы, НеУчитыватьФотопечать, НоменклатураУслугиЦентровкиШва,
			|СтоимостьУслугиЦентровкиШва, СтоимостьЦентровкиШваНеВключаетСтоимостьУслуг");
			ДокУИЦН.УстановитьНовыйНомер();
			ДокУИЦН.Углы.Загрузить(ДокОбъект.Углы.Выгрузить());
			ДокУИЦН.ВырезыApply.Загрузить(ДокОбъект.ВырезыApply.Выгрузить());
			ДокУИЦН.Фотопечать.Загрузить(ДокОбъект.Фотопечать.Выгрузить());
			ДокУИЦН.ДлинаШвов.Загрузить(ДокОбъект.ДлинаШвов.Выгрузить());
			ДокУИЦН.ДлинаПользовательскихШвов.Загрузить(ДокОбъект.ДлинаПользовательскихШвов.Выгрузить());
			ДокУИЦН.ВнутренниеВырезы.Загрузить(ДокОбъект.ВнутренниеВырезы.Выгрузить());
			ДокУИЦН.Кривые.Загрузить(ДокОбъект.Кривые.Выгрузить());
			ДокУИЦН.ДлинаШвовМногофактурный.Загрузить(ДокОбъект.ДлинаШвовМногофактурный.Выгрузить());
			
			ДокУИЦН.Комментарий = "#Создан автоматически при обновлении на версию 2.6";  //++ 2020-11-05
			
			Попытка
				ДокУИЦН.Записать(РежимЗаписиДокумента.Проведение);
				РезультатОбработки.Успешно = Истина;
			Исключение
				ОтменитьТранзакцию();
				
				РезультатОбработки.Успешно = Ложь;
				РезультатОбработки.ОписаниеОшибки = ОписаниеОшибки();
				Возврат РезультатОбработки;
			КонецПопытки;
		КонецЕсли;
		
		ЗафиксироватьТранзакцию();
		
		
		// №7256
	ИначеЕсли ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.УстановкаЦенМатериалов") Тогда
		
		ДокОбъект = СсылкаНаОбъект.ПолучитьОбъект();
		Если ЗначениеЗаполнено(ДокОбъект.УДАЛИТЬ_ВидЦены) Тогда
			Если ДокОбъект.ВидыЦен.НайтиСтроки(Новый Структура("ВидЦены", ДокОбъект.УДАЛИТЬ_ВидЦены)).Количество() = 0 Тогда
				НоваяСтрока = ДокОбъект.ВидыЦен.Добавить();
				НоваяСтрока.ВидЦены = ДокОбъект.УДАЛИТЬ_ВидЦены;
			КонецЕсли;
			
			Для каждого СтрокаТЧ из ДокОбъект.Материалы Цикл
				СтрокаТЧ.ВидЦены = ДокОбъект.УДАЛИТЬ_ВидЦены;	
			КонецЦикла;		
			
		КонецЕсли;
		
		Попытка
			ДокОбъект.Записать();
			РезультатОбработки.Успешно = Истина;
		Исключение			
			РезультатОбработки.Успешно = Ложь;
			РезультатОбработки.ОписаниеОшибки = ОписаниеОшибки();
		КонецПопытки;
		
		
	ИначеЕсли ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.Лид") Тогда
		
		ДокументОбъект = СсылкаНаОбъект.ПолучитьОбъект();
		
		// №7256
		ОбщийМодульСервер.ЗаполнитьДополнительноеСвойствоЛида(ДокументОбъект, Справочники.ВидыДополнительныхСвойствЛида.ЛидID, ДокументОбъект.УДАЛИТЬ_ЛидID);	
		ОбщийМодульСервер.ЗаполнитьДополнительноеСвойствоЛида(ДокументОбъект, Справочники.ВидыДополнительныхСвойствЛида.ПисьмоID, ДокументОбъект.УДАЛИТЬ_ЭлектроннаяПочтаИД);	
		ОбщийМодульСервер.ЗаполнитьДополнительноеСвойствоЛида(ДокументОбъект, Справочники.ВидыДополнительныхСвойствЛида.ЯндексID, ДокументОбъект.УДАЛИТЬ_ЯндексID);	
		ОбщийМодульСервер.ЗаполнитьДополнительноеСвойствоЛида(ДокументОбъект, Справочники.ВидыДополнительныхСвойствЛида.GoogleID, ДокументОбъект.УДАЛИТЬ_ГуглID);
		ОбщийМодульСервер.ЗаполнитьДополнительноеСвойствоЛида(ДокументОбъект, Справочники.ВидыДополнительныхСвойствЛида.Битрикс24ID, ДокументОбъект.УДАЛИТЬ_ИД_Битрикс24);
		
		// №9853 всем ранее созданным выездам проставить галочку "Адрес выезда отличается от адреса лида"
		ДокументОбъект.АдресВыездаОтличаетсяОтАдресаЛида = Истина;	
		// Адрес выезда мог быть заполнен, если нет, переносим из адреса лида
		Если ПустаяСтрока(ДокументОбъект.АдресВыезда) Тогда
			ДокументОбъект.АдресВыезда = ДокументОбъект.Адрес;
		КонецЕсли;		
		// Город выезда новый реквизит, переносим сразу
		ДокументОбъект.ГородВыезда = ДокументОбъект.Город;
		
		Попытка
			ДокументОбъект.ОбменДанными.Загрузка = Истина; //++ 2020-11-05
			ДокументОбъект.Записать();
			РезультатОбработки.Успешно = Истина;
		Исключение			
			РезультатОбработки.Успешно = Ложь;
			РезультатОбработки.ОписаниеОшибки = ОписаниеОшибки();
		КонецПопытки;
		
	КонецЕсли;		
	
	Возврат РезультатОбработки;
	
КонецФункции

#КонецОбласти

#Область Обработка_2_6_0_0

Функция Обработка_2_6_0_0(СсылкаНаОбъект, ОбработкаОбязательныхОбъектов) Экспорт
	
	Если ОбработкаОбязательныхОбъектов Тогда
		Возврат Обработка_2_6_0_0_Обязательные(СсылкаНаОбъект);
	КонецЕсли;
	
	РезультатОбработки = Новый Структура;
	РезультатОбработки.Вставить("Успешно", Ложь);
