#Область Обработка_2_6_18_0

Функция Обработка_2_6_18_0(СсылкаНаОбъект) Экспорт
	
	РезультатОбработки = Новый Структура;
	РезультатОбработки.Вставить("Успешно", Ложь);
	РезультатОбработки.Вставить("ОписаниеОшибки", "");
	
	// №11305 ПТиУ с доставкой неккоректно делали запись суммы в регистр накопления "Закупки"
	Если ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.ПоступлениеТоваровИУслуг") И СсылкаНаОбъект.Проведен Тогда
		
		ДокОбъект = СсылкаНаОбъект.ПолучитьОбъект();
		
		//Попытка
		//	ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
		//	РезультатОбработки.Успешно = Истина;
		//Исключение
		//	РезультатОбработки.Успешно = Ложь;
		//	РезультатОбработки.ОписаниеОшибки = ОписаниеОшибки();
		//КонецПопытки;
		
		НаборЗаписей = РегистрыНакопления.Закупки.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Регистратор.Установить(СсылкаНаОбъект);
		НаборЗаписей.Прочитать();
		НаборЗаписей.Очистить();
		
		Для Каждого ТекущаяСтрока Из ДокОбъект.Товары Цикл
			Движение = НаборЗаписей.Добавить();
			Движение.Период = ДокОбъект.Дата;
			Движение.Организация = ДокОбъект.Организация;
			Движение.Подразделение = ДокОбъект.Подразделение;
			Движение.Контрагент = ДокОбъект.Контрагент;
			Движение.ДоговорКонтрагента = ДокОбъект.ДоговорКонтрагента;
			Движение.Количество = ТекущаяСтрока.Количество * ТекущаяСтрока.Коэффициент;
			Движение.Номенклатура = ТекущаяСтрока.Номенклатура;
			Движение.СерияНоменклатуры = ТекущаяСтрока.СерияНоменклатуры;
			СуммаСебестоимостиСУчетомДоставки = ДокОбъект.ПолучитьСуммуСУчетомДоставки(ТекущаяСтрока);
			Движение.Сумма = РаботаСВалютой.ПолучитьСуммуВВалютеУчетаПоДокументу(СсылкаНаОбъект, СуммаСебестоимостиСУчетомДоставки);
			Движение.ХарактеристикаНоменклатуры = ТекущаяСтрока.ХарактеристикаНоменклатуры;
		КонецЦикла;
		Для Каждого ТекущаяСтрока Из ДокОбъект.Услуги Цикл
			Движение = НаборЗаписей.Добавить();
			Движение.Период = ДокОбъект.Дата;
			Движение.Организация = ДокОбъект.Организация;
			Движение.Подразделение = ДокОбъект.Подразделение;
			Движение.Контрагент = ДокОбъект.Контрагент;
			Движение.ДоговорКонтрагента = ДокОбъект.ДоговорКонтрагента;
			Движение.Количество = ТекущаяСтрока.Количество * ТекущаяСтрока.Коэффициент;
			Движение.Номенклатура = ТекущаяСтрока.Номенклатура;
			Движение.Сумма = РаботаСВалютой.ПолучитьСуммуВВалютеУчетаПоДокументу(СсылкаНаОбъект, ТекущаяСтрока.Сумма);
			Движение.ХарактеристикаНоменклатуры = ТекущаяСтрока.ХарактеристикаНоменклатуры;
		КонецЦикла;
		
		Попытка
			НаборЗаписей.Записать();
			РезультатОбработки.Успешно = Истина;
		Исключение
			РезультатОбработки.Успешно = Ложь;
			РезультатОбработки.ОписаниеОшибки = ОписаниеОшибки();
		КонецПопытки;
		
	КонецЕсли;
	
	Возврат РезультатОбработки;
	
КонецФункции

#КонецОбласти

#Область Обработка_2_7_0_0_Обязательные

Функция Обработка_2_7_0_0_Обязательные(СсылкаНаОбъект) Экспорт
	
	РезультатОбработки = Новый Структура;
	РезультатОбработки.Вставить("Успешно", Ложь);
	РезультатОбработки.Вставить("ОписаниеОшибки", "");
	
	// #6265
	Если ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.УстановкаСтоимостиВыработкиПоНоменклатуре") Тогда
		
		ДокОбъект = СсылкаНаОбъект.ПолучитьОбъект();
		
		МассивСтрокКДублированию = Новый Массив;
		Для каждого СтрокаТЧ из ДокОбъект.ВыработкаПоВидамНоменклатуры Цикл
			Если ЗначениеЗаполнено(СтрокаТЧ.Применение) Тогда
				Продолжить;
			КонецЕсли;
			
			Если СтрокаТЧ.ВидНоменклатуры = Справочники.ВидыНоменклатуры.Услуга Тогда
				СтрокаТЧ.Применение = Перечисления.ПрименениеНоменклатурыДляВыработки.ПроизводственныеУслуги;
			ИначеЕсли СтрокаТЧ.ВидНоменклатуры = Справочники.ВидыНоменклатуры.Отрез 
				ИЛИ СтрокаТЧ.ВидНоменклатуры = Справочники.ВидыНоменклатуры.Потолок 
				ИЛИ СтрокаТЧ.ВидНоменклатуры = Справочники.ВидыНоменклатуры.ТиповойОтрез Тогда
				СтрокаТЧ.Применение = Перечисления.ПрименениеНоменклатурыДляВыработки.Продукция;
				
				МассивСтрокКДублированию.Добавить(Новый Структура("ВидНоменклатуры, Применение", СтрокаТЧ.ВидНоменклатуры, СтрокаТЧ.Применение));
			Иначе
				СтрокаТЧ.Применение = Перечисления.ПрименениеНоменклатурыДляВыработки.Материалы;
			КонецЕсли;
		КонецЦикла;
		
		// а так же сделать копию данной строки и поставить "Применение"="Материалы""
		// т.к. одна продукция может быть материалом для другой продукции и старые документы выпуска уже начислили выработку по такой номенклатуре-материалу, которая была продукцией в другом выпуске.
		Для каждого СтрокаКДУблированию из МассивСтрокКДублированию Цикл
			НайденныеСтроки = ДокОбъект.ВыработкаПоВидамНоменклатуры.НайтиСтроки(СтрокаКДУблированию);
			Если НайденныеСтроки.Количество() > 0 Тогда
				СтруктураПоиска = Новый Структура("ВидНоменклатуры, Применение", НайденныеСтроки[0].ВидНоменклатуры, Перечисления.ПрименениеНоменклатурыДляВыработки.Материалы);
				НайденныеСтрокиКонтроль = ДокОбъект.ВыработкаПоВидамНоменклатуры.НайтиСтроки(СтруктураПоиска);
				Если НайденныеСтрокиКонтроль.Количество() = 0 Тогда
					НоваяСтрока = ДокОбъект.ВыработкаПоВидамНоменклатуры.Добавить();	
					ЗаполнитьЗначенияСвойств(НоваяСтрока, НайденныеСтроки[0]);
					НоваяСтрока.Применение = Перечисления.ПрименениеНоменклатурыДляВыработки.Материалы;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		
		Для каждого СтрокаТЧ из ДокОбъект.ВыработкаПоНоменклатуре Цикл
			Если СтрокаТЧ.Номенклатура.ВидНоменклатуры = Справочники.ВидыНоменклатуры.Услуга Тогда
				СтрокаТЧ.Применение = Перечисления.ПрименениеНоменклатурыДляВыработки.ПроизводственныеУслуги;
			Иначе
				СтрокаТЧ.Применение = Перечисления.ПрименениеНоменклатурыДляВыработки.Материалы;
			КонецЕсли;
		КонецЦикла;		
		
		Попытка
			ДокОбъект.ДополнительныеСвойства.Вставить("ПропуститьПроверкуЗапретаИзменения", Истина);
			ДокОбъект.Записать();
			РезультатОбработки.Успешно = Истина;
		Исключение
			ОтменитьТранзакцию();
			
			РезультатОбработки.Успешно = Ложь;
			РезультатОбработки.ОписаниеОшибки = ОписаниеОшибки();
			Возврат РезультатОбработки;
		КонецПопытки;	
		
		
	ИначеЕсли ТипЗнч(СсылкаНаОбъект) = Тип("СправочникСсылка.Пользователи") Тогда
		СпрОбъект = СсылкаНаОбъект.ПолучитьОбъект();
		Текст = СсылкаНаОбъект.УДАЛИТЬ_НомерСотовогоТелефона;
		
		Если ЗначениеЗаполнено(Текст) Тогда
			ВидИнформации = Справочники.ВидыКонтактнойИнформации.ТелефонПользователя;
			ТипИнформации = Перечисления.ТипыКонтактнойИнформации.Телефон;
			
			ЗначенияПолей = УправлениеКонтактнойИнформациейСлужебныйВызовСервера.КонтактнаяИнформацияXMLПоПредставлению(Текст, ВидИнформации);
			УправлениеКонтактнойИнформацией.ЗаписатьКонтактнуюИнформацию(СпрОбъект, ЗначенияПолей, ВидИнформации, ТипИнформации);
		КонецЕсли;
		
		Попытка
			СпрОбъект.Записать();
			РезультатОбработки.Успешно = Истина;
		Исключение			
			РезультатОбработки.Успешно = Ложь;
			РезультатОбработки.ОписаниеОшибки = ОписаниеОшибки();
			Возврат РезультатОбработки;
		КонецПопытки;
		
	ИначеЕсли ТипЗнч(СсылкаНаОбъект) = Тип("СправочникСсылка.Сотрудники") Тогда
		СпрОбъект = СсылкаНаОбъект.ПолучитьОбъект();
		//СпрРеквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СпрОбъект, "УДАЛИТЬ_КонтактныйТелефон,УДАЛИТЬ_ЛичныйТелефон, УДАЛИТЬ_ОсновнойEMail, УДАЛИТЬ_ЛичныйEMail, УДАЛИТЬ_АдресФактическогоПроживания");		
		
		Если ЗначениеЗаполнено(СпрОбъект.УДАЛИТЬ_КонтактныйТелефон) Тогда
			Текст = СпрОбъект.УДАЛИТЬ_КонтактныйТелефон;
			ВидИнформации = Справочники.ВидыКонтактнойИнформации.ТелефонСотрудника;
			ТипИнформации = Перечисления.ТипыКонтактнойИнформации.Телефон;
			
			ЗначенияПолей = УправлениеКонтактнойИнформациейСлужебныйВызовСервера.КонтактнаяИнформацияXMLПоПредставлению(Текст, ВидИнформации);
			УправлениеКонтактнойИнформацией.ЗаписатьКонтактнуюИнформацию(СпрОбъект, ЗначенияПолей, ВидИнформации, ТипИнформации);
		КонецЕсли;
		Если ЗначениеЗаполнено(СпрОбъект.УДАЛИТЬ_ОсновнойEMail) Тогда
			Текст = СпрОбъект.УДАЛИТЬ_ОсновнойEMail;
			ВидИнформации = Справочники.ВидыКонтактнойИнформации.EmailСотрудника;
			ТипИнформации = Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты;
			
			ЗначенияПолей = УправлениеКонтактнойИнформациейСлужебныйВызовСервера.КонтактнаяИнформацияXMLПоПредставлению(Текст, ВидИнформации);
			УправлениеКонтактнойИнформацией.ЗаписатьКонтактнуюИнформацию(СпрОбъект, ЗначенияПолей, ВидИнформации, ТипИнформации);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СпрОбъект.УДАЛИТЬ_ЛичныйТелефон) Тогда
			Текст = СпрОбъект.УДАЛИТЬ_ЛичныйТелефон;
			ВидИнформации = Справочники.ВидыКонтактнойИнформации.ЛичныйТелефонСотрудника;
			ТипИнформации = Перечисления.ТипыКонтактнойИнформации.Телефон;
			
			ЗначенияПолей = УправлениеКонтактнойИнформациейСлужебныйВызовСервера.КонтактнаяИнформацияXMLПоПредставлению(Текст, ВидИнформации);
			УправлениеКонтактнойИнформацией.ЗаписатьКонтактнуюИнформацию(СпрОбъект, ЗначенияПолей, ВидИнформации, ТипИнформации);
		КонецЕсли;
		Если ЗначениеЗаполнено(СпрОбъект.УДАЛИТЬ_ЛичныйEMail) Тогда
			Текст = СпрОбъект.УДАЛИТЬ_ЛичныйEMail;
			ВидИнформации = Справочники.ВидыКонтактнойИнформации.ЛичныйEmailСотрудника;
			ТипИнформации = Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты;
			
			ЗначенияПолей = УправлениеКонтактнойИнформациейСлужебныйВызовСервера.КонтактнаяИнформацияXMLПоПредставлению(Текст, ВидИнформации);
			УправлениеКонтактнойИнформацией.ЗаписатьКонтактнуюИнформацию(СпрОбъект, ЗначенияПолей, ВидИнформации, ТипИнформации);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СпрОбъект.УДАЛИТЬ_АдресФактическогоПроживания) Тогда
			Текст = СпрОбъект.УДАЛИТЬ_АдресФактическогоПроживания;
			ВидИнформации = Справочники.ВидыКонтактнойИнформации.ФактАдресСотрудника;
			ТипИнформации = Перечисления.ТипыКонтактнойИнформации.Адрес;
			
			ЗначенияПолей = УправлениеКонтактнойИнформациейСлужебныйВызовСервера.КонтактнаяИнформацияXMLПоПредставлению(Текст, ВидИнформации);
			УправлениеКонтактнойИнформацией.ЗаписатьКонтактнуюИнформацию(СпрОбъект, ЗначенияПолей, ВидИнформации, ТипИнформации);
		КонецЕсли;
		
		Попытка
			СпрОбъект.Записать();
			РезультатОбработки.Успешно = Истина;
		Исключение			
			РезультатОбработки.Успешно = Ложь;
			РезультатОбработки.ОписаниеОшибки = ОписаниеОшибки();
			Возврат РезультатОбработки;
		КонецПопытки;
		
	ИначеЕсли ТипЗнч(СсылкаНаОбъект) = Тип("СправочникСсылка.Организации") Тогда
		СпрОбъект = СсылкаНаОбъект.ПолучитьОбъект();
		
		Если ЗначениеЗаполнено(СпрОбъект.УДАЛИТЬ_ОсновнойСайт) Тогда
			Текст = СпрОбъект.УДАЛИТЬ_ОсновнойСайт;
			ВидИнформации = Справочники.ВидыКонтактнойИнформации.СайтОрганизации;
			ТипИнформации = Перечисления.ТипыКонтактнойИнформации.ВебСтраница;
			
			ЗначенияПолей = УправлениеКонтактнойИнформациейСлужебныйВызовСервера.КонтактнаяИнформацияXMLПоПредставлению(Текст, ВидИнформации);
			УправлениеКонтактнойИнформацией.ЗаписатьКонтактнуюИнформацию(СпрОбъект, ЗначенияПолей, ВидИнформации, ТипИнформации);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СпрОбъект.УДАЛИТЬ_ОсновнаяЭлектроннаяПочта) Тогда
			Текст = СпрОбъект.УДАЛИТЬ_ОсновнаяЭлектроннаяПочта;
			ВидИнформации = Справочники.ВидыКонтактнойИнформации.EmailОрганизации;
			ТипИнформации = Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты;
			
			ЗначенияПолей = УправлениеКонтактнойИнформациейСлужебныйВызовСервера.КонтактнаяИнформацияXMLПоПредставлению(Текст, ВидИнформации);
			УправлениеКонтактнойИнформацией.ЗаписатьКонтактнуюИнформацию(СпрОбъект, ЗначенияПолей, ВидИнформации, ТипИнформации);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СпрОбъект.УДАЛИТЬ_ОсновнойТелефон) Тогда
			Текст = СпрОбъект.УДАЛИТЬ_ОсновнойТелефон;
			ВидИнформации = Справочники.ВидыКонтактнойИнформации.ТелефонОрганизации;
			ТипИнформации = Перечисления.ТипыКонтактнойИнформации.Телефон;
			
			ЗначенияПолей = УправлениеКонтактнойИнформациейСлужебныйВызовСервера.КонтактнаяИнформацияXMLПоПредставлению(Текст, ВидИнформации);
			УправлениеКонтактнойИнформацией.ЗаписатьКонтактнуюИнформацию(СпрОбъект, ЗначенияПолей, ВидИнформации, ТипИнформации);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СпрОбъект.УДАЛИТЬ_ФактическийАдрес) Тогда
			Текст = СпрОбъект.УДАЛИТЬ_ФактическийАдрес;
			ВидИнформации = Справочники.ВидыКонтактнойИнформации.ФактАдресОрганизации;
			ТипИнформации = Перечисления.ТипыКонтактнойИнформации.Адрес;
			
			ЗначенияПолей = УправлениеКонтактнойИнформациейСлужебныйВызовСервера.КонтактнаяИнформацияXMLПоПредставлению(Текст, ВидИнформации);
			УправлениеКонтактнойИнформацией.ЗаписатьКонтактнуюИнформацию(СпрОбъект, ЗначенияПолей, ВидИнформации, ТипИнформации);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СпрОбъект.УДАЛИТЬ_ЮридическийАдрес) Тогда
			Текст = СпрОбъект.УДАЛИТЬ_ЮридическийАдрес;
			ВидИнформации = Справочники.ВидыКонтактнойИнформации.ЮрАдресОрганизации;
