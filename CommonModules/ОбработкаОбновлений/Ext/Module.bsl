		Попытка				
			ДокОбъект.ДополнительныеСвойства.Вставить("ПропуститьПроверкуЗапретаИзменения", Истина);
			ДокОбъект.Записать();
			
			НаборЗаписей = РегистрыНакопления.БонусыКонтрагентов.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.Регистратор.Установить(СсылкаНаОбъект);
			НаборЗаписей.Прочитать();
			НаборЗаписей.Очистить();
			
			Если ДокОбъект.СлужебныйВидБонуснойСистемы = Перечисления.ВидыБонусныхСистем.Внутренняя 
				И ДокОбъект.СуммаБонусовКНачислениюПоДисконтнойКарте > 0 Тогда
				Движение = НаборЗаписей.Добавить();
				Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
				Движение.Период = ДокОбъект.Дата;
				Движение.ДисконтнаяКарта = ДокОбъект.ДисконтнаяКарта;
				Движение.Контрагент = ДокОбъект.Контрагент;
				Движение.Сумма = -ДокОбъект.СуммаБонусовКНачислениюПоДисконтнойКарте;			
			КонецЕсли;
			
			НаборЗаписей.Записать();
			
			РезультатОбработки.Успешно = Истина;				
		Исключение				
			РезультатОбработки.Успешно = Ложь;
			РезультатОбработки.ОписаниеОшибки = ОписаниеОшибки();				
		КонецПопытки;
		
	Иначе
		РезультатОбработки.Успешно = Истина;
	КонецЕсли;
	
	
	
	Возврат РезультатОбработки;
	
