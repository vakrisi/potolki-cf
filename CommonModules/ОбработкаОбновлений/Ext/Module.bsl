//Вспомогательные функции процедуры для перехода на 2.0
// экспортные потому что используются во внешней обработке Дополнительные Обработки или в других документах
Функция ПеревестиЗаказДоговорВВерсию20(СсылкаДокумент) Экспорт
	
	РезультатОбработки = Новый Структура;
	РезультатОбработки.Вставить("Успешно", Истина);
	РезультатОбработки.Вставить("ОписаниеОшибки", "");
	
	Попытка
		НачатьТранзакцию();
		
		ЗаказДоговорОбъект = СсылкаДокумент.ПолучитьОбъект();
		
		//заполняем УИСы в ЗД
		Для Каждого ТекущаяСтрока Из ЗаказДоговорОбъект.ТоварыУслуги Цикл
			Если ПустаяСтрока(ТекущаяСтрока.УИСтроки) Тогда
				ТекущаяСтрока.УИСтроки = Новый УникальныйИдентификатор;
			КонецЕсли;
		КонецЦикла;
		Для Каждого ТекущаяСтрока Из ЗаказДоговорОбъект.Материалы Цикл
			Если ПустаяСтрока(ТекущаяСтрока.УИСтроки) Тогда
				ТекущаяСтрока.УИСтроки = Новый УникальныйИдентификатор;
			КонецЕсли;
		КонецЦикла;
		ЗаказДоговорОбъект.ЗаполнятьУИСтрок = Истина;
		
		//сохраняем ЗД, чтобы убедиться, что ничего не мешает его записать
		ЗаказДоговорОбъект.Записать();
		
		ТаблицаТоваровЗД = ЗаказДоговорОбъект.ТоварыУслуги.Выгрузить();
		ТаблицаТоваровЗД.Колонки.Добавить("Использован", новый ОписаниеТипов("булево"));
		ТаблицаМатериаловЗД = ЗаказДоговорОбъект.Материалы.Выгрузить();
		ТаблицаМатериаловЗД.Колонки.Добавить("Использован", новый ОписаниеТипов("булево"));
		
		//сначала обрабатываем проведенные монтажи
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	Монтаж.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.Монтаж КАК Монтаж
		|ГДЕ
		|	Монтаж.Основание = &Основание
		|	И Монтаж.Проведен";
		Запрос.УстановитьПараметр("Основание",СсылкаДокумент);
		
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			МонтажОбъект = Выборка.Ссылка.ПолучитьОбъект();
			//товары монтажа
			Для Каждого ТекущаяСтрока Из МонтажОбъект.ТоварыУслуги Цикл
				Если ПустаяСтрока(ТекущаяСтрока.УИСтроки) Тогда
					
					Отбор = Новый Структура;
					Отбор.Вставить("Комната",ТекущаяСтрока.Комната);
					Отбор.Вставить("Номенклатура",ТекущаяСтрока.Номенклатура);
					Отбор.Вставить("ХарактеристикаНоменклатуры",ТекущаяСтрока.ХарактеристикаНоменклатуры);
					
					Отбор.Вставить("Количество",ТекущаяСтрока.Количество);
					Отбор.Вставить("Коэффициент",ТекущаяСтрока.Коэффициент);
					Отбор.Вставить("Цена",ТекущаяСтрока.Цена);
					Отбор.Вставить("ПроцентСкидки",ТекущаяСтрока.ПроцентСкидки);
					Отбор.Вставить("СуммаСкидки",ТекущаяСтрока.СуммаСкидки);
					Отбор.Вставить("Сумма",ТекущаяСтрока.Сумма);
					Отбор.Вставить("ЕдиницаИзмерения",ТекущаяСтрока.ЕдиницаИзмерения);
					
					Отбор.Вставить("Использован",Ложь);
					
					НайденныеСтроки = ТаблицаТоваровЗД.НайтиСтроки(Отбор);
					Если НайденныеСтроки.Количество() > 0 Тогда
						ТекущаяСтрока.УИСтроки = НайденныеСтроки[0].УИСтроки;
						НайденныеСтроки[0].Использован = Истина;
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
			
			//материалы монтажа
			Для Каждого ТекущаяСтрока Из МонтажОбъект.Материалы Цикл
				Если ПустаяСтрока(ТекущаяСтрока.УИСтроки) Тогда
					Отбор = Новый Структура;
					Отбор.Вставить("Использован",Ложь);
					Отбор.Вставить("Комната",ТекущаяСтрока.Комната);
					Отбор.Вставить("Номенклатура",ТекущаяСтрока.Номенклатура);
					Отбор.Вставить("ХарактеристикаНоменклатуры",ТекущаяСтрока.ХарактеристикаНоменклатуры);
					НайденныеСтроки = ТаблицаМатериаловЗД.НайтиСтроки(Отбор);
					Если НайденныеСтроки.Количество() > 0 Тогда
						ТекущаяСтрока.УИСтроки = НайденныеСтроки[0].УИСтроки;
						НайденныеСтроки[0].Использован = Истина;
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
			
			//обработали монтаж, записываем
			МонтажОбъект.Записать();
		КонецЦикла;
		
		//потом обрабатываем не проведенные, но и не помеченные на удаление монтажи
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	Монтаж.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.Монтаж КАК Монтаж
		|ГДЕ
		|	Монтаж.Основание = &Основание
		|	И НЕ Монтаж.Проведен
		|	И НЕ Монтаж.ПометкаУдаления";
		Запрос.УстановитьПараметр("Основание",СсылкаДокумент);
		
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			МонтажОбъект = Выборка.Ссылка.ПолучитьОбъект();
			//товары монтажа
			Для Каждого ТекущаяСтрока Из МонтажОбъект.ТоварыУслуги Цикл
				Если ПустаяСтрока(ТекущаяСтрока.УИСтроки) Тогда
					
					Отбор = Новый Структура;
					Отбор.Вставить("Комната",ТекущаяСтрока.Комната);
					Отбор.Вставить("Номенклатура",ТекущаяСтрока.Номенклатура);
					Отбор.Вставить("ХарактеристикаНоменклатуры",ТекущаяСтрока.ХарактеристикаНоменклатуры);
					
					Отбор.Вставить("Количество",ТекущаяСтрока.Количество);
					Отбор.Вставить("Коэффициент",ТекущаяСтрока.Коэффициент);
					Отбор.Вставить("Цена",ТекущаяСтрока.Цена);
					Отбор.Вставить("ПроцентСкидки",ТекущаяСтрока.ПроцентСкидки);
					Отбор.Вставить("СуммаСкидки",ТекущаяСтрока.СуммаСкидки);
					Отбор.Вставить("Сумма",ТекущаяСтрока.Сумма);
					Отбор.Вставить("ЕдиницаИзмерения",ТекущаяСтрока.ЕдиницаИзмерения);
					
