			РезультатОбработки.ОписаниеОшибки = ОписаниеОшибки();
			Возврат РезультатОбработки;
		КонецПопытки;
		
		//++ №6629 в документах резервирования и снятие с резервов заполнить новые реквизиты "Вид табличной части"
	ИначеЕсли ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.Резервирование") ИЛИ ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.СнятиеРезервов") Тогда
		
		// 1. Заполняем в документах новый реквизит
		ДокОбъект = СсылкаНаОбъект.ПолучитьОбъект();
		
		Для Каждого ТекущаяСтрока Из ДокОбъект.Товары Цикл
			ТекущаяСтрока.ВидТабличнойЧасти = Перечисления.ВидыТабличнойЧасти.Товары;
