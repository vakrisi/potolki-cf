Функция Обработка_3_0_3_0(СсылкаНаОбъект, ОбработкаОбязательныхОбъектов, ВерсияПрограммыЧисло) Экспорт
	
	Если ОбработкаОбязательныхОбъектов Тогда
		Возврат Обработка_3_0_3_0_Обязательные(СсылкаНаОбъект);
	КонецЕсли;
	
	РезультатОбработки = Новый Структура;
	РезультатОбработки.Вставить("Успешно", Ложь);
	РезультатОбработки.Вставить("ОписаниеОшибки", "");
	
	// №14649 у всех выездов лида:
	// а) у которых стоит галочка "Выполнен" поставить результат = РезультатыВыездаЛида.ВыездВыполнен
	// б) заполнить новый реквизит дата назначения
	Если ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.Лид")	Тогда
		
		ПервыйЭтапБезОшибок = Истина;
		
		ДокументОбъект = СсылкаНаОбъект.ПолучитьОбъект();
		
		Для Каждого ТекущаяСтрока Из ДокументОбъект.Выезды Цикл
			
			// Заполняем результат выезда
			Если ТекущаяСтрока.Выполнен Тогда
				ТекущаяСтрока.Результат = Справочники.РезультатыВыездаЛида.ВыездВыполнен;
			КонецЕсли;
			
			// Заполняем дату назначения
			ТекущаяСтрока.ДатаНазначения =  ОбщийМодульКлиентСервер.СоединитьДатуИВремя(ТекущаяСтрока.Дата, ТекущаяСтрока.ВремяНачала);
			
		КонецЦикла;
		
		Попытка
			
			ДокументОбъект.ОбменДанными.Загрузка = Истина;
			ДокументОбъект.Записать(); // Только запись, т.к. нужно исключить все проверки, в регистре меняем отдельно ниже
			
		Исключение
			
			ПервыйЭтапБезОшибок = Ложь;
			
			РезультатОбработки.Успешно = Ложь;
			РезультатОбработки.ОписаниеОшибки = ОписаниеОшибки();
			
			Возврат РезультатОбработки;
			
		КонецПопытки;
		
		Если ПервыйЭтапБезОшибок Тогда
			
			НаборЗаписей = РегистрыСведений.Замеры.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.Регистратор.Установить(СсылкаНаОбъект);
			
			НаборЗаписей.Прочитать();
			
			Для Каждого ТекущаяЗапись Из НаборЗаписей Цикл
				
				Если ТекущаяЗапись.ЭтоВыезд Тогда
					
					// Заполняем результат выезда
					Если ТекущаяЗапись.ЗамерВыполнен Тогда
						ТекущаяЗапись.Результат = Справочники.РезультатыВыездаЛида.ВыездВыполнен;
					КонецЕсли;
					
					// Заполняем дату назначения
					Если ЗначениеЗаполнено(ТекущаяЗапись.ИДЗамера) Тогда
						СтруктураПоиска = новый Структура("ИДЗамера", ТекущаяЗапись.ИДЗамера);
					Иначе
						СтруктураПоиска = новый Структура("Исполнитель, Дата, ВремяНачала", ТекущаяЗапись.Сотрудник, ТекущаяЗапись.Дата, ТекущаяЗапись.ВремяНачала);
					КонецЕсли;
					
					// Ищем выезд в документе, чтобы оттуда взять дату назначения
					НайденныеСтроки = ДокументОбъект.Выезды.НайтиСтроки(СтруктураПоиска);
					
					Если НайденныеСтроки.Количество() > 0 Тогда
						ТекущаяЗапись.ДатаНазначенияЗамера = НайденныеСтроки[0].ДатаНазначения;
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЦикла;
			
			Попытка
				
				РезультатОбработки.Успешно = Истина;
				НаборЗаписей.Записать();
				
			Исключение
				
				РезультатОбработки.Успешно = Ложь;
				РезультатОбработки.ОписаниеОшибки = ОписаниеОшибки();
				
			КонецПопытки;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат РезультатОбработки;
	
КонецФункции

