#Область Обработка_2_8_0_Sa

Функция Обработка_2_8_0_Sa(СсылкаДокумент) Экспорт
	
	РезультатОбработки = Новый Структура;
	РезультатОбработки.Вставить("Успешно", Ложь);
	РезультатОбработки.Вставить("ОписаниеОшибки", "");
	
	//++ №11768 автоматическая обработка очереди не должна никак обрабатывать документы "Заказ-договор", пользователь должен обработать их только вручную
	Если ТипЗнч(СсылкаДокумент) = Тип("ДокументСсылка.ЗаказДоговор") Тогда
		
		РезультатОбработки.Успешно = Ложь;
		РезультатОбработки.ОписаниеОшибки = "Требуется ручная обработка непосредственно в документе.";
		
		Возврат РезультатОбработки;
		
	КонецЕсли;
	//-- №11768
	
	Возврат РезультатОбработки;
	
КонецФункции

#КонецОбласти

#Область Обработка_2_8_7_0

Функция Обработка_2_8_7_0(СсылкаНаОбъект, ОбработкаОбязательныхОбъектов) Экспорт
	
	Если ОбработкаОбязательныхОбъектов Тогда
		Возврат Обработка_2_8_7_0_Обязательные(СсылкаНаОбъект);
	КонецЕсли;
	
	РезультатОбработки = Новый Структура;
	РезультатОбработки.Вставить("Успешно", Ложь);
	РезультатОбработки.Вставить("ОписаниеОшибки", "");
	
	//#12948
	Если ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.НачислениеЗарплаты") 
		ИЛИ ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.РасходныйКассовыйОрдер")
		ИЛИ ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.СписаниеСРасчетногоСчета") 
		ИЛИ ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.ВыплатаЗарплатыВНатуральнойФорме")
		Тогда
		
		НаборЗаписей = РегистрыНакопления.РасчетыСПерсоналом.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Регистратор.Установить(СсылкаНаОбъект);
		НаборЗаписей.Прочитать();
		Для каждого Движение из НаборЗаписей Цикл
			Движение.Период	= Движение.Регистратор.Дата;
			Движение.ПериодРегистрации = Движение.Регистратор.ПериодРегистрации;
		КонецЦикла;
		
		Попытка
			НаборЗаписей.Записать();
			РезультатОбработки.Успешно = Истина;
		Исключение
			РезультатОбработки.Успешно = Ложь;
			РезультатОбработки.ОписаниеОшибки = ОписаниеОшибки();
		КонецПопытки;
		
	КонецЕсли;
	
	Возврат РезультатОбработки;
	
КонецФункции

#КонецОбласти

#Область Обработка_2_8_7_0

Функция Обработка_2_8_7_0_Обязательные(СсылкаНаОбъект) Экспорт
	
	РезультатОбработки = Новый Структура;
	РезультатОбработки.Вставить("Успешно", Ложь);
	РезультатОбработки.Вставить("ОписаниеОшибки", "");
	
	// №12975 СОРД в связке с заказ-договором нужно перепровести, поменялись движения
	Если ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.СоглашениеОРасторженииДоговора") Тогда
		
		ДокОбъект = СсылкаНаОбъект.ПолучитьОбъект();
		
		ЗаказДоговорОбъект = ДокОбъект.ЗаказДоговор.ПолучитьОбъект();
		
		УспешноПровелся = Истина;
		Попытка
			ЗаказДоговорОбъект.Записать(?(ЗаказДоговорОбъект.Проведен, РежимЗаписиДокумента.Проведение, РежимЗаписиДокумента.Запись));
			РезультатОбработки.Успешно = Истина;
		Исключение
			УспешноПровелся = Ложь;
			РезультатОбработки.Успешно = Ложь;
			РезультатОбработки.ОписаниеОшибки = "Не удалось обновить связанный заказ-договор: " + ОписаниеОшибки();
		КонецПопытки;
		
		Если УспешноПровелся Тогда
			
			Попытка
				ДокОбъект.Записать(?(ДокОбъект.Проведен, РежимЗаписиДокумента.Проведение, РежимЗаписиДокумента.Запись));
				РезультатОбработки.Успешно = Истина;
			Исключение
				РезультатОбработки.Успешно = Ложь;
				РезультатОбработки.ОписаниеОшибки = ОписаниеОшибки();
			КонецПопытки;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат РезультатОбработки;
	
КонецФункции

#КонецОбласти

#Область Обработка_2_8_8_0

Функция Обработка_2_8_8_0(СсылкаНаОбъект, ОбработкаОбязательныхОбъектов) Экспорт
	
	Если ОбработкаОбязательныхОбъектов Тогда
		Возврат Обработка_2_8_8_0_Обязательные(СсылкаНаОбъект);
	КонецЕсли;
	
	РезультатОбработки = Новый Структура;
	РезультатОбработки.Вставить("Успешно", Ложь);
	РезультатОбработки.Вставить("ОписаниеОшибки", "");
	
	//##12975
	Если ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.ЗаказДоговор")
		Тогда
		
		НаборЗаписей = РегистрыНакопления.ПродажиПоЗаказДоговорам.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Регистратор.Установить(СсылкаНаОбъект);
		НаборЗаписей.Прочитать();
		Для каждого Движение из НаборЗаписей Цикл
			Движение.Контрагент	= СсылкаНаОбъект.Контрагент;
		КонецЦикла;
		
		Попытка
			НаборЗаписей.Записать();
			РезультатОбработки.Успешно = Истина;
		Исключение
			РезультатОбработки.Успешно = Ложь;
			РезультатОбработки.ОписаниеОшибки = ОписаниеОшибки();
		КонецПопытки;
	ИначеЕсли ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.СоглашениеОРасторженииДоговора")
		Тогда
		
		НаборЗаписей = РегистрыНакопления.ПродажиПоЗаказДоговорам.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Регистратор.Установить(СсылкаНаОбъект);
		НаборЗаписей.Прочитать();
		Для каждого Движение из НаборЗаписей Цикл
			Движение.Контрагент	= СсылкаНаОбъект.ЗаказДоговор.Контрагент;
		КонецЦикла;
		
		Попытка
			НаборЗаписей.Записать();
			РезультатОбработки.Успешно = Истина;
		Исключение
			РезультатОбработки.Успешно = Ложь;
			РезультатОбработки.ОписаниеОшибки = ОписаниеОшибки();
		КонецПопытки;
		
		//#12822 удалить движения «Возврат продукции» по регистру "Заказы покупателей".
	ИначеЕсли ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.ВозвратПродукции") Тогда
		
		НаборЗаписей = РегистрыНакопления.ЗаказыПокупателей.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Регистратор.Установить(СсылкаНаОбъект);
		НаборЗаписей.Прочитать();		
		Попытка
			НаборЗаписей.Очистить();
			НаборЗаписей.Записать();
			РезультатОбработки.Успешно = Истина;
		Исключение
			РезультатОбработки.Успешно = Ложь;
			РезультатОбработки.ОписаниеОшибки = ОписаниеОшибки();
		КонецПопытки;
		
		//#12822 заполнить новый реквизит "Компенсация по возврату"
	ИначеЕсли ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.ВозвратТовараОтПокупателя") Тогда
		
		ДокОбъект = СсылкаНаОбъект.ПолучитьОбъект();
		
		Для каждого СтрокаТЧ из ДокОбъект.Товары Цикл
			Если НЕ ЗначениеЗаполнено(СтрокаТЧ.КомпенсацияПоВозврату) Тогда
				СтрокаТЧ.КомпенсацияПоВозврату = Перечисления.ВариантыКомпенсацииПоВозврату.ОтгрузитьПовторно;
			КонецЕсли;
		КонецЦикла;
		
		ДокОбъект.ДополнительныеСвойства.Вставить("ПропуститьПроверкуЗапретаИзменения", Истина);
		Попытка
			ДокОбъект.Записать(); // Только запись
			РезультатОбработки.Успешно = Истина;
		Исключение
			РезультатОбработки.Успешно = Ложь;
			РезультатОбработки.ОписаниеОшибки = ОписаниеОшибки();
		КонецПопытки;
		
	КонецЕсли;
	
	Возврат РезультатОбработки;
	
КонецФункции

#КонецОбласти

#Область Обработка_2_8_8_0_Обязательные

Функция Обработка_2_8_8_0_Обязательные(СсылкаНаОбъект) Экспорт
	
	РезультатОбработки = Новый Структура;
	РезультатОбработки.Вставить("Успешно", Ложь);
	РезультатОбработки.Вставить("ОписаниеОшибки", "");
	
	// №12909 новый реквизит "Наименование для печати" в карточке номенклатуры
	Если ТипЗнч(СсылкаНаОбъект) = Тип("СправочникСсылка.Номенклатура") Тогда
		
		НоменклатураОбъект = СсылкаНаОбъект.ПолучитьОбъект();
		
		НоменклатураОбъект.НаименованиеДляПечати = НоменклатураОбъект.Наименование;
		
		НоменклатураОбъект.ОбменДанными.Загрузка = Истина;
		
		Попытка
			
			НоменклатураОбъект.Записать();
			РезультатОбработки.Успешно = Истина;
			
		Исключение
			
			РезультатОбработки.Успешно = Ложь;
			РезультатОбработки.ОписаниеОшибки = "Не удалось установить наименование для печати: " + ОписаниеОшибки();
			
		КонецПопытки;
		
		// №12802 в монтажах со статусами "Выполнен" или "Закрыт" дату выполнения сделать равной дате документа
	ИначеЕсли ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.Монтаж") Тогда
		
		ДокОбъект = СсылкаНаОбъект.ПолучитьОбъект();
		
		Если ДокОбъект.Результат = Справочники.РезультатыМонтажа.Выполнен Или ДокОбъект.Результат = Справочники.РезультатыМонтажа.Закрыт Тогда
			ДокОбъект.ДатаВыполнения = ДокОбъект.Дата;
		КонецЕсли;
		
		ДокОбъект.ДополнительныеСвойства.Вставить("ПропуститьПроверкуЗапретаИзменения", Истина);
		Попытка
			ДокОбъект.Записать(?(ДокОбъект.Проведен, РежимЗаписиДокумента.Проведение, РежимЗаписиДокумента.Запись));
			РезультатОбработки.Успешно = Истина;
		Исключение
			РезультатОбработки.Успешно = Ложь;
			РезультатОбработки.ОписаниеОшибки = ОписаниеОшибки();
		КонецПопытки;
		
	КонецЕсли;	
	
	Возврат РезультатОбработки;
	
КонецФункции

#КонецОбласти

