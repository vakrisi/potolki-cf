		ДокОбъект.Движения.РасчетыПоЗаказам.Очистить();
		
		Попытка   
			ДокОбъект.Движения.ЗаказыПокупателей.Записать();
			ДокОбъект.Движения.РасчетыПоЗаказам.Записать();
			//ДокОбъект.Записать(РежимЗаписиДокумента.Проведение); 
			РезультатОбработки.Успешно = Истина;
		Исключение
			РезультатОбработки.Успешно = Ложь;
			РезультатОбработки.ОписаниеОшибки = ОписаниеОшибки();
		КонецПопытки;
		
		//#13885
	ИначеЕсли ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.ЗаказНаПроизводство") Тогда
		
		ДокОбъект = СсылкаНаОбъект.ПолучитьОбъект();
		
		ДокОбъект.СуммаДокумента = ДокОбъект.Товары.Итог("Сумма") + ДокОбъект.Услуги.Итог("Сумма") + ДокОбъект.ПродукцияСумма + ДокОбъект.Продукция.Итог("Сумма");
		
		Попытка
			ДокОбъект.ДополнительныеСвойства.Вставить("ПропуститьПроверкуЗапретаИзменения", Истина);
			ДокОбъект.Записать(); 
			РезультатОбработки.Успешно = Истина;
		Исключение
			РезультатОбработки.Успешно = Ложь;
			РезультатОбработки.ОписаниеОшибки = ОписаниеОшибки();
		КонецПопытки;
		
	КонецЕсли;
	
	Возврат РезультатОбработки;
	
