					Движение = НаборЗаписей.Добавить();
					Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
					Движение.Период 	 = ДокОбъект.Дата;
					Движение.Заказ 		 = ТекущаяСтрока.ДокументПродажи;			
					Движение.Контрагент  = ДокОбъект.Контрагент;
					Движение.Сумма 		 = ТекущаяСтрока.Сумма;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
		Для Каждого ТекущаяСтрока Из ДокОбъект.ЗачетАванса Цикл
			Если ТекущаяСтрока.Сумма = 0 Тогда
				Продолжить;
			КонецЕсли;
			
			НайденныйВидДокумента = СписокВидовДокументовПоКоторымВедутсяРасчеты.Найти(ТипЗнч(ТекущаяСтрока.Документ));
			Если НайденныйВидДокумента = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			Движение = НаборЗаписей.Добавить();
			Движение.Период = ДокОбъект.Дата;
			Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
			Движение.Заказ = ТекущаяСтрока.Документ;
			Движение.Контрагент = ДокОбъект.Контрагент;
			Если ТекущаяСтрока.Документ.Валюта = ДокОбъект.Валюта ИЛИ ТекущаяСтрока.СуммаВВалютеДокумента = 0 Тогда 
