			РезультатОбработки.ОписаниеОшибки = ОписаниеОшибки();				
		КонецПопытки;
		
		
		//#15395
	ИначеЕсли ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.ВозвратПродукции") Тогда
		
		ДокОбъект = СсылкаНаОбъект.ПолучитьОбъект();
		
		НаборЗаписей = РегистрыНакопления.РасчетыПоЗаказам.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Регистратор.Установить(СсылкаНаОбъект);
		НаборЗаписей.Прочитать();
		
		
		Если НЕ ДокОбъект.УменьшитьДолгКонтрагента Тогда
			НаборЗаписей.Очистить();
		Иначе		
			НайденныеСтроки = ДокОбъект.ЗачетАванса.НайтиСтроки(Новый Структура("Документ", ДокОбъект.Основание));
			
			Если ТипЗнч(ДокОбъект.Основание) = Тип("ДокументСсылка.РеализацияТоваровИУслуг") 
				И Не ДокОбъект.Основание.Пустая() 
				И Константы.ВестиРасчетыПоЗаказамПоРТиУ.Получить()
				И НаборЗаписей.Количество() > 0 
				И НайденныеСтроки.Количество() = 0
				Тогда
				
				НоваяСтрока = ДокОбъект.ЗачетАванса.Добавить();
				НоваяСтрока.Документ = ДокОбъект.Основание;
				НоваяСтрока.Сумма = ДокОбъект.Товары.Итог("Сумма");
				Если НЕ ДокОбъект.Валюта = ПолучитьФункциональнуюОпцию("ВалютаУчета") 
					ИЛИ НЕ ДокОбъект.Основание.Валюта = ДокОбъект.Валюта  Тогда
					НоваяСтрока.СуммаВВалютеДокумента = РаботаСВалютой.ПересчитатьИзВалютыВВалюту(ДокОбъект.Валюта, ДокОбъект.Основание.Валюта, ДокОбъект.Дата, НоваяСтрока.Сумма);
				КонецЕсли;			
			КонецЕсли;		
		КонецЕсли;
		
		Для каждого СтрокаТЧ из ДокОбъект.Товары Цикл
			СтрокаТЧ.ВариантОпределенияСебестоимости = Перечисления.ВариантыОпределенияСебестоимостиПоВозвратам.РучноеУказание;	
			
			Если ДокОбъект.БракПроизводства Тогда
				Если НЕ ДокОбъект.УДАЛИТЬ_ОтветственностьИсполнителейПоСебестоимости Тогда
					СтрокаТЧ.ВариантОпределенияОтветственности = Перечисления.ВариантыОпределенияОтветственностиПоВозвратам.ПоСумме;
					СтрокаТЧ.Ответственность = СтрокаТЧ.Сумма;
				Иначе
					СтрокаТЧ.ВариантОпределенияОтветственности = Перечисления.ВариантыОпределенияОтветственностиПоВозвратам.ПоСебестоимости;
					СтрокаТЧ.Ответственность = СтрокаТЧ.Себестоимость;					
				КонецЕсли;
			КонецЕсли;
			
			СтрокаТЧ.Себестоимость = СтрокаТЧ.Сумма; // так как по ней приходовалось на склад
		КонецЦикла;
		
		Попытка
			НаборЗаписей.Записать();
			
			ДокОбъект.ДополнительныеСвойства.Вставить("ПропуститьПроверкуЗапретаИзменения", Истина);
			ДокОбъект.Записать();
			
			РезультатОбработки.Успешно = Истина;				
		Исключение				
			РезультатОбработки.Успешно = Ложь;
			РезультатОбработки.ОписаниеОшибки = ОписаниеОшибки();				
		КонецПопытки;
		
	КонецЕсли;
	
	Возврат РезультатОбработки;
	
КонецФункции

