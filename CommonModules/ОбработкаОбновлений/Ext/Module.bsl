Процедура ОчиститьПодразделениеВДокументе(СсылкаНаОбъект, РезультатОбработки)
	
	ДокОбъект = СсылкаНаОбъект.ПолучитьОбъект();
	Если НЕ ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.Замена") Тогда
		ДокОбъект.Подразделение = Справочники.Подразделения.ПустаяСсылка(); 				
	КонецЕсли;
	
	Попытка
		ДокОбъект.ДополнительныеСвойства.Вставить("ПропуститьПроверкуЗапретаИзменения", Истина);
		ДокОбъект.ОбменДанными.Загрузка = Истина;
		ДокОбъект.Записать();
		РезультатОбработки.Успешно = Истина;
		
		// в этом случае надо очистить подразделения в движениях
		Если НЕ ДокОбъект.Движения.Найти("ВыработкаИсполнителейПроизводства") = Неопределено Тогда
			ДокОбъект.Движения.ВыработкаИсполнителейПроизводства.Прочитать();
			Для каждого Запись из ДокОбъект.Движения.ВыработкаИсполнителейПроизводства Цикл
				Запись.Подразделение = Справочники.Подразделения.ПустаяСсылка();
			КонецЦикла;
			ДокОбъект.Движения.ВыработкаИсполнителейПроизводства.Записать();
		КонецЕсли;
		Если НЕ ДокОбъект.Движения.Найти("ДоходыРасходы") = Неопределено Тогда
			ДокОбъект.Движения.ДоходыРасходы.Прочитать();
			Для каждого Запись из ДокОбъект.Движения.ДоходыРасходы Цикл
				Запись.Подразделение = Справочники.Подразделения.ПустаяСсылка();
			КонецЦикла;
			ДокОбъект.Движения.ДоходыРасходы.Записать();
		КонецЕсли;
		Если НЕ ДокОбъект.Движения.Найти("Закупки") = Неопределено Тогда
			ДокОбъект.Движения.Закупки.Прочитать();
			Для каждого Запись из ДокОбъект.Движения.Закупки Цикл
				Запись.Подразделение = Справочники.Подразделения.ПустаяСсылка();
			КонецЦикла;
			ДокОбъект.Движения.Закупки.Записать();
		КонецЕсли;
		Если НЕ ДокОбъект.Движения.Найти("Продажи") = Неопределено Тогда				
			ДокОбъект.Движения.Продажи.Прочитать();
			Для каждого Запись из ДокОбъект.Движения.Продажи Цикл
				Запись.Подразделение = Справочники.Подразделения.ПустаяСсылка();
				Запись.ПодразделениеЗаказа = Справочники.Подразделения.ПустаяСсылка();
			КонецЦикла;
			ДокОбъект.Движения.Продажи.Записать();
		КонецЕсли;
		Если НЕ ДокОбъект.Движения.Найти("РасходМатериаловНаПроизводстве") = Неопределено Тогда
			ДокОбъект.Движения.РасходМатериаловНаПроизводстве.Прочитать();
			Для каждого Запись из ДокОбъект.Движения.РасходМатериаловНаПроизводстве Цикл
				Запись.Подразделение = Справочники.Подразделения.ПустаяСсылка();
			КонецЦикла;
			ДокОбъект.Движения.РасходМатериаловНаПроизводстве.Записать();
		КонецЕсли;
		
	Исключение			
		РезультатОбработки.Успешно = Ложь;
		РезультатОбработки.ОписаниеОшибки = ОписаниеОшибки();
	КонецПопытки;
	
КонецПроцедуры

