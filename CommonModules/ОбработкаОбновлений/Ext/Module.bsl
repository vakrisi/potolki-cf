		ИЛИ ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.Замена")
		ИЛИ ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.Монтаж")
		ИЛИ ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.РеализацияТоваровИУслуг") 
		ИЛИ ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.СоглашениеОРасторженииДоговора")
		ИЛИ ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.ЧекККМ")
		Тогда
		
		ВалютаУчета = ПолучитьФункциональнуюОпцию("ВалютаУчета");
		
		НаборЗаписей = РегистрыНакопления.Продажи.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Регистратор.Установить(СсылкаНаОбъект);
		
		НаборЗаписей.Прочитать();
		НаборЗаписей.Очистить();
		
		// берем код из модулей объектов
		Если ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.ВозвратПродукции") Тогда
			
			Для Каждого ТекущаяСтрока Из СсылкаНаОбъект.Товары Цикл
				Движение = НаборЗаписей.Добавить();
				Движение.Период = СсылкаНаОбъект.Дата;
				Движение.Организация = СсылкаНаОбъект.Организация;
				Движение.Подразделение = СсылкаНаОбъект.Подразделение;
				Движение.Склад = СсылкаНаОбъект.Склад;  //#12367
				Движение.ДоговорКонтрагента = СсылкаНаОбъект.ДоговорКонтрагента;
				Движение.ДокументПродажи = СсылкаНаОбъект.Основание;
				Движение.ЗаказПокупателя = ТекущаяСтрока.ЗаказПокупателя;
				Движение.Контрагент = СсылкаНаОбъект.Контрагент;
				Движение.Номенклатура = ТекущаяСтрока.Номенклатура;
				Движение.ХарактеристикаНоменклатуры = ТекущаяСтрока.ХарактеристикаНоменклатуры;
				Движение.СерияНоменклатуры = ТекущаяСтрока.СерияНоменклатуры;
				Движение.ЕдиницаИзмерения = ТекущаяСтрока.ЕдиницаИзмерения;         //#14300
				Движение.КоличествоВЕдиницахДокумента = -ТекущаяСтрока.Количество;	//#14300
				Движение.Количество = -ТекущаяСтрока.Количество * ТекущаяСтрока.Коэффициент;
				Движение.Сумма = -РаботаСВалютой.ПересчитатьИзВалютыВВалюту(СсылкаНаОбъект.Валюта, ВалютаУчета, СсылкаНаОбъект.Дата, ТекущаяСтрока.Сумма);
				Движение.СуммаВал = -РаботаСВалютой.ПолучитьСуммуВДопВалютеУчетаПоДокументу(СсылкаНаОбъект, ТекущаяСтрока.Сумма); //#8288				
				Если ЗначениеЗаполнено(Движение.ЗаказПокупателя) Тогда
					Движение.ПодразделениеЗаказа = Движение.ЗаказПокупателя.Подразделение;		
				КонецЕсли;		
			КонецЦикла;
			
		ИначеЕсли ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.ВозвратТовараОтПокупателя") Тогда
			
