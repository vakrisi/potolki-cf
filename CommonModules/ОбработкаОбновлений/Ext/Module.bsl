Функция Обработка_3_0_0_0(СсылкаНаОбъект, ОбработкаОбязательныхОбъектов, ВерсияПрограммыЧисло) Экспорт
	
	Если ОбработкаОбязательныхОбъектов Тогда
		Возврат Обработка_3_0_0_0_Обязательные(СсылкаНаОбъект);
	КонецЕсли;
	
	РезультатОбработки = Новый Структура;
	РезультатОбработки.Вставить("Успешно", Ложь);
	РезультатОбработки.Вставить("ОписаниеОшибки", "");
	
	// №13851 дубли номенклатур по номерам расчетов (исключая типовые отрезы) для ручного исправления
	Если ТипЗнч(СсылкаНаОбъект) = Тип("СправочникСсылка.Номенклатура") Тогда
		
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("Потолок_НомерРасчета",  СсылкаНаОбъект.Потолок_НомерРасчета);
		Запрос.УстановитьПараметр("Потолок_ИндексПотолка", СсылкаНаОбъект.Потолок_ИндексПотолка);
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	Номенклатура.Потолок_НомерРасчета КАК НомерРасчета,
		|	Номенклатура.Потолок_ИндексПотолка КАК ИндексПотолка
		|ИЗ
		|	Справочник.Номенклатура КАК Номенклатура
		|ГДЕ
		|	Номенклатура.Потолок_НомерРасчета = &Потолок_НомерРасчета 
		|	И Номенклатура.Потолок_ИндексПотолка = &Потолок_ИндексПотолка	
		|";
		
		РезультатЗапроса = Запрос.Выполнить().Выгрузить();
		Если РезультатЗапроса.Количество() = 1 Тогда
			// номенклатура или ее дубль были обработаны внешними обработками, убираем из списка
			РезультатОбработки.Успешно = Истина;
		Иначе
			РезультатОбработки.Успешно = Ложь;
			РезультатОбработки.ОписаниеОшибки = "В справочнике имеется дубль по номеру расчета. Требуется ручная обработка.";
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.Лид") Тогда
		//++ #13943 для заполнения нового реквизита Менеджер
		
		// Если у лида перед выполнением обработчика менеджер уже заполнен, то просто убирает лид из очереди
		
		// если у пользователя реквизита "Автор" указан "Сотрудник", и у лида пустой менеджер, 
		// то обработчик ставит данного сотрудника менеджером лида и убирает лид из очереди.		
		
		Если ВерсияПрограммыЧисло = 3000000999 Тогда
			
			ДокОбъект = СсылкаНаОбъект.ПолучитьОбъект();
			Если ЗначениеЗаполнено(ДокОбъект.Менеджер) Тогда
				// уже заполнено, не трогаем
				РезультатОбработки.Успешно = Истина;	
				
			Иначе
				Если ЗначениеЗаполнено(ДокОбъект.Автор) Тогда
					МенеджерСсылка = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокОбъект.Автор, "Сотрудник");
					Если ЗначениеЗаполнено(МенеджерСсылка) Тогда
						ДокОбъект.Менеджер = МенеджерСсылка;
						ДокОбъект.ОбменДанными.Загрузка = Истина;
						Попытка			
							ДокОбъект.Записать();
							РезультатОбработки.Успешно = Истина;
						Исключение
							РезультатОбработки.Успешно = Ложь;
							РезультатОбработки.ОписаниеОшибки = ОписаниеОшибки();
						КонецПопытки;
					Иначе
						РезультатОбработки.Успешно = Ложь;
						РезультатОбработки.ОписаниеОшибки = "Не удается определить менеджера: не указан сотрудник автора """ + Строка(ДокОбъект.Автор) + """";
					КонецЕсли;
				Иначе
					РезультатОбработки.Успешно = Ложь;
					РезультатОбработки.ОписаниеОшибки = "Не удается определить менеджера: не указан автор лида";
				КонецЕсли;
			КонецЕсли;
			
			//ИначеЕсли ВерсияПрограммыЧисло = 2009000100 Тогда
			//	
			//	// №13942 УБРАНО заполнение при обновлении
			//  //в РС Замеры добавлено измерение "НазначилЗамерПользователь"
			//	НаборЗаписей = РегистрыСведений.Замеры.СоздатьНаборЗаписей();
			//	НаборЗаписей.Отбор.Регистратор.Установить(СсылкаНаОбъект);
			//	
			//	НаборЗаписей.Прочитать();
			//	
			//	Если НаборЗаписей.Количество() = 0 Тогда
			//		
			//		РезультатОбработки.Успешно = Истина;
			//		Возврат РезультатОбработки;
			//		
			//	КонецЕсли;
			//	
			//	Для Каждого ТекущаяЗапись Из НаборЗаписей Цикл
			//		
			//		Если ТекущаяЗапись.НазначилЗамер.Пустая() Тогда
			//			Продолжить;
			//		КонецЕсли;
			//		
			//		ТекущаяЗапись.НазначилЗамерПользователь = Справочники.Пользователи.НайтиПоРеквизиту("Сотрудник", ТекущаяЗапись.НазначилЗамер);
			//		
			//	КонецЦикла;
			//	
			//	Попытка
			//		
			//		НаборЗаписей.Записать();
			//		РезультатОбработки.Успешно = Истина;
			//		
			//	Исключение
			//		
			//		РезультатОбработки.Успешно = Ложь;
			//		РезультатОбработки.ОписаниеОшибки = ОписаниеОшибки();
			//		
			//	КонецПопытки;
			
		КонецЕсли;
		
		// В документах "Начисление и списание бонусов" если у всех записей указана дисконтная карта
		// и снят флаг "(служебный) Учет бонусов по дисконтным картам" - нужно его установить
	ИначеЕсли ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.НачислениеБонусовКонтрагентам") Тогда
		
		ДокументОбъект = СсылкаНаОбъект.ПолучитьОбъект();
		
		ВездеУказанаДискотнаяКарта = Истина;
		
		Для Каждого ТекущаяСтрока Из ДокументОбъект.Бонусы Цикл
			
			Если Не ЗначениеЗаполнено(ТекущаяСтрока.ДисконтнаяКарта) Тогда
				
				ВездеУказанаДискотнаяКарта = Ложь;
				Прервать;
				
			КонецЕсли;
			
		КонецЦикла;
		
		Для Каждого ТекущаяСтрока Из ДокументОбъект.СписаниеБонусов Цикл
			
			Если Не ЗначениеЗаполнено(ТекущаяСтрока.ДисконтнаяКарта) Тогда
				
				ВездеУказанаДискотнаяКарта = Ложь;
				Прервать;
				
			КонецЕсли;
			
		КонецЦикла;
		
		Если ВездеУказанаДискотнаяКарта Тогда
			
			ДокументОбъект.СлужебныйУчетБонусовПоДисконтнымКартам = Истина;
			
			Попытка
				
				ДокументОбъект.Записать(); // только запись, т.к. движения не трогаем
				РезультатОбработки.Успешно = Истина;
				
			Исключение
				
				РезультатОбработки.Успешно = Ложь;
				РезультатОбработки.ОписаниеОшибки = ОписаниеОшибки();
				
			КонецПопытки;
			
		Иначе
			
			РезультатОбработки.Успешно = Ложь;
			РезультатОбработки.ОписаниеОшибки = "в документе часть записей с указанием дисконтной карты, часть без.";
			
		КонецЕсли;
		
		// #14300 нужно заполнить новое измерение "ЕдиницаИзмерения" и ресурс "КоличествоВЕдиницахДокумента" в регистре накопления "Продажи"
	ИначеЕсли ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.ВозвратПродукции") 
