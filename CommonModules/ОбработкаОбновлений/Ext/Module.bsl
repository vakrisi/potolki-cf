				ТекущаяСтрока.Сумма = ТекущаяСтрока.Сумма + ТекущаяСтрока.СкидкаБонусами;  //#10397
			КонецЦикла;
			
			//++ 2020-11-19
			Для Каждого ТекущаяСтрока Из СсылкаНаОбъект.Услуги Цикл
				НоваяСтрока = ТаблицаТоваров.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущаяСтрока);
				НоваяСтрока.Количество = ТекущаяСтрока.Количество * ТекущаяСтрока.Коэффициент;
				НоваяСтрока.Коэффициент = 1;
				НоваяСтрока.Сумма = ТекущаяСтрока.Сумма + ТекущаяСтрока.СкидкаБонусами;  //#10397
			КонецЦикла;
			//-- 2020-11-19
			
			ПоляПоиска = "Номенклатура, ХарактеристикаНоменклатуры, СерияНоменклатуры, Количество"; //, Цена"; //++ 2020-11-19 цены в регистре нет
			
			//-- №10123
			
		КонецЕсли;
		
		НаборЗаписей = РегистрыНакопления.ЗаказыПокупателей.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Регистратор.Установить(СсылкаНаОбъект);
		НаборЗаписей.Прочитать();
		Для каждого Движение из НаборЗаписей Цикл
			
			СтруктураПоиска = Новый Структура(ПоляПоиска);
