		ИЛИ ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.ПередачаМатериаловВЭксплуатацию")
		ИЛИ ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.ПоступлениеТоваровИУслуг")
		ИЛИ ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.РеализацияТоваровИУслуг")
		Тогда
		
		ДокОбъект = СсылкаНаОбъект.ПолучитьОбъект();		
