				КонецЕсли;
			КонецЦикла;
			
			//обработали монтаж, записываем
			МонтажОбъект.Записать();
		КонецЦикла;
		
		
		//потом помеченные на удаление монтажи
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	Монтаж.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.Монтаж КАК Монтаж
		|ГДЕ
