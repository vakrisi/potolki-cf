		|	ВТ КАК ВТ";
		
		РезультатЗапроса = Запрос.ВыполнитьПакет();		
		ВыборкаНоменклатуры = РезультатЗапроса[0].Выбрать();
		ТаблицаВД = РезультатЗапроса[2].Выгрузить();
		
		Если ТаблицаВД.Количество() = 1 Тогда
			// спецификация использовалась в одном виде документов
			Если ТаблицаВД[0].ВидДокумента = 1 Тогда
				СпрОбъект = СсылкаНаОбъект.ПолучитьОбъект();
				СпрОбъект.ВидСпецификации = Перечисления.ВидыСпецификации.СопутствующиеМатериалы;
				Попытка
					СпрОбъект.ОбменДанными.Загрузка = Истина;
					СпрОбъект.Записать();
					РезультатОбработки.Успешно = Истина;
				Исключение				
