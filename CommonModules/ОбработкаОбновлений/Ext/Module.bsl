		Попытка
			ДокОбъект.Записать();
			РезультатОбработки.Успешно = Истина;
		Исключение
			РезультатОбработки.Успешно = Ложь;
			РезультатОбработки.ОписаниеОшибки = ОписаниеОшибки();
		КонецПопытки;
		
		// 2. Заполняем в регистрах новое измерение
		// Делаем отдельно от самого документа, т.к. если делать проведение самого документа, могут быть конфликты
		// Делаем если выше прошло успешно (документ успешно записался)
		Если РезультатОбработки.Успешно Тогда
			
			НаборЗаписей = РегистрыНакопления.ТоварыВРезервеНаСкладах.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.Регистратор.Установить(СсылкаНаОбъект);
			НаборЗаписей.Прочитать();
			
			Для Каждого Движение из НаборЗаписей Цикл
				Движение.ВидТабличнойЧасти = Перечисления.ВидыТабличнойЧасти.Товары;
			КонецЦикла;
			
			Попытка
				НаборЗаписей.Записать();
				РезультатОбработки.Успешно = Истина;
			Исключение
				РезультатОбработки.Успешно = Ложь;
				РезультатОбработки.ОписаниеОшибки = ОписаниеОшибки();
			КонецПопытки;
			
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.РеализацияТоваровИУслуг") Тогда
		
		НаборЗаписей = РегистрыНакопления.ТоварыВРезервеНаСкладах.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Регистратор.Установить(СсылкаНаОбъект);
		НаборЗаписей.Прочитать();
		
