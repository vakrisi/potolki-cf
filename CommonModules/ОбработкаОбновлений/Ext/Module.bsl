Функция Обработка_2_8_33_0_Обязательные(СсылкаНаОбъект, ВерсияПрограммыЧисло) Экспорт
	
	РезультатОбработки = Новый Структура;
	РезультатОбработки.Вставить("Успешно", Ложь);
	РезультатОбработки.Вставить("ОписаниеОшибки", "");
	
	// №14035 в УСВ по монтажу появилось применение к ТЧ
	Если ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.УстановкаСтоимостиВыработкиПоНоменклатуре")
		И СсылкаНаОбъект.ВидДокументаРасчета = Справочники.ВидыДокументовРасчетаВыработки.Монтаж Тогда	
		
		ДокОбъект = СсылкаНаОбъект.ПолучитьОбъект();
		
		Для Каждого ТекущаяСтрока Из ДокОбъект.ВыработкаПоВидамНоменклатуры Цикл
			ТекущаяСтрока.Применение = Перечисления.ПрименениеНоменклатурыДляВыработки.ТоварыИУслуги;
		КонецЦикла;
		
		Для Каждого ТекущаяСтрока Из ДокОбъект.ВыработкаПоНоменклатуре Цикл
			ТекущаяСтрока.Применение = Перечисления.ПрименениеНоменклатурыДляВыработки.ТоварыИУслуги;
		КонецЦикла;
		
		Попытка
			ДокОбъект.Записать(РежимЗаписиДокумента.Запись); 
			РезультатОбработки.Успешно = Истина;
		Исключение
			РезультатОбработки.Успешно = Ложь;
			РезультатОбработки.ОписаниеОшибки = ОписаниеОшибки();
		КонецПопытки;
		
		// №14124 исправление выпусков с пустым видом заказа
	ИначеЕсли ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.ВыпускПродукции") Тогда
		
		Если ЗначениеЗаполнено(СсылкаНаОбъект.ВидЗаказа) Тогда
			РезультатОбработки.Успешно = Истина;
			Возврат РезультатОбработки;
		КонецЕсли;
		
		ДокОбъект = СсылкаНаОбъект.ПолучитьОбъект();
		
		ЗаказНаПроизводство = ДокОбъект.Основание;
		
		// Заполняем по заказу на производство
		ДокОбъект.ВидЗаказа = ЗаказНаПроизводство.ВидЗаказа;
		
		ДокОбъект.ПродукцияНоменклатура = ЗаказНаПроизводство.ПродукцияНоменклатура;
		ДокОбъект.ПродукцияНоменклатураЕдиницаИзмерения = ЗаказНаПроизводство.ПродукцияНоменклатураЕдиницаИзмерения;
		ДокОбъект.ПродукцияНоменклатураКоличество  = ЗаказНаПроизводство.ПродукцияНоменклатураКоличество;
		ДокОбъект.ПродукцияНоменклатураКоэффициент = ЗаказНаПроизводство.ПродукцияНоменклатураКоэффициент;
		ДокОбъект.ПродукцияНомерРасчета = ЗаказНаПроизводство.ПродукцияНомерРасчета;
		
		Попытка
			ДокОбъект.Записать(?(ДокОбъект.Проведен, РежимЗаписиДокумента.Проведение, РежимЗаписиДокумента.Запись));
			РезультатОбработки.Успешно = Истина;
		Исключение
			РезультатОбработки.Успешно = Ложь;
			РезультатОбработки.ОписаниеОшибки = ОписаниеОшибки();
		КонецПопытки;
		
	КонецЕсли;
	
