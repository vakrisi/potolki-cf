	Если ОбработкаОбязательныхОбъектов Тогда
		Возврат Обработка_2_8_36_0_Обязательные(СсылкаНаОбъект, ВерсияПрограммыЧисло);
	КонецЕсли;
	
	РезультатОбработки = Новый Структура;
	РезультатОбработки.Вставить("Успешно", Ложь);
	РезультатОбработки.Вставить("ОписаниеОшибки", "");
	
	Если ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.ОплатаБанковскойКартой")
		ИЛИ ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.ПоступлениеНаРасчетныйСчет")
		ИЛИ ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.ПриходныйКассовыйОрдер")
		ИЛИ ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.РасходныйКассовыйОрдер")
		ИЛИ ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.РеализацияТоваровИУслуг") Тогда
		
		НаборЗаписей = РегистрыНакопления.БонусыКонтрагентов.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Регистратор.Установить(СсылкаНаОбъект);
		НаборЗаписей.Прочитать();
		
		Для Каждого Запись Из НаборЗаписей Цикл
			Запись.КатегорияКонтрагента = СсылкаНаОбъект.КатегорияКонтрагента; 		
