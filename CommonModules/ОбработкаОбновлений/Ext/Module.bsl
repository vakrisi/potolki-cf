Функция Обработка_2_0_0_1(СсылкаДокумент) Экспорт
	
	РезультатОбработки = Новый Структура;
	РезультатОбработки.Вставить("Успешно", Ложь);
	РезультатОбработки.Вставить("ОписаниеОшибки", "");
	
	// записи в регистр ЗаказыПокупателейВПроизводстве
	Если ТипЗнч(СсылкаДокумент) = Тип("ДокументСсылка.ВыпускПродукции") Тогда
		
		ДокОбъект = СсылкаДокумент.ПолучитьОбъект();				
		Попытка
			ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);			 
			РезультатОбработки.Успешно = Истина;
		Исключение
			РезультатОбработки.Успешно = Ложь;
			РезультатОбработки.ОписаниеОшибки = ОписаниеОшибки();
		КонецПопытки;
		
	ИначеЕсли ТипЗнч(СсылкаДокумент) = Тип("ДокументСсылка.ЗаказНаПроизводство") Тогда
		
		ДокОбъект = СсылкаДокумент.ПолучитьОбъект();		
		Попытка
			ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);			 
			РезультатОбработки.Успешно = Истина;
		Исключение
			РезультатОбработки.Успешно = Ложь;
			РезультатОбработки.ОписаниеОшибки = ОписаниеОшибки();
		КонецПопытки;
		
	ИначеЕсли ТипЗнч(СсылкаДокумент) = Тип("ДокументСсылка.ЗаказПокупателя") Тогда
		
		СтруктураОтвета = Документы.ЗаказПокупателя.ВсеТоварыПоЗаказуОтгружены(СсылкаДокумент, СсылкаДокумент.Товары);
		Если СтруктураОтвета.Результат Тогда
			ДокОбъект = СсылкаДокумент.ПолучитьОбъект();		
			ДокОбъект.ТекущийСтатус = Справочники.СтатусыЗаказовПокупателей.Выполнен;
			Попытка
				ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);			 
				РезультатОбработки.Успешно = Истина;
			Исключение
				РезультатОбработки.Успешно = Ложь;
				РезультатОбработки.ОписаниеОшибки = ОписаниеОшибки();
			КонецПопытки;
		Иначе
			// заказ еще не отгружен
			//просто его перепроведем, чтобы заполнить регистр ЗаказыПокупателейВПроизводстве
			ДокОбъект = СсылкаДокумент.ПолучитьОбъект();		
			Попытка
				Если ДокОбъект.Проведен Тогда
					ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
				КонецЕсли;
				РезультатОбработки.Успешно = Истина;
			Исключение
				РезультатОбработки.Успешно = Ложь;
				РезультатОбработки.ОписаниеОшибки = ОписаниеОшибки();
			КонецПопытки;
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(СсылкаДокумент) = Тип("ДокументСсылка.РеализацияТоваровИУслуг") Тогда
		
		ДокументИзменен = Ложь;
		
		Док = СсылкаДокумент.ПолучитьОбъект();
		
		Для Каждого ТекущаяСтрока Из Док.Товары Цикл
			Если ТипЗнч(ТекущаяСтрока.Заказ) = Тип("ДокументСсылка.ЗаказНаПроизводство") И НЕ ТекущаяСтрока.Заказ.Пустая()
				И ТипЗнч(ТекущаяСтрока.Заказ.ДокументОснование) = Тип("ДокументСсылка.ЗаказПокупателя") И НЕ ТекущаяСтрока.Заказ.ДокументОснование.Пустая() Тогда
				
				ЗаказПокупателя = ТекущаяСтрока.Заказ.ДокументОснование;
				Если ЗаказПокупателя = СсылкаДокумент.Основание Тогда
					//если основание ЗНП является так же основанием нашей РТиУ, то в ТЧ Товары поставим пустую ссылку
					ЗаказПокупателя = Документы.ЗаказПокупателя.ПустаяСсылка();
				Иначе
					Если НЕ СсылкаДокумент.Основания.Найти(ЗаказПокупателя,"Основание") = Неопределено Тогда
						//если основание ЗНП так же является одним из оснований нашей РТиУ, то в ТЧ Товары поставим пустую ссылку
						ЗаказПокупателя = Документы.ЗаказПокупателя.ПустаяСсылка();
					КонецЕсли;
				КонецЕсли;
				//если же основание ЗНП не является ни основанием нашей РТиУ и не входит в состав оснований нашей РТиУ, то ссылку на него помещаем в ТЧ в поле "Заказ"
				
				ТекущаяСтрока.Заказ = ЗаказПокупателя;
				ДокументИзменен = Истина;
				
			КонецЕсли;
		КонецЦикла;
		Для Каждого ТекущаяСтрока Из Док.Услуги Цикл
			Если ТипЗнч(ТекущаяСтрока.Заказ) = Тип("ДокументСсылка.ЗаказНаПроизводство") И НЕ ТекущаяСтрока.Заказ.Пустая()
				И ТипЗнч(ТекущаяСтрока.Заказ.ДокументОснование) = Тип("ДокументСсылка.ЗаказПокупателя") И НЕ ТекущаяСтрока.Заказ.ДокументОснование.Пустая() Тогда
				
				ЗаказПокупателя = ТекущаяСтрока.Заказ.ДокументОснование;
				Если ЗаказПокупателя = СсылкаДокумент.Основание Тогда
					//если основание ЗНП является так же основанием нашей РТиУ, то в ТЧ Товары поставим пустую ссылку
					ЗаказПокупателя = Документы.ЗаказПокупателя.ПустаяСсылка();
				Иначе
					Если НЕ СсылкаДокумент.Основания.Найти(ЗаказПокупателя,"Основание") = Неопределено Тогда
						//если основание ЗНП так же является одним из оснований нашей РТиУ, то в ТЧ Товары поставим пустую ссылку
						ЗаказПокупателя = Документы.ЗаказПокупателя.ПустаяСсылка();
					КонецЕсли;
				КонецЕсли;
				//если же основание ЗНП не является ни основанием нашей РТиУ и не входит в состав оснований нашей РТиУ, то ссылку на него помещаем в ТЧ в поле "Заказ"
				
				ТекущаяСтрока.Заказ = ЗаказПокупателя;
				ДокументИзменен = Истина;
				
			КонецЕсли;
		КонецЦикла;
		
		Попытка
			Если ДокументИзменен Тогда
				Если Док.Проведен Тогда
					Док.Записать(РежимЗаписиДокумента.Проведение);
				Иначе
					Док.Записать();
				КонецЕсли;
			КонецЕсли;
			РезультатОбработки.Успешно = Истина;
		Исключение
			РезультатОбработки.Успешно = Ложь;
			РезультатОбработки.ОписаниеОшибки = "Не удалось в " + СсылкаДокумент + " заменить ссылку ЗНП на ЗП: " + ОписаниеОшибки();
		КонецПопытки;
		
	КонецЕсли;
	Возврат РезультатОбработки;
	
КонецФункции

