Процедура ВосстановитьПоследовательностьПоСебестоимостиТоваров() Экспорт
	
	// Если идет обновление конфигурации, то все регламентные задания блокируются.
	ОбщегоНазначения.ПриНачалеВыполненияРегламентногоЗадания();
	УстановитьПривилегированныйРежим(Истина); // №12993
	
	РегЗаданиеОбработкаПослеОбновления = РегламентныеЗадания.НайтиПредопределенное("ОбработкаДокументовПослеОбновления");
	
	СостояниеРегЗаданияОбработкаПослеОбновления = РегламентныеЗаданияСлужебный.СвойстваПоследнегоФоновогоЗаданияВыполненияРегламентногоЗадания(РегЗаданиеОбработкаПослеОбновления);	
	
	Если СостояниеРегЗаданияОбработкаПослеОбновления <> Неопределено 
		И СостояниеРегЗаданияОбработкаПослеОбновления.Состояние = СостояниеФоновогоЗадания.Активно Тогда
		
		ВызватьИсключение "Запуск регламентного задания отменен, так как выполняется обработка документов после обновления";
		
	Иначе
		
		//Последовательности.СебестоимостьЗапасов.Восстановить();
		
		Если ПустаяСтрока(ИмяПользователя()) Тогда
			ДатыЗапретаИзмененияСлужебный.ПропуститьПроверкуЗапретаИзменения(Истина);
		КонецЕсли;	
		
		ЕстьОшибка = Ложь;
		ТекстОшибки = "";
		Попытка
			Последовательности.СебестоимостьЗапасов.Восстановить();
			ДатыЗапретаИзмененияСлужебный.ПропуститьПроверкуЗапретаИзменения(Ложь);
			ЗаписьЖурналаРегистрации("Восстановлен параметр сеанса ""ПропуститьПроверкуЗапретаИзменения""", УровеньЖурналаРегистрации.Предупреждение,, "ВосстановлениеПоследовательностиПоСебестоимостиТоваров");
		Исключение
			ДатыЗапретаИзмененияСлужебный.ПропуститьПроверкуЗапретаИзменения(Ложь);
			ЗаписьЖурналаРегистрации("Восстановлен параметр сеанса ""ПропуститьПроверкуЗапретаИзменения""", УровеньЖурналаРегистрации.Предупреждение,, "ВосстановлениеПоследовательностиПоСебестоимостиТоваров");
			ВызватьИсключение;
		КонецПопытки;	
		
	КонецЕсли;	
	
КонецПроцедуры

Процедура ОбработатьДокументыПослеОбновления() Экспорт
	
	// Если идет обновление конфигурации, то все регламентные задания блокируются.
	ОбщегоНазначения.ПриНачалеВыполненияРегламентногоЗадания();
	
	Если ОбщегоНазначения.ИнформационнаяБазаФайловая() Тогда
		ВызватьИсключение "Информационная база является файловой, запуск данного регламентного задания отменен";
	КонецЕсли;
	
	ДокументыКОбработке = ПолучитьСписокДокументовКОбработке();
	
	Для Каждого ТекущийДокумент Из ДокументыКОбработке Цикл	
		
		Если НЕ ТребуетсяВыполнениеРегламентногоЗаданияПоТекущейДате("ОбработкаДокументовПослеОбновления") Тогда
			ВызватьИсключение "Выполнение регламентного задания прервано по заданному в расписании времени";
			Прервать;
		КонецЕсли;	
		
		СтруктураДанных = Новый Структура;
		СтруктураДанных.Вставить("ВерсияПрограммы", ТекущийДокумент.ВерсияПрограммы);
		СтруктураДанных.Вставить("ВерсияПрограммыЧисло", ТекущийДокумент.ВерсияПрограммыЧисло);
		СтруктураДанных.Вставить("Документ", ТекущийДокумент.Документ);
		СтруктураДанных.Вставить("ОбъектДата", ТекущийДокумент.ДокументДата);
		
		ОбработатьОбъект(СтруктураДанных);
		
	КонецЦикла;
	
КонецПроцедуры

Функция ТребуетсяВыполнениеРегламентногоЗаданияПоТекущейДате(ИмяРегламентногоЗадания)
	
	Если РегламентныеЗадания.НайтиПредопределенное(ИмяРегламентногоЗадания).Расписание.ТребуетсяВыполнение(ТекущаяДатаСеанса()) Тогда		
		Возврат Истина;		
	Иначе
		Возврат Ложь;		
	КонецЕсли;
	
КонецФункции

Функция ПолучитьСписокДокументовКОбработке()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ОбъектыКОбработкеПослеОбновленияРекомендуемые.ВерсияПрограммы,
	|	ОбъектыКОбработкеПослеОбновленияРекомендуемые.ВерсияПрограммыЧисло,
	|	ОбъектыКОбработкеПослеОбновленияРекомендуемые.Документ,
	|	ОбъектыКОбработкеПослеОбновленияРекомендуемые.ДокументДата
	|ИЗ
	|	РегистрСведений.ОбъектыКОбработкеПослеОбновленияРекомендуемые КАК ОбъектыКОбработкеПослеОбновленияРекомендуемые
	|
	|УПОРЯДОЧИТЬ ПО
	|	ОбъектыКОбработкеПослеОбновленияРекомендуемые.ВерсияПрограммыЧисло, ОбъектыКОбработкеПослеОбновленияРекомендуемые.ДокументДата";
	ДокументыКОбработке = Запрос.Выполнить().Выгрузить();
	
	Возврат ДокументыКОбработке;
	
КонецФункции


#Область СлужебныйПрограммныйИнтерфейс

Функция ТребуетсяВыводКомандыПодключеннойКОбъекту(Ссылка) Экспорт
	
	Если НЕ ЗначениеЗаполнено(Ссылка) Тогда
		Возврат Ложь;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ОбъектСсылка", Ссылка);
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ОбъектыКОбработкеПослеОбновленияОбязательные.ОбъектСсылка КАК ОбъектСсылка
	|ИЗ
	|	РегистрСведений.ОбъектыКОбработкеПослеОбновленияОбязательные КАК ОбъектыКОбработкеПослеОбновленияОбязательные
	|ГДЕ
	|	ОбъектыКОбработкеПослеОбновленияОбязательные.ОбъектСсылка = &ОбъектСсылка
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ОбъектыКОбработкеПослеОбновленияРекомендуемые.Документ
	|ИЗ
	|	РегистрСведений.ОбъектыКОбработкеПослеОбновленияРекомендуемые КАК ОбъектыКОбработкеПослеОбновленияРекомендуемые
	|ГДЕ
	|	ОбъектыКОбработкеПослеОбновленияРекомендуемые.Документ = &ОбъектСсылка";
	
	РезультатЗапроса = Запрос.Выполнить();
	Возврат НЕ РезультатЗапроса.Пустой();
	
КонецФункции

#КонецОбласти

