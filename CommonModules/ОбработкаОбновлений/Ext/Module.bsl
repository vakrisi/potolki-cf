Функция Обработка_2_0_3_6(СсылкаДокумент) Экспорт
	
	РезультатОбработки = Новый Структура;
	РезультатОбработки.Вставить("Успешно", Истина);
	РезультатОбработки.Вставить("ОписаниеОшибки", "");
	
	//#6233  в имени файла только имя, в расширении - только расширение, в расширении не должно быть точки.
	ЗапросМенеджер = Новый Запрос;
	ЗапросМенеджер.УстановитьПараметр("СсылкаНаОбъект", СсылкаДокумент);
	ЗапросМенеджер.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ПрикрепленныеДанные.Период КАК Период,
	|	ПрикрепленныеДанные.ВидФайлаПрограммыПостроителя КАК ВидФайлаПрограммыПостроителя,
	|	ПрикрепленныеДанные.СсылкаНаОбъект КАК СсылкаНаОбъект,
	|	ПрикрепленныеДанные.ИмяФайла КАК ИмяФайла,
	|	ПрикрепленныеДанные.Расширение КАК Расширение
	|ИЗ
	|	РегистрСведений.ПрикрепленныеДанные КАК ПрикрепленныеДанные
	|ГДЕ
	|	ПрикрепленныеДанные.СсылкаНаОбъект = &СсылкаНаОбъект
	|
	|УПОРЯДОЧИТЬ ПО
	|	Период";
	
	ВыборкаМенеджер = ЗапросМенеджер.Выполнить().Выбрать();
	Пока ВыборкаМенеджер.Следующий() Цикл
		
		ЗаписьМодицифирована = Ложь;
		МенеджерЗаписи = РегистрыСведений.ПрикрепленныеДанные.СоздатьМенеджерЗаписи();
		ЗаполнитьЗначенияСвойств(МенеджерЗаписи, ВыборкаМенеджер);
		МенеджерЗаписи.Прочитать();	
		
		СтрДлинаРасширения = СтрДлина(МенеджерЗаписи.Расширение);
		Если Прав(МенеджерЗаписи.ИмяФайла, СтрДлинаРасширения) = МенеджерЗаписи.Расширение Тогда
			МенеджерЗаписи.ИмяФайла = Лев(МенеджерЗаписи.ИмяФайла, СтрДлина(МенеджерЗаписи.ИмяФайла)-СтрДлинаРасширения);
			ЗаписьМодицифирована = Истина;
		КонецЕсли;
		Если Лев(МенеджерЗаписи.Расширение, 1) = "." Тогда
			МенеджерЗаписи.Расширение = Сред(МенеджерЗаписи.Расширение, 2);
			ЗаписьМодицифирована = Истина;
		КонецЕсли;
		
		Если ЗаписьМодицифирована Тогда
			Попытка
				МенеджерЗаписи.Записать(Истина);
			Исключение
				РезультатОбработки.Успешно = Ложь;	
				РезультатОбработки.ОписаниеОшибки = ОписаниеОшибки();
			КонецПопытки;
		КонецЕсли;
	КонецЦикла;
	
	Возврат РезультатОбработки;
	
КонецФункции

Функция Обработка_2_0_3_7(СсылкаДокумент) Экспорт
	
	РезультатОбработки = Новый Структура;
	РезультатОбработки.Вставить("Успешно", Истина);
	РезультатОбработки.Вставить("ОписаниеОшибки", "");
	
	ЗапросМенеджер = Новый Запрос;
	ЗапросМенеджер.УстановитьПараметр("СсылкаНаОбъект", СсылкаДокумент);
	ЗапросМенеджер.Текст = 
	"ВЫБРАТЬ
	|	КОЛИЧЕСТВО(*) КАК КоличествоФайлов,
	|	ПрикрепленныеДанные.СсылкаНаОбъект КАК СсылкаНаОбъект,
	|	ПрикрепленныеДанные.ИмяФайла КАК ИмяФайла,
	|	ПрикрепленныеДанные.Расширение КАК Расширение
	|ПОМЕСТИТЬ ВТ_Файлы
	|ИЗ
	|	РегистрСведений.ПрикрепленныеДанные КАК ПрикрепленныеДанные
	|ГДЕ
	|	ПрикрепленныеДанные.СсылкаНаОбъект = &СсылкаНаОбъект
	|	И ПрикрепленныеДанные.ВидФайлаПрограммыПостроителя = ЗНАЧЕНИЕ(Справочник.ВидыФайловПрограммыПостроителя.пустаяссылка)
	|
	|СГРУППИРОВАТЬ ПО
	|	ПрикрепленныеДанные.СсылкаНаОбъект,
	|	ПрикрепленныеДанные.ИмяФайла,
	|	ПрикрепленныеДанные.Расширение
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Файлы.КоличествоФайлов КАК КоличествоФайлов,
	|	ВТ_Файлы.СсылкаНаОбъект КАК СсылкаНаОбъект,
	|	ВТ_Файлы.ИмяФайла КАК ИмяФайла,
	|	ВТ_Файлы.Расширение КАК Расширение
	|ПОМЕСТИТЬ ВТ
	|ИЗ
	|	ВТ_Файлы КАК ВТ_Файлы
	|ГДЕ
	|	ВТ_Файлы.КоличествоФайлов > 1
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПрикрепленныеДанные.Период КАК Период,
	|	ПрикрепленныеДанные.ВидФайлаПрограммыПостроителя КАК ВидФайлаПрограммыПостроителя,
	|	ПрикрепленныеДанные.СсылкаНаОбъект КАК СсылкаНаОбъект,
	|	ПрикрепленныеДанные.ИмяФайла КАК ИмяФайла,
	|	ПрикрепленныеДанные.Данные КАК Данные,
	|	ПрикрепленныеДанные.Расширение КАК Расширение
	|ИЗ
	|	РегистрСведений.ПрикрепленныеДанные КАК ПрикрепленныеДанные
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ КАК ВТ
	|		ПО (ВТ.СсылкаНаОбъект = ПрикрепленныеДанные.СсылкаНаОбъект)
	|			И (ВТ.ИмяФайла = ПрикрепленныеДанные.ИмяФайла)
	|			И (ВТ.Расширение = ПрикрепленныеДанные.Расширение)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Период";
	
	ВыборкаМенеджер = ЗапросМенеджер.Выполнить().Выбрать();
	Пока ВыборкаМенеджер.Следующий() Цикл			
		МенеджерЗаписи = РегистрыСведений.ПрикрепленныеДанные.СоздатьМенеджерЗаписи();
		ЗаполнитьЗначенияСвойств(МенеджерЗаписи, ВыборкаМенеджер);
		МенеджерЗаписи.Прочитать();	
		
		ИмяФайла = ОбщийМодульСервер.ПолучитьИмяФайлаПрикрепленныхДанных(МенеджерЗаписи.СсылкаНаОбъект, МенеджерЗаписи.ИмяФайла, МенеджерЗаписи.Расширение);
		Если НЕ ИмяФайла = МенеджерЗаписи.ИмяФайла Тогда
			МенеджерЗаписи.ИмяФайла = ИмяФайла;
			Попытка
				МенеджерЗаписи.Записать(Истина);
			Исключение
				РезультатОбработки.Успешно = Ложь;	
				РезультатОбработки.ОписаниеОшибки = ОписаниеОшибки();
			КонецПопытки;
		КонецЕсли;
	КонецЦикла;
	
	Возврат РезультатОбработки;
	
КонецФункции

#КонецОбласти

#Область Обработка_2_4_0_0

Функция Обработка_2_4_0_0(СсылкаДокумент) Экспорт
	
	РезультатОбработки = Новый Структура;
	РезультатОбработки.Вставить("Успешно", Ложь);
	РезультатОбработки.Вставить("ОписаниеОшибки", "");
	
	// #7342
	Если ТипЗнч(СсылкаДокумент) = Тип("ДокументСсылка.ОплатаБанковскойКартой") Тогда
		
		НаборЗаписей = РегистрыНакопления.РасчетыПоЭквайрингу.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Регистратор.Установить(СсылкаДокумент);
		НаборЗаписей.Прочитать();
		Если НаборЗаписей.Количество() > 0 Тогда
			Для каждого Движение из НаборЗаписей Цикл
				Движение.Сумма = СсылкаДокумент.Сумма;
				Если ЗначениеЗаполнено(Движение.Документ) Тогда
					Движение.ВидОперации = СсылкаДокумент.ВидОперации;
				КонецЕсли;
			КонецЦикла;
			
			Попытка
				НаборЗаписей.Записать();
				РезультатОбработки.Успешно = Истина;
			Исключение
				РезультатОбработки.Успешно = Ложь;
				РезультатОбработки.ОписаниеОшибки = ОписаниеОшибки();
			КонецПопытки;
			
		Иначе
			РезультатОбработки.Успешно = Истина;
		КонецЕсли;
		
	КонецЕсли;
	
	// #7342
	Если ТипЗнч(СсылкаДокумент) = Тип("ДокументСсылка.ПоступлениеНаРасчетныйСчет") Тогда
		Если СсылкаДокумент.ВидОперации = Перечисления.ВидыОперацийПоступлениеНаРасчетныйСчет.ПоступлениеПоБанковскимКартам И СсылкаДокумент.Проведен Тогда
			ДокОбъект = СсылкаДокумент.ПолучитьОбъект();
			
			Попытка
				ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
				РезультатОбработки.Успешно = Истина;
			Исключение
				РезультатОбработки.Успешно = Ложь;
				РезультатОбработки.ОписаниеОшибки = ОписаниеОшибки();
			КонецПопытки;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат РезультатОбработки;
	
КонецФункции

#КонецОбласти

#Область Обработка_2_4_2_0

Функция Обработка_2_4_2_0(СсылкаДокумент) Экспорт
	
	РезультатОбработки = Новый Структура;
	РезультатОбработки.Вставить("Успешно", Ложь);
	РезультатОбработки.Вставить("ОписаниеОшибки", "");
	
	// №1083
	//!!! Внимание документы Монтаж и Заказы покупателей не добавлять в обработку версии 2.4.2.0, чтобы они не пересеклись с документами по другим датам
	// В монтаже и заказе покупателя добавлена галочка "СозданПриИспользованииСтатусаЗакрыт"
	// При обновлении на версию, если используется статус «Закрыт» в настройках программы, 
	// находить самый первый документ в этом статусе и ему и всем последующим документам ставить галочку «Создан при использовании статуса закрыт».
	Если ТипЗнч(СсылкаДокумент) = Тип("ДокументСсылка.ЗаказПокупателя") ИЛИ ТипЗнч(СсылкаДокумент) = Тип("ДокументСсылка.Монтаж") Тогда
		
		ДокОбъект = СсылкаДокумент.ПолучитьОбъект();
		
		Попытка
			ДокОбъект.СозданПриИспользованииСтатусаЗакрыт = Истина;
			ДокОбъект.Записать();
			РезультатОбработки.Успешно = Истина;
		Исключение
			РезультатОбработки.Успешно = Ложь;
			РезультатОбработки.ОписаниеОшибки = ОписаниеОшибки();
		КонецПопытки;
		
	КонецЕсли;
	
	Возврат РезультатОбработки;
	
КонецФункции

#КонецОбласти

#Область Обработка_2_4_3_0

Функция Обработка_2_4_3_0(СсылкаДокумент) Экспорт
	
	РезультатОбработки = Новый Структура;
	РезультатОбработки.Вставить("Успешно", Ложь);
	РезультатОбработки.Вставить("ОписаниеОшибки", "");
	
	// №7722 прикрпеленные изображения номенклатуры хранятся в отдельном справочнике НоменклатураПрисоединенныеФайлы
	// Если у номенклатуры указано изображение в старом реквизите "Фото" его необходимо перенести в справочник и очистить в карточке номенклатуры
	// В запросе мы не можем узнать заполненность типа "ХранилищеЗначений", поэтмому проверку будем делать в постобработке, сейчас выгружать все элементы
	Если ТипЗнч(СсылкаДокумент) = Тип("СправочникСсылка.Номенклатура") Тогда
		
		// Проверяем, указано ли изображение в старом реквизите
		Если ЗначениеЗаполнено(СсылкаДокумент.Фото.Получить()) Тогда
			
			СправочникОбъект = СсылкаДокумент.ПолучитьОбъект();
			
			// Делаем в одной транзакции: 
			//	1. Создаем изображение в справочнике
			//	2. Переносим ссылку изображения в карточку номенклатуры
			НачатьТранзакцию(РежимУправленияБлокировкойДанных.Автоматический);
			
			ИзображениеОбъект = Справочники.НоменклатураПрисоединенныеФайлы.СоздатьЭлемент();
			ИзображениеОбъект.ФайлХранилище = Новый ХранилищеЗначения(СправочникОбъект.Фото.Получить());
			ИзображениеОбъект.Наименование = "Основное";
			ИзображениеОбъект.Расширение = "jpg";
			ИзображениеОбъект.ДатаСоздания = ТекущаяДатаСеанса();
			ИзображениеОбъект.ВладелецФайла = СправочникОбъект.Ссылка;
			
			Попытка
				ИзображениеОбъект.Записать();
			Исключение
				РезультатОбработки.Успешно = Ложь;
				РезультатОбработки.ОписаниеОшибки = ОписаниеОшибки();
				ОтменитьТранзакцию();
				Возврат РезультатОбработки;
			КонецПопытки;
			
			Попытка
				СправочникОбъект.ФайлКартинки = ИзображениеОбъект.Ссылка;
				СправочникОбъект.Фото = новый ХранилищеЗначения(Неопределено);
				СправочникОбъект.Записать();
				РезультатОбработки.Успешно = Истина;
				ЗафиксироватьТранзакцию();
			Исключение
				РезультатОбработки.Успешно = Ложь;
				РезультатОбработки.ОписаниеОшибки = ОписаниеОшибки();
				ОтменитьТранзакцию();
				Возврат РезультатОбработки;
			КонецПопытки;
			
		Иначе
			
			// Считаем успешным, т.к. нам нужно было обработать, только если заполнен реквизит
			РезультатОбработки.Успешно = Истина;
			
		КонецЕсли;	
		
	КонецЕсли;
	
	Возврат РезультатОбработки;
	
КонецФункции

#КонецОбласти

#Область Обработка_2_4_5_0

Функция Обработка_2_4_5_0(СсылкаДокумент) Экспорт
	
	РезультатОбработки = Новый Структура;
	РезультатОбработки.Вставить("Успешно", Ложь);
	РезультатОбработки.Вставить("ОписаниеОшибки", "");
	
	// #8030 все монтажи в регистр для заполнения ИДМонтажа
	Если ТипЗнч(СсылкаДокумент) = Тип("ДокументСсылка.Монтаж") Тогда
		
		ДокОбъект = СсылкаДокумент.ПолучитьОбъект();
		
		Попытка
			ДокОбъект.Записать(); // без режимов
			
			ТекущийГрафикМонтажей = ДокОбъект.ГрафикМонтажей.Выгрузить();
			Если ЗначениеЗаполнено(ДокОбъект.ДатаМонтажа) И ЗначениеЗаполнено(ДокОбъект.ВремяНачала) Тогда
				СтрокаМонтажа = ТекущийГрафикМонтажей.Вставить(0);
				СтрокаМонтажа.ДатаМонтажа 		= ДокОбъект.ДатаМонтажа;
				СтрокаМонтажа.ВремяНачала 		= ДокОбъект.ВремяНачала;
				СтрокаМонтажа.ВремяОкончания 	= ДокОбъект.ВремяОкончания;
				СтрокаМонтажа.ИДМонтажа 		= ДокОбъект.ИДМонтажа;
			КонецЕсли;
			
			НаборЗаписей = РегистрыСведений.Монтажи.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.Регистратор.Установить(СсылкаДокумент);
			НаборЗаписей.Прочитать();
			Для каждого Движение из НаборЗаписей Цикл
				НайденныеСтроки = ТекущийГрафикМонтажей.НайтиСтроки(Новый Структура("ДатаМонтажа, ВремяНачала, ВремяОкончания", Движение.Дата, Движение.ВремяНачала, Движение.ВремяОкончания));
				Если НайденныеСтроки.Количество() Тогда
					Движение.ИДМонтажа = НайденныеСтроки[0].ИДМонтажа;
				КонецЕсли;
			КонецЦикла;			
			НаборЗаписей.Записать();
			
			РезультатОбработки.Успешно = Истина;
		Исключение
			РезультатОбработки.Успешно = Ложь;
			РезультатОбработки.ОписаниеОшибки = ОписаниеОшибки();
		КонецПопытки;
		
	КонецЕсли;
	
	Возврат РезультатОбработки;
	
КонецФункции

#КонецОбласти

#Область Обработка_2_4_11_0

Функция Обработка_2_4_11_0(СсылкаДокумент) Экспорт
	
	РезультатОбработки = Новый Структура;
	РезультатОбработки.Вставить("Успешно", Ложь);
	РезультатОбработки.Вставить("ОписаниеОшибки", "");
	
	// №8373 у всех старых РТиУ, которые делали движения в РН очереди на создание ПТиУ взвести соответствующую галочку
	Если ТипЗнч(СсылкаДокумент) = Тип("ДокументСсылка.РеализацияТоваровИУслуг") Тогда
		
		Попытка
			
			// Если документ есть в регистре, обрабатываем
			НаборЗаписей = РегистрыНакопления.ОтгрузкиСПроизодстваДляРозницы.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.Регистратор.Установить(СсылкаДокумент);
			НаборЗаписей.Прочитать();
			Если НаборЗаписей.Количество() > 0 Тогда
				
				ДокОбъект = СсылкаДокумент.ПолучитьОбъект();
				// В зависимости от движений (ручное или интеркампани)
				Если НаборЗаписей[0].ОприходоватьПоРучнымЗаказам Тогда
					
					ДокОбъект.АвтоматическиСоздатьДокументПоступленияОтПроизводстваНаРозницуСозданныхВручную = Истина;
					
					МенеджерЗаписи = РегистрыСведений.СвязкиОрганизацийПроизводстваКонтрагентРозницы.СоздатьМенеджерЗаписи();
					МенеджерЗаписи.Организация = ДокОбъект.Организация;
					МенеджерЗаписи.Контрагент  = ДокОбъект.Контрагент;
					МенеджерЗаписи.Прочитать();
					Если МенеджерЗаписи.Выбран() Тогда
						ДокОбъект.ОрганизацияПоступления = МенеджерЗаписи.ОрганизацияПоступления;
						ДокОбъект.КонтрагентПоступления  = МенеджерЗаписи.КонтрагентПоступления;
					КонецЕсли;
					
				Иначе	
					
					ДокОбъект.АвтоматическиСоздатьДокументПоступленияОтПроизводстваНаРозницуПоИнтеркампани = Истина;
					
				КонецЕсли;
				
				ДокОбъект.Записать();
				
			КонецЕсли;
			
			РезультатОбработки.Успешно = Истина;
			
		Исключение
			РезультатОбработки.Успешно = Ложь;
			РезультатОбработки.ОписаниеОшибки = ОписаниеОшибки();
		КонецПопытки;
		
	КонецЕсли;
	
	Возврат РезультатОбработки;
	
КонецФункции

#КонецОбласти

