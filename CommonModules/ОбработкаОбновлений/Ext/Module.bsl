		КонецЕсли;		
		
		//#7806 обработка ЗП: для внутренних заказов очистить настройку интеркампани
	ИначеЕсли ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.ЗаказПокупателя") Тогда
		
		ДокОбъект = СсылкаНаОбъект.ПолучитьОбъект();
		
		//++ №9385
		НужноЗаписатьОбъект = Ложь;
		
		Если СсылкаНаОбъект.Проведен 
