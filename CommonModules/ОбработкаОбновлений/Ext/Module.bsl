			ДокОбъект.Записать(); // только запись
			РезультатОбработки.Успешно = Истина;
		Исключение
			РезультатОбработки.Успешно = Ложь;
			РезультатОбработки.ОписаниеОшибки = ОписаниеОшибки();
		КонецПопытки;
		
		// #12667	
		//ИначеЕсли ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.ЗаказДоговор") Тогда	
		//	РезультатОбработки.Успешно = Ложь;
		//	РезультатОбработки.ОписаниеОшибки =  "В заказ-договоре для товаров используются спецификации, что недоступно с версии 2.8.";
		//	
		//ИначеЕсли ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.Монтаж")	Тогда
		//	РезультатОбработки.Успешно = Ложь;
		//	РезультатОбработки.ОписаниеОшибки = "В монтаже для товаров используются спецификации, что недоступно с версии 2.8.";
		//		
	КонецЕсли;
	
	Возврат РезультатОбработки;
	
КонецФункции

#КонецОбласти

#Область Обработка_2_8_0_0

Функция Обработка_2_8_0_0(СсылкаНаОбъект, ОбработкаОбязательныхОбъектов) Экспорт
	
	Если ОбработкаОбязательныхОбъектов Тогда
		Возврат Обработка_2_8_0_0_Обязательные(СсылкаНаОбъект);
	КонецЕсли;
	
	РезультатОбработки = Новый Структура;
	РезультатОбработки.Вставить("Успешно", Ложь);
	РезультатОбработки.Вставить("ОписаниеОшибки", "");
	
	// #12157 заполнение реквизита "НомераПотолков"
	//Если ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.ЗаказНаПроизводство") Тогда
	//			
	//	ДокОбъект = СсылкаНаОбъект.ПолучитьОбъект();
	//	ЕстьИзменения = ДокОбъект.ЗаполнитьНомераПотолков();
	//	Если НЕ ЕстьИзменения Тогда
	//		РезультатОбработки.Успешно = Истина;
	//	Иначе
	//		Попытка
	//			ДокОбъект.ДополнительныеСвойства.Вставить("ПропуститьПроверкуЗапретаИзменения", Истина);
	//			ДокОбъект.Записать(); // Только запись
	//			РезультатОбработки.Успешно = Истина;
	//		Исключение
	//			РезультатОбработки.Успешно = Ложь;
	//			РезультатОбработки.ОписаниеОшибки = ОписаниеОшибки();
	//			Возврат РезультатОбработки;
	//		КонецПопытки;
	//	КонецЕсли;
	//	
	//КонецЕсли;
	
	ОбработаноУспешно1 = Ложь;
	ОбработаноУспешно2 = Ложь;
	
	//#12367 Нужно заполнить новое измерение "Склад" в регистре накопления "Продажи"
	Если ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.ВозвратПродукции") 
		ИЛИ ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.ВозвратТовараОтПокупателя")
		ИЛИ ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.Замена")
		ИЛИ ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.Монтаж")
		ИЛИ ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.РеализацияТоваровИУслуг") 
		ИЛИ ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.СоглашениеОРасторженииДоговора")
		ИЛИ ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.ЧекККМ")
		Тогда
		
		Если ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.Монтаж") Тогда
			Склад = СсылкаНаОбъект.СкладТоваров;
		ИначеЕсли ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.СоглашениеОРасторженииДоговора") Тогда
			Склад = СсылкаНаОбъект.СкладСписанияТоваров;
		Иначе
			Склад = СсылкаНаОбъект.Склад;
		КонецЕсли;
		
		НаборЗаписей = РегистрыНакопления.Продажи.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Регистратор.Установить(СсылкаНаОбъект);
		НаборЗаписей.Прочитать();
		Для каждого Движение из НаборЗаписей Цикл
			Движение.Склад = Склад;
		КонецЦикла;
		
		Попытка
			НаборЗаписей.Записать();
			РезультатОбработки.Успешно = Истина;
			
			Если ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.Монтаж") ИЛИ ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.РеализацияТоваровИУслуг") Тогда
				ОбработаноУспешно1 = Истина;	
			КонецЕсли;
		Исключение
			РезультатОбработки.Успешно = Ложь;
			РезультатОбработки.ОписаниеОшибки = ОписаниеОшибки();
		КонецПопытки;
		
	КонецЕсли;
	
	// #12131 заполнение реквизита "НомераПотолков"
	Если ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.Монтаж") Тогда
		
		ДокОбъект = СсылкаНаОбъект.ПолучитьОбъект();
		Если ДокОбъект.ВидОперации = Справочники.ВидыМонтажа.Рекламация И ДокОбъект.СуммаДокумента <> 0 Тогда
			ДокОбъект.ВидОперации = Справочники.ВидыМонтажа.СервиснаяЗаявка;
			
			Попытка
				ДокОбъект.ОбменДанными.Загрузка = Истина;
				ДокОбъект.ДополнительныеСвойства.Вставить("ПропуститьПроверкуЗапретаИзменения", Истина);
				ДокОбъект.Записать(); // Только запись
				РезультатОбработки.Успешно = Истина;
				
				ОбработаноУспешно2 = Истина;
			Исключение
				РезультатОбработки.Успешно = Ложь;
				РезультатОбработки.ОписаниеОшибки = ОписаниеОшибки();
				Возврат РезультатОбработки;
			КонецПопытки;
		Иначе
			ОбработаноУспешно2 = Истина;
		КонецЕсли;
		
		//#12127
		// этот кусок перенесен в 2.7.21
		//Если ДокОбъект.СлужебныйКоличествоКСписаниюНеСоответствуетКоличествуПроданного Тогда
		//	РезультатОбработки.Успешно = Ложь;
		//	РезультатОбработки.ОписаниеОшибки = "Создан при использовании функционала отличающегося проданного количества потолков от реального, который отсутствует в новых версиях";
		//	Возврат РезультатОбработки;	
		//КонецЕсли;
		
	ИначеЕсли ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.РеализацияТоваровИУслуг") Тогда
		//#12358
		ДокОбъект = СсылкаНаОбъект.ПолучитьОбъект();
		Если ДокОбъект.УДАЛИТЬ_Выдано Тогда
			ДокОбъект.СтатусОтгрузки = Справочники.СтатусыОтгрузки.Отгружен;
			
			Попытка
				ДокОбъект.ОбменДанными.Загрузка = Истина;
				ДокОбъект.ДополнительныеСвойства.Вставить("ПропуститьПроверкуЗапретаИзменения", Истина);
				ДокОбъект.Записать(); // Только запись
				РезультатОбработки.Успешно = Истина;
				
				ОбработаноУспешно2 = Истина;
			Исключение
				РезультатОбработки.Успешно = Ложь;
				РезультатОбработки.ОписаниеОшибки = ОписаниеОшибки();
				Возврат РезультатОбработки;
			КонецПопытки;
			
		Иначе
			ОбработаноУспешно2 = Истина;		
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.НачислениеБонусовКонтрагентам") Тогда
		//#12518 
		ДокОбъект = СсылкаНаОбъект.ПолучитьОбъект();
		КолСтрок = ДокОбъект.Бонусы.Количество();
		Для Индекс = 1 по КолСтрок Цикл 			
			СтрокаТабличнойЧасти = ДокОбъект.Бонусы[КолСтрок - Индекс];
			Если СтрокаТабличнойЧасти.Сумма < 0 Тогда
				НоваяСтрока = ДокОбъект.СписаниеБонусов.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТабличнойЧасти);
				НоваяСтрока.Сумма = -СтрокаТабличнойЧасти.Сумма;
				ДокОбъект.Бонусы.Удалить(СтрокаТабличнойЧасти);
			КонецЕсли;
		КонецЦикла;
		
		Попытка
			ДокОбъект.ДополнительныеСвойства.Вставить("ПропуститьПроверкуЗапретаИзменения", Истина);
			ДокОбъект.Записать(РежимЗаписиДокумента.Проведение); 
			РезультатОбработки.Успешно = Истина;
		Исключение
			РезультатОбработки.Успешно = Ложь;
			РезультатОбработки.ОписаниеОшибки = ОписаниеОшибки();
			Возврат РезультатОбработки;
		КонецПопытки;		
		
	ИначеЕсли ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.УстановкаЦенМатериалов") 
		ИЛИ ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.УстановкаИндивидуальныхЦенМатериалов") Тогда
		//#12615 заполнение нового реквизита
		ДокОбъект = СсылкаНаОбъект.ПолучитьОбъект();
		ДокОбъект.ЦенаСФотопечатьюОтличается = Истина;		
		Попытка
			ДокОбъект.ДополнительныеСвойства.Вставить("ПропуститьПроверкуЗапретаИзменения", Истина);
			ДокОбъект.Записать(); // запись без перепроведения 
			РезультатОбработки.Успешно = Истина;
		Исключение
			РезультатОбработки.Успешно = Ложь;
			РезультатОбработки.ОписаниеОшибки = ОписаниеОшибки();
			Возврат РезультатОбработки;
		КонецПопытки;
		
	КонецЕсли;
	
	Если ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.Монтаж") ИЛИ ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.РеализацияТоваровИУслуг") Тогда
		РезультатОбработки.Успешно = ОбработаноУспешно1 И ОбработаноУспешно2;	
	КонецЕсли;
	
	Если ТипЗнч(СсылкаНаОбъект) = Тип("СправочникСсылка.Номенклатура") Тогда
		
		РезультатОбработки.Успешно = Ложь;
		РезультатОбработки.ОписаниеОшибки = "Номенклатура имеет вид ""Типовой отрез"" который отсутствует в новых версиях программы.";
		
	КонецЕсли;
	
	Возврат РезультатОбработки;
	
КонецФункции

#КонецОбласти

#Область Обработка_2_8_0_0_Обязательные

Функция Обработка_2_8_0_0_Обязательные(СсылкаНаОбъект) Экспорт
	
	РезультатОбработки = Новый Структура;
	РезультатОбработки.Вставить("Успешно", Ложь);
	РезультатОбработки.Вставить("ОписаниеОшибки", "");
	
	// №10807 в документе "Монтаж" добавлен реквизит "ЗаказДоговор"
	Если ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.Монтаж") Тогда
		
		ДокОбъект = СсылкаНаОбъект.ПолучитьОбъект();
		
		Если ТипЗнч(ДокОбъект.Основание) = Тип("ДокументСсылка.ЗаказДоговор") Тогда
			ДокОбъект.ЗаказДоговор = ДокОбъект.Основание;
		КонецЕсли;
		
		ДокОбъект.ДополнительныеСвойства.Вставить("ПропуститьПроверкуЗапретаИзменения", Истина);
		Попытка
			ДокОбъект.Записать(); // Только запись
			РезультатОбработки.Успешно = Истина;
		Исключение
			РезультатОбработки.Успешно = Ложь;
			РезультатОбработки.ОписаниеОшибки = ОписаниеОшибки();
			Возврат РезультатОбработки;
		КонецПопытки;	
		
		//++ №11768 в заказ-договоре привязывается ссылка на замер
	ИначеЕсли ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.ЗаказДоговор") Тогда
		
		ДокОбъект = СсылкаНаОбъект.ПолучитьОбъект();
		
		Если ТипЗнч(ДокОбъект.Основание) = Тип("ДокументСсылка.Лид") И Не ЗначениеЗаполнено(ДокОбъект.ИдентификаторЗамера) Тогда
			
			// сначала попробуем найти замеры, у которых результат "Договор заключен"
			// - если их нет, ничего не делаем (фиксируем успешную обработку)
			// - если такой замер один и замерщик совпадает с замерщиком договора, ставим ИД этого замера
			// - если таких замеров несколько, но разные замерщики, то ставим ИД замера, у которого замерщик совпадает с замерщиком ЗД
			//	 при этом, если таких замеров по замерщику договора несколько, ставим ИД самого последнего (по дате) из них
			// - если ни под один критерий не подходит, тогда ставим к ручной обработке версии 2.8.a$
			
			Замеры = ДокОбъект.Основание.Замеры;
			
			НайденныеСтроки = Замеры.НайтиСтроки(новый Структура("РезультатЗамера", Справочники.РезультатЗамераЛида.ЗаключенДоговор));
			НайденныеСтрокиПоЗамерщику = Замеры.НайтиСтроки(новый Структура("РезультатЗамера, ИсполнительЗамера", Справочники.РезультатЗамераЛида.ЗаключенДоговор, ДокОбъект.ИсполнительЗамера));
			
			Если НайденныеСтроки.Количество() = 0 Тогда
				
				// нету замеров "Договор заключен" - ничего не делаем (ниже будет зафиксирована успешная обработка)
				
			ИначеЕсли НайденныеСтрокиПоЗамерщику.Количество() > 0 Тогда
				
				// есть замер "Договор заключен" и замерщик совпадает с замерщиком договора, ставим ИД этого замера (самый последний по дате)
				ИндексСтроки = Неопределено;
				ПоследняяДатаЗамера = Дата(1,1,1);
				
				Для Индекс = 0 По НайденныеСтрокиПоЗамерщику.Количество() -1 Цикл
					
					СтрокаЗамера = НайденныеСтрокиПоЗамерщику[Индекс];
					
					Если ИндексСтроки = Неопределено Или ПоследняяДатаЗамера < (СтрокаЗамера.ДатаЗамера + (СтрокаЗамера.ВремяНачалаЗамера - Дата(1,1,1))) Тогда
						
						ИндексСтроки = Индекс;
						ПоследняяДатаЗамера = СтрокаЗамера.ДатаЗамера + (СтрокаЗамера.ВремяНачалаЗамера - Дата(1,1,1));
						
					КонецЕсли;
					
				КонецЦикла;
				
				ДокОбъект.ИдентификаторЗамера = НайденныеСтрокиПоЗамерщику[ИндексСтроки].ИДЗамера;
				
			Иначе
				
				// ставим к ручной обработке версии 2.8.0.$a т.к. замеры с результатом "Договор заключен" есть, но замерщик не совпадает с замерщиком в заказ-договоре
				ОбновлениеИнформационнойБазыПотолки.ПоместитьВРегистрКОбработке("2.8.0.$a", ДокОбъект.Ссылка, ДокОбъект.Дата,, 1);
				
			КонецЕсли;
			
