Функция Обработка_2_7_24_0_Обязательные(СсылкаНаОбъект) Экспорт
	
	РезультатОбработки = Новый Структура;
	РезультатОбработки.Вставить("Успешно", Ложь);
	РезультатОбработки.Вставить("ОписаниеОшибки", "");
	
	// #12345 в обработчике важных объектов после обновления для этих объектов пытаться просто выполнить запись, 
	// если запись прошла (нет ошибки по пересечениям), то объект уходит из списка объектов к обработке.	
	Если ТипЗнч(СсылкаНаОбъект) = Тип("СправочникСсылка.ЦеныУслугРаскроя") 
		ИЛИ ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.УстановкаИндивидуальныхЦенНаУслугиПроизводства")
