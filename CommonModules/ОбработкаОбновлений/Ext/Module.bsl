						СпрНоменОбъект.ОсновнаяСпецификацияСопутствующиеМатериалы = СсылкаНаОбъект;
						СпрНоменОбъект.ОбменДанными.Загрузка = Истина;
						СпрНоменОбъект.Записать();
					Исключение
					КонецПопытки;
				КонецЕсли;
				
			ИначеЕсли ТаблицаВД[0].ВидДокумента = 2 Тогда
				СпрОбъект = СсылкаНаОбъект.ПолучитьОбъект();
