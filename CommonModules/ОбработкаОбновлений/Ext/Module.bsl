				ТекстОшибки = "Требуется доп.обработка: номенклатура-отрез, количество к выработке пленки равно 0";
				РезультатОбработки.Успешно = Ложь;
				РезультатОбработки.ОписаниеОшибки = ТекстОшибки;				
			КонецЕсли;
		КонецЕсли;		
		
		// #13763 заполнение новых измерений и ресурсов
	ИначеЕсли ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.ВыпускПродукции") Тогда
		
		ДокОбъект = СсылкаНаОбъект.ПолучитьОбъект();
		
		//ВремРасходТоваров = ДокОбъект.Движения.ТоварыНаСкладах.Выгрузить();
		
		НаборЗаписейСклад = РегистрыНакопления.ТоварыНаСкладах.СоздатьНаборЗаписей();
		НаборЗаписейСклад.Отбор.Регистратор.Установить(СсылкаНаОбъект);
		НаборЗаписейСклад.Прочитать();
		ВремРасходТоваров = НаборЗаписейСклад.Выгрузить();
		ВремРасходТоваров.Свернуть("Номенклатура, ХарактеристикаНоменклатуры, СерияНоменклатуры", "Сумма, Количество");
		
		Попытка
			НаборЗаписей = РегистрыНакопления.РасходМатериаловНаПроизводстве.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.Регистратор.Установить(СсылкаНаОбъект);
			НаборЗаписей.Прочитать();
			НаборЗаписей.Очистить(); 
			
			Для Каждого ТекущаяСтрока Из ДокОбъект.Материалы Цикл
				Движение = НаборЗаписей.Добавить();
				Движение.Период = ДокОбъект.Дата;
				Движение.ДокументСписания = ДокОбъект.Ссылка;
				Движение.Организация = ДокОбъект.Организация;      //+ #13763
				Движение.Подразделение = ДокОбъект.Подразделение;  //+ #13763
				Движение.Склад = ДокОбъект.СкладМатериалов;        //+ #13763
				Если ЗначениеЗаполнено(ТекущаяСтрока.Продукция) Тогда
					Движение.Продукция = ТекущаяСтрока.Продукция;  		 //+ #13763
				ИначеЕсли ДокОбъект.ВидЗаказа = Перечисления.ВидыЗаказовНаПроизводство.ПроизводствоПотолка Тогда
					Движение.Продукция = ДокОбъект.ПродукцияНоменклатура;  		 //+ #13763
				КонецЕсли;
				Движение.Номенклатура = ТекущаяСтрока.Номенклатура;
				Движение.НомерРасчета = ДокОбъект.ПродукцияНомерРасчета;
				Движение.СерияНоменклатуры = ТекущаяСтрока.СерияНоменклатуры;
				Движение.ХарактеристикаНоменклатуры = ТекущаяСтрока.ХарактеристикаНоменклатуры;
				Движение.ЕдиницаИзмерения = ТекущаяСтрока.ЕдиницаИзмерения;
				Движение.Количество = ТекущаяСтрока.Количество;
				Движение.КоличествоВБазовыхЕдиницах = ТекущаяСтрока.Количество * ТекущаяСтрока.Коэффициент; //+ #13763
				
				Отбор = Новый Структура;
				Отбор.Вставить("Номенклатура",Движение.Номенклатура);
				Отбор.Вставить("ХарактеристикаНоменклатуры",Движение.ХарактеристикаНоменклатуры);
				Отбор.Вставить("СерияНоменклатуры",Движение.СерияНоменклатуры);
				НайденныеСтроки = ВремРасходТоваров.НайтиСтроки(Отбор);
				Если НайденныеСтроки.Количество() > 0 Тогда
					Если НЕ НайденныеСтроки[0].Количество = 0 Тогда
						Движение.Сумма = (НайденныеСтроки[0].Сумма / НайденныеСтроки[0].Количество) * Движение.Количество;
					КонецЕсли;
				КонецЕсли; 		
			КонецЦикла;
			
			НаборЗаписей.Записать();
			РезультатОбработки.Успешно = Истина;
		Исключение
			РезультатОбработки.Успешно = Ложь;
			РезультатОбработки.ОписаниеОшибки = ОписаниеОшибки();
		КонецПопытки;
		
	КонецЕсли;
	
	Возврат РезультатОбработки;
	
КонецФункции

