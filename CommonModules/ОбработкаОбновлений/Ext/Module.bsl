Функция Обработка_2_8_34_0(СсылкаНаОбъект, ОбработкаОбязательныхОбъектов, ВерсияПрограммыЧисло) Экспорт
	
	Если ОбработкаОбязательныхОбъектов Тогда
		Возврат Обработка_2_8_34_0_Обязательные(СсылкаНаОбъект, ВерсияПрограммыЧисло);
	КонецЕсли;
	
	РезультатОбработки = Новый Структура;
	РезультатОбработки.Вставить("Успешно", Ложь);
	РезультатОбработки.Вставить("ОписаниеОшибки", "");
	
	// #14174
	Если ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.Лид")
		ИЛИ ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.ВыпускПродукции")
		ИЛИ ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.ЗаказПокупателя")
		Тогда	
		
		ДокОбъект = СсылкаНаОбъект.ПолучитьОбъект();
		Если ДокОбъект.Проведен Тогда
			Попытка
				ДокОбъект.Записать(РежимЗаписиДокумента.Проведение); 
				РезультатОбработки.Успешно = Истина;
			Исключение
				РезультатОбработки.Успешно = Ложь;
				РезультатОбработки.ОписаниеОшибки = ОписаниеОшибки();
			КонецПопытки;
		Иначе
			РезультатОбработки.Успешно = Истина;
		КонецЕсли;		
		
		// №14125 Все документы "Возврат уникальной продукции", у которых есть введенные на основании документы "Штраф"
		// поместить в очередь к обработке после обновления с текстом "Документ "Возврат уникальной продукции" имеет дублирующее начисление отрицательной выработки документом "Штраф"
	ИначеЕсли ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.ВозвратПродукции") И ВерсияПрограммыЧисло = 2008034200 Тогда	
		
		НаборЗаписей = РегистрыНакопления.ВыработкаИсполнителейПроизводства.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Регистратор.Установить(СсылкаНаОбъект);
		НаборЗаписей.Прочитать();
		ЕстьВыработка = НаборЗаписей.Количество() > 0;
		
		ЕстьШтраф = Ложь;
		Запрос = новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		|	Штраф.Основание КАК Ссылка
		|ИЗ
		|	Документ.Штраф КАК Штраф
		|ГДЕ
		|	Штраф.Проведен
		|	И Штраф.Основание = &Ссылка
		|";
		Запрос.УстановитьПараметр("Ссылка", СсылкаНаОбъект);
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Следующий() Тогда
			ЕстьШтраф = Истина;
		КонецЕсли;
		
		Если ЕстьШтраф И ЕстьВыработка Тогда
			РезультатОбработки.Успешно = Ложь;
			РезультатОбработки.ОписаниеОшибки = "Документ ""Возврат уникальной продукции"" имеет дублирующее начисление отрицательной выработки документом ""Штраф"".";			
		Иначе			
			РезультатОбработки.Успешно = Истина;			
		КонецЕсли;
		
		//#13834 
