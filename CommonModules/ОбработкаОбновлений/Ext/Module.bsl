				//ЗаписатьВИсторию("Записан документ " + Выборка.Ссылка);
			Исключение
				//ЗаписатьВИсторию("Ошибка изменения документа " + Выборка.Ссылка + ": " + ОписаниеОшибки(), Истина);
				ТекстОшибки = "Ошибка изменения документа " + Выборка.Ссылка + ": " + ОписаниеОшибки();
				ЗаписатьОшибкуВЖурнал(ТекстОшибки, Выборка.Ссылка);
				СтруктураОтвета.ОписаниеОшибки = ТекстОшибки;
				Возврат СтруктураОтвета;
			КонецПопытки;
		КонецЦикла;
		
	ИначеЕсли ШагКорректировки = 9 Тогда
		//лдя всех возвратов продукции, которые оформлены по ЗНП с видом "Комплектующие" или "Перезаказ"
		//заменим ссылку ЗНП на ЗП
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДанныеДокумента.Ссылка КАК Ссылка,
		|	ДанныеДокумента.Основание КАК Основание
		|ИЗ
		|	Документ.ВозвратПродукции КАК ДанныеДокумента
		|ГДЕ
		|	ТИПЗНАЧЕНИЯ(ДанныеДокумента.Основание) = ТИП(Документ.ЗаказНаПроизводство)
		|	И (ДанныеДокумента.Основание.ВидЗаказа = ЗНАЧЕНИЕ(Перечисление.ВидыЗаказовНаПроизводство.Перезаказ)
		|			ИЛИ ДанныеДокумента.Основание.ВидЗаказа = ЗНАЧЕНИЕ(Перечисление.ВидыЗаказовНаПроизводство.ЗаказНаПродажу))
		|	И ДанныеДокумента.Основание В (&МассивОснований)";
		
		Выборка = Запрос.Выполнить().Выбрать();		
		Пока Выборка.Следующий() Цикл
			ДокОбъект = Выборка.Ссылка.ПолучитьОбъект();
			Попытка
				
				ЗаменитьОснованиеНаЗаказПокупателя(ДокОбъект.Основание, ДокОбъект.Основание.ДокументОснование);
				
				Если ДокОбъект.Проведен Тогда
					ДокОбъект.Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Неоперативный);
				Иначе
					ДокОбъект.Записать(РежимЗаписиДокумента.Запись);
				КонецЕсли;
			Исключение
				ТекстОшибки = "Ошибка замены ссылки зааза на произвоство на ссылку заказа покупателя в " + Выборка.Ссылка + ": " + ОписаниеОшибки();
				ЗаписатьОшибкуВЖурнал(ТекстОшибки, Выборка.Ссылка);
				СтруктураОтвета.ОписаниеОшибки = ТекстОшибки;
				Возврат СтруктураОтвета;
			КонецПопытки;
		КонецЦикла;
		
	КонецЕсли;
	
	// успешно прошли
	СтруктураОтвета.Успешно = Истина;
	Возврат СтруктураОтвета;
	
КонецФункции

Функция ЗаполнитьУИСтрокВЗНП(СсылкаДокумент)
	
	РезультатОбработки = Новый Структура;
	РезультатОбработки.Вставить("Успешно", Истина);
	РезультатОбработки.Вставить("ОписаниеОшибки","");
	
	ЗНПИзменен = Ложь;
	ЗНПОбъект = СсылкаДокумент.ПолучитьОбъект();
	УИСПотолка = "";
	
	Если ЗНПОбъект.ВидЗаказа = Перечисления.ВидыЗаказовНаПроизводство.ПроизводствоПотолка Тогда
		Если ПустаяСтрока(ЗНПОбъект.ПродукцияУИСтроки) Тогда
			ЗНПОбъект.ПродукцияУИСтроки = Новый УникальныйИдентификатор;
			УИСПотолка = ЗНПОбъект.ПродукцияУИСтроки; 
			ЗНПИзменен = Истина;
		КонецЕсли;
	ИначеЕсли ЗНПОбъект.ВидЗаказа = Перечисления.ВидыЗаказовНаПроизводство.ТиповоеПроизводство Тогда
		Для Каждого СтрокаПродукция Из ЗНПОбъект.Продукция Цикл
			Если ПустаяСтрока(СтрокаПродукция.УИСтроки) Тогда
				СтрокаПродукция.УИСтроки = Новый УникальныйИдентификатор;
				Если ПустаяСтрока(УИСПотолка) Тогда
					//для типового производства запомним только УИ первой продукции, чтобы на нее отнести все материалы
					УИСПотолка = ЗНПОбъект.ПродукцияУИСтроки;
				КонецЕсли;
				ЗНПИзменен = Истина;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	//заполним УИ Услуг
	Для Каждого ТекущаяСтрока Из ЗНПОбъект.Услуги Цикл
		Если ПустаяСтрока(ТекущаяСтрока.УИСтроки) Тогда
			ТекущаяСтрока.УИСтроки = УИСПотолка;
			ЗНПИзменен = Истина;
		КонецЕсли;
	КонецЦикла;
	
	//заполним УИ материалов
	Для Каждого ТекущаяСтрока Из ЗНПОбъект.Материалы Цикл
		Если ПустаяСтрока(ТекущаяСтрока.УИСтроки) Тогда
			ТекущаяСтрока.УИСтроки = УИСПотолка;
			ЗНПИзменен = Истина;
		КонецЕсли;
	КонецЦикла;
	
	Если ЗНПИзменен Тогда
		Попытка
			ЗНПОбъект.ОбменДанными.Загрузка = Истина;
			ЗНПОбъект.Записать();
		Исключение
			РезультатОбработки.Успешно = Ложь;
			РезультатОбработки.ОписаниеОшибки = "При заполнении УИ строки ЗнП: " + ОписаниеОшибки();
			Возврат РезультатОбработки;
		КонецПопытки;
	КонецЕсли;
	
	Возврат РезультатОбработки;
	
КонецФункции

#КонецОбласти

#Область Обработка_2_0_0_Se

Функция Обработка_2_0_0_Se(СсылкаДокумент) Экспорт
	
	РезультатОбработки = Новый Структура;
	РезультатОбработки.Вставить("Успешно", Ложь);
	РезультатОбработки.Вставить("ОписаниеОшибки", "");
	
	Если ТипЗнч(СсылкаДокумент) = Тип("ДокументСсылка.ЗаказПокупателя") Тогда
		
		ЗПОбъект = СсылкаДокумент.ПолучитьОбъект();
		
		//сначала заполним УИСтрок потолков или свободных товаров, вдруг есть потолки с пустыми УИСтрокии нам нужно будет потом присвоенный УИСтроки указывать как родительский для подчиненных строк
		Для Каждого Товар Из ЗПОбъект.Товары Цикл
			Если ПустаяСтрока(Товар.УИСтроки) и Товар.Потолок.Пустая() Тогда
				Товар.УИСтроки = Новый УникальныйИдентификатор;
				Товар.УИСтрокиРодителя = Товар.УИСтроки;
			КонецЕсли;
		КонецЦикла;
		
		//Теперь переберем подчиненные строки
		Для Каждого Товар Из ЗПОбъект.Товары Цикл
			Если ПустаяСтрока(Товар.УИСтроки) и НЕ Товар.Потолок.Пустая() Тогда
				Товар.УИСтроки = Новый УникальныйИдентификатор;
				
				Отбор = Новый Структура;
				Отбор.Вставить("Номенклатура", Товар.Потолок);
				НайденныеСтроки = ЗПОбъект.Товары.НайтиСтроки(Отбор);
				Если НайденныеСтроки.Количество() > 0 Тогда
					Товар.УИСтрокиРодителя = НайденныеСтроки[0].УИСтроки;
				Иначе
					//почему-то сам потолок не нашли... 
					Товар.УИСтрокиРодителя = Товар.УИСтроки;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		
		Попытка
			ЗПОбъект.Записать();
		Исключение
			РезультатОбработки.Успешно = Ложь;
			РезультатОбработки.ОписаниеОшибки = "Ошибка при заполнении УИ строк заказа покупателя: " + ОписаниеОшибки();
			Возврат РезультатОбработки;
		КонецПопытки
		
	КонецЕсли;
	
	РезультатОбработки.Успешно = Истина;
	Возврат РезультатОбработки;
	
КонецФункции

#КонецОбласти

#Область Обработка_2_0_0_0

Функция Обработка_2_0_0_0(СсылкаДокумент) Экспорт
	
	РезультатОбработки = Новый Структура;
	РезультатОбработки.Вставить("Успешно", Ложь);
	РезультатОбработки.Вставить("ОписаниеОшибки", "");
	
	//Перемещения с таблицей назначения: Товары или Материалы нужно проставить назначение в самой табличной части
	Если ТипЗнч(СсылкаДокумент) = Тип("ДокументСсылка.ПеремещениеТоваров") Тогда
		
		ДокОбъект = СсылкаДокумент.ПолучитьОбъект();		
		
		Если ДокОбъект.ТаблицаНазначения = "Товары"
			ИЛИ ДокОбъект.ТаблицаНазначения = "Материалы" Тогда
			
			Для Каждого Строка Из ДокОбъект.Товары Цикл
				Строка.ТаблицаНазначения = ДокОбъект.УДАЛИТЬ_ТаблицаНазначения;
			КонецЦикла;	
			
			Попытка
				Если ДокОбъект.Проведен Тогда
					ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
				Иначе
					ДокОбъект.Записать(РежимЗаписиДокумента.Запись);
				КонецЕсли; 
				РезультатОбработки.Успешно = Истина;
			Исключение
				РезультатОбработки.Успешно = Ложь;
				РезультатОбработки.ОписаниеОшибки = ОписаниеОшибки();
			КонецПопытки;
			
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(СсылкаДокумент) = Тип("ДокументСсылка.АвансовыйОтчет") 
		ИЛИ ТипЗнч(СсылкаДокумент) = Тип("ДокументСсылка.ВозвратПродукции")
		ИЛИ ТипЗнч(СсылкаДокумент) = Тип("ДокументСсылка.ВозвратТовараОтПокупателя")
		ИЛИ ТипЗнч(СсылкаДокумент) = Тип("ДокументСсылка.ВозвратТовараПоставщику")
		ИЛИ ТипЗнч(СсылкаДокумент) = Тип("ДокументСсылка.Замена") 
		ИЛИ ТипЗнч(СсылкаДокумент) = Тип("ДокументСсылка.КорректировкаДолга")
		ИЛИ ТипЗнч(СсылкаДокумент) = Тип("ДокументСсылка.Монтаж")
		ИЛИ ТипЗнч(СсылкаДокумент) = Тип("ДокументСсылка.ОплатаБанковскойКартой")
		ИЛИ ТипЗнч(СсылкаДокумент) = Тип("ДокументСсылка.ПоступлениеНаРасчетныйСчет")
		ИЛИ ТипЗнч(СсылкаДокумент) = Тип("ДокументСсылка.ПоступлениеТоваровИУслуг")
		ИЛИ ТипЗнч(СсылкаДокумент) = Тип("ДокументСсылка.ПриходныйКассовыйОрдер")
		ИЛИ ТипЗнч(СсылкаДокумент) = Тип("ДокументСсылка.РасходныйКассовыйОрдер")
		ИЛИ ТипЗнч(СсылкаДокумент) = Тип("ДокументСсылка.РеализацияТоваровИУслуг")
		ИЛИ ТипЗнч(СсылкаДокумент) = Тип("ДокументСсылка.СписаниеСРасчетногоСчета")
		Тогда
		
		НаборЗаписей = РегистрыНакопления.ВзаиморасчетыСКонтрагентами.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Регистратор.Установить(СсылкаДокумент);
		НаборЗаписей.Прочитать();
		Для каждого Движение из НаборЗаписей Цикл
			Движение.Документ = СсылкаДокумент;			
		КонецЦикла;
		
		Попытка
			НаборЗаписей.Записать();
			РезультатОбработки.Успешно = Истина;
		Исключение
			РезультатОбработки.Успешно = Ложь;
			РезультатОбработки.ОписаниеОшибки = ОписаниеОшибки();
		КонецПопытки;			
		
	КонецЕсли;
	
	Если ТипЗнч(СсылкаДокумент) = Тип("ДокументСсылка.РеализацияТоваровИУслуг") Тогда
		
		НаборЗаписей = РегистрыНакопления.Продажи.СоздатьНаборЗаписей();
