		Если ТипЗнч(ИспользуемыеРегионы) = Тип("Строка") Тогда
			ИспользуемыеРегионыМассив = СтрРазделить(ИспользуемыеРегионы, ",", Ложь);
			Для каждого КодСубъекта из ИспользуемыеРегионыМассив Цикл
				Попытка
					ОбщийМодульСервер.ЗагрузитьАдресаРегионаФиас2(КодСубъекта);
				Исключение
					Сообщить(ОписаниеОшибки());
				КонецПопытки;
			КонецЦикла;
		КонецЕсли;
		
		РезультатОбработки.Успешно = Истина;
		
	КонецЕсли;

	Возврат РезультатОбработки;
	
