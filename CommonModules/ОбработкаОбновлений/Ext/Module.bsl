			Исключение
				РезультатОбработки.Успешно = Ложь;
				РезультатОбработки.ОписаниеОшибки = ОписаниеОшибки();
			КонецПопытки;
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.ПоступлениеНаРасчетныйСчет") 
		Тогда
		
		ДокОбъект = СсылкаНаОбъект.ПолучитьОбъект();
		Если ДокОбъект.ВидОперации = Перечисления.ВидыОперацийПоступлениеНаРасчетныйСчет.ИнкассацияВБанк
			И НЕ ДокОбъект.СтатьяДоходов = Справочники.СтатьиДоходовИРасходов.ПустаяСсылка() Тогда
			
			ДокОбъект.СтатьяДоходов = Справочники.СтатьиДоходовИРасходов.ПустаяСсылка();
			
			Попытка
				ДокОбъект.ДополнительныеСвойства.Вставить("ПропуститьПроверкуЗапретаИзменения", Истина);
				Если ДокОбъект.Проведен Тогда
					ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
				Иначе
					ДокОбъект.Записать();
				КонецЕсли;
				РезультатОбработки.Успешно = Истина;
			Исключение
				РезультатОбработки.Успешно = Ложь;
				РезультатОбработки.ОписаниеОшибки = ОписаниеОшибки();
			КонецПопытки;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат РезультатОбработки;
	
КонецФункции

#КонецОбласти

#Область Обработка_2_7_37_0

Функция Обработка_2_7_37_0(СсылкаНаОбъект, ОбработкаОбязательныхОбъектов) Экспорт
	
