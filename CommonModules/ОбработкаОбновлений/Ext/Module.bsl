	//#7042 При обновлении на версию в документе "Установка стоимости выработки" не заполнилась "Вид начисления"
	Если ТипЗнч(СсылкаДокумент) = Тип("ДокументСсылка.УстановкаСтоимостиВыработкиПоНоменклатуре") Тогда
