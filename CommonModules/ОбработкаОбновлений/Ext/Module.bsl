				Движение = НаборЗаписей.Добавить();
				Движение.Период = СсылкаНаОбъект.Дата;
				Движение.Организация = СсылкаНаОбъект.Организация;
				Движение.Подразделение = СсылкаНаОбъект.Подразделение;
				Движение.Склад = СсылкаНаОбъект.Склад;
				Движение.ДоговорКонтрагента = СсылкаНаОбъект.ДоговорКонтрагента;
				Движение.ДокументПродажи = ТекущаяСтрока.ДокументПродажи; //?(ЗначениеЗаполнено(ТекущаяСтрока.ДокументПродажи), ТекущаяСтрока.ДокументПродажи, Основание);
				Движение.ЗаказПокупателя = ТекущаяСтрока.ЗаказПокупателя;
				Движение.Контрагент = СсылкаНаОбъект.Контрагент;
				Движение.Номенклатура = ТекущаяСтрока.Номенклатура;
				Движение.ХарактеристикаНоменклатуры = ТекущаяСтрока.ХарактеристикаНоменклатуры;
				Движение.СерияНоменклатуры = ТекущаяСтрока.СерияНоменклатуры;
				Движение.ЕдиницаИзмерения = ТекущаяСтрока.ЕдиницаИзмерения;         //#14300
