Процедура ЗафиксироватьНеуспешнуюОбработку(ВерсияПрограммы, ВерсияПрограммыЧисло, ОбъектСсылка, ОбъектДата, Знач ОписаниеОшибки = "", ОбработкаОбязательныхОбъектов)
	
	ЗаписьЖурналаРегистрации("Обновление_"+ВерсияПрограммы, УровеньЖурналаРегистрации.Ошибка,,,"Не удалось обработать объект " + ОбъектСсылка + " : " + ОписаниеОшибки);
	
	Если ОбработкаОбязательныхОбъектов Тогда
		
		НаборЗаписей = РегистрыСведений.ОбъектыКОбработкеПослеОбновленияОбязательные.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.ВерсияПрограммы.Установить(ВерсияПрограммы);
		НаборЗаписей.Отбор.ВерсияПрограммыЧисло.Установить(ВерсияПрограммыЧисло);
		НаборЗаписей.Отбор.ОбъектСсылка.Установить(ОбъектСсылка);
		
		НоваяЗапись = НаборЗаписей.Добавить();
		НоваяЗапись.ВерсияПрограммы = ВерсияПрограммы;
		НоваяЗапись.ВерсияПрограммыЧисло = ВерсияПрограммыЧисло;
		НоваяЗапись.ОбъектСсылка = ОбъектСсылка;
		НоваяЗапись.ОбъектДата = ОбъектДата;
		НоваяЗапись.РезультатОбработки = ОписаниеОшибки;
		
		НаборЗаписей.Записать(Истина);
		
	Иначе		
		
		НаборЗаписей = РегистрыСведений.ОбъектыКОбработкеПослеОбновленияРекомендуемые.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.ВерсияПрограммы.Установить(ВерсияПрограммы);
		НаборЗаписей.Отбор.Документ.Установить(ОбъектСсылка);
		
		НоваяЗапись = НаборЗаписей.Добавить();
		НоваяЗапись.ВерсияПрограммы = ВерсияПрограммы;
		НоваяЗапись.ВерсияПрограммыЧисло = ВерсияПрограммыЧисло;
		НоваяЗапись.Документ = ОбъектСсылка;
		НоваяЗапись.ДокументДата = ОбъектДата;
		НоваяЗапись.РезультатОбработки = ОписаниеОшибки;
		
		НаборЗаписей.Записать(Истина);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗафиксироватьУспешнуюОбработку(ВерсияПрограммы, ВерсияПрограммыЧисло, ОбъектСсылка, ОбработкаОбязательныхОбъектов) Экспорт
	
	Если ОбработкаОбязательныхОбъектов Тогда
		
		НаборЗаписей = РегистрыСведений.ОбъектыКОбработкеПослеОбновленияОбязательные.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.ВерсияПрограммы.Установить(ВерсияПрограммы);
		НаборЗаписей.Отбор.ВерсияПрограммыЧисло.Установить(ВерсияПрограммыЧисло);
		НаборЗаписей.Отбор.ОбъектСсылка.Установить(ОбъектСсылка); 
		
		НаборЗаписей.Записать();
		
	Иначе
		
		НаборЗаписей = РегистрыСведений.ОбъектыКОбработкеПослеОбновленияРекомендуемые.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.ВерсияПрограммы.Установить(ВерсияПрограммы);
		НаборЗаписей.Отбор.ВерсияПрограммыЧисло.Установить(ВерсияПрограммыЧисло);
		НаборЗаписей.Отбор.Документ.Установить(ОбъектСсылка); 
		
		НаборЗаписей.Записать();
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПроверитьОбработку200AB()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ОбъектыКОбработкеПослеОбновленияРекомендуемые.ВерсияПрограммы КАК ВерсияПрограммы
	|ИЗ
	|	РегистрСведений.ОбъектыКОбработкеПослеОбновленияРекомендуемые КАК ОбъектыКОбработкеПослеОбновленияРекомендуемые
	|ГДЕ
	|	(ОбъектыКОбработкеПослеОбновленияРекомендуемые.ВерсияПрограммы = ""2.0.0.$a""
	|			ИЛИ ОбъектыКОбработкеПослеОбновленияРекомендуемые.ВерсияПрограммы = ""2.0.0.$b"")";
	
	РезультатЗапроса = Запрос.Выполнить();
	Если НЕ РезультатЗапроса.Пустой() Тогда
		ВызватьИсключение "Не завершена обработка документов версии ""2.0.0.$a"" и ""2.0.0.$b""";
	КонецЕсли;	
	
КонецПроцедуры

//ФУНКЦИИ ОБРАБОТКИ ОБЪЕКТОВ СОГЛАСНО ВЕРСИИ ПРОГРАММЫ
//
Функция Обработка_0_9_11_1(СсылкаДокумент) Экспорт
	
	РезультатОбработки = Новый Структура;
	РезультатОбработки.Вставить("Успешно", Ложь);
	РезультатОбработки.Вставить("ОписаниеОшибки", "");
	
	Если ТипЗнч(СсылкаДокумент) = Тип("ДокументСсылка.РеализацияТоваровИУслуг") Тогда
		
		ДокОбъект = СсылкаДокумент.ПолучитьОбъект();
		Попытка
			ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
			РезультатОбработки.Успешно = Истина;
		Исключение
			РезультатОбработки.Успешно = Ложь;
			РезультатОбработки.ОписаниеОшибки = ОписаниеОшибки();
		КонецПопытки;
		
	ИначеЕсли ТипЗнч(СсылкаДокумент) = Тип("ДокументСсылка.ЗаказНаПроизводство") Тогда
		
		ДокОбъект = СсылкаДокумент.ПолучитьОбъект();
		Попытка
			ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
			РезультатОбработки.Успешно = Истина;
		Исключение
			РезультатОбработки.Успешно = Ложь;
			РезультатОбработки.ОписаниеОшибки = ОписаниеОшибки();
		КонецПопытки;
		
	ИначеЕсли ТипЗнч(СсылкаДокумент) = Тип("ДокументСсылка.Монтаж") Тогда
		
		ДокОбъект = СсылкаДокумент.ПолучитьОбъект();
		Попытка
			ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
			РезультатОбработки.Успешно = Истина;
		Исключение
			РезультатОбработки.Успешно = Ложь;
			РезультатОбработки.ОписаниеОшибки = ОписаниеОшибки();
		КонецПопытки;
		
	ИначеЕсли ТипЗнч(СсылкаДокумент) = Тип("ДокументСсылка.ПриходныйКассовыйОрдер") Тогда
		
		ДокОбъект = СсылкаДокумент.ПолучитьОбъект();
		СписокЗаказов = Новый ТаблицаЗначений;
		СписокЗаказов.Колонки.Добавить("Заказ");
		СписокЗаказов.Колонки.Добавить("Сумма");
		Для Каждого ТекСтрокаДокумента Из СсылкаДокумент.Ссылка.РаспределениеПлатежа Цикл
			Если ТипЗнч(ТекСтрокаДокумента.Документ) = Тип("ДокументСсылка.РеализацияТоваровИУслуг") Тогда 
				Если ТипЗнч(ТекСтрокаДокумента.Документ.Основание) = Тип("ДокументСсылка.ЗаказПокупателя") 
					или ТипЗнч(ТекСтрокаДокумента.Документ.Основание) = Тип("ДокументСсылка.ЗаказНаПроизводство") Тогда
					Если НЕ ТекСтрокаДокумента.Документ.Основание.ПУстая() Тогда
						НоваяСтрока = СписокЗаказов.Добавить();
						НоваяСтрока.Заказ = ТекСтрокаДокумента.Документ.Основание;
						НоваяСтрока.Сумма = ТекСтрокаДокумента.Сумма;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		
		Для Каждого ТекСтрокаСпискаЗаказов Из СписокЗаказов Цикл
			Нашли = Ложь;
			Для Каждого ТекСтрокаДокумента Из СсылкаДокумент.РаспределениеПлатежа Цикл
				Если ТекСтрокаДокумента.Документ = ТекСтрокаСпискаЗаказов.Заказ Тогда
					Нашли = Истина;
				КонецЕсли;
			КонецЦикла;
			
			Если НЕ Нашли Тогда
				НоваяСтрокаДокумента = ДокОбъект.РаспределениеПлатежа.Добавить();
				НоваяСтрокаДокумента.Документ = ТекСтрокаСпискаЗаказов.Заказ;
				НоваяСтрокаДокумента.Сумма = ТекСтрокаСпискаЗаказов.Сумма;
			КонецЕсли;
		КонецЦикла;
		
		Попытка
			ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
			РезультатОбработки.Успешно = Истина;
		Исключение
			РезультатОбработки.Успешно = Ложь;
			РезультатОбработки.ОписаниеОшибки = ОписаниеОшибки();
		КонецПопытки;
		
	ИначеЕсли ТипЗнч(СсылкаДокумент) = Тип("ДокументСсылка.ОплатаБанковскойКартой") Тогда
		
		ДокОбъект = СсылкаДокумент.ПолучитьОбъект();
		Попытка
			ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
			РезультатОбработки.Успешно = Истина;
		Исключение
			РезультатОбработки.Успешно = Ложь;
			РезультатОбработки.ОписаниеОшибки = ОписаниеОшибки();
		КонецПопытки;
		
	ИначеЕсли ТипЗнч(СсылкаДокумент) = Тип("ДокументСсылка.ПоступлениеНаРасчетныйСчет") Тогда
		
		ДокОбъект = СсылкаДокумент.ПолучитьОбъект();
		Попытка
			ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
			РезультатОбработки.Успешно = Истина;
		Исключение
			РезультатОбработки.Успешно = Ложь;
			РезультатОбработки.ОписаниеОшибки = ОписаниеОшибки();
		КонецПопытки;
		
	КонецЕсли;
	
	Возврат РезультатОбработки;
	
КонецФункции

Функция Обработка_1_0_0_0(СсылкаДокумент) Экспорт
	
	РезультатОбработки = Новый Структура;
	РезультатОбработки.Вставить("Успешно", Ложь);
	РезультатОбработки.Вставить("ОписаниеОшибки", "");
	
	Если ТипЗнч(СсылкаДокумент) = Тип("ДокументСсылка.СоставПроизводственнойСмены") Тогда
		
		ДокОбъект = СсылкаДокумент.ПолучитьОбъект();
		
		Для Каждого ТекСотрудник Из ДокОбъект.Сотрудники Цикл
			Если ТекСотрудник.Коэффициент = 0 Тогда
				ТекСотрудник.Коэффициент = 1;
			КонецЕсли;
		КонецЦикла;
		
		Попытка
			Если СсылкаДокумент.Проведен Тогда
				ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
			Иначе
				ДокОбъект.Записать();
			КонецЕсли;
			РезультатОбработки.Успешно = Истина;
		Исключение
			РезультатОбработки.Успешно = Ложь;
			РезультатОбработки.ОписаниеОшибки = ОписаниеОшибки();
		КонецПопытки;
		
	КонецЕсли;
	
	Возврат РезультатОбработки;
	
КонецФункции

Функция Обработка_1_0_1_0(СсылкаДокумент) Экспорт
	
	РезультатОбработки = Новый Структура;
	РезультатОбработки.Вставить("Успешно", Ложь);
	РезультатОбработки.Вставить("ОписаниеОшибки", "");
	
	Если ТипЗнч(СсылкаДокумент) = Тип("ДокументСсылка.ЗаказДоговор") Тогда
		
		Записывать = Ложь;
		ДокОбъект = СсылкаДокумент.ПолучитьОбъект();
		Если ДокОбъект.ТочкаПродаж.Пустая() Тогда
			Если ТипЗнч(ДокОбъект.Основание) = Тип("ДокументСсылка.Лид") Тогда
				Если НЕ ДокОбъект.Основание.Пустая() Тогда
					Если НЕ ДокОбъект.Основание.ТочкаПродаж.Пустая() Тогда
						ДокОбъект.ТочкаПродаж = ДокОбъект.Основание.ТочкаПродаж;
						Записывать = Истина;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		
		Попытка
			Если Записывать Тогда
				ДокОбъект.Записать();
			КонецЕсли;
			РезультатОбработки.Успешно = Истина;
		Исключение
			РезультатОбработки.Успешно = Ложь;
			РезультатОбработки.ОписаниеОшибки = ОписаниеОшибки();
		КонецПопытки;
		
	ИначеЕсли ТипЗнч(СсылкаДокумент) = Тип("ДокументСсылка.ПоступлениеНаРасчетныйСчет")
		или ТипЗнч(СсылкаДокумент) = Тип("ДокументСсылка.СписаниеСРасчетногоСчета") Тогда
		
		Записывать = Ложь;
		ДокОбъект = СсылкаДокумент.ПолучитьОбъект();
		//Если НЕ ДокОбъект.Оплачено Тогда
		//	ДокОбъект.Оплачено = Истина;
		//	Записывать = Истина;
		//КонецЕсли;
		
		Попытка
			Если Записывать Тогда
				Если СсылкаДокумент.Проведен Тогда
					ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
				Иначе
					ДокОбъект.Записать();
				КонецЕсли;
			КонецЕсли;
			РезультатОбработки.Успешно = Истина;
		Исключение
			РезультатОбработки.Успешно = Ложь;
			РезультатОбработки.ОписаниеОшибки = ОписаниеОшибки();
		КонецПопытки;
		
	КонецЕсли;
	
	Возврат РезультатОбработки;
	
КонецФункции

Функция Обработка_1_0_2_0(СсылкаДокумент) Экспорт
	
	РезультатОбработки = Новый Структура;
	РезультатОбработки.Вставить("Успешно", Ложь);
	РезультатОбработки.Вставить("ОписаниеОшибки", "");
	
	Если ТипЗнч(СсылкаДокумент) = Тип("ДокументСсылка.ЗаказНаПроизводство") Тогда
		//в ТЧ "Услуги" заполняем значение колонки "Количество к выработке" по данным колонки "Количество", если "Количество к выработке не заполнено"
		
		Записывать = Ложь;
		ДокОбъект = СсылкаДокумент.ПолучитьОбъект();
		Для Каждого СтрокаУслуги Из ДокОбъект.Услуги Цикл
			Если СтрокаУслуги.КоличествоКВыработке = 0 Тогда
				СтрокаУслуги.КоличествоКВыработке = СтрокаУслуги.Количество;
				Записывать = Истина;
			КонецЕсли;
		КонецЦикла;
		
		
		Попытка
			Если Записывать Тогда
				Если ДокОбъект.Проведен Тогда
					ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
				Иначе
					ДокОбъект.Записать();
				КонецЕсли;
			КонецЕсли;
			РезультатОбработки.Успешно = Истина;
		Исключение
			РезультатОбработки.Успешно = Ложь;
			РезультатОбработки.ОписаниеОшибки = ОписаниеОшибки();
		КонецПопытки;
		
	ИначеЕсли ТипЗнч(СсылкаДокумент) = Тип("ДокументСсылка.ВыпускПродукции") Тогда
		//в документе "Выпуск продукции" заоплняем ТЧ "Услуги" по данным документа "Заказ на производство", если ТЧ пустая
		
		Записывать = Ложь;
		ДокОбъект = СсылкаДокумент.ПолучитьОбъект();
		Если ДокОбъект.Услуги.Количество() = 0 Тогда
			Если НЕ ДокОбъект.Основание.Пустая() Тогда
				Если НЕ ДокОбъект.Основание.Услуги.Количество() = 0 Тогда
					Для Каждого СтрокаУслуги Из ДокОбъект.Основание.Услуги Цикл
						НоваяСтрока = ДокОбъект.Услуги.Добавить();
						ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаУслуги);
					КонецЦикла;
					Записывать = Истина;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		Попытка
			Если Записывать Тогда
				Если ДокОбъект.Проведен Тогда
					ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
				Иначе
					ДокОбъект.Записать();
				КонецЕсли;
			КонецЕсли;
			РезультатОбработки.Успешно = Истина;
		Исключение
			РезультатОбработки.Успешно = Ложь;
			РезультатОбработки.ОписаниеОшибки = ОписаниеОшибки();
		КонецПопытки;
		
	КонецЕсли;
	
	Возврат РезультатОбработки;
	
КонецФункции

Функция Обработка_1_0_3_0(СсылкаДокумент) Экспорт
	
	РезультатОбработки = Новый Структура;
	РезультатОбработки.Вставить("Успешно", Ложь);
	РезультатОбработки.Вставить("ОписаниеОшибки", "");
	
