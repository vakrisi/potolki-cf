		Запрос = новый Запрос;
		ТекстЗапроса = "";
		
		Для Каждого ВидДокумента Из Метаданные.Документы Цикл
			
			Если ВидДокумента.Реквизиты.Найти("Контрагент") = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(ТекстЗапроса) Тогда
				ТекстЗапроса = ТекстЗапроса + "
				|	ОБЪЕДИНИТЬ ВСЕ";
			КонецЕсли;
			
			ТекстЗапроса = ТекстЗапроса + "
			|ВЫБРАТЬ
