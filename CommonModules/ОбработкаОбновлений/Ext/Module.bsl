Функция Обработка_2_7_5_0(СсылкаНаОбъект, ОбработкаОбязательныхОбъектов) Экспорт
	
	//Если ОбработкаОбязательныхОбъектов Тогда
	//	Возврат Обработка_2_7_5_0_Обязательные(СсылкаНаОбъект);
	//КонецЕсли;
	
	РезультатОбработки = Новый Структура;
	РезультатОбработки.Вставить("Успешно", Истина);
	РезультатОбработки.Вставить("ОписаниеОшибки", "");
	
	//#11666 заполнения измерения решстра ХарактеристикаНоменклатуры
	Если ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.ПоступлениеТоваровИУслуг") Тогда
		
		ДокОбъект = СсылкаНаОбъект.ПолучитьОбъект();
		
		НаборЗаписей = РегистрыНакопления.ЗаказыПоставщикам.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Регистратор.Установить(СсылкаНаОбъект);
		НаборЗаписей.Прочитать();
		НаборЗаписей.Очистить();
		
		Для Каждого ТекущаяСтрока Из ДокОбъект.Товары Цикл
			Движение = НаборЗаписей.Добавить();
			Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
			Движение.Период = ДокОбъект.Дата;
			Движение.ЗаказПоставщику = ДокОбъект.Основание;
			Движение.Организация = ДокОбъект.Организация;
			Движение.Номенклатура = ТекущаяСтрока.Номенклатура;
			Движение.ХарактеристикаНоменклатуры = ТекущаяСтрока.ХарактеристикаНоменклатуры;
			Движение.Количество = ТекущаяСтрока.Количество * ТекущаяСтрока.Коэффициент;
			Движение.Потолок = ТекущаяСтрока.Потолок;
			Движение.Цена = ТекущаяСтрока.Цена;
			Движение.ЕдиницаИзмерения = ТекущаяСтрока.ЕдиницаИзмерения;
			Движение.Сумма = ТекущаяСтрока.Сумма; //#8742
			
		КонецЦикла;
		Для Каждого ТекущаяСтрока Из ДокОбъект.Услуги Цикл
			Движение = НаборЗаписей.Добавить();
			Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
			Движение.Период = ДокОбъект.Дата;
			Движение.ЗаказПоставщику = ДокОбъект.Основание;
			Движение.Организация = ДокОбъект.Организация;
			Движение.Номенклатура = ТекущаяСтрока.Номенклатура;
			Движение.ХарактеристикаНоменклатуры = ТекущаяСтрока.ХарактеристикаНоменклатуры;
			Движение.Количество = ТекущаяСтрока.Количество * ТекущаяСтрока.Коэффициент;
			Движение.Потолок = ТекущаяСтрока.Потолок;
			Движение.Цена = ТекущаяСтрока.Цена;
			Движение.ЕдиницаИзмерения = ТекущаяСтрока.ЕдиницаИзмерения;
			Движение.Сумма = ТекущаяСтрока.Сумма;
		КонецЦикла;
		
		Попытка
			НаборЗаписей.Записать();
			РезультатОбработки.Успешно = Истина;
		Исключение
			РезультатОбработки.Успешно = Ложь;
			РезультатОбработки.ОписаниеОшибки = ОписаниеОшибки();
		КонецПопытки;
		
	КонецЕсли;
	
	Возврат РезультатОбработки;
	
КонецФункции

