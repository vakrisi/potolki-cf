#Область Обработка_3_1_3_0

Функция Обработка_3_1_3_0(СсылкаНаОбъект, ОбработкаОбязательныхОбъектов, ВерсияПрограммыЧисло) Экспорт
	
	Если ОбработкаОбязательныхОбъектов Тогда
		Возврат Обработка_3_1_3_0_Обязательные(СсылкаНаОбъект, ВерсияПрограммыЧисло);
	КонецЕсли;
	
	РезультатОбработки = Новый Структура;
	РезультатОбработки.Вставить("Успешно", Ложь);
	РезультатОбработки.Вставить("ОписаниеОшибки", "");
		
	Если ТипЗнч(СсылкаНаОбъект) = Тип("СправочникСсылка.НастройкиПредварительногоРасчетаЗаказаВРознице") Тогда

		//#16346 заполнение нового реквизита "ВидОперацииМонтажа" 
		СпрОбъект = СсылкаНаОбъект.ПолучитьОбъект();
		СпрОбъект.ВидОперацииМонтажа = Справочники.ВидыМонтажа.Монтаж;	 
		
		Попытка
			СпрОбъект.ОбменДанными.Загрузка = Истина;
			СпрОбъект.Записать();
			
			РезультатОбработки.Успешно = Истина;				
		Исключение				
			РезультатОбработки.Успешно = Ложь;
			РезультатОбработки.ОписаниеОшибки = ОписаниеОшибки();
		КонецПопытки;
		
	ИначеЕсли ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.Монтаж") Тогда
		
		Версия999 = ОбщийМодульСервер.ПолучитьНомерВерсииЧислом("3.1.3.0", 999);
		Версия10  = ОбщийМодульСервер.ПолучитьНомерВерсииЧислом("3.1.3.0", 10);
		
		Если ВерсияПрограммыЧисло = Версия999 Тогда
			// сверить выработку начисленную с новыми УСВ
			РеквизитыМонтажа = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СсылкаНаОбъект, "ДатаВыполнения, ДатаЗакрытия, Результат, СозданПриИспользованииСтатусаЗакрыт");
			
			//++ отмененные / в работе не проверяем
			//++ скорректированные вручную после обновления не проверяем
			Если РеквизитыМонтажа.Результат = Справочники.РезультатыМонтажа.Отменен
				ИЛИ РеквизитыМонтажа.Результат = Справочники.РезультатыМонтажа.ВРаботе 
				ИЛИ РеквизитыМонтажа.РучнаяКорректировкаВыработки
				Тогда
				РезультатОбработки.Успешно = Истина;
				Возврат РезультатОбработки;
			КонецЕсли;
			//--

			ДатаРасчетаВыработки = РеквизитыМонтажа.ДатаВыполнения;
			Если (РеквизитыМонтажа.Результат = Справочники.РезультатыМонтажа.Закрыт И РеквизитыМонтажа.СозданПриИспользованииСтатусаЗакрыт) Тогда
				ДатаРасчетаВыработки = РеквизитыМонтажа.ДатаЗакрытия;
			КонецЕсли;
			
			СтруктураПроверки = ОбщийМодульСервер.ВыработкаРасчетнаяИНачисленнаяСовпадают(СсылкаНаОбъект, ДатаРасчетаВыработки);
			Если СтруктураПроверки.Результат Тогда
				РезультатОбработки.Успешно = Истина;
			Иначе
				РезультатОбработки.Успешно = Ложь;
				РезультатОбработки.ОписаниеОшибки = СтрШаблон("Выработка начисленная (%1) и расчетная (%2) не совпадают", СтруктураПроверки.СуммаНачисленная, СтруктураПроверки.СуммаРасчетная);
			КонецЕсли;
			
		ИначеЕсли ВерсияПрограммыЧисло = Версия10 Тогда
			
			//#16346 очистка реквизита "ЗаказДоговор"
			ДокОбъект = СсылкаНаОбъект.ПолучитьОбъект();
			
			Если НЕ ДокОбъект.ЗаказДоговор = ДокОбъект.Основание 
				И ЗначениеЗаполнено(ДокОбъект.ЗаказДоговор)
				Тогда
				РезультатОбработки.Успешно = Ложь;
				РезультатОбработки.ОписаниеОшибки = "Расходятся значения Заказ-договор и основание в монтаже";
				
			Иначе
				
				ДокОбъект = СсылкаНаОбъект.ПолучитьОбъект();
				ДокОбъект.ЗаказДоговор = Документы.ЗаказДоговор.ПустаяСсылка();	 
				
				Попытка
					ДокОбъект.ОбменДанными.Загрузка = Истина;
					ДокОбъект.ДополнительныеСвойства.Вставить("ПропуститьПроверкуЗапретаИзменения", Истина);
					ДокОбъект.Записать();
					
					РезультатОбработки.Успешно = Истина;				
				Исключение				
					РезультатОбработки.Успешно = Ложь;
					РезультатОбработки.ОписаниеОшибки = ОписаниеОшибки();
				КонецПопытки;
			КонецЕсли;

		КонецЕсли;
		
	ИначеЕсли ТипЗнч(СсылкаНаОбъект) = Тип("СправочникСсылка.ВидыКонтактов") Тогда
		
		МассивСсылок = новый Массив;
		МассивСсылок.Добавить(СсылкаНаОбъект);
		
		// проверить Б24
		// Обработка НастройкиСинхронизацииСБитрикс24
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	НастройкиСинхронизацииСБитрикс24.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.НастройкиСинхронизацииСБитрикс24 КАК НастройкиСинхронизацииСБитрикс24";
		
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			НастройкаСинхронизации = Выборка.Ссылка;	
			НастройкиОбмена = НастройкаСинхронизации.ХранилищеНастроек.Получить();
			Если НЕ НастройкиОбмена = Неопределено И НастройкиОбмена.Свойство("НастройкиСинхронизацииЛидов") Тогда
				СтруктураНастроек = НастройкиОбмена.НастройкиСинхронизацииЛидов;	
				Для каждого запись из СтруктураНастроек.ТаблицаПолей Цикл
					Если запись.ИмяПоля = "ВидКонтакта" Тогда
						Для каждого СсылкаНаТелефон из МассивСсылок Цикл
							Если запись.Значение = СсылкаНаТелефон Тогда
								запись.Значение = Справочники.ВидыКонтактов.Телефон;
							КонецЕсли;	
						КонецЦикла;
					КонецЕсли;	
				КонецЦикла;
				НастройкиОбмена.НастройкиСинхронизацииЛидов = СтруктураНастроек;
				ТекущаяНастройкаСинхронизации = НастройкаСинхронизации.ПолучитьОбъект();
				ТекущаяНастройкаСинхронизации.СинхронизацияСделок = Истина;
				ТекущаяНастройкаСинхронизации.ХранилищеНастроек = Новый ХранилищеЗначения(НастройкиОбмена);
				Попытка
					ТекущаяНастройкаСинхронизации.Записать();
					РезультатОбработки.Успешно = Истина;
				Исключение
					РезультатОбработки.Успешно = Ложь;
					РезультатОбработки.ОписаниеОшибки = ОписаниеОшибки();
				КонецПопытки;	
			Иначе 
				РезультатОбработки.Успешно = Истина;
			КонецЕсли;	
		КонецЦикла;
		
		// остальное		
		ТаблицаСсылок = НайтиПоСсылкам(МассивСсылок);
		Если ТаблицаСсылок.Количество()> 1 Тогда
			
			Для каждого строкаТС из ТаблицаСсылок Цикл
				
				// Обработка Лидов
				Если строкаТС.Метаданные.Имя = "Лид" Тогда
					ДокОбъект = строкаТС.Данные.ПолучитьОбъект();
					ДокОбъект.ВидКонтакта = Справочники.ВидыКонтактов.Телефон;
					Попытка
						ДокОбъект.Записать();
						РезультатОбработки.Успешно = Истина;
					Исключение
						РезультатОбработки.Успешно = Ложь;
						РезультатОбработки.ОписаниеОшибки = ОписаниеОшибки();
					КонецПопытки;
					
					// Обновляем проводку	
					НаборЗаписей = РегистрыСведений.ВходящиеКонтакты.СоздатьНаборЗаписей();
					НаборЗаписей.Отбор.Регистратор.Установить(строкаТС.Данные);
					НаборЗаписей.Прочитать();
					Для каждого Движение из НаборЗаписей Цикл
						Движение.ВидКонтакта	= Справочники.ВидыКонтактов.Телефон;
					КонецЦикла;
					
					Попытка
						НаборЗаписей.Записать();
						РезультатОбработки.Успешно = Истина;
					Исключение
						РезультатОбработки.Успешно = Ложь;
						РезультатОбработки.ОписаниеОшибки = ОписаниеОшибки();
					КонецПопытки;
				КонецЕсли;
				
				// Обработка УстановкаСтоимостиВыработкиПоНоменклатуре
				Если строкаТС.Метаданные.Имя = "УстановкаСтоимостиВыработкиПоНоменклатуре" Тогда
					ДокОбъект = строкаТС.Данные.ПолучитьОбъект();
					Для каждого запись из ДокОбъект.ВыработкаЛид Цикл
						Если Запись.НомерСтроки = строкаТС.Данные.НомерСтроки Тогда 
							Запись.ВидКонтакта = Справочники.ВидыКонтактов.Телефон;
						КонецЕсли;
					КонецЦикла;
					Попытка
						ДокОбъект.Записать();
						РезультатОбработки.Успешно = Истина;
					Исключение
						РезультатОбработки.Успешно = Ложь;
						РезультатОбработки.ОписаниеОшибки = ОписаниеОшибки();
					КонецПопытки;		
				КонецЕсли;	
				
				// Обрабатываем пользоватлей	
				Если строкаТС.Метаданные.Имя = "ПраваПользователей" Тогда
					НаборЗаписей = РегистрыСведений.ПраваПользователей.СоздатьНаборЗаписей();
					НаборЗаписей.Отбор.Пользователь.Установить(строкаТС.Данные.Пользователь, Истина);
					НаборЗаписей.Прочитать();  
					Для каждого запись из НаборЗаписей Цикл
						Запись.ВидВходящегоКонтактаСофтФон = Справочники.ВидыКонтактов.Телефон;
					КонецЦикла;
					Попытка
						НаборЗаписей.Записать();
						РезультатОбработки.Успешно = Истина;
					Исключение
						РезультатОбработки.Успешно = Ложь;
						РезультатОбработки.ОписаниеОшибки = ОписаниеОшибки();
					КонецПопытки;	
				КонецЕсли;	
				
			КонецЦикла;
		Иначе
			РезультатОбработки.Успешно = Истина;
		КонецЕсли;
		
		Если РезультатОбработки.Успешно Тогда
			ТаблицаСсылок = НайтиПоСсылкам(МассивСсылок);
			Если ТаблицаСсылок.Количество()= 1 Тогда
				Для каждого ЗаписьМС Из	МассивСсылок Цикл
					ОбъектВидКонтакта = ЗаписьМС.ПолучитьОбъект();
					Попытка
						ОбъектВидКонтакта.Удалить();
					Исключение
					КонецПопытки;
				КонецЦикла;	
			КонецЕсли;	
		КонецЕсли;
		
		
	КонецЕсли;
	
	Возврат РезультатОбработки;
	
КонецФункции

Функция Обработка_3_1_3_0_Обязательные(СсылкаНаОбъект, ВерсияПрограммыЧисло) Экспорт
	
	РезультатОбработки = Новый Структура;
	РезультатОбработки.Вставить("Успешно", Ложь);
	РезультатОбработки.Вставить("ОписаниеОшибки", "");
	
	
	Если ТипЗнч(СсылкаНаОбъект) = Тип("СправочникСсылка.ВидыПродукции") Тогда

		//#16283 
		СпрОбъект = СсылкаНаОбъект.ПолучитьОбъект();
		СпрОбъект.ГруппаНоменклатуры = Константы.УДАЛИТЬ_ГруппаНоменклатурыДляПродукции.Получить();	 
		
		Попытка
			СпрОбъект.ОбменДанными.Загрузка = Истина;
			СпрОбъект.Записать();
			
			РезультатОбработки.Успешно = Истина;				
		Исключение				
			РезультатОбработки.Успешно = Ложь;
			РезультатОбработки.ОписаниеОшибки = ОписаниеОшибки();
		КонецПопытки;
		
	ИначеЕсли ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.УстановкаСтоимостиВыработкиПоНоменклатуре") Тогда
		
		Версия10 = ОбщийМодульСервер.ПолучитьНомерВерсииЧислом("3.1.3.0", 10);
		Версия20 = ОбщийМодульСервер.ПолучитьНомерВерсииЧислом("3.1.3.0", 20);
		
		Если ВерсияПрограммыЧисло = Версия10 Тогда
			
			//#16268 заполнение нового реквизита
			ДокОбъект = СсылкаНаОбъект.ПолучитьОбъект();
			ДокОбъект.ВидПродукции = Справочники.ВидыПродукции.Конструкция;	 
			
			Попытка
				ДокОбъект.ОбменДанными.Загрузка = Истина;			
				ДокОбъект.ДополнительныеСвойства.Вставить("ПропуститьПроверкуЗапретаИзменения", Истина);
				ДокОбъект.Записать();
				
				РезультатОбработки.Успешно = Истина;				
			Исключение				
				РезультатОбработки.Успешно = Ложь;
				РезультатОбработки.ОписаниеОшибки = ОписаниеОшибки();
			КонецПопытки;
			
		ИначеЕсли ВерсияПрограммыЧисло = Версия20 Тогда
			
			//#16346 
			ДокОбъект = СсылкаНаОбъект.ПолучитьОбъект();
			
			// заполнение нового реквизита "Направление деятельности"
			ДокОбъект.НаправлениеДеятельности = ?(ДокОбъект.ВидДокументаРасчета.Розница, Перечисления.НаправленияДеятельности.Розница, Перечисления.НаправленияДеятельности.Производство);	 
			
			// изменение вида документа расчета
			Если ДокОбъект.ВидОперацииМонтажа = Справочники.ВидыМонтажа.СервиснаяЗаявка Тогда
			//Если ДокОбъект.УДАЛИТЬ_ВидМонтажа = Справочники.ВидыМонтажа.СервиснаяЗаявка Тогда
			//	ДокОбъект.ВидДокументаРасчета = Справочники.ВидыДокументовРасчетаВыработки.СервиснаяЗаявка; 
				
				Комментарий = СтрШаблон("%1: вид документа основания изменен с %2 на Заказ-договор", СсылкаНаОбъект, ?(ЗначениеЗаполнено(ДокОбъект.ВидДокументаОснования), Строка(ДокОбъект.ВидДокументаОснования), ""));
				РегистрыСведений.ТехнологическийЖурнал.ЗаписатьСобытие("Изменение вида документа основания (УСВ)", Комментарий);
				
				//Если ДокОбъект.ВидДокументаОснования = Справочники.ВидыДокументовОснованийРасчетаВыработки.Лид Тогда
					ДокОбъект.ВидДокументаОснования = Справочники.ВидыДокументовОснованийРасчетаВыработки.ЗаказДоговор;	
				//КонецЕсли;				
				
			ИначеЕсли ДокОбъект.ВидОперацииМонтажа = Справочники.ВидыМонтажа.Рекламация Тогда
			//ИначеЕсли ДокОбъект.УДАЛИТЬ_ВидМонтажа = Справочники.ВидыМонтажа.Рекламация Тогда
			//	ДокОбъект.ВидДокументаРасчета = Справочники.ВидыЗаказДоговоров.Рекламация;
				
				Комментарий = СтрШаблон("%1: вид документа основания изменен с %2 на Заказ-договор", СсылкаНаОбъект, ?(ЗначениеЗаполнено(ДокОбъект.ВидДокументаОснования), Строка(ДокОбъект.ВидДокументаОснования), ""));
				РегистрыСведений.ТехнологическийЖурнал.ЗаписатьСобытие("Изменение вида документа основания (УСВ)", Комментарий);
				
				//Если ДокОбъект.ВидДокументаОснования = Справочники.ВидыДокументовОснованийРасчетаВыработки.Лид Тогда
					ДокОбъект.ВидДокументаОснования = Справочники.ВидыДокументовОснованийРасчетаВыработки.ЗаказДоговор;	
				//КонецЕсли;
				
			КонецЕсли;
			
			Попытка
				ДокОбъект.ОбменДанными.Загрузка = Истина;			
				ДокОбъект.ДополнительныеСвойства.Вставить("ПропуститьПроверкуЗапретаИзменения", Истина);
				ДокОбъект.Записать();
				
				РезультатОбработки.Успешно = Истина;				
			Исключение				
				РезультатОбработки.Успешно = Ложь;
				РезультатОбработки.ОписаниеОшибки = ОписаниеОшибки();
			КонецПопытки;
		КонецЕсли;

	КонецЕсли;
	
	Возврат РезультатОбработки;
	
КонецФункции

