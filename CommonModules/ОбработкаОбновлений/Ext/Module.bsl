	РезультатОбработки = Новый Структура;
	РезультатОбработки.Вставить("Успешно", Истина);
	РезультатОбработки.Вставить("ОписаниеОшибки", "");
	
	// №12232 всю номенклатуру с видом "Типовой отрез" помещаем в очередь, однако процедуры обработки этих объектов не делать, т.е. объекты висят всегда и убираются оттуда только вручную
	Если ТипЗнч(СсылкаНаОбъект) = Тип("СправочникСсылка.Номенклатура") Тогда
		
