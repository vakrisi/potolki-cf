	Если ОбработкаОбязательныхОбъектов Тогда
		Возврат Обработка_3_0_23_0_Обязательные(СсылкаНаОбъект, ВерсияПрограммыЧисло);
	КонецЕсли;
	
	РезультатОбработки = Новый Структура;
	РезультатОбработки.Вставить("Успешно", Ложь);
	РезультатОбработки.Вставить("ОписаниеОшибки", "");
		
	Если ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.Монтаж") Тогда
		// сверить выработку начисленную с расчетной
		РеквизитыМонтажа = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СсылкаНаОбъект, "ДатаВыполнения, ДатаЗакрытия, Результат, СозданПриИспользованииСтатусаЗакрыт, РучнаяКорректировкаВыработки");
		
		//++ отмененные / в работе не проверяем
		//++ скорректированные вручную после обновления не проверяем
		Если РеквизитыМонтажа.Результат = Справочники.РезультатыМонтажа.Отменен
			ИЛИ РеквизитыМонтажа.Результат = Справочники.РезультатыМонтажа.ВРаботе 
			ИЛИ РеквизитыМонтажа.РучнаяКорректировкаВыработки
			Тогда
			РезультатОбработки.Успешно = Истина;
			Возврат РезультатОбработки;
		КонецЕсли;
		//--
		
		ДатаРасчетаВыработки = РеквизитыМонтажа.ДатаВыполнения;
		Если (РеквизитыМонтажа.Результат = Справочники.РезультатыМонтажа.Закрыт И РеквизитыМонтажа.СозданПриИспользованииСтатусаЗакрыт) Тогда
			ДатаРасчетаВыработки = РеквизитыМонтажа.ДатаЗакрытия;
		КонецЕсли;

		СтруктураПроверки = ОбщийМодульСервер.ВыработкаРасчетнаяИНачисленнаяСовпадают(СсылкаНаОбъект, ДатаРасчетаВыработки);
		Если СтруктураПроверки.Результат Тогда
			РезультатОбработки.Успешно = Истина;
		Иначе
			РезультатОбработки.Успешно = Ложь;
			РезультатОбработки.ОписаниеОшибки = СтрШаблон("Выработка начисленная (%1) и расчетная (%2) не совпадают", СтруктураПроверки.СуммаНачисленная, СтруктураПроверки.СуммаРасчетная);
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.РеализацияТоваровИУслуг") Тогда
		
		РезультатОбработки.Успешно = Ложь;
		РезультатОбработки.ОписаниеОшибки = "Реализация на основании заказ-договора";
		
	КонецЕсли;
			
	Возврат РезультатОбработки;
	
