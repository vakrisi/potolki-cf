					Попытка
						СпрНоменОбъект.ОсновнаяСпецификация = Перечисления.ВидыСпецификации.ПустаяСсылка();
						СпрНоменОбъект.ОсновнаяСпецификацияКомплектация = СсылкаНаОбъект;
						СпрНоменОбъект.ОбменДанными.Загрузка = Истина;
						СпрНоменОбъект.Записать();
					Исключение
					КонецПопытки;
				КонецЕсли;
				
			КонецЕсли;
			
		ИначеЕсли ТаблицаВД.Количество() = 0 Тогда
			// спецификация не использовалась в документах
			
			//Если ВыборкаНоменклатуры.Следующий() Тогда
