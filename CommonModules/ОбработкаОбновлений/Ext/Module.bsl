#Область Обработка_2_8_25_0

Функция Обработка_2_8_25_0_Обязательные(СсылкаНаОбъект) Экспорт
	
	РезультатОбработки = Новый Структура;
	РезультатОбработки.Вставить("Успешно", Ложь);
	РезультатОбработки.Вставить("ОписаниеОшибки", "");
	
	//#13511 
	Если ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.ВводОстатков") Тогда
		ТипОперации = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СсылкаНаОбъект, "ТипОперации");
		
		ПоляСвертки = Новый Массив;
		ПоляСвертки.Добавить("УДАЛИТЬ_Организация");
		
		Если ТипОперации = Перечисления.ТипыОперацийВводаОстатков.БонусыКонтрагентов Тогда
			// ничего не делаем
			РезультатОбработки.Успешно = истина;
			
		ИначеЕсли ТипОперации = Перечисления.ТипыОперацийВводаОстатков.ВзаиморасчетыСКонтрагентами Тогда
			Документы.ВводОстатков.ОбработатьДокумент_Версия_2_8_25(РезультатОбработки, СсылкаНаОбъект, "ВзаиморасчетыСКонтрагентами", ПоляСвертки);
			
		ИначеЕсли ТипОперации = Перечисления.ТипыОперацийВводаОстатков.ВзаиморасчетыСКонтрагентамиВВалюте Тогда
			РезультатОбработки.Успешно = Ложь;
			РезультатОбработки.ОписаниеОшибки = "Требуется ручная обработка: возможно документ не нужен";
			
		ИначеЕсли ТипОперации = Перечисления.ТипыОперацийВводаОстатков.ДенежныеСредства Тогда
			ПоляСвертки.Добавить("УДАЛИТЬ_Валюта");
			Документы.ВводОстатков.ОбработатьДокумент_Версия_2_8_25(РезультатОбработки, СсылкаНаОбъект, "ДенежныеСредства", ПоляСвертки);
			
		ИначеЕсли ТипОперации = Перечисления.ТипыОперацийВводаОстатков.МатериалыВЭксплуатации Тогда			
			Документы.ВводОстатков.ОбработатьДокумент_Версия_2_8_25(РезультатОбработки, СсылкаНаОбъект, "МатериалыВЭксплуатации", ПоляСвертки);
			
		ИначеЕсли ТипОперации = Перечисления.ТипыОперацийВводаОстатков.РасчетыСПерсоналом Тогда
			Документы.ВводОстатков.ОбработатьДокумент_Версия_2_8_25(РезультатОбработки, СсылкаНаОбъект, "РасчетыСПерсоналом", ПоляСвертки);	
			
		ИначеЕсли ТипОперации = Перечисления.ТипыОперацийВводаОстатков.РасчетыСПодотчетниками Тогда
			Документы.ВводОстатков.ОбработатьДокумент_Версия_2_8_25(РезультатОбработки, СсылкаНаОбъект, "РасчетыСПодотчетниками", ПоляСвертки);
			
		ИначеЕсли ТипОперации = Перечисления.ТипыОперацийВводаОстатков.ТоварыНаСкладах Тогда
			ПоляСвертки.Добавить("УДАЛИТЬ_Склад");
			Документы.ВводОстатков.ОбработатьДокумент_Версия_2_8_25(РезультатОбработки, СсылкаНаОбъект, "ТоварыНаСкладах", ПоляСвертки);
			
		КонецЕсли;
		
		// №13299 новый реквизит "СписыватьБонусы" в реализациях, нужно установить если установлена галочка СлужебныйУчитыватьБонусы
	ИначеЕсли ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.РеализацияТоваровИУслуг") Тогда
		
		ДокОбъект = СсылкаНаОбъект.ПолучитьОбъект();
		
		Если ДокОбъект.СлужебныйУчитыватьБонусы Тогда
			
			ДокОбъект.СписыватьБонусы = Истина;
			
			Попытка
				ДокОбъект.ОбменДанными.Загрузка = Истина;
				ДокОбъект.Записать(); // ТОЛЬКО ЗАПИСЬ
				РезультатОбработки.Успешно = Истина;
			Исключение
				РезультатОбработки.Успешно = Ложь;
				РезультатОбработки.ОписаниеОшибки = ОписаниеОшибки();
			КонецПопытки;
			
		Иначе
			
			// ничего не делаем
			РезультатОбработки.Успешно = Истина;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат РезультатОбработки;
	
КонецФункции

Функция Обработка_2_8_25_0(СсылкаНаОбъект, ОбработкаОбязательныхОбъектов) Экспорт
	
	Если ОбработкаОбязательныхОбъектов Тогда
		Возврат Обработка_2_8_25_0_Обязательные(СсылкаНаОбъект);
	КонецЕсли;
	
	РезультатОбработки = Новый Структура;
	РезультатОбработки.Вставить("Успешно", Ложь);
	РезультатОбработки.Вставить("ОписаниеОшибки", "");
	
