Функция Обработка_3_0_0_0_Обязательные(СсылкаНаОбъект) Экспорт
	
	РезультатОбработки = Новый Структура;
	РезультатОбработки.Вставить("Успешно", Ложь);
	РезультатОбработки.Вставить("ОписаниеОшибки", "");
	
	// №13930 в документе "Ввод остатков" для операций "Товары на складах" и "Материалы в эксплуатации" добавлена колонка "Цена"
	Если ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.ВводОстатков") Тогда
		
		ДокументОбъект = СсылкаНаОбъект.ПолучитьОбъект();
		
		Для Каждого ТекущаяСтрока Из ДокументОбъект.ТоварыНаСкладах Цикл
			ТекущаяСтрока.Цена = ?(ТекущаяСтрока.Количество = 0, ТекущаяСтрока.Сумма, ТекущаяСтрока.Сумма / ТекущаяСтрока.Количество)
		КонецЦикла;
		
		Для Каждого ТекущаяСтрока Из ДокументОбъект.МатериалыВЭксплуатации Цикл
			ТекущаяСтрока.Цена = ?(ТекущаяСтрока.Количество = 0, ТекущаяСтрока.Сумма, ТекущаяСтрока.Сумма / ТекущаяСтрока.Количество)
		КонецЦикла;
		
		Попытка
			
			ДокументОбъект.Записать(); // только запись, т.к. движения не трогаем
			РезультатОбработки.Успешно = Истина;
			
		Исключение
			
			РезультатОбработки.Успешно = Ложь;
			РезультатОбработки.ОписаниеОшибки = ОписаниеОшибки();
			
		КонецПопытки;
		
	ИначеЕсли ТипЗнч(СсылкаНаОбъект) = Тип("СправочникСсылка.УчетныеЗаписиЭлектроннойПочты") Тогда
		//++ #13943 для заполнения нового реквизита ОтветственныйМенеджер
		
		СпрОбъект = СсылкаНаОбъект.ПолучитьОбъект();
		МенеджерСсылка = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СпрОбъект.УДАЛИТЬ_ОтветственныйПользователь, "Сотрудник");
		Если ЗначениеЗаполнено(МенеджерСсылка) Тогда
			СпрОбъект.УДАЛИТЬ_ОтветственныйМенеджер = МенеджерСсылка;
			Попытка			
				СпрОбъект.Записать();
				РезультатОбработки.Успешно = Истина;
			Исключение
				РезультатОбработки.Успешно = Ложь;
				РезультатОбработки.ОписаниеОшибки = ОписаниеОшибки();
			КонецПопытки;
		Иначе
			РезультатОбработки.Успешно = Истина;
			РезультатОбработки.ОписаниеОшибки = "";
		КонецЕсли;
		
		// №14311 Для всех пользовательских номенклатур, с видом "Материал заказчика" поставить вид = "Товары и материалы" и "Материал заказчика" = ИСТИНА
	ИначеЕсли ТипЗнч(СсылкаНаОбъект) = Тип("СправочникСсылка.Номенклатура")
		И СсылкаНаОбъект.ВидНоменклатуры = Справочники.ВидыНоменклатуры.УДАЛИТЬ_МатериалЗаказчика
		Тогда
		
		НоменклатураОбъект = СсылкаНаОбъект.ПолучитьОбъект();
		
		НоменклатураОбъект.ВидНоменклатуры = Справочники.ВидыНоменклатуры.Материал;
		НоменклатураОбъект.МатериалЗаказчика = Истина;
		
		НоменклатураОбъект.ОбменДанными.Загрузка = Истина;
		
		Попытка
			
			НоменклатураОбъект.Записать();
			РезультатОбработки.Успешно = Истина;
			
		Исключение
			
			РезультатОбработки.Успешно = Ложь;
			РезультатОбработки.ОписаниеОшибки = ОписаниеОшибки();
			
		КонецПопытки;
		
		// После всех преобразований и проверки что на вид номенклатуры "УДАЛИТЬ_МатериалЗаказчика" более нет ссылок нигде, полностью удалить элемент из базы
		МассивСсылок = новый Массив;
		МассивСсылок.Добавить(Справочники.ВидыНоменклатуры.УДАЛИТЬ_МатериалЗаказчика);
		
		ТаблицаСсылок = НайтиПоСсылкам(МассивСсылок);
		
		Если ТаблицаСсылок.Количество() = 0 Тогда
			ВидНоменклатурыОбъект = Справочники.ВидыНоменклатуры.УДАЛИТЬ_МатериалЗаказчика.ПолучитьОбъект();
			ВидНоменклатурыОбъект.ИмяПредопределенныхДанных = "";
			ВидНоменклатурыОбъект.Записать();
			ВидНоменклатурыОбъект.Удалить();
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат РезультатОбработки;
	
КонецФункции

