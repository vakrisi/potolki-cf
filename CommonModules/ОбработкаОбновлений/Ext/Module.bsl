					Продолжить;
				КонецЕсли;
				
				Если СтрокаТЧ.Данные.Проведен Тогда
					ДокОбъект = СтрокаТЧ.Данные.ПолучитьОбъект();
					ДокОбъект.ДополнительныеСвойства.Вставить("ПропуститьПроверкуЗапретаИзменения", Истина);
					
