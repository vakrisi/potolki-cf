		ДокОбъект = СсылкаНаОбъект.ПолучитьОбъект();
		Если НЕ ЗначениеЗаполнено(ДокОбъект.ОжидаемаяДатаОтгрузки) И ЗначениеЗаполнено(ДокОбъект.УДАЛИТЬ_ПредполагаемыйМонтажДата) Тогда
			ДокОбъект.ОжидаемаяДатаОтгрузки = ДокОбъект.УДАЛИТЬ_ПредполагаемыйМонтажДата;
		//КонецЕсли;
		//Если НЕ ЗначениеЗаполнено(ДокОбъект.ОжидаемоеВремяОтгрузки) И ЗначениеЗаполнено(ДокОбъект.УДАЛИТЬ_ПредполагаемыйМонтажВремя) Тогда
			ДокОбъект.ОжидаемоеВремяОтгрузки = ДокОбъект.УДАЛИТЬ_ПредполагаемыйМонтажВремя;
		КонецЕсли;
		Попытка
			ДокОбъект.ДополнительныеСвойства.Вставить("ПропуститьПроверкуЗапретаИзменения", Истина);
			ДокОбъект.ОбменДанными.Загрузка = Истина;
			ДокОбъект.Записать();
			РезультатОбработки.Успешно = Истина;
		Исключение
			РезультатОбработки.Успешно = Ложь;
			РезультатОбработки.ОписаниеОшибки = ОписаниеОшибки();
		КонецПопытки;	
		
	//#15994	
	ИначеЕсли ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.НачислениеЗарплаты") Тогда	
		
		ДокОбъект = СсылкаНаОбъект.ПолучитьОбъект();
		
		ВалютаУчета = Константы.ВалютаУчета.Получить();
		ВалютаОдинаковая = Истина;
		
		СуммаДокумента = 0;
		Для каждого Строка Из ДокОбъект.Начисление Цикл
			СуммаДокумента = СуммаДокумента + Строка.Сумма;  
			Если НЕ ВалютаУчета = Строка.Валюта Тогда
				ВалютаОдинаковая = Ложь;
				Прервать;
			КонецЕсли;		
		КонецЦикла;
		
		Если ВалютаОдинаковая Тогда
			ДокОбъект.СуммаДокумента = СуммаДокумента;
			ДокОбъект.Валюта = ВалютаУчета;
			Попытка
				ДокОбъект.ДополнительныеСвойства.Вставить("ПропуститьПроверкуЗапретаИзменения", Истина);
				ДокОбъект.ОбменДанными.Загрузка = Истина;
				ДокОбъект.Записать();
				РезультатОбработки.Успешно = Истина;
			Исключение
				РезультатОбработки.Успешно = Ложь;
				РезультатОбработки.ОписаниеОшибки = ОписаниеОшибки();
			КонецПопытки;		
		Иначе
			РезультатОбработки.Успешно = Ложь;
			РезультатОбработки.ОписаниеОшибки = "Валюта в строках документа отличается от валюты учета";
		КонецЕсли;		
		
	Иначе
		РезультатОбработки.Успешно = Истина;
	КонецЕсли;	
	
	Возврат РезультатОбработки;
	
