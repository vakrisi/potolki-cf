			РезультатОбработки.Успешно = Ложь;
			РезультатОбработки.ОписаниеОшибки = ОписаниеОшибки();
		КонецПопытки;
		
		
		//#7806 заполняем новый реквизит и создаем новую установку, если не удалось при обнвлении
	ИначеЕсли ТипЗнч(СсылкаНаОбъект) = Тип("СправочникСсылка.ЦеныУслугРаскроя") Тогда
		
