		СпрОбъект = СсылкаНаОбъект.ПолучитьОБъект();
		СпрОбъект.ВидНоменклатуры = Справочники.ВидыНоменклатуры.Отрез;
		
		СпрОбъект.Наименование = ОбменСEasyCeiling.ПолучитьНаименованиеОтреза(СпрОбъект.Потолок_НомерРасчета, 
		СпрОбъект.Потолок_Фактура[0].ПродукцияЦвет, 
		СпрОбъект.Потолок_Фактура[0].ПродукцияФактура, 
		СпрОбъект.Потолок_КоличествоПродукция);
		СпрОбъект.НаименованиеДляПечати = СпрОбъект.Наименование;
		
		МассивСсылок = новый Массив;
		МассивСсылок.Добавить(СсылкаНаОбъект);
		
		ТаблицаСсылок = НайтиПоСсылкам(МассивСсылок);
		
		НачатьТранзакцию();
		
		Отказ = Ложь;
		
		Попытка
			СпрОбъект.Записать();
		Исключение
			РезультатОбработки.Успешно = Ложь;
			РезультатОбработки.ОписаниеОшибки = ОписаниеОшибки();
			
			Отказ = Истина;
			ОтменитьТранзакцию();
		КонецПопытки;		
		
		Для каждого СтрокаТЧ из ТаблицаСсылок Цикл
			Если Отказ Тогда
				Прервать;
			КонецЕсли;
			Если ОбщегоНазначения.ЭтоДокумент(СтрокаТЧ.Метаданные) Тогда
				Если ТипЗнч(СтрокаТЧ.Данные) = Тип("ДокументСсылка.ЗаказНаПроизводство")
