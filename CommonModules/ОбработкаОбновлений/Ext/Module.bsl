		|	И Монтаж.ПометкаУдаления";
		Запрос.УстановитьПараметр("Основание",СсылкаДокумент);
		
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			МонтажОбъект = Выборка.Ссылка.ПолучитьОбъект();
			//товары монтажа
			Для Каждого ТекущаяСтрока Из МонтажОбъект.ТоварыУслуги Цикл
				Если ПустаяСтрока(ТекущаяСтрока.УИСтроки) Тогда
					
					Отбор = Новый Структура;
					Отбор.Вставить("Комната",ТекущаяСтрока.Комната);
					Отбор.Вставить("Номенклатура",ТекущаяСтрока.Номенклатура);
					Отбор.Вставить("ХарактеристикаНоменклатуры",ТекущаяСтрока.ХарактеристикаНоменклатуры);
					
					Отбор.Вставить("Количество",ТекущаяСтрока.Количество);
					Отбор.Вставить("Коэффициент",ТекущаяСтрока.Коэффициент);
					Отбор.Вставить("Цена",ТекущаяСтрока.Цена);
					Отбор.Вставить("ПроцентСкидки",ТекущаяСтрока.ПроцентСкидки);
					Отбор.Вставить("СуммаСкидки",ТекущаяСтрока.СуммаСкидки);
					Отбор.Вставить("Сумма",ТекущаяСтрока.Сумма);
					Отбор.Вставить("ЕдиницаИзмерения",ТекущаяСтрока.ЕдиницаИзмерения);
					
					Отбор.Вставить("Использован",Ложь);
					
					НайденныеСтроки = ТаблицаТоваровЗД.НайтиСтроки(Отбор);
					Если НайденныеСтроки.Количество() > 0 Тогда
						ТекущаяСтрока.УИСтроки = НайденныеСтроки[0].УИСтроки;
						НайденныеСтроки[0].Использован = Истина;
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
			
			//материалы монтажа
			Для Каждого ТекущаяСтрока Из МонтажОбъект.Материалы Цикл
				Если ПустаяСтрока(ТекущаяСтрока.УИСтроки) Тогда
					Отбор = Новый Структура;
					Отбор.Вставить("Использован",Ложь);
					Отбор.Вставить("Комната",ТекущаяСтрока.Комната);
					Отбор.Вставить("Номенклатура",ТекущаяСтрока.Номенклатура);
					Отбор.Вставить("ХарактеристикаНоменклатуры",ТекущаяСтрока.ХарактеристикаНоменклатуры);
					НайденныеСтроки = ТаблицаМатериаловЗД.НайтиСтроки(Отбор);
					Если НайденныеСтроки.Количество() > 0 Тогда
						ТекущаяСтрока.УИСтроки = НайденныеСтроки[0].УИСтроки;
						НайденныеСтроки[0].Использован = Истина;
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
			
			//обработали монтаж, записываем
			МонтажОбъект.Записать();
		КонецЦикла;
		
		ЗафиксироватьТранзакцию();
		РезультатОбработки.Успешно = Истина;
		
	Исключение
		ОтменитьТранзакцию();
		РезультатОбработки.Успешно = Ложь;
		РезультатОбработки.ОписаниеОшибки = "При переводе на версию 2.0 вышли ошибки: " + ОписаниеОшибки();
	КонецПопытки;
	
	Возврат РезультатОбработки;
	
КонецФункции

Функция ПеренестиАвтоматическиеСкидкиПослеОбновленияНа20(СсылкаДокумент) Экспорт
	
	РезультатОбработки = Новый Структура;
	РезультатОбработки.Вставить("Успешно", Истина);
	РезультатОбработки.Вставить("ОписаниеОшибки", "");
	
	ДокОбъект = СсылкаДокумент.ПолучитьОбъект();
	Для Каждого ТекущаяСтрока Из ДокОбъект.ТоварыУслуги Цикл
		ТекущаяСтрока.ПроцентСкидки = ТекущаяСтрока.ПроцентСкидки + ТекущаяСтрока.УДАЛИТЬ_ПроцентАвтоматическойСкидки;
		ТекущаяСтрока.СуммаСкидки = ТекущаяСтрока.СуммаСкидки + ТекущаяСтрока.УДАЛИТЬ_ПроцентАвтоматическойСкидки;
		ТекущаяСтрока.УДАЛИТЬ_ПроцентАвтоматическойСкидки = 0;
		ТекущаяСтрока.УДАЛИТЬ_ПроцентАвтоматическойСкидки = 0;
	КонецЦикла;
	
	Попытка
		ДокОбъект.Записать();
	Исключение
		РезультатОбработки.Успешно = Ложь;
		РезультатОбработки.ОписаниеОшибки = "Ошибка при записи после переноса автоматических скидок: " + ОписаниеОшибки();
	КонецПопытки;
	
	Возврат РезультатОбработки;
	
КонецФункции

Функция ЗаказДоговорМожноПеревестиВВерсию20(СсылкаДокумент) Экспорт
	
	МожноПереводитьВ20 = Истина;
	Причина = "";
	
	ЕстьПустыеКомнатыВЗД = Ложь;
	Для Каждого ТекСтрока Из СсылкаДокумент.ТоварыУслуги Цикл
		Если ПустаяСтрока(ТекСтрока.Комната) Тогда
			ЕстьПустыеКомнатыВЗД = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если НЕ ЕстьПустыеКомнатыВЗД Тогда
		Для Каждого ТекСтрока Из СсылкаДокумент.Материалы Цикл
			Если ПустаяСтрока(ТекСтрока.Комната) Тогда
				ЕстьПустыеКомнатыВЗД = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Если ЕстьПустыеКомнатыВЗД Тогда
		МожноПереводитьВ20 = Ложь;
		Причина = "В заказ-договоре есть пустые комнаты";
	КонецЕсли;
	
	Если МожноПереводитьВ20 Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	МонтажТоварыУслуги.Ссылка КАК Ссылка,
		|	МонтажТоварыУслуги.Комната КАК Комната,
		|	МонтажТоварыУслуги.Номенклатура КАК Номенклатура,
		|	МонтажТоварыУслуги.Количество КАК Количество,
		|	МонтажТоварыУслуги.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
		|	МонтажТоварыУслуги.Коэффициент КАК Коэффициент,
		|	МонтажТоварыУслуги.Цена КАК Цена,
		|	МонтажТоварыУслуги.ПроцентСкидки КАК ПроцентСкидки,
		|	МонтажТоварыУслуги.СуммаСкидки КАК СуммаСкидки,
		|	МонтажТоварыУслуги.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
		|	МонтажТоварыУслуги.Сумма КАК Сумма,
		|	МонтажТоварыУслуги.УИСтроки КАК УИСтроки
		|ИЗ
		|	Документ.Монтаж.ТоварыУслуги КАК МонтажТоварыУслуги
		|ГДЕ
		|	НЕ МонтажТоварыУслуги.Ссылка.ПометкаУдаления
		|	И МонтажТоварыУслуги.Ссылка.Основание = &Основание";
		Запрос.УстановитьПараметр("Основание", СсылкаДокумент); 
		ТоварыМонтажей = Запрос.Выполнить().Выгрузить();
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	МонтажТоварыУслуги.Ссылка КАК Ссылка,
		|	МонтажТоварыУслуги.Комната КАК Комната,
		|	МонтажТоварыУслуги.Номенклатура КАК Номенклатура,
		|	МонтажТоварыУслуги.Количество КАК Количество,
		|	МонтажТоварыУслуги.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
		|	МонтажТоварыУслуги.Коэффициент КАК Коэффициент,
		|	МонтажТоварыУслуги.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
		|	МонтажТоварыУслуги.УИСтроки КАК УИСтроки
		|ИЗ
		|	Документ.Монтаж.Материалы КАК МонтажТоварыУслуги
		|ГДЕ
		|	НЕ МонтажТоварыУслуги.Ссылка.ПометкаУдаления
		|	И МонтажТоварыУслуги.Ссылка.Основание = &Основание";
		Запрос.УстановитьПараметр("Основание", СсылкаДокумент); 
		МатериалыМонтажей = Запрос.Выполнить().Выгрузить();
		
		Если ТоварыМонтажей.Количество() = 0 Тогда
			//монтажей нет. можно переводить в 2.0, проверки не нужны
			МожноПереводитьВ20 = Истина;
		ИначеЕсли ТоварыМонтажей.Количество() > СсылкаДокумент.ТоварыУслуги.Количество() Тогда
			//в монтажах позиций по товарам больше чем в ЗД, переводить в 2.0 нельзя
			МожноПереводитьВ20 = Ложь;
			Причина = "Количество позиций в монтажах больше, чем в заказ-договоре";
		Иначе
			//в монтажах такое же количество позиций или меньше чем в ЗД, нужно проверять
			ЕстьПустыеКомнатыВМонтажах = Ложь;
			Для Каждого ТекСтрока Из ТоварыМонтажей Цикл
				Если ПустаяСтрока(ТекСтрока.Комната) Тогда
					ЕстьПустыеКомнатыВМонтажах = Истина;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			Если НЕ ЕстьПустыеКомнатыВМонтажах Тогда
				Для Каждого ТекСтрока Из МатериалыМонтажей Цикл
					Если ПустаяСтрока(ТекСтрока.Комната) Тогда
						ЕстьПустыеКомнатыВМонтажах = Истина;
						Прервать;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
			Если ЕстьПустыеКомнатыВМонтажах Тогда
				МожноПереводитьВ20 = Ложь;
				Причина = "В монтажах есть пустые комнаты в товарах или материалах";
			Иначе
				//проверяем что в монтажах нет позиций, которые отсутствуют в ЗД (по комнате и номенклатуре)
				Для Каждого ТекСтрока Из ТоварыМонтажей Цикл
					Отбор = Новый Структура;
					Отбор.Вставить("Комната", ТекСтрока.Комната);
					Отбор.Вставить("Номенклатура", ТекСтрока.Номенклатура);
					Отбор.Вставить("ХарактеристикаНоменклатуры", ТекСтрока.ХарактеристикаНоменклатуры);
					НайденныеСтроки = СсылкаДокумент.ТоварыУслуги.НайтиСтроки(Отбор);
					Если НайденныеСтроки.Количество() = 0 Тогда
						//такой строки нет в ЗД
						МожноПереводитьВ20 = Ложь;
						Причина = "В монтажах есть строки, которые отсутствуют в заказ-договоре";
						Прервать;
					КонецЕсли;
				КонецЦикла;
				
				Если МожноПереводитьВ20 Тогда
					//дошли до того, что в монтажах столько же или меньше строк чем в ЗД и нет позиций, которых нет в ЗД
					//проверяем что все строки, что есть в монтажах полностью соответствуют строкам ЗД (по всем колонкам)
					//если хоть одна строка по одному из значений отличается - переводить в 2.0 нельзя
					
					ЗапросЗД = Новый Запрос;
					ЗапросЗД.Текст = 
					"ВЫБРАТЬ
					|	ЗаказДоговорТоварыУслуги.Ссылка КАК Ссылка,
					|	ЗаказДоговорТоварыУслуги.Комната КАК Комната,
					|	ЗаказДоговорТоварыУслуги.Номенклатура КАК Номенклатура,
					|	ЗаказДоговорТоварыУслуги.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
					|	ЗаказДоговорТоварыУслуги.Количество КАК Количество,
					|	ЗаказДоговорТоварыУслуги.Коэффициент КАК Коэффициент,
					|	ЗаказДоговорТоварыУслуги.Цена КАК Цена,
					|	ЗаказДоговорТоварыУслуги.ПроцентСкидки КАК ПроцентСкидки,
					|	ЗаказДоговорТоварыУслуги.СуммаСкидки КАК СуммаСкидки,
					|	ЗаказДоговорТоварыУслуги.Сумма КАК Сумма,
					|	ЗаказДоговорТоварыУслуги.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
					|	ЗаказДоговорТоварыУслуги.УИСтроки КАК УИСтроки
					|ИЗ
					|	Документ.ЗаказДоговор.ТоварыУслуги КАК ЗаказДоговорТоварыУслуги
					|ГДЕ
					|	ЗаказДоговорТоварыУслуги.Ссылка = &Ссылка";
					ЗапросЗД.УстановитьПараметр("Ссылка",СсылкаДокумент);
					ТоварыЗД = ЗапросЗД.Выполнить().Выгрузить();
					ТоварыЗД.Колонки.Добавить("Разобран",Новый ОписаниеТипов("булево"));
					
					Для Каждого ТекСтрока Из ТоварыМонтажей Цикл
						
						Отбор = Новый Структура;
						Отбор.Вставить("Комната",ТекСтрока.Комната);
						Отбор.Вставить("Номенклатура",ТекСтрока.Номенклатура);
						Отбор.Вставить("ХарактеристикаНоменклатуры",ТекСтрока.ХарактеристикаНоменклатуры);
						Отбор.Вставить("УИСтроки",ТекСтрока.УИСтроки);
						
						Отбор.Вставить("Количество",ТекСтрока.Количество);
						Отбор.Вставить("Коэффициент",ТекСтрока.Коэффициент);
						Отбор.Вставить("Цена",ТекСтрока.Цена);
						Отбор.Вставить("ПроцентСкидки",ТекСтрока.ПроцентСкидки);
						Отбор.Вставить("СуммаСкидки",ТекСтрока.СуммаСкидки);
						Отбор.Вставить("Сумма",ТекСтрока.Сумма);
						Отбор.Вставить("ЕдиницаИзмерения",ТекСтрока.ЕдиницаИзмерения);
						
						Отбор.Вставить("Разобран",Ложь);
						
						
						НайденныеСтроки = ТоварыЗД.НайтиСтроки(Отбор);
						Если НайденныеСтроки.Количество() = 0 Тогда
							//такой строки нет в ЗД (что-то по параметрам не сходится), кидаем в отказ в переводе на 2.0
							МожноПереводитьВ20 = Ложь;
							Причина = "Не все строки монтажей полностью соответствуют заказ-договору";
							Прервать;
						Иначе
							//строку нашли, отметим что ее уже разобрали
							НайденныеСтроки[0].Разобран = Истина;
						КонецЕсли;
					КонецЦикла; 
				КонецЕсли;
				
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	СтруктураОтвета = Новый Структура;
	СтруктураОтвета.Вставить("МожноПереводитьВ20",МожноПереводитьВ20);
	СтруктураОтвета.Вставить("Причина",Причина);
	
	Возврат СтруктураОтвета;
	
КонецФункции

Процедура ЗаполнитьНомераПотолковВЗП(ДокОбъект) Экспорт
	
	//заполним номера потолков
	ТаблицаНомеров = Новый ТаблицаЗначений;
	ТаблицаНомеров.Колонки.Добавить("Номер");
	
	Для Каждого ВерхняяСтрока Из ДокОбъект.Товары Цикл
		НомерПотолка = ВерхняяСтрока.Номенклатура.Потолок_НомерРасчета;
		Если НЕ ПустаяСтрока(ВерхняяСтрока.Номенклатура.Потолок_ИндексПотолка) Тогда
			НомерПотолка = ВерхняяСтрока.Номенклатура.Потолок_ИндексПотолка+"-"+НомерПотолка;
		КонецЕсли;
		Если НЕ ПустаяСтрока(НомерПотолка) Тогда
			НоваяСтрока = ТаблицаНомеров.Добавить();
			НоваяСтрока.Номер = НомерПотолка;
		КонецЕсли;
	КонецЦикла;
	
	ТаблицаНомеров.Свернуть("Номер");
	ДокОбъект.НомераПотолков = "";
	Ном = 0;
	Для Каждого СтрокаНомер Из ТаблицаНомеров Цикл
		Если Ном > 0 Тогда
			ДокОбъект.НомераПотолков = ДокОбъект.НомераПотолков + "; ";
		КонецЕсли;
		ДокОбъект.НомераПотолков = ДокОбъект.НомераПотолков + СтрокаНомер.Номер;
		Ном = Ном + 1;
	КонецЦикла;
	
КонецПроцедуры

