		КонецПопытки;
	КонецЕсли;
	
	// №6377 всем ранее созданным контрагентам проставить "Дата создания" = дата первого документа в базе по контрагенту (любой документ).
	//	Всем контрагентам, у которых нет ни одного документа, ставить дату = текущая дата.
	Если ТипЗнч(СсылкаНаОбъект) = Тип("СправочникСсылка.Контрагенты") Тогда
		
