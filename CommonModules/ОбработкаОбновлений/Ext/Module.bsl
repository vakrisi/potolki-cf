			РезультатОбработки.ОписаниеОшибки = ОписаниеОшибки();
		КонецПопытки;
		
		//-- №6629
		
		//++ №10184 по документу Лид предварительный расчет выведен в отдельный документ:
	ИначеЕсли ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.Лид") Тогда
		
		ДокОбъект = СсылкаНаОбъект.ПолучитьОбъект();
		
		Если ДокОбъект.УДАЛИТЬ_ТоварыУслуги.Количество() = 0 И ДокОбъект.УДАЛИТЬ_Материалы.Количество() = 0 Тогда
			РезультатОбработки.Успешно = Истина;
			Возврат РезультатОбработки;
		КонецЕсли;
		
		НачатьТранзакцию();
		
		// Сначала попробуем найти существующий документ
		Запрос = новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ПредварительныйРасчет.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.ПредварительныйРасчетЗаказДоговора КАК ПредварительныйРасчет
		|ГДЕ
		|	ПредварительныйРасчет.Основание = &Лид
		|
		|УПОРЯДОЧИТЬ ПО
		|	ПредварительныйРасчет.Дата
		|";
		Запрос.УстановитьПараметр("Лид", ДокОбъект.Ссылка);
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Следующий() Тогда
			НовыйОбъект = Выборка.Ссылка.ПолучитьОбъект();
		Иначе
			НовыйОбъект = Документы.ПредварительныйРасчетЗаказДоговора.СоздатьДокумент();
		КонецЕсли;
		
		НовыйОбъект.ТоварыУслуги.Очистить();
		НовыйОбъект.Материалы.Очистить();
		
		// Шапочные реквизиты
		НовыйОбъект.Дата = ДокОбъект.Дата;
		НовыйОбъект.Основание = ДокОбъект.Ссылка;
		НовыйОбъект.Валюта = ДокОбъект.УДАЛИТЬ_Валюта;
		НовыйОбъект.ВидСкидки = ДокОбъект.УДАЛИТЬ_ВидСкидки;
		НовыйОбъект.ВидЦен = ДокОбъект.УДАЛИТЬ_ВидЦен;
		НовыйОбъект.Организация = ДокОбъект.Организация;
		//НовыйОбъект.Ответственный = ДокОбъект.Ответственный;
		НовыйОбъект.СуммаДокумента = ДокОбъект.УДАЛИТЬ_СуммаДокумента;
		НовыйОбъект.СуммаДокументаПоПрайсу = ДокОбъект.УДАЛИТЬ_СуммаДокументаПоПрайсу;
		НовыйОбъект.Комментарий = "#Создан при обновлении на 2.7.0.0 по " + ДокОбъект.Ссылка + "#";
		
		// Товары Услуги
		Для Каждого ТекущаяСтрока Из ДокОбъект.УДАЛИТЬ_ТоварыУслуги Цикл
			НоваяСтрока = НовыйОбъект.ТоварыУслуги.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущаяСтрока);
		КонецЦикла;
		
		// Материалы
		Для Каждого ТекущаяСтрока Из ДокОбъект.УДАЛИТЬ_Материалы Цикл
			НоваяСтрока = НовыйОбъект.Материалы.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущаяСтрока);
		КонецЦикла;
		
		Попытка
			НовыйОбъект.Записать(РежимЗаписиДокумента.Проведение);
			РезультатОбработки.Успешно = Истина;
		Исключение
			ОтменитьТранзакцию();
			РезультатОбработки.Успешно = Ложь;
			РезультатОбработки.ОписаниеОшибки = ОписаниеОшибки();
		КонецПопытки;
		
		Если РезультатОбработки.Успешно Тогда
			
			ДокОбъект.ОсновнойПредварительныйРасчет = НовыйОбъект.Ссылка;
			ДокОбъект.УДАЛИТЬ_ТоварыУслуги.Очистить();
			ДокОбъект.УДАЛИТЬ_Материалы.Очистить();
			
			ДокОбъект.УДАЛИТЬ_Валюта = Справочники.Валюты.ПустаяСсылка();
			ДокОбъект.УДАЛИТЬ_ВидСкидки = Справочники.ВидыСкидок.ПустаяСсылка();
			ДокОбъект.УДАЛИТЬ_ВидЦен = Справочники.ВидыЦен.ПустаяСсылка();
			ДокОбъект.УДАЛИТЬ_СуммаДокумента = 0;
			ДокОбъект.УДАЛИТЬ_СуммаДокументаПоПрайсу = 0;
			
			Попытка
				ДокОбъект.Записать();
				РезультатОбработки.Успешно = Истина;
				ЗафиксироватьТранзакцию();
			Исключение
				ОтменитьТранзакцию();
				РезультатОбработки.Успешно = Ложь;
				РезультатОбработки.ОписаниеОшибки = "Не удалось установить основной предварительный расчет: " + ОписаниеОшибки();
			КонецПопытки;
			
		КонецЕсли;
		
		//-- №10184
		
		//++ №10663 документ "Заявка на доставку"
	ИначеЕсли ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.ЗаявкаНаДоставку") Тогда
		
		ДокОбъект = СсылкаНаОбъект.ПолучитьОбъект();
		
		// реквизит "Текущий статус" заменен тип (предыдущий реквизит помечен на удаление, создан новый)
		Если ДокОбъект.УДАЛИТЬ_ТекущийСтатус = Перечисления.УДАЛИТЬ_СтатусыДоставкиТовара.Заявка Тогда
			ДокОбъект.Результат = Справочники.СтатусыЗаявокНаДоставку.Заявка;
		ИначеЕсли ДокОбъект.УДАЛИТЬ_ТекущийСтатус = Перечисления.УДАЛИТЬ_СтатусыДоставкиТовара.ВПути Тогда
			ДокОбъект.Результат = Справочники.СтатусыЗаявокНаДоставку.Отправлено;
		ИначеЕсли ДокОбъект.УДАЛИТЬ_ТекущийСтатус = Перечисления.УДАЛИТЬ_СтатусыДоставкиТовара.Доставлено Тогда
			ДокОбъект.Результат = Справочники.СтатусыЗаявокНаДоставку.Доставлено;
		ИначеЕсли ДокОбъект.УДАЛИТЬ_ТекущийСтатус = Перечисления.УДАЛИТЬ_СтатусыДоставкиТовара.Отменен Тогда
			ДокОбъект.Результат = Справочники.СтатусыЗаявокНаДоставку.Отказ;
		Иначе
			ДокОбъект.Результат = Справочники.СтатусыЗаявокНаДоставку.Заявка;
		КонецЕсли;
		
		// реквизит "Основание" переделена на табличную часть
		Если НЕ ДокОбъект.УДАЛИТЬ_Основание = Неопределено И НЕ ДокОбъект.УДАЛИТЬ_Основание.Пустая() Тогда
			
			Если ДокОбъект.Основания.Найти(ДокОбъект.УДАЛИТЬ_Основание) = Неопределено Тогда
				НоваяСтрока = ДокОбъект.Основания.Добавить();
				НоваяСтрока.Основание = ДокОбъект.УДАЛИТЬ_Основание;
			КонецЕсли;
			
			Для Каждого ТекущаяСтрока Из ДокОбъект.Товары Цикл
				ТекущаяСтрока.Основание = ДокОбъект.УДАЛИТЬ_Основание;
			КонецЦикла;
			
		КонецЕсли;
		
		Попытка
			// Только запись, т.к. выбраны все документы
			ДокОбъект.Записать();
			РезультатОбработки.Успешно = Истина;
		Исключение
			РезультатОбработки.Успешно = Ложь;
			РезультатОбработки.ОписаниеОшибки = ОписаниеОшибки();
		КонецПопытки;
		
		//-- №10663
		
		//++ №10772 в регистре "ПродажиПоЗаказДоговорам" добавлена характеристика, фиксируем по документам "Заказ-договор" и "Монтаж"
	ИначеЕсли ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.ЗаказДоговор")
		ИЛИ ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.СоглашениеОРасторженииДоговора") Тогда
		
		НаборЗаписей = РегистрыНакопления.ПродажиПоЗаказДоговорам.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Регистратор.Установить(СсылкаНаОбъект);
		НаборЗаписей.Прочитать();
		
		ТаблицаЗаписей = НаборЗаписей.Выгрузить(); // Для результата
		
		Сч = 0;
		Для каждого СтрокаВДокументе из СсылкаНаОбъект.ТоварыУслуги Цикл
			
			// Строка движения должна совпадать строке в ТЧ Товары и услуги
			// Но, на всякий случай делаем проверку, вдруг разное количество строк, тогда ищем по номенклатуре и количество * коэффициент
			СтрокаСовпадает = Ложь;
			Если НЕ Сч > ТаблицаЗаписей.Количество() - 1 Тогда
				
				СтрокаВДвижении = ТаблицаЗаписей[Сч];
				
				Если СтрокаВДокументе.Номенклатура = СтрокаВДвижении.Номенклатура И (СтрокаВДокументе.Количество * СтрокаВДокументе.Коэффициент) = СтрокаВДвижении.Количество Тогда
					СтрокаСовпадает = Истина;
				КонецЕсли;
				
			КонецЕсли;
			
			Если СтрокаСовпадает Тогда
				ТаблицаЗаписей[Сч].ХарактеристикаНоменклатуры = СтрокаВДокументе.ХарактеристикаНоменклатуры;
			Иначе
				
				// не совпала строка, пробуем найти по ключам номенклатура и количество
				НайденнаяСтрока = ТаблицаЗаписей.НайтиСтроки(новый Структура("Номенклатура, Количество", СтрокаВДокументе.Номенклатура, СтрокаВДокументе.Количество * СтрокаВДокументе.Коэффициент));
				Если НайденнаяСтрока.Количество() > 0 Тогда
					
					НайденнаяСтрока[0].ХарактеристикаНоменклатуры = СтрокаВДокументе.ХарактеристикаНоменклатуры;
					
				КонецЕсли;
				
			КонецЕсли;
			
			Сч = Сч + 1;
			
		КонецЦикла;
		
		НаборЗаписей.Загрузить(ТаблицаЗаписей);
		
		Попытка
			НаборЗаписей.Записать();
			РезультатОбработки.Успешно = Истина;
		Исключение
			РезультатОбработки.Успешно = Ложь;
			РезультатОбработки.ОписаниеОшибки = ОписаниеОшибки();
		КонецПопытки;
		
		//-- №10772
		
	КонецЕсли;
	
	Возврат РезультатОбработки;
	
КонецФункции

#КонецОбласти

#Область Обработка_2_7_0_0

Функция Обработка_2_7_0_0(СсылкаНаОбъект, ОбработкаОбязательныхОбъектов) Экспорт
	
	Если ОбработкаОбязательныхОбъектов Тогда
		Возврат Обработка_2_7_0_0_Обязательные(СсылкаНаОбъект);
	КонецЕсли;
	
	РезультатОбработки = Новый Структура;
	РезультатОбработки.Вставить("Успешно", Ложь);
	РезультатОбработки.Вставить("ОписаниеОшибки", "");
	
	//ОбработаноУспешно1 = Ложь;
	//ОбработаноУспешно2 = Ложь;
	
	Если ТипЗнч(СсылкаНаОбъект) = Тип("СправочникСсылка.УчетныеЗаписиЭлектроннойПочты") Тогда
		СпрОбъект = СсылкаНаОбъект.ПолучитьОбъект();			
		СпрОбъект.ВремяОжидания = 30;
		
		Попытка
			СпрОбъект.Записать();
			РезультатОбработки.Успешно = Истина;
		Исключение			
			РезультатОбработки.Успешно = Ложь;
			РезультатОбработки.ОписаниеОшибки = ОписаниеОшибки();
			Возврат РезультатОбработки;
		КонецПопытки;
	КонецЕсли;
	
	//#10385
	Если ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.АвансовыйОтчет")
		ИЛИ ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.ВозвратТовараОтПокупателя")
		ИЛИ ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.ВозвратТовараПоставщику")
		ИЛИ ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.Замена")
		ИЛИ ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.Монтаж")
		ИЛИ ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.ОприходованиеТоваров") 
		ИЛИ ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.ПоступлениеТоваровИУслуг")
		ИЛИ ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.РеализацияТоваровИУслуг")
		ИЛИ ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.СоглашениеОРасторженииДоговора")
		ИЛИ ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.СписаниеТоваров")
		ИЛИ ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.ЧекККМ")
		Тогда
		
		ДокОбъект = СсылкаНаОбъект.ПолучитьОбъект();
		
		Если ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.РеализацияТоваровИУслуг") Тогда
			
			РезультатЗаполнения = ЗаполнитьСтатьиДиРВТабличныхЧастях(ДокОбъект, "Товары", "Услуги", "СтатьяДоходов");
			
		ИначеЕсли ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.АвансовыйОтчет")
			ИЛИ ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.ПоступлениеТоваровИУслуг") Тогда
			
			РезультатЗаполнения = ЗаполнитьСтатьиДиРВТабличныхЧастях(ДокОбъект, "Товары", "Услуги", "СтатьяРасходов");
			
		ИначеЕсли ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.ВозвратТовараПоставщику") 
			ИЛИ ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.ОприходованиеТоваров") Тогда
			
			РезультатЗаполнения = ЗаполнитьСтатьиДиРВТабличныхЧастях(ДокОбъект, "Товары", , "СтатьяДоходов");
			
		ИначеЕсли ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.ВозвратТовараОтПокупателя") 
			ИЛИ ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.СписаниеТоваров") Тогда
			
			РезультатЗаполнения = ЗаполнитьСтатьиДиРВТабличныхЧастях(ДокОбъект, "Товары", , "СтатьяРасходов");
			
		ИначеЕсли ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.Монтаж") 
			ИЛИ ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.СоглашениеОРасторженииДоговора") Тогда
			
			РезультатЗаполнения = ЗаполнитьСтатьиДиРВТабличныхЧастях(ДокОбъект, "ТоварыУслуги", , "СтатьяДоходов");
			
		ИначеЕсли ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.Замена") Тогда
			
			РезультатЗаполнения = ЗаполнитьСтатьиДиРВТабличныхЧастях(ДокОбъект, "ТаблицаВозврат", "ТаблицаВыдача");	
			
		ИначеЕсли ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.ЧекККМ") Тогда
			
			РезультатЗаполнения = ЗаполнитьСтатьиДиРВТабличныхЧастях(ДокОбъект, "Товары");	
			
		КонецЕсли;
		
		Если РезультатЗаполнения = "" Тогда
			Попытка
				ДокОбъект.Записать(); // записываем без перепроведения
				РезультатОбработки.Успешно = Истина;
				ОбработаноУспешно1 = Истина;
			Исключение			
				РезультатОбработки.Успешно = Ложь;
				РезультатОбработки.ОписаниеОшибки = ОписаниеОшибки();
				Возврат РезультатОбработки;
			КонецПопытки;
		Иначе
			РезультатОбработки.Успешно = Ложь;
			РезультатОбработки.ОписаниеОшибки = РезультатЗаполнения;
			Возврат РезультатОбработки;
		КонецЕсли;	
		
	ИначеЕсли ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.Лид") Тогда
		//#11332
		
		ДокОбъект = СсылкаНаОбъект.ПолучитьОбъект();
		Если ДокОбъект.ТекущийСтатус = Справочники.СтатусыЛида.УДАЛИТЬ_Рекламация 
			ИЛИ ДокОбъект.ТекущийСтатус = Справочники.СтатусыЛида.УДАЛИТЬ_Сервис Тогда
			
			ДокОбъект.ВидОбращения = ?(ДокОбъект.ТекущийСтатус = Справочники.СтатусыЛида.УДАЛИТЬ_Рекламация, Справочники.ВидыОбращенийЛида.Рекламация, Справочники.ВидыОбращенийЛида.СервиснаяЗаявка);
			ДокОбъект.РезультатОбращения = Справочники.РезультатыЛида.Закрыт;
			ДокОбъект.ДатаЗакрытияОбращения = ДокОбъект.Дата;
			
			ДокОбъект.ТекущийСтатус = Справочники.СтатусыЛида.Обращение;
			
			Попытка
				ДокОбъект.Записать(); // записываем без перепроведения
				РезультатОбработки.Успешно = Истина;
			Исключение			
				РезультатОбработки.Успешно = Ложь;
				РезультатОбработки.ОписаниеОшибки = ОписаниеОшибки();
				Возврат РезультатОбработки;
			КонецПопытки;
		КонецЕсли;
		
	КонецЕсли;
	
	//#10837
	Если ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.ПоступлениеТоваровИУслуг") Тогда
		Если ТипЗнч(СсылкаНаОбъект.Основание) = Тип("ДокументСсылка.РеализацияТоваровИУслуг")	
			ИЛИ ТипЗнч(СсылкаНаОбъект.Основание) = Тип("ДокументСсылка.ЗаказПокупателя") Тогда
			
			ДокОбъект = СсылкаНаОбъект.ПолучитьОбъект();
			ДокОбъект.АдресМонтажа = ДокОбъект.Основание.АдресМонтажа;
			
			Попытка
				ДокОбъект.Записать(); // записываем без перепроведения
				РезультатОбработки.Успешно = Истина;
				ОбработаноУспешно2 = Истина;
			Исключение			
				РезультатОбработки.Успешно = Ложь;
				РезультатОбработки.ОписаниеОшибки = ОписаниеОшибки();
				Возврат РезультатОбработки;
			КонецПопытки;
		Иначе
			ОбработаноУспешно2 = Истина;	
		КонецЕсли;
	КонецЕсли;
	
	// если встречаются такие же регистраторы как выше, то не включать в ИначеЕсли
	
	//Если ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.") Тогда
	
	//ИначеЕсли ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.") Тогда
	
	//КонецЕсли;
	
	Если ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.ПоступлениеТоваровИУслуг") Тогда
		РезультатОбработки.Успешно = ОбработаноУспешно1 И ОбработаноУспешно2;	
	КонецЕсли;
	
	Возврат РезультатОбработки;
	
КонецФункции

Функция ЗаполнитьСтатьиДиРВТабличныхЧастях(ДокОбъект, ИмяТЧ1, ИмяТЧ2="", ИмяРеквизитаСтатья="")
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("СсылкаНаОбъект", ДокОбъект.Ссылка);
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ДоходыРасходы.Регистратор КАК Ссылка,
	|	ДоходыРасходы.Статья КАК Статья,
	|	ДоходыРасходы.СуммаДоходов КАК СуммаДоходов,
	|	ДоходыРасходы.СуммаРасходов КАК СуммаРасходов,
	|	ВЫБОР
	|		КОГДА ДоходыРасходы.СуммаДоходов <> 0
	|			ТОГДА ДоходыРасходы.СуммаДоходов
	|		ИНАЧЕ ДоходыРасходы.СуммаРасходов
	|	КОНЕЦ КАК Сумма
	|ИЗ
	|	РегистрНакопления.ДоходыРасходы КАК ДоходыРасходы
	|ГДЕ
	|	ДоходыРасходы.Регистратор = &СсылкаНаОбъект
	|	И ДоходыРасходы.Метод = ЗНАЧЕНИЕ(Перечисление.МетодыВеденияУчетаДоходовРасходов.Некассовый)
	|	И (ДоходыРасходы.СуммаДоходов <> 0
	|				И ДоходыРасходы.Регистратор.СтатьяДоходов <> ДоходыРасходы.Статья
	|			ИЛИ ДоходыРасходы.СуммаРасходов <> 0
	|				И ДоходыРасходы.Регистратор.СтатьяРасходов <> ДоходыРасходы.Статья)";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл 
		
		//++ №11687 в ТЧ документа списание товаров нет колонки "Сумма", ищем по статье в номенклатуре
		Если ТипЗнч(Выборка.Ссылка) = Тип("ДокументСсылка.СписаниеТоваров") Тогда
			НайденныеПозиции1 = ДокОбъект[ИмяТЧ1];
		Иначе
			//-- №11687
			СтруктураПоиска = Новый Структура("Сумма", Выборка.Сумма);
			НайденныеПозиции1 = ДокОбъект[ИмяТЧ1].НайтиСтроки(СтруктураПоиска);
		КонецЕсли;
		
		Если ИмяТЧ2="" ТОгда
			НайденныеПозиции2 = Новый Массив; // заглушка
		Иначе
			НайденныеПозиции2 = ДокОбъект[ИмяТЧ2].НайтиСтроки(СтруктураПоиска);
		КонецЕсли;
		
		Если ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.Замена") Тогда
			Если Выборка.СуммаДоходов <> 0 И НайденныеПозиции1.Количество() = 1 Тогда
				НайденныеПозиции1[0].СтатьяДоходов = Выборка.Статья;
				
			ИначеЕсли Выборка.СуммаРасходов <> 0 И НайденныеПозиции2.Количество() = 1 Тогда
				НайденныеПозиции1[0].СтатьяРасходов = Выборка.Статья;
				
			Иначе
				Возврат "Требуется ручное заполнение статей в табличных частях документа";	
			КонецЕсли;
			
		ИначеЕсли ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.ЧекККМ") Тогда
			Если ДокОбъект.ВидОперации = Перечисления.ВидыОперацийЧекККМ.Продажа Тогда
				Если НайденныеПозиции1.Количество() = 1 Тогда
					НайденныеПозиции1[0].СтатьяДоходов = Выборка.Статья;
				Иначе
					Возврат "Требуется ручное заполнение статей в табличных частях документа";
				КонецЕсли;
			Иначе // возврат
				Если НайденныеПозиции1.Количество() = 1 Тогда
					НайденныеПозиции1[0].СтатьяРасходов = Выборка.Статья;
				Иначе
					Возврат "Требуется ручное заполнение статей в табличных частях документа";
				КонецЕсли;
				
			КонецЕсли;
			
		Иначе
			Если НайденныеПозиции1.Количество() = 1 И НайденныеПозиции2.Количество() = 0 Тогда
				НайденныеПозиции1[0][ИмяРеквизитаСтатья] = Выборка.Статья;
				
			ИначеЕсли НайденныеПозиции1.Количество() = 0 И НайденныеПозиции2.Количество() = 1 Тогда
				НайденныеПозиции2[0][ИмяРеквизитаСтатья] = Выборка.Статья;
				
			Иначе
				// если несколько одинаковых по суммам строк, то смотрим номенклатуру
				СоответствиеНайдено = Ложь;
				Для каждого СтрокаТЧ из НайденныеПозиции1 Цикл
					Если Выборка.Статья = СтрокаТЧ.Номенклатура[ИмяРеквизитаСтатья] Тогда
						СтрокаТЧ[ИмяРеквизитаСтатья] = Выборка.Статья;
						СоответствиеНайдено = Истина;
						Прервать;
					КонецЕсли;
				КонецЦикла;
				Если НЕ СоответствиеНайдено И НЕ ТипЗнч(НайденныеПозиции2) = Тип("Массив") Тогда
					Для каждого СтрокаТЧ из НайденныеПозиции2 Цикл
						Если Выборка.Статья = СтрокаТЧ.Номенклатура[ИмяРеквизитаСтатья] Тогда
							СтрокаТЧ[ИмяРеквизитаСтатья] = Выборка.Статья;
							СоответствиеНайдено = Истина;
							Прервать;
						КонецЕсли;
					КонецЦикла;
				КонецЕсли;
				Если НЕ СоответствиеНайдено Тогда
					Возврат "Требуется ручное указание статей в табличных частях документа";
				Конецесли;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат "";
	
КонецФункции

