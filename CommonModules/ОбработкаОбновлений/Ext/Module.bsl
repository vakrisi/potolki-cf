		Исключение
			РезультатОбработки.Успешно = Ложь;
			РезультатОбработки.ОписаниеОшибки = ОписаниеОшибки();
			
			Если ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.ЗаказПокупателя") ИЛИ ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.Монтаж") Тогда
				ОбработаноУспешно1 = Ложь;	
