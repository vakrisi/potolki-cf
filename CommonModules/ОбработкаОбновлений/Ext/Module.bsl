#Область Обработка_2_5_0_0

Функция Обработка_2_5_0_0(СсылкаДокумент) Экспорт
	
	РезультатОбработки = Новый Структура;
	РезультатОбработки.Вставить("Успешно", Ложь);
	РезультатОбработки.Вставить("ОписаниеОшибки", "");
	
	//#8090 пока не надо
	//Если ТипЗнч(СсылкаДокумент) = Тип("ДокументСсылка.Лид") Тогда
	//	
	//	ДокОбъект = СсылкаДокумент.ПолучитьОбъект();
	//	
	//	НаборНаписей = РегистрыСведений.ИсторияЛида.СоздатьНаборЗаписей();
	//	НаборНаписей.Отбор.Лид.Установить(СсылкаДокумент);
	//	НаборНаписей.Прочитать();
	//	Для каждого ЗаписьРегистра из НаборНаписей Цикл
	//		Если СтрНайти(ЗаписьРегистра, "Создан лид по входящему звонку") > 0 Тогда
	//			ДокОбъект.СпособСоздания = Перечисления.СпособыСозданияЛида.АвтоматическиПриВходящемЗвонке;
	//			ДокОбъект.ДатаЗвонкаСоздавшегоЛид = ЗаписьРегистра.Дата;
	//			Прервать;
	//		КонецЕсли;
	//	КонецЦикла;				
	//	
	//	Попытка
	//		ДокОбъект.Записать(); // без режимов			
	//		РезультатОбработки.Успешно = Истина;
	//	Исключение
	//		РезультатОбработки.Успешно = Ложь;
	//		РезультатОбработки.ОписаниеОшибки = ОписаниеОшибки();
	//	КонецПопытки;
	//	
	//КонецЕсли;
	
	//#8261
	//Нужно заполнить новое измерения Подразделение в РегистрыНакопления.Закупки	
	Если ТипЗнч(СсылкаДокумент) = Тип("ДокументСсылка.ПоступлениеТоваровИУслуг") Тогда
		
		НаборЗаписей = РегистрыНакопления.Закупки.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Регистратор.Установить(СсылкаДокумент);
		НаборЗаписей.Прочитать();
		Для каждого Движение из НаборЗаписей Цикл
			Движение.Подразделение	= СсылкаДокумент.Подразделение;
		КонецЦикла;
		
		Попытка
			НаборЗаписей.Записать();
			РезультатОбработки.Успешно = Истина;
		Исключение
			РезультатОбработки.Успешно = Ложь;
			РезультатОбработки.ОписаниеОшибки = ОписаниеОшибки();
		КонецПопытки;
		
	КонецЕсли;
	
	// №8429 во всех лидах заполнить значение подразделение значением подразделение точки продаж лида
	Если ТипЗнч(СсылкаДокумент) = Тип("ДокументСсылка.Лид") Тогда
		
		ДокОбъект = СсылкаДокумент.ПолучитьОбъект();
		ДокОбъект.Подразделение = ДокОбъект.ТочкаПродаж.Подразделение;
		
		Попытка
			// Просто запишем, т.к. в выборке были все документы, даже не проведенные
			ДокОбъект.Записать();
			РезультатОбработки.Успешно = Истина;
		Исключение
			РезультатОбработки.Успешно = Ложь;
			РезультатОбработки.ОписаниеОшибки = ОписаниеОшибки();
		КонецПопытки;
		
	КонецЕсли;
	
	// №8266 новый реквизит ШиринаПолотна в карточке Номенклатуры для вида номенклатуры "Полотно"
	//заполнить ширину, если для полотна задан один элемент цвет - фактура, или у всех элементов одинаковое значение, если несколько и ширины разные, оставить для ручного исправления.
	Если ТипЗнч(СсылкаДокумент) = Тип("СправочникСсылка.Номенклатура") Тогда
		
		СправочникОбъект = СсылкаДокумент.ПолучитьОбъект();
		
		Запрос = новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ЕСТЬNULL(Цвет.Владелец.ШиринаПолотна, 0) КАК ШиринаПолотна
		|ИЗ
		|	Справочник.ЦветФактуры КАК Цвет
		|ГДЕ
		|	Цвет.Номенклатура = &Номенклатура
		|";
		Запрос.УстановитьПараметр("Номенклатура", СсылкаДокумент);
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		// Если элементов нет, считаем что обрабатывать нечего
		Если Выборка.Количество() = 0 Тогда
			
			РезультатОбработки.Успешно = Истина;
			
			// Если ширина во всех фактурах указана одна, то подставляем её
		ИначеЕсли Выборка.Количество() = 1 Тогда
			
			Выборка.Следующий();
			
			Попытка
				СправочникОбъект.ШиринаПолотна = Выборка.ШиринаПолотна;
				СправочникОбъект.ОбменДанными.Загрузка = Истина;
				СправочникОбъект.Записать();
				РезультатОбработки.Успешно = Истина;
			Исключение
				РезультатОбработки.Успешно = Ложь;
				РезультатОбработки.ОписаниеОшибки = ОписаниеОшибки();
			КонецПопытки;
			
		Иначе
			
			ТекстШирины = "";
			Пока Выборка.Следующий() Цикл
				ТекстШирины = ТекстШирины + ?(ЗначениеЗаполнено(ТекстШирины), ", ", "") + Выборка.ШиринаПолотна;
			КонецЦикла;
			
			РезультатОбработки.Успешно = Ложь;
			РезультатОбработки.ОписаниеОшибки = "Не удалось определить конкретное значение ширины полотна по связке цвет - фактура, где номенклатура указана как полотно. Найдены ширины (" + ТекстШирины + ").";
			
		КонецЕсли;
		
	КонецЕсли;
	
	// #6384 по документу Невыходы создаем 2 новых документа
	Если ТипЗнч(СсылкаДокумент) = Тип("ДокументСсылка.УДАЛИТЬ_Невыходы") Тогда
		ОбработатьДокументыНевыходы_Версия2500(РезультатОбработки);	
	КонецЕсли;
	
	Возврат РезультатОбработки;
	
КонецФункции

Процедура ОбработатьДокументыНевыходы_Версия2500(РезультатОбработки) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	НАЧАЛОПЕРИОДА(НевыходыЗамерщиков.Дата, МЕСЯЦ) КАК ПериодРегистрации,
	|	НевыходыЗамерщиков.Сотрудник КАК Сотрудник,
	//|	НевыходыЗамерщиков.Сотрудник.ТочкаПродаж КАК ТочкаПродаж,
	|	НевыходыЗамерщиков.Дата КАК ДатаНачала,
	|	НевыходыЗамерщиков.Дата КАК ДатаОкончания,
	|	НевыходыЗамерщиков.ВремяНачала КАК ВремяНачала,
	|	НевыходыЗамерщиков.ВремяОкончания КАК ВремяОкончания,
	|	НевыходыЗамерщиков.Комментарий КАК Комментарий
	|ИЗ
	|	РегистрСведений.Невыходы КАК НевыходыЗамерщиков
	|ГДЕ
	|	НЕ НевыходыЗамерщиков.Сотрудник = ЗНАЧЕНИЕ(Справочник.Сотрудники.ПустаяСсылка)
	|ИТОГИ ПО
	|	ПериодРегистрации
	//|	, ТочкаПродаж
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	НАЧАЛОПЕРИОДА(НевыходыБригад.Дата, МЕСЯЦ) КАК ПериодРегистрации,
	|	НевыходыБригад.Бригада КАК Бригада,
	|	НевыходыБригад.Дата КАК ДатаНачала,
	|	НевыходыБригад.Дата КАК ДатаОкончания,
	|	НевыходыБригад.ВремяНачала КАК ВремяНачала,
	|	НевыходыБригад.ВремяОкончания КАК ВремяОкончания,
	|	НевыходыБригад.Комментарий КАК Комментарий
	|ИЗ
	|	РегистрСведений.Невыходы КАК НевыходыБригад
	|ГДЕ
	|	НЕ НевыходыБригад.Бригада = ЗНАЧЕНИЕ(Справочник.Бригады.ПустаяСсылка)
	|ИТОГИ ПО
	|	ПериодРегистрации";
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	// формируем данные для создания документов
	МассивПоЗамерщикам = Новый Массив;
	ВыборкаПоПериодам = РезультатЗапроса[0].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаПоПериодам.Следующий() Цикл
		
		//ВыборкаПоТП = ВыборкаПоПериодам.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		//Пока ВыборкаПоТП.Следующий() Цикл
		СтруктураДокумента = Новый Структура("ПериодРегистрации, ТабличнаяЧасть", ВыборкаПоПериодам.ПериодРегистрации, Новый Массив);
		//СтруктураДокумента.Вставить("ТочкаПродаж", ВыборкаПоТП.ТочкаПродаж);
		
		Выборка = ВыборкаПоПериодам.Выбрать();
		Пока Выборка.Следующий() Цикл
			СтруктураСтрокиТЧ = Новый Структура("Сотрудник, ДатаНачала, ДатаОкончания, ВремяНачала, ВремяОкончания, Комментарий");
			ЗаполнитьЗначенияСвойств(СтруктураСтрокиТЧ, Выборка);
			СтруктураДокумента.ТабличнаяЧасть.Добавить(СтруктураСтрокиТЧ);
		КонецЦикла;
		
		МассивПоЗамерщикам.Добавить(СтруктураДокумента);
		//КонецЦикла;		
	КонецЦикла;
	
	МассивПоБригадам = Новый Массив;
	ВыборкаПоПериодам = РезультатЗапроса[1].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаПоПериодам.Следующий() Цикл
		СтруктураДокумента = Новый Структура("ПериодРегистрации, ТабличнаяЧасть", ВыборкаПоПериодам.ПериодРегистрации, Новый Массив);
		
		Выборка = ВыборкаПоПериодам.Выбрать();
		Пока Выборка.Следующий() Цикл
			СтруктураСтрокиТЧ = Новый Структура("Бригада, ДатаНачала, ДатаОкончания, ВремяНачала, ВремяОкончания, Комментарий");
			ЗаполнитьЗначенияСвойств(СтруктураСтрокиТЧ, Выборка);
			СтруктураДокумента.ТабличнаяЧасть.Добавить(СтруктураСтрокиТЧ);
		КонецЦикла;
		
		МассивПоБригадам.Добавить(СтруктураДокумента);
	КонецЦикла;
	
	// все в одной транзакции
	Попытка		
		НачатьТранзакцию();
		
		// распроводим невыходы
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ 
		|	Невыходы.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.УДАЛИТЬ_Невыходы КАК Невыходы
		|ГДЕ
		|	Невыходы.Проведен";
		
		Выборка = Запрос.Выполнить().Выбрать();	
		Пока Выборка.Следующий() Цикл
			ДокОбъект = Выборка.Ссылка.ПолучитьОбъект();
			ДокОбъект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
		КонецЦикла;
		
		Для каждого СтруктураДокумента из МассивПоЗамерщикам Цикл
			// пробуем подобрать документ по ПериодРегистрации
			Запрос = Новый Запрос;
			Запрос.УстановитьПараметр("ПериодРегистрации", СтруктураДокумента.ПериодРегистрации);
			//Запрос.УстановитьПараметр("ТочкаПродаж", СтруктураДокумента.ТочкаПродаж);
			Запрос.Текст = 
			"ВЫБРАТЬ
			|	ГрафикРаботыЗамерщиков.Ссылка КАК Ссылка
			|ИЗ
			|	Документ.ГрафикРаботыЗамерщиков КАК ГрафикРаботыЗамерщиков
			|ГДЕ
			|	НАЧАЛОПЕРИОДА(ГрафикРаботыЗамерщиков.ПериодРегистрации, МЕСЯЦ) = НАЧАЛОПЕРИОДА(&ПериодРегистрации, МЕСЯЦ)
			//|	И ГрафикРаботыЗамерщиков.ТочкаПродаж = &ТочкаПродаж
			|	И НЕ ГрафикРаботыЗамерщиков.ПометкаУдаления";
			
			Выборка = Запрос.Выполнить().Выбрать();
			Если Выборка.Следующий() Тогда
				ДокОбъект = Выборка.Ссылка.ПолучитьОбъект();
			Иначе
				ДокОбъект = Документы.ГрафикРаботыЗамерщиков.СоздатьДокумент();
				ДокОбъект.Дата = Мин(СтруктураДокумента.ПериодРегистрации, ТекущаяДатаСеанса());
				ДокОбъект.ПериодРегистрации = СтруктураДокумента.ПериодРегистрации;
				//ДокОбъект.ТочкаПродаж = СтруктураДокумента.ТочкаПродаж;
				ДокОбъект.УстановитьНовыйНомер();
			КонецЕсли;
			
			ДокОбъект.Сотрудники.Очистить();
			Для каждого СтруктураСтрокиТЧ из СтруктураДокумента.ТабличнаяЧасть Цикл
				СтрокаТЧ = ДокОбъект.Сотрудники.Добавить();
				ЗаполнитьЗначенияСвойств(СтрокаТЧ, СтруктураСтрокиТЧ);
			КонецЦикла;
			
			ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
		КонецЦикла;
		
		Для каждого СтруктураДокумента из МассивПоБригадам Цикл
			// пробуем подобрать документ по ПериодРегистрации
			Запрос = Новый Запрос;
			Запрос.УстановитьПараметр("ПериодРегистрации", СтруктураДокумента.ПериодРегистрации);
			Запрос.Текст = 
			"ВЫБРАТЬ 
			|	ГрафикРаботыМонтажныхБригад.Ссылка КАК Ссылка
			|ИЗ
			|	Документ.ГрафикРаботыМонтажныхБригад КАК ГрафикРаботыМонтажныхБригад
			|ГДЕ
			|	НачалоПериода(ГрафикРаботыМонтажныхБригад.ПериодРегистрации, Месяц) = НачалоПериода(&ПериодРегистрации, Месяц)
			|	И НЕ ГрафикРаботыМонтажныхБригад.ПометкаУдаления";
			
			Выборка = Запрос.Выполнить().Выбрать();
			Если Выборка.Следующий() Тогда
				ДокОбъект = Выборка.Ссылка.ПолучитьОбъект();
			Иначе
				ДокОбъект = Документы.ГрафикРаботыМонтажныхБригад.СоздатьДокумент();
				ДокОбъект.Дата = Мин(СтруктураДокумента.ПериодРегистрации, ТекущаяДатаСеанса());
				ДокОбъект.ПериодРегистрации = СтруктураДокумента.ПериодРегистрации;
				ДокОбъект.УстановитьНовыйНомер();
			КонецЕсли;
			
			ДокОбъект.Бригады.Очистить();
			Для каждого СтруктураСтрокиТЧ из СтруктураДокумента.ТабличнаяЧасть Цикл
				СтрокаТЧ = ДокОбъект.Бригады.Добавить();
				ЗаполнитьЗначенияСвойств(СтрокаТЧ, СтруктураСтрокиТЧ);
			КонецЦикла;
			
			ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
		КонецЦикла; 
		
		ЗафиксироватьТранзакцию();
		РезультатОбработки.Успешно = Истина;
	Исключение
		ОтменитьТранзакцию();
		
		РезультатОбработки.Успешно = Ложь;
		РезультатОбработки.ОписаниеОшибки = ОписаниеОшибки();		
	КонецПопытки;	
	
КонецПроцедуры

#КонецОбласти

#Область Обработка_2_5_2_0

Функция Обработка_2_5_2_0(СсылкаДокумент) Экспорт
	
	РезультатОбработки = Новый Структура;
	РезультатОбработки.Вставить("Успешно", Ложь);
	РезультатОбработки.Вставить("ОписаниеОшибки", "");
	
	// #7556 заполняем новые реквизиты
	Если ТипЗнч(СсылкаДокумент) = Тип("ДокументСсылка.ЗаказДоговор") Тогда
		
		ДокОбъект = СсылкаДокумент.ПолучитьОбъект();
		Комнаты = ДокОбъект.ТоварыУслуги.Выгрузить();
		Комнаты.Свернуть("Комната");
		ДокОбъект.КоличествоКомнат = Комнаты.Количество();;
		ДокОбъект.СуммаСкидки = ДокОбъект.ТоварыУслуги.Итог("СуммаСкидки");
		ДокОбъект.ПроцентСкидки = ?(НЕ (ДокОбъект.СуммаДокумента + ДокОбъект.СуммаСкидки) = 0, ДокОбъект.СуммаСкидки / (ДокОбъект.СуммаДокумента + ДокОбъект.СуммаСкидки)*100, 0);
		ДокОбъект.ОтклонениеОтПрайса = ДокОбъект.СуммаДокумента - ДокОбъект.СуммаДокументаПоПрайсу;
		
		Попытка
			// Просто запишем
			ДокОбъект.ОбменДанными.Загрузка = Истина;
			ДокОбъект.Записать();
			РезультатОбработки.Успешно = Истина;
		Исключение
			РезультатОбработки.Успешно = Ложь;
			РезультатОбработки.ОписаниеОшибки = ОписаниеОшибки();
		КонецПопытки;
		
	КонецЕсли;
	
	Возврат РезультатОбработки;
	
КонецФункции

#КонецОбласти

#Область Обработка_2_5_3_0

Функция Обработка_2_5_3_0(СсылкаДокумент) Экспорт
	
	РезультатОбработки = Новый Структура;
	РезультатОбработки.Вставить("Успешно", Ложь);
	РезультатОбработки.Вставить("ОписаниеОшибки", "");
	
	// #8756 удаление пустых замеров
	Если ТипЗнч(СсылкаДокумент) = Тип("ДокументСсылка.Лид") Тогда
		
		ДокОбъект = СсылкаДокумент.ПолучитьОбъект();
		
		Попытка
			// Просто запишем, обработка в процедуре ПередЗаписью модуля объекта
			ДокОбъект.Записать();
			РезультатОбработки.Успешно = Истина;
		Исключение
			РезультатОбработки.Успешно = Ложь;
			РезультатОбработки.ОписаниеОшибки = ОписаниеОшибки();
		КонецПопытки;
		
	КонецЕсли;
	
	// #8742 заполнение нового ресурса
	Если ТипЗнч(СсылкаДокумент) = Тип("ДокументСсылка.ЗаказПоставщику") 
		ИЛИ ТипЗнч(СсылкаДокумент) = Тип("ДокументСсылка.ВозвратТовараПоставщику")
		ИЛИ ТипЗнч(СсылкаДокумент) = Тип("ДокументСсылка.ПоступлениеТоваровИУслуг")
		Тогда
		
		ДокОбъект = СсылкаДокумент.ПолучитьОбъект();
		
		НаборЗаписей = РегистрыНакопления.ЗаказыПоставщикам.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Регистратор.Установить(СсылкаДокумент);
		НаборЗаписей.Прочитать();
		Для каждого Движение из НаборЗаписей Цикл
			
			СтруктураПоиска = Новый Структура("Номенклатура, ХарактеристикаНоменклатуры, ЕдиницаИзмерения, Цена");
			ЗаполнитьЗначенияСвойств(СтруктураПоиска, Движение);
			
			НайденныеСтроки = ДокОбъект.Товары.НайтиСтроки(СтруктураПоиска);
			Если НайденныеСтроки.Количество() > 0 Тогда 
				Для каждого НайденнаяСтрока из НайденныеСтроки Цикл
					Если Движение.Количество = Окр(НайденнаяСтрока.Количество * НайденнаяСтрока.Коэффициент, 2) Тогда
						Движение.Сумма = НайденнаяСтрока.Сумма;
						Прервать;
					КонецЕсли;
				КонецЦикла;
				
			ИначеЕсли ТипЗнч(СсылкаДокумент) = Тип("ДокументСсылка.ПоступлениеТоваровИУслуг") Тогда				
				СтруктураПоиска = Новый Структура("Номенклатура, ЕдиницаИзмерения, Цена");
				ЗаполнитьЗначенияСвойств(СтруктураПоиска, Движение);
				
				НайденныеСтроки = ДокОбъект.Услуги.НайтиСтроки(СтруктураПоиска);
				Если НайденныеСтроки.Количество() > 0 Тогда 
					Для каждого НайденнаяСтрока из НайденныеСтроки Цикл
						Если Движение.Количество = Окр(НайденнаяСтрока.Количество * НайденнаяСтрока.Коэффициент, 2) Тогда
							Движение.Сумма = НайденнаяСтрока.Сумма;
							Прервать;
						КонецЕсли;
					КонецЦикла;					
				КонецЕсли;
			КонецЕсли;
			
		КонецЦикла;
		
		Попытка
			НаборЗаписей.Записать();
			РезультатОбработки.Успешно = Истина;
		Исключение
			РезультатОбработки.Успешно = Ложь;
			РезультатОбработки.ОписаниеОшибки = ОписаниеОшибки();
		КонецПопытки;
		
	КонецЕсли;
	
	Возврат РезультатОбработки;
	
КонецФункции

#КонецОбласти

#Область Обработка_2_5_4_0

Функция Обработка_2_5_4_0(СсылкаДокумент) Экспорт
	
	РезультатОбработки = Новый Структура;
	РезультатОбработки.Вставить("Успешно", Ложь);
	РезультатОбработки.Вставить("ОписаниеОшибки", "");
	
	// №8814 получим список одинаковых потолков
	Если ТипЗнч(СсылкаДокумент) = Тип("СправочникСсылка.Номенклатура") Тогда
		
		ЗапросПозиции = новый Запрос;
		ЗапросПозиции.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Номенклатура.Ссылка
		|ИЗ
		|	Справочник.Номенклатура КАК Номенклатура
		|ГДЕ
		|	Номенклатура.Наименование = &Наименование
		|	И Номенклатура.Потолок_НомерРасчета = &Потолок_НомерРасчета
		|	И Номенклатура.Потолок_ИндексПотолка = &Потолок_ИндексПотолка
		|	И НЕ Номенклатура.ПометкаУдаления
		|";
		ЗапросПозиции.УстановитьПараметр("Наименование", СсылкаДокумент.Наименование);
		ЗапросПозиции.УстановитьПараметр("Потолок_НомерРасчета", СсылкаДокумент.Потолок_НомерРасчета);
		ЗапросПозиции.УстановитьПараметр("Потолок_ИндексПотолка", СсылкаДокумент.Потолок_ИндексПотолка);
		
		ТаблицаПозиции = ЗапросПозиции.Выполнить().Выгрузить();
		ТаблицаПозиции.Колонки.Добавить("ПоследняяДатаДокумента", новый ОписаниеТипов("Дата",,,,, новый КвалификаторыДаты(ЧастиДаты.ДатаВремя)));
		
		// Если потолка существует более одного (с ключами "Наименование, Номер расчета, Индекс потолока").
		Если ТаблицаПозиции.Количество() > 1 Тогда
			
			// Пройдёмся по всем одинаковым позициям и проверяем те, по которым нет ни одного документа, 
			// помечаем на удаление и пытаемся удалить с контролем ссылочной целостности.
			// Если по нескольким из найденных дублей потолка есть документы,
			// то помечаем на удаление все кроме того который использовался в самом последнем по дате документе и оставляем в справочнике
			Для Каждого ТекущаяПозиция Из ТаблицаПозиции Цикл
				
				ЗапросДокументы = новый Запрос;
				ТекстЗапроса = "";
				
				Для Каждого ВидДокумента Из Метаданные.Документы Цикл
					
					Если НЕ ВидДокумента.ТабличныеЧасти.Найти("Товары") = Неопределено И НЕ ВидДокумента.ТабличныеЧасти.Товары.Реквизиты.Найти("Номенклатура") = Неопределено Тогда
						
						Если ЗначениеЗаполнено(ТекстЗапроса) Тогда
							ТекстЗапроса = ТекстЗапроса + "
							|	ОБЪЕДИНИТЬ ВСЕ";
						КонецЕсли;
						
						ТекстЗапроса = ТекстЗапроса + "
						|ВЫБРАТЬ
						|	Ссылка.Дата КАК Дата
						|ИЗ
						|	Документ." + ВидДокумента.Имя + ".Товары
						|ГДЕ
						|	Номенклатура = &Номенклатура
						|";
						
					КонецЕсли;
					
					
					Если НЕ ВидДокумента.ТабличныеЧасти.Найти("Материалы") = Неопределено И НЕ ВидДокумента.ТабличныеЧасти.Материалы.Реквизиты.Найти("Номенклатура") = Неопределено Тогда
						
						Если ЗначениеЗаполнено(ТекстЗапроса) Тогда
							ТекстЗапроса = ТекстЗапроса + "
							|	ОБЪЕДИНИТЬ ВСЕ";
						КонецЕсли;
						
						ТекстЗапроса = ТекстЗапроса + "
						|ВЫБРАТЬ
						|	Ссылка.Дата КАК Дата
						|ИЗ
						|	Документ." + ВидДокумента.Имя + ".Материалы
						|ГДЕ
						|	Номенклатура = &Номенклатура
						|";
						
					КонецЕсли;
					
					
				КонецЦикла;
				
				ТекстЗапроса = ТекстЗапроса + "
				|УПОРЯДОЧИТЬ ПО
				|	Дата УБЫВ";
				
				ЗапросДокументы.Текст = ТекстЗапроса;
				ЗапросДокументы.УстановитьПараметр("Номенклатура", ТекущаяПозиция.Ссылка);
				
				ВыборкаДокументы = ЗапросДокументы.Выполнить().Выбрать();
				
				Если ВыборкаДокументы.Следующий() Тогда
					ТекущаяПозиция.ПоследняяДатаДокумента = ВыборкаДокументы.Дата;
				КонецЕсли;
				
			КонецЦикла;	
			
			// Сортируем по убыванию даты документа (если документа не было, дата будет (1,1,1)), далее самую первую позицию не будет трогать!
			ТаблицаПозиции.Сортировать("ПоследняяДатаДокумента УБЫВ");
			
			// Начинаем сразу со второй, т.к. первая по дате будет считаться самой приоритетной (которую не нужно помечать на удаление и удалять)
			Первая = Истина;
			Для Каждого ТекущаяСтрока Из ТаблицаПозиции Цикл
				
				Если Первая Тогда 
					Первая = Ложь;
					Продолжить;
				КонецЕсли;
				
				ОбъектНоменклатура = ТекущаяСтрока.Ссылка.ПолучитьОбъект();
				
				Попытка
					ОбъектНоменклатура.УстановитьПометкуУдаления(Истина, Истина);
					
					// Если позиция не указана в документах и на неё нет ссылок в других объектах, можем смело удалять такую позицию из ИБ
					МассивСсылок = новый Массив;
					МассивСсылок.Добавить(ОбъектНоменклатура.Ссылка);
					Если ТекущаяСтрока.ПоследняяДатаДокумента = Дата(1,1,1) И НайтиПоСсылкам(МассивСсылок).Количество() = 0 Тогда
						ОбъектНоменклатура.Удалить();
					Иначе
						// Иначе просто помечаем на удаление
						ОбъектНоменклатура.Записать();
					КонецЕсли;
					
					РезультатОбработки.Успешно = Истина;
					
				Исключение
					
					РезультатОбработки.Успешно = Ложь;
					РезультатОбработки.ОписаниеОшибки = ОписаниеОшибки();
					Прервать; // прерываем цикл, если хотя бы по одной позиции не получилось произвести пометку на удаление или полное удаление
					
				КонецПопытки;
				
			КонецЦикла;
			
		Иначе
			
			// Дублей потолков нет, считаем обработанной позицией
			РезультатОбработки.Успешно = Истина;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат РезультатОбработки;
	
КонецФункции

#КонецОбласти

