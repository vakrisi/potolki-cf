		ИЛИ ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.ПриходныйКассовыйОрдер")
		ИЛИ ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.РасходныйКассовыйОрдер")
		Тогда
		
		ИмяРеквизита = "";
		ИмяРеквизитаБонусов = "СуммаБонусовКНачислениюПоДисконтнойКарте";
		Если ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.ОплатаБанковскойКартой") Тогда
			ИмяРеквизита = "ЭквайринговыйТерминал";
		ИначеЕсли ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.ПоступлениеНаРасчетныйСчет") Тогда
			ИмяРеквизита = "Счет";
		ИначеЕсли ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.ПриходныйКассовыйОрдер") Тогда
			ИмяРеквизита = "Касса";
		ИначеЕсли ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.РасходныйКассовыйОрдер") Тогда
			ИмяРеквизита = "Касса";
			ИмяРеквизитаБонусов = "СуммаБонусовКСписаниюПоДисконтнойКарте";
		КонецЕсли;
		
		ДокОбъект = СсылкаНаОбъект.ПолучитьОбъект();
		СтруктураБонусов = БонусыСервер.ПолучитьСуммуБонусовКНачислениюПоДокументуОплаты(ДокОбъект.Дата, ДокОбъект.Организация, ДокОбъект.Контрагент.Категория, 
		ДокОбъект[ИмяРеквизита], ДокОбъект.Сумма, 
		ДокОбъект.Ссылка, ДокОбъект.ДисконтнаяКарта, 
		ДокОбъект.СлужебныйУчетБонусовПоДисконтнымКартам);
		
		Если СтруктураБонусов.СуммаБонусов = ДокОбъект[ИмяРеквизитаБонусов] Тогда
			РезультатОбработки.Успешно = Истина;
			
			// #14188 Ильнур: пока не меняем документ, пусть реквизиты остаются пустыми
			//ДокОбъект.ДокументНАНБ = СтруктураБонусов.ДокументНАНБ;           // #14188 
			//ДокОбъект.КатегорияКонтрагента = ДокОбъект.Контрагент.Категория;  // #14188
			//
			//Если ДокОбъект.Проведен Тогда // #14188 запишем документ
			//	Попытка
			//		ДокОбъект.ДополнительныеСвойства.Вставить("ПропуститьПроверкуЗапретаИзменения", Истина);
			//		ДокОбъект.Записать(РежимЗаписиДокумента.Проведение); 
			//		РезультатОбработки.Успешно = Истина;
			//	Исключение
			//		РезультатОбработки.Успешно = Ложь;
			//		РезультатОбработки.ОписаниеОшибки = ОписаниеОшибки();
			//	КонецПопытки;
			//Иначе
			//	РезультатОбработки.Успешно = Истина;
			//КонецЕсли;
			
		Иначе
			РезультатОбработки.Успешно = Ложь;
			РезультатОбработки.ОписаниеОшибки = СтрШаблон("Суммы начисленных бонусов по новой (%1) и старой (%2) схеме не совпадают",
			СтруктураБонусов.СуммаБонусов, ДокОбъект[ИмяРеквизитаБонусов]);
		КонецЕсли;
		
		//#13834 
	ИначеЕсли ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.РеализацияТоваровИУслуг") Тогда
		
		ДокОбъект = СсылкаНаОбъект.ПолучитьОбъект();
		БонусыСервер.ПересчитатьБонусыПоДокументу(ДокОбъект, Истина, Ложь);
		
		Если ДокОбъект.СуммаБонусовКНачислениюПоДисконтнойКарте = СсылкаНаОбъект.СуммаБонусовКНачислениюПоДисконтнойКарте Тогда
			
			РезультатОбработки.Успешно = Истина;
			
			// #14188 Ильнур: пока не меняем документ, пусть реквизиты остаются пустыми
			//ДокОбъект.КатегорияКонтрагента = ДокОбъект.Контрагент.Категория; // #14188
			//
			//Если ДокОбъект.Проведен Тогда  // #14188 запишем документ
			//	Попытка
			//		ДокОбъект.ДополнительныеСвойства.Вставить("ПропуститьПроверкуЗапретаИзменения", Истина);
			//		ДокОбъект.Записать(РежимЗаписиДокумента.Проведение); 
			//		РезультатОбработки.Успешно = Истина;
			//	Исключение
			//		РезультатОбработки.Успешно = Ложь;
			//		РезультатОбработки.ОписаниеОшибки = ОписаниеОшибки();
			//	КонецПопытки;
			//Иначе
			//	РезультатОбработки.Успешно = Истина;
			//КонецЕсли;
		Иначе
			РезультатОбработки.Успешно = Ложь;
			РезультатОбработки.ОписаниеОшибки = СтрШаблон("Суммы начисленных бонусов по новой (%1) и старой (%2) схеме не совпадают",
			ДокОбъект.СуммаБонусовКНачислениюПоДисконтнойКарте, СсылкаНаОбъект.СуммаБонусовКНачислениюПоДисконтнойКарте);
		КонецЕсли;
		
