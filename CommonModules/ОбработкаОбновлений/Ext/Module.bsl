#Область Обработка_3_1_5_0

Функция Обработка_3_1_5_0(СсылкаНаОбъект, ОбработкаОбязательныхОбъектов, ВерсияПрограммыЧисло) Экспорт
	
	Если ОбработкаОбязательныхОбъектов Тогда
		Возврат Обработка_3_1_5_0_Обязательные(СсылкаНаОбъект, ВерсияПрограммыЧисло);
	КонецЕсли;
	
	РезультатОбработки = Новый Структура;
	РезультатОбработки.Вставить("Успешно", Ложь);
	РезультатОбработки.Вставить("ОписаниеОшибки", "");
	
	//#16579 заполнение новых реквизитов "Цена по прайсу", "Сумма по прайсу" 
	Если ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.Монтаж") Тогда
		
		ДокОбъект = СсылкаНаОбъект.ПолучитьОбъект();
		ДокументИзменен = Ложь;
		
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("СсылкаНаОбъект", СсылкаНаОбъект);
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ДанныеДокумента.НомерСтроки КАК НомерСтроки,
		|	ЕСТЬNULL(ТоварыЗаказа.ЦенаПоПрайсу, 0) КАК ЦенаПоПрайсу,
		|	ЕСТЬNULL(ТоварыЗаказа.СуммаПоПрайсу, 0) КАК СуммаПоПрайсу
		|ИЗ
		|	Документ.Монтаж.ТоварыУслуги КАК ДанныеДокумента
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаказДоговор.ТоварыУслуги КАК ТоварыЗаказа
		|		ПО ДанныеДокумента.Ссылка.Основание = ТоварыЗаказа.Ссылка
		|			И ДанныеДокумента.УИСтроки = ТоварыЗаказа.УИСтроки
		|			И (НЕ ТоварыЗаказа.СуммаПоПрайсу = 0)
		|ГДЕ
		|	ДанныеДокумента.Ссылка = &СсылкаНаОбъект";

		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			СтрокаТЧ = ДокОбъект.ТоварыУслуги[Выборка.НомерСтроки - 1];
			СтрокаТЧ.ЦенаПоПрайсу = Выборка.ЦенаПоПрайсу;
			СтрокаТЧ.СуммаПоПрайсу = Выборка.СуммаПоПрайсу;
			
			ДокументИзменен = Истина;
		КонецЦикла;
		
		Если ДокументИзменен  Тогда
			Попытка
				ДокОбъект.ОбменДанными.Загрузка = Истина;
				ДокОбъект.ДополнительныеСвойства.Вставить("ПропуститьПроверкуЗапретаИзменения", Истина);
				ДокОбъект.Записать();
				РезультатОбработки.Успешно = Истина;				
			Исключение				
				РезультатОбработки.Успешно = Ложь;
				РезультатОбработки.ОписаниеОшибки = ОписаниеОшибки();
			КонецПопытки;
		Иначе
			РезультатОбработки.Успешно = Истина;
		КонецЕсли;
		
	КонецЕсли;
	
