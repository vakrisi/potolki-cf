					Элемент.Заказ = ЭлементМассива.ДокументОснование;
				КонецЦикла;
				
				НайденныеСтроки = ДокОбъект.Услуги.НайтиСтроки(Новый Структура("Заказ", ЭлементМассива));
				Для каждого Элемент из  НайденныеСтроки Цикл
					Элемент.Заказ = ЭлементМассива.ДокументОснование;
				КонецЦикла;
				
				НайденныеСтроки = ДокОбъект.Основания.НайтиСтроки(Новый Структура("Основание", ЭлементМассива));
				Для каждого Элемент из  НайденныеСтроки Цикл
					Элемент.Основание = ЭлементМассива.ДокументОснование;
				КонецЦикла;
