#Область Обработка_2_5_7_0

Функция Обработка_2_5_7_0(СсылкаДокумент) Экспорт
	
	РезультатОбработки = Новый Структура;
	РезультатОбработки.Вставить("Успешно", Ложь);
	РезультатОбработки.Вставить("ОписаниеОшибки", "");
	
	// #8731 
	Если ТипЗнч(СсылкаДокумент) = Тип("ДокументСсылка.Лид") Тогда		
		
		ДокОбъект = СсылкаДокумент.ПолучитьОбъект();
		ДокОбъект.ДатаИзмененияДанныхКлиента = ДокОбъект.Дата;
		
		Попытка
			// Просто запишем, перепроведение не требуется
			ДокОбъект.Записать();
			РезультатОбработки.Успешно = Истина;
		Исключение
			РезультатОбработки.Успешно = Ложь;
			РезультатОбработки.ОписаниеОшибки = ОписаниеОшибки();
		КонецПопытки;
		
	КонецЕсли;
	
	Возврат РезультатОбработки;
	
КонецФункции

#КонецОбласти

#Область Обработка_2_5_9_0

Функция Обработка_2_5_9_0(СсылкаДокумент) Экспорт
	
	РезультатОбработки = Новый Структура;
	РезультатОбработки.Вставить("Успешно", Ложь);
	РезультатОбработки.Вставить("ОписаниеОшибки", "");
	
	// №8749 Формирование новых движений в регистры ЗаказыПокупателей и РасчетыПоЗаказам
	// Винимание! Здесь обрабатываются только возврат продукции и возврат товаров от покупателя
	Если ТипЗнч(СсылкаДокумент) = Тип("ДокументСсылка.ВозвратПродукции")
		ИЛИ ТипЗнч(СсылкаДокумент) = Тип("ДокументСсылка.ВозвратТовараОтПокупателя")
		Тогда
		
		// Обрабатываем только проведенный документ и только если в ТЧ Товары есть данные
		Если СсылкаДокумент.Проведен И СсылкаДокумент.Товары.Количество() > 0 Тогда
			
			ВестиРасчетыПоЗаказамПоРТиУ = Константы.ВестиРасчетыПоЗаказамПоРТиУ.Получить();
			
			НаборЗаписей = РегистрыНакопления.ЗаказыПокупателей.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.Регистратор.Установить(СсылкаДокумент);
			
			Для Каждого ТекущаяСтрока Из СсылкаДокумент.Товары Цикл
				
				Если ТекущаяСтрока.ЗаказПокупателя.Пустая() Тогда
					Продолжить;
				КонецЕсли;	
				
				Движение = НаборЗаписей.Добавить();
				Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
				Движение.Период = СсылкаДокумент.Дата;
				Движение.ЗаказНаПроизводство = ТекущаяСтрока.ЗаказПокупателя;
				Движение.Организация = СсылкаДокумент.Организация;
				Движение.Контрагент = СсылкаДокумент.Контрагент;
				Движение.Количество = -(ТекущаяСтрока.Количество * ТекущаяСтрока.Коэффициент);
				Движение.Номенклатура = ТекущаяСтрока.Номенклатура;
				Движение.ХарактеристикаНоменклатуры = ТекущаяСтрока.ХарактеристикаНоменклатуры;
				Движение.СерияНоменклатуры = ТекущаяСтрока.СерияНоменклатуры;
				
			КонецЦикла;
			
			Попытка
				НаборЗаписей.Записать();
				РезультатОбработки.Успешно = Истина;
			Исключение
				РезультатОбработки.Успешно = Ложь;
				РезультатОбработки.ОписаниеОшибки = "Не удалось сформировать движения в регистр ""Заказы покупателей"": " + ОписаниеОшибки();
				// Сразу возвращаем результат, т.к. есть второй этап обработки, который без успешной первой нельзя обрабатывать
				Возврат РезультатОбработки;
			КонецПопытки;
			
			// Т.к. условия формирования движений в регистр "Расчеты по заказам" немного разные, сделаем доп условия по аналогии с настрощими условиями (которые в ОбработкаПроведения соответствующих документов)
			ДопУсловиеВыполнено = ?(ТипЗнч(СсылкаДокумент) = Тип("ДокументСсылка.ВозвратПродукции"), ТипЗнч(СсылкаДокумент.Основание) = Тип("ДокументСсылка.РеализацияТоваровИУслуг") И Не СсылкаДокумент.Основание.Пустая(), Истина);
			Если ВестиРасчетыПоЗаказамПоРТиУ И ДопУсловиеВыполнено Тогда
				
				//РасчетыПоЗаказам
				НаборЗаписей = РегистрыНакопления.РасчетыПоЗаказам.СоздатьНаборЗаписей();
				НаборЗаписей.Отбор.Регистратор.Установить(СсылкаДокумент);
				
				Для Каждого ТекущаяСтрока Из СсылкаДокумент.Товары Цикл
					
					Если ТипЗнч(СсылкаДокумент) = Тип("ДокументСсылка.ВозвратТовараОтПокупателя") И ТекущаяСтрока.ДокументПродажи.Пустая() Тогда
						Продолжить;
					КонецЕсли;
					
					Заказ = ?(ТипЗнч(СсылкаДокумент) = Тип("ДокументСсылка.ВозвратТовараОтПокупателя"), ТекущаяСтрока.ДокументПродажи, СсылкаДокумент.Основание);
					
					Движение = НаборЗаписей.Добавить();
					Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
					Движение.Период = СсылкаДокумент.Дата;
					Движение.Заказ = Заказ;
					Движение.Сумма = ТекущаяСтрока.Сумма;
					Движение.Контрагент = СсылкаДокумент.Контрагент;
					
				КонецЦикла;
				
				Попытка
					НаборЗаписей.Записать();
					РезультатОбработки.Успешно = Истина;
				Исключение
					РезультатОбработки.Успешно = Ложь;
					РезультатОбработки.ОписаниеОшибки = "Не удалось сформировать движения в регистр ""Расчеты по заказам"": " + ОписаниеОшибки();
				КонецПопытки;
				
			КонецЕсли;
			
		Иначе
			
			// Обработка не требуется
			РезультатОбработки.Успешно = Истина;
			
		КонецЕсли;	
		
	КонецЕсли;
	
	Возврат РезультатОбработки;
	
КонецФункции

#КонецОбласти

