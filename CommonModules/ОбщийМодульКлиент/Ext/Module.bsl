#Область ИзменениеСтатусаЗаявкиНаДоставку

//++ №10663
Процедура ИзменитьТекущийСтатусЗаявкиНаДоставку(Форма, ИмяСписка) Экспорт
	
	Элементы = Форма.Элементы;
	
	ОчиститьСообщения();
	
	МассивДокументов = Новый Массив;
	
	Если Форма.Элементы[ИмяСписка].ВыделенныеСтроки.Количество() = 0 Тогда
		Сообщить("Нет выделенных документов");
		Возврат;
	КонецЕсли;
		
	Для НомерСтроки = 0 По Элементы[ИмяСписка].ВыделенныеСтроки.Количество()-1 Цикл			
		МассивДокументов.Добавить(Элементы[ИмяСписка].ВыделенныеСтроки.Получить(НомерСтроки)); 
	КонецЦикла;
	
	ОписаниеОповещения = новый ОписаниеОповещения("ПослеВыбораНовогоСтатуса", ЭтотОбъект, новый Структура("Форма, ИмяСписка, МассивДокументов", Форма, ИмяСписка, МассивДокументов));
	ОткрытьФорму("ОбщаяФорма.ВыборИзСписка", новый Структура("ДоступныеЗначения", ОбщийМодульВызовСервера.ВернутьСписокСтатустовЗаявокНаДоставку()),,,,, ОписаниеОповещения);
	
КонецПроцедуры

Процедура ПослеВыбораНовогоСтатуса(Результат, ДопПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ДопПараметры.Вставить("Статус", Результат);
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ПослеВопросаИзменитьСтатусДокументов", ЭтотОбъект, ДопПараметры);
	ТекстСообщения = "Перевести заявки на доставку в количестве " + ДопПараметры.МассивДокументов.Количество() + " шт. в статус """ + Результат + """? 
					|Документы будут автоматически записаны.";
	ПоказатьВопрос(ОписаниеОповещения, ТекстСообщения, РежимДиалогаВопрос.ДаНет);	
	
КонецПроцедуры

Процедура ПослеВопросаИзменитьСтатусДокументов(Результат, ДопПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли;
	
	ОбщийМодульВызовСервера.ИзменитьСтатусДокументовНаСервере(ДопПараметры.МассивДокументов, ДопПараметры.Статус);
	ДопПараметры.Форма.Элементы[ДопПараметры.ИмяСписка].Обновить();
	
	ПоказатьОповещениеПользователя("Выполнено");
		
КонецПроцедуры
