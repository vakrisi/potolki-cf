	//		Возврат;
	//	КонецЕсли;
	//КонецЕсли;
	
	ДанныеВыбора = Результат.Данные;
	
	// Стандартную обработку отключаем, только если есть наши варианты.
	Если ДанныеВыбора.Количество() > 0 Тогда
		СтандартнаяОбработка = Ложь;
	КонецЕсли;
	
КонецПроцедуры

Функция ВариантыУлицПоТексту(Знач Текст, ИдентификаторНаселенногоПункта)
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("Идентификатор", ИдентификаторНаселенногоПункта);
	ДополнительныеПараметры.Вставить("ТипАдреса",     "Административно-территориальный");
	ДополнительныеПараметры.Вставить("Уровень",       7);
	
	ДополнительныеПараметры.Вставить("ИзФормыДокумента", Истина); //++
	
	Результат = ОбщийМодульВызовСервера.СписокАвтоподбораУлицы(Текст, ДополнительныеПараметры);
	Возврат Результат;

КонецФункции

