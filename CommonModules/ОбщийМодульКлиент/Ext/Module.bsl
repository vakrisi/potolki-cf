Процедура ПослеВопросаОПерезаполненииВыпуска(Результат, Параметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		//пользователь согласился с перезаполнением документа
		ПараметрыОповещенияПослеЗакрытия = Новый Структура;
		ПараметрыОповещенияПослеЗакрытия.Вставить("Дата", Параметры.Дата);
		ПараметрыОповещенияПослеЗакрытия.Вставить("Номер", Параметры.Номер);
		ПараметрыОповещенияПослеЗакрытия.Вставить("ИмяСписка", Параметры.ИмяСписка);
		ПараметрыОповещенияПослеЗакрытия.Вставить("Основание", Параметры.Основание);				
		ПараметрыОповещенияПослеЗакрытия.Вставить("Ключ", Параметры.Ключ);
		ОткрытьФорму("Документ.ВыпускПродукции.Форма.ФормаДокумента", Параметры,,,,,Новый ОписаниеОповещения("ПослеСозданияДокументаВыпуска", ОбщийМодульКлиент, ПараметрыОповещенияПослеЗакрытия));
	Иначе
		//пользователь отказался
		ПоказатьПредупреждение(,"Выпуск должен соответствовать заказу");
	КонецЕсли;
	
КонецПроцедуры

Процедура ПеревестиЗаказыНаПроизводствоВСтатусОтменен(МассивЗаказовКОтмене) Экспорт
	
	ТекстВопроса = "На основании заказа покупателя имеются заказы на производство, которые еще не были произведены. Перевести их в статус ""Отменен""?
	|Список заказов на производство к отмене:";
	Для каждого ЭлементМассива из МассивЗаказовКОтмене Цикл
		ТекстВопроса = ТекстВопроса + Строка(ЭлементМассива) + Символы.ПС;
	КонецЦикла;
	
	ДополнительныеПараметры = Новый Структура("МассивЗаказовКОтмене", МассивЗаказовКОтмене);
	ОписаниеОповещения = Новый ОписаниеОповещения("ПослеВопросаОбОтменеЗаказовНаПроизводство", ЭтотОбъект, ДополнительныеПараметры);
	ПоказатьВопрос(ОписаниеОповещения,ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры

Процедура ПослеВопросаОбОтменеЗаказовНаПроизводство(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		Для каждого ЭлементМассива из ДополнительныеПараметры.МассивЗаказовКОтмене Цикл
			ОбщийМодульВызовСервера.ИзменитьСтатусЗаказНаПроизводство(ЭлементМассива, ПредопределенноеЗначение("Справочник.СтатусыЗаказовНаПроизводство.Отменен"));
		КонецЦикла;
		ПоказатьПредупреждение(,"Перевод заказов на производство в статус ""Отменен"" завершен");
    КонецЕсли;

