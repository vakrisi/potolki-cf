Процедура Розница_ДобавитьСтрокуВДеревоТоваров(Форма, ДанныеСтроки, ПереходНаСтроку = Истина, РежимИзмененияСтроки = Ложь)
	
	//++ №12433
	//Розница_ДобавитьНоменклатуруВДерево(Форма, Форма.ДеревоТоваров, ДанныеСтроки, ПереходНаСтроку, "ДеревоТоваровКоличество", РежимИзмененияСтроки);
