Процедура Розница_ДобавитьКомнату(Параметры) Экспорт
	
	Если Параметры.ПереключательНаНазваниеКомнат Тогда
		ПараметрыФормыВыбора = Новый Структура("ПодборВЗаказДоговор", Истина);
		// #10992 изменена схема наименования комнаты
		//ОписаниеОповещения = Новый ОписаниеОповещения("ПослеВыбораКомнаты", ЭтотОбъект);
		//ОткрытьФорму("Справочник.НазваниеКомнат.ФормаВыбора", ПараметрыФормыВыбора, , , , , ОписаниеОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		ОткрытьФорму("Справочник.НазваниеКомнат.ФормаВыбора", ПараметрыФормыВыбора, Параметры.Форма, , , , , РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	Иначе
		Розница_ДобавитьКомнатуЗавершение(Параметры, Неопределено);
	КонецЕсли;
		
КонецПроцедуры

Процедура Розница_ДобавитьКомнатуЗавершение(Параметры, ДанныеВыборкаКомнаты) Экспорт
	
	Форма = Параметры.Форма;
	
	МассивКомнат = Новый Массив;
	СтрокиКомнат = Форма.ДеревоТоваров.ПолучитьЭлементы();
	Для каждого СтрокаКомнаты из СтрокиКомнат Цикл
		МассивКомнат.Добавить(СтрокаКомнаты.Комната);
	КонецЦикла;
	
	//добавим комнату в товары
	ИмяНовойКомнаты = "";
	Если ДанныеВыборкаКомнаты = Неопределено Тогда
		// простое добавление комнаты с номером
		ИмяНовойКомнаты = ОбщийМодульВызовСервера.Розница_ПолучитьНаименованиеНовойКомнаты(МассивКомнат, Неопределено);
	Иначе
		// добавление из справочника		
		ИмяНовойКомнаты = СокрЛП(ДанныеВыборкаКомнаты.Комната);
		Если НЕ ДанныеВыборкаКомнаты.НеДобавлятьПрефиксКомнаты Тогда
			// с префиксом "Комната Х ..."
			ИмяНовойКомнаты = ОбщийМодульВызовСервера.Розница_ПолучитьНаименованиеНовойКомнаты(МассивКомнат, ДанныеВыборкаКомнаты.Комната);
		КонецЕсли;
	КонецЕсли;
	
	Для каждого СтрокаКомнаты из СтрокиКомнат Цикл
		Если СтрокаКомнаты.Комната = ИмяНовойКомнаты Тогда
			ТекстСообщения = "Комната с наименованием """ + ИмяНовойКомнаты + """ уже имеется в заказе";
			//ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
			ПоказатьПредупреждение(, ТекстСообщения);
			Возврат;
		КонецЕсли;
	КонецЦикла;
	
	НоваяСтрокаТовары = СтрокиКомнат.Добавить();
	НоваяСтрокаТовары.Комната = ИмяНовойКомнаты;
	Форма.Элементы.ДеревоТоваров.ТекущаяСтрока = НоваяСтрокаТовары.ПолучитьИдентификатор();

	//добавим комнату в материалах
	ЕстьРеквизитЗМ = ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Форма, "ЗаполнениеМатериаловПоЗаказам");
	
	Если НЕ ЕстьРеквизитЗМ ИЛИ Форма.ЗаполнениеМатериаловПоЗаказам Тогда
		НоваяСтрокаМатериалы = Форма.ДеревоМатериалов.ПолучитьЭлементы().Добавить();
		НоваяСтрокаМатериалы.Комната = ИмяНовойКомнаты;
	КонецЕсли;
	
	Форма.РассчитатьИтоговыеПоказателиКлиент();

КонецПроцедуры

Процедура Розница_ПереименоватьКомнату(ПараметрыПереименования) Экспорт
	
	ПослеВводаНовогоНаименованияКомнаты = Новый ОписаниеОповещения("Розница_ПослеВводаНовогоНаименованияКомнаты", ЭтотОбъект, ПараметрыПереименования);
	ПоказатьВводСтроки(ПослеВводаНовогоНаименованияКомнаты, ПараметрыПереименования.СтароеНаименование, "Введите название комнаты");
	
КонецПроцедуры

Процедура Розница_ПослеВводаНовогоНаименованияКомнаты(Результат, Параметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
    //проверим на наличие такого наименования
	ПараметрыПереименования = Новый Структура;
	ПараметрыПереименования.Вставить("НовоеНаименование",		Результат);
	ПараметрыПереименования.Вставить("СтароеНаименование",		Параметры.СтароеНаименование);
	ПараметрыПереименования.Вставить("ИдТекущейСтрокиКомнаты",	Параметры.ИдТекущейСтрокиКомнаты);
	
	ИдИмеющейсяСтрокиКомнаты = 0;
	ЕстьКомната = Ложь;
	СтрокиКомнат = Параметры.Форма.ДеревоТоваров.ПолучитьЭлементы();
	Для каждого СтрокаКомнаты из СтрокиКомнат Цикл
		Если СтрокаКомнаты.Комната = Результат Тогда
			ЕстьКомната = Истина;
			ИдИмеющейсяСтрокиКомнаты = СтрокаКомнаты.ПолучитьИдентификатор();
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	ПараметрыПереименования.Вставить("ИдИмеющейсяСтрокиКомнаты", ИдИмеющейсяСтрокиКомнаты);
	ПараметрыПереименования.Вставить("ЕстьКомната",				 ЕстьКомната);
	ПараметрыПереименования.Вставить("Форма",				 	 Параметры.Форма);
	
	Если ЕстьКомната Тогда
		ПереименоватьКомнатуПодтверждение = Новый ОписаниеОповещения("Розница_ПереименоватьКомнатуПодтверждение", ЭтотОбъект, ПараметрыПереименования);
		ПоказатьВопрос(ПереименоватьКомнатуПодтверждение,"В документе уже есть комната """+Результат+""""+Символы.ПС
		+"Если присвоить такое же наименование, все товары текущей комнаты будут добавлены к существующей."
		+Символы.ПС+"Продолжить?",РежимДиалогаВопрос.ДаНет)
	Иначе
		Розница_ПереименоватьКомнатуПодтверждение(КодВозвратаДиалога.Да, ПараметрыПереименования);
	КонецЕсли;

КонецПроцедуры

Процедура Розница_ПереименоватьКомнатуПодтверждение(Результат, ДополнительныеПараметры) Экспорт
	
    Если НЕ Результат = КодВозвратаДиалога.Да Тогда
        Возврат;
	КонецЕсли;

	Форма = ДополнительныеПараметры.Форма;
	
	Если НЕ ДополнительныеПараметры.ЕстьКомната Тогда
		//товары
		СтрокаКомнаты = Форма.ДеревоТоваров.НайтиПоИдентификатору(ДополнительныеПараметры.ИдТекущейСтрокиКомнаты);	
		СтрокаКомнаты.Комната = ДополнительныеПараметры.НовоеНаименование;
		СтрокиТоваров = СтрокаКомнаты.ПолучитьЭлементы();
		Для каждого СтрокаТовара из СтрокиТоваров Цикл
			СтрокаТовара.Комната = ДополнительныеПараметры.НовоеНаименование;	
		КонецЦикла;
		
		//материалы
		Для Каждого ТекущаяСтрокаДерева Из Форма.ДеревоМатериалов.ПолучитьЭлементы() Цикл
			Если ТекущаяСтрокаДерева.Комната = ДополнительныеПараметры.СтароеНаименование Тогда
				ТекущаяСтрокаДерева.Комната = ДополнительныеПараметры.НовоеНаименование;				
				Для Каждого ТекущаяСтрока Из ТекущаяСтрокаДерева.ПолучитьЭлементы() Цикл
					Если ТекущаяСтрока.Комната = ДополнительныеПараметры.СтароеНаименование Тогда
						ТекущаяСтрока.Комната = ДополнительныеПараметры.НовоеНаименование;
					КонецЕсли;
				КонецЦикла;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	Иначе
		
		//товары
		СтрокаКомнаты = Форма.ДеревоТоваров.НайтиПоИдентификатору(ДополнительныеПараметры.ИдТекущейСтрокиКомнаты);
		СтрокаНовойКомнаты = Форма.ДеревоТоваров.НайтиПоИдентификатору(ДополнительныеПараметры.ИдИмеющейсяСтрокиКомнаты);
		СтрокиТоваров = СтрокаКомнаты.ПолучитьЭлементы();
		Для каждого СтрокаТовара из СтрокиТоваров Цикл
			НоваяСтрокаТовара = СтрокаНовойКомнаты.ПолучитьЭлементы().Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрокаТовара, СтрокаТовара);
			НоваяСтрокаТовара.Комната = ДополнительныеПараметры.НовоеНаименование;	
		КонецЦикла;
		Форма.ДеревоТоваров.ПолучитьЭлементы().Удалить(СтрокаКомнаты);
		Форма.Элементы.ДеревоТоваров.ТекущаяСтрока = ДополнительныеПараметры.ИдИмеющейсяСтрокиКомнаты;
		
		//материалы
		СтрокаКомнатыМатериалов = Неопределено;
		СтрокаНовойКомнатыМатериалов = Неопределено;
		Для Каждого ТекущаяСтрокаДерева Из Форма.ДеревоМатериалов.ПолучитьЭлементы() Цикл
			Если ТекущаяСтрокаДерева.Комната = ДополнительныеПараметры.СтароеНаименование Тогда
				СтрокаКомнатыМатериалов = ТекущаяСтрокаДерева;	
			КонецЕсли;
			Если ТекущаяСтрокаДерева.Комната = ДополнительныеПараметры.НовоеНаименование Тогда
				СтрокаНовойКомнатыМатериалов = ТекущаяСтрокаДерева;
			КонецЕсли;
		КонецЦикла;
		
		Если НЕ СтрокаКомнатыМатериалов = Неопределено И НЕ СтрокаНовойКомнатыМатериалов = Неопределено Тогда			
			Для каждого СтрокаМатериала из СтрокаКомнатыМатериалов.ПолучитьЭлементы() Цикл
				НоваяСтрокаМатериала = СтрокаНовойКомнатыМатериалов.ПолучитьЭлементы().Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрокаМатериала, СтрокаМатериала);
				НоваяСтрокаМатериала.Комната = ДополнительныеПараметры.НовоеНаименование;	
			КонецЦикла;
			Форма.ДеревоМатериалов.ПолучитьЭлементы().Удалить(СтрокаКомнатыМатериалов);
		КонецЕсли;
		
		Форма.РассчитатьИтоговыеПоказателиКлиент();

	КонецЕсли;
	
	Форма.Модифицированность = Истина;

КонецПроцедуры

Процедура Розница_ПеренестиПозициюВДругуюКомнату(Параметры) Экспорт

	Форма = Параметры.Форма;
	СписокКомнат = ПолучитьСписокКомнатПоДереву(Форма.ДеревоТоваров, Параметры.ТекущаяКомната);		
	ПеренестиВДругуюКомнатуПодтверждение = Новый ОписаниеОповещения("Розница_ПеренестиВДругуюКомнатуПодтверждение", ЭтотОбъект, Параметры);
	СписокКомнат.ПоказатьВыборЭлемента(ПеренестиВДругуюКомнатуПодтверждение, "Выберите комнату");
	
КонецПроцедуры 

Процедура Розница_ПеренестиВДругуюКомнатуПодтверждение(ВыбранныйЭлемент, ДополнительныеПараметры) Экспорт
	
	Если ВыбранныйЭлемент = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
    //ПеренестиВДругуюКомнатуПодтверждениеНаСервере(ВыбранныйЭлемент.Значение, ДополнительныеПараметры);
	
	ИмяКомнаты = ВыбранныйЭлемент.Значение;
	Если ИмяКомнаты = Неопределено Тогда
		Возврат;
	КонецЕсли; 
	
	Форма = ДополнительныеПараметры.Форма;
	//ТекущаяСтрока = Форма.ДеревоТоваров.НайтиПоИдентификатору(ДополнительныеПараметры.ИдТекущейСтроки);
	//Если ИмяКомнаты = ТекущаяСтрока.Комната Тогда
	//	Возврат;
	//КонецЕсли;
	
	ЭлементыДерева = Форма.ДеревоТоваров.ПолучитьЭлементы();
	Для Каждого ТекЭлемент из ЭлементыДерева Цикл		
		Если СокрЛП(ТекЭлемент.Комната) = СокрЛП(ИмяКомнаты) Тогда
			СтрокиКомнатыПриемника = ТекЭлемент.ПолучитьЭлементы();
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	МассивСтрок = Новый Массив;
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(МассивСтрок, ДополнительныеПараметры.ВыделенныеСтроки);
	Для каждого ИдТекущейСтроки из МассивСтрок Цикл
		ТекущаяСтрока = Форма.ДеревоТоваров.НайтиПоИдентификатору(ИдТекущейСтроки);
		Если ИмяКомнаты = ТекущаяСтрока.Комната Тогда
			Продолжить;
		КонецЕсли;
	 
		// добавляем новую строку
		УИСтроки = ТекущаяСтрока.УИСтроки;
		НоваяСтрока = СтрокиКомнатыПриемника.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущаяСтрока, , "Комната");
		НоваяСтрока.Комната = ИмяКомнаты;
		ИдНовойСтроки = НоваяСтрока.ПолучитьИдентификатор();		
	
		// удаляем перенесенную	
		РодительКомната     = ТекущаяСтрока.ПолучитьРодителя();	
		РодительКомната.ПолучитьЭлементы().Удалить(ТекущаяСтрока);
	
		// перенесем материалы, относящиеся к товару
		НоваяКомнатаМатериалов = Неопределено;
		СтрокиДереваМатериалов = Форма.ДеревоМатериалов.ПолучитьЭлементы();
		Для Каждого СтрокаКомнаты из СтрокиДереваМатериалов Цикл
			Если СокрЛП(СтрокаКомнаты.Комната) = СокрЛП(ИмяКомнаты) Тогда
				НоваяКомнатаМатериалов = СтрокаКомнаты.ПолучитьЭлементы();
			КонецЕсли;
		КонецЦикла;
		Если НЕ НоваяКомнатаМатериалов = Неопределено Тогда
			//добавляем
			Для Каждого СтрокаКомнаты из СтрокиДереваМатериалов Цикл		
				Если СокрЛП(СтрокаКомнаты.Комната) = СокрЛП(ДополнительныеПараметры.ТекущаяКомната) Тогда
					Для Каждого СтрокаМатериала Из СтрокаКомнаты.ПолучитьЭлементы() Цикл
						Если СтрокаМатериала.УИСтроки = УИСтроки Тогда
							НоваяСтрока = НоваяКомнатаМатериалов.Добавить();
							ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаМатериала, , "Комната");
							НоваяСтрока.Комната = ИмяКомнаты;
						КонецЕсли;
					КонецЦикла;
				КонецЕсли;
			КонецЦикла;
			//удаляем
			Для Каждого СтрокаКомнаты из СтрокиДереваМатериалов Цикл		
				Если СокрЛП(СтрокаКомнаты.Комната) = СокрЛП(ДополнительныеПараметры.ТекущаяКомната) Тогда
					СтрокиМатериалов = СтрокаКомнаты.ПолучитьЭлементы();
					КоличествоСтрокМатериалов = СтрокиМатериалов.Количество();
					//обратный обход для удаления
					Для Индекс = 1 По КоличествоСтрокМатериалов Цикл
						СтрокаМатериала = СтрокиМатериалов[КоличествоСтрокМатериалов-Индекс];
						Если СтрокаМатериала.УИСтроки = УИСтроки Тогда
							
							ИдентификаторСтроки = СтрокаМатериала.ПолучитьИдентификатор();
							ТекущаяСтрокаМатериалов  = Форма.ДеревоМатериалов.НайтиПоИдентификатору(ИдентификаторСтроки);	
							РодительКомната     = ТекущаяСтрокаМатериалов.ПолучитьРодителя();	
							РодительКомната.ПолучитьЭлементы().Удалить(ТекущаяСтрокаМатериалов);
							
						КонецЕсли;
					КонецЦикла;
				КонецЕсли;
			КонецЦикла;				
		КонецЕсли;
	КонецЦикла;
	
	Форма.Модифицированность = Истина;
	
	Форма.РассчитатьИтоговыеПоказателиКлиент();	
	Форма.Элементы.ДеревоТоваров.ТекущаяСтрока = ИдНовойСтроки;
	
КонецПроцедуры

#Область КомандыУстановкиСкидок

Процедура Розница_ИзменитьСкидку(Параметры) Экспорт
	
	УстановитьСкидку = 0;
	ПроцедураПослеВВодаСкидки = Новый ОписаниеОповещения("Розница_ИзменитьСкидкуПослеВводаСкидки", ЭтотОбъект, Параметры);
	ПоказатьВводЗначения(ПроцедураПослеВВодаСкидки, УстановитьСкидку, Параметры.ТекстСообщения);
	
КонецПроцедуры

&НаКлиенте
Процедура Розница_ИзменитьСкидкуПослеВводаСкидки(ЗначениеСкидки, ДополнительныеПараметры) Экспорт
	
	Если ЗначениеСкидки = Неопределено Тогда
		Возврат;
	КонецЕсли;
		
	ЕстьСтрокиСВыполненнымиМонтажами = Ложь;
	
	Предмет  = ДополнительныеПараметры.Предмет;	
	Форма    = ДополнительныеПараметры.Форма;
	ЭтоЗаказ = ДополнительныеПараметры.ЭтоЗаказ;
	
	СтрокиКомнат = Форма.ДеревоТоваров.ПолучитьЭлементы(); 
	Для Каждого СтрокаКомнаты из СтрокиКомнат Цикл
		СтрокиНоменклатуры = СтрокаКомнаты.ПолучитьЭлементы();		
		Для каждого СтрокаНоменклатуры из СтрокиНоменклатуры Цикл
			
			ЭтоПотолок = (СтрокаНоменклатуры.ВидНоменклатуры = ПредопределенноеЗначение("Справочник.ВидыНоменклатуры.Потолок"))
				ИЛИ (СтрокаНоменклатуры.ВидНоменклатуры = ПредопределенноеЗначение("Справочник.ВидыНоменклатуры.Отрез"))
				ИЛИ (СтрокаНоменклатуры.ВидНоменклатуры = ПредопределенноеЗначение("Справочник.ВидыНоменклатуры.ТиповойОтрез")
				ИЛИ (СтрокаНоменклатуры.УчитыватьКакПотолок) // №14690
			);
			
			Если (Предмет = "Товары" И СтрокаНоменклатуры.ВидНоменклатуры = ПредопределенноеЗначение("Справочник.ВидыНоменклатуры.Материал") И НЕ СтрокаНоменклатуры.УчитыватьКакПотолок)
				ИЛИ (Предмет = "Услуги" И СтрокаНоменклатуры.ВидНоменклатуры = ПредопределенноеЗначение("Справочник.ВидыНоменклатуры.Услуга") И НЕ СтрокаНоменклатуры.УчитыватьКакПотолок)
				ИЛИ (Предмет = "Потолок" И ЭтоПотолок)
				ИЛИ (Предмет = "Все") // №14690
			Тогда
				
				ТребуетсяИзменениеСкидки = Истина;
				Если ЭтоЗаказ Тогда
					Если СтрокаНоменклатуры.МонтажСтатус = ПредопределенноеЗначение("Справочник.РезультатыМонтажа.Выполнен") 
						ИЛИ СтрокаНоменклатуры.МонтажСтатус = ПредопределенноеЗначение("Справочник.РезультатыМонтажа.Закрыт") Тогда
						ЕстьСтрокиСВыполненнымиМонтажами = Истина;
						ТребуетсяИзменениеСкидки = Ложь;
					КонецЕсли;
				КонецЕсли;
				
				Если ТребуетсяИзменениеСкидки Тогда
					СтрокаНоменклатуры.ПроцентСкидки = ЗначениеСкидки;					
					
					ОбработкаТабличныхЧастейКлиентСервер.ПересчитатьСуммуРучнойСкидкиВСтрокеТЧ(СтрокаНоменклатуры, "ПроцентСкидки", "СуммаСкидки");
					ОбработкаТабличныхЧастейКлиентСервер.ПересчитатьСуммуСУчетомСкидокВСтрокеТЧ(СтрокаНоменклатуры, Ложь, "СуммаСкидки");
					ОбработкаТабличныхЧастейКлиентСервер.ПересчитатьСуммуПоПрайсуВСтрокеТЧ(СтрокаНоменклатуры);
					ОбработкаТабличныхЧастейКлиентСервер.ПересчитатьСуммуНДСВСтрокеТЧ(СтрокаНоменклатуры, Форма.УчитыватьНДС);
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	Форма.Модифицированность = Истина;	
	
	ВыполнитьОбработкуОповещения(ДополнительныеПараметры.ОповещениеПослеИзмененияСкидки, ЕстьСтрокиСВыполненнымиМонтажами);
	Если ЕстьСтрокиСВыполненнымиМонтажами Тогда
		Сообщить("При установке скидки были пропущены строки по выполненным и закрытым монтажам");
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

Процедура Розница_ЗаполнитьКомнатуПоШаблону(Форма, ЗапретРедактированияЦен) Экспорт
	
	Элементы = Форма.Элементы;
	Объект = Форма.Объект;
	
	ТекущиеДанные = Элементы.ДеревоТоваров.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		ПоказатьОповещениеПользователя("Выберите комнату");
		Возврат;
	КонецЕсли;	
	
	Если ПустаяСтрока(ТекущиеДанные.Комната) Тогда		
		ПоказатьОповещениеПользователя("Выберите комнату");
		Возврат;
	КонецЕсли;
	
	ПараметрыПодбора = Новый Структура;
	ПараметрыПодбора.Вставить("ВидЦены",				Объект.ВидЦен);
	ПараметрыПодбора.Вставить("Валюта",					Объект.Валюта);
	ПараметрыПодбора.Вставить("ЗапретРедактированияЦен",ЗапретРедактированияЦен);
	
	ЕстьРеквизитКонтрагент = ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Объект, "Контрагент");
	Если ЕстьРеквизитКонтрагент Тогда
		ПараметрыПодбора.Вставить("Контрагент",				Объект.Контрагент);
	КонецЕсли;	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Объект, "ДоговорКонтрагента") Тогда
		ПараметрыПодбора.Вставить("ДоговорКонтрагента",		Объект.ДоговорКонтрагента);
	ИначеЕсли ЕстьРеквизитКонтрагент И ЗначениеЗаполнено(Объект.Контрагент) Тогда
		ПараметрыПодбора.Вставить("ДоговорКонтрагента",		ОбщийМодульВызовСервера.ЗначениеРеквизитаОбъекта(Объект.Контрагент, "ОсновнойДоговор"));
	КонецЕсли;
	
	ОткрытьФорму("Справочник.ШаблоныКомнатДляЗаказДоговора.Форма.ФормаПодбора", ПараметрыПодбора, Форма, Форма.УникальныйИдентификатор);
	
КонецПроцедуры

Процедура Розница_ОбработкаВыбораЗаполненияПоШаблону(Форма, ОповещениеЗаполнитьКомнатуПоШаблонуЗавершение, ВыбранноеЗначение) Экспорт
	
	Если Не ЗначениеЗаполнено(ВыбранноеЗначение) Тогда
		Возврат;
	КонецЕсли;
	
	Элементы = Форма.Элементы;
	
	ТекущаяСтрока = Элементы.ДеревоТоваров.ТекущаяСтрока;	
	СтрокаКомнаты = Форма.ДеревоТоваров.НайтиПоИдентификатору(ТекущаяСтрока);
	Если НЕ СтрокаКомнаты.ПолучитьРодителя() = Неопределено Тогда
		СтрокаКомнаты = СтрокаКомнаты.ПолучитьРодителя();
	КонецЕсли;
	СтрокиТоваров = СтрокаКомнаты.ПолучитьЭлементы(); //.Удалить();
	
	Если СтрокиТоваров.Количество() = 0 Тогда
		Розница_ЗаполнитьКомнатуПоШаблонуЗавершение(ОповещениеЗаполнитьКомнатуПоШаблонуЗавершение, ВыбранноеЗначение);
	Иначе
		ТекстВопроса = "Комната не пустая. Очистить комнату перед заполнением?";
		ДополнительныеПараметры = Новый Структура;
		ДополнительныеПараметры.Вставить("СтрокаКомнаты", СтрокаКомнаты);
		ДополнительныеПараметры.Вставить("ВыбранноеЗначение", ВыбранноеЗначение);
		ДополнительныеПараметры.Вставить("ОповещениеЗаполнитьКомнатуПоШаблонуЗавершение", ОповещениеЗаполнитьКомнатуПоШаблонуЗавершение);
		ДополнительныеПараметры.Вставить("Форма", Форма);
		ОписаниеОповещения = Новый ОписаниеОповещения("Розница_ЗаполнитьКомнатуПоШаблонуФрагмент", ЭтотОбъект, ДополнительныеПараметры);
		ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНетОтмена);
	КонецЕсли;
	
КонецПроцедуры

Процедура Розница_ЗаполнитьКомнатуПоШаблонуФрагмент(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		// очищаем строки товаров в выбранной комнате
		СтрокиТоваров = ДополнительныеПараметры.СтрокаКомнаты.ПолучитьЭлементы();
		КоличествоСтрок = СтрокиТоваров.Количество();
		Для Индекс = 1 по КоличествоСтрок Цикл 
			СтрокиТоваров.Удалить(СтрокиТоваров[КоличествоСтрок - Индекс]);
		КонецЦикла;
		ДополнительныеПараметры.Форма.Элементы.ДеревоТоваров.ТекущаяСтрока = ДополнительныеПараметры.СтрокаКомнаты.ПолучитьИдентификатор();		
	ИначеЕсли Результат = КодВозвратаДиалога.Нет Тогда
		// не очищаем	
	Иначе
		Возврат;
	КонецЕсли;
	
	Розница_ЗаполнитьКомнатуПоШаблонуЗавершение(ДополнительныеПараметры.ОповещениеЗаполнитьКомнатуПоШаблонуЗавершение, ДополнительныеПараметры.ВыбранноеЗначение);
	
КонецПроцедуры

Процедура Розница_ЗаполнитьКомнатуПоШаблонуЗавершение(ОповещениеЗаполнитьКомнатуПоШаблонуЗавершение, ВыбранноеЗначение)
	
	ВыполнитьОбработкуОповещения(ОповещениеЗаполнитьКомнатуПоШаблонуЗавершение, ВыбранноеЗначение);
	//ОбработкаВыбораПодборНаКлиенте(ВыбранноеЗначение);
		
КонецПроцедуры

&НаКлиенте
Процедура Розница_ТоварыСуммаПриИзменении(Форма, СтрокаТабличнойЧасти, ЭтоДерево = Истина) Экспорт
	
	//корневые строки редактировать нельзя
	Если ЭтоДерево И СтрокаТабличнойЧасти.ПолучитьРодителя() = Неопределено Тогда
		СтрокаТабличнойЧасти.Сумма = 0;
		Возврат;
	КонецЕсли;	
	
	СтрокаТабличнойЧасти.Бесплатно = Ложь;
	
	//++ #15423	
	//Если НЕ СтрокаТабличнойЧасти.Количество = 0 Тогда
	//	Если СтрокаТабличнойЧасти.ПроцентСкидки = 100 Тогда
	//		СтрокаТабличнойЧасти.Цена = 0;
	//	ИначеЕсли НЕ СтрокаТабличнойЧасти.ПроцентСкидки = 0 Тогда
	//		СтрокаТабличнойЧасти.Цена = СтрокаТабличнойЧасти.Сумма / ((1 - СтрокаТабличнойЧасти.ПроцентСкидки / 100) * СтрокаТабличнойЧасти.Количество);
	//	Иначе
	//		СтрокаТабличнойЧасти.Цена = СтрокаТабличнойЧасти.Сумма / СтрокаТабличнойЧасти.Количество;
	//	КонецЕсли;
	//КонецЕсли;
	ОбработкаТабличныхЧастейКлиентСервер.ПересчитатьПроцентРучнойСкидкиВСтрокеТЧ(СтрокаТабличнойЧасти, "ПроцентСкидки", "СуммаСкидки");
	Если НЕ СтрокаТабличнойЧасти.Количество = 0 Тогда
		СтрокаТабличнойЧасти.Цена = (СтрокаТабличнойЧасти.Сумма + СтрокаТабличнойЧасти.СуммаСкидки) / СтрокаТабличнойЧасти.Количество;
	КонецЕсли;	
	//-- #15423
	
	ОбработкаТабличныхЧастейКлиент.ПересчитатьСуммуНДСВСтрокеТЧ(СтрокаТабличнойЧасти, Форма.УчитыватьНДС);
	Форма.РассчитатьИтоговыеПоказателиКлиент(); 
	
КонецПроцедуры

#КонецОбласти

#Область Штрихкодирование

Функция ПолучитьНоменклатуруПоШтрихКоду(Штрихкод) Экспорт
	
	СтруктураТовара = Новый Структура;
	СтруктураТовара.Вставить("Номенклатура", 				ПредопределенноеЗначение("Справочник.Номенклатура.ПустаяСсылка"));
	СтруктураТовара.Вставить("ХарактеристикаНоменклатуры", 	ПредопределенноеЗначение("Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка"));
	СтруктураТовара.Вставить("СерияНоменклатуры", 			ПредопределенноеЗначение("Справочник.СерииНоменклатуры.ПустаяСсылка"));
	СтруктураТовара.Вставить("ЕдиницаИзмерения", 			ПредопределенноеЗначение("Справочник.КлассификаторЕдиницИзмерения.ПустаяСсылка"));
	СтруктураТовара.Вставить("Штрихкод", 					"");
	
	Если Штрихкод.Количество() = 0 Тогда
		Возврат ШтрихКод;
	КонецЕсли;
	 
	СтруктураТовара.Вставить("Штрихкод", Штрихкод[0].Штрихкод);
	
	ОбщийМодульВызовСервера.ЗаполнитьСтруктуруТовараПоШтрихКоду(СтруктураТовара);
	
	Возврат СтруктураТовара;	
	
КонецФункции

Процедура ОткрытьФормуПечатиШК(ЗначениеКода, ТипШтрихкода = Неопределено, ЗаголовокКода="") Экспорт
	
	КлючУникальности = Строка(Новый УникальныйИдентификатор);
	
	ПараметрыОткрытия = Новый Структура("ИмяМенеджераПечати,ИменаМакетов,ПараметрКоманды,ПараметрыПечати");
	ПараметрыОткрытия.ПараметрКоманды = Новый Массив;
	ПараметрыОткрытия.ПараметрыПечати = Новый Структура;
	ПараметрыОткрытия.Вставить("ПотолкиПечатьШтрихкода", Истина);
	//++ №13526 по умолчанию EAN13
	//ПараметрыОткрытия.Вставить("ПотолкиТипШтрихкода", ?(ТипШтрихкода = Неопределено, ПредопределенноеЗначение("Перечисление.ТипыШтрихкодов.Code128"), ТипШтрихкода));
	ПараметрыОткрытия.Вставить("ПотолкиТипШтрихкода", ?(ТипШтрихкода = Неопределено, ПредопределенноеЗначение("Перечисление.ТипыШтрихкодов.EAN13"), ТипШтрихкода));
	//-- №13526
	ПараметрыОткрытия.Вставить("ПотолкиЗначениеКода", ЗначениеКода);
	ПараметрыОткрытия.Вставить("ПотолкиЗаголовокКода", ЗаголовокКода);
	
	ОткрытьФорму("ОбщаяФорма.ПечатьДокументов", ПараметрыОткрытия, , КлючУникальности);
	
КонецПроцедуры
	
#КонецОбласти

#Область Розница

Функция СоздатьЗаказКлиента(Команда) Экспорт
	
	Если Команда.Имя = "СоздатьЗаказДоговор" Тогда
		ВидЗаказа = ПредопределенноеЗначение("Справочник.ВидыЗаказДоговоров.Договор");
	ИначеЕсли Команда.Имя = "СоздатьЗаказНаПродажу" Тогда
		ВидЗаказа = ПредопределенноеЗначение("Справочник.ВидыЗаказДоговоров.Продажа");
	ИначеЕсли Команда.Имя = "СоздатьЗаказНаРекламацию" Тогда
