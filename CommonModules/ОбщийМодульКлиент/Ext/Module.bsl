Процедура ОбработкаСобытияАдресАвтоПодбор(Форма, ИдентификаторУлицы, ИдентификаторНаселенногоПункта, Текст, ДанныеВыбора, Ожидание, СтандартнаяОбработка) Экспорт
	
	Если Ожидание = 0 Тогда
		// Формирование списка быстрого выбора, стандартную обработку не надо трогать.
		Возврат;
	КонецЕсли;
	
	Если СтрДлина(Текст) < 3 ИЛИ НЕ ЗначениеЗаполнено(ИдентификаторНаселенногоПункта) Тогда 
		// Нет вариантов, список пуст, стандартную обработку не надо трогать.
		Возврат;
	КонецЕсли;
	
	ЧислоВхождений = СтрЧислоВхождений(Текст, ",");
	
	Если ЧислоВхождений = 0 Тогда
		//запятых нет, предлагаем улицы
		
		//#17014 переделываем на "стандарт" классификатора
		
		////улица уже могла быть сохранена в виде строки "ул Название". Разделяем строку на значения, разделитель - пробел. пытаемся найти улицу по второму слову, если оно есть, иначе - по первому
		//ИскомаяСтрока = Текст;
		//СписокСлов = СтрРазделить(Текст, " ", ложь);
		//Если СписокСлов.Количество() > 1 Тогда
		//	Для НомерПозиции = 1 По СписокСлов.Количество()-1 Цикл
		//		ИскомаяСтрока = ИскомаяСтрока + " " + СокрЛП(СписокСлов[НомерПозиции]);
		//	КонецЦикла;
		//	ИскомаяСтрока = СокрЛП(ИскомаяСтрока);
		//ИначеЕсли СписокСлов.Количество() > 0 Тогда
		//	ИскомаяСтрока = СокрЛП(СписокСлов[0]);
		//КонецЕсли;
		//
		//СтандартнаяОбработка = Ложь;
		//
		//КодГорода = Форма.КодГорода;
		//КодНасПункта = Форма.КодНасПункта;
		//КодСубъектаРФ = Форма.КодСубъектаРФ;
		//ИдентификаторРодителя = Форма.ИдентификаторРодителя;
		//
		//Если ЭтоВыезд И Форма.Объект.АдресВыездаОтличаетсяОтАдресаЛида Тогда
		//	
		//	КодГорода = Форма.КодГородаВыезда;
		//	КодНасПункта = Форма.КодНасПунктаВыезда;
		//	КодСубъектаРФ = Форма.КодСубъектаРФВыезда;
		//	ИдентификаторРодителя = Форма.ИдентификаторРодителяВыезда;
		//	
		//КонецЕсли;
		//
		//СписокУлиц = ОбщийМодульВызовСервера.ПолучитьСписокУлицПоЧастиНаименования(ИскомаяСтрока, КодГорода, КодНасПункта, КодСубъектаРФ, ИдентификаторРодителя);
		//Если НЕ СписокУлиц.Количество() = 0 Тогда
		//	ДанныеВыбора = СписокУлиц;
		//КонецЕсли;
		УлицаАвтоПодбор(ИдентификаторНаселенногоПункта, Текст, ДанныеВыбора, СтандартнаяОбработка);
		
	ИначеЕсли ЧислоВхождений = 1 
		ИЛИ (ЧислоВхождений = 2 И СтрНайти(НРег(Текст), "дом") = 0 И СтрНайти(НРег(Текст), "квартира") = 0 И СтрНайти(НРег(Текст), "кв.") = 0) Тогда		
		//есть одна запятая или 2 запятые (но не указан дом, улица с микрорайоном), предлагаем дома
		СтандартнаяОбработка = Ложь;
		ПолныйСписокДомов = ОбщийМодульВызовСервера.СписокАвтоподбораДомов(ИдентификаторУлицы);
		Если НЕ ПолныйСписокДомов.Количество() = 0 Тогда
			ДанныеВыбора = ПолныйСписокДомов;
		КонецЕсли;
	Иначе
		//слишком много запятых. ничего не предлагаем
		Возврат;
	КонецЕсли;
	
