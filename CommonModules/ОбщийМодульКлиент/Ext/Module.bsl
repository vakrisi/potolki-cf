// Ищем элемент дерева по идентификатору и путь к элементу в дереве сохраняем в соответсвии "ВеткиДерева"
// Идентификатор - то что ищем в дереве
// Элемент       - дерево значений или ветка элементов где ищем
Функция ПолучитьВетвьДоЭлемента(Идентификатор, Элемент, Уровень = 0, ВеткиДерева = Неопределено) Экспорт
	Если ВеткиДерева = Неопределено Тогда
		ВеткиДерева = Новый Соответствие;
	КонецЕсли;	
	ЭлементыДерева=Элемент.ПолучитьЭлементы();
	Для инд=0 по ЭлементыДерева.Количество()-1 Цикл
		Если Идентификатор = ЭлементыДерева[инд].ПолучитьИдентификатор() Тогда
			ВеткиДерева.Вставить(Уровень,инд);
			Возврат ВеткиДерева;
		КонецЕсли;
		Если ПолучитьВетвьДоЭлемента(Идентификатор, ЭлементыДерева[инд], Уровень+1, ВеткиДерева) <> Ложь  Тогда
			ВеткиДерева.Вставить(Уровень,инд);
			Возврат ВеткиДерева;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

// Получаем идентификатор строки в дереве по полученной функцией "ПолучитьВетвьДоЭлемента" ветке
Функция ПолучитьидентификаторПоВетке(ЗНАЧ Элемент, ВеткиДерева) Экспорт
	ЭлементыДерева=Элемент.ПолучитьЭлементы();
	Для Уровень=0 По 9999 Цикл
	     ИндексСтроки = ВеткиДерева.Получить(Уровень);
		 Если ИндексСтроки <> Неопределено Тогда
			 Идентификатор = ЭлементыДерева[ИндексСтроки].ПолучитьИдентификатор();	
			 ЭлементыДерева=ЭлементыДерева[ИндексСтроки].ПолучитьЭлементы();
		 Иначе	 
			 Возврат Идентификатор;
		 КонецЕсли;	 
	КонецЦикла;	
КонецФункции


#Область ФункцииСопутствующейНоменклатуры

Функция ПолучитьСвязанныеСопутствующиеТоварыПоВыделеннымСтрокам(ЭлементыДеревоТоваров, ДеревоТоваров) Экспорт
	
	МассивСвязанных = Новый Массив;
	ВыбранныеСтроки = ЭлементыДеревоТоваров.ВыделенныеСтроки;
	
	Для Каждого ВыделеннаяСтрока Из ЭлементыДеревоТоваров.ВыделенныеСтроки Цикл
		ТекущиеДанные = ДеревоТоваров.НайтиПоИдентификатору(ВыделеннаяСтрока);
		
		РодительскийЭлемент = ТекущиеДанные.ПолучитьРодителя();		 
		Если РодительскийЭлемент = Неопределено Тогда   // Это комната
			ПодчиненныеСтроки = ТекущиеДанные.ПолучитьЭлементы();
			Для каждого СтрокаТовара из ПодчиненныеСтроки Цикл
				СтрокаКомнаты = СтрокаТовара.ПолучитьРодителя();		 
				СтрокиТоваров = СтрокаКомнаты.ПолучитьЭлементы();
				НайтиСвязанныеСтрокиПоСопуствующимТоварам(СтрокиТоваров, ВыбранныеСтроки, СтрокаТовара.УИСтроки, МассивСвязанных);
			КонецЦикла;		
		Иначе		 
			СтрокиТоваров = РодительскийЭлемент.ПолучитьЭлементы();
			НайтиСвязанныеСтрокиПоСопуствующимТоварам(СтрокиТоваров, ВыбранныеСтроки, ТекущиеДанные.УИСтроки, МассивСвязанных);
		КонецЕсли;		
		
		//Если ТекущиеДанные.ПолучитьРодителя() = Неопределено Тогда
		//	// строка комнаты
		//	//Продолжить;
		//	Возврат МассивСвязанных;
		//КонецЕсли;
		// СтрокаКомнаты = ТекущиеДанные.ПолучитьРодителя();		 
		//СтрокиТоваров = СтрокаКомнаты.ПолучитьЭлементы();
		//НайтиСвязанныеСтрокиПоСопуствующимТоварам(СтрокиТоваров, ВыбранныеСтроки, ТекущиеДанные.УИСтроки, МассивСвязанных);
	КонецЦикла;
	Возврат МассивСвязанных;
	
КонецФункции

Процедура НайтиСвязанныеСтрокиПоСопуствующимТоварам(СтрокиТоваров, ВыбранныеСтроки, УИСтроки, МассивСвязанных)
	
	Для Каждого СтрокаТовара Из СтрокиТоваров Цикл
		Если СтрокаТовара.УИСтрокиРодителя = УИСтроки
			И МассивСвязанных.Найти(СтрокаТовара.ПолучитьИдентификатор()) = Неопределено 
			// проверяем, что найденная строка нет среди удаляемых пользователем
			И ВыбранныеСтроки.Найти(СтрокаТовара.ПолучитьИдентификатор()) = Неопределено
			Тогда
			МассивСвязанных.Добавить(СтрокаТовара.ПолучитьИдентификатор());
			НайтиСвязанныеСтрокиПоСопуствующимТоварам(СтрокиТоваров, ВыбранныеСтроки, СтрокаТовара.УИСтроки, МассивСвязанных)
		КонецЕсли; 			
	КонецЦикла;
	
КонецПроцедуры

Процедура УдалитьСопутствующиеТовары(ДеревоТоваров, МассивСопутстующихТоваровНаУдаление) Экспорт
	
	Для Каждого ИдентификаторСтроки Из МассивСопутстующихТоваровНаУдаление Цикл
		ЭлементКомнаты = ДеревоТоваров.НайтиПоИдентификатору(ИдентификаторСтроки);
		Если ЭлементКомнаты = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Комната = ЭлементКомнаты.ПолучитьРодителя();
		СтрокиНоменклатурыКомнаты = Комната.ПолучитьЭлементы();
		СтрокиНоменклатурыКомнаты.Удалить(ЭлементКомнаты);
	КонецЦикла;
	
КонецПроцедуры

Функция ИзменитьКоличествоСопутствущихТоваров(ДеревоТоваров, Номенклатура, Характеристика, УИСтроки, Количество, ИдКомнаты, ИзмененныеСтроки = Неопределено) Экспорт
	
	Если ИзмененныеСтроки = Неопределено Тогда
		ИзмененныеСтроки = Новый Массив;
	КонецЕсли;	
	СтрокаКомнаты = ДеревоТоваров.НайтиПоИдентификатору(ИдКомнаты);	
	СтрокиНоменклатурыКомнаты = СтрокаКомнаты.ПолучитьЭлементы();
	
	Позиция = Новый Структура;
	Позиция.Вставить("Номенклатура",								Номенклатура);
	Позиция.Вставить("ХарактеристикаНоменклатуры",		Характеристика);
	Позиция.Вставить("УИСтроки",										УИСтроки);
	Позиция.Вставить("Количество",									Количество);
	ТаблицаСопутствующейНоменклатуры = СопутствующиеТоварыВызовСервера.ПодборСопутствующейНоменклатурыНаСервере(Позиция);
	
	Для Каждого СтрокаТовара Из СтрокиНоменклатурыКомнаты Цикл
		ТекущийРодитель = СтрокаТовара.УИСтрокиРодителя;
		Для Каждого Запись из ТаблицаСопутствующейНоменклатуры Цикл
			Если СтрокаТовара.УИСтрокиРодителя = Запись.УИСтрокиРодителя
				И СтрокаТовара.Номенклатура = Запись.Номенклатура
				И СтрокаТовара.ХарактеристикаНоменклатуры = Запись.Характеристика Тогда 
				НовыйУИ = СтрокаТовара.УИСтроки;
				СтарыйУИ = Запись.УИСтроки;
				Для Каждого СтрокаКорректировкиУИ Из ТаблицаСопутствующейНоменклатуры Цикл  // приводим в соответсвие УИ
					Если СтрокаКорректировкиУИ.УИСтроки = СтарыйУИ Тогда
						СтрокаКорректировкиУИ.УИСтроки = НовыйУИ;
					КонецЕсли;	
					Если СтрокаКорректировкиУИ.УИСтрокиРодителя = СтарыйУИ Тогда
						СтрокаКорректировкиУИ.УИСтрокиРодителя = НовыйУИ;
					КонецЕсли;	
				КонецЦикла;
			КонецЕсли;	
		КонецЦикла;
	КонецЦикла;	
	
	Для Каждого Запись из ТаблицаСопутствующейНоменклатуры Цикл
		Для Каждого СтрокаТовара Из СтрокиНоменклатурыКомнаты Цикл
			Если СтрокаТовара.УИСтроки = Запись.УИСтроки И СтрокаТовара.Номенклатура = Запись.Номенклатура  И СтрокаТовара.ХарактеристикаНоменклатуры = Запись.Характеристика Тогда
				СтрокаТовара.Количество = Запись.Количество;
				ИзмененныеСтроки.Добавить(СтрокаТовара);
			КонецЕсли; 			
		КонецЦикла;
	КонецЦикла;
		
	Возврат ИзмененныеСтроки;
	
КонецФункции

Функция ПолучитьИдентификаторПоУИстроки(ДеревоТоваров, УИСтроки) Экспорт
	СтрокиКорня = ДеревоТоваров.ПолучитьЭлементы();
	Для каждого Строка Из СтрокиКорня Цикл
		СтрокиНоменклатуры = Строка.ПолучитьЭлементы();
		Для Каждого СтрокаНоменклатуры Из СтрокиНоменклатуры Цикл
			Если СтрокаНоменклатуры.УИСТроки = УИСтроки Тогда
				Возврат  СтрокаНоменклатуры.ПолучитьИдентификатор();
			КонецЕсли;	
		КонецЦикла;   	   
	КонецЦикла;   
КонецФункции


