Процедура СформироватьДанныеВыбораВидаИсполнителяПоРеализации(ДанныеВыбора, Текст="")
	
	ПредставлениеЭлемента = Строка(ПредопределенноеЗначение("Справочник.ВидыИсполнителей.МенеджерКонтрагента"));
	Если ПустаяСтрока(Текст) ИЛИ СтрНайти(ВРег(ПредставлениеЭлемента), ВРег(Текст)) Тогда
		ДанныеВыбора.Добавить(ПредопределенноеЗначение("Справочник.ВидыИсполнителей.МенеджерКонтрагента"), ПредставлениеЭлемента);
	КонецЕсли;
	
	ПредставлениеЭлемента = Строка(ПредопределенноеЗначение("Справочник.ВидыИсполнителей.АвторВЗаказеПокупателя"));
	Если ПустаяСтрока(Текст) ИЛИ СтрНайти(ВРег(ПредставлениеЭлемента), ВРег(Текст)) Тогда
		ДанныеВыбора.Добавить(ПредопределенноеЗначение("Справочник.ВидыИсполнителей.АвторВЗаказеПокупателя"), ПредставлениеЭлемента);
	КонецЕсли;
	
	ПредставлениеЭлемента = Строка(ПредопределенноеЗначение("Справочник.ВидыИсполнителей.АвторВРеализации"));
	Если ПустаяСтрока(Текст) ИЛИ СтрНайти(ВРег(ПредставлениеЭлемента), ВРег(Текст)) Тогда
		ДанныеВыбора.Добавить(ПредопределенноеЗначение("Справочник.ВидыИсполнителей.АвторВРеализации"), ПредставлениеЭлемента);
	КонецЕсли;
	
	ПредставлениеЭлемента = Строка(ПредопределенноеЗначение("Справочник.ВидыИсполнителей.МенеджерВЗаказеПокупателя"));	
	Если ПустаяСтрока(Текст) ИЛИ СтрНайти(ВРег(ПредставлениеЭлемента), ВРег(Текст)) Тогда
		ДанныеВыбора.Добавить(ПредопределенноеЗначение("Справочник.ВидыИсполнителей.МенеджерВЗаказеПокупателя"), ПредставлениеЭлемента);
	КонецЕсли;
	
	ПредставлениеЭлемента = Строка(ПредопределенноеЗначение("Справочник.ВидыИсполнителей.МенеджерВРеализации"));	
	Если ПустаяСтрока(Текст) ИЛИ СтрНайти(ВРег(ПредставлениеЭлемента), ВРег(Текст)) Тогда
		ДанныеВыбора.Добавить(ПредопределенноеЗначение("Справочник.ВидыИсполнителей.МенеджерВРеализации"), ПредставлениеЭлемента);
	КонецЕсли;
	
КонецПроцедуры

Процедура ВыработкаВыбор(Элемент, Поле, СтандартнаяОбработка) Экспорт
	
	Если Поле.Имя = "ВыработкаДокументУСВ" Тогда
		СтандартнаяОбработка = Ложь;
		Если ЗначениеЗаполнено(Элемент.ТекущиеДанные.ДокументУСВ) Тогда
			ПоказатьЗначение(, Элемент.ТекущиеДанные.ДокументУСВ);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Процедура ВыработкаПлановаяВыбор(Элемент, Поле, СтандартнаяОбработка) Экспорт
	
	Если Поле.Имя = "ВыработкаПлановаяДокументУСВ" Тогда
		СтандартнаяОбработка = Ложь;
		Если ЗначениеЗаполнено(Элемент.ТекущиеДанные.ДокументУСВ) Тогда
			ПоказатьЗначение(, Элемент.ТекущиеДанные.ДокументУСВ);
		КонецЕсли;	
	КонецЕсли;
	
КонецПроцедуры

