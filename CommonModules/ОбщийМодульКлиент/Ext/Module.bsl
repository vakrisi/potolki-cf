//++ №11768 для версии 2.8.0.$a производится ручная обработка
Функция ЕстьОбъектыКОбработкеВерсии(Версия, ВыборочныеОбъектыКОбработке) Экспорт
	
	Для Каждого ТекущаяСтрока Из ВыборочныеОбъектыКОбработке Цикл
		Если ТекущаяСтрока.ВерсияПрограммы = Версия Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

Процедура ВыполнитьОбработку_2_8_0_Sa(Версия, ВерсияПрограммыЧисло, ДокументСсылка, ДополнительныеПараметры)
	
	ИнформацияПоСвязке = ОбщийМодульВызовСервера.ПолучитьИнформациюПоСвязкеЗамераЛидаИЗаказДоговора(ДокументСсылка);
	
	Если ИнформацияПоСвязке.УказанЗамер И ИнформацияПоСвязке.ЗамерщикСовпадает Тогда
		
		// убираем из обработки
		ОбщийМодульВызовСервера.ЗафиксироватьУспешнуюОбработку(Версия, ВерсияПрограммыЧисло, ДокументСсылка, Ложь);
		ДополнительныеПараметры.Форма.Прочитать();
		Возврат;
		
	ИначеЕсли НЕ ИнформацияПоСвязке.УказанЗамер Или НЕ ИнформацияПоСвязке.ЗамерщикСовпадает Тогда
		
		ТекстВопроса = "Внимание! В заказ-договоре не указан замер и/или замерщик не совпадает с данными замера, считать эти данные верными?";
		
		СтруктураПараметров = новый Структура;
		СтруктураПараметров.Вставить("Форма", ДополнительныеПараметры.Форма);
		СтруктураПараметров.Вставить("Версия", Версия);
		СтруктураПараметров.Вставить("ВерсияПрограммыЧисло", ВерсияПрограммыЧисло);
		СтруктураПараметров.Вставить("ДокументСсылка", ДокументСсылка);
		
		ОписаниеОповещения = новый ОписаниеОповещения("ПослеВопросаОКорректностиДанныхПоЗамеруВЗаказДоговоре", ОбщийМодульКлиент, СтруктураПараметров);
		
		ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПослеВопросаОКорректностиДанныхПоЗамеруВЗаказДоговоре(Ответ, ДополнительныеПараметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Да Тогда
		
		ОбщийМодульВызовСервера.ЗафиксироватьУспешнуюОбработку(ДополнительныеПараметры.Версия, ДополнительныеПараметры.ВерсияПрограммыЧисло, ДополнительныеПараметры.ДокументСсылка, Ложь);
		ДополнительныеПараметры.Форма.Прочитать();
		
	КонецЕсли;
	
КонецПроцедуры
