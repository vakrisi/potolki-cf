
#Область ПроцедурыЗаписиДокументоа

Процедура ПроверитьИПровестиДокумент(Параметры, ПроверятьМодифицированность = Ложь) Экспорт
	
	Форма  = Параметры.Форма;
	Объект = Форма.Объект;
	
	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) 
		ИЛИ НЕ Объект.Проведен
		ИЛИ (ПроверятьМодифицированность И Форма.Модифицированность) Тогда
		
		ОписаниеОповещения = Новый ОписаниеОповещения("ОбработчикВопросаОНеобходимостиПроведенияДокумента", ЭтотОбъект, Параметры);
		ТекстВопроса = "Для продолжения документ следует провести. 
						|Провести документ?";
		ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
		
		Возврат;
	КонецЕсли;
	
	ВыполнитьОбработкуОповещения(Параметры.ДействиеПослеЗаписи, Параметры);
		
КонецПроцедуры

Процедура ОбработчикВопросаОНеобходимостиПроведенияДокумента(Результат, ДополнительныеПараметры) Экспорт
	
	Если НЕ Результат = КодВозвратаДиалога.Да Тогда
		Возврат;	
	КонецЕсли;
	
	ПараметрыЗаписи = Новый Структура;
	ПараметрыЗаписи.Вставить("РежимЗаписи", РежимЗаписиДокумента.Проведение);
	
	ОчиститьСообщения();
	Форма = ДополнительныеПараметры.Форма;
	РезультатЗаписиДокумента = Форма.Записать(ПараметрыЗаписи);
	
	Если РезультатЗаписиДокумента И ДополнительныеПараметры.Свойство("ДействиеПослеЗаписи") Тогда
		//ДействиеПослеЗаписи = Новый ОписаниеОповещения("ДействиеПослеЗаписи", Форма);
		ВыполнитьОбработкуОповещения(ДополнительныеПараметры.ДействиеПослеЗаписи, ДополнительныеПараметры);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область РаботаСРегистромИсторииДокумента

// Процедура - ДобавитьЗаписьВИсториюДокумента
//
// Параметры:
//  Форма			 - 	 Управляемая форма 
//  СтруктураИстории - 	 Структура("ИмяРеквизита, ОбработчикОповещения") 
//
Процедура ДобавитьЗаписьВИсториюДокумента(Форма, СтруктураИстории) Экспорт
		
	РеквизитФормы = Форма[СтруктураИстории.ИмяРеквизита];
	
	Если ПустаяСтрока(РеквизитФормы) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Поле ""Запись в историю"" не заполнено",, СтруктураИстории.ИмяРеквизита);
		Возврат;
	КонецЕсли;
	
	Объект = Форма.Объект;
	
	ОписаниеОповещенияЗавершение = Новый ОписаниеОповещения("ДобавитьЗаписьВИсториюДокументаЗавершение", Форма);
	
	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) ИЛИ НЕ Объект.Проведен Тогда
		ДополнительныеПараметры = Новый Структура;
		ДополнительныеПараметры.Вставить("Форма", Форма);
		ДополнительныеПараметры.Вставить("ДействиеПослеЗаписи", ОписаниеОповещенияЗавершение);
		ДополнительныеПараметры.Вставить("ТекстЗаписиИстории", РеквизитФормы);
		ОписаниеОповещения = Новый ОписаниеОповещения("ОбработчикВопросаОНеобходимостиПроведенияДокумента", ЭтотОбъект, ДополнительныеПараметры);
		ТекстВопроса = "Для продолжения документ следует провести. 
						|Провести документ?";
		ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
		
		Возврат;
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ТекстЗаписиИстории", РеквизитФормы);		
	ВыполнитьОбработкуОповещения(ОписаниеОповещенияЗавершение, ДополнительныеПараметры);
		
КонецПроцедуры

#КонецОбласти

#Область ПредпросмотрИРаботаСФайлами

Процедура ПредпросмотрФайла(АдресФайла, Знач РасширениеФайла, РеквизитФормыДляВывода, ЭлементФормыДляВывода) Экспорт
	
	ЭлементФормыДляВывода.Вид = ВидПоляФормы.ПолеHTMLДокумента;
	
	// №7253
	Если АдресФайла = Неопределено Тогда
		РеквизитФормыДляВывода = "";
		Возврат;
	КонецЕсли;

	//ВременноеИмяФайла = ПолучитьИмяВременногоФайла(РасширениеФайла);
	
	ВременноеИмяФайла = КаталогВременныхФайлов() + Строка(Новый УникальныйИдентификатор()) + "." + РасширениеФайла;
	
	Результат = ПолучитьФайл(АдресФайла, ВременноеИмяФайла, Ложь);
	Если Результат Тогда	
		ОбъектФайл = Новый Файл(ВременноеИмяФайла);
		РасширениеФайла = НРег(ОбъектФайл.Расширение);
		
		Если РасширениеФайла = ".png"  
			ИЛИ РасширениеФайла = ".bmp"  
			ИЛИ РасширениеФайла = ".jpg"  
			ИЛИ РасширениеФайла = ".jpeg" 
			ИЛИ РасширениеФайла = ".gif"  
			ИЛИ РасширениеФайла = ".tiff"  
			ИЛИ РасширениеФайла = ".wmf" Тогда
		
			ОбъектКартинка = Новый Картинка(ВременноеИмяФайла);
			Если НЕ ОбъектКартинка.Формат() = ФорматКартинки.НеизвестныйФормат Тогда
				//РеквизитФормыДляВывода = "<HTML><img src=""file:\\" + ВременноеИмяФайла + """ width=""100%"" height=""100%""></img></HTML>";		
				ЭлементФормыДляВывода.Вид = ВидПоляФормы.ПолеКартинки;
				ЭлементФормыДляВывода.РазмерКартинки = РазмерКартинки.АвтоРазмер;
				РеквизитФормыДляВывода = АдресФайла;
			КонецЕсли;
			
		ИначеЕсли РасширениеФайла = ".txt" ИЛИ РасширениеФайла = ".ini" Тогда
			ЭлементФормыДляВывода.Вид = ВидПоляФормы.ПолеТекстовогоДокумента;
			ТекстовыйФайл = Новый ТекстовыйДокумент;
			ТекстовыйФайл.Прочитать(ВременноеИмяФайла);
			РеквизитФормыДляВывода = ТекстовыйФайл.ПолучитьТекст();

		ИначеЕсли РасширениеФайла = ".doc" ИЛИ РасширениеФайла = ".docx" Тогда
			Word = ПолучитьCOMОбъект("", "Word.Application");
			Document = Word.Documents.Open(ВременноеИмяФайла);
			
			ВременноеИмяФайлаCOM = КаталогВременныхФайлов() + Строка(Новый УникальныйИдентификатор()) + ".html";
			
			//ВременноеИмяФайлаCOM = ПолучитьИмяВременногоФайла(".html");
			Document.SaveAs(ВременноеИмяФайлаCOM, 8);
			Word.Quit();
			Word = Неопределено;
			РеквизитФормыДляВывода = ВременноеИмяФайлаCOM;
			
		ИначеЕсли РасширениеФайла = ".xls" ИЛИ РасширениеФайла = ".xlsx" Тогда
			Excel = ПолучитьCOMОбъект("", "Excel.Application");
			WorkBook = Excel.WorkBooks.Open(ВременноеИмяФайла);
			
			ВременноеИмяФайлаCOM = КаталогВременныхФайлов() + Строка(Новый УникальныйИдентификатор()) + ".html";
			
			//ВременноеИмяФайлаCOM = ПолучитьИмяВременногоФайла(".html");
			WorkBook.SaveAs(ВременноеИмяФайлаCOM, 44);
			Excel.Quit();
			Excel = Неопределено;
			РеквизитФормыДляВывода = ВременноеИмяФайлаCOM; 
			
		ИначеЕсли РасширениеФайла = ".pdf" ИЛИ РасширениеФайла = ".xml" ИЛИ РасширениеФайла = ".html" Тогда
			РеквизитФормыДляВывода = ВременноеИмяФайла;
			
		Иначе
			//РеквизитФормыДляВывода = "";
			ЭлементФормыДляВывода.Вид = ВидПоляФормы.ПолеКартинки;
			ЭлементФормыДляВывода.РазмерКартинки = РазмерКартинки.АвтоРазмер;
			РеквизитФормыДляВывода = ПоместитьВоВременноеХранилище(БиблиотекаКартинок.ПросмотрНедоступен);
		КонецЕсли;
	Иначе
		РеквизитФормыДляВывода = "";
	КонецЕсли;

КонецПроцедуры

Процедура ПослеВыбораСсылкиДляПрикрепленияФайла(ВыбранныйЭлемент, ДопПараметры = Неопределено) Экспорт
	
	Результат = Ложь;
	
	// №7722 признак выбора только изображений и вывода сообщений при успешном результате
	ТолькоИзображения = Ложь;
	ВыводитьСообщенияПриУспешномРезультате = Истина;
	Если ТипЗнч(ДопПараметры) = Тип("Структура") Тогда
		
		Если ДопПараметры.Свойство("ТолькоИзображения") Тогда
			ТолькоИзображения = ДопПараметры.ТолькоИзображения;
		КонецЕсли;
		
		Если ДопПараметры.Свойство("ВыводитьСообщенияПриУспешномРезультате") Тогда
			ВыводитьСообщенияПриУспешномРезультате = ДопПараметры.ВыводитьСообщенияПриУспешномРезультате;
		КонецЕсли;
		
	КонецЕсли;
	
	Если ВыбранныйЭлемент = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(ВыбранныйЭлемент) = Тип("ЭлементСпискаЗначений") Тогда	
		ВыбраннаяСсылка = ВыбранныйЭлемент.Значение;
	Иначе
		ВыбраннаяСсылка = ВыбранныйЭлемент;
	КонецЕсли;
	
	Режим = РежимДиалогаВыбораФайла.Открытие;
	ДиалогОткрытияФайла = Новый ДиалогВыбораФайла(Режим);
	ДиалогОткрытияФайла.ПолноеИмяФайла = "";
	ДиалогОткрытияФайла.МножественныйВыбор = Истина;
	ДиалогОткрытияФайла.Заголовок = "Выберите файлы";
	
	// №7722 признак выбора только изображений
	Если ТолькоИзображения Тогда
		ДиалогОткрытияФайла.Фильтр = ОбщийМодульКлиентСервер.ФильтрФайловИзображений();
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура;
	Если НЕ ДопПараметры = Неопределено Тогда
		ОбщегоНазначенияКлиентСервер.ДополнитьСтруктуру(ДополнительныеПараметры, ДопПараметры);	
	КонецЕсли;
	ДополнительныеПараметры.Вставить("ВыбраннаяСсылка", ВыбраннаяСсылка);
	Если НЕ ДопПараметры = Неопределено И ДопПараметры.Свойство("ДействиеПослеПрикрепления") Тогда
		ДополнительныеПараметры.Вставить("ДействиеПослеПрикрепления", ДопПараметры.ДействиеПослеПрикрепления);
	Иначе
		ДополнительныеПараметры.Вставить("ДействиеПослеПрикрепления", Неопределено);
	КонецЕсли;
	ДополнительныеПараметры.Вставить("ВыводитьСообщенияПриУспешномРезультате", ВыводитьСообщенияПриУспешномРезультате);

	ОписаниеОповещения = Новый ОписаниеОповещения("ПослеВыбораФайловДляПрикрепления", ЭтотОбъект, ДополнительныеПараметры);
	ДиалогОткрытияФайла.Показать(ОписаниеОповещения);
	
КонецПроцедуры

Процедура ПослеВыбораФайловДляПрикрепления(ВыбранныеФайлы, ДополнительныеПараметры) Экспорт
	
	СтруктураРезультата = Новый Структура("Результат, ПрисоединенныеФайлы", Ложь, Новый Массив);
	
	Если ВыбранныеФайлы = Неопределено Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Файл(ы) не выбран!'; en = 'File(s) not selected!'"));
		Возврат;
	КонецЕсли;
	
	ДействиеПослеПрикрепления = Неопределено;
	Если ДополнительныеПараметры.Свойство("ДействиеПослеПрикрепления", ДействиеПослеПрикрепления) Тогда
		ДополнительныеПараметры.Удалить("ДействиеПослеПрикрепления");
	КонецЕсли;
	
	Для Каждого ИмяФайла Из ВыбранныеФайлы Цикл
		ВыбФайл = Новый Файл(ИмяФайла);
		ПрисоединенныйФайл = ПредопределенноеЗначение("Справочник.НоменклатураПрисоединенныеФайлы.ПустаяСсылка");
		Если ОбщийМодульВызовСервера.СохранитьПрикрепленныеДанные(ДополнительныеПараметры.ВыбраннаяСсылка, 
																ВыбФайл.ИмяБезРасширения, 
																СтрЗаменить(ВыбФайл.Расширение,".",""), 
																ОбщийМодуль.Сериализовать(Новый ДвоичныеДанные(ИмяФайла)), 
																ДополнительныеПараметры, 
																ПрисоединенныйФайл) Тогда
																
			Если ДополнительныеПараметры.ВыводитьСообщенияПриУспешномРезультате Тогда
				Сообщить("Файлы успешно прикреплены");
			КонецЕсли;	
			СтруктураРезультата.Результат = Истина;
			СтруктураРезультата.ПрисоединенныеФайлы.Добавить(ПрисоединенныйФайл);
		Иначе
			Сообщить("Не удалось прикрепить файлы!", СтатусСообщения.Важное);
		КонецЕсли;
	КонецЦикла;
	
	Если НЕ ДействиеПослеПрикрепления = Неопределено Тогда
		ВыполнитьОбработкуОповещения(ДействиеПослеПрикрепления, СтруктураРезультата);	
	КонецЕсли;
	
КонецПроцедуры

Процедура УдалитьФайлыВДереве(Форма, ФайлыДерево, ЭлементыФайлыДерево) Экспорт
	
	МассивФайловКУдалению = Новый Массив;
	ВыбранныеЭлементы = ЭлементыФайлыДерево.ВыделенныеСтроки;	
	
	Если ВыбранныеЭлементы.Количество() > 0 Тогда
		Для каждого ЭлементДляПечати из ВыбранныеЭлементы Цикл
			СтрФайл = ФайлыДерево.НайтиПоИдентификатору(ЭлементДляПечати);
			
			// если выделен корень дерева, то пропускаем
			Если СтрФайл.ПолучитьРодителя() = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			КлючЗаписи = Новый Структура("Период,ВидФайлаПрограммыПостроителя,СсылкаНаОбъект,ИмяФайла");
			ЗаполнитьЗначенияСвойств(КлючЗаписи, СтрФайл);
			МассивФайловКУдалению.Добавить(КлючЗаписи);			
		КонецЦикла;
	Иначе
		ПоказатьПредупреждение(,"Выберите файл(ы) в списке");
	КонецЕсли;
	
	Если МассивФайловКУдалению.Количество() = 0 Тогда
		ПоказатьПредупреждение(,"Выберите файл(ы) в списке");
	Иначе
		ПараметрыУдаления = Новый Структура("МассивФайловКУдалению", МассивФайловКУдалению);
		Оповещение = Новый ОписаниеОповещения("ПослеВопросаОбУдаленииФайловВДереве", Форма, ПараметрыУдаления);
		ПоказатьВопрос(Оповещение, "Удалить выбранные файлы из базы?", РежимДиалогаВопрос.ДаНет, 0);
	КонецЕсли;
	
КонецПроцедуры

//++ №13833
Процедура ОтправитьВсеВложенныеФайлыЗаказаНаПроизводствоНаПринтер(ДокументСсылка, УникальныйИдентификатор) Экспорт
	
	ФайлыЗаказа = ОбщийМодульВызовСервера.ПолучитьМассивФайловЗНП(ДокументСсылка);
	
	Для Каждого ДанныеФайла Из ФайлыЗаказа Цикл
		
		АдресФайла = ОбщийМодульВызовСервера.ПолучитьДанныеФайла(ДанныеФайла.Номенклатура, ДанныеФайла.ИмяФайла,, УникальныйИдентификатор);
		
		ВременноеИмя = КаталогВременныхФайлов() + Строка(Новый УникальныйИдентификатор()) + "." + ДанныеФайла.Расширение;
		
		//ВременноеИмя = ПолучитьИмяВременногоФайла(ДанныеФайла.Расширение);
		ПолучитьФайл(АдресФайла, ВременноеИмя, Ложь);
		
		Shell = Новый COMОбъект("Shell.Application");
		Shell.ShellExecute(ВременноеИмя, "", "", "print", 0);
		
		// пауза
		ДатаВыхода = ТекущаяДата() + 2;
		Пока ТекущаяДата() < ДатаВыхода Цикл
			ОбработкаПрерыванияПользователя();
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры
