#Область ПросмотрФайловВПроводнике

Процедура ПросмотретьВсеФайлы(ФайлыДерево, СинонимВызываемогоОбъекта, УникальныйИдентификатор, ТолькоВыбранные = Ложь) Экспорт
	
	WSS = Новый COMОбъект("WScript.Shell");
	ПапкаМоиДокументы = WSS.SpecialFolders().Item("MyDocuments");
	
	Если ПустаяСтрока(ПапкаМоиДокументы) Тогда
		Возврат;
	КонецЕсли;
	ИмяКаталога = ПапкаМоиДокументы + "\" + СинонимВызываемогоОбъекта;
	
	КаталогНаДиске = Новый Файл(ИмяКаталога);
	Если НЕ КаталогНаДиске.Существует() Тогда
		СоздатьКаталог(ИмяКаталога);
	КонецЕсли;
	Если НЕ КаталогНаДиске.Существует() Тогда
		Возврат;
	КонецЕсли;
	
	МассивПолучаемыхФайлов = Новый Массив;

	СтрокиДерева = ФайлыДерево.ПолучитьЭлементы();
	Для каждого СтрокаДокумента из СтрокиДерева Цикл
		Если ТолькоВыбранные И НЕ СтрокаДокумента.ПометкаДляВыбора Тогда
			Продолжить;
		КонецЕсли;
		
		ИмяКаталогаОбъекта = ИмяКаталога + "\" + СтрокаДокумента.СинонимОбъекта;
		КаталогОбъектаНаДиске = Новый Файл(ИмяКаталогаОбъекта);
		Если НЕ КаталогОбъектаНаДиске.Существует() Тогда
			СоздатьКаталог(ИмяКаталогаОбъекта);
		КонецЕсли;
		Если НЕ КаталогОбъектаНаДиске.Существует() Тогда
			Возврат;
		КонецЕсли;
		ПодстрокиДерева = СтрокаДокумента.ПолучитьЭлементы();
		Для Каждого СтрокаФайла Из ПодстрокиДерева Цикл
			АдресФайла = ОбщийМодульВызовСервера.ПолучитьДанныеФайла(СтрокаФайла.Документ, СтрокаФайла.ИмяФайла, , УникальныйИдентификатор);
			Если НЕ АдресФайла = Неопределено Тогда // №7253
				ВременноеИмя = ИмяКаталогаОбъекта + "\" + СтрокаФайла.НаименованиеФайла;			
				МассивПолучаемыхФайлов.Добавить(Новый ОписаниеПередаваемогоФайла(ВременноеИмя, АдресФайла));
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	Если МассивПолучаемыхФайлов.Количество() > 0 Тогда
		НачатьПолучениеФайлов(Новый ОписаниеОповещения("ПросмотретьВсеФайлыФрагмент", ЭтотОбъект, ИмяКаталога), МассивПолучаемыхФайлов,, Ложь);
	КонецЕсли;
	
КонецПроцедуры 	

Процедура ПросмотретьВсеФайлыФрагмент(ПолученныеФайлы, ДополнительныеПараметры) Экспорт 
    
    Если ПолученныеФайлы = Неопределено
        И Не (ТипЗнч(ПолученныеФайлы) = Тип("Массив")
            И ПолученныеФайлы.Количество()) Тогда
        Возврат;
    КонецЕсли;
	
	Оповещение = Новый ОписаниеОповещения("ЗавершитьЗапускПроводника", ЭтотОбъект,, "ОткрытьПроводникПриОбработкеОшибки", ЭтотОбъект);
	//НачатьЗапускПриложения(Оповещение, "explorer.exe """ + ДополнительныеПараметры + """");
	НачатьЗапускПриложения(Оповещение, "file:///" + ДополнительныеПараметры);
		
КонецПроцедуры

Процедура ОткрытьПроводникПриОбработкеОшибки(ИнформацияОбОшибке, СтандартнаяОбработка, Контекст) Экспорт 
	
	СтандартнаяОбработка = Ложь;
	ОткрытьПроводникОповеститьОбОшибке("", Контекст);
	
КонецПроцедуры

Процедура ОткрытьПроводникОповеститьОбОшибке(ОписаниеОшибки, Контекст)
	
	Если Не ПустаяСтрока(ОписаниеОшибки) Тогда 
		ПоказатьПредупреждение(, ОписаниеОшибки);
	КонецЕсли;
	
КонецПроцедуры

