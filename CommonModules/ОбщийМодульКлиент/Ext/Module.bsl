Функция ПолучитьСписокКомнатПоДереву(Дерево, ИсключитьКомнату = Неопределено) Экспорт
	
	СписокКомнат = Новый СписокЗначений;
	
	СтрокиДерева = Дерево.ПолучитьЭлементы();
	Для Каждого СтрокаДерева Из СтрокиДерева Цикл
		Если СписокКомнат.НайтиПоЗначению(СтрокаДерева.Комната) = Неопределено И НЕ СтрокаДерева.Комната = ИсключитьКомнату Тогда
			СписокКомнат.Добавить(СтрокаДерева.Комната);
		КонецЕсли;
	КонецЦикла;
	
	Возврат СписокКомнат;
	
КонецФункции

#Область ГрафикЗамеровИМонтажей

Процедура ПриИзмененииДатыНачалаГрафика(Форма) Экспорт
	
	Если Форма.ИмяФормы = "Документ.Монтаж.Форма.ФормаДокумента" Тогда
		Объект = Форма;
	Иначе
		Объект = Форма.Отчет;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.ДатаНачала) И ЗначениеЗаполнено(Объект.ДатаОкончания) Тогда
		Если Объект.ДатаНачала > Объект.ДатаОкончания Тогда
			 Объект.ДатаОкончания = Объект.ДатаНачала;
		КонецЕсли;
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("Форма", Форма);
	
	ОбновитьСостояниеКнопокИнтервалаПриИзмененииДат(ДополнительныеПараметры);
	
КонецПроцедуры

Процедура ПриИзмененииДатыОкончанияГрафика(Форма) Экспорт
	
	Если Форма.ИмяФормы = "Документ.Монтаж.Форма.ФормаДокумента" Тогда
		Объект = Форма;
	Иначе
		Объект = Форма.Отчет;
	КонецЕсли;

	Если ЗначениеЗаполнено(Объект.ДатаНачала) И ЗначениеЗаполнено(Объект.ДатаОкончания) Тогда
		Если Объект.ДатаНачала > Объект.ДатаОкончания Тогда
			 Объект.ДатаНачала = Объект.ДатаОкончания;
		КонецЕсли;
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("Форма", Форма);
	
	ОбновитьСостояниеКнопокИнтервалаПриИзмененииДат(ДополнительныеПараметры);
	
КонецПроцедуры
	
Процедура ПоказатьДиалогВыбораПериода(Форма, ОписаниеОповещенияПослеВыбораПериода) Экспорт
	
	//#8387	
	Элементы = Форма.Элементы;
	
	//++ №10185
	Если Форма.ИмяФормы = "Документ.Монтаж.Форма.ФормаДокумента" Тогда
		Отчет = Форма;
	Иначе
	//-- №10185
		Отчет = Форма.Отчет;
	КонецЕсли;
	
    Диалог = Новый ДиалогРедактированияСтандартногоПериода();
	Если Элементы.УстановитьДень.Пометка Тогда
		Диалог.Период = Новый СтандартныйПериод(ВариантСтандартногоПериода.Сегодня);
	ИначеЕсли Элементы.УстановитьНеделя.Пометка Тогда
		Диалог.Период = Новый СтандартныйПериод(ВариантСтандартногоПериода.ЭтаНеделя);
	ИначеЕсли Элементы.УстановитьМесяц.Пометка Тогда
		Диалог.Период = Новый СтандартныйПериод(ВариантСтандартногоПериода.ЭтотМесяц);
	Иначе
    	Диалог.Период = Новый СтандартныйПериод(Отчет.ДатаНачала, Отчет.ДатаОкончания);
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ОписаниеОповещенияПослеВыбораПериода", ОписаниеОповещенияПослеВыбораПериода);
	ДополнительныеПараметры.Вставить("Форма", Форма);
    ОписаниеОповещения = Новый ОписаниеОповещения("ВыбратьПериодЗавершение", ЭтотОбъект, ДополнительныеПараметры);
    Диалог.Показать(ОписаниеОповещения);

КонецПроцедуры

Процедура ВыбратьПериодЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Элементы = ДополнительныеПараметры.Форма.Элементы;
	
	//++ №10185
	Если ДополнительныеПараметры.Форма.ИмяФормы = "Документ.Монтаж.Форма.ФормаДокумента" Тогда
		Отчет = ДополнительныеПараметры.Форма;
	Иначе
	//-- №10185
		Отчет = ДополнительныеПараметры.Форма.Отчет;
	КонецЕсли;
	
	Если Результат <> Неопределено Тогда
        Отчет.ДатаНачала    = Результат.ДатаНачала;
        Отчет.ДатаОкончания = Результат.ДатаОкончания;
	КонецЕсли;
	ОбновитьСостояниеКнопокИнтервалаПриИзмененииДат(ДополнительныеПараметры);
	
	//ДатаИнтервалаПриИзменении();
	ВыполнитьОбработкуОповещения(ДополнительныеПараметры.ОписаниеОповещенияПослеВыбораПериода);
	
КонецПроцедуры
	
Процедура ОбновитьСостояниеКнопокИнтервалаПриИзмененииДат(ДополнительныеПараметры)
	
	Элементы = ДополнительныеПараметры.Форма.Элементы;
	
	//++ №10185
	Если ДополнительныеПараметры.Форма.ИмяФормы = "Документ.Монтаж.Форма.ФормаДокумента" Тогда
		Отчет = ДополнительныеПараметры.Форма;
	Иначе
	//-- №10185
		Отчет = ДополнительныеПараметры.Форма.Отчет;
	КонецЕсли;
	
	//#8387
	СнятьПометкиКнопокИнтервалаГрафика(Элементы);
	Если НачалоДня(Отчет.ДатаНачала) = НачалоДня(Отчет.ДатаОкончания) Тогда
		Элементы.УстановитьДень.Пометка = Истина;
		
	ИначеЕсли НачалоДня(Отчет.ДатаОкончания) = НачалоДня(Отчет.ДатаНачала + 60*60*24*6) Тогда
		Элементы.УстановитьНеделя.Пометка = Истина;
		
	ИначеЕсли НачалоДня(Отчет.ДатаОкончания) = НачалоДня(ДобавитьМесяц(Отчет.ДатаНачала, 1) - 86400) Тогда
		Элементы.УстановитьМесяц.Пометка = Истина;
		
	КонецЕсли;
	
	ОбновитьДоступностьКнопокСдвигаПриИзмененииДат(ДополнительныеПараметры);
	
КонецПроцедуры

Процедура СнятьПометкиКнопокИнтервалаГрафика(Элементы) Экспорт
	
	//#8387	
	Элементы.УстановитьДень.Пометка = Ложь;  
	Элементы.УстановитьНеделя.Пометка = Ложь; 
	Элементы.УстановитьМесяц.Пометка = Ложь;  

КонецПроцедуры
	
Процедура ОбновитьДоступностьКнопокСдвигаПриИзмененииДат(ДополнительныеПараметры)
	
	Элементы = ДополнительныеПараметры.Форма.Элементы;

	ДоступностьКнопокСдвига = Элементы.УстановитьДень.Пометка ИЛИ Элементы.УстановитьНеделя.Пометка ИЛИ Элементы.УстановитьМесяц.Пометка;
	Элементы.СдвинутьИнтервалВлево.Доступность  = ДоступностьКнопокСдвига;
	Элементы.СдвинутьИнтервалВправо.Доступность = ДоступностьКнопокСдвига;

КонецПроцедуры

Процедура СдвинутьДатуГрафика(Форма, Знак=1, ОписаниеОповещенияПослеВыбораПериода) Экспорт
	
	//#8387
	
	Элементы = Форма.Элементы;
	
	//++ №10185
	Если Форма.ИмяФормы = "Документ.Монтаж.Форма.ФормаДокумента" Тогда
		Отчет = Форма;
	Иначе
	//-- №10185
		Отчет = Форма.Отчет;
	КонецЕсли;
	
	Если Элементы.УстановитьДень.Пометка Тогда
		Отчет.ДатаНачала 	= Отчет.ДатаНачала + Знак*86400;
		Отчет.ДатаОкончания = Отчет.ДатаНачала;
		
	ИначеЕсли Элементы.УстановитьНеделя.Пометка Тогда
		Отчет.ДатаНачала 	= Отчет.ДатаНачала + Знак*86400*7;
		Отчет.ДатаОкончания = Отчет.ДатаОкончания + Знак*86400*7;
		
	ИначеЕсли Элементы.УстановитьМесяц.Пометка Тогда
		Отчет.ДатаНачала 	= ДобавитьМесяц(Отчет.ДатаНачала, Знак);
		Отчет.ДатаОкончания = ДобавитьМесяц(Отчет.ДатаОкончания, Знак);
		
	КонецЕсли;
	
	//ДатаИнтервалаПриИзменении();
	ВыполнитьОбработкуОповещения(ОписаниеОповещенияПослеВыбораПериода);
		
КонецПроцедуры

Процедура УстановитьПериодГрафикаДень(Форма, ОписаниеОповещенияПриИзмененииДатИнтервала=Неопределено, СброситьДаты = Истина) Экспорт
	
	//++ №10185
	Если Форма.ИмяФормы = "Документ.Монтаж.Форма.ФормаДокумента" Тогда
		Отчет = Форма;
	Иначе
	//-- №10185
		Отчет = Форма.Отчет;
	КонецЕсли;
		
	Элементы = Форма.Элементы;
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("Форма", Форма);
	
	Если СброситьДаты Тогда
		Отчет.ДатаНачала = ТекущаяДата();
		Отчет.ДатаОкончания = ТекущаяДата();
	КонецЕсли;
	
	СнятьПометкиКнопокИнтервалаГрафика(Элементы);  	//#8387
	Элементы.УстановитьДень.Пометка = Истина;  				//#8387
	ОбновитьДоступностьКнопокСдвигаПриИзмененииДат(ДополнительныеПараметры);
	
	Если НЕ ОписаниеОповещенияПриИзмененииДатИнтервала = Неопределено Тогда	
		ВыполнитьОбработкуОповещения(ОписаниеОповещенияПриИзмененииДатИнтервала);
	КонецЕсли;
	
КонецПроцедуры

Процедура УстановитьПериодГрафикаНеделя(Форма, ОписаниеОповещенияПриИзмененииДатИнтервала) Экспорт
	
	//++ №10185
	Если Форма.ИмяФормы = "Документ.Монтаж.Форма.ФормаДокумента" Тогда
		Отчет = Форма;
	Иначе
	//-- №10185
		Отчет = Форма.Отчет;
	КонецЕсли;
	
	Элементы = Форма.Элементы;
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("Форма", Форма);
	
	Отчет.ДатаНачала = ТекущаяДата();
	Отчет.ДатаОкончания = ТекущаяДата() + 60*60*24*6;
	
	СнятьПометкиКнопокИнтервалаГрафика(Элементы);  	//#8387
	Элементы.УстановитьНеделя.Пометка = Истина;  			//#8387
	ОбновитьДоступностьКнопокСдвигаПриИзмененииДат(ДополнительныеПараметры);
	
	ВыполнитьОбработкуОповещения(ОписаниеОповещенияПриИзмененииДатИнтервала);
	
КонецПроцедуры

Процедура УстановитьПериодГрафикаМесяц(Форма, ОписаниеОповещенияПриИзмененииДатИнтервала) Экспорт
	
	//++ №10185
	Если Форма.ИмяФормы = "Документ.Монтаж.Форма.ФормаДокумента" Тогда
		Отчет = Форма;
	Иначе
	//-- №10185
		Отчет = Форма.Отчет;
	КонецЕсли;
	
	Элементы = Форма.Элементы;
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("Форма", Форма);
	
	Отчет.ДатаНачала = ТекущаяДата();
	Отчет.ДатаОкончания = ДобавитьМесяц(ТекущаяДата(), 1) - 86400;
	
	СнятьПометкиКнопокИнтервалаГрафика(Элементы);  	//#8387
	Элементы.УстановитьМесяц.Пометка = Истина;  			//#8387
	ОбновитьДоступностьКнопокСдвигаПриИзмененииДат(ДополнительныеПараметры);
	
	ВыполнитьОбработкуОповещения(ОписаниеОповещенияПриИзмененииДатИнтервала);
	
КонецПроцедуры

#КонецОбласти

#Область ПроцедурыИФункцииФормированияКомандныхПанелейФорм

// Результат - ДокументСсылка, из формы которого производится запуск команды
// ДополнительныеПараметры - Структура
Процедура ВыполнитьОбработкуОбновления(Результат, ДополнительныеПараметры) Экспорт
	
	ПараметрыОбработки = Новый Структура;
	ПараметрыОбработки.Вставить("ОбработкаОбязательныхОбъектов", Неопределено);
	
	ВыборочныеОбъектыКОбработке = ОбщийМодульВызовСервера.ПолучитьДанныеИзРегистровОбработкиОбновления(Результат);
	
	//++ №11768 для версии 2.8.0.$a производится ручная обработка
	ПроверочнаяВерсия = "2.8.0.$a";
	Если ЕстьОбъектыКОбработкеВерсии(ПроверочнаяВерсия, ВыборочныеОбъектыКОбработке) Тогда
		
		ВыполнитьОбработку_2_8_0_Sa(ПроверочнаяВерсия, 0, Результат, ДополнительныеПараметры);
		Возврат;
		
	КонецЕсли;
	//-- №11768
		
	ПараметрыОбработки.Вставить("ВыборочнаяОбработка", Истина);
	ПараметрыОбработки.Вставить("ВыборочныеОбъектыКОбработке", ВыборочныеОбъектыКОбработке);
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ВыполнитьОбработкуОбновленияЗавершение", ЭтотОбъект, ДополнительныеПараметры);
	ОткрытьФорму("Обработка.НастройкаПрограммы.Форма.ОбработкаДокументовПослеОбновления", ПараметрыОбработки, ДополнительныеПараметры.Форма, , , , ОписаниеОповещения);
	
КонецПроцедуры

Процедура ВыполнитьОбработкуОбновленияЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Истина Тогда
		ДополнительныеПараметры.Форма.Прочитать();
		Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ДополнительныеПараметры.Форма, "ТребуетсяВыводКомандыОбработкиОбновления") Тогда
			ДополнительныеПараметры.Форма.ТребуетсяВыводКомандыОбработкиОбновления = 
				ОбщийМодульВызовСервера.ТребуетсяВыводКомандыПодключеннойКОбъекту(ДополнительныеПараметры.Источник.Ссылка, ДополнительныеПараметры.ОписаниеКоманды);	
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

