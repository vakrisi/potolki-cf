	ДополнительныеПараметры = Новый Структура("ТекущаяКомната, ВМатериалы, ВСписокМатериалов, Форма", ТекущаяКомната, ВМатериалы, ВСписокМатериалов, Форма);
	
	Оповещение = Новый ОписаниеОповещения("ЗагрузитьПотолокИзПостроителяПослеВыбораФайлов", ЭтотОбъект, ДополнительныеПараметры);
	
	ВыборФайловПостроителя(Форма, Оповещение, Истина, Истина);

	//НачальныйКаталог = ОбщийМодуль.ПолучитьКаталогВыгрузиИзПостроителяДляТекущегоПользователя(Истина);
	//
	//Если ОбменСEasyCeiling.ИспользоватьСтандартныйДиалогWindowsДляВыбораФайлаВыгрузкиИзПостроителя() Тогда		
	//	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	//	Диалог.Каталог = НачальныйКаталог;
	//	Фильтр = "Выгрузка из построителя (*.ini)|*.ini";
	//	Диалог.Фильтр = Фильтр;
	//	Диалог.МножественныйВыбор = Истина;
	//	Диалог.Заголовок = "Выберите файлы";	
	//	Диалог.Показать(Оповещение);		
	//Иначе
	//	ОткрытьФорму("ОбщаяФорма.ФормаВыбораФайла", Новый Структура("НачальныйКаталог", НачальныйКаталог), Форма, , , , Оповещение);					
	//КонецЕсли;
	
КонецПроцедуры

Процедура ЗагрузитьПотолокИзПостроителяПослеВыбораФайлов(ВыбранныеФайлы, ДополнительныеПараметры) Экспорт
	
	Если ВыбранныеФайлы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ВыбранныеФайлы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	//ПеренестиДеревоВТабличнуюЧасть();
	
	СписокФайлов = Новый СписокЗначений;
	СписокФайлов.ЗагрузитьЗначения(ВыбранныеФайлы);
	
	ОповещениеПослеЗакрытия = Новый ОписаниеОповещения("ЗагрузитьПотолокИзПостроителяЗавершение", ДополнительныеПараметры.Форма, ДополнительныеПараметры);			
	ПараметрыФормыЗагрузки = Новый Структура;
	ПараметрыФормыЗагрузки.Вставить("ЗапускатьПриОткрытии", Истина);
	ПараметрыФормыЗагрузки.Вставить("НаКлиенте", 			Истина);
	
	ПараметрыФормыЗагрузки.Вставить("СписокФайлов", 		СписокФайлов);
	ПараметрыФормыЗагрузки.Вставить("ПоВладельцу", 			Истина);
	
	ПараметрыФормыЗагрузки.Вставить("ЭтоРозница", 			Истина);
	//ПараметрыФормыЗагрузки.Вставить("ТипДокументаСтрокой", 	ДополнительныеПараметры.ТипДокументаСтрокой);
	ПараметрыФормыЗагрузки.Вставить("УчитыватьНДС",			ДополнительныеПараметры.Форма.УчитыватьНДС);
	ПараметрыФормыЗагрузки.Вставить("Комната", 				ДополнительныеПараметры.ТекущаяКомната);	
	ПараметрыФормыЗагрузки.Вставить("ВМатериалы", 			ДополнительныеПараметры.ВМатериалы ИЛИ ДополнительныеПараметры.ВСписокМатериалов);
	
	ОткрытьФорму("ОбщаяФорма.ФормаЗагрузкиИзПостроителя", ПараметрыФормыЗагрузки, ДополнительныеПараметры.Форма, , , , ОповещениеПослеЗакрытия);

КонецПроцедуры

Функция РасширеннаяОбработкаДобавленнойПродукции(Форма, ВидЗаказа, ВМатериалы=Ложь, Комната, СтруктураПродукции, ЭтоПродукция = Ложь) Экспорт
	
	//#11670 обработка по расширенным правилам
	
	Объект = Форма.Объект;

	ОписаниеОшибки = "";
	
	//++ №13814
	Если ЭтоПродукция Тогда
		СтруктураПродукцииПотолка = новый Структура("ПродукцияНоменклатура, ВидНоменклатурыПотолка, КоличествоПродукция", СтруктураПродукции.Номенклатура, ПредопределенноеЗначение("Справочник.ВидыНоменклатуры.Продукция"), СтруктураПродукции.Количество);
	//-- №13814
	Иначе
		СтруктураПродукцииПотолка = ОбменСEasyCeiling.ПолучитьСтруктуруПотолка(СтруктураПродукции.Номенклатура,,,,,,, ОписаниеОшибки);
	КонецЕсли;
	
	Если СтруктураПродукцииПотолка <> Неопределено И Не ЗначениеЗаполнено(ОписаниеОшибки) Тогда
		
		//++ №13814
		Если ЭтоПродукция Тогда
			НомерРасчета = СтруктураПродукции.НомерРасчета;
		Иначе
			НомерРасчета = СтруктураПродукцииПотолка.НомерРасчетаЗаказа;
		КонецЕсли;
		//-- №13814
			
		ДоговорКонтрагента = Неопределено;
		Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Объект, "ДоговорКонтрагента") Тогда
			ДоговорКонтрагента = Объект.ДоговорКонтрагента	
		КонецЕсли;
	
		ДанныеЗаказа = ОбменСEasyCeiling.СтруктураДанныхЗаказа(Объект.Организация, Объект.Подразделение, ,
							  				 Объект.ВидЦен, Объект.Валюта, Объект.Дата, Форма.УчитыватьНДС, , ДоговорКонтрагента);
		СтруктураЗаказа = ОбменСEasyCeiling.ПолучитьСтруктуруЗаказа(СтруктураПродукцииПотолка, ВидЗаказа, ДанныеЗаказа, Истина);
				
		Для Каждого ТекущаяСтрока Из СтруктураЗаказа.Товары Цикл
			Если НЕ ТекущаяСтрока.РасширеннаяОбработка Тогда
				Продолжить;
			КонецЕсли;
			//НоваяСтрока = Объект.ТоварыУслуги.Добавить();
			НоваяСтрока = Новый Структура("Номенклатура, ХарактеристикаНоменклатуры, Количество, ЕдиницаИзмерения, Коэффициент, Бесплатно, Комната, УИСтроки, 
											|ЗагруженоИзПостроителя, НомерПотолка, ПроцентСкидки, Спецификация, СтавкаНДС, Сумма, СуммаНДС, СуммаПоПрайсу, СуммаСкидки,
											|ЦветФактуры, Цена, ЦенаПоПрайсу");
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущаяСтрока);
			НоваяСтрока.Комната = Комната;
			НоваяСтрока.НомерПотолка = НомерРасчета;
			НоваяСтрока.УИСтроки = СтруктураПродукции.УИСтроки;
			Если ВМатериалы = Неопределено Тогда
				НоваяСтрокаТаблицы = Объект.ТоварыУслуги.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрокаТаблицы, НоваяСтрока);
			Иначе
				Розница_ДобавитьСтрокуВДеревоТоваров(Форма, НоваяСтрока, Ложь);
			КонецЕсли;
		КонецЦикла;
		Для Каждого ТекущаяСтрока Из СтруктураЗаказа.Услуги Цикл
			Если НЕ ТекущаяСтрока.РасширеннаяОбработка Тогда
				Продолжить;
			КонецЕсли;
			//НоваяСтрока = Объект.ТоварыУслуги.Добавить();
			НоваяСтрока = Новый Структура("Номенклатура, ХарактеристикаНоменклатуры, Количество, ЕдиницаИзмерения, Коэффициент, Бесплатно, Комната, УИСтроки, 
											|ЗагруженоИзПостроителя, НомерПотолка, ПроцентСкидки, Спецификация, СтавкаНДС, Сумма, СуммаНДС, СуммаПоПрайсу, СуммаСкидки,
											|ЦветФактуры, Цена, ЦенаПоПрайсу");
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущаяСтрока);
			НоваяСтрока.Комната = Комната;
			НоваяСтрока.НомерПотолка = НомерРасчета;
			НоваяСтрока.УИСтроки = СтруктураПродукции.УИСтроки;
			Если ВМатериалы = Неопределено Тогда
				НоваяСтрокаТаблицы = Объект.ТоварыУслуги.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрокаТаблицы, НоваяСтрока);
			Иначе
				Розница_ДобавитьСтрокуВДеревоТоваров(Форма, НоваяСтрока, Ложь);
			КонецЕсли;
		КонецЦикла;
		Для Каждого ТекущаяСтрока Из СтруктураЗаказа.Материалы Цикл
			Если НЕ ТекущаяСтрока.РасширеннаяОбработка Тогда
				Продолжить;
			КонецЕсли;
			//НоваяСтрока = Объект.Материалы.Добавить();	
			НоваяСтрока = Новый Структура("Номенклатура, ХарактеристикаНоменклатуры, Количество, ЕдиницаИзмерения, Коэффициент, Комната, УИСтроки, НоменклатураТоваров");
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущаяСтрока);			
			НоваяСтрока.Комната = Комната;
			Если ВМатериалы = Ложь Тогда
				НоваяСтрока.НоменклатураТоваров = СтруктураПродукции.Номенклатура;
			КонецЕсли;
			НоваяСтрока.УИСтроки = СтруктураПродукции.УИСтроки;
			Если ВМатериалы = Неопределено Тогда
				НоваяСтрокаТаблицы = Объект.Материалы.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрокаТаблицы, НоваяСтрока);
			Иначе
				Розница_ДобавитьСтрокуВДеревоМатериалов(Форма, НоваяСтрока, Ложь);
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
КонецФункции

Функция Розница_КомнатаЗаполнена(ТекущиеДанные) Экспорт
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если ПустаяСтрока(ТекущиеДанные.Комната) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции
	
//++ №12433
//Процедура Розница_ДобавитьНоменклатуруВДерево(Форма, ДеревоЗначений, ДанныеСтроки, ПереходНаСтроку = Истина, ТекущийЭлемент="", РежимИзмененияСтроки = Истина) Экспорт
Процедура Розница_ДобавитьНоменклатуруВДерево(Форма, ИмяДереваЗначений, ДанныеСтроки, ПереходНаСтроку = Истина, РежимИзмененияСтроки = Истина) Экспорт
//-- №12433
	
	//++ №12433
	//СтрокиКомнат = ДеревоЗначений.ПолучитьЭлементы(); 
	СтрокиКомнат = Форма[ИмяДереваЗначений].ПолучитьЭлементы(); 
	//-- №12433
	
	Для Каждого СтрокаКомнаты из СтрокиКомнат Цикл
		Если СтрокаКомнаты.Комната = ДанныеСтроки.Комната Тогда
			СтрокиНоменклатуры = СтрокаКомнаты.ПолучитьЭлементы();
			
			НоваяСтрока = СтрокиНоменклатуры.Добавить();
			НоваяСтрока.Номенклатура = ДанныеСтроки.Номенклатура;
			НоваяСтрока.Комната = ДанныеСтроки.Комната;			
			НоваяСтрока.ЕдиницаИзмерения = ОбщийМодульВызовСервера.ПолучитьБазовуюЕдиницуИзмеренияНоменклатуры(НоваяСтрока.Номенклатура);
			НоваяСтрока.Коэффициент = 1;
			НоваяСтрока.Количество = 1;
			
			Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(НоваяСтрока, "УИСтроки") Тогда
				НоваяСтрока.УИСтроки = Новый УникальныйИдентификатор;
			КонецЕсли;
			Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(НоваяСтрока, "Уровень") Тогда
				НоваяСтрока.Уровень = 1;
			КонецЕсли;
			
			Если ПереходНаСтроку Тогда
				//++ №12433 исправлем обращение
				//Форма.Элементы.ДеревоЗначений.ТекущаяСтрока = НоваяСтрока.ПолучитьИдентификатор();
				//Форма.Элементы.ДеревоЗначений.ТекущийЭлемент = Форма.Элементы[ТекущийЭлемент];
				Форма.Элементы[ИмяДереваЗначений].ТекущаяСтрока = НоваяСтрока.ПолучитьИдентификатор();
				Форма.Элементы[ИмяДереваЗначений].ТекущийЭлемент = Форма.Элементы[ИмяДереваЗначений + "Количество"];
				//-- №12433
			КонецЕсли;
			
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ДанныеСтроки);
			
			Если РежимИзмененияСтроки Тогда				
				
				//++ №12433 исправлем обращение
				//Форма.Элементы[ДеревоЗначений].ИзменитьСтроку();
				Форма.Элементы[ИмяДереваЗначений].ИзменитьСтроку();
				//-- №12433 исправлем обращение
				
			КонецЕсли;
			Прервать;
		КонецЕсли
	КонецЦикла;	
	
КонецПроцедуры

Процедура Розница_ДобавитьСтрокуВДеревоМатериалов(Форма, ДанныеСтроки, ПереходНаСтроку = Истина, РежимИзмененияСтроки = Ложь) Экспорт
	
	//++ №12433
	//Розница_ДобавитьНоменклатуруВДерево(Форма, Форма.ДеревоМатериалов, ДанныеСтроки,  ПереходНаСтроку, "ДеревоМатериаловКоличество", РежимИзмененияСтроки);
