#Область РаботаСАдресами

//++ №10663 перенесено из формы лида, чтобы использовать в других формах
Процедура ОбработкаСобытияАдресОбработкаВыбора(Форма, ОбъектАдрес, ОбъектИдентификаторУлицы, РеквизитВремАдрес, ЭлементАдрес, ИмяОбработчикаОжидания, ВыбранноеЗначение, СтандартнаяОбработка) Экспорт
	
	Если ВыбранноеЗначение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(ВыбранноеЗначение) = Тип("Структура") Тогда
		СтандартнаяОбработка = Ложь;
		
		Если НЕ ВыбранноеЗначение.Свойство("ЭтоДом") Тогда
			//выбрали улицу
			ОбъектИдентификаторУлицы = ВыбранноеЗначение.Идентификатор;
			ОбъектАдрес = Строка(ВыбранноеЗначение.Представление);
			ЭлементАдрес.ОбновитьТекстРедактирования();
			Форма.ПодключитьОбработчикОжидания(ИмяОбработчикаОжидания, 0.1, Истина);
			РеквизитВремАдрес = ОбъектАдрес;
		Иначе
			//выбрали дом 
			ОбъектАдрес = РеквизитВремАдрес + ", " + ВыбранноеЗначение.Представление + ", квартира ";
			ЭлементАдрес.ОбновитьТекстРедактирования();
			Форма.ПодключитьОбработчикОжидания(ИмяОбработчикаОжидания, 0.1, Истина);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

// на основе Обработка.РасширенныйВводКонтактнойИнформации.ВводАдреса - процедура УлицаАвтоПодбор
