// Процедура открывает форму выбора настройки форм.
//
// Параметры:
//  ФормаВладелец            - Форма - форма, которая является владельцем формы выбора.
//  НастраиваемыйОбъект       - объект, для которой выбирается настройка.
//  РежимСохраненияНастройки - Истина - форма открыта для выбора сохраняемой настройки.
//
&НаКлиенте
Процедура ВыбратьНастройкуФормы(СохраненнаяНастройка, ФормаВладелец, НастраиваемыйОбъект, РежимСохраненияНастройки) Экспорт
	
	//ФормаВыбора = Справочники.СохраненныеНастройки.ПолучитьФормуВыбора(, ФормаВладелец);
	ФормаВыбора = ПолучитьФорму("Справочники.СохраненныеНастройки.ФормаВыбора",, ФормаВладелец);
	
	ФормаВыбора.Отбор.НастраиваемыйОбъект.Установить(НастраиваемыйОбъект);
	
	Если Найти(НастраиваемыйОбъект, "ОтчетОбъект") > 0 Тогда
		ФормаВыбора.Отбор.ТипНастройки.Установить(Лен_СохранениеНастроекСервер.ПолучитьТипНастройки());
	КонецЕсли;
	
	Если Лен_ОбщегоНазначенияКлиент.РольДоступнаНаСервере("ПолныеПрава") Тогда
		// Для администратора устанавливается отбор по владельцу (пользователь) настроек, который можно снять,
		// чтобы использовать настройки других пользователей
		
		ТабРезультат = Лен_СохранениеНастроекСервер.ПолучитьГруппуПользователя();
		
		СписокПользователей = Новый СписокЗначений;
		Для каждого ВыбСтрока из ТабРезультат Цикл
			СписокПользователей.Добавить(ВыбСтрока.Ссылка);
		КонецЦикла;
		//СписокПользователей.Добавить(ПараметрыСеанса.ТекущийПользователь);
		СписокПользователей.Добавить(Лен_ОбщегоНазначенияКлиент.ТекущийПользователь());
				   		
		ФормаВыбора.Отбор.Владелец.Использование	= Истина;
		ФормаВыбора.Отбор.Владелец.ВидСравнения		= ВидСравнения.ВСпискеПоИерархии;
		ФормаВыбора.Отбор.Владелец.Значение			= СписокПользователей;
		
	КонецЕсли;
	
	ФормаВыбора.Отбор.НастраиваемыйОбъект.Установить(НастраиваемыйОбъект);

	ФормаВыбора.Отбор.Ссылка.Использование	= Не Лен_ОбщегоНазначенияКлиент.РольДоступнаНаСервере("ПолныеПрава");
	ФормаВыбора.Отбор.Ссылка.ВидСравнения	= ВидСравнения.ВСписке;
	
	СписокДоступныхВариантов = Лен_СохранениеНастроекСервер.ПолучитьСписокДоступныхВариантов(НастраиваемыйОбъект);
	
	Для каждого ДоступныйВариант Из СписокДоступныхВариантов Цикл
		Если ДоступныйВариант.Пометка Тогда
			ФормаВыбора.Отбор.Ссылка.Значение.Добавить(ДоступныйВариант.Значение);
		КонецЕсли;
	КонецЦикла;
	
	ФормаВыбора.ПараметрТекущаяСтрока		= СохраненнаяНастройка;
	ФормаВыбора.РежимСохраненияНастройки	= РежимСохраненияНастройки;
	
	ФормаВыбора.Элементы.СправочникСписокСохраненныеНастройки.Колонки.Владелец.Видимость = Ложь;
		
	ФормаВыбора.ОткрытьМодально();
	ФормаВыбора.Активизировать();
	
КонецПроцедуры
