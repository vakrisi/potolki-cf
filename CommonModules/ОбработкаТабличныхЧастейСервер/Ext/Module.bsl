	ОбработкаТабличныхЧастейКлиентСервер.ПересчитатьСуммуСУчетомСкидокВСтрокеТЧ(ТекущаяСтрока, ИспользуютсяАвтоматическиеСкидки, , ИспользуютсяСкидки, ИспользуютсяБонусы);

КонецПроцедуры

Процедура ОкруглитьСтрокуТЧ(СтрокаДокумента, ПорядокОкругления, ОкруглятьВБольшуюСторону, ВариантОкругления,
	ИмяРеквизитаПроцентРучнойСкидки = Неопределено, 
	ИмяРеквизитаСуммаРучнойСкидки = Неопределено,
	ИспользуютсяАвтоматическиеСкидки = Ложь) Экспорт
	
	ОбработкаТабличныхЧастейКлиентСервер.ОкруглитьСтрокуТЧ(СтрокаДокумента, ПорядокОкругления, ОкруглятьВБольшуюСторону, ВариантОкругления,
				ИмяРеквизитаПроцентРучнойСкидки, 
				ИмяРеквизитаСуммаРучнойСкидки,
				ИспользуютсяАвтоматическиеСкидки);
	
КонецПроцедуры

Процедура ПроверитьЦенуСтроки(ТекущаяСтрока, СтруктураПараметров, Отказ = Ложь) Экспорт
	
	Если НЕ ЗначениеЗаполнено(ТекущаяСтрока.Цена) Тогда
		Если НЕ ТекущаяСтрока.Бесплатно И НЕ ТекущаяСтрока.Номенклатура.РазрешитьПродажуПоНулевойЦене Тогда
			
			ПутьКТабличнойЧасти = "";
			НомерСтроки = 0;
			Если СтруктураПараметров.Свойство("НомерСтроки", НомерСтроки) Тогда 
				НомерСтроки = Формат(НомерСтроки, "ЧН=0; ЧГ=0");
				ПутьКТабличнойЧасти = ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти(СтруктураПараметров.ТабличнаяЧасть, НомерСтроки, "Цена");
			КонецЕсли;
			ТекстСообщения = "";
			Если НЕ СтруктураПараметров.Свойство("ТекстСообщения", ТекстСообщения) Тогда 
				ТекстСообщения = "В табличной части """ + СтруктураПараметров.ИмяТабличнойЧасти + """ в строке " + (НомерСтроки) + " не заполнено значение колонки ""Цена""";
			КонецЕсли;
						
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
				ТекстСообщения,
				СтруктураПараметров.Ссылка,
				ПутьКТабличнойЧасти,
				,
				Отказ);
			
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Процедура ПересчитатьСуммуНДСВСтрокеТЧ(ТекущаяСтрока, УчитыватьНДС) Экспорт
	
	ОбработкаТабличныхЧастейКлиентСервер.ПересчитатьСуммуНДСВСтрокеТЧ(ТекущаяСтрока, УчитыватьНДС);

КонецПроцедуры

Процедура ЗаполнитьСтавкуНДСВСтрокеТЧ(СтрокаТабличнойЧасти, СтавкаНДСПоУмолчанию, УчитыватьНДС) Экспорт

	ОбработкаТабличныхЧастейКлиентСервер.ЗаполнитьСтавкуНДСВСтрокеТЧ(СтрокаТабличнойЧасти, СтавкаНДСПоУмолчанию, УчитыватьНДС);
	
КонецПроцедуры

Процедура НазначитьРучнуюСкидку(Объект, ИмяТЧ, Знач СуммаСкидкиКРаспределению, ИспользуютсяАвтоматическиеСкидки, УчитыватьНДС) Экспорт
	
	МаксимальнаяСуммаСкидки = 0;
	Для Каждого СтрокаТЧ Из Объект[ИмяТЧ] Цикл
		
		СуммаАвтоматическойСкидки = 0;
		Если ИспользуютсяАвтоматическиеСкидки Тогда
			СуммаАвтоматическойСкидки = СтрокаТЧ.СуммаАвтоматическойСкидки;
		КонецЕсли;
		//Если ЕстьБонусы Тогда
		//	СуммаАвтоматическойСкидки = СуммаАвтоматическойСкидки + СтрокаТЧ.СуммаСкидкиОплатыБонусом;
		//КонецЕсли;
		МаксимальнаяСуммаСкидки = МаксимальнаяСуммаСкидки + СтрокаТЧ.Количество * СтрокаТЧ.Цена - СуммаАвтоматическойСкидки;
		
	КонецЦикла;
	
	Если СуммаСкидкиКРаспределению > МаксимальнаяСуммаСкидки Тогда
		СуммаСкидкиКРаспределению = МаксимальнаяСуммаСкидки;
	КонецЕсли;
	
	Для каждого СтрокаТЧ Из Объект[ИмяТЧ] Цикл
				
		СуммаБезСкидки = СтрокаТЧ.Количество * СтрокаТЧ.Цена;
		СуммаАвтоматическойСкидки = 0;
		Если ИспользуютсяАвтоматическиеСкидки Тогда
			СуммаАвтоматическойСкидки = СтрокаТЧ.СуммаАвтоматическойСкидки;
		КонецЕсли;
		//Если ЕстьБонусы Тогда
		//	СуммаАвтоматическойСкидки = СуммаАвтоматическойСкидки + СтрокаТЧ.СуммаСкидкиОплатыБонусом;
		//КонецЕсли;
		
		Если МаксимальнаяСуммаСкидки <> 0 Тогда
			СтрокаТЧ.СуммаРучнойСкидки = (СуммаБезСкидки - СуммаАвтоматическойСкидки) * (СуммаСкидкиКРаспределению / МаксимальнаяСуммаСкидки);
		Иначе
			СтрокаТЧ.СуммаРучнойСкидки = 0;
		КонецЕсли;
		СуммаСкидкиКРаспределению = СуммаСкидкиКРаспределению - СтрокаТЧ.СуммаРучнойСкидки;
		МаксимальнаяСуммаСкидки = МаксимальнаяСуммаСкидки - (СуммаБезСкидки - СуммаАвтоматическойСкидки);
		
		Если СуммаБезСкидки <> 0 Тогда
			СтрокаТЧ.ПроцентРучнойСкидки = 100 * СтрокаТЧ.СуммаРучнойСкидки / СуммаБезСкидки;
		Иначе
			СтрокаТЧ.ПроцентРучнойСкидки = 0;
		КонецЕсли;
		
		СуммаСкидки = СуммаАвтоматическойСкидки + СтрокаТЧ.СуммаРучнойСкидки;
		
		Если ИспользуютсяАвтоматическиеСкидки Тогда
			Если СуммаБезСкидки <> 0 Тогда
				СтрокаТЧ.ПроцентАвтоматическойСкидки = ?(СуммаБезСкидки = 0, 0 , 100 * СуммаАвтоматическойСкидки / СуммаБезСкидки);
			Иначе
				СтрокаТЧ.ПроцентАвтоматическойСкидки = 0;
			КонецЕсли;
		КонецЕсли;
		
		СтрокаТЧ.Сумма    = СуммаБезСкидки - ?(СуммаСкидки > СуммаБезСкидки, СуммаБезСкидки, СуммаСкидки);
		ПересчитатьСуммуНДСВСтрокеТЧ(СтрокаТЧ, УчитыватьНДС);
		
	КонецЦикла;
	
	Объект.СуммаДокумента = Объект[ИмяТЧ].Итог("Сумма");
	
КонецПроцедуры

Процедура ОтменитьРучныеСкидки(Объект, ИмяТЧ, ИспользуютсяАвтоматическиеСкидки, УчитыватьНДС) Экспорт
	
	Для Каждого СтрокаТЧ Из Объект[ИмяТЧ] Цикл
		
		СтрокаТЧ.СуммаРучнойСкидки   = 0;
		СтрокаТЧ.ПроцентРучнойСкидки = 0;
		
		СуммаБезСкидки = СтрокаТЧ.Количество * СтрокаТЧ.Цена;
		
		СуммаАвтоматическойСкидки = 0;
		Если ИспользуютсяАвтоматическиеСкидки Тогда
			СуммаАвтоматическойСкидки = СтрокаТЧ.СуммаАвтоматическойСкидки;
		КонецЕсли;

		//Если ЕстьБонусы Тогда
		//	СуммаАвтоматическойСкидки = СуммаАвтоматическойСкидки + СтрокаТЧ.СуммаСкидкиОплатыБонусом;
		//КонецЕсли;
		
		СтрокаТЧ.Сумма    = СуммаБезСкидки - ?(СуммаАвтоматическойСкидки > СуммаБезСкидки, СуммаБезСкидки, СуммаАвтоматическойСкидки);
		ПересчитатьСуммуНДСВСтрокеТЧ(СтрокаТЧ, УчитыватьНДС);
		
	КонецЦикла;
	
	Объект.СуммаДокумента = Объект[ИмяТЧ].Итог("Сумма");
	
КонецПроцедуры

#КонецОбласти

