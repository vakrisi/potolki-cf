#Область ОбработкаТабличныхЧастей_ЗаказДоговор

Функция ДобавитьОбновитьПотолокВТЧДокументаРозницы(ДанныеФормы, ИмяТабличнойЧасти, ДанныеСтроки) Экспорт
	
	ОтборСтрока = Новый Структура("Комната, Номенклатура", ДанныеСтроки.Комната, ДанныеСтроки.Номенклатура);
	
	ТабличнаяЧастьДокумента = ДанныеФормы[ИмяТабличнойЧасти];	
	МетаданныеДокумента = ДанныеФормы.Ссылка.Метаданные(); // заказ-договор / предварительный расчет / монтаж	
	Если ОбщийМодуль.ЕстьРеквизитТабЧастиОбъекта("ЗагруженоИзПостроителя", МетаданныеДокумента, ИмяТабличнойЧасти) Тогда		
		ОтборСтрока.Вставить("ЗагруженоИзПостроителя", Истина);
	КонецЕсли;
		
	НайденнаяСтрока = ТабличнаяЧастьДокумента.НайтиСтроки(ОтборСтрока);
	Если НайденнаяСтрока.Количество() > 0 Тогда
		НоваяСтрокаДокумента = НайденнаяСтрока[0];
	Иначе
		//НоваяСтрокаДокумента = ТабличнаяЧастьДокумента.Добавить();							
		//Нужно указать индекс чтобы вставить в нужную комнату
		ОтборИндекс = Новый Структура("Комната", ДанныеСтроки.Комната);
		НайтиИндексКомнаты = ТабличнаяЧастьДокумента.НайтиСтроки(ОтборИндекс);
		Если НайтиИндексКомнаты.Количество() > 0 Тогда
			ИндексКомнаты = НайтиИндексКомнаты[НайтиИндексКомнаты.Количество()-1].НомерСтроки;
			НоваяСтрокаДокумента = ТабличнаяЧастьДокумента.Вставить(ИндексКомнаты);					
		Иначе	
			НоваяСтрокаДокумента = ТабличнаяЧастьДокумента.Добавить();					
		КонецЕсли;	
	КонецЕсли;
				
	ЗаполнитьЗначенияСвойств(НоваяСтрокаДокумента, ДанныеСтроки);	
	
	Возврат НоваяСтрокаДокумента;
	
КонецФункции

Функция ДобавитьОбновитьСтрокуВТЧЗаказДоговора(ТабличнаяЧастьДокумента, СтрокаТЧИсточник, ДополнительныеДанныеСтроки) Экспорт
	
	ОтборСтрока = Новый Структура("Комната, Номенклатура, НомерПотолка, ЗагруженоИзПостроителя", ДополнительныеДанныеСтроки.Комната, СтрокаТЧИсточник.Номенклатура, ДополнительныеДанныеСтроки.НомерПотолка, Истина);
	НайденнаяСтрока = ТабличнаяЧастьДокумента.НайтиСтроки(ОтборСтрока);
	
	Если НайденнаяСтрока.Количество() > 0 Тогда
		НоваяСтрокаДокумента = НайденнаяСтрока[0];
	Иначе
		//НоваяСтрокаДокумента = ТабличнаяЧастьДокумента.Добавить();
		//Нужно указать индекс чтобы вставить в нужную комнату
		ОтборИндекс = Новый Структура("Комната", ДополнительныеДанныеСтроки.Комната);
		НайтиИндексКомнаты = ТабличнаяЧастьДокумента.НайтиСтроки(ОтборИндекс);
		Если НайтиИндексКомнаты.Количество() > 0 Тогда
			ИндексКомнаты = НайтиИндексКомнаты[НайтиИндексКомнаты.Количество()-1].НомерСтроки;
			НоваяСтрокаДокумента = ТабличнаяЧастьДокумента.Вставить(ИндексКомнаты);					
		Иначе	
			НоваяСтрокаДокумента = ТабличнаяЧастьДокумента.Добавить();					
		КонецЕсли;
	КонецЕсли;
				
	ЗаполнитьЗначенияСвойств(НоваяСтрокаДокумента, СтрокаТЧИсточник);
	НоваяСтрокаДокумента.Спецификация = ОбщийМодульВызовСервера.ПолучитьОсновнуюСпецификациюНоменклатуры(НоваяСтрокаДокумента.Номенклатура, Перечисления.ВидыСпецификации.СопутствующиеМатериалы);
	ЗаполнитьЗначенияСвойств(НоваяСтрокаДокумента, ДополнительныеДанныеСтроки);
	
	Возврат НоваяСтрокаДокумента;
	
КонецФункции

Процедура ОбработатьЗагрузкуМатериаловВДокументРозницы(НоменклатураПотолок, Комната, ТЧМатериалы, ТЧМатериалыСлужебная=Неопределено, ТЧМатериалыИсточник) Экспорт
	
	Для Каждого ТекМатериал Из ТЧМатериалыИсточник Цикл
		Если ТекМатериал.РезультатРасширеннойОбработки Тогда
			
			ОтборСтрок = Новый Структура("Номенклатура, ХарактеристикаНоменклатуры, ЗагруженоИзПостроителя, Потолок, Комната, КлючУникальности", 
										ТекМатериал.Номенклатура, Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка(), Истина, НоменклатураПотолок, Комната, ТекМатериал.КлючУникальности);
			
			КоличествоСлужебная = 0;
			Если НЕ ТЧМатериалыСлужебная = Неопределено Тогда
				НайденныеСтроки = ТЧМатериалыСлужебная.НайтиСтроки(ОтборСтрок);
				Если НайденныеСтроки.Количество() > 0 Тогда
					КоличествоСлужебная = НайденныеСтроки[0].Количество;
				КонецЕсли;
			КонецЕсли;
		
			ОтборСтрок = Новый Структура("Номенклатура, ХарактеристикаНоменклатуры, Комната", 
										ТекМатериал.Номенклатура, Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка(), Комната);
			
			НайденныеСтроки = ТЧМатериалы.НайтиСтроки(ОтборСтрок);
			Если НайденныеСтроки.Количество() > 0 Тогда
				НоваяСтрока = НайденныеСтроки[0];
				НоваяСтрока.Количество = НайденныеСтроки[0].Количество - КоличествоСлужебная + ТекМатериал.Количество;
			Иначе
				НоваяСтрока = ТЧМатериалы.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекМатериал);
				НоваяСтрока.Комната = Комната;
			КонецЕсли;
			
		КонецЕсли;
	КонецЦикла;
	
	Если НЕ ТЧМатериалыСлужебная = Неопределено Тогда	
		Колво = ТЧМатериалыСлужебная.Количество();	
		Для Инд = 1 По Колво Цикл
			Если ТЧМатериалыСлужебная[Колво - Инд].Комната = Комната И ТЧМатериалыСлужебная[Колво - Инд].Потолок = НоменклатураПотолок Тогда
				ТЧМатериалыСлужебная.Удалить(Колво - Инд);
			КонецЕсли;
		КонецЦикла;
		Для каждого ТекМатериал Из ТЧМатериалыИсточник Цикл
			НоваяСтрока = ТЧМатериалыСлужебная.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекМатериал);
			НоваяСтрока.Комната = Комната;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

Процедура ПроставитьИРассчитатьДанныеПоПрайсу(ТекущаяСтрока) Экспорт
	
	ОбработкаТабличныхЧастейКлиентСервер.ПроставитьИРассчитатьДанныеПоПрайсу(ТекущаяСтрока);	
	
КонецПроцедуры

#КонецОбласти


#Область ОбработкаТабличныхЧастей_Монтаж

Процедура ОбработатьЗагрузкуМатериаловВМонтаж(НоменклатураПотолок, Комната, ТЧМатериалы, ТЧМатериалыИсточник) Экспорт
	
	Для Каждого ТекМатериал Из ТЧМатериалыИсточник Цикл
		Если ТекМатериал.РезультатРасширеннойОбработки Тогда
			
			ОтборСтрок = Новый Структура("Номенклатура, ХарактеристикаНоменклатуры, Комната", 
										ТекМатериал.Номенклатура, Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка(), Комната);
			
			НайденныеСтроки = ТЧМатериалы.НайтиСтроки(ОтборСтрок);
			Если НайденныеСтроки.Количество() > 0 Тогда
				НоваяСтрока = НайденныеСтроки[0];
				НоваяСтрока.Количество = НоваяСтрока.Количество + ТекМатериал.Количество;
			Иначе
				НоваяСтрока = ТЧМатериалы.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекМатериал);
				НоваяСтрока.Комната = Комната;
			КонецЕсли;
			
		КонецЕсли;
	КонецЦикла;
			
КонецПроцедуры

#КонецОбласти

#Область ОбработкаТабличныхЧастей_ЗаказПокупателя

Функция ДобавитьОбновитьПотолокВТЧЗаказПокупателя(ТабличнаяЧастьДокумента, СтрокаДокумента, ДанныеСтроки, Знач УИСтроки = Неопределено) Экспорт
	
	Если УИСтроки = Неопределено Тогда
		УИСтроки = "";
	КонецЕсли;
	
	//Если СтрокаДокумента = Неопределено Тогда
	//	НоваяСтрокаДокумента = ТабличнаяЧастьДокумента.Добавить();
	//Иначе
	//	НоваяСтрокаДокумента = СтрокаДокумента;
	//КонецЕсли;
	
	//ОтборСтрока = Новый Структура("Номенклатура, ЗагруженоИзПостроителя", ДанныеСтроки.Номенклатура, Истина);
	ОтборСтрока = Новый Структура;
	ОтборСтрока.Вставить("Номенклатура", ДанныеСтроки.Номенклатура);
	ОтборСтрока.Вставить("УИСтроки", УИСтроки);
	НайденнаяСтрока = ТабличнаяЧастьДокумента.НайтиСтроки(ОтборСтрока);
	Если НайденнаяСтрока.Количество() > 0 Тогда
		НоваяСтрокаДокумента = НайденнаяСтрока[0];
	Иначе
		НоваяСтрокаДокумента = ТабличнаяЧастьДокумента.Добавить();					
	КонецЕсли;
				
	ЗаполнитьЗначенияСвойств(НоваяСтрокаДокумента, ДанныеСтроки);
	НоваяСтрокаДокумента.УИСтроки = УИСтроки;
	
	Возврат НоваяСтрокаДокумента;
	
КонецФункции

Функция ДобавитьОбновитьСтрокуВТЧЗаказПокупателя(ТабличнаяЧастьДокумента, СтрокаТЧИсточник, ДополнительныеДанныеСтроки, ВставитьПередНомерСтроки = Неопределено, ИзменятьВыработку = Ложь) Экспорт
	
	ОтборСтрока = Новый Структура("Номенклатура, Потолок, ЗагруженоИзПостроителя", СтрокаТЧИсточник.Номенклатура, ДополнительныеДанныеСтроки.Потолок, Истина);
	НайденнаяСтрока = ТабличнаяЧастьДокумента.НайтиСтроки(ОтборСтрока);
	
	Если НайденнаяСтрока.Количество() > 0 Тогда
		НоваяСтрокаДокумента = НайденнаяСтрока[0];
	Иначе
		//++ №14059 добавлена вставка после позициции
		//НоваяСтрокаДокумента = ТабличнаяЧастьДокумента.Добавить();
		НоваяСтрокаДокумента = ?(ВставитьПередНомерСтроки = Неопределено, ТабличнаяЧастьДокумента.Добавить(), ТабличнаяЧастьДокумента.Вставить(ВставитьПередНомерСтроки));
		//-- №14059
	КонецЕсли;
				
	ЗаполнитьЗначенияСвойств(НоваяСтрокаДокумента, СтрокаТЧИсточник);
	ЗаполнитьЗначенияСвойств(НоваяСтрокаДокумента, ДополнительныеДанныеСтроки);
	
	Если ИзменятьВыработку Тогда
		НоваяСтрокаДокумента.КоличествоКВыработке = НоваяСтрокаДокумента.Количество; // №14311
	КонецЕсли;
	
	Возврат НоваяСтрокаДокумента;
	
КонецФункции

Процедура ОкруглитьСтоимостьПотолковВЗаказеПокупателя(ТабличнаяЧастьДокумента, НоменклатураПотолка) Экспорт
	
	ПорядокОкругления = Константы.ПорядокОкругленияЧисломСтоимостиПотолков.Получить();
	//ТребуетсяОкругление = НЕ ПорядокОкругления = Перечисления.ПорядкиОкругления.ПустаяСсылка();
	//ТребуетсяОкругление = (ПорядокОкругления > 0);
	ТребуетсяОкругление = Константы.ОкруглятьСтоимостьПотолка.Получить() И (ПорядокОкругления > 0);
	Если ТребуетсяОкругление Тогда		
		ОкруглятьВБольшуюСторону = Константы.ОкруглятьВБольшуюСторонуСтоимостьПотолков.Получить();
		СпособОкругления = Константы.СпособОкругленияСтоимостиПотолков.Получить();
		ВариантОкругления = Константы.ВариантОкругленияСтоимостиПотолков.Получить();
		ТребуетсяОкруглениеСоставляющих = ТребуетсяОкругление И СпособОкругления = 1;
		ТребуетсяОкруглениеПотолка    = ТребуетсяОкругление И СпособОкругления = 0;
		НайденныеСтроки = ТабличнаяЧастьДокумента.НайтиСтроки(Новый Структура("Потолок", НоменклатураПотолка));
		
		Если ТребуетсяОкруглениеСоставляющих Тогда
			Для каждого СтрокаТЧ из НайденныеСтроки Цикл
				ОбработкаТабличныхЧастейСервер.ОкруглитьСтрокуТЧ(СтрокаТЧ, ПорядокОкругления, ОкруглятьВБольшуюСторону, ВариантОкругления, "ПроцентРучнойСкидки", "СуммаРучнойСкидки");
			КонецЦикла;
		ИначеЕсли ТребуетсяОкруглениеПотолка Тогда
			ИтоговаяСуммаПотолка = 0;
			Для каждого СтрокаТЧ из НайденныеСтроки Цикл
				ИтоговаяСуммаПотолка = ИтоговаяСуммаПотолка + СтрокаТЧ.Сумма;
			КонецЦикла;
			ОкругленнаяИтоговаяСуммаПотолка = ОбщийМодуль.ОкруглитьЧисло(ИтоговаяСуммаПотолка, ПорядокОкругления, ОкруглятьВБольшуюСторону);
			НайденнаяСтрокаПотолка = ТабличнаяЧастьДокумента.НайтиСтроки(Новый Структура("Номенклатура", НоменклатураПотолка));
			Если НайденнаяСтрокаПотолка.Количество() > 0  Тогда
				НайденнаяСтрокаПотолка[0].Сумма = НайденнаяСтрокаПотолка[0].Сумма - (ИтоговаяСуммаПотолка - ОкругленнаяИтоговаяСуммаПотолка); 
				
				Если ВариантОкругления = 0 Тогда
					//изменять цену после округления
					Если НЕ НайденнаяСтрокаПотолка[0].Количество = 0 Тогда
						СуммаБезСкидки = НайденнаяСтрокаПотолка[0].Сумма + НайденнаяСтрокаПотолка[0].СуммаРучнойСкидки;
						НайденнаяСтрокаПотолка[0].Цена = Окр(СуммаБезСкидки / НайденнаяСтрокаПотолка[0].Количество, 2);
					КонецЕсли;
				Иначе
					//изменять сумму ручной скидки
					НайденнаяСтрокаПотолка[0].СуммаРучнойСкидки = НайденнаяСтрокаПотолка[0].СуммаРучнойСкидки + (ИтоговаяСуммаПотолка - ОкругленнаяИтоговаяСуммаПотолка);
					ОбработкаТабличныхЧастейСервер.ПересчитатьПроцентРучнойСкидкиВСтрокеТЧ(НайденнаяСтрокаПотолка[0], "ПроцентРучнойСкидки", "СуммаРучнойСкидки");					
				КонецЕсли;
				
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти


#Область ОбработкаТабличныхЧастей_ЗаказНаПроизводство

Функция ДобавитьОбновитьСтрокуВТЧЗаказНаПроизводство(ТабличнаяЧастьДокумента, СтрокаТЧИсточник, ДополнительныеДанныеСтроки) Экспорт
	
	ОтборСтрока = Новый Структура("Номенклатура, ЗагруженоИзПостроителя", СтрокаТЧИсточник.Номенклатура, Истина);
	НайденнаяСтрока = ТабличнаяЧастьДокумента.НайтиСтроки(ОтборСтрока);
	
	Если НайденнаяСтрока.Количество() > 0 Тогда
		НоваяСтрокаДокумента = НайденнаяСтрока[0];
	Иначе
		НоваяСтрокаДокумента = ТабличнаяЧастьДокумента.Добавить();					
