Процедура ИдентифицироватьНоменклатуру(ТаблицаДанных, СпособПоискаНоменклатуры, ЕдиницаИзмеренияНовойНоменклатуры = Неопределено)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СпрНоменклатура.Артикул КАК Артикул,
	|	СпрНоменклатура.Ссылка КАК Номенклатура,
	|	СпрНоменклатура.Наименование КАК Наименование
	|ИЗ
	|	Справочник.Номенклатура КАК СпрНоменклатура
	|ГДЕ
	|	НЕ СпрНоменклатура.ЭтоГруппа";
	
	ТаблицаНоменклатуры = Запрос.Выполнить().Выгрузить();
		
	Для каждого ТекущаяСтрока из ТаблицаДанных Цикл
		
		Если ЗначениеЗаполнено(ТекущаяСтрока.Номенклатура) Тогда
			Продолжить;	
		КонецЕсли;
		
		ПоляПоискаШаг1 = "";
		Если СпособПоискаНоменклатуры = Перечисления.СпособыПоискаНоменклатуры.ТолькоПоАртикулу
			И ЗначениеЗаполнено(ТекущаяСтрока.Артикул) Тогда
		    ПоляПоискаШаг1 = "Артикул";
		ИначеЕсли СпособПоискаНоменклатуры = Перечисления.СпособыПоискаНоменклатуры.ПоАртикулуПоНаименованию
			И ЗначениеЗаполнено(ТекущаяСтрока.Артикул) Тогда
		    ПоляПоискаШаг1 = "Артикул";
		ИначеЕсли СпособПоискаНоменклатуры = Перечисления.СпособыПоискаНоменклатуры.ТолькоПоНаименованию
			И ЗначениеЗаполнено(ТекущаяСтрока.Наименование) Тогда
		    ПоляПоискаШаг1 = "Наименование";
		ИначеЕсли СпособПоискаНоменклатуры = Перечисления.СпособыПоискаНоменклатуры.ПоНаименованиюПоАртикулу
			И ЗначениеЗаполнено(ТекущаяСтрока.Наименование) Тогда
		    ПоляПоискаШаг1 = "Наименование";
		ИначеЕсли СпособПоискаНоменклатуры = Перечисления.СпособыПоискаНоменклатуры.ПоАртикулуПоНаименованиюВместе
			И (ЗначениеЗаполнено(ТекущаяСтрока.Артикул) ИЛИ ЗначениеЗаполнено(ТекущаяСтрока.Наименование)) Тогда
		    ПоляПоискаШаг1 = "Артикул, Наименование";	
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ПоляПоискаШаг1) Тогда
			СтруктураПоиска = Новый Структура(ПоляПоискаШаг1);
				ЗаполнитьЗначенияСвойств(СтруктураПоиска, ТекущаяСтрока);
			НайденныеСтроки = ТаблицаНоменклатуры.НайтиСтроки(СтруктураПоиска);
			Если НайденныеСтроки.Количество() > 0 Тогда
				ТекущаяСтрока.Номенклатура = НайденныеСтроки[0].Номенклатура;
			КонецЕсли;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(ТекущаяСтрока.Номенклатура) Тогда			
			ПоляПоискаШаг2 = "";
			Если СпособПоискаНоменклатуры = Перечисления.СпособыПоискаНоменклатуры.ПоАртикулуПоНаименованию
				И ЗначениеЗаполнено(ТекущаяСтрока.Наименование) Тогда
				ПоляПоискаШаг2 = "Наименование";
			ИначеЕсли СпособПоискаНоменклатуры = Перечисления.СпособыПоискаНоменклатуры.ПоНаименованиюПоАртикулу
				И ЗначениеЗаполнено(ТекущаяСтрока.Артикул) Тогда
				ПоляПоискаШаг2 = "Артикул";	
			КонецЕсли;
			
			Если ЗначениеЗаполнено(ПоляПоискаШаг2) Тогда
				СтруктураПоиска = Новый Структура(ПоляПоискаШаг2);
				ЗаполнитьЗначенияСвойств(СтруктураПоиска, ТекущаяСтрока);
				НайденныеСтроки = ТаблицаНоменклатуры.НайтиСтроки(СтруктураПоиска);
				Если НайденныеСтроки.Количество() > 0 Тогда
					ТекущаяСтрока.Номенклатура = НайденныеСтроки[0].Номенклатура;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		// Нужно найти характеристику при наличии
		Если ЗначениеЗаполнено(ТекущаяСтрока.Характеристика)
			И ТекущаяСтрока.ХарактеристикаНоменклатуры.Пустая() 
			И НЕ ТекущаяСтрока.Номенклатура.Пустая() Тогда
			ТекущаяСтрока.ХарактеристикаНоменклатуры = Справочники.ХарактеристикиНоменклатуры.НайтиПоНаименованию(ТекущаяСтрока.Характеристика, Истина,, ТекущаяСтрока.Номенклатура);
		КонецЕсли;

		// единица измерения
		Если ЗначениеЗаполнено(ТекущаяСтрока.ЕдиницаИзмеренияСтрокой) Тогда
			ТекущаяСтрока.ЕдиницаИзмерения = Справочники.КлассификаторЕдиницИзмерения.НайтиПоНаименованию(ТекущаяСтрока.ЕдиницаИзмеренияСтрокой, Истина);
			Если ЗначениеЗаполнено(ТекущаяСтрока.Номенклатура)
				И НЕ ТекущаяСтрока.ЕдиницаИзмерения = ТекущаяСтрока.Номенклатура.БазоваяЕдиницаИзмерения Тогда
				ТекущаяСтрока.ЕдиницаИзмерения = ТекущаяСтрока.Номенклатура.БазоваяЕдиницаИзмерения;
			КонецЕсли;
			
		ИначеЕсли ЗначениеЗаполнено(ТекущаяСтрока.Номенклатура) Тогда
			ТекущаяСтрока.ЕдиницаИзмерения = ТекущаяСтрока.Номенклатура.БазоваяЕдиницаИзмерения;
			
		ИначеЕсли НЕ ЕдиницаИзмеренияНовойНоменклатуры = Неопределено Тогда
			ТекущаяСтрока.ЕдиницаИзмерения = ЕдиницаИзмеренияНовойНоменклатуры;
			
	    КонецЕсли;
	КонецЦикла;
		
КонецПроцедуры

Функция СоздатьНоменклатуруПоТаблице(ДанныеКЗагрузке, ПараметрыЗагрузки)
	
	Если ПараметрыЗагрузки.ВидНовойНоменклатуры.Пустая() Тогда
		ТекстОшибки = "Не указан вид создаваемой номенклатуры";
		ЗафиксироватьОшибкуЗагрузки(ПараметрыЗагрузки.Ссылка, ТекстОшибки);
		Возврат Ложь;
	КонецЕсли;
		
	Для Каждого ТекущаяСтрока Из ДанныеКЗагрузке Цикл	
		
		Если ТекущаяСтрока.ЕдиницаИзмерения.Пустая() Тогда
			Продолжить;
		КонецЕсли;		
		
		Если НЕ ЗначениеЗаполнено(ТекущаяСтрока.Номенклатура) Тогда			
			
			НоваяНоменклатура = Справочники.Номенклатура.СоздатьЭлемент();
			НоваяНоменклатура.Заполнить(Неопределено);
			НоваяНоменклатура.УстановитьНовыйКод(); // #16295
			НоваяНоменклатура.Наименование = ТекущаяСтрока.Наименование;
			НоваяНоменклатура.НаименованиеДляПечати = ?(ЗначениеЗаполнено(ТекущаяСтрока.НаименованиеДляПечати), ТекущаяСтрока.НаименованиеДляПечати, ТекущаяСтрока.Наименование);
			НоваяНоменклатура.Артикул = ТекущаяСтрока.Артикул;
			НоваяНоменклатура.Родитель = ПараметрыЗагрузки.ГруппаНовойНоменклатуры;
			НоваяНоменклатура.ВидНоменклатуры = ПараметрыЗагрузки.ВидНовойНоменклатуры;				
			
			//Базовая ед. изм.
			НоваяНоменклатура.БазоваяЕдиницаИзмерения = ТекущаяСтрока.ЕдиницаИзмерения;
			
			Попытка
				НоваяНоменклатура.ОбменДанными.Загрузка = Истина;
				НоваяНоменклатура.Записать();				
			Исключение
				Продолжить;
			КонецПопытки;
			
			СтруктураПоиска = Новый Структура("Наименование, Артикул", ТекущаяСтрока.Наименование, ТекущаяСтрока.Артикул);
			ИдентичныеПозиции = ДанныеКЗагрузке.НайтиСтроки(СтруктураПоиска);
			Для каждого НайденнаяСтрока из ИдентичныеПозиции Цикл
				НайденнаяСтрока.Номенклатура = НоваяНоменклатура.Ссылка;
			КонецЦикла;
			
		ИначеЕсли ПараметрыЗагрузки.ОбновлятьДанныеНоменклатуры
			И ПараметрыЗагрузки.СпособПоискаНоменклатуры = Перечисления.СпособыПоискаНоменклатуры.ТолькоПоАртикулу Тогда
			
			СпрОбъект = ТекущаяСтрока.Номенклатура.ПолучитьОбъект();
			Если НЕ СпрОбъект.Наименование = ТекущаяСтрока.Наименование Тогда
				СпрОбъект.Наименование = ТекущаяСтрока.Наименование;
				СпрОбъект.НаименованиеДляПечати = ?(ЗначениеЗаполнено(ТекущаяСтрока.НаименованиеДляПечати), ТекущаяСтрока.НаименованиеДляПечати, ТекущаяСтрока.Наименование);
				
				Попытка
					СпрОбъект.ОбменДанными.Загрузка = Истина;
					СпрОбъект.Записать();				
				Исключение
					Продолжить;
				КонецПопытки;
			КонецЕсли;
			
		КонецЕсли;
		  		
		//Проверим / создадим характеристики
		Если ЗначениеЗаполнено(ТекущаяСтрока.Характеристика) И НЕ ЗначениеЗаполнено(ТекущаяСтрока.ХарактеристикаНоменклатуры) Тогда
			НайденнаяХарактеристика = Справочники.ХарактеристикиНоменклатуры.НайтиПоНаименованию(ТекущаяСтрока.Характеристика, Истина,,НоваяНоменклатура.Ссылка);
			Если НайденнаяХарактеристика.Пустая() Тогда
				НоваяХарактеристика = Справочники.ХарактеристикиНоменклатуры.СоздатьЭлемент();
				НоваяХарактеристика.Владелец = ТекущаяСтрока.Номенклатура;
				НоваяХарактеристика.Наименование = ТекущаяСтрока.Характеристика;
				Попытка
					НоваяХарактеристика.Записать();
				Исключение
					
				КонецПопытки;	
			КонецЕсли;	
		КонецЕсли;	
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

Функция СоздатьУстановкуЦенПоТаблице(ДанныеКЗагрузке, ПараметрыЗагрузки)
	
	Если ПараметрыЗагрузки.ВидЦены.Пустая() Тогда
		ТекстОшибки = "Не указан вид цены";
		ЗафиксироватьОшибкуЗагрузки(ПараметрыЗагрузки.Ссылка, ТекстОшибки);
		Возврат Ложь;
	КонецЕсли;
	
	ТаблицаДанных = ДанныеКЗагрузке.Скопировать(, "Номенклатура, ХарактеристикаНоменклатуры, ЕдиницаИзмерения, Цена");
	
	Запрос = Новый запрос;
	Запрос.УстановитьПараметр("ТаблицаДанных", ТаблицаДанных);
	Запрос.УстановитьПараметр("ВидЦены", ПараметрыЗагрузки.ВидЦены);
	Запрос.УстановитьПараметр("ЗагружатьТолькоИзмененныеЦены", ПараметрыЗагрузки.ЗагружатьТолькоИзмененныеЦены);
	
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТаблицаДанных.Номенклатура КАК Номенклатура,
	|	ТаблицаДанных.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	|	ТаблицаДанных.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	ТаблицаДанных.Цена КАК Цена
	|ПОМЕСТИТЬ ВТ
	|ИЗ
	|	&ТаблицаДанных КАК ТаблицаДанных
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВТ.Номенклатура КАК Номенклатура,
	|	ВТ.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	|	ВТ.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	&ВидЦены КАК ВидЦены,
	|	ВТ.Цена КАК Цена
	|ИЗ
	|	ВТ КАК ВТ
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЦеныНоменклатуры.СрезПоследних(, ВидЦены = &ВидЦены) КАК ТекущиеЦены
	|		ПО (ТекущиеЦены.Номенклатура = ВТ.Номенклатура)
	|			И (ТекущиеЦены.ХарактеристикаНоменклатуры = ВТ.ХарактеристикаНоменклатуры)
	|			И (ТекущиеЦены.ЕдиницаИзмерения = ВТ.ЕдиницаИзмерения)
	|ГДЕ
	|	НЕ ВТ.Номенклатура = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	|	И ВЫБОР
	|			КОГДА &ЗагружатьТолькоИзмененныеЦены
	|				ТОГДА НЕ ВТ.Цена = ЕСТЬNULL(ТекущиеЦены.Цена, 0)
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ";
	
	ТаблицаДанных = Запрос.Выполнить().Выгрузить();
	
	Если ТаблицаДанных.Количество() = 0 Тогда
		Возврат Истина;
	КонецЕсли;
	
	ДокОбъект = Документы.УстановкаЦенНоменклатуры.СоздатьДокумент();	
	ДокОбъект.Заполнить(Неопределено);
	ДокОбъект.Дата = ТекущаяДатаСеанса();
	ДокОбъект.НеРегистрировытьНулевыеЦены = Истина;
	ДокОбъект.Валюта = ПолучитьФункциональнуюОпцию("ВалютаУчета");
	ДокОбъект.Комментарий = "#Загрузка данных из внешних источников#";
	
	НоваяСтрока = ДокОбъект.ВидыЦен.Добавить();
	НоваяСтрока.ВидЦены = ПараметрыЗагрузки.ВидЦены;
	
	Для каждого СтрокаТЗ из ТаблицаДанных Цикл
		НоваяСтрока = ДокОбъект.Товары.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТЗ);
	КонецЦикла;
	
	Попытка
		ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
		Возврат Истина;
	Исключение
		ТекстОшибки = ОписаниеОшибки();
		ЗафиксироватьОшибкуЗагрузки(ПараметрыЗагрузки.Ссылка, ТекстОшибки);
		Возврат Ложь;
	КонецПопытки;
	
КонецФункции
		
		