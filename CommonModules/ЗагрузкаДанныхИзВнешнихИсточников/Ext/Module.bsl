
Процедура ЗагрузкаДанныхИзВнешнихИсточников(КодЭлемента) Экспорт
	
	ОбщегоНазначения.ПриНачалеВыполненияРегламентногоЗадания(
		Метаданные.РегламентныеЗадания.ЗагрузкаДанныхИзВнешнихИсточников);
	
	НастройкаЗагрузки = Справочники.ЗагрузкаДанныхИзВнешнихИсточников.НайтиПоКоду(КодЭлемента);
	
	Если НЕ ЗначениеЗаполнено(НастройкаЗагрузки) Тогда
		ТекстОшибки = "Не найден элемент с кодом" + " " + КодЭлемента;
		ЗафиксироватьОшибкуЗагрузки(НастройкаЗагрузки, ТекстОшибки);		
		Возврат;		
	КонецЕсли;
	
	ЗагрузкаДанных(НастройкаЗагрузки);

КонецПроцедуры
	
Процедура ЗагрузкаДанных(НастройкаЗагрузки) Экспорт

	ПараметрыЗагрузки = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(НастройкаЗагрузки, "ОбъектЗагрузки, Источник");
	РезультатЗагрузки = Ложь;
	ДатаНачала = ТекущаяДатаСеанса();
	
	Если ПараметрыЗагрузки.ОбъектЗагрузки = Перечисления.ТипыОбъектовЗагрузкиИзВнешнихИсточников.СправочникНоменклатура Тогда
		Если ПараметрыЗагрузки.Источник = Перечисления.ТипыИсточниковЗагрузкиИзВнешнихИсточников.ФайлExcel 
			ИЛИ ПараметрыЗагрузки.Источник = Перечисления.ТипыИсточниковЗагрузкиИзВнешнихИсточников.ФайлExcelURL
			Тогда
			РезультатЗагрузки = Загрузить_СправочникНоменклатура_ИзExcel(НастройкаЗагрузки);
			
		ИначеЕсли ПараметрыЗагрузки.Источник = Перечисления.ТипыИсточниковЗагрузкиИзВнешнихИсточников.ФайлCSV 
			ИЛИ ПараметрыЗагрузки.Источник = Перечисления.ТипыИсточниковЗагрузкиИзВнешнихИсточников.ФайлCSVURL
			Тогда
			РезультатЗагрузки = Загрузить_СправочникНоменклатура_ИзCSV(НастройкаЗагрузки);
			
		КонецЕсли;
		
	ИначеЕсли ПараметрыЗагрузки.ОбъектЗагрузки = Перечисления.ТипыОбъектовЗагрузкиИзВнешнихИсточников.ДокументУстановкаЦенНоменклатуры Тогда		
		Если ПараметрыЗагрузки.Источник = Перечисления.ТипыИсточниковЗагрузкиИзВнешнихИсточников.ФайлExcel 
			ИЛИ ПараметрыЗагрузки.Источник = Перечисления.ТипыИсточниковЗагрузкиИзВнешнихИсточников.ФайлExcelURL Тогда
			РезультатЗагрузки = Загрузить_ДокументУстановкаЦенНоменклатуры_ИзExcel(НастройкаЗагрузки);
			
		ИначеЕсли ПараметрыЗагрузки.Источник = Перечисления.ТипыИсточниковЗагрузкиИзВнешнихИсточников.ФайлCSV 
			ИЛИ ПараметрыЗагрузки.Источник = Перечисления.ТипыИсточниковЗагрузкиИзВнешнихИсточников.ФайлCSVURL
			Тогда
			РезультатЗагрузки = Загрузить_ДокументУстановкаЦенНоменклатуры_ИзCSV(НастройкаЗагрузки);

		КонецЕсли;
		
	КонецЕсли;
	
	// состояние обмена
	ЗафиксироватьСостояниеЗагрузки(НастройкаЗагрузки, ДатаНачала, РезультатЗагрузки);
	
КонецПроцедуры

Функция ПолучитьПутьКФайлу(ПараметрыЗагрузки)
	
	ПутьКФайлу = ПараметрыЗагрузки.ПутьКФайлу;
	
	Если ПараметрыЗагрузки.Источник = Перечисления.ТипыИсточниковЗагрузкиИзВнешнихИсточников.ФайлExcelURL Тогда
		
		РезультатЗагрузкиФайла = ОбщийМодульКлиентСервер.ПолучитьФайлЗаписиПоHttpСсылке(ПараметрыЗагрузки.ПутьКФайлу, Ложь, ".xlsx");
		//РезультатЗагрузкиФайла = ОбщийМодульКлиентСервер.ПолучитьФайлЗаписиПоHttpСсылке(ПараметрыЗагрузки.ПутьКФайлу, Ложь, ".xls");
		Если НЕ РезультатЗагрузкиФайла.КодОтвета = 200 Тогда
			ТекстОшибки = "Ошибка загрузки файла по URL, код: " + " " + РезультатЗагрузкиФайла.КодОтвета;
			ЗафиксироватьОшибкуЗагрузки(ПараметрыЗагрузки.Ссылка, ТекстОшибки);		
			Возврат Ложь;	
		КонецЕсли;
		ПутьКФайлу = РезультатЗагрузкиФайла.ПутьКФайлу;
		
	ИначеЕсли ПараметрыЗагрузки.Источник = Перечисления.ТипыИсточниковЗагрузкиИзВнешнихИсточников.ФайлCSVURL Тогда

		РезультатЗагрузкиФайла = ОбщийМодульКлиентСервер.ПолучитьФайлЗаписиПоHttpСсылке(ПараметрыЗагрузки.ПутьКФайлу, Ложь, ".csv");
		Если НЕ РезультатЗагрузкиФайла.КодОтвета = 200 Тогда
			ТекстОшибки = "Ошибка загрузки файла по URL, код: " + " " + РезультатЗагрузкиФайла.КодОтвета;
			ЗафиксироватьОшибкуЗагрузки(ПараметрыЗагрузки.Ссылка, ТекстОшибки);		
			Возврат Ложь;	
		КонецЕсли;
		ПутьКФайлу = РезультатЗагрузкиФайла.ПутьКФайлу;
		
	КонецЕсли;
	
	Возврат ПутьКФайлу;
	
КонецФункции

Функция ПустаяТаблицаЗагрузкиНоменклатуры()
	
	ДанныеКЗагрузке = Новый ТаблицаЗначений;
	ДанныеКЗагрузке.Колонки.Добавить("Наименование");
	ДанныеКЗагрузке.Колонки.Добавить("НаименованиеДляПечати");
	ДанныеКЗагрузке.Колонки.Добавить("ЕдиницаИзмеренияСтрокой");
	ДанныеКЗагрузке.Колонки.Добавить("Артикул");
	ДанныеКЗагрузке.Колонки.Добавить("Характеристика");
	
	ДанныеКЗагрузке.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ДанныеКЗагрузке.Колонки.Добавить("ХарактеристикаНоменклатуры", Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры"));
	ДанныеКЗагрузке.Колонки.Добавить("ЕдиницаИзмерения", Новый ОписаниеТипов("СправочникСсылка.КлассификаторЕдиницИзмерения"));
	
	Возврат ДанныеКЗагрузке;
	
КонецФункции

Функция ПустаяТаблицаЗагрузкиЦенНоменклатуры()
	
	ДанныеКЗагрузке = Новый ТаблицаЗначений;
	ДанныеКЗагрузке.Колонки.Добавить("Наименование");
	ДанныеКЗагрузке.Колонки.Добавить("ЕдиницаИзмеренияСтрокой");
	ДанныеКЗагрузке.Колонки.Добавить("Артикул");
	ДанныеКЗагрузке.Колонки.Добавить("Характеристика");
	ДанныеКЗагрузке.Колонки.Добавить("Цена", Новый ОписаниеТипов("Число", ,, Новый КвалификаторыЧисла(15,2)));
	
	ДанныеКЗагрузке.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ДанныеКЗагрузке.Колонки.Добавить("ХарактеристикаНоменклатуры", Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры"));
	ДанныеКЗагрузке.Колонки.Добавить("ЕдиницаИзмерения", Новый ОписаниеТипов("СправочникСсылка.КлассификаторЕдиницИзмерения"));
	
	Возврат ДанныеКЗагрузке;
		
КонецФункции

Функция Загрузить_СправочникНоменклатура_ИзExcel(НастройкаЗагрузки)
	
	ТекстОшибки = "";
	
	ПараметрыЗагрузки = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(НастройкаЗагрузки, "Ссылка, Источник, ПутьКФайлу, 
																					  |СпособПоискаНоменклатуры, 
																					  |ВидНовойНоменклатуры, ГруппаНовойНоменклатуры, ЕдиницаИзмеренияНовойНоменклатуры,
																					  |НомерНачальнойСтроки, НомерКолонкиНаименование, НомерКолонкиНаименованиеДляПечати,
																					  |НомерКолонкиХарактеристика, НомерКолонкиАртикул, НомерКолонкиЕдиницаИзмерения,
																					  |ОбновлятьДанныеНоменклатуры");
	
	ПутьКФайлу = ПолучитьПутьКФайлу(ПараметрыЗагрузки);
		
	ТабличныйДокумент = ПрочитатьФайлExcelВТабличныйДокумент(ПутьКФайлу, ТекстОшибки);
	
	Если ПараметрыЗагрузки.Источник = Перечисления.ТипыИсточниковЗагрузкиИзВнешнихИсточников.ФайлExcelURL  Тогда
		УдалитьФайлы(ПутьКФайлу);
	КонецЕсли;
	
	Если ТабличныйДокумент = Неопределено Тогда 
		ЗафиксироватьОшибкуЗагрузки(НастройкаЗагрузки, ТекстОшибки);		
		Возврат Ложь;
	КонецЕсли;
	
	ДанныеКЗагрузке = ПустаяТаблицаЗагрузкиНоменклатуры();
		
	КоличествоСтрок = ТабличныйДокумент.ПолучитьРазмерОбластиДанныхПоВертикали();
	КоличествоКолонок = ТабличныйДокумент.ПолучитьРазмерОбластиДанныхПоГоризонтали();
	
	Для НомерСтроки = ПараметрыЗагрузки.НомерНачальнойСтроки По КоличествоСтрок Цикл
		Попытка
			Наименование = ЗначениеИзОбласти(ТабличныйДокумент, НомерСтроки, ПараметрыЗагрузки.НомерКолонкиНаименование);
			Если НЕ ЗначениеЗаполнено(Наименование) Тогда
				Продолжить;
			КонецЕсли;
			
			СтрокаТЗ = ДанныеКЗагрузке.Добавить();
			СтрокаТЗ.Наименование = Наименование;
			СтрокаТЗ.НаименованиеДляПечати =  ЗначениеИзОбласти(ТабличныйДокумент, НомерСтроки, ПараметрыЗагрузки.НомерКолонкиНаименованиеДляПечати);
			СтрокаТЗ.ЕдиницаИзмеренияСтрокой = ЗначениеИзОбласти(ТабличныйДокумент, НомерСтроки, ПараметрыЗагрузки.НомерКолонкиЕдиницаИзмерения);								
			СтрокаТЗ.Артикул = ЗначениеИзОбласти(ТабличныйДокумент, НомерСтроки, ПараметрыЗагрузки.НомерКолонкиАртикул);					
			СтрокаТЗ.Характеристика = ЗначениеИзОбласти(ТабличныйДокумент, НомерСтроки, ПараметрыЗагрузки.НомерКолонкиХарактеристика);
			
		Исключение
			ТекстОшибки = "Ошибка чтения строки файла " + НомерСтроки + Символы.ПС + ОписаниеОшибки();
			ЗафиксироватьОшибкуЗагрузки(НастройкаЗагрузки, ТекстОшибки);		
			Возврат Ложь;
		КонецПопытки;
	КонецЦикла;
	
	ИдентифицироватьНоменклатуру(ДанныеКЗагрузке, ПараметрыЗагрузки.СпособПоискаНоменклатуры, ПараметрыЗагрузки.ЕдиницаИзмеренияНовойНоменклатуры);
	Результат = СоздатьНоменклатуруПоТаблице(ДанныеКЗагрузке, ПараметрыЗагрузки);
	
	Возврат Результат;
	
КонецФункции

Функция Загрузить_СправочникНоменклатура_ИзCSV(НастройкаЗагрузки)
	
	ТекстОшибки = "";
	
	ПараметрыЗагрузки = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(НастройкаЗагрузки, "Ссылка, Источник, ПутьКФайлу, РазделительCSV, КодировкаФайла,
																					  |СпособПоискаНоменклатуры, 
																					  |ВидНовойНоменклатуры, ГруппаНовойНоменклатуры, ЕдиницаИзмеренияНовойНоменклатуры,
																					  |НомерНачальнойСтроки, НомерКолонкиНаименование, НомерКолонкиНаименованиеДляПечати,
																					  |НомерКолонкиХарактеристика, НомерКолонкиАртикул, НомерКолонкиЕдиницаИзмерения,
																					  |ОбновлятьДанныеНоменклатуры");
	
	ПутьКФайлу = ПолучитьПутьКФайлу(ПараметрыЗагрузки);
		
	МассивСтрок = ОбщийМодульКлиентСервер.ПрочитатьФайлCSV(ПутьКФайлу, ПараметрыЗагрузки.КодировкаФайла, ПараметрыЗагрузки.НомерНачальнойСтроки, ТекстОшибки);
	
	Если ПараметрыЗагрузки.Источник = Перечисления.ТипыИсточниковЗагрузкиИзВнешнихИсточников.ФайлCSVURL Тогда
		УдалитьФайлы(ПутьКФайлу);
	КонецЕсли;
	
	Если МассивСтрок.Количество() = 0 Тогда 
		ТекстОшибки = "Файл загрузки пуст";
		ЗафиксироватьОшибкуЗагрузки(НастройкаЗагрузки, ТекстОшибки);		
		Возврат Ложь;
	КонецЕсли;
	
	ДанныеКЗагрузке = ПустаяТаблицаЗагрузкиНоменклатуры();
	
	РазделительCSV = ?(НЕ ПустаяСтрока(ПараметрыЗагрузки.РазделительCSV), ПараметрыЗагрузки.РазделительCSV, ";");
	
	Для каждого СтрокаФайл из МассивСтрок Цикл
		
		ЭлементыСтроки = СтрРазделить(СтрокаФайл, РазделительCSV, Истина);
		
		Попытка
			Наименование = ЗначениеИзМассива(ЭлементыСтроки, ПараметрыЗагрузки.НомерКолонкиНаименование);
			Если НЕ ЗначениеЗаполнено(Наименование) Тогда
				Продолжить;
			КонецЕсли;
			
			СтрокаТЗ = ДанныеКЗагрузке.Добавить();
			СтрокаТЗ.Наименование = Наименование;
			СтрокаТЗ.НаименованиеДляПечати =  ЗначениеИзМассива(ЭлементыСтроки, ПараметрыЗагрузки.НомерКолонкиНаименованиеДляПечати);
			СтрокаТЗ.ЕдиницаИзмеренияСтрокой = ЗначениеИзМассива(ЭлементыСтроки, ПараметрыЗагрузки.НомерКолонкиЕдиницаИзмерения);								
			СтрокаТЗ.Артикул = ЗначениеИзМассива(ЭлементыСтроки, ПараметрыЗагрузки.НомерКолонкиАртикул);					
			СтрокаТЗ.Характеристика = ЗначениеИзМассива(ЭлементыСтроки, ПараметрыЗагрузки.НомерКолонкиХарактеристика);
			
		Исключение
			ТекстОшибки = "Ошибка чтения строки файла " + СтрокаФайл + Символы.ПС + ОписаниеОшибки();
			ЗафиксироватьОшибкуЗагрузки(НастройкаЗагрузки, ТекстОшибки);		
			Возврат Ложь;
		КонецПопытки;
	КонецЦикла;
	
	ИдентифицироватьНоменклатуру(ДанныеКЗагрузке, ПараметрыЗагрузки.СпособПоискаНоменклатуры, ПараметрыЗагрузки.ЕдиницаИзмеренияНовойНоменклатуры);
	Результат = СоздатьНоменклатуруПоТаблице(ДанныеКЗагрузке, ПараметрыЗагрузки);
	
	Возврат Результат;
	
КонецФункции

Функция Загрузить_ДокументУстановкаЦенНоменклатуры_ИзExcel(НастройкаЗагрузки)
	
	ТекстОшибки = "";
	
	ПараметрыЗагрузки = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(НастройкаЗагрузки, "Ссылка, Источник, ПутьКФайлу, 
																					  |СпособПоискаНоменклатуры, 
																					  |ВидНовойНоменклатуры, ГруппаНовойНоменклатуры, ЕдиницаИзмеренияНовойНоменклатуры,
																					  |НомерНачальнойСтроки, НомерКолонкиНаименование, НомерКолонкиХарактеристика,
																					  |НомерКолонкиАртикул, НомерКолонкиЕдиницаИзмерения, НомерКолонкиЦена,
																					  |ВидЦены, ЗагружатьТолькоИзмененныеЦены");
	
	ПутьКФайлу = ПолучитьПутьКФайлу(ПараметрыЗагрузки);
	
	ТабличныйДокумент = ПрочитатьФайлExcelВТабличныйДокумент(ПутьКФайлу, ТекстОшибки);
	
	Если ПараметрыЗагрузки.Источник = Перечисления.ТипыИсточниковЗагрузкиИзВнешнихИсточников.ФайлExcelURL  Тогда
		УдалитьФайлы(ПутьКФайлу);
	КонецЕсли;
	
	Если ТабличныйДокумент = Неопределено Тогда 
		ЗафиксироватьОшибкуЗагрузки(НастройкаЗагрузки, ТекстОшибки);		
		Возврат Ложь;
	КонецЕсли;
	
	ДанныеКЗагрузке = ПустаяТаблицаЗагрузкиЦенНоменклатуры();
	
	КоличествоСтрок = ТабличныйДокумент.ПолучитьРазмерОбластиДанныхПоВертикали();
	КоличествоКолонок = ТабличныйДокумент.ПолучитьРазмерОбластиДанныхПоГоризонтали();
	
	Для НомерСтроки = ПараметрыЗагрузки.НомерНачальнойСтроки По КоличествоСтрок Цикл
		Попытка
			Наименование = ЗначениеИзОбласти(ТабличныйДокумент, НомерСтроки, ПараметрыЗагрузки.НомерКолонкиНаименование);
			Если НЕ ЗначениеЗаполнено(Наименование) Тогда
				Продолжить;
			КонецЕсли;
			
			ЦенаСтрокой = ЗначениеИзОбласти(ТабличныйДокумент, НомерСтроки, ПараметрыЗагрузки.НомерКолонкиЦена);
			Если НЕ ЗначениеЗаполнено(ЦенаСтрокой) Тогда
				Продолжить;
			КонецЕсли;

			Цена = СтроковыеФункцииКлиентСервер.СтрокаВЧисло(ЦенаСтрокой);
			Если Цена = Неопределено ИЛИ Цена = 0 Тогда
				Продолжить;	
			КонецЕсли;
			
			СтрокаТЗ = ДанныеКЗагрузке.Добавить();
			СтрокаТЗ.Наименование = Наименование;
			СтрокаТЗ.ЕдиницаИзмеренияСтрокой = ЗначениеИзОбласти(ТабличныйДокумент, НомерСтроки, ПараметрыЗагрузки.НомерКолонкиЕдиницаИзмерения);								
			СтрокаТЗ.Артикул = ЗначениеИзОбласти(ТабличныйДокумент, НомерСтроки, ПараметрыЗагрузки.НомерКолонкиАртикул);					
			СтрокаТЗ.Характеристика = ЗначениеИзОбласти(ТабличныйДокумент, НомерСтроки, ПараметрыЗагрузки.НомерКолонкиХарактеристика);
			
			СтрокаТЗ.Цена = Цена;
		Исключение
			ТекстОшибки = "Ошибка чтения строки файла " + НомерСтроки + Символы.ПС + ОписаниеОшибки();
			ЗафиксироватьОшибкуЗагрузки(НастройкаЗагрузки, ТекстОшибки);		
			Возврат Ложь;
		КонецПопытки;
	КонецЦикла;
	
	ИдентифицироватьНоменклатуру(ДанныеКЗагрузке, ПараметрыЗагрузки.СпособПоискаНоменклатуры);
	
	Результат = СоздатьУстановкуЦенПоТаблице(ДанныеКЗагрузке, ПараметрыЗагрузки);
	
	Возврат Результат;
	
КонецФункции

Функция Загрузить_ДокументУстановкаЦенНоменклатуры_ИзCSV(НастройкаЗагрузки)
	
	ТекстОшибки = "";
	
	ПараметрыЗагрузки = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(НастройкаЗагрузки, "Ссылка, Источник, ПутьКФайлу, РазделительCSV, КодировкаФайла,
																					  |СпособПоискаНоменклатуры, 
																					  |ВидНовойНоменклатуры, ГруппаНовойНоменклатуры, ЕдиницаИзмеренияНовойНоменклатуры,
																					  |НомерНачальнойСтроки, НомерКолонкиНаименование, НомерКолонкиХарактеристика,
																					  |НомерКолонкиАртикул, НомерКолонкиЕдиницаИзмерения, НомерКолонкиЦена,
																					  |ВидЦены, ЗагружатьТолькоИзмененныеЦены");
	
	ПутьКФайлу = ПолучитьПутьКФайлу(ПараметрыЗагрузки);
	
	МассивСтрок = ОбщийМодульКлиентСервер.ПрочитатьФайлCSV(ПутьКФайлу, ПараметрыЗагрузки.КодировкаФайла, ПараметрыЗагрузки.НомерНачальнойСтроки, ТекстОшибки);
	
	Если ПараметрыЗагрузки.Источник = Перечисления.ТипыИсточниковЗагрузкиИзВнешнихИсточников.ФайлCSVURL Тогда
		УдалитьФайлы(ПутьКФайлу);
	КонецЕсли;
	
	Если МассивСтрок.Количество() = 0 Тогда 
		ТекстОшибки = "Файл загрузки пуст";
		ЗафиксироватьОшибкуЗагрузки(НастройкаЗагрузки, ТекстОшибки);		
		Возврат Ложь;
	КонецЕсли;
	
	ДанныеКЗагрузке = ПустаяТаблицаЗагрузкиЦенНоменклатуры();
	
	РазделительCSV = ?(НЕ ПустаяСтрока(ПараметрыЗагрузки.РазделительCSV), ПараметрыЗагрузки.РазделительCSV, ";");
	
	Для каждого СтрокаФайл из МассивСтрок Цикл
		
		ЭлементыСтроки = СтрРазделить(СтрокаФайл, РазделительCSV, Истина);

		Попытка
			Наименование = ЗначениеИзМассива(ЭлементыСтроки, ПараметрыЗагрузки.НомерКолонкиНаименование);
			Если НЕ ЗначениеЗаполнено(Наименование) Тогда
				Продолжить;
			КонецЕсли;
			
			ЦенаСтрокой = ЗначениеИзМассива(ЭлементыСтроки, ПараметрыЗагрузки.НомерКолонкиЦена);
			Если НЕ ЗначениеЗаполнено(ЦенаСтрокой) Тогда
				Продолжить;
			КонецЕсли;

			Цена = СтроковыеФункцииКлиентСервер.СтрокаВЧисло(ЦенаСтрокой);
			Если Цена = Неопределено ИЛИ Цена = 0 Тогда
				Продолжить;	
			КонецЕсли;
			
			СтрокаТЗ = ДанныеКЗагрузке.Добавить();
			СтрокаТЗ.Наименование = Наименование;
			СтрокаТЗ.ЕдиницаИзмеренияСтрокой = ЗначениеИзМассива(ЭлементыСтроки, ПараметрыЗагрузки.НомерКолонкиЕдиницаИзмерения);								
			СтрокаТЗ.Артикул = ЗначениеИзМассива(ЭлементыСтроки, ПараметрыЗагрузки.НомерКолонкиАртикул);					
			СтрокаТЗ.Характеристика = ЗначениеИзМассива(ЭлементыСтроки, ПараметрыЗагрузки.НомерКолонкиХарактеристика);
			
			СтрокаТЗ.Цена = Цена;
		Исключение
			ТекстОшибки = "Ошибка чтения строки файла " + СтрокаФайл + Символы.ПС + ОписаниеОшибки();
			ЗафиксироватьОшибкуЗагрузки(НастройкаЗагрузки, ТекстОшибки);		
			Возврат Ложь;
		КонецПопытки;
	КонецЦикла;
	
	ИдентифицироватьНоменклатуру(ДанныеКЗагрузке, ПараметрыЗагрузки.СпособПоискаНоменклатуры);
	
	Результат = СоздатьУстановкуЦенПоТаблице(ДанныеКЗагрузке, ПараметрыЗагрузки);
	
	Возврат Результат;
	
КонецФункции

Функция ПрочитатьФайлExcelВТабличныйДокумент(ПутьКФайлуНаСервере, ТекстОшибки) Экспорт
		
	ТабличныйДокумент = Новый ТабличныйДокумент;
	
	ФайлЗагрузки = Новый Файл(ПутьКФайлуНаСервере);
	Если НЕ ФайлЗагрузки.Существует() Тогда
		ТекстОшибки = "Файл недоступен или не существует";
		Возврат Неопределено;
	КонецЕсли;
		
	УстановитьПривилегированныйРежим(Истина);
	Попытка
		ТабличныйДокумент.Прочитать(ПутьКФайлуНаСервере, СпособЧтенияЗначенийТабличногоДокумента.Значение);
		Возврат ТабличныйДокумент;
	Исключение
		ТекстОшибки = "Не удалось прочитать файл Excel: " + ОписаниеОшибки();
		Возврат Неопределено;
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);
	
КонецФункции

Процедура ЗафиксироватьОшибкуЗагрузки(НастройкаЗагрузки, ТекстОшибки)
	
	ЗаписьЖурналаРегистрации("Загрузка данных из внешних источников",
			УровеньЖурналаРегистрации.Ошибка,
			НастройкаЗагрузки.Метаданные(),
			НастройкаЗагрузки,
			ТекстОшибки);
			
КонецПроцедуры
		
Процедура ЗафиксироватьСостояниеЗагрузки(НастройкаЗагрузки, ДатаНачала, Успешно = Истина)
	
	МенеджерЗаписи = РегистрыСведений.СостоянияЗагрузкиДанныхИзВнешнихИсточников.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.НастройкаЗагрузки = НастройкаЗагрузки;
	МенеджерЗаписи.РезультатВыполнения = ?(Успешно, Перечисления.РезультатыВыполненияОбмена.Выполнено, Перечисления.РезультатыВыполненияОбмена.Ошибка);
	МенеджерЗаписи.ДатаНачала = ДатаНачала;
	МенеджерЗаписи.ДатаОкончания = ТекущаяДатаСеанса();
	МенеджерЗаписи.Записать();
	
КонецПроцедуры

