
Функция ПолучитьЗначениеКонстанты_ФП_НастройкиРеквизитов() Экспорт
	
	Хранилище = Константы.ИА_ФП_НастройкиРеквизитов.Получить();
	
	СтруктураНастроек = Хранилище.Получить();
	
	//здесь можно вводить значения по умолчанию
	
	ТекстСообщения = "";
	
	//если вдруг в хранилище не структура вернем пустую.
	Если Не ТипЗнч(СтруктураНастроек) = Тип("Структура") Тогда
		ТекстСообщения = "Не заполненны настройки реквизитов ФП!";
		СтруктураНастроек = Новый Структура;
	КонецЕсли;
	
	//	
	Если ЗначениеЗаполнено(ТекстСообщения) Тогда
		
		ИА_КСУОбщийКлиентСервер.СообщитьПользователю(ТекстСообщения);
		
	КонецЕсли;

	Возврат СтруктураНастроек;
	
КонецФункции

Функция ФП_по_ТБ(дата = Неопределено) Экспорт

	дата1 = дата;
	тд = ТекущаяДата();
	Если дата1= Неопределено или не ЗначениеЗаполнено(дата1) Тогда
		дата1 = тд;
	КонецЕсли;
	
	Возврат дата1>=Константы.КСУ_ДатаПереходаНаТБ.Получить() И Константы.КСУ_ФП_ТБ.Получить();
	
КонецФункции 

Функция ОтключитьПодразделения() Экспорт
	возврат не Константы.КСУ_ФП_ИспользоватьПодразделения.Получить();
КонецФункции

Функция ПолучитьЗначениеКонстанты_ФП(имяКонстанты) Экспорт
	Возврат Константы[имяКонстанты].Получить();	
КонецФункции
