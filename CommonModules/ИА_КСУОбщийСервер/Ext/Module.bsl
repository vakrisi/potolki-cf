Функция ПолучитьAccessTokenИзRefresh(Соединение, refresh_token = Неопределено) Экспорт
	Если refresh_token = Неопределено Тогда
		менП = РегистрыСведений.КСУ_ДоступКGoogleКалендарю.СоздатьМенеджерЗаписи();
		менп.Пользователь = ПараметрыСеанса.ТекущийПользователь;
		менП.Прочитать();
		refresh_token = менП.Токен;
	КонецЕсли;
	
	Проект = ПолучитьДанныеПроектаКСУ();
	
	ПараметрыPOST = "grant_type=refresh_token&client_id=" + Проект.client_id + "&client_secret=" + Проект.client_secret + "&refresh_token=" + refresh_token;
	хеадерс = новый Соответствие;
	хеадерс.Вставить("Content-Type","application/x-www-form-urlencoded");
	
	Запрос = Новый HTTPЗапрос("/oauth2/v4/token", хеадерс);

	Запрос.УстановитьТелоИзСтроки(ПараметрыPOST, КодировкаТекста.Системная);
    Результат = Соединение.ОтправитьДляОбработки(Запрос);
	ТекстОтвета = Результат.ПолучитьТелоКакСтроку();
	
	JSon = Новый ЧтениеJSON;
	JSon.УстановитьСтроку(ТекстОтвета);
	рез = ПрочитатьJSON(JSon);
	
	Возврат рез.access_token;
	
КонецФункции

