// Работа  календарем

Процедура Календарь_ЗаполнитьПоПрКалендарю(ДанныеДляЗагрузки, ДатаНачала, ДатаКонца, КолРабочихЧасовПятница, КолРабочихЧасов) Экспорт
	
	мДниНедели = Новый Соответствие();
	мДниНедели.Вставить(1, "ПН");
	мДниНедели.Вставить(2, "ВТ");
	мДниНедели.Вставить(3, "СР");
	мДниНедели.Вставить(4, "ЧТ");
	мДниНедели.Вставить(5, "ПТ");
	мДниНедели.Вставить(6, "СБ");
	мДниНедели.Вставить(7, "ВС");
	
	
	ДанныеДляЗагрузки.Очистить();
	
	ИмяРегистраПроизводственногоКалендаря      = ИА_БФСПИ.Константа_Получить("ИА_ПроизводственныйКалендарьИмяРегистра");
	ИмяИзмеренияДатаПроизводственногоКалендаря = ИА_БФСПИ.Константа_Получить("ИА_ПроизводственныйКалендарьИзмерениеДата");
	
	Если ИмяРегистраПроизводственногоКалендаря = "ДанныеПроизводственногоКалендаря"  Тогда
		
		Если Метаданные.Константы.Найти("ОсновнойКалендарьПредприятия") <> Неопределено Тогда
			
			ОсновнойКалендарьПредприятия = Константы.ОсновнойКалендарьПредприятия.Получить();
			ПроизводственныйКалендарьПоУмолчанию =  ОсновнойКалендарьПредприятия.ПроизводственныйКалендарь;
			
		ИначеЕсли Метаданные.Справочники.Найти("ПроизводственныеКалендари") <> Неопределено Тогда
			
			//Арчил Тваладзе 22.04.2016 по другому не придумал, в УНФ нет ни константы  ОсновнойКалендарьПредприятия, ни чего аналогичного
			ПроизводственныйКалендарьПоУмолчанию = Справочники.ПроизводственныеКалендари.НайтиПоКоду("РФ");
			
		иначе 
			
			ПроизводственныйКалендарьПоУмолчанию = Неопределено;
			
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(ПроизводственныйКалендарьПоУмолчанию) Тогда
			
			ИА_КСУОбщийКлиентСервер.СообщитьПользователю("Не заполнена константа ОсновнойКалендарьПредприятия");
			Возврат;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ДанныеПроизводственногоКалендаря."+ИмяИзмеренияДатаПроизводственногоКалендаря+" Как Дата,
	|	ВЫБОР
	|		КОГДА ДанныеПроизводственногоКалендаря.ВидДня = ЗНАЧЕНИЕ(Перечисление.ВидыДнейПроизводственногоКалендаря.Праздник)
	|				ИЛИ ДанныеПроизводственногоКалендаря.ВидДня = ЗНАЧЕНИЕ(Перечисление.ВидыДнейПроизводственногоКалендаря.Суббота)
	|				ИЛИ ДанныеПроизводственногоКалендаря.ВидДня = ЗНАЧЕНИЕ(Перечисление.ВидыДнейПроизводственногоКалендаря.Воскресенье)
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ КАК Рабочий
	|ИЗ
	|	РегистрСведений."+ИмяРегистраПроизводственногоКалендаря+" КАК ДанныеПроизводственногоКалендаря
	|ГДЕ
	|	ДанныеПроизводственногоКалендаря."+ИмяИзмеренияДатаПроизводственногоКалендаря+" МЕЖДУ &ДатаНачала И &ДатаКонца";
	
	Если ИмяРегистраПроизводственногоКалендаря = "ДанныеПроизводственногоКалендаря"  Тогда
		
		Запрос.УстановитьПараметр("ПроизводственныйКалендарьПоУмолчанию", ПроизводственныйКалендарьПоУмолчанию);
		Запрос.Текст = Запрос.Текст +"				
		|	И ДанныеПроизводственногоКалендаря.ПроизводственныйКалендарь = &ПроизводственныйКалендарьПоУмолчанию";
		
	КонецЕсли;

	
	Запрос.УстановитьПараметр("ДатаНачала", ДатаНачала);
	Запрос.УстановитьПараметр("ДатаКонца", ДатаКонца);
	
	Результат = Запрос.Выполнить().Выбрать();
	
	Пока Результат.Следующий() Цикл
		
		Новстр = ДанныеДляЗагрузки.Добавить();
		Новстр.Период = Результат.Дата;
		дн = ДеньНедели(Новстр.Период);
		Новстр.ДеньНедели = мДниНедели[дн];
		Новстр.Рабочий = Результат.Рабочий;
		Если Новстр.Рабочий Тогда
			Новстр.КоличествоРабочихЧасов = ?(дн = 5, КолРабочихЧасовПятница, КолРабочихЧасов)
		Иначе
			Новстр.КоличествоРабочихЧасов = 0;
		КонецЕсли;
		
	КонецЦикла;
КонецПроцедуры

// Календарь_ДобавитьКДате - к "Дата" прибавить требуемое "КоличествоДней" "календарных", либо "рабочих"
// Параметры:
// Дата -Дата - дата начала
// КоличествоДней - Число - прибавляемое число дней
// ВариантДней - Число - 0 - Календарные; 1-рабочие. По-умолчанию: 1
Функция Календарь_ДобавитьКДате(Дата, КоличествоДней, ВариантДней = 1) Экспорт
    Результат = '00010101';
    
    Если ВариантДней = 0 Тогда
        Результат = НачалоДня(Дата) + КоличествоДней * 86400;
    Иначе
        Результат = ИА_БФС.Запрос_ВыполнитьСкалярный(
        "ВЫБРАТЬ
        |   ИА_Календарь.Период КАК Период,
        |   ИА_Календарь.Рабочий,
        |   ИА_Календарь.КоличествоРабочихЧасов
        |ПОМЕСТИТЬ Даты
        |ИЗ
        |   РегистрСведений.ИА_Календарь КАК ИА_Календарь
        |ГДЕ
        |   ИА_Календарь.Период >= &Дата
        |   И ИА_Календарь.Рабочий
        |
        |ИНДЕКСИРОВАТЬ ПО
        |   Период
        |;
        |
        |////////////////////////////////////////////////////////////////////////////////
        |ВЫБРАТЬ
        |   Даты.Период КАК Результат,
        |   КОЛИЧЕСТВО(Даты1.Период) КАК Номер
        |ИЗ
        |   Даты КАК Даты
        |       ВНУТРЕННЕЕ СОЕДИНЕНИЕ Даты КАК Даты1
        |       ПО Даты.Период >= Даты1.Период
        |
        |СГРУППИРОВАТЬ ПО
        |   Даты.Период
        |
        |ИМЕЮЩИЕ
        |   КОЛИЧЕСТВО(Даты1.Период) = 1 + &КоличествоДней"
        , Новый Структура("Дата, КоличествоДней", Дата, КоличествоДней)); 
    КонецЕсли; 
    
	Возврат Результат;	
КонецФункции
 

