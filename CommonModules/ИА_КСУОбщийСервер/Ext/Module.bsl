Функция ОбновитьИзображение(ФизЛицо, ТипФото = "", уид) Экспорт
	
	ФотоФизЛицаДвоичныеДанные = ПолучитьФотоФизЛица(ФизЛицо, ТипФото);
	
	Возврат ПоместитьВоВременноеХранилище(ФотоФизЛицаДвоичныеДанные,уид);
	
КонецФункции

Функция ПолучитьФотоФизЛица(ФизЛицо, ТипФото="") Экспорт
	
	Фото = РегистрыСведений.ИА_ДанныеФизЛиц.ПолучитьФотоФизЛица(ФизЛицо,ТипФото);
	
    Возврат Фото;
	
КонецФункции

Процедура ОбновитьАватар(ФизЛицо = Неопределено, ИзАватара = Ложь, АдресВх = Неопределено, АдресИсх = Неопределено, уидИсх = Неопределено) Экспорт
	РежимАдресов =  АдресВх <> Неопределено; // работаем не с физ лицом, а с несохраненными данными
	
	Каталог = КаталогВременныхФайлов() + "IMConv\";
	СоздатьКаталог(Каталог);
	
	ИмяПриложения = Каталог + "runer.exe";
	СоздатьКонвертер(ИмяПриложения, Каталог);
	
    ИмяФайла = ПолучитьИмяВременногоФайла("jpg");
	ИмяНовойКартинки = ПолучитьИмяВременногоФайла("png");
	
	// исходное фото
	Если РежимАдресов Тогда
		ДД_Фото = ПолучитьИзВременногоХранилища(АдресВх);
	Иначе
	    ДД_Фото = ПолучитьФотоФизЛица(ФизЛицо,?(ИзАватара,"Аватар",""));
		Если ДД_Фото = Неопределено Тогда
			возврат;
		КонецЕсли;
	КонецЕсли;
	ДД_Фото.Записать(ИмяФайла);
	
	//
	Соотношение = "100x";	
	
	Попытка 
		ФВр = Новый Файл(ИмяФайла);
	    Shell = Новый COMОбъект("Shell.Application");
	    Folder = Shell.Namespace(ФВр.Путь);
	    размеры = Folder.GetDetailsOf(Folder.Items().item(ФВр.Имя), 26) + Folder.GetDetailsOf(Folder.Items().item(ФВр.Имя), 31); // раньше было в одном потом в другом
		р = Найти(размеры, "x");
		ширинаСтр = Лев(размеры, р - 2);
		высотаСтр = Сред(размеры, р + 2);
		
		попытка
			ширина = Число(ширинаСтр);
			высота = Число(высотаСтр);
		Исключение  // бывают глюки с нечитаемым символом по бокам
			ширина = Число(Сред(ширинаСтр,2));
			высота = Число(Сред(высотаСтр,1,СтрДлина(высотаСтр)-1));
		КонецПопытки;
		
		Если ширина > высота Тогда
			Соотношение = "x100";
		КонецЕсли;
	Исключение
	КонецПопытки;
	//
	ТекстКонв = "convert.exe  ""%ИмяФайла%""  -resize %Соотн% -gravity center -crop 100x100+0+0 -quality 90 ""2.png"" 
                 |convert.exe  ""2.png""  ( +clone -threshold -1 -negate -fill white -draw ""circle 50,50 50,0"" ) -alpha off -compose copy_opacity -composite -quality 90 ""%ИмяНовойКартинки%"" "; 
	ТекстКонв = СтрЗаменить(ТекстКонв, "%ИмяФайла%", ИмяФайла);
	ТекстКонв = СтрЗаменить(ТекстКонв, "%ИмяНовойКартинки%", ИмяНовойКартинки);
	ТекстКонв = СтрЗаменить(ТекстКонв, "%Соотн%", Соотношение);
    
    ТекстДок = Новый ТекстовыйДокумент();
    ТекстДок.УстановитьТекст(ТекстКонв);
    ТекстДок.Записать(Каталог + "cmd.txt", КодировкаТекста.ANSI);
	
	//
	КодВозврата = 0;
    ЗапуститьПриложение(ИмяПриложения,,Истина,КодВозврата);
   
	Если КодВозврата <> Неопределено Тогда
		ДД_Рез = Новый ДвоичныеДанные(ИмяНовойКартинки);
		Если РежимАдресов Тогда
			АдресИсх = ПоместитьВоВременноеХранилище(ДД_Рез, уидИсх);
		Иначе
			мен = РегистрыСведений.ИА_ДанныеФизЛиц.СоздатьМенеджерЗаписи();        	
			мен.ФизЛицо = ФизЛицо;
			мен.Прочитать();
			мен.ФотоАватар = Новый ХранилищеЗначения(ДД_Рез);
			мен.Записать();
		КонецЕсли;
	КонецЕсли; 
	УдалитьФайлы(ИмяФайла);
    УдалитьФайлы(ИмяНовойКартинки);

КонецПроцедуры

Процедура СоздатьКонвертер(ИмяПриложения, Каталог)
	ФайлПриложения = Новый Файл(ИмяПриложения);
	Если НЕ ФайлПриложения.Существует() Тогда
        ДД =  ПолучитьОбщийМакет("ИА_Приложение_Convert");
        ИмяАрхива = Каталог + "arc.zip";
        ДД.Записать(ИмяАрхива);
        
        Архив = Новый ЧтениеZIPФайла(ИмяАрхива);
        Архив.ИзвлечьВсе(Каталог,РежимВосстановленияПутейФайловZIP.НеВосстанавливать);
    КонецЕсли;
КонецПроцедуры

Функция Картинки_ИзменитьРазмер(ИмяФайлаИлиДД, НоваяШирина, НоваяВысота, НовоеСоотношениеСторон = 0) Экспорт 
	
	Результат = Новый Структура("ИмяФайла, Выполнено, ДДКартинки", "", Ложь);
    
    Каталог = КаталогВременныхФайлов() + "IMConv\";
    СоздатьКаталог(Каталог);
    ИмяПриложения = Каталог + "runer.exe";
    СоздатьКонвертер(ИмяПриложения, Каталог);
    
    РежимДД = ТипЗнч(ИмяФайлаИлиДД) <> Тип("Строка");
    Если РежимДД Тогда
        ИмяФайла = ПолучитьИмяВременногоФайла("jpg");
        ИмяФайлаИлиДД.Записать(ИмяФайла);
    Иначе
        ИмяФайла = ИмяФайлаИлиДД;
	КонецЕсли; 
    
    ИмяНовойКартинки = ПолучитьИмяВременногоФайла("jpg");    
    КодВозврата = 0;
    
    ТекстДок = Новый ТекстовыйДокумент();
    Если НовоеСоотношениеСторон = 0 Тогда
        СтрокаПараметров = """" + Каталог + "convert.exe"" "
        + " """ + ИмяФайла + """ "
        + " -resize " + Формат(НоваяШирина, "ЧГ=") +"x" + Формат(НоваяВысота, "ЧГ=")
        + " -quality 90 """ + ИмяНовойКартинки + """ "
    Иначе
        НоваяШирина = НоваяВысота * НовоеСоотношениеСторон;
        СтрокаПараметров = """" + Каталог + "convert.exe"" "
        + " """ + ИмяФайла + """ "
        + " -resize x" + Формат(НоваяВысота, "ЧГ=")
        + " -gravity center -crop " + Формат(НоваяШирина, "ЧГ=") + "x" + Формат(НоваяВысота, "ЧГ=") + "+0+0"
        + " -quality 90 """ + ИмяНовойКартинки + """ "
        
    КонецЕсли; 
    ТекстДок.УстановитьТекст(СтрокаПараметров);
    ТекстДок.Записать(Каталог + "cmd.txt", КодировкаТекста.ANSI);
    
    ЗапуститьПриложение(ИмяПриложения,,Истина,КодВозврата);
    //УдалитьФайлы(Каталог, "*.*");
    Если КодВозврата = 0 Тогда
        Результат.Выполнено = Истина;
        Результат.ИмяФайла = ИмяНовойКартинки;
        Если РежимДД Тогда
            Результат.ДДКартинки = Новый ДвоичныеДанные(ИмяНовойКартинки);
            Ф = Новый Файл(ИмяФайла);
            УдалитьФайлы(Ф.Путь, Ф.Имя);
            Ф = Новый Файл(ИмяНовойКартинки);
            УдалитьФайлы(Ф.Путь, Ф.Имя);
        КонецЕсли; 
    КонецЕсли; 
    
    Возврат Результат;
	
КонецФункции

