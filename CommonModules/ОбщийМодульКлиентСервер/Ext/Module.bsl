#Область РаботаСАдресами

Функция УбратьИндексВАдресе(ПредставлениеАдреса) Экспорт
	
	Результат = ПредставлениеАдреса;
	Если СтрДлина(Результат) < 7 Тогда
		Возврат Результат;	
	КонецЕсли;
	
	Если СтроковыеФункцииКлиентСервер.ТолькоЦифрыВСтроке(Лев(Результат, 6)) Тогда
		Результат = Сред(Результат, 7);
	КонецЕсли;
	
	Если Лев(Результат, 1) = "," Тогда
		Результат = Сред(Результат, 2);
	КонецЕсли;
	
	Результат = СокрЛП(Результат);
	
	Возврат Результат;
	
КонецФункции

