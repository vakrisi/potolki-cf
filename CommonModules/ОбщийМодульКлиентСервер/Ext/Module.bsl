#Область РаботаСФайлами

// получает файл по http-ссылке
// URLАдрес - http-ссылка на файл
// ОжидаемоеРасширениеФайла в формате ".xls"
// ДанныеАвторизации - структура(Логин, Пароль), если надо авторизоваться для скачивания файла
Функция ПолучитьФайлЗаписиПоHttpСсылке(Знач URLАдрес, 
										ТолькоПроверка = Ложь,
	                                    ОжидаемоеРасширениеФайла = ".txt",
										ДанныеАвторизации = Неопределено) Экспорт
										 
	Результат = Новый Структура("ПутьКФайлу, КодОтвета", "", -1);
	
	Адрес="";
	РазделительСхемы = "://"; 
	ПозицияСхемы = СтрНайти(URLАдрес, РазделительСхемы);
	Если ПозицияСхемы = 0 Тогда
		Возврат Результат;
	КонецЕсли; 
	Схема = Лев(URLАдрес, ПозицияСхемы-1) + РазделительСхемы;
	
	ПутьСсылки = СтрЗаменить(URLАдрес, Схема, "");	
	Колво = СтрЧислоВхождений(ПутьСсылки,"/");
	Для Индекс=1 По Колво Цикл		
		Позиция = СтрНайти(ПутьСсылки,"/");
		Если Позиция > 0 Тогда				
			Если Индекс=1 Тогда
				Адрес = Лев(ПутьСсылки, Позиция-1);
			КонецЕсли;		
			ПутьСсылки = Сред(ПутьСсылки, Позиция+1);			
		КонецЕсли;	
	КонецЦикла;
	
	Таймаут=10;
	ssl = Новый ЗащищенноеСоединениеOpenSSL;
	
	Если Схема="https://" Тогда	
		HTTPСоединение=Новый HTTPСоединение(Адрес,,,,,,ssl);
	ИначеЕсли Схема="http://" Тогда
		HTTPСоединение=Новый HTTPСоединение(Адрес);
	Иначе
		Возврат Результат;
	КонецЕсли;
	
	Заголовки = Новый Соответствие(); 
	Если НЕ ДанныеАвторизации = Неопределено Тогда
   		Заголовки.Вставить("Authorization", "Basic " + ПолучитьBase64ЗаголовокАвторизации(ДанныеАвторизации.Логин, ДанныеАвторизации.Пароль));
	КонецЕсли;
	 
	АдресПуть = СтрЗаменить(URLАдрес, Схема+Адрес, "");
	HTTPЗапрос = Новый HTTPЗапрос(АдресПуть, Заголовки);
	//HTTPОтвет = HTTPСоединение.ОтправитьДляОбработки(HTTPЗапрос); // post	
	HTTPОтвет = HTTPСоединение.Получить(HTTPЗапрос);                // get
	
	Результат.КодОтвета = HTTPОтвет.КодСостояния;
	
	Если ТолькоПроверка Тогда		
		Возврат Результат;
	КонецЕсли;
		
	Если HTTPОтвет.КодСостояния = 200 Тогда
		ФайлЗаписи = HTTPОтвет.ПолучитьТелоКакДвоичныеДанные();
		
		Каталог = КаталогВременныхФайлов();
		Если НЕ Прав(Каталог, 1) = "\" Тогда
			Каталог = Каталог + "\";	
		КонецЕсли;
		Если ПустаяСтрока(ПутьСсылки) Тогда
			#Если НЕ ВебКлиент Тогда
				ПутьКФайлу = ПолучитьИмяВременногоФайла(ОжидаемоеРасширениеФайла);
			#Иначе
				ПутьКФайлу = ннаАдаптацияВебКлиента.ПолучитьИмяВременногоФайлаСервер(ОжидаемоеРасширениеФайла); //нна 
			#КонецЕсли	
		Иначе
			ПутьКФайлу = Каталог + ПутьСсылки;
		КонецЕсли;
		
		ЧислоСимволовПослеТочкиВКонце = (СтрДлина(ПутьКФайлу) - СтрНайти(ПутьКФайлу, ".", НаправлениеПоиска.СКонца));
		
		Если НЕ (ЧислоСимволовПослеТочкиВКонце = 3 Или ЧислоСимволовПослеТочкиВКонце = 4) Тогда			
			ПутьКФайлу = ПутьКФайлу + ОжидаемоеРасширениеФайла;			
		КонецЕсли;
		
		ФайлЗаписи.Записать(ПутьКФайлу);
		
		Результат.ПутьКФайлу = ПутьКФайлу;
		Возврат Результат;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьBase64ЗаголовокАвторизации(ИмяПользователя, Пароль)

    КодировкаФайла = КодировкаТекста.UTF8;
	#Если НЕ ВебКлиент Тогда
		ВременныйФайл = ПолучитьИмяВременногоФайла();
	#Иначе
		ВременныйФайл = ннаАдаптацияВебКлиента.ПолучитьИмяВременногоФайлаСервер(); //нна 
	#КонецЕсли
    Запись = Новый ЗаписьТекста(ВременныйФайл, КодировкаФайла);
    Запись.Записать(ИмяПользователя+":"+Пароль);
    Запись.Закрыть();

    ДвДанные = Новый ДвоичныеДанные(ВременныйФайл);
    Результат = Base64Строка(ДвДанные);
    УдалитьФайлы(ВременныйФайл);

    Результат = Сред(Результат,5);

    Возврат Результат;

КонецФункции

Функция ПрочитатьФайлCSV(ПутьКФайлу, КодировкаФайла, НачальнаяСтрока = 1, ТекстОшибки) Экспорт
	
	МассивСтрок = Новый Массив;
	
	Текст = Новый ТекстовыйДокумент();
	Текст.Прочитать(ПутьКФайлу, КодировкаФайла);
	
	Если Текст.КоличествоСтрок() < НачальнаяСтрока Тогда
		Возврат МассивСтрок;
	КонецЕсли; 
	
	Для ИндексСтроки = НачальнаяСтрока По Текст.КоличествоСтрок() Цикл
		
		ТекущаяСтрока = Текст.ПолучитьСтроку(ИндексСтроки);
		Если Не ЗначениеЗаполнено(ТекущаяСтрока) Тогда
			Продолжить;
		КонецЕсли;
		МассивСтрок.Добавить(ТекущаяСтрока);
	КонецЦикла;
	
	Возврат МассивСтрок;
		
КонецФункции

Функция ОбрезатьСтрокуCSV(Знач СтрокаФайла) Экспорт
	
	СтрокаФайла	= СокрЛП(СтрокаФайла);
	Если Лев(СтрокаФайла, 1) = """" И Прав(СтрокаФайла, 1) = """" Тогда
		СтрокаФайла = Сред(СтрокаФайла, 2, СтрДлина(СтрокаФайла)-2);	
	КонецЕсли;
	
	Возврат СтрокаФайла;
		
КонецФункции

#КонецОбласти

#Область РаботаСГрафикомОплат

Функция РассчитатьПлатежПоГрафику(ПараметрыГрафика) Экспорт
	
	КРаспределению = ПараметрыГрафика.Сумма - ПараметрыГрафика.СуммаПервоначальногоВзноса;
	Если КРаспределению < 0 Тогда
		Возврат 0;
	КонецЕсли;
	
	Платеж = Окр(КРаспределению / ПараметрыГрафика.КоличествоПериодов, 2);
	Если ПараметрыГрафика.ОкруглятьПлатеж Тогда
		Платеж = ОбщийМодуль.ОкруглитьЧисло(Платеж, ПараметрыГрафика.ПорядокОкругленияЧислом, ПараметрыГрафика.ОкруглятьВБольшуюСторону);
	КонецЕсли;
	
	Возврат Платеж;
	
КонецФункции

//#16286
Функция РаспределитьГрафикОплат(ПараметрыГрафика) Экспорт
	
	//ПараметрыГрафика = Новый Структура("Сумма, ДатаНачала, СуммаПервоначальногоВзноса, Периодичность, КоличествоПериодов,
	//									|ОкруглятьПлатеж, ПорядокОкругленияЧислом, ОкруглятьВБольшуюСторону");
	
	МассивОплат = Новый Массив;
	СтруктураСтроки = Новый Структура("ДатаПлатежа, Сумма", ПараметрыГрафика.ДатаНачала, ПараметрыГрафика.СуммаПервоначальногоВзноса);
	КРаспределению = ПараметрыГрафика.Сумма - ПараметрыГрафика.СуммаПервоначальногоВзноса;
	Если КРаспределению < 0 Тогда
		СтруктураСтроки.Сумма = ПараметрыГрафика.Сумма;
		МассивОплат.Добавить(СтруктураСтроки);
		Возврат МассивОплат;
	КонецЕсли;
	
	// первоначальный платеж (вне графика)
	МассивОплат.Добавить(СтруктураСтроки);
	
	Платеж = РассчитатьПлатежПоГрафику(ПараметрыГрафика);
	
	Если Платеж = 0 Тогда
		Возврат МассивОплат;	
	КонецЕсли;
	
	Распределено = 0; 
	ДатаПлатежа = ПараметрыГрафика.ДатаНачала;
	Для Сч = 1 по ПараметрыГрафика.КоличествоПериодов Цикл
		Если ПараметрыГрафика.Периодичность = 0 Тогда
			ДатаПлатежа = ДобавитьМесяц(ДатаПлатежа, 1);
		Иначе
			// день
			ДатаПлатежа = ДатаПлатежа + 86400;
		КонецЕсли;
		
		СтруктураСтроки = Новый Структура("ДатаПлатежа, Сумма", ДатаПлатежа, Платеж);
		Распределено = Распределено + Платеж;
		
		Если Сч = ПараметрыГрафика.КоличествоПериодов Тогда
			СтруктураСтроки.Сумма = СтруктураСтроки.Сумма + (КРаспределению - Распределено);	
		КонецЕсли;
		
		МассивОплат.Добавить(СтруктураСтроки);
		
	КонецЦикла;
	
	Возврат МассивОплат;
	
КонецФункции

#КонецОбласти

//аналог ОбщегоНазначения.ДанныеСовпадают
// нужен был Вызов с клиента
Функция СтруктурыСовпадают(Данные1, Данные2) Экспорт
	
	Если ТипЗнч(Данные1) <> ТипЗнч(Данные2) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если ТипЗнч(Данные1) <> Тип("Структура") Тогда
		Возврат Ложь;
	КонецЕсли;	
	
	Если Данные1.Количество() <> Данные2.Количество() Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Для каждого КлючИЗначение Из Данные1 Цикл
		СтароеЗначение = Неопределено;
		
		Если НЕ Данные2.Свойство(КлючИЗначение.Ключ, СтароеЗначение)
			ИЛИ НЕ КлючИЗначение.Значение = СтароеЗначение Тогда
			
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции
		
	