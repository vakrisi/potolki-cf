Функция НастройкиВариантаОтчетаПоЛидам(ОтчетСсылка, КлючВарианта, Предопределенный) Экспорт
	
	Результат = ПустаяТаблицаПоказателей();
	
	СтруктураРезультата = ОтчетыЭффективности.ДанныеПоИмениОтчета(ОтчетСсылка.Имя);
	ПолеПоказателя = СтруктураРезультата.ПолеПоказателя;
	ТипПоказателя  = СтруктураРезультата.ТипПоказателя;
	
	ТаблицаДоступныхПоказателей = ТаблицаДоступныхПоказателейПоЛидам(ПолеПоказателя, ТипПоказателя);
	
	// настройки предопределенных храним "внутри" отчета
	Если Предопределенный Тогда		
		
		Если КлючВарианта = "ВсеПоказатели" Тогда
			Для каждого СтрокаТЗ из ТаблицаДоступныхПоказателей Цикл
				НоваяСтрока = Результат.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТЗ);
			КонецЦикла;
			
		ИначеЕсли КлючВарианта = "АнализЛидовВПериодеОтчета" Тогда
			ОтчетыЭффективности.ДобавитьПоказательВПредопределенныйВариантОтчета(ТаблицаДоступныхПоказателей, "КоличествоСозданныхЛидов", Результат);
