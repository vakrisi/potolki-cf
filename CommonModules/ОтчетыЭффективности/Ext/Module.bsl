Функция СтруктураИтогов() Экспорт
	
	//Вариант:
	// 0 - как сумма значений показателя
	// 1 - как ЗначениеПоказателя / Знаменатель
	//Дополнительный вес - значение, на которое дополнительно умножается итог
	// 1 - по умолчанию 
	// 100 - например, для процентов
	Возврат Новый Структура("ЕстьСумма, ЕстьСреднее, ВариантСуммы, ВариантСреднего, ДополнительныйВесСуммы, ДополнительныйВесСреднего", 
							Истина, Истина, 0, 0, 1, 1);
	
КонецФункции

Функция ДанныеПоИмениОтчета(ИмяОтчета) Экспорт
	
	СтруктураРезультата = Новый Структура("ПредставлениеПоказателя, ПолеПоказателя, ТипПоказателя", "", "", "");
	
	Если ИмяОтчета = "ЭффективностьМаркетинга" Тогда
		СтруктураРезультата.ПредставлениеПоказателя = "";
		
		// поля, по которым осуществляется сбор данных
		// но в отчете эти детальные записи не выводятся
		СтруктураРезультата.ПолеПоказателя 			= "ВидКонтакта";
		СтруктураРезультата.ТипПоказателя  			= "ВидыКонтактов";

	ИначеЕсли ИмяОтчета = "ЭффективностьВидовКонтакта" Тогда
		СтруктураРезультата.ПредставлениеПоказателя = "Вид контакта";
		СтруктураРезультата.ПолеПоказателя 			= "ВидКонтакта";
		СтруктураРезультата.ТипПоказателя  			= "ВидыКонтактов";
		
	ИначеЕсли ИмяОтчета = "ЭффективностьРекламныхАкций" Тогда
		СтруктураРезультата.ПредставлениеПоказателя = "Рекламная акция";
		СтруктураРезультата.ПолеПоказателя			= "РекламнаяАкция";
		СтруктураРезультата.ТипПоказателя  			= "РекламнаяАкция";
		
	ИначеЕсли ИмяОтчета = "ЭффективностьРекламныхИсточников" Тогда
		СтруктураРезультата.ПредставлениеПоказателя = "Рекламный источник";
		СтруктураРезультата.ПолеПоказателя 			= "РекламныйИсточник";
		СтруктураРезультата.ТипПоказателя  			= "РекламныеИсточники";
		
	ИначеЕсли ИмяОтчета = "ЭффективностьТочекПродаж" Тогда
		СтруктураРезультата.ПредставлениеПоказателя = "Точка продаж";
		СтруктураРезультата.ПолеПоказателя 			= "ТочкаПродаж";
		СтруктураРезультата.ТипПоказателя  			= "ТочкиПродаж";

	КонецЕсли;
	
	Возврат СтруктураРезультата;
	
КонецФункции
	
Функция ПустаяТаблицаПоказателей() Экспорт
	
	// при добавлении колонок также добавлять их в:
	// - общая форма "ФормаОтчетаЭффективности" / реквизит формы "ТаблицаТекущихПоказателей"
	// - общая форма "ФормаНастроекЭффективности" / реквизит формы "ВыбранныеПоказатели"
	// - общая форма "ФормаНастроекЭффективности" / реквизит формы "ДеревоПоказателей"
	
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("ИдПоказателя", 				Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("ПредставлениеПоказателя", 	Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("ОписаниеПоказателя", 		Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("ТекстЗапроса", 				Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("ЕстьСумма", 				Новый ОписаниеТипов("Булево"));
	Результат.Колонки.Добавить("ЕстьСреднее", 				Новый ОписаниеТипов("Булево"));
	Результат.Колонки.Добавить("СтруктураИтогов", 			Новый ОписаниеТипов("Структура"));
	Результат.Колонки.Добавить("Формат", 					Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("ИдРаздела", 				Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("ПредставлениеРаздела", 		Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("ИдРаздела2", 				Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("ПредставлениеРаздела2", 	Новый ОписаниеТипов("Строка"));
	
	Возврат Результат;
	
КонецФункции

// добавляет очередной показатель в таблицу доступных показателей
// Параметры:
// ТаблицаДоступныхПоказателей - таблица, в которую добавляется показатель
// СтруктураРазделов - структура с описанием разделов 1 и 2 уровня
// ИдПоказателя - уникальный в рамках отчета идентификатор показателя
// ПредставлениеПоказателя - представление показателя для отчета
// ОписаниеПоказателя - текстовое описание показателя, выводится на форме настроек
// Формат поля - доступные значение "Количество", "Сумма", учитывается в функции ФорматЯчейки(Значение, Формат)
// СтруктураИтогов - определяет параметры расчета и наличие итогов
// //ЕстьСумма - определяет необходимость вывода итога в строке "Сумма"
// //ЕстьСреднее - определяет необходимость вывода итога в строке "Среднее"
// ТекстЗапроса - текст запроса для вычисления значения показателя
    // Структура запроса:  
	// Раздел - идентификатор раздела, совпадает с параметром "СтруктураРазделов.ИдРаздела"
	// ИдПоказателя - идентификатор показателя - совпадает с параметром "ИдПоказателя"
	// Документ - ссылка на лид
	// Исполнитель - ссылка на исполнителя
	// ЗначениеПоказателя - значение показателя
	// Знаменатель - значение знаменателя (при расчете процентов, конверсии)
	// ВесЗнаменателя - использовать знаменатель при расчете показателя по исполнителю: -1 (нет), 1 (обычная конверсия), 100 (при расчете процента)
Процедура ДобавитьПоказатель(ТаблицаДоступныхПоказателей, 
									СтруктураРазделов,
									ИдПоказателя, ПредставлениеПоказателя, ОписаниеПоказателя, 
									Формат = "Количество",
									//ЕстьСумма = Истина, ЕстьСреднее = Истина,
									СтруктураИтогов,
									ТекстЗапроса 
									) Экспорт
	
	НоваяСтрока = ТаблицаДоступныхПоказателей.Добавить();

	НоваяСтрока.ИдПоказателя = ИдПоказателя;
	НоваяСтрока.ПредставлениеПоказателя = ПредставлениеПоказателя;
	НоваяСтрока.ОписаниеПоказателя = ОписаниеПоказателя;
	НоваяСтрока.ТекстЗапроса = ТекстЗапроса;
	НоваяСтрока.СтруктураИтогов = СтруктураИтогов;
	//НоваяСтрока.ЕстьСумма = ЕстьСумма;
	//НоваяСтрока.ЕстьСреднее = ЕстьСреднее;
	НоваяСтрока.Формат = Формат;
	
	НоваяСтрока.ИдРаздела = СтруктураРазделов.ИдРаздела;
	НоваяСтрока.ПредставлениеРаздела = СтруктураРазделов.ПредставлениеРаздела;
	НоваяСтрока.ИдРаздела2 = СтруктураРазделов.ИдРаздела2;
	НоваяСтрока.ПредставлениеРаздела2 = СтруктураРазделов.ПредставлениеРаздела2;
	
КонецПроцедуры

Функция ЗначениеПоказателя(ТаблицаДанныхДляПоиска, СтруктураПоиска, ЗначениеПоУмолчанию = 0) Экспорт
	
	ЗначениеПоказателя = ЗначениеПоУмолчанию;

	НайденныеСтроки = ТаблицаДанныхДляПоиска.НайтиСтроки(СтруктураПоиска);
	Если НайденныеСтроки.Количество() > 0 Тогда
		ЗначениеПоказателя = НайденныеСтроки[0].ЗначениеПоказателя;
	КонецЕсли;
	
	Возврат ЗначениеПоказателя;
	
КонецФункции

Функция ЗначениеПоказателяСоЗнаменателем(ТаблицаДанныхДляПоиска, СтруктураПоиска, ЗначениеПоУмолчанию = 0) Экспорт
	
	ЗначениеПоказателя = ЗначениеПоУмолчанию;

	НайденныеСтроки = ТаблицаДанныхДляПоиска.НайтиСтроки(СтруктураПоиска);
	Если НайденныеСтроки.Количество() > 0 Тогда
		Если НайденныеСтроки[0].Знаменатель = 0 Тогда
			ЗначениеПоказателя = 0;
		Иначе
			ЗначениеПоказателя = НайденныеСтроки[0].ЗначениеПоказателя / НайденныеСтроки[0].Знаменатель;
		КонецЕсли;
	КонецЕсли;
	
	Возврат ЗначениеПоказателя;
	
КонецФункции

Функция ФорматЯчейки(Значение, Формат) Экспорт
	
	Если Формат = "Сумма" Тогда
		Возврат Формат(Значение, "ЧДЦ=2");
	ИначеЕсли Формат = "Количество" Тогда
		Возврат Формат(Значение, "ЧДЦ=0");
	Иначе
		Возврат Значение;		
	КонецЕсли;
	
КонецФункции

Функция ФорматСумм(Значение) Экспорт
		
	Возврат Формат(Значение, "ЧДЦ=2");
	
КонецФункции

#КонецОбласти
