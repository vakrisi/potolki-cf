Процедура ЗаполнитьНастройкиПользовательскогоВариантаОтчета(ОтчетСсылка, КлючВарианта, ТаблицаДоступныхПоказателей, Результат) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВариантыОтчетов.Настройки КАК Настройки
	|ИЗ
	|	Справочник.ВариантыОтчетов КАК ВариантыОтчетов
	|ГДЕ
	|	ВариантыОтчетов.Отчет = &Отчет
	|	И ВариантыОтчетов.КлючВарианта = &КлючВарианта
	//|	И ВариантыОтчетов.ДополнительныйКлючОтчета = &ДополнительныйКлючОтчета
	|";
	
	Запрос.УстановитьПараметр("Отчет", ОтчетСсылка);
	Запрос.УстановитьПараметр("КлючВарианта", КлючВарианта);
	//Запрос.УстановитьПараметр("ДополнительныйКлючОтчета", ДополнительныйКлючОтчета);
	
	Вариант = Запрос.Выполнить().Выбрать();
	Если Вариант.Следующий() Тогда
		
		НастройкиОтчета = Вариант.Настройки.Получить();
		Если НЕ НастройкиОтчета = Неопределено И ТипЗнч(НастройкиОтчета) = Тип("Структура") Тогда
			Если НастройкиОтчета.Свойство("ТаблицаПоказателей") И ТипЗнч(НастройкиОтчета.ТаблицаПоказателей) = Тип("ТаблицаЗначений") Тогда
				Для каждого ПоказательПользователя из НастройкиОтчета.ТаблицаПоказателей Цикл
					Найденные = ТаблицаДоступныхПоказателей.НайтиСтроки(Новый Структура("ИдПоказателя", ПоказательПользователя.ИдПоказателя));
					НоваяСтрока = Результат.Добавить();
					ЗаполнитьЗначенияСвойств(НоваяСтрока, Найденные[0]);					
				КонецЦикла;
			Иначе
				// настройки невалидные
			КонецЕсли;
		Иначе
			// настройки невалидные	
		КонецЕсли;				
	КонецЕсли;
	
КонецПроцедуры

Процедура ДобавитьПоказательВПредопределенныйВариантОтчета(ТаблицаДоступныхПоказателей, ИдПоказателя, Результат) Экспорт
	
	НайденныеСтроки = ТаблицаДоступныхПоказателей.НайтиСтроки(Новый Структура("ИдПоказателя", ИдПоказателя));
	НоваяСтрока = Результат.Добавить();
	ЗаполнитьЗначенияСвойств(НоваяСтрока, НайденныеСтроки[0]);
	
КонецПроцедуры
		
#КонецОбласти

#Область ОбщиеПоказатели

Процедура ДобавитьОбщийПоказатель(ТаблицаДоступныхПоказателей, СтруктураРазделов,
	                              ИДПоказателя, ПолеПоказателя, ТипПоказателя = "",
								  НаименованиеПоказателя = ""
								  ) Экспорт

	СтруктураИтоговПоУмолчанию = СтруктураИтогов();
	
	СтруктураИтоговОтношениеБезСреднего = ОтчетыЭффективности.СтруктураИтогов();
	СтруктураИтоговОтношениеБезСреднего.ЕстьСреднее = Ложь;
	СтруктураИтоговОтношениеБезСреднего.ВариантСуммы = 1;
	СтруктураИтоговОтношениеБезСреднего.ДополнительныйВесСуммы = 1;
	
	СтруктураИтоговПроцентБезСреднего = СтруктураИтогов();
	СтруктураИтоговПроцентБезСреднего.ЕстьСреднее = Ложь;
	СтруктураИтоговПроцентБезСреднего.ВариантСуммы = 1;
	СтруктураИтоговПроцентБезСреднего.ДополнительныйВесСуммы = 100;
	
	
	#Область КоличествоЗамеров
	Если ИДПоказателя = "КоличествоЗамеров" Тогда
		ОтчетыЭффективности.ДобавитьПоказатель(ТаблицаДоступныхПоказателей, СтруктураРазделов,
			ИДПоказателя,
			"Назначено замеров, шт.",
			"Количество назначенных замеров: неотмененных замеров, дата которых попадает в период отчета, шт. (выезды не включаются)",
		    , СтруктураИтоговПоУмолчанию,
			
			СтрШаблон(
			"ВЫБРАТЬ
			|	""Лид"" КАК Раздел,
			|	""%1"" КАК ИдПоказателя,
			|	Замеры.ДокументЗамер КАК Лид,
			|	НЕОПРЕДЕЛЕНО КАК Документ,
			|	Замеры.ДокументЗамер.Дата КАК ДатаЛида,
			|	ДАТАВРЕМЯ(1,1,1) КАК ДатаДокумента,
			|	Замеры.ДокументЗамер.Организация КАК Организация,
			|	ВЫБОР
			|		КОГДА Замеры.Сотрудник = ЗНАЧЕНИЕ(Справочник.Сотрудники.ПустаяСсылка)
			|			ТОГДА ЗНАЧЕНИЕ(Справочник.Сотрудники.ПустаяСсылка)
			|		ИНАЧЕ Замеры.Сотрудник.Родитель
			|	КОНЕЦ КАК ИсполнительРодитель,
			|	Замеры.Сотрудник КАК Исполнитель,
			|	1 КАК ЗначениеПоказателя,		
			|	0 КАК Знаменатель,
			|	-1 КАК ВесЗнаменателя		
			|ИЗ
			|	РегистрСведений.Замеры КАК Замеры
			|ГДЕ
			|	НЕ Замеры.Результат = Значение(Справочник.РезультатЗамераЛида.ЗамерОтменен)
			|	И Замеры.Дата МЕЖДУ &НачалоПериода И &КонецПериода
			|	И НЕ Замеры.ЭтоВыезд
			|"
			, ИДПоказателя)
			);
	#КонецОбласти
	
	#Область КоличествоНеЗакрытыхЗамеров
	ИначеЕсли ИДПоказателя = "КоличествоНеЗакрытыхЗамеров" Тогда
		//КоличествоНЕЗакрытыхЗамеров = КоличествоЗамеров - (КоличествоЗамеровУспех+КоличествоЗамеровОтказ+КоличествоЗамеровНевыполнен)
		ОтчетыЭффективности.ДобавитьПоказатель(ТаблицаДоступныхПоказателей, СтруктураРазделов,
			ИДПоказателя,
			"Замеры в работе, шт.",
			"Замеры в работе: назначенных замеров, дата которых попадает в период отчета, за минусом замеров закрытых с любым результатом, шт. (выезды не включаются)",
		    , СтруктураИтоговПоУмолчанию,
			
			СтрШаблон(
			"ВЫБРАТЬ
			|	""Лид"" КАК Раздел,
			|   ""%1"" КАК ИдПоказателя,
			|	Замеры.ДокументЗамер КАК Лид,
			|	НЕОПРЕДЕЛЕНО КАК Документ,
			|	Замеры.ДокументЗамер.Дата КАК ДатаЛида,
			|	ДАТАВРЕМЯ(1,1,1) КАК ДатаДокумента,
			|	Замеры.ДокументЗамер.Организация КАК Организация,
			|	ВЫБОР
			|		КОГДА Замеры.Сотрудник = ЗНАЧЕНИЕ(Справочник.Сотрудники.ПустаяСсылка)
			|			ТОГДА ЗНАЧЕНИЕ(Справочник.Сотрудники.ПустаяСсылка)
			|		ИНАЧЕ Замеры.Сотрудник.Родитель
			|	КОНЕЦ КАК ИсполнительРодитель,
			|	Замеры.Сотрудник КАК Исполнитель,	
			|	1 - ВЫБОР КОГДА Замеры.Результат В (Значение(Справочник.РезультатЗамераЛида.ЗамерНеПроизводился),
			|                         Значение(Справочник.РезультатЗамераЛида.ЗаключенДоговор),
			|                         Значение(Справочник.РезультатЗамераЛида.ДоговорНеЗаключен))
			|        ТОГДА 1
			|		ИНАЧЕ 0
			|	КОНЕЦ КАК ЗначениеПоказателя,		
			|	0 КАК Знаменатель,
			|	-1 КАК ВесЗнаменателя
			|ИЗ
			|	РегистрСведений.Замеры КАК Замеры
			|ГДЕ
			|	НЕ Замеры.Результат = Значение(Справочник.РезультатЗамераЛида.ЗамерОтменен)
			|	И Замеры.Дата МЕЖДУ &НачалоПериода И &КонецПериода
			|	И НЕ Замеры.ЭтоВыезд   
			|
			|"
			, ИДПоказателя)
			);
	#КонецОбласти

	#Область КоличествоЗакрытыхЗамеров
	ИначеЕсли ИДПоказателя = "КоличествоЗакрытыхЗамеров" Тогда
		//КоличествоЗакрытыхЗамеров = КоличествоЗамеровУспех+КоличествоЗамеровОтказ+КоличествоЗамеровНевыполнен
		ОтчетыЭффективности.ДобавитьПоказатель(ТаблицаДоступныхПоказателей, СтруктураРазделов,
			"КоличествоЗакрытыхЗамеров",
			"Закрытые замеры, шт.",
			"Количество закрытых замеров: неотмененных замеров, дата которых попадает в период отчета, и закрытых с любым результатом, шт. (выезды не включаются)",
		    , СтруктураИтоговПоУмолчанию,
			
			"ВЫБРАТЬ
			|	""Лид"" КАК Раздел,
			|   ""КоличествоЗакрытыхЗамеров"" КАК ИдПоказателя,
			|	Замеры.ДокументЗамер КАК Лид,
			|	НЕОПРЕДЕЛЕНО КАК Документ,
			|	Замеры.ДокументЗамер.Дата КАК ДатаЛида,
			|	ДАТАВРЕМЯ(1,1,1) КАК ДатаДокумента,
			|	Замеры.ДокументЗамер.Организация КАК Организация,
			|	ВЫБОР
			|		КОГДА Замеры.Сотрудник = ЗНАЧЕНИЕ(Справочник.Сотрудники.ПустаяСсылка)
			|			ТОГДА ЗНАЧЕНИЕ(Справочник.Сотрудники.ПустаяСсылка)
			|		ИНАЧЕ Замеры.Сотрудник.Родитель
			|	КОНЕЦ КАК ИсполнительРодитель,
			|	Замеры.Сотрудник КАК Исполнитель,	
			|	1 КАК ЗначениеПоказателя,		
			|	0 КАК Знаменатель,
			|	-1 КАК ВесЗнаменателя
			|ИЗ
			|	РегистрСведений.Замеры КАК Замеры
			|ГДЕ
			|	НЕ Замеры.Результат = Значение(Справочник.РезультатЗамераЛида.ЗамерОтменен)
			|	И Замеры.Дата МЕЖДУ &НачалоПериода И &КонецПериода
			|	И НЕ Замеры.ЭтоВыезд
			|
			|   И Замеры.Результат В (Значение(Справочник.РезультатЗамераЛида.ЗамерНеПроизводился),
			|                         Значение(Справочник.РезультатЗамераЛида.ЗаключенДоговор),
			|                         Значение(Справочник.РезультатЗамераЛида.ДоговорНеЗаключен))
			|
			|");
	#КонецОбласти
	
	СтруктураРазделов.ИдРаздела2 = "ЛидПоЗакрытымЗамерам";
	СтруктураРазделов.ПредставлениеРаздела2 = "В закрытых замерах";
	
	//#Область КоличествоВыполненныхЗамеров
	//ИначеЕсли ИДПоказателя = "КоличествоВыполненныхЗамеров" Тогда
	//	ОтчетыЭффективности.ДобавитьПоказатель(ТаблицаДоступныхПоказателей, СтруктураРазделов,
