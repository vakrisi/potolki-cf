	#КонецОбласти
	
	#Область СуммаДоговоровПоДатеНазначения
	ИначеЕсли ИДПоказателя = "СуммаДоговоровПоДатеНазначения" Тогда
		ОтчетыЭффективности.ДобавитьПоказатель(ТаблицаДоступныхПоказателей, СтруктураРазделов,
