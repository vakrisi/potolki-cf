
#Область ОбработчикиСобытий

Функция СформироватьТабличныйДокумент(СтруктураПараметров, АдресДляРазмещенияРезультата = Неопределено) Экспорт
	
	ТаблицаТекущихПоказателей = СтруктураПараметров.ТаблицаПоказателей;
	Период = СтруктураПараметров.Период;
	
	ВыводитьДетальныеЗаписи = СтруктураПараметров.ВыводитьДетальныеЗаписи; // для отчета "ОтчетЭффективностьМаркетинга" не требуется
	
	Таб = Новый ТабличныйДокумент;
	Таб.ИмяПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_" + СтруктураПараметров.ИмяОтчета;
	
	Макет = ПолучитьОбщийМакет("МакетОтчетаЭффективности");
		
	Запрос = Новый Запрос(СтруктураПараметров.ТекстЗапроса);
	Запрос.УстановитьПараметр("НачалоПериода", Период.ДатаНачала);
	Запрос.УстановитьПараметр("КонецПериода", Период.ДатаОкончания);
	Запрос.УстановитьПараметр("ПустойИдентификатор", новый УникальныйИдентификатор("00000000-0000-0000-0000-000000000000"));
	
	// #13446
	Запрос.УстановитьПараметр("ОтборПоОрганизации", СтруктураПараметров.ОтборПоОрганизации);
	Запрос.УстановитьПараметр("Организация", СтруктураПараметров.Организация);		
	
	Запрос.УстановитьПараметр("ОтборПоПоказателю", СтруктураПараметров.ОтборПоПоказателю);
	Запрос.УстановитьПараметр("Показатель", СтруктураПараметров.Показатель);
	
	ТаблицаДанных = Запрос.Выполнить().Выгрузить();
	
	ТаблицаДанных.Свернуть("Раздел, ИдПоказателя, Лид, Документ, ДатаЛида, ДатаДокумента, ИсполнительРодитель, Исполнитель, ВесЗнаменателя", 
						   "ЗначениеПоказателя, Знаменатель");
	ТаблицаДанных.Сортировать("ДатаЛида, ДатаДокумента"); //#16032 для расшифровки
	
	Если НЕ ВыводитьДетальныеЗаписи Тогда
		ТаблицаДанных.ЗаполнитьЗначения(Неопределено, "Исполнитель, ИсполнительРодитель");	
	КонецЕсли;
	
	Если НЕ СтруктураПараметров.ВыводитьГруппы Тогда
		ТаблицаДанных.ЗаполнитьЗначения(Неопределено, "ИсполнительРодитель");
	КонецЕсли;
	//
	ТаблицаГруппИсполнителей = ТаблицаДанных.Скопировать();
	ТаблицаГруппИсполнителей.Свернуть("ИсполнительРодитель");

	//
	ТаблицаИсполнителей = ТаблицаДанных.Скопировать();
	ТаблицаИсполнителей.Свернуть("ИсполнительРодитель, Исполнитель");
	
	ТаблицаИсполнителей.Сортировать("ИсполнительРодитель, Исполнитель");	
	КоличествоИсполнителей = ТаблицаИсполнителей.Количество();
	Если КоличествоИсполнителей = 0 Тогда
		//Возврат Таб;	// отчет формируем "пустым"
	КонецЕсли;
	//
	ТаблицаПоказателейИсполнителей = ТаблицаДанных.Скопировать();
	ТаблицаПоказателейИсполнителей.Свернуть("Исполнитель, Раздел, ИдПоказателя, ВесЗнаменателя", "ЗначениеПоказателя, Знаменатель");
	// расчет процентов / конверсий
	Для каждого СтрокаТЗ из ТаблицаПоказателейИсполнителей Цикл
		Если СтрокаТЗ.ВесЗнаменателя = -1 Тогда 
			Продолжить;
		КонецЕсли;
		Если СтрокаТЗ.Знаменатель = 0 Тогда
			СтрокаТЗ.ЗначениеПоказателя = 0;
			Продолжить;
		КонецЕсли;
		СтрокаТЗ.ЗначениеПоказателя = СтрокаТЗ.ЗначениеПоказателя / СтрокаТЗ.Знаменатель  * СтрокаТЗ.ВесЗнаменателя;
	КонецЦикла;
	
	//
	ТаблицаПоказателейГрупп = ТаблицаДанных.Скопировать();
	ТаблицаПоказателейГрупп.Свернуть("ИсполнительРодитель, Раздел, ИдПоказателя, ВесЗнаменателя", "ЗначениеПоказателя, Знаменатель");
	// расчет процентов / конверсий
	Для каждого СтрокаТЗ из ТаблицаПоказателейГрупп Цикл
		Если СтрокаТЗ.ВесЗнаменателя = -1 Тогда 
			Продолжить;
		КонецЕсли;
		Если СтрокаТЗ.Знаменатель = 0 Тогда
			СтрокаТЗ.ЗначениеПоказателя = 0;
			Продолжить;
		КонецЕсли;
		СтрокаТЗ.ЗначениеПоказателя = СтрокаТЗ.ЗначениеПоказателя / СтрокаТЗ.Знаменатель  * СтрокаТЗ.ВесЗнаменателя;
	КонецЦикла;
	
	//
	ТаблицаИтоговПоказателей = ТаблицаДанных.Скопировать();
	ТаблицаИтоговПоказателей.Свернуть("Раздел, ИдПоказателя", "ЗначениеПоказателя, Знаменатель");
	
	ОбластьМакета = Макет.ПолучитьОбласть("Заголовок");
	ОбластьМакета.Параметры.НаименованиеОтчета = СтруктураПараметров.ПредставлениеОтчета;
	ОбластьМакета.Параметры.НачалоПериода = Формат(Период.ДатаНачала, "ДЛФ=Д");
	ОбластьМакета.Параметры.КонецПериода = Формат(Период.ДатаОкончания, "ДЛФ=Д");
	Таб.Вывести(ОбластьМакета);
		
	//шапка
	ОбластьМакета = Макет.ПолучитьОбласть("Шапка|Исполнитель");
	ОбластьМакета.Параметры.Показатель = СтруктураПараметров.ПредставлениеПоказателя;
	Таб.Вывести(ОбластьМакета);
	
	ИдПредыдущегоРаздела = Неопределено;
	ИдПредыдущегоРаздела2 = Неопределено;
	ПозицияТекРаздела = 2;
	ПозицияТекРаздела2 = 2;
	
	ТекПозиция = 2;
	Для каждого СтрокаПоказателя из ТаблицаТекущихПоказателей Цикл

		УровеньПоказателя = 2;
		ОбластьМакета = Макет.ПолучитьОбласть("Шапка|Показатель");
		//ОбластьМакета.Параметры.Заполнить(СтрокаПоказателя);
		ОбластьМакета.Параметры.Группировка1 = СтрокаПоказателя.ПредставлениеРаздела;
		ОбластьМакета.Параметры.Группировка2 = СтрокаПоказателя.ПредставлениеРаздела2;
		Если НЕ ЗначениеЗаполнено(СтрокаПоказателя.ИдРаздела2) Тогда
			ОбластьМакета.Параметры.Группировка2 = СтрокаПоказателя.ПредставлениеПоказателя;
		Иначе
			ОбластьМакета.Параметры.Группировка3 = СтрокаПоказателя.ПредставлениеПоказателя;
			УровеньПоказателя = 3;
		КонецЕсли;
		
		// #14909 пока убрано в рамках той же заявки
		//Если НЕ ПустаяСтрока(СтрокаПоказателя.ОписаниеПоказателя) Тогда
		//	ОбластьКолонкиЯчейки = ОбластьМакета.Область(УровеньПоказателя, 1, УровеньПоказателя, 1);
		//	ОбластьКолонкиЯчейки.Примечание.Текст = СтрокаПоказателя.ОписаниеПоказателя;
		//	
		//	ПараметрРасшифровки = "ЗначениеРасшифровкиГруппировки" + УровеньПоказателя;
		//	ОбластьМакета.Параметры[ПараметрРасшифровки] = СтрокаПоказателя.ОписаниеПоказателя;			
		//КонецЕсли;

		ОбластьЯчеек = Таб.Присоединить(ОбластьМакета);
				
		// "объединение" шапки показателя
		Если НЕ ЗначениеЗаполнено(СтрокаПоказателя.ИдРаздела2) Тогда
			ОбластьЗаголовка = Таб.Область(Таб.ВысотаТаблицы - 1, ТекПозиция, Таб.ВысотаТаблицы, ТекПозиция);
			ОбластьЗаголовка.Объединить();
		КонецЕсли;
		
		// "объединение" шапки верхнего раздела
		Если НЕ СтрокаПоказателя.ИдРаздела = ИдПредыдущегоРаздела И НЕ ИдПредыдущегоРаздела = Неопределено Тогда
			ОбластьЗаголовка = Таб.Область(Таб.ВысотаТаблицы - 2, ПозицияТекРаздела, Таб.ВысотаТаблицы - 2, ТекПозиция-1);
			ОбластьЗаголовка.Объединить();
			
			ПозицияТекРаздела = ТекПозиция;
		КонецЕсли;
		
		// "объединение" шапки раздела уровня 2
		Если НЕ СтрокаПоказателя.ИдРаздела2 = ИдПредыдущегоРаздела2 И НЕ ИдПредыдущегоРаздела2 = Неопределено Тогда
			Если ЗначениеЗаполнено(ИдПредыдущегоРаздела2) Тогда
				ОбластьЗаголовка = Таб.Область(Таб.ВысотаТаблицы - 1, ПозицияТекРаздела2, Таб.ВысотаТаблицы - 1, ТекПозиция-1);
				ОбластьЗаголовка.Объединить();
			КонецЕсли;
			
			ПозицияТекРаздела2 = ТекПозиция;
		КонецЕсли;
		
		ИдПредыдущегоРаздела = СтрокаПоказателя.ИдРаздела;
		ИдПредыдущегоРаздела2 = СтрокаПоказателя.ИдРаздела2;
		ТекПозиция = ТекПозиция + 1;
		
	КонецЦикла;
	// "объединение" шапки разделов (последние столбцы)
	ОбластьЗаголовка = Таб.Область(Таб.ВысотаТаблицы - 2, ПозицияТекРаздела, Таб.ВысотаТаблицы - 2, ТекПозиция-1);
	ОбластьЗаголовка.Объединить();
	Если ЗначениеЗаполнено(ИдПредыдущегоРаздела2) Тогда
		ОбластьЗаголовка = Таб.Область(Таб.ВысотаТаблицы - 1, ПозицияТекРаздела2, Таб.ВысотаТаблицы - 1, ТекПозиция-1);
		ОбластьЗаголовка.Объединить();
	КонецЕсли;
	
	Если ВыводитьДетальныеЗаписи Тогда
		
		Таб.НачатьАвтогруппировкуСтрок();
		
		Для каждого СтрокаГруппы из ТаблицаГруппИсполнителей Цикл
			
			Если СтруктураПараметров.ВыводитьГруппы Тогда
				ОбластьМакета = Макет.ПолучитьОбласть("Группа|Исполнитель");
				ОбластьМакета.Параметры.Заполнить(СтрокаГруппы);
				Таб.Вывести(ОбластьМакета, 1);
				Для каждого СтрокаПоказателя из ТаблицаТекущихПоказателей Цикл
					
					ОбластьМакета = Макет.ПолучитьОбласть("Группа|Показатель");	
					
					СтруктураПоиска = Новый Структура("ИсполнительРодитель, Раздел, ИдПоказателя", 
					СтрокаГруппы.ИсполнительРодитель, СтрокаПоказателя.ИдРаздела, СтрокаПоказателя.ИдПоказателя);
					ЗначениеПоказателя = ОтчетыЭффективности.ЗначениеПоказателя(ТаблицаПоказателейГрупп, СтруктураПоиска);								
					ОбластьМакета.Параметры.ЗначениеПоказателя = ОтчетыЭффективности.ФорматЯчейки(ЗначениеПоказателя, СтрокаПоказателя.Формат);
					
					Таб.Присоединить(ОбластьМакета, 1);	
					
				КонецЦикла;
			КонецЕсли;
			
			// строки исполнителей
			НайденныеСтрокиИсполнителей = ТаблицаИсполнителей.НайтиСтроки(Новый Структура("ИсполнительРодитель", СтрокаГруппы.ИсполнительРодитель));
			Для каждого СтрокаИсполнителя из НайденныеСтрокиИсполнителей Цикл
				
				ОбластьМакета = Макет.ПолучитьОбласть("Строка|Исполнитель");
				Исполнитель = ?(ЗначениеЗаполнено(СтрокаИсполнителя.Исполнитель), СтрокаИсполнителя.Исполнитель, НСтр("ru = '<не указан>'"));
				ОбластьМакета.Параметры.Заполнить(СтрокаИсполнителя);
				ОбластьМакета.Параметры.Исполнитель = Исполнитель;
				Таб.Вывести(ОбластьМакета, 2);
				
				Для каждого СтрокаПоказателя из ТаблицаТекущихПоказателей Цикл
					
					ОбластьМакета = Макет.ПолучитьОбласть("Строка|Показатель");
					
					СтруктураПоиска = Новый Структура("Исполнитель, Раздел, ИдПоказателя", 
					СтрокаИсполнителя.Исполнитель, СтрокаПоказателя.ИдРаздела, СтрокаПоказателя.ИдПоказателя);
					ЗначениеПоказателя = ОтчетыЭффективности.ЗначениеПоказателя(ТаблицаПоказателейИсполнителей, СтруктураПоиска);								
					ОбластьМакета.Параметры.ЗначениеПоказателя = ОтчетыЭффективности.ФорматЯчейки(ЗначениеПоказателя, СтрокаПоказателя.Формат);
					
					СтруктураПоиска.Вставить("Показатель", СтрокаПоказателя.ПредставлениеПоказателя);
					СтруктураПоиска.Вставить("ПредставлениеРаздела", СтрокаПоказателя.ПредставлениеРаздела);
					СтруктураПоиска.Вставить("Формат", СтрокаПоказателя.Формат);
					ОбластьМакета.Параметры.ЗначениеРасшифровки = СтруктураПоиска;
					
					Таб.Присоединить(ОбластьМакета, 2);	
					
				КонецЦикла;
				
			КонецЦикла;
			
		КонецЦикла;
		
		Таб.ЗакончитьАвтогруппировкуСтрок();
		
	КонецЕсли;
	
	// ИТОГ: Сумма
	Итоги = Новый Соответствие;
	ОбластьМакета = Макет.ПолучитьОбласть("Итог|Исполнитель"); 
	Таб.Вывести(ОбластьМакета);
	
	Для каждого СтрокаПоказателя из ТаблицаТекущихПоказателей Цикл
		ОбластьМакета = Макет.ПолучитьОбласть("Итог|Показатель");
		
		СтруктураИтогов = СтрокаПоказателя.СтруктураИтогов;
		
		ЗначениеПоказателя = 0;
		Если СтруктураИтогов.ЕстьСумма Тогда
			
			// сумма как сумма показателей
			Если СтруктураИтогов.ВариантСуммы = 0 Тогда
				СтруктураПоиска = Новый Структура("Раздел, ИдПоказателя", СтрокаПоказателя.ИдРаздела, СтрокаПоказателя.ИдПоказателя);
				ЗначениеПоказателя = ОтчетыЭффективности.ЗначениеПоказателя(ТаблицаИтоговПоказателей, СтруктураПоиска);
				
			// сумма как отношение сумм двух показателей
			ИначеЕсли СтруктураИтогов.ВариантСуммы = 1 Тогда
				СтруктураПоиска = Новый Структура("Раздел, ИдПоказателя", СтрокаПоказателя.ИдРаздела, СтрокаПоказателя.ИдПоказателя);
				ЗначениеПоказателя = ОтчетыЭффективности.ЗначениеПоказателяСоЗнаменателем(ТаблицаИтоговПоказателей, СтруктураПоиска);
				
			КонецЕсли;
			
			ЗначениеПоказателя = ЗначениеПоказателя * СтруктураИтогов.ДополнительныйВесСуммы;
			
		КонецЕсли;
		
		ОбластьМакета.Параметры.ЗначениеПоказателя = ОтчетыЭффективности.ФорматЯчейки(ЗначениеПоказателя, СтрокаПоказателя.Формат);
		
		// расшифровка итога
		СтруктураПоиска = Новый Структура;
		СтруктураПоиска.Вставить("Раздел", СтрокаПоказателя.ИдРаздела);
		СтруктураПоиска.Вставить("ИдПоказателя", СтрокаПоказателя.ИдПоказателя);
		СтруктураПоиска.Вставить("Показатель", СтрокаПоказателя.ПредставлениеПоказателя);
		СтруктураПоиска.Вставить("ПредставлениеРаздела", СтрокаПоказателя.ПредставлениеРаздела);
		СтруктураПоиска.Вставить("Формат", СтрокаПоказателя.Формат);
		ОбластьМакета.Параметры.ЗначениеРасшифровки = СтруктураПоиска;
		
		Итоги.Вставить(СтрокаПоказателя.ИдПоказателя, ЗначениеПоказателя);
		
		Таб.Присоединить(ОбластьМакета);	
		
	КонецЦикла;
	
	// ИТОГ: Среднее
	Если ВыводитьДетальныеЗаписи Тогда
		ОбластьМакета = Макет.ПолучитьОбласть("Среднее|Исполнитель"); 
		Таб.Вывести(ОбластьМакета);
		
		Для каждого СтрокаПоказателя из ТаблицаТекущихПоказателей Цикл
			
			ОбластьМакета = Макет.ПолучитьОбласть("Среднее|Показатель");
			
			СтруктураИтогов = СтрокаПоказателя.СтруктураИтогов;
			
			ЗначениеПоказателя = 0;
			Если СтруктураИтогов.ЕстьСреднее Тогда
				ЗначениеПоказателя = Итоги.Получить(СтрокаПоказателя.ИдПоказателя);
				Если ЗначениеПоказателя = Неопределено Тогда
					ЗначениеПоказателя = 0;
				КонецЕсли;	
			КонецЕсли;
			
			Если НЕ КоличествоИсполнителей = 0 Тогда
				ОбластьМакета.Параметры.ЗначениеПоказателя = ОтчетыЭффективности.ФорматСумм(ЗначениеПоказателя / КоличествоИсполнителей);
			КонецЕсли;
			
			Таб.Присоединить(ОбластьМакета);	
			
		КонецЦикла;
	КонецЕсли;
	
	Если СтруктураПараметров.КлючВарианта = "ВсеПоказатели" Тогда
		Таб.ФиксацияСлева = 1;
	КонецЕсли;
	
	СтруктураВозврата = Новый Структура;
	СтруктураВозврата.Вставить("ТабличныйДокумент", Таб);
	СтруктураВозврата.Вставить("ТаблицаДанных", ТаблицаДанных);
	
	АдресХранения = ПоместитьВоВременноеХранилище(СтруктураВозврата, АдресДляРазмещенияРезультата);
	Возврат СтруктураВозврата;
	
КонецФункции

Функция СформироватьРасшифровку(ТаблицаДанных, СтруктураРасшифровки, УникальныйИдентификатор) Экспорт
	
	Таб = Новый ТабличныйДокумент;
	Таб.ИмяПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_ЭффективностьРасшифровка";
	Макет = ПолучитьОбщийМакет("МакетРасшифровкиОтчетаЭффективности"); //ПолучитьМакет("МакетРасшифровки");
	
	ФорматПоказателя = "";
	СтруктураРасшифровки.Свойство("Формат", ФорматПоказателя);
		
	//шапка
	ОбластьМакета = Макет.ПолучитьОбласть("Шапка|Исполнитель"); 
	Таб.Вывести(ОбластьМакета);	
	ОбластьМакета = Макет.ПолучитьОбласть("Шапка|Показатель");
	ОбластьМакета.Параметры.ПредставлениеРаздела = СтруктураРасшифровки.ПредставлениеРаздела;
	ОбластьМакета.Параметры.Показатель = СтруктураРасшифровки.Показатель;
	Таб.Присоединить(ОбластьМакета);
	
	// строки
	Итог = 0;
	СтруктураПоиска = Новый Структура("Раздел, ИдПоказателя");
	ЗаполнитьЗначенияСвойств(СтруктураПоиска, СтруктураРасшифровки);
	Если СтруктураРасшифровки.Свойство("Исполнитель") Тогда
		СтруктураПоиска.Вставить("Исполнитель", СтруктураРасшифровки.Исполнитель); // расшифровка по строке отчета, иначе по итогу
	КонецЕсли;
	
	НайденныеСтроки = ТаблицаДанных.НайтиСтроки(СтруктураПоиска);
	Для каждого СтрокаПоказателя из НайденныеСтроки Цикл
		ОбластьМакета = Макет.ПолучитьОбласть("Строка|Исполнитель");
		ОбластьМакета.Параметры.Заполнить(СтрокаПоказателя);
		Таб.Вывести(ОбластьМакета);
	
		ОбластьМакета = Макет.ПолучитьОбласть("Строка|Показатель");
		ОбластьМакета.Параметры.ЗначениеПоказателя = ОтчетыЭффективности.ФорматЯчейки(СтрокаПоказателя.ЗначениеПоказателя, ФорматПоказателя);
		Таб.Присоединить(ОбластьМакета);
		
		Итог = Итог + СтрокаПоказателя.ЗначениеПоказателя;
	КонецЦикла;
	
	// итог
	ОбластьМакета = Макет.ПолучитьОбласть("Итог|Исполнитель"); 
	Таб.Вывести(ОбластьМакета);	
	ОбластьМакета = Макет.ПолучитьОбласть("Итог|Показатель");
	ОбластьМакета.Параметры.ЗначениеПоказателя = ОтчетыЭффективности.ФорматЯчейки(Итог, ФорматПоказателя); //Итог;
	Таб.Присоединить(ОбластьМакета);
		
	Возврат ПоместитьВоВременноеХранилище(Таб, УникальныйИдентификатор);
	
КонецФункции

