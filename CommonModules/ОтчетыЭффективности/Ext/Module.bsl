Процедура ЗагрузитьПользовательскиеНастройки(Форма) Экспорт //, ДополнительныйКлючОтчета) Экспорт
	
	//Если ЗначениеЗаполнено(ДополнительныйКлючОтчета) Тогда 
	//	КлючОбъекта = "Отчет." + Форма.ОтчетИмя + "/" + ДополнительныйКлючОтчета + "/ПоследниеПользовательскиеНастройки";
	//Иначе
		КлючОбъекта = "Отчет." + Форма.ОтчетИмя + "/ПоследниеПользовательскиеНастройки";
	//КонецЕсли;
	
	ПоследниеПользовательскиеНастройки = ХранилищеСистемныхНастроек.Загрузить(КлючОбъекта,"");
	
	Если ПоследниеПользовательскиеНастройки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(ПоследниеПользовательскиеНастройки) = Тип("ПользовательскиеНастройкиКомпоновкиДанных") Тогда
		
		Для каждого ЭлементНастройки из ПоследниеПользовательскиеНастройки.Элементы Цикл
			
			Если ТипЗнч(ЭлементНастройки) = Тип("ЗначениеПараметраНастроекКомпоновкиДанных") Тогда
				Если СтрНайти(ЭлементНастройки.ИдентификаторПользовательскойНастройки, "-") > 0 Тогда
					Продолжить;	
				КонецЕсли;
				Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Форма, ЭлементНастройки.ИдентификаторПользовательскойНастройки) Тогда
					Форма[ЭлементНастройки.ИдентификаторПользовательскойНастройки] = ЭлементНастройки.Значение;
				КонецЕсли;    
			КонецЕсли; 
		КонецЦикла;
		
	ИначеЕсли ТипЗнч(ПоследниеПользовательскиеНастройки) = Тип("Структура") Тогда
		
		Для каждого ЭлементНастройки из ПоследниеПользовательскиеНастройки.Элементы Цикл			
			Если ТипЗнч(ЭлементНастройки) = Тип("Структура") Тогда
				Если СтрНайти(ЭлементНастройки.ИдентификаторПользовательскойНастройки, "-") > 0 Тогда
					Продолжить;	
				КонецЕсли;
				Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Форма, ЭлементНастройки.ИдентификаторПользовательскойНастройки) Тогда
					Форма[ЭлементНастройки.ИдентификаторПользовательскойНастройки] = ЭлементНастройки.Значение;
				КонецЕсли;    
			КонецЕсли; 
		КонецЦикла;
		
	КонецЕсли;

КонецПроцедуры

