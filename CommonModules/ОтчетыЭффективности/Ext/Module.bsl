Функция ТаблицаДоступныхПоказателейПоЗамерщикам(Знач ПолеПоказателя="", Знач ТипПоказателя="") Экспорт

	ПолеПоказателя = "Менеджер";
	ТипПоказателя  = "Сотрудники";
	
	ТаблицаДоступныхПоказателей = ПустаяТаблицаПоказателей();
	
