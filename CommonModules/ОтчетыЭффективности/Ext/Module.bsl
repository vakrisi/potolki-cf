			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Лид КАК ДанныеДокумента
			|		ПО ДанныеРегистра.ДокументЗамер = ДанныеДокумента.Ссылка
			|ГДЕ
			|	ДанныеРегистра.ДатаНазначенияЗамера МЕЖДУ &НачалоПериода И &КонецПериода
			|	И НЕ ДанныеРегистра.ЭтоВыезд
			|   И (ДанныеРегистра.Результат = ЗНАЧЕНИЕ(Справочник.РезультатЗамераЛида.ЗаключенДоговор)
			|      ИЛИ ДанныеРегистра.Результат = ЗНАЧЕНИЕ(Справочник.РезультатЗамераЛида.ДоговорНеЗаключен)
			|      ИЛИ ДанныеРегистра.Результат = ЗНАЧЕНИЕ(Справочник.РезультатЗамераЛида.ЗамерНеПроизводился))
			|
			|"
			, ПолеПоказателя, ТипПоказателя)
			);
	#КонецОбласти

	КонецЕсли;
	
КонецПроцедуры

Процедура ДополнитьТекстЗапросаВТ(ТекстЗапроса) Экспорт

	Если СтрНайти(ТекстЗапроса, "ВТ_ПлощадиПоЗаказам") > 0 Тогда
		
		ТекстЗапроса =  
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ 
		|	ЗаказДоговорТоварыУслуги.Ссылка КАК ЗаказДоговор,
		|	ЗаказДоговорТоварыУслуги.Ссылка.Основание КАК Основание,
		|	КОЛИЧЕСТВО(ЗаказДоговорТоварыУслуги.Номенклатура) КАК КоличествоПотолков,
		|	СУММА(ЗаказДоговорТоварыУслуги.Количество * ЗаказДоговорТоварыУслуги.Коэффициент) КАК Площадь
		|ПОМЕСТИТЬ ВТ_ПлощадиПоЗаказам
		|ИЗ
		|	Документ.ЗаказДоговор.ТоварыУслуги КАК ЗаказДоговорТоварыУслуги
		|ГДЕ
		|	(ЗаказДоговорТоварыУслуги.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Справочник.ВидыНоменклатуры.Потолок)
		|			ИЛИ ЗаказДоговорТоварыУслуги.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Справочник.ВидыНоменклатуры.Отрез)
		|			ИЛИ ЗаказДоговорТоварыУслуги.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Справочник.ВидыНоменклатуры.ТиповойОтрез)
		|			ИЛИ ЗаказДоговорТоварыУслуги.Номенклатура.УчитыватьКакПотолокВОтчетахПоЭффективности)
		|	И ЗаказДоговорТоварыУслуги.Ссылка.Проведен
		|	И НЕ ЗаказДоговорТоварыУслуги.Ссылка.ПометкаУдаления
		|	И ЗаказДоговорТоварыУслуги.Ссылка.ВидЗаказа = ЗНАЧЕНИЕ(Справочник.ВидыЗаказДоговоров.Договор)
		|{ГДЕ
		|	(ЗаказДоговорТоварыУслуги.Ссылка.Основание.Дата >= &НачалоПериода
		|				И ЗаказДоговорТоварыУслуги.Ссылка.Основание.Дата <= &КонецПериода
		|			ИЛИ ЗаказДоговорТоварыУслуги.Ссылка.Дата >= &НачалоПериода
		|				И ЗаказДоговорТоварыУслуги.Ссылка.Дата <= &КонецПериода
		|			ИЛИ ЗаказДоговорТоварыУслуги.Ссылка.Основание.ПоследняяДатаЗамера >= &НачалоПериода
		|				И ЗаказДоговорТоварыУслуги.Ссылка.Основание.ПоследняяДатаЗамера <= &КонецПериода)}
		|
		|СГРУППИРОВАТЬ ПО
		|	ЗаказДоговорТоварыУслуги.Ссылка,
		|	ЗаказДоговорТоварыУслуги.Ссылка.Основание
		|;
		|
		|"	+ ТекстЗапроса;
		
	КонецЕсли;
	
	Если СтрНайти(ТекстЗапроса, "ВТ_ОбщиеПродажиПоЗаказам") > 0 Тогда
		ТекстЗапроса =  
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ПродажиПоЗаказДоговорамОбороты.Регистратор КАК ЗаказДоговор,
		|	СУММА(ПродажиПоЗаказДоговорамОбороты.СуммаОборот) КАК СреднийЧекСумма
		|ПОМЕСТИТЬ ВТ_ОбщиеПродажиПоЗаказам
		|ИЗ
		|	РегистрНакопления.ПродажиПоЗаказДоговорам.Обороты(, , Регистратор, ) КАК ПродажиПоЗаказДоговорамОбороты,
		|	Константа.ВсяНоменклатураПоУмолчаниюВСреднемЧеке КАК ВсяНоменклатураПоУмолчаниюВСреднемЧеке
		|ГДЕ
		|	ВЫБОР
		|			КОГДА ВсяНоменклатураПоУмолчаниюВСреднемЧеке.Значение
		|				ТОГДА ИСТИНА
		|			ИНАЧЕ ПродажиПоЗаказДоговорамОбороты.Номенклатура.УчитыватьВСреднемЧеке = ИСТИНА
		|		КОНЕЦ
		|
		|СГРУППИРОВАТЬ ПО
		|	ПродажиПоЗаказДоговорамОбороты.Регистратор
		|;
		|
		|"	+ ТекстЗапроса;
	КонецЕсли;
	
	Если СтрНайти(ТекстЗапроса, "ВТ_ОбщиеДанныеПоМонтажам") > 0 Тогда
		
		ТекстЗапроса =	
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	МонтажТоварыУслуги.Ссылка КАК Монтаж,
		|	МонтажТоварыУслуги.Ссылка.Организация КАК Организация,
		|	МонтажТоварыУслуги.Ссылка.ДатаВыполнения КАК ДатаМонтажа,
		|	МонтажТоварыУслуги.Ссылка.ДатаВыполнения КАК ДатаВыполненияМонтажа,
		|	МонтажТоварыУслуги.Ссылка.Основание КАК ЗаказДоговор,
		|	МонтажТоварыУслуги.Ссылка.Основание.Дата КАК ДатаДоговора,
		|	ЕСТЬNULL(МонтажТоварыУслуги.Ссылка.Основание.Основание.Менеджер, ЗНАЧЕНИЕ(Справочник.Сотрудники.ПустаяСсылка)) КАК МенеджерЛида,
		
		|	ЕСТЬNULL(МонтажТоварыУслуги.Ссылка.Основание.Основание.ВидКонтакта, ЗНАЧЕНИЕ(Справочник.ВидыКонтактов.ПустаяСсылка)) КАК ВидКонтакта,
		|	ЕСТЬNULL(МонтажТоварыУслуги.Ссылка.Основание.Основание.РекламнаяАкция, ЗНАЧЕНИЕ(Справочник.РекламнаяАкция.ПустаяСсылка)) КАК РекламнаяАкция,
		|	ЕСТЬNULL(МонтажТоварыУслуги.Ссылка.Основание.Основание.РекламныйИсточник, ЗНАЧЕНИЕ(Справочник.РекламныеИсточники.ПустаяСсылка)) КАК РекламныйИсточник,
		|	ЕСТЬNULL(МонтажТоварыУслуги.Ссылка.Основание.Основание.ТочкаПродаж, ЗНАЧЕНИЕ(Справочник.ТочкиПродаж.ПустаяСсылка)) КАК ТочкаПродаж,
		
		|	МонтажТоварыУслуги.Ссылка.Основание.ИсполнительЗамера КАК ИсполнительЗамера,
		|	МонтажТоварыУслуги.Ссылка.Основание.ИдентификаторЗамера КАК ИдентификаторЗамера,
		|	МонтажТоварыУслуги.Ссылка.Основание.Основание КАК Лид,
		|	МонтажТоварыУслуги.Ссылка.Основание.Основание.Дата КАК ДатаЛида,
		|	СРЕДНЕЕ(МонтажТоварыУслуги.Ссылка.СуммаДокумента) КАК СуммаМонтажа,
		|	СУММА(ВЫБОР
		|			КОГДА МонтажТоварыУслуги.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Справочник.ВидыНоменклатуры.Потолок)
		|					ИЛИ МонтажТоварыУслуги.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Справочник.ВидыНоменклатуры.Отрез)
		|					ИЛИ МонтажТоварыУслуги.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Справочник.ВидыНоменклатуры.ТиповойОтрез)
		|					ИЛИ МонтажТоварыУслуги.Номенклатура.УчитыватьКакПотолокВОтчетахПоЭффективности
		|				ТОГДА 1
		|			ИНАЧЕ 0
		|		КОНЕЦ) КАК КоличествоПотолков,
		|	СУММА(ВЫБОР
		|			КОГДА МонтажТоварыУслуги.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Справочник.ВидыНоменклатуры.Потолок)
		|					ИЛИ МонтажТоварыУслуги.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Справочник.ВидыНоменклатуры.Отрез)
		|					ИЛИ МонтажТоварыУслуги.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Справочник.ВидыНоменклатуры.ТиповойОтрез)
		|					ИЛИ МонтажТоварыУслуги.Номенклатура.УчитыватьКакПотолокВОтчетахПоЭффективности
		|				ТОГДА МонтажТоварыУслуги.Количество * МонтажТоварыУслуги.Коэффициент
		|			ИНАЧЕ 0
		|		КОНЕЦ) КАК ПлощадьПотолков
		|ПОМЕСТИТЬ ВТ_ОбщиеДанныеПоМонтажам
		|ИЗ
		|	Документ.Монтаж.ТоварыУслуги КАК МонтажТоварыУслуги
		|ГДЕ
		|	МонтажТоварыУслуги.Ссылка.Проведен
		|	И МонтажТоварыУслуги.Ссылка.Результат В (ЗНАЧЕНИЕ(Справочник.РезультатыМонтажа.Выполнен), ЗНАЧЕНИЕ(Справочник.РезультатыМонтажа.Закрыт))
		|	И МонтажТоварыУслуги.Ссылка.ВидОперации = ЗНАЧЕНИЕ(Справочник.ВидыМонтажа.Монтаж)
		
		//#12853 закомментировано: в отчете "Эффективность по лидам" в таблице "Монтажи за период по дате монтажа" должны попадать все монтажи, 
		// не важно привязаны они к лидам\договорам или нет. 
		//|	И МонтажТоварыУслуги.Ссылка.Основание ССЫЛКА Документ.ЗаказДоговор
		//|	И МонтажТоварыУслуги.Ссылка.Основание.Основание ССЫЛКА Документ.Лид
		
		|
		|СГРУППИРОВАТЬ ПО
		|	МонтажТоварыУслуги.Ссылка,
		|	МонтажТоварыУслуги.Ссылка.Организация,
		|	МонтажТоварыУслуги.Ссылка.ДатаВыполнения,
		|	МонтажТоварыУслуги.Ссылка.Основание,
		|	МонтажТоварыУслуги.Ссылка.Основание.Дата,
		
		|	ЕСТЬNULL(МонтажТоварыУслуги.Ссылка.Основание.Основание.Менеджер, ЗНАЧЕНИЕ(Справочник.Сотрудники.ПустаяСсылка)),
		|	ЕСТЬNULL(МонтажТоварыУслуги.Ссылка.Основание.Основание.ВидКонтакта, ЗНАЧЕНИЕ(Справочник.ВидыКонтактов.ПустаяСсылка)),
		|	ЕСТЬNULL(МонтажТоварыУслуги.Ссылка.Основание.Основание.РекламнаяАкция, ЗНАЧЕНИЕ(Справочник.РекламнаяАкция.ПустаяСсылка)),
		|	ЕСТЬNULL(МонтажТоварыУслуги.Ссылка.Основание.Основание.РекламныйИсточник, ЗНАЧЕНИЕ(Справочник.РекламныеИсточники.ПустаяСсылка)),
		|	ЕСТЬNULL(МонтажТоварыУслуги.Ссылка.Основание.Основание.ТочкаПродаж, ЗНАЧЕНИЕ(Справочник.ТочкиПродаж.ПустаяСсылка)),
		
		|	МонтажТоварыУслуги.Ссылка.Основание.ИсполнительЗамера,
		|	МонтажТоварыУслуги.Ссылка.Основание.ИдентификаторЗамера,
		|	МонтажТоварыУслуги.Ссылка.Основание.Основание,
		|	МонтажТоварыУслуги.Ссылка.Основание.Основание.Дата
		|;
		|
		|"	+ ТекстЗапроса;
		
	КонецЕсли;
	
	// таблицы отчета
	Если СтрНайти(ТекстЗапроса, "ВТ_ОбщиеПродажиПоЛидамЗаказам") > 0 Тогда
		ТекстЗапроса =  
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ПродажиПоЗаказДоговорамОбороты.Регистратор КАК ЗаказДоговор,
