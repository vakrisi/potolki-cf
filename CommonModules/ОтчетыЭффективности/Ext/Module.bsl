// используется для ВариантыОтчетов.ДеревоПредопределенных
Процедура ДобавитьПредопределенныеВариантыОтчетаЭффективностьПоЛидам(ТаблицаВариантов, ОписаниеОтчета, ОтчетТип) Экспорт
	
	РасшифровкаПоказателя = ""; // для ЭффективностьМаркетинга
	Если ОписаниеОтчета.Метаданные = Метаданные.Отчеты.ЭффективностьВидовКонтакта Тогда
		РасшифровкаПоказателя = " (по видам контактов)";
	ИначеЕсли ОписаниеОтчета.Метаданные = Метаданные.Отчеты.ЭффективностьРекламныхАкций Тогда
		РасшифровкаПоказателя = " (по рекламным акциям)";
	ИначеЕсли ОписаниеОтчета.Метаданные = Метаданные.Отчеты.ЭффективностьРекламныхИсточников Тогда
		РасшифровкаПоказателя = " (по рекламным источникам)";
	ИначеЕсли ОписаниеОтчета.Метаданные = Метаданные.Отчеты.ЭффективностьТочекПродаж Тогда
		РасшифровкаПоказателя = " (по точкам продаж)";
	КонецЕсли;	
	
	ВариантыНастроек = Новый Массив;
	ВариантыНастроек.Добавить(Новый Структура("Имя, Представление", "ВсеПоказатели", 					"Все показатели"));
	ВариантыНастроек.Добавить(Новый Структура("Имя, Представление", "АнализЛидовВПериодеОтчета", 		"1. Анализ лидов (по дате лида)"));
	ВариантыНастроек.Добавить(Новый Структура("Имя, Представление", "АнализЗамеровПоДатеЛида", 			"2. Анализ замеров (по дате лида)"));
	ВариантыНастроек.Добавить(Новый Структура("Имя, Представление", "АнализЗамеровПоДатеНазначения",	"3. Анализ замеров (по дате назначения замера)"));
	ВариантыНастроек.Добавить(Новый Структура("Имя, Представление", "АнализДоговоровПоДатеЛида", 		"4. Анализ договоров (по дате лида)"));
	ВариантыНастроек.Добавить(Новый Структура("Имя, Представление", "АнализДоговоровПоДатеДоговора", 	"5. Анализ договоров (по дате договора)"));
	ВариантыНастроек.Добавить(Новый Структура("Имя, Представление", "АнализПрайсаПоДатеЛида", 			"6. Анализ работы с прайсом (по дате лида)"));
	ВариантыНастроек.Добавить(Новый Структура("Имя, Представление", "АнализПрайсаПоДатеДоговора", 		"7. Анализ работы с прайсом (по дате договора)"));
	ВариантыНастроек.Добавить(Новый Структура("Имя, Представление", "АнализМонтажейПоМенеджерамЛида", 	СтрШаблон("8. Анализ монтажей%1", РасшифровкаПоказателя)));
		
	ДобавитьПредопределенныеВариантыОтчета(ТаблицаВариантов, ОписаниеОтчета, ОтчетТип, ВариантыНастроек);
	
КонецПроцедуры

Процедура НастроитьОтчеты(Настройки) Экспорт
	
	ВариантыОтчетов.ОписаниеВарианта(Настройки, Метаданные.Отчеты.ЭффективностьВидовКонтакта, "ВсеПоказатели").Включен = Истина;
	ВариантыОтчетов.ОписаниеВарианта(Настройки, Метаданные.Отчеты.ЭффективностьЗамерщиков, "ВсеПоказатели").Включен = Истина;
	ВариантыОтчетов.ОписаниеВарианта(Настройки, Метаданные.Отчеты.ЭффективностьМаркетинга, "ВсеПоказатели").Включен = Истина;
	ВариантыОтчетов.ОписаниеВарианта(Настройки, Метаданные.Отчеты.ЭффективностьМенеджеров, "ВсеПоказатели").Включен = Истина;
	ВариантыОтчетов.ОписаниеВарианта(Настройки, Метаданные.Отчеты.ЭффективностьРекламныхАкций, "ВсеПоказатели").Включен = Истина;
	ВариантыОтчетов.ОписаниеВарианта(Настройки, Метаданные.Отчеты.ЭффективностьРекламныхИсточников, "ВсеПоказатели").Включен = Истина;
	ВариантыОтчетов.ОписаниеВарианта(Настройки, Метаданные.Отчеты.ЭффективностьТочекПродаж, "ВсеПоказатели").Включен = Истина;
	
КонецПроцедуры

Процедура ДобавитьПредопределенныеВариантыОтчета(ТаблицаВариантов, ОписаниеОтчета, ОтчетТип, ВариантыНастроек)
	
	Для каждого ВариантНастроек из ВариантыНастроек Цикл
		ОписаниеВарианта = ТаблицаВариантов.Добавить();
		ОписаниеВарианта.Отчет        = ОписаниеОтчета.Отчет;
		//ОписаниеВарианта.ОтчетМетаданные = ОтчетМетаданные;
		ОписаниеВарианта.КлючВарианта = ВариантНастроек.Имя;
		ОписаниеВарианта.Наименование = ВариантНастроек.Представление;
		ОписаниеВарианта.Тип          = ОтчетТип;
		ОписаниеВарианта.ЭтоВариант   = Истина;
		//ОписаниеВарианта.Включен      = ВариантНастроек.Включен;
		//Если СтрокаОтчет.ОсновнойВариант = Неопределено Тогда
		//	СтрокаОтчет.ОсновнойВариант = Вариант;
		//КонецЕсли;
		Если ПустаяСтрока(ОписаниеОтчета.ОсновнойВариант) Тогда
			ОписаниеОтчета.ОсновнойВариант = ОписаниеВарианта.КлючВарианта;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

