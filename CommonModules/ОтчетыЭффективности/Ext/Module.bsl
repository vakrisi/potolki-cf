	ИначеЕсли ИДПоказателя = "СуммаСкидкиДоговоровПоДоговорам" Тогда
		ОтчетыЭффективности.ДобавитьПоказатель(ТаблицаДоступныхПоказателей, СтруктураРазделов,
			"СуммаСкидкиДоговоровПоДоговорам",
			"Сумма скидки по договорам",
			"Сумма скидки по договорам, оформленных в период отчета",
		    "Сумма", СтруктураИтоговПоУмолчанию,
		
		    СтрШаблон(
			"ВЫБРАТЬ
			|	""Договор"" КАК Раздел,
			|   ""СуммаСкидкиДоговоровПоДоговорам"" КАК ИдПоказателя,
			| 	ДанныеЛида.Ссылка КАК Лид,
			| 	ДанныеДокумента.Ссылка КАК Документ,
			| 	ДанныеЛида.Дата КАК ДатаЛида,
			| 	ДанныеДокумента.Дата КАК ДатаДокумента,
			|	ДанныеДокумента.Организация КАК Организация,
			|	ВЫБОР
			|		КОГДА ЕСТЬNULL(%1, ЗНАЧЕНИЕ(Справочник.%2.ПустаяСсылка)) = ЗНАЧЕНИЕ(Справочник.%2.ПустаяСсылка)
			|			ТОГДА ЗНАЧЕНИЕ(Справочник.%2.ПустаяСсылка)
			|		ИНАЧЕ %1.Родитель
			|	КОНЕЦ КАК ИсполнительРодитель,
			|	ЕСТЬNULL(%1, НЕОПРЕДЕЛЕНО) КАК Исполнитель,
			|	ДанныеДокумента.СуммаСкидки КАК ЗначениеПоказателя,
			|	0 КАК Знаменатель,
			|	-1 КАК ВесЗнаменателя
			|ИЗ
			|	Документ.ЗаказДоговор КАК ДанныеДокумента
			
			|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Лид КАК ДанныеЛида
			|		ПО ДанныеДокумента.Основание = ДанныеЛида.Ссылка
			
			|
			|ГДЕ
			|	ДанныеДокумента.Проведен
			|	И ДанныеДокумента.ВидЗаказа = ЗНАЧЕНИЕ(Справочник.ВидыЗаказДоговоров.Договор)
			|	И ДанныеДокумента.Дата МЕЖДУ &НачалоПериода И &КонецПериода
			|
			|"
			, ПолеПоказателя, ТипПоказателя)
			);
	#КонецОбласти
	
	#Область СреднийПроцентСкидкиДоговоровПоДоговорам
	ИначеЕсли ИДПоказателя = "СреднийПроцентСкидкиДоговоровПоДоговорам" Тогда
		ОтчетыЭффективности.ДобавитьПоказатель(ТаблицаДоступныхПоказателей, СтруктураРазделов,
			"СреднийПроцентСкидкиДоговоровПоДоговорам", 
			"Средняя скидка по договорам, %",
			"Средний процент скидки по договорам, оформленным в период отчета",
		    "Сумма", СтруктураИтоговПроцентБезСреднего,
		
		    СтрШаблон(
			"ВЫБРАТЬ
			|	""Договор"" КАК Раздел,
			|	""СреднийПроцентСкидкиДоговоровПоДоговорам"" КАК ИдПоказателя,
			|	ЗНАЧЕНИЕ(Документ.Лид.ПустаяСсылка) КАК Лид,
			|	НЕОПРЕДЕЛЕНО КАК Документ,
			|	ДАТАВРЕМЯ(1,1,1) КАК ДатаЛида,
			|	ДАТАВРЕМЯ(1,1,1) КАК ДатаДокумента,
			// отбор по организации ниже в условии
			|	НЕОПРЕДЕЛЕНО КАК Организация,
			|	ВЫБОР
			|		КОГДА ЕСТЬNULL(%1, ЗНАЧЕНИЕ(Справочник.%2.ПустаяСсылка)) = ЗНАЧЕНИЕ(Справочник.%2.ПустаяСсылка)
			|			ТОГДА ЗНАЧЕНИЕ(Справочник.%2.ПустаяСсылка)
			|		ИНАЧЕ %1.Родитель
			|	КОНЕЦ КАК ИсполнительРодитель,
			|	ЕСТЬNULL(%1, НЕОПРЕДЕЛЕНО) КАК Исполнитель,
			|	ДанныеДокумента.СуммаСкидки КАК ЗначениеПоказателя,
			|	ДанныеДокумента.СуммаДокумента + ДанныеДокумента.СуммаСкидки КАК Знаменатель,	
			|	100 КАК ВесЗнаменателя
			|ИЗ
			|	Документ.ЗаказДоговор КАК ДанныеДокумента
			
			|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Лид КАК ДанныеЛида
			|		ПО ДанныеДокумента.Основание = ДанныеЛида.Ссылка
			
			|ГДЕ
			|	ДанныеДокумента.Проведен
			|	И ДанныеДокумента.ВидЗаказа = ЗНАЧЕНИЕ(Справочник.ВидыЗаказДоговоров.Договор)
			|	И ДанныеДокумента.Дата МЕЖДУ &НачалоПериода И &КонецПериода
			// для отдельных показателей отбор по организации применяем "сразу"
			|	И ВЫБОР 
			|		КОГДА &ОтборПоОрганизации 
			|			ТОГДА ДанныеДокумента.Организация = &Организация
			|		ИНАЧЕ ИСТИНА 
			|	КОНЕЦ
			|
			|"
			, ПолеПоказателя, ТипПоказателя)
			);
	#КонецОбласти	
		
#Область КоличествоОформленныхДоговоровПоДоговорамПоВыполненнымЗамерам
	ИначеЕсли ИДПоказателя = "КоличествоОформленныхДоговоровПоДоговорамПоВыполненнымЗамерам" Тогда
		
		// #15996 
		ОтчетыЭффективности.ДобавитьПоказатель(ТаблицаДоступныхПоказателей, СтруктураРазделов,
			ИДПоказателя, 
			"Количество оформленных договоров / Выполненные замеры, %",
			"Количество оформленных договоров в период отчета / Выполненные замеры, %",
	    	"Сумма", СтруктураИтоговПроцентБезСреднего,
			
			СтрШаблон(
			"ВЫБРАТЬ
			|	""%1"" КАК Раздел,
			|   ""%2"" КАК ИдПоказателя,
			|	ЗНАЧЕНИЕ(Документ.Лид.ПустаяСсылка) КАК Лид,
			|	НЕОПРЕДЕЛЕНО КАК Документ,
			|	ДАТАВРЕМЯ(1,1,1) КАК ДатаЛида,
			|	ДАТАВРЕМЯ(1,1,1) КАК ДатаДокумента,
			// отбор по организации ниже во вложенных запросах
			|	НЕОПРЕДЕЛЕНО КАК Организация,
			|	ВЫБОР
			|		КОГДА ВложенныйЗапрос.ИсполнительЗамера = ЗНАЧЕНИЕ(Справочник.Сотрудники.ПустаяСсылка)
			|			ТОГДА ЗНАЧЕНИЕ(Справочник.Сотрудники.ПустаяСсылка)
			|		ИНАЧЕ ВложенныйЗапрос.ИсполнительЗамера.Родитель
			|	КОНЕЦ КАК ИсполнительРодитель,
			|	ВложенныйЗапрос.ИсполнительЗамера КАК Исполнитель,
			|	ВложенныйЗапрос.КоличествоДоговоров КАК ЗначениеПоказателя,
			|	ВложенныйЗапрос.КоличествоВыполненныхЗамеров КАК Знаменатель,		
			|	100 КАК ВесЗнаменателя
			|ИЗ
			|	(ВЫБРАТЬ
			// знаменатель: количество выполненных замеров (с договором или без)
			|		Замеры.Сотрудник КАК ИсполнительЗамера,
			|		1 КАК КоличествоВыполненныхЗамеров,
			|		0 КАК КоличествоДоговоров
			|	ИЗ
			|		РегистрСведений.Замеры КАК Замеры
			|	ГДЕ
			|		НЕ Замеры.Результат = ЗНАЧЕНИЕ(Справочник.РезультатЗамераЛида.ЗамерОтменен)
			|		И Замеры.Дата МЕЖДУ &НачалоПериода И &КонецПериода
			|		И НЕ Замеры.ЭтоВыезд
			|		И Замеры.ЗамерВыполнен
			// для отдельных показателей отбор по организации применяем "сразу"
			|		И ВЫБОР
			|			КОГДА &ОтборПоОрганизации 
			|				ТОГДА Замеры.ДокументЗамер.Организация = &Организация 
			|			ИНАЧЕ 
			|				ИСТИНА 
			|		КОНЕЦ
			|		
			|	ОБЪЕДИНИТЬ ВСЕ
			// договоры, дата которых попадает в указанный период
			|		
			|	ВЫБРАТЬ
			|		ДанныеДокумента.ИсполнительЗамера,
			|		0,
			|		1
			|	ИЗ
			|		Документ.ЗаказДоговор КАК ДанныеДокумента
			|	ГДЕ
			|		ДанныеДокумента.Проведен
			|		И ДанныеДокумента.ВидЗаказа = ЗНАЧЕНИЕ(Справочник.ВидыЗаказДоговоров.Договор)
			|		И ДанныеДокумента.Дата МЕЖДУ &НачалоПериода И &КонецПериода
			// для отдельных показателей отбор по организации применяем "сразу"
			|		И ВЫБОР 
			|			КОГДА &ОтборПоОрганизации 
			|				ТОГДА ДанныеДокумента.Организация = &Организация 
			|			ИНАЧЕ ИСТИНА 
			|		КОНЕЦ
			|	) КАК ВложенныйЗапрос
			|	
			|"
			, СтруктураРазделов.ИдРаздела, ИДПоказателя)
			);
	#КонецОбласти
	
	#Область КоличествоОформленныхДоговоровПоДоговорамПоНазначеннымЗамерам
	ИначеЕсли ИДПоказателя = "КоличествоОформленныхДоговоровПоДоговорамПоНазначеннымЗамерам" Тогда
		
		// #15996 
		ОтчетыЭффективности.ДобавитьПоказатель(ТаблицаДоступныхПоказателей, СтруктураРазделов,
			ИДПоказателя, 
			"Количество оформленных договоров / Назначенные замеры, %",
			"Количество оформленных договоров в период отчета / Назначенные замеры, %",
	    	"Сумма", СтруктураИтоговПроцентБезСреднего,
			
			СтрШаблон(
			"ВЫБРАТЬ
			|	""%1"" КАК Раздел,
			|   ""%2"" КАК ИдПоказателя,
			|	ЗНАЧЕНИЕ(Документ.Лид.ПустаяСсылка) КАК Лид,
			|	НЕОПРЕДЕЛЕНО КАК Документ,
			|	ДАТАВРЕМЯ(1,1,1) КАК ДатаЛида,
			|	ДАТАВРЕМЯ(1,1,1) КАК ДатаДокумента,
			// отбор по организации ниже во вложенных запросах
			|	НЕОПРЕДЕЛЕНО КАК Организация,
			|	ВЫБОР
			|		КОГДА ВложенныйЗапрос.ИсполнительЗамера = ЗНАЧЕНИЕ(Справочник.Сотрудники.ПустаяСсылка)
			|			ТОГДА ЗНАЧЕНИЕ(Справочник.Сотрудники.ПустаяСсылка)
			|		ИНАЧЕ ВложенныйЗапрос.ИсполнительЗамера.Родитель
			|	КОНЕЦ КАК ИсполнительРодитель,
			|	ВложенныйЗапрос.ИсполнительЗамера КАК Исполнитель,
			|	ВложенныйЗапрос.КоличествоДоговоров КАК ЗначениеПоказателя,
			|	ВложенныйЗапрос.КоличествоВыполненныхЗамеров КАК Знаменатель,		
			|	100 КАК ВесЗнаменателя
			|ИЗ
			|	(ВЫБРАТЬ
			// знаменатель: количество неотмененных замеров
			|		Замеры.Сотрудник КАК ИсполнительЗамера,
			|		1 КАК КоличествоВыполненныхЗамеров,
			|		0 КАК КоличествоДоговоров
			|	ИЗ
			|		РегистрСведений.Замеры КАК Замеры
			|	ГДЕ
			|		Замеры.Дата МЕЖДУ &НачалоПериода И &КонецПериода
			|		И Замеры.Результат В (ЗНАЧЕНИЕ(Справочник.РезультатЗамераЛида.ЗаключенДоговор), ЗНАЧЕНИЕ(Справочник.РезультатЗамераЛида.ДоговорНеЗаключен), ЗНАЧЕНИЕ(Справочник.РезультатЗамераЛида.ЗамерНеПроизводился))
			|		И НЕ Замеры.ЭтоВыезд
			// для отдельных показателей отбор по организации применяем "сразу"
			|		И ВЫБОР
			|			КОГДА &ОтборПоОрганизации 
			|				ТОГДА Замеры.ДокументЗамер.Организация = &Организация 
			|			ИНАЧЕ 
			|				ИСТИНА 
			|		КОНЕЦ
			|		
			|	ОБЪЕДИНИТЬ ВСЕ
			// договоры, дата которых попадает в указанный период
			|		
			|	ВЫБРАТЬ
			|		ДанныеДокумента.ИсполнительЗамера,
			|		0,
			|		1
			|	ИЗ
			|		Документ.ЗаказДоговор КАК ДанныеДокумента
			|	ГДЕ
			|		ДанныеДокумента.Проведен
			|		И ДанныеДокумента.ВидЗаказа = ЗНАЧЕНИЕ(Справочник.ВидыЗаказДоговоров.Договор)
			|		И ДанныеДокумента.Дата МЕЖДУ &НачалоПериода И &КонецПериода
			// для отдельных показателей отбор по организации применяем "сразу"
			|		И ВЫБОР 
			|			КОГДА &ОтборПоОрганизации 
			|				ТОГДА ДанныеДокумента.Организация = &Организация 
			|			ИНАЧЕ ИСТИНА 
			|		КОНЕЦ
			|	) КАК ВложенныйЗапрос
			|	
			|"
			, СтруктураРазделов.ИдРаздела, ИДПоказателя)
			);
	#КонецОбласти	

	/////////////////////////////////////////////////////////////////////////////////////////////////////////////////
	
	#Область КоличествоДоговоровПоЛидам
	ИначеЕсли ИДПоказателя = "КоличествоДоговоровПоЛидам" Тогда
		ОтчетыЭффективности.ДобавитьПоказатель(ТаблицаДоступныхПоказателей, СтруктураРазделов,
			"КоличествоДоговоровПоЛидам",
			"Количество оформленных договоров, шт.",
			"Количество оформленных договоров, основание-лид которых попадает в период отчета, шт.",
			, СтруктураИтоговПоУмолчанию,
			
			СтрШаблон(
			"ВЫБРАТЬ
			//|	""ЛидДоговор"" КАК Раздел,
			|	""Лид"" КАК Раздел,
			|   ""КоличествоДоговоровПоЛидам"" КАК ИдПоказателя,
			| 	ДанныеЛида.Ссылка КАК Лид,
			| 	ДанныеДокумента.Ссылка КАК Документ,
			| 	ДанныеЛида.Дата КАК ДатаЛида,
			| 	ДанныеДокумента.Дата КАК ДатаДокумента,
			|	ДанныеДокумента.Организация КАК Организация,
			|	ВЫБОР
			|		КОГДА ЕСТЬNULL(%1, ЗНАЧЕНИЕ(Справочник.%2.ПустаяСсылка)) = ЗНАЧЕНИЕ(Справочник.%2.ПустаяСсылка)
			|			ТОГДА ЗНАЧЕНИЕ(Справочник.%2.ПустаяСсылка)
			|		ИНАЧЕ %1.Родитель
			|	КОНЕЦ КАК ИсполнительРодитель,
			|	ЕСТЬNULL(%1, НЕОПРЕДЕЛЕНО) КАК Исполнитель,
			|	1 КАК ЗначениеПоказателя,
			|	0 КАК Знаменатель,
			|	-1 КАК ВесЗнаменателя
			|ИЗ
			|	Документ.ЗаказДоговор КАК ДанныеДокумента
			
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Лид КАК ДанныеЛида
			|		ПО ДанныеДокумента.Основание = ДанныеЛида.Ссылка
			|
			|ГДЕ
			|	ДанныеДокумента.Проведен
			|	И ДанныеДокумента.ВидЗаказа = ЗНАЧЕНИЕ(Справочник.ВидыЗаказДоговоров.Договор)
			|	И ДанныеЛида.Дата МЕЖДУ &НачалоПериода И &КонецПериода
			|
			|"
			, ПолеПоказателя, ТипПоказателя)
			);
	#КонецОбласти
	
	#Область СуммаДоговоровПоДатеЛида
	ИначеЕсли ИДПоказателя = "СуммаДоговоровПоДатеЛида" Тогда
		ОтчетыЭффективности.ДобавитьПоказатель(ТаблицаДоступныхПоказателей, СтруктураРазделов,
			"СуммаДоговоровПоДатеЛида",
			"Сумма договоров",
			"Сумма договоров, основание-лид которых попадает в период отчета",
		    "Сумма", СтруктураИтоговПоУмолчанию,
		
			СтрШаблон(
			"ВЫБРАТЬ
			|	""Лид"" КАК Раздел,
			|   ""СуммаДоговоровПоДатеЛида"" КАК ИдПоказателя,
			| 	ДанныеЛида.Ссылка КАК Лид,
			| 	ДанныеДокумента.Ссылка КАК Документ,
			| 	ДанныеЛида.Дата КАК ДатаЛида,
			| 	ДанныеДокумента.Дата КАК ДатаДокумента,
			|	ДанныеДокумента.Организация КАК Организация,
			|	ВЫБОР
			|		КОГДА ЕСТЬNULL(%1, ЗНАЧЕНИЕ(Справочник.%2.ПустаяСсылка)) = ЗНАЧЕНИЕ(Справочник.%2.ПустаяСсылка)
			|			ТОГДА ЗНАЧЕНИЕ(Справочник.%2.ПустаяСсылка)
			|		ИНАЧЕ %1.Родитель
			|	КОНЕЦ КАК ИсполнительРодитель,
			|	ЕСТЬNULL(%1, НЕОПРЕДЕЛЕНО) КАК Исполнитель,
			|	ДанныеДокумента.СуммаДокумента КАК ЗначениеПоказателя,
			|	0 КАК Знаменатель,
			|	-1 КАК ВесЗнаменателя
			|ИЗ
			|	Документ.ЗаказДоговор КАК ДанныеДокумента
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Лид КАК ДанныеЛида
			|		ПО ДанныеДокумента.Основание = ДанныеЛида.Ссылка
			|
