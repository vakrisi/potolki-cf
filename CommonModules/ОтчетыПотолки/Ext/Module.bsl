#Область ПанельИзбранноеНачальнаяСтраница

&НаСервере
Функция ТаблицаОтчетовПользователяНаНачальнойСтранице() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТекущийПользователь", Пользователи.ТекущийПользователь());
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	""00000000-0000-0000-0000-000000000000"" КАК УИД,
	|	ИзбранныеОтчетыПользователя.ВариантОтчета КАК Вариант,
	|	ИзбранныеОтчетыПользователя.ВариантОтчета.Отчет КАК Отчет,
	|	ИзбранныеОтчетыПользователя.ВариантОтчета.КлючВарианта КАК КлючВарианта,
	|	ИзбранныеОтчетыПользователя.ВариантОтчета.Наименование КАК Наименование,
	|	ИзбранныеОтчетыПользователя.ВариантОтчета.Описание КАК Описание,
	|	ИзбранныеОтчетыПользователя.Порядок КАК Порядок
	|ИЗ
	|	РегистрСведений.ИзбранныеОтчетыПользователя КАК ИзбранныеОтчетыПользователя
	|ГДЕ
	|	ИзбранныеОтчетыПользователя.Пользователь = &ТекущийПользователь
	|
	|УПОРЯДОЧИТЬ ПО
	|	ИзбранныеОтчетыПользователя.Порядок";
	
	ТаблицаОтчетов = Запрос.Выполнить().Выгрузить();
	
	Для каждого СтрокаТЗ из ТаблицаОтчетов Цикл
		Если ТипЗнч(СтрокаТЗ.Вариант) = Тип("СправочникСсылка.ВариантыОтчетов") Тогда
			СтрокаТЗ.УИД = СтрЗаменить(СтрокаТЗ.Вариант.УникальныйИдентификатор(), "-", "");
		Иначе
			СтрокаТЗ.УИД = СтрЗаменить(Строка(Новый УникальныйИдентификатор), "-", "");
		КонецЕсли;
	КонецЦикла;
	
	Возврат ТаблицаОтчетов;
	
КонецФункции

#КонецОбласти

#Область ОтчетыЭффективности

// вызывается из ВариантыОтчетов.ДеревоПредопределенных
Процедура ДобавитьПредопределенныеВариантыОтчетовНеСКД(ТаблицаВариантов, ОписаниеОтчета, ОтчетТип) Экспорт
	
	Если ОписаниеОтчета.Метаданные = Метаданные.Отчеты.ЭффективностьЗамерщиков Тогда
		ОтчетыЭффективности.ДобавитьПредопределенныеВариантыОтчетаЭффективностьЗамерщиков(ТаблицаВариантов, ОписаниеОтчета, ОтчетТип);
		
	ИначеЕсли ОписаниеОтчета.Метаданные = Метаданные.Отчеты.ЭффективностьМенеджеров Тогда
		ОтчетыЭффективности.ДобавитьПредопределенныеВариантыОтчетаЭффективностьМенеджеров(ТаблицаВариантов, ОписаниеОтчета, ОтчетТип);
		
	ИначеЕсли ОписаниеОтчета.Метаданные = Метаданные.Отчеты.ЭффективностьМаркетинга 
		ИЛИ ОписаниеОтчета.Метаданные = Метаданные.Отчеты.ЭффективностьВидовКонтакта
		ИЛИ ОписаниеОтчета.Метаданные = Метаданные.Отчеты.ЭффективностьРекламныхАкций
		ИЛИ ОписаниеОтчета.Метаданные = Метаданные.Отчеты.ЭффективностьРекламныхИсточников
		ИЛИ ОписаниеОтчета.Метаданные = Метаданные.Отчеты.ЭффективностьТочекПродаж		
		Тогда
		ОтчетыЭффективности.ДобавитьПредопределенныеВариантыОтчетаЭффективностьПоЛидам(ТаблицаВариантов, ОписаниеОтчета, ОтчетТип);
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область НастройкаОтчетов

Процедура НастроитьОтображениеГруппировкиПодразделение(Настройки) Экспорт
	
	Если НЕ ПолучитьФункциональнуюОпцию("ИспользоватьПодразделения") Тогда
	
		КоллекцияГрупп = Настройки.Структура;
		ОтключитьГруппировкуОтчета(КоллекцияГрупп, "Подразделение");
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ОтключитьГруппировкуОтчета(КоллекцияГрупп, ИмяГруппировки)
	
	Отключена = СостояниеЭлементаНастройкиКомпоновкиДанных.Отключен;
	
	Для каждого ТекущаяГруппировка из КоллекцияГрупп Цикл
		
		Если ТипЗнч(ТекущаяГруппировка) = Тип("ГруппировкаКомпоновкиДанных")
			ИЛИ ТипЗнч(ТекущаяГруппировка) = Тип("ГруппировкаТаблицыКомпоновкиДанных") Тогда
			
			ЕстьГруппировка = ЕстьГруппировкаВПоляхГруппировки(ТекущаяГруппировка.ПоляГруппировки, ИмяГруппировки);
			
			Если ЕстьГруппировка Тогда
				ТекущаяГруппировка.Состояние = Отключена;
			Иначе
				// идем по дереву
				КоллекцияГрупп = ТекущаяГруппировка.Структура;
				ОтключитьГруппировкуОтчета(КоллекцияГрупп, ИмяГруппировки);
			КонецЕсли;
			
			
		ИначеЕсли ТипЗнч(ТекущаяГруппировка) = Тип("ТаблицаКомпоновкиДанных") Тогда
			
			КоллекцияГрупп = ТекущаяГруппировка.Строки;
			ОтключитьГруппировкуОтчета(КоллекцияГрупп, ИмяГруппировки);
			
		КонецЕсли;
	КонецЦикла;
		
КонецПроцедуры

Функция ЕстьГруппировкаВПоляхГруппировки(ПоляГруппировки, ИмяГруппировки)
	
	ЕстьГруппировка = Ложь;
	
	Для каждого ПолеКомпоновки из ПоляГруппировки.Элементы Цикл
		Если ПолеКомпоновки.Поле = Новый ПолеКомпоновкиДанных(ИмяГруппировки) Тогда
			ЕстьГруппировка = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Возврат ЕстьГруппировка;
	
КонецФункции
				
#КонецОбласти



