Функция НайтиСсылкуНаОбъектПоГуид(УзелИБ, СтроковыйГУИД) Экспорт
	
	Если ПустаяСтрока(СтроковыйГУИД) тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ДанныеРегистра.УникальныйИдентификаторИсточника КАК Ссылка
	|ИЗ
	|	РегистрСведений.СоответствияОбъектовИнформационныхБаз КАК ДанныеРегистра
	|ГДЕ
	|	ДанныеРегистра.УникальныйИдентификаторПриемника = &УИД
	|	И ДанныеРегистра.УзелИнформационнойБазы = &УзелИБ
	|";
		
	Запрос.УстановитьПараметр("УИД", СтроковыйГУИД);
	Запрос.УстановитьПараметр("УзелИБ", УзелИБ);
	
	Выборка = Запрос.Выполнить().Выбрать();	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	Иначе
	    Возврат Неопределено;
	КонецЕсли;
	
КонецФункции	

Процедура ЗаписатьСоответствиеОбъектов(УзелИБ, СсылкаНаОбъект, СтроковыйГУИД, ТипПриемника="") Экспорт
	
	Попытка
		МенеджерЗаписей = Новый Структура;
		МенеджерЗаписей.Вставить("УзелИнформационнойБазы", УзелИБ);
		МенеджерЗаписей.Вставить("УникальныйИдентификаторПриемника", СтроковыйГУИД);
		МенеджерЗаписей.Вставить("УникальныйИдентификаторИсточника", СсылкаНаОбъект);
		МенеджерЗаписей.Вставить("ТипПриемника", ТипПриемника);
		МенеджерЗаписей.Вставить("ТипИсточника", Строка(ТипЗнч(СсылкаНаОбъект)));
		РегистрыСведений.СоответствияОбъектовИнформационныхБаз.ДобавитьЗапись(МенеджерЗаписей, Истина);
	Исключение
		Сообщить("Не удалось записать в регистр соответсвия: " + ОписаниеОшибки());
	КонецПопытки;
	
КонецПроцедуры

Функция ПолучитьСтавкуНДСУИБ(ВнешнееСоединение, COMСтавкаНДС) Экспорт
	
	Если COMСтавкаНДС.Пустая() Тогда
		Возврат	Перечисления.СтавкиНДС.ПустаяСсылка();
	КонецЕсли;
	
	НДСНомер = ВнешнееСоединение.Перечисления.СтавкиНДС.Индекс(COMСтавкаНДС);
	НДСИмя = ВнешнееСоединение.Метаданные().Перечисления.СтавкиНДС.EnumValues.Get(НДСНомер).Name;	
	Возврат Перечисления.СтавкиНДС[НДСИмя];
	
КонецФункции

Функция ПолучитьНоменклатуруУИБ(ВнешнееСоединение, комНоменклатура, Знач ГруппаНовойНоменклатуры = Неопределено, ТекстОшибки) Экспорт
	
	Если комНоменклатура.Пустая() Тогда
		Возврат	Справочники.Номенклатура.ПустаяСсылка();
	КонецЕсли;
	
	СсылкаНаОбъект = Справочники.Номенклатура.НайтиПоНаименованию(комНоменклатура.Наименование, Истина);
	Если ЗначениеЗаполнено(СсылкаНаОбъект) Тогда
		Возврат СсылкаНаОбъект;
	КонецЕсли;
	Если ГруппаНовойНоменклатуры = Неопределено Тогда
		ГруппаНовойНоменклатуры = Справочники.Номенклатура.ПустаяСсылка();	
	КонецЕсли;
	
	НовыйОбъектСсылка = Справочники.Номенклатура.ПолучитьСсылку(Новый УникальныйИдентификатор);
	НовыйОбъект = Справочники.Номенклатура.СоздатьЭлемент();
	НовыйОбъект.УстановитьСсылкуНового(НовыйОбъектСсылка);
	НовыйОбъект.Родитель = ГруппаНовойНоменклатуры;	
	НовыйОбъект.Наименование = комНоменклатура.Наименование;	
	НовыйОбъект.ПометкаУдаления = комНоменклатура.ПометкаУдаления;
 	
	ЗаполнитьЗначенияСвойств(НовыйОбъект, комНоменклатура, , 
				"Code, Owner, Parent,
				|АльтернативнаяЕдиницаИзмерения, БазоваяЕдиницаИзмерения, ВидНоменклатуры, ВидПроизводственнойУслуги,
				|Категория, ОсновнаяСпецификация, СтатьяДоходов, СтатьяРасходов, УДАЛИТЬ_Фактура, УДАЛИТЬ_ЦветФактуры,
				|ФайлКартинки, Шаблон, Потолок_Фактура, ДополнительныеРеквизиты");
	
	ВидНоменклатуры = ВнешнееСоединение.String(комНоменклатура.ВидНоменклатуры);
	НовыйОбъект.ВидНоменклатуры = Справочники.ВидыНоменклатуры.НайтиПоНаименованию(ВидНоменклатуры);
	
	Ед = ВнешнееСоединение.String(комНоменклатура.БазоваяЕдиницаИзмерения);
	НовыйОбъект.БазоваяЕдиницаИзмерения = Справочники.КлассификаторЕдиницИзмерения.НайтиПоНаименованию(Ед);
	
	Если НЕ комНоменклатура.АльтернативнаяЕдиницаИзмерения.Пустая() Тогда
		НоваяЕИОбъект = Справочники.ЕдиницыИзмерений.СоздатьЭлемент();
		НоваяЕИОбъект.УстановитьНовыйКод();
		НоваяЕИОбъект.Владелец = НовыйОбъектСсылка;
		НоваяЕИОбъект.Наименование = комНоменклатура.АльтернативнаяЕдиницаИзмерения.Наименование;
		НоваяЕИОбъект.Коэффициент = комНоменклатура.АльтернативнаяЕдиницаИзмерения.Коэффициент;
		НоваяЕИОбъект.Вес = комНоменклатура.АльтернативнаяЕдиницаИзмерения.Вес;
		Попытка
			НоваяЕИОбъект.ОбменДанными.Загрузка = Истина;
			НоваяЕИОбъект.Записать();
			НовыйОбъект.АльтернативнаяЕдиницаИзмерения = НоваяЕИОбъект.Ссылка;
		Исключение
			
		КонецПопытки;
	КонецЕсли;
	
	НовыйОбъект.Потолок_Фактура.Очистить();
	Для каждого комСтрокаТЧ из комНоменклатура.Потолок_Фактура Цикл
		НоваяСтрока = НовыйОбъект.Потолок_Фактура.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, комСтрокаТЧ, 
			"ПродукцияКоличество, Основная, Фактура_МатериалЦвет, Фактура_МатериалМатериал, 
			|Фактура_МатериалКаталог, Фактура_КоличествоРасход, Фактура_КоличествоВыработка, Фактура_ШиринаПолотна");
		НоваяСтрока.ПродукцияФактура = ПолучитьФактуруУИБ(ВнешнееСоединение, комСтрокаТЧ.ПродукцияФактура);
	    НоваяСтрока.ПродукцияЦвет = ПолучитьЦветФактурыУИБ(ВнешнееСоединение, комСтрокаТЧ.ПродукцияЦвет, НоваяСтрока.ПродукцияФактура);
	КонецЦикла;
	
	Если НЕ комНоменклатура.ФайлКартинки.Пустая() И НовыйОбъект.ФайлКартинки.Пустая() Тогда		
		НовоеФотоОбъект = Справочники.НоменклатураПрисоединенныеФайлы.СоздатьЭлемент();
		НовоеФотоОбъект.ВладелецФайла = НовыйОбъектСсылка;
		НовоеФотоОбъект.Наименование = комНоменклатура.ФайлКартинки.Наименование;
		НовоеФотоОбъект.Расширение = комНоменклатура.ФайлКартинки.Расширение;
		НовоеФотоОбъект.ДатаСоздания = комНоменклатура.ФайлКартинки.ДатаСоздания;
		НовоеФотоОбъект.ФайлХранилище = Новый ХранилищеЗначения(Base64Значение(ВнешнееСоединение.Base64Строка(комНоменклатура.ФайлКартинки.ФайлХранилище.Получить())));

		Попытка
			НовоеФотоОбъект.ОбменДанными.Загрузка = Истина;
			НовоеФотоОбъект.Записать();
			НовыйОбъект.ФайлКартинки = НовоеФотоОбъект.Ссылка;
		Исключение
			
		КонецПопытки;
	КонецЕсли;
	
	Попытка
		НовыйОбъект.ОбменДанными.Загрузка = Истина;
		НовыйОбъект.Записать();
		Возврат НовыйОбъект.Ссылка;
	Исключение
		ТекстОшибки = ОписаниеОшибки();
		Возврат Справочники.Номенклатура.ПустаяСсылка();
	КонецПопытки;
	
КонецФункции

Функция ПолучитьХарактеристикуУИБ(ВнешнееСоединение, комХарактеристика, НоменклатураСсылка) Экспорт
	
	Если комХарактеристика.Пустая() Тогда
		Возврат	Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка();
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(НоменклатураСсылка) Тогда
		Возврат	Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка();
	КонецЕсли;	
	
	СсылкаНаОбъект = Справочники.ХарактеристикиНоменклатуры.НайтиПоНаименованию(комХарактеристика.Наименование, Истина, , НоменклатураСсылка);
	Если ЗначениеЗаполнено(СсылкаНаОбъект) ТОгда
		Возврат СсылкаНаОбъект;
	КонецЕсли;
	
	НовыйОбъект = Справочники.ХарактеристикиНоменклатуры.СоздатьЭлемент();
	НовыйОбъект.Владелец = НоменклатураСсылка;	
	НовыйОбъект.Наименование = комХарактеристика.Наименование;	
	
	Попытка
		НовыйОбъект.ОбменДанными.Загрузка = Истина;
		НовыйОбъект.Записать();
		Возврат НовыйОбъект.Ссылка;
	Исключение
		ТекстОшибки = ОписаниеОшибки();
		Возврат Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка();
	КонецПопытки;
	
КонецФункции

Функция ПолучитьЕдиницуИзмеренияУИБ(ВнешнееСоединение, комЕдиница, НоменклатураСсылка) Экспорт
	
	Если комЕдиница = Неопределено ИЛИ комЕдиница = NULL ИЛИ комЕдиница.Пустая() Тогда
		Возврат	Неопределено;
	КонецЕсли;
	
	Если комЕдиница.Метаданные().Имя = "ЕдиницыИзмерений" Тогда
		Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(НоменклатураСсылка, "АльтернативнаяЕдиницаИзмерения");
	Иначе //комЕдиница.Метаданные().Имя = "КлассификаторЕдиницИзмерения" Тогда
		Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(НоменклатураСсылка, "БазоваяЕдиницаИзмерения");
	КонецЕсли;

КонецФункции

Функция ПолучитьФактуруУИБ(ВнешнееСоединение, комФактура) Экспорт
	
	Если комФактура.Пустая() Тогда
		Возврат	Справочники.Фактура.ПустаяСсылка();
	КонецЕсли;
	
	СсылкаНаОбъект = Справочники.Фактура.НайтиПоНаименованию(комФактура.Наименование, Истина);
	Если ЗначениеЗаполнено(СсылкаНаОбъект) ТОгда
		Возврат СсылкаНаОбъект;
	КонецЕсли;
	
	НовыйОбъект = Справочники.Фактура.СоздатьЭлемент();
	ЗаполнитьЗначенияСвойств(НовыйОбъект, комФактура, 
		"Наименование, Гарантия, Каталог, Материал, 
		|МобильныйПостроитель_Группа, МобильныйПостроитель_Код, 
		|ПроцентРастяженияПоУ, ПроцентРастяженияПоХ, ШиринаПолотна");
		
	Попытка
		НовыйОбъект.ОбменДанными.Загрузка = Истина;
		НовыйОбъект.Записать();
		Возврат НовыйОбъект.Ссылка;
	Исключение
		ТекстОшибки = ОписаниеОшибки();
		Возврат Справочники.Фактура.ПустаяСсылка();
	КонецПопытки;
	
КонецФункции

Функция ПолучитьЦветФактурыУИБ(ВнешнееСоединение, комЦвет, ФактураСсылка) Экспорт
	
	Если комЦвет.Пустая() Тогда
		Возврат	Справочники.ЦветФактуры.ПустаяСсылка();
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(ФактураСсылка) Тогда
		Возврат	Справочники.ЦветФактуры.ПустаяСсылка();
	КонецЕсли;
	
	СсылкаНаОбъект = Справочники.ЦветФактуры.НайтиПоНаименованию(комЦвет.Наименование, Истина, , ФактураСсылка);
	Если ЗначениеЗаполнено(СсылкаНаОбъект) ТОгда
		Возврат СсылкаНаОбъект;
	КонецЕсли;
	
	НовыйОбъект = Справочники.ЦветФактуры.СоздатьЭлемент();
	НовыйОбъект.Владелец = ФактураСсылка;
	ЗаполнитьЗначенияСвойств(НовыйОбъект, комЦвет, "Наименование, МобильныйПостроитель_Код, МобильныйПостроитель_Фактура");
	
	ТекстОшибки = "";
	Если НЕ комЦвет.Номенклатура.Пустая() Тогда
		НовыйОбъект.Номенклатура = ПолучитьНоменклатуруУИБ(ВнешнееСоединение, комЦвет.Номенклатура, , ТекстОшибки);
	КонецЕсли;	
	
	Попытка
		НовыйОбъект.ОбменДанными.Загрузка = Истина;
		НовыйОбъект.Записать();
		Возврат НовыйОбъект.Ссылка;
	Исключение
		ТекстОшибки = ОписаниеОшибки();
		Возврат Справочники.ЦветФактуры.ПустаяСсылка();
	КонецПопытки;
	
КонецФункции

#КонецОбласти
