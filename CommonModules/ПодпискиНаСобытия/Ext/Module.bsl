Процедура УстановитьСоответствиеВидовЦенНенамУслугРаскроя(Источник, Отказ) Экспорт
	
	ИзмерениеВидЦенНастройкаИнтеркампани = Неопределено;
	Если Источник.ВидОперации = Перечисления.ВидыОперацийУстановкиЦенНаУслугиПроизводства.ПоВидуЦен Тогда
		ИзмерениеВидЦенНастройкаИнтеркампани = Источник.ВидЦен;
	ИначеЕсли Источник.ВидОперации = Перечисления.ВидыОперацийУстановкиЦенНаУслугиПроизводства.ПоИнтеркампани Тогда
		ИзмерениеВидЦенНастройкаИнтеркампани = Источник.НастройкаИнтеркампани;	
	КонецЕсли;
	
	//Предварительно очистим все записи по ссылке
	НаборЗаписей = РегистрыСведений.СоответствиеВидовЦенЦенамУслугРаскроя.СоздатьНаборЗаписей();
	//НаборЗаписей.Отбор.Период.Установить(Источник.Дата);  // могли изменить дату
	НаборЗаписей.Прочитать();
	
	КоличествоЗаписей = НаборЗаписей.Количество();
	Для Сч = 1 По КоличествоЗаписей Цикл
		Если НаборЗаписей[КоличествоЗаписей-Сч].ЦеныУслугРаскроя = Источник.Ссылка Тогда
			НаборЗаписей.Удалить(КоличествоЗаписей-Сч);
		КонецЕсли;
	КонецЦикла;
	НаборЗаписей.Записать(Истина);
	
	Если НЕ Источник.ПометкаУдаления Тогда		
		//Теперь сделаем новую запись
		НоваяЗапись = РегистрыСведений.СоответствиеВидовЦенЦенамУслугРаскроя.СоздатьМенеджерЗаписи();
		
		НоваяЗапись.Период = Источник.Дата;
		НоваяЗапись.Валюта = Источник.Валюта;
		НоваяЗапись.ВидНоменклатуры = Источник.ВидНоменклатуры;
		НоваяЗапись.ВидОперации = Источник.ВидОперации;
		НоваяЗапись.ВидЦен = ИзмерениеВидЦенНастройкаИнтеркампани;
		НоваяЗапись.ЦеныУслугРаскроя = Источник.Ссылка;
		
		НоваяЗапись.Записать();
	КонецЕсли;
	
КонецПроцедуры

Процедура ОтменаПроведенияЗаказа(Источник, Отказ) Экспорт
	
	//проверим сколько отгружено по заказу. Если отгружено больше чем заказано в заказе - отказываем в проведении (защита от удаления товаров из заказа после его отгрузки)
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЗаказыПокупателейОбороты.Номенклатура,
	|	ЗаказыПокупателейОбороты.КоличествоРасход КАК Отгружено
	|ИЗ
	|	РегистрНакопления.ЗаказыПокупателей.Обороты(, , , ЗаказНаПроизводство = &ЗаказНаПроизводство) КАК ЗаказыПокупателейОбороты";
	Запрос.УстановитьПараметр("ЗаказНаПроизводство", Источник.Ссылка);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Сообщить("По данному заказу уже отгружено " + Выборка.Отгружено + " ед. номенклатуры """ + Выборка.Номенклатура + """");
		Отказ = Истина;
	КонецЦикла;
	Если Отказ Тогда
		Сообщить("Отмена проведения не выполнена");
	КонецЕсли;
	
КонецПроцедуры

