Процедура nva_ПередПроведениемДокСписанияОбработкаПроведения(Источник, Отказ, РежимПроведения) Экспорт
	
	Если Источник.ОбменДанными.Загрузка = Истина Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Источник.Ссылка) И ТипЗнч(Источник.Ссылка) = Тип("ДокументСсылка.СписаниеТоваров") Тогда
		Если НЕ ЗначениеЗаполнено(Источник.Комментарий) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Поле ""Комментарий"" обязательно должно быть заполненно!", , , , Отказ);
		КонецЕсли;
	ИначеЕсли ЗначениеЗаполнено(Источник.Ссылка) И ТипЗнч(Источник.Ссылка) = Тип("ДокументСсылка.ЗаказПоставщику") Тогда
		Если НЕ ЗначениеЗаполнено(Источник.СрокПоставки) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Поле ""Срок  поставки"" обязательно должно быть заполненно!", , , , Отказ);
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(Источник.СрокОплаты) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Поле ""Срок  оплаты"" обязательно должно быть заполненно!", , , , Отказ);
		КонецЕсли;
	ИначеЕсли ЗначениеЗаполнено(Источник.Ссылка) И ТипЗнч(Источник.Ссылка) = Тип("ДокументСсылка.ЗаказПокупателя") Тогда
		Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Источник, "ОжидаемаяДатаОтгрузки") Тогда
			Если НЕ ЗначениеЗаполнено(Источник.ОжидаемаяДатаОтгрузки) Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Поле ""Дата огрузки с"" обязательно должно быть заполненно!", , , , Отказ);
			КонецЕсли;	
		КонецЕсли;	
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Источник.Ссылка) Тогда
		Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Источник, "Основание") Тогда
			Если ЗначениеЗаполнено(Источник.Основание) И ТипЗнч(Источник.Основание) = Тип("ДокументСсылка.ЗаказПоставщику") 
				И Источник.Основание.ТекущийСтатус = Справочники.СтатусыЗаказовПоставщику.Отменен Тогда 
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Проведение документов на основании ""Заказа поставщику"" со статусом ""Отменен"" запрещено", , , , Отказ);
			КонецЕсли;	
		КонецЕсли;	
	КонецЕсли;	
	
КонецПроцедуры

Процедура дкПередЗаписью(Источник, Отказ, РежимЗаписи=ложь, РежимПроведения=ложь) Экспорт
	
	Если Не Отказ Тогда
						
		дкНабор = РегистрыСведений.Лен_ЖурналИзменений.СоздатьНаборЗаписей();
		дкНабор.ЗаписатьВЖурналИзменений(Источник);
		
	КонецЕсли;
	
КонецПроцедуры
