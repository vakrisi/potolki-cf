// Проверяет настройки контроля документа по журналу правок задним числом
//
Функция ЗаписыватьДокументВЖурналПравокЗаднимЧислом(Знач Источник)
	
	// Проверяем, что подсистема включена
	Если НЕ ПолучитьФункциональнуюОпцию("ВестиЖурналПравокЗаднимЧислом") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ТипДокумента = ОбщегоНазначения.ИдентификаторОбъектаМетаданных(Источник.Метаданные());
	КонтролироватьДокумент = ПолучитьФункциональнуюОпцию("ЗаписыватьОбъектВЖурналПравокЗаднимЧислом", Новый Структура("ТипДокументаЖурналаПравок", ТипДокумента));
	
	Если КонтролироватьДокумент Тогда
		РазницаВДнях = (НачалоДня(ТекущаяДатаСеанса()) - НачалоДня(Источник.Дата)) / (60 * 60 * 24);
		//Если РазницаВДнях = 0 ИЛИ РазницаВДнях > ПолучитьФункциональнуюОпцию("КоличествоДнейКонтроляПравокЗаднимЧислом") Тогда
		Если РазницаВДнях <= ПолучитьФункциональнуюОпцию("КоличествоДнейКонтроляПравокЗаднимЧислом") Тогда
			КонтролироватьДокумент = Ложь;
		КонецЕсли;
	КонецЕсли;
	
	Возврат КонтролироватьДокумент;
	
КонецФункции

Процедура ПередЗаписьюДокументПередЗаписью(Источник, Отказ, РежимЗаписи, РежимПроведения) Экспорт
	
	//#9528	
	ТекущийПользователь = Пользователи.ТекущийПользователь();
	
	РеквизитыПользователя = ОбщийМодульСервер.НастройкиПользователя("ДополнительныеПраваЗапретРедактированияПроведенныхДокументовДругихПользователей,
	                                                                |ДополнительныеПраваЗапретРедактированияПроведенныхДокументовПоТипам,
																	|ДополнительныеПраваЗапретПометкиНаУдалениеДокументовПоТипам", ТекущийПользователь);
	
	Если ТекущийПользователь.ДополнительныеПраваЗапретРедактированияПроведенныхДокументовДругихПользователей 
		И Источник.Проведен 		
		И ОбщегоНазначения.ЕстьРеквизитОбъекта("Автор", Источник.Метаданные()) Тогда
		Если НЕ Источник.Автор = ТекущийПользователь Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Запрещено редактирование проведенных документов других пользователей", , , , Отказ);
		КонецЕсли;
	КонецЕсли;
	
	//#11190
	Если ЗначениеЗаполнено(Источник.Ссылка) 
		И Источник.Ссылка.Проведен 
		И РеквизитыПользователя.ДополнительныеПраваЗапретРедактированияПроведенныхДокументовПоТипам
		Тогда
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("ТекущийПользователь", ТекущийПользователь);
		Запрос.УстановитьПараметр("ТипДокумента", Источник.Метаданные().Имя);
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДанныеСправочника.ТипДокумента КАК ТипДокумента
		|ИЗ
		|	Справочник.Пользователи.ЗапрещенныеПослеПроведенияДокументы КАК ДанныеСправочника
		|ГДЕ
		|	ДанныеСправочника.Ссылка = &ТекущийПользователь
		|	И ДанныеСправочника.Ссылка.ДополнительныеПраваЗапретРедактированияПроведенныхДокументовПоТипам
		|	И ДанныеСправочника.ТипДокумента = &ТипДокумента";
		
		РезультатЗапроса = Запрос.Выполнить();
		Если НЕ РезультатЗапроса.Пустой() Тогда			
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Настройками пользователя запрещено редактирование проведенных документов!", , , , Отказ);
		КонецЕсли;
	КонецЕсли;
	
	//#15997
	Если ЗначениеЗаполнено(Источник.Ссылка) 
		И НЕ Источник.Ссылка.ПометкаУдаления = Источник.ПометкаУдаления
		И РеквизитыПользователя.ДополнительныеПраваЗапретПометкиНаУдалениеДокументовПоТипам
		Тогда
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("ТекущийПользователь", ТекущийПользователь);
		Запрос.УстановитьПараметр("ТипДокумента", Источник.Метаданные().Имя);
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДанныеСправочника.ТипДокумента КАК ТипДокумента
		|ИЗ
		|	Справочник.Пользователи.ЗапрещенныеКПометкеУдаленияТипыДокументов КАК ДанныеСправочника
		|ГДЕ
		|	ДанныеСправочника.Ссылка = &ТекущийПользователь
		|	И ДанныеСправочника.ТипДокумента = &ТипДокумента";
		
		РезультатЗапроса = Запрос.Выполнить();
		Если НЕ РезультатЗапроса.Пустой() Тогда			
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Настройками пользователя запрещено изменение пометки удаления документов данного типа!", , , , Отказ);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

