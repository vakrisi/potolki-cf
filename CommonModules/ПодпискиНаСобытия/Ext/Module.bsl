Процедура ПередЗаписьюПользователиПередЗаписью(Источник, Отказ) Экспорт
	
	Если (Источник.ПометкаУдаления И НЕ Источник.Ссылка.ПометкаУдаления)
		ИЛИ (НЕ Источник.ПометкаУдаления И Источник.Ссылка.ПометкаУдаления) Тогда
		
		Если (Источник.Наименование = "Администратор"
			ИЛИ Источник.Наименование = "Служба поддержки SmartCeilings"
			//ИЛИ Источник.Наименование = "УстановкаОбновлений" // #7604 закомментировано
			)
			//И НЕ Строка(ПараметрыСеанса.ТекущийПользователь) = "Администратор"
			И НЕ Строка(Пользователи.ТекущийПользователь()) = "Служба поддержки SmartCeilings" Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Нарушение прав доступа");
			Отказ = Истина;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Процедура ПередЗаписьюЖурналПравокЗаднимЧисломПередЗаписью(Источник, Отказ, РежимЗаписи, РежимПроведения) Экспорт
	
	Если ОбщегоНазначения.ЗначениеСсылочногоТипа(Источник) Тогда
		Источник = Источник.ПолучитьОбъект();
	КонецЕсли;
	
	Если Источник.ЭтоНовый() Тогда
		Возврат;
	КонецЕсли;
		
	Если Источник = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Источник.ОбменДанными.Загрузка
	   И Источник.ДополнительныеСвойства.Свойство("ПропуститьЗаписьВЖурналПравокЗаднимЧислом")
	   Тогда
		Возврат;
	КонецЕсли;
	
	Если СтандартныеПодсистемыСервер.ЭтоИдентификаторОбъектаМетаданных(Источник) Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ ЗаписыватьДокументВЖурналПравокЗаднимЧислом(Источник) Тогда
		Возврат;
	КонецЕсли;
	
	ЕстьИзменения = Ложь;
	
	НачальноеСостояниеПроведен = Источник.Ссылка.Проведен;
	КонечноеСостояниеПроведен  = ?(РежимЗаписи = РежимЗаписиДокумента.Проведение, Истина, Ложь); 
	
	НачальноеСостояниеПометкаУдаления = Источник.Ссылка.ПометкаУдаления;
	КонечноеСостояниеПометкаУдаления  = Источник.ПометкаУдаления;
	
	НачальнаяСумма = 0 ;
	КонечнаяСумма  = 0;
	Если ОбщегоНазначения.ЕстьРеквизитОбъекта("СуммаДокумента", Источник.Метаданные()) тогда
		НачальнаяСумма = Источник.Ссылка.СуммаДокумента;
		КонечнаяСумма  = Источник.СуммаДокумента; 		
	ИначеЕсли ОбщегоНазначения.ЕстьРеквизитОбъекта("Сумма", Источник.Метаданные()) Тогда
		НачальнаяСумма = Источник.Ссылка.Сумма;
		КонечнаяСумма  = Источник.Сумма;		
	КонецЕсли;
	
	Если НачальноеСостояниеПроведен <> КонечноеСостояниеПроведен
		ИЛИ НачальноеСостояниеПометкаУдаления <> КонечноеСостояниеПометкаУдаления
