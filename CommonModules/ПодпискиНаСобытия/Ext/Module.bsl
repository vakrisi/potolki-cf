		МенеджерЗаписи = РегистрыСведений.ЖурналПравокЗаднимЧислом.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.Период = ТекущаяДатаСеанса();
		МенеджерЗаписи.Пользователь = Пользователи.ТекущийПользователь();
		МенеджерЗаписи.Документ = Источник.Ссылка;
