
Функция ПолучитьЦенуНоменклатуры(Знач Номенклатура, Знач ХарактеристикаНоменклатуры, Знач ЕдиницаИзмерения, Знач Количество,
			     	  Знач Дата, Знач ВидЦены, Знач Валюта,
					  Знач Организация = Неопределено, Знач Подразделение = Неопределено,
					  Знач Контрагент = Неопределено, Знач ДоговорКонтрагента = Неопределено) Экспорт

	Цена = 0;
	ПараметрыПродукции = Новый Структура;
	
	Если Справочники.ВидыНоменклатуры.ЭтоНоменклатураПотолкаИлиОтреза(Номенклатура) Тогда
		
		РеквизитыНоменклатуры = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Номенклатура, "ВидНоменклатуры, Потолок_ПлощадьФотопечати");
		ФактураПотолка = Справочники.Номенклатура.ПолучитьОсновнуюФактуруИЦветПотолка(Номенклатура);
		
		ПараметрыПродукции.Вставить("ВидНоменклатуры", РеквизитыНоменклатуры.ВидНоменклатуры);
		ПараметрыПродукции.Вставить("СФотопечатью", НЕ (РеквизитыНоменклатуры.Потолок_ПлощадьФотопечати = 0));
		ПараметрыПродукции.Вставить("Фактура", ФактураПотолка.ПродукцияФактура);
		ПараметрыПродукции.Вставить("ЦветФактур", ФактураПотолка.ПродукцияЦвет);
		Цена = ПолучитьЦенуПродукции(ПараметрыПродукции, Дата, ВидЦены, Валюта, Контрагент, ДоговорКонтрагента);
		
	ИначеЕсли Справочники.ВидыНоменклатуры.ЭтоНоменклатураПродукция(Номенклатура) Тогда
		
		РеквизитыНоменклатуры = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Номенклатура, "ВидНоменклатуры, ВидПродукции.СпособОпределенияСтоимости, Шаблон");
		ПараметрыПродукции.Вставить("ВидНоменклатуры", РеквизитыНоменклатуры.ВидНоменклатуры);
		
		Если РеквизитыНоменклатуры.ВидПродукцииСпособОпределенияСтоимости = Перечисления.СпособыОпределенияСтоимостиПродукции.ПоШаблону Тогда
			ШаблонПродукции = РеквизитыНоменклатуры.Шаблон;			
			ПараметрыПродукции.Вставить("Шаблон", ШаблонПродукции);
			Цена = ПолучитьЦенуПродукции(ПараметрыПродукции, Дата, ВидЦены, Валюта, Контрагент, ДоговорКонтрагента);
			
			ДанныеМинимальнойСтоимости = РегистрыСведений.МинимальнаяСтоимостьПродукции.ПолучитьМинимальнуюСтоимость(Дата, ВидЦены, Валюта, Организация, Подразделение, ШаблонПродукции, , РеквизитыНоменклатуры.ВидНоменклатуры);
			Если ДанныеМинимальнойСтоимости.Стоимость > 0 И Количество > 0
				И Цена * Количество < ДанныеМинимальнойСтоимости.Стоимость Тогда
				Цена = ДанныеМинимальнойСтоимости.Стоимость / Количество;
			КонецЕсли;
			
		ИначеЕсли РеквизитыНоменклатуры.ВидПродукцииСпособОпределенияСтоимости = Перечисления.СпособыОпределенияСтоимостиПродукции.ПоПараметрам Тогда
			// #16971
			Цена = РегистрыСведений.ЦеныПараметровПродукции.ПолучитьЦену(Номенклатура, Дата, ВидЦены, Валюта, Контрагент, ДоговорКонтрагента);
			
		ИначеЕсли РеквизитыНоменклатуры.ВидПродукцииСпособОпределенияСтоимости = Перечисления.СпособыОпределенияСтоимостиПродукции.ПоНоменклатуре Тогда
			// #16971
			ПараметрыПродукции.Вставить("Номенклатура", Номенклатура);
			ПараметрыПродукции.Вставить("ЕдиницаИзмерения", ЕдиницаИзмерения);
			Цена = ПолучитьЦенуПродукции(ПараметрыПродукции, Дата, ВидЦены, Валюта, Контрагент, ДоговорКонтрагента);

		КонецЕсли;
	Иначе
		Если ЕдиницаИзмерения = Неопределено Тогда
			ЕдиницаИзмерения = ОбщийМодульВызовСервера.ПолучитьБазовуюЕдиницуИзмеренияНоменклатуры(Номенклатура);
		КонецЕсли;
		Цена = РегистрыСведений.ЦеныНоменклатуры.ПолучитьЦенуНоменклатуры(Номенклатура, ХарактеристикаНоменклатуры, ЕдиницаИзмерения, 
																		   Дата, ВидЦены, Валюта, Контрагент, ДоговорКонтрагента);
	КонецЕсли;
	
	Возврат Цена;
	
КонецФункции

#Область ЦеныПродукции

Функция ПолучитьЦенуПродукцииВВалюте(ПараметрыПродукции, Знач ДатаЦены, Знач ВидЦены, Знач Валюта,
									Знач Контрагент = Неопределено, Знач ДоговорКонтрагента = Неопределено) Экспорт
									
	// ПараметрыПродукции: СФотопечатью = Ложь, Знач ДатаЦены, Знач ВидЦены, Знач ФактураШаблон, Знач ЦветФактуры = Неопределено, Знач Валюта, Знач ВидНоменклатуры = Неопределено								
	СФотопечатью = Ложь;
	Если ПараметрыПродукции.Свойство("СФотопечатью") Тогда
		СФотопечатью = ПараметрыПродукции.СФотопечатью;	
	КонецЕсли;
	ВидНоменклатуры = Неопределено;
	Если ПараметрыПродукции.Свойство("ВидНоменклатуры") Тогда
		ВидНоменклатуры = ПараметрыПродукции.ВидНоменклатуры;	
	КонецЕсли;
	Если ВидНоменклатуры = Неопределено Тогда
		ВидНоменклатуры = Справочники.ВидыНоменклатуры.Потолок;
	КонецЕсли;
	Фактура = Неопределено;
	Если ПараметрыПродукции.Свойство("Фактура") Тогда
		Фактура = ПараметрыПродукции.Фактура;	
	КонецЕсли;
	ЦветФактуры = Неопределено;
	Если ПараметрыПродукции.Свойство("ЦветФактуры") Тогда
		ЦветФактуры = ПараметрыПродукции.ЦветФактуры;	
	КонецЕсли;
	Шаблон = Неопределено;
	Если ПараметрыПродукции.Свойство("Шаблон") Тогда
		Шаблон = ПараметрыПродукции.Шаблон;	
	КонецЕсли;
	Номенклатура = Неопределено;
	Если ПараметрыПродукции.Свойство("Номенклатура") Тогда
		Номенклатура = ПараметрыПродукции.Номенклатура;	
	КонецЕсли;
	ЕдиницаИзмерения = Неопределено;
	Если ПараметрыПродукции.Свойство("ЕдиницаИзмерения") Тогда
		ЕдиницаИзмерения = ПараметрыПродукции.ЕдиницаИзмерения;	
	КонецЕсли;
	
	Результат = 0;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВЫБОР
	|		КОГДА НЕ &СФотопечатью
	|			ТОГДА ЦеныМатериаловСрезПоследних.Цена
	|		ИНАЧЕ ЦеныМатериаловСрезПоследних.ЦенаСФотопечатью
	|	КОНЕЦ КАК Цена
	|ИЗ
	|	РегистрСведений.ЦеныМатериалов.СрезПоследних(
	|			&ДатаЦены,
	//++#7256
	|			ВЫБОР
	|					КОГДА ВЫРАЗИТЬ(&ВидЦены КАК Справочник.ВидыЦен).СсылочныйВидЦены = ИСТИНА
	|						ТОГДА ВидЦен = ВЫРАЗИТЬ(&ВидЦены КАК Справочник.ВидыЦен).ВидЦеныНаПродукцию
	|					ИНАЧЕ ВидЦен = &ВидЦены
	|				КОНЕЦ
	//|			ВидЦен = &ВидЦены
	//--#7256
	|				И Валюта = &Валюта
	|				И ВидНоменклатуры = &ВидНоменклатуры
	|				И ВЫБОР 
	|					КОГДА &ОтборПоШаблону ТОГДА Шаблон = &Шаблон 
	|					КОГДА &ОтборПоНоменклатуре ТОГДА Номенклатура = &Номенклатура И ЕдиницаИзмерения = &ЕдиницаИзмерения 
	|				  	ИНАЧЕ Фактура = &Фактура И ЦветФактуры = &ЦветФактуры
	|                 КОНЕЦ
	|	) КАК ЦеныМатериаловСрезПоследних";
	
	Запрос.УстановитьПараметр("ДатаЦены",			КонецДня(ДатаЦены));
	Запрос.УстановитьПараметр("ВидЦены",			ВидЦены);
	Запрос.УстановитьПараметр("Валюта",				Валюта);
	Запрос.УстановитьПараметр("ВидНоменклатуры",	ВидНоменклатуры);
	
	Запрос.УстановитьПараметр("Фактура",			Фактура);
	Запрос.УстановитьПараметр("ЦветФактуры",		ЦветФактуры);
	Запрос.УстановитьПараметр("СФотопечатью",		СФотопечатью);
	
	Запрос.УстановитьПараметр("ОтборПоШаблону",		НЕ Шаблон = Неопределено);
	Запрос.УстановитьПараметр("Шаблон",				Шаблон);
	
	Запрос.УстановитьПараметр("ОтборПоНоменклатуре",НЕ Номенклатура = Неопределено);
	Запрос.УстановитьПараметр("Номенклатура",		Номенклатура);
	Запрос.УстановитьПараметр("ЕдиницаИзмерения",	ЕдиницаИзмерения);
	
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Результат = Выборка.Цена;
	КонецЕсли;
	
	//#7256
	Если НЕ Контрагент = Неопределено ИЛИ ДоговорКонтрагента = Неопределено Тогда
		Если Контрагент = Неопределено Тогда
			Контрагент = Справочники.Контрагенты.ПустаяСсылка();
		КонецЕсли;
		Если ДоговорКонтрагента = Неопределено Тогда
			ДоговорКонтрагента = Справочники.ДоговорыКонтрагентов.ПустаяСсылка();
		КонецЕсли;
		Результат = ПолучитьИндивидуальнуюЦенуПродукции(Результат, ВидНоменклатуры, Фактура, ЦветФактуры, СФотопечатью, Шаблон, Номенклатура, ЕдиницаИзмерения,
														ДатаЦены, Валюта, Контрагент, ДоговорКонтрагента);
	КонецЕсли;
													
	Возврат Результат;
	
КонецФункции

Функция ПолучитьЦенуПродукцииВВалютеУчета(ПараметрыПродукции, Знач ДатаЦены, Знач ВидЦены,
	                                      Знач Контрагент = Неопределено, Знач ДоговорКонтрагента = Неопределено) Экспорт
										  
	Валюта = ПолучитьФункциональнуюОпцию("ВалютаУчета");									  
	Возврат ПолучитьЦенуПродукцииВВалюте(ПараметрыПродукции, ДатаЦены, ВидЦены, Валюта, 
									     Контрагент, ДоговорКонтрагента);
	
КонецФункции

Функция ПолучитьЦенуПродукции(ПараметрыПродукции, ДатаЦены, ВидЦены, ВалютаДокумента,
	                          Знач Контрагент = Неопределено, Знач ДоговорКонтрагента = Неопределено) Экспорт
							  
	Результат = 0;
	ЦенаНоменклатуры = ПолучитьЦенуПродукцииВВалюте(ПараметрыПродукции, КонецДня(ДатаЦены), ВидЦены, ВалютаДокумента, Контрагент, ДоговорКонтрагента);
	
	Если НЕ ЦенаНоменклатуры = 0 Тогда
		Возврат ЦенаНоменклатуры;
	КонецЕсли;
		
	ВалютаУчета = Константы.ВалютаУчета.Получить();
	ОсновнаяВалютаПересчетаЦены = Константы.ОсновнаяВалютаПересчетаЦены.Получить();
	
	//++ №12971 по новому
	// 1. Если не нашли цену по валюте документа и задана валюта пересчета, ищем прайс в валюте пересчета
	//	(если нашли, то ставим цену в валюте документа по курсу к валюте пересчета)
	Если ЗначениеЗаполнено(ОсновнаяВалютаПересчетаЦены) Тогда
		
		ЦенаНоменклатуры = ПолучитьЦенуПродукцииВВалюте(ПараметрыПродукции, КонецДня(ДатаЦены), ВидЦены, ОсновнаяВалютаПересчетаЦены, Контрагент, ДоговорКонтрагента);
		
		Если НЕ ЦенаНоменклатуры = 0 Тогда
			
			ДатаКурса = ДатаЦены;
			
			Если ДатаКурса = Дата(1,1,1) Тогда
				ДатаКурса = ТекущаяДатаСеанса();
			КонецЕсли;
			
			Возврат РаботаСВалютой.ПересчитатьИзВалютыВВалюту(ОсновнаяВалютаПересчетаЦены, ВалютаДокумента, ДатаКурса, ЦенаНоменклатуры);
			
		КонецЕсли;
		
	КонецЕсли;
	
	// 2. Если не нашли цену по валюте пересчета, то ищем прайс в валюте учета (если валюта документа отличается от валюты учёта)
	//	(если нашли, то ставим цену в валюте документа по курсу к валюте учета)
	Если НЕ ВалютаДокумента = ВалютаУчета Тогда
		
		ЦенаНоменклатуры = ПолучитьЦенуПродукцииВВалютеУчета(ПараметрыПродукции, КонецДня(ДатаЦены), ВидЦены, Контрагент, ДоговорКонтрагента);
		
		Если НЕ ЦенаНоменклатуры = 0 Тогда
			
			ДатаКурса = ДатаЦены;
			
			Если ДатаКурса = Дата(1,1,1) Тогда
				ДатаКурса = ТекущаяДатаСеанса();
			КонецЕсли;
			
			Возврат РаботаСВалютой.ПересчитатьИзВалютыВВалюту(ВалютаУчета, ВалютаДокумента, ДатаКурса, ЦенаНоменклатуры);
			
		КонецЕсли;
		
	КонецЕсли;
	//-- №12971 по новому
	
	Возврат ЦенаНоменклатуры;
	
КонецФункции

//#7256
Функция ПолучитьИндивидуальнуюЦенуПродукции(ТекущаяЦена, ВидНоменклатуры, Фактура, ЦветФактуры, СФотопечатью, Шаблон, Номенклатура, ЕдиницаИзмерения, 
											ДатаЦены, Валюта,
											Знач Контрагент, Знач ДоговорКонтрагента)
	Результат = ТекущаяЦена;
	
	Если ПолучитьФункциональнуюОпцию("ИспользоватьИндивидуальныеЦены") Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВЫБОР
		|		КОГДА НЕ &СФотопечатью
		|			ТОГДА ВЫБОР
		|					КОГДА ЦеныИндивидуальныеСрезПоследних.ВидЦены = ЗНАЧЕНИЕ(Справочник.ВидыЦен.ПустаяСсылка)
		|						ТОГДА ЦеныИндивидуальныеСрезПоследних.Цена
		|					ИНАЧЕ ВЫРАЗИТЬ(ЕСТЬNULL(ЦеныСрезПоследних.Цена, 0) + ЕСТЬNULL(ЦеныСрезПоследних.Цена, 0) / 100 * ЦеныИндивидуальныеСрезПоследних.Наценка КАК ЧИСЛО(15, 2))
		|				КОНЕЦ
		|		ИНАЧЕ ВЫБОР
		|				КОГДА ЦеныИндивидуальныеСрезПоследних.ВидЦеныСФотопечатью = ЗНАЧЕНИЕ(Справочник.ВидыЦен.ПустаяСсылка)
		|					ТОГДА ЦеныИндивидуальныеСрезПоследних.ЦенаСФотопечатью
		|				ИНАЧЕ ВЫРАЗИТЬ(ЕСТЬNULL(ЦеныСрезПоследних.Цена, 0) + ЕСТЬNULL(ЦеныСрезПоследних.Цена, 0) / 100 * ЦеныИндивидуальныеСрезПоследних.НаценкаСФотопечатью КАК ЧИСЛО(15, 2))
		|			КОНЕЦ
		|	КОНЕЦ КАК Цена,
		|	ЦеныИндивидуальныеСрезПоследних.Отменена КАК Отменена
		|ИЗ
		|	РегистрСведений.ЦеныМатериаловИндивидуальные.СрезПоследних(
		|			&ДатаЦены,
		|			Контрагент = &Контрагент
		|				И ДоговорКонтрагента = &ДоговорКонтрагента
		|				И ВидНоменклатуры = &ВидНоменклатуры
		|				И Валюта = &Валюта
		|				И ВЫБОР
		|					КОГДА &ОтборПоШаблону ТОГДА Шаблон = &Шаблон 
		|					КОГДА &ОтборПоНоменклатуре ТОГДА Номенклатура = &Номенклатура И ЕдиницаИзмерения = &ЕдиницаИзмерения 
		|				  	ИНАЧЕ Фактура = &Фактура И ЦветФактуры = &ЦветФактуры
		|				  КОНЕЦ
		|	) КАК ЦеныИндивидуальныеСрезПоследних
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЦеныМатериалов.СрезПоследних(
		|				&ДатаЦены,
		|				ВидНоменклатуры = &ВидНоменклатуры
		|					И Валюта = &Валюта
		|					И ВЫБОР 
		|						КОГДА &ОтборПоШаблону ТОГДА Шаблон = &Шаблон 
		|						КОГДА &ОтборПоНоменклатуре ТОГДА Номенклатура = &Номенклатура И ЕдиницаИзмерения = &ЕдиницаИзмерения 
		|				  		ИНАЧЕ Фактура = &Фактура И ЦветФактуры = &ЦветФактуры
		|				  	  КОНЕЦ
		|		) КАК ЦеныСрезПоследних
		|		ПО ЦеныИндивидуальныеСрезПоследних.ВидНоменклатуры = ЦеныСрезПоследних.ВидНоменклатуры
		|			И ЦеныИндивидуальныеСрезПоследних.Фактура = ЦеныСрезПоследних.Фактура
		|			И ЦеныИндивидуальныеСрезПоследних.ЦветФактуры = ЦеныСрезПоследних.ЦветФактуры
		|			И ЦеныИндивидуальныеСрезПоследних.Шаблон = ЦеныСрезПоследних.Шаблон 		
		|			И ЦеныИндивидуальныеСрезПоследних.Номенклатура = ЦеныСрезПоследних.Номенклатура
		|			И ЦеныИндивидуальныеСрезПоследних.ЕдиницаИзмерения = ЦеныСрезПоследних.ЕдиницаИзмерения
		|			И (ВЫБОР
		|				КОГДА &СФотопечатью
		|					ТОГДА ЦеныИндивидуальныеСрезПоследних.ВидЦеныСФотопечатью = ЦеныСрезПоследних.ВидЦен
		|				ИНАЧЕ ЦеныИндивидуальныеСрезПоследних.ВидЦены = ЦеныСрезПоследних.ВидЦен
		|			КОНЕЦ)";
		
		Запрос.УстановитьПараметр("ДатаЦены",			КонецДня(ДатаЦены));
		Запрос.УстановитьПараметр("Контрагент",			Контрагент);
		Запрос.УстановитьПараметр("ДоговорКонтрагента", ДоговорКонтрагента);
		
		Запрос.УстановитьПараметр("ВидНоменклатуры",	ВидНоменклатуры);
		Запрос.УстановитьПараметр("Валюта",				Валюта);
		
		Запрос.УстановитьПараметр("Фактура",			Фактура);
		Запрос.УстановитьПараметр("ЦветФактуры",		ЦветФактуры);
		Запрос.УстановитьПараметр("СФотопечатью",		СФотопечатью);
		
		Запрос.УстановитьПараметр("ОтборПоШаблону",		НЕ Шаблон = Неопределено);
		Запрос.УстановитьПараметр("Шаблон",				Шаблон);
		
		Запрос.УстановитьПараметр("ОтборПоНоменклатуре",НЕ Номенклатура = Неопределено);
		Запрос.УстановитьПараметр("Номенклатура",		Номенклатура);
		Запрос.УстановитьПараметр("ЕдиницаИзмерения",	ЕдиницаИзмерения);
		
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Если НЕ Выборка.Отменена Тогда
				Результат = Выборка.Цена;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

