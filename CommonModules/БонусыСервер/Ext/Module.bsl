Процедура ОбработчикиПриОбновленииНаВерсию_2_8_34() Экспорт
	
	//#13834
	
	//1. настройка
	БонусыПоОплатам = Константы.УДАЛИТЬ_АвтоматическиНачислятьБонусыВДокументахОплаты.Получить();
	БонусыПоПродажам = Константы.УДАЛИТЬ_АвтоматическоеНачислениеБонусов.Получить();
	
	АвтоматическиНачислятьБонусы = БонусыПоОплатам ИЛИ БонусыПоПродажам;
								
	Константы.АвтоматическиНачислятьБонусы.Установить(АвтоматическиНачислятьБонусы);
	
	// 2. новый вид документа
	ЕстьНастройкиПоПродажам = Ложь;
	ЕстьНастройкиПоОБК = Ложь;
	ЕстьНастройкиПоПКО = Ложь;
	ЕстьНастройкиПоРКО = Ложь;
	ЕстьНастройкиПоПнРС = Ложь;
	ЕстьНастройкиПоОплатам = Ложь;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	НастройкиНачисления.Период КАК Период,
	
	|	НастройкиНачисления.Организация КАК Организация,
	|	НастройкиНачисления.ВидДокумента КАК ВидДокумента,
	|	НастройкиНачисления.КатегорияКонтрагента КАК КатегорияКонтрагента,
	
	|	НастройкиНачисления.ВидНоменклатуры КАК ВидНоменклатуры,
	|	НастройкиНачисления.Категория КАК Категория,
	|	НастройкиНачисления.Номенклатура КАК Номенклатура,
	|	НастройкиНачисления.СчетКасса КАК СчетКасса,
	|	НастройкиНачисления.БонусСуммой КАК БонусСуммой,
	|	НастройкиНачисления.БонусПроцентом КАК БонусПроцентом,
	|	НастройкиНачисления.НеНачислятьБонусы КАК НеНачислятьБонусы
	|ИЗ
	|	РегистрСведений.НастройкиНачисленияБонусовПоПродажам КАК НастройкиНачисления
	|
	|УПОРЯДОЧИТЬ ПО
	|	Организация,
	|	ВидДокумента,
	|	КатегорияКонтрагента,
	|	Период
	|ИТОГИ ПО
	|	Организация,
	|	ВидДокумента,
	|	КатегорияКонтрагента,
	|	Период";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Попытка
		// все в одной транзакции
		НачатьТранзакцию();
		
		ВыборкаПоОрганизациям = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаПоОрганизациям.Следующий() Цикл
			ВыборкаПоВидамДокументов = ВыборкаПоОрганизациям.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			Пока ВыборкаПоВидамДокументов.Следующий() Цикл
				ВыборкаПоКатегориямКонтрагентов = ВыборкаПоВидамДокументов.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
				
				Пока ВыборкаПоКатегориямКонтрагентов.Следующий() Цикл
					ВыборкаПоПериодам = ВыборкаПоКатегориямКонтрагентов.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
					
					Таблица1 = Неопределено;
					Таблица2 = Неопределено;
					Таблица3 = Неопределено;										
					
					Пока ВыборкаПоПериодам.Следующий() Цикл
						
						НовыйДокумент = Документы.НастройкаАвтоматическихНачисленийБонусов.СоздатьДокумент();
						НовыйДокумент.Заполнить(Неопределено);
						НовыйДокумент.Дата = ВыборкаПоПериодам.Период;
						НовыйДокумент.Организация = ВыборкаПоОрганизациям.Организация;
						НовыйДокумент.ВидДокумента = ВыборкаПоВидамДокументов.ВидДокумента;
						НовыйДокумент.КатегорияКонтрагента = ВыборкаПоКатегориямКонтрагентов.КатегорияКонтрагента;
						НовыйДокумент.Комментарий = "#Создан автоматически при обновлении на версию 2.8.Х";
						
						// ??? КАЖДЫЙ СЛЕДУЮЩИЙ ДОКУМЕНТ ПО ПЕРИОДУ ДОЛЖЕН СОДЕРЖАТЬ ТЧ ПРЕДЫДУЩЕГО ???
						Если НЕ Таблица1 = Неопределено Тогда
							НовыйДокумент.НастройкаПоВидамНоменклатуры.Загрузить(Таблица1);
						КонецЕсли;
						Если НЕ Таблица2 = Неопределено Тогда
							НовыйДокумент.НастройкаПоНоменклатуре.Загрузить(Таблица2);
						КонецЕсли;
						Если НЕ Таблица3 = Неопределено Тогда
							НовыйДокумент.СчетаИКассы.Загрузить(Таблица3);
						КонецЕсли;
						
						Выборка = ВыборкаПоПериодам.Выбрать();
						
						Пока Выборка.Следующий() Цикл
							
							Если ЗначениеЗаполнено(Выборка.Номенклатура) Тогда
								ИмяТабличнойЧасти = "НастройкаПоНоменклатуре";
								ПараметрыОтбора = Новый Структура("Номенклатура");
								
							ИначеЕсли ЗначениеЗаполнено(Выборка.ВидНоменклатуры) ИЛИ ЗначениеЗаполнено(Выборка.Категория) Тогда
								ИмяТабличнойЧасти = "НастройкаПоВидамНоменклатуры";
								ПараметрыОтбора = Новый Структура("ВидНоменклатуры, Категория");
								
							ИначеЕсли ЗначениеЗаполнено(Выборка.СчетКасса) Тогда
								ИмяТабличнойЧасти = "СчетаИКассы";
								ПараметрыОтбора = Новый Структура("СчетКасса");
								
							Иначе
								Продолжить;
								
							КонецЕсли;
							
							ЗаполнитьЗначенияСвойств(ПараметрыОтбора, Выборка);
							
							НайденныеСтроки = НовыйДокумент[ИмяТабличнойЧасти].НайтиСтроки(ПараметрыОтбора);
							Если НайденныеСтроки.Количество() = 0 Тогда
								СтрокаТабличнойЧасти = НовыйДокумент[ИмяТабличнойЧасти].Добавить();
							Иначе
								СтрокаТабличнойЧасти = НайденныеСтроки[0];
							КонецЕсли;
							
							ЗаполнитьЗначенияСвойств(СтрокаТабличнойЧасти, Выборка);
							
						КонецЦикла;
						
						Таблица1 = НовыйДокумент.НастройкаПоВидамНоменклатуры.Выгрузить();
					    Таблица2 = НовыйДокумент.НастройкаПоНоменклатуре.Выгрузить();
						Таблица3 = НовыйДокумент.СчетаИКассы.Выгрузить();
						
						Если Таблица1.Количество() > 0 ИЛИ Таблица2.Количество() > 0 ИЛИ Таблица3.Количество() > 0 Тогда
							НовыйДокумент.Записать(РежимЗаписиДокумента.Проведение);
						КонецЕсли;
						
						Если ВыборкаПоВидамДокументов.ВидДокумента = Справочники.ВидыДокументовНачисленияБонусов.РеализацияТоваровИУслуг Тогда
							ЕстьНастройкиПоПродажам = Истина;
						ИначеЕсли ВыборкаПоВидамДокументов.ВидДокумента = Справочники.ВидыДокументовНачисленияБонусов.ОплатаБанковскойКартой Тогда
							ЕстьНастройкиПоОБК = Истина;
						ИначеЕсли ВыборкаПоВидамДокументов.ВидДокумента = Справочники.ВидыДокументовНачисленияБонусов.ПриходныйКассовыйОрдер Тогда
							ЕстьНастройкиПоПКО = Истина;
						ИначеЕсли ВыборкаПоВидамДокументов.ВидДокумента = Справочники.ВидыДокументовНачисленияБонусов.РасходныйКассовыйОрдер Тогда
							ЕстьНастройкиПоРКО = Истина;
						ИначеЕсли ВыборкаПоВидамДокументов.ВидДокумента = Справочники.ВидыДокументовНачисленияБонусов.ПоступлениеНаРасчетныйСчет Тогда
							ЕстьНастройкиПоПнРС = Истина;
						КонецЕсли;
					КонецЦикла;
					
				КонецЦикла;
				
				
			КонецЦикла;
		КонецЦикла;		
		
		// документы-стопы		
		Если НЕ БонусыПоПродажам И ЕстьНастройкиПоПродажам Тогда //И АвтоматическиНачислятьБонусы Тогда
			
			// если на данный момент отключены бонусы по реализации, но есть документы "НастройкаАвтоматическихНачисленийБонусов"
			// то найдем последний документ реализации, при котором была включена настройка и создадим стоп-начисление
			Запрос = Новый запрос;
			Запрос.УстановитьПараметр("ВидДокументаНачисленияБонусов", Справочники.ВидыДокументовНачисленияБонусов.РеализацияТоваровИУслуг);
			ТекстЗапроса = ТекстЗапросаПоискПоследнегоДокумента();
			Запрос.Текст = СтрЗаменить(ТекстЗапроса, "%Таблица", "РеализацияТоваровИУслуг");
			
			РезультатЗапроса = Запрос.ВыполнитьПакет();
			
			ДатаДокумента = Неопределено;
			Выборка = РезультатЗапроса[0].Выбрать();
			Если Выборка.Следующий() Тогда
				ДатаДокумента = Выборка.Дата + 1;
			КонецЕсли;
			
			Выборка = РезультатЗапроса[2].Выбрать();
			Пока Выборка.Следующий() Цикл
				
				Дата = ?(ДатаДокумента = Неопределено, Выборка.Дата + 1, Макс(ДатаДокумента, Выборка.Дата + 1));
				РезультатСД = СоздатьСтопНастройкуАвтоматическихНачисленийБонусов(Дата, Выборка.Ссылка, Истина, Истина, Ложь);
				
				Если НЕ РезультатСД Тогда
					ВызватьИсключение "";
				КонецЕсли;				
				
			КонецЦикла;
		КонецЕсли; 		
		
		ЕстьНастройкиПоОплатам = ЕстьНастройкиПоОБК ИЛИ ЕстьНастройкиПоПКО ИЛИ ЕстьНастройкиПоРКО ИЛИ ЕстьНастройкиПоПнРС ;
	
		Если НЕ БонусыПоОплатам И ЕстьНастройкиПоОплатам Тогда //И АвтоматическиНачислятьБонусы Тогда
			
			// если на данный момент отключены бонусы по оплатам, но есть документы "НастройкаАвтоматическихНачисленийБонусов"
			// то найдем последний документ оплаты (по видам), при котором была включена настройка и создадим стоп-начисление
			МассивДок = новый Массив;
			Если ЕстьНастройкиПоОБК Тогда
				МассивДок.Добавить(Новый Структура("Таблица, ВидДокумента", "ОплатаБанковскойКартой", Справочники.ВидыДокументовНачисленияБонусов.ОплатаБанковскойКартой));
			КонецЕсли;
			Если ЕстьНастройкиПоПКО Тогда
				МассивДок.Добавить(Новый Структура("Таблица, ВидДокумента", "ПриходныйКассовыйОрдер", Справочники.ВидыДокументовНачисленияБонусов.ПриходныйКассовыйОрдер));
			КонецЕсли;
			Если ЕстьНастройкиПоПнРС Тогда
				МассивДок.Добавить(Новый Структура("Таблица, ВидДокумента", "ПоступлениеНаРасчетныйСчет", Справочники.ВидыДокументовНачисленияБонусов.ПоступлениеНаРасчетныйСчет));			
			КонецЕсли;
			Если ЕстьНастройкиПоРКО Тогда
				МассивДок.Добавить(Новый Структура("Таблица, ВидДокумента", "РасходныйКассовыйОрдер", Справочники.ВидыДокументовНачисленияБонусов.РасходныйКассовыйОрдер));
			КонецЕсли;
			
			Для каждого ЭлементМассива из МассивДок Цикл
				Запрос = Новый запрос;
				Запрос.УстановитьПараметр("ВидДокументаНачисленияБонусов", ЭлементМассива.ВидДокумента);
				ТекстЗапроса = ТекстЗапросаПоискПоследнегоДокумента();
				Запрос.Текст = СтрЗаменить(ТекстЗапроса, "%Таблица", ЭлементМассива.Таблица);
				
				РезультатЗапроса = Запрос.ВыполнитьПакет();
				
				ДатаДокумента = Неопределено;
				Выборка = РезультатЗапроса[0].Выбрать();
				Если Выборка.Следующий() Тогда
					ДатаДокумента = Выборка.Дата + 1;
				КонецЕсли;
				
				Выборка = РезультатЗапроса[2].Выбрать();
				Пока Выборка.Следующий() Цикл
					
					Дата = ?(ДатаДокумента = Неопределено, Выборка.Дата + 1, Макс(ДатаДокумента, Выборка.Дата + 1));
					РезультатСД = СоздатьСтопНастройкуАвтоматическихНачисленийБонусов(Дата, Выборка.Ссылка, Ложь, Ложь, Истина);
					
					Если НЕ РезультатСД Тогда
						ВызватьИсключение "";
					КонецЕсли;				
					
				КонецЦикла;
			КонецЦикла;

		КонецЕсли;
	
	
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		
		ЗаписьЖурналаРегистрации("Обновление информационной базы", УровеньЖурналаРегистрации.Ошибка,,, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ВызватьИсключение; // обновление невозможно
	КонецПопытки;
		
КонецПроцедуры
 
Функция ТекстЗапросаПоискПоследнегоДокумента()
	
	Возврат
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	ДанныеДокумента.Ссылка КАК Ссылка,
	|	ДанныеДокумента.Дата КАК Дата
	|ИЗ
	|	Документ.%Таблица КАК ДанныеДокумента
	|ГДЕ
	|	ДанныеДокумента.НачислятьБонусы
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДанныеДокумента.Дата УБЫВ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	МАКСИМУМ(НастройкаАвтоматическихНачисленийБонусов.Дата) КАК Дата,
	|	НастройкаАвтоматическихНачисленийБонусов.Организация КАК Организация,
	|	НастройкаАвтоматическихНачисленийБонусов.ВидДокумента КАК ВидДокумента,
	|	НастройкаАвтоматическихНачисленийБонусов.КатегорияКонтрагента КАК КатегорияКонтрагента
	|ПОМЕСТИТЬ ВТ
	|ИЗ
	|	Документ.НастройкаАвтоматическихНачисленийБонусов КАК НастройкаАвтоматическихНачисленийБонусов
	|ГДЕ
	|	НастройкаАвтоматическихНачисленийБонусов.ВидДокумента = &ВидДокументаНачисленияБонусов
	|	И НЕ НастройкаАвтоматическихНачисленийБонусов.ПометкаУдаления
	|
	|СГРУППИРОВАТЬ ПО
	|	НастройкаАвтоматическихНачисленийБонусов.Организация,
	|	НастройкаАвтоматическихНачисленийБонусов.ВидДокумента,
	|	НастройкаАвтоматическихНачисленийБонусов.КатегорияКонтрагента
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	НастройкаАвтоматическихНачисленийБонусов.Ссылка КАК Ссылка,
	|	НастройкаАвтоматическихНачисленийБонусов.Дата КАК Дата
	|ИЗ
	|	Документ.НастройкаАвтоматическихНачисленийБонусов КАК НастройкаАвтоматическихНачисленийБонусов
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ КАК ВТ
	|		ПО НастройкаАвтоматическихНачисленийБонусов.Дата = ВТ.Дата
	|			И НастройкаАвтоматическихНачисленийБонусов.Организация = ВТ.Организация
	|			И НастройкаАвтоматическихНачисленийБонусов.ВидДокумента = ВТ.ВидДокумента
	|			И НастройкаАвтоматическихНачисленийБонусов.КатегорияКонтрагента = ВТ.КатегорияКонтрагента
	|ГДЕ
	|	НЕ НастройкаАвтоматическихНачисленийБонусов.ПометкаУдаления";
	
КонецФункции

Функция СоздатьСтопНастройкуАвтоматическихНачисленийБонусов(Дата, Основание, СтопПоВидамНоменклатуры = Ложь, СтопПоНоменклатуре = Ложь, СтопПоСчетамКассам = Ложь)
	
	НовыйДокумент = Документы.НастройкаАвтоматическихНачисленийБонусов.СоздатьДокумент();
	НовыйДокумент.Заполнить(Основание);
	НовыйДокумент.Дата = Дата;
	НовыйДокумент.Комментарий = "#Создан автоматически при обновлении на версию 2.8.Х (стоп)";
	
	Если СтопПоВидамНоменклатуры Тогда	
		Для каждого СтрокаТЧ из НовыйДокумент.НастройкаПоВидамНоменклатуры Цикл
			СтрокаТЧ.БонусСуммой = 0;
			СтрокаТЧ.БонусПроцентом = 0;
			СтрокаТЧ.НеНачислятьБонусы = Истина;
		КонецЦикла;
	КонецЕсли;
	
	Если СтопПоНоменклатуре Тогда
		Для каждого СтрокаТЧ из НовыйДокумент.НастройкаПоНоменклатуре Цикл
			СтрокаТЧ.БонусСуммой = 0;
			СтрокаТЧ.БонусПроцентом = 0;
			СтрокаТЧ.НеНачислятьБонусы = Истина;
		КонецЦикла;
	КонецЕсли;
	
	Если СтопПоСчетамКассам Тогда 
		Для каждого СтрокаТЧ из НовыйДокумент.СчетаИКассы Цикл
			СтрокаТЧ.БонусПроцентом = 0;
		КонецЦикла;
	КонецЕсли;
	
	Если НовыйДокумент.НастройкаПоВидамНоменклатуры.Количество() > 0 
		ИЛИ НовыйДокумент.НастройкаПоНоменклатуре.Количество() > 0 
		ИЛИ НовыйДокумент.СчетаИКассы.Количество() > 0 Тогда
		
		Попытка
			НовыйДокумент.Записать(РежимЗаписиДокумента.Проведение);
			Возврат Истина;
		Исключение
			Возврат Ложь;
		КонецПопытки;
		
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции
			
#КонецОбласти