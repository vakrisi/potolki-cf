Функция ВидДокументаНачисленияБонусовПоСсылке(ДокументСсылка)
	
	ВидДокумента = Справочники.ВидыДокументовНачисленияБонусов.ПустаяСсылка();
	
	Если ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.РеализацияТоваровИУслуг") Тогда
		ВидДокумента = Справочники.ВидыДокументовНачисленияБонусов.РеализацияТоваровИУслуг;
		
	ИначеЕсли ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.Монтаж") Тогда
		//для розницы дисконтные карты пока неработают
		//ВидДокумента = Справочники.ВидыДокументовНачисленияБонусов.Монтаж;
		
	ИначеЕсли ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.ПриходныйКассовыйОрдер") Тогда
		ВидДокумента = Справочники.ВидыДокументовНачисленияБонусов.ПриходныйКассовыйОрдер;
		
	ИначеЕсли ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.ПоступлениеНаРасчетныйСчет") Тогда
		ВидДокумента = Справочники.ВидыДокументовНачисленияБонусов.ПоступлениеНаРасчетныйСчет;
		
	ИначеЕсли ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.ОплатаБанковскойКартой") Тогда
		ВидДокумента = Справочники.ВидыДокументовНачисленияБонусов.ОплатаБанковскойКартой;
		
	ИначеЕсли ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.РасходныйКассовыйОрдер") Тогда
		ВидДокумента = Справочники.ВидыДокументовНачисленияБонусов.РасходныйКассовыйОрдер;
	КонецЕсли;
	
	Возврат ВидДокумента;
	
КонецФункции

