
#Область СлужебныеПроцедурыИФункции

Процедура НастройкаЭлементов(Элементы, ДокОбъект) Экспорт
	
	//#13359
	Элементы.СлужебныйВидБонуснойСистемы.ТолькоПросмотр = НЕ ОбщийМодульСервер.НастройкаПользователя("РазрешеноМенятьВидБонуснойСистемыВДокументе");
	
	Если ДокОбъект.СлужебныйВидБонуснойСистемы = Перечисления.ВидыБонусныхСистем.Внутренняя тогда
		
		Элементы.ГруппаВидБонуснойСистемыUDS.Видимость = Ложь;
		Элементы.ГруппаВидБонуснойСистемыВнутренняя.Видимость = Истина;
		
		Элементы.ГруппаВидыБонусныхСистем.ТекущаяСтраница = Элементы.ГруппаВидБонуснойСистемыВнутренняя;
		
	ИначеЕсли ДокОбъект.СлужебныйВидБонуснойСистемы = Перечисления.ВидыБонусныхСистем.UDS тогда
		
		Элементы.ГруппаВидБонуснойСистемыВнутренняя.Видимость = Ложь;
		Элементы.ГруппаВидБонуснойСистемыUDS.Видимость = Истина;
		
		Элементы.ГруппаВидыБонусныхСистем.ТекущаяСтраница = Элементы.ГруппаВидБонуснойСистемыUDS;
		Если ЗначениеЗаполнено(ДокОбъект.UDS_ИдентификаторОперации) Тогда
			Элементы.ГруппаВидыБонусныхСистем.ТолькоПросмотр = Истина;	
		КонецЕсли;
		
		Элементы.ДоступноБонусовКСписаниюUDS.Видимость = ДокОбъект.СписыватьБонусы;
		Элементы.СуммаБонусовКСписаниюUDS.Видимость = ДокОбъект.СписыватьБонусы;
		
	КонецЕсли;
	
КонецПроцедуры

// №13299
Процедура ОпределитьОстатокПоДисконтнойКарте(Форма) Экспорт
	
	ДанныеФормыОбъект = Форма.Объект;
	
	Если НЕ ДанныеФормыОбъект.СлужебныйВидБонуснойСистемы = Перечисления.ВидыБонусныхСистем.Внутренняя Тогда
		Возврат;
	КонецЕсли;	
	
	ДатаЗапроса = ДанныеФормыОбъект.Дата;
	Если ДатаЗапроса = Дата(1,1,1) Тогда
		ДатаЗапроса = ТекущаяДатаСеанса();
	КонецЕсли;
	
	Форма.ОстатокПоДисконтнойКарте = 0;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВЫБОР
	|		КОГДА &УчетБонусовПоДисконтнымКартам И (&ДисконтнаяКарта = Значение(Справочник.ДисконтныеКарты.ПустаяСсылка))
	|			ТОГДА 0
	|		ИНАЧЕ БонусыКонтрагентовОстатки.СуммаОстаток
	|	КОНЕЦ КАК СуммаОстаток
	|ИЗ
	|	РегистрНакопления.БонусыКонтрагентов.Остатки(
	|			&ДатаЗапроса,
	|			Контрагент = &Контрагент
	|				И ДисконтнаяКарта = &ДисконтнаяКарта) КАК БонусыКонтрагентовОстатки";
	
	//#15828 на момент документа
	//Запрос.УстановитьПараметр("ДатаЗапроса", КонецДня(ДатаЗапроса));
	Запрос.УстановитьПараметр("ДатаЗапроса", Новый Граница(ДатаЗапроса, ВидГраницы.Исключая));
	Запрос.УстановитьПараметр("ДисконтнаяКарта", ДанныеФормыОбъект.ДисконтнаяКарта);
	Запрос.УстановитьПараметр("Контрагент", ДанныеФормыОбъект.Контрагент);
	Запрос.УстановитьПараметр("УчетБонусовПоДисконтнымКартам", ДанныеФормыОбъект.СлужебныйУчетБонусовПоДисконтнымКартам); // №6316 нужно проверить заполненность дисконтной карты
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Форма.ОстатокПоДисконтнойКарте = Выборка.СуммаОстаток;
	КонецЦикла;
	
КонецПроцедуры

// №13299
Процедура ПересчитатьБонусыПоДокументу(ДанныеФормыОбъект, ЕстьУслуги = Ложь, КатегорияИзДокумента = Истина) Экспорт
	
	//ДанныеФормыОбъект = Форма.Объект;
	//ЕстьУслуги = ДанныеФормыОбъект.Свойство("Услуги");
	
	Если НЕ ДанныеФормыОбъект.СлужебныйВидБонуснойСистемы = Перечисления.ВидыБонусныхСистем.Внутренняя Тогда
		Возврат;
	КонецЕсли;
		
	ДокументНАНБ = Документы.НастройкаАвтоматическихНачисленийБонусов.ПустаяСсылка();
	
	Если ДанныеФормыОбъект.СлужебныйУчитыватьБонусы Тогда
		
		мНачислятьБонусы = ДанныеФормыОбъект.НачислятьБонусы;
		Если мНачислятьБонусы И (ДанныеФормыОбъект.Товары.Итог("СкидкаБонусами") + ?(ЕстьУслуги, ДанныеФормыОбъект.Услуги.Итог("СкидкаБонусами"), 0)) > 0 Тогда
			Если НЕ ДанныеФормыОбъект.НачислятьБонусыПоДисконтнойКартеПриЗачетеБонусовКакСкидку Тогда
				мНачислятьБонусы = Ложь;
			КонецЕсли;
		КонецЕсли;
				
		Если мНачислятьБонусы Тогда
			
			// рассчитаем бонусы к начислению
			ДатаРасчета = ?(ДанныеФормыОбъект.Дата = Дата(1,1,1), ТекущаяДатаСеанса(), ДанныеФормыОбъект.Дата);
			ВидДокументаНБ = ВидДокументаНачисленияБонусовПоСсылке(ДанныеФормыОбъект.Ссылка);
			КатегорияКонтрагента = ?(КатегорияИзДокумента, ДанныеФормыОбъект.КатегорияКонтрагента, ДанныеФормыОбъект.Контрагент.Категория);
			ПараметрыОтбора = Новый Структура("Организация, ВидДокумента, КатегорияКонтрагента", 
												ДанныеФормыОбъект.Организация, ВидДокументаНБ, КатегорияКонтрагента);
			ДокументНАНБ = ПодобратьДокументНастройкиНачисленияБонусов(ДатаРасчета, ПараметрыОтбора);
	
			ТаблицаБонусовТовары = ПолучитьТаблицуБонусовКНачислению(ДокументНАНБ, ДатаРасчета, ДанныеФормыОбъект.Товары.Выгрузить()); //, ДанныеФормыОбъект.Дата, ДанныеФормыОбъект.Организация, ДанныеФормыОбъект.Контрагент.Категория, ДанныеФормыОбъект.Ссылка);
			
			Если ЕстьУслуги Тогда
				ТаблицаБонусовУслуги = ПолучитьТаблицуБонусовКНачислению(ДокументНАНБ, ДатаРасчета, ДанныеФормыОбъект.Услуги.Выгрузить()); //, ДанныеФормыОбъект.Дата, ДанныеФормыОбъект.Организация, ДанныеФормыОбъект.Контрагент.Категория, ДанныеФормыОбъект.Ссылка);
			КонецЕсли;
			
			Для Каждого ТекущаяСтрока Из ДанныеФормыОбъект.Товары Цикл
				
				Отбор = Новый Структура;
				Отбор.Вставить("Номенклатура", ТекущаяСтрока.Номенклатура);
				
				НайденныеСтроки = ТаблицаБонусовТовары.НайтиСтроки(Отбор);
				
				Если НайденныеСтроки.Количество() > 0 Тогда
					//вычисляем сумму бонусов для строки, а не просто присваиваем, т.к. в документе номенклатура в строках может быть задвоена
					Если НайденныеСтроки[0].КоличествоПродажи <> 0 Тогда
						ТекущаяСтрока.БонусыКНачислению = (НайденныеСтроки[0].БонусыКНачислению / НайденныеСтроки[0].КоличествоПродажи) * (ТекущаяСтрока.Количество * ТекущаяСтрока.Коэффициент);
					КонецЕсли;
				КонецЕсли;
				
			КонецЦикла;
			
			Если ЕстьУслуги Тогда
				
				Для Каждого ТекущаяСтрока Из ДанныеФормыОбъект.Услуги Цикл
					
					Отбор = Новый Структура;
					Отбор.Вставить("Номенклатура", ТекущаяСтрока.Номенклатура);
					
					НайденныеСтроки = ТаблицаБонусовУслуги.НайтиСтроки(Отбор);
					
					Если НайденныеСтроки.Количество() > 0 Тогда
						//вычисляем сумму бонусов для строки, а не просто присваиваем, т.к. в документе номенклатура в строках может быть задвоена
						Если НайденныеСтроки[0].КоличествоПродажи <> 0 Тогда
							ТекущаяСтрока.БонусыКНачислению = (НайденныеСтроки[0].БонусыКНачислению / НайденныеСтроки[0].КоличествоПродажи) * (ТекущаяСтрока.Количество * ТекущаяСтрока.Коэффициент);
						КонецЕсли;
					КонецЕсли;
					
				КонецЦикла;
				
			КонецЕсли;
			
		Иначе
			
			Для Каждого ТекущаяСтрока Из ДанныеФормыОбъект.Товары Цикл
				ТекущаяСтрока.БонусыКНачислению = 0;
			КонецЦикла;
			
			Если ЕстьУслуги Тогда
				
				Для Каждого ТекущаяСтрока Из ДанныеФормыОбъект.Услуги Цикл
					ТекущаяСтрока.БонусыКНачислению = 0;
				КонецЦикла;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	СуммаБонусовВрем = ДанныеФормыОбъект.Товары.Итог("БонусыКНачислению") + ?(ЕстьУслуги, ДанныеФормыОбъект.Услуги.Итог("БонусыКНачислению"), 0);
	
	// №6316 нужно проверить заполнение дисконтной карты
	Если ДанныеФормыОбъект.СлужебныйУчетБонусовПоДисконтнымКартам И ДанныеФормыОбъект.ДисконтнаяКарта.Пустая() Тогда
		СуммаБонусовВрем = 0;
	КонецЕсли;	
	
	Если НЕ ДанныеФормыОбъект.СуммаБонусовКНачислениюПоДисконтнойКарте = СуммаБонусовВрем Тогда
		ДанныеФормыОбъект.СуммаБонусовКНачислениюПоДисконтнойКарте = СуммаБонусовВрем;
	КонецЕсли;
	
	Если мНачислятьБонусы = Истина Тогда
		ДанныеФормыОбъект.ДокументНАНБ = ДокументНАНБ;
	КонецЕсли;
	
КонецПроцедуры

// №13299
Процедура ОчиститьСуммуБонусовПоСтрокамДокумента(ДанныеФормыОбъект) Экспорт
	
	//ДанныеФормыОбъект = Форма.Объект;
	//или ДокументОбъект
	
	//ЕстьУслуги = ДанныеФормыОбъект.Свойство("Услуги");
	ЕстьУслуги = ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ДанныеФормыОбъект, "Услуги");
	
	УчитыватьНДС = УчетНДС.ОрганизацияЯвляетсяПлательщикомНДС(ДанныеФормыОбъект.Организация);
	
	// #10832 Сумму не пересчитываем как Цена*Количество, а берем имеющееся значение
	Для Каждого ТекСтрока Из ДанныеФормыОбъект.Товары Цикл
		
		ТекСтрока.Сумма = ТекСтрока.Сумма + ТекСтрока.СкидкаБонусами;
		ТекСтрока.СкидкаБонусами = 0;
		
		ОбработкаТабличныхЧастейСервер.ПересчитатьСуммуНДСВСтрокеТЧ(ТекСтрока, УчитыватьНДС);
		
	КонецЦикла;
	
	Если ЕстьУслуги Тогда
			
		Для Каждого ТекСтрока Из ДанныеФормыОбъект.Услуги Цикл
			
			ТекСтрока.Сумма = ТекСтрока.Сумма + ТекСтрока.СкидкаБонусами;
			ТекСтрока.СкидкаБонусами = 0;
			
			ОбработкаТабличныхЧастейСервер.ПересчитатьСуммуНДСВСтрокеТЧ(ТекСтрока, УчитыватьНДС);
			
		КонецЦикла;
		
	КонецЕсли;
	
	//#8095
	ДанныеФормыОбъект.СуммаДокумента = ДанныеФормыОбъект.Товары.Итог("Сумма") + ?(ЕстьУслуги, ДанныеФормыОбъект.Услуги.Итог("Сумма"), 0); 

КонецПроцедуры

// №13299
Процедура РаспределитьСкидкуБонусамиПоСтрокамДокумента(ДанныеФормыОбъект, ПолеСуммаСкидки = Неопределено, СуммаРаспределения = Неопределено) Экспорт
	
	//ДанныеФормыОбъект = Форма.Объект;
	//или ДокументОбъект
	
	Если ПолеСуммаСкидки = Неопределено Тогда
		ПолеСуммаСкидки = "СкидкаБонусами";
	КонецЕсли;
	
	Если СуммаРаспределения = Неопределено Тогда
		СуммаРаспределения = ДанныеФормыОбъект.СуммаБонусовКСписаниюПоДисконтнойКарте;
	КонецЕсли;
	
	//ЕстьУслуги = ДанныеФормыОбъект.Свойство("Услуги");
	ЕстьУслуги = ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ДанныеФормыОбъект, "Услуги");
	
	ВалютаУчета = Константы.ВалютаУчета.Получить();
	УчитыватьНДС = УчетНДС.ОрганизацияЯвляетсяПлательщикомНДС(ДанныеФормыОбъект.Организация);
	
	ОчиститьСуммуБонусовПоСтрокамДокумента(ДанныеФормыОбъект); //ОчиститьСуммуБонусовПоДисконтнымКартамПоСтрокам(ДанныеФормыОбъект);
	
	РаспределитьВсего = РаботаСВалютой.ПересчитатьИзВалютыВВалюту(ВалютаУчета, ДанныеФормыОбъект.Валюта, ДанныеФормыОбъект.Дата, СуммаРаспределения);
	РаспределитьНаУслуги = 0;
	РаспределитьНаТовары = 0;
	
	ИтоговаяСумммаДокументаДолжнаБыть = ДанныеФормыОбъект.СуммаДокумента - РаспределитьВсего;
	
	//#8095 вычисляем сумму только по "платным" строкам
	//СуммаТовары = Товары.Итог("Сумма");
	//СуммаУслуги = Услуги.Итог("Сумма");
	СуммаТовары = 0;
	СуммаУслуги = 0;
	
	Для Каждого ТекСтрока Из ДанныеФормыОбъект.Товары Цикл
		Если НЕ ТекСтрока.Сумма = 0 И НЕ ТекСтрока.Бесплатно Тогда
			СуммаТовары = СуммаТовары + ТекСтрока.Сумма;
		КонецЕсли;
	КонецЦикла;
	
	Если ЕстьУслуги Тогда
		
		Для Каждого ТекСтрока Из ДанныеФормыОбъект.Услуги Цикл
			Если НЕ ТекСтрока.Сумма = 0 И НЕ ТекСтрока.Бесплатно Тогда
				СуммаУслуги = СуммаУслуги + ТекСтрока.Сумма;
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
													   
	Если СуммаТовары + СуммаУслуги = 0 Тогда
		Возврат;
	КонецЕсли;
	
	РаспределитьНаУслуги = Окр(СуммаУслуги / (СуммаТовары + СуммаУслуги) * РаспределитьВсего, 2);
	РаспределитьНаТовары = РаспределитьВсего - РаспределитьНаУслуги;

	// распределим сумму бонусов как скидку
	Если НЕ СуммаУслуги = 0 Тогда
		
		Для Каждого ТекСтрока Из ДанныеФормыОбъект.Услуги Цикл
			
			Если ТекСтрока.Сумма = 0 ИЛИ ТекСтрока.Бесплатно Тогда
				// #8095 пропускаем "бесплатные" строки
				Продолжить;
			КонецЕсли;
			
			ТекСтрока[ПолеСуммаСкидки] = Окр((ТекСтрока.Сумма / СуммаУслуги) * РаспределитьНаУслуги,2);
			// #10832 Сумму не пересчитываем как Цена*Количество, а берем имеющееся значение
			//ТекСтрока.Сумма = ТекСтрока.Количество * ТекСтрока.Цена - ТекСтрока.СуммаРучнойСкидки - ТекСтрока.СкидкаБонусами;
			ТекСтрока.Сумма = ТекСтрока.Сумма - ТекСтрока[ПолеСуммаСкидки];
			
			ОбработкаТабличныхЧастейСервер.ПересчитатьСуммуНДСВСтрокеТЧ(ТекСтрока, УчитыватьНДС);
			
		КонецЦикла;
		
	КонецЕсли;
	
	Если НЕ СуммаТовары = 0 Тогда
		
		Для Каждого ТекСтрока Из ДанныеФормыОбъект.Товары Цикл
			
			Если ТекСтрока.Сумма = 0 ИЛИ ТекСтрока.Бесплатно Тогда
				// #8095 пропускаем "бесплатные" строки
				Продолжить;
			КонецЕсли;
			
			ТекСтрока[ПолеСуммаСкидки] = Окр((ТекСтрока.Сумма / СуммаТовары) * РаспределитьНаТовары,2);
			//ТекСтрока.Сумма = ТекСтрока.Количество * ТекСтрока.Цена - ТекСтрока.СуммаРучнойСкидки - ТекСтрока.СкидкаБонусами;
			ТекСтрока.Сумма = ТекСтрока.Сумма - ТекСтрока[ПолеСуммаСкидки];
			
			ОбработкаТабличныхЧастейСервер.ПересчитатьСуммуНДСВСтрокеТЧ(ТекСтрока, УчитыватьНДС);
			
		КонецЦикла;
		
	КонецЕсли;
	
	РазницаВРаспределении = (ДанныеФормыОбъект.Товары.Итог("Сумма") + ?(ЕстьУслуги, ДанныеФормыОбъект.Услуги.Итог("Сумма"), 0)) - ИтоговаяСумммаДокументаДолжнаБыть;
	
	Если НЕ РазницаВРаспределении = 0 Тогда
		
		// скорее всего копейка "закатилась" при округлениях, добавим ее
		Если ЕстьУслуги И ДанныеФормыОбъект.Услуги.Количество() > 0 Тогда
			
			Для Каждого ТекСтрока Из ДанныеФормыОбъект.Услуги Цикл
				
				Если ТекСтрока.Сумма = 0 ИЛИ ТекСтрока.Бесплатно Тогда
					// #8095 пропускаем "бесплатные" строки
					Продолжить;
				Иначе
					
					КРаспределению = Мин(ТекСтрока.Сумма, РазницаВРаспределении);
					ТекСтрока[ПолеСуммаСкидки] = ТекСтрока[ПолеСуммаСкидки] + КРаспределению;
					//ТекСтрока.Сумма = ТекСтрока.Количество * ТекСтрока.Цена - ТекСтрока.СуммаРучнойСкидки - ТекСтрока.СкидкаБонусами;
					// #11036 исправлено: вычитаем не всю сумму бонусов, а только остаток к Распределению
					ТекСтрока.Сумма = ТекСтрока.Сумма - КРаспределению; // - ТекСтрока.СкидкаБонусами;
					
					ОбработкаТабличныхЧастейСервер.ПересчитатьСуммуНДСВСтрокеТЧ(ТекСтрока, УчитыватьНДС);
					
					РазницаВРаспределении = РазницаВРаспределении - КРаспределению;
					Если РазницаВРаспределении = 0 Тогда
						Прервать;
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЕсли;
		
		Если НЕ РазницаВРаспределении = 0 И ДанныеФормыОбъект.Товары.Количество() > 0 Тогда
			
			Для Каждого ТекСтрока Из ДанныеФормыОбъект.Товары Цикл
				
				Если ТекСтрока.Сумма = 0 ИЛИ ТекСтрока.Бесплатно Тогда
					// #8095 пропускаем "бесплатные" строки
