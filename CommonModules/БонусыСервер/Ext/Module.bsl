//Бонусы по документам оплаты
Функция ПолучитьСуммуБонусовКНачислениюПоДокументуОплаты(Знач Дата, Знач Организация, Знач КатегорияКонтрагента, 
														Знач СчетКасса, Знач СуммаДокумента, 
														Знач ДокументСсылка, Знач ДисконтнаяКарта, 
														Знач УчетБонусовПоДисконтнымКартам) Экспорт
	
	БонусыКВозврату = 0;
	СтруктураВозврата = Новый Структура("ДокументНАНБ, СуммаБонусов", Документы.НастройкаАвтоматическихНачисленийБонусов.ПустаяСсылка(), БонусыКВозврату);
	
	Если СуммаДокумента = 0 Тогда
		Возврат СтруктураВозврата;
	КонецЕсли;
	
	// №6316 нужно проверить заполнение дисконтной карты
	Если УчетБонусовПоДисконтнымКартам И ДисконтнаяКарта.Пустая() Тогда
		Возврат СтруктураВозврата;
	КонецЕсли;
	
	ВидДокумента = ВидДокументаНачисленияБонусовПоСсылке(ДокументСсылка);
	
	ДатаРасчета = ?(Дата = Дата(1,1,1), ТекущаяДатаСеанса(), Дата);
	//Если Дата = Дата(1,1,1) Тогда
	//	Дата = КонецДня(ТекущаяДатаСеанса());
	//Иначе
	//	Дата = КонецДня(Дата);
	//КонецЕсли;
	
	//++ #13834 регистр не используется
	//Запрос = Новый Запрос;
	//Запрос.Текст =	
	//"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	//|	НастройкиНачисленияБонусовПоПродажамСрезПоследних.Организация,
	//|	НастройкиНачисленияБонусовПоПродажамСрезПоследних.КатегорияКонтрагента,	
	//|	НастройкиНачисленияБонусовПоПродажамСрезПоследних.ВидДокумента,
	//|	НастройкиНачисленияБонусовПоПродажамСрезПоследних.БонусПроцентом
	//|ИЗ
	//|	РегистрСведений.НастройкиНачисленияБонусовПоПродажам.СрезПоследних(&Дата, ) КАК НастройкиНачисленияБонусовПоПродажамСрезПоследних
	//|ГДЕ
	//|	НастройкиНачисленияБонусовПоПродажамСрезПоследних.Организация = &Организация
	//|	И НастройкиНачисленияБонусовПоПродажамСрезПоследних.КатегорияКонтрагента = &КатегорияКонтрагента
	//|	И НастройкиНачисленияБонусовПоПродажамСрезПоследних.ВидДокумента = &ВидДокумента
	//|	И НастройкиНачисленияБонусовПоПродажамСрезПоследних.СчетКасса = &СчетКасса";
	//Запрос.УстановитьПараметр("Дата", Дата);
	//Запрос.УстановитьПараметр("Организация", Организация);
	//Запрос.УстановитьПараметр("КатегорияКонтрагента", КатегорияКонтрагента);
	//Запрос.УстановитьПараметр("ВидДокумента", ВидДокумента);	
	//Запрос.УстановитьПараметр("СчетКасса", СчетКасса);
	
	ПараметрыОтбора = Новый Структура("Организация, ВидДокумента, КатегорияКонтрагента", Организация, ВидДокумента, КатегорияКонтрагента);
	ДокументНАНБ = ПодобратьДокументНастройкиНачисленияБонусов(ДатаРасчета, ПараметрыОтбора);
			
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДокументНАНБ", ДокументНАНБ);
	Запрос.УстановитьПараметр("СчетКасса", СчетКасса);
	Запрос.Текст =	
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ДанныеДокумента.БонусПроцентом КАК БонусПроцентом
	|ИЗ
	|	Документ.НастройкаАвтоматическихНачисленийБонусов.СчетаИКассы КАК ДанныеДокумента
	|ГДЕ
	|	ДанныеДокумента.Ссылка = &ДокументНАНБ
	|	И ДанныеДокумента.СчетКасса = &СчетКасса";
	
	//-- #13834
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		БонусыКВозврату = Окр(Выборка.БонусПроцентом / 100 * СуммаДокумента, 2);	
	КонецЕсли;
	
	//Возврат БонусыКВозврату;
	
	СтруктураВозврата.ДокументНАНБ = ДокументНАНБ;
	СтруктураВозврата.СуммаБонусов = БонусыКВозврату;
	Возврат СтруктураВозврата;
	
КонецФункции

// #13834
Функция ПодобратьДокументНастройкиНачисленияБонусов(ДатаРасчета, ПараметрыОтбора)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	ДанныеДокумента.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.НастройкаАвтоматическихНачисленийБонусов КАК ДанныеДокумента
	|ГДЕ
	|	ДанныеДокумента.Проведен
	|	И ДанныеДокумента.Дата < &ДатаРасчета
	|	И ДанныеДокумента.Организация = &Организация
	|	И ДанныеДокумента.ВидДокумента = &ВидДокумента
	|	И ДанныеДокумента.КатегорияКонтрагента = &КатегорияКонтрагента	
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДанныеДокумента.Дата УБЫВ";
	
	Запрос.УстановитьПараметр("ДатаРасчета", 			ДатаРасчета);
	Запрос.УстановитьПараметр("Организация", 			ПараметрыОтбора.Организация);
	Запрос.УстановитьПараметр("ВидДокумента", 			ПараметрыОтбора.ВидДокумента);
	Запрос.УстановитьПараметр("КатегорияКонтрагента", 	ПараметрыОтбора.КатегорияКонтрагента);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Документы.НастройкаАвтоматическихНачисленийБонусов.ПустаяСсылка();
	
КонецФункции

Функция СуммаБонусовКСписаниюПриИзменении(ДокОбъект, ВалютаУчета, ОстатокБонусов, ДоступноКСписанию, СуммаДокументаБезУчетаБонусов) Экспорт
	
	СтруктураВозврата = Новый Структура("ВыполненаОчистка, ВыполненоРаспределение, ВыполненПересчет", Ложь, Ложь, Ложь);
	
	Если ДокОбъект.СуммаБонусовКСписаниюПоДисконтнойКарте = 0 Тогда		
		ОчиститьСуммуБонусовПоСтрокамДокумента(ДокОбъект);
		СтруктураВозврата.ВыполненаОчистка = Истина;
		
	Иначе
		
		Отказ = Ложь;
		//Если ДокОбъект.СлужебныйВидБонуснойСистемы = ПредопределенноеЗначение("Перечисление.ВидыБонусныхСистем.Внутренняя") Тогда
			Если ДокОбъект.СуммаБонусовКСписаниюПоДисконтнойКарте > ДоступноКСписанию Тогда				
				Сообщить("Согласно настроек программы нельзя списать более " + ДоступноКСписанию + " " + ВалютаУчета + " бонусов по данному документу");
				ДокОбъект.СуммаБонусовКСписаниюПоДисконтнойКарте = 0;
				ОчиститьСуммуБонусовПоСтрокамДокумента(ДокОбъект);
				СтруктураВозврата.ВыполненаОчистка = Истина;
				Отказ = Истина;
			КонецЕсли;
		//КонецЕсли;	
		
		Если ДокОбъект.СуммаБонусовКСписаниюПоДисконтнойКарте > ОстатокБонусов Тогда				
			Сообщить("Остаток бонусов " + ОстатокБонусов + " " + ВалютаУчета + ", нельзя списать больше этой суммы");
			ДокОбъект.СуммаБонусовКСписаниюПоДисконтнойКарте = 0;
			ОчиститьСуммуБонусовПоСтрокамДокумента(ДокОбъект);
			СтруктураВозврата.ВыполненаОчистка = Истина;
			Отказ = Истина;
		КонецЕсли;		
		
		Если ДокОбъект.СуммаБонусовКСписаниюПоДисконтнойКарте > РаботаСВалютой.ПолучитьСуммуВВалютеУчетаПоДокументу(ДокОбъект.Ссылка, СуммаДокументаБезУчетаБонусов) Тогда			
			Сообщить("Сумма всего документа (в валюте учета) " + РаботаСВалютой.ПолучитьСуммуВВалютеУчетаПоДокументу(ДокОбъект.Ссылка, ДокОбъект.СуммаДокумента) + " " + ВалютаУчета + ", нельзя списать больше этой суммы");
			ДокОбъект.СуммаБонусовКСписаниюПоДисконтнойКарте = 0;
			ОчиститьСуммуБонусовПоСтрокамДокумента(ДокОбъект);
			СтруктураВозврата.ВыполненаОчистка = Истина;
			Отказ = Истина;
		КонецЕсли;
		
		Если НЕ Отказ Тогда			
			// распределяем скидку, пересчитываем строки и сумму документа
			РаспределитьСкидкуБонусамиПоСтрокамДокумента(ДокОбъект);			
			СтруктураВозврата.ВыполненоРаспределение = Истина;
			Возврат СтруктураВозврата;
		КонецЕсли;
		
	КонецЕсли;
	
	ПересчитатьБонусыПоДокументу(ДокОбъект);
	СтруктураВозврата.ВыполненПересчет = Истина;
	
	Возврат СтруктураВозврата;
	
КонецФункции

Функция ОстатокБонусов(Контрагент, Дата = Неопределено) Экспорт
		
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Дата", ?(Дата = Неопределено, Дата(3000,1,1), Новый Граница(Дата, ВидГраницы.Включая)));
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СУММА(БонусыКонтрагентовОстатки.СуммаОстаток) КАК СуммаОстаток
	|ИЗ
	|	РегистрНакопления.БонусыКонтрагентов.Остатки(&Дата, Контрагент = &Контрагент) КАК БонусыКонтрагентовОстатки";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Возврат Выборка.СуммаОстаток;
	КонецЦикла;
	
	Возврат 0;
	
КонецФункции

