Процедура Задачи_ЗаполнитьАдресацию(Контекст) Экспорт
    Задача = Контекст.Задача;
    #ЕСЛИ НЕ( Клиент или Сервер или ВнешнееСоединение ) Тогда
        Задача = Задачи.ИА_ЗадачаПланаДействий.СоздатьЗадачу();
    #КОНЕЦЕСЛИ
    
    Отв = Задача.ИА_ТочкаБП.Ответственный;
    
    Если ТипЗнч(Отв) = Тип("СправочникСсылка.ОргСхема") Тогда
        Задача.Пост = Отв;
        Задача.Пользователь = Неопределено;
    КонецЕсли;    
    
    
    Если Задача.ИА_ТочкаБП.Тип = Перечисления.ИА_БПТипыТочекМаршрута.ВложенныйБизнесПроцесс Тогда
    	Задача.Пост = Неопределено;
    КонецЕсли; 
КонецПроцедуры

