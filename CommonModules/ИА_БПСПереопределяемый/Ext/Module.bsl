Процедура ЗаполнитьОбщиеНастройкиБП(Контекст) Экспорт
    Если Метаданные.БизнесПроцессы.ИА_БПНоситель.Задача.Имя = "ИА_ЗадачаПланаДействий" Тогда
    	// Это КСУ
        Контекст.КСУ = Истина;
        Если ИА_БФКС.РеквизитЕсть(Константы, "ИА_НФИспользоватьТипыЗадач") Тогда
        	Контекст.ТипыЗадач         = Константы["ИА_НФИспользоватьТипыЗадач"].Получить();
        КонецЕсли; 
        Если ИА_БФКС.РеквизитЕсть(Константы, "ИА_НФИспользоватьДлительностьЗадач") Тогда
        	Контекст.ДлительностьЗадач = Константы["ИА_НФИспользоватьДлительностьЗадач"].Получить();
        КонецЕсли; 
    КонецЕсли; 
КонецПроцедуры

