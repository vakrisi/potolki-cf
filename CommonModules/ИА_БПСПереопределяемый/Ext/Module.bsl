Процедура Задачи_ПередЗаписьюНовой(Контекст) Экспорт    
    Задача = Контекст.Задача;
    #ЕСЛИ НЕ( Клиент или Сервер или ВнешнееСоединение ) Тогда
        Задача = Задачи.ИА_ЗадачаПланаДействий.СоздатьЗадачу();
    #КОНЕЦЕСЛИ
     
    Задача.Содержание = Задача.ИА_ТочкаБП.Описание;
    
    Если ИА_БФКС.РеквизитЕсть(Задача, "СодержаниеТекст") Тогда
    	Задача.СодержаниеТекст = Задача.ИА_ТочкаБП.Описание;
    КонецЕсли; 
    
    Если Задача.ИА_ТочкаБП.ЭтоУведомление Тогда
    	Задача.ЭтоПослание = Истина;
    КонецЕсли; 
    
    Задача.Отправлена = Истина;
КонецПроцедуры

