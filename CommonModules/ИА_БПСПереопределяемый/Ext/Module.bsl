Процедура Формы_Точка_Форма_ПриСозданииНаСервере(Контекст) Экспорт
	Элемент = Контекст.Форма.Элементы.Добавить("ВозвращатьАвторуНаПроверку", Тип("ПолеФормы"), Контекст.Форма.Элементы.ДополнительныеРеквизиты);
    Элемент.Вид = ВидПоляФормы.ПолеФлажка;
    Элемент.Заголовок = "Возвращать автору на проверку";
    Элемент.ПутьКДанным = "Объект.ВозвращатьАвторуНаПроверку";
		
КонецПроцедуры
 
