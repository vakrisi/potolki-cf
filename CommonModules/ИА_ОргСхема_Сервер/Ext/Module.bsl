Функция ПолучитьПредставлениеСотрудников(пТерминал, КолСот=0, ФотоСотрудника = Неопределено, П = Неопределено, Сотрудник2Фото = Неопределено, КэшДанных = Неопределено) Экспорт
	
	Рез = "";
	
	ЭтоПервый = Истина;
	
	Сотрудник2Фото = Новый Соответствие;
	
	ФотоСотрудника = Неопределено;
    
    Если КэшДанных = Неопределено Тогда
    	КэшДанных = ИА_Защита_Оргсхема.КэшДанных_Сформировать();
	КонецЕсли; 
	
    пТерминалСотрудники = КэшДанных_РеквизитПоста(КэшДанных, пТерминал, "Сотрудники");
	КолСот = пТерминалСотрудники.Количество();
	
	//ВыводитьФото = пТерминал.Фотографии;// ИА_ 20160225
	//ВыводитьФото = КэшДанных_РеквизитПоста(КэшДанных, пТерминал, "Фотографии");//ИА_ 20160630
	Для каждого стр из пТерминалСотрудники Цикл
		Если не ЭтоПервый Тогда
			Рез = Рез + Символы.ПС;
        КонецЕсли;
        
        Если НЕ КэшДанных.Свойство("КэшДанныхФизЛиц") Тогда
        	КэшДанных.Вставить("КэшДанныхФизЛиц", Новый Соответствие);
        КонецЕсли; 
        Данные = КэшДанных.КэшДанныхФизЛиц[стр.ФизЛицо];
        Если Данные = Неопределено Тогда
            //иа_ ФИО = стр.ФизЛицо.Наименование; // Сейчас нет смысла кэшировать, т.к. для получения "фото" все равно идет обращение к справочнику
			ФИО = КэшДанных_РеквизитФизЛица(КэшДанных, стр.ФизЛицо, "Наименование");
			
            ФИО = ИА_ОргСхема_СерверПовторИсп.ПолучитьИнициалыПоСтроке(ФИО);
			//Если ВыводитьФото Тогда
            	Фото = ИА_КСУОбщийСервер.ПолучитьФотоФизЛица(стр.ФизЛицо);	
			//Иначе
			//	фото=Неопределено;
			//КонецЕсли;
            Данные = Новый Структура("ФИО, Фото", ФИО, Фото);
            КэшДанных.КэшДанныхФизЛиц.Вставить(стр.ФизЛицо, Данные);
        КонецЕсли; 
        ФИО = Данные.ФИО;
        
        Если ФотоСотрудника = Неопределено Тогда
            ФотоСотрудника = Данные.Фото;
            //Сотрудник2Фото.Вставить(ФИО, ФотоСотрудника);
		КонецЕсли;
		Сотрудник2Фото.Вставить(ФИО, Данные.Фото);
		
		
		Рез = Рез + ФИО;
		ЭтоПервый = Ложь;
	КонецЦикла;
	
	Возврат Рез;
	
КонецФункции

Функция ПолучитьМассивФИО(ФИО)

	МассивФИО = Новый Массив;
	МассивФИО.Добавить("");
	МассивФИО.Добавить("");
	МассивФИО.Добавить("");
	
	МассивПодсток = РазложитьСтрокуВМассивПодстрок1(ФИО, " ");
	Для Индекс = 0 По МассивПодсток.ВГраница() Цикл
		Если Индекс < 3 Тогда
			МассивФИО[Индекс] = МассивПодсток[Индекс];
		Иначе
			МассивФИО[2] = МассивФИО[2] + " " + МассивПодсток[Индекс];
		КонецЕсли;
	КонецЦикла;

	Возврат МассивФИО;
	
КонецФункции // ПолучитьМассивФИО()

Функция РазложитьСтрокуВМассивПодстрок1(Строка, Разделитель = ",", ПропускатьПустыеСтроки = Неопределено) Экспорт
    Возврат ИА_ОргСхема_СерверПовторИсп.РазложитьСтрокуВМассивПодстрок1(Строка, Разделитель, ПропускатьПустыеСтроки); 
КонецФункции

Функция Ссылка2Стрктура(Ссылка, Поля) Экспорт 
	Д = Новый Структура(Поля);
	
	ЗаполнитьЗначенияСвойств(Д, Ссылка.ПолучитьОбъект());
	
	Для Каждого эл из Д Цикл
		Если ТипЗнч(эл.Значение) = Тип("ХранилищеЗначения") Тогда
			Д[эл.Ключ] = эл.Значение.Получить();
		КонецЕсли;
	КонецЦикла;
	
	Возврат Д;
КонецФункции
 
Функция КэшДанных_РеквизитПоста(Кэш, Пост, Имя) Экспорт
	ТЗ = Кэш.ОргСхема;
	
	НайдСтрока = ТЗ.Найти(Пост,"Ссылка");
	
	Если НайдСтрока <> Неопределено Тогда
		Результат = НайдСтрока[Имя];
	Иначе
		Результат = Пост[Имя];
	КонецЕсли; 
	
	Возврат Результат;
КонецФункции

Функция КэшДанных_РеквизитФизЛица(Кэш, ФизЛицо, Имя) Экспорт
	ТЗ = Кэш.ФизЛица;
	
	НайдСтрока = ТЗ.Найти(ФизЛицо,"Ссылка");
	
	Если НайдСтрока <> Неопределено Тогда
		Результат = НайдСтрока[Имя];
	Иначе
		Результат = ФизЛицо[Имя];
	КонецЕсли; 
	
	Возврат Результат;
КонецФункции
	
Функция КэшДанных_ПостыПоРодителю(Кэш, ПостРодителя) Экспорт
    М = Кэш.ОргСхема.НайтиСтроки(Новый Структура("Родитель, ПометкаУдаления",ПостРодителя,Ложь));		
    
    Результат = Кэш.ОргСхема.СкопироватьКолонки();
    Для каждого СтрокаТЗ Из М Цикл
    	ЗаполнитьЗначенияСвойств(Результат.Добавить(), СтрокаТЗ);
    КонецЦикла; 
    
    Результат.Сортировать("ПорядокВСхеме");
    Возврат Результат;
КонецФункции

Функция ПолучитьМинимальнуюВысотуБлока(Тест, Ширина, Шрифт) Экспорт
	Шрифт1 = ЗначениеИзСтрокиВнутр(Шрифт);
	
	Таб = Новый ТабличныйДокумент;
	об = Таб.Область("R1C1:R1C1");
	об.ШиринаКолонки = Ширина/1.852;
	об.Шрифт = Новый Шрифт(Шрифт1);
	об.РазмещениеТекста = ТипРазмещенияТекстаТабличногоДокумента.Переносить;
	об.Текст = Тест;
    Надпись = Таб.Рисунки.Добавить(ТипРисункаТабличногоДокумента.Текст);
    Надпись.Расположить(об); 
    Возврат Надпись.Высота;
КонецФункции	   

Процедура НарисоватьДерево(ос, строкаДерева, знач сдвигЛево, знач сдвигВерх, ПараметрыОргсхемы, МассивНарисованныхЭлементов, КэшДанных) Экспорт
	
	ШрифтПодписиСотрудника = ИА_ОргСхема_Сервер.ПолучитьШрифтПодписиСотрудника();
	ЭМ = ПараметрыОргсхемы.ЭМ;
	ЭтоДепартамент = строкаДерева.ТипТерминала = Перечисления.ТипТерминалаОргСхемы.Департамент;
	ЭтоРукСостав = строкаДерева.ТипТерминала = Перечисления.ТипТерминалаОргСхемы.РуководящийСостав;
	ЭтоУчредитель = строкаДерева.ТипТерминала = Перечисления.ТипТерминалаОргСхемы.Учредитель;
	ЭтоОтдел = строкаДерева.ТипТерминала = Перечисления.ТипТерминалаОргСхемы.Отдел;
	ЭтоСекция = строкаДерева.ТипТерминала = Перечисления.ТипТерминалаОргСхемы.Секция;
	ЭтоСектор = строкаДерева.ТипТерминала = Перечисления.ТипТерминалаОргСхемы.Сектор;
	ЭтоСотрудник = строкаДерева.ТипТерминала = Перечисления.ТипТерминалаОргСхемы.Сотрудник;
	ЭтоОрганизация = Перечисления.ТипТерминалаОргСхемы.Организация;
	СсылкаНаОрг = Справочники.ОргСхема.НайтиПоНаименованию(строкаДерева.Ссылка.Наименование);
	
	Если строкаДерева.ТипТерминала <> Перечисления.ТипТерминалаОргСхемы.Организация Тогда // По вложенной не рисуем		
		центрБлока = сдвигЛево + строкаДерева.ШиринаПодчиненных/2;	
		
		//ос.ВерхнийКолонтитул.ТекстВЦентре = 
		
		ТекстСекции = "";
		// отрисовка блока
		новБлок = ос.Рисунки.Добавить(ТипРисункаТабличногоДокумента.Текст);
		новБлок.Лево = ?(ЭтоУчредитель, сдвигЛево, центрБлока - строкаДерева.Ширина/2);
		
		
		Если ЭтоДепартамент Тогда
			верх =  ПараметрыОргсхемы.УровеньДепартаментов;
		Иначе
			верх = сдвигВерх;
		КонецЕсли;
		верх = верх - ?(ЭтоДепартамент И строкаДерева.ПоднятьВверх, ПараметрыОргсхемы.ПоднятиеСекции, 0);    
		
		// опускаем чайлдов департамента (оформление "Отдельно")   
		Если ПараметрыОргсхемы.ОформлениеОтдельно	И (ЭтоОтдел Или ЭтоСекция или ЭтоСектор Или ЭтоСотрудник) Тогда
			верх = верх + ПараметрыОргсхемы.расстояниеМеждуБлокамиВерт;
		КонецЕсли;
					
		новБлок.Верх = верх;
		новБлок.Ширина = строкаДерева.Ширина;
		
		// сужаем ширину департамента и смещаем его положение на центр (оформление "Отдельно") 
		Если ПараметрыОргсхемы.ОформлениеОтдельно И ЭтоДепартамент и не ЭМ Тогда
			новБлок.Ширина = строкаДерева.Ширина * 0.7; // 0.7 это 70% от реальной ширины при отображении отдельно
			новБлок.Лево = новБлок.Лево + строкаДерева.Ширина * 0.15; 
		КонецЕсли;
		
		новБлок.Высота = строкаДерева.Высота;
		новБлок.ВертикальноеПоложение = ВертикальноеПоложение.Центр;
		
		новБлок.Текст = строкаДерева.НаименованиеДляОргсхемы;
		Если ЭтоСекция или ЭтоСектор Тогда
			ТекстСекции = новБлок.Текст;
			Если ЭМ Тогда
				новБлок.Текст = "";
			Иначе
				новБлок.Текст = "ЦКП:" +Символы.ПС+ строкаДерева.ЦКП;
				новБлок.ВертикальноеПоложение = ВертикальноеПоложение.Низ;
			КонецЕсли;
		КонецЕсли;
		
		Если ЭтоСотрудник И (строкаДерева.ТипТерминалаРодителя = Перечисления.ТипТерминалаОргСхемы.Секция ИЛИ строкаДерева.ТипТерминалаРодителя = Перечисления.ТипТерминалаОргСхемы.Сектор) Тогда
			новБлок.ВертикальноеПоложение = ВертикальноеПоложение.Верх;
			новБлок.Линия = новый Линия(ТипЛинииРисункаТабличногоДокумента.Точечная); 
			новБлок.ГраницаСверху = истина;
			новБлок.ГраницаСлева = Ложь;
			новБлок.ГраницаСправа = Ложь;
			новБлок.ГраницаСнизу = Ложь;
			новБлок.ЦветЛинии = Новый Цвет(120,120,120);
			новБлок.Лево = новБлок.Лево + 1;
			новБлок.Ширина = новБлок.Ширина - 2;
		КонецЕсли;
		
		новБлок.ГоризонтальноеПоложение = ?(ЭтоСекция или ЭтоСектор, ГоризонтальноеПоложение.Лево, ГоризонтальноеПоложение.Центр);
		новБлок.РазмещениеТекста = ТипРазмещенияТекстаТабличногоДокумента.Переносить;
		
		ПараметрыОргсхемы.НижняяТочка = Макс(ПараметрыОргсхемы.НижняяТочка, новБлок.Верх + новБлок.Высота);
		
		шр = строкаДерева.Шрифт;
		Если шр<>Неопределено Тогда 
			новБлок.Шрифт = шр;
		Иначе
			новБлок.Шрифт = Новый Шрифт(новБлок.Шрифт, , , Истина);
		КонецЕсли;
		новБлок.Расшифровка = строкаДерева.Ссылка; // погарцев
		
		// толщина линии:
		Если ЭтоУчредитель Тогда
			новБлок.Линия = новый Линия(ТипЛинииРисункаТабличногоДокумента.Сплошная,3);
		ИначеЕсли ЭтоРукСостав Тогда
			новБлок.Линия = новый Линия(ТипЛинииРисункаТабличногоДокумента.Сплошная,2);
		КонецЕсли;
		
		// цвет блока
		цв = строкаДерева.ЦветФона;
		Если цв<>Неопределено Тогда
			новБлок.ЦветФона = цв;
		Иначе
			цв = Новый Цвет(255,255,255);
		КонецЕсли;

		// сохранение элементов для последующего анализа
		структураЭлемента = Новый Структура("Ссылка, ТипТерминала,Элемент, Лево, Верх, Ширина, Высота, ЦветФона, Шрифт, ЦКП, ВысотаПодчиненных, КоличествоПодчиненных");
		ЗаполнитьЗначенияСвойств(структураЭлемента, новБлок);
		структураЭлемента.ЦКП = строкаДерева.ЦКП;
		структураЭлемента.Элемент = ос.Рисунки.Индекс(новБлок); 
		структураЭлемента.Ссылка = строкаДерева.Ссылка;
		структураЭлемента.ТипТерминала = строкаДерева.ТипТерминала;
		структураЭлемента.ВысотаПодчиненных = строкаДерева.ВысотаПодчиненных;
		структураЭлемента.КоличествоПодчиненных = строкаДерева.Строки.Количество();
		
		МассивНарисованныхЭлементов.Добавить(структураЭлемента);
		строкаДерева.структураЭлемента = структураЭлемента;
		//
		
		Если ЭМ и (ЭтоСотрудник ИЛИ ЭтоСекция или ЭтоСекция) Тогда
			новБлок.ГоризонтальноеПоложение = ГоризонтальноеПоложение.Лево;
			новБлок.ГраницаСверху = Ложь;		
			новБлок.ГраницаСнизу = Ложь;
		КонецЕсли;
			
		Если ЭтоСекция или ЭтоСектор Тогда // Выведем отдельно заголовок
			новБлокСекция = ос.Рисунки.Добавить(ТипРисункаТабличногоДокумента.Текст);
			новБлокСекция.Лево = новБлок.Лево+1;
			новБлокСекция.Верх = новБлок.Верх+1;
			новБлокСекция.Ширина = новБлок.Ширина-2;
			новБлокСекция.Высота = строкаДерева.ВысотаЗаголовка;
			новБлокСекция.ВертикальноеПоложение = ВертикальноеПоложение.Верх;
			новБлокСекция.Текст = ТекстСекции; // это заголовок
			новБлокСекция.ГоризонтальноеПоложение = ГоризонтальноеПоложение.Центр;
			Если ЭМ Тогда
				новБлокСекция.ГоризонтальноеПоложение = ГоризонтальноеПоложение.Лево;
			КонецЕсли;
			новБлокСекция.РазмещениеТекста = ТипРазмещенияТекстаТабличногоДокумента.Переносить;
			
			

			шр = строкаДерева.Шрифт;
			Если строкаДерева.Шрифт<>Неопределено Тогда 
				Если эм Тогда
					новБлокСекция.Шрифт = Новый Шрифт(шр, , , Истина , Ложь, Ложь);
				Иначе
					новБлокСекция.Шрифт = Новый Шрифт(шр, , , ложь , Истина, Истина);
				КонецЕсли;
			Иначе
				Если эм Тогда
					новБлокСекция.Шрифт = Новый Шрифт(, , Истина, Ложь, Ложь);
				Иначе
					новБлокСекция.Шрифт = Новый Шрифт(, , ложь , Истина, Истина);
				КонецЕСли
			КонецЕсли;
					
			новБлокСекция.Расшифровка = строкаДерева.Ссылка;
			новБлокСекция.Линия = новый Линия(ТипЛинииРисункаТабличногоДокумента.Точечная);
			новБлокСекция.ГраницаСверху = ложь;
			новБлокСекция.ГраницаСлева = ложь;
			новБлокСекция.ГраницаСправа = ложь;
			новБлокСекция.ГраницаСнизу = истина;
			новБлокСекция.ЦветФона = цв;
		КонецЕсли;
		
		//Подпись руководителей
		КолСотр = 0; 
		ФотоСотрудника = Неопределено;
		Сотрудник2Фото = Новый Соответствие;
		ТекстРук = ИА_ОргСхема_Сервер.ПолучитьПредставлениеСотрудников(строкаДерева.Ссылка, КолСотр, ФотоСотрудника, ПараметрыОргсхемы, Сотрудник2Фото, КэшДанных);
		
		БлокФото = Неопределено;
		БазовыйБлок = Неопределено; // то, что под фотографией
		
		ЭМ_ВысотаНО = ПараметрыОргсхемы.ВысотаНО;
		
		// вывод сотрудников
		СдвинутьВниз = ЭМ и ЭтоОтдел;
		ВывестиАдминаСекции = ЭМ и ЭтоСекция;
		
		Если СдвинутьВниз И КолСотр = 0 Тогда
			БазовыйБлокНО = ос.Рисунки.Добавить(ТипРисункаТабличногоДокумента.Текст);
			ЗаполнитьЗначенияСвойств(БазовыйБлокНО, новБлок,,"ПараметрРасшифровки");
