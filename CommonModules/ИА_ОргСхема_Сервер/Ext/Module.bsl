			БазовыйБлокНО.ГоризонтальноеПоложение = ГоризонтальноеПоложение.Центр;
		КонецЕсли;
		
		Если ВывестиАдминаСекции Тогда
			БазовыйБлокАС = ос.Рисунки.Добавить(ТипРисункаТабличногоДокумента.Текст);
