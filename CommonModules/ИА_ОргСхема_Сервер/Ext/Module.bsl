						БазовыйБлокНО.узор = ТипУзораТабличногоДокумента.Сплошной;
						БазовыйБлокНО.ВертикальноеПоложение = ВертикальноеПоложение.Центр;
						Если строкаДерева.Ссылка.НаименованиеДолжности <> "" тогда
							ТекстРук = строкаДерева.Ссылка.НаименованиеДолжности + Символы.ПС + ТекстРук;
						Иначе				
							ТекстРук = "НАЧАЛЬНИК ОТДЕЛА"+ Символы.ПС + ТекстРук;
						КонецЕсли;					
						БазовыйБлокНО.Текст = ТекстРук;
						БазовыйБлокНО.ГоризонтальноеПоложение = ГоризонтальноеПоложение.Центр;
						БазовыйБлокНО.РазмещениеТекста = ТипРазмещенияТекстаТабличногоДокумента.Переносить;
						БазовыйБлокНО.Расшифровка = строкаДерева.Ссылка;
					Иначе
						ВысотаБлока = ИА_ОргСхема_Сервер.ПолучитьМинимальнуюВысотуБлока(ТекстРук, новБлок.Ширина-2, ЗначениеВСтрокуВнутр(ШрифтПодписиСотрудника));
						новБлокРук = ос.Рисунки.Добавить(ТипРисункаТабличногоДокумента.Текст);
						новБлокРук.Лево = новБлок.Лево+1;
						новБлокРук.Верх = новБлок.Верх + новБлок.Высота - ВысотаБлока - 1; 
						новБлокРук.Ширина = новБлок.Ширина-2;
						новБлокРук.Высота = ВысотаБлока;
						новБлокРук.ВертикальноеПоложение = ВертикальноеПоложение.Центр;
						новБлокРук.Текст = ТекстРук;
						новБлокРук.ГоризонтальноеПоложение = ГоризонтальноеПоложение.Центр;
						новБлокРук.РазмещениеТекста = ТипРазмещенияТекстаТабличногоДокумента.Переносить;
						
						новБлокРук.Расшифровка = строкаДерева.Ссылка;
						новБлокРук.Линия = новый Линия(ТипЛинииРисункаТабличногоДокумента.НетЛинии);
						новБлокРук.ЦветФона = цв;
						новБлокРук.Шрифт = Новый Шрифт(ШрифтПодписиСотрудника);
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	// найдем максимальную высоту текущего уровня. для дальнейшей отрисовки подчиненных элементов
	Если ЭтоРукСостав ТОгда
		максВысота = ПараметрыОргсхемы.МаксВысотаРукСостав;
	ИначеЕсли ЭтоДепартамент ТОгда
		максВысота = ПараметрыОргсхемы.МаксВысотаДепартаменты;
	ИначеЕсли ЭтоОтдел ТОгда
		максВысота = ПараметрыОргсхемы.МаксВысотаОтделы;
	Иначе
		максВысота = строкаДерева.Высота;
	КонецЕсли;
	
	// линии:
	КолЧайлдов = строкаДерева.Строки.Количество();
		
	// рисование подчиненных. Вычисление их сдвига по вертикали
	Если ЭтоОтдел Тогда 
		св = сдвигВерх + максВысота + ПараметрыОргсхемы.расстояниеМеждуСекциями;	
		Если ЭМ Тогда
			св = св + ПараметрыОргсхемы.расстояниеПодОтделом + ЭМ_ВысотаНО; // доп сотрудник
		КонецЕсли;
	ИначеЕсли ЭтоДепартамент Тогда 
		св = ПараметрыОргсхемы.УровеньДепартаментов + строкаДерева.Высота - ?(строкаДерева.ПоднятьВверх, ПараметрыОргсхемы.ПоднятиеСекции,0);
	ИначеЕсли ЭтоСекция Тогда
		св = сдвигВерх + строкаДерева.ВысотаЗаголовка + ПараметрыОргсхемы.ВысотаСотрудника * КолСотр + 3;
		//св = сдвигВерх + строкаДерева.Высота + 3;
		//св = сдвигВерх + строкаДерева.ВысотаЗаголовка + 2;
	ИначеЕсли ЭтоСектор Тогда
		св = сдвигВерх + строкаДерева.ВысотаЗаголовка + ПараметрыОргсхемы.ВысотаСотрудника * КолСотр + 3;
	ИначеЕсли ЭтоСотрудник Тогда
		св = сдвигВерх + строкаДерева.Высота;
	ИначеЕсли ЭтоРукСостав Тогда
		св = сдвигВерх + максВысота + ПараметрыОргсхемы.расстояниеМеждуБлокамиВерт;
	Иначе
		св = сдвигВерх + максВысота + ПараметрыОргсхемы.расстояниеМеждуБлокамиВерт;
	КонецЕсли;
	
	сч = 0;
	св1 = св;
	сдвигЛево1 = сдвигЛево;
	Для каждого стр из строкаДерева.Строки Цикл
		стрЭтоДепартамент = стр.ТипТерминала = ПредопределенноеЗначение("Перечисление.ТипТерминалаОргСхемы.Департамент");
		стрЭтоРукСостав = стр.ТипТерминала = ПредопределенноеЗначение("Перечисление.ТипТерминалаОргСхемы.РуководящийСостав");
		стрЭтоУчредитель = стр.ТипТерминала = ПредопределенноеЗначение("Перечисление.ТипТерминалаОргСхемы.Учредитель");
		стрЭтоОтдел = стр.ТипТерминала = ПредопределенноеЗначение("Перечисление.ТипТерминалаОргСхемы.Отдел");
		стрЭтоСекция = стр.ТипТерминала = ПредопределенноеЗначение("Перечисление.ТипТерминалаОргСхемы.Секция");
		стрЭтоСектор = стр.ТипТерминала = ПредопределенноеЗначение("Перечисление.ТипТерминалаОргСхемы.Сектор");
		стрЭтоСотрудник = стр.ТипТерминала = ПредопределенноеЗначение("Перечисление.ТипТерминалаОргСхемы.Сотрудник");
		
		НарисоватьДерево(ос, стр, сдвигЛево1, св1, ПараметрыОргсхемы, МассивНарисованныхЭлементов, КэшДанных);	
		
		Если НЕ (стрЭтоСотрудник ИЛИ стрЭтоСекция или стрЭтоСектор) Тогда
			сдвигЛево1 = сдвигЛево1 + стр.ШиринаПодчиненных;
		КонецЕсли;
		
		Если стрЭтоДепартамент или стрЭтоРукСостав Тогда
			сдвигЛево1 = сдвигЛево1 + ПараметрыОргсхемы.расстояниеМеждуБлоками;
		КонецЕсли;
		
		//эм
		Если стрЭтоОтдел и ЭМ Тогда
			сдвигЛево1 = сдвигЛево1 + ПараметрыОргсхемы.расстояниеМеждуОтделами;
		КонецЕсли;
		
		
		Если стрЭтоСотрудник Тогда
			св1 = св1 + стр.Высота;
		ИначеЕсли стрЭтоСекция или стрЭтоСектор Тогда
			св1 = св1 + стр.Высота + ПараметрыОргсхемы.расстояниеМеждуСекциями;
		КонецЕсли;
				
		сч = сч + 1;
	КонецЦикла;
		
	Если ЭтоУчредитель И строкаДерева.Ссылка.Родитель.Фотографии Тогда
		Организация = строкаДерева.Ссылка.Родитель;
				
		БлокФото = ос.Рисунки.Добавить(ТипРисункаТабличногоДокумента.Картинка);
		БлокФото.Линия = новый Линия(ТипЛинииРисункаТабличногоДокумента.Сплошная, 0);

		БлокФото.Высота = 30;
		БлокФото.Ширина = 30;
		Попытка
			Картинка = Новый Картинка(Организация.Логотип.Получить());
			БлокФото.Картинка = Картинка;
		исключение
			Сообщить("Не удалось получить логотип организации!");
		КонецПопытки;
		БлокФото.Верх = сдвигВерх;
		БлокФото.Лево = строкаДерева.ШиринаПодчиненных - БлокФото.Ширина;
		БлокФото.РазмерКартинки = РазмерКартинки.Пропорционально;
		
		БлокЗаголовок = ос.Рисунки.Добавить(ТипРисункаТабличногоДокумента.Текст);
		БлокЗаголовок.Линия = новый Линия(ТипЛинииРисункаТабличногоДокумента.Сплошная, 0);

		им1 = ос.ВерхнийКолонтитул.Шрифт.Имя;
		НШрифт = новый Шрифт(им1,"14",истина,ложь,ложь,ложь,100);
		ос.ВерхнийКолонтитул.Шрифт = НШрифт;

		// отображение заголовка на ОРГСХЕМЕ
		//БлокЗаголовок.Высота = 20;
		//БлокЗаголовок.Ширина = 150;
		//БлокЗаголовок.Текст = "ОРГАНИЗУЮЩАЯ СХЕМА КОМПАНИИ " + строкаДерева.Ссылка.Родитель;
		//БлокЗаголовок.Шрифт = НШрифт;
		//БлокЗаголовок.Верх = сдвигВерх;
		//БлокЗаголовок.Лево = ос.ШиринаСтраницы + 75;

	КонецЕсли;
		
КонецПроцедуры

Процедура НарисоватьЛинии(ос, строкаДерева, ПараметрыОргсхемы) Экспорт
	
	Если строкаДерева.ТипТерминала = ПредопределенноеЗначение("Перечисление.ТипТерминалаОргСхемы.Организация") Тогда
		Для каждого стр из строкаДерева.Строки Цикл
			НарисоватьЛинии(ос, стр, ПараметрыОргсхемы);
		КонецЦикла;
		возврат;
	КонецЕсли;
	
	Если ПараметрыОргсхемы.ОформлениеОтдельно Тогда 
		
		Если не (строкаДерева.ТипТерминала = Перечисления.ТипТерминалаОргСхемы.Учредитель
			Или строкаДерева.ТипТерминала = Перечисления.ТипТерминалаОргСхемы.Департамент 
			Или (строкаДерева.ТипТерминала = Перечисления.ТипТерминалаОргСхемы.Отдел и ПараметрыОргсхемы.ЭМ) 
			ИЛИ строкаДерева.ТипТерминала = Перечисления.ТипТерминалаОргСхемы.РуководящийСостав) Тогда
			Возврат;
		КонецЕсли;
		
	Иначе 
		
		Если не (строкаДерева.ТипТерминала = Перечисления.ТипТерминалаОргСхемы.Учредитель
			ИЛИ строкаДерева.ТипТерминала = Перечисления.ТипТерминалаОргСхемы.РуководящийСостав) Тогда
			Возврат;
		КонецЕсли;
	
	КонецЕсли;
	
			
	серединаЭлемента = строкаДерева.структураЭлемента.Лево + строкаДерева.структураЭлемента.Ширина/2;
	НизЭлемента = строкаДерева.структураЭлемента.Верх + строкаДерева.структураЭлемента.Высота;
		
	Если строкаДерева.ТипТерминала = Перечисления.ТипТерминалаОргСхемы.Отдел и ПараметрыОргсхемы.ЭМ Тогда
		
		//линия вниз 
		новЛиния = ос.Рисунки.Добавить(ТипРисункаТабличногоДокумента.Прямая);
		новЛиния.Лево = серединаЭлемента;
		новЛиния.Верх = НизЭлемента; 
		новЛиния.Ширина = 0;
		новЛиния.Высота = ПараметрыОргсхемы.расстояниеПодОтделом;
	
		возврат;
	КонецЕсли;
	
	КолЧайлдов = строкаДерева.Строки.Количество();
	Если КолЧайлдов = 0 Тогда
		возврат;
	КонецЕсли;

	ПоследнийЧайлд = строкаДерева.Строки[КолЧайлдов-1];
	ПервыйЧайлд = строкаДерева.Строки[0];

	
	//линия вниз (1/2) 
	новЛиния = ос.Рисунки.Добавить(ТипРисункаТабличногоДокумента.Прямая);
	новЛиния.Лево = серединаЭлемента;
	новЛиния.Верх = НизЭлемента; 
	новЛиния.Ширина = 0;
	новЛиния.Высота = ПараметрыОргсхемы.расстояниеМеждуБлокамиВерт/2;
	
	//горизонтальная вправо
	ШирГорЛин = ПоследнийЧайлд.структураЭлемента.Лево + ПоследнийЧайлд.структураЭлемента.Ширина/2 - серединаЭлемента; 
	Если ШирГорЛин > 0 Тогда
		новЛиния = ос.Рисунки.Добавить(ТипРисункаТабличногоДокумента.Прямая);
		новЛиния.Лево = серединаЭлемента;
		новЛиния.Верх = НизЭлемента + ПараметрыОргсхемы.расстояниеМеждуБлокамиВерт/2; 
		новЛиния.Ширина = ШирГорЛин;
		новЛиния.Высота = 0;
	КонецЕсли;
	
	//горизонтальная влево
	ШирГорЛин = серединаЭлемента - (ПервыйЧайлд.структураЭлемента.Лево + ПервыйЧайлд.структураЭлемента.Ширина/2); 
	Если ШирГорЛин > 0 Тогда
		новЛиния = ос.Рисунки.Добавить(ТипРисункаТабличногоДокумента.Прямая);
		новЛиния.Лево = ПервыйЧайлд.структураЭлемента.Лево + ПервыйЧайлд.структураЭлемента.Ширина/2;
		новЛиния.Верх = НизЭлемента + ПараметрыОргсхемы.расстояниеМеждуБлокамиВерт/2; 
		новЛиния.Ширина = ШирГорЛин;
		новЛиния.Высота = 0;
	КонецЕсли;
	
	Для каждого стр из строкаДерева.Строки Цикл
		//вверх от каждого чайлда
		новЛиния = ос.Рисунки.Добавить(ТипРисункаТабличногоДокумента.Прямая);
		новЛиния.Лево = стр.структураЭлемента.Лево + стр.структураЭлемента.Ширина/2;
		новЛиния.Верх = НизЭлемента + ПараметрыОргсхемы.расстояниеМеждуБлокамиВерт/2; 
		новЛиния.Ширина = 0;
		новЛиния.Высота = стр.структураЭлемента.Верх - новЛиния.Верх;
	
		НарисоватьЛинии(ос, стр, ПараметрыОргсхемы);
	КонецЦикла;
КонецПроцедуры

Процедура НарисоватьЦКП(Организация, ос, ПараметрыОргсхемы, МассивНарисованныхЭлементов, КэшДанных) Экспорт
	ВысотаЦКП_Департамент = ПараметрыОргсхемы.ВысотаЦКП_Департамент;
	ВысотаЦКП_Отдел       = ПараметрыОргсхемы.ВысотаЦКП_Отдел;
	ВысотаЦКП_Орг         = ПараметрыОргсхемы.ВысотаЦКП_Орг;
	
	
	// отделы
	ЛеваяГраница = 1000;
	ПраваяГраница = 0;
	ПараметрыОргсхемы.НижняяТочка = ПараметрыОргсхемы.НижняяТочка + 3;
	
	для каждого стр из МассивНарисованныхЭлементов Цикл
		ЛеваяГраница = Мин(ЛеваяГраница, стр.Лево);
		ПраваяГраница = Макс(ПраваяГраница, стр.Лево + стр.Ширина);
		
		Если стр.ТипТерминала = Перечисления.ТипТерминалаОргСхемы.Отдел Тогда
			новБлок = ос.Рисунки.Добавить(ТипРисункаТабличногоДокумента.Текст);
			новБлок.Лево = стр.Лево;
			новБлок.Верх = ПараметрыОргсхемы.НижняяТочка; 
			новБлок.Ширина = стр.Ширина;
			новБлок.Высота = ВысотаЦКП_Отдел;
			новБлок.Текст = "ЦКП: " + стр.ЦКП;
			новБлок.ВертикальноеПоложение = ВертикальноеПоложение.Центр;
			новБлок.ГоризонтальноеПоложение = ГоризонтальноеПоложение.Центр;
			новБлок.РазмещениеТекста = ТипРазмещенияТекстаТабличногоДокумента.Переносить;
			новБлок.Расшифровка = стр.Ссылка;
			// цвет блока
			цв = стр.ЦветФона;
			Если цв<>Неопределено Тогда
				новБлок.ЦветФона = цв;
			КонецЕсли;
			
			шр = стр.Шрифт;
			Если шр<>Неопределено Тогда 
				новБлок.Шрифт = шр;
			Иначе
				новБлок.Шрифт = Новый Шрифт(шр, , , Истина);
			КонецЕсли;
			
			// заливка оставшейся области
			ДопОтступыСекции = стр.КоличествоПодчиненных * ПараметрыОргсхемы.расстояниеМеждуСекциями;  
			новЗаливка = ос.Рисунки.Добавить(ТипРисункаТабличногоДокумента.Прямоугольник);
			новЗаливка.Лево = стр.Лево;
			новЗаливка.Верх = стр.Верх + стр.ВысотаПодчиненных + стр.Высота + ДопОтступыСекции  + ?(ПараметрыОргсхемы.ЭМ,ПараметрыОргсхемы.расстояниеПодОтделом+ПараметрыОргсхемы.ВысотаНО,0); 
			новЗаливка.Ширина = стр.Ширина;
			новЗаливка.Высота = ПараметрыОргсхемы.НижняяТочка - стр.Верх - стр.ВысотаПодчиненных - стр.Высота - ДопОтступыСекции - ?(ПараметрыОргсхемы.ЭМ,ПараметрыОргсхемы.расстояниеПодОтделом+ПараметрыОргсхемы.ВысотаНО,0);
			Если цв<>Неопределено Тогда
				новЗаливка.ЦветФона = цв;
			КонецЕсли;
			новЗаливка.ГраницаСверху = Ложь;		
		КонецЕсли;
	КонецЦикла;
	
	ПараметрыОргсхемы.НижняяТочка = ПараметрыОргсхемы.НижняяТочка + ВысотаЦКП_Отдел;
	
	// отделения (департаменты)
	для каждого стр из МассивНарисованныхЭлементов Цикл
		Если стр.ТипТерминала = Перечисления.ТипТерминалаОргСхемы.Департамент Тогда
			новБлок = ос.Рисунки.Добавить(ТипРисункаТабличногоДокумента.Текст);
			
			Если ПараметрыОргсхемы.ОформлениеОтдельно Тогда //расширяем ЦКП до ширины всех отделов в сумме 
				Лево = 5000000000;
				Ширина = 0;
				Для каждого элем Из МассивНарисованныхЭлементов Цикл
					
					ТекРодит = ИА_ОргСхема_Сервер.КэшДанных_РеквизитПоста(КэшДанных, элем.ссылка, "Родитель");
					Если ТекРодит = стр.Ссылка 
						И элем.ТипТерминала = ПредопределенноеЗначение("Перечисление.ТипТерминалаОргСхемы.Отдел") Тогда
						Ширина = Окр(Ширина + элем.Ширина, 0, 1);
						Лево = Мин(Лево, элем.Лево);
					КонецЕсли;	
					
				КонецЦикла;	
				новБлок.Лево = Лево;
				Если ПараметрыОргсхемы.ЭМ Тогда					
					новБлок.Ширина = Ширина + ПараметрыОргсхемы.расстояниеМеждуОтделами*(стр.КоличествоПодчиненных-1);		
				Иначе
					новБлок.Ширина = Ширина;
				КонецЕсли;
				
			Иначе
				новБлок.Лево = стр.Лево;
				новБлок.Ширина = стр.Ширина;
			КонецЕсли;
			
			новБлок.Верх = ПараметрыОргсхемы.НижняяТочка + ?(ПараметрыОргсхемы.ЭМ,4,0); 
			новБлок.Высота = ВысотаЦКП_Департамент;
			новБлок.Текст = "ЦКП: " + стр.ЦКП;
			новБлок.ВертикальноеПоложение = ВертикальноеПоложение.Центр;
			новБлок.ГоризонтальноеПоложение = ГоризонтальноеПоложение.Центр;
			новБлок.РазмещениеТекста = ТипРазмещенияТекстаТабличногоДокумента.Переносить;
			новБлок.Расшифровка = стр.Ссылка;
			// цвет блока
			цв = стр.ЦветФона;
			Если цв<>Неопределено Тогда
				новБлок.ЦветФона = цв;
			КонецЕсли;
			
			шр = стр.Шрифт;
			Если шр<>Неопределено Тогда 
				новБлок.Шрифт = шр;
			Иначе
				новБлок.Шрифт = Новый Шрифт(шр, , , Истина);
			КонецЕсли;

		КонецЕсли;
	КонецЦикла;
	
	ПараметрыОргсхемы.НижняяТочка = ПараметрыОргсхемы.НижняяТочка + ВысотаЦКП_Департамент + 4 + ?(ПараметрыОргсхемы.ЭМ,4,0);
	
	// цкп организации
	Если не Организация.ЭтоВложеннаяОргсхема Тогда 
		новБлок = ос.Рисунки.Добавить(ТипРисункаТабличногоДокумента.Текст);
		новБлок.Лево = ЛеваяГраница;
		новБлок.Ширина = ПраваяГраница - ЛеваяГраница;
		новБлок.Верх = ПараметрыОргсхемы.НижняяТочка; 	
		новБлок.Высота = ВысотаЦКП_Орг;
		новБлок.Текст = "ЦКП: " + Организация.ЦКП;
		новБлок.ВертикальноеПоложение = ВертикальноеПоложение.Центр;
		новБлок.ГоризонтальноеПоложение = ГоризонтальноеПоложение.Центр;
		новБлок.РазмещениеТекста = ТипРазмещенияТекстаТабличногоДокумента.Переносить;
		новБлок.Расшифровка = Организация.Ссылка;
		// цвет блока
		цв = Организация.ЦветФона;
		Если цв<>Неопределено Тогда
			новБлок.ЦветФона = цв;
		КонецЕсли;
		
		шр = Организация.Шрифт;
		Если шр<>Неопределено Тогда 
			новБлок.Шрифт = шр;
		Иначе
			новБлок.Шрифт = Новый Шрифт(шр, , , Истина);
		КонецЕсли;
	КонецЕсли;
	
	
КонецПроцедуры

Процедура ЗаполнитьДерево(строкаДерева, П, КэшДанных = Неопределено) Экспорт
			
	ЭтоДепартамент = строкаДерева.ТипТерминала = Перечисления.ТипТерминалаОргСхемы.Департамент;
	ЭтоРукСостав = строкаДерева.ТипТерминала = Перечисления.ТипТерминалаОргСхемы.РуководящийСостав;
	ЭтоУчредитель = строкаДерева.ТипТерминала = Перечисления.ТипТерминалаОргСхемы.Учредитель;
	ЭтоОтдел = строкаДерева.ТипТерминала = Перечисления.ТипТерминалаОргСхемы.Отдел;
	ЭтоСекция = строкаДерева.ТипТерминала = Перечисления.ТипТерминалаОргСхемы.Секция;
	ЭтоСектор = строкаДерева.ТипТерминала = Перечисления.ТипТерминалаОргСхемы.Сектор;
	ЭтоСотрудник = строкаДерева.ТипТерминала = Перечисления.ТипТерминалаОргСхемы.Сотрудник;
	
	ширинаПодч = 0;
	ВысотаПодч = 0;
    
    Если КэшДанных = Неопределено Тогда
    	КэшДанных = ИА_Защита_Оргсхема.КэшДанных_Сформировать();
    КонецЕсли; 
    ТЗ_Выборка = ИА_ОргСхема_Сервер.КэшДанных_ПостыПоРодителю(КэшДанных, строкаДерева.Ссылка);
    
	КолПодч = 0;
    Для каждого Выборка Из ТЗ_Выборка Цикл
		
		Новстр = ДобавитьСтрокуВДерево(строкаДерева.Строки);
		
		Новстр.Ссылка = Выборка.Ссылка;
		Новстр.ТипТерминала = Выборка.ТипТерминала;

		ТекРодитель = ИА_ОргСхема_Сервер.КэшДанных_РеквизитПоста(КэшДанных, Выборка.Ссылка, "Родитель");
		Новстр.ТипТерминалаРодителя = ИА_ОргСхема_Сервер.КэшДанных_РеквизитПоста(КэшДанных, ТекРодитель, "ТипТерминала");
		Новстр.Ширина = Выборка.Ширина;
		
		Если Новстр.ТипТерминала = Перечисления.ТипТерминалаОргСхемы.РуководящийСостав ТОгда
			Новстр.Высота = П.МаксВысотаРукСостав;
		ИначеЕсли Новстр.ТипТерминала = Перечисления.ТипТерминалаОргСхемы.Департамент ТОгда
			Новстр.Высота = П.МаксВысотаДепартаменты;
		ИначеЕсли Новстр.ТипТерминала = Перечисления.ТипТерминалаОргСхемы.Отдел ТОгда
			Новстр.Высота = П.МаксВысотаОтделы;
		Иначе
			Новстр.Высота = Выборка.Высота;
		КонецЕсли;

		Новстр.Фотографии = Выборка.Фотографии;
		Новстр.НаименованиеДляОргсхемы = Выборка.НаименованиеДляОргсхемы;
		Новстр.Шрифт = Выборка.Шрифт.Получить();
		Новстр.ЦветФона = Выборка.ЦветФона.Получить();
		Новстр.ПоднятьВверх = Выборка.ПоднятьВверх;
		Новстр.ЦКП = Выборка.ЦКП;
		
		
		ЗаполнитьДерево(Новстр, П, КэшДанных);
		ширинаПодч = ширинаПодч + Новстр.ШиринаПодчиненных; 
		ВысотаПодч = ВысотаПодч + Новстр.Высота + ?(Новстр.ТипТерминала = Перечисления.ТипТерминалаОргСхемы.Секция или Новстр.ТипТерминала = Перечисления.ТипТерминалаОргСхемы.Сектор, 0, Новстр.ВысотаПодчиненных); 
		КолПодч = КолПодч + 1;
	КонецЦикла;
    
    строкаДерева.ШиринаПодчиненных = ?(ширинаПодч=0, ИА_ОргСхема_Сервер.КэшДанных_РеквизитПоста(КэшДанных, строкаДерева.Ссылка, "Ширина"), ширинаПодч); 
	
	строкаДерева.ВысотаПодчиненных = ВысотаПодч; 
	
	Если ЭтоРукСостав ТОгда
		строкаДерева.Высота = П.МаксВысотаРукСостав;
	ИначеЕсли ЭтоДепартамент ТОгда
		строкаДерева.Высота = П.МаксВысотаДепартаменты;
	ИначеЕсли ЭтоОтдел ТОгда
		строкаДерева.Высота = П.МаксВысотаОтделы;
    Иначе
        строкаДерева.Высота = ИА_ОргСхема_Сервер.КэшДанных_РеквизитПоста(КэшДанных, строкаДерева.Ссылка, "Высота");
	КонецЕсли;

    строкаДерева.ВысотаЗаголовка = ИА_ОргСхема_Сервер.КэшДанных_РеквизитПоста(КэшДанных, строкаДерева.Ссылка, "ВысотаЗаголовка");
    стрДереваСсылкаШирина = ИА_ОргСхема_Сервер.КэшДанных_РеквизитПоста(КэшДанных, строкаДерева.Ссылка, "Ширина");
	

	Если ЭтоДепартамент Тогда
		Если П.ЭМ И КолПодч > 0 Тогда
			строкаДерева.ШиринаПодчиненных = строкаДерева.ШиринаПодчиненных + П.расстояниеМеждуОтделами*(КолПодч-1);	
		КонецЕсли;
		строкаДерева.Ширина = ?(ширинаПодч=0, стрДереваСсылкаШирина, строкаДерева.ШиринаПодчиненных);		
	ИначеЕсли ЭтоСотрудник Тогда
		строкаДерева.Ширина = стрДереваСсылкаШирина;
		строкаДерева.ШиринаПодчиненных = строкаДерева.Ширина;
	ИначеЕсли ЭтоСекция или ЭтоСектор или ЭтоОтдел Тогда
		строкаДерева.Ширина = стрДереваСсылкаШирина;
		строкаДерева.ШиринаПодчиненных = строкаДерева.Ширина;
	ИначеЕсли ЭтоРукСостав И КолПодч > 0 Тогда
		строкаДерева.ШиринаПодчиненных = строкаДерева.ШиринаПодчиненных + П.расстояниеМеждуБлоками*(КолПодч-1);	
	КонецЕсли;
КонецПроцедуры

Процедура ПостроитьОС(ОрганизацияСсылка, ТабДокОргСхемаХранилище, МассивНарисованныхЭлементовХранилище, РасшифровкиРисунков) Экспорт
	Если ОрганизацияСсылка.ПометкаУдаления Тогда
		Сообщить("Организация помечена на удаление! Выберите другую.");
		Возврат;
	КонецЕсли;	
	
	Если ТипЗнч(ТабДокОргСхемаХранилище) = Тип("ХранилищеЗначения") Тогда
		ТабДокОргСхема = ТабДокОргСхемаХранилище.Получить();
	Иначе
		ТабДокОргСхема = ТабДокОргСхемаХранилище;
	КонецЕсли;
	
	Если ТипЗнч(МассивНарисованныхЭлементовХранилище) = Тип("ХранилищеЗначения") Тогда
		МассивНарисованныхЭлементов = МассивНарисованныхЭлементовХранилище.Получить();
	Иначе
		МассивНарисованныхЭлементов = МассивНарисованныхЭлементовХранилище;
	КонецЕсли;	
	
	ПараметрыОргсхемы = ИА_Защита_Оргсхема.ПараметрыОргСхемы(ОрганизацияСсылка);
	ПараметрыОргсхемы.НижняяТочка = 0;           
	Дерево = СтруктураСтрокиДерева();
	КэшДанных = ИА_Защита_Оргсхема.КэшДанных_Сформировать();
	
	Начало = ИА_Защита_Оргсхема.ПолучитьПервыйЭлементОргсхемы(ОрганизацияСсылка);	
	Если Начало = Неопределено Тогда
		Сообщить("Не найдена оргсхема!");
		Возврат;
	КонецЕсли;
	Начало.Шрифт = Начало.Шрифт.Получить();
	Начало.ЦветФона = Начало.ЦветФона.Получить();	
    
	// заполнение дерева
	Новстр = ДобавитьСтрокуВДерево(Дерево.Строки);
	ЗаполнитьЗначенияСвойств(Новстр, Начало);
	
	ЗаполнитьДерево(НовСтр, ПараметрыОргсхемы, КэшДанных);
	
	// вычислим уровень департаментов
	дерВрем = Новый ХранилищеЗначения(Дерево);
	ПараметрыОргсхемы.УровеньДепартаментов = ИА_Защита_Оргсхема.НайтиГлубинуДепартаментов(дерВрем, ПараметрыОргсхемы, ОрганизацияСсылка);

	
	// рисование
	МассивНарисованныхЭлементов = Новый Массив;
	НарисоватьДерево(ТабДокОргСхема, Новстр, ПараметрыОргсхемы.пОтступСлева, ПараметрыОргсхемы.пОтступСверху, ПараметрыОргсхемы, МассивНарисованныхЭлементов, КэшДанных);
	
	НарисоватьЛинии(ТабДокОргСхема, НовСтр, ПараметрыОргсхемы);
	НарисоватьЦКП(ИА_ОргСхема_Сервер.Ссылка2Стрктура(ОрганизацияСсылка,"ЦКП, Шрифт, ЦветФона, Ссылка, ЭтоВложеннаяОргсхема"), ТабДокОргСхема, ПараметрыОргсхемы, МассивНарисованныхЭлементов,КэшДанных);
	
	//ТабДокОргСхемаХранилище = Новый ХранилищеЗначения(ТабДокОргСхема);
	//МассивНарисованныхЭлементовХранилище = Новый ХранилищеЗначения(МассивНарисованныхЭлементов);
	
	Если ТипЗнч(ТабДокОргСхемаХранилище) = Тип("ХранилищеЗначения") Тогда
		ТабДокОргСхемаХранилище = Новый ХранилищеЗначения(ТабДокОргСхема);
	Иначе
		ТабДокОргСхемаХранилище = ТабДокОргСхема;
	КонецЕсли;
	
	Если ТипЗнч(МассивНарисованныхЭлементовХранилище) = Тип("ХранилищеЗначения") Тогда
		МассивНарисованныхЭлементовХранилище = Новый ХранилищеЗначения(МассивНарисованныхЭлементов);
	Иначе
		МассивНарисованныхЭлементовХранилище = МассивНарисованныхЭлементов;
	КонецЕсли;

КонецПроцедуры

Функция ДобавитьСтрокуВДерево(Строки) Экспорт
	
	Строки.Добавить(СтруктураСтрокиДерева());
	Возврат Строки[Строки.ВГраница()];
	
КонецФункции

Функция СтруктураСтрокиДерева()
	Д = Новый Структура;
	
	Д.Вставить("Ссылка");
	Д.Вставить("Ширина");
	Д.Вставить("Высота");
	Д.Вставить("ВысотаЗаголовка");
	Д.Вставить("ШиринаПодчиненных");
	Д.Вставить("ВысотаПодчиненных");
	Д.Вставить("СтруктураЭлемента");
	Д.Вставить("ТипТерминала");
	Д.Вставить("ТипТерминалаРодителя");
	Д.Вставить("НаименованиеДляОргсхемы");
	Д.Вставить("Шрифт");
	Д.Вставить("ЦветФона");
	Д.Вставить("Фотографии");
	Д.Вставить("ПоднятьВверх");
	Д.Вставить("ЦКП");
	
	
	Д.Вставить("Строки", Новый Массив);
	
	Возврат Д;
КонецФункции
