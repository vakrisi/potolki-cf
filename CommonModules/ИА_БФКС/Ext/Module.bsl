Функция   Excel_ЗагрузитьФайлВТЗФ(ИмяФайла, НомерЛиста = 1, ЗадатьТипСтрока = Ложь, ИспользоватьФайлКэша = Ложь, НомерСтрокиНачала = 2) Экспорт
    Результат = Новый Структура("Таб, Загружено, СообщениеОбОшибке, ЗагруженоИзКэша"
    , Новый Массив, Ложь, "", Ложь);
    
    Если НЕ Файл_Существует(ИмяФайла) Тогда
        Результат.СообщениеОбОшибке = "Файл """ + ИмяФайла + """ не найден!";
        Возврат Результат;
    КонецЕсли; 
    
    Таб = Новый Массив;
    
    СтруктураКолонок = Новый Структура;
    
    ИмяФайлаКэш = ИмяФайла
    + "_" + Формат(НомерЛиста, "ЧГ=")
    + "_" + Формат(НомерСтрокиНачала, "ЧГ=")
    + "_" + ?(ЗадатьТипСтрока, "S", "N")+ ".1tv";
    
    Если ИспользоватьФайлКэша Тогда
        Если Файл_Существует(ИмяФайлаКэш) Тогда
            ВремяИсходного = Файл_ВремяИзменения(ИмяФайла);
            ВремяКэш       = Файл_ВремяИзменения(ИмяФайлаКэш);
            Если ВремяИсходного <= ВремяКэш Тогда
                Результат.ЗагруженоИзКэша = Истина;
                Результат.Загружено = Истина;
                
                ДД = Новый ДвоичныеДанные(ИмяФайлаКэш);
                Результат.Таб = ИА_БФС.ДвоичныеДанные2Значение(ДД);
                ДД = Неопределено;
                
                Возврат Результат;
            КонецЕсли; 
        КонецЕсли; 
    КонецЕсли; 
    
    //подключаемся к эксел
    Попытка
        Excel = Новый COMОбъект("Excel.Application");
        Excel.WorkBooks.Open(ИмяФайла);
        #Если Клиент Тогда
            Состояние("Открытие файла Microsoft Excel...");      	
        #КонецЕсли 
    Исключение
        Результат.СообщениеОбОшибке = "Ошибка при открытии файла с помощью Excel! Загрузка не будет произведена! Ошибка: "+ ОписаниеОшибки();
        Возврат Результат;
    КонецПопытки;
    
    мСтароеЗначениеDisplayAlerts = Excel.DisplayAlerts;
	Excel.DisplayAlerts = Ложь;
    
    Попытка 
        //Открываем необходимый лист
        ЛистЭксель = Excel.Sheets(НомерЛиста);
        ЛистЭксель.Select();
    Исключение
        //Закрываем Excel
        Excel.ActiveWorkbook.Close(); 	
        Excel = 0;
        ЛистЭксель = 0;
        Результат.СообщениеОбОшибке = "Файл "+Строка(ИмяФайла)+" не соответствует необходимому формату! Лист №"
        + НомерЛиста + "не найден! Ошибка: "+ ОписаниеОшибки();
        Возврат Результат;
    КонецПопытки;	
    
    //Получим количество строк и колонок.
    Версия = Лев(Excel.Version,Найти(Excel.Version,".")-1);
    Если Версия = "8" тогда
        ФайлСтрок   = Excel.Cells.CurrentRegion.Rows.Count;
        ФайлКолонок = Макс(Excel.Cells.CurrentRegion.Columns.Count, 13);
    Иначе
        Попытка
            ФайлСтрок   = Excel.Cells(1,1).SpecialCells(11).Row;
            ФайлКолонок = Excel.Cells(1,1).SpecialCells(11).Column;   
        Исключение
            ТекстОшибки = ОписаниеОшибки();
            ФайлСтрок   = ЛистЭксель.UsedRange.Row + ЛистЭксель.UsedRange.Rows.Count - 1;
            ФайлКолонок = ЛистЭксель.UsedRange.Column + ЛистЭксель.UsedRange.Columns.Count - 1;
        КонецПопытки; 
    Конецесли;
    
    отСтрока = Новый ОписаниеТипов("Строка",,Новый КвалификаторыСтроки(1023));
    //Для Ц = 1 По ФайлКолонок Цикл
    //    Имя = "К"+Формат(Ц,"ЧГ=");
    //    СтруктураКолонок.Вставить(Имя);
    //КонецЦикла; 	
    //ИменаКлючей = Струк_Ключи(СтруктураКолонок); 
    
    //_____________________________________________________________
    ЛистЭксель = Excel.Sheets(НомерЛиста);
    
    МассивИменКолонок = Новый Массив;
    Для Ц = 1 По ФайлКолонок Цикл
        Имя = "К"+Формат(Ц,"ЧГ=");
        МассивИменКолонок.Добавить(Имя);
    КонецЦикла; 	
    
    #Если Клиент Тогда
        Состояние("Выгрузка файла ...");      	
    #КонецЕсли 
    Область = ЛистЭксель.Range(ЛистЭксель.Cells(НомерСтрокиНачала,1), ЛистЭксель.Cells(ФайлСтрок,ФайлКолонок));
    Данные = Область.Value.Выгрузить();
    
    МассивПервойКолонки = Данные[0];
    #Если Клиент Тогда
        Состояние("Обработка данных...");      	
    #КонецЕсли 
    
    СчетчикОбновления = 0;
    Колво = МассивПервойКолонки.Количество() - 1;
    Для НомерСтроки = 0 По Колво Цикл
        Стр = Новый Структура;
        #Если Клиент Тогда
            СчетчикОбновления = СчетчикОбновления  + 1;
            Если СчетчикОбновления > 100 Тогда
                СчетчикОбновления = 0;
                Состояние("Обработка данных: " + Окр(100 * НомерСтроки / Колво,2)+ " %");
            КонецЕсли; 
            
            ОбработкаПрерыванияПользователя(); //указав данный оператор, цикл можно прервать в любой момент нажатие ctrl+break
        #КонецЕсли 
        
        Для Счетчик = 0 По ФайлКолонок - 1 Цикл
