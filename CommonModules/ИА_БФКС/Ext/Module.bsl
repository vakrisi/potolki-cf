
////#Область Общие_процедуры

Функция   СформироватьУИД() Экспорт
    УИД = СтрЗаменить("m"+Сред(""+Новый УникальныйИдентификатор, 2), "-", "");
    Возврат УИД;
КонецФункции

Функция   РеквизитЕсть(Объект, ИмяРеквизита) Экспорт 
    Если Объект = Неопределено Тогда
        Возврат Ложь;
    КонецЕсли; 
    ПустоеЗначение = "ca7a403c-94f3-4b24-b250-a75ce1a78427_7ad647ce-5ea1-427a-8121-6d04d254979f";
    Стр = Новый Структура(ИмяРеквизита, ПустоеЗначение);
    Попытка
    	ЗаполнитьЗначенияСвойств(Стр, Объект);
    Исключение
        ТекстОшибки = ОписаниеОшибки();
        Возврат Ложь;
    КонецПопытки; 
    
    Возврат Стр[ИмяРеквизита] <> ПустоеЗначение;
КонецФункции

Функция   Разделить(Делимое, Делитель, РезультатЕслиДелитель0 = 0) Экспорт
	Если Делитель = 0 Тогда
    	Возврат РезультатЕслиДелитель0;
    Иначе
        Возврат Делимое / Делитель;
    КонецЕсли; 
КонецФункции

Функция   ЧислоПрописьюБезДробных(Число) Экспорт
    Возврат СокрЛП(ЧислоПрописью(Число,,",,,м,,,,ж,0"));
КонецФункции

Функция   ВСписке(ЗначениеСписка
    , ЭлементСписка1 = "m86ecf82c2c1432c862a171cfebe64ad"
    , ЭлементСписка2 = "m86ecf82c2c1432c862a171cfebe64ad"
    , ЭлементСписка3 = "m86ecf82c2c1432c862a171cfebe64ad"
    , ЭлементСписка4 = "m86ecf82c2c1432c862a171cfebe64ad"
    , ЭлементСписка5 = "m86ecf82c2c1432c862a171cfebe64ad"
    , ЭлементСписка6 = "m86ecf82c2c1432c862a171cfebe64ad"
    , ЭлементСписка7 = "m86ecf82c2c1432c862a171cfebe64ad"
    , ЭлементСписка8 = "m86ecf82c2c1432c862a171cfebe64ad"
    , ЭлементСписка9 = "m86ecf82c2c1432c862a171cfebe64ad"
    ) Экспорт
    
    Массив = Новый Массив;
    Пустое = "m86ecf82c2c1432c862a171cfebe64ad";
    Если ЭлементСписка1 <> Пустое Тогда Массив.Добавить(ЭлементСписка1); КонецЕсли; 
    Если ЭлементСписка2 <> Пустое Тогда Массив.Добавить(ЭлементСписка2); КонецЕсли; 
    Если ЭлементСписка3 <> Пустое Тогда Массив.Добавить(ЭлементСписка3); КонецЕсли; 
    Если ЭлементСписка4 <> Пустое Тогда Массив.Добавить(ЭлементСписка4); КонецЕсли; 
    Если ЭлементСписка5 <> Пустое Тогда Массив.Добавить(ЭлементСписка5); КонецЕсли; 
    Если ЭлементСписка6 <> Пустое Тогда Массив.Добавить(ЭлементСписка6); КонецЕсли; 
    Если ЭлементСписка7 <> Пустое Тогда Массив.Добавить(ЭлементСписка7); КонецЕсли; 
    Если ЭлементСписка8 <> Пустое Тогда Массив.Добавить(ЭлементСписка8); КонецЕсли; 
    Если ЭлементСписка9 <> Пустое Тогда Массив.Добавить(ЭлементСписка9); КонецЕсли; 
	Результат = Массив.Найти(ЗначениеСписка) <> Неопределено;
    Возврат Результат;
КонецФункции

