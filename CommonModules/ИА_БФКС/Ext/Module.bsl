        Массив.Добавить(Элемент)
    КонецЕсли; 
КонецПроцедуры

Процедура Массив_УдалитьЕслиЕсть(Массив, Элемент) Экспорт
    Индекс = Массив.Найти(Элемент);
    Если Индекс <> Неопределено Тогда
        Массив.Удалить(Индекс);
        Массив_УдалитьЕслиЕсть(Массив, Элемент);
    КонецЕсли; 
КонецПроцедуры

Процедура Массив_УдалитьПоУсловию(Массив, Условие, Контекст = Неопределено) Экспорт
    Ц = 0;
    Пока Ц < Массив.Количество() Цикл
        Эл = Массив[Ц];
        Удалять = Вычислить(Условие);
        Если Удалять Тогда
            Массив.Удалить(Ц);
        Иначе
            Ц = Ц + 1;
        КонецЕсли; 
    КонецЦикла; 
КонецПроцедуры

Функция   Массив_ФильтрПоУсловию(Массив, Условие, Контекст = Неопределено) Экспорт
    Результат = Новый Массив;
    Для каждого Эл Из Массив Цикл
        Результат.Добавить(Эл);
    КонецЦикла;
    Массив_УдалитьПоУсловию(Результат, "НЕ (" + Условие + ")", Контекст);
    Возврат Результат;
КонецФункции

Функция   Массив_Новый(Эл1 = Неопределено
    , Эл2  = Неопределено
    , Эл3  = Неопределено
    , Эл4  = Неопределено
    , Эл5  = Неопределено
    , Эл6  = Неопределено
    , Эл7  = Неопределено
    , Эл8  = Неопределено
    , Эл9  = Неопределено
    , Эл10 = Неопределено) Экспорт 
    
    Результат = Новый Массив;
    
    Если Эл1  <> Неопределено Тогда Результат.Добавить(Эл1)  КонецЕсли;
    Если Эл2  <> Неопределено Тогда Результат.Добавить(Эл2)  КонецЕсли;
    Если Эл3  <> Неопределено Тогда Результат.Добавить(Эл3)  КонецЕсли;
    Если Эл4  <> Неопределено Тогда Результат.Добавить(Эл4)  КонецЕсли;
    Если Эл5  <> Неопределено Тогда Результат.Добавить(Эл5)  КонецЕсли;
    Если Эл6  <> Неопределено Тогда Результат.Добавить(Эл6)  КонецЕсли;
    Если Эл7  <> Неопределено Тогда Результат.Добавить(Эл7)  КонецЕсли;
    Если Эл8  <> Неопределено Тогда Результат.Добавить(Эл8)  КонецЕсли;
    Если Эл9  <> Неопределено Тогда Результат.Добавить(Эл9)  КонецЕсли;
    Если Эл10 <> Неопределено Тогда Результат.Добавить(Эл10) КонецЕсли;
    
    Возврат Результат;
КонецФункции

Функция   Массив_Представление(Массив, ТолькоУникальные = Ложь, Разделитель = "; ") Экспорт
	Результат = "";
    
    Если ТолькоУникальные Тогда
        МассивДляВывода = Массив_ПолучитьУникальныеЭлементы(Массив);
    Иначе
        МассивДляВывода = Массив;
    КонецЕсли; 
    
    
    Для каждого Эл Из МассивДляВывода Цикл
    	Результат = Результат + Разделитель + Эл;
    КонецЦикла; 
    
    Результат = Сред(Результат, СтрДлина(Разделитель) + 1);
    
    Возврат Результат;
КонецФункции

Функция   Массив_Сложить(Массив1, Массив2, ТолькоУникальные = Ложь) Экспорт
	Результат = Новый Массив;
    
    Если ТолькоУникальные Тогда
        Для каждого Эл Из Массив1 Цикл
            Если Результат.Найти(Эл) = Неопределено Тогда
            	Результат.Добавить(Эл);
            КонецЕсли; 
        КонецЦикла; 
        
        Для каждого Эл Из Массив2 Цикл
            Если Результат.Найти(Эл) = Неопределено Тогда
            	Результат.Добавить(Эл);
            КонецЕсли; 
        КонецЦикла; 
    Иначе
        Для каждого Эл Из Массив1 Цикл
            Результат.Добавить(Эл);
        КонецЦикла; 
        Для каждого Эл Из Массив2 Цикл
            Результат.Добавить(Эл);
        КонецЦикла; 
    КонецЕсли; 
    
    Возврат Результат;
КонецФункции
 
Функция   Массив_Содержит(Массив, Элемент) Экспорт
	Возврат Массив.Найти(Элемент) <> Неопределено;
КонецФункции

Функция   Массив2Строка(Массив, ТолькоУникальные = Ложь, Разделитель = "; ") Экспорт
    Возврат Массив_Представление(Массив, ТолькоУникальные, Разделитель);
