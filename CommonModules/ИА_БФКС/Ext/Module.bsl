////#Область ОС

Функция   ОС_ЗначениеПеременой(ИмяПеременной, ДобавитьПроценты = Истина) Экспорт
    Объект_WSShell = Новый COMОбъект("WScript.Shell");
    Если ДобавитьПроценты Тогда
    	Текст = "%" + ИмяПеременной + "%"
    Иначе
        Текст = ИмяПеременной;
    КонецЕсли; 
    
    Результат = Объект_WSShell.ExpandEnvironmentStrings(Текст);
    Возврат Результат;
КонецФункции


