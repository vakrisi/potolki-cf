////#Область РедакторФормул
Функция РедакторФормул_СформироватьПустуюФормулу() Экспорт
    ДЗФ = Новый Структура("Колонки, Строки", Новый Структура, Новый Массив);
    
    ДанныеФормулы = Новый Структура("Вид, Переменные, СоставФормулы, ПредставлениеФормулы, ОбработкаПроверкиФормулы"
    , ПредопределенноеЗначение("Перечисление.ИА_БФФормулыТип.ПустаяСсылка")
    , ДЗФ, Новый Массив, "", "");
    // 1 - Строка
    // 2 - Число
    
    Возврат ДанныеФормулы;
КонецФункции    
    
Функция РедакторФормул_ВыбраноЗначение(ВыбранноеЗначение) Экспорт
    Результат = ТипЗнч(ВыбранноеЗначение) = Тип("Структура")
    И ВыбранноеЗначение.Свойство("Вид")
    И ВыбранноеЗначение.Вид = "РедакторФормул";
    Возврат Результат;
КонецФункции

Функция РедакторФормул_ИзВыбЗначенияПолучитьДанныеФормулы(ВыбранноеЗначение) Экспорт
    
    Если ТипЗнч(ВыбранноеЗначение) = Тип("Структура")
        И ВыбранноеЗначение.Свойство("Вид")
        И ВыбранноеЗначение.Вид = "РедакторФормул" Тогда
        Результат = ВыбранноеЗначение.ДанныеФормулы;
    Иначе
        Результат = РедакторФормул_СформироватьПустуюФормулу();
    КонецЕсли;
    
    Возврат Результат;	
КонецФункции


