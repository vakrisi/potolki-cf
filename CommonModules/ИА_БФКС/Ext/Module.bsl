Функция   Струк_НайтиПоЗначению (Структура, Значение) Экспорт
    Для каждого КиЗ Из Структура Цикл
        Если КиЗ.Значение = Значение Тогда
            Возврат КиЗ.Ключ;
        КонецЕсли; 
    КонецЦикла; 
    Возврат Неопределено;
КонецФункции 

// Формирует текстовое представление структуры в формате: <Ключ1> = <Значение1>; <Ключ...> = <Значение...>; <КлючN> = <ЗначениеN>
// Параметры:
// Структура - Структура - Структура, строквое представление которой требуется получить
// ПорядокСледования - Строка - Желаемая последовательность ключей. Остальные ключи выведутся в системном порядке
// Исключенные - Строка - Ключи структуры, которые выводить не следует
// ВыражениеЕслиПусто - Строка - по-умолчанию "<пусто>" - что выводить для незаполненных ключей
Функция   Струк_Представление   (Структура, ПорядокСледования = "", Исключенные = "", ВыражениеЕслиПусто="<пусто>") Экспорт
    Результат = "";
    Стр = СтрЗаменить("," + ПорядокСледования + ",", ",", Символы.ПС);
    СписокКлючей = Новый Массив;
    ИсключенныеКлючи = Новый Структура(Исключенные);    
    
    Для Ц = 1 По СтрЧислоВхождений(Стр, Символы.ПС) Цикл
        ПодСтрока = СокрЛП(СтрПолучитьСтроку(Стр, Ц));
        Если ЗначениеЗаполнено(ПодСтрока) И СписокКлючей.Найти(ПодСтрока) = Неопределено Тогда
            СписокКлючей.Добавить(ПодСтрока);
        КонецЕсли; 
    КонецЦикла; 
    
    УжеВыведены = Новый Структура;
    
    Для каждого Ключ Из СписокКлючей Цикл
        Если Структура.Свойство(Ключ) И НЕ ИсключенныеКлючи.Свойство(Ключ) Тогда
            Значение = Структура[Ключ];
            Если НЕ ЗначениеЗаполнено(Значение) Тогда
                Значение = ВыражениеЕслиПусто;
            КонецЕсли; 
            Результат = Результат + "; " + Ключ + " = " + Значение;
            УжеВыведены.Вставить(Ключ);
        КонецЕсли; 
    КонецЦикла; 
    
    Для каждого КиЗ Из Структура Цикл
        Если НЕ УжеВыведены.Свойство(КиЗ.Ключ) И НЕ ИсключенныеКлючи.Свойство(КиЗ.Ключ) Тогда
            Значение = КиЗ.Значение;
            Попытка
                Если НЕ ЗначениеЗаполнено(Значение) Тогда
                    Значение = ВыражениеЕслиПусто;
                КонецЕсли; 
            Исключение
                Ошибка = ОписаниеОшибки();
                Значение = "" + Значение;
            КонецПопытки; 
            Результат = Результат + "; " + КиЗ.Ключ + " = " + Значение;
            
            УжеВыведены.Вставить(КиЗ.Ключ);
        КонецЕсли; 
    КонецЦикла; 
    
    Результат = Сред(Результат, 3);
    
    Возврат Результат;
КонецФункции

Функция   Струк_Ключи           (Структура) Экспорт
    Результат = "";
	Для каждого КиЗ Из Структура Цикл
        Результат = Результат + "," + КиЗ.Ключ;
    КонецЦикла; 
    Результат = Сред(Результат, 2);
    Возврат Результат;
КонецФункции
 
Функция   Струк_Равны(Структура1, Структура2) Экспорт
	Если Структура1.Количество() <> Структура2.Количество() Тогда
    	Возврат Ложь;
    КонецЕсли; 
    
    Для каждого КиЗ Из Структура1 Цикл
    	ПервоеЗначение = КиЗ.Значение;
        ВтороеЗначение = Неопределено;
        Если НЕ Структура2.Свойство(КиЗ.Ключ, ВтороеЗначение) Тогда
        	Возврат Ложь;
        КонецЕсли; 
        
        Если ПервоеЗначение <> ВтороеЗначение Тогда
        	Возврат Ложь;
        КонецЕсли; 
    КонецЦикла; 
    
    Возврат Истина;
КонецФункции

Функция   Струк_Новый(ИменаКолонок, ИсточникЗаполнения = Неопределено) Экспорт
	Результат = Новый Структура(ИменаКолонок);
    Если ИсточникЗаполнения <> Неопределено Тогда
    	ЗаполнитьЗначенияСвойств(Результат, ИсточникЗаполнения);
    КонецЕсли; 
    Возврат Результат;
КонецФункции

Функция   Струк_Объединить(Структура1, Структура2) Экспорт
    Результат = Новый Структура;
	Для каждого КиЗ Из Структура1 Цикл
    	Результат.Вставить(КиЗ.Ключ, КиЗ.Значение);
