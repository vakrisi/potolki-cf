Процедура ОбновитьДоступныеИнструкцииПользователя(Пользователь, КодыРаспределения, Администратор=Ложь) Экспорт
	// Обновление доступных инструкций
	Набор = РегистрыСведений.ИА_ДоступныеИнструкции.СоздатьНаборЗаписей();
	Набор.Отбор.Пользователь.Значение = Пользователь;
	Набор.Отбор.Пользователь.Использование = Истина;
	Если Администратор Тогда // все инструкции
		ВыборкаИнстр = Справочники.ИА_Инструкции.Выбрать();
		Пока ВыборкаИнстр.Следующий() Цикл
			Новстр = Набор.Добавить();
			Новстр.Инструкция = ВыборкаИнстр.Ссылка;
			Новстр.Пользователь = Пользователь;
		КонецЦикла;
	Иначе
		СписокРодителей = Новый СписокЗначений;
		Для каждого КодРаспределения ИЗ КодыРаспределения Цикл
			ТекРодитель = КодРаспределения.Родитель;
			Пока ЗначениеЗаполнено(ТекРодитель) Цикл
				Если СписокРодителей.НайтиПоЗначению(ТекРодитель)=Неопределено Тогда
					СписокРодителей.Добавить(ТекРодитель);
				КонецЕсли;
				ТекРодитель = ТекРодитель.Родитель;
			КонецЦикла;
		КонецЦикла;
		
		ЕстьКонтрольПоТипамИнструкций = Константы.ИА_ДИ_КонтрольПоТипамИнструкций.Получить();
		ЕстьКонтрольПоСтатусам        = Константы.ИА_ДИ_КонтрольПоСтатусам.Получить();
		ЕстьКонтрольПоСериям          = Константы.ИА_ДИ_КонтрольПоСериям.Получить();
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ИА_Инструкции.Ссылка
		|ИЗ
		|	Справочник.ИА_Инструкции КАК ИА_Инструкции ";
		Если ЕстьКонтрольПоТипамИнструкций Тогда
			Запрос.Текст = Запрос.Текст + "
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ИА_УровниДоступаПользователей КАК ИА_УровниДоступаПользователей1
			|		ПО (ИА_Инструкции.ТипИнструкции = ИА_УровниДоступаПользователей1.ОбъектДоступа
			|					И ИА_УровниДоступаПользователей1.Пользователь = &Пользователь
			|				ИЛИ ИА_Инструкции.ТипИнструкции = &ПустойТип) ";
		КонецЕсли;
		Если ЕстьКонтрольПоСтатусам Тогда
			Запрос.Текст = Запрос.Текст + "
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ИА_УровниДоступаПользователей КАК ИА_УровниДоступаПользователей3
			|		ПО (ИА_Инструкции.Статус = ИА_УровниДоступаПользователей3.ОбъектДоступа
			|					И ИА_УровниДоступаПользователей3.Пользователь = &Пользователь
			|				ИЛИ ИА_Инструкции.Статус = &ПустойСтатус) ";
		КонецЕсли;
		
		Запрос.Текст = Запрос.Текст + "
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ РАЗЛИЧНЫЕ
		|			ИнструкцииПоКодам.Ссылка КАК Ссылка
		|		ИЗ
		|			(ВЫБРАТЬ РАЗЛИЧНЫЕ
		|				ИА_Инструкции.Ссылка КАК Ссылка,
		|				ИА_ИнструкцииКодыРаспределения.КодРаспределения КАК КодРаспределения,
		|				ИА_ИнструкцииКодыРаспределения.ВсемСотрудникам КАК ВсемСотрудникам
		|			ИЗ
		|				Справочник.ИА_Инструкции КАК ИА_Инструкции
		|					ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ИА_Инструкции.КодыРаспределения КАК ИА_ИнструкцииКодыРаспределения
		|					ПО ИА_Инструкции.Ссылка = ИА_ИнструкцииКодыРаспределения.Ссылка) КАК ИнструкцииПоКодам
		|				ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ИА_УровниДоступаПользователей КАК ИА_УровниДоступаПользователей4
		|				ПО ((ИнструкцииПоКодам.КодРаспределения = ИА_УровниДоступаПользователей4.ОбъектДоступа
		|							ИЛИ ИнструкцииПоКодам.КодРаспределения В (&СписокРодителей)
		|								И ИнструкцииПоКодам.ВсемСотрудникам)
		|							И ИА_УровниДоступаПользователей4.Пользователь = &Пользователь
		|						ИЛИ ИнструкцииПоКодам.КодРаспределения ЕСТЬ NULL )) КАК ИнструкцииПоКодам
		|		ПО ИА_Инструкции.Ссылка = ИнструкцииПоКодам.Ссылка ";
		
		Если ЕстьКонтрольПоСтатусам Тогда
			Запрос.Текст = Запрос.Текст + "
			
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ РАЗЛИЧНЫЕ
			|			ИнструкцииПоСериям.Ссылка КАК Ссылка
			|		ИЗ
			|			(ВЫБРАТЬ РАЗЛИЧНЫЕ
			|				ИА_Инструкции.Ссылка КАК Ссылка,
			|				ИА_ИнструкцииСерии.Серия КАК Серия
			|			ИЗ
			|				Справочник.ИА_Инструкции КАК ИА_Инструкции
			|					ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ИА_Инструкции.Серии КАК ИА_ИнструкцииСерии
			|					ПО ИА_Инструкции.Ссылка = ИА_ИнструкцииСерии.Ссылка) КАК ИнструкцииПоСериям
			|				ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ИА_УровниДоступаПользователей КАК ИА_УровниДоступаПользователей5
			|				ПО (ИнструкцииПоСериям.Серия = ИА_УровниДоступаПользователей5.ОбъектДоступа
			|							И ИА_УровниДоступаПользователей5.Пользователь = &Пользователь
			|						ИЛИ ИнструкцииПоСериям.Серия ЕСТЬ NULL )) КАК ПоСериям
			|		ПО ИА_Инструкции.Ссылка = ПоСериям.Ссылка";
		КонецЕсли;
		Запрос.УстановитьПараметр("Пользователь", Пользователь);
		Запрос.УстановитьПараметр("ПустойТип", Справочники.ИА_ТипыИнструкций.ПустаяСсылка());
		Запрос.УстановитьПараметр("ПустойСтатус", Перечисления.ИА_СтатусИнструкции.ПустаяСсылка());
		Запрос.УстановитьПараметр("СписокРодителей", СписокРодителей);
		
		Выборка = Запрос.Выполнить().Выбрать();
		Пока выборка.Следующий() Цикл
			Новстр = Набор.Добавить();
			Новстр.Инструкция = выборка.Ссылка;
			Новстр.Пользователь = Пользователь;
		КонецЦикла;
	КонецЕсли;
	Набор.Записать(Истина);
КонецПроцедуры

Функция ПолучитьПредставлениеИнструкции(Инструкция) Экспорт
    Текст = Инструкция.Текст;
    
    НовТекст = ИА_ДИ_КлиентСервер.ПропарситьХТМЛДокументИОбновитьНаименованияСсылокИПеременные(Текст, Инструкция);
    НовТекст = ВставитьСсылкиНаОпределения(НовТекст,,Инструкция);
    
    Возврат НовТекст;
КонецФункции
 
Процедура ПроверитьПраваПоста(СсылкаПост) Экспорт
	Пользователи1 = ПользователиБезПрав(СсылкаПост);
	Если Пользователи1.Количество()>0 Тогда
		УстановитьПраваПользователюНаДИПоста(СсылкаПост,Пользователи1);		
	КонецЕсли;
КонецПроцедуры

Процедура ВывестиПодписьИПечать(Подписант, ДД_Инструкции, ИмяФайлаДок,ДвДанныеШаблон) Экспорт
			
	ДанныеПодписи = ИА_ОбщиеПроцедуры_Технология_Сервер.ПолучитьДанныеПодписанта(Подписант);
	Если ДанныеПодписи = Неопределено Тогда
		Сообщить("У подписанта не настроена подпись. Укажите в настройках КСУ.");
		Возврат;
	КонецЕсли;
	
	редактор = ПолучитьРедакторИнструкций();
	Если редактор = Неопределено Тогда // гугл. Там еще подписи не делали
		возврат;
	КонецЕсли;
	
	Если редактор = ПредопределенноеЗначение("Перечисление.ИА_РедакторИнструкций.ПустаяСсылка") Тогда
		Сообщить("Установите MS Word или Open Office Writer");
		Возврат;
	КонецЕсли;
	
	ВрКат = КаталогВременныхФайлов()+"ksu_template\";
	СоздатьКаталог(ВрКат);
	ПолныйПутьДокФайлШаблон = ВрКат + "template.doc";
	ДвДанныеШаблон.Записать(ПолныйПутьДокФайлШаблон);
	
	пИмяФайла = ВрКат + ИмяФайлаДок;
	ДД_Инструкции.Записать(пИмяФайла);
	
	файлДок = Новый Файл(пИмяФайла);
	ПолныйПутьКартинкаПодпись = файлДок.Путь + "signature.jpg";
	Если ДанныеПодписи.Подпись <> "" Тогда
		ДвДанныеПодпись = Base64Значение(ДанныеПодписи.Подпись);
		ДвДанныеПодпись.Записать(ПолныйПутьКартинкаПодпись);
	КонецЕсли;
	
	Если редактор = ПредопределенноеЗначение("Перечисление.ИА_РедакторИнструкций.Word") Тогда
		Word = новый COMОбъект("Word.Application");
		Document = Word.Documents.Open(ПолныйПутьДокФайлШаблон);
		//
		// Производим замену (подготовка шаблона)
		//
		Поиск = Document.Range().Find; 
		Поиск.ClearFormatting(); 
		Поиск.Execute("%ДОЛЖНОСТЬ%", , , , , , - 1, , , ДанныеПодписи.Должность, 2);
		Поиск.Execute("%ФИО%", , , , , , - 1, , , ДанныеПодписи.ФИО, 2);
		//
		// вставляем подпись
		//
		Для Каждого s из Document.Shapes Цикл
			Если s.Type = 13 Тогда
				прервать;
			КонецЕсли;
		КонецЦикла;
		Document.Shapes.AddPicture(ПолныйПутьКартинкаПодпись, false, true, 0, 0, s.Width, s.Height, s.Anchor); 
		s.Delete();
		
		Document.Save();		
		Document.Close();
		
		//
		//загрузка основного документа
		//
		Document = Word.Documents.Open(пИмяФайла);
		Selection = Word.Selection;
		
		//
		//переход в конец документа
		//
		wdStory = 6;
		Selection.EndKey(wdStory);
		
		//
		// вставка из документа
		//
		Selection.InsertFile(ПолныйПутьДокФайлШаблон, "",False, False, False);
		
		//
		// сохраняем, закрываем
		//
		Document.Save();		
		Document.Close();
		
		Word.Quit();
		Word = 0;
	Иначе // ОО
		Word = новый COMОбъект("com.sun.star.ServiceManager");
		Desktop = Word.createInstance("com.sun.star.frame.Desktop");
		
		Args = Новый COMSafeArray("VT_VARIANT", 1);
		// невидимым нельзя сделать ОО глючит
		//lProp       = Word.Bridge_GetStruct("com.sun.star.beans.PropertyValue"); 
		//lProp.Name  = "Hidden"; 
		//lProp.Value = true; 
		//Args.SetValue(0, lProp);
		
		lProp       = Word.Bridge_GetStruct("com.sun.star.beans.PropertyValue"); 
		lProp.Name  = "MacroExecutionMode"; 
		lProp.Value = 2; 
		Args.SetValue(0, lProp);
		
		//
		// вставляем подпись (подготовка шаблона)
		//
		Если ДанныеПодписи.Подпись <> "" Тогда
			ДокументШаблон = Desktop.LoadComponentFromURL(convertToURL(ПолныйПутьДокФайлШаблон), "_hidden", 0, Args);
			oExistingGraph = ДокументШаблон.getGraphicObjects().getbyIndex(0);
			oExistingGraph.GraphicURL = convertToURL(ПолныйПутьКартинкаПодпись);
			
			ДокументШаблон.store();
			ДокументШаблон.Close(Истина);
			ДокументШаблон = 0;
		КонецЕсли;
		
		//
		//загрузка основного документа
		//
		Документ = Desktop.LoadComponentFromURL(convertToURL(пИмяФайла), "_hidden", 0, Args);
		dispatcher = Word.createInstance("com.sun.star.frame.DispatchHelper");
		documentFrame = Документ.CurrentController.Frame;
		
		//
		//переход в конец документа
		//
		lProperties1 = Новый COMSafeArray("VT_VARIANT", 0);
		dispatcher.executeDispatch(documentFrame, ".uno:GoToEndOfDoc", "", 0, lProperties1);
		
		//
		// вставка из документа
		//
		lProperties = Новый COMSafeArray("VT_VARIANT", 2);
		lProp       = Word.Bridge_GetStruct("com.sun.star.beans.PropertyValue"); 
		lProp.Name  = "Name"; 
		lProp.Value = convertToURL(ПолныйПутьДокФайлШаблон); 
		lProperties.SetValue(0, lProp);
		
		lProp2       = Word.Bridge_GetStruct("com.sun.star.beans.PropertyValue"); 
		lProp2.Name  = "Filter"; 
		lProp2.Value = "MS Word 97"; 
		lProperties.SetValue(1, lProp2);
		
		dispatcher.executeDispatch(documentFrame, ".uno:InsertDoc", "", 0, lProperties);
		
		//
		// Производим замену
		//
		lProperties = ПолучитьСвойстваЗаменыТекста(Word, "%ДОЛЖНОСТЬ%", ДанныеПодписи.Должность); 
		dispatcher.executeDispatch(documentFrame, ".uno:ExecuteSearch", "", 0, lProperties);
		lProperties = ПолучитьСвойстваЗаменыТекста(Word, "%ФИО%", ДанныеПодписи.ФИО); 
		dispatcher.executeDispatch(documentFrame, ".uno:ExecuteSearch", "", 0, lProperties);
		
		//
		// убираем последний разрыв страницы
		//
		iCnt = 0;
		iCnt1 = 0;
		oText = Документ.Text;
		oCursor = oText.CreateTextCursor();
		oCursor.GoToStart(False);
		Продолжать = истина;
		Пока Продолжать Цикл // получим количество разрывов
			Если не oCursor.gotoEndOfParagraph(True) Тогда Прервать; КонецЕсли;
			Если ЗначениеЗаполнено(oCursor.PageDescName) Тогда
				iCnt = iCnt + 1;
			КонецЕсли;
			Продолжать = oCursor.gotoNextParagraph(False);
		КонецЦикла;
		
		oCursor.GoToStart(False);  
		Продолжать = истина;
		Пока Продолжать Цикл // удалим последний разрыв
			Если не oCursor.gotoEndOfParagraph(True) Тогда Прервать; КонецЕсли;
			Если ЗначениеЗаполнено(oCursor.PageDescName) Тогда
				iCnt1 = iCnt1 + 1;
				Если iCnt1 = iCnt Тогда
					oCursor.PageDescName = "";
				КонецЕсли;
			КонецЕсли;
			Продолжать = oCursor.gotoNextParagraph(False);
		КонецЦикла;			
		
		//
		// сохраняем, закрываем
		//
		Документ.store();
		Документ.Close(Истина);
		//
		Документ = 0;
		Args = 0;
		lProperties = 0;
		lProp = 0;
		Desktop = 0;
		Word = 0;
	КонецЕсли;
	
	ДД_Инструкции = Новый ДвоичныеДанные(пИмяФайла);
	УдалитьФайлы(ВрКат);

КонецПроцедуры

Функция ПолучитьСвойстваЗаменыТекста(Word, ЧтоМеняем, НаЧтоменяем)
	lProperties = Новый COMSafeArray("VT_VARIANT", 6);
	
	lProp       = Word.Bridge_GetStruct("com.sun.star.beans.PropertyValue"); 
	lProp.Name  = "SearchItem.SearchFlags"; 
	lProp.Value = 65536; 
	lProperties.SetValue(0, lProp);
	
	lProp       = Word.Bridge_GetStruct("com.sun.star.beans.PropertyValue"); 
	lProp.Name  = "SearchItem.SearchString"; 
	lProp.Value = ЧтоМеняем; 
	lProperties.SetValue(1, lProp);
	
	lProp       = Word.Bridge_GetStruct("com.sun.star.beans.PropertyValue"); 
	lProp.Name  = "SearchItem.ReplaceString"; 
	lProp.Value = НаЧтоменяем; 
	lProperties.SetValue(2, lProp);
	
	lProp       = Word.Bridge_GetStruct("com.sun.star.beans.PropertyValue"); 
	lProp.Name  = "SearchItem.Command"; 
	lProp.Value = 3; 
	lProperties.SetValue(3, lProp);
	
	lProp       = Word.Bridge_GetStruct("com.sun.star.beans.PropertyValue"); 
	lProp.Name  = "Quiet"; 
	lProp.Value = true; 
	lProperties.SetValue(4, lProp);
	
	lProp       = Word.Bridge_GetStruct("com.sun.star.beans.PropertyValue"); 
	lProp.Name  = "SearchItem.AlgorithmType"; 
	lProp.Value = 0; 
	lProperties.SetValue(5, lProp);
	
	
	Возврат lProperties;
КонецФункции

функция convertToURL(FileName) Экспорт
    рез =  стрзаменить(FileName," ","%20" );
    рез =  стрзаменить(рез,"\","/" );
    возврат "file:/" + "/localhost/"+рез;
конецфункции

Функция ПолучитьРедакторИнструкций() Экспорт
	
	Если Константы.ИА_ДИ_ИспользоватьGoogleДокументы.Получить() или Константы.ИА_ДИ_ИспользоватьGoogleДокументыДляКонвертации.Получить() Тогда
		возврат Неопределено;
	КонецЕсли;
	
	Попытка
		Word = новый COMОбъект("Word.Application");
		Word = 0;
		Возврат Перечисления.ИА_РедакторИнструкций.Word;
	Исключение
	КонецПопытки;
	
	Попытка
		Word = новый COMОбъект("com.sun.star.ServiceManager");
		Word = 0;
		Возврат Перечисления.ИА_РедакторИнструкций.Writer;
	Исключение
	КонецПопытки;
	
	Возврат Перечисления.ИА_РедакторИнструкций.ПустаяСсылка();
КонецФункции

Функция ПолучитьДанныеОпределения(Инструкция) Экспорт
	
	ТекстОпр = Инструкция.Определение;
	
	Вложения = Инструкция.Вложения.Получить();
	Если Вложения<>Неопределено Тогда
		Для каждого стр из Вложения Цикл
			Если ТипЗнч(стр.Значение) = Тип("Картинка") Тогда
				имяФ = стр.Ключ;
				ддФ = стр.Значение.ПолучитьДвоичныеДанные();
				
				КартинкаBase64 = Base64Строка(ддФ);
				ТекстОпр = СтрЗаменить(ТекстОпр,"src="""+имяФ, "src=""data:image/jpeg;base64,"+КартинкаBase64);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Возврат ТекстОпр;
КонецФункции

Функция ПолучитьЗадачуНаОзнакомление(Сотрудник, СписокДИ, срок) Экспорт
	Док = Документы.ИА_ЗаданиеНаИзучениеДИ.СоздатьДокумент();
	док.Дата = ТекущаяДата();
	док.Автор = ПараметрыСеанса.ТекущийПользователь;
	док.Сотрудник = Сотрудник;
	док.Срок = срок;
	
	Для каждого стрДИ из СписокДИ Цикл
		НовстрДИ = док.Инструкции.Добавить();
		НовстрДИ.Инструкция = стрДИ;
		НовстрДИ.УИДстроки = строка(новый УникальныйИдентификатор);
		
		Для каждого стрВопрос из стрДИ.Вопросы Цикл
			новстрВопрос = док.Вопросы.Добавить();
			новстрВопрос.Вопрос = стрВопрос.Вопрос;
			новстрВопрос.УИДстроки = НовстрДИ.УИДстроки;
		КонецЦикла;
	КонецЦикла;
	
	док.Записать(РежимЗаписиДокумента.Проведение);
	
	возврат док.Ссылка;
КонецФункции

