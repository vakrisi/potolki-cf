Процедура ПропарситьЧайлдовИВставитьОпределения(КоллекцияЧайлдов, МассивСлов)
	сч = 0;
    КоллекцияЧайлдовlength = КоллекцияЧайлдов.length;
    ////Для каждого эл Из КоллекцияЧайлдов Цикл
    Пока сч < КоллекцияЧайлдовlength Цикл
    	эл = КоллекцияЧайлдов.item(сч);
		Если ВРЕГ(эл.nodeName) = "A" Тогда
			сч = сч + 1;
			Продолжить;
		КонецЕсли;
		
		Если эл.nodeName = "#text" Тогда
			текстРазб = эл.nodeValue;
			
			сч_букв = 1;
			НачалоСлова = 0;
			КонецСлова = 0;
			
			Пока сч_букв <= СтрДлина(текстРазб) Цикл
				Слово = "";
				Символ = Сред(текстРазб, сч_букв, 1);
				
				Если ИА_ДИ_КлиентСервер.ЭтоБуква(Символ) Тогда
					НачалоСлова = сч_букв;
					Пока ИА_ДИ_КлиентСервер.ЭтоБуква(Символ) и сч_букв <= СтрДлина(текстРазб) Цикл
						Слово = Слово + Символ;
						КонецСлова = сч_букв;
						сч_букв = сч_букв + 1;
						Символ = Сред(текстРазб, сч_букв, 1);
					КонецЦикла;
					
					Если Слово<>"" Тогда
						Если МассивСлов.Найти(нрег(сокрЛП(Слово)))<>Неопределено Тогда
							
							Определение = ОпределениеПоСлову(Слово);							
							ТекстВсплывающейПодсказки = ПолучитьТекстИзHTML(Определение);
							ТекстВсплывающейПодсказки = СтрЗаменить(ТекстВсплывающейПодсказки,"""","");
							ТекстВсплывающейПодсказки = СтрЗаменить(ТекстВсплывающейПодсказки,Символы.ПС,"");
							
							текстРазб = Лев(текстРазб, НачалоСлова - 1) + "<A href=1CRefInstGlossary title = "+""""+ТекстВсплывающейПодсказки+""""+">"+ Слово + "</A>" + Сред(текстРазб, КонецСлова + 1);	
							сч_букв = сч_букв + СтрДлина("<A href=1CRefInstGlossary title = "+""""+ТекстВсплывающейПодсказки+""""+"></A>") - 1;
							
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;
				
				сч_букв = сч_букв + 1;
			КонецЦикла;
			
			эл.nodeValue = текстРазб;
		КонецЕсли;
		
		ПропарситьЧайлдовИВставитьОпределения(эл.childNodes, МассивСлов);
		сч = сч + 1;
	КонецЦикла;
КонецПроцедуры

Функция ПолучитьТекстИзHTML(ТекстHTML) Экспорт
	
	фд = Новый ФорматированныйДокумент();
	вл = новый Структура();
	фд.УстановитьHTML(ТекстHTML, вл);
	рез = Строка(фд.ПолучитьФорматированнуюСтроку());
	
	Возврат рез;
КонецФункции

// Функция склоняет переданную фразу
// Параметры:
//  ФИО (обязательный), тип строка
//   Параметр должен содержать фамилию имя отчества в именительном падеже, которые необходимо просклонять.
//
//  Падеж (обязательный), тип число
//   Падеж, в который необходимо поставить ФИО.
//   1 - Именительный
//   2 - Родительный
//   3 - Дательный
//   4 - Винительный
//   5 - Творительный
//   6 - Предложный
//
//  Результат (обязательный), тип строка
//   Переменная, в которую будет возвращен результат склонения.
//
//  Пол (необязательный), тип Перечисление.ПолФизическогоЛица
//   Пол физического лица
//
Функция Просклонять(Знач ФИО, Падеж, Результат, Пол = Неопределено) Экспорт
	
	ПодключитьВнешнююКомпоненту("ОбщийМакет.КомпонентаСклоненияФИО", "Decl");
	Компонента = Новый("AddIn.Decl.CNameDecl");
	
	Результат = ФИО;
	
	ИмяПеречисления = "ПолФизическихЛиц";
	
	Попытка
		Проверка = Перечисления.ПолФизическихЛиц.Мужской;
	Исключение
		ИмяПеречисления = "ПолФизическогоЛица";
	КонецПопытки;
	
	Попытка
		Если Пол = Перечисления[ИмяПеречисления].Мужской Тогда
			Результат = Компонента.Просклонять(Результат, Падеж, 1) + " ";
			
		ИначеЕсли Пол = Перечисления[ИмяПеречисления].Женский Тогда
			Результат = Компонента.Просклонять(Результат, Падеж, 2) + " ";
			
		Иначе
			Результат = Компонента.Просклонять(Результат, Падеж) + " ";
			
		КонецЕсли;
		
	Исключение
		Результат = ФИО;
		Возврат Ложь;
		
	КонецПопытки;
	
	Результат = СокрЛП(Результат);
	
	Возврат Истина;
	
КонецФункции

