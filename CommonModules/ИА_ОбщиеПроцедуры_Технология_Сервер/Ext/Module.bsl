Функция ПолучитьДанныеПодписанта(Подписант) Экспорт
	Результат = Новый Структура("ФИО, Подпись, Должность");
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ИА_ПодписиСотрудников.Должность,
	|	ИА_ПодписиСотрудников.ФИО,
	|	ИА_ПодписиСотрудников.Подпись
	|ИЗ
	|	РегистрСведений.ИА_ПодписиСотрудников КАК ИА_ПодписиСотрудников
	|ГДЕ
	|	ИА_ПодписиСотрудников.Сотрудник = &Сотрудник";
	
	Запрос.УстановитьПараметр("Сотрудник", Подписант);
	
	ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Результат.ФИО = ВыборкаДетальныеЗаписи.ФИО;
		Результат.Должность = ВыборкаДетальныеЗаписи.Должность;
		Результат.Подпись = Base64Строка(ВыборкаДетальныеЗаписи.Подпись.Получить());
	Иначе
		Результат = Неопределено;
	КонецЕсли;
	
	Возврат  Результат;
	
КонецФункции

Функция ПользователиБезПрав(СсылкаПост) Экспорт
	
	//Арчил Тваладзе 2016.04.25
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ИА_ДанныеФизЛиц.ФизЛицо,
	               |	ИА_ДанныеФизЛиц.Пользователь
	               |ПОМЕСТИТЬ ВТФизЛицаПользователи
	               |ИЗ
	               |	РегистрСведений.ИА_ДанныеФизЛиц КАК ИА_ДанныеФизЛиц
	               |ГДЕ
	               |	ИА_ДанныеФизЛиц.ФизЛицо В(&ФизЛицо)
	               |	И ИА_ДанныеФизЛиц.Пользователь <> ЗНАЧЕНИЕ(Справочник.Пользователи.ПустаяСсылка)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	Пользователи.Ссылка КАК Пользователь,
	               |	ИА_УровниДоступаПользователей.Пользователь КАК Пользователь1
