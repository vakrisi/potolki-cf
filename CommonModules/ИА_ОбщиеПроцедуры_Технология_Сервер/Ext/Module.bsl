КонецФункции


Функция ОпределениеПоСлову(Слово) Экспорт
	
	ЗапросСлова = Новый Запрос;
	ЗапросСлова.Текст = "ВЫБРАТЬ
	|	ИА_ОпределенияСклонения.Ссылка.Определение КАК Определение
	|ИЗ
	|	Справочник.ИА_Определения.Склонения КАК ИА_ОпределенияСклонения
	|ГДЕ
	|	ИА_ОпределенияСклонения.Слово ПОДОБНО &Слово";
	ЗапросСлова.УстановитьПараметр("Слово",Слово);
	Выборка= ЗапросСлова.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Определение;
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

Функция СсылкаПоСлову(Слово) Экспорт
	
	ЗапросСлова = Новый Запрос;
	ЗапросСлова.Текст = "ВЫБРАТЬ
	|	ИА_ОпределенияСклонения.Ссылка
	|ИЗ
	|	Справочник.ИА_Определения.Склонения КАК ИА_ОпределенияСклонения
	|ГДЕ
	|	ИА_ОпределенияСклонения.Слово ПОДОБНО &Слово";
	ЗапросСлова.УстановитьПараметр("Слово",Слово);
	Выборка= ЗапросСлова.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	Возврат "";
КонецФункции

Функция ИА_ВычислитьПеременную(объект,переменная,формула = "") Экспорт
	Если СОКРЛП(формула)= "" И СОКРЛП(переменная)<>"" Тогда
		Запрос = Новый запрос;
		Запрос.Текст = "ВЫБРАТЬ
		|	ИА_ПеременныеИнструкцийПеременные.Формула
		|ИЗ
		|	Справочник.ИА_ПеременныеИнструкций.Переменные КАК ИА_ПеременныеИнструкцийПеременные
		|ГДЕ
		|	ИА_ПеременныеИнструкцийПеременные.Переменная = &Переменная
		|	И ИА_ПеременныеИнструкцийПеременные.Ссылка.ПометкаУдаления = Ложь ";
		Запрос.УстановитьПараметр("Переменная",переменная);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			формула = Выборка.Формула;
		КонецЕсли;
	КонецЕсли;
	рез = "";
	Если СОКРЛП(формула)<>"" Тогда
		УстановитьБезопасныйРежим(Истина);
		Выполнить(формула);
		УстановитьБезопасныйРежим(Ложь);
	КонецЕсли;
	Возврат рез;
КонецФункции


Функция ПолучитьСловаИсключивОпределение( ИсключитьСлово = Неопределено ) Экспорт
	
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
                   |    ИА_ОпределенияСклонения.Слово КАК Наименование
                   |ИЗ
                   |    Справочник.ИА_Определения.Склонения КАК ИА_ОпределенияСклонения
                   |ГДЕ
                   |    ИА_ОпределенияСклонения.Ссылка <> &Ссылка
                   |
                   |СГРУППИРОВАТЬ ПО
                   |    ИА_ОпределенияСклонения.Слово
                   |
                   |УПОРЯДОЧИТЬ ПО
                   |    ИА_ОпределенияСклонения.Слово";
	Запрос.УстановитьПараметр("Ссылка", ИсключитьСлово);
	МассивСлов = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Наименование");
	сч=0;
	Пока сч < МассивСлов.Количество() Цикл
		МассивСлов[сч] = нрег(МассивСлов[сч]);
		сч = сч + 1;
	КонецЦикла;
	
	Возврат МассивСлов;
	
КонецФункции


Функция ПолучитьНастройкуПользователя(пНастройка, пПользователь = Неопределено) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	НастройкиПользователей.Значение
	|ИЗ
	|	РегистрСведений.НастройкиПользователей КАК НастройкиПользователей
	|ГДЕ
	|	НастройкиПользователей.Пользователь = &Пользователь
	|	И НастройкиПользователей.Настройка = &Настройка";
	Запрос.УстановитьПараметр("Пользователь", ?(пПользователь = Неопределено, ПараметрыСеанса.ТекущийПользователь, пПользователь));
	Запрос.УстановитьПараметр("Настройка", пНастройка);
	Выборка = Запрос.Выполнить().Выбрать();
	Если выборка.Следующий() Тогда
		Возврат Выборка.Значение;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
КонецФункции


функция ИА_ОбъектДоступен(Объект) Экспорт
	
	Набор = РегистрыСведений.ИА_УровниДоступаПользователей.СоздатьНаборЗаписей();
	Набор.Отбор.Пользователь.Значение = ПараметрыСеанса.ТекущийПользователь;
	Набор.Отбор.Пользователь.Использование = Истина;
	Набор.Отбор.ОбъектДоступа.Использование = Истина;
	
	//сначала праверяем есть ли у пользователя админские права
	Набор.Отбор.ОбъектДоступа.Значение = ПредопределенноеЗначение("Справочник.ОргСхема.ПустаяСсылка");
	Набор.Прочитать();
	
	Если Набор.Количество()>0 Тогда
	
		Возврат Истина;
	
	КонецЕсли;
	
	//потом права конкретно на это объект
	Набор.Отбор.ОбъектДоступа.Значение = Объект;
	Набор.Прочитать();
	
	Возврат Набор.Количество()>0;
	
КонецФункции


