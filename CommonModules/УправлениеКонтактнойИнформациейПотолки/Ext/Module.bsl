//    СтрокаТабличнойЧасти - СтрокаТабличнойЧасти - заполняемая строка табличной части "Контактная информация".
//
Процедура ЗаполнитьРеквизитыТабличнойЧастиДляТелефона(СтрокаТабличнойЧасти)
	
	// Умолчания
	НомерАбонента = СтрокаТабличнойЧасти.Представление;
	СтрокаТабличнойЧасти.НомерТелефона = СофтФон.ОставитьТолькоЦифры(НомерАбонента);
	
КонецПроцедуры

Функция ПолучитьДанныеИзКонтактнойИнформацииФормыПоВиду(Форма, Вид, ТолькоПредставление) Экспорт
	
	Результат = Новый Массив;
	ОтборПоВиду = Новый Структура("Вид", Вид);
	НайденныеСтроки = Форма.ДополнительнаяКонтактнаяИнформацияОписаниеРеквизитов.НайтиСтроки(ОтборПоВиду);
	Для каждого СтрокаКИ из НайденныеСтроки Цикл
		Результат.Добавить(СтрокаКИ.Представление);
	КонецЦикла;
	
	Если ТолькоПредставление Тогда
		Если Результат.Количество() > 0 Тогда
			Возврат Результат[0];	
		Иначе			
			Возврат "";
		КонецЕсли;
	Иначе
		Возврат Результат;
	КонецЕсли;
	
КонецФункции

Функция ПолучитьТелефонИзКонтактнойИнформацииФормы(Форма, ТолькоПредставление) Экспорт
	
	Вид = ПредопределенноеЗначение("Справочник.ВидыКонтактнойИнформации.ТелефонКонтрагента");
	Возврат ПолучитьДанныеИзКонтактнойИнформацииФормыпоВиду(Форма, Вид, ТолькоПредставление);
		
КонецФункции

Функция ПолучитьАдресПочтыИзКонтактнойИнформацииФормы(Форма, ТолькоПредставление) Экспорт
	
	Вид = ПредопределенноеЗначение("Справочник.ВидыКонтактнойИнформации.EmailКонтрагента");
	Возврат ПолучитьДанныеИзКонтактнойИнформацииФормыПоВиду(Форма, Вид, ТолькоПредставление);
		
КонецФункции

Функция ПолучитьДанныеИзКонтактнойИнформацииОбъектаПоВиду(СсылкаИлиОбъект, ВидКИ, ТолькоПредставление) Экспорт
	
	// ДокументСсылка
	Если ТипЗнч(СсылкаИлиОбъект) = Тип("ДокументСсылка.Лид") Тогда
		Если ТолькоПредставление Тогда
			Возврат КонтактнаяИнформацияОбъекта(СсылкаИлиОбъект, ВидКИ, Истина);
		Иначе
		    Возврат КонтактнаяИнформацияОбъекта(СсылкаИлиОбъект, ВидКИ, Ложь, Истина);
		КонецЕсли;
	КонецЕсли;	
	
	// ДокументОбъект
	Результат = Новый Массив;
	
	ОтборПоВиду = Новый Структура("Вид", ВидКИ);
	НайденныеСтроки = СсылкаИлиОбъект.ДополнительнаяКонтактнаяИнформация.НайтиСтроки(ОтборПоВиду);	
	Для каждого СтрокаКИ из НайденныеСтроки Цикл
		Результат.Добавить(СтрокаКИ.Представление);
	КонецЦикла;
	
	Если ТолькоПредставление Тогда
		Если Результат.Количество() > 0 Тогда
			Возврат Результат[0];	
		Иначе			
			Возврат "";
		КонецЕсли;
	Иначе
		Возврат Результат;
	КонецЕсли;
	
КонецФункции

Функция ПолучитьТелефонИзКонтактнойИнформацииОбъекта(СсылкаИлиОбъект, ТолькоПредставление = Истина) Экспорт
	
	ВидКИ = ПредопределенноеЗначение("Справочник.ВидыКонтактнойИнформации.ТелефонКонтрагента");
	Возврат ПолучитьДанныеИзКонтактнойИнформацииОбъектаПоВиду(СсылкаИлиОбъект, ВидКИ, ТолькоПредставление);
	
КонецФункции

Функция ПолучитьАдресПочтыИзКонтактнойИнформацииОбъекта(СсылкаИлиОбъект, ТолькоПредставление) Экспорт

	ВидКИ = ПредопределенноеЗначение("Справочник.ВидыКонтактнойИнформации.EmailКонтрагента");
	Возврат ПолучитьДанныеИзКонтактнойИнформацииОбъектаПоВиду(СсылкаИлиОбъект, ВидКИ, ТолькоПредставление);
	
КонецФункции

Процедура ЗаполнитьКонтактнуюИнформациюОбъектаИзСтроки(СтрокаКонтактнойИнформацииОбъекта, СтрокаКонтактнойИнформации)
	
	ЗаполнитьЗначенияСвойств(СтрокаКонтактнойИнформации, СтрокаКонтактнойИнформацииОбъекта);
	
	Если ЗначениеЗаполнено(СтрокаКонтактнойИнформации.Представление) Тогда
		ЗаполнитьТехническиеПоляКонтактнойИнформации(СтрокаКонтактнойИнформации, СтрокаКонтактнойИнформацииОбъекта.Тип);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти
