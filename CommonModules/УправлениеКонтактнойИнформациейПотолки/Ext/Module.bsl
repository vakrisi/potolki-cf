//			
//			Для каждого Строка Из НайденныеСтроки Цикл
//				Объект.КонтактнаяИнформация.Удалить(Строка);
//			КонецЦикла;
//			
//		КонецЦикла;
//		
//	КонецЕсли;

	Телефоны = Новый Массив;
	ЭлектронныеАдреса = Новый Массив;
