Функция МассивОрганизацийФП(Организация)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ИА_ГруппыКомпанийДочерниеОрганизации.Организация
	|ИЗ
	|	Справочник.ИА_ГруппыКомпаний.ДочерниеОрганизации КАК ИА_ГруппыКомпанийДочерниеОрганизации
	|ГДЕ
	|	ИА_ГруппыКомпанийДочерниеОрганизации.Ссылка.ГоловнаяОрганизация = &ГоловнаяОрганизация
	|
	|СГРУППИРОВАТЬ ПО
	|	ИА_ГруппыКомпанийДочерниеОрганизации.Организация";
	
	Запрос.УстановитьПараметр("ГоловнаяОрганизация", Организация);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Массив = Новый Массив;
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Массив.Добавить(ВыборкаДетальныеЗаписи.Организация);
	КонецЦикла;
	Если Массив.Найти(Организация) = Неопределено Тогда 
		Массив.Добавить(Организация);
	КонецЕсли;
	Возврат Массив;
	
КонецФункции

Процедура ДобавитьКолонкуСумма(ТЗ)
	ТЗ.Колонки.Добавить("Сумма");
    Для каждого Стр Из ТЗ Цикл
    	Стр.Сумма = Стр.СуммаНал + Стр.СуммаБезНал;
    КонецЦикла;  
КонецПроцедуры

Процедура ЗаполнитьДокумент_РасчетПолитика2(Док, ДанныеРасчета, ДокНастройка, ПараметрыЗапросов, НеОчищатьРучные)
	
	ИмяТч = "Политика2";
	
    Если НеОчищатьРучные Тогда
    	ТабСтарыхДанных = ИА_БФС.ТЗ_ФильтрПоОтбору(Док[ИмяТч], Новый Структура("Вручную", Истина));
    Иначе
        ТабСтарыхДанных = Док[ИмяТч].ВыгрузитьКолонки();
    КонецЕсли; 
    
    мен = Перечисления.ИА_РежимРасчетаСуммы;
                
    Для каждого Стр Из ДокНастройка.Политика2 Цикл
        НовСтрока = ДанныеРасчета.Политика2.Добавить();
        ЗаполнитьЗначенияСвойств(НовСтрока, Стр);
		НовСтрока.Статья = Стр.Статья;
        
        Если      Стр.СпособРасчета = мен.ФиксированнаяСумма Тогда
            Если ТипЗнч(Стр.Значение) = тип("Строка") ТОгда
            	НовСтрока.Сумма = число(Стр.Значение);
			Иначе
				НовСтрока.Сумма = Стр.Значение;
			КонецЕсли;
			
			расш = Новый Структура("Формула,ФормулаРезультат");
			расш.Формула = "Фиксированная сумма"; 
			расш.ФормулаРезультат = "" + НовСтрока.Сумма; 
			НовСтрока.ДанныеРасшифровки = ЗначениеВСтрокуВнутр(расш);
        ИначеЕсли Стр.СпособРасчета = мен.Процент Тогда
            НовСтрока.Сумма = Окр(ДанныеРасчета.ВаловаяПрибыль * ?(ЗначениеЗаполнено(Стр.Значение),Стр.Значение,0) / 100, 2);
			//
			расш = Новый Структура("Формула,ФормулаРезультат");
			расш.Формула = "Валовая прибыль * " + Стр.Значение + "%"; 
			расш.ФормулаРезультат = ""+ДанныеРасчета.ВаловаяПрибыль + " * " + Стр.Значение + "% = " + НовСтрока.Сумма; 
			
			НовСтрока.ДанныеРасшифровки = ЗначениеВСтрокуВнутр(расш);
		ИначеЕсли Стр.СпособРасчета = мен.РучнойВвод Тогда 
			Если ТипЗнч(Стр.Значение) = тип("Строка") ТОгда
				Если сокрлп(Стр.Значение) = "" Тогда
					НовСтрока.Сумма = 0;
				Иначе
            		НовСтрока.Сумма = число(Стр.Значение);
				КонецЕсли;
			Иначе
				НовСтрока.Сумма = Стр.Значение;
			КонецЕсли;
			
            расш = Новый Структура("Формула,ФормулаРезультат");
			расш.Формула = "Ручной ввод"; 
			расш.ФормулаРезультат = ""; 
			НовСтрока.ДанныеРасшифровки = ЗначениеВСтрокуВнутр(расш);
		ИначеЕсли Стр.СпособРасчета = мен.ВычисляемоеВыражение Тогда
            ПараметрыФормулы = Новый Структура("ДатаНачала, ДатаКонца, Организация");
            ЗаполнитьЗначенияСвойств(ПараметрыФормулы, ПараметрыЗапросов);
			
            Данные = ВычислитьФормулуФП(Док, Стр.Значение, ПараметрыФормулы, Стр.ИДСтрокиРаспределения, ДанныеРасчета);
            НовСтрока.Сумма = Данные.Значение;
            НовСтрока.ДанныеРасшифровки = ЗначениеВСтрокуВнутр(Данные);
            
            Если Не Данные.Вычислено Тогда
                ИА_БФКС.СообщениеОбОшибке(ИА_БФКС.Стр_ПодставитьПараметрыВСтроку(
                    "При вычислении формулы произошла ошибка по условию: Подразделение: '%3', Статья: '%4'"  + Символы.ПС
                    + " — Формула:    %1" + Символы.ПС
                    + " — Вычисление: %2" + Символы.ПС
                    + " — Описание ошибки: %5" 
                    , Данные.Формула, Данные.ФормулаРезультат, Стр.Подразделение, Стр.Статья, Данные.ТекстОшибки));
            КонецЕсли; 
		КонецЕсли;
		
		Если НеОчищатьРучные Тогда
			ОтборПД = Новый Структура("Раздел,Подразделение,Статья");
			ЗаполнитьЗначенияСвойств(ОтборПД,Стр);
			МСтарых = ТабСтарыхДанных.НайтиСтроки(ОтборПД);
			Для каждого стрСтар из МСтарых Цикл
				ЗаполнитьЗначенияСвойств(НовСтрока, стрСтар); 
			КонецЦикла;				
		КонецЕсли;
    КонецЦикла; 
    
    //{ В_ФП
    Док[ИмяТч].Загрузить(ДанныеРасчета.Политика2); 
	
КонецПроцедуры

функция ПолучитьФиксСуммуПоТБ(ТекНеделя, Организация, Подразделение, Фонд, ВидДохода)
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	п1.Сумма
	               |ИЗ
	               |	РегистрНакопления.КСУ_ЗаливкаПолитики1 КАК п1
	               |ГДЕ
	               |	п1.Неделя = &Неделя
				   |	И п1.ВидДохода = &ВидДохода
	               |	И п1.Подразделение = &Подразделение
	               |	И п1.Фонд = &Фонд
	               |	И (п1.Организация = &Организация
	               |			ИЛИ &Организация = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка))
	               |	И п1.ВидДвижения = ЗНАЧЕНИЕ(виддвижениянакопления.приход)";
	Запрос.УстановитьПараметр("Неделя", ТекНеделя);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Подразделение", Подразделение);
	Запрос.УстановитьПараметр("Фонд", Фонд);
	Запрос.УстановитьПараметр("ВидДохода", ВидДохода);
	
	Выборка = запрос.Выполнить().Выбрать();
	Если выборка.Следующий() тогда
		возврат выборка.Сумма;
	Иначе
		возврат 0;
	КонецЕсли;
КонецФункции

Процедура ЗаполнитьДокумент_РасчетПолитика1(Док, ДанныеРасчета, ДокНастройка, ПараметрыЗапросов, НеОчищатьРучные, ФпТБ, ИспДоходыПоПодразделениям, ТекПарам)
	
	ИмяТч = "Политика1";
	
    Если НеОчищатьРучные Тогда
    	ТабСтарыхДанных = ИА_БФС.ТЗ_ФильтрПоОтбору(Док[ИмяТч], Новый Структура("Вручную", Истина));
    Иначе
        ТабСтарыхДанных = Док[ИмяТч].ВыгрузитьКолонки();
	КонецЕсли; 
	
	СчитатьФиксПоТБ = ФпТБ и ТипЗнч(ДокНастройка)<>Тип("ДокументОбъект.ИА_ФП_Настройка");
	Если СчитатьФиксПоТБ Тогда	
		Если ТекПарам = Неопределено Тогда 
			Возврат; 
		КонецЕсли;
	КонецЕсли;
    
    мен = Перечисления.ИА_РежимРасчетаСуммы;
	Для каждого СтрДоход Из ДанныеРасчета.ДоходыИтого Цикл
		Если ИспДоходыПоПодразделениям тогда
        	Таб = ИА_БФС.ТЗ_ФильтрПоОтбору(ДокНастройка.Политика1, Новый Структура("ВидДохода, Подразделение", СтрДоход.ВидДохода, СтрДоход.Подразделение));
		Иначе
			Таб = ИА_БФС.ТЗ_ФильтрПоОтбору(ДокНастройка.Политика1, Новый Структура("ВидДохода", СтрДоход.ВидДохода));
		КонецЕсли;
                
        Для каждого Стр Из Таб Цикл
            НовСтрока = ДанныеРасчета.Политика1.Добавить();
            ЗаполнитьЗначенияСвойств(НовСтрока, Стр);
			
			Если Стр.СпособРасчета = мен.ФиксированнаяСумма Тогда
				Если СчитатьФиксПоТБ Тогда
					НовСтрока.Сумма = ПолучитьФиксСуммуПоТБ(ТекПарам.ТекНеделя, док.Организация, Стр.Подразделение, стр.Статья, стр.ВидДохода);
				Иначе
					Если ТипЗнч(Стр.Значение) = тип("Строка") ТОгда
	                	НовСтрока.Сумма = число(Стр.Значение);
					Иначе
						НовСтрока.Сумма = Стр.Значение;
					КонецЕсли;
				КонецЕсли;
				
				расш = Новый Структура("Формула,ФормулаРезультат");
				расш.Формула = "Фиксированная сумма"; 
				расш.ФормулаРезультат = "" + НовСтрока.Сумма; 
				НовСтрока.ДанныеРасшифровки = ЗначениеВСтрокуВнутр(расш);
			ИначеЕсли Стр.СпособРасчета = мен.Процент Тогда
                НовСтрока.Сумма = Окр(СтрДоход.Сумма * ?(ЗначениеЗаполнено(Стр.Значение),Стр.Значение,0) / 100, 2);
				//
				расш = Новый Структура("Формула,ФормулаРезультат");
				расш.Формула = ""+СтрДоход.ВидДохода + " * " + Стр.Значение + "%"; 
				расш.ФормулаРезультат = ""+СтрДоход.Сумма + " * " + Стр.Значение + "% = " + НовСтрока.Сумма; 
				НовСтрока.ДанныеРасшифровки = ЗначениеВСтрокуВнутр(расш);
			ИначеЕсли Стр.СпособРасчета = мен.РучнойВвод Тогда 
				Если ТипЗнч(Стр.Значение) = тип("Строка") ТОгда
					Если сокрлп(Стр.Значение) = "" Тогда
						НовСтрока.Сумма = 0;
					Иначе
                		НовСтрока.Сумма = число(Стр.Значение);
					КонецЕсли;
				Иначе
					НовСтрока.Сумма = Стр.Значение;
				КонецЕсли;
				
				расш = Новый Структура("Формула,ФормулаРезультат");
				расш.Формула = "Ручной ввод"; 
				расш.ФормулаРезультат = ""; 
				НовСтрока.ДанныеРасшифровки = ЗначениеВСтрокуВнутр(расш);
			ИначеЕсли Стр.СпособРасчета = мен.ВычисляемоеВыражение Тогда
                ПараметрыФормулы = Новый Структура("ДатаНачала, ДатаКонца, Организация");
                ЗаполнитьЗначенияСвойств(ПараметрыФормулы, ПараметрыЗапросов);
				
				ОтПодр = ?(ИспДоходыПоПодразделениям, стр.Подразделение, Неопределено);
                Данные = ВычислитьФормулуФП(Док, Стр.Значение, ПараметрыФормулы, стр.ИДСтрокиРаспределения, ДанныеРасчета, стр.ВидДохода, ОтПодр);
                НовСтрока.Сумма = Данные.Значение;
                НовСтрока.ДанныеРасшифровки = ЗначениеВСтрокуВнутр(Данные);
                
                Если Не Данные.Вычислено Тогда
                    ИА_БФКС.СообщениеОбОшибке(ИА_БФКС.Стр_ПодставитьПараметрыВСтроку(
                    "При вычислении формулы произошла ошибка по условию: ВидДохода: '%3', Подразделение: '%4', Статья: '%5'"  + Символы.ПС
                    + " — Формула:    %1" + Символы.ПС
                    + " — Вычисление: %2" + Символы.ПС
                    + " — Описание ошибки: %6" 
                    , Данные.Формула, Данные.ФормулаРезультат,Стр.ВидДохода, Стр.Подразделение, Стр.Статья, Данные.ТекстОшибки));
                КонецЕсли; 
			КонецЕсли;             
			
			НовСтрока.СуммаАвто = НовСтрока.Сумма;

			Если НеОчищатьРучные Тогда
				ОтборПД = Новый Структура("ВидДохода,Раздел,Подразделение,Статья");
				ЗаполнитьЗначенияСвойств(ОтборПД,Стр);
				МСтарых = ТабСтарыхДанных.НайтиСтроки(ОтборПД);
				Для каждого стрСтар из МСтарых Цикл
					ЗаполнитьЗначенияСвойств(НовСтрока, стрСтар,"Сумма,Вручную"); 
				КонецЦикла;				
			КонецЕсли;
        КонецЦикла;  
    КонецЦикла;  
    
    Док[ИмяТч].Загрузить(ДанныеРасчета.Политика1);  
	
КонецПроцедуры

Функция   НайтиПоследнийПоДатеДокумент(ИмяДокумента, Дата
    , ИсключаемыйДокумент = Неопределено, ДопПараметры = Неопределено) Экспорт
    
    ТекстЗапроса =
    #Область ТекстЗапроса
    "ВЫБРАТЬ
    |   Т.Ссылка,
    |   Т.Дата
    |ПОМЕСТИТЬ Таб
    |ИЗ
    |   Документ.АвансовыйОтчет КАК Т
    |ГДЕ
    |   Т.Проведен
    |   И Т.Дата <= &Дата
    |   И &ДопОтборИзмерения
    |   И Т.Ссылка <> &ИсключаемыйДокумент
    |;
    |
    |////////////////////////////////////////////////////////////////////////////////
    |ВЫБРАТЬ
    |   Таб.Ссылка Результат
    |ИЗ
    |   (ВЫБРАТЬ
    |       МАКСИМУМ(Таб.Дата) КАК Дата
    |   ИЗ
    |       Таб КАК Таб) КАК ВложенныйЗапрос
    |       ВНУТРЕННЕЕ СОЕДИНЕНИЕ Таб КАК Таб
    |       ПО ВложенныйЗапрос.Дата = Таб.Дата";
    #КонецОбласти 
    
    ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "Документ.АвансовыйОтчет", "Документ." + ИмяДокумента);
    
    ПЗ = Новый Структура("Дата, ИсключаемыйДокумент, ДопОтборИзмерения"
    , Дата
    , ИсключаемыйДокумент
    , Истина);
    Если ДопПараметры <> Неопределено Тогда
        ТекстУсловия = "";
        Для каждого КиЗ Из ДопПараметры Цикл
            ТекстУсловия = ТекстУсловия + Символы.ПС
            + " И " + КиЗ.Ключ + " = " + "&Парам_" + КиЗ.Ключ;
            ПЗ.Вставить("Парам_" + КиЗ.Ключ, КиЗ.Значение);
        КонецЦикла;  
        ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "И &ДопОтборИзмерения", ТекстУсловия);
    КонецЕсли; 
    
    Результат = ИА_БФС.Запрос_ВыполнитьСкалярный(ТекстЗапроса, ПЗ);
    
    Возврат Результат;
КонецФункции

Функция   ВычислитьФормулуФП(Док, ТекстФормулы, ПараметрыФормулы, ИДСтроки, ДанныеРасчета, ОтборВидДохода = Неопределено, ОтборПодразделение = Неопределено)
    Формула = ТекстФормулы;
    Результат = Новый Структура("Вычислено, Формула,ФормулаРезультат, Значение, ТекстОшибки, Расшифровка", Ложь, ТекстФормулы, "", 00000000000000.00, "");    
    Параметры = ИА_БФС.ТЗ_НоваяТаблицаЗначений("Параметр, Значение, Расшифровка");
	
	// запросы
	Нстр = Док.ЗапросыДанных.НайтиСтроки(Новый Структура("ИДСтроки", ИДСтроки));
	Для каждого Стр Из Нстр Цикл
		Если Найти(Формула, Стр.ИмяПараметра) > 0 Тогда
        	ИА_БФС.ТЗ_ДобавитьСтроку(Параметры, Стр.ИмяПараметра, Стр.Сумма, Стр.Расшифровка);
		КонецЕсли;
    КонецЦикла;
 
    
    // доходы
	Для каждого Стр Из ДанныеРасчета.ДоходыИтого Цикл
		Если ЗначениеЗаполнено(ОтборПодразделение) и Стр.Подразделение <> ОтборПодразделение Тогда
			Продолжить;
		КонецЕсли;
		
        Представление = "[Доход:" + Стр.ВидДохода + "]";
        Если Найти(Формула, Представление) > 0 Тогда
            ИА_БФС.ТЗ_ДобавитьСтроку(Параметры, Представление, Стр.Сумма);
        КонецЕсли; 
    КонецЦикла;  
    Представление   = "[ДоходыИтого]";
    Сумма           = ДанныеРасчета.ДоходыИтого.Итог("Сумма");
    Если Найти(Формула, Представление) > 0 Тогда
        ИА_БФС.ТЗ_ДобавитьСтроку(Параметры, Представление, Сумма);
    КонецЕсли;     
    

	// политика 1
	ВхСальдо = Сумма; // (доходы итого)
	ДанныеРасчета.Политика1.Сортировать("Раздел");
	сч = 0;
	кол = ДанныеРасчета.Политика1.Количество();
	ПредРаздел = Неопределено;
	СуммаРаздела = 0;
	Для каждого СтрСтатьи Из ДанныеРасчета.Политика1 Цикл
		Если СтрСтатьи.Сумма = Неопределено ТОгда
			Продолжить;
		КонецЕсли;
		
		Если ОтборВидДохода <> Неопределено И СтрСтатьи.ВидДохода<>ОтборВидДохода ТОгда
			Продолжить;
		КонецЕсли;
		
		Если ПредРаздел = Неопределено Тогда
			ПредРаздел = СтрСтатьи.Раздел;
		КонецЕсли;
		
		Представление = "[П1 Сумма:" + СтрСтатьи.Подразделение + "$" + СтрСтатьи.Статья+ "]";
		Если Найти(Формула, Представление) > 0 Тогда
			НовСтрокаПР1 = Параметры.Добавить();
	        НовСтрокаПР1.Параметр = Представление;
	        НовСтрокаПР1.Значение = СтрСтатьи.Сумма;
		КонецЕсли;
		
		сч = сч + 1;
		Если сч = Кол Тогда
			ВхСальдо = ВхСальдо - СтрСтатьи.Сумма;
			СуммаРаздела = СуммаРаздела + СтрСтатьи.Сумма; 
		КонецЕсли;
		
		Если сч = Кол ИЛИ СтрСтатьи.Раздел <> ПредРаздел Тогда	
			Представление = "[П1 СКД:"+ПредРаздел+"]";
			Если Найти(Формула, Представление) > 0 Тогда
				НовСтрокаПР1 = Параметры.Добавить();
		        НовСтрокаПР1.Параметр = Представление;
		        НовСтрокаПР1.Значение = ВхСальдо;
			КонецЕсли;
			
			Представление = "[П1 Итог:"+ПредРаздел+"]";
			Если Найти(Формула, Представление) > 0 Тогда
				НовСтрокаПР1 = Параметры.Добавить();
		        НовСтрокаПР1.Параметр = Представление;
		        НовСтрокаПР1.Значение = СуммаРаздела;
			КонецЕсли;
			
			СуммаРаздела = 0;
		КонецЕсли;
		
		ВхСальдо = ВхСальдо - СтрСтатьи.Сумма;
		СуммаРаздела = СуммаРаздела + СтрСтатьи.Сумма; 
		ПредРаздел = СтрСтатьи.Раздел;
	КонецЦикла; 
	
	Если Найти(Формула, "[ВалПрибыль]") > 0 Тогда
		ВалПриб = Параметры.Добавить();
	    ВалПриб.Параметр = "[ВалПрибыль]";
	    ВалПриб.Значение = ДанныеРасчета.ВаловаяПрибыль;
	КонецЕсли;
	
	// политика 2
	Если ДанныеРасчета.Свойство("ВаловаяПрибыль") Тогда
		ВхСальдо = ДанныеРасчета.ВаловаяПрибыль; 
	Иначе
		ВхСальдо = 0; // это формула политики 1. Тут не нужна вал прибыль
	КонецЕсли;
	ДанныеРасчета.Политика2.Сортировать("Раздел");
	сч = 0;
	кол = ДанныеРасчета.Политика2.Количество();
	ПредРаздел = Неопределено;
	СуммаРаздела = 0;
	Для каждого СтрСтатьи Из ДанныеРасчета.Политика2 Цикл
		Если СтрСтатьи.Сумма = Неопределено ТОгда
			СтрСтатьи.Сумма = 0;
			//Продолжить;
		КонецЕсли;
		
		Если ПредРаздел = Неопределено Тогда
			ПредРаздел = СтрСтатьи.Раздел;
		КонецЕсли;
		
		Представление = "[П2 Сумма:" + СтрСтатьи.Подразделение + "$" + СтрСтатьи.Статья+ "]";
		Если Найти(Формула, Представление) > 0 Тогда
	        НовСтрокаПР1 = Параметры.Добавить();
	        НовСтрокаПР1.Параметр = Представление;
	        НовСтрокаПР1.Значение = СтрСтатьи.Сумма;
		КонецЕсли;
		
		//ВхСальдо = ВхСальдо - СтрСтатьи.Сумма;
		//СуммаРаздела = СуммаРаздела + СтрСтатьи.Сумма; 
		
		сч = сч + 1;
		Если сч = Кол Тогда
			ВхСальдо = ВхСальдо - СтрСтатьи.Сумма;
			СуммаРаздела = СуммаРаздела + СтрСтатьи.Сумма; 
		КонецЕсли;
		Если сч = Кол ИЛИ СтрСтатьи.Раздел <> ПредРаздел Тогда	
			Представление = "[П2 СКД:"+ПредРаздел+"]";
			Если Найти(Формула, Представление) > 0 Тогда
				НовСтрокаПР1 = Параметры.Добавить();
		        НовСтрокаПР1.Параметр = Представление;
		        НовСтрокаПР1.Значение = ВхСальдо;
			КонецЕсли;
			
			Представление = "[П2 Итог:"+ПредРаздел+"]";
			Если Найти(Формула, Представление) > 0 Тогда
				НовСтрокаПР1 = Параметры.Добавить();
		        НовСтрокаПР1.Параметр = Представление;
		        НовСтрокаПР1.Значение = СуммаРаздела;
			КонецЕсли;
			
			СуммаРаздела = 0;
		КонецЕсли;
		
		ВхСальдо = ВхСальдо - СтрСтатьи.Сумма;
		СуммаРаздела = СуммаРаздела + СтрСтатьи.Сумма; 
		ПредРаздел = СтрСтатьи.Раздел;
    КонецЦикла;

	
	//
    Для каждого Стр Из Параметры Цикл
        Формула = СтрЗаменить(Формула, Стр.Параметр, Формат(число(Стр.Значение), "ЧРД=.; ЧН=; ЧГ="));
    КонецЦикла;  
    
    Результат.Расшифровка = Параметры;
    
    Попытка
        //Формула = СтрЗаменить(Формула, ",", ".");
        Результат.ФормулаРезультат = Формула;
        
        Если ЗначениеЗаполнено(Формула) Тогда
        	Результат.Значение = Вычислить(Формула);
        Иначе
            Результат.Значение = 0;
        КонецЕсли; 
        
        
        Результат.Значение = Окр(Результат.Значение, 2);
        Результат.Вычислено = Истина;
    Исключение
        Результат.ТекстОшибки = ОписаниеОшибки();
    КонецПопытки; 
    
    Возврат Результат;
КонецФункции
  
Функция ДополнитьПользовательскимиПараметрами(ПараметрыЗапросов, ИДСтроки, ПользовательскиеПараметры)
	Если ПользовательскиеПараметры <> Неопределено И ПользовательскиеПараметры.Свойство(ИДСтроки) Тогда 
		ПараметрыСтроки = ПользовательскиеПараметры[ИДСтроки];
		Для каждого Элемент Из ПараметрыСтроки Цикл 
			ПараметрыЗапросов.Вставить(Элемент.Ключ, Элемент.Значение);		
		КонецЦикла;
	КонецЕсли; 
	Возврат ПараметрыЗапросов; 
КонецФункции

Функция ФП_ПолучитьОстаткиНаФондах(МоментВремени, Организация) Экспорт
    МассивОрганизаций = МассивОрганизацийФП(Организация);
    
    Результат = ИА_БФС.Запрос_ВыполнитьВСтруктуру(
    "ВЫБРАТЬ
    |   СУММА(Т.ОстатокНал) КАК ОстатокСвНал,
    |   СУММА(Т.ОстатокБезНал) КАК ОстатокСвБезНал,
    |   СУММА(Т.Остаток) КАК ОстатокСв,
    |   СУММА(Т.ОстатокРезервНал) КАК ОстатокРезервНал,
    |   СУММА(Т.ОстатокРезервБезНал) КАК ОстатокРезервБезНал,
    |   СУММА(Т.ОстатокРезерв) КАК ОстатокРезерв,
    |   СУММА(Т.ОстатокРезерв + Т.Остаток) КАК ОстатокВсего
    |ИЗ
    |   (ВЫБРАТЬ
    |       ИА_СредстваНаФондахОстатки.СуммаНалОстаток КАК ОстатокНал,
    |       ИА_СредстваНаФондахОстатки.СуммаБезналОстаток КАК ОстатокБезНал,
    |       ИА_СредстваНаФондахОстатки.СуммаНалОстаток + ИА_СредстваНаФондахОстатки.СуммаБезналОстаток КАК Остаток,
    |       0 КАК ОстатокРезервНал,
    |       0 КАК ОстатокРезервБезНал,
    |       0 КАК ОстатокРезерв
    |   ИЗ
    |       РегистрНакопления.ИА_СредстваНаФондах.Остатки(&МВ, Организация В (&СписокОрганизация)) КАК ИА_СредстваНаФондахОстатки
    |   
    |   ОБЪЕДИНИТЬ ВСЕ
    |   
    |   ВЫБРАТЬ
    |       0,
    |       0,
    |       0,
    |       ИА_СредстваВРезервеНаФондахОстатки.СуммаНалОстаток,
    |       ИА_СредстваВРезервеНаФондахОстатки.СуммаБезналОстаток,
    |       ИА_СредстваВРезервеНаФондахОстатки.СуммаНалОстаток + ИА_СредстваВРезервеНаФондахОстатки.СуммаБезналОстаток
    |   ИЗ
    |       РегистрНакопления.ИА_СредстваВРезервеНаФондах.Остатки(&МВ, Организация В (&СписокОрганизация)) КАК ИА_СредстваВРезервеНаФондахОстатки) КАК Т"
    , Новый Структура("МВ, СписокОрганизация", МоментВремени, МассивОрганизаций)); 
    
    
    Возврат Результат;    
КонецФункции

Функция ПолучитьТЗЗаймов(НаДату, Организация, НеРазделять, ТаблицаТекДок, ВключаяТекЗаймы = истина) Экспорт
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	ТекДок.ид КАК ид,
	|	ТекДок.Фонд КАК Фонд,
	|	ТекДок.Подразделение КАК Подразделение,
	|	ТекДок.СФонда КАК СФонда,
	|	ТекДок.СПодразделения КАК СПодразделения,
	|	ТекДок.ПричинаЗайма КАК ПричинаЗайма,
	|	ТекДок.Комментарий КАК Комментарий,
	|	ТекДок.КрайнийСрок КАК КрайнийСрок,
	|	ТекДок.СуммаБезнал КАК СуммаБезнал,
	|	ТекДок.ЗаймВозврат КАК ЗаймВозврат,
	|	ТекДок.ИсточникОтложенногоДохода КАК ИсточникОтложенногоДохода
	|ПОМЕСТИТЬ ВТЗ
	|ИЗ
	|	&ТЗ КАК ТекДок
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЛОЖЬ КАК Выбрать,
	|	ПодЗапрос.ид КАК ид,
	|	ВЫБОР
	|		КОГДА ПодЗапрос.ид = ЗНАЧЕНИЕ(Справочник.КСУ_Займы.ПереходНа84)
	|				ИЛИ ПодЗапрос.ЭтоТекДок
	|			ТОГДА ПодЗапрос.ПричинаЗайма
	|		ИНАЧЕ ПодЗапрос.ид.ПричинаЗайма
	|	КОНЕЦ КАК ПричинаЗайма,
	|	ВЫБОР
	|		КОГДА ПодЗапрос.ЭтоТекДок И ПодЗапрос.Сумма > 0
	|			ТОГДА &НаДату
	|		ИНАЧЕ ПодЗапрос.ид.ДатаЗайма
	|	КОНЕЦ КАК ДатаЗайма,
	|	ВЫБОР
	|		КОГДА ПодЗапрос.ид = ЗНАЧЕНИЕ(Справочник.КСУ_Займы.ПереходНа84)
	|				ИЛИ ПодЗапрос.ЭтоТекДок
	|			ТОГДА ПодЗапрос.Сфонда
	|		ИНАЧЕ ПодЗапрос.ид.НаФонд
	|	КОНЕЦ КАК Фонд,
	|	ВЫБОР
	|		КОГДА ПодЗапрос.ид = ЗНАЧЕНИЕ(Справочник.КСУ_Займы.ПереходНа84)
	|				ИЛИ ПодЗапрос.ЭтоТекДок
	|			ТОГДА ПодЗапрос.СПодразделения
	|		ИНАЧЕ ПодЗапрос.ид.НаПодразделение
	|	КОНЕЦ КАК Подразделение,
	|	ВЫБОР
	|		КОГДА ПодЗапрос.ид = ЗНАЧЕНИЕ(Справочник.КСУ_Займы.ПереходНа84)
	|				ИЛИ ПодЗапрос.ЭтоТекДок
	|			ТОГДА ПодЗапрос.Фонд
	|		ИНАЧЕ ПодЗапрос.ид.СФонда
	|	КОНЕЦ КАК СФонда,
	|	ВЫБОР
	|		КОГДА ПодЗапрос.ид = ЗНАЧЕНИЕ(Справочник.КСУ_Займы.ПереходНа84)
	|				ИЛИ ПодЗапрос.ЭтоТекДок
	|			ТОГДА ПодЗапрос.Подразделение
	|		ИНАЧЕ ПодЗапрос.ид.СПодразделения
	|	КОНЕЦ КАК СПодразделения,
	|	ВЫБОР
	|		КОГДА ПодЗапрос.ид = ЗНАЧЕНИЕ(Справочник.КСУ_Займы.ПереходНа84)
	|				ИЛИ ПодЗапрос.ЭтоТекДок
	|			ТОГДА ПодЗапрос.Комментарий
	|		ИНАЧЕ ПодЗапрос.ид.Комментарий
	|	КОНЕЦ КАК Комментарий,
	|	ВЫБОР
	|		КОГДА ПодЗапрос.ид = ЗНАЧЕНИЕ(Справочник.КСУ_Займы.ПереходНа84)
	|				ИЛИ ПодЗапрос.ЭтоТекДок
	|			ТОГДА ПодЗапрос.КрайнийСрок
	|		ИНАЧЕ ПодЗапрос.ид.КрайнийСрок
	|	КОНЕЦ КАК КрайнийСрок,
	|	ВЫБОР
	|		КОГДА ПодЗапрос.ид = ЗНАЧЕНИЕ(Справочник.КСУ_Займы.ПереходНа84)
	|				ИЛИ ПодЗапрос.ЭтоТекДок
	|			ТОГДА ПодЗапрос.ИсточникОтложенногоДохода
	|		ИНАЧЕ ПодЗапрос.ид.ИсточникОтложенногоДохода
	|	КОНЕЦ КАК ИсточникОтложенногоДохода,
	|	СУММА(ПодЗапрос.Сумма) КАК Сумма
	|ИЗ
	|	(ВЫБРАТЬ
	|		ИА_ЗаймыСФондовОстатки.Фонд КАК Фонд,
	|		ИА_ЗаймыСФондовОстатки.Подразделение КАК Подразделение,
	|		ИА_ЗаймыСФондовОстатки.НаФонд КАК СФонда,
	|		ИА_ЗаймыСФондовОстатки.НаПодразделение КАК СПодразделения,
	|		ИА_ЗаймыСФондовОстатки.ПричинаЗайма КАК ПричинаЗайма,
	|		ИА_ЗаймыСФондовОстатки.ид.Комментарий КАК Комментарий,
	|		ИА_ЗаймыСФондовОстатки.КрайнийСрок КАК КрайнийСрок,
	|		ИА_ЗаймыСФондовОстатки.ИсточникОтложенногоДохода КАК ИсточникОтложенногоДохода,
	|		ИА_ЗаймыСФондовОстатки.СуммаБезналОстаток КАК Сумма,
	|		ИА_ЗаймыСФондовОстатки.ид КАК ид,
	|		ЛОЖЬ КАК ЭтоТекДок
	|	ИЗ
	|		РегистрНакопления.ИА_ЗаймыСФондов.Остатки(
	|				&НаДату,
	|				Организация = &Организация
	|					ИЛИ &НеРазделять) КАК ИА_ЗаймыСФондовОстатки
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		ТекДок.Фонд,
	|		ТекДок.Подразделение,
	|		ТекДок.СФонда,
	|		ТекДок.СПодразделения,
	|		ТекДок.ПричинаЗайма,
	|		ТекДок.ид.Комментарий,
	|		ТекДок.КрайнийСрок,
	|		ТекДок.ИсточникОтложенногоДохода,
	|		-ТекДок.СуммаБезнал,
	|		ТекДок.ид,
	|		ИСТИНА
	|	ИЗ
	|		ВТЗ КАК ТекДок
	|	ГДЕ
	|		ТекДок.ЗаймВозврат = ЗНАЧЕНИЕ(Перечисление.ИА_ЗаймВозврат.Возврат)
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		ТекДок.СФонда,
	|		ТекДок.СПодразделения,
	|		ТекДок.Фонд,
	|		ТекДок.Подразделение,
	|		ТекДок.ПричинаЗайма,
	|		ТекДок.Комментарий,
	|		ТекДок.КрайнийСрок,
	|		ТекДок.ИсточникОтложенногоДохода,
	|		ТекДок.СуммаБезнал,
	|		ТекДок.ид,
	|		ИСТИНА
	|	ИЗ
	|		ВТЗ КАК ТекДок
	|	ГДЕ
	|		ТекДок.ЗаймВозврат = ЗНАЧЕНИЕ(Перечисление.ИА_ЗаймВозврат.Займ)
	|		И &ВключаяТекЗаймы = ИСТИНА) КАК ПодЗапрос
	|
	|СГРУППИРОВАТЬ ПО
	|	ПодЗапрос.ид,
	|	ВЫБОР
	|		КОГДА ПодЗапрос.ид = ЗНАЧЕНИЕ(Справочник.КСУ_Займы.ПереходНа84)
	|				ИЛИ ПодЗапрос.ЭтоТекДок
	|			ТОГДА ПодЗапрос.ПричинаЗайма
	|		ИНАЧЕ ПодЗапрос.ид.ПричинаЗайма
	|	КОНЕЦ,
	|	ВЫБОР
	|		КОГДА ПодЗапрос.ЭтоТекДок И ПодЗапрос.Сумма > 0
	|			ТОГДА &НаДату
	|		ИНАЧЕ ПодЗапрос.ид.ДатаЗайма
	|	КОНЕЦ,
	|	ВЫБОР
	|		КОГДА ПодЗапрос.ид = ЗНАЧЕНИЕ(Справочник.КСУ_Займы.ПереходНа84)
	|				ИЛИ ПодЗапрос.ЭтоТекДок
	|			ТОГДА ПодЗапрос.Сфонда
	|		ИНАЧЕ ПодЗапрос.ид.НаФонд
	|	КОНЕЦ,
	|	ВЫБОР
	|		КОГДА ПодЗапрос.ид = ЗНАЧЕНИЕ(Справочник.КСУ_Займы.ПереходНа84)
	|				ИЛИ ПодЗапрос.ЭтоТекДок
	|			ТОГДА ПодЗапрос.СПодразделения
	|		ИНАЧЕ ПодЗапрос.ид.НаПодразделение
	|	КОНЕЦ,
	|	ВЫБОР
	|		КОГДА ПодЗапрос.ид = ЗНАЧЕНИЕ(Справочник.КСУ_Займы.ПереходНа84)
	|				ИЛИ ПодЗапрос.ЭтоТекДок
	|			ТОГДА ПодЗапрос.Фонд
	|		ИНАЧЕ ПодЗапрос.ид.СФонда
	|	КОНЕЦ,
	|	ВЫБОР
	|		КОГДА ПодЗапрос.ид = ЗНАЧЕНИЕ(Справочник.КСУ_Займы.ПереходНа84)
	|				ИЛИ ПодЗапрос.ЭтоТекДок
	|			ТОГДА ПодЗапрос.Подразделение
	|		ИНАЧЕ ПодЗапрос.ид.СПодразделения
	|	КОНЕЦ,
	|	ВЫБОР
	|		КОГДА ПодЗапрос.ид = ЗНАЧЕНИЕ(Справочник.КСУ_Займы.ПереходНа84)
	|				ИЛИ ПодЗапрос.ЭтоТекДок
	|			ТОГДА ПодЗапрос.Комментарий
	|		ИНАЧЕ ПодЗапрос.ид.Комментарий
	|	КОНЕЦ,
	|	ВЫБОР
	|		КОГДА ПодЗапрос.ид = ЗНАЧЕНИЕ(Справочник.КСУ_Займы.ПереходНа84)
	|				ИЛИ ПодЗапрос.ЭтоТекДок
	|			ТОГДА ПодЗапрос.КрайнийСрок
	|		ИНАЧЕ ПодЗапрос.ид.КрайнийСрок
	|	КОНЕЦ,
	|	ВЫБОР
	|		КОГДА ПодЗапрос.ид = ЗНАЧЕНИЕ(Справочник.КСУ_Займы.ПереходНа84)
	|				ИЛИ ПодЗапрос.ЭтоТекДок
	|			ТОГДА ПодЗапрос.ИсточникОтложенногоДохода
	|		ИНАЧЕ ПодЗапрос.ид.ИсточникОтложенногоДохода
	|	КОНЕЦ  
	|    
	|ИМЕЮЩИЕ
	|	СУММА(ПодЗапрос.Сумма) > 0";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("НеРазделять", НеРазделять);
	Запрос.УстановитьПараметр("НаДату", НаДату);
	Запрос.УстановитьПараметр("ТЗ", ТаблицаТекДок);
	Запрос.УстановитьПараметр("ВключаяТекЗаймы", ВключаяТекЗаймы);
	
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

Функция ПолучитьНедели(месяц) Экспорт
		
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ИА_РаспределениеНедель.Период КАК НачалоНедели,
	               |	КОЛИЧЕСТВО(Периоды.Период) КАК КолДней,
	               |	ИА_РаспределениеНедель.КонецНедели КАК КонецНедели
	               |ИЗ
	               |	РегистрСведений.ИА_РаспределениеНедель КАК ИА_РаспределениеНедель
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИА_Календарь КАК Периоды
	               |		ПО (Периоды.Период МЕЖДУ ИА_РаспределениеНедель.Период И ИА_РаспределениеНедель.КонецНедели)
	               |ГДЕ
	               |	ИА_РаспределениеНедель.Месяц = &Месяц
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ИА_РаспределениеНедель.Период,
	               |	ИА_РаспределениеНедель.КонецНедели
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	НачалоНедели";
	Запрос.УстановитьПараметр("Месяц", Месяц);	
	
	тз = Запрос.Выполнить().Выгрузить();
	Возврат тз;
КонецФункции

Функция ПолучитьФСЧисла(пЧисло) Экспорт
	ЦелаяЧасть = Цел(пЧисло);
	Копейки = (пЧисло - ЦелаяЧасть) * 100;
	ЦветТ = ?(пЧисло = 0, Новый цвет(170, 170, 170),  Новый цвет(0, 0, 0));
	ШрифтТ = Новый шрифт(,12);
	ШрифтТк = Новый шрифт(,8);
	рез1 = новый ФорматированнаяСтрока(формат(ЦелаяЧасть,"ЧДЦ=0; ЧН="),ШрифтТ, ЦветТ);
	рез2 = новый ФорматированнаяСтрока("," + формат(Копейки,"ЧЦ=2; ЧДЦ=0; ЧН=; ЧВН="),ШрифтТк, ЦветТ);
	
	возврат новый ФорматированнаяСтрока(рез1,рез2);
КонецФункции

Функция ОстатокРезерва(заказ, Дата) Экспорт
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("НаДату", дата);
	Запрос.УстановитьПараметр("заказ", заказ);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЕСТЬNULL(ИА_СредстваВРезервеНаФондахОстатки.СуммаБезналОстаток, 0) КАК ОстатокРезерва
	               |ИЗ
	               |	РегистрНакопления.ИА_СредстваВРезервеНаФондах.Остатки(&НаДату, ЗП = &заказ) КАК ИА_СредстваВРезервеНаФондахОстатки";
	Выборка = запрос.Выполнить().Выбрать();
	рез = 0;
	Если выборка.Следующий() Тогда
		рез = выборка.ОстатокРезерва;
	КонецЕсли;
	
	Возврат рез;
КонецФункции

Функция ПолучитьТекстСсылкиНаВДПС(ссылкаПлатежка) Экспорт
	сс = ПолучитьСсылкуНаВДПС(ссылкаПлатежка);
	Если сс = Неопределено Тогда
		возврат "";
	Иначе
		возврат строка(сс);
	КонецЕсли;
	
КонецФункции

Функция ПолучитьСсылкуНаВДПС(ссылкаПлатежка) Экспорт
	если ссылкаПлатежка.пустая() Тогда
		возврат Неопределено;
	КонецЕсли;
	
	Запрос = новый запрос;
	запрос.Текст = "ВЫБРАТЬ
	               |	КСУ_ВнедоходноеПоступлениеСредств.Ссылка КАК Ссылка
	               |ИЗ
	               |	Документ.КСУ_ВнедоходноеПоступлениеСредств КАК КСУ_ВнедоходноеПоступлениеСредств
	               |ГДЕ
	               |	КСУ_ВнедоходноеПоступлениеСредств.Основание = &Основание
	               |	И КСУ_ВнедоходноеПоступлениеСредств.ПометкаУдаления = ложь";
	Запрос.УстановитьПараметр("Основание", ссылкаПлатежка);
	Выборка = запрос.Выполнить().Выбрать();
	
	Если выборка.Следующий() Тогда
		Возврат выборка.ссылка;		
	КонецЕсли;
	
	возврат Неопределено;
КонецФункции

Функция СоздатьВДПС(ссылкаПлатежка) Экспорт
	если ссылкаПлатежка.пустая() Тогда
		возврат Неопределено;
	КонецЕсли;
	
	ДокОб = Документы.КСУ_ВнедоходноеПоступлениеСредств.СоздатьДокумент();
	ДокОб.Заполнить(новый Структура("Ссылка, ЭтоПлатежка", ссылкаПлатежка, Истина));
	ДокОб.Записать();
	
	возврат ДокОб.Ссылка;
КонецФункции

Процедура ИзменитьПорядокВидаСтатистики(пВид, Направление, СПомеченными) Экспорт
	Запрос = новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ИА_ВидыСтатистик.Ссылка КАК Ссылка
	               |ИЗ
	               |	Справочник.ИА_ВидыСтатистик КАК ИА_ВидыСтатистик
	               |ГДЕ
	               |	ИА_ВидыСтатистик.Родитель = &Родитель
	               |	И (ИА_ВидыСтатистик.ПометкаУдаления = ЛОЖЬ
	               |			ИЛИ &СПомеченными = ИСТИНА)
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ИА_ВидыСтатистик.Порядок";
	Запрос.УстановитьПараметр("Родитель", Справочники.ИА_ВидыСтатистик.СтатистикиФП);
	Запрос.УстановитьПараметр("СПомеченными", СПомеченными);
	тз = запрос.Выполнить().Выгрузить();
	
	стр = тз.Найти(пВид);
	Если стр <> Неопределено Тогда
		Попытка
			тз.Сдвинуть(стр, Направление);
		Исключение
			возврат;
		КонецПопытки;
		
		ТекПорядок = 1;
		для каждого стрВид из тз цикл
			об = стрВид.Ссылка.ПолучитьОбъект();
			об.Порядок = ТекПорядок;
			об.записать();
			
			ТекПорядок = ТекПорядок + 1;
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

Функция ПолучитьОстатокОтлДохода(НаДату, Организация)  Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЕСТЬNULL(СУММА(ИА_ДоходыБудущихПериодов.СуммаБезналОстаток),0) КАК СуммаБезналОстаток
	               |ИЗ
	               |	РегистрНакопления.ИА_ДоходыБудущихПериодов.Остатки(
	               |			&ДатаОстатков,
	               |			Организация = &Организация
	               |				ИЛИ &НеРазделять) КАК ИА_ДоходыБудущихПериодов
	               |ГДЕ
	               |	ИА_ДоходыБудущихПериодов.СуммаБезналОстаток > 0";
	Запрос.УстановитьПараметр("ДатаОстатков", новый Граница(НаДату,ВидГраницы.Исключая));
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("НеРазделять", не Константы.ИА_ФП_ВестиФППоОрганизациям.Получить());
	
	Выборка = запрос.Выполнить().Выбрать();
	
	Если выборка.Следующий() тогда
		возврат выборка.СуммаБезналОстаток;
	Иначе
		возврат 0;
	КонецЕсли;

КонецФункции

