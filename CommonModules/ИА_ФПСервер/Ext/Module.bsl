Функция   ФП2(Дата) Экспорт
    ДатаПерехода = ИА_БФСПИ.Константа_Значение("ДатаНачалаИспользованияФП2");
    Если ТипЗнч(ДатаПерехода) <> Тип("Дата")
        ИЛИ НЕ ЗначениеЗаполнено(ДатаПерехода)
        Тогда
        ДатаПерехода = Дата(2099,1,1);
    КонецЕсли; 
    
	Возврат НЕ ЗначениеЗаполнено(Дата) ИЛИ НачалоДня(Дата) >= ДатаПерехода;
КонецФункции

Функция   СтруктураВТЗ(Струк)
    ТЗ = ИА_БФС.ТЗ_НоваяТаблицаЗначений("Ключ, Значение");
    Для каждого КиЗ Из Струк Цикл
        ЗаполнитьЗначенияСвойств(ТЗ.Добавить(), КиЗ);
    КонецЦикла;		
    
    Возврат ТЗ;
КонецФункции

Процедура ЗаполнитьЗапросы(Док, ДокНастройка, ПараметрыЗапросов, ПользовательскиеНастройки)
	Док.ЗапросыДанных.Очистить();
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ИА_ЗапросыДанныхФондов.Ссылка,
	|	""[Запрос:"" + ИА_ЗапросыДанныхФондов.Наименование + ""]"" КАК Наименование
	|ИЗ
	|	Справочник.ИА_ЗапросыДанныхФондов КАК ИА_ЗапросыДанныхФондов
	|ГДЕ
	|	ИА_ЗапросыДанныхФондов.ПометкаУдаления = ЛОЖЬ";
	
	тз_Запросы = Запрос.Выполнить().Выгрузить();
	
	Если тз_Запросы.Количество() = 0 Тогда
		Возврат;	
	КонецЕсли;
	
	ИспЗапросы = Новый Массив;
	
	Для каждого стрФ из ДокНастройка.ВидыДоходов Цикл
		Для каждого стрЗапр из тз_Запросы Цикл
			Если найти("[Запрос:"+стрФ.Значение +"]",стрЗапр.Наименование)>0 Тогда
				ИспЗапросы.Добавить(Новый Структура("Ссылка, Наименование, ИД",стрЗапр.Ссылка, стрЗапр.Наименование,  СтрЗаменить(стрФ.ИДСтроки, " ", ""))); 
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	Для каждого стрФ из ДокНастройка.Политика1 Цикл
		Для каждого стрЗапр из тз_Запросы Цикл
			Если найти("[Запрос:"+стрФ.Значение+"]",стрЗапр.Наименование)>0 Тогда
				ИспЗапросы.Добавить(Новый Структура("Ссылка, Наименование, ИД",стрЗапр.Ссылка, стрЗапр.Наименование,  СтрЗаменить(стрФ.ИДСтрокиРаспределения, " ", ""))); 
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	Для каждого стрФ из ДокНастройка.Политика2 Цикл
		Для каждого стрЗапр из тз_Запросы Цикл
			Если найти("[Запрос:"+стрФ.Значение+"]",стрЗапр.Наименование)>0 Тогда
				ИспЗапросы.Добавить(Новый Структура("Ссылка, Наименование, ИД",стрЗапр.Ссылка, стрЗапр.Наименование,  СтрЗаменить(стрФ.ИДСтрокиРаспределения, " ", ""))); 
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
		
	Для каждого Запр из ИспЗапросы Цикл
		ПараметрыЗапроса1 = Новый Структура("ДатаНачала, ДатаКонца, Организация");
        ЗаполнитьЗначенияСвойств(ПараметрыЗапроса1, ПараметрыЗапросов);
		ПараметрыЗапроса1 = ДополнитьПользовательскимиПараметрами(ПараметрыЗапросов, Запр.ИД, ПользовательскиеНастройки); 
		
		Данные = КСУ_ФП_Веб_Общее.ВыполнитьЗапрос(Запр.Ссылка, ПараметрыЗапроса1);
		
		НовСтр = Док.ЗапросыДанных.Добавить();
		НовСтр.ИДСтроки = Запр.ИД;
		НовСтр.Запрос = Запр.Ссылка;
		НовСтр.ИмяПараметра = Запр.Наименование;
		
        Если Данные.Выполнен Тогда
            НовСтр.Сумма = Окр(Данные.Таб.Итог("Сумма"), 2);
            НовСтр.Расшифровка = ЗначениеВСтрокуВнутр(Данные);
        Иначе
            НовСтр.Сумма = 0;
            ВызватьИсключение ИА_БФКС.Стр_ПодставитьПараметрыВСтроку(
            "При получении данных по запрос '%1' возникла ошибка: %2"
            , Запр.Ссылка, Данные.ТекстОшибки);
		КонецЕсли;		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьДокумент(Док
    , ЗаполнитьДоходы           = Истина
    , ЗаполнитьДоходыИтого      = Истина
    , ЗаполнитьПолитику1        = Истина
	, ЗаполнитьПолитику2        = Истина
	, ЗаполнитьЗапросы          = Ложь
	, НеОчищатьРучные           = Ложь
	, ДокПредФП 				= Неопределено
	, ФпТБ 						= ложь 
	, ДокНастройка				= Неопределено
	, ИспДоходыПоПодразделениям	= ложь) Экспорт
    
    ФППоОрганизациям              = Константы.ИА_ФП_ВестиФППоОрганизациям.Получить();
	
	ТекПарамПериодов = ПолучитьПараметрыТекРаспределения(док.Организация, Док.Дата);
	
	Если ТекПарамПериодов <> Неопределено тогда
		Док.НеделяТБ = ТекПарамПериодов.ТекНеделя;
		Док.МесяцТБ = ТекПарамПериодов.ТекМесяц;
	КонецЕсли;
    
    Если ФППоОрганизациям Тогда
        ОтборДокументовФП = Новый Структура("Организация", Док.Организация);
    Иначе
        ОтборДокументовФП = Новый Структура;
    КонецЕсли; 
	
	док.МаржаПоПодразделениям.Очистить();
	док.ИтогоВЗаливкуПодразделениям.Очистить();
	
	Если ДокНастройка = Неопределено Тогда 
		Если ТекПарамПериодов = Неопределено Тогда
			ДокНастройка = Документы.ИА_ФП_Настройка.ПустаяСсылка();
			Док.ТБ =  ДокНастройка;
		Иначе
    		Запрос = новый запрос;
			Запрос.Текст = "ВЫБРАТЬ
			               |	ИА_ФП_Настройка.Ссылка КАК Ссылка
			               |ИЗ
			               |	Документ.ИА_ФП_Настройка КАК ИА_ФП_Настройка
			               |ГДЕ
			               |	ИА_ФП_Настройка.Организация = &Организация
			               |	И ИА_ФП_Настройка.Проведен = ИСТИНА
			               |	И ИА_ФП_Настройка.Месяц = &Месяц
			               |	И ИА_ФП_Настройка.Месяц <> ДАТАВРЕМЯ(1, 1, 1)
			               |
			               |УПОРЯДОЧИТЬ ПО
			               |	ИА_ФП_Настройка.Дата УБЫВ";
			Запрос.УстановитьПараметр("Организация", Док.Организация);
			Запрос.УстановитьПараметр("Месяц", ТекПарамПериодов.ТекМесяц);
			Выборка = запрос.Выполнить().Выбрать();
			Если выборка.Следующий() Тогда
				ДокНастройка = выборка.ссылка;		
			Иначе
				ДокНастройка = Документы.ИА_ФП_Настройка.ПустаяСсылка();
				Сообщить("На выбранный период нет ТБ!");
			КонецЕсли;
			Док.ТБ =  ДокНастройка;
		КонецЕсли;
		
		Док.ДатаПроведенияТБ =  Док.ТБ.ДатаПроведения;
	КонецЕсли;
	
	
    
    //ПараметрыЗапросов = Новый Структура("ДатаНачала, ДатаКонца, Организация", ?(ЗначениеЗаполнено(ДокПредФП), ДокПредФП.Дата, Дата(1,1,1)) + 1, Док.Дата, Док.Организация);
	Если ЗначениеЗаполнено(Док.Доходы_ДатаНачала) тогда
		Доходы_ДатаНачала = Док.Доходы_ДатаНачала;
		Доходы_ДатаКонца = Док.Дата;
	Иначе
		Если ДокПредФП = Неопределено тогда
	    	ДокПредФП    = НайтиПоследнийПоДатеДокумент("ИА_ФинансовоеПланирование", Док.Дата, Док.Ссылка, ОтборДокументовФП); 
		КонецЕсли;
		Доходы_ДатаНачала = ?(ЗначениеЗаполнено(ДокПредФП), ДокПредФП.Дата, Док.Дата - 60*60*24*7) + 1;
		Доходы_ДатаКонца = Док.Дата;
	КонецЕсли;
	
	ПараметрыЗапросов = Новый Структура("ДатаНачала, ДатаКонца, Организация", Доходы_ДатаНачала, Доходы_ДатаКонца, Док.Организация);
	
    ДанныеРасчета = Новый Структура;
    // "Доходы"
    ДанныеРасчета.Вставить("Доходы", ИА_БФС.ТЗ_НоваяТаблицаЗначений("Подразделение, ВидДохода, СпособЗаполнения, Сумма, СуммаНал, СуммаБезнал, ДанныеРасшифровки"));
    ДанныеРасчета.Вставить("ДоходыИзСпецДоходов", ИА_БФС.ТЗ_НоваяТаблицаЗначений("Подразделение, ВидДохода, Сумма, СуммаБезНал, СуммаНал"));
    ДанныеРасчета.Вставить("ДоходыИзСписанияФондов", ИА_БФС.ТЗ_НоваяТаблицаЗначений("Подразделение, ВидДохода, Сумма, СуммаБезНал, СуммаНал"));
    ДанныеРасчета.Вставить("ДоходыВСпецДоход", ИА_БФС.ТЗ_НоваяТаблицаЗначений("Подразделение, ВидДохода, Сумма, СуммаБезНал, СуммаНал"));
    ДанныеРасчета.Вставить("ДоходыИтого", ИА_БФС.ТЗ_НоваяТаблицаЗначений("Подразделение, ВидДохода, Сумма, СуммаБезНал, СуммаНал"));
	
    // Распределение политика 1
    ДанныеРасчета.Вставить("Политика1", ИА_БФС.ТЗ_НоваяТаблицаЗначений("ВидДохода, Раздел, Подразделение, Статья, СпособРасчета, Сумма, СуммаАвто, ДанныеРасшифровки,Вручную"));
	ДанныеРасчета.Вставить("Политика2", ИА_БФС.ТЗ_НоваяТаблицаЗначений("ВидДохода, Раздел, Подразделение, Статья, СпособРасчета, Сумма, ДанныеРасшифровки,Вручную"));
	ДанныеРасчета.Вставить("УчредительскиеФонды", ИА_БФС.ТЗ_НоваяТаблицаЗначений("Подразделение, Фонд, Сумма"));
	
	ПользовательскиеНастройки = ДокНастройка.ХранилищеПараметров.Получить();
	
	Если ЗаполнитьЗапросы Тогда
		ЗаполнитьЗапросы(Док, ДокНастройка, ПараметрыЗапросов, ПользовательскиеНастройки);
	КонецЕсли;
	
	Если ЗаполнитьДоходы Тогда
		//ПредТЗРучные = Док.Доходы.Выгрузить();
		//ПредТЗРучные.Очистить();
		док.ЕстьАвтодоходы = ложь;
		
        Для каждого Стр Из ДокНастройка.ВидыДоходов Цикл
            НовСтрока = ДанныеРасчета.Доходы.Добавить();
			НовСтрока.Подразделение = Стр.Подразделение;
            НовСтрока.ВидДохода = Стр.ВидДохода;
			
			Если Стр.СпособЗаполнения = Перечисления.ИА_ВариантыПолученияДанныхВидыДоходов.Запрос ИЛИ Стр.СпособЗаполнения = Перечисления.ИА_ВариантыПолученияДанныхВидыДоходов.ВычисляемоеВыражение Тогда
				док.ЕстьАвтодоходы = истина;	
			КонецЕсли;
			
			Если док.АвтосборДоходов Тогда
	            Если     Стр.СпособЗаполнения = Перечисления.ИА_ВариантыПолученияДанныхВидыДоходов.Вручную Тогда
	                //НовСтрока.Сумма = Стр.Значение;
					НстрокиД = Док.Доходы.НайтиСтроки(Новый структура("Подразделение,ВидДохода", Стр.Подразделение, стр.ВидДохода));
					Если НстрокиД.Количество()>0 Тогда
						//НовстрПред = ПредТЗРучные.добавить();
						//ЗаполнитьЗначенияСвойств(НовстрПред, НстрокиД[0]);
						НовСтрока.Сумма = НстрокиД[0].СуммаБезнал;
					КонецЕсли;
				ИначеЕсли Стр.СпособЗаполнения = Перечисления.ИА_ВариантыПолученияДанныхВидыДоходов.Запрос Тогда
					
					Отбор = Новый Структура("Запрос, ИДСтроки", Стр.Значение, Стр.ИДСтроки);
					нСтр = Док.ЗапросыДанных.НайтиСтроки(Отбор);
					Если нСтр.Количество() = 0 Тогда
						ВызватьИсключение "При получении дохода '"+Стр.ВидДохода+"' произошла ошибка: не вычислен запрос - "+ Стр.Значение;
					Иначе
					    НовСтрока.Сумма = нСтр[0].Сумма;
					    НовСтрока.ДанныеРасшифровки = нСтр[0].Расшифровка;
					КонецЕсли;

	            ИначеЕсли Стр.СпособЗаполнения = Перечисления.ИА_ВариантыПолученияДанныхВидыДоходов.ВычисляемоеВыражение Тогда
					ПараметрыФормулы = Новый Структура("ДатаНачала, ДатаКонца, Организация");
					ЗаполнитьЗначенияСвойств(ПараметрыФормулы, ПараметрыЗапросов);
	                
	                Данные = ВычислитьФормулуФП(Док, Стр.Значение, ПараметрыФормулы, стр.ИДСтроки, ДанныеРасчета);
	                НовСтрока.Сумма = Данные.Значение;
	                НовСтрока.ДанныеРасшифровки = ЗначениеВСтрокуВнутр(Данные);
	                
	                Если Не Данные.Вычислено Тогда
	                    ВызватьИсключение ИА_БФКС.Стр_ПодставитьПараметрыВСтроку(
	                    "При вычислении формулы '%1' (%2) (ВидДохода: '%3') произошла ошибка: %4"
	                    ,Данные.Формула, Данные.ФормулаРезультат, Стр.ВидДохода, Данные.ТекстОшибки);
	                КонецЕсли; 
				КонецЕсли;
			Иначе
				НовСтрока.Сумма = 0;
			КонецЕсли;
            НовСтрока.СуммаБезнал = НовСтрока.Сумма;
        КонецЦикла;
        
        Док.Доходы.Загрузить(ДанныеРасчета.Доходы); // В_ФП
    Иначе
        ДанныеРасчета.Доходы = Док.Доходы.Выгрузить();
        ДобавитьКолонкуСумма(ДанныеРасчета.Доходы);
    КонецЕсли;
    
    Если ЗаполнитьДоходыИтого Тогда
        Для каждого Стр Из Док.ДоходыБП_Распределение Цикл
            НовСтрока = ДанныеРасчета.ДоходыИзСпецДоходов.Добавить();
            ЗаполнитьЗначенияСвойств(НовСтрока, Стр);
            НовСтрока.Сумма = Стр.СуммаНал + Стр.СуммаБезнал;
            НовСтрока.ВидДохода = Стр.ВидДоходаПолучатель;
        КонецЦикла;  	
        
        Для каждого Стр Из Док.РаспределениеСредствСФондов Цикл
        	НовСтрока = ДанныеРасчета.ДоходыИзСписанияФондов.Добавить();
            ЗаполнитьЗначенияСвойств(НовСтрока, Стр);
            НовСтрока.Сумма = НовСтрока.СуммаНал + НовСтрока.СуммаБезнал;
        КонецЦикла;  	
        
        Для каждого Стр Из Док.ДоходыБП Цикл
        	НовСтрока = ДанныеРасчета.ДоходыВСпецДоход.Добавить();
            ЗаполнитьЗначенияСвойств(НовСтрока, Стр);
            НовСтрока.СуммаНал      = -НовСтрока.СуммаНал;
            НовСтрока.СуммаБезнал   = -НовСтрока.СуммаБезнал;
            НовСтрока.Сумма         = НовСтрока.СуммаНал + НовСтрока.СуммаБезнал;
		КонецЦикла;  
		
		// удалим откладывание доходов, которых нет
		счОтл = Док.ОтложенныйДоход.Количество() - 1;
		Пока счОтл >= 0 Цикл
			стрОтл = Док.ОтложенныйДоход[счОтл];
			
			Если стрОтл.ТипОперации = Перечисления.КСУ_ОперацииСОтложеннымДоходом.Отложить и ЗначениеЗаполнено(стрОтл.ВидДохода) тогда
				СтруктПоиск = новый Структура("ВидДохода", стрОтл.ВидДохода);
				Если ИспДоходыПоПодразделениям и ЗначениеЗаполнено(стрОтл.Подразделение) тогда
					СтруктПоиск.Вставить("Подразделение", стрОтл.Подразделение);
				КонецЕсли;
				НСтроки =  ДанныеРасчета.Доходы.НайтиСтроки(СтруктПоиск);
				
				Если НСтроки.Количество() = 0 тогда
					Док.ОтложенныйДоход.удалить(счОтл);
				КонецЕсли;
			КонецЕсли;
			
			счОтл = счОтл - 1;
		КонецЦикла;
		
		Для каждого Стр Из Док.ОтложенныйДоход Цикл
            НовСтрока = ДанныеРасчета.ДоходыИзСпецДоходов.Добавить();
            ЗаполнитьЗначенияСвойств(НовСтрока, Стр);
			Если стр.ТипОперации = Перечисления.КСУ_ОперацииСОтложеннымДоходом.Отложить Тогда
				НовСтрока.Сумма = - НовСтрока.Сумма;
			КонецЕсли;
			НовСтрока.СуммаБезнал = НовСтрока.Сумма;
        КонецЦикла;
        
        Для каждого Стр Из ДанныеРасчета.Доходы Цикл
            ЗаполнитьЗначенияСвойств(ДанныеРасчета.ДоходыИтого.Добавить(), Стр);
        КонецЦикла;  
        Для каждого Стр Из ДанныеРасчета.ДоходыИзСписанияФондов Цикл
            ЗаполнитьЗначенияСвойств(ДанныеРасчета.ДоходыИтого.Добавить(), Стр);
        КонецЦикла;  
        
        Для каждого Стр Из ДанныеРасчета.ДоходыИзСпецДоходов Цикл
            ЗаполнитьЗначенияСвойств(ДанныеРасчета.ДоходыИтого.Добавить(), Стр);
        КонецЦикла;  
        Для каждого Стр Из ДанныеРасчета.ДоходыВСпецДоход Цикл
            ЗаполнитьЗначенияСвойств(ДанныеРасчета.ДоходыИтого.Добавить(), Стр);
        КонецЦикла;  
        
        ДанныеРасчета.ДоходыИтого.Свернуть("Подразделение, ВидДохода", "Сумма, СуммаНал, СуммаБезНал");
        
        Док.ДоходыИтого.Загрузить(ДанныеРасчета.ДоходыИтого);  // В_ФП
	Иначе
		
        ДанныеРасчета.ДоходыИтого = Док.ДоходыИтого.Выгрузить();
        ДобавитьКолонкуСумма(ДанныеРасчета.ДоходыИтого);
    КонецЕсли; 
    
	Если ЗаполнитьПолитику1 Тогда
		ЗаполнитьДокумент_РасчетПолитика1(Док, ДанныеРасчета, ДокНастройка, ПараметрыЗапросов, НеОчищатьРучные, ФпТБ, ИспДоходыПоПодразделениям, ТекПарамПериодов);
	Иначе
		ДанныеРасчета.Политика1 = Док.Политика1.Выгрузить();
	КонецЕсли; 
	
	ИтогоДоход = ДанныеРасчета.ДоходыИтого.Итог("Сумма");
	Док.ИтогоДоход = ИтогоДоход;
	Док.ИтогоЧистыйДоход = ДанныеРасчета.Доходы.Итог("Сумма");
	
	ДанныеРасчета.Вставить("ВаловаяПрибыль", ИтогоДоход - ДанныеРасчета.Политика1.Итог("Сумма"));
	
	Если ЗаполнитьПолитику2 Тогда
		Если ФпТБ Тогда
			ДанныеРасчета.Вставить("МаржинальнаяПрибыль", ДанныеРасчета.ДоходыИтого.Итог("Сумма") - ДанныеРасчета.Политика1.Итог("Сумма"));
			Док.МаржинальнаяПрибыль = ДанныеРасчета.МаржинальнаяПрибыль;
						
			ЗаполнитьУчредительскиеФонды(Док, ДанныеРасчета, ИспДоходыПоПодразделениям);
			
			ДанныеРасчета.Вставить("ИтогоВЗаливку", Док.МаржинальнаяПрибыль - ДанныеРасчета.УчредительскиеФонды.Итог("Сумма"));
			Док.ИтогоВЗаливку = ДанныеРасчета.ИтогоВЗаливку;
			
			Док.Политика2.Очистить();
			ЗаполнитьЗаливкуФондов(Док,ДанныеРасчета, ИспДоходыПоПодразделениям, ТекПарамПериодов);
		Иначе
			ЗаполнитьДокумент_РасчетПолитика2(Док, ДанныеРасчета, ДокНастройка, ПараметрыЗапросов, НеОчищатьРучные);
		КонецЕсли;
	Иначе
		ДанныеРасчета.Политика2 = Док.Политика2.Выгрузить();
    КонецЕсли; 
КонецПроцедуры

Функция ПолучитьПараметрыТекРаспределения(Организация, ДатаДокФП) Экспорт
	ФпНаСледДень = не Константы.ИА_ФП_НачалоПланирования.Получить();
	ДатаФП = ДатаДокФП;
	Если ФпНаСледДень Тогда
		ДатаФП = ДатаФП - 60*60*24;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Организация", Организация);	
	Запрос.УстановитьПараметр("ДатаФП", ДатаФП);	
	
	// получение конца месяца
	Запрос.Текст = "ВЫБРАТЬ
	               |	МАКСИМУМ(ИА_РаспределениеНедель.КонецНедели) КАК КонецПоследнейНедели,
	               |	МАКСИМУМ(ИА_РаспределениеНедель.Период) КАК НачалоПоследнейНедели,
	               |	СУММА(ВЫБОР
	               |			КОГДА ИА_РаспределениеНедель.Период >= ПодЗапрМесяц.неделя
	               |				ТОГДА 1
	               |			ИНАЧЕ 0
	               |		КОНЕЦ) КАК КолНедельДоКонцаМесяца,
	               |	ПодЗапрМесяц.Месяц,
	               |	ПодЗапрМесяц.неделя КАК ТекНеделя
	               |ИЗ
	               |	РегистрСведений.ИА_РаспределениеНедель КАК ИА_РаспределениеНедель
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	               |			ИА_РаспределениеНедель.Месяц КАК Месяц,
	               |			ИА_РаспределениеНедель.Период КАК неделя
	               |		ИЗ
	               |			РегистрСведений.ИА_РаспределениеНедель КАК ИА_РаспределениеНедель
	               |		ГДЕ
	               |			ИА_РаспределениеНедель.Период <= &ДатаФП
	               |			И КОНЕЦПЕРИОДА(ИА_РаспределениеНедель.КонецНедели, ДЕНЬ) >= &ДатаФП) КАК ПодЗапрМесяц
	               |		ПО ИА_РаспределениеНедель.Месяц = ПодЗапрМесяц.Месяц
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ПодЗапрМесяц.Месяц,
	               |	ПодЗапрМесяц.неделя";
	Выборка = Запрос.Выполнить().Выбрать();
	Если не Выборка.Следующий() ТОгда
		Сообщить("Заполните распределение недель по месяцам");
		Возврат Неопределено;
	КонецЕсли;
	
	ТекМесяц = выборка.Месяц;
	ТекНеделя = выборка.ТекНеделя;
	ЭтоПоследняяНеделя = ДатаФП > Выборка.НачалоПоследнейНедели;	
	КолНедельДоКонца = Выборка.КолНедельДоКонцаМесяца;
	
	Возврат Новый Структура("ТекМесяц, ТекНеделя, ЭтоПоследняяНеделя, КолНедельДоКонца, ДатаФП, ПоследняяНеделя,ДатаДокФП", 
							 ТекМесяц, ТекНеделя, ЭтоПоследняяНеделя, КолНедельДоКонца, ДатаФП, Выборка.НачалоПоследнейНедели, ДатаДокФП -1);
КонецФункции

Процедура ЗаполнитьОстаткиДоФП(Запрос) Экспорт

	Запрос.Текст = "ВЫБРАТЬ
	               |	ТекРаспр.Подразделение,
	               |	ТекРаспр.Фонд,
	               |	СУММА(ТекРаспр.СуммаОстаток) КАК СуммаОстаток
	               |ПОМЕСТИТЬ ОстаткиДоФП
	               |ИЗ
	               |	РегистрНакопления.КСУ_РаспределениеТБ.Остатки(
	               |			&ДатаФП,
	               |			Неделя < &ТекНеделя
	               |					И (Организация = &Организация
	               |				ИЛИ &Организация = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка))) КАК ТекРаспр
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ИА_РаспределениеНедель КАК ИА_РаспределениеНедель
	               |		ПО (ИА_РаспределениеНедель.Период = ТекРаспр.Неделя)
	               |			И (ИА_РаспределениеНедель.Месяц = &ТекМесяц)
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ТекРаспр.Подразделение,
	               |	ТекРаспр.Фонд";
	Запрос.Выполнить();
	
КонецПроцедуры

Процедура ЗаполнитьУчредительскиеФонды(Док, ДанныеРасчета, ИспДоходыПоПодразделениям)
	ДанныеРасчета.УчредительскиеФонды.Очистить();
	
	Запрос = новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	КСУ_ПравилоУчредительскихФондов.Подразделение КАК Подразделение,
	               |	КСУ_ПравилоУчредительскихФондов.Фонд КАК Фонд,
	               |	КСУ_ПравилоУчредительскихФондов.Процент КАК Процент
	               |ИЗ
	               |	РегистрСведений.КСУ_ПравилоУчредительскихФондов КАК КСУ_ПравилоУчредительскихФондов
	               |ГДЕ
	               |	КСУ_ПравилоУчредительскихФондов.Месяц = &Месяц
	               |	И (КСУ_ПравилоУчредительскихФондов.Организация = &Организация
	               |			ИЛИ &Организация = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка))";
	Запрос.УстановитьПараметр("Месяц", Док.МесяцТБ);
	Запрос.УстановитьПараметр("Организация", Док.Организация);
	тз_Учр = Запрос.Выполнить().Выгрузить();
	
	ТЗ_Подр_Доходы = ДанныеРасчета.ДоходыИтого.Скопировать();
	ТЗ_Подр_Доходы.Свернуть("Подразделение", "Сумма");
	
	Для каждого стрДоходПодр из ТЗ_Подр_Доходы Цикл
		Если ИспДоходыПоПодразделениям Тогда
			СтрокиРасходы = ДанныеРасчета.Политика1.НайтиСтроки(Новый Структура("Подразделение", стрДоходПодр.Подразделение));
		Иначе
			СтрокиРасходы = ДанныеРасчета.Политика1;
		КонецЕсли;
		ИтогоПеремРасходы = 0;
		Для каждого стр из СтрокиРасходы Цикл
			ИтогоПеремРасходы = ИтогоПеремРасходы + стр.Сумма;
		КонецЦикла;
		
		маржа = стрДоходПодр.Сумма - ИтогоПеремРасходы; 
		
		НовстрТЧ = док.МаржаПоПодразделениям.Добавить();
		НовстрТЧ.Подразделение = стрДоходПодр.Подразделение;
		НовстрТЧ.Сумма = маржа;
		
		Если ИспДоходыПоПодразделениям Тогда
			СтрокиУФ = тз_Учр.НайтиСтроки(Новый Структура("Подразделение", стрДоходПодр.Подразделение));
		Иначе
			СтрокиУФ = тз_Учр;
		КонецЕсли;
		
		Для каждого стрУФ из СтрокиУФ Цикл
			Новстр = ДанныеРасчета.УчредительскиеФонды.Добавить();
			ЗаполнитьЗначенияСвойств(Новстр, стрУФ);
			Новстр.сумма = окр(маржа / 100 * стрУФ.Процент, 2); 
		КонецЦикла;
	КонецЦикла;
	
	Док.УчредительскиеФонды.Загрузить(ДанныеРасчета.УчредительскиеФонды);
КонецПроцедуры


Процедура ЗаполнитьЗаливкуФондов(Док, ДанныеРасчета, ИспДоходыПоПодразделениям, ТекПарам)
	Док.ЗаливкаФондов.Очистить();
	
	Если ТекПарам = Неопределено Тогда 
		Возврат; 
	КонецЕсли;
		
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = новый МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("Организация", Док.Организация);	
	Запрос.УстановитьПараметр("ДатаФП", ТекПарам.ДатаФП);
	Запрос.УстановитьПараметр("ДатаДокФП", ТекПарам.ДатаДокФП);
	Запрос.УстановитьПараметр("КолНедельДоКонца", ТекПарам.КолНедельДоКонца);	
	Запрос.УстановитьПараметр("ТекМесяц", ТекПарам.ТекМесяц);	
	Запрос.УстановитьПараметр("ТекНеделя", ТекПарам.ТекНеделя);	
	
	ЗаполнитьОстаткиДоФП(Запрос);
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	ТекРаспр.Подразделение КАК Подразделение,
	               |	ТекРаспр.Фонд КАК Фонд,
	               |	ТекРаспр.СуммаОстаток + ЕСТЬNULL(ОстаткиДоФП.СуммаОстаток, 0) / &КолНедельДоКонца КАК СуммаПоФП,
	               |	ТекРаспр.Неделя КАК Неделя,
	               |	КСУ_ПорядокРаспределенияПоФондамСрезПоследних.Порядок КАК Порядок
	               |ИЗ
	               |	РегистрНакопления.КСУ_РаспределениеТБ.Остатки(
	               |			&ДатаДокФП,
	               |			Неделя >= &ТекНеделя
	               |				И (Организация = &Организация
	               |					ИЛИ &Организация = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка))) КАК ТекРаспр
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КСУ_ПорядокРаспределенияПоФондам.СрезПоследних(
	               |				&ДатаДокФП,
	               |				(НомерПолитики = 2)
	               |					И (Организация = &Организация
	               |						ИЛИ &Организация = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка))) КАК КСУ_ПорядокРаспределенияПоФондамСрезПоследних
	               |		ПО ТекРаспр.Подразделение = КСУ_ПорядокРаспределенияПоФондамСрезПоследних.Подразделение
	               |			И ТекРаспр.Фонд = КСУ_ПорядокРаспределенияПоФондамСрезПоследних.Фонд
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ИА_РаспределениеНедель КАК ИА_РаспределениеНедель
	               |		ПО (ИА_РаспределениеНедель.Период = ТекРаспр.Неделя)
	               |			И (ИА_РаспределениеНедель.Месяц = &ТекМесяц)
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ОстаткиДоФП КАК ОстаткиДоФП
	               |		ПО ТекРаспр.Подразделение = ОстаткиДоФП.Подразделение
	               |			И ТекРаспр.Фонд = ОстаткиДоФП.Фонд
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ТекРаспр.Неделя,
	               |	Порядок";
	
	тз = Запрос.Выполнить().Выгрузить();
	Док.ЗаливкаФондовСостояние.Загрузить(тз);
	
	// ЗАЛИВКА
	
	
	Если ИспДоходыПоПодразделениям тогда
		тз_ДоходыПоПодр = ДанныеРасчета.ДоходыИтого.Скопировать(); 
		тз_ДоходыПоПодр.Свернуть("Подразделение", "Сумма");
		тз_РасходыПоПодр = ДанныеРасчета.Политика1.Скопировать();
		тз_РасходыПоПодр.Свернуть("Подразделение", "Сумма");
		тз_УчредПоПодр = ДанныеРасчета.УчредительскиеФонды.Скопировать();
		тз_УчредПоПодр.Свернуть("Подразделение", "Сумма");
		
		Для каждого стрДох из тз_ДоходыПоПодр Цикл
			нстр = тз_РасходыПоПодр.найти(стрДох.Подразделение);
			Если нстр<> Неопределено Тогда
				стрДох.Сумма = стрДох.Сумма - нстр.Сумма; 
			КонецЕсли;
			
			нстр = тз_УчредПоПодр.найти(стрДох.Подразделение);
			Если нстр<> Неопределено Тогда
				стрДох.Сумма = стрДох.Сумма - нстр.Сумма; 
			КонецЕсли;
			
			НовстрТЧ = док.ИтогоВЗаливкуПодразделениям.Добавить();
			НовстрТЧ.Подразделение = стрДох.Подразделение;
			НовстрТЧ.Сумма = стрДох.Сумма;
		КонецЦикла;
		
		тз.Сортировать("Подразделение, Неделя, Порядок");
		
		Для каждого стрДох из тз_ДоходыПоПодр Цикл
			СтрокиПланЗаливки = тз.НайтиСтроки(Новый Структура("Подразделение", стрДох.Подразделение));
			
			сч = 0;
			кол = СтрокиПланЗаливки.Количество()-1;
			Пока сч <= кол  и стрДох.Сумма > 0 Цикл
				Текстр = СтрокиПланЗаливки[сч];
			
				НовСтр = Док.ЗаливкаФондов.Добавить();
				ЗаполнитьЗначенияСвойств(НовСтр, Текстр);
				НовСтр.Сумма = мин(Текстр.СуммаПоФП, стрДох.Сумма);
				стрДох.Сумма = стрДох.Сумма - НовСтр.Сумма;
				
				сч = сч + 1;
			КонецЦикла;
			Если стрДох.Сумма>0 и НовСтр <> Неопределено Тогда // Весь месяц залили, а деньги остались. Кидаем на последний
				НовСтр.Сумма = НовСтр.Сумма + стрДох.Сумма;
			КонецЕсли;
		КонецЦикла;

	Иначе
		НовстрТЧ = док.ИтогоВЗаливкуПодразделениям.Добавить();
		НовстрТЧ.Сумма = ДанныеРасчета.ИтогоВЗаливку;
			
		сч = 0;
		кол = тз.Количество()-1;
		СуммаРаспр = ДанныеРасчета.ИтогоВЗаливку;
		Пока сч <= кол  и СуммаРаспр > 0 Цикл
			Текстр = тз[сч];
		
			НовСтр = Док.ЗаливкаФондов.Добавить();
			ЗаполнитьЗначенияСвойств(НовСтр, Текстр);
			НовСтр.Сумма = мин(Текстр.СуммаПоФП, СуммаРаспр);
			СуммаРаспр = СуммаРаспр - НовСтр.Сумма;
			
			сч = сч + 1;
		КонецЦикла;
		Если СуммаРаспр>0 и НовСтр <> Неопределено Тогда // Весь месяц залили, а деньги остались. Кидаем на последний
			НовСтр.Сумма = НовСтр.Сумма + СуммаРаспр;
		КонецЕсли;
	КонецЕсли;
	
	     	
КонецПроцедуры

Функция   СформироватьОтчетРасшифровкиВидаДохода(Док, ВидДохода, Подразделение, ВыводитьОбщийДоход = Ложь) Экспорт
    #ЕСЛИ НЕ( Клиент или Сервер или ВнешнееСоединение ) Тогда
        Док = Документы.ИА_ФинансовоеПланирование.СоздатьДокумент();
    #КОНЕЦЕСЛИ
    
    ТабДок = Новый ТабличныйДокумент;
    Макет = Новый ТабличныйДокумент;
    
    Заголовок = "Вид дохода: " + ВидДохода;
    Результат = Новый Структура("Сформирован, ТабДок, Заголовок", Ложь, ТабДок, Заголовок);
    Данные = Неопределено;
    
    НайдСтроки = Док.Доходы.НайтиСтроки(Новый структура("ВидДохода,Подразделение", ВидДохода,Подразделение));
    
    Обл = Макет.ПолучитьОбласть(1,1,1,1);
    Обл.Область(1,1,1,1).Текст = Заголовок;
    ТабДок.Вывести(Обл);
    
	Если НайдСтроки.Количество() > 0 Тогда
		НайдСтрока = НайдСтроки[0];
        Попытка
            Данные = ЗначениеИзСтрокиВнутр(НайдСтрока.ДанныеРасшифровки);
        Исключение
            ТекстОшибки = ОписаниеОшибки();
        КонецПопытки; 
        
        Если ТипЗнч(Данные) = Тип("Структура") Тогда
            Если ИА_БФКС.РеквизитЕсть(Данные, "Таб") Тогда
                ТабДок.Область(2, 1, 2, 1).Текст = "Сумма дохода = " + Данные.Таб.Итог("Сумма");
                
                ТЗ = СтруктураВТЗ(Данные.Параметры);  
                
                ТабДокВрем = ИА_БФС.ТЗ_ВывестиВТабДок(ТЗ, "Параметры запроса",,Истина,Истина);
                ТабДок.Вывести(ТабДокВрем);
                
                ТабДокВрем = ИА_БФС.ТЗ_ВывестиВТабДок(Данные.Таб, "Результат запроса",,Истина,Истина);
                ТабДок.Вывести(ТабДокВрем);
            ИначеЕсли ИА_БФКС.РеквизитЕсть(Данные, "Формула") Тогда
                
                ТабДок.НачатьГруппуСтрок();
                
                Обл.Область(1,1,1,1).Текст = "Формула: " + Данные.Формула;
                ТабДок.Вывести(Обл);
                Обл.Область(1,1,1,1).Текст = "Расчет: " + Данные.ФормулаРезультат;
                ТабДок.Вывести(Обл);
                
                Обл.Область(1,1,1,1).Текст = "Параметры формулы:";
                ТабДок.Вывести(Обл);
                Обл.Область(1,1,1,1).Текст = "";
                ТабДок.Вывести(Обл);
                
                
                
                Для каждого Стр Из Данные.Расшифровка Цикл
                    Обл.Область(1,1,1,1).Текст = ИА_БФКС.Стр_ПодставитьПараметрыВСтроку(
                    "'%1' = %2"
                    ,Стр.Параметр,Стр.Значение);
                    ТабДок.Вывести(Обл);
                    ТабДок.НачатьГруппуСтрок();
                    Если ТипЗнч(Стр.Расшифровка) = Тип("Структура") Тогда
                        ТабДок.Вывести(ИА_БФС.ТЗ_ВывестиВТабДок(СтруктураВТЗ(Стр.Расшифровка.Параметры), "Параметры запроса:",,Истина,Истина));
                        ТабДок.Вывести(ИА_БФС.ТЗ_ВывестиВТабДок(Стр.Расшифровка.Таб, "Результат запроса:",,Истина,Истина));
                    КонецЕсли; 
                    Обл.Область(1,1,1,1).Текст = "";
                    ТабДок.Вывести(Обл);
                    
                    ТабДок.ЗакончитьГруппуСтрок();
                КонецЦикла;  
                
                ТабДок.ЗакончитьГруппуСтрок();
            КонецЕсли; 
            
            Результат.Сформирован = Истина;
        КонецЕсли; 
    КонецЕсли; 
    
    
    Если ВыводитьОбщийДоход Тогда
        Результат.Сформирован = Истина;
        
        Отбор = Новый Структура("ВидДохода,Подразделение", ВидДохода, Подразделение);
        
        ВывестиТаблицуДокумента(Док.ДоходыБП, Отбор,                        "Спец. доход. ", ТабДок);
        ВывестиТаблицуДокумента(Док.ДоходыБП_Распределение, Отбор,          "Распределение спец. дохода. ", ТабДок);
        ВывестиТаблицуДокумента(Док.РаспределениеСредствСФондов, Отбор,     "Распределение с фондов. ", ТабДок);
        
    КонецЕсли; 
    
    
    Возврат Результат;
КонецФункции

Процедура ВывестиТаблицуДокумента(ТЧ, Отбор, Заголовок, ТабДок)
    ТЗ = ИА_БФС.ТЗ_ФильтрПоОтбору(ТЧ, Отбор);
    ТЗ.Колонки.Удалить("Номерстроки");
    ТЗ.Колонки.Удалить("ВидДохода");
    ТекстИтога = "Итог = " + ТЗ.Итог("СуммаБезнал");
    ТабДок.Вывести(ИА_БФС.ТЗ_ВывестиВТабДок(ТЗ, Заголовок + " " + ТекстИтога,,Истина,Истина));
КонецПроцедуры
 
Функция   СформироватьОтчетРасшифровкиПолитика(Док, КлючиПоиска, НомерПолитики) Экспорт
	
	ТабДок = Новый ТабличныйДокумент;
	Макет = Документы.ИА_ФинансовоеПланирование.ПолучитьМакет("РасшифровкаПолитики");
	
	Отбор = Новый Структура("Подразделение, Статья");
	ЗаполнитьЗначенияСвойств(Отбор, КлючиПоиска);
	
	Если ИА_БФКС.РеквизитЕсть(КлючиПоиска, "Раздел") и КлючиПоиска.Раздел<>Неопределено Тогда
		Отбор.Вставить("Раздел", КлючиПоиска.Раздел);
	КонецЕсли;
	
	Если ИА_БФКС.РеквизитЕсть(КлючиПоиска, "ВидДохода") Тогда
		Отбор.Вставить("ВидДохода", КлючиПоиска.ВидДохода);
	КонецЕсли;
	
	Если НомерПолитики = 1 Тогда
		ТабПолитика1 = ИА_БФС.ТЗ_ФильтрПоОтбору(Док.Политика1, Отбор);
	Иначе
		ТабПолитика1 = ИА_БФС.ТЗ_ФильтрПоОтбору(Док.Политика2, Отбор);
	КонецЕсли;
	
	//////////////////////////////////////////////////////////////////////////////////////////////
	
	Заголовок = "Расшифровка статьи """ + Отбор.Статья + """";
	Результат = Новый Структура("Сформирован, ТабДок, Заголовок", Ложь, ТабДок, Заголовок);	

	Для каждого СтрПолитика1 Из ТабПолитика1 Цикл
		Результат.Сформирован = Истина;
		
		Если НомерПолитики = 1 Тогда
			Обл = Макет.ПолучитьОбласть("ВидДохода");
			ЗаполнитьЗначенияСвойств(обл.Параметры, СтрПолитика1); 
			ТабДок.Вывести(Обл);		
		КонецЕсли;		
		
		ДанныеРасшифровки =  Неопределено;
		Попытка
			ДанныеРасшифровки =  ЗначениеИзСтрокиВнутр(СтрПолитика1.ДанныеРасшифровки);
		Исключение
			ТекстОшибки = ОписаниеОшибки();
		КонецПопытки; 
		
		Если ТипЗнч(ДанныеРасшифровки) = Тип("Структура") Тогда
									
			Обл = Макет.ПолучитьОбласть("Формула");
			ЗаполнитьЗначенияСвойств(обл.Параметры, ДанныеРасшифровки); 
			ТабДок.Вывести(Обл);		
			
			Если ДанныеРасшифровки.Свойство("Расшифровка") И ДанныеРасшифровки.Расшифровка.Количество()>0 Тогда
				Обл = Макет.ПолучитьОбласть("ПараметрыШапка");
				ТабДок.Вывести(Обл);						
				
				Для каждого Стр Из ДанныеРасшифровки.Расшифровка Цикл
					
					Обл = Макет.ПолучитьОбласть("Параметр");
					ЗаполнитьЗначенияСвойств(обл.Параметры, Стр); 
					ТабДок.Вывести(Обл);

					Если ТипЗнч(Стр.Расшифровка) = Тип("Структура") Тогда
						ТабДок.Вывести(ИА_БФС.ТЗ_ВывестиВТабДок(СтруктураВТЗ(Стр.Расшифровка.Параметры), "Параметры запроса:",,Истина,Истина));
						ТабДок.Вывести(ИА_БФС.ТЗ_ВывестиВТабДок(Стр.Расшифровка.Таб, "Результат запроса:",,Истина,Истина));
						Обл = Макет.ПолучитьОбласть("ПустаяСтрока");
						ТабДок.Вывести(Обл);						
					КонецЕсли; 															
				КонецЦикла;  
			КонецЕсли;
			
			Обл = Макет.ПолучитьОбласть("ПустаяСтрока");
			ТабДок.Вывести(Обл);						
		КонецЕсли; 
	КонецЦикла;  
	
	Возврат Результат	
КонецФункции

