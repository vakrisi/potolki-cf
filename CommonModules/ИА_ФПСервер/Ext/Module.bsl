Функция естьБудущиеДоки(организация, дата) Экспорт
	Запрос = новый запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ИА_СредстваНаФондах.Регистратор КАК Регистратор
	               |ИЗ
	               |	РегистрНакопления.ИА_СредстваНаФондах КАК ИА_СредстваНаФондах
	               |ГДЕ
	               |	ИА_СредстваНаФондах.Организация = &Организация
	               |	И ИА_СредстваНаФондах.Период > &Период";
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Период", Дата);
	Выборка = запрос.Выполнить().Выбрать();
	
	возврат выборка.Следующий();
КонецФункции

Функция УбратьНули(номер) Экспорт
	рез = номер; 
	Пока Лев(рез, 1) = "0" Цикл 
	    рез = Прав(рез, СтрДлина(рез) - 1);
	КонецЦикла;
	Возврат рез;
КонецФункции

Функция ИдИсточника(Источник) Экспорт
	если ТипЗнч(Источник) = тип("Строка") тогда
		возврат Источник;
	КонецЕсли;
	возврат Источник.НаименованиеИД;
КонецФункции

Функция ПолучитьПредставлениеНедели(НачНедели) Экспорт	
	Если НачНедели = дата(1,1,1) тогда
		возврат "";
	КонецЕсли;
	
	Запрос = новый запрос;
	запрос.Текст = "ВЫБРАТЬ
	               |	ИА_РаспределениеНедель.Период КАК Период,
	               |	ИА_РаспределениеНедель.КонецНедели КАК КонецНедели,
	               |	ИА_РаспределениеНедель.Месяц КАК Месяц
	               |ИЗ
	               |	РегистрСведений.ИА_РаспределениеНедель КАК ИА_РаспределениеНедель
	               |ГДЕ
	               |	ИА_РаспределениеНедель.Период = &Период";
	Запрос.УстановитьПараметр("Период", НачНедели);
	Выборка = запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат формат(Выборка.Период, "ДФ=dd.MM") + " — " + формат(Выборка.КонецНедели, "ДФ=dd.MM") + " ("+ формат(выборка.Месяц, "ДФ=ММММ") +")";
	Иначе
		возврат "";
	КонецЕсли;
КонецФункции

Функция ПолучитьДоступныеНедели(ДатаДокумента) Экспорт	
	Если ДатаДокумента = дата(1,1,1) тогда
		возврат новый СписокЗначений;
	КонецЕсли;
	
	Запрос = новый запрос;
	запрос.Текст = "ВЫБРАТЬ
	               |	ИА_РаспределениеНедель.Период КАК Период,
	               |	ИА_РаспределениеНедель.КонецНедели КАК КонецНедели,
	               |	ИА_РаспределениеНедель.Месяц КАК Месяц
	               |ИЗ
	               |	РегистрСведений.ИА_РаспределениеНедель КАК ИА_РаспределениеНедель
	               |ГДЕ
	               |	ИА_РаспределениеНедель.Период <= &Период И КОНЕЦПЕРИОДА(ИА_РаспределениеНедель.КонецНедели,ДЕНЬ)>= &Период";
	Запрос.УстановитьПараметр("Период", ДатаДокумента);
	Выборка = запрос.Выполнить().Выбрать();
	
	Рез = новый СписокЗначений;
	Если Выборка.Следующий() Тогда
		Рез.Добавить(Выборка.Период, формат(Выборка.Период, "ДФ=dd.MM") + " — " + формат(Выборка.КонецНедели, "ДФ=dd.MM") + " ("+ формат(выборка.Месяц, "ДФ=ММММ") +")");
		
		// пред неделя
		
		Запрос.УстановитьПараметр("Период", Выборка.период - 60*60*24);
		Выборка = запрос.Выполнить().Выбрать();

		Если Выборка.Следующий() Тогда
			Рез.Добавить(Выборка.Период, формат(Выборка.Период, "ДФ=dd.MM") + " — " + формат(Выборка.КонецНедели, "ДФ=dd.MM") + " ("+ формат(выборка.Месяц, "ДФ=ММММ") +")");
		КонецЕсли;
	КонецЕсли;	 
	
	Возврат Рез;
КонецФункции

Функция ЭтоНачалонедели(НачНедели) Экспорт		
