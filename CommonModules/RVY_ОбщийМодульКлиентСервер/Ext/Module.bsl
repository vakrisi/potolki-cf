Функция ПолучитьСоединениеСREVVY() Экспорт
	
	Соединение = Новый HTTPСоединение("revvy.ru",443,,,,,Новый ЗащищенноеСоединениеOpenSSL());
	Возврат Соединение;
	
КонецФункции

Функция ОбновитьТокен(Логин, Пароль) Экспорт
	
	ДанныеТокена = Неопределено;
	Если НЕ ЗначениеЗаполнено(Логин) Тогда
		#Если Клиент Тогда
		ПоказатьПредупреждение(, "Не заполнен ""Логин""");
		#КонецЕсли
		Возврат ДанныеТокена;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Пароль) Тогда
		#Если Клиент Тогда
		ПоказатьПредупреждение(,"Не заполнен ""Пароль""");
		#КонецЕсли
		Возврат ДанныеТокена;
	КонецЕсли;
	
 	Соединение = RVY_ОбщийМодульКлиентСервер.ПолучитьСоединениеСREVVY();
		
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Content-Type","application/json");
	
	Запрос = Новый HTTPЗапрос;
	Запрос.АдресРесурса = "/api/authentication";
	Запрос.Заголовки = Заголовки;
	
	Данные = Новый Структура;
	Данные.Вставить("name", Логин);
	Данные.Вставить("password", Пароль);
	Запрос.УстановитьТелоИзСтроки(СтрокаИзСтруктурыJSON(Данные));
	Ответ = Соединение.ОтправитьДляОбработки(Запрос);
	Если Ответ.КодСостояния = 200 Тогда
		ОтветСервера = Ответ.ПолучитьТелоКакСтроку();
		Данные = СтруктураИзСтрокиJSON(ОтветСервера);
		ДанныеТокена = Новый Структура("Токен, ДатаПолучения", Данные.jwtToken, ТекущаяДата());
	Иначе
		#Если Клиент Тогда
		Сообщить("Код ответа: " + Ответ.КодСостояния);
		Сообщить(Ответ.ПолучитьТелоКакСтроку());
		#КонецЕсли
	КонецЕсли;
	
	Возврат ДанныеТокена;
	
КонецФункции

Функция ОтправитьВRevvy(ИмяКлиента, Телефон) Экспорт
	
	// проверяем актуальность токена
	ДанныеТокена = RVY_ОбщийМодульВызовСервера.ПолучитьДанныеТокена();
	Если НЕ ЗначениеЗаполнено(ДанныеТокена.ДатаПолучения) 
		ИЛИ КонецДня(ДанныеТокена.ДатаПолучения) < ТекущаяДата() Тогда
		
		ДанныеТокена = ОбновитьТокен(ДанныеТокена.Логин, ДанныеТокена.Пароль);
		Если НЕ ТипЗнч(ДанныеТокена) = Тип("Структура") Тогда
			Возврат Ложь;	
		КонецЕсли;
		RVY_ОбщийМодульВызовСервера.СохранитьДанныеТокена(ДанныеТокена);
	КонецЕсли;		
	
	// отправляем запрос
	Соединение = ПолучитьСоединениеСREVVY();
	
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Content-Type","application/json");
	Заголовки.Вставить("Authorization", "Bearer " + ДанныеТокена.Токен);	
	
	Запрос = Новый HTTPЗапрос;                     
	Запрос.АдресРесурса = "/api/reviews/request";	
	Запрос.Заголовки = Заголовки; 
	
	Данные = Новый Структура;
	Данные.Вставить("name", ИмяКлиента);
	Данные.Вставить("phone", Телефон);
	//Данные.Вставить("placeId",id);
	//Данные.Вставить("additionalData", additionalData);
	Запрос.УстановитьТелоИзСтроки(СтрокаИзСтруктурыJSON(Данные));	
	
	Ответ = Соединение.ОтправитьДляОбработки(Запрос);
	Если Ответ.КодСостояния = 200 Тогда
		Возврат Истина;		
	Иначе
		Сообщить("Ошибка отправки запроса Revvy. Код ответа: " + Ответ.КодСостояния);
		//Сообщить(Ответ.ПолучитьТелоКакСтроку());
		ОтветСообщение = Ответ.ПолучитьТелоКакСтроку();
		Попытка			
			ЧтениеJSON = Новый ЧтениеJSON;
			ЧтениеJSON.УстановитьСтроку(ОтветСообщение);
			РезультатСоответствие = ПрочитатьJSON(ЧтениеJSON, Истина);
			Если НЕ РезультатСоответствие.Получить("userFriendlyMessage") = Неопределено Тогда
				ОтветСообщение = РезультатСоответствие.Получить("userFriendlyMessage") + Символы.ПС + ОтветСообщение;
			КонецЕсли;
		Исключение
		КонецПопытки;		
		Сообщить(ОтветСообщение);
	КонецЕсли;	
	
	Возврат Ложь;
	
КонецФункции

///// Преобразование JSON
Функция СтрокаИзСтруктурыJSON(Данные) 
	
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, Данные, , "ПреобразованиеЗначенийJSON", RVY_ОбщийМодульКлиентСервер);
	Возврат ЗаписьJSON.Закрыть();
	
КонецФункции

Функция ПреобразованиеЗначенийJSON(Свойство, Значение, ДополнительныеПараметры, Отказ) Экспорт 
	
    Если ТипЗнч(Значение) = Тип("УникальныйИдентификатор") Тогда
        Возврат Строка(Значение);
    КонецЕсли; 
    
    Возврат Значение;
	
КонецФункции

Функция СтруктураИзСтрокиJSON(Строка, СвойстваТипаДата = Неопределено) Экспорт
	
	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(Строка);
	Ответ = ПрочитатьJSON(ЧтениеJSON,, СвойстваТипаДата, ФорматДатыJSON.ISO); 
	Возврат Ответ;
	
КонецФункции

