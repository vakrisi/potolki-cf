
// Получение значения константы.
//
// Параметры:
//  ИмяКонстанты - Строка - наименование константы.
//
// Возвращаемое значение:
//  Значение - значение константы.
Функция ПолучитьЗначениеКонстанты(ИмяКонстанты) Экспорт

	Возврат Константы[ИмяКонстанты].Получить();

КонецФункции

#Область РаботаСЗаказами

//процедуры перевода статуса Заказа на производство
Функция ОснованимЗаказаНаПроизводствоЯвляетсяЗаказПокупателя(СсылкаНаЗаказНаПроизводство) Экспорт
	
	Если ТипЗнч(СсылкаНаЗаказНаПроизводство) = Тип("ДокументСсылка.ЗаказНаПроизводство") 
		И ТипЗнч(СсылкаНаЗаказНаПроизводство.ДокументОснование) = Тип("ДокументСсылка.ЗаказПокупателя")
		И НЕ СсылкаНаЗаказНаПроизводство.ДокументОснование.Пустая() Тогда
		Возврат Истина;
	КонецЕсли;
	
	Возврат Ложь;
			
КонецФункции

Функция ЗаказНаПроизводствоСвязанСЗаказомПокупателя(СсылкаЗаказНаПроизводство) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("СсылкаЗаказНаПроизводство", СсылкаЗаказНаПроизводство);
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ДокументЗаказНаПроизводство.Ссылка 
	|ИЗ
	|	Документ.ЗаказНаПроизводство КАК ДокументЗаказНаПроизводство
	
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаказПокупателя.Товары КАК ТоварыЗП
	|		ПО (ТоварыЗП.Ссылка = ДокументЗаказНаПроизводство.ДокументОснование)
	|			И (ТоварыЗП.ЗаказНаПроизводство = ДокументЗаказНаПроизводство.Ссылка)
	|           И ТоварыЗП.Ссылка.Проведен
	
	|ГДЕ
	|	ДокументЗаказНаПроизводство.Ссылка = &СсылкаЗаказНаПроизводство
	|	И ДокументЗаказНаПроизводство.Проведен
	|	И НЕ ДокументЗаказНаПроизводство.ТекущийСтатус = ЗНАЧЕНИЕ(Справочник.СтатусыЗаказовНаПроизводство.Отменен)";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Истина;		
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

Функция СоздатьЗаказыПокупателейНаПроизводствоРозница(СтруктураДанных, ДополнительныеПараметры) Экспорт
	
	Возврат ОбщийМодульСервер.СоздатьЗаказыПокупателейНаПроизводствоИзРозницы(ДополнительныеПараметры.ДокументСсылка, СтруктураДанных.СписокЗаказать, 
																			  ДополнительныеПараметры.НастройкаИнтеркампани, СтруктураДанных);
	
КонецФункции

#КонецОбласти

