//Работа с файлами
Функция ПолучитьДанныеФайла(СсылкаНаОбъект, ИмяФайла, Знач Номенклатура = Неопределено, УникальныйИдентификатор) Экспорт
	
	Если Номенклатура = Неопределено Тогда
		Номенклатура = Справочники.Номенклатура.ПустаяСсылка();
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ПрикрепленныеДанные.Данные,
	//++ №7253
	|	ПрикрепленныеДанные.СсылкаНаОбъект,
	|	ПрикрепленныеДанные.ИмяФайла,
	|	ПрикрепленныеДанные.Расширение,
	|	ПрикрепленныеДанные.Архивирован,
	|	ПрикрепленныеДанные.ВариантАрхивации,
	|	ПрикрепленныеДанные.ПутьАрхивации,
	|	ПрикрепленныеДанные.ДатаАрхивации,
	|	ПрикрепленныеДанные.ИдентификаторФайлаGD,
	|	ПрикрепленныеДанные.ИдентификаторПапкиGD
	//-- №7253
	|ИЗ
	|	РегистрСведений.ПрикрепленныеДанные КАК ПрикрепленныеДанные
	|ГДЕ
	|	ПрикрепленныеДанные.СсылкаНаОбъект = &Ссылка
	|	И ПрикрепленныеДанные.ИмяФайла = &ИмяФайла";
	Запрос.УстановитьПараметр("Ссылка", ?(Номенклатура = Справочники.Номенклатура.ПустаяСсылка(), СсылкаНаОбъект, Номенклатура));
	Запрос.УстановитьПараметр("ИмяФайла", ИмяФайла);
	
	
	Данные = Неопределено;
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		
		// №7253 если архивирован, нужно получить из архива
		Если Выборка.Архивирован Тогда
			
			Данные = ПолучитьФайлИзАрхива(Выборка);
			
		Иначе
			
			Данные = Выборка.Данные.Получить();
			
		КонецЕсли;
		
	КонецЕсли;
	
	// №7253 если Данные = Неопределено возвращаем как есть, чтобы пропустить файл (там откуда вызывается функция)
	Если Данные = Неопределено Тогда
		Возврат Неопределено;
	Иначе
		Возврат ПоместитьВоВременноеХранилище(Данные, УникальныйИдентификатор);
	КонецЕсли;
	
КонецФункции

//++ №7253
Функция ПолучитьФайлИзАрхива(СтруктураФайла) Экспорт
	
	Если СтруктураФайла.ВариантАрхивации = Перечисления.ВариантыАрхивацииПрикрепленныхДанных.ЛокальныйДиск Тогда
		
		ПолныйПутьКФайлу = СтруктураФайла.ПутьАрхивации + "\" + СтруктураФайла.СсылкаНаОбъект.УникальныйИдентификатор() + "\" + СтруктураФайла.ИмяФайла + "." + СтруктураФайла.Расширение;
		ФайлНаДиске = новый Файл(ПолныйПутьКФайлу);
		Если ФайлНаДиске.Существует() Тогда
			Возврат Новый ДвоичныеДанные(ФайлНаДиске.ПолноеИмя);
		Иначе
			Сообщить("Не удалось получить файл из локального архива: " + ПолныйПутьКФайлу);
		КонецЕсли;
		
	ИначеЕсли СтруктураФайла.ВариантАрхивации = Перечисления.ВариантыАрхивацииПрикрепленныхДанных.GoogleDrive Тогда
		
		Возврат РаботаСGoogleAPIВызовСервера.ПолучитьФайлПоID(СтруктураФайла.ИдентификаторФайлаGD);
		
	ИначеЕсли СтруктураФайла.ВариантАрхивации = Перечисления.ВариантыАрхивацииПрикрепленныхДанных.ЯндексДиск Тогда
		
		ПолныйПутьКФайлу = СтруктураФайла.ПутьАрхивации + "/" + СтруктураФайла.ИмяФайла + "." + СтруктураФайла.Расширение;
		Возврат РаботаСЯндексAPIВызовСервера.ПолучитьФайлПолномуПути(ПолныйПутьКФайлу);
		
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции
//-- №7253

Функция СохранитьПрикрепленныеДанные(Ссылка, ИмяФайла, Расширение, Данные, ДополнительныеПараметры = Неопределено, ПрисоединенныйФайл = Неопределено) Экспорт
	
	// №7722 для изображений номенклатуры используется справочник
	НоменклатураПрисоединенныеФайлы = Ложь;
	Если ТипЗнч(ДополнительныеПараметры) = Тип("Структура") И ДополнительныеПараметры.Свойство("НоменклатураПрисоединенныеФайлы") Тогда
		НоменклатураПрисоединенныеФайлы = ДополнительныеПараметры.НоменклатураПрисоединенныеФайлы;
	КонецЕсли;
	
	Результат = Истина;
	
	// №9396 проверка превышения объема
	СтруктураПрикрепленныхДанных = ОбщийМодуль.ПолучитьСтруктуруПрикрепленныхДанных();
	Если СтруктураПрикрепленныхДанных.ОбъемПревышен ИЛИ СтруктураПрикрепленныхДанных.ОбъемПредупреждение Тогда
		Сообщить(СтруктураПрикрепленныхДанных.ТекстСообщения);
		Если СтруктураПрикрепленныхДанных.ОбъемПревышен Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;
	
	Если НоменклатураПрисоединенныеФайлы Тогда
		
		Попытка
		
			СправочникОбъект = Справочники.НоменклатураПрисоединенныеФайлы.СоздатьЭлемент();
			СправочникОбъект.ФайлХранилище = Новый ХранилищеЗначения(ОбщийМодуль.Десериализовать(Данные));
			СправочникОбъект.Наименование = ИмяФайла;
			СправочникОбъект.Расширение = Расширение;
			СправочникОбъект.ДатаСоздания = ТекущаяДатаСеанса();
			СправочникОбъект.ВладелецФайла = Ссылка;
			
			СправочникОбъект.Записать();
			ПрисоединенныйФайл = СправочникОбъект.Ссылка;
			
		Исключение
			
			Результат = Ложь;
			Сообщить(" " + ОписаниеОшибки());
			
		КонецПопытки;
		
	Иначе	
	
		Попытка
			
			МенеджерЗаписи = РегистрыСведений.ПрикрепленныеДанные.СоздатьМенеджерЗаписи();
			МенеджерЗаписи.Период = ТекущаяДатаСеанса();
			МенеджерЗаписи.Данные = Новый ХранилищеЗначения(ОбщийМодуль.Десериализовать(Данные));
			МенеджерЗаписи.ИмяФайла = ОбщийМодульСервер.ПолучитьИмяФайлаПрикрепленныхДанных(Ссылка, ИмяФайла, Расширение); //ИмяФайла;
			МенеджерЗаписи.Расширение = Расширение;
			МенеджерЗаписи.СсылкаНаОбъект = Ссылка;
			МенеджерЗаписи.Записать(Ложь);
			
		Исключение
			Результат = Ложь;
			Сообщить(" " + ОписаниеОшибки());
		КонецПопытки;
		
	КонецЕсли;	
	
	Возврат Результат;
	
КонецФункции

Функция СкопироватьЭкземплярПрикрепленныхДанных(ИсточникСсылка, ПриемникСсылка, ИмяФайла, Расширение, ДатаПрикрепления) Экспорт
	
	Результат = Истина;
	Попытка
		
		НаборЗаписей = РегистрыСведений.ПрикрепленныеДанные.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.СсылкаНаОбъект.Установить(ИсточникСсылка);
		НаборЗаписей.Отбор.ИмяФайла.Установить(ИмяФайла);
		НаборЗаписей.Отбор.Период.Установить(ДатаПрикрепления);
		НаборЗаписей.Прочитать();
		
		Если НаборЗаписей.Количество() > 0 Тогда
			
			СтрокаНабора = НаборЗаписей[0];		
		
			МенеджерЗаписи = РегистрыСведений.ПрикрепленныеДанные.СоздатьМенеджерЗаписи();
			МенеджерЗаписи.Период = ТекущаяДатаСеанса();
			МенеджерЗаписи.Данные = СтрокаНабора.Данные;
			МенеджерЗаписи.ИмяФайла =  ОбщийМодульСервер.ПолучитьИмяФайлаПрикрепленныхДанных(ПриемникСсылка, СтрокаНабора.ИмяФайла, СтрокаНабора.Расширение); //СтрокаНабора.ИмяФайла;
			МенеджерЗаписи.Расширение = СтрокаНабора.Расширение;
			МенеджерЗаписи.СсылкаНаОбъект = ПриемникСсылка;
			МенеджерЗаписи.Записать(Ложь);
			
		КонецЕсли;		
		
	Исключение
		Результат = Ложь;
		Сообщить(" " + ОписаниеОшибки());
	КонецПопытки;
	Возврат Результат;
	
КонецФункции

Процедура УдалитьФайлыВДереве(МассивФайловКУдалению) Экспорт
	
	Для каждого ЭлементМассива из МассивФайловКУдалению	Цикл
		МенеджерЗаписи = РегистрыСведений.ПрикрепленныеДанные.СоздатьМенеджерЗаписи();
		ЗаполнитьЗначенияСвойств(МенеджерЗаписи, ЭлементМассива); 					
		Попытка
			МенеджерЗаписи.Прочитать();
			МенеджерЗаписи.Удалить();
		Исключение
			Сообщить(ОписаниеОшибки());
		КонецПопытки;		
	КонецЦикла;
	
КонецПроцедуры

//Проверка монтажа по выбранным позициям заказ договора
Функция ПроверкаМонтажСоответствуетВыбраннымПозициямЗаказДоговора(Монтаж, ЗаказДоговор) Экспорт
	
	МассивРазличийЗД = Новый Массив;
	МассивРазличийМонтаж  = Новый Массив;
	
	СтруктураВозврата = Новый Структура("Результат, МассивРазличийЗД, МассивРазличийМонтаж, МассивЗД, МассивМонтаж", Истина, МассивРазличийЗД, МассивРазличийМонтаж);
	
	ТаблицаЗаказДоговора = ОбщийМодуль.ПустаяТаблицаДляСравненияЗаказов();	
	ТаблицаМотажа = ОбщийМодуль.ПустаяТаблицаДляСравненияЗаказов();
			
	//добавляем ТоварыУслуги Монтажа
	Для Каждого ТекущаяСтрока Из Монтаж.ТоварыУслуги Цикл
		НоваяСтрока = ТаблицаМотажа.Добавить();
		НоваяСтрока.Номенклатура = ТекущаяСтрока.Номенклатура; 
		НоваяСтрока.Количество = ТекущаяСтрока.Количество;
		НоваяСтрока.ЕдиницаИзмерения = ТекущаяСтрока.ЕдиницаИзмерения;
		НоваяСтрока.Спецификация = ТекущаяСтрока.Спецификация;
		НоваяСтрока.Коэффициент = ТекущаяСтрока.Коэффициент;
		НоваяСтрока.ПроцентРучнойСкидки = ТекущаяСтрока.ПроцентСкидки;
		НоваяСтрока.СуммаРучнойСкидки = ТекущаяСтрока.СуммаСкидки;
		НоваяСтрока.Цена = ТекущаяСтрока.Цена;
		НоваяСтрока.Сумма = ТекущаяСтрока.Сумма;
		НоваяСтрока.УИСтроки = ТекущаяСтрока.УИСтроки;		
		НоваяСтрока.Назначение = "Товары и услуги";
	Конеццикла;
	
	//добавляем материалы Монтажа
	Для Каждого ТекущаяСтрока Из Монтаж.Материалы Цикл
		НоваяСтрока = ТаблицаМотажа.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущаяСтрока);
		НоваяСтрока.Назначение = "Материалы";		
	КонецЦикла;
	
	//добавляем ТоварыУслуги Заказ-договора, которые присутствуют в монтаже
	Для Каждого ТекущаяСтрока Из ЗаказДоговор.ТоварыУслуги Цикл
		Если НЕ Монтаж.ТоварыУслуги.Найти(ТекущаяСтрока.УИСтроки, "УИСтроки") = Неопределено Тогда
			НоваяСтрока = ТаблицаЗаказДоговора.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущаяСтрока);
			НоваяСтрока.Назначение = "Товары и услуги";
		КонецЕсли;		
	КонецЦикла;
	
	//добавляем материалы Заказ-договора, которые присутствуют в монтаже
	Для Каждого ТекущаяСтрока Из ЗаказДоговор.Материалы Цикл
		Если НЕ Монтаж.Материалы.Найти(ТекущаяСтрока.УИСтроки, "УИСтроки") = Неопределено Тогда
			НоваяСтрока = ТаблицаЗаказДоговора.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущаяСтрока);
			НоваяСтрока.Назначение = "Материалы";
		КонецЕсли;
	КонецЦикла;
	
	//////////////////////////////
		
	//сравниваем полученные таблицы
	Для Каждого СтрокаМонтажа Из ТаблицаМотажа Цикл
		Если НЕ СтрокаМонтажа.Найдено Тогда
			Для Каждого СтрокаЗаказДоговора Из ТаблицаЗаказДоговора Цикл
				Если НЕ СтрокаЗаказДоговора.Найдено Тогда
					Если СтрокаМонтажа.Номенклатура = СтрокаЗаказДоговора.Номенклатура
						И СтрокаМонтажа.ХарактеристикаНоменклатуры = СтрокаЗаказДоговора.ХарактеристикаНоменклатуры 
						И СтрокаМонтажа.Количество = СтрокаЗаказДоговора.Количество
						И СтрокаМонтажа.ЕдиницаИзмерения = СтрокаЗаказДоговора.ЕдиницаИзмерения
						И СтрокаМонтажа.Коэффициент = СтрокаЗаказДоговора.Коэффициент
						И СтрокаМонтажа.ПроцентРучнойСкидки = СтрокаЗаказДоговора.ПроцентРучнойСкидки
						И СтрокаМонтажа.СуммаРучнойСкидки = СтрокаЗаказДоговора.СуммаРучнойСкидки
						И СтрокаМонтажа.Цена = СтрокаЗаказДоговора.Цена
						И СтрокаМонтажа.Сумма = СтрокаЗаказДоговора.Сумма
						И СтрокаМонтажа.КоличествоКВыработке = СтрокаЗаказДоговора.КоличествоКВыработке
						Тогда
						СтрокаМонтажа.Найдено = Истина;
						СтрокаЗаказДоговора.Найдено = Истина;
						Прервать;
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого СтрокаМонтажа Из ТаблицаМотажа Цикл
		Если НЕ СтрокаМонтажа.Найдено Тогда
			// пустую структуру получаем каждый раз
			СтруктураКолонок = ОбщийМодуль.ПустаяСтруктураПоКолонкамТаблицыЗначений(ТаблицаМотажа.СкопироватьКолонки());
			ЗаполнитьЗначенияСвойств(СтруктураКолонок, СтрокаМонтажа);
			МассивРазличийМонтаж.Добавить(СтруктураКолонок);
		КонецЕсли;
	КонецЦикла;
	Для Каждого СтрокаЗаказДоговора Из ТаблицаЗаказДоговора Цикл
		Если НЕ СтрокаЗаказДоговора.Найдено Тогда
			СтруктураКолонок = ОбщийМодуль.ПустаяСтруктураПоКолонкамТаблицыЗначений(ТаблицаЗаказДоговора.СкопироватьКолонки());
			ЗаполнитьЗначенияСвойств(СтруктураКолонок, СтрокаЗаказДоговора);
			МассивРазличийЗД.Добавить(СтруктураКолонок);
		КонецЕсли;
	КонецЦикла;
	СтруктураВозврата.МассивРазличийМонтаж = МассивРазличийМонтаж;
	СтруктураВозврата.МассивРазличийЗД  = МассивРазличийЗД;
	СтруктураВозврата.МассивМонтаж = ОбщегоНазначения.ТаблицаЗначенийВМассив(ТаблицаМотажа);
	СтруктураВозврата.МассивЗД  = ОбщегоНазначения.ТаблицаЗначенийВМассив(ТаблицаЗаказДоговора);
	
	ТаблицаМотажа.Свернуть("Найдено");
	ТаблицаЗаказДоговора.Свернуть("Найдено");
	
	Для Каждого ТекСтрока Из ТаблицаМотажа Цикл
		Если НЕ ТекСтрока.Найдено Тогда
			СтруктураВозврата.Результат = Ложь;
		КонецЕсли;
	КонецЦИкла;
	Для Каждого ТекСтрока Из ТаблицаЗаказДоговора Цикл
		Если НЕ ТекСтрока.Найдено Тогда
			СтруктураВозврата.Результат = Ложь;
		КонецЕсли;
	КонецЦИкла;
	
	Возврат СтруктураВозврата;
	
КонецФункции

