#Область ФункцииСопутствующейНоменклатуры

Функция ЕстьСопутствующаяНоменклатураВРегистре(Номенклатура, Характеристика, ПолучитьКоличество=Ложь) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СопутствующиеТоварыИУслуги.СопутствующийТовар КАК СопутствующийТовар,
	|	СопутствующиеТоварыИУслуги.ХарактеристикаСопутствующегоТовара КАК ХарактеристикаСопутствующегоТовара
	|ИЗ
	|	РегистрСведений.СопутствующиеТоварыИУслуги КАК СопутствующиеТоварыИУслуги
	|ГДЕ
	|	СопутствующиеТоварыИУслуги.Номенклатура = &Номенклатура
	|	И СопутствующиеТоварыИУслуги.Характеристика = &Характеристика";
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("Характеристика", Характеристика);
	Выборка = Запрос.Выполнить().Выбрать();
	Если НЕ ПолучитьКоличество Тогда
		Возврат Выборка.Количество() > 0;	
	КонецЕсли;
	
	МассивСопутствующейНоменклатурыВРегистре = Новый Массив;
	Уровень = 1;
	Если Выборка.Количество() > 0 Тогда
		Пока Выборка.Следующий() Цикл
			ДанныеПоНоменклатуре = Новый Структура;
			ДанныеПоНоменклатуре.Вставить("Родитель", Номенклатура);
			ДанныеПоНоменклатуре.Вставить("ХарактеристикаРодителя", Характеристика);
			ДанныеПоНоменклатуре.Вставить("Номенклатура", Выборка.СопутствующийТовар);
			ДанныеПоНоменклатуре.Вставить("Характеристика", Выборка.ХарактеристикаСопутствующегоТовара);
			МассивСопутствующейНоменклатурыВРегистре.Добавить(ДанныеПоНоменклатуре);
			ПолучитьВложенныеСопутствующиеТовары(МассивСопутствующейНоменклатурыВРегистре, Уровень);
		КонецЦикла;
	КонецЕсли;	
	Возврат МассивСопутствующейНоменклатурыВРегистре.Количество();
	
КонецФункции	

Процедура ПолучитьВложенныеСопутствующиеТовары(МассивСопутствующейНоменклатурыВРегистре, Уровень)
	
	Если Уровень < ДопустимаяГлубинаВложенностиСопутствующихТоваровИУслуг() Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СопутствующиеТоварыИУслуги.СопутствующийТовар КАК СопутствующийТовар,
		|	СопутствующиеТоварыИУслуги.ХарактеристикаСопутствующегоТовара КАК ХарактеристикаСопутствующегоТовара
		|ИЗ
		|	РегистрСведений.СопутствующиеТоварыИУслуги КАК СопутствующиеТоварыИУслуги
		|ГДЕ
		|	СопутствующиеТоварыИУслуги.Номенклатура = &Номенклатура
		|	И СопутствующиеТоварыИУслуги.Характеристика = &Характеристика";
		Запрос.УстановитьПараметр("Номенклатура", МассивСопутствующейНоменклатурыВРегистре[МассивСопутствующейНоменклатурыВРегистре.Количество()-1].Номенклатура);
		Запрос.УстановитьПараметр("Характеристика", МассивСопутствующейНоменклатурыВРегистре[МассивСопутствующейНоменклатурыВРегистре.Количество()-1].Характеристика);
		Выборка = Запрос.Выполнить().Выбрать();
		
		Пока Выборка.Следующий() Цикл
			ДанныеПоНоменклатуре = Новый Структура;
			ДанныеПоНоменклатуре.Вставить("Родитель", МассивСопутствующейНоменклатурыВРегистре[МассивСопутствующейНоменклатурыВРегистре.Количество()-1].Номенклатура);
			ДанныеПоНоменклатуре.Вставить("ХарактеристикаРодителя", МассивСопутствующейНоменклатурыВРегистре[МассивСопутствующейНоменклатурыВРегистре.Количество()-1].Характеристика);
			ДанныеПоНоменклатуре.Вставить("Номенклатура", Выборка.СопутствующийТовар);
			ДанныеПоНоменклатуре.Вставить("Характеристика", Выборка.ХарактеристикаСопутствующегоТовара);
			МассивСопутствующейНоменклатурыВРегистре.Добавить(ДанныеПоНоменклатуре);
			ПолучитьВложенныеСопутствующиеТовары(МассивСопутствующейНоменклатурыВРегистре, Уровень+1);
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

