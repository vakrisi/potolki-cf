Функция ПолучитьБазовуюЕдиницуИзмеренияНоменклатуры(Знач Номенклатура) Экспорт
	
	Если ЗначениеЗаполнено(Номенклатура) ТОгда
		Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Номенклатура, "БазоваяЕдиницаИзмерения");
	КонецЕсли;
	
	Возврат Справочники.КлассификаторЕдиницИзмерения.ПустаяСсылка();
	
КонецФункции

Функция ПолучитьКоэффициентЕдиницыИзмерения(ЕдиницаИзмерения) Экспорт
	
	Если ЗначениеЗаполнено(ЕдиницаИзмерения) Тогда
		Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЕдиницаИзмерения, "Коэффициент");
	КонецЕсли;
	
	Возврат 0;
	
КонецФункции

Функция ПолучитьЕдиницуИзмеренияДляПроизводства(Знач Номенклатура) Экспорт
	
	Если ЗначениеЗаполнено(Номенклатура) ТОгда
		РеквизитыНоменклатуры = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Номенклатура, "БазоваяЕдиницаИзмерения, ВидНоменклатуры, АльтернативнаяЕдиницаИзмерения");
				
		ЕдиницаИзмерения = РеквизитыНоменклатуры.БазоваяЕдиницаИзмерения;
		
		Если РеквизитыНоменклатуры.ВидНоменклатуры = Справочники.ВидыНоменклатуры.Полотно Тогда
			Если Константы.ИспользоватьАльтернативнуюЕдиницуИзмеренияМатериалаПриЗагрузкеИзИзиСилинг.Получить() Тогда
				Если НЕ РеквизитыНоменклатуры.АльтернативнаяЕдиницаИзмерения.Пустая() Тогда
					ЕдиницаИзмерения = РеквизитыНоменклатуры.АльтернативнаяЕдиницаИзмерения;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;	
		
		Возврат ЕдиницаИзмерения;
	КонецЕсли;

	Возврат Справочники.КлассификаторЕдиницИзмерения.ПустаяСсылка();
	
КонецФункции

