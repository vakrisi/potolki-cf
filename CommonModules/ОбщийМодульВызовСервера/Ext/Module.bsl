Функция Розница_ПолучитьНаименованиеНовойКомнаты(МассивКомнат, НазваниеНовойКомнаты) Экспорт
	
	ТаблицаНомеров = Новый ТаблицаЗначений;
	ТаблицаНомеров.Колонки.Добавить("Номер", Новый ОписаниеТипов("Число"));	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	НазваниеКомнат.Наименование КАК НазКомнаты
	|ИЗ
	|	Справочник.НазваниеКомнат КАК НазваниеКомнат";
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	Для Каждого Комната Из МассивКомнат Цикл
		НоваяСтрока = ТаблицаНомеров.Добавить();
		Попытка
			//#14049 если в названии комнат есть фраза "Комната", то ломается нумерация, данная замена перенесена ниже: сначала убираем названия из справочника
			//СтрокаЗамены = СтрЗаменить(Комната, "Комната ", "");
			СтрокаЗамены = Комната;
			Выборка.Сбросить();
			Пока Выборка.Следующий() Цикл
				Если Найти(СтрокаЗамены, Выборка.НазКомнаты) Тогда
					СтрокаЗамены = СтрЗаменить(СтрокаЗамены, " - " + Выборка.НазКомнаты, "");
					СтрокаЗамены = СтрЗаменить(СтрокаЗамены, Выборка.НазКомнаты, "");
					СтрокаЗамены = СтрЗаменить(СтрокаЗамены, " ", "");
				КонецЕсли;
			КонецЦикла;
			СтрокаЗамены = СтрЗаменить(СтрокаЗамены, "Комната", "");			
			 
			НоваяСтрока.Номер = Число(СтрокаЗамены);
		Исключение
		КонецПопытки;
	КонецЦикла;
	
	ТаблицаНомеров.Свернуть("Номер");
	ТаблицаНомеров.Сортировать("Номер Убыв");
	
	Если НЕ НазваниеНовойКомнаты = Неопределено Тогда
		Если ТаблицаНомеров.Количество() > 0 Тогда
			Возврат "Комната " + СтрЗаменить(Строка(ТаблицаНомеров[0].Номер+1), Символ(160), "") + " - " + НазваниеНовойКомнаты;
		Иначе
			Возврат "Комната 1" + " - " + НазваниеНовойКомнаты;
		КонецЕсли;
	Иначе
		Если ТаблицаНомеров.Количество() > 0 Тогда
			Возврат "Комната " + СтрЗаменить(Строка(ТаблицаНомеров[0].Номер+1), Символ(160), "");
		Иначе
			Возврат "Комната 1";
		КонецЕсли;
	КонецЕсли;
	
КонецФункции

