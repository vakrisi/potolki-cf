Процедура УстановитьСрокиНеНапоминатьОЗавершенииТехПоддержки(Дней) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	Попытка
		
		МенеджерЗаписи = РегистрыСведений.ДатыНеНапоминатьОТехническойПоддержке.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.Период = ТекущаяДатаСеанса();		
		МенеджерЗаписи.Пользователь = Пользователи.ТекущийПользователь();
		МенеджерЗаписи.НеУведомлятьДо = ТекущаяДатаСеанса() + (Дней * 86400);
		МенеджерЗаписи.Записать(Истина);
		
	Исключение		
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

Функция ПроверитьСрокиНеНапоминатьОЗавершенииТехПоддержки() Экспорт
	
	// Истина - нужно напомнить
	// Ложь - установлена острочка на напоминание
	КВозврату = Истина;
	
	Запрос = новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДатыНеНапоминатьОТехническойПоддержке.Пользователь,
		|	ДатыНеНапоминатьОТехническойПоддержке.НеУведомлятьДо
		|ИЗ
		|   РегистрСведений.ДатыНеНапоминатьОТехническойПоддержке КАК ДатыНеНапоминатьОТехническойПоддержке
		|ГДЕ
		|	ДатыНеНапоминатьОТехническойПоддержке.Пользователь = &Пользователь";
	Запрос.УстановитьПараметр("Пользователь", Пользователи.ТекущийПользователь());
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		КВозврату = (Выборка.НеУведомлятьДо < ТекущаяДатаСеанса());
	КонецЕсли;
	
	Возврат КВозврату;
	
КонецФункции

Функция ЭтоЗаказИнтеркампаниСОднойОрганизацией(СсылкаЗаказПокупателя) Экспорт
	
	СтруктураВозврата = Новый Структура("Результат, ТекстОшибки", Ложь, "");
	
	Если ЗначениеЗаполнено(СсылкаЗаказПокупателя.НастройкаИнтеркампани) Тогда
		Если СсылкаЗаказПокупателя.НастройкаИнтеркампани.ОднаОрганизацияПроизводстваИПродажиПотолков Тогда
			ТекстОшибки = "%Документ% оформлен по настройке интеркампани, которая не подразумевает необходимость создания документа реализации. Реализация не создана";
			СтруктураВозврата.ТекстОшибки = СтрЗаменить(ТекстОшибки, "%Документ%", СсылкаЗаказПокупателя);
			СтруктураВозврата.Результат = Истина;
		КонецЕсли;
	КонецЕсли;
	
	Возврат СтруктураВозврата;
	
КонецФункции

Функция ПолучитьРеализациюПоЗаказу(ЗаказСсылка) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЗаказыПокупателейОбороты.Регистратор.Ссылка КАК Ссылка
	|ИЗ
	|	РегистрНакопления.ЗаказыПокупателей.Обороты(, , Регистратор, ЗаказНаПроизводство = &Заказ) КАК ЗаказыПокупателейОбороты
	|ГДЕ
	|	ЗаказыПокупателейОбороты.КоличествоРасход > 0";
	Запрос.УстановитьПараметр("Заказ", ЗаказСсылка);
	Выборка = Запрос.Выполнить().Выбрать();
	УстановитьПривилегированныйРежим(Ложь);
	Пока Выборка.Следующий() Цикл
		Возврат Выборка.Ссылка;
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции

Функция ПолучитьОсновнуюСпецификациюНоменклатуры(Номенклатура, ВидСпецификации) Экспорт
	
	//#12667 переделано с учетом ВидСпецификации
	//Возврат Номенклатура.ОсновнаяСпецификация;
	
	Результат = Справочники.Спецификации.ПустаяСсылка();
	НеобходимыеРеквизиты = "ОсновнаяСпецификация, ОсновнаяСпецификацияКомплектация, ОсновнаяСпецификацияСопутствующиеМатериалы";
	ДанныеНоменклатуры = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Номенклатура, НеобходимыеРеквизиты);
	Если ВидСпецификации = Перечисления.ВидыСпецификации.СпецификацияПродукции Тогда
		Результат = ДанныеНоменклатуры.ОсновнаяСпецификация;
	ИначеЕсли ВидСпецификации = Перечисления.ВидыСпецификации.СопутствующиеМатериалы Тогда
		Результат = ДанныеНоменклатуры.ОсновнаяСпецификацияСопутствующиеМатериалы;
	ИначеЕсли ВидСпецификации = Перечисления.ВидыСпецификации.Комплектация Тогда
		Результат = ДанныеНоменклатуры.ОсновнаяСпецификацияКомплектация;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Результат) Тогда
		ВидСпецификацииРезультата = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Результат, "ВидСпецификации");
		Если НЕ ВидСпецификацииРезультата = ВидСпецификации Тогда
			Результат = Справочники.Спецификации.ПустаяСсылка();
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьДанныеНоменклатурыПриИзменении(СтруктураДанные) Экспорт
	
	НеобходимыеРеквизиты = "БазоваяЕдиницаИзмерения, СтатьяДоходов, СтатьяРасходов, 
							|ВидНоменклатуры, 
							|Потолок_ПериметрПомещения, Потолок_КоличествоВыработка, УчитыватьКакПотолокВОтчетахПоЭффективности,
							|Потолок_НомерРасчета, Потолок_ИндексПотолка,
							|СтавкаНДС"; //nva
	ДанныеНоменклатуры = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СтруктураДанные.Номенклатура, НеобходимыеРеквизиты);
	
	СтруктураДанные.Вставить("ЕдиницаИзмерения", ДанныеНоменклатуры.БазоваяЕдиницаИзмерения);
	СтруктураДанные.Вставить("Коэффициент", 1);
	СтруктураДанные.Вставить("ВидНоменклатуры", ДанныеНоменклатуры.ВидНоменклатуры);
	СтруктураДанные.Вставить("ПериметрПомещения", ДанныеНоменклатуры.Потолок_ПериметрПомещения);
	СтруктураДанные.Вставить("НомерРасчета", ДанныеНоменклатуры.Потолок_НомерРасчета);
	СтруктураДанные.Вставить("ИндексПотолка", ДанныеНоменклатуры.Потолок_ИндексПотолка);
	СтруктураДанные.Вставить("СтавкаНДС", ДанныеНоменклатуры.СтавкаНДС); //nva

	Если ПолучитьФункциональнуюОпцию("ИспользоватьВедениеУчетаДоходовРасходовПострочно") Тогда
		СтруктураДанные.Вставить("СтатьяДоходов",  ДанныеНоменклатуры.СтатьяДоходов);	
		СтруктураДанные.Вставить("СтатьяРасходов", ДанныеНоменклатуры.СтатьяРасходов);
	Иначе
		СтруктураДанные.Вставить("СтатьяДоходов",  Справочники.СтатьиДоходовИРасходов.ПустаяСсылка());	
