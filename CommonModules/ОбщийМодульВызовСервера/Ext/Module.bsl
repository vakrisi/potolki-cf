Функция ПолучитьДанныеБлокировки(ИнформацияОбОшибке)
	
	Результат  = Новый Структура("ВремяНачалаБлокировки,ИмяПользователяЗаблокировавшегоДок,ЗаблокированВТекущемСеансе");
	СистемИнфо = Новый СистемнаяИнформация;
	ВерсияПлатформы = СистемИнфо.ВерсияПриложения;
	ИмяПользователяЗаблокировавшегоДок = "";
	ВремяНачалаБлокировки = "";
	ЗаблокированВТекущемСеансе = Ложь;
	АктивныеСеансы = ПолучитьСеансыИнформационнойБазы();
	//НомерТекущегоСеансаСтрокой = Строка(НомерСеансаИнформационнойБазы());

	//++ №7388 закомментировано, т.к. в пределах одной версии платформы может быть разный формат ошибки
	//Если Найти(ВерсияПлатформы, "8.3.10.") <> 0 
	//	ИЛИ Найти(ВерсияПлатформы, "8.3.11.") <> 0 
	//	ИЛИ Найти(ВерсияПлатформы, "8.3.12.") <> 0 
	//	ИЛИ Найти(ВерсияПлатформы, "8.3.13.") <> 0 Тогда // 8.3.13.1644 возвращает в таком виде			
	//-- №7388 закомментировано
	
	// №7388 новая логика получения данных из ошибки
	Ошибка = ИнформацияОбОшибке.Причина.Описание;
	Если Найти(Ошибка, "сеанс") > 0 Тогда
		ОбрезанаОшибка = Сред(Ошибка, Найти(Ошибка, "сеанс:")+6);
		НомерСеансаСтрокой = Сред(ОбрезанаОшибка, 0 , Найти(ОбрезанаОшибка,", начат:")-1);
	Иначе
		НомерСеансаСтрокой = Сред(Ошибка, СтрНайти(Ошибка, ", ", НаправлениеПоиска.СКонца)+2);
	КонецЕсли;
	
	//НомерСеанса = Число(Сред(ОбрезанаОшибка, 0 , Найти(ОбрезанаОшибка,", начат:")-1));
	
	Попытка
		НомерСеанса = Число(НомерСеансаСтрокой);
	Исключение
		НомерСеанса = 0;
	КонецПопытки;
	
	Если НомерСеанса <> НомерСеансаИнформационнойБазы() Тогда
		
		Для Каждого Элемент Из АктивныеСеансы Цикл
			Если Элемент.НомерСеанса = НомерСеанса Тогда
				ИмяПользователяЗаблокировавшегоДок = Элемент.Пользователь.ПолноеИмя;
				ВремяНачалаБлокировки = Сред(ОбрезанаОшибка, Найти(ОбрезанаОшибка,", начат:"));
				Прервать;
			КонецЕсли;
		КонецЦикла;
	Иначе
		ЗаблокированВТекущемСеансе = Истина;
	КонецЕсли;		
		
	//++ №7388 закомментировано, т.к. в пределах одной версии платформы может быть разный формат ошибки	
	//Иначе // для платформ выше в ОписаниеОшибки строка в формате "Компьютер, Пользователь, НомерСеанса"		
	//	Если Найти(Ошибка, НомерТекущегоСеансаСтрокой) = 0 Тогда
	//		Для Каждого Элемент Из АктивныеСеансы Цикл
	//			Если Найти(Ошибка, Строка(Элемент.НомерСеанса)) <> 0 Тогда
	//				ИмяПользователяЗаблокировавшегоДок = Элемент.Пользователь.ПолноеИмя;
	//				Прервать;
	//			КонецЕсли;
	//		КонецЦикла;
	//	Иначе
	//		ЗаблокированВТекущемСеансе = Истина;
	//	КонецЕсли;	
	//КонецЕсли;
	//-- №7388 закомментировано
	
	Результат.ВремяНачалаБлокировки = ВремяНачалаБлокировки;
	Результат.ИмяПользователяЗаблокировавшегоДок = ИмяПользователяЗаблокировавшегоДок;
	Результат.ЗаблокированВТекущемСеансе = ЗаблокированВТекущемСеансе;
	
	Возврат Результат;	

КонецФункции
		
//блокировки документов для запрета одновременного создания на основании
Процедура ЗаблокироватьОбъектДляРедактирования(Знач Ссылка, Знач Форма, ГруппаЭлементовСоздатьНаОсновании=Неопределено) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	Попытка
		ЗаблокироватьДанныеДляРедактирования(Ссылка,, Форма.УникальныйИдентификатор);
	Исключение
		Ошибка = ИнформацияОбОшибке(); // №7388 было ОписаниеОшибки();
		ДанныеБлокировки = ПолучитьДанныеБлокировки(Ошибка);
				
		Если ТипЗнч(Ссылка) = Тип("ДокументСсылка.Лид") Тогда
			Сообщить("Внимание! Форма данного лида так же открыта у пользователя: " + ДанныеБлокировки.ИмяПользователяЗаблокировавшегоДок + ДанныеБлокировки.ВремяНачалаБлокировки+ "
				|Сохранение документа может привести к потере несохранненых этим пользователем данных.");			
		Иначе
			Если ТипЗнч(Ссылка) = Тип("ДокументСсылка.ЗаказДоговор") Тогда
				Форма.ТолькоПросмотр = Истина;
			КонецЕсли;
			Сообщить("Объект заблокирован пользователем: " + ДанныеБлокировки.ИмяПользователяЗаблокировавшегоДок + ДанныеБлокировки.ВремяНачалаБлокировки);
		КонецЕсли;
				
		Если НЕ ГруппаЭлементовСоздатьНаОсновании = Неопределено И НЕ ТипЗнч(Ссылка) = Тип("ДокументСсылка.ЗаказПокупателя") Тогда
			ГруппаЭлементовСоздатьНаОсновании.Доступность = Ложь;
		КонецЕсли;	
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

Функция ПроверкаОбъектЗаблокирован(Знач Ссылка) Экспорт
	
	СтруктураПроверки = новый Структура;
	СтруктураПроверки.Вставить("Заблокирован", Ложь);
	СтруктураПроверки.Вставить("ЗаблокированВТекущемСеансе", Ложь);
	СтруктураПроверки.Вставить("ПользовательИДата", "");	
	
	УстановитьПривилегированныйРежим(Истина);
	
	Попытка
		ЗаблокироватьДанныеДляРедактирования(Ссылка);
	Исключение
		Ошибка = ИнформацияОбОшибке(); // №7388 было ОписаниеОшибки();
		ДанныеБлокировки = ПолучитьДанныеБлокировки(Ошибка);
		
		СтруктураПроверки.Вставить("Заблокирован", Истина);
		СтруктураПроверки.Вставить("ЗаблокированВТекущемСеансе", ДанныеБлокировки.ЗаблокированВТекущемСеансе);
		СтруктураПроверки.Вставить("ПользовательИДата", ДанныеБлокировки.ИмяПользователяЗаблокировавшегоДок + ДанныеБлокировки.ВремяНачалаБлокировки);		
		
	КонецПопытки;
	Попытка
		РазблокироватьДанныеДляРедактирования(Ссылка);
	Исключение
	КонецПопытки;
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат СтруктураПроверки;
	
КонецФункции	

Функция ПолучитьКонтрагентаПоНомеруТелефона(мНомерТелефона) Экспорт
	
	КВозврату = Справочники.Контрагенты.ПустаяСсылка();
	
	Если НЕ ЗначениеЗаполнено(мНомерТелефона) Тогда
		Возврат КВозврату;
	КонецЕсли;
	мНомерТелефона = СофтФон.ОставитьТолькоЦифры(мНомерТелефона);		
	НомерТелефона = Прав(мНомерТелефона, СтрДлина(мНомерТелефона)-1);
	
	Если ПустаяСтрока(НомерТелефона) Тогда
		Возврат КВозврату;
	КонецЕсли;

	Запрос = новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|   КонтактнаяИнформация.Ссылка
	|ИЗ 
	|	Справочник.Контрагенты.КонтактнаяИнформация КАК КонтактнаяИнформация
	|ГДЕ
	|   КонтактнаяИнформация.НомерТелефона ПОДОБНО &НомерТелефона
	|   И НЕ КонтактнаяИнформация.Ссылка.ПометкаУдаления
	|";
