Функция ПолучитьМассивФайловЗНП(ДокументСсылка) Экспорт
	
	Файлы = Новый Массив;
	
	СписокНоменклатуры = Новый СписокЗначений;
	Если ЗначениеЗаполнено(ДокументСсылка.ПродукцияНоменклатура) Тогда
		СписокНоменклатуры.Добавить(ДокументСсылка.ПродукцияНоменклатура);
	КонецЕсли;
	 
	Для Каждого Строка Из ДокументСсылка.Продукция Цикл
		СписокНоменклатуры.Добавить(Строка.Номенклатура);
	КонецЦикла;
	
	Для Каждого Строка Из ДокументСсылка.Товары Цикл
		Если Справочники.ВидыНоменклатуры.ЭтоНоменклатураПотолкаИлиОтреза(Строка.Номенклатура) Тогда
			СписокНоменклатуры.Добавить(Строка.Номенклатура);
		КонецЕсли;
	КонецЦикла;
	
	МассивДоступныхРасширений = Новый Массив;
	МассивДоступныхРасширений.Добавить("pdf");  //++ 2020-08-06	
	МассивДоступныхРасширений.Добавить("jpg");  //#10734
	МассивДоступныхРасширений.Добавить("jpeg"); //#10734

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ПрикрепленныеДанные.СсылкаНаОбъект КАК Номенклатура,
	|	ПрикрепленныеДанные.ИмяФайла,
	|	ПрикрепленныеДанные.Расширение,
	|	ПрикрепленныеДанные.ВидФайлаПрограммыПостроителя,
	|	ПрикрепленныеДанные.Период КАК ДатаПрикрепления
	|ИЗ
	|	РегистрСведений.ПрикрепленныеДанные КАК ПрикрепленныеДанные
	|ГДЕ
	|	ПрикрепленныеДанные.СсылкаНаОбъект В(&СсылкаНаОбъект)
	|	И ПрикрепленныеДанные.Расширение В(&МассивДоступныхРасширений)
	|";
	Запрос.УстановитьПараметр("СсылкаНаОбъект", СписокНоменклатуры);
	Запрос.УстановитьПараметр("МассивДоступныхРасширений", МассивДоступныхРасширений);

	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		СтруктураФайл = Новый Структура;
		СтруктураФайл.Вставить("Номенклатура", Выборка.Номенклатура);
		СтруктураФайл.Вставить("ИмяФайла", Выборка.ИмяФайла);
		СтруктураФайл.Вставить("Расширение", Выборка.Расширение);
		СтруктураФайл.Вставить("ВидФайлаПрограммыПостроителя", Выборка.ВидФайлаПрограммыПостроителя);
		СтруктураФайл.Вставить("ДатаПрикрепления", Выборка.ДатаПрикрепления);
		
		Файлы.Добавить(СтруктураФайл);
		
	КонецЦикла;
	
	Возврат Файлы;
	
КонецФункции
