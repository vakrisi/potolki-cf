Функция ПолучитьСписокСопутствующихТоваров(Номенклатура, Характеристика = Неопределено, Количество, УИСтрокиРодителя=Неопределено, Уровень=0) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СопутствующиеТоварыИУслуги.Номенклатура КАК Номенклатура,
	|	СопутствующиеТоварыИУслуги.Характеристика КАК Характеристика,
	|	СопутствующиеТоварыИУслуги.СопутствующийТовар КАК СопутствующийТовар,
	|	СопутствующиеТоварыИУслуги.ХарактеристикаСопутствующегоТовара КАК ХарактеристикаСопутствующегоТовара,
	|	СопутствующиеТоварыИУслуги.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	СопутствующиеТоварыИУслуги.Коэффициент КАК Коэффициент,
	|	СопутствующиеТоварыИУслуги.Количество КАК Количество,
	|	СопутствующиеТоварыИУслуги.ФиксированноеКоличество КАК ФиксированноеКоличество,
	|	СопутствующиеТоварыИУслуги.ОкруглятьВБольшуюСторону КАК ОкруглятьВБольшуюСторону,
	|	СопутствующиеТоварыИУслуги.ПорядокОкругленияЧислом КАК ПорядокОкругленияЧислом
	|ИЗ
	|	РегистрСведений.СопутствующиеТоварыИУслуги КАК СопутствующиеТоварыИУслуги
	|ГДЕ
	|	СопутствующиеТоварыИУслуги.Номенклатура = &Номенклатура
	|	И СопутствующиеТоварыИУслуги.Характеристика = &Характеристика";
	
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("Характеристика", ?(Характеристика = Неопределено, Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка(), Характеристика));
	
	НаборЗаписей = Запрос.Выполнить().Выгрузить();
	МассивЗаписей = Новый Массив;	
	Для Каждого Запись из НаборЗаписей Цикл
		СтруктураЗаписи =  Новый Структура;
		СтруктураЗаписи.Вставить("Номенклатура", 			Запись.СопутствующийТовар);
		СтруктураЗаписи.Вставить("Характеристика", 			Запись.ХарактеристикаСопутствующегоТовара);
		СтруктураЗаписи.Вставить("ЕдиницаИзмерения",		Запись.ЕдиницаИзмерения);
		СтруктураЗаписи.Вставить("Коэффициент", 			Запись.Коэффициент);
		СтруктураЗаписи.Вставить("УИСтроки", 					Строка(Новый УникальныйИдентификатор()));
		СтруктураЗаписи.Вставить("УИСтрокиРодителя", 	Строка(	УИСтрокиРодителя));
		СтруктураЗаписи.Вставить("Уровень", 						Уровень+1);
		
		Если Запись.ФиксированноеКоличество Тогда
			СтруктураЗаписи.Вставить("Количество", Запись.Количество);
		ИначеЕсли Запись.ПорядокОкругленияЧислом > 0 Тогда
			//Округляем до точности указанной в "ПорядокОкругленияЧислом" 
			РасчетноеКоличество = Запись.Количество * Количество;
			КратПоПорядкуОкругления = Окр(РасчетноеКоличество/Запись.ПорядокОкругленияЧислом, 0);
			ОкругленноеКоличество = КратПоПорядкуОкругления * Запись.ПорядокОкругленияЧислом;
			Остаток = РасчетноеКоличество - ОкругленноеКоличество;
			Если Остаток > 0 И (Остаток > Запись.ПорядокОкругленияЧислом/2 ИЛИ Запись.ОкруглятьВБольшуюСторону) Тогда
				ОкругленноеКоличество = ОкругленноеКоличество + Запись.ПорядокОкругленияЧислом;
			КонецЕсли;	
			СтруктураЗаписи.Вставить("Количество", ОкругленноеКоличество);
		Иначе
			СтруктураЗаписи.Вставить("Количество", Запись.Количество * Количество);
		КонецЕсли;
		
		МассивЗаписей.Добавить(СтруктураЗаписи);
	КонецЦикла;
	
	Возврат МассивЗаписей;
	
КонецФункции

#КонецОбласти
