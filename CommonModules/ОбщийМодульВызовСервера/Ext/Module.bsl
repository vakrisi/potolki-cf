Функция ПолучитьСтруктуруУведомлений() Экспорт 
	
	СтруктураВозврата = Новый Структура;
	ПоказыватьУведомлениеОРезервномКопировании 		= ПоказыватьУведомлениеОРезервномКопировании();
	ПоказыватьУведомлениеОЗапускеЭкспрессПроверки 	= ПоказыватьУведомлениеОЗапускеЭкспрессПроверки();
	//#7399
	ПоказыватьУведомлениеОбОбработкеПослеОбновления = ПоказыватьУведомлениеОбОбработкеПослеОбновления();
	//ОтветПоказыватьУведомлениеОПроверкеПубликацииДляМобильногоКлиента = ПоказыватьУведомлениеОПроверкеПубликацииДляМобильногоКлиента();
	
	// №9396
	ПоказыватьУведомлениеОПревышенииОбъемаПрикрепленныхДанных = ПоказыватьУведомлениеОПревышенииОбъемаПрикрепленныхДанных();
	
	//#10449
	ПоказыватьУведомлениеПоСервисам = ПоказыватьУведомлениеПоСервисам();
	
	ТребуетсяУведомление = ПоказыватьУведомлениеОРезервномКопировании                                          // дополнять при новых событиях
							ИЛИ ПоказыватьУведомлениеОЗапускеЭкспрессПроверки
							ИЛИ ПоказыватьУведомлениеОбОбработкеПослеОбновления
							//ИЛИ ОтветПоказыватьУведомлениеОПроверкеПубликацииДляМобильногоКлиента.Показывать; 
							ИЛИ ПоказыватьУведомлениеОПревышенииОбъемаПрикрепленныхДанных
							ИЛИ ПоказыватьУведомлениеПоСервисам;
	
	СтруктураВозврата.Вставить("ПоказыватьУведомлениеОРезервномКопировании", ПоказыватьУведомлениеОРезервномКопировании);
	СтруктураВозврата.Вставить("ПоказыватьУведомлениеОЗапускеЭкспрессПроверки", ПоказыватьУведомлениеОЗапускеЭкспрессПроверки);
	СтруктураВозврата.Вставить("ПоказыватьУведомлениеОбОбработкеПослеОбновления", ПоказыватьУведомлениеОбОбработкеПослеОбновления);
	//СтруктураВозврата.Вставить("ПоказатьСостояниеПубликацииДляМобильногоКлиента", ОтветПоказыватьУведомлениеОПроверкеПубликацииДляМобильногоКлиента.Показывать);
	//СтруктураВозврата.Вставить("РезультатПроверкиМобильногоКлиента", ОтветПоказыватьУведомлениеОПроверкеПубликацииДляМобильногоКлиента.РезультатПроверкиМобильногоКлиента);
	СтруктураВозврата.Вставить("ПоказыватьУведомлениеОПревышенииОбъемаПрикрепленныхДанных", ПоказыватьУведомлениеОПревышенииОбъемаПрикрепленныхДанных);
	СтруктураВозврата.Вставить("ПоказыватьУведомлениеПоСервисам", ПоказыватьУведомлениеПоСервисам);
	СтруктураВозврата.Вставить("ТребуетсяУведомление", ТребуетсяУведомление);
	
	
	Возврат СтруктураВозврата;
	
КонецФункции

Функция ПоказыватьУведомлениеОРезервномКопировании()
	
	Если НЕ РольДоступна("АдминистраторСистемы") И НЕ РольДоступна("ПолныеПрава") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	РезультатПроверки = ОбщийМодуль.ОпределитьМассивПеременныхСеанса();
	Если РезультатПроверки.Коробка = 1 Тогда
		//не коробка
		Возврат Ложь;
	КонецЕсли;
	
	ПоказыватьУведомление = Истина;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	УведомлениеОРезервномКопировании.НеПоказывать КАК НеПоказывать
	|ИЗ
	|	РегистрСведений.УведомлениеОРезервномКопировании КАК УведомлениеОРезервномКопировании
	|ГДЕ
	|	УведомлениеОРезервномКопировании.Версия = &Версия
	|	И УведомлениеОРезервномКопировании.Пользователь = &Пользователь
	|	И УведомлениеОРезервномКопировании.НеПоказывать";
	
	Запрос.УстановитьПараметр("Версия", ОбщийМодуль.ПолучитьВерсиюКонфигурации());
	Запрос.УстановитьПараметр("Пользователь", Пользователи.ТекущийПользователь());
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ПоказыватьУведомление = Ложь;
	КонецЕсли;
	
	Возврат ПоказыватьУведомление;
	
КонецФункции

Функция ПоказыватьУведомлениеОЗапускеЭкспрессПроверки()
	//nva+++ надоело - отключил
	Возврат Ложь;
	//nva---
	Если НЕ РольДоступна("АдминистраторСистемы") И НЕ РольДоступна("ПолныеПрава") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ДатаЗапуска = ОбщийМодульСервер.ПолучитьДатуПоследнегоЗапускаОтчетаЭкспрессПроверки();
	// если в регистре нет ни одной записи, то зафиксируем точку отчета как текущее время
	Если ДатаЗапуска = Дата(1,1,1) Тогда
		ОбщийМодульСервер.ОтметитьЗапускОтчетаЭкспрессПроверки();
		Возврат Ложь;
	КонецЕсли;
	
	Если ТекущаяДатаСеанса() - ДатаЗапуска > 86400*7 Тогда
		Возврат Истина;	
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

