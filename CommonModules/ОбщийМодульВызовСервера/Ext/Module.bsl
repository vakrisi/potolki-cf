Функция ПолучитьИнформациюПоСвязкеЗамераЛидаИЗаказДоговора(ДокументСсылка) Экспорт
	
	СтруктураОтвета = новый Структура("УказанЗамер, ЗамерщикСовпадает", Ложь, Ложь);
	
	Если НЕ ТипЗнч(ДокументСсылка.Основание) = Тип("ДокументСсылка.Лид") Тогда
		Возврат СтруктураОтвета;
	КонецЕсли;
	
	Замеры = ДокументСсылка.Основание.Замеры;
	
	СтруктураОтвета.УказанЗамер = (ЗначениеЗаполнено(ДокументСсылка.ИдентификаторЗамера));
	
	// проверка что в заказ-договоре указан замер (ИД) и замерщик замера совпадает с замерщиком договора
	Если ЗначениеЗаполнено(ДокументСсылка.ИдентификаторЗамера)
		И Замеры.НайтиСтроки(новый Структура("ИДЗамера", ДокументСсылка.ИдентификаторЗамера)).Количество() > 0
		И Замеры.НайтиСтроки(новый Структура("ИДЗамера", ДокументСсылка.ИдентификаторЗамера))[0].ИсполнительЗамера = ДокументСсылка.ИсполнительЗамера Тогда
		
		СтруктураОтвета.ЗамерщикСовпадает = Истина;
		
	КонецЕсли;
	
	Возврат СтруктураОтвета;
	
КонецФункции

