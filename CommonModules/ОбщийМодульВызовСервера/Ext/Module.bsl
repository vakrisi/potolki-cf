КонецФункции

Функция ЭтоПроизводствоУникальнойПродукции(ЗаказНаПроизводство) Экспорт
	
	Результат = Ложь;
	
	Если ТипЗнч(ЗаказНаПроизводство) = Тип("ДокументСсылка.ЗаказНаПроизводство") Тогда
		Если ЗаказНаПроизводство.ВидЗаказа = Перечисления.ВидыЗаказовНаПроизводство.ПроизводствоПотолка Тогда
			Результат = Истина;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция НайтиДокументВыпускаПродукции(СсылкаНаЗаказНаПроизводство) Экспорт
	
	Результат = Документы.ВыпускПродукции.ПустаяСсылка();
	
	Если СсылкаНаЗаказНаПроизводство.ВидЗаказа = Перечисления.ВидыЗаказовНаПроизводство.ПроизводствоПотолка Тогда
		//подберем последний документ выпуска продукции по данному заказу на производство
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЗаказыНаПроизводствоОбороты.Регистратор
		|ИЗ
		|	РегистрНакопления.ЗаказыНаПроизводство.Обороты(, , Регистратор, ЗаказНаПроизводство = &ЗаказНаПроизводство) КАК ЗаказыНаПроизводствоОбороты
		|ГДЕ
		|	ЗаказыНаПроизводствоОбороты.КоличествоРасход > 0
		|	И ЗаказыНаПроизводствоОбороты.ЗаказНаПроизводство.ПродукцияНоменклатура = &ПродукцияНоменклатура";
		Запрос.УстановитьПараметр("ЗаказНаПроизводство",СсылкаНаЗаказНаПроизводство);
		Запрос.УстановитьПараметр("ПродукцияНоменклатура",СсылкаНаЗаказНаПроизводство.ПродукцияНоменклатура);
		
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			ВыпускПродукции = Выборка.Регистратор;
			Результат = Выборка.Регистратор;
		КонецЦикла;
	Иначе
		//подберем последний документ выпуска продукции по данному заказу на производство
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЗаказыНаПроизводствоОбороты.Регистратор
		|ИЗ
		|	РегистрНакопления.ЗаказыНаТиповоеПроизводство.Обороты(, , Регистратор, ЗаказНаПроизводство = &ЗаказНаПроизводство) КАК ЗаказыНаПроизводствоОбороты
		|ГДЕ
		|	ЗаказыНаПроизводствоОбороты.КоличествоРасход > 0";
		Запрос.УстановитьПараметр("ЗаказНаПроизводство",СсылкаНаЗаказНаПроизводство);
		
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			ВыпускПродукции = Выборка.Регистратор;
			Результат = Выборка.Регистратор;
		КонецЦикла;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ДокументПроведен(Документ) Экспорт
	Возврат Документ.Проведен;
КонецФункции

Функция ИзменяетсяСтатусПроведения(Знач ДокументОбъект, Знач РежимЗаписи) Экспорт
	
	Возврат (НЕ ДокументОбъект.Ссылка.Проведен И РежимЗаписи = РежимЗаписиДокумента.Проведение)
			ИЛИ (ДокументОбъект.Ссылка.Проведен И РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения);
			
КонецФункции

Функция ЕстьНеПроведенныйДокументВыпускаПоЭтомуЗаказу(СсылкаНаЗаказНаПроизводство) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВыпускПродукции.Ссылка
	|ИЗ
	|	Документ.ВыпускПродукции КАК ВыпускПродукции
	|ГДЕ
	|	ВыпускПродукции.Основание = &СсылкаНаЗаказНаПроизводство
	|	И НЕ ВыпускПродукции.ПометкаУдаления
	|	И НЕ ВыпускПродукции.Проведен";
	Запрос.УстановитьПараметр("СсылкаНаЗаказНаПроизводство",СсылкаНаЗаказНаПроизводство);
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда 
		Возврат Документы.ВыпускПродукции.ПустаяСсылка();
	Иначе
		ВыборкаЗапроса = РезультатЗапроса.Выбрать();
		Пока ВыборкаЗапроса.Следующий() Цикл
			Возврат ВыборкаЗапроса.Ссылка;
		КонецЦикла;
	КонецЕсли;
	
КонецФункции

Функция ВыпускСоответствуетЗаказу(Выпуск, Заказ) Экспорт
	
	Если Заказ.ВидЗаказа = Перечисления.ВидыЗаказовНаПроизводство.ПроизводствоПотолка Тогда
		Если Выпуск.ПродукцияНоменклатура = Заказ.ПродукцияНоменклатура
			и Выпуск.ПродукцияНомерРасчета = Заказ.ПродукцияНомерРасчета Тогда
			Возврат Истина;
		Иначе
			Возврат Ложь;
		КонецЕсли;
	Иначе
		ТаблицаВыпуска = Выпуск.Продукция.Выгрузить();
		ТаблицаВыпуска.Свернуть("Номенклатура, ЕдиницаИзмерения","Количество");
		ТаблицаВыпуска.Сортировать("Номенклатура Возр, ЕдиницаИзмерения Возр, Количество Возр");
		ТаблицаЗаказа = Заказ.Продукция.Выгрузить();
		ТаблицаЗаказа.Свернуть("Номенклатура, ЕдиницаИзмерения","Количество");
		ТаблицаЗаказа.Сортировать("Номенклатура Возр, ЕдиницаИзмерения Возр, Количество Возр");
		Если НЕ ТаблицаВыпуска.Количество() = ТаблицаЗаказа.Количество() Тогда
			Возврат Ложь;
		Иначе
			Для НомерСтроки = 0 По ТаблицаВыпуска.Количество()-1 Цикл
				Если НЕ ТаблицаВыпуска[НомерСтроки].Номенклатура = ТаблицаЗаказа[НомерСтроки].Номенклатура
					ИЛИ НЕ ТаблицаВыпуска[НомерСтроки].ЕдиницаИзмерения = ТаблицаЗаказа[НомерСтроки].ЕдиницаИзмерения
					ИЛИ НЕ ТаблицаВыпуска[НомерСтроки].Количество = ТаблицаЗаказа[НомерСтроки].Количество Тогда
						Возврат Ложь;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		ВозВрат Истина;
	КонецЕсли;
	
КонецФункции

Функция ИзменитьСтатусЗаказаНаПроизводствоНаПроизведен(Заказ = Неопределено, Номер="", Дата = Неопределено) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЗаказНаПроизводство.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ЗаказНаПроизводство КАК ЗаказНаПроизводство
	|ГДЕ
	|	(ЗаказНаПроизводство.Номер = &Номер
	|				И ЗаказНаПроизводство.Дата = &Дата
	|			ИЛИ ЗаказНаПроизводство.Ссылка = &Заказ)";
	Запрос.УстановитьПараметр("Номер", Номер);
	Запрос.УстановитьПараметр("Дата",  Дата);
	Запрос.УстановитьПараметр("Заказ", Заказ);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ДокументОбъект = Выборка.Ссылка.ПолучитьОбъект();
		Если ДокументОбъект.ПроверитьЗаполнение() Тогда
			ДокументОбъект.ТекущийСтатус = Справочники.СтатусыЗаказовНаПроизводство.Произведен;
			Попытка
				ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);				
			Исключение
				Возврат Ложь;				
			КонецПопытки;
			//сформируем электронное письмо
			Если РаботаСЭлектроннойПочтой.ОтправлятьEMailКонтрагентуПриПереводеЗаказаНаПроизводствоВСтатусПроизведен() Тогда
				СсылкаНаЭлектронноеПисьмо = Документы.ЗаказНаПроизводство.СформироватьЭлектронноеПисьмоКонтрагентуОПереводеВСтатусПроизведен(Выборка.Ссылка);
				Если НЕ СсылкаНаЭлектронноеПисьмо.Пустая() Тогда
					РезультатОтправки = Документы.ЭлектронноеПисьмо.ОтправитьЭлектронноеПисьмо(СсылкаНаЭлектронноеПисьмо);
					Если НЕ ПустаяСтрока(РезультатОтправки) Тогда
						Сообщить("Ошибка отправки электронного письма контрагенту: " + РезультатОтправки);
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

Функция ПолучитьПотолокЗаказаНаПроизводство(СсылкаНаЗаказНаПроизводство) Экспорт
	
	СтруктураОтвета = Новый Структура;
	СтруктураОтвета.Вставить("Потолок", Справочники.Номенклатура.ПустаяСсылка());
	СтруктураОтвета.Вставить("УИСтроки", "");
	
	Если СсылкаНаЗаказНаПроизводство.ВидЗаказа = Перечисления.ВидыЗаказовНаПроизводство.ПроизводствоПотолка Тогда
		
		СтруктураОтвета.Вставить("Потолок", СсылкаНаЗаказНаПроизводство.ПродукцияНоменклатура);
		СтруктураОтвета.Вставить("УИСтроки", СсылкаНаЗаказНаПроизводство.ПродукцияУИСтроки);
	
	КонецЕсли;
	
	Возврат СтруктураОтвета;
	
КонецФункции

// вызов из модуля СозданиеНаОснованииПотолкиКлиент
Функция СоздатьОбновитьВыпускПродукции(ДанныеЗаполнения, СсылкаНаДокументВыпуска, ОписаниеОшибки) Экспорт
	
	Если СсылкаНаДокументВыпуска <> Неопределено И НЕ СсылкаНаДокументВыпуска.Пустая() Тогда
		ВыпускОбъект = СсылкаНаДокументВыпуска.ПолучитьОбъект();
		ВыпускОбъект.ОбновитьДату(); //#14923
	Иначе
		ВыпускОбъект = Документы.ВыпускПродукции.СоздатьДокумент();
		ВыпускОбъект.Дата = ТекущаяДатаСеанса();
	КонецЕсли;
	
	ВыпускОбъект.Заполнить(ДанныеЗаполнения);
	
	//nva+++
	//Если выпуск из остатков или из материалов заказчика то надо в заказе на производства тоже поменять ТЧ
	Если ЗначениеЗаполнено(ДанныеЗаполнения.Заказ) Тогда
		ЗаказОбъект = ДанныеЗаполнения.Заказ.ПолучитьОбъект();
		Если ДанныеЗаполнения.Свойство("ВыпускИзОстатков") И ДанныеЗаполнения.ВыпускИзОстатков Тогда
			ОбщийМодульСервер.ИзменитьПолотнаВМатериалах(ЗаказОбъект, Истина, Истина);
			ЗаказОбъект.РучнаяКорректировкаМатериалов = Истина;
			Попытка
				ЗаказОбъект.Записать(РежимЗаписиДокумента.Проведение);			
			Исключение	
				//ОписаниеОшибки = ОписаниеОшибки();
				МассивСообщений = ПолучитьСообщенияПользователю(Ложь); //Истина);
				ОписаниеОшибки = "Ошибки при проведении документа: ";
				Для каждого Сообщение из МассивСообщений Цикл
					ОписаниеОшибки = ОписаниеОшибки + Символы.ПС + Сообщение.Текст; 
				КонецЦикла;
			КонецПопытки;
		КонецЕсли;
		//#13345
		Если ДанныеЗаполнения.Свойство("ВыпускИзМатериаловЗаказчика") И ДанныеЗаполнения.ВыпускИзМатериаловЗаказчика Тогда
			ОбщийМодульСервер.ИзменитьПолотнаВМатериалах(ЗаказОбъект, Истина, Ложь);
			ЗаказОбъект.РучнаяКорректировкаМатериалов = Истина;
			Попытка
				ЗаказОбъект.Записать(РежимЗаписиДокумента.Проведение);			
			Исключение	
				//ОписаниеОшибки = ОписаниеОшибки();
				МассивСообщений = ПолучитьСообщенияПользователю(Ложь); //Истина);
				ОписаниеОшибки = "Ошибки при проведении документа: ";
				Для каждого Сообщение из МассивСообщений Цикл
					ОписаниеОшибки = ОписаниеОшибки + Символы.ПС + Сообщение.Текст; 
				КонецЦикла;
			КонецПопытки;
		КонецЕсли;
	КонецЕсли;
	//nva---
	
	Если ВыпускОбъект.ПроверитьЗаполнение() Тогда		
		Попытка
			ВыпускОбъект.Записать(РежимЗаписиДокумента.Проведение);			
			Возврат ВыпускОбъект.Ссылка;
		Исключение	
			//ОписаниеОшибки = ОписаниеОшибки();
			МассивСообщений = ПолучитьСообщенияПользователю(Ложь); //Истина);
			ОписаниеОшибки = "Ошибки при проведении документа: ";
			Для каждого Сообщение из МассивСообщений Цикл
				ОписаниеОшибки = ОписаниеОшибки + Символы.ПС + Сообщение.Текст; 
			КонецЦикла;
			Возврат Документы.ВыпускПродукции.ПустаяСсылка();
		КонецПопытки;
	Иначе
		МассивСообщений = ПолучитьСообщенияПользователю(Ложь); //Истина);
		ОписаниеОшибки = "Ошибки при проверке заполнения документа: ";
		Для каждого Сообщение из МассивСообщений Цикл
			ОписаниеОшибки = ОписаниеОшибки + Символы.ПС + Сообщение.Текст; 
		КонецЦикла;	
		Возврат Документы.ВыпускПродукции.ПустаяСсылка();	
	КонецЕсли;
	
КонецФункции

Процедура ЗаполнитьСтруктуруТовараПоШтрихКоду(СтруктураТовара) Экспорт
	
	Если ЗначениеЗаполнено(СтруктураТовара.ШтрихКод) Тогда
		
		Запрос = новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Штрихкоды.Номенклатура КАК Номенклатура,
		|	Штрихкоды.Характеристика КАК ХарактеристикаНоменклатуры,
		|	Штрихкоды.Серия КАК СерияНоменклатуры,
		|	Штрихкоды.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
		|	Штрихкоды.Штрихкод КАК Штрихкод
		|ИЗ
		|	РегистрСведений.ШтрихкодыНоменклатуры КАК Штрихкоды
		|ГДЕ
		|	Штрихкоды.Штрихкод = &Штрихкод";
		Запрос.УстановитьПараметр("Штрихкод", СтруктураТовара.ШтрихКод);
		
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			ЗаполнитьЗначенияСвойств(СтруктураТовара, Выборка);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьСписокЗаказовНаПроизводствоКОтмене(МассивЗаказовПокупателей) Экспорт
	
	МассивЗаказов = Новый Массив;
	
	//найдем все ЗнП по ЗП
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ДокументЗаказ.Ссылка КАК Ссылка,
	|	ЕСТЬNULL(ЗаказыНаПроизводствоОбороты.КоличествоРасход, 0) КАК КоличествоРасход
	|ИЗ
	|	Документ.ЗаказНаПроизводство КАК ДокументЗаказ
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ЗаказыНаПроизводство.Обороты КАК ЗаказыНаПроизводствоОбороты
	|		ПО ДокументЗаказ.Ссылка = ЗаказыНаПроизводствоОбороты.ЗаказНаПроизводство
	|ГДЕ
	|	ДокументЗаказ.Проведен
	|	И НЕ ДокументЗаказ.ТекущийСтатус = ЗНАЧЕНИЕ(Справочник.СтатусыЗаказовНаПроизводство.Отменен)
	|	И ДокументЗаказ.ДокументОснование В(&МассивЗаказовПокупателей)";
	
	Запрос.УстановитьПараметр("МассивЗаказовПокупателей", МассивЗаказовПокупателей);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Выборка.КоличествоРасход = 0 Тогда
			МассивЗаказов.Добавить(Выборка.Ссылка);
		КонецЕсли;
	КонецЦикла;
	
	Возврат МассивЗаказов;
	
КонецФункции

Функция ИзменитьСтатусЗаказНаПроизводство(ЗаказНаПроизводство, УстановитьСтатус) Экспорт
	
	Если ЗаказНаПроизводство.ТекущийСтатус = УстановитьСтатус Тогда
		Возврат Истина;
	КонецЕсли;

	Попытка
		ДокОбъект = ЗаказНаПроизводство.ПолучитьОбъект();
		ДокОбъект.ТекущийСтатус = УстановитьСтатус;
		Если ДокОбъект.Проведен Тогда
			ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
		Иначе
			ДокОбъект.Записать();
		КонецЕсли;
		Возврат Истина;
	Исключение
		Возврат Ложь
	КонецПопытки;
	
КонецФункции

// процедура изменяет статусы заказов в массиве, если изменение статуса не удалось, то заказ удаляется из массива
Процедура ИзменитьСтатусЗаказовПокупателей(Форма, МассивВыполненныхЗаказов, УстановитьСтатус, ПроверятьБлокировку = Истина) Экспорт
	
	Колво = МассивВыполненныхЗаказов.Количество();
	Для Инд = 1 по Колво Цикл
		ЗаказСсылка = МассивВыполненныхЗаказов[Колво-Инд];
		Если ЗаказСсылка.ТекущийСтатус = УстановитьСтатус Тогда
			Продолжить;
		КонецЕсли;
		
		ПродолжитьИзменение = Ложь;
		
		Если ПроверятьБлокировку Тогда
			Если БлокировкаОбъекта(Форма, ЗаказСсылка, Истина) Тогда
				БлокировкаОбъекта(Форма, ЗаказСсылка, Ложь);
				ПродолжитьИзменение = Истина;
			КонецЕсли;
		Иначе
			ПродолжитьИзменение = Истина;
		КонецЕсли;
		
		Если ПродолжитьИзменение Тогда	
			ДокОбъект = ЗаказСсылка.ПолучитьОбъект();
			ДокОбъект.ТекущийСтатус = УстановитьСтатус;
			Попытка
				Если ДокОбъект.Проведен Тогда
					ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
				Иначе
					ДокОбъект.Записать();
				КонецЕсли;
			Исключение
				МассивВыполненныхЗаказов.Удалить(Колво-Инд);	
			КонецПопытки;
		Иначе
			МассивВыполненныхЗаказов.Удалить(Колво-Инд);
		КонецЕсли;	
	КонецЦикла;
	
КонецПроцедуры

