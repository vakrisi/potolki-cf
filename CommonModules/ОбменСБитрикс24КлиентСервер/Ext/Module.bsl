#Область ВыполнениеОбмена

&НаСервере
Процедура ВыполнитьСинхронизациюПоРасписанию(НастройкаСинхронизации) Экспорт
	
	ОбщегоНазначения.ПриНачалеВыполненияРегламентногоЗадания();
	
	Если НЕ ЗначениеЗаполнено(НастройкаСинхронизации) Тогда
		
		ЗаписьЖурналаРегистрации("Обмен с Битрикс 24",
			УровеньЖурналаРегистрации.Ошибка,
			НастройкаСинхронизации.Метаданные(),
			НастройкаСинхронизации,
			НСтр("ru = 'Не найдена настройка обмена'") + " " + НастройкаСинхронизации);
		
		Возврат;
		
	КонецЕсли;
	
	ВыполнитьСинхронизацию(НастройкаСинхронизации, 0);
	
КонецПроцедуры

Процедура ВыполнитьСинхронизациюПоФоновомуЗаданию(ПараметрыСинхронизации, АдресРезультата = Неопределено) Экспорт
	
	НастройкаСинхронизации  = ПараметрыСинхронизации.НастройкаСинхронизации;
	ВидСинхронизации		= ПараметрыСинхронизации.ВидСинхронизации;
	
	ВыполнитьСинхронизацию(НастройкаСинхронизации, ВидСинхронизации);
	
	#Если Сервер Тогда
	ПоместитьВоВременноеХранилище(ПолучитьСообщенияПользователю(Истина), АдресРезультата);
	#КонецЕсли	

КонецПроцедуры

Процедура ВыполнитьСинхронизацию(НастройкаСинхронизации, ВидСинхронизации) Экспорт
	
	ОбщиеНастройки = СформироватьНастройкиСинхронизации(НастройкаСинхронизации, ВидСинхронизации);
	
	Если ОбщиеНастройки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ОбщиеНастройки.ВыполненоБезОшибок = Истина;
		
	ОбщиеНастройки.Логирование.Измерение2 = "Загрузка данных с Битрикс24";
	ЗапуститьВыполнениеЗагрузки(ОбщиеНастройки);
	
	Если ОбщиеНастройки.ВыполненоБезОшибок Тогда
		
		ОбщиеНастройки.Логирование.Измерение2 = "Выгрузка данных в Битрикс24";
		ЗапуститьВыполнениеОчередиВыгрузки(ОбщиеНастройки);
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ЗагрузкаДанных

Процедура ЗапуститьВыполнениеЗагрузки(ОбщиеНастройки) Экспорт
	
	Если ОбщиеНастройки.НастройкаПодключения.СинхронизацияСделок Тогда
		ОбработатьЗагрузкуДанныхПолнойВыгрузки(ОбщиеНастройки, "Сделки");
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработатьЗагрузкуДанныхПолнойВыгрузки(ОбщиеНастройки, Операция)
	
	ОбщиеНастройки.Логирование.Измерение3 = "Полная загрузка данных с портала с типом: " + Строка(Операция);
		
	ОбщиеНастройки.Операция = Операция; 
	ЗагрузитьСПорталаИОбработать(ОбщиеНастройки);
	
	ОбщиеНастройки.Логирование.Измерение3 = "";
	
КонецПроцедуры

Процедура ЗагрузитьСПорталаИОбработать(ОбщиеНастройки, МассивЭлементов = Неопределено) Экспорт 
	
	ОбщиеНастройки.Логирование.Измерение4 = Строка(ОбщиеНастройки.Операция);
	
	Если ОбщиеНастройки.Операция = "Сделки" Тогда
		ОтборПоПараметру = "filter[>DATE_MODIFY]=" + Формат(ОбщиеНастройки.ДатаНачала_Модифицированы, "ДФ=dd.MM.yyyyTHH:mm:ss"); // Формат 2020-04-06T00:00:00
		//++ №9040 меняем метод на загрузку сделок
		//ЗагрузитьДанныеСПортала(ОбщиеНастройки, "crm.lead.list", "select[]=ID",, ОтборПоПараметру);
		ЗагрузитьДанныеСПортала(ОбщиеНастройки, "crm.deal.list", "select[]=ID",, ОтборПоПараметру);
		//-- №9040
	КонецЕсли;
	
	ОбщиеНастройки.Логирование.Измерение4 = "";
	
КонецПроцедуры

Процедура ЗагрузитьДанныеСПортала(ОбщиеНастройки, Метод, Фильтр = "" ,ОбязательныйОтбор = "", ОтборПоПараметру = "")
	
	МетодПолностью 			= "/rest/" + Метод;
	ПараметрыHTTPЗапроса 	= ?(ЗначениеЗаполнено(Фильтр), "&" + Фильтр, "" ) + ?(ЗначениеЗаполнено(ОбязательныйОтбор), "&" + ОбязательныйОтбор, "" ) + ?(ЗначениеЗаполнено(ОтборПоПараметру), "&" + ОтборПоПараметру, "");
	
	СтруктураОтвета 	 		= Неопределено;
	КоличествоВыполнений 		= 0;
	ОбщиеНастройки.Логирование.Измерение6 	= "0";
	КоличествоПовторенийПриОшибках = 0;
	
	Пока СтруктураОтвета = Неопределено И (КоличествоВыполнений < КоличествоПовторенийПриОшибках ИЛИ КоличествоВыполнений = 0) Цикл
		
		Если КоличествоВыполнений > 0 Тогда
			ОбщиеНастройки.Логирование.Измерение5 = "Повторная загрузка данных с портала с типом: " + Строка(ОбщиеНастройки.Операция);
		Иначе
			ОбщиеНастройки.Логирование.Измерение5 = "Загрузка данных с портала с типом: " + Строка(ОбщиеНастройки.Операция);
		КонецЕсли;
		
		ДобавитьВЛогИОповестить(ОбщиеНастройки, ОбщиеНастройки.ТипыСообщений.Информация, "Начало загрузки данных с портала с типом: " + Строка(ОбщиеНастройки.Операция));
		
		СтруктураОтвета = ОбменСБитрикс24ВызовСервера.ОтправкаДанныхНаПортал(ОбщиеНастройки, МетодПолностью, ПараметрыHTTPЗапроса);
		
		ДобавитьВЛогИОповестить(ОбщиеНастройки, ОбщиеНастройки.ТипыСообщений.Информация, "Завершение загрузки данных с портала с типом: " + Строка(ОбщиеНастройки.Операция));
		
		КоличествоВыполнений = КоличествоВыполнений + 1;
		
	КонецЦикла;
	
	Если СтруктураОтвета = Неопределено Тогда
		ОбщиеНастройки.ВыполненоБезОшибок = Ложь;
		Возврат;
	КонецЕсли;
	
	ОбщиеНастройки.Логирование.Измерение5 = "Обработка данных с типом: " + Строка(ОбщиеНастройки.Операция) + " в 1С";
	
	ДобавитьВЛогИОповестить(ОбщиеНастройки, ОбщиеНастройки.ТипыСообщений.Информация, "Начало обработки данных в 1С, пришедших  с портала с типом: " + Строка(ОбщиеНастройки.Операция));
	ОбработатьДанныеСПортала(ОбщиеНастройки, СтруктураОтвета);
	ДобавитьВЛогИОповестить(ОбщиеНастройки, ОбщиеНастройки.ТипыСообщений.Информация, "Завершена обработка данных в 1С, пришедших  с портала с типом: " + Строка(ОбщиеНастройки.Операция));
	
	Следующие = СтруктураОтвета.Получить("next");
	
	Пока ЗначениеЗаполнено(Следующие) Цикл
		
		Следующие = Формат(Следующие, "ЧГ=0");
		
		ОбщиеНастройки.Логирование.Измерение6 = Строка(Следующие);
		
		КоличествоВыполнений = 0;
		
		ТелоHTTPЗапроса = ПараметрыHTTPЗапроса + "&start="+Следующие;	
		
		Пока СтруктураОтвета = Неопределено И КоличествоВыполнений < ОбщиеНастройки.КоличествоПовторенийПриОшибках Цикл
			
			Если КоличествоВыполнений > 0 Тогда
				ОбщиеНастройки.Логирование.Измерение5 = "Повторная загрузка данных с портала с типом: " + Строка(ОбщиеНастройки.Операция);
			Иначе
				ОбщиеНастройки.Логирование.Измерение5 = "Загрузка данных с портала с типом: " + Строка(ОбщиеНастройки.Операция);
			КонецЕсли;
			
			ДобавитьВЛогИОповестить(ОбщиеНастройки, ОбщиеНастройки.ТипыСообщений.Информация, "Начало загрузки данных с портала с типом: " + Строка(ОбщиеНастройки.Операция));
			
			СтруктураОтвета = ОбменСБитрикс24ВызовСервера.ОтправкаДанныхНаПортал(ОбщиеНастройки, МетодПолностью, ТелоHTTPЗапроса); 
			
			ДобавитьВЛогИОповестить(ОбщиеНастройки, ОбщиеНастройки.ТипыСообщений.Информация, "Завершение загрузки данных с портала с типом: " + Строка(ОбщиеНастройки.Операция));
			
			КоличествоВыполнений = КоличествоВыполнений + 1;
			
		КонецЦикла;
		
		Если СтруктураОтвета = Неопределено Тогда
			ОбщиеНастройки.ВыполненоБезОшибок = Ложь;
			Возврат;
		КонецЕсли;
		
		ОбщиеНастройки.Логирование.Измерение5 = "Обработка данных с типом: " + Строка(ОбщиеНастройки.Операция) + " в 1С";
		
		ДобавитьВЛогИОповестить(ОбщиеНастройки, ОбщиеНастройки.ТипыСообщений.Информация, "Начало обработки данных в 1С, пришедших  с портала с типом: " + Строка(ОбщиеНастройки.Операция));
		ОбработатьДанныеСПортала(ОбщиеНастройки, СтруктураОтвета);
		ДобавитьВЛогИОповестить(ОбщиеНастройки, ОбщиеНастройки.ТипыСообщений.Информация, "Завершена обработка данных в 1С, пришедших  с портала с типом: " + Строка(ОбщиеНастройки.Операция));
		
		Следующие = СтруктураОтвета.Получить("next");
		СтруктураОтвета = Неопределено;
	КонецЦикла;
	
	ОбщиеНастройки.Логирование.Измерение5 = "";
	ОбщиеНастройки.Логирование.Измерение6 = "";
	
КонецПроцедуры

Процедура ОбработатьДанныеСПортала(ОбщиеНастройки, СтруктураОтвета, ДополнительныйКлюч = Неопределено)
	
	мДанных = Новый Массив;
	                             
	Если СтруктураОтвета = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	result = СтруктураОтвета.Получить("result");
	Если result <> Неопределено Тогда
		
		Если ТипЗнч(result)=Тип("Массив") Тогда
			мДанных = result;	
		Иначе
			
			Если ДополнительныйКлюч = Неопределено Тогда
			
				result2 = result.Получить("result");
				
				Если result2 <> Неопределено Тогда
					
					Для каждого ТекЭлемент Из result2 Цикл
						Для каждого ТекЭлемент2 Из ТекЭлемент Цикл
							мДанных.Добавить(ТекЭлемент2);
						КонецЦикла;
					КонецЦикла;
					
				КонецЕсли;
				
			Иначе                 
				
				result2 = result.Получить(ДополнительныйКлюч);
				
				Если result2 <> Неопределено Тогда
					
					Для каждого ТекЭлемент Из result2 Цикл
						мДанных.Добавить(ТекЭлемент);
					КонецЦикла;
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если мДанных.количество() > 0 Тогда
		
		Если ОбщиеНастройки.Операция = "Сделки" Тогда
			
			ПодробныеДанные = Новый Структура;
			
			//++ №9040 меняем метод на загрузку сделок, а также необходимо получить контакты
			//ПодробныеДанные.Вставить("ИнформацияОЛидах", ПолучитьПодробныеДанныеЧерезGET(ОбщиеНастройки, "crm.lead.get", мДанных));
			//РезультатОбработки = ОбменСБитрикс24ВызовСервера.ЗагрузитьОбновитьЛиды(ОбщиеНастройки, ПодробныеДанные);
			
			ПодробныеДанные.Вставить("ИнформацияОСделках", ПолучитьПодробныеДанныеЧерезGET(ОбщиеНастройки, "crm.deal.get", мДанных));
			ПодробныеДанные.Вставить("ИнформацияОКонтактах", ПолучитьИнформациюОКонтактах(ОбщиеНастройки, ПодробныеДанные.ИнформацияОСделках));
			
			РезультатОбработки = ОбменСБитрикс24ВызовСервера.ЗагрузитьОбновитьСделки(ОбщиеНастройки, ПодробныеДанные);
			//-- №9040
		
		КонецЕсли;
	
	КонецЕсли;
	
КонецПроцедуры

//++ №9040 получаем контакты по сделкам
Функция ПолучитьИнформациюОКонтактах(ОбщиеНастройки, ДанныеСделок)
	
	// Получим список ИД контактов, указанных в сделках, после получим по ИД все данные из Битрикса
	МассивИДКонтактов = новый Массив;
	Для Каждого ТекущаяСделка Из ДанныеСделок Цикл
		КонтактИД = ТекущаяСделка.Получить("CONTACT_ID");
		Если НЕ КонтактИД = Неопределено 
			И ЗначениеЗаполнено(КонтактИД) 
			И НЕ КонтактИД = "0" 
			Тогда
			СоответствиеИД = новый Соответствие;
			СоответствиеИД.Вставить("ID", КонтактИД);
			МассивИДКонтактов.Добавить(СоответствиеИД);
		КонецЕсли;		
	КонецЦикла;
	
	Возврат ПолучитьПодробныеДанныеЧерезGET(ОбщиеНастройки, "crm.contact.get", МассивИДКонтактов);
	
КонецФункции
//-- №9040

Функция ПолучитьПодробныеДанныеЧерезGET(ОбщиеНастройки, Метод, мДанных, НазваниеПараметра= "id")
	
	РезультатОбработки = Новый Массив; 
	
	ТелоHTTPЗапроса= "";
	
	Для каждого ТекЭлемент Из мДанных Цикл
		
		ИдЭлемента = Формат(ТекЭлемент.Получить("ID"), "ЧГ=0");
		ИдЭлемента = ?(ЗначениеЗаполнено(ИдЭлемента), ИдЭлемента, Формат(ТекЭлемент.Получить("id"), "ЧГ=0"));
			
		ТелоHTTPЗапроса = ТелоHTTPЗапроса + "&" + "cmd[]=" + ОбменСБитрикс24ВызовСервера.ЗакодироватьСтрокуСервер(Метод + "?"+НазваниеПараметра+"=" + ИдЭлемента);
	КонецЦикла;
	
	СтруктураОтвета = ОбменСБитрикс24ВызовСервера.ОтправкаДанныхНаПорталЧерезBatch(ОбщиеНастройки, ТелоHTTPЗапроса);
	
	Если СтруктураОтвета = Неопределено Тогда
		Возврат РезультатОбработки;
	КонецЕсли;
	
	result = СтруктураОтвета.Получить("result");
	Если result <> Неопределено Тогда
		result2 = result.Получить("result");
		Если result2 <> Неопределено Тогда
			РезультатОбработки = result2;
		КонецЕсли;
	КонецЕсли;
	
	Возврат РезультатОбработки;			
	
КонецФункции

#КонецОбласти

