Процедура ЗапуститьВыполнениеОчередиВыгрузки(ОбщиеНастройки) Экспорт
	
	//СформироватьИОтправить(ОбщиеНастройки, "Выгрузка номенклатуры");
	
	//ТипДанных = "Выгрузка заказов как счетов";
	//СформироватьИОтправить(ОбщиеНастройки, ТипДанных);
	
	//++ №14571
	Если ОбщиеНастройки.НастройкаПодключения.СинхронизацияКонтрагентов Тогда
		
		ТипДанных = "Выгрузка контрагентов";
		
		ОбщиеНастройки.Логирование.Измерение3 = "Полная выгрузка данных на портал с типом: " + ТипДанных;
		СформироватьИОтправить(ОбщиеНастройки, ТипДанных);
		
	КонецЕсли;
	
	Если ОбщиеНастройки.НастройкаПодключения.СинхронизацияКонтрагентов Тогда
		
		ТипДанных = "Выгрузка контактных лиц";
		
		ОбщиеНастройки.Логирование.Измерение3 = "Полная выгрузка данных на портал с типом: " + ТипДанных;
		СформироватьИОтправить(ОбщиеНастройки, ТипДанных);
		
	КонецЕсли;
	//-- №14571
	
	Если ОбщиеНастройки.НастройкаПодключения.СинхронизацияСделок 
		И ОбменСБитрикс24ВызовСервера.НастройкиСинхронизацииЛидов(ОбщиеНастройки.НастройкаПодключения, "ВыгружатьИнформациюПоЛидам") = Истина Тогда
		
		ТипДанных = "Информация по лидам";
		
		ОбщиеНастройки.Логирование.Измерение3 = "Полная выгрузка данных на портал с типом: " + ТипДанных;
		СформироватьИОтправить(ОбщиеНастройки, ТипДанных);
		
	КонецЕсли;
	
	ОбщиеНастройки.Логирование.Измерение3 = "";
	
КонецПроцедуры

Процедура СформироватьИОтправить(ОбщиеНастройки, ТипДанных) Экспорт
	
	ОбщиеНастройки.Логирование.Измерение4 = Строка(ТипДанных);
	
	Если ОбщиеНастройки.СтатусПроверкиОчереди = 0 Тогда
		ОбщиеНастройки.Логирование.Измерение5 = "Первая отправка данных на портал"
	ИначеЕсли ОбщиеНастройки.СтатусПроверкиОчереди = 2 Тогда
		ОбщиеНастройки.Логирование.Измерение5 = "Повторная отправка данных на портал"
	КонецЕсли;
	
	Если ОбщиеНастройки.СтатусПроверкиОчереди = 0 Тогда
		ДобавитьВЛогИОповестить(ОбщиеНастройки, ОбщиеНастройки.ТипыСообщений.Информация, "Начало выгрузки объектов с типом: " + Строка(ТипДанных));
	ИначеЕсли ОбщиеНастройки.СтатусПроверкиОчереди = 2 Тогда
		ДобавитьВЛогИОповестить(ОбщиеНастройки, ОбщиеНастройки.ТипыСообщений.Информация, "Повторная выгрузки объектов с типом: " + Строка(ТипДанных));
	КонецЕсли;
	
	ПодготовкаИВыгрузкаДанныхНаПортал(ОбщиеНастройки, ТипДанных);
	
	Если ОбщиеНастройки.СтатусПроверкиОчереди = 0 Тогда
		ДобавитьВЛогИОповестить(ОбщиеНастройки,  ОбщиеНастройки.ТипыСообщений.Информация, "Завершение выгрузки объектов с типом: " + Строка(ТипДанных));
	ИначеЕсли ОбщиеНастройки.СтатусПроверкиОчереди = 2 Тогда
		ДобавитьВЛогИОповестить(ОбщиеНастройки, ОбщиеНастройки.ТипыСообщений.Информация, "Повторная выгрузка объектов с типом: " + Строка(ТипДанных) + " завершена");
	КонецЕсли;
	
	ОбщиеНастройки.Логирование.Измерение4 = "";
	ОбщиеНастройки.Логирование.Измерение5 = "";
	ОбщиеНастройки.Логирование.Измерение6 = "";
	
КонецПроцедуры

Процедура ПодготовкаИВыгрузкаДанныхНаПортал(ОбщиеНастройки, ТипДанных)
	
	СформированныеДанные = Новый Массив;
	
	ТипОбъекта = Неопределено;
	
	Если ТипДанных = "Информация по лидам" Тогда    			
		
		ТипОбъекта = Тип("ДокументСсылка.Лид");
		СформированныеДанные =  ОбменСБитрикс24ВызовСервера.СформироватьДанныеПоЛидам(ОбщиеНастройки);
		
	ИначеЕсли ТипДанных = "Выгрузка контрагентов" Тогда    			
		
		ТипОбъекта = Тип("СправочникСсылка.Контрагенты");
		СформированныеДанные =  ОбменСБитрикс24ВызовСервера.СформироватьДанныеПоКонтрагентам(ОбщиеНастройки);
		
	ИначеЕсли ТипДанных = "Выгрузка контактных лиц" Тогда    			
		
		ТипОбъекта = Тип("СправочникСсылка.КонтактныеЛица");
		СформированныеДанные =  ОбменСБитрикс24ВызовСервера.СформироватьДанныеПоКонтактнымЛицам(ОбщиеНастройки);
		
	ИначеЕсли ТипДанных = "Выгрузка номенклатуры" Тогда	
		ТипОбъекта = Тип("СправочникСсылка.Номенклатура");
		СформированныеДанные = ОбменСБитрикс24ВызовСервера.СформироватьДанныеНоменклатуры(ОбщиеНастройки);
		
	ИначеЕсли ТипДанных = "Выгрузка заказов как счетов" Тогда
		ТипОбъекта = Тип("ДокументСсылка.ЗаказПокупателя");
		СформированныеДанные = ОбменСБитрикс24ВызовСервера.СформироватьДанныеПоЗаказамПокупателейКакПоСчетам(ОбщиеНастройки);
		
	КонецЕсли;
	
	ВыгрузкаДанныхНаПортал(ОбщиеНастройки, ТипДанных, СформированныеДанные, ТипОбъекта);
	
	ОбщиеНастройки.Логирование.Измерение6 = "";
	
КонецПроцедуры

Процедура ВыгрузкаДанныхНаПортал(ОбщиеНастройки, ТипДанных, СформированныеДанные, ТипОбъекта)
	
	Если СформированныеДанные.Количество() > 0 Тогда
		
		ТелоHTTPЗапроса= "";
		Для каждого ТекЭлемент Из СформированныеДанные Цикл
			ТелоHTTPЗапроса = ТелоHTTPЗапроса + "&" + ТекЭлемент;	
		КонецЦикла;
		
		СтруктураОтвета = ОбменСБитрикс24ВызовСервера.ОтправкаДанныхНаПорталЧерезBatch(ОбщиеНастройки, ТелоHTTPЗапроса);
		
		Если СтруктураОтвета = Неопределено Тогда
			ОбщиеНастройки.ВыполненоБезОшибок = Ложь;
			Возврат;	
		КонецЕсли;
		
		Если СтруктураОтвета.Получить("result") <> Неопределено Тогда
			
			СтруктураОтвета2 = СтруктураОтвета.Получить("result");
			
			Если СтруктураОтвета2.Получить("result") <> Неопределено Тогда
				
				Для каждого ТекСтрока Из СтруктураОтвета2.Получить("result") Цикл
					
					лОбъект = ОбменСБитрикс24ВызовСервера.ПолучитьЗначениеПоXML(ТипОбъекта, ТекСтрока.Ключ);	
					
					Если НЕ ЗначениеЗаполнено(лОбъект) Тогда
						ДобавитьВЛогИОповестить(ОбщиеНастройки,  ОбщиеНастройки.ТипыСообщений.Ошибка, "Не найден объект с ид: " + Строка(ТекСтрока.Ключ));  
						ОбщиеНастройки.ВыполненоБезОшибок = Ложь;
					Иначе
						
						Если ТипЗнч(ТекСтрока.Значение) = Тип("Булево") Тогда
							
							Если ТекСтрока.Значение Тогда
								ОбменСБитрикс24ВызовСервера.УдалитьОбъектИзОчереди(ОбщиеНастройки, лОбъект);
							КонецЕсли;
							
						Иначе 
							
							Если ОбменСБитрикс24ВызовСервера.ЗаписатьИдБ24Объекта(ОбщиеНастройки, лОбъект, ТекСтрока.Значение) Тогда
								ОбменСБитрикс24ВызовСервера.УдалитьОбъектИзОчереди(ОбщиеНастройки, лОбъект);
							КонецЕсли;
							
						КонецЕсли;
						
					КонецЕсли;
					
				КонецЦикла;
			КонецЕсли;
			
			Если СтруктураОтвета2.Получить("result_error") <> Неопределено Тогда
				
				Для каждого ТекСтрока Из СтруктураОтвета2.Получить("result_error") Цикл
					
					лОписаниеОшибки = ТекСтрока.Значение.Получить("error_description");
					
					лОбъект = ОбменСБитрикс24ВызовСервера.ПолучитьЗначениеПоXML(ТипОбъекта, ТекСтрока.Ключ);	
					
					Если НЕ ЗначениеЗаполнено(лОбъект) Тогда
						ДобавитьВЛогИОповестить(ОбщиеНастройки,  ОбщиеНастройки.ТипыСообщений.Ошибка, лОписаниеОшибки + " у не найденного объекта с ид: " + Строка(ТекСтрока.Ключ));   
					Иначе
						ДобавитьВЛогИОповестить(ОбщиеНастройки,  ОбщиеНастройки.ТипыСообщений.Ошибка, лОписаниеОшибки + " у объекта: " + Строка(лОбъект));   
						РазобратьОшибку(ОбщиеНастройки, ТипДанных, лОбъект, лОписаниеОшибки);
					КонецЕсли;	
					
					ОбщиеНастройки.ВыполненоБезОшибок = Ложь;
					
				КонецЦикла;
				
			КонецЕсли;
			
		Иначе
			
			ДобавитьВЛогИОповестить(ОбщиеНастройки,  ОбщиеНастройки.ТипыСообщений.Ошибка, "Не удалось разобрать JSON ответа");
			ДобавитьВЛогИОповестить(ОбщиеНастройки,  ОбщиеНастройки.ТипыСообщений.Ошибка, "Тело отправляемого запроса: " + ТелоHTTPЗапроса);
			
			ОбщиеНастройки.ВыполненоБезОшибок = Ложь;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура РазобратьОшибку(ОбщиеНастройки, ТипДанных, Объект, ОписаниеОшибки)
	
	НастройкаСинхронизации = ОбщиеНастройки.НастройкаПодключения;
	
	Если ОбщиеНастройки.Операция = "Сделки" Тогда
		
		Если СтрНайти(ОписаниеОшибки, "ot found") > 0 ИЛИ СтрНайти(ОписаниеОшибки, "не найден") > 0 Тогда
			ОбменСБитрикс24ВызовСервера.УдалитьОбъектИзОчереди(ОбщиеНастройки, Объект);  
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

