
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// только программное создание через настройки программы
	Если Параметры.Ключ.Пустая() Тогда
		Отказ = Истина;
	КонецЕсли;
	
	Элементы.ГруппаСтраницы.ТекущаяСтраница = ?(Объект.ЭтоБазаПроизводства, Элементы.ГруппаПроизводство, Элементы.ГруппаРозница);
	
КонецПроцедуры
