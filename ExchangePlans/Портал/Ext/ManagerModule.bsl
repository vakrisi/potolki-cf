Процедура ЗарегистрироватьНоменклатуру(Ссылка)
	
	Если Ссылка.Пустая() Тогда
		Возврат;
	КонецЕсли;
	Если Ссылка.ЭтоГруппа Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Портал.Ссылка
	|ИЗ
	|	ПланОбмена.Портал КАК Портал
	|ГДЕ
	|	НЕ Портал.ПометкаУдаления
	|	И Портал.ВыполнятьОбменНоменклатурой";
	УзлыОбмена = Запрос.Выполнить().Выбрать();
	Пока УзлыОбмена.Следующий() Цикл
		Если УзлыОбмена.Ссылка.ФильтрНоменклатура.Количество() = 0 Тогда
			ПланыОбмена.ЗарегистрироватьИзменения(УзлыОбмена.Ссылка, Ссылка);
		Иначе
			ЗапросФильтр = Новый Запрос;
			ЗапросФильтр.Текст = 
			"ВЫБРАТЬ
			|	Номенклатура.Ссылка
			|ИЗ
			|	Справочник.Номенклатура КАК Номенклатура
			|ГДЕ
			|	Номенклатура.Ссылка = &Ссылка
			|	И Номенклатура.Ссылка В ИЕРАРХИИ(&СписокНоменклатуры)";
			ЗапросФильтр.УстановитьПараметр("Ссылка", Ссылка);
			ЗапросФильтр.УстановитьПараметр("СписокНоменклатуры", УзлыОбмена.Ссылка.ФильтрНоменклатура.ВыгрузитьКолонку("Номенклатура"));
			Если ЗапросФильтр.Выполнить().Выбрать().Количество() > 0 Тогда
				ПланыОбмена.ЗарегистрироватьИзменения(УзлыОбмена.Ссылка, Ссылка);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

