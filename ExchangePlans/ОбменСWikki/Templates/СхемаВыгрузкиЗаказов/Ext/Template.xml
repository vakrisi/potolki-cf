			<dataPath>ИдентификаторКонтрагента</dataPath>
			<field>ИдентификаторКонтрагента</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Идентификатор контрагента</v8:content>
				</v8:item>
			</title>
			<useRestriction>
				<condition>true</condition>
			</useRestriction>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Проведен</dataPath>
			<field>Проведен</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>СтатусСайта</dataPath>
			<field>СтатусСайта</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Статус сайта</v8:content>
				</v8:item>
			</title>
			<useRestriction>
				<condition>true</condition>
			</useRestriction>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ПериметрПомещения</dataPath>
			<field>ПериметрПомещения</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Периметр помещения</v8:content>
				</v8:item>
			</title>
			<useRestriction>
				<condition>true</condition>
			</useRestriction>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>АдресМонтажа</dataPath>
			<field>АдресМонтажа</field>
			<useRestriction>
				<condition>true</condition>
			</useRestriction>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Организация</dataPath>
			<field>Организация</field>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ РАЗРЕШЕННЫЕ
	Заказы.Ссылка КАК ЗаказПокупателя,
	Заказы.Дата КАК Дата,
	Заказы.Проведен,
	Заказы.ТекущийСтатус КАК ТекущийСтатус,
	Заказы.Организация КАК Организация,
	Заказы.Контрагент КАК Контрагент,
	Заказы.Валюта КАК Валюта,
	Заказы.СуммаДокумента КАК СуммаДокумента,
	Заказы.Склад КАК Склад,
	ЕСТЬNULL(ИдентификаторыОбъектовWikki.Идентификатор, "") КАК ИдентификаторСайта,
	ЕСТЬNULL(ИдентификаторыКонтрагентовWikki.Идентификатор, "") КАК ИдентификаторКонтрагента,
	"         " КАК СтатусСайта,
	0 КАК ПериметрПомещения,
	Заказы.АдресМонтажа КАК АдресМонтажа
ИЗ
	Документ.ЗаказПокупателя КАК Заказы
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИдентификаторыОбъектовWikki КАК ИдентификаторыОбъектовWikki
		ПО Заказы.Ссылка = ИдентификаторыОбъектовWikki.Объект
			И (ИдентификаторыОбъектовWikki.Сайт = &amp;Сайт)
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ИдентификаторыОбъектовWikki КАК ИдентификаторыКонтрагентовWikki
		ПО Заказы.Контрагент = ИдентификаторыКонтрагентовWikki.Объект
			И (ИдентификаторыКонтрагентовWikki.Сайт = &amp;Сайт)
ГДЕ
	Заказы.Дата &gt;= &amp;ДатаНачалаВыгрузкиЗаказов
	И НЕ Заказы.ПометкаУдаления
	//И Заказы.Проведен
	</query>
	</dataSet>
	<parameter>
		<name>ДатаНачалаВыгрузкиЗаказов</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Дата начала выгрузки заказов</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>xs:dateTime</v8:Type>
			<v8:DateQualifiers>
				<v8:DateFractions>DateTime</v8:DateFractions>
			</v8:DateQualifiers>
		</valueType>
		<value xsi:type="xs:dateTime">2000-01-01T00:00:00</value>
		<useRestriction>false</useRestriction>
	</parameter>
	<parameter>
		<name>Сайт</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Сайт</v8:content>
			</v8:item>
		</title>
		<value xsi:nil="true"/>
		<useRestriction>true</useRestriction>
	</parameter>
