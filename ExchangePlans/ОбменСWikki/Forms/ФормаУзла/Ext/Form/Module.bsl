&НаКлиенте
Процедура ПроверитьСоединение(Команда)
	
	ОчиститьСообщения();
	Если Не Модифицированность И ЗначениеЗаполнено(Объект.АдресСайта) И ЗначениеЗаполнено(Объект.ТокенАвторизации) Тогда
		СтруктураПроверки = ПроверитьСоединениеНаСервере();
	Иначе
		Если Модифицированность Тогда
			ТекстВозврата = "Предварительно необходимо записать текущую настройку!";
		Иначе
			ТекстВозврата = "Необходимо заполнить настройки подключения!";	
		КонецЕсли;
	КонецЕсли;
	
	Если СтруктураПроверки.Успешно Тогда
		ПоказатьПредупреждение(Неопределено, "Соединение успешно установлено!", 10, "Результат проверки соединения");
	Иначе
		ПоказатьПредупреждение(Неопределено, СтруктураПроверки.ОписаниеОшибки, 10, "Результат проверки соединения");
	КонецЕсли;
	
	Если СтруктураПроверки.IDОрганизацииИзменен Тогда
		ПоказатьОповещениеПользователя("Заполнен ID организации");	
	КонецЕсли;
	
КонецПроцедуры  

&НаСервере
Функция ПроверитьСоединениеНаСервере()
	
	НастройкиПодключения = Новый Структура;
	НастройкиПодключения.Вставить("АдресСайта", Объект.АдресСайта);
	НастройкиПодключения.Вставить("ТокенАвторизации", Объект.ТокенАвторизации);
	
	СтруктураПроверки = Новый Структура("Успешно, IDОрганизацииИзменен, ОписаниеОшибки", Ложь, Ложь, "");
	ОписаниеОшибки = "";
	РезультатПодключения = ОбменСWikki.ВыполнитьТестовоеПодключениеКСайту(НастройкиПодключения, ОписаниеОшибки);
	
	Если ЗначениеЗаполнено(ОписаниеОшибки) Тогда
		СтруктураПроверки.ОписаниеОшибки = ОписаниеОшибки;
		Возврат СтруктураПроверки;
	КонецЕсли;
	
	Если РезультатПодключения.Результат = Ложь ИЛИ НЕ РезультатПодключения.КодОтвета = 200 Тогда
		СтруктураПроверки.ОписаниеОшибки = РезультатПодключения.ТелоОтвета;
		Возврат СтруктураПроверки;
	КонецЕсли;
	
	СтруктураПроверки.Успешно = Истина;
	//ТекстВозврата = "Соединение успешно установлено!";
	
	ТекID = "";
	Для Каждого ТекВитрина Из РезультатПодключения.Данные.stores Цикл
		Если Не ЗначениеЗаполнено(ТекID) Тогда
			ТекID = ТекВитрина.company_id;
		КонецЕсли;
		//Сообщить("По данной учетной записи числится витрина " + ТекВитрина.company + " с ID " + ТекВитрина.company_id);		
	КонецЦикла;
	
	Если НЕ Объект.IDОрганизации = ТекID И ЗначениеЗаполнено(ТекID) Тогда
		Объект.IDОрганизации = ТекID;
		СтруктураПроверки.IDОрганизацииИзменен = Истина;
		Модифицированность = Истина;
	КонецЕсли;
	
	Возврат СтруктураПроверки;
	
КонецФункции

