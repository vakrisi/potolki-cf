&НаКлиенте
Процедура СопоставлениеОплатВидОперацииНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	//СтандартнаяОбработка = Ложь;
	ТекущиеДанные = Элементы.СопоставлениеОплат.ТекущиеДанные;
	
	Если ТекущиеДанные.ТипДокумента = ПредопределенноеЗначение("Перечисление.Wikki_ТипыДокументовОплаты.ОплатаБанковскойКартой") Тогда
		Элемент.ОграничениеТипа = Новый ОписаниеТипов("ПеречислениеСсылка.ВидыОперацийОплатаБанковскойКартой");
	ИначеЕсли ТекущиеДанные.ТипДокумента = ПредопределенноеЗначение("Перечисление.Wikki_ТипыДокументовОплаты.ПриходныйКассовыйОрдер") Тогда
		Элемент.ОграничениеТипа = Новый ОписаниеТипов("ПеречислениеСсылка.ВидыОперацийПриходныйКассовыйОрдер");
	ИначеЕсли ТекущиеДанные.ТипДокумента = ПредопределенноеЗначение("Перечисление.Wikki_ТипыДокументовОплаты.РасходныйКассовыйОрдер") Тогда
		Элемент.ОграничениеТипа = Новый ОписаниеТипов("ПеречислениеСсылка.ВидыОперацийРасходныйКассовыйОрдер");
	ИначеЕсли ТекущиеДанные.ТипДокумента = ПредопределенноеЗначение("Перечисление.Wikki_ТипыДокументовОплаты.ПоступлениеНаРасчетныйСчет") Тогда
		Элемент.ОграничениеТипа = Новый ОписаниеТипов("ПеречислениеСсылка.ВидыОперацийПоступлениеНаРасчетныйСчет");
	ИначеЕсли ТекущиеДанные.ТипДокумента = ПредопределенноеЗначение("Перечисление.Wikki_ТипыДокументовОплаты.СписаниеСРасчетногоСчета") Тогда
		Элемент.ОграничениеТипа = Новый ОписаниеТипов("ПеречислениеСсылка.ВидыОперацийСписаниеСРасчетногоСчета");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СопоставлениеОплатАналитикаОплатыНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ТекущиеДанные = Элементы.СопоставлениеОплат.ТекущиеДанные;
	
	Если ТекущиеДанные.ТипДокумента = ПредопределенноеЗначение("Перечисление.Wikki_ТипыДокументовОплаты.ОплатаБанковскойКартой") Тогда
		Элемент.ОграничениеТипа = Новый ОписаниеТипов("СправочникСсылка.ЭквайринговыеТерминалы");
	ИначеЕсли ТекущиеДанные.ТипДокумента = ПредопределенноеЗначение("Перечисление.Wikki_ТипыДокументовОплаты.ПриходныйКассовыйОрдер")
		  ИЛИ ТекущиеДанные.ТипДокумента = ПредопределенноеЗначение("Перечисление.Wikki_ТипыДокументовОплаты.РасходныйКассовыйОрдер") Тогда
		Элемент.ОграничениеТипа = Новый ОписаниеТипов("СправочникСсылка.Кассы");
	ИначеЕсли ТекущиеДанные.ТипДокумента = ПредопределенноеЗначение("Перечисление.Wikki_ТипыДокументовОплаты.ПоступлениеНаРасчетныйСчет")
		  ИЛИ ТекущиеДанные.ТипДокумента = ПредопределенноеЗначение("Перечисление.Wikki_ТипыДокументовОплаты.СписаниеСРасчетногоСчета") Тогда
		Элемент.ОграничениеТипа = Новый ОписаниеТипов("СправочникСсылка.БанковскиеСчета");
	КонецЕсли;
	
КонецПроцедуры

