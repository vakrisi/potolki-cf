&НаКлиенте
Процедура ПросмотрКатегорийСайта(Команда)
	
	ОчиститьСообщения();
	Если НЕ ЗначениеЗаполнено(Объект.АдресСайта) 
		ИЛИ НЕ ЗначениеЗаполнено(Объект.ТокенАвторизации) Тогда
		Сообщить("Необходимо заполнить настройки подключения!");
		Возврат;
	КонецЕсли;
	
	СтруктураКатегорий = ЗагрузитьКатегорииССайтаНаСервере();
	Если НЕ ЗначениеЗаполнено(СтруктураКатегорий) Тогда
		Сообщить("Не удалось получить категории!");
		Возврат;	
	КонецЕсли;
	
	МассивКатегорий = СтруктураКатегорий.Получить("categories");
	МассивКатегорийОбработано = Новый Массив;
	Для каждого ОписаниеКатегории из МассивКатегорий Цикл
		СтруктураКатегории = Новый Структура;
		СтруктураКатегории.Вставить("ИДРодителя", ОписаниеКатегории.Получить("parent_id"));
		СтруктураКатегории.Вставить("ИД", ОписаниеКатегории.Получить("category_id"));
		СтруктураКатегории.Вставить("Категория", ОписаниеКатегории.Получить("category"));
		СтруктураКатегории.Вставить("Статус", ОписаниеКатегории.Получить("status"));
		СтруктураКатегории.Вставить("Позиция", ОписаниеКатегории.Получить("position"));
		
		МассивКатегорийОбработано.Добавить(СтруктураКатегории);
	КонецЦикла;
	
	ОткрытьФорму("ПланОбмена.ОбменСWikki.Форма.КатегорииСайта", Новый Структура("МассивКатегорий", МассивКатегорийОбработано), ЭтотОбъект);
	
КонецПроцедуры

&НаСервере
Функция ЗагрузитьКатегорииССайтаНаСервере()
	
	НастройкиПодключения = Новый Структура;
	НастройкиПодключения.Вставить("АдресСайта", Объект.АдресСайта);
	НастройкиПодключения.Вставить("ТокенАвторизации", Объект.ТокенАвторизации);
	
	ОписаниеОшибки = "";
	РезультатЗапроса = ОбменСWikki.ЗагрузитьКатегорииССайта(НастройкиПодключения, ОписаниеОшибки);
	
	Если РезультатЗапроса.Результат = Истина И ТипЗнч(РезультатЗапроса.Данные) = Тип("Соответствие") Тогда
		Возврат РезультатЗапроса.Данные;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

&НаКлиенте
Процедура ПросмотрСтатусовСайта(Команда)
	
	ОчиститьСообщения();
	Если НЕ ЗначениеЗаполнено(Объект.АдресСайта) 
		ИЛИ НЕ ЗначениеЗаполнено(Объект.ТокенАвторизации) Тогда
		Сообщить("Необходимо заполнить настройки подключения!");
		Возврат;
	КонецЕсли;
	
	СтруктураСтатусов = ЗагрузитьСтатусыССайтаНаСервере();
	Если НЕ ЗначениеЗаполнено(СтруктураСтатусов) Тогда
		Сообщить("Не удалось получить статусы!");
		Возврат;	
	КонецЕсли;
	
	Для каждого ОписаниеСтатуса из СтруктураСтатусов.statuses Цикл		
		Сообщить(СтрШаблон("%1 - %2", ОписаниеСтатуса.status, ОписаниеСтатуса.description));
	КонецЦикла;
	 
КонецПроцедуры

