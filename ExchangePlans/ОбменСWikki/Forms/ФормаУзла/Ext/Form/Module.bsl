&НаСервере
Процедура УстановитьУсловноеОформлениеФормы()
	
	УсловноеОформление.Элементы.Очистить();
		
	//
	Элемент = УсловноеОформление.Элементы.Добавить();
			
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных("СопоставлениеОплатВидОперации");
			
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.СопоставлениеОплат.ТипДокумента");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено;
	
	Элемент.Оформление.УстановитьЗначениеПараметра("Доступность", Ложь);
	
	//
	Элемент = УсловноеОформление.Элементы.Добавить();
			
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных("СопоставлениеОплатВидОперации");
			
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.СопоставлениеОплат.ТипДокумента");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено;
	
	Элемент.Оформление.УстановитьЗначениеПараметра("Доступность", Ложь);

КонецПроцедуры

&НаСервере
Процедура ВыполнитьДействияПриСозданииНаСервере()
		
	Элементы.ПодразделениеЗаказа.Видимость = ПолучитьФункциональнуюОпцию("ИспользоватьПодразделения");
	Элементы.ПодразделениеОплаты.Видимость = ПолучитьФункциональнуюОпцию("ИспользоватьПодразделения");
	
	НастройкиКомпоновки = РеквизитФормыВЗначение("Объект").СохраненныйОтборТоваров.Получить();
	// отбор товаров
	ИнициализироватьКомпоновкуДанныхТоваров(НастройкиКомпоновки);
	
	НастройкиКомпоновки = РеквизитФормыВЗначение("Объект").СохраненныйОтборБезлимитныхТоваров.Получить();
	// отбор безлимитных товаров
	ИнициализироватьКомпоновкуДанныхБезлимитныхТоваров(НастройкиКомпоновки);
	
	НастройкиКомпоновки = РеквизитФормыВЗначение("Объект").СохраненныйОтборЗаказов.Получить();
	// отбор заказов
	ИнициализироватьКомпоновкуДанныхЗаказов(НастройкиКомпоновки);
	
	НастройкиКомпоновки = РеквизитФормыВЗначение("Объект").СохраненныйОтборОплат.Получить();
	// отбор оплат
	ИнициализироватьКомпоновкуДанныхОплат(НастройкиКомпоновки);
		
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьРасписаниеЗадания(РежимОбмена, ТекущийОбъект, РасписаниеРЗ)
	
	Задание = ТекущийОбъект.СуществующееЗадание(РежимОбмена);
	
	Если Не Задание = Неопределено Тогда
		
		Если ТипЗнч(Задание.Расписание) = Тип("РасписаниеРегламентногоЗадания") Тогда
			РасписаниеРЗ = Задание.Расписание;
		ИначеЕсли ТипЗнч(Задание.Расписание) = Тип("ХранилищеЗначения") Тогда
			РасписаниеРЗ = Задание.Расписание.Получить();
		Иначе
			РасписаниеРЗ = Неопределено;
		КонецЕсли;
	КонецЕсли;
		
КонецПроцедуры

