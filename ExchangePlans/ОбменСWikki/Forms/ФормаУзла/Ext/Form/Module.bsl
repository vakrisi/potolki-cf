&НаКлиенте
Процедура НастроитьРасписание(ИмяРеквизитаРасписание, Элемент)

	ВыполнитьНастройкуРасписания(ИмяРеквизитаРасписание, Элемент);
	Элемент.Заголовок = УстановитьНадписьРасписания(ЭтотОбъект[ИмяРеквизитаРасписание]);
	Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Функция УстановитьНадписьРасписания(Расписание)
	
	Если Расписание = Неопределено Тогда
		ТекстЗаголовка = НСтр("ru='Настроить расписание обмена'");
	Иначе
		ТекстЗаголовка = Расписание;
	КонецЕсли;
	
	Возврат ТекстЗаголовка;
	
КонецФункции

&НаКлиенте
Процедура ВыполнитьНастройкуРасписания(ИмяРеквизитаРасписание, Элемент)
	
	РасписаниеЗадания = ЭтотОбъект[ИмяРеквизитаРасписание];
	
	Если РасписаниеЗадания = Неопределено Тогда
		РасписаниеЗадания = Новый РасписаниеРегламентногоЗадания;
	КонецЕсли;
	
	Диалог = Новый ДиалогРасписанияРегламентногоЗадания(РасписаниеЗадания);
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ВыполнитьНастройкуРасписанияЗавершение", ЭтотОбъект, Новый Структура("ЭлементФормы, ИмяРеквизитаРасписание", Элемент, ИмяРеквизитаРасписание));
	Диалог.Показать(ОписаниеОповещения);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьНастройкуРасписанияЗавершение(Расписание, ДополнительныеПараметры) Экспорт
	
	Если Расписание = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЭтотОбъект[ДополнительныеПараметры.ИмяРеквизитаРасписание] = Расписание;		
	ДополнительныеПараметры.ЭлементФормы.Заголовок = УстановитьНадписьРасписания(Расписание);
		
КонецПроцедуры

&НаКлиенте
Процедура ПриИзмененииИспользоватьРегламентныеЗадания(ИмяРеквизитаУзлаИспользоватьРегламентноеЗадание, ИмяРеквизитаРасписание, ЭлементНастроитьРасписаниеОбмена)
	
	ЭлементНастроитьРасписаниеОбмена.Доступность = Объект[ИмяРеквизитаУзлаИспользоватьРегламентноеЗадание];
	
	Если Объект[ИмяРеквизитаУзлаИспользоватьРегламентноеЗадание] Тогда	
		ВыполнитьНастройкуРасписания(ИмяРеквизитаРасписание, ЭлементНастроитьРасписаниеОбмена);
		
		ЭлементНастроитьРасписаниеОбмена.Заголовок = УстановитьНадписьРасписания(ЭтотОбъект[ИмяРеквизитаРасписание]);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти