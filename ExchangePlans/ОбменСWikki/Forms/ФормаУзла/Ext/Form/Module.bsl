&НаСервере
Процедура ЗаполнитьСопоставлениеСтатусовПоУмолчаниюНаСервере()
	
	СписокСтатусов = Справочники.СтатусыЗаказовПокупателей.СписокСтатусов();
	Для Каждого Статус1С из СписокСтатусов Цикл
		НоваяСтрока = Объект.СопоставлениеСтатусовЗаказов.Добавить();
		НоваяСтрока.Статус1С = Статус1С.Значение;
		
		Если НоваяСтрока.Статус1С = Справочники.СтатусыЗаказовПокупателей.Новый
			ИЛИ НоваяСтрока.Статус1С = Справочники.СтатусыЗаказовПокупателей.ВРаботе Тогда
			НоваяСтрока.ИспользуетсяПриВыгрузке = Истина;
		КонецЕсли;
		
		Если НоваяСтрока.Статус1С = Справочники.СтатусыЗаказовПокупателей.Новый Тогда
			НоваяСтрока.СимвольноеОбозначение = "O"; // латинская
		ИначеЕсли НоваяСтрока.Статус1С = Справочники.СтатусыЗаказовПокупателей.ВРаботе Тогда
			НоваяСтрока.СимвольноеОбозначение = "A";
		//ИначеЕсли НоваяСтрока.Статус1С = Справочники.СтатусыЗаказовПокупателей. Тогда
		//	НоваяСтрока.СимвольноеОбозначение = "B";
		ИначеЕсли НоваяСтрока.Статус1С = Справочники.СтатусыЗаказовПокупателей.Выполнен Тогда
			НоваяСтрока.СимвольноеОбозначение = "C";
		ИначеЕсли НоваяСтрока.Статус1С = Справочники.СтатусыЗаказовПокупателей.Выполнен Тогда
			НоваяСтрока.СимвольноеОбозначение = "C";
		ИначеЕсли НоваяСтрока.Статус1С = Справочники.СтатусыЗаказовПокупателей.Отменен Тогда
			НоваяСтрока.СимвольноеОбозначение = "F";
		КонецЕсли;		
	КонецЦикла;
	
КонецПроцедуры

