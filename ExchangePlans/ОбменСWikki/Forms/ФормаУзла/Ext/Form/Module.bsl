
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	УстановитьУсловноеОформлениеФормы();
	
	УзелОбменаЭтаИБ = ПроверитьУзелОбменаЭтаИБСервер();
	
	Если УзелОбменаЭтаИБ Тогда
		Возврат;
	КонецЕсли;
	
	//РазделениеВключено = Ложь;
	
	ВыполнитьДействияПриСозданииНаСервере();
	
	УстановитьВидимостьИДоступностьЭлементов();
		
	Элементы.СопоставлениеОплатТипОплаты.СписокВыбора.Очистить();
	Элементы.СопоставлениеОплатТипОплаты.СписокВыбора.Добавить("card");
	Элементы.СопоставлениеОплатТипОплаты.СписокВыбора.Добавить("QR");
	Элементы.СопоставлениеОплатТипОплаты.СписокВыбора.Добавить("QR_PM");
	Элементы.СопоставлениеОплатТипОплаты.СписокВыбора.Добавить("Оплатить через СБП");
	Элементы.СопоставлениеОплатТипОплаты.СписокВыбора.Добавить("cash");
	
	Элементы.СопоставлениеОплатПризнакОтменыОплаты.СписокВыбора.Очистить();
	Элементы.СопоставлениеОплатПризнакОтменыОплаты.СписокВыбора.Добавить("n");  // проведен / оплата
	Элементы.СопоставлениеОплатПризнакОтменыОплаты.СписокВыбора.Добавить("y");  // проведен / возврат
	Элементы.СопоставлениеОплатПризнакОтменыОплаты.СписокВыбора.Добавить("d");  // не проведен
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	ЗаполнитьРасписаниеЗадания("ОбменТоварами", ТекущийОбъект, РасписаниеРегламентногоЗаданияОбменаТоварами);
	ЗаполнитьРасписаниеЗадания("ОбменЗаказами", ТекущийОбъект, РасписаниеРегламентногоЗаданияОбменаЗаказами);
	ЗаполнитьРасписаниеЗадания("ОбменОплатами", ТекущийОбъект, РасписаниеРегламентногоЗаданияОбменаОплатами);
		
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	Если УзелОбменаЭтаИБ Тогда
		
		ОчиститьСообщения();
		
		ОбщегоНазначенияКлиент.СообщитьПользователю(
			НСтр("ru = 'Узел соответствует этой информационной базе и не может использоваться в обмене. Используйте другой узел обмена или создайте новый.'"));
			
		Отказ = Истина;
		Возврат;
		
	КонецЕсли;
	
	Элементы.НастроитьРасписаниеОбменаТоварами.Заголовок = УстановитьНадписьРасписания(РасписаниеРегламентногоЗаданияОбменаТоварами);
	Элементы.НастроитьРасписаниеОбменаЗаказами.Заголовок = УстановитьНадписьРасписания(РасписаниеРегламентногоЗаданияОбменаЗаказами);
	Элементы.НастроитьРасписаниеОбменаОплатами.Заголовок = УстановитьНадписьРасписания(РасписаниеРегламентногоЗаданияОбменаОплатами);

КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	//Обмен по расписанию
	Если ТекущийОбъект.ИспользоватьРегламентноеЗаданиеОбменаТоварами
		И (РасписаниеРегламентногоЗаданияОбменаТоварами = Неопределено
			ИЛИ НЕ ТекущийОбъект.ОбменТоварами)
		Тогда		
		ТекущийОбъект.ИспользоватьРегламентноеЗаданиеОбменаТоварами = Ложь;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);	
	ТекущийОбъект.ВключитьОтключитьРегламентноеЗадание("ОбменТоварами", РасписаниеРегламентногоЗаданияОбменаТоварами);	
	УстановитьПривилегированныйРежим(Ложь);
	
	Если ТекущийОбъект.ИспользоватьРегламентноеЗаданиеОбменаЗаказами
		И (РасписаниеРегламентногоЗаданияОбменаЗаказами = Неопределено
			ИЛИ НЕ ТекущийОбъект.ОбменЗаказами)
		Тогда		
		ТекущийОбъект.ИспользоватьРегламентноеЗаданиеОбменаЗаказами = Ложь;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);	
	ТекущийОбъект.ВключитьОтключитьРегламентноеЗадание("ОбменЗаказами", РасписаниеРегламентногоЗаданияОбменаЗаказами);	
	УстановитьПривилегированныйРежим(Ложь);
	
	Если ТекущийОбъект.ИспользоватьРегламентноеЗаданиеОбменаОплатами
		И (РасписаниеРегламентногоЗаданияОбменаОплатами = Неопределено
			ИЛИ НЕ ТекущийОбъект.ОбменОплатами)
		Тогда		
		ТекущийОбъект.ИспользоватьРегламентноеЗаданиеОбменаОплатами = Ложь;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);	
	ТекущийОбъект.ВключитьОтключитьРегламентноеЗадание("ОбменОплатами", РасписаниеРегламентногоЗаданияОбменаОплатами);	
	УстановитьПривилегированныйРежим(Ложь);
	
	// отборы
	ТекущийОбъект.СохраненныйОтборТоваров = Новый ХранилищеЗначения(ОтборТоваров.ПолучитьНастройки());
	ТекущийОбъект.СохраненныйОтборБезлимитныхТоваров = Новый ХранилищеЗначения(ОтборБезлимитныхТоваров.ПолучитьНастройки());
	
	ТекущийОбъект.СохраненныйОтборЗаказов = Новый ХранилищеЗначения(ОтборЗаказов.ПолучитьНастройки());
	
	ТекущийОбъект.СохраненныйОтборОплат = Новый ХранилищеЗначения(ОтборОплат.ПолучитьНастройки());
	
КонецПроцедуры

