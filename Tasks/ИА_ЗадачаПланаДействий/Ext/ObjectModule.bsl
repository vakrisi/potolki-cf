
Процедура ПередЗаписью(Отказ)
	
	если ОбменДанными.Загрузка Тогда
		возврат;
	КонецЕсли;
	
	Если Приоритет.Пустая() и не ЭтоПослание Тогда
		Приоритет = Перечисления.КСУ_ПриоритетЗадачи.Средний;
	КонецЕсли;
		
	Если Автор.Пустая() тогда
		Автор = ПараметрыСеанса.ТекущийПользователь;
	КонецЕсли;
	
	Взаимодействия1с = Константы.КСУ_КЦ_ИспользоватьВзаимодействия1С.Получить();
	
	ТекстКомм = "";
	Если ЭтоПослание и ЭтоНовый() Тогда
		ТекстКомм = "Послание отправлено";
	ИначеЕсли ЭтоНовый() и не ЭтотОбъект.Отправлена Тогда
		ТекстКомм = "Черновик записан";
	ИначеЕсли ЭтотОбъект.Отправлена и не Ссылка.Отправлена Тогда
		Если ЭтоЗРС Тогда
			ТекстКомм = "ЗРС отправлена";
		Иначе
			ТекстКомм = "Задача отправлена";
		КонецЕсли;
	КонецЕсли;
	
	Если ТекстКомм <> "" Тогда
		Если ЭтоНовый() Тогда
			уид = новый УникальныйИдентификатор;
			сс = Задачи.ИА_ЗадачаПланаДействий.ПолучитьСсылку(уид);
			УстановитьСсылкуНового(сс);
		КонецЕсли;
		ДобавитьКоммент(Взаимодействия1с, ЭтотОбъект, ТекстКомм);
	КонецЕсли;
	
	// установка пометки удаления
	Если ПометкаУдаления и не Ссылка.ПометкаУдаления Тогда
		ТекЮзер = ПараметрыСеанса.ТекущийПользователь;
		Если ТекЮзер <> Автор Тогда
			Сообщить("Удалять задачи может только автор!");
			Отказ = Истина;
			Возврат;
		КонецЕсли;
				
		ДобавитьКоммент(Взаимодействия1с, ЭтотОбъект, "Задача удалена");

		Пост = Справочники.ОргСхема.ПустаяСсылка();
		Пользователь = Автор;
		
		Выполнена = истина;
	КонецЕсли;
	
	// снятие пометки удаления
	Если (не ПометкаУдаления) и Ссылка.ПометкаУдаления Тогда
		ТекЮзер = ПараметрыСеанса.ТекущийПользователь;
		Если ТекЮзер <> Автор Тогда
			Сообщить("Отменять удаление задачи может только автор!");
			Отказ = Истина;
			Возврат;
		КонецЕсли;
		
		ДобавитьКоммент(Взаимодействия1с, ЭтотОбъект, "Задача восстановлена");
		
		Выполнена = ложь;
	КонецЕсли;
	
	Если ПостАвтора.Пустая() Тогда
		ПостАвтора = ИА_ОбщиеПроцедуры_Технология_КоммЦентр.ПолучитьВысокийПостПользователя(Автор);
	КонецЕсли;
		
	// папки
	Если Выполнена Тогда
		// очистим все группы
		Набор = РегистрыСведений.ИА_ГруппыКЦ.СоздатьНаборЗаписей();
		Набор.Отбор.Задача.Установить(Ссылка);
		Набор.Записать(истина);
		
		// очистим все новые задачи
		Набор = РегистрыСведений.ИА_НовыеЗадачи.СоздатьНаборЗаписей();
		Набор.Отбор.Задача.Установить(Ссылка);
		Набор.Записать(истина);
	ИначеЕсли  (не ссылка.Пустая() и не Пользователь.Пустая() И (Пользователь <> Ссылка.Пользователь ИЛИ Пост <> Ссылка.Пост ИЛИ Отложена <> Ссылка.Отложена)) Тогда
		// очистим папки у нового адресата или при перемещении "В работе"
		Набор = РегистрыСведений.ИА_ГруппыКЦ.СоздатьНаборЗаписей();
		Набор.Отбор.Задача.Установить(Ссылка);
		Набор.Отбор.Пользователь.Установить(Пользователь);
		Набор.Записать(истина);
	КонецЕсли;
КонецПроцедуры

Функция ПечатьЗадачи() Экспорт
	
	Взаимодействия1с = Константы.КСУ_КЦ_ИспользоватьВзаимодействия1С.Получить();
	ТабДок = Новый ТабличныйДокумент;
	
	Макет = ПолучитьМакет("Макет");
	облшапка = Макет.ПолучитьОбласть("Шапка");
	облшапка.Параметры.Заполнить(ЭтотОбъект);
	ТабДок.Вывести(облшапка);
	
	облЗадачи = Макет.ПолучитьОбласть("Задача");
	облЗадачи.Параметры.Содержание = ?(СодержаниеТекст="", Содержание, СодержаниеТекст);
	ТабДок.Вывести(облЗадачи);
	
	облшапка2 = Макет.ПолучитьОбласть("Шапка2");
	облшапка2.Параметры.Заполнить(ЭтотОбъект);
	ТабДок.Вывести(облшапка2);
	
	Если Взаимодействия1с Тогда
		ход = ИА_ОбщиеПроцедуры_Технология_КоммЦентр.ПолучитьТЗСообщенийОбсужденийзадачи(Ссылка); 
	Иначе
		ход = ХодВыполнения;
	КонецЕсли;
	
	Для каждого стр из ход Цикл
		облСтрока = Макет.ПолучитьОбласть("Строка");
		облСтрока.Параметры.Заполнить(стр);
		ТабДок.Вывести(облСтрока);
	КонецЦикла;
	
	ТабДок.МасштабПечати = 155;
	ТабДок.ОтображатьЗаголовки = Ложь;
	ТабДок.ОтображатьСетку = Ложь;
	Возврат ТабДок;
	
КонецФункции

Функция ПечатьЗРС() Экспорт
	
	Взаимодействия1с = Константы.КСУ_КЦ_ИспользоватьВзаимодействия1С.Получить();
	ТабДок = Новый ТабличныйДокумент;
	
	Макет = ПолучитьМакет("МакетЗРС");
	
	ОблШапка = Макет.ПолучитьОбласть("Шапка");
	ОблШапка.Параметры.Заполнить(ЭтотОбъект);
	
	ТабДок.Вывести(ОблШапка);
	
	ТекущийПост         = ЭтотОбъект.Пост;
	ТекущийИсполнитель  = ЭтотОбъект.Исполнитель;
	ТекущийПользователь = ЭтотОбъект.Пользователь;
	// анализ комлиний
	Если Маршрут.Количество()=0 Тогда
		// без комлиний
		
		ОблКому = Макет.ПолучитьОбласть("Кому");
		
		Если  ИсполнительЗРС.Пустая() и Исполнитель.Пустая() Тогда
			Если не пост.Пустая() Тогда
				ОблКому.Параметры.Кому = Пост;
			Иначе
				ОблКому.Параметры.Кому = Пользователь;
			КонецЕсли;
		ИначеЕсли не ИсполнительЗРС.Пустая() Тогда
			ОблКому.Параметры.Кому = ИсполнительЗРС;
		Иначе
			ОблКому.Параметры.Кому = Исполнитель;
		КонецЕсли;
		
		ТабДок.Вывести(ОблКому);
	Иначе	
		Для Н = 2 По Маршрут.Количество() Цикл
			
			Если Н = Маршрут.Количество() Тогда
				Обл = Макет.ПолучитьОбласть("Кому");
				Обл.Параметры.Кому = Маршрут[Н-1].Пост;
			Иначе
				Обл = Макет.ПолучитьОбласть("ЧерезКого");
				Обл.Параметры.Пост = Маршрут[Н-1].Пост;
			КонецЕсли;
			
			ТабДок.Вывести(Обл);
		КонецЦикла;
	КонецЕсли;
	
	СитуацияТекст1 = ?(СитуацияТекст="", Ситуация, СитуацияТекст); 	
	ДанныеТекст1 = ?(ДанныеТекст="", Данные, ДанныеТекст); 	
	РешениеТекст1 = ?(СодержаниеТекст="", Содержание, СодержаниеТекст); 	
	
	ВывестиБлок("Ситуация",Макет,ТабДок,СитуацияТекст1);
	ВывестиБлок("Данные",Макет,ТабДок,ДанныеТекст1);
	ВывестиБлок("Решение",Макет,ТабДок,РешениеТекст1);
	
	облПодвал = Макет.ПолучитьОбласть("Подвал");
	облПодвал.Параметры.Заполнить(ЭтотОбъект);
	ТабДок.Вывести(облПодвал);
	
	
	Если Маршрут.Количество()>0 Тогда
		Для Н = 2 По Маршрут.Количество() Цикл
			ОблПодписи = Макет.ПолучитьОбласть("Подписи");
			ОблПодписи.Параметры.Пост = Маршрут[Н-1].Пост;
			
			Если Маршрут[Н-1].ВсеВерно Тогда
				ОблПодписи.Параметры.ПодписантОдобрено = Маршрут[Н-1].Пользователь;
			КонецЕсли;
			ТабДок.Вывести(ОблПодписи);
		КонецЦикла;
	Иначе
		ОблПодписи = Макет.ПолучитьОбласть("Подписи");
		ОблПодписи.Параметры.Пост = ""+Пост+" "+Исполнитель;
		
		Если ОтклонениеЗРС Тогда
			ОблПодписи.Параметры.ПодписантНеОдобрено = ИсполнительОтказЗРС;
		ИначеЕсли не Исполнитель.Пустая() Тогда
			ОблПодписи.Параметры.ПодписантОдобрено = Исполнитель;
		КонецЕсли;
		
			
		ТабДок.Вывести(ОблПодписи);
	КонецЕсли;
	
	ТабДок.АвтоМасштаб = Истина;
	ТабДок.ОтображатьЗаголовки = Ложь;
	ТабДок.ОтображатьСетку = Ложь;
	Возврат ТабДок;
	
КонецФункции

Функция ПечатьПослания() Экспорт
	
	Взаимодействия1с = Константы.КСУ_КЦ_ИспользоватьВзаимодействия1С.Получить();
	ТабДок = Новый ТабличныйДокумент;
	
	Макет = ПолучитьМакет("МакетПослания");
	
	ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
	ОбластьШапка.Параметры.Заполнить(ЭтотОбъект);
	ТабДок.Вывести(ОбластьШапка);
	
	ТекущийПользователь = ЭтотОбъект.Пользователь;
	ОбластьКому = Макет.ПолучитьОбласть("Кому");
	ОбластьКому.Параметры.Пользователь = ТекущийПользователь;
	ТабДок.Вывести(ОбластьКому);
	
	
	
	ОбластьПослание = Макет.ПолучитьОбласть("Послание");
	ОбластьПослание.Параметры.Содержание = ?(СодержаниеТекст="", Содержание, СодержаниеТекст);
	ТабДок.Вывести(ОбластьПослание);
	
	ОбластьПодвал = Макет.ПолучитьОбласть("Подвал");
	ОбластьПодвал.Параметры.Заполнить(ЭтотОбъект);
	ТабДок.Вывести(ОбластьПодвал);
	
	ТабДок.АвтоМасштаб = Истина;
	ТабДок.ОтображатьЗаголовки = Ложь;
	ТабДок.ОтображатьСетку = Ложь;
	Возврат ТабДок;
	
КонецФункции

Процедура ВывестиБлок(ИмяБлока,Макет,ТабДокумент,ТекстБлока)
	Область = Макет.ПолучитьОбласть("Шапка" + ИмяБлока);
	ТабДокумент.Вывести(Область);
	
	Область = Макет.ПолучитьОбласть("Строка" + ИмяБлока);
	Область.Параметры[ИмяБлока] = ТекстБлока;
	Если ТабДокумент.ПроверитьВывод(Область) Тогда 
		ТабДокумент.Вывести(Область);
	Иначе
		МассивСлов = ВернутьМассивСлов(ТекстБлока);
		ПоэтапныйВыводСлов(ТабДокумент,Макет,Область,МассивСлов,ИмяБлока,"Строка" + ИмяБлока);
	КонецЕсли;
КонецПроцедуры

Функция ВернутьМассивСлов(ИсходныйТекст)
	КолВо = СтрДлина(ИсходныйТекст);
	Слово = "";
	МассивСлов = Новый Массив;
	Для Сч = 1 По КолВо Цикл
		Буква = Сред(ИсходныйТекст,Сч,1);
		Если ЗначениеЗаполнено(Буква) Тогда 
			Слово = Слово + Буква;
		Иначе
			Если Слово <> "" Тогда
				МассивСлов.Добавить(Слово);
				Слово = "";
				МассивСлов.Добавить(Буква);//Добавляем пустые символы как отдельные слова
			Иначе
				МассивСлов.Добавить(Буква);//Добавляем пустые символы как отдельные слова
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Если Слово <> "" Тогда
		МассивСлов.Добавить(Слово);
	КонецЕсли;
	Возврат МассивСлов;
КонецФункции

Процедура ПоэтапныйВыводСлов(ТабДокумент,Макет,Область,МассивСлов,ИмяБлока,ИмяОбластиСтроки)
	ВремТекст = "";
	Для Каждого Эл Из МассивСлов Цикл
		Область.Параметры[ИмяБлока] = ВремТекст + Эл;
		Если НЕ ТабДокумент.ПроверитьВывод(Область) Тогда
			Область.Параметры[ИмяБлока] = ВремТекст;
			ТабДокумент.Вывести(Область);
			ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
			Область = Макет.ПолучитьОбласть(ИмяОбластиСтроки);
			ВремТекст = Эл;
		Иначе
			ВремТекст = ВремТекст + Эл;
		КонецЕсли;
	КонецЦикла;
	Область.Параметры[ИмяБлока] = ВремТекст;
	ТабДокумент.Вывести(Область);
КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	
	если ОбменДанными.Загрузка Тогда
		возврат;
	КонецЕсли;
	
	Если Пользователь.Пустая() Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		|	ИА_АдресацияЗадачПланаДействий.Пользователь
		|ИЗ
		|	РегистрСведений.ИА_АдресацияЗадачПланаДействий КАК ИА_АдресацияЗадачПланаДействий
		|ГДЕ
		|	ИА_АдресацияЗадачПланаДействий.Пост = &Пост
		|	И ИА_АдресацияЗадачПланаДействий.Пользователь <> ЗНАЧЕНИЕ(Справочник.Пользователи.ПустаяСсылка)";
		Запрос.УстановитьПараметр("Пост", Пост);
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			ИА_ОбщиеПроцедуры_Технология_КоммЦентр_Сервер.ОбновитьДанныеКорзины("Входящие",,Выборка.Пользователь);
		КонецЦикла;
	Иначе
		ИА_ОбщиеПроцедуры_Технология_КоммЦентр_Сервер.ОбновитьДанныеКорзины("Входящие",,Пользователь);
	КонецЕсли;
	
	набор = РегистрыСведений.КСУ_СвязьЗадач.СоздатьНаборЗаписей();
	набор.Отбор.Задача1.Установить(Ссылка);
	набор.Очистить();
	Новстр = набор.Добавить();
	ЗаполнитьЗначенияСвойств(Новстр, ЭтотОбъект);
	Новстр.Задача1 = Ссылка;
	Новстр.Задача2 = Ссылка;
	
	Если ТипЗнч(Основание) = тип("ЗадачаСсылка.ИА_ЗадачаПланаДействий") И (не Основание.Пустая()) и Основание<>Ссылка ТОгда
		Новстр = набор.Добавить();
		ЗаполнитьЗначенияСвойств(Новстр, ЭтотОбъект);
		Новстр.Задача1 = Ссылка;
		Новстр.Задача2 = Основание;
	КонецЕсли;
	
	набор.Записать(истина);
КонецПроцедуры

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("Структура") Тогда		
		Основание = ДанныеЗаполнения.Задача;                        
		
		ЗаполнитьЗначенияСвойств(ЭтотОбъект, ДанныеЗаполнения.Задача, "Наименование,Содержание,Ситуация,Данные,ПрикрепленныйОбъект");
		Если ДанныеЗаполнения.вид = "ЗРС" Тогда
			ЭтоЗРС = истина;
		ИначеЕсли ДанныеЗаполнения.вид = "ПОСЛАНИЕ" Тогда
			ЭтоПослание = истина;
			Если Основание.ЭтоЗРС Тогда
				Содержание = "ЗРС-основание:"+Символы.ПС + "Ситуация: "+ Основание.Ситуация  +Символы.ПС + "Данные: " + Основание.Данные +Символы.ПС + "Решение: " + Основание.Содержание; 
			КонецЕсли;
		ИначеЕсли ДанныеЗаполнения.вид = "ЗАДАЧА" Тогда
			Если Основание.ЭтоЗРС Тогда
				Содержание = "ЗРС-основание:"+Символы.ПС + "Ситуация: "+ Основание.Ситуация  +Символы.ПС + "Данные: " + Основание.Данные +Символы.ПС + "Решение: " + Основание.Содержание; 
			КонецЕсли;
		КонецЕсли;	
	КонецЕсли;

КонецПроцедуры

Процедура ДобавитьКоммент(Взаимодействия1с, Объект, Комментарий, получатель = Неопределено) Экспорт
	Если Взаимодействия1с Тогда
		ссылка1 = объект.ссылка;
		Если ссылка1.пустая() тогда
			ссылка1 = Объект.получитьссылкунового();
		КонецЕсли;
		ИА_ОбщиеПроцедуры_Технология_КоммЦентр.ДобавитьЗаписьВЗадачу(ссылка1,Комментарий,получатель);
	Иначе
		Новстр = Объект.ХодВыполнения.Вставить(0);
		Новстр.Дата = ТекущаяДата();
		Новстр.Комментарий = Комментарий;
		Новстр.Пользователь = ПараметрыСеанса.ТекущийПользователь;
	КонецЕсли;
КонецПроцедуры
