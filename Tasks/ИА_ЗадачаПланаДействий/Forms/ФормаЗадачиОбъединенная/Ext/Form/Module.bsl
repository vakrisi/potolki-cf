	Если ЭтоЗРС Тогда
		ФормаСправки = ПолучитьФорму("Задача.ИА_ЗадачаПланаДействий.Форма.ФормаСправки", Новый Структура("ТипСправки","СправкаЗРС"));
	ИначеЕсли ЭтоЗадача Тогда
		ФормаСправки = ПолучитьФорму("Задача.ИА_ЗадачаПланаДействий.Форма.ФормаСправки", Новый Структура("ТипСправки","СправкаЗадачи"));
	Иначе
		ФормаСправки = ПолучитьФорму("Задача.ИА_ЗадачаПланаДействий.Форма.ФормаСправки", Новый Структура("ТипСправки","СправкаПослания"));
	КонецЕсли;
	
	ФормаСправки.Открыть();
	
