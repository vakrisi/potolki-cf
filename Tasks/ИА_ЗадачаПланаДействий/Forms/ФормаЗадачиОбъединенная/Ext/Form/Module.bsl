&НаКлиенте
Процедура ПрикрепленныйФайлНажатие(Элемент)
	Если Объект.Ссылка.Пустая() Тогда
		Записать();
	
		Если Объект.Номер = "" тогда
			возврат;
		КонецЕсли;

	КонецЕсли;
	
	СтрПарам = Новый Структура;
	СтрПарам.Вставить("Номер",Объект.Номер);
	
	МассисФайлов = Новый Массив;
	Для каждого стр из Объект.Файлы Цикл
		Струк = Новый Структура();
		Струк.Вставить("Дата", Стр.Дата);
		Струк.Вставить("Имя", Стр.Имя);
		МассисФайлов.Добавить(Струк);
	КонецЦикла;
	СтрПарам.Вставить("Файлы",МассисФайлов);
	
	Оповещение  = Новый ОписаниеОповещения("ПослеЗакрытияФормыПрикрепленных", ЭтаФорма);

	ф = ОткрытьФорму("Задача.ИА_ЗадачаПланаДействий.Форма.ФормаПрикрепленныхФайлов",СтрПарам,ЭтаФорма,,,,Оповещение);
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияФормыПрикрепленных(Результат, Параметры) Экспорт
	Если Результат <> КодВозвратаДиалога.Отмена 
		И Результат <> Неопределено Тогда
		//Значит Сохраняем
		
		Модифицированность = истина;
		Объект.Файлы.Очистить();
		Для каждого стр из Результат.Файлы Цикл
			Новстр = Объект.Файлы.Добавить();
			ЗаполнитьЗначенияСвойств(Новстр, стр);
		КонецЦикла;	
		
		Для каждого стр из Результат.СписокДобавленныхФайлов Цикл
			СписокДобавленныхФайлов.Добавить(стр);
		КонецЦикла;
		ОбновитьКоличествоФайлов();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьКоличествоФайлов()
	к = Объект.Файлы.Количество();
	Элементы.ПрикрепленныйФайл.Заголовок = ?(к = 0, "Прикрепить файлы", "Прикрепленные файлы (" + к + ")");
КонецПроцедуры

&НаКлиенте
Процедура КомандныеЛинииНажатие(Элемент)
	ф = ПолучитьФорму("Задача.ИА_ЗадачаПланаДействий.Форма.ФормаКомандныеЛинии");
	ф.КомЛинии.Очистить();
	Для каждого стр из Объект.Маршрут Цикл
		Новстр = ф.КомЛинии.Добавить();
		ЗаполнитьЗначенияСвойств(Новстр, стр);
	КонецЦикла;
	
	Если не Объект.ЭтоЗРС ТОгда
		ф.Элементы.КомЛинииВсеВерно.Заголовок = "Выполнено";
	КонецЕсли;
	
	ф.Открыть();
КонецПроцедуры

