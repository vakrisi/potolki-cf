&НаКлиенте
Процедура ВзятьВРаботу(Команда)
	
	Если Объект.ПоКомлиниям И не ИА_ОбщиеПроцедуры_Технология_КоммЦентр.ПользовательНаПосту(ТекПользователь, Объект.Пост) тогда
		ПоказатьПредупреждение(,"Вы не занимаете пост " + Объект.Пост+"! Вы не можете взять эту задачу.");
		Возврат;
	КонецЕсли;
	
	Комментарий = "Задача взята пользователем";	
	ДобавитьКоммент(Комментарий);
	
	Объект.Пользователь = ТекПользователь;
	Если не Объект.ПоКомлиниям Тогда
		Объект.Пост = ПредопределенноеЗначение("Справочник.ОргСхема.ПустаяСсылка");
	КонецЕсли;
	
	Записать();
	ОбновитьВидимостьКнопок();
	ОбновитьВидимостьДоступностьЭлементов();
	
КонецПроцедуры

