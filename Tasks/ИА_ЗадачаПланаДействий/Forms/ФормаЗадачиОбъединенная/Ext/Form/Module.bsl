&НаСервере
Процедура ЗадачаВыполнитьНаСервере()
	
	ОбъектЗадачи = РеквизитФормыВЗначение("Объект");
	ИА_Защита_КЦ.ЗадачаВыполнитьНаСервере(ТекПользователь, ОбъектЗадачи);
	ЗначениеВРеквизитФормы(ОбъектЗадачи,"Объект");
КонецПроцедуры


&НаКлиенте
Процедура ОтправитьЗадачу(Команда)
	
	Если СокрЛП(объект.Наименование) = "" Тогда
		Сообщить("Заполните тему!");
		Возврат;
	КонецЕсли;
	
	Отказ = Ложь;
	
	ПроверкаПоста();
	
	ПроверитьЗаполнениеРеквизитов(Отказ);
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	Объект.Отправлена = Истина;
	
	Если Объект.ЗРСП и Объект.Маршрут.Количество()>1 Тогда // отправим опять по маршруту
		ПоказатьВопрос(Новый ОписаниеОповещения("ОтправитьЗадачуЗавершение", ЭтотОбъект), "ЗРС будет отправлена по командной линии на пост: "+ Объект.Маршрут[1].Пост + ". Продолжить?", РежимДиалогаВопрос.ДаНет);
        Возврат;
	КонецЕсли;
	
	ОтправитьЗадачуФрагмент();
КонецПроцедуры

&НаКлиенте
Процедура ОтправитьЗадачуЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса=КодВозвратаДиалога.Да Тогда
		Объект.Маршрут[0].ВсеВерно = истина;
		Объект.Маршрут[0].ДатаПодтверждения = ТекущаяДата();
		
		сч = 1;
		СледующийПост = Объект.Маршрут[1].Пост;				
		ПостНайден = ложь;
		Пока сч < Объект.Маршрут.Количество() Цикл
			Если ИА_ОбщиеПроцедуры_Технология_КоммЦентр.ПользовательНаПосту(ТекПользователь, Объект.Маршрут[сч].Пост) И не Объект.Маршрут[сч].ВсеВерно Тогда
				Объект.Маршрут[сч].ВсеВерно = Истина;
				Объект.Маршрут[сч].ДатаПодтверждения = ТекущаяДата();
			Иначе
				СледующийПост = Объект.Маршрут[сч].Пост; 
				ПостНайден = истина;
				Прервать;
			КонецЕсли;
			сч = сч + 1;
		КонецЦикла;
		
		Объект.Пользователь = ПредопределенноеЗначение("Справочник.Пользователи.ПустаяСсылка");
		Если ПостНайден тогда
			Объект.Пост = СледующийПост; 
		Иначе
			Объект.Пост = Объект.Маршрут[0].Пост; 
		КонецЕсли;
	Иначе
		возврат;
	КонецЕсли;
	
	ОтправитьЗадачуФрагмент();

КонецПроцедуры

&НаКлиенте
Процедура ОтправитьЗадачуФрагмент()
	
	Если ЗначениеЗаполнено(Объект.ИсполнительЗРС) Тогда // возврат зрс
		ПоказатьВопрос(Новый ОписаниеОповещения("ОтправитьЗадачуФрагментЗавершение", ЭтотОбъект), "ЗРС будет отправлена пользователю: "+ Объект.ИсполнительЗРС + ". Продолжить?", РежимДиалогаВопрос.ДаНет);
        Возврат;
	КонецЕсли;
	
	
	ОтправитьЗадачуФрагментФрагмент();
КонецПроцедуры

&НаКлиенте
Процедура ОтправитьЗадачуФрагментЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса=КодВозвратаДиалога.Да Тогда
		Объект.Пользователь = Объект.ИсполнительЗРС;
		Объект.Пост = ПредопределенноеЗначение("Справочник.ОргСхема.ПустаяСсылка");
		Объект.ИсполнительЗРС = ПредопределенноеЗначение("Справочник.Пользователи.ПустаяСсылка");
	Иначе
		возврат;
	КонецЕсли;
	
	ОтправитьЗадачуФрагментФрагмент();

КонецПроцедуры

&НаКлиенте
Процедура ОтправитьЗадачуФрагментФрагмент()
	
	Объект.ЗРСП = Ложь;
	Объект.ОтказЗадачи = Ложь;
	
	Записать();
	
	ПроверитьИсоздатьЗадачиПоСписку();
	
	Закрыть();

КонецПроцедуры

&НаКлиенте
Процедура ОтправитьПоКомлиниям(Команда)
	
	Если СокрЛП(объект.Наименование) = "" Тогда
		Сообщить("Заполните тему!");
		Возврат;
	КонецЕсли;
	
	ПроверкаПоста();
	
	Если ОтправитьПоКомлиниямНаСервере() Тогда
		Объект.Отправлена = Истина;
		Объект.ЗРСП = Ложь;
		Записать();
		Закрыть();
	КонецЕсли;
	
КонецПроцедуры

