&НаКлиенте
Процедура ПередатьДругомуСотрудникуЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса=КодВозвратаДиалога.Да Тогда
		польз = ПредопределенноеЗначение("Справочник.Пользователи.ПустаяСсылка");
		ПоказатьВводЗначения(Новый ОписаниеОповещения("ПередатьДругомуСотрудникуЗавершениеЗавершение", ЭтотОбъект, Новый Структура("польз", польз)), польз, "Кому передать задачу?");
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПередатьДругомуСотрудникуЗавершениеЗавершение(Значение, ДополнительныеПараметры1) Экспорт
	
	польз = ?(Значение = Неопределено, ДополнительныеПараметры1.польз, Значение);
	
	
	Если (Значение <> Неопределено) Тогда
		Если ЗначениеЗаполнено(польз) Тогда
			
			// если отказались от задачи, то можно пустить другому исполнителю вне комлиний
			Если Объект.ПоКомлиниям и Объект.ОтказЗадачи и ТекПользователь = Объект.Автор Тогда
				Объект.ПоКомлиниям = ложь;
			КонецЕсли;	
			
			Если Объект.ПоКомлиниям Тогда
				Если не ИА_ОбщиеПроцедуры_Технология_КоммЦентр.ПользовательНаПосту(польз, Объект.Пост) тогда
					ПоказатьПредупреждение(,"Выбранный пользователь не занимает пост " + Объект.Пост+"! Это недопустимо при работе с ЗРС.");
					Возврат;
				КонецЕсли;
			КонецЕсли;
			
			// при передаче задачи, пишем кто передал и на кого
			Комментарий = "Задачу передал " + ТекПользователь + " на " + польз;
			Если Объект.ДокладОбИсполнении<>"" Тогда
				Комментарий = Комментарий + Символы.ПС + "Предыдущий доклад: "+ Объект.ДокладОбИсполнении;
				Объект.ДокладОбИсполнении = "";
			КонецЕсли;
			ДобавитьКоммент(Комментарий, Объект.Автор);
			
			// сбросить "в работе" при передаче задачи
			Объект.Отложена = Ложь;
			
			// уведомления
			Если ТекПользователь <>  Объект.Автор Тогда
				ИА_ОбщиеПроцедуры_Технология_КоммЦентр.СоздатьУведомление(Объект.Ссылка, Объект.Автор, ПредопределенноеЗначение("Перечисление.ИА_ВидСобытия.ПереданаДругомуИсполнителю"), "Задача """+Объект.Наименование+""" передана на: "+ польз);
			КонецЕсли;
			Для каждого стр из объект.МаршрутПередачи Цикл
				Если ТекПользователь <>  стр.Пользователь Тогда
					ИА_ОбщиеПроцедуры_Технология_КоммЦентр.СоздатьУведомление(Объект.Ссылка, стр.Пользователь, ПредопределенноеЗначение("Перечисление.ИА_ВидСобытия.ПереданаДругомуИсполнителю"), "Задача """+Объект.Наименование+""" передана на: "+ польз);
				КонецЕсли;
			КонецЦикла;
			
			// Маршрут передачи
			Если не Объект.ПоКомлиниям Тогда
				// если он уже есть в маршруте, то удалим его. Еще раз проходить через него не надо
				Отбор = новый Структура("Пользователь", Объект.Пользователь);
				стрРез = объект.МаршрутПередачи.НайтиСтроки(Отбор);
				Если стрРез.Количество()>0 Тогда
					объект.МаршрутПередачи.Удалить(стрРез[0]);	
				КонецЕсли;
				
				// если ранее передавали на него, то еще раз уведомлять не надо
				Отбор = новый Структура("Пользователь", польз);
				стрРез = объект.МаршрутПередачи.НайтиСтроки(Отбор);
				Если стрРез.Количество()>0 Тогда
					объект.МаршрутПередачи.Удалить(стрРез[0]);	
				КонецЕсли;
				
				Если Объект.Пользователь <> Объект.Автор Тогда
					Новстр = объект.МаршрутПередачи.Добавить();
					Новстр.Пользователь = Объект.Пользователь;
				КонецЕсли;
			КонецЕсли;
			
			Объект.ОтказЗадачи = Ложь;
			Объект.ОтклонениеЗРС = Ложь;
			
			Объект.Пост = ПредопределенноеЗначение("Справочник.ОргСхема.ПустаяСсылка");
			Объект.Пользователь = польз;
			Записать();
			Закрыть();
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

