КонецПроцедуры

&НаКлиенте
Процедура ЗРСПЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено или СокрЛП(Результат)= "" Тогда
		Возврат;
	КонецЕсли;
	
	зн = СОКРЛП(Результат); 	
	
	Если не Объект.ПоКомлиниям Тогда // запомним исполнителя ЗРС
		Объект.ИсполнительЗРС = ТекПользователь;
	КонецЕсли;
	
	Объект.Пользователь = Объект.Автор;
	Объект.Пост = ПредопределенноеЗначение("Справочник.ОргСхема.ПустаяСсылка");
	Объект.Отложена = Ложь;
	
	Для каждого стр из Объект.Маршрут Цикл
		стр.ВсеВерно = Ложь;
		стр.ДатаПодтверждения = Дата(1,1,1);
	КонецЦикла;
	
	Комментарий = "Требуется уточнение: "+ зн;
	ДобавитьКоммент(Комментарий);
	
	ИА_Защита_КЦ.ВключитьНапоминание(ТекПользователь, Объект.Ссылка);
	
	Объект.ЗРСП = Истина;
	
	Записать();	
	Закрыть();

КонецПроцедуры

&НаКлиенте
Процедура ВРаботе(Команда)
	
	Комментарий = "В работе";
	ДобавитьКоммент(Комментарий, Объект.Автор);
	
	Объект.Отложена = Истина;
	Записать();
	
	Если ТекПользователь <>  Объект.Автор Тогда
		ИА_ОбщиеПроцедуры_Технология_КоммЦентр.СоздатьУведомление(Объект.Ссылка, Объект.Автор, ПредопределенноеЗначение("Перечисление.ИА_ВидСобытия.ВРаботе"), "Задача взята в работу");
	КонецЕсли;
	
	Закрыть();
	
КонецПроцедуры

