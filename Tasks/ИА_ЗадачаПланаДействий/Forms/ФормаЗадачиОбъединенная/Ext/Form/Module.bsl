КонецФункции

&НаКлиенте
Процедура ПрикрепленныйОбъектНажатие(Элемент)
	Если ЗначениеЗаполнено(Объект.ПрикрепленныйОбъект) Тогда   // просто откроем
		ОткрытьДолжностныеИнструкции = Ложь;
		ОткрытьЗаданиеДИ = Ложь;
	
		Попытка 
			Если ТипЗнч(Объект.ПрикрепленныйОбъект) = Тип("СправочникСсылка.ИА_Инструкции")Тогда
				ОткрытьДолжностныеИнструкции = Истина;
			КонецЕсли;       
		Исключение
		КонецПопытки;
		
		Попытка 
			Если ТипЗнч(Объект.ПрикрепленныйОбъект) = Тип("ДокументСсылка.ИА_ЗаданиеНаИзучениеДИ")Тогда
				Если ЭтоМоеЗаданиеДИ(Объект.ПрикрепленныйОбъект) Тогда
					ОткрытьЗаданиеДИ = Истина;
				КонецЕсли;
			КонецЕсли;       
		Исключение
		КонецПопытки;
		
		Если ОткрытьЗаданиеДИ Тогда
			СтруктураПараметров = Новый Структура("ДокЗадание", Объект.ПрикрепленныйОбъект);
			ФормаСпискаИнструкции = ПолучитьФорму("Обработка.ИА_РаботаСИнструкциями.Форма.ФормаУправляемая", СтруктураПараметров,ЭтаФорма);
			ФормаСпискаИнструкции.Открыть();
		ИначеЕсли ОткрытьДолжностныеИнструкции Тогда
			
			СтруктураПараметров = Новый Структура("Инструкция", Объект.ПрикрепленныйОбъект);
			
			ФормаСпискаИнструкции = ПолучитьФорму("Обработка.ИА_РаботаСИнструкциями.Форма.ФормаУправляемая", СтруктураПараметров,ЭтаФорма);
			ФормаСпискаИнструкции.ВыбИнструкция = Объект.ПрикрепленныйОбъект;
			ФормаСпискаИнструкции.Открыть();
			ФормаСпискаИнструкции.ОткрытьИнструкциюНаВесьЭкран(Объект.ПрикрепленныйОбъект);
		ИначеЕсли ОБъект.ЭтоКоррекцияСУ Тогда
			ФормаСУ = ПолучитьФорму("Обработка.ИА_РабочийСтолСтратегическогоУправления.Форма.Форма");
			ФормаСУ.Отбор_ЗРС = Объект.Ссылка;
			ФормаСУ.Открыть();
			ФормаСУ.СледующаяКоррекция(Неопределено);
		Иначе
			ПоказатьЗначение(,Объект.ПрикрепленныйОбъект);
		КонецЕсли;
	ИначеЕсли не Объект.Выполнена Тогда
		ОткрытьФорму("Задача.ИА_ЗадачаПланаДействий.Форма.ФормаВопросаПрикрепленногоОбъекта",,,,,, Новый ОписаниеОповещения("ПрикрепленныйОбъектНажатиеЗавершение", ЭтотОбъект), РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);
	КонецЕсли;
КонецПроцедуры

