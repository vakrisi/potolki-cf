Процедура Выполненно(Команда)
	ПоказатьВопрос(Новый ОписаниеОповещения("ВыполненноЗавершение", ЭтотОбъект), "Вы уверены?",РежимДиалогаВопрос.ДаНет);	
КонецПроцедуры

&НаКлиенте
Процедура ВыполненноЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса=КодВозвратаДиалога.Да Тогда
		Если Не Объект.ЭтоЗРС и Не СерединаКоманднойЛинии и Не ЭтоДоклад и СокрЛП(Объект.ДокладОбИсполнении) = "" и Не Объект.ОтказЗадачи Тогда 
			Сообщить("Должен быть заполнен доклад об исполнении!");
			Возврат;
		КонецЕсли;
		
		Если Модифицированность Тогда
			ЭтаФорма.Записать();
		КонецЕсли; 
		ЗадачаВыполнитьНаСервере();
		Закрыть();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура Отказаться(Команда)
	
	ПоказатьВопрос(Новый ОписаниеОповещения("ОтказатьсяЗавершение1", ЭтотОбъект), "Вы уверены?",РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтказатьсяЗавершение1(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса=КодВозвратаДиалога.Да Тогда
		
		Если Объект.ЭтоЗРС Тогда
			ЗаголовокФ = "Введите причину отклонения ЗРС";
		Иначе
			ЗаголовокФ = "Введите причину отказа";
		КонецЕсли;
		Парам = новый Структура("Заголовок", ЗаголовокФ);
		ОткрытьФорму("ОбщаяФорма.ИА_ФормаРедактированияСтрокиУправляемая", Парам,,,,, Новый ОписаниеОповещения("ОтказатьсяЗавершение", ЭтотОбъект), РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ДобавитьКоммент(Комментарий, получатель = Неопределено) Экспорт
	Если Взаимодействия1с Тогда
		пол = получатель;
		Если пол = ТекПользователь тогда
			пол = Неопределено;
		КонецЕсли;
		ИА_ОбщиеПроцедуры_Технология_КоммЦентр.ДобавитьЗаписьВЗадачу(объект.ссылка,Комментарий,пол);
	Иначе
		Новстр = Объект.ХодВыполнения.Вставить(0);
		Новстр.Дата = ТекущаяДата();
		Новстр.Комментарий = Комментарий;
		Новстр.Пользователь = ТекПользователь;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОтказатьсяЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	рез = Результат;
	
	ОтказДобавлен = Ложь;
	Если Результат<>Неопределено Тогда
		зн = Результат;
		Если СОКРЛП(зн)<>"" Тогда			
			ДобавитьКоммент(СОКРЛП(зн));					
			ОтказДобавлен = истина;
		КонецЕсли;
	КонецЕсли; 
	
	Если не ОтказДобавлен Тогда
		ПоказатьПредупреждение(,"Необходимо указать причину отказа!");
		возврат;
	КонецЕсли;
	
	
	Если Объект.ЭтоЗРС Тогда
		Комментарий = "ЗРС не одобрена";
	Иначе
		Комментарий = "Исполнитель отказался от задачи";
	КонецЕсли;
	ДобавитьКоммент(Комментарий);
	
	КолМарш = Объект.МаршрутПередачи.Количество();
	Если КолМарш > 0 Тогда
		СтрокаМаршрута = Объект.МаршрутПередачи[КолМарш-1];
		Объект.Пользователь = СтрокаМаршрута.Пользователь;	
		Объект.МаршрутПередачи.Удалить(СтрокаМаршрута);
	Иначе
		Объект.Пользователь = Объект.Автор;
	КонецЕсли;
	
	Объект.Отложена = Ложь;
	Объект.Пост = ПредопределенноеЗначение("Справочник.ОргСхема.ПустаяСсылка");
	
	Если Объект.ЭтоЗРС Тогда
		Объект.ОтклонениеЗРС = истина;
		Объект.ИсполнительОтказЗРС = ТекПользователь;
	Иначе
		Объект.ОтказЗадачи = истина;
	КонецЕсли;
	
	Если ЭтоДоклад Тогда
		Объект.Наименование = "[Отклонено] " + Объект.Наименование;
		Объект.Содержание = Объект.Содержание + Символы.ПС + ТекПользователь + " отлонил доклад " + ТекущаяДата() + ":" + Символы.ПС +  СОКРЛП(зн);
	КонецЕсли;
	
	Записать();
	Закрыть();

КонецПроцедуры

&НаКлиенте
Процедура ВернутьНаДоработку(Команда)
	
	ПоказатьВопрос(Новый ОписаниеОповещения("ВернутьНаДоработкуЗавершение1", ЭтотОбъект), "Вы уверены?",РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры

&НаКлиенте
Процедура ВернутьНаДоработкуЗавершение1(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса=КодВозвратаДиалога.Да Тогда	
		
		Если Объект.ПоКомлиниям Тогда
			
			Объект.Маршрут[Объект.Маршрут.Количество()-1].ВсеВерно = Ложь;
			Объект.Маршрут[Объект.Маршрут.Количество()-1].ДатаПодтверждения = Дата(1,1,1);
			
			Объект.Пользователь = ПредопределенноеЗначение("Справочник.Пользователи.ПустаяСсылка");
			Объект.Пост = Объект.Маршрут[Объект.Маршрут.Количество()-1].Пост;
			Объект.Отложена = Ложь;
			Объект.ДатаВыполнения = Дата(1,1,1);
			Объект.Исполнитель = ПредопределенноеЗначение("Справочник.Пользователи.ПустаяСсылка");
		Иначе
			Объект.Пользователь = Объект.Исполнитель;
			Объект.Пост = ПредопределенноеЗначение("Справочник.ОргСхема.ПустаяСсылка");
			Объект.Отложена = Ложь;
			Объект.ДатаВыполнения = Дата(1,1,1);
			Объект.Исполнитель = ПредопределенноеЗначение("Справочник.Пользователи.ПустаяСсылка");
		КонецЕсли;
		
		
		Парам = новый Структура("Заголовок", "Введите причину");
		ОткрытьФорму("ОбщаяФорма.ИА_ФормаРедактированияСтрокиУправляемая", Парам,,,,, Новый ОписаниеОповещения("ВернутьНаДоработкуЗавершение", ЭтотОбъект), РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ВернутьНаДоработкуЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено или СокрЛП(Результат)= "" Тогда
		Возврат;
	КонецЕсли;
	
	зн = СОКРЛП(Результат);
	
	Комментарий = "Возвращено на доработку" + ?(зн = "", "", ": " + зн);
	ДобавитьКоммент(Комментарий);
	
	ИА_Защита_КЦ.ВключитьНапоминание(ТекПользователь, Объект.Ссылка);
	
	
	Объект.Отложена = Ложь;
	Объект.ДатаВыполнения = Дата(1,1,1);
	
	Если ТекПользователь <> Объект.Автор и не Объект.ПоКомлиниям Тогда // маршрут передачи
		Новстр = Объект.МаршрутПередачи.Добавить();
		Новстр.Пользователь = ТекПользователь;
	КонецЕсли;
	
	Записать();	
	Закрыть();

КонецПроцедуры

