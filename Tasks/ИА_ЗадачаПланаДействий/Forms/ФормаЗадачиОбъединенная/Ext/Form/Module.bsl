&НаСервере
Процедура ВыполнитьДаннуюЗадачу()
    
    ОбъектЗадачи = РеквизитФормыВЗначение("Объект");
	Если не ЗначениеЗаполнено(ОбъектЗадачи.Исполнитель) Тогда
		ОбъектЗадачи.Исполнитель = ТекПользователь;
	КонецЕсли;
    ОбъектЗадачи.ВыполнитьЗадачу();
    ЗначениеВРеквизитФормы(ОбъектЗадачи,"Объект");
    
КонецПроцедуры	


&НаКлиенте
Процедура Ответить(Команда)
	
	Парам = новый Структура("Заголовок", "Введите ответ (поле должно быть заполнено)");

	ОткрытьФорму("ОбщаяФорма.ИА_ФормаРедактированияСтрокиУправляемая", Парам,,,,, Новый ОписаниеОповещения("ОтветитьЗавершение", ЭтотОбъект), РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс); 

КонецПроцедуры

&НаКлиенте
Процедура ОтветитьЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено или СокрЛП(Результат)= "" Тогда
		Возврат;
	КонецЕсли;
	
	ТекстОтвета = Результат;
	
	Если не ЗначениеЗаполнено(Объект.Исполнитель) Тогда
		Объект.Исполнитель = ТекПользователь;
	КонецЕсли;
	
	// формирование текст
	ТекТекст = ОБъект.Содержание;
	
	Если не Объект.ЭтоПереписка Тогда // первый ответ
		ТекТекст = Символы.ПС + "   " + Объект.Дата + " " + Объект.Автор + ":" + Символы.ПС + ТекТекст;
	КонецЕсли;
	ТекТекст = Строка(ТекущаяДата()) + " " + ТекПользователь + ":" + Символы.ПС + ТекстОтвета + Символы.ПС + ТекТекст;
	
	Объект.Содержание = ТекТекст;
	
	//
	Объект.ЭтоПереписка = истина;
	Объект.Пост = ПредопределенноеЗначение("Справочник.ОргСхема.ПустаяСсылка");
	
	Если ТекПользователь = Объект.Автор Тогда
		Объект.Пользователь = Объект.Исполнитель;
	Иначе
		Объект.Пользователь = Объект.Автор;
	КонецЕсли;
	
	ЭтоОтвет = Истина;
	
	Записать();
	Закрыть();

КонецПроцедуры

