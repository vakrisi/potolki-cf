&НаКлиенте
Процедура ПроверитьИсоздатьЗадачиПоСписку()
	Если ВводСпискаИсполнителей Тогда
		
		КолИсп = СписокИсполнителей.Количество();
	    Для н=1 По СписокИсполнителей.Количество() Цикл 
	        
	        Если н=1 Тогда 
	            Продолжить; 
	        КонецЕсли;
	        
	        Исполнитель = СписокИсполнителей.Получить(н-1);
	        СоздатьЗадачуПоСпискуИсполнителей(Исполнитель.Значение);				        
	    КонецЦикла;
	    	  
	    СписокИсполнителей.Очистить();
	    
	    ВводСпискаИсполнителей = Ложь;
	КонецЕсли;
КонецПроцедуры
	
