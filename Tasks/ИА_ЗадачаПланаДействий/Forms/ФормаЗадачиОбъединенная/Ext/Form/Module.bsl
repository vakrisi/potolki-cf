&НаСервере 
Процедура СформироватьЛенту() Экспорт
	//
	ЦветФонаЭл = Элементы.НовыйКоммент.ЦветФона;
	// очистка
	сч = 1;
	удРекв = Новый Массив;
	Пока Элементы.ГруппаЛента.ПодчиненныеЭлементы.Количество() >0 Цикл
		Элементы.Удалить(Элементы.ГруппаЛента.ПодчиненныеЭлементы.Получить(0));
		
		удРекв.Добавить("ФотоКоммент"+сч);
		удРекв.Добавить("КомментТекст_"+сч);
		сч = сч + 1;
	КонецЦикла;
	ИзменитьРеквизиты(,удРекв);
	
	//
	ТекНомер = 1;
	тз = Объект.ХодВыполнения.Выгрузить();
	тз.Сортировать("Дата УБЫВ");
	//
	Для каждого стр из тз Цикл
		// реквизит
		ИмяРеквЭл = "КомментТекст_"+ТекНомер;
		МассивРеквизитов = Новый Массив;
		МассивРеквизитов.Добавить(Новый РеквизитФормы(ИмяРеквЭл, Новый ОписаниеТипов("Строка")));
		ИзменитьРеквизиты(МассивРеквизитов);
		ЭтаФорма[ИмяРеквЭл]= стр.Комментарий;
		
		// элементы
		
		ГруппаКоммент = ДобавитьГруппуИФото(ТекНомер, стр.Пользователь);				
		
		фДатаЮзер = Новый ФорматированнаяСтрока(Формат(стр.Дата,"ДФ='dd.MM.yy HH:mm'") +"    "+ стр.Пользователь,Новый Шрифт("Calibri", 10,истина,истина), Новый Цвет(85,85,85));
		НовыйЭлементКомментЮзер = Элементы.Добавить("КомментСтрЮзер"+ТекНомер, Тип("ДекорацияФормы"), ГруппаКоммент);
		НовыйЭлементКомментЮзер.Вид = ВидДекорацииФормы.Надпись;
		НовыйЭлементКомментЮзер.РастягиватьПоГоризонтали = Истина;
		НовыйЭлементКомментЮзер.АвтоМаксимальнаяВысота = ложь;
		НовыйЭлементКомментЮзер.Заголовок = фДатаЮзер;
		НовыйЭлементКомментЮзер.РастягиватьПоВертикали = ложь;
		НовыйЭлементКомментЮзер.Высота = 1;
		//НовыйЭлементКомментЮзер.Рамка = Новый Рамка(ТипРамкиЭлементаУправления.Одинарная,1); 
		
		НовыйЭлементКоммент = Элементы.Добавить("КомментСтр"+ТекНомер, Тип("ПолеФормы"), ГруппаКоммент);
		НовыйЭлементКоммент.Вид = ВидПоляФормы.ПолеВвода;
		НовыйЭлементКоммент.путьКДанным = ИмяРеквЭл;
		НовыйЭлементКоммент.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Нет;
		НовыйЭлементКоммент.многострочныйРежим = истина;
		НовыйЭлементКоммент.Шрифт = Новый Шрифт("Calibri",11,истина);
		НовыйЭлементКоммент.ЦветФона = ЦветФонаЭл;
		НовыйЭлементКоммент.ЦветРамки = ЦветФонаЭл;
		НовыйЭлементКоммент.ТолькоПросмотр = истина;
		
		НовыйЭлементКоммент.АвтоМаксимальнаяВысота = ложь;
		НовыйЭлементКоммент.РастягиватьПоВертикали = ложь;
		НовыйЭлементКоммент.Высота = 3;
		
		//
		ТекНомер = ТекНомер + 1;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере 
Функция ДобавитьГруппуИФото(ТекИндекс, Пользователь)
	ГруппаКоммент = Элементы.Добавить("Коммент"+ТекИндекс, Тип("ГруппаФормы"), Элементы.ГруппаЛента);
	ГруппаКоммент.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	ГруппаКоммент.Отображение = ОтображениеОбычнойГруппы.Нет;
	ГруппаКоммент.ОтображатьЗаголовок = Ложь;
	ГруппаКоммент.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Горизонтальная;
	ГруппаКоммент.РастягиватьПоГоризонтали = Истина;
	
	//
	ИмяРеквЭл = "ФотоКоммент"+ТекИндекс;
	МассивРеквизитов = Новый Массив;
	МассивРеквизитов.Добавить(Новый РеквизитФормы(ИмяРеквЭл, Новый ОписаниеТипов("Строка")));
	ИзменитьРеквизиты(МассивРеквизитов);
	Фото = РегистрыСведений.ИА_ДанныеФизЛиц.ПолучитьФотоПользователя(Пользователь,"Аватар");
	ЭтаФорма[ИмяРеквЭл] = ПоместитьВоВременноеХранилище(Фото, Новый УникальныйИдентификатор); 		
	
	НовыйЭлементФото = Элементы.Добавить(ИмяРеквЭл, Тип("ПолеФормы"), ГруппаКоммент);
	ЗаполнитьЗначенияСвойств(НовыйЭлементФото, Элементы.ФотоАвтора,,"ПутьКДанным,Родитель");
	НовыйЭлементФото.ПутьКДанным = ИмяРеквЭл;
	НовыйЭлементФото.Ширина = 6;
	НовыйЭлементФото.Высота = 2;

	ГруппаКомментПрав = Элементы.Добавить("КомментПрав"+ТекИндекс, Тип("ГруппаФормы"), ГруппаКоммент);
	ГруппаКомментПрав.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	ГруппаКомментПрав.Отображение = ОтображениеОбычнойГруппы.Нет;
	ГруппаКомментПрав.ОтображатьЗаголовок = Ложь;
	ГруппаКомментПрав.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
	ГруппаКомментПрав.РастягиватьПоГоризонтали = Истина;
	
	Возврат ГруппаКомментПрав;
КонецФункции

&НаКлиенте 
Процедура ОбновитьВидимостьДоступностьЭлементов()
	// общие настройки
	Если ЭтоЗРС Тогда
		Элементы.СтраницыРежим.ТекущаяСтраница = Элементы.ЗРС;
	ИначеЕсли ЭтоПослание Тогда
		Элементы.СтраницыРежим.ТекущаяСтраница = Элементы.Послание;
	ИначеЕсли ЭтоЗадача Тогда
		Элементы.СтраницыРежим.ТекущаяСтраница = Элементы.Задача;
	КонецЕсли;
	
	Элементы.ГруппаСрок.Видимость =  ЭтоЗадача;
	Элементы.ГруппаДокладОбИсполнении.Видимость = Объект.Отправлена;
	
	// видимость ленты
	СкрытьЛенту = ИА_НастройкиСПИ.ЗначениеНастройки(ТекПользователь, ПредопределенноеЗначение("ПланВидовХарактеристик.ИА_НастройкиПользователей.СкрытьХодВыполнения"));
	Если ЭтоПослание или СкрытьЛенту или ЭтоДоклад или ЭтоНовый или Взаимодействия1с Тогда 
		Элементы.ГруппаЗаголовокЛенты.Видимость = Ложь;
		Элементы.ГруппаЛента.Видимость = Ложь;
		Элементы.ДобавитьКомментарий.Видимость = Ложь;
	КонецЕсли;
	Элементы.ГруппаКомЛинии.Видимость = Объект.Маршрут.Количество()>0;
	
	Если Объект.ПометкаУдаления Тогда
		ЭтаФорма.ТолькоПросмотр = истина;
		ЭтаФорма.КоманднаяПанель.Видимость = ложь;
		возврат;
	КонецЕсли;
	МожноРедакт = (не Объект.Отправлена) И ОБъект.Автор = ТекПользователь;
	///
	Элементы.Наименование.ТолькоПросмотр = не МожноРедакт;
	Ред_ПостАвтора = МожноРедакт;  
	Ред_Пользователь = МожноРедакт или ЭтоАдмин;
	Ред_Пост = МожноРедакт или ЭтоАдмин;	
	Ред_Срок = МожноРедакт;
	
	Элементы.ГруппаКП_Подзадачи.Видимость = МожноРедакт;
	Элементы.ПодзадачиЗадача.ТолькоПросмотр = не МожноРедакт;
	Элементы.ПодзадачиПользователь.ТолькоПросмотр = не МожноРедакт;
	
	Элементы.Содержание.ТолькоПросмотр = не МожноРедакт;
	Элементы.Содержание1.ТолькоПросмотр = не МожноРедакт;
	
	Элементы.УточнитьЗадачу.Видимость = ЭтоЗадача и не МожноРедакт;
	
	Элементы.Ситуация.ТолькоПросмотр = не МожноРедакт И не Объект.ЗРСП;
	Элементы.Данные.ТолькоПросмотр = не МожноРедакт И не Объект.ЗРСП;;
	Элементы.Решение.ТолькоПросмотр = не МожноРедакт И не Объект.ЗРСП;;
	
	Элементы.ПрикрепленныйОбъектКонтекстноеМенюОчиститьПрикрепленныйОбъект.Видимость = МожноРедакт;
	
	Элементы.ДокладОбИсполнении.ТолькоПросмотр = не (Объект.Автор = ТекПользователь ИЛИ МояЗадача);
	
	Если ЭтоДоклад Тогда
		Элементы.ГруппаСрок.Видимость = ложь;
		Элементы.Наименование.ТолькоПросмотр = истина;
		Элементы.ГруппаДокладОбИсполнении.Видимость = ложь;
	КонецЕсли;
	
	Если Объект.ЭтоКоррекцияСУ ТОгда
		Элементы.Решение.ТолькоПросмотр = истина;
		Ред_Пользователь = ложь;
		Ред_Пост = ложь;	
		Элементы.Наименование.ТолькоПросмотр = истина;
		Элементы.ОтправитьПоКомлиниям.Видимость = ложь;
	КонецЕсли;

	Элементы.ГруппаПодзадачи.Видимость = МожноРедакт или Объект.Подзадачи.Количество()>0;
	Если (не МожноРедакт) и Объект.Подзадачи.Количество()>0 Тогда
		Элементы.ГруппаПодзадачи.Показать();
	КонецЕсли;
КонецПроцедуры

