&НаКлиенте
Процедура ПостАвтораНажатие(Элемент)
	Если не Ред_ПостАвтора Тогда
		Возврат;
	КонецЕсли;
	
	м = ИА_ОбщиеПроцедуры_Технология_КоммЦентр.ПолучитьМассивПостов(Объект.Автор);
	список = новый СписокЗначений;
	список.ЗагрузитьЗначения(м);
	
	Оп = Новый ОписаниеОповещения("ВыполнитьПослеВыбораПостаАвтора", ЭтаФорма);
	//ПоказатьВыборИзСписка(Оп, список, Элементы.ГруппаОт); 
	ПоказатьВыборИзСписка(Оп, список, Элементы.ПостАвтора); 
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьПослеВыбораПостаАвтора(рез, парам) Экспорт
	Если рез <> Неопределено Тогда
		Объект.ПостАвтора = рез.Значение;
		ОбновитьЗаголовкиЭлементовШапки();
	КонецЕсли;
КонецПроцедуры


&НаКлиенте
Процедура ПостНажатие(Элемент)
	Если не Ред_Пост Тогда
		Возврат;
	КонецЕсли;
	
	Оп = Новый ОписаниеОповещения("ВыполнитьПослеВыбораПоста", ЭтаФорма);
	парам = Новый Структура("ОтборПользователь, ОтборИерархия", Объект.Пользователь, Объект.ПостАвтора);
	ОткрытьФорму("Справочник.ОргСхема.ФормаВыбора", парам,ЭтаФорма,,,,оп,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьПослеВыбораПоста(рез, парам) Экспорт
	Если рез <> Неопределено Тогда
		Объект.Пост = рез;
		ОбновитьЗаголовкиЭлементовШапки();
	КонецЕсли;
КонецПроцедуры


&НаКлиенте
Процедура СрокНажатие(Элемент)
	Если не Ред_Срок Тогда
		Возврат;
	КонецЕсли;
	
	Оп = Новый ОписаниеОповещения("ВыполнитьПослеВыбораСрока", ЭтаФорма);
	Если Объект.Пользователь.Пустая() тогда
		ПоказатьВводДаты(Оп, Объект.СрокИсполнения, "Введите срок");
	Иначе
		ОткрытьФорму("Задача.ИА_ЗадачаПланаДействий.Форма.ВыборСрока",Новый Структура("Пользователь", Объект.Пользователь),,,,,оп);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьПослеВыбораСрока(рез, парам) Экспорт
	Если рез <> Неопределено Тогда
		Объект.СрокИсполнения = рез;
		
		тд = ТекущаяДата();	
		Если Объект.СрокИсполнения = НачалоДня(тд) Тогда
			Объект.СрокИсполнения = тд + 300;
		КонецЕсли;
		
		Если  Объект.СрокИсполнения < (тд + 300) Тогда
			Объект.СрокИсполнения = тд + 300;
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = "Срок должен быть больше текущей даты. Установлен соответствующий срок!";
			Сообщение.Поле = "Объект.СрокИсполнения";
			Сообщение.ПутьКДанным = "Объект.СрокИсполнения";
			Сообщение.УстановитьДанные(Объект.СрокИсполнения);
			Сообщение.Сообщить();
		КонецЕсли;

		ОбновитьЗаголовкиЭлементовШапки();
	КонецЕсли;
КонецПроцедуры


&НаКлиенте
Процедура ПользовательНажатие(Элемент)
	Если не Ред_Пользователь Тогда
		Возврат;
	КонецЕсли;
	
	Если ВводСпискаИсполнителей Тогда
		парамФ = Новый Структура("Значения", СписокИсполнителей.ВыгрузитьЗначения());
		опов = Новый ОписаниеОповещения("ОткрытьВыборСписокИсполнителейЗавершение", ЭтотОбъект);
		ОткрытьФорму("ОбщаяФорма.ИА_ВводСпискаПользователей",парамФ, ЭтаФорма,,,, опов, РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);
	Иначе
		Оп = Новый ОписаниеОповещения("ВыполнитьПослеВыбораПользователя", ЭтаФорма);
		ПоказатьВводЗначения(Оп, Объект.Пользователь, "Введите сотрудника");
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьПослеВыбораПользователя(рез, парам) Экспорт
	Если рез <> Неопределено Тогда
		Объект.Пользователь = рез;
		Если ЭтоПослание Тогда
			Объект.Пост = ПредопределенноеЗначение("Справочник.ОргСхема.ПустаяСсылка");
		Иначе
			Объект.Пост = ИА_ОбщиеПроцедуры_Технология_КоммЦентр.ПолучитьВысокийПостПользователя(Объект.Пользователь, Объект.ПостАвтора);
		КонецЕсли;
		ОбновитьЗаголовкиЭлементовШапки();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСвернутыеЗаголовки()
	Элементы.ГруппаСодержание1.ЗаголовокСвернутогоОтображения = "Содержание: " + Объект.Содержание;
	Элементы.ГруппаДокладОбИсполнении.ЗаголовокСвернутогоОтображения = "Доклад об исполнении: " + Объект.ДокладОбИсполнении;
