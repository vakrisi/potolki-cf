&НаСервере
Функция ЕстьБизнесПроцессы()
	Возврат ЗначениеЗаполнено(Объект.БизнесПроцесс) И ЗначениеЗаполнено(Объект.ИА_ТочкаБП);
КонецФункции

&НаСервере
Процедура БП_ЗаполнитьСвязанныеДанные()
    Если ЕстьБизнесПроцессы() Тогда
    	ИА_БПС.ФормаЗадачи_ЗаполнитьРеквизитыБП(Объект, ИА_БПРеквизиты);
    КонецЕсли;  
КонецПроцедуры
 
&НаСервере
Процедура БП_ПриСозданииНаСервере()
    Если ЕстьБизнесПроцессы() Тогда
        Если ЗначениеЗаполнено(Объект.БизнесПроцесс) Тогда
            Элементы.ГруппаБП.Видимость = Истина;
            Элементы.ИА_ВариантУсловияБП.Видимость = Справочники.ИА_БПТочкиМаршрута.ВТочкеТребуетсяВыборВарианта(Объект.ИА_ТочкаБП);          
        Иначе
            Элементы.ГруппаБП.Видимость = Ложь;
        КонецЕсли; 
        БП_ЗаполнитьСвязанныеДанные();
        
        Элементы.ИА_БПДанные.Видимость = ИА_БПРеквизиты.Количество() > 0;
        Элементы.ИА_БПВладелец.Видимость = Объект.БизнесПроцесс.ИА_МаршрутЗадачБП.ВыводитьВладельцаБПВЗадаче;
        ИА_БПВладелец = Объект.БизнесПроцесс.ИА_Владелец;
    КонецЕсли;     
КонецПроцедуры

&НаСервере
Процедура БП_ЗаписатьСвязанныеДанные()
    Если ЕстьБизнесПроцессы() Тогда
        ИА_БПС.ФормаЗадачи_ЗаписатьСвязанныеДанныеБП(Объект, ИА_БПРеквизиты);
    КонецЕсли; 
КонецПроцедуры

//_____________________________________________________________



&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ТекПользователь = ПараметрыСеанса.ТекущийПользователь;
	Взаимодействия1с = Константы.КСУ_КЦ_ИспользоватьВзаимодействия1С.Получить();
	
	// Заполнение новой
	Если Объект.Ссылка.Пустая() Тогда
		Объект.Автор = ТекПользователь;
		Объект.ПостАвтора = ИА_ОбщиеПроцедуры_Технология_КоммЦентр.ПолучитьВысокийПостПользователя(ТекПользователь);
		
		Если Параметры.ЭтоЗРС Тогда
			Объект.ЭтоЗРС = Истина;
		КонецЕсли;
		
		Если Параметры.ЭтоПослание Тогда
			Объект.ЭтоПослание = Истина;
		КонецЕсли;
		
		Параметры.Свойство("Пост", Объект.Пост);
		Параметры.Свойство("Пользователь", Объект.Пользователь);
		Параметры.Свойство("ЗадачаСУ", Объект.ЗадачаСУ);
		Параметры.Свойство("Наименование", Объект.Наименование);
		Параметры.Свойство("Содержание", Объект.Содержание);
		
		Если не Объект.ЭтоПослание Тогда
			Объект.Приоритет = Перечисления.КСУ_ПриоритетЗадачи.Средний;
		КонецЕсли;
	КонецЕсли;
	
	// Определение режима
	ЭтоЗРС = Объект.ЭтоЗРС;
	ЭтоПослание = Объект.ЭтоПослание;
	ЭтоЗадача = не (ЭтоЗРС или ЭтоПослание);
	
	//
	Если ЭтоЗадача Тогда
		ЭтоАдмин = ИА_ПраваС.ЗначениеПрава(ТекПользователь, ПредопределенноеЗначение("ПланВидовХарактеристик.ИА_ПраваПользователей.АдминистраторЗадач"));
		ЭтоДоклад = ЗначениеЗаполнено(Объект.ЗадачаСУ);
		БП_ПриСозданииНаСервере();		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере 
Процедура ОбновитьЗаголовкиЭлементовШапки() Экспорт
	Элементы.Автор.Заголовок = Объект.Автор;
	Элементы.ПостАвтора.Заголовок = ?(Объект.ПостАвтора.Пустая(), "<выбрать пост>",СокрЛП(Объект.ПостАвтора.Наименование));
	
	Если Объект.ЗРСП Тогда
		Если Объект.ПоКомлиниям И Объект.Маршрут.Количество()>0 Тогда 
			Элементы.Пользователь.Заголовок = ""; 
			Элементы.Пост.Заголовок = "[ЗРСП] " + Объект.Маршрут[Объект.Маршрут.Количество()-1].Пост;
		Иначе
			Элементы.Пользователь.Заголовок = "[ЗРСП] " + Объект.ИсполнительЗРС; 
			Элементы.Пост.Заголовок = "";
		КонецЕсли;
	Иначе
		Если ВводСпискаИсполнителей Тогда
			ТекстСпис = "";
			Для каждого стр из СписокИсполнителей Цикл
				ТекстСпис = ТекстСпис + стр.Значение + "; ";
			КонецЦикла;
			
			Элементы.Пользователь.Заголовок = ?(СписокИсполнителей.Количество()=0, "<выбрать сотрудников>", ТекстСпис); 
		Иначе
			Элементы.Пользователь.Заголовок = ?(Объект.Пользователь.Пустая(), "<выбрать сотрудника>",Объект.Пользователь); 
		КонецЕсли;
		Элементы.Пост.Заголовок = ?(Объект.Пост.Пустая(), "<выбрать пост>",СокрЛП(Объект.Пост.Наименование));
	КонецЕсли;
	
	Элементы.Срок.Заголовок = ?(ЗначениеЗаполнено(Объект.СрокИсполнения), Формат(Объект.СрокИсполнения,"ДФ=dd.MM.yyyy"),"<указать срок>");
КонецПроцедуры
	
&НаСервере 
Процедура ОбновитьЗаголовокИФотоАвтора()
	Заголовок = "Задача";
	Если Объект.ЭтоЗРС Тогда
		Заголовок = "ЗРС";
	ИначеЕсли Объект.ЭтоПослание Тогда
		Заголовок = "Послание";
	КонецЕсли;
	Если ЗначениеЗаполнено(Объект.Дата) Тогда
		Заголовок = Заголовок + " от " + Объект.Дата;
	КонецЕсли;
	//
	Фото = РегистрыСведений.ИА_ДанныеФизЛиц.ПолучитьФотоПользователя(Объект.Автор,"Аватар");
	ФотоАвтора = ПоместитьВоВременноеХранилище(Фото, ЭтаФорма.УникальныйИдентификатор); 
	
	Фото = РегистрыСведений.ИА_ДанныеФизЛиц.ПолучитьФотоПользователя(ТекПользователь,"Аватар");
	ФотоТекПользователя = ПоместитьВоВременноеХранилище(Фото, Новый УникальныйИдентификатор); 
	
	Фото = РегистрыСведений.ИА_ДанныеФизЛиц.ПолучитьФотоПользователя(Объект.Исполнитель,"Аватар");
	ФотоИсполнителя = ПоместитьВоВременноеХранилище(Фото, Новый УникальныйИдентификатор); 
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	Если не ИА_Защита_Общий.ЛицензияДоступна("КЦ") Тогда
		Отказ = Истина;
		возврат;
	КонецЕсли;
	
	ОбновитьНаСервере();
	
	ОбновитьВидимостьКнопок();
	ОбновитьВидимостьДоступностьЭлементов();
	ОбновитьСвернутыеЗаголовки();
	ОбновитьКоличествоФайлов();
	ОбновитьНадписьПрикрОбъекта();
	ОбновитьНадписьОснование();
	ОбновитьНадписьПриоритет();
	ОбновитьГруппуПодзадачи();
КонецПроцедуры

&НаСервере
Процедура ОбновитьНаСервере()
	ОбновитьЗаголовокИФотоАвтора();
	ОбновитьЗаголовкиЭлементовШапки();
	Если не Взаимодействия1с Тогда
		СформироватьЛенту();
	КонецЕсли;
КонецПроцедуры


&НаКлиенте
Функция ИтогПоМаршруту(пКолонка)
	рез = 0;
	Для каждого стр из Объект.Маршрут Цикл
		Если стр[пКолонка] Тогда
			рез = рез + 1;
		КонецЕсли;
	КонецЦикла;
	
	Возврат рез;
КонецФункции

&НаКлиенте
Функция ЭтоВыполнениеПоКомандЛинии()
	Если не Объект.ПоКомлиниям Тогда
		Возврат ложь;
	КонецЕсли;
	
	всегоШагов = Объект.Маршрут.Количество();
	ИтогоВыполнено = ИтогПоМаршруту("ВсеВерно");
	Если ИтогоВыполнено < всегоШагов И ИтогоВыполнено > 0 Тогда
		Возврат истина;
	Иначе
		Возврат ложь;
	КонецЕсли;
КонецФункции

&НаКлиенте
Функция ЭтоСерединаКомандЛинии()
	Если не Объект.ПоКомлиниям Тогда
		Возврат ложь;
	КонецЕсли;
	
	всегоШагов = Объект.Маршрут.Количество();
	ИтогоВыполнено = ИтогПоМаршруту("ВсеВерно");
	Если ИтогоВыполнено < всегоШагов-1 И ИтогоВыполнено > 0 Тогда
		Возврат истина;
	Иначе
		Возврат ложь;
	КонецЕсли;
КонецФункции

&НаКлиенте
Функция ЭтоВозвратПоКомандЛинии()
	Если не Объект.ПоКомлиниям Тогда
		Возврат ложь;
	КонецЕсли;
	
	всегоШагов = Объект.Маршрут.Количество();
	ИтогоВыполнено = ИтогПоМаршруту("ВсеВерно");
	
	Возврат ИтогоВыполнено = всегоШагов;
КонецФункции

&НаКлиенте                                                      
Функция ЗапретитьВыполнение(ТекПользователь)
	
	Если Объект.Ссылка.Пустая() или Объект.Выполнена или не Объект.Отправлена Тогда // запретим выполнение новых, выполненных и черновиков
		возврат истина;
	КонецЕсли;
	
	Если (Объект.Автор <> ТекПользователь или Объект.ПоКомлиниям или ЭтоДоклад) и не ИА_Защита_КЦ.ЭтоМояЗадача(Объект.Ссылка) Тогда // не может выполнить задачу тот, кому она не адресована если он не автор и не по командной линии
		возврат истина;
	КонецЕсли;
	
	Возврат  Ложь;
КонецФункции

&НаКлиенте
Процедура ОбновитьВидимостьКнопок()	
	ЗапретитьВыполнение = ЗапретитьВыполнение(ТекПользователь); // простая проверка на автора или того, кому задача адресована
	МояЗадача = ИА_Защита_КЦ.ЭтоМояЗадача(Объект.Ссылка);
	ЭтоНовый = Объект.Ссылка.Пустая();
	ЭтоМойЧерновик = ЭтоНовый ИЛИ (Объект.Автор = ТекПользователь и не Объект.Отправлена);
	Выполнена = Объект.Выполнена;
	ВыполнениеПоКоманднойЛинии = ЭтоВыполнениеПоКомандЛинии();
	СерединаКоманднойЛинии = ЭтоСерединаКомандЛинии();
	ВозвратАторуВыполненнойЗадачи = ЭтоВозвратПоКомандЛинии();
	ОтклонениеЗРС = Объект.ОтклонениеЗРС;
	ЗРСП = Объект.ЗРСП;
	
	// командная панель
	Элементы.ГруппКнПослание.Видимость = ЭтоПослание;
	Элементы.ГруппКнЗадача_ЗРС.Видимость = ЭтоЗадача или ЭтоЗРС;
	
	Если ЭтоПослание Тогда
		Если Объект.Отправлена Тогда
	        Элементы.ОК.Видимость = Ложь;
			Если не Объект.Выполнена Тогда
				Элементы.ФормаОтветить.Видимость = МояЗадача и (Объект.Пользователь<>Объект.Автор ИЛИ Объект.ЭтоПереписка);
			КонецЕсли;
	    Иначе
	        Элементы.ОК.Видимость = истина;
	        //Элементы.ОК.КнопкаПоУмолчанию = истина;
			Элементы.ФормаОтветить.Видимость = Ложь;
		КонецЕсли;
		
	    Элементы.Прочитано.Видимость = (не Объект.Выполнена) И (не ЭтоНовый) и МояЗадача;
		//Элементы.Прочитано.КнопкаПоУмолчанию = Элементы.Прочитано.Видимость;
	Иначе
		
		// черновик                                                       
		Элементы.ФормаЗаписатьЧерновик.Видимость = ЭтоМойЧерновик и не ЭтоДоклад;
		Элементы.ФормаЗаписатьЗакрыть.Видимость = Объект.Отправлена И не Выполнена;
		
		НоваяОтправка = ТекПользователь = Объект.Автор И (не Объект.Отправлена или ЗРСП) и не Выполнена;
		Элементы.Отправить.Видимость = НоваяОтправка;
		Элементы.ОтправитьПоКомлиниям.Видимость = НоваяОтправка;
		
		// Выполнить
		Элементы.Выполнено.Видимость = не ЗапретитьВыполнение и не ЗРСП;   
		Если Объект.ЭтоЗРС Тогда // по зрс другая схема - одобрено или уже в архив
			Если (ВозвратАторуВыполненнойЗадачи ИЛИ ОтклонениеЗРС ИЛИ не Объект.ПоКомлиниям) И ТекПользователь = Объект.Автор Тогда  // ЗРС вернулась автору
				Элементы.Выполнено.Заголовок = "В архив";
			Иначе
				Элементы.Выполнено.Заголовок = "Одобрено";
			КонецЕсли;
		ИначеЕсли СерединаКоманднойЛинии Тогда // если задача идет по маршруту и это не автор и не конечный исполнитель 
			Элементы.Выполнено.Заголовок = "Всё верно";
		ИначеЕсли ТекПользователь = Объект.Автор Тогда
			Элементы.Выполнено.Заголовок = "Принять";
		КонецЕсли;
		
		Если Объект.ОтказЗадачи Тогда
			Элементы.Выполнено.Заголовок = "В архив";
		ИначеЕсли ЭтоДоклад Тогда
			Если ЗначениеЗаполнено(Объект.Исполнитель) Тогда
				Элементы.Выполнено.Заголовок = "В архив";
			Иначе
				Элементы.Выполнено.Заголовок = "Подтверждено";
			КонецЕсли;
		КонецЕсли;
		
		
		// На доработку
		Элементы.ВернутьНаДоработку.Видимость = (не Выполнена) И (не ЭтоНовый) И МояЗадача
		И (    Объект.Пользователь = Объект.Автор или (ТекПользователь = ОБъект.Пользователь и ОБъект.Пользователь<>Объект.Исполнитель) или ВозвратАторуВыполненнойЗадачи ) 
		И (не Объект.Исполнитель.Пустая()) и не Объект.ЭтоЗРС и не ЭтоДоклад;
		
		// ЗРСП
		Элементы.ЗРСП.Видимость = Объект.ЭтоЗРС И (не Объект.Выполнена) И (не ЭтоНовый) И МояЗадача и ТекПользователь <> Объект.Автор;
		
		// В РАБОТЕ
		Элементы.ВРаботе.Видимость = (не Выполнена) И (не Объект.Отложена) И (не ЭтоНовый) И Объект.Пользователь = ТекПользователь И Объект.Отправлена;
		
		// Удалить
		Элементы.УдалитьЗадачу.Видимость = Объект.Автор = ТекПользователь и не ЭтоНовый и не Выполнена и не ЭтоДоклад;
		
		// Отказаться
		Элементы.Отказаться.Видимость = МояЗадача и не Выполнена И ТекПользователь <> Объект.Автор И Объект.Отправлена;
		Если Объект.ЭтоЗРС Тогда
			Элементы.Отказаться.Заголовок = "Не одобрено";
		ИначеЕсли СерединаКоманднойЛинии Тогда // если задача идет по маршруту и это не автор и не конечный исполнитель 
			Элементы.Отказаться.Заголовок = "Отклонено";
		ИначеЕсли ЭтоДоклад Тогда
			Элементы.Отказаться.Заголовок = "Отклонено";
		КонецЕсли;
		
		Элементы.ВзятьВРаботу.Видимость = Объект.Пользователь.Пустая() и (не Выполнена) И (не ЭтоНовый) И ТекПользователь <> Объект.Автор и МояЗадача;
		Элементы.ПередатьДругомуСотруднику.Видимость = (не Выполнена) И (не ЭтоНовый) И Объект.Пользователь = ТекПользователь и не Объект.ЭтоЗРС И Объект.Отправлена и не ЭтоДоклад;
		Элементы.ОткрытьЗадачуСУ.Видимость = ЭтоДоклад;	
	КонецЕсли;
	
	Элементы.СписокПользователей.Видимость = (ЭтоПослание или ЭтоЗадача) и ЭтоНовый;
	
	СделатьКнопкуОсновной();
КонецПроцедуры

&НаСервере
Процедура СделатьКнопкуОсновной()
	ИА_КСУОбщийСервер.СделатьКнопкуОсновной(Элементы.ГруппаКП_Главная);
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьЗаполнениеРеквизитов(Отказ)
	
	
	// проверка даты исполнения
	// в новой задачи даты еше нет, сравниваем с текущей датой
	Если ЗначениеЗаполнено(Объект.СрокИсполнения) И (Объект.СрокИсполнения<=?(ЗначениеЗаполнено(Объект.Дата), Объект.Дата, ТекущаяДата())) Тогда
		Сообщить("Срок исполнения не может быть раньше, чем дата создания задачи.");
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	Если Объект.Наименование = "" Тогда
		Сообщить("Укажите наименование!");
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	
	// оба реквизита ПОСТ и ПОЛЬЗОВТЕЛЬ не могу быть пустыми
	Если Объект.Пост.Пустая() Тогда
		
		Если ВводСпискаИсполнителей И СписокИсполнителей.Количество()=0 Тогда
			Сообщить("Пост и список сотрудников не могут быть одновременно пустыми. Укажите пост и/или список сотрудников.");
			Отказ = Истина;
			Возврат;
		КонецЕсли;	
		
		Если НЕ ВводСпискаИсполнителей И Объект.Пользователь.Пустая() Тогда
			Сообщить("Пост и сотрудник не могут быть одновременно пустыми. Укажите пост и/или сотрудника.");
			Отказ = Истина;
			Возврат;
		КонецЕсли;	
		
	КонецЕсли;
	
КонецПроцедуры

// Проверяем заполнен ли пост и есть ли у него сотрудники, 
// если сотрудников нет, то по иерархии поднимаемся до ближайшего
// поста с сотрудниками и заменяем текущий пост на заполненный
// 
&НаКлиенте
Процедура ПроверкаПоста()
	
	// проверяем заполнен ли пост и есть ли у него родитель, если что
	Если ЗначениеЗаполнено(Объект.Пост) Тогда
		//
		//КоличествоСотрудников = ПолучитьКоличествоСотрНаПосту(Объект.Пост);
		КоличествоСотрудников = ПолучитьКоличествоПользователейНаПосту(Объект.Пост);
		Родитель = ИА_КСУОбщийСервер.ПолучитьЗначениеРеквизита(Объект.Пост, "Родитель");
		
		Если КоличествоСотрудников = 0 И ЗначениеЗаполнено(Родитель) Тогда
			Объект.Пост = ПолучитьЗанятыйПост(Объект.Пост);
		КонецЕсли; 
		
	КонецЕсли;
	
КонецПроцедуры // ПроверкаПоста()

&НаСервереБезКонтекста
Функция ПолучитьКоличествоПользователейНаПосту(пПост)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ОргСхемаСотрудники.ФизЛицо,
		|	ИА_ДанныеФизЛиц.Пользователь
		|ПОМЕСТИТЬ ВТПостыДанныеФизлиц
		|ИЗ
		|	Справочник.ОргСхема.Сотрудники КАК ОргСхемаСотрудники
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИА_ДанныеФизЛиц КАК ИА_ДанныеФизЛиц
		|		ПО ОргСхемаСотрудники.ФизЛицо = ИА_ДанныеФизЛиц.ФизЛицо
		|ГДЕ
		|	ОргСхемаСотрудники.Ссылка = &Пост
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТПостыДанныеФизлиц.ФизЛицо,
		|	ВТПостыДанныеФизлиц.Пользователь
		|ИЗ
		|	ВТПостыДанныеФизлиц КАК ВТПостыДанныеФизлиц
		|ГДЕ
		|	ВТПостыДанныеФизлиц.Пользователь <> ЗНАЧЕНИЕ(Справочник.Пользователи.ПустаяСсылка)
		|	И НЕ ВТПостыДанныеФизлиц.Пользователь ЕСТЬ NULL 
		|
		|СГРУППИРОВАТЬ ПО
		|	ВТПостыДанныеФизлиц.ФизЛицо,
		|	ВТПостыДанныеФизлиц.Пользователь";
			
	Запрос.УстановитьПараметр("Пост", пПост);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Возврат ВыборкаДетальныеЗаписи.Количество();
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьЗанятыйПост(Пост)
	
	ТекПост = Пост;
	Пока Истина Цикл //поднимаемся вверх до поста, который будет заполнен или до упора
		Если ПолучитьКоличествоПользователейНаПосту(ТекПост) = 0 И
			ЗначениеЗаполнено(ТекПост.Родитель) Тогда
			ТекПост = ТекПост.Родитель;
		Иначе  // останавливаемся как только пост заполнен 
			Сообщить("Пост изменен на вышестоящий занятый по иерархии", СтатусСообщения.Информация);
			Прервать;
		КонецЕсли;	
	КонецЦикла;
	
	Возврат ТекПост;
	
КонецФункции

&НаСервере
Функция  НапечататьДокумент()
	
	Если ЭтоЗРС Тогда
		ТабДок = РеквизитФормыВЗначение("Объект").ПечатьЗРС();
	ИначеЕсли  ЭтоЗадача Тогда
		ТабДок = РеквизитФормыВЗначение("Объект").ПечатьЗадачи();
	Иначе
		ТабДок = РеквизитФормыВЗначение("Объект").ПечатьПослания();
	КонецЕсли;
	
	Возврат ТабДок;
	
КонецФункции

