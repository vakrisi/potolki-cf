&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	Если НовыйКоммент <> "" Тогда
		Новстр = ТекущийОбъект.ХодВыполнения.Добавить();
		Новстр.Дата = ТекущаяДата();
		Новстр.Пользователь = ТекПользователь;
		Новстр.Комментарий = НовыйКоммент;
		Новстр.ЭтоКомментарий = Истина;
		
		Элементы.ГруппаНовыйКоммент.Видимость = Ложь;
		//
		Если ТекПользователь <>  Объект.Автор Тогда
			ИА_ОбщиеПроцедуры_Технология_КоммЦентр.СоздатьУведомление(Объект.Ссылка, Объект.Автор, ПредопределенноеЗначение("Перечисление.ИА_ВидСобытия.НовыйКомментарий"), НовыйКоммент);
		КонецЕсли;
		
		НовыйКоммент = "";

	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии()
	Парам = Новый Структура("Ссылка,ВладелецФормы,ПоКомлиниям,Пост");
	ЗаполнитьЗначенияСвойств(Парам,Объект);
	Парам.ВладелецФормы = ВладелецФормы;
	
	Оповестить("ЗакрытиеЗадачиБП",Парам);
	Если ИА_БФКС.РеквизитЕсть(Объект, "БизнесПроцесс") Тогда
		Оповестить("ОбновитьКарты", Объект["БизнесПроцесс"]);	
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	Если ЗавершениеРаботы и СписокДобавленныхФайлов.Количество()>0 Тогда
		ТекстПредупреждения = "Сначала закройте задачу";
		отказ = Истина;
	ИначеЕсли не ЗавершениеРаботы Тогда
		УдаляемСписокФайловСервер(СписокДобавленныхФайлов);
	КонецЕсли;
КонецПроцедуры


&НаСервереБезКонтекста
Процедура УдаляемСписокФайловСервер(СписокДобавленныхФайлов)
	
	// удаляем лишние файлы, если они есть несохраненные
	Для каждого с из СписокДобавленныхФайлов Цикл
		УдалитьФайлы(с.Значение);
	КонецЦикла;	
	
КонецПроцедуры 

&НаСервере
Процедура УстановитьНомер()
	Если НЕ ЗначениеЗаполнено(Объект.Номер) Тогда
		об = РеквизитФормыВЗначение("Объект");
		об.УстановитьНовыйНомер();
		ЗначениеВРеквизитФормы(об, "Объект");
	КонецЕсли; 
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	ПроверитьЗаполнениеРеквизитов(Отказ);
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
		
	
	Если ВводСпискаИсполнителей Тогда
        Объект.Пользователь = СписокИсполнителей[0].Значение; 
    КонецЕсли;
			
    БП_ЗаписатьСвязанныеДанные();
КонецПроцедуры

&НаСервере
Процедура СоздатьЗадачуПоСпискуИсполнителей(Исполнитель)
    
    НоваяЗадача = Задачи.ИА_ЗадачаПланаДействий.СоздатьЗадачу();
    ЗаполнитьЗначенияСвойств(НоваяЗадача, Объект,,"Номер");
    НоваяЗадача.Пользователь 	= Исполнитель;
    НоваяЗадача.Файлы.Загрузить(Объект.Файлы.Выгрузить());
    НоваяЗадача.Записать();
    
    // перенесем файлы
    КаталогХранения = Константы.ИА_КаталогХраненияФайлов.Получить();
    КаталогХраненияИсх = КаталогХранения + СОКРЛП(Объект.Номер) + "\";
    папка = Новый Файл(КаталогХраненияИсх);
    
    Если папка.Существует() Тогда
        КаталогХраненияРез = КаталогХранения + СОКРЛП(НоваяЗадача.Номер) + "\";
        СоздатьКаталог(КаталогХраненияРез);
        
        МассивКопируемыхФайлов = НайтиФайлы(КаталогХраненияИсх, "*");
        
        Для каждого ФайлИзМассива из МассивКопируемыхФайлов Цикл
            КопироватьФайл(ФайлИзМассива.ПолноеИмя, КаталогХраненияРез + ФайлИзМассива.Имя)
        КонецЦикла;
    КонецЕсли;
    
    
КонецПроцедуры

