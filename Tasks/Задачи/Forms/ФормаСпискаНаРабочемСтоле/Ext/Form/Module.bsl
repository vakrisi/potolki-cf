Процедура ФильтрАвторПриИзменении(Элемент)
	
	УстановитьОтборыДинамическогоСписка();
	
КонецПроцедуры

&НаКлиенте
Процедура ФильтрИсполнительПриИзменении(Элемент)
	
	УстановитьОтборыДинамическогоСписка();
	
КонецПроцедуры

&НаКлиенте
Процедура ФильтрТочкаПродажПриИзменении(Элемент)
	
	УстановитьОтборыДинамическогоСписка();
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьОтборыДинамическогоСписка()
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(СписокВсе, "Автор", 	  ФильтрАвтор, 		 ВидСравненияКомпоновкиДанных.Равно,, НЕ ФильтрАвтор.Пустая());
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(СписокВсе, "Исполнитель", ФильтрИсполнитель, ВидСравненияКомпоновкиДанных.Равно,, НЕ ФильтрИсполнитель.Пустая());
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(СписокВсе, "ТочкаПродаж", ФильтрТочкаПродаж, ВидСравненияКомпоновкиДанных.Равно,, НЕ ФильтрТочкаПродаж.Пустая());
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "Запись_Задание" Тогда
		Элементы.Список.Обновить();
		Элементы.СписокВсе.Обновить();
		Элементы.СписокЗаданияОтМеня.Обновить();
	КонецЕсли;
	
КонецПроцедуры
