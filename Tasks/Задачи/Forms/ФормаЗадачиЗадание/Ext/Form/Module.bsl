&НаКлиенте
Процедура ОбработкаАктивации()
	Объект.ПринятВРаботу = Истина;
	Объект.ДатаНачалаИсполнения = ТекущаяДата();
	Записать();
КонецПроцедуры

&НаКлиенте
Процедура ВернутьИсполнителю(Команда)
	Объект.ПодтвержденаПроверка = Ложь;
	Записать();
	ВернутьИсполнителюНаСервере();	
	Закрыть();
КонецПроцедуры

&НаСервере
Процедура ВернутьИсполнителюНаСервере()
	Объект.Ссылка.ПолучитьОбъект().ВыполнитьЗадачу();
КонецПроцедуры

&НаСервере
Функция ПриОткрытииНаСервере()
	Если не Объект.ПринятВРаботу Тогда 
		Если Объект.ТочкаМаршрута.Имя = "Выполнить" и Объект.Исполнитель = ПараметрыСеанса.ТекущийПользователь Тогда 
			Объект.ПринятВРаботу = Истина;
			Объект.ДатаНачалаИсполнения = ТекущаяДатаСеанса();
		ИначеЕсли Объект.ТочкаМаршрута.Имя = "Проверить" и Объект.Проверяющий = ПараметрыСеанса.ТекущийПользователь Тогда 
			Объект.ПринятВРаботу = Истина;
			Объект.ДатаНачалаИсполнения = ТекущаяДатаСеанса();
		КонецЕсли;	
	КонецЕсли;
	Возврат Истина;
КонецФункции

