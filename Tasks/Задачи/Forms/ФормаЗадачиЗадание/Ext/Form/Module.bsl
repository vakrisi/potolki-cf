
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если НЕ Объект.БизнесПроцесс.Пустая() Тогда 
		Карта = Объект.БизнесПроцесс.Ссылка.ПолучитьОбъект().ПолучитьКартуМаршрута();
	КонецЕсли;
	
	Элементы.РезультатИсполнения.ТолькоПросмотр = ?(Объект.ТочкаМаршрута.Имя = "Выполнить", Ложь, Истина);
	
	Если Объект.ТочкаМаршрута.Имя = "Проверить" Тогда 
		Если Объект.Автор = ПараметрыСеанса.ТекущийПользователь или Объект.Проверяющий = ПараметрыСеанса.ТекущийПользователь Тогда 
			Элементы.РезультатПроверки.ТолькоПросмотр = Ложь;
			Элементы.ФормаВыполнитьИЗакрыть.Заголовок = "Принято, закрыть"; 
		Иначе
			Элементы.ФормаВыполнитьИЗакрыть.Доступность = Ложь;
			Элементы.ФормаАктивировать.Видимость = Ложь;
			Элементы.ФормаПеренаправить.Видимость = Ложь;
			Элементы.ФормаОтменено.Видимость = Ложь;
		КонецЕсли;
	Иначе
		Если не Объект.Автор = Пользователи.ТекущийПользователь() Тогда 					
			Элементы.ФормаОтменено.Видимость = Ложь;
		КонецЕсли;
		Элементы.РезультатПроверки.ТолькоПросмотр = Истина;	
		Элементы.ФормаВернутьИсполнителю.Видимость = Ложь;
	КонецЕсли;	
	
	//Элементы.ИзменитьЗадание.Видимость = (Объект.Автор = ПараметрыСеанса.ТекущийПользователь);	
	Если Объект.Ссылка.Пустая() Тогда
		ИнициализацияФормы();
	КонецЕсли;
	
	ЗаданиеОтменено = Ложь;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если ЗначениеЗаполнено(Объект.Ссылка) И ПриОткрытииНаСервере() Тогда 
		Записать();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	ИнициализацияФормы();
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	ВыполнитьЗадачу = Ложь;
	Если НЕ (ПараметрыЗаписи.Свойство("ВыполнитьЗадачу", ВыполнитьЗадачу) И ВыполнитьЗадачу) Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ ЗаданиеВыполнено И НЕ ЗначениеЗаполнено(ТекущийОбъект.РезультатИсполнения) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			НСтр("ru = 'Укажите причину, по которой задача отклоняется.'"),,
			"Объект.РезультатИсполнения",,
			Отказ);
		Возврат;
	КонецЕсли;
	
	// Запись объекта бизнес-процесса.
	УстановитьПривилегированныйРежим(Истина);
	ЗаданиеОбъект = ТекущийОбъект.БизнесПроцесс.ПолучитьОбъект();
	ЗаблокироватьДанныеДляРедактирования(ЗаданиеОбъект.Ссылка);
	ЗаданиеОбъект.Отменено = ЗаданиеОтменено;
	ЗаданиеОбъект.Записать();

КонецПроцедуры

#КонецОбласти

