&НаКлиенте
Процедура ПеренаправитьЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если НЕ ТипЗнч(Результат) = Тип("Структура") Тогда
		Возврат;
	КонецЕсли; 
	
	Если ПеренаправитьНаСервере(Результат) Тогда
		Записать();	
		Закрыть();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Перенаправить(Команда)
	
	//Сотрудник = ПолучитьПустогоСотрудника();
	//ОП = новый ОписаниеОповещения("ПеренаправитьЗавершение",Этаформа);
	//ПоказатьВводЗначения(ОП,Сотрудник);
	
	ТолькоИсполнитель = (Объект.ТочкаМаршрута = ПредопределенноеЗначение("БизнесПроцесс.Задание.ТочкаМаршрута.Проверить"));    
	
	МассивЗадач = Новый Массив;
	МассивЗадач.Добавить(Объект.Ссылка);
	
	ПараметрыФормы = Новый Структура("Задача,КоличествоЗадач,ЗаголовокФормы,ТолькоИсполнитель", 
		МассивЗадач[0], МассивЗадач.Количество(), 
		?(МассивЗадач.Количество() > 1, НСтр("ru = 'Перенаправить задачи'"), 
			НСтр("ru = 'Перенаправить задачу'")), ТолькоИсполнитель);
			
	Оповещение = Новый ОписаниеОповещения("ПеренаправитьЗавершение", ЭтотОбъект);
	ОткрытьФорму("Задача.Задачи.Форма.ПеренаправитьЗадачи", ПараметрыФормы, ЭтотОбъект,,,,Оповещение);
		
КонецПроцедуры

&НаСервере
Функция ПеренаправитьНаСервере(ВыбЗнач)
	
	Попытка
		Если Объект.ТочкаМаршрута = ПредопределенноеЗначение("БизнесПроцесс.Задание.ТочкаМаршрута.Выполнить") Тогда
			Объект.Исполнитель = ВыбЗнач.Исполнитель;
			Объект.РольИсполнителя = ВыбЗнач.РольИсполнителя;
			//Объект.Ответственный = ВыбЗнач;
			Исполнитель = ?(ЗначениеЗаполнено(Объект.Исполнитель), Объект.Исполнитель, Объект.РольИсполнителя);
			Текст = Формат(ТекущаяДатаСеанса(),"ДЛФ=DDT") + " " + ПараметрыСеанса.ТекущийПользователь + " назначил(а) нового исполнителя: " + Исполнитель;
			
		ИначеЕсли Объект.ТочкаМаршрута = ПредопределенноеЗначение("БизнесПроцесс.Задание.ТочкаМаршрута.Проверить") Тогда
			Объект.Проверяющий = ВыбЗнач.Исполнитель;
			//Объект.Ответственный = ВыбЗнач;
			Текст = Формат(ТекущаяДатаСеанса(),"ДЛФ=DDT") + " " + ПараметрыСеанса.ТекущийПользователь + " назначил(а) нового проверяющего: " + Объект.Проверяющий;
		КонецЕсли;
		
		Объект.ИсторияВыполнения = Объект.ИсторияВыполнения + "
		|" + Текст + "
		|";
		БП = Объект.БизнесПроцесс.Ссылка.ПолучитьОбъект();
		БП.ИсторияВыполнения = БП.ИсторияВыполнения +"
		|" + Текст + "
		|";
		БП.Записать();
		
		//запись в регистр напоминаний
		Если Объект.ТочкаМаршрута = ПредопределенноеЗначение("БизнесПроцесс.Задание.ТочкаМаршрута.Выполнить") Тогда
			НаборДанных = РегистрыСведений.УведомленияОНовыхЗадачах.СоздатьНаборЗаписей();
			//НаборДанных.Отбор.Ответственный.Установить(Объект.Ответственный);
			НаборДанных.Отбор.Задача.Установить(Объект.Ссылка);
			НаборДанных.Прочитать();
			НаборДанных.Очистить();
		
			//Движение = НаборДанных.Добавить();
			//Движение.Период = ТекущаяДатаСеанса();
			//Движение.Исполнитель = Объект.Ответственный;
			//Движение.Задача = Объект.Ссылка;
			//Движение.УДАЛИТЬ_Количество = 1;
			
			Если ЗначениеЗаполнено(Объект.РольИсполнителя) Тогда
				НаборИсполнителей = РегистрыСведений.ИсполнителиЗадач.СоздатьНаборЗаписей();
				НаборИсполнителей.Отбор.РольИсполнителя.Установить(Объект.РольИсполнителя);
				НаборИсполнителей.Прочитать();
				Для каждого ИсполнительРоли из НаборИсполнителей Цикл
					Движение = НаборДанных.Добавить();
					Движение.Период = ТекущаяДатаСеанса();
					Движение.Исполнитель = ИсполнительРоли.Исполнитель;
					Движение.Задача = Объект.Ссылка;
				КонецЦикла;
			ИначеЕсли ЗначениеЗаполнено(Объект.Исполнитель) Тогда
				Движение = НаборДанных.Добавить();
				Движение.Период = ТекущаяДатаСеанса();
				Движение.Исполнитель = Объект.Исполнитель;
				Движение.Задача = Объект.Ссылка;
			КонецЕсли;
			
			НаборДанных.Записать();
		КонецЕсли;
		
		Возврат Истина;
	Исключение
		Сообщить ("Переназначить задачу не удалось");
		Возврат Ложь;
	КонецПопытки;
	
КонецФункции

&НаКлиенте
Процедура ИзменитьЗадание(Команда)
	
	Записать();
	ПоказатьЗначение(,Объект.БизнесПроцесс);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "Запись_Задание" Тогда
		Если Источник = Объект.БизнесПроцесс Тогда
			Прочитать();
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура Отменено(Команда)
	
	ЗаданиеВыполнено = Ложь;
	ЗаданиеОтменено  = Истина;
	Если НЕ Записать(Новый Структура("ВыполнитьЗадачу", Истина)) Тогда
		Возврат;
	КонецЕсли;
	
	ПоказатьОповещениеПользователя("Задача отменена",
		ПолучитьНавигационнуюСсылку(Объект.Ссылка),
		Строка(Объект.Ссылка),
		БиблиотекаКартинок.Информация32);
	Закрыть();
	
КонецПроцедуры



