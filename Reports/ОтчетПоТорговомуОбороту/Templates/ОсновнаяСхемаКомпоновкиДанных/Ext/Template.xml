////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗРЕШЕННЫЕ
	ЗаказПокупателя.Организация КАК Организация,
	ЗаказПокупателя.Подразделение КАК Подразделение,
	НАЧАЛОПЕРИОДА(ЗаказПокупателя.Дата, ДЕНЬ) КАК Период,
	ЗаказПокупателя.СуммаДокумента КАК Сумма,
	ЗаказПокупателя.Ссылка КАК Регистратор,
	ЗаказПокупателя.Контрагент КАК Контрагент
ПОМЕСТИТЬ ВТ_Заказы
ИЗ
	Документ.ЗаказПокупателя КАК ЗаказПокупателя
ГДЕ
	(ЗаказПокупателя.ТекущийСтатус = ЗНАЧЕНИЕ(Справочник.СтатусыЗаказовПокупателей.ВРаботе)
			ИЛИ ЗаказПокупателя.ТекущийСтатус = ЗНАЧЕНИЕ(Справочник.СтатусыЗаказовПокупателей.Выполнен))
;

////////////////////////////////////////////////////////////////////////////////
