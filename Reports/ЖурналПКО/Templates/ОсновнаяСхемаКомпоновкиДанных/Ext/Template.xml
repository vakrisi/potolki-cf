			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Документ</v8:content>
				</v8:item>
			</title>
			<role>
				<dcscom:required>true</dcscom:required>
			</role>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ОснованиеСсылка</dataPath>
			<field>ОснованиеСсылка</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Основание</v8:content>
				</v8:item>
			</title>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ РАЗРЕШЕННЫЕ
	ДанныеДокумента.Ссылка КАК Ссылка,
	ОснованияДокумента.Основание КАК ОснованиеСсылка
ИЗ
	Документ.ПриходныйКассовыйОрдер КАК ДанныеДокумента
		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПриходныйКассовыйОрдер.Основания КАК ОснованияДокумента
		ПО ДанныеДокумента.Ссылка = ОснованияДокумента.Ссылка
ГДЕ
	ДанныеДокумента.Проведен
{ГДЕ
	(ВЫБОР
			КОГДА НЕ &amp;НачалоПериода = ДАТАВРЕМЯ(1, 1, 1)
				ТОГДА ДанныеДокумента.Дата &gt;= &amp;НачалоПериода
			ИНАЧЕ ИСТИНА
		КОНЕЦ),
	(ВЫБОР
			КОГДА НЕ &amp;КонецПериода = ДАТАВРЕМЯ(1, 1, 1)
				ТОГДА ДанныеДокумента.Дата &lt;= КОНЕЦПЕРИОДА(&amp;КонецПериода, ДЕНЬ)
			ИНАЧЕ ИСТИНА
		КОНЕЦ),
	(ВЫБОР
			КОГДА &amp;ВидОснования = "Пустое"
				ТОГДА ОснованияДокумента.Основание ЕСТЬ NULL
						ИЛИ ОснованияДокумента.Основание.Ссылка ЕСТЬ NULL
			КОГДА &amp;ВидОснования = "РеализацияТоваровИУслуг"
				ТОГДА ОснованияДокумента.Основание ССЫЛКА Документ.РеализацияТоваровИУслуг
						И НЕ ОснованияДокумента.Основание.Ссылка ЕСТЬ NULL
			КОГДА &amp;ВидОснования = "Монтаж"
				ТОГДА ОснованияДокумента.Основание ССЫЛКА Документ.Монтаж
						И НЕ ОснованияДокумента.Основание.Ссылка ЕСТЬ NULL
			КОГДА &amp;ВидОснования = "ЗаказПоставщику"
				ТОГДА ОснованияДокумента.Основание ССЫЛКА Документ.ЗаказПоставщику
						И НЕ ОснованияДокумента.Основание.Ссылка ЕСТЬ NULL
			КОГДА &amp;ВидОснования = "ЗаказПокупателя"
				ТОГДА ОснованияДокумента.Основание ССЫЛКА Документ.ЗаказПокупателя
						И НЕ ОснованияДокумента.Основание.Ссылка ЕСТЬ NULL
			КОГДА &amp;ВидОснования = "ЗаказДоговор"
				ТОГДА ОснованияДокумента.Основание ССЫЛКА Документ.ЗаказДоговор
						И НЕ ОснованияДокумента.Основание.Ссылка ЕСТЬ NULL
			КОГДА &amp;ВидОснования = "РасходныйКассовыйОрдер"
				ТОГДА ОснованияДокумента.Основание ССЫЛКА Документ.РасходныйКассовыйОрдер
						И НЕ ОснованияДокумента.Основание.Ссылка ЕСТЬ NULL
			КОГДА &amp;ВидОснования = "СчетНаОплату"
				ТОГДА ОснованияДокумента.Основание ССЫЛКА Документ.СчетНаОплату
						И НЕ ОснованияДокумента.Основание.Ссылка ЕСТЬ NULL
			КОГДА &amp;ВидОснования = "Замена"
				ТОГДА ОснованияДокумента.Основание ССЫЛКА Документ.Замена
						И НЕ ОснованияДокумента.Основание.Ссылка ЕСТЬ NULL
			КОГДА &amp;ВидОснования = "ЗаявкаНаДоставку"
				ТОГДА ОснованияДокумента.Основание ССЫЛКА Документ.ЗаявкаНаДоставку
						И НЕ ОснованияДокумента.Основание.Ссылка ЕСТЬ NULL
			ИНАЧЕ ИСТИНА
		КОНЕЦ)}</query>
	</dataSet>
