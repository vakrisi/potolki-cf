		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ РАЗРЕШЕННЫЕ
	Замеры.Дата КАК ДатаЗамера,
		Замеры.ВремяНачала КАК ВремяЗамера,
	Замеры.ВремяОкончания КАК ВремяОкончания,
	Замеры.ДокументЗамер КАК ДокументЗамер,
	Замеры.ТочкаПродаж КАК ТочкаПродаж,
	Замеры.НазначилЗамер КАК НазначилЗамер,
	Замеры.Сотрудник КАК Замерщик,
	Замеры.Регистратор КАК Регистратор,
	ВЫБОР
		КОГДА Замеры.Город = ЗНАЧЕНИЕ(Справочник.Города.ПустаяСсылка)
			ТОГДА Замеры.Адрес
		ИНАЧЕ ВЫБОР
				КОГДА Замеры.Адрес = ""
					ТОГДА Замеры.Город.Наименование
				ИНАЧЕ Замеры.Город.Наименование + ", " + Замеры.Адрес
			КОНЕЦ
	КОНЕЦ КАК ПолныйАдрес,
	Замеры.ИмяКлиента КАК Клиент,
	Замеры.Комментарий КАК Комментарий,
	Замеры.Город КАК Город,
	Замеры.ЗамерВыполнен КАК ЗамерВыполнен,
	Замеры.КомментарийЗамерщика КАК КомментарийЗамерщика,
	Замеры.Результат КАК Результат,
	Замеры.СуммаДоговора КАК СуммаДоговора,
	Замеры.ТелефонКлиента КАК ТелефонКлиента,
	Замеры.ПричинаОтказа КАК ПричинаОтказа,
	Замеры.ЭтоВыезд КАК ЭтоВыезд,
	Замеры.ДатаНазначенияЗамера КАК ДатаНазначенияЗамера
ИЗ
	РегистрСведений.Замеры КАК Замеры
ГДЕ
	//++ №12136
	ВЫБОР
		КОГДА &amp;ИспользоватьОтборПоСотруднику
			ТОГДА Замеры.Сотрудник = &amp;ОтборСотрудник
		ИНАЧЕ ИСТИНА
	КОНЕЦ
	//-- №12136
{ГДЕ
	ВЫБОР
		КОГДА &amp;ВариантПериода = 2
			ТОГДА Замеры.ДатаНазначенияЗамера &gt;= &amp;НачалоПериода
		ИНАЧЕ Замеры.Дата &gt;= &amp;НачалоПериода
	КОНЕЦ,
	ВЫБОР
		КОГДА &amp;ВариантПериода = 2
			ТОГДА Замеры.ДатаНазначенияЗамера &lt;= &amp;КонецПериода
		ИНАЧЕ Замеры.Дата &lt;= &amp;КонецПериода
	КОНЕЦ}</query>
