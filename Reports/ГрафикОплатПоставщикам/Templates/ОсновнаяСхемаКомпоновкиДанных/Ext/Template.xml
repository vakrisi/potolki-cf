		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	ЗаказПоставщику.Контрагент КАК Поставщик,
	ЗаказПоставщику.Ссылка КАК Заказ,
	ЗаказПоставщику.СрокОплатыC КАК ДатаОплаты,
	ЗаказПоставщику.СуммаДокумента КАК СуммаЗаказа,
	ЗаказПоставщику.Валюта КАК Валюта,
	ЗаказПоставщику.СтатусОплаты КАК СтатусОплаты,
	ЗаказПоставщику.Организация КАК Организация,
	ЗаказПоставщику.Подразделение КАК Подразделение,
	ЗаказПоставщику.Склад КАК Склад
ПОМЕСТИТЬ ВТПлан
ИЗ
	Документ.ЗаказПоставщику КАК ЗаказПоставщику
ГДЕ
	ЗаказПоставщику.Проведен
	И ЗаказПоставщику.ТекущийСтатус В (
			ЗНАЧЕНИЕ(Справочник.СтатусыЗаказовПоставщику.Новый),
			ЗНАЧЕНИЕ(Справочник.СтатусыЗаказовПоставщику.ВРаботе),
			ЗНАЧЕНИЕ(Справочник.СтатусыЗаказовПоставщику.Выполнен))
	И (ЗаказПоставщику.СтатусОплаты = &amp;СтатусОплаты
			ИЛИ &amp;СтатусОплаты = ЗНАЧЕНИЕ(Справочник.СтатусыОплаты.ПустаяСсылка))
	И ЗаказПоставщику.СрокОплатыC МЕЖДУ &amp;ДатаНачалаПериода И &amp;ДатаОкончанияПериода
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ЗаказПоставщику.Контрагент КАК Поставщик,
	КОЛИЧЕСТВО(ЗаказПоставщику.Ссылка) КАК ПросроченоЗаказов,
	СУММА(ЗаказПоставщику.СуммаДокумента) КАК ПросроченоСумма
ПОМЕСТИТЬ ВТПросрочка
ИЗ
	Документ.ЗаказПоставщику КАК ЗаказПоставщику
ГДЕ
	ЗаказПоставщику.Проведен
	И ЗаказПоставщику.ТекущийСтатус В (
			ЗНАЧЕНИЕ(Справочник.СтатусыЗаказовПоставщику.Новый),
			ЗНАЧЕНИЕ(Справочник.СтатусыЗаказовПоставщику.ВРаботе),
			ЗНАЧЕНИЕ(Справочник.СтатусыЗаказовПоставщику.Выполнен))
	И (ЗаказПоставщику.СтатусОплаты = &amp;СтатусОплаты
			ИЛИ &amp;СтатусОплаты = ЗНАЧЕНИЕ(Справочник.СтатусыОплаты.ПустаяСсылка))
	И ЗаказПоставщику.СрокОплатыC &lt;&gt; ДАТАВРЕМЯ(1, 1, 1)
	И ЗаказПоставщику.СрокОплатыC &lt; &amp;ДатаНачалаПериода
СГРУППИРОВАТЬ ПО
	ЗаказПоставщику.Контрагент
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ВТПлан.Поставщик КАК Поставщик
ПОМЕСТИТЬ ВТПоставщики
ИЗ
	ВТПлан КАК ВТПлан

ОБЪЕДИНИТЬ

ВЫБРАТЬ
	ВТПросрочка.Поставщик
ИЗ
	ВТПросрочка КАК ВТПросрочка
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ВТПоставщики.Поставщик КАК Поставщик,
	ВЫРАЗИТЬ(ВТПоставщики.Поставщик.Дополнительно КАК СТРОКА(100)) КАК СрокОплатыПоставщика,
	ЕСТЬNULL(ВТПросрочка.ПросроченоЗаказов, 0) КАК ПросроченоЗаказов,
	ЕСТЬNULL(ВТПросрочка.ПросроченоСумма, 0) КАК ПросроченоСумма,
	ВТПлан.Заказ КАК Заказ,
	ВТПлан.ДатаОплаты КАК ДатаОплаты,
	ЕСТЬNULL(ВТПлан.СуммаЗаказа, 0) КАК СуммаПлановая,
	ВЫБОР
		КОГДА ВТПлан.Заказ ЕСТЬ NULL
			ТОГДА 0
		ИНАЧЕ 1
	КОНЕЦ КАК КоличествоПлановое,
	ВТПлан.Валюта КАК Валюта,
	ВТПлан.СтатусОплаты КАК СтатусОплаты,
	ВТПлан.Организация КАК Организация,
	ВТПлан.Подразделение КАК Подразделение,
	ВТПлан.Склад КАК Склад
ИЗ
	ВТПоставщики КАК ВТПоставщики
		ЛЕВОЕ СОЕДИНЕНИЕ ВТПлан КАК ВТПлан
		ПО ВТПлан.Поставщик = ВТПоставщики.Поставщик
		ЛЕВОЕ СОЕДИНЕНИЕ ВТПросрочка КАК ВТПросрочка
		ПО ВТПросрочка.Поставщик = ВТПоставщики.Поставщик</query>
	</dataSet>
	<totalField>
		<dataPath>КоличествоПлановое</dataPath>
		<expression>Сумма(КоличествоПлановое)</expression>
	</totalField>
