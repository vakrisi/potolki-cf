&НаКлиенте
Процедура ТабДокОбработкаРасшифровки(Элемент, Расшифровка, СтандартнаяОбработка, ДополнительныеПараметры)
	если ТипЗнч(Расшифровка) = тип("Массив") Тогда
		СтандартнаяОбработка = ложь;
		
		сп = Новый СписокЗначений;
		сп.ЗагрузитьЗначения(Расшифровка);
		
		ОпОп = новый ОписаниеОповещения("ВыборРег", ЭтотОбъект);
		ПоказатьВыборИзСписка(ОпОп, сп);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ВыборРег(ВыбЗн, дп) Экспорт
	если ВыбЗн<>Неопределено Тогда
		ПоказатьЗначение(, ВыбЗн.Значение);
	КонецЕсли;
КонецПроцедуры

