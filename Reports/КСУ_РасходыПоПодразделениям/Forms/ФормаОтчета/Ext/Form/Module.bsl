&НаСервере
Процедура ЗаполнитьНастройки()
	НаДату = ТекущаяДата();
	
	НовстрН = Настройки.Добавить();
	НовстрН.Настройка = "Показывать сводные";
	НовстрН.Выбрать = истина;
	
	НовстрН = Настройки.Добавить();
	НовстрН.Настройка = "Показывать детализацию";
	НовстрН.Выбрать = истина;

	
	//
	МассОрг = ИА_ФПСервер.ПолучитьОрганизацииДляОтчетов();
	Для каждого орг из МассОрг Цикл
		НовстрН = Организации.Добавить();
		НовстрН.Организация = орг;
		НовстрН.Выбрать = истина;
	КонецЦикла;
	Если не Константы.ИА_ФП_ВестиФППоОрганизациям.Получить() Тогда
		НовстрН = Организации.Добавить();
		НовстрН.Организация = Справочники.Организации.ПустаяСсылка();
		НовстрН.Выбрать = истина;
	КонецЕсли;
	
	//
	Выборка= Справочники.ИА_ЦФО.Выбрать(,,,"Наименование");
	Пока выборка.Следующий() Цикл
		Если не выборка.ПометкаУдаления Тогда
			НовстрН = Подразделения.Добавить();
			НовстрН.Подразделение = выборка.Ссылка;
			НовстрН.Выбрать = истина;		
		КонецЕсли;
	КонецЦикла;
	НовстрН = Подразделения.Добавить();
	НовстрН.Подразделение = Справочники.ИА_ЦФО.ПустаяСсылка();
	НовстрН.Выбрать = истина;		
	
	//
	ЭтоРСФ = ИА_ФП.ЭтоРСФ();
	Выборка= Справочники.ИА_Фонды.Выбрать(,,,"Наименование");
	Пока выборка.Следующий() Цикл
		Если не выборка.ПометкаУдаления Тогда
			Если ЭтоРСФ или выборка.Защищенный = ложь Тогда
				НовстрН = Фонды.Добавить();
				НовстрН.Фонд = Выборка.Ссылка;
				НовстрН.Выбрать = истина;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	//
	Выборка= Справочники.КСУ_СтатьиРасходов.Выбрать(,,,"Наименование");
	Пока выборка.Следующий() Цикл
		Если не выборка.ПометкаУдаления Тогда
			НовстрН = Статьи.Добавить();
			НовстрН.Статья = Выборка.Ссылка;
			НовстрН.Выбрать = истина;
		КонецЕсли;
	КонецЦикла;
	НовстрН = Статьи.Добавить();
	НовстрН.Статья = Справочники.КСУ_СтатьиРасходов.ПустаяСсылка();
	НовстрН.Выбрать = истина;		

КонецПроцедуры

&НаСервере
Процедура СформироватьНаСервере()
	
	ТабДок.Очистить();
	
	отч = РеквизитФормыВЗначение("Отчет");
	макет = отч.ПолучитьМакет("Макет");
	
	Обл = макет.ПолучитьОбласть("Шапка");
	ТекДата = ТекущаяДата();
	обл.параметры.ДатаОтчета = ТекДата;
	обл.параметры.Период = формат(ДатаНачала,"ДФ=dd.MM.yyyy") + " - " + формат(ДатаКонца,"ДФ=dd.MM.yyyy");
	ТабДок.Вывести(обл);
	
	ЕстьФильтры = ложь;
	ВыбФонды = Новый массив;
	Для каждого стр из Фонды Цикл
		Если стр.выбрать Тогда
			ВыбФонды.Добавить(стр.фонд);
		Иначе
			ЕстьФильтры = Истина;
		КонецЕсли;
	КонецЦикла;
	
	ВыбПодр = Новый массив;
	Для каждого стр из Подразделения Цикл
		Если стр.выбрать Тогда
			ВыбПодр.Добавить(стр.Подразделение);
		Иначе
			ЕстьФильтры = Истина;
		КонецЕсли;
	КонецЦикла;
	
	ВыбОрг = Новый массив;
	Для каждого стр из Организации Цикл
		Если стр.выбрать Тогда
			ВыбОрг.Добавить(стр.Организация);
		Иначе
			ЕстьФильтры = Истина;
		КонецЕсли;
	КонецЦикла;
	
	ВыбСтатьи = Новый массив;
	Для каждого стр из статьи Цикл
		Если стр.выбрать Тогда
			ВыбСтатьи.Добавить(стр.Статья);
		Иначе
			ЕстьФильтры = Истина;
		КонецЕсли;
	КонецЦикла;
	
	ЧтоТоВыбрано = ложь;
	Для сч =1 по Настройки.Количество() - 1 Цикл
		если Настройки[сч].Выбрать Тогда
			ЧтоТоВыбрано = истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	////////////////////////////////////////////////////////
	
	Если ЕстьФильтры Тогда
		Обл = макет.ПолучитьОбласть("Фильтры");		
		ТабДок.Вывести(обл);
	КонецЕсли;
	
	///////////////////////////////////////////////////////////////////////////	
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДатаНачала", ДатаНачала);
	Запрос.УстановитьПараметр("ДатаКонца", КонецДня(ДатаКонца));
	Запрос.УстановитьПараметр("Фонды", ВыбФонды);
	Запрос.УстановитьПараметр("Подразделения", ВыбПодр);
	Запрос.УстановитьПараметр("Организации", ВыбОрг);
	Запрос.УстановитьПараметр("Статьи", ВыбСтатьи);
	Запрос.УстановитьПараметр("СтатусРассмотретьНаФП", Перечисления.ИА_СостояниеЗаказа.РассмотретьНаФП);
	Запрос.УстановитьПараметр("СтатусНаСледФП", Перечисления.ИА_СостояниеЗаказа.ПереносНаСледующееФП);
	Запрос.УстановитьПараметр("СтатусОТклонен", Перечисления.ИА_СостояниеЗаказа.Отклонен);
	
	// подготовка данных
	Запрос.Текст = "ВЫБРАТЬ
	               |	Подзапрос.Заказ КАК Заказ,
	               |	Подзапрос.Заказ.Сумма КАК СуммаЗаказа,
	               |	СУММА(Подзапрос.Допущено) КАК Допущено,
	               |	СУММА(Подзапрос.Отклонено) КАК Отклонено,
	               |	СУММА(Подзапрос.Одобрено) КАК Одобрено,
	               |	СУММА(Подзапрос.Оплачено) КАК Оплачено,
	               |	Подзапрос.Заказ.Фонд КАК Фонд,
	               |	Подзапрос.Заказ.Подразделение КАК Подразделение,
	               |	Подзапрос.Заказ.Статья КАК Статья,
	               |	Подзапрос.Заказ.Номер КАК Номер,
	               |	Подзапрос.Заказ.ПредметЗаказа КАК Предмет,
	               |	Подзапрос.Заказ.Организация КАК Организация
	               |ИЗ
	               |	(ВЫБРАТЬ
	               |		ИА_ИсторияСтатусовЗВС.ЗВС КАК Заказ,
	               |		ИА_ИсторияСтатусовЗВС.ЗВС.Сумма КАК Допущено,
	               |		0 КАК Отклонено,
	               |		0 КАК Одобрено,
	               |		0 КАК Оплачено
	               |	ИЗ
	               |		РегистрСведений.ИА_ИсторияСтатусовЗВС КАК ИА_ИсторияСтатусовЗВС
	               |	ГДЕ
	               |		ИА_ИсторияСтатусовЗВС.Статус = &СтатусРассмотретьНаФП
	               |		И ИА_ИсторияСтатусовЗВС.Период МЕЖДУ &ДатаНачала И &ДатаКонца
	               |	
	               |	ОБЪЕДИНИТЬ ВСЕ
	               |	
	               |	ВЫБРАТЬ
	               |		ИА_ИсторияСтатусовЗВС.ЗВС,
	               |		0,
	               |		ИА_ИсторияСтатусовЗВС.ЗВС.Сумма,
	               |		0,
	               |		0
	               |	ИЗ
	               |		РегистрСведений.ИА_ИсторияСтатусовЗВС КАК ИА_ИсторияСтатусовЗВС
	               |	ГДЕ
	               |		ИА_ИсторияСтатусовЗВС.Статус = &СтатусОТклонен
	               |		И ИА_ИсторияСтатусовЗВС.Период МЕЖДУ &ДатаНачала И &ДатаКонца
	               |	
	               |	ОБЪЕДИНИТЬ ВСЕ
	               |	
	               |	ВЫБРАТЬ
	               |		ИА_СредстваВРезервеНаФондахОбороты.ЗП,
	               |		0,
	               |		0,
	               |		ИА_СредстваВРезервеНаФондахОбороты.СуммаБезналПриход,
	               |		ИА_СредстваВРезервеНаФондахОбороты.СуммаБезналРасход
	               |	ИЗ
	               |		РегистрНакопления.ИА_СредстваВРезервеНаФондах.Обороты(&ДатаНАчала, &ДатаКонца, , ) КАК ИА_СредстваВРезервеНаФондахОбороты) КАК Подзапрос
	               |ГДЕ
	               |	Подзапрос.Заказ.Организация В(&Организации)
	               |	И Подзапрос.Заказ.Фонд В(&Фонды)
	               |	И Подзапрос.Заказ.Подразделение В(&Подразделения)
	               |	И Подзапрос.Заказ.Статья В(&Статьи)
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	Подзапрос.Заказ,
	               |	Подзапрос.Заказ.Сумма,
	               |	Подзапрос.Заказ.Фонд,
	               |	Подзапрос.Заказ.Подразделение,
	               |	Подзапрос.Заказ.Статья,
	               |	Подзапрос.Заказ.Номер,
	               |	Подзапрос.Заказ.ПредметЗаказа,
	               |	Подзапрос.Заказ.Организация
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Подзапрос.Заказ.Подразделение.Наименование,
	               |	Подзапрос.Заказ.Фонд.Наименование";
	ВсеДанные = запрос.Выполнить().Выгрузить();
	
	
	Если ЧтоТоВыбрано Тогда
		
		для каждого текОрг из ВыбОрг Цикл
			// организация
			Обл = макет.ПолучитьОбласть("ГруппаОрганизация");
			обл.параметры.Организация = текОрг;
			ТабДок.Вывести(обл);

			// фильтр данных по тек организации
			ТекДанные = ВсеДанные.Скопировать();
			Сч = ТекДанные.Количество() - 1;
			Пока сч >=0 Цикл
				если ТекДанные[сч].Организация <> текОрг Тогда
					ТекДанные.Удалить(сч);
				КонецЕсли;				
				сч = сч - 1;
			КонецЦикла;
			
			//
			Если Настройки[0].Выбрать Тогда // Сводно 
				ВывестиСводнуюТаблицу(макет, табдок, ТекДанные);
			КонецЕсли;	
			
			//
			Если Настройки[1].Выбрать Тогда // Детализация
				ВывестиДетализацию(макет, табдок, ТекДанные, ДатаНачала, КонецДня(ДатаКонца));
			КонецЕсли;
			
		КонецЦикла;
	КонецЕсли;	
		
	Обл = макет.ПолучитьОбласть("Подвал");
	ТабДок.Вывести(обл);
	
	ТабДок.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	ТабДок.АвтоМасштаб = Истина;
	
	Элементы.ТабДок.РежимМасштабированияПросмотра = РежимМасштабированияПросмотра.Обычный;
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ВывестиДетализацию(макет, табдок, тз, ДатаНачала, ДатаКонца)

	Обл = макет.ПолучитьОбласть("ДетализацияШапка");
	ТабДок.Вывести(обл);
	
	тзДетал = тз.Скопировать();
	тзДетал.Свернуть("Подразделение", "СуммаЗаказа, Допущено, Отклонено, Одобрено, Оплачено");
	
	Для каждого стрДет из тзДетал Цикл	
		Обл = макет.ПолучитьОбласть("ДетализацияШапкаГруппировка");		
		обл.параметры.Группировка = стрДет.Подразделение; 
		ТабДок.Вывести(обл);
		
		
		// фильтр данных по тек Подразделению
		тзДетал1 = тз.Скопировать();
		Сч = тзДетал1.Количество() - 1;
		Пока сч >=0 Цикл
			если тзДетал1[сч].Подразделение <> стрДет.Подразделение Тогда
				тзДетал1.Удалить(сч);
			КонецЕсли;				
			сч = сч - 1;
		КонецЦикла;
		
		Для каждого стрЗаказ из тзДетал1 цикл
			Обл = макет.ПолучитьОбласть("ДетализацияСтрока");
			ЗаполнитьЗначенияСвойств(обл.параметры, стрЗаказ); 
			РегистраторыСтрукт = ПолучитьПредставлениеРегистраторов(стрЗаказ.Заказ, ДатаНачала, ДатаКонца);
			ЗаполнитьЗначенияСвойств(обл.параметры, РегистраторыСтрукт);
			ТабДок.Вывести(обл);
		КонецЦикла;
		
		Обл = макет.ПолучитьОбласть("ДетализацияИтого");
		обл.параметры.СуммаЗаказа = тзДетал1.итог("СуммаЗаказа");
		обл.параметры.Допущено = тзДетал1.итог("Допущено");
		обл.параметры.Отклонено = тзДетал1.итог("Отклонено");
		обл.параметры.Одобрено = тзДетал1.итог("Одобрено");
		обл.параметры.Оплачено = тзДетал1.итог("Оплачено");
		
		ТабДок.Вывести(обл);

	КонецЦикла;
	
		
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьПредставлениеРегистраторов(заказ, ДатаНачала, ДатаКонца)
	
	Запрос = новый запрос;
	запрос.Текст = "ВЫБРАТЬ
	               |	ИА_СредстваВРезервеНаФондахОбороты.Регистратор КАК Регистратор,
	               |	ИА_СредстваВРезервеНаФондахОбороты.Регистратор.Номер КАК Номер,
	               |	ИА_СредстваВРезервеНаФондахОбороты.СуммаБезналПриход КАК СуммаБезналПриход,
	               |	ИА_СредстваВРезервеНаФондахОбороты.СуммаБезналРасход КАК СуммаБезналРасход
	               |ИЗ
	               |	РегистрНакопления.ИА_СредстваВРезервеНаФондах.Обороты(&ДатаНачала, &ДатаКонца, Регистратор, ЗП = &ЗП) КАК ИА_СредстваВРезервеНаФондахОбороты
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ИА_СредстваВРезервеНаФондахОбороты.Период";
	Запрос.УстановитьПараметр("ЗП", заказ);
	Запрос.УстановитьПараметр("ДатаНачала", ДатаНачала);
	Запрос.УстановитьПараметр("ДатаКонца", ДатаКонца);
	Выборка = запрос.Выполнить().Выбрать();
	
	рез = "";
	масс = новый массив;
	Пока выборка.Следующий() цикл
		Если рез <> "" Тогда
			рез = рез + ", ";
		КонецЕсли;
		ном = УбратьНули(выборка.Номер);
		
		Предст = "";
		Если ТипЗнч(Выборка.Регистратор) = тип("ДокументСсылка.ИА_ФинансовоеПланирование") Тогда
			Предст = "ФП №"+ном;
		ИначеЕсли ТипЗнч(Выборка.Регистратор) = тип("ДокументСсылка.КСУ_ВнедоходноеПоступлениеСредств") Тогда
			Предст = "ВДПС №"+ном;
		ИначеЕсли ТипЗнч(Выборка.Регистратор) = тип("ДокументСсылка.КСУ_ФормальнаяВыплата") Тогда
			Предст = "Форм. выплата №"+ном;
		ИначеЕсли ТипЗнч(Выборка.Регистратор) = тип("ДокументСсылка.ИА_ЗакрытиеЗаказаНаПриобретение") Тогда
			Предст = "Закрытие №"+ном;
		ИначеЕсли Выборка.СуммаБезналПриход > 0 Тогда
			Предст = "Возврат №"+ном;
		Иначе
			Предст = "Выплата №"+ном;
		КонецЕсли;
		
		рез = рез + Предст;
		масс.Добавить(Выборка.Регистратор);
	КонецЦикла;
	
	РезСтрукт = Новый Структура("Регистраторы, РегистраторыМассив", рез, масс); 
	
	возврат РезСтрукт;
КонецФункции

&НаСервереБезКонтекста
Функция УбратьНули(номер)
	рез = номер; 
	Пока Лев(рез, 1) = "0" Цикл 
	    рез = Прав(рез, СтрДлина(рез) - 1);
	КонецЦикла;
	Возврат рез;
КонецФункции

&НаСервереБезКонтекста
Процедура ВывестиСводнуюТаблицу(макет, табдок, тз)

	Обл = макет.ПолучитьОбласть("СводноШапка");
	ТабДок.Вывести(обл);
				   
	тзДетал = тз.Скопировать();
	тзДетал.Свернуть("Подразделение", "СуммаЗаказа, Допущено, Отклонено, Одобрено, Оплачено");
	
	Для каждого стрДет из тзДетал Цикл	
		
		Обл = макет.ПолучитьОбласть("СводноСтрока");		
		ЗаполнитьЗначенияСвойств(обл.параметры, стрДет); 
		ТабДок.Вывести(обл);
		
	КонецЦикла;
	
	Обл = макет.ПолучитьОбласть("СводноИтого");

	обл.параметры.Допущено = тзДетал.итог("Допущено");
	обл.параметры.Отклонено = тзДетал.итог("Отклонено");
	обл.параметры.Одобрено = тзДетал.итог("Одобрено");
	обл.параметры.Оплачено = тзДетал.итог("Оплачено");
	
	ТабДок.Вывести(обл);
	
КонецПроцедуры

