		<query>ВЫБРАТЬ РАЗРЕШЕННЫЕ
	ЧекККМ.Дата КАК Период,
	ЧекККМ.Ссылка КАК ДокументПродажи,
	ЧекККМ.Организация КАК Организация,
	ЧекККМ.Магазин КАК Магазин,
	ЧекККМ.Продавец КАК Продавец,
	ЧекККМТовары.Номенклатура КАК Номенклатура,
	ЧекККМТовары.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	ЧекККМТовары.Количество КАК Количество,
	ЧекККМТовары.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	ЧекККМТовары.Цена КАК Цена,
	ЧекККМТовары.Сумма КАК Сумма,
	ВЫБОР
				КОГДА НЕ ЕСТЬNULL(ТоварыНаСкладахОбороты.КоличествоРасход, 0) = 0
					ТОГДА ЧекККМТовары.Количество * ЕСТЬNULL(ТоварыНаСкладахОбороты.СуммаРасход, 0) / ЕСТЬNULL(ТоварыНаСкладахОбороты.КоличествоРасход, 0)
				ИНАЧЕ 0
			КОНЕЦ
	КАК Себестоимость
ПОМЕСТИТЬ ВТ_РозничныеПродажи
ИЗ
	Документ.ЧекККМ.Товары КАК ЧекККМТовары
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЧекККМ КАК ЧекККМ
		ПО ЧекККМТовары.Ссылка = ЧекККМ.Ссылка
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыНаСкладах.Обороты(, , Авто, ) КАК ТоварыНаСкладахОбороты
		ПО ЧекККМТовары.Ссылка = ТоварыНаСкладахОбороты.Регистратор
			И ЧекККМТовары.Номенклатура = ТоварыНаСкладахОбороты.Номенклатура
			И ЧекККМТовары.ХарактеристикаНоменклатуры = ТоварыНаСкладахОбороты.ХарактеристикаНоменклатуры
			И ЧекККМТовары.СерияНоменклатуры = ТоварыНаСкладахОбороты.СерияНоменклатуры
ГДЕ
	ЧекККМ.Проведен
	И ЧекККМ.Дата &gt;= &amp;НачалоПериода
	И ЧекККМ.Дата &lt;= &amp;КонецПериода
	И ЧекККМ.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийЧекККМ.Продажа)
	И ЧекККМ.СтатусЧекаККМ В (ЗНАЧЕНИЕ(Перечисление.СтатусыЧековККМ.Пробитый), ЗНАЧЕНИЕ(перечисление.СтатусыЧековККМ.Архивный))

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	ЧекККМ.ЧекККМПродажа.Дата,
	ЧекККМ.ЧекККМПродажа,
	ЧекККМ.Организация,
	ЧекККМ.Магазин,
	ЧекККМ.Продавец,
	ЧекККМТовары.Номенклатура,
	ЧекККМТовары.ХарактеристикаНоменклатуры,
	-ЧекККМТовары.Количество,
	ЧекККМТовары.ЕдиницаИзмерения,
	ЧекККМТовары.Цена,
	-ЧекККМТовары.Сумма,
	ВЫБОР
				КОГДА НЕ ЕСТЬNULL(ТоварыНаСкладахОбороты.КоличествоРасход, 0) = 0
					ТОГДА ЧекККМТовары.Количество * ЕСТЬNULL(ТоварыНаСкладахОбороты.СуммаРасход, 0) / ЕСТЬNULL(ТоварыНаСкладахОбороты.КоличествоРасход, 0)
				ИНАЧЕ 0
			КОНЕЦ
	КАК Себестоимость
ИЗ
	Документ.ЧекККМ.Товары КАК ЧекККМТовары
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЧекККМ КАК ЧекККМ
		ПО ЧекККМТовары.Ссылка = ЧекККМ.Ссылка
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыНаСкладах.Обороты(, , Авто, ) КАК ТоварыНаСкладахОбороты
		ПО ЧекККМТовары.Ссылка = ТоварыНаСкладахОбороты.Регистратор
			И ЧекККМТовары.Номенклатура = ТоварыНаСкладахОбороты.Номенклатура
			И ЧекККМТовары.ХарактеристикаНоменклатуры = ТоварыНаСкладахОбороты.ХарактеристикаНоменклатуры
			И ЧекККМТовары.СерияНоменклатуры = ТоварыНаСкладахОбороты.СерияНоменклатуры

ГДЕ
	ЧекККМ.Проведен
	И ЧекККМ.Дата &gt;= &amp;НачалоПериода
	И ЧекККМ.Дата &lt;= &amp;КонецПериода
	И ЧекККМ.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийЧекККМ.Возврат)
	И ЧекККМ.СтатусЧекаККМ В (ЗНАЧЕНИЕ(Перечисление.СтатусыЧековККМ.Пробитый), ЗНАЧЕНИЕ(Перечисление.СтатусыЧековККМ.Архивный))
;

