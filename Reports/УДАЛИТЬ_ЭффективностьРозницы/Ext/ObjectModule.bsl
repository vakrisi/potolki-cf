
Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;  
    УстановитьПривилегированныйРежим(Истина); // #4888
	
	НастройкиОтчета = КомпоновщикНастроек.ПолучитьНастройки();	
	Для Каждого Элемент Из НастройкиОтчета.ПараметрыДанных.Элементы Цикл
		Если Строка(Элемент.Параметр) = "НачалоПериода"  Тогда
			НачалоПериода = Элемент.Значение;
		ИначеЕсли Строка(Элемент.Параметр) = "КонецПериода"  Тогда			
			КонецПериода = Элемент.Значение;
		ИначеЕсли Строка(Элемент.Параметр) = "ТипДиаграммы"  Тогда
			ПараметрТипДиаграммы = Элемент.Значение;
		КонецЕсли;
	КонецЦикла;
	НачалоПериода = НачалоПериода.Дата;
	КонецПериода = КонецПериода.Дата;
	Если КонецПериода = Дата(0001,01,01) Тогда
		КонецПериода = ТекущаяДатаСеанса();
	КонецЕсли;	
	
	Для каждого ЭлементВыбора из НастройкиОтчета.Выбор.Элементы Цикл
		Если НРег(Лев(ЭлементВыбора.Заголовок, 19)) = "оформлено договоров" Тогда
			ЭлементВыбора.Заголовок = "Оформлено договоров за период с " + Формат(НачалоПериода, "ДЛФ=D") + " по " + Формат(КонецПериода, "ДЛФ=D");
		ИначеЕсли НРег(Лев(ЭлементВыбора.Заголовок, 18)) = "выполнено монтажей" Тогда		
			ЭлементВыбора.Заголовок = "Выполнено монтажей за период с " + Формат(НачалоПериода, "ДЛФ=D") + " по " + Формат(КонецПериода, "ДЛФ=D");
		КонецЕсли;
	КонецЦикла;

	//Выбор типа диаграммы
	//ТипДиаграммы.ГистограммаГоризонтальная;
	//ТипДиаграммы.ГистограммаГоризонтальнаяОбъемная;
	//ТипДиаграммы.ГистограммаСНакоплениемГоризонтальная;
	//ТипДиаграммы.ГистограммаСНакоплениемГоризонтальнаяОбъемная;
	
	Если ПараметрТипДиаграммы <> Неопределено Тогда
		Для	Каждого СтруктураВывода Из НастройкиОтчета.Структура Цикл
			Если ТипЗнч(СтруктураВывода) = Тип("ДиаграммаКомпоновкиДанных") Тогда
				Для Каждого ПараметрВывода Из СтруктураВывода.ПараметрыВывода.Элементы Цикл
					Если Строка(ПараметрВывода.Параметр) = "ТипДиаграммы" Тогда
						ПараметрВывода.Значение = ТипДиаграммы[ПараметрТипДиаграммы];
					КонецЕсли;	
				КонецЦикла;			
			КонецЕсли;	
		КонецЦикла;
	КонецЕсли;	
		
	КомпоновщикНастроек.ЗагрузитьНастройки(НастройкиОтчета);
	
	//НастройкиОтчета = КомпоновщикНастроек.ПолучитьНастройки();
    КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
    МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, НастройкиОтчета, ДанныеРасшифровки,,,Ложь);
    
    
    ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
    ПроцессорКомпоновки.Инициализировать(МакетКомпоновки, , ДанныеРасшифровки);
    
    ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
    
    ПроцессорВывода.УстановитьДокумент(ДокументРезультат);
    ПроцессорВывода.Вывести(ПроцессорКомпоновки);
	
КонецПроцедуры
