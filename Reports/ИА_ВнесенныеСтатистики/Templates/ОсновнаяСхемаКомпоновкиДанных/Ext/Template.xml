	ИА_НастройкиРабочегоСтолаСтатистикСтатистики.ВидСтатистики,
	ЕСТЬNULL(ИА_НастройкиРабочегоСтолаСтатистикСтатистики.Аналитика1, НЕОПРЕДЕЛЕНО) КАК Аналитика1,
	ЕСТЬNULL(ИА_НастройкиРабочегоСтолаСтатистикСтатистики.Аналитика2, НЕОПРЕДЕЛЕНО) КАК Аналитика2,
	ЕСТЬNULL(ИА_НастройкиРабочегоСтолаСтатистикСтатистики.Аналитика3, НЕОПРЕДЕЛЕНО) КАК Аналитика3
ПОМЕСТИТЬ втНастройкиСтатистик
ИЗ
	Справочник.ИА_НастройкиРабочегоСтолаСтатистик.Статистики КАК ИА_НастройкиРабочегоСтолаСтатистикСтатистики

СГРУППИРОВАТЬ ПО
	ИА_НастройкиРабочегоСтолаСтатистикСтатистики.Ссылка,
	ИА_НастройкиРабочегоСтолаСтатистикСтатистики.ВидСтатистики,
	ЕСТЬNULL(ИА_НастройкиРабочегоСтолаСтатистикСтатистики.Аналитика1, НЕОПРЕДЕЛЕНО),
	ЕСТЬNULL(ИА_НастройкиРабочегоСтолаСтатистикСтатистики.Аналитика2, НЕОПРЕДЕЛЕНО),
	ЕСТЬNULL(ИА_НастройкиРабочегоСтолаСтатистикСтатистики.Аналитика3, НЕОПРЕДЕЛЕНО)
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ИА_ВидыСтатистик.Ссылка КАК ВидСтатистики,
	ВЫБОР
		КОГДА ИА_ВидыСтатистик.Аналитика1 = ЗНАЧЕНИЕ(Справочник.ИА_ВидыАналитикиСтатистики.ПустаяСсылка)
			ТОГДА НЕОПРЕДЕЛЕНО
		ИНАЧЕ ИА_ВидыСтатистик.Аналитика1
	КОНЕЦ КАК ТипАналитики1,
	ВЫБОР
		КОГДА ИА_ВидыСтатистик.Аналитика2 = ЗНАЧЕНИЕ(Справочник.ИА_ВидыАналитикиСтатистики.ПустаяСсылка)
			ТОГДА НЕОПРЕДЕЛЕНО
		ИНАЧЕ ИА_ВидыСтатистик.Аналитика2
	КОНЕЦ КАК ТипАналитики2,
	ВЫБОР
		КОГДА ИА_ВидыСтатистик.Аналитика3 = ЗНАЧЕНИЕ(Справочник.ИА_ВидыАналитикиСтатистики.ПустаяСсылка)
			ТОГДА НЕОПРЕДЕЛЕНО
		ИНАЧЕ ИА_ВидыСтатистик.Аналитика3
	КОНЕЦ КАК ТипАналитики3
ПОМЕСТИТЬ втТипыАналитик
ИЗ
	Справочник.ИА_ВидыСтатистик КАК ИА_ВидыСтатистик
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	втТипыАналитик.ВидСтатистики,
	втНастройкиСтатистик.Аналитика1,
	втНастройкиСтатистик.Аналитика2,
	втНастройкиСтатистик.Аналитика3,
	втТипыАналитик.ТипАналитики1,
	втТипыАналитик.ТипАналитики2,
	втТипыАналитик.ТипАналитики3,
	ВЫБОР
		КОГДА втТипыАналитик.ВидСтатистики.ВариантПолученияДанных = ЗНАЧЕНИЕ(Перечисление.ИА_ВариантыПолученияДанныхСтатистик.ДокументомСтатистика)
			ТОГДА ИСТИНА
		ИНАЧЕ ЛОЖЬ
	КОНЕЦ КАК ДанныеВносятсяВручную,
	втНастройкиСтатистик.НастройкаСтатистики
ПОМЕСТИТЬ втПодитог
ИЗ
	втТипыАналитик КАК втТипыАналитик
		ЛЕВОЕ СОЕДИНЕНИЕ втНастройкиСтатистик КАК втНастройкиСтатистик
		ПО втТипыАналитик.ВидСтатистики = втНастройкиСтатистик.ВидСтатистики
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗЛИЧНЫЕ
	втПодитог.ВидСтатистики,
	втПодитог.Аналитика1,
	втПодитог.ТипАналитики1,
	втПодитог.Аналитика2,
	втПодитог.ТипАналитики2,
	втПодитог.Аналитика3,
	втПодитог.ТипАналитики3,
	ВЫБОР
		КОГДА ЕСТЬNULL(втЗначенияСтатистик.ДатаЗаполнения, НЕОПРЕДЕЛЕНО) &lt;&gt; НЕОПРЕДЕЛЕНО
				И втПодитог.ДанныеВносятсяВручную = ИСТИНА
			ТОГДА 1
		КОГДА ЕСТЬNULL(втЗначенияСтатистик.ДатаЗаполнения, НЕОПРЕДЕЛЕНО) = НЕОПРЕДЕЛЕНО
				И (втПодитог.ТипАналитики1 = НЕОПРЕДЕЛЕНО
					И втПодитог.ТипАналитики2 = НЕОПРЕДЕЛЕНО
					И втПодитог.ТипАналитики3 = НЕОПРЕДЕЛЕНО)
				И втПодитог.ДанныеВносятсяВручную = ИСТИНА
			ТОГДА 2
		КОГДА втПодитог.Аналитика1 = НЕОПРЕДЕЛЕНО
				И втПодитог.Аналитика2 = НЕОПРЕДЕЛЕНО
				И втПодитог.Аналитика3 = НЕОПРЕДЕЛЕНО
				И (втПодитог.ТипАналитики1 &lt;&gt; НЕОПРЕДЕЛЕНО
					ИЛИ втПодитог.ТипАналитики2 &lt;&gt; НЕОПРЕДЕЛЕНО
					ИЛИ втПодитог.ТипАналитики3 &lt;&gt; НЕОПРЕДЕЛЕНО)
				И втПодитог.ДанныеВносятсяВручную = ЛОЖЬ
			ТОГДА 0
		КОГДА ЕСТЬNULL(втЗначенияСтатистик.ДатаЗаполнения, НЕОПРЕДЕЛЕНО) = НЕОПРЕДЕЛЕНО
				И (втПодитог.Аналитика1 &lt;&gt; НЕОПРЕДЕЛЕНО
					ИЛИ втПодитог.Аналитика2 &lt;&gt; НЕОПРЕДЕЛЕНО
					ИЛИ втПодитог.Аналитика3 &lt;&gt; НЕОПРЕДЕЛЕНО)
				И втПодитог.ДанныеВносятсяВручную = ИСТИНА
			ТОГДА 2
		КОГДА втПодитог.ДанныеВносятсяВручную = ЛОЖЬ ТОГДА 0
		ИНАЧЕ 2
	КОНЕЦ КАК ДанныеВнесены,
	втЗначенияСтатистик.ДатаЗаполнения,
	ОргСхема.Ссылка КАК Пост
ИЗ
	втПодитог КАК втПодитог
		ЛЕВОЕ СОЕДИНЕНИЕ втЗначенияСтатистик КАК втЗначенияСтатистик
