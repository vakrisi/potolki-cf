		//ТЗ_ПорядокВидовЦен.Колонки.НомерСтроки.Имя = "ПорядокЦены";
		ОбщегоНазначения.ХранилищеОбщихНастроекСохранить(
			"ОтчетПрайсЛист",
			"ПорядокВидовЦен",
			ТЗ_ПорядокВидовЦен);
	КонецЕсли;
	
	ДополнительныеНастройки = Новый Структура;
	ДополнительныеНастройки.Вставить("ОтборНоменклатура", Новый ХранилищеЗначения(КомпоновщикНастроекНоменклатура.ПолучитьНастройки()));
	
	ОбщегоНазначения.ХранилищеОбщихНастроекСохранить(
			"ОтчетПрайсЛист",
			"ДополнительныеНастройки",
			ДополнительныеНастройки);	

КонецПроцедуры

