	ТЗ_ПорядокВидовЦен = ПустаяТаблицаНастроекЦен();
	Счетчик = 1;
	ЗапомнитьВыборВидовЦенРекурсивно(ДеревоВидовЦен.ПолучитьЭлементы(), ТЗ_ПорядокВидовЦен, Счетчик);
	
