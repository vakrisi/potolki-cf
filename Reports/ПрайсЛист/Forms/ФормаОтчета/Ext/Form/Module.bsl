	Для каждого ЭлементДерева из ЭлементыДерева Цикл
		Если ЭлементДерева.Выбрать И НЕ ЭлементДерева.ЭтоГруппа Тогда
			СписокВидовЦен.Добавить(ЭлементДерева.Ссылка);
		КонецЕсли;
		
		ВыбратьВидыЦенРекурсивно(ЭлементДерева.ПолучитьЭлементы(), СписокВидовЦен)
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗапомнитьВыборВидовЦенРекурсивно(ЭлементыДерева, ТаблицаВидов, Счетчик)
	
	Для каждого ЭлементДерева из ЭлементыДерева Цикл
		НоваяСтрока = ТаблицаВидов.Добавить();
		НоваяСтрока.Выбрать = ЭлементДерева.Выбрать;
		НоваяСтрока.ПорядокЦены = Счетчик;
		НоваяСтрока.ВидЦены = ЭлементДерева.Ссылка;
		
		Счетчик = Счетчик + 1;
		
		ЗапомнитьВыборВидовЦенРекурсивно(ЭлементДерева.ПолучитьЭлементы(), ТаблицаВидов, Счетчик)
	КонецЦикла;
	
КонецПроцедуры

