#Область ФормированиеОтчета

&НаКлиенте
Процедура Сформировать(Команда)
	
	// №6999 переделано на вызов стандартной проверки заполнения
	Если НЕ ПроверитьЗаполнение() Тогда
		Возврат;
	КонецЕсли;
	
	//Результат = Новый ТабличныйДокумент;
	Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.ГруппаПрайсЛист;
	
	ЗаголовокВыведен = Ложь;
	
	РезультатФоновогоЗадания = ФоновоеЗаданиеЗапустить();
	Если РезультатФоновогоЗадания = Неопределено Тогда 
		Возврат;
	КонецЕсли;
	Если РезультатФоновогоЗадания.Статус = "Ошибка" Тогда
		ПоказатьОшибкиФормирования(РезультатФоновогоЗадания);
	ИначеЕсли РезультатФоновогоЗадания.Статус <> "Выполняется" Тогда 
		//ОперацииПослеФормирования();
	Иначе
		Обработчик = Новый ОписаниеОповещения("ФоновоеЗаданиеВыполнено", ЭтотОбъект, Истина);
		ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
		ПараметрыОжидания.ВыводитьОкноОжидания = Ложь;
		ДлительныеОперацииКлиент.ОжидатьЗавершение(РезультатФоновогоЗадания, Обработчик, ПараметрыОжидания);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ФоновоеЗаданиеЗапустить()
	
	ТабличныйДокумент.Очистить();
	
	Если Отчет.Дата = Дата(1,1,1) Тогда
		Отчет.Дата = ТекущаяДатаСеанса();
	КонецЕсли;
	
	СписокВидовЦен = Новый СписокЗначений;	
	ВыбратьВидыЦенРекурсивно(ДеревоВидовЦен.ПолучитьЭлементы(), СписокВидовЦен);
	
	// Запуск фонового задания
	
	ТекОбъект = РеквизитФормыВЗначение("Отчет");
	СКДНоменклатура = ТекОбъект.ПолучитьМакет("СКДНоменклатура");
	СКДФактура 		= ТекОбъект.ПолучитьМакет("СКДФактура");
	СписокДляОтбораНоменклатуры = ПолучитьМассивСсылокПоОтбору(СКДНоменклатура, КомпоновщикНастроекНоменклатура, "Номенклатура");
	СписокДляОтбораФактур 		= ПолучитьМассивСсылокПоОтбору(СКДФактура, КомпоновщикНастроекФактура, "Фактура");
	
	//СтруктураПараметров = Новый Структура;
	//СтруктураПараметров.Вставить("ТаблицаПоказателей", ТаблицаТекущихПоказателей.Выгрузить());
	//СтруктураПараметров.Вставить("Период", Период);	
	
	ПараметрыФормированияОтчета = Новый Структура;
	
	ПараметрыФормированияОтчета.Вставить("Организация", Отчет.Организация);
	ПараметрыФормированияОтчета.Вставить("Дата", Отчет.Дата);
	ПараметрыФормированияОтчета.Вставить("Валюта", Отчет.Валюта);
	
	ПараметрыФормированияОтчета.Вставить("ПрайсТоварыМатериалыУслуги", Отчет.ПрайсТоварыМатериалыУслуги);	
	ПараметрыФормированияОтчета.Вставить("ПрайсПотолки", Отчет.ПрайсПотолки);
	ПараметрыФормированияОтчета.Вставить("ПрайсПроизводственныеУслугиНаПотолки", Отчет.ПрайсПроизводственныеУслугиНаПотолки);
	ПараметрыФормированияОтчета.Вставить("ПрайсОтрезы", Отчет.ПрайсОтрезы);
	ПараметрыФормированияОтчета.Вставить("ПрайсПроизводственныеУслугиНаОтрезы", Отчет.ПрайсПроизводственныеУслугиНаОтрезы);
	
	ПараметрыФормированияОтчета.Вставить("ПоказыватьНулевыеЦены", 		Отчет.ПоказыватьНулевыеЦены);
	ПараметрыФормированияОтчета.Вставить("ПоказыватьАрхивныеПозиции", 	Отчет.ПоказыватьАрхивныеПозиции);
	ПараметрыФормированияОтчета.Вставить("Потолки_ПоказыватьНулевыеЦены", 		Отчет.Потолки_ПоказыватьНулевыеЦены);
	ПараметрыФормированияОтчета.Вставить("Потолки_ПоказыватьАрхивныеПозиции", 		Отчет.Потолки_ПоказыватьАрхивныеПозиции);
	ПараметрыФормированияОтчета.Вставить("ПроизводственныеУслуги_ПоказыватьАрхивныеПозиции", 		Отчет.ПроизводственныеУслуги_ПоказыватьАрхивныеПозиции);
	ПараметрыФормированияОтчета.Вставить("ПроизводственныеУслугиОтрезы_ПоказыватьАрхивныеПозиции", 	Отчет.ПроизводственныеУслугиОтрезы_ПоказыватьАрхивныеПозиции);
	ПараметрыФормированияОтчета.Вставить("Отрезы_ПоказыватьНулевыеЦены", 		Отчет.Отрезы_ПоказыватьНулевыеЦены);
	ПараметрыФормированияОтчета.Вставить("Отрезы_ПоказыватьАрхивныеПозиции", 	Отчет.Отрезы_ПоказыватьАрхивныеПозиции);
	
	ПараметрыФормированияОтчета.Вставить("СписокДляОтбораНоменклатуры",	СписокДляОтбораНоменклатуры);
	ПараметрыФормированияОтчета.Вставить("СписокДляОтбораФактур", 		СписокДляОтбораФактур);
	
	ПараметрыФормированияОтчета.Вставить("Потолки_ГруппировкаПоФактуре", 		Отчет.Потолки_ГруппировкаПоФактуре);
	ПараметрыФормированияОтчета.Вставить("Потолки_ГруппировкаПоГруппеФактур", 	Отчет.Потолки_ГруппировкаПоГруппеФактур);
	ПараметрыФормированияОтчета.Вставить("Отрезы_ГруппировкаПоФактуре", 		Отчет.Отрезы_ГруппировкаПоФактуре);
	ПараметрыФормированияОтчета.Вставить("Отрезы_ГруппировкаПоГруппеФактур", 	Отчет.Отрезы_ГруппировкаПоГруппеФактур);
		
	ПараметрыФормированияОтчета.Вставить("ВыводитьКартинки", 			Отчет.ВыводитьКартинки);
	ПараметрыФормированияОтчета.Вставить("СписокВидовЦен", 				СписокВидовЦен);
	ПараметрыФормированияОтчета.Вставить("ВидыИндивидуальныхЦен", 		Отчет.ВидыИндивидуальныхЦен.Выгрузить());
		
	ПараметрыЗадания = Новый Структура;
	ПараметрыЗадания.Вставить("ИмяМетода", "СформироватьОтчет");
	ПараметрыЗадания.Вставить("ИмяОтчета", ОтчетИмя);
	//ПараметрыФормированияОтчета.Вставить("КлючВарианта", КлючТекущегоВарианта);
	ПараметрыЗадания.Вставить("ЭтоВнешнийОтчет", Ложь);
	ПараметрыЗадания.Вставить("ПараметрыВыполнения", ПараметрыФормированияОтчета);
	
	ИнформацияОбОшибке = Неопределено;
	Попытка
		ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
		ПараметрыВыполнения.ЗапуститьВФоне = Истина;
		
		ВыполняемыйМетод = "ДлительныеОперации.ВыполнитьПроцедуруМодуляОбъектаОтчета";
		
		РезультатФоновогоЗадания = ДлительныеОперации.ВыполнитьВФоне(
			ВыполняемыйМетод,
			ПараметрыЗадания,
			ПараметрыВыполнения);
	Исключение
		ИнформацияОбОшибке = ИнформацияОбОшибке();
	КонецПопытки;
	
	Если ИнформацияОбОшибке <> Неопределено Тогда
		ПоказатьОшибкиФормирования(ПоляПредставлениеОшибки(ИнформацияОбОшибке));
		Возврат Неопределено;
	КонецЕсли;
	
	Если РезультатФоновогоЗадания.Статус = "Выполнено" Тогда
		
		ФоновоеЗаданиеЗагрузитьРезультат(РезультатФоновогоЗадания);
		
	ИначеЕсли РезультатФоновогоЗадания.Статус = "Ошибка" Тогда
		
		ПоказатьОшибкиФормирования(РезультатФоновогоЗадания);
		
	ИначеЕсли РезультатФоновогоЗадания.Статус = "Выполняется" Тогда
		
		ОтображениеСостояния = Элементы.ТабличныйДокумент.ОтображениеСостояния;
		ОтображениеСостояния.Видимость                      = Истина;
		ОтображениеСостояния.ДополнительныйРежимОтображения = ДополнительныйРежимОтображения.Неактуальность;
		ОтображениеСостояния.Картинка                       = БиблиотекаКартинок.ДлительнаяОперация48;
		ОтображениеСостояния.Текст                          = НСтр("ru = 'Отчет формируется...'");
		
	КонецЕсли;
	
	Возврат РезультатФоновогоЗадания;
	
КонецФункции

&НаКлиенте
Процедура ФоновоеЗаданиеВыполнено(Результат, ЗагрузитьРезультатФормированияОтчета) Экспорт
	
	Если Результат = Неопределено Тогда 
		Возврат;
	КонецЕсли;
		
	Если Результат.Статус = "Выполнено" Тогда 
		ФоновоеЗаданиеЗагрузитьРезультат(Результат);
	ИначеЕсли Результат.Статус = "Ошибка" Тогда
		ПоказатьОшибкиФормирования(Результат);
	КонецЕсли;
	
	//ОперацииПослеФормирования();
	
КонецПроцедуры

&НаСервере
Процедура ФоновоеЗаданиеЗагрузитьРезультат(Знач РезультатФоновогоЗадания)
	
	Если НЕ ЭтоАдресВременногоХранилища(РезультатФоновогоЗадания.АдресРезультата) Тогда
		Возврат;
	КонецЕсли; 
	
	РезультатФормирования = ПолучитьИзВременногоХранилища(РезультатФоновогоЗадания.АдресРезультата);
	
	//НастройкиПечатиСохранить();
	ТабличныйДокумент = РезультатФормирования.ТабличныйДокумент;
	ТабличныйДокумент.АвтоМасштаб = Истина;
	//НастройкиПечатиВосстановить();
	
	//ТаблицаДанных.Загрузить(РезультатФормирования.ТаблицаДанных); //для расшифровки
		
	ОтображениеСостояния = Элементы.ТабличныйДокумент.ОтображениеСостояния;
	ОтображениеСостояния.Видимость                      = Ложь;
	ОтображениеСостояния.ДополнительныйРежимОтображения = ДополнительныйРежимОтображения.НеИспользовать;
	ОтображениеСостояния.Картинка                       = Новый Картинка;
	ОтображениеСостояния.Текст                          = "";
	
	УдалитьИзВременногоХранилища(РезультатФоновогоЗадания.АдресРезультата);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ПоляПредставлениеОшибки(Знач ИнформацияОбОшибке)
	
	Результат = Новый Структура;
	КраткоеПредставлениеОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке);
	ПодробноеПредставлениеОшибки = НСтр("ru = 'Ошибка при формировании:'") + Символы.ПС + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке);
	Если ПустаяСтрока(КраткоеПредставлениеОшибки) Тогда
		КраткоеПредставлениеОшибки = ПодробноеПредставлениеОшибки;
	КонецЕсли;
	Результат.Вставить("КраткоеПредставлениеОшибки", КраткоеПредставлениеОшибки);
	Результат.Вставить("ПодробноеПредставлениеОшибки", ПодробноеПредставлениеОшибки);
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура ПоказатьОшибкиФормирования(Знач ДанныеОшибки)
	
	Если ТипЗнч(ДанныеОшибки) = Тип("Структура") Тогда
		КраткоеПредставлениеОшибки = ДанныеОшибки.КраткоеПредставлениеОшибки;
		ПодробноеПредставлениеОшибки = ДанныеОшибки.ПодробноеПредставлениеОшибки;
	Иначе
		КраткоеПредставлениеОшибки = ДанныеОшибки;
		ПодробноеПредставлениеОшибки = "";
	КонецЕсли;
	
	ОтображениеСостояния = Элементы.ТабличныйДокумент.ОтображениеСостояния;
	ОтображениеСостояния.Видимость                      = Истина;
	ОтображениеСостояния.ДополнительныйРежимОтображения = ДополнительныйРежимОтображения.Неактуальность;
	ОтображениеСостояния.Картинка                       = Новый Картинка;
	ОтображениеСостояния.Текст                          = КраткоеПредставлениеОшибки;
	
	Если ПустаяСтрока(ПодробноеПредставлениеОшибки) Тогда
		Возврат;
	КонецЕсли; 
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьМассивСсылокПоОтбору(МакетСКД, КомпоновщикНастроек, НаименованиеКолонки)
	
	НастройкиКомпоновки = КомпоновщикНастроек.ПолучитьНастройки();
	
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки = КомпоновщикМакета.Выполнить(МакетСКД, НастройкиКомпоновки, , , Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
	
	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(МакетКомпоновки);
	
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	ТЗ = новый ТаблицаЗначений;
	ПроцессорВывода.УстановитьОбъект(ТЗ);
	ПроцессорВывода.Вывести(ПроцессорКомпоновки);
	
	Возврат ТЗ.ВыгрузитьКолонку(НаименованиеКолонки);
	 	
КонецФункции

