Функция СформироватьОтчет(ПараметрыФормирования, АдресДляРазмещенияРезультата = Неопределено) Экспорт
	
	//ТаблицаТекущихПоказателей = СтруктураПараметров.ТаблицаПоказателей;
	Дата = ПараметрыФормирования.Дата;
	ЗаголовокВыведен = Ложь;
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.ИмяПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_ПрайсЛист";
	
	Если ПараметрыФормирования.ПрайсТоварыМатериалыУслуги Тогда
		СформироватьНаСервереКомплектующие(ТабличныйДокумент, ЗаголовокВыведен, ПараметрыФормирования);
	КонецЕсли;	
	Если ПараметрыФормирования.ПрайсПотолки Тогда
		СформироватьНаСервереПродукция(ТабличныйДокумент, ЗаголовокВыведен, ПараметрыФормирования);
	КонецЕсли;	
	Если ПараметрыФормирования.ПрайсПроизводственныеУслугиНаПотолки Тогда
		СформироватьНаСервереУслугиПроизводства(ТабличныйДокумент, ЗаголовокВыведен, ПараметрыФормирования);
	КонецЕсли;	
	Если ПараметрыФормирования.ПрайсОтрезы Тогда	
		СформироватьНаСервереПродукцияОтрез(ТабличныйДокумент, ЗаголовокВыведен, ПараметрыФормирования);
	КонецЕсли;
	Если ПараметрыФормирования.ПрайсПроизводственныеУслугиНаОтрезы Тогда	
		СформироватьНаСервереУслугиПроизводстваОтрезы(ТабличныйДокумент, ЗаголовокВыведен, ПараметрыФормирования);
	КонецЕсли;

	СтруктураВозврата = Новый Структура;
	СтруктураВозврата.Вставить("ТабличныйДокумент", ТабличныйДокумент);
	
	АдресХранения = ПоместитьВоВременноеХранилище(СтруктураВозврата, АдресДляРазмещенияРезультата);
	Возврат СтруктураВозврата;
		
КонецФункции

Процедура СформироватьНаСервереКомплектующие(ТабличныйДокумент, ЗаголовокВыведен, ПараметрыФормирования)
	
	СтруктураПараметров = Новый Структура;	
	
	//СКДНоменклатура = ПолучитьМакет("СКДНоменклатура");
	//СКДФактура 		= ПолучитьМакет("СКДФактура");
	СписокДляОтбораНоменклатуры = ПараметрыФормирования.СписокДляОтбораНоменклатуры; //ПолучитьМассивСсылокПоОтбору(СКДНоменклатура, ПараметрыФормирования.КомпоновщикНастроекНоменклатура, "Номенклатура");
	СписокДляОтбораФактур 		= ПараметрыФормирования.СписокДляОтбораФактур; //ПолучитьМассивСсылокПоОтбору(СКДФактура, ПараметрыФормирования.КомпоновщикНастроекФактура, "Фактура");
	
	Если СписокДляОтбораНоменклатуры.Количество() = 0 Тогда
		СписокДляОтбораНоменклатуры.Добавить(Справочники.Номенклатура.ПустаяСсылка());
	КонецЕсли;
	
	СтруктураПараметров.Вставить("ДатаОтчета", 					ПараметрыФормирования.Дата);
	СтруктураПараметров.Вставить("СписокВидовЦен", 				ПараметрыФормирования.СписокВидовЦен);
	СтруктураПараметров.Вставить("СписокДляОтбораНоменклатуры",	СписокДляОтбораНоменклатуры);
	СтруктураПараметров.Вставить("СписокДляОтбораФактур", 		СписокДляОтбораФактур);
	СтруктураПараметров.Вставить("Валюта", 						ПараметрыФормирования.Валюта);
	СтруктураПараметров.Вставить("ВыводитьКартинки", 			ПараметрыФормирования.ВыводитьКартинки);
	СтруктураПараметров.Вставить("ПоказыватьНулевыеЦены", 		ПараметрыФормирования.ПоказыватьНулевыеЦены);
	СтруктураПараметров.Вставить("ПоказыватьАрхивныеПозиции", 	ПараметрыФормирования.ПоказыватьАрхивныеПозиции);
	СтруктураПараметров.Вставить("ИндивидуальныеЦены", 			Ложь);
	СтруктураПараметров.Вставить("Контрагент", 					Справочники.Контрагенты.ПустаяСсылка());
	СтруктураПараметров.Вставить("ДоговорКонтрагента", 			Справочники.ДоговорыКонтрагентов.ПустаяСсылка());
	
	//ТекОбъект = РеквизитФормыВЗначение("Отчет");
	Макет = ПолучитьМакет("Макет");
	
	Таб = Новый ТабличныйДокумент;
	Таб.КлючПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_ОтчетПрайсЛист_Комплектующие";
	
	Если НЕ ЗаголовокВыведен Тогда
		ОбластьМакета = Макет.ПолучитьОбласть("ШапкаПрайса");
		ОбластьМакета.Параметры.Организация = ПараметрыФормирования.Организация;
		ОбластьМакета.Параметры.Дата = Формат(ПараметрыФормирования.Дата,"ДЛФ=ДД");
		Таб.Вывести(ОбластьМакета);
		ЗаголовокВыведен = Истина;
	КонецЕсли;
	
	ОбластьМакета = Макет.ПолучитьОбласть("ЗаголовокВидаПрайса");
	ОбластьМакета.Параметры.ЦеныНоменклатуры = "Товары, материалы, услуги";
	Таб.Вывести(ОбластьМакета);
	
	ВывестиКомплектующие(СтруктураПараметров, Макет, Таб);
	ПрисоединитьТабличныйДокумент(ТабличныйДокумент, Таб);
	
	Если ПараметрыФормирования.ВидыИндивидуальныхЦен.Количество() > 0 Тогда 
		Для каждого ВидИндивидуальнойЦены Из ПараметрыФормирования.ВидыИндивидуальныхЦен Цикл
			Если ЗначениеЗаполнено(ВидИндивидуальнойЦены.Контрагент) И ЗначениеЗаполнено(ВидИндивидуальнойЦены.ДоговорКонтрагента) Тогда
				СтруктураПараметров.Контрагент = ВидИндивидуальнойЦены.Контрагент;
				СтруктураПараметров.ДоговорКонтрагента = ВидИндивидуальнойЦены.ДоговорКонтрагента;
				СтруктураПараметров.ИндивидуальныеЦены = Истина;
				
				Таб = Новый ТабличныйДокумент;
				Таб.КлючПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_ОтчетПрайсЛист_Комплектующие";
	  
				ОбластьМакета = Макет.ПолучитьОбласть("ЗаголовокВидаПрайса");
				ОбластьМакета.Параметры.ЦеныНоменклатуры = "Товары, материалы, услуги ("+ ВидИндивидуальнойЦены.Контрагент+")";
				Таб.Вывести(ОбластьМакета);
				
				ВывестиКомплектующие(СтруктураПараметров, Макет, Таб);
				ПрисоединитьТабличныйДокумент(ТабличныйДокумент, Таб);
			КонецЕсли;	
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

Процедура СформироватьНаСервереПродукция(ТабличныйДокумент, ЗаголовокВыведен, ПараметрыФормирования)
	
	СтруктураПараметров = Новый Структура;	
	
	//СКДНоменклатура = ПолучитьМакет("СКДНоменклатура");
	//СКДФактура 		= ПолучитьМакет("СКДФактура");
	СписокДляОтбораНоменклатуры = ПараметрыФормирования.СписокДляОтбораНоменклатуры; //ПолучитьМассивСсылокПоОтбору(СКДНоменклатура, ПараметрыФормирования.КомпоновщикНастроекНоменклатура, "Номенклатура");
	СписокДляОтбораФактур 		= ПараметрыФормирования.СписокДляОтбораФактур; //ПолучитьМассивСсылокПоОтбору(СКДФактура, ПараметрыФормирования.КомпоновщикНастроекФактура, "Фактура");
	
	Если СписокДляОтбораНоменклатуры.Количество() = 0 Тогда
		СписокДляОтбораНоменклатуры.Добавить(Справочники.Номенклатура.ПустаяСсылка());
	КонецЕсли;
	
	СтруктураПараметров.Вставить("ДатаОтчета", 					ПараметрыФормирования.Дата);
	СтруктураПараметров.Вставить("СписокВидовЦен", 				ПараметрыФормирования.СписокВидовЦен);
	СтруктураПараметров.Вставить("СписокДляОтбораНоменклатуры",	СписокДляОтбораНоменклатуры);
	СтруктураПараметров.Вставить("СписокДляОтбораФактур", 		СписокДляОтбораФактур);
	СтруктураПараметров.Вставить("Валюта", 						ПараметрыФормирования.Валюта);
	СтруктураПараметров.Вставить("ПоказыватьНулевыеЦены", 		ПараметрыФормирования.Потолки_ПоказыватьНулевыеЦены);
	СтруктураПараметров.Вставить("ВидНоменклатурыПотолки",		Справочники.ВидыНоменклатуры.Потолок);
	СтруктураПараметров.Вставить("ПоказыватьАрхивныеПозиции", 	ПараметрыФормирования.Потолки_ПоказыватьАрхивныеПозиции);
	СтруктураПараметров.Вставить("ГруппировкаПоФактуре", 		ПараметрыФормирования.Потолки_ГруппировкаПоФактуре);
	СтруктураПараметров.Вставить("ГруппировкаПоГруппеФактур", 	ПараметрыФормирования.Потолки_ГруппировкаПоГруппеФактур);
	СтруктураПараметров.Вставить("ИндивидуальныеЦены", 			Ложь);
	СтруктураПараметров.Вставить("Контрагент", 					Справочники.Контрагенты.ПустаяСсылка());
	СтруктураПараметров.Вставить("ДоговорКонтрагента", 			Справочники.ДоговорыКонтрагентов.ПустаяСсылка());
	
	Макет = ПолучитьМакет("МакетПотолки");
	МакетОсновной = ПолучитьМакет("Макет");
	
	Таб = Новый ТабличныйДокумент;
	Таб.КлючПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_ОтчетПрайсЛист_Потолки";
	
	Если НЕ ЗаголовокВыведен Тогда
		ОбластьМакета = МакетОсновной.ПолучитьОбласть("ШапкаПрайса");
		ОбластьМакета.Параметры.Организация = ПараметрыФормирования.Организация;
		ОбластьМакета.Параметры.Дата = Формат(ПараметрыФормирования.Дата,"ДЛФ=ДД");
		Таб.Вывести(ОбластьМакета);
		ЗаголовокВыведен=Истина;
	КонецЕсли;
		
	ОбластьМакета = Макет.ПолучитьОбласть("ЗаголовокВидаПрайса");
	ОбластьМакета.Параметры.ЦеныНоменклатуры = "Потолки";
	Таб.Вывести(ОбластьМакета);
	
	ВывестиЦеныНаПродукцию(СтруктураПараметров, Макет, Таб);
	ПрисоединитьТабличныйДокумент(ТабличныйДокумент, Таб);
	
	Если ПараметрыФормирования.ВидыИндивидуальныхЦен.Количество()>0 Тогда 
		Для каждого ВидИндивидуальнойЦены Из ПараметрыФормирования.ВидыИндивидуальныхЦен Цикл
			Если ЗначениеЗаполнено(ВидИндивидуальнойЦены.Контрагент) И ЗначениеЗаполнено(ВидИндивидуальнойЦены.ДоговорКонтрагента) Тогда
				СтруктураПараметров.Контрагент = ВидИндивидуальнойЦены.Контрагент;
				СтруктураПараметров.ДоговорКонтрагента = ВидИндивидуальнойЦены.ДоговорКонтрагента;
				СтруктураПараметров.ИндивидуальныеЦены = Истина;
				
				Таб = Новый ТабличныйДокумент;
				Таб.КлючПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_ОтчетПрайсЛист_Комплектующие";
	                        				
				ОбластьМакета = Макет.ПолучитьОбласть("ЗаголовокВидаПрайса");
				ОбластьМакета.Параметры.ЦеныНоменклатуры = "Потолки ("+ ВидИндивидуальнойЦены.Контрагент+")";
				Таб.Вывести(ОбластьМакета);
				
				ВывестиЦеныНаПродукцию(СтруктураПараметров, Макет, Таб);
				ПрисоединитьТабличныйДокумент(ТабличныйДокумент, Таб);
			КонецЕсли;	
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

