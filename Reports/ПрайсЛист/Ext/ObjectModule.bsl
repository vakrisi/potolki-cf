					ЦветФактурыПредставление = ВыборкаЦветов.ЦветФактуры;
					
					//Если СтруктураПараметров.ГруппировкаПоФактуре Тогда
					//	ЦветФактурыПредставление = ВыборкаЦветов.ЦветФактуры;
					//Иначе
					//	ЦветФактурыПредставление = Строка(ВыборкаЦветов.ЦветФактуры) + ", "+ВыборкаФактур.Фактура;
					//КонецЕсли;
					
					ЦеныНоменклатуры = Новый Соответствие;
					ЦеныСФотоНоменклатуры = Новый Соответствие;
					ВыборкаЦены = ВыборкаЦветов.Выбрать();
					Пока ВыборкаЦены.Следующий() Цикл
						ЦеныНоменклатуры.Вставить(ВыборкаЦены.ВидЦены, ВыборкаЦены.Цена);
						ЦеныСФотоНоменклатуры.Вставить(ВыборкаЦены.ВидЦены, ВыборкаЦены.ЦенаСФотопечатью);
					КонецЦикла;
					
					Если ВыводитьЦветКолонкой Тогда
						ОбластьМакета = Макет.ПолучитьОбласть("СтрокаФактураЦвет|Данные");
						//ОбластьМакета.Параметры.ЦветФактурыПредставление = ЦветФактурыПредставление;
						ОбластьМакета.Параметры.Заполнить(ВыборкаФактур);
						//ОбластьМакета.Параметры.ЦветФактуры = ВыборкаЦветов.ЦветФактуры;
						Таб.Вывести(ОбластьМакета, 4);	
						ОбластьМакета = Макет.ПолучитьОбласть("СтрокаФактураЦвет|Цвет");
						ОбластьМакета.Параметры.ЦветФактурыПредставление = ЦветФактурыПредставление;
						//ОбластьМакета.Параметры.ЦветФактуры = ВыборкаЦветов.ЦветФактуры;
						Таб.Присоединить(ОбластьМакета, 4);
					Иначе
						ОбластьМакета = Макет.ПолучитьОбласть("Строка|Данные");
						ОбластьМакета.Параметры.ЦветФактурыПредставление = ЦветФактурыПредставление;
						ОбластьМакета.Параметры.ЦветФактуры = ВыборкаЦветов.ЦветФактуры;
						Таб.Вывести(ОбластьМакета, 4);	
					КонецЕсли;
					
					
					Для НомерЦены = 0 По СписокВидовЦенМатериалов.Количество() - 1 Цикл
						ОбластьМакета = Макет.ПолучитьОбласть("Строка|Цена");
						ОбластьМакета.Параметры.Цена = ЦеныНоменклатуры.Получить(СписокВидовЦенМатериалов.Получить(НомерЦены).Значение);
						ОбластьМакета.Параметры.ЦенаСФотопечатью = ЦеныСФотоНоменклатуры.Получить(СписокВидовЦенМатериалов.Получить(НомерЦены).Значение);
						Таб.Присоединить(ОбластьМакета, 4);
					КонецЦикла;
				КонецЦикла;
			КонецЦикла;
		КонецЦикла;	
	КонецЦикла;
	
	Таб.ЗакончитьАвтогруппировкуСтрок();
		
КонецПроцедуры

Функция ТекстЗапросаЦенУслугРаскроя()
	Возврат
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СправочникВидыЦен.Ссылка КАК ВидЦены,
	|	ВЫБОР
	|		КОГДА СправочникВидыЦен.СсылочныйВидЦены = ИСТИНА
	|			ТОГДА СправочникВидыЦен.ВидЦеныНаУслугиПроизводства
	|		ИНАЧЕ СправочникВидыЦен.Ссылка
	|	КОНЕЦ КАК ВидЦеныРасчетный
	|ПОМЕСТИТЬ ВТ_ВидыЦен
	|ИЗ
	|	Справочник.ВидыЦен КАК СправочникВидыЦен
	|ГДЕ
	|	СправочникВидыЦен.Ссылка В(&ВидЦены)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СоответствиеВидовЦенЦенамУслугРаскрояСрезПоследних.Валюта КАК Валюта,
	//|	СоответствиеВидовЦенЦенамУслугРаскрояСрезПоследних.ЦеныУслугРаскроя.ВидЦен КАК ВидЦен,
	|	ВТ_ВидыЦен.ВидЦены КАК ВидЦены,
	|	СоответствиеВидовЦенЦенамУслугРаскрояСрезПоследних.ЦеныУслугРаскроя.Углы.(
	|		Ссылка КАК Ссылка,
	|		НомерСтроки КАК НомерСтроки,
	|		КоличествоОт КАК КоличествоОт,
	|		КоличествоДо КАК КоличествоДо,
	|		Цена КАК Цена,
	|		Номенклатура КАК Номенклатура
	|	) КАК Углы,
	|	СоответствиеВидовЦенЦенамУслугРаскрояСрезПоследних.ЦеныУслугРаскроя.ВырезыApply.(
	|		Ссылка КАК Ссылка,
	|		НомерСтроки КАК НомерСтроки,
	|		КоличествоОт КАК КоличествоОт,
	|		КоличествоДо КАК КоличествоДо,
	|		Цена КАК Цена,
	|		Номенклатура КАК Номенклатура
	|	) КАК ВырезыApply,
	|	СоответствиеВидовЦенЦенамУслугРаскрояСрезПоследних.ЦеныУслугРаскроя.Фотопечать.(
	|		Ссылка КАК Ссылка,
	|		НомерСтроки КАК НомерСтроки,
	|		КоличествоОт КАК КоличествоОт,
	|		КоличествоДо КАК КоличествоДо,
	|		Цена КАК Цена,
	|		Номенклатура КАК Номенклатура
	|	) КАК Фотопечать,
	|	СоответствиеВидовЦенЦенамУслугРаскрояСрезПоследних.ЦеныУслугРаскроя.ДлинаШвов.(
	|		Ссылка КАК Ссылка,
	|		НомерСтроки КАК НомерСтроки,
	|		КоличествоОт КАК КоличествоОт,
	|		КоличествоДо КАК КоличествоДо,
	|		Цена КАК Цена,
	|		Номенклатура КАК Номенклатура
	|	) КАК ДлинаШвов,
	|	СоответствиеВидовЦенЦенамУслугРаскрояСрезПоследних.ЦеныУслугРаскроя.ДлинаПользовательскихШвов.(
	|		Ссылка КАК Ссылка,
	|		НомерСтроки КАК НомерСтроки,
	|		КоличествоОт КАК КоличествоОт,
	|		КоличествоДо КАК КоличествоДо,
	|		Цена КАК Цена,
	|		Номенклатура КАК Номенклатура
	|	) КАК ДлинаПользовательскихШвов,
	|	СоответствиеВидовЦенЦенамУслугРаскрояСрезПоследних.ЦеныУслугРаскроя.ВнутренниеВырезы.(
	|		Ссылка КАК Ссылка,
	|		НомерСтроки КАК НомерСтроки,
	|		КоличествоОт КАК КоличествоОт,
	|		КоличествоДо КАК КоличествоДо,
	|		Цена КАК Цена,
	|		Номенклатура КАК Номенклатура
	|	) КАК ВнутренниеВырезы,
	|	СоответствиеВидовЦенЦенамУслугРаскрояСрезПоследних.ЦеныУслугРаскроя.Кривые.(
	|		Ссылка КАК Ссылка,
	|		НомерСтроки КАК НомерСтроки,
	|		КоличествоОт КАК КоличествоОт,
	|		КоличествоДо КАК КоличествоДо,
	|		Цена КАК Цена,
	|		Номенклатура КАК Номенклатура
	|	) КАК Кривые,
	|	СоответствиеВидовЦенЦенамУслугРаскрояСрезПоследних.ЦеныУслугРаскроя.ДлинаШвовМногофактурный.(
	|		Ссылка КАК Ссылка,
	|		НомерСтроки КАК НомерСтроки,
	|		КоличествоОт КАК КоличествоОт,
	|		КоличествоДо КАК КоличествоДо,
	|		Цена КАК Цена,
	|		Номенклатура КАК Номенклатура
	|	) КАК ДлинаШвовМногофактурный,
	|	СоответствиеВидовЦенЦенамУслугРаскрояСрезПоследних.ЦеныУслугРаскроя.СтоимостьУслугиЦентровкиШва КАК СтоимостьУслугиЦентровкиШва
	|ИЗ
	|	РегистрСведений.СоответствиеВидовЦенЦенамУслугРаскроя.СрезПоследних(
	|			&Период,
	//|			ВидЦен В (&ВидЦены) И
	|			ВидНоменклатуры = &ВидНоменклатуры И
	|			ВЫБОР
	|				КОГДА &ОтборПоВалюте
	|					ТОГДА Валюта = &Валюта
	|				ИНАЧЕ ИСТИНА
	|			КОНЕЦ) КАК СоответствиеВидовЦенЦенамУслугРаскрояСрезПоследних
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ВидыЦен КАК ВТ_ВидыЦен
	|		ПО (ВТ_ВидыЦен.ВидЦеныРасчетный = СоответствиеВидовЦенЦенамУслугРаскрояСрезПоследних.ВидЦен)";
	
КонецФункции

