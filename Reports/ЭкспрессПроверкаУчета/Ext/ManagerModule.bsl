Функция ПолучитьТаблицу_КонтрольРезервов2(СтруктураПараметров)
	
	ТаблицаРезультата = Новый ТаблицаЗначений;
	ТаблицаРезультата.Колонки.Добавить("Документ1"); 
	//ТаблицаРезультата.Колонки.Добавить("Пояснение1"); 
	ТаблицаРезультата.Колонки.Добавить("Документ2"); 
	//ТаблицаРезультата.Колонки.Добавить("Пояснение2");
	ТаблицаРезультата.Колонки.Добавить("Примечание");
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДатаНачала",    СтруктураПараметров.Получить("ДатаНачала"));
	Запрос.УстановитьПараметр("ДатаОкончания", СтруктураПараметров.Получить("ДатаОкончания"));
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТоварыВРезервеНаСкладахОстатки.ДокументРезерва КАК Документ1,
	|	ТоварыВРезервеНаСкладахОстатки.Номенклатура КАК Номенклатура,
	|	ТоварыВРезервеНаСкладахОстатки.КоличествоОстаток КАК КоличествоОстаток,
	|	ЗаказПокупателяТовары.Ссылка КАК СсылкаТовар,
	|	ЗаказПокупателяМатериалы.Ссылка КАК СсылкаМатериал
	|ПОМЕСТИТЬ ВТ_Резерв
	|ИЗ
	|	РегистрНакопления.ТоварыВРезервеНаСкладах.Остатки(, ) КАК ТоварыВРезервеНаСкладахОстатки
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаказПокупателя.Товары КАК ЗаказПокупателяТовары
	|		ПО ТоварыВРезервеНаСкладахОстатки.ДокументРезерва.Ссылка = ЗаказПокупателяТовары.Ссылка
	|			И ТоварыВРезервеНаСкладахОстатки.Номенклатура = ЗаказПокупателяТовары.Номенклатура
	|			И ТоварыВРезервеНаСкладахОстатки.ХарактеристикаНоменклатуры = ЗаказПокупателяТовары.ХарактеристикаНоменклатуры
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаказПокупателя.Материалы КАК ЗаказПокупателяМатериалы
	|		ПО ТоварыВРезервеНаСкладахОстатки.ДокументРезерва.Ссылка = ЗаказПокупателяМатериалы.Ссылка
	|			И ТоварыВРезервеНаСкладахОстатки.Номенклатура = ЗаказПокупателяМатериалы.Номенклатура
	|			И ТоварыВРезервеНаСкладахОстатки.ХарактеристикаНоменклатуры = ЗаказПокупателяМатериалы.ХарактеристикаНоменклатуры
	|ГДЕ
	|	ТоварыВРезервеНаСкладахОстатки.ДокументРезерва ССЫЛКА Документ.ЗаказПокупателя
	|	И ЗаказПокупателяТовары.Ссылка ЕСТЬ NULL
	|	И ЗаказПокупателяМатериалы.Ссылка ЕСТЬ NULL
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Резерв.Документ1 КАК Документ1,
	|	ВТ_Резерв.Номенклатура КАК Номенклатура,
	|	ВТ_Резерв.КоличествоОстаток КАК КоличествоОстаток,
	|	ТоварыВРезервеНаСкладах.Регистратор КАК Документ2
	|ИЗ
	|	ВТ_Резерв КАК ВТ_Резерв
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыВРезервеНаСкладах КАК ТоварыВРезервеНаСкладах
	|		ПО ВТ_Резерв.Документ1 = ТоварыВРезервеНаСкладах.ДокументРезерва
	|ГДЕ
	|	(ТоварыВРезервеНаСкладах.Период >= &ДатаНачала
	|			ИЛИ &ДатаНачала = ДАТАВРЕМЯ(1, 1, 1))
	|	И (ТоварыВРезервеНаСкладах.Период <= &ДатаОкончания
	|			ИЛИ &ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1))
	|ИТОГИ
	|	МАКСИМУМ(Номенклатура),
	|	МАКСИМУМ(КоличествоОстаток)
	|ПО
	|	Документ1,
	|	Документ2";
	
	
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаЗаказовПокупателей = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Примечание = "";
	Пока ВыборкаЗаказовПокупателей.Следующий() Цикл
		Выборка = ВыборкаЗаказовПокупателей.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока Выборка.Следующий() Цикл
			Примечание = "Номенклатура """ + Выборка.Номенклатура + """ находится в резерве в количестве " + Выборка.КоличествоОстаток + ", которого нет в заказе покупателя.";	
			НоваяСтрока = ТаблицаРезультата.Добавить();
			НоваяСтрока.Документ1 = Выборка.Документ1;
			НоваяСтрока.Документ2 = Выборка.Документ2;
			НоваяСтрока.Примечание = Примечание;
		КонецЦикла;
	КонецЦикла;
	
	Возврат ТаблицаРезультата;
	
КонецФункции

Функция ВывестиРезультатПроверки_КонтрольРезервов2(ТаблицаРезультата)	
	
