КонецФункции

Функция ПолучитьТаблицу_КонтрольРезервов(СтруктураПараметров)
	
	ТаблицаРезультата = Новый ТаблицаЗначений;
	ТаблицаРезультата.Колонки.Добавить("Документ1"); 
	//ТаблицаРезультата.Колонки.Добавить("Пояснение1"); 
	ТаблицаРезультата.Колонки.Добавить("Документ2"); 
	//ТаблицаРезультата.Колонки.Добавить("Пояснение2");
	ТаблицаРезультата.Колонки.Добавить("Примечание");
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДатаНачала",    СтруктураПараметров.Получить("ДатаНачала"));
	Запрос.УстановитьПараметр("ДатаОкончания", СтруктураПараметров.Получить("ДатаОкончания"));
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТоварыВРезервеНаСкладахОстатки.ДокументРезерва КАК Документ1,
	|	ТоварыВРезервеНаСкладах.Регистратор КАК Документ2,
	|	ТоварыВРезервеНаСкладахОстатки.Номенклатура КАК Номенклатура,
	|	ТоварыВРезервеНаСкладахОстатки.КоличествоОстаток КАК КоличествоОстаток,
	|	ТоварыВРезервеНаСкладахОстатки.ДокументРезерва.Проведен КАК ДокументРезерваПроведен,
	|	ТоварыВРезервеНаСкладахОстатки.ДокументРезерва.ТекущийСтатус КАК ДокументРезерваТекущийСтатус
	|ИЗ
	|	РегистрНакопления.ТоварыВРезервеНаСкладах.Остатки(, ) КАК ТоварыВРезервеНаСкладахОстатки
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыВРезервеНаСкладах КАК ТоварыВРезервеНаСкладах
	|		ПО ТоварыВРезервеНаСкладахОстатки.ДокументРезерва = ТоварыВРезервеНаСкладах.ДокументРезерва
	|ГДЕ
	|	ТоварыВРезервеНаСкладахОстатки.ДокументРезерва ССЫЛКА Документ.ЗаказПокупателя
	|	И (ТоварыВРезервеНаСкладах.Период >= &ДатаНачала
	|			ИЛИ &ДатаНачала = ДАТАВРЕМЯ(1, 1, 1))
	|	И (ТоварыВРезервеНаСкладах.Период <= &ДатаОкончания
	|			ИЛИ &ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1))
	|	И (НЕ ТоварыВРезервеНаСкладахОстатки.ДокументРезерва.Проведен
	|			ИЛИ ТоварыВРезервеНаСкладахОстатки.ДокументРезерва.ТекущийСтатус В (ЗНАЧЕНИЕ(Справочник.СтатусыЗаказовПокупателей.Выполнен), ЗНАЧЕНИЕ(Справочник.СтатусыЗаказовПокупателей.Закрыт), ЗНАЧЕНИЕ(Справочник.СтатусыЗаказовПокупателей.Отменен)))
	|ИТОГИ
	|	МАКСИМУМ(Документ2),
	|	МАКСИМУМ(КоличествоОстаток)
	|ПО
	|	Документ1,
	|	Номенклатура";
	
	
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаЗаказовПокупателей = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаЗаказовПокупателей.Следующий() Цикл
		Примечание = "";
		Если НЕ ВыборкаЗаказовПокупателей.ДокументРезерваПроведен Тогда
			Примечание =  "По непроведенному документу зарезервировано:"+Символы.ПС;	
		ИначеЕсли ВыборкаЗаказовПокупателей.ДокументРезерваТекущийСтатус = Справочники.СтатусыЗаказовПокупателей.Выполнен Тогда
			Примечание =  "По документу в статусе ВЫПОЛНЕН зарезервировано:"+Символы.ПС;
		ИначеЕсли ВыборкаЗаказовПокупателей.ДокументРезерваТекущийСтатус = Справочники.СтатусыЗаказовПокупателей.Закрыт Тогда
			Примечание =  "По документу в статусе ЗАКРЫТ зарезервировано:"+Символы.ПС;
	        ИначеЕсли ВыборкаЗаказовПокупателей.ДокументРезерваТекущийСтатус = Справочники.СтатусыЗаказовПокупателей.Отменен Тогда
			Примечание =  "По документу в статусе ОТМЕНЕН зарезервировано:"+Символы.ПС;
		КонецЕсли;	
		Выборка = ВыборкаЗаказовПокупателей.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока Выборка.Следующий() Цикл
			Примечание = Примечание + ?(ПустаяСтрока(Примечание), "", Символы.ПС) + """" + Выборка.Номенклатура + """ в количестве " + Выборка.КоличествоОстаток;	
		КонецЦикла;
		НоваяСтрока = ТаблицаРезультата.Добавить();
		НоваяСтрока.Документ1 = ВыборкаЗаказовПокупателей.Документ1;
		НоваяСтрока.Документ2 = ВыборкаЗаказовПокупателей.Документ2;
		НоваяСтрока.Примечание = Примечание;
	КонецЦикла;
	
	Возврат ТаблицаРезультата;
	
КонецФункции

Функция ВывестиРезультатПроверки_КонтрольРезервов(ТаблицаРезультата)	
	
	Таб = Новый ТабличныйДокумент;
	Макет = ПолучитьОбщийМакет("МакетЭкспрессПроверкаУчета");
	
	Таб.НачатьАвтогруппировкуСтрок();
	
	ОбластьМакета = Макет.ПолучитьОбласть("Шапка_ВидПроверки");
	ОбластьМакета.Параметры.ВидПроверки = "Контроль резервов.";
	Таб.Вывести(ОбластьМакета, 1);
	
	Если ТаблицаРезультата.Количество() = 0 Тогда
		ОбластьМакета = Макет.ПолучитьОбласть("Шапка_ОшибокНет");
		Таб.Вывести(ОбластьМакета, 1);
	Иначе
		ОбластьМакета = Макет.ПолучитьОбласть("Шапка_ОшибкиЕсть");
		ОбластьМакета.Параметры.КоличествоОшибок = ТаблицаРезультата.Количество();
		Таб.Вывести(ОбластьМакета, 1);
		
		ОбластьМакета = Макет.ПолучитьОбласть("Шапка_Таблица");
		ОбластьМакета.Параметры.Документ1  = "ЗаказПокупателю";
		ОбластьМакета.Параметры.Документ2  = "Резервирование";
		Таб.Вывести(ОбластьМакета, 2, "Документ", Ложь);
		
		Ном = 1;
		Для Каждого ТекущаяСтрока Из ТаблицаРезультата Цикл
			ОбластьМакета = Макет.ПолучитьОбласть("Строка_Таблица");
			ЗаполнитьЗначенияСвойств(ОбластьМакета.Параметры, ТекущаяСтрока);
			ОбластьМакета.Параметры.Ном = Ном;
			Таб.Вывести(ОбластьМакета, 2, "Документ", Ложь);
			Ном = Ном + 1;
			
		КонецЦикла;
	КонецЕсли;
	
	Таб.ЗакончитьАвтогруппировкуСтрок();	
	Возврат Таб;
	
КонецФункции


