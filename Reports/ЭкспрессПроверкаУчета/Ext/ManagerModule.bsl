		ОбластьМакета.Параметры.ТекстПоясненияИсправления = "Процедура исправления изменяет дату документа ""Реализация товаров и услуг"" на дату документа ""Заказ покупателя"", увеличенную на 1 секунду";
		
		Таб.Вывести(ОбластьМакета, 1);
		
		ОбластьМакета = Макет.ПолучитьОбласть("Шапка_Таблица");
		ОбластьМакета.Параметры.Документ1 = "Реализация";
