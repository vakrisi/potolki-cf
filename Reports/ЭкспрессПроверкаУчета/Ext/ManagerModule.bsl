	КоличествоОшибокСч = 0;
	ТабВрем = Новый ТабличныйДокумент;
	
	Если КоличествоОшибок = 0 Тогда
		ОбластьМакета = Макет.ПолучитьОбласть("Шапка_ОшибокНет");
		Таб.Вывести(ОбластьМакета, 1);
	Иначе
		
		ТабВрем.НачатьАвтогруппировкуСтрок();
		
		ОбластьМакета = Макет.ПолучитьОбласть("Шапка_отрицДС");
		ТабВрем.Вывести(ОбластьМакета, 1);
		
		Пока Выборка.Следующий() Цикл
			
			ОбластьМакета = Макет.ПолучитьОбласть("Шапка_отрицДС_организация");
			ОбластьМакета.Параметры.Заполнить(Выборка);
			ТабВрем.Вывести(ОбластьМакета, 2);
			
			ВыборкаСчетКасса =  Выборка.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			Пока ВыборкаСчетКасса.Следующий() Цикл 
				
				ВыборкаВалюта = ВыборкаСчетКасса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
				Пока ВыборкаВалюта.Следующий() Цикл
					
					ОбластьМакета = Макет.ПолучитьОбласть("Шапка_отрицДС_счеткасса");
					ОбластьМакета.Параметры.Заполнить(ВыборкаВалюта);
					ТабВрем.Вывести(ОбластьМакета, 3);
					
					ВыборкаРегистратор = ВыборкаВалюта.Выбрать();
					Ном = 1;
					ЭтоПервый = Истина;
					Пока ВыборкаРегистратор.Следующий() Цикл
						ОбластьМакета = Макет.ПолучитьОбласть("Строка_отрицДС_остатки");
						ОбластьМакета.Параметры.Заполнить(ВыборкаРегистратор);
						ОбластьМакета.Параметры.Ном = Ном;				
						ТабВрем.Вывести(ОбластьМакета, 4);
						Ном = Ном + 1; 
						
						КоличествоОшибокСч = КоличествоОшибокСч + 1;
						
						НоваяСтрока = ОбъектыКИсправлению.Добавить();
						НоваяСтрока.Документ1 = ВыборкаРегистратор.Регистратор;
						НоваяСтрока.Исправить = "ИсправитьОтрицательныеОстаткиДС";
						
					КонецЦикла;	
					
				КонецЦикла;				
			КонецЦикла;		
		КонецЦикла;
		
		ТабВрем.ЗакончитьАвтогруппировкуСтрок();
		
