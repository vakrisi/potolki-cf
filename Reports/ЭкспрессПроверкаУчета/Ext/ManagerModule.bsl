Функция ПолучитьТаблицу_РеализацияРаньшеЗаказаНаПроизводство(ОбъектыКИсправлению, СтруктураПараметров)
	
	ТаблицаРезультата = Новый ТаблицаЗначений;
	ТаблицаРезультата.Колонки.Добавить("Документ1");
	ТаблицаРезультата.Колонки.Добавить("Пояснение1");
	ТаблицаРезультата.Колонки.Добавить("Документ2");
	ТаблицаРезультата.Колонки.Добавить("Пояснение2");
	ТаблицаРезультата.Колонки.Добавить("Примечание");
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДатаНачала",    СтруктураПараметров.Получить("ДатаНачала"));
	Запрос.УстановитьПараметр("ДатаОкончания", СтруктураПараметров.Получить("ДатаОкончания"));
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ДанныеДокумента.Ссылка КАК Документ1,
	|	ДанныеДокумента.Дата КАК Пояснение1,
	|	ДанныеДокумента.Основание.Ссылка КАК Документ2,
	|	ДанныеДокумента.Основание.Дата КАК Пояснение2
