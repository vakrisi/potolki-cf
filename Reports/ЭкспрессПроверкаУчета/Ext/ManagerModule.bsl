#Область ДатаДокументаРТИУМеньшеЧемДатаЗаказаНаПроизводствоСлучай2
//================================ Дата реализации товаров и услуг меньше чем дата заказа на производство (случай подчинения докментов заказу покупателя) =======
//НЕ ИСПОЛЬЗУЕТСЯ
Функция ВыполнитьПроверку_РеализацияРаньшеЗНПпоЗД(ОбъектыКИсправлению, СтруктураПараметров) Экспорт
	
	РезультатПроверки = ПолучитьТаблицу_РеализацияРаньшеЗНПпоЗД(ОбъектыКИсправлению, СтруктураПараметров);
	ТабДок = ВывестиРезультатПроверки_РеализацияРаньшеЗНПпоЗД(РезультатПроверки);
	Возврат ТабДок;
	
КонецФункции

Функция ПолучитьТаблицу_РеализацияРаньшеЗНПпоЗД(ОбъектыКИсправлению, СтруктураПараметров)
	
	ТаблицаРезультата = Новый ТаблицаЗначений;
	ТаблицаРезультата.Колонки.Добавить("Документ1");
	ТаблицаРезультата.Колонки.Добавить("Пояснение1");
	ТаблицаРезультата.Колонки.Добавить("Документ2");
	ТаблицаРезультата.Колонки.Добавить("Пояснение2");
	ТаблицаРезультата.Колонки.Добавить("Примечание");
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДатаНачала",    СтруктураПараметров.Получить("ДатаНачала"));
	Запрос.УстановитьПараметр("ДатаОкончания", СтруктураПараметров.Получить("ДатаОкончания"));
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	МИНИМУМ(ЗаказНаПроизводство.Ссылка) КАК Ссылка,
	|	ЗаказНаПроизводство.ДокументОснование КАК Основание
	|ПОМЕСТИТЬ ВТ_ЗаказыПроизводства
	|ИЗ
	|	Документ.ЗаказНаПроизводство КАК ЗаказНаПроизводство
	|ГДЕ
	|	ЗаказНаПроизводство.ДокументОснование ССЫЛКА Документ.ЗаказДоговор
	|	И ЗаказНаПроизводство.Проведен
	|	И ЗаказНаПроизводство.ДокументОснование.Проведен
	|
	|СГРУППИРОВАТЬ ПО
	|	ЗаказНаПроизводство.ДокументОснование
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	МИНИМУМ(РеализацияТоваровИУслуг.Ссылка) КАК Ссылка,
	|	РеализацияТоваровИУслуг.Основание КАК Основание
	|ПОМЕСТИТЬ ВТ_Реализации
	|ИЗ
	|	Документ.РеализацияТоваровИУслуг КАК РеализацияТоваровИУслуг
	|ГДЕ
	|	РеализацияТоваровИУслуг.Основание ССЫЛКА Документ.ЗаказДоговор
	|	И РеализацияТоваровИУслуг.Проведен
	|	И РеализацияТоваровИУслуг.Основание.Проведен
	|
	|СГРУППИРОВАТЬ ПО
	|	РеализацияТоваровИУслуг.Основание
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ЗаказыПроизводства.Основание КАК Основание,
	|	ВТ_ЗаказыПроизводства.Ссылка КАК Документ2,
	|	ВТ_Реализации.Ссылка КАК Документ1,
	|	ВТ_Реализации.Ссылка.Дата КАК Пояснение1,
	|	ВТ_ЗаказыПроизводства.Ссылка.Дата КАК Пояснение2
	|ИЗ
	|	ВТ_Реализации КАК ВТ_Реализации
	|		ПОЛНОЕ СОЕДИНЕНИЕ ВТ_ЗаказыПроизводства КАК ВТ_ЗаказыПроизводства
	|		ПО (ВТ_ЗаказыПроизводства.Основание = ВТ_Реализации.Основание)
	|ГДЕ
	|	НЕ ВТ_Реализации.Ссылка ЕСТЬ NULL
	|	И НЕ ВТ_ЗаказыПроизводства.Ссылка ЕСТЬ NULL
	|	И ВТ_Реализации.Ссылка.Дата < ВТ_ЗаказыПроизводства.Ссылка.Дата";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = ТаблицаРезультата.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);	
		НоваяСтрока.Примечание = ТекстОшибкиДополнительно(Выборка.Пояснение1, Выборка.Пояснение2);	
		
		НоваяСтрока = ОбъектыКИсправлению.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		НоваяСтрока.Исправить = "ПоставитьДатуРеализацииПозжеДатыЗНПпоЗД";
	КонецЦикла;
	
	Возврат ТаблицаРезультата;
	
КонецФункции

Функция ВывестиРезультатПроверки_РеализацияРаньшеЗНПпоЗД(ТаблицаРезультата)
	
	
	Таб = Новый ТабличныйДокумент;
	Макет = ПолучитьОбщийМакет("макетЭкспрессПроверкаУчета");
	
	Таб.НачатьАвтогруппировкуСтрок();
	
	ОбластьМакета = Макет.ПолучитьОбласть("Шапка_ВидПроверки");
	ОбластьМакета.Параметры.ВидПроверки = """Реализация товаров и услуг"" имеет дату меньшую чем документ ""Заказ на производство"" (при подчинении документов одному заказу покупателя)";
	Таб.Вывести(ОбластьМакета, 1);
	
	Если ТаблицаРезультата.Количество() = 0 Тогда
		ОбластьМакета = Макет.ПолучитьОбласть("Шапка_ОшибокНет");
		Таб.Вывести(ОбластьМакета, 1);
	Иначе
		ОбластьМакета = Макет.ПолучитьОбласть("Шапка_ОшибкиЕсть_Исправить");
		ОбластьМакета.Параметры.КоличествоОшибок = ТаблицаРезультата.Количество();
		ОбластьМакета.Параметры.Исправить = "ПоставитьДатуРеализацииПозжеДатыЗНПпоЗД";
		Таб.Вывести(ОбластьМакета, 1);
		
		ОбластьМакета = Макет.ПолучитьОбласть("Шапка_Таблица");
		ОбластьМакета.Параметры.Документ1 = "Реализация";
		ОбластьМакета.Параметры.Пояснение1 = "Дата";
		ОбластьМакета.Параметры.Документ2 = "Заказ на производство";
		ОбластьМакета.Параметры.Пояснение2 = "Дата";
		Таб.Вывести(ОбластьМакета, 2, "Документ", Ложь);
		
		Ном = 1;
		Для Каждого ТекущаяСтрока Из ТаблицаРезультата Цикл
			ОбластьМакета = Макет.ПолучитьОбласть("Строка_Таблица");
			ЗаполнитьЗначенияСвойств(ОбластьМакета.Параметры, ТекущаяСтрока);
			ОбластьМакета.Параметры.Ном = Ном;
			Таб.Вывести(ОбластьМакета, 2, "Документ", Ложь);
			Ном = Ном + 1;
			
		КонецЦикла;
	КонецЕсли;
	
	Таб.ЗакончитьАвтогруппировкуСтрок();
	
	Возврат Таб;
	
КонецФункции

Функция ИсправитьОбъект_РеализацияРаньшеЗНПпоЗД(ДокументРеализация, ДокументЗНП) Экспорт
	Если НачалоДня(ДокументРеализация.Дата) <>  НачалоДня(ДокументЗНП.Дата) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Результат1 = Истина;
	ОбъектЗНП = ДокументЗНП.ПолучитьОбъект();
	ОбъектЗНП.Дата = ДокументРеализация.Дата - 2;
	
	Попытка
		Если ОбъектЗНП.Проведен Тогда
			ОбъектЗНП.Записать(РежимЗаписиДокумента.Проведение);
		Иначе
			ОбъектЗНП.Записать();
		КонецЕсли;
	Исключение
		Результат1 = Ложь;
	КонецПопытки;
	
	Результат2 = ИсправитьОбъектВыпускПродукцииПоЗНП(ДокументЗНП);
	
	Возврат Результат1 и Результат2;
	
КонецФункции

Функция ИсправитьОбъектВыпускПродукцииПоЗНП(ДокументЗНП) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ВыпускПродукции.Ссылка,
	|	ВыпускПродукции.Дата,
	|	ВыпускПродукции.Основание.Дата КАК ОснованиеДата
	|ИЗ
	|	Документ.ВыпускПродукции КАК ВыпускПродукции
	|ГДЕ
	|	ВыпускПродукции.Основание = &Основание
	|	И НАЧАЛОПЕРИОДА(ВыпускПродукции.Дата, ДЕНЬ) = НАЧАЛОПЕРИОДА(ВыпускПродукции.Основание.Дата, ДЕНЬ)
	|	И ВыпускПродукции.Дата <= ВыпускПродукции.Основание.Дата";
	
	Запрос.УстановитьПараметр("Основание", ДокументЗНП);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	Результат = Истина;
	
	Пока Выборка.Следующий() Цикл
		ОбъектВыпускПродукции = Выборка.Ссылка.ПолучитьОбъект();
		ОбъектВыпускПродукции.Дата = Выборка.ОснованиеДата + 1;
		
		Попытка
			Если ОбъектВыпускПродукции.Проведен Тогда
				ОбъектВыпускПродукции.Записать(РежимЗаписиДокумента.Проведение);
			Иначе
				ОбъектВыпускПродукции.Записать();
			КонецЕсли;
		Исключение
			Результат = Ложь;
		КонецПопытки;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

