		ОбластьМакета.Параметры.КоличествоОшибок = ТаблицаРезультата.Количество();
		ОбластьМакета.Параметры.Исправить = "КорректировкаИспользованияОстатковПленки";
		ОбластьМакета.Параметры.ТекстПоясненияИсправления = "Процедура исправления в документах ""Выпуск продукции"" исправляет некорректное использование номенклатуры ""Остатки пленки"":
		|- единица измерения устанавливается из базовой единицы измерения номенклатуры;
		|- коэффициент устанавливается равным единице;
		|- количество устанавливается равным ""Количество * Коэффициент"" из документа-основания ""Заказ на производство"" по полотну";
		Таб.Вывести(ОбластьМакета, 1);
		
		ОбластьМакета = Макет.ПолучитьОбласть("Шапка_Таблица");
		ОбластьМакета.Параметры.Документ1 = "Выпуск продукции";
		ОбластьМакета.Параметры.Пояснение1 = "";
		ОбластьМакета.Параметры.Документ2 = "";
		ОбластьМакета.Параметры.Пояснение2 = "";
		Таб.Вывести(ОбластьМакета, 2, "Документ", Ложь);
		
		Ном = 1;
		Для Каждого ТекущаяСтрока Из ТаблицаРезультата Цикл
			ОбластьМакета = Макет.ПолучитьОбласть("Строка_Таблица");
			ЗаполнитьЗначенияСвойств(ОбластьМакета.Параметры, ТекущаяСтрока);
			ОбластьМакета.Параметры.Ном = Ном;
			Таб.Вывести(ОбластьМакета, 2, "Документ", Ложь);
			Ном = Ном + 1;
			
		КонецЦикла;
	КонецЕсли;
	
	Таб.ЗакончитьАвтогруппировкуСтрок();
	Возврат Таб;
	
КонецФункции

Функция ИсправитьОбъект_КорректировкаИспользованияОстатковПленкиМатериалаЗаказчика(ДокументВыпускПродукции, ЭтоОстаток = Истина) Экспорт
	
	ДокОбъект = ДокументВыпускПродукции.ПолучитьОбъект();
	
	Для каждого СтрокаМатериалов из ДокОбъект.Материалы Цикл
		Если (ЭтоОстаток И СтрокаМатериалов.Номенклатура = Справочники.Номенклатура.ОстаткиПленки)
			ИЛИ (НЕ ЭтоОстаток И СтрокаМатериалов.Номенклатура = Справочники.Номенклатура.ПолотноЗаказчика) Тогда
			КоличествоПолотнаВЗаказе = ПолучитьКоличествоПолотнаВЗаказе(ДокОбъект.Основание);
			Если КоличествоПолотнаВЗаказе > 0 Тогда
				СтрокаМатериалов.ЕдиницаИзмерения = СтрокаМатериалов.Номенклатура.БазоваяЕдиницаИзмерения;
				СтрокаМатериалов.Коэффициент = 1;
				СтрокаМатериалов.Количество = КоличествоПолотнаВЗаказе;
			Иначе
				Если СтрокаМатериалов.Коэффициент = 0 Тогда
					СтрокаМатериалов.Коэффициент = 1;
				КонецЕсли;
				СтрокаМатериалов.ЕдиницаИзмерения = СтрокаМатериалов.Номенклатура.БазоваяЕдиницаИзмерения;
				СтрокаМатериалов.Количество = СтрокаМатериалов.Количество * СтрокаМатериалов.Коэффициент;
				СтрокаМатериалов.Коэффициент = 1;
			КонецЕсли;
			
		КонецЕсли;
	КонецЦикла;
	
	Попытка
		Если ДокОбъект.Проведен Тогда
			ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
		Иначе
			ДокОбъект.Записать();
		КонецЕсли;
		Возврат Новый Структура("Успешно, ОписаниеОшибки", Истина, "");
	Исключение
		//Сообщить("Попытка присвоить дату " + ОбъектВыпуск.Дата + " для " + ОбъектВыпуск + ". Ошибка: " + ОписаниеОшибки());
		Возврат Новый Структура("Успешно, ОписаниеОшибки", Ложь, ОписаниеОшибки());
	КонецПопытки;
	
КонецФункции

Функция ПолучитьКоличествоПолотнаВЗаказе(ДокументЗНП)
	
	Результат = 0;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", ДокументЗНП);
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЕСТЬNULL(СУММА(ЗНПМатериалы.Количество * ЗНПМатериалы.Коэффициент), 0) КАК Количество
	|ИЗ
	|	Документ.ЗаказНаПроизводство.Материалы КАК ЗНПМатериалы
	|ГДЕ
	|	ЗНПМатериалы.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Справочник.ВидыНоменклатуры.Полотно)
	|	И ЗНПМатериалы.Ссылка.ВидЗаказа = ЗНАЧЕНИЕ(Перечисление.ВидыЗаказовНаПроизводство.ПроизводствоПотолка)
	|	И ЗНПМатериалы.Ссылка = &Ссылка";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Результат = Выборка.Количество;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

