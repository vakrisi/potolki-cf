				Пока ВыборкаСерия.Следующий() Цикл
					ОбластьМакета = Макет.ПолучитьОбласть("Шапка_отриц_остатки_серия");
					ОбластьМакета.Параметры.СерияНоменклатуры = ВыборкаСерия.СерияНоменклатуры;
