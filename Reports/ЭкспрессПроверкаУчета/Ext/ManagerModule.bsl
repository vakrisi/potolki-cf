Функция ИсправитьОбъект_ОтрицательныеОстаткиДС(ДокументРасходаДС) Экспорт
	
	Результат = Истина;
	
	Если ТипЗнч(ДокументРасходаДС) = Тип("ДокументСсылка.РасходныйКассовыйОрдер") Тогда
		
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("Касса", ДокументРасходаДС.Касса);
		Запрос.УстановитьПараметр("ДатаРасходаДС", ДокументРасходаДС.Дата);		
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДанныеДокумента.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.ПриходныйКассовыйОрдер КАК ДанныеДокумента
		|ГДЕ
		|	ДанныеДокумента.Проведен
		|	И ДанныеДокумента.Касса = &Касса
		|	И НАЧАЛОПЕРИОДА(ДанныеДокумента.Дата, ДЕНЬ) = НАЧАЛОПЕРИОДА(&ДатаРасходаДС, ДЕНЬ)
		|	И НЕ(ЧАС(ДанныеДокумента.Дата) = 0
		|				И МИНУТА(ДанныеДокумента.Дата) = 0
		|				И СЕКУНДА(ДанныеДокумента.Дата) = 1)";
		
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			ДокОбъект = Выборка.Ссылка.ПолучитьОбъект();
			ДокОбъект.Дата = НачалоДня(ДокОбъект.Дата) + 1;
			Попытка
				ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
			Исключение
				Сообщить("Ошибка проведения " + Выборка.Ссылка + ". " + ОписаниеОшибки());
				Результат = Ложь;
			КонецПопытки;
		КонецЦикла;
		
	ИначеЕсли ТипЗнч(ДокументРасходаДС) = Тип("ДокументСсылка.СписаниеСРасчетногоСчета") Тогда
		
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("Счет", ДокументРасходаДС.Счет);
		Запрос.УстановитьПараметр("ДатаРасходаДС", ДокументРасходаДС.Дата);		
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДанныеДокумента.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.ПоступлениеНаРасчетныйСчет КАК ДанныеДокумента
		|ГДЕ
		|	ДанныеДокумента.Проведен
		|	И ДанныеДокумента.Счет = &Счет
		|	И НАЧАЛОПЕРИОДА(ДанныеДокумента.Дата, ДЕНЬ) = НАЧАЛОПЕРИОДА(&ДатаРасходаДС, ДЕНЬ)
		|	И НЕ(ЧАС(ДанныеДокумента.Дата) = 0
		|				И МИНУТА(ДанныеДокумента.Дата) = 0
		|				И СЕКУНДА(ДанныеДокумента.Дата) = 1)";
		
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			ДокОбъект = Выборка.Ссылка.ПолучитьОбъект();
			ДокОбъект.Дата = НачалоДня(ДокОбъект.Дата) + 1;
			Попытка
				ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
			Исключение
				Сообщить("Ошибка проведения " + Выборка.Ссылка + ". " + ОписаниеОшибки());
				Результат = Ложь;
			КонецПопытки;
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти


#Область ПослеОбновления
//============================================== Документы к обработке после обновления (+)========================================

Функция ВыполнитьПроверку_ДокументыКОбработкеПослеОбновления() Экспорт
	
	ТабДок = ВывестиРезультатПроверки_ДокументыКОбработкеПослеОбновления();
	Возврат ТабДок;
	
КонецФункции

Функция ВывестиРезультатПроверки_ДокументыКОбработкеПослеОбновления()
	
	Таб = Новый ТабличныйДокумент;
	Макет = ПолучитьОбщийМакет("макетЭкспрессПроверкаУчета");
	
	Таб.НачатьАвтогруппировкуСтрок();
	
	ОбластьМакета = Макет.ПолучитьОбласть("Шапка_ВидПроверки");
	ОбластьМакета.Параметры.ВидПроверки = "Документы, которые следует обработать после обновления программы";
	Таб.Вывести(ОбластьМакета, 1);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ 
	|	ВерсияПрограммы КАК Версия,
	|	Документ,
	|	ДокументДата КАК Дата
	|ИЗ
	|	РегистрСведений.ОбъектыКОбработкеПослеОбновленияРекомендуемые
	|УПОРЯДОЧИТЬ ПО Версия, ДокументДата";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Если Выборка.Количество() = 0 Тогда
		ОбластьМакета = Макет.ПолучитьОбласть("Шапка_ОшибокНет");
		Таб.Вывести(ОбластьМакета, 1);
	Иначе						
		ОбластьМакета = Макет.ПолучитьОбласть("Шапка_ОшибкиЕсть_Исправить");
		ОбластьМакета.Параметры.Исправить = "ЗапуститьОбработчикПроведенияДокументовПослеОбновления";
		ОбластьМакета.Параметры.КоличествоОшибок = Выборка.Количество();
		ОбластьМакета.Параметры.ТекстПоясненияИсправления = "Процедура исправления запускает обработку документов после обновления";
		
		Таб.Вывести(ОбластьМакета, 1);	
		
		ОбластьМакета = Макет.ПолучитьОбласть("Шапка_КОбработке");
		Таб.Вывести(ОбластьМакета, 2, "Документ", Ложь);
		
		Ном = 1;
		Пока Выборка.Следующий() Цикл
			
			ОбластьМакета = Макет.ПолучитьОбласть("Строка_КОбработке");
			ОбластьМакета.Параметры.Ном = Ном;
			ОбластьМакета.Параметры.Версия = Выборка.Версия;					
			ОбластьМакета.Параметры.Документ = Выборка.Документ;
			ОбластьМакета.Параметры.ДатаДокумента = Выборка.Дата;
			Таб.Вывести(ОбластьМакета, 2, "Документ", Ложь);			
			
			Ном = Ном + 1;
		КонецЦикла;
		
	КонецЕсли;
	
	
	Таб.ЗакончитьАвтогруппировкуСтрок();	
	
	Возврат Таб;
	
КонецФункции  

#КонецОбласти

#Область ДатаДокументаПТИУМеньшеЗаказаПоставщику
//============================================== Дата поступления товаров и услуг меньше чем дата заказа поставщику (+)========================================

Функция ВыполнитьПроверку_ПоступлениеРаньшеЗаказаПоставщику(ОбъектыКИсправлению, СтруктураПараметров) Экспорт
	
	РезультатПроверки = ПолучитьТаблицу_ПоступлениеРаньшеЗаказаПоставщику(ОбъектыКИсправлению, СтруктураПараметров);
	ТабДок = ВывестиРезультатПроверки_ПоступлениеРаньшеЗаказаПоставщику(РезультатПроверки);
	Возврат ТабДок;
	
КонецФункции

Функция ПолучитьТаблицу_ПоступлениеРаньшеЗаказаПоставщику(ОбъектыКИсправлению, СтруктураПараметров)
	
	ТаблицаРезультата = Новый ТаблицаЗначений;
	ТаблицаРезультата.Колонки.Добавить("Документ1");
	ТаблицаРезультата.Колонки.Добавить("Пояснение1");
	ТаблицаРезультата.Колонки.Добавить("Документ2");
	ТаблицаРезультата.Колонки.Добавить("Пояснение2");
	ТаблицаРезультата.Колонки.Добавить("Примечание");
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДатаНачала",    СтруктураПараметров.Получить("ДатаНачала"));
	Запрос.УстановитьПараметр("ДатаОкончания", СтруктураПараметров.Получить("ДатаОкончания"));
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ДанныеДокумента.Ссылка КАК Документ1,
	|	ДанныеДокумента.Дата КАК Пояснение1,
	|	ДанныеДокумента.Основание.Ссылка КАК Документ2,
	|	ДанныеДокумента.Основание.Дата КАК Пояснение2
	|ИЗ
	|	Документ.ПоступлениеТоваровИУслуг КАК ДанныеДокумента
	|ГДЕ
	|	ДанныеДокумента.Проведен
	|	И ДанныеДокумента.Основание.Проведен
	|	И ДанныеДокумента.Дата < ДанныеДокумента.Основание.Дата
	|	И ДанныеДокумента.Основание ССЫЛКА Документ.ЗаказПоставщику
	|	И (ДанныеДокумента.Дата >= &ДатаНачала
	|			ИЛИ &ДатаНачала = ДАТАВРЕМЯ(1, 1, 1))
	|	И (ДанныеДокумента.Дата <= &ДатаОкончания
	|			ИЛИ &ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1))
	|";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = ТаблицаРезультата.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);	
		НоваяСтрока.Примечание = ТекстОшибкиДополнительно(Выборка.Пояснение1, Выборка.Пояснение2);	
		
		НоваяСтрока = ОбъектыКИсправлению.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		НоваяСтрока.Исправить = "ПоставитьДатуЗаказаПоставщикуРаньшеДатыПоступления";
	КонецЦикла;
	
	Возврат ТаблицаРезультата;
	
КонецФункции

Функция ВывестиРезультатПроверки_ПоступлениеРаньшеЗаказаПоставщику(ТаблицаРезультата)	
	
	Таб = Новый ТабличныйДокумент;
	Макет = ПолучитьОбщийМакет("МакетЭкспрессПроверкаУчета");
	
	Таб.НачатьАвтогруппировкуСтрок();
	
	ОбластьМакета = Макет.ПолучитьОбласть("Шапка_ВидПроверки");
	ОбластьМакета.Параметры.ВидПроверки = """Поступление товаров и услуг"" имеет дату меньшую чем документ ""Заказ поставщику""";
	Таб.Вывести(ОбластьМакета, 1);
	
	Если ТаблицаРезультата.Количество() = 0 Тогда
		ОбластьМакета = Макет.ПолучитьОбласть("Шапка_ОшибокНет");
		Таб.Вывести(ОбластьМакета, 1);
	Иначе
		ОбластьМакета = Макет.ПолучитьОбласть("Шапка_ОшибкиЕсть_Исправить");
		ОбластьМакета.Параметры.КоличествоОшибок = ТаблицаРезультата.Количество();
		ОбластьМакета.Параметры.Исправить = "ПоставитьДатуЗаказаПоставщикуРаньшеДатыПоступления";
		ОбластьМакета.Параметры.ТекстПоясненияИсправления = "Процедура исправления изменяет дату документа ""Заказ поставщику"" на дату документа ""Поступление товаров и услуг"", уменьшенную на 1 секунду";
		
		Таб.Вывести(ОбластьМакета, 1);
		
		ОбластьМакета = Макет.ПолучитьОбласть("Шапка_Таблица");
		ОбластьМакета.Параметры.Документ1 = "Поступление";
		ОбластьМакета.Параметры.Пояснение1 = "Дата";
		ОбластьМакета.Параметры.Документ2 = "Заказ поставщику";
		ОбластьМакета.Параметры.Пояснение2 = "Дата";
		Таб.Вывести(ОбластьМакета, 2, "Документ", Ложь);
		
		Ном = 1;
		Для Каждого ТекущаяСтрока Из ТаблицаРезультата Цикл
			ОбластьМакета = Макет.ПолучитьОбласть("Строка_Таблица");
			ЗаполнитьЗначенияСвойств(ОбластьМакета.Параметры, ТекущаяСтрока);
			ОбластьМакета.Параметры.Ном = Ном;
			Таб.Вывести(ОбластьМакета, 2, "Документ", Ложь);
			Ном = Ном + 1;
			
		КонецЦикла;
	КонецЕсли;
	
	Таб.ЗакончитьАвтогруппировкуСтрок();	
	Возврат Таб;
	
КонецФункции

Функция ИсправитьОбъект_ПоступлениеРаньшеЗаказаПоставщику(ДокументПоступления, ДокументЗаказПоставщику) Экспорт
	
	Если НачалоДня(ДокументЗаказПоставщику.Дата) <> НачалоДня(ДокументПоступления.Дата) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ОбъектИсправления = ДокументЗаказПоставщику.ПолучитьОбъект();
	ОбъектИсправления.Дата = ДокументПоступления.Дата - 1;
	
	Попытка
		Если ОбъектИсправления.Проведен Тогда
			ОбъектИсправления.Записать(РежимЗаписиДокумента.Проведение);
		Иначе
			ОбъектИсправления.Записать();
		КонецЕсли;
		Возврат Истина;
	Исключение
		//Сообщить("Попытка присвоить дату " + ОбъектВыпуск.Дата + " для " + ОбъектВыпуск + ". Ошибка: " + ОписаниеОшибки());
		Возврат Ложь;
	КонецПопытки;
	
КонецФункции

#КонецОбласти

#Область СуммаРеализацииНеСходитсяССуммойЗаказаНаПроизводство
//============================================== Сумма реализации не сходится с суммой заказа на производство ========================================
//НЕ ИСПОЛЬЗУЕТСЯ

Функция ВыполнитьПроверку_СуммаРеализацииНеСходитсяССуммойЗаказаНаПроизводство() Экспорт
	
	РезультатПроверки = ПолучитьТаблицу_СуммаРеализацииНеСходитсяССуммойЗаказаНаПроизводство();
	ТабДок = ВывестиРезультатПроверки_СуммаРеализацииНеСходитсяССуммойЗаказаНаПроизводство(РезультатПроверки);
	Возврат ТабДок;
	
КонецФункции

Функция ПолучитьТаблицу_СуммаРеализацииНеСходитсяССуммойЗаказаНаПроизводство()
	
	ТаблицаРезультата = Новый ТаблицаЗначений;
	ТаблицаРезультата.Колонки.Добавить("Документ1"); //ЗнП
	ТаблицаРезультата.Колонки.Добавить("Пояснение1"); //сумма документа
	ТаблицаРезультата.Колонки.Добавить("Документ2"); //РТиУ
	ТаблицаРезультата.Колонки.Добавить("Пояснение2"); //сумма документа
	ТаблицаРезультата.Колонки.Добавить("Примечание"); //не используется
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ДанныеТаблицы.Ссылка КАК Ссылка,
	|	ДанныеТаблицы.Заказ КАК Заказ,
	|	ДанныеТаблицы.Сумма КАК СуммаОтгрузки
	|ПОМЕСТИТЬ ВТ_ГрупповыеОтгрузкиВрем
	|ИЗ
	|	Документ.РеализацияТоваровИУслуг.Товары КАК ДанныеТаблицы
	|ГДЕ
	|	ДанныеТаблицы.Ссылка.ГрупповаяОтгрузка
	|	И ДанныеТаблицы.Ссылка.Проведен
	|	И ДанныеТаблицы.Заказ ССЫЛКА Документ.ЗаказНаПроизводство
	|	И НЕ ДанныеТаблицы.Заказ ЕСТЬ NULL
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ДанныеТаблицы.Ссылка,
	|	ДанныеТаблицы.Заказ,
	|	ДанныеТаблицы.Сумма
	|ИЗ
	|	Документ.РеализацияТоваровИУслуг.Услуги КАК ДанныеТаблицы
	|ГДЕ
	|	ДанныеТаблицы.Ссылка.ГрупповаяОтгрузка
	|	И ДанныеТаблицы.Ссылка.Проведен
	|	И ДанныеТаблицы.Заказ ССЫЛКА Документ.ЗаказНаПроизводство
	|	И НЕ ДанныеТаблицы.Заказ ЕСТЬ NULL
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ГрупповыеОтгрузкиВрем.Ссылка КАК Ссылка,
	|	ВТ_ГрупповыеОтгрузкиВрем.Заказ КАК Заказ,
	|	СУММА(ВТ_ГрупповыеОтгрузкиВрем.СуммаОтгрузки) КАК СуммаОтгрузки
	|ПОМЕСТИТЬ ВТ_ГрупповыеОтгрузки
	|ИЗ
	|	ВТ_ГрупповыеОтгрузкиВрем КАК ВТ_ГрупповыеОтгрузкиВрем
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_ГрупповыеОтгрузкиВрем.Ссылка,
	|	ВТ_ГрупповыеОтгрузкиВрем.Заказ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	РеализацияТоваровИУслуг.Ссылка КАК ДокРтиу,
	|	РеализацияТоваровИУслуг.Основание КАК ДокОснование,
	|	РеализацияТоваровИУслуг.СуммаДокумента КАК СуммаОтгрузки
	|ПОМЕСТИТЬ ВТ_ДокументыРеализацииВрем
	|ИЗ
	|	Документ.РеализацияТоваровИУслуг КАК РеализацияТоваровИУслуг
	|ГДЕ
	|	НЕ РеализацияТоваровИУслуг.ГрупповаяОтгрузка
	|	И РеализацияТоваровИУслуг.Проведен
	|	И РеализацияТоваровИУслуг.Основание ССЫЛКА Документ.ЗаказНаПроизводство
	|	И НЕ РеализацияТоваровИУслуг.Основание ЕСТЬ NULL
	|	И РеализацияТоваровИУслуг.Основание.ТекущийСтатус = ЗНАЧЕНИЕ(Справочник.СтатусыЗаказовНаПроизводство.Отгружен)
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	ВТ_ГрупповыеОтгрузки.Ссылка,
	|	ВТ_ГрупповыеОтгрузки.Заказ,
	|	ВТ_ГрупповыеОтгрузки.СуммаОтгрузки
	|ИЗ
	|	ВТ_ГрупповыеОтгрузки КАК ВТ_ГрупповыеОтгрузки
	|ГДЕ
	|	ВТ_ГрупповыеОтгрузки.Заказ.ТекущийСтатус = ЗНАЧЕНИЕ(Справочник.СтатусыЗаказовНаПроизводство.Отгружен)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ДокументыРеализацииВрем.ДокОснование КАК ДокОснование,
	|	СУММА(ВТ_ДокументыРеализацииВрем.СуммаОтгрузки) КАК СуммаОтгрузки,
	|	ВТ_ДокументыРеализацииВрем.ДокОснование.СуммаДокумента КАК СуммаЗаказа
	|ПОМЕСТИТЬ ВТ_ДокументыВрем
	|ИЗ
	|	ВТ_ДокументыРеализацииВрем КАК ВТ_ДокументыРеализацииВрем
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_ДокументыРеализацииВрем.ДокОснование,
	|	ВТ_ДокументыРеализацииВрем.ДокОснование.СуммаДокумента
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ДокументыВрем.ДокОснование КАК ДокОснование,
	|	ВТ_ДокументыРеализацииВрем.ДокРтиу КАК ДокРтиу,
	|	ВТ_ДокументыВрем.СуммаЗаказа КАК СуммаЗаказа,
	|	ВТ_ДокументыВрем.СуммаОтгрузки КАК СуммаОтгрузки
	|ИЗ
	|	ВТ_ДокументыВрем КАК ВТ_ДокументыВрем
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ДокументыРеализацииВрем КАК ВТ_ДокументыРеализацииВрем
	|		ПО (ВТ_ДокументыРеализацииВрем.ДокОснование = ВТ_ДокументыВрем.ДокОснование)
	|ГДЕ
	|	ВТ_ДокументыВрем.СуммаЗаказа <> ВТ_ДокументыВрем.СуммаОтгрузки
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДокОснование
	|ИТОГИ ПО
	|	ДокОснование";
	
	ВыборкаЗаказов = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам,"ДокОснование");		
	Пока ВыборкаЗаказов.Следующий() Цикл
		НоваяСтрока = ТаблицаРезультата.Добавить();
		НоваяСтрока.Документ1 = ВыборкаЗаказов.ДокОснование;
		
		СписокДокументовВРасшифровку = Новый СписокЗначений;	
		ВыборкаРеализаций = ВыборкаЗаказов.Выбрать();
		Пока ВыборкаРеализаций.Следующий() Цикл
			СписокДокументовВРасшифровку.Добавить(ВыборкаРеализаций.ДокРтиу);
			НоваяСтрока.Пояснение1 = ВыборкаРеализаций.СуммаЗаказа;
			НоваяСтрока.Пояснение2 = ВыборкаРеализаций.СуммаОтгрузки;
		КонецЦикла;
		Если СписокДокументовВРасшифровку.Количество() = 1 Тогда
			НоваяСтрока.Документ2 = СписокДокументовВРасшифровку[0].Значение;
		Иначе
			НоваяСтрока.Документ2 = СписокДокументовВРасшифровку;
		КонецЕсли;
	КонецЦикла;
	
	Возврат ТаблицаРезультата;
	
КонецФункции

Функция ВывестиРезультатПроверки_СуммаРеализацииНеСходитсяССуммойЗаказаНаПроизводство(ТаблицаРезультата)	
	
	Таб = Новый ТабличныйДокумент;
	Макет = ПолучитьОбщийМакет("МакетЭкспрессПроверкаУчета");
	
	Таб.НачатьАвтогруппировкуСтрок();
	
	ОбластьМакета = Макет.ПолучитьОбласть("Шапка_ВидПроверки");
	//ОбластьМакета.Параметры.ВидПроверки = "Сумма документа ""Реализация товаров и услуг"" не соответствует сумме документа ""Заказ на производство"", являющегося основанием реализации. Учитываются только пары документов 1 к 1.";
	ОбластьМакета.Параметры.ВидПроверки = "Сумма документа ""Реализация товаров и услуг"" не соответствует сумме документа ""Заказ на производство"", являющегося основанием реализации";	
	Таб.Вывести(ОбластьМакета, 1);
	
	Если ТаблицаРезультата.Количество() = 0 Тогда
		ОбластьМакета = Макет.ПолучитьОбласть("Шапка_ОшибокНет");
		Таб.Вывести(ОбластьМакета, 1);
	Иначе
		ОбластьМакета = Макет.ПолучитьОбласть("Шапка_ОшибкиЕсть");
		ОбластьМакета.Параметры.КоличествоОшибок = ТаблицаРезультата.Количество();
		Таб.Вывести(ОбластьМакета, 1);
		
		ОбластьМакета = Макет.ПолучитьОбласть("Шапка_Таблица");
		ОбластьМакета.Параметры.Документ1 = "Заказ на производство";
		ОбластьМакета.Параметры.Пояснение1 = "Сумма";
		ОбластьМакета.Параметры.Документ2 = "Реализация";
		ОбластьМакета.Параметры.Пояснение2 = "Сумма";
		Таб.Вывести(ОбластьМакета, 2, "Документ", Ложь);
		
		Ном = 1;
		Для Каждого ТекущаяСтрока Из ТаблицаРезультата Цикл
			ОбластьМакета = Макет.ПолучитьОбласть("Строка_Таблица");
			ЗаполнитьЗначенияСвойств(ОбластьМакета.Параметры, ТекущаяСтрока);
			ОбластьМакета.Параметры.Ном = Ном;
			Таб.Вывести(ОбластьМакета, 2, "Документ", Ложь);
			Ном = Ном + 1;
			
		КонецЦикла;
	КонецЕсли;
	
	Таб.ЗакончитьАвтогруппировкуСтрок();	
	Возврат Таб;
	
КонецФункции

#КонецОбласти

#Область СуммаРеализацииНеСходитсяССуммойЗаказаПокупателя
//============================================== Сумма реализации не сходится с суммой заказа покупателя (+)========================================

Функция ВыполнитьПроверку_СуммаРеализацииНеСходитсяССуммойЗаказаПокупателя(СтруктураПараметров) Экспорт 
	
	РезультатПроверки = ПолучитьТаблицу_СуммаРеализацииНеСходитсяССуммойЗаказаПокупателя(СтруктураПараметров);
	ТабДок = ВывестиРезультатПроверки_СуммаРеализацииНеСходитсяССуммойЗаказаПокупателя(РезультатПроверки);
	возврат ТабДок;
	
КонецФункции

Функция ПолучитьТаблицу_СуммаРеализацииНеСходитсяССуммойЗаказаПокупателя(СтруктураПараметров)
	
	// #12360 делаем так: проверяем по реализациям указанного периода. по реализации в периоде находим заказы без учета периода, 
	// далее по заказу находим все реализации без учета периода и сверяем их все с этим заказом.
	// т.е. по факту первая найденная РТиУ в указанном периоде лишь точка входа в цепочку и далее проверка без учета периода.
	// ВТ_Документы_Врем - все реализации за период и заказы, по которым они отгружаются
	// ВТ_Документы - уникальные связки реализация-заказ
	
	ТаблицаРезультата = Новый ТаблицаЗначений;
	ТаблицаРезультата.Колонки.Добавить("Документ1"); //РТиУ
	ТаблицаРезультата.Колонки.Добавить("Пояснение1"); //сумма документа
	ТаблицаРезультата.Колонки.Добавить("Документ2"); //Заказ покупателя
	ТаблицаРезультата.Колонки.Добавить("Пояснение2"); //сумма документа
	ТаблицаРезультата.Колонки.Добавить("Примечание"); //используется
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДатаНачала",    СтруктураПараметров.Получить("ДатаНачала"));
	Запрос.УстановитьПараметр("ДатаОкончания", СтруктураПараметров.Получить("ДатаОкончания"));
	//Запросом получим товары и услуги в табличных частях реализаций, у которых указан выполненный заказ покупателя в колонке "Заказ"
	
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ДанныеДокумента.Ссылка КАК СсылкаНаРеализацию,
	|	ДанныеДокумента.Заказ.Ссылка КАК СсылкаНаЗаказ
	|ПОМЕСТИТЬ ВТ_Документы_Врем
	|ИЗ
	|	Документ.РеализацияТоваровИУслуг.Товары КАК ДанныеДокумента
	|ГДЕ
	|	ДанныеДокумента.Ссылка.Проведен
	|	И ДанныеДокумента.Заказ ССЫЛКА Документ.ЗаказПокупателя
	|	И ДанныеДокумента.Заказ.Ссылка ЕСТЬ НЕ NULL 
	|	И ДанныеДокумента.Заказ.ТекущийСтатус = &ТекущийСтатус
	|	И (ДанныеДокумента.Ссылка.Дата >= &ДатаНачала
	|			ИЛИ &ДатаНачала = ДАТАВРЕМЯ(1, 1, 1))
	|	И (ДанныеДокумента.Ссылка.Дата <= &ДатаОкончания
	|			ИЛИ &ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1))
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ДанныеДокумента.Ссылка,
	|	ДанныеДокумента.Заказ.Ссылка
	|ИЗ
	|	Документ.РеализацияТоваровИУслуг.Услуги КАК ДанныеДокумента
	|ГДЕ
	|	ДанныеДокумента.Ссылка.Проведен
	|	И ДанныеДокумента.Заказ ССЫЛКА Документ.ЗаказПокупателя
	|	И ДанныеДокумента.Заказ.Ссылка ЕСТЬ НЕ NULL 
	|	И ДанныеДокумента.Заказ.ТекущийСтатус = &ТекущийСтатус
	|	И (ДанныеДокумента.Ссылка.Дата >= &ДатаНачала
	|			ИЛИ &ДатаНачала = ДАТАВРЕМЯ(1, 1, 1))
	|	И (ДанныеДокумента.Ссылка.Дата <= &ДатаОкончания
	|			ИЛИ &ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1))
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	ВТ_Документы_Врем.СсылкаНаРеализацию КАК СсылкаНаРеализацию,
	|	ВТ_Документы_Врем.СсылкаНаЗаказ КАК СсылкаНаЗаказ
	|ПОМЕСТИТЬ ВТ_Документы
	|ИЗ
	|	ВТ_Документы_Врем КАК ВТ_Документы_Врем
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ДанныеДокумента.Ссылка КАК СсылкаНаРеализацию,
	|	СУММА(ЕСТЬNULL(ДанныеДокумента.Сумма, 0) + ЕСТЬNULL(ДанныеДокумента.СкидкаБонусами, 0)) КАК СуммаРеализации,
	|	ДанныеДокумента.Заказ.Ссылка КАК СсылкаНаЗаказ,
	|	СРЕДНЕЕ(ЕСТЬNULL(ДанныеДокумента.Заказ.СуммаДокумента, 0)) КАК СуммаЗаказов,
	|	ВЫБОР 
	|		КОГДА (ДанныеДокумента.Ссылка.Дата >= &ДатаНачала
	|				ИЛИ &ДатаНачала = ДАТАВРЕМЯ(1, 1, 1))
	|			И (ДанныеДокумента.Ссылка.Дата <= &ДатаОкончания
	|				ИЛИ &ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1))
	|			ТОГДА 1
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК Отображать
	|ПОМЕСТИТЬ ВТ
	|ИЗ
	|	Документ.РеализацияТоваровИУслуг.Товары КАК ДанныеДокумента
	
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_Документы КАК ВТ_Документы 
	|		ПО ВТ_Документы.СсылкаНаЗаказ = ДанныеДокумента.Заказ
	
	|ГДЕ
	|	ДанныеДокумента.Ссылка.Проведен
	//|	И ДанныеДокумента.Заказ ССЫЛКА Документ.ЗаказПокупателя
	//|	И ДанныеДокумента.Заказ.Ссылка ЕСТЬ НЕ NULL 
	//|	И ДанныеДокумента.Заказ.ТекущийСтатус = &ТекущийСтатус
	//|	И (ДанныеДокумента.Ссылка.Дата >= &ДатаНачала
	//|			ИЛИ &ДатаНачала = ДАТАВРЕМЯ(1, 1, 1))
	//|	И (ДанныеДокумента.Ссылка.Дата <= &ДатаОкончания
	//|			ИЛИ &ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1))
	|
	|СГРУППИРОВАТЬ ПО
	|	ДанныеДокумента.Ссылка,
	|	ДанныеДокумента.Заказ.Ссылка
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ДанныеДокумента.Ссылка,
	|	СУММА(ЕСТЬNULL(ДанныеДокумента.Сумма, 0) + ЕСТЬNULL(ДанныеДокумента.СкидкаБонусами, 0)),
	|	ДанныеДокумента.Заказ.Ссылка,
	|	СРЕДНЕЕ(ЕСТЬNULL(ДанныеДокумента.Заказ.СуммаДокумента, 0)),
	|	ВЫБОР 
	|		КОГДА (ДанныеДокумента.Ссылка.Дата >= &ДатаНачала
	|				ИЛИ &ДатаНачала = ДАТАВРЕМЯ(1, 1, 1))
	|			И (ДанныеДокумента.Ссылка.Дата <= &ДатаОкончания
	|				ИЛИ &ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1))
	|			ТОГДА 1
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК Отображать
	|ИЗ
	|	Документ.РеализацияТоваровИУслуг.Услуги КАК ДанныеДокумента
	
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_Документы КАК ВТ_Документы 
	|		ПО ВТ_Документы.СсылкаНаЗаказ = ДанныеДокумента.Заказ
	
	|ГДЕ
	|	ДанныеДокумента.Ссылка.Проведен
	//|	И ДанныеДокумента.Заказ ССЫЛКА Документ.ЗаказПокупателя
	//|	И ДанныеДокумента.Заказ.Ссылка ЕСТЬ НЕ NULL 
	//|	И ДанныеДокумента.Заказ.ТекущийСтатус = &ТекущийСтатус
	//|	И (ДанныеДокумента.Ссылка.Дата >= &ДатаНачала
	//|			ИЛИ &ДатаНачала = ДАТАВРЕМЯ(1, 1, 1))
	//|	И (ДанныеДокумента.Ссылка.Дата <= &ДатаОкончания
	//|			ИЛИ &ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1))
	|
	|СГРУППИРОВАТЬ ПО
	|	ДанныеДокумента.Ссылка,
	|	ДанныеДокумента.Заказ.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	РеализацииЗаказы.СсылкаНаРеализацию КАК СсылкаНаРеализацию,
	|	СУММА(ЕСТЬNULL(РеализацииЗаказы.СуммаРеализации, 0)) КАК СуммаРеализации,
	|	РеализацииЗаказы.СсылкаНаЗаказ КАК СсылкаНаЗаказ,
	|	СРЕДНЕЕ(ЕСТЬNULL(РеализацииЗаказы.СуммаЗаказов, 0)) КАК СуммаЗаказов,
	|	МАКСИМУМ(РеализацииЗаказы.Отображать) КАК Отображать	
	|ИЗ
	|	ВТ КАК РеализацииЗаказы
	|
	|СГРУППИРОВАТЬ ПО
	|	РеализацииЗаказы.СсылкаНаРеализацию,
	|	РеализацииЗаказы.СсылкаНаЗаказ";
	
	Запрос.УстановитьПараметр("ТекущийСтатус",Справочники.СтатусыЗаказовПокупателей.Выполнен);
	
	//Выгружаем весь запрос, основная таблица, с которой мы будем работать
	ТаблицаЗаказов = Запрос.Выполнить().Выгрузить();	
	ТаблицаЗаказов.Колонки.Добавить("Обработана", Новый ОписаниеТипов("Булево"));
	
	Для Каждого ТекущаяСтрока Из ТаблицаЗаказов Цикл
		
		Если ТекущаяСтрока.Обработана Тогда
			Продолжить;
		КонецЕсли;
		
		Примечание = "";
		
		// считаем, что КоличествоЗаказов = 1
		// иначе при связи много-ко-многим возможна рекурсия вложенности и не все документы обрабатываются
		КоличествоЗаказов = 1;
		СуммаЗаказа = ТекущаяСтрока.СсылкаНаЗаказ.СуммаДокумента;	
		
		//Найдем все записи по текущему Заказу в таблице, если их больше 1 значить есть несколько реализаций по данному заказу
		НайденныеРТиУПоЗаказу = ТаблицаЗаказов.НайтиСтроки(Новый Структура("СсылкаНаЗаказ", ТекущаяСтрока.СсылкаНаЗаказ));
		КоличествоРТиУ = НайденныеРТиУПоЗаказу.Количество(); //Количество РТиУ по текущему заказу
		
		//по заказу один РТиУ
		Если КоличествоРТиУ = 1 и КоличествоЗаказов = 1 Тогда
			
			// #12360
			Если НЕ НайденныеРТиУПоЗаказу[0].Отображать Тогда
				Продолжить;
			КонецЕсли;
			
			ОтметитьСтрокуЗПРТиУОбработанной(ТаблицаЗаказов, ТекущаяСтрока.СсылкаНаЗаказ, ТекущаяСтрока.СсылкаНаРеализацию);
			
			ДанныеПроверки = ПроверитьСуммуРеализацийПоЗаказу(ТекущаяСтрока.СсылкаНаЗаказ, ТекущаяСтрока.СсылкаНаРеализацию);
			Если ДанныеПроверки.СуммаРеализаций = ДанныеПроверки.СуммаЗаказа Тогда 
				Продолжить;
			Иначе
				Примечание = ДанныеПроверки.Примечание;
			КонецЕсли;	
			
			Документ1  = ТекущаяСтрока.СсылкаНаРеализацию;
			Пояснение1 = ДанныеПроверки.СуммаРеализаций;
			Документ2  = ТекущаяСтрока.СсылкаНаЗаказ;
			Пояснение2 = ДанныеПроверки.СуммаЗаказа;				
			
			//по заказу несколько РТиУ	
		ИначеЕсли КоличествоЗаказов = 1 и КоличествоРТиУ > 1 Тогда
			
			СписокРТиУВРасшифровку = Новый СписокЗначений;
			СписокРТиУДляСверки = Новый СписокЗначений;
			МассивРеализаций = Новый Массив;
			Для Каждого НайденнаяСтрока Из НайденныеРТиУПоЗаказу Цикл
				ОтметитьСтрокуЗПРТиУОбработанной(ТаблицаЗаказов, ТекущаяСтрока.СсылкаНаЗаказ, НайденнаяСтрока.СсылкаНаРеализацию);
				СписокРТиУДляСверки.Добавить(НайденнаяСтрока.СсылкаНаРеализацию);
				Если НайденнаяСтрока.Отображать Тогда
					СписокРТиУВРасшифровку.Добавить(НайденнаяСтрока.СсылкаНаРеализацию);
				КонецЕсли;
			КонецЦикла;	
			
			ДанныеПроверки = ПроверитьСуммуРеализацийПоЗаказу(ТекущаяСтрока.СсылкаНаЗаказ, СписокРТиУДляСверки.ВыгрузитьЗначения());				
			
			Если ДанныеПроверки.СуммаРеализаций = ДанныеПроверки.СуммаЗаказа Тогда
				Продолжить;
			Иначе
				Примечание = ДанныеПроверки.Примечание;
			КонецЕсли;	
			
			Документ1  = СписокРТиУВРасшифровку;
			Пояснение1 = ДанныеПроверки.СуммаРеализаций;
			Документ2  = ТекущаяСтрока.СсылкаНаЗаказ;
			Пояснение2 = ДанныеПроверки.СуммаЗаказа;			
			
		Иначе
			Продолжить;
		КонецЕсли;
		
		//Если сюда дошли, значить есть расхождения
		НоваяСтрока = ТаблицаРезультата.Добавить();
		НоваяСтрока.Документ1 = Документ1;
		НоваяСтрока.Пояснение1 = Пояснение1;
		НоваяСтрока.Документ2 = Документ2;
		НоваяСтрока.Пояснение2 = Пояснение2;		
		НоваяСтрока.Примечание = Примечание;
		
	КонецЦикла;
	
	Возврат ТаблицаРезультата;
	
КонецФункции

Функция ПроверитьСуммуРеализацийПоЗаказу(СсылкаНаЗаказ, МассивРеализацийКОбработке)
	
	СтруктураОтвета = Новый Структура;
	
	МассивРеализаций = Новый Массив;
	Если ТипЗнч(МассивРеализацийКОбработке) = Тип("ДокументСсылка.РеализацияТоваровИУслуг") Тогда
		МассивРеализаций.Добавить(МассивРеализацийКОбработке);
	Иначе
		МассивРеализаций = МассивРеализацийКОбработке;
	КонецЕсли;
	
	СуммаРеализаций = 0;
	СуммаЗаказа = 0;
	
	МассивТипов = новый Массив;
	МассивТипов.Добавить(Тип("СправочникСсылка.ЕдиницыИзмерений"));
	МассивТипов.Добавить(Тип("СправочникСсылка.КлассификаторЕдиницИзмерения"));
	ПозицииЗаказаВРеализации = Новый ТаблицаЗначений;
	ПозицииЗаказаВРеализации.Колонки.Добавить("Документ", 					новый ОписаниеТипов("ДокументСсылка.РеализацияТоваровИУслуг"));
	ПозицииЗаказаВРеализации.Колонки.Добавить("Номенклатура", 				новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ПозицииЗаказаВРеализации.Колонки.Добавить("ХарактеристикаНоменклатуры", новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры"));
	ПозицииЗаказаВРеализации.Колонки.Добавить("СерияНоменклатуры", 			новый ОписаниеТипов("СправочникСсылка.СерииНоменклатуры"));	
	ПозицииЗаказаВРеализации.Колонки.Добавить("ЕдиницаИзмерения", 			новый ОписаниеТипов(МассивТипов));
	ПозицииЗаказаВРеализации.Колонки.Добавить("Количество", 				новый ОписаниеТипов("Число",,, новый КвалификаторыЧисла(15, 2)));
	ПозицииЗаказаВРеализации.Колонки.Добавить("Цена", 						новый ОписаниеТипов("Число",,, новый КвалификаторыЧисла(15, 2)));
	ПозицииЗаказаВРеализации.Колонки.Добавить("ПроцентРучнойСкидки", 		новый ОписаниеТипов("Число",,, новый КвалификаторыЧисла(10, 2)));
	ПозицииЗаказаВРеализации.Колонки.Добавить("Сумма", 						новый ОписаниеТипов("Число",,, новый КвалификаторыЧисла(15, 2)));  //++
	
	ПозицииЗаказа = Новый ТаблицаЗначений;
	ПозицииЗаказа.Колонки.Добавить("Номенклатура", 				новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ПозицииЗаказа.Колонки.Добавить("ХарактеристикаНоменклатуры", новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры"));
	ПозицииЗаказа.Колонки.Добавить("СерияНоменклатуры", 			новый ОписаниеТипов("СправочникСсылка.СерииНоменклатуры"));	
	ПозицииЗаказа.Колонки.Добавить("ЕдиницаИзмерения", 			новый ОписаниеТипов(МассивТипов));
	ПозицииЗаказа.Колонки.Добавить("Количество", 				новый ОписаниеТипов("Число",,, новый КвалификаторыЧисла(15, 2)));
	ПозицииЗаказа.Колонки.Добавить("Цена", 						новый ОписаниеТипов("Число",,, новый КвалификаторыЧисла(15, 2)));
	ПозицииЗаказа.Колонки.Добавить("ПроцентРучнойСкидки", 		новый ОписаниеТипов("Число",,, новый КвалификаторыЧисла(10, 2)));
	ПозицииЗаказа.Колонки.Добавить("Сумма", 						новый ОписаниеТипов("Число",,, новый КвалификаторыЧисла(15, 2))); 
	
	//Подготовим позиции заказа в реализации	
	Для каждого СсылкаНаРеализацию из МассивРеализаций Цикл
		Для Каждого ТекущаяСтрока Из СсылкаНаРеализацию.Товары Цикл
			Если ТекущаяСтрока.Заказ = СсылкаНаЗаказ Тогда
				НоваяСтрока = ПозицииЗаказаВРеализации.Добавить();
				НоваяСтрока.Документ = СсылкаНаРеализацию;
				ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущаяСтрока);
				НоваяСтрока.Сумма = НоваяСтрока.Сумма + ТекущаяСтрока.СкидкаБонусами;
			КонецЕсли;
		КонецЦикла;
		
		Для Каждого ТекущаяСтрока Из СсылкаНаРеализацию.Услуги Цикл
			Если ТекущаяСтрока.Заказ = СсылкаНаЗаказ Тогда
				НоваяСтрока = ПозицииЗаказаВРеализации.Добавить();
				//++16574
				НоваяСтрока.Документ = СсылкаНаРеализацию;
				//--16574
				ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущаяСтрока);
				НоваяСтрока.Сумма = НоваяСтрока.Сумма + ТекущаяСтрока.СкидкаБонусами;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	//++16936
	ДокументЗаказаВРеализации = ПозицииЗаказаВРеализации.Скопировать();
	//ПозицииЗаказаВРеализации.Свернуть("Документ, Номенклатура, ХарактеристикаНоменклатуры, СерияНоменклатуры, ЕдиницаИзмерения, Цена, ПроцентРучнойСкидки", "Количество, Сумма");
	ДокументЗаказаВРеализации.Свернуть("Документ", "Сумма");
	ПозицииЗаказаВРеализации.Свернуть("Номенклатура, ХарактеристикаНоменклатуры, СерияНоменклатуры, ЕдиницаИзмерения, Цена, ПроцентРучнойСкидки", "Количество, Сумма");
	ПозицииЗаказаВРеализации.Сортировать("Номенклатура, Цена убыв");

	
	ТоварыЗаказа = СсылкаНаЗаказ.Товары.Выгрузить();
	СуммаТоварыЗаказа	= ТоварыЗаказа.Скопировать();
	СуммаТоварыЗаказа.Свернуть(, "Сумма");
    СуммаЗаказа = СуммаТоварыЗаказа[0].Сумма;
	
	ТоварыЗаказа.Свернуть("Номенклатура, ХарактеристикаНоменклатуры, СерияНоменклатуры, ЕдиницаИзмерения, Цена, ПроцентРучнойСкидки", "Количество, Сумма");
	ТоварыЗаказа.Сортировать("Номенклатура, Цена убыв");
	
	Примечание = "";
	//Теперь сверим реквизиты в заказе покупателя
	Для Каждого ДокументРеализации Из ДокументЗаказаВРеализации Цикл
		Если НЕ (ДокументРеализации.Документ.Организация = СсылкаНаЗаказ.Организация И ДокументРеализации.Документ.Контрагент = СсылкаНаЗаказ.Контрагент) Тогда
			Примечание = Примечание + "Несовпадение организации или контрагента в документе " + ДокументРеализации.Документ + " и в документе " + СсылкаНаЗаказ;
			Примечание = Примечание + Символы.ПС;
		Иначе
			СуммаРеализаций = СуммаРеализаций + ДокументРеализации.Сумма;
		КонецЕсли;
	КонецЦикла;
	
	Если СуммаЗаказа <> СуммаРеализаций Тогда	//Теперь найдем реализации в заказе покупателя
		Примечание = Примечание + "Несовпадение суммы документа " + СсылкаНаЗаказ + " с суммами документов реализаций";
		Примечание = Примечание + Символы.ПС;
		Для Каждого СтрокаРеализации Из ПозицииЗаказаВРеализации Цикл
			Для Каждого СтрокаЗаказа Из ТоварыЗаказа Цикл //СсылкаНаЗаказ.Товары Цикл
				
				Если СтрокаЗаказа.Номенклатура = СтрокаРеализации.Номенклатура
					И СтрокаЗаказа.ХарактеристикаНоменклатуры = СтрокаРеализации.ХарактеристикаНоменклатуры
					И СтрокаЗаказа.СерияНоменклатуры = СтрокаРеализации.СерияНоменклатуры
					И СтрокаЗаказа.ЕдиницаИзмерения = СтрокаРеализации.ЕдиницаИзмерения
					И СтрокаЗаказа.Количество = СтрокаРеализации.Количество
					И СтрокаЗаказа.Цена = СтрокаРеализации.Цена
					И СтрокаЗаказа.ПроцентРучнойСкидки = СтрокаРеализации.ПроцентРучнойСкидки
					Тогда
					
					Если СтрокаЗаказа.Сумма <> СтрокаРеализации.Сумма Тогда
						Примечание = Примечание + "Номенклатура: " + СтрокаЗаказа.Номенклатура;
						Примечание = Примечание + Символы.ПС;
						Примечание = Примечание + "Сумма: " + СтрокаРеализации.Сумма + " / " + СтрокаЗаказа.Сумма + "; ";
						Примечание = Примечание + Символы.ПС + Символы.ПС; 
					КонецЕсли;
					ТоварыЗаказа.Удалить(СтрокаЗаказа);
					
				Иначе
					Если СтрокаЗаказа.Номенклатура = СтрокаРеализации.Номенклатура
						И СтрокаЗаказа.ХарактеристикаНоменклатуры = СтрокаРеализации.ХарактеристикаНоменклатуры
						И СтрокаЗаказа.СерияНоменклатуры = СтрокаРеализации.СерияНоменклатуры
						И СтрокаЗаказа.ЕдиницаИзмерения = СтрокаРеализации.ЕдиницаИзмерения Тогда
						
						// данные примечание не будут выведены в отчете, если суммы совпадают
						Примечание = Примечание + "Номенклатура: " + СтрокаЗаказа.Номенклатура;
						Примечание = Примечание + Символы.ПС;
						Если СтрокаЗаказа.Количество <> СтрокаРеализации.Количество Тогда
							Примечание = Примечание + "Количество: " + СтрокаРеализации.Количество + " / " + СтрокаЗаказа.Количество + "; ";
						КонецЕсли;
						Если СтрокаЗаказа.Цена <> СтрокаРеализации.Цена Тогда
							Примечание = Примечание + "Цена: " + СтрокаРеализации.Цена + " / " + СтрокаЗаказа.Цена + "; ";
						КонецЕсли;
						Если СтрокаЗаказа.ПроцентРучнойСкидки <> СтрокаРеализации.ПроцентРучнойСкидки Тогда
							Примечание = Примечание + "ПроцентРучнойСкидки: " + СтрокаРеализации.ПроцентРучнойСкидки + " / " + СтрокаЗаказа.ПроцентРучнойСкидки + "; ";
						КонецЕсли;					
						Примечание = Примечание + Символы.ПС + Символы.ПС;
					КонецЕсли;
				КонецЕсли;	
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;	
	//--16936
	
	СтруктураОтвета.Вставить("СуммаРеализаций", СуммаРеализаций);
	СтруктураОтвета.Вставить("СуммаЗаказа", СуммаЗаказа);
	СтруктураОтвета.Вставить("Примечание", Примечание);
	Возврат СтруктураОтвета;
	
КонецФункции

Процедура ОтметитьСтрокуЗПРТиУОбработанной(ТаблицаЗаказов, СсылкаНаЗаказ, СсылкаНаРеализацию)
	
	НайденныеСтроки = ТаблицаЗаказов.НайтиСтроки(Новый Структура("СсылкаНаРеализацию, СсылкаНаЗаказ", СсылкаНаРеализацию, СсылкаНаЗаказ));
	
	Для Каждого СтрокаТЧ Из НайденныеСтроки Цикл
		СтрокаТЧ.Обработана = Истина;
	КонецЦикла;	
	
КонецПроцедуры

Функция ВывестиРезультатПроверки_СуммаРеализацииНеСходитсяССуммойЗаказаПокупателя(ТаблицаРезультата)	
	
	Таб = Новый ТабличныйДокумент;
	Макет = ПолучитьОбщийМакет("МакетЭкспрессПроверкаУчета");
	
	Таб.НачатьАвтогруппировкуСтрок();
	
	ОбластьМакета = Макет.ПолучитьОбласть("Шапка_ВидПроверки");
	ОбластьМакета.Параметры.ВидПроверки = "Сумма документов ""Реализация товаров и услуг"" по Заказам покупателя не соответствует сумме документа ""Заказ покупателя"", являющегося их основанием.";
	Таб.Вывести(ОбластьМакета, 1);
	
	Если ТаблицаРезультата.Количество() = 0 Тогда
		ОбластьМакета = Макет.ПолучитьОбласть("Шапка_ОшибокНет");
		Таб.Вывести(ОбластьМакета, 1);
	Иначе
		ОбластьМакета = Макет.ПолучитьОбласть("Шапка_ОшибкиЕсть");
		ОбластьМакета.Параметры.КоличествоОшибок = ТаблицаРезультата.Количество();
		Таб.Вывести(ОбластьМакета, 1);
		
		ОбластьМакета = Макет.ПолучитьОбласть("Шапка_Таблица");
		ОбластьМакета.Параметры.Документ1 = "Реализация";
		ОбластьМакета.Параметры.Пояснение1 = "Сумма";
		ОбластьМакета.Параметры.Документ2 = "Заказ покупателя";
		ОбластьМакета.Параметры.Пояснение2 = "Сумма";
		Таб.Вывести(ОбластьМакета, 2, "Документ", Ложь);
		
		Ном = 1;
		Для Каждого ТекущаяСтрока Из ТаблицаРезультата Цикл
			ОбластьМакета = Макет.ПолучитьОбласть("Строка_Таблица");
			ЗаполнитьЗначенияСвойств(ОбластьМакета.Параметры, ТекущаяСтрока);
			ОбластьМакета.Параметры.Ном = Ном;
			Таб.Вывести(ОбластьМакета, 2, "Документ", Ложь);
			Ном = Ном + 1;
			
		КонецЦикла;
	КонецЕсли;
	
	Таб.ЗакончитьАвтогруппировкуСтрок();	
	Возврат Таб;
	
КонецФункции

#КонецОбласти

//============================================== Документы не проведенные, не помеченные на удаление (+)========================================
#Область ДокументыНеПроведенныеНеПомеченныеНаУдаление

Функция ВыполнитьПроверку_ДокументыНеПроведенныеНеПомеченныеНаУдаление(ОбъектыКИсправлению) Экспорт
	
	РезультатПроверки = ПолучитьТаблицу_ДокументыНеПроведенныеНеПомеченныеНаУдаление(ОбъектыКИсправлению);
	ТабДок = ВывестиРезультатПроверки_ДокументыНеПроведенныеНеПомеченныеНаУдаление(РезультатПроверки);
	Возврат ТабДок;
	
КонецФункции

Функция ПолучитьТаблицу_ДокументыНеПроведенныеНеПомеченныеНаУдаление(ОбъектыКИсправлению)
	
	ТаблицаРезультата = Новый ТаблицаЗначений;
	ТаблицаРезультата.Колонки.Добавить("Документ1"); //Ссылка на документ
	
	НомерШага = 0;
	ТекстЗапроса = "";                               
	Для Каждого Документ Из Метаданные.Документы Цикл
		
		Если Документ.Проведение = Метаданные.СвойстваОбъектов.Проведение.Разрешить 
			И НЕ Документ.Имя = "ОтправкаСМС" 
			И НЕ Документ.Имя = "ЭлектронноеПисьмо" Тогда
			
			Если НомерШага > 0 Тогда
				ТекстЗапроса = ТекстЗапроса + " ОБЪЕДИНИТЬ ВСЕ ";
			КонецЕсли;
			
			Текст = " ВЫБРАТЬ
			|    Документ.Ссылка КАК Документ1
			|ИЗ 
			|    Документ.Накладная КАК Документ
			|ГДЕ
			|    НЕ Документ.Проведен И НЕ Документ.ПометкаУдаления ";
			
			Текст = СтрЗаменить(Текст, "Документ.Накладная", "Документ." + Документ.Имя);
			
			ТекстЗапроса = ТекстЗапроса + Текст;
			
			НомерШага = НомерШага + 1;
			
		КонецЕсли;
	КонецЦикла; 
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = ТаблицаРезультата.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		
		НоваяСтрокаОбъектыКИсправлению = ОбъектыКИсправлению.Добавить();
		НоваяСтрокаОбъектыКИсправлению.Документ1 = Выборка.Документ1;
		НоваяСтрокаОбъектыКИсправлению.Исправить = "ПометитьНаУдалениеНепроведенныеДокументы";
	КонецЦикла;
	
	Возврат ТаблицаРезультата;
	
КонецФункции

Функция ВывестиРезультатПроверки_ДокументыНеПроведенныеНеПомеченныеНаУдаление(ТаблицаРезультата)	
	
	Таб = Новый ТабличныйДокумент;
	Макет = ПолучитьОбщийМакет("МакетЭкспрессПроверкаУчета");
	
	Таб.НачатьАвтогруппировкуСтрок();
	
	ОбластьМакета = Макет.ПолучитьОбласть("Шапка_ВидПроверки");
	ОбластьМакета.Параметры.ВидПроверки = "Не проведенные и не помеченные на удаление документы";
	Таб.Вывести(ОбластьМакета, 1);
	
	Если ТаблицаРезультата.Количество() = 0 Тогда
		ОбластьМакета = Макет.ПолучитьОбласть("Шапка_ОшибокНет");
		Таб.Вывести(ОбластьМакета, 1);
	Иначе
		ОбластьМакета = Макет.ПолучитьОбласть("Шапка_ОшибкиЕсть_Исправить");
		ОбластьМакета.Параметры.КоличествоОшибок = "" + ТаблицаРезультата.Количество();
		ОбластьМакета.Параметры.Исправить = "ПометитьНаУдалениеНепроведенныеДокументы";
		ОбластьМакета.Параметры.ТекстПоясненияИсправления = "Процедура исправления помечает документы на удаление";
		Таб.Вывести(ОбластьМакета, 1);
		
		ОбластьМакета = Макет.ПолучитьОбласть("Шапка_Таблица");
		ОбластьМакета.Параметры.Документ1 = "Документ";
		ОбластьМакета.Параметры.Пояснение1 = "";
		ОбластьМакета.Параметры.Документ2 = "";
		ОбластьМакета.Параметры.Пояснение2 = "";
		Таб.Вывести(ОбластьМакета, 2, "Документ", Ложь);
		
		Ном = 1;
		Для Каждого ТекущаяСтрока Из ТаблицаРезультата Цикл
			ОбластьМакета = Макет.ПолучитьОбласть("Строка_Таблица");
			ЗаполнитьЗначенияСвойств(ОбластьМакета.Параметры, ТекущаяСтрока);
			ОбластьМакета.Параметры.Ном = Ном;
			Таб.Вывести(ОбластьМакета, 2, "Документ", Ложь);
			Ном = Ном + 1;
			
		КонецЦикла;
	КонецЕсли;
	
	Таб.ЗакончитьАвтогруппировкуСтрок();	
	Возврат Таб;
	
КонецФункции

Функция ИсправитьОбъект_ДокументыНеПроведенныеНеПомеченныеНаУдаление(ДокументСсылка) Экспорт
	
	ДокОбъект = ДокументСсылка.ПолучитьОбъект();				
	ДокОбъект.ПометкаУдаления = Истина;
	
	Попытка	
		ДокОбъект.Записать();
		Возврат Истина;
	Исключение
		Сообщить("Ошибка пометки на удаление: " + ОписаниеОшибки());
		Возврат Ложь;
	КонецПопытки;
	
КонецФункции

#КонецОбласти

//============================================== Документы и справочники помеченные на удаление (+)========================================
#Область ДокументыИСправочникиПомеченныеНаУдаление

Функция ВыполнитьПроверку_ДокументыИСправочникиПомеченныеНаУдаление() Экспорт
	
	РезультатПроверки = ПолучитьТаблицу_ДокументыИСправочникиПомеченныеНаУдаление();
	ТабДок = ВывестиРезультатПроверки_ДокументыИСправочникиПомеченныеНаУдаление(РезультатПроверки);
	Возврат ТабДок;
	
КонецФункции

Функция ПолучитьТаблицу_ДокументыИСправочникиПомеченныеНаУдаление()
	
	ТаблицаРезультата = Новый ТаблицаЗначений;
	ТаблицаРезультата.Колонки.Добавить("Документ1"); //Ссылка на документ или справочник
	ТаблицаРезультата.Колонки.Добавить("Пояснение1"); //ыид документа или спарвочника
	
	//документы
	НомерШага = 0;
	ТекстЗапроса = "";                               
	Для Каждого Документ Из Метаданные.Документы Цикл
		
		Если НомерШага > 0 Тогда
			ТекстЗапроса = ТекстЗапроса + " ОБЪЕДИНИТЬ ВСЕ ";
		КонецЕсли;
		
		Текст = " ВЫБРАТЬ
		|    Документ.Ссылка КАК Документ1
		|ИЗ 
		|    Документ.Накладная КАК Документ
		|ГДЕ
		|    Документ.ПометкаУдаления ";
		
		Текст = СтрЗаменить(Текст, "Документ.Накладная", "Документ." + Документ.Имя);
		
		ТекстЗапроса = ТекстЗапроса + Текст;
		
		НомерШага = НомерШага + 1;
		
	КонецЦикла; 
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = ТаблицаРезультата.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		НоваяСтрока.Пояснение1 = Строка(ТипЗнч(НоваяСтрока.Документ1));
	КонецЦикла;
	
	//справочники
	НомерШага = 0;
	ТекстЗапроса = "";                               
	Для Каждого Документ Из Метаданные.Справочники Цикл
		
		Если Документ.Имя = "ИдентификаторыОбъектовМетаданных"
			//++ №13508
			Или Документ.Имя = "ПредопределенныеВариантыОтчетов"
			Или Документ.Имя = "ПредопределенныеВариантыОтчетовРасширений"
			//-- №13508
			Тогда
			Продолжить;
		КонецЕсли;
		
		Если НомерШага > 0 Тогда
			ТекстЗапроса = ТекстЗапроса + " ОБЪЕДИНИТЬ ВСЕ ";
		КонецЕсли;
		
		Текст = " ВЫБРАТЬ
		|    Справочник.Ссылка КАК Документ1
		|ИЗ 
		|    Справочник.Накладная КАК Справочник
		|ГДЕ
		|    Справочник.ПометкаУдаления ";
		
		Текст = СтрЗаменить(Текст, "Справочник.Накладная", "Справочник." + Документ.Имя);
		
		ТекстЗапроса = ТекстЗапроса + Текст;
		
		НомерШага = НомерШага + 1;
		
	КонецЦикла; 
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = ТаблицаРезультата.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		НоваяСтрока.Пояснение1 = Строка(ТипЗнч(НоваяСтрока.Документ1));
	КонецЦикла;
	
	Возврат ТаблицаРезультата;
	
КонецФункции

Функция ВывестиРезультатПроверки_ДокументыИСправочникиПомеченныеНаУдаление(ТаблицаРезультата)	
	
	Таб = Новый ТабличныйДокумент;
	Макет = ПолучитьОбщийМакет("МакетЭкспрессПроверкаУчета");
	
	Таб.НачатьАвтогруппировкуСтрок();
	
	ОбластьМакета = Макет.ПолучитьОбласть("Шапка_ВидПроверки");
	ОбластьМакета.Параметры.ВидПроверки = "Помеченные на удаление документы и элементы справочников";
	Таб.Вывести(ОбластьМакета, 1);
	
	Если ТаблицаРезультата.Количество() = 0 Тогда
		ОбластьМакета = Макет.ПолучитьОбласть("Шапка_ОшибокНет");
		Таб.Вывести(ОбластьМакета, 1);
	Иначе
		ОбластьМакета = Макет.ПолучитьОбласть("Шапка_ОшибкиЕсть");
		ОбластьМакета.Параметры.КоличествоОшибок = ТаблицаРезультата.Количество();
		Таб.Вывести(ОбластьМакета, 1);
		
		ОбластьМакета = Макет.ПолучитьОбласть("Шапка_Таблица");
		ОбластьМакета.Параметры.Документ1 = "Объект";
		ОбластьМакета.Параметры.Пояснение1 = "Вид объекта";
		ОбластьМакета.Параметры.Документ2 = "";
		ОбластьМакета.Параметры.Пояснение2 = "";
		Таб.Вывести(ОбластьМакета, 2, "Документ", Ложь);
		
		Ном = 1;
		Для Каждого ТекущаяСтрока Из ТаблицаРезультата Цикл
			ОбластьМакета = Макет.ПолучитьОбласть("Строка_Таблица");
			ЗаполнитьЗначенияСвойств(ОбластьМакета.Параметры, ТекущаяСтрока);
			ОбластьМакета.Параметры.Ном = Ном;
			Таб.Вывести(ОбластьМакета, 2, "Документ", Ложь);
			Ном = Ном + 1;
			
		КонецЦикла;
	КонецЕсли;
	
	Таб.ЗакончитьАвтогруппировкуСтрок();	
	Возврат Таб;
	
КонецФункции

#КонецОбласти

#Область ДанныеПоПотолкуЗаказаНаПроизводствоНеСходятсяСДаннымиЗаказаПокупателя
//============================================== ДанныеПоПотолкуЗаказаНаПроизводствоНеСходятсяСДаннымиЗаказаПокупателя (+)========================================

Функция ВыполнитьПроверку_ДанныеПоПотолкуЗаказаНаПроизводствоНеСходятсяСДаннымиЗаказаПокупателя(ОбъектыКИсправлению, СтруктураПараметров) Экспорт
	
	РезультатПроверки = ПолучитьТаблицу_ДанныеПоПотолкуЗаказаНаПроизводствоНеСходятсяСДаннымиЗаказаПокупателя(ОбъектыКИсправлению, СтруктураПараметров);
	ТабДок = ВывестиРезультатПроверки_ДанныеПоПотолкуЗаказаНаПроизводствоНеСходятсяСДаннымиЗаказаПокупателя(РезультатПроверки);
	Возврат ТабДок;
	
КонецФункции

Функция ПолучитьТаблицу_ДанныеПоПотолкуЗаказаНаПроизводствоНеСходятсяСДаннымиЗаказаПокупателя(ОбъектыКИсправлению, СтруктураПараметров)
	
	ТаблицаРезультата = Новый ТаблицаЗначений;
	ТаблицаРезультата.Колонки.Добавить("Документ1"); //Заказ на произодство
	ТаблицаРезультата.Колонки.Добавить("Пояснение1"); //сумма документа
	ТаблицаРезультата.Колонки.Добавить("Документ2"); //Заказ покупателя
	ТаблицаРезультата.Колонки.Добавить("Пояснение2"); //сумма документа
	ТаблицаРезультата.Колонки.Добавить("Примечание"); //не используется
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ВидЗаказа", Перечисления.ВидыЗаказовНаПроизводство.ПроизводствоПотолка);
	Запрос.УстановитьПараметр("ДатаНачала",    СтруктураПараметров.Получить("ДатаНачала"));
	Запрос.УстановитьПараметр("ДатаОкончания", СтруктураПараметров.Получить("ДатаОкончания"));
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ДанныеДокумента.Ссылка КАК Документ1,
	|	ДанныеДокумента.ДокументОснование КАК Документ2,
	|	ДанныеДокумента.СуммаДокумента КАК Пояснение1,
	|	ДанныеДокумента.ДокументОснование.СуммаДокумента КАК Пояснение2
	|ИЗ
	|	Документ.ЗаказНаПроизводство КАК ДанныеДокумента
	
	//#14923 по тем ЗНП, которые указаны в ТЧ "Товары и услуги" в ЗП
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаказПокупателя.Товары КАК ТоварыЗП
	|		ПО (ТоварыЗП.Ссылка = ДанныеДокумента.ДокументОснование)
	|			И (ТоварыЗП.ЗаказНаПроизводство = ДанныеДокумента.Ссылка)
	
	|ГДЕ
	//|	НЕ ДанныеДокумента.ПометкаУдаления
	|	ДанныеДокумента.Проведен
	|	И ДанныеДокумента.ВидЗаказа = &ВидЗаказа
	|	И ДанныеДокумента.ДокументОснование ССЫЛКА Документ.ЗаказПокупателя
	|	И НЕ ДанныеДокумента.ДокументОснование = ЗНАЧЕНИЕ(Документ.ЗаказПокупателя.ПустаяСсылка)
	|	И НЕ ДанныеДокумента.ТекущийСтатус = ЗНАЧЕНИЕ(Справочник.СтатусыЗаказовНаПроизводство.Отменен)
	|	И (ДанныеДокумента.ПродукцияНоменклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Справочник.ВидыНоменклатуры.Потолок)
	|			ИЛИ ДанныеДокумента.ПродукцияНоменклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Справочник.ВидыНоменклатуры.Отрез))
	|	И (ДанныеДокумента.Дата >= &ДатаНачала
	|			ИЛИ &ДатаНачала = ДАТАВРЕМЯ(1, 1, 1))
	|	И (ДанныеДокумента.Дата <= &ДатаОкончания
	|			ИЛИ &ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1))
	|";	
	
	//ТаблицаЗаказов = Запрос.Выполнить().Выгрузить(); - не нужен? Нигде не используется
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		//Нужно проверить, что потолок из ЗнП есть в ЗП
		Если Выборка.Документ2.Товары.НайтиСтроки(новый Структура("Номенклатура", Выборка.Документ1.ПродукцияНоменклатура)).Количество() > 0 Тогда 
			
			СтруктураПроверки = ОбщийМодуль.ЗаказНаПроизводствоСоответствуетЗаказуПокупателя(Выборка.Документ1, Выборка.Документ2);
			Если НЕ СтруктураПроверки.Результат Тогда
				
				//Необходимо показать сумму Заказа покупателя, только по позициям ЗнП
				СуммаЗП = 0;
				Для Каждого ТекущаяСтрока Из СтруктураПроверки.МассивСравнения Цикл // №13466 было: Для Каждого ТекущаяСтрока Из СтруктураПроверки.МассивЗП Цикл
					СуммаЗП = СуммаЗП + ТекущаяСтрока.Сумма;
				КонецЦикла;
				
				НоваяСтрока = ТаблицаРезультата.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);	
				НоваяСтрока.Пояснение2 = СуммаЗП;
				
				НоваяСтрока = ОбъектыКИсправлению.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);				
				НоваяСтрока.Исправить = "ОбновитьЗаказНаПроизводствоПоПотолкуПоЗаказуПокупателя";
				НоваяСтрока.ПараметрБулево = СтруктураПроверки.ДоступноИзменениеПриНаличииВыпуска; //#13200 
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ТаблицаРезультата;
	
КонецФункции

Функция ВывестиРезультатПроверки_ДанныеПоПотолкуЗаказаНаПроизводствоНеСходятсяСДаннымиЗаказаПокупателя(ТаблицаРезультата)	
	
	Таб = Новый ТабличныйДокумент;
