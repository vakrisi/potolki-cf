Функция ИсправитьОбъект_ОтрицательныеОстаткиТоваров(ДокументРасходаТовара) Экспорт
	
	МассивСкладов = Новый Массив;
	Если ОбщегоНазначения.ЕстьРеквизитОбъекта("Склад", ДокументРасходаТовара.Метаданные()) Тогда
		МассивСкладов.Добавить(ДокументРасходаТовара.Склад);
	КонецЕсли;
	// выпуск
	Если ОбщегоНазначения.ЕстьРеквизитОбъекта("СкладПродукции", ДокументРасходаТовара.Метаданные()) Тогда
		МассивСкладов.Добавить(ДокументРасходаТовара.СкладПродукции);
	КонецЕсли;
	// выпуск
	Если ОбщегоНазначения.ЕстьРеквизитОбъекта("СкладМатериалов", ДокументРасходаТовара.Метаданные()) Тогда
		МассивСкладов.Добавить(ДокументРасходаТовара.СкладМатериалов);
	КонецЕсли;
	// комплектация , разукомплектация
	Если ОбщегоНазначения.ЕстьРеквизитОбъекта("СкладИсточник", ДокументРасходаТовара.Метаданные()) Тогда
		МассивСкладов.Добавить(ДокументРасходаТовара.СкладИсточник);
	КонецЕсли;
	// монтаж
	Если ОбщегоНазначения.ЕстьРеквизитОбъекта("СкладТоваров", ДокументРасходаТовара.Метаданные()) Тогда
		МассивСкладов.Добавить(ДокументРасходаТовара.СкладТоваров);
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Склад", МассивСкладов);
	Запрос.УстановитьПараметр("ДатаРасхода", ДокументРасходаТовара.Дата);		
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ДанныеДокумента.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ПоступлениеТоваровИУслуг КАК ДанныеДокумента
	|ГДЕ
	|	ДанныеДокумента.Проведен
	|	И ДанныеДокумента.Склад В(&Склад)
	|	И НАЧАЛОПЕРИОДА(ДанныеДокумента.Дата, ДЕНЬ) = НАЧАЛОПЕРИОДА(&ДатаРасхода, ДЕНЬ)
	|	И НЕ(ЧАС(ДанныеДокумента.Дата) = 0
	|				И МИНУТА(ДанныеДокумента.Дата) = 0
	|				И СЕКУНДА(ДанныеДокумента.Дата) = 1)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ДанныеДокумента.Ссылка
	|ИЗ
	|	Документ.ОприходованиеТоваров КАК ДанныеДокумента
	|ГДЕ
	|	ДанныеДокумента.Проведен
	|	И ДанныеДокумента.Склад В(&Склад)
	|	И НАЧАЛОПЕРИОДА(ДанныеДокумента.Дата, ДЕНЬ) = НАЧАЛОПЕРИОДА(&ДатаРасхода, ДЕНЬ)
	|	И НЕ(ЧАС(ДанныеДокумента.Дата) = 0
	|				И МИНУТА(ДанныеДокумента.Дата) = 0
	|				И СЕКУНДА(ДанныеДокумента.Дата) = 1)";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Результат = Истина;
	Пока Выборка.Следующий() Цикл
		ДокОбъект = Выборка.Ссылка.ПолучитьОбъект();
		ДокОбъект.Дата = НачалоДня(ДокОбъект.Дата) + 1;
		Попытка
			ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
		Исключение
			Сообщить("Ошибка проведения " + Выборка.Ссылка + ". " + ОписаниеОшибки());
			Результат = Ложь;
		КонецПопытки;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

