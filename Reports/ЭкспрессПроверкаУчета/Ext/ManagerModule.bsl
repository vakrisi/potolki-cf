Функция ВыполнитьПроверку_РеализацияРаньшеЗаказаПокупателя(ОбъектыКИсправлению, СтруктураПараметров) Экспорт
	
	РезультатПроверки = ПолучитьТаблицу_РеализацияРаньшеЗаказаПокупателя(ОбъектыКИсправлению, СтруктураПараметров);
	ТабДок = ВывестиРезультатПроверки_РеализацияРаньшеЗаказаПокупателя(РезультатПроверки);
	Возврат ТабДок;
	
КонецФункции

Функция ПолучитьТаблицу_РеализацияРаньшеЗаказаПокупателя(ОбъектыКИсправлению, СтруктураПараметров)
	
	ТаблицаРезультата = Новый ТаблицаЗначений;
	ТаблицаРезультата.Колонки.Добавить("Документ1");
	ТаблицаРезультата.Колонки.Добавить("Пояснение1");
	ТаблицаРезультата.Колонки.Добавить("Документ2");
	ТаблицаРезультата.Колонки.Добавить("Пояснение2");
	ТаблицаРезультата.Колонки.Добавить("Примечание");
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДатаНачала",    СтруктураПараметров.Получить("ДатаНачала"));
	Запрос.УстановитьПараметр("ДатаОкончания", СтруктураПараметров.Получить("ДатаОкончания"));
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ДанныеДокумента.Ссылка КАК Документ1,
	|	ДанныеДокумента.Дата КАК Пояснение1,
	|	ДанныеДокумента.Основание.Ссылка КАК Документ2,
	|	ДанныеДокумента.Основание.Дата КАК Пояснение2
	|ИЗ
	|	Документ.РеализацияТоваровИУслуг КАК ДанныеДокумента
	|ГДЕ
	|	ДанныеДокумента.Проведен
	|	И ДанныеДокумента.Основание.Проведен
	|	И ДанныеДокумента.Дата < ДанныеДокумента.Основание.Дата
	|	И ДанныеДокумента.Основание ССЫЛКА Документ.ЗаказПокупателя
	|	И (ДанныеДокумента.Дата >= &ДатаНачала
	|			ИЛИ &ДатаНачала = ДАТАВРЕМЯ(1, 1, 1))
	|	И (ДанныеДокумента.Дата <= &ДатаОкончания
	|			ИЛИ &ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1))
	|";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = ТаблицаРезультата.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		НоваяСтрока.Примечание = ТекстОшибкиДополнительно(Выборка.Пояснение1, Выборка.Пояснение2);	
		
		НоваяСтрока = ОбъектыКИсправлению.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		НоваяСтрока.Исправить = "ПоставитьДатуРеализацииПозжеДатыЗаказаПокупателя";
	КонецЦикла;
	
	Возврат ТаблицаРезультата;
	
КонецФункции

