Функция ТекстОшибкиДополнительно(Дата1, Дата2)
	
	Если НачалоДня(Дата1) <> НачалоДня(Дата2) Тогда
		Возврат "Различаются даты документов. Требуется ручное исправление"	
	КонецЕсли;
	Возврат "";
	
КонецФункции

#Область РазныеПодразделенияВЗаказеНаПроизводствоИВВыпускеПродукции
//============================================== Разные подразделения в заказе на производство и в выпуске продукции (+)========================================

Функция ВыполнитьПроверку_РазныеПодразделенияЗаказНаПроизводствоИВыпускПродукции(СтруктураПараметров) Экспорт
	
	РезультатПроверки = ПолучитьТаблицу_РазныеПодразделенияЗаказНаПроизводствоИВыпускПродукции(СтруктураПараметров);
	ТабДок = ВывестиРезультатПроверки_РазныеПодразделенияЗаказНаПроизводствоИВыпускПродукции(РезультатПроверки);
	Возврат ТабДок;
	
КонецФункции

Функция ПолучитьТаблицу_РазныеПодразделенияЗаказНаПроизводствоИВыпускПродукции(СтруктураПараметров)
	
	ТаблицаРезультата = Новый ТаблицаЗначений;
	ТаблицаРезультата.Колонки.Добавить("Документ1");
	ТаблицаРезультата.Колонки.Добавить("Пояснение1");
	ТаблицаРезультата.Колонки.Добавить("Документ2");
	ТаблицаРезультата.Колонки.Добавить("Пояснение2");
	ТаблицаРезультата.Колонки.Добавить("Примечание");
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДатаНачала",    СтруктураПараметров.Получить("ДатаНачала"));
	Запрос.УстановитьПараметр("ДатаОкончания", СтруктураПараметров.Получить("ДатаОкончания"));
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ДанныеДокумента.Ссылка КАК Документ1,
	|	ДанныеДокумента.Основание КАК Документ2,
	|	ДанныеДокумента.Подразделение КАК Пояснение1,
	|	ДанныеДокумента.Основание.Подразделение КАК Пояснение2
	|ИЗ
	|	Документ.ВыпускПродукции КАК ДанныеДокумента
	|ГДЕ
	|	ДанныеДокумента.Проведен
	|	И ДанныеДокумента.Основание.Проведен
	|	И ДанныеДокумента.Подразделение <> ДанныеДокумента.Основание.Подразделение
	|	И (ДанныеДокумента.Дата >= &ДатаНачала
	|			ИЛИ &ДатаНачала = ДАТАВРЕМЯ(1, 1, 1))
	|	И (ДанныеДокумента.Дата <= &ДатаОкончания
	|			ИЛИ &ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1))
	|";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = ТаблицаРезультата.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
	КонецЦикла;
	
	Возврат ТаблицаРезультата;
	
КонецФункции

Функция ВывестиРезультатПроверки_РазныеПодразделенияЗаказНаПроизводствоИВыпускПродукции(ТаблицаРезультата)
	
	Таб = Новый ТабличныйДокумент;
	Макет = ПолучитьОбщийМакет("макетЭкспрессПроверкаУчета");
	
	Таб.НачатьАвтогруппировкуСтрок();
	
	ОбластьМакета = Макет.ПолучитьОбласть("Шапка_ВидПроверки");
	ОбластьМакета.Параметры.ВидПроверки = "Разные подразделения в документах ""Заказ на производство"" и ""Выпуск продукции""";
	Таб.Вывести(ОбластьМакета, 1);
	
	Если ТаблицаРезультата.Количество() = 0 Тогда
		ОбластьМакета = Макет.ПолучитьОбласть("Шапка_ОшибокНет");
		Таб.Вывести(ОбластьМакета, 1);
	Иначе
		ОбластьМакета = Макет.ПолучитьОбласть("Шапка_ОшибкиЕсть");
		ОбластьМакета.Параметры.КоличествоОшибок = ТаблицаРезультата.Количество();
		Таб.Вывести(ОбластьМакета, 1);
		
		ОбластьМакета = Макет.ПолучитьОбласть("Шапка_Таблица");
		ОбластьМакета.Параметры.Документ1 = "Выпуск продукции";
		ОбластьМакета.Параметры.Пояснение1 = "Подразделение";
		ОбластьМакета.Параметры.Документ2 = "Заказ на производство";
		ОбластьМакета.Параметры.Пояснение2 = "Подразделение";
		Таб.Вывести(ОбластьМакета, 2, "Документ", Ложь);
		
		Ном = 1;
		Для Каждого ТекущаяСтрока Из ТаблицаРезультата Цикл
			ОбластьМакета = Макет.ПолучитьОбласть("Строка_Таблица");
			ЗаполнитьЗначенияСвойств(ОбластьМакета.Параметры, ТекущаяСтрока);
			ОбластьМакета.Параметры.Ном = Ном;
			Таб.Вывести(ОбластьМакета, 2, "Документ", Ложь);
			Ном = Ном + 1;
		КонецЦикла;
	КонецЕсли;
	
	Таб.ЗакончитьАвтогруппировкуСтрок();
	
	Возврат Таб;
	
КонецФункции

#КонецОбласти

#Область ДатаДокументаВыпускаМеньшеЧемДатаЗаказаНаПроизводство
//============================================== Дата документа выпуска меньше чем дата заказа на производство (+)===============================================

Функция ВыполнитьПроверку_ВыпускПродукцииРаньшеЗаказаНаПроизводство(ОбъектыКИсправлению, СтруктураПараметров) Экспорт
	
	РезультатПроверки = ПолучитьТаблицу_ВыпускПродукцииРаньшеЗаказаНаПроизводство(ОбъектыКИсправлению, СтруктураПараметров);
	ТабДок = ВывестиРезультатПроверки_ВыпускПродукцииРаньшеЗаказаНаПроизводство(РезультатПроверки);
	Возврат ТабДок;
	
КонецФункции

Функция ПолучитьТаблицу_ВыпускПродукцииРаньшеЗаказаНаПроизводство(ОбъектыКИсправлению, СтруктураПараметров)
	
	ТаблицаРезультата = Новый ТаблицаЗначений;
	ТаблицаРезультата.Колонки.Добавить("Документ1");
	ТаблицаРезультата.Колонки.Добавить("Пояснение1");
	ТаблицаРезультата.Колонки.Добавить("Документ2");
	ТаблицаРезультата.Колонки.Добавить("Пояснение2");
	ТаблицаРезультата.Колонки.Добавить("Примечание");
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДатаНачала",    СтруктураПараметров.Получить("ДатаНачала"));
	Запрос.УстановитьПараметр("ДатаОкончания", СтруктураПараметров.Получить("ДатаОкончания"));
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ДанныеДокумента.Ссылка КАК Документ1,
	|	ДанныеДокумента.Основание.Ссылка КАК Документ2,
	|	ДанныеДокумента.Дата КАК Пояснение1,
	|	ДанныеДокумента.Основание.Дата КАК Пояснение2
	|ИЗ
	|	Документ.ВыпускПродукции КАК ДанныеДокумента
	|ГДЕ
	|	ДанныеДокумента.Проведен
	|	И ДанныеДокумента.Основание.Проведен
	|	И ДанныеДокумента.Дата < ДанныеДокумента.Основание.Дата
	|	И (ДанныеДокумента.Дата >= &ДатаНачала
	|			ИЛИ &ДатаНачала = ДАТАВРЕМЯ(1, 1, 1))
	|	И (ДанныеДокумента.Дата <= &ДатаОкончания
	|			ИЛИ &ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1))
	|";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = ТаблицаРезультата.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		НоваяСтрока.Примечание = ТекстОшибкиДополнительно(Выборка.Пояснение1, Выборка.Пояснение2);	
		
		НоваяСтрока = ОбъектыКИсправлению.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		НоваяСтрока.Исправить = "ПоставитьДатуВыпускаПозжеДатыЗаказаНаПроизводство";
	КонецЦикла;
	
	Возврат ТаблицаРезультата;
	
КонецФункции

Функция ВывестиРезультатПроверки_ВыпускПродукцииРаньшеЗаказаНаПроизводство(ТаблицаРезультата)
	
	Таб = Новый ТабличныйДокумент;
	Макет = ПолучитьОбщийМакет("МакетЭкспрессПроверкаУчета");
	
	Таб.НачатьАвтогруппировкуСтрок();
	
	ОбластьМакета = Макет.ПолучитьОбласть("Шапка_ВидПроверки");
	ОбластьМакета.Параметры.ВидПроверки = """Выпуск продукции"" имеет дату меньшую чем документ ""Заказ на производство""";
	Таб.Вывести(ОбластьМакета, 1);
	
	Если ТаблицаРезультата.Количество() = 0 Тогда
		ОбластьМакета = Макет.ПолучитьОбласть("Шапка_ОшибокНет");
