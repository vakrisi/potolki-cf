	|	ВТ_ТаблицыПоступленийВрем.Документ1 КАК Документ1,
	|	ВТ_ТаблицыПоступленийВрем.Документ2 КАК Документ2,
	|	ВТ_ТаблицыПоступленийВрем.Номенклатура КАК Номенклатура,
	|	ВТ_ТаблицыПоступленийВрем.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	|	ВТ_ТаблицыПоступленийВрем.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	СУММА(ВТ_ТаблицыПоступленийВрем.Количество) КАК Количество,
	|	ВТ_ТаблицыПоступленийВрем.Цена КАК Цена,
	|	СУММА(ВТ_ТаблицыПоступленийВрем.Сумма) КАК Сумма
	|ПОМЕСТИТЬ ВТ_ТаблицыПоступлений
	|ИЗ
	|	ВТ_ТаблицыПоступленийВрем КАК ВТ_ТаблицыПоступленийВрем
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_ТаблицыПоступленийВрем.Таблица,
	|	ВТ_ТаблицыПоступленийВрем.Документ1,
	|	ВТ_ТаблицыПоступленийВрем.Документ2,
	|	ВТ_ТаблицыПоступленийВрем.Номенклатура,
	|	ВТ_ТаблицыПоступленийВрем.ХарактеристикаНоменклатуры,
	|	ВТ_ТаблицыПоступленийВрем.ЕдиницаИзмерения,
	|	ВТ_ТаблицыПоступленийВрем.Цена
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВТ_ТаблицыРеализаций.Документ1 КАК Документ1,
	|	ЕСТЬNULL(ВТ_ТаблицыПоступлений.Документ2, ВТ_РеализацииПоступления.Документ2) КАК Документ2,
	|	ЕСТЬNULL(ВТ_ТаблицыРеализаций.Номенклатура, ВТ_ТаблицыПоступлений.Номенклатура) КАК Номенклатура,
	|	ЕСТЬNULL(ВТ_ТаблицыРеализаций.ХарактеристикаНоменклатуры, ВТ_ТаблицыПоступлений.ХарактеристикаНоменклатуры) КАК ХарактеристикаНоменклатуры,
	|	ЕСТЬNULL(ВТ_ТаблицыРеализаций.ЕдиницаИзмерения, ВТ_ТаблицыПоступлений.ЕдиницаИзмерения) КАК ЕдиницаИзмерения,
	|	ЕСТЬNULL(ВТ_ТаблицыРеализаций.Цена, ВТ_ТаблицыПоступлений.Цена) КАК Цена,
	|	ВТ_ТаблицыРеализаций.Количество КАК Количество,
	|	ЕСТЬNULL(ВТ_ТаблицыПоступлений.Количество, 0) КАК Количество1,
	|	ВТ_ТаблицыРеализаций.Сумма КАК Сумма,
	|	ЕСТЬNULL(ВТ_ТаблицыПоступлений.Сумма, 0) КАК Сумма1
	|ИЗ
	|	ВТ_ТаблицыРеализаций КАК ВТ_ТаблицыРеализаций
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_РеализацииПоступления КАК ВТ_РеализацииПоступления
	|		ПО (ВТ_РеализацииПоступления.Документ1 = ВТ_ТаблицыРеализаций.Документ1)
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ТаблицыПоступлений КАК ВТ_ТаблицыПоступлений
	|		ПО (ВТ_ТаблицыПоступлений.Документ1 = ВТ_ТаблицыРеализаций.Документ1)
	|			И (ВТ_ТаблицыПоступлений.Таблица = ВТ_ТаблицыРеализаций.Таблица)
	|			И (ВТ_ТаблицыПоступлений.Номенклатура = ВТ_ТаблицыРеализаций.Номенклатура)
	|			И (ВТ_ТаблицыПоступлений.ХарактеристикаНоменклатуры = ВТ_ТаблицыРеализаций.ХарактеристикаНоменклатуры)
	|			И (ВТ_ТаблицыПоступлений.ЕдиницаИзмерения = ВТ_ТаблицыРеализаций.ЕдиницаИзмерения)
	|			И ВЫБОР
	|				КОГДА &УслугиВыделены
	|					ТОГДА (ВТ_ТаблицыПоступлений.Цена = ВТ_ТаблицыРеализаций.Цена) 
	|				ИНАЧЕ ИСТИНА
	|			КОНЕЦ
	|ГДЕ
	|	ВЫБОР 
	|		КОГДА &УслугиВыделены 
	|			ТОГДА (НЕ ВТ_ТаблицыРеализаций.Количество = ЕСТЬNULL(ВТ_ТаблицыПоступлений.Количество, 0)
	|					ИЛИ НЕ ВТ_ТаблицыРеализаций.Сумма = ЕСТЬNULL(ВТ_ТаблицыПоступлений.Сумма, 0))
	|			ИНАЧЕ (НЕ ВТ_ТаблицыРеализаций.Количество = ЕСТЬNULL(ВТ_ТаблицыПоступлений.Количество, 0))
	|	КОНЕЦ
	|
	|ИТОГИ ПО
	|	Документ1,
	|	Документ2";
	
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаРеализаций = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаРеализаций.Следующий() Цикл
		ВыборкаПоступлений = ВыборкаРеализаций.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаПоступлений.Следующий() Цикл
			Примечание = "";
			Выборка = ВыборкаПоступлений.Выбрать();
			Пока Выборка.Следующий() Цикл
				Примечание = Примечание + ?(ПустаяСтрока(Примечание), "", Символы.ПС) + Выборка.Номенклатура;	
			КонецЦикла;
			НоваяСтрока = ТаблицаРезультата.Добавить();
			НоваяСтрока.Документ1 = ВыборкаРеализаций.Документ1;
			НоваяСтрока.Документ2 = ВыборкаПоступлений.Документ2;
			НоваяСтрока.Примечание = Примечание;
			
		КонецЦикла;
	КонецЦикла;
	
	Возврат ТаблицаРезультата;
	
КонецФункции

Функция ВывестиРезультатПроверки_СоответствиеПоступленийРеализацийПоИнтеркампани(ТаблицаРезультата)	
	
	Таб = Новый ТабличныйДокумент;
	Макет = ПолучитьОбщийМакет("МакетЭкспрессПроверкаУчета");
	
	Таб.НачатьАвтогруппировкуСтрок();
	
	ОбластьМакета = Макет.ПолучитьОбласть("Шапка_ВидПроверки");
	ОбластьМакета.Параметры.ВидПроверки = "Соответствие поступлений и реализаций по интеркампани (Производство-Розница и Розница-Производство).";
	Таб.Вывести(ОбластьМакета, 1);
	
	Если ТаблицаРезультата.Количество() = 0 Тогда
		ОбластьМакета = Макет.ПолучитьОбласть("Шапка_ОшибокНет");
		Таб.Вывести(ОбластьМакета, 1);
	Иначе
		ОбластьМакета = Макет.ПолучитьОбласть("Шапка_ОшибкиЕсть");
		ОбластьМакета.Параметры.КоличествоОшибок = ТаблицаРезультата.Количество();
		Таб.Вывести(ОбластьМакета, 1);
		
		ОбластьМакета = Макет.ПолучитьОбласть("Шапка_Таблица");
		ОбластьМакета.Параметры.Документ1  = "Реализация";
		ОбластьМакета.Параметры.Документ2  = "Поступление";
		Таб.Вывести(ОбластьМакета, 2, "Документ", Ложь);
		
		Ном = 1;
		Для Каждого ТекущаяСтрока Из ТаблицаРезультата Цикл
			ОбластьМакета = Макет.ПолучитьОбласть("Строка_Таблица");
			ЗаполнитьЗначенияСвойств(ОбластьМакета.Параметры, ТекущаяСтрока);
			ОбластьМакета.Параметры.Ном = Ном;
			Таб.Вывести(ОбластьМакета, 2, "Документ", Ложь);
			Ном = Ном + 1;
			
		КонецЦикла;
	КонецЕсли;
	
	Таб.ЗакончитьАвтогруппировкуСтрок();	
	Возврат Таб;
	
КонецФункции

#КонецОбласти

#Область НеуникальностьНомераРасчетаПоНоменклатуре
//(+)
Функция ВыполнитьПроверку_НеуникальностьНомераРасчетаПоНоменклатуре(СтруктураПараметров) Экспорт
	
	РезультатПроверки = ПолучитьТаблицу_НеуникальностьНомераРасчетаПоНоменклатуре(СтруктураПараметров);
	ТабДок = ВывестиРезультатПроверки_НеуникальностьНомераРасчетаПоНоменклатуре(РезультатПроверки);
	Возврат ТабДок;
	
КонецФункции

Функция ПолучитьТаблицу_НеуникальностьНомераРасчетаПоНоменклатуре(СтруктураПараметров)
	
	ТаблицаРезультата = Новый ТаблицаЗначений;
	ТаблицаРезультата.Колонки.Добавить("Документ1"); 
	ТаблицаРезультата.Колонки.Добавить("Примечание");
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Номенклатура.Потолок_НомерРасчета КАК НомерРасчета,
	|	Номенклатура.Потолок_ИндексПотолка КАК ИндексПотолка,
	|	СУММА(1) КАК Количество
	|ПОМЕСТИТЬ ВТ_ДублиНомеров
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	(НЕ Номенклатура.Потолок_НомерРасчета = """" Или НЕ Номенклатура.Потолок_ИндексПотолка = """")
	|	И НЕ Номенклатура.ВидНоменклатуры = Значение(Справочник.ВидыНоменклатуры.ТиповойОтрез)
	|	
	|СГРУППИРОВАТЬ ПО
	|	Номенклатура.Потолок_НомерРасчета,
	|	Номенклатура.Потолок_ИндексПотолка
	|ИМЕЮЩИЕ
	|	СУММА(1) > 1
	|	
	|;
	|////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Номенклатура.Ссылка КАК Документ1,
	|	Номенклатура.Потолок_НомерРасчета КАК НомерРасчета,
	|	Номенклатура.Потолок_ИндексПотолка КАК ИндексПотолка,
	|	ДублиНомеров.Количество КАК КоличествоНоменклатур
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ДублиНомеров КАК ДублиНомеров
	|		ПО Номенклатура.Потолок_НомерРасчета = ДублиНомеров.НомерРасчета
	|			И Номенклатура.Потолок_ИндексПотолка = ДублиНомеров.ИндексПотолка
	|";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Примечание = СтрШаблон("В справочнике ""Номенклатура"" имеется %1 карточки с одинаковым номером расчета %2%3",
		Выборка.КоличествоНоменклатур,
		Выборка.НомерРасчета,
		?(ЗначениеЗаполнено(Выборка.ИндексПотолка), " и индексом " + Выборка.ИндексПотолка, "")
		);
		
		НоваяСтрока = ТаблицаРезультата.Добавить();
		НоваяСтрока.Документ1 = Выборка.Документ1;
		НоваяСтрока.Примечание = Примечание;
		
	КонецЦикла;
	
	Возврат ТаблицаРезультата;
	
КонецФункции

Функция ВывестиРезультатПроверки_НеуникальностьНомераРасчетаПоНоменклатуре(ТаблицаРезультата)	
	
	Таб = Новый ТабличныйДокумент;
	Макет = ПолучитьОбщийМакет("МакетЭкспрессПроверкаУчета");
	
