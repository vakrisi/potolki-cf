		ОбластьМакета.Параметры.Исправить = "ПоставитьДатуВыпускаПозжеДатыЗаказаНаПроизводство";
		ОбластьМакета.Параметры.ТекстПоясненияИсправления = "Процедура исправления изменяет дату документа ""Заказ на производство"" на дату документа ""Выпуск продукции"", уменьшенную на 1 секунду";
		Таб.Вывести(ОбластьМакета, 1);
		
		ОбластьМакета = Макет.ПолучитьОбласть("Шапка_Таблица");
		ОбластьМакета.Параметры.Документ1 = "Выпуск продукции";
		ОбластьМакета.Параметры.Пояснение1 = "Дата";
		ОбластьМакета.Параметры.Документ2 = "Заказ на производство";
		ОбластьМакета.Параметры.Пояснение2 = "Дата";
		Таб.Вывести(ОбластьМакета, 2, "Документ", Ложь);
		
		Ном = 1;
		Для Каждого ТекущаяСтрока Из ТаблицаРезультата Цикл
			ОбластьМакета = Макет.ПолучитьОбласть("Строка_Таблица");
			ЗаполнитьЗначенияСвойств(ОбластьМакета.Параметры, ТекущаяСтрока);
			ОбластьМакета.Параметры.Ном = Ном;
			Таб.Вывести(ОбластьМакета, 2, "Документ", Ложь);
			Ном = Ном + 1;
			
		КонецЦикла;
	КонецЕсли;
	
	Таб.ЗакончитьАвтогруппировкуСтрок();
	Возврат Таб;
	
КонецФункции

Функция ИсправитьОбъект_ВыпускПродукцииРаньшеЗаказаНаПроизводство(ДокументВыпускПродукции, ДокументЗаказНаПроизводство) Экспорт
	
	Если НачалоДня(ДокументВыпускПродукции.Дата) <> НачалоДня(ДокументЗаказНаПроизводство.Дата) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ОбъектЗаказ = ДокументЗаказНаПроизводство.ПолучитьОбъект();
	ОбъектЗаказ.Дата = ДокументВыпускПродукции.Дата - 1;
	
	Попытка
		Если ОбъектЗаказ.Проведен Тогда
			ОбъектЗаказ.Записать(РежимЗаписиДокумента.Проведение);
		Иначе
			ОбъектЗаказ.Записать();
		КонецЕсли;
		Возврат Истина;
	Исключение
		//Сообщить("Попытка присвоить дату " + ОбъектВыпуск.Дата + " для " + ОбъектВыпуск + ". Ошибка: " + ОписаниеОшибки());
		Возврат Ложь;
	КонецПопытки;
	
КонецФункции
#КонецОбласти

