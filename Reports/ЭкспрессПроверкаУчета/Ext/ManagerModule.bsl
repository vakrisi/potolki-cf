					Пока ВыборкаСклад.Следующий() Цикл
						ОбластьМакета = Макет.ПолучитьОбласть("Шапка_отриц_остатки_склад");
						ОбластьМакета.Параметры.Склад = ВыборкаСклад.Склад;
