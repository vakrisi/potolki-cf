	Таб.Вывести(ОбластьМакета, 1);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ДанныеРегистра.Организация КАК Организация,
	|	ДанныеРегистра.СчетКасса КАК СчетКасса,
	|	ДанныеРегистра.Валюта КАК Валюта,
	|	ДанныеРегистра.Регистратор КАК Регистратор,
	|	ДанныеРегистра.СуммаКонечныйОстаток КАК СуммаПослеДвижения
	|ИЗ
	|	РегистрНакопления.ДенежныеСредства.ОстаткиИОбороты(, , Регистратор, , ) КАК ДанныеРегистра
	|ГДЕ
	|	ДанныеРегистра.СуммаКонечныйОстаток < 0
	|	И НЕ ДанныеРегистра.СуммаПриход > 0 
	|ИТОГИ ПО
	|	Организация,
	|	СчетКасса,
	|	Валюта";
