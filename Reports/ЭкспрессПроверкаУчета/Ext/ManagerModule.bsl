	ОбластьМакета.Параметры.ВидПроверки = "Корректность использования остатков пленки";
	Таб.Вывести(ОбластьМакета, 1);
	
	Если ТаблицаРезультата.Количество() = 0 Тогда
		ОбластьМакета = Макет.ПолучитьОбласть("Шапка_ОшибокНет");
		Таб.Вывести(ОбластьМакета, 1);
