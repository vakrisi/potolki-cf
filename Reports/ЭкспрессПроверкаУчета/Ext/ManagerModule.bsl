#Область ПотолокУказанныйВЗаказеНаПроизводствоОтсутствуетВЗаказеПокупателя
//============================================== ПотолокУказанныйВЗаказеНаПроизводствоОтсутствуетВЗаказеПокупателя (+)========================================

Функция ВыполнитьПроверку_ПотолокУказанныйВЗаказеНаПроизводствоОтсутствуетВЗаказеПокупателя(СтруктураПараметров) Экспорт
	
	РезультатПроверки = ПолучитьТаблицу_ПотолокУказанныйВЗаказеНаПроизводствоОтсутствуетВЗаказеПокупателя(СтруктураПараметров);
	ТабДок = ВывестиРезультатПроверки_ПотолокУказанныйВЗаказеНаПроизводствоОтсутствуетВЗаказеПокупателя(РезультатПроверки);
	Возврат ТабДок;
	
КонецФункции

Функция ПолучитьТаблицу_ПотолокУказанныйВЗаказеНаПроизводствоОтсутствуетВЗаказеПокупателя(СтруктураПараметров)
	
	ТаблицаРезультата = Новый ТаблицаЗначений;
	ТаблицаРезультата.Колонки.Добавить("Документ1"); //Заказ на произодство
	ТаблицаРезультата.Колонки.Добавить("Пояснение1"); //Потолок или список типовых отрезов
	ТаблицаРезультата.Колонки.Добавить("Документ2"); //Заказ покупателя
	ТаблицаРезультата.Колонки.Добавить("Пояснение2"); //не используется
	ТаблицаРезультата.Колонки.Добавить("Примечание"); //не используется
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДатаНачала",    СтруктураПараметров.Получить("ДатаНачала"));
	Запрос.УстановитьПараметр("ДатаОкончания", СтруктураПараметров.Получить("ДатаОкончания"));
	Запрос.УстановитьПараметр("ВидЗаказа", Перечисления.ВидыЗаказовНаПроизводство.ПроизводствоПотолка);
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ДанныеДокумента.Ссылка КАК Документ1,
	|	ДанныеДокумента.ДокументОснование КАК Документ2,
	|	ДанныеДокумента.ПродукцияНоменклатура,
	|	ДанныеДокумента.ПродукцияУИСтроки,
	|	ВЫБОР
	|		КОГДА ДанныеДокумента.ВидЗаказа = Значение(Перечисление.ВидыЗаказовНаПроизводство.ПроизводствоПотолка)
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ПроизводствоПотолка
	|ИЗ
	|	Документ.ЗаказНаПроизводство КАК ДанныеДокумента
	|ГДЕ
	|	НЕ ДанныеДокумента.ПометкаУдаления
	|	И (ДанныеДокумента.ВидЗаказа = Значение(Перечисление.ВидыЗаказовНаПроизводство.ПроизводствоПотолка)
	|		ИЛИ ДанныеДокумента.ВидЗаказа = Значение(Перечисление.ВидыЗаказовНаПроизводство.ТиповоеПроизводство))
	|	И ДанныеДокумента.ДокументОснование ССЫЛКА Документ.ЗаказПокупателя
	|	И НЕ ДанныеДокумента.ДокументОснование = ЗНАЧЕНИЕ(Документ.ЗаказПокупателя.ПустаяСсылка)
	|	И НЕ ДанныеДокумента.ТекущийСтатус = ЗНАЧЕНИЕ(Справочник.СтатусыЗаказовНаПроизводство.Отменен)
	|	И (ДанныеДокумента.ПродукцияНоменклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Справочник.ВидыНоменклатуры.Потолок)
	|			ИЛИ ДанныеДокумента.ПродукцияНоменклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Справочник.ВидыНоменклатуры.Отрез))
	|	И (ДанныеДокумента.Дата >= &ДатаНачала
	|			ИЛИ &ДатаНачала = ДАТАВРЕМЯ(1, 1, 1))
	|	И (ДанныеДокумента.Дата <= &ДатаОкончания
	|			ИЛИ &ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1))
	|";		
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		Отсутствует = Ложь;
		СписокПотолков = "";
		
		//Если потолок, то смотрим по ПродукцияНоменклатура, если типовое производство, то смотрим для каждой номенклатуры из ТЧ Продукции
		Если Выборка.ПроизводствоПотолка Тогда
			
			Если Выборка.Документ2.Товары.НайтиСтроки(новый Структура("Номенклатура, УИСтроки", Выборка.ПродукцияНоменклатура, Выборка.ПродукцияУИСтроки)).Количество() = 0 Тогда
				Отсутствует = Истина;
				СписокПотолков = Выборка.ПродукцияНоменклатура;
			КонецЕсли;
			
		Иначе
			
			СписокПотолков = новый СписокЗначений;
			
			Для Каждого ТиповойПотолок Из Выборка.Документ1.Продукция Цикл
				Если Выборка.Документ2.Товары.НайтиСтроки(новый Структура("Номенклатура, УИСтроки", ТиповойПотолок.Номенклатура, ТиповойПотолок.УИСтроки)).Количество() = 0 Тогда
					Отсутствует = Истина;
					СписокПотолков.Добавить(ТиповойПотолок.Номенклатура);
				КонецЕсли;	
			КонецЦикла;
			
		КонецЕсли;	
		
		Если Отсутствует Тогда
			НоваяСтрока = ТаблицаРезультата.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
			НоваяСтрока.Пояснение1 = СписокПотолков;
		КонецЕсли;		
		
	КонецЦикла;
	
	Возврат ТаблицаРезультата;
	
КонецФункции

Функция ВывестиРезультатПроверки_ПотолокУказанныйВЗаказеНаПроизводствоОтсутствуетВЗаказеПокупателя(ТаблицаРезультата)	
	
	Таб = Новый ТабличныйДокумент;
	Макет = ПолучитьОбщийМакет("МакетЭкспрессПроверкаУчета");
	
	Таб.НачатьАвтогруппировкуСтрок();
	
	ОбластьМакета = Макет.ПолучитьОбласть("Шапка_ВидПроверки");
	ОбластьМакета.Параметры.ВидПроверки = "Потолок указанный в документе ""Заказ на производство"" отсутствует в документе ""Заказ покупателя""";
	Таб.Вывести(ОбластьМакета, 1);
	
	Если ТаблицаРезультата.Количество() = 0 Тогда
		ОбластьМакета = Макет.ПолучитьОбласть("Шапка_ОшибокНет");
		Таб.Вывести(ОбластьМакета, 1);
	Иначе
		ОбластьМакета = Макет.ПолучитьОбласть("Шапка_ОшибкиЕсть");
		ОбластьМакета.Параметры.КоличествоОшибок = ТаблицаРезультата.Количество();
		Таб.Вывести(ОбластьМакета, 1);
		//ОбластьМакета = Макет.ПолучитьОбласть("Шапка_ОшибкиЕсть_Исправить");
		//ОбластьМакета.Параметры.КоличествоОшибок = ТаблицаРезультата.Количество();
		//ОбластьМакета.Параметры.Исправить = "ОбновитьЗаказНаПроизводствоПоПотолкуПоЗаказуПокупателя";
		//Таб.Вывести(ОбластьМакета, 1);
		
		ОбластьМакета = Макет.ПолучитьОбласть("Шапка_Таблица");
		ОбластьМакета.Параметры.Документ1 = "Заказ на производство";
		ОбластьМакета.Параметры.Пояснение1 = "Список потолков";
		ОбластьМакета.Параметры.Документ2 = "Заказ покупателя";
		ОбластьМакета.Параметры.Пояснение2 = "";
		Таб.Вывести(ОбластьМакета, 2, "Документ", Ложь);
		
		Ном = 1;
		Для Каждого ТекущаяСтрока Из ТаблицаРезультата Цикл
			ОбластьМакета = Макет.ПолучитьОбласть("Строка_Таблица");
			ЗаполнитьЗначенияСвойств(ОбластьМакета.Параметры, ТекущаяСтрока);
			ОбластьМакета.Параметры.Ном = Ном;
			Таб.Вывести(ОбластьМакета, 2, "Документ", Ложь);
			Ном = Ном + 1;
			
		КонецЦикла;
	КонецЕсли;
	
	Таб.ЗакончитьАвтогруппировкуСтрок();	
	Возврат Таб;
	
КонецФункции

#КонецОбласти

#Область ПроверкаСоответствияПродукцииВыпускаИЗаказаНаПроизводство
//(+)
Функция ВыполнитьПроверку_ПроверкаСоответствияПродукцииВыпускаИЗаказаНаПроизводство(СтруктураПараметров) Экспорт
	
	РезультатПроверки = ПолучитьТаблицу_ПроверкаСоответствияПродукцииВыпускаИЗаказаНаПроизводство(СтруктураПараметров);
	ТабДок = ВывестиРезультатПроверки_ПроверкаСоответствияПродукцииВыпускаИЗаказаНаПроизводство(РезультатПроверки);
	Возврат ТабДок;
	
КонецФункции

Функция ПолучитьТаблицу_ПроверкаСоответствияПродукцииВыпускаИЗаказаНаПроизводство(СтруктураПараметров)
	
	ТаблицаРезультата = Новый ТаблицаЗначений;
	ТаблицаРезультата.Колонки.Добавить("Документ1"); //Выпуск
	ТаблицаРезультата.Колонки.Добавить("Пояснение1"); 
	ТаблицаРезультата.Колонки.Добавить("Документ2"); //Заказ НП
	ТаблицаРезультата.Колонки.Добавить("Пояснение2"); 
	ТаблицаРезультата.Колонки.Добавить("Примечание"); //не используется
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДатаНачала",    СтруктураПараметров.Получить("ДатаНачала"));
	Запрос.УстановитьПараметр("ДатаОкончания", СтруктураПараметров.Получить("ДатаОкончания"));
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ДанныеДокумента.Ссылка КАК Документ1,
	|	ДанныеДокумента.Основание КАК Документ2
	|ИЗ
	|	Документ.ВыпускПродукции КАК ДанныеДокумента
	|ГДЕ
	|	НЕ ДанныеДокумента.ПометкаУдаления
	|	И ДанныеДокумента.ВидЗаказа В (ЗНАЧЕНИЕ(Перечисление.ВидыЗаказовНаПроизводство.ПроизводствоПотолка), ЗНАЧЕНИЕ(Перечисление.ВидыЗаказовНаПроизводство.ТиповоеПроизводство))
	|	И ДанныеДокумента.Основание ССЫЛКА Документ.ЗаказНаПроизводство
	|	И НЕ ДанныеДокумента.Основание = ЗНАЧЕНИЕ(Документ.ЗаказНаПроизводство.ПустаяСсылка)
	|	И (ДанныеДокумента.Дата >= &ДатаНачала
	|			ИЛИ &ДатаНачала = ДАТАВРЕМЯ(1, 1, 1))
	|	И (ДанныеДокумента.Дата <= &ДатаОкончания
	|			ИЛИ &ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1))
	|";
	
	ТаблицаЗаказов = Запрос.Выполнить().Выгрузить();
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СтруктураПроверки = ОбщийМодуль.ПроверкаСоответствияПродукцииВыпускаИЗаказаНаПроизводство(Выборка.Документ1, Выборка.Документ2);
		Если НЕ СтруктураПроверки.Результат Тогда
			НоваяСтрока = ТаблицаРезультата.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);	
		КонецЕсли;
	КонецЦикла;
	
	Возврат ТаблицаРезультата;
	
КонецФункции

Функция ВывестиРезультатПроверки_ПроверкаСоответствияПродукцииВыпускаИЗаказаНаПроизводство(ТаблицаРезультата)	
	
	Таб = Новый ТабличныйДокумент;
	Макет = ПолучитьОбщийМакет("МакетЭкспрессПроверкаУчета");
	
	Таб.НачатьАвтогруппировкуСтрок();
	
	ОбластьМакета = Макет.ПолучитьОбласть("Шапка_ВидПроверки");
	ОбластьМакета.Параметры.ВидПроверки = "Данные по продукции документа ""Выпуск продукции"" не сходятся с данными документа ""Заказ на производство""";
	Таб.Вывести(ОбластьМакета, 1);
	
	Если ТаблицаРезультата.Количество() = 0 Тогда
		ОбластьМакета = Макет.ПолучитьОбласть("Шапка_ОшибокНет");
		Таб.Вывести(ОбластьМакета, 1);
	Иначе
		ОбластьМакета = Макет.ПолучитьОбласть("Шапка_ОшибкиЕсть");
		ОбластьМакета.Параметры.КоличествоОшибок = ТаблицаРезультата.Количество();
		Таб.Вывести(ОбластьМакета, 1);
		//ОбластьМакета = Макет.ПолучитьОбласть("Шапка_ОшибкиЕсть_Исправить");
		//ОбластьМакета.Параметры.КоличествоОшибок = ТаблицаРезультата.Количество();
		//ОбластьМакета.Параметры.Исправить = "...";
		//Таб.Вывести(ОбластьМакета, 1);
		
		ОбластьМакета = Макет.ПолучитьОбласть("Шапка_Таблица");
		ОбластьМакета.Параметры.Документ1 = "Выпуск продукции";
		ОбластьМакета.Параметры.Пояснение1 = "";
		ОбластьМакета.Параметры.Документ2 = "Заказ на производство";
		ОбластьМакета.Параметры.Пояснение2 = "";
		Таб.Вывести(ОбластьМакета, 2, "Документ", Ложь);
		
		Ном = 1;
		Для Каждого ТекущаяСтрока Из ТаблицаРезультата Цикл
			ОбластьМакета = Макет.ПолучитьОбласть("Строка_Таблица");
			ЗаполнитьЗначенияСвойств(ОбластьМакета.Параметры, ТекущаяСтрока);
			ОбластьМакета.Параметры.Ном = Ном;
			Таб.Вывести(ОбластьМакета, 2, "Документ", Ложь);
			Ном = Ном + 1;
			
		КонецЦикла;
	КонецЕсли;
	
	Таб.ЗакончитьАвтогруппировкуСтрок();	
	Возврат Таб;
	
КонецФункции

#КонецОбласти

#Область ПроверкаСоответствияУслугВыпускаИЗаказаНаПроизводство	
//(+)
Функция ВыполнитьПроверку_ПроверкаСоответствияУслугВыпускаИЗаказаНаПроизводство(ОбъектыКИсправлению, СтруктураПараметров) Экспорт
	
	РезультатПроверки = ПолучитьТаблицу_ПроверкаСоответствияУслугВыпускаИЗаказаНаПроизводство(ОбъектыКИсправлению, СтруктураПараметров);
	ТабДок = ВывестиРезультатПроверки_ПроверкаСоответствияУслугВыпускаИЗаказаНаПроизводство(РезультатПроверки);
	Возврат ТабДок;
	
КонецФункции

Функция ПолучитьТаблицу_ПроверкаСоответствияУслугВыпускаИЗаказаНаПроизводство(ОбъектыКИсправлению, СтруктураПараметров)
	
	ТаблицаРезультата = Новый ТаблицаЗначений;
	ТаблицаРезультата.Колонки.Добавить("Документ1"); //Выпуск
	ТаблицаРезультата.Колонки.Добавить("Пояснение1"); 
	ТаблицаРезультата.Колонки.Добавить("Документ2"); //Заказ НП
	ТаблицаРезультата.Колонки.Добавить("Пояснение2"); 
	ТаблицаРезультата.Колонки.Добавить("Примечание"); //не используется
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДатаНачала",    СтруктураПараметров.Получить("ДатаНачала"));
	Запрос.УстановитьПараметр("ДатаОкончания", СтруктураПараметров.Получить("ДатаОкончания"));
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ДанныеДокумента.Ссылка КАК Документ1,
	|	ДанныеДокумента.Основание КАК Документ2
	|ИЗ
	|	Документ.ВыпускПродукции КАК ДанныеДокумента
	|ГДЕ
	|	НЕ ДанныеДокумента.ПометкаУдаления
	|	И ДанныеДокумента.ВидЗаказа В (ЗНАЧЕНИЕ(Перечисление.ВидыЗаказовНаПроизводство.ПроизводствоПотолка), ЗНАЧЕНИЕ(Перечисление.ВидыЗаказовНаПроизводство.ТиповоеПроизводство))
	|	И ДанныеДокумента.Основание ССЫЛКА Документ.ЗаказНаПроизводство
	|	И НЕ ДанныеДокумента.Основание = ЗНАЧЕНИЕ(Документ.ЗаказНаПроизводство.ПустаяСсылка)
	|	И (ДанныеДокумента.Дата >= &ДатаНачала
	|			ИЛИ &ДатаНачала = ДАТАВРЕМЯ(1, 1, 1))
	|	И (ДанныеДокумента.Дата <= &ДатаОкончания
	|			ИЛИ &ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1))
	|";
	
	ТаблицаЗаказов = Запрос.Выполнить().Выгрузить();
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СтруктураПроверки = ОбщийМодуль.ПроверкаСоответствияУслугВыпускаИЗаказаНаПроизводство(Выборка.Документ1, Выборка.Документ2);
		Если НЕ СтруктураПроверки.Результат Тогда
			НоваяСтрока = ТаблицаРезультата.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);	
			
			НоваяСтрока = ОбъектыКИсправлению.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
			НоваяСтрока.Исправить = "ОбновитьУслугиВыпускаПоЗаказуНаПроизводство";
			
		КонецЕсли;
	КонецЦикла;
	
	Возврат ТаблицаРезультата;
	
КонецФункции

Функция ВывестиРезультатПроверки_ПроверкаСоответствияУслугВыпускаИЗаказаНаПроизводство(ТаблицаРезультата)	
	
	Таб = Новый ТабличныйДокумент;
	Макет = ПолучитьОбщийМакет("МакетЭкспрессПроверкаУчета");
	
	Таб.НачатьАвтогруппировкуСтрок();
	
	ОбластьМакета = Макет.ПолучитьОбласть("Шапка_ВидПроверки");
	ОбластьМакета.Параметры.ВидПроверки = "Данные по услугам документа ""Выпуск продукции"" не сходятся с данными документа ""Заказ на производство""";
	Таб.Вывести(ОбластьМакета, 1);
	
	Если ТаблицаРезультата.Количество() = 0 Тогда
		ОбластьМакета = Макет.ПолучитьОбласть("Шапка_ОшибокНет");
		Таб.Вывести(ОбластьМакета, 1);
	Иначе
		//ОбластьМакета = Макет.ПолучитьОбласть("Шапка_ОшибкиЕсть");
		//ОбластьМакета.Параметры.КоличествоОшибок = ТаблицаРезультата.Количество();
		//Таб.Вывести(ОбластьМакета, 1);
		ОбластьМакета = Макет.ПолучитьОбласть("Шапка_ОшибкиЕсть_Исправить");
		ОбластьМакета.Параметры.КоличествоОшибок = ТаблицаРезультата.Количество();
		ОбластьМакета.Параметры.Исправить = "ОбновитьУслугиВыпускаПоЗаказуНаПроизводство";
		ОбластьМакета.Параметры.ТекстПоясненияИсправления = "Процедура исправления в документе ""Выпуск продукции"" очищает табличную часть ""Услуги"" и перезаполняет ее по документу-основанию ""Заказ на производство""";
		Таб.Вывести(ОбластьМакета, 1);
		
		ОбластьМакета = Макет.ПолучитьОбласть("Шапка_Таблица");
		ОбластьМакета.Параметры.Документ1 = "Выпуск продукции";
		ОбластьМакета.Параметры.Пояснение1 = "";
		ОбластьМакета.Параметры.Документ2 = "Заказ на производство";
		ОбластьМакета.Параметры.Пояснение2 = "";
		Таб.Вывести(ОбластьМакета, 2, "Документ", Ложь);
		
		Ном = 1;
		Для Каждого ТекущаяСтрока Из ТаблицаРезультата Цикл
			ОбластьМакета = Макет.ПолучитьОбласть("Строка_Таблица");
			ЗаполнитьЗначенияСвойств(ОбластьМакета.Параметры, ТекущаяСтрока);
			ОбластьМакета.Параметры.Ном = Ном;
			Таб.Вывести(ОбластьМакета, 2, "Документ", Ложь);
			Ном = Ном + 1;
			
		КонецЦикла;
	КонецЕсли;
	
	Таб.ЗакончитьАвтогруппировкуСтрок();	
	Возврат Таб;
	
КонецФункции

Функция ИсправитьОбъект_ОбновитьУслугиВыпускаПоЗаказуНаПроизводство(ДокументВыпуска, ДокументЗНП) Экспорт
	
	ОбъектИсправления = ДокументВыпуска.ПолучитьОбъект();
	
	ОбъектИсправления.Услуги.Очистить();
	Для Каждого СтрокаЗаказа Из ДокументЗНП.Услуги Цикл
		СтрокаВыпуска = ОбъектИсправления.Услуги.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаВыпуска, СтрокаЗаказа);
	КонецЦикла;
	
	Попытка
		Если ОбъектИсправления.Проведен Тогда
			ОбъектИсправления.Записать(РежимЗаписиДокумента.Проведение);
		Иначе
			ОбъектИсправления.Записать();
		КонецЕсли;
		Возврат Истина;
	Исключение
		//Сообщить(ОписаниеОшибки());
		Возврат Ложь;
	КонецПопытки;
	
КонецФункции

#КонецОбласти	

#Область ПроверкаЗаказовНаПроизводствоВНедействительныхСтатусах
