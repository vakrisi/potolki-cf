Функция ПолучитьТаблицу_ПроверкаЗаказовНаПроизводствоВНедействительныхСтатусах(СтруктураПараметров)
	
	ТаблицаРезультата = Новый ТаблицаЗначений;
	ТаблицаРезультата.Колонки.Добавить("Документ1");
	ТаблицаРезультата.Колонки.Добавить("Пояснение1");
	ТаблицаРезультата.Колонки.Добавить("Документ2");
	ТаблицаРезультата.Колонки.Добавить("Пояснение2");
	ТаблицаРезультата.Колонки.Добавить("Примечание");
	
	//Первый запрос выводит в статусах, которые теперь не используются
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДатаНачала",    СтруктураПараметров.Получить("ДатаНачала"));
	Запрос.УстановитьПараметр("ДатаОкончания", СтруктураПараметров.Получить("ДатаОкончания"));
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ДанныеДокумента.Ссылка КАК Документ1,
	|	ДанныеДокумента.ТекущийСтатус КАК Пояснение1
	|ИЗ
	|	Документ.ЗаказНаПроизводство КАК ДанныеДокумента
	|ГДЕ
	|	ДанныеДокумента.ТекущийСтатус В (ЗНАЧЕНИЕ(Справочник.СтатусыЗаказовНаПроизводство.Новый), ЗНАЧЕНИЕ(Справочник.СтатусыЗаказовНаПроизводство.Подтвержден), ЗНАЧЕНИЕ(Справочник.СтатусыЗаказовНаПроизводство.Отгружен))
	|	И (ДанныеДокумента.Ссылка.Дата >= &ДатаНачала
	|			ИЛИ &ДатаНачала = ДАТАВРЕМЯ(1, 1, 1))
	|	И (ДанныеДокумента.Ссылка.Дата <= &ДатаОкончания
	|			ИЛИ &ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1))
	|";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = ТаблицаРезультата.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
	КонецЦикла;
	
	//Заказы на производстве в статусе произведен без выпуска
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ДанныеДокумента.Ссылка КАК Документ1,
	|	ДанныеДокумента.ТекущийСтатус КАК Пояснение1
	|ИЗ
	|	Документ.ЗаказНаПроизводство КАК ДанныеДокумента
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ВыпускПродукции КАК ВыпускПродукции
	|		ПО ДанныеДокумента.Ссылка = ВыпускПродукции.Основание
	|ГДЕ
	|	ДанныеДокумента.ТекущийСтатус = ЗНАЧЕНИЕ(Справочник.СтатусыЗаказовНаПроизводство.Произведен)
	|	И ЕСТЬNULL(ВыпускПродукции.Ссылка, ЗНАЧЕНИЕ(Документ.ВыпускПродукции.ПустаяСсылка)) = ЗНАЧЕНИЕ(Документ.ВыпускПродукции.ПустаяСсылка)
	|	И (ДанныеДокумента.Ссылка.Дата >= &ДатаНачала
	|			ИЛИ &ДатаНачала = ДАТАВРЕМЯ(1, 1, 1))
	|	И (ДанныеДокумента.Ссылка.Дата <= &ДатаОкончания
	|			ИЛИ &ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1))";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = ТаблицаРезультата.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		НоваяСтрока.Примечание = "Заказ на производство в статусе ""Произведен"" без выпуска продукции";
	КонецЦикла;	
	
	//Заказы на производстве в статусе произведен с помеченным на удаление выпуском
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ДанныеДокумента.Основание КАК Документ1,
	|	ДанныеДокумента.Основание.ТекущийСтатус КАК Пояснение1,
	|	ДанныеДокумента.Ссылка КАК Документ2		
	|ИЗ
	|	Документ.ВыпускПродукции КАК ДанныеДокумента
	|		
	|ГДЕ		
	|	ДанныеДокумента.Основание ССЫЛКА Документ.ЗаказНаПроизводство
	|	И ДанныеДокумента.Основание <> Значение(Документ.ЗаказНаПроизводство.ПустаяСсылка)
	|	И ДанныеДокумента.Основание.ТекущийСтатус = ЗНАЧЕНИЕ(Справочник.СтатусыЗаказовНаПроизводство.Произведен)
	|	И ДанныеДокумента.ПометкаУдаления
	|	И (ДанныеДокумента.Дата >= &ДатаНачала
	|			ИЛИ &ДатаНачала = ДАТАВРЕМЯ(1, 1, 1))
	|	И (ДанныеДокумента.Дата <= &ДатаОкончания
	|			ИЛИ &ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1))
	|";	
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = ТаблицаРезультата.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		НоваяСтрока.Примечание = "Заказ на производство в статусе ""Произведен"" с помеченным на удаление выпуском продукции";
	КонецЦикла;	
	
	//Заказ на производство в работе, отменен либо помечен на удаление но с выпуском
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ДанныеДокумента.Основание КАК Документ1,
	|	ДанныеДокумента.Основание.ТекущийСтатус КАК Пояснение1,
	|	ДанныеДокумента.Ссылка КАК Документ2,
	|	ВЫБОР
	|		КОГДА ДанныеДокумента.Основание.ПометкаУдаления
	|			ТОГДА ""помечен на удаление.""
	|		КОГДА ДанныеДокумента.Основание.ТекущийСтатус = ЗНАЧЕНИЕ(Справочник.СтатусыЗаказовНаПроизводство.Отменен)
	|			ТОГДА ""находится в статусе 'Отменен'.""
	|		КОГДА ДанныеДокумента.Основание.ТекущийСтатус = ЗНАЧЕНИЕ(Справочник.СтатусыЗаказовНаПроизводство.ВПроизводстве)
	|			ТОГДА ""находится в статусе 'В производстве'.""
	|	КОНЕЦ КАК Пояснение
	|ИЗ
	|	Документ.ВыпускПродукции КАК ДанныеДокумента
	|ГДЕ
	|	ДанныеДокумента.Проведен
	|	И ДанныеДокумента.Основание ССЫЛКА Документ.ЗаказНаПроизводство
	|	И ДанныеДокумента.Основание <> ЗНАЧЕНИЕ(Документ.ЗаказНаПроизводство.ПустаяСсылка)
	|	И (ДанныеДокумента.Основание.ТекущийСтатус = ЗНАЧЕНИЕ(Справочник.СтатусыЗаказовНаПроизводство.ВПроизводстве)
	|			ИЛИ ДанныеДокумента.Основание.ТекущийСтатус = ЗНАЧЕНИЕ(Справочник.СтатусыЗаказовНаПроизводство.Отменен)
	|			ИЛИ ДанныеДокумента.Основание.ПометкаУдаления)
	|	И (ДанныеДокумента.Дата >= &ДатаНачала
	|			ИЛИ &ДатаНачала = ДАТАВРЕМЯ(1, 1, 1))
	|	И (ДанныеДокумента.Дата <= &ДатаОкончания
	|			ИЛИ &ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1))
	|";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = ТаблицаРезультата.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		НоваяСтрока.Примечание = "Проведенный выпуск продукции с основанием заказ на производство, который " + Выборка.Пояснение;
	КонецЦикла;	
	
	Возврат ТаблицаРезультата;
	
КонецФункции

Функция ВывестиРезультатПроверки_ПроверкаЗаказовНаПроизводствоВНедействительныхСтатусах(ТаблицаРезультата)
	
	Таб = Новый ТабличныйДокумент;
	Макет = ПолучитьОбщийМакет("МакетЭкспрессПроверкаУчета");
	
	Таб.НачатьАвтогруппировкуСтрок();
	
	ОбластьМакета = Макет.ПолучитьОбласть("Шапка_ВидПроверки");
	ОбластьМакета.Параметры.ВидПроверки = "Заказы на производство в недействительных статусах";
	Таб.Вывести(ОбластьМакета, 1);
	
	Если ТаблицаРезультата.Количество() = 0 Тогда
		ОбластьМакета = Макет.ПолучитьОбласть("Шапка_ОшибокНет");
		Таб.Вывести(ОбластьМакета, 1);
	Иначе
		ОбластьМакета = Макет.ПолучитьОбласть("Шапка_ОшибкиЕсть");
		ОбластьМакета.Параметры.КоличествоОшибок = ТаблицаРезультата.Количество();
		Таб.Вывести(ОбластьМакета, 1);
		
		ОбластьМакета = Макет.ПолучитьОбласть("Шапка_Таблица");
		ОбластьМакета.Параметры.Документ1 = "Документ";
		ОбластьМакета.Параметры.Пояснение1 = "Статус";
		ОбластьМакета.Параметры.Документ2 = "";
		ОбластьМакета.Параметры.Пояснение2 = "";
		Таб.Вывести(ОбластьМакета, 2, "Документ", Ложь);
		
		Ном = 1;
		Для Каждого ТекущаяСтрока Из ТаблицаРезультата Цикл
			ОбластьМакета = Макет.ПолучитьОбласть("Строка_Таблица");
			ЗаполнитьЗначенияСвойств(ОбластьМакета.Параметры, ТекущаяСтрока);
			ОбластьМакета.Параметры.Ном = Ном;
			Таб.Вывести(ОбластьМакета, 2, "Документ", Ложь);
			Ном = Ном + 1;
			
		КонецЦикла;
	КонецЕсли;
	
	Таб.ЗакончитьАвтогруппировкуСтрок();	
	Возврат Таб;
	
КонецФункции

#КонецОбласти	

#Область ПроверкаСостоянияОтгрузкиПоВыполненнымЗаказамПокупателей
//(+)
Функция ВыполнитьПроверку_ПроверкаСостоянияОтгрузкиПоВыполненнымЗаказамПокупателей(СтруктураПараметров) Экспорт
	
	РезультатПроверки = ПолучитьТаблицу_ПроверкаСостоянияОтгрузкиПоВыполненнымЗаказамПокупателей(СтруктураПараметров);
	ТабДок = ВывестиРезультатПроверки_ПроверкаСостоянияОтгрузкиПоВыполненнымЗаказамПокупателей(РезультатПроверки);
	Возврат ТабДок;
	
КонецФункции

Функция ПолучитьТаблицу_ПроверкаСостоянияОтгрузкиПоВыполненнымЗаказамПокупателей(СтруктураПараметров)
	
	ТаблицаРезультата = Новый ТаблицаЗначений;
	ТаблицаРезультата.Колонки.Добавить("Документ1"); //Ссылка на документ
	ТаблицаРезультата.Колонки.Добавить("Пояснение1"); //Ссылка на документ
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДатаНачала",    СтруктураПараметров.Получить("ДатаНачала"));
	Запрос.УстановитьПараметр("ДатаОкончания", СтруктураПараметров.Получить("ДатаОкончания"));
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ДанныеДокумента.Ссылка КАК Документ1
	|ИЗ
	|	Документ.ЗаказПокупателя ДанныеДокумента
	|ГДЕ
	|	ДанныеДокумента.Проведен
	|	И ДанныеДокумента.ТекущийСтатус = ЗНАЧЕНИЕ(Справочник.СтатусыЗаказовПокупателей.Выполнен)
	|	И (ДанныеДокумента.Дата >= &ДатаНачала
	|			ИЛИ &ДатаНачала = ДАТАВРЕМЯ(1, 1, 1))
	|	И (ДанныеДокумента.Дата <= &ДатаОкончания
	|			ИЛИ &ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1))
	|";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СтруктураВозврата = Документы.ЗаказПокупателя.ВсеТоварыПоЗаказуОтгружены(Выборка.Документ1, Выборка.Документ1.Товары);
		Если НЕ СтруктураВозврата.Результат Тогда		
			НоваяСтрока = ТаблицаРезультата.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
			НоваяСтрока.Пояснение1 = СтруктураВозврата.Описание;
		КонецЕсли;
	КонецЦикла;
	
	Возврат ТаблицаРезультата;
	
КонецФункции

Функция ВывестиРезультатПроверки_ПроверкаСостоянияОтгрузкиПоВыполненнымЗаказамПокупателей(ТаблицаРезультата)
	
	Таб = Новый ТабличныйДокумент;
	Макет = ПолучитьОбщийМакет("МакетЭкспрессПроверкаУчета");
	
	Таб.НачатьАвтогруппировкуСтрок();
	
	ОбластьМакета = Макет.ПолучитьОбласть("Шапка_ВидПроверки");
	ОбластьМакета.Параметры.ВидПроверки = "Состояние отгрузки по выполненным заказам покупателей";
	Таб.Вывести(ОбластьМакета, 1);
	
	Если ТаблицаРезультата.Количество() = 0 Тогда
		ОбластьМакета = Макет.ПолучитьОбласть("Шапка_ОшибокНет");
		Таб.Вывести(ОбластьМакета, 1);
	Иначе
		ОбластьМакета = Макет.ПолучитьОбласть("Шапка_ОшибкиЕсть");
		ОбластьМакета.Параметры.КоличествоОшибок = ТаблицаРезультата.Количество();
		Таб.Вывести(ОбластьМакета, 1);
		
		ОбластьМакета = Макет.ПолучитьОбласть("Шапка_Таблица");
		ОбластьМакета.Параметры.Документ1 = "Документ";
		ОбластьМакета.Параметры.Пояснение1 = "Описание";
		ОбластьМакета.Параметры.Документ2 = "";
		ОбластьМакета.Параметры.Пояснение2 = "";
		Таб.Вывести(ОбластьМакета, 2, "Документ", Ложь);
		
		Ном = 1;
		Для Каждого ТекущаяСтрока Из ТаблицаРезультата Цикл
			ОбластьМакета = Макет.ПолучитьОбласть("Строка_Таблица");
			ЗаполнитьЗначенияСвойств(ОбластьМакета.Параметры, ТекущаяСтрока);
			ОбластьМакета.Параметры.Ном = Ном;
			Таб.Вывести(ОбластьМакета, 2, "Документ", Ложь);
			Ном = Ном + 1;
			
		КонецЦикла;
	КонецЕсли;
	
	Таб.ЗакончитьАвтогруппировкуСтрок();	
	Возврат Таб;
	
КонецФункции

#КонецОбласти

#Область УникальныйПотолокБолееЧемВОдномЗаказеПокупателя
//(+)
Функция ВыполнитьПроверку_УникальныйПотолокБолееЧемВОдномДокументе() Экспорт
	
	РезультатПроверки = ПолучитьТаблицу_УникальныйПотолокБолееЧемВОдномДокументе();
	ТабДок = ВывестиРезультатПроверки_УникальныйПотолокБолееЧемВОдномДокументе(РезультатПроверки);
	Возврат ТабДок;
	
КонецФункции

Функция ПолучитьТаблицу_УникальныйПотолокБолееЧемВОдномДокументе()
	
	ТаблицаРезультата = Новый ТаблицаЗначений;
	ТаблицаРезультата.Колонки.Добавить("Документ1"); //Номенклатура
	ТаблицаРезультата.Колонки.Добавить("Пояснение1"); 
	ТаблицаРезультата.Колонки.Добавить("Документ2"); //Документ (список)
	ТаблицаРезультата.Колонки.Добавить("Пояснение2"); 
	ТаблицаРезультата.Колонки.Добавить("Примечание"); 
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ДанныеДокумента.Номенклатура КАК Номенклатура,
	|	СУММА(1) КАК Количество
	|ПОМЕСТИТЬ ВТ_ПотолкиЗП
	|ИЗ
	|	Документ.ЗаказПокупателя.Товары КАК ДанныеДокумента
	|ГДЕ
	|	ДанныеДокумента.Ссылка.Проведен
	|	И (ДанныеДокумента.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Справочник.ВидыНоменклатуры.Потолок)
	|			ИЛИ ДанныеДокумента.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Справочник.ВидыНоменклатуры.Отрез))
	|	И (ДанныеДокумента.Ссылка.ТекущийСтатус = ЗНАЧЕНИЕ(Справочник.СтатусыЗаказовПокупателей.ВРаботе)
	|			ИЛИ ДанныеДокумента.Ссылка.ТекущийСтатус = ЗНАЧЕНИЕ(Справочник.СтатусыЗаказовПокупателей.Выполнен))
	|
	|СГРУППИРОВАТЬ ПО
	|	ДанныеДокумента.Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВТ_ПотолкиЗП.Номенклатура КАК Номенклатура,
	|	ВТ_ПотолкиЗП.Количество КАК Количество
	|ПОМЕСТИТЬ ВТ_НеУникальныеПотолкиЗП
	|ИЗ
	|	ВТ_ПотолкиЗП КАК ВТ_ПотолкиЗП
	|ГДЕ
	|	ВТ_ПотолкиЗП.Количество > 1
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ДанныеДокумента.ПродукцияНоменклатура КАК Номенклатура,
	|	СУММА(1) КАК Количество
	|ПОМЕСТИТЬ ВТ_ПотолкиЗНП
	|ИЗ
	|	Документ.ЗаказНаПроизводство КАК ДанныеДокумента
	|ГДЕ
	|	ДанныеДокумента.Проведен
	|	И НЕ ДанныеДокумента.ТекущийСтатус = ЗНАЧЕНИЕ(Справочник.СтатусыЗаказовНаПроизводство.Отменен)
	|	И ДанныеДокумента.ВидЗаказа = ЗНАЧЕНИЕ(Перечисление.ВидыЗаказовНаПроизводство.ПроизводствоПотолка)
	|	И НЕ ДанныеДокумента.ПродукцияНоменклатура = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	|	И (ДанныеДокумента.ПродукцияНоменклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Справочник.ВидыНоменклатуры.Потолок)
	|			ИЛИ ДанныеДокумента.ПродукцияНоменклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Справочник.ВидыНоменклатуры.Отрез))
	|
	|СГРУППИРОВАТЬ ПО
	|	ДанныеДокумента.ПродукцияНоменклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВТ_ПотолкиЗНП.Номенклатура КАК Номенклатура,
	|	ВТ_ПотолкиЗНП.Количество КАК Количество
	|ПОМЕСТИТЬ ВТ_НеУникальныеПотолкиЗНП
	|ИЗ
	|	ВТ_ПотолкиЗНП КАК ВТ_ПотолкиЗНП
	|ГДЕ
	|	ВТ_ПотолкиЗНП.Количество > 1
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ДанныеДокумента.ПродукцияНоменклатура КАК Номенклатура,
	|	СУММА(1) КАК Количество
	|ПОМЕСТИТЬ ВТ_ПотолкиВыпуски
	|ИЗ
	|	Документ.ВыпускПродукции КАК ДанныеДокумента
	|ГДЕ
	|	ДанныеДокумента.Проведен
	|	И ДанныеДокумента.ВидЗаказа = ЗНАЧЕНИЕ(Перечисление.ВидыЗаказовНаПроизводство.ПроизводствоПотолка)
	|	И НЕ ДанныеДокумента.ПродукцияНоменклатура = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	|	И (ДанныеДокумента.ПродукцияНоменклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Справочник.ВидыНоменклатуры.Потолок)
	|			ИЛИ ДанныеДокумента.ПродукцияНоменклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Справочник.ВидыНоменклатуры.Отрез))
	|
	|СГРУППИРОВАТЬ ПО
	|	ДанныеДокумента.ПродукцияНоменклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВТ_ПотолкиВыпуски.Номенклатура КАК Номенклатура,
	|	ВТ_ПотолкиВыпуски.Количество КАК Количество
	|ПОМЕСТИТЬ ВТ_НеУникальныеПотолкиВыпуски
	|ИЗ
	|	ВТ_ПотолкиВыпуски КАК ВТ_ПотолкиВыпуски
	|ГДЕ
	|	ВТ_ПотолкиВыпуски.Количество > 1
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВТ_НеУникальныеПотолкиЗП.Номенклатура КАК Номенклатура,
	|	ДанныеДокумента.Ссылка КАК ДокументПотолка,
	|	""Заказ покупателя"" КАК ТипДокумента
	|ПОМЕСТИТЬ ВТ_Итог
	|ИЗ
	|	ВТ_НеУникальныеПотолкиЗП КАК ВТ_НеУникальныеПотолкиЗП
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаказПокупателя.Товары КАК ДанныеДокумента
	|		ПО ВТ_НеУникальныеПотолкиЗП.Номенклатура = ДанныеДокумента.Номенклатура
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВТ_НеУникальныеПотолкиЗНП.Номенклатура,
	|	ДанныеДокумента.Ссылка,
	|	""Заказ на производство""
	|ИЗ
	|	ВТ_НеУникальныеПотолкиЗНП КАК ВТ_НеУникальныеПотолкиЗНП
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаказНаПроизводство КАК ДанныеДокумента
	|		ПО ВТ_НеУникальныеПотолкиЗНП.Номенклатура = ДанныеДокумента.ПродукцияНоменклатура
	|			И (ДанныеДокумента.ВидЗаказа = ЗНАЧЕНИЕ(Перечисление.ВидыЗаказовНаПроизводство.ПроизводствоПотолка))
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВТ_НеУникальныеПотолкиВыпуски.Номенклатура,
	|	ДанныеДокумента.Ссылка,
	|	""Выпуск продукции""
	|ИЗ
	|	ВТ_НеУникальныеПотолкиВыпуски КАК ВТ_НеУникальныеПотолкиВыпуски
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ВыпускПродукции КАК ДанныеДокумента
	|		ПО ВТ_НеУникальныеПотолкиВыпуски.Номенклатура = ДанныеДокумента.ПродукцияНоменклатура
	|			И (ДанныеДокумента.ВидЗаказа = ЗНАЧЕНИЕ(Перечисление.ВидыЗаказовНаПроизводство.ПроизводствоПотолка))
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Итог.Номенклатура КАК Номенклатура,
	|	ВТ_Итог.ДокументПотолка КАК ДокументПотолка,
	|	ВТ_Итог.ТипДокумента КАК ТипДокумента
	|ИЗ
	|	ВТ_Итог КАК ВТ_Итог
	|
	|УПОРЯДОЧИТЬ ПО
	|	ВТ_Итог.Номенклатура,
	|	ТипДокумента
	|ИТОГИ ПО
	|	Номенклатура,
	|	ТипДокумента";
	
	ВыборкаНоменклатуры = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам,"Номенклатура");		
	Пока ВыборкаНоменклатуры.Следующий() Цикл
		НоваяСтрока = ТаблицаРезультата.Добавить();
		НоваяСтрока.Документ1 = ВыборкаНоменклатуры.Номенклатура;
		
		ВыборкаТиповДокументов = ВыборкаНоменклатуры.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам, "ТипДокумента");
		ЭтоПервыйТип = Истина;
		Пока ВыборкаТиповДокументов.Следующий() Цикл
			СписокДокументовВРасшифровку = Новый СписокЗначений;
			
			Выборка = ВыборкаТиповДокументов.Выбрать();
			Пока Выборка.Следующий() Цикл
				СписокДокументовВРасшифровку.Добавить(Выборка.ДокументПотолка);
			КонецЦикла;
			
			Если ЭтоПервыйТип Тогда
				НоваяСтрока.Документ2 = СписокДокументовВРасшифровку;
				ЭтоПервыйТип = Ложь;
			Иначе
				НоваяСтрока = ТаблицаРезультата.Добавить();
				НоваяСтрока.Документ2 = СписокДокументовВРасшифровку;
			КонецЕсли;
			
		КонецЦикла;
	КонецЦикла;
	
	Возврат ТаблицаРезультата;
	
КонецФункции

Функция ВывестиРезультатПроверки_УникальныйПотолокБолееЧемВОдномДокументе(ТаблицаРезультата)
	
	Таб = Новый ТабличныйДокумент;
	Макет = ПолучитьОбщийМакет("МакетЭкспрессПроверкаУчета");
	
	Таб.НачатьАвтогруппировкуСтрок();
	
	ОбластьМакета = Макет.ПолучитьОбласть("Шапка_ВидПроверки");
	ОбластьМакета.Параметры.ВидПроверки = "Уникальный потолок более чем в одном документе.";
	Таб.Вывести(ОбластьМакета, 1);
	
	Если ТаблицаРезультата.Количество() = 0 Тогда
		ОбластьМакета = Макет.ПолучитьОбласть("Шапка_ОшибокНет");
		Таб.Вывести(ОбластьМакета, 1);
	Иначе
		ОбластьМакета = Макет.ПолучитьОбласть("Шапка_ОшибкиЕсть");
		ОбластьМакета.Параметры.КоличествоОшибок = ТаблицаРезультата.Количество();
		Таб.Вывести(ОбластьМакета, 1);
		
		ОбластьМакета = Макет.ПолучитьОбласть("Шапка_Таблица");
		ОбластьМакета.Параметры.Документ1 = "Потолок/отрез";
		ОбластьМакета.Параметры.Пояснение1 = "";
		ОбластьМакета.Параметры.Документ2 = "Документ";
		ОбластьМакета.Параметры.Пояснение2 = "";
		Таб.Вывести(ОбластьМакета, 2, "Документ", Ложь);
		
		Ном = 1;
		Для Каждого ТекущаяСтрока Из ТаблицаРезультата Цикл
			ОбластьМакета = Макет.ПолучитьОбласть("Строка_Таблица");
			ЗаполнитьЗначенияСвойств(ОбластьМакета.Параметры, ТекущаяСтрока);
			ОбластьМакета.Параметры.Ном = Ном;
			Таб.Вывести(ОбластьМакета, 2, "Документ", Ложь);
			Ном = Ном + 1;
			
		КонецЦикла;
	КонецЕсли;
	
	Таб.ЗакончитьАвтогруппировкуСтрок();	
	Возврат Таб;
	
КонецФункции

#КонецОбласти

#Область ПроверкаЗаказыНаПроизводствоВРеализации
//(+)
Функция ВыполнитьПроверку_ЗаказыНаПроизводствоВРеализации(СтруктураПараметров) Экспорт
	
	РезультатПроверки = ПолучитьТаблицу_ЗаказыНаПроизводствоВРеализации(СтруктураПараметров);
	ТабДок = ВывестиРезультатПроверки_ЗаказыНаПроизводствоВРеализациие(РезультатПроверки);
	Возврат ТабДок;
	
КонецФункции

Функция ПолучитьТаблицу_ЗаказыНаПроизводствоВРеализации(СтруктураПараметров)
	
	ТаблицаРезультата = Новый ТаблицаЗначений;
	ТаблицаРезультата.Колонки.Добавить("Документ1"); //Документ
	ТаблицаРезультата.Колонки.Добавить("Пояснение1"); 
	ТаблицаРезультата.Колонки.Добавить("Документ2"); 
	ТаблицаРезультата.Колонки.Добавить("Пояснение2"); 
	ТаблицаРезультата.Колонки.Добавить("Примечание"); 
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДатаНачала",    СтруктураПараметров.Получить("ДатаНачала"));
	Запрос.УстановитьПараметр("ДатаОкончания", СтруктураПараметров.Получить("ДатаОкончания"));
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ДанныеДокумента.Ссылка КАК Документ1,
	|	""в товарах"" КАК Примечание
	|ПОМЕСТИТЬ ВТ_Временная
	|ИЗ
	|	Документ.РеализацияТоваровИУслуг.Товары КАК ДанныеДокумента
	|ГДЕ
	|	ДанныеДокумента.Заказ ССЫЛКА Документ.ЗаказНаПроизводство
	|	И НЕ ДанныеДокумента.Заказ = ЗНАЧЕНИЕ(Документ.ЗаказНаПроизводство.ПустаяСсылка)
	|	И (ДанныеДокумента.Ссылка.Дата >= &ДатаНачала
	|			ИЛИ &ДатаНачала = ДАТАВРЕМЯ(1, 1, 1))
	|	И (ДанныеДокумента.Ссылка.Дата <= &ДатаОкончания
	|			ИЛИ &ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1))
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ДанныеДокумента.Ссылка,
	|	""в услугах""
	|ИЗ
	|	Документ.РеализацияТоваровИУслуг.Услуги КАК ДанныеДокумента
	|ГДЕ
	|	ДанныеДокумента.Заказ ССЫЛКА Документ.ЗаказНаПроизводство
	|	И НЕ ДанныеДокумента.Заказ = ЗНАЧЕНИЕ(Документ.ЗаказНаПроизводство.ПустаяСсылка)
	|	И (ДанныеДокумента.Ссылка.Дата >= &ДатаНачала
	|			ИЛИ &ДатаНачала = ДАТАВРЕМЯ(1, 1, 1))
	|	И (ДанныеДокумента.Ссылка.Дата <= &ДатаОкончания
	|			ИЛИ &ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1))
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ДанныеДокумента.Ссылка,
	|	""в основаниях""
	|ИЗ
	|	Документ.РеализацияТоваровИУслуг.Основания КАК ДанныеДокумента
	|ГДЕ
	|	ДанныеДокумента.Основание ССЫЛКА Документ.ЗаказНаПроизводство
	|	И НЕ ДанныеДокумента.Основание = ЗНАЧЕНИЕ(Документ.ЗаказНаПроизводство.ПустаяСсылка)
	|	И (ДанныеДокумента.Ссылка.Дата >= &ДатаНачала
	|			ИЛИ &ДатаНачала = ДАТАВРЕМЯ(1, 1, 1))
	|	И (ДанныеДокумента.Ссылка.Дата <= &ДатаОкончания
	|			ИЛИ &ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1))
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ДанныеДокумента.Ссылка,
	|	""в основании""
	|ИЗ
	|	Документ.РеализацияТоваровИУслуг КАК ДанныеДокумента
	|ГДЕ
	|	ДанныеДокумента.Основание ССЫЛКА Документ.ЗаказНаПроизводство
	|	И НЕ ДанныеДокумента.Основание = ЗНАЧЕНИЕ(Документ.ЗаказНаПроизводство.ПустаяСсылка)
	|	И (ДанныеДокумента.Дата >= &ДатаНачала
	|			ИЛИ &ДатаНачала = ДАТАВРЕМЯ(1, 1, 1))
	|	И (ДанныеДокумента.Дата <= &ДатаОкончания
	|			ИЛИ &ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1))
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВТ_Временная.Документ1 КАК Документ1,
	|	ВТ_Временная.Примечание КАК Примечание
	|ИЗ
	|	ВТ_Временная КАК ВТ_Временная
	|
	|УПОРЯДОЧИТЬ ПО
	|	ВТ_Временная.Документ1.Дата
	|ИТОГИ ПО
	|	Документ1";
	
	ВыборкаПоДокументам = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам, "Документ1");
	
	Пока ВыборкаПоДокументам.Следующий() Цикл
		НоваяСтрока = ТаблицаРезультата.Добавить();
		НоваяСтрока.Документ1 = ВыборкаПоДокументам.Документ1;
		
		Примечание = "";
		
		Выборка = ВыборкаПоДокументам.Выбрать();
		Пока Выборка.Следующий() Цикл
			Примечание = Примечание + ?(ПустаяСтрока(Примечание), "", "; ") + Выборка.Примечание;
		КонецЦикла;
		
		НоваяСтрока.Примечание = Примечание;		
	КонецЦикла;
	
	Возврат ТаблицаРезультата;
	
КонецФункции

Функция ВывестиРезультатПроверки_ЗаказыНаПроизводствоВРеализациие(ТаблицаРезультата)
	
	Таб = Новый ТабличныйДокумент;
	Макет = ПолучитьОбщийМакет("МакетЭкспрессПроверкаУчета");
	
	Таб.НачатьАвтогруппировкуСтрок();
	
	ОбластьМакета = Макет.ПолучитьОбласть("Шапка_ВидПроверки");
	ОбластьМакета.Параметры.ВидПроверки = "Ссылки на заказ на производство в реквизитах и таблицах реализаций.";
	Таб.Вывести(ОбластьМакета, 1);
	
	Если ТаблицаРезультата.Количество() = 0 Тогда
		ОбластьМакета = Макет.ПолучитьОбласть("Шапка_ОшибокНет");
		Таб.Вывести(ОбластьМакета, 1);
	Иначе
		ОбластьМакета = Макет.ПолучитьОбласть("Шапка_ОшибкиЕсть");
		ОбластьМакета.Параметры.КоличествоОшибок = ТаблицаРезультата.Количество();
		Таб.Вывести(ОбластьМакета, 1);
		
		ОбластьМакета = Макет.ПолучитьОбласть("Шапка_Таблица");
		ОбластьМакета.Параметры.Документ1 = "Документ";
		ОбластьМакета.Параметры.Пояснение1 = "";
		ОбластьМакета.Параметры.Документ2 = "";
		ОбластьМакета.Параметры.Пояснение2 = "";
		Таб.Вывести(ОбластьМакета, 2, "Документ", Ложь);
		
		Ном = 1;
		Для Каждого ТекущаяСтрока Из ТаблицаРезультата Цикл
			ОбластьМакета = Макет.ПолучитьОбласть("Строка_Таблица");
			ЗаполнитьЗначенияСвойств(ОбластьМакета.Параметры, ТекущаяСтрока);
			ОбластьМакета.Параметры.Ном = Ном;
			Таб.Вывести(ОбластьМакета, 2, "Документ", Ложь);
			Ном = Ном + 1;
			
		КонецЦикла;
	КонецЕсли;
	
	Таб.ЗакончитьАвтогруппировкуСтрок();	
	Возврат Таб;
	
КонецФункции

#КонецОбласти

#Область ПроверкаЗаполнениеЗаказовВТабличныхЧастяхРеализаций
//(+)
Функция ВыполнитьПроверку_ЗаполнениеЗаказовВТабличныхЧастяхРеализаций(ОбъектыКИсправлению, СтруктураПараметров) Экспорт
	
	РезультатПроверки = ПолучитьТаблицу_ЗаполнениеЗаказовВТабличныхЧастяхРеализаций(ОбъектыКИсправлению, СтруктураПараметров);
	ТабДок = ВывестиРезультатПроверки_ЗаполнениеЗаказовВТабличныхЧастяхРеализаций(РезультатПроверки);
	Возврат ТабДок;
	
КонецФункции

Функция ПолучитьТаблицу_ЗаполнениеЗаказовВТабличныхЧастяхРеализаций(ОбъектыКИсправлению, СтруктураПараметров)
	
	ТаблицаРезультата = Новый ТаблицаЗначений;
	ТаблицаРезультата.Колонки.Добавить("Документ1"); //Документ
	ТаблицаРезультата.Колонки.Добавить("Пояснение1"); 
	ТаблицаРезультата.Колонки.Добавить("Документ2"); 
	ТаблицаРезультата.Колонки.Добавить("Пояснение2"); 
	ТаблицаРезультата.Колонки.Добавить("Примечание"); 
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДатаНачала",    СтруктураПараметров.Получить("ДатаНачала"));
	Запрос.УстановитьПараметр("ДатаОкончания", СтруктураПараметров.Получить("ДатаОкончания"));
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ДанныеДокумента.Ссылка КАК Ссылка,
	|	ДанныеДокумента.Заказ	
	|	
	|ПОМЕСТИТЬ ВТ_ТЧ
	|	
	|ИЗ
	|	Документ.РеализацияТоваровИУслуг.Товары КАК ДанныеДокумента	
	|	
	|ГДЕ
	|	ДанныеДокумента.Ссылка.Проведен
	|	И (ДанныеДокумента.Ссылка.Дата >= &ДатаНачала
	|			ИЛИ &ДатаНачала = ДАТАВРЕМЯ(1, 1, 1))
	|	И (ДанныеДокумента.Ссылка.Дата <= &ДатаОкончания
	|			ИЛИ &ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1))
	|	
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ДанныеДокумента.Ссылка КАК Ссылка,
	|	ДанныеДокумента.Заказ	
	|	
	|ИЗ
	|	Документ.РеализацияТоваровИУслуг.Услуги КАК ДанныеДокумента	
	|	
	|ГДЕ
	|	ДанныеДокумента.Ссылка.Проведен
	|	И (ДанныеДокумента.Ссылка.Дата >= &ДатаНачала
	|			ИЛИ &ДатаНачала = ДАТАВРЕМЯ(1, 1, 1))
	|	И (ДанныеДокумента.Ссылка.Дата <= &ДатаОкончания
	|			ИЛИ &ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1))
	|	
	|;	
	|//////////////////////////////
	|
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	РеализацияТоваров.Ссылка КАК Ссылка,	
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ РеализацияТоваров.Заказ) КАК КоличествоРазличные
	|	
	|ПОМЕСТИТЬ ВТ
	|	
	|ИЗ
	|	ВТ_ТЧ КАК РеализацияТоваров	
	|	
	|СГРУППИРОВАТЬ ПО
	|
	|	РеализацияТоваров.Ссылка	
	|	
	|;	
	|//////////////////////////////	
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	РеализацияТоваров.Ссылка,	
	|	РеализацияТоваров.КоличествоРазличные
	|ИЗ
	|	ВТ КАК РеализацияТоваров
	|ГДЕ
	|	РеализацияТоваров.КоличествоРазличные > 1";
	
	//В эту выборку попадут реализации, по которым указаны разные значения в колонке "Заказ", учитываются обе табличные части.
	//Причём "Неопределено" также считается другим значением
	//НО! сюда попадут реализации к примеру если просто указаны разные ЗП или ЗНП, или к примеру в одном Неопределено, в другом пустая ссылка
	//Поэтому они будут обработаны в цикле с перебором табличных частей
	Выборка = Запрос.Выполнить().Выбрать();	
	
	Пока Выборка.Следующий() Цикл
		
		ЕстьРазличия = Ложь;
		БылТип = Неопределено;
		БылоЗначение = Неопределено;
		ВсеЗначенияПустыеИлиНеопределено = Истина;
		Сч = 0;
		
		ЗапросТЧ = новый Запрос;
		ЗапросТЧ.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ		
		|	РеализацияТоваровИУслугТовары.Заказ	
		|	
		|ИЗ
		|	Документ.РеализацияТоваровИУслуг.Товары КАК РеализацияТоваровИУслугТовары	
		|	
		|ГДЕ
		|	РеализацияТоваровИУслугТовары.Ссылка = &Ссылка
		|	
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ		
		|	РеализацияТоваровИУслугУслуги.Заказ	
		|	
		|ИЗ
		|	Документ.РеализацияТоваровИУслуг.Услуги КАК РеализацияТоваровИУслугУслуги	
		|	
		|ГДЕ
		|	РеализацияТоваровИУслугУслуги.Ссылка = &Ссылка";
		ЗапросТЧ.УстановитьПараметр("Ссылка", Выборка.Ссылка);
		
		//Выбираем все различные значения из табличных частей текущей реализации
		ВыборкаТЧ = ЗапросТЧ.Выполнить().Выбрать();
		
		Пока ВыборкаТЧ.Следующий() Цикл
			
			//первое значение мы не обрабатываем, т.к. не с чем сравнивать
			//логика сравнения: если текущий тип не равен предыдущему либо в одном заполнено значение в другом нет - значить нужно вывести как ошибку
			Если Сч > 0 Тогда
				Если (ТипЗнч(ВыборкаТЧ.Заказ) <> БылТип) 
					ИЛИ (ЗначениеЗаполнено(ВыборкаТЧ.Заказ) И Не ЗначениеЗаполнено(БылоЗначение))
					ИЛИ (НЕ ЗначениеЗаполнено(ВыборкаТЧ.Заказ) И ЗначениеЗаполнено(БылоЗначение))
					Тогда
					ЕстьРазличия = Истина;
				КонецЕсли;
			КонецЕсли;
			
			Сч = Сч + 1;
			БылТип = ТипЗнч(ВыборкаТЧ.Заказ);
			БылоЗначение = ВыборкаТЧ.Заказ;
			
			//Исключаем что попался РТиУ где Неопределено или не заполнено, такие РТиУ не нужно выводить как ошибку
			Если НЕ ТипЗнч(ВыборкаТЧ.Заказ) = Тип("Неопределено")
				И ЗначениеЗаполнено(ВыборкаТЧ.Заказ) Тогда
				ВсеЗначенияПустыеИлиНеопределено = Ложь;
			КонецЕсли;
			
		КонецЦикла;
		
		Если ЕстьРазличия И Не ВсеЗначенияПустыеИлиНеопределено Тогда
			НоваяСтрока = ТаблицаРезультата.Добавить();
			НоваяСтрока.Документ1 = Выборка.Ссылка;
			
			НоваяСтрока = ОбъектыКИсправлению.Добавить();
			НоваяСтрока.Документ1 = Выборка.Ссылка;
			НоваяСтрока.Исправить = "ЗаполнитьЗначениеЗаказаВТабличныхЧастяхРеализации";
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ТаблицаРезультата;
	
КонецФункции

Функция ВывестиРезультатПроверки_ЗаполнениеЗаказовВТабличныхЧастяхРеализаций(ТаблицаРезультата)	
	
	Таб = Новый ТабличныйДокумент;
	Макет = ПолучитьОбщийМакет("МакетЭкспрессПроверкаУчета");
	
	Таб.НачатьАвтогруппировкуСтрок();
	
	ОбластьМакета = Макет.ПолучитьОбласть("Шапка_ВидПроверки");
	ОбластьМакета.Параметры.ВидПроверки = "Заполнение заказов в табличных частях реализаций.";
	Таб.Вывести(ОбластьМакета, 1);
	
	Если ТаблицаРезультата.Количество() = 0 Тогда
		ОбластьМакета = Макет.ПолучитьОбласть("Шапка_ОшибокНет");
		Таб.Вывести(ОбластьМакета, 1);
	Иначе
		ОбластьМакета = Макет.ПолучитьОбласть("Шапка_ОшибкиЕсть_Исправить");
		ОбластьМакета.Параметры.КоличествоОшибок = ТаблицаРезультата.Количество();
		ОбластьМакета.Параметры.Исправить = "ЗаполнитьЗначениеЗаказаВТабличныхЧастяхРеализации";
		ОбластьМакета.Параметры.ТекстПоясненияИсправления = "Процедура исправления заполняет значения ""Заказ"" в табличных частях ""Товары"" и ""Услуги"" документа ""Реализация товаров и услуг""";
		Таб.Вывести(ОбластьМакета, 1);
		
		ОбластьМакета = Макет.ПолучитьОбласть("Шапка_Таблица");
		ОбластьМакета.Параметры.Документ1 = "Документ";
		ОбластьМакета.Параметры.Пояснение1 = "";
		ОбластьМакета.Параметры.Документ2 = "";
		ОбластьМакета.Параметры.Пояснение2 = "";
		Таб.Вывести(ОбластьМакета, 2, "Документ", Ложь);
		
		Ном = 1;
		Для Каждого ТекущаяСтрока Из ТаблицаРезультата Цикл
			ОбластьМакета = Макет.ПолучитьОбласть("Строка_Таблица");
			ЗаполнитьЗначенияСвойств(ОбластьМакета.Параметры, ТекущаяСтрока);
			ОбластьМакета.Параметры.Ном = Ном;
			Таб.Вывести(ОбластьМакета, 2, "Документ", Ложь);
			Ном = Ном + 1;
			
		КонецЦикла;
	КонецЕсли;
	
	Таб.ЗакончитьАвтогруппировкуСтрок();	
	Возврат Таб;
	
КонецФункции

Функция ИсправитьОбъект_ЗаполнитьЗначениеЗаказаВТабличныхЧастяхРеализации(ДокументРеализация) Экспорт
	
	ОбъектИсправления = ДокументРеализация.ПолучитьОбъект();
	
	ЕстьРазличия = Ложь; 
	
	//сверяем сумму заказа и сумма реализации, относящуюся к данному заказу (явно указан заказ или пустой заказ в ТЧ)
	СуммаЗаказа = 0;
	СуммаРеализации = 0;
	Если ТипЗнч(ОбъектИсправления.Основание) = Тип("ДокументСсылка.ЗаказПокупателя") Тогда
		СуммаЗаказа = ОбъектИсправления.Основание.СуммаДокумента; 
		
		Для Каждого ТекСтрока Из ОбъектИсправления.Товары Цикл
			Если ТекСтрока.Заказ = ОбъектИсправления.Основание
				или ТекСтрока.Заказ = Неопределено
				или ТекСтрока.Заказ = Документы.ЗаказПокупателя.ПустаяСсылка() Тогда
				СуммаРеализации = СуммаРеализации + ТекСтрока.Сумма;
			КонецЕсли;
		КонецЦикла;
		
		Для Каждого ТекСтрока Из ОбъектИсправления.Услуги Цикл
			Если ТекСтрока.Заказ = ОбъектИсправления.Основание
				или ТекСтрока.Заказ = Неопределено
				или ТекСтрока.Заказ = Документы.ЗаказПокупателя.ПустаяСсылка() Тогда
				СуммаРеализации = СуммаРеализации + ТекСтрока.Сумма;
			КонецЕсли;
		КонецЦикла;
		Если НЕ СуммаЗаказа = СуммаРеализации Тогда
			ЕстьРазличия = Истина;
			Возврат Ложь;
		КонецЕсли;
		
		//проверяем на полное соответствие по ТЧ "Товары" и "Услуги"
		
		
		ТаблицаРеализации = ОбъектИсправления.Товары.Выгрузить();
		ТаблицаРеализации.Очистить();
		Для Каждого ТекСтрока Из ОбъектИсправления.Товары Цикл
			Если ТекСтрока.Заказ = ОбъектИсправления.Основание
				или ТекСтрока.Заказ = Неопределено
				или ТекСтрока.Заказ = Документы.ЗаказПокупателя.ПустаяСсылка() Тогда
				НоваяСтрока = ТаблицаРеализации.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
			КонецЕсли;
		КонецЦикла;
		Для Каждого ТекСтрока Из ОбъектИсправления.Услуги Цикл
			Если ТекСтрока.Заказ = ОбъектИсправления.Основание
				или ТекСтрока.Заказ = Неопределено
				или ТекСтрока.Заказ = Документы.ЗаказПокупателя.ПустаяСсылка() Тогда
				НоваяСтрока = ТаблицаРеализации.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
			КонецЕсли;
		КонецЦикла;
		
		ТаблицаЗаказа = ОбъектИсправления.Основание.Товары.Выгрузить();
		
		ТаблицаРеализации.Свернуть("Номенклатура, ХарактеристикаНоменклатуры, СерияНоменклатуры, ЕдиницаИзмерения, Цена","Количество, Сумма");
		ТаблицаЗаказа.Свернуть("Номенклатура, ХарактеристикаНоменклатуры, СерияНоменклатуры, ЕдиницаИзмерения, Цена","Количество, Сумма");
		
		ТаблицаРеализации.Колонки.Добавить("Учтен", Новый ОписаниеТипов("Булево"));
		ТаблицаЗаказа.Колонки.Добавить("Учтен", Новый ОписаниеТипов("Булево"));
		
		//ищем строки РТиУ в заказе
		Для Каждого ТекСтрока Из ТаблицаРеализации Цикл
			Если НЕ ТекСтрока.Учтен Тогда
				Отбор = Новый Структура;
				Отбор.Вставить("Номенклатура",ТекСтрока.Номенклатура);
				Отбор.Вставить("ХарактеристикаНоменклатуры",ТекСтрока.ХарактеристикаНоменклатуры);
				Отбор.Вставить("СерияНоменклатуры",ТекСтрока.СерияНоменклатуры);
				Отбор.Вставить("ЕдиницаИзмерения",ТекСтрока.ЕдиницаИзмерения);
				Отбор.Вставить("Цена",ТекСтрока.Цена);
				Отбор.Вставить("Количество",ТекСтрока.Количество);
				Отбор.Вставить("Сумма",ТекСтрока.Сумма);
				Отбор.Вставить("Учтен",Ложь);
				НайденныеСтроки = ТаблицаЗаказа.НайтиСтроки(Отбор);
				Если НайденныеСтроки.Количество() > 0 Тогда
					ТекСтрока.Учтен = Истина;
					НайденныеСтроки[0].Учтен = Истина;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		
		//ищем строки заказа в РТиУ
		Для Каждого ТекСтрока Из ТаблицаЗаказа Цикл
			Если НЕ ТекСтрока.Учтен Тогда
				Отбор = Новый Структура;
				Отбор.Вставить("Номенклатура",ТекСтрока.Номенклатура);
				Отбор.Вставить("ХарактеристикаНоменклатуры",ТекСтрока.ХарактеристикаНоменклатуры);
				Отбор.Вставить("СерияНоменклатуры",ТекСтрока.СерияНоменклатуры);
				Отбор.Вставить("ЕдиницаИзмерения",ТекСтрока.ЕдиницаИзмерения);
				Отбор.Вставить("Цена",ТекСтрока.Цена);
				Отбор.Вставить("Количество",ТекСтрока.Количество);
				Отбор.Вставить("Сумма",ТекСтрока.Сумма);
				Отбор.Вставить("Учтен",Ложь);
				НайденныеСтроки = ТаблицаРеализации.НайтиСтроки(Отбор);
				Если НайденныеСтроки.Количество() > 0 Тогда
					ТекСтрока.Учтен = Истина;
					НайденныеСтроки[0].Учтен = Истина;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		
		//проверяем наличие неучтенных строк
		Для Каждого ТекСтрока Из ТаблицаРеализации Цикл
			Если НЕ ТекСтрока.Учтен Тогда
				ЕстьРазличия = Истина;
				Возврат Ложь;
			КонецЕсли;
		КонецЦикла;
		Для Каждого ТекСтрока Из ТаблицаЗаказа Цикл
			Если НЕ ТекСтрока.Учтен Тогда
				ЕстьРазличия = Истина;
				Возврат Ложь;
			КонецЕсли;
		КонецЦикла;
		
		//заполняем заказ
		Если НЕ ЕстьРазличия Тогда
			Для Каждого ТекСтрока Из ОбъектИсправления.Товары Цикл
				Если ТекСтрока.Заказ = Неопределено
					или ТекСтрока.Заказ = Документы.ЗаказПокупателя.ПустаяСсылка() Тогда
					ТекСтрока.Заказ = ОбъектИсправления.Основание;
				КонецЕсли;
			КонецЦикла;
			Для Каждого ТекСтрока Из ОбъектИсправления.Услуги Цикл
				Если ТекСтрока.Заказ = Неопределено
					или ТекСтрока.Заказ = Документы.ЗаказПокупателя.ПустаяСсылка() Тогда
					ТекСтрока.Заказ = ОбъектИсправления.Основание;
				КонецЕсли;
			КонецЦикла;
			
		КонецЕсли;
		
		Попытка
			Если ОбъектИсправления.Проведен Тогда
				ОбъектИсправления.Записать(РежимЗаписиДокумента.Проведение);
			Иначе
				ОбъектИсправления.Записать();
			КонецЕсли;
			Возврат Истина;
		Исключение
			//Сообщить(ОписаниеОшибки());
			Возврат Ложь;
		КонецПопытки;
		
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

#КонецОбласти

#Область ПроверкаНомерРасчетаВДокументеНеСоответствуетНомеруРасчетаВыпускаемойПРодукции
//(+)
Функция ВыполнитьПроверку_НомерРасчетаВДокументеНеСоответствуетНомеруРасчетаВыпускаемойПродукции(СтруктураПараметров) Экспорт
	
	РезультатПроверки = ПолучитьТаблицу_НомерРасчетаВДокументеНеСоответствуетНомеруРасчетаВыпускаемойПродукции(СтруктураПараметров);
	ТабДок = ВывестиРезультатПроверки_НомерРасчетаВДокументеНеСоответствуетНомеруРасчетаВыпускаемойПродукции(РезультатПроверки);
	Возврат ТабДок;
	
КонецФункции

Функция ПолучитьТаблицу_НомерРасчетаВДокументеНеСоответствуетНомеруРасчетаВыпускаемойПродукции(СтруктураПараметров)
	
	ТаблицаРезультата = Новый ТаблицаЗначений;
	ТаблицаРезультата.Колонки.Добавить("Документ1"); //Документ
	ТаблицаРезультата.Колонки.Добавить("Пояснение1"); //Номер расчета в документе 
	ТаблицаРезультата.Колонки.Добавить("Документ2"); 
	ТаблицаРезультата.Колонки.Добавить("Пояснение2"); //Номер расчета в выпускаемой продукции 
	ТаблицаРезультата.Колонки.Добавить("Примечание"); 
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДатаНачала",    СтруктураПараметров.Получить("ДатаНачала"));
	Запрос.УстановитьПараметр("ДатаОкончания", СтруктураПараметров.Получить("ДатаОкончания"));
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ДанныеДокумента.Ссылка КАК Документ1,
	|	ДанныеДокумента.ПродукцияНомерРасчета КАК Пояснение1,
	|	ВЫБОР
	|		КОГДА ДанныеДокумента.ПродукцияНоменклатура.Потолок_ИндексПотолка = """"
	|			ТОГДА ДанныеДокумента.ПродукцияНоменклатура.Потолок_НомерРасчета
	|		ИНАЧЕ ДанныеДокумента.ПродукцияНоменклатура.Потолок_ИндексПотолка + ""-"" + ДанныеДокумента.ПродукцияНоменклатура.Потолок_НомерРасчета
	|	КОНЕЦ КАК Пояснение2
	|ПОМЕСТИТЬ ВТ_ДокументыСНомерамиРасчетов
	|ИЗ
	|	Документ.ЗаказНаПроизводство КАК ДанныеДокумента
	|ГДЕ
	|	ДанныеДокумента.ВидЗаказа = ЗНАЧЕНИЕ(Перечисление.ВидыЗаказовНаПроизводство.ПроизводствоПотолка)
	|	И (ДанныеДокумента.Дата >= &ДатаНачала
	|			ИЛИ &ДатаНачала = ДАТАВРЕМЯ(1, 1, 1))
	|	И (ДанныеДокумента.Дата <= &ДатаОкончания
	|			ИЛИ &ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1))
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ДанныеДокумента.Ссылка,
	|	ДанныеДокумента.ПродукцияНомерРасчета,
	|	ВЫБОР
	|		КОГДА ДанныеДокумента.ПродукцияНоменклатура.Потолок_ИндексПотолка = """"
	|			ТОГДА ДанныеДокумента.ПродукцияНоменклатура.Потолок_НомерРасчета
	|		ИНАЧЕ ДанныеДокумента.ПродукцияНоменклатура.Потолок_ИндексПотолка + ""-"" + ДанныеДокумента.ПродукцияНоменклатура.Потолок_НомерРасчета
	|	КОНЕЦ
	|ИЗ
	|	Документ.ВыпускПродукции КАК ДанныеДокумента
	|ГДЕ
	|	ДанныеДокумента.ВидЗаказа = ЗНАЧЕНИЕ(Перечисление.ВидыЗаказовНаПроизводство.ПроизводствоПотолка)
	|	И (ДанныеДокумента.Дата >= &ДатаНачала
	|			ИЛИ &ДатаНачала = ДАТАВРЕМЯ(1, 1, 1))
	|	И (ДанныеДокумента.Дата <= &ДатаОкончания
	|			ИЛИ &ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1))
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ДокументыСНомерамиРасчетов.Документ1 КАК Документ1,
	|	ДокументыСНомерамиРасчетов.Пояснение1 КАК Пояснение1,
	|	ДокументыСНомерамиРасчетов.Пояснение2 КАК Пояснение2
	|ИЗ
	|	ВТ_ДокументыСНомерамиРасчетов КАК ДокументыСНомерамиРасчетов
	|ГДЕ
	|	ДокументыСНомерамиРасчетов.Пояснение1 <> ДокументыСНомерамиРасчетов.Пояснение2";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = ТаблицаРезультата.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
	КонецЦикла;
	
	Возврат ТаблицаРезультата;
	
КонецФункции

Функция ВывестиРезультатПроверки_НомерРасчетаВДокументеНеСоответствуетНомеруРасчетаВыпускаемойПРодукции(ТаблицаРезультата)	
	
	Таб = Новый ТабличныйДокумент;
	Макет = ПолучитьОбщийМакет("МакетЭкспрессПроверкаУчета");
	
	Таб.НачатьАвтогруппировкуСтрок();
	
	ОбластьМакета = Макет.ПолучитьОбласть("Шапка_ВидПроверки");
	ОбластьМакета.Параметры.ВидПроверки = "Номер расчета в документе не соответствует номеру расчета выпускаемой продукции (Для вида ""Производство потолока"").";
	Таб.Вывести(ОбластьМакета, 1);
	
	Если ТаблицаРезультата.Количество() = 0 Тогда
		ОбластьМакета = Макет.ПолучитьОбласть("Шапка_ОшибокНет");
		Таб.Вывести(ОбластьМакета, 1);
	Иначе
		ОбластьМакета = Макет.ПолучитьОбласть("Шапка_ОшибкиЕсть");
		ОбластьМакета.Параметры.КоличествоОшибок = ТаблицаРезультата.Количество();
		Таб.Вывести(ОбластьМакета, 1);
		
		ОбластьМакета = Макет.ПолучитьОбласть("Шапка_Таблица");
		ОбластьМакета.Параметры.Документ1 = "Документ";
		ОбластьМакета.Параметры.Пояснение1 = "Номер расчета в документе";
		ОбластьМакета.Параметры.Документ2 = "";
		ОбластьМакета.Параметры.Пояснение2 = "Номер расчета в выпускаемой продукции";
		Таб.Вывести(ОбластьМакета, 2, "Документ", Ложь);
		
		Ном = 1;
		Для Каждого ТекущаяСтрока Из ТаблицаРезультата Цикл
			ОбластьМакета = Макет.ПолучитьОбласть("Строка_Таблица");
			ЗаполнитьЗначенияСвойств(ОбластьМакета.Параметры, ТекущаяСтрока);
			ОбластьМакета.Параметры.Ном = Ном;
			Таб.Вывести(ОбластьМакета, 2, "Документ", Ложь);
			Ном = Ном + 1;
			
		КонецЦикла;
	КонецЕсли;
	
	Таб.ЗакончитьАвтогруппировкуСтрок();	
	Возврат Таб;
	
КонецФункции

#КонецОбласти

#Область ПроверкаКоличестваПотолков
//(+)
Функция ВыполнитьПроверку_ПроверкаКоличестваПотолков(СтруктураПараметров) Экспорт
	
	РезультатПроверки = ПолучитьТаблицу_ПроверкаКоличестваПотолков(СтруктураПараметров);
	ТабДок = ВывестиРезультатПроверки_ПроверкаКоличестваПотолков(РезультатПроверки);
	Возврат ТабДок;
	
КонецФункции

Функция ПолучитьТаблицу_ПроверкаКоличестваПотолков(СтруктураПараметров)
	
	ТаблицаРезультата = Новый ТаблицаЗначений;
	ТаблицаРезультата.Колонки.Добавить("Документ1"); 
	ТаблицаРезультата.Колонки.Добавить("Пояснение1"); 
	ТаблицаРезультата.Колонки.Добавить("Документ2"); 
	ТаблицаРезультата.Колонки.Добавить("Пояснение2"); 
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДатаНачала",    СтруктураПараметров.Получить("ДатаНачала"));
	Запрос.УстановитьПараметр("ДатаОкончания", СтруктураПараметров.Получить("ДатаОкончания"));
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ДанныеДокумента.Ссылка КАК Документ1,
	|	ДанныеДокумента.Количество * ДанныеДокумента.Коэффициент КАК Пояснение1,
	|	ДанныеДокумента.Номенклатура КАК Документ2,
	|	ДанныеДокумента.Номенклатура.Потолок_КоличествоПродукция КАК Пояснение2
	|ИЗ
	|	Документ.ЗаказПокупателя.Товары КАК ДанныеДокумента
	|ГДЕ
	|	(ДанныеДокумента.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Справочник.ВидыНоменклатуры.Потолок)
	|			ИЛИ ДанныеДокумента.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Справочник.ВидыНоменклатуры.Отрез))
	|	И ДанныеДокумента.Номенклатура.Потолок_КоличествоПродукция <> 0
	|	И ДанныеДокумента.Количество * ДанныеДокумента.Коэффициент <> ДанныеДокумента.Номенклатура.Потолок_КоличествоПродукция
	|	И (ДанныеДокумента.Ссылка.Дата >= &ДатаНачала
	|			ИЛИ &ДатаНачала = ДАТАВРЕМЯ(1, 1, 1))
	|	И (ДанныеДокумента.Ссылка.Дата <= &ДатаОкончания
	|			ИЛИ &ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1))";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл		
		НоваяСтрока = ТаблицаРезультата.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
	КонецЦикла;
	
	Возврат ТаблицаРезультата;
	
КонецФункции

Функция ВывестиРезультатПроверки_ПроверкаКоличестваПотолков(ТаблицаРезультата)
	
	Таб = Новый ТабличныйДокумент;
	Макет = ПолучитьОбщийМакет("МакетЭкспрессПроверкаУчета");
	
	Таб.НачатьАвтогруппировкуСтрок();
	
	ОбластьМакета = Макет.ПолучитьОбласть("Шапка_ВидПроверки");
	ОбластьМакета.Параметры.ВидПроверки = "Несовпадение количества по потолкам в заказах покупателей и в карточке номенклатуры";
	Таб.Вывести(ОбластьМакета, 1);
	
	Если ТаблицаРезультата.Количество() = 0 Тогда
		ОбластьМакета = Макет.ПолучитьОбласть("Шапка_ОшибокНет");
		Таб.Вывести(ОбластьМакета, 1);
	Иначе
		ОбластьМакета = Макет.ПолучитьОбласть("Шапка_ОшибкиЕсть");
		ОбластьМакета.Параметры.КоличествоОшибок = ТаблицаРезультата.Количество();
		Таб.Вывести(ОбластьМакета, 1);
		
		ОбластьМакета = Макет.ПолучитьОбласть("Шапка_Таблица");
		ОбластьМакета.Параметры.Документ1  = "Заказ покупателя";
		ОбластьМакета.Параметры.Пояснение1 = "Количество в заказе";
		ОбластьМакета.Параметры.Документ2  = "Номенклатура";
		ОбластьМакета.Параметры.Пояснение2 = "Количество в карточке";
		Таб.Вывести(ОбластьМакета, 2, "Документ", Ложь);
		
		Ном = 1;
		Для Каждого ТекущаяСтрока Из ТаблицаРезультата Цикл
			ОбластьМакета = Макет.ПолучитьОбласть("Строка_Таблица");
			ЗаполнитьЗначенияСвойств(ОбластьМакета.Параметры, ТекущаяСтрока);
			ОбластьМакета.Параметры.Ном = Ном;
			Таб.Вывести(ОбластьМакета, 2, "Документ", Ложь);
			Ном = Ном + 1;
			
		КонецЦикла;
	КонецЕсли;
	
	Таб.ЗакончитьАвтогруппировкуСтрок();	
	Возврат Таб;
	
КонецФункции

#КонецОбласти

#Область РасходятсяКоличествоКВыработкеМатериаловВыпускаПродукции
//(+)
Функция ВыполнитьПроверку_РасходятсяКоличествоКВыработкеМатериаловВыпускаПродукции(СтруктураПараметров) Экспорт
	
	РезультатПроверки = ПолучитьТаблицу_РасходятсяКоличествоКВыработкеМатериаловВыпускаПродукции(СтруктураПараметров);
	ТабДок = ВывестиРезультатПроверки_РасходятсяКоличествоКВыработкеМатериаловВыпускаПродукции(РезультатПроверки);
	Возврат ТабДок;
	
КонецФункции

Функция ПолучитьТаблицу_РасходятсяКоличествоКВыработкеМатериаловВыпускаПродукции(СтруктураПараметров)
	
	ТаблицаРезультата = Новый ТаблицаЗначений;
	ТаблицаРезультата.Колонки.Добавить("Документ1"); 
	ТаблицаРезультата.Колонки.Добавить("Пояснение1"); 
	ТаблицаРезультата.Колонки.Добавить("Документ2"); 
	ТаблицаРезультата.Колонки.Добавить("Пояснение2"); 
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДатаНачала",    СтруктураПараметров.Получить("ДатаНачала"));
	Запрос.УстановитьПараметр("ДатаОкончания", СтруктураПараметров.Получить("ДатаОкончания"));
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВыработкаИсполнителейПроизводства.Регистратор КАК Регистратор,
	|	ВыработкаИсполнителейПроизводства.Номенклатура КАК Номенклатура,
	|	СУММА(ЕСТЬNULL(ВыработкаИсполнителейПроизводства.Количество, 0)) КАК КоличествоВРегистре,
	|	ВыработкаИсполнителейПроизводства.ВидНачисления КАК ВидНачисления,
	|	ВыработкаИсполнителейПроизводства.ПроизводственнаяОперация КАК ПроизводственнаяОперация,
	|	КОЛИЧЕСТВО(ВыработкаИсполнителейПроизводства.Количество) КАК КоличествоПоВиду
	|ПОМЕСТИТЬ ВТ_Выработка
	|ИЗ
	|	РегистрНакопления.ВыработкаИсполнителейПроизводства КАК ВыработкаИсполнителейПроизводства
	|ГДЕ
	|	ВыработкаИсполнителейПроизводства.Регистратор ССЫЛКА Документ.ВыпускПродукции
	|	И ЕСТЬNULL(ВыработкаИсполнителейПроизводства.Номенклатура, ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)) <> ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	|	И (ВыработкаИсполнителейПроизводства.Период >= &ДатаНачала
	|			ИЛИ &ДатаНачала = ДАТАВРЕМЯ(1, 1, 1))
	|	И (ВыработкаИсполнителейПроизводства.Период <= &ДатаОкончания
	|			ИЛИ &ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1))
	|
	|СГРУППИРОВАТЬ ПО
	|	ВыработкаИсполнителейПроизводства.Регистратор,
	|	ВыработкаИсполнителейПроизводства.Номенклатура,
	|	ВыработкаИсполнителейПроизводства.ВидНачисления,
	|	ВыработкаИсполнителейПроизводства.ПроизводственнаяОперация
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ДанныеДокумента.Ссылка КАК Ссылка,
	|	ДанныеДокумента.Номенклатура КАК Номенклатура,
	//#14348
	//|	СУММА(ДанныеДокумента.Количество) КАК Количество,
	|	СУММА(ДанныеДокумента.Количество * ДанныеДокумента.Коэффициент) КАК Количество,
	|	СУММА(ДанныеДокумента.КоличествоКВыработке) КАК КоличествоКВыработке
	|ПОМЕСТИТЬ ВТ_ВыпускиМатериалы
	|ИЗ
	|	Документ.ВыпускПродукции.Материалы КАК ДанныеДокумента
	|ГДЕ
	|	(ДанныеДокумента.Ссылка.Дата >= &ДатаНачала
	|			ИЛИ &ДатаНачала = ДАТАВРЕМЯ(1, 1, 1))
	|	И (ДанныеДокумента.Ссылка.Дата <= &ДатаОкончания
	|			ИЛИ &ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1))
	|
	|СГРУППИРОВАТЬ ПО
	|	ДанныеДокумента.Ссылка,
	|	ДанныеДокумента.Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВТ_Выработка.Регистратор КАК Документ1,
	|	ВТ_Выработка.Номенклатура КАК Номенклатура,
	|	ВТ_Выработка.КоличествоВРегистре КАК КоличествоВРегистре,
	|	ВыпускиПродукцииМатериалы.Количество КАК КоличествоВВыпуске,
	|	ВыпускиПродукцииМатериалы.КоличествоКВыработке КАК КоличествоКВыработкеВВыпуске,
	|	ВТ_Выработка.КоличествоПоВиду КАК КоличествоПоВиду
	|ИЗ
	|	ВТ_Выработка КАК ВТ_Выработка
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ВыпускиМатериалы КАК ВыпускиПродукцииМатериалы
	|		ПО ВТ_Выработка.Регистратор = ВыпускиПродукцииМатериалы.Ссылка
	|			И ВТ_Выработка.Номенклатура = ВыпускиПродукцииМатериалы.Номенклатура
	|ГДЕ
	|	НЕ(ВыпускиПродукцииМатериалы.КоличествоКВыработке / ВТ_Выработка.КоличествоПоВиду - ВТ_Выработка.КоличествоВРегистре / ВТ_Выработка.КоличествоПоВиду <= 0.01
	|				И ВыпускиПродукцииМатериалы.КоличествоКВыработке / ВТ_Выработка.КоличествоПоВиду - ВТ_Выработка.КоличествоВРегистре / ВТ_Выработка.КоличествоПоВиду >= -0.01)
	|	И НЕ(ВыпускиПродукцииМатериалы.Количество / ВТ_Выработка.КоличествоПоВиду - ВТ_Выработка.КоличествоВРегистре / ВТ_Выработка.КоличествоПоВиду <= 0.01
	|				И ВыпускиПродукцииМатериалы.Количество / ВТ_Выработка.КоличествоПоВиду - ВТ_Выработка.КоличествоВРегистре / ВТ_Выработка.КоличествоПоВиду >= -0.01)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ВТ_Выработка.Регистратор.Дата
	|ИТОГИ ПО
	|	Документ1";
	
	Выборка = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока Выборка.Следующий() Цикл
		
		НоваяСтрока = ТаблицаРезультата.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		
		//Выведем попозиционно, где различия
		ВыборкаПозиции = Выборка.Выбрать(ОбходРезультатаЗапроса.Прямой);
		Пояснение1 = "";
		Пока ВыборкаПозиции.Следующий() Цикл
			Пояснение1 = Пояснение1 + ВыборкаПозиции.Номенклатура 
			+ " количество к выработке в выпуске " + ВыборкаПозиции.КоличествоКВыработкеВВыпуске
			+ ", количество в выпуске " + ВыборкаПозиции.КоличествоВВыпуске 
			+ ", количество в регистре " + ВыборкаПозиции.КоличествоВРегистре + Символы.ПС;
		КонецЦикла;
		НоваяСтрока.Пояснение1 = Пояснение1;
		
	КонецЦикла;
	
	Возврат ТаблицаРезультата;
	
КонецФункции

Функция ВывестиРезультатПроверки_РасходятсяКоличествоКВыработкеМатериаловВыпускаПродукции(ТаблицаРезультата)	
	
	Таб = Новый ТабличныйДокумент;
	Макет = ПолучитьОбщийМакет("МакетЭкспрессПроверкаУчета");
	
	Таб.НачатьАвтогруппировкуСтрок();
	
	ОбластьМакета = Макет.ПолучитьОбласть("Шапка_ВидПроверки");
	ОбластьМакета.Параметры.ВидПроверки = "Расходятся количество к выработке материалов выпуска продукции и движений по регистру ""Выработка сотрудников Производства"".";
	Таб.Вывести(ОбластьМакета, 1);
	
	Если ТаблицаРезультата.Количество() = 0 Тогда
		ОбластьМакета = Макет.ПолучитьОбласть("Шапка_ОшибокНет");
		Таб.Вывести(ОбластьМакета, 1);
	Иначе
		ОбластьМакета = Макет.ПолучитьОбласть("Шапка_ОшибкиЕсть");
		ОбластьМакета.Параметры.КоличествоОшибок = ТаблицаРезультата.Количество();
		Таб.Вывести(ОбластьМакета, 1);
		
		ОбластьМакета = Макет.ПолучитьОбласть("Шапка_Таблица");
		ОбластьМакета.Параметры.Документ1  = "Выпуск продукции";
		ОбластьМакета.Параметры.Пояснение1 = "Различающиеся значения";
		ОбластьМакета.Параметры.Документ2  = "";
		ОбластьМакета.Параметры.Пояснение2 = "";
		Таб.Вывести(ОбластьМакета, 2, "Документ", Ложь);
		
		Ном = 1;
		Для Каждого ТекущаяСтрока Из ТаблицаРезультата Цикл
			ОбластьМакета = Макет.ПолучитьОбласть("Строка_Таблица");
			ЗаполнитьЗначенияСвойств(ОбластьМакета.Параметры, ТекущаяСтрока);
			ОбластьМакета.Параметры.Ном = Ном;
			Таб.Вывести(ОбластьМакета, 2, "Документ", Ложь);
			Ном = Ном + 1;
			
		КонецЦикла;
	КонецЕсли;
	
	Таб.ЗакончитьАвтогруппировкуСтрок();	
	Возврат Таб;
	
КонецФункции

#КонецОбласти

#Область КорректностьИспользованияОстатковПленкиМатериалаЗаказчика
//(+)
Функция ВыполнитьПроверку_КорректностьИспользованияОстатковПленки(ОбъектыКИсправлению, СтруктураПараметров) Экспорт
	
	РезультатПроверки = ПолучитьТаблицу_КорректностьИспользованияОстатковПленкиМатериалаЗаказчика(ОбъектыКИсправлению, , СтруктураПараметров);
	ТабДок = ВывестиРезультатПроверки_КорректностьИспользованияОстатковПленки(РезультатПроверки);
	Возврат ТабДок;
	
КонецФункции

Функция ПолучитьТаблицу_КорректностьИспользованияОстатковПленкиМатериалаЗаказчика(ОбъектыКИсправлению, ЭтоОстаток = Истина, СтруктураПараметров)
	
	ТаблицаРезультата = Новый ТаблицаЗначений;
	ТаблицаРезультата.Колонки.Добавить("Документ1");
	ТаблицаРезультата.Колонки.Добавить("Пояснение1");
	ТаблицаРезультата.Колонки.Добавить("Документ2");
	ТаблицаРезультата.Колонки.Добавить("Пояснение2");
	ТаблицаРезультата.Колонки.Добавить("Примечание");
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДатаНачала",    СтруктураПараметров.Получить("ДатаНачала"));
	Запрос.УстановитьПараметр("ДатаОкончания", СтруктураПараметров.Получить("ДатаОкончания"));
	Запрос.УстановитьПараметр("Номенклатура", ?(ЭтоОстаток, Справочники.Номенклатура.ОстаткиПленки, Справочники.Номенклатура.ПолотноЗаказчика));
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ДанныеДокумента.Ссылка КАК ДокументВыпуска,
	|	ДанныеДокумента.Ссылка.Основание КАК ДокументЗНП,
	|	СУММА(ДанныеДокумента.Количество) КАК Количество
	|ПОМЕСТИТЬ ВТ_Выпуски
	|ИЗ
	|	Документ.ВыпускПродукции.Материалы КАК ДанныеДокумента
	|ГДЕ
	|	ДанныеДокумента.Номенклатура = &Номенклатура
	|	И ДанныеДокумента.Ссылка.Основание.ВидЗаказа = ЗНАЧЕНИЕ(Перечисление.ВидыЗаказовНаПроизводство.ПроизводствоПотолка)
	|	И НЕ ДанныеДокумента.Ссылка.ПродукцияНоменклатура.Потолок_Многфактурный
	|	И (ДанныеДокумента.Ссылка.Дата >= &ДатаНачала
	|			ИЛИ &ДатаНачала = ДАТАВРЕМЯ(1, 1, 1))
	|	И (ДанныеДокумента.Ссылка.Дата <= &ДатаОкончания
	|			ИЛИ &ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1))
	|
	|СГРУППИРОВАТЬ ПО
	|	ДанныеДокумента.Ссылка,
	|	ДанныеДокумента.Ссылка.Основание
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЗНПМатериалы.Ссылка КАК ДокументЗНП,
	|	СУММА(ВЫРАЗИТЬ(ЗНПМатериалы.Количество * ЗНПМатериалы.Коэффициент КАК ЧИСЛО(15, 2))) КАК Количество
	|ПОМЕСТИТЬ ВТ_Заказы
	|ИЗ
	|	Документ.ЗаказНаПроизводство.Материалы КАК ЗНПМатериалы
	|ГДЕ
	|	ЗНПМатериалы.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Справочник.ВидыНоменклатуры.Полотно)
	|	И ЗНПМатериалы.Ссылка.ВидЗаказа = ЗНАЧЕНИЕ(Перечисление.ВидыЗаказовНаПроизводство.ПроизводствоПотолка)
	|	И ЗНПМатериалы.Ссылка В
	|			(ВЫБРАТЬ
	|				ВТ_Выпуски.ДокументЗНП
	|			ИЗ
	|				ВТ_Выпуски)
	|
	|СГРУППИРОВАТЬ ПО
	|	ЗНПМатериалы.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ДанныеДокумента.Ссылка КАК Документ1,
	|	ДанныеДокумента.Ссылка.Дата КАК Пояснение1,
	|	""Указана не базовая единица измерения"" КАК Примечание
	|ПОМЕСТИТЬ ВТ_Ошибки
	|ИЗ
	|	Документ.ВыпускПродукции.Материалы КАК ДанныеДокумента
	|ГДЕ
	|	(ДанныеДокумента.ЕдиницаИзмерения = ЗНАЧЕНИЕ(Справочник.ЕдиницыИзмерений.ПустаяСсылка)
	|			ИЛИ ДанныеДокумента.ЕдиницаИзмерения ССЫЛКА Справочник.ЕдиницыИзмерений)
	|	И ДанныеДокумента.Номенклатура = &Номенклатура
	|	И (ДанныеДокумента.Ссылка.Дата >= &ДатаНачала
	|			ИЛИ &ДатаНачала = ДАТАВРЕМЯ(1, 1, 1))
	|	И (ДанныеДокумента.Ссылка.Дата <= &ДатаОкончания
	|			ИЛИ &ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1))
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ДанныеДокумента.Ссылка,
	|	ДанныеДокумента.Ссылка.Дата,
	|	""Не заполнен коэффициент""
	|ИЗ
	|	Документ.ВыпускПродукции.Материалы КАК ДанныеДокумента
	|ГДЕ
	|	ДанныеДокумента.Коэффициент = 0
	|	И ДанныеДокумента.Номенклатура = &Номенклатура
	|	И (ДанныеДокумента.Ссылка.Дата >= &ДатаНачала
	|			ИЛИ &ДатаНачала = ДАТАВРЕМЯ(1, 1, 1))
	|	И (ДанныеДокумента.Ссылка.Дата <= &ДатаОкончания
	|			ИЛИ &ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1))
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВТ_Выпуски.ДокументВыпуска,
	|	ВТ_Выпуски.ДокументВыпуска.Дата,
	|	""Не совпадает количество в выпуске и заказе на производство""
	|ИЗ
	|	ВТ_Выпуски КАК ВТ_Выпуски
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Заказы КАК ВТ_Заказы
	|		ПО (ВТ_Заказы.ДокументЗНП = ВТ_Выпуски.ДокументЗНП)
	|ГДЕ
	|	ВТ_Выпуски.Количество <> ВТ_Заказы.Количество
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Ошибки.Документ1 КАК Документ1,
	|	ВТ_Ошибки.Пояснение1 КАК Пояснение1,
	|	ВТ_Ошибки.Примечание КАК Примечание
	|ИЗ
	|	ВТ_Ошибки КАК ВТ_Ошибки
	|
	|УПОРЯДОЧИТЬ ПО
	|	Пояснение1
	|ИТОГИ ПО
	|	Документ1";
	
	Выборка = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока Выборка.Следующий() Цикл
		
		НоваяСтрока = ТаблицаРезультата.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		
		//Выведем попозиционно, в чем различия
		ВыборкаПозиции = Выборка.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Примечание = "";
		Пока ВыборкаПозиции.Следующий() Цикл
			Примечание = Примечание + ВыборкаПозиции.Примечание + Символы.ПС;
		КонецЦикла;
		НоваяСтрока.Примечание = СокрЛП(Примечание);
		
		НоваяСтрока = ОбъектыКИсправлению.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		НоваяСтрока.Исправить = ?(ЭтоОстаток, "КорректировкаИспользованияОстатковПленки", "КорректировкаИспользованияматериалаЗаказчика"); // №12260 добавлено условие, чтобы отрабатывало второе правило
	КонецЦикла;
	
	Возврат ТаблицаРезультата;
	
КонецФункции

Функция ВывестиРезультатПроверки_КорректностьИспользованияОстатковПленки(ТаблицаРезультата)
	
	Таб = Новый ТабличныйДокумент;
	Макет = ПолучитьОбщийМакет("МакетЭкспрессПроверкаУчета");
	
