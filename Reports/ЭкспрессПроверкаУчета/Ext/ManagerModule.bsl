Функция ИсправитьОбъект_РеализацияРаньшеЗаказаНаПроизводство(ДокументРеализация, ДокументЗаказНаПроизводство) Экспорт
	
	Если НачалоДня(ДокументРеализация.Дата) <>  НачалоДня(ДокументЗаказНаПроизводство.Дата) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ОбъектРеализация = ДокументРеализация.ПолучитьОбъект();
	ОбъектРеализация.Дата = ДокументЗаказНаПроизводство.Дата + 1;
	
	Попытка
		Если ОбъектРеализация.Проведен Тогда
			ОбъектРеализация.Записать(РежимЗаписиДокумента.Проведение);
		Иначе
			ОбъектРеализация.Записать();
		КонецЕсли;
		Возврат Истина;
	Исключение
		//Сообщить("Попытка присвоить дату " + ОбъектВыпуск.Дата + " для " + ОбъектВыпуск + ". Ошибка: " + ОписаниеОшибки());
		Возврат Ложь;
	КонецПопытки;
	
КонецФункции

