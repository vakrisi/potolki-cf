&НаКлиенте
Процедура Пауза(КоличествоСекунд)
	
	ВС_Шелл = Новый COMОбъект("WScript.Shell");
	ВС_Шелл.Run("ping 127.0.0.1 -n "+КоличествоСекунд, 0, 1);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОжиданияПрерыванияИсправления()
	УправлениеВидимостью();
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьНадписьИнформацииПоОбработкеОбъектов(РезультатОбработки, КоличествоОбъектов, КоличествоОбъектовУспешно, КоличествоОбъектовНеуспешно)
	
	Если РезультатОбработки Тогда
		КоличествоОбъектовУспешно = КоличествоОбъектовУспешно + 1;
	Иначе
		КоличествоОбъектовНеуспешно = КоличествоОбъектовНеуспешно + 1;
	КонецЕсли;
	
	ШрифтСообщения = Новый Шрифт(,,Истина);
	ЦветСообщения = WebЦвета.Черный;
	ЦветУспешногоОбъекта = WebЦвета.ЗеленыйЛес;
	ЦветПроблемногоОбъекта = WebЦвета.Красный;
	
	ФормСтрока1 = Новый ФорматированнаяСтрока("Всего объектов к обработке: " + Строка(КоличествоОбъектов) + ", ", ШрифтСообщения, ЦветСообщения);  
	ФормСтрока2 = Новый ФорматированнаяСтрока("обработано успешно: " + Строка(КоличествоОбъектовУспешно) + ", ", ШрифтСообщения, ЦветУспешногоОбъекта);
	ФормСтрока3 = Новый ФорматированнаяСтрока("неуспешно: " + Строка(КоличествоОбъектовНеуспешно), ШрифтСообщения, ЦветПроблемногоОбъекта);

	МассивСтрокСообщения = Новый Массив;
	МассивСтрокСообщения.Добавить(ФормСтрока1);
	МассивСтрокСообщения.Добавить(ФормСтрока2);
	МассивСтрокСообщения.Добавить(ФормСтрока3);
	
	ИнформацияПоОбработкеОбъектов = Новый ФорматированнаяСтрока(МассивСтрокСообщения);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы
&НаКлиенте
Процедура РезультатОбработкаРасшифровки(Элемент, Расшифровка, СтандартнаяОбработка)
	
	Если Расшифровка = "ПоставитьДатуВыпускаПозжеДатыЗаказаНаПроизводство" Тогда		
		СтандартнаяОбработка = Ложь;
		УправлениеВидимостью(2);
	
		ПодключитьОбработчикОжидания("ОбработкаОжиданияПрерыванияИсправления", 0.1, Истина);
		ИсправитьОбъекты_ВыпускПродукцииРаньшеЗаказаНаПроизводство(Расшифровка);
		ОтключитьОбработчикОжидания("ОбработкаОжиданияПрерыванияИсправления");
		
		УправлениеВидимостью();
		ВыполнитьПроверку(Неопределено);
		
	ИначеЕсли Расшифровка = "ПоставитьДатуРеализацииПозжеДатыЗаказаНаПроизводство" Тогда	
		СтандартнаяОбработка = Ложь;
		УправлениеВидимостью(2);
		
		ПодключитьОбработчикОжидания("ОбработкаОжиданияПрерыванияИсправления", 0.1, Истина);
		ИсправитьОбъекты_РеализацияРаньшеЗаказаНаПроизводство(Расшифровка);
		ОтключитьОбработчикОжидания("ОбработкаОжиданияПрерыванияИсправления");
		
		УправлениеВидимостью();
		ВыполнитьПроверку(Неопределено);
		
	ИначеЕсли Расшифровка = "ПоставитьДатуРеализацииПозжеДатыЗаказаПокупателя" Тогда
		СтандартнаяОбработка = Ложь;
		УправлениеВидимостью(2);
	
		ПодключитьОбработчикОжидания("ОбработкаОжиданияПрерыванияИсправления", 0.1, Истина);
		ИсправитьОбъекты_РеализацияРаньшеЗаказаПокупателя(Расшифровка);
		ОтключитьОбработчикОжидания("ОбработкаОжиданияПрерыванияИсправления");
		
		УправлениеВидимостью();
		ВыполнитьПроверку(Неопределено);
		
	ИначеЕсли Расшифровка = "ПоставитьДатуПоступленияРаньшеДатыРеализации" Тогда
		СтандартнаяОбработка = Ложь;
		УправлениеВидимостью(2);
		
	    ПодключитьОбработчикОжидания("ОбработкаОжиданияПрерыванияИсправления", 0.1, Истина);
		ИсправитьОбъекты_РеализацияРаньшеПоступления(Расшифровка);
		ОтключитьОбработчикОжидания("ОбработкаОжиданияПрерыванияИсправления");
		
		УправлениеВидимостью();
		ВыполнитьПроверку(Неопределено);
		
	ИначеЕсли Расшифровка = "ПоставитьДатуЗаказаПоставщикуРаньшеДатыПоступления" Тогда		
		СтандартнаяОбработка = Ложь;
		УправлениеВидимостью(2);
	
		ПодключитьОбработчикОжидания("ОбработкаОжиданияПрерыванияИсправления", 0.1, Истина);
		ИсправитьОбъекты_ПоступлениеРаньшеЗаказаПоставщику(Расшифровка);
		ОтключитьОбработчикОжидания("ОбработкаОжиданияПрерыванияИсправления");
		
		УправлениеВидимостью();
		ВыполнитьПроверку(Неопределено);		
		
	ИначеЕсли Расшифровка = "ПоставитьДатуРеализацииПозжеДатыЗНПпоЗД" Тогда
		СтандартнаяОбработка = Ложь;
		УправлениеВидимостью(2);
	
		ПодключитьОбработчикОжидания("ОбработкаОжиданияПрерыванияИсправления", 0.1, Истина);
		ИсправитьОбъекты_РеализацияРаньшеЗНПпоЗД(Расшифровка);
		ОтключитьОбработчикОжидания("ОбработкаОжиданияПрерыванияИсправления");
		
		УправлениеВидимостью();
		ВыполнитьПроверку(Неопределено);
		
	ИначеЕсли Расшифровка = "ПоставитьДатуРеализацииПозжеДатыВыпускаПоЗНП" Тогда
		СтандартнаяОбработка = Ложь;
		УправлениеВидимостью(2);
		
		ПодключитьОбработчикОжидания("ОбработкаОжиданияПрерыванияИсправления", 0.1, Истина);
		ИсправитьОбъекты_РеализацияРаньшеВыпускаПоЗНП(Расшифровка);
		ОтключитьОбработчикОжидания("ОбработкаОжиданияПрерыванияИсправления");
		
		УправлениеВидимостью();
		ВыполнитьПроверку(Неопределено);

	ИначеЕсли Расшифровка = "ЗапуститьОбработчикПроведенияДокументовПослеОбновления" Тогда
		СтандартнаяОбработка = Ложь;		
		ОткрытьФормуМодально("Обработка.НастройкаПрограммы.Форма.ОбработкаДокументовПослеОбновления");
		ВыполнитьПроверку(Неопределено);
		
	ИначеЕсли Расшифровка = "ОбновитьЗаказНаПроизводствоПоПотолкуПоЗаказуПокупателя" Тогда
		СтандартнаяОбработка = Ложь;
		УправлениеВидимостью(2);
		
		ПодключитьОбработчикОжидания("ОбработкаОжиданияПрерыванияИсправления", 0.1, Истина);
		ИсправитьОбъекты_ОбновитьЗаказНаПроизводствоПоПотолкуПоЗаказуПокупателя(Расшифровка);
		ОтключитьОбработчикОжидания("ОбработкаОжиданияПрерыванияИсправления");
		
		УправлениеВидимостью();
		ВыполнитьПроверку(Неопределено);
		
	ИначеЕсли Расшифровка = "ОбновитьУслугиВыпускаПоЗаказуНаПроизводство" Тогда
		СтандартнаяОбработка = Ложь;
		УправлениеВидимостью(2);
		
		ПодключитьОбработчикОжидания("ОбработкаОжиданияПрерыванияИсправления", 0.1, Истина);
		ИсправитьОбъекты_ОбновитьУслугиВыпускаПоЗаказуНаПроизводство(Расшифровка);
		ОтключитьОбработчикОжидания("ОбработкаОжиданияПрерыванияИсправления");
		
		УправлениеВидимостью();
		ВыполнитьПроверку(Неопределено);
		
	ИначеЕсли Расшифровка = "ПометитьНаУдалениеНепроведенныеДокументы" Тогда
		СтандартнаяОбработка = Ложь;
		УправлениеВидимостью(2);
		
		ПодключитьОбработчикОжидания("ОбработкаОжиданияПрерыванияИсправления", 0.1, Истина);
		ИсправитьОбъекты_ПометитьНаУдалениеНепроведенныеДокументы(Расшифровка);
		ОтключитьОбработчикОжидания("ОбработкаОжиданияПрерыванияИсправления");
		
		УправлениеВидимостью();
		ВыполнитьПроверку(Неопределено);
		
	ИначеЕсли ТипЗнч(Расшифровка) =	Тип("СписокЗначений") Тогда
		
		СтандартнаяОбработка = Ложь;
		
		Если Расшифровка.Количество() > 0 Тогда
			
			Если ТипЗнч(Расшифровка[0].Значение) = Тип("ДокументСсылка.РеализацияТоваровИУслуг") Тогда
				
				НазваниеФормы = "Документ.РеализацияТоваровИУслуг.ФормаСписка";
				
			ИначеЕсли ТипЗнч(Расшифровка[0].Значение) = Тип("ДокументСсылка.ЗаказПокупателя") Тогда			
				НазваниеФормы = "Документ.ЗаказПокупателя.ФормаСписка";
				
			ИначеЕсли ТипЗнч(Расшифровка[0].Значение) = Тип("ДокументСсылка.ЗаказНаПроизводство") Тогда				
				НазваниеФормы = "Документ.ЗаказНаПроизводство.ФормаСписка";
				
			ИначеЕсли ТипЗнч(Расшифровка[0].Значение) = Тип("ДокументСсылка.ВыпускПродукции") Тогда				
				НазваниеФормы = "Документ.ВыпускПродукции.ФормаСписка";
				
			ИначеЕсли ТипЗнч(Расшифровка[0].Значение) = Тип("СправочникСсылка.Номенклатура") Тогда				
				НазваниеФормы = "Справочник.Номенклатура.ФормаСписка";
				
			Иначе
				Возврат;
			КонецЕсли;	
			
			ПараметрыФормы = ПолучитьНастройкиОткрытияСписка(Расшифровка);
			ОткрытьФорму(НазваниеФормы, новый Структура("ФиксированныеНастройки", ПараметрыФормы), ЭтотОбъект);
			
		КонецЕсли;
		
	ИначеЕсли Расшифровка = "ЗаполнитьЗначениеЗаказаВТабличныхЧастяхРеализации" Тогда
		СтандартнаяОбработка = Ложь;
		УправлениеВидимостью(2);
		
		ПодключитьОбработчикОжидания("ОбработкаОжиданияПрерыванияИсправления", 0.1, Истина);
		ИсправитьОбъект_ЗаполнитьЗначениеЗаказаВТабличныхЧастяхРеализации(Расшифровка);
		ОтключитьОбработчикОжидания("ОбработкаОжиданияПрерыванияИсправления");
		
		УправлениеВидимостью();
		ВыполнитьПроверку(Неопределено);
		
	ИначеЕсли Расшифровка = "ИсправитьОтрицательныеОстаткиТоваров" Тогда
		СтандартнаяОбработка = Ложь;
		УправлениеВидимостью(2);
		
		ПодключитьОбработчикОжидания("ОбработкаОжиданияПрерыванияИсправления", 0.1, Истина);
		ИсправитьОбъекты_ОтрицательныеОстаткиТоваров(Расшифровка);
		ОтключитьОбработчикОжидания("ОбработкаОжиданияПрерыванияИсправления");
		
		УправлениеВидимостью();
		ВыполнитьПроверку(Неопределено);
		
	ИначеЕсли Расшифровка = "ИсправитьОтрицательныеОстаткиДС" Тогда
		СтандартнаяОбработка = Ложь;
		УправлениеВидимостью(2);
		
		ПодключитьОбработчикОжидания("ОбработкаОжиданияПрерыванияИсправления", 0.1, Истина);
		ИсправитьОбъекты_ОтрицательныеОстаткиДС(Расшифровка);
		ОтключитьОбработчикОжидания("ОбработкаОжиданияПрерыванияИсправления");
		
		УправлениеВидимостью();
		ВыполнитьПроверку(Неопределено);
		
	ИначеЕсли Расшифровка = "КорректировкаИспользованияОстатковПленки" Тогда
		СтандартнаяОбработка = Ложь;
		УправлениеВидимостью(2);
		
		ПодключитьОбработчикОжидания("ОбработкаОжиданияПрерыванияИсправления", 0.1, Истина);
		ИсправитьОбъекты_КорректировкаИспользованияОстатковПленкиМатериалаЗаказчика(Расшифровка);
		ОтключитьОбработчикОжидания("ОбработкаОжиданияПрерыванияИсправления");
		
		УправлениеВидимостью();
		ВыполнитьПроверку(Неопределено);
		
	ИначеЕсли Расшифровка = "КорректировкаИспользованияматериалаЗаказчика" Тогда
		СтандартнаяОбработка = Ложь;
		УправлениеВидимостью(2);
		
		ПодключитьОбработчикОжидания("ОбработкаОжиданияПрерыванияИсправления", 0.1, Истина);
		ИсправитьОбъекты_КорректировкаИспользованияОстатковПленкиМатериалаЗаказчика(Расшифровка, Ложь);
		ОтключитьОбработчикОжидания("ОбработкаОжиданияПрерыванияИсправления");
		
		УправлениеВидимостью();
		ВыполнитьПроверку(Неопределено);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьНастройкиОткрытияСписка(СписокДокументов)

	КомпоновщикНастроек = Новый КомпоновщикНастроекКомпоновкиДанных;	

	Элт = КомпоновщикНастроек.ФиксированныеНастройки.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Элт.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Ссылка");
	Элт.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке;
	Элт.Использование = Истина;
	Элт.ПравоеЗначение = СписокДокументов;

	Возврат КомпоновщикНастроек.ФиксированныеНастройки

КонецФункции

&НаКлиенте
Процедура ВыполнитьПроверку(Команда)
	
	ОтключитьОбработчикОжидания("Подключаемый_ПроверитьВыполнениеЗадания");

	//ФормаДлительнойОперации = ДлительныеОперацииКлиент.ОткрытьФормуДлительнойОперации(ЭтаФорма, ИдентификаторЗадания);	
	ОтображениеСостояния = Элементы.Результат.ОтображениеСостояния;
	ОтображениеСостояния.Видимость                      = Истина;
    ОтображениеСостояния.ДополнительныйРежимОтображения = ДополнительныйРежимОтображения.Неактуальность;
    ОтображениеСостояния.Картинка                       = БиблиотекаКартинок.ДлительнаяОперация48;
    ОтображениеСостояния.Текст                          = НСтр("ru = 'Данные формируются...'");
	
	РезультатВыполнения = ВыполнитьПроверкуНаСервере();
		
	Если РезультатВыполнения.ЗаданиеВыполнено Тогда  
		
		ОбработатьРезультат(АдресХранилища);

		ОтображениеСостояния = Элементы.Результат.ОтображениеСостояния;
		ОтображениеСостояния.Видимость                      = Ложь;
		ОтображениеСостояния.ДополнительныйРежимОтображения = ДополнительныйРежимОтображения.НеИспользовать;
		ОтображениеСостояния.Картинка                       = Новый Картинка;
		ОтображениеСостояния.Текст                          = "";
		
	Иначе
		ДлительныеОперацииКлиент.ИнициализироватьПараметрыОбработчикаОжидания(ПараметрыОбработчикаОжидания);
		ПодключитьОбработчикОжидания("Подключаемый_ПроверитьВыполнениеЗадания", 1, Истина);    
	КонецЕсли;
 	
КонецПроцедуры

