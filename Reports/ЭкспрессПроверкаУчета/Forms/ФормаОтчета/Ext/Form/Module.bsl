 &НаСервере
Процедура ОбработатьРезультат(РезультатВыполнения)
	//Результат.Вывести(РезультатВыполнения.ТабличныйДокумент); 
	РезультатВыполнения = ПолучитьИзВременногоХранилища(РезультатВыполнения);	
	Результат = РезультатВыполнения.ТабличныйДокумент;
	Для каждого ЭлементРез из РезультатВыполнения.ОбъектыКИсправлению Цикл
		НоваяСтрока = ОбъектыКИсправлению.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ЭлементРез);
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ДекорацияНастройкаДатыЗапретаНажатие(Элемент)
	ОписаниеОповещения = Новый ОписаниеОповещения("ПослеИзмененияДатыЗапрета", ЭтотОбъект);
	ОткрытьФорму("РегистрСведений.ДатыЗапретаИзменения.Форма.ДатыЗапретаИзменения",,,,,,ОписаниеОповещения);
КонецПроцедуры

&НаКлиенте
Процедура ПослеИзмененияДатыЗапрета(Результат, ДополнительныеПараметры) Экспорт
	УстановитьВидимостьГруппыДатыЗапрета();	
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьГруппыДатыЗапрета()
	
	ЕстьЗапрет = ОбщийМодульСервер.ЕстьЗапретИзмененияДанных(Дата(2001,1,1));
	Элементы.ГруппаДатаЗапрета.Видимость = ЕстьЗапрет; 

КонецПроцедуры

&НаСервере
Процедура ВыделитьПроверки(Выделить)
	МассивТипов = Новый Массив;
	МассивТипов.Добавить(Тип("Булево"));
	ДопустимыеТипы = Новый ОписаниеТипов(МассивТипов);

	Для каждого РеквизитФормы из ЭтаФорма.ПолучитьРеквизиты() Цикл
		Если РеквизитФормы.ТипЗначения = ДопустимыеТипы И СтрНачинаетсяС(РеквизитФормы.Имя, "Проверка") Тогда
			ЭтаФорма[РеквизитФормы.Имя] = Выделить;	
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура СнятьВсеПроверки(Команда)
	ВыделитьПроверки(Ложь);
КонецПроцедуры

&НаКлиенте
Процедура ВыделитьВсеПроверки(Команда)	
	ВыделитьПроверки(Истина);	
КонецПроцедуры

&НаСервере
Процедура ПроверкиПоУмолчаниюНаСервере()
	ВыделитьПроверки(Истина);
	ПроверкаДанныеПоПотолкуЗаказаНаПроизводствоНеСходятсяСДаннымиЗаказаПокупателя = Ложь;
	ПроверкаПотолокУказанныйВЗаказеНаПроизводствоОтсутствуетВЗаказеПокупателя = Ложь;
	ПроверкаСостоянияОтгрузкиПоВыполненнымЗаказамПокупателей = Ложь;
КонецПроцедуры

&НаКлиенте
Процедура ПроверкиПоУмолчанию(Команда)
	ПроверкиПоУмолчаниюНаСервере();
КонецПроцедуры

