//============================================== ПРОЦЕДУРЫ ПО ВИДАМ ПРОВЕРОК ========================================
//============================================== Дата документа выпуска меньше чем дата заказа на производство ===============================================
&НаКлиенте
Процедура ИсправитьОбъекты_ВыпускПродукцииРаньшеЗаказаНаПроизводство(Исправить)
		
	Отбор = Новый Структура("Исправить", Исправить);
	СтрокиКОбработке = ОбъектыКИсправлению.НайтиСтроки(Отбор);
	
	КоличествоВыполнено = 0;
	Элементы.КоличествоВыполнено.МаксимальноеЗначение = СтрокиКОбработке.Количество();
	
	КоличествоОбъектов = СтрокиКОбработке.Количество();
	КоличествоОбъектовУспешно = 0;
	КоличествоОбъектовНеуспешно = 0;
	
	ТекущееСостояниеВыполнения = "Исправление даты выпусков продукции";
	ОбновитьОтображениеДанных();
	
	Для Каждого ТекущаяСтрока Из СтрокиКОбработке Цикл
		ОбработкаПрерыванияПользователя();
		РезультатОбработки = ИсправитьОбъект_ВыпускПродукцииРаньшеЗаказаНаПроизводство(ТекущаяСтрока.Документ1, ТекущаяСтрока.Документ2);
		
		ОбновитьНадписьИнформацииПоОбработкеОбъектов(РезультатОбработки, КоличествоОбъектов, КоличествоОбъектовУспешно, КоличествоОбъектовНеуспешно);
		КоличествоВыполнено = КоличествоВыполнено + 1;
		ОбновитьОтображениеДанных();
		Пауза(1);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере 
Функция ИсправитьОбъект_ВыпускПродукцииРаньшеЗаказаНаПроизводство(ДокументВыпускПродукции, ДокументЗаказНаПроизводство)
	Возврат Отчеты.ЭкспрессПроверкаУчета.ИсправитьОбъект_ВыпускПродукцииРаньшеЗаказаНаПроизводство(ДокументВыпускПродукции, ДокументЗаказНаПроизводство);
