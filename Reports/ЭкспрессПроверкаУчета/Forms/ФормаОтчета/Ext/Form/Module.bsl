	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ОприходованиеТоваров.Ссылка
	|ИЗ
	|	Документ.ОприходованиеТоваров КАК ОприходованиеТоваров
	|ГДЕ
	|	ОприходованиеТоваров.Проведен
	|	И НЕ(ЧАС(ОприходованиеТоваров.Дата) = 0
	|				И МИНУТА(ОприходованиеТоваров.Дата) = 0
	|				И СЕКУНДА(ОприходованиеТоваров.Дата) = 1)";
	Элементы.ПеренестиВсеОприходованияТоваровНаНачалоДня.Заголовок = "Перенести все оприходования товаров на начало дня (" + Запрос.Выполнить().Выбрать().Количество() + ")";
	
