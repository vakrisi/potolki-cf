//============================================== Сервисные обработки ========================================
&НаСервере
Процедура ПеренестиВсеПоступленияНаНачалоДняНаСервере()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ПоступлениеТоваровИУслуг.Ссылка
	|ИЗ
	|	Документ.ПоступлениеТоваровИУслуг КАК ПоступлениеТоваровИУслуг
	|ГДЕ
	|	ПоступлениеТоваровИУслуг.Проведен
	|	И НЕ(ЧАС(ПоступлениеТоваровИУслуг.Дата) = 0
	|				И МИНУТА(ПоступлениеТоваровИУслуг.Дата) = 0
	|				И СЕКУНДА(ПоступлениеТоваровИУслуг.Дата) = 1)";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ДокОбъект = Выборка.Ссылка.ПолучитьОбъект();
		ДокОбъект.Дата = НачалоДня(ДокОбъект.Дата) + 1;
		Попытка
			ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
		Исключение
			Сообщить("Ошибка проведения " + Выборка.Ссылка + ". " + ОписаниеОшибки());
		КонецПопытки;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ПеренестиВсеПоступленияНаНачалоДня(Команда)
	ПеренестиВсеПоступленияНаНачалоДняНаСервере();
	ПоказатьПредупреждение(,"Готово");
	ОбновитьЭлементыФормыНаСервере();
КонецПроцедуры

