#Область ВкладкаСебестоимость

&НаКлиенте
Процедура ВосстановитьПоследовательность(Команда)
	
	Режим = РежимДиалогаВопрос.ДаНет;
	Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопросаОЗапускеВосстановленияПоследовательности", ЭтаФорма, Параметры);
	ПоказатьВопрос(Оповещение, "Восстановление последовательности может занять продолжительное время, программа в этот момент будет вас не доступна для работы. Продолжить?", Режим, 0);

КонецПроцедуры

&НаКлиенте
Процедура АвтоматическиОбновлениеСостоянияПоследовательностиПриИзменении(Элемент)
	
	ОтключитьОбработчикОжидания("ОбработчикОбновленияСостоянияПоследовательности");
	Если АвтоматическиОбновлениеСостоянияПоследовательности Тогда
		ПодключитьОбработчикОжидания("ОбработчикОбновленияСостоянияПоследовательности", 1);	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияВопросаОЗапускеВосстановленияПоследовательности(Результат, Параметры) Экспорт
	
	Если НЕ Результат = КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
		
	Если ОбщийМодуль.ПоследовательностьПоСебестоимостиНарушена() Тогда
		Сообщение = "";
		Идентификатор = "";
		
		ОбщийМодуль.ЗапуститьФоновоеЗаданиеВосстановлениеПоследовательностиПоСебестоимости(Сообщение, Идентификатор);
		
		Если ЗначениеЗаполнено(Идентификатор) Тогда
			ИдентификаторФоновогоЗадания = Идентификатор;			
			ПодключитьОбработчикОжидания("СообщитьОбОкончанииВосстановленияПоследовательности", 0.1, Истина);
		КонецЕсли;
		
		ПоказатьПредупреждение(, Сообщение);
		
		ОтключитьОбработчикОжидания("ОбработчикОбновленияСостоянияПоследовательности");
		Если АвтоматическиОбновлениеСостоянияПоследовательности Тогда
			ПодключитьОбработчикОжидания("ОбработчикОбновленияСостоянияПоследовательности", 1);	
		КонецЕсли;
		
	КонецЕсли;	
	ОбновитьЭлементыФормыНаСервере();
		
КонецПроцедуры
	
&НаКлиенте
Процедура СообщитьОбОкончанииВосстановленияПоследовательности()
	
	ОповещенияОбОкончанииВыполнения = ОбщийМодуль.ОповещенияОбОкончанииВыполненияРегламентныхЗаданий(ИдентификаторФоновогоЗадания);
	
	Если ТипЗнч(ОповещенияОбОкончанииВыполнения) = Тип("Структура") Тогда
		
		ПоказатьОповещениеПользователя(
			"Выполнена процедура восстановления последовательности",
			, "Восстановление последовательности завершено в фоновом задании " + Строка(ОповещенияОбОкончанииВыполнения.МоментОкончания)
			+ ?(ЗначениеЗаполнено(ОповещенияОбОкончанииВыполнения.ОписаниеОшибки), Символы.ПС + "Завершено с ошибками: " + ОповещенияОбОкончанииВыполнения.ОписаниеОшибки, ""),				
			БиблиотекаКартинок.ВыполнитьРегламентноеЗаданиеВручную);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ИдентификаторФоновогоЗадания) Тогда
		
		ПодключитьОбработчикОжидания(
			"СообщитьОбОкончанииВосстановленияПоследовательности", 2, Истина);	
		
	Иначе	
		ОбновитьЭлементыФормыНаСервере();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработчикОбновленияСостоянияПоследовательности()
	ОбновитьСостояниеПоследовательностиНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСостояниеПоследовательности(Команда)
	ОбновитьСостояниеПоследовательностиНаСервере();	
КонецПроцедуры

&НаКлиенте
Процедура ОтменитьВосстановление(Команда)	
	
	Если ЗначениеЗаполнено(ИдентификаторФоновогоЗадания) Тогда		
		ОтменитьВосстановлениеНаСервере(ИдентификаторФоновогоЗадания);
		ИдентификаторФоновогоЗадания = "";
			
		ПоказатьПредупреждение(,
				НСтр("ru = 'Задание отменено, но состояние отмены будет
				|установлено сервером только через секунды,
				|возможно потребуется обновить данные вручную.'"));
	Иначе
		ПоказатьОповещениеПользователя("Восстановление не запущено");
	КонецЕсли;
		
КонецПроцедуры

&НаСервере
Процедура ОтменитьВосстановлениеНаСервере(Знач ИдентификаторФЗ)
	
	РегламентныеЗаданияСлужебный.ОтменитьФоновоеЗадание(ИдентификаторФЗ);
		
КонецПроцедуры

#КонецОбласти
