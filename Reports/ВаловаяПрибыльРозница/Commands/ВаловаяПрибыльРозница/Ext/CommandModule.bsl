
&НаКлиенте
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)
	
	ПараметрыФормы = Новый Структура("КлючНазначенияИспользования, СформироватьПриОткрытии", "ВаловаяПрибыльРозница", Истина);
	
	ФормаОтчета	= ПолучитьФорму("Отчет.ВаловаяПрибыльРозница.Форма", 
	ПараметрыФормы, 
	ПараметрыВыполненияКоманды.Источник, 
	Новый УникальныйИдентификатор, //ПараметрыВыполненияКоманды.Уникальность, 
	ПараметрыВыполненияКоманды.Окно, 
	ПараметрыВыполненияКоманды.НавигационнаяСсылка);
	
	КомпоновщикНастроек = ФормаОтчета.Отчет.КомпоновщикНастроек;
	
	
	Если ПараметрКоманды <> Неопределено Тогда
		Если ПараметрКоманды.Количество() = 1 Тогда
			СЗ = ПараметрКоманды[0];
		Иначе
			СЗ = Новый СписокЗначений;
			СЗ.ЗагрузитьЗначения(ПараметрКоманды);
		КонецЕсли;
		
		// Снимаем флажки с пользовательских настроек
	    Настройки = ФормаОтчета.Отчет.КомпоновщикНастроек.ПользовательскиеНастройки;
	    Для каждого ТекНастройка Из Настройки.Элементы Цикл
			ТекНастройка.Использование = Ложь;
		КонецЦикла; 
		
		// Устанавливаем отбор по ЗаказДоговор 
		Настройки = КомпоновщикНастроек.Настройки.Отбор;
		Для каждого ТекОтбор Из Настройки.Элементы Цикл
			Элемент = ФормаОтчета.Отчет.КомпоновщикНастроек.ПользовательскиеНастройки.Элементы.Найти(ТекОтбор.ИдентификаторПользовательскойНастройки);
			Если Строка(ТекОтбор.ЛевоеЗначение) = "ЗаказДоговор" Тогда
				Если Элемент <> Неопределено Тогда
					Элемент.Использование = ЗначениеЗаполнено(СЗ);
					Элемент.ВидСравнения = ?(ТипЗнч(СЗ) = Тип("СписокЗначений"), ВидСравненияКомпоновкиДанных.ВСписке, ВидСравненияКомпоновкиДанных.Равно);
					Элемент.ПравоеЗначение = СЗ;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла; 
	КонецЕсли;
	
	ФормаОтчета.Открыть();
	
КонецПроцедуры



