		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ РАЗРЕШЕННЫЕ
	ЗакупкиОбороты.Номенклатура КАК Номенклатура,
	ЗакупкиОбороты.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	ЗакупкиОбороты.СерияНоменклатуры КАК СерияНоменклатуры,
	ЗакупкиОбороты.Организация КАК Организация,
	ЗакупкиОбороты.Контрагент КАК Контрагент,
	ВЫБОР
		КОГДА ЕСТЬNULL(ЗакупкиОбороты.КоличествоОборот, 0) = 0
			ТОГДА 0
		ИНАЧЕ ВЫРАЗИТЬ(ЗакупкиОбороты.СуммаОборот / ЗакупкиОбороты.КоличествоОборот КАК ЧИСЛО(15, 2))
	КОНЕЦ КАК ЦенаЗакупки
ПОМЕСТИТЬ ВТ_Закупки
ИЗ
	(ВЫБРАТЬ
		МАКСИМУМ(ЗакупкиОбороты.Регистратор) КАК Регистратор,
		ЗакупкиОбороты.Номенклатура КАК Номенклатура,
		ЗакупкиОбороты.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
		ЗакупкиОбороты.СерияНоменклатуры КАК СерияНоменклатуры,
		ЗакупкиОбороты.Организация КАК Организация,
		ЗакупкиОбороты.Контрагент КАК Контрагент
	ИЗ
		РегистрНакопления.Закупки.Обороты(&amp;НачалоВремен {(&amp;НачалоВремен)}, &amp;КонецПериода {(&amp;КонецПериода)}, Запись, ) КАК ЗакупкиОбороты
	ГДЕ
		ЗакупкиОбороты.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Справочник.ВидыНоменклатуры.Материал)
	
	СГРУППИРОВАТЬ ПО
		ЗакупкиОбороты.Номенклатура,
		ЗакупкиОбороты.ХарактеристикаНоменклатуры,
		ЗакупкиОбороты.СерияНоменклатуры,
		ЗакупкиОбороты.Организация,
		ЗакупкиОбороты.Контрагент) КАК ДокументыЗакупок
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.Закупки.Обороты(&amp;НачалоВремен {(&amp;НачалоВремен)}, &amp;КонецПериода {(&amp;КонецПериода)}, Запись, ) КАК ЗакупкиОбороты
		ПО (ЗакупкиОбороты.Регистратор = ДокументыЗакупок.Регистратор)
			И (ЗакупкиОбороты.Номенклатура = ДокументыЗакупок.Номенклатура)
			И (ЗакупкиОбороты.ХарактеристикаНоменклатуры = ДокументыЗакупок.ХарактеристикаНоменклатуры)
			И (ЗакупкиОбороты.СерияНоменклатуры = ДокументыЗакупок.СерияНоменклатуры)
			И (ЗакупкиОбороты.Организация = ДокументыЗакупок.Организация)
			И (ЗакупкиОбороты.Контрагент = ДокументыЗакупок.Контрагент)
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗРЕШЕННЫЕ
	ПродажиОбороты.Номенклатура.Поставщик КАК Контрагент,
	ПродажиОбороты.Номенклатура КАК Номенклатура,
	ПродажиОбороты.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	ПродажиОбороты.СерияНоменклатуры КАК СерияНоменклатуры,
	СУММА(ПродажиОбороты.КоличествоОборот) КАК Количество,
	СУММА(ПродажиОбороты.СуммаОборот) КАК Сумма,
	ВТ_Закупки.ЦенаЗакупки КАК ЦенаЗакупки,
	СУММА(ВТ_Закупки.ЦенаЗакупки * ПродажиОбороты.КоличествоОборот) КАК СуммаЗакупки
{ВЫБРАТЬ
	Контрагент.*,
	Номенклатура.*,
	ХарактеристикаНоменклатуры.*,
	СерияНоменклатуры.*,
	ЦенаЗакупки,
	Количество,
	Сумма,
	СуммаЗакупки}
ИЗ
	РегистрНакопления.Продажи.Обороты(&amp;НачалоПериода, &amp;КонецПериода, Запись, ) КАК ПродажиОбороты
		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Закупки КАК ВТ_Закупки
		ПО (ВТ_Закупки.Организация = ПродажиОбороты.Организация)
			И (ВТ_Закупки.Номенклатура = ПродажиОбороты.Номенклатура)
			И (ВТ_Закупки.ХарактеристикаНоменклатуры = ПродажиОбороты.ХарактеристикаНоменклатуры)
			И (ВТ_Закупки.СерияНоменклатуры = ПродажиОбороты.СерияНоменклатуры)
			И (ВТ_Закупки.Контрагент = ПродажиОбороты.Номенклатура.Поставщик)
ГДЕ
	ПродажиОбороты.Номенклатура.Поставщик = &amp;Поставщик

СГРУППИРОВАТЬ ПО
	ПродажиОбороты.Номенклатура,
	ПродажиОбороты.ХарактеристикаНоменклатуры,
	ПродажиОбороты.СерияНоменклатуры,
	ВТ_Закупки.ЦенаЗакупки,
	ПродажиОбороты.Номенклатура.Поставщик</query>
		<autoFillFields>false</autoFillFields>
	</dataSet>
