&НаСервереБезКонтекста
Функция ПолучитьОтчетРасшифровкуВидДохода(Документ, ВидДохода)
    Об = Документ.ПолучитьОбъект();   
	Данные = ИА_ФПСервер.СформироватьОтчетРасшифровкиВидаДохода(Об, ВидДохода, Истина);
    Возврат Данные;
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьОтчетРасшифровкуРаспределения(Документ, ВидДохода, Раздел, Подразделение, Статья)
	Если ЗначениеЗаполнено(Раздел) Тогда
	    КлючиПоиска = Новый Структура("Раздел, Подразделение, Статья, ВидДохода"
	    , Раздел, Подразделение, Статья, ВидДохода);
	Иначе
		КлючиПоиска = Новый Структура("Подразделение, Статья, ВидДохода"
	    , Подразделение, Статья, ВидДохода);
	КонецЕсли;
    
    Об = Документ.ПолучитьОбъект();   
	Данные = ИА_ФПСервер.СформироватьОтчетРасшифровкиПолитика(Об, КлючиПоиска,1);
    Возврат Данные;
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьДанныеРасшифровки(ДР, Расшифровка)
    ДанныеРасш = ПолучитьИзВременногоХранилища(ДР);
    Эл = ДанныеРасш.Элементы[Расшифровка];
	Результат = ИА_БФС.СКД_ПолучитьПоляРасшифровки(Эл);
    Возврат Результат;
КонецФункции
 
&НаКлиенте
Процедура РезультатОбработкаРасшифровки(Элемент, Расшифровка, СтандартнаяОбработка)
    Данные = ПолучитьДанныеРасшифровки(ДанныеРасшифровки, Расшифровка);
    Если Данные <> Неопределено Тогда
        
        __АктивноеПоле  = Данные["__АктивноеПоле"];
        Документ        = Данные["Документ"];
        ВидДохода       = Данные["ВидДохода"];
        Подразделение   = Данные["Подразделение"];
        Статья          = Данные["Статья"];
        Раздел          = Данные["Раздел"];
        
        Если     __АктивноеПоле = "ДоходСуммаНал" ИЛИ __АктивноеПоле = "ДоходСуммаБезнал" Тогда
        	// Расшифровка Вида дохода
            СтандартнаяОбработка = Ложь;
            
            Если ЗначениеЗаполнено(Документ) И ЗначениеЗаполнено(ВидДохода) Тогда
            	Данные = ПолучитьОтчетРасшифровкуВидДохода(Документ, ВидДохода);
                Если Данные.Сформирован Тогда
                    ИА_БФКС.ТабДок_Показать(Данные.ТабДок, Данные.Заголовок);
                Иначе
                    ИА_БФКС.СообщениеОбОшибке("Не удалось расшифровать по: " + ВидДохода); 
                КонецЕсли; 
            КонецЕсли;  
        ИначеЕсли __АктивноеПоле = "РаспределениеСуммаНал" ИЛИ __АктивноеПоле = "РаспределениеСуммаБезнал" Тогда
        	// Расшифровка Распределения
            СтандартнаяОбработка = Ложь;
            Данные = ПолучитьОтчетРасшифровкуРаспределения(Документ, ВидДохода, Раздел, Подразделение, Статья);
            Если Данные.Сформирован Тогда
                ИА_БФКС.ТабДок_Показать(Данные.ТабДок, Данные.Заголовок);
            Иначе
                ИА_БФКС.СообщениеОбОшибке("Не удалось расшифровать распределение!"); 
            КонецЕсли; 
        КонецЕсли; 
    КонецЕсли; 
КонецПроцедуры

