		<query>ВЫБРАТЬ РАЗРЕШЕННЫЕ
	Расход.Регистратор КАК Регистратор,
	Расход.Период КАК Период,
	//Расход.Регистратор.Дата КАК ДатаДокумента,
	Расход.Период КАК ДатаДокумента,
	Расход.Организация КАК Организация,
	Расход.Подразделение КАК Подразделение,
	Расход.НомерРасчета КАК НомерРасчета,
	Расход.Номенклатура КАК Номенклатура,
	Расход.СерияНоменклатуры КАК СерияНоменклатуры,
	Расход.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	Расход.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	
	ВЫБОР
		КОГДА Расход.Номенклатура = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПолотноЗаказчика)
			ТОГДА Расход.КоличествоОборот
	КОНЕЦ КАК КоличествоМатериалЗаказчика,
	
	ВЫБОР
		КОГДА (Расход.Номенклатура = ЗНАЧЕНИЕ(Справочник.Номенклатура.ОстаткиПленки)
				//#13763
				ИЛИ Расход.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Справочник.ВидыНоменклатуры.ОстатокПленки))
			ТОГДА Расход.КоличествоОборот
	КОНЕЦ КАК КоличествоОстаток,
	                                                
	ВЫБОР
		КОГДА Расход.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Справочник.ВидыНоменклатуры.Полотно)
				И НЕ Расход.Номенклатура = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПолотноЗаказчика)
				И НЕ Расход.Номенклатура = ЗНАЧЕНИЕ(Справочник.Номенклатура.ОстаткиПленки)
			//#13763
			//ТОГДА Расход.КоличествоОборот
			ТОГДА Расход.КоличествоВБазовыхЕдиницахОборот
	КОНЕЦ КАК КоличествоПолотно,
	
	ВЫРАЗИТЬ(ВЫБОР
			КОГДА Расход.ЕдиницаИзмерения ССЫЛКА Справочник.ЕдиницыИзмерений
				ТОГДА ЕСТЬNULL(Расход.ЕдиницаИзмерения.Коэффициент * Расход.КоличествоОборот, 0)
			ИНАЧЕ ЕСТЬNULL(Расход.КоличествоОборот, 0)
		КОНЕЦ КАК ЧИСЛО(15, 2)) КАК Площадь,
		
	Расход.Склад КАК СкладМатериалов
ИЗ
	РегистрНакопления.РасходМатериаловНаПроизводстве.Обороты(
			,
			,
			Регистратор,
			(Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Справочник.ВидыНоменклатуры.Полотно)
					И НЕ Номенклатура = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПолотноЗаказчика)
					И НЕ Номенклатура = ЗНАЧЕНИЕ(Справочник.Номенклатура.ОстаткиПленки))
				ИЛИ Номенклатура = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПолотноЗаказчика)
				ИЛИ (Номенклатура = ЗНАЧЕНИЕ(Справочник.Номенклатура.ОстаткиПленки)
				      //#13763
				      ИЛИ Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Справочник.ВидыНоменклатуры.ОстатокПленки))
			) КАК Расход
			
		//ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ВидыНоменклатуры КАК ВидыНоменклатуры
		//ПО (ВидыНоменклатуры.Ссылка = Расход.Номенклатура.ВидНоменклатуры)

УПОРЯДОЧИТЬ ПО
	ДатаДокумента</query>
