//	РасчетыСПерсоналомОстаткиИОбороты.ПериодМесяц КАК ПериодМесяц,
//	РасчетыСПерсоналомОстаткиИОбороты.ПериодКвартал КАК ПериодКвартал,
//	РасчетыСПерсоналомОстаткиИОбороты.ПериодПолугодие КАК ПериодПолугодие,
//	РасчетыСПерсоналомОстаткиИОбороты.ПериодГод КАК ПериодГод,
//	РасчетыСПерсоналомОстаткиИОбороты.Организация КАК Организация,
//	РасчетыСПерсоналомОстаткиИОбороты.Сотрудник КАК Сотрудник,
//	РасчетыСПерсоналомОстаткиИОбороты.СуммаНачальныйОстаток КАК НачальныйДолгПередСотрудником,
//	РасчетыСПерсоналомОстаткиИОбороты.СуммаКонечныйОстаток КАК КонечныйДолгПередСотрудником,
//	РасчетыСПерсоналомОстаткиИОбороты.СуммаОборот КАК СуммаОборот,
//	РасчетыСПерсоналомОстаткиИОбороты.СуммаПриход КАК Начисление,
//	РасчетыСПерсоналомОстаткиИОбороты.СуммаРасход КАК Выплата
//ИЗ
//	РегистрНакопления.РасчетыСПерсоналом.ОстаткиИОбороты({(&amp;НачалоПериодаРег)}, {(&amp;КонецПериодаРег)}, Авто, , ) КАК РасчетыСПерсоналомОстаткиИОбороты
//{ГДЕ
//	(РасчетыСПерсоналомОстаткиИОбороты.ПериодРегистрации &gt;= &amp;НачалоПериодаПР),
//	(РасчетыСПерсоналомОстаткиИОбороты.ПериодРегистрации &lt;= &amp;КонецПериодаПР)}
//-- №13259 прежняя версия

//++ №13259 новая версия
ВЫБРАТЬ РАЗРЕШЕННЫЕ
	РасчетыСПерсоналомОстатки.Организация КАК Организация,
	РасчетыСПерсоналомОстатки.Сотрудник КАК Сотрудник,
	СУММА(РасчетыСПерсоналомОстатки.СуммаОстаток) КАК СуммаОстаток
ПОМЕСТИТЬ ВТ_ОстатокПоПериодуРегистрации
ИЗ
	РегистрНакопления.РасчетыСПерсоналом.Остатки(, {(ПериодРегистрации &lt; &amp;НачалоПериодаРегистрации)}) КАК РасчетыСПерсоналомОстатки
ГДЕ
	&amp;ПолучитьОстатокПоПериодуРегистрации = ИСТИНА
	
СГРУППИРОВАТЬ ПО
	РасчетыСПерсоналомОстатки.Организация,
	РасчетыСПерсоналомОстатки.Сотрудник
	
;
/////////////////////////////////////
ВЫБРАТЬ РАЗРЕШЕННЫЕ
	РасчетыСПерсоналомОстаткиИОбороты.Регистратор КАК Регистратор,
	РасчетыСПерсоналомОстаткиИОбороты.ПериодРегистрации КАК ПериодРегистрации,
	РасчетыСПерсоналомОстаткиИОбороты.ПериодСекунда КАК ПериодСекунда,
	ЕСТЬNULL(РасчетыСПерсоналомОстаткиИОбороты.Организация, ОстатокПоПериодуРегистрации.Организация) КАК Организация,
	ЕСТЬNULL(РасчетыСПерсоналомОстаткиИОбороты.Сотрудник, ОстатокПоПериодуРегистрации.Сотрудник) КАК Сотрудник,
	ЕСТЬNULL(РасчетыСПерсоналомОстаткиИОбороты.СуммаНачальныйОстаток, 0) + ЕСТЬNULL(ОстатокПоПериодуРегистрации.СуммаОстаток, 0) КАК НачальныйДолгПередСотрудником,
	ЕСТЬNULL(РасчетыСПерсоналомОстаткиИОбороты.СуммаКонечныйОстаток, 0) + ЕСТЬNULL(ОстатокПоПериодуРегистрации.СуммаОстаток, 0) КАК КонечныйДолгПередСотрудником,
	ЕСТЬNULL(РасчетыСПерсоналомОстаткиИОбороты.СуммаОборот, 0) КАК СуммаОборот,
	ЕСТЬNULL(РасчетыСПерсоналомОстаткиИОбороты.СуммаПриход, 0) КАК Начисление,
	ЕСТЬNULL(РасчетыСПерсоналомОстаткиИОбороты.СуммаРасход, 0) КАК Выплата
ИЗ
	РегистрНакопления.РасчетыСПерсоналом.ОстаткиИОбороты({(&amp;НачалоПериодаСтандартное)}, {(&amp;КонецПериодаСтандартное)}, Авто, ДвиженияИГраницыПериода, {(ПериодРегистрации &gt;= &amp;НачалоПериодаРегистрации), (ПериодРегистрации &lt;= &amp;КонецПериодаРегистрации)}) КАК РасчетыСПерсоналомОстаткиИОбороты
	
		ПОЛНОЕ СОЕДИНЕНИЕ ВТ_ОстатокПоПериодуРегистрации КАК ОстатокПоПериодуРегистрации
