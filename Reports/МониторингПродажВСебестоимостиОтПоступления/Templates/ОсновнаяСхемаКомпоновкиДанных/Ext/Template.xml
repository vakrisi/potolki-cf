<?xml version="1.0" encoding="UTF-8"?>
<DataCompositionSchema xmlns="http://v8.1c.ru/8.1/data-composition-system/schema" xmlns:dcscom="http://v8.1c.ru/8.1/data-composition-system/common" xmlns:dcscor="http://v8.1c.ru/8.1/data-composition-system/core" xmlns:dcsset="http://v8.1c.ru/8.1/data-composition-system/settings" xmlns:v8="http://v8.1c.ru/8.1/data/core" xmlns:v8ui="http://v8.1c.ru/8.1/data/ui" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<dataSource>
		<name>ИсточникДанных1</name>
		<dataSourceType>Local</dataSourceType>
	</dataSource>
	<dataSet xsi:type="DataSetQuery">
		<name>НаборДанных1</name>
		<field xsi:type="DataSetFieldField">
			<dataPath>Организация</dataPath>
			<field>Организация</field>
			<role>
				<dcscom:dimension>true</dcscom:dimension>
			</role>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Контрагент</dataPath>
			<field>Контрагент</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Склад</dataPath>
			<field>Склад</field>
			<role>
				<dcscom:dimension>true</dcscom:dimension>
			</role>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>УДАЛИТЬ_ЗаказНаПроизводство</dataPath>
			<field>УДАЛИТЬ_ЗаказНаПроизводство</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Номенклатура</dataPath>
			<field>Номенклатура</field>
			<role>
				<dcscom:dimension>true</dcscom:dimension>
			</role>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Подразделение</dataPath>
			<field>Подразделение</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ЕдиницаИзмерения</dataPath>
			<field>ЕдиницаИзмерения</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ХарактеристикаНоменклатуры</dataPath>
			<field>ХарактеристикаНоменклатуры</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>СерияНоменклатуры</dataPath>
			<field>СерияНоменклатуры</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ДокументПродажи</dataPath>
			<field>ДокументПродажи</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ДоговорКонтрагента</dataPath>
			<field>ДоговорКонтрагента</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ДисконтнаяКарта</dataPath>
			<field>ДисконтнаяКарта</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ЗаказПокупателя</dataPath>
			<field>ЗаказПокупателя</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ПодразделениеЗаказа</dataPath>
			<field>ПодразделениеЗаказа</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Количество</dataPath>
			<field>Количество</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Количество</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ДатаЗаказа</dataPath>
			<field>ДатаЗаказа</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Дата заказа</v8:content>
				</v8:item>
			</title>
			<appearance>
				<dcscor:item xsi:type="dcsset:SettingsParameterValue">
					<dcscor:parameter>Формат</dcscor:parameter>
					<dcscor:value xsi:type="v8:LocalStringType">
						<v8:item>
							<v8:lang>ru</v8:lang>
							<v8:content>ДФ=dd.MM.yyyy</v8:content>
						</v8:item>
					</dcscor:value>
				</dcscor:item>
			</appearance>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ДатаПоступления</dataPath>
			<field>ДатаПоступления</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Дата поступления</v8:content>
				</v8:item>
			</title>
			<appearance>
				<dcscor:item xsi:type="dcsset:SettingsParameterValue">
					<dcscor:parameter>Формат</dcscor:parameter>
					<dcscor:value xsi:type="v8:LocalStringType">
						<v8:item>
							<v8:lang>ru</v8:lang>
							<v8:content>ДФ=dd.MM.yyyy</v8:content>
						</v8:item>
					</dcscor:value>
				</dcscor:item>
			</appearance>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Поставщик</dataPath>
			<field>Поставщик</field>
			<role>
				<dcscom:dimension>true</dcscom:dimension>
				<dcscom:parentDimension>Номенклатура</dcscom:parentDimension>
			</role>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Регистратор</dataPath>
			<field>Регистратор</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Себестоимость</dataPath>
			<field>Себестоимость</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Себестоимость</v8:content>
				</v8:item>
			</title>
			<appearance>
				<dcscor:item xsi:type="dcsset:SettingsParameterValue">
					<dcscor:parameter>Формат</dcscor:parameter>
					<dcscor:value xsi:type="v8:LocalStringType">
						<v8:item>
							<v8:lang>ru</v8:lang>
							<v8:content>ЧДЦ=2</v8:content>
						</v8:item>
					</dcscor:value>
				</dcscor:item>
			</appearance>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>РегистраторЗаказ</dataPath>
			<field>РегистраторЗаказ</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Регистратор заказ</v8:content>
				</v8:item>
			</title>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ РАЗРЕШЕННЫЕ
	Организации.Ссылка КАК Организация,
	Номенклатура.Поставщик КАК Поставщик,
	Номенклатура.Ссылка КАК Номенклатура,
	Номенклатура.БазоваяЕдиницаИзмерения КАК БазоваяЕдиницаИзмерения,
	Номенклатура.АльтернативнаяЕдиницаИзмерения КАК АльтернативнаяЕдиницаИзмерения
ПОМЕСТИТЬ ВТ_Номенклатура
ИЗ
	Справочник.Номенклатура КАК Номенклатура,
	Справочник.Организации КАК Организации
ГДЕ
	Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Справочник.ВидыНоменклатуры.Материал)
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗРЕШЕННЫЕ
	ПродажиОбороты.Организация КАК Организация,
	ПродажиОбороты.Склад КАК Склад,
	ПродажиОбороты.Номенклатура.Поставщик КАК Поставщик,
	ПродажиОбороты.Номенклатура КАК Номенклатура,
	ПродажиОбороты.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	ПродажиОбороты.КоличествоОборот КАК Количество,
	ПродажиОбороты.Период КАК Период
ПОМЕСТИТЬ ВТ_Продажи
ИЗ
	РегистрНакопления.Продажи.Обороты(, , Запись, Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Справочник.ВидыНоменклатуры.Материал)) КАК ПродажиОбороты

СГРУППИРОВАТЬ ПО
	ПродажиОбороты.Номенклатура,
	ПродажиОбороты.Номенклатура.Поставщик,
	ПродажиОбороты.Склад,
	ПродажиОбороты.Организация,
	ПродажиОбороты.Период,
	ПродажиОбороты.ЕдиницаИзмерения,
	ПродажиОбороты.КоличествоОборот
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗРЕШЕННЫЕ
	ЗаказПоставщикуТовары.Ссылка.Организация КАК Организация,
	ЗаказПоставщикуТовары.Номенклатура КАК Номенклатура,
	МАКСИМУМ(ЗаказПоставщикуТовары.Ссылка.Дата) КАК Дата
ПОМЕСТИТЬ ВТ_ЗаказыПоставщикам
ИЗ
	Документ.ЗаказПоставщику.Товары КАК ЗаказПоставщикуТовары

СГРУППИРОВАТЬ ПО
	ЗаказПоставщикуТовары.Номенклатура,
	ЗаказПоставщикуТовары.Ссылка.Организация
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗРЕШЕННЫЕ
	ЗаказПоставщикуТовары.Ссылка.Организация КАК Организация,
	ЗаказПоставщикуТовары.Номенклатура КАК Номенклатура,
	ЗаказПоставщикуТовары.Ссылка.Дата КАК Дата,
	ЗаказПоставщикуТовары.Ссылка КАК РегистраторЗаказ
ПОМЕСТИТЬ ВТ_ЗаказыПоставщикамРегистратор
ИЗ
	Документ.ЗаказПоставщику.Товары КАК ЗаказПоставщикуТовары

СГРУППИРОВАТЬ ПО
	ЗаказПоставщикуТовары.Ссылка.Организация,
	ЗаказПоставщикуТовары.Номенклатура,
	ЗаказПоставщикуТовары.Ссылка.Дата,
	ЗаказПоставщикуТовары.Ссылка
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗРЕШЕННЫЕ
	ТоварыНаСкладахОбороты.Организация КАК Организация,
	ТоварыНаСкладахОбороты.Номенклатура КАК Номенклатура,
	МАКСИМУМ(ТоварыНаСкладахОбороты.Регистратор.Дата) КАК Дата,
	МАКСИМУМ(ВЫБОР
			КОГДА ТоварыНаСкладахОбороты.КоличествоПриход = 0
					ИЛИ ЕСТЬNULL(ТоварыНаСкладахОбороты.КоличествоПриход, 0) = 0
				ТОГДА 0
			ИНАЧЕ ТоварыНаСкладахОбороты.СуммаПриход / ТоварыНаСкладахОбороты.КоличествоПриход
		КОНЕЦ) КАК СебестоимостьБазовойЕдиницы
ПОМЕСТИТЬ ВТ_ПоступлениеТоваров
ИЗ
	РегистрНакопления.ТоварыНаСкладах.Обороты(, , Запись, ) КАК ТоварыНаСкладахОбороты
ГДЕ
	ТоварыНаСкладахОбороты.Регистратор ССЫЛКА Документ.ПоступлениеТоваровИУслуг

СГРУППИРОВАТЬ ПО
	ТоварыНаСкладахОбороты.Организация,
	ТоварыНаСкладахОбороты.Номенклатура
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗРЕШЕННЫЕ
	ТоварыНаСкладахОбороты.Организация КАК Организация,
	ТоварыНаСкладахОбороты.Номенклатура КАК Номенклатура,
	ТоварыНаСкладахОбороты.Регистратор.Дата КАК Дата,
	ТоварыНаСкладахОбороты.Регистратор КАК Регистратор
ПОМЕСТИТЬ ВТ_ПоступлениеТоваровРегистраторы
ИЗ
	РегистрНакопления.ТоварыНаСкладах.Обороты(, , Запись, ) КАК ТоварыНаСкладахОбороты

СГРУППИРОВАТЬ ПО
	ТоварыНаСкладахОбороты.Организация,
	ТоварыНаСкладахОбороты.Номенклатура,
	ТоварыНаСкладахОбороты.Регистратор.Дата,
	ТоварыНаСкладахОбороты.Регистратор
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗРЕШЕННЫЕ
	ВТ_Номенклатура.Организация КАК Организация,
	ВТ_Номенклатура.Номенклатура КАК Номенклатура,
	ВТ_Продажи.Склад КАК Склад,
	ВЫБОР
		КОГДА &amp;ВАльтернативныхЕдиницахИзмемрения
			ТОГДА ВТ_Номенклатура.АльтернативнаяЕдиницаИзмерения
		ИНАЧЕ ВТ_Номенклатура.БазоваяЕдиницаИзмерения
	КОНЕЦ КАК ЕдиницаИзмерения,
	ВТ_ЗаказыПоставщикам.Дата КАК ДатаЗаказа,
	ВТ_ПоступлениеТоваров.Дата КАК ДатаПоступления,
	СУММА(ВЫБОР
			КОГДА &amp;ВАльтернативныхЕдиницахИзмемрения
				ТОГДА ВЫБОР
						КОГДА ВТ_Продажи.ЕдиницаИзмерения = ВТ_Номенклатура.АльтернативнаяЕдиницаИзмерения
							ТОГДА 1
						ИНАЧЕ 1 / ВЫБОР
								КОГДА ЕСТЬNULL(ВТ_Номенклатура.АльтернативнаяЕдиницаИзмерения.Коэффициент, 0) = 0
									ТОГДА 1
								ИНАЧЕ ЕСТЬNULL(ВТ_Номенклатура.АльтернативнаяЕдиницаИзмерения.Коэффициент, 0)
							КОНЕЦ
					КОНЕЦ
			ИНАЧЕ ВЫБОР
					КОГДА ВТ_Продажи.ЕдиницаИзмерения = ВТ_Номенклатура.АльтернативнаяЕдиницаИзмерения
						ТОГДА 1 / ВЫБОР
								КОГДА ЕСТЬNULL(ВТ_Номенклатура.АльтернативнаяЕдиницаИзмерения.Коэффициент, 0) = 0
									ТОГДА 1
								ИНАЧЕ ЕСТЬNULL(ВТ_Номенклатура.АльтернативнаяЕдиницаИзмерения.Коэффициент, 0)
							КОНЕЦ
					ИНАЧЕ 1
				КОНЕЦ
		КОНЕЦ * ВТ_Продажи.Количество) КАК Количество,
	ВТ_Номенклатура.Поставщик КАК Поставщик,
	СУММА(ВТ_ПоступлениеТоваров.СебестоимостьБазовойЕдиницы * ВЫБОР
			КОГДА ВТ_Продажи.ЕдиницаИзмерения = ВТ_Номенклатура.АльтернативнаяЕдиницаИзмерения
				ТОГДА 1 / ВЫБОР
						КОГДА ЕСТЬNULL(ВТ_Номенклатура.АльтернативнаяЕдиницаИзмерения.Коэффициент, 0) = 0
							ТОГДА 1
						ИНАЧЕ ЕСТЬNULL(ВТ_Номенклатура.АльтернативнаяЕдиницаИзмерения.Коэффициент, 0)
					КОНЕЦ
			ИНАЧЕ 1
		КОНЕЦ * ВТ_Продажи.Количество) КАК Себестоимость,
	ВТ_ПоступлениеТоваровРегистраторы.Регистратор КАК Регистратор,
	ВТ_ЗаказыПоставщикамРегистратор.РегистраторЗаказ КАК РегистраторЗаказ
ИЗ
	ВТ_Номенклатура КАК ВТ_Номенклатура
		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ЗаказыПоставщикам КАК ВТ_ЗаказыПоставщикам
			ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ЗаказыПоставщикамРегистратор КАК ВТ_ЗаказыПоставщикамРегистратор
			ПО ВТ_ЗаказыПоставщикам.Организация = ВТ_ЗаказыПоставщикамРегистратор.Организация
				И ВТ_ЗаказыПоставщикам.Номенклатура = ВТ_ЗаказыПоставщикамРегистратор.Номенклатура
				И ВТ_ЗаказыПоставщикам.Дата = ВТ_ЗаказыПоставщикамРегистратор.Дата
		ПО ВТ_Номенклатура.Номенклатура = ВТ_ЗаказыПоставщикам.Номенклатура
			И ВТ_Номенклатура.Организация = ВТ_ЗаказыПоставщикам.Организация
		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ПоступлениеТоваров КАК ВТ_ПоступлениеТоваров
			ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ПоступлениеТоваровРегистраторы КАК ВТ_ПоступлениеТоваровРегистраторы
			ПО ВТ_ПоступлениеТоваров.Организация = ВТ_ПоступлениеТоваровРегистраторы.Организация
				И ВТ_ПоступлениеТоваров.Номенклатура = ВТ_ПоступлениеТоваровРегистраторы.Номенклатура
				И ВТ_ПоступлениеТоваров.Дата = ВТ_ПоступлениеТоваровРегистраторы.Дата
		ПО ВТ_Номенклатура.Организация = ВТ_ПоступлениеТоваров.Организация
			И ВТ_Номенклатура.Номенклатура = ВТ_ПоступлениеТоваров.Номенклатура
		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Продажи КАК ВТ_Продажи
		ПО ВТ_Номенклатура.Номенклатура = ВТ_Продажи.Номенклатура
			И ВТ_Номенклатура.Поставщик = ВТ_Продажи.Поставщик
			И ВТ_Номенклатура.Организация = ВТ_Продажи.Организация
			И (ВТ_ПоступлениеТоваров.Дата &lt;= ВТ_Продажи.Период)

СГРУППИРОВАТЬ ПО
	ВТ_Номенклатура.Организация,
	ВТ_Номенклатура.Номенклатура,
	ВТ_Продажи.Склад,
	ВЫБОР
		КОГДА &amp;ВАльтернативныхЕдиницахИзмемрения
			ТОГДА ВТ_Номенклатура.АльтернативнаяЕдиницаИзмерения
		ИНАЧЕ ВТ_Номенклатура.БазоваяЕдиницаИзмерения
	КОНЕЦ,
	ВТ_ЗаказыПоставщикам.Дата,
	ВТ_ПоступлениеТоваров.Дата,
	ВТ_Номенклатура.Поставщик,
	ВТ_ПоступлениеТоваровРегистраторы.Регистратор,
	ВТ_ЗаказыПоставщикамРегистратор.РегистраторЗаказ</query>
	</dataSet>
	<calculatedField>
		<dataPath>СебестоимостьЕдиницы</dataPath>
		<expression>ВЫБОР КОГДА Количество = 0 ТОГДА 0 ИНАЧЕ Себестоимость/Количество КОНЕЦ</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Себестоимость единицы</v8:content>
			</v8:item>
		</title>
	</calculatedField>
	<calculatedField>
		<dataPath>ПрошлоДней</dataPath>
		<expression>РАЗНОСТЬДАТ(ДатаПоступления, &amp;ТекущаяДата, "ДЕНЬ")</expression>
		<title xsi:type="v8:LocalStringType">
