Процедура РезультатПланировщикВыбор(Элемент, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	Если Не Элементы.РезультатПланировщик.ВыделенныеЭлементы.Количество() Тогда
		Возврат;
	КонецЕсли;
	
	ВыделенныйЭлемент = Элементы.РезультатПланировщик.ВыделенныеЭлементы[0];
	ДокументРегистратор = ВыделенныйЭлемент.Значение.Регистратор;
		
	Если Не ЗначениеЗаполнено(ДокументРегистратор) Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Ключ", ДокументРегистратор);
	
	//Если ТипЗнч(ДокументРегистратор) = Тип("ДокументСсылка.Замер") Тогда
	//	ОткрытьФорму("Документ.Замер.ФормаОбъекта", ПараметрыФормы);
	//Иначе
	Если ТипЗнч(ДокументРегистратор) = Тип("ДокументСсылка.Лид") Тогда
		ОткрытьФорму("Документ.Лид.ФормаОбъекта", ПараметрыФормы);
	КонецЕсли;
	
