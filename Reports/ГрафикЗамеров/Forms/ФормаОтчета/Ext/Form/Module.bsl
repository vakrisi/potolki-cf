&НаКлиенте
Процедура РезультатТаблицаНачалоПеретаскивания(Элемент, ПараметрыПеретаскивания, Выполнение)
	
	СтароеЗначение = ПараметрыПеретаскивания.Значение.ТекущаяОбласть.Расшифровка;
	Если СтароеЗначение = Неопределено Тогда
		Выполнение = Ложь;
	Иначе
		Если НЕ СтароеЗначение.Свойство("МассивДокументов") Тогда
			Выполнение = Ложь;
		КонецЕсли;
	КонецЕсли;
	
