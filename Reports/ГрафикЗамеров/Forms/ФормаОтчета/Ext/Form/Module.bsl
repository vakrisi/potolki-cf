&НаСервере
Функция ПроверитьСвободныйИнтервалЗамеров(Знач ПараметрыНовогоЗамера)
	
	Если НЕ ПараметрыНовогоЗамера.Свойство("ИдЗамера") Тогда
		ПараметрыНовогоЗамера.Вставить("ИдЗамера", "");
	КонецЕсли;
	Если НЕ ПараметрыНовогоЗамера.Свойство("ИдЗамера") Тогда
		ПараметрыНовогоЗамера.Вставить("ИдЗамера", "");
	КонецЕсли;
	Если НЕ ПараметрыНовогоЗамера.Свойство("ИсполнительЗамера") И ПараметрыНовогоЗамера.Свойство("Исполнитель") Тогда
		ПараметрыНовогоЗамера.Вставить("ИсполнительЗамера", ПараметрыНовогоЗамера.Исполнитель);
	КонецЕсли;
	Если НЕ ПараметрыНовогоЗамера.Свойство("ДатаЗамера") И ПараметрыНовогоЗамера.Свойство("Дата") Тогда
		ПараметрыНовогоЗамера.Вставить("ДатаЗамера", ПараметрыНовогоЗамера.Дата);
	КонецЕсли;
	Если НЕ ПараметрыНовогоЗамера.Свойство("ВремяНачала") И ПараметрыНовогоЗамера.Свойство("ВремяНачалаЗамера") Тогда
		ПараметрыНовогоЗамера.Вставить("ВремяНачала", ПараметрыНовогоЗамера.ВремяНачалаЗамера);
	КонецЕсли;
	Если НЕ ПараметрыНовогоЗамера.Свойство("ВремяОкончания") И ПараметрыНовогоЗамера.Свойство("ВремяОкончанияЗамера") Тогда
		ПараметрыНовогоЗамера.Вставить("ВремяОкончания", ПараметрыНовогоЗамера.ВремяОкончанияЗамера);
	КонецЕсли;
	Возврат МодульОтчетов.ПроверитьСвободныйИнтервалЗамеров(ПараметрыНовогоЗамера, ФильтрТочкаПродаж);
	
	//Если ТипЗнч(ПараметрыНовогоЗамера.ИсполнительЗамера) = Тип("СправочникСсылка.Сотрудники") Тогда
	//	Если НЕ ПараметрыНовогоЗамера.ИсполнительЗамера.НеПроверятьПересечениеЗамеровВГрафике 
	//		И НЕ ОбщийМодуль.ПроверитьСвободныйИнтервалЗамеров(ПараметрыНовогоЗамера.ДатаЗамера, ПараметрыНовогоЗамера.ИсполнительЗамера, ПараметрыНовогоЗамера.ВремяНачалаЗамера, ПараметрыНовогоЗамера.ВремяОкончанияЗамера, Лид) Тогда
	//		Возврат Ложь;
	//	КонецЕсли;
	//КонецЕсли;
	//
	//Если ПолучитьФункциональнуюОпцию("ИспользоватьПулЗамеров") 
	//	И (ТипЗнч(ПараметрыНовогоЗамера.ИсполнительЗамера) = Тип("Строка") // строка вида "ПланируемыйХХХ"
	//	ИЛИ Вариант = 3 ИЛИ Вариант = 4 
