Процедура РезультатПланировщикПередСозданием(Элемент, Начало, Конец, Значения, Текст, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	
	ПараметрыОснования = Новый Структура;
	ПараметрыОснования.Вставить("ДатаЗамера", 			НачалоДня(Начало));
	ПараметрыОснования.Вставить("ВремяНачалаЗамера", 	Дата("00010101") + (Начало - НачалоДня(Начало)));
	ПараметрыОснования.Вставить("ВремяОкончанияЗамера", Дата("00010101") + (Конец - НачалоДня(Конец)));
	ПараметрыОснования.Вставить("ИсполнительЗамера", 	Значения.Получить("Сотрудник"));
 	ОткрытьФормуНовогоЛида(ПараметрыОснования);
	
КонецПроцедуры

&НаКлиенте
Процедура РезультатПланировщикПриОкончанииРедактирования(Элемент, НовыйЭлемент, ОтменаРедактирования)
	
	Если Элемент.ВыделенныеЭлементы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура;
	ЭлементЗамера = Элемент.ВыделенныеЭлементы[0];
	
	// в графике по пулу - перенос замеров, назначенных на реальных замерщиков
	ТекстВопросаДополнение = "";
	НовыйИсполнительЗамера = ЭлементЗамера.ЗначенияИзмерений["Сотрудник"];
	Если (Вариант = 3 ИЛИ Вариант = 4) И ЭлементЗамера.Значение.НазначенНаЗамерщика И НЕ РазрешеноРаспределениеПулаЗамеровНаЗамерщиков Тогда
		ТекстВопросаДополнение = "Исполнитель замера будет сброшен. ";
		НовыйИсполнительЗамера = ПредопределенноеЗначение("Справочник.Сотрудники.ПустаяСсылка");
	//	ОтменаРедактирования = Истина;
	//	Возврат;
	КонецЕсли;
	// запрещаем перенос невыходов
	Если ТипЗнч(ЭлементЗамера.Значение.Регистратор) = Тип("ДокументСсылка.УДАЛИТЬ_Невыходы") 
		ИЛИ ТипЗнч(ЭлементЗамера.Значение.Регистратор) = Тип("ДокументСсылка.ГрафикРаботыЗамерщиков") Тогда
		ОтменаРедактирования = Истина;
		Возврат;
	КонецЕсли;
	// запрещаем перенос выполненных замеров/выездов
	Если ЭлементЗамера.Значение.Выполнен Тогда
		ОтменаРедактирования = Истина;
		Возврат;
	КонецЕсли;
	
	ЭтоВыезд = ЭлементЗамера.Значение.ЭтоВыезд;
	ДополнительныеПараметры.Вставить("Начало", ЭлементЗамера.Начало);
	ДополнительныеПараметры.Вставить("Конец",  ЭлементЗамера.Конец);
	ДополнительныеПараметры.Вставить("Регистратор", ЭлементЗамера.Значение.Регистратор);
	ДополнительныеПараметры.Вставить("ИДЗамера",	ЭлементЗамера.Значение.ИДЗамера);
	ДополнительныеПараметры.Вставить("ЭтоВыезд", 	ЭтоВыезд);	
	ДополнительныеПараметры.Вставить("Сотрудник", 	НовыйИсполнительЗамера);
	
	ПослеСдвигаЗамера = Новый ОписаниеОповещения("ПослеСдвигаЗамера", ЭтаФорма, ДополнительныеПараметры);
	ПоказатьВопрос(ПослеСдвигаЗамера, ТекстВопросаДополнение + "Сохранить изменения " + ?(НЕ ЭтоВыезд, "замера", "выезда") + "?", РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеСдвигаЗамера(Результат, ДополнительныеПараметры) Экспорт
	
	ОчиститьСообщения();
	Если Результат = КодВозвратаДиалога.Нет Тогда
		//отказались от сохранения результата. Перестроим отчет
        Сформировать(Неопределено);
		Возврат;
	КонецЕсли;
	
	Если ПослеСдвигаЗамераНаСервере(ДополнительныеПараметры) Тогда
		// #12209
		РаботаССМСКлиент.ПослеЗаписиЛида(ДополнительныеПараметры.Регистратор);		
	КонецЕсли;
	Сформировать(Неопределено);
	
	//++ №12180 заглушка для платформы 8.3.18.1208, чтобы после переноса, фокус скидывался
	Для Каждого ТекЭлемент Из РезультатПланировщик.Элементы Цикл
		ЦветФонаБыл = ТекЭлемент.ЦветФона;
		ТекЭлемент.ЦветФона = WebЦвета.Белоснежный;
		ТекЭлемент.ЦветФона = ЦветФонаБыл;
	КонецЦикла;
	//-- №12180

КонецПроцедуры

&НаСервере
Функция ПослеСдвигаЗамераНаСервере(ПараметрыЗамера)
	
	ЛидСсылка = ПараметрыЗамера.Регистратор;
	Если ТипЗнч(ЛидСсылка) <> Тип("ДокументСсылка.Лид") Тогда
		Возврат Ложь;
	КонецЕсли;

	Если НЕ ПараметрыЗамера.ЭтоВыезд Тогда
		НайденныеСтроки = ЛидСсылка.Замеры.НайтиСтроки(Новый Структура("ИДЗамера", ПараметрыЗамера.ИДЗамера));
		Если НайденныеСтроки.Количество() > 0 Тогда
			ДанныеЗамера = НайденныеСтроки[0];
			Если ДанныеЗамера.ДатаЗамера + (ДанныеЗамера.ВремяНачалаЗамера - Дата(1, 1, 1)) = ПараметрыЗамера.Начало
				И ДанныеЗамера.ДатаЗамера + (ДанныеЗамера.ВремяОкончанияЗамера - Дата(1, 1, 1)) = ПараметрыЗамера.Конец
				И (ДанныеЗамера.ИсполнительЗамера = ПараметрыЗамера.Сотрудник
			   		ИЛИ (ДанныеЗамера.ИсполнительЗамера = Справочники.Сотрудники.ПустаяСсылка() //#6384
			        	И ТипЗнч(ПараметрыЗамера.Сотрудник) = Тип("Строка")))
			Тогда
				//ничего не поменялось в замере
				Возврат Ложь;
			КонецЕсли;
		Иначе
			Возврат Ложь;
		КонецЕсли;
		
	Иначе
		НайденныеСтроки = ЛидСсылка.Выезды.НайтиСтроки(Новый Структура("ИДЗамера", ПараметрыЗамера.ИДЗамера));
		Если НайденныеСтроки.Количество() > 0 Тогда
			ДанныеВыезда = НайденныеСтроки[0];
			Если (ДанныеВыезда.Дата + (ДанныеВыезда.ВремяНачала - Дата(1, 1, 1))) = ПараметрыЗамера.Начало
				И (ДанныеВыезда.Дата + (ДанныеВыезда.ВремяОкончания - Дата(1, 1, 1))) = ПараметрыЗамера.Конец
				И (ДанныеВыезда.Исполнитель = ПараметрыЗамера.Сотрудник
