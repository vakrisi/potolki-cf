	Расшифровка = Область.Расшифровка;
	Если ТипЗнч(Расшифровка) = Тип("Структура") Тогда
		СтандартнаяОбработка = Ложь;
		Если Расшифровка.Свойство("МассивДокументов") Тогда
			//передан массив документов
			Для Каждого ЭлементМассива Из Расшифровка.МассивДокументов Цикл				
				ПоказатьЗначение(,ЭлементМассива.Регистратор);									
			КонецЦикла;	
		Иначе
			ОткрытьФормуНовогоЛида(Расшифровка);
		КонецЕсли;		
	КонецЕсли;
	
