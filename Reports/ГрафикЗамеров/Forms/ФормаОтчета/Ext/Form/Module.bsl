&НаКлиенте
Процедура РезультатТаблицаПеретаскивание(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка, Область)
	
	// перетащили 
	СтароеЗначение = ПараметрыПеретаскивания.Значение.ТекущаяОбласть.Расшифровка;
	НовоеЗначение  = Область.Расшифровка;
	Если НовоеЗначение <> Неопределено Тогда
		// если есть изменения
		Если СтароеЗначение.ДатаЗамера <> НовоеЗначение.ДатаЗамера 
			ИЛИ СтароеЗначение.ВремяНачалаЗамера <> НовоеЗначение.ВремяНачалаЗамера 
			ИЛИ СтароеЗначение.ВремяОкончанияЗамера <> НовоеЗначение.ВремяОкончанияЗамера
			ИЛИ СтароеЗначение.ИсполнительЗамера <> НовоеЗначение.ИсполнительЗамера Тогда
			ДопПараметры = Новый Структура;
			ДопПараметры.Вставить("НовоеЗначение",  НовоеЗначение);
			ДопПараметры.Вставить("СтароеЗначение", СтароеЗначение);
			ПослеСдвигаЗамера = Новый ОписаниеОповещения("ПослеСдвигаЗамераТаблица", ЭтаФорма, ДопПараметры);
			ПоказатьВопрос(ПослеСдвигаЗамера, "Сохранить изменения замера?", РежимДиалогаВопрос.ДаНет);
		КонецЕсли;
		
	Иначе
		СтандартнаяОбработка = Ложь;
		Сформировать(Неопределено);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеСдвигаЗамераТаблица(Результат, ДопПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Нет Тогда
		Сформировать(Неопределено);
		Возврат;
	КонецЕсли;
	
	ПослеСдвигаЗамераТаблицаНаСервере(ДопПараметры.НовоеЗначение, ДопПараметры.СтароеЗначение);
	Сформировать(Неопределено);

КонецПроцедуры

&НаСервере
Процедура ПослеСдвигаЗамераТаблицаНаСервере(НовоеЗначение, СтароеЗначение)
	
	Для Каждого ЭлементМассива Из СтароеЗначение.МассивДокументов Цикл
	    ЛидСсылка = ЭлементМассива.Регистратор; 
		Если ТипЗнч(ЛидСсылка) <> Тип("ДокументСсылка.Лид") Тогда
			Продолжить;
		КонецЕсли;
		НовоеЗначение.ВремяОкончанияЗамера = Мин(ОбщийМодульКлиентСервер.СоединитьДатуИВремя(НовоеЗначение.ДатаЗамера, ВремяКонцаЗамеров),
											НовоеЗначение.ВремяНачалаЗамера + (ЭлементМассива.ВремяОкончания - ЭлементМассива.ВремяНачала));
		//Если НЕ ЭлементМассива.ЭтоВыезд Тогда
			//пытаемся изменить документ лид
			ОбновитьЛидНаСервере(ЛидСсылка, 
							НовоеЗначение.ИсполнительЗамера,
							НовоеЗначение.ДатаЗамера,
							НовоеЗначение.ВремяНачалаЗамера,
							НовоеЗначение.ВремяОкончанияЗамера, ЭлементМассива.ЭтоВыезд, ЭлементМассива.ИДЗамера);
		//Иначе
							
		//КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьЗаявкуНаЗамер(Команда)
	
	ТекОбласть = Элементы.РезультатТаблица.ТекущаяОбласть;
	Расшифровка = Элементы.РезультатТаблица.ТекущаяОбласть.Расшифровка;
	Если Расшифровка = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТекОбласть.Верх <= ТекОбласть.Низ Тогда
		Расшифровка.ВремяОкончанияЗамера = Мин(ВремяКонцаЗамеров,
											Расшифровка.ВремяНачалаЗамера + (ТекОбласть.Низ - ТекОбласть.Верх + 1) * (ПродолжительностьЗамера) * 3600);
	КонецЕсли;
										
	ОткрытьФормуНовогоЛида(Расшифровка);

		//Список = Новый СписокЗначений;
		//Список.ЗагрузитьЗначения(ПолучитьМассивИнтерваловЗамеров());
		//Для каждого элементСписка из Список Цикл
		//	ЭлементСписка.Представление = Формат(ЭлементСписка.Значение, "ДФ = ""ЧЧ:мм""");
