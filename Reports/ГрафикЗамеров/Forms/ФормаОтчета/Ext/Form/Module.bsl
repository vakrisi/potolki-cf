&НаСервере
Функция ОбновитьЛидНаСервере(ЛидСсылка, Сотрудник, НоваяДатаЗамера, НовоеВремяНачалаЗамера, НовоеВремяОкончанияЗамера, ЭтоВыезд, ИДЗамера)
	
	ПараметрыЗамера = Новый Структура;
	ПараметрыЗамера.Вставить("ДатаЗамера", НоваяДатаЗамера);
	ПараметрыЗамера.Вставить("ИсполнительЗамера", Сотрудник); 
	ПараметрыЗамера.Вставить("ВремяНачалаЗамера", НовоеВремяНачалаЗамера);
	ПараметрыЗамера.Вставить("ВремяОкончанияЗамера", НовоеВремяОкончанияЗамера);
	ПараметрыЗамера.Вставить("ИДЗамера", ИДЗамера);

	Если НЕ ПроверитьСвободныйИнтервалЗамеров(ПараметрыЗамера) Тогда
		Сообщить("Выбранный интервал занят");
		Возврат Ложь;
	КонецЕсли;
	
	ДокОбъект = ЛидСсылка.ПолучитьОбъект();
	
	Если НЕ ЭтоВыезд Тогда
		//Замер
		НайденныеСтроки = ДокОбъект.Замеры.НайтиСтроки(Новый Структура("ИДЗамера", ИДЗамера));
		Если НайденныеСтроки.Количество() > 0 Тогда
			ДанныеЗамера = НайденныеСтроки[0];
			ДанныеЗамера.ИсполнительЗамера = ?(ТипЗнч(Сотрудник) = Тип("СправочникСсылка.Сотрудники"), Сотрудник, Справочники.Сотрудники.ПустаяСсылка());
			ДанныеЗамера.ДатаЗамера = НоваяДатаЗамера;
			ДанныеЗамера.ВремяНачалаЗамера = НовоеВремяНачалаЗамера;
			ДанныеЗамера.ВремяОкончанияЗамера = НовоеВремяОкончанияЗамера;
			
			Если ДанныеЗамера.НомерСтроки = ДокОбъект.Замеры.Количество() Тогда				
				ДокОбъект.ПоследнийИсполнительЗамера = ДанныеЗамера.ИсполнительЗамера;
				ДокОбъект.ПоследняяДатаЗамера = НоваяДатаЗамера;
				ДокОбъект.ПоследнееВремяНачалаЗамера = НовоеВремяНачалаЗамера;
				ДокОбъект.ПоследнееВремяОкончанияЗамера = НовоеВремяОкончанияЗамера;
			КонецЕсли;
		КонецЕсли;
	Иначе	
		//Выезд
		НайденныеСтроки = ДокОбъект.Выезды.НайтиСтроки(Новый Структура("ИДЗамера", ИДЗамера));
		Если НайденныеСтроки.Количество() > 0 Тогда
			ДанныеВыезда = НайденныеСтроки[0];
			ДанныеВыезда.Исполнитель = ?(ТипЗнч(Сотрудник) = Тип("СправочникСсылка.Сотрудники"), Сотрудник, Справочники.Сотрудники.ПустаяСсылка());
			ДанныеВыезда.Дата = НоваяДатаЗамера;
			ДанныеВыезда.ВремяНачала = НовоеВремяНачалаЗамера;
			ДанныеВыезда.ВремяОкончания = НовоеВремяОкончанияЗамера;
		КонецЕсли;
	КонецЕсли;	
	
	// #11632 закомментировано
	//ДокОбъект.ДатаПоследнейРеакции = ТекущаяДатаСеанса();
	
	Комментарий = "Изменено расписание " + ?(ЭтоВыезд, "выезда", "замера") + " из графика замеров. Новые значения: " + Формат(НоваяДатаЗамера, "ДЛФ=Д") + " " + Формат(НовоеВремяНачалаЗамера, "ДЛФ=В") + "-" + Формат(НовоеВремяОкончанияЗамера, "ДЛФ=В") + ". Замерщик: " + Сотрудник;
	ДокОбъект.ПоследнийКомментарий = Комментарий;		
	
	Попытка
		ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
		РегистрыСведений.ИсторияЛида.ДобавитьЗаписьВИсториюЛида(ДокОбъект.Ссылка, ТекущаяДатаСеанса(), Пользователи.ТекущийПользователь(), Новый УникальныйИдентификатор, Комментарий);
		
		// №12181
		ОтправитьПУШУведомленияНаСервере(Сотрудник, НоваяДатаЗамера, НовоеВремяНачалаЗамера, НовоеВремяОкончанияЗамера, ЭтоВыезд, ?(ЭтоВыезд И ДокОбъект.АдресВыездаОтличаетсяОтАдресаЛида, ДокОбъект.АдресВыезда, ДокОбъект.Адрес));
		Возврат Истина;
	Исключение
		Сообщить("Не удалось изменить " + ЛидСсылка + ". Ошибка: " + ОписаниеОшибки());
	КонецПопытки;
	
	Возврат Ложь;
	
КонецФункции

&НаСервере
Процедура ОтправитьПУШУведомленияНаСервере(Сотрудник, НоваяДатаЗамера, НовоеВремяНачалаЗамера, НовоеВремяОкончанияЗамера, ЭтоВыезд, Адрес)
	
	МассивДанных = Новый Массив;
	
	СтруктураДанных = Новый Структура;
	СтруктураДанных.Вставить("Текст", "Новая дата: " + Формат(НоваяДатаЗамера, "ДФ=dd.MM.yyyy") + " г. " + Формат(НовоеВремяНачалаЗамера, "ДФ=ЧЧ:мм") + "-" + Формат(НовоеВремяОкончанияЗамера, "ДФ=ЧЧ:мм") + " Адрес: " + Адрес);
	СтруктураДанных.Вставить("Исполнитель", Сотрудник);
	СтруктураДанных.Вставить("Заголовок", ?(ЭтоВыезд, "Выезд", "Замер") + " перенесен");
	
	МассивДанных.Добавить(СтруктураДанных);
		
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = НСтр("ru = 'Отправка PUSH уведомлений замерщикам'");
	Результат = ДлительныеОперации.ВыполнитьВФоне("МобильныйКлиент.ОтправитьPUSHУведомлениеОбИзмененияхЗамеров", МассивДанных, ПараметрыВыполнения);
		
КонецПроцедуры

