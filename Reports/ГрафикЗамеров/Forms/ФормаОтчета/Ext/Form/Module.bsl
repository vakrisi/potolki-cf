#Область ОписаниеЗамерщиков

&НаСервере
Процедура СформироватьОписанияЗамерщиковHTML()
	ОписаниеЗамерщиковHTML = Документы.Лид.СформироватьОписаниеЗамерщиковHTML(ФильтрТочкаПродаж);
КонецПроцедуры

&НаКлиенте
Процедура ОписаниеЗамерщиковHTMLПриНажатии(Элемент, ДанныеСобытия, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	
	Если ВРег(ДанныеСобытия.Element.tagName) = "A" Тогда
		
		СсылкаТекст = Сред(ДанныеСобытия.Element.href, 4);
		СсылкаЗамерщик = ЗамерщикПоВнутреннемуПредставлению(СсылкаТекст);
		Если НЕ СсылкаЗамерщик.Пустая()  Тогда 
			ПоказатьЗначение(, СсылкаЗамерщик);
		КонецЕсли;
		
	КонецЕсли; 
	
КонецПроцедуры

&НаСервере
Функция ЗамерщикПоВнутреннемуПредставлению(СсылкаТекст) 
	Возврат ЗначениеИзСтрокиВнутр(СсылкаТекст);
КонецФункции

&НаКлиенте
Процедура ПоказатьОписаниеЗамерщиковНажатие(Элемент)
	
	Если Элементы.ГруппаОписаниеЗамерщиков.Видимость Тогда
		Элементы.ГруппаОписаниеЗамерщиков.Видимость = Ложь;
		Элементы.ПоказатьОписаниеЗамерщиков.Заголовок = "Показать описание замерщиков";
	Иначе
		Элементы.ГруппаОписаниеЗамерщиков.Видимость = Истина;
		Элементы.ПоказатьОписаниеЗамерщиков.Заголовок = "Скрыть описание замерщиков";
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

