&НаКлиенте
Процедура РезультатТаблицаОбработкаРасшифровки(Элемент, Расшифровка, СтандартнаяОбработка, ДополнительныеПараметры)
	
	//++ не срабатывает в режиме Редактирования, включенного для возможности перетаскивания
	//перенесено в событие Выбор	
	Если ТипЗнч(Расшифровка) = Тип("Структура") Тогда
		СтандартнаяОбработка = Ложь;
		Если Расшифровка.Свойство("МассивДокументов") Тогда
			//передан массив документов
			Для Каждого ЭлементМассива Из Расшифровка.МассивДокументов Цикл				
				ПоказатьЗначение(,ЭлементМассива.Регистратор);								
			КонецЦикла;	
		Иначе
			ОткрытьФормуНовогоЛида(Расшифровка);
		КонецЕсли;		
	КонецЕсли;

КонецПроцедуры

