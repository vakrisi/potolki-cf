#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	//Если НЕ Параметры.ДатаНачала = Дата("00010101") Тогда
	//	Отчет.ДатаНачала = Параметры.ДатаНачала;
	//Иначе 
	//	Отчет.ДатаНачала = ТекущаяДатаСеанса(); //НачалоНедели(ТекущаяДата());
	//КонецЕсли;

	//Если НЕ Параметры.ДатаОкончания = Дата("00010101") Тогда
	//	Отчет.ДатаОкончания = Параметры.ДатаОкончания;
	//Иначе
	//	Отчет.ДатаОкончания = ТекущаяДатаСеанса() + 86400*6; //КонецНедели(ТекущаяДата());
	//КонецЕсли;
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	//ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	МассивИсточников = Новый Массив;
	МассивИсточников.Добавить(Метаданные.Отчеты.ГрафикЗамеров);
	ПараметрыРазмещения = ПодключаемыеКоманды.ПараметрыРазмещения();
	//ПараметрыРазмещения.Источники = Новый ОписаниеТипов("ОтчетСсылка.ГрафикЗамеров");
	ПараметрыРазмещения.Источники = МассивИсточников;
	ПараметрыРазмещения.КоманднаяПанель = Элементы.ГруппаКоманднаяПанель;
	ПараметрыРазмещения.ПрефиксГрупп = ""; 	
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект, ПараметрыРазмещения);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	Отчет.ДатаНачала 	= ТекущаяДатаСеанса(); //#8387
	Отчет.ДатаОкончания = ТекущаяДатаСеанса(); //#8387
	Элементы.УстановитьДень.Пометка = Истина;  //#8387
	
	// ВариантОтображенияГрафика	
	СписокВариантов = МодульОтчетов.ПолучитьСписокВариантовГрафикаЗамеров();
	ИспользоватьКартыЯндекс = НЕ ПустаяСтрока(Константы.КлючAPIЯндексКарты.Получить());
	// #15043 карту на отдельную вкладку
	//Если ИспользоватьКартыЯндекс Тогда
	//	СписокВариантов.Добавить(9, "Карты Яндекс");
	//КонецЕсли;
	Элементы.ГруппаКартыЯндекс.Видимость = ИспользоватьКартыЯндекс;
	
	Для каждого ТекЭлемент из СписокВариантов Цикл
		Элементы.Вариант.СписокВыбора.Добавить(ТекЭлемент.Значение, ТекЭлемент.Представление);
	КонецЦикла;
	
	ВариантОтображенияГрафикаНастройка = ХранилищеОбщихНастроек.Загрузить("ОтчетГрафикЗамеров", "ВариантОтображенияГрафика");
	//Вариант = ?(ВариантОтображенияГрафикаНастройка = Неопределено, 0, ВариантОтображенияГрафикаНастройка);	
	ВариантОтображенияГрафикаПоУмолчанию = Элементы.Вариант.СписокВыбора[0].Значение;
	Если ВариантОтображенияГрафикаНастройка = Неопределено Тогда
		Вариант = ВариантОтображенияГрафикаПоУмолчанию;
	ИначеЕсли Элементы.Вариант.СписокВыбора.НайтиПоЗначению(ВариантОтображенияГрафикаНастройка) = Неопределено Тогда
		Вариант = ВариантОтображенияГрафикаПоУмолчанию;
	Иначе
		Вариант = ВариантОтображенияГрафикаНастройка;
	КонецЕсли;	
	
	ОбновитьВидимостьЭлементов();

	РеквизитыПользователя = ОбщийМодульСервер.НастройкиПользователя("ФильтроватьГрафикЗамеровПоТочкеПродаж, ТочкаПродаж, ГородПоУмолчанию, РазрешеноРаспределениеПулаЗамеровНаЗамерщиков");
	
	Если РеквизитыПользователя.ФильтроватьГрафикЗамеровПоТочкеПродаж Тогда
		ФильтрТочкаПродаж = РеквизитыПользователя.ТочкаПродаж;
		
		//#6384
		НовыйМассив = Новый Массив();
		НовыйМассив.Добавить(Новый ПараметрВыбора("Отбор.Ссылка", ФильтрТочкаПродаж));
		Элементы.ФильтрТочкаПродаж.ПараметрыВыбора = Новый ФиксированныйМассив(НовыйМассив);
		
	КонецЕсли;
	
	Элементы.ГруппаОписаниеЗамерщиков.Видимость = Ложь;	
	ОписаниеЗамерщиковHTML = Документы.Лид.СформироватьОписаниеЗамерщиковHTML(ФильтрТочкаПродаж);
	
	//#11453
	НастройкаОформленияГрафикаЗамеров = ОбщийМодульСервер.ПолучитьНастройкуОформленияГрафикаЗамеров(); 
	НастройкиОформленияГрафикаЗамеров = ОбщийМодульСервер.ПолучитьНастройкиОформленияГрафикаЗамеров(НастройкаОформленияГрафикаЗамеров);
	ОбщийМодульСервер.ЗаполнитьГруппуГрафикЗамеровОформление(ЭтаФорма, НастройкиОформленияГрафикаЗамеров, Элементы.ГруппаГрафикОформлениеЗамеры, Элементы.ГруппаГрафикОформлениеВыезды);
	
	ВремяНачалаЗамеров = Константы.НачалоРабочегоВремениЗамеров.Получить();
	ВремяКонцаЗамеров = Константы.КонецРабочегоВремениЗамеров.Получить();
	
	ПродолжительностьЗамера = Константы.КоличествоЧасовНеобходимыхНаЗамер.Получить();
	ПродолжительностьЗамера = ?(ПродолжительностьЗамера = 0, 0.5, ПродолжительностьЗамера);
	
	Город = РеквизитыПользователя.ГородПоУмолчанию;
	Если Город.Пустая() Тогда
		Город = Константы.ГородПоУмолчанию.Получить();
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	РежимСовместимости = ХранилищеОбщихНастроек.Загрузить("ЯндексКарты_РежимСовместимости");
	УстановитьПривилегированныйРежим(Ложь);
	
	СохранитьЗначенияНастроекОтчета();	
	
	//Элементы.КнопкаПревышенПлан.Видимость  = ПолучитьФункциональнуюОпцию("ИспользоватьПулЗамеров");
	//Элементы.НадписьПревышенПлан.Видимость = ПолучитьФункциональнуюОпцию("ИспользоватьПулЗамеров");
	
 	РазрешеноРаспределениеПулаЗамеровНаЗамерщиков = РеквизитыПользователя.РазрешеноРаспределениеПулаЗамеровНаЗамерщиков;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	
	Если ТипЗнч(ВыбранноеЗначение) = Тип("Структура") Тогда
		//назначили новый замер по новому лиду
		Если ВыбранноеЗначение.Свойство("ВыборНового") Тогда
		    Сформировать(Неопределено);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	//#5402
	ПодключитьОбработчикОжидания("СформироватьПриЗапуске", 0.1, Истина);
		
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура СформироватьПриЗапуске()
	Сформировать(Неопределено);
КонецПроцедуры

&НаКлиенте
Процедура Сформировать(Команда)
	
	Если Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.ГруппаКартыЯндекс Тогда		
		ИнициализироватьКартуЯндекс();
	КонецЕсли;
	
	Элементы.ДекорацияНетОтчета.Видимость = Ложь;	
	
	РезультатПланировщик.ШкалаВремени.ЦветФона = WebЦвета.Белый;
	
	Если Вариант = 0 Тогда
		Элементы.ГруппаРезультатПланировщик.Видимость = Истина;
		Элементы.ГруппаРезультатТаблица.Видимость = Ложь;
		СформироватьГрафикЗамеровКалендарьНаСервере(0);	
		
	ИначеЕсли Вариант = 1 Тогда
		Элементы.ГруппаРезультатПланировщик.Видимость = Истина;
		Элементы.ГруппаРезультатТаблица.Видимость = Ложь;
		СформироватьГрафикЗамеровКалендарьНаСервере(1);
		
	// пул
	ИначеЕсли Вариант = 5 Тогда
		Элементы.ГруппаРезультатПланировщик.Видимость = Истина;
		Элементы.ГруппаРезультатТаблица.Видимость = Ложь;
		СформироватьГрафикПоПлануКалендарьНаСервере(0, Ложь);	
		
	ИначеЕсли Вариант = 6 Тогда
		Элементы.ГруппаРезультатПланировщик.Видимость = Истина;
		Элементы.ГруппаРезультатТаблица.Видимость = Ложь;
		СформироватьГрафикПоПлануКалендарьНаСервере(1, Ложь);
		
	// распределение монтажей
	ИначеЕсли Вариант = 3 Тогда
		Элементы.ГруппаРезультатПланировщик.Видимость = Истина;
		Элементы.ГруппаРезультатТаблица.Видимость = Ложь;
		СформироватьГрафикПоПлануКалендарьНаСервере(0, Истина);	
		
	ИначеЕсли Вариант = 4 Тогда
		Элементы.ГруппаРезультатПланировщик.Видимость = Истина;
		Элементы.ГруппаРезультатТаблица.Видимость = Ложь;
		СформироватьГрафикПоПлануКалендарьНаСервере(1, Истина);
		
	// табличный документ
	ИначеЕсли Вариант = 2 Тогда
		Элементы.ГруппаРезультатПланировщик.Видимость = Ложь;
		Элементы.ГруппаРезультатТаблица.Видимость = Истина;
		РезультатТаблица = СформироватьГрафикЗамеровТаблица();
		
	//ИначеЕсли Вариант = 9 Тогда
		//карты Яндекс
	//	ИнициализироватьКартуЯндекс();
	КонецЕсли; 
	
	ЭтаФорма.ОбновитьОтображениеДанных();
	
	СформироватьОписанияЗамерщиковHTML();
	
КонецПроцедуры

&НаСервере
Процедура ИнициализироватьКартуЯндекс()
	
	КартаЯндекс = КартыЯндекс.ИнициализироватьКарту(Город,Отчет.ДатаНачала, РежимСовместимости);
	ЛегендаЯндекс = КартыЯндекс.СформироватьЛегендуЯндексКарт(ФильтрТочкаПродаж);
	
КонецПроцедуры

&НаСервере
Функция СформироватьГрафикЗамеровТаблица()
	
	Возврат МодульОтчетов.СформироватьГрафикЗамеровТаблица(Отчет.ДатаНачала, Отчет.ДатаОкончания, ФильтрТочкаПродаж);
	
КонецФункции

&НаСервере
Процедура СформироватьГрафикЗамеровКалендарьНаСервере(Развертка)
	
	МодульОтчетов.СформироватьГрафикЗамеровПоЗамерщикамКалендарь(РезультатПланировщик, Отчет.ДатаНачала, Отчет.ДатаОкончания, Развертка, ФильтрТочкаПродаж);
	
КонецПроцедуры

&НаСервере
Процедура СформироватьГрафикПоПлануКалендарьНаСервере(Развертка, ВыводитьРеальныхЗамерщиков)
	
	МодульОтчетов.СформироватьГрафикЗамеровПоПлануКалендарь(РезультатПланировщик, Отчет.ДатаНачала, Отчет.ДатаОкончания, Развертка, ВыводитьРеальныхЗамерщиков, ФильтрТочкаПродаж);
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьДень(Команда)
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ПриИзмененииДатИнтервала", ЭтотОбъект);
	ОбщийМодульКлиент.УстановитьПериодГрафикаДень(ЭтотОбъект, ОписаниеОповещения);
		
КонецПроцедуры

&НаКлиенте
Процедура УстановитьНеделя(Команда)
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ПриИзмененииДатИнтервала", ЭтотОбъект);
	ОбщийМодульКлиент.УстановитьПериодГрафикаНеделя(ЭтотОбъект, ОписаниеОповещения);
		
КонецПроцедуры

&НаКлиенте
Процедура УстановитьМесяц(Команда)
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ПриИзмененииДатИнтервала", ЭтотОбъект);
	ОбщийМодульКлиент.УстановитьПериодГрафикаМесяц(ЭтотОбъект, ОписаниеОповещения);
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьВидимостьЭлементов()
	
	Если Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.ГруппаКартыЯндекс Тогда
				
		Элементы.ДатаНачала.Заголовок = "Дата";
		Элементы.ДатаОкончания.Видимость = Ложь;
		Элементы.УстановитьДень.Видимость = Ложь;
		Элементы.УстановитьМесяц.Видимость = Ложь;
		Элементы.УстановитьНеделя.Видимость = Ложь;
		Элементы.ДекорацияТиреИнтервала.Видимость = Ложь;
		Элементы.ВыбратьПериод.Видимость = Ложь;		
	
	Иначе
		
		Если Вариант = 2 Тогда
			Элементы.ДекорацияНетОтчета.Видимость = Ложь;
			Элементы.ГруппаРезультатПланировщик.Видимость = Ложь;
			Элементы.ГруппаРезультатТаблица.Видимость = Истина;
			//Элементы.ГруппаКартыЯндекс.Видимость = Ложь;
			Элементы.ГруппаГрафикОформление.Видимость = Истина;
			Элементы.ДатаНачала.Заголовок = "Интервал";
			Элементы.ДатаОкончания.Видимость = Истина;
			Элементы.УстановитьДень.Видимость = Истина;
			Элементы.УстановитьМесяц.Видимость = Истина;
			Элементы.УстановитьНеделя.Видимость = Истина;
			Элементы.ДекорацияТиреИнтервала.Видимость = Истина;		
		//ИначеЕсли Вариант = 9 Тогда
			//	//карты Яндекс
			//	Элементы.ДекорацияНетОтчета.Видимость = Ложь;
			//	Элементы.ГруппаРезультатПланировщик.Видимость = Ложь;
			//	Элементы.ГруппаРезультатТаблица.Видимость = Ложь;
			//	Элементы.ГруппаКартыЯндекс.Видимость = Истина;
			//	Элементы.ГруппаГрафикОформление.Видимость = Ложь;
			//	Элементы.ДатаНачала.Заголовок = "Дата";
			//	Элементы.ДатаОкончания.Видимость = Ложь;
			//	Элементы.УстановитьДень.Видимость = Ложь;
			//	Элементы.УстановитьМесяц.Видимость = Ложь;
			//	Элементы.УстановитьНеделя.Видимость = Ложь;
			//	Элементы.ДекорацияТиреИнтервала.Видимость = Ложь;
			
		Иначе
			Элементы.ДекорацияНетОтчета.Видимость = Истина;
			Элементы.ГруппаРезультатПланировщик.Видимость = Ложь;
			Элементы.ГруппаРезультатТаблица.Видимость = Ложь;
			//Элементы.ГруппаКартыЯндекс.Видимость = Ложь;
			Элементы.ГруппаГрафикОформление.Видимость = Истина;
			Элементы.ДатаНачала.Заголовок = "Интервал";
			Элементы.ДатаОкончания.Видимость = Истина;
			Элементы.УстановитьДень.Видимость = Истина;
			Элементы.УстановитьМесяц.Видимость = Истина;
			Элементы.УстановитьНеделя.Видимость = Истина;
			Элементы.ДекорацияТиреИнтервала.Видимость = Истина;
		КонецЕсли;
		
	КонецЕсли;
	
	//Элементы.РежимСовместимости.Видимость = (Вариант = 9);
	
КонецПроцедуры
		
&НаКлиенте
Процедура ВариантПриИзменении(Элемент)
	
	//Если Вариант = 9 Тогда
	//	//карты Яндекс
	//	Отчет.ДатаОкончания = Отчет.ДатаНачала;    						//#8387
	//	ОбщийМодульКлиент.СнятьПометкиКнопокИнтервалаГрафика(Элементы); //#8387
	//	Элементы.УстановитьДень.Пометка = Истина;  						//#8387
	//КонецЕсли;

	ВариантОтображенияГрафикаПриИзмененииНаСервере();
	ОбновитьВидимостьЭлементов();
	Сформировать(Неопределено);
	
КонецПроцедуры

&НаСервере
Процедура ВариантОтображенияГрафикаПриИзмененииНаСервере()
	ХранилищеОбщихНастроек.Сохранить("ОтчетГрафикЗамеров", "ВариантОтображенияГрафика", Вариант);
КонецПроцедуры

&НаКлиенте
Процедура ДатаИнтервалаПриИзменении()

	СохранитьЗначенияНастроекОтчета();
	Сформировать(Неопределено);
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаНачалаПриИзменении(Элемент)
	
	ОбщийМодульКлиент.ПриИзмененииДатыНачалаГрафика(ЭтотОбъект);
	ДатаИнтервалаПриИзменении();
	
КонецПроцедуры

&НаКлиенте
