//++ №11768 формируем запрос используя внешние наборы данных
Функция ПолучитьТаблицуОсновная(НачалоПериода, КонецПериода)
	
	Запрос = новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Замеры.ДокументЗамер КАК Контакт,
	//++ №10213 строим по показателю, кто назначил замер
	//|	Замеры.ДокументЗамер.Ответственный КАК Показатель,
	|	Замеры.НазначилЗамер КАК Показатель,
	// №13645 формируем по сотрудникам	ЕСТЬNULL(Пользователи.Ссылка, ЗНАЧЕНИЕ(Справочник.Пользователи.ПустаяСсылка)) КАК Показатель,
	//-- №10213
	|	СУММА(1) КАК КоличествоЗамеровПоДатеНазначенияЗамера,
	|	СУММА(ВЫБОР
	|			КОГДА Замеры.ЗамерВыполнен
	|				ТОГДА 1
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК КоличествоВыполненныхЗамеровПоДатеНазначенияЗамера,
	|	СУММА(ВЫБОР
	|			КОГДА Замеры.Результат = ЗНАЧЕНИЕ(Справочник.РезультатЗамераЛида.ЗаключенДоговор)
	|				ТОГДА 1
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК КоличествоЗамеровУспехПоДатеНазначенияЗамера,
	|	СУММА(ВЫБОР
	|			КОГДА Замеры.Результат = ЗНАЧЕНИЕ(Справочник.РезультатЗамераЛида.ДоговорНеЗаключен)
	|				ТОГДА 1
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК КоличествоЗамеровОтказПоДатеНазначенияЗамера,
	|	СУММА(ВЫБОР
	|			КОГДА Замеры.Результат = ЗНАЧЕНИЕ(Справочник.РезультатЗамераЛида.ЗамерНеПроизводился)
	|				ТОГДА 1
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК КоличествоЗамеровНевыполненПоДатеНазначенияЗамера,
	|	СУММА(ВЫБОР
	|			КОГДА Замеры.Результат = ЗНАЧЕНИЕ(Справочник.РезультатЗамераЛида.ЗаключенДоговор)
	|				ТОГДА 1
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК КоличествоДоговоровНаЗамерахПоДатеНазначенияЗамера,
	|	СУММА(ВЫБОР
	|			КОГДА Замеры.Результат = ЗНАЧЕНИЕ(Справочник.РезультатЗамераЛида.ЗаключенДоговор)
	|				ТОГДА 1
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК КоличествоДоговоровПоДатеНазначенияЗамера,
	|	СУММА(ВЫБОР
	|			КОГДА Замеры.Результат = ЗНАЧЕНИЕ(Справочник.РезультатЗамераЛида.ЗаключенДоговор)
	|				ТОГДА Замеры.СуммаДоговора
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК СуммаДоговоровПоДатеНазначенияЗамера
	|ИЗ
	|	РегистрСведений.Замеры КАК Замеры
	//++ №13645 формируем по сотрудникам
	//// #12889 приводим тип показателя к "Пользователь"
	//|	ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Пользователи КАК Пользователи 
	//|	ПО Пользователи.Сотрудник = Замеры.НазначилЗамер
	//|		И НЕ Замеры.НазначилЗамер = ЗНАЧЕНИЕ(Справочник.Сотрудники.ПустаяСсылка)
	//-- №13645
	|ГДЕ
	|	НЕ Замеры.Результат = ЗНАЧЕНИЕ(Справочник.РезультатЗамераЛида.ЗамерОтменен)
	|	И Замеры.ДатаНазначенияЗамера МЕЖДУ &НачалоПериода И &КонецПериода
	|	И НЕ Замеры.ЭтоВыезд
	|
	|СГРУППИРОВАТЬ ПО
	|	Замеры.ДокументЗамер,
	|	Замеры.НазначилЗамер
	//++ №13645 формируем по сотрудникам|	ЕСТЬNULL(Пользователи.Ссылка, ЗНАЧЕНИЕ(Справочник.Пользователи.ПустаяСсылка))
	|
	//|ОБЪЕДИНИТЬ ВСЕ
	//|
	//|ВЫБРАТЬ
	//|	ЗНАЧЕНИЕ(Документ.Лид.ПустаяСсылка),
	//|	-1,
	//|   0, 0, 0, 0, 0, 0, 0, 0
	|";
	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", КонецДня(КонецПериода));
	
	ТаблицаРезультат = Запрос.Выполнить().Выгрузить();
	
	//++ в колонке "Показатель" кроме показателя еще может быть текст
	КС = Новый КвалификаторыСтроки(20);
	
	МассивТипов = Новый Массив;
	МассивТипов.Добавить(Тип("Строка"));
	//++ №13645 формируем по сотрудникам
	//МассивТипов.Добавить(Тип("СправочникСсылка.Пользователи"));
	МассивТипов.Добавить(Тип("СправочникСсылка.Сотрудники"));
	//-- №13645 формируем по сотрудникам
	
	ОписаниеТиповС = Новый ОписаниеТипов(МассивТипов, , КС);
	
	ТаблицаРезультат.Колонки.Добавить("Показатель1", ОписаниеТиповС);
	
	Для каждого СтрокаТЧ из ТаблицаРезультат Цикл
		СтрокаТЧ.Показатель1 = СтрокаТЧ.Показатель; 	
	КонецЦикла;
	
	ТаблицаРезультат.Колонки.Показатель.Имя = "Показатель_Врем";
	ТаблицаРезультат.Колонки.Показатель1.Имя = "Показатель";
	ТаблицаРезультат.Колонки.Удалить("Показатель_Врем"); 
	
	Возврат ТаблицаРезультат;
	
КонецФункции
//-- №11768

#КонецОбласти

