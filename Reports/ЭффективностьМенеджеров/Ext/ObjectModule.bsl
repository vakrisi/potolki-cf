	// Вторая таблица полностью по вычисляемым полям Конверсии
	СтруктураТаблиц.Вставить("ПоДатеЛидаПродолжение", ОбщийМодульСервер.ПолучитьТаблицуПоДатеЛидаПродолжение(МенеджерВТ, НачалоПериода, КонецПериода));
	СтруктураТаблиц.Вставить("ПоДатеДоговора", ОбщийМодульСервер.ПолучитьТаблицуПоДатеДоговора(МенеджерВТ, НачалоПериода, КонецПериода));
	
	//#12914 новая таблица
	СтруктураТаблиц.Вставить("ПоМонтажам", ОбщийМодульСервер.ПолучитьТаблицуПоМонтажам(МенеджерВТ, НачалоПериода, КонецПериода));
	
	ВнешниеНаборыДанных = новый Структура("Основной", ОбщийМодульСервер.ОбъединитьТаблицыНаборовДанных(СтруктураТаблиц));
	
	//Выбор типа диаграммы
