
&НаСервере
Функция СформироватьНаСервере()
	
	Возврат МодульОтчетов.СформироватьОтчетПоВходящимКонтактамВРазрезеРекламныхИсточников(Отчет.ДатаНачала, Отчет.ДатаОкончания);
	
КонецФункции

&НаКлиенте
Процедура Сформировать(Команда)
	Анализ = СформироватьНаСервере();
	ОбновитьОтображениеДанных();
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	Если Отчет.ДатаНачала = Дата("00010101") Тогда
		Отчет.ДатаНачала = НачалоМесяца(ТекущаяДата());
	КонецЕсли;
	Если Отчет.ДатаОкончания = Дата("00010101") Тогда
		Отчет.ДатаОкончания = КонецМесяца(ТекущаяДата());
	КонецЕсли;
КонецПроцедуры
