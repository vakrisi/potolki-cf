<?xml version="1.0" encoding="UTF-8"?>
<DataCompositionSchema xmlns="http://v8.1c.ru/8.1/data-composition-system/schema" xmlns:dcscom="http://v8.1c.ru/8.1/data-composition-system/common" xmlns:dcscor="http://v8.1c.ru/8.1/data-composition-system/core" xmlns:dcsset="http://v8.1c.ru/8.1/data-composition-system/settings" xmlns:v8="http://v8.1c.ru/8.1/data/core" xmlns:v8ui="http://v8.1c.ru/8.1/data/ui" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<dataSource>
		<name>ИсточникДанных1</name>
		<dataSourceType>Local</dataSourceType>
	</dataSource>
	<dataSet xsi:type="DataSetQuery">
		<name>НаборДанных1</name>
		<field xsi:type="DataSetFieldField">
			<dataPath>СтоимостьДляМенеджера</dataPath>
			<field>СтоимостьДляМенеджера</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Стоимость для менеджера</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Фактура</dataPath>
			<field>Фактура</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Фактура</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Номенклатура</dataPath>
			<field>Номенклатура</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Наименование</dataPath>
			<field>Наименование</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>СтоимостьДляРаскройщика</dataPath>
			<field>СтоимостьДляРаскройщика</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Стоимость для раскройщика</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Ссылка</dataPath>
			<field>Ссылка</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Цвет фактуры</v8:content>
				</v8:item>
			</title>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	ЦветФактуры.Ссылка,
	ЦветФактуры.Владелец КАК Фактура,
	ЦветФактуры.Номенклатура КАК Номенклатура,
	ЦветФактуры.Наименование КАК Наименование,
	ЕСТЬNULL(СтоимостьВыработкиПроизводства.Стоимость, 0) КАК СтоимостьДляРаскройщика,
	ЕСТЬNULL(СтоимостьВыработкиПроизводства.СтоимостьДляМенеджера, 0) КАК СтоимостьДляМенеджера
ИЗ
	Справочник.ЦветФактуры КАК ЦветФактуры
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтоимостьВыработкиПроизводства.СрезПоследних({(&amp;Период)}, ) КАК СтоимостьВыработкиПроизводства
		ПО (СтоимостьВыработкиПроизводства.Номенклатура = ЦветФактуры.Номенклатура)
ГДЕ
	НЕ ЦветФактуры.Номенклатура = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
{ГДЕ
	(ЕСТЬNULL(СтоимостьВыработкиПроизводства.Стоимость, 0) = &amp;Стоимость
			ИЛИ ЕСТЬNULL(СтоимостьВыработкиПроизводства.СтоимостьДляМенеджера, 0) = &amp;Стоимость)}

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	"",
	"",
	СтоимостьВыработкиПроизводства.Номенклатура,
	СтоимостьВыработкиПроизводства.Номенклатура.Наименование,
	ЕСТЬNULL(СтоимостьВыработкиПроизводства.Стоимость, 0),
	ЕСТЬNULL(СтоимостьВыработкиПроизводства.СтоимостьДляМенеджера, 0)
ИЗ
	РегистрСведений.СтоимостьВыработкиПроизводства.СрезПоследних({(&amp;Период)}, ) КАК СтоимостьВыработкиПроизводства
ГДЕ
	СтоимостьВыработкиПроизводства.Номенклатура = ЗНАЧЕНИЕ(Справочник.Номенклатура.ОстаткиПленки)
{ГДЕ
	(ЕСТЬNULL(СтоимостьВыработкиПроизводства.Стоимость, 0) = &amp;Стоимость
			ИЛИ ЕСТЬNULL(СтоимостьВыработкиПроизводства.СтоимостьДляМенеджера, 0) = &amp;Стоимость)}</query>
	</dataSet>
