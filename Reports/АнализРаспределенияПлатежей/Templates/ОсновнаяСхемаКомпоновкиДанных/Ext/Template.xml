			<field>Валюта</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Контрагент</dataPath>
			<field>Контрагент</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>УчитыватьСтроку</dataPath>
			<field>УчитыватьСтроку</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Учитывать строку</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ВидОперации</dataPath>
			<field>ВидОперации</field>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ РАЗРЕШЕННЫЕ
	ИсточникДанных.Период КАК Период,
	ИсточникДанных.Регистратор КАК ДокументОплаты,
	ИсточникДанных.СуммаПриход КАК СуммаДокументаОплаты
ПОМЕСТИТЬ ВТ_ДокументыОплаты
ИЗ
	РегистрНакопления.ДенежныеСредства.Обороты(, , Регистратор, ) КАК ИсточникДанных
ГДЕ
	(ИсточникДанных.Регистратор ССЫЛКА Документ.ПриходныйКассовыйОрдер
			ИЛИ ИсточникДанных.Регистратор ССЫЛКА Документ.ПоступлениеНаРасчетныйСчет
	)
	//++ #15247
	И ВЫБОР 
		КОГДА ИсточникДанных.Регистратор ССЫЛКА Документ.ПриходныйКассовыйОрдер
			ТОГДА ВЫРАЗИТЬ(ИсточникДанных.Регистратор КАК Документ.ПриходныйКассовыйОрдер).ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийПриходныйКассовыйОрдер.ОплатаОтПокупателя)
		КОГДА ИсточникДанных.Регистратор ССЫЛКА Документ.ПриходныйКассовыйОрдер
			ТОГДА ВЫРАЗИТЬ(ИсточникДанных.Регистратор КАК Документ.ПоступлениеНаРасчетныйСчет).ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийПоступлениеНаРасчетныйСчет.ОплатаОтПокупателя)
		ИНАЧЕ
			ЛОЖЬ
	КОНЕЦ
	//-- #15247

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	ИсточникДанных.Период,
	ИсточникДанных.Регистратор,
	ИсточникДанных.СуммаПриход + ИсточникДанных.КомиссияБанкаПриход
ИЗ
	РегистрНакопления.РасчетыПоЭквайрингу.Обороты(, , Регистратор, ) КАК ИсточникДанных
ГДЕ
	ИсточникДанных.Регистратор ССЫЛКА Документ.ОплатаБанковскойКартой

// #12822 	
ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	ИсточникДанных.Дата,
	ИсточникДанных.Ссылка,
	ИсточникДанных.СуммаАванса
ИЗ
	Документ.ВозвратТовараОтПокупателя КАК ИсточникДанных
ГДЕ
	ИсточникДанных.Проведен 
	И ИсточникДанных.СуммаАванса &gt; 0
{ГДЕ
	ИсточникДанных.Дата &gt;= &amp;НачалоПериода,  ИсточникДанных.Дата &lt;= &amp;КонецПериода}
	
//#15395	
ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	ИсточникДанных.Дата,
	ИсточникДанных.Ссылка,
	ИсточникДанных.СуммаАванса
ИЗ
	Документ.ВозвратПродукции КАК ИсточникДанных
ГДЕ
	ИсточникДанных.Проведен 
	И ИсточникДанных.СуммаАванса &gt; 0
{ГДЕ
	ИсточникДанных.Дата &gt;= &amp;НачалоПериода,  ИсточникДанных.Дата &lt;= &amp;КонецПериода}

;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗРЕШЕННЫЕ
	ИсточникДанных.Период КАК Период,
	ИсточникДанных.Регистратор КАК ДокументОплаты,
	ВЫБОР
		КОГДА ИсточникДанных.Регистратор ССЫЛКА Документ.ПриходныйКассовыйОрдер
			ТОГДА ИсточникДанных.Регистратор.Касса
		КОГДА ИсточникДанных.Регистратор ССЫЛКА Документ.ПоступлениеНаРасчетныйСчет
			ТОГДА ИсточникДанных.Регистратор.Счет
		КОГДА ИсточникДанных.Регистратор ССЫЛКА Документ.ОплатаБанковскойКартой
			ТОГДА ИсточникДанных.Регистратор.Касса
		ИНАЧЕ
			НЕОПРЕДЕЛЕНО
	КОНЕЦ КАК КассаСчет,
	ИсточникДанных.Заказ КАК Документ,
	ТИПЗНАЧЕНИЯ(ИсточникДанных.Заказ) КАК ТипДокумента,
	ИсточникДанных.Заказ.СуммаДокумента КАК СуммаДокумента,
	ИсточникДанных.СуммаРасход КАК СуммаРаспределения,
	ИсточникДанных.Заказ.СуммаДокумента - ИсточникДанных.СуммаРасход КАК ОстатокРаспределения
ПОМЕСТИТЬ ВТ_Распределение
ИЗ
	РегистрНакопления.РасчетыПоЗаказам.Обороты(, , Регистратор, ) КАК ИсточникДанных
ГДЕ
	(ИсточникДанных.Регистратор ССЫЛКА Документ.ПриходныйКассовыйОрдер
			ИЛИ ИсточникДанных.Регистратор ССЫЛКА Документ.ОплатаБанковскойКартой
			ИЛИ ИсточникДанных.Регистратор ССЫЛКА Документ.ПоступлениеНаРасчетныйСчет
			// #12822 
			ИЛИ ИсточникДанных.Регистратор ССЫЛКА Документ.ВозвратТовараОтПокупателя
			// #15395 
			ИЛИ ИсточникДанных.Регистратор ССЫЛКА Документ.ВозвратПродукции
	)
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗРЕШЕННЫЕ
	ВТ_ДокументыОплаты.Период КАК Период,
	ВТ_ДокументыОплаты.ДокументОплаты КАК ДокументОплаты,
	ВТ_ДокументыОплаты.СуммаДокументаОплаты КАК СуммаДокументаОплаты,
	ВТ_Распределение.Документ КАК Документ,
	ВТ_Распределение.ТипДокумента КАК ТипДокумента,
	ЕСТЬNULL(ВТ_Распределение.СуммаДокумента, 0) КАК СуммаДокумента,
	ЕСТЬNULL(ВТ_Распределение.СуммаРаспределения, 0) КАК СуммаРаспределения,
	ЕСТЬNULL(ВТ_Распределение.ОстатокРаспределения, 0) КАК ОстатокРаспределения,
	ЕСТЬNULL(ВТ_Распределение.КассаСчет, НЕОПРЕДЕЛЕНО) КАК КассаСчет,
	ВЫБОР
		КОГДА НЕ ВТ_Распределение.Документ ЕСТЬ NULL
			ТОГДА ВЫБОР
					КОГДА ВТ_Распределение.Документ ССЫЛКА Документ.ЗаказПокупателя
								И &amp;ТипДокументаОтбор = "ЗаказПокупателя"
							ИЛИ ВТ_Распределение.Документ ССЫЛКА Документ.СчетНаОплату
								И &amp;ТипДокументаОтбор = "СчетНаОплату"
							ИЛИ ВТ_Распределение.Документ ССЫЛКА Документ.ЗаказДоговор
								И &amp;ТипДокументаОтбор = "ЗаказДоговор"
							ИЛИ ВТ_Распределение.Документ ССЫЛКА Документ.Монтаж
								И &amp;ТипДокументаОтбор = "Монтаж"
							ИЛИ ВТ_Распределение.Документ ССЫЛКА Документ.РеализацияТоваровИУслуг
								И &amp;ТипДокументаОтбор = "Реализация"
							ИЛИ &amp;ТипДокументаОтбор = НЕОПРЕДЕЛЕНО
						ТОГДА ИСТИНА
					ИНАЧЕ ЛОЖЬ
				КОНЕЦ
		ИНАЧЕ ИСТИНА
	КОНЕЦ КАК УчитыватьСтроку
ПОМЕСТИТЬ ВТ_ОплатыРаспределение
ИЗ
	ВТ_ДокументыОплаты КАК ВТ_ДокументыОплаты
		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Распределение КАК ВТ_Распределение
		ПО (ВТ_Распределение.ДокументОплаты = ВТ_ДокументыОплаты.ДокументОплаты)
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗРЕШЕННЫЕ
	ВТ_ОплатыРаспределение.ДокументОплаты КАК ДокументОплаты,
	ВТ_ОплатыРаспределение.СуммаДокументаОплаты КАК СуммаДокументаОплаты,
	ВТ_ОплатыРаспределение.ТипДокумента КАК ТипДокумента,
	ВЫРАЗИТЬ(СУММА(ВТ_ОплатыРаспределение.СуммаРаспределения) КАК ЧИСЛО(15, 2)) КАК СуммаРаспределения
ПОМЕСТИТЬ ВТ_ОплатыРаспределениеПоТипам
ИЗ
	ВТ_ОплатыРаспределение КАК ВТ_ОплатыРаспределение

СГРУППИРОВАТЬ ПО
	ВТ_ОплатыРаспределение.ДокументОплаты,
	ВТ_ОплатыРаспределение.СуммаДокументаОплаты,
	ВТ_ОплатыРаспределение.ТипДокумента
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗРЕШЕННЫЕ
	ВТ_ОплатыРаспределениеПоТипам.ДокументОплаты КАК ДокументОплаты,
	ВТ_ОплатыРаспределениеПоТипам.ТипДокумента КАК ТипДокумента,
	ИСТИНА КАК НеРаспределено
ПОМЕСТИТЬ ВТ_Нераспределенные
ИЗ
	ВТ_ОплатыРаспределениеПоТипам КАК ВТ_ОплатыРаспределениеПоТипам
ГДЕ
	ВТ_ОплатыРаспределениеПоТипам.СуммаДокументаОплаты &lt;&gt; ВТ_ОплатыРаспределениеПоТипам.СуммаРаспределения

ОБЪЕДИНИТЬ

ВЫБРАТЬ
	ВТ_ОплатыРаспределение.ДокументОплаты,
	ВТ_ОплатыРаспределение.ТипДокумента,
	ИСТИНА
ИЗ
	ВТ_ОплатыРаспределение КАК ВТ_ОплатыРаспределение
ГДЕ
	ВТ_ОплатыРаспределение.ОстатокРаспределения &lt; 0
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗРЕШЕННЫЕ
	ВТ_ОплатыРаспределение.Период КАК Период,
	ВТ_ОплатыРаспределение.ДокументОплаты КАК ДокументОплаты,
	ВТ_ОплатыРаспределение.КассаСчет КАК КассаСчет,
	ВТ_ОплатыРаспределение.СуммаДокументаОплаты КАК СуммаДокументаОплаты,
	ВТ_ОплатыРаспределение.Документ КАК Документ,
	ВТ_ОплатыРаспределение.ТипДокумента КАК ТипДокумента,
	ВЫБОР
		КОГДА ВТ_ОплатыРаспределение.УчитыватьСтроку
			ТОГДА ВТ_ОплатыРаспределение.СуммаДокумента
		ИНАЧЕ 0
	КОНЕЦ КАК СуммаДокумента,
	ВЫБОР
		КОГДА ВТ_ОплатыРаспределение.УчитыватьСтроку
			ТОГДА ВТ_ОплатыРаспределение.СуммаРаспределения
		ИНАЧЕ 0
	КОНЕЦ КАК СуммаРаспределения,
	ВЫБОР
		КОГДА ВТ_ОплатыРаспределение.УчитыватьСтроку
			ТОГДА ВТ_ОплатыРаспределение.ОстатокРаспределения			  
		ИНАЧЕ 0
	КОНЕЦ КАК ОстатокРаспределения,
	ЕСТЬNULL(ВТ_Нераспределенные.НеРаспределено, ЛОЖЬ) КАК НеРаспределено ,
	ВТ_ОплатыРаспределение.УчитыватьСтроку
ИЗ
	ВТ_ОплатыРаспределение КАК ВТ_ОплатыРаспределение
		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Нераспределенные КАК ВТ_Нераспределенные
		ПО (ВТ_Нераспределенные.ДокументОплаты = ВТ_ОплатыРаспределение.ДокументОплаты)
			И (ВТ_ОплатыРаспределение.ТипДокумента = ВТ_Нераспределенные.ТипДокумента
				ИЛИ ВТ_ОплатыРаспределение.ТипДокумента ЕСТЬ NULL)

ОБЪЕДИНИТЬ ВСЕ

// для вычисления "ОстатокРаспределения12822"
