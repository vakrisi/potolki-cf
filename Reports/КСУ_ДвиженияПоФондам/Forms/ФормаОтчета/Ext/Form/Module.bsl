
&НаСервере
Процедура СформироватьНаСервере()
	ИспПодр = Константы.КСУ_ФП_ИспользоватьПодразделения.Получить();
	ДоходыПодр = Константы.КСУ_ДоходыПоПодразделениям.Получить();
	ПодрДетализация = ИспПодр и не ДоходыПодр; 
	
	ТабДок.Очистить();
	
	отч = РеквизитФормыВЗначение("Отчет");
	макет = отч.ПолучитьМакет("Макет");
	
	Обл = макет.ПолучитьОбласть("Шапка");
	обл.параметры.ДатаОтчета = ТекущаяДата();
	обл.параметры.Период = формат(ДатаНачала,"ДФ=dd.MM.yyyy") + " - " + формат(ДатаКонца,"ДФ=dd.MM.yyyy");
	ТабДок.Вывести(обл);
	
	ВыбФонды = Новый массив;
	Для каждого стр из Фонды Цикл
		Если стр.выбрать Тогда
			ВыбФонды.Добавить(стр.фонд);
		КонецЕсли;
	КонецЦикла;
	ВсеФонды = ВыбФонды.Количество() = Фонды.Количество();
	
	ВыбОперации = Новый массив;
	Для каждого стр из ВидыОпераций Цикл
		Если стр.выбрать Тогда
			ВыбОперации.Добавить(стр.ВидОперации);
		КонецЕсли;
	КонецЦикла;
	ВсеОперации = ВыбОперации.Количество() = ВидыОпераций.Количество();
	
	Если не ВсеФонды Тогда
		Обл = макет.ПолучитьОбласть("НеВсеФонды");		
		ТабДок.Вывести(обл);
	КонецЕсли;
	
	Если не ВсеОперации Тогда
		Обл = макет.ПолучитьОбласть("НеВсеОперации");		
		ТабДок.Вывести(обл);
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДатаНачала", ДатаНачала);
	Запрос.УстановитьПараметр("ДатаКонца", КонецДня(ДатаКонца));
	Запрос.УстановитьПараметр("Фонды", ВыбФонды);
	Запрос.УстановитьПараметр("Операции", ВыбОперации);
	
	для каждого стрОрг из Организации Цикл
		если не стрОрг.Выбрать тогда
			Продолжить;
		КонецЕсли;
		
		/////////// ОРГАНИЗАЦИЯ
		Обл = макет.ПолучитьОбласть("ГруппаОрганизация");
		обл.параметры.Организация = стрОрг.Организация;
		ТабДок.Вывести(обл);
		
		// подготовка данных
		Запрос.Текст = "ВЫБРАТЬ
		               |	ИА_СредстваНаФондахОстаткиИОбороты.Фонд.Счет КАК Счет,
		               |	ИА_СредстваНаФондахОстаткиИОбороты.Фонд КАК Фонд,
		               |	0 КАК Лимит,
		               |	СУММА(ИА_СредстваНаФондахОстаткиИОбороты.СуммаБезналНачальныйОстаток) КАК НачальныйОстаток,
		               |	СУММА(ИА_СредстваНаФондахОстаткиИОбороты.СуммаБезналПриход) КАК Приход,
		               |	СУММА(ИА_СредстваНаФондахОстаткиИОбороты.СуммаБезналРасход) КАК Расход,
		               |	СУММА(ИА_СредстваНаФондахОстаткиИОбороты.СуммаБезналКонечныйОстаток) КАК КонечныйОстаток,
		               |	ВЫБОР
		               |		КОГДА &ИспПодр
		               |			ТОГДА ИА_СредстваНаФондахОстаткиИОбороты.Подразделение
		               |		ИНАЧЕ НЕОПРЕДЕЛЕНО
		               |	КОНЕЦ КАК Подразделение,
		               |	ВЫБОР
		               |		КОГДА &ИспПодр
		               |			ТОГДА ИА_СредстваНаФондахОстаткиИОбороты.Подразделение.Наименование
		               |		ИНАЧЕ """"
		               |	КОНЕЦ КАК ПодразделениеНаименование
		               |ИЗ
		               |	РегистрНакопления.ИА_СредстваНаФондах.ОстаткиИОбороты(
		               |			&ДатаНачала,
		               |			&ДатаКонца,
		               |			Период,
		               |			,
		               |			Организация = &Организация
		               |				И Фонд В (&Фонды)) КАК ИА_СредстваНаФондахОстаткиИОбороты		             
					   |СГРУППИРОВАТЬ ПО
		               |	ИА_СредстваНаФондахОстаткиИОбороты.Фонд.Счет,
		               |	ИА_СредстваНаФондахОстаткиИОбороты.Фонд,
		               |	ВЫБОР
		               |		КОГДА &ИспПодр
		               |			ТОГДА ИА_СредстваНаФондахОстаткиИОбороты.Подразделение
		               |		ИНАЧЕ НЕОПРЕДЕЛЕНО
		               |	КОНЕЦ,
		               |	ВЫБОР
		               |		КОГДА &ИспПодр
		               |			ТОГДА ИА_СредстваНаФондахОстаткиИОбороты.Подразделение.Наименование
		               |		ИНАЧЕ """"
		               |	КОНЕЦ
		               |
		               |ИМЕЮЩИЕ
		               |	(СУММА(ИА_СредстваНаФондахОстаткиИОбороты.СуммаБезналНачальныйОстаток) > 0
		               |		ИЛИ СУММА(ИА_СредстваНаФондахОстаткиИОбороты.СуммаБезналПриход) > 0
		               |		ИЛИ СУММА(ИА_СредстваНаФондахОстаткиИОбороты.СуммаБезналРасход) > 0
		               |		ИЛИ СУММА(ИА_СредстваНаФондахОстаткиИОбороты.СуммаБезналКонечныйОстаток) > 0)
		               |
		               |УПОРЯДОЧИТЬ ПО
		               |	ИА_СредстваНаФондахОстаткиИОбороты.Фонд.Счет.Наименование,
		               |	ПодразделениеНаименование,
		               |	ИА_СредстваНаФондахОстаткиИОбороты.Фонд.Наименование";
		Запрос.УстановитьПараметр("Организация", стрОрг.Организация);
		Запрос.УстановитьПараметр("ИспПодр", ИспПодр);
		тз_счетаФонды = запрос.Выполнить().Выгрузить();
		тз_счета = тз_счетаФонды.Скопировать();
		Если ДоходыПодр Тогда
			тз_счета.Свернуть("Счет,Подразделение", "НачальныйОстаток,Приход,Расход,КонечныйОстаток"); 
		Иначе
			тз_счета.Свернуть("Счет", "НачальныйОстаток,Приход,Расход,КонечныйОстаток"); 
		КонецЕсли;
		
		Если тз_счетаФонды.Количество() = 0 Тогда
			Обл = макет.ПолучитьОбласть("НетДвижений");		
			ТабДок.Вывести(обл);
		
			Продолжить;
		КонецЕсли;
		
		тзПодрДоход = тз_счетаФонды.Скопировать();		
		Если ДоходыПодр Тогда
			тзПодрДоход.Свернуть("Подразделение");
		Иначе
			тзПодрДоход.Очистить();
			нСтр = тзПодрДоход.Добавить();
		КонецЕсли;
		
		Для каждого стрподрДоход из тзПодрДоход Цикл
			
			Если ДоходыПодр Тогда
				Обл = макет.ПолучитьОбласть("ДетализацияШапкаПодр");
				обл.параметры.Подразделение = "Подразделение: " + стрподрДоход.Подразделение;					
				ТабДок.Вывести(обл);
			КонецЕсли;									
		
			/////////// СЧЕТА
			ВыводитьСчета = Настройки[0].Выбрать;
			
			Если ДоходыПодр Тогда
				СтрокиСчета = тз_счета.НайтиСтроки(Новый Структура("Подразделение", стрподрДоход.Подразделение)); 
			Иначе
				СтрокиСчета = тз_счета; 
			КонецЕсли;
			
			Если ВыводитьСчета Тогда
				Обл = макет.ПолучитьОбласть("СчетаШапка");
				ТабДок.Вывести(обл);
				
				НачальныйОстаток = 0;
				Приход = 0;
				Расход = 0;
				КонечныйОстаток = 0;
				Для каждого стрСчет из СтрокиСчета Цикл
					Обл = макет.ПолучитьОбласть("СчетаСтрока");
					ЗаполнитьЗначенияСвойств(обл.параметры, стрСчет);
					ТабДок.Вывести(обл);
					
					НачальныйОстаток = НачальныйОстаток + стрСчет.НачальныйОстаток;
					Приход = Приход + стрСчет.Приход;
					Расход = Расход + стрСчет.Расход;
					КонечныйОстаток = КонечныйОстаток + стрСчет.КонечныйОстаток;
				КонецЦикла;
				
				Обл = макет.ПолучитьОбласть("СчетаИтого");
				обл.параметры.НачальныйОстаток = НачальныйОстаток;
				обл.параметры.Приход = Приход;
				обл.параметры.Расход = Расход;
				обл.параметры.КонечныйОстаток = КонечныйОстаток;
				ТабДок.Вывести(обл);
			КонецЕсли;
			
			/////////// ФОНДЫ
			ВыводитьФонды = Настройки[1].Выбрать;
			
			Если ВыводитьФонды Тогда
				Обл = макет.ПолучитьОбласть("ФондыШапка");
				ТабДок.Вывести(обл);
				
				
				Для каждого стрСчет из СтрокиСчета Цикл
					Если ПодрДетализация Тогда
						Обл = макет.ПолучитьОбласть("ФондыШапкаСчет_подр");
					Иначе
						Обл = макет.ПолучитьОбласть("ФондыШапкаСчет");
					КонецЕсли;
						
					обл.параметры.Счёт = стрСчет.Счет;
					ТабДок.Вывести(обл);
					
					Если ДоходыПодр Тогда
						СтрокиФонда = тз_счетаФонды.НайтиСтроки(Новый Структура("счет, Подразделение", стрСчет.Счет, стрподрДоход.Подразделение));
					Иначе
						СтрокиФонда = тз_счетаФонды.НайтиСтроки(Новый Структура("счет", стрСчет.Счет));
					КонецЕсли;
					
					НачальныйОстаток = 0;
					Приход = 0;
					Расход = 0;
					КонечныйОстаток = 0;
					Для каждого стрФонд из СтрокиФонда Цикл
						Если ПодрДетализация Тогда
							Обл = макет.ПолучитьОбласть("ФондыСтрока_подр");
						Иначе
							Обл = макет.ПолучитьОбласть("ФондыСтрока");
						КонецЕсли;
						ЗаполнитьЗначенияСвойств(обл.параметры, стрФонд);
						Если стрФонд.Лимит > 0 Тогда
							обл.параметры.Фонд =  строка(стрФонд.Фонд) + " ( лимит " + формат(стрФонд.Лимит,"ЧДЦ=2") + " )";
						КонецЕсли;
						ТабДок.Вывести(обл);
						
						НачальныйОстаток = НачальныйОстаток + стрФонд.НачальныйОстаток;
						Приход = Приход + стрФонд.Приход;
						Расход = Расход + стрФонд.Расход;
						КонечныйОстаток = КонечныйОстаток + стрФонд.КонечныйОстаток;
					КонецЦикла;
					
					Обл = макет.ПолучитьОбласть("ФондыИтого");
					обл.параметры.НачальныйОстаток = НачальныйОстаток;
					обл.параметры.Приход = Приход;
					обл.параметры.Расход = Расход;
					обл.параметры.КонечныйОстаток = КонечныйОстаток;
					ТабДок.Вывести(обл);
				КонецЦикла;
			КонецЕсли;
			
			/////////// ФОНДЫ ДЕТАЛИЗАЦИЯ
			ВыводитьДетализациюФонды = Настройки[2].Выбрать;
			
			Если ВыводитьДетализациюФонды тогда
				Обл = макет.ПолучитьОбласть("ДетализацияШапка");
				ТабДок.Вывести(обл);
				
				Если ПодрДетализация Тогда				
					тзПодр = тз_счетаФонды.Скопировать();
					тзПодр.Свернуть("Подразделение");
					Для каждого стрподр из тзПодр Цикл
						Обл = макет.ПолучитьОбласть("ДетализацияШапкаПодр");
						обл.параметры.Подразделение = "Подразделение: " + стрподр.Подразделение;					
						ТабДок.Вывести(обл);
						
						СтрокиПодр = тз_счетаФонды.НайтиСтроки(Новый Структура("Подразделение", стрподр.Подразделение));
						ВывестиДетализацию(запрос, макет, табдок, СтрокиПодр, ВсеОперации, ДатаНачала, стрподр.Подразделение);
					КонецЦикла;
				Иначе
					Если ДоходыПодр Тогда
						СтрокиПодр = тз_счетаФонды.НайтиСтроки(Новый Структура("Подразделение", стрподрДоход.Подразделение));
						ВывестиДетализацию(запрос, макет, табдок, СтрокиПодр, ВсеОперации, ДатаНачала, стрподрДоход.Подразделение);
					Иначе
						СтрокиПодр = тз_счетаФонды; 
						ВывестиДетализацию(запрос, макет, табдок, СтрокиПодр, ВсеОперации, ДатаНачала);
					КонецЕсли;										
				КонецЕсли;
			КонецЕсли;
		КонецЦикла; // по Подразделениям
	КонецЦикла; // по организациям
	
	Обл = макет.ПолучитьОбласть("Подвал");
	ТабДок.Вывести(обл);
	
	ТабДок.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	ТабДок.АвтоМасштаб = Истина;
	
	Элементы.ТабДок.РежимМасштабированияПросмотра = РежимМасштабированияПросмотра.Обычный;
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ВывестиДетализацию(запрос, макет, табдок, тз_счетаФонды, ВсеОперации, ДатаНачала, ОтборПодр = Неопределено)
	для каждого стрФонд из тз_счетаФонды Цикл
		Если ВсеОперации Тогда
			Обл = макет.ПолучитьОбласть("ДетализацияШапкаФонд");
		Иначе
			Обл = макет.ПолучитьОбласть("ДетализацияШапкаФондБезОстатка");
		КонецЕсли;
		Обл.Параметры.Фонд = стрФонд.Фонд;
		Если стрФонд.Лимит > 0 Тогда
			обл.параметры.Фонд =  строка(стрФонд.Фонд) + " ( лимит " + формат(стрФонд.Лимит,"ЧДЦ=2") + " )";
		КонецЕсли;
		ТабДок.Вывести(обл);

		// начальный остаток
		ВхОст = стрФонд.НачальныйОстаток; 
		
		Если ВсеОперации Тогда					
			Обл = макет.ПолучитьОбласть("ДетализацияСтрока");
			обл.параметры.Период = ДатаНачала;
			обл.параметры.Операция = "Остаток на начало периода";
			обл.параметры.Остаток = ВхОст;
			ТабДок.Вывести(обл);
		КонецЕсли;
		
		запрос.Текст = "ВЫБРАТЬ
		               |	ИА_СредстваНаФондах.Период КАК Период,
		               |	ИА_СредстваНаФондах.Регистратор КАК Регистратор,
		               |	ИА_СредстваНаФондах.ВидДвижения КАК ВидДвижения,
		               |	ВЫБОР
		               |		КОГДА ИА_СредстваНаФондах.ВидДвижения = ЗНАЧЕНИЕ(видДвиженияНакопления.Приход)
		               |			ТОГДА ИА_СредстваНаФондах.СуммаБезнал
		               |		ИНАЧЕ 0
		               |	КОНЕЦ КАК Приход,
		               |	ВЫБОР
		               |		КОГДА ИА_СредстваНаФондах.ВидДвижения = ЗНАЧЕНИЕ(видДвиженияНакопления.Расход)
		               |			ТОГДА ИА_СредстваНаФондах.СуммаБезнал
		               |		ИНАЧЕ 0
		               |	КОНЕЦ КАК Расход,
		               |	ИА_СредстваНаФондах.Операция КАК Операция,
		               |	ИА_СредстваНаФондах.ПояснениеТекст КАК ПояснениеТЕкст,
		               |	ИА_СредстваНаФондах.ПояснениеСсылка КАК ПояснениеСсылка
		               |ИЗ
		               |	РегистрНакопления.ИА_СредстваНаФондах КАК ИА_СредстваНаФондах
		               |ГДЕ
		               |	ИА_СредстваНаФондах.Период МЕЖДУ &ДатаНачала И &ДатаКонца
		               |	И ИА_СредстваНаФондах.Организация = &Организация
		               |	И (ИА_СредстваНаФондах.Подразделение = &ОтборПодр ИЛИ &ОтборПодр = НЕОПРЕДЕЛЕНО)
					   |	И ИА_СредстваНаФондах.Фонд = &Фонд
		               |	И ИА_СредстваНаФондах.Операция В(&Операции)
		               |
		               |УПОРЯДОЧИТЬ ПО
		               |	ИА_СредстваНаФондах.Период";
		Запрос.УстановитьПараметр("Фонд", стрФонд.Фонд);
		Запрос.УстановитьПараметр("ОтборПодр", ОтборПодр);
		
		тзДетал = запрос.Выполнить().Выгрузить();
		Для каждого стрДет из тзДетал Цикл
			ВхОст = ВхОст + стрДет.Приход - стрДет.Расход;
			
			Если ВсеОперации Тогда
				Обл = макет.ПолучитьОбласть("ДетализацияСтрока");
			Иначе
				Обл = макет.ПолучитьОбласть("ДетализацияСтрокаБезОстатка");
			КонецЕсли;

			ЗаполнитьЗначенияСвойств(обл.параметры, стрДет);
			обл.параметры.ПояснениеТекст = стрДет.ПояснениеТЕкст + " " + стрДет.ПояснениеСсылка; 
			Если ВсеОперации тогда
				обл.параметры.Остаток = ВхОст;
			КонецЕсли;
			ТабДок.Вывести(обл);
		КонецЦикла;
		
		Если ВсеОперации Тогда
			Обл = макет.ПолучитьОбласть("ДетализацияИтого");
		Иначе
			Обл = макет.ПолучитьОбласть("ДетализацияИтогоБезОстатка");
		КонецЕсли;

		обл.параметры.Приход = тзДетал.итог("Приход");
		обл.параметры.Расход = тзДетал.итог("Расход");
		Если ВсеОперации тогда
			обл.параметры.Остаток = ВхОст;
		КонецЕсли;
		ТабДок.Вывести(обл);
	КонецЦикла;
КонецПроцедуры
	
