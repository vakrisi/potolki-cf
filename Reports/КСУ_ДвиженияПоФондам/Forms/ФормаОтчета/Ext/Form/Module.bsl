	если ДатаНачала = Дата(1,1,1) или ДатаКонца = Дата(1,1,1) ТОгда
		ПоказатьПредупреждение(,"Заполните период отчета!");
		Возврат;
	КонецЕсли;
	
	СформироватьНаСервере();
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ЗаполнитьНастройки();
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьНастройки()
	НовстрН = Настройки.Добавить();
	НовстрН.Настройка = "Сводные данные по счетам";
	НовстрН.Выбрать = истина;
	
	НовстрН = Настройки.Добавить();
	НовстрН.Настройка = "Сводные данные по фондам";
	НовстрН.Выбрать = истина;
	
	НовстрН = Настройки.Добавить();
	НовстрН.Настройка = "Детализация по фондам";
	НовстрН.Выбрать = истина;
	
	//
	МассОрг = ИА_ФПСервер.ПолучитьОрганизацииДляОтчетов();
	Для каждого орг из МассОрг Цикл
		НовстрН = Организации.Добавить();
		НовстрН.Организация = орг;
		НовстрН.Выбрать = истина;
	КонецЦикла;
	Если не Константы.ИА_ФП_ВестиФППоОрганизациям.Получить() Тогда
		НовстрН = Организации.Добавить();
		НовстрН.Организация = Справочники.Организации.ПустаяСсылка();
		НовстрН.Выбрать = истина;
	КонецЕсли;
	
	//
	ЭтоРСФ = иа_фп.ЭтоРСФ();
	Выборка= Справочники.ИА_Фонды.Выбрать(,,,"Наименование");
	Пока выборка.Следующий() Цикл
		Если не выборка.ПометкаУдаления Тогда
			Если ЭтоРСФ или выборка.Защищенный = ложь Тогда
				НовстрН = Фонды.Добавить();
				НовстрН.Фонд = Выборка.Ссылка;
				НовстрН.Выбрать = истина;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	//
	для каждого во из Перечисления.КСУ_ОперацииПоФондам Цикл		
		НовстрН = ВидыОпераций.Добавить();
		НовстрН.ВидОперации = во;
		НовстрН.Выбрать = истина;		
	КонецЦикла;
	
	НовстрН = ВидыОпераций.Добавить();
	НовстрН.ВидОперации = Перечисления.КСУ_ОперацииПоФондам.ПустаяСсылка();
	НовстрН.Выбрать = истина;		
КонецПроцедуры


