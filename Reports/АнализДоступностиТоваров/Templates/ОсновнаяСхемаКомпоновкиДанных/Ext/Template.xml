////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗРЕШЕННЫЕ
	ПеремещениеТоваровТовары.Ссылка.Организация КАК Организация,
	ПеремещениеТоваровТовары.Ссылка.СкладПолучатель КАК Склад,
	ПеремещениеТоваровТовары.Номенклатура КАК Номенклатура,
	ПеремещениеТоваровТовары.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	ПеремещениеТоваровТовары.СерияНоменклатуры КАК СерияНоменклатуры,
	СУММА(ПеремещениеТоваровТовары.Количество) КАК Количество
ПОМЕСТИТЬ ВТ_ТоварыВПути
ИЗ
	Документ.ПеремещениеТоваров.Товары КАК ПеремещениеТоваровТовары
ГДЕ
	(ПеремещениеТоваровТовары.Ссылка.ТекущийСтатус = ЗНАЧЕНИЕ(Перечисление.СтатусыПеремещений.Собран)
			ИЛИ ПеремещениеТоваровТовары.Ссылка.ТекущийСтатус = ЗНАЧЕНИЕ(Перечисление.СтатусыПеремещений.Отправлен))

СГРУППИРОВАТЬ ПО
	ПеремещениеТоваровТовары.Ссылка.СкладПолучатель,
	ПеремещениеТоваровТовары.СерияНоменклатуры,
	ПеремещениеТоваровТовары.ХарактеристикаНоменклатуры,
	ПеремещениеТоваровТовары.Номенклатура,
	ПеремещениеТоваровТовары.Ссылка.Организация
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗРЕШЕННЫЕ
	ЕСТЬNULL(ЕСТЬNULL(ТоварыНаСкладахОстатки.Организация, ОжидаемыеПоставки.Организация), ВТ_ТоварыВПути.Организация) КАК Организация,
	ЕСТЬNULL(ЕСТЬNULL(ТоварыНаСкладахОстатки.Склад, ОжидаемыеПоставки.Склад), ВТ_ТоварыВПути.Склад) КАК Склад,
	ЕСТЬNULL(ЕСТЬNULL(ТоварыНаСкладахОстатки.Номенклатура, ОжидаемыеПоставки.Номенклатура), ВТ_ТоварыВПути.Номенклатура) КАК Номенклатура,
	ЕСТЬNULL(ЕСТЬNULL(ТоварыНаСкладахОстатки.ХарактеристикаНоменклатуры, ОжидаемыеПоставки.ХарактеристикаНоменклатуры), ВТ_ТоварыВПути.ХарактеристикаНоменклатуры) КАК ХарактеристикаНоменклатуры,
	ЕСТЬNULL(ЕСТЬNULL(ТоварыНаСкладахОстатки.СерияНоменклатуры, ВТ_ТоварыВПути.СерияНоменклатуры), ЗНАЧЕНИЕ(Справочник.СерииНоменклатуры.ПустаяСсылка)) КАК СерияНоменклатуры,
	ЕСТЬNULL(ТоварыНаСкладахОстатки.КоличествоОстаток, 0) КАК КоличествоОстаток,
	ЕСТЬNULL(ТоварыВРезервеНаСкладахОстатки.КоличествоОстаток, 0) КАК КоличествоВРезерве,
	ЕСТЬNULL(ОжидаемыеПоставки.КоличествоОстаток, 0) КАК КоличествоОжидаемыеПоставки,
	ЕСТЬNULL(ВТ_ТоварыВПути.Количество, 0) КАК КоличествоВПути,
	ЕСТЬNULL(ТоварыНаСкладахОстатки.КоличествоОстаток, 0) + ЕСТЬNULL(ОжидаемыеПоставки.КоличествоОстаток, 0) + ЕСТЬNULL(ВТ_ТоварыВПути.Количество, 0) КАК КоличествоИтого
ИЗ
	РегистрНакопления.ТоварыНаСкладах.Остатки(, ) КАК ТоварыНаСкладахОстатки
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыВРезервеНаСкладах.Остатки(, ) КАК ТоварыВРезервеНаСкладахОстатки
		ПО ТоварыНаСкладахОстатки.Организация = ТоварыВРезервеНаСкладахОстатки.Организация
			И ТоварыНаСкладахОстатки.Склад = ТоварыВРезервеНаСкладахОстатки.Склад
			И ТоварыНаСкладахОстатки.Номенклатура = ТоварыВРезервеНаСкладахОстатки.Номенклатура
			И ТоварыНаСкладахОстатки.ХарактеристикаНоменклатуры = ТоварыВРезервеНаСкладахОстатки.ХарактеристикаНоменклатуры
			И ТоварыНаСкладахОстатки.СерияНоменклатуры = ТоварыВРезервеНаСкладахОстатки.СерияНоменклатуры
		ПОЛНОЕ СОЕДИНЕНИЕ ВТ_ОжидаемыеПоставки КАК ОжидаемыеПоставки
		ПО ТоварыНаСкладахОстатки.Организация = ОжидаемыеПоставки.Организация
			И ТоварыНаСкладахОстатки.Склад = ОжидаемыеПоставки.Склад
			И ТоварыНаСкладахОстатки.Номенклатура = ОжидаемыеПоставки.Номенклатура
			И ТоварыНаСкладахОстатки.ХарактеристикаНоменклатуры = ОжидаемыеПоставки.ХарактеристикаНоменклатуры
		ПОЛНОЕ СОЕДИНЕНИЕ ВТ_ТоварыВПути КАК ВТ_ТоварыВПути
		ПО ТоварыНаСкладахОстатки.Организация = ВТ_ТоварыВПути.Организация
			И ТоварыНаСкладахОстатки.Склад = ВТ_ТоварыВПути.Склад
			И ТоварыНаСкладахОстатки.Номенклатура = ВТ_ТоварыВПути.Номенклатура
			И ТоварыНаСкладахОстатки.ХарактеристикаНоменклатуры = ВТ_ТоварыВПути.ХарактеристикаНоменклатуры
			И ТоварыНаСкладахОстатки.СерияНоменклатуры = ВТ_ТоварыВПути.СерияНоменклатуры</query>
	</dataSet>
