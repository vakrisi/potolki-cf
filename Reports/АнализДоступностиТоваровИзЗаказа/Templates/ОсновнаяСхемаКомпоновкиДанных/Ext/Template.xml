		<query>ВЫБРАТЬ РАЗРЕШЕННЫЕ
	ВЫБОР
		КОГДА &amp;ОбщиеСклады
			ТОГДА ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
		ИНАЧЕ ЗаказыПоставщикамОстатки.Организация
	КОНЕЦ КАК Организация,
	ЗаказыПоставщикамОстатки.ЗаказПоставщику.Склад КАК Склад,
	ЗаказыПоставщикамОстатки.Номенклатура КАК Номенклатура,
	ЗаказыПоставщикамОстатки.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	СУММА(ЗаказыПоставщикамОстатки.КоличествоОстаток) КАК КоличествоОстаток
ПОМЕСТИТЬ ВТ_ОжидаемыеПоставки
ИЗ
	РегистрНакопления.ЗаказыПоставщикам.Остатки(, ) КАК ЗаказыПоставщикамОстатки

СГРУППИРОВАТЬ ПО
	ВЫБОР
		КОГДА &amp;ОбщиеСклады
			ТОГДА ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
		ИНАЧЕ ЗаказыПоставщикамОстатки.Организация
	КОНЕЦ,
	ЗаказыПоставщикамОстатки.ЗаказПоставщику.Склад,
	ЗаказыПоставщикамОстатки.Номенклатура,
	ЗаказыПоставщикамОстатки.ХарактеристикаНоменклатуры
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗРЕШЕННЫЕ
	ЕСТЬNULL(ТоварыНаСкладахОстатки.Организация, ОжидаемыеПоставки.Организация) КАК Организация,
	ЕСТЬNULL(ТоварыНаСкладахОстатки.Склад, ОжидаемыеПоставки.Склад) КАК Склад,
	ЕСТЬNULL(ТоварыНаСкладахОстатки.Номенклатура, ОжидаемыеПоставки.Номенклатура) КАК Номенклатура,
	ЕСТЬNULL(ТоварыНаСкладахОстатки.ХарактеристикаНоменклатуры, ОжидаемыеПоставки.ХарактеристикаНоменклатуры) КАК ХарактеристикаНоменклатуры,
	ЕСТЬNULL(ТоварыНаСкладахОстатки.СерияНоменклатуры, ЗНАЧЕНИЕ(Справочник.СерииНоменклатуры.ПустаяСсылка)) КАК СерияНоменклатуры,
	ЕСТЬNULL(ТоварыНаСкладахОстатки.КоличествоОстаток, 0) КАК КоличествоОстаток,
	ЕСТЬNULL(ТоварыВРезервеНаСкладахОстатки.КоличествоОстаток, 0) КАК КоличествоВРезерве,
	ЕСТЬNULL(ОжидаемыеПоставки.КоличествоОстаток, 0) КАК КоличествоОжидаемыеПоставки,
	ЕСТЬNULL(ТоварыНаСкладахОстатки.КоличествоОстаток, 0) + ЕСТЬNULL(ОжидаемыеПоставки.КоличествоОстаток, 0) КАК КоличествоИтого,
	ВЫБОР
		КОГДА ЕСТЬNULL(ТоварыНаСкладахОстатки.Склад, ОжидаемыеПоставки.Склад) = &amp;ВыбСклад
			ТОГДА 0
		ИНАЧЕ 100
	КОНЕЦ КАК Порядок
ИЗ
	РегистрНакопления.ТоварыНаСкладах.Остатки(, ) КАК ТоварыНаСкладахОстатки
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыВРезервеНаСкладах.Остатки(, ) КАК ТоварыВРезервеНаСкладахОстатки
		ПО ТоварыНаСкладахОстатки.Организация = ТоварыВРезервеНаСкладахОстатки.Организация
			И ТоварыНаСкладахОстатки.Склад = ТоварыВРезервеНаСкладахОстатки.Склад
			И ТоварыНаСкладахОстатки.Номенклатура = ТоварыВРезервеНаСкладахОстатки.Номенклатура
			И ТоварыНаСкладахОстатки.ХарактеристикаНоменклатуры = ТоварыВРезервеНаСкладахОстатки.ХарактеристикаНоменклатуры
			И ТоварыНаСкладахОстатки.СерияНоменклатуры = ТоварыВРезервеНаСкладахОстатки.СерияНоменклатуры
		ПОЛНОЕ СОЕДИНЕНИЕ ВТ_ОжидаемыеПоставки КАК ОжидаемыеПоставки
		ПО ТоварыНаСкладахОстатки.Организация = ОжидаемыеПоставки.Организация
			И ТоварыНаСкладахОстатки.Склад = ОжидаемыеПоставки.Склад
			И ТоварыНаСкладахОстатки.Номенклатура = ОжидаемыеПоставки.Номенклатура
			И ТоварыНаСкладахОстатки.ХарактеристикаНоменклатуры = ОжидаемыеПоставки.ХарактеристикаНоменклатуры</query>
	</dataSet>
