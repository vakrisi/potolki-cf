		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	Фактура.Ссылка КАК Фактура,
	ЦветФактуры.Ссылка КАК Цвет,
	ВидыЦен.Ссылка КАК ВидЦен,
	ВидыНоменклатуры.Ссылка КАК ВидНоменклатуры
ПОМЕСТИТЬ ФактураИЦвет
ИЗ
	Справочник.Фактура КАК Фактура
		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ЦветФактуры КАК ЦветФактуры
		ПО Фактура.Ссылка = ЦветФактуры.Владелец,
	Справочник.ВидыЦен КАК ВидыЦен,
	Справочник.ВидыНоменклатуры КАК ВидыНоменклатуры
ГДЕ
	(ВидыНоменклатуры.Ссылка = ЗНАЧЕНИЕ(Справочник.ВидыНоменклатуры.Потолок)
			ИЛИ ВидыНоменклатуры.Ссылка = ЗНАЧЕНИЕ(Справочник.ВидыНоменклатуры.Отрез))
	И НЕ Фактура.ЭтоГруппа
;

