		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ РАЗРЕШЕННЫЕ
	ВЫБОР
		КОГДА ИА_ЗадачаПланаДействий.Выполнена
			ТОГДА ВЫБОР
					КОГДА ИА_ЗадачаПланаДействий.Исполнитель = ЗНАЧЕНИЕ(Справочник.Пользователи.ПустаяСсылка)
						ТОГДА ИА_ЗадачаПланаДействий.Пользователь
					ИНАЧЕ ИА_ЗадачаПланаДействий.Исполнитель
				КОНЕЦ
		ИНАЧЕ ВЫБОР
				КОГДА ИА_ЗадачаПланаДействий.Пост = ЗНАЧЕНИЕ(Справочник.ОргСхема.ПустаяСсылка)
					ТОГДА ИА_ЗадачаПланаДействий.Пользователь
				ИНАЧЕ ИА_ЗадачаПланаДействий.Пост
			КОНЕЦ
	КОНЕЦ КАК Исполнитель,
	ИА_ЗадачаПланаДействий.Наименование КАК Тема,
	ИА_ЗадачаПланаДействий.Автор КАК Автор,
	ИА_ЗадачаПланаДействий.Дата КАК ДатаПостановки,
	ИА_ЗадачаПланаДействий.СрокИсполнения КАК ПланИсполнение,
	ИА_ЗадачаПланаДействий.ДатаВыполнения КАК ФактВыполнение,
	ВЫБОР
		КОГДА ИА_ЗадачаПланаДействий.ДатаВыполнения = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
			ТОГДА ВЫБОР
					КОГДА ИА_ЗадачаПланаДействий.СрокИсполнения &lt;&gt; ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
						ТОГДА ВЫБОР
								КОГДА РАЗНОСТЬДАТ(ИА_ЗадачаПланаДействий.СрокИсполнения, &amp;ТекущаяДата, ДЕНЬ) &gt; 0
									ТОГДА РАЗНОСТЬДАТ(ИА_ЗадачаПланаДействий.СрокИсполнения, &amp;ТекущаяДата, ДЕНЬ)
								ИНАЧЕ 0
							КОНЕЦ
					ИНАЧЕ 0
				КОНЕЦ
		ИНАЧЕ ВЫБОР
				КОГДА ИА_ЗадачаПланаДействий.СрокИсполнения &lt;&gt; ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
					ТОГДА ВЫБОР
							КОГДА РАЗНОСТЬДАТ(ИА_ЗадачаПланаДействий.СрокИсполнения, ИА_ЗадачаПланаДействий.ДатаВыполнения, ДЕНЬ) &gt; 0
								ТОГДА РАЗНОСТЬДАТ(ИА_ЗадачаПланаДействий.СрокИсполнения, ИА_ЗадачаПланаДействий.ДатаВыполнения, ДЕНЬ)
							ИНАЧЕ 0
						КОНЕЦ
				ИНАЧЕ 0
			КОНЕЦ
	КОНЕЦ КАК Просрочка,
	ВЫБОР
		КОГДА ИА_ЗадачаПланаДействий.ДатаВыполнения &lt;&gt; ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
				И ИА_ЗадачаПланаДействий.СрокИсполнения &lt;&gt; ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
			ТОГДА ВЫБОР
					КОГДА РАЗНОСТЬДАТ(ИА_ЗадачаПланаДействий.СрокИсполнения, ИА_ЗадачаПланаДействий.ДатаВыполнения, ДЕНЬ) &gt; 0
						ТОГДА 0
					ИНАЧЕ 100
				КОНЕЦ
		КОГДА ИА_ЗадачаПланаДействий.ДатаВыполнения &lt;&gt; ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
				И ИА_ЗадачаПланаДействий.СрокИсполнения = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
			ТОГДА 100
		ИНАЧЕ 0
	КОНЕЦ КАК ПроцентВыполнения,
	ИА_ЗадачаПланаДействий.Ссылка КАК Задача,
	ВЫБОР
		КОГДА ИА_ЗадачаПланаДействий.Выполнена
			ТОГДА 1
		ИНАЧЕ ВЫБОР
				КОГДА ИА_ЗадачаПланаДействий.Пост = ЗНАЧЕНИЕ(Справочник.ОргСхема.ПустаяСсылка)
					ТОГДА 1
				ИНАЧЕ 0
			КОНЕЦ
	КОНЕЦ КАК ПорядокВывода
ИЗ
	Задача.ИА_ЗадачаПланаДействий КАК ИА_ЗадачаПланаДействий
ГДЕ
	ВЫБОР
			КОГДА &amp;ДатаКонца &gt; ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
				ТОГДА ИА_ЗадачаПланаДействий.Дата МЕЖДУ &amp;ДатаНачала И &amp;ДатаКонца
			ИНАЧЕ ИА_ЗадачаПланаДействий.Дата МЕЖДУ &amp;ДатаНачала И ДАТАВРЕМЯ(2999, 1, 1, 0, 0, 0)
		КОНЕЦ
	И ИА_ЗадачаПланаДействий.ЭтоПослание = ЛОЖЬ</query>
	</dataSet>
