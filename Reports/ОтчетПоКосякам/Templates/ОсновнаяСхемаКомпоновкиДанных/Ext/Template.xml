		<query>ВЫБРАТЬ РАЗРЕШЕННЫЕ
	Контрагенты.Ссылка КАК Дилер
ПОМЕСТИТЬ ВТ_Дилер
ИЗ
	Справочник.Контрагенты КАК Контрагенты
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗРЕШЕННЫЕ
	ПродажиОбороты.Контрагент КАК Контрагент,
	СУММА(ПродажиОбороты.СуммаОборот) КАК СуммаОборот
ПОМЕСТИТЬ ВТ_Оборот
ИЗ
	РегистрНакопления.Продажи.Обороты(&amp;Д1, &amp;Д2, , ) КАК ПродажиОбороты

СГРУППИРОВАТЬ ПО
	ПродажиОбороты.Контрагент
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗРЕШЕННЫЕ
	ЗаказПокупателя.Контрагент КАК Контрагент,
	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ЗаказПокупателя.Ссылка) КАК КоличествоЗаказов,
	СУММА(ВЫБОР
			КОГДА ЗаказПокупателя.КосячныйЗаказ
				ТОГДА 1
			ИНАЧЕ 0
		КОНЕЦ) КАК КоличествоКосячныхЗаказов,
	ВЫБОР
		КОГДА КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ЗаказПокупателя.Ссылка) = 0
			ТОГДА 0
		ИНАЧЕ СУММА(ВЫБОР
					КОГДА ЗаказПокупателя.КосячныйЗаказ
						ТОГДА 1
					ИНАЧЕ 0
				КОНЕЦ) / КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ЗаказПокупателя.Ссылка)
	КОНЕЦ * 100 КАК ПроцентКосяков
ПОМЕСТИТЬ ВТ_Заказы
ИЗ
	Документ.ЗаказПокупателя КАК ЗаказПокупателя
ГДЕ
	ЗаказПокупателя.ТекущийСтатус = ЗНАЧЕНИЕ(Справочник.СтатусыЗаказовПокупателей.Выполнен)
	И ЗаказПокупателя.Дата МЕЖДУ &amp;Д1 И &amp;Д2

СГРУППИРОВАТЬ ПО
	ЗаказПокупателя.Контрагент
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗРЕШЕННЫЕ
	ЗаказПокупателя.Контрагент КАК Контрагент,
	МАКСИМУМ(ЗаказПокупателя.Дата) КАК ДатаПоследнегоКосяка
ПОМЕСТИТЬ ВТ_ДатыЗаказовСКосяком
ИЗ
	Документ.ЗаказПокупателя КАК ЗаказПокупателя
ГДЕ
	ЗаказПокупателя.ТекущийСтатус = ЗНАЧЕНИЕ(Справочник.СтатусыЗаказовПокупателей.Выполнен)
	И ЗаказПокупателя.Дата МЕЖДУ &amp;Д1 И &amp;Д2
	И ЗаказПокупателя.КосячныйЗаказ

СГРУППИРОВАТЬ ПО
	ЗаказПокупателя.Контрагент
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗРЕШЕННЫЕ
	ЗаказПокупателя.Контрагент КАК Контрагент,
	ЗаказПокупателя.Дата КАК Дата
ПОМЕСТИТЬ ВТ_ДатыЗаказов
ИЗ
	Документ.ЗаказПокупателя КАК ЗаказПокупателя
ГДЕ
	ЗаказПокупателя.ТекущийСтатус = ЗНАЧЕНИЕ(Справочник.СтатусыЗаказовПокупателей.Выполнен)
	И ЗаказПокупателя.Дата МЕЖДУ &amp;Д1 И &amp;Д2

СГРУППИРОВАТЬ ПО
	ЗаказПокупателя.Контрагент,
	ЗаказПокупателя.Дата
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗРЕШЕННЫЕ
	ВТ_Дилер.Дилер КАК Дилер,
	ВТ_Оборот.СуммаОборот КАК СуммаОборот,
	ВТ_Заказы.КоличествоЗаказов КАК КоличествоЗаказов,
	ВТ_Заказы.КоличествоКосячныхЗаказов КАК КоличествоКосячныхЗаказов,
	ВТ_Заказы.ПроцентКосяков КАК ПроцентКосяков,
	ВТ_ДатыЗаказовСКосяком.ДатаПоследнегоКосяка КАК ДатаПоследнегоКосяка,
	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВТ_ДатыЗаказов.Дата) КАК КоличествоЗаказовПослеКосяка,
	РАЗНОСТЬДАТ(ВТ_ДатыЗаказовСКосяком.ДатаПоследнегоКосяка, &amp;ТекущаяДата, ДЕНЬ) КАК КоличествоДнейПослеКосяка
{ВЫБРАТЬ
	Дилер.*,
	СуммаОборот,
	КоличествоЗаказов,
	КоличествоКосячныхЗаказов,
	ПроцентКосяков,
	ДатаПоследнегоКосяка,
	КоличествоЗаказовПослеКосяка,
	КоличествоДнейПослеКосяка}
ИЗ
	ВТ_Дилер КАК ВТ_Дилер
		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Оборот КАК ВТ_Оборот
		ПО ВТ_Дилер.Дилер = ВТ_Оборот.Контрагент
		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Заказы КАК ВТ_Заказы
		ПО ВТ_Дилер.Дилер = ВТ_Заказы.Контрагент
		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ДатыЗаказовСКосяком КАК ВТ_ДатыЗаказовСКосяком
		ПО ВТ_Дилер.Дилер = ВТ_ДатыЗаказовСКосяком.Контрагент
		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ДатыЗаказов КАК ВТ_ДатыЗаказов
		ПО ВТ_Дилер.Дилер = ВТ_ДатыЗаказов.Контрагент
			И (ВТ_ДатыЗаказовСКосяком.ДатаПоследнегоКосяка &lt; ВТ_ДатыЗаказов.Дата)
{ГДЕ
	ВТ_Дилер.Дилер.*,
	ВТ_Заказы.КоличествоЗаказов,
	ВТ_Заказы.КоличествоКосячныхЗаказов,
	ВТ_Заказы.ПроцентКосяков,
	ВТ_Оборот.СуммаОборот,
	ВТ_ДатыЗаказовСКосяком.ДатаПоследнегоКосяка}

СГРУППИРОВАТЬ ПО
	ВТ_Дилер.Дилер,
	ВТ_Оборот.СуммаОборот,
	ВТ_Заказы.КоличествоЗаказов,
	ВТ_Заказы.КоличествоКосячныхЗаказов,
	ВТ_Заказы.ПроцентКосяков,
	ВТ_ДатыЗаказовСКосяком.ДатаПоследнегоКосяка</query>
		<autoFillFields>false</autoFillFields>
	</dataSet>
	<totalField>
		<dataPath>КоличествоЗаказов</dataPath>
		<expression>Сумма(КоличествоЗаказов)</expression>
	</totalField>
	<totalField>
		<dataPath>КоличествоКосячныхЗаказов</dataPath>
		<expression>Сумма(КоличествоКосячныхЗаказов)</expression>
	</totalField>
	<totalField>
		<dataPath>ПроцентКосяков</dataPath>
		<expression>ВЫБОР КОГДА Сумма(КоличествоЗаказов) - 0 ТОГДА 0 ИНАЧЕ Сумма(КоличествоКосячныхЗаказов)/Сумма(КоличествоЗаказов)* 100 КОНЕЦ</expression>
	</totalField>
