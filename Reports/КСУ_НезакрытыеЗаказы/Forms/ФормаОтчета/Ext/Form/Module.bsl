КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьПредставлениеРегистраторов(заказ, доДаты)
	
	Запрос = новый запрос;
	запрос.Текст = "ВЫБРАТЬ
	               |	ИА_СредстваВРезервеНаФондахОбороты.Регистратор КАК Регистратор,
	               |	ИА_СредстваВРезервеНаФондахОбороты.Регистратор.Номер КАК Номер,
	               |	ИА_СредстваВРезервеНаФондахОбороты.СуммаБезналПриход КАК СуммаБезналПриход,
	               |	ИА_СредстваВРезервеНаФондахОбороты.СуммаБезналРасход КАК СуммаБезналРасход
	               |ИЗ
	               |	РегистрНакопления.ИА_СредстваВРезервеНаФондах.Обороты(, &ДоДаты, Регистратор, ЗП = &ЗП) КАК ИА_СредстваВРезервеНаФондахОбороты
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ИА_СредстваВРезервеНаФондахОбороты.Период";
	Запрос.УстановитьПараметр("ЗП", заказ);
	Запрос.УстановитьПараметр("доДаты", доДаты);
	Выборка = запрос.Выполнить().Выбрать();
	
	рез = "";
	масс = новый массив;
	Пока выборка.Следующий() цикл
		Если рез <> "" Тогда
			рез = рез + ", ";
		КонецЕсли;
		ном = УбратьНули(выборка.Номер);
		
		Предст = "";
		Если ТипЗнч(Выборка.Регистратор) = тип("ДокументСсылка.ИА_ФинансовоеПланирование") Тогда
			Предст = "ФП №"+ном;
		ИначеЕсли ТипЗнч(Выборка.Регистратор) = тип("ДокументСсылка.КСУ_ВнедоходноеПоступлениеСредств") Тогда
			Предст = "ВДПС №"+ном;
		ИначеЕсли ТипЗнч(Выборка.Регистратор) = тип("ДокументСсылка.КСУ_ФормальнаяВыплата") Тогда
			Предст = "Форм. выплата №"+ном;
		ИначеЕсли ТипЗнч(Выборка.Регистратор) = тип("ДокументСсылка.ИА_ЗакрытиеЗаказаНаПриобретение") Тогда
			Предст = "Закрытие №"+ном;
		ИначеЕсли Выборка.СуммаБезналПриход > 0 Тогда
			Предст = "Возврат №"+ном;
		Иначе
			Предст = "Выплата №"+ном;
		КонецЕсли;
		
		рез = рез + Предст;
		масс.Добавить(Выборка.Регистратор);
	КонецЦикла;
	
	РезСтрукт = Новый Структура("Регистраторы, РегистраторыМассив", рез, масс); 
	
	возврат РезСтрукт;
КонецФункции

&НаСервереБезКонтекста
Функция УбратьНули(номер)
	рез = номер; 
	Пока Лев(рез, 1) = "0" Цикл 
	    рез = Прав(рез, СтрДлина(рез) - 1);
	КонецЦикла;
	Возврат рез;
КонецФункции

&НаСервереБезКонтекста
Процедура ВывестиСводнуюТаблицу(макет, табдок, тз, группировка, заголовок, заголовокКолонки, ДопГруппировка = "")

	Обл = макет.ПолучитьОбласть("СводноШапка");
	обл.параметры.заголовок = заголовок;
	обл.параметры.заголовокКолонки = заголовокКолонки;
	ТабДок.Вывести(обл);
	
	тзДетал = тз.Скопировать();
	тзДетал.Свернуть(группировка, "СуммаЗаказа, Одобрено, Выплачено, ОсталосьВыплатитьОдобр, ОсталосьОдобрить, ОсталосьВыплатить");
	
	Для каждого стрДет из тзДетал Цикл	
		Если ДопГруппировка = "" Тогда
			Обл = макет.ПолучитьОбласть("СводноСтрока");		
		Иначе
			Обл = макет.ПолучитьОбласть("СводноСтрокаГруппировка");		
		КонецЕсли;
		ЗаполнитьЗначенияСвойств(обл.параметры, стрДет);
		обл.параметры.Группировка = стрДет[группировка]; 
		ТабДок.Вывести(обл);
		
		Если ДопГруппировка <> "" Тогда
			тзДетал1 = тз.Скопировать();
			Сч = тзДетал1.Количество() - 1;
			Пока сч >=0 Цикл
				если тзДетал1[сч][группировка] <> стрДет[группировка] Тогда
					тзДетал1.Удалить(сч);
				КонецЕсли;				
				сч = сч - 1;
			КонецЦикла;
			тзДетал1.Свернуть(ДопГруппировка, "СуммаЗаказа, Одобрено, Выплачено, ОсталосьВыплатитьОдобр, ОсталосьОдобрить, ОсталосьВыплатить");
			Для каждого стрДет1 из тзДетал1 Цикл	
				Обл = макет.ПолучитьОбласть("СводноСтрока");
				ЗаполнитьЗначенияСвойств(обл.параметры, стрДет1);
				обл.параметры.Группировка = стрДет1[ДопГруппировка]; 
				ТабДок.Вывести(обл);
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	
	Обл = макет.ПолучитьОбласть("СводноИтого");
	обл.параметры.СуммаЗаказа = тзДетал.итог("СуммаЗаказа");
	обл.параметры.Одобрено = тзДетал.итог("Одобрено");
	обл.параметры.Выплачено = тзДетал.итог("Выплачено");
	обл.параметры.ОсталосьВыплатитьОдобр = тзДетал.итог("ОсталосьВыплатитьОдобр");
	обл.параметры.ОсталосьОдобрить = тзДетал.итог("ОсталосьОдобрить");
	обл.параметры.ОсталосьВыплатить = тзДетал.итог("ОсталосьВыплатить");
	ТабДок.Вывести(обл);
	
КонецПроцедуры

	
