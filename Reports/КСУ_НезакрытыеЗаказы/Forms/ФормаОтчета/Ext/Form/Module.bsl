
&НаСервере
Процедура СформироватьНаСервере()
	ИспПодр = Константы.КСУ_ФП_ИспользоватьПодразделения.Получить();
	ДоходыПодр = Константы.КСУ_ДоходыПоПодразделениям.Получить();
	ПодрДетализация = ИспПодр и не ДоходыПодр; 
	
	ТабДок.Очистить();
	
	отч = РеквизитФормыВЗначение("Отчет");
	макет = отч.ПолучитьМакет("Макет");
	
	Обл = макет.ПолучитьОбласть("Шапка");
	ТекДата = ТекущаяДата();
	обл.параметры.ДатаОтчета = ТекДата;
	обл.параметры.Период = формат(НаДату,"ДФ=dd.MM.yyyy");
	ТабДок.Вывести(обл);
	
	ЕстьФильтры = ложь;
	ВыбФонды = Новый массив;
	Для каждого стр из Фонды Цикл
		Если стр.выбрать Тогда
			ВыбФонды.Добавить(стр.фонд);
		Иначе
			ЕстьФильтры = Истина;
		КонецЕсли;
	КонецЦикла;
	
	ВыбПодр = Новый массив;
	Для каждого стр из Подразделения Цикл
		Если стр.выбрать Тогда
			ВыбПодр.Добавить(стр.Подразделение);
		Иначе
			ЕстьФильтры = Истина;
		КонецЕсли;
	КонецЦикла;
	
	ВыбОрг = Новый массив;
	Для каждого стр из Организации Цикл
		Если стр.выбрать Тогда
			ВыбОрг.Добавить(стр.Организация);
		Иначе
			ЕстьФильтры = Истина;
		КонецЕсли;
	КонецЦикла;
	
	ВыбОргД = Новый массив;
	Для каждого стр из ОрганизацииДочерние Цикл
		Если стр.выбрать Тогда
			ВыбОргД.Добавить(стр.Организация);
		Иначе
			ЕстьФильтры = Истина;
		КонецЕсли;
	КонецЦикла;
	
	ЧтоТоВыбрано = ложь;
	Для сч =1 по Настройки.Количество() - 1 Цикл
		если Настройки[сч].Выбрать Тогда
			ЧтоТоВыбрано = истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	////////////////////////////////////////////////////////
	
	Если ЕстьФильтры Тогда
		Обл = макет.ПолучитьОбласть("Фильтры");		
		ТабДок.Вывести(обл);
	КонецЕсли;
	
	///////////////////////////////////////////////////////////////////////////	
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("НаДату", КонецДня(НаДату));
	Запрос.УстановитьПараметр("ПредДень", НачалоДня(НаДату-1));
	Запрос.УстановитьПараметр("Фонды", ВыбФонды);
	Запрос.УстановитьПараметр("Подразделения", ВыбПодр);
	Запрос.УстановитьПараметр("Организации", ВыбОрг);
	Запрос.УстановитьПараметр("ОрганизацииД", ВыбОргД);
	Запрос.УстановитьПараметр("РассмНаФП", Перечисления.ИА_СостояниеЗаказа.РассмотретьНаФП);
	Запрос.УстановитьПараметр("ПереносНаСлФП", Перечисления.ИА_СостояниеЗаказа.ПереносНаСледующееФП);
	
	// подготовка данных
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЗаказыОстатки.Организация КАК Организация,
	               |	ЗаказыОстатки.ЗП КАК Заказ,
	               |	ЗаказыОстатки.ЗП.Подразделение КАК Подразделение,
	               |	ЗаказыОстатки.ЗП.Подразделение.Наименование КАК ПодразделениеНаименование,
	               |	ЗаказыОстатки.ЗП.Фонд КАК Фонд,
	               |	ЗаказыОстатки.ЗП.Фонд.Наименование КАК ФондНаименование,
	               |	ЗаказыОстатки.ЗП.Фонд.Счет КАК Счет,
	               |	ЗаказыОстатки.ЗП.Фонд.Счет.Наименование КАК СчетНаименование,
	               |	ЗаказыОстатки.ЗП.Сумма КАК СуммаЗаказа,
	               |	ЕСТЬNULL(ИА_СредстваВРезервеНаФондахОбороты.СуммаБезналПриход, 0) КАК Одобрено,
	               |	ЕСТЬNULL(ИА_СредстваВРезервеНаФондахОбороты.СуммаБезналРасход, 0) КАК Выплачено,
	               |	ЕСТЬNULL(ИА_СредстваВРезервеНаФондахОбороты.СуммаБезналПриход, 0) - ЕСТЬNULL(ИА_СредстваВРезервеНаФондахОбороты.СуммаБезналРасход, 0) КАК ОсталосьВыплатитьОдобр,
	               |	ВЫБОР
	               |		КОГДА ЗаказыОстатки.ЗП.Сумма - ЕСТЬNULL(ИА_СредстваВРезервеНаФондахОбороты.СуммаБезналПриход, 0) > 0
	               |			ТОГДА ЗаказыОстатки.ЗП.Сумма - ЕСТЬNULL(ИА_СредстваВРезервеНаФондахОбороты.СуммаБезналПриход, 0)
	               |		ИНАЧЕ 0
	               |	КОНЕЦ КАК ОсталосьОдобрить,
				   |	ВЫБОР
	               |		КОГДА ЗаказыОстатки.ЗП.Сумма - ЕСТЬNULL(ИА_СредстваВРезервеНаФондахОбороты.СуммаБезналРасход, 0) > 0
	               |			ТОГДА ЗаказыОстатки.ЗП.Сумма - ЕСТЬNULL(ИА_СредстваВРезервеНаФондахОбороты.СуммаБезналРасход, 0)
	               |		ИНАЧЕ 0
	               |	КОНЕЦ КАК ОсталосьВыплатить,
	               |	ЗаказыОстатки.ЗП.Статья КАК Статья,
	               |	ЗаказыОстатки.ЗП.Статья.Наименование КАК СтатьяНаименование,
	               |	ЗаказыОстатки.ЗП.Номер КАК Номер,
	               |	ЗаказыОстатки.ЗП.ПредметЗаказа КАК Предмет,
	               |	ЗаказыОстатки.ЗП.ДатаОплаты КАК СрокОплаты,
	               |	ВЫБОР
	               |		КОГДА ЗаказыОстатки.ЗП.ДатаОплаты <> ДАТАВРЕМЯ(1, 1, 1)
	               |				И ЗаказыОстатки.ЗП.ДатаОплаты <= &ПредДень
	               |			ТОГДА ИСТИНА
	               |		ИНАЧЕ ЛОЖЬ
	               |	КОНЕЦ КАК ЭтоПросрочка,
	               |	РАЗНОСТЬДАТ(ЗаказыОстатки.ЗП.ДатаОплаты, &ПредДень, ДЕНЬ) + 1 КАК Просрочено,
	               |	ИА_ИсторияСтатусовЗВССрезПоследних.Период КАК ДатаДопущен
	               |ИЗ
	               |	РегистрНакопления.ИА_ЗаказыНаПриобретение.Остатки(
	               |			&НаДату,
	               |			Организация В (&Организации)
	               |				И ЗП.ОрганизацияДочерняя В (&ОрганизацииД)
	               |				И ЗП.Фонд В (&Фонды)
	               |				И ЗП.Подразделение В (&Подразделения)) КАК ЗаказыОстатки
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.ИА_СредстваВРезервеНаФондах.Обороты(, &НаДату, , ) КАК ИА_СредстваВРезервеНаФондахОбороты
	               |		ПО ЗаказыОстатки.ЗП = ИА_СредстваВРезервеНаФондахОбороты.ЗП
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИА_ИсторияСтатусовЗВС.СрезПоследних(
	               |				,
	               |				Статус = &РассмНаФП
	               |					ИЛИ Статус = &ПереносНаСлФП) КАК ИА_ИсторияСтатусовЗВССрезПоследних
	               |		ПО ЗаказыОстатки.ЗП = ИА_ИсторияСтатусовЗВССрезПоследних.ЗВС
	               |ГДЕ
	               |	ЗаказыОстатки.ЗП.Сумма - ЕСТЬNULL(ИА_СредстваВРезервеНаФондахОбороты.СуммаБезналРасход, 0) > 0";
	ВсеДанные = запрос.Выполнить().Выгрузить();
	
	//////////
	Если Настройки[0].Выбрать Тогда // Сводно по организациям
		ВывестиСводнуюТаблицу(макет, табдок, ВсеДанные, "Организация", "ОРГАНИЗАЦИЯМ", "ОРГАНИЗАЦИЯ")
	КонецЕсли;
	
	
	Если ЧтоТоВыбрано Тогда
		
		для каждого текОрг из ВыбОрг Цикл
			Обл = макет.ПолучитьОбласть("ГруппаОрганизация");
			обл.параметры.Организация = текОрг;
			ТабДок.Вывести(обл);

			ТекДанные = ВсеДанные.Скопировать();
			Сч = ТекДанные.Количество() - 1;
			Пока сч >=0 Цикл
				если ТекДанные[сч].Организация <> текОрг Тогда
					ТекДанные.Удалить(сч);
				КонецЕсли;				
				сч = сч - 1;
			КонецЦикла;
			
			//
			Если Настройки[1].Выбрать Тогда // Сводно по счетам
				ТекДанные.Сортировать("СчетНаименование");
				ВывестиСводнуюТаблицу(макет, табдок, ТекДанные, "Счет", "СЧЕТАМ", "СЧЕТ ОРГАНИЗАЦИИ")
			КонецЕсли;	
			
			//
			Если Настройки[2].Выбрать Тогда // Сводно по подразделениям
				ТекДанные.Сортировать("ПодразделениеНаименование");
				ВывестиСводнуюТаблицу(макет, табдок, ТекДанные, "Подразделение", "ПОДРАЗДЕЛЕНИЯМ", "ПОДРАЗДЕЛЕНИЕ")
			КонецЕсли;
			
			//
			Если Настройки[3].Выбрать Тогда // Сводно по фондам				
				ТекДанные.Сортировать("ФондНаименование");
				ВывестиСводнуюТаблицу(макет, табдок, ТекДанные, "Фонд", "ФОНДАМ", "ФОНД");				
			КонецЕсли;
			
			//
			Если Настройки[4].Выбрать Тогда // Сводно по фондам и статьям
				ТекДанные.Сортировать("ФондНаименование,СтатьяНаименование");
				ВывестиСводнуюТаблицу(макет, табдок, ТекДанные, "Фонд", "СТАТЬЯМ РАСХОДА", "ФОНД / СТАТЬЯ РАСХОДА", "Статья")
			КонецЕсли;
			
			//////////////////////////
			
			//
			Если Настройки[5].Выбрать Тогда // Список незакрытых заказов
				ТекДанные.Сортировать("Номер");
				ВывестиВсеЗаказы(макет, табдок, ТекДанные, КонецДня(НаДату));
			КонецЕсли;
			
			//
			Если Настройки[6].Выбрать Тогда // список просроченных заказов
				ТекДанные.Сортировать("Просрочено УБЫВ");				
				ВывестиПросроченныеЗаказы(макет, табдок, ТекДанные, КонецДня(НаДату));
			КонецЕсли;
			
			//////////////////////////
			
			//
			Если Настройки[7].Выбрать Тогда // Детализация по фондам (и подразделениям)
				ТекДанные.Сортировать("ФондНаименование, ПодразделениеНаименование");
				ВывестиДетализацию(макет, табдок, ТекДанные, "Фонд", "ФОНДАМ (группировка по подразделениям)", "Подразделение", "Статья расходов", "Статья", КонецДня(НаДату))
			КонецЕсли;
			
			//
			Если Настройки[8].Выбрать Тогда // Детализация по фондам (и статьям)
				ТекДанные.Сортировать("ФондНаименование, СтатьяНаименование");
				ВывестиДетализацию(макет, табдок, ТекДанные, "Фонд", "ФОНДАМ (группировка по статьям)", "Статья", "Подразделение", "Подразделение", КонецДня(НаДату))
			КонецЕсли;
			
			//
			Если Настройки[9].Выбрать Тогда // Детализация по подразделениям
				ТекДанные.Сортировать("ПодразделениеНаименование, ФондНаименование");
				ВывестиДетализацию(макет, табдок, ТекДанные, "Подразделение", "ПОДРАЗДЕЛЕНИЯМ", "Фонд", "Статья расходов", "Статья", КонецДня(НаДату))
			КонецЕсли;

		КонецЦикла;
	КонецЕсли;	
		
	Обл = макет.ПолучитьОбласть("Подвал");
	ТабДок.Вывести(обл);
	
	ТабДок.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	ТабДок.АвтоМасштаб = Истина;
	
	Элементы.ТабДок.РежимМасштабированияПросмотра = РежимМасштабированияПросмотра.Обычный;
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ВывестиПросроченныеЗаказы(макет, табдок, тз, ДоДаты)

	СтрокиПроср = тз.НайтиСтроки(новый структура("ЭтоПросрочка", истина));
	Если СтрокиПроср.количество() = 0 Тогда
		Обл = макет.ПолучитьОбласть("ПросрШапкаПусто");
		ТабДок.Вывести(обл);
		Возврат;
	КонецЕсли;
	
	Обл = макет.ПолучитьОбласть("ПросрШапка");
	ТабДок.Вывести(обл);
	
	Для каждого стрДет из СтрокиПроср Цикл	
		Обл = макет.ПолучитьОбласть("ПросрСтрока");
		ЗаполнитьЗначенияСвойств(обл.параметры, стрДет); 
		РегистраторыСтрукт = ПолучитьПредставлениеРегистраторов(стрДет.Заказ, ДоДаты);
		ЗаполнитьЗначенияСвойств(обл.параметры, РегистраторыСтрукт);
		ТабДок.Вывести(обл);
	КонецЦикла;
			
	Обл = макет.ПолучитьОбласть("ПросрИтого");
	обл.параметры.СуммаЗаказа = тз.итог("СуммаЗаказа");
	обл.параметры.ОсталосьОдобрить = тз.итог("ОсталосьОдобрить");
	обл.параметры.ОсталосьВыплатить = тз.итог("ОсталосьВыплатить");
	ТабДок.Вывести(обл);
	
		
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ВывестиВсеЗаказы(макет, табдок, тз, ДоДаты)

	Обл = макет.ПолучитьОбласть("СписокШапка");
	ТабДок.Вывести(обл);
	
	Для каждого стрДет из тз Цикл	
		Обл = макет.ПолучитьОбласть("СписокСтрока");
		ЗаполнитьЗначенияСвойств(обл.параметры, стрДет); 
		РегистраторыСтрукт = ПолучитьПредставлениеРегистраторов(стрДет.Заказ, ДоДаты);
		ЗаполнитьЗначенияСвойств(обл.параметры, РегистраторыСтрукт);
		ТабДок.Вывести(обл);
	КонецЦикла;
			
	Обл = макет.ПолучитьОбласть("СписокИтого");
	обл.параметры.СуммаЗаказа = тз.итог("СуммаЗаказа");
	обл.параметры.Одобрено = тз.итог("Одобрено");
	обл.параметры.Выплачено = тз.итог("Выплачено");
	обл.параметры.ОсталосьВыплатитьОдобр = тз.итог("ОсталосьВыплатитьОдобр");
	обл.параметры.ОсталосьОдобрить = тз.итог("ОсталосьОдобрить");
	обл.параметры.ОсталосьВыплатить = тз.итог("ОсталосьВыплатить");
	ТабДок.Вывести(обл);
	
		
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ВывестиДетализацию(макет, табдок, тз, группировка, заголовок, ДопГруппировка = "", заголовокКол, имяКол, ДоДаты)

	Обл = макет.ПолучитьОбласть("ДетализацияШапка");
	обл.параметры.заголовок = заголовок;
	ТабДок.Вывести(обл);
	
	тзДетал = тз.Скопировать();
	тзДетал.Свернуть(группировка, "СуммаЗаказа, Одобрено, Выплачено, ОсталосьВыплатитьОдобр, ОсталосьОдобрить, ОсталосьВыплатить");
	
	Для каждого стрДет из тзДетал Цикл	
		Обл = макет.ПолучитьОбласть("ДетализацияШапкаГруппировка");		
		обл.параметры.Группировка = стрДет[группировка]; 
		обл.параметры.заголовокКол = заголовокКол;
		ТабДок.Вывести(обл);
		
	
		тзДетал1 = тз.Скопировать();
		Сч = тзДетал1.Количество() - 1;
		Пока сч >=0 Цикл
			если тзДетал1[сч][группировка] <> стрДет[группировка] Тогда
				тзДетал1.Удалить(сч);
			КонецЕсли;				
			сч = сч - 1;
		КонецЦикла;
		тзДетал1.Свернуть(ДопГруппировка, "СуммаЗаказа, Одобрено, Выплачено, ОсталосьВыплатитьОдобр, ОсталосьОдобрить, ОсталосьВыплатить");
		Для каждого стрДет1 из тзДетал1 Цикл	
			Обл = макет.ПолучитьОбласть("ДетализацияСтрокаГруппировка");
			обл.параметры.Группировка = стрДет1[ДопГруппировка]; 
			ТабДок.Вывести(обл);
			
			СтрокиПоЗаказам = тз.НайтиСтроки(Новый структура(группировка +"," + ДопГруппировка, стрДет[группировка], стрДет1[ДопГруппировка]));
			Для каждого стрЗаказ из СтрокиПоЗаказам цикл
				Обл = макет.ПолучитьОбласть("ДетализацияСтрока");
				ЗаполнитьЗначенияСвойств(обл.параметры, стрЗаказ); 
				обл.параметры.СтатьяПодразделение = стрЗаказ[имяКол];
				РегистраторыСтрукт = ПолучитьПредставлениеРегистраторов(стрЗаказ.Заказ, ДоДаты);
				ЗаполнитьЗначенияСвойств(обл.параметры, РегистраторыСтрукт);
				ТабДок.Вывести(обл);
			КонецЦикла;
		КонецЦикла;
		
		Обл = макет.ПолучитьОбласть("ДетализацияИтого");
		обл.параметры.СуммаЗаказа = тзДетал1.итог("СуммаЗаказа");
		обл.параметры.Одобрено = тзДетал1.итог("Одобрено");
		обл.параметры.Выплачено = тзДетал1.итог("Выплачено");
		обл.параметры.ОсталосьВыплатитьОдобр = тзДетал1.итог("ОсталосьВыплатитьОдобр");
		обл.параметры.ОсталосьОдобрить = тзДетал1.итог("ОсталосьОдобрить");
		обл.параметры.ОсталосьВыплатить = тзДетал1.итог("ОсталосьВыплатить");
