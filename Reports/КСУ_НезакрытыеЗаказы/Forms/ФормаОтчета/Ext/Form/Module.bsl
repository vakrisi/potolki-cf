Процедура ВыборРег(ВыбЗн, дп) Экспорт
	если ВыбЗн<>Неопределено Тогда
		ПоказатьЗначение(, ВыбЗн.Значение);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура pdf(Команда)
	Оповещение  = Новый ОписаниеОповещения("ПутьКФайлуНачалоВыбораЗавершение", ЭтаФорма);
    ДиалогВыбора = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Сохранение); 
	ДиалогВыбора.ПолноеИмяФайла = "Незакрытые заказы на "+ формат(НаДату, "ДФ=dd.MM.yyyy");
	ДиалогВыбора.Расширение = "pdf";
    ДиалогВыбора.Показать(Оповещение);
КонецПроцедуры

&НаКлиенте
Процедура ПутьКФайлуНачалоВыбораЗавершение(МассивФайлов, ДопПараметры) Экспорт
    Если МассивФайлов = Неопределено Тогда
        Возврат;
	КонецЕсли;
	
	ТабДок.Записать(МассивФайлов[0], ТипФайлаТабличногоДокумента.PDF);
КонецПроцедуры


&НаКлиенте
Процедура ПриОткрытии(Отказ)
	НаДату = ТекущаяДата();
КонецПроцедуры


&НаКлиенте
Процедура ОрганизацииДочерниеВыбратьПриИзменении(Элемент)
	Элементы.ГруппаОрганизацииДочерние.ЦветТекстаЗаголовка = новый цвет(90, 150, 249);
	для каждого стр из ОрганизацииДочерние Цикл
		если стр.выбрать = ложь тогда
			Элементы.ГруппаОрганизацииДочерние.ЦветТекстаЗаголовка = новый цвет(255, 0, 0);	
			Элементы.СброситьФильтры.Видимость = истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры


&НаКлиенте
Процедура СнятьВыборСоВсехОрганизацийДочерних(Команда)
	Элементы.ГруппаОрганизацииДочерние.ЦветТекстаЗаголовка = новый цвет(255, 0, 0);
	для каждого стр из ОрганизацииДочерние Цикл
		стр.выбрать = ложь;
	КонецЦикла;

	Элементы.СброситьФильтры.Видимость = истина;
КонецПроцедуры


&НаКлиенте
Процедура ВыбратьВсеОрганизацииДочерние(Команда)
	Элементы.ГруппаОрганизацииДочерние.ЦветТекстаЗаголовка = новый цвет(90, 150, 249);
	для каждого стр из ОрганизацииДочерние Цикл
		стр.выбрать = истина;
	КонецЦикла;
КонецПроцедуры

