&НаСервере
Процедура ЗаполнитьНастройки()
	НаДату = ТекущаяДата();
	
	НовстрН = Настройки.Добавить();
	НовстрН.Настройка = "Сводно по организациям (головным)";
	НовстрН.Выбрать = ложь;
	
	НовстрН = Настройки.Добавить();
	НовстрН.Настройка = "Сводно по счетам";
	НовстрН.Выбрать = ложь;
	
	НовстрН = Настройки.Добавить();
	НовстрН.Настройка = "Сводно по подразделениям";
	НовстрН.Выбрать = ложь;
	
	НовстрН = Настройки.Добавить();
	НовстрН.Настройка = "Сводно по фондам";
	НовстрН.Выбрать = ложь;
	
	НовстрН = Настройки.Добавить();
	НовстрН.Настройка = "Сводно по фондам и статьям";
	НовстрН.Выбрать = ложь;

	НовстрН = Настройки.Добавить();
	НовстрН.Настройка = "Список заказов";
	НовстрН.Выбрать = Истина;
	
	НовстрН = Настройки.Добавить();
	НовстрН.Настройка = "Список просроченных заказов";
	НовстрН.Выбрать = ложь;

	НовстрН = Настройки.Добавить();
	НовстрН.Настройка = "Детализация по фондам (и подразделениям)";
	НовстрН.Выбрать = ложь;
	
	НовстрН = Настройки.Добавить();
	НовстрН.Настройка = "Детализация по фондам (и статьям)";
	НовстрН.Выбрать = ложь;
	
	НовстрН = Настройки.Добавить();
	НовстрН.Настройка = "Детализация по подразделениям";
	НовстрН.Выбрать = ложь;
	
	//
	МассОрг = ИА_ФПСервер.ПолучитьОрганизацииДляОтчетов();
	Для каждого орг из МассОрг Цикл
		НовстрН = Организации.Добавить();
		НовстрН.Организация = орг;
		НовстрН.Выбрать = истина;
	КонецЦикла;
	
	Выборка = Справочники.Организации.Выбрать(,,,"Наименование");
	Пока выборка.Следующий() Цикл
		Если не выборка.ПометкаУдаления Тогда
			НовстрН = ОрганизацииДочерние.Добавить();
			НовстрН.Организация = выборка.Ссылка;
			НовстрН.Выбрать = истина;
		КонецЕсли;
	КонецЦикла;
	
	Элементы.ГруппаОрганизацииДочерние.Видимость = Справочники.ИА_ГруппыКомпаний.ПолучитьПризнакИспользованияГруппКомпаний();
	
	Если не Константы.ИА_ФП_ВестиФППоОрганизациям.Получить() Тогда
		НовстрН = Организации.Добавить();
		НовстрН.Организация = Справочники.Организации.ПустаяСсылка();
		НовстрН.Выбрать = истина;
		
		НовстрН = ОрганизацииДочерние.Добавить();
		НовстрН.Организация = Справочники.Организации.ПустаяСсылка();
		НовстрН.Выбрать = истина;
	КонецЕсли;
	//
	
	//
	Выборка= Справочники.ИА_ЦФО.Выбрать(,,,"Наименование");
	Пока выборка.Следующий() Цикл
		Если не выборка.ПометкаУдаления Тогда
			НовстрН = Подразделения.Добавить();
			НовстрН.Подразделение = выборка.Ссылка;
			НовстрН.Выбрать = истина;		
		КонецЕсли;
	КонецЦикла;
	НовстрН = Подразделения.Добавить();
	НовстрН.Подразделение = Справочники.ИА_ЦФО.ПустаяСсылка();
	НовстрН.Выбрать = истина;		
	
	//
	ЭтоРСФ = ИА_ФП.ЭтоРСФ();
	Выборка= Справочники.ИА_Фонды.Выбрать(,,,"Наименование");
	Пока выборка.Следующий() Цикл
		Если не выборка.ПометкаУдаления Тогда
			Если ЭтоРСФ или выборка.Защищенный = ложь Тогда
				НовстрН = Фонды.Добавить();
				НовстрН.Фонд = Выборка.Ссылка;
				НовстрН.Выбрать = истина;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

