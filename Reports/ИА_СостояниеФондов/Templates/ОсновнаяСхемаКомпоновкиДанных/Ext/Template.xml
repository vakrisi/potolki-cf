	ЕСТЬNULL(ИА_СредстваНаФондахОстатки.Фонд, ИА_СредстваВРезервеНаФондахОстатки.Фонд) КАК Фонд,
	ЕСТЬNULL(ИА_СредстваНаФондахОстатки.СуммаНалКонечныйОстаток, 0) КАК СуммаНал,
	ЕСТЬNULL(ИА_СредстваНаФондахОстатки.СуммаБезналКонечныйОстаток, 0) КАК СуммаБезнал,
	ЕСТЬNULL(ИА_СредстваВРезервеНаФондахОстатки.СуммаНалКонечныйОстаток, 0) КАК СуммаЗарезервированоНал,
	ЕСТЬNULL(ИА_СредстваВРезервеНаФондахОстатки.СуммаБезналКонечныйОстаток, 0) КАК СуммаЗарезервированоБезнал,
	ЕСТЬNULL(ИА_СредстваНаФондахОстатки.СуммаНалКонечныйОстаток, 0) - ЕСТЬNULL(ИА_СредстваВРезервеНаФондахОстатки.СуммаНалКонечныйОстаток, 0) КАК СвободныйОстатокНал,
	ЕСТЬNULL(ИА_СредстваНаФондахОстатки.СуммаБезналКонечныйОстаток, 0) - ЕСТЬNULL(ИА_СредстваВРезервеНаФондахОстатки.СуммаБезналКонечныйОстаток, 0) КАК СвободныйОстатокБезнал,
	ЕСТЬNULL(ИА_СредстваНаФондахОстатки.Подразделение, ИА_СредстваВРезервеНаФондахОстатки.Подразделение) КАК Подразделение,
	ЕСТЬNULL(ИА_СредстваНаФондахОстатки.СуммаБезналКонечныйОстаток, 0) КАК Сумма,
	ЕСТЬNULL(ИА_СредстваВРезервеНаФондахОстатки.СуммаБезналКонечныйОстаток, 0) КАК СуммаЗарезервировано,
	ЕСТЬNULL(ИА_СредстваНаФондахОстатки.СуммаБезналКонечныйОстаток, 0) - ЕСТЬNULL(ИА_СредстваВРезервеНаФондахОстатки.СуммаБезналКонечныйОстаток, 0) КАК СвободныйОстаток,
	ИА_СредстваНаФондахОстатки.Регистратор КАК Регистратор,
	ИА_СредстваВРезервеНаФондахОстатки.ЗП КАК Заявка,
	ЕСТЬNULL(ИА_СредстваНаФондахОстатки.СуммаНалНачальныйОстаток, 0) КАК СуммаНалНачальныйОстаток1,
	ЕСТЬNULL(ИА_СредстваНаФондахОстатки.СуммаБезналНачальныйОстаток, 0) КАК СуммаБезналНачальныйОстаток2,
	ИА_СредстваВРезервеНаФондахОстатки.СуммаНалНачальныйОстаток,
	ИА_СредстваВРезервеНаФондахОстатки.СуммаБезналНачальныйОстаток,
	ИА_СредстваВРезервеНаФондахОстатки.СуммаБезналНачальныйОстаток КАК СуммаБезналНачальныйОстаток1,
	ИА_СредстваНаФондахОстатки.СуммаБезналНачальныйОстаток КАК СуммаБезналНачальныйОстаток3,
	ЕСТЬNULL(ИА_СредстваНаФондахОстатки.Фонд.Счет, ИА_СредстваВРезервеНаФондахОстатки.Фонд.Счет) КАК СчетФонда
ИЗ
	РегистрНакопления.ИА_СредстваНаФондах.ОстаткиИОбороты({(&amp;КонецПериода)}, , Авто, , ) КАК ИА_СредстваНаФондахОстатки
		ПОЛНОЕ СОЕДИНЕНИЕ РегистрНакопления.ИА_СредстваВРезервеНаФондах.ОстаткиИОбороты({(&amp;КонецПериода)}, , Авто, , ) КАК ИА_СредстваВРезервеНаФондахОстатки
		ПО ИА_СредстваНаФондахОстатки.Фонд = ИА_СредстваВРезервеНаФондахОстатки.Фонд
			И ИА_СредстваНаФондахОстатки.Организация = ИА_СредстваВРезервеНаФондахОстатки.Организация
			И ИА_СредстваНаФондахОстатки.Подразделение = ИА_СредстваВРезервеНаФондахОстатки.Подразделение
ГДЕ
	(ЕСТЬNULL(ИА_СредстваНаФондахОстатки.Фонд.Счет, ИА_СредстваВРезервеНаФондахОстатки.Фонд.Счет) &lt;&gt; ЗНАЧЕНИЕ(Справочник.ИА_Счета.Счет1)
			ИЛИ &amp;ЭтоРСФ)</query>
