////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	МинимальныеОстаткиНоменклатуры.Склад КАК Склад,
	МинимальныеОстаткиНоменклатуры.Номенклатура КАК Номенклатура,
	МИНИМУМ(МинимальныеОстаткиНоменклатуры.Количество) КАК МинимальныйОстаток,
	МАКСИМУМ(МинимальныеОстаткиНоменклатуры.КоличествоМаксимум) КАК МаксимальныйОстаток
ПОМЕСТИТЬ ВТ_МинМаксОстаток
ИЗ
	РегистрСведений.МинимальныеОстаткиНоменклатуры КАК МинимальныеОстаткиНоменклатуры

СГРУППИРОВАТЬ ПО
	МинимальныеОстаткиНоменклатуры.Склад,
	МинимальныеОстаткиНоменклатуры.Номенклатура
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	МинимальныеОстаткиНоменклатуры.Номенклатура КАК Номенклатура,
	СУММА(МинимальныеОстаткиНоменклатуры.Количество) КАК МинимальныйОстатокОбщий,
	СУММА(МинимальныеОстаткиНоменклатуры.КоличествоМаксимум) КАК МаксимальныйОстатокОбщий
ПОМЕСТИТЬ ВТ_МинМаксОстатокОбщий
ИЗ
	РегистрСведений.МинимальныеОстаткиНоменклатуры КАК МинимальныеОстаткиНоменклатуры

СГРУППИРОВАТЬ ПО
	МинимальныеОстаткиНоменклатуры.Номенклатура
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ВТ_Ном.Номенклатура КАК Номенклатура,
	ВТ_Ном.Склад КАК Склад,
	ВТ_Ном.Организация КАК Организация,
	ВТ_МинМаксОстаток.МинимальныйОстаток КАК МинимальныйОстаток,
	ВТ_МинМаксОстаток.МаксимальныйОстаток КАК МаксимальныйОстаток,
	ВТ_МинМаксОстатокОбщий.МинимальныйОстатокОбщий КАК МинимальныйОстатокОбщий,
	ВТ_МинМаксОстатокОбщий.МаксимальныйОстатокОбщий КАК МаксимальныйОстатокОбщий
ПОМЕСТИТЬ ВТ_Номенклатура
ИЗ
	ВТ_Ном КАК ВТ_Ном
		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_МинМаксОстаток КАК ВТ_МинМаксОстаток
		ПО ВТ_Ном.Склад = ВТ_МинМаксОстаток.Склад
			И ВТ_Ном.Номенклатура = ВТ_МинМаксОстаток.Номенклатура
		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_МинМаксОстатокОбщий КАК ВТ_МинМаксОстатокОбщий
		ПО ВТ_Ном.Номенклатура = ВТ_МинМаксОстатокОбщий.Номенклатура
ГДЕ
	(ВТ_Ном.Склад.Код = "000000007"
			ИЛИ ВТ_Ном.Склад.Код = "000000005"
			ИЛИ ВТ_Ном.Склад.Код = "000000004"
			ИЛИ ВТ_Ном.Склад.Код = "000000001"
			ИЛИ ВТ_Ном.Склад.Код = "000000017")
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ТоварыНаСкладахОбороты.Регистратор КАК Регистратор,
	ТоварыНаСкладахОбороты.Организация КАК Организация,
	ТоварыНаСкладахОбороты.Склад КАК Склад,
	ТИПЗНАЧЕНИЯ(ТоварыНаСкладахОбороты.Регистратор) КАК ВидРасхода,
	ТоварыНаСкладахОбороты.Номенклатура КАК Номенклатура,
	ТоварыНаСкладахОбороты.Номенклатура.ВидНоменклатуры КАК НоменклатураВидНоменклатуры,
	ТоварыНаСкладахОбороты.КоличествоРасход КАК КоличествоРасход,
	РАЗНОСТЬДАТ(&amp;НачалоПериода, &amp;КонецПериода, МЕСЯЦ) + 1 КАК КоличествоМесяцев,
	ТоварыНаСкладахОбороты.ПериодМесяц КАК ПериодМесяц,
	РАЗНОСТЬДАТ(&amp;НачалоПериода, &amp;КонецПериода, ДЕНЬ) + 1 КАК КоличествоДней
ПОМЕСТИТЬ ВТ_ТоварыНаСкладахОбороты
ИЗ
	РегистрНакопления.ТоварыНаСкладах.Обороты({(&amp;НачалоПериода)}, {(&amp;КонецПериода)}, Авто, ) КАК ТоварыНаСкладахОбороты

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	ТоварыВРезервеНаСкладахОбороты.Регистратор,
	ТоварыВРезервеНаСкладахОбороты.Организация,
	ТоварыВРезервеНаСкладахОбороты.Склад,
	ТИПЗНАЧЕНИЯ(ТоварыВРезервеНаСкладахОбороты.Регистратор),
	ТоварыВРезервеНаСкладахОбороты.Номенклатура,
	ТоварыВРезервеНаСкладахОбороты.Номенклатура.ВидНоменклатуры,
	ТоварыВРезервеНаСкладахОбороты.КоличествоПриход,
	РАЗНОСТЬДАТ(&amp;НачалоПериода, &amp;Конецпериода, МЕСЯЦ) + 1,
	ТоварыВРезервеНаСкладахОбороты.ПериодМесяц,
	РАЗНОСТЬДАТ(&amp;НачалоПериода, &amp;КонецПериода, ДЕНЬ) + 1
ИЗ
	РегистрНакопления.ТоварыВРезервеНаСкладах.Обороты({(&amp;НачалоПериода)}, {(&amp;КонецПериода)}, Авто, ) КАК ТоварыВРезервеНаСкладахОбороты
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ЕСТЬNULL(ТоварыНаСкладахОстатки.Организация, ТоварыВРезервеНаСкладахОстатки.Организация) КАК Организация,
	ЕСТЬNULL(ТоварыНаСкладахОстатки.Склад, ТоварыВРезервеНаСкладахОстатки.Склад) КАК Склад,
	ЕСТЬNULL(ТоварыНаСкладахОстатки.Номенклатура, ТоварыВРезервеНаСкладахОстатки.Номенклатура) КАК Номенклатура,
	ВЫБОР
		КОГДА &amp;УчитыватьРезервы
			ТОГДА ЕСТЬNULL(ТоварыНаСкладахОстатки.КоличествоОстаток, 0) - ЕСТЬNULL(ТоварыВРезервеНаСкладахОстатки.КоличествоОстаток, 0)
		ИНАЧЕ ЕСТЬNULL(ТоварыНаСкладахОстатки.КоличествоОстаток, 0)
	КОНЕЦ КАК Остаток
ПОМЕСТИТЬ ВТ_ОстатокСУчетомРезервов
ИЗ
	РегистрНакопления.ТоварыНаСкладах.Остатки(
			,
			Склад.Код = "000000007"
				ИЛИ Склад.Код = "000000005"
				ИЛИ Склад.Код = "000000004"
				ИЛИ Склад.Код = "000000001"
				ИЛИ Склад.Код = "000000017") КАК ТоварыНаСкладахОстатки
		ПОЛНОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыВРезервеНаСкладах.Остатки(
				,
				Склад.Код = "000000007"
					ИЛИ Склад.Код = "000000005"
					ИЛИ Склад.Код = "000000004"
					ИЛИ Склад.Код = "000000001"
					ИЛИ Склад.Код = "000000017") КАК ТоварыВРезервеНаСкладахОстатки
		ПО ТоварыНаСкладахОстатки.Организация = ТоварыВРезервеНаСкладахОстатки.Организация
			И ТоварыНаСкладахОстатки.Склад = ТоварыВРезервеНаСкладахОстатки.Склад
			И ТоварыНаСкладахОстатки.Номенклатура = ТоварыВРезервеНаСкладахОстатки.Номенклатура
			И ТоварыНаСкладахОстатки.ХарактеристикаНоменклатуры = ТоварыВРезервеНаСкладахОстатки.ХарактеристикаНоменклатуры
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗРЕШЕННЫЕ
	ВТ_Номенклатура.Организация КАК Организация,
	ВТ_Номенклатура.Склад КАК Склад,
	ВТ_Номенклатура.Номенклатура КАК Номенклатура,
	ВТ_Номенклатура.Номенклатура.ВидНоменклатуры КАК ВидНоменклатуры,
	ВТ_Номенклатура.Номенклатура.Поставщик КАК Поставщик,
	ЕСТЬNULL(ВТ_Номенклатура.МинимальныйОстаток, 0) КАК МинимальныйОстаток,
	ЕСТЬNULL(ВТ_Номенклатура.МаксимальныйОстаток, 0) КАК МаксимальныйОстаток,
	ЕСТЬNULL(ВТ_Номенклатура.МинимальныйОстатокОбщий, 0) КАК МинимальныйОстатокОбщий,
	ЕСТЬNULL(ВТ_Номенклатура.МаксимальныйОстатокОбщий, 0) КАК МаксимальныйОстатокОбщий,
	ВЫБОР
		КОГДА ВТ_ТоварыНаСкладахОбороты.Регистратор ЕСТЬ NULL
			ТОГДА 0
		КОГДА ВТ_ТоварыНаСкладахОбороты.Регистратор ССЫЛКА Документ.РеализацияТоваровИУслуг
				ИЛИ ВТ_ТоварыНаСкладахОбороты.Регистратор ССЫЛКА Документ.ВыпускПродукции
			ТОГДА ЕСТЬNULL(ВТ_ТоварыНаСкладахОбороты.КоличествоРасход, 0)
		ИНАЧЕ 0
	КОНЕЦ КАК Количество,
	ВТ_ТоварыНаСкладахОбороты.КоличествоМесяцев КАК КоличествоМесяцев,
	ВТ_ТоварыНаСкладахОбороты.Регистратор КАК Регистратор,
	ЕСТЬNULL(ВТ_ТоварыНаСкладахОбороты.ПериодМесяц, НАЧАЛОПЕРИОДА(&amp;НачалоПериода, МЕСЯЦ)) КАК ПериодМесяц,
	ЕСТЬNULL(ВТ_ОстатокСУчетомРезервов.Остаток, 0) КАК Остаток,
