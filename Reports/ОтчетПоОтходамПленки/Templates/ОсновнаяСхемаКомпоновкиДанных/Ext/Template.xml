		<query>ВЫБРАТЬ РАЗРЕШЕННЫЕ
	ОприходованиеТоваровТовары.Ссылка.Склад КАК Склад,
	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ОприходованиеТоваровТовары.Ссылка) КАК КоличествоМешков,
	ОприходованиеТоваровТовары.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	СУММА(ОприходованиеТоваровТовары.Количество) КАК Количество
ПОМЕСТИТЬ ВТ_Оприходования
ИЗ
	Документ.ОприходованиеТоваров.Товары КАК ОприходованиеТоваровТовары
ГДЕ
	ОприходованиеТоваровТовары.Номенклатура = &amp;Номенклатура
	И ОприходованиеТоваровТовары.Ссылка.Дата МЕЖДУ &amp;Д1 И &amp;Д2

СГРУППИРОВАТЬ ПО
	ОприходованиеТоваровТовары.Ссылка.Склад,
	ОприходованиеТоваровТовары.ЕдиницаИзмерения
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗРЕШЕННЫЕ
	ВыпускПродукцииМатериалы.Ссылка.СкладМатериалов КАК Склад,
	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВыпускПродукцииМатериалы.Ссылка.ПродукцияНоменклатура) КАК КолвоРазличныхПродукция,
	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВыпускПродукцииМатериалы.Номенклатура) КАК КолвоРазличныхНоменклатура,
	СУММА(ВыпускПродукцииМатериалы.Количество) КАК Количество,
	СУММА(ВыпускПродукцииМатериалы.КоличествоКВыработке) КАК КоличествоКВыработке,
	ВыпускПродукцииМатериалы.ЕдиницаИзмерения КАК ЕдиницаИзмерения
ПОМЕСТИТЬ ВТ_Выпуски
ИЗ
	Документ.ВыпускПродукции.Материалы КАК ВыпускПродукцииМатериалы
ГДЕ
	(ВыпускПродукцииМатериалы.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Справочник.ВидыНоменклатуры.Полотно)
			ИЛИ ВыпускПродукцииМатериалы.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Справочник.ВидыНоменклатуры.ОстатокПленки))
	И ВыпускПродукцииМатериалы.Ссылка.Дата МЕЖДУ &amp;Д1 И &amp;Д2

СГРУППИРОВАТЬ ПО
	ВыпускПродукцииМатериалы.ЕдиницаИзмерения,
	ВыпускПродукцииМатериалы.Ссылка.СкладМатериалов
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ЕСТЬNULL(ВТ_Оприходования.Склад, ВТ_Выпуски.Склад) КАК Склад,
	ВТ_Выпуски.КолвоРазличныхПродукция КАК КолвоРазличныхПродукция,
	ВТ_Выпуски.КоличествоКВыработке КАК КоличествоКВыработке,
	ВТ_Выпуски.ЕдиницаИзмерения КАК ЕдиницаИзмеренияПродукции,
	ВТ_Оприходования.КоличествоМешков КАК КоличествоМешков,
	ВТ_Оприходования.Количество КАК Количество,
	ВТ_Оприходования.ЕдиницаИзмерения КАК ЕдиницаИзмеренияОтходов,
	ВЫБОР
		КОГДА ЕСТЬNULL(ВТ_Выпуски.КоличествоКВыработке, 0) = 0
			ТОГДА 0
		ИНАЧЕ ВТ_Оприходования.Количество / 0.22 * 100 / ВТ_Выпуски.КоличествоКВыработке
	КОНЕЦ КАК ПроцентОтходов,
	ЕСТЬNULL(ВТ_Выпуски.КолвоРазличныхПродукция, 0) * 0.7 КАК КолвоПленкиНаУпаковкуМ2,
	ЕСТЬNULL(ВТ_Выпуски.КолвоРазличныхПродукция, 0) * 0.7 * 0.22 КАК КолвоПленкиНаУпаковкуКГ,
	ВЫБОР
		КОГДА ЕСТЬNULL(ВТ_Выпуски.КоличествоКВыработке, 0) = 0
			ТОГДА 0
		ИНАЧЕ ВТ_Оприходования.Количество / 0.22 * 100 / ВТ_Выпуски.КоличествоКВыработке + ЕСТЬNULL(ВТ_Выпуски.КолвоРазличныхПродукция, 0) * 0.7 * 100 / ВТ_Выпуски.КоличествоКВыработке
	КОНЕЦ КАК ОбщийПроцентОтходов
ИЗ
	ВТ_Выпуски КАК ВТ_Выпуски
		ПОЛНОЕ СОЕДИНЕНИЕ ВТ_Оприходования КАК ВТ_Оприходования
		ПО (ВТ_Оприходования.Склад = ВТ_Выпуски.Склад)</query>
