<?xml version="1.0" encoding="UTF-8"?>
<DataCompositionSchema xmlns="http://v8.1c.ru/8.1/data-composition-system/schema" xmlns:dcscom="http://v8.1c.ru/8.1/data-composition-system/common" xmlns:dcscor="http://v8.1c.ru/8.1/data-composition-system/core" xmlns:dcsset="http://v8.1c.ru/8.1/data-composition-system/settings" xmlns:v8="http://v8.1c.ru/8.1/data/core" xmlns:v8ui="http://v8.1c.ru/8.1/data/ui" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<dataSource>
		<name>ИсточникДанных1</name>
		<dataSourceType>Local</dataSourceType>
	</dataSource>
	<dataSet xsi:type="DataSetQuery">
		<name>Данные</name>
		<field xsi:type="DataSetFieldField">
			<dataPath>Номенклатура</dataPath>
			<field>Номенклатура</field>
			<role>
				<dcscom:dimension>true</dcscom:dimension>
			</role>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Поставщик</dataPath>
			<field>Поставщик</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Поставщик</v8:content>
				</v8:item>
			</title>
			<role>
				<dcscom:dimension>true</dcscom:dimension>
			</role>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Склад</dataPath>
			<field>Склад</field>
			<role>
				<dcscom:dimension>true</dcscom:dimension>
			</role>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ЭтоЭталонныйСклад</dataPath>
			<field>ЭтоЭталонныйСклад</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Это эталонный склад</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ЕстьМинимальныйОстаток</dataPath>
			<field>ЕстьМинимальныйОстаток</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Есть минимальный остаток</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Сток</dataPath>
			<field>Сток</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Сток</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Резерв</dataPath>
			<field>Резерв</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Резерв</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>МинимальныйОстаток</dataPath>
			<field>МинимальныйОстаток</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Min</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Поставка</dataPath>
			<field>Поставка</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Поставка</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ПоставкаВРаботе</dataPath>
			<field>ПоставкаВРаботе</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Поставка в работе (без основания)</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Перемещение</dataPath>
			<field>Перемещение</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Перемещение</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ПеремещениеЗаявка</dataPath>
			<field>ПеремещениеЗаявка</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Перемещение (заявки и к сборке)</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ЗаявкиИсходящие</dataPath>
			<field>ЗаявкиИсходящие</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Исходящие заявки на перемещение</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ДокументРезерва</dataPath>
			<field>ДокументРезерва</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Организация</dataPath>
			<field>Организация</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ВидТабличнойЧасти</dataPath>
			<field>ВидТабличнойЧасти</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ХарактеристикаНоменклатуры</dataPath>
			<field>ХарактеристикаНоменклатуры</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>СерияНоменклатуры</dataPath>
			<field>СерияНоменклатуры</field>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ РАЗРЕШЕННЫЕ
	ПеремещениеТоваровТовары.Ссылка.Организация КАК Организация,
	ПеремещениеТоваровТовары.Номенклатура КАК Номенклатура,
	ПеремещениеТоваровТовары.Ссылка.СкладПолучатель КАК Склад,
	ПеремещениеТоваровТовары.Количество * ПеремещениеТоваровТовары.Коэффициент КАК Количество,
	ВЫБОР
		КОГДА ПеремещениеТоваровТовары.Ссылка.ТекущийСтатус = ЗНАЧЕНИЕ(Перечисление.СтатусыПеремещений.Заявка)
				ИЛИ ПеремещениеТоваровТовары.Ссылка.ТекущийСтатус = ЗНАЧЕНИЕ(Перечисление.СтатусыПеремещений.Собран)
			ТОГДА ПеремещениеТоваровТовары.Количество * ПеремещениеТоваровТовары.Коэффициент
		ИНАЧЕ 0
	КОНЕЦ КАК КоличествоЗаявка,
	ПеремещениеТоваровТовары.Ссылка КАК Регистратор
ПОМЕСТИТЬ ВТ_Перемещения
ИЗ
	Документ.ПеремещениеТоваров.Товары КАК ПеремещениеТоваровТовары
ГДЕ
	ПеремещениеТоваровТовары.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Справочник.ВидыНоменклатуры.Материал)
	И ПеремещениеТоваровТовары.Ссылка.Проведен
	И ПеремещениеТоваровТовары.Ссылка.ТекущийСтатус &lt;&gt; ЗНАЧЕНИЕ(Перечисление.СтатусыПеремещений.Получен)
	И ПеремещениеТоваровТовары.Ссылка.ТекущийСтатус &lt;&gt; ЗНАЧЕНИЕ(Перечисление.СтатусыПеремещений.Отменен)
	И НЕ ПеремещениеТоваровТовары.Ссылка.ПометкаУдаления
	И (ПеремещениеТоваровТовары.Ссылка.Основание = НЕОПРЕДЕЛЕНО
			ИЛИ ПеремещениеТоваровТовары.Ссылка.Основание = ЗНАЧЕНИЕ(Документ.Монтаж.ПустаяСсылка)
			ИЛИ ПеремещениеТоваровТовары.Ссылка.Основание = ЗНАЧЕНИЕ(Документ.ЗаказПокупателя.ПустаяСсылка)
			ИЛИ ПеремещениеТоваровТовары.Ссылка.Основание = ЗНАЧЕНИЕ(Документ.ПоступлениеТоваровИУслуг.ПустаяСсылка)
			ИЛИ ПеремещениеТоваровТовары.Ссылка.Основание = ЗНАЧЕНИЕ(Документ.ПеремещениеТоваров.ПустаяСсылка))
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗРЕШЕННЫЕ
	ЗаказПоставщикуТовары.Ссылка.Организация КАК Организация,
	ЗаказПоставщикуТовары.Ссылка.Склад КАК Склад,
	ЗаказПоставщикуТовары.Количество * ЗаказПоставщикуТовары.Коэффициент КАК Количество,
	ВЫБОР
		КОГДА ЗаказПоставщикуТовары.Ссылка.ТекущийСтатус = ЗНАЧЕНИЕ(Справочник.СтатусыЗаказовПоставщику.ВРаботе)
				И (ЗаказПоставщикуТовары.Ссылка.Основание = НЕОПРЕДЕЛЕНО
					ИЛИ ЗаказПоставщикуТовары.Ссылка.Основание = ЗНАЧЕНИЕ(Документ.Монтаж.ПустаяСсылка)
					ИЛИ ЗаказПоставщикуТовары.Ссылка.Основание = ЗНАЧЕНИЕ(Документ.ЗаказПокупателя.ПустаяСсылка)
					ИЛИ ЗаказПоставщикуТовары.Ссылка.Основание = ЗНАЧЕНИЕ(Документ.ЗаказДоговор.ПустаяСсылка)
					ИЛИ ЗаказПоставщикуТовары.Ссылка.Основание = ЗНАЧЕНИЕ(Документ.ЗаказНаПроизводство.ПустаяСсылка))
			ТОГДА ЗаказПоставщикуТовары.Количество * ЗаказПоставщикуТовары.Коэффициент
		ИНАЧЕ 0
	КОНЕЦ КАК КоличествоВРаботе,
	ЗаказПоставщикуТовары.Номенклатура КАК Номенклатура,
	ЗаказПоставщикуТовары.Ссылка КАК Регистратор
ПОМЕСТИТЬ ВТ_ЗаказыПоставщику
ИЗ
	Документ.ЗаказПоставщику.Товары КАК ЗаказПоставщикуТовары
ГДЕ
	ЗаказПоставщикуТовары.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Справочник.ВидыНоменклатуры.Материал)
	И ЗаказПоставщикуТовары.Ссылка.Проведен
	И (ЗаказПоставщикуТовары.Ссылка.ТекущийСтатус = ЗНАЧЕНИЕ(Справочник.СтатусыЗаказовПоставщику.Новый)
			ИЛИ ЗаказПоставщикуТовары.Ссылка.ТекущийСтатус = ЗНАЧЕНИЕ(Справочник.СтатусыЗаказовПоставщику.ВРаботе))
	И НЕ ЗаказПоставщикуТовары.Ссылка.ПометкаУдаления
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗРЕШЕННЫЕ
	ВТ_Перемещения.Номенклатура КАК Номенклатура,
	ВТ_Перемещения.Склад КАК Склад,
	СУММА(ВТ_Перемещения.Количество) КАК Количество,
	СУММА(ВТ_Перемещения.КоличествоЗаявка) КАК КоличествоЗаявка
ПОМЕСТИТЬ ВТ_ПеремещенияСвод
ИЗ
	ВТ_Перемещения КАК ВТ_Перемещения

СГРУППИРОВАТЬ ПО
	ВТ_Перемещения.Номенклатура,
	ВТ_Перемещения.Склад
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗРЕШЕННЫЕ
	ВТ_ЗаказыПоставщику.Номенклатура КАК Номенклатура,
	ВТ_ЗаказыПоставщику.Склад КАК Склад,
	СУММА(ВТ_ЗаказыПоставщику.Количество) КАК Количество,
	СУММА(ВТ_ЗаказыПоставщику.КоличествоВРаботе) КАК КоличествоВРаботе
ПОМЕСТИТЬ ВТ_ПоставкиСвод
ИЗ
	ВТ_ЗаказыПоставщику КАК ВТ_ЗаказыПоставщику

СГРУППИРОВАТЬ ПО
	ВТ_ЗаказыПоставщику.Номенклатура,
	ВТ_ЗаказыПоставщику.Склад
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗРЕШЕННЫЕ
	ПеремещениеТоваровТовары.Номенклатура КАК Номенклатура,
	ПеремещениеТоваровТовары.Ссылка.СкладОтправитель КАК Склад,
	СУММА(ПеремещениеТоваровТовары.Количество * ПеремещениеТоваровТовары.Коэффициент) КАК Количество
ПОМЕСТИТЬ ВТ_ЗаявкиИсходящие
ИЗ
	Документ.ПеремещениеТоваров.Товары КАК ПеремещениеТоваровТовары
ГДЕ
	ПеремещениеТоваровТовары.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Справочник.ВидыНоменклатуры.Материал)
	И ПеремещениеТоваровТовары.Ссылка.Проведен
	И (ПеремещениеТоваровТовары.Ссылка.ТекущийСтатус = ЗНАЧЕНИЕ(Перечисление.СтатусыПеремещений.Заявка)
			ИЛИ ПеремещениеТоваровТовары.Ссылка.ТекущийСтатус = ЗНАЧЕНИЕ(Перечисление.СтатусыПеремещений.Собран))
	И НЕ ПеремещениеТоваровТовары.Ссылка.ПометкаУдаления

СГРУППИРОВАТЬ ПО
	ПеремещениеТоваровТовары.Номенклатура,
	ПеремещениеТоваровТовары.Ссылка.СкладОтправитель
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗРЕШЕННЫЕ
	ТоварыНаСкладахОстатки.Номенклатура КАК Номенклатура,
	ТоварыНаСкладахОстатки.Склад КАК Склад,
	СУММА(ТоварыНаСкладахОстатки.КоличествоОстаток) КАК Количество
ПОМЕСТИТЬ ВТ_Остатки
ИЗ
	РегистрНакопления.ТоварыНаСкладах.Остатки(&amp;ДатаОстатков, Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Справочник.ВидыНоменклатуры.Материал)) КАК ТоварыНаСкладахОстатки

СГРУППИРОВАТЬ ПО
	ТоварыНаСкладахОстатки.Номенклатура,
	ТоварыНаСкладахОстатки.Склад
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗРЕШЕННЫЕ
	ТоварыВРезервеОстатки.Номенклатура КАК Номенклатура,
	ТоварыВРезервеОстатки.Склад КАК Склад,
	СУММА(ТоварыВРезервеОстатки.КоличествоОстаток) КАК Количество
ПОМЕСТИТЬ ВТ_Резервы
ИЗ
	РегистрНакопления.ТоварыВРезервеНаСкладах.Остатки(&amp;ДатаОстатков, Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Справочник.ВидыНоменклатуры.Материал)) КАК ТоварыВРезервеОстатки

СГРУППИРОВАТЬ ПО
	ТоварыВРезервеОстатки.Номенклатура,
	ТоварыВРезервеОстатки.Склад
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗРЕШЕННЫЕ
	МинимальныеОстаткиНоменклатуры.Номенклатура КАК Номенклатура,
	МинимальныеОстаткиНоменклатуры.Склад КАК Склад,
	МинимальныеОстаткиНоменклатуры.Количество КАК Количество
ПОМЕСТИТЬ ВТ_МинОстатки
ИЗ
	РегистрСведений.МинимальныеОстаткиНоменклатуры КАК МинимальныеОстаткиНоменклатуры
ГДЕ
	МинимальныеОстаткиНоменклатуры.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Справочник.ВидыНоменклатуры.Материал)
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗРЕШЕННЫЕ
	ВТ_МинОстатки.Номенклатура КАК Номенклатура
ПОМЕСТИТЬ ВТ_МинПоНоменклатуре
ИЗ
	ВТ_МинОстатки КАК ВТ_МинОстатки
ГДЕ
	ВТ_МинОстатки.Количество &lt;&gt; 0

СГРУППИРОВАТЬ ПО
	ВТ_МинОстатки.Номенклатура
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗРЕШЕННЫЕ
	ВТ_Остатки.Номенклатура КАК Номенклатура,
	ВТ_Остатки.Склад КАК Склад
ПОМЕСТИТЬ ВТ_Ключи
ИЗ
	ВТ_Остатки КАК ВТ_Остатки

ОБЪЕДИНИТЬ

ВЫБРАТЬ
	ВТ_МинОстатки.Номенклатура,
	ВТ_МинОстатки.Склад
ИЗ
	ВТ_МинОстатки КАК ВТ_МинОстатки

ОБЪЕДИНИТЬ

ВЫБРАТЬ
	ВТ_ПеремещенияСвод.Номенклатура,
	ВТ_ПеремещенияСвод.Склад
ИЗ
	ВТ_ПеремещенияСвод КАК ВТ_ПеремещенияСвод

ОБЪЕДИНИТЬ

ВЫБРАТЬ
	ВТ_ПоставкиСвод.Номенклатура,
	ВТ_ПоставкиСвод.Склад
ИЗ
	ВТ_ПоставкиСвод КАК ВТ_ПоставкиСвод

ОБЪЕДИНИТЬ

ВЫБРАТЬ
	ВТ_ЗаявкиИсходящие.Номенклатура,
	ВТ_ЗаявкиИсходящие.Склад
ИЗ
	ВТ_ЗаявкиИсходящие КАК ВТ_ЗаявкиИсходящие
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗРЕШЕННЫЕ
	ВТ_Ключи.Номенклатура КАК Номенклатура,
	ВТ_Ключи.Номенклатура.Поставщик КАК Поставщик,
	ВТ_Ключи.Склад КАК Склад,
	ВЫБОР
		КОГДА ВТ_Ключи.Склад = &amp;ЭталонныйСклад
			ТОГДА ИСТИНА
		ИНАЧЕ ЛОЖЬ
	КОНЕЦ КАК ЭтоЭталонныйСклад,
	ВЫБОР
		КОГДА ВТ_МинПоНоменклатуре.Номенклатура ЕСТЬ NULL
			ТОГДА ЛОЖЬ
		ИНАЧЕ ИСТИНА
	КОНЕЦ КАК ЕстьМинимальныйОстаток,
	ЕСТЬNULL(ВТ_Остатки.Количество, 0) - ЕСТЬNULL(ВТ_Резервы.Количество, 0) КАК Сток,
	ЕСТЬNULL(ВТ_Резервы.Количество, 0) КАК Резерв,
	ЕСТЬNULL(ВТ_МинОстатки.Количество, 0) КАК МинимальныйОстаток,
	ЕСТЬNULL(ВТ_ПоставкиСвод.Количество, 0) КАК Поставка,
