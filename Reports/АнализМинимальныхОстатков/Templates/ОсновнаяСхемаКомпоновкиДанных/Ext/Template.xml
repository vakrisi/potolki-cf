ИЗ
	ВТ_Остатки КАК ВТ_Остатки

ОБЪЕДИНИТЬ

ВЫБРАТЬ
	ВТ_МинОстатки.Номенклатура,
	ВТ_МинОстатки.Склад
ИЗ
	ВТ_МинОстатки КАК ВТ_МинОстатки

ОБЪЕДИНИТЬ

ВЫБРАТЬ
	ВТ_ПеремещенияСвод.Номенклатура,
	ВТ_ПеремещенияСвод.Склад
ИЗ
	ВТ_ПеремещенияСвод КАК ВТ_ПеремещенияСвод

ОБЪЕДИНИТЬ

ВЫБРАТЬ
	ВТ_ПоставкиСвод.Номенклатура,
	ВТ_ПоставкиСвод.Склад
ИЗ
	ВТ_ПоставкиСвод КАК ВТ_ПоставкиСвод
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗРЕШЕННЫЕ
	ВТ_Ключи.Номенклатура КАК Номенклатура,
	ВТ_Ключи.Номенклатура.Поставщик КАК Поставщик,
	ВТ_Ключи.Склад КАК Склад,
	ВЫБОР
		КОГДА ВТ_Ключи.Склад = &amp;ЭталонныйСклад
			ТОГДА ИСТИНА
		ИНАЧЕ ЛОЖЬ
	КОНЕЦ КАК ЭтоЭталонныйСклад,
	ЕСТЬNULL(ВТ_Остатки.Количество, 0) КАК Сток,
	ЕСТЬNULL(ВТ_МинОстатки.Количество, 0) КАК МинимальныйОстаток,
	ЕСТЬNULL(ВТ_ПоставкиСвод.Количество, 0) КАК Поставка,
	ЕСТЬNULL(ВТ_ПеремещенияСвод.Количество, 0) КАК Перемещение
ИЗ
	ВТ_Ключи КАК ВТ_Ключи
		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Остатки КАК ВТ_Остатки
		ПО ВТ_Ключи.Номенклатура = ВТ_Остатки.Номенклатура
			И ВТ_Ключи.Склад = ВТ_Остатки.Склад
		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_МинОстатки КАК ВТ_МинОстатки
		ПО ВТ_Ключи.Номенклатура = ВТ_МинОстатки.Номенклатура
			И ВТ_Ключи.Склад = ВТ_МинОстатки.Склад
		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ПоставкиСвод КАК ВТ_ПоставкиСвод
		ПО ВТ_Ключи.Номенклатура = ВТ_ПоставкиСвод.Номенклатура
			И ВТ_Ключи.Склад = ВТ_ПоставкиСвод.Склад
		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ПеремещенияСвод КАК ВТ_ПеремещенияСвод
		ПО ВТ_Ключи.Номенклатура = ВТ_ПеремещенияСвод.Номенклатура
			И ВТ_Ключи.Склад = ВТ_ПеремещенияСвод.Склад</query>
