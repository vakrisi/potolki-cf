		Запрос.УстановитьПараметр("ОтборТочкаПродаж", ОтборТочкаПродаж);
	КонецЕсли;
	
	Если ОтборМенеджеры.Количество() > 0 Тогда
		ОтборЗапроса.Добавить("Лиды.Автор В (&ОтборМенеджеры)");
