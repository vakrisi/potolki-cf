&НаСервереБезКонтекста
Функция ЕстьИзмененияВМонтаже(ПараметрыМонтажа)
	
	Результат = Истина;
	
	Если ПараметрыМонтажа.ИндексСтроки = 0 Тогда
		// монтаж на 1 день
		ДанныеМонтажа = ПараметрыМонтажа.МонтажСсылка;
		Если (ДанныеМонтажа.ДатаМонтажа + (ДанныеМонтажа.ВремяНачала - Дата(1, 1, 1))) = ПараметрыМонтажа.Начало
			И (ДанныеМонтажа.ДатаМонтажа + (ДанныеМонтажа.ВремяОкончания - Дата(1, 1, 1))) = ПараметрыМонтажа.Конец
			И ПараметрыМонтажа.МонтажСсылка.Бригада = ПараметрыМонтажа.Бригада Тогда
			Результат = Ложь;
		КонецЕсли;
	Иначе
		// монтаж на несколько дней
		Если ПараметрыМонтажа.МонтажСсылка.ГрафикМонтажей.Количество() >= ПараметрыМонтажа.ИндексСтроки Тогда
			ДанныеМонтажа = ПараметрыМонтажа.МонтажСсылка.ГрафикМонтажей[ПараметрыМонтажа.ИндексСтроки-1];
			Если (ДанныеМонтажа.ДатаМонтажа + (ДанныеМонтажа.ВремяНачала - Дата(1, 1, 1))) = ПараметрыМонтажа.Начало
				И (ДанныеМонтажа.ДатаМонтажа + (ДанныеМонтажа.ВремяОкончания - Дата(1, 1, 1))) = ПараметрыМонтажа.Конец
				И ПараметрыМонтажа.МонтажСсылка.Бригада = ПараметрыМонтажа.Бригада Тогда
				Результат = Ложь;
			КонецЕсли;	
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

