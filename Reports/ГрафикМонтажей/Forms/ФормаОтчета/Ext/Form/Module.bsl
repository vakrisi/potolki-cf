КонецПроцедуры

&НаКлиенте
Процедура РезультатПланировщикВыбор(Элемент, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	Если Не Элементы.РезультатПланировщик.ВыделенныеЭлементы.Количество() Тогда
		Возврат;
	КонецЕсли;
	
	ВыделенныйЭлемент = Элементы.РезультатПланировщик.ВыделенныеЭлементы[0];
	СтруктураМонтаж = ВыделенныйЭлемент.Значение;
	ДокументМонтаж = СтруктураМонтаж.Регистратор;
		
	Если Не ЗначениеЗаполнено(ДокументМонтаж) Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Ключ", ДокументМонтаж);
	
	Если ТипЗнч(ДокументМонтаж) = Тип("ДокументСсылка.Монтаж") Тогда
		ОткрытьФорму("Документ.Монтаж.ФормаОбъекта", ПараметрыФормы);
	КонецЕсли;
	
КонецПроцедуры

