&НаКлиенте
Процедура РезультатПланировщикПриОкончанииРедактирования(Элемент, НовыйЭлемент, ОтменаРедактирования)
	
	ОчиститьСообщения();
	
	Если Элемент.ВыделенныеЭлементы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если Элемент.ВыделенныеЭлементы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ТекущиеДанные = Элемент.ВыделенныеЭлементы[0];
		
	ПараметрыЭлемента = Новый Структура("ИндексСтроки, МонтажСсылка, Начало, Конец, ДатаМонтажа, ВремяНачала, ВремяОкончания, Бригада, ИДМонтажа",
											ТекущиеДанные.Значение.ИндексСтроки, 
											ТекущиеДанные.Значение.Регистратор, 
											ТекущиеДанные.Начало, ТекущиеДанные.Конец,
											НачалоДня(ТекущиеДанные.Начало),
											Дата(1,1,1, Час(ТекущиеДанные.Начало), Минута(ТекущиеДанные.Начало), Секунда(ТекущиеДанные.Начало)),
											Дата(1,1,1, Час(ТекущиеДанные.Конец),  Минута(ТекущиеДанные.Конец),  Секунда(ТекущиеДанные.Конец)),
											ТекущиеДанные.ЗначенияИзмерений["Бригада"],
											ТекущиеДанные.Значение.ИДМонтажа);
											
	// проверки возможности изменения
	СтруктураПроверки = ВозможноИзменениеМонтажа(ПараметрыЭлемента);
	Если НЕ СтруктураПроверки.Результат Тогда
		Для каждого ТекстОшибки из СтруктураПроверки.ОписаниеОшибок Цикл
			Если НЕ ПустаяСтрока(ТекстОшибки) Тогда
				Сообщить(ТекстОшибки);
			КонецЕсли;
		КонецЦикла;
		ОтменаРедактирования = Истина;
		Возврат;
	КонецЕсли; 									
	
	// проверим свободный интервал		
	Если НЕ ПроверитьСвободныйИнтервалМонтажей(ПараметрыЭлемента, Вариант, ФильтрТочкаПродаж) Тогда	
		//Если НЕ СвободныйИнтервалМонтажей(ПараметрыЭлемента) Тогда									
		//	Сообщить("Выбранный интервал занят");
		ОтменаРедактирования = Истина;
		Возврат;
	КонецЕсли; 
	
	// проверим есть ли изменения
	ЕстьИзменения = ЕстьИзмененияВМонтаже(ПараметрыЭлемента);
	Если ЕстьИзменения Тогда
		ПослеСдвигаМонтажа = Новый ОписаниеОповещения("ПослеСдвигаМонтажа", ЭтаФорма, ПараметрыЭлемента);
		ПоказатьВопрос(ПослеСдвигаМонтажа, "Сохранить изменения в документе монтажа?", РежимДиалогаВопрос.ДаНет);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеСдвигаМонтажа(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Нет Тогда
		//отказались от сохранения результата. Перестроим отчет по документам монтажа
        Сформировать(Неопределено);
		Возврат;
	КонецЕсли;
	
	ПослеСдвигаМонтажаНаСервере(ДополнительныеПараметры);
	Сформировать(Неопределено);

КонецПроцедуры

&НаСервере
Процедура ПослеСдвигаМонтажаНаСервере(ПараметрыМонтажа)
		
	ДокОбъект = ПараметрыМонтажа.МонтажСсылка.ПолучитьОбъект();
	ДокОбъект.Бригада = ПараметрыМонтажа.Бригада;
	
	РеквизитыБригады = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокОбъект.Бригада, "Бригадир, ВидБригады");
	ДокОбъект.Бригадир = РеквизитыБригады.Бригадир;
	
	//++ #12356	
	//ДокОбъект.Склад = ДокОбъект.Бригада.Склад;
	ДокОбъект.ЗаполнитьСкладыПоБригаде();
	ДокОбъект.ВидБригады = РеквизитыБригады.ВидБригады;
	//-- #12356
	
	ДокОбъект.Исполнители.Очистить();
	Для Каждого ТекущийСотрудник Из ДокОбъект.Бригада.Сотрудники Цикл
		НоваяСтрока = ДокОбъект.Исполнители.Добавить();
		НоваяСтрока.Сотрудник = ТекущийСотрудник.Сотрудник;
		НоваяСтрока.Коэффициент = 1;
	КонецЦикла;
	
	ДатаМонтажа    = Дата(Год(ПараметрыМонтажа.Начало),Месяц(ПараметрыМонтажа.Начало), День(ПараметрыМонтажа.Начало));
	ВремяНачала    = Дата(1, 1, 1, Час(ПараметрыМонтажа.Начало), Минута(ПараметрыМонтажа.Начало), Секунда(ПараметрыМонтажа.Начало));
	ВремяОкончания = Дата(1, 1, 1, Час(ПараметрыМонтажа.Конец),  Минута(ПараметрыМонтажа.Конец),  Секунда(ПараметрыМонтажа.Конец));	
	
	Если НЕ ДокОбъект.СрокМонтажа = Перечисления.СрокиМонтажа.МонтажНаНесколькоДней Тогда
		ДокОбъект.ДатаМонтажа = ДатаМонтажа;
		ДокОбъект.ВремяНачала = ВремяНачала;
		ДокОбъект.ВремяОкончания = ВремяОкончания;
	Иначе
		Если ДокОбъект.ГрафикМонтажей.Количество() >= ПараметрыМонтажа.ИндексСтроки Тогда
			ДанныеМонтажа = ДокОбъект.ГрафикМонтажей[ПараметрыМонтажа.ИндексСтроки-1];
			ДанныеМонтажа.ДатаМонтажа = ДатаМонтажа;
			ДанныеМонтажа.ВремяНачала = ВремяНачала;
			ДанныеМонтажа.ВремяОкончания = ВремяОкончания;
		КонецЕсли;
	КонецЕсли;
	Попытка
		ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
	Исключение
		Сообщить("Не удалось изменить " + ПараметрыМонтажа.МонтажСсылка + ". Ошибка: " + ОписаниеОшибки());
	КонецПопытки;
	
КонецПроцедуры

