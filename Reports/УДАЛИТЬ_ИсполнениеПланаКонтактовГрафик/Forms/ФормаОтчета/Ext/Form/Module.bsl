&НаСервере
Функция СформироватьНаСервере()
	
	ТекОбъект = ЭтаФорма.РеквизитФормыВЗначение("Отчет");
	Макет = ТекОбъект.ПолучитьМакет("Макет");
	Возврат МодульОтчетов.СформироватьОтчетИсполнениеПланаКонтактовГрафик(Макет, Отчет.ТочкаПродаж, Отчет.Год);
	
КонецФункции

&НаКлиенте
Процедура Сформировать(Команда)
	ТабличныйДокумент = СформироватьНаСервере();
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Отчет.Год = Год(ТекущаяДатаСеанса());
	
КонецПроцедуры

