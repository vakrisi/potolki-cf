		<query>ВЫБРАТЬ
	ИА_СредстваВРезервеНаФондахОстаткиИОбороты.Организация КАК Организация,
	ИА_СредстваВРезервеНаФондахОстаткиИОбороты.ЗП КАК ЗП,
	ИА_СредстваВРезервеНаФондахОстаткиИОбороты.Фонд КАК Фонд,
	ИА_СредстваВРезервеНаФондахОстаткиИОбороты.Подразделение КАК Подразделение,
	ЕСТЬNULL(ИА_СредстваВРезервеНаФондахОстаткиИОбороты.СуммаБезналНачальныйОстаток, 0) КАК СуммаНачальныйОстаток,
	ИА_СредстваВРезервеНаФондахОстаткиИОбороты.СуммаБезналПриход - ЕСТЬNULL(Закрытия.Сумма, 0) КАК СуммаПриход,
	ИА_СредстваВРезервеНаФондахОстаткиИОбороты.СуммаБезналРасход - ЕСТЬNULL(Закрытия.Сумма, 0) КАК СуммаРасход,
	ЕСТЬNULL(ИА_СредстваВРезервеНаФондахОстаткиИОбороты.СуммаБезналКонечныйОстаток, 0) КАК СуммаКонечныйОстаток,
	ИА_СредстваВРезервеНаФондахОстаткиИОбороты.ЗП.ПредметЗаказа КАК ПредметЗаказа,
	ЕСТЬNULL(СостояниеЗП.Статус, ЗНАЧЕНИЕ(Перечисление.ИА_СостояниеЗаказа.Подготовлен)) КАК СтатусЗП,
	ВЫБОР
		КОГДА ЕСТЬNULL(ИА_СредстваВРезервеНаФондахОстаткиИОбороты.СуммаБезналКонечныйОстаток, 0) = 0
			ТОГДА ИСТИНА
		ИНАЧЕ ЛОЖЬ
	КОНЕЦ КАК Оплачено,
	ИА_СредстваВРезервеНаФондахОстаткиИОбороты.ПериодСекунда КАК ПериодСекунда,
	ИА_СредстваВРезервеНаФондахОстаткиИОбороты.Фонд.Счет КАК СчетФонда
ИЗ
	РегистрНакопления.ИА_СредстваВРезервеНаФондах.ОстаткиИОбороты(&amp;НачалоПериода {(&amp;НачалоПериода)}, &amp;КонецПериода {(&amp;КонецПериода)}, Авто, , ) КАК ИА_СредстваВРезервеНаФондахОстаткиИОбороты
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИА_ИсторияСтатусовЗВС.СрезПоследних(НЕОПРЕДЕЛЕНО {(НЕОПРЕДЕЛЕНО) КАК Поле2}, ) КАК СостояниеЗП
		ПО ИА_СредстваВРезервеНаФондахОстаткиИОбороты.ЗП = СостояниеЗП.ЗВС
		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			СУММА(ИА_СредстваВРезервеНаФондах.СуммаБезналРасход) КАК Сумма,
			ИА_СредстваВРезервеНаФондах.ЗП КАК ЗП
		ИЗ
			РегистрНакопления.ИА_СредстваВРезервеНаФондах.Обороты(&amp;НачалоПериода {(&amp;НачалоПериода)}, &amp;КонецПериода {(&amp;КонецПериода)}, Регистратор, ) КАК ИА_СредстваВРезервеНаФондах
		ГДЕ
			ИА_СредстваВРезервеНаФондах.Регистратор ССЫЛКА Документ.ИА_ЗакрытиеЗаказаНаПриобретение
		
		СГРУППИРОВАТЬ ПО
			ИА_СредстваВРезервеНаФондах.ЗП) КАК Закрытия
		ПО (Закрытия.ЗП = ИА_СредстваВРезервеНаФондахОстаткиИОбороты.ЗП)
ГДЕ
	(ИА_СредстваВРезервеНаФондахОстаткиИОбороты.ЗП.Фонд.Счет &lt;&gt; ЗНАЧЕНИЕ(Справочник.ИА_Счета.Счет1)
			ИЛИ &amp;ЭтоРСФ)</query>
