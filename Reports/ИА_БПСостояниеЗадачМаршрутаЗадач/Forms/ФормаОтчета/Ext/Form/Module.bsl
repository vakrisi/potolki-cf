
&НаСервере
Процедура УстановитьВидимостьДоступность()
    Элементы.КомпоновщикНастроекПользовательскиеНастройки.Доступность = ЗначениеЗаполнено(Отчет.МаршрутЗадач);
    ЭтаФорма.КоманднаяПанель.ПодчиненныеЭлементы.ФормаСформировать.Доступность = ЗначениеЗаполнено(Отчет.МаршрутЗадач);
КонецПроцедуры

&НаСервере
Процедура ПриИзмененииМаршрута()
    СохранитьНастройки();
    
	Об = РеквизитФормыВЗначение("Отчет");
    СКД = Об.ПолучитьМакет("МакетОтчета");
    
    Параметр = СКД.Параметры.Найти(Новый ПолеКомпоновкиДанных("МаршрутЗадач"));
    Если Параметр <> Неопределено Тогда
    	Параметр.Значение = Отчет.МаршрутЗадач;
    КонецЕсли; 
    
    АдресСКД = ПоместитьВоВременноеХранилище(СКД, ЭтаФорма.УникальныйИдентификатор);
    
    КомпоновщикНастроек.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(АдресСКД));
    КомпоновщикНастроек.ЗагрузитьНастройки(СКД.НастройкиПоУмолчанию);
    
    Таб = Справочники.ИА_БПМаршрутЗадач.ПолучитьТаблицуДопРеквизитов(Отчет.МаршрутЗадач);
    ТаблицаРеквизитов.Загрузить(Таб);
    
    Для каждого СтрокаК Из ТаблицаРеквизитов Цикл
        СтрокаК.МаршрутЗадач = Отчет.МаршрутЗадач;
        М = ТабНастроекРеквизитов.НайтиСтроки(Новый Структура("Реквизит", СтрокаК.Реквизит));
        Если М.Количество() > 0 Тогда
            СтрокаК.Использование = М[0].Использование;
        КонецЕсли; 
    КонецЦикла; 
КонецПроцедуры

&НаСервере
Процедура СохранитьНастройки()
    ТабТек = ТаблицаРеквизитов.Выгрузить();
    
    Если ТабТек.Количество() > 0 Тогда
        ТабВсе = ТабНастроекРеквизитов.Выгрузить();
        
        МаршрутЗадач = ТабТек[0].МаршрутЗадач;
        иа_бфс.ТЗ_ВставитьТЗПоИзмерениямВДругую(ТабТек, ТабВсе, Новый Структура("МаршрутЗадач", МаршрутЗадач));
        
        ТабНастроекРеквизитов.Загрузить(ТабВсе);
    КонецЕсли; 
КонецПроцедуры


//_____________________________________________________________

&НаСервере
Процедура СформироватьНаСервере()
    Результат.Очистить();
    СКД = ПолучитьИзВременногоХранилища(АдресСКД);
    
    Настройки = КомпоновщикНастроек.ПолучитьНастройки();
    
    Таб = ИА_БФС.ТЗ_ФильтрПоОтбору(ТаблицаРеквизитов, Новый Структура("Использование", Истина));
    Для каждого СтрокаТЗ Из Таб Цикл
    	НовСтрока = Настройки.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
        НовСтрока.Поле  = Новый ПолеКомпоновкиДанных("БП.["+СтрокаТЗ.Наименование+"]");
        НовСтрока.Заголовок = СтрокаТЗ.Реквизит;
        НовСтрока.Использование = Истина;
    КонецЦикла; 
    
    
    ДР = Новый ДанныеРасшифровкиКомпоновкиДанных;    
    КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
    Макет = КомпоновщикМакета.Выполнить(СКД, Настройки, ДР);

    ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
    ПроцессорКомпоновки.Инициализировать(Макет,,ДР);

    ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
    ПроцессорВывода.УстановитьДокумент(Результат);
    ПроцессорВывода.Вывести(ПроцессорКомпоновки, Истина);
    
    ДанныеРасшифровки = ПоместитьВоВременноеХранилище(ДР, ЭтаФорма.УникальныйИдентификатор);
КонецПроцедуры

&НаКлиенте
Процедура Сформировать(Команда)
    Если ЗначениеЗаполнено(Отчет.МаршрутЗадач) Тогда
        СформироватьНаСервере();	
    КонецЕсли;     
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
    УстановитьВидимостьДоступность();
КонецПроцедуры

&НаКлиенте
Процедура МаршрутЗадачПриИзменении(Элемент)
    ПриИзмененииМаршрута();
    УстановитьВидимостьДоступность();
КонецПроцедуры

&НаКлиенте
Процедура ПанельНастроек(Команда)
    Эл = ЭтаФорма.КоманднаяПанель.ПодчиненныеЭлементы.ФормаПанельНастроек;
    Эл.Пометка = НЕ Эл.Пометка;
    Элементы.ГруппаНастроек.Видимость = Эл.Пометка;
КонецПроцедуры

&НаКлиенте
Процедура РезультатОбработкаРасшифровки(Элемент, Расшифровка, СтандартнаяОбработка)
    СтандартнаяОбработка = Ложь;
    ЗначенияКОткрытию = Новый Массив;
    РезультатОбработкаРасшифровкиНаСервере(Расшифровка, ЗначенияКОткрытию);
    Для каждого Значение Из ЗначенияКОткрытию Цикл
    	ПоказатьЗначение(,Значение);
    КонецЦикла; 
КонецПроцедуры


&НаСервере
Процедура РезультатОбработкаРасшифровкиНаСервере(Расшифровка, ЗначенияКОткрытию)
    ДР = ПолучитьИзВременногоХранилища(ДанныеРасшифровки);
    Эл = ДР.Элементы.Получить(Расшифровка);
    Если Эл <> Неопределено Тогда
        Поля = Эл.ПолучитьПоля();
        Для каждого Поле Из Поля Цикл
            Если Поле.Значение <> Null Тогда
                ЗначенияКОткрытию.Добавить(Поле.Значение);	
            КонецЕсли;         	
        КонецЦикла; 
    КонецЕсли;     
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, СтандартнаяОбработка)
    СохранитьНастройки();
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
КонецПроцедуры


