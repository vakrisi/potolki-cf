	Задача.ИА_ЗадачаПланаДействий КАК Задача
ГДЕ
	НЕ Задача.ПометкаУдаления
	И НЕ Задача.БизнесПроцесс.Номер ЕСТЬ NULL 
	И Задача.БизнесПроцесс.ИА_МаршрутЗадачБП = &amp;МаршрутЗадач

ИНДЕКСИРОВАТЬ ПО
	БП,
	ТочкаБП
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ   разрешенные
	ИА_БППлановыеДатыВыполненияЗадач.БизнесПроцесс КАК БизнесПроцесс,
	ИА_БППлановыеДатыВыполненияЗадач.Точка КАК Точка,
	ИА_БППлановыеДатыВыполненияЗадач.ДатаНачала,
	ИА_БППлановыеДатыВыполненияЗадач.ДатаОкончания
ПОМЕСТИТЬ ПлановыеТочки
ИЗ
	РегистрСведений.ИА_БППлановыеДатыВыполненияЗадач КАК ИА_БППлановыеДатыВыполненияЗадач
ГДЕ
	ИА_БППлановыеДатыВыполненияЗадач.БизнесПроцесс В
			(ВЫБРАТЬ
				ВсеЗадачи.БП
			ИЗ
				ВсеЗадачи КАК ВсеЗадачи)

ИНДЕКСИРОВАТЬ ПО
	БизнесПроцесс,
	Точка
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ЕСТЬNULL(ПлановыеТочки.БизнесПроцесс, ВсеЗадачи.БП) КАК БП,
	ЕСТЬNULL(ПлановыеТочки.Точка, ВсеЗадачи.ТочкаБП) КАК Точка,
	ВсеЗадачи.Задача,
	ПлановыеТочки.ДатаНачала КАК ДатаНачалаПлан,
	ПлановыеТочки.ДатаОкончания КАК ДатаОкончанияПлан,
	ВсеЗадачи.ДатаНачалаФакт,
	ВсеЗадачи.ДатаЗавершенияФакт,
	ВсеЗадачи.ИсключенаИзОбработки,
	ВсеЗадачи.Ответственный,
	ВсеЗадачи.Выполнена
ПОМЕСТИТЬ Сводные
ИЗ
	ВсеЗадачи КАК ВсеЗадачи
		ПОЛНОЕ СОЕДИНЕНИЕ ПлановыеТочки КАК ПлановыеТочки
		ПО ВсеЗадачи.ТочкаБП = ПлановыеТочки.Точка
			И ВсеЗадачи.БП = ПлановыеТочки.БизнесПроцесс
;

