ВЫБРАТЬ
	Сводные.БП,
	Сводные.Точка,
	Сводные.Задача,
	Сводные.ДатаНачалаПлан,
	Сводные.ДатаОкончанияПлан,
	Сводные.ДатаНачалаФакт,
	Сводные.ДатаЗавершенияФакт,
	Сводные.Точка.ПорядокВКарте,
	ЕСТЬNULL(Сводные.Задача, Сводные.Точка) КАК ЗадачаТочка,
	ЕСТЬNULL(Сводные.ИсключенаИзОбработки, ЛОЖЬ) КАК ИсключенаИзОбработки,
	Сводные.Точка.Наименование,
	Сводные.БП.ИА_КартаМаршрутаБП КАК КартаМаршрута,
	Сводные.БП.ИА_МаршрутЗадачБП КАК МаршрутЗадач,
	Сводные.БП.ИА_Владелец КАК ВладелецБП,
	Сводные.Ответственный,
	1 КАК Количество,
	Сводные.Выполнена
ИЗ
	Сводные КАК Сводные
{ХАРАКТЕРИСТИКИ
	ТИП(БизнесПроцесс.ИА_БПНоситель)
	ВИДЫХАРАКТЕРИСТИК (ВЫБРАТЬ
			ИА_БПРеквизиты.Ссылка,
			ИА_БПРеквизиты.Наименование + " (" + ИА_БПРеквизиты.УниКод + ")" КАК Наименование,
			ИА_БПРеквизиты.ТипЗначения
		ИЗ
			ПланВидовХарактеристик.ИА_БПРеквизиты КАК ИА_БПРеквизиты
		ГДЕ
			ИА_БПРеквизиты.ВладелецРеквизита = &amp;МаршрутЗадач
			И НЕ ИА_БПРеквизиты.ЭтоГруппа
			И НЕ ИА_БПРеквизиты.ПометкаУдаления)
	ПОЛЕКЛЮЧА Ссылка
	ПОЛЕИМЕНИ Наименование
	ПОЛЕТИПАЗНАЧЕНИЯ ТипЗначения
	ЗНАЧЕНИЯХАРАКТЕРИСТИК (ВЫБРАТЬ
			ИА_БПНосительИА_Реквизиты.Ссылка,
			ИА_БПНосительИА_Реквизиты.Реквизит,
			ИА_БПНосительИА_Реквизиты.Значение
		ИЗ
			БизнесПроцесс.ИА_БПНоситель.ИА_Реквизиты КАК ИА_БПНосительИА_Реквизиты)
	ПОЛЕОБЪЕКТА Ссылка
	ПОЛЕВИДА Реквизит
