		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ РАЗРЕШЕННЫЕ
	ДанныеРегистра.Организация КАК Организация,
	ДанныеРегистра.НомерРозничногоДоговора КАК НомерРозничногоДоговора,
	ДанныеРегистра.Номенклатура КАК Номенклатура,
	ДанныеРегистра.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	ДанныеРегистра.СерияНоменклатуры КАК СерияНоменклатуры,
	ДанныеРегистра.КоличествоОборот КАК КоличествоОборот,
	ДанныеРегистра.Регистратор КАК ДокументПоступления
ПОМЕСТИТЬ ВТ_Приход
ИЗ
	РегистрНакопления.ПоступленияДляРозницыОтПроизодства.Обороты({&amp;МинНачалоПериода}, {&amp;КонецПериода}, Авто, ) КАК ДанныеРегистра
ГДЕ
	ДанныеРегистра.Регистратор ССЫЛКА Документ.ПоступлениеТоваровИУслуг
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗРЕШЕННЫЕ
	ДанныеРегистра.Организация КАК Организация,
	ДанныеРегистра.НомерРозничногоДоговора КАК НомерРозничногоДоговора,
	ДанныеРегистра.Номенклатура КАК Номенклатура,
	ДанныеРегистра.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	ДанныеРегистра.СерияНоменклатуры КАК СерияНоменклатуры,
	ДанныеРегистра.КоличествоОборот КАК Остаток
ПОМЕСТИТЬ ВТ_Остатки
ИЗ
	РегистрНакопления.ПоступленияДляРозницыОтПроизодства.Обороты({&amp;МинНачалоПериода}, {&amp;КонецПериода}, Авто, ) КАК ДанныеРегистра
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗРЕШЕННЫЕ
	ДанныеРегистра.Организация КАК Организация,
	ДанныеРегистра.НомерРозничногоДоговора КАК НомерРозничногоДоговора,
	ДанныеРегистра.Номенклатура КАК Номенклатура,
	ДанныеРегистра.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	ДанныеРегистра.СерияНоменклатуры КАК СерияНоменклатуры,
	ДанныеРегистра.Остаток КАК Остаток,
	(ЕСТЬNULL(ДокументЗаказДоговор.Ссылка, ЗНАЧЕНИЕ(Документ.ЗаказДоговор.ПустаяСсылка))).Контрагент КАК КонтрагентЗаказа,
	ЕСТЬNULL(ВТ_Приход.ДокументПоступления, ЗНАЧЕНИЕ(Документ.ПоступлениеТоваровИУслуг.ПустаяСсылка)) КАК ДокументПоступления
ИЗ
	ВТ_Остатки КАК ДанныеРегистра
		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаказДоговор КАК ДокументЗаказДоговор
		ПО (ДокументЗаказДоговор.Организация = ДанныеРегистра.Организация)
			И (ДокументЗаказДоговор.НомерДоговора = ДанныеРегистра.НомерРозничногоДоговора)
			И (НЕ ДокументЗаказДоговор.НомерДоговора = "")
		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Приход КАК ВТ_Приход
		ПО (ВТ_Приход.Организация = ДанныеРегистра.Организация)
			И (ВТ_Приход.НомерРозничногоДоговора = ДанныеРегистра.НомерРозничногоДоговора)
			И (ВТ_Приход.Номенклатура = ДанныеРегистра.Номенклатура)
			И (ВТ_Приход.ХарактеристикаНоменклатуры = ДанныеРегистра.ХарактеристикаНоменклатуры)
			И (ВТ_Приход.СерияНоменклатуры = ДанныеРегистра.СерияНоменклатуры)</query>
	</dataSet>
	<parameter>
		<name>КонецПериода</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Конец периода</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>xs:dateTime</v8:Type>
			<v8:DateQualifiers>
				<v8:DateFractions>DateTime</v8:DateFractions>
			</v8:DateQualifiers>
		</valueType>
		<value xsi:type="xs:dateTime">0001-01-01T00:00:00</value>
		<useRestriction>true</useRestriction>
		<expression>ВЫБОР КОГДА &amp;ДатаОтчета = ДатаВремя(1,1,1) ТОГДА ДатаВремя(3999,12,31) ИНАЧЕ КонецПериода(&amp;ДатаОтчета, "День") КОНЕЦ</expression>
