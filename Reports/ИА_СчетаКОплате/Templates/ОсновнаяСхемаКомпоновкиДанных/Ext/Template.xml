		<field xsi:type="DataSetFieldField">
			<dataPath>ЗВС</dataPath>
			<field>ЗВС</field>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ РАЗРЕШЕННЫЕ
	ИА_ЗаказыНаПриобретение.ЗП КАК Счет,
	ИА_ЗаказыНаПриобретение.ЗП.Дата КАК ДатаСчета,
	ИА_ЗаказыНаПриобретение.ЗП.ПредметЗаказа КАК Описание,
	ИА_ЗаказыНаПриобретение.ЗП.ДатаОплаты КАК ДатаОплаты,
	ИА_ЗаказыНаПриобретение.СуммаПриход КАК СуммаПриход,
	ИА_ЗаказыНаПриобретение.СуммаРасход КАК СуммаРасход,
	ИА_ЗаказыНаПриобретение.СуммаКонечныйОстаток КАК СуммаКонечныйОстаток,
	ВЫБОР
		КОГДА &amp;ТекДата &gt; ИА_ЗаказыНаПриобретение.ЗП.ДатаОплаты
			ТОГДА РАЗНОСТЬДАТ(ИА_ЗаказыНаПриобретение.ЗП.ДатаОплаты, &amp;ТекДата, ДЕНЬ)
		ИНАЧЕ 0
	КОНЕЦ КАК ДнейПросрочки,
	ВЫБОР
		КОГДА &amp;ТекДата &gt; КОНЕЦПЕРИОДА(ИА_ЗаказыНаПриобретение.ЗП.ДатаОплаты, ДЕНЬ)
			ТОГДА ИА_ЗаказыНаПриобретение.СуммаКонечныйОстаток
		ИНАЧЕ 0
	КОНЕЦ КАК СуммаПросрочки2,
	ИА_ЗаказыНаПриобретение.Регистратор КАК Регистратор,
	ИА_ЗаказыНаПриобретение.НомерСтроки КАК НомерСтроки,
	ИА_ЗаказыНаПриобретение.ПериодСекунда КАК ПериодСекунда,
	ИА_ЗаказыНаПриобретение.СуммаНачальныйОстаток КАК СуммаНачальныйОстаток,
	ИА_ЗаказыНаПриобретение.ЗП.ДатаОплаты КАК ЗПДатаОплаты,
	ИА_ЗаказыНаПриобретение.Организация КАК Организация,
	ЕСТЬNULL(СостояниеЗП.Статус, ЗНАЧЕНИЕ(Перечисление.ИА_СостояниеЗаказа.Подготовлен)) КАК СтатусЗП,
	ЕСТЬNULL(ИА_СредстваВРезервеНаФондахОстатки.СуммаБезналОстаток, 0) + ЕСТЬNULL(ИА_СредстваВРезервеНаФондахОстатки.СуммаНалОстаток, 0) КАК ОдобреноНеВыплачено,
	ИА_ЗаказыНаПриобретение.ЗП.Фонд.Счет КАК СчетФонда,
	ИА_ЗаказыНаПриобретение.ЗП.Фонд КАК Фонд
ИЗ
	РегистрНакопления.ИА_ЗаказыНаПриобретение.ОстаткиИОбороты(, , Авто, Движения, ЗП.ДатаОплаты &lt;&gt; ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)) КАК ИА_ЗаказыНаПриобретение
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ИА_СредстваВРезервеНаФондах.Остатки КАК ИА_СредстваВРезервеНаФондахОстатки
		ПО ИА_ЗаказыНаПриобретение.ЗП = ИА_СредстваВРезервеНаФондахОстатки.ЗП
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИА_ИсторияСтатусовЗВС.СрезПоследних КАК СостояниеЗП
		ПО ИА_ЗаказыНаПриобретение.ЗП = СостояниеЗП.ЗВС
ГДЕ
	ИА_ЗаказыНаПриобретение.СуммаКонечныйОстаток &gt; 0
	И ВЫБОР
			КОГДА СостояниеЗП.Статус ЕСТЬ NULL
				ТОГДА ИА_ЗаказыНаПриобретение.ЗП.Статус &lt;&gt; ЗНАЧЕНИЕ(Перечисление.ИА_СостояниеЗаказа.Подготовлен)
			ИНАЧЕ СостояниеЗП.Статус &lt;&gt; ЗНАЧЕНИЕ(Перечисление.ИА_СостояниеЗаказа.Подготовлен)
		КОНЕЦ
	И ВЫБОР
			КОГДА СостояниеЗП.Статус ЕСТЬ NULL
				ТОГДА ИА_ЗаказыНаПриобретение.ЗП.Статус &lt;&gt; ЗНАЧЕНИЕ(Перечисление.ИА_СостояниеЗаказа.Отклонен)
			ИНАЧЕ СостояниеЗП.Статус &lt;&gt; ЗНАЧЕНИЕ(Перечисление.ИА_СостояниеЗаказа.Отклонен)
		КОНЕЦ
	И (ИА_ЗаказыНаПриобретение.ЗП.Фонд.Счет &lt;&gt; ЗНАЧЕНИЕ(Справочник.ИА_Счета.Счет1)
			ИЛИ &amp;ЭтоРСФ)</query>
	</dataSet>
