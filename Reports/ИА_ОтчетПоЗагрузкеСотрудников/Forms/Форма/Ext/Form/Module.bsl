&НаСервереБезКонтекста
Функция ПолучитьПоказателиСтатистик(Пост, ДатаНачала = '00010101000000', ДатаОкончания = '00010101000000')

	Если Не ЗначениеЗаполнено(Пост.НастройкаСтатистик) Тогда
		Возврат Неопределено;
	КонецЕсли;
	тзПоказатели = Новый ТаблицаЗначений;
	тзПоказатели.Колонки.Добавить("ВидСтатистики");
	тзПоказатели.Колонки.Добавить("Аналитика1");
	тзПоказатели.Колонки.Добавить("Аналитика2");
	тзПоказатели.Колонки.Добавить("Аналитика3");
	тзПоказатели.Колонки.Добавить("Количество");
	
	ДатаНачала = ?(ДатаНачала = Дата("00010101000000"), Дата(1990, 1, 1, 0, 0, 0), ДатаНачала);
	ДатаОкончания = ?(ДатаОкончания = Дата("00010101000000"), Дата(2100, 1, 1, 0, 0, 0), КонецДня(ДатаОкончания));

	Для каждого с из Пост.НастройкаСтатистик.Статистики Цикл
		Данные = ПолучитьЗначениеСтатистики(с.ВидСтатистики, с.Аналитика1,  с.Аналитика2,  с.Аналитика3, ДатаНачала, ДатаОкончания);
	
		стрПоказ = тзПоказатели.Добавить();
		ЗаполнитьЗначенияСвойств(стрПоказ, с);
		Если с.ВидСтатистики.ВидИтогов = Перечисления.ИА_ВидыИтогов.Сумма Тогда
			стрПоказ.Количество = Данные.Итог("Количество");
		ИначеЕсли с.ВидСтатистики.ВидИтогов = Перечисления.ИА_ВидыИтогов.СреднееЗначение Тогда
			КоличествоДанных = Данные.Количество();
			Если КоличествоДанных = 0 Тогда
				стрПоказ.Количество = 0;
			Иначе	
				стрПоказ.Количество = Окр(Данные.Итог("Количество") / КоличествоДанных, 2, 2);
			КонецЕсли;	
		КонецЕсли;	
		
	КонецЦикла;

	Возврат тзПоказатели;
	
КонецФункции // ПолучитьПоказателиСтатистик()

&НаСервереБезКонтекста
Функция ПолучитьЗначениеСтатистики(пВидСтатистики, пАналитика1, пАналитика2, пАналитика3, пДатаНачала, пДатаКонца)
	ДатаНач = НачалоДня(пДатаНачала);
	ДатаКон = КонецДня(пДатаКонца);
	Данные = Новый ТаблицаЗначений;
	Данные.Колонки.Добавить("ДатаНачала");
	Данные.Колонки.Добавить("ДатаКонца");
	Новстр = Данные.Добавить();
	Новстр.ДатаНачала = ДатаНач;
	Новстр.ДатаКонца = ДатаКон;
	СтрокаСтатистик = Новый Структура("ВидСтатистики,Аналитика1,Аналитика2,Аналитика3,Данные",пВидСтатистики, пАналитика1, пАналитика2, пАналитика3,Данные);
	
	ТЗ = ИА_Защита_Статистика.ПолучитьТЗДанныеСтатистики(СтрокаСтатистик,ДатаНач,ДатаКон);
	
	возврат тз;
КонецФункции

