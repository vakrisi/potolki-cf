&НаСервереБезКонтекста
Функция ПолучитьВходящие(ДатаНачала = '00010101000000', ДатаОкончания = '00010101000000')

	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	ИА_ЗадачаПланаДействий.Ссылка КАК Задача,
	                      |	ИА_ЗадачаПланаДействий.Пост КАК Пост,
	                      |	ВЫБОР
	                      |		КОГДА ИА_ЗадачаПланаДействий.Пользователь = ЗНАЧЕНИЕ(Справочник.Пользователи.ПустаяСсылка)
	                      |			ТОГДА ИА_АдресацияЗадачПланаДействий.Пользователь
	                      |		ИНАЧЕ ИА_ЗадачаПланаДействий.Пользователь
	                      |	КОНЕЦ КАК Пользователь
	                      |ПОМЕСТИТЬ ВТЗадачиПользователяНаПосту
	                      |ИЗ
	                      |	Задача.ИА_ЗадачаПланаДействий КАК ИА_ЗадачаПланаДействий
	                      |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИА_АдресацияЗадачПланаДействий КАК ИА_АдресацияЗадачПланаДействий
	                      |		ПО ИА_ЗадачаПланаДействий.Пост = ИА_АдресацияЗадачПланаДействий.Пост
	                      |			И (ИА_АдресацияЗадачПланаДействий.Пользователь В (&Пользователь))
	                      |ГДЕ
	                      |	(ИА_ЗадачаПланаДействий.Пост = ЗНАЧЕНИЕ(Справочник.Оргсхема.ПустаяСсылка)
	                      |			ИЛИ НЕ ИА_АдресацияЗадачПланаДействий.Пользователь ЕСТЬ NULL )
	                      |	И НЕ ИА_ЗадачаПланаДействий.Выполнена
	                      |	И НЕ ИА_ЗадачаПланаДействий.Отложена
	                      |	И ИА_ЗадачаПланаДействий.Отправлена
	                      |	И НЕ ИА_ЗадачаПланаДействий.ПометкаУдаления
	                      |	И ИА_ЗадачаПланаДействий.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
	                      |;
	                      |
	                      |////////////////////////////////////////////////////////////////////////////////
	                      |ВЫБРАТЬ
	                      |	ВТЗадачиПользователяНаПосту.Задача,
	                      |	ВТЗадачиПользователяНаПосту.Пост,
	                      |	ВТЗадачиПользователяНаПосту.Пользователь,
	                      |	ИА_ДанныеФизЛиц.ФизЛицо КАК ФизЛицо
	                      |ИЗ
	                      |	ВТЗадачиПользователяНаПосту КАК ВТЗадачиПользователяНаПосту
	                      |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИА_ДанныеФизЛиц КАК ИА_ДанныеФизЛиц
	                      |		ПО ВТЗадачиПользователяНаПосту.Пользователь = ИА_ДанныеФизЛиц.Пользователь");
						  
						  
	//ПроверитьФизЛицоВЗапросе(Запрос);
	
	ДатаНачала = ?(ДатаНачала = Дата("00010101000000"), Дата(1900, 1, 1, 0, 0, 0), ДатаНачала);
	ДатаОкончания = ?(ДатаОкончания = Дата("00010101000000"), Дата(2100, 1, 1, 0, 0, 0), КонецДня(ДатаОкончания));
	Запрос.УстановитьПараметр("Пользователь", ПолучитьПользователей());
	Запрос.УстановитьПараметр("ДатаНачала", ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания", ДатаОкончания);
						  
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции // ПолучитьВходящие()

&НаСервереБезКонтекста
Функция ПолучитьВРаботе(ДатаНачала = '00010101000000', ДатаОкончания = '00010101000000')
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	ИА_ЗадачаПланаДействий.Ссылка КАК Задача,
	                      |	ИА_ЗадачаПланаДействий.Пост,
	                      |	ВЫБОР
	                      |		КОГДА ИА_ЗадачаПланаДействий.Пользователь = ЗНАЧЕНИЕ(Справочник.Пользователи.ПустаяСсылка)
	                      |			ТОГДА ИА_АдресацияЗадачПланаДействий.Пользователь
	                      |		ИНАЧЕ ИА_ЗадачаПланаДействий.Пользователь
	                      |	КОНЕЦ КАК Пользователь
	                      |ПОМЕСТИТЬ ВТЗадачиПользователяНаПосту
	                      |ИЗ
	                      |	Задача.ИА_ЗадачаПланаДействий КАК ИА_ЗадачаПланаДействий
	                      |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИА_АдресацияЗадачПланаДействий КАК ИА_АдресацияЗадачПланаДействий
	                      |		ПО (ИА_АдресацияЗадачПланаДействий.Пользователь В (&Пользователь))
	                      |			И ИА_ЗадачаПланаДействий.Пост = ИА_АдресацияЗадачПланаДействий.Пост
	                      |ГДЕ
