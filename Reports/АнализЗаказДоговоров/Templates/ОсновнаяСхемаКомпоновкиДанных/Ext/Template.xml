		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ РАЗРЕШЕННЫЕ
	ЕСТЬNULL(Продажи.Период, РасчетыПоЗаказамОстаткиИОбороты.ПериодСекунда) КАК Порядок, // №12802 + 16251
	РасчетыПоЗаказамОстаткиИОбороты.Заказ КАК ЗаказДоговор,
	ВЫРАЗИТЬ(РасчетыПоЗаказамОстаткиИОбороты.Заказ КАК Документ.ЗаказДоговор).Контрагент КАК Контрагент,
	ВЫРАЗИТЬ(РасчетыПоЗаказамОстаткиИОбороты.Заказ КАК Документ.ЗаказДоговор).СуммаДокумента КАК СуммаПоДоговору,
	РасчетыПоЗаказамОстаткиИОбороты.СуммаПриход КАК СуммаПриход,
	РасчетыПоЗаказамОстаткиИОбороты.СуммаРасход КАК Оплачено,
	РасчетыПоМонтажам.СуммаРасход КАК ОплаченоПоМонтажам,
	Продажи.ДокументПродажи КАК Монтаж,
	ЕСТЬNULL(Продажи.СуммаОборот, 0) КАК СуммаМонтажа,
	ЕСТЬNULL(ВзаиморасчетыСКонтрагентамиОстатки.СуммаОстаток, 0) КАК ОбщийТекущийДолг,
	РасчетыПоЗаказамОстаткиИОбороты.СуммаНачальныйОстаток КАК СуммаНачальныйОстаток,
	РасчетыПоЗаказамОстаткиИОбороты.СуммаКонечныйОстаток КАК СуммаКонечныйОстаток
ИЗ
	РегистрНакопления.РасчетыПоЗаказам.ОстаткиИОбороты(, , Авто, ДвиженияИГраницыПериода, ) КАК РасчетыПоЗаказамОстаткиИОбороты
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.Продажи.Обороты(, , Регистратор, ) КАК Продажи
		ПО (РасчетыПоЗаказамОстаткиИОбороты.Заказ = ВЫРАЗИТЬ(Продажи.ДокументПродажи КАК Документ.Монтаж).Основание)
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ВзаиморасчетыСКонтрагентами.Остатки КАК ВзаиморасчетыСКонтрагентамиОстатки
		ПО РасчетыПоЗаказамОстаткиИОбороты.Заказ.Контрагент = ВзаиморасчетыСКонтрагентамиОстатки.Контрагент
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.Продажи.Обороты КАК ПродажиИтог
		ПО ((ВЫРАЗИТЬ(РасчетыПоЗаказамОстаткиИОбороты.Заказ КАК Документ.ЗаказДоговор)) = ВЫРАЗИТЬ(ПродажиИтог.ДокументПродажи КАК Документ.Монтаж).Основание)
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.РасчетыПоЗаказам.Обороты(, , , ) КАК РасчетыПоМонтажам
		ПО (РасчетыПоМонтажам.Заказ = (ВЫРАЗИТЬ(Продажи.ДокументПродажи КАК Документ.Монтаж)))
ГДЕ
	РасчетыПоЗаказамОстаткиИОбороты.Заказ ССЫЛКА Документ.ЗаказДоговор //и РасчетыПоЗаказамОстаткиИОбороты.Заказ.номер = "ПР0000021"
{ГДЕ
	(ВЫРАЗИТЬ(РасчетыПоЗаказамОстаткиИОбороты.Заказ КАК Документ.ЗаказДоговор).Дата &gt;= НАЧАЛОПЕРИОДА(&amp;ДатаНачала, ДЕНЬ)),
	(ВЫРАЗИТЬ(РасчетыПоЗаказамОстаткиИОбороты.Заказ КАК Документ.ЗаказДоговор).Дата &lt;= КОНЕЦПЕРИОДА(&amp;ДатаОкончания, ДЕНЬ))}</query>
	</dataSet>
