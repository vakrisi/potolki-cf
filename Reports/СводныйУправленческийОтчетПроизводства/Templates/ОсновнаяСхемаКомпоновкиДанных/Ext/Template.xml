		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ РАЗРЕШЕННЫЕ
	ЗаказНаПроизводствоДокумент.Ссылка КАК Регистратор,
	ЗакНаПроОбороты.Регистратор КАК ДокументВыпуска,
	ЗаказНаПроизводствоДокумент.Подразделение КАК Подразделение,
	ВЫБОР
		КОГДА &amp;ВариантПо = 0
			ТОГДА НачалоПериода(ЗаказНаПроизводствоДокумент.Дата, МЕСЯЦ)
		//#14233
		//ИНАЧЕ НачалоПериода(ЗакНаПроОбороты.Регистратор.Дата, МЕСЯЦ)
		ИНАЧЕ НачалоПериода(ЗакНаПроОбороты.Период, МЕСЯЦ)
	КОНЕЦ КАК Месяц,
	ЕСТЬNULL(ЗаказНаПроизводствоДокумент.ПродукцияНоменклатураКоличество, 0) КАК КоличествоПроизведено,
	ЕСТЬNULL(ВыработкаПроизводстваОбороты.КоличествоОборот, 0) КАК КоличествоВыработка,
	
	//#13763 заменено
	//ВЫБОР
	//	КОГДА РасходМатериаловНаПроизводствеОбороты.ЕдиницаИзмерения ССЫЛКА Справочник.ЕдиницыИзмерений
	//		ТОГДА ЕСТЬNULL(РасходМатериаловНаПроизводствеОбороты.ЕдиницаИзмерения.Коэффициент * РасходМатериаловНаПроизводствеОбороты.КоличествоОборот, 0)
	//	ИНАЧЕ ЕСТЬNULL(РасходМатериаловНаПроизводствеОбороты.КоличествоОборот, 0)
	//КОНЕЦ КАК КоличествоПленки,
	ЕСТЬNULL(РасходМатериаловНаПроизводствеОбороты.КоличествоВБазовыхЕдиницахОборот, 0) КАК КоличествоПленки,
	
	//#13763 заменено
	//ВЫБОР
	//	КОГДА РасходОстатковПленкиНаПроизводстве.ЕдиницаИзмерения ССЫЛКА Справочник.ЕдиницыИзмерений
	//		ТОГДА ЕСТЬNULL(РасходОстатковПленкиНаПроизводстве.ЕдиницаИзмерения.Коэффициент * РасходОстатковПленкиНаПроизводстве.КоличествоОборот, 0)
	//	ИНАЧЕ ЕСТЬNULL(РасходОстатковПленкиНаПроизводстве.КоличествоОборот, 0)
	//КОНЕЦ КАК КоличествоОстатка,
	ЕСТЬNULL(РасходОстатковПленкиНаПроизводстве.КоличествоВБазовыхЕдиницахОборот, 0) КАК КоличествоОстатка,
	
	ЕСТЬNULL(РасходПолотнаЗаказчикаНаПроизводстве.КоличествоВБазовыхЕдиницахОборот, 0) КАК КоличествоПолотнаЗаказчика,
	
	
	ЗаказНаПроизводствоДокумент.ПродукцияСумма КАК СтоимостьПотолков,
	ЗакНаПроОбороты.КоличествоРасход КАК КоличествоПроизведеноФакт,
	ЕСТЬNULL(УслугиЗаказаНаПроизводство.Сумма, 0) КАК СтоимостьУслуг,
	ЗаказНаПроизводствоДокумент.ПродукцияСумма + ЕСТЬNULL(УслугиЗаказаНаПроизводство.Сумма, 0) КАК СтоимостьПотолковИУслуг
ИЗ
	Документ.ЗаказНаПроизводство КАК ЗаказНаПроизводствоДокумент
	
		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			ЗаказНаПроизводствоУслуги.Ссылка КАК ДокументЗаказа,
			СУММА(ЗаказНаПроизводствоУслуги.Сумма) КАК Сумма
		ИЗ
			Документ.ЗаказНаПроизводство.Услуги КАК ЗаказНаПроизводствоУслуги
		
		СГРУППИРОВАТЬ ПО
			ЗаказНаПроизводствоУслуги.Ссылка) КАК УслугиЗаказаНаПроизводство
		ПО ЗаказНаПроизводствоДокумент.Ссылка = УслугиЗаказаНаПроизводство.ДокументЗаказа
		
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ВыработкаПроизводства.Обороты({(&amp;НачПериода)}, {(&amp;КонПериода)}, Регистратор, ) КАК ВыработкаПроизводстваОбороты
		ПО ЗаказНаПроизводствоДокумент.Ссылка = ВыработкаПроизводстваОбороты.ЗаказНаПроизводство
		
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.РасходМатериаловНаПроизводстве.Обороты(
				{(&amp;НачПериода)}, 
				{(&amp;КонПериода)}, 
				Авто, 
				Номенклатура.ВидНоменклатуры В (ЗНАЧЕНИЕ(Справочник.ВидыНоменклатуры.Полотно), 
												ЗНАЧЕНИЕ(Справочник.ВидыНоменклатуры.ОстатокПленки))
					ИЛИ Номенклатура = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПолотноЗаказчика)								
		) КАК РасходМатериаловНаПроизводствеОбороты
		ПО ЗаказНаПроизводствоДокумент.ПродукцияНоменклатура = РасходМатериаловНаПроизводствеОбороты.Продукция
		
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.РасходМатериаловНаПроизводстве.Обороты(
				{(&amp;НачПериода)},
				{(&amp;КонПериода)},
				Авто,
				Номенклатура = Значение(Справочник.Номенклатура.ОстаткиПленки)
					ИЛИ Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Справочник.ВидыНоменклатуры.ОстатокПленки)
		) КАК РасходОстатковПленкиНаПроизводстве
		ПО ЗаказНаПроизводствоДокумент.ПродукцияНоменклатура = РасходОстатковПленкиНаПроизводстве.Продукция
		
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.РасходМатериаловНаПроизводстве.Обороты(
				{(&amp;НачПериода)},
				{(&amp;КонПериода)},
				Авто,
				Номенклатура = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПолотноЗаказчика)
		) КАК РасходПолотнаЗаказчикаНаПроизводстве
		ПО ЗаказНаПроизводствоДокумент.ПродукцияНоменклатура = РасходПолотнаЗаказчикаНаПроизводстве.Продукция
		
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ЗаказыНаПроизводство.Обороты({(&amp;НачПериода)}, {(&amp;КонПериода)} , Регистратор, ) КАК ЗакНаПроОбороты
		ПО ЗаказНаПроизводствоДокумент.Ссылка = ЗакНаПроОбороты.ЗаказНаПроизводство
ГДЕ
	ВЫБОР
			КОГДА &amp;ВариантПо = 0
				ТОГДА ГОД(ЗаказНаПроизводствоДокумент.Дата) = &amp;Год
			//#14233
			//ИНАЧЕ ГОД(ЗакНаПроОбороты.Регистратор.Дата) = &amp;Год
			ИНАЧЕ ГОД(ЗакНаПроОбороты.Период) = &amp;Год
		КОНЕЦ
	И ЗаказНаПроизводствоДокумент.Проведен
	И ЗаказНаПроизводствоДокумент.ТекущийСтатус = Значение(Справочник.СтатусыЗаказовНаПроизводство.Произведен)

