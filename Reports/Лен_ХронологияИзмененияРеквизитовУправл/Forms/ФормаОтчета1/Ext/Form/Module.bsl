&НаКлиенте
Процедура УстановитьДоступныеВидыСравнения(Значение)
	
	Если Значение.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ЗначениеРеквизита")
		ИЛИ Значение.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект") Тогда
		
		Значение.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;					
		Поле = Отчет.КомпоновщикНастроек.Настройки.Отбор.ДоступныеПоляОтбора.НайтиПоле(Значение.ЛевоеЗначение);
		
		Поле.ДоступныеВидыСравнения.Очистить();		
		Поле.ДоступныеВидыСравнения.Добавить(ВидСравненияКомпоновкиДанных.Равно);		
		Поле.ДоступныеВидыСравнения.Добавить(ВидСравненияКомпоновкиДанных.НеРавно);		
		
	ИначеЕсли Значение.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Реквизит") 
		ИЛИ Значение.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Метаданные")
		ИЛИ Значение.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Компьютер") Тогда
		
		Значение.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;				
		
		Поле = Отчет.КомпоновщикНастроек.Настройки.Отбор.ДоступныеПоляОтбора.НайтиПоле(Значение.ЛевоеЗначение);		
		Поле.ДоступныеВидыСравнения.Очистить();
		
		Поле.ДоступныеВидыСравнения.Добавить(ВидСравненияКомпоновкиДанных.Равно);		
		Поле.ДоступныеВидыСравнения.Добавить(ВидСравненияКомпоновкиДанных.НеРавно);			
		Поле.ДоступныеВидыСравнения.Добавить(ВидСравненияКомпоновкиДанных.Содержит);			
		Поле.ДоступныеВидыСравнения.Добавить(ВидСравненияКомпоновкиДанных.НеСодержит);						
		Поле.ДоступныеВидыСравнения.Добавить(ВидСравненияКомпоновкиДанных.ВСписке);		
		Поле.ДоступныеВидыСравнения.Добавить(ВидСравненияКомпоновкиДанных.НеВСписке);
		
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВидовСравнения()
	
	Для Каждого Значение Из Отчет.КомпоновщикНастроек.Настройки.Отбор.Элементы Цикл
		
		УстановитьДоступныеВидыСравнения(Значение);
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии()
	
	Если Отчет.АтоматическийРежим Тогда
		
		Элементы.ОсновнаяКоманднаяПанель.ПодчиненныеЭлементы.ФормаОтображениеПанелиБыстрогоОтбора.Пометка = Истина;
		
	КонецЕсли;
	
	ЭтаФорма.Элементы.Результат.ОтображениеСостояния.Видимость = ложь;
	ОтображениеПанелиБыстрогоОтбора(Элементы.ОсновнаяКоманднаяПанель.ПодчиненныеЭлементы.ФормаОтображениеПанелиБыстрогоОтбора);
		
	ОбновитьКнопкиВыбораВыриантовСохраненныхНастроек();		
	
	ОтображениеПанелиВыбораВариантовСохраненныхНастроек(Элементы.ОсновнаяКоманднаяПанель.ПодчиненныеЭлементы.ФормаОтображениеПанелиВыбораВариантовСохраненныхНастроек);	
	
	ОбработкаВидовСравнения();
	
	//Если НЕ Лен_ОбщегоНазначенияКлиент.РольДоступнаНаКлиенте("ПолныеПрава") Тогда
	Если НЕ ЕстьРоль("ПолныеПрава") Тогда	
		Элементы.Отбор.ИзменятьСоставСтрок = Ложь;		
		Элементы.ПанельБыстрыхНастроек.ПодчиненныеЭлементы.Группа7.Доступность = Ложь;	// ВыбранныеПоля
		Элементы.ПанельБыстрыхНастроек.ПодчиненныеЭлементы.Группа8.Доступность = Ложь;	// Параметры		
		Элементы.ОсновнаяКоманднаяПанель.ПодчиненныеЭлементы.ФормаРежимНастроекЭксперт.Доступность = Ложь;			// РежимНастроекЭксперт
		
	КонецЕсли;
	
	//Нужно доработать
	//СохранениеНастроек.ЗаполнитьНастройкиПриОткрытииОтчета(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура Сформировать(Команда) 
		
	СформироватьОтчетИзОбъекта(ЭтаФорма.Результат, ЭтаФорма.ДанныеРасшифровки);	
			
КонецПроцедуры

&НаСервере
Процедура СформироватьОтчетИзОбъекта(Результат, ДанныеРасшифровки) Экспорт
	
	ЭтаФорма.Элементы.Результат.ОтображениеСостояния.Видимость = ложь;
	Док = РеквизитФормыВЗначение("Отчет");	
	Док.Сформировать(Результат, ДанныеРасшифровки); 
	
	//Никифоров
	ДанныеРасшифровки = "";
	
	ЭтаФорма.Элементы.Результат.ОтображениеСостояния.ДополнительныйРежимОтображения=ДополнительныйРежимОтображения.НеИспользовать;
	ЭтаФорма.Элементы.Результат.ОтображениеСостояния.Видимость = ложь;

	ЭтаФорма.ВариантМодифицирован = Ложь; 
	
КонецПроцедуры

&НаКлиенте
Процедура ВыборПериода(Команда)

	//НастройкаПериода = ПолучитьНастройкуПериода();
	НастройкаПериода = Новый ДиалогРедактированияСтандартногоПериода;
	СтандПериод = Новый СтандартныйПериод;
	СтандПериод.ДатаНачала = Отчет.НачалоПериода;
	СтандПериод.ДатаОкончания = ?(Отчет.КонецПериода='0001-01-01', Отчет.КонецПериода, КонецДня(Отчет.КонецПериода));
	НастройкаПериода.Период = СтандПериод;
	
	Если НастройкаПериода.Редактировать() Тогда		
		Отчет.НачалоПериода = НастройкаПериода.Период.ДатаНачала;
		Отчет.КонецПериода  = НастройкаПериода.Период.ДатаОкончания;		
	КонецЕсли;

	УстановитьПроверитьПериодОтчетаСКлиента();	
	
КонецПроцедуры

&НаСервере
Процедура УстановитьПроверитьПериодОтчетаСКлиента()
	
	Док = РеквизитФормыВЗначение("Отчет");
	Док.УстановитьПроверитьПериодОтчета();
	
КонецПроцедуры

&НаКлиенте
Процедура НачалоПериодаПриИзменении(Элемент)
	
	Отчет.УстановитьПроверитьПериодОтчета();		
	
КонецПроцедуры

&НаКлиенте
Процедура КонецПериодаПриИзменении(Элемент)
	
	Отчет.УстановитьПроверитьПериодОтчета();		
	
КонецПроцедуры

