&НаКлиенте
Перем СписокВыбораВидаОперации;
&НаКлиенте
Перем БазовыйМеханизмПодбораВариантовНастроек;

&НаКлиенте
Процедура ОбработкаНажатияКнопкиВыбораВыриантаСохраненнойНастройки(Элемент)
	
	Индекс = Число(Сред(Элемент.Имя, 30));
	
	ВыбранныйВариантСохраненнойНастройки = Отчет.ТаблицаВариантовСохраненныхНастроекОтчета[Индекс].Ссылка;
	
	Если Не ВыбранныйВариантСохраненнойНастройки.Пустая() И ВыбранныйВариантСохраненнойНастройки.ПолучитьОбъект() = Неопределено Тогда
		
		Предупреждение("Вариант отчета """ + Элемент.ТекстНевыбраннойКартинки + """ удален.",15);
		
		ОбновитьКнопкиВыбораВыриантовСохраненныхНастроек();
		
		Если Отчет.ТаблицаВариантовСохраненныхНастроекОтчета.Количество() = 0 Тогда
		
			ОтображениеПанелиВыбораВариантовСохраненныхНастроек(Элементы.ДействияФормы.Кнопки.ОтображениеПанелиВыбораВариантовСохраненныхНастроек);		
		
		КонецЕсли;		
		
		Возврат;
		
	ИначеЕсли ВыбранныйВариантСохраненнойНастройки.ПометкаУдаления Тогда
		
		Предупреждение("Вариант отчета """ + Элемент.ТекстНевыбраннойКартинки + """ помечен на удаление.",15);
		
		ОбновитьКнопкиВыбораВыриантовСохраненныхНастроек();
		
		Если Отчет.ТаблицаВариантовСохраненныхНастроекОтчета.Количество() = 0 Тогда
		
			ОтображениеПанелиВыбораВариантовСохраненныхНастроек(Элементы.ДействияФормы.Кнопки.ОтображениеПанелиВыбораВариантовСохраненныхНастроек);		
		
		КонецЕсли;			
		
		Возврат;		
		
	КонецЕсли;
	
	ОтображенияПометкиВыбраннойСохраненнойНастройки(Элемент);	
	
	Если Не БазовыйМеханизмПодбораВариантовНастроек Тогда
		
		СохраненнаяНастройка = Отчет.ТаблицаВариантовСохраненныхНастроекОтчета[Индекс].Ссылка;
		
		Отчет.ПрименитьНастройку();
		
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьКнопкуВыбораВариантаСохраненнойНастройки(Индекс, Заголовок, Описание)
	
	Кнопка = Элементы.Добавить(Тип("ПолеКартинки"), "КнопкаВыбораВариантаНастройки" + Индекс, Истина, Элементы.ПанельВыбораВариантовСохраненныхНастроек);		
		
	Кнопка.Рамка                    = Новый Рамка(ТипРамкиЭлементаУправления.Одинарная,1);
	Кнопка.ГиперСсылка 				= Истина;
	Кнопка.ТекстНевыбраннойКартинки = Заголовок;
	Кнопка.Лево 					= ?(Индекс = 0,2,Элементы["КнопкаВыбораВариантаНастройки" + (Индекс - 1)].Лево + 131);
	Кнопка.Верх 					= 2;
	Кнопка.Ширина 					= 130;
	Кнопка.Высота					= 42;
	Кнопка.ЦветФона 				= WebЦвета.Лазурный;
	Кнопка.ЦветТекста 				= WebЦвета.Черный;
	Кнопка.АвтоКонтекстноеМеню 		= Ложь;
	Кнопка.Подсказка 				= Описание;
	
	Кнопка.УстановитьДействие("Нажатие", Новый Действие("ОбработкаНажатияКнопкиВыбораВыриантаСохраненнойНастройки"));	
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьКнопкиВыбораВыриантовСохраненныхНастроек()
	
	колич = КоличествоСтрокТаблицыВариантовСохрНастроекОтчета();
	
	Для Индекс = 0 По колич - 1 Цикл		
		
		Кнопка = Элементы["КнопкаВыбораВариантаНастройки" + Индекс];
		
		Элементы.Удалить(Кнопка);
			
	КонецЦикла;
	
	ЗаполнитьТаблицуДоступныхВариантовСохраненныхНастроек1();	
	
	Для Индекс = 0 По колич - 1 Цикл
		
		//Строка = Отчет.ТаблицаВариантовСохраненныхНастроекОтчета.Получить(Индекс);
		Строка = ПолучитьСтрокуТаблицыВариантовСохрНастроекОтчета(Индекс);
		
		ДобавитьКнопкуВыбораВариантаСохраненнойНастройки(Индекс, Строка.Наименование, Строка.Описание);
		
	КонецЦикла;	
	
КонецПроцедуры

&НаСервере
Функция КоличествоСтрокТаблицыВариантовСохрНастроекОтчета()
	
	Док = РеквизитФормыВЗначение("Отчет");	
	возврат Док.ТаблицаВариантовСохраненныхНастроекОтчета.Количество();
	
КонецФункции

&НаСервере
Функция ПолучитьСтрокуТаблицыВариантовСохрНастроекОтчета(Индекс)
	
	Док = РеквизитФормыВЗначение("Отчет");	
	возврат Док.ТаблицаВариантовСохраненныхНастроекОтчета.Получить(Индекс);
	
КонецФункции

&НаСервере
Процедура ЗаполнитьТаблицуДоступныхВариантовСохраненныхНастроек1()
	
	Док = РеквизитФормыВЗначение("Отчет");
	Док.ЗаполнитьТаблицуДоступныхВариантовСохраненныхНастроек();
	
КонецПроцедуры

