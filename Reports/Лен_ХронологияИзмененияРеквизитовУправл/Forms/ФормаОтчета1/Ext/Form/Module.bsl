КонецПроцедуры

&НаКлиенте
Процедура ОтображениеПанелиВыбораВариантовСохраненныхНастроек(Кнопка)
	
	колич = КоличествоСтрокТаблицыВариантовСохрНастроекОтчета();
	СамаКнопка = Элементы.ОсновнаяКоманднаяПанель.ПодчиненныеЭлементы.ФормаОтображениеПанелиВыбораВариантовСохраненныхНастроек;
	//Если Кнопка.Пометка Тогда
	Если СамаКнопка.Пометка Тогда
		
		Если колич = 0 Тогда
			
			СамаКнопка.Доступность = Ложь;
			
		Иначе
			
			СамаКнопка.Доступность = Истина;			
			
		КонецЕсли;
			
		СамаКнопка.Пометка = Ложь;			
		//Элементы.ПанельВыбораВариантовСохраненныхНастроек.Свертка = РежимСверткиЭлементаУправления.Верх;	
		Элементы.ГруппаВарианта.Видимость = ложь;	
		
	Иначе		
		
		Если колич = 0 Тогда
			
			//Элементы.ПанельВыбораВариантовСохраненныхНастроек.Свертка = РежимСверткиЭлементаУправления.Верх;					
			Элементы.ГруппаВарианта.Видимость = ложь;	
			СамаКнопка.Доступность = Ложь;			
			СамаКнопка.Пометка = Ложь;
			
		Иначе
		
			//Элементы.ПанельВыбораВариантовСохраненныхНастроек.Свертка = РежимСверткиЭлементаУправления.Нет;					
			Элементы.ГруппаВарианта.Видимость = истина;	
			СамаКнопка.Доступность = Истина;						
			СамаКнопка.Пометка = Истина;
			
		КонецЕсли;
			
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ОтображенияПометкиВыбраннойСохраненнойНастройки(Элемент)
	
	Для Индекс = 0 По Отчет.ТаблицаВариантовСохраненныхНастроекОтчета.Количество() - 1 Цикл		
		
		Кнопка = Элементы["КнопкаВыбораВариантаНастройки" + Индекс];
			
		Если Кнопка <> Элемент Тогда			
			Кнопка.ЦветФона	= WebЦвета.Лазурный;						
		КонецЕсли;
		
	КонецЦикла;
	
	Элемент.ЦветФона = WebЦвета.Лимонный;	
	ЭтаФорма.ТекущийЭлемент = Элемент;
	
КонецПроцедуры

&НаКлиенте
Процедура РежимНастроекЭксперт(Кнопка)
		
	Кнопка.Пометка = Истина;
		
	Если Элементы.ОсновнаяКоманднаяПанель.ПодчиненныеЭлементы.ФормаОтображениеПанелиБыстрогоОтбора.Пометка Тогда
		ОтображениеПанелиБыстрогоОтбора(Элементы.ОсновнаяКоманднаяПанель.ПодчиненныеЭлементы.ФормаОтображениеПанелиБыстрогоОтбора);	
	КонецЕсли;	
	
	//ФормаНастроекЭксперт = ПолучитьФормуНастроек("ФормаНастройки",ЭтаФорма);
	//
	//ФормаНастроекЭксперт.ОткрытьМодально();
		
	Кнопка.Пометка = Ложь;	
	
	Если НЕ Элементы.ОсновнаяКоманднаяПанель.ПодчиненныеЭлементы.ФормаОтображениеПанелиБыстрогоОтбора.Пометка Тогда
		ОтображениеПанелиБыстрогоОтбора(Элементы.ОсновнаяКоманднаяПанель.ПодчиненныеЭлементы.ФормаОтображениеПанелиБыстрогоОтбора);	
	КонецЕсли;		
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ЗначениеВыбора, Источник)
	
	ВыбранныйВариантСохраненнойНастройки = Отчет.ТаблицаВариантовСохраненныхНастроекОтчета.Найти(ЗначениеВыбора,"Ссылка");
	
	Если ВыбранныйВариантСохраненнойНастройки <> Неопределено Тогда
		
		БазовыйМеханизмПодбораВариантовНастроек = Истина;
		
		Кнопка = Элементы["КнопкаВыбораВариантаНастройки" + Отчет.ТаблицаВариантовСохраненныхНастроекОтчета.Индекс(ВыбранныйВариантСохраненнойНастройки)];
		
		ОбработкаНажатияКнопкиВыбораВыриантаСохраненнойНастройки(Кнопка);
		
		БазовыйМеханизмПодбораВариантовНастроек = Ложь;			
		
	Иначе
		
		ОбновитьКнопкиВыбораВыриантовСохраненныхНастроек();		
		
	КонецЕсли;		
	
КонецПроцедуры

// почему-то этого события нету!!!
&НаКлиенте
Процедура ОтборПриПолученииДанных(Элемент, ОформленияСтрок)
	
	Если Не ЕстьРоль("ПолныеПрава") Тогда
			
		Для Каждого Значение Из ОформленияСтрок Цикл
			
			Если ТипЗнч(Значение.ДанныеСтроки) = Тип("ЭлементОтбораКомпоновкиДанных") Тогда
				
				Если Значение.ДанныеСтроки.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект") Тогда
					
					Значение.Ячейки.ВидыСравненияДляКраткогоОтображенияЭлемента.ТолькоПросмотр = Истина;								
					Значение.Ячейки.ВидыСравненияДляПодробногоОтображенияЭлементаГлавногоОтбора.ТолькоПросмотр = Истина;									
					Значение.Ячейки.ЛевоеЗначениеДляКраткогоОтображенияЭлемента.ТолькоПросмотр = Истина;								
					Значение.Ячейки.ЛевоеЗначениеДляПодробногоОтображенияЭлементаГлавногоОтбора.ТолькоПросмотр = Истина;						
					Значение.Ячейки.ПравоеЗначениеДляКраткогоОтображенияЭлемента.ТолькоПросмотр = Истина;								
					Значение.Ячейки.ПравоеЗначениеДляПодробногоОтображенияЭлементаГлавногоОтбора.ТолькоПросмотр = Истина;													
					Значение.Ячейки.ПредставлениеДляКраткогоОтображенияЭлемента.ТолькоПросмотр = Истина;								
					Значение.Ячейки.ПредставлениеДляПодробногоОтображенияЭлементаГлавногоОтбора.ТолькоПросмотр = Истина;					
					Значение.Ячейки.РежимОтображенияДляПодробногоОтображенияЭлементаГлавногоОтбора.ТолькоПросмотр = Истина;									
					Значение.Ячейки.Использование.ТолькоПросмотр = Истина;
					
				Иначе
					
					Значение.Ячейки.ЛевоеЗначениеДляКраткогоОтображенияЭлемента.ТолькоПросмотр = Истина;								
					Значение.Ячейки.ЛевоеЗначениеДляПодробногоОтображенияЭлементаГлавногоОтбора.ТолькоПросмотр = Истина;						
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ЕстьРоль(ИмяРоли, Пользователь = Неопределено) Экспорт

	Если Пользователь = Неопределено Тогда
		Пользователь = ПользователиКлиентСервер.ТекущийПользователь();
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	1 
		|ИЗ
		|	Справочник.ГруппыДоступа.Пользователи КАК ГруппыДоступаПользователи
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ПрофилиГруппДоступа.Роли КАК ПрофилиГруппДоступаРоли
		|		ПО ГруппыДоступаПользователи.Ссылка.Профиль = ПрофилиГруппДоступаРоли.Ссылка
		|ГДЕ
		|	ПрофилиГруппДоступаРоли.Роль.Имя = &Роль
		|	И ГруппыДоступаПользователи.Пользователь = &Пользователь";
	
	Запрос.УстановитьПараметр("Пользователь", Пользователь);
	Запрос.УстановитьПараметр("Роль", ИмяРоли);
	
	УстановитьПривилегированныйРежим(Истина);
	РезультатЗапроса = Запрос.Выполнить();
	УстановитьПривилегированныйРежим(Ложь);
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Ложь;		
	Иначе	
		Возврат Истина;		
	КонецЕсли;
	
КонецФункции


БазовыйМеханизмПодбораВариантовНастроек = Ложь;
