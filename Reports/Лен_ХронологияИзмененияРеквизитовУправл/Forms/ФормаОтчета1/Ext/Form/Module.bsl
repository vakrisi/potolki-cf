	СамаКнопка = Элементы.ОсновнаяКоманднаяПанель.ПодчиненныеЭлементы.ФормаОтображениеПанелиБыстрогоОтбора;
	Если СамаКнопка.Пометка Тогда
		
		СамаКнопка.Пометка = Ложь;
		
		//Элементы.Разделитель.Свертка 			= РежимСверткиЭлементаУправления.Лево;
		//Элементы.ПанельБыстрыхНастроек.Свертка  = РежимСверткиЭлементаУправления.Лево;
		Элементы.ПанельБыстрыхНастроек.Видимость = ложь;
		//Элементы.Результат.Свертка				= РежимСверткиЭлементаУправления.Лево;			
		
	Иначе
		
		СамаКнопка.Пометка = Истина;
		
		//Элементы.Разделитель.Свертка 		     = РежимСверткиЭлементаУправления.Нет;
		Элементы.ПанельБыстрыхНастроек.Видимость = истина;		
