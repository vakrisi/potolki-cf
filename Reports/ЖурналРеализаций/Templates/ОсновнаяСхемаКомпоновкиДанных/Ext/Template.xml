ВЫБРАТЬ
	ДанныеДокумента.Ссылка КАК Ссылка,
	//ДанныеДокумента.Дата КАК Дата,
	ДанныеДокумента.Основание КАК ОснованиеСсылка
ИЗ
	ВТ КАК ДанныеДокумента
{ГДЕ
	(ВЫБОР
			КОГДА НЕ &amp;НачалоПериода = ДАТАВРЕМЯ(1, 1, 1)
				ТОГДА ДанныеДокумента.Дата &gt;= &amp;НачалоПериода
			ИНАЧЕ ИСТИНА
		КОНЕЦ),
	(ВЫБОР
			КОГДА НЕ &amp;КонецПериода = ДАТАВРЕМЯ(1, 1, 1)
				ТОГДА ДанныеДокумента.Дата &lt;= КОНЕЦПЕРИОДА(&amp;КонецПериода, ДЕНЬ)
			ИНАЧЕ ИСТИНА
		КОНЕЦ),
	(ВЫБОР
			КОГДА &amp;ВидОснования = "Пустое"
				ТОГДА ДанныеДокумента.Основание ЕСТЬ NULL
						ИЛИ ДанныеДокумента.Основание.Ссылка ЕСТЬ NULL
			КОГДА &amp;ВидОснования = "ПоступлениеТоваровИУслуг"
				ТОГДА ДанныеДокумента.Основание ССЫЛКА Документ.ПоступлениеТоваровИУслуг
						И НЕ ДанныеДокумента.Основание.Ссылка ЕСТЬ NULL
			КОГДА &amp;ВидОснования = "ПеремещениеТоваров"
				ТОГДА ДанныеДокумента.Основание ССЫЛКА Документ.ПеремещениеТоваров
						И НЕ ДанныеДокумента.Основание.Ссылка ЕСТЬ NULL
			КОГДА &amp;ВидОснования = "ЗаказПокупателя"
				ТОГДА ДанныеДокумента.Основание ССЫЛКА Документ.ЗаказПокупателя
						И НЕ ДанныеДокумента.Основание.Ссылка ЕСТЬ NULL
			КОГДА &amp;ВидОснования = "ЗаказДоговор"
				ТОГДА ДанныеДокумента.Основание ССЫЛКА Документ.ЗаказДоговор
						И НЕ ДанныеДокумента.Основание.Ссылка ЕСТЬ NULL
			КОГДА &amp;ВидОснования = "ЗаказНаПроизводство"
				ТОГДА ДанныеДокумента.Основание ССЫЛКА Документ.ЗаказНаПроизводство
						И НЕ ДанныеДокумента.Основание.Ссылка ЕСТЬ NULL
			ИНАЧЕ ИСТИНА
		КОНЕЦ)}</query>
