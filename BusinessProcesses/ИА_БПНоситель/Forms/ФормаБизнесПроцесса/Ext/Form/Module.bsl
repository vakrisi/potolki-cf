&НаСервере
Процедура УстановитьДоступность()
    Если Объект.Стартован Тогда
    	Элементы.ГруппаБП.ТолькоПросмотр = Истина;
        Элементы.ГруппаБПГлавная.ТолькоПросмотр = Истина;
        ЭтаФорма.КоманднаяПанель.ПодчиненныеЭлементы.ФормаСтарт.Видимость = Ложь;
        ЭтаФорма.КоманднаяПанель.ПодчиненныеЭлементы.ФормаБПСтарт.Видимость = Ложь;
    КонецЕсли; 	
    
    Элементы.ВедущаяЗадача.Видимость = ЗначениеЗаполнено(Объект.ВедущаяЗадача);
КонецПроцедуры

&НаСервере
Процедура УстановитьНеизменяемыеПараметры()
    Настройки = ИА_БПС.ОбщиеНастройкиБП();
    
    Элементы.ФормаСформироватьПланВыполнения.Видимость = Настройки.ДлительностьЗадач;
КонецПроцедуры

 
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
    Если НЕ ИА_Защита_Общий.ЛицензияДоступна("НФ", Отказ) Тогда Возврат КонецЕсли; 
    
    УстановитьНеизменяемыеПараметры();
    
    ПутьКХранимымФайлам = ИА_БПС.Файлы_КаталогХранения();
    Если НЕ ЗначениеЗаполнено(ПутьКХранимымФайлам) Тогда
    	Элементы.страницаФайлы.Видимость = Ложь;        
        ИА_БФКС.СообщениеОбОшибке("В настройках программы не задан каталог хранения файлов, работа с файлами заблокирована!"); 
    Иначе
        ПутьКХранимымФайлам = ПутьКХранимымФайлам + ?(Прав(ПутьКХранимымФайлам, 1) = "\", "", "\") + "BP\";
    КонецЕсли; 
    
    
    
    ДеревоРеквизитов_ИзМД();
    УстановитьДоступность();
    ОбновитьКартуНаСервере();
    
    
    Настройки = ИА_БПС.ОбщиеНастройкиБП();
    Если НЕ Настройки.ДлительностьЗадач Тогда
    	Для каждого Эл Из Элементы Цикл
            Если  ИА_БФКС.РеквизитЕсть(Эл, "Имя")
                И ИА_БФКС.РеквизитЕсть(Эл, "Видимость")
                И Эл.Видимость
                И Найти(ВРЕГ(Эл.Имя), ВРЕГ("ИА_БППлановыеДатыВыполненияЗадач")) > 0
                Тогда
            	Эл.Видимость = Ложь;
            КонецЕсли; 
        КонецЦикла;  
    КонецЕсли; 
    
    Если НЕ Настройки.ЭтоАдмин Тогда
    	Элементы.ФормаЗавершитьНепосредственноБП.Видимость = Ложь;
    КонецЕсли; 
    
    Контекст = Новый Структура("Параметры, Объект, Форма", Параметры, Объект, ЭтаФорма);
    ИА_БПСПереопределяемый.Формы_БП_Форма_ПриСозданииНаСервере(Контекст);  
	
	Если не Объект.Ссылка.Пустая() ТОгда
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	ИА_ЗадачаПланаДействийФайлы.Дата КАК Дата,
		               |	ИА_ЗадачаПланаДействийФайлы.Имя КАК Имя,
		               |	ИА_ЗадачаПланаДействийФайлы.Ссылка.Номер КАК Номер
		               |ИЗ
		               |	Задача.ИА_ЗадачаПланаДействий.Файлы КАК ИА_ЗадачаПланаДействийФайлы
		               |ГДЕ
		               |	ИА_ЗадачаПланаДействийФайлы.Ссылка.БизнесПроцесс = &БизнесПроцесс";
		Запрос.УстановитьПараметр("БизнесПроцесс",Объект.Ссылка );
		УстановитьПривилегированныйРежим(истина);
		тзф = запрос.Выполнить().Выгрузить();
		УстановитьПривилегированныйРежим(ложь);
		ЗначениеВРеквизитФормы(тзф,"ФайлыЗадач");
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ОбновитьКартуНаСервере()
    Если Объект.Ссылка.Пустая() Тогда
        ТекущаяКарта = Справочники.ИА_БПКартыМаршрутов.ПолучитьКартуМаршрута(Объект.ИА_КартаМаршрутаБП);
    Иначе
        Обр = Обработки.ИА_БПМенеджер.Создать();
        Обр.Инициализировать(Объект.Ссылка);
        ТекущаяКарта = Обр.ПолучитьКартуМаршрута();
    КонецЕсли; 
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьКарту(Команда)
    ОбновитьКартуНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура РазрешитьРедактирование(Команда)
    Элементы.ГруппаБП.ТолькоПросмотр = Ложь;    
    Элементы.ГруппаБПГлавная.ТолькоПросмотр = Истина;
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
    ДеревоРеквизитов_ИзМД();
    УстановитьДоступность();
    ОбновитьКартуНаСервере();
КонецПроцедуры

&НаСервере
Функция СформироватьПланВыполненияНаСервере()
    Об = РеквизитФормыВЗначение("Объект");
    Результат = Об.СформироватьПланВыполнения();
    Возврат Результат.ПФ;
КонецФункции

&НаКлиенте
Процедура СформироватьПланВыполнения(Команда)
    ПФ = СформироватьПланВыполненияНаСервере();
    ПФ.ОтображатьСетку = Ложь;
    ПФ.ТолькоПросмотр = Истина;
    ПФ.Показать();
КонецПроцедуры

&НаКлиенте
Процедура ТекущаяКартаВыбор(Элемент)
	Если Элемент.ТекущийЭлемент <> Неопределено Тогда
		ИА_БПК.ПоказатьЗадачиПоТочке(Объект.Ссылка, Элемент.ТекущийЭлемент.Имя);
    КонецЕсли; 
КонецПроцедуры


&НаКлиенте
Процедура ЗаписатьИЗакрыть(Команда)
    ЭтаФорма.Записать();
    Закрыть();
КонецПроцедуры


&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	Если ИмяСобытия = "ОбновитьКарты" И
		(Параметр = Объект.Ссылка
		ИЛИ Параметр = Объект.ИА_КартаМаршрутаБП)
		Тогда
        ЭтаФорма.Прочитать();
        ДеревоРеквизитов_ИзМД();
		ОбновитьКартуНаСервере();
        РазвернутьДеревоРеквизитов();
	КонецЕсли; 
КонецПроцедуры


&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	ОбновитьКартуНаСервере();
КонецПроцедуры


&НаКлиенте
Процедура ИА_КартаМаршрутаБППриИзменении(Элемент)
    УстановитьДоступность();
    ЗаполнитьМЗ();
    ДеревоРеквизитов_ИзМД();
    РазвернутьДеревоРеквизитов();
КонецПроцедуры


&НаКлиенте
Процедура ИА_МаршрутЗадачБППриИзменении(Элемент)
    ВыбратьКМПоУмолчанию();
    ДеревоРеквизитов_ИзМД();
    РазвернутьДеревоРеквизитов();
КонецПроцедуры

&НаСервере
Процедура ВыбратьКМПоУмолчанию()
    Объект.ИА_КартаМаршрутаБП = Объект.ИА_МаршрутЗадачБП.ТекущаяКартаМаршрута;
    ОбновитьКартуНаСервере();
КонецПроцедуры
 
&НаСервере
Процедура ЗаполнитьМЗ()
    Объект.ИА_МаршрутЗадачБП = Объект.ИА_КартаМаршрутаБП.МаршрутЗадач;
    ОбновитьКартуНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
    РазвернутьДеревоРеквизитов();
КонецПроцедуры

&НаКлиенте
Процедура ДеревоРеквизитовПриАктивизацииЯчейки(Элемент)
    ТекСтрока = Элемент.ТекущиеДанные;
    Если ТекСтрока <> Неопределено Тогда
    	Элементы.ДеревоРеквизитов.ПодчиненныеЭлементы.ДеревоРеквизитовЗначение.ТолькоПросмотр = ТекСтрока.ЭтоГруппа;
    КонецЕсли; 
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
    Таб = ДеревоРеквизитов_ВМД();
    ТекущийОбъект.ИА_Реквизиты.Загрузить(Таб);
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
    РазвернутьДеревоРеквизитов();
КонецПроцедуры


&НаКлиенте
Процедура ИА_МаршрутЗадачБПНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
    М = Новый Массив;
    Если ЗначениеЗаполнено(Объект.ИА_Владелец) Тогда
        СЗ = СформироватьСписокНФ();	
        Если СЗ.Количество() > 0 Тогда
            М.Добавить(Новый ПараметрВыбора("Отбор.Ссылка", СЗ));
        КонецЕсли; 
    КонецЕсли; 
    Элемент.ПараметрыВыбора = Новый ФиксированныйМассив(М);
КонецПроцедуры

