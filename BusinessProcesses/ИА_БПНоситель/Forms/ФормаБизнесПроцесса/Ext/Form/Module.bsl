&НаСервере
Процедура ДеревоРеквизитов_ИзМД()
    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ
    |   ИА_БПРеквизиты.Ссылка КАК Реквизит,
    |   ИА_БПРеквизиты.ЗначениеПоУмолчанию,
    |   ИА_БПРеквизиты.Порядок
    |ПОМЕСТИТЬ ВсеРеквизиты
    |ИЗ
    |   ПланВидовХарактеристик.ИА_БПРеквизиты КАК ИА_БПРеквизиты
    |ГДЕ
    |   ИА_БПРеквизиты.ВладелецРеквизита = &ВладелецРеквизита
    |   И НЕ ИА_БПРеквизиты.ПометкаУдаления
    |   И НЕ ИА_БПРеквизиты.ЭтоГруппа
    |;
    |
    |////////////////////////////////////////////////////////////////////////////////
    |ВЫБРАТЬ
    |   ТЗ.Реквизит КАК Реквизит,
    |   ТЗ.Значение КАК Значение
    |ПОМЕСТИТЬ ТЗ
    |ИЗ
    |   &ТЗ КАК ТЗ
    |;
    |
    |////////////////////////////////////////////////////////////////////////////////
    |ВЫБРАТЬ
    |   ВсеРеквизиты.Реквизит КАК Реквизит,
    |   ЕСТЬNULL(ТЗ.Значение, ВсеРеквизиты.ЗначениеПоУмолчанию) КАК Значение,
    |   ЛОЖЬ КАК ЭтоГруппа,
    |   ВсеРеквизиты.ЗначениеПоУмолчанию,
    |   ВсеРеквизиты.Порядок КАК Порядок,
    |   ВсеРеквизиты.Реквизит.ТипЗначения КАК ТипЗначения
    |ИЗ
    |   ВсеРеквизиты КАК ВсеРеквизиты
    |       ЛЕВОЕ СОЕДИНЕНИЕ ТЗ КАК ТЗ
    |       ПО ВсеРеквизиты.Реквизит = ТЗ.Реквизит
    |
    |УПОРЯДОЧИТЬ ПО
    |   Порядок,
    |   Реквизит
    |ИТОГИ ПО
    |   Реквизит ТОЛЬКО ИЕРАРХИЯ
    |АВТОУПОРЯДОЧИВАНИЕ";
    
    Запрос.УстановитьПараметр("ВладелецРеквизита", Объект.ИА_МаршрутЗадачБП);
    Запрос.УстановитьПараметр("ТЗ", Объект.ИА_Реквизиты.Выгрузить());
    
    Результат = Запрос.Выполнить();
    
    Дерево = РеквизитФормыВЗначение("ДеревоРеквизитов");
    Дерево = Результат.Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкамСИерархией);
    ЗаполнитьДанныеВВетке(Дерево);
    
    Дерево.Строки.Сортировать("Порядок, Реквизит", Истина);
    
    ЗначениеВРеквизитФормы(Дерево, "ДеревоРеквизитов");
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДанныеВВетке(ВеткаДерева, КэшДанных = Неопределено)
    Если КэшДанных = Неопределено Тогда
    	Запрос = Новый Запрос("ВЫБРАТЬ * ИЗ ПланВидовХарактеристик.ИА_БПРеквизиты
        | КАК Т ГДЕ Т.ВладелецРеквизита = &ВладелецРеквизита");
        Запрос.УстановитьПараметр("ВладелецРеквизита", Объект.ИА_МаршрутЗадачБП);
        ТЗ = Запрос.Выполнить().Выгрузить();
        Для каждого СтрокаТЗ Из ТЗ Цикл
        	ИА_БФС.Кэш_Вставить(КэшДанных, Новый Структура("Ссылка", СтрокаТЗ.Ссылка), СтрокаТЗ);
        КонецЦикла; 
    КонецЕсли; 
    
    Для каждого ПодчВетка Из ВеткаДерева.Строки Цикл
        ЗначениеКэша = ИА_БФС.Кэш_Получить(КэшДанных, Новый Структура("Ссылка", ПодчВетка.Реквизит));
        
        Если НЕ ЗначениеЗаполнено(ПодчВетка.Реквизит) Тогда
        	ПодчВетка.ЭтоГруппа = Истина;
        КонецЕсли; 
        
        Если ЗначениеКэша <> Неопределено Тогда
            ПодчВетка.ЭтоГруппа = ЗначениеКэша.ЭтоГруппа;
            ПодчВетка.Порядок = ЗначениеКэша.Порядок;
            ПодчВетка.ТипЗначения = ЗначениеКэша.ТипЗначения;
            Если ЗначениеКэша.ТипЗначения <> NULL Тогда
                ПодчВетка.Значение = ЗначениеКэша.ТипЗначения.ПривестиЗначение(ПодчВетка.Значение);
            КонецЕсли; 
        КонецЕсли; 
        ЗаполнитьДанныеВВетке(ПодчВетка, КэшДанных);
    КонецЦикла; 
КонецПроцедуры
 

&НаСервере
Функция ДеревоРеквизитов_ВМД()
    Дерево = РеквизитФормыВЗначение("ДеревоРеквизитов");
    Таб = Объект.ИА_Реквизиты.Выгрузить(Новый Массив);
    СохранитьВеткуВМД(Дерево, Таб);
    Возврат Таб;
КонецФункции

&НаКлиенте
Процедура РазвернутьДеревоРеквизитов()
	Для каждого СтрокаД Из ДеревоРеквизитов.ПолучитьЭлементы() Цикл
    	ИД = СтрокаД.ПолучитьИдентификатор();
        Элементы.ДеревоРеквизитов.Развернуть(ИД,Истина);
    КонецЦикла; 
    
    Элементы.страницаРеквизиты.Видимость = ДеревоРеквизитов.ПолучитьЭлементы().Количество()  > 0;
КонецПроцедуры
 

&НаСервере
Процедура СохранитьВеткуВМД(Дерево, Таб)
    Для каждого ПодчВетка Из Дерево.Строки Цикл
        Если НЕ ПодчВетка.ЭтоГруппа и ЗначениеЗаполнено(ПодчВетка.Реквизит) Тогда
            ЗаполнитьЗначенияСвойств(Таб.Добавить(), ПодчВетка);	
        КонецЕсли; 
        СохранитьВеткуВМД(ПодчВетка, Таб)
    КонецЦикла; 
КонецПроцедуры
 

&НаСервере
Функция СформироватьСписокНФ()
    М = Справочники.ИА_БПМаршрутЗадач.ПолучитьСписокМаршрутовПоОбъекту(Объект.ИА_Владелец);
    Результат = ИА_БФКС.Массив2СписокЗначений(М);
	Возврат Результат;
КонецФункции
 

