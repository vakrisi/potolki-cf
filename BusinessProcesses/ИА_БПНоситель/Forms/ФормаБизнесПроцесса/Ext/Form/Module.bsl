&НаСервере
Процедура ПриЗаписиНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
    #ЕСЛИ НЕ( Клиент или Сервер или ВнешнееСоединение ) Тогда
        ТекущийОбъект = БизнесПроцессы.ИА_БПНоситель.СоздатьБизнесПроцесс();
    #КОНЕЦЕСЛИ
     
    Если ТаблицаФайлов.Количество() > 0 Тогда
    	// Надо сохранить файлы
        
        Для каждого Стр Из ТаблицаФайлов Цикл
            ИмяФайлаВХранилище = Файлы_ПолучитьИмяФайлаНаСервере(Стр.ИмяВнутр, ТекущийОбъект.Ссылка.УникальныйИдентификатор());
            ДД = ПолучитьИзВременногоХранилища(Стр.Хранилище);
        	ДД.Записать(ИмяФайлаВХранилище);
        КонецЦикла; 
        
        ТаблицаФайлов.Очистить();
    КонецЕсли; 
КонецПроцедуры


&НаКлиенте
Процедура ДеревоРеквизитовЗначениеПриИзменении(Элемент)
    Модифицированность = Истина;
КонецПроцедуры


&НаКлиенте
Процедура БПСтарт(Команда)
    Если Модифицированность
        ИЛИ Объект.Ссылка.Пустая()
        ИЛИ (Объект.ИА_Реквизиты.Количество() = 0 И ДеревоРеквизитов.ПолучитьЭлементы().Количество() > 0)
        Тогда
    	ЭтаФорма.Записать();
    КонецЕсли; 
    ЭтаФорма.Записать(Новый Структура("Старт", Истина) );
КонецПроцедуры


&НаСервере
Процедура ЗавершитьНепосредственноБПНаСервере()
    БизнесПроцессы.ИА_БПНоситель.ЗавершитьБП(Объект.Ссылка);
КонецПроцедуры


&НаКлиенте
Процедура ЗавершитьНепосредственноБП(Команда)
    Если Модифицированность ИЛИ Объект.Ссылка.Пустая() Тогда
        ЭтаФорма.Записать();
    КонецЕсли; 
    
    ПоказатьВопрос(
    Новый ОписаниеОповещения("ЗавершитьНепосредственноБПЗавершение", ЭтаФорма)
    , "Завершить непосредственно БП ?"
    , РежимДиалогаВопрос.ОКОтмена); 
КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьНепосредственноБПЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
    Если РезультатВопроса = КодВозвратаДиалога.ОК Тогда
        ЗавершитьНепосредственноБПНаСервере();
        ЭтаФорма.Прочитать();
        ОбновитьКартуНаСервере();
    КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ФайлыЗадачОткрыть(Команда)
	Если Элементы.ФайлыЗадач.ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	#Если ВебКлиент Тогда
		Оповещение = Новый ОписаниеОповещения("НачатьПодключениеРасширенияРаботыСФайламиЗавершение", ЭтаФорма,);
		НачатьПодключениеРасширенияРаботыСФайлами(Оповещение);
	#Иначе
		ОткрытьФайлЗавершение(Неопределено);
	#КонецЕсли
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФайлЗавершение(ДополнительныеПараметры) Экспорт
	тд = Элементы.ФайлыЗадач.ТекущиеДанные;
    имяФайла = тд.Имя;
	АдресВременногоХранилища = ПоместитьТекущийФайлВБуфер(имяФайла, тд.Номер);
	Если ЗначениеЗаполнено(АдресВременногоХранилища) Тогда
		врИмяФайла = КаталогВременныхФайлов() + имяФайла;
		#Если ВебКлиент Тогда
			ПолучитьФайл(АдресВременногоХранилища,врИмяФайла, истина);
		#Иначе
			ДвоичныеДанные = ПолучитьИзВременногоХранилища(АдресВременногоХранилища);
			ДвоичныеДанные.Записать(врИмяФайла);
			ЗапуститьПриложение(врИмяФайла);
		#КонецЕсли
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция ПоместитьТекущийФайлВБуфер(ВыбранноеИмя,НомерЗ)
	
	КаталогХранения	= ПолучитьПолноеИмяФайла(ВыбранноеИмя,НомерЗ); 
	ФайлДляПередачи = Новый ДвоичныеДанные(КаталогХранения);
	
	АдресВременногоХранилища = ПоместитьВоВременноеХранилище(ФайлДляПередачи, УникальныйИдентификатор);
	
	Возврат АдресВременногоХранилища;
	
КонецФункции

&НаСервере
Функция ПолучитьПолноеИмяФайла(ВыбранноеИмя,НомерЗ)
	
	КаталогХранения = Константы.ИА_КаталогХраненияФайлов.Получить();
	КаталогХранения = КаталогХранения + СОКРЛП(НомерЗ) + "\";
	
	КаталогХранения = КаталогХранения + ВыбранноеИмя;
	
	Возврат КаталогХранения;
	
КонецФункции


&НаКлиенте
Процедура ФайлыЗадачСохранить(Команда)
	Если Элементы.ФайлыЗадач.ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;  
	#Если ВебКлиент Тогда
	    Оповещение = Новый ОписаниеОповещения("НачатьПодключениеРасширенияРаботыСФайламиЗавершение", ЭтаФорма);
	    НачатьПодключениеРасширенияРаботыСФайлами(Оповещение);
	#Иначе
		СохранитьФайлЗавершение(Неопределено);
	#КонецЕсли
КонецПроцедуры

&НаКлиенте
Процедура СохранитьФайлЗавершение(ДополнительныеПараметры) Экспорт
	тд = Элементы.ФайлыЗадач.ТекущиеДанные;
	
    Режим = РежимДиалогаВыбораФайла.Сохранение;	
	ДиалогОткрытияФайла = Новый ДиалогВыбораФайла(Режим);
	ДиалогОткрытияФайла.ПолноеИмяФайла = Элементы.ФайлыЗадач.ТекущиеДанные.Имя;
	ДиалогОткрытияФайла.Заголовок = "Сохранение файла";
	Расширение = Сред(тд.Имя,Найти(тд.Имя, ".")+1);
	Фильтр = "(*."+ Расширение +")|*."+Расширение+"";
	ДиалогОткрытияФайла.Фильтр = Фильтр;
	ДиалогОткрытияФайла.Расширение = Расширение;	
	Если ДиалогОткрытияФайла.Выбрать() Тогда
		
		ВыбранныйКаталог = Новый Файл(ДиалогОткрытияФайла.Каталог);
		
		
		АдресВременногоХранилища = ПоместитьТекущийФайлВБуфер(тд.Имя, тд.Номер);
		ДвоичныеДанные = ПолучитьИзВременногоХранилища(АдресВременногоХранилища);
		
		Попытка
			ДвоичныеДанные.Записать(ДиалогОткрытияФайла.ПолноеИмяФайла);
		Исключение
			Сообщить(ОписаниеОшибки());
		КонецПопытки;
	КонецЕсли;
КонецПроцедуры


