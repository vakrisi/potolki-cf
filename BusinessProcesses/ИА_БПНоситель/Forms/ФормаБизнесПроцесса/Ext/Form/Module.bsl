// БЛОК Работа с файлами

&НаКлиенте
Процедура ФайлыОткрыть(Команда)
    ТекСтрока = Элементы.ИА_Файлы.ТекущиеДанные;
    Если ТекСтрока <> Неопределено Тогда
        Адрес = Файлы_ПолучитьФайлКакХранилище(ТекСтрока.ИмяВнутр);
        
        Если ЗначениеЗаполнено(Адрес) Тогда
            ДвоичныеДанные = ПолучитьИзВременногоХранилища(Адрес);
            ИмяФайла = КаталогВременныхФайлов() + ТекСтрока.ИмяФайла;
            ДвоичныеДанные.Записать(ИмяФайла);
            ЗапуститьПриложение(ИмяФайла);
        КонецЕсли;
    КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ИА_ФайлыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
    ФайлыОткрыть(Неопределено);
КонецПроцедуры

&НаКлиенте
Процедура ФайлыДобавить(Команда)
    АдресВременногоХранилища = "";
    ВыбранноеИмя = "";
    Если ПоместитьФайл(АдресВременногоХранилища, ВыбранноеИмя, ВыбранноеИмя
        , Истина, ЭтаФорма.УникальныйИдентификатор) Тогда
        Модифицированность = Истина;
        НовСтрока = ТаблицаФайлов.Добавить();
        НовСтрока.Хранилище = АдресВременногоХранилища;
        НовСтрока.ИмяФайла  = ИА_БФКС.Файл_Имя(ВыбранноеИмя);
        НовСтрока.ИмяВнутр  = ИА_БФКС.СформироватьУИД() + "." + ИА_БФКС.Файл_Расширение(ВыбранноеИмя);
        НовСтрока.Дата      = ИА_БФКС.Файл_ВремяИзменения(ВыбранноеИмя);
        
        НовСтрТЧ = Объект.ИА_Файлы.Добавить();
        ЗаполнитьЗначенияСвойств(НовСтрТЧ, НовСтрока);
    КонецЕсли;    
КонецПроцедуры


&НаСервере
Функция Файлы_ПолучитьФайлКакХранилище(ИмяВнутр)
    
    М = Объект.ИА_Файлы.НайтиСтроки(Новый Структура("ИмяВнутр", ИмяВнутр));
    Если М.Количество() <> 1 Тогда
    	ВызватьИсключение "Невозможно получить файл с ИмяВнутр=" + ИмяВнутр; 
    КонецЕсли; 
    
    Стр = М[0];
    
    М = ТаблицаФайлов.НайтиСтроки(Новый Структура("ИмяВнутр", ИмяВнутр));
    Если М.Количество() <> 0 Тогда
    	Адрес = М[0].Хранилище;
    Иначе
        ИмяФайлаНаСервере = Файлы_ПолучитьИмяФайлаНаСервере(ИмяВнутр);
        ДД = Новый ДвоичныеДанные(ИмяФайлаНаСервере);
        Адрес = ПоместитьВоВременноеХранилище(ДД, ЭтаФорма.УникальныйИдентификатор);
    КонецЕсли; 
    
    Возврат Адрес;
КонецФункции

&НаСервере
Функция Файлы_ПолучитьИмяФайлаНаСервере(ИмяВнутр, УИД = Неопределено)
    Если УИД = Неопределено Тогда
        Если Объект.Ссылка.Пустая() Тогда
            Возврат "";        
        КонецЕсли; 
    	УИД = Объект.Ссылка.УникальныйИдентификатор();
    КонецЕсли; 
    
    ПутьТекущий = ПутьКХранимымФайлам + УИД + "\";
    
    Если НЕ ИА_БФКС.Файл_Существует(ПутьТекущий) Тогда
        СоздатьКаталог(ПутьТекущий);
    КонецЕсли;
    Результат = ПутьТекущий + ИмяВнутр;
    Возврат Результат
КонецФункции
 
&НаКлиенте
Процедура ФайлыСохранить(Команда)
    ТекСтрока = Элементы.ИА_Файлы.ТекущиеДанные;
    Если ТекСтрока <> Неопределено Тогда
        Адрес = Файлы_ПолучитьФайлКакХранилище(ТекСтрока.ИмяВнутр);
        
        Если ЗначениеЗаполнено(Адрес) Тогда
            ИмяФайла = ТекСтрока.ИмяФайла;
            Расширение = ИА_БФКС.Файл_Расширение(ИмяФайла);
            Фильтр = "*" + Расширение + "|*" + Расширение + "|*.*|*.*";
            Если ИА_БФКС.Файл_ВыбратьФайл(ИмяФайла, РежимДиалогаВыбораФайла.Сохранение, Фильтр) Тогда
                ДвоичныеДанные = ПолучитьИзВременногоХранилища(Адрес);
                ДвоичныеДанные.Записать(ИмяФайла);
            КонецЕсли; 
        КонецЕсли;
    КонецЕсли;
КонецПроцедуры
 
