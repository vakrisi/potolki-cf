Функция ПолучитьРеквизиты(БП, СписокРеквизитов = Неопределено) Экспорт
	#ЕСЛИ НЕ( Клиент или Сервер или ВнешнееСоединение ) Тогда
        БП = БизнесПроцессы.ИА_БПНоситель.ПустаяСсылка();
    #КОНЕЦЕСЛИ
    
    Таб = Справочники.ИА_БПМаршрутЗадач.ПолучитьТаблицуДопРеквизитов(БП.ИА_МаршрутЗадачБП);
    Если СписокРеквизитов <> Неопределено Тогда
    	ИА_БФС.ТЗ_УдалитьСтрокиПоУсловию(Таб
        , "Контекст.Найти(СтрокаТЗ.Реквизит) = Неопределено"
        , СписокРеквизитов);
    КонецЕсли; 
    Таб.Колонки.Добавить("Значение", Метаданные.ПланыВидовХарактеристик.ИА_БПРеквизиты.Тип);
    Для каждого Стр Из БП.ИА_Реквизиты Цикл
    	НайдСтрока = Таб.Найти(Стр.Реквизит, "Реквизит");
        Если НайдСтрока <> Неопределено Тогда
        	НайдСтрока.Значение = Стр.Значение;
        КонецЕсли; 
    КонецЦикла;  
    
    Возврат Таб;
КонецФункции
 