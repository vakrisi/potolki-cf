Процедура ПроверитьПередСозданиемЗадач(ТочкаМаршрутаБизнесПроцесса, ФормируемыеЗадачи, СтандартнаяОбработка)
	
	Если Проверяющий.Пустая() Тогда
		Возврат;
	КонецЕсли;
	
	СтандартнаяОбработка = Ложь;
	
	НоваяЗадача = Задачи.Задачи.СоздатьЗадачу();
	НоваяЗадача.Заполнить(Неопределено);
	ЗаполнитьЗначенияСвойств(НоваяЗадача, ЭтотОбъект, "Автор, Важность, ПредметЗадачи");
	НоваяЗадача.Дата = ТекущаяДатаСеанса();
	НоваяЗадача.БизнесПроцесс = Ссылка;
	НоваяЗадача.ТочкаМаршрута = БизнесПроцессы.Задание.ТочкиМаршрута.Проверить;
		
	НоваяЗадача.Наименование = "Проверить: " + Заголовок;
	НоваяЗадача.УстановитьНовыйНомер(Строка(Ссылка.Номер));
	//НоваяЗадача.Исполнитель = Ссылка.Проверяющий;
	Если ТипЗнч(Проверяющий) = Тип("СправочникСсылка.РолиИсполнителей") Тогда
		НоваяЗадача.РольИсполнителя = Проверяющий;
	Иначе	
		НоваяЗадача.Исполнитель = Проверяющий;
	КонецЕсли;
	НоваяЗадача.СрокИсполнения = СрокПроверки;    // #13821
	//НоваяЗадача.ПодтвержденаПроверка = Истина;  // #13821 убрано
	НоваяЗадача.Записать();
	
	ФормируемыеЗадачи.Добавить(НоваяЗадача); 
	
	//запись в регистр напоминаний
	НаборДанных = РегистрыСведений.УведомленияОНовыхЗадачах.СоздатьНаборЗаписей();
	НаборДанных.Отбор.Задача.Установить(НоваяЗадача.Ссылка);
	НаборДанных.Прочитать();
	НаборДанных.Очистить();
	
	Движение = НаборДанных.Добавить();
	Движение.Период = ТекущаяДатаСеанса();
	Движение.Исполнитель = Ссылка.Проверяющий;
	Движение.Задача = НоваяЗадача.Ссылка;
	//Движение.Количество = 1;
	
	НаборДанных.Записать();

КонецПроцедуры

