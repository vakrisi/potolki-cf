//уменьшение суммы взаиморасчетов - увеличение дебиторской задолженности
Функция ВыполнитьРасход(Знач Документ, Знач Организация, Знач Контрагент, Знач Договор, Знач Сумма) Экспорт
	
	Результат = Истина;
	
	Попытка
		НаборЗаписей = РегистрыНакопления.ВзаиморасчетыСКонтрагентами.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Регистратор.Установить(Документ);
		НаборЗаписей.Прочитать();
		
		Расход = НаборЗаписей.Добавить();
		Расход.ВидДвижения = ВидДвиженияНакопления.Расход;
		Расход.Период = Документ.Дата;
		Расход.Контрагент = Контрагент;
		Расход.Договор = Договор;
		//Расход.Документ = Документ;
		Расход.Сумма = РаботаСВалютой.ПолучитьСуммуВВалютеУчетаПоДокументу(Документ, Сумма);
		Расход.Организация = Организация;
		
		НаборЗаписей.Записать();
	Исключение
		Результат = Ложь;
		Сообщить("Ошибка записи взаиморасчетов! " + ОписаниеОшибки(),СтатусСообщения.Важное);
	КонецПопытки;
	
	Возврат Результат;

	
КонецФункции

