Функция ЗаказОплаченПолностью(Заказ) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	РасчетыПоЗаказамОбороты.СуммаПриход КАК Заказано,
	|	РасчетыПоЗаказамОбороты.СуммаПриход - РасчетыПоЗаказамОбороты.СуммаРасход КАК КОплате,
	|	РасчетыПоЗаказамОбороты.Заказ КАК Заказ
	|ИЗ
	|	РегистрНакопления.РасчетыПоЗаказам.Обороты(, , Авто, Заказ = &Заказ) КАК РасчетыПоЗаказамОбороты";
	
	Запрос.УстановитьПараметр("Заказ", Заказ);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Если Выборка.Заказано > 0 И Выборка.КОплате <= 0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

Функция ПолучитьОстатокДолгаПоЗаказу(Заказ) Экспорт
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	РасчетыПоЗаказамОстатки.СуммаОстаток
	|ИЗ
	|	РегистрНакопления.РасчетыПоЗаказам.Остатки(, Заказ = &Заказ) КАК РасчетыПоЗаказамОстатки";
	Запрос.УстановитьПараметр("Заказ", Заказ);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.СуммаОстаток;
	КонецЕсли;
	
	Возврат 0;
		
КонецФункции
