	<restrictionTemplate>
		<name>ШаблонКонтрагенты</name>
		<condition>#Если &amp;ОграничиватьДоступККонтрагентамПоГруппамДоступа #Тогда
    ВЫБОР 
        КОГДА #ТекущаяТаблица.#Параметр(1) ССЫЛКА Справочник.Контрагенты
            И НЕ (#ТекущаяТаблица.#Параметр(1)).ЭтоГруппа 
            ТОГДА 
                (#ТекущаяТаблица.#Параметр(1)).ГруппаДоступа В
                    (ВЫБРАТЬ
                        ДоступныеГруппы.ГруппаКонтрагентов
                    ИЗ
                        Справочник.Пользователи.ДоступныеГруппыКонтрагентов КАК ДоступныеГруппы
                    ГДЕ
                        ДоступныеГруппы.Ссылка = &amp;Пользователь)
        ИНАЧЕ 
            ИСТИНА 
    КОНЕЦ   
#Иначе
    ИСТИНА
#КонецЕсли</condition>
	</restrictionTemplate>
	<restrictionTemplate>
		<name>ШаблонОрганизации</name>
