    #ТекущаяТаблица.#Параметр(1) В
            (ВЫБРАТЬ
                ДоступныеОрганизации.Организация
            ИЗ
                Справочник.Пользователи.ДоступныеОрганизации КАК ДоступныеОрганизации
            ГДЕ
                ДоступныеОрганизации.Ссылка = &amp;Пользователь
            )
#Иначе
    ИСТИНА  
#КонецЕсли</condition>
	</restrictionTemplate>
