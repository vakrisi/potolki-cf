                    ПО МоиПосты.Пост = КСУ_ИерархияПостов.Родитель
                ПО (МоиПосты.Пользователь = &amp;ТекущийПользователь)
                    И (ИА_ПланыДействий.Пост = КСУ_ИерархияПостов.Пост)) КАК Доступ
        ПО ТекущаяТаблица.Ссылка = Доступ.Ссылка
        ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИА_ПраваЗначения КАК ИА_ПраваЗначения
        ПО (&amp;ТекущийПользователь = ИА_ПраваЗначения.Пользователь)
