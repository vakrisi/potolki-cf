&наСервере
Процедура ПеренестиТоварВЗаказНаСервере()
	
	НоваяСтрока = Объект.Товары.Добавить();
	НоваяСтрока.Номенклатура = ВыбранныйТовар;
	НоваяСтрока.Характеристика = ВыбраннаяХарактеристика;
	НоваяСтрока.Количество = КоличествоТовара;
	НоваяСтрока.Цена = ЦенаТовара;
	НоваяСтрока.Сумма = НоваяСтрока.Количество * НоваяСтрока.Цена;
	НоваяСтрока.ЕдиницаИзмерения = НоваяСтрока.Номенклатура.БазоваяЕдиницаИзмерения;
	
КонецПроцедуры

&НаКлиенте
Процедура ПеренестиТоварВЗаказ(Команда)
	
	Если НЕ ВыбранныйТовар.Пустая() Тогда
		ПеренестиТоварВЗаказНаСервере();
	
		Состояние("Товар " + ВыбранныйТовар + " добавлен к заказу",);
		КоличествоТовара = 1;
		ВыбранныйТовар = "";
		Элементы.ПеренестиТоварВЗаказ.Доступность = Ложь;
	Иначе
		Состояние("Не выбран товар");
	КонецЕсли;
	
	ПоказатьСкрытьВкладки(3);
	
КонецПроцедуры

&НаКлиенте
Процедура УбратьТовар(Команда)
	
	ТекущиеДанные = Элементы.Товары.ТекущиеДанные;
	Если НЕ ТекущиеДанные = Неопределено Тогда
		Объект.Товары.Удалить(ТекущиеДанные);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОформитьЗаказ(Команда)
	Если ДокументЗаказ = Неопределено Тогда		
		Если Объект.Товары.Количество() > 0 Тогда
			ОписаниеОповещенияВопроса = Новый ОписаниеОповещения("ОбработкаВопросаОСозданииЗаказа", ЭтотОбъект);
			ПоказатьВопрос(ОписаниеОповещенияВопроса,"Оформить заказ?",РежимДиалогаВопрос.ДаНет);
		Иначе
			Состояние("Не выбран товар");
		КонецЕсли;
	Иначе 
		Если ДокументЗаказ.Пустая() Тогда
			Если Объект.Товары.Количество() > 0 Тогда
				ОписаниеОповещенияВопроса = Новый ОписаниеОповещения("ОбработкаВопросаОСозданииЗаказа", ЭтотОбъект);
				ПоказатьВопрос(ОписаниеОповещенияВопроса,"Оформить заказ?",РежимДиалогаВопрос.ДаНет);
			Иначе
				Состояние("Не выбран товар");
			КонецЕсли;
		Иначе	
			Состояние("Заказ уже оформлен");
		КонецЕсли;	
	КонецЕсли;
КонецПроцедуры

