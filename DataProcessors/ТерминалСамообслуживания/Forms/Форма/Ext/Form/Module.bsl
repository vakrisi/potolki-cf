	Отказ = Истина;	//выводит стандартное окно Продолжить или Завершить
	СтандартнаяОбработка = Ложь;		
	
	//Запомним текущую вкладку: кроме вкладки пин кода (вдруг ещё раз попытаются закрыть)
	Если Элементы.ГруппаСтраницыЭкрана.ТекущаяСтраница.Имя = "ГруппаСтраницаНачальная" Тогда
		мПоследняяВкладка = 1;
