&НаКлиенте
Перем мПоследняяВкладка;

//СЕРВИСНЫЕ ФУНКЦИИ
&НаСервере
Процедура УбратьПанелиИнтерфейсаНаСервере()
	
	НастройкиИнтерфейса = Новый НастройкиИнтерфейсаКлиентскогоПриложения;
	НастройкиСостава = НастройкиИнтерфейса.ПолучитьСостав();
	
	// Очистить настройки состава.
	НастройкиСостава.Верх.Очистить();
	НастройкиСостава.Лево.Очистить();
	НастройкиСостава.Низ.Очистить();
	НастройкиСостава.Право.Очистить();
	
	// Загрузить настройки состава в пустой объект настроек.
	НастройкиИнтерфейса.УстановитьСостав(НастройкиСостава);
	
	// Положить объект настроек текущему пользователю в хранилище.
	ХранилищеСистемныхНастроек.Сохранить("Общее/НастройкиИнтерфейсаКлиентскогоПриложения", , НастройкиИнтерфейса);
	
	
КонецПроцедуры

&НаСервере
Функция ПолучитьЦенуТовара(Знач Номенклатура, Знач Характеристика)
	
	РеквизитыПользователя = ОбщийМодульСервер.НастройкиПользователя("ВидЦен, КонтрагентТерминалаСамообслуживания");
	
	ВидЦен = РеквизитыПользователя.КонтрагентТерминалаСамообслуживания.ОсновнойДоговор.ВидЦен;
	Если ВидЦен.Пустая() Тогда
		ВидЦен = РеквизитыПользователя.ВидЦен;
	КонецЕсли;	
	Если ВидЦен.Пустая() Тогда
		ВидЦен = Справочники.ВидыЦен.ОсновнаяЦенаПродажи;
	КонецЕсли;
	Если Номенклатура = Неопределено Тогда
		Номенклатура = Справочники.Номенклатура.ПустаяСсылка();
	КонецЕсли;
	Если Характеристика = Неопределено Тогда
		Характеристика = Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка();
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЦеныНоменклатурыСрезПоследних.Цена
	|ИЗ
	|	РегистрСведений.ЦеныНоменклатуры.СрезПоследних(
	|			,
	|			ВидЦены = &ВидЦены
	|				И Номенклатура = &Номенклатура
	|				И ХарактеристикаНоменклатуры = &Характеристика
	|				И ЕдиницаИзмерения = &ЕдиницаИзмерения) КАК ЦеныНоменклатурыСрезПоследних";
	Запрос.УстановитьПараметр("ВидЦены",ВидЦен);
	Запрос.УстановитьПараметр("Номенклатура",Номенклатура);
	Запрос.УстановитьПараметр("Характеристика",Характеристика);
	Запрос.УстановитьПараметр("ЕдиницаИзмерения",Номенклатура.БазоваяЕдиницаИзмерения);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Возврат Выборка.Цена;
	КонецЦикла;
	
	Возврат 0;
	
КонецФункции

&НаСервере
Функция ЗаполнитьСписокХарактеристик(Номенклатура)
	
	СписокХарактеристики.Очистить();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Характеристики.Ссылка
	|ИЗ
	|	Справочник.ХарактеристикиНоменклатуры КАК Характеристики
	|ГДЕ
	|   НЕ Характеристики.ПометкаУдаления
	|   И Характеристики.Владелец = &Номенклатура
	|
	|УПОРЯДОЧИТЬ ПО
	|	Характеристики.Наименование";
	Запрос.УстановитьПараметр("Номенклатура",Номенклатура);	
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		СписокХарактеристики.Добавить(Выборка.Ссылка);
	КонецЦикла;
	
	Если СписокХарактеристики.Количество() = 0 Тогда
		Возврат Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка();
	Иначе
		Возврат СписокХарактеристики.Получить(0).Значение;
	КонецЕсли;	
	
КонецФункции
	
&НаСервере
Функция ПолучитьСписокТоваровДляСтраницы(Знач Родитель = Неопределено)
	
	Если Родитель = Неопределено Тогда
		Родитель = Справочники.Номенклатура.ПустаяСсылка();
	КонецЕсли;
	
	СписокРезультата = Новый СписокЗначений;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Номенклатура.Ссылка
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	Номенклатура.Родитель = &Родитель
	|	И Номенклатура.ПометкаУдаления = ЛОЖЬ
	|
	|УПОРЯДОЧИТЬ ПО
	|	Номенклатура.Наименование";
	Запрос.УстановитьПараметр("Родитель",Родитель);
	
	ВыборкаНоменклатура = Запрос.Выполнить().Выбрать();
	Пока ВыборкаНоменклатура.Следующий() Цикл
		СписокРезультата.Добавить(ВыборкаНоменклатура.Ссылка);
	КонецЦикла;
	
	Возврат СписокРезультата;
	
КонецФункции
	
&НаСервере
Процедура ОбновитьСписокТоваров(Знач НомерСтраницыТоваров = 1, Знач ВыбраннаяГруппа = Неопределено)
	
	КоличествоТоваровНаСтранице = 15; 
	
	Если ВыбраннаяГруппа = Неопределено Тогда
		ТекущаяГруппаТоваров = Константы.ТерминалСамообслуживанияГруппаНоменклатуры.Получить();
	КонецЕсли;
	Если ТекущаяГруппаТоваров.Пустая() Тогда
		ТекущаяГруппаТоваров = Константы.ТерминалСамообслуживанияГруппаНоменклатуры.Получить();
	КонецЕсли;
	
	СписокТоваров = ПолучитьСписокТоваровДляСтраницы(ТекущаяГруппаТоваров);
	НомерКнопки = 1;
	Для НомерТовара = (НомерСтраницыТоваров-1)*КоличествоТоваровНаСтранице По ((КоличествоТоваровНаСтранице*НомерСтраницыТоваров)-1) Цикл
