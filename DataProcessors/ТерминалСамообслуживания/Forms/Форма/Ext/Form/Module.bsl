			НоменклатураДляКнопки = СписокТоваров.Получить(НомерТовара).Значение;
			Элементы["КартинкаТовара"+(НомерКнопки)].Видимость = Истина;
			Элементы["КартинкаТовара"+(НомерКнопки)].Заголовок = НоменклатураДляКнопки;
			
			//++ №7722 комментируем, т.к. можно упросить и теперь для элемента номенклатуры, для хранения изображения используется отдельный справочник
			//Если НомерКнопки = 1 Тогда
			//	КартинкаТовара1 = ПолучитьНавигационнуюСсылку(НоменклатураДляКнопки,"Фото");
			//ИначеЕсли НомерКнопки = 2 Тогда
			//	КартинкаТовара2 = ПолучитьНавигационнуюСсылку(НоменклатураДляКнопки,"Фото");
			//ИначеЕсли НомерКнопки = 3 Тогда
			//	КартинкаТовара3 = ПолучитьНавигационнуюСсылку(НоменклатураДляКнопки,"Фото");
			//ИначеЕсли НомерКнопки = 4 Тогда
			//	КартинкаТовара4 = ПолучитьНавигационнуюСсылку(НоменклатураДляКнопки,"Фото");
			//ИначеЕсли НомерКнопки = 5 Тогда
			//	КартинкаТовара5 = ПолучитьНавигационнуюСсылку(НоменклатураДляКнопки,"Фото");
			//ИначеЕсли НомерКнопки = 6 Тогда
			//	КартинкаТовара6 = ПолучитьНавигационнуюСсылку(НоменклатураДляКнопки,"Фото");
			//ИначеЕсли НомерКнопки = 7 Тогда
			//	КартинкаТовара7 = ПолучитьНавигационнуюСсылку(НоменклатураДляКнопки,"Фото");
			//ИначеЕсли НомерКнопки = 8 Тогда
			//	КартинкаТовара8 = ПолучитьНавигационнуюСсылку(НоменклатураДляКнопки,"Фото");
			//ИначеЕсли НомерКнопки = 9 Тогда
			//	КартинкаТовара9 = ПолучитьНавигационнуюСсылку(НоменклатураДляКнопки,"Фото");
			//ИначеЕсли НомерКнопки = 10 Тогда
			//	КартинкаТовара10 = ПолучитьНавигационнуюСсылку(НоменклатураДляКнопки,"Фото");
			//ИначеЕсли НомерКнопки = 11 Тогда
			//	КартинкаТовара11 = ПолучитьНавигационнуюСсылку(НоменклатураДляКнопки,"Фото");
			//ИначеЕсли НомерКнопки = 12 Тогда
			//	КартинкаТовара12 = ПолучитьНавигационнуюСсылку(НоменклатураДляКнопки,"Фото");
			//ИначеЕсли НомерКнопки = 13 Тогда
			//	КартинкаТовара13 = ПолучитьНавигационнуюСсылку(НоменклатураДляКнопки,"Фото");
			//ИначеЕсли НомерКнопки = 14 Тогда
			//	КартинкаТовара14 = ПолучитьНавигационнуюСсылку(НоменклатураДляКнопки,"Фото");
			//ИначеЕсли НомерКнопки = 15 Тогда
			//	КартинкаТовара15 = ПолучитьНавигационнуюСсылку(НоменклатураДляКнопки,"Фото");
			//КонецЕсли;
			//-- №7722
			
			// №7722 фото в зависмости от признака ЭтоГруппа
			АдресКартинки = "";
			Если НоменклатураДляКнопки.ЭтоГруппа Тогда
				АдресКартинки = ПолучитьНавигационнуюСсылку(НоменклатураДляКнопки, "Фото");
			Иначе
				АдресКартинки = ПолучитьНавигационнуюСсылку(НоменклатураДляКнопки.ФайлКартинки, "ФайлХранилище");
			КонецЕсли;	
			ЭтаФорма["КартинкаТовара" + НомерКнопки] = АдресКартинки;
			
			Если НоменклатураДляКнопки.ЭтоГруппа Тогда
				Элементы["КартинкаТовара"+(НомерКнопки)].ШрифтЗаголовка = Новый Шрифт(Элементы["КартинкаТовара"+(НомерКнопки)].ШрифтЗаголовка,,,Истина);
				Если СтрДлина(Элементы["КартинкаТовара"+(НомерКнопки)].Заголовок) > 17 Тогда
					Элементы["КартинкаТовара"+(НомерКнопки)].Заголовок = Лев(Элементы["КартинкаТовара"+(НомерКнопки)].Заголовок,17)+"...";
				КонецЕсли;
				Элементы["КартинкаТовара"+(НомерКнопки)].РазмерКартинки = РазмерКартинки.Растянуть;
			Иначе
				Элементы["КартинкаТовара"+(НомерКнопки)].ШрифтЗаголовка = Новый Шрифт(Элементы["КартинкаТовара"+(НомерКнопки)].ШрифтЗаголовка,,,Ложь);
				Если СтрДлина(Элементы["КартинкаТовара"+(НомерКнопки)].Заголовок) > 20 Тогда
					Элементы["КартинкаТовара"+(НомерКнопки)].Заголовок = Лев(Элементы["КартинкаТовара"+(НомерКнопки)].Заголовок,17)+"...";
				КонецЕсли;
			КонецЕсли;
		Иначе
			Элементы["КартинкаТовара"+(НомерКнопки)].Видимость = Ложь;
		КонецЕсли;
		НомерКнопки = НомерКнопки + 1;
	КонецЦикла;
	
	Если ТекущаяГруппаТоваров.Пустая() Тогда
		Элементы.ПредыдущаяГруппаТоваров.Доступность = Ложь;
	Иначе
		Элементы.ПредыдущаяГруппаТоваров.Доступность = Истина;
	КонецЕсли;
	Если НомерСтраницыТоваров = 1 Тогда
		Элементы.ПредыдущаяСтраницаТоваров.Доступность = Ложь;
	Иначе
		Элементы.ПредыдущаяСтраницаТоваров.Доступность = Истина;
	КонецЕсли;
	Если ВыбранныйТовар.Пустая() Тогда
		Элементы.ПеренестиТоварВЗаказ.Доступность = Ложь;
	Иначе
		Элементы.ПеренестиТоварВЗаказ.Доступность = Истина;
	КонецЕсли;
	
	Элементы.ДекорацияКоличествоТоваровВКорзине.Заголовок = Объект.Товары.Итог("Количество");
	Элементы.ДекорацияСуммаТоваровВКорзине.Заголовок = Объект.Товары.Итог("Сумма");
	
КонецПроцедуры

&НаКлиенте
Процедура ВыбранТовар(Знач НомерТовара)
	
	ВыбраннаяНоменклатура = СписокТоваров.Получить((НомерСтраницыТоваров-1)*15+(НомерТовара-1)).Значение;
	Если ЭтоГруппаНоменклатуры(ВыбраннаяНоменклатура) Тогда
		ВыбранныйТовар = ПредопределенноеЗначение("Справочник.Номенклатура.ПустаяСсылка"); //Справочники.Номенклатура.ПустаяСсылка();
		Элементы.ДекорацияНадписьВыбранныйТовар.Заголовок = ВыбранныйТовар; //ВыбранныйТовар.Наименование;
		ТекущаяГруппаТоваров = ВыбраннаяНоменклатура;
		ОбновитьСписокТоваров(1, ТекущаяГруппаТоваров);
	Иначе
		ВыбранныйТовар = ВыбраннаяНоменклатура;
		ВыбраннаяХарактеристика = ЗаполнитьСписокХарактеристик(ВыбраннаяНоменклатура);
		ЦенаТовара = ПолучитьЦенуТовара(ВыбранныйТовар, ВыбраннаяХарактеристика);
		Элементы.ДекорацияНадписьВыбранныйТовар.Заголовок = ВыбранныйТовар; //ВыбранныйТовар.Наименование;
		Элементы.ГруппаХарактеристика.Видимость = (СписокХарактеристики.Количество() > 0);
		КоличествоТовара = 1;
		
		// №7722 фото по номенклатуре теперь в справочнике
		//ДанныеТовараФото = ПолучитьНавигационнуюСсылку(ВыбранныйТовар,"Фото");
		ДанныеТовараФото = ПолучитьНавигационнуюСсылку(ПолучитьСсылкуНаФайлКартинкиНаСервере(ВыбранныйТовар), "ФайлХранилище");
				
		ПоказатьСкрытьВкладки(5);
	КонецЕсли;
	
	Если ВыбранныйТовар.Пустая() Тогда
		Элементы.ПеренестиТоварВЗаказ.Доступность = Ложь;
	Иначе
		Элементы.ПеренестиТоварВЗаказ.Доступность = Истина;
	КонецЕсли;
	
КонецПроцедуры

