&НаСервере
Процедура СоздатьДокументЗаказПокупателя()
	
	//Начало изменен при переходе на 2.0
	//Если НЕ Константы.ТерминалСамообслуживанияЗаказНаПроизводство.Получить() Тогда
		НовыйДокумент = Документы.ЗаказПокупателя.СоздатьДокумент();
