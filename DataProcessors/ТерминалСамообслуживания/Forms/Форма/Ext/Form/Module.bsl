	//	НовыйДокумент = Документы.ЗаказНаПроизводство.СоздатьДокумент();
	//	НовыйДокумент.ВидЗаказа = Перечисления.ВидыЗаказовНаПроизводство.ЗаказНаПродажу;
	//	НовыйДокумент.ЗаказНаПродажу = Истина;
	//КонецЕсли;
	//Конец изменен при переходе на 2.0	
	
	//заполняем шапку документа
	НовыйДокумент.Дата = ТекущаяДатаСеанса();
	ОбщийМодуль.ЗаполнитьШапкуДокумента(НовыйДокумент);
	НовыйДокумент.Контрагент = ОбщийМодульСервер.НастройкаПользователя("КонтрагентТерминалаСамообслуживания");
	НовыйДокумент.ДоговорКонтрагента = НовыйДокумент.Контрагент.ОсновнойДоговор;
