&НаКлиенте
Процедура ПоказатьСкрытьВкладки(Знач НомерВкладки)
	
	Элементы.ГруппаСтраницаНачальная.Видимость = Ложь;
	Элементы.ГруппаСтраницаСоставЗаказа.Видимость = Ложь;
	Элементы.ГруппаСтраницаВыбораТовара.Видимость = Ложь;
	Элементы.ГруппаСтраницаПечатьЗаказа.Видимость = Ложь;
	Элементы.ГруппаИнформацияОТоваре.Видимость = Ложь;
	Элементы.ГруппаВводПинКода.Видимость = Ложь;	
	
	Если НомерВкладки = 1 Тогда
		Элементы.ГруппаСтраницыЭкрана.ТекущаяСтраница = Элементы.ГруппаСтраницаНачальная;
		Элементы.ГруппаСтраницаНачальная.Видимость = Истина;
	ИначеЕсли НомерВкладки = 2 Тогда
		Элементы.ГруппаСтраницыЭкрана.ТекущаяСтраница = Элементы.ГруппаСтраницаСоставЗаказа;
		Элементы.ГруппаСтраницаСоставЗаказа.Видимость = Истина;
	ИначеЕсли НомерВкладки = 3 Тогда
		Элементы.ГруппаСтраницыЭкрана.ТекущаяСтраница = Элементы.ГруппаСтраницаВыбораТовара;
		Элементы.ГруппаСтраницаВыбораТовара.Видимость = Истина;
	ИначеЕсли НомерВкладки = 4 Тогда
		Элементы.ГруппаСтраницыЭкрана.ТекущаяСтраница = Элементы.ГруппаСтраницаПечатьЗаказа;
		Элементы.ГруппаСтраницаПечатьЗаказа.Видимость = Истина;
	ИначеЕсли НомерВкладки = 5 Тогда
		Элементы.ГруппаСтраницыЭкрана.ТекущаяСтраница = Элементы.ГруппаИнформацияОТоваре;
		Элементы.ГруппаИнформацияОТоваре.Видимость = Истина;
	ИначеЕсли НомерВкладки = 6 Тогда
		Элементы.ГруппаСтраницыЭкрана.ТекущаяСтраница = Элементы.ГруппаВводПинКода;
		Элементы.ГруппаВводПинКода.Видимость = Истина;
	КонецЕсли;
	
	Элементы.ДекорацияКоличествоТоваровВКорзине.Заголовок = Объект.Товары.Итог("Количество");
	Элементы.ДекорацияСуммаТоваровВКорзине.Заголовок = Объект.Товары.Итог("Сумма");
	
КонецПроцедуры

