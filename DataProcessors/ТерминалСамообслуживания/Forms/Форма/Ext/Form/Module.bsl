	//КонецЕсли;
	//Конец исключен при переходе на 2.0

	//заполняем табличную часть "Товары"
	Для Каждого ТекущаяСтрока Из Объект.Товары Цикл
		НоваяСтрока = НовыйДокумент.Товары.Добавить();
		НоваяСтрока.Номенклатура = ТекущаяСтрока.Номенклатура;
		НоваяСтрока.ХарактеристикаНоменклатуры = ТекущаяСтрока.Характеристика;
		НоваяСтрока.ЕдиницаИзмерения = ТекущаяСтрока.ЕдиницаИзмерения;		
		НоваяСтрока.Коэффициент = 1;
		НоваяСтрока.Количество = ТекущаяСтрока.Количество;
		НоваяСтрока.Цена = ТекущаяСтрока.Цена;
		НоваяСтрока.Сумма = НоваяСтрока.Количество * НоваяСтрока.Цена;
	КонецЦикла;
	
	НовыйДокумент.СуммаДокумента = НовыйДокумент.Товары.Итог("Сумма");
	
	Попытка
		НовыйДокумент.Записать(РежимЗаписиДокумента.Проведение);
		НомерСозданногоЗаказа = НовыйДокумент.Номер;
		Элементы.НомерСозданногоЗаказа.Видимость = Истина;
		Элементы.ДобавитьТовар.Доступность = Ложь;
		Элементы.УбратьТовар.Доступность = Ложь;
		ДокументЗаказ = НовыйДокумент.Ссылка;
	Исключение
		
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Процедура РаспечататьЗаказ()
	Если ДокументЗаказ <> Неопределено Тогда
		Если ЗначениеЗаполнено(ДокументЗаказ) Тогда				
			Если ТипЗНЧ(ДокументЗаказ) = Тип("ДокументСсылка.ЗаказПокупателя") Тогда
				//Печать заказа покупателя				
				ТабличныйДокументЗаказ = ВернутьТабличныйДокументЗаказаПокупателя(ДокументЗаказ);
			Иначе
				//Печать заказа на производство				
				ТабличныйДокументЗаказ = ВернутьТабличныйДокументЗаказаНаПроизводство(ДокументЗаказ);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;	
КонецПроцедуры

&НаСервере
Функция ВернутьТабличныйДокументЗаказаНаПроизводство(Документ)
	Возврат Документы.ЗаказНаПроизводство.СформироватьПечатнуюФормуЗаказаНаПроизводство(Документ.Ссылка)
КонецФункции

&НаСервере
Функция ВернутьТабличныйДокументЗаказаПокупателя(Документ)
	Массив = новый Массив;
	Массив.Добавить(Документ.Ссылка);
	Возврат Документы.ЗаказПокупателя.ПечатьЗаказПокупателя(Массив, Неопределено);
КонецФункции	

