&НаСервере
Процедура ЗаполнитьЗначенияПоУмолчанию()
	
	РеквизитыПользователя = ОбщийМодульСервер.НастройкиПользователя("ОрганизацияРозницы, СкладРозница");

	Объект.Склад = РеквизитыПользователя.СкладРозница;
	Объект.Организация = РеквизитыПользователя.ОрганизацияРозницы;
