&НаСервере
Процедура УдалитьОбъектКонфигурации(ФайлОписания, МассивВыражениеКоманды, УровеньРодителя=1)
	
	МассивВыражений = Новый Массив;
	Если ТипЗнч(МассивВыражениеКоманды) = Тип("Строка") Тогда
		МассивВыражений.Добавить(МассивВыражениеКоманды);
	Иначе
	    МассивВыражений = МассивВыражениеКоманды;
	КонецЕсли;
	
	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.ОткрытьФайл(ФайлОписания);
	
	ПостроительDOM = Новый ПостроительDOM;
	ДокументDOM    = ПостроительDOM.Прочитать(ЧтениеXML);
	ЧтениеXML.Закрыть();
	
	Разыменователь = Новый РазыменовательПространствИменDOM(ДокументDOM);
	
	Для каждого ВыражениеКоманды из МассивВыражений Цикл
		РезультатXPath        = ДокументDOM.ВычислитьВыражениеXPath(ВыражениеКоманды, ДокументDOM, Разыменователь);
		
		УзелКоманды = РезультатXPath.ПолучитьСледующий();
		
		Если НЕ УзелКоманды = Неопределено Тогда
			
			Если УровеньРодителя = 1 Тогда
				УзелРодителя = УзелКоманды.РодительскийУзел;
				УзелРодителя.УдалитьДочерний(УзелКоманды);
				
			ИначеЕсли УровеньРодителя = 2 Тогда
				УзелРодителя = УзелКоманды.РодительскийУзел.РодительскийУзел;
				УзелКоманды = УзелКоманды.РодительскийУзел;
				
				УзелРодителя.УдалитьДочерний(УзелКоманды);
				
			ИначеЕсли УровеньРодителя = 3 Тогда
				УзелРодителя = УзелКоманды.РодительскийУзел.РодительскийУзел.РодительскийУзел;
				УзелКоманды = УзелКоманды.РодительскийУзел.РодительскийУзел;
				
				УзелРодителя.УдалитьДочерний(УзелКоманды);
				
			КонецЕсли;
			
		КонецЕсли;
	КонецЦикла;

	ЗаписьXML = Новый ЗаписьXML;
	ЗаписьXML.ОткрытьФайл(ФайлОписания);
	
	ЗаписьDOM = Новый ЗаписьDOM;
	ЗаписьDOM.Записать(ДокументDOM, ЗаписьXML);
	
	ЗаписьXML.Закрыть();
	
КонецПроцедуры

