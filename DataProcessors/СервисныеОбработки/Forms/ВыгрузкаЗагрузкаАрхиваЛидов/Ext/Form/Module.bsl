&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЭтоЗагрузка = Параметры.Свойство("Загрузка");
	
	Если ЭтоЗагрузка Тогда
		Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.СтраницаЗагрузки;
	Иначе
		Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.СтраницаВыгрузки;		
		
		// загружаем статусы
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	СтатусыЛида.Ссылка КАК ПредставлениеСтатуса
		|ИЗ
		|	Справочник.СтатусыЛида КАК СтатусыЛида
		|ГДЕ
		|	НЕ СтатусыЛида.ПометкаУдаления
		|	И НЕ СтатусыЛида.Ссылка = ЗНАЧЕНИЕ(Справочник.СтатусыЛида.ЗаполнитьДанныеЗамера)
		|
		|УПОРЯДОЧИТЬ ПО
		|	СтатусыЛида.РеквизитДопУпорядочивания";
		
		Статусы.ЗагрузитьЗначения(Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("ПредставлениеСтатуса"));	
		Статусы.ЗаполнитьПометки(Истина);
	КонецЕсли;
	
	Формат = 0;

КонецПроцедуры

&НаКлиенте
Процедура ПутьКФайлуНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	Режим = ?(ЭтоЗагрузка, РежимДиалогаВыбораФайла.Открытие, РежимДиалогаВыбораФайла.Сохранение);
	ДиалогОткрытияФайла = Новый ДиалогВыбораФайла(Режим);
	ДиалогОткрытияФайла.ПолноеИмяФайла = "leads_SmartCeilings_" + Формат(ТекущаяДата(), "ДФ=yyyy-MM-dd") + ?(НЕ Формат = 0, ".xml", ".txt");
	ДиалогОткрытияФайла.МножественныйВыбор = Ложь;
	ДиалогОткрытияФайла.Заголовок = "Введите название файла";
	
	Фильтр =  ?(Формат = 0, "Файл txt|*.txt", "Файл xml|*.xml");
	ДиалогОткрытияФайла.Фильтр = Фильтр;
	
	ДиалогОткрытияФайла.Показать(Новый ОписаниеОповещения("ПослеВыбораФайла", ЭтотОбъект));
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораФайла(ВыбранныеФайлы, Параметры) Экспорт
	
	Если ТипЗнч(ВыбранныеФайлы) = Тип("Массив") И ВыбранныеФайлы.Количество() > 0  Тогда
		ПутьКФайлу = ВыбранныеФайлы[0];
	КонецЕсли;
	
КонецПроцедуры

