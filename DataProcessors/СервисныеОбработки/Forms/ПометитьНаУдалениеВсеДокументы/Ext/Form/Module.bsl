		Запрос.УстановитьПараметр("Организация", ИзмеренияДокумента.Организация);
		Запрос.УстановитьПараметр("Валюта", 	 ИзмеренияДокумента.Валюта);
		Запрос.УстановитьПараметр("Склад", 		 ИзмеренияДокумента.Склад);		
		
		Выборка = Запрос.Выполнить().Выбрать();
		ЭтоНовый = Ложь;
		
		Если Выборка.Следующий() Тогда
			
			ДокументОбъект = Выборка.Ссылка.ПолучитьОбъект();
			
		Иначе
			
			ЭтоНовый = Истина;
			ДокументОбъект = Документы.ВводОстатков.СоздатьДокумент();
			ДокументОбъект.Заполнить(Неопределено);
			ДокументОбъект.Дата = КонецДня(Дата);
			
		КонецЕсли;
		
		ДокументОбъект.Комментарий = "#Загружен обработкой ""Очистка базы""#";
		ЗаполнитьЗначенияСвойств(ДокументОбъект, ИзмеренияДокумента);
		
		ДокументОбъект[ИзмеренияДокумента.ТипОстатков].Очистить();
		
		СтруктураОтбора = Новый Структура(ПоляИзмерений);
		ЗаполнитьЗначенияСвойств(СтруктураОтбора, ИзмеренияДокумента);
		НайденныеСтроки = ТаблицаДанных.НайтиСтроки(СтруктураОтбора);
		
		// №13930 для операций "Товары на складах" и "Материалы в эксплуатации" добавлена колонка "Цена"
		ПересчитыватьЦену = (ДокументОбъект.ТипОперации = Перечисления.ТипыОперацийВводаОстатков.ТоварыНаСкладах
				Или ДокументОбъект.ТипОперации = Перечисления.ТипыОперацийВводаОстатков.МатериалыВЭксплуатации);
		
		Для каждого ТекущаяСтрока из НайденныеСтроки Цикл
			
			НоваяСтрока = ДокументОбъект[ИзмеренияДокумента.ТипОстатков].Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущаяСтрока);
			
			//++ №13930
			Если ПересчитыватьЦену Тогда
				НоваяСтрока.Цена = ?(НоваяСтрока.Количество = 0, НоваяСтрока.Сумма, НоваяСтрока.Сумма / НоваяСтрока.Количество);
			КонецЕсли;
			//-- №13930
			
		КонецЦикла;
		
		Попытка
			ДокументОбъект.Записать();
		Исключение
			Сообщить("Не удалось " + ?(ЭтоНовый, "создать", "обновить") + " документ по виду операции " + ТипОперации + ": " + ОписаниеОшибки());
			Продолжить;
		КонецПопытки;
		
		Попытка
			ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
		Исключение
			Сообщить("Не удалось провести документ " + ДокументОбъект.Ссылка + ": " + ОписаниеОшибки());
		КонецПопытки;
	КонецЦикла;
	
	
	Попытка
		УдалитьФайлы(ПутьКФайлу);
	Исключение
		//ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Ошибка удаления временного файла  "+ ПутьКФайлу);
	КонецПопытки;
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура НайтиСсылку(СтруктураСтроки, СтрокаXML, ИмяСвойства, СоответствиеПолей, СвойстваОписаниеТипов)
	
	// ИмяСвойства, как приходит в XML - ИД_Номенклатура
	// ИмяРеквизита, поле в 1С - Номенклатура
	
	Значение = СтрокаXML[ИмяСвойства];
	
	// Преобразуем имя свойства к полю в 1С
	ИмяРеквизита = Сред(ИмяСвойства, 4);
	
	// Чтобы определить тип справочника для поиска элемента, используем два варианта:
	// 1. Для этого поля явно передали тип в структуре XML, т.к. он составной
	// 2. Для него задано соответствие в "СоответствиеПолей"
	
	// Пример: поле Контрагент - справочник Контрагенты
	Если СвойстваОписаниеТипов.Найти("ТипСправочника_" + ИмяРеквизита) = Неопределено Тогда
		ИмяСправочника = СоответствиеПолей.Получить(ИмяРеквизита);
	Иначе
		ИмяСправочника = СтрокаXML["ТипСправочника_" + ИмяРеквизита];
	КонецЕсли;
	
	// Если ГУИД пустой не ищем
	Если Значение = "00000000-0000-0000-0000-000000000000" Тогда
		Возврат;
	КонецЕсли;
	
	// Пытаемся найти по ГУИД, если не находим сообщаяем, если обязательное, то пропускаем эту строку
	НайденнаяСсылка = Справочники[ИмяСправочника].ПолучитьСсылку(новый УникальныйИдентификатор(Значение));
	Если НайденнаяСсылка.ПолучитьОбъект() = Неопределено Тогда
		
		Сообщить(СтрШаблон("Не найден элемент справочника ""%1"", с идентификатором: %2", ИмяСправочника, Значение));
		Возврат;
		
	КонецЕсли;
	
	// Формируем найденный элемент в структуру
	СтруктураСтроки.Вставить(ИмяРеквизита, НайденнаяСсылка);
	
КонецПроцедуры


