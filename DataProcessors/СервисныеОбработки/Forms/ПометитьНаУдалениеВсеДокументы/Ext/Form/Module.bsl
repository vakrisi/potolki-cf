		//КонецПопытки;
		
	КонецЦикла;
	
	ПоляИзмерений = "ТипОстатков, ТипОперации, Организация, Валюта, Склад";
	ТаблицаИзмерений = ТаблицаДанных.Скопировать(, ПоляИзмерений);
	ТаблицаИзмерений.Свернуть(ПоляИзмерений);
	Для каждого ИзмеренияДокумента из ТаблицаИзмерений Цикл
		
		Запрос = новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВводОстатков.Ссылка
		|ИЗ
		|	Документ.ВводОстатков КАК ВводОстатков
