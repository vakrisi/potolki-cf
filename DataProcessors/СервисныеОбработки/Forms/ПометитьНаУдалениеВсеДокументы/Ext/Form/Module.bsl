			Если Лев(НРег(ТекущееСвойство.Имя), 3) = "ид_" Тогда
				
				СсылочныеСвойства.Добавить(ТекущееСвойство.Имя);
				
			КонецЕсли;
			
			Если Лев(НРег(ТекущееСвойство.Имя), 15) = "типсправочника_" Тогда
				
				СвойстваОписаниеТипов.Добавить(ТекущееСвойство.Имя);
				
			КонецЕсли;
			
		КонецЦикла;
		
		ТипОперации = Перечисления.ТипыОперацийВводаОстатков[ТипОстатков.Имя];
 
		//Запрос = новый Запрос;
		//Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		//|	ВводОстатков.Ссылка
		//|ИЗ
		//|	Документ.ВводОстатков КАК ВводОстатков
		//|ГДЕ
		//|	ВводОстатков.Дата = &Дата
		//|	И ВводОстатков.ТипОперации = &ТипОперации
		//|";
		//Запрос.УстановитьПараметр("Дата", КонецДня(Дата));
		//Запрос.УстановитьПараметр("ТипОперации", ТипОперации);
		//
		//Выборка = Запрос.Выполнить().Выбрать();
		//ЭтоНовый = Ложь;
		//
		//Если Выборка.Следующий() Тогда
		//	
		//	ДокументОбъект = Выборка.Ссылка.ПолучитьОбъект();
		//	
		//Иначе
		//	
		//	ЭтоНовый = Истина;
		//	ДокументОбъект = Документы.ВводОстатков.СоздатьДокумент();
		//	ДокументОбъект.Заполнить(Неопределено);
		//	ДокументОбъект.Дата = КонецДня(Дата);
		//	
		//КонецЕсли;
		//
		//ДокументОбъект.Комментарий = "#Загружен обработкой ""Очистка базы""#";
		//ДокументОбъект.ТипОперации = ТипОперации;
		
		//ДокументОбъект[ТипОстатков.Имя].Очистить();
		
		Для Каждого ТекущаяСтрока Из ОстаткиXDTO[ТипОстатков.Имя] Цикл
			
			СтруктураСтроки = новый Структура;
			
			Для Каждого СсылочноеСвойство Из СсылочныеСвойства Цикл
				НайтиСсылку(СтруктураСтроки, ТекущаяСтрока, СсылочноеСвойство, СоответствиеПолей, СвойстваОписаниеТипов);
			КонецЦикла;
			
			//НоваяСтрока = ДокументОбъект[ТипОстатков.Имя].Добавить();
			//ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущаяСтрока);
			//ЗаполнитьЗначенияСвойств(НоваяСтрока, СтруктураСтроки);
			
			НоваяСтрокаДанных = ТаблицаДанных.Добавить();
			НоваяСтрокаДанных.ТипОперации = ТипОперации;
			НоваяСтрокаДанных.ТипОстатков = ТипОстатков.Имя;
			ЗаполнитьЗначенияСвойств(НоваяСтрокаДанных, ТекущаяСтрока);
