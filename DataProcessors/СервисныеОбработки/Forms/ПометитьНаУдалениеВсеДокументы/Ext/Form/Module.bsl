		|	ВводОстатков.Дата = &Дата
		|	И ВводОстатков.ТипОперации = &ТипОперации
		|	И ВводОстатков.Организация = &Организация
		|	И ВводОстатков.Валюта = &Валюта
		|	И ВводОстатков.Склад = &Склад
