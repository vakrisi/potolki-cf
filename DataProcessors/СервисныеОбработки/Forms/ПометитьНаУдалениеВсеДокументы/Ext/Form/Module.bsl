&НаКлиенте
Процедура ЗагрузитьОстатки(Команда)
	
	ДиалогВыбора = новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	ДиалогВыбора.Заголовок = "Выберите файл XML с ранее выгруженными остатками.";
	ДиалогВыбора.МножественныйВыбор = Ложь;
	ДиалогВыбора.Фильтр = "Файл xml|*.xml"; //#13511
	ДиалогВыбора.Показать(новый ОписаниеОповещения("ПослеВыбораФайлаОстатков", ЭтотОбъект));
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораФайлаОстатков(ВыбранныйФайл, ДопПараметры) Экспорт
	
	Если Не ТипЗнч(ВыбранныйФайл) = Тип("Массив") Тогда
		Возврат;
	КонецЕсли;
	
	Если ВыбранныйФайл.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ОписаниеОповещения = новый ОписаниеОповещения("ПослеВводаДатыПриЗагрузкеОстатков", ЭтотОбъект, новый Структура("ПутьКФайлу", ВыбранныйФайл[0]));
	ПоказатьВводДаты(ОписаниеОповещения, ТекущаяДата(), "Введите дату, на которую будут созданы документы ввода остатков (на конец дня).", ЧастиДаты.Дата);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВводаДатыПриЗагрузкеОстатков(Дата, ДопПараметры) Экспорт
	
	Если Дата = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	// #15138 файл - на клиенте
	//ЗагрузитьОстаткиНаСервере(Дата, ДопПараметры.ПутьКФайлу);	
	//ПоказатьОповещениеПользователя("Загрузка остатков завершена.");
	ДополнительныеПараметры = Новый Структура("Дата", Дата);
	ОписаниеОповещения = Новый ОписаниеОповещения("ЗагрузитьОстаткиЗавершение", ЭтотОбъект, ДополнительныеПараметры);
    НачатьПомещениеФайла(ОписаниеОповещения, , ДопПараметры.ПутьКФайлу, Ложь, УникальныйИдентификатор);
		
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьОстаткиЗавершение(Знач Успешно, Адрес, Знач ВыбранноеИмяФайла, Знач ДополнительныеПараметры) Экспорт
	
	Если Не Успешно Тогда
		Возврат;
	КонецЕсли;

	ЗагрузитьОстаткиНаСервере(ДополнительныеПараметры.Дата, Адрес);	
	ПоказатьОповещениеПользователя("Загрузка остатков завершена.");
	
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьОстаткиНаСервере(Дата, АдресВХранилище) //ПутьКФайлу)
	
	ПутьКФайлу = ПолучитьИмяВременногоФайла(".xml");
	ДвоичныеДанныеФайла = ПолучитьИзВременногоХранилища(АдресВХранилище);
	ДвоичныеДанныеФайла.Записать(ПутьКФайлу);
	
	Если Дата = Дата(1,1,1) Тогда
		Дата = ТекущаяДатаСеанса();
	КонецЕсли;
	
	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.ОткрытьФайл(ПутьКФайлу);
	
	ОстаткиXDTO = ФабрикаXDTO.ПрочитатьXML(ЧтениеXML, ФабрикаXDTO.Тип("ОстаткиПоРегистрам", "ОстаткиПоРегистрам"));
	
	// Соответствие названия полей и типов справочников для поиска
	СоответствиеПолей = новый Соответствие;
	СоответствиеПолей.Вставить("Номенклатура", 		"Номенклатура");
	СоответствиеПолей.Вставить("Организация", 		"Организации");
	СоответствиеПолей.Вставить("Склад", 			"Склады");
	СоответствиеПолей.Вставить("ХарактеристикаНоменклатуры", "ХарактеристикиНоменклатуры");
	СоответствиеПолей.Вставить("СерияНоменклатуры", "СерииНоменклатуры");
	СоответствиеПолей.Вставить("ЕдиницаИзмерения", 	"КлассификаторЕдиницИзмерения");
	СоответствиеПолей.Вставить("Контрагент", 		"Контрагенты");
	СоответствиеПолей.Вставить("ДисконтнаяКарта", 	"ДисконтныеКарты");
	СоответствиеПолей.Вставить("Договор", 			"ДоговорыКонтрагентов");
	СоответствиеПолей.Вставить("Валюта", 			"Валюты");
	СоответствиеПолей.Вставить("Сотрудник", 		"Сотрудники");
	СоответствиеПолей.Вставить("Ответственный", 	"Сотрудники");
	СоответствиеПолей.Вставить("СчетКасса", 		"Кассы");
	
	//++ #13511 данные считываем в таблицу, затем сворачиваем и создаем документы
	ТаблицаДанных = Новый ТаблицаЗначений;
	ТаблицаДанных.Колонки.Добавить("ТипОстатков", Новый ОписаниеТипов("Строка", , , , Новый КвалификаторыСтроки(50)));
	ТаблицаДанных.Колонки.Добавить("ТипОперации", Новый ОписаниеТипов("ПеречислениеСсылка.ТипыОперацийВводаОстатков"));
	ТаблицаДанных.Колонки.Добавить("Организация", Новый ОписаниеТипов("СправочникСсылка.Организации"));
	ТаблицаДанных.Колонки.Добавить("Валюта", Новый ОписаниеТипов("СправочникСсылка.Валюты"));
	ТаблицаДанных.Колонки.Добавить("Склад", Новый ОписаниеТипов("СправочникСсылка.Склады"));
	
	ТаблицаДанных.Колонки.Добавить("Сотрудник", Новый ОписаниеТипов("СправочникСсылка.Сотрудники"));
	ТаблицаДанных.Колонки.Добавить("Контрагент", Новый ОписаниеТипов("СправочникСсылка.Контрагенты"));
	ТаблицаДанных.Колонки.Добавить("ДисконтнаяКарта", Новый ОписаниеТипов("СправочникСсылка.ДисконтныеКарты"));
	ТаблицаДанных.Колонки.Добавить("Договор", Новый ОписаниеТипов("СправочникСсылка.ДоговорыКонтрагентов"));
	ТаблицаДанных.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ТаблицаДанных.Колонки.Добавить("ХарактеристикаНоменклатуры", Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры"));
	ТаблицаДанных.Колонки.Добавить("СерияНоменклатуры", Новый ОписаниеТипов("СправочникСсылка.СерииНоменклатуры"));
	ТаблицаДанных.Колонки.Добавить("ЕдиницаИзмерения", Новый ОписаниеТипов("СправочникСсылка.КлассификаторЕдиницИзмерения"));
	
	//СправочникСсылка.ПроизводственныеБригады, СправочникСсылка.Сотрудники, СправочникСсылка.Бригады, СправочникСсылка.Контрагенты
	МассивТиповОтветственный = Новый Массив;
	МассивТиповОтветственный.Добавить(Тип("СправочникСсылка.ПроизводственныеБригады"));
	МассивТиповОтветственный.Добавить(Тип("СправочникСсылка.Сотрудники"));
	МассивТиповОтветственный.Добавить(Тип("СправочникСсылка.Бригады"));
	МассивТиповОтветственный.Добавить(Тип("СправочникСсылка.Контрагенты"));
	ТаблицаДанных.Колонки.Добавить("Ответственный", Новый ОписаниеТипов(МассивТиповОтветственный));
	
	МассивТиповСчетКасса = Новый Массив;
	МассивТиповСчетКасса.Добавить(Тип("СправочникСсылка.БанковскиеСчета"));
	МассивТиповСчетКасса.Добавить(Тип("СправочникСсылка.Кассы"));
	ТаблицаДанных.Колонки.Добавить("СчетКасса", Новый ОписаниеТипов(МассивТиповСчетКасса));
	
	ТаблицаДанных.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число", , , Новый КвалификаторыЧисла(15, 2)));
	ТаблицаДанных.Колонки.Добавить("Сумма", Новый ОписаниеТипов("Число", , , Новый КвалификаторыЧисла(15, 2)));
	ТаблицаДанных.Колонки.Добавить("Коэффициент", Новый ОписаниеТипов("Число", , , Новый КвалификаторыЧисла(10, 4)));
	//-- #13511

	Для Каждого ТипОстатков Из ОстаткиXDTO.Свойства() Цикл
		
