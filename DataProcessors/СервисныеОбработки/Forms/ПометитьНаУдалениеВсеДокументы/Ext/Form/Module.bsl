&НаКлиенте
перем ИдентификаторЗадания Экспорт;

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	НеУдалятьДокументыУстановкиЦен = Истина;
	НеУдалятьДокументыУстановкиСтоимостиВыработки = Истина; // №13931
	
	//++ #14380 от 11.08.2022
	ИмяМетода = Метаданные.РегламентныеЗадания.ОчисткаБазы.ИмяМетода;
	СписокФоновыхЗаданий = ФоновыеЗадания.ПолучитьФоновыеЗадания();
	Для каждого элемент Из СписокФоновыхЗаданий Цикл
		Если элемент.ИмяМетода = ИмяМетода И элемент.Состояние=СостояниеФоновогоЗадания.Активно Тогда
			ИдентификаторФоновогоЗадания = элемент.УникальныйИдентификатор;
		КонецЕсли; 
	КонецЦикла; 
	//-- #14380 от 11.08.2022
	
		
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	Если ИдентификаторФоновогоЗадания <>  Новый УникальныйИдентификатор("00000000-0000-0000-0000-000000000000") Тогда
		СтатусФоновогоЗадания = ПолучитьДанныеНаСервере();
		Если СтатусФоновогоЗадания.Активность Тогда
			ПодключитьОбработчикОжидания("ПроверитьВыполнениеЗадания", 2, Ложь);
			Элементы.ПометитьВсеНаУдаление.Видимость = Ложь;
	   		Элементы.УдалитьНепосредственно.Видимость = Ложь;
			Если СтатусФоновогоЗадания.Режим = "пометка" Тогда
			    Элементы.ОстановитьПометитьВсеНаУдаление.Видимость = Истина;
			Иначе
				Элементы.ОстановитьУдалитьНепосредственно.Видимость = Истина;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ЗапуститьФоновоеЗадание(УдалятьНепосредственно)
	ИмяМетода = Метаданные.РегламентныеЗадания.ОчисткаБазы.ИмяМетода;
	ПараметрыФоновогоЗадания = Новый Массив;
	ПараметрыФоновогоЗадания.Добавить(НеУдалятьДокументыУстановкиЦен);
	ПараметрыФоновогоЗадания.Добавить(НеУдалятьДокументыУстановкиСтоимостиВыработки);
	ПараметрыФоновогоЗадания.Добавить(УдалятьНепосредственно);
	Ключ = ?( УдалятьНепосредственно, "удаление", "пометка");
	Фон = ФоновыеЗадания.Выполнить(ИмяМетода, ПараметрыФоновогоЗадания , Ключ, "Обработка документов на удаление");
	ИдентификаторФоновогоЗадания = Фон.УникальныйИдентификатор;
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьВыполнениеЗадания()
	СтатусФоновогоЗадания = ПолучитьДанныеНаСервере();
	Если СтатусФоновогоЗадания.Прогресс >= 0 Тогда // Если есть сообщение от фонового задания
		Если СтатусФоновогоЗадания.Активность Тогда
			ЭтаФорма.Элементы.ТекущийПроцесс.Заголовок = СтатусФоновогоЗадания.ТекущийПроцесс;
			ИндикаторСостоянияФоновогоЗадания=СтатусФоновогоЗадания.Прогресс;
			ЭтаФорма.Элементы.ПрогрессБар.Видимость = Истина;
			ЭтаФорма.Элементы.ТекущийПроцесс.Видимость = Истина;
		Иначе	
			Если СтатусФоновогоЗадания.ТекущийПроцесс <> "" Тогда
			    ЭтаФорма.Элементы.ТекущийПроцесс.Заголовок = СтатусФоновогоЗадания.ТекущийПроцесс;
			КонецЕсли;
			ИндикаторСостоянияФоновогоЗадания=СтатусФоновогоЗадания.Прогресс;
			ОтключитьОбработчикОжидания("ПроверитьВыполнениеЗадания");
			Элементы.ОстановитьПометитьВсеНаУдаление.Видимость = Ложь;
			Элементы.ОстановитьУдалитьНепосредственно.Видимость = Ложь;
			Элементы.ПометитьВсеНаУдаление.Видимость = Истина;
			Элементы.УдалитьНепосредственно.Видимость = Истина;
			ИдентификаторФоновогоЗадания =  Новый УникальныйИдентификатор("00000000-0000-0000-0000-000000000000");
		КонецЕсли; 
	КонецЕсли; 
КонецПроцедуры 

&НаСервере
Функция ПолучитьДанныеНаСервере()
	Статус = Новый Структура;
	Статус.Вставить("Активность", Истина);
	Статус.Вставить("Прогресс", -1); // -1 для определения что новых сообщений нет
	Статус.Вставить("ТекущийПроцесс", "");
	Статус.Вставить("Режим", "");
	Задание = ФоновыеЗадания.НайтиПоУникальномуИдентификатору(ИдентификаторФоновогоЗадания); 
	Статус.Режим = Задание.Ключ;
	СообщенияПользователю=Задание.ПолучитьСообщенияПользователю(Истина);
	Если Задание.Состояние = СостояниеФоновогоЗадания.Активно Тогда
		Если СообщенияПользователю.ВГраница() > 0  Тогда 
			ПоследнееСообщение = СообщенияПользователю[СообщенияПользователю.ВГраница()].Текст;
			Индекс = СтрНайти(ПоследнееСообщение, "|");
			Если Индекс > 0 Тогда  
				Статус.ТекущийПроцесс=Лев(ПоследнееСообщение, Индекс-1);
				Статус.Прогресс = Число(Сред(ПоследнееСообщение, Индекс+1, 3));
				Статус.Активность=Истина;
			Иначе
				Сообщить(ПоследнееСообщение);
			КонецЕсли;
		КонецЕсли; 
	Иначе
		Статус.Прогресс = 100;
		Статус.Активность=Ложь;
	КонецЕсли;
	Возврат Статус;
КонецФункции
	


&НаКлиенте
Процедура ПометитьВсеНаУдаление(Команда)
	ФормаВвода = ПолучитьФорму("Обработка.СервисныеОбработки.Форма.ФормаВводаПароля" ,  , ЭтотОбъект);
    ФормаВвода.РежимОткрытияОкна = РежимОткрытияОкнаФормы.БлокироватьОкноВладельца;
	ГСЧ = Новый ГенераторСлучайныхЧисел();
	СлучайныйПароль = ГСЧ.СлучайноеЧисло(1000, 9999);
	ФормаВвода.Текст="Для исключения случайного запуска, при нажатии на кнопку ""Пометить все на удаление"" будет запрошен ""Пароль""." + Символы.ПС + Символы.ПС + "Введите: " + Строка(Формат(СлучайныйПароль,"ЧЦ=5; ЧГ=0"));
    
    Оповещение = Новый ОписаниеОповещения("ПослеВВодаПароля", ЭтотОбъект, ФормаВвода);
    ФормаВвода.ОписаниеОповещенияОЗакрытии = Оповещение;
    ФормаВвода.Открыть();
КонецПроцедуры

&НаКлиенте
Процедура ПослеВВодаПароля(Число, Параметры) Экспорт
    Если НЕ Параметры.Пароль = Неопределено Тогда
		Если Параметры.Пароль = СлучайныйПароль Тогда
			//++ #14380 от 11.08.2022
			ЗапуститьФоновоеЗадание(Ложь);
	        ПодключитьОбработчикОжидания("ПроверитьВыполнениеЗадания", 1, Ложь);
			Элементы.ПометитьВсеНаУдаление.Видимость = Ложь;
			Элементы.УдалитьНепосредственно.Видимость = Ложь;
			Элементы.ОстановитьПометитьВсеНаУдаление.Видимость = Истина;
			//-- #14380 от 11.08.2022
		КонецЕсли;
    КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура УдалитьНепосредственно(Команда)
	ФормаВвода = ПолучитьФорму("Обработка.СервисныеОбработки.Форма.ФормаВводаПароля" ,  , ЭтотОбъект);
    ФормаВвода.РежимОткрытияОкна = РежимОткрытияОкнаФормы.БлокироватьОкноВладельца;
	ГСЧ = Новый ГенераторСлучайныхЧисел();
	СлучайныйПароль = ГСЧ.СлучайноеЧисло(1000, 9999);
	ФормаВвода.Текст="Для исключения случайного запуска, при нажатии на кнопку ""Удалить непосредственно"" будет запрошен ""Пароль""." + Символы.ПС + Символы.ПС + "Введите: " + Строка(Формат(СлучайныйПароль,"ЧЦ=5; ЧГ=0"));
    Оповещение = Новый ОписаниеОповещения("ПослеВВодаПароляПриНепосредственномУдалении", ЭтотОбъект, ФормаВвода);
    ФормаВвода.ОписаниеОповещенияОЗакрытии = Оповещение;
    ФормаВвода.Открыть();
КонецПроцедуры

&НаКлиенте
Процедура ПослеВВодаПароляПриНепосредственномУдалении(Число, ДопПараметры) Экспорт
	Если НЕ ДопПараметры.Пароль = Неопределено И ДопПараметры.Пароль = СлучайныйПароль Тогда
		ОписаниеОповещения = Новый ОписаниеОповещения("ПослеОкончательногоВопросаПриНепосредственномУдалении", ЭтаФорма);
		ТекстВопроса = "Вы действительно хотите произвести полное непосредственное удаление данных?
		|Операция необратима, все документы, задачи и бизнесс-процессы исчезнут полностью, без возможности восстановления!";
		ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПослеОкончательногоВопросаПриНепосредственномУдалении(Ответ, ДопПараметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Да Тогда
		
		ЗапуститьФоновоеЗадание(Истина);
        ПодключитьОбработчикОжидания("ПроверитьВыполнениеЗадания", 1, Ложь);
		Элементы.ПометитьВсеНаУдаление.Видимость = Ложь;
		Элементы.УдалитьНепосредственно.Видимость = Ложь;
		Элементы.ОстановитьУдалитьНепосредственно.Видимость = Истина;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьОстатки(Команда)
	
	ДиалогВыбора = новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.ВыборКаталога);
	ДиалогВыбора.Заголовок = "Выберите каталог, для сохранения XML файла с остатками.";
	ДиалогВыбора.МножественныйВыбор = Ложь;
	ДиалогВыбора.Показать(новый ОписаниеОповещения("ПослеУказанияКаталогаПриВыгрузкеОстатков", ЭтотОбъект));
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеУказанияКаталогаПриВыгрузкеОстатков(ВыбранныйКаталог, ДопПараметры) Экспорт
	
	Если Не ТипЗнч(ВыбранныйКаталог) = Тип("Массив") Тогда
		Возврат;
	КонецЕсли;
	
	Если ВыбранныйКаталог.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ОписаниеОповещения = новый ОписаниеОповещения("ПослеВводаДатыПриВыгрузкеОстатков", ЭтотОбъект, новый Структура("Каталог", ВыбранныйКаталог[0]));
	ПоказатьВводДаты(ОписаниеОповещения, ТекущаяДата(), "Введите дату, на которую будут выгружены остатки (на конец дня).", ЧастиДаты.Дата);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВводаДатыПриВыгрузкеОстатков(Дата, ДопПараметры) Экспорт
	
	Если Дата = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИмяФайла = СтрШаблон("%1.xml", Формат(ТекущаяДата(), "ДФ=yyyy-MM-dd_HH-mm"));
	ПолноеИмяФайла = СтрШаблон("%1\%2", ДопПараметры.Каталог, ИмяФайла);
	
	АдресФайлаВоВременномХранилище = "";	
	ВыгрузитьОстаткиНаСервере(Дата, АдресФайлаВоВременномХранилище); //ДопПараметры.Каталог); 	
	
	// #15138 файл нужен на клиенте
	ДополнительныеПараметры = Новый Структура("ИмяФайла", ИмяФайла);
	ОписаниеОповещения = Новый ОписаниеОповещения("ВыгрузитьОстаткиЗавершение", ЭтотОбъект, ДополнительныеПараметры);
	ПолучаемыеФайлы = Новый Массив;
    ПолучаемыеФайлы.Добавить(Новый ОписаниеПередаваемогоФайла(ПолноеИмяФайла, АдресФайлаВоВременномХранилище));
	НачатьПолучениеФайлов(ОписаниеОповещения, ПолучаемыеФайлы, , Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьОстаткиЗавершение(ПолученныеФайлы, ДополнительныеПараметры) Экспорт
		   
	ПоказатьОповещениеПользователя("Выгрузка остатков завершена.", , СтрШаблон("Создан файл %1", ДополнительныеПараметры.ИмяФайла));
	
КонецПроцедуры

&НаСервере
Функция ВыгрузитьОстаткиНаСервере(Дата, АдресФайлаВоВременномХранилище)
	
	Если Дата = Дата(1,1,1) Тогда
		Дата = ТекущаяДатаСеанса();
	КонецЕсли;
	
	ИмяВременногоФайла = ПолучитьИмяВременногоФайла("xml");
	
	ЗаписьXML = новый ЗаписьXML;
	ЗаписьXML.ОткрытьФайл(ИмяВременногоФайла, "UTF-8"); //СтрШаблон("%1\%2.xml", ВыбранныйКаталог, Формат(ТекущаяДатаСеанса(), "ДФ=yyyy-MM-dd_HH-mm")), "UTF-8");
	
	ЗаписьXML.ЗаписатьОбъявлениеXML();
	
	ОстаткиXDTO = ФабрикаXDTO.Создать("ОстаткиПоРегистрам", "ОстаткиПоРегистрам");
	
	МассивЗапросов = новый Массив;
	
	ДобавитьТекстЗапроса(МассивЗапросов, "ТоварыНаСкладах", ТекстЗапросаТоварыНаСкладах());
	ДобавитьТекстЗапроса(МассивЗапросов, "БонусыКонтрагентов", ТекстЗапросаБонусыКонтрагентов());
	ДобавитьТекстЗапроса(МассивЗапросов, "ВзаиморасчетыСКонтрагентами", ТекстЗапросаВзаиморасчетыСКонтрагентами());
	//ДобавитьТекстЗапроса(МассивЗапросов, "ВзаиморасчетыСКонтрагентамиВВалюте", ТекстЗапросаВзаиморасчетыСКонтрагентамиВВалюте()); //#13511 убрано
	ДобавитьТекстЗапроса(МассивЗапросов, "РасчетыСПерсоналом", ТекстЗапросаРасчетыСПерсоналом());
	ДобавитьТекстЗапроса(МассивЗапросов, "РасчетыСПодотчетниками", ТекстЗапросаРасчетыСПодотчетниками());
	ДобавитьТекстЗапроса(МассивЗапросов, "МатериалыВЭксплуатации", ТекстЗапросаМатериалыВЭксплуатации());
	ДобавитьТекстЗапроса(МассивЗапросов, "ДенежныеСредства", ТекстЗапросаДенежныеСредства());
	
	Для Каждого ТекущийЗапрос Из МассивЗапросов Цикл
	
		Запрос = Новый Запрос;
		Запрос.Текст = ТекущийЗапрос.ТекстЗапроса;
		Запрос.УстановитьПараметр("Дата", КонецДня(Дата));
		
		ТаблицаОстатков = Запрос.Выполнить().Выгрузить();
		
		КолонкиСсылки = новый Массив;
		КолонкиОпределениеТипа = новый Массив;
		
		Для Каждого Колонка Из ТаблицаОстатков.Колонки Цикл
			
			Если Лев(НРег(Колонка.Имя), 7) = "ссылка_" Тогда
				КолонкиСсылки.Добавить(Колонка.Имя);
			КонецЕсли;
			
			Если Лев(НРег(Колонка.Имя), 15) = "типсправочника_" Тогда
				КолонкиОпределениеТипа.Добавить(Колонка.Имя);
			КонецЕсли;
			
		КонецЦикла;
		
		Для Каждого ТекущаяСтрока Из ТаблицаОстатков Цикл
			
			Остаток_Тип = ОстаткиXDTO.Свойства().Получить(ТекущийЗапрос.ИмяОстатков).Тип;
			Остаток_XDTO = ФабрикаXDTO.Создать(Остаток_Тип);
			
			ЗаполнитьЗначенияСвойств(Остаток_XDTO, ТекущаяСтрока);
			
			Для Каждого ИмяКолонки Из КолонкиСсылки Цикл
				
				Если ТекущаяСтрока[ИмяКолонки] = Неопределено Тогда
					Продолжить;
				КонецЕсли;
				
				Остаток_XDTO["ИД_" + Сред(ИмяКолонки, 8)] = Строка(ТекущаяСтрока[ИмяКолонки].УникальныйИдентификатор());
				
			КонецЦикла;
			
			ОстаткиXDTO[ТекущийЗапрос.ИмяОстатков].Добавить(Остаток_XDTO);
			
		КонецЦикла;
		
	КонецЦикла;
	
	ФабрикаXDTO.ЗаписатьXML(ЗаписьXML, ОстаткиXDTO, "ОстаткиПоРегистрам");
	ЗаписьXML.Закрыть();
	
	// #15138 для передачи на клиент
	Файл = Новый Файл(ИмяВременногоФайла);		
	Если Файл.Существует() Тогда			
		ДвоичныеДанные = Новый ДвоичныеДанные(ИмяВременногоФайла);
		АдресФайлаВоВременномХранилище = ПоместитьВоВременноеХранилище(ДвоичныеДанные, УникальныйИдентификатор);
		УдалитьФайлы(ИмяВременногоФайла);			
	КонецЕсли;
	
КонецФункции

&НаСервереБезКонтекста
Процедура ДобавитьТекстЗапроса(МассивЗапросов, ИмяОстатков, ТекстЗапроса)
	
	МассивЗапросов.Добавить(новый Структура("ИмяОстатков, ТекстЗапроса", ИмяОстатков, ТекстЗапроса));
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ТекстЗапросаТоварыНаСкладах()
	
	ТекстЗапроса = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
