
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ОбновитьЭлементыФормы();
КонецПроцедуры

&НаСервере
Функция ВыполнитьПерепроведениеПоПартиямНаСервере()
	
	ВремНачалоПериода = НачалоДня(НачалоПериода);
	ВремКонецПериода = ?(КонецПериода = Дата(1,1,1),КонецДня(ТекущаяДатаСеанса()),КонецДня(КонецПериода));
	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТоварыНаСкладахОбороты.Регистратор
	|ИЗ
	|	РегистрНакопления.ТоварыНаСкладах.Обороты(&НачалоПериода, &КонецПериода, Регистратор, Номенклатура В ИЕРАРХИИ (&Номенклатура)) КАК ТоварыНаСкладахОбороты
	|
	|УПОРЯДОЧИТЬ ПО
	|	ТоварыНаСкладахОбороты.Период";
	Запрос.УстановитьПараметр("НачалоПериода",ВремНачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода",ВремКонецПериода);
	Запрос.УстановитьПараметр("Номенклатура",Номенклатура);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ДокОбъект = Выборка.Регистратор.ПолучитьОбъект();
		Попытка
			ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
		Исключение
			Возврат ДокОбъект.Ссылка;
		КонецПопытки;
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

&НаКлиенте
Процедура ВыполнитьПерепроведениеПоПартиям(Команда)
	Элементы.ДекорацияИдетПерепроведение.Видимость = Истина;
	Результат = ВыполнитьПерепроведениеПоПартиямНаСервере();
	Элементы.ДекорацияИдетПерепроведение.Видимость = Ложь;
	
	Если НЕ Результат = Истина Тогда
		ПоказатьПредупреждение(,"Не удалось перепровести документ " + Результат + ". Вам необходимо исправить его ошибки и запустить перепроведение заново");
	Иначе
		ПоказатьПредупреждение(,"Перепроведение завершено");
	КонецЕсли;
	
	ОбновитьЭлементыФормы();
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьЭлементыФормы()
	
	Элементы.ДекорацияИдетПерепроведение.Видимость = Ложь;
	
	Если ОбщийМодуль.ПоследовательностьПоСебестоимостиНарушена() Тогда
		Элементы.ГруппаПоследовательность.Видимость = Истина;
		Элементы.ДекорацияНарушенаПоследовательность.Заголовок = "Последовательность по себестоимости нарушена." + Символы.ПС + "Граница последовательности: " + ОбщийМодуль.ПолучитьГраницуПоследовательностиПоСебестоимости();
	Иначе
		Элементы.ГруппаПоследовательность.Видимость = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ВосстановитьПоследовательностьНаСервере()
	
	Последовательности.СебестоимостьЗапасов.Восстановить();
	ОбновитьЭлементыФормы();
	
КонецПроцедуры

&НаКлиенте
Процедура ВосстановитьПоследовательность(Команда)
	
	Элементы.ДекорацияИдетПерепроведение.Видимость = Истина;
	ВосстановитьПоследовательностьНаСервере();
	ПоказатьПредупреждение(,"Восстановление последовательности по себестоимости завершено");
	
КонецПроцедуры

&НаСервере
Процедура УстановитьГраницуНаДатуНаСервере(НоваяДатаГраницы)
	
	Последовательности.СебестоимостьЗапасов.УстановитьГраницу(Новый МоментВремени(НоваяДатаГраницы,));
	ОбновитьЭлементыФормы();
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьГраницуНаДату(Команда)
	
	ПослеВводаДаты = Новый ОписаниеОповещения("ПослеВводаДаты", ЭтаФорма);
	ПоказатьВводДаты(ПослеВводаДаты,);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВводаДаты(Дата, Параметры) Экспорт
    Если НЕ Дата = Неопределено Тогда
        УстановитьГраницуНаДатуНаСервере(Дата);
    КонецЕсли;
КонецПроцедуры
