&НаКлиенте
Функция ПолучитьСписокОператоров_Mango(ВнутрНомер="")

	ДанныеJSON="{}";
	Если ЗначениеЗаполнено(ВнутрНомер) Тогда
		ДанныеJSON="{'extension':'"+ВнутрНомер+"'}";
	КонецЕсли;	
	Пакет=СформироватьПакетREST(ДанныеJSON,"config/users/request");	
	ОтправитьПакетSimplitIO(Пакет);

КонецФункции
 
