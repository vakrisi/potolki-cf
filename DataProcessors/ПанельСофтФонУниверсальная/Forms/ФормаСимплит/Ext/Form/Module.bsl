&НаКлиенте
Функция ЭтоСобытиеТекущегоВнутреннего_Binotel(СтрТекущиеСобытия)

	Результат=Ложь;
	
	Если СтрТекущиеСобытия.extNumber=ВнутреннийНомер Тогда
		Возврат Истина;
	КонецЕсли; 
	
	Если СтрТекущиеСобытия.internalNumber=ВнутреннийНомер Тогда
		Возврат Истина;
	КонецЕсли; 
	
	Если ЗначениеЗаполнено(УчастникиГруппы) Тогда
		Результат=(Не УчастникиГруппы.Найти(СтрТекущиеСобытия.internalNumber+"_"+ВнутреннийНомер)=Неопределено);
	Иначе
		Результат=(Не ЭтоВнутреннийНомер_Binotel(СтрТекущиеСобытия.internalNumber));
	КонецЕсли; 
	
	Возврат Результат;

КонецФункции

&НаКлиенте
Функция ЭтоВнутреннийНомер_Binotel(Номер)

	Если Не ЗначениеЗаполнено(Номер) Тогда
		Возврат Ложь;
	КонецЕсли; 
	Если Номер=ВнутреннийНомер Тогда
		Возврат Истина;
	КонецЕсли; 
	
	ПараметрыОтбора=Новый Структура;
	ПараметрыОтбора.Вставить("Номер", Номер);
	МассивСтрок = ВнутренниеНомера_Binotel.НайтиСтроки(ПараметрыОтбора);
	Если ЗначениеЗаполнено(МассивСтрок) Тогда
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;

КонецФункции

&НаКлиенте
Функция ПолучитьСтрокуСобытия_Binotel(ИД, ФлагСоздания=Истина)

	Результат=Неопределено;
	
	Если Не ЗначениеЗаполнено(ИД) Тогда
		Возврат Результат;
	КонецЕсли; 
	
	ПараметрыОтбора=Новый Структура;
	ПараметрыОтбора.Вставить("generalCallID", ИД);
	МассивСтрок=ТекущиеСобытия_Binotel.НайтиСтроки(ПараметрыОтбора);
	Если Не ЗначениеЗаполнено(МассивСтрок) Тогда
		Если ФлагСоздания Тогда
			Результат=ТекущиеСобытия_Binotel.Добавить();
			Результат.generalCallID=ИД;
		КонецЕсли; 
	Иначе	
		Результат=МассивСтрок[0];
	КонецЕсли;

	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция ОбработкаВнутренниеНомера_Binotel(Данные)

	ВнутренниеНомера_Binotel.Очистить();
	
	КоллекцияСотрудники=Данные.Получить("listOfEmployees");
	Для каждого ЭлементСотрудник Из КоллекцияСотрудники Цикл
	
		ОбъектКлюч=ЭлементСотрудник.Ключ;
		ОбъектСотрудник=ЭлементСотрудник.Значение;
		
		Если ТипЗнч(ОбъектСотрудник)=Тип("Соответствие") Тогда
		
			extNumber=ОбъектСотрудник.Получить("extNumber");
			Если Не ЗначениеЗаполнено(extNumber) Тогда
				Продолжить;
			КонецЕсли;
			
			ОбъектСтатус=ОбъектСотрудник.Получить("extStatus");
			
			Если Не extNumber=ВнутреннийНомер Тогда
			
				СтрВнутренниеНомера = ВнутренниеНомера_Binotel.Добавить();
				СтрВнутренниеНомера.Имя=ОбъектСотрудник.Получить("name");
				СтрВнутренниеНомера.Номер=extNumber;
				СтрВнутренниеНомера.НомерSIP=ОбъектСотрудник.Получить("extHash");
				СтрВнутренниеНомера.Мобильный=ОбъектСотрудник.Получить("mobilePhoneNumber");
				СтрВнутренниеНомера.Присутствие=ОбъектСотрудник.Получить("presenceState");
				СтрВнутренниеНомера.Статус=ОбъектСтатус.Получить("status");
				//СтрВнутренниеНомера.ИндексСтатуса=ПолучитьИндексСтатуса(СтрВнутренниеНомера.Статус);
			
			Иначе
				//СтатусТелефона=(Не ОбъектСтатус.Получить("status")="offline");
			КонецЕсли; 
		
		КонецЕсли; 
	
	КонецЦикла;
	
	ВнутренниеНомера_Binotel.Сортировать("ИндексСтатуса Убыв, Номер Возр");
	//ЗаполнитьПользователей();

КонецФункции

&НаКлиенте
Функция ОбработкаРингГруппы_Binotel(Данные)

	УчастникиГруппы=Новый Массив;
	
	КоллекцияГруппы=Данные.Получить("listOfRingGroups");
	Для каждого ЭлементГруппы Из КоллекцияГруппы Цикл
	
		ОбъектКлюч=ЭлементГруппы.Ключ;
		ОбъектГруппа=ЭлементГруппы.Значение;
		
		Если ТипЗнч(ОбъектГруппа)=Тип("Соответствие") Тогда
		
			НомерГруппы=ОбъектГруппа.Получить("number");
			Если Не ЗначениеЗаполнено(НомерГруппы) Тогда
				Продолжить;
			КонецЕсли;
			
			ЧленыГруппы=ОбъектГруппа.Получить("members");
			Если Не ТипЗнч(ЧленыГруппы)=Тип("Массив") Тогда
				Продолжить;
			КонецЕсли; 
			
			Для каждого УчастникГруппы Из ЧленыГруппы Цикл
				УчастникиГруппы.Добавить(НомерГруппы+"_"+УчастникГруппы);
			КонецЦикла; 
		
		КонецЕсли; 
	
	КонецЦикла;
	
КонецФункции

