&НаКлиенте
Функция ОбработкаСозданияКанала_Onpbx(Данные)
	
	Если Не ТипЗнч(Данные)=Тип("Структура") Тогда
		Возврат Ложь;
	КонецЕсли; 
	
	destination_number=""; ИД=""; aleg_uuid=""; gate=""; 
	//bleg_uuid="";
	Если Не Данные.Свойство("destination_number",destination_number) Тогда
		Возврат Ложь;
	КонецЕсли; 
	Если Не Данные.Свойство("uuid",ИД) Тогда
		Возврат Ложь;
	КонецЕсли;
	Данные.Свойство("gate", gate);
	
	СтрТекущиеЗвонки = ПолучитьСтрокуИсторииOnlinePBX(Новый Структура("uuid", ИД));
	
	//2020-12-25 Не перетираем данные родительской строки СтрТекущиеЗвонки, так как при наличии нескольких пользователей, звонок отображается только у одного пользователя
	
	Если Данные.Свойство("aleg_uuid", aleg_uuid) Тогда		
		
		СтрРодительскийЗвонок = ПолучитьСтрокуИсторииOnlinePBX(Новый Структура("uuid", aleg_uuid), Ложь);
		Если НЕ СтрРодительскийЗвонок = Неопределено Тогда
			ЗаполнитьЗначенияСвойств(СтрТекущиеЗвонки, СтрРодительскийЗвонок, "direction, caller_number, gate");	
		КонецЕсли;
		
		//bleg_uuid=ИД;
		ИД=aleg_uuid;
	Иначе		

		Данные.Свойство("direction",		СтрТекущиеЗвонки.direction);
		Данные.Свойство("caller_number",	СтрТекущиеЗвонки.caller_number);
		СтрТекущиеЗвонки.gate=gate;
	КонецЕсли;
	
	СтрТекущиеЗвонки.destination_number=destination_number;
	//Данные.Свойство("uuid",				СтрТекущиеЗвонки.uuid);
	//Данные.Свойство("direction",		СтрТекущиеЗвонки.direction);
	Данные.Свойство("created_stamp",	СтрТекущиеЗвонки.created_stamp);
	Данные.Свойство("state",			СтрТекущиеЗвонки.state);
	Данные.Свойство("endpoint",			СтрТекущиеЗвонки.endpoint);
	Данные.Свойство("domain",			СтрТекущиеЗвонки.domain);
	//Данные.Свойство("caller_number",	СтрТекущиеЗвонки.caller_number);
	Данные.Свойство("caller_name",		СтрТекущиеЗвонки.caller_name);
	Данные.Свойство("destination_host",	СтрТекущиеЗвонки.destination_host);
	Данные.Свойство("aleg_uuid",		СтрТекущиеЗвонки.aleg_uuid);
	
	Если Не ЗначениеЗаполнено(СтрТекущиеЗвонки.direction) Тогда
		Данные.Свойство("direction",	СтрТекущиеЗвонки.direction);
	КонецЕсли;
	//Если ЗначениеЗаполнено(gate) Тогда
	//	СтрТекущиеЗвонки.gate=gate;
	//Иначе
	//	//пытаемся найти гейт из таблицы текущих звонков
	//	ПараметрыОтбора=Новый Структура;
	//	ПараметрыОтбора.Вставить("aleg_uuid", ИД);
	//	МассивСтрок=ИсторияOnlinePBX.НайтиСтроки(ПараметрыОтбора);
	//	Для чНом = 0 По МассивСтрок.Количество()-1 Цикл
	//		Если НЕ ПустаяСтрока(МассивСтрок[чНом].gate) Тогда
	//			СтрТекущиеЗвонки.gate=МассивСтрок[чНом].gate;
	//		КонецЕсли;
	//	КонецЦикла
	//КонецЕсли;
	
	
	//Если ЗначениеЗаполнено(bleg_uuid) Тогда
	//	СтрТекущиеЗвонки.bleg_uuid=bleg_uuid;
	//КонецЕсли;
	
	СтрТекущиеЗвонки.internal=ЭтоВнутреннийЗвонок_Onpbx(СтрТекущиеЗвонки.caller_number,СтрТекущиеЗвонки.destination_number);
	Если СтрТекущиеЗвонки.internal Тогда
		Возврат Ложь;
	КонецЕсли; 
	
	Если destination_number=ВнутреннийНомер 
		ИЛИ (СтрТекущиеЗвонки.endpoint = ЛогинТелефонии И НЕ ПустаяСтрока(ЛогинТелефонии)) //#7881
		Тогда
		// входящий
		ИДТекущегоЗвонка=ИД;
		Состояние="Вызов";
		НомерАбонента=СтрТекущиеЗвонки.caller_number;
		СтрТекущиеЗвонки.extension=ВнутреннийНомер;
		СтрТекущиеЗвонки.number=НомерАбонента;
		
		НаправлениеЗвонка="";
		Если ПользовательПринимаетВходящиеЗвонки() Тогда
			Если ЗначениеЗаполнено(СтрТекущиеЗвонки.direction) 
				И НЕ СтрТекущиеЗвонки.direction = "outbound" // не исходящий (callback) ++2020-10-20 
				Тогда
				НаправлениеЗвонка="Входящий";
				ВнешняяЛиния=СтрТекущиеЗвонки.gate;
				
				СтруктураНовойФормы = Новый Структура;
				СтруктураНовойФормы.Вставить("НомерАбонента",СофтФон.ПолучитьНомерТелефонаВМеждународномФОрматеПользователя(НомерАбонента));
				СтруктураНовойФормы.Вставить("ВнешняяЛиния",ВнешняяЛиния);
				СтруктураНовойФормы.Вставить("НашВнутреннийНомер",ВнутреннийНомер);
				СтруктураНовойФормы.Вставить("ИДсобытия",СтрТекущиеЗвонки.uuid);
				СтруктураНовойФормы.Вставить("ИДСессииСобытия",СтрТекущиеЗвонки.aleg_uuid);
				ОткрытьФорму("ОбщаяФорма.ФормаВходящийЗвонок",СтруктураНовойФормы,,НомерАбонента,ВариантОткрытияОкна.ОтдельноеОкно,,,); //ТЕСТ!
				
			КонецЕсли; 
		КонецЕсли;
		СтрТекущиеЗвонки.incoming=1;
		
		Возврат Истина;
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Функция ОбработкаСоединениеКанала_Onpbx(Данные)

	Если Не ЗначениеЗаполнено(ИДТекущегоЗвонка) Тогда
		Возврат Ложь;
	КонецЕсли; 
	Если Не ТипЗнч(Данные)=Тип("Структура") Тогда
