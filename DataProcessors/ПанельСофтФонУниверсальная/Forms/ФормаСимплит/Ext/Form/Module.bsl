			Если СтрТекущиеСобытия.callType="0" Тогда
				НаправлениеЗвонка="Входящий";
				Линия=СтрТекущиеСобытия.didNumber;
			Иначе
				НаправлениеЗвонка="Исходящий";
				Линия="";
