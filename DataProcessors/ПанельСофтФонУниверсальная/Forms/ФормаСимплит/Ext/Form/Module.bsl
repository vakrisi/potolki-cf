&НаКлиенте
Функция ПолучитьКлючREST_Phonet()

	КлючСессии=""; Таймаут=5;
	SSL = Новый ЗащищенноеСоединениеOpenSSL();
	HTTPСоединение=Новый HTTPСоединение(ДоменAPI,,,,,Таймаут,SSL);
	
	ДанныеJSON="{'domain':'"+ДоменAPI+"','apiKey':'"+КлючAPI+"'}";
	HTTPЗапрос=Новый HTTPЗапрос();
	HTTPЗапрос.АдресРесурса="/rest/security/authorize";
	HTTPЗапрос.Заголовки.Вставить("Content-Type","application/json");
	HTTPЗапрос.УстановитьТелоИзСтроки(СофтФонКлиентСервер.Stringify(ДанныеJSON));
	
	Попытка
		HTTPОтвет=HTTPСоединение.ОтправитьДляОбработки(HTTPЗапрос);
		Если HTTPОтвет.КодСостояния=200 Тогда
			КлючСессии=HTTPОтвет.Заголовки.Получить("Set-Cookie");
		КонецЕсли; 
	Исключение
		//Если Отладка Тогда
		Сообщить("Ошибка получения ключа сессии: " + ОписаниеОшибки());
		//КонецЕсли; 
	КонецПопытки; 
	
	Возврат КлючСессии;

КонецФункции

