&НаКлиенте
Функция ОбработкаСписокОператоровITooLabs(Данные)
	
	Если Не ТипЗнч(Данные)=Тип("Массив") Тогда
		Возврат Ложь;
	КонецЕсли; 
	
	ВнутренниеНомера.Очистить();
	Для каждого ЭлементМассива Из Данные Цикл
		
		ВнутрНомер = Неопределено;
		ЭлементМассива.Свойство("ext", ВнутрНомер);
		Если ВнутрНомер=ВнутреннийНомер Тогда
			ЭлементМассива.Свойство("name",ВнутреннийЛогин_ITooLabs);
			Продолжить;
		КонецЕсли;
		
		СтрВнутренниеНомера=ВнутренниеНомера.Добавить();
		ЭлементМассива.Свойство("ext",СтрВнутренниеНомера.Номер);
		ЭлементМассива.Свойство("name",СтрВнутренниеНомера.Имя);
		СтрВнутренниеНомера.ВнутреннийЛогин=СтрВнутренниеНомера.Имя+"@"+ДоменAPI;
		
	КонецЦикла;
		
