		Пакет=СформироватьПакетREST(ДанныеJSON, Путь, "get", Маркер);
	
	ИначеЕсли ИспользуетсяROMHMAC Тогда
		// OnlinePBX	
		Если ВерсияИсторииАТС = 0 Тогда
			Путь="history/search.json";
			
			СтрДата1="";
			Если ЗначениеЗаполнено(Дата1) Тогда
				// дата в формате RFC 2822
				rfcДата1=ПолучитьДатуRFC(Дата1);
