&НаКлиенте
Функция ОбработкаСобытийREST_Phonet(СобытиеПакета, ДанныеПакета, Маркер="")
	
	ДанныеСобытия = Base64Раскодировать(ДанныеПакета);
	
	Данные = СофтФонКлиентСервер.ПолучитьДанныеJSON(ДанныеСобытия,Истина);
		
	// json не прошел валидацию
	Если Данные=Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ФлагAPI=Истина;
	
	// обработка сообщений об ошибках от API
	Если ТипЗнч(Данные)=Тип("Соответствие") Тогда
	
		Статус=Данные.Получить("error");
		Если Не Статус=Неопределено Тогда
			
			СтатусОшибки=ИнфоОшибок.Получить(Статус);
			Если СтатусОшибки=Неопределено Тогда
				СтатусОшибки=Статус;
			КонецЕсли; 
			
			ТекстОшибки=ИнфоОшибок.Получить(Данные.Получить("message"));
			Если ТекстОшибки=Неопределено Тогда
				ТекстОшибки=Данные.Получить("message");
			КонецЕсли; 
			ПоказатьОповещениеПользователя(СтатусОшибки,,ТекстОшибки);
		
		КонецЕсли; 
	
	КонецЕсли; 
	
	// определение имени события
	Событие=СтрЗаменить(СобытиеПакета,Схема+ДоменAPI,"");
	ПозицияПараметров=Найти(Событие,"?");
	Если ПозицияПараметров>0 Тогда
		Событие=Лев(Событие,ПозицияПараметров-1);
	КонецЕсли; 
	
	Если Событие="/rest/users" Тогда
		
		// список внутренних номеров
		ОбработкаВнутренниеНомера_Phonet(Данные);
		
	ИначеЕсли Найти(Событие,"/rest/calls/company.api")>0 Тогда
		
		// история
		ОбработкаИсторияАТС_Phonet(Данные, Маркер);
		
	КонецЕсли; 
	
КонецФункции

&НаКлиенте
Функция ОбработкаВнутренниеНомера_Phonet(Данные)

	Если Не ЗначениеЗаполнено(Данные) Тогда
		Возврат Ложь;
	КонецЕсли; 
	
	ДанныеСобытия=СофтФонКлиентСервер.ПолучитьДанныеJSON(Данные,Истина);
	
	Если Не ТипЗнч(ДанныеСобытия)=Тип("Массив") Тогда
		Возврат Ложь;
	КонецЕсли; 
	
	ВнутренниеНомера_Phonet.Очистить();
	
	Для каждого ЭлементСотрудник Из ДанныеСобытия Цикл
		
		Если Не ТипЗнч(ЭлементСотрудник)=Тип("Соответствие") Тогда
			Возврат Ложь;
		КонецЕсли; 
		
		Номер=ЭлементСотрудник.Получить("ext");
		Если Не Номер=ВнутреннийНомер Тогда
			СтрВнутренниеНомера=ВнутренниеНомера_Phonet.Добавить();
			СтрВнутренниеНомера.ИД=Формат(ЭлементСотрудник.Получить("id"),"ЧГ=0");
			СтрВнутренниеНомера.Номер=Номер;
			СтрВнутренниеНомера.Почта=ЭлементСотрудник.Получить("email");
			СтрВнутренниеНомера.Имя=ЭлементСотрудник.Получить("displayName");
			СтрВнутренниеНомера.Статус="online";
			СтрВнутренниеНомера.ИндексСтатуса=ПолучитьИндексСтатуса_Phonet(СтрВнутренниеНомера.Статус);
		Иначе
			СтатусТелефона=Истина;
		КонецЕсли; 
		
	КонецЦикла;
	
	ВнутренниеНомера_Phonet.Сортировать("ИндексСтатуса Убыв, Номер Возр");
	//ЗаполнитьПользователей();

КонецФункции

