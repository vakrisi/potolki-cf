			КонецЕсли;
			
			СтрДата2="";
			Если ЗначениеЗаполнено(Дата2) Тогда
				// дата в формате RFC 2822
				rfcДата2=ПолучитьДатуRFC(Дата2);
				СтрДата2=",'date_to':'"+rfcДата2+"'";
			КонецЕсли;
			
			СтрНомер="'out_number':''";
			
			ДанныеJSON="{"+СтрНомер+СтрДата1+СтрДата2+"}";
			Пакет=СформироватьПакетREST(ДанныеJSON,Путь);
			
		ИначеЕсли  ВерсияИсторииАТС = 1 Тогда  		
			// OnlinePBX (новая версия)
			Путь="mongo_history/search.json";
			
			СтрДата1="";
			Если ЗначениеЗаполнено(Дата1) Тогда
				ДатаЗапроса1 = УниверсальноеВремя(Дата1); // согласно инструкции требуется GMT 0
				// дата в формате UT
				ПредставлениеДата1 = ПолучитьДатуUT(ДатаЗапроса1); //Формат(ДатаЗапроса1 - Дата(1970,1,1,0,0,0), "ЧГ=0");
