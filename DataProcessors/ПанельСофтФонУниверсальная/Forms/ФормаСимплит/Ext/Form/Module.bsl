		//ConnectedLineNum = СофтФон.ПолучитьНомерТелефонаВМеждународномФорматеПользователя(ConnectedLineNum);
		Channel = ДанныеСобытия.Получить("Channel");
		
		Если //(СокрЛП(CallerIDNum) = СокрЛП(ВнутреннийНомер) ИЛИ (СтрНайти(Channel, "SIP/"+ВнутреннийНомер)=1)) 
			СокрЛП(ConnectedLineNum) = СокрЛП(ВнутреннийНомер) 
			Тогда
			ЗакрытьФормуВходящегоЗвонка(Uniqueid);
			ИсторияAsterisk.Очистить();
		КонецЕсли;
		
	ИначеЕсли ВРег(ВидСобытия)="BRIDGE" Тогда
		//3. Менеджер поднял трубку....
		
		НоваяСтрока = ИсторияAsterisk.Добавить();
		НоваяСтрока.Event = ВРег(ВидСобытия);
		НоваяСтрока.Uniqueid = ДанныеСобытия.Получить("Uniqueid1");
		НоваяСтрока.Uniqueid1 = НоваяСтрока.Uniqueid;
		НоваяСтрока.Uniqueid2 = ДанныеСобытия.Получить("Uniqueid2");
		НоваяСтрока.Exten = "";
		НоваяСтрока.ДанныеСобытия = ДанныеСобытия;
		НоваяСтрока.CallerID2 = ДанныеСобытия.Получить("CallerID1");
		
	КонецЕсли;
		
	
	//отрабатываем события
	Если ВРег(ВидСобытия)="DIAL" Тогда
		Если ПользовательПринимаетВходящиеЗвонки() Тогда
			
			ВнутреннийНомерКудаУпалЗвонок = ДанныеСобытия.Получить("Dialstring");
			ВнутреннийНомерМод = СокрЛП(ВнутреннийНомер) + "@";
			Если СокрЛП(ВнутреннийНомерКудаУпалЗвонок) = СокрЛП(ВнутреннийНомер) 
				//ИЛИ Лев(СокрЛП(ВнутреннийНомерКудаУпалЗвонок), СтрДлина(ВнутреннийНомерМод)) = ВнутреннийНомерМод
				Тогда
				//к нам упал
				
				Отбор = Новый Структура;
				Отбор.Вставить("CallerID2", ДанныеСобытия.Получить("CallerIDNum"));
				Отбор.Вставить("Event",    "DIAL");
				НайденныеСтроки = ИсторияAsterisk.НайтиСтроки(Отбор);
				UniqueID = "";
				Колво = НайденныеСтроки.Количество();
				Для Индекс = 1 По Колво Цикл
					СтрокаТЗ = НайденныеСтроки[Колво-Индекс];
					Если Лев(СокрЛП(СтрокаТЗ.Dialstring), СтрДлина(ВнутреннийНомерМод)) = ВнутреннийНомерМод Тогда
						UniqueID = СтрокаТЗ.UniqueID;
						Прервать;
					КонецЕсли;
				КонецЦикла;
				
				НашВнешнийНомер = "";
				Если НЕ ПустаяСтрока(UniqueID) Тогда
					НоваяСтрока.Uniqueid1 = UniqueID; // сохраним ИД сессии
					Отбор = Новый Структура;
					Отбор.Вставить("Uniqueid", UniqueID);
					Отбор.Вставить("Event","NEWCHANNEL");
					НайденныеСтроки = ИсторияAsterisk.НайтиСтроки(Отбор);
					Если НайденныеСтроки.Количество() > 0 Тогда
						НашВнешнийНомер = ?(НЕ ПустаяСтрока(НайденныеСтроки[0].CallerIDName), НайденныеСтроки[0].CallerIDName, НайденныеСтроки[0].Exten); 						
					КонецЕсли;
					
					СтруктураНовойФормы = Новый Структура;
					СтруктураНовойФормы.Вставить("НомерАбонента",СофтФон.ПолучитьНомерТелефонаВМеждународномФОрматеПользователя(ДанныеСобытия.Получить("CallerIDNum")));
					СтруктураНовойФормы.Вставить("ВнешняяЛиния",НашВнешнийНомер);
					СтруктураНовойФормы.Вставить("НашВнутреннийНомер",ВнутреннийНомер);
					СтруктураНовойФормы.Вставить("ИДсобытия", ДанныеСобытия.Получить("UniqueID"));
					СтруктураНовойФормы.Вставить("ИДСессииСобытия", UniqueID);
					
					ОткрытьФорму("ОбщаяФорма.ФормаВходящийЗвонок",СтруктураНовойФормы,,ДанныеСобытия.Получить("CallerIDNum"),ВариантОткрытияОкна.ОтдельноеОкно,,,);
				КонецЕсли;
			КонецЕсли;
			
		КонецЕсли;
		
	ИначеЕсли ВРег(ВидСобытия) = "BRIDGE" Тогда
		
		времИДсобытия = ДанныеСобытия.Получить("Uniqueid1");
		ИДСессии = ""; 
		Отбор = Новый Структура;
		Отбор.Вставить("Uniqueid", времИДсобытия);
		Отбор.Вставить("Event",    "DIAL");
		НайденныеСтроки = ИсторияAsterisk.НайтиСтроки(Отбор);
		Если НайденныеСтроки.Количество() > 0 Тогда
			ИДСессии = НайденныеСтроки[0].Uniqueid1;
		КонецЕсли;
		
		Если СокрЛП(ДанныеСобытия.Получить("CallerID2")) = СокрЛП(ВнутреннийНомер) Тогда
			//создался канал между 2 мя - подняли трубку и начали разговор		
			НомерАбонента = СофтФон.ПолучитьНомерТелефонаВМеждународномФорматеПользователя(СокрЛП(ДанныеСобытия.Получить("CallerID1")));
			ДействияПриПоднятииТрубки_Asterisk(НомерАбонента, времИДсобытия, ИДСессии);
		КонецЕсли; 
		ЗакрытьФормуВходящегоЗвонка(времИДсобытия);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаСобытий_Вариант_93_1_Asterisk(ВидСобытия, ДанныеСобытия)
	
	//2. Звонок поступает по очереди: на номер 220, затем 215, 203 ...
	// номер 215 только в событии DialBegin
	
	//++Newchannel 
	//CallerIDNum: 220            
	//Uniqueid: 1647587456.836
	//Linkedid: 1647587439.834
	//
	//
	//++DialBegin входящий звонок на менеджера (форма входящий звонок)
	//
	//ConnectedLineNum: 215    - внутренний номер менеджера
	//CallerIDNum: 89270480522 - номер абонента
	//
	//Uniqueid: 1647587439.834
	//Linkedid: 1647587439.834
	//
	//
	//++BridgeEnter (поднятие трубки, 2 события. реакция на второе)
	//++BridgeEnter 
	//CallerIDNum: 89270480522
	//ConnectedLineNum: 220
	//ConnectedLineName: 220
	//Uniqueid: 1647587439.834
	//Linkedid: 1647587439.834
	//
	//
	//
	//++Hangup (2 события)
	//CallerIDNum: 220
	//CallerIDName: 220
	//ConnectedLineNum: 89270480522
	//Uniqueid: 1647587456.836
	//Linkedid: 1647587439.834

	//копим историю звонков
	Если ВРег(ВидСобытия)="NEWCHANNEL" Тогда
		//1. Пришел звонок на наш внешний номер (группу номеров)
		
		НоваяСтрока = ИсторияAsterisk.Добавить();
		НоваяСтрока.Event = ВидСобытия;
		НоваяСтрока.Uniqueid  = ДанныеСобытия.Получить("Uniqueid");
		НоваяСтрока.Linkedid  = ДанныеСобытия.Получить("Linkedid");
		НоваяСтрока.Exten = ДанныеСобытия.Получить("Exten");
		//НоваяСтрока.ДанныеСобытия = ДанныеСобытия;
		НоваяСтрока.CallerID2 = ДанныеСобытия.Получить("CallerIDNum");       // внутренний номер менеджера
		//НоваяСтрока.CallerIDName = ДанныеСобытия.Получить("CallerIDName");

	ИначеЕсли ВРег(ВидСобытия) = "DIALBEGIN" Тогда
		//2. АТС перебросила звонок на менеджера
		
		НоваяСтрока = ИсторияAsterisk.Добавить();
		НоваяСтрока.Event = ВРег(ВидСобытия);
		НоваяСтрока.Uniqueid  = ДанныеСобытия.Получить("DestUniqueid");
		НоваяСтрока.Linkedid  = ДанныеСобытия.Получить("DestLinkedid");
		НоваяСтрока.DestCallerIDNum = СокрЛП(ДанныеСобытия.Получить("DestCallerIDNum"));  // внутренний номер менеджера 
		НоваяСтрока.CallerID2 = ДанныеСобытия.Получить("CallerIDNum");  // номер клиента
		ВнешняяЛиния = ДанныеСобытия.Получить("DestExten");
		
		Если СокрЛП(НоваяСтрока.DestCallerIDNum) = СокрЛП(ВнутреннийНомер) Тогда			
			ДействияПриНачалеВходящегоЗвонка(НоваяСтрока.CallerID2, ВнешняяЛиния, ВнутреннийНомер, НоваяСтрока.Uniqueid, НоваяСтрока.Linkedid);			
		КонецЕсли;
		
	ИначеЕсли ВРег(ВидСобытия) = "HANGUP" Тогда	
		
		//Разорвал канал - положили трубку или разговор окончен - закрываем окно входящего звонка
		//CallerIDNum = ДанныеСобытия.Получить("CallerIDNum");
		Uniqueid = ДанныеСобытия.Получить("Uniqueid");
		//ConnectedLineNum = ДанныеСобытия.Получить("ConnectedLineNum");
		//ConnectedLineNum = СофтФон.ПолучитьНомерТелефонаВМеждународномФорматеПользователя(ConnectedLineNum);
		//Channel = ДанныеСобытия.Получить("Channel");
		//
		//Если (СокрЛП(CallerIDNum) = СокрЛП(ВнутреннийНомер) Тогда
			ЗакрытьФормуВходящегоЗвонка(Uniqueid);
			ИсторияAsterisk.Очистить();
		//КонецЕсли;
		
	ИначеЕсли ВРег(ВидСобытия)="BRIDGEENTER" Тогда
		//3. Менеджер поднял трубку
		
		НоваяСтрока = ИсторияAsterisk.Добавить();
		НоваяСтрока.Event = ВидСобытия;
		НоваяСтрока.Uniqueid  = ДанныеСобытия.Получить("Uniqueid");
		НоваяСтрока.Linkedid  = ДанныеСобытия.Получить("Linkedid");
		НоваяСтрока.CallerID2 = ДанныеСобытия.Получить("CallerID1"); //номер группы		
		
		Отбор = Новый Структура;
		Отбор.Вставить("Uniqueid", 			ДанныеСобытия.Получить("Uniqueid"));
		Отбор.Вставить("Linkedid", 			ДанныеСобытия.Получить("Linkedid"));
		Отбор.Вставить("Event", 			"DIALBEGIN");
		Отбор.Вставить("DestCallerIDNum", 	СокрЛП(ВнутреннийНомер));
		
		НайденныеСтроки = ИсторияAsterisk.НайтиСтроки(Отбор);
		Если НайденныеСтроки.Количество() > 0 Тогда
			
		//времИДсобытия = ПолучитьИдСобытияДоТочки(ДанныеСобытия.Получить("Uniqueid1"));
		//
		//Если СокрЛП(ДанныеСобытия.Получить("CallerID2")) = СокрЛП(ВнутреннийНомер) Тогда		
			НомерАбонента = СофтФон.ПолучитьНомерТелефонаВМеждународномФорматеПользователя(НайденныеСтроки[0].CallerID2);
			ДействияПриПоднятииТрубки_Asterisk(НомерАбонента, НоваяСтрока.Uniqueid);
		//КонецЕсли; 
			ЗакрытьФормуВходящегоЗвонка(НоваяСтрока.Uniqueid);
		КонецЕсли;
		
	КонецЕсли;
		
КонецПроцедуры

&НаСервере
Процедура ОбработкаИсторияАТСAsteriskНаСервере(ДатаНачала, ДатаОкончания)
	
	МассивПараметров = Новый Массив;	
	СтруктПараметры = Новый Структура;
	СтруктПараметры.Вставить("ВидАТС", ИДВАТС);	
	СтруктПараметры.Вставить("ДатаНачала", ДатаНачала);
	СтруктПараметры.Вставить("ДатаОкончания", ДатаОкончания);
	СтруктПараметры.Вставить("ДатаЗапросаИстории", ТекущаяДатаСеанса());
	МассивПараметров.Добавить(СтруктПараметры);
	
	// сначала проверим завершилось ли предыдущее задание
	ТребуетсяЗапускЗадания = Истина;
	Если НЕ ПустаяСтрока(ИдентификаторФоновогоЗаданияИстории) И ИдентификаторФоновогоЗаданияИстории <> "00000000-0000-0000-0000-000000000000" Тогда
		НайденноеЗадание = ФоновыеЗадания.НайтиПоУникальномуИдентификатору(Новый УникальныйИдентификатор(ИдентификаторФоновогоЗаданияИстории));
		Если НЕ НайденноеЗадание = Неопределено Тогда
			Если НайденноеЗадание.Состояние = СостояниеФоновогоЗадания.Активно Тогда
				ТребуетсяЗапускЗадания = Ложь;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	Если ТребуетсяЗапускЗадания Тогда
		ФоновоеЗадание = ФоновыеЗадания.Выполнить("СофтФон.ОбработкаИсторииЗвонковАТС", МассивПараметров, , "Обработка истории звонков АТС");
		ИдентификаторФоновогоЗаданияИстории = Строка(ФоновоеЗадание.УникальныйИдентификатор);
	КонецЕсли;
	
КонецПроцедуры


