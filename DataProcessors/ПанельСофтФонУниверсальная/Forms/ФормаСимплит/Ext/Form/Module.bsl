&НаКлиенте
Функция ПолучитьСтрокуСобытия_Phonet(ИД, ФлагСоздания=Истина)

	Результат=Неопределено;
	
	Если Не ЗначениеЗаполнено(ИД) Тогда
		Возврат Результат;
	КонецЕсли; 
	
	ПараметрыОтбора=Новый Структура;
	ПараметрыОтбора.Вставить("ИД", ИД);
	МассивСтрок=ТекущиеСобытия_Phonet.НайтиСтроки(ПараметрыОтбора);
	Если Не ЗначениеЗаполнено(МассивСтрок) Тогда
		Если ФлагСоздания Тогда
			Результат=ТекущиеСобытия_Phonet.Добавить();
			Результат.ИД=ИД;
		КонецЕсли; 
	Иначе	
		Результат=МассивСтрок[0];
	КонецЕсли;

	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция ОбработкаНачалаЗвонкаНомера_Phonet(Данные)

	Попытка
				
		ИД=Данные.Получить("parentUuid");
		
		СтрТекущиеСобытия=ПолучитьСтрокуСобытия_Phonet(ИД);
		Если СтрТекущиеСобытия=Неопределено Тогда
			Возврат Ложь;
		КонецЕсли; 
		
		СтрТекущиеСобытия.ИДПлеча=Данные.Получить("uuid");
		СтрТекущиеСобытия.Направление=Данные.Получить("lgDirection");
		СтрТекущиеСобытия.ЛинияНомер=Данные.Получить("trunkNum");
		СтрТекущиеСобытия.ЛинияИмя=Данные.Получить("trunkName");
		СтрТекущиеСобытия.ДатаНачала=Данные.Получить("dialAt");
		СтрТекущиеСобытия.ДатаОтвета=Данные.Получить("bridgeAt");
		
		КоллекцияВнутрНомер=Данные.Получить("leg");
		Если ТипЗнч(КоллекцияВнутрНомер)=Тип("Соответствие") Тогда
			СтрТекущиеСобытия.ВнутреннийНомер=КоллекцияВнутрНомер.Получить("ext");
			СтрТекущиеСобытия.ВнутреннийНомерТип=КоллекцияВнутрНомер.Получить("type");
		КонецЕсли; 
		
		КоллекцияНомер=Данные.Получить("otherLegs");
		Если ТипЗнч(КоллекцияНомер)=Тип("Массив") Тогда
			Если КоллекцияНомер.Количество()>0 Тогда
