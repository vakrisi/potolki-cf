&НаКлиенте
Процедура ПодключитьсяКАТС()
	
	ПодключенКАТС = Ложь;
	
	Если ИспользуетсяROMAsterisk Тогда

		ПодключитьПанель_Asterisk();
		
	ИначеЕсли ИспользуетсяROMHMAC Тогда
		
		//справка: общий принцип подключения
		//скачиваем и подключаем библиотеку (панель) Simplit OnlinePBX
		//создаем внешнюю компоненту Simplit OnlinePBX которая будет отлавливать события OnlinePBX Simplit
		//Подключаем библиотеку к серверу Simplit и слушаем события
		//Если приходит событие Авторизации - отправляем логин\пароль авторизации, после прохождения авторизации к нам начинают падать события АТС OnlinePBX
		//Параллельно создаем внешнюю компоненту (панель), которая подключится к серверу Simplit и создаст ХЭШ для авторизации
		
		ПодключитьПанель_OnlinePBX(); //установили и включили компоненту
		ПодключитьсяКСерверуSimplit(); //подключидлисьподключились к серверу Simplit
		ПодключитьПанель_SimplitХэш(); //установили и включили компоненту
		
	ИначеЕсли ИспользуетсяSIOМегафон ИЛИ ИспользуетсяSIODomRu Тогда
		
		//справка: общий принцип подключения
		//скачиваем и подключаем библиотеку (панель) Simplit
		//создаем внешнюю компоненту Simplit которая будет отлавливать события 
		//Подключаем библиотеку к серверу Simplit и слушаем события
		
		ПодключитьПанель_ITooLabs();
		ПодключитьсяКСерверуSimplit(); //подключились к серверу Simplit
		
	ИначеЕсли ИспользуетсяSIOUIS Тогда
		
		//справка: общий принцип подключения
		//скачиваем и подключаем библиотеку (панель) Simplit
		//создаем внешнюю компоненту Simplit UIS которая будет отлавливать события UIS Simplit
		//Подключаем библиотеку к серверу Simplit и слушаем события
		
		ПодключитьПанель_UIS();
		ПодключитьсяКСерверуSimplit(); //подключились к серверу Simplit
		
	ИначеЕсли ИспользуетсяSIOSipuni Тогда
		
		//справка: общий принцип подключения
		//скачиваем и подключаем библиотеку (панель) Simplit
		//создаем внешнюю компоненту Simplit UIS которая будет отлавливать события UIS Simplit
		//Подключаем библиотеку к серверу Simplit и слушаем события
		
		ПодключитьПанель_Sipuni();
		ПодключитьсяКСерверуSimplit(); //подключились к серверу Simplit

	ИначеЕсли ИспользуетсяSIOBinotel 
		ИЛИ ИспользуетсяSIOMango 
		ИЛИ ИспользуетсяSIOPhonet Тогда
		
		//справка: общий принцип подключения
		//скачиваем и подключаем библиотеку (панель) Simplit
		//создаем внешнюю компоненту Simplit, которая будет отлавливать события Simplit
		//Подключаем библиотеку к серверу Simplit и слушаем события
		
		ПодключитьПанель_Simplit();
		ПодключитьсяКСерверуSimplit(); //подключились к серверу Simplit
		
	ИначеЕсли СофтФон.ИспользуютсяСофтФон() Тогда
		
		//справка: общий принцип подключения
		//устанавливаем сервер Рарус СофтФон
		//устанавилаем клиент Рарус СофтФон, подключаем к серверу и подколчаем к SIP. Указываем что основной канал - SIP
		//подключаем компоненту и слушаем внешние события
		
		ПодключитьПанель_РарусСофтФон();
		
	КонецЕсли;
	
	Если ПодключенКАТС И ИнтервалПроверкиПодключенияКАТС > 0 Тогда
	    ОтключитьОбработчикОжидания("ПроверитьПодключениеКАТС");
		ПодключитьОбработчикОжидания("ПроверитьПодключениеКАТС", ИнтервалПроверкиПодключенияКАТС, Ложь);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ИнтервалЗапросаИсторииЗвонков()
	Возврат ПараметрыСеанса.ИнтервалЗапросаИсторииЗвонков;
КонецФункции

&НаКлиенте
Процедура Подключиться(Команда)
	
	#Если ВебКлиент Тогда
		ПоказатьОповещениеПользователя("Компоненты работы с АТС не доступны в web-клиенте");
		Возврат;
	#КонецЕсли	
	
	ПодключенКАТС = Ложь;
	КоличествоВыполненныхПопытокПодключения = 0;
	
	Если ПараметрыСеансаТелефонияСтрана().Пустая() Тогда
		ПанельRomAsterisk = Неопределено;
		ПанельRomHMac = Неопределено;
		УстановитьСтатусПользовательПодключен(Ложь);
		ПоказатьПредупреждение(,"В настройках программы не указана страна (в разделе ""Основные""). Использование телефонии не доступно.");
		Возврат;
	КонецЕсли;
	
	//ВнутреннийНомер = СофтФон.ПолучитьВнутреннийНомерПользователя();
	//ЛогинТелефонии  = СофтФон.ПолучитьЛогинТелефонииПользователя();
	
	ЛогинАТС = СофтФон.ПолучитьЛогинАдминистратораАТС();
	ПарольАТС = СофтФон.ПолучитьПарольАдминистратораАТС();
	АдресАТС = СофтФон.ПолучитьТелефонияАдресСервера();
	
	Если СофтФон.ТекущемуПользователюРазрешеноИспользованиеIPТелефонии() Тогда
		ПодключитьсяКАТС();
		УстановитьСтатусПользовательПодключен(ПодключенКАТС);
	Иначе
		ПоказатьПредупреждение(,"Для использования софтфона у вас должно быть соответствующее право и внутренний номер SIP");
		ПанельRomAsterisk = Неопределено;
		ПанельRomHMac = Неопределено;
		УстановитьСтатусПользовательПодключен(Ложь);
	КонецЕсли;
	
КонецПроцедуры

////////////////////процедуры работы с историей  звонков
&НаСервере
Функция ТелефонияДатаПоследнегоЗапросаИстории()
	Возврат Константы.ТелефонияДатаНачальногоЗапросаИсторииЗвонков.Получить();
КонецФункции

&НаКлиенте
Процедура АвтоматическиЗапроситьИсториюЗвонков()
	
	ДатаНачала = ТелефонияДатаПоследнегоЗапросаИстории();
	Если ДатаНачала = Дата(1, 1, 1) Тогда
		ДатаНачала =  НачалоДня(ТекущаяДата());
	КонецЕсли;
	ДатаОкончания = ТекущаяДата();
	
	Если ДатаНачала + ИнтервалЗапросаИсторииЗвонков() <= ТекущаяДата() Тогда
		ПолучитьИсторию(ДатаНачала, ДатаОкончания);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ПолучитьИсторию(Дата1,Дата2)
	
	СмещениеЧасовогоПоясаАТС = Софтфон.СмещениеЧасовогоПоясаАТС();
	Если СмещениеЧасовогоПоясаАТС <> 0 Тогда
		Дата1 = Дата1 - СмещениеЧасовогоПоясаАТС;		
		Дата2 = Дата2 - СмещениеЧасовогоПоясаАТС;
	КонецЕсли;
	
	//#6061
	// по истории АТС есть "проблема". примерно так: в 18:52 поступил звонок, например в 18:55 в 1с производится запрос истории, 
	// который фиксирует время последнего успешного получения данных на 18:54 (когда был последний звонок). 
	// Звонок 18:52 длился 10 минут и завершился в 19:02 и только после этого попал в историю на стороне АТС (со временем 18:52). 
	// в следующий раз 1с при запросе запрашивает звонки с 18:54. В итоге звонок 18:52 в истории 1с не появляется.
	// Пока следующее решение: запрашивать 3 часа назад от последнего успешного
	Дата1 = Дата1 - 3*60*60;
	
	Пакет = "";
	Пакет2 = "";
	
	Если ИспользуетсяSIOМегафон ИЛИ ИспользуетсяSIODomRu Тогда
		
		СтрДата1="";
