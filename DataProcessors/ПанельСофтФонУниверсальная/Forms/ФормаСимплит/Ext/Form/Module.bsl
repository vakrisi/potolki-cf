////////////////////процедуры по исходящим звонкам
&НаКлиенте
Процедура ВыполнитьИсходящийЗвонок(ТелефонКлиента, ИмяКлиента)
	
	Если СофтФон.ИспользуютсяСофтФон() Тогда
		Если НЕ ПанельСофтФон = Неопределено Тогда
			Если НЕ ПанельСофтФон.MakeCall("", ТелефонКлиента, , ИмяКлиента, ИмяКлиента,) = 0 Тогда
				Состояние("Не удалось соединиться с СофтФон");
			КонецЕсли;
		Иначе
			Состояние("Не удалось соединиться с СофтФон");
		КонецЕсли;
		
	ИначеЕсли ИспользуетсяROMAsterisk Тогда
		
		Контекст = СофтФон.ПолучитьКонтекстИсходящихЗвонков();
		Если Не ЗначениеЗаполнено(ВнутреннийНомер) Тогда
			Состояние("Не указан внутренний номер, с которого выполняется звонок");
			Возврат;
		КонецЕсли;
		
		СтрокаНабораЦифры = ПодготовитьНомерДляЗвонка(ТелефонКлиента);
		Если ПустаяСтрока(СтрокаНабораЦифры) Тогда
			Состояние("Телефонный номер должен содержать цифры");
			Возврат;
		КонецЕсли;
		
		//отправим комнду проверки на наличие запущенного программного телефона или подключенного аппаратного. ответ поймает и отработает функция в обработке "СофтФон"
		CRLF=Chars.CR+Chars.LF;
		ТекстКоманды = "Action: Command"+CRLF+
		"Command: sip show peer 118"+CRLF+CRLF;
		ПанельRomAsterisk.ВыполнитьКоманду(ТекстКоманды);
		
		//отправляем команду звонка
		CRLF=Chars.CR+Chars.LF;
		ТекстКоманды="Action: Originate"+CRLF+
		//"Channel: SIP/"+ВнутреннийНомер+CRLF+
		"Channel: "+КаналИсходящегоВызова+CRLF+
		"Context: "+Контекст+CRLF+
		"Exten: "+СтрокаНабораЦифры+CRLF+
		"Priority: 1"+CRLF+
		"Callerid: "+ВнутреннийНомер+CRLF+
		"Timeout: 30000"+CRLF+CRLF;
		
		ПанельRomAsterisk.ВыполнитьКоманду(ТекстКоманды);
		
	ИначеЕсли ИспользуетсяROMHMAC Тогда
		
		Номер = СофтФон.ОставитьТолькоЦифры(ТелефонКлиента);
		Если Не ЗначениеЗаполнено(Номер) Тогда
			Состояние("Не указан номер, куда выполняется звонок");
			Возврат;
		КонецЕсли; 
		Если Не ЗначениеЗаполнено(ВнутреннийНомер) Тогда
			Состояние("Не указан внутренний номер");
			Возврат;
		КонецЕсли;
		
		ДанныеJSON=
		"{
		|'from':'"+ВнутреннийНомер+"',
		|'to':'"+Номер+"',
		|'from_orig_number':'"+Номер+"',
		|'from_orig_name':'"+Номер+"',
		|'domain_to':'"+ДоменAPI+"',
		|'from_name':'"+ВнутреннийНомер+"'
		|}";
		
		Пакет = СформироватьПакетOnPBX(ДанныеJSON, "make_call");
		ПанельRomHMac.Отправить(Пакет);
		
	ИначеЕсли ИспользуетсяSIOМегафон ИЛИ ИспользуетсяSIODomRu Тогда //++2020-08-26
		
		Номер = СофтФон.ОставитьТолькоЦифры(ТелефонКлиента);
		Если ПустаяСтрока(Номер) Тогда
			Состояние("Телефонный номер должен содержать цифры");
			Возврат;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(ВнутреннийНомер) Тогда
			Возврат;
		КонецЕсли;
		
		ДанныеJSON="{'cmd':'makeCall','phone':'"+Номер+"','user':'"+ВнутреннийЛогин_ITooLabs+"','token':'"+КлючAPI+"'}";
		Пакет=СформироватьПакетREST(ДанныеJSON,,"post","makeCall");
		ОтправитьПакетSimplitIO(Пакет);

	ИначеЕсли ИспользуетсяSIOUIS Тогда //++2020-08-26
		
		Номер = СофтФон.ОставитьТолькоЦифры(ТелефонКлиента);
		Если ПустаяСтрока(Номер) Тогда
			Состояние("Телефонный номер должен содержать цифры");
			Возврат;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(ВнутреннийНомер) Тогда
			Возврат;
		КонецЕсли;
		
		Путь = "callapi.uiscom.ru/v4.0";
		ИмяМетода = "start.employee_call";
		ДанныеJSON = "{'jsonrpc':'2.0','id':'"+ИмяМетода+"','method':'"+ИмяМетода+"','params':{'access_token':'"+КлючAPI+"','first_call':'employee','virtual_phone_number':'"+ВнутреннийВиртНомер_UIS+
		"','contact':'"+Номер+"','employee':{'id':"+ВнутреннийИД_UIS+"}}}";
		Пакет=СформироватьПакетREST(ДанныеJSON,Путь,,ИмяМетода);
		ОтправитьПакетSimplitIO(Пакет);
		
	ИначеЕсли ИспользуетсяSIOBinotel Тогда //++2020-06-29
		
		СтрокаНабораЦифры = ПодготовитьНомерДляЗвонка(ТелефонКлиента);
		Если ПустаяСтрока(СтрокаНабораЦифры) Тогда
			Состояние("Телефонный номер должен содержать цифры");
			Возврат;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(ВнутреннийНомер) Тогда
			Возврат;
		КонецЕсли;
	
		Путь="/calls/ext-to-phone.json";	
		СтрАвтоответ="";
		//Если ФлагАвтоответ Тогда
		//	СтрАвтоответ="'autoAnswer':'TRUE',";
		//КонецЕсли; 
	
		ДанныеJSON = "{"+СтрАвтоответ+"'ext_number':'"+ВнутреннийНомер+"','phone_number':'"+СтрокаНабораЦифры+"','playbackWaiting':0}";
	
		Пакет = СформироватьПакетREST(ДанныеJSON,Путь);
		ПанельRomHMac.Отправить(Пакет);
		
	ИначеЕсли ИспользуетсяSIOMango Тогда //++2021-08
		Номер = СофтФон.ОставитьТолькоЦифры(ТелефонКлиента);
		Если ПустаяСтрока(Номер) Тогда
			Состояние("Телефонный номер должен содержать цифры");
			Возврат;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(ВнутреннийНомер) Тогда
			Возврат;
		КонецЕсли;
		
		ЛинияИЗ = "";
		СтрАвтоответ=",'sip_headers':{'Call-Info/answer-after':'0'}"; //автоответ внутреннего телефона при исходящем звонке; может оставить пустым
		
		ДанныеJSON="{'command_id':'api.outgoing."+ВнутреннийНомер+"','from':{'extension':'"+ВнутреннийНомер+"','number':'"+ЛинияИЗ+"'},'to_number':'"+Номер+"'"+СтрАвтоответ+"}";
		Пакет=СформироватьПакетREST(ДанныеJSON,"commands/callback");
		ОтправитьПакетSimplitIO(Пакет);

	ИначеЕсли ИспользуетсяSIOPhonet Тогда //++2021-12		
		Путь = "/rest/user/makeCall";
		ДанныеJSON = "{'legExt':'"+ВнутреннийНомер+"','otherLegNum':'"+ТелефонКлиента+"'}";
		
		Пакет=СформироватьПакетREST(ДанныеJSON, Путь, "post");
		ОтправитьПакетSimplitIO(Пакет);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ПодготовитьНомерДляЗвонка(Знач Номер)
	
	Номер = СтрЗаменить(Номер, "+7", "8");
	ТолькоЦифры="";
	Для Индекс=1 По СтрДлина(Номер) Цикл
		Символ=Сред(Номер,Индекс,1);
		Если КодСимвола(Символ)>47 и КодСимвола(Символ)<58 Тогда
			ТолькоЦифры=ТолькоЦифры+Символ;
		КонецЕсли; 
	КонецЦикла; 
	Возврат ТолькоЦифры;

КонецФункции

	
