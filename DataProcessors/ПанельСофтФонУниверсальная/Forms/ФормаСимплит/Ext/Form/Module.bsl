&НаКлиенте
Функция СформироватьПакетREST(ДанныеJSON,Путь,Метод="post",Маркер="")

	Результат="";
	
	Если ИспользуетсяSIOМегафон ИЛИ ИспользуетсяSIODomRu Тогда
		ИмяИсточника = ИДВАТС;
		// нет ключа 
		Если Не ЗначениеЗаполнено(КлючAPI) Тогда
			Возврат Результат;
		КонецЕсли; 
		
		// нет команды
		Если Не ЗначениеЗаполнено(ДанныеJSON) Тогда
			Возврат Результат;
		КонецЕсли; 
		
		//ДоменAPI = СофтФон.ПолучитьТелефонияАдресСервера();
		БазовыйПуть=ДоменAPI+"/sys/crm_api.wcgp";
		Если Не ЗначениеЗаполнено(Путь) Тогда
			Путь=БазовыйПуть;
		КонецЕсли;
		
		Данные="";
		Если НРег(Метод)="post" Тогда
			Данные=СофтФонКлиентСервер.JSON2URL(ДанныеJSON);
		ИначеЕсли НРег(Метод)="get" Тогда
			Путь=Путь+"?"+СофтФонКлиентСервер.JSON2URL(ДанныеJSON);
		КонецЕсли; 
		
		// формирование заголовков
		ContentType="application/x-www-form-urlencoded; charset=UTF-8;";
		ДанныеЗаголовка="'Accept': 'application/json', 'Content-Type': '"+ContentType+"'";
		
		Пакет=
		"{
		|'service': '"+НРег(ИмяИсточника)+"', 
		|'data': 
		|	{
		|		'url': '"+"https://"+Путь+"',
		|		'header': {"+ДанныеЗаголовка+"}, 
		|		'method': '"+ВРег(Метод)+"',";
		
		Если ЗначениеЗаполнено(Маркер) Тогда
			Пакет=Пакет+"
			|		'marker': '"+Маркер+"',";
		КонецЕсли; 
		
		Пакет=Пакет+"
		|		'data': '"+Данные+"' 
		|	}
		|}";
		
		Результат=СофтФонКлиентСервер.Stringify(Пакет);
				
	ИначеЕсли ИспользуетсяSIOUIS Тогда
		Схема="https://";
		ИмяИсточника = "uis";
		ВерсияAPI 	= "2.0";
		//ДоменAPI 	= СофтФон.ПолучитьТелефонияАдресСервера(); //"dataapi.uiscom.ru";
		//КлючAPI 	= СофтФон.ПолучитьПарольАдминистратораАТС();
		
		// нет ключа 
		Если Не ЗначениеЗаполнено(КлючAPI) Тогда 
			Возврат Результат;
		КонецЕсли; 
		
		// нет команды
		Если Не ЗначениеЗаполнено(ДанныеJSON) Тогда
			Возврат Результат;
		КонецЕсли; 
		
		БазовыйПуть=ДоменAPI+"/v"+ВерсияAPI;
		Если Не ЗначениеЗаполнено(Путь) Тогда
			Путь=БазовыйПуть;
		КонецЕсли;
		
		Данные=ДанныеJSON;
		
		// формирование заголовков
		ContentType="application/json; charset=UTF-8;";
		ДанныеЗаголовка="'Content-Type': '"+ContentType+"'";
		
		Пакет=
		"{
		|'service': '"+НРег(ИмяИсточника)+"', 
		|'data': 
		|	{
		|		'url': '"+Схема+Путь+"',
		|		'header': {"+ДанныеЗаголовка+"}, 
		|		'method': '"+ВРег(Метод)+"',";
		
		Если ЗначениеЗаполнено(Маркер) Тогда
			Пакет=Пакет+"
			|		'marker': '"+Маркер+"',";
		КонецЕсли; 
		
		Пакет=Пакет+"
		|		'data': "+Данные+"
		|	}
		|}";
		
		Результат=СофтФонКлиентСервер.Stringify(Пакет);
		
	ИначеЕсли ИспользуетсяSIOSipuni Тогда
		
		Если Не ЗначениеЗаполнено(Путь) Тогда
			Возврат Результат;
		КонецЕсли;
		
		ДанныеЗаголовка="'Content-Type': 'application/json'";
		
		url=Схема+АдресAPI+Путь;
		data=ДанныеJSON;
		Если НРег(Метод)="get" Тогда
			url=url+"?"+СофтФонКлиентСервер.JSON2URL(ДанныеJSON);
			data="''";
		ИначеЕсли НРег(Метод)="post" Тогда
			ДанныеЗаголовка="'Content-Type': 'application/x-www-form-urlencoded'";
			data="'"+СофтФонКлиентСервер.JSON2URL(ДанныеJSON)+"'";
		КонецЕсли; 
		
		Пакет=
		"{
		|'service': '"+НРег(ИДВАТС)+"', 
		|'data': 
		|	{
		|		'url': '"+url+"',
		|		'header': {"+ДанныеЗаголовка+"}, 
		|		'method': '"+ВРег(Метод)+"',";
		
		Если ЗначениеЗаполнено(Маркер) Тогда
			Пакет=Пакет+"
			|		'marker': '"+Маркер+"',";
		КонецЕсли; 
		
		Пакет=Пакет+"
		|		'data': "+data+" 
		|	}
		|}";
		
		Результат=СофтФонКлиентСервер.Stringify(Пакет);
		
	ИначеЕсли ИспользуетсяSIOBinotel Тогда
		
		// без ключа все команды запрещены
		Если Не ЗначениеЗаполнено(КлючAPI) ИЛИ Не ЗначениеЗаполнено(ПарольAPI) Тогда
			Возврат Результат;
		КонецЕсли; 
		
		// проверка корректности переданных параметров
		Если Не ЗначениеЗаполнено(Путь) Тогда
			Возврат Результат;
		КонецЕсли;
		
		СтрокаХеширования="[]";
		Если ЗначениеЗаполнено(ДанныеJSON) Тогда
			
			СтрокаХеширования=ДанныеJSON;
			ДанныеJSONСодержимое=СтрЗаменить(ДанныеJSON,"{","");
			ДанныеJSONСодержимое=СтрЗаменить(ДанныеJSONСодержимое,"}","");
			ДанныеJSONСодержимое=","+ДанныеJSONСодержимое;
			
		КонецЕсли; 
		
		// формирование и хеширование параметров
		ДанныеMD5=MD5(ПарольAPI+СофтФонКлиентСервер.Stringify(СтрокаХеширования));
		
		ДанныеТела="{'signature':'"+ДанныеMD5+"','key':'"+КлючAPI+"'"+ДанныеJSONСодержимое+"}";
		
		// добавление заголовков
		ДанныеЗаголовка="'Content-Length': '"+СтрДлина(СофтФонКлиентСервер.Stringify(ДанныеТела))+"', 'Content-Type': 'application/json'";
		
		Пакет=
		"{
		|'service': '"+НРег(ИДВАТС)+"', 
		|'data': 
		|	{
		|		'url': '"+Схема+ДоменAPI+ВерсияAPI+Путь+"',
		|		'header': {"+ДанныеЗаголовка+"}, 
		|		'method': '"+ВРег(Метод)+"',";
		
		Если ЗначениеЗаполнено(Маркер) Тогда
			Пакет=Пакет+"
			|		'marker': '"+Маркер+"',";
		КонецЕсли; 
		
		Пакет=Пакет+"
		|		'data': "+ДанныеТела+"
		|	}
		|}";
		
		Результат=СофтФонКлиентСервер.Stringify(Пакет);
		
	ИначеЕсли ИспользуетсяSIOMango Тогда
		
		Если Не ЗначениеЗаполнено(Путь) Тогда
			Возврат Результат;
		КонецЕсли;
		
		Подпись=ПодписатьПакет_Mango(СофтФонКлиентСервер.Stringify(ДанныеJSON));
		Данные="vpbx_api_key="+КлючAPI+"&sign="+Подпись+"&json="+КодироватьДанныеПакета(СофтФонКлиентСервер.Stringify(ДанныеJSON));
		
		ДанныеЗаголовка="";
		
		url=Схема+АдресAPI+Путь;
		data=Данные;
		Если НРег(Метод)="get" Тогда
			url=url+"?"+Данные;
			data="";
		ИначеЕсли НРег(Метод)="post" Тогда
			ДанныеЗаголовка=ДанныеЗаголовка+"'Content-Type': 'application/x-www-form-urlencoded'";
		КонецЕсли; 
		
		Пакет=
		"{
		|'service': 'mango', 
		|'data': 
		|	{
		|		'url': '"+url+"',
		|		'header': {"+ДанныеЗаголовка+"}, 
		|		'method': '"+ВРег(Метод)+"',";
		
		Если ЗначениеЗаполнено(Маркер) Тогда
			Пакет=Пакет+"
			|		'marker': '"+Маркер+"',";
		КонецЕсли; 
		
		Пакет=Пакет+"
		|		'data': '"+Данные+"' 
		|	}
		|}";
		
		Результат=СофтФонКлиентСервер.Stringify(Пакет);
		
	ИначеЕсли ИспользуетсяSIOPhonet Тогда
		
		Результат="";
		
		// проверка корректности переданных параметров
		Если Не ЗначениеЗаполнено(Путь) Тогда
			//Если Отладка Тогда
			//	Сообщить("Не указан путь REST-запроса");
			//КонецЕсли; 
			Возврат Результат;
		КонецЕсли;
		
		// без ключа все команды запрещены
		Если Не ЗначениеЗаполнено(КлючСессии) И Путь<>"/rest/security/authorize" Тогда
			//Если Отладка Тогда
			//	Сообщить("Отсутствует ключ сессии");
			//КонецЕсли; 
			Возврат Результат;
		КонецЕсли; 
		
		// формирование заголовков
		ДанныеЗаголовка="'Content-Type':'application/json'";
		Если ЗначениеЗаполнено(КлючСессии) Тогда
			ДанныеЗаголовка=ДанныеЗаголовка+",'Cookie':'"+КлючСессии+"'";
		КонецЕсли; 
		
		ДанныеТела="''";
		Если ЗначениеЗаполнено(ДанныеJSON) Тогда
			ДанныеТела=ДанныеJSON;
		КонецЕсли;
		
		Если НРег(Метод)="get" Тогда
			Если ЗначениеЗаполнено(ДанныеJSON) Тогда
				Путь=Путь+"?"+СофтФонКлиентСервер.JSON2URL(СофтФонКлиентСервер.Stringify(ДанныеJSON));
			КонецЕсли; 
		КонецЕсли; 
		
		Пакет=
		"{
		|'service': 'phonet', 
		|'data': 
		|	{
		|		'url': '"+Схема+ДоменAPI+Путь+"',
		|		'header': {"+ДанныеЗаголовка+"}, 
		|		'method': '"+ВРег(Метод)+"',";
		
		Если ЗначениеЗаполнено(Маркер) Тогда
			Пакет=Пакет+"
			|		'marker': '"+Маркер+"',";
		КонецЕсли; 
		
		Пакет=Пакет+"
		|		'data': "+ДанныеТела+"
		|	}
		|}";
		
		Результат=СофтФонКлиентСервер.Stringify(Пакет);
		
	ИначеЕсли ИспользуетсяROMHMAC Тогда
		
		Схема="https://";
		
		Если Не ЗначениеЗаполнено(Путь) Тогда 
			Возврат Результат;
		КонецЕсли;
		
		// без ключа все команды кроме auth запрещены
		Если Не ЗначениеЗаполнено(КлючСессии) И Путь<>"auth.json" Тогда 
			Возврат Результат;
		КонецЕсли; 
		
		БазовыйПуть="api2.onlinepbx.ru/"+АдресАТС+"/"; //2021-07-21 изменено на api2 с api 
		
		Данные=СофтФонКлиентСервер.JSON2URL(ДанныеJSON);
		
		// формирование заголовков
		ContentType="application/x-www-form-urlencoded; charset=UTF-8;";
		ДанныеЗаголовка="'Accept': 'application/json', 'Content-Type': '"+ContentType+"'";
		
		Если ЗначениеЗаполнено(КлючСессии) Тогда
			
			ДатаEET=Формат(ПолучитьДатуGMT(),"ДФ='yyyy-MM-dd ЧЧ:мм:сс'");
			ДанныеMD5=MD5(Данные);
			ЗаголовокURL=БазовыйПуть+Путь;
			
			//LF=Chars.LF;
			//СтрХеширования=ВРег(Метод)+LF+ДанныеMD5+LF+ContentType+LF+ДатаEET+LF+ЗаголовокURL+LF;
			
			//ПодписьHex=ПанельSimplitРасчетХэш.ХешСумма(КлючСессии,СтрХеширования);
			//КлючBase64=Base64ИзСтроки(ПодписьHex);
			
			//2021-07-21 изменено на КлючСессии с КлючBase64
			//ДанныеЗаголовка="'x-pbx-date': '"+ДатаEET+"', "+ДанныеЗаголовка+
			//", 'Content-MD5': '"+ДанныеMD5+"', 'x-pbx-authentication': '"+КлючИД+":"+КлючBase64+"'";  
			ДанныеЗаголовка="'x-pbx-date': '"+ДатаEET+"', "+ДанныеЗаголовка+
			", 'Content-MD5': '"+ДанныеMD5+"', 'x-pbx-authentication': '"+КлючИД+":"+КлючСессии+"'"; 
			
		КонецЕсли; 
		
		Пакет=
		"{
		|'service': 'onpbx-rest', 
		|'data': 
		|	{
		|		'url': '"+Схема+БазовыйПуть+Путь+"',
		|		'header': {"+ДанныеЗаголовка+"}, 
		|		'method': '"+ВРег(Метод)+"',";
		
		Если ЗначениеЗаполнено(Маркер) Тогда
			Пакет=Пакет+"
			|		'marker': '"+Маркер+"',";
		КонецЕсли; 
		
		Пакет=Пакет+"
		|		'data': '"+Данные+"' 
		|	}
		|}";
		
		Результат=СофтФонКлиентСервер.Stringify(Пакет);
		
	Иначе
		//
	КонецЕсли;
	
	Возврат Результат;

КонецФункции

&НаКлиенте
Функция СформироватьПакетOnPBX(ДанныеJSON,Команда,Метод="command")

	// проверка корректности переданных параметров
	Результат="";
	Если Не ЗначениеЗаполнено(Команда) Тогда
		Сообщить("Не указана команда Realtime-запроса");
		Возврат Результат;
	КонецЕсли;
	
	Данные=СофтФонКлиентСервер.Stringify(ДанныеJSON);

	Пакет=
	"{
	|'service': 'onpbx', 
	|'data': 
	|	{
	|		'header': '"+Команда+"', 
	|		'method': '"+Метод+"', 
	|		'data': "+Данные+"
	|	}
	|}";
	
	Результат=СофтФонКлиентСервер.Stringify(Пакет);
	
	Возврат Результат;

КонецФункции

