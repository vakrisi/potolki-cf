			//Состояние="Завершен";
			//ЗакрытьФормуОповещения();
			//НажатьКнопкуЗаписи(Ложь);
		КонецЕсли; 
	КонецЕсли; 
	
	//ТекущиеЗвонки.Удалить(СтрТекущиеЗвонки);
	
