Процедура ПодключитьПанель_SimplitХэш()
	
	ПанельSimplitРасчетХэш = Неопределено;
	ИмяМакетаБиблиотеки = "ROM_HMAC_ZIP";
	ИмяИсточникаСобытий = "OnPBXHMAC";
	
	Результат = Ложь;
	
	// попытка установить компоненту
	Результат=ПодключитьВнешнююКомпоненту("ОбщийМакет."+ИмяМакетаБиблиотеки,ИмяИсточникаСобытий,ТипВнешнейКомпоненты.Native);
	
	Если Не Результат Тогда
		// неудачно, возможно еще не устанавлена
		УстановитьВнешнююКомпоненту("ОбщийМакет."+ИмяМакетаБиблиотеки);
		Результат=ПодключитьВнешнююКомпоненту("ОбщийМакет."+ИмяМакетаБиблиотеки,ИмяИсточникаСобытий,ТипВнешнейКомпоненты.Native);
	КонецЕсли; 
	
	Если Результат Тогда
		Попытка
			ПанельSimplitРасчетХэш=Новый("AddIn.OnPBXHMAC.ROM_HMAC");
		Исключение
			Сообщить(ОписаниеОшибки());
		КонецПопытки; 
	Иначе
		Сообщить("Не удалось установить компоненту для SimplitХэш");
	КонецЕсли; 

	
КонецПроцедуры

