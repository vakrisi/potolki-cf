	ИначеЕсли ВРег(ВидСобытия) = "HANGUP" Тогда	
		
		//Разорвал канал - положили трубку или разговор окончен - закрываем окно входящего звонка
		CallerIDNum = ДанныеСобытия.Получить("CallerIDNum");
