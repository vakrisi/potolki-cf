// ОбработчикиСобытийформы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Доступен = ОбщийМодуль.РасширенныйФункционалДоступен();
	Если НЕ Доступен тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	ИнтервалПроверкиПодключенияКАТС = Константы.ИнтервалПроверкиПодключенияКАТС.Получить();
	ИнтервалАвтоподключения = 30;
	
	ВерсияИсторииАТС = Константы.УДАЛИТЬ_ВерсияИсторииАТС.Получить();

	ИспользуетсяROMHMAC 	= СофтФон.ИспользуетсяROMHMAC();
	ИспользуетсяROMAsterisk = СофтФон.ИспользуетсяROMAsterisk();
	ИспользуетсяSIOМегафон 	= СофтФон.ИспользуетсяМегафон();
	ИспользуетсяSIOUIS 		= СофтФон.ИспользуетсяUIS();
	ИспользуетсяSIODomRu 	= СофтФон.ИспользуетсяDomRu();
	ИспользуетсяSIOSipuni 	= СофтФон.ИспользуетсяSipuni();
	ИспользуетсяSIOBinotel 	= СофтФон.ИспользуетсяBinotel(); //++2020-06-29
	ИспользуетсяSIOMango    = СофтФон.ИспользуетсяMango(); //++2021-08
	ИспользуетсяSIOPhonet   = СофтФон.ИспользуетсяPhonet(); //++2021-12

	Если ИспользуетсяSIOМегафон Тогда
		ИДВАТС = "megafon";
	ИначеЕсли ИспользуетсяSIOUIS Тогда
		ИДВАТС = "uis";
	ИначеЕсли ИспользуетсяSIODomRu Тогда
		ИДВАТС = "domru";
	ИначеЕсли ИспользуетсяROMAsterisk Тогда
		ИДВАТС = "asterisk";
	ИначеЕсли ИспользуетсяSIOSipuni Тогда
		ИДВАТС = "sipuni";
	ИначеЕсли ИспользуетсяSIOBinotel Тогда
		ИДВАТС = "binotel";
		ВерсияAPI="2.0";
	ИначеЕсли ИспользуетсяSIOMango Тогда
		ИДВАТС = "mango";
	ИначеЕсли ИспользуетсяSIOPhonet Тогда
		ИДВАТС = "phonet";
	КонецЕсли;
	
	ВнутреннийНомер = СофтФон.ПолучитьВнутреннийНомерПользователя();
	ЛогинТелефонии  = СофтФон.ПолучитьЛогинТелефонииПользователя();
	
	Схема="https://";
	КлючAPI  = СофтФон.ПолучитьПарольАдминистратораАТС();
	ДоменAPI = СофтФон.ПолучитьТелефонияАдресСервера();
	АдресAPI = ДоменAPI; // используется: sipuni, mango
	Если ИспользуетсяSIOSipuni Тогда
		АдресAPI = ДоменAPI+"/api";		
	КонецЕсли;
	КлючWSS  = СофтФон.ПолучитьКлючWSS(); // используется: sipuni
	НомерВАТС= СофтФон.ПолучитьНомерВАТС(); // используется: sipuni
	ПарольAPI= СофтФон.ПолучитьПарольAPI(); // используется: binotel
	КлючДляПодписи = СофтФон.ПолучитьКлючДляПодписи(); // используется: mango
	
	ЛогинSimplit = СофтФон.ПолучитьЛогинSimplit();
	ПарольSimplit = СофтФон.ПолучитьПарольSimplit();
	
	Вариант53_Asterisk   = (ВариантНастроекТелефонии_Asterisk() = ПредопределенноеЗначение("Справочник.ВариантыНастроекТелефонии.Вариант_53"));
	Вариант85_Asterisk   = (ВариантНастроекТелефонии_Asterisk() = ПредопределенноеЗначение("Справочник.ВариантыНастроекТелефонии.Вариант_85"));
	Вариант85_2_Asterisk = (ВариантНастроекТелефонии_Asterisk() = ПредопределенноеЗначение("Справочник.ВариантыНастроекТелефонии.Вариант_85_2"));
	Вариант93_Asterisk   = (ВариантНастроекТелефонии_Asterisk() = ПредопределенноеЗначение("Справочник.ВариантыНастроекТелефонии.Вариант_93"));
	Вариант296_Asterisk  = (ВариантНастроекТелефонии_Asterisk() = ПредопределенноеЗначение("Справочник.ВариантыНастроекТелефонии.Вариант_296"));
	Вариант93_1_Asterisk   	= (ВариантНастроекТелефонии_Asterisk() = ПредопределенноеЗначение("Справочник.ВариантыНастроекТелефонии.Вариант_93_1"));
	
	//#10674
	ТекущийПользователь = Пользователи.ТекущийПользователь();
	КаналИсходящегоВызова = ОбщийМодульСервер.НастройкаПользователя("КаналИсходящегоВызова", ТекущийПользователь);
	КаналИсходящегоВызова = ?(ПустаяСтрока(КаналИсходящегоВызова), "SIP/"+ВнутреннийНомер, КаналИсходящегоВызова);
	
КонецПроцедуры

&НаСервере
Функция ПараметрыСеансаТелефонияСтрана()
	Возврат ПараметрыСеанса.ТелефонияСтрана;
КонецФункции

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если СофтФон.ТекущемуПользователюРазрешеноИспользованиеIPТелефонии() Тогда
		Подключиться(Неопределено);
		ИнтервалЗапросаИсторииЗвонков = ИнтервалЗапросаИсторииЗвонков();
		Если ИнтервалЗапросаИсторииЗвонков > 0 Тогда
			ПодключитьОбработчикОжидания("АвтоматическиЗапроситьИсториюЗвонков",1,Истина); //запустить прямо сейчас
			ПодключитьОбработчикОжидания("АвтоматическиЗапроситьИсториюЗвонков",ИнтервалЗапросаИсторииЗвонков,Ложь); //запускать периодическии
		КонецЕсли;
	КонецЕсли;
	
	Если ИспользуетсяSIOBinotel Тогда
		ИнициализироватьИнфоОшибок_Binotel();
		УчастникиГруппы = Новый Массив;
	ИначеЕсли ИспользуетсяSIOMango Тогда	
		ИнициализироватьОписаниеКода_Mango();
	ИначеЕсли ИспользуетсяSIOPhonet Тогда
		ИнициализироватьИнфоОшибок_Phonet();
		ИнициализироватьСтатусы_Phonet();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, СтандартнаяОбработка)
	Если ПанельRomHMac<>Неопределено Тогда
		Если ПанельRomHMac.Подключено Тогда
			ПанельRomHMac.Отключиться();
		КонецЕсли; 
	КонецЕсли; 
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии()
	ПанельRomAsterisk = Неопределено;
	ПанельRomHMac = Неопределено;
КонецПроцедуры

&НаКлиенте
Процедура ВнешнееСобытие(Источник, Событие, Данные)
	
	ДанныеСобытия=СофтФон.ДанныеВСоответствие(Данные);
	СтрокаЛога = "Источник="+Источник+". Событие="+Событие+". Данные="+Данные;
	
	ЗаписатьСобытиеВЛог(СокрЛП(ДанныеСобытия.Получить("Event")),СтрокаЛога, Данные);
	
	Если Источник = "SoftPhone" Тогда
		//СОБЫТИЕ Рарус-СофтФон 3.0 //////////////////////////////////////////////
		
		МассивСоответствия = UnJSON(ЗаменитьНедопустимыеСимволыXML(Данные));
		Если МассивСоответствия = Неопределено Тогда
			Возврат;
		ИначеЕсли НЕ (ТипЗнч(МассивСоответствия)  = Тип("Соответствие")) Тогда
			Возврат;
		ИначеЕсли МассивСоответствия.Количество() = 0 Тогда
			Возврат;
		КонецЕсли;
		СтруктураДанных = Новый Структура();
		Для Каждого ЭлементМассива Из МассивСоответствия Цикл
			СтруктураДанных.Вставить(ЭлементМассива.Ключ, ЭлементМассива.Значение); 
		КонецЦикла;
		
		Если Событие = "OnCallInfoEx" Тогда
			Если СтруктураДанных.State = 5 и НЕ СокрЛП(СтруктураДанных.CallerID) = СокрЛП(ВнутреннийНомер) Тогда
				//входящий звонок текущему пользователю
				
				Если ПользовательПринимаетВходящиеЗвонки() Тогда
					СтруктураНовойФормы = Новый Структура;
					СтруктураНовойФормы.Вставить("НомерАбонента",СофтФон.ПолучитьНомерТелефонаВМеждународномФОрматеПользователя(СтруктураДанных.CallerID));
					СтруктураНовойФормы.Вставить("ВнешняяЛиния",СтруктураДанных.CalledId);
					СтруктураНовойФормы.Вставить("НашВнутреннийНомер",ВнутреннийНомер);
					ОткрытьФорму("ОбщаяФорма.ФормаВходящийЗвонок",СтруктураНовойФормы,,СтруктураДанных.CallerID,ВариантОткрытияОкна.ОтдельноеОкно,,,);
				КонецЕсли;
				
			КонецЕсли;
		ИначеЕсли  Событие = "PutSettingsJSON" Тогда	
			//
		ИначеЕсли  Событие = "OnEvent" Тогда
			//
		ИначеЕсли  Событие = "OnEventData" Тогда
			//
		ИначеЕсли  Событие = "OnAllLinesInfo" Тогда
			//
		ИначеЕсли  Событие = "OnLinesStatus" Тогда	
			//
		ИначеЕсли  Событие = "OnRecordInfo" Тогда	
			//
		ИначеЕсли  Событие = "OnResultInfo" Тогда
			//
		ИначеЕсли  Событие = "OnCallInfoCoMagic" Тогда
			//
		КонецЕсли;

	
	ИначеЕсли Источник = "ROM-Asterisk-Native" Тогда
		//СОБЫТИЕ АСТЕРИСК //////////////////////////////////////////////
		
		//Вариант получения событий:
		//1. Пишется под каждого клиента (в зависимости от очереди, от настрое к и т.д. в ряде случаев подходит то что уже делали
		//
		//Вариант получения истории:
		//1. в таблице используется filename (формат свой) 
		//1462348401.7930-2016-05-04-10_53-201-89178797700.mp3
		//2. в таблице используется recordingfile (формат свой) in-435405-89878631473-20171022-161042-1508670642.4457.wav
		//
		//Вариант получения записи звонка:
		//1. по ссылке dl.php?BASE64. Указать каталог размещения сайта. Все функции поиска и отдачи файла выполняет веб сервер, со стороны клиента ОС ведет себя как обычное открытие/скачивание файлв.
		//2. ftp - если исп. 2 вариант выше берем из поля cdrdate, YY\MM\DD. FTP и FTPs (не sFTP) реализовать нет проблем 
		//3. samba - если исп. 2 вариант выше берем из поля cdrdate, YY\MM\DD. Авторизация? если нет доступа к сетевой папке, 1с при прослушивании не запросит авторизацию, пользователю нужно будет зайти в папки виндовыми средствами и открыть папку.
		//4. по другой ссылке http запрос либо получать ссылку на файл или в двоичном виде
		//необходимо разрабатывать api на сервере и отправку/прием в 1с
		//		
		//Имя поля записи [filename, recordingfile]
		//Вариант доступа к записям. Выбор из вариантов: "DL.php, Ftp-сервер, samba, http-запрос"
		//
		//когда Вариант доступа к записям = DL.php
		//должна быть настройка начального каталога
		//
		//Ftp-сервер, samba
		//хост, порт, логин, пароль, начальный каталог, формат иерархии папок 
		//
		//http-запрос
		//url,запросом отправляем имя файла, в ответ получаем двоичные данные записи звонка
		
		Если Событие="Disconnect" Тогда
						
			ПодключенКАТС = Ложь;
			УстановитьСтатусПользовательПодключен(ПодключенКАТС);
			//Подключиться(Неопределено); //пробуем переподключиться //пока убрана, т.к. в случае обрыва связи с АТС 1с наглухо зависает в попытках подключиться
			//#13668			
			ПодключитьОбработчикОжидания("ПодключитьсяКСерверуAsterisk", ИнтервалАвтоПодключения, Ложь);
			Возврат;
			
		ИначеЕсли ВРег(СокрЛП(ДанныеСобытия.Получить("Response"))) = "FOLLOWS" Тогда
			
			//идет запрос состояния подключения телефона (программнорго ил иаппаратного) к АТС
			ПакетДанных = ДанныеСобытия.Получить("Пакет");
			
			МассивЗначений = СтрРазделить(ПакетДанных, Символы.ПС);
			Для Ном = 0 По МассивЗначений.Количество()-1 Цикл
				Если СтрНайти(МассивЗначений[Ном], "Status") > 0 Тогда
					Если СтрНайти(ВРег(МассивЗначений[Ном]), "UNKNOWN") > 0 Тогда
						ПоказатьОповещениеПользователя("Для работы с ip-телефонией" + Символы.ПС + "следует подключить программный " + Символы.ПС + "или аппаратный телефон к АТС");
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
			
		Иначе
			
			//отрабатываем событие в зависимости от вариантов настроек
			ВидСобытия=ВРег(СокрЛП(ДанныеСобытия.Получить("Event")));                                 
			//Если ВРег(ВидСобытия)="DIALBEGIN" ИЛИ ВРег(ВидСобытия)="NEWCHANNEL" ИЛИ ВРег(ВидСобытия)="AGENTCALLED" Тогда
				
				Если Вариант53_Asterisk Тогда
					//вариант 53
					Вариант_53_Asterisk(ВидСобытия, ДанныеСобытия)
				ИначеЕсли Вариант85_Asterisk Тогда
					//вариант 85
					Вариант_85_Asterisk(ВидСобытия, ДанныеСобытия)
				ИначеЕсли Вариант85_2_Asterisk Тогда
					//вариант 85 (очереди)
					Вариант_85_2_Asterisk(ВидСобытия, ДанныеСобытия)
				ИначеЕсли Вариант93_Asterisk Тогда
					//вариант 93
					ОбработкаСобытий_Вариант_93_Asterisk(ВидСобытия, ДанныеСобытия);
				ИначеЕсли Вариант296_Asterisk Тогда
					//вариант 296
					ОбработкаСобытий_Вариант_296_Asterisk(ВидСобытия, ДанныеСобытия);
				ИначеЕсли Вариант93_1_Asterisk Тогда
					//вариант 93.1
					ОбработкаСобытий_Вариант_93_1_Asterisk(ВидСобытия, ДанныеСобытия);
				Иначе
					//неизвестный вариант. не реагируем 
				КонецЕсли;
			//КонецЕсли;
			
		КонецЕсли;
	
	ИначеЕсли Источник="SimplitIO-WS.OnPBX" 
		ИЛИ Источник="SimplitIO-WS.megafon" ИЛИ Источник="SimplitIO-WS.domru"
		ИЛИ Источник="SimplitIO-WS.uis" 
		ИЛИ Источник="SimplitIO-WS.sipuni" 
		ИЛИ Источник="SimplitIO-WS.binotel"
		ИЛИ Источник="SimplitIO-WS.mango"
		ИЛИ Источник="SimplitIO-WS.phonet"
		Тогда
		//СОБЫТИЕ SimplitIO ///////////////////////////////////////////
		
		Если Данные="{""Connection"": ""Close""}" ИЛИ Данные="{""Connection"": ""Fail""}" Тогда
			
			ПодключенКАТС = Ложь;
			//пытаемся переподключиться
			ПодключитьсяКАТС();
			
		ИначеЕсли Данные="{""Connection"": ""Open""}" Тогда
			
			ПодключенКАТС = Истина;			
			
		КонецЕсли;
		
		Если Событие="{""Event"": ""Message""}" Тогда
			//обработка событий различается в части разбора JSON (структура или соответствие)
			Если Источник="SimplitIO-WS.OnPBX" Тогда
 				ОбработкаСобытийСервераSimplitOnPbx(Источник, Данные);
			Иначе
				ОбработкаСобытийСервераSimplitOther(Источник, Данные);
			КонецЕсли;
		КонецЕсли; 
		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	// событие по кнопкам Скачать / Прослушать для OnPbx (Журнал звонков, форма контрагента, форма лида, форма списка истории АТС)
	Если ИмяСобытия = "ПолучитьСсылкуНаЗаписьOnPbxОткрыть"
		ИЛИ ИмяСобытия = "ПолучитьСсылкуНаЗаписьOnPbxСкачать" Тогда
		
		//ЗагружатьЗаписьOnPbx = (ИмяСобытия = "ПолучитьСсылкуНаЗаписьOnPbxСЗагрузкой");
		Если ИмяСобытия = "ПолучитьСсылкуНаЗаписьOnPbxОткрыть" Тогда
			РежимЗагрузкиЗаписиOnPbx = 0;
		Иначе
			Запустить = Параметр.Свойство("ЗапуститьПослеСкачивания") И Параметр.ЗапуститьПослеСкачивания;
			Если НЕ Запустить Тогда
				РежимЗагрузкиЗаписиOnPbx = 1;
			Иначе
				РежимЗагрузкиЗаписиOnPbx = 2;
			КонецЕсли;
		КонецЕсли;
		
		ИД = Параметр.ИДЗвонка;
		КаталогЗаписи = Параметр.Каталог;
		
		Маркер = "";

		Путь="history/search.json";
		Если ВерсияИсторииАТС = 1 Тогда
			Путь="mongo_history/search.json";
		КонецЕсли;
		
		ДанныеJSON="{'uuid':'"+ИД+"','download':true}";		
		
		Пакет = СформироватьПакетREST(ДанныеJSON, Путь, , Маркер);
		ПанельRomHMac.Отправить(Пакет);
		
	ИначеЕсли ИмяСобытия = "ПолучитьСсылкуНаЗаписьBinotelОткрыть"
		ИЛИ ИмяСобытия = "ПолучитьСсылкуНаЗаписьBinotelСкачать" Тогда
		
		//ЗагружатьЗаписьBinotel = (ИмяСобытия = "ПолучитьСсылкуНаЗаписьBinotelСЗагрузкой");
		Если ИмяСобытия = "ПолучитьСсылкуНаЗаписьBinotelОткрыть" Тогда
			РежимЗагрузкиЗаписиBinotel = 0;
		Иначе
			Запустить = Параметр.Свойство("ЗапуститьПослеСкачивания") И Параметр.ЗапуститьПослеСкачивания;
			Если НЕ Запустить Тогда
				РежимЗагрузкиЗаписиBinotel = 1;
			Иначе
				РежимЗагрузкиЗаписиBinotel = 2;
			КонецЕсли;
		КонецЕсли;
		
		ИДЗаписи = Параметр.ИДЗвонка;
		КаталогЗаписи = Параметр.Каталог;
		Маркер = "";

		Путь="/stats/call-record.json";
		ДанныеJSON="{'callID':["+ИДЗаписи+"]}";	
		
		Пакет = СформироватьПакетREST(ДанныеJSON, Путь, , Маркер);
		ОтправитьПакетSimplitIO(Пакет);
		
	ИначеЕсли ИмяСобытия = "ПолучитьСсылкуНаЗаписьMangoОткрыть"
		ИЛИ ИмяСобытия = "ПолучитьСсылкуНаЗаписьMangoСкачать" Тогда
		
		Если ИмяСобытия = "ПолучитьСсылкуНаЗаписьMangoОткрыть" Тогда
			РежимЗагрузкиЗаписиMango = 0;
		Иначе
			Запустить = Параметр.Свойство("ЗапуститьПослеСкачивания") И Параметр.ЗапуститьПослеСкачивания;
			Если НЕ Запустить Тогда
				РежимЗагрузкиЗаписиMango = 1;
			Иначе
				РежимЗагрузкиЗаписиMango = 2;
			КонецЕсли;
		КонецЕсли;
		
		ИДЗаписи = Параметр.ФайлЗаписиСсылка;
		КаталогЗаписи = Параметр.Каталог;
		Маркер = "";
		Команда = ?(ИмяСобытия = "ПолучитьСсылкуНаЗаписьMangoСкачать", "download", "play");
		Путь="queries/recording/post";
		ДанныеJSON = "{'recording_id':'"+ИДЗаписи+"','action':'"+Команда+"'}";	
		
		Маркер="record-request."+Команда+"." + ИДЗаписи;
		
		Пакет = СформироватьПакетREST(ДанныеJSON, Путь, "post", Маркер);
		ОтправитьПакетSimplitIO(Пакет);
		
	// событие с Журнала звонков по кнопке ПолучитьИсториюИзАТСВручную
	ИначеЕсли ИмяСобытия = "ПолучитьИсториюИзАТСВручную" Тогда
		ПолучитьИсторию(Параметр.ДатаНачала, Параметр.ДатаОкончания);
		
	ИначеЕсли ИмяСобытия = "ВыполнитьИсходящийЗвонок" Тогда
		ВыполнитьИсходящийЗвонок(Параметр.ТелефонКлиента, Параметр.ИмяКлиента);
		
	КонецЕсли;

КонецПроцедуры

