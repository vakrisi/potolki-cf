&НаКлиенте
Функция ПодключитьПанель_Sipuni()
	
	ПанельRomHMac = Неопределено;
	ИмяМакетаБиблиотеки = "SIO_WS_ZIP";
	ИмяИсточникаСобытий = "sipuni";
	
	// попытка установить компоненту
	Результат=ПодключитьВнешнююКомпоненту("ОбщийМакет."+ИмяМакетаБиблиотеки,ИмяИсточникаСобытий,ТипВнешнейКомпоненты.Native);
	
	Если Не Результат Тогда
		
		// неудачно, возможно еще не устанавлена
		УстановитьВнешнююКомпоненту("ОбщийМакет."+ИмяМакетаБиблиотеки);
		Результат=ПодключитьВнешнююКомпоненту("ОбщийМакет."+ИмяМакетаБиблиотеки,ИмяИсточникаСобытий,ТипВнешнейКомпоненты.Native);
		
	КонецЕсли; 
	
	
	Если Результат Тогда
		ПанельRomHMac=Новый("AddIn."+ИмяИсточникаСобытий+".SimplitIO-WS");
		ПанельRomHMac.ИсточникСобытия=ИмяИсточникаСобытий;
		//ПанельRomHMac.РегулярноеВыражение=СофтФонКлиентСервер.Stringify("'service':'(simplit.io|"+ИмяИсточникаСобытий+")'");
		ПанельRomHMac.РегулярноеВыражение=СофтФонКлиентСервер.Stringify("'service':'(simplit.io|"+НРег(ИмяИсточникаСобытий)+"|"+НРег(ИмяИсточникаСобытий)+"-wss)'");
	КонецЕсли; 
	
	ПодключенКАТС=ПанельRomHMac.Подключено;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция СоединитьсяWSS()

	Если Не ЗначениеЗаполнено(КлючWSS) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ДанныеJSON="{'key':'"+КлючWSS+"'}";
	Пакет=СформироватьПакетWSS(ДанныеJSON,"connect");
 
	ПанельRomHMac.Отправить(Пакет);

КонецФункции

&НаКлиенте
Функция ПолучитьСписокОператоров_Sipuni()

	Если Не ЗначениеЗаполнено(НомерВАТС) Тогда
		Возврат Ложь;
	КонецЕсли; 
	
	Хеш=MD5(НомерВАТС+"+"+КлючAPI);
	ДанныеJSON="{'hash':'"+Хеш+"','user':'"+НомерВАТС+"'}";
	
	Пакет=СформироватьПакетREST(ДанныеJSON,"/states","post");
	
	ПанельRomHMac.Отправить(Пакет);

КонецФункции

&НаКлиенте
Функция ОбработкаСобытийSipuni(Событие,Данные,Маркер="",ИДОтвета="", Сервис)

	Если Сервис="sipuni" Тогда
		
		//обработка событий REST API
		Если Найти(Событие,"://api.simplit.io/"+ЛогинSimplit+"/sipuni")>0 Тогда
		
			// webhooks
			ОбработкаСобытийWebhooks(Событие,Данные,ИДОтвета);
		
		ИначеЕсли Найти(Событие,Схема+АдресAPI)>0 Тогда
			
			// ответы API Sipuni на команды пользователя
			// все ответы приходят в формате JSON, за исключением статистики - она приходит в формате CSV
			
			Если Событие=Схема+АдресAPI+"/statistic/export" Тогда
				ДанныеПакета=Base64Раскодировать(Данные);
				ОбработкаИсторияАТСSipuni(ДанныеПакета,Маркер);
			Иначе
				// ОбработкаОтветаНаКоманду и ОбработкаВнутренниеНомера
				//ОбработкаСобытийREST(Событие,Данные,Маркер);
			КонецЕсли; 
			
		Иначе
			
			// неизвестно
			//Если Отладка Тогда
			//	ДанныеПакета=Base64Раскодировать(Данные);
			//	Сообщить(ДанныеПакета);
			//КонецЕсли; 
			
		КонецЕсли; 
		
	ИначеЕсли Сервис="sipuni-wss" Тогда
		ОбработкаСобытийWSS_Sipuni(Событие,Данные,Маркер);
	КонецЕсли;
	
КонецФункции

&НаСервере
Процедура ОбработкаИсторияАТСSipuniНаСервере(Данные, Маркер="")
		
	МассивПараметров = Новый Массив;
	
	СтруктПараметры = Новый Структура;
	СтруктПараметры.Вставить("ВидАТС", ИДВАТС);
	СтруктПараметры.Вставить("ДатаЗапросаИстории", ТекущаяДатаСеанса());
	СтруктПараметры.Вставить("Данные", Данные);
	СтруктПараметры.Вставить("НомерВАТС", НомерВАТС);
	СтруктПараметры.Вставить("ДоменAPI", ДоменAPI);
	СтруктПараметры.Вставить("КлючAPI", КлючAPI);
		
	МассивПараметров.Добавить(СтруктПараметры);
	
	ФоновыеЗадания.Выполнить("СофтФон.ОбработкаИсторииЗвонковАТС", МассивПараметров, , "Обработка истории звонков АТС");
	
