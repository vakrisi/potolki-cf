&НаКлиенте
Функция ОбработкаИсторияАТС_Phonet(ДанныеСобытия, Маркер="")

	Если НЕ ЗначениеЗаполнено(ДанныеСобытия) Тогда
		Возврат Ложь;		
	КонецЕсли;
	
	Данные = ДанныеСобытия; //СофтФонКлиентСервер.ПолучитьДанныеJSON(ДанныеСобытия, Истина);
	
	Если Не ТипЗнч(Данные)=Тип("Массив") Тогда
