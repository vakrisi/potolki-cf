Функция ПолучитьСписокЛиний_Mango()

	ДанныеJSON="{}";	
	Пакет=СформироватьПакетREST(ДанныеJSON,"incominglines");	
	ОтправитьПакетSimplitIO(Пакет);

КонецФункции

&НаСервере
Функция ПодписатьПакет_Mango(JSONПакет)
	
	//sign = sha256(vpbx_api_key + json + vpbx_api_salt). 
	
	Хеш = Новый ХешированиеДанных(ХешФункция.SHA256);
	Хеш.Добавить(КлючAPI+JSONПакет+КлючДляПодписи);
	
	ДвДанныеСумма=Хеш.ХешСумма;
	СтрПодпись=НРег(Строка(ДвДанныеСумма));
	СтрПодпись=СтрЗаменить(СтрПодпись," ","");
	Возврат СтрПодпись;
	
КонецФункции

&НаКлиенте
Функция ОбработкаСобытийMango(Событие, Данные, Маркер="", ИДОтвета="")

	Если Найти(Событие,Схема+"api.simplit.io"+"/"+ЛогинSimplit+"/mango/") > 0 Тогда
	
		// webhooks
		ОбработкаСобытийХуков_Mango(Событие,Данные,ИДОтвета);
	
	ИначеЕсли Найти(Событие,Схема+АдресAPI)>0 Тогда
		
		// ответы API Mango на команды пользователя
		// все ответы приходят в формате JSON, за исключением статистики - она приходит в формате CSV
		
		Если Событие=Схема+АдресAPI+"stats/result" Тогда
			ДанныеПакета = Base64Раскодировать(Данные);
			ОбработкаИсторияАТС_Mango(ДанныеПакета, Маркер);
		Иначе
			ОбработкаСобытийREST_Mango(Событие,Данные,Маркер);
		КонецЕсли; 
		
	Иначе		
		// неизвестно
		ДанныеПакета=Base64Раскодировать(Данные);
		Сообщить(ДанныеПакета); 
		
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Функция ОбработкаСобытийХуков_Mango(СобытиеПакета,ДанныеПакета,ИД)

	БазовыйПуть=Схема+"api.simplit.io/"+ЛогинSimplit+"/mango/";
	Событие=СтрЗаменить(СобытиеПакета,БазовыйПуть,"");
	
	ДанныеСобытия=Base64Раскодировать(ДанныеПакета);
	Данные=СофтФонКлиентСервер.URL2JSON(ДанныеСобытия,Истина);
	
	// json не прошел валидацию
	Если Не ЗначениеЗаполнено(Данные) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	СодержимоеПакета=Данные.Получить("json");
	Если СодержимоеПакета=Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если Событие="events/call" Тогда
		
		Если Не ТипЗнч(СодержимоеПакета)=Тип("Соответствие") Тогда
			Возврат Ложь;
		КонецЕсли; 
		
		ТипСобытияЗвонка=СодержимоеПакета.Получить("call_state");
		Если ТипСобытияЗвонка=Неопределено Тогда
			Возврат Ложь;
		КонецЕсли; 
		
		Если НРег(ТипСобытияЗвонка)="appeared" Тогда
		
			// начало звонка
			ОбработкаНачалаЗвонка_Mango(СодержимоеПакета, ИД);
		
		ИначеЕсли НРег(ТипСобытияЗвонка)="connected" Тогда
		
			// соединение
			ОбработкаСоединенияЗвонка_Mango(СодержимоеПакета);
		
		ИначеЕсли НРег(ТипСобытияЗвонка)="onhold" Тогда
		
			// удержание
			//ОбработкаУдержанияЗвонка(СодержимоеПакета);
		
		ИначеЕсли НРег(ТипСобытияЗвонка)="disconnected" Тогда
		
			// завершение
			ОбработкаЗавершенияЗвонка_Mango(СодержимоеПакета);
		
		КонецЕсли; 
		
	ИначеЕсли Событие="events/recording" Тогда
		
		//ОбработкаСостоянияЗаписи(СодержимоеПакета);
		
	ИначеЕсли Событие="result/stat" Тогда
		
		// событие готовности данных истории
		КлючИстории=СодержимоеПакета.Получить("key");
		ИДЗапроса=СодержимоеПакета.Получить("request_id");
		
		Если ИДЗапроса="api.history."+ВнутреннийНомер Тогда
			ПолучитьИсторию_Mango(КлючИстории);
		Иначе
			ПолучитьИсторию_Mango(КлючИстории,ИДЗапроса);
		КонецЕсли; 
		
	ИначеЕсли Событие="events/summary" Тогда
		
		//ОбработкаРезультатаЗвонка(СодержимоеПакета);
		
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Функция ОбработкаСобытийREST_Mango(СобытиеПакета,ДанныеПакета,Маркер="")
	
	БазовыйПуть=Схема+АдресAPI;
	Событие=СтрЗаменить(СобытиеПакета,БазовыйПуть,"");
	
	ДанныеСобытия=Base64Раскодировать(ДанныеПакета);
	Данные = СофтФонКлиентСервер.ПолучитьДанныеJSON(ДанныеСобытия,Истина);
	
	Если Не ТипЗнч(Данные)=Тип("Соответствие") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	// json не прошел валидацию
	Если Данные=Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	//ФлагAPI=Истина;
	
	// обработка ошибок
	Статус=Данные.Получить("status");
	Если Не Статус=Неопределено Тогда
		Если ТипЗнч(Статус)=Тип("Число") Тогда
			Если Статус>400 Тогда
				Текст=Данные.Получить("message");
				ИмяОшибки=Данные.Получить("name");
				КодОшибки=Данные.Получить("code");
				//Если Не Отладка Тогда
					Если ЗначениеЗаполнено(Текст) Тогда
						ПоказатьОповещениеПользователя(ИмяОшибки,,Текст);
					КонецЕсли; 
				//КонецЕсли;
				Возврат Ложь;
			КонецЕсли;
		КонецЕсли; 
	КонецЕсли; 
	
	// обработка событий согласно Mango-Office API
	Метка="&json=";
	Если Событие="result/callback" Тогда
		
		ОбработкаОтветаНаКоманду_Mango(Данные);
		
	ИначеЕсли Событие="result/call/hangup" Тогда
		
		ОбработкаОтветаНаКоманду_Mango(Данные);
		
	ИначеЕсли Событие="result/route" Тогда
		
		ОбработкаОтветаНаКоманду_Mango(Данные);
		
	ИначеЕсли Событие="result/transfer" Тогда
		
		ОбработкаОтветаНаКоманду_Mango(Данные);
		
	ИначеЕсли Событие="config/users/request" Тогда
		
		ОбработкаВнутренниеНомера_Mango(Данные);
		
	ИначеЕсли Событие="incominglines" Тогда
		
		ОбработкаЛинии_Mango(Данные);
		
	ИначеЕсли Событие="stats/request" Тогда
		
		// в ответ должен вернуться ключ
		КлючИстории=Данные.Получить("key");
		Если Не ЗначениеЗаполнено(КлючИстории) Тогда
			СтрСообщения="Запрос истории не выполнен";
			Если ЗначениеЗаполнено(Данные.Получить("message")) Тогда
				СтрСообщения=Данные.Получить("message");
			КонецЕсли; 
			ПоказатьОповещениеПользователя("Ошибка запроса истории",,СтрСообщения);
		КонецЕсли; 
		
	ИначеЕсли Событие="queries/recording/post" Тогда
		
		// в ответ должен вернуться линк
		ОбработкаЗапросФайлаЗаписи_Mango(Данные,Маркер);
		
	ИначеЕсли Событие="stats/result" Тогда
		
	КонецЕсли; 
	
КонецФункции

&НаКлиенте
Функция ОбработкаОтветаНаКоманду_Mango(Данные)

	ИДКоманды=Данные.Получить("command_id");
	КодРезультата=Данные.Получить("result");
	
	Если ИДКоманды="api.outgoing."+ВнутреннийНомер 
		ИЛИ ИДКоманды="api.transfer."+ВнутреннийНомер
		ИЛИ ИДКоманды="api.hangup."+ВнутреннийНомер
		ИЛИ ИДКоманды="api.route."+ВнутреннийНомер Тогда
		
		Если КодРезультата>1000 Тогда
		
			ОписаниеПричины=ПолучитьОписаниеКода_Mango(КодРезультата);
			ПоказатьОповещениеПользователя("Ошибка",,ОписаниеПричины);
		
		КонецЕсли; 
	
	КонецЕсли; 

КонецФункции

&НаКлиенте
Функция ОбработкаЗапросФайлаЗаписи_Mango(Данные, Маркер)
	
	КодОтвета=Данные.Получить("code");
	ФайлЗаписиСсылка=Данные.Получить("location");
	
	Если Не КодОтвета=302 Тогда
		Возврат Ложь;
	КонецЕсли; 
	
	Если ЗначениеЗаполнено(ФайлЗаписиСсылка) Тогда
		
		ПараметрыОтбора=Новый Структура;
		
		Разделитель=".";
		СтрПоиска="record-request"+Разделитель;
		Длина=СтрДлина(СтрПоиска);
		Позиция=Найти(Маркер,СтрПоиска);
		Если Позиция=0 Тогда
			Возврат Ложь;
		КонецЕсли;
		СтрМаркер=СтрЗаменить(Маркер,СтрПоиска,"")+Разделитель;
		
		Команда1С=""; ФайлЗаписиИД=""; ИДФормыОповещения="";
		Колво=СтрЧислоВхождений(СтрМаркер,Разделитель);
		Для Индекс=1 По Колво Цикл
			
			ПозицияРазделителя=Найти(СтрМаркер,Разделитель);
			Если ПозицияРазделителя>0 Тогда
			
				Значение=Лев(СтрМаркер,ПозицияРазделителя-1);
				Если Индекс=1 Тогда
					Команда1С=Значение;
				ИначеЕсли Индекс=2 Тогда
					ФайлЗаписиИД=Значение;
				ИначеЕсли Индекс=3 Тогда
					ИДФормыОповещения=Значение;
				КонецЕсли;
				СтрМаркер=Сред(СтрМаркер,ПозицияРазделителя+1);
			
			КонецЕсли; 
		
		КонецЦикла; 
		
		Если Не ЗначениеЗаполнено(ФайлЗаписиИД) Тогда
			Возврат Ложь;
		КонецЕсли; 
		
		//Если Команда1С="download" Тогда
		//	СохранитьФайлЗаписи(ФайлЗаписиСсылка,ФайлЗаписиИД,ИДФормыОповещения);
		//ИначеЕсли Команда1С="play" Тогда
		//	Если ФлагФайлыПрослушивание Тогда
		//		ОткрытьФормуВоспроизведения(ФайлЗаписиСсылка);
		//	Иначе
		//		НачатьЗапускПриложения(Новый ОписаниеОповещения("ЗавершитьЗапускПриложения", ЭтаФорма), ФайлЗаписиСсылка);
		//	КонецЕсли; 
		//КонецЕсли;
		//Если ЗагружатьЗаписьMango Тогда
		//	СофтФонКлиент.ПолучитьФайлЗаписиПоHttpСсылке(ФайлЗаписиСсылка);
		//Иначе			
		//	Оповещение=Новый ОписаниеОповещения("ЗавершитьЗапускПриложения", СофтФонКлиент);
		//	НачатьЗапускПриложения(Оповещение, ФайлЗаписиСсылка);
		//КонецЕсли;
		ОбработатьПолучениеСсылкиФайлаЗаписиЗвонка(РежимЗагрузкиЗаписиMango, ФайлЗаписиСсылка);		
	КонецЕсли; 

КонецФункции

&НаКлиенте
Функция ПолучитьОписаниеКода_Mango(Код)

	// строковое представление кода завершения
	Результат=Код;
	Если Не ЗначениеЗаполнено(Код) Тогда
		Возврат Результат;
	КонецЕсли; 
	
	Попытка
		ЧислоКод=Число(Код);
	Исключение
		Возврат Результат;
	КонецПопытки; 
	
	ЧислоКласс=Окр(ЧислоКод,-3);
	СтрКласс=Формат(ЧислоКласс,"ЧГ=0");
	СтрКод=Формат(ЧислоКод,"ЧГ=0");
	ОписаниеКласса=СоответствиеКода_Mango.Получить(СтрКласс);
	ОписаниеКода=СоответствиеКода_Mango.Получить(СтрКод);
	
	Результат=ОписаниеКода;
	Если ЗначениеЗаполнено(ОписаниеКласса) Тогда
		Если ЧислоКласс>2000 Тогда
			Результат=ОписаниеКласса+": "+ОписаниеКода;
		КонецЕсли; 
	КонецЕсли; 
	
	Возврат Результат;

КонецФункции

&НаКлиенте
Функция ОбработкаВнутренниеНомера_Mango(Данные)

	Содержимое=Данные.Получить("users");
	Если Не ТипЗнч(Содержимое)=Тип("Массив") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ПараметрыОтбора=Новый Структура;
	
	Для каждого ЭлементМассива Из Содержимое Цикл
		Попытка
			
			Общие=ЭлементМассива.Получить("general"); 
			Если Общие=Неопределено  Тогда
				Продолжить;
			КонецЕсли;
			
			Телефоны=ЭлементМассива.Получить("telephony");
			Если Телефоны=Неопределено  Тогда
				Продолжить;
			КонецЕсли;
			
			Номера=Телефоны.Получить("numbers");
			Если Номера=Неопределено  Тогда
				Продолжить;
			КонецЕсли; 
			
			Номер=Телефоны.Получить("extension");
			
			Для каждого ЭлементНомера Из Номера Цикл
				
				Протокол=ЭлементНомера.Получить("protocol");
				Статус=ЭлементНомера.Получить("status");
				УчЗапись=ЭлементНомера.Получить("number");
				
				Если НРег(Протокол)="sip" Тогда
					
					Если Не Номер=ВнутреннийНомер Тогда
						ПараметрыОтбора.Вставить("Номер",Номер);
						МассивСтрок=ВнутренниеНомера_Mango.НайтиСтроки(ПараметрыОтбора);
						Если МассивСтрок.Количество()>0 Тогда
							СтрВнутренниеНомера=МассивСтрок[0];
						Иначе
							СтрВнутренниеНомера=ВнутренниеНомера_Mango.Добавить();
						КонецЕсли; 
						СтрВнутренниеНомера.Номер=Номер;
						СтрВнутренниеНомера.Протокол=Протокол;
						СтрВнутренниеНомера.УчетнаяЗапись=УчЗапись;
						СтрВнутренниеНомера.Имя=Общие.Получить("name");
						СтрВнутренниеНомера.Статус=Макс((Статус="on"),СтрВнутренниеНомера.Статус);
					Иначе
						//СтатусТелефона=Макс((Статус="on"),СтатусТелефона);
						УчетнаяЗапись_Mango = УчЗапись;
					КонецЕсли;
					
				КонецЕсли; 
				
			КонецЦикла; 
			
		Исключение
		КонецПопытки; 
	КонецЦикла;
	
	//ЗаполнитьПользователей();
	ВнутренниеНомера_Mango.Сортировать("Номер");

КонецФункции

&НаКлиенте
Функция ОбработкаЛинии_Mango(Данные)

	Содержимое=Данные.Получить("lines");
	Если Не ТипЗнч(Содержимое)=Тип("Массив") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ПараметрыОтбора=Новый Структура;
	
	Для каждого ЭлементМассива Из Содержимое Цикл
					
		ИД=ЭлементМассива.Получить("line_id");
		
		ПараметрыОтбора.Вставить("ИД",ИД);
		МассивСтрок=Линии_Mango.НайтиСтроки(ПараметрыОтбора);
		Если МассивСтрок.Количество()>0 Тогда
			СтрЛинии=МассивСтрок[0];
		Иначе
			СтрЛинии=Линии_Mango.Добавить();
		КонецЕсли; 
		СтрЛинии.УчетнаяЗапись=ЭлементМассива.Получить("number");;
		СтрЛинии.Номер=ЭлементМассива.Получить("name");;
					
	КонецЦикла;
	
КонецФункции

&НаКлиенте
Функция ОбработкаИсторияАТС_Mango(Данные, Маркер="")
	
	СтруктПараметры = Новый Структура;
	СтруктПараметры.Вставить("ВидАТС", ИДВАТС);
	СтруктПараметры.Вставить("ДатаЗапросаИстории", ТекущаяДата());
	СтруктПараметры.Вставить("Данные", Данные);
	СтруктПараметры.Вставить("КоллекцияВнутрНомера", ПолучитьСоответствиеВнутреннихНомеров_Mango());
	СтруктПараметры.Вставить("КоллекцияЛинии", ПолучитьСоответствиеЛиний_Mango());
	
	ОбработкаИсторияАТСКлиент(СтруктПараметры);
	
КонецФункции

&НаКлиенте
Функция ПолучитьСоответствиеВнутреннихНомеров_Mango()

	КоллекцияВнутрНомера=Новый Соответствие;
	КоллекцияВнутрНомера.Вставить(УчетнаяЗапись_Mango, ВнутреннийНомер);
	Для каждого Элемент Из ВнутренниеНомера_Mango Цикл
		КоллекцияВнутрНомера.Вставить(Элемент.УчетнаяЗапись, Элемент.Номер);
	КонецЦикла; 
	
	Возврат КоллекцияВнутрНомера;

КонецФункции

&НаКлиенте
Функция ПолучитьСоответствиеЛиний_Mango()

	КоллекцияЛинии = Новый Соответствие;
	Для каждого Элемент Из Линии_Mango Цикл
		КоллекцияЛинии.Вставить(Элемент.УчетнаяЗапись,Элемент.Номер);
	КонецЦикла; 
	
	Возврат КоллекцияЛинии;

КонецФункции

&НаКлиенте
Функция ПолучитьСтрокуТекущегоЗвонка_Mango(ИД, Создавать=Истина, ИДПлеча="")

	Результат=Неопределено;
	ПараметрыОтбора=Новый Структура;
	ПараметрыОтбора.Вставить("ИД",ИД);
	Если ЗначениеЗаполнено(ИДПлеча) Тогда
		ПараметрыОтбора.Вставить("call_id",ИДПлеча);
	КонецЕсли; 
	МассивСтрок=ТекущиеЗвонки_Mango.НайтиСтроки(ПараметрыОтбора);
	Если МассивСтрок.Количество()=0 Тогда
		Если Создавать Тогда
			Результат=ТекущиеЗвонки_Mango.Добавить();
			Результат.ИД=ИД;
		КонецЕсли;
	Иначе
		Результат=МассивСтрок[0];
	КонецЕсли;
	
	Возврат Результат;

КонецФункции

&НаКлиенте
Функция ПолучитьПредставлениеЛинии_Mango(УчетнаяЗапись)

	Результат=УчетнаяЗапись;
	
	ПараметрыОтбора=Новый Структура;
	ПараметрыОтбора.Вставить("УчетнаяЗапись",УчетнаяЗапись);
	
	МассивСтрок=Линии_Mango.НайтиСтроки(ПараметрыОтбора);
	Если МассивСтрок.Количество()>0 Тогда
		Результат=МассивСтрок[0].Номер;
	КонецЕсли; 
	
	Возврат Результат;

КонецФункции

&НаКлиенте
Функция ОбработкаНачалаЗвонка_Mango(Данные,ИДОтвета)

	ИД=Данные.Получить("entry_id");
	Если ИД=Неопределено  Тогда
		Возврат Ложь;
	КонецЕсли;
	
	СтрТекущиеЗвонки = ПолучитьСтрокуТекущегоЗвонка_Mango(ИД);
	
	СтрТекущиеЗвонки.call_id=			Данные.Получить("call_id");
	СтрТекущиеЗвонки.timestamp=			Данные.Получить("timestamp");
	СтрТекущиеЗвонки.seq=				Данные.Получить("seq");
	СтрТекущиеЗвонки.call_state=		Данные.Получить("call_state");
	СтрТекущиеЗвонки.location=			Данные.Получить("location");
	СтрТекущиеЗвонки.disconnect_reason=	Данные.Получить("disconnect_reason");
	СтрТекущиеЗвонки.command_id=		Данные.Получить("command_id");
	
	Откуда=Данные.Получить("from");
	Если Не Откуда=Неопределено Тогда
		СтрТекущиеЗвонки.from_extension=	Откуда.Получить("extension");
		СтрТекущиеЗвонки.from_number=		Откуда.Получить("number");
		СтрТекущиеЗвонки.taken_from_call_id=Откуда.Получить("taken_from_call_id");
	КонецЕсли; 
	
	Куда=Данные.Получить("to");
	Если Не Куда=Неопределено Тогда
		СтрТекущиеЗвонки.to_extension=	Куда.Получить("extension");
		СтрТекущиеЗвонки.to_number=		Куда.Получить("number");
		СтрТекущиеЗвонки.to_line_number=Куда.Получить("line_number");
		СтрТекущиеЗвонки.acd_group=		Куда.Получить("acd_group");
	КонецЕсли; 
	
	// внутренние не регистрируются
	ЭтоВнутренний=СофтФонКлиентСервер.ЭтоВнутренний_Mango(СтрТекущиеЗвонки.from_number,СтрТекущиеЗвонки.to_number);
	Если ЭтоВнутренний Тогда
		//ОбновитьСтатусВнутреннегоНомера(СтрТекущиеЗвонки.from_extension,2,ИД);
