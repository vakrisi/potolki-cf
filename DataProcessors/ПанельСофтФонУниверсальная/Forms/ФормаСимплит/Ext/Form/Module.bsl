&НаКлиенте
Функция ОбработкаСобытийPhonet(Событие, Данные, Маркер="", ИДОтвета="")

	// события API Phonet
	Если Найти(Событие, ДоменAPI) > 0 Тогда
		// response
		ОбработкаСобытийREST_Phonet(Событие, Данные, Маркер);
	Иначе
		// webhooks
		ОбработкаСобытийPush_Phonet(Событие, Данные, ИДОтвета);
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Функция ОбработкаСобытийPush_Phonet(Путь,ДанныеПакета,ИДОтвета="")
	
	ДанныеСобытия=Base64Раскодировать(ДанныеПакета);
		
	Данные=СофтФонКлиентСервер.ПолучитьДанныеJSON(ДанныеСобытия,Истина);
		
	// json не прошел валидацию
	Если Данные=Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если Не ТипЗнч(Данные)=Тип("Соответствие") Тогда
		Возврат Ложь;
	КонецЕсли; 
	
	ФлагAPI=Истина;
	
	// запрос контакта
	Событие=Данные.Получить("request");
	Если Не Событие=Неопределено Тогда
		Если Событие="call.settings" Тогда
			ОбработкаПолученияСвойствЗвонка_Phonet(Данные,ИДОтвета);
			Возврат Истина;
		КонецЕсли;
	КонецЕсли;
	
	// webhooks
	Событие=Данные.Получить("event");
	БазовыйПуть="https://api.simplit.io/"+ЛогинSimplit+"/"+ИДВАТС;
	
	Если Событие="call.dial" Тогда
		
		ОбработкаНачалаЗвонкаНомера_Phonet(Данные);
		
	ИначеЕсли Событие="call.bridge" Тогда
		
		ОбработкаОтветаНаЗвонок_Phonet(Данные);
		
	ИначеЕсли Событие="call.hangup" Тогда
		
		Если Путь=БазовыйПуть+"/hangup" Тогда
			
			ОбработкаЗавершенияЗвонкаНомера_Phonet(Данные);
			
		ИначеЕсли Путь=БазовыйПуть+"/end" Тогда
			
			ОбработкаЗавершенияЗвонкаГруппы_Phonet(Данные);
			
		КонецЕсли; 
		
		
	ИначеЕсли Событие="call.join-queue" Тогда
		
		ОбработкаНачалаЗвонкаГруппы_Phonet(Данные);
		
	Иначе
		
		Если Путь=БазовыйПуть+"/finish" Тогда
			
			ОбработкаЗавершенияЗвонка_Phonet(Данные);
		
		КонецЕсли; 
		
	КонецЕсли; 
	
КонецФункции

