Функция ОбработкаЗавершенияЗвонка_Mango(Данные)

	ИД=Данные.Получить("entry_id");
	Если ИД=Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Расположение=Данные.Получить("location");
