&НаКлиенте
Функция ПодключитьПанель_Simplit()
	
	ПанельRomHMac = Неопределено;
	ИмяМакетаБиблиотеки = "SIO_WS_ZIP";
	ИмяИсточникаСобытий = ИДВАТС;
	
	// попытка установить компоненту
	Результат=ПодключитьВнешнююКомпоненту("ОбщийМакет."+ИмяМакетаБиблиотеки,ИмяИсточникаСобытий,ТипВнешнейКомпоненты.Native);
	
	Если Не Результат Тогда
		
		// неудачно, возможно еще не устанавлена
		УстановитьВнешнююКомпоненту("ОбщийМакет."+ИмяМакетаБиблиотеки);
		Результат=ПодключитьВнешнююКомпоненту("ОбщийМакет."+ИмяМакетаБиблиотеки,ИмяИсточникаСобытий,ТипВнешнейКомпоненты.Native);
		
	КонецЕсли;
	
	Если Результат Тогда
		ПанельRomHMac=Новый("AddIn."+ИмяИсточникаСобытий+".SimplitIO-WS");
		ПанельRomHMac.ИсточникСобытия=ИмяИсточникаСобытий;
		ПанельRomHMac.РегулярноеВыражение=СофтФонКлиентСервер.Stringify("'service':'(simplit.io|"+ИмяИсточникаСобытий+")'");
	КонецЕсли; 
	
	ПодключенКАТС=ПанельRomHMac.Подключено;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция АвторизоватьсяНаSimplitIO()
	
	Пакет="{'service': 'simplit.io','data': {'action': 'auth','user': '"+СокрЛП(ЛогинSimplit)+"', 'key': '"+СокрЛП(ПарольSimplit)+"'}}";
	Пакет=СофтФонКлиентСервер.Stringify(Пакет);
	ПанельRomHMac.Отправить(Пакет);
		
КонецФункции

&НаКлиенте
Функция ОтправитьПакетSimplitIO(Пакет)

	Если Не ПанельRomHMac=Неопределено Тогда
		Если НЕ ПустаяСтрока(Пакет) Тогда
			ПанельRomHMac.Отправить(Пакет);
		КонецЕсли; 
	КонецЕсли; 

КонецФункции

&НаКлиенте
Процедура ПодключитьсяКСерверуSimplit()
	
	КоличествоВыполненныхПопытокПодключения = КоличествоВыполненныхПопытокПодключения + 1;
	
	Если КоличествоВыполненныхПопытокПодключения > 10 тогда
		Возврат;
	ИначеЕсли КоличествоВыполненныхПопытокПодключения > 2 Тогда
		Пауза(3);
	КонецЕсли;
	
	Если ПанельRomHMac=Неопределено Тогда
		ПодключенКАТС=Ложь;
		Возврат;
	КонецЕсли; 
	
	Если Не ПанельRomHMac.Подключено Тогда
		Если ЗначениеЗаполнено(ЛогинSimplit) Тогда
			Если НЕ ПанельRomHMac.Подключиться(ЛогинSimplit) Тогда
				//пробуем еще раз
				ПодключитьсяКСерверуSimplit();
			КонецЕсли;
		КонецЕсли; 
	КонецЕсли;
	ПодключенКАТС=ПанельRomHMac.Подключено;
	
КонецПроцедуры

&НаКлиенте
Функция ОбработкаСобытийСервераSimplitOnPBX(Источник, ДанныеСобытия)

	JSON=СофтФонКлиентСервер.ПолучитьДанныеJSON(ДанныеСобытия);
	Если JSON=Неопределено Тогда
		Возврат Ложь;
	КонецЕсли; 
	
	// получение данных
	Сервис=""; Событие=""; Данные=""; Маркер=""; ИДОтвета="";
	JSON.Свойство("service",Сервис);
	JSON.Свойство("event",Событие);
	JSON.Свойство("data",Данные);
	JSON.Свойство("marker",Маркер);
	JSON.Свойство("response",ИДОтвета);
	
	// проверки
	Если Не ЗначениеЗаполнено(Сервис) Тогда
		Возврат Ложь;
	КонецЕсли; 
	Если Не ЗначениеЗаполнено(Событие) Тогда
		Возврат Ложь;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Данные) Тогда
		Возврат Ложь;
	КонецЕсли;
		
	// json не прошел валидацию
	Если Не ТипЗнч(JSON)=Тип("Структура") Тогда
		Возврат Ложь;
	КонецЕсли; 
	
	Если Сервис="simplit.io" Тогда
		//СОБЫТИЯ ОТ СЕРВЕРА SIMPLIT
		Если Событие="connection" Тогда
			
			//отправляем запрос на авторизацию на сервере Simplit
			Если НЕ ПанельRomHMac = Неопределено Тогда
				АвторизоватьсяНаSimplitIO();
				//Пакет="{'service': 'simplit.io','data': {'action': 'auth','user': '"+СокрЛП(ЛогинSimplit)+"', 'key': '"+СокрЛП(ПарольSimplit)+"'}}";
				//Пакет=СофтФонКлиентСервер.Stringify(Пакет);
				//ПанельRomHMac.Отправить(Пакет);
				Возврат Истина;
			Иначе
				Возврат Ложь;
			КонецЕсли;
			
		ИначеЕсли Событие="auth" Тогда
			
			Результат=Ложь;
			Если Данные.status="allow" Тогда
				Результат=Истина;
				
				Если НЕ ПанельRomHMac = Неопределено Тогда
					Если Источник = "SimplitIO-WS.OnPBX" Тогда
						//отправляем запрос на авторизацию на сервере OnlinePBX
						
						ДанныеJSON=
						"{
						|'domain':'"+АдресАТС+"',
						|'key':'"+ПарольАТС+"',
						|'secure':true,
						|'port':8093
						|}";
						Пакет=СформироватьПакетOnPBX(ДанныеJSON,"connect","connect");
						ПанельRomHMac.Отправить(Пакет);
						ОтправитьЗапросНаПолучениеКлючаREST();
						
					КонецЕсли;
				КонецЕсли;				
			КонецЕсли; 
			Возврат Результат;		
			
		ИначеЕсли Событие="error" Тогда
			
			//получили ошибку от сервера Simplit
			ПоказатьОповещениеПользователя("Сервис: "+Сервис+" Ошибка: "+ДанныеСобытия);
			Возврат Ложь;
			
		КонецЕсли; 
		
	// события API OnlinePBX
	ИначеЕсли Сервис="onpbx" Тогда
		ОбработкаСобытийOnpbx(Событие,Данные);
	ИначеЕсли Сервис="onpbx-rest" Тогда
		ОбработкаСобытийOnpbxREST(Событие,Данные,Маркер);
	КонецЕсли; 
	
КонецФункции

&НаКлиенте
Функция ОбработкаСобытийСервераSimplitOther(Источник, ДанныеСобытия)

	JSON = СофтФонКлиентСервер.ПолучитьДанныеJSON(ДанныеСобытия, Истина);
	Если JSON = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли; 
	
	// получение данных
	Сервис=""; Событие=""; Данные=""; Маркер=""; ИДОтвета="";
	// получение данных
	Сервис=JSON.Получить("service");
	Событие=JSON.Получить("event");
	Данные=JSON.Получить("data");
	Маркер=JSON.Получить("marker");
	ИДОтвета=JSON.Получить("response");
	
	// проверки
	Если Не ЗначениеЗаполнено(Сервис) Тогда
		Возврат Ложь;
	КонецЕсли; 
	Если Не ЗначениеЗаполнено(Событие) Тогда
		Возврат Ложь;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Данные) Тогда
		Возврат Ложь;
	КонецЕсли;
		
	// json не прошел валидацию
	Если Не ТипЗнч(JSON)=Тип("Соответствие") Тогда
		Возврат Ложь;
	КонецЕсли; 
	
	Если Сервис="simplit.io" Тогда
		//СОБЫТИЯ ОТ СЕРВЕРА SIMPLIT
		Если Событие="connection" Тогда
			
			//отправляем запрос на авторизацию на сервере Simplit
			Если НЕ ПанельRomHMac = Неопределено Тогда
				АвторизоватьсяНаSimplitIO();
				Возврат Истина;
			Иначе
				Возврат Ложь;
			КонецЕсли;
			
		ИначеЕсли Событие = "too many connections" Тогда
			ПоказатьОповещениеПользователя("Ошибка: " + Сервис, , "Слишком много соединений");
			ПодключенКАТС = Ложь;
			Возврат Ложь;
			
		ИначеЕсли Событие="auth" Тогда
			
			Результат=Ложь;
			Если Данные.Получить("status")="allow" Тогда
				Результат=Истина;
								
				Если НЕ ПанельRomHMac = Неопределено Тогда
					Если Источник="SimplitIO-WS.megafon" ИЛИ Источник="SimplitIO-WS.domru" Тогда
						//запросим список пользователей онлайн
						ДанныеJSON="{'cmd':'accounts','token':'"+КлючAPI+"'}";
						Пакет=СформироватьПакетREST(ДанныеJSON,,,"accounts");
						ПанельRomHMac.Отправить(Пакет);
						
					ИначеЕсли Источник="SimplitIO-WS.uis" Тогда
						//запросим список внтуренних номеров и id
						ПолучитьСписокОператоров_UIS();
						//ИмяМетода="get.employees";
						//ДанныеJSON="{'jsonrpc':'2.0','id':'"+ИмяМетода+"','method':'"+ИмяМетода+"','params':{'access_token':'"+КлючAPI+"'}}";
						//Пакет=СформироватьПакетREST(ДанныеJSON,,,ИмяМетода);
						//ПанельRomHMac.Отправить(Пакет);
						ПолучитьСписокSIP_UIS();
						
					ИначеЕсли Источник="SimplitIO-WS.sipuni" Тогда
						СоединитьсяWSS();
						ПолучитьСписокОператоров_Sipuni();
						
					ИначеЕсли Источник="SimplitIO-WS.binotel" Тогда
						ПолучитьСписокОператоров_Binotel();
						ПолучитьСписокРингГрупп_Binotel();

					ИначеЕсли Источник="SimplitIO-WS.mango" Тогда
						ПолучитьСписокОператоров_Mango();
						ПолучитьСписокЛиний_Mango();
						
					ИначеЕсли Источник="SimplitIO-WS.phonet" Тогда
						Если Не ЗначениеЗаполнено(КлючСессии) Тогда
							ПолучитьКлючREST_Phonet();
						КонецЕсли;						
						ПолучитьСписокОператоров_Phonet();
	
					КонецЕсли;
				КонецЕсли;
				
			КонецЕсли; 
			Возврат Результат;
					
		ИначеЕсли Событие="error" Тогда
			
			//получили ошибку от сервера Simplit
			ПоказатьОповещениеПользователя("Сервис: "+Сервис+" Ошибка: "+ДанныеСобытия);
			Возврат Ложь;
			
		КонецЕсли; 
		
	ИначеЕсли Сервис="megafon" или Сервис="domru" Тогда
		//СОБЫТИЯ ОТ СЕРВЕРА ITooLabs (Megafon, Domru)
		ОбработкаСобытийITooLabs(Событие, Данные, Маркер, ИДОтвета);
	ИначеЕсли Сервис="uis" Тогда
		//СОБЫТИЯ ОТ СЕРВЕРА uis
		ОбработкаСобытийUis(Событие, Данные, Маркер, ИДОтвета);
	ИначеЕсли Сервис="sipuni" ИЛИ Сервис="sipuni-wss" Тогда
		//СОБЫТИЯ ОТ СЕРВЕРА sipuni
		ОбработкаСобытийSipuni(Событие, Данные, Маркер, ИДОтвета, Сервис);
	ИначеЕсли Сервис="binotel" Тогда
		//СОБЫТИЯ ОТ СЕРВЕРА binotel
		ОбработкаСобытийBinotel(Событие, Данные, Маркер, ИДОтвета);
	ИначеЕсли Сервис="mango" Тогда
		//СОБЫТИЯ ОТ СЕРВЕРА mango
		ОбработкаСобытийMango(Событие, Данные, Маркер, ИДОтвета);
	ИначеЕсли Сервис="phonet" Тогда
		//СОБЫТИЯ ОТ СЕРВЕРА phonet
		ОбработкаСобытийPhonet(Событие, Данные, Маркер, ИДОтвета);
	КонецЕсли; 
	
КонецФункции

