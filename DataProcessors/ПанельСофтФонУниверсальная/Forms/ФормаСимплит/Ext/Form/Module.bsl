&НаКлиенте
Функция ОбработкаИсторияАТСSipuni(Данные, Маркер="")

	Если ЭтоОшибкаSipuni(Данные) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ОбработкаИсторияАТСSipuniНаСервере(Данные, Маркер);
	
КонецФункции

&НаКлиенте
Функция ЭтоОшибкаSipuni(Данные)

	Результат=Ложь;
	
	Если ТипЗнч(Данные)=Тип("Строка") Тогда
	
		Если Найти(НРег(Данные),"</html>")>0 Тогда
			Результат=Ложь;
		КонецЕсли; 
	
	КонецЕсли;
	
	Возврат Результат;

КонецФункции

&НаКлиенте
Функция ОбработкаСобытийWSS_Sipuni(Событие,ДанныеПакета,ИД)

	ДанныеСобытия=Base64Раскодировать(ДанныеПакета);
	Данные=СофтФонКлиентСервер.ПолучитьДанныеJSON(ДанныеСобытия,Истина);

	// json не прошел валидацию
	Если Данные=Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если Не ТипЗнч(Данные)=Тип("Соответствие") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если Событие="auth" Тогда
		
		Если Данные.Получить("action")="auth" Тогда
			ФлагAPI=(Данные.Получить("status")=1);
		КонецЕсли; 
		
	ИначеЕсли Событие="message" Тогда
		
		Если Данные.Получить("action")="notify" Тогда
			ДанныеЗапроса=Данные.Получить("request");
			Если ТипЗнч(ДанныеЗапроса)=Тип("Соответствие") Тогда
			
				ТипСобытия=ДанныеЗапроса.Получить("event");
				
				Если ТипСобытия=1 Тогда
				
					ОбработкаНачалаЗвонка_Sipuni(ДанныеЗапроса, ИД);
					
				ИначеЕсли ТипСобытия=2 Тогда
			
					ОбработкаЗавершенияЗвонка_Sipuni(ДанныеЗапроса);
					
				ИначеЕсли ТипСобытия=3 Тогда
				
					ОбработкаСоединенияЗвонка_Sipuni(ДанныеЗапроса);
					
				ИначеЕсли ТипСобытия=4 Тогда
				
					ОбработкаЗавершенияЗвонкаПромежуточное_Sipuni(ДанныеЗапроса);
					
				КонецЕсли; 
				
			КонецЕсли; 
		КонецЕсли; 
		
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Функция ОбработкаНачалаЗвонка_Sipuni(Данные,ИДОтвета)

	ИД=Данные.Получить("call_id");
	Если ИД=Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
		
	СтрТекущиеЗвонки=ПолучитьСтрокуТекущегоЗвонка_Sipuni(ИД);
	ЗаполнитьДанныеТекущиеЗвонки_Sipuni(СтрТекущиеЗвонки,Данные);
	ЗаполнитьЛинию_Sipuni(СтрТекущиеЗвонки);
	
	ЭтоВходящий=ЭтоВходящий_Sipuni(СтрТекущиеЗвонки);
	Номер=СтрТекущиеЗвонки.src_num;
	ВнутрНомер=СтрТекущиеЗвонки.short_dst_num;
	ЭтоВнутренний=ЭтоВнутренний_Sipuni(СтрТекущиеЗвонки);
	Если ЭтоВнутренний Тогда
		Номер=СтрТекущиеЗвонки.short_src_num;
	КонецЕсли; 
	Если Не ЭтоВходящий Тогда
		ВнутрНомер=СтрТекущиеЗвонки.short_src_num;
		Номер=СтрТекущиеЗвонки.dst_num;
		Если ЭтоВнутренний Тогда
			Номер=СтрТекущиеЗвонки.short_dst_num;
		КонецЕсли; 
	КонецЕсли; 
	
	// действия по отслеживаемому внутреннему номеру
	Если ВнутрНомер=ВнутреннийНомер Тогда
		ИДТекущегоЗвонка=ИД;
		НаправлениеЗвонка="Исходящий";
		Если ЭтоВходящий Тогда
			НаправлениеЗвонка="Входящий";			
			Если ПользовательПринимаетВходящиеЗвонки() Тогда
				СтруктураНовойФормы = Новый Структура;
				СтруктураНовойФормы.Вставить("НомерАбонента", СофтФон.ПолучитьНомерТелефонаВМеждународномФОрматеПользователя(Номер));
				СтруктураНовойФормы.Вставить("ВнешняяЛиния", СтрТекущиеЗвонки.Линия);
				СтруктураНовойФормы.Вставить("НашВнутреннийНомер", ВнутреннийНомер);
				СтруктураНовойФормы.Вставить("ИДСобытия", ИДТекущегоЗвонка);
				ОткрытьФорму("ОбщаяФорма.ФормаВходящийЗвонок", СтруктураНовойФормы, , Номер, ВариантОткрытияОкна.ОтдельноеОкно,,,);
			КонецЕсли;
		КонецЕсли; 
		
	КонецЕсли;
		
КонецФункции

&НаКлиенте
Функция ОбработкаЗавершенияЗвонка_Sipuni(Данные)

	ИД=Данные.Получить("call_id");
	Если ИД=Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	СтрТекущиеЗвонки=ПолучитьСтрокуТекущегоЗвонка_Sipuni(ИД);
	ЗаполнитьДанныеТекущиеЗвонки_Sipuni(СтрТекущиеЗвонки,Данные);
	
	ЭтоВходящий=ЭтоВходящий_Sipuni(СтрТекущиеЗвонки);
	Номер=СтрТекущиеЗвонки.src_num;
	ВнутрНомер=СтрТекущиеЗвонки.short_dst_num;
	ЭтоВнутренний=ЭтоВнутренний_Sipuni(СтрТекущиеЗвонки);
	Если ЭтоВнутренний Тогда
		Номер=СтрТекущиеЗвонки.short_src_num;
	КонецЕсли; 
	Если Не ЭтоВходящий Тогда
		ВнутрНомер=СтрТекущиеЗвонки.short_src_num;
		Номер=СтрТекущиеЗвонки.dst_num;
		Если ЭтоВнутренний Тогда
			Номер=СтрТекущиеЗвонки.short_dst_num;
		КонецЕсли; 
	КонецЕсли; 
	
	// действия по отслеживаемому внутреннему номеру
	Если ВнутрНомер=ВнутреннийНомер ИЛИ ИДТекущегоЗвонка=ИД Тогда	 
		ЗакрытьФормуВходящегоЗвонка(ИДТекущегоЗвонка);	
	КонецЕсли;
		
	ТекущиеЗвонки_Sipuni.Удалить(СтрТекущиеЗвонки);
	
КонецФункции

&НаКлиенте
Функция ОбработкаСоединенияЗвонка_Sipuni(Данные)

	ИД=Данные.Получить("call_id");
	Если ИД=Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	СтрТекущиеЗвонки=ПолучитьСтрокуТекущегоЗвонка_Sipuni(ИД);
	ЗаполнитьДанныеТекущиеЗвонки_Sipuni(СтрТекущиеЗвонки,Данные);
	
	ЭтоВходящий=ЭтоВходящий_Sipuni(СтрТекущиеЗвонки);
	Номер=СтрТекущиеЗвонки.src_num;
	ВнутрНомер=СтрТекущиеЗвонки.short_dst_num;
	ЭтоВнутренний=ЭтоВнутренний_Sipuni(СтрТекущиеЗвонки);
	Если ЭтоВнутренний Тогда
		Номер=СтрТекущиеЗвонки.short_src_num;
	КонецЕсли; 
	Если Не ЭтоВходящий Тогда
		ВнутрНомер=СтрТекущиеЗвонки.short_src_num;
		Номер=СтрТекущиеЗвонки.dst_num;
		Если ЭтоВнутренний Тогда
			Номер=СтрТекущиеЗвонки.short_dst_num;
		КонецЕсли; 
	КонецЕсли; 
	
	// действия по отлеживаемому внутреннему номеру
	Если ВнутрНомер=ВнутреннийНомер Тогда
		
		//ИДТекущегоЗвонка=ИД;
		
		НаправлениеЗвонка="Исходящий";
		Если ЭтоВходящий Тогда
			НаправлениеЗвонка="Входящий";
			ДействияПриПоднятииТрубки_Sipuni(Номер, ИДТекущегоЗвонка);
		КонецЕсли; 
		ЗакрытьФормуВходящегоЗвонка(ИДТекущегоЗвонка);
	
	КонецЕсли;
		
КонецФункции

&НаКлиенте
Функция ОбработкаЗавершенияЗвонкаПромежуточное_Sipuni(Данные)
	// здесь можно ничего не делать
	// будет сгенерировано ОбработкаЗавершенияЗвонка_Sipuni
		
КонецФункции

&НаКлиенте
Функция ПолучитьСтрокуТекущегоЗвонка_Sipuni(ИД, Создавать=Истина)

	Результат = Неопределено;
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("call_id", ИД);
	МассивСтрок = ТекущиеЗвонки_Sipuni.НайтиСтроки(ПараметрыОтбора);
	Если МассивСтрок.Количество()=0 Тогда
		Если Создавать Тогда
			Результат = ТекущиеЗвонки_Sipuni.Добавить();
			Результат.call_id=ИД;
		КонецЕсли;
	Иначе
		Результат=МассивСтрок[0];
	КонецЕсли;
	
	Возврат Результат;

КонецФункции

&НаКлиенте
Функция ЗаполнитьДанныеТекущиеЗвонки_Sipuni(СтрТекущиеЗвонки, Данные)

	Для каждого Элемент Из Данные Цикл
	
		ИДПоля=Элемент.Ключ;
		ЗначениеПоля=Элемент.Значение;
	
		Если Не ЗначениеПоля=Неопределено Тогда
			Если СтрТекущиеЗвонки.Свойство(ИДПоля) Тогда
				СтрТекущиеЗвонки[ИДПоля]=ЗначениеПоля;
			КонецЕсли; 
		КонецЕсли; 
		
	КонецЦикла; 
	
КонецФункции

&НаКлиенте
Функция ЗаполнитьЛинию_Sipuni(СтрТекущиеЗвонки)

	Если СтрТекущиеЗвонки.dst_type=1 И СтрТекущиеЗвонки.src_type=1 Тогда // оба номера внешние
		Если СтрТекущиеЗвонки.is_inner_call Тогда //НРег(СтрТекущиеЗвонки.treeName)="входящая" Тогда  // имя задается в настройках личного кабинета и может отличаться от "входящая"
			СтрТекущиеЗвонки.Линия = СтрТекущиеЗвонки.dst_num;
		КонецЕсли; 
	КонецЕсли; 
	
	//++ 2019-11-19
	Если СтрТекущиеЗвонки.dst_type=2 И СтрТекущиеЗвонки.src_type=1 Тогда // dst - внутренний,  src - внешний
		Если СтрТекущиеЗвонки.is_inner_call Тогда 
			СтрТекущиеЗвонки.Линия = СтрТекущиеЗвонки.treeName; // treeName - имя линии 
		КонецЕсли; 
	КонецЕсли;
	//-- 2019-11-19
	
КонецФункции

&НаКлиенте
Функция ЭтоВходящий_Sipuni(СтрТекущиеЗвонки)

	Результат=(СтрТекущиеЗвонки.src_type=1);
	Если СтрТекущиеЗвонки.src_type=СтрТекущиеЗвонки.dst_type Тогда
		Если СтрТекущиеЗвонки.src_type=1 Тогда
			// оба номера - внешние
			Результат = СтрТекущиеЗвонки.is_inner_call;//(НРег(СтрТекущиеЗвонки.treeName)="входящая"); нельзя проверять по имени транка, имя задается вличном кабинете и может отличаться
		Иначе
			// оба номера - внутрение
			Результат=Истина;
			Если СтрТекущиеЗвонки.short_src_num=ВнутреннийНомер Тогда
				Результат=Ложь;
			КонецЕсли; 
		КонецЕсли; 
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции
 
&НаКлиенте
Функция ЭтоВнутренний_Sipuni(СтрТекущиеЗвонки)

	Результат=(СтрТекущиеЗвонки.src_type=СтрТекущиеЗвонки.dst_type И СтрТекущиеЗвонки.src_type=2);
	Возврат Результат;
	
КонецФункции

