	КонецЕсли; 
	
	aleg_uuid=""; bleg_uuid=""; direction="";
	Данные.Свойство("aleg_uuid",aleg_uuid);
	Данные.Свойство("bleg_uuid",bleg_uuid);
	Данные.Свойство("direction",direction);	
	
	Если aleg_uuid=ИДТекущегоЗвонка ИЛИ bleg_uuid=ИДТекущегоЗвонка Тогда
		
		СтрЗвонок = ПолучитьСтрокуИсторииOnlinePBX(Новый Структура("uuid", bleg_uuid), Ложь);
		Если СтрЗвонок = Неопределено Тогда
			СтрЗвонок = ПолучитьСтрокуИсторииOnlinePBX(Новый Структура("uuid", aleg_uuid), Ложь);
			Если СтрЗвонок = Неопределено Тогда
				Возврат Ложь;
			КонецЕсли;
		КонецЕсли;
		
		//ПараметрыОтбора = Новый Структура;
		//ПараметрыОтбора.Вставить("aleg_uuid", aleg_uuid);
		//МассивСтрок=ИсторияOnlinePBX.НайтиСтроки(ПараметрыОтбора);
		//Если Не ЗначениеЗаполнено(МассивСтрок) Тогда
		//	ПараметрыОтбора.Вставить("aleg_uuid", bleg_uuid);
		//	МассивСтрок=ИсторияOnlinePBX.НайтиСтроки(ПараметрыОтбора);
		//	Если Не ЗначениеЗаполнено(МассивСтрок) Тогда
		//		Возврат Ложь;
		//	КонецЕсли;
		//КонецЕсли;
		
		//МассивСтрок[0].bleg_uuid=bleg_uuid;
		Если СтрЗвонок.extension = ВнутреннийНомер Тогда
			Если НЕ СтрЗвонок.internal                // не внутренний
				И НЕ СтрЗвонок.direction = "outbound" // не исходящий (callback) ++2020-10-20				
				Тогда
				Состояние="Разговор";
				ИД=aleg_uuid;
				//Если МассивСтрок[0].incoming=1 Тогда
				//	ВнешняяЛиния=ПолучитьЛинию(aleg_uuid);
				//Иначе
				//	ВнешняяЛиния=ПолучитьЛинию(bleg_uuid);
				//КонецЕсли;
				НомерАбонента=СтрЗвонок.caller_number;
				
				ДействияПриПоднятииТрубки_OnlinePBX(НомерАбонента, aleg_uuid, bleg_uuid);
				ЗакрытьФормуВходящегоЗвонка(bleg_uuid);
				ЗакрытьФормуВходящегоЗвонка(aleg_uuid);

			КонецЕсли; 
		Иначе
			ОбновитьСтатусВнутреннегоНомера_Onpbx(СтрЗвонок.destination_number,4,,Ложь);
		КонецЕсли; 
		
	КонецЕсли; 
	
КонецФункции

