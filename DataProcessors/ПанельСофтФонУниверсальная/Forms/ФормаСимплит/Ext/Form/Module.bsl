		ДанныеJSON="{'date_from':'"+ПолучитьДатуUT(УниверсальноеВремя(Дата1))+"','date_to':'"+ПолучитьДатуUT(УниверсальноеВремя(Дата2))+"'"+Поля+",'request_id':"+ИДЗапроса+"}";	
