&НаКлиенте
Процедура ИнициализироватьИнфоОшибок_Binotel()

	// инициализация информации об ошибках
	ИнфоОшибок = Новый Соответствие;
	Для Индекс = 1 По 10 Цикл
		ИнфоОшибок.Вставить("Requests are too frequent. You can do this request after "+Индекс+" sec.","Слишком частые запросы. Повторите запрос через "+Индекс+" секунд.");
	КонецЦикла; 
	ИнфоОшибок.Вставить("Can't call to the ext",	"Ошибка вызова внутреннего номера");
	ИнфоОшибок.Вставить("Wrong data",				"Ошибка получения данных");
	ИнфоОшибок.Вставить("Access Denied",			"Доступ запрещен");
	
	//http://developers.binotel.ua/
	//102	No such method
	//103	Not enough data
	//104	Wrong data
	//105	Something went wrong
	//106	Requests are too frequent
	//120	Your company is disabled
	//121	Your key or secret is wrong
	//150	Can't call to the ext
	//151	Can't call to the external number

КонецПроцедуры

&НаКлиенте
Функция ОбработкаСобытийBinotel(Событие, Данные, Маркер="", ИДОтвета="")
	
	// события API Binotel
	ПутьВходящихОповещенийHTTP  = "http://api.simplit.io/"+ЛогинSimplit+"/binotel";
	ПутьВходящихОповещенийHTTPS = "https://api.simplit.io/"+ЛогинSimplit+"/binotel";
	
	Если Событие = ПутьВходящихОповещенийHTTP ИЛИ Событие = ПутьВходящихОповещенийHTTPS Тогда
		ОбработкаСобытийPush_Binotel(Данные, ИДОтвета);
	Иначе
		ОбработкаСобытийREST_Binotel(Событие, Данные, Маркер);
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Функция ОбработкаСобытийPush_Binotel(ДанныеПакета, ИДОтвета="")
	
	ДанныеСобытия=Base64Раскодировать(ДанныеПакета);
	
	//Если Отладка Тогда
	//	Сообщить(ДанныеСобытия);
	//КонецЕсли;
	
	Если Найти(ДанныеСобытия,"requestType=apiCallCompleted&")>0 Тогда
		//ОбработкаСобытийCallCompleted(ДанныеСобытия);
		Возврат Ложь;
	КонецЕсли; 
	
	Данные=СофтФонКлиентСервер.URL2JSON(ДанныеСобытия,Истина);
		
	// json не прошел валидацию
	Если Данные=Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если Не ТипЗнч(Данные)=Тип("Соответствие") Тогда
		Возврат Ложь;
	КонецЕсли; 
	
	Статус=Данные.Получить("status");
	
	// обработка ошибок
	Если Статус="error" Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ФлагAPI=Истина;
	Событие=Данные.Получить("requestType");
	
	Если Событие="receivedTheCall" Тогда
		
		ОбработкаСозданияКанала_Binotel(Данные);
		
	ИначеЕсли Событие="answeredTheCall" Тогда
		
		ОбработкаОтветаНаЗвонок_Binotel(Данные);
		
	ИначеЕсли Событие="transferredTheCall" Тогда
		
		ОбработкаПереводаЗвонка_Binotel(Данные);
		
	ИначеЕсли Событие="hangupTheCall" Тогда
		
		ОбработкаЗавершенияЗвонка_Binotel(Данные);
		
	ИначеЕсли Событие="gettingCallSettings" Тогда
		
		//ОбработкаПолученияСвойствЗвонка(Данные,ИДОтвета);
		
	КонецЕсли; 
	
КонецФункции
 
&НаКлиенте
Функция ОбработкаСобытийREST_Binotel(СобытиеПакета, ДанныеПакета, Маркер="")
	
	ДанныеСобытия=Base64Раскодировать(ДанныеПакета);
	
	//Если Отладка Тогда
	//	Сообщить(ДанныеСобытия);
	//КонецЕсли;
	
	Данные = СофтФонКлиентСервер.ПолучитьДанныеJSON(ДанныеСобытия,Истина);
		
	// json не прошел валидацию
	Если Данные=Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Событие=СтрЗаменить(СобытиеПакета, Схема+ДоменAPI+ВерсияAPI, "");
	
	Статус="";
	
	Если Не ТипЗнч(Данные)=Тип("Соответствие") Тогда
		Возврат Ложь;
	КонецЕсли; 
	
	Статус=Данные.Получить("status");
	
	// обработка ошибок
	Если Статус="error" Тогда
		ТекстОшибки=ИнфоОшибок.Получить(Данные.Получить("message"));
		Если ТекстОшибки=Неопределено Тогда
			ТекстОшибки=Данные.Получить("message");
		КонецЕсли; 
		ПоказатьОповещениеПользователя("Ошибка",,ТекстОшибки);
		Возврат Ложь;
	КонецЕсли;
	
	ФлагAPI=Истина;
	
	Если Событие="/settings/list-of-employees.json" Тогда
		
		// список внутренних номеров
		ОбработкаВнутренниеНомера_Binotel(Данные);
		
	ИначеЕсли Событие="/settings/list-of-ring-groups.json" Тогда
		
		// список участников ринг-груп
		ОбработкаРингГруппы_Binotel(Данные);
		
	ИначеЕсли Найти(Событие,"/stats/call-record.json")>0 Тогда
		
		// ссылка на файл записи
		ОбработкаФайлЗаписи_Binotel(Данные,Маркер);
		
	ИначеЕсли Событие="/stats/list-of-calls-for-period.json" Тогда
		
		// история за день
		ОбработкаИсторияАТСBinotel(Данные);
		
	ИначеЕсли Найти(Событие,"/stats/")>0 Тогда
		
		// история звонков
		Если ЗначениеЗаполнено(Маркер) Тогда
			Если Маркер="background.history.binotel" Тогда
				ОбработкаИсторияАТСBinotel(Данные);
			КонецЕсли; 
		Иначе
			ОбработкаИсторияАТСBinotel(Данные);
		КонецЕсли; 
		
	КонецЕсли; 
		
КонецФункции

&НаКлиенте
Функция ОбработкаСозданияКанала_Binotel(Данные)

	Попытка
				
		generalCallID=Данные.Получить("generalCallID");
		
		СтрТекущиеСобытия=ПолучитьСтрокуСобытия_Binotel(generalCallID);
		Если СтрТекущиеСобытия=Неопределено Тогда
			Возврат Ложь;
		КонецЕсли; 
		
		СтрТекущиеСобытия.requestType=Данные.Получить("requestType");
		СтрТекущиеСобытия.callType=Данные.Получить("callType");
		СтрТекущиеСобытия.extNumber=Данные.Получить("extNumber");
		СтрТекущиеСобытия.externalNumber=Данные.Получить("externalNumber");
		СтрТекущиеСобытия.internalNumber=Данные.Получить("internalNumber");
		СтрТекущиеСобытия.companyID=Данные.Получить("companyID");
		СтрТекущиеСобытия.didNumber=Данные.Получить("didNumber");
		Если Не ЗначениеЗаполнено(СтрТекущиеСобытия.didNumber) Тогда
			СтрТекущиеСобытия.didNumber=Данные.Получить("did");
		КонецЕсли; 
	
		Если ЭтоСобытиеТекущегоВнутреннего_Binotel(СтрТекущиеСобытия) Тогда
			
			Если Не СуществуетТекущийРазговор_Binotel() Тогда // приходят несколько повторяющихся событий
			
				// звонок, принадлежащий этому оператору или звонок, 
				// который еще ни на кого не размещен отображается всем
				НомерАбонента=СтрТекущиеСобытия.externalNumber;
				Если СтрТекущиеСобытия.callType="0" Тогда
					
					НаправлениеЗвонка="Входящий";
					Линия=СтрТекущиеСобытия.didNumber;
					
				ИначеЕсли СтрТекущиеСобытия.callType="1" Тогда
					
					НаправлениеЗвонка="Исходящий";
					Линия="";
					
				КонецЕсли;
				
				//Состояние="Вызов";
				ИДТекущегоЗвонка=generalCallID;
				 
				Если НаправлениеЗвонка="Входящий" Тогда
					//ДействияПриНачалеВходящегоЗвонка(СтрТекущиеСобытия);
					ВнешняяЛиния = Линия;
					
					СтруктураНовойФормы = Новый Структура;
					СтруктураНовойФормы.Вставить("НомерАбонента",	СофтФон.ПолучитьНомерТелефонаВМеждународномФОрматеПользователя(НомерАбонента));
					СтруктураНовойФормы.Вставить("ВнешняяЛиния",	ВнешняяЛиния);
					СтруктураНовойФормы.Вставить("НашВнутреннийНомер",ВнутреннийНомер);
					СтруктураНовойФормы.Вставить("ИДсобытия",		ИДТекущегоЗвонка);
					ОткрытьФорму("ОбщаяФорма.ФормаВходящийЗвонок",СтруктураНовойФормы,,НомерАбонента,ВариантОткрытияОкна.ОтдельноеОкно,,,);
					
				КонецЕсли; 
			
			КонецЕсли; 
			
		КонецЕсли;
		
		//ОбновитьСтатусВнутреннегоНомера(СтрТекущиеСобытия.extNumber,"ringing");
		
	Исключение
	КонецПопытки; 
	
КонецФункции

&НаКлиенте
Функция ОбработкаОтветаНаЗвонок_Binotel(Данные)

	Попытка
				
		generalCallID=Данные.Получить("generalCallID");
		
		СтрТекущиеСобытия=ПолучитьСтрокуСобытия_Binotel(generalCallID);
		Если СтрТекущиеСобытия=Неопределено Тогда
			Возврат Ложь;
		КонецЕсли; 
		
		// дополнение буфера новыми данными
		СтрТекущиеСобытия.callType=Данные.Получить("callType");
		СтрТекущиеСобытия.extNumber=Данные.Получить("extNumber");
		СтрТекущиеСобытия.didNumber=Данные.Получить("didNumber");
		Если Не ЗначениеЗаполнено(СтрТекущиеСобытия.didNumber) Тогда
			СтрТекущиеСобытия.didNumber=Данные.Получить("did");
		КонецЕсли; 
		СтрТекущиеСобытия.companyID=Данные.Получить("companyID");
		СтрТекущиеСобытия.externalNumber=Данные.Получить("externalNumber");
		СтрТекущиеСобытия.internalNumber=Данные.Получить("internalNumber");
		
		// звонок текущего оператора
		Если СтрТекущиеСобытия.extNumber=ВнутреннийНомер ИЛИ СтрТекущиеСобытия.internalNumber=ВнутреннийНомер Тогда
			Если СтрТекущиеСобытия.callType="0" Тогда
				
				//НаправлениеЗвонка="Входящий";
				Линия=СтрТекущиеСобытия.didNumber;
				НомерАбонента=СтрТекущиеСобытия.externalNumber;
				
			ИначеЕсли СтрТекущиеСобытия.callType="1" Тогда
				
				//НаправлениеЗвонка="Исходящий";
				Линия="";
				НомерАбонента=СтрТекущиеСобытия.externalNumber;
				
			КонецЕсли;
			
			//Состояние="Разговор";
			ИДТекущегоЗвонка=generalCallID;
			
			//ДействияПриПоднятииТрубки(СтрТекущиеСобытия);			
			Если СтрТекущиеСобытия.callType="0" И ПользовательПринимаетВходящиеЗвонки() Тогда
				ДействияПриПоднятииТрубки_Binotel(НомерАбонента, ИДТекущегоЗвонка);
			КонецЕсли; 
			ЗакрытьФормуВходящегоЗвонка(ИДТекущегоЗвонка);
			
		Иначе
			
			//Если Не СуществуетТекущийРазговор_Binotel() Тогда
			//	ОчиститьОтображениеЗвонка_Binotel(generalCallID);
			//КонецЕсли; 
			
		КонецЕсли;
		
		//ОбновитьСтатусВнутреннегоНомера(СтрТекущиеСобытия.extNumber,"inuse");
		
	Исключение
		//Если Отладка Тогда
		//	Сообщить(ОписаниеОшибки());
		//КонецЕсли; 
	КонецПопытки; 
	
КонецФункции

