Процедура ОбработкаИсторияАТСUISНаСервере(Данные,Маркер="", ДатаЗапросаИстории=Неопределено)
	
	Результат = Данные.Получить("result");
	ДанныеКоллекция = Результат.Получить("data");
	
	МассивПараметров = Новый Массив;
	
	СтруктПараметры = Новый Структура;
	СтруктПараметры.Вставить("ВидАТС","Uis");
