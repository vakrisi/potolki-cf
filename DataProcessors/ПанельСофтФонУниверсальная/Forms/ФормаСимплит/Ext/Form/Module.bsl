КонецФункции

&НаКлиенте
Функция ПолучитьДатуUTC(Дата='00010101')
	
	ФорматДаты="ДФ=гггг-ММ-ддTЧЧ:мм:сс";
	СтрДатаUTC=Формат(Дата,ФорматДаты)+"Z";
	
	Возврат СтрДатаUTC;

КонецФункции

&НаКлиенте
Функция ПолучитьДатуRFC(ТекДата='00010101')
	
	// Дата в формате RFC 2822
	Если Не ЗначениеЗаполнено(ТекДата) Тогда
		ТекДата=ПолучитьДатуGMT();
	КонецЕсли;
	
	Если ТекДата=НачалоДня(ТекДата) ИЛИ ТекДата=КонецДня(ТекДата) Тогда
		ДатаRFC=Формат(ТекДата,"Л=en_GB; ДФ='дд МММ гггг ЧЧ:мм:сс'")+" GMT";
	Иначе
		ДатаRFC=Формат(УниверсальноеВремя(ТекДата),"Л=en_GB; ДФ='дд МММ гггг ЧЧ:мм:сс'")+" GMT";
	КонецЕсли; 
	
	Возврат ДатаRFC;

КонецФункции

&НаКлиенте
Функция ПолучитьДатуUT(ТекДата='00010101', Миллисекунды=Ложь) 

	// Дата -> UnixTime	
	Возврат Формат(ТекДата - Дата(1970,1,1,0,0,0), "ЧГ=0") + ?(Миллисекунды, "000", "");
	
КонецФункции

&НаКлиенте
Функция Base64ИзСтроки(Знач СтрокаСимволов)
	Массив64 = Новый Массив;
	Для Код = КодСимвола("A") По КодСимвола("Z") Цикл Массив64.Добавить(Символ(Код)); КонецЦикла;
	Для Код = КодСимвола("a") По КодСимвола("z") Цикл Массив64.Добавить(Символ(Код)); КонецЦикла;
	Для Код = КодСимвола("0") По КодСимвола("9") Цикл Массив64.Добавить(Символ(Код)); КонецЦикла;
	Массив64.Добавить("+");
	Массив64.Добавить("/");

	Рет = "";   
	РетХ = "";
	СтрокаСимволов = СтрЗаменить(СтрокаСимволов, Символы.ПС, Символы.ВК + Символы.ПС);
	КоличествоСимволов = СтрДлина(СтрокаСимволов);
	
	КоличествоУчтенных = 0;
	Накопитель = 0;
	Для Индекс = 0 По КоличествоСимволов - 1 Цикл
		МассивВрем = ПреобразоватьСимволЮникод(Сред(СтрокаСимволов, Индекс + 1, 1));
		
		Для ИндексВ = 0 По МассивВрем.Количество() - 1 Цикл
			Накопитель = Накопитель * 256 + МассивВрем[ИндексВ];
			Если КоличествоУчтенных = 2 Или (Индекс = КоличествоСимволов - 1 И ИндексВ = МассивВрем.Количество() - 1) Тогда
				Пока КоличествоУчтенных < 2 Цикл Накопитель = Накопитель * 256; КоличествоУчтенных = КоличествоУчтенных + 1; РетХ = РетХ + "="; КонецЦикла;
				МассивГрупп = Новый Массив(4);
				Для Индекс4 = -3 По 0 Цикл
					Остаток = Накопитель % 64;
					Накопитель = (Накопитель - Остаток) / 64;
					МассивГрупп[ - Индекс4] = Остаток;
				КонецЦикла;
				Для Индекс4 = 0 По 3 Цикл Рет = Рет + Массив64[МассивГрупп[Индекс4]]; КонецЦикла;	
				КоличествоУчтенных = 0;
			Иначе
				КоличествоУчтенных = КоличествоУчтенных + 1;
			КонецЕсли
		КонецЦикла;
	КонецЦикла;

	Возврат "" + ?(ЗначениеЗаполнено(РетХ), Лев(Рет, СтрДлина(Рет) - СтрДлина(РетХ)) + РетХ, Рет);
	
КонецФункции

&НаКлиенте
Функция Base64ВСтроку(Знач Строка64)
	
	// раскодирование Base64, без файловых операций и серверных вызовов
	// на базе mxm2
	Если Лев(Строка64, 4) = "77u/" Тогда
		Строка64 = Сред(Строка64, 5);
	КонецЕсли;
	
	Массив64 = Новый Массив;
	Для Код = КодСимвола("A") По КодСимвола("Z") Цикл
		Массив64.Добавить(Символ(Код));
	КонецЦикла;
	
	Для Код = КодСимвола("a") По КодСимвола("z") Цикл
		Массив64.Добавить(Символ(Код));
	КонецЦикла;
	
	Для Код = КодСимвола("0") По КодСимвола("9") Цикл
		Массив64.Добавить(Символ(Код)); 
	КонецЦикла;
	Массив64.Добавить("+");
	Массив64.Добавить("/");
	
	МассивВрем = Новый Массив;
	
	Строка64 = СтрЗаменить(СтрЗаменить(Строка64, Символ(13), ""), Символ(10), "");
	
	Количество4 = Цел(СтрДлина(Строка64) / 4);
	Результат = "";
	Заглушек = 0;
	Для Индекс4 = 0 По Количество4 - 1 Цикл
		Накопитель = 0;
		Для Индекс = 0 По 3 Цикл
			Символ = Сред(Строка64, Индекс4 * 4 + 1 + Индекс, 1);
			Если Символ = "=" Тогда
				Заглушек = Заглушек + 1;
				Накопитель = Накопитель * 64; // Поднимаем разрядность
				Продолжить;
			КонецЕсли;
			
			ИндексЭлемента = Массив64.Найти(Символ);
			Накопитель = Накопитель * 64 + ИндексЭлемента;
		КонецЦикла;
		
		Для Индекс3 = - 2 По 0 Цикл
			Остаток = Накопитель % 256;
			Если МассивВрем.ВГраница() >= Индекс4 * 3 - Индекс3 Тогда
				МассивВрем[Индекс4 * 3 - Индекс3] = Остаток;
			Иначе
				МассивВрем.Вставить(Индекс4 * 3 - Индекс3, Остаток);
			КонецЕсли;
			Накопитель = (Накопитель - Остаток) / 256;
		КонецЦикла;
	КонецЦикла;
	
	КоличествоЭлементов = МассивВрем.Количество() - Заглушек;
	Индекс = 0;
	Пока Индекс < КоличествоЭлементов Цикл
		Если Индекс + 3 < КоличествоЭлементов И МассивВрем[Индекс] >= 240 И МассивВрем[Индекс + 1] >= 128 И МассивВрем[Индекс + 2] >= 128 И МассивВрем[Индекс + 3] >= 128 Тогда
			Результат = Результат + Символ(64 * 64 * 64 *(МассивВрем[Индекс] - 240) + 64 * 64 *(МассивВрем[Индекс + 1]) - 128 + 64 * (МассивВрем[Индекс + 2] - 128) + МассивВрем[Индекс + 3] - 128);
			Индекс = Индекс + 4;
			Продолжить;
		ИначеЕсли Индекс + 2 < КоличествоЭлементов И МассивВрем[Индекс] >= 224 И МассивВрем[Индекс + 1] >= 128 И МассивВрем[Индекс + 2] >= 128 Тогда
			Результат = Результат + Символ(64 * 64 * (МассивВрем[Индекс] - 224) + 64 * (МассивВрем[Индекс + 1] - 128) + МассивВрем[Индекс + 2] - 128);
			Индекс = Индекс + 3;
			Продолжить;
		ИначеЕсли Индекс + 1 < КоличествоЭлементов И МассивВрем[Индекс] >= 192 И МассивВрем[Индекс + 1] >= 128 Тогда
			Результат = Результат + Символ(64 * (МассивВрем[Индекс] - 192) + МассивВрем[Индекс + 1] - 128);
			Индекс = Индекс + 2;
			Продолжить;
		Иначе
			Результат = Результат + Символ(МассивВрем[Индекс]);
			Индекс = Индекс + 1;
			Продолжить;
		КонецЕсли;
	КонецЦикла;
	
	Результат = СтрЗаменить(Результат, Символы.ВК + Символы.ПС, Символы.ПС);
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция ПреобразоватьСимволЮникод(Символ)
	Код = КодСимвола(Символ);
	Если Код >= 2048 Тогда // Число кодируется 3 байтами 1110хххх, 10хххххх, 10хххххх = (224+), (128+), (128+) (максимально что поддерживается функцией 1с КодСимвола)
		КоличествоБайт = 2; //с нуля
		Байты = Новый Массив; Байты.Добавить(224); Байты.Добавить(128); Байты.Добавить(128);
	ИначеЕсли Код >= 128 Тогда // Число кодируется 2 байтами типа 110ххххх, 10хххххх = (192+ ), (128+ )
		КоличествоБайт = 1; //с нуля
		Байты = Новый Массив; Байты.Добавить(192); Байты.Добавить(128); 
	Иначе//Если Код < 128 Тогда //Как Есть
		Байты = Новый Массив; Байты.Добавить(Код);
		Возврат Байты;
	КонецЕсли;	
	
	Для ИндексБайт = - КоличествоБайт По 0 Цикл
		Остаток = (Код % 64);
		Байты[- ИндексБайт] = Байты[- ИндексБайт] + Остаток;
		Код = (Код - Остаток) / 64;
	КонецЦикла;
    Возврат Байты;
КонецФункции

&НаКлиенте
Функция ЗакрытьФормуВходящегоЗвонка(ИДЗвонка, ИДСессииЗвонка="")
	
	// 2022-05-23
	//Оповестить("ЗакрытьФормуВходящегоЗвонка", ИДЗвонка);
	Если ИДСессииЗвонка = "" Тогда
		Оповестить("ЗакрытьФормуВходящегоЗвонка", ИДЗвонка);
	Иначе
		Оповестить("ЗакрытьФормуВходящегоЗвонка", Новый Структура("ИДЗвонка, ИДСессииЗвонка", ИДЗвонка, ИДСессииЗвонка) );
	КонецЕсли;
		
КонецФункции

&НаКлиенте
Функция ДействияПриНачалеВходящегоЗвонка(НомерАбонента, ВнешняяЛиния, ВнутреннийНомер, ИДТекущегоЗвонка="", ИДСессииСобытия = "")
	
	Если ПользовательПринимаетВходящиеЗвонки() Тогда
		СтруктураНовойФормы = Новый Структура;
		СтруктураНовойФормы.Вставить("НомерАбонента", СофтФон.ПолучитьНомерТелефонаВМеждународномФОрматеПользователя(НомерАбонента));
		СтруктураНовойФормы.Вставить("ВнешняяЛиния", ВнешняяЛиния);
		СтруктураНовойФормы.Вставить("НашВнутреннийНомер", ВнутреннийНомер);
		СтруктураНовойФормы.Вставить("ИДСобытия", ИДТекущегоЗвонка);
		Если ЗначениеЗаполнено(ИДСессииСобытия) Тогда
			СтруктураНовойФормы.Вставить("ИДСессииСобытия", ИДСессииСобытия);
		КонецЕсли;
		ОткрытьФорму("ОбщаяФорма.ФормаВходящийЗвонок", СтруктураНовойФормы, , НомерАбонента, ВариантОткрытияОкна.ОтдельноеОкно,,,);
	КонецЕсли;
	
КонецФункции
		
