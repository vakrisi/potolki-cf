&НаКлиенте
Функция ОбработкаСписокОператоровUis(Данные)

	Результат = Данные.Получить("result");
	Если Результат=Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;	
	ДанныеКоллекция = Результат.Получить("data");
	Если ДанныеКоллекция = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если Не ТипЗнч(ДанныеКоллекция)=Тип("Массив") Тогда
		Возврат Ложь;
	КонецЕсли; 
	
	ВнутренниеНомера_UIS.Очистить();
	Для каждого ЭлементМассива Из ДанныеКоллекция Цикл
		
		extension=ЭлементМассива.Получить("extension");
		Если extension=Неопределено Тогда
			Продолжить;
		КонецЕсли; 
		
		ИД=Формат(ЭлементМассива.Получить("id"),"ЧГ=0");
		ВнутрНомер=extension.Получить("extension_phone_number");
		Если ВнутрНомер=ВнутреннийНомер Тогда
			ВнутреннийИД_UIS=ИД;
			Продолжить;
		КонецЕсли;
		Если НЕ ВнутрНомер = Неопределено Тогда
			СтрВнутренниеНомера=ВнутренниеНомера_UIS.Добавить();
			СтрВнутренниеНомера.ИД=ИД;
			СтрВнутренниеНомера.Номер=ВнутрНомер;
			СтрВнутренниеНомера.Имя=ЭлементМассива.Получить("full_name");
		КонецЕсли;
	КонецЦикла;
	
КонецФункции 

