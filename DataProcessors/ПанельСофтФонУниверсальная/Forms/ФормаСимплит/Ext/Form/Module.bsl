Функция ОбработкаЗавершенияЗвонка_Phonet(Данные)

	Попытка
		
		МассивДанных=Данные.Получить("calls");
		Если Не ТипЗнч(МассивДанных)=Тип("Массив") Тогда
			Возврат Ложь;
		КонецЕсли; 
		
		Для каждого ЭлементМассива Из МассивДанных Цикл
		
			ИД=ЭлементМассива.Получить("parentUuid");
			
			СтрТекущиеСобытия=ПолучитьСтрокуСобытия_Phonet(ИД,Ложь);
			Если СтрТекущиеСобытия=Неопределено Тогда
				Продолжить;
			КонецЕсли; 
		
			Направление=ЭлементМассива.Получить("lgDirection");
			Если Направление=1 Тогда
				Продолжить;
			КонецЕсли;
			
			Источник=ЭлементМассива.Получить("caller");
			Если Не ТипЗнч(Источник)=Тип("Соответствие") Тогда
				Продолжить;
			КонецЕсли; 
			Приемник=ЭлементМассива.Получить("callee");
			Если Не ТипЗнч(Приемник)=Тип("Соответствие") Тогда
				Продолжить;
			КонецЕсли; 
			
			ВнутрНомер=Источник.Получить("num");
			Номер=Приемник.Получить("num");
			Если Направление=4 Тогда
				Номер=Источник.Получить("num");
				ВнутрНомер=Приемник.Получить("num");
			КонецЕсли;
			
			Если ВнутрНомер=ВнутреннийНомер Тогда
				Состояние="Завершен";
				ИДЗвонка="";
				//ЗакрытьФормуОповещения();
				ЗакрытьФормуВходящегоЗвонка(ИД);			
				
			КонецЕсли; 
			
			//ОбновитьСтатусВнутреннегоНомера(ВнутрНомер,"online");
			ТекущиеСобытия_Phonet.Удалить(СтрТекущиеСобытия);
			
		КонецЦикла; 
		
	Исключение
