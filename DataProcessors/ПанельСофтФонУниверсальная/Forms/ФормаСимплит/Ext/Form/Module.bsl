&НаКлиенте
Функция ОбработкаИсторияАТСUIS(Данные,Маркер="", ДатаЗапросаИстории=Неопределено)
	
	Результат = Данные.Получить("result");
	Если Результат=Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;	
	ДанныеКоллекция = Результат.Получить("data");
	Если ДанныеКоллекция = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ОбработкаИсторияАТСUISНаСервере(Данные, Маркер, ДатаЗапросаИстории);
	
КонецФункции

&НаКлиенте
Функция ЭтоОшибкаUIS(Значение)
	
	ТекущийТип=ТипЗнч(Значение);
	Если ТекущийТип=Тип("Строка") Тогда
		ФлагОшибки=Найти(Значение,"{""error"":")>0;
		Если Не ФлагОшибки Тогда
			ФлагОшибки=Найти(Значение,"</html>")>0;
		КонецЕсли; 
	ИначеЕсли ТекущийТип=Тип("Соответствие") Тогда
		ФлагОшибки=Не (Значение.Получить("error")=Неопределено);
	КонецЕсли; 
	
	Возврат ФлагОшибки;
	
КонецФункции

