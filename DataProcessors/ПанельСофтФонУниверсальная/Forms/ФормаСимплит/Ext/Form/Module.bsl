				// дата в формате UT
				ПредставлениеДата2 = ПолучитьДатуUT(ДатаЗапроса2); //Формат(ДатаЗапроса2 - Дата(1970,1,1,0,0,0), "ЧГ=0");
				СтрДата2="'start_stamp_to':'"+ПредставлениеДата2+"'";
			КонецЕсли;
			
			ДанныеJSON="{"+СтрДата1+ ?(ПустаяСтрока(СтрДата1),"", ",") + СтрДата2+"}";
			Пакет=СформироватьПакетREST(ДанныеJSON,Путь);
		КонецЕсли;
		
	ИначеЕсли ИспользуетсяROMAsterisk Тогда
		ОбработкаИсторияАТСAsteriskНаСервере(Дата1, Дата2);

	Иначе
		Возврат Неопределено; 	
	КонецЕсли;
	
	Если (ИспользуетсяROMHMAC 
		ИЛИ ИспользуетсяSIOМегафон 
		ИЛИ ИспользуетсяSIODomRu 
		ИЛИ ИспользуетсяSIOUIS 
