Функция ОбработкаСписокОператоров_Onpbx(Данные)

	Если Не ТипЗнч(Данные)=Тип("Структура") Тогда
		Возврат Ложь;
	КонецЕсли; 
	
	Статус=Ложь;
	Данные.Свойство("status",Статус);
	Если Не Статус Тогда
		Возврат Ложь;
	КонецЕсли; 
	
	ДанныеМассив=""; 
	Данные.Свойство("data",ДанныеМассив);
	
	Если Не ТипЗнч(ДанныеМассив)=Тип("Массив") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Для каждого ЭлементМассива Из ДанныеМассив Цикл
		ОбновитьСтатусВнутреннегоНомера_Onpbx(ЭлементМассива.uid,1,ЭлементМассива.name);
	КонецЦикла;
	ВнутренниеНомера_OnPbx.Сортировать("Статус Убыв, Номер Возр");
	//ЗаполнитьПользователей();
	
КонецФункции

&НаКлиенте
Функция ОбновитьСтатусВнутреннегоНомера_Onpbx(Номер,Статус,Имя="",ФлагНового=Истина)

	Если Номер=ВнутреннийНомер Тогда
		Если Не Статус=Неопределено Тогда
			СтатусТелефона=Статус;
		КонецЕсли; 
		Возврат Истина;
	КонецЕсли; 
	
	СтрВнутренниеНомера=Неопределено;
	ПараметрыОтбора=Новый Структура;
	ПараметрыОтбора.Вставить("Номер", Номер);
	МассивСтрок=ВнутренниеНомера_OnPbx.НайтиСтроки(ПараметрыОтбора);
	Если Не ЗначениеЗаполнено(МассивСтрок) Тогда
		Если ФлагНового Тогда
			СтрВнутренниеНомера=ВнутренниеНомера_OnPbx.Добавить();
			СтрВнутренниеНомера.Номер=Номер;
			СтрВнутренниеНомера.Имя=Номер;
		КонецЕсли; 
		
	Иначе
		СтрВнутренниеНомера=МассивСтрок[0];
	КонецЕсли;

	Если Не Статус=Неопределено Тогда
		Если Не СтрВнутренниеНомера=Неопределено Тогда
			СтрВнутренниеНомера.Статус=Статус;
		КонецЕсли; 
	КонецЕсли; 
	
КонецФункции

&НаКлиенте
Функция ЭтоВнутреннийЗвонок_Onpbx(Источник, Приемник)

	ПараметрыОтбора=Новый Структура;
	ПараметрыОтбора.Вставить("Номер",Источник);
	МассивСтрок=ВнутренниеНомера_OnPbx.НайтиСтроки(ПараметрыОтбора);
	ВнутрИсточник=(МассивСтрок.Количество()>0 ИЛИ Источник=ВнутреннийНомер);
	
	ПараметрыОтбора.Вставить("Номер",Приемник);
	МассивСтрок=ВнутренниеНомера_OnPbx.НайтиСтроки(ПараметрыОтбора);
	ВнутрПриемник=(МассивСтрок.Количество()>0 ИЛИ Приемник=ВнутреннийНомер);
	
	Возврат (ВнутрИсточник И ВнутрПриемник);

КонецФункции

&НаКлиенте
Функция ОбработкаСобытийOnpbxREST(СобытиеПакета,ДанныеПакета,Маркер="")
	
	ДоменAPI = АдресАТС;
	Схема="https://";
	
	БазовыйПуть=Схема+"api2.onlinepbx.ru/"+ДоменAPI+"/"; //2021-07-21 изменено на api2 с api
	Событие=СтрЗаменить(СобытиеПакета,БазовыйПуть,"");
	
	ДанныеСобытия=Base64ВСтроку(ДанныеПакета);
	Данные=СофтФонКлиентСервер.ПолучитьДанныеJSON(ДанныеСобытия);
			
	// json не прошел валидацию
	Если Данные=Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Содержимое="";
	Комментарий="";
	Статус=0;
	
	Данные.Свойство("status",Статус);
	Данные.Свойство("comment",Комментарий);
	Данные.Свойство("data",Содержимое);
	
	// обработка ошибок
	Если Статус=0 Тогда
		// аутенфификация имеет свой обработчик ошибок
		Если Не Событие="auth.json" Тогда
			Возврат Ложь;
		КонецЕсли; 
	КонецЕсли; 
	
	Если Событие="auth.json" Тогда
		
		// обработка ошибок
		Если Статус=0 Тогда
			Если Не КлючЗапрашивался Тогда
				КлючЗапрашивался=Истина;
				ОтправитьЗапросНаПолучениеКлючаREST(Истина);
				Возврат Истина;
			КонецЕсли;
			Возврат Ложь;
		КонецЕсли; 
			
		// получение ключа
		Попытка
			КлючСессии=Данные.data.key;
			КлючИД=Данные.data.key_id;
			//ПриПолученииКлюча();
		Исключение
			КлючСессии=""; КлючИД="";
		КонецПопытки; 
		
	ИначеЕсли Событие="history/search.json" ИЛИ Событие="mongo_history/search.json" Тогда
		
		// обработка ответа на запрос истории
		МассивСтрок=Содержимое;
		Если Не ЗначениеЗаполнено(МассивСтрок) Тогда
			Возврат Ложь;
		КонецЕсли;
		
		Если ТипЗнч(МассивСтрок)=Тип("Массив") Тогда
			Если ЗначениеЗаполнено(Маркер) Тогда
				//ОбработкаИсторияКлиента(МассивСтрок,Маркер);
			Иначе
				//ОбработкаИстория(МассивСтрок);
				ВерсияИстории = Лев(Событие, СтрДлина(Событие) - СтрДлина("/search.json")); 
				ОбработкаИсторияАТСOnPBX(МассивСтрок, , ТекущаяДата(), ВерсияИстории);
			КонецЕсли; 
		ИначеЕсли ТипЗнч(МассивСтрок)=Тип("Строка") Тогда
			ОбработкаФайлЗаписи_OnPbx(МассивСтрок, Маркер);
		КонецЕсли; 
		

	ИначеЕсли Событие="queues/list.json" Тогда
		
		// обработка ответа на запрос списка очередей
		Если Не ТипЗнч(Содержимое)=Тип("Структура") Тогда
			Возврат Ложь;
		КонецЕсли; 
		
		Попытка
			МассивСтрок=Содержимое.queues;
		Исключение
			Возврат Ложь;
		КонецПопытки; 
		
		//ОбработкаОчереди(МассивСтрок);
		
	ИначеЕсли Событие="user/get.json" Тогда
		
		// обработка ответа на запрос списка пользователей
		Если Не ТипЗнч(Содержимое)=Тип("Массив") Тогда
			Возврат Ложь;
		КонецЕсли; 
		
		МассивСтрок=Содержимое;
		
		Для каждого ЭлементМассива Из МассивСтрок Цикл
			//ОбновитьСтатусВнутреннегоНомера(ЭлементМассива,Неопределено,ЭлементМассива);
		КонецЦикла; 
		
		//ВнутренниеНомера.Сортировать("Статус Убыв, Номер Возр");
		//ЗаполнитьПользователей();
		
	КонецЕсли; 
	
КонецФункции

&НаКлиенте
Функция ПолучитьСтрокуИсторииOnlinePBX(СтруктураПоиска, ФлагСоздания=Истина)

	Результат=Неопределено;
	
	//Если Не ЗначениеЗаполнено(ИД) Тогда
	//	Возврат Результат;
	//КонецЕсли; 
	
	//ПараметрыОтбора=Новый Структура;
	//ПараметрыОтбора.Вставить("uuid", ИД);
	МассивСтрок=ИсторияOnlinePBX.НайтиСтроки(СтруктураПоиска);
	Если Не ЗначениеЗаполнено(МассивСтрок) Тогда
		Если ФлагСоздания Тогда
			Результат=ИсторияOnlinePBX.Добавить();
			ЗаполнитьЗначенияСвойств(Результат, СтруктураПоиска);
			//Результат.uuid=ИД;
		КонецЕсли; 
	Иначе	
		Результат=МассивСтрок[0];
	КонецЕсли;

	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура ОбработкаИсторияАТСOnPBXНаСервере(Данные, Маркер="", ДатаЗапросаИстории=Неопределено, ВерсияИстории)
	
	МассивПараметров = Новый Массив;
	
	СтруктПараметры = Новый Структура;
	СтруктПараметры.Вставить("ВидАТС",				"OnlinePBX");
	СтруктПараметры.Вставить("ДатаЗапросаИстории",	ДатаЗапросаИстории);
	СтруктПараметры.Вставить("Данные", 				Данные);
	СтруктПараметры.Вставить("ВерсияИстории", 		ВерсияИстории);
	
	МассивПараметров.Добавить(СтруктПараметры);
	
	ФоновыеЗадания.Выполнить("СофтФон.ОбработкаИсторииЗвонковАТС", МассивПараметров, , "Обработка истории звонков АТС");
	
КонецПроцедуры

&НаКлиенте
Функция ОбработкаИсторияАТСOnPBX(Данные, Маркер="", ДатаЗапросаИстории=Неопределено, ВерсияИстории = "history")
	
	Если ВерсияИстории = "mongo_history" Тогда
		// на клиенте выполним получение времени из-за разницы в часовых поясах
		// на сервере может быть другой часовой пояс
		Для каждого СтрокаЗаписи из Данные Цикл
