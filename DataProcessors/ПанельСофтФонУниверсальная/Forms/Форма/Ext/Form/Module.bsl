&НаКлиенте
Функция ОбработкаСобытийSmartConnector(ДанныеСобытия)

	JSON = СофтФонКлиентСервер.ПолучитьДанныеJSON(ДанныеСобытия, Истина);
	Если JSON = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли; 
	
	// получение данных
	Событие 	= JSON.Получить("event");
		
	Если Событие = "error" Тогда
		ЕстьОшибкиПодключения = Истина;
		
		ТекстОшибки	= JSON.Получить("message");	
		Если НЕ ТекстОшибки = Неопределено Тогда
			ПоказатьОповещениеПользователя("Ошибка Софтфон", , ТекстОшибки);	
		КонецЕсли;
		
	ИначеЕсли Событие = "connection" Тогда
		
		СтатусПодключения = JSON.Получить("connection");
		Если СтатусПодключения = "open" Тогда
		    ИдентификаторПодключения = JSON.Получить("resourceId");
		    Элементы.СостояниеПодключения.Подсказка = СтрШаблон("Идентификатор подключения: %1", ИдентификаторПодключения);
			
			ПодключенКАТС = Истина;
			УстановитьСтатусПользовательПодключен(ПодключенКАТС);
			ОтключитьОбработчикОжидания("ПодключитьсяКСерверуSC");
			ЕстьОшибкиПодключения = Ложь;
			//КоличествоВыполненныхПопытокПодключения = 0;
			
			Если ИнтервалПроверкиПодключенияКАТС > 0 Тогда
				ОтключитьОбработчикОжидания("ПроверитьПодключениеКАТС");
				ПодключитьОбработчикОжидания("ПроверитьПодключениеКАТС", ИнтервалПроверкиПодключенияКАТС, Ложь);
			КонецЕсли;
		КонецЕсли;
	
	ИначеЕсли Событие = "message" Тогда
		
		Данные		= JSON.Получить("data");
		Сервис		= JSON.Получить("target");
		ДопМетодыЗапроса	= JSON.Получить("url_params"); // используется для mango
		ДопПараметрыЗапроса	= JSON.Получить("get_params"); // используется для sipuni, uis (2022-11-18)
	
		Если Сервис = "megafon" ИЛИ Сервис = "domru" Тогда
			ОбработкаСобытий_ITooLabs(Событие, Данные);
			
		ИначеЕсли Сервис = "uis" Тогда
			ОбработкаСобытий_UIS(Событие, Данные, ДопПараметрыЗапроса);
			
		ИначеЕсли Сервис = "onlinepbx" Тогда
			ОбработкаСобытий_OnlinePBX(Событие, Данные);
			
		ИначеЕсли Сервис = "mango" Тогда
			ОбработкаСобытий_Mango(Событие, Данные, ДопМетодыЗапроса);
			
		ИначеЕсли Сервис = "sipuni" Тогда
			ОбработкаСобытий_Sipuni(Событие, Данные, ДопПараметрыЗапроса);

		ИначеЕсли Сервис = "beeline" Тогда
			ОбработкаСобытий_Beeline(Событие, Данные);
			
		КонецЕсли;
	КонецЕсли;
		
КонецФункции

