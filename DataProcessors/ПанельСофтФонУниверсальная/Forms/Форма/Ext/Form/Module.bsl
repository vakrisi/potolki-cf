Функция ПолучитьСписокЛиний_Mango()

	ДанныеJSON="{}";
	
	Подпись = ПодписатьПакет_Mango(СофтФонКлиентСервер.Stringify(ДанныеJSON));
	ТелоЗапроса = "vpbx_api_key=" + КлючAPI + "&sign=" + Подпись + "&json=" + КодироватьДанныеПакета(СофтФонКлиентСервер.Stringify(ДанныеJSON));

	// обработка запроса 
	Ресурс = "/vpbx/incominglines";
	
	Заголовки = Новый Соответствие;	
	Заголовки.Вставить("Content-Type", "application/x-www-form-urlencoded");

	Данные = ВыполнитьRestЗапрос("POST", ДоменAPI, Ресурс, Заголовки, ТелоЗапроса);

	Если НЕ Данные = Неопределено Тогда
		Если ЭтоОшибка_Mango(Данные) Тогда
			Возврат Ложь;
		КонецЕсли;
		
		ОбработкаСписокЛиний_Mango(Данные);		
	КонецЕсли;
	
