					НомерАбонента = ДанныеСобытия.Получить("CallerIDNum");
					ИдЗвонка = ДанныеСобытия.Получить("UniqueID");
					
					ДействияПриНачалеВходящегоЗвонка(НомерАбонента, ВнешняяЛиния, ВнутреннийНомер, ИдЗвонка, UniqueID);
					
				КонецЕсли;
			КонецЕсли;
			
		КонецЕсли;
		
	ИначеЕсли ВРег(ВидСобытия) = "BRIDGE" Тогда
		
		времИДсобытия = ДанныеСобытия.Получить("Uniqueid1");
		ИДСессии = ""; 
		Отбор = Новый Структура;
		Отбор.Вставить("Uniqueid", времИДсобытия);
