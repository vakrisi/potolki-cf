	// обработка запроса 
	Ресурс = "/vpbx/stats/result";
	
	Заголовки = Новый Соответствие;	
	Заголовки.Вставить("Content-Type", "application/x-www-form-urlencoded");

	// все ответы приходят в формате JSON, за исключением статистики - она приходит в формате CSV
	Данные = ВыполнитьRestЗапрос("POST", ДоменAPI, Ресурс, Заголовки, ТелоЗапроса, Ложь);  

	Если НЕ Данные = Неопределено Тогда
		Если ПустаяСтрока(Данные) Тогда
			Возврат Ложь;
		КонецЕсли;
		
		ОбработкаИсторияАТС_Mango(Данные);		
	КонецЕсли;
	
