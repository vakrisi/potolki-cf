		МассивСтрок=ВнутренниеНомера_UIS.НайтиСтроки(ПараметрыОтбора);
		Если МассивСтрок.Количество()>0 Тогда
			МассивСтрок[0].Статус=Статус;
		КонецЕсли; 
		
	КонецЦикла;
	
	ВнутренниеНомера_UIS.Сортировать("Статус Убыв, Номер Возр");
	
