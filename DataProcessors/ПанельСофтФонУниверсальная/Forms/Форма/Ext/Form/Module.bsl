&НаКлиенте
Функция ОбработкаСобытий_OnlinePBX(СобытиеПакета, ДанныеСобытия)
	
	ДанныеСобытия = СтрЗаменить(ДанныеСобытия, "\""", """");
	//Данные = СофтФонКлиентСервер.ПолучитьДанныеJSON(ДанныеСобытия, Истина);		
	Данные = СофтФонКлиентСервер.URL2JSON(ДанныеСобытия, Истина);
	
	Если Данные = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если ТипЗнч(Данные)=Тип("Соответствие") Тогда
		
		ВидСобытия = Данные.Получить("event");		
		
		Если ВидСобытия = "call_start" Тогда 
			// начался звонок
			//ОбработкаСозданияКанала_OnlinePBX(Данные);
			
		ИначеЕсли ВидСобытия = "call_user_start" Тогда
			// начался звонок на пользователя
			ОбработкаСозданияКанала_OnlinePBX(Данные);
			
		ИначеЕсли ВидСобытия = "call_answered" Тогда
			ОбработкаСоединениеКанала_OnlinePBX(Данные);
			
		ИначеЕсли ВидСобытия = "call_end" Тогда
			ОбработкаЗакрытиеКанала_OnlinePBX(Данные);
			
		КонецЕсли; 
		
	КонецЕсли;

КонецФункции

&НаКлиенте
Функция ОбработкаСозданияКанала_OnlinePBX(Данные)
	
	ИДСессииЗвонка 	= Данные.Получить("uuid");
	НомерАбонента 	= Данные.Получить("caller");
	ВнешняяЛиния 	= Данные.Получить("gateway");	
	КудаЗвонит 		= Данные.Получить("callee");
	
	Если СокрЛП(КудаЗвонит) = СокрЛП(ВнутреннийНомер) Тогда	
		ДействияПриНачалеВходящегоЗвонка(НомерАбонента, ВнешняяЛиния, ВнутреннийНомер, ИДСессииЗвонка);
	КонецЕсли;
		
КонецФункции

&НаКлиенте
Функция ОбработкаСоединениеКанала_OnlinePBX(Данные)
	
	ИДСессииЗвонка 	= Данные.Получить("uuid");
	НомерАбонента 	= Данные.Получить("caller");
	//ВнешняяЛиния 	= Данные.Получить("gateway");	
	КудаЗвонит 		= Данные.Получить("callee");
	
	Если СокрЛП(КудаЗвонит) = СокрЛП(ВнутреннийНомер) Тогда	
		ДействияПриПоднятииТрубки_OnlinePBX(НомерАбонента, ИДСессииЗвонка);
	КонецЕсли;
	ЗакрытьФормуВходящегоЗвонка(ИДСессииЗвонка);
		
КонецФункции

&НаКлиенте
Функция ОбработкаЗакрытиеКанала_OnlinePBX(Данные)
	
	ИДСессииЗвонка 	= Данные.Получить("uuid");
	КудаЗвонит 		= Данные.Получить("callee");
	
	Если СокрЛП(КудаЗвонит) = СокрЛП(ВнутреннийНомер) Тогда	
		ЗакрытьФормуВходящегоЗвонка(ИДСессииЗвонка);
	КонецЕсли;
	
КонецФункции

