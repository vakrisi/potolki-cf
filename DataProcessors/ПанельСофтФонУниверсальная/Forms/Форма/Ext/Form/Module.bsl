&НаКлиенте
Процедура ПолучитьИсторию_Beeline(Дата1, Дата2)
		
//	https://cloudpbx.beeline.ru/apis/portal/v2/statistics?dateFrom=2023-06-18T03%3A00%3A00.000Z&dateTo=2023-06-19T22%3A00%3A00.000Z&page=100&pageSize=100

	МаксИДЗаписи = СофтФон.МаксимальныйИДЗаписиВИстории(ИДВАТС);

	Дата1 = ?(ЗначениеЗаполнено(Дата1), Дата1, ТекущаяДата());
	Дата2 = ?(ЗначениеЗаполнено(Дата2), Дата2, ТекущаяДата());
		
	СтрДата1 = ПолучитьДатуUTC(Дата1, ".000Z");
	СтрДата2 = ПолучитьДатуUTC(Дата2, ".000Z");

	Ресурс = "/apis/portal/v2/statistics";
	ПараметрыЗапроса = СтрШаблон("?dateFrom=%1&dateTo=%2&page=NumPage&pageSize=100", СтрДата1, СтрДата2);
	
	Заголовки = Новый Соответствие;	
	Заголовки.Вставить("X-MPBX-API-AUTH-TOKEN", КлючAPI);
	
	ПолучитьИсториюПостранично_Beeline(Ресурс, ПараметрыЗапроса, Заголовки, 0, МаксИДЗаписи);
	
КонецПроцедуры

&НаКлиенте
Процедура ПолучитьИсториюПостранично_Beeline(Ресурс, ПараметрыЗапросаШаблон, Заголовки, НомерСтраницы, Знач МаксИДЗаписи)

	ПараметрыЗапроса = СтрЗаменить(ПараметрыЗапросаШаблон, "NumPage", Формат(НомерСтраницы, "ЧН=0; ЧГ=0"));
	
	Данные = ВыполнитьRestЗапрос("GET", ДоменAPI, Ресурс + ПараметрыЗапроса, Заголовки);

	Если НЕ Данные = Неопределено И ТипЗнч(Данные) = Тип("Массив") Тогда
		Если Данные.Количество() > 0 Тогда
			
			//records
			Если ЗначениеЗаполнено(МаксИДЗаписи) Тогда
				РесурсПоЗаписям = СтрШаблон("/apis/portal/records?id=%1", Формат(МаксИДЗаписи, "ЧГ=0"));				
			Иначе	
				МинДата  = Данные[0].Получить("startDate");
				МаксДата = МинДата;
				Для каждого ЭлементМассива из Данные Цикл
					ДатаЗвонка = ЭлементМассива.Получить("startDate");
					Если ДатаЗвонка > МаксДата Тогда
						МаксДата = ДатаЗвонка;
					КонецЕсли;
					Если ДатаЗвонка < МинДата Тогда
						МинДата = ДатаЗвонка;
					КонецЕсли;
				КонецЦикла;			
				
				Смещение = 3*60*60;
				дМинДата  = СофтФонКлиентСервер.ДатаИзUT(МинДата, Ложь, Истина) - Смещение;
				дМаксДата = СофтФонКлиентСервер.ДатаИзUT(МаксДата, Ложь, Истина);
				РесурсПоЗаписям = СтрШаблон("/apis/portal/records?dateFrom=%1&dateTo=%2", ПолучитьДатуUTC(дМинДата, ".000Z"), ПолучитьДатуUTC(дМаксДата, ".000Z"));
			КонецЕсли;
			ДанныеПоЗаписям = ВыполнитьRestЗапрос("GET", ДоменAPI, РесурсПоЗаписям, Заголовки);
			Если ТипЗнч(ДанныеПоЗаписям) = Тип("Массив") Тогда
				Для каждого ЭлементМассива Из ДанныеПоЗаписям Цикл
					Попытка
						ИДЗаписи = Число(ЭлементМассива.Получить("id"));
						Если ИДЗаписи > МаксИДЗаписи Тогда
							МаксИДЗаписи = ИДЗаписи;
						КонецЕсли;
					Исключение
					КонецПопытки;
				КонецЦикла;
			КонецЕсли;
			
			ОбработкаИсторияАТС_Beeline(Данные, ДанныеПоЗаписям);
			ПолучитьИсториюПостранично_Beeline(Ресурс, ПараметрыЗапросаШаблон, Заголовки, НомерСтраницы + 1, МаксИДЗаписи);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаИсторияАТС_Beeline(Данные, ДанныеПоЗаписям)
	
	СтруктПараметры = Новый Структура;
	СтруктПараметры.Вставить("ВидАТС", ИДВАТС);
	СтруктПараметры.Вставить("ДатаЗапросаИстории", Неопределено);
	СтруктПараметры.Вставить("Данные", Данные);
	СтруктПараметры.Вставить("ДанныеПоЗаписям", ДанныеПоЗаписям);
	
	ОбработкаИсторияАТСКлиент(СтруктПараметры);
	
КонецПроцедуры

