#Область ПроцедурыПоИсторииЗвонков

&НаКлиенте
Функция ПолучитьИсторию(Дата1, Дата2)
	
	СмещениеЧасовогоПоясаАТС = Софтфон.СмещениеЧасовогоПоясаАТС();
	Если СмещениеЧасовогоПоясаАТС <> 0 Тогда
		Дата1 = Дата1 - СмещениеЧасовогоПоясаАТС;		
		Дата2 = Дата2 - СмещениеЧасовогоПоясаАТС;
	КонецЕсли;
	
	//#6061
	// по истории АТС есть "проблема". примерно так: в 18:52 поступил звонок, например в 18:55 в 1с производится запрос истории, 
	// который фиксирует время последнего успешного получения данных на 18:54 (когда был последний звонок). 
	// Звонок 18:52 длился 10 минут и завершился в 19:02 и только после этого попал в историю на стороне АТС (со временем 18:52). 
	// в следующий раз 1с при запросе запрашивает звонки с 18:54. В итоге звонок 18:52 в истории 1с не появляется.
	// Пока следующее решение: запрашивать 3 часа назад от последнего успешного
	Дата1 = Дата1 - 3*60*60;
	
	Если ИспользуетсяМегафон ИЛИ ИспользуетсяDomRu Тогда
		
		ПолучитьИсторию_ITooLabs(Дата1, Дата2);
		
	ИначеЕсли ИспользуетсяUIS Тогда

		ПолучитьИсторию_UIS(Дата1, Дата2);
		
	ИначеЕсли ИспользуетсяOnlinePBX Тогда

		ПолучитьИсторию_OnlinePBX(Дата1, Дата2);
	
	ИначеЕсли ИспользуетсяSipuni Тогда
		
		ПолучитьИсторию_Sipuni(Дата1, Дата2);
				
	ИначеЕсли ИспользуетсяBinotel Тогда
		
		ПолучитьИсторию_Binotel(Дата1, Дата2);
				
	ИначеЕсли ИспользуетсяMango Тогда

		ПолучитьИсторию_Mango(Дата1, Дата2);
	
	ИначеЕсли ИспользуетсяPhonet Тогда
		
		ПолучитьИсторию_Phonet(Дата1, Дата2);
		
	ИначеЕсли ИспользуетсяБилайн Тогда
		
		ПолучитьИсторию_Beeline(Дата1, Дата2);
				
	ИначеЕсли ИспользуетсяROMAsterisk Тогда
		// 2022-10-06 переделано на общую процедуру ОбработкаИсторияАТСКлиент, чтобы срабатывало оповещение после загрузки истории
		//ОбработкаИсторияАТСAsteriskНаСервере(Дата1, Дата2);
		ОбработкаИсторияАТС_Asterisk(Дата1, Дата2);

	Иначе
		Возврат Неопределено; 	
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Процедура ОбработкаИсторияАТСКлиент(СтруктПараметры)
		
	ДлительнаяОперация = ОбработкаИсторияАТССервер(СтруктПараметры);
	ИдентификаторЗадания = ДлительнаяОперация.ИдентификаторЗадания;
	
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ВыводитьОкноОжидания = Ложь;
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ОбработкаИсторияАТСЗавершение", ЭтотОбъект);
	ДлительныеОперацииКлиент.ОжидатьЗавершение(ДлительнаяОперация, ОписаниеОповещения, ПараметрыОжидания);
	
КонецПроцедуры

