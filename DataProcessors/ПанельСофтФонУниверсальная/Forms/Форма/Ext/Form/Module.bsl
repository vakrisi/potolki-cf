&НаКлиенте
Процедура ОбработкаСобытий_Вариант_296_1_Asterisk(ВидСобытия, ДанныеСобытия)

	//копим историю звонков
	Если ВРег(ВидСобытия)="NEWCHANNEL" Тогда
		//1. Пришел звонок на наш внешний номер (группу номеров)
		Если ДанныеСобытия.Получить("Context") = "from-trunk-custom" Тогда
			НоваяСтрока = ИсторияAsterisk.Добавить();
			НоваяСтрока.Event = ВРег(ВидСобытия);
			НоваяСтрока.Uniqueid  = ДанныеСобытия.Получить("Uniqueid");
			НоваяСтрока.Linkedid  = ДанныеСобытия.Получить("Linkedid");
			НоваяСтрока.Exten = ДанныеСобытия.Получить("Exten");
			НоваяСтрока.CallerID2 = ДанныеСобытия.Получить("CallerIDNum");       // номер клиента
		КонецЕсли;
		
	ИначеЕсли ВРег(ВидСобытия) = "DIALBEGIN" Тогда
		//2. АТС перебросила звонок на менеджера
		
		Если ВРег(ДанныеСобытия.Получить("ChannelStateDesc")) = "RING" Тогда			
			ИДЗвонка = ДанныеСобытия.Получить("DestUniqueid");
			ИДСессииЗвонка = ДанныеСобытия.Получить("DestLinkedid");
			
			ВнешняяЛиния = ДанныеСобытия.Получить("ConnectedLineNum");
			
			// внутренний номер менеджера 
			ВнутреннийНомерЗвонка = СокрЛП(ДанныеСобытия.Получить("DestCallerIDNum"));    		 
			
			НоваяСтрока = ИсторияAsterisk.Добавить();
			НоваяСтрока.Event = ВРег(ВидСобытия);
			НоваяСтрока.Uniqueid  = ИДЗвонка;
			НоваяСтрока.Linkedid  = ИДСессииЗвонка;
			НоваяСтрока.DestCallerIDNum = ВнутреннийНомерЗвонка; 
			НоваяСтрока.CallerID2 = ДанныеСобытия.Получить("CallerIDNum");  // номер клиента		

			Если ВнутреннийНомерЗвонка = СокрЛП(ВнутреннийНомер) Тогда
				ДействияПриНачалеВходящегоЗвонка(НоваяСтрока.CallerID2, ВнешняяЛиния, ВнутреннийНомер, ИДЗвонка, ИДСессииЗвонка);			
			КонецЕсли;
		КонецЕсли;

	ИначеЕсли ВРег(ВидСобытия) = "HANGUP" Тогда		
		//Разорвал канал - положили трубку или разговор окончен - закрываем окно входящего звонка

		ВнутреннийНомерЗвонка = СокрЛП(ДанныеСобытия.Получить("CallerIDNum"));		
		Если ВнутреннийНомерЗвонка = ВнутреннийНомер Тогда // 2023-07-11 добавлен отбор по внутреннему номеру
		
			ИДСессииЗвонка = ДанныеСобытия.Получить("Linkedid");
			ЗакрытьФормуВходящегоЗвонка(ИДСессииЗвонка);
		
			ИДЗвонка = ДанныеСобытия.Получить("Uniqueid");
			ЗакрытьФормуВходящегоЗвонка(ИДЗвонка);
			
			// 2023-07-11 очищаем только "связанные" события
			//ИсторияAsterisk.Очистить();
			Отбор = Новый Структура;
			Отбор.Вставить("Linkedid", 			ИДСессииЗвонка);			
			НайденныеСтроки = ИсторияAsterisk.НайтиСтроки(Отбор);
			Для каждого НайденнаяСтрока из НайденныеСтроки Цикл
				ИсторияAsterisk.Удалить(НайденнаяСтрока);
			КонецЦикла;
				
		КонецЕсли;
		
	ИначеЕсли ВРег(ВидСобытия)="BRIDGEENTER" Тогда
		//3. Менеджер поднял трубку	
	
		ВнутреннийНомерЗвонка = СокрЛП(ДанныеСобытия.Получить("CallerIDNum"));
	
		Если ВнутреннийНомерЗвонка = СокрЛП(ВнутреннийНомер) Тогда
			
			ИДЗвонка = ДанныеСобытия.Получить("Uniqueid");
			ИДСессииЗвонка = ДанныеСобытия.Получить("Linkedid");
			
			Отбор = Новый Структура;
			Отбор.Вставить("Uniqueid", 			ИДЗвонка);
			Отбор.Вставить("Linkedid", 			ИДСессииЗвонка);
			Отбор.Вставить("Event", 			"DIALBEGIN");
			
			НайденныеСтроки = ИсторияAsterisk.НайтиСтроки(Отбор);
			Если НайденныеСтроки.Количество() > 0 Тогда				
				НомерАбонента = СофтФон.ПолучитьНомерТелефонаВМеждународномФорматеПользователя(НайденныеСтроки[0].CallerID2);
				ДействияПриПоднятииТрубки_Asterisk(НомерАбонента, ИДЗвонка, ИДСессииЗвонка);				
				ЗакрытьФормуВходящегоЗвонка(ИДСессииЗвонка);
			КонецЕсли;
		КонецЕсли;
	
	КонецЕсли;
	
КонецПроцедуры

