&НаКлиенте
Функция ВыполнитьЗапросКлючаRest_OnlinePBX(ЗапроситьНовыйКлюч=Ложь)
	
	Ресурс = "/" + ДоменAPI +  "/auth.json";
	
	СтрНовыйКлюч="&new=false";
	Если ЗапроситьНовыйКлюч Тогда
		СтрНовыйКлюч="&new=true";
	КонецЕсли; 
	ТелоЗапроса="auth_key=" + КлючAPI + СтрНовыйКлюч;							
	
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Accept", "application/json");
	Заголовки.Вставить("Content-Type", "application/x-www-form-urlencoded");
		
	Данные = ВыполнитьRestЗапрос("POST", ДоменOnlinePBX, Ресурс, Заголовки, ТелоЗапроса);
	
	Если НЕ Данные = Неопределено Тогда	
		Статус = Данные.Получить("status");
		// обработка ошибок
		Если НЕ Статус = "1" Тогда
			Если Не КлючЗапрашивался Тогда
				КлючЗапрашивался = Истина;
				Возврат ВыполнитьЗапросКлючаRest_OnlinePBX(Истина);
			КонецЕсли;
			Возврат Ложь;
		Иначе			
			// получение ключа
			ДанныеКлюча = Данные.Получить("data");
			Попытка
				КлючСессии=ДанныеКлюча.Получить("key");
				КлючИД=ДанныеКлюча.Получить("key_id");
				Возврат Истина;
			Исключение
				КлючСессии=""; 
				КлючИД="";
				Возврат Ложь;
			КонецПопытки;
		КонецЕсли;
	Иначе
		Возврат Ложь;
	КонецЕсли;

КонецФункции

&НаКлиенте
Процедура ПолучитьИсторию_OnlinePBX(Знач Дата1, Знач Дата2)
	
	Ресурс = "/" + ДоменAPI +  "/mongo_history/search.json";
	
	Дата1 = ?(ЗначениеЗаполнено(Дата1), Дата1, ТекущаяДата() - 86400);
	Дата2 = ?(ЗначениеЗаполнено(Дата2), Дата2, ТекущаяДата());
	ДатаЗапроса1 = УниверсальноеВремя(Дата1);
	ДатаЗапроса2 = УниверсальноеВремя(Дата2);
	
	ТелоЗапроса = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку("start_stamp_from=%1&start_stamp_to=%2", ПолучитьДатуUT(ДатаЗапроса1), ПолучитьДатуUT(ДатаЗапроса2));							
	
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Accept", "application/json");
	Заголовки.Вставить("Content-Type", "application/x-www-form-urlencoded");
	
	Если ЗначениеЗаполнено(КлючСессии) Тогда
		Заголовки.Вставить("x-pbx-authentication", Строка(КлючИД) + ":" + Строка(КлючСессии));		
	КонецЕсли;
		
	Данные = ВыполнитьRestЗапрос("POST", ДоменOnlinePBX, Ресурс, Заголовки, ТелоЗапроса, , Ложь);
	
	Если НЕ Данные = Неопределено Тогда	
		Если Данные.Свойство("isNotAuth") И Данные.isNotAuth = Истина Тогда
			РезультатАвторизации = ВыполнитьЗапросКлючаRest_OnlinePBX();				
			Если РезультатАвторизации Тогда
				ПолучитьИсторию_OnlinePBX(Дата1, Дата2);
			КонецЕсли;
		Иначе
			
			Если Данные.Свойство("data") Тогда
				МассивСтрок = Данные.data;
				Если Не ЗначениеЗаполнено(МассивСтрок) 
					ИЛИ НЕ ТипЗнч(МассивСтрок)=Тип("Массив") Тогда
					Возврат;
				КонецЕсли;
				ОбработкаИсторияАТС_OnlinePBX(МассивСтрок);
				
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
			
КонецПроцедуры

&НаКлиенте
Функция ОбработкаИсторияАТС_OnlinePBX(Данные)
	
	//mongo_history
	// на клиенте выполним получение времени из-за разницы в часовых поясах
	// на сервере может быть другой часовой пояс
	Для каждого СтрокаЗаписи из Данные Цикл
		СтрокаЗаписи.Вставить("ДатаНачалаЗвонка", СофтФонКлиент.ДатаИзUT(СтрокаЗаписи.start_stamp));	
	КонецЦикла;
	
	СтруктПараметры = Новый Структура;
	СтруктПараметры.Вставить("ВидАТС", ИДВАТС);
	СтруктПараметры.Вставить("ДатаЗапросаИстории", Неопределено);
	СтруктПараметры.Вставить("Данные", Данные);
	СтруктПараметры.Вставить("ВерсияИстории", "mongo_history");
	
	ОбработкаИсторияАТСКлиент(СтруктПараметры);
		
КонецФункции

