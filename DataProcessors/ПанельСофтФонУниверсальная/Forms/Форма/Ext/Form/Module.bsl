		Channel = ДанныеСобытия.Получить("Channel");
		
		Если //(СокрЛП(CallerIDNum) = СокрЛП(ВнутреннийНомер) ИЛИ (СтрНайти(Channel, "SIP/"+ВнутреннийНомер)=1)) 
			СокрЛП(ConnectedLineNum) = СокрЛП(ВнутреннийНомер) 
			Тогда
			ЗакрытьФормуВходящегоЗвонка(Uniqueid);
			ИсторияAsterisk.Очистить();
		КонецЕсли;
		
	ИначеЕсли ВРег(ВидСобытия)="BRIDGE" Тогда
		//3. Менеджер поднял трубку....
		
		НоваяСтрока = ИсторияAsterisk.Добавить();
		НоваяСтрока.Event = ВРег(ВидСобытия);
		НоваяСтрока.Uniqueid = ДанныеСобытия.Получить("Uniqueid1");
