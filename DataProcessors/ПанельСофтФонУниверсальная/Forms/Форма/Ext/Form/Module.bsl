Процедура АвтоматическиЗапроситьИсториюЗвонков()
	
	ДатаНачала = ТелефонияДатаПоследнегоЗапросаИстории();
	Если ДатаНачала = Дата(1, 1, 1) Тогда
		ДатаНачала =  НачалоДня(ТекущаяДата());
	КонецЕсли;
	ДатаОкончания = ТекущаяДата();
	
	Если ДатаНачала + ИнтервалЗапросаИсторииЗвонков() <= ТекущаяДата() Тогда
		ПолучитьИсторию(ДатаНачала, ДатаОкончания);
	КонецЕсли;
	
