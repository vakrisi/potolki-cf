// Вспомогательная функция перевода шестнацатиричного числа в десятичное 
//
// Параметры:
//	Hex	- Строка	- Число в шестнадцатиричном представлении
//
// Возвращаемое значение:
//	Число	- Десятичное число
//
Функция Hex2Число(Hex) 
	Стр	= ВРег(СокрЛП(Hex));
	Dec	= 0;
	Для Х = 1 По СтрДлина(Стр) Цикл
		Dec	= Dec + Найти("123456789ABCDEF", Сред(Стр, Х, 1)) * Pow(16, СтрДлина(Стр) - Х);
	КонецЦикла;
	Возврат Dec;
КонецФункции

// Функция получает значение из строки
//
// Параметры:
//	ЗначениеВСтроке	- Строка	- Строка, содержащая значение
//	Кавычек			- Число		- Количество кавычек в строке
//
// Возвращаемое значение:
//	Произвольный	- Значение из строки
//
Функция ПолучитьЗначениеИзСтроки(ЗначениеВСтроке, Кавычек)
	Если ЗначениеВСтроке = "" Тогда
		Возврат Неопределено;
	ИначеЕсли Кавычек > 0 Тогда
		Возврат ЗначениеВКавычках(ЗначениеВСтроке);
	Иначе
		Возврат ЗначениеБезКавычек(ЗначениеВСтроке);
	КонецЕсли;
КонецФункции

// Функция получает значение из строки без кавычек
//
// Параметры:
//	ЗначениеВСтроке	- Строка	- Строка, содержащая значение
//
// Возвращаемое значение:
//	Строка	- Значение из строки
//
Функция ЗначениеВКавычках(ЗначениеВСтроке)
	Возврат ЗначениеВСтроке;
КонецФункции 

// Функция получает значение из строки с кавычками
//
// Параметры:
//	ЗначениеВСтроке	- Строка	- Строка, содержащая значение
//
// Возвращаемое значение:
//	Произвольный	- Значение из строки
//
Функция ЗначениеБезКавычек(ЗначениеВСтроке)
	// Это число, булево или null.
	// Хотя здесь могут быть и строки. Например: {Code:123}
	Стр = ВРег(ЗначениеВСтроке);
	Если Стр = "TRUE" Тогда
		Возврат Истина;
	ИначеЕсли Стр = "FALSE" Тогда
		Возврат Ложь;
	ИначеЕсли Стр = "NULL" Тогда
		Возврат Неопределено;
	КонецЕсли;
	// Пробежимся по предполагаемому "числу"
	Экспонента	= Ложь;
	ХХ			= " ";
	Для Индекс = 1 По СтрДлина(Стр) Цикл
		Х = Сред(Стр, Индекс, 1);
		Если Найти("0123456789.+-", Х) Тогда
			ХХ = ХХ + Х;
		ИначеЕсли Х = "E" Тогда
			#Если ВебКлиент Тогда
				Возврат ЗначениеВСтроке;
			#Иначе
				Экспонента = Истина;
				УУ = XMLЗначение(Тип("Число"),ХХ);
				ХХ = " ";
			#КонецЕсли
		Иначе
			// Это не число, а строка
			Возврат ЗначениеВСтроке;
		КонецЕсли;
	КонецЦикла;
	#Если ВебКлиент Тогда
		Попытка
			ХХ = Число(ХХ);
		Исключение
		КонецПопытки;	
	#Иначе
		ХХ = XMLЗначение(Тип("Число"), ХХ);
		Если Экспонента Тогда
			ХХ = УУ * Pow(10, ХХ);
		КонецЕсли;
	#КонецЕсли
	Возврат ХХ;
КонецФункции

// Функция получает описание объекта из модели JSON 
//
// Параметры:
//  СтрJSON	- Строка	- Описание объекта в виде модели json
//
// Возвращаемое значение:
//  Значение	- Соответствие	- Соответствие свойств и значений объекта 
//
Функция UnJSON(СтрJSON) Экспорт 
	
	СтрJSON	= ЗаменитьНедопустимыеСимволыXML(СтрJSON);	
	Значение = "";
	Если ПолучитьЗначениеJSON(СтрJSON, Значение) = 0 Тогда
		Возврат Значение;
	КонецЕсли;
	Возврат Неопределено;
	
КонецФункции // сфпUnJSON()

// Функция заменяет недопустимые символы в XML-строке на заданные символы
//
// Параметры:
//   Текст			– Строка	– Строка, в которой требуется выполнить замену недопустимых символов.
//   СимволЗамены	– Строка	– Строка, на которую требуется выполнить замену недопустимого символа в XML-строке
// 
//  Возвращаемое значение:
//    Строка - Строка, полученная заменой недопустимых символов в XML-строке.
//
Функция ЗаменитьНедопустимыеСимволыXML(Знач Текст, СимволЗамены = " ") Экспорт
	ПозицияНачала = 1;
	Пока Истина Цикл
		Позиция = НайтиНедопустимыеСимволыXML(Текст, ПозицияНачала);
		Если Позиция = 0 Тогда
			Прервать;
		КонецЕсли;
		Если Позиция > 1 Тогда
			НедопустимыйСимвол = Сред(Текст, Позиция - 1, 1);
			Если НайтиНедопустимыеСимволыXML(НедопустимыйСимвол) > 0 Тогда
				Текст = СтрЗаменить(Текст, НедопустимыйСимвол, СимволЗамены);
			КонецЕсли;
		КонецЕсли;
		НедопустимыйСимвол = Сред(Текст, Позиция, 1);
		Если НайтиНедопустимыеСимволыXML(НедопустимыйСимвол) > 0 Тогда
			Текст = СтрЗаменить(Текст, НедопустимыйСимвол, СимволЗамены);
		КонецЕсли;
		ПозицияНачала = Позиция + 1;
	КонецЦикла;
	Возврат Текст;
КонецФункции // сфпЗаменитьНедопустимыеСимволыXML()

// Функция осуществляет непосредственный разбор JSON 
//
// Параметры:
//  СтрJSON		- Строка		- Описание объекта в виде модели json
//  Значение	- Соответствие	- Соответствие свойств и значений объекта 
//	Позиция		- Число			- Позиция в описании
//	Ключ		- Строка		- Ключ соответствия
//
// Возвращаемое значение:
//  Число	- Позиция в описании
//
Функция ПолучитьЗначениеJSON(СтрJSON, Значение, Позиция = 1, Ключ = "") Экспорт
	Кавычка			= "";
	ЗначениеВСтроке	= "";
	Кавычек			= 0;
	Комментарий		= Ложь;
	Строка			= Ложь;
	Пока Позиция <= СтрДлина(СтрJSON) Цикл
		ХХ		= Сред(СтрJSON, Позиция, 2);
		Х		= Лев(ХХ,1);
		Позиция	= Позиция + 1;
		Если Х > " " ИЛИ Строка Тогда // Отсекаем всякий хлам
			Если Комментарий Тогда
				// Это комментарий. Крутимся в цикле пока не встретится конец комментария
				Если ХХ = "*/" Тогда
					// Комментарий закончился
					Комментарий	= Ложь;
					Позиция		= Позиция + 1;
				КонецЕсли;
			ИначеЕсли Х = "\" Тогда
				Позиция	= Позиция + 1;
				ХХ		= ВРег(ХХ);
				Если ХХ = "\""" Тогда
					ЗначениеВСтроке	= ЗначениеВСтроке + """";
				ИначеЕсли ХХ = "\\" Тогда
					ЗначениеВСтроке	= ЗначениеВСтроке + "\";
				ИначеЕсли ХХ = "\/" Тогда
					ЗначениеВСтроке	= ЗначениеВСтроке + "/";
				ИначеЕсли ХХ = "\B" Тогда
					ЗначениеВСтроке	= ЗначениеВСтроке + Символ(8);
				ИначеЕсли ХХ = "\F" Тогда
					ЗначениеВСтроке	= ЗначениеВСтроке + Символы.ПФ; // Перевод формы (страницы)
				ИначеЕсли ХХ = "\N" Тогда
					ЗначениеВСтроке	= ЗначениеВСтроке + Символы.ПС; // Перевод строки
				ИначеЕсли ХХ = "\R" Тогда
					ЗначениеВСтроке	= ЗначениеВСтроке + Символы.ВК; // Возврат каретки
				ИначеЕсли ХХ = "\T" Тогда
					ЗначениеВСтроке	= ЗначениеВСтроке + Символы.ВТаб; // Символ вертикальной табуляции
				ИначеЕсли ХХ = "\U" Тогда
					ЗначениеВСтроке	= ЗначениеВСтроке + Символ(Hex2Число(Сред(СтрJSON, Позиция, 4))); // Шестнадцатиричное число
					Позиция = Позиция + 4;
				КонецЕсли;
			ИначеЕсли Строка Тогда
				// Если строка не закончилась, то пропускаем управляющие символы
				Если Х = Кавычка Тогда
					//Закончилась строка
					Строка	= Ложь;
					Кавычек	= Кавычек + 1;
				Иначе
					ЗначениеВСтроке	= ЗначениеВСтроке + Х;
				КонецЕсли;
			ИначеЕсли ХХ = "/*" Тогда
				// Начался комментарий
				Комментарий	= Истина;
				Позиция		= Позиция + 1;
			ИначеЕсли Найти("""'{}[]:,", Х) > 0 Тогда
				Если (Х = """") ИЛИ (Х = "'") Тогда
					// Началась строка
					// Строка - коллекция нуля или больше символов Unicode, заключенная в
					// двойные кавычки, используя "\" в качестве символа экранирования.
					// Символ представляется как односимвольная строка.
					// Похожий синтаксис используется в C и Java.
					Строка	= Истина;
					Кавычка	= Х;
					Кавычек	= Кавычек + 1;
				ИначеЕсли Х = "{" Тогда
					// Начался объект
					// Объект - неупорядоченный набор пар ключ/значение.
					// Объект начинается с "{" и заканчивается "}".
					// Каждое имя сопровождается ":", пары ключ/значение разделяются ",".
					вОбъект	= Новый Соответствие;
					Пока Истина Цикл
						// Получим ключ и значение
						Ключ	= "";
						Режим	= ПолучитьЗначениеJSON(СтрJSON, Значение, Позиция, Ключ);
						// 0 - есть значение и не конец объекта (запятая)
						// 1 - есть значение и конец объекта
						// 2 - нет значения и не конец объекта (запятая)
						// 3 - нет значения и конец объекта
						Если Режим = 0 Тогда
							вОбъект.Вставить(Ключ, Значение);
						ИначеЕсли Режим = 1 Тогда
							вОбъект.Вставить(Ключ, Значение);
							Прервать;
						ИначеЕсли Режим = 3 Тогда
							Прервать;
						КонецЕсли;
					КонецЦикла;
					Значение	= вОбъект;
					Возврат 0;
				ИначеЕсли Х = "[" Тогда
					// Начался массив
					// Массив - упорядоченная коллекция значений.
					// Массив начинается с "[" и заканчивается "]".
					// Значения разделены ",".
					Массив	= Новый Массив;
					Пока Истина Цикл
						Режим	= ПолучитьЗначениеJSON(СтрJSON, Значение, Позиция);
						// 0 - есть значение и не конец массива (запятая)
						// 1 - есть значение и конец массива
						// 2 - нет значения и не конец массива (запятая)
						// 3 - нет значения и конец массива
						Если Режим = 0 Тогда
							Массив.Добавить(Значение);
						ИначеЕсли Режим = 1 Тогда
							Массив.Добавить(Значение);
							Прервать;
						ИначеЕсли Режим = 3 Тогда
							Прервать;
						КонецЕсли;
					КонецЦикла;
					Значение	= Массив;
					Возврат 0;
				ИначеЕсли (Х = "]") ИЛИ (Х = "}") Тогда
					// Закончился массив/объект
					Если (ЗначениеВСтроке = "") И (Кавычек = 0) Тогда
						Возврат 3; // Нет значения и конец массива/объекта
					Иначе
						Значение	= ПолучитьЗначениеИзСтроки(ЗначениеВСтроке,Кавычек);
						Возврат 1; // Есть значение и конец массива/объекта
					КонецЕсли;
				ИначеЕсли Х = ":" Тогда
					Ключ	= ЗначениеВСтроке;
					Возврат ПолучитьЗначениеJSON(СтрJSON, Значение, Позиция);
				Иначе
					// Запятая
					Прервать;
				КонецЕсли;
			Иначе
				ЗначениеВСтроке	= ЗначениеВСтроке + Х;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Если Кавычек > 0 Тогда
		Значение = ЗначениеВКавычках(ЗначениеВСтроке);
	Иначе
		Если ЗначениеВСтроке = "" Тогда
			Возврат 2;
		Иначе
			Значение	= ЗначениеБезКавычек(ЗначениеВСтроке);
		КонецЕсли;
	КонецЕсли;
	Возврат 0;
КонецФункции 

#КонецОбласти

#Область Asterisk

&НаКлиенте
Процедура ПодключитьПанель_Asterisk()
	
	ПодключенКАТС = Ложь;
	Результат = Ложь;
	Попытка
		Результат = ПодключитьКомпоненту_Asterisk_Синхронно();
	Исключение
		ПоказатьОповещениеПользователя("Не удалось установить компоненту для АТС Asterisk " + ОписаниеОшибки());
		Возврат;
	КонецПопытки;
	
	Если НЕ Результат Тогда
		ПоказатьОповещениеПользователя("Не удалось подключить компоненту для АТС Asterisk");
		Возврат;
	КонецЕсли;
	
	ПодключитьсяКСерверуAsterisk();
	
КонецПроцедуры		
		
&НаКлиенте
Процедура ПодключитьсяКСерверуAsterisk()

	//подключаемся к серверу
	// IP-адрес или DNS-имя должны быть указаны обязательно
	Если Не ЗначениеЗаполнено(СерверAsterisk) Тогда
		ПоказатьОповещениеПользователя("Не указан параметр соединения: IP-адрес сервера телефонии");
		Возврат;
	КонецЕсли;
	
	Успешно = Ложь;
	Попытка
		Успешно = ПанельRomAsterisk.Подключиться(СерверAsterisk, ПортAsterisk);
	Исключение
		ПоказатьОповещениеПользователя("Не удалось подключиться к серверу ip-телефонии. " + ОписаниеОшибки());
		Возврат;
	КонецПопытки;
	
	Если ПанельRomAsterisk = Неопределено 
		ИЛИ НЕ Успешно = Истина Тогда
		ПодключенКАТС = Ложь;
		Возврат;
	КонецЕсли;
	
	// установки режима вывода всех сообщений сокета во внешнее событие
	ПанельRomAsterisk.УстановитьРежимПрослушивания(Истина);
	
	CRLF = Chars.CR+Chars.LF;
	ТекстКоманды=
		"Action: Login"+CRLF+
		"Username: "+ЛогинАТС+CRLF+
		"Secret: "+ПарольАТС+CRLF+CRLF;
	
	УспешнаяОтправка = ПанельRomAsterisk.ВыполнитьКоманду(ТекстКоманды);
	
	ПодключенКАТС = Истина;
	УстановитьСтатусПользовательПодключен(ПодключенКАТС);
	ОтключитьОбработчикОжидания("ПодключитьсяКСерверуAsterisk");
	
	//применим наложение фильтра на получение событий
	Если Вариант53_Asterisk 
		ИЛИ Вариант296_Asterisk
		ИЛИ Вариант85_Asterisk // #11582 для получения "родительского" звонка, в котором хранится информация о внешней линии
		Тогда
		// для указанных вариантов получаем все события Newchannel
		// для варианта 296 использется для получения "родительского" звонка, в котором хранится информация о внешней линии
		РегулярноеВыражение = "DialBegin.{1,}?ВнутреннийНомер|Newchannel|AgentCalled.{1,}?ВнутреннийНомер|Hangup.{1,}?ВнутреннийНомер|BridgeEnter.{1,}?ВнутреннийНомер|Disconnect.{1,}?ВнутреннийНомер|AgentConnect.{1,}?ВнутреннийНомер|Bridge.{1,}?ВнутреннийНомер|Dial.{1,}?ВнутреннийНомер";
		
	ИначеЕсли Вариант296_1_Asterisk Тогда
		// "режем сильно" 
		РегулярноеВыражение = "Newchannel.{1,}?from-trunk-custom|DialBegin.{1,}?RING|Hangup.{1,}?ВнутреннийНомер|BridgeEnter.{1,}?ВнутреннийНомер|Disconnect.{1,}?ВнутреннийНомер";
		
	Иначе
		РегулярноеВыражение = "DialBegin.{1,}?ВнутреннийНомер|Newchannel.{1,}?ВнутреннийНомер|AgentCalled.{1,}?ВнутреннийНомер|Hangup.{1,}?ВнутреннийНомер|BridgeEnter.{1,}?ВнутреннийНомер|Disconnect.{1,}?ВнутреннийНомер|AgentConnect.{1,}?ВнутреннийНомер|Bridge.{1,}?ВнутреннийНомер|Dial.{1,}?ВнутреннийНомер";
	КонецЕсли;
	
	РегулярноеВыражение = СтрЗаменить(РегулярноеВыражение,"ВнутреннийНомер",ВнутреннийНомер);
	ПанельRomAsterisk.УстановитьРегулярноеВыражение(РегулярноеВыражение);
	
	// клиент 296: на стороне АТС раз в час срабатывает: "core restart when convenient", в результате соединение теряется
	Если ПодключенКАТС И ИнтервалПроверкиПодключенияКАТС > 0 Тогда
		ОтключитьОбработчикОжидания("ПроверитьПодключениеКАТС");
		ПодключитьОбработчикОжидания("ПроверитьПодключениеКАТС", ИнтервалПроверкиПодключенияКАТС, Ложь);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ПодключитьКомпоненту_Asterisk_Синхронно()
	
	ИмяМакета = "ОбщийМакет.SC_AsteriskZIP";
	
	// попытка установить компоненту
	Результат = ПодключитьВнешнююКомпоненту(ИмяМакета, "SmartCeiling");
	
	Если Не Результат Тогда
		
		// неудачно, возможно еще не установлен
		УстановитьВнешнююКомпоненту(ИмяМакета);
		Результат = ПодключитьВнешнююКомпоненту(ИмяМакета, "SmartCeiling");
		
	КонецЕсли; 
	
	// флаг, создание объекта
	ФлагПодключенияВК = Результат;
	Если Результат Тогда
		ПанельRomAsterisk = Новый("AddIn.SmartCeiling.SC-Asterisk-Native");
	КонецЕсли; 
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция ДействияПриПоднятииТрубки_Asterisk(НомерАбонента, ИДЗвонка, ИДСессииЗвонка="")
	
	Оповестить( "ПоднятиеТрубки_Asterisk", Новый Структура("НомерАбонента, ИДЗвонка, ИДСессииЗвонка", НомерАбонента, ИДЗвонка, ИДСессииЗвонка) );
		
КонецФункции

&НаКлиенте
Процедура Вариант_53_Asterisk(ВидСобытия, ДанныеСобытия)
	
	Если ВидСобытия = "NEWCHANNEL" Тогда
		
		ВнешняяЛиния = ДанныеСобытия.Получить("Exten");
		НомерАбонента = ДанныеСобытия.Получить("CallerIDNum");
		ИдЗвонка = ДанныеСобытия.Получить("Uniqueid");       //2022-06-08
		ИдЗвонкаДоТочки = ПолучитьИдСобытияДоТочки(ИдЗвонка);
		
		Если НЕ ПустаяСтрока(ВнешняяЛиния) Тогда
			//пришло событие с входящим звонком на очередь, тут нет номера внутреннего абонента
			//копим историю
			НоваяСтрока = ИсторияAsterisk.Добавить();
			НоваяСтрока.Event = ВидСобытия;
			НоваяСтрока.Uniqueid = ИдЗвонкаДоТочки;
			НоваяСтрока.Exten = ВнешняяЛиния;
			НоваяСтрока.ДанныеСобытия = ДанныеСобытия;
			НоваяСтрока.CallerID2 = ДанныеСобытия.Получить("CallerIDNum");
			НоваяСтрока.Uniqueid1 = ИдЗвонка; //2022-06-08
			
		ИначеЕсли СокрЛП(НомерАбонента) = СокрЛП(ВнутреннийНомер) Тогда
			//событие звонка упало на наш внутренний номер
			
			//найдем внешнюю линию в истории
			ОтборСтрок = Новый Структура;
			ОтборСтрок.Вставить("Uniqueid", ИдЗвонкаДоТочки);
			НайденныеСтроки = ИсторияAsterisk.НайтиСтроки(ОтборСтрок);
			Если НайденныеСтроки.Количество() > 0 Тогда
				ВнешняяЛиния = НайденныеСтроки[0].Exten;
				КтоЗвонит = НайденныеСтроки[0].CallerID2;
				ИдСессииЗвонка  = НайденныеСтроки[0].Uniqueid1; //2022-06-08
			КонецЕсли;
			
			//2022-06-08
			//ДействияПриНачалеВходящегоЗвонка(КтоЗвонит, ВнешняяЛиния, ВнутреннийНомер, ИдЗвонкаДоТочки);
			ДействияПриНачалеВходящегоЗвонка(КтоЗвонит, ВнешняяЛиния, ВнутреннийНомер, ИдЗвонка, ИдСессииЗвонка);
			
		КонецЕсли;
		
	ИначеЕсли ВРег(ВидСобытия) = "BRIDGE" Тогда
		
		//2022-06-08 переделано: было на форме входящего звонка
		
		ИДЗвонка = ДанныеСобытия.Получить("Uniqueid2");
		ИДСессии = ДанныеСобытия.Получить("Uniqueid1");
		Bridgestate = ДанныеСобытия.Получить("Bridgestate");  // LINK / UNLINK
		CallerID2 = ДанныеСобытия.Получить("CallerID2");
		
		Если ВРег(Bridgestate) = "LINK" Тогда
					
			Если СокрЛП(CallerID2) = СокрЛП(ВнутреннийНомер) Тогда
				//создался канал между 2 мя - подняли трубку и начали разговор
				ЗакрытьФормуВходящегоЗвонка(ИДЗвонка);
				
				НомерАбонента = СофтФон.ПолучитьНомерТелефонаВМеждународномФорматеПользователя(СокрЛП(ДанныеСобытия.Получить("CallerID1")));
				ДействияПриПоднятииТрубки_Asterisk(НомерАбонента, ИДЗвонка, ИДСессии);
			КонецЕсли;
			
			ЗакрытьФормуВходящегоЗвонка(ИДСессии); // для закрытия формы входящео звонка у других пользователей
		КонецЕсли;
		
	ИначеЕсли ВидСобытия = "HANGUP" Тогда
		
		//Разорвал канал - положили трубку или разговор окончен - закрываем окно входящего звонка
		
		//2022-06-08 переделано
		
		//CallerIDNum = ДанныеСобытия.Получить("CallerIDNum");
		//ConnectedLineNum = ДанныеСобытия.Получить("ConnectedLineNum");
		//ConnectedLineNum = СофтФон.ПолучитьНомерТелефонаВМеждународномФорматеПользователя(ConnectedLineNum);
		//Channel = ДанныеСобытия.Получить("Channel");
		//
		//Если (СокрЛП(CallerIDNum) = СокрЛП(ВнутреннийНомер) или (СтрНайти(Channel,"SIP/"+ВнутреннийНомер)=1)) и СокрЛП(ConnectedLineNum) = СокрЛП(НомерАбонента) Тогда
		//	Закрыть();
		//КонецЕсли;
		
		ИдЗвонка = ДанныеСобытия.Получить("Uniqueid");
		ЗакрытьФормуВходящегоЗвонка(ИдЗвонка);
		ИсторияAsterisk.Очистить();
		
	КонецЕсли;

	
КонецПроцедуры

&НаКлиенте
Процедура Вариант_85_Asterisk(ВидСобытия, ДанныеСобытия)
	
	Если ВРег(ВидСобытия)="DIALBEGIN" Тогда
		
		//Начался звонок до поднятия трубки. Тут показываем окошко входящего звонка
		CallerID = ДанныеСобытия.Получить("CallerIDNum");
		DestCallerIDNum = ДанныеСобытия.Получить("DestCallerIDNum");
		
		Если НЕ СокрЛП(ВнутреннийНомер) = СокрЛП(CallerID) 
			И СокрЛП(ВнутреннийНомер) = СокрЛП(DestCallerIDNum) Тогда //ROM-Asterisk сначала звонит самому себе при исходящем звонке, такие события нужно исключить, реагируем когда позвонили именно нам
			
			НомерАбонента = ДанныеСобытия.Получить("DestConnectedLineNum");
			ВнешняяЛиния = "";
			ВнутреннийНомер = ВнутреннийНомер;
			
			//найдем внешнюю линию в истории
			ИдЗвонка = ДанныеСобытия.Получить("DestLinkedid");
			ОтборСтрок = Новый Структура;
			ОтборСтрок.Вставить("Uniqueid",ИдЗвонка);
			НайденныеСтроки = ИсторияAsterisk.НайтиСтроки(ОтборСтрок);
			Если НайденныеСтроки.Количество() > 0 Тогда
				ВнешняяЛиния = НайденныеСтроки[0].Exten;
			КонецЕсли;
			// для клиента 164 (14.0)
			Если ПустаяСтрока(ВнешняяЛиния) И НЕ ДанныеСобытия.Получить("ConnectedLineNum") = Неопределено Тогда
				ВнешняяЛиния = ДанныеСобытия.Получить("ConnectedLineNum");
			КонецЕсли;
						 
			Если НЕ НомерАбонента = ВнутреннийНомер Тогда	// обратный звонок АТС при исходящем звонке из 1с				
				ДействияПриНачалеВходящегоЗвонка(НомерАбонента, ВнешняяЛиния, ВнутреннийНомер, ИдЗвонка);				
			КонецЕсли;
			
		КонецЕсли;
		
	ИначеЕсли ВРег(ВидСобытия)="NEWCHANNEL" Тогда
		
		CallerID=ДанныеСобытия.Получить("CallerIDNum");
		Если НЕ СокрЛП(ВнутреннийНомер) = СокрЛП(CallerID) Тогда
			//копим историю
			НоваяСтрока = ИсторияAsterisk.Добавить();
			НоваяСтрока.Event = ВидСобытия;
			НоваяСтрока.Uniqueid = ДанныеСобытия.Получить("Uniqueid");
			НоваяСтрока.Uniqueid1 = ДанныеСобытия.Получить("Linkedid");
			НоваяСтрока.Exten = ДанныеСобытия.Получить("Exten");
			НоваяСтрока.ДанныеСобытия = ДанныеСобытия;
		КонецЕсли;
		
	КонецЕсли;

	
КонецПроцедуры

&НаКлиенте
Процедура Вариант_85_2_Asterisk(ВидСобытия, ДанныеСобытия)
	
	Если ВРег(ВидСобытия)="AGENTCALLED" Тогда
		
		//Начался звонок до поднятия трубки. Тут показываем окошко входящего звонка
		CallerID = ДанныеСобытия.Получить("CallerIDNum"); //номер телефона клиента (кто звонит)
		Interface = ДанныеСобытия.Получить("Interface"); //строка вида "SIP/ВнутреннийНомер"
		ИдЗвонка = ДанныеСобытия.Получить("Linkedid");
		
		Если НЕ СокрЛП(ВнутреннийНомер) = СокрЛП(CallerID) 
			И СтрНайти(Interface, СокрЛП(ВнутреннийНомер)) > 0 Тогда //ROM-Asterisk сначала звонит самому себе при исходящем звонке, такие события нужно исключить, реагируем когда позвонили именно нам
			
			НомерАбонента = CallerID;
			ВнешняяЛиния = ДанныеСобытия.Получить("Exten");
			
			ДействияПриНачалеВходящегоЗвонка(НомерАбонента, ВнешняяЛиния, ВнутреннийНомер, ИдЗвонка);
			
		КонецЕсли;
		
		
    // перенесено с формы входящего звонка, не проверялось
	ИначеЕсли ВРег(ВидСобытия) = "AGENTCONNECT" Тогда
		
		//создался канал между 2 мя - подняли трубку и начали разговор
		Interface = ДанныеСобытия.Получить("Interface"); //внутренний номер пользователя в формате "SIP/ВнутреннийНомер"
		CallerIDNum = ДанныеСобытия.Получить("CallerIDNum"); //номер телефона клиента (кто звонит)
		НомерАбонента = СофтФон.ПолучитьНомерТелефонаВМеждународномФорматеПользователя(CallerIDNum);
		ИдЗвонка = ДанныеСобытия.Получить("Linkedid");
		
		Если СокрЛП(Interface) = "SIP/"+СокрЛП(ВнутреннийНомер) Тогда	
			ДействияПриПоднятииТрубки_Asterisk(НомерАбонента, ИдЗвонка);
		КонецЕсли;
		
		ЗакрытьФормуВходящегоЗвонка(ИдЗвонка);	
		
	// 2022-10-05
	ИначеЕсли ВРег(ВидСобытия) = "HANGUP" Тогда	
		
		//Разорвал канал - положили трубку или разговор окончен - закрываем окно входящего звонка
		Channel = ДанныеСобытия.Получить("Channel");
		ИдЗвонка = ДанныеСобытия.Получить("Linkedid");
		
		Если (СтрНайти(Channel, "SIP/"+ВнутреннийНомер)=1)  
			Тогда
			ЗакрытьФормуВходящегоЗвонка(ИдЗвонка);
			//ИсторияAsterisk.Очистить();
		КонецЕсли;

				
	КонецЕсли;
	
КонецПроцедуры

