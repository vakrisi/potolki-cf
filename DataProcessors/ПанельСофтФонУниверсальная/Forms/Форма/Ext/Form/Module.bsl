&НаКлиенте
Функция ОбработкаСписокЛиний_Mango(Данные)

	Содержимое=Данные.Получить("lines");
	Если Не ТипЗнч(Содержимое)=Тип("Массив") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ПараметрыОтбора=Новый Структура;
	
	Для каждого ЭлементМассива Из Содержимое Цикл
					
		ИД=ЭлементМассива.Получить("line_id");
		
		ПараметрыОтбора.Вставить("ИД",ИД);
		МассивСтрок=Линии_Mango.НайтиСтроки(ПараметрыОтбора);
		Если МассивСтрок.Количество()>0 Тогда
			СтрЛинии=МассивСтрок[0];
		Иначе
			СтрЛинии=Линии_Mango.Добавить();
		КонецЕсли; 
		СтрЛинии.УчетнаяЗапись=ЭлементМассива.Получить("number");;
		СтрЛинии.Номер=ЭлементМассива.Получить("name");;
					
	КонецЦикла;
	
КонецФункции

&НаКлиенте
Функция ПолучитьИсторию_Mango(Дата1, Дата2)

	Поля=",'fields':'records,start,finish,from_extension,from_number,to_extension,to_number,disconnect_reason,entry_id,answer,line_number,location'";
	ИДЗапроса="'api.history.load'";	// условный ИД
	ДанныеJSON="{'date_from':'"+ПолучитьДатуUT(УниверсальноеВремя(Дата1))+"','date_to':'"+ПолучитьДатуUT(УниверсальноеВремя(Дата2))+"'"+Поля+",'request_id':"+ИДЗапроса+"}";
		
	Подпись = ПодписатьПакет_Mango(СофтФонКлиентСервер.Stringify(ДанныеJSON));
	ТелоЗапроса = "vpbx_api_key=" + КлючAPI + "&sign=" + Подпись + "&json=" + КодироватьДанныеПакета(СофтФонКлиентСервер.Stringify(ДанныеJSON));

	// обработка запроса 
	Ресурс = "/vpbx/stats/request";
	
	Заголовки = Новый Соответствие;	
	Заголовки.Вставить("Content-Type", "application/x-www-form-urlencoded");

	Данные = ВыполнитьRestЗапрос("POST", ДоменAPI, Ресурс, Заголовки, ТелоЗапроса);

	Если НЕ Данные = Неопределено Тогда
		Если ЭтоОшибка_Mango(Данные) Тогда
			Возврат Ложь;
		КонецЕсли;
		
		// в ответ должен вернуться ключ
		КлючИстории = Данные.Получить("key");
		Если Не ЗначениеЗаполнено(КлючИстории) Тогда
			СтрСообщения = "Запрос истории не выполнен";
			Если ЗначениеЗаполнено(Данные.Получить("message")) Тогда
				СтрСообщения=Данные.Получить("message");
			КонецЕсли; 
			ПоказатьОповещениеПользователя("Ошибка запроса истории", , СтрСообщения);			
		Иначе			
			ПолучитьИсториюПоКлючу_Mango(КлючИстории);
		КонецЕсли;
				
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Функция ПолучитьИсториюПоКлючу_Mango(КлючИстории)

