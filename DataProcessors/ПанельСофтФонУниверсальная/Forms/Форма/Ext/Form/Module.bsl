&НаКлиенте
Функция ОбработкаСобытий_Mango(СобытиеПакета, ДанныеСобытия, ДополнительныеМетодыЗапроса)
	
	ДанныеСобытия = СтрЗаменить(ДанныеСобытия, "\""", """");
	//Данные = СофтФонКлиентСервер.ПолучитьДанныеJSON(ДанныеСобытия, Истина);	
	Данные = СофтФонКлиентСервер.URL2JSON(ДанныеСобытия, Истина); //2022-05-23	
	Если Данные = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Данные = Данные.Получить("json");
	Если Данные = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если ДополнительныеМетодыЗапроса = "events/call" Тогда
		
		ТипСобытияЗвонка = Данные.Получить("call_state");
		Если ТипСобытияЗвонка=Неопределено Тогда
			Возврат Ложь;
		КонецЕсли; 
		
		Если НРег(ТипСобытияЗвонка)="appeared" Тогда
		
			// начало звонка
			ОбработкаНачалаЗвонка_Mango(Данные);
		
		ИначеЕсли НРег(ТипСобытияЗвонка)="connected" Тогда
		
			// соединение
			ОбработкаСоединенияЗвонка_Mango(Данные);
		
		ИначеЕсли НРег(ТипСобытияЗвонка)="onhold" Тогда
		
			// удержание
			//ОбработкаУдержанияЗвонка(СодержимоеПакета);
		
		ИначеЕсли НРег(ТипСобытияЗвонка)="disconnected" Тогда
		
			// завершение
			ОбработкаЗавершенияЗвонка_Mango(Данные);
		
		КонецЕсли; 
	КонецЕсли; 
	
КонецФункции

&НаКлиенте
Функция ОбработкаНачалаЗвонка_Mango(Данные)

	ИД = Данные.Получить("entry_id");
	Если ИД = Неопределено  Тогда
		Возврат Ложь;
	КонецЕсли;
	
	СтрТекущиеЗвонки = ПолучитьСтрокуТекущегоЗвонка_Mango(ИД);
	
	СтрТекущиеЗвонки.call_id			= Данные.Получить("call_id");
	СтрТекущиеЗвонки.timestamp			= Данные.Получить("timestamp");
	СтрТекущиеЗвонки.seq				= Данные.Получить("seq");
	СтрТекущиеЗвонки.call_state			= Данные.Получить("call_state");
	СтрТекущиеЗвонки.location			= Данные.Получить("location");
	СтрТекущиеЗвонки.disconnect_reason	= Данные.Получить("disconnect_reason");
	СтрТекущиеЗвонки.command_id			= Данные.Получить("command_id");
	
	Откуда = Данные.Получить("from");
	Если Не Откуда=Неопределено Тогда
		СтрТекущиеЗвонки.from_extension=	Откуда.Получить("extension");
		СтрТекущиеЗвонки.from_number=		Откуда.Получить("number");
		СтрТекущиеЗвонки.taken_from_call_id=Откуда.Получить("taken_from_call_id");
	КонецЕсли; 
	
	Куда=Данные.Получить("to");
	Если Не Куда=Неопределено Тогда
		СтрТекущиеЗвонки.to_extension=	Куда.Получить("extension");
		СтрТекущиеЗвонки.to_number=		Куда.Получить("number");
		СтрТекущиеЗвонки.to_line_number=Куда.Получить("line_number");
		СтрТекущиеЗвонки.acd_group=		Куда.Получить("acd_group");
	КонецЕсли; 
	
	// внутренние не регистрируются
	ЭтоВнутренний = СофтФонКлиентСервер.ЭтоВнутренний_Mango(СтрТекущиеЗвонки.from_number,СтрТекущиеЗвонки.to_number);
	Если ЭтоВнутренний Тогда
		//ОбновитьСтатусВнутреннегоНомера(СтрТекущиеЗвонки.from_extension,2,ИД);
		//ОбновитьСтатусВнутреннегоНомера(СтрТекущиеЗвонки.to_extension,2,ИД);
		Возврат Ложь;
	КонецЕсли; 
	
	ЭтоЗвонокAPI=(Найти(СтрТекущиеЗвонки.command_id,"api.outgoing.")>0);
	ЭтоВходящий=(Откуда.Получить("extension")=Неопределено И Не ЭтоЗвонокAPI);
	СтрТекущиеЗвонки.Входящий=ЭтоВходящий;
	
	// определения номеров
	Номер=СтрТекущиеЗвонки.to_number;
	ВнутрНомер=СтрТекущиеЗвонки.from_extension;
	Если ЭтоВходящий=Истина Тогда
		Номер=СтрТекущиеЗвонки.from_number;
		ВнутрНомер=СтрТекущиеЗвонки.to_extension;
	КонецЕсли;
	СтрТекущиеЗвонки.Номер=Номер;
	СтрТекущиеЗвонки.ВнутрНомер=ВнутрНомер;
	СтрТекущиеЗвонки.Входящий=ЭтоВходящий;
	
	// маршрутизация на ответственного
	Если ЭтоВходящий=Истина Тогда
		Если СтрТекущиеЗвонки.location="ivr" Тогда
			//ВыполнитьМаршрутизацию(СтрТекущиеЗвонки);
		КонецЕсли; 
	КонецЕсли; 
	
	// действия по отлеживаемому внутреннему номеру
	Если ВнутрНомер=ВнутреннийНомер Тогда
		
		Если Не СофтФонКлиентСервер.ЭтоВнутренний_Mango(СтрТекущиеЗвонки.from_number,СтрТекущиеЗвонки.to_number) Тогда
		 
			Состояние="Вызов";
			ВнешняяЛиния=ПолучитьПредставлениеЛинии_Mango(СтрТекущиеЗвонки.to_line_number);
			СтрТекущиеЗвонки.Линия=ВнешняяЛиния;
			НомерАбонента=Номер;
			
			НаправлениеЗвонка="Исходящий";
			Если ЭтоВходящий=Истина Тогда
				НаправлениеЗвонка="Входящий";
				ДействияПриНачалеВходящегоЗвонка(НомерАбонента, ВнешняяЛиния, ВнутреннийНомер, ИД);
			КонецЕсли; 
		
		КонецЕсли; 
	
	КонецЕсли; 

	// обновление списка внутренних
	Если НРег(СтрТекущиеЗвонки.location)="abonent" Тогда
		//ОбновитьСтатусВнутреннегоНомера(ВнутрНомер,2,ИД);
	КонецЕсли; 
		
КонецФункции

