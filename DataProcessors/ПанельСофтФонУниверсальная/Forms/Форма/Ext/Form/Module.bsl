&НаКлиенте
Функция ОбработкаСписокSIP_UIS(Данные)
	
	Результат = Данные.Получить("result");
	Если Результат=Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;	
	ДанныеКоллекция = Результат.Получить("data");
	Если ДанныеКоллекция = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если Не ТипЗнч(ДанныеКоллекция)=Тип("Массив") Тогда
		Возврат Ложь;
	КонецЕсли; 
	
	Для каждого ЭлементМассива Из ДанныеКоллекция Цикл
		
		ИД=Формат(ЭлементМассива.Получить("employee_id"),"ЧГ=0");
		Статус=(ЭлементМассива.Получить("physical_state")="Зарегистрирован");
		
		Если ИД=ВнутреннийИД_UIS Тогда
			//СтатусТелефона=Статус;
			ВнутреннийВиртНомер_UIS=ЭлементМассива.Получить("virtual_phone_number");
			//ВнутреннийSIPНомер=ЭлементМассива.Получить("phone_number");
			Продолжить;
		КонецЕсли; 
		
		ПараметрыОтбора=Новый Структура;
