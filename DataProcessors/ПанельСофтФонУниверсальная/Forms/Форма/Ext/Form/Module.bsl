Функция ТекстANSI_UTF8(ТекстСообщения)
	
	// ANSI в UTF-8
	ПотокВПамяти = Новый ПотокВПамяти;			
	ЗаписьДанных = Новый ЗаписьДанных(ПотокВПамяти);
	ЗаписьДанных.ЗаписатьСтроку(ТекстСообщения, КодировкаТекста.ANSI);
	ЗаписьДанных.Закрыть();			
	ПотокВПамяти.Перейти(0, ПозицияВПотоке.Начало);			
	ЧтениеДанных = Новый ЧтениеДанных(ПотокВПамяти);
	Возврат ЧтениеДанных.ПрочитатьСтроку();
	
