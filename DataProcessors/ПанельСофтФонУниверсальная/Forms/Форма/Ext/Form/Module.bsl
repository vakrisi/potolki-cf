&НаКлиенте
Функция ПолучитьИсторию_Binotel(Дата1, Дата2)
	
	// без ключа все команды запрещены
	Если Не ЗначениеЗаполнено(КлючAPI) ИЛИ Не ЗначениеЗаполнено(ПарольAPI) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Дата1 = ?(ЗначениеЗаполнено(Дата1), Дата1, ТекущаяДата());
	Дата2 = ?(ЗначениеЗаполнено(Дата2), Дата2, ТекущаяДата());

	СтрДата1="'startTime':" + ПолучитьДатуUT(Дата1);
	СтрДата2=",'stopTime':" + ПолучитьДатуUT(Дата2);
	
	ТелоЗапроса = "{'startTime':" + ПолучитьДатуUT(Дата1) + ",'stopTime':" + ПолучитьДатуUT(Дата2) + ",'secret':'" + ПарольAPI + "','key':'" + КлючAPI + "'}";
	ТелоЗапроса = СофтФонКлиентСервер.Stringify(ТелоЗапроса);
	
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Content-Length", СтрДлина(ТелоЗапроса));
	Заголовки.Вставить("Content-Type", "application/json");
		
	Если НачалоДня(Дата1) = НачалоДня(Дата2) Тогда

		Ресурс = "/api/" + ВерсияAPI + "/stats/list-of-calls-for-period.json";		
		Данные = ВыполнитьRestЗапрос("POST", ДоменAPI, Ресурс, Заголовки, ТелоЗапроса);
		
		Если НЕ Данные = Неопределено Тогда
			Если ЭтоОшибка_Binotel(Данные) Тогда
				Возврат Ложь;
			КонецЕсли;
			
			ОбработкаИсторияАТС_Binotel(Данные);		
		КонецЕсли;
		
	Иначе
		// 2 запроса
		Ресурс = "/api/" + ВерсияAPI + "/stats/outgoing-calls-for-period.json";		
		Данные = ВыполнитьRestЗапрос("POST", ДоменAPI, Ресурс, Заголовки, ТелоЗапроса);
		
		Если НЕ Данные = Неопределено Тогда
			Если ЭтоОшибка_Binotel(Данные) Тогда
				Возврат Ложь;
			КонецЕсли;
			
			ОбработкаИсторияАТС_Binotel(Данные);		
		КонецЕсли;
		
		Ресурс = "/api/" + ВерсияAPI + "/stats/incoming-calls-for-period.json";		
		Данные = ВыполнитьRestЗапрос("POST", ДоменAPI, Ресурс, Заголовки, ТелоЗапроса);
		
		Если НЕ Данные = Неопределено Тогда
			Если ЭтоОшибка_Binotel(Данные) Тогда
				Возврат Ложь;
			КонецЕсли;
			
			ОбработкаИсторияАТС_Binotel(Данные);		
		КонецЕсли;
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Функция ОбработкаИсторияАТС_Binotel(Данные)

	КоллекцияЗвонки = Данные.Получить("callDetails");
	Если КоллекцияЗвонки=Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;	
		
	СтруктПараметры = Новый Структура;
	СтруктПараметры.Вставить("ВидАТС", ИДВАТС);
	СтруктПараметры.Вставить("ДатаЗапросаИстории", Неопределено);
	СтруктПараметры.Вставить("Данные", КоллекцияЗвонки);
	
	ОбработкаИсторияАТСКлиент(СтруктПараметры);
	
КонецФункции
	
&НаКлиенте
Функция ПолучитьФайлЗаписи_Binotel(ИДЗаписи)

	// без ключа все команды запрещены
	Если Не ЗначениеЗаполнено(КлючAPI) ИЛИ Не ЗначениеЗаполнено(ПарольAPI) Тогда
		Возврат Ложь;
	КонецЕсли; 
			
	ТелоЗапроса = "{'generalCallID':'" + ИДЗаписи + "','secret':'" + ПарольAPI + "','key':'" + КлючAPI + "'}";
	ТелоЗапроса = СофтФонКлиентСервер.Stringify(ТелоЗапроса);
	
	// обработка запроса 
	Ресурс = "/api/" + ВерсияAPI + "/stats/call-record.json";
	
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Content-Length", СтрДлина(ТелоЗапроса));
	Заголовки.Вставить("Content-Type", "application/json");

	Данные = ВыполнитьRestЗапрос("POST", ДоменAPI, Ресурс, Заголовки, ТелоЗапроса);

	Если НЕ Данные = Неопределено Тогда
		Если ЭтоОшибка_Binotel(Данные) Тогда
			Возврат Ложь;
		КонецЕсли;
		
		Успех = Данные.Получить("status");
		Если Не Успех="success" Тогда
			Возврат Ложь;
		КонецЕсли;
		
		// время жизни ссылки 15 минут	
		ФайлЗаписиСсылка = Данные.Получить("url");
		Если ЗначениеЗаполнено(ФайлЗаписиСсылка) Тогда				
			ОбработатьПолучениеСсылкиФайлаЗаписиЗвонка(РежимЗагрузкиЗаписиBinotel, ФайлЗаписиСсылка);
