		НоваяСтрока.Uniqueid2 = ДанныеСобытия.Получить("Uniqueid2");
		НоваяСтрока.Exten = "";
		НоваяСтрока.ДанныеСобытия = ДанныеСобытия;
		НоваяСтрока.CallerID2 = ДанныеСобытия.Получить("CallerID1");
		
	КонецЕсли;
		
	
	//отрабатываем события
	Если ВРег(ВидСобытия)="DIAL" Тогда
		Если ПользовательПринимаетВходящиеЗвонки() Тогда
			
			ВнутреннийНомерКудаУпалЗвонок = ДанныеСобытия.Получить("Dialstring");
			ВнутреннийНомерМод = СокрЛП(ВнутреннийНомер) + "@";
			Если СокрЛП(ВнутреннийНомерКудаУпалЗвонок) = СокрЛП(ВнутреннийНомер) 
				//ИЛИ Лев(СокрЛП(ВнутреннийНомерКудаУпалЗвонок), СтрДлина(ВнутреннийНомерМод)) = ВнутреннийНомерМод
				Тогда
				//к нам упал
				
				Отбор = Новый Структура;
				Отбор.Вставить("CallerID2", ДанныеСобытия.Получить("CallerIDNum"));
