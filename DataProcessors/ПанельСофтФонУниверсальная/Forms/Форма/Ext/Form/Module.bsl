&НаКлиенте
Функция ПолучитьСписокОператоров_ITooLabs()

	Ресурс = "/sys/crm_api.wcgp";	
	Метод = "?cmd=accounts&token=" + КлючAPI;
	    
	Заголовки = Новый Соответствие;	
	Заголовки.Вставить("Content-Type", "application/x-www-form-urlencoded; charset=UTF-8");
	Заголовки.Вставить("Accept", "application/json");

	Данные = ВыполнитьRestЗапрос("POST", ДоменAPI, Ресурс + Метод, Заголовки, , , Ложь);
	
	Если НЕ Данные = Неопределено Тогда		
		ОбработкаСписокОператоров_ITooLabs(Данные);
	КонецЕсли;

КонецФункции

&НаКлиенте
Функция ОбработкаСписокОператоров_ITooLabs(Данные)
	
	Если Не ТипЗнч(Данные)=Тип("Массив") Тогда
		Возврат Ложь;
	КонецЕсли; 
	
	ВнутренниеНомера_ITooLabs.Очистить();
	Для каждого ЭлементМассива Из Данные Цикл
		
		ВнутрНомер = Неопределено;
		ЭлементМассива.Свойство("ext", ВнутрНомер);
		Если ВнутрНомер=ВнутреннийНомер Тогда
			ЭлементМассива.Свойство("name", ВнутреннийЛогин_ITooLabs);
			Продолжить;
		КонецЕсли;
		
		СтрВнутренниеНомера=ВнутренниеНомера_ITooLabs.Добавить();
		ЭлементМассива.Свойство("ext",СтрВнутренниеНомера.Номер);
		ЭлементМассива.Свойство("name",СтрВнутренниеНомера.Имя);
		СтрВнутренниеНомера.ВнутреннийЛогин=СтрВнутренниеНомера.Имя+"@"+ДоменAPI;
		
	КонецЦикла;
		
КонецФункции

&НаКлиенте
Процедура ПолучитьИсторию_ITooLabs(Дата1, Дата2)
	
	Ресурс = "/sys/crm_api.wcgp";
		
	UTCДата1=ПолучитьДатуUTC(Дата1);
	UTCДата2=ПолучитьДатуUTC(Дата2);

	Метод = "?cmd=history&token=%1&start=%2&end=%3&limit=%4";
	Метод = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Метод, 
							КлючAPI,
							UTCДата1,
							UTCДата2,
							999);							
							    
	Заголовки = Новый Соответствие;	
	Заголовки.Вставить("Content-Type", "application/x-www-form-urlencoded; charset=UTF-8");
	Заголовки.Вставить("Accept", "application/json");
	
	Данные = ВыполнитьRestЗапрос("GET", ДоменAPI, Ресурс + Метод, Заголовки, , , , Истина);
	
	Если НЕ Данные = Неопределено Тогда		
		ОбработкаИсторияАТС_ITooLabs(Данные);
	КонецЕсли;
			
КонецПроцедуры

