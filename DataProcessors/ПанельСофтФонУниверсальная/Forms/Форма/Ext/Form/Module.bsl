Процедура ОбработатьПолучениеСсылкиФайлаЗаписиЗвонка(РежимЗагрузкиЗаписи, ФайлЗаписиСсылка)
	// РежимЗагрузкиЗаписи = 0 - открыть ссылку
	// РежимЗагрузкиЗаписи = 1 - скачать
	// РежимЗагрузкиЗаписи = 2 - скачать и запустить
	
	Если РежимЗагрузкиЗаписи = 0 Тогда
		// открыть по ссылке
		ОписаниеОповещения = Новый ОписаниеОповещения("ЗавершитьЗапускПриложения", СофтФонКлиент);
		НачатьЗапускПриложения(ОписаниеОповещения, ФайлЗаписиСсылка);
	ИначеЕсли РежимЗагрузкиЗаписи = 1 ИЛИ РежимЗагрузкиЗаписи = 2 Тогда
		ПараметрыЗаписи = Новый Структура("ФайлЗаписиСсылка, ЗапуститьПослеСкачивания, Каталог", ФайлЗаписиСсылка, РежимЗагрузкиЗаписи = 2, КаталогЗаписи);
		СофтФонКлиент.ПолучитьФайлЗаписиПоHttpСсылке(ПараметрыЗаписи);
	КонецЕсли;
	
