Функция ОбработкаСобытий_UIS(СобытиеПакета, ДанныеСобытия, Знач ДопПараметрыЗапроса)
	
	//++ 2022-11-88 (000000058)
	//ДанныеСобытия = СтрЗаменить(ДанныеСобытия, "\n", "");
	//ДанныеСобытия = СтрЗаменить(ДанныеСобытия, "\""", """");
	//Данные = СофтФонКлиентСервер.ПолучитьДанныеJSON(ДанныеСобытия, Истина);
	ДопПараметрыЗапроса = СтрЗаменить(ДопПараметрыЗапроса, "%5B", "");  // [ - зарезервированный символ JSON
	ДопПараметрыЗапроса = СтрЗаменить(ДопПараметрыЗапроса, "%5D", "");  // ] - зарезервированный символ JSON
	ДопПараметрыЗапроса = СтрЗаменить(ДопПараметрыЗапроса, "%7B", "");  // { - зарезервированный символ JSON
	ДопПараметрыЗапроса = СтрЗаменить(ДопПараметрыЗапроса, "%7D", "");  // } - зарезервированный символ JSON
	Данные = СофтФонКлиентСервер.URL2JSON(ДопПараметрыЗапроса, Истина);	
	//-- 2022-11-88
	
	Если Данные = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если ЭтоОшибка_UIS(Данные) Тогда
		Возврат Ложь;
	КонецЕсли;		
				
	Если ТипЗнч(Данные)=Тип("Соответствие") Тогда
		
		ВидСобытия = Данные.Получить("notification_mnemonic");
		
		Если НРег(ВидСобытия)="in_call_session" Тогда
			
			//ОбработкаСозданиеКанала(Данные);
			
		ИначеЕсли НРег(ВидСобытия)="out_call_session" Тогда
			
			//ОбработкаВызоваКанала(Данные);
			
		ИначеЕсли НРег(ВидСобытия)="call_proceeding" Тогда			
			//входящий звонок
			ОбработкаВызоваКанала_UIS(Данные);
			
		ИначеЕсли НРег(ВидСобытия)="call_connected" Тогда
			
			//подняли трубку
			ОбработкаОтветКанала_UIS(Данные);
			
		ИначеЕсли НРег(ВидСобытия)="talk_finished" Тогда
			
			ОбработкаЗакрытиеКанала_UIS(Данные);
			
		ИначеЕсли НРег(ВидСобытия)="call_session_finished" Тогда
			
			ОбработкаОкончанияЗвонка_UIS(Данные);
			
		КонецЕсли; 
		
	КонецЕсли; 
		
