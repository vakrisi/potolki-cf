				ДействияПриНачалеВходящегоЗвонка(НомерАбонента, ВнешняяЛиния, ВнутреннийНомер, ИдЗвонка);
								
			КонецЕсли;
			
		КонецЕсли;
		
	ИначеЕсли ВРег(ВидСобытия) = "BRIDGE" Тогда
		
		времИДсобытия = ПолучитьИдСобытияДоТочки(ДанныеСобытия.Получить("Uniqueid1"));
		
		Если СокрЛП(ДанныеСобытия.Получить("CallerID2")) = СокрЛП(ВнутреннийНомер) Тогда
			//создался канал между 2 мя - подняли трубку и начали разговор. Тут создаем документ "Лид"		
			НомерАбонента = СофтФон.ПолучитьНомерТелефонаВМеждународномФорматеПользователя(СокрЛП(ДанныеСобытия.Получить("CallerID1")));
			ДействияПриПоднятииТрубки_Asterisk(НомерАбонента, времИДсобытия);
		КонецЕсли; 
		ЗакрытьФормуВходящегоЗвонка(времИДсобытия);
		
	КонецЕсли;
	
КонецПроцедуры

