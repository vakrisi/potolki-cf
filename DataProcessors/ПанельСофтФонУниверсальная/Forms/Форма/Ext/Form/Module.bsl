Процедура ОбработкаСобытий_Вариант_296_Asterisk(ВидСобытия, ДанныеСобытия)
	
	// порядок событий
	// NEWCHANNEL с CallerIDName / Exten. Uniqueid = ИД1 - первый ид звонка (в частности используется в истории)
	// DIAL Dialstring = ВнутреннийНомер@...  UniqueID = ИД1, DestUniqueID = ИД2
	// DIAL Dialstring = ВнутреннийНомер. Только здесь должна появляться форма звонка. UniqueID = ИД3, DestUniqueID = ИД4
	// BRIDGE CallerID2 = ВнутреннийНомер. Подняли трубку
	// HANGUP CallerIDNum = ВнутреннийНомер. Сброс. Посылаем оповещение закрытия формы входящего звонка. ИД? 
	
	//копим историю звонков
	Если ВРег(ВидСобытия)="NEWCHANNEL" Тогда
		//1. Пришел звонок на наш внешний номер
		
		НоваяСтрока = ИсторияAsterisk.Добавить();
		НоваяСтрока.Event = ВРег(ВидСобытия);
		НоваяСтрока.Uniqueid = ДанныеСобытия.Получить("Uniqueid");
