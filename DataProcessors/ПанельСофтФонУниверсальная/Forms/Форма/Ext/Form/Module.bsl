&НаКлиенте
Функция ЭтоОшибка_Binotel(Данные)

	Если Не ТипЗнч(Данные)=Тип("Соответствие") Тогда
		Возврат Истина;
	КонецЕсли; 
	
	Статус=Данные.Получить("status");
	
	// обработка ошибок
	Если Статус="error" Тогда
		ТекстОшибки=ИнфоОшибок.Получить(Данные.Получить("message"));
		Если ТекстОшибки=Неопределено Тогда
			ТекстОшибки=Данные.Получить("message");
		КонецЕсли; 
		ПоказатьОповещениеПользователя("Ошибка",,ТекстОшибки);
		Возврат Истина;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

