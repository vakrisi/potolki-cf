&НаКлиенте
Функция ЭтоОшибка_Mango(Данные)

	// обработка ошибок
	Статус = Данные.Получить("status");
	Если Не Статус=Неопределено Тогда
		Если ТипЗнч(Статус)=Тип("Число") Тогда
			Если Статус>400 Тогда
				Текст=Данные.Получить("message");
				ИмяОшибки=Данные.Получить("name");
				КодОшибки=Данные.Получить("code");
				//Если Не Отладка Тогда
					Если ЗначениеЗаполнено(Текст) Тогда
						ПоказатьОповещениеПользователя(ИмяОшибки,,Текст);
					КонецЕсли; 
				//КонецЕсли;
				Возврат Истина;
			КонецЕсли;
		КонецЕсли; 
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции
	
&НаСервере
Функция ПодписатьПакет_Mango(JSONПакет)
	
	//sign = sha256(vpbx_api_key + json + vpbx_api_salt). 
	
	Хеш = Новый ХешированиеДанных(ХешФункция.SHA256);
	Хеш.Добавить(КлючAPI + JSONПакет + КлючДляПодписи);
	
	ДвДанныеСумма = Хеш.ХешСумма;
	СтрПодпись = НРег(Строка(ДвДанныеСумма));
	СтрПодпись = СтрЗаменить(СтрПодпись," ","");
	Возврат СтрПодпись;
	
КонецФункции

&НаКлиенте
Функция ПолучитьСписокОператоров_Mango(ИдентификаторСотрудника="")

	ДанныеJSON="{}";
	Если ЗначениеЗаполнено(ИдентификаторСотрудника) Тогда
		ДанныеJSON="{'extension':'"+ИдентификаторСотрудника+"'}";
	КонецЕсли;
	
	Подпись = ПодписатьПакет_Mango(СофтФонКлиентСервер.Stringify(ДанныеJSON));
	ТелоЗапроса = "vpbx_api_key=" + КлючAPI + "&sign=" + Подпись + "&json=" + КодироватьДанныеПакета(СофтФонКлиентСервер.Stringify(ДанныеJSON));

	// обработка запроса 
	Ресурс = "/vpbx/config/users/request";
	
	Заголовки = Новый Соответствие;	
	Заголовки.Вставить("Content-Type", "application/x-www-form-urlencoded");

	Данные = ВыполнитьRestЗапрос("POST", ДоменAPI, Ресурс, Заголовки, ТелоЗапроса);

	Если НЕ Данные = Неопределено Тогда
		Если ЭтоОшибка_Mango(Данные) Тогда
			Возврат Ложь;
		КонецЕсли;
		
		ОбработкаСписокОператоров_Mango(Данные);		
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Функция ОбработкаСписокОператоров_Mango(Данные)

	Содержимое = Данные.Получить("users");
	Если Не ТипЗнч(Содержимое)=Тип("Массив") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ПараметрыОтбора = Новый Структура;
	
	Для каждого ЭлементМассива Из Содержимое Цикл
		Попытка
			
			Общие=ЭлементМассива.Получить("general"); 
			Если Общие=Неопределено  Тогда
				Продолжить;
			КонецЕсли;
			
			Телефоны=ЭлементМассива.Получить("telephony");
			Если Телефоны=Неопределено  Тогда
				Продолжить;
			КонецЕсли;
			
			Номера=Телефоны.Получить("numbers");
			Если Номера=Неопределено  Тогда
				Продолжить;
			КонецЕсли; 
			
			Номер=Телефоны.Получить("extension");
			
			Для каждого ЭлементНомера Из Номера Цикл
				
				Протокол=ЭлементНомера.Получить("protocol");
				Статус=ЭлементНомера.Получить("status");
				УчЗапись=ЭлементНомера.Получить("number");
				
				Если НРег(Протокол)="sip" Тогда
					
					Если Не Номер=ВнутреннийНомер Тогда
						ПараметрыОтбора.Вставить("Номер",Номер);
						МассивСтрок=ВнутренниеНомера_Mango.НайтиСтроки(ПараметрыОтбора);
						Если МассивСтрок.Количество()>0 Тогда
							СтрВнутренниеНомера=МассивСтрок[0];
						Иначе
							СтрВнутренниеНомера=ВнутренниеНомера_Mango.Добавить();
						КонецЕсли; 
						СтрВнутренниеНомера.Номер=Номер;
						СтрВнутренниеНомера.Протокол=Протокол;
						СтрВнутренниеНомера.УчетнаяЗапись=УчЗапись;
						СтрВнутренниеНомера.Имя=Общие.Получить("name");
						СтрВнутренниеНомера.Статус=Макс((Статус="on"),СтрВнутренниеНомера.Статус);
					Иначе
						//СтатусТелефона=Макс((Статус="on"),СтатусТелефона);
						УчетнаяЗапись_Mango = УчЗапись;
					КонецЕсли;
					
				КонецЕсли; 
				
			КонецЦикла; 
			
		Исключение
		КонецПопытки; 
	КонецЦикла;
	
	//ЗаполнитьПользователей();
	ВнутренниеНомера_Mango.Сортировать("Номер");

