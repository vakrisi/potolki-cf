Функция ОбработкаЗавершенияЗвонкаПромежуточное_Sipuni(Данные)
	// здесь можно ничего не делать
	// будет сгенерировано ОбработкаЗавершенияЗвонка_Sipuni
		
КонецФункции

&НаКлиенте
Функция ПолучитьСтрокуТекущегоЗвонка_Sipuni(ИД, Создавать=Истина)

	Результат = Неопределено;
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("call_id", ИД);
	МассивСтрок = ТекущиеЗвонки_Sipuni.НайтиСтроки(ПараметрыОтбора);
	Если МассивСтрок.Количество()=0 Тогда
		Если Создавать Тогда
			Результат = ТекущиеЗвонки_Sipuni.Добавить();
			Результат.call_id=ИД;
		КонецЕсли;
	Иначе
		Результат=МассивСтрок[0];
	КонецЕсли;
	
	Возврат Результат;

КонецФункции

&НаКлиенте
Функция ЗаполнитьДанныеТекущиеЗвонки_Sipuni(СтрТекущиеЗвонки, Данные)

	Для каждого Элемент Из Данные Цикл
	
		ИДПоля=Элемент.Ключ;
		ЗначениеПоля=Элемент.Значение;
	
		Если Не ЗначениеПоля=Неопределено Тогда
			Если СтрТекущиеЗвонки.Свойство(ИДПоля) Тогда
				СтрТекущиеЗвонки[ИДПоля]=ЗначениеПоля;
			КонецЕсли; 
		КонецЕсли; 
		
	КонецЦикла; 
	
КонецФункции

&НаКлиенте
Функция ЗаполнитьЛинию_Sipuni(СтрТекущиеЗвонки)

	Если СтрТекущиеЗвонки.dst_type=1 И СтрТекущиеЗвонки.src_type=1 Тогда // оба номера внешние
		Если СтрТекущиеЗвонки.is_inner_call Тогда //НРег(СтрТекущиеЗвонки.treeName)="входящая" Тогда  // имя задается в настройках личного кабинета и может отличаться от "входящая"
			СтрТекущиеЗвонки.Линия = СтрТекущиеЗвонки.dst_num;
		КонецЕсли; 
	КонецЕсли; 
	
	//++ 2019-11-19
	Если СтрТекущиеЗвонки.dst_type=2 И СтрТекущиеЗвонки.src_type=1 Тогда // dst - внутренний,  src - внешний
		Если СтрТекущиеЗвонки.is_inner_call Тогда 
			СтрТекущиеЗвонки.Линия = СтрТекущиеЗвонки.treeName; // treeName - имя линии 
		КонецЕсли; 
	КонецЕсли;
	//-- 2019-11-19
	
КонецФункции

&НаКлиенте
Функция ЭтоВходящий_Sipuni(СтрТекущиеЗвонки)

	Результат=(СтрТекущиеЗвонки.src_type=1);
	Если СтрТекущиеЗвонки.src_type=СтрТекущиеЗвонки.dst_type Тогда
		Если СтрТекущиеЗвонки.src_type=1 Тогда
			// оба номера - внешние
			Результат = СтрТекущиеЗвонки.is_inner_call;//(НРег(СтрТекущиеЗвонки.treeName)="входящая"); нельзя проверять по имени транка, имя задается вличном кабинете и может отличаться
		Иначе
			// оба номера - внутрение
			Результат=Истина;
			Если СтрТекущиеЗвонки.short_src_num=ВнутреннийНомер Тогда
				Результат=Ложь;
			КонецЕсли; 
		КонецЕсли; 
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции
 
&НаКлиенте
Функция ЭтоВнутренний_Sipuni(СтрТекущиеЗвонки)

	Результат=(СтрТекущиеЗвонки.src_type=СтрТекущиеЗвонки.dst_type И СтрТекущиеЗвонки.src_type=2);
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция ДействияПриПоднятииТрубки_Sipuni(НомерАбонента, ИДЗвонка)
	
	Оповестить( "ПоднятиеТрубки_Sipuni", Новый Структура("НомерАбонента, ИДЗвонка", НомерАбонента, ИДЗвонка) );
		
КонецФункции

