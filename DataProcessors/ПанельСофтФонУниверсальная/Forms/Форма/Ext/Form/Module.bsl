&НаКлиенте
Функция ЭтоОшибка_UIS(Значение)
	
	ТекущийТип=ТипЗнч(Значение);
	Если ТекущийТип=Тип("Строка") Тогда
		ФлагОшибки=Найти(Значение,"{""error"":")>0;
		Если Не ФлагОшибки Тогда
			ФлагОшибки=Найти(Значение,"</html>")>0;
		КонецЕсли; 
	ИначеЕсли ТекущийТип=Тип("Соответствие") Тогда
		ФлагОшибки=Не (Значение.Получить("error")=Неопределено);
	КонецЕсли; 
	
	Возврат ФлагОшибки;
	
КонецФункции

