	Ресурс = "/apis/portal/v2/abonents/%1/call?phoneNumber=%2";
	
	//Номер телефона, на который будет совершен вызов в международном формате: 
	// + (YYY) ХХХ ХХ ХХ, где + - обязательный символ, YYY - Код страны, XXX- номер телефона. Ограничение длины телефона с учетом кода страны: Min - 8 цифр Max - 13 цифр
	
