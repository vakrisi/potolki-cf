&НаКлиенте
Процедура ВыполнитьИсходящийЗвонок(ТелефонКлиента, ИмяКлиента)
	
	Если СофтФон.ИспользуютсяСофтФон() Тогда
		Если НЕ ПанельСофтФон = Неопределено Тогда
			Если НЕ ПанельСофтФон.MakeCall("", ТелефонКлиента, , ИмяКлиента, ИмяКлиента,) = 0 Тогда
				Состояние("Не удалось соединиться с СофтФон");
			КонецЕсли;
		Иначе
			Состояние("Не удалось соединиться с СофтФон");
		КонецЕсли;
		
	ИначеЕсли ИспользуетсяROMAsterisk Тогда
		
		Контекст = СофтФон.ПолучитьКонтекстИсходящихЗвонков();
		Если Не ЗначениеЗаполнено(ВнутреннийНомер) Тогда
			Состояние("Не указан внутренний номер, с которого выполняется звонок");
			Возврат;
		КонецЕсли;
		
		СтрокаНабораЦифры = ПодготовитьНомерДляЗвонка(ТелефонКлиента);
		Если ПустаяСтрока(СтрокаНабораЦифры) Тогда
			Состояние("Телефонный номер должен содержать цифры");
			Возврат;
		КонецЕсли;
		
		//отправим комнду проверки на наличие запущенного программного телефона или подключенного аппаратного. ответ поймает и отработает функция в обработке "СофтФон"
		CRLF=Chars.CR+Chars.LF;
		ТекстКоманды = "Action: Command"+CRLF+
		"Command: sip show peer 118"+CRLF+CRLF;
		ПанельRomAsterisk.ВыполнитьКоманду(ТекстКоманды);
		
		//отправляем команду звонка
		CRLF=Chars.CR+Chars.LF;
		ТекстКоманды="Action: Originate"+CRLF+
		//"Channel: SIP/"+ВнутреннийНомер+CRLF+
		"Channel: "+КаналИсходящегоВызова+CRLF+
		"Context: "+Контекст+CRLF+
		"Exten: "+СтрокаНабораЦифры+CRLF+
		"Priority: 1"+CRLF+
		"Callerid: "+ВнутреннийНомер+CRLF+
		"Timeout: 30000"+CRLF+CRLF;
		
		ПанельRomAsterisk.ВыполнитьКоманду(ТекстКоманды);
		
	ИначеЕсли ИспользуетсяOnlinePBX Тогда
		
		Номер = СофтФон.ОставитьТолькоЦифры(ТелефонКлиента);
		Если Не ЗначениеЗаполнено(Номер) Тогда
			ПоказатьОповещениеПользователя("Не указан номер, куда выполняется звонок");
			Возврат;
		КонецЕсли; 
		Если Не ЗначениеЗаполнено(ВнутреннийНомер) Тогда
			ПоказатьОповещениеПользователя("Не указан внутренний номер");
			Возврат;
		КонецЕсли;
		
		ВыполнитьИсходящийЗвонок_OnlinePBX(Номер);
			
	ИначеЕсли ИспользуетсяМегафон ИЛИ ИспользуетсяDomRu Тогда
	
		Номер = СофтФон.ОставитьТолькоЦифры(ТелефонКлиента);
		Если ПустаяСтрока(Номер) Тогда
			ПоказатьОповещениеПользователя("Телефонный номер должен содержать цифры");
			Возврат;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(ВнутреннийНомер) Тогда
			Возврат;
		КонецЕсли;
		
		ВыполнитьИсходящийЗвонок_ITooLabs(Номер);
		
	ИначеЕсли ИспользуетсяUIS Тогда 
		
		Номер = СофтФон.ОставитьТолькоЦифры(ТелефонКлиента);
		Если ПустаяСтрока(Номер) Тогда
			ПоказатьОповещениеПользователя("Телефонный номер должен содержать цифры");
			Возврат;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(ВнутреннийНомер) Тогда
			Возврат;
		КонецЕсли;
		
		ВыполнитьИсходящийЗвонок_UIS(Номер);
		
	ИначеЕсли ИспользуетсяBinotel Тогда //++2020-06-29
		
		СтрокаНабораЦифры = ПодготовитьНомерДляЗвонка(ТелефонКлиента);
		Если ПустаяСтрока(СтрокаНабораЦифры) Тогда
			ПоказатьОповещениеПользователя("Телефонный номер должен содержать цифры");
			Возврат;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(ВнутреннийНомер) Тогда
			Возврат;
		КонецЕсли;
		
		ВыполнитьИсходящийЗвонок_Binotel(Номер);
		
	ИначеЕсли ИспользуетсяMango Тогда
	
		Номер = СофтФон.ОставитьТолькоЦифры(ТелефонКлиента);
		Если ПустаяСтрока(Номер) Тогда
			ПоказатьОповещениеПользователя("Телефонный номер должен содержать цифры");
			Возврат;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(ВнутреннийНомер) Тогда
			Возврат;
		КонецЕсли;
		
		ВыполнитьИсходящийЗвонок_Mango(Номер);
		
	ИначеЕсли ИспользуетсяPhonet Тогда //++2021-12
		
		ВыполнитьИсходящийЗвонок_Phonet(ТелефонКлиента);
		
	ИначеЕсли ИспользуетсяБилайн Тогда 
		
		//Номер телефона, на который будет совершен вызов в международном формате: 
		// + (YYY) ХХХ ХХ ХХ, где + - обязательный символ, YYY - Код страны, XXX- номер телефона. Ограничение длины телефона с учетом кода страны: Min - 8 цифр Max - 13 цифр
	
		Номер = Софтфон.ПолучитьНомерТелефонаВМеждународномФорматеПользователя(ТелефонКлиента);
		Если ПустаяСтрока(Номер) Тогда
			ПоказатьОповещениеПользователя("Телефонный номер должен содержать цифры");
			Возврат;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(ВнутреннийНомер) Тогда
			Возврат;
		КонецЕсли;
		
		ВыполнитьИсходящийЗвонок_Beeline(Номер);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ПодготовитьНомерДляЗвонка(Знач Номер)
	
	Номер = СтрЗаменить(Номер, "+7", "8");
	ТолькоЦифры="";
	Для Индекс=1 По СтрДлина(Номер) Цикл
		Символ=Сред(Номер,Индекс,1);
		Если КодСимвола(Символ)>47 и КодСимвола(Символ)<58 Тогда
			ТолькоЦифры=ТолькоЦифры+Символ;
		КонецЕсли; 
	КонецЦикла; 
	Возврат ТолькоЦифры;

