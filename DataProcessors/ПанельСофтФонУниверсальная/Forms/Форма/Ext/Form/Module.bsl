			//	ОтключитьОбработчикОжидания("ПодключитьсяКСерверуSC");
			//	Возврат;
			//КонецЕсли;
			//РезультатПодключения = ПанельRomHMac.Подключиться(КлючAPISC);
			
			СтрокаПодключения = СтрШаблон("{""action"": ""connection"", ""apiKey"": ""%1"", ""sipnumber"": ""%2"", ""siplogin"": ""%3""}", КлючAPISC, ВнутреннийНомер, ЛогинТелефонии);
			//РезультатПодключения = 
			// с версии компоненты 2.0 Подключиться - это процедура, а не функция
			ПанельRomHMac.Подключиться(СтрокаПодключения);
			
		КонецЕсли;		
	КонецЕсли;
	
	// ПодключенКАТС будет взводить после получения от сервера ответа во внешнем событии
	//ПодключенКАТС = ПанельRomHMac.Подключено;
	
