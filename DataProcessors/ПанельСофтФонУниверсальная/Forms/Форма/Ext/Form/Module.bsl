	Данные = ВыполнитьRestЗапрос("POST", ДоменAPI, Метод, Заголовки);

	Если НЕ Данные = Неопределено Тогда
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ОбработкаСобытий_Beeline(Событие, ДанныеПакета)
		
	Если Событие = "message" Тогда
		
		Если Лев(ДанныеПакета, 5) = "<?xml" Тогда				
			
			ДанныеПакета = СтрЗаменить(ДанныеПакета, АдресВнешнейСистемыДляВАТС, "beeline");
			
			ИмяСобытия = "";
			номерАбонента = "";
			ВнешняяЛиния = "";
			startTime = "";
			callId = "";
			targetId  = "";
			ПакетПрочитан = Истина;
				
			Попытка
				ЧтениеXML = Новый ЧтениеXML;
				ЧтениеXML.УстановитьСтроку(ДанныеПакета);
				
				// 1
				// Пакет = ФабрикаXDTO.ПрочитатьXML(ЧтениеXML);  не рабоатет чтение атрибутов внутри тегов
				
								
				СтекУзлов = Новый Массив;
				ТекущийПуть = "";
				
				Пока ЧтениеXML.Прочитать() Цикл
					
					Если ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
						СтекУзлов.Добавить(ЧтениеXML.Имя); 
						ТекущийПуть = СтрСоединить(СтекУзлов, "/");
						
						Если ЧтениеXML.Имя = "xsi:eventData" Тогда
							Пока ЧтениеXML.ПрочитатьАтрибут() Цикл
								Если ЧтениеXML.Имя = "xsi1:type" Тогда
									ИмяСобытия = ЧтениеXML.Значение;
								КонецЕсли;
							КонецЦикла;
									
						КонецЕсли;
						
					ИначеЕсли  ЧтениеXML.ТипУзла = ТипУзлаXML.Текст Тогда
						
						Если ТекущийПуть = "xsi:Event/xsi:eventData/xsi:call/xsi:remoteParty/xsi:address" Тогда
							НомерАбонента = СтрЗаменить(ЧтениеXML.Значение, "tel:", "");
							
						ИначеЕсли ТекущийПуть = "xsi:Event/xsi:eventData/xsi:call/xsi:redirections/xsi:redirection/xsi:party/xsi:address" Тогда
							ВнешняяЛиния = СтрЗаменить(ЧтениеXML.Значение, "tel:", "");
					
						ИначеЕсли ТекущийПуть = "xsi:Event/xsi:eventData/xsi:call/xsi:startTime" Тогда
							startTime = ЧтениеXML.Значение;
							
						ИначеЕсли ТекущийПуть = "xsi:Event/xsi:eventData/xsi:call/xsi:callId" Тогда
							callId = ЧтениеXML.Значение;							
							
						ИначеЕсли ТекущийПуть = "xsi:Event/xsi:targetId" Тогда
							targetId = ЧтениеXML.Значение;
							
						ИначеЕсли ТекущийПуть = "xsi:Event/xsi:subscriptionId" Тогда
							ИдПодписки = ЧтениеXML.Значение;
						КонецЕсли;						
						
					ИначеЕсли ЧтениеXML.ТипУзла = ТипУзлаXML.КонецЭлемента Тогда
						СтекУзлов.Удалить(СтекУзлов.Количество()-1);
						ТекущийПуть = СтрСоединить(СтекУзлов, "/");
					КонецЕсли;
					
				КонецЦикла;
				
				ЧтениеXML.Закрыть();
				
			Исключение
				ПакетПрочитан = Ложь;
			КонецПопытки;
			
			Если ПакетПрочитан
				И ИдПодписки = БилайнИДПодписки
				И targetId = ВнутреннийЛогин_Beeline Тогда
				
				Если ИмяСобытия = "xsi:CallReceivedEvent" Тогда
					// входящий звонок
					
					//НоваяСтрока = ИсторияБилайн.Добавить();
					//НоваяСтрока.Event = ИмяСобытия;
					//НоваяСтрока.startTime = startTime;
					//НоваяСтрока.callId = callId;
					//НоваяСтрока.Caller = НомерАбонента;
					
					ИДСессии = "";
					Если Не ПустаяСтрока(startTime) Тогда
						// поле нужно для сопоставления с историей звонков, где нет ИД
						// делаем самодельный составной ключ
						// отсекаем последние значения
						ИДСессии = Лев(startTime, СтрДлина(startTime)-3) + "_" + ВнутреннийНомер;
					КонецЕсли;
					ДействияПриНачалеВходящегоЗвонка(НомерАбонента, ВнешняяЛиния, ВнутреннийНомер, callId, ИДСессии);
					
				ИначеЕсли ИмяСобытия = "xsi:CallAnsweredEvent" Тогда
					
					// подняли трубку
					ДействияПриПоднятииТрубки_Beeline(НомерАбонента, callId);
					ЗакрытьФормуВходящегоЗвонка(callId);
		
					//НоваяСтрока = ИсторияБилайн.Добавить();
					//НоваяСтрока.Event = ИмяСобытия;
					//НоваяСтрока.startTime = startTime;
					//НоваяСтрока.callId = callId;
					//НоваяСтрока.Caller = НомерАбонента;					
					
				ИначеЕсли ИмяСобытия = "xsi:CallReleasedEvent" Тогда
					// при сбросе вызова либо абонентом, либо удаленной стороной
					// завершили звонок
					ЗакрытьФормуВходящегоЗвонка(callId);
					
				КонецЕсли;				
				
			КонецЕсли;
				
		КонецЕсли; 
		
	КонецЕсли; 
	
	
КонецФункции

&НаКлиенте
Функция ДействияПриПоднятииТрубки_Beeline(НомерАбонента, ИДЗвонка)
	
	Оповестить("ПоднятиеТрубки_Beeline", Новый Структура("НомерАбонента, ИДЗвонка", НомерАбонента, ИДЗвонка) );
		
