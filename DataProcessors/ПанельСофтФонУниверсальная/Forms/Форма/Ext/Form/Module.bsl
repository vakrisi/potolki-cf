&НаКлиенте
Процедура ПолучитьИсторию_Sipuni(Дата1, Дата2)

	ФорматДаты="ДФ=дд.ММ.гггг";
		
	Дата1 = ?(ЗначениеЗаполнено(Дата1), Дата1, ТекущаяДата());
	Дата2 = ?(ЗначениеЗаполнено(Дата2), Дата2, ТекущаяДата());
	
	СтрДата1 = Формат(Дата1,ФорматДаты);
	СтрДата2 = Формат(Дата2,ФорматДаты);
		
	ТипЗвонка		= "0"; //0 — Все звонки 1 — Входящий 2 — Исходящий 3 — Внутренний	
	СтатусЗвонка	= "0"; // 0 — Все звонки 1 — Пропущенный 2 — Принятый	
	НомерСхемы		= "";	
	НомерОткуда		= ""; 
	НомерКуда		= ""; 
	НомерОтветил	= "";
	anonymous		= "1"; 
	ТолькоНовыеКлиенты = "0";
		
	ДанныеJSON=
	"'user':'"+НомерВАТС+"',"+
	"'from':'"+СтрДата1+"',"+
	"'to':'"+СтрДата2+"',"+
	"'type':'"+ТипЗвонка+"',"+
	"'state':'"+СтатусЗвонка+"',"+
	"'tree':'"+НомерСхемы+"',"+
	"'fromNumber':'"+НомерОткуда+"',"+
	"'toNumber':'"+НомерКуда+"',"+
	"'toAnswer':'"+НомерОтветил+"',"+
	"'anonymous':'"+anonymous+"',"+
	"'firstTime':'"+ТолькоНовыеКлиенты+"'";
	
	ДанныеJSON="{"+ДанныеJSON+"}";
	Подпись=ПодписатьПакет_Sipuni(ДанныеJSON);
	ДанныеJSON=СортироватьПоляПакета_Sipuni(ДанныеJSON);
	ДанныеJSON="{"+ДанныеJSON+",'hash':'"+Подпись+"'}";
	ДанныеJSON=СофтФонКлиентСервер.Stringify(ДанныеJSON);
	
	ТелоЗапроса = СофтФонКлиентСервер.JSON2URL(ДанныеJSON) ;
	
	// обработка запроса 
	Ресурс = "/api/statistic/export";
	
	Заголовки = Новый Соответствие;	
	Заголовки.Вставить("Content-Type", "application/x-www-form-urlencoded");

	Данные = ВыполнитьRestЗапрос("POST", ДоменAPI, Ресурс, Заголовки, ТелоЗапроса, Ложь);

	Если НЕ Данные = Неопределено Тогда
		ОбработкаИсторияАТС_Sipuni(Данные);	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ОбработкаИсторияАТС_Sipuni(Данные)

	Если ЭтоОшибка_Sipuni(Данные) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	СтруктПараметры = Новый Структура;
	СтруктПараметры.Вставить("ВидАТС", ИДВАТС);
	СтруктПараметры.Вставить("ДатаЗапросаИстории", ТекущаяДата());
	СтруктПараметры.Вставить("Данные", Данные);
	СтруктПараметры.Вставить("НомерВАТС", НомерВАТС);
	СтруктПараметры.Вставить("ДоменAPI", ДоменAPI);
	СтруктПараметры.Вставить("КлючAPI", КлючAPI);
	
	ОбработкаИсторияАТСКлиент(СтруктПараметры);
	
КонецФункции

&НаКлиенте
Функция ОбработкаСобытий_Sipuni(СобытиеПакета, ДанныеСобытия, ДопПараметрыЗапроса)
		
	ДанныеЗапроса = СофтФонКлиентСервер.URL2JSON(ДопПараметрыЗапроса, Истина);

	// json не прошел валидацию
	Если ДанныеЗапроса = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ТипСобытия = ДанныеЗапроса.Получить("event");
	
	Если ТипСобытия="1" Тогда
		
		ОбработкаНачалаЗвонка_Sipuni(ДанныеЗапроса);
		
	ИначеЕсли ТипСобытия="2" Тогда
		
		ОбработкаЗавершенияЗвонка_Sipuni(ДанныеЗапроса);
		
	ИначеЕсли ТипСобытия="3" Тогда
		
		ОбработкаСоединенияЗвонка_Sipuni(ДанныеЗапроса);
		
	ИначеЕсли ТипСобытия="4" Тогда
		
		ОбработкаЗавершенияЗвонкаПромежуточное_Sipuni(ДанныеЗапроса);
		
	КонецЕсли;

КонецФункции

&НаКлиенте
Функция ОбработкаНачалаЗвонка_Sipuni(Данные)

	ИД=Данные.Получить("call_id");
	Если ИД=Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
		
	СтрТекущиеЗвонки=ПолучитьСтрокуТекущегоЗвонка_Sipuni(ИД);
	ЗаполнитьДанныеТекущиеЗвонки_Sipuni(СтрТекущиеЗвонки,Данные);
	ЗаполнитьЛинию_Sipuni(СтрТекущиеЗвонки);
	
	ЭтоВходящий=ЭтоВходящий_Sipuni(СтрТекущиеЗвонки);
	НомерАбонента=СтрТекущиеЗвонки.src_num;
	ВнутрНомер=СтрТекущиеЗвонки.short_dst_num;
	ЭтоВнутренний=ЭтоВнутренний_Sipuni(СтрТекущиеЗвонки);
	Если ЭтоВнутренний Тогда
		НомерАбонента=СтрТекущиеЗвонки.short_src_num;
	КонецЕсли; 
	Если Не ЭтоВходящий Тогда
		ВнутрНомер=СтрТекущиеЗвонки.short_src_num;
		НомерАбонента=СтрТекущиеЗвонки.dst_num;
		Если ЭтоВнутренний Тогда
			НомерАбонента=СтрТекущиеЗвонки.short_dst_num;
		КонецЕсли; 
	КонецЕсли; 
	
	// действия по отслеживаемому внутреннему номеру
	Если ВнутрНомер=ВнутреннийНомер Тогда
		ИДТекущегоЗвонка=ИД;
		НаправлениеЗвонка="Исходящий";
		Если ЭтоВходящий Тогда
			НаправлениеЗвонка="Входящий";
			
			ДействияПриНачалеВходящегоЗвонка(НомерАбонента, СтрТекущиеЗвонки.Линия, ВнутреннийНомер, ИДТекущегоЗвонка);
		КонецЕсли; 
		
	КонецЕсли;
		
КонецФункции

&НаКлиенте
Функция ОбработкаЗавершенияЗвонка_Sipuni(Данные)

	ИД=Данные.Получить("call_id");
	Если ИД=Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	СтрТекущиеЗвонки=ПолучитьСтрокуТекущегоЗвонка_Sipuni(ИД);
	ЗаполнитьДанныеТекущиеЗвонки_Sipuni(СтрТекущиеЗвонки,Данные);
	
	ЭтоВходящий=ЭтоВходящий_Sipuni(СтрТекущиеЗвонки);
	Номер=СтрТекущиеЗвонки.src_num;
	ВнутрНомер=СтрТекущиеЗвонки.short_dst_num;
	ЭтоВнутренний=ЭтоВнутренний_Sipuni(СтрТекущиеЗвонки);
	Если ЭтоВнутренний Тогда
		Номер=СтрТекущиеЗвонки.short_src_num;
	КонецЕсли; 
	Если Не ЭтоВходящий Тогда
		ВнутрНомер=СтрТекущиеЗвонки.short_src_num;
		Номер=СтрТекущиеЗвонки.dst_num;
		Если ЭтоВнутренний Тогда
			Номер=СтрТекущиеЗвонки.short_dst_num;
		КонецЕсли; 
	КонецЕсли; 
	
	// действия по отслеживаемому внутреннему номеру
	Если ВнутрНомер=ВнутреннийНомер ИЛИ ИДТекущегоЗвонка=ИД Тогда	 
		ЗакрытьФормуВходящегоЗвонка(ИДТекущегоЗвонка);	
	КонецЕсли;
		
	ТекущиеЗвонки_Sipuni.Удалить(СтрТекущиеЗвонки);
	
КонецФункции

&НаКлиенте
Функция ОбработкаСоединенияЗвонка_Sipuni(Данные)

	ИД=Данные.Получить("call_id");
	Если ИД=Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	СтрТекущиеЗвонки=ПолучитьСтрокуТекущегоЗвонка_Sipuni(ИД);
	ЗаполнитьДанныеТекущиеЗвонки_Sipuni(СтрТекущиеЗвонки,Данные);
	
	ЭтоВходящий=ЭтоВходящий_Sipuni(СтрТекущиеЗвонки);
	Номер=СтрТекущиеЗвонки.src_num;
	ВнутрНомер=СтрТекущиеЗвонки.short_dst_num;
	ЭтоВнутренний=ЭтоВнутренний_Sipuni(СтрТекущиеЗвонки);
	Если ЭтоВнутренний Тогда
		Номер=СтрТекущиеЗвонки.short_src_num;
	КонецЕсли; 
	Если Не ЭтоВходящий Тогда
		ВнутрНомер=СтрТекущиеЗвонки.short_src_num;
		Номер=СтрТекущиеЗвонки.dst_num;
		Если ЭтоВнутренний Тогда
			Номер=СтрТекущиеЗвонки.short_dst_num;
		КонецЕсли; 
	КонецЕсли; 
	
	// действия по отлеживаемому внутреннему номеру
	Если ВнутрНомер=ВнутреннийНомер Тогда
		
		//ИДТекущегоЗвонка=ИД;
		
		НаправлениеЗвонка="Исходящий";
		Если ЭтоВходящий Тогда
			НаправлениеЗвонка="Входящий";
			ДействияПриПоднятииТрубки_Sipuni(Номер, ИДТекущегоЗвонка);
		КонецЕсли; 
		ЗакрытьФормуВходящегоЗвонка(ИДТекущегоЗвонка);
	
	КонецЕсли;
		
КонецФункции

