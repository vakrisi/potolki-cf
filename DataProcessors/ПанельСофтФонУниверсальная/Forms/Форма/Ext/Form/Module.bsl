&НаКлиенте
Процедура ПолучитьИсторию_UIS(Дата1, Дата2)
	
	// собираем тело запроса
	ФорматДаты="ДФ='гггг-ММ-дд ЧЧ:мм:сс'";
	Если Не ЗначениеЗаполнено(Дата1) Тогда
		Дата1=НачалоДня(ТекущаяДата());
	КонецЕсли;
	СтрДата1=Формат(Дата1,ФорматДаты);
	
	Если Не ЗначениеЗаполнено(Дата2) Тогда
		Дата2=КонецДня(ТекущаяДата());
	КонецЕсли;
	СтрДата2=Формат(Дата2,ФорматДаты);
	
	ИмяМетода="get.calls_report";
	
	СтрСортировка="'sort':[{'field':'start_time','order':'asc'}]";
	СтрПоля="'fields':['source','communication_id','communication_type','start_time','finish_time','finish_reason','direction','is_lost','virtual_phone_number','contact_phone_number','employees','last_answered_employee_id','last_talked_employee_id','total_duration','total_wait_duration','clean_talk_duration','call_records']";
	ДанныеJSON="{'jsonrpc':'2.0','id':'"+ИмяМетода+"','method':'"+ИмяМетода+"','params':{'access_token':'"+КлючAPI+"','date_from':'"+СтрДата1+"','date_till':'"+СтрДата2+"',"+СтрСортировка+","+СтрПоля+"}}";
	
	ДанныеJSON=СофтФонКлиентСервер.Stringify(ДанныеJSON);

	// обработка запроса 
	Ресурс = "/v"+ВерсияAPI;
	
	Заголовки = Новый Соответствие;	
	Заголовки.Вставить("Content-Type", "application/json; charset=UTF-8;");

	Данные = ВыполнитьRestЗапрос("POST", ДоменAPI, Ресурс, Заголовки, ДанныеJSON);

	Если НЕ Данные = Неопределено Тогда
		Если ЭтоОшибка_UIS(Данные) Тогда
			Возврат;
		КонецЕсли;
		
		ОбработкаИсторияАТС_UIS(Данные);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
