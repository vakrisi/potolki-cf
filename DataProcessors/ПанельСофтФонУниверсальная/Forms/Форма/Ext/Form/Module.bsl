&НаКлиенте
Функция ВыполнитьRestЗапрос(ТипЗапроса = "POST", Хост, Ресурс, Заголовки = Неопределено, ТелоЗапроса=Неопределено, 
							ПрочитатьВJson = Истина, ПрочитатьВСоответствие = Истина, 
							РезультатВФайл=Ложь,
							Таймаут = 0,
							ВернутьКуки = Ложь,
							Знач ПутьКФайлуРезультата = "")
		
	Если Заголовки = Неопределено Тогда
		Заголовки = Новый Соответствие;	
		Заголовки.Вставить("Content-Type", "application/json; charset=UTF-8;");
	КонецЕсли;

	Запрос = Новый HTTPЗапрос(Ресурс, Заголовки);
	Если НЕ ТелоЗапроса=Неопределено Тогда
		Запрос.УстановитьТелоИзСтроки(ТелоЗапроса, КодировкаТекста.UTF8);
	КонецЕсли;
	
	Попытка
		
		//++ №13602 обрабатываем адрес сервера АТС, на случай если на входе https://server.ru/resurce/api, на выходе будет server.ru
		//Соединение = Новый HTTPСоединение(Хост,,,,,Таймаут,Новый ЗащищенноеСоединениеOpenSSL); // https
		Соединение = Новый HTTPСоединение(ОбработатьАдресСервера(Хост), 443,,,, Таймаут, Новый ЗащищенноеСоединениеOpenSSL);
		//-- №13602
		
		Если ТипЗапроса = "POST" Тогда
			HTTPОтвет = Соединение.ОтправитьДляОбработки(Запрос);
			
		ИначеЕсли ТипЗапроса = "GET" Тогда
			Если РезультатВФайл Тогда
				ВремФайл = ?(ПустаяСтрока(ПутьКФайлуРезультата), ПолучитьИмяВременногоФайла("txt"), ПутьКФайлуРезультата);
				HTTPОтвет = Соединение.Получить(Запрос, ВремФайл);
			Иначе
			    HTTPОтвет = Соединение.Получить(Запрос);
			КонецЕсли;
			
		ИначеЕсли ТипЗапроса = "PUT" Тогда
			HTTPОтвет = Соединение.Записать(Запрос);
			
		КонецЕсли;
		
		КодОтвета = HTTPОтвет.КодСостояния;
		
		Если КодОтвета = 200 Тогда
			Если ТипЗапроса = "GET" И РезультатВФайл Тогда
				// Мегафон (история звонков)
				Если ПустаяСтрока(ПутьКФайлуРезультата) Тогда
					Файл = Новый ЧтениеТекста(ВремФайл);
					Данные = Файл.Прочитать();
					Файл.Закрыть();
					УдалитьФайлы(ВремФайл);
					Возврат Данные;
				Иначе
					// билайн (запись звонка)
					Возврат ПутьКФайлуРезультата;
				КонецЕсли;
				
			ИначеЕсли ВернутьКуки Тогда				
				Возврат HTTPОтвет.Заголовки.Получить("Set-Cookie");
				
			Иначе
				ТелоОтвета = HTTPОтвет.ПолучитьТелоКакСтроку();
				Если ПрочитатьВJson Тогда
					Данные = СофтФонКлиентСервер.ПолучитьДанныеJSON(ТелоОтвета, ПрочитатьВСоответствие);
					Возврат Данные;
				Иначе
					Возврат ТелоОтвета;
				КонецЕсли;
			КонецЕсли;
			
		ИначеЕсли КодОтвета = 302 И Ресурс = "/vpbx/queries/recording/post" Тогда
			// получена ссылка на файл записи: ссылки являются временными, срок их жизни ограничен 
			ФайлЗаписиСсылка = HTTPОтвет.Заголовки.Получить("Location");
			Возврат ФайлЗаписиСсылка;
			
		КонецЕсли;
	Исключение
		ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		ПоказатьОповещениеПользователя("Ошибка Софтфон", , ТекстОшибки); 
		Возврат Неопределено;
	КонецПопытки;
	
	Возврат Неопределено;
			
КонецФункции

//++ №13602
Функция ОбработатьАдресСервера(Знач АдресСервера)
	
	АдресСервера = СокрЛП(АдресСервера);

	Сервер = ""; 
		
	Если НЕ ПустаяСтрока(АдресСервера) Тогда
		
		АдресСервера = СтрЗаменить(АдресСервера, "\", "/");
		АдресСервера = СтрЗаменить(АдресСервера, " ", "");
		
		Если НРег(Лев(АдресСервера, 7)) = "http://" Тогда
			АдресСервера = Сред(АдресСервера, 8);
		ИначеЕсли НРег(Лев(АдресСервера, 8)) = "https://" Тогда
			АдресСервера = Сред(АдресСервера, 9);
		КонецЕсли;
		
		ПозицияСлэша = СтрНайти(АдресСервера, "/");
		
		Если ПозицияСлэша > 0 Тогда
			Сервер = Лев(АдресСервера, ПозицияСлэша - 1);
		Иначе	
			Сервер = АдресСервера;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Сервер;
	
КонецФункции
