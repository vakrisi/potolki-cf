&НаКлиенте
Процедура ПоказатьЗаданияСотрудника(Команда)
	тд = Элементы.АнализОшляпливания.ТекущиеДанные;
	Если тд<>Неопределено и ТипЗнч(тд.Узел) = Тип("СправочникСсылка.Пользователи") Тогда
		ПоказатьЗаданияСотрудникаОбщ(тд.Узел);
	Иначе
		ПоказатьПредупреждение(,"Выберите сотрудника!");
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьЗаданияСотрудникаОбщ(Сотр)
	ЗаданияДИ.Отбор.Элементы.Очистить();
	
	ЭлементОтб = ЗаданияДИ.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтб.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Сотрудник");
	ЭлементОтб.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ЭлементОтб.ПравоеЗначение = Сотр;
	ЭлементОтб.Использование = истина;
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьЗаданияСотрудника1(Команда)
	тд = Элементы.АнализСдачи.ТекущиеДанные;
	Если тд<>Неопределено и ТипЗнч(тд.Узел) = Тип("СправочникСсылка.Пользователи") Тогда
		ПоказатьЗаданияСотрудникаОбщ(тд.Узел);
	Иначе
		ПоказатьПредупреждение(,"Выберите сотрудника!");
	КонецЕсли;
КонецПроцедуры

