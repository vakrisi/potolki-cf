&НаКлиенте
Процедура ПерелистнутьСтраницу(Сдвиг)
	
	ТекущаяСтраница = ТекущаяСтраница + Сдвиг;
	Если ТекущаяСтраница < 1 Тогда
		ТекущаяСтраница = 1;
	КонецЕсли;
	Если ТекущаяСтраница > Элементы.ГруппаСтраницы.ПодчиненныеЭлементы.Количество() Тогда
		ТекущаяСтраница = Элементы.ГруппаСтраницы.ПодчиненныеЭлементы.Количество();
	КонецЕсли;
	
	Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы["Группа" + СтрЗаменить(ТекущаяСтраница,Символ(160),"")];
	
	Элементы.КомандаНазад.Видимость = Ложь;
	Элементы.КомандаВыполнить.Видимость = Ложь;
	Элементы.КомандаВеперд.Видимость = Ложь;
	
	Если ТекущаяСтраница = 1 Тогда
		Элементы.КомандаВыполнить.Видимость = Ложь;
		Элементы.КомандаНазад.Видимость = Ложь;
		Элементы.КомандаВеперд.Видимость = Истина;
	ИначеЕсли ТекущаяСтраница = Элементы.ГруппаСтраницы.ПодчиненныеЭлементы.Количество() Тогда
		Элементы.КомандаВыполнить.Видимость = Истина;
		Элементы.КомандаНазад.Видимость = Истина;
		Элементы.КомандаВеперд.Видимость = Ложь;
	Иначе
		Элементы.КомандаВыполнить.Видимость = Ложь;
		Элементы.КомандаНазад.Видимость = Истина;
		Элементы.КомандаВеперд.Видимость = Истина;
	КонецЕсли;
	
КонецПроцедуры

