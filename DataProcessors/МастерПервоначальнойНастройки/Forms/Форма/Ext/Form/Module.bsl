Функция СоздатьГруппуНоменклатуры(Наименование, Родитель = Неопределено)
	
	ИскомаяНоменклатура = Справочники.Номенклатура.ПустаяСсылка();
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Номенклатура.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	Номенклатура.Наименование = &Наименование
	|	И Номенклатура.Родитель = &Родитель
	|	И Номенклатура.ЭтоГруппа";
	Запрос.УстановитьПараметр("Наименование", Наименование);
	Запрос.УстановитьПараметр("Родитель", ?(Родитель = Неопределено, Справочники.Номенклатура.ПустаяСсылка(), Родитель) );
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ИскомаяНоменклатура = Выборка.Ссылка;
	КонецЦикла;
	
	Если НЕ ИскомаяНоменклатура.Пустая() Тогда
		НоменклатураОбъект = ИскомаяНоменклатура.ПолучитьОбъект();
	Иначе
		НоменклатураОбъект = Справочники.Номенклатура.СоздатьГруппу();
	КонецЕсли;
	
	НоменклатураОбъект.Наименование = Наименование;
	Если НЕ Родитель = Неопределено Тогда
		НоменклатураОбъект.Родитель = Родитель;
	КонецЕсли;
	НоменклатураОбъект.Записать();
	
	Возврат НоменклатураОбъект.Ссылка;
	
