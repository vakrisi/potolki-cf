
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ТекущаяСтраница = 1;
	ВалютаУчета = Справочники.Валюты.RUB;
	ВыполнитьПервоначальноеЗаполнениеНоменклатуры = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ПерелистнутьСтраницу(0);
	
	// попробуем развернуть форму на весь экран
	Попытка
		WSHShell = Новый COMОбъект("WScript.Shell");
    	WSHShell.SendKeys("%");
    	WSHShell.SendKeys("{LEFT}{LEFT}{ENTER}"); 
	Исключение
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	//#11138
	Если НЕ ЗавершениеРаботы Тогда
		Если НЕ ГотовКЗакрытию Тогда
			СтандартнаяОбработка = Ложь;
			Отказ = Истина;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура СтранаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	СписокСтран = СофтФон.ПолучитьСписокСтранДляИспользованияТелефонии();
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ВыборСтраныТелефонии", ЭтаФорма);
	ПоказатьВыборИзМеню(ОписаниеОповещения, СписокСтран, Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыборСтраныТелефонии(ВыбранныйЭлемент, ДополнительныеПараметры) Экспорт 
	
	Страна = ВыбранныйЭлемент.Значение;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура КомандаВперед(Команда)
	
	//#11138
	Если ТекущаяСтраница = 1 Тогда
		Если НЕ ПроверитьЗаполнение() Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;
	ПерелистнутьСтраницу(1);
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаНазад(Команда)
	
	ПерелистнутьСтраницу(-1);
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаВыполнить(Команда)
	
	Отказ = Ложь;
	
	Если НЕ ПроверитьЗаполнение() Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнитьНастройкиПоУмолчанию();
	ПоказатьПредупреждение(,"Настройки выполнены");
	ГотовКЗакрытию = Истина;
	Закрыть();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗаполнитьНастройкиПоУмолчанию()
	
	Константы.ИспользоватьВедениеУчетаДоходовРасходов.Установить(Истина);
	Константы.КассовыйМетодВеденияУчетаДоходовРасходов.Установить(Истина);
	Константы.НекассовыйМетодВеденияУчетаДоходовРасходов.Установить(Истина);
	Константы.ДопустимаяГлубинаВложенностиСопутствующихТоваровИУслуг.Установить(1);
	Константы.РазрешитьОбновлятьПотолокЕслиОнРанееБылЗагружен.Установить(Истина);
	Константы.ВалютаУчета.Установить(ВалютаУчета);
	Константы.ТелефонияСтрана.Установить(Страна);
	Константы.АвтоматическиЗаполнятьДатуПодписанияДокументовВМонтаже.Установить(Перечисления.ВариантыЗаполненияДатыПодписанияВМонтаже.НеЗаполнять); 
	Константы.СпособДобавленияПродукцииВыбратьПотолок.Установить(Истина);
	
	СоздатьОрганизацию();
	СоздатьСклад();
	
	Если ВыполнитьПервоначальноеЗаполнениеНоменклатуры Тогда
		
		//папки
		СоздатьГруппуНоменклатуры("Инструмент");
		
		ГруппаКомплектующие = СоздатьГруппуНоменклатуры("Комплектующие");
    	СоздатьГруппуНоменклатуры("Багет",ГруппаКомплектующие);
    	СоздатьГруппуНоменклатуры("Вставка",ГруппаКомплектующие);
    	СоздатьГруппуНоменклатуры("Гардины",ГруппаКомплектующие);
    	СоздатьГруппуНоменклатуры("Гарпун",ГруппаКомплектующие);
    	СоздатьГруппуНоменклатуры("Ленты светодиодные / Звездные булавки / Световые панели",ГруппаКомплектующие);
    	СоздатьГруппуНоменклатуры("Обвод трубы",ГруппаКомплектующие);
    	СоздатьГруппуНоменклатуры("Платформы",ГруппаКомплектующие);
    	СоздатьГруппуНоменклатуры("Светильники",ГруппаКомплектующие);
    	СоздатьГруппуНоменклатуры("Термокольцо",ГруппаКомплектующие);
    	СоздатьГруппуНоменклатуры("Упаковка",ГруппаКомплектующие);
		
		ГруппаФактуры = 		СоздатьГруппуНоменклатуры("Полотна");
    	ГруппаПотолки = 		СоздатьГруппуНоменклатуры("Потолки");
		ГруппаОстатки = 		СоздатьГруппуНоменклатуры("Остатки пленки"); // #11670
		//ГруппаПродукции = 		СоздатьГруппуНоменклатуры("Продукция");
    	ГруппаУслугРаскроя = 	СоздатьГруппуНоменклатуры("Услуги Производства");
    	СоздатьГруппуНоменклатуры("Услуги Розницы");
		
		Константы.ГруппаНоменклатурДляФактуры.Установить(ГруппаФактуры);
		Константы.ГруппаНоменклатурыПродукция.Установить(ГруппаПотолки);
		Константы.ГруппаНоменклатурыДляОстатков.Установить(ГруппаОстатки); // #11670
		//Константы.ГруппаНоменклатурыДляПродукции.Установить(ГруппаПродукции); //#16283 не используется
		
		//элементы
		СоздатьЭлементНоменклатуры("Угол бесплатный (раскрой)", 		ГруппаУслугРаскроя, Справочники.ВидыНоменклатуры.Услуга, 				Справочники.КлассификаторЕдиницИзмерения.Штука, 		Истина, Справочники.ВидыПроизводственныхУслуг.Углы);
		СоздатьЭлементНоменклатуры("Углы (раскрой)", 					ГруппаУслугРаскроя, Справочники.ВидыНоменклатуры.Услуга, 				Справочники.КлассификаторЕдиницИзмерения.Штука, 		Ложь, Справочники.ВидыПроизводственныхУслуг.Углы);
		СоздатьЭлементНоменклатуры("Apply вырез", 						ГруппаУслугРаскроя, Справочники.ВидыНоменклатуры.Услуга, 				Справочники.КлассификаторЕдиницИзмерения.МетрПогонный, 	Ложь, Справочники.ВидыПроизводственныхУслуг.ВырезыApply);
		СоздатьЭлементНоменклатуры("Фотопечать", 						ГруппаУслугРаскроя, Справочники.ВидыНоменклатуры.Услуга, 				Справочники.КлассификаторЕдиницИзмерения.МетрКвадратный, Ложь, Справочники.ВидыПроизводственныхУслуг.Фотопечать);
		СоздатьЭлементНоменклатуры("Прямолинейный шов",					ГруппаУслугРаскроя, Справочники.ВидыНоменклатуры.Услуга, 				Справочники.КлассификаторЕдиницИзмерения.МетрПогонный, 	Ложь, Справочники.ВидыПроизводственныхУслуг.ПрямолинейныеШвы);
		СоздатьЭлементНоменклатуры("Криволинейный шов", 				ГруппаУслугРаскроя, Справочники.ВидыНоменклатуры.Услуга, 				Справочники.КлассификаторЕдиницИзмерения.МетрПогонный, 	Ложь, Справочники.ВидыПроизводственныхУслуг.КриволинейныеШвы);
		СоздатьЭлементНоменклатуры("Внутренний вырез (раскрой)", 		ГруппаУслугРаскроя, Справочники.ВидыНоменклатуры.Услуга, 				Справочники.КлассификаторЕдиницИзмерения.МетрПогонный, 	Ложь, Справочники.ВидыПроизводственныхУслуг.ВнутренниеВырезы);
		СоздатьЭлементНоменклатуры("Криволинейный участок (раскрой)", 	ГруппаУслугРаскроя, Справочники.ВидыНоменклатуры.Услуга, 				Справочники.КлассификаторЕдиницИзмерения.МетрПогонный, 	Ложь, Справочники.ВидыПроизводственныхУслуг.КриволинейныйУчасток);
		
	КонецЕсли;
	
	//Остатки пленки приведем к соответствующему виду
	Попытка
		НоменклатураОстаткиПленки = Справочники.Номенклатура.ОстаткиПленки.ПолучитьОбъект();
		НоменклатураОстаткиПленки.ВидНоменклатуры = Справочники.ВидыНоменклатуры.ОстатокПленки;
		НоменклатураОстаткиПленки.БазоваяЕдиницаИзмерения = Справочники.КлассификаторЕдиницИзмерения.МетрКвадратный;
		НоменклатураОстаткиПленки.Родитель = ГруппаОстатки; //#11670
		НоменклатураОстаткиПленки.Записать();
	Исключение
	КонецПопытки;
	
	//Материал заказчика приведем к соответствующему виду
	Попытка
		НоменклатураПолотноЗаказчика = Справочники.Номенклатура.ПолотноЗаказчика.ПолучитьОбъект();
		//НоменклатураПолотноЗаказчика.ВидНоменклатуры = Справочники.ВидыНоменклатуры.Материал;
		//++ №14311 Предопределленной номенклатуре "ПолотноЗаказчика" поставить вид номенклатуры = "Полотно" и "Материал заказчика" = ИСТИНА
		//НоменклатураПолотноЗаказчика.ВидНоменклатуры = Справочники.ВидыНоменклатуры.МатериалЗаказчика;
		НоменклатураПолотноЗаказчика.ВидНоменклатуры = Справочники.ВидыНоменклатуры.Полотно;
		НоменклатураПолотноЗаказчика.МатериалЗаказчика = Истина;
		//-- №14311
		НоменклатураПолотноЗаказчика.БазоваяЕдиницаИзмерения = Справочники.КлассификаторЕдиницИзмерения.МетрКвадратный;	
		НоменклатураПолотноЗаказчика.Записать();
	Исключение
	КонецПопытки;
	
	//#12079
	Попытка
		НоменклатураОбъект = Справочники.Номенклатура.ПрофильЗаказчика.ПолучитьОбъект();
		//++ №14311 Предопределленной номенклатуре "ПрофильЗаказчика" поставить вид номенклатуры = "Товары и материалы" и "Материал заказчика" = ИСТИНА
		//НоменклатураОбъект.ВидНоменклатуры = Справочники.ВидыНоменклатуры.МатериалЗаказчика;
		НоменклатураОбъект.ВидНоменклатуры = Справочники.ВидыНоменклатуры.Материал;
		НоменклатураОбъект.МатериалЗаказчика = Истина;
		//-- №14311
		НоменклатураОбъект.БазоваяЕдиницаИзмерения = Справочники.КлассификаторЕдиницИзмерения.МетрПогонный;	
		НоменклатураОбъект.Записать();
	Исключение
	КонецПопытки;
	
	//#15715
	Попытка
	СсылкаНаЭлемент = Справочники.РекламныеИсточники.ПовторныйКлиент;
	СпрОбъект = СсылкаНаЭлемент.ПолучитьОбъект();
	СпрОбъект.ДоступенВПроизводстве = Истина;
	СпрОбъект.ДоступенВРознице = Истина;
	СпрОбъект.Записать();
	Исключение
	КонецПопытки;
	
	НастроитьАдминистратора();
	//СоздатьПользователяДляУстановкиОбновлений(); // #7604 закомментировано
	
	Справочники.СтатьиДоходовИРасходов.ЗаполнитьИспользованиеСтатейВУчетеДоходовИРасходовПоУмолчанию();
	РегистрыСведений.НастройкиСтатейДоходовРасходовПоУмолчанию.ЗаполнитьНастройкиПоУмолчанию();
	
	//Константы.МонтажКакРеализация.Установить(Истина);
	Константы.НачалоРабочегоВремениМонтажей.Установить(Дата(1,1,1,8,0,0));
	Константы.КонецРабочегоВремениМонтажей.Установить(Дата(1,1,1,21,0,0));
	Константы.КоличествоЧасовНеобходимыхНаМонтаж.Установить(4);
	
	Константы.НачалоРабочегоВремениЗамеров.Установить(Дата(1,1,1,8,0,0));
	Константы.КонецРабочегоВремениЗамеров.Установить(Дата(1,1,1,21,0,0));
	Константы.КоличествоЧасовНеобходимыхНаЗамер.Установить(1);
	//Константы.КоличествоЧасовПерезвонитьПриОтказеНаЗамере.Установить(1);
	Константы.РазмерИнтервалаВГрафикеЗамеров.Установить(60);
	
	Константы.ИспользоватьАльтернативнуюЕдиницуИзмеренияМатериалаПриЗагрузкеИзИзиСилинг.Установить(Истина);
	
	Константы.ПорядокФормированияНаименованияПленки.Установить(1); //СписокПорядков.Добавить(1, "Цвет, фактура, ширина");
	
	Константы.ПрефиксНаименованияПотолка.Установить("Потолок");
	Константы.СуффиксАртПотолок.Установить("арт");
	Константы.СуффиксМногофактурныйПотолок.Установить("мф");
	
	//#11670  #12523 частично закомментировано
	//Константы.ПрефиксНаименованияТиповогоОтреза.Установить("Отрез");
	Константы.ПрефиксНаименованияОтреза.Установить("Отрез");
	Константы.ПрефиксНаименованияОстатковПленки.Установить("Остаток");
	//Константы.ПравилоОпределенияОтреза.Установить(Справочники.ПравилаОпределенияВидаПотолка.Отрез);  #12532 закомментировано
	//Константы.ПравилоОпределенияТиповогоотреза.Установить(Справочники.ПравилаОпределенияВидаПотолка.ТиповойОтрез);
	
	//Константы.ЗаказПокупателяВыделятьУслугиРаскрояИзПотолка.Установить(Истина); // 2019-02-04 удалено использование константы, всегда Истина
	Константы.ВыделятьУслугиРаскрояИзПотолкаПриЗагрузкеИзПостроителяВЗаказДоговор.Установить(Истина); //2018-06-26
	
	//#6347 закомментировано
	//Зарплата.НастроитьВидыНачисленийПоРолямСотрудников();
	
	//Устанавливаем константы Ведение расчетов по заказам (Монтаж новый для распределения, его не устанавливаем)
	Константы.ВестиРасчетыПоЗаказамПоЗаказДоговору.Установить(Истина);
	//Константы.ВестиРасчетыПоЗаказамПоЗаказуНаПроизводство.Установить(Истина); //переход на 2.0
	Константы.ВестиРасчетыПоЗаказамПоЗаказуПокупателя.Установить(Истина);	
	//Константы.ВестиРасчетыПоЗаказамПоРТиУ.Установить(Истина); // #14620 закомментировано
	Константы.ВестиРасчетыПоЗаказамПоСчетуНаОплату.Установить(Истина);
	
	//Правила наименования потолка "Префикс + номер + цвет + фактура"
	Константы.ПорядокФормированияНаименованияПотолка.Установить(1);
	
	//Справочник Результаты Монтажа нужно установить у всех доступность, кроме статуса Закрыт
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	РезультатыМонтажа.Ссылка
		|ИЗ
		|	Справочник.РезультатыМонтажа КАК РезультатыМонтажа
		|ГДЕ
		|	НЕ РезультатыМонтажа.Ссылка = Значение(Справочник.РезультатыМонтажа.Закрыт)";
	
	Выборка = Запрос.Выполнить().Выбрать();	
	
	Пока Выборка.Следующий() Цикл
		Попытка
			Статус = Выборка.Ссылка.ПолучитьОбъект();
			Статус.Доступен = Истина;
			Статус.Записать();
		Исключение
		КонецПопытки
	КонецЦикла;
	
	ПравилоПоискаИсторииОбращений = Новый Структура("ПоТелефону, ПоАдресуЭлектроннойПочты", Истина, Истина);		
	Константы.ПравилоПоискаИсторииОбращений.Установить(Новый ХранилищеЗначения(ПравилоПоискаИсторииОбращений));
	
	//#6347
	Константы.СпособРаспределенияВыработкиПоМонтажуПоУмолчанию.Установить(Перечисления.СпособыРаспределенияВыработкиПоМонтажникам.ПоКоэффициентам);
	
	// №6627
	Константы.ПриВходящемЗвонкеОткрыватьКарточкуЛидаВРаботе.Установить(Истина);
	
	//#6852
	НаборКонстант = Константы.СоздатьНабор("ЗаполнениеМатериаловРозницы,ОбеспеченностьРозницыПоЗаказДоговорам,ОбеспеченностьРозницыПоМонтажам");	
	НаборКонстант.Прочитать();
	НаборКонстант.ЗаполнениеМатериаловРозницы = 1;
