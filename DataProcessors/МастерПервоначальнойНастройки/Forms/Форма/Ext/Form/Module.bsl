			КонецЕсли;
			НовыйАдминистратор.Записать();
		КонецЕсли;
	КонецЕсли;
	
	//#9957
	Если НЕ ПустаяСтрока(ИмяПользователяАдминистратораСистемы) Тогда
		НовыйАдминистратор = ПользователиИнформационнойБазы.НайтиПоИмени(ИмяПользователяАдминистратораСистемы);
		
		Если НовыйАдминистратор = Неопределено Тогда			
			ПользовательИБ = ПользователиИнформационнойБазы.СоздатьПользователя();
			ПользовательИБ.Имя       = ИмяПользователяАдминистратораСистемы;
			ПользовательИБ.ПолноеИмя = ИмяПользователяАдминистратораСистемы;
			ПользовательИБ.Роли.Добавить(Метаданные.Роли.АдминистраторСистемы);			
			ПользовательИБ.Записать();
			
			// создаем элемент в справочнике Пользователи
			Пользователь = Справочники.Пользователи.СоздатьЭлемент();		
			Пользователь.Наименование = ПользовательИБ.ПолноеИмя;		
			ОписаниеПользователяИБ = Новый Структура;
			ОписаниеПользователяИБ.Вставить("Действие", "Записать");
			ОписаниеПользователяИБ.Вставить("УникальныйИдентификатор", ПользовательИБ.УникальныйИдентификатор);		
			Пользователь.ДополнительныеСвойства.Вставить("ОписаниеПользователяИБ", ОписаниеПользователяИБ);		
			Пользователь.Записать();
			
			// не заполняются "Общее/НастройкиКлиентскогоПриложения", в результате чего недоступно переключение режимов окна через Персональные настройки
			ПользователиСлужебный.УстановитьНачальныеНастройки(ПользовательИБ.Имя, Пользователь);
		КонецЕсли;	
	КонецЕсли;
	
КонецПроцедуры

