
&НаКлиенте
Процедура КомандаОК(Команда)
	Рез = Новый Массив;
	Для каждого стр из Пользователи Цикл
		Если стр.Выбор Тогда
			Рез.Добавить(стр.Пользователь);
		КонецЕсли;
	КонецЦикла;
	
	Закрыть(рез);
КонецПроцедуры

&НаКлиенте
Процедура КомандаЗакрыть(Команда)
	Закрыть(Неопределено);
КонецПроцедуры

&НаСервереБезКонтекста
Функция ЭтоГруппаПольз(пСсылка)
	Попытка      
		Возврат пСсылка.ЭтоГруппа;
	Исключение
		Возврат ложь;
	КонецПопытки;
КонецФункции

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	Пользователи.Ссылка
	               |ИЗ
	               |	Справочник.Пользователи КАК Пользователи
	               |ГДЕ
	               |	Пользователи.ПометкаУдаления = ЛОЖЬ
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Пользователи.Наименование";
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Если не ЭтоГруппаПольз(Выборка.Ссылка) Тогда
			Новстр = Пользователи.Добавить();
			Новстр.Пользователь = Выборка.Ссылка;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура КомандаВыбратьВсе(Команда)
	Для каждого стр из Пользователи Цикл
		стр.Выбор = истина;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура КомандаОтменитьВыборВсех(Команда)
	Для каждого стр из Пользователи Цикл
		стр.Выбор = ложь;
	КонецЦикла;
КонецПроцедуры
