
&НаКлиенте
Процедура Сохранить(Команда)
	СохранитьНаСервере();
	Элементы.Пользователи.Обновить();
	Модифицированность = Ложь;
КонецПроцедуры

&НаСервере
Процедура СохранитьНаСервере()
	
	Если не ЗначениеЗаполнено(Пользователь) Тогда
		Возврат;
	КонецЕсли;
	
	// сохраним доступные объекты
	набор = РегистрыСведений.ИА_УровниДоступаПользователей.СоздатьНаборЗаписей();
	Набор.Отбор.Пользователь.Значение = Пользователь;
	Набор.Отбор.Пользователь.Использование = Истина;
	Набор.Прочитать();
	Набор.Очистить();
	
	Если Администратор Тогда
		Новстр = Набор.Добавить();
		Новстр.Пользователь = Пользователь;
		Новстр.ОбъектДоступа = Справочники.ОргСхема.ПустаяСсылка();
	КонецЕсли;
	
	Для каждого стр из Объект.КодыРаспределения Цикл
		Если ЗначениеЗаполнено(Стр.КодРаспределения) тогда
			НовСтр = Набор.Добавить();
			НовСтр.Пользователь = Пользователь;
			НовСтр.ОбъектДоступа = Стр.КодРаспределения;
		КонецЕсли;
	КонецЦикла;		
	
	Для каждого Стр из Объект.Серии Цикл
		Если Стр.Доступно Тогда
			НовСтр = Набор.Добавить();
			НовСтр.Пользователь = Пользователь;
			НовСтр.ОбъектДоступа = Стр.Серия;
		КонецЕсли;
	КонецЦикла;
	
	Для каждого Стр из Объект.ТипыИнструкции Цикл
		Если Стр.Доступно Тогда
			НовСтр = Набор.Добавить();
			НовСтр.Пользователь = Пользователь;
			НовСтр.ОбъектДоступа = Стр.ТипИнструкции;
		КонецЕсли;
	КонецЦикла;
	
	Для каждого Стр из Объект.Статусы Цикл
		Если Стр.Доступно Тогда
			НовСтр = Набор.Добавить();
			НовСтр.Пользователь = Пользователь;
			НовСтр.ОбъектДоступа = Стр.Статус;
		КонецЕсли;
	КонецЦикла;
	
	Набор.Записать();
	
	//
	ИА_ОбщиеПроцедуры_Технология_Сервер.ОбновитьДоступныеИнструкцииПользователя(Пользователь, Объект.КодыРаспределения.Выгрузить().ВыгрузитьКолонку("КодРаспределения"), Администратор);
	
	
КонецПроцедуры

&НаКлиенте
Процедура ПользовательПриИзменении(Элемент)
	ПользовательПриИзмененииНаСервере();
	Модифицированность = Ложь;
	ОбновитьДоступностьТаблиц();
КонецПроцедуры

&НаСервере
Процедура ПользовательПриИзмененииНаСервере()
	
	//
	Администратор = Ложь;
	
	Объект.КодыРаспределения.Очистить();
	//
	Объект.Серии.Очистить();
	выб = Справочники.ИА_Серии.Выбрать();
	Пока Выб.Следующий() Цикл
		Новст = Объект.Серии.Добавить();
		Новст.Серия = Выб.Ссылка;
	КонецЦикла;
	//
	Объект.ТипыИнструкции.Очистить();
	выб = Справочники.ИА_ТипыИнструкций.Выбрать();
	Пока Выб.Следующий() Цикл
		Новст = Объект.ТипыИнструкции.Добавить();
		Новст.ТипИнструкции = Выб.Ссылка;
	КонецЦикла;
	//
	Объект.Статусы.Очистить();
	Новстр = Объект.Статусы.Добавить();
	Новстр.Статус = Перечисления.ИА_СтатусИнструкции.Действует;
	Новстр = Объект.Статусы.Добавить();
	Новстр.Статус = Перечисления.ИА_СтатусИнструкции.НаСогласовании;
	Новстр = Объект.Статусы.Добавить();
	Новстр.Статус = Перечисления.ИА_СтатусИнструкции.Проект;
	//
	Если не ЗначениеЗаполнено(Пользователь) Тогда
		Возврат;
	КонецЕсли;
	
	набор = РегистрыСведений.ИА_УровниДоступаПользователей.СоздатьНаборЗаписей();
	Набор.Отбор.Пользователь.Значение = Пользователь;
	Набор.Отбор.Пользователь.Использование = Истина;
	Набор.Прочитать();
	
	Для каждого стр из Набор Цикл
		Если стр.ОбъектДоступа = Справочники.ОргСхема.ПустаяСсылка() Тогда
			Администратор = Истина;
		КонецЕсли;
		
		типЗ = ТипЗнч(стр.ОбъектДоступа);
		
		Если типЗ = Тип("СправочникСсылка.ОргСхема") и ЗначениеЗаполнено(стр.ОбъектДоступа) Тогда
			Новстр = Объект.КодыРаспределения.Добавить();
			Новстр.КодРаспределения = стр.ОбъектДоступа;
		КонецЕсли;
		
		Если типЗ = Тип("СправочникСсылка.ИА_Серии") Тогда
			Парам = Новый Структура("Серия",стр.ОбъектДоступа);
			стр1 = Объект.Серии.НайтиСтроки(Парам);
			стр1[0].Доступно = истина;
		КонецЕсли;
		
		Если типЗ = Тип("СправочникСсылка.ИА_ТипыИнструкций") Тогда
			Парам = Новый Структура("ТипИнструкции",стр.ОбъектДоступа);
			стр1 = Объект.ТипыИнструкции.НайтиСтроки(Парам);
			стр1[0].Доступно = истина;
		КонецЕсли;
		
		Если типЗ = Тип("ПеречислениеСсылка.ИА_СтатусИнструкции") Тогда
			Парам = Новый Структура("Статус",стр.ОбъектДоступа);
			стр1 = Объект.Статусы.НайтиСтроки(Парам);
			стр1[0].Доступно = истина;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры


