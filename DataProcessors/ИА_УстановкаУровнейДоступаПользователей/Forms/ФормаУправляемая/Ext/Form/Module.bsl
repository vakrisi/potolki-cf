&НаСервере
Процедура ЗаполнитьПоОргсхеме_Сервер()

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	            | ОргСхема.Ссылка
	            |ИЗ
	            | Справочник.ОргСхема КАК ОргСхема";
	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл
		ИА_ОбщиеПроцедуры_Технология_Сервер.ПроверитьПраваПоста(Выборка.Ссылка);
		ИА_ОбщиеПроцедуры_Технология_Сервер.УдалитьЛишниеПраваДИ(Выборка.Ссылка);
	КонецЦикла; 
      
КонецПроцедуры

