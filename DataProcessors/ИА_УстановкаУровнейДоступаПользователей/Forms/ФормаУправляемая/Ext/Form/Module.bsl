&НаСервереБезКонтекста
Функция ЭтоГруппаПольз(пСсылка)
	Попытка      
		Возврат пСсылка.ЭтоГруппа;
	Исключение
		Возврат ложь;
	КонецПопытки;
КонецФункции

&НаКлиенте
Процедура ПользователиПриАктивизацииСтроки(Элемент)
	Если ЗначениеЗаполнено(Элементы.Пользователи.ТекущаяСтрока) и не ЭтоГруппаПольз(Элементы.Пользователи.ТекущиеДанные.Ссылка) Тогда 
		Если Модифицированность Тогда
			отв = Неопределено;

			ПоказатьВопрос(Новый ОписаниеОповещения("ПользователиПриАктивизацииСтрокиЗавершение", ЭтотОбъект), "Данные были изменены. Сохранить изменения?", РежимДиалогаВопрос.ДаНет);
            Возврат;
		КонецЕсли;
		ПользователиПриАктивизацииСтрокиФрагмент();

	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПользователиПриАктивизацииСтрокиЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	отв = РезультатВопроса;
	Если отв = КодВозвратаДиалога.Да Тогда
		СохранитьНаСервере();
		Элементы.Пользователи.Обновить();
	КонецЕсли;
	
	ПользователиПриАктивизацииСтрокиФрагмент();

КонецПроцедуры

&НаКлиенте
Процедура ПользователиПриАктивизацииСтрокиФрагмент()
	
	Пользователь = Элементы.Пользователи.ТекущаяСтрока;
	ПользовательПриИзменении(Неопределено);

КонецПроцедуры


&НаКлиенте
Процедура ПередЗакрытием(Отказ, СтандартнаяОбработка)
	Если Модифицированность Тогда

		ПоказатьВопрос(Новый ОписаниеОповещения("ПередЗакрытиемЗавершение", ЭтотОбъект), "Данные были изменены. Сохранить изменения?", РежимДиалогаВопрос.ДаНетОтмена);
        Отказ = Истина;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытиемЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	отв = РезультатВопроса;
	Если отв = КодВозвратаДиалога.Да Тогда
		СохранитьНаСервере();
		Модифицированность = ложь;
		Закрыть();
	ИначеЕсли отв = КодВозвратаДиалога.Отмена Тогда
		Возврат;
	КонецЕсли;

КонецПроцедуры


&НаКлиенте
Процедура УстановитьПраваГруппе(Команда)
	ПоказатьВопрос(Новый ОписаниеОповещения("УстановитьПраваГруппеЗавершение1", ЭтотОбъект), "Групповая установка прав устанавливает указанные права за исключением доступных постов т.к. посты указываются для каждого пользователя индивидуально. Продолжить?", РежимДиалогаВопрос.ДаНет);
КонецПроцедуры

&НаКлиенте
Процедура УстановитьПраваГруппеЗавершение1(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса <> КодВозвратаДиалога.Да Тогда		
		Возврат;
	КонецЕсли;
	
	ОткрытьФорму("Обработка.ИА_УстановкаУровнейДоступаПользователей.Форма.ФормаВыбораПользователей",,,,,, Новый ОписаниеОповещения("УстановитьПраваГруппеЗавершение", ЭтотОбъект), РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);

КонецПроцедуры

&НаКлиенте
Процедура УстановитьПраваГруппеЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	рез = Результат;
	Если ЗначениеЗаполнено(рез) Тогда
		УстановитьПраваГруппе_Сервер(рез);
		Элементы.Пользователи.Обновить();
		Модифицированность = Ложь;
		ПоказатьПредупреждение(,"Права установлены!");
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура УстановитьПраваГруппе_Сервер(списокПольз)
	
	Для каждого польз из списокПольз Цикл	
		
		// сохраним доступные объекты
		набор = РегистрыСведений.ИА_УровниДоступаПользователей.СоздатьНаборЗаписей();
		Набор.Отбор.Пользователь.Значение = польз;
		Набор.Отбор.Пользователь.Использование = Истина;
		Набор.Прочитать();
		
		//посты
		ИсхДостПосты = Новый Массив;
		Для каждого стр из Набор Цикл
			Если ТипЗнч(стр.ОбъектДоступа) = Тип("СправочникСсылка.ОргСхема") И ЗначениеЗаполнено(Стр.ОбъектДоступа) Тогда
				ИсхДостПосты.Добавить(стр.ОбъектДоступа);
			КонецЕсли;
		КонецЦикла;
		
		Набор.Очистить();
		
		Если Администратор Тогда
			Новстр = Набор.Добавить();
			Новстр.Пользователь = польз;
			Новстр.ОбъектДоступа = Справочники.ОргСхема.ПустаяСсылка();
		КонецЕсли;
		
		Для каждого стрПост из ИсхДостПосты Цикл
			Новстр = Набор.Добавить();
			Новстр.Пользователь = польз;
			Новстр.ОбъектДоступа = стрПост;
		КонецЦикла;
		
		Для каждого стр из Объект.Серии Цикл
			Если стр.Доступно Тогда
				Новстр = Набор.Добавить();
				Новстр.Пользователь = польз;
				Новстр.ОбъектДоступа = стр.Серия;
			КонецЕсли;
		КонецЦикла;
		
		Для каждого стр из Объект.ТипыИнструкции Цикл
			Если стр.Доступно Тогда
				Новстр = Набор.Добавить();
				Новстр.Пользователь = польз;
				Новстр.ОбъектДоступа = стр.ТипИнструкции;
			КонецЕсли;
		КонецЦикла;
		
		Для каждого стр из Объект.Статусы Цикл
			Если стр.Доступно Тогда
				Новстр = Набор.Добавить();
				Новстр.Пользователь = польз;
				Новстр.ОбъектДоступа = стр.Статус;
			КонецЕсли;
		КонецЦикла;
		
		Набор.Записать();
		
		//
		ИА_ОбщиеПроцедуры_Технология_Сервер.ОбновитьДоступныеИнструкцииПользователя(польз, ИсхДостПосты, Администратор);
		
	КонецЦикла;	
КонецПроцедуры


&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Элементы.ТипыИнструкции.Видимость = Константы.ИА_ДИ_КонтрольПоТипамИнструкций.Получить();
	Элементы.Серии.Видимость          = Константы.ИА_ДИ_КонтрольПоСериям.Получить();
	Элементы.Статусы.Видимость        = Константы.ИА_ДИ_КонтрольПоСтатусам.Получить();
КонецПроцедуры


