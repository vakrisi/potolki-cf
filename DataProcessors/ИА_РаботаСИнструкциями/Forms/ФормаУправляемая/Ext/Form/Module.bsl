
&НаКлиенте
Процедура Список(Команда)
	Элементы.ФормаСписок.Пометка = НЕ Элементы.ФормаСписок.Пометка;
	Элементы.ГруппаИнструкции.Видимость = Элементы.ФормаСписок.Пометка;
КонецПроцедуры

&НаКлиенте
Процедура Отбор(Команда)
	Элементы.ФормаОтбор.Пометка = НЕ Элементы.ФормаОтбор.Пометка;
	Элементы.ГруппаОтбор.Видимость = Элементы.ФормаОтбор.Пометка;
КонецПроцедуры

&НаКлиенте
Процедура История(Команда)
	Элементы.ФормаИстория.Пометка = НЕ Элементы.ФормаИстория.Пометка;
	Элементы.ГруппаИстория.Видимость = Элементы.ФормаИстория.Пометка;
КонецПроцедуры

&НаКлиенте
Процедура Обновить(Команда)
	
	ЗаполнитьСписокНаСервере();
	
	ОбновитьОтображениеДанных();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокНаСервере()
	
	дерево = ИА_Защита_ДИ.ЗаполнитьСписокДИНаСервере(Пост, "", Текст, Серия, ТипИнструкции, Статус, ДатаВыпуска);
	
	ЗначениеВРеквизитФормы(дерево, "СписокИнструкций");	
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если не ИА_Защита_Общий.ЛицензияДоступна("ДИ") Тогда
		Отказ = Истина;
		возврат;
	КонецЕсли;
	
	#Если ВебКлиент Тогда
		СисИнфо = Новый СистемнаяИнформация;
		ЭтоИЕ = (Найти(СисИнфо.ИнформацияПрограммыПросмотра, "MSIE")>0);
		
		ПодключитьРасширениеРаботыСФайлами();
	#Иначе
		ЭтоИЕ = Истина;
	#КонецЕсли
	
	
	Если ДокЗадание.Пустая() Тогда
		Элементы.ФормаСписок.Пометка = Истина;
		Элементы.ФормаОтбор.Пометка = Ложь;
		Элементы.ФормаИстория.Пометка = Истина;
		
		//Элементы.ГруппаОтбор.Видимость = Элементы.ФормаОтбор.Пометка;
		
		ЗаполнитьСписокНаСервере();
		
		Если ЗначениеЗаполнено(ВыбИнструкция) Тогда
			ид = ПолучитьИДСтрокиПОИнструкции(СписокИнструкций.ПолучитьЭлементы(), ВыбИнструкция);
			Если ид <> Неопределено Тогда
				Элементы.СписокИнструкций.ТекущаяСтрока = ид;
			КонецЕсли;
		КонецЕсли;
		
		Элементы.Серия.Видимость = ИспользоватьКонтрольПоСериям;
		Элементы.ТипИнструкции.Видимость = ИспользоватьКонтрольПоТипамИнструкций;
		
		Элементы.ФормаПечать.Видимость = не Гугл;
		Элементы.ФормаСохранитьИнструкцииВПапку.Видимость = не Гугл;
		
		Элементы.ГруппаИнструкции.Видимость = истина;
		Элементы.ГруппаЗадание.Видимость = ложь;
		
		Элементы.ФормаСохранить.Видимость = ложь;
	Иначе
		Элементы.ФормаКнопкиВидимость.Видимость = ложь;
		Элементы.ФормаГруппа1.Видимость = ложь;
		Элементы.ФормаГруппа3.Видимость = ложь;
		Элементы.РаботаСАрхивом.Видимость = ложь;
		Элементы.Группа2.Видимость = ложь;
		Элементы.ФормаСохранитьИнструкцииВПапку.Видимость = ложь;
		
		Элементы.ГруппаИстория.Видимость = ложь;
		
		Элементы.ГруппаИнструкции.Видимость = ложь;
		Элементы.ГруппаЗадание.Видимость = истина;
		
		Элементы.ФормаСохранить.Видимость = истина;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Функция ПолучитьИДСтрокиПОИнструкции(пСтроки, пИнструкция)
	ид = Неопределено;
	Для каждого стр из пСтроки Цикл
		Если стр.Ссылка = пИнструкция Тогда
			Возврат стр.ПолучитьИдентификатор();
		КонецЕсли;
		ид = ПолучитьИДСтрокиПОИнструкции(стр.ПолучитьЭлементы(), пИнструкция);
		Если ид<>Неопределено Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Возврат ид;
КонецФункции

&НаКлиенте
Процедура СписокИнструкцийВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Если не Элемент.ТекущиеДанные.ЭтоГруппа Тогда
		ОткрытьИнструкциюНаВесьЭкран(Элемент.ТекущиеДанные.Ссылка);
	КонецЕсли;		
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьИнструкциюНаВесьЭкран(инстр) Экспорт
	флОтбор = Элементы.ФормаОтбор.Пометка;
	флСписок = Элементы.ФормаСписок.Пометка;
	флИстория = Элементы.ФормаИстория.Пометка;
	
	Элементы.ФормаОтбор.Пометка = ложь;
	Элементы.ГруппаОтбор.Видимость = ложь;
	Элементы.ФормаИстория.Пометка = ложь;
	Элементы.ГруппаИстория.Видимость = ложь;
	Элементы.ФормаСписок.Пометка = ложь;
	Элементы.ГруппаИнструкции.Видимость = ложь;
	
	Элементы.ФормаВернутьсяКСписку.Видимость = истина;
	Элементы.ФормаКнопкиВидимость.Видимость = ложь;
	Элементы.ФормаГруппа1.Видимость = ложь;
	
	ЗагрузитьИнструкцию(инстр);
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьИнструкцию(Инструкция, ИгнорироватьИсторию = Ложь)
	
	Если Не ИгнорироватьИсторию Тогда
		ДобавитьСсылкуВИсторию(Инструкция);
	КонецЕсли;
	
	ТекущаяИнструкция = Инструкция;
	
	НовыйТекстHTML = ИА_ОбщиеПроцедуры_Технология_Сервер.ПолучитьПредставлениеИнструкции(Инструкция);
	
	ПодключитьОбработчикОжидания("ПерегрузитьСтраницу", 0.1, истина);
	
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьОпределение(Определение, ИгнорироватьИсторию = Ложь)
	
	Если Не ИгнорироватьИсторию Тогда
		ДобавитьСсылкуВИсторию(Определение);
	КонецЕсли;
	
	ОпределениеТекст = ИА_ОбщиеПроцедуры_Технология_Сервер.ПолучитьДанныеОпределения(Определение);
	
	НовТекст = ИА_ОбщиеПроцедуры_Технология.ВставитьСсылкиНаОпределения(ОпределениеТекст);
	
	НовыйТекстHTML = НовТекст;	
	ПодключитьОбработчикОжидания("ПерегрузитьСтраницу", 0.1, истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ПерегрузитьСтраницу()
	ИмяРеквизита = "ПолеHTML_Просмотр";
	УстановитьТекстHTML(ИмяРеквизита, НовыйТекстHTML);
КонецПроцедуры

&НаКлиенте
Процедура УстановитьТекстHTML(ИмяРеквизита, ИсходныйТекст)
	#Если ВебКлиент или ТолстыйКлиентОбычноеПриложение Тогда
		ЭтаФорма[ИмяРеквизита] = ИсходныйТекст;
	#Иначе
		Элементы[ИмяРеквизита].Документ.open  ("text/html","replace");
		Элементы[ИмяРеквизита].Документ.write (ИсходныйТекст);
		Элементы[ИмяРеквизита].Документ.close ();
	#КонецЕсли
КонецПроцедуры

&НаСервереБезКонтекста 
Функция ПолучитьДанныеИнструкции(Инструкция)
	// ИА_Аврамов 05.02.2016  Спр = Инструкция.ПолучитьОбъект();
	Спр = Инструкция;
	Возврат Новый Структура("Текст, ТекстКолонтитула", Спр.Текст, Спр.ТекстКолонтитула);
КонецФункции

&НаКлиенте
Процедура ПолеHTML_ПросмотрПриНажатии(Элемент, ДанныеСобытия, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	pEvtObj = Новый Структура("srcElement,returnValue",ДанныеСобытия.Element,Неопределено);
	
	элИнструкция  = ИА_ОбщиеПроцедуры_Технология.ИА_ПолучитьСсылкуOnClickПоляHTML(Неопределено, pEvtObj);
	элОпределение = ИА_ОбщиеПроцедуры_Технология.ИА_ПолучитьСсылкуНаГлоссарийOnClickПоляHTML(Неопределено, pEvtObj);
	
	Если ЗначениеЗаполнено(элИнструкция) Тогда
		ЗагрузитьИнструкцию(элИнструкция);
	ИначеЕсли ЗначениеЗаполнено(элОпределение) Тогда
		ЗагрузитьОпределение(элОпределение);
	ИначеЕсли ЗначениеЗаполнено(ДанныеСобытия.Href) Тогда
		Попытка
			ЗапуститьПриложение(ДанныеСобытия.Href);
		Исключение
		КонецПопытки;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПолеHTML_ПросмотрДокументСформирован(Элемент)
	Элемент.Документ.Body.ContentEditable = "false";
	Элемент.Документ.body.scroll = "auto";
КонецПроцедуры

&НаКлиенте
Процедура ИсторияПереходовВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = ложь;
	
	инд = ИсторияПереходов.Индекс(ИсторияПереходов.НайтиПоЗначению(Элемент.ТекущиеДанные.Значение));
	Пока инд>0 Цикл
		ИсторияПереходов.Удалить(0);
		инд = инд - 1;
	КонецЦикла;
	
	ВыбранноеЗначение = Элемент.ТекущиеДанные.Значение;
	Если ТипЗнч(ВыбранноеЗначение) = Тип("СправочникСсылка.ИА_Инструкции") Тогда
		ЗагрузитьИнструкцию(ВыбранноеЗначение);
	ИначеЕсли ТипЗнч(ВыбранноеЗначение) = Тип("СправочникСсылка.ИА_Определения") Тогда
		ЗагрузитьОпределение(ВыбранноеЗначение);
	Иначе
		ПоказатьПредупреждение(,"Неизвестный тип ссылки.");
	КонецЕсли;
	
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьСсылкуВИсторию(Ссылка)
	
	// удаляем всю историю "ВПЕРЕД"
	Если Элементы.ИсторияПереходов.ТекущаяСтрока <> Неопределено Тогда
		знДляУдаления = ИсторияПереходов.НайтиПоИдентификатору(Элементы.ИсторияПереходов.ТекущаяСтрока).Значение;
		
		Кол = ИсторияПереходов.Количество();
		сч = кол-1;
		Удалять = Ложь;
		Пока сч>=0 Цикл
			стр = ИсторияПереходов[сч];
			
			Если удалять тогда
				ИсторияПереходов.Удалить(стр);
				сч = сч - 1;
				Продолжить;
			КонецЕсли;
			
			Если стр.Значение = знДляУдаления Тогда
				Удалять = Истина;
			КонецЕсли;
			сч = сч - 1;
		КонецЦикла;
	КонецЕсли;
	
	// удаляем предыдущие
	НайденныйЭлемент = ИсторияПереходов.НайтиПоЗначению(Ссылка);
	Если НайденныйЭлемент<>Неопределено Тогда
		ИсторияПереходов.Удалить(НайденныйЭлемент);
	КонецЕсли;
	
	ИсторияПереходов.Вставить(0, Ссылка);
	
	Если Элементы.ИсторияПереходов.ВыделенныеСтроки.Количество() = 0 Тогда
		Элементы.ИсторияПереходов.ВыделенныеСтроки.Добавить(ИсторияПереходов[0].ПолучитьИдентификатор());
	Иначе
		Элементы.ИсторияПереходов.ВыделенныеСтроки[0] = ИсторияПереходов[0].ПолучитьИдентификатор();
	КонецЕсли;
	
	Элементы.ИсторияПереходов.ТекущаяСтрока = ИсторияПереходов[0].ПолучитьИдентификатор();
	
КонецПроцедуры

&НаКлиенте
Процедура ИсторияЗначениеОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	Если ТипЗнч(ВыбранноеЗначение) = Тип("СправочникСсылка.ИА_Инструкции") Тогда
		ЗагрузитьИнструкцию(ВыбранноеЗначение);
	ИначеЕсли ТипЗнч(ВыбранноеЗначение) = Тип("СправочникСсылка.ИА_Определения") Тогда
		ЗагрузитьОпределение(ВыбранноеЗначение);
	Иначе
		ПоказатьПредупреждение(,"Неизвестный тип ссылки.");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Печать(Команда)
	ф = ПолучитьФорму("ОбщаяФорма.ИА_ПечатьДолжностнойИнструкцииУправляемая");
	ф.Текст = ПолучитьТекстHTML("ПолеHTML_Просмотр");
	ф.Инструкция = ТекущаяИнструкция;
	ф.Открыть();
КонецПроцедуры

&НаКлиенте
Процедура Навигация(Команда)
	
	Если ИсторияПереходов.Количество()=0 Тогда
		Возврат;
	КонецЕсли;
	
	ТекСтр = ИсторияПереходов.НайтиПоИдентификатору(Элементы.ИсторияПереходов.ТекущаяСтрока);
	
	Если ТекСтр = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИндексТекСтроки = ИсторияПереходов.Индекс(ТекСтр);
	
	Если Команда.Имя = "Назад" Тогда
		ИндексТекСтроки = ИндексТекСтроки + 1;
		Если ИндексТекСтроки>=ИсторияПереходов.Количество() Тогда
			Возврат;
		КонецЕсли;
	ИначеЕсли Команда.Имя = "Вперед" Тогда
		ИндексТекСтроки = ИндексТекСтроки - 1;
		Если ИндексТекСтроки<0 Тогда
			Возврат;
		КонецЕсли;
	Иначе
		Сообщить("Не известная команда "+Команда.Имя+".");
		Возврат;
	КонецЕсли;
	
	Элементы.ИсторияПереходов.ТекущаяСтрока = ИсторияПереходов[ИндексТекСтроки].ПолучитьИдентификатор();
	
	Если Элементы.ИсторияПереходов.ВыделенныеСтроки.Количество() = 0 Тогда
		Элементы.ИсторияПереходов.ВыделенныеСтроки.Добавить(Элементы.ИсторияПереходов.ТекущаяСтрока);
	Иначе
		Элементы.ИсторияПереходов.ВыделенныеСтроки[0] = Элементы.ИсторияПереходов.ТекущаяСтрока;
	КонецЕсли;
	
	ВыбранноеЗначение = ИсторияПереходов[ИндексТекСтроки].Значение;
	
	Если ТипЗнч(ВыбранноеЗначение) = Тип("СправочникСсылка.ИА_Инструкции") Тогда
		ЗагрузитьИнструкцию(ВыбранноеЗначение, Истина);
	ИначеЕсли ТипЗнч(ВыбранноеЗначение) = Тип("СправочникСсылка.ИА_Определения") Тогда
		ЗагрузитьОпределение(ВыбранноеЗначение, Истина);
	Иначе
		ПоказатьПредупреждение(,"Неизвестный тип ссылки.");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтборПриИзменении(Элемент)
	ЗаполнитьСписокНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура СписокИнструкцийПриАктивизацииСтроки(Элемент)
	Если Элемент.ТекущиеДанные<>Неопределено Тогда
		Если не Элемент.ТекущиеДанные.ЭтоГруппа Тогда
			ЗагрузитьИнструкцию(Элемент.ТекущиеДанные.Ссылка);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ВернутьсяКСписку(Команда)
	Элементы.ФормаОтбор.Пометка = флОтбор;
	Элементы.ГруппаОтбор.Видимость = истина;
	Элементы.ФормаИстория.Пометка = флИстория;
	Элементы.ГруппаИстория.Видимость = флИстория;
	Элементы.ФормаСписок.Пометка = флСписок;
	Элементы.ГруппаИнструкции.Видимость = истина;
	
	Элементы.ФормаВернутьсяКСписку.Видимость = ложь;
	Элементы.ФормаКнопкиВидимость.Видимость = истина;
	Элементы.ФормаГруппа1.Видимость = истина;
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Параметры.Свойство("Инструкция", ВыбИнструкция);
	Параметры.Свойство("ДокЗадание", ДокЗадание);
	
	ИспользоватьКонтрольПоСериям          = Константы.ИА_ДИ_КонтрольПоСериям.Получить();
	ИспользоватьКонтрольПоСтатусам        = Константы.ИА_ДИ_КонтрольПоСтатусам.Получить();
	ИспользоватьКонтрольПоТипамИнструкций = Константы.ИА_ДИ_КонтрольПоТипамИнструкций.Получить();
	
	Гугл = Константы.ИА_ДИ_ИспользоватьGoogleДокументы.Получить();
	
	Если не ДокЗадание.Пустая() Тогда
		тзДИ = ДокЗадание.Инструкции.Выгрузить(,"Инструкция,Изучено,УИДстроки,Сдано,ДатаСдачи");
		ЗначениеВРеквизитФормы(тзДИ,"ТабИнструкции");
		
		тзВопр = ДокЗадание.Вопросы.Выгрузить(,"Вопрос,Ответ,УИДстроки");
		ЗначениеВРеквизитФормы(тзВопр,"ТабВопросы");
	КонецЕсли;
	
