&НаСервере
Функция ПолучитьИнструкцииПоОтбору()
	
	ДеревоИнструкций = ИА_Защита_ДИ.ЗаполнитьСписокДИНаСервере(Пост, "", Текст, Серия, ТипИнструкции, Статус, ДатаВыпуска);
	
	ИнструкцииПоОтбору = Новый Массив;
	
	ОбработатьДерево(ДеревоИнструкций,ИнструкцииПоОтбору);    
	
	Возврат ИнструкцииПоОтбору;
	
КонецФункции // ПолучитьИнструкцииПоОтбору()


&НаСервере
Процедура ОбработатьДерево(СтрокаДерева, ИнструкцииПоОтбору)
	
	Для каждого Строка Из СтрокаДерева.Строки Цикл
		Если Строка.Строки.Количество()>0 Тогда
			ОбработатьДерево(Строка, ИнструкцииПоОтбору)
		КонецЕсли;
		
		Если НЕ Строка.Ссылка.ЭтоГруппа  Тогда  
			ПараметрыИнструкции = Новый Соответствие;
			
			СтруктураЗаполнения = ИА_Защита_ДИ.ПолучитьДанныеДокФайла(Строка.Ссылка);
			
			Если СтруктураЗаполнения = Неопределено Тогда						  
				Продолжить;
			Иначе
				ДанныеЗаполнения = ИА_Защита_ДИ.ПолучитьДанныеДокФайла(Строка.Ссылка).Данные; 
			КонецЕсли; 
			
			ПараметрыИнструкции.Вставить(Строка.Наименование, ДанныеЗаполнения);		  
			ИнструкцииПоОтбору.Добавить(ПараметрыИнструкции); 
			
		КонецЕсли;             
	КонецЦикла; 
	
КонецПроцедуры // ОбработатьДерево()


&НаКлиенте
Процедура ПередЗакрытием(Отказ, СтандартнаяОбработка)
	Если Элементы.ФормаВернутьсяКСписку.Видимость Тогда
		ВернутьсяКСписку(Неопределено);
		СтандартнаяОбработка = ложь;
		отказ = истина;
	КонецЕсли;
	
	Если измЗадания = истина Тогда
		отказ = Истина;
		СтандартнаяОбработка = ложь;
		ПоказатьВопрос(Новый ОписаниеОповещения("ПередЗакрытиемЗавершение", ЭтотОбъект), "Сохранить изменения в задании?",РежимДиалогаВопрос.ДаНет);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытиемЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса=КодВозвратаДиалога.Да Тогда
		СохранитьНаСервере();
		Закрыть();
	Иначе
		измЗадания = ложь;
		Закрыть();
	КонецЕсли;

КонецПроцедуры


&НаКлиенте
Процедура ТабИнструкцииПриАктивизацииСтроки(Элемент)
	ТекСтрока = Элемент.ТекущиеДанные;
	Если ТекСтрока<>Неопределено Тогда
		ЗагрузитьИнструкцию(ТекСтрока.Инструкция);
		УИДстроки = ТекСтрока.УИДстроки;
	Иначе
		УИДстроки = "424242424242424242424242424242";
	КонецЕсли;
	    
    Элементы.ТабВопросы.ОтборСтрок = Новый ФиксированнаяСтруктура("УИДстроки", УИДстроки);

КонецПроцедуры


&НаСервере
Процедура СохранитьНаСервере()
	тзИнстр = РеквизитФормыВЗначение("ТабИнструкции");
	тзВопр = РеквизитФормыВЗначение("ТабВопросы");
	
	ДокОб = ДокЗадание.ПолучитьОбъект();
	ДокОб.Инструкции.Загрузить(тзИнстр);
	ДокОб.Вопросы.Загрузить(тзВопр);
	
	Если не ДокОб.ПометкаУдаления Тогда
		ДокОб.Записать(РежимЗаписиДокумента.Проведение);
	Иначе
		ДокОб.Записать();
	КонецЕсли;
	измЗадания = ложь;
КонецПроцедуры


&НаКлиенте
Процедура Сохранить(Команда)
	СохранитьНаСервере();
КонецПроцедуры


