&НаКлиенте
Процедура СохранитьИнструкцииВПапку(Команда)
	
	Режим = РежимДиалогаВыбораФайла.ВыборКаталога;
	ДиалогВыбораКаталога= Новый ДиалогВыбораФайла(Режим);
	
	ДиалогВыбораКаталога.Показать(Новый ОписаниеОповещения("СохранитьИнструкцииВПапкуЗавершение", ЭтотОбъект));    
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьИнструкцииВПапкуЗавершение(ВыбранныеФайлы, ДополнительныеПараметры) Экспорт
	
	Если (ВыбранныеФайлы <> Неопределено) Тогда
		ВыбраныйКаталог = ВыбранныеФайлы[0]+"\";
		Состояние("Получение инструкций",,"",); 
		Результат = ПолучитьИнструкцииПоОтбору();
		
		Для каждого ТекЭлемент Из Результат Цикл
			Для каждого ТекСоответствие Из ТекЭлемент Цикл
				Если ТекСоответствие.Значение = Неопределено Тогда              
					Продолжить;
				КонецЕсли;
				
				ПолныйПутьКФайлу = ВыбраныйКаталог+ТекСоответствие.Ключ+".doc";
				Состояние("Сохранение инструкции",,ТекСоответствие.Ключ,);
				
				ТекСоответствие.Значение.НачатьЗапись(Новый ОписаниеОповещения("ЗаписьЗавершение", ЭтотОбъект),ПолныйПутьКФайлу);
				
			КонецЦикла; 
		КонецЦикла;      
		Состояние("Сохранение инструкция",,"Сохранение завершено",);     
	Иначе
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Не выбран каталог для сохранения инструкций";
		Сообщение.Сообщить(); 
		Возврат;
	КонецЕсли;

КонецПроцедуры

