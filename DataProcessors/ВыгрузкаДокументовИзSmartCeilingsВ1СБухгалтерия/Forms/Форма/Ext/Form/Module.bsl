#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	УстановитьУсловноеОформление();
	
	Объект.ВидыДокументов.Добавить("АвансовыйОтчет", 				"Авансовый отчет");
	Объект.ВидыДокументов.Добавить("ВозвратТовараОтПокупателя", 	"Возврат товаров от покупателя"); //#14475
	Объект.ВидыДокументов.Добавить("ВозвратТовараПоставщику", 		"Возврат товара поставщику"); // #15677
	Объект.ВидыДокументов.Добавить("ВыпускПродукции", 				"Выпуск продукции");
	Объект.ВидыДокументов.Добавить("КорректировкаДолга", 			"Корректировка долга"); // #15677
	Объект.ВидыДокументов.Добавить("Монтаж", 						"Монтаж"); // №12409
	Объект.ВидыДокументов.Добавить("ОплатаБанковскойКартой", 		"Оплата банковской картой"); // #15677
	Объект.ВидыДокументов.Добавить("ОприходованиеТоваров", 			"Оприходование товаров"); // №12409
	Объект.ВидыДокументов.Добавить("ПоступлениеНаРасчетныйСчет", 	"Поступление на расчетный счет");
	Объект.ВидыДокументов.Добавить("ПоступлениеТоваровИУслуг", 		"Поступление товаров и услуг");
	Объект.ВидыДокументов.Добавить("ПриходныйКассовыйОрдер", 		"Приходный кассовый ордер");
	Объект.ВидыДокументов.Добавить("РасходныйКассовыйОрдер", 		"Расходный кассовый ордер");
	Объект.ВидыДокументов.Добавить("РеализацияТоваровИУслуг", 		"Реализация товаров и услуг");
	Объект.ВидыДокументов.Добавить("СписаниеСРасчетногоСчета", 		"Списание с расчетного счета");
	Объект.ВидыДокументов.Добавить("СписаниеТоваров", 				"Списание товаров"); // №12409
	Объект.ВидыДокументов.Добавить("СчетФактураВыданный", 			"Счет-фактура выданный");
	
КонецПроцедуры

&НаСервере
Процедура ПриСохраненииДанныхВНастройкахНаСервере(Настройки)
	
	ВыбранныеТипыДокументов = Новый СписокЗначений;
	Для каждого СтрокаСЗ из Объект.ВидыДокументов Цикл
		Если СтрокаСЗ.Пометка Тогда
			ВыбранныеТипыДокументов.Добавить(СтрокаСЗ.Значение);	
		КонецЕсли;
	КонецЦикла;
	Настройки.Вставить("ВыбранныеТипыДокументов", ВыбранныеТипыДокументов);
	
КонецПроцедуры

&НаСервере
Процедура ПриЗагрузкеДанныхИзНастроекНаСервере(Настройки)
	
	Если ТипЗнч(Настройки) = Тип("Соответствие") Тогда
		ВыбранныеТипыДокументов = Настройки.Получить("ВыбранныеТипыДокументов");
		Если НЕ ВыбранныеТипыДокументов = Неопределено Тогда
			Для каждого СтрокаСЗ из ВыбранныеТипыДокументов Цикл
				СтрокаВидаДокумента = Объект.ВидыДокументов.НайтиПоЗначению(СтрокаСЗ.Значение);
				Если НЕ СтрокаВидаДокумента = Неопределено Тогда
					СтрокаВидаДокумента.Пометка = Истина;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;	
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура ДокументыCRMПометкаПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ДокументыCRM.ТекущиеДанные;
	Если ТекущиеДанные.ЕстьКритичныеОшибки И ТекущиеДанные.Пометка Тогда
		ТекущиеДанные.Пометка = Ложь;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ДокументыCRMВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ПоказатьЗначение(,  Элемент.ТекущиеДанные.Ссылка);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	УсловноеОформление.Элементы.Очистить();
	
	// 
	ЭлементУО = УсловноеОформление.Элементы.Добавить();

	ПолеЭлемента 		= ЭлементУО.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле 	= Новый ПолеКомпоновкиДанных("ДокументыCRM");
	
	ГруппаОтбора = ЭлементУО.Отбор.Элементы.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
	ГруппаОтбора.ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИЛИ;
	
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ГруппаОтбора,
		"Объект.ДокументыCRM.НеНайденаНоменклатура", ВидСравненияКомпоновкиДанных.Равно, Истина);
	
		ГруппаОтбора2 = ГруппаОтбора.Элементы.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
		ГруппаОтбора.ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИ;
					
		ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ГруппаОтбора2,
			"Объект.ДокументыCRM.Контрагент", ВидСравненияКомпоновкиДанных.НеЗаполнено);
		
		ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ГруппаОтбора2,
			"Объект.ДокументыCRM.НеТребуетсяКонтрагент", ВидСравненияКомпоновкиДанных.Равно, Ложь);

	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", WebЦвета.Красный);
	
	//
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	
	ПолеЭлемента = ЭлементУО.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных("ДокументыCRM");

	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.ДокументыCRM.ЕстьКритичныеОшибки", ВидСравненияКомпоновкиДанных.Равно, Истина);
	
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", WebЦвета.Красный);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Шрифт", Новый Шрифт(, , Истина));
	
	//
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	
	ПолеЭлемента = ЭлементУО.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных("ДокументыCRMПометка");

	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.ДокументыCRM.ЕстьКритичныеОшибки", ВидСравненияКомпоновкиДанных.Равно, Истина);
	
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Доступность",    Ложь);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
	
	//
	
КонецПроцедуры

&НаСервере
Функция ИмяПоЗначениюПеречисления(ИмяПеречисления, ЗначениеПеречисления)
		
	ИндексЗначения = Перечисления[ИмяПеречисления].Индекс(ЗначениеПеречисления);	
	ИмяЗначения    = Метаданные.Перечисления[ИмяПеречисления].ЗначенияПеречисления.Получить(ИндексЗначения).Имя;
	Возврат ИмяЗначения;	
		
КонецФункции

//++ #15677
&НаСервере
Функция ДобавитьИерархиюНоменклатуры(НоменклатураСсылка, СписокНоменклатуры)
	
	ТекНоменклатура = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(НоменклатураСсылка, "Родитель");
	Если ЗначениеЗаполнено(ТекНоменклатура) Тогда
		Если СписокНоменклатуры.НайтиПоЗначению(ТекНоменклатура) = Неопределено Тогда				
			СписокНоменклатуры.Добавить(ТекНоменклатура);
			ДобавитьИерархиюНоменклатуры(ТекНоменклатура, СписокНоменклатуры);	
		КонецЕсли;
	КонецЕсли;
	
КонецФункции
