&НаКлиенте
Процедура УстановитьФлажки(Команда)
	
	Для Каждого СтрокаТЧ Из Объект.ДокументыCRM Цикл
		Если СтрокаТЧ.ЕстьКритичныеОшибки Тогда
			Продолжить;
		КонецЕсли;
		СтрокаТЧ.Пометка = Истина;
	КонецЦикла;
	СохраняемыеВНастройкахДанныеМодифицированы = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура СнятьФлажки(Команда)
	
	Для Каждого Строка Из Объект.ДокументыCRM Цикл
		Строка.Пометка = Ложь;
	КонецЦикла;
	СохраняемыеВНастройкахДанныеМодифицированы = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ПолучитьДокументы(Команда)
	ПолучитьДокументыНаСервере();
КонецПроцедуры

&НаСервере
Процедура ПолучитьДокументыНаСервере()
	
	Объект.ДокументыCRM.Очистить();
	//Объект.Товары.Очистить();
	//Объект.Услуги.Очистить();
	
	Для Каждого ВидДок Из Объект.ВидыДокументов Цикл
		
		Если Не ВидДок.Пометка Тогда
			Продолжить;
		КонецЕсли;
		
		Запрос = новый Запрос;
		Запрос.УстановитьПараметр("ИНН", Объект.Организация.ИНН);
		Запрос.УстановитьПараметр("НачПериода", НачалоДня(Объект.ПериодОтбора.ДатаНачала));
		Запрос.УстановитьПараметр("КонПериода", КонецДня(Объект.ПериодОтбора.ДатаОкончания));
		Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДокументДляЗагрузки.Ссылка КАК Ссылка,
		|	ДокументДляЗагрузки.Дата КАК Дата,
		|	ДокументДляЗагрузки.Номер КАК Номер,
		|	ВЫБОР
		|		КОГДА ДокументДляЗагрузки.ПометкаУдаления = ИСТИНА
		|			ТОГДА 2
		|		ИНАЧЕ ВЫБОР
		|				КОГДА ДокументДляЗагрузки.Проведен = ИСТИНА
		|					ТОГДА 1
		|				ИНАЧЕ 0
		|			КОНЕЦ
		|	КОНЕЦ КАК СостояниеДокумента,
		|	ПРЕДСТАВЛЕНИЕ(ТИПЗНАЧЕНИЯ(ДокументДляЗагрузки.Ссылка)) КАК ВидДокумента,
		|	ДокументДляЗагрузки.Организация.ИНН КАК Организация,";
		
		//++ №12409 поля смотрим по метаданным, чтобы не делать кучу условий по видам документов (кроме обращения через точку)
		ВозможныеПоля = новый Соответствие;
		ВозможныеПоля.Вставить("Контрагент", 		"Контрагент");
		ВозможныеПоля.Вставить("СуммаДокумента",	"Сумма");
		ВозможныеПоля.Вставить("Сумма",				"Сумма");
		ВозможныеПоля.Вставить("ВхНомер",			"НомерВходящегоДокумента");
		ВозможныеПоля.Вставить("ВхДата",	 		"ДатаВходящегоДокумента");
		ВозможныеПоля.Вставить("Комментарий", 		"Комментарий");
		ВозможныеПоля.Вставить("Сотрудник", 		"Сотрудник");
		
		Для Каждого ВозможноеПоле Из ВозможныеПоля Цикл
			
			Если Метаданные.Документы[СокрЛП(ВидДок.Значение)].Реквизиты.Найти(ВозможноеПоле.Ключ) = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			Запрос.Текст = Запрос.Текст + СтрШаблон("
			|	ДокументДляЗагрузки.%1 КАК %2,", ВозможноеПоле.Ключ, ВозможноеПоле.Значение);
			
		КонецЦикла;
		//-- №12409
		
		//++ №12409 комментируем, т.к. выше реализовано по новому
		//Если Не ВидДок.Значение = "АвансовыйОтчет" И НЕ ВидДок.Значение = "ВыпускПродукции" Тогда
		//	Запрос.Текст = Запрос.Текст + "
		//	|	ДокументДляЗагрузки.Контрагент КАК Контрагент,";
		//	Если ВидДок.Значение = "РеализацияТоваровИУслуг" Тогда
		//		Запрос.Текст = Запрос.Текст + "
		//		|	ДокументДляЗагрузки.СуммаДокумента КАК Сумма,";
		//	ИначеЕсли ВидДок.Значение = "ПоступлениеТоваровИУслуг" Тогда
		//		Запрос.Текст = Запрос.Текст + "
		//		|	ДокументДляЗагрузки.СуммаДокумента КАК Сумма,
		//		|	ДокументДляЗагрузки.ВхНомер КАК НомерВходящегоДокумента,
		//		|	ДокументДляЗагрузки.ВхДата КАК ДатаВходящегоДокумента,";
		//	ИначеЕсли НЕ ВидДок.Значение = "СчетФактураВыданный" Тогда
		//		Запрос.Текст = Запрос.Текст + "
		//		|	ДокументДляЗагрузки.Сумма КАК Сумма,";
		//	КонецЕсли;
		//	Запрос.Текст = Запрос.Текст + "
		//	|	ДокументДляЗагрузки.Комментарий КАК Комментарий,"
		//КонецЕсли;
		//
		//Если ВидДок.Значение = "АвансовыйОтчет" ИЛИ ВидДок.Значение = "ПриходныйКассовыйОрдер" ИЛИ ВидДок.Значение = "РасходныйКассовыйОрдер" Тогда
		//	Запрос.Текст = Запрос.Текст + "
		//	|	ДокументДляЗагрузки.Сотрудник КАК Сотрудник,";
		//КонецЕсли;
		//-- №12409 комментируем, т.к. выше реализовано по новому
		
		Если НЕ ВидДок.Значение = "ВыпускПродукции"
			И НЕ ВидДок.Значение = "СписаниеТоваров" // №12409
			И НЕ ВидДок.Значение = "КорректировкаДолга"
		Тогда
			
		    Запрос.Текст = Запрос.Текст + "
			|	ДокументДляЗагрузки.Валюта.Код КАК Валюта,";
			
		КонецЕсли;
		
		Запрос.Текст = Запрос.Текст + "		
		|	Истина КАК Пометка
		//|	ПРЕДСТАВЛЕНИЕССЫЛКИ(ДокументДляЗагрузки.Ссылка) КАК Представление
		|ИЗ
		|	Документ." + СокрЛП(ВидДок.Значение) + " КАК ДокументДляЗагрузки
		|ГДЕ
		|	ДокументДляЗагрузки.Организация.ИНН = &ИНН
		|	И ДокументДляЗагрузки.Дата МЕЖДУ &НачПериода И &КонПериода";		
		
		Запрос.Текст = Запрос.Текст + "
		|
		|УПОРЯДОЧИТЬ ПО
		|	Дата";
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Пока Выборка.Следующий() Цикл
			
			СтрокаДокумента = Объект.ДокументыCRM.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаДокумента, Выборка);
			СтрокаДокумента.Организация = Объект.Организация;
			
			СтрокаДокумента.НеТребуетсяКонтрагент = (СтрокаДокумента.ВидДок = "ВыпускПродукции" 
												 ИЛИ СтрокаДокумента.ВидДок = "КорректировкаДолга");
			
			Попытка
				СтрокаДокумента.Контрагент = Выборка.Контрагент;
			Исключение
			КонецПопытки;
			
			Если НЕ ЗначениеЗаполнено(СтрокаДокумента.Контрагент) Тогда
				Попытка
					СтрокаДокумента.Контрагент = Выборка.Сотрудник;
				Исключение
				КонецПопытки;
			КонецЕсли;
			
			//НовДок.Валюта = Справочники.Валюты.НайтиПоКоду(СокрЛП(Выборка.Валюта));
			СтрокаДокумента.ВидДок = ВидДок.Значение;
			
			//получим табличные части документа
			//Если НовДок.ВидДок = "АвансовыйОтчет" 
			//	ИЛИ НовДок.ВидДок = "РеализацияТоваровИУслуг"
			//	ИЛИ НовДок.ВидДок = "ПоступлениеТоваровИУслуг" Тогда
			//	
			//	//товары
			//	ПодЗапрос = новый Запрос;
			//	ПодЗапрос.Текст = 
			//	"ВЫБРАТЬ
			//	|	ТабличнаяЧастьДокумента.Номенклатура.Наименование КАК НоменклатураСтрокой,
			//	|	ТабличнаяЧастьДокумента.Номенклатура.Код КАК НоменклатураСтрокойКод,
			//	|	ТабличнаяЧастьДокумента.Количество * ТабличнаяЧастьДокумента.Коэффициент КАК Количество,
			//	|	ТабличнаяЧастьДокумента.Цена КАК Цена,
