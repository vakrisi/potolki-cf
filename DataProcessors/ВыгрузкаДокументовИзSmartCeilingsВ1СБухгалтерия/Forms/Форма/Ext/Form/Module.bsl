	|	ПРЕДСТАВЛЕНИЕ(ЕСТЬNULL(Спр.БазоваяЕдиницаИзмерения.Код, """")) КАК БазоваяЕдиницаИзмеренияКод,
	|	ПРЕДСТАВЛЕНИЕ(ЕСТЬNULL(Спр.НоменклатурнаяГруппа, """")) КАК НоменклатурнаяГруппа,
	|	Спр.ЭтоГруппа КАК ЭтоГруппа
	|ИЗ
