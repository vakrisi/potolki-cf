	|	РегистрНакопления.ТоварыНаСкладах.Обороты(, , Регистратор, ) КАК ТоварыНаСкладахОбороты
	|ГДЕ
	|	ТоварыНаСкладахОбороты.Регистратор В(&МассивСсылок)";

	Запрос.УстановитьПараметр("МассивСсылок", МассивСсылок);
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	ТаблицаДанных = РезультатЗапроса[0].Выгрузить();
	
	//++ #15677
	ТаблицаСебестоимости = РезультатЗапроса[1].Выгрузить();
	Для Каждого СтрокаДокумента Из ТаблицаДанных Цикл
		Для Каждого СтрокаТаблицы Из СтрокаДокумента.мТовары Цикл
			Если НЕ ЗначениеЗаполнено(СтрокаТаблицы.ДокументПродажи) Тогда
				НайденныеСтроки = ТаблицаСебестоимости.НайтиСтроки(Новый Структура("Регистратор, Номенклатура", СтрокаДокумента.СсылкаКУдалению, СтрокаТаблицы.Номенклатура));	
				Если НайденныеСтроки.Количество() > 0 Тогда
					СтрокаТаблицы.Себестоимость = НайденныеСтроки[0].Себестоимость;	
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	//-- #15677
	
	ОбработатьТаблицуДанныхПередВыгрузкой(ТаблицаДанных);
	
	СтруктураДанных.Документы.Вставить("ВозвратТовараОтПокупателя", ОбщегоНазначения.ТаблицаЗначенийВМассив(ТаблицаДанных));
	
