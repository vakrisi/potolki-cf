			ТекущаяСтрока.ПродукцияГУИД = ТекущаяСтрока.ПродукцияНоменклатура.УникальныйИдентификатор();
			
		КонецЕсли;
		
		// Обработка сотрудника
		Если ЕстьКолонкаСотрудник Тогда
		
			Если СписокСотрудников.НайтиПоЗначению(ТекущаяСтрока.Сотрудник) = Неопределено Тогда
				
				СписокСотрудников.Добавить(ТекущаяСтрока.Сотрудник);
				
			КонецЕсли;
			
			ТекущаяСтрока.СотрудникГУИД = ТекущаяСтрока.Сотрудник.УникальныйИдентификатор();
			
		КонецЕсли;
		
		// Обработка табличной части ПлатежноРасчетныеДокументы
		Если ЕстьКолонкамПлатежноРасчетныеДокументы Тогда
			
			ТекущаяСтрока.ПлатежноРасчетныеДокументы = ОбщегоНазначения.ТаблицаЗначенийВМассив(ТекущаяСтрока.мПлатежноРасчетныеДокументы);
			
		КонецЕсли;
		
		// Обработка табличной части ЗарплатаСотрудникам
		Если ЕстьКолонкаЗарплатаСотрудникам Тогда
			
			ТекущаяСтрока.мЗарплатаСотрудникам.Колонки.Добавить("СотрудникГУИД", новый ОписаниеТипов("Строка"));
			
			// В табличной части по сотруднику укажем ГУИД
			Для Каждого СтрокаТаблицы Из ТекущаяСтрока.мЗарплатаСотрудникам Цикл
				
				Если СписокСотрудников.НайтиПоЗначению(СтрокаТаблицы.Сотрудник) = Неопределено Тогда
					
					СписокСотрудников.Добавить(СтрокаТаблицы.Сотрудник);
					
				КонецЕсли;
				
				СтрокаТаблицы.СотрудникГУИД = СтрокаТаблицы.Сотрудник.УникальныйИдентификатор();
				
			КонецЦикла;
			
			ТекущаяСтрока.мЗарплатаСотрудникам.Колонки.Удалить(ТекущаяСтрока.мЗарплатаСотрудникам.Колонки.Найти("Сотрудник"));
			
			ТекущаяСтрока.ЗарплатаСотрудникам = ОбщегоНазначения.ТаблицаЗначенийВМассив(ТекущаяСтрока.мЗарплатаСотрудникам);
			
		КонецЕсли;
		
		Если ЕстьКолонкаКонтактнаяИнформация Тогда			
			ТекущаяСтрока.КонтактнаяИнформация = ОбщегоНазначения.ТаблицаЗначенийВМассив(ТекущаяСтрока.мКонтактнаяИнформация);			
		КонецЕсли;
		
		//++ #15677 
		Если ЕстьКолонкаДолги Тогда
			СтруктураОбработки = Новый Структура;
			СтруктураОбработки.Вставить("мУвеличениеДолгаПокупателей" ,"УвеличениеДолгаПокупателей");
			СтруктураОбработки.Вставить("мУменьшениеДолгаПокупателей", "УменьшениеДолгаПокупателей");
			СтруктураОбработки.Вставить("мУвеличениеДолгаПоставщиков", "УвеличениеДолгаПоставщиков");
			СтруктураОбработки.Вставить("мУменьшениеДолгаПоставщиков", "УменьшениеДолгаПоставщиков");
				
			// В табличной части заполним ГУИД
			Для каждого КЗ из СтруктураОбработки Цикл
				Для Каждого СтрокаТаблицы Из ТекущаяСтрока[КЗ.Ключ] Цикл				
					Если СписокКонтрагентов.НайтиПоЗначению(СтрокаТаблицы.Контрагент) = Неопределено Тогда					
						СписокКонтрагентов.Добавить(СтрокаТаблицы.Контрагент);					
					КонецЕсли;				
					СтрокаТаблицы.КонтрагентГУИД = СтрокаТаблицы.Контрагент.УникальныйИдентификатор();				
					СтрокаТаблицы.ДоговорГУИД = СтрокаТаблицы.Договор.УникальныйИдентификатор();
				КонецЦикла;
				
				ТекущаяСтрока[КЗ.Ключ].Колонки.Удалить(ТекущаяСтрока[КЗ.Ключ].Колонки.Найти("Контрагент"));
				ТекущаяСтрока[КЗ.Ключ].Колонки.Удалить(ТекущаяСтрока[КЗ.Ключ].Колонки.Найти("Договор"));
				
				ТекущаяСтрока[КЗ.Значение] = ОбщегоНазначения.ТаблицаЗначенийВМассив(ТекущаяСтрока[КЗ.Ключ]);
			КонецЦикла;
		КонецЕсли;	
		//-- #15677
		
		//++ #16065
		Если ЕстьКолонкаРаспределениеПлатежа Тогда			
			ТекущаяСтрока.РаспределениеПлатежа = ОбщегоНазначения.ТаблицаЗначенийВМассив(ТекущаяСтрока.мРаспределениеПлатежа);			
		КонецЕсли;
		Если ЕстьКолонкаОснования Тогда			
			ТекущаяСтрока.Основания = ОбщегоНазначения.ТаблицаЗначенийВМассив(ТекущаяСтрока.мОснования);			
		КонецЕсли;
		Если ЕстьКолонкаДУЛ Тогда
			Если ЗначениеЗаполнено(ТекущаяСтрока.ДУЛ) Тогда
				РеквизитыДУЛ = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ТекущаяСтрока.ДУЛ, "Вид, Серия, Номер, КемВыдан, ДатаВыдачи, КодПодразделения");
				ТекущаяСтрока.ПредставлениеДУЛ = СтрШаблон("%1 серия: %2 номер: %3, выдан: %4 %5", РеквизитыДУЛ.Вид, РеквизитыДУЛ.Серия, РеквизитыДУЛ.Номер,
																								   РеквизитыДУЛ.КемВыдан, Формат(РеквизитыДУЛ.ДатаВыдачи,"ДЛФ=Д")); 
			КонецЕсли;
		КонецЕсли;
		//-- #16065
		
		Для каждого ПолеЭкр из МассивПолейЭкранирования Цикл
			ТекущаяСтрока[ПолеЭкр] = ОбщийМодульКлиентСервер.ЭкранироватьСимволыJSON(ТекущаяСтрока[ПолеЭкр]);
		КонецЦикла;
		
	КонецЦикла;
	
	Для Каждого Колонка Из КолонкиКУдалению Цикл
		ТаблицаДанных.Колонки.Удалить(ТаблицаДанных.Колонки.Найти(Колонка));
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура СформироватьДанныеПоУчаствующимОбъектамВДокументах(СтруктураДанных)
	
	// Контрагенты
	Запрос = новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
