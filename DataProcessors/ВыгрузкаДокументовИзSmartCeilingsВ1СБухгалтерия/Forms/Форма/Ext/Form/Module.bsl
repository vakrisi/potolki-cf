&НаКлиенте
Процедура ВыгрузитьДокументы(Команда)
	
	Если НЕ ЗначениеЗаполнено(Объект.ПутьКФайлу) Тогда
		ПоказатьПредупреждение(, "Необходимо указать расположение файла для выгрузки данных!");
		Возврат;
	КонецЕсли;
	
	Данные = СформироватьДанныеНаСервере();
	
	//формируем jSON с данными
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.ОткрытьФайл(Объект.ПутьКФайлу, КодировкаТекста.UTF8,, новый ПараметрыЗаписиJSON(, Символы.Таб));
	ЗаписатьJSON(ЗаписьJSON, Данные);
	
	ЗаписьJSON.Закрыть();
	
	ПоказатьОповещениеПользователя("Выгрузка завершена успешно.");
	
КонецПроцедуры

&НаСервере
Функция СформироватьДанныеНаСервере()
	
	СписокКонтрагентов 	= новый СписокЗначений;
	СписокНоменклатуры 	= новый СписокЗначений;
	СписокСотрудников  	= новый СписокЗначений;
	СписокСкладов  		= новый СписокЗначений;
	СписокДоговоров     = новый СписокЗначений;
	
	СтруктураДанных = новый Структура;
	СтруктураДанных.Вставить("Документы", 	новый Соответствие);
	СтруктураДанных.Вставить("Справочники", новый Соответствие);
	
	ВидыДокументовКВыгрузке = Объект.ДокументыCRM.Выгрузить(, "ВидДок, Пометка");
	ВидыДокументовКВыгрузке.Свернуть("ВидДок", "Пометка");
	
	Для Каждого ТекущаяСтрока Из ВидыДокументовКВыгрузке Цикл
		
		Если НЕ ТекущаяСтрока.Пометка Тогда
			Продолжить;
		КонецЕсли;
		
		СписокДокументовПоВиду = Объект.ДокументыCRM.НайтиСтроки(новый Структура("Пометка, ВидДок", Истина, ТекущаяСтрока.ВидДок));
		
		МассивСсылок = новый Массив;
		
		Для Каждого Док Из СписокДокументовПоВиду Цикл
			МассивСсылок.Добавить(Док.Ссылка);
		КонецЦикла;
		
		Выполнить("СформироватьДанныеПо_" + СокрЛП(ТекущаяСтрока.ВидДок) + "(СтруктураДанных, МассивСсылок)");
		
	КонецЦикла;
	
	// Выгрузка ссылочных объектов, участвующих в документах
	СформироватьДанныеПоУчаствующимОбъектамВДокументах(СтруктураДанных);
	
	Возврат СтруктураДанных;
	
КонецФункции

&НаКлиенте
Процедура ПутьКФайлуНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ДиалогОткрытияФайла = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Сохранение);
	ДиалогОткрытияФайла.ПолноеИмяФайла = "obmen_SmartCeilings_" + Формат(ТекущаяДата(), "ДФ=yyyy-MM-dd") + ".txt";
	ДиалогОткрытияФайла.МножественныйВыбор = Ложь;
	ДиалогОткрытияФайла.Заголовок = "Введите название сохраняемого файла";
	
	Фильтр =  "Файл txt|*.txt";
	ДиалогОткрытияФайла.Фильтр = Фильтр;
	
	ДиалогОткрытияФайла.Показать(новый ОписаниеОповещения("ПослеВыбораФайла", ЭтотОбъект));
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораФайла(ВыбранныеФайлы, Параметры) Экспорт
	
	Если ТипЗнч(ВыбранныеФайлы) = Тип("Массив") И ВыбранныеФайлы.Количество() > 0  Тогда
		Объект.ПутьКФайлу = ВыбранныеФайлы[0];
	КонецЕсли;
	
КонецПроцедуры

