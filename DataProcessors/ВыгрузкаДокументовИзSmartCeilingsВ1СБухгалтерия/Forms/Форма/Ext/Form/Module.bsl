	|	""00000000-0000-0000-0000-000000000000"" КАК ДоговорГУИД,
	|	Док.ДоговорКонтрагента КАК Договор,
	|	ПРЕДСТАВЛЕНИЕ(ЕСТЬNULL(Док.ДоговорКонтрагента, """")) КАК ПредставлениеДоговора,
	|	Док.Контрагент КАК Контрагент,
	|	ПРЕДСТАВЛЕНИЕ(Док.СуммаДокумента) КАК Сумма,
	|	ВЫБОР
	|		КОГДА Док.ПометкаУдаления = ИСТИНА
	|			ТОГДА 2
	|		ИНАЧЕ ВЫБОР
	|				КОГДА Док.Проведен = ИСТИНА
	|					ТОГДА 1
	|				ИНАЧЕ 0
	|			КОНЕЦ
	|	КОНЕЦ КАК СостояниеДокумента,
	|	Док.Товары.(
	|		""00000000-0000-0000-0000-000000000000"" КАК ДокументПродажиГУИД,
	|		ДокументПродажи КАК ДокументПродажи,
	|		Номенклатура КАК Номенклатура,
	|		ПРЕДСТАВЛЕНИЕ(Док.Товары.ЕдиницаИзмерения) КАК ЕдиницаИзмерения,
