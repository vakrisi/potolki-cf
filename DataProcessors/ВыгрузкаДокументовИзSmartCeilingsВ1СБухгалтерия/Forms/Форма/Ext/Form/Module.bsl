&НаСервере
Процедура ОбработатьТаблицуДанныхПередВыгрузкой(ТаблицаДанных)
	
	// Колонки:
	// - с ссылочным типом, будут перед выгрузкой удаляться, предварительно перенеся их ГУИДы
	// - таблицы значений, будут преобразовываться в массив со структурой, перед выгрузкой удаляться
	КолонкиКУдалению = новый Массив;
	
	ЕстьКолонкаСсылкаКУдалению = (НЕ ТаблицаДанных.Колонки.Найти("СсылкаКУдалению") = Неопределено);
	ЕстьКолонкаОснование = (НЕ ТаблицаДанных.Колонки.Найти("Основание") = Неопределено);
	ЕстьКолонкаКонтрагент = (НЕ ТаблицаДанных.Колонки.Найти("Контрагент") = Неопределено);
	ЕстьКолонкаДоговор = (НЕ ТаблицаДанных.Колонки.Найти("Договор") = Неопределено);
