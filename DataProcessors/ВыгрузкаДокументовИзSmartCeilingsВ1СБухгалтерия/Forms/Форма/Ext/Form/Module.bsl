	Для Каждого ТекущийДокумент Из ТаблицаДанных Цикл
		
		КоличествоСтрок = ТекущийДокумент.мТовары.Количество() - 1;
		Для Сч = 0 По КоличествоСтрок Цикл
			
			Если Справочники.ВидыНоменклатуры.ЭтоНоменклатураУслуга(ТекущийДокумент.мТовары[КоличествоСтрок - Сч].Номенклатура) Тогда
				ТекущийДокумент.мТовары.Удалить(КоличествоСтрок - Сч);
			Иначе
				ТекущийДокумент.мУслуги.Удалить(КоличествоСтрок - Сч);
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
	ОбработатьТаблицуДанныхПередВыгрузкой(ТаблицаДанных);
	
	СтруктураДанных.Документы.Вставить("Монтаж", ОбщегоНазначения.ТаблицаЗначенийВМассив(ТаблицаДанных));
	
