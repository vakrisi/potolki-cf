&НаКлиенте
Процедура КомандаСумма(Команда)

	ПолеРедактирования = "Сумма";
	ПервыйВвод = Истина;
	Элементы.ВводимаяСумма.ТолькоПросмотр = Ложь;
	Элементы.ВводимыйНомерКарты.ТолькоПросмотр = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаНомерКарты(Команда)
	
	ПолеРедактирования = "НомерКарты";
	ПервыйВвод = Истина;
	Элементы.ВводимаяСумма.ТолькоПросмотр = Истина;
	Элементы.ВводимыйНомерКарты.ТолькоПросмотр = Ложь;
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаВидКарты(Команда)
	
	ПолеРедактирования = "ВидКарты";
	ПервыйВвод = Истина;
	
	Элементы.ВводимаяСумма.ТолькоПросмотр = Истина;
	Элементы.ВводимыйНомерКарты.ТолькоПросмотр = Истина;
    
	ОбработчикОповещения = Новый ОписаниеОповещения("ОповещениеОткрытьФормуВыбораВидаКарты", ЭтотОбъект);
	Режим = РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс;
	ОткрытьФорму("Справочник.ВидыПлатежныхКарт.ФормаВыбора",,,,,, ОбработчикОповещения, Режим);

КонецПроцедуры

&НаКлиенте
Процедура ОповещениеОткрытьФормуВыбораВидаКарты(РезультатОткрытияФормы, ДополнительныеПараметры) Экспорт
	
	Если ЗначениеЗаполнено(РезультатОткрытияФормы) Тогда
		ВводимыйВидКарты = РезультатОткрытияФормы;
	КонецЕсли;
	
КонецПроцедуры


