&НаКлиенте
Процедура КомандаТочка(Команда)
	
	Если ПервыйВвод Тогда
		ВводимаяСумма = "";
		ПервыйВвод = Ложь;
	КонецЕсли;
	
	Если ВводимаяСумма = "" Тогда
		ВводимаяСумма = "0";
	КонецЕсли;
	
	ЧислоВхождений = СтрЧислоВхождений(ВводимаяСумма, ",");
	
	Если Не ЧислоВхождений > 0 Тогда
		ВводимаяСумма = ВводимаяСумма + ",";
	КонецЕсли;
КонецПроцедуры

