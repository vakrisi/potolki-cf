	СтруктураДанных = ОбщийМодульКлиентСервер.СтруктураДляОбновленияТаблоНоменклатурыРМК();
	СтруктураДанных.ВыведеныЧеки            = ВыведеныЧеки;
	СтруктураДанных.ОставлятьФлагТаблоСдачи = ОставлятьФлагТаблоСдачи;
