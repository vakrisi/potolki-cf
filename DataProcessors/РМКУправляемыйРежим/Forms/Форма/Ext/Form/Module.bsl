//	ПодключаемоеОборудованиеРТВызовСервера.ПолучитьДоступноеПодключаемоеОборудование(
//		ИспользоватьПодключаемоеОборудование, ПодключаемоеОборудованиеЕстьТСД, ПодключаемоеОборудованиеЕстьВесы);
	ИспользоватьПодключаемоеОборудование = Константы.ИспользоватьПодключаемоеОборудование.Получить();
//	ПараметрыСобытийПО = Новый Структура;
//	ПараметрыСобытийПО.Вставить("РегистрацияНовойКарты", Истина);
//	ПараметрыСобытийПО.Вставить("ПоискАкцизнойМарки", Истина);
