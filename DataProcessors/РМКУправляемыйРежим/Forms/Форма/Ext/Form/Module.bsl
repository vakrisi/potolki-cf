	Пользователь = Пользователи.ТекущийПользователь();
	ТекущийПользователь = Пользователи.ТекущийПользователь();
	РеквизитыПользователя = ОбщийМодульСервер.НастройкиПользователя("Магазин, Подразделение, НастройкаРМК, Сотрудник", ТекущийПользователь);

	Если Параметры.Свойство("РабочееМесто") Тогда
		Объект.РабочееМесто = Параметры.РабочееМесто;
	КонецЕсли;
	
	Если Параметры.Свойство("РасчетноеВремяЗакрытияКассы") Тогда
		РасчетноеВремяЗакрытияКассы = Параметры.РасчетноеВремяЗакрытияКассы;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Объект.Магазин) Тогда
		Объект.Магазин = РеквизитыПользователя.Магазин;
		СкладПродажиПоУмолчанию = Объект.Магазин.Склад;
	КонецЕсли;
	
