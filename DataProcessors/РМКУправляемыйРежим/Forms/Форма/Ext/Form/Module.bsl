//		СтрокаТабличнойЧасти.Цена,
//		Неопределено,
//		УменьшениеСуммыЧекаККМ);
	
	ОбновитьФорму();
//	ОбновлениеДисплеяПокупателя("ИзмененияЦены");
КонецПроцедуры

