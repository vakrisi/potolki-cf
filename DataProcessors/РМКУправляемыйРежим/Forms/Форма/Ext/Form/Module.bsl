&НаСервере
Процедура НазначитьРучнуюСкидку(СуммаСкидкиНаценки)
	
	Если СуммаСкидкиНаценки <> 0 Тогда
		ОбработкаТабличныхЧастейСервер.НазначитьРучнуюСкидку(Объект, "Товары", СуммаСкидкиНаценки, Истина, Истина);
	Иначе
		ОбработкаТабличныхЧастейСервер.ОтменитьРучныеСкидки(Объект, "Товары", Ложь, УчитыватьНДС);
	КонецЕсли;

	
КонецПроцедуры

&НаСервере
Процедура ОтменитьРучныеСкидки()
	
	ОбработкаТабличныхЧастейСервер.ОтменитьРучныеСкидки(Объект, "Товары", Истина, Истина);
	ОбработкаТабличныхЧастейКлиентСервер.ЗаполнитьСуммуВсегоВТаблице(Объект.Товары, Объект.ЦенаВключаетНДС);
//	ЛогированиеВводаРучнойСкидки(НСтр("ru = 'Отмена ручной скидки в чеке'"), 0, 0);
	
