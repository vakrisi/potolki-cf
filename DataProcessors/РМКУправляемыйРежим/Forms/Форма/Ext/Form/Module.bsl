&НаКлиенте
Процедура УдалениеСтрокиКлиент()
	
	ДанныеСтрокиТовары = Элементы.Товары.ТекущиеДанные;
	
	Если ДанныеСтрокиТовары <> Неопределено Тогда
		
		СтруктураПараметровКлиента = Новый Структура;
		СтруктураПараметровКлиента.Вставить("ИдентификаторСтроки", ДанныеСтрокиТовары.ПолучитьИдентификатор());
		
		ТекстВопроса = НСтр("ru = 'Удалить выбранную строку?'");
		ОбработчикОповещения = Новый ОписаниеОповещения("ОповещениеУдалениеСтрокиТоваровЗавершение", ЭтотОбъект, СтруктураПараметровКлиента);
		ОбщийМодульКлиент.ВывестиВопросДляРМКУправляемой(ТекстВопроса,,, ОбработчикОповещения);
	
	КонецЕсли;
	
КонецПроцедуры
	
