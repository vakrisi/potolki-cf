//	СтруктураДанных.ЭтоОплатаРассрочки           = ЭтоОплатаРассрочки;
	СтруктураДанных.Продавец                     = Объект.Продавец;
//	СтруктураДанных.РеверсКнопкиПродавец         = РеверсКнопкиПродавец;
