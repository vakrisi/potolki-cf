#Область КассыККМ

&НаСервере
Процедура ЗаполнитьИспользуемыеКассыККМ()

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ДанныеСправочника.Ссылка КАК КассаККМ,
	|	ДанныеСправочника.Владелец КАК Организация,
	|	ДанныеСправочника.ПодключаемоеОборудование.ТипОборудования КАК ТипОборудования
	|ИЗ
	|	Справочник.КассыККМ КАК ДанныеСправочника
	|ГДЕ
	|	НЕ ДанныеСправочника.ПометкаУдаления
	|	И ДанныеСправочника.РабочееМесто = &РабочееМесто
	|	И (ДанныеСправочника.Магазин = &Магазин
	|			ИЛИ &Магазин = ЗНАЧЕНИЕ(Справочник.Магазины.ПустаяСсылка))
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДанныеСправочника.Наименование";
	
	Запрос.УстановитьПараметр("РабочееМесто", 	Объект.РабочееМесто);
	Запрос.УстановитьПараметр("Магазин",		Объект.Магазин);
	//Запрос.УстановитьПараметр("ККТОнлайн"   , 	Перечисления.ТипыПодключаемогоОборудования.ККТ);
		
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = ТаблицаКассККМОрганизаций.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		Если Выборка.ТипОборудования = Перечисления.ТипыПодключаемогоОборудования.ККТ Тогда
			ЕстьПередачаОФД = Истина;
		КонецЕсли;
	КонецЦикла;
	
	Если ТаблицаКассККМОрганизаций.Количество() = 1 Тогда
		Объект.Организация = ТаблицаКассККМОрганизаций[0].Организация;
	КонецЕсли;
		
КонецПроцедуры

