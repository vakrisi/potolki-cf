	ОбработкаТабличныхЧастейКлиент.ПересчитатьСуммуРучнойСкидкиВСтрокеТЧ(СтрокаТабличнойЧасти);
	ОбработкаТабличныхЧастейКлиент.ПересчитатьСуммуСУчетомСкидокВСтрокеТЧ(СтрокаТабличнойЧасти, Ложь); //, ИспользуютсяАвтоматическиеСкидки);
	ОбработкаТабличныхЧастейКлиент.ПересчитатьСуммуНДСВСтрокеТЧ(СтрокаТабличнойЧасти, Объект.ЦенаВключаетНДС);
	
	ОбработкаТабличныхЧастейКлиентСервер.ЗаполнитьСуммуВсегоВТаблице(Объект.Товары, Объект.ЦенаВключаетНДС);
	
	СуммаПослеРасчета = СтрокаТабличнойЧасти.Сумма;
	УменьшениеСуммыЧекаККМ = СуммаДоРасчета - СуммаПослеРасчета;
	УменьшениеСуммыЧекаККМ = ?(УменьшениеСуммыЧекаККМ > 0, УменьшениеСуммыЧекаККМ, 0);
