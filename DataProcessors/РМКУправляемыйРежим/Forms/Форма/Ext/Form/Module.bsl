&НаСервере
Функция ЕстьОплатаПлатежнойКартой(ОбъектЧекККМ)

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВЫРАЗИТЬ(Оплата.ВидОплаты КАК Перечисление.ВидыОплатЧекаККМ) КАК ВидОплаты,
	|	ВЫРАЗИТЬ(Оплата.Сумма КАК ЧИСЛО) КАК Сумма
	|ПОМЕСТИТЬ ТаблицаОплаты
	|ИЗ
	|	&Оплата КАК Оплата
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТаблицаОплаты.ВидОплаты,
	|	ТаблицаОплаты.Сумма
	|ИЗ
	|	ТаблицаОплаты КАК ТаблицаОплаты
	|ГДЕ
	|	ТаблицаОплаты.ВидОплаты = ЗНАЧЕНИЕ(Перечисление.ВидыОплатЧекаККМ.ПлатежнаяКарта)
	|	И ТаблицаОплаты.Сумма > 0";
	
	Запрос.УстановитьПараметр("Оплата", ОбъектЧекККМ.Оплата.Выгрузить());
	
	Результат = Запрос.Выполнить();
	
	Возврат Не Результат.Пустой();
КонецФункции

