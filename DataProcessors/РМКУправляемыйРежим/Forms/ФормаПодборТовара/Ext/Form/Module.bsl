	|					ИНАЧЕ Организация = &Организация
	|				КОНЕЦ
	|				И НЕ Склад = &СкладМагазина
	|				И Номенклатура = &Номенклатура
	|				И ХарактеристикаНоменклатуры = &Характеристика) КАК ТоварыНаСкладахОстатки
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыВРезервеНаСкладах.Остатки(
	|				,
	|				ВЫБОР
	|						КОГДА &ИспользуютсяОбщиеСклады
	|							ТОГДА ИСТИНА
	|						ИНАЧЕ Организация = &Организация
	|					КОНЕЦ
	|					И НЕ Склад = &СкладМагазина
	|					И Номенклатура = &Номенклатура
	|					И ХарактеристикаНоменклатуры = &Характеристика) КАК ВРезервеОстатки
	|		ПО (ВРезервеОстатки.Склад = ТоварыНаСкладахОстатки.Склад)";

	Результат = Запрос.Выполнить();		
	Выборка = Результат.Выбрать();
	
	Пока Выборка.Следующий() Цикл			
