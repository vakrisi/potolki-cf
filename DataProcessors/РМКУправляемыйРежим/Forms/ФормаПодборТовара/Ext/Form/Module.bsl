&НаСервере
Процедура ПередЗагрузкойДанныхИзНастроекНаСервере(Настройки)
	
	СохраненноеИмяТекущейСтраницы = Настройки.Получить("ИмяТекущейСтраницы");
	
	Если Не СохраненноеИмяТекущейСтраницы = Неопределено
		И Не СохраненноеИмяТекущейСтраницы = ИмяТекущейСтраницы Тогда
		
		ПоказРасширения = Найти(СохраненноеИмяТекущейСтраницы, "Расширение") > 0;
		ИмяТекущейСтраницы = ?(ПоказРасширения, "СтраницаТоварыРасширение", "СтраницаТовары");
		
		Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы[ИмяТекущейСтраницы];
		
		Настройки.Удалить("ИмяТекущейСтраницы");
		
		Если НЕ ПустаяСтрока(ВидПоискаПриОткрытии) Тогда
			УстановитьНадписьПутиВДереве();
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

