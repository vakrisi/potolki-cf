
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ИспользоватьСумму = Истина;
	Если Параметры.Свойство("ИспользоватьСумму") Тогда
		ИспользоватьСумму = Параметры.ИспользоватьСумму;
	КонецЕсли;
	
	Элементы.НомерКолонкиСумма.Видимость = ИспользоватьСумму;
	Элементы.ТабЗначСумма.Видимость = ИспользоватьСумму;
	
	ИспользоватьКоличество = Истина;
	Если Параметры.Свойство("ИспользоватьКоличество") Тогда
		ИспользоватьКоличество = Параметры.ИспользоватьКоличество;
	КонецЕсли;
	
	Элементы.НомерКолонкиКоличество.Видимость = ИспользоватьКоличество;
	Элементы.ТабЗначКоличество.Видимость  = ИспользоватьКоличество;
	Элементы.ТабЗначКоэффициент.Видимость = ИспользоватьКоличество;
	
	ИспользоватьСтатьи = Истина;
	Если Параметры.Свойство("ИспользоватьСтатьи") Тогда
		ИспользоватьСтатьи = Параметры.ИспользоватьСтатьи;
	КонецЕсли;
	
	МассивЭлементов = Новый Массив;
	МассивЭлементов.Добавить("ТабЗначСтатьяДоходов");
	МассивЭлементов.Добавить("ТабЗначСтатьяРасходов");
	ФинансыСервер.УстановитьВидимостьКолонокСтатейДиРВТабличнойЧасти(ЭтаФорма, МассивЭлементов);
	
	Для каждого ЭлементФормы из МассивЭлементов Цикл
		Элементы[ЭлементФормы].Видимость = Элементы[ЭлементФормы].Видимость И ИспользоватьСтатьи;	
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	НачСтр = 1;
КонецПроцедуры

&НаКлиенте
Процедура ПутьКФайлуНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ДиалогВыбораФайла = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	
	ДиалогВыбораФайла.ПолноеИмяФайла = "";
    ДиалогВыбораФайла.Заголовок = "Выберите файл Excel";
	
	Фильтр =  "Файлы Excel|*.xls;*.xlsx";
	ДиалогВыбораФайла.Фильтр = Фильтр;
	ДиалогВыбораФайла.МножественныйВыбор = Ложь;
    
    Оповещение_ПослеЗакрытияДиалогаВыбораФайла = Новый ОписаниеОповещения("ПутьКФайлуНачалоВыбораЗавершение", ЭтаФорма);
	
	ДиалогВыбораФайла.Показать(Оповещение_ПослеЗакрытияДиалогаВыбораФайла);
	
КонецПроцедуры

&НаКлиенте
Процедура ПутьКФайлуНачалоВыбораЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
    Если Результат = Неопределено Тогда
        Возврат;
    КонецЕсли;
    
    ПутьКФайлу = Результат[0]; // ПолноеИмяФайла
    
КонецПроцедуры

