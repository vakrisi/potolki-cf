&НаКлиенте
Процедура ПослеПомещенияФайлаВоВременноеХранилище(Успешно, АдресВХранилище, ВыбранноеИмяФайла, ДопПараметры) Экспорт
	
	Если Не Успешно Тогда
		Возврат;
	КонецЕсли;
	
	ПрочитатьФайлExcel(АдресВХранилище);
	
	ПоказатьОповещениеПользователя ("Чтение файла завершено");
	
КонецПроцедуры

&НаСервере
Процедура ПрочитатьФайлExcel(АдресВХранилище)
	
	РасширениеФайла = Сред(ПутьКФайлу, СтрНайти(ПутьКФайлу, ".", НаправлениеПоиска.СКонца)+1);
	ПутьКФайлуНаСервере = ПолучитьИмяВременногоФайла(РасширениеФайла);
	
	ДвоичныеДанныеФайла = ПолучитьИзВременногоХранилища(АдресВХранилище);
	ДвоичныеДанныеФайла.Записать(ПутьКФайлуНаСервере);
	
	ТабДокИзФайла = новый ТабличныйДокумент;
	
	УстановитьПривилегированныйРежим(Истина);
	Попытка
		ТабДокИзФайла.Прочитать(ПутьКФайлуНаСервере, СпособЧтенияЗначенийТабличногоДокумента.Значение);
	Исключение
		Сообщить("Не удалось прочитать файл Excel: " + ОписаниеОшибки());
		Возврат;
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);
	
	НачальнаяСтрока = ?(НачСтр = 0, 1, НачСтр);
	КоличествоСтрок = ТабДокИзФайла.ПолучитьРазмерОбластиДанныхПоВертикали();
	
	Для Строка = НачальнаяСтрока По КоличествоСтрок Цикл
		Попытка
			ЗагружаемоеНаименование = ?(НомерКолонкиНаименование = 0, 	"", ЗначениеИзОбласти(ТабДокИзФайла, Строка, НомерКолонкиНаименование));
			ЗагружаемыйАртикул 		= ?(НомерКолонкиАртикул = 0, 		"", ЗначениеИзОбласти(ТабДокИзФайла, Строка, НомерКолонкиАртикул));
			ЗагружаемыйКод 			= ?(НомерКолонкиКод = 0, 			"", ЗначениеИзОбласти(ТабДокИзФайла, Строка, НомерКолонкиКод));
			ЗагружаемыйШтрихкод 	= ?(НомерКолонкиШтрихкод = 0, 		"", ЗначениеИзОбласти(ТабДокИзФайла, Строка, НомерКолонкиШтрихкод));
			
			Если ПустаяСтрока(ЗагружаемоеНаименование) И ПустаяСтрока(ЗагружаемыйАртикул)
				И ПустаяСтрока(ЗагружаемыйКод) И ПустаяСтрока(ЗагружаемыйШтрихкод) Тогда
				Продолжить;
			КонецЕсли;
			 
			Стр = ТабЗнач.Добавить();
			Стр.Наименование = ЗагружаемоеНаименование;
			Стр.ЗагружаемыйАртикул = ЗагружаемыйАртикул;
			Стр.ЗагружаемыйКод = ЗагружаемыйКод;
			Стр.ЗагружаемыйШтрихкод = ЗагружаемыйШтрихкод;
			
			Стр.Характеристика = ?(НомерКолонкиХарактеристика = 0, 	"", ЗначениеИзОбласти(ТабДокИзФайла, Строка, НомерКолонкиХарактеристика));
			
			Стр.ЗагружаемаяЕдиницаИзмерения = ?(НомерКолонкиЕдИзм = 0, 	"", ЗначениеИзОбласти(ТабДокИзФайла, Строка, НомерКолонкиЕдИзм));
			
			Стр.Количество = ?(НомерКолонкиКоличество = 0, 1, ЗначениеИзОбласти(ТабДокИзФайла, Строка, НомерКолонкиКоличество));
			Стр.Цена = ?(НомерКолонкиЦена = 0, 0, ЗначениеИзОбласти(ТабДокИзФайла, Строка, НомерКолонкиЦена));
			Стр.Сумма = ?(НомерКолонкиСумма = 0, 0, ЗначениеИзОбласти(ТабДокИзФайла, Строка, НомерКолонкиСумма));
			
			Если Стр.Цена = 0 И Стр.Сумма > 0 И Стр.Количество <> 0 Тогда
				Стр.Цена = Стр.Сумма / Стр.Количество;
			КонецЕсли;
			Если Стр.Цена > 0 И Стр.Сумма = 0 И Стр.Количество <> 0 И ИспользоватьСумму Тогда
				Стр.Сумма = Стр.Цена * Стр.Количество;
			КонецЕсли;

		Исключение
			Сообщить("Ошибка чтения строки файла: " + Строка + Символы.ПС + ОписаниеОшибки(), СтатусСообщения.Внимание);
		КонецПопытки;
	КонецЦикла;
	
	ОпределитьНоменклатуру();
	
КонецПроцедуры

&НаСервере
Функция ЗначениеИзОбласти(ТабДокИзФайла, НомерСтроки, НомерКолонки)
	
	Возврат СокрЛП(ТабДокИзФайла.Область("R" + Формат(НомерСтроки, "ЧГ=") +"C" + Формат(НомерКолонки, "ЧГ=")).Текст);
	
КонецФункции
//-- №1426
	
&НаСервере
Процедура ОпределитьНоменклатуру()
	
	Для Каждого ТекущаяСтрока Из ТабЗнач Цикл
		Если ТекущаяСтрока.Номенклатура.Пустая() И НЕ ПустаяСтрока(ТекущаяСтрока.ЗагружаемыйАртикул) Тогда
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
			|	Номенклатура.Ссылка КАК Ссылка
			|ИЗ
			|	Справочник.Номенклатура КАК Номенклатура
			|ГДЕ
			|	НЕ Номенклатура.ЭтоГруппа
			|	И Номенклатура.Артикул = &Артикул";
			Запрос.УстановитьПараметр("Артикул",ТекущаяСтрока.ЗагружаемыйАртикул);
			Выборка = Запрос.Выполнить().Выбрать();
			Если Выборка.Следующий() Тогда
				ТекущаяСтрока.Номенклатура = Выборка.Ссылка;
			КонецЕсли;	
		КонецЕсли;
		
		Если ТекущаяСтрока.Номенклатура.Пустая() И НЕ ПустаяСтрока(ТекущаяСтрока.ЗагружаемыйКод) Тогда
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
			|	Номенклатура.Ссылка КАК Ссылка
			|ИЗ
			|	Справочник.Номенклатура КАК Номенклатура
			|ГДЕ
			|	НЕ Номенклатура.ЭтоГруппа
			|	И Номенклатура.Код = &Код";
			Запрос.УстановитьПараметр("Код", ТекущаяСтрока.ЗагружаемыйКод);
			Выборка = Запрос.Выполнить().Выбрать();
			Если Выборка.Следующий() Тогда
				ТекущаяСтрока.Номенклатура = Выборка.Ссылка;
			КонецЕсли;	
		КонецЕсли;
		
		Если ТекущаяСтрока.Номенклатура.Пустая() И НЕ ПустаяСтрока(ТекущаяСтрока.ЗагружаемыйШтрихкод) Тогда
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
			|	ШтрихкодыНоменклатуры.Номенклатура КАК Ссылка,
			|	ШтрихкодыНоменклатуры.Характеристика КАК Характеристика,
			|	ШтрихкодыНоменклатуры.ЕдиницаИзмерения КАК ЕдиницаИзмерения
			|ИЗ
			|	РегистрСведений.ШтрихкодыНоменклатуры КАК ШтрихкодыНоменклатуры
			|ГДЕ
			|	ШтрихкодыНоменклатуры.Штрихкод = &Штрихкод";
			Запрос.УстановитьПараметр("Штрихкод", ТекущаяСтрока.ЗагружаемыйШтрихкод);
			Выборка = Запрос.Выполнить().Выбрать();
			Если Выборка.Следующий() Тогда
				ТекущаяСтрока.Номенклатура = Выборка.Ссылка;
				ТекущаяСтрока.ХарактеристикаНоменклатуры = Выборка.Характеристика;
				ТекущаяСтрока.ЕдиницаИзмерения = Выборка.ЕдиницаИзмерения;
			КонецЕсли;	
		КонецЕсли;
		
		Если ТекущаяСтрока.Номенклатура.Пустая() И НЕ ПустаяСтрока(ТекущаяСтрока.Наименование) Тогда
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
			|	Номенклатура.Ссылка КАК Ссылка
			|ИЗ
			|	Справочник.Номенклатура КАК Номенклатура
			|ГДЕ
			|	НЕ Номенклатура.ЭтоГруппа
			|	И Номенклатура.Наименование = &Наименование";
			Запрос.УстановитьПараметр("Наименование", ТекущаяСтрока.Наименование);
			Выборка = Запрос.Выполнить().Выбрать();
			Если Выборка.Следующий() Тогда
				ТекущаяСтрока.Номенклатура = Выборка.Ссылка;
			КонецЕсли;	
		КонецЕсли;
		
		Если ТекущаяСтрока.Номенклатура.Пустая() Тогда
			Сообщить("По данным для поиска в строке " + (ТабЗнач.Индекс(ТекущаяСтрока)+1) + " совпадений не найдено.");
			Продолжить;
		КонецЕсли;
		
		ТекущаяСтрока.Отметка = Истина;
		
		// Нужно найти характеристику при наличии
		Если НЕ ПустаяСтрока(ТекущаяСтрока.Характеристика) И ТекущаяСтрока.ХарактеристикаНоменклатуры.Пустая() Тогда
			ТекущаяСтрока.ХарактеристикаНоменклатуры = Справочники.ХарактеристикиНоменклатуры.НайтиПоНаименованию(ТекущаяСтрока.Характеристика, Истина,, ТекущаяСтрока.Номенклатура);
		КонецЕсли;
		
		ЕдиницаИзмерения = Справочники.КлассификаторЕдиницИзмерения.ПустаяСсылка();
		Коэффициент = 1;
		Если НЕ ПустаяСтрока(ТекущаяСтрока.ЗагружаемаяЕдиницаИзмерения) И НЕ ЗначениеЗаполнено(ТекущаяСтрока.ЕдиницаИзмерения) Тогда			
			ЕдиницаИзмерения = Справочники.КлассификаторЕдиницИзмерения.НайтиПоНаименованию(ТекущаяСтрока.ЗагружаемаяЕдиницаИзмерения, Истина);			
			Если ЕдиницаИзмерения.Пустая() Тогда
				ЕдиницаИзмерения = Справочники.ЕдиницыИзмерений.НайтиПоНаименованию(ТекущаяСтрока.ЗагружаемаяЕдиницаИзмерения, Истина,, ТекущаяСтрока.Номенклатура);
				Если НЕ ЕдиницаИзмерения.Пустая() Тогда
					Коэффициент = ЕдиницаИзмерения.Коэффициент;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		Если ЕдиницаИзмерения.Пустая() Тогда
			ЕдиницаИзмерения = ТекущаяСтрока.Номенклатура.БазоваяЕдиницаИзмерения;	
		КонецЕсли;
		ТекущаяСтрока.ЕдиницаИзмерения = ЕдиницаИзмерения;
		ТекущаяСтрока.Коэффициент = Коэффициент;
		
		СтруктураДанные = Новый Структура;
		СтруктураДанные.Вставить("Номенклатура", ТекущаяСтрока.Номенклатура);
		СтруктураДанные = ОбщийМодульВызовСервера.ПолучитьДанныеНоменклатурыПриИзменении(СтруктураДанные);	
		ЗаполнитьЗначенияСвойств(ТекущаяСтрока, СтруктураДанные, "СтатьяДоходов, СтатьяРасходов");
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтметитьВсе(Команда)
	Для Каждого ТекущаяСтрока Из ТабЗнач Цикл
		Если НЕ ТекущаяСтрока.Номенклатура.Пустая() Тогда
			ТекущаяСтрока.Отметка = Истина;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура СнятьВсе(Команда)
	Для Каждого ТекущаяСтрока Из ТабЗнач Цикл
		ТекущаяСтрока.Отметка = Ложь;		
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ТабЗначНоменклатураПриИзменении(Элемент)
	
	СтрокаТабличнойЧасти = Элементы.ТабЗнач.ТекущиеДанные;
	СтруктураДанные = Новый Структура;
	СтруктураДанные.Вставить("Номенклатура", СтрокаТабличнойЧасти.Номенклатура);
	СтруктураДанные = ОбработкаТабличныхЧастейКлиент.ПолучитьДанныеНоменклатурыПриИзменении(СтруктураДанные);
	
	ЗаполнитьЗначенияСвойств(СтрокаТабличнойЧасти, СтруктураДанные, "ЕдиницаИзмерения, Коэффициент, СтатьяДоходов, СтатьяРасходов");
	
КонецПроцедуры

&НаКлиенте
Процедура ТабЗначКоличествоПриИзменении(Элемент)
	
	Если ИспользоватьСумму Тогда
		ТекущаяСтрока = Элементы.ТабЗнач.ТекущиеДанные;
		ОбработкаТабличныхЧастейКлиент.ПересчитатьСуммуСУчетомСкидокВСтрокеТЧ(ТекущаяСтрока, Ложь, Ложь, Ложь);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТабЗначЕдиницаИзмеренияПриИзменении(Элемент)
	ТекущаяСтрока = Элементы.ТабЗнач.ТекущиеДанные;
	Если ТипЗнч(ТекущаяСтрока.ЕдиницаИзмерения) = Тип("СправочникСсылка.КлассификаторЕдиницИзмерения") Тогда
		ТекущаяСтрока.Коэффициент = 1;
	Иначе
		ТекущаяСтрока.Коэффициент = ОбщийМодуль.ПолучитьКоэффициентЕдиницыИзмерения(ТекущаяСтрока.ЕдиницаИзмерения);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ТабЗначЕдиницаИзмеренияНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	ТекущаяСтрока = Элементы.ТабЗнач.ТекущиеДанные;
	СписокЕдиниц = ОбщийМодуль.ПолучитьСписокЕдиницИзмеренияНоменклатуры(ТекущаяСтрока.Номенклатура);
	
	ДанныеВыбора = Новый СписокЗначений;
	Для Ном = 0 По СписокЕдиниц.Количество() - 1 Цикл
		ДанныеВыбора.Добавить(СписокЕдиниц[Ном]);
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ТабЗначЕдиницаИзмеренияОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	ТекущаяСтрока = Элементы.ТабЗнач.ТекущиеДанные;
	Если ТипЗнч(ВыбранноеЗначение) = Тип("СправочникСсылка.КлассификаторЕдиницИзмерения") Тогда
		ТекущаяСтрока.Коэффициент = 1;
	Иначе
		ТекущаяСтрока.Коэффициент = ОбщийМодуль.ПолучитьКоэффициентЕдиницыИзмерения(ВыбранноеЗначение);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ТабЗначЦенаПриИзменении(Элемент)
	
	Если ИспользоватьСумму Тогда
		ТекущаяСтрока = Элементы.ТабЗнач.ТекущиеДанные;
		ОбработкаТабличныхЧастейКлиент.ПересчитатьСуммуСУчетомСкидокВСтрокеТЧ(ТекущаяСтрока, Ложь, Ложь, Ложь);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТабЗначСуммаПриИзменении(Элемент)
	ТекущаяСтрока = Элементы.ТабЗнач.ТекущиеДанные;
	Если НЕ ТекущаяСтрока.Количество = 0 Тогда
		ТекущаяСтрока.Цена = ТекущаяСтрока.Сумма / ТекущаяСтрока.Количество;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПеренестиТовары(Команда)
	
	Перем СтруктураВыбора;
	
	Для Каждого ТекущаяСтрока Из ТабЗнач Цикл
		Если ТекущаяСтрока.Отметка И ТекущаяСтрока.Номенклатура.Пустая() Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("По данным для поиска в строке " + (ТабЗнач.Индекс(ТекущаяСтрока)+1) + " совпадений не найдено.");
			Возврат;
		КонецЕсли;
	КонецЦикла;
	
	Закрыть();
	СтруктураВыбора = Новый Структура();
	СтруктураВыбора.Вставить("АдресТоваровВХранилище", ПоместитьТоварыВХранилище());
	ОповеститьОВыборе(СтруктураВыбора);			
	
КонецПроцедуры

&НаСервере
Функция ПоместитьТоварыВХранилище()
	
	ТоварыДляПереноса = ТабЗнач.Выгрузить(, "Номенклатура, ХарактеристикаНоменклатуры, Количество, ЕдиницаИзмерения, Коэффициент, Цена, Сумма, СтатьяДоходов, СтатьяРасходов");
	ТоварыДляПереноса.Очистить();
	
	Для Каждого ПодобранныйТовар Из ТабЗнач Цикл
		Если НЕ ПодобранныйТовар.Отметка Тогда
			Продолжить;
		КонецЕсли;
		
		Если ИспользоватьСумму Тогда
			ОбработкаТабличныхЧастейКлиентСервер.ПересчитатьСуммуСУчетомСкидокВСтрокеТЧ(ПодобранныйТовар, Ложь, Ложь, Ложь);
		КонецЕсли;
		
		НоваяСтрока = ТоварыДляПереноса.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ПодобранныйТовар);
	КонецЦикла;			
	
	Возврат ПоместитьВоВременноеХранилище(ТоварыДляПереноса);
	
КонецФункции

