#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Элементы.ГруппаПоказатели.Видимость = ПараметрыСеанса.ТекущийПользователь.ДоступенМониторПульсБизнесаРозница;
	
	Если НЕ ПараметрыСеанса.ТекущийПользователь.ДоступенМониторПульсБизнесаРозница Тогда
		ЭтаФорма.АвтоЗаголовок = Ложь;
		ЭтаФорма.Заголовок = "";
	КонецЕсли;
	
	Элементы.ЗапуститьОтчет.Видимость = ПравоДоступа("Просмотр", Метаданные.Отчеты.ПульсБизнесаРозница);
	
	НастройкаМонитора = ПараметрыСеанса.ТекущийПользователь.ИспользуемаяНастройкаМонитораПульсРозницы;
	Если НастройкаМонитора.Пустая() Тогда
		НастройкаМонитора = Справочники.УДАЛИТЬ_НастройкиМонитораПульсРозницы.НастройкаПоУмолчанию;
	КонецЕсли;
			
	//Для Сч = 1 По 8 Цикл
	//	Элементы["ГруппаВыручка"+Сч].Видимость = Ложь;
	//КонецЦикла;	
	
	ОбновитьОтчет();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Обновить(Команда)
	ОбновитьОтчет();
КонецПроцедуры

&НаСервере
Процедура ОбновитьОтчет()
	
	ТДата = НачалоДня(ТекущаяДатаСеанса() - 6*86400);
	
	СписокКассДляВыручки = Новый СписокЗначений;
	Для каждого СтрокаКассы из НастройкаМонитора.КассыДляОтбораВВыручку Цикл
		СписокКассДляВыручки.Добавить(СтрокаКассы.Касса);
	КонецЦикла;	
	ИспользоватьОтборПоКассам = СписокКассДляВыручки.Количество() > 0;

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("НачалоПериода", ТДата);
	Запрос.УстановитьПараметр("КонецПериода", КонецДня(ТекущаяДатаСеанса()));
	Запрос.УстановитьПараметр("СписокКассДляВыручки", СписокКассДляВыручки);
	Запрос.УстановитьПараметр("ИспользоватьОтборПоКассам", ИспользоватьОтборПоКассам);
	
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	НАЧАЛОПЕРИОДА(Лид.Дата, ДЕНЬ) КАК Дата,
	|	КОЛИЧЕСТВО(1) КАК Статус
	|ИЗ
	|	Документ.Лид КАК Лид
	|ГДЕ
	|	Лид.Проведен
	|	И Лид.Дата >= &НачалоПериода
	|
	|СГРУППИРОВАТЬ ПО
	|	НАЧАЛОПЕРИОДА(Лид.Дата, ДЕНЬ)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	НАЧАЛОПЕРИОДА(Лид.Дата, ДЕНЬ) КАК Дата,
	|	КОЛИЧЕСТВО(1) КАК Статус
	|ИЗ
	|	Документ.Лид КАК Лид
	|ГДЕ
	|	Лид.Проведен
	|	И Лид.Дата >= &НачалоПериода
	|	И Лид.ТекущийСтатус = ЗНАЧЕНИЕ(Справочник.СтатусыЛида.Отказ)
	|
	|СГРУППИРОВАТЬ ПО
	|	НАЧАЛОПЕРИОДА(Лид.Дата, ДЕНЬ)
	|;		
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	НАЧАЛОПЕРИОДА(Лид.Дата, ДЕНЬ) КАК Дата,
	|	КОЛИЧЕСТВО(1) КАК Статус
	|ИЗ
	|	Документ.Лид КАК Лид
	|ГДЕ
	|	Лид.Проведен
	|	И Лид.Дата >= &НачалоПериода
	|	И Лид.ТекущийСтатус = ЗНАЧЕНИЕ(Справочник.СтатусыЛида.НеЦелевой)
	|
	|СГРУППИРОВАТЬ ПО
	|	НАЧАЛОПЕРИОДА(Лид.Дата, ДЕНЬ)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	НАЧАЛОПЕРИОДА(Лид.Дата, ДЕНЬ) КАК Дата,
	|	КОЛИЧЕСТВО(1) КАК Статус
	|ИЗ
	|	Документ.Лид КАК Лид
	|ГДЕ
	|	Лид.Проведен
	|	И Лид.Дата >= &НачалоПериода
	|	И НЕ Лид.ТекущийСтатус = ЗНАЧЕНИЕ(Справочник.СтатусыЛида.НеЦелевой)
	|
	|СГРУППИРОВАТЬ ПО
	|	НАЧАЛОПЕРИОДА(Лид.Дата, ДЕНЬ)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ				
	|	КОЛИЧЕСТВО	(1) КАК КоличествоЗамеров,
	|	НАЧАЛОПЕРИОДА(Замеры.Дата, ДЕНЬ) КАК Дата
	|ИЗ
	|	РегистрСведений.Замеры КАК Замеры
	|ГДЕ
	|	Замеры.Дата >= &НачалоПериода
	|	И Замеры.Дата <= &КонецПериода
	|	И НЕ Замеры.ЭтоВыезд
	|
	|СГРУППИРОВАТЬ ПО
	|	НАЧАЛОПЕРИОДА(Замеры.Дата, ДЕНЬ)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ				
	|	КОЛИЧЕСТВО	(1) КАК КоличествоЗамеров,
	|	НАЧАЛОПЕРИОДА(Замеры.ДатаНазначенияЗамера, ДЕНЬ) КАК Дата
	|ИЗ
	|	РегистрСведений.Замеры КАК Замеры
	|ГДЕ
	|	НАЧАЛОПЕРИОДА(Замеры.ДатаНазначенияЗамера, ДЕНЬ) >= &НачалоПериода
	|	И НАЧАЛОПЕРИОДА(Замеры.ДатаНазначенияЗамера, ДЕНЬ) <= &КонецПериода
	|	И НЕ Замеры.ЭтоВыезд
	|
	|СГРУППИРОВАТЬ ПО
	|	НАЧАЛОПЕРИОДА(Замеры.ДатаНазначенияЗамера, ДЕНЬ)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	НАЧАЛОПЕРИОДА(ЗаказДоговоры.Дата, ДЕНЬ) КАК Дата,
	|	СУММА(ЗаказДоговоры.СуммаДокумента) КАК СуммаДоговоров,
	|	КОЛИЧЕСТВО(1) КАК КоличествоДоговоров
	|ИЗ
	|	Документ.ЗаказДоговор КАК ЗаказДоговоры
	|ГДЕ
	|	ЗаказДоговоры.Дата >= &НачалоПериода
	|	И ЗаказДоговоры.Дата <= &КонецПериода
	|	И ЗаказДоговоры.Проведен
	|
	|СГРУППИРОВАТЬ ПО
	|	НАЧАЛОПЕРИОДА(ЗаказДоговоры.Дата, ДЕНЬ)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	НАЧАЛОПЕРИОДА(ДенежныеСредства.Период, ДЕНЬ) КАК Дата,
	|	СУММА(ДенежныеСредства.СуммаПриход) КАК Выручка
	|ИЗ
	|	РегистрНакопления.ДенежныеСредства.Обороты(
	|			&НачалоПериода,
	|			&КонецПериода,
	|			Регистратор,
	|			ВЫБОР
	|				КОГДА &ИспользоватьОтборПоКассам
	|					ТОГДА СчетКасса В (&СписокКассДляВыручки)
	|				ИНАЧЕ ИСТИНА
	|			КОНЕЦ) КАК ДенежныеСредства
	|
	|ГДЕ
	|   НЕ ДенежныеСредства.Регистратор ССЫЛКА Документ.ВнутреннееПеремещениеДенежныхСредств
	|
	|СГРУППИРОВАТЬ ПО
	|	НАЧАЛОПЕРИОДА(ДенежныеСредства.Период, ДЕНЬ)
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	НАЧАЛОПЕРИОДА(Монтажи.Дата, ДЕНЬ) КАК Дата,
	|	КОЛИЧЕСТВО	(1) КАК КоличествоМонтажей
	|ИЗ
	|	РегистрСведений.Монтажи КАК Монтажи
	|ГДЕ
	|	Монтажи.Дата >= &НачалоПериода
	|	И Монтажи.Дата <= &КонецПериода		
	|   И Монтажи.Монтаж.ВидМонтажа = Значение(Справочник.ВидыМонтажа.Монтаж)
	|
	|СГРУППИРОВАТЬ ПО
	|	НАЧАЛОПЕРИОДА(Монтажи.Дата, ДЕНЬ)
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	НАЧАЛОПЕРИОДА(Монтажи.Дата, ДЕНЬ) КАК Дата,
	|	КОЛИЧЕСТВО	(1) КАК Количество
	|ИЗ
	|	РегистрСведений.Монтажи КАК Монтажи
	|ГДЕ
	|	Монтажи.Дата >= &НачалоПериода
	|	И Монтажи.Дата <= &КонецПериода
	|	И Монтажи.Монтаж.ВидМонтажа = Значение(Справочник.ВидыМонтажа.СервиснаяЗаявка)
	|СГРУППИРОВАТЬ ПО
	|	НАЧАЛОПЕРИОДА(Монтажи.Дата, ДЕНЬ)	
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	НАЧАЛОПЕРИОДА(Монтажи.Дата, ДЕНЬ) КАК Дата,
	|	КОЛИЧЕСТВО	(1) КАК Количество
	|ИЗ
	|	РегистрСведений.Монтажи КАК Монтажи
	|ГДЕ
	|	Монтажи.Дата >= &НачалоПериода
	|	И Монтажи.Дата <= &КонецПериода
	|	И Монтажи.Монтаж.ВидМонтажа = Значение(Справочник.ВидыМонтажа.Рекламация)
	|СГРУППИРОВАТЬ ПО
	|	НАЧАЛОПЕРИОДА(Монтажи.Дата, ДЕНЬ)
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ				
	|	КОЛИЧЕСТВО	(1) КАК КоличествоЗамеров,
	|	НАЧАЛОПЕРИОДА(Замеры.Дата, ДЕНЬ) КАК Дата
	|ИЗ
	|	РегистрСведений.Замеры КАК Замеры
	|ГДЕ
	|	Замеры.Дата >= &НачалоПериода
	|	И Замеры.Дата <= &КонецПериода		
	|	И Замеры.ЗамерВыполнен
	|	И НЕ Замеры.ЭтоВыезд
	|
	|СГРУППИРОВАТЬ ПО
	|	НАЧАЛОПЕРИОДА(Замеры.Дата, ДЕНЬ)
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ				
	|	КОЛИЧЕСТВО	(1) КАК КоличествоЗамеров,
	|	НАЧАЛОПЕРИОДА(Замеры.Дата, ДЕНЬ) КАК Дата
	|ИЗ
	|	РегистрСведений.Замеры КАК Замеры
	|ГДЕ
	|	Замеры.Дата >= &НачалоПериода
	|	И Замеры.Дата <= &КонецПериода		
	|	И Замеры.Результат = Значение(Справочник.РезультатЗамераЛида.ЗамерОтменен)
	|	И НЕ Замеры.ЭтоВыезд
	|
	|СГРУППИРОВАТЬ ПО
	|	НАЧАЛОПЕРИОДА(Замеры.Дата, ДЕНЬ)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	//|	НАЧАЛОПЕРИОДА(Монтажи.Дата, ДЕНЬ) КАК Дата,
	//|	НАЧАЛОПЕРИОДА(Монтажи.Монтаж.Дата, ДЕНЬ) КАК Дата,
	|	НАЧАЛОПЕРИОДА(Монтажи.Монтаж.ДатаВыполнения, ДЕНЬ) КАК Дата,
	|	СУММА(Монтажи.СуммаДокумента) КАК СуммаМонтажей
	|ИЗ
	|	РегистрСведений.Монтажи КАК Монтажи
	|ГДЕ
	//++ #12853
	//|	Монтажи.Дата >= &НачалоПериода
	//|	И Монтажи.Дата <= &КонецПериода
	
	//#12853 монтажи в отчеты должны попадать не по дате документа, а по дате выполнения
	//|	Монтажи.Монтаж.Дата МЕЖДУ &НачалоПериода И &КонецПериода
	|	Монтажи.Монтаж.ДатаВыполнения МЕЖДУ &НачалоПериода И &КонецПериода
	//-- #12853
	|	И Монтажи.Монтаж.ВидМонтажа = Значение(Справочник.ВидыМонтажа.Монтаж)
	|	И Монтажи.ИндексСтроки <= 1
	//++ #12853
	//|	И ВЫБОР 
	//|			КОГДА Монтажи.Монтаж.СозданПриИспользованииСтатусаЗакрыт
	//|				ТОГДА Монтажи.Монтаж.Результат = ЗНАЧЕНИЕ(Справочник.РезультатыМонтажа.Закрыт)
	//|			ИНАЧЕ Монтажи.Монтаж.Результат = ЗНАЧЕНИЕ(Справочник.РезультатыМонтажа.Выполнен)
	//|		КОНЕЦ
	|	И Монтажи.Монтаж.Результат В (ЗНАЧЕНИЕ(Справочник.РезультатыМонтажа.Выполнен), ЗНАЧЕНИЕ(Справочник.РезультатыМонтажа.Закрыт))
	//-- #12853
	|
	|СГРУППИРОВАТЬ ПО
	//|	НАЧАЛОПЕРИОДА(Монтажи.Дата, ДЕНЬ)
	//|	НАЧАЛОПЕРИОДА(Монтажи.Монтаж.Дата, ДЕНЬ)
	|	НАЧАЛОПЕРИОДА(Монтажи.Монтаж.ДатаВыполнения, ДЕНЬ)
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	НАЧАЛОПЕРИОДА(Монтажи.Дата, ДЕНЬ) КАК Дата,
	|	СУММА(Монтажи.СуммаДокумента) КАК СуммаЗаявок
	|ИЗ
	|	РегистрСведений.Монтажи КАК Монтажи
	|ГДЕ
	|	Монтажи.Дата >= &НачалоПериода
	|	И Монтажи.Дата <= &КонецПериода
	|	И Монтажи.Монтаж.ВидМонтажа = Значение(Справочник.ВидыМонтажа.СервиснаяЗаявка)
	|	И Монтажи.ИндексСтроки <= 1 
	|
	|СГРУППИРОВАТЬ ПО
	|	НАЧАЛОПЕРИОДА(Монтажи.Дата, ДЕНЬ)
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ				
	|	КОЛИЧЕСТВО	(1) КАК КоличествоЗамеров,
	|	НАЧАЛОПЕРИОДА(Замеры.Дата, ДЕНЬ) КАК Дата
	|ИЗ
	|	РегистрСведений.Замеры КАК Замеры
	|ГДЕ
	|	Замеры.Дата >= &НачалоПериода
	|	И Замеры.Дата <= &КонецПериода		
	|	И Замеры.Результат = Значение(Справочник.РезультатЗамераЛида.ПустаяСсылка)
	|	И НЕ Замеры.ЭтоВыезд
	|
	|СГРУППИРОВАТЬ ПО
	|	НАЧАЛОПЕРИОДА(Замеры.Дата, ДЕНЬ)
	|;
	|";
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	ТЗНовые = РезультатЗапроса[0].Выгрузить();
	ТЗОтказ = РезультатЗапроса[1].Выгрузить();
	ТЗНецелевые = РезультатЗапроса[2].Выгрузить();
	ТЗЦелевые = РезультатЗапроса[3].Выгрузить();
	ТЗЗамеры = РезультатЗапроса[4].Выгрузить();
	ТЗЗамерыВЭтотДень = РезультатЗапроса[5].Выгрузить();
	ТЗДоговоры = РезультатЗапроса[6].Выгрузить();
	ТЗВыручка = РезультатЗапроса[7].Выгрузить();
	ТЗМонтажи = РезультатЗапроса[8].Выгрузить();
	ТЗСервис = РезультатЗапроса[9].Выгрузить();
	ТЗРекламация = РезультатЗапроса[10].Выгрузить();
	ТЗВыполненныеЗамеры = РезультатЗапроса[11].Выгрузить();
	ТЗОтмененныеЗамеры = РезультатЗапроса[12].Выгрузить();
	ТЗСуммаМонтажей = РезультатЗапроса[13].Выгрузить();
	ТЗСуммаСервисныхЗаявок = РезультатЗапроса[14].Выгрузить();
	ТЗЗамерыВРаботе = РезультатЗапроса[15].Выгрузить();
	
	Для Сч = 1 По 7 Цикл
		
		СоответствиеДат.Добавить(ТДата);
		
		// дни и дни недели
		Элементы["ГруппаПоказателиДень"+Сч].Заголовок = Формат(ТДата, "ДФ='дд ММММ'");
		Элементы["ДекорацияЗначениеДень"+Сч].Заголовок = Формат(ТДата, "ДФ=дддд");
		
		// новые лиды
		НайденныеСтроки = ТЗНовые.НайтиСтроки(Новый Структура("Дата", ТДата)); 
		НовыеЛиды = ?(НайденныеСтроки.Количество() > 0, НайденныеСтроки[0].Статус, 0);
		Элементы["ДекорацияЗначениеНовыеЛиды"+Сч].Заголовок = НовыеЛиды;
		
		// отказ - лиды
		НайденныеСтроки = ТЗОтказ.НайтиСтроки(Новый Структура("Дата", ТДата)); 
		ОтказЛиды = ?(НайденныеСтроки.Количество() > 0, НайденныеСтроки[0].Статус, 0);
		Элементы["ДекорацияЗначениеОтказы"+Сч].Заголовок = ОтказЛиды;
		
		// не целевой - лиды
		НайденныеСтроки = ТЗНецелевые.НайтиСтроки(Новый Структура("Дата", ТДата)); 
		НецелевыеЛиды = ?(НайденныеСтроки.Количество() > 0, НайденныеСтроки[0].Статус, 0);
		Элементы["ДекорацияЗначениеНецелевые"+Сч].Заголовок = НецелевыеЛиды;
		
		// целевой - лиды
		НайденныеСтроки = ТЗЦелевые.НайтиСтроки(Новый Структура("Дата", ТДата)); 
		ЦелевыеЛиды = ?(НайденныеСтроки.Количество() > 0, НайденныеСтроки[0].Статус, 0);
		Элементы["ДекорацияЗначениеЦелевые"+Сч].Заголовок = ЦелевыеЛиды;
		
		// созданные замеры (назначенные в этот же день)
		НайденныеСтроки = ТЗЗамерыВЭтотДень.НайтиСтроки(Новый Структура("Дата", ТДата)); 
		ЗамерыВЭтотДень = ?(НайденныеСтроки.Количество() > 0, НайденныеСтроки[0].КоличествоЗамеров, 0);
		Элементы["ДекорацияЗначениеЗамерыВЭтотДень"+Сч].Заголовок = ЗамерыВЭтотДень;
		
		// замеры
		НайденныеСтроки = ТЗЗамеры.НайтиСтроки(Новый Структура("Дата", ТДата)); 
		Замеры = ?(НайденныеСтроки.Количество() > 0, НайденныеСтроки[0].КоличествоЗамеров, 0);
		Элементы["ДекорацияЗначениеЗамеры"+Сч].Заголовок = Замеры;
		
		// выполненные замеры
		НайденныеСтроки = ТЗВыполненныеЗамеры.НайтиСтроки(Новый Структура("Дата", ТДата)); 
		ВыполненныеЗамеры = ?(НайденныеСтроки.Количество() > 0, НайденныеСтроки[0].КоличествоЗамеров, 0);
		Элементы["ДекорацияЗначениеЗамерыВыполнены"+Сч].Заголовок = ВыполненныеЗамеры;
		
		// замеры в работе
		НайденныеСтроки = ТЗЗамерыВРаботе.НайтиСтроки(Новый Структура("Дата", ТДата)); 
		ЗамерыВРаботе = ?(НайденныеСтроки.Количество() > 0, НайденныеСтроки[0].КоличествоЗамеров, 0);
		Элементы["ДекорацияЗначениеЗамерыВРаботе"+Сч].Заголовок = ЗамерыВРаботе;
		
		// отмененные замеры
		НайденныеСтроки = ТЗОтмененныеЗамеры.НайтиСтроки(Новый Структура("Дата", ТДата)); 
		ОтмененныеЗамеры = ?(НайденныеСтроки.Количество() > 0, НайденныеСтроки[0].КоличествоЗамеров, 0);
		Элементы["ДекорацияЗначениеЗамерыОтменены"+Сч].Заголовок = ОтмененныеЗамеры;
		
		// договоры
		НайденныеСтроки = ТЗДоговоры.НайтиСтроки(Новый Структура("Дата", ТДата)); 
		Договоры = ?(НайденныеСтроки.Количество() > 0, НайденныеСтроки[0].КоличествоДоговоров, 0);
		ДоговорыСумма = ?(НайденныеСтроки.Количество() > 0, НайденныеСтроки[0].СуммаДоговоров, 0);
		Элементы["ДекорацияЗначениеДоговоры"+Сч].Заголовок = Договоры;
		Элементы["ДекорацияЗначениеДоговорыСумма"+Сч].Заголовок = Формат(ДоговорыСумма, "ЧДЦ=2; ЧРГ=; ЧН=0");
		
		// выручка
		НайденныеСтроки = ТЗВыручка.НайтиСтроки(Новый Структура("Дата", ТДата)); 
		Выручка = ?(НайденныеСтроки.Количество() > 0, НайденныеСтроки[0].Выручка, 0);
		Элементы["ДекорацияЗначениеВыручка"+Сч].Заголовок = Формат(Выручка, "ЧДЦ=2; ЧРГ=; ЧН=0");
		
		// монтажи
		НайденныеСтроки = ТЗМонтажи.НайтиСтроки(Новый Структура("Дата", ТДата)); 
		КоличествоМонтажей = ?(НайденныеСтроки.Количество() > 0, НайденныеСтроки[0].КоличествоМонтажей, 0);
		Элементы["ДекорацияЗначениеМонтажи"+Сч].Заголовок = КоличествоМонтажей;
		
		// Монтаж Сервис
		НайденныеСтроки = ТЗСервис.НайтиСтроки(Новый Структура("Дата", ТДата)); 
		КоличествоСервис = ?(НайденныеСтроки.Количество() > 0, НайденныеСтроки[0].Количество, 0);
		Элементы["ДекорацияЗначениеСервис"+Сч].Заголовок = КоличествоСервис;
		
		// Монтаж Рекламация
		НайденныеСтроки = ТЗРекламация.НайтиСтроки(Новый Структура("Дата", ТДата)); 
		КоличествоРекламаций = ?(НайденныеСтроки.Количество() > 0, НайденныеСтроки[0].Количество, 0);
		Элементы["ДекорацияЗначениеРекламация"+Сч].Заголовок = КоличествоРекламаций;
		
		// Сумма монтажей
		НайденныеСтроки = ТЗСуммаМонтажей.НайтиСтроки(Новый Структура("Дата", ТДата)); 
		СуммаМонтажей = ?(НайденныеСтроки.Количество() > 0, НайденныеСтроки[0].СуммаМонтажей, 0);
		Элементы["ДекорацияЗначениеСуммаМонтажей"+Сч].Заголовок = СуммаМонтажей;

		// Сумма сервисных заявок
		НайденныеСтроки = ТЗСуммаСервисныхЗаявок.НайтиСтроки(Новый Структура("Дата", ТДата)); 
		СуммаЗаявок = ?(НайденныеСтроки.Количество() > 0, НайденныеСтроки[0].СуммаЗаявок, 0);
		Элементы["ДекорацияЗначениеСуммаСервисныхЗаявок"+Сч].Заголовок = СуммаЗаявок;
		
		ТДата = ТДата + 86400;
		
	КонецЦикла;
	
КонецПроцедуры

