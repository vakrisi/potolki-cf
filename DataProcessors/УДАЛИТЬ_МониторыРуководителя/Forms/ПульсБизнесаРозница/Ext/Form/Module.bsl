&НаКлиенте
Процедура ДекорацияЗначениеНажатие(Элемент)
	
	// пример: Элемент.Имя = ДекорацияЗначениеСервис6
	ИмяЭлемента = СтрЗаменить(Элемент.Имя, "ДекорацияЗначение", "");
	НомерКолонки = Число(Прав(ИмяЭлемента, 1));
	Показатель = Лев(ИмяЭлемента, СтрДлина(ИмяЭлемента) - 1);
	
	ИмяВариантаОтчета = "Отчет.ПульсБизнесаРозница.ПоРегистратору";	
	ВариантОтчета = ВариантОтчетаПоПолномуИмени(ИмяВариантаОтчета);
	Если ВариантОтчета=Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СоответствиеПоказателей = НОвый Соответствие;
	СоответствиеПоказателей.Вставить("НовыеЛиды", 		1);
	СоответствиеПоказателей.Вставить("Нецелевые", 		2);
	СоответствиеПоказателей.Вставить("Целевые", 		3);
	СоответствиеПоказателей.Вставить("Отказы", 			4);
	СоответствиеПоказателей.Вставить("ЗамерыВЭтотДень", 5);
	СоответствиеПоказателей.Вставить("Замеры", 			6);
	СоответствиеПоказателей.Вставить("ЗамерыВыполнены", 7);
	СоответствиеПоказателей.Вставить("ЗамерыВРаботе", 	8);
	СоответствиеПоказателей.Вставить("ЗамерыОтменены", 	9);	
	СоответствиеПоказателей.Вставить("Договоры", 		10);
	СоответствиеПоказателей.Вставить("Монтажи", 		11);
	СоответствиеПоказателей.Вставить("Сервис", 			12);
	СоответствиеПоказателей.Вставить("Рекламация", 		13);
	СоответствиеПоказателей.Вставить("ДоговорыСумма", 	14);
	СоответствиеПоказателей.Вставить("СуммаМонтажей",	15);
	СоответствиеПоказателей.Вставить("СуммаСервисныхЗаявок",	16);
	СоответствиеПоказателей.Вставить("Выручка", 		17);
	
	ПериодРасшифровки = Новый СтандартныйПериод();
	ПериодРасшифровки.ДатаНачала    = СоответствиеДат.Получить(НомерКолонки-1).Значение;
	ПериодРасшифровки.ДатаОкончания = ПериодРасшифровки.ДатаНачала;
	ОтборРасшифровки = Новый Соответствие;	
	ОтборРасшифровки.Вставить("Период", ПериодРасшифровки);
	
	СтруктураЗначения = Новый Структура;
	СтруктураЗначения.Вставить("ВидСравнения", ВидСравненияКомпоновкиДанных.Равно);
	СтруктураЗначения.Вставить("ПравоеЗначение", СоответствиеПоказателей.Получить(Показатель));
	ОтборРасшифровки.Вставить("ПриоритетПоказателя", СтруктураЗначения);
		
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("СформироватьПриОткрытии", Истина); 
	ПараметрыФормы.Вставить("ОтборРасшифровки", ОтборРасшифровки);
	ВариантыОтчетовКлиент.ОткрытьФормуОтчета(ЭтаФорма, ВариантОтчета, ПараметрыФормы);
	
КонецПроцедуры

&НаСервереБезКонтекста
// Возвращает ссылку на вариант отчета.
//
// Параметры:
//  ПолноеИмя - полное имя отчета, включающее имя варианта, отделенное точкой. Пример: Отчеты.Продажи.Основной
//
// Возвращаемое значение:
//  СправочникСсылка.ВариантыОтчетов, Неопределено - вариант отчета, 
//          либо Неопределено, если отчет отсутствует или недоступен по правам.
//
Функция ВариантОтчетаПоПолномуИмени(ПолноеИмя)
	
	Если ПустаяСтрока(ПолноеИмя) Тогда
		Возврат Неопределено;
	КонецЕсли; 
	
	ЧастиИмени = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ПолноеИмя, ".");
	Если ЧастиИмени.Количество()<>3 Тогда
		Возврат Неопределено;
	КонецЕсли; 
	
	Возврат ВариантыОтчетов.ПолучитьСсылку(ОбщегоНазначения.ИдентификаторОбъектаМетаданных(Метаданные.НайтиПоПолномуИмени(ЧастиИмени[0] + "." + ЧастиИмени[1])), ЧастиИмени[2]);
	
КонецФункции

