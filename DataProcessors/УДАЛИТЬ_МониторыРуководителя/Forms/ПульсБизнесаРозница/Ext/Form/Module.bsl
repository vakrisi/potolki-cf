&НаСервереБезКонтекста
Функция ПолучитьСписокЛидовПоЗамерам(ТДата, ЭтотДень, Отбор)
	
	Выполненные = Ложь;
	Отмененные = Ложь;
	Если ТипЗнч(Отбор) = Тип("Структура") Тогда
		Выполненные = Отбор.Свойство("Выполненные");
		Отмененные = Отбор.Свойство("Отмененные");
	КонецЕсли;	
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("НачалоПериода", ТДата);
	Запрос.УстановитьПараметр("КонецПериода", КонецДня(ТДата));	
	Запрос.УстановитьПараметр("ЭтотДень", ЭтотДень);	
	Запрос.УстановитьПараметр("Выполненные", Выполненные);
	Запрос.УстановитьПараметр("Отмененные", Отмененные);
	
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
       |	Замеры.ДокументЗамер КАК ДокументЗамер
       |ИЗ
       |	РегистрСведений.Замеры КАК Замеры
       |ГДЕ
       |	ИСТИНА
       |	И ВЫБОР
       |			КОГДА &ЭтотДень
       |				ТОГДА НАЧАЛОПЕРИОДА(Замеры.ДатаНазначенияЗамера, ДЕНЬ) = &НачалоПериода
       |			ИНАЧЕ Замеры.Дата >= &НачалоПериода
       |					И Замеры.Дата <= &КонецПериода
       |		КОНЕЦ
       |	И ВЫБОР
       |			КОГДА &Выполненные
       |				ТОГДА Замеры.ЗамерВыполнен
       |			ИНАЧЕ ИСТИНА
       |		КОНЕЦ
       |	И ВЫБОР
       |			КОГДА &Отмененные
       |				ТОГДА Замеры.Результат = ЗНАЧЕНИЕ(Справочник.РезультатЗамераЛида.ЗамерОтменен)
       |			ИНАЧЕ ИСТИНА
       |		КОНЕЦ";
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("ДокументЗамер");
	
КонецФункции

