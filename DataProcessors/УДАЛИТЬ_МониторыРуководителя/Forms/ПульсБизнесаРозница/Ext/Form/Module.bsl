&НаКлиенте
Процедура ОткрытьСписокЛидов(День, Статус)
	
	МассивОтборов = новый Массив;
	
	//++ №10969 комментируем, т.к. меняем отбор по отказным и не целевым (сразу получаем ссылки из регистра "История лида")
	//Если Статус = 2 Тогда
	//	МассивОтборов.Добавить(новый Структура("Поле, Значение, ВидСравнения", "ТекущийСтатус", ПредопределенноеЗначение("Справочник.СтатусыЛида.Отказ"), ВидСравненияКомпоновкиДанных.Равно));
	//ИначеЕсли Статус = 3 Тогда
	//	МассивОтборов.Добавить(новый Структура("Поле, Значение, ВидСравнения", "ТекущийСтатус", ПредопределенноеЗначение("Справочник.СтатусыЛида.НеЦелевой"), ВидСравненияКомпоновкиДанных.Равно));	
	//КонецЕсли;
	//-- №10969
	
	ТДата = НачалоДня(ТекущаяДата() - 6*86400);
	ТДата = ТДата + ((День-1) * 86400);
	
	Если Статус = 1 Тогда // №10969 добавлено условие, по дате нужно отбирать только в этом статусе
		
		МассивОтборов.Добавить(новый Структура("Поле, Значение, ВидСравнения", "Дата", ТДата, ВидСравненияКомпоновкиДанных.БольшеИлиРавно));
		МассивОтборов.Добавить(новый Структура("Поле, Значение, ВидСравнения", "Дата", КонецДня(ТДата), ВидСравненияКомпоновкиДанных.МеньшеИлиРавно));
		
	//++ №10969 меняем отбор по отказным и не целевым (сразу получаем ссылки из регистра "История лида")
	Иначе
		ПолучитьСсылкиНаЛидыВСтатусе(Статус, МассивОтборов, ТДата);
	КонецЕсли;
	//-- №10969
	
	ОткрытьФорму("Документ.Лид.ФормаСписка", новый Структура("ФиксированныеНастройки", ЗаполнитьПараметрыОткрытияСписка(МассивОтборов)), ЭтотОбъект, ЭтотОбъект.УникальныйИдентификатор);
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ПолучитьСсылкиНаЛидыВСтатусе(Статус, МассивОтборов, Дата)
	
	ОтборСтатус = ?(Статус = 2, Справочники.СтатусыЛида.Отказ, Справочники.СтатусыЛида.НеЦелевой);
	
	Запрос = новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ИсторияСтатусовЛидов.Лид КАК Лид
	|ИЗ
	|	РегистрСведений.ИсторияСтатусовЛидов КАК ИсторияСтатусовЛидов
	|ГДЕ
	|	ИсторияСтатусовЛидов.Дата МЕЖДУ &НачалоПериода И &КонецПериода
	|	И ИсторияСтатусовЛидов.Статус = &Статус
	|";
	Запрос.УстановитьПараметр("НачалоПериода", Дата);
	Запрос.УстановитьПараметр("КонецПериода", КонецДня(Дата));
	Запрос.УстановитьПараметр("Статус", ОтборСтатус);
	
	МассивОтборов.Добавить(новый Структура("Поле, Значение, ВидСравнения", "Ссылка", Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Лид"), ВидСравненияКомпоновкиДанных.ВСписке));
	
КонецПроцедуры

