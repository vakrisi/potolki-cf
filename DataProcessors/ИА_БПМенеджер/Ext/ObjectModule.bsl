// Работа с точками

Функция   Точки_ПолучитьКэш()
    Запрос = Новый Запрос;
    Запрос.Текст =
    // !!! НЕ ОТКРЫВАТЬ В КОНСТРУКТОРЕ !!!
    "ВЫБРАТЬ  разрешенные *
    |ИЗ
    |   Справочник.ИА_БПТочкиМаршрута КАК ИА_БПТочкиМаршрута
    |ГДЕ
    |   ИА_БПТочкиМаршрута.Владелец = &Владелец
    |   И НЕ ИА_БПТочкиМаршрута.ПометкаУдаления";
    Запрос.УстановитьПараметр("Владелец", КартаМаршрута);
    ТаблицаТочек = Запрос.Выполнить().Выгрузить();
    ТаблицаТочек.Колонки.Добавить("Исходящие");
    ТаблицаТочек.Колонки.Добавить("Входящие");
    Для каждого СтрокаТЗ Из ТаблицаТочек Цикл
        СтрокаТЗ.Входящие   = Справочники.ИА_БПТочкиМаршрута.ПолучитьВходящиеТочки(СтрокаТЗ.Ссылка);
        СтрокаТЗ.Исходящие  = Справочники.ИА_БПТочкиМаршрута.ПолучитьИсходящиеТочки(СтрокаТЗ.Ссылка);
    КонецЦикла; 
КонецФункции

Функция   Точки_ПолучитьПоИмениТочки(ИмяТочки) Экспорт
    М = ТаблицаТочек.НайтиСтроки(Новый Структура("Имя", ИмяТочки));
    Если М.Количество() > 0 Тогда
        Возврат М[0].Ссылка;
    Иначе
        Возврат Справочники.ИА_БПТочкиМаршрута.ПустаяСсылка();
    КонецЕсли; 
КонецФункции

Функция   Точки_ПолучитьИнформацию(Точка) Экспорт
    М = ТаблицаТочек.НайтиСтроки(Новый Структура("Ссылка", Точка));
    Если М.Количество() > 0 Тогда
        Возврат М[0];
    Иначе
        ТЗ = ТаблицаТочек.СкопироватьКолонки();
        Возврат ТЗ.Добавить();
    КонецЕсли; 
КонецФункции

Функция   Точки_Тип(Точка)
    Инфо = Точки_ПолучитьИнформацию(Точка);
    Возврат Инфо.Тип;
КонецФункции

Функция   Точки_Входящие(Точка)
    Инфо = Точки_ПолучитьИнформацию(Точка);
    Возврат Инфо.Входящие;
КонецФункции

Функция   Точки_Исходящие(Точка, Вариант = Неопределено)
    Инфо = Точки_ПолучитьИнформацию(Точка);
    Если Вариант = Неопределено Тогда
        Результат = Инфо.Исходящие;
    Иначе
        Таб = ИА_БФС.ТЗ_ФильтрПоУсловию(Инфо.ИсходящиеЛинии, "СтрокаТЗ.Вариант = Контекст" , Вариант);
        Результат = Таб.ВыгрузитьКолонку("Адрес");
    КонецЕсли;     
    Возврат Результат;
КонецФункции

Функция   Точки_ПолучитьТочкиДействияВверхПоПроцессу(Точка)
    Массив = Новый Массив;
    М = Точки_Входящие(Точка);		
    Для каждого ПредТочка Из М Цикл
        Тип = Точки_Тип(ПредТочка);
        Если Тип = Перечисления.ИА_БПТипыТочекМаршрута.Действие
            ИЛИ Тип = Перечисления.ИА_БПТипыТочекМаршрута.ВложенныйБизнесПроцесс
            Тогда
            Массив.Добавить(ПредТочка);	
        ИначеЕсли Тип = Перечисления.ИА_БПТипыТочекМаршрута.Старт Тогда
            // Ничего!
        ИначеЕсли Тип = Перечисления.ИА_БПТипыТочекМаршрута.Слияние Тогда
            М2 = Точки_ПолучитьТочкиДействияВверхПоПроцессу(ПредТочка);
            Для каждого Эл Из М2 Цикл
                Массив.Добавить(Эл);
            КонецЦикла; 
        ИначеЕсли Тип = Перечисления.ИА_БПТипыТочекМаршрута.Условие Тогда            
            // ИА_ 24.03.2015  условия должны также обрабатываться
            Если ПредТочка.ПрограммнаяОбработка Тогда
                М2 = Точки_ПолучитьТочкиДействияВверхПоПроцессу(ПредТочка);
                Для каждого Эл Из М2 Цикл
                    Массив.Добавить(Эл);
                КонецЦикла; 
            Иначе
                Массив.Добавить(ПредТочка);
            КонецЕсли; 
        ИначеЕсли Тип = Перечисления.ИА_БПТипыТочекМаршрута.Разделение Тогда            
            // ИА_Аврамов 24.03.2015  
            М2 = Точки_ПолучитьТочкиДействияВверхПоПроцессу(ПредТочка);
            Для каждого Эл Из М2 Цикл
                Массив.Добавить(Эл);
            КонецЦикла; 
        Иначе
            ВызватьИсключение "Не реализован поиск для типа " + Тип + " !";
        КонецЕсли;        
    КонецЦикла; 
    Возврат Массив;
КонецФункции

Функция   Точки_НайтиВсехВозможныхПотомков(Точка, ВсеТипы = Ложь) Экспорт
    Результат = Новый Массив;
    
    Точки_НайтиВсехВозможныхПотомковИтератор(Точка, Результат, ВсеТипы);	
    
    ИндексИсходной = Результат.Найти(Точка);
    Если ИндексИсходной <> Неопределено Тогда
        Результат.Удалить(ИндексИсходной);	
    КонецЕсли; 
    
    Возврат Результат;
КонецФункции

Процедура Точки_НайтиВсехВозможныхПотомковИтератор(Точка, МассивРезультат, ВсеТипы)
    
    Инфо = Точки_ПолучитьИнформацию(Точка);
    Если  (ВсеТипы ИЛИ СписокТиповДляЗадач.Найти(Инфо.Тип) <> Неопределено)
        И МассивРезультат.Найти(Точка) = Неопределено
        Тогда
        МассивРезультат.Добавить(Точка);
    ИначеЕсли МассивРезультат.Найти(Точка) <> Неопределено Тогда
        Возврат
    КонецЕсли; 
    
    Для каждого СледТочка Из Инфо.Исходящие Цикл
        Точки_НайтиВсехВозможныхПотомковИтератор(СледТочка, МассивРезультат, ВсеТипы);
    КонецЦикла; 
КонецПроцедуры

Функция   Точки_НайтиВсехВозможныхПредков(Точка, ВсеТипы = Ложь) Экспорт
    Результат = Новый Массив;
    
    Точки_НайтиВсехВозможныхПредковИтератор(Точка, Результат, ВсеТипы);	
    
    ИндексИсходной = Результат.Найти(Точка);
    Если ИндексИсходной <> Неопределено Тогда
        Результат.Удалить(ИндексИсходной);	
    КонецЕсли; 
    
    Возврат Результат;
КонецФункции

Процедура Точки_НайтиВсехВозможныхПредковИтератор(Точка, МассивРезультат, ВсеТипы)
    Инфо = Точки_ПолучитьИнформацию(Точка);
    Если  (ВсеТипы ИЛИ СписокТиповДляЗадач.Найти(Инфо.Тип) <> Неопределено)
        И МассивРезультат.Найти(Точка) = Неопределено
        Тогда
        МассивРезультат.Добавить(Точка);
    ИначеЕсли МассивРезультат.Найти(Точка) <> Неопределено Тогда
        Возврат
    КонецЕсли;
    
    Для каждого Родитель Из Инфо.Входящие Цикл
        Точки_НайтиВсехВозможныхПредковИтератор(Родитель, МассивРезультат, ВсеТипы);
    КонецЦикла; 
КонецПроцедуры

Функция   Точки_ТипыДляЗадач() Экспорт
    Возврат ИА_БФС.КопияОбъекта(СписокТиповДляЗадач);
КонецФункции
 
Функция   Точки_ПолучитьТочкиПроверкиДляСлияния(Точка, СчетчикСлияний = 0, МассивТочекДляВозврата = Неопределено)
    #ЕСЛИ НЕ( Клиент или Сервер или ВнешнееСоединение ) Тогда
        Точка = Справочники.ИА_БПТочкиМаршрута.ПустаяСсылка();
    #КОНЕЦЕСЛИ
    Если МассивТочекДляВозврата = Неопределено Тогда
    	МассивТочекДляВозврата = новый Массив;
    КонецЕсли; 
    
    менТ = Перечисления.ИА_БПТипыТочекМаршрута;
    
    ТочкаИнфо = Точки_ПолучитьИнформацию(Точка);
    МассивВходящихТочек = Точки_Входящие(Точка);
    
    Для каждого ВходящаяТочка Из МассивВходящихТочек Цикл
        ВходящаяТочкаИнфо = Точки_ПолучитьИнформацию(ВходящаяТочка);
        ТипВхТ = ВходящаяТочкаИнфо.Тип;
        
        Если ТипВхТ = менТ.Разделение И СчетчикСлияний = 0 Тогда
        	// Выход из главного блока
            Возврат МассивТочекДляВозврата;
        КонецЕсли; 
        
        Если ТипВхТ = Перечисления.ИА_БПТипыТочекМаршрута.Слияние Тогда
        	СчетчикСлияний = СчетчикСлияний + 1;
        ИначеЕсли ТипВхТ = Перечисления.ИА_БПТипыТочекМаршрута.Разделение Тогда
        	СчетчикСлияний = СчетчикСлияний - 1;
        КонецЕсли; 
        
        Если МассивТочекДляВозврата.Найти(ВходящаяТочка) = Неопределено
            И ( (ТипВхТ = менТ.Действие И НЕ ВходящаяТочкаИнфо.ЭтоУведомление)
            ИЛИ  ТипВхТ = менТ.ВложенныйБизнесПроцесс
            ИЛИ (ТипВхТ = менТ.Условие  И НЕ ВходящаяТочкаИнфо.ПрограммнаяОбработка)
            )
            Тогда
        	МассивТочекДляВозврата.Добавить(ВходящаяТочка);
        КонецЕсли; 
        
        Точки_ПолучитьТочкиПроверкиДляСлияния(ВходящаяТочка, СчетчикСлияний, МассивТочекДляВозврата);
    КонецЦикла; 
    
    Возврат МассивТочекДляВозврата;
КонецФункции
 