Функция   Задачи_ПолучитьИнформацию(СписокТочек = Неопределено, ДополнятьНесуществующими = Ложь, ВключатьИсключенные = Ложь) Экспорт    
    Запрос = Новый Запрос;
    Запрос.Текст = СтрЗаменить(
    "ВЫБРАТЬ РАЗРЕШЕННЫЕ
    |   Т.Ссылка,
    |   Т.ВерсияДанных,
    |   Т.ПометкаУдаления,
    |   Т.Номер,
    |   Т.Дата,
    |   Т.БизнесПроцесс,
    |   Т.ТочкаМаршрута,
    |   Т.Наименование,
    |   Т.Выполнена,
    |   Т.ИА_ТочкаБП,
    |   Т.ИА_ВариантУсловияБП,
    |   Т.ИА_ТочкаБП.Имя КАК ИмяТочкиБП
    |ИЗ
    |   Задача.ИА_БПЗадачаНосителя КАК Т
    |ГДЕ
    |   Т.БизнесПроцесс = &БизнесПроцесс
    |   И НЕ Т.ПометкаУдаления
    |   И Т.ИА_ТочкаБП <> ЗНАЧЕНИЕ(Справочник.ИА_БПТочкиМаршрута.ПустаяСсылка)
    |   И Т.ИА_ТочкаБП.Владелец = &КартаМаршрута
    |   И (&ВключатьИсключенные ИЛИ НЕ Т.ИА_ИсключенаИзОбработки)", "ИА_БПЗадачаНосителя", ЗадачаИмя);
    Если СписокТочек <> Неопределено Тогда
        Запрос.Текст = Запрос.Текст + " И Т.ИА_ТочкаБП В (&СписокТочек)";
        Запрос.УстановитьПараметр("СписокТочек", СписокТочек)
    КонецЕсли; 
    
    Запрос.УстановитьПараметр("БизнесПроцесс", БизнесПроцесс);    
    Запрос.УстановитьПараметр("КартаМаршрута", КартаМаршрута);
	Запрос.УстановитьПараметр("ВключатьИсключенные", ВключатьИсключенные);
    
    ТЗ = Запрос.Выполнить().Выгрузить();
    Если ДополнятьНесуществующими Тогда
        Если СписокТочек = Неопределено Тогда
            СписокТочек = ТаблицаТочек.ВыгрузитьКолонку("Ссылка");
        КонецЕсли; 
        
        Для каждого Точка Из СписокТочек Цикл
            Если ТЗ.Найти(Точка, "ИА_ТочкаБП") = Неопределено Тогда
                НовСтрока = ТЗ.Добавить();
                НовСтрока.ИА_ТочкаБП = Точка;
                НовСтрока.БизнесПроцесс = БизнесПроцесс;
                НовСтрока.Ссылка = Неопределено;
            КонецЕсли; 
        КонецЦикла; 
    КонецЕсли; 
    Возврат ТЗ;
КонецФункции

Процедура Задачи_Выполнить(мЗадача, Отказ) Экспорт
    ПереданОбъект = ИА_БФКС.РеквизитЕсть(мЗадача, "ОбменДанными");
    
    Если ПереданОбъект Тогда
        Задача = мЗадача;
    Иначе
        Задача = мЗадача.ПолучитьОбъект();
    КонецЕсли;
    
    Контекст = Новый Структура("Задача, Отказ", мЗадача, Отказ);
    ИА_БПСПереопределяемый.Задачи_ПриВыполнении(Контекст);
    Если Контекст.Отказ Тогда
    	Отказ = Истина;
        Возврат;
    КонецЕсли; 
    
    
    // Создать "следующие" задачи
    Если Задача.ИА_ТочкаБП.Тип = Перечисления.ИА_БПТипыТочекМаршрута.Условие Тогда
        Вариант = Задача.ИА_ВариантУсловияБП;
    Иначе
        Вариант = Неопределено;
    КонецЕсли; 
    
    Если Задача.ИА_ТочкаБП.ЭтоУведомление Тогда
        М = ПолучитьЗадачиНевыполненные();
        
        Если М.Количество() < 2 Тогда // Это уведомление в практически "завершенном" БП
            БП = БизнесПроцесс.ПолучитьОбъект();
            БП.Завершен = Истина;
            БП.Записать();
        КонецЕсли; 
    Иначе
        ТабЗадачТекущейТочки = Задачи_ПолучитьИнформацию(Задача.ИА_ТочкаБП);
        ИА_БФС.ТЗ_УдалитьСтрокиПоУсловию(ТабЗадачТекущейТочки, "СтрокаТЗ.Выполнена ИЛИ СтрокаТЗ.Ссылка=Контекст", мЗадача.Ссылка);    
        Если ТабЗадачТекущейТочки.Количество() > 0 Тогда
            Сообщение = Новый СообщениеПользователю;
            Сообщение.Текст = "Задача """ + мЗадача + """ не создаст сейчас новых задач, т.к. в точке """
            + мЗадача.ИА_ТочкаБП + """ есть невыполненные задачи (Двойной поток управления)!";
            Сообщение.Сообщить(); 
        Иначе
            Исходящие = Точки_Исходящие(Задача.ИА_ТочкаБП, Вариант);
            Для каждого СледТочка Из Исходящие Цикл
                Задачи_СоздатьПоТочке(СледТочка, мЗадача);
            КонецЦикла;
        КонецЕсли; 
    КонецЕсли; 
КонецПроцедуры

Функция ПолучитьСтруктуруУчетаРазделений(Уровень, ЭтоКонечнаяВетка, ВложенныйУчет = Неопределено)
	Возврат Новый Структура("Уровень, ЭтоКонечнаяВетка, ВложенныйУчет"
    , Уровень, ЭтоКонечнаяВетка, ВложенныйУчет);
КонецФункции
 
// Создает новую задачу (или ветку задач) по переданой точке маршрута
// Параметры:
// Точка - СправочникСсылка.ИА_БПТочкиМаршрута - создать задачу с этой точкой
// ИсключаяемаяЗадача - ЗадачаОбъект.<ОсновнаяЗадача> - задача-объект породившая цепочку создания
Процедура Задачи_СоздатьПоТочке(Точка, ИсключаяемаяЗадача = Неопределено, УчетРазделений = Неопределено) Экспорт
    #ЕСЛИ НЕ( Клиент или Сервер или ВнешнееСоединение ) Тогда
        Точка = Справочники.ИА_БПТочкиМаршрута.ПустаяСсылка();
    #КОНЕЦЕСЛИ
    ТочкаИнфо = Точки_ПолучитьИнформацию(Точка); 
    ТипТочки = ТочкаИнфо.Тип;
    
    Если ИсключаяемаяЗадача = Неопределено Тогда
    	ИсключаяемаяЗадачаСсылка = Задачи[ЗадачаИмя].ПустаяСсылка();
    Иначе
        ИсключаяемаяЗадачаСсылка = ИсключаяемаяЗадача.Ссылка;
    КонецЕсли;
    
    Если УчетРазделений = Неопределено Тогда
    	УчетРазделений = ПолучитьСтруктуруУчетаРазделений(0, Истина);
    КонецЕсли; 
    
    Если ТипТочки = Перечисления.ИА_БПТипыТочекМаршрута.Условие И Точка.ПрограммнаяОбработка Тогда
        // Программная обработка условий
        Если НЕ ЗначениеЗаполнено(ТочкаИнфо.ЛинияДляУсловияИстинно) Тогда
            ТекстСообщения = "В точке """ + Точка + """ по """ + БизнесПроцесс + """ не выбрана линия для условия !";
            ИА_БПС.СообщениеВЖурнал("ОшибкаУсловия", ТекстСообщения);
            ВызватьИсключение ТекстСообщения;
        КонецЕсли; 
        
        Контекст = Новый Структура("БП, Точка, Задача, Результат", БизнесПроцесс, Точка, ИсключаяемаяЗадача, Неопределено);
        Обработчик = ИА_БПС.Обработчики_Получить(Точка, Перечисления.ИА_БПСобытияТочекБП.Условие_ПроверкаУсловия);
        ИА_БПС.Обработчики_Выполнить(Обработчик, Контекст,,"Результат",,Истина);
        
        Если Контекст.Результат = Неопределено Тогда
            ТекстСообщения = "Обработчик в точке """ + Точка + """ по """ + БизнесПроцесс + """ не вернул варианта условия!";
            ИА_БПС.СообщениеВЖурнал("ОшибкаУсловия", ТекстСообщения);
            ВызватьИсключение ТекстСообщения;
        КонецЕсли; 
        
        Если Контекст.Результат Тогда
            Вариант = ТочкаИнфо.ЛинияДляУсловияИстинно;
        Иначе
            Вариант = ТочкаИнфо.ЛинияДляУсловияЛожно;
        КонецЕсли; 
        МассивТочек = Точки_Исходящие(Точка, Вариант);
        Для каждого СледТочка Из МассивТочек Цикл
        	Задачи_СоздатьПоТочке(СледТочка, ИсключаяемаяЗадача, УчетРазделений);
        КонецЦикла; 
    ИначеЕсли СписокТиповДляЗадач.Найти(ТипТочки) <> Неопределено и ТочкаИнфо.ЭтоУведомление Тогда    
        // Для уведомлений мы должны создать задачу, не ожидающую ничего
        Задачи_СоздатьИЗаписать(Точка); // Создадим, даже если уже есть непрочитанные (цикл и т.п.)
                                                                                        
        Массив = Точки_Исходящие(Точка); 
        Для каждого ВложеннаяТочка Из Массив Цикл
            Задачи_СоздатьПоТочке(ВложеннаяТочка, ИсключаяемаяЗадача, УчетРазделений)
        КонецЦикла; 
    ИначеЕсли СписокТиповДляЗадач.Найти(ТипТочки) <> Неопределено
        ИЛИ
        ТипТочки = Перечисления.ИА_БПТипыТочекМаршрута.ВложенныйБизнесПроцесс
        Тогда    
        ЗадачиНовойТочки = Задачи_ПолучитьИнформацию(Точка);
        ИА_БФС.ТЗ_УдалитьСтрокиПоУсловию(ЗадачиНовойТочки
        , "СтрокаТЗ.Выполнена ИЛИ СтрокаТЗ.Ссылка=Контекст"
        , ИсключаяемаяЗадачаСсылка);
        
        Если ЗадачиНовойТочки.Количество() > 0 Тогда
            ИА_БФКС.СообщениеОбОшибке("Задача в точке """ + Точка + """ не будет создана, т.к. в этой точке уже есть невыполненная задача (Двойной поток управления) !");
        Иначе
            Задачи_СоздатьИЗаписать(Точка); // Создать задачу // 26.11.2014 ИА_ Аврамов (1) ToDo: Для "не интерактивных условий" нет	
        КонецЕсли; 
    ИначеЕсли ТипТочки = Перечисления.ИА_БПТипыТочекМаршрута.Разделение Тогда
        Массив = Точки_Исходящие(Точка); 
        
        НовыйУчет = ПолучитьСтруктуруУчетаРазделений(УчетРазделений.Уровень + 1, Ложь, УчетРазделений);
        
        СчетчикВеток = 0;
        Для каждого ВложеннаяТочка Из Массив Цикл
            НовыйУчет.ЭтоКонечнаяВетка = СчетчикВеток = Массив.Количество() - 1;
            Задачи_СоздатьПоТочке(ВложеннаяТочка, ИсключаяемаяЗадача, НовыйУчет);
            СчетчикВеток = СчетчикВеток  + 1;
        КонецЦикла; 
        
    ИначеЕсли ТипТочки = Перечисления.ИА_БПТипыТочекМаршрута.Слияние Тогда
        //{ ИА_Аврамов 25.09.2015
        // БЫЛО:
        ////СписокТочек = Точки_ПолучитьТочкиДействияВверхПоПроцессу(Точка);
        ////ТабПредыдущихЗадач = Задачи_ПолучитьИнформацию(СписокТочек, Истина);
        ////ИА_БФС.ТЗ_УдалитьСтрокиПоУсловию(ТабПредыдущихЗадач
        ////, "СтрокаТЗ.Ссылка <> Неопределено И (СтрокаТЗ.Выполнена ИЛИ СтрокаТЗ.Ссылка=Контекст)"
        ////, ИсключаяемаяЗадача.Ссылка);
        //} 
        
        Если УчетРазделений.ЭтоКонечнаяВетка Тогда
            // Для варианта, когда в одной транзакции создается разветеленное дерево проверяем только конечную ветвь
            СписокТочек = Точки_ПолучитьТочкиПроверкиДляСлияния(Точка);
            ТабПредыдущихЗадач = Задачи_ПолучитьИнформацию(СписокТочек);
            ИА_БФС.ТЗ_УдалитьСтрокиПоУсловию(ТабПредыдущихЗадач
            , "СтрокаТЗ.Ссылка = Неопределено ИЛИ (СтрокаТЗ.Выполнена ИЛИ СтрокаТЗ.Ссылка=Контекст)"
            , ИсключаяемаяЗадача.Ссылка);
            Если ТабПредыдущихЗадач.Количество() = 0 Тогда // Всё выполнено!
                М = Точки_Исходящие(Точка);
                Для каждого СледующаяТочка Из М Цикл
                    Задачи_СоздатьПоТочке(СледующаяТочка, ИсключаяемаяЗадача, УчетРазделений.ВложенныйУчет);
                КонецЦикла; 
            КонецЕсли; 
        КонецЕсли; 
    ИначеЕсли ТипТочки = Перечисления.ИА_БПТипыТочекМаршрута.Завершение Тогда
        ТабПредыдущихЗадач = Задачи_ПолучитьИнформацию();
        Если ИсключаяемаяЗадача <> Неопределено Тогда
            ИА_БФС.ТЗ_УдалитьСтрокиПоУсловию(ТабПредыдущихЗадач
            , "СтрокаТЗ.Выполнена ИЛИ СтрокаТЗ.Ссылка=Контекст ИЛИ СтрокаТЗ.ИА_ТочкаБП.ЭтоУведомление"
            , ИсключаяемаяЗадача.Ссылка);    
        Иначе
            ИА_БФС.ТЗ_УдалитьСтрокиПоУсловию(ТабПредыдущихЗадач
            , "СтрокаТЗ.Выполнена ИЛИ СтрокаТЗ.ИА_ТочкаБП.ЭтоУведомление");    
        КонецЕсли; 
        
        Если ТабПредыдущихЗадач.Количество() = 0 Тогда
            // Можно завершать БП!
            Запрос = Новый Запрос;
            Запрос.Текст = СтрЗаменить(
            "ВЫБРАТЬ  разрешенные
            |   Т.Ссылка
            |ИЗ
            |   Задача.ИА_БПЗадачаНосителя КАК Т
            |ГДЕ
            |   Т.БизнесПроцесс = &БизнесПроцесс
            |   И Т.ИА_ТочкаБП = ЗНАЧЕНИЕ(Перечисление.ИА_БПТипыТочекМаршрута.ПустаяСсылка)
            |   И НЕ Т.Выполнена", "ИА_БПЗадачаНосителя", ЗадачаИмя);
            Запрос.УстановитьПараметр("БизнесПроцесс", БизнесПроцесс);
            Результат = Запрос.Выполнить();
            Выборка = Результат.Выбрать();
            Пока Выборка.Следующий() Цикл
                Задача = Выборка.Ссылка.ПолучитьОбъект();
                Задача.Выполнена = Истина;
                Задача.Записать();
            КонецЦикла;
            
            Если ОбъектБизнесПроцесс <> Неопределено Тогда
            	БП = ОбъектБизнесПроцесс;
            Иначе
                БП = БизнесПроцесс.ПолучитьОбъект();
            КонецЕсли; 
            
            БП.Завершен = Истина;
            БП.Записать();
            
            //{ Вложенные БП
            Если ЗначениеЗаполнено(БП.ВедущаяЗадача) Тогда
            	ВедущаяЗадача = БП.ВедущаяЗадача.ПолучитьОбъект();
                ВедущаяЗадача.ДополнительныеСвойства.Вставить("ИА_ПрограммноеЗавершение", Истина);
                ВедущаяЗадача.ВыполнитьЗадачу();
            КонецЕсли; 
            //}
        КонецЕсли; 
    Иначе
        ВызватьИсключение "Пока не реализовано для типа точек """ + ТипТочки+ """ !!!";
    КонецЕсли; 
КонецПроцедуры

Функция получитьСрокзадачи(инфо)
	ТекСрок = ТекущаяДата();
	
	Запрос = новый запрос;
	запрос.Текст = "ВЫБРАТЬ
	               |	ИА_Календарь.Период КАК Период
	               |ИЗ
	               |	РегистрСведений.ИА_Календарь КАК ИА_Календарь
	               |ГДЕ
	               |	ИА_Календарь.Период > &ТекДата
	               |	И (ИА_Календарь.Рабочий = ИСТИНА
	               |			ИЛИ &БезФильтра)
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Период";
	Запрос.УстановитьПараметр("БезФильтра", инфо.ВариантДлительности = Перечисления.ИА_БПВариантыДней.Календарные);
	Запрос.УстановитьПараметр("ТекДата", ТекСрок);
	Выборка = Запрос.Выполнить().Выбрать();
	
	НужноДобавить = инфо.ДлительностьВыполнения;
	Пока выборка.Следующий() и НужноДобавить>0 цикл
		ТекСрок = выборка.Период;
		НужноДобавить = НужноДобавить - 1;
	КонецЦикла;
	возврат ТекСрок;
КонецФункции

Функция   Задачи_СоздатьИЗаписать(Точка, Выполнена = Ложь) Экспорт
	#ЕСЛИ НЕ( Клиент или Сервер или ВнешнееСоединение ) Тогда
	    Точка = Справочники.ИА_БПТочкиМаршрута.ПустаяСсылка();
	#КОНЕЦЕСЛИ
	 
    Задача = МенеджерЗадач.СоздатьЗадачу();
    
    Точка_Инфо = Точки_ПолучитьИнформацию(Точка);
    
    Задача.Дата 			= ТекущаяДата(); 
    Задача.БизнесПроцесс 	= БизнесПроцесс;
    Задача.ИА_ТочкаБП 		= Точка;
    Задача.Наименование 	= Точка_Инфо.Наименование;
    Задача.Выполнена 		= Выполнена;
	
	Если Точка_Инфо.ДлительностьВыполнения > 0 и не Точка_Инфо.ВариантДлительности.пустая() тогда
		Задача.СрокИсполнения = получитьСрокзадачи(Точка_Инфо);
	КонецЕсли;
    
    //{ Очистим реквизиты по точке
    РеквизитыДляОчистки = ИА_БФС.ТЗ_ФильтрПоОтбору(Точка_Инфо.ВыводимыеРеквизиты
    , Новый Структура("ОчищатьПриСозданииЗадачи", Истина)).ВыгрузитьКолонку("Реквизит");
    Если РеквизитыДляОчистки.Количество() > 0 Тогда
        Если ОбъектБизнесПроцесс = Неопределено Тогда
            БПОбъект = БизнесПроцесс.ПолучитьОбъект();
        Иначе
        	БПОбъект = ОбъектБизнесПроцесс;
        КонецЕсли; 
    	
        Для каждого Стр Из БПОбъект.ИА_Реквизиты Цикл
        	Если РеквизитыДляОчистки.Найти(Стр.Реквизит) <> Неопределено Тогда
            	Стр.Значение  = Стр.Реквизит.ТипЗначения.ПривестиЗначение(Неопределено);
            КонецЕсли; 
        КонецЦикла;  
        Если ОбъектБизнесПроцесс = Неопределено Тогда
            БПОбъект.Записать();
        КонецЕсли;
    КонецЕсли; 
    //} 
	
	Задачи_ЗаполнитьАдресацию(Задача);
	
	Контекст = Новый Структура("Задача, Выполнена", Задача, Выполнена);
	ИА_БПСПереопределяемый.Задачи_ПередЗаписьюНовой(Контекст);
    
    
    Контекст = ИА_БПС.СформироватьКонтекстВыполненияДляЗадачи(Задача);
    Контекст.Вставить("Результат", Задача.Наименование);
    
    //{ Обработчики формирования наименования    
    Обработчик          = ИА_БПС.Обработчики_Получить(Точка, Перечисления.ИА_БПСобытияТочекБП.ФормированиеНаименования);
    ИА_БПС.Обработчики_Выполнить(Обработчик, Контекст,,"Результат");
    Задача.Наименование = Контекст.Результат;
    //}
    
    //{ Обработчики формирования содержания
    Если ИА_БФКС.РеквизитЕсть(Задача, "Содержание") Тогда
        Задача.Содержание   = Точка.Описание;
        Контекст.Вставить("Результат", Задача.Содержание);
        Обработчик          = ИА_БПС.Обработчики_Получить(Точка, Перечисления.ИА_БПСобытияТочекБП.ФормированиеСодержания);
        ИА_БПС.Обработчики_Выполнить(Обработчик, Контекст,,"Результат");
        Задача.Содержание   = Контекст.Результат;
    КонецЕсли; 
    //}
    
    
    
    
    
    //{ Обработка "влож. БП"
    Если Точка_Инфо.Тип = Перечисления.ИА_БПТипыТочекМаршрута.ВложенныйБизнесПроцесс Тогда
        ИмяПоля = ИА_БПС.ПолучитьИмяРеквизитаАдресацииИсполнителя();
        ОтветственныйДляВложенногоБП = Задача[ИмяПоля];
        Задача[ИмяПоля] = Неопределено;
        Задача.Записать();
        
    	// Требуется запуск БП
        
        МаршрутВложБП = Точка_Инфо.МаршрутЗадачВложенногоБП;
        Если НЕ ЗначениеЗаполнено(МаршрутВложБП) Тогда
        	ВызватьИсключение ИА_БФКС.Стр_ПодставитьПараметрыВСтроку(
            "В точке ""%1"" не указан ""%2"" для запуска бизнес-процесса! БП: %3"
            ,Точка_Инфо.Ссылка, Метаданные.Справочники.ИА_БПМаршрутЗадач.ПредставлениеОбъекта, БизнесПроцесс);
        КонецЕсли; 
        
        //{ Подготовим таблицу реквизитов
        ТабРеквизитов = Точка_Инфо.РеквизитыВложенногоБП.Скопировать();
        Если ТабРеквизитов.Количество() > 0 Тогда
            КонтекстРеквизита = Неопределено;
            Для каждого Стр Из ТабРеквизитов Цикл
                Если Стр.СпособЗаполнения = Перечисления.ИА_БПСпособыЗаполненияДопРеквизитов.Перенести Тогда
                    Опции = Стр.ХранилищеДанных.Получить();
                    Если Опции = Неопределено Тогда
                        ИА_БФКС.СообщениеОбОшибке(ИА_БФКС.Стр_ПодставитьПараметрыВСтроку(
                        "Реквизит ""%1"" не заполнен, т.к. нет формулы в точке ""%2"" у БП %3"
                        ,Стр.Реквизит, Точка, БизнесПроцесс) ); 
                    Иначе
                        Если КонтекстРеквизита = Неопределено Тогда
                            КонтекстРеквизита = ИА_БПС.СформироватьКонтекстВыполненияДляЗадачи(Задача);
                        КонецЕсли; 
                        Данные = ИА_БФС.РедакторФормул_Выполнить(Опции, КонтекстРеквизита);
                        Стр.Значение = Данные.Результат;
                    КонецЕсли; 
                КонецЕсли; 
            КонецЦикла; 
        КонецЕсли; 
        //}
        БизнесПроцессы.ИА_БПНоситель.СоздатьБП(Истина, МаршрутВложБП, ТекущаяДата()
        , Задача.Ссылка, ОтветственныйДляВложенногоБП, Задача.Ссылка, ТабРеквизитов);
    Иначе
        Задача.Записать();
    КонецЕсли; 
    //}
    
    Контекст = Новый Структура("Задача, Выполнена", Задача, Выполнена);
	ИА_БПСПереопределяемый.Задачи_ПослеЗаписиНовой(Контекст);
КонецФункции

Процедура Задачи_ЗаполнитьАдресацию(Задача)
	Точка = Задача.ИА_ТочкаБП;
	#ЕСЛИ НЕ( Клиент или Сервер или ВнешнееСоединение ) Тогда
	    Точка = Справочники.ИА_БПТочкиМаршрута.ПустаяСсылка();
	#КОНЕЦЕСЛИ
	
	ИмяПоля = ИА_БПС.ПолучитьИмяРеквизитаАдресацииИсполнителя();
	
	Задача[ИмяПоля] = Неопределено;
	Если ЗначениеЗаполнено(Точка.Ответственный) Тогда
		Если ТипЗнч(Точка.Ответственный) = Тип("СправочникСсылка.Пользователи") Тогда
			Задача[ИмяПоля] = Точка.Ответственный;
		ИначеЕсли ТипЗнч(Точка.Ответственный) = Тип("ПеречислениеСсылка.ИА_БПТипыАдресацииЗадач") Тогда
			Если Точка.Ответственный = Перечисления.ИА_БПТипыАдресацииЗадач.ОтветственныйЗаБП Тогда
				Задача[ИмяПоля]	= Задача.БизнесПроцесс.ИА_Ответственный;
			КонецЕсли; 
		КонецЕсли; 
    КонецЕсли; 
    
    Если НЕ ЗначениеЗаполнено(Задача[ИмяПоля]) Тогда
        Задача[ИмяПоля]	= Задача.БизнесПроцесс.ИА_Ответственный;
    КонецЕсли;
	
	Контекст = Новый Структура("Задача", Задача);
	ИА_БПСПереопределяемый.Задачи_ЗаполнитьАдресацию(Контекст);
    
    //{ Обработчик "УстановкаОтветственного"
    Контекст = ИА_БПС.СформироватьКонтекстВыполненияДляЗадачи(Задача);
    Контекст.Вставить("Результат", Задача[ИмяПоля]);
    Обработчик          = ИА_БПС.Обработчики_Получить(Точка, Перечисления.ИА_БПСобытияТочекБП.УстановкаОтветственного);
    ИА_БПС.Обработчики_Выполнить(Обработчик, Контекст,,"Результат");
    ЕстьОргСхема = Метаданные.Справочники.Найти("ОргСхема") <> Неопределено;
    Если ЕстьОргСхема И ТипЗнч(Контекст.Результат) = Тип("СправочникСсылка.ОргСхема") Тогда
        Задача[ИмяПоля] = Неопределено;
        Задача["Пост"]  = Контекст.Результат;
    Иначе	
        Задача[ИмяПоля] = Контекст.Результат;
    КонецЕсли; 
    //}
    
    Если ЕстьОргСхема Тогда
        Если  НЕ ЗначениеЗаполнено(Задача[ИмяПоля])
            И НЕ ЗначениеЗаполнено(Задача["Пост"])
            Тогда
        	ВызватьИсключение "Не удалось заполнить адресацию у " + Задача + ". Д.б. заполнен ""Пользователь"" или ""Пост"" !";
        КонецЕсли; 
    КонецЕсли;
    
КонецПроцедуры
 
Функция   Задачи_ПолучитьЗадачиПоИмениТочки(ИмяТочки, ВключатьИсключенные = Ложь) Экспорт
    Точка = Точки_ПолучитьПоИмениТочки(ИмяТочки);
    М = Новый Массив;
    М.Добавить(Точка);
    Результат = Задачи_ПолучитьИнформацию(М, ,ВключатьИсключенные);
    Возврат Результат;
КонецФункции

