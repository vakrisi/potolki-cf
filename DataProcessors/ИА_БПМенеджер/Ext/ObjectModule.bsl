Перем СписокТиповДляЗадач;
Перем РежимНовойКарты;
Перем ОбъектБизнесПроцесс;
//_____________________________________________________________
// ИНТЕРФЕЙС

Процедура Инициализировать(БП, КартаМаршрутаНовая = Неопределено, БизнесПроцессОбъект = Неопределено) Экспорт
    БизнесПроцесс = БП;
    Если КартаМаршрутаНовая = Неопределено Тогда
        КартаМаршрута      = БизнесПроцесс.ИА_КартаМаршрутаБП;
        РежимНовойКарты    = Ложь;
    Иначе
        КартаМаршрута      = КартаМаршрутаНовая;
        РежимНовойКарты    = Истина;
    КонецЕсли; 
    
    ОбъектБизнесПроцесс = БизнесПроцессОбъект;
    
    МенеджерЗадач = Задачи[БизнесПроцесс.Метаданные().Задача.Имя];
    ЗадачаИмя = МенеджерЗадач.ПустаяСсылка().Метаданные().Имя;
    
    менТипы = Перечисления.ИА_БПТипыТочекМаршрута;
    СписокТиповДляЗадач = Новый Массив;
    СписокТиповДляЗадач.Добавить(менТипы.Действие);
    СписокТиповДляЗадач.Добавить(менТипы.Условие);
    СписокТиповДляЗадач.Добавить(менТипы.ВложенныйБизнесПроцесс);
    
    Точки_ПолучитьКэш();
КонецПроцедуры

Функция   ПолучитьЗадачиВсе() Экспорт
    ТЗ = Задачи_ПолучитьИнформацию();
    Результат = ТЗ.ВыгрузитьКолонку("Ссылка");
    Возврат Результат;
КонецФункции

Функция   ПолучитьЗадачиНевыполненные() Экспорт
    ТЗ = Задачи_ПолучитьИнформацию();
    ИА_БФС.ТЗ_УдалитьСтрокиПоУсловию(ТЗ, "СтрокаТЗ.Выполнена");
    Результат = ТЗ.ВыгрузитьКолонку("Ссылка");
    Возврат Результат;
КонецФункции

Функция   ПолучитьЗадачиВыполненные() Экспорт
    ТЗ = Задачи_ПолучитьИнформацию();
    ИА_БФС.ТЗ_УдалитьСтрокиПоУсловию(ТЗ, "НЕ СтрокаТЗ.Выполнена");
    Результат = ТЗ.ВыгрузитьКолонку("Ссылка");
    Возврат Результат;
КонецФункции

Функция   ПолучитьКартуМаршрута() Экспорт
    Карта = Справочники.ИА_БПКартыМаршрутов.ПолучитьКартуМаршрута(КартаМаршрута);    
    Если Карта = Неопределено Тогда
        Возврат Новый ГрафическаяСхема;
    КонецЕсли; 
    ТабЗадачи = Задачи_ПолучитьИнформацию();
    Состояния = Перечисления.ИА_БПСостояниеТочекМаршрутаНаКарте;
    
    Для каждого Эл Из Карта.ЭлементыГрафическойСхемы Цикл
        КраситьВыполненые = Истина;
        Если ТипЗнч(Эл) = Тип("ЭлементГрафическойСхемыУсловие") Тогда
            КраситьВыполненые = Ложь;
        КонецЕсли; 
        М = ТабЗадачи.НайтиСтроки(Новый Структура("ИмяТочкиБП", Эл.Имя));
        ЕстьВыполненные = Ложь;
        ЕстьНеВыполненные = Ложь;
        Для каждого СтрокаТЗ Из М Цикл
            ТочкаИнфо = Точки_ПолучитьИнформацию(СтрокаТЗ.ИА_ТочкаБП);
            
            Если СтрокаТЗ.Выполнена Тогда
                ЕстьВыполненные = Истина
            ИначеЕсли Не СтрокаТЗ.Выполнена Тогда
                ЕстьНеВыполненные = Истина
            КонецЕсли; 
        КонецЦикла;
        
        Если ЕстьНеВыполненные Тогда
            ГрафСхема_Отметить(Эл, ?(ТочкаИнфо.ЭтоУведомление, Состояния.НеВыполненаУведомление, Состояния.НеВыполнена));
        ИначеЕсли ЕстьВыполненные и КраситьВыполненые Тогда
            ГрафСхема_Отметить(Эл, ?(ТочкаИнфо.ЭтоУведомление, Состояния.ВыполненаУведомление, Состояния.Выполнена));
        КонецЕсли; 
    КонецЦикла; 
    
    Возврат Карта;
КонецФункции

//_____________________________________________________________

Процедура ГрафСхема_Отметить(Элемент, Состояние, КартаПустая = Неопределено) Экспорт
    Состояния = Перечисления.ИА_БПСостояниеТочекМаршрутаНаКарте;
    
    ЭлементДоИзменений = ?(КартаПустая = Неопределено, Элемент, КартаПустая.ЭлементыГрафическойСхемы.Найти(Элемент.Имя));
    
    ЗаполнитьЗначенияСвойств(Элемент, ЭлементДоИзменений, "ЦветФона, ЦветРамки");
    
    Если Состояние = Состояния.НеСоздана Тогда
        // Ничего !
    ИначеЕсли Состояние = Состояния.НеВыполнена Тогда
        Элемент.ЦветРамки = WebЦвета.Красный;
    ИначеЕсли Состояние = Состояния.Выполнена Тогда
        Элемент.ЦветФона  = WebЦвета.ЗеленаяЛужайка;
        
    ИначеЕсли Состояние = Состояния.ВыполненаУведомление Тогда
        Элемент.ЦветФона  = WebЦвета.ЛимонноЗеленый;
    ИначеЕсли Состояние = Состояния.НеВыполненаУведомление Тогда
        Элемент.ЦветРамки = WebЦвета.СинийСоСтальнымОттенком;
    КонецЕсли; 
КонецПроцедуры


