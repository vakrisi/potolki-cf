// Работа с БП

Процедура БП_Старт(Отказ) Экспорт
    Если БизнесПроцесс.Стартован Тогда
        ВызватьИсключение "Уже стартован " + БизнесПроцесс + " !";
    КонецЕсли;
    
    ТабОбязательныхРеквизитов = ИА_БФС.Запрос_ВыполнитьВТЗ(
    "ВЫБРАТЬ разрешенные
    |   ИА_БПНосительИА_Реквизиты.Реквизит,
    |   ИА_БПНосительИА_Реквизиты.Значение
    |ПОМЕСТИТЬ Таб
    |ИЗ
    |   БизнесПроцесс.ИА_БПНоситель.ИА_Реквизиты КАК ИА_БПНосительИА_Реквизиты
    |ГДЕ
    |   ИА_БПНосительИА_Реквизиты.Реквизит.Обязательный
    |   И ИА_БПНосительИА_Реквизиты.Ссылка = &Ссылка
    |;
    |
    |////////////////////////////////////////////////////////////////////////////////
    |ВЫБРАТЬ  разрешенные
    |   ИА_БПРеквизиты.Ссылка КАК Реквизит
    |ПОМЕСТИТЬ РеквизитыИзКарты
    |ИЗ
    |   ПланВидовХарактеристик.ИА_БПРеквизиты КАК ИА_БПРеквизиты
    |ГДЕ
    |   ИА_БПРеквизиты.ВладелецРеквизита = &МаршрутЗадач
    |   И ИА_БПРеквизиты.Обязательный
    |   И НЕ ИА_БПРеквизиты.ЭтоГруппа
    |   И НЕ ИА_БПРеквизиты.Ссылка В
    |               (ВЫБРАТЬ
    |                   Таб.Реквизит
    |               ИЗ
    |                   Таб КАК Таб)
    |;
    |
    |////////////////////////////////////////////////////////////////////////////////
    |ВЫБРАТЬ
    |   Таб.Реквизит,
    |   Таб.Значение
    |ИЗ
    |   Таб КАК Таб
    |
    |ОБЪЕДИНИТЬ ВСЕ
    |
    |ВЫБРАТЬ
    |   РеквизитыИзКарты.Реквизит,
    |   0
    |ИЗ
    |   РеквизитыИзКарты КАК РеквизитыИзКарты"
    , Новый Структура("Ссылка, МаршрутЗадач", БизнесПроцесс, БизнесПроцесс.ИА_МаршрутЗадачБП));
    
    ТекстСообщения = "";
    Для каждого Стр Из ТабОбязательныхРеквизитов Цикл
        Стр.Значение = Стр.Реквизит.ТипЗначения.ПривестиЗначение(Стр.Значение); // 2015/10/13
    	Если НЕ ЗначениеЗаполнено(Стр.Значение) Тогда
        	ТекстСообщения = ТекстСообщения + Символы.ПС + " — не заполнен """ + Стр.Реквизит+ """ !";
        КонецЕсли; 
    КонецЦикла; 
    
    Если ЗначениеЗаполнено(ТекстСообщения) Тогда
    	ТекстСообщения = "Невозможно стартовать бизнес-процесс, т.к. есть незаполненные реквизиты: " + ТекстСообщения;
        ИА_БФКС.СообщениеОбОшибке(ТекстСообщения, Отказ); 
        Возврат;
    КонецЕсли; 
    
    ТочкаСтарта = Справочники.ИА_БПКартыМаршрутов.ПолучитьТочкуСтарта(КартаМаршрута);
    М = Справочники.ИА_БПТочкиМаршрута.ПолучитьИсходящиеТочки(ТочкаСтарта);
    
    Для каждого Точка Из М Цикл
        Задачи_СоздатьПоТочке(Точка);	
    КонецЦикла; 
КонецПроцедуры

Функция   БП_ПолучитьДействияДляПерехода(СписокТочек, КартаМаршрутаНовая = Неопределено) Экспорт
    СписокТочек = ИА_БФКС.Массив_ПолучитьУникальныеЭлементы(СписокТочек);
    Если КартаМаршрутаНовая = Неопределено Тогда
        КартаМаршрутаНовая = КартаМаршрута;
    КонецЕсли;
    
    МассивТочекЗавершение = ИА_БФКС.Массив_ФильтрПоУсловию(СписокТочек
    , "Эл.Тип = Контекст", Перечисления.ИА_БПТипыТочекМаршрута.Завершение);
    РежимЗавершения = МассивТочекЗавершение.Количество() > 0;
    
    ПереходНаНовуюКарту = КартаМаршрута <> КартаМаршрутаНовая;
    
    ОбрБП = Обработки.ИА_БПМенеджер.Создать();
    ОбрБП.Инициализировать(ЭтотОбъект.БизнесПроцесс, КартаМаршрутаНовая);
    
    ТабВыполняемыеДействия  = ИА_БФС.ТЗ_НоваяТаблицаЗначений("Точка, Задача, Действие");
    ТабРекомендации         = ИА_БФС.ТЗ_НоваяТаблицаЗначений("Рекомендация, Точка1, Точка2");
    
    Действия = Перечисления.ИА_БПДействияНадЗадачами;
    
    ТабЗадачиТекущие = Задачи_ПолучитьИнформацию(, Истина);
    ТабЗадачиТекущие.Колонки.Ссылка.Имя     = "Задача";
    ТабЗадачиТекущие.Колонки.ИА_ТочкаБП.Имя = "Точка";
    
    Если РежимЗавершения Тогда
        НовСтрока = ТабВыполняемыеДействия.Добавить();
        НовСтрока.Точка= МассивТочекЗавершение[0];
        НовСтрока.Действие = Действия.ЗаписатьВыполненной;
        
        Для каждого СтрокаТЗ Из ТабЗадачиТекущие Цикл
            Если ЗначениеЗаполнено(СтрокаТЗ.Задача) И НЕ СтрокаТЗ.Выполнена Тогда
                НовСтрока = ТабВыполняемыеДействия.Добавить();
                ЗаполнитьЗначенияСвойств(НовСтрока, СтрокаТЗ);
                НовСтрока.Действие = Действия.Удалить;
            КонецЕсли;
        КонецЦикла;
    ИначеЕсли ПереходНаНовуюКарту Тогда
        // Т.к. мы переходим на другую карту -> Завершить все задачи
        Для каждого СтрокаТЗ Из ТабЗадачиТекущие Цикл
            Если ЗначениеЗаполнено(СтрокаТЗ.Задача) И НЕ СтрокаТЗ.Выполнена Тогда
                НовСтрока = ТабВыполняемыеДействия.Добавить();
                ЗаполнитьЗначенияСвойств(НовСтрока, СтрокаТЗ);
                НовСтрока.Действие = Действия.Удалить;
            КонецЕсли;
        КонецЦикла;
        // и создать новые
        Для каждого Точка Из СписокТочек Цикл
            НовСтрока = ТабВыполняемыеДействия.Добавить();
            НовСтрока.Точка = Точка;
            НовСтрока.Действие = Действия.СоздатьНевыполненной;
        КонецЦикла; 
    Иначе
        М = ТабЗадачиТекущие.НайтиСтроки(Новый Структура("Выполнена", Ложь));
        Для каждого СтрокаТЗ Из М Цикл
        	Если СписокТочек.Найти(СтрокаТЗ.Точка) = Неопределено Тогда
                НовСтрока = ТабВыполняемыеДействия.Добавить();
                ЗаполнитьЗначенияСвойств(НовСтрока, СтрокаТЗ);
                НовСтрока.Действие = Действия.Удалить;
            КонецЕсли; 
        КонецЦикла; 
        
        Для каждого Точка Из СписокТочек Цикл
            // Пометим на удаление невыполненных "предков"
            Предки = Точки_НайтиВсехВозможныхПредков(Точка);
            ЗадачиПредкиНеВыполненные = ИА_БФС.ТЗ_ФильтрПоУсловию(ТабЗадачиТекущие
            , "ЗначениеЗаполнено(СтрокаТЗ.Задача) И Контекст.Найти(СтрокаТЗ.Точка) <> Неопределено И НЕ СтрокаТЗ.Выполнена"
            , Предки);
            Для каждого СтрокаТЗ Из ЗадачиПредкиНеВыполненные Цикл
                НовСтрока = ТабВыполняемыеДействия.Добавить();
                ЗаполнитьЗначенияСвойств(НовСтрока, СтрокаТЗ);
                НовСтрока.Действие = Действия.ЗаписатьВыполненной;
            КонецЦикла; 
            
            М = ТабЗадачиТекущие.НайтиСтроки(Новый Структура("Точка", Точка));            
            
            //{ Проверим, что есть сейчас по этой точке
            ЕстьВыполненные = Ложь;
            ЕстьНеВыполненные = Ложь;
            Для каждого СтрокаЗадач Из М Цикл
                Если ЗначениеЗаполнено(СтрокаЗадач.Задача) Тогда
                    ЕстьВыполненные   = ЕстьВыполненные   ИЛИ    СтрокаЗадач.Выполнена;
                    ЕстьНеВыполненные = ЕстьНеВыполненные ИЛИ НЕ СтрокаЗадач.Выполнена;
                КонецЕсли;
            КонецЦикла;
            //}
            
            Если НЕ ЕстьНеВыполненные Тогда
                НовСтрока = ТабВыполняемыеДействия.Добавить();
                НовСтрока.Точка = Точка;
                НовСтрока.Действие = Действия.СоздатьНевыполненной;
            КонецЕсли;
            
            Если ЕстьВыполненные Тогда
                Для каждого СтрокаЗадач Из М Цикл
                    Если ЗначениеЗаполнено(СтрокаЗадач.Задача) И СтрокаЗадач.Выполнена Тогда
                        НовСтрока = ТабВыполняемыеДействия.Добавить();
                        НовСтрока.Точка = Точка;
                        НовСтрока.Задача = СтрокаЗадач.Задача;
                        НовСтрока.Действие = Действия.ИсключитьИзОбработки;
                	КонецЕсли;
                КонецЦикла; 
            КонецЕсли;
            
            Потомки = Точки_НайтиВсехВозможныхПотомков(Точка);
            Для каждого СтрокаТЗ Из ТабЗадачиТекущие Цикл
                Если ЗначениеЗаполнено(СтрокаТЗ.Задача) И Потомки.Найти(СтрокаТЗ.Точка) <> Неопределено Тогда
                    НовСтрока = ТабВыполняемыеДействия.Добавить();
                    ЗаполнитьЗначенияСвойств(НовСтрока, СтрокаТЗ);
                    НовСтрока.Действие = Действия.Удалить;
                КонецЕсли; 
            КонецЦикла; 
        КонецЦикла;
    КонецЕсли;    
    ИА_БФС.ТЗ_УдалитьДубликаты(ТабВыполняемыеДействия, "Точка, Задача");
    
    Если НЕ РежимЗавершения Тогда
        // А теперь разрешим конфликты 
        // 1) "Двойной" поток
        // 2) Будущие задачи не м.б. выполнены, т.к. теперь не хватает "выполненных" задач
        
        МассивНовыхНеВыполненныхТочек      = Новый Массив;
        МассивНовыхБудущихВыполненныхТочек = Новый Массив; // Здесь д.б. все точки к-е когда-либо будут выполнены
        // получим "текущие"
        Для каждого СтрокаТЗ Из ТабЗадачиТекущие Цикл
            Если ЗначениеЗаполнено(СтрокаТЗ.Задача) И НЕ СтрокаТЗ.Выполнена Тогда
                ИА_БФКС.Массив_ДобавитьЕслиНет(МассивНовыхНеВыполненныхТочек, СтрокаТЗ.Точка);
                //ИА_БФКС.Массив_ДобавитьЕслиНет(МассивНовыхБудущихВыполненныхТочек, СтрокаТЗ.Точка);
            ИначеЕсли ЗначениеЗаполнено(СтрокаТЗ.Задача) И СтрокаТЗ.Выполнена Тогда
                ИА_БФКС.Массив_ДобавитьЕслиНет(МассивНовыхБудущихВыполненныхТочек, СтрокаТЗ.Точка);
            КонецЕсли; 
        КонецЦикла; 
        МассивНовыхНеВыполненныхТочек        = ИА_БФКС.Массив_ПолучитьУникальныеЭлементы(МассивНовыхНеВыполненныхТочек);
        МассивНовыхБудущихВыполненныхТочек   = ИА_БФКС.Массив_ПолучитьУникальныеЭлементы(МассивНовыхБудущихВыполненныхТочек);
        
        // Удалим "текущие" и добавим "новых"
        Для каждого СтрокаТЗ  Из ТабВыполняемыеДействия Цикл
            //*** Невыполненые
            ЭтоНевыполненаяПокаТочка = МассивНовыхНеВыполненныхТочек.Найти(СтрокаТЗ.Точка) <> Неопределено;
            Если ЭтоНевыполненаяПокаТочка
                И (СтрокаТЗ.Действие = Действия.ЗаписатьВыполненной
                ИЛИ СтрокаТЗ.Действие = Действия.Удалить)
                Тогда // Надо удалить
                ИА_БФКС.Массив_УдалитьЕслиЕсть(МассивНовыхНеВыполненныхТочек, СтрокаТЗ.Точка);
            ИначеЕсли СтрокаТЗ.Действие = Действия.СоздатьНевыполненной
                И МассивНовыхНеВыполненныхТочек.Найти(СтрокаТЗ.Точка) = Неопределено            
                Тогда // Новая "невыполненная" точка
                МассивНовыхНеВыполненныхТочек.Добавить(СтрокаТЗ.Точка);
                ИА_БФКС.Массив_ДобавитьЕслиНет(МассивНовыхНеВыполненныхТочек, СтрокаТЗ.Точка);
            КонецЕсли;
            //*** Выполненные
            Если СтрокаТЗ.Действие = Действия.ЗаписатьВыполненной Тогда
                ИА_БФКС.Массив_ДобавитьЕслиНет(МассивНовыхБудущихВыполненныхТочек, СтрокаТЗ.Точка);
            ИначеЕсли СтрокаТЗ.Действие = Действия.СоздатьНевыполненной Тогда
                ИА_БФКС.Массив_ДобавитьЕслиНет(МассивНовыхБудущихВыполненныхТочек, СтрокаТЗ.Точка);
                
                Потомки = ОбрБП.Точки_НайтиВсехВозможныхПотомков(СтрокаТЗ.Точка);
                Для каждого СледТочка Из Потомки Цикл
                    Если СписокТиповДляЗадач.Найти(СледТочка.Тип) <> Неопределено Тогда
                        ИА_БФКС.Массив_ДобавитьЕслиНет(МассивНовыхБудущихВыполненныхТочек, СледТочка);
                    КонецЕсли; 
                КонецЦикла; 
            ИначеЕсли СтрокаТЗ.Действие = Действия.Удалить Тогда
                ИА_БФКС.Массив_УдалитьЕслиЕсть(МассивНовыхБудущихВыполненныхТочек, СтрокаТЗ.Точка);
            КонецЕсли; 
        КонецЦикла; 
        МассивНовыхНеВыполненныхТочек = ИА_БФКС.Массив_ПолучитьУникальныеЭлементы(МассивНовыхНеВыполненныхТочек);
        МассивНовыхБудущихВыполненныхТочек   = ИА_БФКС.Массив_ПолучитьУникальныеЭлементы(МассивНовыхБудущихВыполненныхТочек);
        
        Для каждого Точка Из МассивНовыхНеВыполненныхТочек Цикл
            Потомки = ОбрБП.Точки_НайтиВсехВозможныхПотомков(Точка);
            Для каждого СледТочка Из Потомки Цикл
                Если СписокТиповДляЗадач.Найти(СледТочка.Тип) <> Неопределено Тогда
                    ИА_БФКС.Массив_ДобавитьЕслиНет(МассивНовыхБудущихВыполненныхТочек, СледТочка);
                КонецЕсли; 
            КонецЦикла; 
        КонецЦикла; 
        
        
        Для каждого Точка Из МассивНовыхНеВыполненныхТочек Цикл
            Массив = Новый Массив;
            ЗаполнитьМассивНедостающимиТочкамиДляКорректногоВыполненияВсехБудущихЗадач(ОбрБП
            , Массив
            , Точка
            , МассивНовыхБудущихВыполненныхТочек);
            //ИА_БФКС.Массив_УдалитьЕслиЕсть(Массив, Точка);
            ИА_БФКС.Массив_УдалитьПоУсловию(Массив, "Контекст.Найти(Эл) <> Неопределено", МассивНовыхБудущихВыполненныхТочек);
            ИА_БФКС.Массив_УдалитьПоУсловию(Массив, "Контекст.Найти(Эл) <> Неопределено", МассивНовыхНеВыполненныхТочек);
            Для каждого НеобходимаяТочка Из Массив Цикл            
                НовСтрока = ТабРекомендации.Добавить();
                НовСтрока.Рекомендация = "Требуется решение по точке";
                НовСтрока.Точка1 = НеобходимаяТочка;
                
                НовСтрока = ТабВыполняемыеДействия.Добавить();
                НовСтрока.Точка = НеобходимаяТочка;
                НовСтрока.Действие = Действия.ЗаписатьВыполненной;
            КонецЦикла; 
        КонецЦикла; 
        
        МассивНовыхНеВыполненныхТочек = СписокТочек;
        Для каждого Точка Из МассивНовыхНеВыполненныхТочек Цикл
            Потомки = ОбрБП.Точки_НайтиВсехВозможныхПотомков(Точка);
            Для каждого АктивнаяТочка Из МассивНовыхНеВыполненныхТочек Цикл
                Если Потомки.Найти(АктивнаяТочка) <> Неопределено Тогда
                    НовСтрока = ТабРекомендации.Добавить();
                    НовСтрока.Рекомендация = """Двойной"" поток";
                    НовСтрока.Точка1 = Точка;
                    НовСтрока.Точка2 = АктивнаяТочка;
                КонецЕсли; 
            КонецЦикла; 
        КонецЦикла;
    КонецЕсли; 
    
    ИА_БФС.ТЗ_УдалитьДубликаты(ТабВыполняемыеДействия, "Точка, Задача");
    ИА_БФС.ТЗ_УдалитьДубликаты(ТабРекомендации, "Рекомендация, Точка1, Точка2");
    Результат = Новый Структура("ТабВыполняемыеДействия, ТабРекомендации", ТабВыполняемыеДействия, ТабРекомендации); 
    Возврат Результат;
КонецФункции

Процедура ЗаполнитьМассивНедостающимиТочкамиДляКорректногоВыполненияВсехБудущихЗадач(Обр, Массив, Точка
    , МассивНовыхБудущихВыполненныхТочек, НаправлениеВверх = Ложь)
    #ЕСЛИ НЕ( Клиент или Сервер или ВнешнееСоединение ) Тогда
        Обр = Обработки.ИА_БПМенеджер.Создать();
    #КОНЕЦЕСЛИ
    Если НаправлениеВверх Тогда
        ТочкиСлияния = Новый Массив;
        ТочкиСлияния.Добавить(Точка);
    Иначе        
        Потомки = Обр.Точки_НайтиВсехВозможныхПотомков(Точка, Истина);
        ТочкиСлияния = ИА_БФКС.Массив_ФильтрПоУсловию(Потомки, "Эл.Тип=Контекст", Перечисления.ИА_БПТипыТочекМаршрута.Слияние);
    КонецЕсли; 
    
    Для каждого ТочкаСлияния Из ТочкиСлияния Цикл
        Инфо = Обр.Точки_ПолучитьИнформацию(ТочкаСлияния);
        
        Для каждого Родитель Из Инфо.Входящие Цикл
            ИнфоРодитель = Обр.Точки_ПолучитьИнформацию(Родитель);
            Если ИнфоРодитель.Тип = Перечисления.ИА_БПТипыТочекМаршрута.Слияние Тогда
                ЗаполнитьМассивНедостающимиТочкамиДляКорректногоВыполненияВсехБудущихЗадач(Обр, Массив, Родитель, МассивНовыхБудущихВыполненныхТочек, Истина);
            ИначеЕсли СписокТиповДляЗадач.Найти(ИнфоРодитель.Тип) <> Неопределено
                И МассивНовыхБудущихВыполненныхТочек.Найти(ИнфоРодитель) = Неопределено
                Тогда // Д.б. "выполнено"
                ИА_БФКС.Массив_ДобавитьЕслиНет(Массив, Родитель);
            КонецЕсли;
        КонецЦикла; 
    КонецЦикла;
КонецПроцедуры

Функция   БП_ПолучитьКартуМаршрутаПослеПерехода(КартаМаршрутаНовая, ТабВыполняемыеДействия) Экспорт
    Возврат ИА_Защита_НФ.БП_ПолучитьКартуМаршрутаПослеПерехода(КартаМаршрутаНовая, ТабВыполняемыеДействия, ЭтотОбъект);
КонецФункции

Процедура БП_ВыполнитьПереход(КартаМаршрутаНовая, ТабВыполняемыеДействия) Экспорт
