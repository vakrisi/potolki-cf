&НаКлиенте
Процедура Сдвинуть(ВерхНиз)
	тс = Элементы.Стратегия.ТекущаяСтрока;
	ТекСтрока = СтратегияДерево.НайтиПоИдентификатору(тс); 
	
	Родитель = ?(ТекСтрока.ПолучитьРодителя() = Неопределено, СтратегияДерево, ТекСтрока.ПолучитьРодителя());
	Коллекция = Родитель.ПолучитьЭлементы();
	
	// удалим архив
	сч = Коллекция.Количество()-1;
	Пока сч>=0 Цикл
		текСтр = Коллекция[сч];
		Если текСтр.ЭтоАрхив Тогда
			Коллекция.Удалить(текСтр);
		КонецЕсли;
		
		сч = сч - 1;
	КонецЦикла;
	
	Инд = Коллекция.Индекс(ТекСтрока);
	Попытка
		СдвигЭлем = Коллекция.Получить(Инд + ?(ВерхНиз=1,2,-1));
		Если СдвигЭлем.ЭтоКоррекция и не СдвигЭлем.Коррекция_Добавление Тогда
			ВерхНиз = ВерхНиз * 2; // проскакиваем коррекции и элементы которые они корректируют
		КонецЕсли;
	Исключение
	КонецПопытки;
	Коллекция.Сдвинуть(Инд,ВерхНиз);
	
	//
	КоллСсылок = Новый массив;
	Для каждого стр из Коллекция Цикл
		Если не стр.ЭтоКоррекция ИЛИ стр.Коррекция_Добавление Тогда
			КоллСсылок.Добавить(стр.Ссылка);
		КонецЕсли;
	КонецЦикла;
	СохранитьСдвиг(КоллСсылок);
	//
	
	ОбновитьДоступностьСдвигов();
КонецПроцедуры

