&НаКлиенте
Процедура ПриОткрытии(Отказ)
	Если не ИА_Защита_Общий.ЛицензияДоступна("Админшкала") Тогда
		Отказ = Истина;
		возврат;
	КонецЕсли;
	
	ОбновитьОтобрРежима();	
	
	Если РежимВыбора Тогда
		ЭтаФорма.КоманднаяПанель.Видимость = Ложь;
		Элементы.Стратегия.ТолькоПросмотр = истина;
		Отбор_ПриИзменении(Неопределено);
		Элементы.ДиаграммаГанта.Видимость = Ложь;
	Иначе
		ОбновитьДерево();
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Отбор_ЗРС) ТОгда
		Элементы.Стратегия.ТолькоПросмотр = истина;
		Элементы.Стратегия.ПоложениеКоманднойПанели=ПоложениеКоманднойПанелиЭлементаФормы.Нет;
	Иначе
		Элементы.ГруппаКП_Коррекция.Видимость = Ложь;
	КонецЕсли;
КонецПроцедуры

