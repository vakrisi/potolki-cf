&НаСервереБезКонтекста
Функция ПолучитьРешениеЗРСКоррекции(Коррекции)
	Рез = "Прошу одобрить следующие корректировки задач:" + Символы.ПС;
	Для каждого КоррСсылка из Коррекции Цикл
		НаименованиеЗадачи = СокрЛП(КоррСсылка.Содержание);		
		
		НаименованиеИсходнойЗадачи = СокрЛП(КоррСсылка.СсылкаНаКоррЭлемент.Содержание);		
		
		Если КоррСсылка.Коррекция_Удаление Тогда
			Рез = Рез + "[УДАЛЕНИЕ] " + НаименованиеЗадачи + Символы.ПС + Символы.ПС;
		ИначеЕсли КоррСсылка.Коррекция_Добавление Тогда
			Рез = Рез + "[НОВАЯ ЗАДАЧА] " + НаименованиеЗадачи  + Символы.ПС + Символы.ПС;
		Иначе
			Рез = Рез + "[КОРРЕКЦИЯ] " + НаименованиеИсходнойЗадачи + Символы.ПС;
			Если НаименованиеЗадачи <> НаименованиеИсходнойЗадачи Тогда
				Рез = Рез + "[Новое содержание задачи] " + НаименованиеЗадачи + Символы.ПС;
			КонецЕсли;
			Если КоррСсылка.Срок <> КоррСсылка.СсылкаНаКоррЭлемент.Срок Тогда
				Рез = Рез + "[Новый срок] " + ФОРМАТ(КоррСсылка.Срок,"ДФ=dd.MM.yyyy") + Символы.ПС;
			КонецЕсли;
			Рез = Рез + Символы.ПС;
		КонецЕсли;
	КонецЦикла;
	Возврат Рез;
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьКоррекци(Программа)
	Запрос = новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ИА_СтратегическоеУправление.Ссылка
	|ИЗ
	|	Справочник.ИА_СтратегическоеУправление КАК ИА_СтратегическоеУправление
	|ГДЕ
	|	ИА_СтратегическоеУправление.Ссылка В ИЕРАРХИИ(&Ссылка)
	|	И ИА_СтратегическоеУправление.ЭтоКоррекция
	|	И ИА_СтратегическоеУправление.Коррекция_Автор = &Пользователь
	|	И ИА_СтратегическоеУправление.ПометкаУдаления = ЛОЖЬ
	|	И ИА_СтратегическоеУправление.Коррекция_ЗРС = ЗНАЧЕНИЕ(Задача.ИА_ЗадачаПланаДействий.ПустаяСсылка)";
	Запрос.УстановитьПараметр("Ссылка", Программа);
	Запрос.УстановитьПараметр("Пользователь", ПараметрыСеанса.ТекущийПользователь);
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
КонецФункции

&НаКлиенте
Процедура СледующаяКоррекция(Команда) Экспорт
	тд = Элементы.Стратегия.ТекущиеДанные;
	Если тд = Неопределено Тогда
		ТекИд = 1;
	Иначе
		текИД = тд.ПолучитьИдентификатор() + 1;
	КонецЕсли;
	
	СледЭлем = СтратегияДерево.НайтиПоИдентификатору(текИД);
	Пока СледЭлем<>Неопределено Цикл
		Если СледЭлем.ЭтоКоррекция Тогда
			Элементы.Стратегия.ТекущаяСтрока =  текИД;
			Возврат;
		КонецЕсли;
		
		текИД = ТекИд + 1;
		СледЭлем = СтратегияДерево.НайтиПоИдентификатору(текИД);
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ПредыдущаяКоррекция(Команда)
	тд = Элементы.Стратегия.ТекущиеДанные;
	Если тд = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	текИД = тд.ПолучитьИдентификатор() - 1;
	СледЭлем = СтратегияДерево.НайтиПоИдентификатору(текИД);
	Пока СледЭлем<>Неопределено Цикл
		Если СледЭлем.ЭтоКоррекция Тогда
			Элементы.Стратегия.ТекущаяСтрока =  текИД;
			Возврат;
		КонецЕсли;
		
		текИД = ТекИд - 1;
		СледЭлем = СтратегияДерево.НайтиПоИдентификатору(текИД);
	КонецЦикла;
КонецПроцедуры

