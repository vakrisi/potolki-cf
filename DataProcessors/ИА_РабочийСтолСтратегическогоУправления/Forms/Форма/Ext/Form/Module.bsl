&НаКлиенте
Процедура ОтправитьОтчетОбИсполнении(Команда)
	тд = Элементы.Стратегия.ТекущиеДанные;
	
	Программа = ИА_АдминшкалаСервер.ПолучитьПрограммуЗадачи(тд.ссылка);
	
	Если Программа = Неопределено тогда
		Сообщить("Неверная структура данных. Задача не в программе!");
		Возврат;
	КонецЕсли;
	
	Отв = ИА_АдминшкалаСервер.ПолучитьОтветственногоПрограммы(Программа);
	Если отв.Пустая() Тогда
		Сообщить("В программе не указан ответственный за задачи! Отчет не отправлен!");
		Возврат;
	КонецЕсли;
	
	НаименованиеЗадачи = СокрЛП(тд.Содержание);
	Если СтрДлина(НаименованиеЗадачи)>70 Тогда
		НаименованиеЗадачи = лев(НаименованиеЗадачи,70)+"...";
	КонецЕсли;
	НаименованиеЗадачи = СтрЗаменить(НаименованиеЗадачи, Символы.ПС, " ");
	
	НаименованиеПрограммы = ИА_АдминшкалаСервер.ПолучитьНаименованиеПрограммы(Программа);
	
	СодержаниеЗ = "Задача """+НаименованиеЗадачи+""" из программы """+НаименованиеПрограммы+""" выполнена. Прошу подтвердить. "+Символы.ПС+"Доказательства (напишите текст или прикрепите файл или объект базы данных):"+Символы.ПС ;
	ПользЗ = ИА_ОбщиеПроцедурыКЦиОргсхема.ПолучитьПользователяНаПосту(Отв);
	НаименованиеЗ = "Доклад об исполнении задачи: "+НаименованиеЗадачи;
	Парам = Новый структура("ЗадачаСУ,Наименование,Пост,Пользователь,Содержание",тд.Ссылка,НаименованиеЗ,Отв,ПользЗ,СодержаниеЗ);
	
	ОткрытьФорму("Задача.ИА_ЗадачаПланаДействий.ФормаОбъекта",Парам,ЭтаФорма,,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

