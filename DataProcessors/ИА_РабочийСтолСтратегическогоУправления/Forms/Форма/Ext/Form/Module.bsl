&НаСервере
Процедура ОбновитьГантаНаСервере()
	дер = ИА_Защита_Админшкала.ПолучитьДеревоСУ(Отбор_ТолькоПросроченные, Отбор_ТолькоРабочие, Отбор_ТолькоНезавершенные, Отбор_ЗадачиПоста, Отбор_ПрограммыПоста, Отбор_Архив, Отбор_ЗРС, истина);
	
	ЗависимыеЗадачи.Очистить();
	
	Гант.Обновление = Ложь;
	Гант.Очистить();
	Гант.ОтображатьЛегенду = ложь;
	
	Серия = Гант.УстановитьСерию("Задачи"); 
	ЗагрузитьДеревоВГанта(дер.Строки, гант.Точки,Серия);
	
	Для каждого т из Гант.Точки Цикл
		Гант.РазвернутьТочку(т,истина);	
	КонецЦикла;
	
	Гант.Обновление = Истина;
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьДеревоВГанта(СтрокиДерева, ТочкиГанта,Серия)
	текДата = ТекущаяДата();
	
	Для каждого стр из СтрокиДерева Цикл
		Если ЗначениеЗаполнено(стр.ЗависитОтЗадачи) Тогда
			новСв = ЗависимыеЗадачи.Добавить();
			новСв.Задача = стр.Ссылка;
			новСв.ЗависитОтЗадачи = стр.ЗависитОтЗадачи;
		КонецЕсли;
		
		НовТочка = ТочкиГанта.Добавить();
		НовТочка.Значение = стр.Ссылка;
		НовТочка.Текст = стр.Содержание;
		
		Значение = Гант.ПолучитьЗначение(НовТочка, Серия);
		Значение.Редактирование = стр.ПравоРедактирования;
		// 
		Если стр.ТипЭлемента = Перечисления.ИА_ТипыЭлементовСтратегическогоУправления.Цель Тогда
			НовТочка.Картинка = БиблиотекаКартинок.ИА_Стратегия_Цель;
			НовТочка.Шрифт = Новый Шрифт(,13);
		ИначеЕсли стр.ТипЭлемента = Перечисления.ИА_ТипыЭлементовСтратегическогоУправления.План Тогда
			НовТочка.Картинка = БиблиотекаКартинок.ИА_Стратегия_План;
			НовТочка.Шрифт = Новый Шрифт(,12);
		ИначеЕсли стр.ТипЭлемента = Перечисления.ИА_ТипыЭлементовСтратегическогоУправления.Программа Тогда
			НовТочка.Картинка = БиблиотекаКартинок.ИА_Стратегия_Программа;
			НовТочка.Шрифт = Новый Шрифт(,11);
		ИначеЕсли стр.ТипЭлемента = Перечисления.ИА_ТипыЭлементовСтратегическогоУправления.ТипЗадачи Тогда
			НовТочка.Картинка = БиблиотекаКартинок.ИА_Стратегия_ТипЗадачи;
			НовТочка.Шрифт = Новый Шрифт(,10);
			
			Значение.Редактирование = ложь;
			
			стр.ДатаНачала = стр.ДатаНачалаМин;
			стр.Срок = стр.СрокМакс;

		ИначеЕсли стр.ТипЭлемента = Перечисления.ИА_ТипыЭлементовСтратегическогоУправления.Раздел Тогда			
			НовТочка.Картинка = БиблиотекаКартинок.ИА_Стратегия_Раздел;
			НовТочка.Шрифт = Новый Шрифт(,9);
		ИначеЕсли стр.ТипЭлемента = Перечисления.ИА_ТипыЭлементовСтратегическогоУправления.Задача Тогда			
			Если стр.Выполнено Тогда
				НовТочка.Картинка = БиблиотекаКартинок.ИА_Стратегия_ЗадачаВыполнена;
			Иначе
				НовТочка.Картинка = БиблиотекаКартинок.ИА_Стратегия_Задача;
			КонецЕсли;
			НовТочка.Шрифт = Новый Шрифт(,9);
		КонецЕсли;
		//
		Интервал = Значение.Добавить();
		
		Если не стр.ПравоРедактирования Тогда
			Интервал.Цвет = Новый цвет(230,230,255);
		ИначеЕсли не (ЗначениеЗаполнено(стр.ДатаНачала) И ЗначениеЗаполнено(стр.ДатаНачала)) Тогда
			Интервал.Цвет = Новый цвет(200,200,255);
		Иначе
			Интервал.Цвет = Новый цвет(150,150,255);
		КонецЕсли;
		
		Если стр.ТипЭлемента = Перечисления.ИА_ТипыЭлементовСтратегическогоУправления.Задача Тогда
			Если стр.Выполнено Тогда
				Интервал.Цвет = Новый цвет(190,255,190);
			ИначеЕсли ЗначениеЗаполнено(стр.Срок) и стр.Срок < НачалоДня(ТекущаяДата()) ТОгда
				Интервал.Цвет = Новый цвет(255,190,190);
			КонецЕсли;
		КонецЕсли;
		
		дн = ?(ЗначениеЗаполнено(стр.ДатаНачала),стр.ДатаНачала,стр.ДатаНачалаМин);
		дк = ?(ЗначениеЗаполнено(стр.Срок),КонецДня(стр.Срок),КонецДня(стр.СрокМакс));
		Если дк < дн Тогда
			дк = дн + 60*60*24;
		КонецЕсли;
		
		Интервал.Начало = ?(ЗначениеЗаполнено(дн),дн,текДата);
		Интервал.Конец = КонецДня(?(ЗначениеЗаполнено(дк),дк,текДата));
				
		ЗагрузитьДеревоВГанта(стр.Строки, НовТочка.Точки, Серия)
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьГанта(Команда)
	Если Элементы.СохранитьИзменения.Доступность Тогда
		ПоказатьВопрос(Новый ОписаниеОповещения("ОбновитьГантаЗавершение", ЭтаФорма), "Данные были изменены. Сохранить?",РежимДиалогаВопрос.ДаНет);
        Возврат;
	КонецЕсли;
	
	ОбновитьГантаФрагмент();
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьГантаЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		СохранитьИзменения(Неопределено);
	КонецЕсли;		
	
	ОбновитьГантаФрагмент();

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьГантаФрагмент()
	
	ОбновитьГантаНаСервере(); 
	ОбновитьТекстыВсехИнтервалов();
	ОбновитьСвязи(гант.Точки);
	Элементы.СохранитьИзменения.Доступность = ложь;

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСвязи(точки)
	Для каждого т из точки Цикл
		нстроки = ЗависимыеЗадачи.НайтиСтроки(новый Структура("Задача", т.значение));
		если нстроки.Количество() > 0 Тогда
			ЗадачаИсх = нстроки[0].Задача;
			ЗадачаОтКоторойЗав = нстроки[0].ЗависитОтЗадачи;
			ТочкаЗав = ПолучитьТочкуПоЗначению(ЗадачаОтКоторойЗав,т.Родитель);
			
			Серия = Гант.Серии[0];			
			знчОт = Гант.ПолучитьЗначение(ТочкаЗав, Серия);
			ДЛя каждого ИнтервалОт из знчОт Цикл
			КонецЦикла;
			знчДо = Гант.ПолучитьЗначение(т, Серия);
			ДЛя каждого ИнтервалДо из знчДо Цикл
			КонецЦикла;
			
			ИнтервалОт.Добавить(ИнтервалДо);
		КонецЕсли;
		ОбновитьСвязи(т.точки);		
	КонецЦикла;
КонецПроцедуры	
	
&НаКлиенте
Процедура ГантПриОкончанииРедактированияИнтервала(Элемент, Интервал, ОтменаРедактирования)
	Элементы.СохранитьИзменения.Доступность = истина;	
	ОбновитьТекстыВсехИнтервалов();
	
	// зависимые задачи
	ТекЗадача = Интервал.Значение.Точка.Значение;
	СдвинутьЗависящиеЗадачи(ТекЗадача, Интервал.Конец);
	
КонецПроцедуры

&НаКлиенте
Процедура СдвинутьЗависящиеЗадачи(ТекЗадача, конец)
	
	нстроки = ЗависимыеЗадачи.НайтиСтроки(новый Структура("ЗависитОтЗадачи", ТекЗадача));
	Если нстроки.Количество() > 0 Тогда
		ТочкаЗав = ПолучитьТочкуПоЗначению(нстроки[0].Задача, Гант);
		
		Серия = Гант.Серии[0];			
		знЗависимое = Гант.ПолучитьЗначение(ТочкаЗав, Серия);
		ДЛя каждого ИнтервалЗависимый из знЗависимое Цикл
			длительность = ИнтервалЗависимый.Конец - ИнтервалЗависимый.Начало;
			ИнтервалЗависимый.Начало = Конецдня(Конец) + 1;
			ИнтервалЗависимый.Конец = ИнтервалЗависимый.Начало + длительность;
			
			СдвинутьЗависящиеЗадачи(ТочкаЗав.Значение, ИнтервалЗависимый.Конец);
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры



&НаСервере
Процедура СохранитьИзмененияТочек(точки)
	с= гант.Серии[0];
	Для каждого т из Точки Цикл
		зн = гант.ПолучитьЗначение(т,с);
		Для каждого инт из зн Цикл
			об = т.Значение.ПолучитьОбъект();
			об.ДатаНачала = инт.Начало;
			об.Срок = инт.Конец;
			об.Записать();
		КонецЦикла;		
		СохранитьИзмененияТочек(т.Точки);
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура СохранитьИзмененияНаСервере()
	СохранитьИзмененияТочек(гант.Точки);
КонецПроцедуры


&НаКлиенте
Процедура СохранитьИзменения(Команда)
	СохранитьИзмененияНаСервере();
	Элементы.СохранитьИзменения.Доступность = ложь;
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьТекстыВсехИнтервалов()
	гант.Обновление = ложь;
	ОбновитьТекстыИнтервалов(гант.Точки);
	гант.Обновление = Истина;
КонецПроцедуры
	
&НаКлиенте
Процедура ОбновитьТекстыИнтервалов(точки)
	с= гант.Серии[0];
	Для каждого т из точки Цикл
		зн = гант.ПолучитьЗначение(т,с);
		Для каждого инт из зн Цикл
			инт.Текст = формат(инт.Начало,"ДФ=dd.MM")+"-"+формат(инт.Конец,"ДФ=dd.MM");
		КонецЦикла;
		ОбновитьТекстыИнтервалов(т.точки);
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ДиаграммаГанта(Команда)
	РежимГант = не РежимГант;
	ОбновитьОтобрРежима();
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьОтобрРежима()
	
	Элементы.ГруппаКПГлавная.Видимость = не РежимГант;
	Элементы.Стратегия.Видимость = не РежимГант;
	Элементы.ГруппаКП_Коррекция.Видимость = ЗначениеЗаполнено(Отбор_ЗРС) и не РежимГант;
	
	Элементы.ГруппаКПГант.Видимость = РежимГант;
	Элементы.Гант.Видимость = РежимГант;
	
	Если РежимГант Тогда
		ОбновитьГанта(Неопределено);
	Иначе
		ОбновитьДеревоССохранениемСостояния();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ГантВыбор(Элемент, Значения, СтандартнаяОбработка, Дата)
	если типзнч(Значения) = тип("ТочкаДиаграммыГанта") И ТипЗнч(Значения.Значение) = тип("СправочникСсылка.ИА_СтратегическоеУправление") Тогда
		Если Элементы.СохранитьИзменения.Доступность Тогда
			ПоказатьПредупреждение(,"Перед открытием задачи сохраните все изменения");
	        Возврат;
		КонецЕсли;
		оп = новый ОписаниеОповещения("ГантВыборЗакрытие",ЭтаФорма,новый Структура("знч", Значения.Значение));
		ОткрытьФорму("Справочник.ИА_СтратегическоеУправление.ФормаОбъекта", новый структура("Ключ", Значения.Значение),,,,,оп);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Функция ПолучитьТочкуПоЗначению(зн,ТекСтр)
	Для каждого т из ТекСтр.Точки Цикл
		если т.значение = зн Тогда
			возврат т;
		КонецЕсли;
		рез = ПолучитьТочкуПоЗначению(зн, т);
		Если рез<> Неопределено ТОгда
			возврат рез;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Неопределено;		
КонецФункции

&НаКлиенте
Процедура ГантВыборЗакрытие(ВыбЗн, ДопПарам) Экспорт
	Серия = Гант.Серии[0]; 
	//Точка = гант.Точки.Получить(ДопПарам.ТочкаИнд);
	точка = ПолучитьТочкуПоЗначению(ДопПарам.знч, Гант);
	
	знч = Гант.ПолучитьЗначение(Точка, Серия);
	ДЛя каждого Интервал из знч Цикл
	КонецЦикла;
	
	ДанныеЗадачи = ПолучитьДанныеЗадачи(ДопПарам.знч);
	
	Если ЗначениеЗаполнено(ДанныеЗадачи.ДатаНачала) Тогда
		интервал.Начало = ДанныеЗадачи.ДатаНачала;
	КонецЕсли;
	Если ЗначениеЗаполнено(ДанныеЗадачи.Срок) Тогда
		интервал.Конец = КонецДня(ДанныеЗадачи.Срок);
	КонецЕсли;
	
	Если ДанныеЗадачи.Выполнено Тогда
		Интервал.Цвет = Новый цвет(190,255,190);
	ИначеЕсли ЗначениеЗаполнено(ДанныеЗадачи.Срок) и ДанныеЗадачи.Срок < НачалоДня(ТекущаяДата()) ТОгда
		Интервал.Цвет = Новый цвет(255,190,190);
	КонецЕсли;
	
	точка.Текст = ДанныеЗадачи.Содержание;
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьДанныеЗадачи(з)
	Возврат новый структура("ДатаНачала, Срок, Выполнено, Содержание", з.ДатаНачала, з.Срок, з.Выполнено, з.Содержание);
КонецФункции

