&НаКлиенте
Процедура СтратегияПриАктивизацииСтроки(Элемент)
	ОбновитьДоступностьСоздатьВыполнитьЗадачу();		
	ОбновитьДоступностьДобавления();
	ОбновитьДоступностьСдвигов();
	ОбновитьДоступностьАрхиваИКоррекции();
	ОбновитьДоступностьПечати();
	//ОбновитьЗаголовкиДобавления();
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьДоступностьПечати()
	Элементы.СтратегияПечатьПрограммы.Доступность = ложь;
	тд = Элементы.Стратегия.ТекущиеДанные;
	Если тд = Неопределено ТОгда
		Возврат;
	КонецЕсли;
	
	типЗ = ПредопределенноеЗначение("Перечисление.ИА_ТипыЭлементовСтратегическогоУправления.Программа");
	Элементы.СтратегияПечатьПрограммы.Доступность = тд.ТипЭлемента = типЗ;
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьДоступностьСдвигов()
	тд = Элементы.Стратегия.ТекущиеДанные;
	Если тд = Неопределено ТОгда
		Элементы.СтратегияКонтекстноеМенюСдвинутьВверх.Доступность = Ложь;
		Элементы.СтратегияКонтекстноеМенюСдвинутьВниз.Доступность = Ложь;
		Возврат;
	КонецЕсли;
	ТекИд = Элементы.Стратегия.ТекущаяСтрока;
	
	Элементы.СтратегияКонтекстноеМенюСдвинутьВверх.Доступность =  не тд.ЭтоАрхив и тд.ПравоРедактирования и ((не тд.ЭтоКоррекция) ИЛИ тд.Коррекция_Добавление);
	Элементы.СтратегияКонтекстноеМенюСдвинутьВниз.Доступность =  не тд.ЭтоАрхив и тд.ПравоРедактирования и ((не тд.ЭтоКоррекция) ИЛИ тд.Коррекция_Добавление);
	
	Родитель = ?(тд.ПолучитьРодителя() = Неопределено, СтратегияДерево, тд.ПолучитьРодителя());
	Коллекция = Родитель.ПолучитьЭлементы();
	Если ТекИд = Коллекция[0].ПолучитьИдентификатор() ТОгда // первая строка
		Элементы.СтратегияКонтекстноеМенюСдвинутьВверх.Доступность = Ложь;
	КонецЕсли;
	
	Если ТекИд = Коллекция[Коллекция.Количество()-1].ПолучитьИдентификатор() ТОгда // последняя строка
		Элементы.СтратегияКонтекстноеМенюСдвинутьВниз.Доступность = Ложь;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьДоступностьАрхиваИКоррекции()
	тд = Элементы.Стратегия.ТекущиеДанные;
	Если тд = Неопределено ТОгда
		Возврат;
	КонецЕсли;
	
	Элементы.СтратегияКонтекстноеМенюСкрытьАрхивныеКопии.Доступность = тд.ТипЭлемента = ПредопределенноеЗначение("Перечисление.ИА_ТипыЭлементовСтратегическогоУправления.Программа") и не тд.ЭтоАрхив и не тд.ЭтоКоррекция;
	Элементы.СтратегияКонтекстноеМенюПоказатьАрхивныеКопии.Доступность = тд.ТипЭлемента = ПредопределенноеЗначение("Перечисление.ИА_ТипыЭлементовСтратегическогоУправления.Программа") и не тд.ЭтоАрхив и не тд.ЭтоКоррекция;
	
	КоррекцияДоступна = тд.ТипЭлемента = ПредопределенноеЗначение("Перечисление.ИА_ТипыЭлементовСтратегическогоУправления.Задача");
	
	Элементы.СтратегияИзменитьТекущуюЗадачу.Доступность = ложь;
	Элементы.СтратегияДобавитьЗадачу.Доступность = КоррекцияДоступна;
	Элементы.СтратегияУдалитьЗадачу.Доступность = ложь;
	Элементы.СтратегияОтменитьКоррекцию.Доступность = КоррекцияДоступна и тд.ЭтоКоррекция;
	Элементы.СтратегияОформитьЗРСНаКоррекцию.Доступность = тд.ТипЭлемента = ПредопределенноеЗначение("Перечисление.ИА_ТипыЭлементовСтратегическогоУправления.Программа") 
	ИЛИ тд.ТипЭлемента = ПредопределенноеЗначение("Перечисление.ИА_ТипыЭлементовСтратегическогоУправления.ТипЗадачи")
	ИЛИ тд.ТипЭлемента = ПредопределенноеЗначение("Перечисление.ИА_ТипыЭлементовСтратегическогоУправления.Раздел")
	ИЛИ тд.ТипЭлемента = ПредопределенноеЗначение("Перечисление.ИА_ТипыЭлементовСтратегическогоУправления.Задача");
	
	Если КоррекцияДоступна Тогда
		УжеЕстьКоррекция = тд.ЭтоКоррекция;	
		Если не УжеЕстьКоррекция Тогда
			ЭлементыРод = СтратегияДерево.НайтиПоИдентификатору(тд.ПолучитьИдентификатор()).ПолучитьРодителя().ПолучитьЭлементы();
			индексТек = ЭлементыРод.Индекс(тд); 
			Если индексТек < ЭлементыРод.Количество()-1 Тогда
				СледСтрока = ЭлементыРод.Получить(индексТек+1);
				УжеЕстьКоррекция = СледСтрока.ЭтоКоррекция и не СледСтрока.Коррекция_Добавление;
			КонецЕсли;
		КонецЕсли;
		
		Элементы.СтратегияИзменитьТекущуюЗадачу.Доступность = не УжеЕстьКоррекция и не тд.Выполнено;
		Элементы.СтратегияУдалитьЗадачу.Доступность = не УжеЕстьКоррекция и не тд.Выполнено;
	КонецЕсли;
	
	Если не ЕстьПравоРедактирования Тогда
		Элементы.СтратегияИзменитьТекущуюЗадачу.Доступность = ложь;
		Элементы.СтратегияДобавитьЗадачу.Доступность = ложь;
		Элементы.СтратегияУдалитьЗадачу.Доступность = ложь;
		Элементы.СтратегияОтменитьКоррекцию.Доступность = ложь;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьЗаголовкиДобавления()
	тд = Элементы.Стратегия.ТекущиеДанные;
	Если тд = Неопределено ТОгда
		Возврат;
	КонецЕсли;
	
	ЗаголовокДобСтроку = "Добавить строку";
	ЗаголовокДобПодчСтроку = "Добавить подчиненную строку";
	
	// Подчиненные
	Отбор = Новый Структура("ТипЭлемента", тд.ТипЭлемента);
	возмПодч = ИерархияСУ.НайтиСтроки(Отбор);
	
	ДобТип = Неопределено;
	Если возмПодч.количество() > 0 Тогда
		ЗаголовокДобПодчСтроку = "Добавить ";
		Первый = истина;
		Для каждого стр из возмПодч Цикл
			Если не Первый Тогда
				ЗаголовокДобПодчСтроку = ЗаголовокДобПодчСтроку + " или ";
			КонецЕсли;
			
			ЗаголовокДобПодчСтроку = ЗаголовокДобПодчСтроку + стр.ПодчиненныйТип;
			Первый = Ложь;
		КонецЦикла;		
	КонецЕсли;
	
	Элементы.СтратегияДобавитьПодчиненнуюСтроку.Заголовок = ЗаголовокДобПодчСтроку;
	Элементы.СтратегияКонтекстноеМенюДобавитьПодчиненнуюСтроку.Заголовок = ЗаголовокДобПодчСтроку;
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьДоступностьДобавления()
	тд = Элементы.Стратегия.ТекущиеДанные;
	Если тд = Неопределено ТОгда
		Возврат;
	КонецЕсли;
	
	типЗ = ПредопределенноеЗначение("Перечисление.ИА_ТипыЭлементовСтратегическогоУправления.Задача");
	Элементы.СтратегияДобавитьПодчиненнуюСтроку.Доступность = тд.ТипЭлемента <> типЗ и не тд.ЭтоАрхив и тд.ПравоРедактирования и не тд.ЭтоКоррекция;
	Элементы.СтратегияКонтекстноеМенюДобавитьПодчиненнуюСтроку.Доступность = тд.ТипЭлемента <> типЗ и не тд.ЭтоАрхив и тд.ПравоРедактирования и не тд.ЭтоКоррекция;
	
	МожноДобавлятьСтроки = не тд.ЭтоАрхив и не тд.ЭтоКоррекция;
	текРод = тд.ПолучитьРодителя();
	Если МожноДобавлятьСтроки И текРод<>Неопределено Тогда
		МожноДобавлятьСтроки = текРод.ПравоРедактирования;
	КонецЕсли;
	Элементы.СтратегияДобавитьСтроку.Доступность = МожноДобавлятьСтроки;
	Элементы.СтратегияКонтекстноеМенюДобавитьСтроку.Доступность = МожноДобавлятьСтроки;
	
	Элементы.СтратегияКонтекстноеМенюУдалить.Доступность = не тд.ЭтоАрхив и тд.ПравоРедактирования и не тд.ЭтоКоррекция;
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьДоступностьСоздатьВыполнитьЗадачу()
	Элементы.СтратегияСоздатьЗадачуКЦ.Доступность = Ложь;
	Элементы.СтратегияВыполнитьЗадачу.Доступность = Ложь;
	Элементы.СтратегияОтправитьОтчетОбИсполнении.Доступность = Ложь;
	тд = Элементы.Стратегия.ТекущиеДанные;
	
	если тд = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Элементы.СтратегияСоздатьЗадачуКЦ.Доступность = 
	тд.ТипЭлемента = ПредопределенноеЗначение("Перечисление.ИА_ТипыЭлементовСтратегическогоУправления.Задача") 
	и не ЗначениеЗаполнено(тд.Задача) и не тд.Выполнено и ЗначениеЗаполнено(тд.Ссылка) и не тд.ЭтоАрхив и не тд.ЭтоКоррекция И ИА_АдминшкалаСервер.МожноВыполнитьЗадачу(тд.Ссылка);
	
	Элементы.СтратегияВыполнитьЗадачу.Доступность = 
	тд.ТипЭлемента = ПредопределенноеЗначение("Перечисление.ИА_ТипыЭлементовСтратегическогоУправления.Задача") 
	и не тд.Выполнено и ЗначениеЗаполнено(тд.Ссылка) И ИА_АдминшкалаСервер.МожноВыполнитьЗадачу(тд.Ссылка) и не тд.ЭтоАрхив и тд.ПравоРедактирования и не тд.ЭтоКоррекция;
	
	Элементы.СтратегияОтправитьОтчетОбИсполнении.Доступность = 
	тд.ТипЭлемента = ПредопределенноеЗначение("Перечисление.ИА_ТипыЭлементовСтратегическогоУправления.Задача") 
	и не тд.Выполнено и ЗначениеЗаполнено(тд.Ссылка) и не тд.ЭтоАрхив и не тд.ЭтоКоррекция;
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если не ИА_Защита_Общий.ЛицензияДоступна("Админшкала") Тогда
		возврат;
	КонецЕсли;
	
	//
	Параметры.Свойство("Отбор_ЗадачиПоста", Отбор_ЗадачиПоста);
	Параметры.Свойство("РежимВыбора", РежимВыбора);
	Параметры.Свойство("Отбор_ТолькоНезавершенные", Отбор_ТолькоНезавершенные);
	//
	
	спрСтратегия = Метаданные.Справочники.ИА_СтратегическоеУправление;
	ЕстьПравоРедактирования = ПравоДоступа("Изменение",спрСтратегия) и ПравоДоступа("Добавление",спрСтратегия);
	
	Если не ЕстьПравоРедактирования Тогда
		Элементы.Стратегия.ТолькоПросмотр = истина;
		
		Элементы.СтратегияДобавитьСтроку.Видимость = ложь;
		Элементы.СтратегияДобавитьПодчиненнуюСтроку.Видимость = ложь;
		
		Элементы.СтратегияКонтекстноеМенюДобавитьСтроку.Видимость = ложь;
		Элементы.СтратегияКонтекстноеМенюДобавитьПодчиненнуюСтроку.Видимость = ложь;
		Элементы.СтратегияКонтекстноеМенюСдвинутьВверх.Видимость = ложь;
		Элементы.СтратегияКонтекстноеМенюСдвинутьВниз.Видимость = ложь;
		Элементы.СтратегияКонтекстноеМенюУдалить.Видимость = ложь;
	КонецЕсли;
	
	Элементы.ДекорацияЦель.Заголовок = Константы.ИА_ЦельКомпании.Получить();
	
	мДерево = РеквизитФормыВЗначение("СтратегияДерево");
	ИменаКолонокДерева = "";
	Для каждого Колонка Из мДерево.Колонки Цикл
		ИменаКолонокДерева = ИменаКолонокДерева + "," + Колонка.Имя;
	КонецЦикла;  
	
	ИменаКолонокДерева = Сред(ИменаКолонокДерева, 2);
	
	
	ТекущийПользователь = ПараметрыСеанса.ТекущийПользователь;
	
	ЗаполнитьТаблицуИндексов();
	ЗаполнитьСписокТиповЗадач();
	ЗаполнитьИерархиюСУ();
	
	//
	Лого = Константы.ИА_ЛоготипКомпании.Получить();
	Если ЗначениеЗаполнено(лого) ТОгда
		дд = лого.Получить();
		Если ЗначениеЗаполнено(дд) Тогда
			уид1 = Новый УникальныйИдентификатор;
			АдресКартинкиЛоготип = ПоместитьВоВременноеХранилище(дд,уид1);
		КонецЕсли;
	КонецЕсли;
	Элементы.ПолеЛоготип.Видимость = АдресКартинкиЛоготип<>"";
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокТиповЗадач()
	СписокТиповЗадач.Очистить();
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ИА_ТипыЗадачАдминШкалы.Ссылка
	|ИЗ
	|	Перечисление.ИА_ТипыЗадачАдминШкалы КАК ИА_ТипыЗадачАдминШкалы";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СписокТиповЗадач.Добавить(Выборка.Ссылка);
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ОбновитьДерево()	
	дер = ИА_Защита_Админшкала.ПолучитьДеревоСУ(Отбор_ТолькоПросроченные, Отбор_ТолькоРабочие, Отбор_ТолькоНезавершенные, Отбор_ЗадачиПоста, Отбор_ПрограммыПоста, Отбор_Архив, Отбор_ЗРС);
	ЗначениеВРеквизитФормы(Дер,"СтратегияДерево");
КонецПроцедуры

&НаКлиенте
Функция АктивизироватьСтроку(пСсылка, Строки) Экспорт
	Для каждого стр из Строки Цикл
		Если стр.Ссылка = пСсылка Тогда
			Элементы.стратегия.ТекущаяСтрока = стр.ПолучитьИдентификатор();
			Возврат истина;
		КонецЕсли;
		
		нашли = АктивизироватьСтроку(пСсылка, стр.ПолучитьЭлементы());
		Если нашли тогда
			Возврат истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
КонецФункции

&НаСервере
Процедура ЗаполнитьТаблицуИндексов()
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ИА_ТипыЭлементовСтратегическогоУправления.Ссылка КАК ТипЭлемента,
	|	ИА_ТипыЭлементовСтратегическогоУправления.Порядок КАК Индекс
	|ИЗ
	|	Перечисление.ИА_ТипыЭлементовСтратегическогоУправления КАК ИА_ТипыЭлементовСтратегическогоУправления";
	рез = Запрос.Выполнить().Выгрузить();
	ЗначениеВРеквизитФормы(рез,"ИндексыКартинки");
КонецПроцедуры


&НаСервере
Процедура ЗаполнитьИерархиюСУ()
	ИерархияСУ.Очистить();
	
	тз = ИА_АдминшкалаСервер.ПолучитьТаблицуИерархииСУ();
	Для каждого стр из тз Цикл
		Новстр = ИерархияСУ.Добавить();
		ЗаполнитьЗначенияСвойств(Новстр, стр);
		Новстр.ИмяПодчТипа = XMLстрока(стр.ПодчиненныйТип);
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура СоздатьЗадачуКЦ(Команда)
	тд = Элементы.Стратегия.ТекущиеДанные;
	Если тд.Срок < НачалоДня(ТекущаяДата()) Тогда
		ПоказатьПредупреждение(,"Неверно указан срок задачи!");
		Возврат;
	КонецЕсли;
	
	тд.Задача = ПолучитьЗадачуКЦ(тд.Ссылка, тд.Ответственный, тд.Содержание, тд.Срок);
	Если ЗначениеЗаполнено(тд.задача) Тогда
		Элементы.СтратегияСоздатьЗадачуКЦ.Доступность = ложь;
		тд.ЗадачаОтправлена = 0;
	КонецЕсли;
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьЗадачуКЦ(СсылкаСтратегии, Ответственный, Содержание, Срок)
	ОбСтратег = СсылкаСтратегии.Получитьобъект();
	ОбСтратег.Задача = ИА_АдминшкалаСервер.СоздатьЗадачуСервер(Ответственный,Содержание, Срок, Содержание, СсылкаСтратегии);
	ОбСтратег.Записать();
	Возврат ОбСтратег.Задача;
КонецФункции

&НаКлиенте
Процедура СтратегияПриИзменении(Элемент)
	тд = Элементы.Стратегия.ТекущиеДанные;
	Если тд = Неопределено Тогда
		возврат;
	КонецЕсли;
	
	Если СокрЛП(тд.Содержание) = "" Тогда
		Возврат;
	КонецЕсли;
	
	СтруктураСтрокаДерева = Новый Структура(ИменаКолонокДерева);
	ЗаполнитьЗначенияСвойств(СтруктураСтрокаДерева, ТД);
	
	РодительСтроки = ТД.ПолучитьРодителя();
	Если РодительСтроки <> Неопределено тогда
		СтруктураСтрокаДерева.Вставить("Родитель", РодительСтроки.Ссылка);
	Иначе
		СтруктураСтрокаДерева.Вставить("Родитель", ПредопределенноеЗначение("Справочник.ИА_СтратегическоеУправление.ПустаяСсылка"));
	КонецЕсли;
	ЗаписатьТекСтрокуБезКонтекста(СтруктураСтрокаДерева);
	ТД.Ссылка = СтруктураСтрокаДерева.Ссылка;
	
	ПересчитатьИтогиНаКлиенте(ТД)
КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьИтогиНаКлиенте(ТекСтрока)
	Если ТекСтрока.ТипЭлемента = ПредопределенноеЗначение("Перечисление.ИА_ТипыЭлементовСтратегическогоУправления.Задача") Тогда
		
		Если    ТекСтрока.ТипЗадачи = ПредопределенноеЗначение("Перечисление.ИА_ТипыЗадачАдминШкалы.Рабочая")
			ИЛИ ТекСтрока.ТипЗадачи = ПредопределенноеЗначение("Перечисление.ИА_ТипыЗадачАдминШкалы.Производственная")
			Тогда
			ТекДата = НачалоДня(ТекущаяДата());
			ТекСтрока.ЗадачВсего = 1;
			Если ЗначениеЗаполнено(ТекСтрока.Срок) И ТекСтрока.Срок < ТекДата Тогда
				ТекСтрока.ЗадачПросрочено = 1;
			Иначе
				ТекСтрока.ЗадачПросрочено = 0;
			КонецЕсли; 
			
			ТекСтрока.ЗадачВыполнено = ?(ТекСтрока.Выполнено, 1, 0);
			
			ОбновитьИтогиВВетке(ТекСтрока);
		КонецЕсли; 
	Иначе
		ОбновитьДеревоССохранениемСостояния();
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьИтогиВВетке(СтрокаДерева)
	РодительСтроки = СтрокаДерева.ПолучитьРодителя();
	Пока РодительСтроки <> Неопределено Цикл
		Итоги = Новый Структура("ЗадачВсего, ЗадачПросрочено, ЗадачВыполнено, ПроцентВыполнения", 0, 0, 0, 0);
		Ветки = РодительСтроки.ПолучитьЭлементы();
		Для каждого Стр Из Ветки Цикл
			Итоги.ЗадачВсего        = Итоги.ЗадачВсего      + Стр.ЗадачВсего;
			Итоги.ЗадачВыполнено    = Итоги.ЗадачВыполнено  + Стр.ЗадачВыполнено;
			Итоги.ЗадачПросрочено   = Итоги.ЗадачПросрочено + Стр.ЗадачПросрочено;
		КонецЦикла;  
		Итоги.ПроцентВыполнения = ?(Итоги.ЗадачВсего = 0, 0, 100 * Итоги.ЗадачВыполнено / Итоги.ЗадачВсего);
		ЗаполнитьЗначенияСвойств(РодительСтроки, Итоги);
		
		РодительСтроки = РодительСтроки.ПолучитьРодителя();
	КонецЦикла; 
КонецПроцедуры



&НаСервереБезКонтекста
Процедура ЗаписатьТекСтрокуБезКонтекста(СтруктураСтрокаДерева)
	пСтрока	= СтруктураСтрокаДерева;
	
	Если пСтрока.Ссылка.Пустая() Тогда
		обСтратег = Справочники.ИА_СтратегическоеУправление.СоздатьЭлемент();
	Иначе
		обСтратег = пСтрока.Ссылка.ПолучитьОбъект();
	КонецЕсли;
	
	
	ЗаполнитьЗначенияСвойств(обСтратег, пСтрока,,"Ссылка");
	обСтратег.Наименование = Лев(СокрЛП(пСтрока.Содержание),50);
	Если обСтратег.Автор.Пустая() Тогда
		обСтратег.Автор = ПараметрыСеанса.ТекущийПользователь;
	КонецЕсли;
	
	// порядок
	Если пСтрока.Ссылка.Пустая() Тогда
		Если СтруктураСтрокаДерева.Свойство("СледЭлем") И СтруктураСтрокаДерева.СледЭлем<>Неопределено Тогда// надо вставить строку на место след элем
			обСтратег.Порядок = СтруктураСтрокаДерева.СледЭлем.Порядок;	
			
			Запрос = Новый Запрос;
			Запрос.Текст = "ВЫБРАТЬ
			               |	ИА_СтратегическоеУправление.Ссылка,
			               |	ИА_СтратегическоеУправление.Порядок
			               |ИЗ
			               |	Справочник.ИА_СтратегическоеУправление КАК ИА_СтратегическоеУправление
			               |ГДЕ
			               |	ИА_СтратегическоеУправление.Родитель = &Родитель
			               |	И ИА_СтратегическоеУправление.ПометкаУдаления = ЛОЖЬ
			               |	И (НЕ ИА_СтратегическоеУправление.ЭтоКоррекция
			               |			ИЛИ ИА_СтратегическоеУправление.Коррекция_Добавление)
			               |	И ИА_СтратегическоеУправление.Порядок >= &Порядок";
			Запрос.УстановитьПараметр("Родитель", обСтратег.Родитель);
			Запрос.УстановитьПараметр("Порядок", обСтратег.Порядок);
			Выборка = Запрос.Выполнить().Выбрать();
			
			Если Выборка.Следующий() Тогда
				ТекОБ = Выборка.Ссылка.ПолучитьОбъект();
				ТекОБ.Порядок = ТекОБ.Порядок + 1;	
				ТекОБ.Записать();
			КонецЕсли;

		Иначе
			Запрос = Новый Запрос;
			Запрос.Текст = "ВЫБРАТЬ
			|	МАКСИМУМ(ИА_СтратегическоеУправление.Порядок) КАК Порядок
			|ИЗ
			|	Справочник.ИА_СтратегическоеУправление КАК ИА_СтратегическоеУправление
			|ГДЕ
			|	ИА_СтратегическоеУправление.Родитель = &Родитель
			|	И ИА_СтратегическоеУправление.ПометкаУдаления = ЛОЖЬ
			|	И (НЕ ИА_СтратегическоеУправление.ЭтоКоррекция
			|			ИЛИ ИА_СтратегическоеУправление.Коррекция_Добавление)";
			Запрос.УстановитьПараметр("Родитель", обСтратег.Родитель);
			Выборка = Запрос.Выполнить().Выбрать();
			
			Если Выборка.Следующий() и Выборка.Порядок<>NULL Тогда
				обСтратег.Порядок = Выборка.Порядок + 1;	
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	//
	
	обСтратег.Записать();
	
	пСтрока.Ссылка = обСтратег.Ссылка;
КонецПроцедуры 


&НаСервере
Процедура ЗаписатьТекСтроку(идСтроки)
	
	пСтрока = СтратегияДерево.НайтиПоИдентификатору(идСтроки);
	СтруктураСтрокаДерева = Новый Структура(ИменаКолонокДерева);
	ЗаполнитьЗначенияСвойств(СтруктураСтрокаДерева, пСтрока);
	
	РодительСтроки = пСтрока.ПолучитьРодителя();
	Если РодительСтроки <> Неопределено тогда
		СтруктураСтрокаДерева.Вставить("Родитель", РодительСтроки.Ссылка);
	Иначе
		СтруктураСтрокаДерева.Вставить("Родитель", ПредопределенноеЗначение("Справочник.ИА_СтратегическоеУправление.ПустаяСсылка"));
	КонецЕсли;
	
	//
	Если РодительСтроки = Неопределено Тогда
		РодительСтроки = СтратегияДерево;
	КонецЕсли;
	ТекИнд = РодительСтроки.ПолучитьЭлементы().Индекс(пСтрока);
	СледЭлем = Неопределено;
	Если РодительСтроки.ПолучитьЭлементы().Количество()-1 > ТекИнд Тогда
		СледЭлем = РодительСтроки.ПолучитьЭлементы().Получить(ТекИнд+1).ссылка;
	КонецЕсли;
	СтруктураСтрокаДерева.Вставить("СледЭлем", СледЭлем);
	//
	ЗаписатьТекСтрокуБезКонтекста(СтруктураСтрокаДерева);
	пСтрока.Ссылка = СтруктураСтрокаДерева.Ссылка;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьДеревоССохранениемСостояния()
	СохранитьТекущееСостояниеДерева();
	//
	ОбновитьДерево();
	//
	ВосстановитьСостояниеДерева();
	
	ОбновитьДоступностьСоздатьВыполнитьЗадачу();
КонецПроцедуры

&НаКлиенте
Процедура СтратегияСодержаниеОткрытие(Элемент, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	тд = Элементы.Стратегия.ТекущиеДанные;
	тд.Содержание = Элемент.ТекстРедактирования;
	Если СокрЛП(тд.Содержание) = "" Тогда
		Возврат;
	КонецЕсли;
	//
	ЗаписатьТекСтроку(Элементы.Стратегия.ТекущаяСтрока);
	//
	парам = Новый Структура("Ключ", тд.Ссылка);
	ОткрытьФорму("Справочник.ИА_СтратегическоеУправление.ФормаОбъекта",парам,ЭтаФорма,,,,Новый ОписаниеОповещения("СтратегияСодержаниеОткрытиеЗавершение", ЭтаФорма),РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура СтратегияСодержаниеОткрытиеЗавершение(рез, дп) Экспорт
	ОбновитьДеревоССохранениемСостояния();
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьПодчиненнуюСтроку_Команда(Команда)
	ДобавитьСтрокуВДерево(истина);
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьСтрокуВДерево(Подчиненная)
	тд = Элементы.Стратегия.ТекущиеДанные;
	Если Подчиненная и тд = Неопределено Тогда
		возврат;
	КонецЕсли;
	
	Если Подчиненная Тогда
		Если не тд.правоРедактирования Тогда
			Сообщить("Вам запрещено редактирование!");
			Возврат;
		КонецЕсли;
		
		Если тд.ПолучитьРодителя()<>Неопределено И СокрЛП(тд.ПолучитьРодителя().Содержание)="" Тогда
			Сообщить("Укажите содержание текущей строки!");
			Возврат;
		КонецЕсли;
		ТипЭлементаРодителя = тд.ТипЭлемента;
	Иначе
		Если тд = Неопределено Тогда
			ТипЭлементаРодителя = ПредопределенноеЗначение("Перечисление.ИА_ТипыЭлементовСтратегическогоУправления.ПустаяСсылка");
		Иначе
			ТипЭлементаРодителя = тд.ТипРодителя;
		КонецЕсли;
	КонецЕсли;
	
	Отбор = Новый Структура("ТипЭлемента", ТипЭлементаРодителя);
	возмПодч = ИерархияСУ.НайтиСтроки(Отбор);
	
	ДобТип = Неопределено;
	Если возмПодч.количество() = 0 Тогда
		возврат;
	ИначеЕсли возмПодч.количество() = 1 Тогда
		ДобТип = возмПодч[0].ПодчиненныйТип;
	Иначе
		список = Новый СписокЗначений;
		Для каждого стр из возмПодч Цикл
			список.Добавить(стр.ПодчиненныйТип);
		КонецЦикла;
		
		ПоказатьВыборИзСписка(Новый ОписаниеОповещения("ДобавитьСтрокуВДеревоЗавершение", ЭтотОбъект, Новый Структура("Подчиненная, тд, ТипЭлементаРодителя", Подчиненная, тд, ТипЭлементаРодителя)), список);
		Возврат;
	КонецЕсли;
	
	
	ДобавитьСтрокуВДеревоФрагмент(ДобТип, Подчиненная, тд, ТипЭлементаРодителя);
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьСтрокуВДеревоЗавершение(ВыбранныйЭлемент, ДополнительныеПараметры) Экспорт
	
	Подчиненная = ДополнительныеПараметры.Подчиненная;
	тд = ДополнительныеПараметры.тд;
	ТипЭлементаРодителя = ДополнительныеПараметры.ТипЭлементаРодителя;
	
	
	ДобТип = ВыбранныйЭлемент;
	Если ДобТип = Неопределено Тогда
		возврат;
	Иначе
		ДобТип = ДобТип.Значение;
	КонецЕсли;
	
	ДобавитьСтрокуВДеревоФрагмент(ДобТип, Подчиненная, тд, ТипЭлементаРодителя);
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьСтрокуВДеревоФрагмент(Знач ДобТип, Знач Подчиненная, Знач тд, Знач ТипЭлементаРодителя)
	
	Перем ВыбТипЗадачи, Новстр, род, Родитель;
	
	ВыбТипЗадачи = Неопределено;
	Если ДобТип = ПредопределенноеЗначение("Перечисление.ИА_ТипыЭлементовСтратегическогоУправления.ТипЗадачи") Тогда
		ПоказатьВыборИзСписка(Новый ОписаниеОповещения("ДобавитьСтрокуВДеревоФрагментЗавершение", ЭтотОбъект, Новый Структура("ДобТип, Подчиненная, тд, ТипЭлементаРодителя", ДобТип, Подчиненная, тд, ТипЭлементаРодителя)), СписокТиповЗадач);
		Возврат;
	КонецЕсли;
	
	ДобавитьСтрокуВДеревоФрагментФрагмент(ВыбТипЗадачи, ДобТип, Подчиненная, тд, ТипЭлементаРодителя);
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьСтрокуВДеревоФрагментЗавершение(ВыбранныйЭлемент, ДополнительныеПараметры) Экспорт
	
	ДобТип = ДополнительныеПараметры.ДобТип;
	Подчиненная = ДополнительныеПараметры.Подчиненная;
	тд = ДополнительныеПараметры.тд;
	ТипЭлементаРодителя = ДополнительныеПараметры.ТипЭлементаРодителя;
	
	
	ВыбТипЗадачи = ВыбранныйЭлемент;
	Если ВыбТипЗадачи = Неопределено Тогда
		возврат;
	Иначе
		ВыбТипЗадачи = ВыбТипЗадачи.Значение;
		//-> Григорьева
		Родитель = ?(Подчиненная, тд.Ссылка, СтратегияДерево.НайтиПоИдентификатору(тд.ПолучитьИдентификатор()).ПолучитьРодителя().Ссылка);
		Если ТипЗадачиСуществует(ВыбТипЗадачи, Родитель) Тогда
			ИА_КСУОбщийКлиентСервер.СообщитьПользователю("Тип задачи """ + ВыбТипЗадачи + """ уже используется в рамках текущей программы.");
			Возврат;
		КонецЕсли; 
		//<- Григорьева
	КонецЕсли;
	
	ДобавитьСтрокуВДеревоФрагментФрагмент(ВыбТипЗадачи, ДобТип, Подчиненная, тд, ТипЭлементаРодителя);
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьСтрокуВДеревоФрагментФрагмент(Знач ВыбТипЗадачи, Знач ДобТип, Знач Подчиненная, Знач тд, Знач ТипЭлементаРодителя)
	
	Перем Новстр, род;
	
	Если Подчиненная Тогда
		Новстр = СтратегияДерево.НайтиПоИдентификатору(тд.ПолучитьИдентификатор()).ПолучитьЭлементы().Добавить();
	Иначе
		Если тд = Неопределено Тогда
			Новстр = СтратегияДерево.ПолучитьЭлементы().Добавить();
		Иначе
			род = СтратегияДерево.НайтиПоИдентификатору(тд.ПолучитьИдентификатор()).ПолучитьРодителя();
			Если род = Неопределено Тогда
				Новстр = СтратегияДерево.ПолучитьЭлементы().Добавить();
			Иначе
				родЭлем = СтратегияДерево.НайтиПоИдентификатору(тд.ПолучитьИдентификатор()).ПолучитьРодителя().ПолучитьЭлементы();
				Новстр = родЭлем.Добавить();
				
				ТекИнд = родЭлем.Индекс(тд);
				родЭлем.Сдвинуть(родЭлем.Количество()-1,-(родЭлем.Количество() - ТекИнд - 2)); 
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	Новстр.ТипЭлемента = ДобТип;
	Новстр.ТипРодителя = ТипЭлементаРодителя;
	Новстр.ИндексКартинки = ПолучитьИндексКартинки(ДобТип);
	Новстр.ЗадачаОтправлена = 2;
	Новстр.Содержание = "<...>";
	Новстр.ПравоРедактирования = истина;
	Новстр.ПравоПросмотра = истина;
	
	Если ВыбТипЗадачи<>Неопределено Тогда
		Новстр.ТипЗадачи = ВыбТипЗадачи;
		Новстр.Содержание = ВыбТипЗадачи;
	КонецЕсли;
	
	ТекИД = Новстр.ПолучитьИдентификатор();
	ЗаписатьТекСтроку(ТекИД);
	Элементы.Стратегия.ТекущаяСтрока = ТекИД;
	
КонецПроцедуры

&НаКлиенте
Функция ПолучитьИндексКартинки(пТип)
	Отбор = новый Структура("ТипЭлемента", пТип);
	рез = ИндексыКартинки.НайтиСтроки(Отбор);
	Возврат рез[0].Индекс;
КонецФункции

&НаКлиенте
Процедура СтратегияПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	Отказ = Истина;
	ДобавитьСтрокуВДерево(Ложь);
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьСтроку(Команда)
	ДобавитьСтрокуВДерево(Ложь);
КонецПроцедуры

&НаКлиенте
Процедура СтратегияПередУдалением(Элемент, Отказ)
	тд = Элементы.Стратегия.ТекущиеДанные;
	
	Если (не тд.ПравоРедактирования) или тд.ЭтоАрхив Тогда
		отказ = Истина;
		Возврат;
	КонецЕсли;
	
	ПоказатьВопрос(Новый ОписаниеОповещения("СтратегияПередУдалениемЗавершение", ЭтотОбъект, Новый Структура("тд", тд)), "Вы уверены?", РежимДиалогаВопрос.ДаНет);
	Отказ = Истина;
	
КонецПроцедуры

