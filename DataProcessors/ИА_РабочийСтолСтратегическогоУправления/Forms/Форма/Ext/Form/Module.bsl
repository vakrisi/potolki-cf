	тд = Элементы.Стратегия.ТекущиеДанные;
	Если тд = Неопределено Тогда
		возврат;
	КонецЕсли;
	
	Если тд.ТипЭлемента = ПредопределенноеЗначение("Перечисление.ИА_ТипыЭлементовСтратегическогоУправления.Программа") Тогда
		Программа = тд.Ссылка;
	Иначе
		Программа = ИА_АдминшкалаСервер.ПолучитьПрограммуЗадачи(тд.Ссылка);
	КонецЕсли;
	
	Если не ЗначениеЗаполнено(Программа) Тогда
		возврат;
	КонецЕсли;
	
	Коррекции = ПолучитьКоррекци(Программа);
	Если Коррекции.Количество() = 0 Тогда
		ПоказатьПредупреждение(,"В данной программе нет коррекций");
		Возврат;
	КонецЕсли;
	
	
	Отв = ИА_АдминшкалаСервер.ПолучитьОтветственногоПрограммы(Программа);
	Если отв.Пустая() Тогда
		Сообщить("В программе не указан ответственный за задачи! ЗРС не отправлена!");
		Возврат;
	КонецЕсли;
	
	НаименованиеПрограммы = ИА_АдминшкалаСервер.ПолучитьНаименованиеПрограммы(Программа);
	НаименованиеПрограммы = СтрЗаменить(НаименованиеПрограммы,"<","&lt;");
	НаименованиеПрограммы = СтрЗаменить(НаименованиеПрограммы,">","&gt;");
	
	Тема = "Корректировка программы: "+НаименованиеПрограммы;
	
	Решение = ПолучитьРешениеЗРСКоррекции(Коррекции);	
	//
	форм = ПолучитьФорму("Задача.ИА_ЗадачаПланаДействий.ФормаОбъекта",Новый структура("ЭтоЗРС",истина));
	форм.ЭтоЗРС = истина;
	форм.Объект.ЭтоЗРС = истина;
	форм.Объект.Наименование = Тема;
	форм.Объект.Пост = Отв;	
	форм.Объект.Пользователь = ИА_ОбщиеПроцедурыКЦиОргсхема.ПолучитьПользователяНаПосту(Отв);
	форм.Объект.Содержание = Решение;
	//форм.ПеречитатьПоляФД();
	
	форм.Объект.ЭтоКоррекцияСУ = истина;
	форм.Объект.ПрикрепленныйОбъект = Программа;
	форм.Записать();
	
	ПрописатьЗРС_В_Коррекции(Коррекции, форм.Объект.Ссылка);
	ОбновитьДеревоССохранениемСостояния();
	
	форм.Открыть();
КонецПроцедуры

