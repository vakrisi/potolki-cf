&НаСервере
Функция ПечатьПрограммы_Сервер()
	ТабДокПечать = новый ТабличныйДокумент;
	
	СтрПрограмма = СтратегияДерево.НайтиПоИдентификатору(Элементы.Стратегия.ТекущаяСтрока);
	//СтрПрограмма = Элементы.Стратегия.ТекущиеДанные;  
	
	//ТабДокПечать = Новый ТабличныйДокумент;
	//Макет = Обработки.ИА_РабочийСтолСтратегическогоУправления.ПолучитьМакет("Программа");
	ОбъектМакет = РеквизитФормыВЗначение("Объект"); 
	Макет = ОбъектМакет.ПолучитьМакет("Программа");
	ТабДокПечать.Очистить(); 
	ТабДокПечать.НачатьАвтогруппировкуСтрок();  
	ОблШапка   = Макет.ПолучитьОбласть("Шапка");
	Раздел     = Макет.ПолучитьОбласть("Раздел");
	Задача     = Макет.ПолучитьОбласть("Задача");
	Задача1    = Макет.ПолучитьОбласть("Задача1");
	Задача2    = Макет.ПолучитьОбласть("Задача2");
	Задача3    = Макет.ПолучитьОбласть("Задача3");
	Задача4    = Макет.ПолучитьОбласть("Задача4");
	Задача5    = Макет.ПолучитьОбласть("Задача5");
	ЗадачаВРазделе    = Макет.ПолучитьОбласть("ЗадачаВРазделе");
	ОблШапка.Параметры.Наименование = СтрПрограмма.Содержание;
	ТабДокПечать.Вывести(ОблШапка, 1);
	
	Для каждого стрТип из СтрПрограмма.ПолучитьЭлементы() Цикл
		ОблСтрока = Макет.ПолучитьОбласть("ТипЗадачи");
		ОблСтрока.Параметры.Заполнить(стрТип);
		ТабДокПечать.Вывести(ОблСтрока, 2);
		
		// разделы и задачи
		Для каждого стрЗадачаРаздел из стрТип.ПолучитьЭлементы() Цикл
			// раздел
			Если стрЗадачаРаздел.ТипЭлемента = Перечисления.ИА_ТипыЭлементовСтратегическогоУправления.Раздел Тогда
				ОблСтрока = Раздел; ОблСтрока.Параметры.Заполнить(стрЗадачаРаздел);
				ТабДокПечать.Вывести(ОблСтрока, 3,,Истина);
				Для каждого стрЗадача из стрЗадачаРаздел.ПолучитьЭлементы() Цикл
					ОблСтрока = ЗадачаВРазделе;	ОблСтрока.Параметры.Заполнить(стрЗадача);
					ОблСтрока.Параметры.Ответственный = стрЗадача.Ответственный.Наименование;
					ТабДокПечать.Вывести(ОблСтрока, 4, ,Истина);
				КонецЦикла;
			Иначе    // задача	
				ОблСтрока = Задача;
				Если стрЗадачаРаздел.ТипЭлемента = Перечисления.ИА_ТипыЭлементовСтратегическогоУправления.Задача и
					стрЗадачаРаздел.Выполнено Тогда
					ОблСтрока = Задача2;
				КонецЕсли;	
				Если стрЗадачаРаздел.ТипЭлемента = Перечисления.ИА_ТипыЭлементовСтратегическогоУправления.Задача и
					стрЗадачаРаздел.ЗадачПросрочено Тогда
					ОблСтрока = Задача1; 
				КонецЕсли;	
				Если стрЗадачаРаздел.ЭтоАрхив Тогда
					ОблСтрока = Задача3; 
				КонецЕсли;
				Если стрЗадачаРаздел.ЭтоКоррекция Тогда
					ОблСтрока = Задача4;
				КонецЕсли;
				ОблСтрока.Параметры.Заполнить(стрЗадачаРаздел);
				ОблСтрока.Параметры.Ответственный = стрЗадачаРаздел.Ответственный.Наименование;
				ТабДокПечать.Вывести(ОблСтрока, 3,,Истина);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	ТабДокПечать.ЗакончитьАвтогруппировкуСтрок();
	ТабДокПечать.АвтоМасштаб = Истина;
	ТабДокПечать.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	ТабДокПечать.ОтображатьЗаголовки = Ложь;
	ТабДокПечать.ОтображатьСетку = Ложь;
	ТабДокПечать.ФиксацияСверху = 4;
	
	Возврат ТабДокПечать;
КонецФункции


