	Иначе
		Если ЗначениеЗаполнено(Отбор_ЗадачиПоста) или Отбор_ТолькоНезавершенные или Отбор_ТолькоПросроченные или Отбор_ТолькоРабочие Тогда
			ОбновитьДерево(); // все свернули
			ТекИд = -100;
			РазвернутьЗадачи(СтратегияДерево.ПолучитьЭлементы());
			Если ТекИд<>-100 Тогда
				Элементы.Стратегия.ТекущаяСтрока = ТекИд;
			КонецЕсли;
		Иначе
			ОбновитьДеревоССохранениемСостояния();
		КонецЕсли;
	КонецЕсли;
