Процедура СтратегияПередУдалениемЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	тд = ДополнительныеПараметры.тд;
	
	
	Если РезультатВопроса<>КодВозвратаДиалога.Да Тогда
		возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(тд.Ссылка) Тогда
		ТекРод = тд.ПолучитьРодителя();
		
		ПометитьНаУдаление(тд.Ссылка);	
		
		Если ТекРод<> Неопределено Тогда
			Элементы.Стратегия.ТекущаяСтрока = ТекРод.ПолучитьИдентификатор();
		КонецЕсли;
		
		ОбновитьДеревоССохранениемСостояния();
	КонецЕсли;
	
