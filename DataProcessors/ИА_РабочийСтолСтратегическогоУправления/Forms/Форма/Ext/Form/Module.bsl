Функция ТипЗадачиСуществует(ВыбТипЗадачи, Родитель)	//Григорьева
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ИА_СтратегическоеУправление.Ссылка
	|ИЗ
	|	Справочник.ИА_СтратегическоеУправление КАК ИА_СтратегическоеУправление
	|ГДЕ
	|	ИА_СтратегическоеУправление.Родитель = &Родитель
	|	И НЕ ИА_СтратегическоеУправление.ПометкаУдаления
	|	И ИА_СтратегическоеУправление.ТипЭлемента = ЗНАЧЕНИЕ(Перечисление.ИА_ТипыЭлементовСтратегическогоУправления.ТипЗадачи)
	|	И НЕ ИА_СтратегическоеУправление.НеПоказыватьНаРабочемСтоле
	|	И ИА_СтратегическоеУправление.ТипЗадачи = &ТипЗадачи";
	
	Запрос.УстановитьПараметр("Родитель", Родитель);
	Запрос.УстановитьПараметр("ТипЗадачи", ВыбТипЗадачи);
	
	Возврат Не Запрос.Выполнить().Пустой();
	
КонецФункции

