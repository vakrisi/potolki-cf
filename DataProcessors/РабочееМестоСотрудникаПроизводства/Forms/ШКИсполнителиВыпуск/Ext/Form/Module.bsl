
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ИспользоватьПодключаемоеОборудование = Константы.ИспользоватьПодключаемоеОборудование.Получить();

	Заказ = Параметры.ЗаказНаПроизводство;
	Для каждого СтрокаТЧ из Заказ.материалы Цикл
		ЗаполнитьЗначенияСвойств(Материалы.Добавить(), СтрокаТЧ);	
	КонецЦикла;
	
	Параметры.Свойство("ПредставлениеПродукции", ПредставлениеПродукции);
	
	//#15805
	Элементы.ИзменитьКоличество.Видимость = ОбщийМодульСервер.НастройкаПользователя("РазрешитьИзменениеКоличестваПриВыпускеВРМСотрудникаПроизводства");
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	МенеджерОборудованияКлиентПереопределяемый.НачатьПодключениеОборудованиеПриОткрытииФормы(ЭтаФорма, "СканерШтрихкода");
	
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)
	
	МенеджерОборудованияКлиентПереопределяемый.НачатьОтключениеОборудованиеПриЗакрытииФормы(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если Источник = "ПодключаемоеОборудование" И ВводДоступен() Тогда 
		Если ИмяСобытия = "ScanData" Тогда
			ОчиститьСообщения();
			ОбработатьШтрихкоды(МенеджерОборудованияПотолкиКлиент.ПреобразоватьДанныеСоСканераВСтруктуру(Параметр));
		КонецЕсли;	
	КонецЕсли; 
		
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Выпуск(Команда)
	
	ВыпускКлиент(Команда.Имя);	
	
КонецПроцедуры

&НаКлиенте
Процедура ВыпускКлиент(ИмяКоманды)
	
	ПараметрыЗаказа = ПолучитьПараметрыЗаказаНаСервере(Заказ);
	
	Если ИмяКоманды = "Выпуск" Тогда
		
	ИначеЕсли ИмяКоманды = "ВыпускИзОстатков" Тогда
		ПараметрыЗаказа.Вставить("ВыпускИзОстатков", Истина);
	ИначеЕсли ИмяКоманды = "ВыпускИзМатериаловЗаказчика" Тогда
		ПараметрыЗаказа.Вставить("ВыпускИзМатериаловЗаказчика", Истина);
	КонецЕсли;
	
	Если МатериалыИзменены Тогда
		ПараметрыЗаказа.Вставить("Материалы", ТаблицаМатериалов());		
	КонецЕсли;
	
	//++ #14923
	//ОбщийМодульКлиент.ПеревестиЗаказНаПроизводствоВСтатусПроизведен(Заказ, ПараметрыЗаказа, Истина);	
	ПараметрыВыполнения = Новый Структура;
	ПараметрыВыполнения.Вставить("ЗначениеЗаполнения", ПараметрыЗаказа);
	ПараметрыВыполнения.Вставить("ОписаниеОшибки", "");
	
	СозданиеНаОснованииПотолкиКлиент.ВыпускПродукцииСоздатьНаОснованииЗаказаНаПроизводство(Заказ, ПараметрыВыполнения);
	//-- #14923
	
	Если ЗначениеЗаполнено(ПараметрыВыполнения.ОписаниеОшибки) Тогда
		Закрыть(ПараметрыВыполнения.ОписаниеОшибки);
	Иначе	
		Закрыть(Истина);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ЗаменитьМатериал(Команда)
	
	ТекущиеДанные = Элементы.Материалы.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПредыдущийМатериал = ТекущиеДанные.Номенклатура;
	
	ПараметрыФормы = Новый Структура("ТекущаяСтрока", ТекущиеДанные.Номенклатура);
	ДополнительныеПараметры = Новый Структура("ИдентификаторСтроки", ТекущиеДанные.ПолучитьИдентификатор());
	ОписаниеОповещения = Новый ОписаниеОповещения("ЗаменитьМатериалФрагмент", ЭтотОбъект, ДополнительныеПараметры);
	ОткрытьФорму("Справочник.Номенклатура.Форма.ФормаВыбораДляСотрудникаПроизводства", ПараметрыФормы,,,,, ОписаниеОповещения); 
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаменитьМатериалФрагмент(ВыбранноеЗначение, ДополнительныеПараметры) Экспорт
	
	Если ВыбранноеЗначение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	МатериалыИзменены = Истина;
	ТекущиеДанные = Элементы.Материалы.ТекущиеДанные;
	//ТекущаяСтрока = Материалы.НайтиПоИдентификатору(ДополнительныеПараметры.ИдентификаторСтроки);	
	ТекущиеДанные.Номенклатура = ВыбранноеЗначение;
	МатериалыНоменклатураПриИзменении(Неопределено);
	
	//ОписаниеОповещения = Новый ОписаниеОповещения("ЗаменитьМатериалЗавершение", ЭтотОбъект, ДополнительныеПараметры);
	//ПоказатьВводЧисла(ОписаниеОповещения, ТекущиеДанные.Количество, "Укажите количество", 15, 2);
	
	ИзменитьКоличествоМатериалаИнтерактивно(ТекущиеДанные);
	
КонецПроцедуры	

