&НаКлиенте
Процедура МатериалыНоменклатураПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.Материалы.ТекущиеДанные;
	ТекущиеДанные.ЕдиницаИзмерения = ОбщийМодульВызовСервера.ПолучитьЕдиницуИзмеренияДляПроизводства(ТекущиеДанные.Номенклатура);	
				
	Если ТипЗнч(ТекущиеДанные.ЕдиницаИзмерения) = Тип("СправочникСсылка.КлассификаторЕдиницИзмерения") Тогда
		ТекущиеДанные.Коэффициент = 1;
	ИначеЕсли ТипЗнч(ТекущиеДанные.ЕдиницаИзмерения) = Тип("СправочникСсылка.ЕдиницыИзмерений") Тогда
		ТекущиеДанные.Коэффициент = ОбщийМодульВызовСервера.ПолучитьКоэффициентЕдиницыИзмерения(ТекущиеДанные.ЕдиницаИзмерения);
	КонецЕсли;
	
	ПроверитьШиринуПолотнаНоменклатурыИОчиститьКоличествоПриРазличии(ТекущиеДанные.Количество, ТекущиеДанные.Номенклатура, ПредыдущийМатериал);
	
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьКоличество(Команда)
	
	ТекущиеДанные = Элементы.Материалы.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИзменитьКоличествоМатериалаИнтерактивно(ТекущиеДанные)
	
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьКоличествоМатериалаИнтерактивно(ТекущиеДанные)
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Заголовок", "Введите количество");
	ПараметрыФормы.Вставить("ЧислоВвода", ТекущиеДанные.Количество);
	ПараметрыФормы.Вставить("КоличествоСимволовПослеЗапятой", 3);
	
	ДополнительныеПараметры = Новый Структура("ИдентификаторСтроки", Элементы.Материалы.ТекущаяСтрока);
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ИзменитьКоличествоЗавершение", ЭтотОбъект, ДополнительныеПараметры);	
	ОткрытьФорму("Обработка.РабочееМестоСотрудникаПроизводства.Форма.ФормаВводаЧисла", ПараметрыФормы,,,,, ОписаниеОповещения);

КонецПроцедуры

&НаКлиенте
Процедура ИзменитьКоличествоЗавершение(РезультатОткрытияФормы, ДополнительныеПараметры) Экспорт
	
	СтрокаТабличнойЧасти = Материалы.НайтиПоИдентификатору(ДополнительныеПараметры.ИдентификаторСтроки);
	
	Если СтрокаТабличнойЧасти = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ РезультатОткрытияФормы = Неопределено Тогда
		СтрокаТабличнойЧасти.Количество = РезультатОткрытияФормы.ВведенноеЧисло;
		
		МатериалыИзменены = Истина;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ШтрихкодыИТорговоеОборудование

&НаКлиенте
Процедура ОбработатьШтрихкоды(Данные)
	
	ШК = Данные.Штрихкод; // Штрихкод[0].Штрихкод;
	
	Если ПустаяСтрока(ШК) Тогда
		ПоказатьПредупреждение(,"Штрих-код не распознан");
		Возврат;
	КонецЕсли;

	//#14336
	Если Лев(ШК, 12) = "000000000000" Тогда
		Закрыть();
		Возврат;
	ИначеЕсли Лев(ШК, 12) = "000000000001" Тогда
		ВыпускКлиент("Выпуск");
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервереБезКонтекста
Функция ПолучитьПараметрыЗаказаНаСервере(ЗаказНаПроизводство)
	
	ПараметрыЗаказа = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ЗаказНаПроизводство, "Номер, Дата, ТекущийСтатус");
	ПараметрыЗаказа.Вставить("Заказ", ЗаказНаПроизводство);
	Возврат ПараметрыЗаказа;
	
КонецФункции

&НаСервере
Процедура ПроверитьШиринуПолотнаНоменклатурыИОчиститьКоличествоПриРазличии(Количество, НовыйМатериал, ПредыдущийМатериал)
	
	Если Константы.ПриЗаменеПленкиВВыпускеПродукцииНаПленкуДругойШириныОчищатьКоличествоКСписанию.Получить() 
		И НовыйМатериал.ВидНоменклатуры = Справочники.ВидыНоменклатуры.Полотно
		И ПредыдущийМатериал.ВидНоменклатуры = Справочники.ВидыНоменклатуры.Полотно
		И НЕ ПредыдущийМатериал.ШиринаПолотна = НовыйМатериал.ШиринаПолотна
	Тогда	
		
		Количество = 0;
	
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ТаблицаМатериалов()
	
	Возврат ОбщегоНазначения.ТаблицаЗначенийВМассив(Материалы.Выгрузить());
	
КонецФункции

#КонецОбласти



