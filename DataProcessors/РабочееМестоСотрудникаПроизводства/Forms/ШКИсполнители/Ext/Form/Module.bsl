Процедура ЗаполнитьИсполнителейПоЗаказуНаПроизводство()
	
	Исполнители.Очистить();
	ИсполнителиПоОперациям.Очистить();
	
	Если ПоПроизводственнымОперациям Тогда
		Для Каждого ТекСтрока Из ЗаказНаПроизводство.ИсполнителиПоОперациям Цикл
			НоваяСтрока = ИсполнителиПоОперациям.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
		КонецЦикла;
	Иначе
		Для Каждого ТекСтрока Из ЗаказНаПроизводство.Исполнители Цикл
			НоваяСтрока = Исполнители.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

