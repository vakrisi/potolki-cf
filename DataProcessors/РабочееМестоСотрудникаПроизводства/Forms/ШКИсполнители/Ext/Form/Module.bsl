Функция ДобавитьИсполнителяВБригаднойСхеме()
	
	//сначала убедимся что такого исполнителя нет
	Для Каждого ТекСтрока Из Исполнители Цикл
		Если ТекСтрока.Сотрудник = Сотрудник Тогда
			Сотрудник = ПредопределенноеЗначение("Справочник.Сотрудники.ПустаяСсылка");
