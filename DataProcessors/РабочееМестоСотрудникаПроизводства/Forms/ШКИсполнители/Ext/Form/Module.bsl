&НаСервере
Функция ПолучитьЗаказНаПроизводство(Знач НомерРасчета)
	
	Запрос = новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЗаказНаПроизводство.Ссылка КАК Ссылка,
	|	ВЫБОР
	|		КОГДА ЗаказНаПроизводство.СпособНачисленияВыработки = Значение(Перечисление.СпособыНачисленияВыработки.ПроизводственныеОперации)
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ПоПроизводственнымОперациям
	|ИЗ
	|   Документ.ЗаказНаПроизводство КАК ЗаказНаПроизводство
	|ГДЕ
	|	ЗаказНаПроизводство.ПродукцияНомерРасчета ПОДОБНО &НомерРасчета
	|	И ЗаказНаПроизводство.ТекущийСтатус = Значение(Справочник.СтатусыЗаказовНаПроизводство.ВПроизводстве)
	|	И ЗаказНаПроизводство.Проведен
	|";
	Запрос.УстановитьПараметр("НомерРасчета", НомерРасчета);
	Выборка = Запрос.Выполнить().Выбрать();

	Если Выборка.Следующий() Тогда
		
		ПоПроизводственнымОперациям = Выборка.ПоПроизводственнымОперациям; // №14141
		
		Возврат Выборка.Ссылка;
				
	Иначе
		
		Возврат Документы.ЗаказНаПроизводство.ПустаяСсылка();
		
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Процедура НачалоПерезаполненияЗаказаНаПроизводствоПоОснованию(Результат, ДопПараметры) Экспорт
	
	//Если Результат = КодВозвратаДиалога.Да Тогда		
	Если Результат = Истина Тогда
			
		СтруктураПотолка = ПолучитьПотолокЗаказаНаПроизводство(ДопПараметры.ЗаказНаПроизводство);		
		СтруктураВозврата = ОбновитьЗаказНаПроизводствоПоПотолкуПоЗаказуПокупателяНаСервере(ДопПараметры.ЗаказНаПроизводство, СтруктураПотолка.Потолок, ДопПараметры.ЗаказНаПроизводствоОснование, СтруктураПотолка.УИСтроки);	
		ЗаказНаПроизводство = СтруктураВозврата.ЗаказНаПроизводство;
		//ДобавитьВИсторию(СтруктураВозврата.ТекстСообщения);
		Если НЕ ПустаяСтрока(СтруктураВозврата.ТекстСообщения) Тогда
			ПоказатьПредупреждение(,СтруктураВозврата.ТекстСообщения);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ЗаказНаПроизводство) Тогда
			ВыборЗаказНаПроизводствоЗавершение(ЗаказНаПроизводство);
		КонецЕсли;
	КонецЕсли;
	
	//ОбновитьСостояние();

КонецПроцедуры

&НаСервереБезКонтекста
Функция ОбновитьЗаказНаПроизводствоПоПотолкуПоЗаказуПокупателяНаСервере(Знач СсылкаЗаказНаПроизводство, Знач Потолок, Знач ЗаказНаПроизводствоОснование, Знач УИСтроки)
	
	СтруктураВозврата = Новый Структура("ЗаказНаПроизводство, ТекстСообщения", Документы.ЗаказНаПроизводство.ПустаяСсылка(), "");
	
	УспешноПроведен = Ложь;
	//#14923 вызываем единую функцию перезаполнения ЗНП
	//ОбщийМодуль.ОбновитьЗаказНаПроизводствоПоПотолкуПоЗаказуПокупателя(СсылкаЗаказНаПроизводство, Потолок, ЗаказНаПроизводствоОснование, УспешноПроведен, УИСтроки);
	ОбщийМодуль.ОбновитьЗаказНаПроизводствоПоЗаказуПокупателя(СсылкаЗаказНаПроизводство, , УспешноПроведен);
	Если УспешноПроведен Тогда
		//Сообщить("Заказ на производство перезаполнен");		
		СтруктураВозврата.ЗаказНаПроизводство = СсылкаЗаказНаПроизводство;
		СтруктураВозврата.ТекстСообщения = "Заказ на производство перезаполнен";
	Иначе	
		//Сообщить("Заказ на производство " + СсылкаЗаказНаПроизводство + " не был успешно перезаполнен. Выбор отменен.");
		СтруктураВозврата.ТекстСообщения = "Заказ на производство " + СсылкаЗаказНаПроизводство + " не был успешно перезаполнен. Выбор отменен.";
	КонецЕсли;
	
	Возврат СтруктураВозврата;
	
КонецФункции	

&НаСервере
Функция ПолучитьПотолокЗаказаНаПроизводство(СсылкаНаЗаказНаПроизводство)
	
	СтруктураОтвета = Новый Структура;
	СтруктураОтвета.Вставить("Потолок",Справочники.Номенклатура.ПустаяСсылка());
	СтруктураОтвета.Вставить("УИСтроки","");
	
	Если СсылкаНаЗаказНаПроизводство.ВидЗаказа = Перечисления.ВидыЗаказовНаПроизводство.ПроизводствоПотолка Тогда
		
		СтруктураОтвета.Вставить("Потолок",СсылкаНаЗаказНаПроизводство.ПродукцияНоменклатура);
		СтруктураОтвета.Вставить("УИСтроки",СсылкаНаЗаказНаПроизводство.ПродукцияУИСтроки);

	КонецЕсли;
	
	Возврат СтруктураОтвета;
	
КонецФункции

&НаСервере
Функция ОснованиемЗаказаНаПроизводствоЯвляетсяЗаказПокупателя(СсылкаНаЗаказНаПроизводство)
	
	Если ТипЗнч(СсылкаНаЗаказНаПроизводство) = Тип("ДокументСсылка.ЗаказНаПроизводство") 
		И ТипЗнч(СсылкаНаЗаказНаПроизводство.ДокументОснование) = Тип("ДокументСсылка.ЗаказПокупателя")
		И НЕ СсылкаНаЗаказНаПроизводство.ДокументОснование.Пустая() Тогда
		Возврат Истина;
	КонецЕсли;
	
	Возврат Ложь;
			
КонецФункции

&НаСервере
Процедура СохранитьНастройкиФормы()

	ПользовательскийОтбор = Новый ОтборКомпоновкиДанных();
	
	ОбщийМодульСервер.НовыйОтбор(ПользовательскийОтбор, "ТекущийСтатус", ЗаказОтборПоТекущемуСтатусу); 
	ОбщийМодульСервер.НовыйОтбор(ПользовательскийОтбор, "Цех", ЗаказОтборПоЦеху);
	ОбщийМодульСервер.НовыйОтбор(ПользовательскийОтбор, "СкладМатериалов", ЗаказОтборПоСкладуМатериалов); //nva
	
	СтруктураНастроек = Новый Структура;	
	СтруктураНастроек.Вставить("НастройкиОтбораЗНП",  Новый ХранилищеЗначения(ПользовательскийОтбор));
	
	ОбщегоНазначения.ХранилищеОбщихНастроекСохранить("РабочееМестоСотрудникаПроизводства", "НастройкиФормыСписка", СтруктураНастроек);
	
КонецПроцедуры

&НаСервере
Процедура ВосстановитьНастройкиФормы()

	СтруктураНастроек = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить("РабочееМестоСотрудникаПроизводства", "НастройкиФормыСписка");
	
	Если НЕ ТипЗнч(СтруктураНастроек) = Тип("Структура") Тогда
		Возврат;	
	КонецЕсли;
	
	ПользовательскийОтбор = СтруктураНастроек.НастройкиОтбораЗНП.Получить();	
	
	МассивРеквизитовСтатусыЗаказа = ПолучитьМассивРеквизитовСтатусыЗаказа(); 
	
	Для Каждого НастройкаОтбора Из ПользовательскийОтбор.Элементы Цикл
		
		Если НастройкаОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ТекущийСтатус") Тогда		
			Для Каждого ЭлементСписка Из НастройкаОтбора.ПравоеЗначение Цикл 				
				Если НЕ МассивРеквизитовСтатусыЗаказа.Найти(ЭлементСписка.Значение.ИмяПредопределенныхДанных) = Неопределено Тогда					
					ЗаказОтборПоТекущемуСтатусу.Добавить(ЭлементСписка.Значение);					
					Элементы["ОтборСтатусЗаказа" + ЭлементСписка.Значение.ИмяПредопределенныхДанных].Пометка = Истина;					
				КонецЕсли;				
			КонецЦикла;
		КонецЕсли;
		
		Если НастройкаОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Цех") Тогда		
			Для Каждого ЭлементСписка Из НастройкаОтбора.ПравоеЗначение Цикл				
				НайденныеСтроки = КомандыЦехов.НайтиСтроки(Новый Структура("Цех", ЭлементСписка.Значение));
				Если НайденныеСтроки.Количество() > 0 Тогда					
					ЗаказОтборПоЦеху.Добавить(ЭлементСписка.Значение);					
					Элементы[НайденныеСтроки[0].ИмяКоманды].Пометка = Истина;					
				КонецЕсли;				
			КонецЦикла;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры 

&НаСервере
Процедура ДобавитьКомандуИКнопкуОтбораПоЦеху(Цех, КодЦеха, Наименование, КраткоеПредставление)
	
	ИмяКоманды = "ОтборПоЦеху" + КодЦеха;
	ЗаголовокКоманды = ?(ПустаяСтрока(КраткоеПредставление), Наименование, КраткоеПредставление);
	КомандаФормы = Команды.Добавить(ИмяКоманды);
	//КомандаФормы.Подсказка = Подсказка; 
	КомандаФормы.Заголовок = ЗаголовокКоманды; 
	КомандаФормы.Отображение = ОтображениеКнопки.Текст;
	КомандаФормы.Действие = "ОтборПоЦехуНажатие";	
	
	ИмяРеквизита = ИмяКоманды;
	КнопкаФормы = Элементы.Добавить(ИмяРеквизита, Тип("КнопкаФормы"), Элементы.ГруппаЗаказОтборыЦех); 		
	КнопкаФормы.ИмяКоманды = ИмяКоманды;		
	КнопкаФормы.Вид = ВидКнопкиФормы.ОбычнаяКнопка;
	КнопкаФормы.Ширина = 15;
	КнопкаФормы.Высота = 4;
	
	
	НоваяСтрока = КомандыЦехов.Добавить();
	НоваяСтрока.Цех = Цех;
	НоваяСтрока.ИмяКоманды = ИмяКоманды;
	
КонецПроцедуры

&НаКлиенте
Процедура ИзОстатков(Команда)
	
	Если Команда.Имя = "ИзОстатков" Тогда
		Элемент = Элементы.Материалы;
	ИначеЕсли Команда.Имя = "ИзОстатков1" Тогда
		Элемент = Элементы.Материалы1;
	КонецЕсли;
	
	ТекущиеДанные = Элемент.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИдентификаторСтроки = Элемент.ТекущаяСтрока;	
	ДополнительныеПараметры = Новый Структура("ИдентификаторСтроки", ИдентификаторСтроки);
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ТекстВопроса", "ЗАМЕНИТЬ ПОЛОТНА НА ОСТАТОК?");
	ОписаниеОповещения = Новый ОписаниеОповещения("ЗаменитьНаОстаток", ЭтотОбъект, ДополнительныеПараметры);	
	ОткрытьФорму("Обработка.РабочееМестоСотрудникаПроизводства.Форма.ФормаВопроса", ПараметрыФормы,,,,, ОписаниеОповещения);
КонецПроцедуры

&НаКлиенте
Процедура ЗаменитьНаОстаток(РезультатОткрытияФормы, ДополнительныеПараметры) Экспорт
	Если РезультатОткрытияФормы = КодВозвратаДиалога.Да Тогда
        ЗаменитьНаМатериалЗаказчикаНаСервере(Истина, Истина);
	КонецЕсли;
	Если РезультатОткрытияФормы = КодВозвратаДиалога.Нет Тогда	
		ЗаменитьНаМатериалЗаказчикаНаСервере(Ложь, Истина);
    КонецЕсли;
КонецПроцедуры

