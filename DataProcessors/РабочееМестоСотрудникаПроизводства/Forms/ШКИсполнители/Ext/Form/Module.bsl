#КонецОбласти

#Область СлужебныеПроцедурыФункции

&НаКлиенте
Процедура УстановитьТекущийЭлемент()
	
	//ТекущийЭлемент = Элементы.ИмитацияШК;
		
	Если Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.ГруппаНачальнаяСтраница Тогда
		ТекущийЭлемент = Элементы.ИмитацияШК;
		
	ИначеЕсли Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.ГруппаПроизводственныеОперации Тогда
		ТекущийЭлемент = Элементы.ИмитацияШК1;
		
	ИначеЕсли Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.ГруппаСотрудник Тогда
		ТекущийЭлемент = Элементы.ИмитацияШК2;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьВсеПоляНаФорме()
	
	НоменклатураПродукции = ПредопределенноеЗначение("Справочник.Номенклатура.ПустаяСсылка");
	ПредставлениеПродукции = "";
	ЗаказНаПроизводство 			= ПредопределенноеЗначение("Документ.ЗаказНаПроизводство.ПустаяСсылка");
	ПроизводственнаяОперация 		= ПредопределенноеЗначение("Справочник.ПроизводственныеОперации.ПустаяСсылка");
	Сотрудник 						= ПредопределенноеЗначение("Справочник.Сотрудники.ПустаяСсылка");
	
	Исполнители.Очистить();
	ИсполнителиПоОперациям.Очистить();
	
	Материалы.Очистить();
	
	//ОбновитьСостояние();
	Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.ГруппаНачальнаяСтраница;
	
КонецПроцедуры

&НаКлиенте	
Процедура ВыборЗаказНаПроизводствоЗавершение(СсылкаНаЗаказНаПроизводство)

	ЗаказНаПроизводство = СсылкаНаЗаказНаПроизводство;
	ПолучитьНоменклатуруПродукцииИзЗаказаНаПроизводство(ЗаказНаПроизводство, НоменклатураПродукции, ПредставлениеПродукции);
	ЗаполнитьИсполнителейПоЗаказуНаПроизводство();
	ЗаполнитьМатериалыПоЗаказуНаПроизводство(); //#16317
	//ОбновитьСостояние();
	
	Если ПоПроизводственнымОперациям Тогда
		Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.ГруппаПроизводственныеОперации;
		Элементы.ОК.КнопкаПоУмолчанию = Истина;
	Иначе
		Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.ГруппаСотрудник;
		Элементы.ОК1.КнопкаПоУмолчанию = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ЭтоРаботникПроизводства(Сотрудник)

	ЭтоРаботникПроизводства = ОбщийМодульВызовСервера.ЗначениеРеквизитаОбъекта(Сотрудник, "РаботникПроизводства");
	Если НЕ ЭтоРаботникПроизводства = Истина Тогда
		ТекстОшибки = "Данный сотрудник не является работником производства.
					|При необходимости установите соответствующий признак в карточке сотрудника";
		ПоказатьПредупреждение(, ТекстОшибки);
		Возврат Ложь;	
	КонецЕсли;
	
	Возврат Истина;
			
КонецФункции

&НаКлиенте
Процедура ВыполненЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если НЕ Результат = Неопределено Тогда
		Если ПроверитьЗаказНаПроизводствоПереведенВСтатусПроизведен(ЗаказНаПроизводство) Тогда
			//ДобавитьВИсторию("" + ЗаказНаПроизводство + " переведен в статус ""Произведен"".");
			ТекстСообщения = "" + ЗаказНаПроизводство + Символы.ПС + "с продукцией: " + НоменклатураПродукции + Символы.ПС + "переведен в статус ""ПРОИЗВЕДЕН""";
			//ПоказатьПредупреждение(, ТекстСообщения);
			ОткрытьФорму("ОбщаяФорма.ФормаПредупреждения", Новый Структура("ЗаголовокИнформации, ТекстИнформации, Состояние", "Успешная обработка", ТекстСообщения, "Успешно"));
			ОчиститьВсеПоляНаФорме();
		Иначе
			//ДобавитьВИсторию("При переводе " + ЗаказНаПроизводство + " в статус ""Произведен"" возникли ошибки, поля очищены не будут.");	
			ТекстСообщения = СтрШаблон("При переводе %1
								|в статус ""ПРОИЗВЕДЕН""
								|возникли ошибки: %2", 
										ЗаказНаПроизводство, 
										?(ТипЗнч(Результат) = Тип("Строка"), Символы.ПС + Результат, ""));
										
			//ПоказатьПредупреждение(,ТекстСообщения);							
			ОткрытьФорму("ОбщаяФорма.ФормаПредупреждения", Новый Структура("ЗаголовокИнформации, ТекстИнформации, Состояние", "Ошибка", ТекстСообщения, "Ошибка"));			
			
			ОчиститьВсеПоляНаФорме();
		КонецЕсли;	
		Оповестить("ОбновитьАРМПроизводства",,"ЗаказНаПроизводство");
	КонецЕсли;
	
	ПодключитьОбработчикОжидания("УстановитьТекущийЭлемент", 0.1, Истина);
	
КонецПроцедуры

&НаСервере
Функция ПроверитьЗаказНаПроизводствоПереведенВСтатусПроизведен(ЗаказНаПроизводство) Экспорт
	
	ТекущийСтатусЗнП = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЗаказНаПроизводство, "ТекущийСтатус");
	Возврат ТекущийСтатусЗнП = Справочники.СтатусыЗаказовНаПроизводство.Произведен;
	
КонецФункции

&НаСервере
Функция ЗаполнитьЗаказНаПроизводствоНаСервере()
	
	ТекстОшибки = "";	
	ДокументОбъект = ЗаказНаПроизводство.ПолучитьОбъект();
		
	Если ПоПроизводственнымОперациям Тогда		
		
		ДокументОбъект.ИсполнителиПоОперациям.Очистить();
		Для Каждого ТекущаяСтрока Из ИсполнителиПоОперациям Цикл
			НоваяСтрока = ДокументОбъект.ИсполнителиПоОперациям.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущаяСтрока);
			Если НЕ НоваяСтрока.Сотрудник1.Пустая() Тогда
				НоваяСтрока.Коэффициент1 = 1;
			КонецЕсли;
			Если НЕ НоваяСтрока.Сотрудник2.Пустая() Тогда
				НоваяСтрока.Коэффициент2 = 1;
			КонецЕсли;
			Если НЕ НоваяСтрока.Сотрудник3.Пустая() Тогда
				НоваяСтрока.Коэффициент3 = 1;
			КонецЕсли;
			Если НЕ НоваяСтрока.Сотрудник4.Пустая() Тогда
				НоваяСтрока.Коэффициент4 = 1;
			КонецЕсли;
		КонецЦикла;
		
	Иначе
		
		ДокументОбъект.Исполнители.Очистить();
		Для Каждого ТекущаяСтрока Из Исполнители Цикл
			НоваяСтрока = ДокументОбъект.Исполнители.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущаяСтрока);
			НоваяСтрока.Коэффициент = 1;
		КонецЦикла;
					
	КонецЕсли;
	
	//#16317
	Если МатериалыИзменены Тогда
		ДокументОбъект.Материалы.Загрузить(Материалы.Выгрузить());	
		ДокументОбъект.РучнаяКорректировкаМатериалов = Истина;
	КонецЕсли;
			
	Попытка
		ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
		Успешно = Истина;	
	Исключение
		//Сообщить("Не удалось записать документ при добавлении исполнителей: " + Символы.ПС + ОписаниеОшибки());
		//ДобавитьВИсторию("Не удалось записать документ при добавлении исполнителей: " + Символы.ПС + ОписаниеОшибки());
		ТекстОшибки = "Не удалось записать документ при добавлении исполнителей: " + Символы.ПС + ОписаниеОшибки();
		Успешно = Ложь;
	КонецПопытки;
	
	Возврат ТекстОшибки;
	
КонецФункции

