	ПараметрыФормы.Вставить("ТекстВопроса", "ЗАМЕНИТЬ ПОЛОТНА НА МАТЕРИАЛ ЗАКАЗЧИКА?");
	ОписаниеОповещения = Новый ОписаниеОповещения("ЗаменитьНаМатериалЗаказчика", ЭтотОбъект, ДополнительныеПараметры);	
	ОткрытьФорму("Обработка.РабочееМестоСотрудникаПроизводства.Форма.ФормаВопроса", ПараметрыФормы,,,,, ОписаниеОповещения);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаменитьНаМатериалЗаказчика(РезультатОткрытияФормы, ДополнительныеПараметры) Экспорт
	Если РезультатОткрытияФормы = КодВозвратаДиалога.Да Тогда
        ЗаменитьНаМатериалЗаказчикаНаСервере(Истина, Ложь);
	КонецЕсли;
	Если РезультатОткрытияФормы = КодВозвратаДиалога.Нет Тогда	
		ЗаменитьНаМатериалЗаказчикаНаСервере(Ложь, Ложь);
    КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ЗаменитьНаМатериалЗаказчикаНаСервере(Заменить, Остаток) 
	ОбщийМодульСервер.ИзменитьПолотнаВМатериалах(ЭтотОбъект, Заменить, Остаток);
	МатериалыИзменены = Истина;
КонецПроцедуры	

&НаКлиенте
Процедура ОтправитьВсеВложенныеФайлыНаПринтер(Команда)
	Если НЕ Элементы.СписокЗаказов.ТекущиеДанные.Ссылка = Неопределено Тогда
		РаспечатаноВыполнитьСписок(Истина); 
		Элементы.СписокЗаказов.Обновить();
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура РаспечатаноВыполнитьСписок(ЗначенияПризнака)
	
	ИмяТекущегоЭлемента = Элементы.СписокЗаказов.Имя;
	
	Если Не ВыборКорректен(ИмяТекущегоЭлемента) Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого ЗаказНаПроизводство Из Элементы[ИмяТекущегоЭлемента].ВыделенныеСтроки Цикл
		ОбщийМодульКлиент.ОтправитьВсеВложенныеФайлыЗаказаНаПроизводствоНаПринтер(ЗаказНаПроизводство, ЗаказНаПроизводство.УникальныйИдентификатор());	
	КонецЦикла;
	
	РаспечатаноВыполнитьСписокНаСервере(ЗначенияПризнака, ИмяТекущегоЭлемента);
		
КонецПроцедуры 

&НаКлиенте
Функция ВыборКорректен(ИмяСписка, ПоТекущейСтроке = Ложь)
	
	ТипГруппировка = Тип("СтрокаГруппировкиДинамическогоСписка");
	Если ПоТекущейСтроке Тогда
		
		Если ТипЗнч(Элементы[ИмяСписка].ТекущаяСтрока) <> ТипГруппировка И Элементы[ИмяСписка].ТекущиеДанные <> Неопределено Тогда
			Возврат Истина;
		КонецЕсли;
		
	Иначе
		
		Для Каждого Элемент Из Элементы[ИмяСписка].ВыделенныеСтроки Цикл
			Если ТипЗнч(Элемент) <> ТипГруппировка Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

&НаСервере
Процедура РаспечатаноВыполнитьСписокНаСервере(ЗначенияПризнака, ИмяТекущегоЭлемента)
	
	МассивЗаказовНаПроизводство = Новый Массив;

	Для Каждого ЗаказНаПроизводство Из Элементы[ИмяТекущегоЭлемента].ВыделенныеСтроки Цикл
		МассивЗаказовНаПроизводство.Добавить(ЗаказНаПроизводство);	
	КонецЦикла;
	
	УстановитьМеткуРаспечатано(МассивЗаказовНаПроизводство, Истина);
	
КонецПроцедуры 

&НаСервере
Процедура УстановитьМеткуРаспечатано(Знач ДанныеДляОбработки, Знач ЗначениеПризнака)
		
	Если ДанныеДляОбработки <> Неопределено Тогда
		
		МассивЗаказовНаПроизводство = Новый Массив;
		
		Для Каждого Заказ Из ДанныеДляОбработки Цикл
			Если ЗначениеЗаполнено(Заказ) Тогда
				МассивЗаказовНаПроизводство.Добавить(Заказ);
			КонецЕсли;
		КонецЦикла;
		
		Для Каждого Заказ Из МассивЗаказовНаПроизводство Цикл
			
			 ЗаписатьМеткуРаспечатано(Заказ);
			
		КонецЦикла;			
		
	КонецЕсли;
		
КонецПроцедуры 

&НаСервере
Процедура ЗаписатьМеткуРаспечатано(Заказ)
	
	Запрос = Новый Запрос;
    Запрос.Текст = 
    "ВЫБРАТЬ
    |	NVA_МеткиОбъектов.Объект КАК Объект,
    |	NVA_МеткиОбъектов.Метка КАК Метка
    |ИЗ
    |	РегистрСведений.NVA_МеткиОбъектов КАК NVA_МеткиОбъектов
    |ГДЕ
    |	NVA_МеткиОбъектов.Объект = &Заказ";
    
    Запрос.УстановитьПараметр("Заказ", Заказ);

    Выборка = Запрос.Выполнить().Выбрать();
    Если НЕ Выборка.Следующий() Тогда
        ТекЗапись = РегистрыСведений.NVA_МеткиОбъектов.СоздатьМенеджерЗаписи();
        ТекЗапись.Объект = Заказ;
        ТекЗапись.Метка  = Истина;
        Попытка
            ТекЗапись.Записать();
        Исключение
        КонецПопытки;
    Иначе
		Если Выборка.Метка Тогда
			Возврат;
		КонецЕсли;	
		
		ТекЗапись = РегистрыСведений.NVA_МеткиОбъектов.СоздатьМенеджерЗаписи();
        ТекЗапись.Объект = Выборка.Объект;
        ТекЗапись.Прочитать();
        
        ТекЗапись.Метка  = Истина;
        Попытка
            ТекЗапись.Записать();
        Исключение
        КонецПопытки;

    КонецЕсли;
	
КонецПроцедуры

#КонецОбласти






