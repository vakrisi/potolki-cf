&НаКлиенте
Процедура ВыборДокументаФрагмент(СсылкаНаЗаказНаПроизводство)
	
	//ПроверитьСоответствиеЗаказаНаПроизводствоЗаказуПокупателя
	
	ЗаказПокупателяСсылка = ПолучитьСсылкуНаОснование(СсылкаНаЗаказНаПроизводство);
	
	//#14923 расширено условие
	Если ОбщийМодульВызовСервера.ЗаказНаПроизводствоСвязанСЗаказомПокупателя(СсылкаНаЗаказНаПроизводство) Тогда
	//Если ОснованиемЗаказаНаПроизводствоЯвляетсяЗаказПокупателя(СсылкаНаЗаказНаПроизводство) Тогда
	
		СтруктураПроверки = ОбщийМодуль.ЗаказНаПроизводствоСоответствуетЗаказуПокупателя(СсылкаНаЗаказНаПроизводство, ПолучитьСсылкуНаОснование(СсылкаНаЗаказНаПроизводство));
		Если НЕ СтруктураПроверки.Результат Тогда
			Если СтруктураПроверки.ЕстьПотолок Тогда
				
				СсылкаЗП = ПолучитьСсылкуНаОснование(СсылкаНаЗаказНаПроизводство);
				
				ДополнительныеПараметры = Новый Структура;
				ДополнительныеПараметры.Вставить("ЗаказНаПроизводство", СсылкаНаЗаказНаПроизводство);
				ДополнительныеПараметры.Вставить("ЗаказНаПроизводствоОснование", СсылкаЗП);
				ОписаниеОповещения = Новый ОписаниеОповещения("НачалоПерезаполненияЗаказаНаПроизводствоПоОснованию", ЭтотОбъект, ДополнительныеПараметры);
				
				//#14923
				//ПоказатьВопрос(ОписаниеОповещения, "Сведения по потолку и его производственным услугам в заказе покупателя, являющемся основанием, отличаются от данных в этом заказе на производство.
				//	|Необходимо предварительно перезаполнить текущий заказ на производство по документу-основанию.
				//	|Выполнить перезаполнение заказа на производство (документ будет автоматически записан)?", РежимДиалогаВопрос.ДаНет);
				
				ПараметрыФормыПросмотраРазличий = Новый Структура;
				ПараметрыФормыПросмотраРазличий.Вставить("МассивСравнения", СтруктураПроверки.МассивСравнения);
				
				ПараметрыФормыПросмотраРазличий.Вставить("Документ1", СсылкаЗП);
				ПараметрыФормыПросмотраРазличий.Вставить("Документ2", СсылкаНаЗаказНаПроизводство);
				ПараметрыФормыПросмотраРазличий.Вставить("МассивРазличийРеквизитов", СтруктураПроверки.МассивРазличийРеквизитов);
				ПараметрыФормыПросмотраРазличий.Вставить("ДоступноИзменениеПриНаличииВыпуска", СтруктураПроверки.ДоступноИзменениеПриНаличииВыпуска); 
				ПараметрыФормыПросмотраРазличий.Вставить("ЕстьВыпуск", СтруктураПроверки.ЕстьВыпуск); 
				ПараметрыФормыПросмотраРазличий.Вставить("ТолькоПросмотр", Ложь);
				
				ТекстСообщения = ОбщийМодульКлиент.ТекстВопросаПерезаполненииЗаказаНаПроизводствоПоОснованию(СтруктураПроверки);
				ПараметрыФормыПросмотраРазличий.Вставить("ТекстСообщения",    ТекстСообщения);
				
				ОткрытьФорму("ОбщаяФорма.ПросмотрРазличийДокументов", ПараметрыФормыПросмотраРазличий, ЭтотОбъект,,,,ОписаниеОповещения);
					
			Иначе
				//Сообщить("В заказе покупателя (основании) отсутствует данный потолок!");
				//ДобавитьВИсторию("В заказе покупателя (основании) отсутствует данный потолок!");
				ПоказатьПредупреждение(, "В " + СсылкаНаЗаказНаПроизводство + " отсутствует продукция " + НоменклатураПродукции);
				// остаемся на начальной странице
			КонецЕсли;
			
			Возврат;
		Иначе
			ВыборЗаказНаПроизводствоЗавершение(СсылкаНаЗаказНаПроизводство);
		КонецЕсли;
		
	Иначе
		ВыборЗаказНаПроизводствоЗавершение(СсылкаНаЗаказНаПроизводство);
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьНоменклатуруПродукцииИзЗаказаНаПроизводство(ЗаказНаПроизводство, НоменклатураПродукции, ПредставлениеПродукции)
	
	НоменклатураПродукции = ПредопределенноеЗначение("Справочник.Номенклатура.ПустаяСсылка");
	КоличествоПродукции = 0;
	ЕдиницаИзмеренияПродукции = Неопределено;
	
	РеквизитыЗаказа = Общегоназначения.ЗначенияРеквизитовОбъекта(ЗаказНаПроизводство, "ВидЗаказа, ПродукцияНоменклатура, ПродукцияНоменклатураКоличество, ПродукцияНоменклатураЕдиницаИзмерения"); 
	Если РеквизитыЗаказа.ВидЗаказа = Перечисления.ВидыЗаказовНаПроизводство.ПроизводствоПотолка Тогда
		НоменклатураПродукции = РеквизитыЗаказа.ПродукцияНоменклатура;
		КоличествоПродукции = РеквизитыЗаказа.ПродукцияНоменклатураКоличество;
		ЕдиницаИзмеренияПродукции = РеквизитыЗаказа.ПродукцияНоменклатураЕдиницаИзмерения;
	ИначеЕсли РеквизитыЗаказа.ВидЗаказа = Перечисления.ВидыЗаказовНаПроизводство.ТиповоеПроизводство Тогда
		Если ЗаказНаПроизводство.Продукция.Количество() > 0 Тогда
			СтрокаПродукции = ЗаказНаПроизводство.Продукция[0];
			НоменклатураПродукции = СтрокаПродукции.Номенклатура;
			КоличествоПродукции = СтрокаПродукции.Количество;
			ЕдиницаИзмеренияПродукции = СтрокаПродукции.ЕдиницаИзмерения;
		КонецЕсли;
	КонецЕсли;	
	
	ПредставлениеПродукции = СтрШаблон("%1 (%2 %3)", НоменклатураПродукции, КоличествоПродукции, ЕдиницаИзмеренияПродукции);
	
КонецФункции

