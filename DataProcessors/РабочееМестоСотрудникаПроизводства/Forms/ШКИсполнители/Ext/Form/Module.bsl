&НаКлиенте
Функция ДобавитьИсполнителяВСхемеПоОперациям()

	//сначала убедимся что по данной операции данного сотрудника еще нет
	Для Каждого ТекСтрока Из ИсполнителиПоОперациям Цикл
		Если ТекСтрока.Операция = ПроизводственнаяОперация Тогда
			Если ТекСтрока.Сотрудник1 = Сотрудник
				или ТекСтрока.Сотрудник2 = Сотрудник
				или ТекСтрока.Сотрудник3 = Сотрудник
				или ТекСтрока.Сотрудник4 = Сотрудник
				тогда
				ПроизводственнаяОперация = ПредопределенноеЗначение("Справочник.ПроизводственныеОперации.ПустаяСсылка");
				Сотрудник = ПредопределенноеЗначение("Справочник.Сотрудники.ПустаяСсылка");
				Возврат "Данный сотрудник уже указан как исполнитель операции " + ПроизводственнаяОперация + " в данном заказе на производство";
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	//пытаемся добавить
	СтрокаОперации = Неопределено;
	Для Каждого ТекСтрока Из ИсполнителиПоОперациям Цикл
		Если ТекСтрока.Операция = ПроизводственнаяОперация Тогда
			СтрокаОперации = ТекСтрока;
		КонецЕсли;
	КонецЦикла;
	
	Если СтрокаОперации = Неопределено Тогда
		//такой операции еще нет, добавляем
		НоваяСтрока = ИсполнителиПоОперациям.Добавить();
		НоваяСтрока.Операция = ПроизводственнаяОперация;
		НоваяСтрока.Сотрудник1 = Сотрудник;
	Иначе
		//такая операция есть, проверяем что есть свободные места для добавления и добавляем
		Если СтрокаОперации.Сотрудник1.Пустая() Тогда
			СтрокаОперации.Сотрудник1 = Сотрудник;
		ИначеЕсли СтрокаОперации.Сотрудник2.Пустая() Тогда
			СтрокаОперации.Сотрудник2 = Сотрудник;
		ИначеЕсли СтрокаОперации.Сотрудник3.Пустая() Тогда
			СтрокаОперации.Сотрудник3 = Сотрудник;
		ИначеЕсли СтрокаОперации.Сотрудник4.Пустая() Тогда
			СтрокаОперации.Сотрудник4 = Сотрудник;
		Иначе
			ПроизводственнаяОперация = ПредопределенноеЗначение("Справочник.ПроизводственныеОперации.ПустаяСсылка");
			Сотрудник = ПредопределенноеЗначение("Справочник.Сотрудники.ПустаяСсылка");
			Возврат "Для операции " + ПроизводственнаяОперация + " в данном заказе на производство указано максимально воможное количество исполнителей";
		КонецЕсли;
	КонецЕсли;
	
	ПроизводственнаяОперация = ПредопределенноеЗначение("Справочник.ПроизводственныеОперации.ПустаяСсылка");
	Сотрудник = ПредопределенноеЗначение("Справочник.Сотрудники.ПустаяСсылка");
	
КонецФункции

