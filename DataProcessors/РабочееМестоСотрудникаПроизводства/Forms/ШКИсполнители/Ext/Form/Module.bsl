
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ТекущийПользователь = Пользователи.ТекущийПользователь();
	
	//++17110
	Если Метаданные.Версия < "3.3.0" И ТекущийПользователь.УДАЛИТЬ_РазрешеноРедактироватьМатериалыЗаказаНаПроизводство Тогда
		// Взводим нужный флаг
		ОбъектПользователь = ТекущийПользователь.ПолучитьОбъект();
		ОбъектПользователь.РазрешитьИзменениеКоличестваПриВыпускеВРМСотрудникаПроизводства = Истина;
		ОбъектПользователь.УДАЛИТЬ_РазрешеноРедактироватьМатериалыЗаказаНаПроизводство = Ложь;
		ОбъектПользователь.ОбменДанными.Загрузка = Истина;
		ОбъектПользователь.Записать();
	КонецЕсли;
	
	РеквизитыПользователя = ОбщийМодульСервер.НастройкиПользователя("РазрешитьИзменениеМатериаловИИхКоличестваВЗнПвРМСП, 
																	|РазрешитьИзменениеКоличестваПриВыпускеВРМСотрудникаПроизводства", ТекущийПользователь);
		
	ИспользоватьПодключаемоеОборудование = Константы.ИспользоватьПодключаемоеОборудование.Получить();
	ШКСотрудникаСодержитКодОперации = Истина; //Константы.ШтрихкодСотрудникаСодержитКодОперации.Получить();  // #13536
	ПоПроизводственнымОперациям = Константы.РасчетЗарплатыПроизводстваПоОперациям.Получить();
	
	//++ №14141 количество колонок по производственным операциям
	МаксимальноеКоличествоСотрудниковВВыпускеНаОперацию = Константы.МаксимальноеКоличествоСотрудниковВВыпускеНаОперацию.Получить();
	
	Для Сч = 1 По 4 Цикл
		Элементы["ИсполнителиПоОперациямСотрудник" + Сч].Видимость = (Сч <= МаксимальноеКоличествоСотрудниковВВыпускеНаОперацию);
	КонецЦикла;
	//-- №14141
	
	//++ #15805
	Элементы.ГруппаЗаказы.Видимость = Константы.ВыводитьСписокЗаказовНаПроизводствоВРМСотрудникаПроизводства.Получить();
	
	Если ПолучитьФункциональнуюОпцию("НесколькоТочекПроизводства") Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Цехи.Ссылка КАК Ссылка,
		|	Цехи.Код КАК Код1,
		|	Цехи.Наименование КАК Наименование,
		|	Цехи.КраткоеПредставление КАК КраткоеПредставление,
		|	Цехи.Код КАК Код
		|ИЗ
		|	Справочник.Цехи КАК Цехи
		|ГДЕ
		|	НЕ Цехи.Архивный
		|	И НЕ Цехи.ПометкаУдаления";
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Пока Выборка.Следующий() Цикл
			ДобавитьКомандуИКнопкуОтбораПоЦеху(Выборка.Ссылка, Выборка.Код, Выборка.Наименование, Выборка.КраткоеПредставление);	
		КонецЦикла;
			
	КонецЕсли;
	
	ВосстановитьНастройкиФормы();	
	УстановитьОтборЗаказов();
	//-- #15805
	
	//#16317
	Элементы.ЗаменитьМатериал.Видимость     = РеквизитыПользователя.РазрешитьИзменениеМатериаловИИхКоличестваВЗнПвРМСП ИЛИ РеквизитыПользователя.РазрешитьИзменениеКоличестваПриВыпускеВРМСотрудникаПроизводства;
	Элементы.ИзменитьКоличество.Видимость   = РеквизитыПользователя.РазрешитьИзменениеМатериаловИИхКоличестваВЗнПвРМСП ИЛИ РеквизитыПользователя.РазрешитьИзменениеКоличестваПриВыпускеВРМСотрудникаПроизводства;
	Элементы.ЗаменитьМатериал1.Видимость    = РеквизитыПользователя.РазрешитьИзменениеМатериаловИИхКоличестваВЗнПвРМСП ИЛИ РеквизитыПользователя.РазрешитьИзменениеКоличестваПриВыпускеВРМСотрудникаПроизводства;
	Элементы.ИзменитьКоличество1.Видимость  = РеквизитыПользователя.РазрешитьИзменениеМатериаловИИхКоличестваВЗнПвРМСП ИЛИ РеквизитыПользователя.РазрешитьИзменениеКоличестваПриВыпускеВРМСотрудникаПроизводства;
	Элементы.ИзОстатков.Видимость 			= РеквизитыПользователя.РазрешитьИзменениеМатериаловИИхКоличестваВЗнПвРМСП ИЛИ РеквизитыПользователя.РазрешитьИзменениеКоличестваПриВыпускеВРМСотрудникаПроизводства;
	Элементы.ИзМатериалаЗаказчика.Видимость = РеквизитыПользователя.РазрешитьИзменениеМатериаловИИхКоличестваВЗнПвРМСП ИЛИ РеквизитыПользователя.РазрешитьИзменениеКоличестваПриВыпускеВРМСотрудникаПроизводства;
		
	Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.ГруппаНачальнаяСтраница;
	ТекущийЭлемент = Элементы.ИмитацияШК; 
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	//ОбновитьСостояние();
	
	МенеджерОборудованияКлиентПереопределяемый.НачатьПодключениеОборудованиеПриОткрытииФормы(ЭтаФорма, "СканерШтрихкода");
	
	ВыделитьКнопкиОтбораЗаказаПоСтатусу();
	ВыделитьКнопкиОтбораЗаказаПоЦеху();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)
	
	МенеджерОборудованияКлиентПереопределяемый.НачатьОтключениеОборудованиеПриЗакрытииФормы(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если Источник = "ПодключаемоеОборудование" И ВводДоступен() Тогда 
		Если ИмяСобытия = "ScanData" Тогда
			ОчиститьСообщения();
			ОбработатьШтрихкоды(МенеджерОборудованияПотолкиКлиент.ПреобразоватьДанныеСоСканераВСтруктуру(Параметр));
			//ОбновитьСостояние();
			
			ПодключитьОбработчикОжидания("УстановитьТекущийЭлемент", 0.1, Истина);
		КонецЕсли;	
	КонецЕсли; 
		
КонецПроцедуры

#КонецОбласти

#Область ШтрихкодыИТорговоеОборудование

&НаКлиенте
Процедура ОбработатьШтрихкоды(Данные)
	
	ШК = Данные.Штрихкод; // Штрихкод[0].Штрихкод;
	
	Если ПустаяСтрока(ШК) Тогда
		//ПоказатьПредупреждение(,"Штрих-код не распознан");
		ОткрытьФорму("ОбщаяФорма.ФормаПредупреждения", Новый Структура("ЗаголовокИнформации, ТекстИнформации, Состояние", "Ошибка", "Штрих-код не распознан", "Ошибка"));			
		Возврат;
	КонецЕсли;
	
	//Если ЗаказНаПроизводство.Пустая() Тогда
	Если Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.ГруппаНачальнаяСтраница Тогда
		//Отсканировали ШК заказа	
		
		СсылкаНаЗаказНаПроизводство = ПолучитьЗаказНаПроизводство(ШК);
		Если НЕ СсылкаНаЗаказНаПроизводство.Пустая() Тогда			
			ВыборДокументаФрагмент(СсылкаНаЗаказНаПроизводство);
		Иначе			
			//Сообщить("Не найден заказ на производство в статусе ""В производстве"" с номером расчета " + ШК);
			//ДобавитьВИсторию("Не найден заказ на производство в статусе ""В производстве"" с номером расчета " + ШК);
			ТекстСообщения = "Не найдена уникальная продукция с номером " + ШК + " с заказом на производство в статусе ""В ПРОИЗВОДСТВЕ""";
			//ПоказатьПредупреждение(,ТекстСообщения);
			ОткрытьФорму("ОбщаяФорма.ФормаПредупреждения", Новый Структура("ЗаголовокИнформации, ТекстИнформации, Состояние", "Ошибка", ТекстСообщения, "Ошибка"));
		КонецЕсли;		
		
	Иначе

		//#14336
		Если Лев(ШК, 12) = "000000000000" Тогда
			Отмена(Неопределено);
			Возврат;
		ИначеЕсли Лев(ШК, 12) = "000000000001" Тогда
			ОК(Неопределено);
			Возврат;
		КонецЕсли;
		
		ШК_ИД = Лев(ШК, 2);
		// #13536 изменена процедура: раньше ШК всегда начиналась с 88, сейчас с 86/87/88
		ДанныеПоШК = ШтрихкодированиеПотолкиКлиент.ОбработатьШтрихкод(ШК);
		Если ДанныеПоШК = Неопределено Тогда
			Возврат;
		КонецЕсли;
	
		Если ШК_ИД = "87" Тогда //ПоПроизводственнымОперациям И ПроизводственнаяОперация.Пустая() И НЕ ШКСотрудникаСодержитКодОперации Тогда
			//Отсканировали ШК операции
			
			//ШКОперации = Сред(ШК, 3, 5);	
			//Результат = ПолучитьПроизводственнуюОперацию(Строка("0000" + ШКОперации));
			//Если ТипЗнч(Результат) = тип("Строка") Тогда
			//	ПоказатьПредупреждение(,Результат);
			//Иначе
			//	ПроизводственнаяОперация = Результат;
			//КонецЕсли;
			
			ПроизводственнаяОперация = ДанныеПоШК.Операция;
			
		ИначеЕсли ШК_ИД = "88" Тогда //ПоПроизводственнымОперациям И ПроизводственнаяОперация.Пустая() И ШКСотрудникаСодержитКодОперации Тогда	
			//Отсканировали ШК операции+сотрудника (единый)
			
			//ШКОперации = Сред(ШК, 3, 5);		
			//Результат = ПолучитьПроизводственнуюОперацию(Строка("0000" + ШКОперации));
			//Если ТипЗнч(Результат) = тип("Строка") Тогда
			//	ПоказатьПредупреждение(,Результат);
			//	Возврат;
			//Иначе
			//	ПроизводственнаяОперация = Результат;
			//КонецЕсли;
			//
			//ШКСотрудника = Сред(ШК, 8, 5);		
			//Результат = ПолучитьСотрудника(Строка("0000" + ШКСотрудника));
			//Если ТипЗнч(Результат) = тип("Строка") Тогда
			//	ПоказатьПредупреждение(,Результат);
			//Иначе
			//	Сотрудник = Результат;
			//КонецЕсли;
			
			ПроизводственнаяОперация = ДанныеПоШК.Операция;
			Сотрудник = ДанныеПоШК.Сотрудник;
			
			//#13729
			Если НЕ ЭтоРаботникПроизводства(Сотрудник) Тогда
				ПроизводственнаяОперация = ПредопределенноеЗначение("Справочник.ПроизводственныеОперации.ПустаяСсылка");
				Сотрудник = ПредопределенноеЗначение("Справочник.Сотрудники.ПустаяСсылка");
				Возврат;
			КонецЕсли;
				
			Результат = ДобавитьИсполнителяВСхемеПоОперациям();
			Если Не ПустаяСтрока(Результат) Тогда
				ПоказатьПредупреждение(,Результат);
			КонецЕсли;
			
		ИначеЕсли ШК_ИД = "86" Тогда //Сотрудник.Пустая() Тогда	
			//Отсканировали ШК сотрудника
			
			//ШКСотрудника = Сред(ШК, 8, 5);		
			//Результат = ПолучитьСотрудника(Строка("0000" + ШКСотрудника));
			//Если ТипЗнч(Результат) = тип("Строка") Тогда
			//	ПоказатьПредупреждение(, Результат);
			//	Возврат;
			//Иначе
			//	Сотрудник = Результат;
			//КонецЕсли;
			
			Сотрудник = ДанныеПоШК.Сотрудник;
			
			//#13729
			Если НЕ ЭтоРаботникПроизводства(Сотрудник) Тогда
				Сотрудник = ПредопределенноеЗначение("Справочник.Сотрудники.ПустаяСсылка");
				Возврат;
			КонецЕсли;

			Если ПоПроизводственнымОперациям Тогда
				Результат = ДобавитьИсполнителяВСхемеПоОперациям();
			Иначе
				Результат = ДобавитьИсполнителяВБригаднойСхеме();
			КонецЕсли;
			Если Не ПустаяСтрока(Результат) Тогда
				ПоказатьПредупреждение(, Результат);
			КонецЕсли;
			
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура ИмитацияШКПриИзменении(Элемент)
	
	ПараметрыКОтправке = Новый Массив;
	ПараметрыКОтправке.Добавить(ИмитацияШК);
	ПараметрыКОтправке.Добавить(Неопределено);
	ОбработкаОповещения("ScanData", ПараметрыКОтправке, "ПодключаемоеОборудование");
	ИмитацияШК = "";
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОК(Команда)
	
	//Если НЕ ЗаказНаПроизводство.Пустая() Тогда
		ТекстОшибки = ЗаполнитьЗаказНаПроизводствоНаСервере();
		Если ПустаяСтрока(ТекстОшибки) Тогда
			ОчиститьВсеПоляНаФорме();
		Иначе
			ПоказатьПредупреждение(, ТекстОшибки);
		КонецЕсли;
	//Иначе
	//	ПоказатьПредупреждение(,"Не выбрана продукция");
	//КонецЕсли;
	
	ПодключитьОбработчикОжидания("УстановитьТекущийЭлемент", 0.1, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура Отмена(Команда)
	
	ОчиститьВсеПоляНаФорме();
	ПодключитьОбработчикОжидания("УстановитьТекущийЭлемент", 0.1, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура Выполнен(Команда)
	
	//Если ЗаказНаПроизводство.Пустая() Тогда
	//	ПоказатьПредупреждение(,"Не указана продукция");
	//Иначе
		ТекстОшибки = ЗаполнитьЗаказНаПроизводствоНаСервере();

		Если ПустаяСтрока(ТекстОшибки) Тогда		
			
			//#13345
			ДополнительныеПараметры = Новый Структура;
			ДополнительныеПараметры.Вставить("ЗаказНаПроизводство",    ЗаказНаПроизводство);
			ДополнительныеПараметры.Вставить("ПредставлениеПродукции", ПредставлениеПродукции);
			ОписаниеОповещения = Новый ОписаниеОповещения("ВыполненЗавершение", ЭтотОбъект, ДополнительныеПараметры);
			ОткрытьФорму("Обработка.РабочееМестоСотрудникаПроизводства.Форма.ШКИсполнителиВыпуск", ДополнительныеПараметры, ЭтаФорма, , , , ОписаниеОповещения);
			
		Иначе
			ПоказатьПредупреждение(, ТекстОшибки);
		КонецЕсли;
	//КонецЕсли;
	
	ПодключитьОбработчикОжидания("УстановитьТекущийЭлемент", 0.1, Истина);
	
КонецПроцедуры

//#16317
&НаКлиенте
Процедура ЗаменитьМатериал(Команда)
	
	Если Команда.Имя = "ЗаменитьМатериал" Тогда
		Элемент = Элементы.Материалы;
		
	ИначеЕсли Команда.Имя = "ЗаменитьМатериал1" Тогда
		Элемент = Элементы.Материалы1;
	КонецЕсли;
	
	ТекущиеДанные = Элемент.ТекущиеДанные;
		
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИдентификаторСтроки = Элемент.ТекущаяСтрока;
	ПредыдущийМатериал = ТекущиеДанные.Номенклатура;
	
	ПараметрыФормы = Новый Структура("ТекущаяСтрока", ТекущиеДанные.Номенклатура);
	//ДополнительныеПараметры = Новый Структура("ИдентификаторСтроки", ТекущиеДанные.ПолучитьИдентификатор());
	ДополнительныеПараметры = Новый Структура("ИдентификаторСтроки", ИдентификаторСтроки);
	ОписаниеОповещения = Новый ОписаниеОповещения("ЗаменитьМатериалФрагмент", ЭтотОбъект, ДополнительныеПараметры);
	ОткрытьФорму("Справочник.Номенклатура.Форма.ФормаВыбораДляСотрудникаПроизводства", ПараметрыФормы,,,,, ОписаниеОповещения); 
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаменитьМатериалФрагмент(ВыбранноеЗначение, ДополнительныеПараметры) Экспорт
	
	Если ВыбранноеЗначение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	МатериалыИзменены = Истина;
	
	СтрокаТабличнойЧасти = Материалы.НайтиПоИдентификатору(ДополнительныеПараметры.ИдентификаторСтроки);
	
	Если СтрокаТабличнойЧасти = Неопределено Тогда
		Возврат;
	КонецЕсли;
		
	СтрокаТабличнойЧасти.Номенклатура = ВыбранноеЗначение;
	МатериалыНоменклатураПриИзменении(СтрокаТабличнойЧасти);
	
	ИзменитьКоличествоМатериалаИнтерактивно(СтрокаТабличнойЧасти, ДополнительныеПараметры.ИдентификаторСтроки);
	
КонецПроцедуры	

&НаКлиенте
Процедура МатериалыНоменклатураПриИзменении(СтрокаТабличнойЧасти)
	
	СтрокаТабличнойЧасти = Элементы.Материалы.ТекущиеДанные;
	СтрокаТабличнойЧасти.ЕдиницаИзмерения = ОбщийМодульВызовСервера.ПолучитьЕдиницуИзмеренияДляПроизводства(СтрокаТабличнойЧасти.Номенклатура);
	
	Если ЗначениеЗаполнено(ПредыдущийМатериал) И СтрокаТабличнойЧасти.Номенклатура = ПредопределенноеЗначение("Справочник.Номенклатура.ОстаткиПленки") Тогда
		СтрокаТабличнойЧасти.Количество = СтрокаТабличнойЧасти.Количество * СтрокаТабличнойЧасти.Коэффициент;
		СтрокаТабличнойЧасти.Коэффициент = 1;
	Иначе		
		Если ТипЗнч(СтрокаТабличнойЧасти.ЕдиницаИзмерения) = Тип("СправочникСсылка.КлассификаторЕдиницИзмерения") Тогда
			СтрокаТабличнойЧасти.Коэффициент = 1;
		ИначеЕсли ТипЗнч(СтрокаТабличнойЧасти.ЕдиницаИзмерения) = Тип("СправочникСсылка.ЕдиницыИзмерений") Тогда
			СтрокаТабличнойЧасти.Коэффициент = ОбщийМодульВызовСервера.ПолучитьКоэффициентЕдиницыИзмерения(СтрокаТабличнойЧасти.ЕдиницаИзмерения);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

//#16317
&НаКлиенте
Процедура ИзменитьКоличество(Команда)
	
	Если Команда.Имя = "ИзменитьКоличество" Тогда
		Элемент = Элементы.Материалы;
		
	ИначеЕсли Команда.Имя = "ИзменитьКоличество1" Тогда
		Элемент = Элементы.Материалы1;
	КонецЕсли;
	
	ТекущиеДанные = Элемент.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИдентификаторСтроки = Элемент.ТекущаяСтрока;	
	ИзменитьКоличествоМатериалаИнтерактивно(ТекущиеДанные, ИдентификаторСтроки);
	
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьКоличествоМатериалаИнтерактивно(ТекущиеДанные, ИдентификаторСтроки)
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Заголовок", "Введите количество");
	ПараметрыФормы.Вставить("ЧислоВвода", ТекущиеДанные.Количество);
	ПараметрыФормы.Вставить("КоличествоСимволовПослеЗапятой", 3);
	
	ДополнительныеПараметры = Новый Структура("ИдентификаторСтроки", ИдентификаторСтроки);
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ИзменитьКоличествоЗавершение", ЭтотОбъект, ДополнительныеПараметры);	
	ОткрытьФорму("Обработка.РабочееМестоСотрудникаПроизводства.Форма.ФормаВводаЧисла", ПараметрыФормы,,,,, ОписаниеОповещения);

КонецПроцедуры

&НаКлиенте
Процедура ИзменитьКоличествоЗавершение(РезультатОткрытияФормы, ДополнительныеПараметры) Экспорт
	
	СтрокаТабличнойЧасти = Материалы.НайтиПоИдентификатору(ДополнительныеПараметры.ИдентификаторСтроки);
	
	Если СтрокаТабличнойЧасти = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ РезультатОткрытияФормы = Неопределено Тогда
		СтрокаТабличнойЧасти.Количество = РезультатОткрытияФормы.ВведенноеЧисло;
		МатериалыИзменены = Истина;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОтборыЗаказов

//++ #15805
&НаСервере
Процедура УстановитьОтборЗаказов()
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(СписокЗаказов,
			"ТекущийСтатус", ЗаказОтборПоТекущемуСтатусу, ВидСравненияКомпоновкиДанных.ВСписке,, ЗаказОтборПоТекущемуСтатусу.Количество() > 0);
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(СписокЗаказов,
			"Цех", ЗаказОтборПоЦеху, ВидСравненияКомпоновкиДанных.ВСписке,, ЗаказОтборПоЦеху.Количество() > 0);
	
	//nva+++
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(СписокЗаказов,
			"СкладМатериалов", ЗаказОтборПоСкладуМатериалов, ВидСравненияКомпоновкиДанных.ВСписке,, ЗаказОтборПоСкладуМатериалов.Количество() > 0);
	//nva---
	
	СохранитьНастройкиФормы();
	
КонецПроцедуры

&НаКлиенте
Процедура СписокЗаказовВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ТекущиеДанные = Элементы.СписокЗаказов.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ ТекущиеДанные.ТекущийСтатус = ПредопределенноеЗначение("Справочник.СтатусыЗаказовНаПроизводство.ВПроизводстве")
		ИЛИ НЕ ТекущиеДанные.Проведен Тогда
		//ПоказатьЗначение(, ТекущиеДанные.Ссылка);
		ТекстСообщения = "Заказ на производство не проведен или не находится в статусе ""В ПРОИЗВОДСТВЕ""";
		ОткрытьФорму("ОбщаяФорма.ФормаПредупреждения", Новый Структура("ЗаголовокИнформации, ТекстИнформации, Состояние", "Ошибка", ТекстСообщения, "Ошибка"));
		Возврат;
	КонецЕсли;
	
	ВыборДокументаФрагмент(ТекущиеДанные.Ссылка);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьМассивРеквизитовСтатусыЗаказа()
	
	МассивРеквизитов = Новый Массив;
	МассивРеквизитов.Добавить("ВПроизводстве");
	МассивРеквизитов.Добавить("Произведен");
	МассивРеквизитов.Добавить("Отменен");
		
	Возврат МассивРеквизитов;
	
КонецФункции

&НаКлиенте
Процедура ОтборЗаказаПоСтатусуНажатие(Команда)
	
	Элементы[Команда.Имя].Пометка = НЕ Элементы[Команда.Имя].Пометка;
	
	ВыделитьКнопкиОтбораЗаказаПоСтатусу();
	ОтборЗаказаПоСтатусу();
	
КонецПроцедуры

&НаКлиенте
Процедура ОтборЗаказаПоСтатусу()
	
	МассивРеквизитов = ПолучитьМассивРеквизитовСтатусыЗаказа();	
	ЗаказОтборПоТекущемуСтатусу.Очистить();	
	Для каждого ИмяРеквизита Из МассивРеквизитов Цикл
		
		Если Элементы["ОтборСтатусЗаказа" + ИмяРеквизита].Пометка Тогда
			
			ЗаказОтборПоТекущемуСтатусу.Добавить(ПредопределенноеЗначение("Справочник.СтатусыЗаказовНаПроизводство." + ИмяРеквизита));
			
		КонецЕсли;
		
	КонецЦикла;	
	УстановитьОтборЗаказов();
	
КонецПроцедуры 

&НаКлиенте
Процедура ВыделитьКнопкиОтбораЗаказаПоСтатусу()
	
	МассивРеквизитов = ПолучитьМассивРеквизитовСтатусыЗаказа();
	
	Для каждого ИмяРеквизита Из МассивРеквизитов Цикл		
		ЭлементКнопка = Элементы["ОтборСтатусЗаказа" + ИмяРеквизита];
		ЭлементКнопка.ЦветФона = ?(ЭлементКнопка.Пометка, WebЦвета.Оранжевый, WebЦвета.СветлоЖелтыйЗолотистый);		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьМассивРеквизитовСкладыМатериалов()
	
	МассивРеквизитов = Новый Массив;
	МассивРеквизитов.Добавить("Юг");
	МассивРеквизитов.Добавить("Север");
		
	Возврат МассивРеквизитов;
	
КонецФункции

&НаКлиенте
Процедура ОтборПоСкладуМатериаловНажатие(Команда)
	
	Элементы[Команда.Имя].Пометка = НЕ Элементы[Команда.Имя].Пометка;
	
	ВыделитьКнопкиОтбораЗаказаПоСкладуМатериалов();
	ОтборЗаказаПоСкладуМатериалов();
	
КонецПроцедуры

&НаКлиенте
Процедура ОтборЗаказаПоСкладуМатериалов()
	
	МассивРеквизитов = ПолучитьМассивРеквизитовСкладыМатериалов();	
	ЗаказОтборПоСкладуМатериалов.Очистить();	
	Для каждого ИмяРеквизита Из МассивРеквизитов Цикл
		
		Если Элементы["ОтборПоСкладуМатериалов" + ИмяРеквизита].Пометка Тогда
			Если ИмяРеквизита = "Юг" Тогда
				Склад = ПолучитьСкладЮг();
			ИначеЕсли ИмяРеквизита = "Север" Тогда
				Склад = ПолучитьСкладСевер();
			Иначе
				Склад = Неопределено;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(Склад) Тогда
				ЗаказОтборПоСкладуМатериалов.Добавить(Склад);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;	
	УстановитьОтборЗаказов();
	
КонецПроцедуры

Функция ПолучитьСкладЮг()
	
	Возврат Справочники.Склады.НайтиПоКоду("000000001");
	
КонецФункции

Функция ПолучитьСкладСевер()
	
	Возврат Справочники.Склады.НайтиПоКоду("000000004");
	
КонецФункции

&НаКлиенте
Процедура ВыделитьКнопкиОтбораЗаказаПоСкладуМатериалов()
	
	МассивРеквизитов = ПолучитьМассивРеквизитовСкладыМатериалов();
	
	Для каждого ИмяРеквизита Из МассивРеквизитов Цикл		
		ЭлементКнопка = Элементы["ОтборПоСкладуМатериалов" + ИмяРеквизита];
		ЭлементКнопка.ЦветФона = ?(ЭлементКнопка.Пометка, WebЦвета.Оранжевый, WebЦвета.СветлоЖелтыйЗолотистый);		
	КонецЦикла;
	
КонецПроцедуры


