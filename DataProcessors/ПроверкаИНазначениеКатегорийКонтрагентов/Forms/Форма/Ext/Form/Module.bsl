		НоваяСтрока.УстановитьКатегорию = ПолучитьКатегориюПоСуммеПродаж(НоваяСтрока.СуммаПродаж);
		Если НЕ НоваяСтрока.ТекущаяКатегория = НоваяСтрока.УстановитьКатегорию Тогда
			НоваяСтрока.Изменять = Истина;
		КонецЕсли;
		
		НоваяСтрока.ТекущийВидЦен = ПолучитьВидЦенДоговора(НоваяСтрока.Договор);
		НоваяСтрока.УстановитьВидЦен = ПолучитьВидЦенКатегории(НоваяСтрока.УстановитьКатегорию);
		Если Объект.ИзменятьВидЦенВДоговорах Тогда
			Если НЕ НоваяСтрока.ТекущийВидЦен = НоваяСтрока.УстановитьВидЦен Тогда
				НоваяСтрока.Изменять = Истина;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьПоПродажам(Команда)
	ДобавитьПоПродажамНаСервере();
КонецПроцедуры

&НаСервере
Процедура ИзменитьКатегориюНаСервере()
	
	Для Каждого ТекущаяСтрока Из Объект.КатегорииПоОбъемуПродаж Цикл
		Если ТекущаяСтрока.Изменять и НЕ (ТекущаяСтрока.ТекущаяКатегория = ТекущаяСтрока.УстановитьКатегорию) Тогда
			ЭлементОбъект = ТекущаяСтрока.Контрагент.ПолучитьОбъект();
			ЭлементОбъект.Категория = ТекущаяСтрока.УстановитьКатегорию;
			Попытка
				ЭлементОбъект.Записать();
			Исключение
				Сообщить("Не удалось изменить категорию контрагента " + ТекущаяСтрока.Контрагент + ". Ошибка: " + ОписаниеОшибки());
			КонецПопытки;   
			ТекущаяСтрока.ТекущаяКатегория = ТекущаяСтрока.Контрагент.Категория;
		КонецЕсли;
		Если Объект.ИзменятьВидЦенВДоговорах Тогда
			Если ТекущаяСтрока.Изменять  и НЕ (ТекущаяСтрока.ТекущийВидЦен = ТекущаяСтрока.УстановитьВидЦен) и НЕ  ТекущаяСтрока.УстановитьВидЦен.Пустая() Тогда
				ЭлементОбъект = ТекущаяСтрока.Договор.ПолучитьОбъект();
				ЭлементОбъект.ВидЦен = ТекущаяСтрока.УстановитьВидЦен;
				Попытка
					ЭлементОбъект.Записать();
				Исключение
					Сообщить("Не удалось изменить вид цен в договоре контрагента " + ТекущаяСтрока.Контрагент + ". Ошибка: " + ОписаниеОшибки());
				КонецПопытки; 
				ТекущаяСтрока.ТекущийВидЦен = ТекущаяСтрока.Договор.ВидЦен;
			КонецЕсли;
		КонецЕсли;
		Если (ТекущаяСтрока.ТекущаяКатегория = ТекущаяСтрока.УстановитьКатегорию) и (ТекущаяСтрока.ТекущийВидЦен = ТекущаяСтрока.УстановитьВидЦен) Тогда
			ТекущаяСтрока.Изменять = Ложь;
		Иначе
			ТекущаяСтрока.Изменять = Истина;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

