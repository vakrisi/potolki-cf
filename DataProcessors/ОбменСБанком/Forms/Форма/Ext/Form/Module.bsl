Функция СформироватьФайлОбменаСБанком()
	Возврат ОбщийМодуль.СформироватьФайлОбменаСБанком(ЭтаФорма);
КонецФункции

&НаСервере 
Функция СоздатьДоговорСКонтрагентом(КонтрагентСсылка)
	НовыйДоговор = Справочники.ДоговорыКонтрагентов.СоздатьЭлемент();
	НовыйДоговор.Наименование = "Основной договор";
	НовыйДоговор.Владелец = КонтрагентСсылка;
	НовыйДоговор.Записать();
	Возврат НовыйДоговор.Ссылка;
КонецФункции

&НаСервере
Функция СоздатьСчетКонтрагента(ПараметрыСчета)
	НовыйСчет = Справочники.БанковскиеСчета.СоздатьЭлемент();
	НовыйСчет.Наименование = ?(ЗначениеЗаполнено(ПараметрыСчета.Банк), ПараметрыСчета.Банк + " ", "") + "счет № " + ПараметрыСчета.РасчетныйСчет;
	НовыйСчет.Владелец = ПараметрыСчета.Контрагент;
	НовыйСчет.НомерСчета = ПараметрыСчета.РасчетныйСчет;
	КодВалюты = Сред(ПараметрыСчета.РасчетныйСчет, 6, 3);
	КодВалюты = ?(КодВалюты = "810", "643", КодВалюты);
	НовыйСчет.Валюта = Справочники.Валюты.НайтиПоКоду(КодВалюты);
	НовыйСчет.БИК = ПараметрыСчета.БИК;
	НовыйСчет.КоррСчет = ПараметрыСчета.КорСчет;
	НовыйСчет.НаименованиеБанка = ПараметрыСчета.Банк;
	НовыйСчет.ГородБанка = ПараметрыСчета.БанкАдрес;
	НовыйСчет.Записать();
	Возврат НовыйСчет.Ссылка;
КонецФункции

&НаСервере
Функция ПерезаполнитьКонтрагентов(НаименованиеКотрагента, КонтрагентСсылка)
	Для Каждого СтрокаДокумента из Объект.Документы Цикл
		Если СтрокаДокумента.СсылкаКонтрагент = НаименованиеКотрагента Тогда 
			СтрокаДокумента.СсылкаКонтрагент = КонтрагентСсылка;
		КонецЕсли;
	КонецЦикла;
КонецФункции

&НаСервере
Функция СоздатьТекущегоКонтрагента(НаименованиеКонтрагента)
	
	ГруппаДоступаДляНовыхКонтрагентов = ОбщийМодульСервер.НастройкаПользователя("ГруппаДоступаДляНовыхКонтрагентов");
	
	УдалосьСоздать = Ложь;
	Для Каждого СтрокаДокумента из Объект.Документы Цикл
		Если СтрокаДокумента.СсылкаКонтрагент = НаименованиеКонтрагента Тогда 
			Попытка
				
				ЭтоПолучатель = ?(СтрокаДокумента.СсылкаКонтрагент = СтрокаДокумента.ПолучательСтрока, Истина, Ложь); 
				НовыйКонтрагент = Справочники.Контрагенты.СоздатьЭлемент();
				НовыйКонтрагент.Родитель = ПапкаДляСохраненияКонтрагента;
				НовыйКонтрагент.Наименование = Сред(НаименованиеКонтрагента,4);
				НовыйКонтрагент.НаименованиеПолное = Сред(НаименованиеКонтрагента,4);
				НовыйКонтрагент.ВидКонтрагента = Перечисления.ВидКонтрагента.ЮрЛицо;
				НовыйКонтрагент.ИНН = ?(ЭтоПолучатель, СтрокаДокумента.ПолучательИНН, СтрокаДокумента.ПлательщикИНН);
				НовыйКонтрагент.КПП = ?(ЭтоПолучатель, СтрокаДокумента.ПолучательКПП, СтрокаДокумента.ПлательщикКПП);
				
				// №6293 определяем для нового элемента группу доступа из карточки пользователя
				НовыйКонтрагент.ГруппаДоступа = ГруппаДоступаДляНовыхКонтрагентов;
				
				НовыйКонтрагент.Записать();
				
				НовыйКонтрагент.ОсновнойДоговор = СоздатьДоговорСКонтрагентом(НовыйКонтрагент.Ссылка);
				
				//Для создания счета, определим параметры
				ПараметрыСчета = Новый Структура;
				ПараметрыСчета.Вставить("Контрагент", 		НовыйКонтрагент.Ссылка);
				ПараметрыСчета.Вставить("РасчетныйСчет",	?(ЭтоПолучатель, СтрокаДокумента.ПолучательСчет, 				СтрокаДокумента.ПлательщикСчет));
				ПараметрыСчета.Вставить("БИК",				?(ЭтоПолучатель, СтрокаДокумента.ПолучательБИК, 				СтрокаДокумента.ПлательщикБИК));
				ПараметрыСчета.Вставить("КорСчет",			?(ЭтоПолучатель, СтрокаДокумента.ПолучательКорсчет, 			СтрокаДокумента.ПлательщикКорсчет));
				ПараметрыСчета.Вставить("Банк",				?(ЭтоПолучатель, СтрокаДокумента.ПолучательБанкНаименование, 	СтрокаДокумента.ПлательщикБанкНаименование));
				ПараметрыСчета.Вставить("БанкАдрес",		?(ЭтоПолучатель, СтрокаДокумента.ПолучательБанкАдрес, 			СтрокаДокумента.ПлательщикБанкАдрес));
				
				НовыйКонтрагент.ОсновнойБанковскийСчет = СоздатьСчетКонтрагента(ПараметрыСчета); 
				НовыйКонтрагент.Записать();
				ПерезаполнитьКонтрагентов(НаименованиеКонтрагента, НовыйКонтрагент.Ссылка);
				УдалосьСоздать = Истина;
			Исключение
				УдалосьСоздать = Ложь;
				Сообщить ("Не удалось создать Контрагента """ + НаименованиеКонтрагента + """ по причине:
				|" + ОписаниеОшибки(), СтатусСообщения.Внимание);
			КонецПопытки;			
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Возврат УдалосьСоздать;
КонецФункции

&НаСервере
Функция СоздатьКонтрагентовНаСервереУдалось()
	ТЗ = Объект.Документы.Выгрузить();
	ТЗ.Свернуть("СсылкаКонтрагент");
	УдалосьСоздать = Истина;
	Для Каждого ТекущийКонтрагент из ТЗ Цикл
		Если ТипЗнч(ТекущийКонтрагент.СсылкаКонтрагент) = Тип("Строка") Тогда 
			УдалосьСоздать = СоздатьТекущегоКонтрагента(ТекущийКонтрагент.СсылкаКонтрагент);
		КонецЕсли;
	КонецЦикла;	
	Возврат  УдалосьСоздать;
КонецФункции

&НаСервере
Функция ЭтоГруппа()
	Возврат ПапкаДляСохраненияКонтрагента.ЭтоГруппа;
КонецФункции

&НаКлиенте
Процедура СоздатьКонтрагентов(Команда)
	Если Объект.Документы.Количество() = 0 Тогда 
		Сообщение = Новый СообщениеПользователю();
		Сообщение.Текст = "Таблица документов пустая";
		Сообщение.Поле = "Документы";
		Сообщение.УстановитьДанные(Объект);
		Сообщение.Сообщить();		
		Возврат;
	КонецЕсли;
	
	Если ПапкаДляСохраненияКонтрагента.Пустая() Тогда  
		Сообщение = Новый СообщениеПользователю();
		Сообщение.Текст = "Необходимо выбрать папку для сохранения созданных контрагентов";
		Сообщение.Поле = "ПапкаДляСохраненияКонтрагента";
		Сообщение.УстановитьДанные(ЭтотОбъект);
		Сообщение.Сообщить();
		Возврат;
	КонецЕсли;
	
	Если не ЭтоГруппа() Тогда
		Сообщение = Новый СообщениеПользователю();
		Сообщение.Текст = "Выбрана не папка";
		Сообщение.Поле = "ПапкаДляСохраненияКонтрагента";
		Сообщение.УстановитьДанные(ЭтотОбъект);
		Сообщение.Сообщить();
		Возврат;
	КонецЕсли;   		
		
	Элементы.ГруппаСоздатьКонтрагента.Видимость = не СоздатьКонтрагентовНаСервереУдалось();
	
КонецПроцедуры

&НаКлиенте
Процедура ПапкаДляСохраненияКонтрагентаСоздание(Элемент, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	
	ОткрытьФорму("Справочник.Контрагенты.ФормаГруппы", Новый Структура("Ключ",ПредопределенноеЗначение("Справочник.Контрагенты.ПустаяСсылка")));
КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформлениеЗагрузка()
	
	УсловноеОформление.Элементы.Очистить();
	
	// ДокументыКИмпортуДокументНеЗагружен
	
	ЭлементУО = УсловноеОформление.Элементы.Добавить();

	ПолеЭлемента 		= ЭлементУО.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле 	= Новый ПолеКомпоновкиДанных("ДокументыДокументНеЗагружен");

	Элемент = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Элемент.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.Документы.СсылкаДокумент");
	Элемент.ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено;
	Элемент.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный;
	
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru = 'Не загружен'"));
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ТекстЗапрещеннойЯчейкиЦвет);
	
	// ДокументыКИмпортуДокументНеЗагружен
	
	ЭлементУО = УсловноеОформление.Элементы.Добавить();

	ПолеЭлемента 		= ЭлементУО.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле 	= Новый ПолеКомпоновкиДанных("ДокументыДокументНеЗагружен");

	Элемент = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Элемент.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.Документы.СсылкаДокумент");
	Элемент.ВидСравнения = ВидСравненияКомпоновкиДанных.Заполнено;
	Элемент.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный;
	
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Видимость", Ложь);

	// Документы Документ
	
	ЭлементУО = УсловноеОформление.Элементы.Добавить();

	ПолеЭлемента 		= ЭлементУО.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле 	= Новый ПолеКомпоновкиДанных("ДокументыСсылкаДокумент");

	Элемент = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Элемент.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.Документы.СсылкаДокумент");
	Элемент.ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено;
	Элемент.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный;
	
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Видимость", Ложь);


	// Документы Контрагент

	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	
	ПолеЭлемента 		= ЭлементУО.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле 	= Новый ПолеКомпоновкиДанных("ДокументыСсылкаКонтрагент");

	Элемент = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Элемент.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.Документы.СсылкаКонтрагент");
	Элемент.ВидСравнения = ВидСравненияКомпоновкиДанных.НачинаетсяС;
	Элемент.ПравоеЗначение = "!!!";
	Элемент.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный;
	
	//ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", Новый ПолеКомпоновкиДанных("ДокументыСсылкаКонтрагент"));
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ПоясняющийОшибкуТекст);
	
КонецПроцедуры


