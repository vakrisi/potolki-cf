&НаСервере
Функция ЕстьОтмеченныеСтрокиКВыгрузке()
	Результат = Ложь;
	Для Каждого Стр из Объект.ДокументыНаВыгрузку Цикл
		Если Стр.Выгружать Тогда 
			Результат = Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

&НаКлиенте
Процедура ВыгрузитьВФайл(Команда)
			
	Если не ЕстьОтмеченныеСтрокиКВыгрузке() Тогда	
		ПоказатьПредупреждение(,"Не выбраны строки для выгрузки");
		Возврат;
	КонецЕсли;
	
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Сохранение);
	Диалог.ПолноеИмяФайла = "1c_to_kl.txt";
	Диалог.Заголовок = "Выберите имя файла для сохранения";              	
	Диалог.МножественныйВыбор = Ложь;                                    	
	Диалог.Фильтр = "Текстовый файл(*.txt)|*.txt";                       
	
	Если Объект.Кодировка = "DOS" Тогда
		КодировкаФайла = КодировкаТекста.OEM;
	ИначеЕсли Объект.Кодировка = "UTF8" Тогда 
		КодировкаФайла = КодировкаТекста.UTF8;
	Иначе
		КодировкаФайла = КодировкаТекста.ANSI;
	КонецЕсли;
	
	//Вызов собственно диалога на экран                                  	
	Если Диалог.Выбрать() Тогда                                          		
		//Сюда попадем только если пользователь нажал ОК                     	
		//Сохранение выбранного имени файла (полного имени, значит включая путь к нему)		
		ИмяФайла = Диалог.ПолноеИмяФайла;				
		Файл = Новый ЗаписьТекста(ИмяФайла, КодировкаФайла);
		МассивСтрокФайла = СформироватьФайлОбменаСБанком();
		Для каждого СтрокаМассива из МассивСтрокФайла Цикл
			Файл.ЗаписатьСтроку(СтрокаМассива);
		КонецЦикла;
		Файл.Закрыть();
		
		ПоказатьПредупреждение(,"Документы выгружены");
	КонецЕсли;
	
КонецПроцедуры

