&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ПериодПлатежныхПорученийИсходящих.Вариант = ВариантСтандартногоПериода.Сегодня;
КонецПроцедуры

&НаСервере
Процедура ПриЗагрузкеДанныхИзНастроекНаСервере(Настройки)
	
	Если Объект.ВерсияФормата = "1.02" Тогда
		Объект.ВерсияФормата = "1.03";
		СохраняемыеВНастройкахДанныеМодифицированы = Истина;		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗагрузкаВыбратьВсе(Команда)
	ОтметитьСтроки("Документы", "Загружать", Истина);
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузкаОтменитьВсе(Команда)
	ОтметитьСтроки("Документы", "Загружать", Ложь);
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузкаВыбратьВсе(Команда)
	ОтметитьСтроки("ДокументыНаВыгрузку", "Выгружать", Истина);
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузкаОтменитьВсе(Команда)
	ОтметитьСтроки("ДокументыНаВыгрузку", "Выгружать", Ложь);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ОтметитьСтроки(ИмяТабличнойЧасти, ИмяРеквизитаТЧ, Пометка = Истина)
	
	Для Каждого СтрокаТабличнойЧасти из Объект[ИмяТабличнойЧасти] Цикл
		СтрокаТабличнойЧасти[ИмяРеквизитаТЧ] = Пометка;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

&НаСервере
Процедура ОбновитьСтатусыДокументов()
	Для Каждого ТекущаяСтрока Из Объект.Документы Цикл
		Если ТекущаяСтрока.СсылкаДокумент = Неопределено Или ТекущаяСтрока.СсылкаДокумент.Пустая() тогда
			ТекущаяСтрока.СостояниеДокумента = 3;
		ИначеЕсли ТекущаяСтрока.СсылкаДокумент.Проведен Тогда
			ТекущаяСтрока.СостояниеДокумента = 1;
		ИначеЕсли ТекущаяСтрока.СсылкаДокумент.ПометкаУдаления Тогда
			ТекущаяСтрока.СостояниеДокумента = 2;
		Иначе
			ТекущаяСтрока.СостояниеДокумента = 0;
		КонецЕсли;		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ПрочитатьВыбранныйФайл(Текст)
	
	Если Объект.ВерсияФормата = "2.00" Тогда
		// версия для Казахстана
		ПрочитатьВыбранныйФайлФорма_2_00(Текст.ПолучитьТекст());	
		Возврат;
	КонецЕсли;
	
	ОбщийМодуль.ПрочитатьФайлОбменаСБанком(ЭтаФорма, Текст);
	ОбновитьСтатусыДокументов();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьВыборФайла(Результат, Адрес, ВыбранноеИмяФайла, ДополнительныеПараметры) Экспорт
	
	#Если ВебКлиент Тогда
		Если Не ПодключитьРасширениеРаботыСФайлами() Тогда
			УстановитьРасширениеРаботыСФайлами();
		КонецЕсли;	
		СтрокаПреобразования = "";
	#КонецЕсли
	
	Если Не Результат Тогда
		Возврат;
	КонецЕсли; 
	
	Если Объект.Кодировка = "DOS" Тогда
		КодировкаФайла = КодировкаТекста.OEM;
	ИначеЕсли Объект.Кодировка = "UTF8" Тогда 
		КодировкаФайла = КодировкаТекста.UTF8;
	Иначе
		КодировкаФайла = КодировкаТекста.ANSI;
	КонецЕсли;

	Текст = Новый ТекстовыйДокумент;
	Текст.Прочитать(ВыбранноеИмяФайла, КодировкаФайла);
	
	Попытка
		Текст.Прочитать(ВыбранноеИмяФайла,КодировкаФайла);
	Исключение
		Сообщить("Файл не прочитан.", СтатусСообщения.Внимание);
		Возврат;
	КонецПопытки;

	Если Текст.КоличествоСтрок()<1 Тогда
		Сообщить("В файл нет данных!");
		Возврат;
	КонецЕсли;

	Если СокрЛП(Врег(Текст.ПолучитьСтроку(1)))<>"1CCLIENTBANKEXCHANGE" Тогда
		Сообщить("Указанный файл не является файлом обмена или неверно указана кодировка!");
		Возврат;
	КонецЕсли;
	
	ПрочитатьВыбранныйФайл(Текст);
	УстановитьУсловноеОформлениеЗагрузка();

КонецПроцедуры

&НаСервере
Функция ИННОрганизацииЗаполнен()
	Если ПустаяСтрока(Объект.Организация.ИНН) Тогда
		Возврат Ложь;
	Иначе
		Возврат Истина;
	КонецЕсли;
КонецФункции

&НаСервере
Функция ОбязательноеЗаполнениеСтатьиВДенежныхДокументах()
	Возврат Константы.ОбязательноеЗаполнениеСтатьиВДенежныхДокументах.Получить();
КонецФункции

&НаКлиенте
Процедура ПрочитатьФайл(Команда)
	Если Объект.Организация.Пустая() Тогда
		ПоказатьОповещениеПользователя("Сначала следует выбрать организацию");
		Возврат;
	КонецЕсли;
	
	//2022-05-24 (Ильнур) закомментировано: для схемы когда упр.организация одна, а ЮЛ несколько
	//Если НЕ ИННОрганизацииЗаполнен() тогда
	//	ПоказатьОповещениеПользователя("У выбранной организации не заполнен ИНН");
	//	Возврат;
	//КонецЕсли;
	
	Если ОбязательноеЗаполнениеСтатьиВДенежныхДокументах() Тогда
		Если Объект.СтатьяПоступление.Пустая() Тогда
			ПоказатьОповещениеПользователя("Необходимо указать статью ДДС для загружаемых документов поступления на расчетный счет");
			Возврат;
		КонецЕсли;
		Если Объект.СтатьяСписание.Пустая() Тогда
			ПоказатьОповещениеПользователя("Необходимо указать статью ДДС для загружаемых документов списания с расчетного счета");
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	Оповещение = Новый ОписаниеОповещения("ОбработатьВыборФайла", ЭтотОбъект);
	НачатьПомещениеФайла(Оповещение, , , Истина, УникальныйИдентификатор);
КонецПроцедуры

&НаКлиенте
Процедура ДокументыСсылкаБанковскийСчетКонтрагентаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	НовыйПараметр = Новый ПараметрВыбора("Отбор.Владелец", Элементы.Документы.ТекущиеДанные.СсылкаКонтрагент);
    НовыйМассив = Новый Массив();
    НовыйМассив.Добавить(НовыйПараметр);
    НовыеПараметры = Новый ФиксированныйМассив(НовыйМассив);
    Элемент.ПараметрыВыбора = НовыеПараметры;
КонецПроцедуры

&НаСервере
Процедура СоздатьДокументыНаСервере()
	
	Для Каждого ТекущаяСтрока Из Объект.Документы Цикл
		Если НЕ ТекущаяСтрока.Загружать Тогда
			Продолжить;
		КонецЕсли;
		
		Если ТекущаяСтрока.ЭтоПоступление Тогда
			
			ДокументСсылка = ТекущаяСтрока.СсылкаДокумент;
			Если ДокументСсылка = Неопределено или ДокументСсылка.Пустая() Тогда
				ДокументОбъект = Документы.ПоступлениеНаРасчетныйСчет.СоздатьДокумент();
			Иначе
				ДокументОбъект = ДокументСсылка.ПолучитьОбъект();
			КонецЕсли;
			ОбщийМодуль.ЗаполнитьШапкуДокумента(ДокументОбъект);
			ДокументОбъект.Дата = ТекущаяСтрока.Дата;
			ДокументОбъект.Организация = Объект.Организация;
			ДокументОбъект.Счет = ТекущаяСтрока.СсылкаБанковскийСчетОрганизации;
			ДокументОбъект.Валюта = ДокументОбъект.Счет.Валюта;
			ДокументОбъект.ВидОперации = Обработки.ОбменСБанком.ОпределитьВидОперации(ТекущаяСтрока.ВидОплаты, Истина); //Перечисления.ВидыОперацийПоступлениеНаРасчетныйСчет.ОплатаОтПокупателя;
			ДокументОбъект.Контрагент = ТекущаяСтрока.СсылкаКонтрагент;
			ДокументОбъект.Договор = ДокументОбъект.Контрагент.ОсновнойДоговор;
			ДокументОбъект.Сумма = ТекущаяСтрока.Сумма;
			ДокументОбъект.ВхНомер = ТекущаяСтрока.Номер;
			ДокументОбъект.ВхДата = ТекущаяСтрока.Дата;
			ДокументОбъект.НазначениеПлатежа = ТекущаяСтрока.НазначениеПлатежа;
			ДокументОбъект.Статья = Объект.СтатьяПоступление;
						
			УчитыватьНДС = УчетНДС.ОрганизацияЯвляетсяПлательщикомНДС(ДокументОбъект.Организация);
	 		ДокументОбъект.СтавкаНДС = УчетНДС.СтавкаНДСПоУмолчанию(ДокументОбъект.Организация);	
			ФинансыКлиентСервер.ПересчитатьСуммуНДС(ДокументОбъект, УчитыватьНДС);
			
			Попытка
				ДокументОбъект.Записать();
				Попытка
					Если Объект.ДействиеПриЗагрузкеПоступлений = 0 Тогда
						Если ДокументОбъект.Проведен Тогда
							ДокументОбъект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
						КонецЕсли;
					ИначеЕсли Объект.ДействиеПриЗагрузкеПоступлений = 1 Тогда
						ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
					КонецЕсли;
				Исключение
					Сообщить("Не удалось произвести проведение/отмену проведения " + ДокументОбъект.Ссылка + ". Ошибка: " + ОписаниеОшибки());
				КонецПопытки;
				
				ТекущаяСтрока.СсылкаДокумент = ДокументОбъект.Ссылка;
				ТекущаяСтрока.Загружать = Ложь;
				
			Исключение
				Сообщить("Не удалось создать документ для платежного поручения №" + ТекущаяСтрока.Номер + ". Ошибка: " + ОписаниеОшибки());
			КонецПопытки;
			
		Иначе
			
			ДокументСсылка = ТекущаяСтрока.СсылкаДокумент;
			Если ДокументСсылка = Неопределено или ДокументСсылка.Пустая() Тогда
				ДокументОбъект = Документы.СписаниеСРасчетногоСчета.СоздатьДокумент();
			Иначе
				ДокументОбъект = ДокументСсылка.ПолучитьОбъект();
			КонецЕсли;
			ОбщийМодуль.ЗаполнитьШапкуДокумента(ДокументОбъект);
			ДокументОбъект.Дата = ТекущаяСтрока.Дата;
			ДокументОбъект.Организация = Объект.Организация;
			ДокументОбъект.Счет = ТекущаяСтрока.СсылкаБанковскийСчетОрганизации;
			ДокументОбъект.Валюта = ДокументОбъект.Счет.Валюта;
			ДокументОбъект.ВидОперации = Обработки.ОбменСБанком.ОпределитьВидОперации(ТекущаяСтрока.ВидОплаты, Ложь, НЕ ПустаяСтрока(ТекущаяСтрока.СтатусСоставителя),,ТекущаяСтрока.ОчередностьПлатежа, ТекущаяСтрока.СсылкаКонтрагент); //Перечисления.ВидыОперацийСписаниеСРасчетногоСчета.ОплатаПоставщику;
			ДокументОбъект.Контрагент = ТекущаяСтрока.СсылкаКонтрагент;
			Если НЕ ДокументОбъект.ВидОперации = Перечисления.ВидыОперацийСписаниеСРасчетногоСчета.ЗарплатаСотрудникам
				И НЕ ДокументОбъект.ВидОперации = Перечисления.ВидыОперацийСписаниеСРасчетногоСчета.ЗарплатаСотруднику 
				И НЕ ДокументОбъект.ВидОперации = Перечисления.ВидыОперацийСписаниеСРасчетногоСчета.ВыдачаПодотчетнику
				И ТипЗнч(ДокументОбъект.Контрагент) = Тип("СправочникСсылка.Контрагенты") // №11762
			Тогда
				ДокументОбъект.Договор = ДокументОбъект.Контрагент.ОсновнойДоговор;
			КонецЕсли;	
			ДокументОбъект.СчетКонтрагента = Обработки.ОбменСБанком.НайтиБанковскийСчетКонтрагента(ДокументОбъект.Контрагент, ТекущаяСтрока.ПолучательСчет);
			ДокументОбъект.Сумма = ТекущаяСтрока.Сумма;
			ДокументОбъект.ИсхНомер = ТекущаяСтрока.Номер;
			ДокументОбъект.ИсхДата = ТекущаяСтрока.Дата;
			ДокументОбъект.НазначениеПлатежа = ТекущаяСтрока.НазначениеПлатежа;
			ДокументОбъект.Статья = Объект.СтатьяСписание;
			
			ДокументОбъект.ИдентификаторПлатежа = ТекущаяСтрока.ИдентификаторПлатежа;
			ДокументОбъект.ОчередностьПлатежа = ТекущаяСтрока.ОчередностьПлатежа;
			ДокументОбъект.КодВидаДохода = ТекущаяСтрока.КодНазПлатежа;
			
			Если НЕ ПустаяСтрока(ТекущаяСтрока.СтатусСоставителя) Тогда
				ДокументОбъект.ПеречислениеВБюджет = Истина;	
				ЗаполнитьЗначенияСвойств(ДокументОбъект, ТекущаяСтрока, "СтатусСоставителя,КодБК,КодОКАТО,ПоказательОснования,ПоказательПериода,ПоказательНомера,ПоказательДаты,ПоказательТипа");
			КонецЕсли;
			
			//ДокументОбъект.Оплачено = Истина;
			Если ДокументОбъект.Проведен Тогда
				ДокументОбъект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
			Иначе
				ДокументОбъект.Записать();
			КонецЕсли;
			ТекущаяСтрока.СсылкаДокумент = ДокументОбъект.Ссылка;
			ТекущаяСтрока.Загружать = Ложь;
			
			Попытка
				ДокументОбъект.Записать();
				Попытка
					Если Объект.ДействиеПриЗагрузкеСписаний = 0 Тогда
						Если ДокументОбъект.Проведен Тогда
							ДокументОбъект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
						КонецЕсли;
					ИначеЕсли Объект.ДействиеПриЗагрузкеСписаний = 1 Тогда
						ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
					КонецЕсли;
				Исключение
					Сообщить("Не удалось произвести проведение/отмену проведения " + ДокументОбъект.Ссылка + ". Ошибка: " + ОписаниеОшибки());
				КонецПопытки;
				
				ТекущаяСтрока.СсылкаДокумент = ДокументОбъект.Ссылка;
				ТекущаяСтрока.Загружать = Ложь;
				
			Исключение
				Сообщить("Не удалось создать документ для платежного поручения №" + ТекущаяСтрока.Номер + ". Ошибка: " + ОписаниеОшибки());
			КонецПопытки;
			
			//#3762
			Если ЗначениеЗаполнено(ТекущаяСтрока.ПлатежноеПоручение) Тогда
				ПлатежОбъект = ТекущаяСтрока.ПлатежноеПоручение.ПолучитьОбъект();
				ПлатежОбъект.Оплачено = Истина;
				Попытка
					ПлатежОбъект.Записать();
				Исключение
				КонецПопытки;
			КонецЕсли;
			
		КонецЕсли;
	КонецЦикла;
	
	ОбновитьСтатусыДокументов();
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьДокументы(Команда)
	СоздатьДокументыНаСервере();
	Элементы.Документы.Обновить();
	ПоказатьОповещениеПользователя("Создание документов завершено. Вам следует проверить и провести документы");
КонецПроцедуры

&НаКлиенте
Процедура ДокументыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	Если НЕ Элементы.Документы.ТекущиеДанные.СсылкаДокумент = Неопределено Тогда
		Если НЕ Элементы.Документы.ТекущиеДанные.СсылкаДокумент.Пустая() Тогда
			СтандартнаяОбработка = Ложь;
			Если Элементы.Документы.ТекущиеДанные.ЭтоПоступлениеКартинка = 0 Тогда
				Парам = Новый Структура;
				Парам.Вставить("Ключ",Элементы.Документы.ТекущиеДанные.СсылкаДокумент);
				ОткрытьФорму("Документ.СписаниеСРасчетногоСчета.Форма.ФормаДокумента",Парам);
			Иначе
				Парам = Новый Структура;
				Парам.Вставить("Ключ",Элементы.Документы.ТекущиеДанные.СсылкаДокумент);
				ОткрытьФорму("Документ.ПоступлениеНаРасчетныйСчет.Форма.ФормаДокумента",Парам);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ВыбратьДокументыНаСервере()
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ПлатежноеПоручение.Ссылка КАК Ссылка,
	|	ПлатежноеПоручение.Номер КАК Номер,
	|	ПлатежноеПоручение.Дата КАК Дата,
	|	ПлатежноеПоручение.Проведен КАК Проведен,
	|	ПлатежноеПоручение.Валюта КАК Валюта,
	|	ПлатежноеПоручение.ВидОперации КАК ВидОперации,
	|	ПлатежноеПоручение.Договор КАК Договор,
	|	ПлатежноеПоручение.Комментарий КАК Комментарий,
	|	ПлатежноеПоручение.Контрагент КАК Контрагент,
	|	ПлатежноеПоручение.СчетКонтрагента КАК СчетКонтрагента,
	|	ПлатежноеПоручение.Организация КАК Организация,
	|	ПлатежноеПоручение.Автор КАК Автор,
	|	ПлатежноеПоручение.Статья КАК Статья,
	|	ПлатежноеПоручение.Сумма КАК Сумма,
	|	ПлатежноеПоручение.Счет КАК Счет,
	|	ПлатежноеПоручение.ИсхНомер КАК ИсхНомер,
	|	ПлатежноеПоручение.ИсхДата КАК ИсхДата,
	|	ПлатежноеПоручение.НазначениеПлатежа КАК НазначениеПлатежа,
	|	ПлатежноеПоручение.ПеречислениеВБюджет КАК ПеречислениеВБюджет,
	|	ПлатежноеПоручение.СтатусСоставителя КАК СтатусСоставителя,
	|	ПлатежноеПоручение.КодБК КАК КодБК,
	|	ПлатежноеПоручение.КодОКАТО КАК КодОКАТО,
	|	ПлатежноеПоручение.ПоказательОснования КАК ПоказательОснования,
	|	ПлатежноеПоручение.ПоказательПериода КАК ПоказательПериода,
	|	ПлатежноеПоручение.ПоказательНомера КАК ПоказательНомера,
	|	ПлатежноеПоручение.ПоказательДаты КАК ПоказательДаты,
	|	ПлатежноеПоручение.ПоказательТипа КАК ПоказательТипа,
	|	ПлатежноеПоручение.ОчередностьПлатежа КАК ОчередностьПлатежа,
	|	ПлатежноеПоручение.ИдентификаторПлатежа КАК ИдентификаторПлатежа,
	|	ПлатежноеПоручение.КодВидаДохода КАК КодНазПлатежа
	|ИЗ
	|	Документ.ПлатежноеПоручениеИсходящее КАК ПлатежноеПоручение
	|ГДЕ
	|	ПлатежноеПоручение.Дата МЕЖДУ &ДатаНач И &ДатаКон
	|	И ПлатежноеПоручение.Проведен
	|	И НЕ ПлатежноеПоручение.Оплачено
	|	И ПлатежноеПоручение.Счет = &Счет";
	
	Запрос.УстановитьПараметр("ДатаНач", НачалоДня(ПериодПлатежныхПорученийИсходящих.ДатаНачала));
	Запрос.УстановитьПараметр("ДатаКон", КонецДня(ПериодПлатежныхПорученийИсходящих.ДатаОкончания));
	Запрос.УстановитьПараметр("Счет", Объект.РасчетныйСчет);
	
	Результат = Запрос.Выполнить();
	
	Если Результат.Пустой() Тогда 
		Сообщить("За указанный период документы для выгрузки в банк отсутствуют");
		Возврат;
	КонецЕсли;
	
	Объект.ДокументыНаВыгрузку.Очистить();

	Выборка = Результат.Выбрать();
	
	Пока Выборка.Следующий() Цикл 
		НоваяСтрока = Объект.ДокументыНаВыгрузку.Добавить();
		НоваяСтрока.Номер = ПрефиксацияОбъектовКлиентСервер.НомерНаПечать(Выборка.Номер); //Число(Выборка.Номер);
		НоваяСтрока.Дата = Выборка.Дата;
		НоваяСтрока.Сумма = Выборка.Сумма;		
		НоваяСтрока.ПолучательИНН = Выборка.Контрагент.ИНН;
		
		НоваяСтрока.ПолучательСчет = Выборка.СчетКонтрагента.НомерСчета;
		Если ТипЗнч(Выборка.Контрагент) = Тип("СправочникСсылка.Сотрудники") Тогда
			НоваяСтрока.ПолучательНаименование = Выборка.Контрагент.Наименование;
		Иначе
			НоваяСтрока.ПолучательКПП = Выборка.Контрагент.КПП;
			НоваяСтрока.ПолучательНаименование = ?(НЕ ПустаяСтрока(Выборка.Контрагент.НаименованиеПолное), Выборка.Контрагент.НаименованиеПолное, Выборка.Контрагент.Наименование);
		КонецЕсли;
		
		НоваяСтрока.СсылкаДокумент = Выборка.Ссылка;		
		НоваяСтрока.ПолучательБИК = Выборка.СчетКонтрагента.БИК;
		НоваяСтрока.НазначениеПлатежа = Выборка.НазначениеПлатежа;
		НоваяСтрока.СсылкаКонтрагент = Выборка.Контрагент;
		НоваяСтрока.ПолучательКорсчет = Выборка.СчетКонтрагента.КоррСчет;
		НоваяСтрока.ПолучательНаименованиеБанка = Выборка.СчетКонтрагента.НаименованиеБанка;		
		НоваяСтрока.ПолучательГородБанка = Выборка.СчетКонтрагента.ГородБанка;
		
		НоваяСтрока.СсылкаБанковскийСчетКонтрагента = Выборка.СчетКонтрагента;
		НоваяСтрока.СсылкаБанковскийСчетОрганизацииВалюта = Выборка.Валюта;
		НоваяСтрока.ПлательщикСчет = Выборка.Счет.НомерСчета;
		НоваяСтрока.ПлательщикИНН = Объект.Организация.ИНН;
		НоваяСтрока.ПлательщикКПП = Объект.Организация.КПП;
		НоваяСтрока.ПлательщикБИК = Выборка.Счет.БИК;
		НоваяСтрока.СсылкаБанковскийСчетОрганизации = Выборка.Счет;
		НоваяСтрока.ПлательщикКорсчет = Выборка.Счет.КоррСчет;
		НоваяСтрока.ПлательщикНаименованиеБанка = Выборка.Счет.НаименованиеБанка;
		НоваяСтрока.ПлательщикНаименование = ?(НЕ ПустаяСтрока(Выборка.Организация.ПолноеНаименование), Выборка.Организация.ПолноеНаименование, Выборка.Организация.Наименование);
		НоваяСтрока.ПлательщикГородБанка = Выборка.Счет.ГородБанка;
		
		Если Выборка.ПеречислениеВБюджет Тогда 
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка, "ПеречислениеВБюджет,СтатусСоставителя,КодБК,КодОКАТО,ПоказательОснования,ПоказательПериода,ПоказательНомера,ПоказательДаты");
		КонецЕсли;
		
		НоваяСтрока.ОчередностьПлатежа = ?(ЗначениеЗаполнено(Выборка.ОчередностьПлатежа), Выборка.ОчередностьПлатежа, 5);
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка, "ИдентификаторПлатежа, КодНазПлатежа");		
	КонецЦикла; 	
	
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьДокументы(Команда)
	
	Если Объект.Организация.Пустая() Тогда 
		ПоказатьПредупреждение(,"Не заполнено значение Организации");
		Возврат;
	КонецЕсли;
	
	Если Объект.РасчетныйСчет.Пустая() Тогда 
		ПоказатьПредупреждение(,"Не выбран расчетный счет организации");
		Возврат;
	КонецЕсли; 	
	
	ВыбратьДокументыНаСервере();
	
КонецПроцедуры

