&НаСервере
Процедура ПослеЗагрузкиДокументов()
	
	Для Каждого СтрокаДокумента Из Объект.Документы Цикл	
		//Распознаем реквизиты 
		Если СтрокаДокумента.ЭтоПоступление Тогда
			СтрокаДокумента.СсылкаБанковскийСчетОрганизации = Обработки.ОбменСБанком.НайтиБанковскийСчетПоНомеру(СтрокаДокумента.ПолучательСчет);
			СтрокаДокумента.СсылкаБанковскийСчетОрганизацииВалюта = СтрокаДокумента.СсылкаБанковскийСчетОрганизации.Валюта;
			Если НЕ ПустаяСтрока(СтрокаДокумента.ПлательщикИНН) Тогда
				СтрокаДокумента.СсылкаКонтрагент = Обработки.ОбменСБанком.НайтиКонтрагентаПоИНН(СтрокаДокумента.ПлательщикИНН);
			КонецЕсли;
			
			//Если не нашли контрагент, то показываем надпись и кнопку - "Создать контрагента"
			Если СтрокаДокумента.СсылкаКонтрагент.Пустая() Тогда
				СтрокаДокумента.СсылкаКонтрагент = СтрокаДокумента.ПлательщикСтрока; 
				Элементы.ГруппаСоздатьКонтрагента.Видимость = Истина;
			КонецЕсли;
			
			СтрокаДокумента.СсылкаДокумент = Обработки.ОбменСБанком.НайтиПоступлениеНаРасчетныйСчет(СтрокаДокумента.Номер, СтрокаДокумента.Дата);

		Иначе
			СтрокаДокумента.СсылкаБанковскийСчетОрганизации = Обработки.ОбменСБанком.НайтиБанковскийСчетПоНомеру(СтрокаДокумента.ПлательщикСчет);
			СтрокаДокумента.СсылкаБанковскийСчетОрганизацииВалюта = СтрокаДокумента.СсылкаБанковскийСчетОрганизации.Валюта;
			Если НЕ ПустаяСтрока(СтрокаДокумента.ПолучательИНН) Тогда
				СтрокаДокумента.СсылкаКонтрагент = Обработки.ОбменСБанком.НайтиКонтрагентаПоИНН(СтрокаДокумента.ПолучательИНН);
			КонецЕсли;
			//Если не нашли контрагент, то показываем надпись и кнопку - "Создать контрагента"
			Если СтрокаДокумента.СсылкаКонтрагент.Пустая() Тогда
				СтрокаДокумента.СсылкаКонтрагент = СтрокаДокумента.ПолучательСтрока; 
				Элементы.ГруппаСоздатьКонтрагента.Видимость = Истина;
			КонецЕсли;
			
			СтрокаДокумента.СсылкаДокумент = Обработки.ОбменСБанком.НайтиСписаниеСРасчетногоСчета(СтрокаДокумента.Номер, СтрокаДокумента.Дата);

		КонецЕсли;
		
		СтрокаДокумента.Загружать = Истина;		
	КонецЦикла;
	
	ОбновитьСтатусыДокументов();
	
КонецПроцедуры


// Загружает секцию документа
&НаСервере
Функция ЗагрузитьСекциюДокумента(СтрокаДокумента) //+
	
	СтрокаРазбора = ПолучитьСтрокуИмпорта();
	Приход = 0;
	Расход = 0;
	Пока Лев(Врег(СокрЛП(СтрокаРазбора)), 14) <> "КОНЕЦДОКУМЕНТА" Цикл
		
		Значение = "";
		Тег = "";
		
		Если РазобратьТеговуюСтроку(СтрокаРазбора, Тег, Значение) Тогда
			
			//Если Импорт_Загружаемые[Тег] = Истина Тогда
			//	Если  Тег = "ВИДДОКУМЕНТА" Тогда 
			//		СтрокаДокумента.Операция = Значение;
			//	Иначе
			//	СтрокаДокумента[Тег] = Значение;                 
			//	КонецЕсли;
			//КонецЕсли;
			Если Тег = "НОМЕРДОКУМЕНТА" Тогда 
				СтрокаДокумента.Номер = Значение;
			ИначеЕсли Тег = "ДАТАДОКУМЕНТА" Тогда
				СтрокаДокумента.Дата = Дата(Сред(Значение,7,4), Сред(Значение,4,2), Сред(Значение,0,2));
			ИначеЕсли Тег = "ПЛАТЕЛЬЩИКИИК" Тогда	
				СтрокаДокумента.ПлательщикСчет = Значение;
			ИначеЕсли Тег = "ПОЛУЧАТЕЛЬИИК" Тогда	
				СтрокаДокумента.ПолучательСчет = Значение;
			ИначеЕсли Тег = "ПЛАТЕЛЬЩИКБИН_ИИН" Тогда	
				СтрокаДокумента.ПлательщикИНН = Значение;
			ИначеЕсли Тег = "ПОЛУЧАТЕЛЬБИН_ИИН" Тогда	
				СтрокаДокумента.ПолучательИНН = Значение;
			ИначеЕсли Тег = "ПЛАТЕЛЬЩИКБАНКБИК" Тогда	
				СтрокаДокумента.ПлательщикБИК = Значение;
			ИначеЕсли Тег = "ПОЛУЧАТЕЛЬБАНКБИК" Тогда	
				СтрокаДокумента.ПолучательБИК = Значение;
			ИначеЕсли Тег = "ПЛАТЕЛЬЩИКНАИМЕНОВАНИЕ" Тогда	
				СтрокаДокумента.ПлательщикСтрока = "!!!" + Значение;
			ИначеЕсли Тег = "ПОЛУЧАТЕЛЬНАИМЕНОВАНИЕ" Тогда	
				СтрокаДокумента.ПолучательСтрока = "!!!" + Значение;
			ИначеЕсли Тег = "ПЛАТЕЛЬЩИКБАНКНАИМЕНОВАНИЕ" Тогда	
				СтрокаДокумента.ПлательщикБанкНаименование = Значение;
			ИначеЕсли Тег = "ПОЛУЧАТЕЛЬБАНКНАИМЕНОВАНИЕ" Тогда	
				СтрокаДокумента.ПолучательБанкНаименование = Значение;
				
			ИначеЕсли Тег = "НАЗНАЧЕНИЕПЛАТЕЖА" Тогда	
				СтрокаДокумента.НазначениеПлатежа = Значение;
				
			ИначеЕсли Тег = "СУММАПРИХОД" Тогда 
				//Приход = 1;
				СтрокаДокумента.Сумма = Значение;
				СтрокаДокумента.ЭтоПоступление = Истина;
				СтрокаДокумента.ЭтоПоступлениеКартинка = 1;
			ИначеЕсли Тег = "СУММАРАСХОД" Тогда 
				//Расход = 1;
				СтрокаДокумента.Сумма = Значение;
				СтрокаДокумента.ЭтоПоступление = Ложь;
				СтрокаДокумента.ЭтоПоступлениеКартинка = 0;
			КонецЕсли;		
			
		КонецЕсли;
		
		СтрокаРазбора = ПолучитьСтрокуИмпорта();
		
	КонецЦикла;
	
	//Если приход = 1 Тогда 
	//	СтрокаДокумента.ДатаПоступило = СтрокаДокумента.ДатаОперации;
	//КонецЕсли;
	//
	//Если Расход = 1 Тогда 
	//	СтрокаДокумента.ДатаСписано = СтрокаДокумента.ДатаОперации;
	//КонецЕсли;
		
	Возврат Истина;
	
КонецФункции

&НаСервере
Функция ЗагрузитьСекциюРасчСчета(СтрокаРССчета=Неопределено) 
	
	СтрокаРазбора = ПолучитьСтрокуИмпорта();
	
	Значение = "";
	Тег = "";
	
	Пока РазобратьТеговуюСтроку(СтрокаРазбора, Тег, Значение) Цикл   
		
		Если ТегиРасчетногоСчета[Тег] = Истина Тогда
			//СтрокаРССчета[Тег] = Значение;       
			
		Иначе
			Если Тег = "РАСЧЕТНЫЙСЧЕТ" Тогда 
				//СтрокаРССчета["РасчСчет"] = Значение;
			ИначеЕсли Тег = "НАЧАЛЬНЫЙ ОСТАТОК" Тогда
				//СтрокаРССчета["НачальныйОстаток"] = Значение;
			Иначе
				
				// неправильный реквизит заголовка
				Сообщить("Неверный реквизит в секции описания расчетного счета, строка " + (Импорт_ТекущаяСтрока - 1) + " : " + СтрокаРазбора);
				Возврат Ложь;
			КонецЕсли;
			
		КонецЕсли;
		
		СтрокаРазбора = ПолучитьСтрокуИмпорта();
		
		Значение = "";
		Тег = "";
		
	КонецЦикла;
	
	Если ВРЕГ(Лев(СокрЛП(СтрокаРазбора), 13)) = "КОНЕЦРАСЧСЧЕТ" Тогда
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции

&НаСервере
Функция ЗагрузитьСтрокуЗаголовка(ТекстСтрокиЗаголовка) 
	
	Значение = "";
	Тег = "";
	РазобратьТеговуюСтроку(ТекстСтрокиЗаголовка, Тег, Значение);
	
	Если ТегиЗаголовка[Тег] = Истина Тогда
		Импорт_Заголовок[Тег] = Значение;
		
	Иначе
		// неправильный реквизит заголовка
		Сообщить("Неверный реквизит заголовка, строка " + (Импорт_ТекущаяСтрока - 1) + " : " + ТекстСтрокиЗаголовка);
		
	КонецЕсли;
		
КонецФункции

&НаСервере
Функция ПолучитьСтрокуИмпорта()
	
	Буфер = "";
	
	Пока (ПустаяСтрока(Буфер)) ИЛИ (Лев(Буфер, 2) = "//") Цикл
		Если Импорт_ТекущаяСтрока > Импорт_КоличествоСтрок Тогда
			Возврат "";
		КонецЕсли;
			
		Буфер = СокрЛП(СтрПолучитьСтроку(Импорт_ТекстДляРазбора, Импорт_ТекущаяСтрока));
		Импорт_ТекущаяСтрока = Импорт_ТекущаяСтрока + 1;
		
	КонецЦикла;
	
	Возврат Буфер;
	
КонецФункции

&НаСервере
Функция РазобратьТеговуюСтроку(СтрокаРазбора, Тег, Значение)
	
	ПозицияПрисваивания = Найти(СтрокаРазбора, "=");
	Если ПозицияПрисваивания = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Тег = ВРЕГ(СокрЛП(Лев(СтрокаРазбора, ПозицияПрисваивания - 1)));
	Значение = СокрЛП(Сред(СтрокаРазбора, ПозицияПрисваивания + 1));
	
	Возврат НЕ ПустаяСтрока(Тег);
	
КонецФункции

&НаСервере
