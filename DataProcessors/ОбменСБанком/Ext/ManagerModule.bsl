	Пока Выборка.Следующий() Цикл
		Возврат Выборка.Ссылка;
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции

Функция ОпределитьВидОперации(ВидОплаты, ЭтоПоступление, ЭтоНалог = Ложь, РезультатСтрокой = Ложь, ОчередностьПлатежа = Неопределено, СсылкаКонтрагент = Неопределено) Экспорт
	Результат = Неопределено;
	Если ЭтоПоступление Тогда
		Результат = Перечисления.ВидыОперацийПоступлениеНаРасчетныйСчет.ОплатаОтПокупателя;
	Иначе
		Результат = Перечисления.ВидыОперацийСписаниеСРасчетногоСчета.ОплатаПоставщику;
	КонецЕсли;
	
	// 04 Поступило наличными по объявлению на взнос наличными, приходному кассовому ордеру, препроводительной ведомости к сумке 0402300 
	Если ВидОплаты = "04" И ЭтоПоступление Тогда
		Результат = Перечисления.ВидыОперацийПоступлениеНаРасчетныйСчет.ИнкассацияВБанк;	
	
	// 03 Оплачен наличными денежный чек, выдано по расходному кассовому ордеру 
	ИначеЕсли ВидОплаты = "03" И НЕ ЭтоПоступление Тогда
		Результат = Перечисления.ВидыОперацийСписаниеСРасчетногоСчета.ИнкассацияИзБанка;	
	 
	ИначеЕсли ЭтоНалог И НЕ ЭтоПоступление Тогда
		Результат = Перечисления.ВидыОперацийСписаниеСРасчетногоСчета.ПеречислениеНалоговИВзносов;
	
	ИначеЕсли НЕ ОчередностьПлатежа = Неопределено И НЕ ЭтоПоступление Тогда
		Если (ОчередностьПлатежа = 3 ИЛИ ОчередностьПлатежа = 2) Тогда
			Если ТипЗнч(СсылкаКонтрагент) = ТипЗнч(Справочники.Контрагенты.ПустаяСсылка()) Тогда
				Результат = Перечисления.ВидыОперацийСписаниеСРасчетногоСчета.ЗарплатаСотрудникам;
			Иначе
				Результат = Перечисления.ВидыОперацийСписаниеСРасчетногоСчета.ЗарплатаСотруднику;
			КонецЕсли;	
		КонецЕсли;	
	КонецЕсли;	
	
	Возврат ?(РезультатСтрокой, Строка(Результат), Результат);
	
КонецФункции

Функция ОбработатьПолеПлательщикПолучатель(НаименованиеКонтрагента) Экспорт
	
	//убираем ИНН из наименования	
	НомерСимволаИНННачало = СтрНайти(НаименованиеКонтрагента, "ИНН");
	
	Если НомерСимволаИНННачало = 0 Тогда
		Возврат НаименованиеКонтрагента;	
	КонецЕсли;
	
	НачПозПоиска = НомерСимволаИНННачало + 1;
	Попытка
		Если Сред(НаименованиеКонтрагента, НомерСимволаИНННачало + 3, 1) = " " Тогда
			НачПозПоиска = НомерСимволаИНННачало + 4;
		КонецЕсли;
	Исключение
	КонецПопытки;
	НомерСимволаИННКонец = СтрНайти(НаименованиеКонтрагента, " ", ,НачПозПоиска);
	Если НомерСимволаИННКонец = 0 Тогда
		НомерСимволаИННКонец = СтрДлина(НаименованиеКонтрагента);
	КонецЕсли;
	
	Если НомерСимволаИНННачало = 1 Тогда
		Результат = СокрЛП(Сред(НаименованиеКонтрагента, НомерСимволаИННКонец));
	Иначе
		Результат = СокрЛП(Сред(НаименованиеКонтрагента, 1, НомерСимволаИНННачало - 1));
	КонецЕсли;
	
	Возврат Результат;
		
КонецФункции

Процедура ЗаписатьНомерИДатуКлиентБанка(СсылкаДокумент, Номер, Дата) Экспорт
	Попытка
		ТекДокумент = СсылкаДокумент;
		ТекДокумент = ТекДокумент.Ссылка.ПолучитьОбъект();
		Если СокрЛП(ТекДокумент.ИсхНомер) = "" Тогда
			ТекДокумент.ИсхНомер = Номер;
			ТекДокумент.ИсхДата = Дата;
			Попытка
				ТекДокумент.Записать();
			Исключение
			КонецПопытки;	
		КонецЕсли;	
	Исключение
	КонецПопытки;
КонецПроцедуры	