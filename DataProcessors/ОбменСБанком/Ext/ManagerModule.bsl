Функция ПроверитьБанковскийСчет(СчетСтрокой, Организация) Экспорт
	
	СчетОрганизации = Справочники.БанковскиеСчета.ПустаяСсылка();
	
	//БанковскиеСчетаОрганизации = Справочники.БанковскиеСчета.Выбрать(,Организация);
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ Ссылка, НомерСчета ИЗ Справочник.БанковскиеСчета ГДЕ Владелец = &Организация";
	БанковскиеСчетаОрганизации = Запрос.Выполнить().Выбрать();
	
	Пока БанковскиеСчетаОрганизации.Следующий() Цикл
		Если СчетСтрокой = СокрЛП(БанковскиеСчетаОрганизации.НомерСчета) Тогда 
			СчетОрганизации = БанковскиеСчетаОрганизации.Ссылка;
		КонецЕсли;
	КонецЦикла;
	
	Возврат СчетОрганизации;
	
КонецФункции

Функция НайтиБанковскийСчетПоНомеру(Знач НомерСчета) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	БанковскиеСчета.Ссылка
	|ИЗ
	|	Справочник.БанковскиеСчета КАК БанковскиеСчета
	|ГДЕ
	|	БанковскиеСчета.НомерСчета = &НомерСчета";
	Запрос.УстановитьПараметр("НомерСчета", НомерСчета);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Возврат Выборка.Ссылка;
	КонецЦикла;
	
	Возврат Справочники.БанковскиеСчета.ПустаяСсылка();
КонецФункции

