	Элементы.ФильтрДоговорыДопМонтаж.Пометка = ФильтрДоговорыТребуетсяДополнительныйМонтаж;
	Элементы.ФильтрДоговорыРассрочки.Пометка = ЗаказДоговорОтборРассрочки;
	Элементы.УстановкаФильтраДоговорыМонтажНеНазначен.Пометка = ФильтрДоговорыМонтажНеНазначен;
	Элементы.УстановкаФильтраДоговорыМонтажНазначен.Пометка = ФильтрДоговорыМонтажНазначен;	
	
	Если ФильтрДоговорыМонтажНазначен 
		ИЛИ ФильтрДоговорыМонтажНеНазначен 
		ИЛИ ФильтрДоговорыТребуетсяДополнительныйМонтаж Тогда
		
		ЗаказДоговорОтборПоСтатусу = Справочники.СтатусыЗаказДоговоров.ВРаботе;
	КонецЕсли;
									
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(ЗаказДоговоры,
			"ТребуетсяДополнительныйМонтаж", ФильтрДоговорыТребуетсяДополнительныйМонтаж, ВидСравненияКомпоновкиДанных.Равно,, ФильтрДоговорыТребуетсяДополнительныйМонтаж);
	
	Если ФильтрДоговорыМонтажНеНазначен Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(ЗаказДоговоры,
			"СтатусЗаказаРозницыМонтаж", 0, ВидСравненияКомпоновкиДанных.Равно,, Истина);
	ИначеЕсли ФильтрДоговорыМонтажНазначен Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(ЗаказДоговоры,
			"СтатусЗаказаРозницыМонтаж", 1, ВидСравненияКомпоновкиДанных.Равно,, Истина);
	Иначе
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(ЗаказДоговоры,
			"СтатусЗаказаРозницыМонтаж", -1, ВидСравненияКомпоновкиДанных.Равно,, Ложь);
	КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(ЗаказДоговоры,
			"Подразделение", ЗаказДоговорОтборПоПодразделению, ВидСравненияКомпоновкиДанных.Равно,, НЕ ЗаказДоговорОтборПоПодразделению.Пустая());										
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(ЗаказДоговоры,
			"Контрагент", ЗаказДоговорОтборПоКонтрагенту, ВидСравненияКомпоновкиДанных.Равно,, НЕ ЗаказДоговорОтборПоКонтрагенту.Пустая());
	
	//#16242
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(ЗаказДоговоры,
			"ВидЗаказа", ЗаказДоговорОтборПоВиду, ВидСравненияКомпоновкиДанных.Равно,, НЕ ЗаказДоговорОтборПоВиду.Пустая());
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(ЗаказДоговоры,
			"ТекущийСтатус", ЗаказДоговорОтборПоСтатусу, ВидСравненияКомпоновкиДанных.Равно,, НЕ ЗаказДоговорОтборПоСтатусу.Пустая());										
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(ЗаказДоговоры,
			"Менеджер", ЗаказДоговорОтборПоМенеджеру, ВидСравненияКомпоновкиДанных.Равно,, НЕ ЗаказДоговорОтборПоМенеджеру.Пустая());
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(ЗаказДоговоры,
			"СостояниеОплаты", ЗаказДоговорОтборПоОплате, ВидСравненияКомпоновкиДанных.Равно,, ЗаказДоговорОтборПоОплате >= -1);

	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(ЗаказДоговоры,
			"ЭтоРассрочка", ЗаказДоговорОтборРассрочки, ВидСравненияКомпоновкиДанных.Равно,, ЗаказДоговорОтборРассрочки);
		
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(ЗаказДоговоры,
			"СостояниеВыполненияМонтажей", ЗаказДоговорОтборПоВыполнениюМонтажей, ВидСравненияКомпоновкиДанных.Равно,, ЗаказДоговорОтборПоВыполнениюМонтажей >= -1);
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(ЗаказДоговоры,
			"СостояниеПозицийВМонтажах", ЗаказДоговорОтборПоПозициямВМонтажах, ВидСравненияКомпоновкиДанных.Равно,, ЗаказДоговорОтборПоПозициямВМонтажах >= -1);
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(ЗаказДоговоры,
			"СтатусЗаказаРозницыНаПроизводство", ЗаказДоговорОтборПоСтатусуПроизводства, ВидСравненияКомпоновкиДанных.Равно,, ЗаказДоговорОтборПоСтатусуПроизводства >= -1);
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(ЗаказДоговоры,
			"СтатусЗаказаРозницыПоставщикам", ЗаказДоговорОтборПоСтатусуЗакупки, ВидСравненияКомпоновкиДанных.Равно,, ЗаказДоговорОтборПоСтатусуЗакупки >= -1);
	
КонецПроцедуры

// #14593 группа отборов, требующих подмены текста запроса Динамического списка "ЗаказДоговоры"
&НаСервере
Процедура ЗаказДоговорОсобыйОтборПриИзмененииНаСервере()
			
	ПоляОтбора = Новый Структура;  
	ПоляОтбора.Вставить("ЗаказДоговорОтборПоВыполнениюМонтажей", ЗаказДоговорОтборПоВыполнениюМонтажей);
