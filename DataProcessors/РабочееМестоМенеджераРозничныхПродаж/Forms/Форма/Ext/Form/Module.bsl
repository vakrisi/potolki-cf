&НаСервере
Процедура УдалитьОтборПоПолю(ЭлементТаблица, Поле1, Поле2, Поле3, Поле4)
	
	ЭОКоличество = ЭлементТаблица.Отбор.Элементы.Количество();
	Для Индекс = 1 По ЭОКоличество Цикл
		ЭлементОтбора = ЭлементТаблица.Отбор.Элементы[ЭОКоличество - Индекс];
		Если ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(Поле1) 
			ИЛИ ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(Поле2)
			ИЛИ ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(Поле3)
			ИЛИ ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(Поле4)
		Тогда
			ЭлементТаблица.Отбор.Элементы.Удалить(ЭлементОтбора);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

