&НаКлиенте
Процедура ПроверитьНеобходимостьОбновленияСпискаЛидов()
	
	Если НужноОбновитьСписокЛидов() И ЭтотОбъект.ВводДоступен() Тогда
		ОбновитьСпискиРМ(Истина);

		//ОбновитьНадписиКнопокНаКлиенте(); //#16089 закомментировано
		УбратьФлагНужноОбновитьСписокЛидов();
		Состояние("Получены новые лиды");
	КонецЕсли;
		
КонецПроцедуры

&НаСервереБезКонтекста
Функция НужноОбновитьСписокЛидов() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Пользователь", Пользователи.ТекущийПользователь());
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ		
	|	ОбновленияАРМРозницы.Обновить
	|ИЗ 
	|   РегистрСведений.НеобходимостьОбновленияАРМРозницы КАК ОбновленияАРМРозницы
	|ГДЕ
	|   ОбновленияАРМРозницы.Пользователь = &Пользователь
	|   И ОбновленияАРМРозницы.Обновить
	|";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат НЕ РезультатЗапроса.Пустой();		
	
КонецФункции

&НаСервере
Процедура УбратьФлагНужноОбновитьСписокЛидов()
	
	МенеджерЗаписи = РегистрыСведений.НеобходимостьОбновленияАРМРозницы.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Пользователь = Пользователи.ТекущийПользователь();
	МенеджерЗаписи.Обновить = Ложь;
	
	Попытка
		МенеджерЗаписи.Записать();	
	Исключение
	КонецПопытки;
	
КонецПроцедуры	

&НаСервере
Процедура ДобавитьФильтрЛидовПоОграничениям()
	
	МассивСписков = Новый Массив;
	МассивСписков.Добавить(Лиды);
	МассивСписков.Добавить(ЛидыНовые);
	МассивСписков.Добавить(ЛидыРасчетДоЗамера);
	МассивСписков.Добавить(ЛидыОтказные);
	МассивСписков.Добавить(ЛидыОтложенныеЗамер);
	МассивСписков.Добавить(ЛидыОбработкаПослеЗамера);
	МассивСписков.Добавить(ЛидыОформитьДоговор);
	МассивСписков.Добавить(ЛидыДоговорОформлен);
	МассивСписков.Добавить(ЛидыНецелевые);
	МассивСписков.Добавить(ЛидыОтложенныеДоговоры);
	МассивСписков.Добавить(ЛидыЗаявкаНаЗамер);
	МассивСписков.Добавить(ЛидыОбращение);
	МассивСписков.Добавить(ЗамерыВыезды);
	
	Для каждого СписокЛидов из МассивСписков Цикл
		УдалитьОтборПоПолю(СписокЛидов, "Автор", "ТочкаПродаж", "Подразделение", "Менеджер");
	КонецЦикла;
	
	ТекущийПользователь = Пользователи.ТекущийПользователь();
	Если ОбщийМодульСервер.НастройкаПользователя("ОтображатьТолькоСвоиЛидыВСписке", ТекущийПользователь) Тогда
		Для каждого СписокЛидов из МассивСписков Цикл
			ДобавитьОтборПоПолю(СписокЛидов, ВидСравненияКомпоновкиДанных.Равно, "Автор", ТекущийПользователь);
		КонецЦикла;
	КонецЕсли;
			
	Если НЕ ЛидОтборПоАвтору.Пустая() Тогда
		Для каждого СписокЛидов из МассивСписков Цикл
			ДобавитьОтборПоПолю(СписокЛидов, ВидСравненияКомпоновкиДанных.Равно, "Автор", ЛидОтборПоАвтору);
		КонецЦикла;
	КонецЕсли;
	
	//++ №14722
	Если НЕ ЛидОтборПоМенеджеру.Пустая() Тогда
		Для каждого СписокЛидов из МассивСписков Цикл
			ДобавитьОтборПоПолю(СписокЛидов, ВидСравненияКомпоновкиДанных.Равно, "Менеджер", ЛидОтборПоМенеджеру);
		КонецЦикла;
	КонецЕсли;
	//-- №14722
	
	//#12515
	Если НЕ ЛидОтборПоПодразделению.Пустая() Тогда
		Для каждого СписокЛидов из МассивСписков Цикл
			ДобавитьОтборПоПолю(СписокЛидов, ВидСравненияКомпоновкиДанных.Равно, "Подразделение", ЛидОтборПоПодразделению);
		КонецЦикла;
	КонецЕсли;
	
	Если НЕ ЛидОтборПоТочкеПродаж.Пустая() Тогда
		Для каждого СписокЛидов из МассивСписков Цикл
			ДобавитьОтборПоПолю(СписокЛидов, ВидСравненияКомпоновкиДанных.Равно, "ТочкаПродаж", ЛидОтборПоТочкеПродаж);
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьВидимостьКолонокСпискаЛидов(Фильтр="")
	
	//колонки, которые видны всегда
	Элементы.ЛидыДата.Видимость 							= Истина;
	Элементы.ЛидыНомер.Видимость 							= Истина;
	Элементы.ЛидыВидКонтакта.Видимость 						= Истина;
	Элементы.ЛидыИмяКлиента.Видимость 						= Истина;
	Элементы.ЛидыТекущийСтатус.Видимость 					= Истина;
	Элементы.ЛидыПоследнийКомментарий.Видимость 			= Истина;
	Элементы.ЛидыАдрес.Видимость 							= Истина;
	
	//колонки с переменной видимостью
	Элементы.ЛидыПоследняяДатаПерезвонить.Видимость 		= Истина;
	//Элементы.ЛидыПоследнееВремяПерезвонить.Видимость 		= Истина;
	Элементы.ЛидыПоследнийРезультатЗамера.Видимость 		= Истина;
	Элементы.ЛидыПоследняяСуммаДоговораНаЗамере.Видимость 	= Истина;
	Элементы.ЛидыПоследнееЗамерВыполнен.Видимость 			= Истина;
	Элементы.ЛидыПоследняяДатаЗамера.Видимость				= Истина;
	Элементы.ЛидыПоследнееВремяНачалаЗамера.Видимость 		= Истина;
	Элементы.ЛидыПоследнийИсполнительЗамера.Видимость 		= Истина;
	
	Если Фильтр = "ЗаполнитьЗамер" Тогда
		Элементы.ЛидыПоследняяДатаПерезвонить.Видимость 		= Ложь;
		//Элементы.ЛидыПоследнееВремяПерезвонить.Видимость 		= Ложь;
		Элементы.ЛидыПоследнийРезультатЗамера.Видимость 		= Истина;
		Элементы.ЛидыПоследняяСуммаДоговораНаЗамере.Видимость 	= Ложь;
		Элементы.ЛидыПоследнееЗамерВыполнен.Видимость 			= Ложь;
		Элементы.ЛидыПоследняяДатаЗамера.Видимость				= Истина;
		Элементы.ЛидыПоследнееВремяНачалаЗамера.Видимость 		= Ложь;
		Элементы.ЛидыПоследнийИсполнительЗамера.Видимость 		= Истина;
	ИначеЕсли Фильтр = "ОтложенныйНазначитьЗамер" Тогда
		Элементы.ЛидыПоследняяДатаПерезвонить.Видимость 		= Истина;
		//Элементы.ЛидыПоследнееВремяПерезвонить.Видимость 		= Истина;
		Элементы.ЛидыПоследнийРезультатЗамера.Видимость 		= Ложь;
		Элементы.ЛидыПоследняяСуммаДоговораНаЗамере.Видимость 	= Ложь;
		Элементы.ЛидыПоследнееЗамерВыполнен.Видимость 			= Ложь;
		Элементы.ЛидыПоследняяДатаЗамера.Видимость				= Ложь;
		Элементы.ЛидыПоследнееВремяНачалаЗамера.Видимость 		= Ложь;
		Элементы.ЛидыПоследнийИсполнительЗамера.Видимость 		= Ложь;
	ИначеЕсли Фильтр = "ОформитьДоговор" Тогда
		Элементы.ЛидыПоследняяДатаПерезвонить.Видимость 		= Ложь;
		//Элементы.ЛидыПоследнееВремяПерезвонить.Видимость 		= Ложь;
		Элементы.ЛидыПоследнийРезультатЗамера.Видимость 		= Ложь;
		Элементы.ЛидыПоследняяСуммаДоговораНаЗамере.Видимость 	= Истина;
		Элементы.ЛидыПоследнееЗамерВыполнен.Видимость 			= Ложь;
		Элементы.ЛидыПоследняяДатаЗамера.Видимость				= Истина;
		Элементы.ЛидыПоследнееВремяНачалаЗамера.Видимость 		= Ложь;
		Элементы.ЛидыПоследнийИсполнительЗамера.Видимость 		= Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьНадписиКнопок()
	
	// процедура переделана на функцию с директивой НаСервереБезКонтекста
	// ранее возникала ошибка: если вызвать окно "Вывести список", в это время срабатывало "ОбновитьНадписиКнопокНаКлиенте" (каждые 60 сек) с вызовом серверной процедуры, 
	// что приводило к обновлению данных на сервере, вызову процедуры "ПриПолученииДанныхНаСервере" для списков и при нажатии кнопки "ОК" программа падала в краш
	
	// убрано в отдельную процедуру ОбновитьЭлементыСостоянияПолученияПисем
	//ПроверкаРекламныхЭлектронныхЯщиков_ПоследняяДатаПроверки = Константы.ПроверкаРекламныхЭлектронныхЯщиков_ПоследняяДатаПроверки.Получить();
	//ПроверкаРекламныхЭлектронныхЯщиков_ТекстОшибки = Константы.ПроверкаРекламныхЭлектронныхЯщиков_ТекстОшибки.Получить();
	//Элементы.ПроверкаРекламныхЭлектронныхЯщиков_ТекстОшибки.Видимость = НЕ ПустаяСтрока(ПроверкаРекламныхЭлектронныхЯщиков_ТекстОшибки);
	
	//ИсторияАТС_ДатаПоследнегоПолучения = Константы.ТелефонияДатаПоследнегоПолученияИсторииИзАТС.Получить();
	//Если ТекущаяДатаСеанса() - ИсторияАТС_ДатаПоследнегоПолучения > 86400 Тогда
	//	Элементы.ИсторияАТС_ДатаПоследнегоПолучения.ЦветТекста = WebЦвета.Красный;
	//	Элементы.ИсторияАТС_ДатаПоследнегоПолучения.Шрифт = Новый Шрифт(Элементы.ИсторияАТС_ДатаПоследнегоПолучения.Шрифт,,,Истина);
	//Иначе
	//	Элементы.ИсторияАТС_ДатаПоследнегоПолучения.ЦветТекста = ЦветаСтиля.ЦветТекстаФормы;
	//	Элементы.ИсторияАТС_ДатаПоследнегоПолучения.Шрифт = Новый Шрифт(Элементы.ИсторияАТС_ДатаПоследнегоПолучения.Шрифт,,,Ложь);
	//КонецЕсли;
	
	РезультатЭлементы = Новый Структура();
	
	Автор = Пользователи.ТекущийПользователь();
	ФильтрПоОтветственному = ОбщийМодульСервер.НастройкаПользователя("ОтображатьТолькоСвоиЛидыВСписке", Автор);
	
	//все статусы кроме "ЗапросВсего"
	ЗапросВсегоИСегодня = Новый Запрос;
	ЗапросВсегоИСегодня.УстановитьПараметр("Завтра",НачалоДня(ТекущаяДатаСеанса()+60*60*24));
	ЗапросВсегоИСегодня.УстановитьПараметр("ЗаполнитьЗамер", Справочники.СтатусыЛида.ЗаполнитьДанныеЗамера);
	ЗапросВсегоИСегодня.УстановитьПараметр("ФильтрПоОтветственному", ФильтрПоОтветственному);
	ЗапросВсегоИСегодня.УстановитьПараметр("Автор", Автор);
	ЗапросВсегоИСегодня.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Лид.ТекущийСтатус КАК ТекущийСтатус,
	|	1 КАК Количество
	|ИЗ
	|	Документ.Лид КАК Лид
	|ГДЕ
	|	Лид.Проведен
	|	И Лид.ТекущийСтатус <> &ЗаполнитьЗамер
	|	И ВЫБОР
	|			КОГДА &ФильтрПоОтветственному
	|				ТОГДА Лид.Автор = &Автор
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Лид.ТекущийСтатус КАК ТекущийСтатус,
	|	ВЫБОР
	|		КОГДА Лид.ТекущийСтатус = ЗНАЧЕНИЕ(Справочник.СтатусыЛида.Обращение)
	|				И Лид.РезультатОбращения = ЗНАЧЕНИЕ(Справочник.РезультатыЛида.Закрыт)
	|			ТОГДА 0
	|		ИНАЧЕ 1
	|	КОНЕЦ КАК Количество
	|ИЗ
	|	Документ.Лид КАК Лид
	|ГДЕ
	|	Лид.Проведен
	|	И ВЫБОР
	|			КОГДА Лид.ТекущийСтатус = ЗНАЧЕНИЕ(Справочник.СтатусыЛида.Обращение)
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ Лид.ПоследняяДатаПерезвонить < &Завтра
	|		КОНЕЦ
	|	И Лид.ТекущийСтатус <> &ЗаполнитьЗамер
	|	И ВЫБОР
	|			КОГДА &ФильтрПоОтветственному
	|				ТОГДА Лид.Автор = &Автор
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ";
	
	РезультатЗапроса = ЗапросВсегоИСегодня.ВыполнитьПакет();
	
	РезультатВсего = РезультатЗапроса[0].Выгрузить();
	РезультатВсего.Свернуть("ТекущийСтатус","Количество");	
	РезультатСегодня = РезультатЗапроса[1].Выгрузить();
	РезультатСегодня.Свернуть("ТекущийСтатус","Количество");
	
	ЗапросВидыСтатусов = Новый Запрос;
	ЗапросВидыСтатусов.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СтатусыЛида.ИмяПредопределенныхДанных,
	|	СтатусыЛида.Ссылка,
	|	СтатусыЛида.Наименование
	|ИЗ
	|	Справочник.СтатусыЛида КАК СтатусыЛида
	|ГДЕ
	|	НЕ СтатусыЛида.ПометкаУдаления
	|	И СтатусыЛида.Ссылка <> &ЗаполнитьЗамер
	//#11332
	|	И НЕ СтатусыЛида.Ссылка = ЗНАЧЕНИЕ(Справочник.СтатусыЛида.УДАЛИТЬ_Сервис)
	|	И НЕ СтатусыЛида.Ссылка = ЗНАЧЕНИЕ(Справочник.СтатусыЛида.УДАЛИТЬ_Рекламация)
	|";
	ЗапросВидыСтатусов.УстановитьПараметр("ЗаполнитьЗамер", Справочники.СтатусыЛида.ЗаполнитьДанныеЗамера);
	ВыборкаВидыСтатусов = ЗапросВидыСтатусов.Выполнить().Выбрать();
	
	Пока ВыборкаВидыСтатусов.Следующий() Цикл
		
		Сегодня = 0;
		НайденнаяСтрока = РезультатСегодня.Найти(ВыборкаВидыСтатусов.Ссылка,"ТекущийСтатус");
		Если НЕ НайденнаяСтрока = Неопределено Тогда
			Сегодня = НайденнаяСтрока.Количество;
		КонецЕсли;
		
		Всего = 0;
		НайденнаяСтрока = РезультатВсего.Найти(ВыборкаВидыСтатусов.Ссылка,"ТекущийСтатус");
		Если НЕ НайденнаяСтрока = Неопределено Тогда
			Всего = НайденнаяСтрока.Количество;
		КонецЕсли;
		
		Если НЕ "Фильтр_"+ВыборкаВидыСтатусов.ИмяПредопределенныхДанных = "Фильтр_НазначитьЗамер"
			и НЕ "Фильтр_"+ВыборкаВидыСтатусов.ИмяПредопределенныхДанных = "Фильтр_ОформитьДоговор" 
			и НЕ "Фильтр_"+ВыборкаВидыСтатусов.ИмяПредопределенныхДанных = "Фильтр_Отказ"
			//и НЕ "Фильтр_"+ВыборкаВидыСтатусов.ИмяПредопределенныхДанных = "Фильтр_Сервис"
			//и НЕ "Фильтр_"+ВыборкаВидыСтатусов.ИмяПредопределенныхДанных = "Фильтр_Рекламация"
			и НЕ "Фильтр_"+ВыборкаВидыСтатусов.ИмяПредопределенныхДанных = "Фильтр_НеЦелевой" Тогда
			
			ЗаголовокЭлемента = ВыборкаВидыСтатусов.Наименование + Символы.ПС +"(" + Сегодня + "/" + Всего + ")";
			//ИскомыйЭлемент = Элементы.Найти("Фильтр_"+ВыборкаВидыСтатусов.ИмяПредопределенныхДанных);
			//Если НЕ ИскомыйЭлемент = Неопределено Тогда
			//	ИскомыйЭлемент.Заголовок = ЗаголовокЭлемента;
			//КонецЕсли; 
			РезультатЭлементы.Вставить("Фильтр_"+ВыборкаВидыСтатусов.ИмяПредопределенныхДанных, ЗаголовокЭлемента);
		Иначе
			ЗаголовокЭлемента = ВыборкаВидыСтатусов.Наименование + Символы.ПС +"(" + Всего + ")";
			//ИскомыйЭлемент = Элементы.Найти("Фильтр_"+ВыборкаВидыСтатусов.ИмяПредопределенныхДанных);
			//Если НЕ ИскомыйЭлемент = Неопределено Тогда
			//	ИскомыйЭлемент.Заголовок =ЗаголовокЭлемента;
			//КонецЕсли;
			РезультатЭлементы.Вставить("Фильтр_"+ВыборкаВидыСтатусов.ИмяПредопределенныхДанных, ЗаголовокЭлемента);
		КонецЕсли;
		
	КонецЦикла;
	
	//статус "ЗапросВсего"
	//Элементы.Фильтр_ЗаполнитьДанныеЗамера.Заголовок = "Заявка на замер (0/0)";
	РезультатЭлементы.Вставить("Фильтр_ЗаполнитьДанныеЗамера", "Замер/Выезд (0/0)");
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	1 КАК Всего,
	|	ВЫБОР
	|		КОГДА Лид.ПоследняяДатаЗамера >= &НачалоСегодня
	|				И Лид.ПоследняяДатаЗамера <= &КонецСегодня
	|			ТОГДА 1
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК Сегодня
	|ИЗ
	|	Документ.Лид КАК Лид
	|ГДЕ
	|	Лид.Проведен
	|	И Лид.ТекущийСтатус = &ЗаполнитьЗамер";
	Если ФильтрПоОтветственному Тогда
		Запрос.Текст = Запрос.Текст + "
			|	И Лид.Автор = &Автор";
	КонецЕсли;
	
	Запрос.УстановитьПараметр("ЗаполнитьЗамер", Справочники.СтатусыЛида.ЗаполнитьДанныеЗамера);
	Запрос.УстановитьПараметр("НачалоСегодня", НачалоДня(ТекущаяДатаСеанса()));
	Запрос.УстановитьПараметр("КонецСегодня", КонецДня(ТекущаяДатаСеанса()));
	Запрос.УстановитьПараметр("Автор", Автор);
	Выборка = Запрос.Выполнить().Выгрузить();
	Выборка.Свернуть(,"Всего,Сегодня");
	Если Выборка.Количество() > 0 Тогда
		ЗаголовокЭлемента = "Замер/Выезд" + Символы.ПС + "("+Выборка[0].Сегодня + "/" + Выборка[0].Всего + ")";
