#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	УстановитьУсловноеОформление();
	
	ТекущийПользователь = Пользователи.ТекущийПользователь();
	РеквизитыПользователя = ОбщийМодульСервер.НастройкиПользователя("Сотрудник, ОграничениеДоступаКЛидамДляЗамерщика, 
												|ОтображатьТолькоСвоиЛидыВСписке, ОткрыватьСписокЛидовСОтборомПоОтветственному,
												|ЧастотаАвтоматическогоОбновленияСписковВАРМРозницы", ТекущийПользователь);
	
	//++ #12503
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(ЗамерыВыезды, "СотрудникЗамерщик",  РеквизитыПользователя.Сотрудник);
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(ЗамерыВыезды, "ИспользоватьОтборПоСотруднику",  РеквизитыПользователя.ОграничениеДоступаКЛидамДляЗамерщика);
	Элементы.ЗамерыВыездыФильтрПоказыватьЗамеры.Пометка = Истина;
	Элементы.ЗамерыВыездыФильтрПоказыватьВыезды.Пометка = Истина;
	УстановитьОтборВыездовЗамеров();
	//-- #12503
	
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(ЗаказДоговоры, "ПустойИдентификатор",  ОбщегоНазначенияКлиентСервер.ПустойУникальныйИдентификатор());
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПараметрыРазмещения = ПодключаемыеКоманды.ПараметрыРазмещения();
	ПараметрыРазмещения.Источники = Новый ОписаниеТипов("ДокументСсылка.ЗаказДоговор");
	ПараметрыРазмещения.КоманднаяПанель = Элементы.ФормаКоманднаяПанель;
	ПараметрыРазмещения.ПрефиксГрупп = "ЗаказДоговорыРМ"; 	
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект, ПараметрыРазмещения);

	ПараметрыРазмещения = ПодключаемыеКоманды.ПараметрыРазмещения();
	ПараметрыРазмещения.Источники = Новый ОписаниеТипов("ДокументСсылка.Монтаж");
	ПараметрыРазмещения.КоманднаяПанель = Элементы.ФормаКоманднаяПанель;
	ПараметрыРазмещения.ПрефиксГрупп = "МонтажиРМ"; 	
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект, ПараметрыРазмещения);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	// СтандартныеПодсистемы.УчетОригиналовПервичныхДокументов
	УчетОригиналовПервичныхДокументов.ПриСозданииНаСервере_ФормаСписка(ЭтотОбъект, Элементы.ЗаказДоговоры);
	УчетОригиналовПервичныхДокументов.ПриСозданииНаСервере_ФормаСписка(ЭтотОбъект, Элементы.Монтажи);
	// Конец СтандартныеПодсистемы.УчетОригиналовПервичныхДокументов

	Если РеквизитыПользователя.ОтображатьТолькоСвоиЛидыВСписке Тогда
		Элементы.ЛидОтборПоАвтору.Видимость = Ложь;
	Иначе
		Если РеквизитыПользователя.ОткрыватьСписокЛидовСОтборомПоОтветственному Тогда
			ЛидОтборПоАвтору = ТекущийПользователь;
		КонецЕсли;
	КонецЕсли;
	Если ПараметрыСеанса.ЗапретитьСниматьОтборПоОтветственномуВСпискеЛидов Тогда
		Элементы.ЛидОтборПоАвтору.Доступность = Ложь;
	КонецЕсли;
	
	//++ №7938 видимость вкладок по правам первоначальная
	Элементы.ГруппаПисьма.Видимость 				= ПравоДоступа("Просмотр", Метаданные.Документы.ЭлектронноеПисьмо);
	Элементы.ГруппаЛиды.Видимость 					= ПравоДоступа("Просмотр", Метаданные.Документы.Лид);
	Элементы.ГруппаДоговоры.Видимость 				= ПравоДоступа("Просмотр", Метаданные.Документы.ЗаказДоговор);
	Элементы.ГруппаМонтажи.Видимость 				= ПравоДоступа("Просмотр", Метаданные.Документы.Монтаж);
	//Элементы.ГруппаСервисныеЗаявки.Видимость 		= ПравоДоступа("Просмотр", Метаданные.Документы.Монтаж);
	Элементы.ГруппаПоступленияПотолков.Видимость 	= ПравоДоступа("Просмотр", Метаданные.Документы.ПоступлениеТоваровИУслуг);
	//-- №7938
	
	//#16875
	СоответствиеКнопок = Новый Соответствие;
	СоответствиеКнопок.Вставить("ГруппаЭлементовНовыйЛид", 				"НазначитьЗамер");
	СоответствиеКнопок.Вставить("ГруппаЭлементовРасчетДоЗамера", 		"РасчетДоЗамера");    
	СоответствиеКнопок.Вставить("ГруппаЭлементовЗамерыВыезды", 			"ЗаполнитьДанныеЗамера");
	СоответствиеКнопок.Вставить("ГруппаЭлементовОтложенныйЗамер", 		"ОтложенныйНазначитьЗамер");
	СоответствиеКнопок.Вставить("ГруппаЭлементовОтложенныйДоговор", 	"ОтложенныйЗаключитьДоговор");	
	СоответствиеКнопок.Вставить("ГруппаЭлементовОбработкаПослеЗамера", 	"ОбработкаПослеЗамера");
	СоответствиеКнопок.Вставить("ГруппаЭлементовОформитьДоговор", 		"ОформитьДоговор");
	СоответствиеКнопок.Вставить("ГруппаЭлементовДоговорОформлен", 		"ДоговорОформлен");
	СоответствиеКнопок.Вставить("ГруппаЭлементовОбращение", 			"Обращение");
	СоответствиеКнопок.Вставить("ГруппаЭлементовОтказные", 				"Отказ");
	СоответствиеКнопок.Вставить("ГруппаЭлементовНецелевые", 			"НеЦелевой");
	Для каждого КлючЗначение из СоответствиеКнопок Цикл		
		Элементы[КлючЗначение.Ключ].Видимость = Справочники.СтатусыЛида[КлючЗначение.Значение].Использовать;
	КонецЦикла;

	//#15605
	Элементы.ЛидОтборПоПодразделению.Видимость = Константы.ИспользоватьПодразделения.Получить();
	
	// отборы по заказ-договорам
	СписокЗаказДоговоровТекстЗапроса = ЗаказДоговоры.ТекстЗапроса;
	ЗаказДоговорОтборПоОплате = -9;
	ЗаказДоговорОтборПоПозициямВМонтажах = -9;
	ЗаказДоговорОтборПоВыполнениюМонтажей = -9;
	ЗаказДоговорОтборПоСтатусуПроизводства = -9;
	ЗаказДоговорОтборПоСтатусуЗакупки = -9;
	УстановитьОтборЗаказДоговоров();
	
	// отборы по монтажам
	СписокМонтажейТекстЗапроса = Монтажи.ТекстЗапроса;
	МонтажиОтборПоСтатусуПроизводства = -9;
	МонтажиОтборПоСтатусуЗакупки = -9;
	МонтажиОтборПоВыдачеМатериалов = -9;
	УстановитьОтборМонтажей();
	
	ДоговорыОтбиратьПоСтатусу = Истина;
	ДоговорыОтборПоСтатусуТекущийСтатус = Справочники.СтатусыЗаказДоговоров.ВРаботе;
	ДобавитьФильтрЛидовПоОграничениям();
	
	УстановитьПараметрПоЛидам();
	УстановитьВидимостьПоляПросроченДляЛидов(Константы.КонтролироватьВремяРеакцииПоЛидам.Получить());
	
	Если РольДоступна("ВКонтакте") или ОбщийМодуль.ЕстьПраваАдминистратора() Тогда
		Объект.access_token = Константы.ВКонтакте_access_token.Получить();
	КонецЕсли;
	Элементы.ВКонтакте_ОпубликоватьЗаписьНаСтене.Доступность = НЕ ПустаяСтрока(Объект.access_token);
		
	//Элементы.ГруппаНастройкиИстории.Доступность = ПользователюРазрешеноИспользованиеIPТелефонии();
	
	//++ №5011 комментируем, т.к. звонки теперь в отделной общей форме "ЖурналЗвонков"
	//Элементы.ГруппаЗвонки.Видимость = СофтФон.ТекущемуПользователюРазрешеноИспользованиеIPТелефонии()
	//                                  И НЕ ПараметрыСеанса.ТекущийПользователь.НеОтображатьВкладкуЗвонкиВАРМ; //#5171 (персональная)
	//-- №5011
	
	Элементы.ГруппаСтраницыЛиды.ТекущаяСтраница = Элементы.ГруппаЛидыНовые;
	
	ИспользуетсяПолучениеЛидов = РаботаСЭлектроннойПочтой.ЕстьЭлектронныеЯщикиавтоматическогоСозданияЛидов()
								ИЛИ ПолучитьФункциональнуюОпцию("ИспользоватьОбменСБитрикс24"); // #16453
	Элементы.КомандаПолучитьНовыеЛиды.Видимость = ИспользуетсяПолучениеЛидов;
	
	Элементы.ГруппаПоступленияПотолков.Видимость = (Константы.РучнойЗапускОбработкиСозданияДокументовПоступленийПотолковВРозницеОтПроизводства.Получить()
	                                               //#7381
											  	   ИЛИ Константы.РучнойЗапускОбработкиСозданияДокументовПоступленийПоРучнымЗаказам.Получить()
												   //#10822
	                                               ИЛИ  Константы.РучнойЗапускОбработкиСозданияДокументовПоступленийПоУдаленнойБазе.Получить())
												   И Элементы.ГруппаПоступленияПотолков.Видимость; //++ №7938 если первоначально вкладка включена
	
	Элементы.ГруппаПисьма.Видимость = Константы.СоздаватьВходящиеКонтактыПоВходящимЭлектроннымПисьмам.Получить()
		И Элементы.ГруппаПисьма.Видимость; //++ №7938 если первоначально вкладка включена
	
	//ТолькоИсториюЗвонков = Параметры.ТолькоИсториюЗвонков;	
	
	// видимость элементов отбора по заказ-договорам
	Элементы.ЗаказДоговорОтборПоПодразделению.Видимость = ПолучитьФункциональнуюОпцию("ИспользоватьПодразделения");
	ОбеспеченностьРозницыПоЗаказДоговорам = ПолучитьФункциональнуюОпцию("ОбеспеченностьРозницыПоЗаказДоговорам");
	Элементы.ЗаказДоговорыСтатусЗаказаРозницыНаПроизводство.Видимость = ОбеспеченностьРозницыПоЗаказДоговорам;
	Элементы.ЗаказДоговорыСтатусЗаказаРозницыПоставщикам.Видимость    = ОбеспеченностьРозницыПоЗаказДоговорам;
	Элементы.ЗаказДоговорОтборПоСтатусуПроизводства.Видимость    	  = ОбеспеченностьРозницыПоЗаказДоговорам;  //#16544
	Элементы.ЗаказДоговорОтборПоСтатусуЗакупки.Видимость    		  = ОбеспеченностьРозницыПоЗаказДоговорам;  //#16544
	
	// видимость элементов отбора по монтажам
	Если Элементы.ГруппаМонтажи.Видимость Тогда //++ №7938
		ИспользоватьСтатусЗакрытВМонтаже = Константы.ИспользоватьСтатусЗакрытВМонтаже.Получить();
		Элементы.МонтажиДатаЗакрытия.Видимость = ИспользоватьСтатусЗакрытВМонтаже;
		Элементы.МонтажиОтборПериодЗакрытия.Видимость = ИспользоватьСтатусЗакрытВМонтаже;      //++ 16027
		
		Элементы.МонтажиОтборПоПодразделению.Видимость = ПолучитьФункциональнуюОпцию("ИспользоватьПодразделения");  //++ 16027
		
		ОбеспеченностьРозницыПоМонтажам = ПолучитьФункциональнуюОпцию("ОбеспеченностьРозницыПоМонтажам");
		Элементы.МонтажиСтатусЗаказаРозницыНаПроизводство.Видимость = ОбеспеченностьРозницыПоМонтажам;
		Элементы.МонтажиСтатусЗаказаРозницыПоставщикам.Видимость    = ОбеспеченностьРозницыПоМонтажам;
		Элементы.МонтажиОтборПоСтатусуПроизводства.Видимость    	= ОбеспеченностьРозницыПоМонтажам;  //#16544 
		Элементы.МонтажиОтборПоСтатусуЗакупки.Видимость    		    = ОбеспеченностьРозницыПоМонтажам;  //#16544				
	КонецЕсли;
	
	//#7414
	Если Элементы.ГруппаПисьма.Видимость Тогда
		ОбновитьЭлементыСостоянияПолученияПисемНаСервере(); 
	КонецЕсли;
	
	//++ №9919
	ИспользоватьНачислениеЗаработнойПлатыНаОснованииМонтажа = ПолучитьФункциональнуюОпцию("ИспользоватьНачислениеЗаработнойПлатыНаОснованииМонтажа");
	//Если ПравоДоступа("Изменение", Метаданные.Документы.НачислениеЗарплаты) Тогда // проверка для типовой команды
	//	
	//	Элементы.МонтажиДокументНачислениеЗарплатыСоздатьНаОсновании.Видимость = ИспользоватьНачислениеЗаработнойПлатыНаОснованииМонтажа;
	//	//Элементы.СервисныеЗаявкиДокументНачислениеЗарплатыСоздатьНаОсновании.Видимость = ИспользоватьНачислениеЗаработнойПлатыНаОснованииМонтажа;
	//	
	//КонецЕсли;
	
	Элементы.МонтажиИндикацияНачисленияЗарплаты.Видимость = ИспользоватьНачислениеЗаработнойПлатыНаОснованииМонтажа;
	//-- №9919
	
	ОбщийМодульСервер.УстановитьВидимостьКомандыВывестиСписокВСпискахЛидов(ЭтаФорма, Истина); // №11556
	
	// №13388
	ОбщийМодульСервер.УстановитьПериодАвтоОбновленияДляВсехДинамическихСписков(ЭтаФорма, РеквизитыПользователя.ЧастотаАвтоматическогоОбновленияСписковВАРМРозницы);
	
КонецПроцедуры

