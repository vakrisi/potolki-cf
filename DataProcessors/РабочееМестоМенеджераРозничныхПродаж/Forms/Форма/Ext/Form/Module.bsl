&НаКлиенте
Процедура ВКонтакте_ОпубликоватьЗаписьНаСтене(Команда)
	ПараметрыБеседы = Новый Структура;
	ПараметрыБеседы.Вставить("access_token",Объект.access_token);
	ОткрытьФорму("Обработка.РабочееМестоМенеджераРозничныхПродаж.Форма.ВКонтакте_ФормаЗаписьНаСтене", ПараметрыБеседы);
КонецПроцедуры

&НаКлиенте
Процедура БеседыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	ПараметрыБеседы = Новый Структура;
	ПараметрыБеседы.Вставить("access_token",Объект.access_token);
	ПараметрыБеседы.Вставить("uid",Элементы.Беседы.ТекущиеДанные.uid);
	ПараметрыБеседы.Вставить("mid",Элементы.Беседы.ТекущиеДанные.mid);
	ПараметрыБеседы.Вставить("chat_id",Элементы.Беседы.ТекущиеДанные.chat_id);
	ПараметрыБеседы.Вставить("Пользователи",ТаблицаПользователей);
	ОткрытьФорму("Обработка.РабочееМестоМенеджераРозничныхПродаж.Форма.ВКонтакте_ФормаБеседы", ПараметрыБеседы);
КонецПроцедуры

&НаКлиенте
Процедура ПолучитьСписокБесед()
	
	Если НЕ ПустаяСтрока(Объект.access_token) Тогда
		
		КоличествоНепрочитанных = 0;
		
		Если НЕ Элементы.Беседы.ТекущиеДанные = Неопределено Тогда
			ТекущийMid = Элементы.Беседы.ТекущиеДанные.mid;
		КонецЕсли;
		
		//перед получением новых бесед, сохраним старый список бесед для определения новых сообщений
		БеседыПредыдущее.Очистить();
		Для Каждого ТекущаяБеседа Из Беседы Цикл
			НоваяСтрока = БеседыПредыдущее.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущаяБеседа);
		КонецЦикла;
		
		Беседы.Очистить();
		СписокБесед = РаботаССайтомВКонтакте.ПолучитьСписокБесед(Объект.access_token,,200);
		Для НомерБеседы = 0 По СписокБесед.Количество()-1 Цикл
			НоваяСтрока = Беседы.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СписокБесед[НомерБеседы]);
			НоваяСтрока.body = СтрЗаменить(НоваяСтрока.body, "<br>", Символы.ПС);
			НоваяСтрока.Дата = Дата(1970,1,1,1,0,0) + НоваяСтрока.date;
			Если НоваяСтрока.read_state = "0" и НоваяСтрока.out = "0" Тогда
				КоличествоНепрочитанных = КоличествоНепрочитанных + 1;
			КонецЕсли;
		КонецЦикла;
		
		//получим ФИО пользователей
		СписокПользователей = "";
		Для Каждого Беседа Из Беседы Цикл
			Если НЕ ПустаяСтрока(СписокПользователей) Тогда
				СписокПользователей = СписокПользователей + ", ";
			КонецЕсли;
			СписокПользователей = СписокПользователей + Беседа.uid;
		КонецЦикла;
		СписокПользователей = РаботаССайтомВКонтакте.ПолучитьИнформациюОПользователях(Объект.access_token, СписокПользователей);
		Для НомерЗаписи = 0 По СписокПользователей.Количество()-1 Цикл
			НоваяСтрока = ТаблицаПользователей.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СписокПользователей[НомерЗаписи]);
		КонецЦикла;
		//теперь сопоставим пользователей в беседах
		Для Каждого Беседа Из Беседы Цикл
			Отбор = Новый Структура;
			Отбор.Вставить("uid", Беседа.uid);
			ЗаписиФИО = ТаблицаПользователей.НайтиСтроки(Отбор);
			Если ЗаписиФИО.Количество() > 0 Тогда
				Беседа.Пользователь = "" + ЗаписиФИО[0].first_name + " " + ЗаписиФИО[0].last_name;
			КонецЕсли;
		КонецЦикла;
		
		Если НЕ Беседы.НайтиСтроки(Новый Структура ("mid", ТекущийMid)).Количество() = 0  Тогда
			Ид = Беседы.НайтиСтроки(Новый Структура ("mid", ТекущийMid))[0].ПолучитьИдентификатор();
			Элементы.Беседы.ТекущаяСтрока = Ид;
		КонецЕсли;
		
		Если КоличествоНепрочитанных > 0 Тогда
			Элементы.ГруппаВКонтакте.Заголовок = "ВКонтакте (" + КоличествоНепрочитанных + "*)";
		Иначе
			Элементы.ГруппаВКонтакте.Заголовок = "ВКонтакте";
		КонецЕсли;
		
		//проверим соответствие нового списка бесед старому и выдадим уведомление о новом сообщении, если надо
		Если БеседыПредыдущее.Количество() > 0 Тогда
			Для Каждого ТекущаяБеседа Из Беседы Цикл
				Если ТекущаяБеседа.out = "0" Тогда
					Отбор = Новый Структура;
					Отбор.Вставить("mid", ТекущаяБеседа.mid);
					ПредыдущиеБеседы = БеседыПредыдущее.НайтиСтроки(Отбор);
					Если ПредыдущиеБеседы.Количество() > 0 Тогда
						Если НЕ ПредыдущиеБеседы[0].body = ТекущаяБеседа.body Тогда
							ПоказатьОповещениеПользователя("ВКонтакте: новое сообщение от " + Символы.ПС + ТекущаяБеседа.Пользователь);
						КонецЕсли;
					Иначе
						ПоказатьОповещениеПользователя("ВКонтакте: новое сообщение от " + Символы.ПС + ТекущаяБеседа.Пользователь);
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

