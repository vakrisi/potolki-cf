&НаСервереБезКонтекста
Процедура ЗаказДоговорыПриПолученииДанныхНаСервере(ИмяЭлемента, Настройки, Строки)
	
	// СтандартныеПодсистемы.УчетОригиналовПервичныхДокументов
	УчетОригиналовПервичныхДокументов.ПриПолученииДанныхНаСервере(Строки); 
	// Конец СтандартныеПодсистемы.УчетОригиналовПервичныхДокументов

	МассивСсылок = Строки.ПолучитьКлючи();
	Если МассивСсылок.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	// когда ЕстьОтборПо..., то заменяется текст запроса и колонка вычисляется в запросе
	ЕстьОтборПоСостояниюВыполненияМонтажей = Настройки.ДополнительныеСвойства.Свойство("ОтборПоСостояниюВыполненияМонтажей") И НЕ Настройки.ДополнительныеСвойства.ОтборПоСостояниюВыполненияМонтажей = -9;
	ЕстьОтборПоСостояниюПозицийВМонтажах = Настройки.ДополнительныеСвойства.Свойство("ОтборПоСостояниюПозицийВМонтажах") И НЕ Настройки.ДополнительныеСвойства.ОтборПоСостояниюПозицийВМонтажах = -9;
	ЕстьОтборПоСтатусуПроизводства = Настройки.ДополнительныеСвойства.Свойство("ОтборПоСтатусуПроизводства") И НЕ Настройки.ДополнительныеСвойства.ОтборПоСтатусуПроизводства = -9;
	ЕстьОтборПоСтатусуЗакупки = Настройки.ДополнительныеСвойства.Свойство("ОтборПоСтатусуЗакупки") И НЕ Настройки.ДополнительныеСвойства.ОтборПоСтатусуЗакупки = -9;
	
	КэшКолонок = Новый Структура;
	СтрокаДС = Строки.Получить(МассивСсылок[0]);
	КэшКолонок.Вставить("ЕстьКолонкаСтатусЗаказаРозницыНаПроизводство", СтрокаДС.Данные.Свойство("СтатусЗаказаРозницыНаПроизводство") И НЕ ЕстьОтборПоСтатусуПроизводства);
	КэшКолонок.Вставить("ЕстьКолонкаСтатусЗаказаРозницыПоставщикам", СтрокаДС.Данные.Свойство("СтатусЗаказаРозницыПоставщикам") И НЕ ЕстьОтборПоСтатусуЗакупки);
	
	КэшКолонок.Вставить("ЕстьКолонкаСостояниеВыполненияМонтажей", СтрокаДС.Данные.Свойство("СостояниеВыполненияМонтажей") И НЕ ЕстьОтборПоСостояниюВыполненияМонтажей);	
	КэшКолонок.Вставить("ЕстьКолонкаСостояниеПозицийВМонтажах", СтрокаДС.Данные.Свойство("СостояниеПозицийВМонтажах") И НЕ ЕстьОтборПоСостояниюПозицийВМонтажах);	
		
	ОбщийМодульСервер.РозницаПриПолученииДанныхНаСервере(Строки, "ЗаказДоговор", КэшКолонок);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаказДоговорыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	Если Поле.Имя = "ЗаказДоговорыСтатусЗаказаРозницыНаПроизводство" Тогда
		СтандартнаяОбработка = Ложь;
		ЗначениеОтбора = Новый Структура("Основание", ВыбраннаяСтрока);
		ПараметрыВыбора = Новый Структура("Отбор", ЗначениеОтбора);
		
		ОткрытьФорму("Документ.ЗаказПокупателя.ФормаСписка", ПараметрыВыбора);
			                           
	ИначеЕсли Поле.Имя = "ЗаказДоговорыСтатусЗаказаРозницыПоставщикам" Тогда
		СтандартнаяОбработка = Ложь;
		ЗначениеОтбора = Новый Структура("Основание", ВыбраннаяСтрока);
		ПараметрыВыбора = Новый Структура("Отбор", ЗначениеОтбора);		
		ОткрытьФорму("Документ.ЗаказПоставщику.Форма.ФормаСпискаИзАРМ", ПараметрыВыбора);
		
	ИначеЕсли Поле.Имя = "ЗаказДоговорыСтатусЗаказаРозницыМонтаж" Тогда
		СтандартнаяОбработка = Ложь;
		ЗначениеОтбора = Новый Структура("Основание", ВыбраннаяСтрока);
		ПараметрыВыбора = Новый Структура("Отбор", ЗначениеОтбора);
		
		Форма = ОткрытьФорму("Документ.Монтаж.Форма.ФормаСпискаИзАРМ", ПараметрыВыбора);
		
	//#6588
	ИначеЕсли Прав(Поле.Имя, 9) = "Основание" Тогда
		Если ЗначениеЗаполнено(Элемент.ТекущиеДанные.Основание) Тогда
			СтандартнаяОбработка = Ложь;
			ПараметрыФормы = Новый Структура("Ключ", Элемент.ТекущиеДанные.Основание);
		
			ОткрытьФорму("Документ.Лид.ФормаОбъекта", ПараметрыФормы);
		КонецЕсли;
	
	КонецЕсли;
	
	// СтандартныеПодсистемы.УчетОригиналовПервичныхДокументов
	УчетОригиналовПервичныхДокументовКлиент.СписокВыбор(Поле.Имя, ЭтотОбъект, Элементы.ЗаказДоговоры, СтандартнаяОбработка);
