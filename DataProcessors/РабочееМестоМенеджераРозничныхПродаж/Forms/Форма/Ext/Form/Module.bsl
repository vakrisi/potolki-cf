&НаСервере
Функция ДанныеОтбораЖурналаРегистрацииПолученияПисем()
	
	Отбор = Новый Структура;
	Отбор.Вставить("СобытиеЖурналаРегистрации", "ФоновоеЗадание.ПроверкаРекламныхЭлектронныхЯщиков");
	Отбор.Вставить("ДатаНачала",                Константы.ПроверкаРекламныхЭлектронныхЯщиков_ПоследняяДатаУспешнойПроверки.Получить());
	Отбор.Вставить("ДатаОкончания",             Константы.ПроверкаРекламныхЭлектронныхЯщиков_ПоследняяДатаПроверки.Получить());
	
	Возврат Отбор;
	
КонецФункции

