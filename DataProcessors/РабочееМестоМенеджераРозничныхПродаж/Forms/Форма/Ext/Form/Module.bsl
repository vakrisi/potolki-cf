&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ГруппаСтраницыПриСменеСтраницы(Неопределено, Элементы.ГруппаСтраницы.ТекущаяСтраница);
	
	//УстановкаФильтраЗаказДоговоры();
	//УстановкаФильтраСервисныеЗаявки();
	//ОбновитьНадписиКнопокНаКлиенте();  //#16089 закомментировано
	Фильтр_НазначитьЗамер(Неопределено);
	//Фильтр_Договоры_Все(Неопределено);
	
	ПодключитьОбработчикОжидания("ПроверкаПросроченныхЛидов", 600, Ложь); 
	//ПодключитьОбработчикОжидания("ОбновитьНадписиКнопокНаКлиенте", 60, Ложь);  //каждую минуту //#16089 закомментировано
	Если Элементы.ГруппаПисьма.Видимость Тогда
		ПодключитьОбработчикОжидания("ОбновитьЭлементыСостоянияПолученияПисем", 60, Ложь); //#7414 //каждую минуту
	КонецЕсли;
	
	Если НЕ ПустаяСтрока(Объект.access_token) Тогда
		ПолучитьСписокБесед();
		ПодключитьОбработчикОжидания("ПолучитьСписокБесед", 15);
		Элементы.ГруппаВКонтакте.Видимость = Истина;
	Иначе
		Элементы.ГруппаВКонтакте.Видимость = Ложь;
	КонецЕсли;
	
	ПодключитьОбработчикОжидания("ПроверитьНеобходимостьОбновленияСпискаЛидов", 60); //каждую минуту уточняем, были ли созданы новые лиды (при парсинге почты или разборе истории звонков)
	Оповестить("ПолучитьКоличествоЛидовПринудительно"); //#16089
	
	УстановитьВидимостьЭлементов();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если Источник="Лид" Тогда
		//Если ИмяСобытия = "ЗапроситьИсториюЗвонков" Тогда 
		//	ИсторияДатаНачала = Параметр.ИсторияДатаНачала;
		//	ИсторияДатаОкончания = Параметр.ИсторияДатаОкончания;
		//	ИсторияОтборПоНомеру = Параметр.ИсторияОтборПоНомеру;
		//	//ПолучитьИсториюЗвонков(Неопределено);
		//	УстановкаФильтраИсторияЗвонковАТС();
		//	Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.ГруппаЗвонки;
		//КонецЕсли;
		
	ИначеЕсли Врег(ИмяСобытия) = Врег("Запись_Лид") Тогда
		ОбновитьСпискиРМ(Истина);
		
	ИначеЕсли ИмяСобытия = "ЗакрытаФормаЗаказДоговора" И Источник = "ЗаказДоговор" Тогда
		Элементы.ЗаказДоговоры.Обновить();
		
	ИначеЕсли ИмяСобытия = "ЗакрытаФормаМонтажа" и Источник = "Монтаж" Тогда
		Элементы.ЗаказДоговоры.Обновить();
		
	ИначеЕсли ИмяСобытия = "Запись_ДокументОплаты" Тогда
		Элементы.ЗаказДоговоры.Обновить();
		Элементы.Монтажи.Обновить();
		
	ИначеЕсли ИмяСобытия = "ОбновитьАРМРозницы" Тогда		
		Если Источник = "ЗаказДоговор"
			ИЛИ Источник = "Монтаж" Тогда
			Элементы.ЗаказДоговоры.Обновить();
		КонецЕсли;

	//#16089
	ИначеЕсли ИмяСобытия = "ОбновитьКнопкиАРМРозницы" Тогда		
		ПредставлениеСчетчикаНовыйЛид 				= СтрШаблон("%1/%2", Формат(Параметр.ЛидыНовыеВРаботе, "ЧН=0; ЧГ=0"), Формат(Параметр.ЛидыНовыеВсего, "ЧН=0; ЧГ=0"));
		ПредставлениеСчетчикаРасчетДоЗамера 		= СтрШаблон("%1/%2", Формат(Параметр.ЛидыРасчетДоЗамераВРаботе, "ЧН=0; ЧГ=0"), Формат(Параметр.ЛидыРасчетДоЗамераВсего, "ЧН=0; ЧГ=0"));   //#16875
		ПредставлениеСчетчикаЗаявкаНаЗамер 			= СтрШаблон("%1/%2", Формат(Параметр.ЛидыЗаявкаНаЗамерВРаботе, "ЧН=0; ЧГ=0"), Формат(Параметр.ЛидыЗаявкаНаЗамерВсего, "ЧН=0; ЧГ=0"));
		ПредставлениеСчетчикаОтложенныйЗамер 		= СтрШаблон("%1/%2", Формат(Параметр.ЛидыОтложенныеЗамерыВРаботе, "ЧН=0; ЧГ=0"), Формат(Параметр.ЛидыОтложенныеЗамерыВсего, "ЧН=0; ЧГ=0")); 
		ПредставлениеСчетчикаОтложенныйДоговор 		= СтрШаблон("%1/%2", Формат(Параметр.ЛидыОтложенныеДоговорыВРаботе, "ЧН=0; ЧГ=0"), Формат(Параметр.ЛидыОтложенныеДоговорыВсего, "ЧН=0; ЧГ=0"));
		ПредставлениеСчетчикаОбработкаПослеЗамера 	= СтрШаблон("%1/%2", Формат(Параметр.ЛидыОбработкаПослеЗамераВРаботе, "ЧН=0; ЧГ=0"), Формат(Параметр.ЛидыОбработкаПослеЗамераВсего, "ЧН=0; ЧГ=0"));  //#16875
		ПредставлениеСчетчикаОформитьДоговор 		= СтрШаблон("%1", Формат(Параметр.ЛидыОформитьДоговорВсего, "ЧН=0; ЧГ=0"));
		ПредставлениеСчетчикаДоговорОформлен 		= СтрШаблон("%1", Формат(Параметр.ЛидыДоговорОформленВсего, "ЧН=0; ЧГ=0"));
		ПредставлениеСчетчикаОбращения 				= СтрШаблон("%1/%2", Формат(Параметр.ЛидыОбращениеВРаботе, "ЧН=0; ЧГ=0"), Формат(Параметр.ЛидыОбращениеВсего, "ЧН=0; ЧГ=0")); 
		ПредставлениеСчетчикаОтказные 				= СтрШаблон("%1", Формат(Параметр.ЛидыОтказныеВсего, "ЧН=0; ЧГ=0")); 
		ПредставлениеСчетчикаНецелевые 				= СтрШаблон("%1", Формат(Параметр.ЛидыНецелевыеВсего, "ЧН=0; ЧГ=0"));
		ПредставлениеСчетчикаВсеЛиды 				= СтрШаблон("%1", Формат(Параметр.ЛидыВсеВсего, "ЧН=0; ЧГ=0"));

	КонецЕсли;
	
	// СтандартныеПодсистемы.УчетОригиналовПервичныхДокументов
	УчетОригиналовПервичныхДокументовКлиент.ОбработчикОповещенияФормаСписка(ИмяСобытия, ЭтотОбъект, Элементы.ЗаказДоговоры);
	УчетОригиналовПервичныхДокументовКлиент.ОбработчикОповещенияФормаСписка(ИмяСобытия, ЭтотОбъект, Элементы.Монтажи);
	// Конец СтандартныеПодсистемы.УчетОригиналовПервичныхДокументов

