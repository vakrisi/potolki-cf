Процедура ПоказатьДиалогВыбораПериодаМонтажа()
	
	Диалог = Новый ДиалогРедактированияСтандартногоПериода();
	
	СтандартныйПериод = Новый СтандартныйПериод();				
	СтандартныйПериод.ДатаНачала = МонтажиОтборПоДатеМонтажаНачалоПериода;
	СтандартныйПериод.ДатаОкончания = МонтажиОтборПоДатеМонтажаКонецПериода;
	
	Диалог.Период = СтандартныйПериод;
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ОбработкаВыбораПериодаМонтажей",ЭтаФорма);
	
	Диалог.Показать(ОписаниеОповещения);
	
КонецПроцедуры
	
&НаКлиенте
Процедура МонтажиОтборПоДатеМонтажаПриИзменении(Элемент)
	
	Если МонтажиОтборПоДатеМонтажа = "Выбрать период..." Тогда
		ПоказатьДиалогВыбораПериодаМонтажа();		
	Иначе
		УстановитьОтборМонтажей();	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбораПериодаМонтажей(Период, Параметры) Экспорт

    Если Период <> Неопределено Тогда        
        МонтажиОтборПоДатеМонтажаНачалоПериода = Период.ДатаНачала;
        МонтажиОтборПоДатеМонтажаКонецПериода = Период.ДатаОкончания; 
		
		МонтажиОтборПоДатеМонтажа = Строка(Период);		
	Иначе
		МонтажиОтборПоДатеМонтажа = "";
	КонецЕсли;
	
	УстановитьОтборМонтажей();

КонецПроцедуры

