&НаКлиенте
Процедура ОбновитьСпискиРМ(ТолькоЛиды = Ложь)
 
	УстановитьПараметрПоЛидам();
	
	//**16055
	//Элементы.Лиды.Обновить();
	//Элементы.ЛидыНовые.Обновить();
	//Элементы.ЛидыОтказные.Обновить();
	//Элементы.ЛидыОтложенныеЗамер.Обновить();
	//Элементы.ЛидыОформитьДоговор.Обновить();
	//Элементы.ЛидыДоговорОформлен.Обновить();
	//Элементы.ЛидыНецелевые.Обновить();
	//Элементы.ЛидыОтложенныеДоговоры.Обновить();
	//Элементы.ЛидыЗаявкаНаЗамер.Обновить();
	Если Элементы.ГруппаСтраницыЛиды.ТекущаяСтраница = Элементы.ГруппаЛидыНовые Тогда
		Элементы.ЛидыНовые.Обновить();
	ИначеЕсли Элементы.ГруппаСтраницыЛиды.ТекущаяСтраница = Элементы.ГруппаРасчетДоЗамера Тогда
		Элементы.ЛидыРасчетДоЗамера.Обновить();
	ИначеЕсли Элементы.ГруппаСтраницыЛиды.ТекущаяСтраница = Элементы.ГруппаОтложенныеЗамер Тогда
		Элементы.ЛидыОтложенныеЗамер.Обновить();
	ИначеЕсли Элементы.ГруппаСтраницыЛиды.ТекущаяСтраница = Элементы.ГруппаЛидыЗаявкаНаЗамер Тогда
		Элементы.ЛидыЗаявкаНаЗамер.Обновить();	
	ИначеЕсли Элементы.ГруппаСтраницыЛиды.ТекущаяСтраница = Элементы.ГруппаЛидыОтложенныйДоговор Тогда
		Элементы.ЛидыОтложенныеДоговоры.Обновить();
	ИначеЕсли Элементы.ГруппаСтраницыЛиды.ТекущаяСтраница = Элементы.ГруппаОбработкаПослеЗамера Тогда
		Элементы.ЛидыОбработкаПослеЗамера.Обновить();
	ИначеЕсли Элементы.ГруппаСтраницыЛиды.ТекущаяСтраница = Элементы.ГруппаЛидыОформитьДоговор Тогда
		Элементы.ЛидыОформитьДоговор.Обновить();
	ИначеЕсли Элементы.ГруппаСтраницыЛиды.ТекущаяСтраница = Элементы.ГруппаЛидыДоговорОформлен Тогда
		Элементы.ЛидыДоговорОформлен.Обновить();
	ИначеЕсли Элементы.ГруппаСтраницыЛиды.ТекущаяСтраница = Элементы.ГруппаЛидыОбращение Тогда
		Элементы.ЛидыОбращение.Обновить();
	ИначеЕсли Элементы.ГруппаСтраницыЛиды.ТекущаяСтраница = Элементы.ГруппаЛидыОтказные Тогда
		Элементы.ЛидыОтказные.Обновить();
	ИначеЕсли Элементы.ГруппаСтраницыЛиды.ТекущаяСтраница = Элементы.ГруппаЛидыНецелевые Тогда
		Элементы.ЛидыНецелевые.Обновить();
	ИначеЕсли Элементы.ГруппаСтраницыЛиды.ТекущаяСтраница = Элементы.ГруппаЛидыВсе Тогда
		Элементы.Лиды.Обновить();
	КонецЕсли;
	//**16055
	
	//ОбновитьНадписиКнопокНаКлиенте(); //#16089 закомментировано
	
	Если ТолькоЛиды Тогда
		Возврат;
	КонецЕсли;
	
	Элементы.ЗаказДоговоры.Обновить();
	Элементы.Монтажи.Обновить();
	Элементы.Поступления.Обновить();
	
КонецПроцедуры

&НаКлиенте
Процедура ГруппаСтраницыЛидыПриСменеСтраницы(Элемент, ТекущаяСтраница)
	
	Если Элементы.ГруппаСтраницыЛиды.ТекущаяСтраница = Элементы.ГруппаЛидыНовые Тогда
		ВыделитьКнопкуФильтраЛида("Фильтр_НазначитьЗамер");
	ИначеЕсли Элементы.ГруппаСтраницыЛиды.ТекущаяСтраница = Элементы.ГруппаОтложенныеЗамер Тогда
		ВыделитьКнопкуФильтраЛида("Фильтр_ОтложенныйНазначитьЗамер");
	ИначеЕсли Элементы.ГруппаСтраницыЛиды.ТекущаяСтраница = Элементы.ГруппаЛидыЗаявкаНаЗамер Тогда
		ВыделитьКнопкуФильтраЛида("Фильтр_ЗаполнитьДанныеЗамера");
	ИначеЕсли Элементы.ГруппаСтраницыЛиды.ТекущаяСтраница = Элементы.ГруппаЛидыОтложенныйДоговор Тогда
		ВыделитьКнопкуФильтраЛида("Фильтр_ОтложенныйЗаключитьДоговор");
	ИначеЕсли Элементы.ГруппаСтраницыЛиды.ТекущаяСтраница = Элементы.ГруппаЛидыОформитьДоговор Тогда
		ВыделитьКнопкуФильтраЛида("Фильтр_ОформитьДоговор");
	ИначеЕсли Элементы.ГруппаСтраницыЛиды.ТекущаяСтраница = Элементы.ГруппаЛидыДоговорОформлен Тогда
		ВыделитьКнопкуФильтраЛида("Фильтр_ДоговорОформлен");
	ИначеЕсли Элементы.ГруппаСтраницыЛиды.ТекущаяСтраница = Элементы.ГруппаЛидыОтказные Тогда
		ВыделитьКнопкуФильтраЛида("Фильтр_Отказ");
	ИначеЕсли Элементы.ГруппаСтраницыЛиды.ТекущаяСтраница = Элементы.ГруппаЛидыНецелевые Тогда
		ВыделитьКнопкуФильтраЛида("Фильтр_НеЦелевой");
	ИначеЕсли Элементы.ГруппаСтраницыЛиды.ТекущаяСтраница = Элементы.ГруппаЛидыВсе Тогда
		ВыделитьКнопкуФильтраЛида("Фильтр_Все");
	КонецЕсли;
	
	ОбновитьСпискиРМ(Истина); //++ 16055
	
КонецПроцедуры

&НаКлиенте
Процедура ЗапуститьПроверкуРекламныхЭлектронныхЯщиков(Команда)
	
	Сообщение = "";
	Идентификатор = "";		
	РаботаСЭлектроннойПочтой.ЗапуститьФоновоеЗаданиеПроверитьРекламныеЭлектронныеЯщики(Сообщение, Идентификатор);
	Если НЕ ПустаяСтрока(Сообщение) Тогда
		ПоказатьПредупреждение(, Сообщение);
	КонецЕсли;
		
КонецПроцедуры

