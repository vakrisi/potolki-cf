Процедура МонтажиПриПолученииДанныхНаСервере(ИмяЭлемента, Настройки, Строки)
	
	// СтандартныеПодсистемы.УчетОригиналовПервичныхДокументов
	УчетОригиналовПервичныхДокументов.ПриПолученииДанныхНаСервере(Строки); 
	// Конец СтандартныеПодсистемы.УчетОригиналовПервичныхДокументов

	МассивСсылок = Строки.ПолучитьКлючи();
	Если МассивСсылок.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	// когда ЕстьОтборПо..., то заменяется текст запроса и колонка вычисляется в запросе
	ЕстьОтборПоСтатусуПроизводства = Настройки.ДополнительныеСвойства.Свойство("ОтборПоСтатусуПроизводства") И НЕ Настройки.ДополнительныеСвойства.ОтборПоСтатусуПроизводства = -9;
	ЕстьОтборПоСтатусуЗакупки = Настройки.ДополнительныеСвойства.Свойство("ОтборПоСтатусуЗакупки") И НЕ Настройки.ДополнительныеСвойства.ОтборПоСтатусуЗакупки = -9;
	
	КэшКолонок = Новый Структура;
	СтрокаДС = Строки.Получить(МассивСсылок[0]);	
	КэшКолонок.Вставить("ЕстьКолонкаСтатусЗаказаРозницыНаПроизводство", СтрокаДС.Данные.Свойство("СтатусЗаказаРозницыНаПроизводство") И НЕ ЕстьОтборПоСтатусуПроизводства);
	КэшКолонок.Вставить("ЕстьКолонкаСтатусЗаказаРозницыПоставщикам", СтрокаДС.Данные.Свойство("СтатусЗаказаРозницыПоставщикам") И НЕ ЕстьОтборПоСтатусуЗакупки);
	
	ОбщийМодульСервер.РозницаПриПолученииДанныхНаСервере(Строки, "Монтаж", КэшКолонок);
	
	//++ №7938 номер и дата заказ-договора
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("МассивСсылок", Строки.ПолучитьКлючи());
	
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Монтаж.Ссылка КАК Монтаж,
	|	ВЫБОР
	|		КОГДА НЕ Монтаж.Основание.НомерДоговора = """"
	|			ТОГДА Монтаж.Основание.НомерДоговора
	|		ИНАЧЕ Монтаж.Основание.Номер
	|	КОНЕЦ КАК Номер,
	|	Монтаж.Основание.Дата КАК Дата
	|ИЗ
	|	Документ.Монтаж КАК Монтаж
	|ГДЕ
	|	Монтаж.Ссылка В (&МассивСсылок)
	|	И Монтаж.Основание ССЫЛКА Документ.ЗаказДоговор";
	
	ВыборкаДокументов = Запрос.Выполнить().Выбрать();
	
	ЕстьКолонки = Истина;
	Пока ВыборкаДокументов.Следующий() Цикл
				
		СтрокаСписка = Строки[ВыборкаДокументов.Монтаж];
		
		Если СтрокаСписка.Данные.Свойство("ЗаказДоговорНомер") Тогда
			СтрокаСписка.Данные["ЗаказДоговорНомер"] = ВыборкаДокументов.Номер;
		Иначе
			ЕстьКолонки = Ложь;
		КонецЕсли;
		
		Если СтрокаСписка.Данные.Свойство("ЗаказДоговорДата") Тогда
			СтрокаСписка.Данные["ЗаказДоговорДата"] = ВыборкаДокументов.Дата;
		Иначе
			ЕстьКолонки = Ложь;
		КонецЕсли;
		
		Если НЕ ЕстьКолонки Тогда
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	УстановитьПривилегированныйРежим(Ложь);
	//-- №7938
	
	Для каждого СтрокаСписка из Строки Цикл
		Если СтрокаСписка.Значение.Данные.ЗаказДоговорКартинка = 0 Тогда
			НомерДата = ?(ПустаяСтрока(СтрокаСписка.Значение.Данные.ЗаказДоговорНомер), "от ", СтрокаСписка.Значение.Данные.ЗаказДоговорНомер + " от ") + Формат(СтрокаСписка.Значение.Данные.ЗаказДоговорДата, "ДЛФ=D");
			СтрокаСписка.Значение.Данные.ЗаказДоговорНомерДата = НомерДата;
		КонецЕсли;
	КонецЦикла;
	
	//++ №9919 индикация начисления ЗП по выработке
	Если ПолучитьФункциональнуюОпцию("ИспользоватьНачислениеЗаработнойПлатыНаОснованииМонтажа") Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РасчетыСПерсоналом.ОбъектВыработки КАК ДокументМонтаж,
		|	ЕСТЬNULL(СУММА(РасчетыСПерсоналом.Сумма), 0) КАК СуммаНачислений
		|
		|ПОМЕСТИТЬ ВТ_Начисления
		|
		|ИЗ
		|	РегистрНакопления.РасчетыСПерсоналом КАК РасчетыСПерсоналом
		|ГДЕ
		|	РасчетыСПерсоналом.ОбъектВыработки В (&МассивСсылок)
		|
		|СГРУППИРОВАТЬ ПО
		|	РасчетыСПерсоналом.ОбъектВыработки
		|
		|;/////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РасчетыСПерсоналом.ДокументМонтаж КАК ДокументМонтаж,
		|	ВЫБОР
		|		КОГДА РасчетыСПерсоналом.СуммаНачислений > 0 И РасчетыСПерсоналом.СуммаНачислений > ЕСТЬNULL(ВыработкаИсполнителейРозницыОбороты.СтоимостьОборот, 0)
		|			ТОГДА 5
		|		КОГДА РасчетыСПерсоналом.СуммаНачислений > 0 И РасчетыСПерсоналом.СуммаНачислений = ЕСТЬNULL(ВыработкаИсполнителейРозницыОбороты.СтоимостьОборот, 0)
		|			ТОГДА 0
		|		КОГДА РасчетыСПерсоналом.СуммаНачислений > 0 И РасчетыСПерсоналом.СуммаНачислений < ЕСТЬNULL(ВыработкаИсполнителейРозницыОбороты.СтоимостьОборот, 0)
		|			ТОГДА 1
		|		ИНАЧЕ 2
		|	КОНЕЦ КАК ИндикацияНачисленияЗарплаты
		|	
		|ИЗ
		|	ВТ_Начисления КАК РасчетыСПерсоналом
		|
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ВыработкаИсполнителейРозницы.Обороты(,, Авто) КАК ВыработкаИсполнителейРозницыОбороты
		|		ПО РасчетыСПерсоналом.ДокументМонтаж = ВыработкаИсполнителейРозницыОбороты.ОбъектВыработки
		|
		|";
		Запрос.УстановитьПараметр("МассивСсылок", Строки.ПолучитьКлючи());
		
		ВыборкаДокументов = Запрос.Выполнить().Выбрать();
		
		Пока ВыборкаДокументов.Следующий() Цикл
			
			СтрокаСписка = Строки[ВыборкаДокументов.ДокументМонтаж];
			
			Если СтрокаСписка.Данные.Свойство("ИндикацияНачисленияЗарплаты") Тогда
				СтрокаСписка.Данные["ИндикацияНачисленияЗарплаты"] = ВыборкаДокументов.ИндикацияНачисленияЗарплаты;
			Иначе
				Прервать;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	//-- №9919
	
КонецПроцедуры

&НаКлиенте
Процедура МонтажиВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если Поле.Имя = "МонтажиЗаказДоговорНомерДата" Тогда
		Если Элемент.ТекущиеДанные.ЗаказДоговорКартинка = 0 Тогда
			СтандартнаяОбработка = Ложь;
			ПараметрыВыбора = Новый Структура("Ключ", Элемент.ТекущиеДанные.Основание);
			ОткрытьФорму("Документ.ЗаказДоговор.ФормаОбъекта", ПараметрыВыбора,,Новый УникальныйИдентификатор);
		КонецЕсли;
	КонецЕсли;
	
	// СтандартныеПодсистемы.УчетОригиналовПервичныхДокументов
	УчетОригиналовПервичныхДокументовКлиент.СписокВыбор(Поле.Имя, ЭтотОбъект, Элементы.Монтажи, СтандартнаяОбработка);
	// Конец СтандартныеПодсистемы.УчетОригиналовПервичныхДокументов
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьСписокСсылокНаМонтажиПоОтборуДоговора(ЗначениеОтбора)
	
	// Если строка, то по номеру договора, иначе по замерщику
	ОтборПоНомеруДоговора = (ТипЗнч(ЗначениеОтбора) = Тип("Строка"));
	
	Запрос = новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ДокументМонтаж.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.Монтаж КАК ДокументМонтаж
	|ГДЕ
	|	ДокументМонтаж.Основание ССЫЛКА Документ.ЗаказДоговор
	|	И ВЫБОР
	|			КОГДА &ОтборПоНомеруДоговора
	|				ТОГДА ВЫБОР
	|						КОГДА НЕ ДокументМонтаж.Основание.НомерДоговора = """"
	|							ТОГДА ДокументМонтаж.Основание.НомерДоговора ПОДОБНО &НомерДоговора
	|						ИНАЧЕ ДокументМонтаж.Основание.Номер ПОДОБНО &НомерДоговора
	|					КОНЕЦ
	|			ИНАЧЕ ДокументМонтаж.Основание.ИсполнительЗамера = &Замерщик
	|		КОНЕЦ";
	Запрос.УстановитьПараметр("НомерДоговора", ?(ОтборПоНомеруДоговора, "%" + ЗначениеОтбора + "%", ""));
	Запрос.УстановитьПараметр("Замерщик", ?(ОтборПоНомеруДоговора, Справочники.Сотрудники.ПустаяСсылка(), ЗначениеОтбора));
	Запрос.УстановитьПараметр("ОтборПоНомеруДоговора", ОтборПоНомеруДоговора);
	
	УстановитьПривилегированныйРежим(Истина);
	МассивСсылок = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат МассивСсылок;
	
КонецФункции

