&НаКлиенте
Процедура ЛидыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если СтрНайти(Поле.Имя, "ЕстьФайлы") > 0 И Элемент.ТекущиеДанные.ЕстьФайлы Тогда
		СтандартнаяОбработка = Ложь;
		ЗначениеОтбора = Новый Структура("СсылкаНаОбъект", ВыбраннаяСтрока);
		ПараметрыВыбора = Новый Структура("Отбор", ЗначениеОтбора);
		
		ОткрытьФорму("РегистрСведений.ПрикрепленныеДанные.ФормаСписка", ПараметрыВыбора,,ВыбраннаяСтрока);
		
	//#6588
	ИначеЕсли Прав(Поле.Имя, 7) = "Договор" Тогда
		Если ЗначениеЗаполнено(Элемент.ТекущиеДанные.Договор) Тогда
			СтандартнаяОбработка = Ложь;
			ПараметрыФормы = Новый Структура("Ключ", Элемент.ТекущиеДанные.Договор);
		
			ОткрытьФорму("Документ.ЗаказДоговор.ФормаОбъекта", ПараметрыФормы);
		КонецЕсли;
	КонецЕсли;	

КонецПроцедуры

