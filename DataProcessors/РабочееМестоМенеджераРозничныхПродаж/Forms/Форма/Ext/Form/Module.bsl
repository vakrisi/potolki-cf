		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(ЗамерыВыезды,
			"ЭтоВыезд", Истина, ВидСравненияКомпоновкиДанных.Равно,, Истина);
		
	Иначе		
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(ЗамерыВыезды,
			"ЭтоВыезд", -1, ВидСравненияКомпоновкиДанных.Равно,, Истина);
		
