&НаКлиенте
Процедура ВыделитьКнопкуФильтраЛида(НазваниеКнопки)
	
	Элементы.Фильтр_НазначитьЗамер.ЦветФона 			= WebЦвета.СветлоЖелтыйЗолотистый;
	Элементы.Фильтр_РасчетДоЗамера.ЦветФона 			= WebЦвета.СветлоЖелтыйЗолотистый;
	Элементы.Фильтр_ОтложенныйНазначитьЗамер.ЦветФона 	= WebЦвета.СветлоЖелтыйЗолотистый;
	Элементы.Фильтр_ОтложенныйЗаключитьДоговор.ЦветФона = WebЦвета.СветлоЖелтыйЗолотистый;
	Элементы.Фильтр_ЗаполнитьДанныеЗамера.ЦветФона 		= WebЦвета.СветлоЖелтыйЗолотистый;
	Элементы.Фильтр_ОбработкаПослеЗамера.ЦветФона 		= WebЦвета.СветлоЖелтыйЗолотистый;
	Элементы.Фильтр_ОформитьДоговор.ЦветФона 			= WebЦвета.СветлоЖелтыйЗолотистый;	
	Элементы.Фильтр_ДоговорОформлен.ЦветФона 			= WebЦвета.СветлоЖелтыйЗолотистый;
	Элементы.Фильтр_Все.ЦветФона 						= WebЦвета.СветлоЖелтыйЗолотистый;
	
	//#16089
	СоответствиеНадписей = Новый Соответствие;
	СоответствиеНадписей.Вставить("Фильтр_НазначитьЗамер", 				"ПредставлениеСчетчикаНовыйЛид");
	СоответствиеНадписей.Вставить("Фильтр_РасчетДоЗамера", 				"ПредставлениеСчетчикаРасчетДоЗамера");    //#16875
	СоответствиеНадписей.Вставить("Фильтр_ЗаполнитьДанныеЗамера", 		"ПредставлениеСчетчикаЗаявкаНаЗамер");
	СоответствиеНадписей.Вставить("Фильтр_ОтложенныйНазначитьЗамер", 	"ПредставлениеСчетчикаОтложенныйЗамер");
	СоответствиеНадписей.Вставить("Фильтр_ОтложенныйЗаключитьДоговор", 	"ПредставлениеСчетчикаОтложенныйДоговор");	
	СоответствиеНадписей.Вставить("Фильтр_ОбработкаПослеЗамера", 		"ПредставлениеСчетчикаОбработкаПослеЗамера");   //#16875
	СоответствиеНадписей.Вставить("Фильтр_ОформитьДоговор", 			"ПредставлениеСчетчикаОформитьДоговор");
	СоответствиеНадписей.Вставить("Фильтр_ДоговорОформлен", 			"ПредставлениеСчетчикаДоговорОформлен");
	СоответствиеНадписей.Вставить("Фильтр_Обращение", 					"ПредставлениеСчетчикаОбращения");
	СоответствиеНадписей.Вставить("Фильтр_Отказ", 						"ПредставлениеСчетчикаОтказные");
	СоответствиеНадписей.Вставить("Фильтр_НеЦелевой", 					"ПредставлениеСчетчикаНецелевые");
	СоответствиеНадписей.Вставить("Фильтр_Все", 						"ПредставлениеСчетчикаВсеЛиды");
	Для каждого КлючЗначение из СоответствиеНадписей Цикл
		Элементы[КлючЗначение.Значение].ЦветФона = WebЦвета.СветлоЖелтыйЗолотистый;
	КонецЦикла;
	
	Элементы.Фильтр_Отказ.ЦветФона 						= WebЦвета.Лосось; // №6627 заменен на цвет бледно красный, был WebЦвета.СеребристоСерый;
	Элементы.Фильтр_НеЦелевой.ЦветФона 					= WebЦвета.Лосось; // №6627 заменен на цвет бледно красный, был WebЦвета.СеребристоСерый;
	Элементы[СоответствиеНадписей.Получить("Фильтр_Отказ")].ЦветФона = WebЦвета.Лосось;
	Элементы[СоответствиеНадписей.Получить("Фильтр_НеЦелевой")].ЦветФона = WebЦвета.Лосось;
	
	Элементы.Фильтр_Обращение.ЦветФона 					= WebЦвета.СеребристоСерый;
	Элементы[СоответствиеНадписей.Получить("Фильтр_Обращение")].ЦветФона = WebЦвета.СеребристоСерый;
	
	Элементы.Фильтр_ЗамерыИВыезды.ЦветФона 				= Новый Цвет();
	
	Элементы[НазваниеКнопки].ЦветФона = WebЦвета.Оранжевый;
	//#16089
	Если НЕ СоответствиеНадписей.Получить(НазваниеКнопки) = Неопределено Тогда
		Элементы[СоответствиеНадписей.Получить(НазваниеКнопки)].ЦветФона = WebЦвета.Оранжевый;
	КонецЕсли;
	
	Элементы.ГруппаБыстрыеФильтрыЛидыОбращение.Видимость = (НРег(НазваниеКнопки) = "фильтр_обращение"); // №11332
	Элементы.ГруппаБыстрыеФильтрыЛидыВсе.Видимость = (НРег(НазваниеКнопки) = "фильтр_все");
	
КонецПроцедуры

