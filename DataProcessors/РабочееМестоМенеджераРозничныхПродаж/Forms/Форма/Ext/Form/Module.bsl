&НаСервере
Процедура ПолучитьПросроченныеЛиды()
	
	МассивПросроченныхЛидов.Очистить();
	
	КоличествоПросроченных = 0;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВЫБОР
	// #11632
	//|		КОГДА НЕ Лид.ДатаПоследнейРеакции = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
	|		КОГДА НЕ Лид.ПоследняяДатаПерезвонить = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
	|			ТОГДА ВЫБОР
	|					КОГДА Лид.ТекущийСтатус = ЗНАЧЕНИЕ(Справочник.СтатусыЛида.ОтложенныйНазначитьЗамер)
	|							ИЛИ Лид.ТекущийСтатус = ЗНАЧЕНИЕ(Справочник.СтатусыЛида.ОтложенныйЗаключитьДоговор)
	|							ИЛИ Лид.ТекущийСтатус = ЗНАЧЕНИЕ(Справочник.СтатусыЛида.ЗаполнитьДанныеЗамера)
	|					ТОГДА ВЫБОР 
	|						  КОГДА Лид.ТекущийСтатус = ЗНАЧЕНИЕ(Справочник.СтатусыЛида.ЗаполнитьДанныеЗамера) ТОГДА
	|								ВЫБОР
	|									КОГДА ДОБАВИТЬКДАТЕ(ДОБАВИТЬКДАТЕ(Лид.ПоследняяДатаЗамера, СЕКУНДА, РАЗНОСТЬДАТ(ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0), Лид.ПоследнееВремяОкончанияЗамера, СЕКУНДА)), СЕКУНДА, НастройкиВремениРеакцииПоЛидам.ВремяВЧасах * 3600) < &ТекущаяДата
	|										ТОГДА 2
	|									ИНАЧЕ 1
	|								КОНЕЦ
	|						  ИНАЧЕ	
	|								ВЫБОР
	//|									КОГДА ДОБАВИТЬКДАТЕ(ДОБАВИТЬКДАТЕ(Лид.ПоследняяДатаПерезвонить, СЕКУНДА, РАЗНОСТЬДАТ(ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0), Лид.ПоследнееВремяПерезвонить, СЕКУНДА)), СЕКУНДА, НастройкиВремениРеакцииПоЛидам.ВремяВЧасах * 3600) < &ТекущаяДата
	|									КОГДА ДОБАВИТЬКДАТЕ(Лид.ПоследняяДатаПерезвонить, СЕКУНДА, НастройкиВремениРеакцииПоЛидам.ВремяВЧасах * 3600) < &ТекущаяДата
	|										ТОГДА 2
	|									ИНАЧЕ 1
	|								КОНЕЦ
	|					КОНЕЦ
	|					ИНАЧЕ ВЫБОР
	// #11632
	//|							КОГДА ДОБАВИТЬКДАТЕ(Лид.ДатаПоследнейРеакции, СЕКУНДА, НастройкиВремениРеакцииПоЛидам.ВремяВЧасах * 3600) < &ТекущаяДата
	//|							КОГДА ДОБАВИТЬКДАТЕ(ДОБАВИТЬКДАТЕ(Лид.ПоследняяДатаПерезвонить, СЕКУНДА, РАЗНОСТЬДАТ(ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0), Лид.ПоследнееВремяПерезвонить, СЕКУНДА)), СЕКУНДА, НастройкиВремениРеакцииПоЛидам.ВремяВЧасах * 3600) < &ТекущаяДата
	|							КОГДА ДОБАВИТЬКДАТЕ(Лид.ПоследняяДатаПерезвонить, СЕКУНДА, НастройкиВремениРеакцииПоЛидам.ВремяВЧасах * 3600) < &ТекущаяДата
	|								ТОГДА 2
	|							ИНАЧЕ 1
	|						КОНЕЦ
	|				КОНЕЦ
	|		ИНАЧЕ 1
	|	КОНЕЦ КАК Просрочен,
	|	Лид.Ссылка
	|ИЗ
	|	Документ.Лид КАК Лид
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НастройкиВремениРеакцииПоЛидам КАК НастройкиВремениРеакцииПоЛидам
	|		ПО Лид.ТекущийСтатус = НастройкиВремениРеакцииПоЛидам.СтатусЛида
	|ГДЕ
	|	Лид.Автор = &Автор";
	Запрос.УстановитьПараметр("ТекущаяДата",ТекущаяДатаСеанса());
	Запрос.УстановитьПараметр("Автор", Пользователи.ТекущийПользователь());
	
	РезультатЗапроса = Запрос.Выполнить().Выбрать();
	Пока РезультатЗапроса.Следующий() Цикл
		Если РезультатЗапроса.Просрочен = 2 Тогда
			МассивПросроченныхЛидов.Добавить(РезультатЗапроса.Ссылка);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

