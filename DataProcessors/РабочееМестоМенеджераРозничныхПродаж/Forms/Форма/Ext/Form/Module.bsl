Процедура ДобавитьОтборПоПолю(ЭлементТаблица, ВидСравнения, ИмяПоляЛевоеЗначение, ПравоеЗначение)
	
	ЭО = ЭлементТаблица.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭО.ВидСравнения		= ВидСравнения;
