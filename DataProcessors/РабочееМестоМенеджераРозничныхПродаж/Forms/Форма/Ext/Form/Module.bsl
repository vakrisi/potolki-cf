&НаСервере
Процедура УстановитьОтборМонтажей()
	
	// №9871 КоличествоФильтров = 0;
	
	Монтажи.Отбор.Элементы.Очистить();
	
	//++ 16281
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Монтажи,
			"Подразделение", МонтажиОтборПоПодразделению, ВидСравненияКомпоновкиДанных.Равно,, НЕ МонтажиОтборПоПодразделению.Пустая());
	
	//#16544
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Монтажи,
			"Контрагент", МонтажиОтборПоКонтрагенту, ВидСравненияКомпоновкиДанных.Равно,, НЕ МонтажиОтборПоКонтрагенту.Пустая());
	
	//#16544
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Монтажи,
			"ВидОперации", МонтажиОтборПоВиду, ВидСравненияКомпоновкиДанных.Равно,, НЕ МонтажиОтборПоВиду.Пустая());
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Монтажи,
			"Результат", МонтажиОтборПоРезультату, ВидСравненияКомпоновкиДанных.Равно,, НЕ МонтажиОтборПоРезультату.Пустая());
	
	ОтборДинамическогоСпискаМонтажи = Монтажи.КомпоновщикНастроек.ФиксированныеНастройки.Отбор;
	
	//#16544 поле изменено: 2-в-1
	Если ПустаяСтрока(МонтажиОтборПоДатеМонтажа) ТОгда
		// Фильтр по дате монтажа сброшен
	ИначеЕсли МонтажиОтборПоДатеМонтажа = "Не определена" Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Монтажи,
			"ДатаМонтажаНеОпределена", Истина, ВидСравненияКомпоновкиДанных.Равно,, Истина);
	Иначе
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Монтажи,
			"ДатаМонтажа", МонтажиОтборПоДатеМонтажаНачалоПериода, ВидСравненияКомпоновкиДанных.БольшеИлиРавно,, Истина);		
		ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ОтборДинамическогоСпискаМонтажи,
			"ДатаМонтажа", ВидСравненияКомпоновкиДанных.МеньшеИлиРавно, МонтажиОтборПоДатеМонтажаКонецПериода,, Истина);
	КонецЕсли;
	//--	

	//++ 16027
	Если ЗначениеЗаполнено(МонтажиОтборПериодВыполнения) Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Монтажи,
			"ДатаВыполнения", МонтажиОтборПериодВыполнения.ДатаНачала, ВидСравненияКомпоновкиДанных.БольшеИлиРавно,, Истина);
		ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ОтборДинамическогоСпискаМонтажи,
			"ДатаВыполнения", ВидСравненияКомпоновкиДанных.МеньшеИлиРавно, МонтажиОтборПериодВыполнения.ДатаОкончания,, Истина);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(МонтажиОтборПериодЗакрытия) Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Монтажи,
			"ДатаЗакрытия", МонтажиОтборПериодЗакрытия.ДатаНачала, ВидСравненияКомпоновкиДанных.БольшеИлиРавно,, Истина);
		ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ОтборДинамическогоСпискаМонтажи,
			"ДатаЗакрытия", ВидСравненияКомпоновкиДанных.МеньшеИлиРавно, МонтажиОтборПериодЗакрытия.ДатаОкончания,, Истина);
	КонецЕсли;
	//-- 16027	
	 
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Монтажи,
			"Бригада", МонтажиОтборПоБригаде, ВидСравненияКомпоновкиДанных.Равно,, НЕ МонтажиОтборПоБригаде.Пустая());
	
	Если НЕ МонтажиОтборПоЗамерщику.Пустая() Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Монтажи,
			"Ссылка", ПолучитьСписокСсылокНаМонтажиПоОтборуДоговора(МонтажиОтборПоЗамерщику), ВидСравненияКомпоновкиДанных.ВСписке,, НЕ МонтажиОтборПоЗамерщику.Пустая());		
	КонецЕсли;
	
	//++ №9894 фильтр по номеру заказ-договора, в привилегированном режиме (если нет доступа на просмотр)
	Если ЗначениеЗаполнено(МонтажиОтборНомерДоговора) Тогда
		
		ЭО = Монтажи.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭО.ВидСравнения		= ВидСравненияКомпоновкиДанных.ВСписке;
		ЭО.ЛевоеЗначение	= Новый ПолеКомпоновкиДанных("Ссылка");
		ЭО.ПравоеЗначение	= ПолучитьСписокСсылокНаМонтажиПоОтборуДоговора(МонтажиОтборНомерДоговора);
		ЭО.Использование	= Истина;
		
	КонецЕсли;
	//-- №9894
	
	//#10804
	Если Элементы.МонтажиУстановкаФильтраМонтажиМонтаж.Пометка 
		ИЛИ Элементы.МонтажиУстановкаФильтраМонтажиСервиснаяЗаявка.Пометка 
		ИЛИ Элементы.МонтажиУстановкаФильтраМонтажиРекламация.Пометка
		ИЛИ Элементы.МонтажиУстановкаФильтраМонтажиПродажи.Пометка Тогда // №12721
		
		СписокВидовМонтажа = Новый СписокЗначений;
		Если Элементы.МонтажиУстановкаФильтраМонтажиМонтаж.Пометка Тогда
			СписокВидовМонтажа.Добавить(ПредопределенноеЗначение("Справочник.ВидыМонтажа.Монтаж"));
		КонецЕсли;
		Если Элементы.МонтажиУстановкаФильтраМонтажиСервиснаяЗаявка.Пометка Тогда
			СписокВидовМонтажа.Добавить(ПредопределенноеЗначение("Справочник.ВидыМонтажа.СервиснаяЗаявка"));
		КонецЕсли;
		Если Элементы.МонтажиУстановкаФильтраМонтажиРекламация.Пометка Тогда
			СписокВидовМонтажа.Добавить(ПредопределенноеЗначение("Справочник.ВидыМонтажа.Рекламация"));
		КонецЕсли;
		
		//++ №12721
		Если Элементы.МонтажиУстановкаФильтраМонтажиПродажи.Пометка Тогда
			СписокВидовМонтажа.Добавить(ПредопределенноеЗначение("Справочник.ВидыМонтажа.Продажа"));
		КонецЕсли;
		//-- №12721
		
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Монтажи, "ВидОперации", СписокВидовМонтажа, ВидСравненияКомпоновкиДанных.ВСписке, , Истина);		
	КонецЕсли;
	
	//#16544
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Монтажи,
			"СтатусЗаказаРозницыНаПроизводство", МонтажиОтборПоСтатусуПроизводства, ВидСравненияКомпоновкиДанных.Равно,, МонтажиОтборПоСтатусуПроизводства >= -1);
	
	//#16544
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Монтажи,
			"СтатусЗаказаРозницыПоставщикам", МонтажиОтборПоСтатусуЗакупки, ВидСравненияКомпоновкиДанных.Равно,, МонтажиОтборПоСтатусуЗакупки >= -1);
	
	//#16544
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Монтажи,
			"ОбеспечениеМатериалами", МонтажиОтборПоВыдачеМатериалов, ВидСравненияКомпоновкиДанных.Равно,, МонтажиОтборПоВыдачеМатериалов >= -1);
	
КонецПроцедуры

