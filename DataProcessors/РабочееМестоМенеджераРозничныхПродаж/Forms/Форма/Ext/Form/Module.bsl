КонецПроцедуры
	
&НаСервере
Процедура ОбновитьЭлементыСостоянияПолученияПисемНаСервере()
	
	ДатаПоследнейПроверки = Константы.ПроверкаРекламныхЭлектронныхЯщиков_ПоследняяДатаПроверки.Получить();
	ПроверкаРекламныхЭлектронныхЯщиков_ПоследняяДатаПроверки = ДатаПоследнейПроверки;
	ПроверкаРекламныхЭлектронныхЯщиков_ПоследняяДатаУспешнойПроверки = Константы.ПроверкаРекламныхЭлектронныхЯщиков_ПоследняяДатаУспешнойПроверки.Получить();
	ПроверкаРекламныхЭлектронныхЯщиков_ТекстОшибки = Константы.ПроверкаРекламныхЭлектронныхЯщиков_ТекстОшибки.Получить();
	// 1. ошибка при работе регламентного задания
	ЕстьОшибкаПолученияПисем = НЕ ПустаяСтрока(ПроверкаРекламныхЭлектронныхЯщиков_ТекстОшибки);
	// 2. проверим запускалось ли само задание
	УстановитьПривилегированныйРежим(Истина);
	Задание = РегламентныеЗаданияСервер.Задание(Метаданные.РегламентныеЗадания.ПроверкаРекламныхЭлектронныхЯщиков);
	Если Задание.Использование Тогда
		ЗаданиеВыполняется = Ложь;
		Если НЕ Задание.ПоследнееЗадание = Неопределено Тогда
			ЗаданиеВыполняется = НЕ ЗначениеЗаполнено(Задание.ПоследнееЗадание.Конец);
		КонецЕсли;
		Если НЕ ЗаданиеВыполняется Тогда
			МассивЗаданий = ФоновыеЗадания.ПолучитьФоновыеЗадания(Новый структура ("Наименование", "Запуск вручную: " + Задание.Наименование));
			Если МассивЗаданий.Количество() > 0 Тогда
				ЗаданиеВыполняется = НЕ ЗначениеЗаполнено(МассивЗаданий[0].Конец);	
			КонецЕсли;
		КонецЕсли;	
		Если НЕ ЗаданиеВыполняется И Задание.Расписание.ТребуетсяВыполнение(ТекущаяДатаСеанса(), ДатаПоследнейПроверки) Тогда
			ЕстьОшибкаПолученияПисем = Истина;
		КонецЕсли;
	КонецЕсли;
	УстановитьПривилегированныйРежим(Ложь);
	
	Элементы.ГруппаПроверкаЭлектронныхЯщиковОшибки.Видимость = ЕстьОшибкаПолученияПисем;
	Элементы.ГруппаПисьма.Картинка = ?(ЕстьОшибкаПолученияПисем, БиблиотекаКартинок.КритическаяОшибка, Новый Картинка());
	
	Элементы.СостояниеПроверкиРекламныхЭлектронныхЯщиков.Картинка = ?(ЕстьОшибкаПолученияПисем, БиблиотекаКартинок.ОформлениеКругКрасный, БиблиотекаКартинок.ОформлениеКругЗеленый);
	
КонецПроцедуры

