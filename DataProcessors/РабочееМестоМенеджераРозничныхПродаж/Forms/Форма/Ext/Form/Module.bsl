&НаСервере
Процедура УстановитьФильтрыСпискаОбращений()
	
	// Вид обращения
	ВидОбращенияЭлемент = ?(ОтборВидОбращения = "БезВида" ИЛИ ПустаяСтрока(ОтборВидОбращения), Справочники.ВидыОбращенийЛида.ПустаяСсылка(), Справочники.ВидыОбращенийЛида[ОтборВидОбращения]); 
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(
		ЛидыОбращение, 
		"ВидОбращения", 
		ВидОбращенияЭлемент,
		ВидСравненияКомпоновкиДанных.Равно, ,
		НЕ ПустаяСтрока(ОтборВидОбращения)
	);
	
	// Закрытые 
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(
		ЛидыОбращение, 
		"РезультатОбращения", 
		Справочники.РезультатыЛида.Закрыт,
		ВидСравненияКомпоновкиДанных.НеРавно, ,
		НЕ ОтборПоказыватьЗакрытыеОбращения
	);	
	
КонецПроцедуры

