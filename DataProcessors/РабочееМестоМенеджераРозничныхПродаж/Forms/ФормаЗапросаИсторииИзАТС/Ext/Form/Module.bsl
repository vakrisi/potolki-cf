&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ДатаНачала = Константы.ТелефонияДатаНачальногоЗапросаИсторииЗвонков.Получить();	
	Если ЗначениеЗаполнено(ДатаНачала) Тогда	
		ДатаОкончания = Мин(ДатаНачала + 86400, ТекущаяДатаСеанса());
	Иначе
		ДатаОкончания = ТекущаяДатаСеанса();
		ДатаНачала = ДатаОкончания - 86400;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
		
КонецПроцедуры

&НаКлиенте
Процедура Запросить(Команда)
	
	Если ДатаНачала = Дата(1, 1, 1) ИЛИ ДатаОкончания = Дата(1, 1, 1) Тогда
		ПоказатьПредупреждение(, "Не указаны даты");
		Возврат;
	КонецЕсли;
	
	СтруктураВозврата = Новый Структура("ДатаНачала, ДатаОкончания", ДатаНачала, ДатаОкончания);
	Закрыть(СтруктураВозврата);
	
КонецПроцедуры

