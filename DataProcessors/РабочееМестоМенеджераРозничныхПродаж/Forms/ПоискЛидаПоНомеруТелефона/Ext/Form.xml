				<DynamicDataRead>false</DynamicDataRead>
				<QueryText>ВЫБРАТЬ РАЗРЕШЕННЫЕ
	ДокументЛид.Ссылка,
	ДокументЛид.ПометкаУдаления,
	ДокументЛид.Номер,
	ДокументЛид.Дата,
	ДокументЛид.Проведен,
	ДокументЛид.Адрес,
	ДокументЛид.ВидКонтакта,
	ДокументЛид.ВидНецелевогоЛида,
	//ДокументЛид.ДатаПоследнейРеакции, //#11632 закомментировано
	ДокументЛид.ДатаСоздания,
	ДокументЛид.ИмяКлиента,
	ДокументЛид.Комментарий,
	//ДокументЛид.ЛидID,
	ДокументЛид.Телефоны,
	ДокументЛид.Автор,
	ДокументЛид.ПоследнееВремяНачалаЗамера,
	ДокументЛид.ПоследнееВремяОкончанияЗамера,
	//ДокументЛид.ПоследнееВремяПерезвонить,
	ДокументЛид.ПоследнееЗамерВыполнен,
	ДокументЛид.ПоследнийИсполнительЗамера,
	ДокументЛид.ПоследнийКомментарий,
	ДокументЛид.ПоследнийКомментарийКЗамеру,
	ДокументЛид.ПоследнийРезультатЗамера,
	ДокументЛид.ПоследняяДатаЗамера,
	ДокументЛид.ПоследняяДатаПерезвонить,
	ДокументЛид.ПоследняяСуммаДоговораНаЗамере,
	ДокументЛид.ПредполагаемыйМонтажВремя,
	ДокументЛид.ПредполагаемыйМонтажДата,
	ДокументЛид.ПредполагаемыйМонтажДатаМонтажаНеОпределена,
	ДокументЛид.ПричинаОтказа,
	ДокументЛид.ПричинаПерезвонить,
	ДокументЛид.РекламнаяАкция,
	ДокументЛид.РекламныйИсточник,
	ДокументЛид.ТекущийСтатус,
	ДокументЛид.ТочкаПродаж,
	ДокументЛид.АдресаЭлектроннойПочты,
	ЕСТЬNULL(ДокументЛид.ОсновнойПредварительныйРасчет.СуммаДокумента, 0) КАК СуммаДокумента,
	ЕСТЬNULL(ДокументЛид.ОсновнойПредварительныйРасчет.ВидЦен, Значение(Справочник.ВидыЦен.ПустаяСсылка)) КАК ВидЦен,
	ЕСТЬNULL(ДокументЛид.ОсновнойПредварительныйРасчет.Валюта, Значение(Справочник.Валюты.ПустаяСсылка)) КАК Валюта,
	ЕСТЬNULL(ДокументЛид.ОсновнойПредварительныйРасчет.ВидСкидки, Значение(Справочник.ВидыСкидок.ПустаяСсылка)) КАК ВидСкидки,
	ЕСТЬNULL(ДокументЛид.ОсновнойПредварительныйРасчет.СуммаДокументаПоПрайсу, 0) КАК СуммаДокументаПоПрайсу,
	ЕСТЬNULL(ДокументЛид.ОсновнойПредварительныйРасчет.Организация, Значение(Справочник.Организации.ПустаяСсылка)) КАК Организация
ИЗ
	Документ.Лид КАК ДокументЛид
ГДЕ
	ДокументЛид.Телефоны ПОДОБНО &amp;Телефон</QueryText>
				<MainTable>Document.Лид</MainTable>
				<ListSettings>
					<dcsset:filter>
						<dcsset:item xsi:type="dcsset:FilterItemGroup">
							<dcsset:groupType>OrGroup</dcsset:groupType>
							<dcsset:item xsi:type="dcsset:FilterItemComparison">
								<dcsset:left xsi:type="dcscor:Field">ОсновнойТелефонКлиента</dcsset:left>
								<dcsset:comparisonType>Contains</dcsset:comparisonType>
								<dcsset:right xsi:type="xs:string"/>
