Процедура ЛидыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	//++ 16259
	СтандартнаяОбработка = Ложь;
	Ключ = Новый Структура("Ключ", ВыбраннаяСтрока);
	Форма = ПолучитьФорму("Документ.Лид.Форма.ФормаДокумента", Ключ); 
	Форма.Открыть();
	//-- 16259
КонецПроцедуры
