&НаСервере
Процедура УстановитьФильтрПоНомеруТелефона()
	
	ЗначениеНомера = НомерТелефона; 
	Если НЕ ПустаяСтрока(ЗначениеНомера) Тогда
		Лиды.Параметры.УстановитьЗначениеПараметра("Телефон", "%" + ЗначениеНомера + "%");
	Иначе 
		Лиды.Параметры.УстановитьЗначениеПараметра("Телефон", "НеУказан");
	КонецЕсли;
	
КонецПроцедуры

