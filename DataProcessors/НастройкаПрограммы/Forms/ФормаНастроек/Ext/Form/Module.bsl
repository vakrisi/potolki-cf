#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ОбщийМодуль.ЗапуститьИнициализациюВЛК();
	ОбщийМодуль.ЗапуститьРегламентноеЗаданиеПроверкиДоступностиРасширенныхСервисов();
	
	УстановитьУсловноеОформление();
	
	// запретим сортировку по указанным полям, иначе возможны "зависания"
	ЗапрещенныеПоляСортировки = Новый Массив;
	ЗапрещенныеПоляСортировки.Добавить("Документ");
	СписокОбъектовКОбработке.УстановитьОграниченияИспользованияВПорядке(ЗапрещенныеПоляСортировки);
	ЗапрещенныеПоляСортировки.Очистить();
	ЗапрещенныеПоляСортировки.Добавить("ОбъектСсылка");
	СписокОбязательныхОбъектовКОбработке.УстановитьОграниченияИспользованияВПорядке(ЗапрещенныеПоляСортировки);	
	
	//новый метод работ с константами (используется частично)
	Набор = РеквизитФормыВЗначение("НаборКонстант");
    Набор.Прочитать();
    ЗначениеВРеквизитФормы(Набор, "НаборКонстант");
	
	ЗаполнитьСпискиПравилФормированияНаименованийПотолкаПленкиФактуры();
	ЗаполнитьСпискиПравилФормированияСМСПриПереводеЗаказаНаПроизводствоВСтатусПроизведен();
	ЗаполнитьСписокВариантовФормированияПФЗаказаПокупателя();
	ЗаполнитьСписокВариантовФормированияПФСчетаНаОплату();
	ЗаполнитьСписокВариантовФормированияПФРТИУ();
	ЗаполнитьСписокВариантовФормированияПФЗаказаПоставщику();
	ЗаполнитьСписокВариантовФормированияПФПеремещения();
	ЗаполнитьСписокВариантовФормированияПФМатериалы();
	
	ЗаполнитьСписокВариантовПеремещенияТоваровИзЗаказДоговора();
	ЗаполнитьСписокВариантовТекстаНаГрафикеЗамеров();
	ЗаполнитьСписокВариантовТекстаНаГрафикеМонтажей();
	ЗаполнитьСписокВариантовСкладаРезервированияПоУмолчанию();
	
	ОбщийМодульСервер.ЗаполнитьПредопределенныеПорядкиОкругления(Элементы.НаборКонстантПорядокОкругленияЧисломСтоимостиПотолков);
	ОбщийМодульСервер.ЗаполнитьПредопределенныеПорядкиОкругления(Элементы.НаборКонстантПорядокОкругленияЧисломСтоимостиПотолковРозница);
	
	//Основные
	ВалютаУчета = Константы.ВалютаУчета.Получить();
	Элементы.ВалютаУчета.Доступность = ВалютаУчета.Пустая();	
	ОсновнаяВалютаПересчетаЦены = Константы.ОсновнаяВалютаПересчетаЦены.Получить();
	//Объект.ИспользоватьДополнительныеРеквизитыИСведения = Константы.ИспользоватьДополнительныеРеквизитыИСведения.Получить();
	Объект.ИспользоватьОбщиеДополнительныеЗначения = Константы.ИспользоватьОбщиеДополнительныеЗначения.Получить();
	Объект.ИспользоватьОбщиеДополнительныеРеквизитыИСведения = Константы.ИспользоватьОбщиеДополнительныеРеквизитыИСведения.Получить();	
	// №12800 Объект.НеИспользоватьПрефиксОрганизацииВНомереДокумента = Константы.НеИспользоватьПрефиксОрганизацииВНомереДокумента.Получить();
	//ПолучитьНастройкуПотолки("ПолФизЛицаОбязателенКЗаполнению");
	//ПолучитьНастройкуПотолки("ВыключитьПредпросмотрПрикрепленныхФайловВДокументах");
	//ПолучитьНастройкуПотолки("ЗапретПроведенияДокументовБудущимЧислом");
	//ПолучитьНастройкуПотолки("ОтображатьЗадолженностьКонтрагентаВВалюте");
	//ПолучитьНастройкуПотолки("ВалютаОтображенияЗадолженностиКонтрагента");
	УправлениеВидимостьюИсточникКурсаВалют();
	СписокEmailСтрокой = Константы.СписокEmailПоКонтролюПравокЗаднимЧислом.Получить();
	СписокEmailПоКонтролюПравокЗаднимЧислом.ЗагрузитьЗначения(СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(СписокEmailСтрокой, ";", Истина, Истина)); 
	
	ЗаполнитьЧасовыеПояса();
	ЧасовойПоясПрограммы = ПолучитьЧасовойПоясИнформационнойБазы();
	//Элементы.ЧасовойПоясПрограммы.СписокВыбора.Добавить(ЧасовойПоясПрограммы);
	
	Если Не ЗначениеЗаполнено(НаборКонстант.АрхивироватьПрикрепленныеДанныеСтарше) Тогда
		НаборКонстант.АрхивироватьПрикрепленныеДанныеСтарше = 24;
	КонецЕсли;
	
	// вкладка "Лиды"
	ПравилоПоискаИсторииОбращений = Константы.ПравилоПоискаИсторииОбращений.Получить().Получить();
	Если НЕ ПравилоПоискаИсторииОбращений = Неопределено Тогда
		ПравилоПоискаИсторииОбращений.Свойство("ПоТелефону", ПравилоПоискаИсторииОбращенийПоТелефону);
		ПравилоПоискаИсторииОбращений.Свойство("ПоАдресуЭлектроннойПочты", ПравилоПоискаИсторииОбращенийПоАдресуЭлектроннойПочты);
	КонецЕсли;
	
	Для Каждого ЭлементПеречисления Из Перечисления.СобытияИзмененияДатыСледующегоКонтактаЛида Цикл
		НоваяСтрока = НастройкиИзмененияДатыСледующегоКонтактаЛида.Добавить();
		НоваяСтрока.Событие = ЭлементПеречисления;		
		НоваяСтрока.Индекс = Перечисления.СобытияИзмененияДатыСледующегоКонтактаЛида.Индекс(ЭлементПеречисления);
		
		Если ЭлементПеречисления = Перечисления.СобытияИзмененияДатыСледующегоКонтактаЛида.ПриПереводеНаКонечныйСтатус
			ИЛИ ЭлементПеречисления = Перечисления.СобытияИзмененияДатыСледующегоКонтактаЛида.ПриЗакрытииВСтатусеОбращение
			Тогда
			НоваяСтрока.ОчисткаДаты = Истина;
		КонецЕсли;
	КонецЦикла; 
	НастройкиИзмененияДатыСледующегоКонтактаЛида.Сортировать("Индекс");
	НастройкаИзмененияДатыСледующегоКонтактаЛида = Константы.НастройкаИзмененияДатыСледующегоКонтактаЛида.Получить().Получить();
	Если НЕ НастройкаИзмененияДатыСледующегоКонтактаЛида = Неопределено Тогда
		Для каждого СтрокаНастройки из НастройкаИзмененияДатыСледующегоКонтактаЛида Цикл
			Событие = Неопределено;
			Попытка
				Событие = Перечисления.СобытияИзмененияДатыСледующегоКонтактаЛида[СтрокаНастройки.ИмяСобытия];
			Исключение
				Продолжить;
			КонецПопытки;
			Если НЕ Событие = Неопределено Тогда
				НайденныеСтроки = НастройкиИзмененияДатыСледующегоКонтактаЛида.НайтиСтроки(Новый Структура("Событие", Событие));
				Если НайденныеСтроки.Количество() > 0 Тогда
					НайденныеСтроки[0].Сдвиг = СтрокаНастройки.Сдвиг;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	//мобильный клиент
	Объект.ОтображатьЗамерыБудущейДатыВМобильномКлиентеЗамерщика = Константы.ОтображатьЗамерыБудущейДатыВМобильномКлиентеЗамерщика.Получить();
	ОбщиеНастройкиМКЗамерщика = НЕ НаборКонстант.ИспользуютсяИндивидуальныеНастройкиМобильногоКлиентаДляПользователей;
	ОбщиеНастройкиМКМонтажника = НЕ НаборКонстант.ИспользуютсяИндивидуальныеНастройкиМобильногоКлиентаМонтажникаДляПользователей;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	МобильныйКлиентЗамерщикаДоступныеВидыЦен.ВидЦены КАК ВидЦены,
	|	МобильныйКлиентЗамерщикаДоступныеВидыЦен.ПоУмолчанию КАК ПоУмолчанию
	|ИЗ
	|	РегистрСведений.МобильныйКлиентЗамерщикаДоступныеВидыЦен КАК МобильныйКлиентЗамерщикаДоступныеВидыЦен";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = МобильныйКлиентЗамерщикаДоступныеВидыЦен.Добавить();
		НоваяСтрока.ВидЦены = Выборка.ВидЦены;
		НоваяСтрока.ПоУмолчанию = Выборка.ПоУмолчанию;
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	МобильныйКлиентЗамерщикаДоступныеВидыСкидок.ВидСкидки КАК ВидСкидки
	|ИЗ
	|	РегистрСведений.МобильныйКлиентЗамерщикаДоступныеВидыСкидок КАК МобильныйКлиентЗамерщикаДоступныеВидыСкидок";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = МобильныйКлиентЗамерщикаДоступныеВидыСкидок.Добавить();
		НоваяСтрока.ВидСкидки = Выборка.ВидСкидки;
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	МобильныйКлиентЗамерщикаДоступнаяНоменклатура.Номенклатура КАК Номенклатура
	|ИЗ
	|	РегистрСведений.МобильныйКлиентЗамерщикаДоступнаяНоменклатура КАК МобильныйКлиентЗамерщикаДоступнаяНоменклатура";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = МобильныйКлиентЗамерщикаДоступнаяНоменклатура.Добавить();
		НоваяСтрока.Номенклатура = Выборка.Номенклатура;
	КонецЦикла;
	
	//замеры
	НастройкаОформленияГрафикаЗамеров = ОбщийМодульСервер.ПолучитьНастройкуОформленияГрафикаЗамеров();
	
	//монтажи
	НастройкаОформленияГрафикаМонтажей = ОбщийМодульСервер.ПолучитьНастройкуОформленияГрафикаМонтажей();

	//софтфон
	ТелефонияАдминистраторЛогин = Константы.ТелефонияАдминистраторЛогин.Получить();
	//ТелефонияАдминистраторПароль = Константы.ТелефонияАдминистраторПароль.Получить();
	//ТелефонияАдресСервера = Константы.ТелефонияАдресСервера.Получить();
	ТелефонияНомерПорта = Константы.ТелефонияНомерПорта.Получить();
	//ТелефонияSimplitЛогин = Константы.ТелефонияSimplitЛогин.Получить();
	//ТелефонияSimplitПароль = Константы.ТелефонияSimplitПароль.Получить();
	ПолучитьНастройкуПотолки("ТелефонияСтрана");
	
	//производство
	//ГруппаНоменклатурыПродукция = Константы.ГруппаНоменклатурыПродукция.Получить();
	//Объект.СуффиксАртПотолок = Константы.СуффиксАртПотолок.Получить();
	//Объект.СуффиксМногофактурныйПотолок = Константы.СуффиксМногофактурныйПотолок.Получить();
	//Объект.ПорядокФормированияНомераТиповогоОтреза = Константы.ПорядокФормированияНомераТиповогоОтреза.Получить();
	//Объект.ГруппаНоменклатурыДляОстатков = Константы.ГруппаНоменклатурыДляОстатков.Получить();
	//Объект.КонтролироватьМаксимальноеКоличествоПотолковВЧасКОтгрузке = Константы.КонтролироватьМаксимальноеКоличествоПотолковВЧасКОтгрузке.Получить();
	//Объект.МаксимальноеКоличествоПотолковВЧасКОтгрузке = Константы.МаксимальноеКоличествоПотолковВЧасКОтгрузке.Получить();
	// №14932 ПолучитьНастройкуПотолки("ЗаказыватьТоварыПриОформленииЗаказаНаПроизводствоНаОснованииЗаказаПокупателя");
	
	НастройкаОформленияЗаказов = ОбщийМодульСервер.ПолучитьНастройкуОформленияЗаказов();
	ПолучитьНастройкуПотолки("ВремяПодсветкиЗнППоДатеОжидаемойОтгрузки", Ложь);
	ПолучитьНастройкуПотолки("ВремяПодсветкиЗППоДатеОжидаемойОтгрузки", Ложь);
	
	//розница
	//Объект.ГруппаНовыхКонтрагентовРозницы = Константы.ГруппаНовыхКонтрагентовРозницы.Получить();
	Объект.ПорядокФормированияНаименованияПотолкаРозницы = Константы.ПорядокФормированияНаименованияПотолкаРозницы.Получить();
	//Объект.ЗаказПоставщикуВыделятьУслугиРаскрояИзПотолка = Константы.ЗаказПоставщикуВыделятьУслугиРаскрояИзПотолка.Получить();
	
	//Объект.АвтоматическиПрисваиватьНомерДоговораВЗаказДоговоре = Константы.АвтоматическиПрисваиватьНомерДоговораВЗаказДоговоре.Получить();
	ОбщийМодуль.ПолучитьДанныеПоШаблонуНомераДоговора(ТекущаяДатаСеанса(), ШаблонНомераДоговора, ПериодичностьНомераДоговора);	
	Элементы.ДекорацияШаблонНомераДоговора.Заголовок = ШаблонНомераДоговора;
	
	Объект.ИспользоватьВерсионированиеОбъектов = Константы.ИспользоватьВерсионированиеОбъектов.Получить();
	
	//Объект.ИспользоватьСправочникКомнатВРознице = Константы.ИспользоватьСправочникКомнатВРознице.Получить();
	
	//Объект.ИспользоватьМаскуВводаТелефона = Константы.ИспользоватьМаскуВводаТелефона.Получить();
	//Объект.НастройкаПредварительногоРасчетаЗаказаВРозницеПоУмолчанию = Константы.НастройкаПредварительногоРасчетаЗаказаВРозницеПоУмолчанию.Получить();
	
	//загрузка из построителя
	//ГруппаНоменклатурДляФактуры = Константы.ГруппаНоменклатурДляФактуры.Получить();
	//АвтоматическиЗагружатьВБазуЧертежПотолкаИзИзиСилинг = Константы.АвтоматическиЗагружатьВБазуЧертежПотолкаИзИзиСилинг.Получить();
	//Объект.ПорядокФормированияНаименованияПотолка = Константы.ПорядокФормированияНаименованияПотолка.Получить();
	Объект.ПорядокФормированияНаименованияПленки = Константы.ПорядокФормированияНаименованияПленки.Получить();
	//ПравилоОпределенияОтреза = Справочники.ПравилаОпределенияВидаПотолка.Отрез; //#12532
	Объект.ВыделятьУслугиРаскрояИзПотолкаПриЗагрузкеИзПостроителяВЗаказДоговор = Константы.ВыделятьУслугиРаскрояИзПотолкаПриЗагрузкеИзПостроителяВЗаказДоговор.Получить();
	ТекущийПорядокФормированияНаименованияПленки = Объект.ПорядокФормированияНаименованияПленки;
	//Объект.ПрефиксНаименованияПотолка = Константы.ПрефиксНаименованияПотолка.Получить();
	ПолучитьНастройкуПотолки("ПорядокФормированияНаименованияФактуры");
	ТекущийПорядокФормированияНаименованияФактуры = Объект.ПорядокФормированияНаименованияФактуры;
	//ПолучитьНастройкуПотолки("ПорядокФормированияНаименованияОтреза");
	//ПолучитьНастройкуПотолки("ПрефиксНаименованияОтреза");
	
	//смс
	ЕВостокСМСЛогин = Константы.ЕВостокСМСЛогин.Получить();
	ЕВостокСМСПароль = Константы.ЕВостокСМСПароль.Получить();
	ЕВостокСМСНомерСервиса = Константы.ЕВостокСМСНомерСервиса.Получить();
	ЕВостокСМСПодпись = Константы.ЕВостокСМСПодпись.Получить();
	
	АвтоматическиСоздаватьПоздравленияСДнемРожденияПоСМС = Константы.АвтоматическиСоздаватьПоздравленияСДнемРожденияПоСМС.Получить();
	ШаблонСМСПоздравленияНаДеньРождения = Константы.ШаблонСМСПоздравленияНаДеньРождения.Получить();
	ГруппаКонтрагентовДляПоздравленияСДнемРожденияЧерезСМС = Константы.ГруппаКонтрагентовДляПоздравленияСДнемРожденияЧерезСМС.Получить();
	
	//ЕВостокОтправлятьСМСЗамерщикуПриПланированииЗамера = Константы.ОтправлятьСМСЗамерщикуПриПланированииЗамера.Получить();
	//ЕВостокОтправлятьСМСКлиентуПриПланированииЗамера = Константы.ОтправлятьСМСКлиентуПриПланированииЗамера.Получить();
	//ЕВостокШаблонТекстаСМСОЗамереЗамерщику = Константы.ШаблонТекстаСМСОЗамереЗамерщику.Получить();
