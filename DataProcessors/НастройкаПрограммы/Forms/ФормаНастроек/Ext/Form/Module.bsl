&НаКлиенте
Процедура ПолучателиУведомленийОПросроченныхЛидахПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	
	// Удаляем дубли и пустые
	МассивСотрудников = новый Массив;
	
	КоличествоСтрок = ПолучателиУведомленийОПросроченныхЛидах.Количество() - 1;
	
	Для Сч = 0 По КоличествоСтрок Цикл
		
		ТекущаяСтрока = ПолучателиУведомленийОПросроченныхЛидах[КоличествоСтрок - Сч];
		
		Если Не ЗначениеЗаполнено(ТекущаяСтрока.Пользователь)
			Или НЕ МассивСотрудников.Найти(ТекущаяСтрока.Пользователь) = Неопределено
		Тогда
		
			ПолучателиУведомленийОПросроченныхЛидах.Удалить(КоличествоСтрок - Сч);
			
		КонецЕсли;
		
		МассивСотрудников.Добавить(ТекущаяСтрока.Пользователь);
		
	КонецЦикла;
	
КонецПроцедуры

