Процедура НастройкаЦветовОформленияЗаказов(Команда)
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Заказы", Истина);
	ПараметрыФормы.Вставить("НастройкиОформления", ПолучитьНастройкиОформленияЗаказов());
	ПараметрыФормы.Вставить("ВремяПодсветкиЗнППоДатеОжидаемойОтгрузки", ВремяПодсветкиЗнППоДатеОжидаемойОтгрузки);
	ПараметрыФормы.Вставить("ВремяПодсветкиЗППоДатеОжидаемойОтгрузки",  ВремяПодсветкиЗППоДатеОжидаемойОтгрузки);
	Оповещение = Новый ОписаниеОповещения("НастройкиОформленияЗавершение", ЭтотОбъект);
	ОткрытьФорму("ОбщаяФорма.НастройкаПодсветки", ПараметрыФормы, ЭтаФорма,,,, Оповещение);
	
КонецПроцедуры

&НаСервере
Функция ПолучитьНастройкиОформленияЗаказов()
	
	Возврат ОбщийМодульСервер.ПолучитьНастройкиОформленияЗаказов(НастройкаОформленияЗаказов);
			
КонецФункции

&НаКлиенте
Процедура НастройкиОформленияЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если НЕ Результат = Неопределено Тогда		
		НастройкаОформленияЗаказов = Результат.НастройкиОформления;
		ВремяПодсветкиЗнППоДатеОжидаемойОтгрузки = Результат.ВремяПодсветкиЗнППоДатеОжидаемойОтгрузки;
		ВремяПодсветкиЗППоДатеОжидаемойОтгрузки  = Результат.ВремяПодсветкиЗППоДатеОжидаемойОтгрузки;
		Модифицированность = Истина;
	КонецЕсли;
	
КонецПроцедуры

