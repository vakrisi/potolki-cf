&НаКлиенте
Процедура УдалитьФайлыВКаталоге(Путь)
	
	КоличествоФайлов = 0;
	
	Попытка
		Если НЕ ПустаяСтрока(Путь) Тогда
			МассивНайденныхФайлов = НайтиФайлы(Путь,"*", Ложь);
			Для Каждого Файл Из МассивНайденныхФайлов Цикл
				Если НЕ Файл.ЭтоКаталог() Тогда
					УдалитьФайлы(Путь,Файл.Имя);
					КоличествоФайлов = КоличествоФайлов + 1;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		ПоказатьПредупреждение(,"Удалено файлов: " + КоличествоФайлов);
	Исключение
		ПоказатьПредупреждение(,"Ошибка удаления файлов: " + ОписаниеОшибки());
	КонецПопытки;
	
КонецПроцедуры

