Процедура МобильныйКлиентЗамерщикаДоступныеВидыЦенПоУмолчаниюПриИзменении(Элемент)
	ТекущиеДанные = Элементы.МобильныйКлиентЗамерщикаДоступныеВидыЦен.ТекущиеДанные;
	Если ТекущиеДанные.ПоУмолчанию Тогда
		Для Каждого ТекСтрока Из МобильныйКлиентЗамерщикаДоступныеВидыЦен Цикл
			Если ТекСтрока.ВидЦены = ТекущиеДанные.ВидЦены Тогда
				ТекСтрока.ПоУмолчанию = Истина;
			Иначе
				ТекСтрока.ПоУмолчанию = Ложь;
			КонецЕсли;
		КонецЦикла;
	Иначе
		Для Каждого ТекСтрока Из МобильныйКлиентЗамерщикаДоступныеВидыЦен Цикл
			ТекСтрока.ПоУмолчанию = Ложь;
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

//++ №12087
&НаКлиенте
Процедура УдалитьЛицензию(Команда)
	
	ТекущиеДанные = Элементы.СерийныеНомера.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ОписаниеОповещения = новый ОписаниеОповещения("ПослеВопросаОбУдаленииЛицензии", ЭтотОбъект, новый Структура("ТекущиеДанные", ТекущиеДанные));
	
	ПоказатьВопрос(ОписаниеОповещения, "Вы действительно намерены удалить лицензию?", РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВопросаОбУдаленииЛицензии(Ответ, ДополнительныеПараметры) Экспорт
	
	Если НЕ Ответ = КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	ТекущиеДанные = ДополнительныеПараметры.ТекущиеДанные;
	
	УдалитьЛицензиюНаСервере(ТекущиеДанные.РегистрационныйНомер, ТекущиеДанные.PINКод);
	
	ОбновитьЭлементыФормы();
	ПолучитьИВывестиДополнительныеСведенияПоЛицензии();
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура УдалитьЛицензиюНаСервере(РегистрационныйНомер, PINКод)
	
	НаборЗаписей = РегистрыСведений.СерийныеНомера.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.РегистрационныйНомер.Установить(РегистрационныйНомер);
	
	НаборЗаписей.Прочитать();
	
	КоличествоЗаписей = НаборЗаписей.Количество() - 1;
	
	Для Сч = 0 По КоличествоЗаписей Цикл
		
		Если НаборЗаписей[КоличествоЗаписей - Сч].PINКод = PINКод Тогда
			
			НаборЗаписей.Удалить(КоличествоЗаписей - Сч);
			
			Прервать;
			
		КонецЕсли;
		
	КонецЦикла;
	
	НаборЗаписей.Записать();
	
КонецПроцедуры
