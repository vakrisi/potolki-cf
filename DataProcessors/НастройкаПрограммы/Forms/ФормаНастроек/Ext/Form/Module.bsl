&НаСервере
Функция ПереименоватьФактуруНаСервере()
	
	Результат = Истина;
	
	ТаблицаРезультата = Новый ТаблицаЗначений;
	ТаблицаРезультата.Колонки.Добавить("Фактура");
	ТаблицаРезультата.Колонки.Добавить("СтароеНаименование");
	ТаблицаРезультата.Колонки.Добавить("Материал");
	ТаблицаРезультата.Колонки.Добавить("ШиринаПолотна");
	ТаблицаРезультата.Колонки.Добавить("НовоеНаименование");
	ТаблицаРезультата.Колонки.Добавить("Переименован", Новый ОписаниеТипов("Булево"));
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ДанныеСправочника.Ссылка
	|ИЗ
	|	Справочник.Фактура КАК ДанныеСправочника
	|ГДЕ
	|	НЕ ДанныеСправочника.ЭтоГруппа
	|	И ((ВЫРАЗИТЬ(ДанныеСправочника.Материал КАК СТРОКА(100))) = """"
	|			ИЛИ ДанныеСправочника.ШиринаПолотна = 0)";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Сообщить("Для фактуры " + Выборка.Ссылка + " не указан материал или ширина!");
		Результат = Ложь;
	КонецЦикла;
	Если НЕ Результат Тогда
		Сообщить("Переименование отменено!");
		Возврат Результат;
	КонецЕсли;
		
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ДанныеСправочника.Ссылка КАК Фактура,
	|	ДанныеСправочника.Материал КАК Материал,
	|	ДанныеСправочника.ШиринаПолотна КАК ШиринаПолотна,
	|	ДанныеСправочника.Наименование КАК СтароеНаименование
	|ИЗ
	|	Справочник.Фактура КАК ДанныеСправочника
	|ГДЕ
	|	НЕ ДанныеСправочника.ЭтоГруппа";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		НоваяСтрока = ТаблицаРезультата.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		НоваяСтрока.НовоеНаименование = ОбменСEasyCeiling.ПолучитьНаименованиеФактуры(Выборка.Материал, Выборка.ШиринаПолотна, Объект.ПорядокФормированияНаименованияФактуры);

	КонецЦикла;
		
	ЕстьОшибкиЗаписи = Ложь;
	Если Результат Тогда
		Для Каждого ТекущаяСтрока Из ТаблицаРезультата Цикл
			Попытка
				СпрОбъект = ТекущаяСтрока.Фактура.ПолучитьОбъект();
				СпрОбъект.Наименование = ТекущаяСтрока.НовоеНаименование;
				СпрОбъект.Записать();
				ТекущаяСтрока.Переименован = Истина;
			Исключение
				Результат = Ложь;
				ЕстьОшибкиЗаписи = Истина;
				Сообщить("Не удалось записать фактуру " + ТекущаяСтрока.Фактура + ". Ошибка: " + ОписаниеОшибки());
			КонецПопытки;
		КонецЦикла;
	Иначе
		Сообщить("Переименование фактуры отменено");
	КонецЕсли;
	
	Если ЕстьОшибкиЗаписи Тогда
		//откатываем изменения
		Для Каждого ТекущаяСтрока Из ТаблицаРезультата Цикл
			Если ТекущаяСтрока.Переименован Тогда
				СпрОбъект = СпрОбъект.Фактура.ПолучитьОбъект();
				СпрОбъект.Наименование = СпрОбъект.СтароеНаименование;
				СпрОбъект.Записать();
				ТекущаяСтрока.Переименован = Ложь;
			КонецЕсли;
		КонецЦикла;
		Сообщить("При переименовании фактур произошла ошибка. Переименование отменено, фактурам возвращено старое наименование");
	КонецЕсли;
	
	Возврат Результат;
		
КонецФункции

