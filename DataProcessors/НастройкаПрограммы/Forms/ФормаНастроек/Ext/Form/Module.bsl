Процедура ЗаполнитьСпискиПравилФормированияНаименованийПотолкаПленкиФактуры()
	
	СписокПленка = ОбменСEasyCeiling.ПолучитьСписокПорядковФормированияНаименованийПленки();
	СписокПотолки = ОбменСEasyCeiling.ПолучитьСписокПорядковФормированияНаименованийПотолков();
	
	СписокПотолкиРозница = ОбщийМодуль.ПолучитьСписокПорядковФормированияНаименованийПотолковРозницы();
	СписокНомерТиповогоОтреза = ОбменСEasyCeiling.ПолучитьСписокПорядковФормированияНомераТиповогоОтреза();
	СписокФактура = ОбменСEasyCeiling.ПолучитьСписокПорядковФормированияНаименованийФактуры();
	
	СписокОтрезы = ОбменСEasyCeiling.ПолучитьСписокПорядковФормированияНаименованийОтреза(); // №12523
	
	Для НомерЭлемента = 0 По СписокПленка.Количество()-1 Цикл
		ТекЭлемент = СписокПленка.Получить(НомерЭлемента);
		Элементы.СписокПорядокФормированияНаименованияПленки.СписокВыбора.Добавить(ТекЭлемент.Значение, ТекЭлемент.Представление);
	КонецЦикла;
	
	Для НомерЭлемента = 0 По СписокПотолки.Количество()-1 Цикл
		ТекЭлемент = СписокПотолки.Получить(НомерЭлемента);
		Элементы.НаборКонстантПорядокФормированияНаименованияПотолка.СписокВыбора.Добавить(ТекЭлемент.Значение, ТекЭлемент.Представление);

		// №12523 теперь свои порядки наименования Элементы.НаборКонстантПорядокФормированияНаименованияОтреза.СписокВыбора.Добавить(ТекЭлемент.Значение, ТекЭлемент.Представление);
		Элементы.НаборКонстантПорядокФормированияНаименованияТиповогоОтреза.СписокВыбора.Добавить(ТекЭлемент.Значение, ТекЭлемент.Представление);
		Элементы.НаборКонстантПорядокФормированияНаименованияОстатковПленки.СписокВыбора.Добавить(ТекЭлемент.Значение, ТекЭлемент.Представление);
	КонецЦикла;
	
	//++ №12523
	Для НомерЭлемента = 0 По СписокОтрезы.Количество()-1 Цикл
		
		ТекЭлемент = СписокОтрезы.Получить(НомерЭлемента);
		Элементы.НаборКонстантПорядокФормированияНаименованияОтреза.СписокВыбора.Добавить(ТекЭлемент.Значение, ТекЭлемент.Представление);
		
	КонецЦикла;
	//-- №12523
	
	Для НомерЭлемента = 0 По СписокПотолкиРозница.Количество()-1 Цикл
		ТекЭлемент = СписокПотолкиРозница.Получить(НомерЭлемента);
		Элементы.СписокПорядокФормированияНаименованияПотолкаРозницы.СписокВыбора.Добавить(ТекЭлемент.Значение, ТекЭлемент.Представление);
	КонецЦикла;
	
	Для НомерЭлемента = 0 По СписокНомерТиповогоОтреза.Количество()-1 Цикл
		ТекЭлемент = СписокНомерТиповогоОтреза.Получить(НомерЭлемента);
	//	Элементы.НаборКонстантПорядокФормированияНомераТиповогоОтреза.СписокВыбора.Добавить(ТекЭлемент.Значение, ТекЭлемент.Представление);
		Элементы.НаборКонстантПорядокФормированияНомераОстатковПленки.СписокВыбора.Добавить(ТекЭлемент.Значение, ТекЭлемент.Представление);
	КонецЦикла;
	
	Для НомерЭлемента = 0 По СписокФактура.Количество()-1 Цикл
		ТекЭлемент = СписокФактура.Получить(НомерЭлемента);
