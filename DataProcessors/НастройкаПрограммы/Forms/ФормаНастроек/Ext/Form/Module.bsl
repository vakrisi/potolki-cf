&НаСервере 
Функция ЕстьОткрытыеСменыУчетаРабочегоВремени()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТабельСотрудников.Период КАК Период,
	|	ТабельСотрудников.Сотрудник КАК Сотрудник
	|ИЗ
	|	РегистрСведений.ТабельСотрудников КАК ТабельСотрудников
	|ГДЕ
	|	ТабельСотрудников.КонецСмены = ДАТАВРЕМЯ(1, 1, 1)";

	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат НЕ РезультатЗапроса.Пустой();	

КонецФункции

