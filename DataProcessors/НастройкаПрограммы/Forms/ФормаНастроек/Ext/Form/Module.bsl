Процедура ПослеЗакрытияВопросаПереименоватьСуществующуюПленку(Результат, ДополнительныеПараметры) Экспорт
	
    Если Результат = КодВозвратаДиалога.Да Тогда
        УспешноПереименовали = ПереименоватьПленкуНаСервере();
		Если УспешноПереименовали Тогда
			ПоказатьОповещениеПользователя("Номенклатура пленки переименована");
			ТекущийПорядокФормированияНаименованияПленки = Объект.ПорядокФормированияНаименованияПленки;
			СохранитьНаСервере();
			ОбновитьИнтерфейс();
			Если ДополнительныеПараметры.ЗакрытьФормуНастроек Тогда
				ЭтаФорма.Закрыть();
			КонецЕсли;
		Иначе
			Объект.ПорядокФормированияНаименованияПленки = ТекущийПорядокФормированияНаименованияПленки;
			ПоказатьПредупреждение(,"Не удалось переименовать номенклатуру пленки. Настройки не сохранены.");
		КонецЕсли;
	Иначе
		Объект.ПорядокФормированияНаименованияПленки = ТекущийПорядокФормированияНаименованияПленки;
		ПоказатьПредупреждение(,"Новое правило формирования наименования пленки не применено");
	КонецЕсли;
		
КонецПроцедуры

&НаСервере
Функция ПереименоватьПленкуНаСервере()
	
	Результат = Истина;
	
	ТаблицаРезультата = Новый ТаблицаЗначений;
	ТаблицаРезультата.Колонки.Добавить("Номенклатура");
	ТаблицаРезультата.Колонки.Добавить("СтароеНаименование");
	ТаблицаРезультата.Колонки.Добавить("Цвет");
	ТаблицаРезультата.Колонки.Добавить("Фактура");
	ТаблицаРезультата.Колонки.Добавить("ШиринаПолотна");
	ТаблицаРезультата.Колонки.Добавить("НовоеНаименование");
	ТаблицаРезультата.Колонки.Добавить("КоличествоНоменклатурСНовымНаименованием");
	ТаблицаРезультата.Колонки.Добавить("Переименован", Новый ОписаниеТипов("булево"));
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЦветФактуры.Ссылка,
	|	ЦветФактуры.Владелец КАК Фактура,
	|	ЦветФактуры.Владелец.ШиринаПолотна КАК ШиринаПолотна,
	|	ЦветФактуры.Номенклатура.Ссылка КАК Номенклатура,
	|	ЦветФактуры.Владелец.Материал КАК Материал,
	|	ЦветФактуры.Наименование КАК Цвет
	|ИЗ
	|	Справочник.ЦветФактуры КАК ЦветФактуры
	|ГДЕ
	|	ЦветФактуры.Номенклатура <> &ПустаяНоменклатура";
	Запрос.УстановитьПараметр("ПустаяНоменклатура",Справочники.Номенклатура.ПустаяСсылка());
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		НоваяСтрока = ТаблицаРезультата.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		НоваяСтрока.СтароеНаименование = Выборка.Номенклатура.Наименование;
		НоваяСтрока.НовоеНаименование = ОбменСEasyCeiling.ПолучитьНаименованиеПленки(Выборка.Цвет, Выборка.Фактура.Материал, Выборка.ШиринаПолотна, Объект.ПорядокФормированияНаименованияПленки);
		НоваяСтрока.КоличествоНоменклатурСНовымНаименованием = 1;
		
	КонецЦикла;
	
	ТаблицаДляПроверки = ТаблицаРезультата.Скопировать();
	ТаблицаДляПроверки.Свернуть("НовоеНаименование","КоличествоНоменклатурСНовымНаименованием");
	Для Каждого СтрокаПроверки Из ТаблицаДляПроверки Цикл
		Если СтрокаПроверки.КоличествоНоменклатурСНовымНаименованием > 1 Тогда
			Результат = Ложь;
			Сообщить("После смены правила наименования, в справочнике номенклатуры будет " + СтрокаПроверки.КоличествоНоменклатурСНовымНаименованием + " элементов с наименованием: " + СтрокаПроверки.НовоеНаименование);
		КонецЕсли;
	КонецЦикла;
	
	ЕстьОшибкиЗаписиНоменклатуры = Ложь;
	Если Результат Тогда
		Для Каждого ТекущаяСтока Из ТаблицаРезультата Цикл
			Попытка
				НоменклатураОбъект = ТекущаяСтока.Номенклатура.ПолучитьОбъект();
				НоменклатураОбъект.Наименование = ТекущаяСтока.НовоеНаименование;
				НоменклатураОбъект.Записать();
				ТекущаяСтока.Переименован = Истина;
			Исключение
				Результат = Ложь;
				ЕстьОшибкиЗаписиНоменклатуры = Истина;
				Сообщить("Не удалось записать номенклатуру " + ТекущаяСтока.Номенклатура + ". Ошибка: " + ОписаниеОшибки());
			КонецПопытки;
		КонецЦикла;
	Иначе
		Сообщить("Переименование номенклатуры пленки отменено");
	КонецЕсли;
	
	Если ЕстьОшибкиЗаписиНоменклатуры Тогда
		//откатываем изменения
		Для Каждого ТекущаяСтока Из ТаблицаРезультата Цикл
			Если ТекущаяСтока.Переименован Тогда
				НоменклатураОбъект = ТекущаяСтока.Номенклатура.ПолучитьОбъект();
				НоменклатураОбъект.Наименование = ТекущаяСтока.СтароеНаименование;
				НоменклатураОбъект.Записать();
				ТекущаяСтока.Переименован = Ложь;
			КонецЕсли;
		КонецЦикла;
		Сообщить("При выполнении операции переименования номенклатуры произошла ошибка. Переименование отменено, номенклатурам возвращено старое наименование");
	КонецЕсли;
	
	Возврат Результат
	
	
КонецФункции

