	Оповещение = Новый ОписаниеОповещения("ПослеДобавленияПродленияЛицензии", ЭтотОбъект);
	ПараметрыФормыКлюча = Новый Структура;
	ПараметрыФормыКлюча.Вставить("Добавление", Истина);
	ОткрытьФорму("ОбщаяФорма.ЗапросСерийногоКлюча", ПараметрыФормыКлюча, ЭтаФорма, ,,,Оповещение);
		
