Процедура ОбновитьСписокСерийныхНомеров()
	
	СерийныеНомера.Очистить();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СерийныеНомера.РегистрационныйНомер КАК РегистрационныйНомер,
	|	СерийныеНомера.PINКод КАК PINКод
	|ИЗ
	|	РегистрСведений.СерийныеНомера КАК СерийныеНомера";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = СерийныеНомера.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
	КонецЦикла;
	ОбщийМодуль.ОпределитьТекущийРегистрационныйНомерВТаблице(СерийныеНомера);
	
КонецПроцедуры

