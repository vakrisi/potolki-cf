				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Раздел ""Расширенные сервисы"": Не заполнена колонка ""Вид цены"" в строке " + НомерСтроки + " списка ""Доступные виды цен""",, "МобильныйКлиентЗамерщикаДоступныеВидыЦен");
				Результат = Ложь;
				
			КонецЕсли;
			
			НомерСтроки = НомерСтроки + 1;
			
		КонецЦикла;
		
		НомерСтроки = 1;
		Для Каждого ТекущаяСтрока Из МобильныйКлиентЗамерщикаДоступнаяНоменклатура Цикл
			
			Если Не ЗначениеЗаполнено(ТекущаяСтрока.Номенклатура) Тогда
				
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Раздел ""Расширенные сервисы"": Не заполнена колонка ""Номенклатура"" в строке " + НомерСтроки + " списка ""Доступная номенклатура""",, "МобильныйКлиентЗамерщикаДоступнаяНоменклатура");
				Результат = Ложь;
				
			КонецЕсли;
			
			НомерСтроки = НомерСтроки + 1;
			
		КонецЦикла;
			
	КонецЕсли;
	
	//#16861
	Если ЗначениеЗаполнено(НаборКонстант.ВремяНачалаСледующегоКонтакта)
		И ЗначениеЗаполнено(НаборКонстант.ВремяОкончанияСледующегоКонтакта) Тогда
		
		Если НаборКонстант.ВремяНачалаСледующегоКонтакта > НаборКонстант.ВремяОкончанияСледующегоКонтакта Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Раздел ""Розница"": ""Время начала следующего контакта"" превышает ""Время окончания следующего контакта""", , "НаборКонстант.ВремяНачалаСледующегоКонтакта");
			Возврат Ложь;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(НаборКонстант.ШагВремениВыбораСледующегоКонтакта) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Раздел ""Розница"": не заполнена настройка ""Шаг времени в часах в поле выбора времени следующего контакта""", , "НаборКонстант.ШагВремениВыбораСледующегоКонтакта");
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

