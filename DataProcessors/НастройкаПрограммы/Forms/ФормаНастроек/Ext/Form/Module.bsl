	РегламентноеЗадание = РегламентныеЗадания.НайтиПредопределенное("УведомлениеКонтрагентаОДолгеПоСМС");
	РегламентноеЗадание.Расписание = РасписаниеРегламентногоЗаданияСМСПоДолгам;
	
	Попытка
		РегламентноеЗадание.Записать();
	Исключение
	КонецПопытки;
	
