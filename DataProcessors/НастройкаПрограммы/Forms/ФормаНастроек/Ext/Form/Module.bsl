Процедура ПродлитьЛицензию(Команда)
	
	ТекущиеДанные = Элементы.СерийныеНомера.ТекущиеДанные;
	Если НЕ ТекущиеДанные = Неопределено Тогда
		Оповещение = Новый ОписаниеОповещения("ПослеДобавленияПродленияЛицензии", ЭтотОбъект);
		ПараметрыФормыКлюча = Новый Структура;
		ПараметрыФормыКлюча.Вставить("Продление", Истина);
		ПараметрыФормыКлюча.Вставить("РегистрационныйНомер", ТекущиеДанные.РегистрационныйНомер);
		ОткрытьФорму("ОбщаяФорма.ЗапросСерийногоКлюча", ПараметрыФормыКлюча, ЭтаФорма, , , ,Оповещение);
	Иначе
		ПоказатьОповещениеПользователя("Не выбран рег.номер");
	КонецЕсли;
	
КонецПроцедуры

