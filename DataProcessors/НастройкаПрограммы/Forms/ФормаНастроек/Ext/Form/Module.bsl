&НаКлиенте
Процедура НастроитьРасписаниеСозданияПоступленийИнтеркампани(Команда)
	
	ИмяРегламентногоЗадания = "";
	Если Команда.Имя = "НастроитьРасписаниеСозданияПоступленийИнтеркампани1" Тогда
		ИмяРегламентногоЗадания = "СозданиеПоступленийТоваровОтПроизводства";
	ИначеЕсли Команда.Имя = "НастроитьРасписаниеСозданияПоступленийИнтеркампани2" Тогда
		ИмяРегламентногоЗадания = "СозданиеПоступленийТоваровОтПроизводстваПоРучнымЗаказам";
	ИначеЕсли Команда.Имя = "НастроитьРасписаниеСозданияПоступленийИнтеркампани3" Тогда
		ИмяРегламентногоЗадания = "СозданиеПоступленийТоваровОтПроизводстваПоУдаленнойБазе";
	Иначе
		Возврат;
	КонецЕсли;
	
	#Если Не МобильныйКлиент Тогда
		
	РасписаниеРегламентногоЗадания = ПолучитьРасписаниеРегламентногоЗадания(ИмяРегламентногоЗадания);
		
	ОписаниеОповещения = Новый ОписаниеОповещения("НастроитьРасписаниеСозданияПоступленийИнтеркампаниЗавершение", ЭтотОбъект, ИмяРегламентногоЗадания);
	
	Диалог = Новый ДиалогРасписанияРегламентногоЗадания(РасписаниеРегламентногоЗадания);
	Диалог.Показать(ОписаниеОповещения);
	
	#КонецЕсли

КонецПроцедуры

&НаКлиенте
Процедура НастроитьРасписаниеСозданияПоступленийИнтеркампаниЗавершение(НовоеРасписание, ИмяРегламентногоЗадания) Экспорт

	Если НовоеРасписание <> Неопределено Тогда
		СохранитьРасписаниеРегламентногоЗадания(ИмяРегламентногоЗадания, НовоеРасписание);
	КонецЕсли;
	
