&НаСервере
Процедура ПолучитьИВывестиДополнительныеСведенияПоЛицензии()
	
	ЕстьДанные = Ложь;
	ТипЛицензии = "";
	КоличествоПользователей = "";
	СрокДействия = Дата(1,1,1);
	
	СоответствиеЛицензия = ОбщийМодуль.ПолучитьДополнительныеСведенияПоЛицензии();
	Если НЕ СоответствиеЛицензия = Неопределено Тогда
		Попытка
			КоличествоПользователей = СоответствиеЛицензия.Получить("count");
			СрокДействия = СоответствиеЛицензия.Получить("expdate");
			ТипЛицензии = СоответствиеЛицензия.Получить("type");
			ЕстьДанные = Истина;
		Исключение
			Элементы.ДекорацияНадписьЛицензия.Видимость = Ложь;
			Возврат;
		КонецПопытки;
		
		Если ЕстьДанные Тогда
			Элементы.ДекорацияНадписьЛицензия.Заголовок = "
			|Дополнительные сведения о лицензии
			|Тип лицензии: "+ ТипЛицензии + "
			|Количество пользователей: " + КоличествоПользователей + "
			|Срок действия: " + Формат(СрокДействия,"ДЛФ=D") + " (включительно)
			|";
			Элементы.ДекорацияНадписьЛицензия.Видимость = Истина;
			Если НачалоДня(СрокДействия) >= ТекущаяДатаСеанса() Тогда
				Элементы.ДекорацияНадписьЛицензия.ЦветТекста = WebЦвета.Зеленый;
			Иначе
				Элементы.ДекорацияНадписьЛицензия.ЦветТекста = WebЦвета.Красный;
			КонецЕсли;
		Иначе
			Элементы.ДекорацияНадписьЛицензия.Видимость = Ложь;
		КонецЕсли;
	Иначе
		Элементы.ДекорацияНадписьЛицензия.Видимость = Ложь;
	КонецЕсли;
		
КонецПроцедуры

