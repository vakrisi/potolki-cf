Процедура СохранитьНаСервере()
		
	Набор = РеквизитФормыВЗначение("НаборКонстант");
    Набор.Записать();
	
	// вкладка "Лиды"
	НастройкиИзменения = НастройкиИзмененияДатыСледующегоКонтактаЛида.Выгрузить(, "Событие, Сдвиг");
	НастройкиИзменения.Колонки.Добавить("ИмяСобытия", Новый ОписаниеТипов("Строка"));
