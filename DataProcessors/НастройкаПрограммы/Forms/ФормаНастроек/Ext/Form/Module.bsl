&НаСервере
Процедура ЗаполнитьЧасовыеПояса()
	
	//#13067
	//Элементы.ЧасовойПоясПрограммы.СписокВыбора.ЗагрузитьЗначения(ПолучитьДопустимыеЧасовыеПояса());
	
	ТаблицаПоясов = НОвый таблицаЗначений;
	ТаблицаПоясов.Колонки.Добавить("ОписаниеЧасовогоПояса", Новый ОписаниеТипов("Строка")); 
	ТаблицаПоясов.Колонки.Добавить("Смещение", Новый ОписаниеТипов("Число"));
	ТаблицаПоясов.Колонки.Добавить("ПредставлениеЧасовогоПояса", Новый ОписаниеТипов("Строка"));
	Для Каждого ОписаниеЧасовогоПояса Из ПолучитьДопустимыеЧасовыеПояса() Цикл
		
		//Смещение = СмещениеСтандартногоВремени(ОписаниеЧасовогоПояса); // не работает
		Смещение = МестноеВремя(ТекущаяУниверсальнаяДата(), ОписаниеЧасовогоПояса) - ТекущаяУниверсальнаяДата();
		
		СмещениеДатой = Дата(1, 1, 1) + ?(Смещение >= 0, Смещение, -Смещение);		
		
		ПредставлениеСмещения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку("(UTC%1%2)",
		                                                                                ?(Смещение >= 0, "+", "-"),
																						Формат(СмещениеДатой, "ДФ=HH:mm; ДП=00:00;"));
		
		ПредставлениеЧасовогоПояса = ПредставлениеСмещения + " " + ОписаниеЧасовогоПояса;
		
		НоваяСтрока = ТаблицаПоясов.Добавить();
		НоваяСтрока.ОписаниеЧасовогоПояса = ОписаниеЧасовогоПояса;
		НоваяСтрока.Смещение = Смещение;
		НоваяСтрока.ПредставлениеЧасовогоПояса = ПредставлениеЧасовогоПояса;
		//Элементы.ЧасовойПоясПрограммы.СписокВыбора.Добавить(ОписаниеЧасовогоПояса, ПредставлениеЧасовогоПояса);
		
	КонецЦикла;
	
	ТаблицаПоясов.Сортировать("Смещение, ОписаниеЧасовогоПояса");
	Для каждого СтрокаТЗ из ТаблицаПоясов Цикл
		Элементы.ЧасовойПоясПрограммы.СписокВыбора.Добавить(СтрокаТЗ.ОписаниеЧасовогоПояса, СтрокаТЗ.ПредставлениеЧасовогоПояса);
	КонецЦикла;
	
КонецПроцедуры

