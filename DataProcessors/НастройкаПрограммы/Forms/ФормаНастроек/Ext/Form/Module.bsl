&НаКлиенте
Функция ОтметитьСервисСМС(ИмяСервисаНастройки)
	
	МассивСервисов = Новый Массив;
	МассивСервисов.Добавить("ЕВостокИспользоватьОтправкуСМС");
	МассивСервисов.Добавить("СМСFlyИспользоватьОтправкуСМС");
	МассивСервисов.Добавить("КазИнфоТехИспользоватьОтправкуСМС");
	МассивСервисов.Добавить("СМСРуИспользоватьОтправкуСМС");
	МассивСервисов.Добавить("ИспользоватьОтправкуСМСRocketSMSBy"); //2020-04-02
	МассивСервисов.Добавить("ИспользоватьОтправкуСМСProstorSMS"); // №8533
	
	Для каждого ИмяСервиса из МассивСервисов Цикл
		Если НЕ (ИмяСервиса = ИмяСервисаНастройки) Тогда
			НаборКонстант[ИмяСервиса] = Ложь;
		КонецЕсли;
	КонецЦикла;
	
	ОбновитьЭлементыФормыНаСервере("СМС");
		
КонецФункции

