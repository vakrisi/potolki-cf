&НаСервере
Процедура ОбновитьНадписьБудетВыгруженоНоменклатурыВМобильныйКлиент()
	
	Запрос = новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	КОЛИЧЕСТВО(ССЫЛКА) КАК Количество
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	Номенклатура.Ссылка В ИЕРАРХИИ (&Номенклатура)
	|";
	Запрос.УстановитьПараметр("Номенклатура", МобильныйКлиентЗамерщикаДоступнаяНоменклатура.Выгрузить(, "Номенклатура").ВыгрузитьКолонку("Номенклатура"));
	
	Количество = 0;
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Количество = Выборка.Количество;
	КонецЕсли;
	
	РекомендуемоеКоличество = 1000;
	
	Элементы.ДекорацияБудетВыгруженоНоменклатуры.Заголовок = СтрШаблон("Будет выгружено %1 элементов номенклатуры. Рекомендуемое количество - не более %2 элементов.", Количество, РекомендуемоеКоличество);
	
	Элементы.ДекорацияБудетВыгруженоНоменклатуры.ЦветТекста = ?(Количество > РекомендуемоеКоличество, ЦветаСтиля.ЦветОсобогоТекста, ЦветаСтиля.ТекстИнформационнойНадписи);
	Элементы.ДекорацияБудетВыгруженоНоменклатуры.Шрифт = Новый Шрифт(,, ?(Количество > РекомендуемоеКоличество, Истина, Ложь));
	
КонецПроцедуры

