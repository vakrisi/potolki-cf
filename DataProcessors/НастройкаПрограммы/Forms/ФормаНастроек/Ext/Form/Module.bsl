		//Элементы.ГруппаНастройкаСофтФонROMAsterisk.Видимость = НаборКонстант.ИспользоватьROMAsterisk;
		//
		//Элементы.СтраницаНастроекПрочихАТС.Видимость =  НаборКонстант.ИспользоватьROMHMAC
		//											ИЛИ НаборКонстант.ИспользоватьМегафон 
		//											ИЛИ НаборКонстант.ИспользоватьUIS 
		//											ИЛИ НаборКонстант.ИспользоватьDomRu 
		//											ИЛИ НаборКонстант.ИспользоватьSipuni
		//											ИЛИ НаборКонстант.ИспользоватьBinotel
		//											ИЛИ НаборКонстант.ИспользоватьMango
		//											ИЛИ НаборКонстант.ИспользоватьPhonet
		//											;
		Элементы.ГруппаOnlinePBX.Видимость = НаборКонстант.ИспользоватьROMHMAC;										
		Элементы.НаборКонстантТелефонияАдминистраторПароль2.Видимость = НЕ НаборКонстант.ИспользоватьMango;		
		Элементы.ГруппаSipuni.Видимость = НаборКонстант.ИспользоватьSipuni;
		Элементы.НаборКонстантТелефонияПарольAPI.Видимость = НаборКонстант.ИспользоватьBinotel;
		Элементы.ГруппаMango.Видимость = НаборКонстант.ИспользоватьMango;
		
		Элементы.ГруппаЛидыПоПропущеннымЗвонкам.Видимость = ИспользуетсяАТС;
		Если НЕ Элементы.ГруппаЛидыПоПропущеннымЗвонкам.Видимость Тогда
			НаборКонстант.АвтоматическиСоздаватьЛидыПоПропущеннымЗвонкам = Ложь;
		КонецЕсли;
			
		ТелефонияТаргет	= "";
		Если НаборКонстант.ИспользоватьROMHMAC Тогда
			ТелефонияТаргет = "onlinepbx";	
		ИначеЕсли НаборКонстант.ИспользоватьМегафон Тогда
			ТелефонияТаргет = "megafon";							
		ИначеЕсли НаборКонстант.ИспользоватьUIS Тогда 
			ТелефонияТаргет = "uis";
		ИначеЕсли НаборКонстант.ИспользоватьDomRu Тогда
			ТелефонияТаргет = "domru";
		ИначеЕсли НаборКонстант.ИспользоватьSipuni Тогда
			ТелефонияТаргет = "sipuni";
		ИначеЕсли НаборКонстант.ИспользоватьBinotel Тогда
			ТелефонияТаргет = "binotel";
		ИначеЕсли НаборКонстант.ИспользоватьMango Тогда
			ТелефонияТаргет = "mango";
		ИначеЕсли НаборКонстант.ИспользоватьPhonet Тогда
			ТелефонияТаргет = "phonet";
		ИначеЕсли НаборКонстант.ИспользоватьБилайн Тогда
			ТелефонияТаргет = "beeline";
		КонецЕсли;
		АдресВнешнейСистемыДляВАТС = СофтФонКлиентСервер.АдресВнешнейСистемыДляВАТС(ТелефонияТаргет, НаборКонстант.КлючAPI);
		//СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(	
		//									"https://api.smartceilings.ru/webhooks?target=%1&apikey=%2",
		//                                    ТелефонияТаргет,
		//                                    НаборКонстант.КлючAPI);
		ОбщийМодуль.ЗадатьЗаголовокФлагаВключенияСервиса(Элементы.ДекорацияСрокДействияКоннектор);

		Если ИмяВкладки = "Телефония" Тогда
			Возврат;
		КонецЕсли;
		
	КонецЕсли;
	
	Если ИмяВкладки = "ЭлектроннаяПочта" ИЛИ ИмяВкладки = "Все" Тогда
		
		Элементы.ГруппаEmailПоКонтролюПравокЗаднимЧислом.Доступность = НаборКонстант.ОтправлятьEmailПоКонтролюПравокЗаднимЧислом;
		
		Элементы.ГруппаEmailДетализацияВзаиморасчетов.Доступность = НаборКонстант.ОтправлятьДетализациюВзаиморасчетовПриИзмененииВзаиморасчетов; //ОтправлятьДетализациюВзаиморасчетов; 
		
		Если ИмяВкладки = "ЭлектроннаяПочта" Тогда
			Возврат;
		КонецЕсли;
		
	КонецЕсли;	
	
	Если ИмяВкладки = "Лицензия" ИЛИ ИмяВкладки = "Все" Тогда
		
		ОбновитьСписокСерийныхНомеров();
			
		Если ИмяВкладки = "Лицензия" Тогда
			Возврат;
		КонецЕсли;
		
	КонецЕсли;	
	
	Если ИмяВкладки = "Обновление" ИЛИ ИмяВкладки = "Все" Тогда
		//отображение элементов обновления программы		
		//получим текущую версию программы
		Элементы.ДекорацияВерсияПрограммы.Заголовок = Метаданные.Версия;
		
		//определим необходимость выполнения процедур после обновления
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ОбъектыКОбработкеПослеОбновленияРекомендуемые.ВерсияПрограммы КАК ВерсияПрограммы,
		|	ОбъектыКОбработкеПослеОбновленияРекомендуемые.ВерсияПрограммыЧисло,
		|	КОЛИЧЕСТВО(ОбъектыКОбработкеПослеОбновленияРекомендуемые.Документ) КАК КоличествоОбъектов
		|ИЗ
		|	РегистрСведений.ОбъектыКОбработкеПослеОбновленияРекомендуемые КАК ОбъектыКОбработкеПослеОбновленияРекомендуемые
		|
		|СГРУППИРОВАТЬ ПО
		|	ОбъектыКОбработкеПослеОбновленияРекомендуемые.ВерсияПрограммы,
		|	ОбъектыКОбработкеПослеОбновленияРекомендуемые.ВерсияПрограммыЧисло
		|
		|УПОРЯДОЧИТЬ ПО
		|	ОбъектыКОбработкеПослеОбновленияРекомендуемые.ВерсияПрограммыЧисло
		|
		|;
		|///////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ОбъектыКОбработкеПриОбновлении.ВерсияПрограммы,
		|	ОбъектыКОбработкеПриОбновлении.ВерсияПрограммыЧисло,
		|	КОЛИЧЕСТВО(ОбъектыКОбработкеПриОбновлении.ОбъектСсылка) КАК КоличествоОбъектов
		|ИЗ
		|	РегистрСведений.ОбъектыКОбработкеПослеОбновленияОбязательные КАК ОбъектыКОбработкеПриОбновлении
		|
		|СГРУППИРОВАТЬ ПО
		|	ОбъектыКОбработкеПриОбновлении.ВерсияПрограммы,
		|	ОбъектыКОбработкеПриОбновлении.ВерсияПрограммыЧисло
		|
		|УПОРЯДОЧИТЬ ПО
		|	ОбъектыКОбработкеПриОбновлении.ВерсияПрограммыЧисло
		|";
		
		РезультатЗапроса = Запрос.ВыполнитьПакет(); //.Выгрузить();
		
		ТаблицаОбъектов = РезультатЗапроса[0].Выгрузить();
		ТаблицаОбъектовОбязательные = РезультатЗапроса[1].Выгрузить();
		
		ЕстьОбязательныеОбъектыКОбработкеПослеОбновления = (ТаблицаОбъектовОбязательные.Количество() > 0);
		
		Если ТаблицаОбъектов.Количество() = 0 И ТаблицаОбъектовОбязательные.Количество() = 0 Тогда
			
			//все хорошо, выполнять дополнительные операции не требуется
			Элементы.ГруппаОбновление.Картинка = Новый Картинка();
			Элементы.ГруппаДокументыКОбработке.Видимость = Ложь;
			Элементы.ДекорацияОбновленияВыполнены.Видимость = Истина;
			
		Иначе
			
			//имеются необработанные документы
			Элементы.ГруппаОбновление.Картинка = ?(ЕстьОбязательныеОбъектыКОбработкеПослеОбновления, БиблиотекаКартинок.КритическаяОшибка, БиблиотекаКартинок.Предупреждение);
			Элементы.ГруппаДокументыКОбработке.Видимость = Истина;
			Элементы.ДекорацияОбновленияВыполнены.Видимость = Ложь;
			
			//РезультатЗапроса.Сортировать("ВерсияПрограммы Возр");
			НадписьСпискаДокументов = "Объекты к обработке:
			|";
			НадписьСпискаДокументовОбязательные = "Обязательные объекты к обработке:
			|";
			
			Для Каждого ТекущаяВерсия Из ТаблицаОбъектов Цикл
				НадписьСпискаДокументов = НадписьСпискаДокументов + "Версия: " + ТекущаяВерсия.ВерсияПрограммы + " Объектов к обработке: " + ТекущаяВерсия.КоличествоОбъектов + Символы.ПС;
			КонецЦикла;
			
			Для Каждого ТекущаяВерсия Из ТаблицаОбъектовОбязательные Цикл
				НадписьСпискаДокументовОбязательные = НадписьСпискаДокументовОбязательные + "Версия: " + ТекущаяВерсия.ВерсияПрограммы + " Объектов к обработке: " + ТекущаяВерсия.КоличествоОбъектов + Символы.ПС;
			КонецЦикла;
			
			Элементы.ДекорацияДокументыКОбработке.Заголовок = НадписьСпискаДокументов;
			Элементы.ДекорацияДокументыКОбработкеОбязательные.Заголовок = НадписьСпискаДокументовОбязательные;
			
			Элементы.ДекорацияДокументыКОбработке.Видимость = (ТаблицаОбъектов.Количество() > 0);
			Элементы.ДекорацияДокументыКОбработкеОбязательные.Видимость = (ТаблицаОбъектовОбязательные.Количество() > 0);
			
		КонецЕсли;
		
		Элементы.СтраницаОбязательныеОбъектыКОбработкеПриОбновлении.Видимость = ЕстьОбязательныеОбъектыКОбработкеПослеОбновления;
		Если НЕ ЕстьОбязательныеОбъектыКОбработкеПослеОбновления
			И Элементы.СтраницыОбъектыКОбработкеПриОбновлении.ТекущаяСтраница = Элементы.СтраницаОбязательныеОбъектыКОбработкеПриОбновлении Тогда
			Элементы.СтраницыОбъектыКОбработкеПриОбновлении.ТекущаяСтраница = Элементы.СтраницаОбъектыКОбработкеПриОбновлении;
		КонецЕсли;
		
		Если ИмяВкладки = "Обновление" Тогда
			Возврат;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьЭлементыФормы()
	
	СрокПоддержки = ОбщийМодуль.ПолучитьСрокЗавершенияПоддержки();
	Если СрокПоддержки = 0 Тогда
		Элементы.ДекорацияНадписьПоддержка.Заголовок = "Вышел срок технической поддержки! Обратитесь к разработчику!";
		Элементы.ДекорацияНадписьПоддержка.ЦветТекста = WebЦвета.Красный;
	ИначеЕсли СрокПоддержки <= 30 Тогда
		Элементы.ДекорацияНадписьПоддержка.Заголовок = "Срок поддержки завершится через "+СрокПоддержки+" дней. Обратитесь к разработчику!";
		Элементы.ДекорацияНадписьПоддержка.ЦветТекста = WebЦвета.ОранжевоКрасный;
	Иначе
		Элементы.ДекорацияНадписьПоддержка.Заголовок = "Ваша конфигурация будет находится на поддержке еще "+СрокПоддержки+" дней.";
		Элементы.ДекорацияНадписьПоддержка.ЦветТекста = WebЦвета.Зеленый;
	КонецЕсли;
	
	Элементы.ОткрытьУзлыОбмена.Видимость = Объект.ИспользоватьОбменСПорталом;
	
	Элементы.ГруппаНастройкиМобильногоКлиентаЗамерщика.Доступность = НаборКонстант.ИспользуетсяМобильныйКлиентЗамерщика;
	
	Элементы.НаборКонстантРазрешитьРезервированиеОтсутствующегоТовара.Доступность = НаборКонстант.ИспользоватьРезервирование;
		
	ОбновитьЭлементыФормыНаСервере("Все");
	
КонецПроцедуры

#Область ОбработкаВкладкиОсновные

&НаКлиенте
Процедура ТелефонияСтранаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	СписокСтран = СофтФон.ПолучитьСписокСтранДляиспользованияТелефонии();
	
	Оп = Новый ОписаниеОповещения("ВыборСтраныТелефонии", ЭтаФорма);
	ПоказатьВыборИзМеню(Оп, СписокСтран, Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыборСтраныТелефонии(ВыбранныйЭлемент, ДополнительныеПараметры) Экспорт 
	Если ВыбранныйЭлемент <> Неопределено Тогда
		Объект.ТелефонияСтрана = ВыбранныйЭлемент.Значение;
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ВалютаУчетаПриИзменении(Элемент)
	Если НаборКонстант.ОсновнаяВалютаПересчетаЦены.Пустая() Тогда
		НаборКонстант.ОсновнаяВалютаПересчетаЦены = ВалютаУчета;
	КонецЕсли;
	
	УправлениеВидимостьюИсточникКурсаВалют();
КонецПроцедуры

&НаСервере
Процедура УправлениеВидимостьюИсточникКурсаВалют()
	//Элементы.НаборКонстантИсточникЗагрузкиКурсовВалют.Видимость = (ВалютаУчета = Справочники.Валюты.USD ИЛИ ВалютаУчета = Справочники.Валюты.EUR);
	//Элементы.ОсновнаяВалютаПересчетаЦены.Видимость = Элементы.НаборКонстантИсточникЗагрузкиКурсовВалют.Видимость;
КонецПроцедуры

&НаКлиенте
Процедура НаборКонстантДополнительнаяОценкаЗапасовВВалютеПриИзменении(Элемент)
	ОбновитьЭлементыФормыНаСервере("Основные");	
КонецПроцедуры

&НаКлиенте
Процедура ЧасовойПоясПрограммыПриИзменении(Элемент)
	
	УстановитьЧасовойПоясНаСервере();
	ОбновитьПовторноИспользуемыеЗначения();
	
КонецПроцедуры

&НаСервере
Процедура УстановитьЧасовойПоясНаСервере()
	
	Если ЧасовойПоясПрограммы <> ПолучитьЧасовойПоясИнформационнойБазы() Тогда
		УстановитьПривилегированныйРежим(Истина);
		Попытка
			УстановитьМонопольныйРежим(Истина);
			УстановитьЧасовойПоясИнформационнойБазы(ЧасовойПоясПрограммы);
			Константы.ЧасовойПоясОбластиДанных.Установить(ЧасовойПоясПрограммы);
			УстановитьМонопольныйРежим(Ложь);
		Исключение
			УстановитьМонопольныйРежим(Ложь);
			ВызватьИсключение;
		КонецПопытки;
		УстановитьПривилегированныйРежим(Ложь);
		УстановитьЧасовойПоясСеанса(ЧасовойПоясПрограммы);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьВремяТекущегоСеанса(Команда)
	
	ПоказатьПредупреждение(,
		СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Время сеанса: %1
				|На сервере: %2
				|На клиенте: %3
				|
				|Время сеанса - это время сервера,
				|приведенное к часовому поясу клиента.'"),
			Формат(ОбщегоНазначенияКлиент.ДатаСеанса(), "ДЛФ=T"),
			Формат(ДатаСервера(), "ДЛФ=T"),
			Формат(ТекущаяДата(), "ДЛФ=T")));
	
КонецПроцедуры

&НаКлиенте
Процедура НаборКонстантИспользоватьДополнительныеРеквизитыИСведенияПриИзменении(Элемент)
	ОбновитьЭлементыФормыНаСервере("Основные");
КонецПроцедуры

&НаКлиенте
Процедура НаборКонстантВестиЖурналПравокЗаднимЧисломПриИзменении(Элемент)
	ОбновитьЭлементыФормыНаСервере("Основные");		
КонецПроцедуры

&НаКлиенте
Процедура НастройкаСпискаДокументовКонтроляПравокЗаднимЧислом(Команда)
	Если НЕ ВестиЖурналПравокЗаднимЧислом() И Модифицированность Тогда
		Сообщить("Для настройки предварительно требуется сохранить настройки программы");
		Возврат;
	КонецЕсли;
	ОткрытьФорму("РегистрСведений.НастройкиЖурналаПравокЗаднимЧислом.ФормаСписка");
КонецПроцедуры

&НаСервереБезКонтекста
Функция ВестиЖурналПравокЗаднимЧислом()
	Возврат ПолучитьФункциональнуюОпцию("ВестиЖурналПравокЗаднимЧислом");	
КонецФункции

&НаКлиенте
Процедура НастроитьРегламентноеЗаданиеУведомленияПоКонтролюПравокЗаднимЧислом(Команда)
	
	Идентификатор = ПолучитьИдентификаторРегламентногоЗадания("УведомлениеПоКонтролюПравокЗаднимЧислом");
	Если НЕ Идентификатор = Неопределено Тогда
		ПараметрыОбработки = Новый Структура;
		ПараметрыОбработки.Вставить("Идентификатор", Идентификатор);
		ПараметрыОбработки.Вставить("Действие", "Изменить");
		ОткрытьФорму("Обработка.РегламентныеИФоновыеЗадания.Форма.РегламентноеЗадание", ПараметрыОбработки);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КонтрольРеквизитов(Команда)
	ОткрытьФорму("РегистрСведений.РеквизитыДляКонтроля.ФормаСписка");
КонецПроцедуры

#КонецОбласти

