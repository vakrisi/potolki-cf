				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		Сообщить("Удалено файлов: " + КоличествоФайлов);
	Исключение
		Сообщить("Ошибка удаления файлов: " + ОписаниеОшибки());
	КонецПопытки;
	
