&НаКлиенте
Процедура ПереместитьВправо(Команда)
	ТекОбласть = Элементы.ОргСхема.ТекущаяОбласть;
	ТекЭлем = ТекОбласть.Расшифровка;
	
	Если ТекЭлем = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПереместитьВправоНаСервере(ТекЭлем);
	ОбновитьОС(МассивНарисованныхЭлементов);
КонецПроцедуры

&НаСервере
Процедура ПереместитьВправоНаСервере(ТекЭлем)
	ТекРодитель = ТекЭлем.Родитель;
	
	Если ЗначениеЗаполнено(ТекРодитель) и ТипЗнч(ТекРодитель) = Тип("СправочникСсылка.ОргСхема") Тогда
		Подчиненные = ПолучитьПодчиненные(ТекРодитель); 
		ТекСтрока = Подчиненные.Найти(ТекЭлем,"Ссылка" );
		Если Подчиненные.Количество() = ТекСтрока.НомерСтроки Тогда //Крайний
			//СледСтрока = Подчиненные.Найти(1,"НомерСтроки" );
			Для каждого ТекЭлемент Из Подчиненные Цикл
				Если ТекЭлемент = ТекСтрока Тогда
					ТекОбъект = ТекЭлемент.Ссылка.ПолучитьОбъект();
					ТекОбъект.ПорядокВСхеме = Подчиненные.Найти(1,"НомерСтроки" );
					ТекОбъект.Записать();
				Иначе
					ТекОбъект = ТекЭлемент.Ссылка.ПолучитьОбъект();
					ТекОбъект.ПорядокВСхеме = ТекОбъект.ПорядокВСхеме+1;
					ТекОбъект.Записать();
				КонецЕсли;
			КонецЦикла;
		Иначе //обычное смещение
			СледСтрока = Подчиненные.Найти(ТекСтрока.НомерСтроки+1,"НомерСтроки" );
			
			ТекОбъект = ТекСтрока.Ссылка.ПолучитьОбъект();
			ТекОбъект.ПорядокВСхеме = СледСтрока.ПорядокВСхеме;
			ТекОбъект.Записать();
			СледОбъект = СледСтрока.Ссылка.ПолучитьОбъект();
			СледОбъект.ПорядокВСхеме = ТекСтрока.ПорядокВСхеме;
			СледОбъект.Записать();
		КонецЕсли;
		//ОбновитьОС(МассивНарисованныхЭлементов);
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция ПолучитьПодчиненные(ТекРодитель)
	Запрос = Новый Запрос;
	Запрос.Текст = "Выбрать 
					|	ОргСхема.Ссылка,
					|	ОргСхема.ПорядокВСхеме
					|Из Справочник.ОргСхема Как ОргСхема
					|Где ОргСхема.Родитель = &Родитель
					|	И ОргСхема.ПометкаУдаления = Ложь
					|Упорядочить ПО ОргСхема.ПорядокВСхеме";
	Запрос.УстановитьПараметр("Родитель",ТекРодитель);
	РезультатЗапроса = Запрос.Выполнить().Выбрать();
	Таб = Новый ТаблицаЗначений;
	НомерСтроки = 1;
	Таб.Колонки.Добавить("НомерСтроки");
	Таб.Колонки.Добавить("Ссылка");
    Таб.Колонки.Добавить("ПорядокВСхеме");
	Пока РезультатЗапроса.Следующий() Цикл
		Стр = Таб.Добавить();
		Стр.НомерСтроки = НомерСтроки;
    	Стр.Ссылка = РезультатЗапроса.Ссылка;
		Стр.ПорядокВСхеме = РезультатЗапроса.ПорядокВСхеме;
		НомерСтроки = НомерСтроки + 1;
	КонецЦикла;
	Возврат Таб;
КонецФункции


&НаКлиенте
Процедура ОргСхемаПриАктивизацииОбласти(Элемент)
	ТекОбласть = Элементы.ОргСхема.ТекущаяОбласть;
	ТекЭлем = ТекОбласть.Расшифровка;
	
	Если ТекЭлем = Неопределено Тогда
		Элементы.ОргСхемаКонтекстноеМенюВывестиОтдельно.Видимость = Ложь;
		Возврат;
	КонецЕсли;
	Элементы.ОргСхемаКонтекстноеМенюОткрытьОргсхемуСекции.Видимость = Ложь;
	
	ДанныеЭлемента = СсылкуВСтруктуру(ТекЭлем, "Ссылка, ТипТерминала,СсылкаНаВложеннуюОргсхему");
	
	Доступ = ПроверитьДоступ();
	
	Если ДанныеЭлемента.ТипТерминала = ПредопределенноеЗначение("Перечисление.ТипТерминалаОргСхемы.Учредитель") Тогда
		Элементы.ОргСхемаКонтекстноеМенюВывестиОтдельно.Видимость = Ложь;
	ИначеЕсли ДанныеЭлемента.ТипТерминала = ПредопределенноеЗначение("Перечисление.ТипТерминалаОргСхемы.РуководящийСостав") Тогда
		Элементы.ОргСхемаКонтекстноеМенюВывестиОтдельно.Видимость = Ложь;
	ИначеЕсли ДанныеЭлемента.ТипТерминала = ПредопределенноеЗначение("Перечисление.ТипТерминалаОргСхемы.Департамент") Тогда
		Элементы.ОргСхемаКонтекстноеМенюВывестиОтдельно.Видимость = Истина;			
	ИначеЕсли ДанныеЭлемента.ТипТерминала = ПредопределенноеЗначение("Перечисление.ТипТерминалаОргСхемы.Отдел") Тогда
		Элементы.ОргСхемаКонтекстноеМенюВывестиОтдельно.Видимость = Ложь;
	ИначеЕсли ДанныеЭлемента.ТипТерминала = ПредопределенноеЗначение("Перечисление.ТипТерминалаОргСхемы.Секция") ИЛИ ДанныеЭлемента.ТипТерминала = ПредопределенноеЗначение("Перечисление.ТипТерминалаОргСхемы.Сектор") Тогда
	
		Элементы.ОргСхемаКонтекстноеМенюВывестиОтдельно.Видимость = Ложь;	
		Если ДанныеЭлемента.ТипТерминала = ПредопределенноеЗначение("Перечисление.ТипТерминалаОргСхемы.Секция") И ЗначениеЗаполнено(ДанныеЭлемента.СсылкаНаВложеннуюОргсхему) Тогда
			Элементы.ОргСхемаКонтекстноеМенюОткрытьОргсхемуСекции.Видимость = истина;
		КонецЕсли;
	ИначеЕсли ДанныеЭлемента.ТипТерминала = ПредопределенноеЗначение("Перечисление.ТипТерминалаОргСхемы.Сотрудник") Тогда
		Элементы.ОргСхемаКонтекстноеМенюВывестиОтдельно.Видимость = Ложь;
	Иначе
		 Элементы.ОргСхемаКонтекстноеМенюВывестиОтдельно.Видимость = Ложь;
	КонецЕсли;
	 
	Элементы.ОргСхемаКонтекстноеМенюИзменить.Видимость = Доступ.ОргсхемаРедактирование;
	Элементы.ОргСхемаКонтекстноеМенюУдалить.Видимость = Доступ.ОргсхемаРедактирование;
	Элементы.ОргСхемаКонтекстноеМенюПланы.Видимость = Доступ.БоевыеПланы;
	Элементы.ОргСхемаКонтекстноеМенюПоказатьСтатистики.Видимость = Доступ.Статистики;
	Элементы.ОргСхемаКонтекстноеМенюДолжностныеИнструкции.Видимость = Доступ.ДолжностныеИнструкции;
	Элементы.ОргСхемаКонтекстноеМенюДобавитьПодчиненного.Видимость = Доступ.ОргсхемаРедактирование;
	Элементы.ОргСхемаКонтекстноеМенюГруппа1.Видимость = Доступ.ЗадачиПланаДействийПросмотр;
	Элементы.ОргСхемаКонтекстноеМенюПоставитьЗадачу.Видимость = Доступ.ЗадачиПланаДействийРедактирование;
	Элементы.ОргСхемаКонтекстноеМенюОтправитьЗРС.Видимость = Доступ.ЗадачиПланаДействийРедактирование;
	Элементы.ОргСхемаКонтекстноеМенюОтправитьПослание.Видимость = Доступ.ЗадачиПланаДействийРедактирование;
	
 
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПроверитьДоступ()
	Структура = Новый Структура;
	Структура.Вставить("ОргсхемаРедактирование",			ПравоДоступаНаОбъект("Редактирование", 	"Справочник.Оргсхема"));
	Структура.Вставить("ДолжностныеИнструкции",				ПравоДоступаНаОбъект("Просмотр", 		"Справочник.ИА_Инструкции"));
	Структура.Вставить("БоевыеПланы",						ПравоДоступаНаОбъект("Просмотр", 		"Справочник.ИА_ПланыДействий"));
	Структура.Вставить("Статистики",						ПравоДоступаНаОбъект("Просмотр", 		"Документ.ИА_Статистика"));
	Структура.Вставить("ЗадачиПланаДействийПросмотр",		ПравоДоступаНаОбъект("Просмотр", 		"Задача.ИА_ЗадачаПланаДействий"));
	Структура.Вставить("ЗадачиПланаДействийРедактирование",	ПравоДоступаНаОбъект("Редактирование",	"Задача.ИА_ЗадачаПланаДействий")); 
	 
	Возврат Структура;	
КонецФункции

