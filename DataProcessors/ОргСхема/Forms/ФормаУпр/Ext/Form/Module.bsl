&НаСервереБезКонтекста
Функция ТекПользователь()
	Возврат ПараметрыСеанса.ТекущийПользователь;
КонецФункции

&НаКлиенте
Процедура Планы(Команда)
	ТекОбласть = Элементы.ОргСхема.ТекущаяОбласть;
	ТекЭлем = ТекОбласть.Расшифровка;
	Если ТекЭлем = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТекЭлем) и ТипЗнч(ТекЭлем) = Тип("СправочникСсылка.ОргСхема") Тогда		
		Парам = Новый Структура("ОтборПост", ТекЭлем);
		фПланы = ПолучитьФорму("Обработка.ИА_КСУ_РабочийСтол.Форма.ПланыСотрудников",Парам);
		фПланы.Открыть();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПоказатьСтатистики(Команда)
	ТекОбласть = Элементы.ОргСхема.ТекущаяОбласть;
	ТекЭлем = ТекОбласть.Расшифровка;
	Если ТекЭлем = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	
	ДанныеЭлемента = СсылкуВСтруктуру(ТекЭлем, "НастройкаСтатистик");
	
	Если ЗначениеЗаполнено(ТекЭлем) и ТипЗнч(ТекЭлем) = Тип("СправочникСсылка.ОргСхема") Тогда
		Если ДанныеЭлемента.НастройкаСтатистик.Пустая() Тогда
			ПоказатьПредупреждение(,"Укажите настройку статистик для поста!");
			Возврат;
		КонецЕсли;
		
		
		ф = ПолучитьФорму("Обработка.ИА_РабочийСтолСтатистик_Упр_HTML.Форма.Форма");
		ф.Открыть();
		ф.Объект.Настройка = ДанныеЭлемента.НастройкаСтатистик;
		ф.НастройкаПриИзменении(Неопределено);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПоместитьВАрхив(Команда)
	НаимЗаписи = Строка(Объект.Организация);
	ПоказатьВводЗначения(Новый ОписаниеОповещения("ПоместитьВАрхивЗавершение", ЭтотОбъект, Новый Структура("НаимЗаписи", НаимЗаписи)), НаимЗаписи, "Наименование макета оргсхемы");
КонецПроцедуры

&НаКлиенте
Процедура ПоместитьВАрхивЗавершение(Значение, ДополнительныеПараметры) Экспорт
	
	НаимЗаписи = ?(Значение = Неопределено, ДополнительныеПараметры.НаимЗаписи, Значение);
	
	
	Если (Значение <> Неопределено) и СокрЛП(НаимЗаписи)<>"" Тогда
		ОбновитьОС(МассивНарисованныхЭлементов);
		ПоместитьВАрхивНаСервере(НаимЗаписи);	
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ПоместитьВАрхивНаСервере(ИмяМакета)
	МенЗаписи = РегистрыСведений.АрхивОргсхем.СоздатьМенеджерЗаписи();
	МенЗаписи.Период = ТекущаяДата();
	МенЗаписи.Наименование = ИмяМакета;
	МенЗаписи.Макет = Новый ХранилищеЗначения(ОргСхема.ПолучитьОбласть());
	МенЗаписи.Записать();
КонецПроцедуры

&НаКлиенте
Процедура Удалить(Команда)
	ТекОбласть = Элементы.ОргСхема.ТекущаяОбласть;
	ТекЭлем = ТекОбласть.Расшифровка;

	Если ТекЭлем = Неопределено Тогда
		Возврат;
	КонецЕсли;
		
	ПоказатьВопрос(Новый ОписаниеОповещения("УдалитьЗавершение", ЭтотОбъект, Новый Структура("ТекЭлем", ТекЭлем)), "Удалить терминал """ + СокрЛП(Строка(ТекЭлем)) + """?", РежимДиалогаВопрос.ДаНет);
КонецПроцедуры

&НаКлиенте
Процедура УдалитьЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	ТекЭлем = ДополнительныеПараметры.ТекЭлем;
	
	
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда	
		
		УстановитьПометкуУдаления(ТекЭлем);
		ОбновитьОС(МассивНарисованныхЭлементов);
		
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура УстановитьПометкуУдаления(ТекЭлем)
	
	ТекОб = ТекЭлем.ПолучитьОбъект();
	ТекОб.УстановитьПометкуУдаления(Истина,Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	Элементы.ГруппаСписокПроблем.Видимость = Ложь;
	
	Если не ИА_Защита_Общий.ЛицензияДоступна("Оргсхема") Тогда
		Отказ = Истина;
		возврат;
	КонецЕсли;
	
	#Если ВебКлиент Тогда
		ПодключитьРасширениеРаботыСФайлами();
	#КонецЕсли
	
	Если не Объект.Организация.Пустая() Тогда
		Попытка
			ОбновитьОС(МассивНарисованныхЭлементов);
		Исключение
			Сообщить(ОписаниеОшибки());
		КонецПопытки;
	КонецЕсли;
    ОбновлятьПриРедактировании	= Истина;
	ПредИдЭлем = -1;
	ПредИдЭлем1 = -1;
КонецПроцедуры


&НаКлиенте
Процедура СохранитьКакPDF(Команда)
	
	#ЕСЛИ ВебКлиент Тогда
	    Оповещение = Новый ОписаниеОповещения("НачатьПодключениеРасширенияРаботыСФайламиЗавершение", ЭтаФорма, новый Структура("формат", "PDF"));
	    НачатьПодключениеРасширенияРаботыСФайлами(Оповещение);
	#ИНАЧЕ
	ТабДок = ПолучитьТабличныйДокументНаСервере(Истина);
	Режим = РежимДиалогаВыбораФайла.Сохранение;
	ДиалогОткрытияФайла = Новый ДиалогВыбораФайла(Режим);
	ДиалогОткрытияФайла.ПолноеИмяФайла = "";
	Фильтр = НСтр("az='PDF';be='PDF';en='PDF';kk='PDF';ky='PDF';md='PDF';ru='PDF';tg='PDF';tk='PDF';uk='PDF';uz='PDF'")
	    + "(*.pdf)|*.pdf";
	ДиалогОткрытияФайла.Фильтр = Фильтр;
	ДиалогОткрытияФайла.МножественныйВыбор = Ложь;
	ДиалогОткрытияФайла.Заголовок = "Выберите файл";
	
	Если ДиалогОткрытияФайла.Выбрать() Тогда
	    ТабДок.Записать(ДиалогОткрытияФайла.ПолноеИмяФайла, ТипФайлаТабличногоДокумента.PDF);
	КонецЕсли; 
	#КОНЕЦЕСЛИ
	
КонецПроцедуры

&НаКлиенте
Процедура НачатьПодключениеРасширенияРаботыСФайламиЗавершение(Подключено, ДополнительныеПараметры) Экспорт
    Если Не Подключено Тогда
        Оповещение = Новый ОписаниеОповещения("НачатьУстановкуРасширенияРаботыСФайламиЗавершение", ЭтаФорма, ДополнительныеПараметры);
        ТекстСообщения = НСтр("ru='Для продолжении работы необходимо установить расширение для веб-клиента ""1С:Предприятие"". Установить?'");
        ПоказатьВопрос(Оповещение, ТекстСообщения, РежимДиалогаВопрос.ДаНет); 
	Иначе
		Если ДополнительныеПараметры.формат = "PDF" Тогда
			дд = ПолучитьТабличныйДокументНаСервере(Истина, истина);
			адрес = ПоместитьВоВременноеХранилище(дд);
			ПолучитьФайл(адрес,"org.pdf", истина);
		ИначеЕсли ДополнительныеПараметры.формат = "XLS" Тогда
			дд = ПолучитьXLSНаСервере();
			адрес = ПоместитьВоВременноеХранилище(дд);
			ПолучитьФайл(адрес,"org.xls", истина);
		КонецЕсли;

    КонецЕсли;   
КонецПроцедуры

