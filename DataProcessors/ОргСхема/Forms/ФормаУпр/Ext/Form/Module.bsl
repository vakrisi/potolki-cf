&НаКлиенте
Процедура ПереместитьВлево(Команда)
	ТекОбласть = Элементы.ОргСхема.ТекущаяОбласть;
	ТекЭлем = ТекОбласть.Расшифровка;
	
	Если ТекЭлем = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ПереместитьВлевоНаСервере(ТекЭлем);
	ОбновитьОС(МассивНарисованныхЭлементов);
КонецПроцедуры

&НаСервере
Процедура ПереместитьВлевоНаСервере(ТекЭлем)
ТекРодитель = ТекЭлем.Родитель;
	
	Если ЗначениеЗаполнено(ТекРодитель) и ТипЗнч(ТекРодитель) = Тип("СправочникСсылка.ОргСхема") Тогда
		Подчиненные = ПолучитьПодчиненные(ТекРодитель); 
		ТекСтрока = Подчиненные.Найти(ТекЭлем,"Ссылка" );
		Если ТекСтрока.НомерСтроки = 1 Тогда
			//СледСтрока = Подчиненные.Найти(Подчиненные.Количество(),"НомерСтроки" );
			Для каждого ТекЭлемент Из Подчиненные Цикл
				Если ТекЭлемент = ТекСтрока Тогда
					ТекОбъект = ТекЭлемент.Ссылка.ПолучитьОбъект();
					ТекОбъект.ПорядокВСхеме = Подчиненные.Найти(Подчиненные.Количество(),"НомерСтроки" ).ПорядокВСхеме;
					ТекОбъект.Записать();
				Иначе
					ТекОбъект = ТекЭлемент.Ссылка.ПолучитьОбъект();
					ТекОбъект.ПорядокВСхеме = ТекОбъект.ПорядокВСхеме-1;
					ТекОбъект.Записать();
				КонецЕсли;
			КонецЦикла;

		Иначе
			СледСтрока = Подчиненные.Найти(ТекСтрока.НомерСтроки-1,"НомерСтроки" );
			ТекОбъект = ТекСтрока.Ссылка.ПолучитьОбъект();
			ТекОбъект.ПорядокВСхеме = СледСтрока.ПорядокВСхеме;
			ТекОбъект.Записать();
			СледОбъект = СледСтрока.Ссылка.ПолучитьОбъект();
			СледОбъект.ПорядокВСхеме = ТекСтрока.ПорядокВСхеме;
			СледОбъект.Записать();
		КонецЕсли;
		
		
		
	КонецЕсли;
КонецПроцедуры


&НаКлиенте
Процедура ВывестиОтдельно(Команда)
	
	ТекОбласть = Элементы.ОргСхема.ТекущаяОбласть;
	//ОбновитьОС(МассивНарисованныхЭлементов); 
	ТекЭлем = ТекОбласть.Расшифровка;
	Лево = 0;
	Верх = 0;
	Ширина = 0;
	
	Если ЭтоБлокДепартамента(ТекЭлем) Тогда
		Для каждого Элем из МассивНарисованныхЭлементов Цикл
			Если ТекЭлем = Элем.Ссылка Тогда
				Лево = Элем.Лево;
				Верх = Элем.Верх;
				Ширина = Элем.Ширина;
				Прервать;
			КонецЕсли;      		
		КонецЦикла;	
		 		
		Форма = ПолучитьФорму("Обработка.ОргСхема.Форма.ФормаВыводаБлокаУпр");
		
		Если Форма.Открыта() Тогда 
			Форма.Закрыть();
			Форма = ПолучитьФорму("Обработка.ОргСхема.Форма.ФормаВыводаБлокаУпр");
		КонецЕсли;	   
		
		Форма.ВладелецФормы = ЭтаФорма;
		Структура = Новый ФиксированнаяСтруктура("Организация, Департамент, Лево, Верх, Ширина",
												Объект.Организация, ТекЭлем, Лево, Верх, Ширина);	
		Форма.ФиксСтруктура = Структура;
		Форма.Открыть(); 
	КонецЕсли;
	
КонецПроцедуры

