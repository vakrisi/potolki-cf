&НаСервере
Процедура ПолучитьПерекрестноеПодчинение(Организация)
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Организация", Организация);
	
	Запрос.Текст = "ВЫБРАТЬ 
	               |	ОргСхемаСотрудники.Ссылка КАК Пост,
	               |	ОргСхемаСотрудники.ФизЛицо КАК ФизЛицо
	               |ИЗ
	               |	Справочник.ОргСхема.Сотрудники КАК ОргСхемаСотрудники
	               |ГДЕ
	               |	ОргСхемаСотрудники.Ссылка В ИЕРАРХИИ(&Организация)
	               |	И НЕ ОргСхемаСотрудники.Ссылка.ПометкаУдаления
	               |	И ОргСхемаСотрудники.НомерСтроки = 1";
	тзОргсх = Запрос.Выполнить().Выгрузить();
	ПараметрыСтроки = Новый КвалификаторыСтроки(150);
	тзОргсх.Колонки.Добавить("ПолныйКод", Новый ОписаниеТипов("Строка",,ПараметрыСтроки));
	
	Для каждого стр из тзОргсх Цикл
		стр.ПолныйКод = стр.Пост.ПолныйКод();
	КонецЦикла;
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	тз.Пост,
	               |	тз.ПолныйКод,
	               |	тз.ФизЛицо
	               |ПОМЕСТИТЬ ОргСхема
	               |ИЗ
	               |	&ТЗ КАК тз
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ОргСхема.Пост КАК Пост1,
	               |	ОргСхема.ФизЛицо КАК Сотрудник,
	               |	ЭтотНиже.Пост КАК Пост2,
	               |	ДругойНижеЭтого.Пост КАК ПостСередина,
	               |	ДругойНижеЭтого.ФизЛицо КАК СотрудникСередина
	               |ИЗ
	               |	ОргСхема КАК ОргСхема
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ОргСхема КАК ДругойНижеЭтого
	               |		ПО (ДругойНижеЭтого.ФизЛицо <> ОргСхема.ФизЛицо)
	               |			И (ДругойНижеЭтого.ПолныйКод ПОДОБНО ОргСхема.ПолныйКод + ""/%"")
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ОргСхема КАК ЭтотНиже
	               |		ПО (ЭтотНиже.ФизЛицо = ОргСхема.ФизЛицо)
	               |			И (ЭтотНиже.ПолныйКод ПОДОБНО ДругойНижеЭтого.ПолныйКод + ""/%"")";
				   
	Запрос.УстановитьПараметр("тз", тзОргсх);			   
	тз = Запрос.Выполнить().Выгрузить();
	ЗначениеВРеквизитФормы(тз,"ПроблемыПерекрест");	
КонецПроцедуры


&НаСервере
Процедура ПолучитьДвойноеПодчинение(Организация)
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Организация", Организация);
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	ОргСхема.Ссылка КАК Пост,
	               |	ОргСхема.Родитель КАК ПостРуководитель
	               |ИЗ
	               |	Справочник.ОргСхема КАК ОргСхема
	               |ГДЕ
	               |	ОргСхема.Ссылка В ИЕРАРХИИ(&Организация)
	               |	И НЕ ОргСхема.ПометкаУдаления";
	тзПодчинение = Запрос.Выполнить().Выгрузить();
	
	Для каждого стр из тзПодчинение Цикл
		пока стр.ПостРуководитель.Сотрудники.Количество() = 0 и ЗначениеЗаполнено(стр.ПостРуководитель.Родитель) Цикл
			стр.ПостРуководитель = стр.ПостРуководитель.Родитель;
		КонецЦикла;
	КонецЦикла;

	
	Запрос.Текст = "ВЫБРАТЬ
	               |	ТЗ.Пост,
	               |	ТЗ.ПостРуководитель
	               |ПОМЕСТИТЬ НепосрРукли
	               |ИЗ
	               |	&ТЗ КАК ТЗ
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ОргСхемаСотрудники.ФизЛицо КАК Руководитель,
	               |	ОргСхемаСотрудники.Ссылка КАК Ссылка
	               |ПОМЕСТИТЬ ПервыеСотрудники
	               |ИЗ
	               |	Справочник.ОргСхема.Сотрудники КАК ОргСхемаСотрудники
	               |ГДЕ
	               |	ОргСхемаСотрудники.Ссылка В ИЕРАРХИИ(&Организация)
	               |	И НЕ ОргСхемаСотрудники.Ссылка.ПометкаУдаления
	               |	И ОргСхемаСотрудники.НомерСтроки = 1
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ОргСхемаСотрудники.ФизЛицо КАК ФизЛицо,
	               |	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ПервыеСотрудники.Руководитель) КАК КолРуководителей
	               |ПОМЕСТИТЬ ПроблемныеСотрудники
	               |ИЗ
	               |	НепосрРукли КАК НепосрРукли
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ОргСхема.Сотрудники КАК ОргСхемаСотрудники
	               |		ПО НепосрРукли.Пост = ОргСхемаСотрудники.Ссылка
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПервыеСотрудники КАК ПервыеСотрудники
	               |		ПО НепосрРукли.ПостРуководитель = ПервыеСотрудники.Ссылка
	               |			И (ОргСхемаСотрудники.ФизЛицо <> ПервыеСотрудники.Руководитель)
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ОргСхемаСотрудники.ФизЛицо
	               |
	               |ИМЕЮЩИЕ
	               |	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ПервыеСотрудники.Руководитель) > 1
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ОргСхемаСотрудники.Ссылка КАК Пост,
	               |	Проблемы.ФизЛицо КАК Сотрудник,
	               |	НепосрРукли.ПостРуководитель,
	               |	ПервыеСотрудники.Руководитель КАК Руководитель
	               |ИЗ
	               |	Справочник.ОргСхема.Сотрудники КАК ОргСхемаСотрудники
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПроблемныеСотрудники КАК Проблемы
	               |		ПО ОргСхемаСотрудники.ФизЛицо = Проблемы.ФизЛицо
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ НепосрРукли КАК НепосрРукли
	               |		ПО (НепосрРукли.Пост = ОргСхемаСотрудники.Ссылка)
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПервыеСотрудники КАК ПервыеСотрудники
	               |		ПО (НепосрРукли.ПостРуководитель = ПервыеСотрудники.Ссылка)
	               |			И (Проблемы.ФизЛицо <> ПервыеСотрудники.Руководитель)
	               |ГДЕ
	               |	ОргСхемаСотрудники.Ссылка В ИЕРАРХИИ(&Организация)
	               |	И НЕ ОргСхемаСотрудники.Ссылка.ПометкаУдаления
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Сотрудник";
	
	Запрос.УстановитьПараметр("ТЗ", тзПодчинение);
	тз = Запрос.Выполнить().Выгрузить();
	ЗначениеВРеквизитФормы(тз,"Проблемы");
КонецПроцедуры

&НаСервере
Процедура СнятьВыделение()
	Если ПредВыделение <> Неопределено ТОгда
		Для каждого рис из ПредВыделение Цикл
			рис.Узор = ТипУзораТабличногоДокумента.Сплошной;;
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры
	
&НаКлиенте
Процедура ПроблемыПриАктивизацииСтроки(Элемент)
	тд = Элементы.Проблемы.ТекущиеДанные;
	Если тд = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	текИд = тд.ПолучитьИдентификатор();
	Если текИд = ПредИдЭлем Тогда
		Возврат;
	КонецЕсли;
	ПредИдЭлем = текИд;
	
	
	
	МассивПостов = Новый Массив;
	Для каждого стрИД из Элементы.Проблемы.ВыделенныеСтроки Цикл
		МассивПостов.Добавить(Проблемы.НайтиПоИдентификатору(стрИД).Пост);
	КонецЦикла;
	
	лево = ПроблемыПриАктивизацииСтрокиНаСервер(МассивПостов);
	
	Если лево> 0 Тогда
		Итер = 0;
		ПодключитьОбработчикОжидания("Спозиционировать", 0.1, истина);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ПроблемыПриАктивизацииСтрокиНаСервер(МассивПостов)
	
	СнятьВыделение();	
	Первый = истина;
	ПредВыделение = Новый Массив;
	Лево = 0;
	Верх = 0;
	Для каждого рис из ОргСхема.Рисунки Цикл
		Если рис.ТипРисунка = ТипРисункаТабличногоДокумента.Текст И МассивПостов.Найти(рис.Расшифровка)<>Неопределено и рис.Текст<>"" Тогда
			
			ПредВыделение.Добавить(рис);
			
			рис.Узор = ТипУзораТабличногоДокумента.Узор15;
			рис.ЦветУзора = Новый Цвет(250,50,50);
			
			Если Первый Тогда
				Лево = рис.Лево;
				Верх = рис.Верх;
				Первый = ложь;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Лево;
КонецФункции

&НаКлиенте
Процедура Спозиционировать() Экспорт
	Колонка = Макс(Окр(Лево / 16.3,  0),1);
	Строка  = Макс(Окр(Верх /  3.8, 0), 1);
	Если итер = 0 Тогда // пляшем влево
		Колонка1 = Макс(Колонка - 8,1);
		Строка1  = Макс(Строка - 15, 1);
		СпозиционироватьНаКолонкеСтроке(Колонка1, Строка1);
	ИначеЕсли итер = 1 Тогда // пляшем вправо
		Колонка1 = Колонка + 8;
		Строка1  = Строка + 15;
		СпозиционироватьНаКолонкеСтроке(Колонка1, Строка1);
	ИначеЕсли итер = 2 Тогда // топаем ногой
		СпозиционироватьНаКолонкеСтроке(Колонка, Строка);
	КонецЕсли;

	Итер = Итер + 1;
	
	Если итер < 3 Тогда
		ПодключитьОбработчикОжидания("Спозиционировать", 0.1, истина);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура СпозиционироватьНаКолонкеСтроке(Колонка, Строка)
	Колонка = Формат(Колонка, "ЧДЦ=; ЧГ=");
	Строка  = Формат(Строка, "ЧДЦ=; ЧГ=");
	Обл = ОргСхема.Область("R" + Строка + "C" + Колонка);
	Элементы.ОргСхема.ТекущаяОбласть = Обл;
КонецПроцедуры

&НаКлиенте
Процедура УбратьСписокПроблем(Команда)
	СнятьВыделение();
	Элементы.ГруппаСписокПроблем.Видимость = Ложь;
КонецПроцедуры

&НаКлиенте
Процедура ПроблемыПерекрестПриАктивизацииСтроки(Элемент)
	тд = Элементы.ПроблемыПерекрест.ТекущиеДанные;
	Если тд = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	текИд = тд.ПолучитьИдентификатор();
	Если текИд = ПредИдЭлем1 Тогда
		Возврат;
	КонецЕсли;
	ПредИдЭлем1 = текИд;
	
	МассивПостов = Новый Массив;
	Для каждого стрИД из Элементы.ПроблемыПерекрест.ВыделенныеСтроки Цикл
		ТекСтр = ПроблемыПерекрест.НайтиПоИдентификатору(стрИД);
		МассивПостов.Добавить(ТекСтр.Пост1);
		МассивПостов.Добавить(ТекСтр.Пост2);
		МассивПостов.Добавить(ТекСтр.ПостСередина);
	КонецЦикла;
	
	Лево = ПроблемыПерекрестПриАктивизацииСтрокиНаСервере(МассивПостов);
	
	Если лево> 0 Тогда
		Итер = 0;
		ПодключитьОбработчикОжидания("Спозиционировать", 0.1, истина);
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция ПроблемыПерекрестПриАктивизацииСтрокиНаСервере(МассивПостов)	
	СнятьВыделение();
	Первый = истина;
	ПредВыделение = Новый Массив;
	Лево = 0;
	Верх = 0;
	Для каждого рис из ОргСхема.Рисунки Цикл
		Если рис.ТипРисунка = ТипРисункаТабличногоДокумента.Текст И МассивПостов.Найти(рис.Расшифровка)<>Неопределено и рис.Текст<>"" Тогда
			
			ПредВыделение.Добавить(рис);
			
			рис.Узор = ТипУзораТабличногоДокумента.Узор15;
			рис.ЦветУзора = Новый Цвет(250,50,50);
			
			Если Первый Тогда
				Лево = рис.Лево;
				Верх = рис.Верх;
				Первый = ложь;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	ВОзврат Лево;
КонецФункции

