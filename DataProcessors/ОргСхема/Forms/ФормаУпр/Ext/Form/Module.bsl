&НаСервере
Функция ПолучитьТабличныйДокументНаСервере(АвтоМасштаб, этоВеб = ложь)
	
	ТабДок = Новый ТабличныйДокумент;
	ТабДок.Вывести(ОргСхема);
	ТабДок.АвтоМасштаб = АвтоМасштаб;
	
	Если Не АвтоМасштаб Тогда
		ТабДок.МасштабПечати = 100;
	КонецЕсли;
	
	ТабДок.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	
	Если этоВеб Тогда
		вр = КаталогВременныхФайлов() + "org1111.pdf";
		ТабДок.Записать(вр, ТипФайлаТабличногоДокумента.PDF);
		
		дд = новый ДвоичныеДанные(вр);
		УдалитьФайлы(вр);
		Возврат дд;
	Иначе
		Возврат ТабДок;
	КонецЕсли;
	
КонецФункции

&НаСервере
Функция ПолучитьXLSНаСервере()
	
	вр = КаталогВременныхФайлов() + "org1111.xls";
	ОргСхема.Записать(вр, ТипФайлаТабличногоДокумента.XLS);
	
	дд = новый ДвоичныеДанные(вр);
	УдалитьФайлы(вр);
	Возврат дд;
	
КонецФункции


&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
    Если ИмяСобытия = "ИзменениеОС" И ОбновлятьПриРедактировании Тогда
		ОбновитьОС(МассивНарисованныхЭлементов);
	ИначеЕсли ИмяСобытия = "ЗакрытиеЗадачиБП" и Параметр<>Неопределено И Параметр.ВладелецФормы = ЭтаФорма Тогда
		Если (не Параметр.Ссылка.Пустая()) и Параметр.ПоКомлиниям Тогда
			ОбозначитьПутьНаСхеме(Параметр.Пост, Параметр.Ссылка, МассивНарисованныхЭлементов);
		КонецЕсли;		
	КонецЕсли;
КонецПроцедуры

