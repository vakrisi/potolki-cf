&НаКлиенте
Перем МассивНарисованныхЭлементов, Лево, Верх, Итер;
&НаСервере
Перем ПредВыделение;

&НаКлиенте
Процедура ПолучитьИзАрхива(Команда)
	
	ОткрытьФорму("Обработка.ОргСхема.Форма.ФормаПолученияИзАрхиваУпр",,,,,, Новый ОписаниеОповещения("ПолучитьИзАрхиваЗавершение", ЭтотОбъект), РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);
	
КонецПроцедуры

&НаКлиенте
Процедура ПолучитьИзАрхиваЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	рез = Результат;
	
	Если рез<>Неопределено Тогда
		ПолучитьИзАрхиваНаСервере(рез);
		ЗагруженаИзАрхива = Истина;
		Элементы.ОргСхемаКонтекстноеМенюГруппа.Доступность = Не ЗагруженаИзАрхива;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ПолучитьИзАрхиваНаСервере(Макет)
	ОргСхема.Очистить();
	ОргСхема.Вывести(Макет);
	ОргСхема.ТолькоПросмотр = Истина;
КонецПроцедуры

&НаКлиенте
Процедура Обновить(Команда)
	
	Элементы.ГруппаСписокПроблем.Видимость = ложь;
	
	Если Объект.Организация.Пустая() Тогда
		ПоказатьПредупреждение(,"Выберите организацию!");
		Возврат;
	КонецЕсли;
	
	ОбновитьОС(МассивНарисованныхЭлементов);

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьОС(МассивНарисованныхЭлементов)
	
	Рисунок = Элементы.ОргСхема.ТекущаяОбласть;
	Если ТипЗнч(Рисунок) = Тип("РисунокТабличногоДокумента") Тогда
		Попытка
			Лево = Рисунок.Лево + Рисунок.Ширина / 2;
			Верх = Рисунок.Верх + Рисунок.Высота / 2;
		Исключение
			Лево = 0;
        	Верх = 0;
		КонецПопытки;
    Иначе
        Лево = 0;
        Верх = 0;
    КонецЕсли;  
    
    ОргСхема1 = Новый ТабличныйДокумент;
    ИА_ОргСхема_Клиент.ПостроитьОС(Объект.Организация, ОргСхема1, МассивНарисованныхЭлементов);
	
	//ВывестиТабДок(ОргСхема1);
	ОргСхема = ОргСхема1;
	
    Элементы.ОргСхема.ТолькоПросмотр = Истина;
    ЗагруженаИзАрхива = Ложь;
    Элементы.ОргСхемаКонтекстноеМенюГруппа.Доступность = Не ЗагруженаИзАрхива;
    
	Если Лево > 0 И Верх > 0 Тогда
		Итер = 0;
	    ПодключитьОбработчикОжидания("Спозиционировать", 0.1, истина);
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ВывестиТабДок(ОргСхема1)
	ОргСхема.Очистить();
	ОргСхема.Вывести(ОргСхема1);
КонецПроцедуры

&НаКлиенте
Процедура ОрганизацияПриИзменении(Элемент)
	
	Если Объект.Организация.Пустая() Тогда
		ОргСхема = Новый ТабличныйДокумент;
		Элементы.ОргСхема.ТолькоПросмотр = Истина;
		ЗагруженаИзАрхива = Ложь;
		Элементы.ОргСхемаКонтекстноеМенюГруппа.Доступность = Ложь;
	Иначе
		ОбновитьОС(МассивНарисованныхЭлементов);
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция СсылкуВСтруктуру(Ссылка, Поля = "")
	
	Д = Новый Структура(Поля);
	ЗаполнитьЗначенияСвойств(Д, Ссылка.ПолучитьОбъект());
	Возврат Д;
	
КонецФункции

&НаКлиенте
Процедура ДобавитьПодчиненного(Команда)
	ТекОбласть = Элементы.ОргСхема.ТекущаяОбласть;
	ТекЭлем = ТекОбласть.Расшифровка;
	
	Если ТекЭлем = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ДанныеЭлемента = СсылкуВСтруктуру(ТекЭлем, "Ссылка, ТипТерминала");
	
	Если ЗначениеЗаполнено(ТекЭлем) и ТипЗнч(ТекЭлем) = Тип("СправочникСсылка.ОргСхема") Тогда
		Если ДанныеЭлемента.ТипТерминала = ПредопределенноеЗначение("Перечисление.ТипТерминалаОргСхемы.Сотрудник") Тогда
			возврат;
		КонецЕсли;
		
		Если ДанныеЭлемента.ТипТерминала = ПредопределенноеЗначение("Перечисление.ТипТерминалаОргСхемы.Учредитель") Тогда
			ТипТерминала1 = ПредопределенноеЗначение("Перечисление.ТипТерминалаОргСхемы.РуководящийСостав");
		ИначеЕсли ДанныеЭлемента.ТипТерминала = ПредопределенноеЗначение("Перечисление.ТипТерминалаОргСхемы.РуководящийСостав") Тогда
			ТипТерминала1 = ПредопределенноеЗначение("Перечисление.ТипТерминалаОргСхемы.Департамент");
		ИначеЕсли ДанныеЭлемента.ТипТерминала = ПредопределенноеЗначение("Перечисление.ТипТерминалаОргСхемы.Департамент") Тогда
			ТипТерминала1 = ПредопределенноеЗначение("Перечисление.ТипТерминалаОргСхемы.Отдел");
		ИначеЕсли ДанныеЭлемента.ТипТерминала = ПредопределенноеЗначение("Перечисление.ТипТерминалаОргСхемы.Отдел") Тогда
			ТипТерминала1 = ПредопределенноеЗначение("Перечисление.ТипТерминалаОргСхемы.Секция");
		ИначеЕсли ДанныеЭлемента.ТипТерминала = ПредопределенноеЗначение("Перечисление.ТипТерминалаОргСхемы.Секция") Тогда
			ТипТерминала1 = ПредопределенноеЗначение("Перечисление.ТипТерминалаОргСхемы.Сектор");			
		ИначеЕсли ДанныеЭлемента.ТипТерминала = ПредопределенноеЗначение("Перечисление.ТипТерминалаОргСхемы.Сектор") Тогда
			ТипТерминала1 = ПредопределенноеЗначение("Перечисление.ТипТерминалаОргСхемы.Сотрудник");			
		КонецЕсли;
		
		ЭтоГруппа = ТипТерминала1 <> ПредопределенноеЗначение("Перечисление.ТипТерминалаОргСхемы.Сотрудник");
		Парам = Новый Структура("Родитель,ТипТерминала,ЭтоГруппа", ТекЭлем,ТипТерминала1,ЭтоГруппа);
		
		ОткрытьФорму("Справочник.ОргСхема.ФормаГруппы", парам,ЭтаФорма,,,,Новый ОписаниеОповещения("ОбновитьОСОбр",ЭтаФорма),РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
	КонецЕсли;
КонецПроцедуры


&НаКлиенте
Процедура ОбновитьОСОбр(рез,дп) Экспорт
	ОбновитьОС(МассивНарисованныхЭлементов);
КонецПроцедуры


&НаКлиенте
Процедура ДолжностныеИнструкции(Команда)
	ТекОбласть = Элементы.ОргСхема.ТекущаяОбласть;
	ТекЭлем = ТекОбласть.Расшифровка;
	Если ЗначениеЗаполнено(ТекЭлем) и ТипЗнч(ТекЭлем) = Тип("СправочникСсылка.ОргСхема") Тогда	
		ф = ПолучитьФорму("Обработка.ИА_РаботаСИнструкциями.Форма.ФормаУправляемая");
		ф.Пост = ТекЭлем;
		ф.Открыть();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОтправитьЗРС(Команда)
	ТекОбласть = Элементы.ОргСхема.ТекущаяОбласть;
	ТекЭлем = ТекОбласть.Расшифровка;
	Если ТекЭлем = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТекЭлем) и ТипЗнч(ТекЭлем) = Тип("СправочникСсылка.ОргСхема") Тогда
		
		Парам = Новый Структура("ЭтоЗРС,Пост", Истина,ТекЭлем);
		ОткрытьФорму("Задача.ИА_ЗадачаПланаДействий.ФормаОбъекта",Парам,ЭтаФорма);
		
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОбозначитьПутьНаСхеме(ПостКому, ЗадачаСсылка, МассивНарисованныхЭлементов)
	массивПостов = ПолучитьСписокПостовМаршрута(ЗадачаСсылка);
	
	Для каждого стр из МассивНарисованныхЭлементов Цикл
		Если массивПостов.Найти(стр.Ссылка)<>Неопределено Тогда
			Элем = ОргСхема.Рисунки[стр.Элемент];
			
			Обводка = ОргСхема.Рисунки.Добавить(ТипРисункаТабличногоДокумента.Прямоугольник);
			ЗаполнитьЗначенияСвойств(Обводка, Элем);
			Обводка.Узор = ТипУзораТабличногоДокумента.БезУзора;
			
			Обводка.Линия = новый Линия(ТипЛинииРисункаТабличногоДокумента.Сплошная,3);
			Обводка.ЦветЛинии = Новый Цвет(255,50,50);
		КонецЕсли;
	КонецЦикла;
		
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьСписокПостовМаршрута(пЗадача)
	возврат пЗадача.Маршрут.ВыгрузитьКолонку("Пост");
КонецФункции

&НаСервереБезКонтекста
Функция МассивПользовтелейПоПосту(Пост)
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ИА_АдресацияЗадачПланаДействий.Пользователь
	|ИЗ
	|	РегистрСведений.ИА_АдресацияЗадачПланаДействий КАК ИА_АдресацияЗадачПланаДействий
	|ГДЕ
	|	ИА_АдресацияЗадачПланаДействий.Пост = &Пост";
	Запрос.УстановитьПараметр("Пост", Пост);
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Пользователь");
КонецФункции

&НаКлиенте
Процедура ОтправитьПослание(Команда)
	ТекОбласть = Элементы.ОргСхема.ТекущаяОбласть;
	ТекЭлем = ТекОбласть.Расшифровка;
	Если ТекЭлем = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТекЭлем) и ТипЗнч(ТекЭлем) = Тип("СправочникСсылка.ОргСхема") Тогда
		
		масПользователей = МассивПользовтелейПоПосту(ТекЭлем);
		
		Парам = Новый Структура("ЭтоПослание", Истина);
		ФПослание = ПолучитьФорму("Задача.ИА_ЗадачаПланаДействий.ФормаОбъекта", Парам);
		обПослание = ФПослание.Объект;
		
		//обПослание = Задачи.ИА_ЗадачаПланаДействий.СоздатьЗадачу();
		
		Если масПользователей.Количество() = 0 Тогда 
			Сообщить("По данному посту не найден пользователь в адресации коммцентра!");
			возврат;
		ИначеЕсли масПользователей.Количество() = 1 Тогда 
			обПослание.Пользователь = масПользователей[0];
		Иначе
			СписокПольз = Новый СписокЗначений;
			СписокПольз.ЗагрузитьЗначения(масПользователей);
			
			РезПольз = Неопределено;

			
			ПоказатьВыборИзСписка(Новый ОписаниеОповещения("ОтправитьПосланиеЗавершение", ЭтотОбъект, Новый Структура("обПослание, ФПослание", обПослание, ФПослание)), СписокПольз);
            Возврат;
		КонецЕсли;
		
		//обПослание.ЭтоПослание = Истина;
		ОтправитьПосланиеФрагмент(ФПослание);

	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОтправитьПосланиеЗавершение(ВыбранныйЭлемент, ДополнительныеПараметры) Экспорт
	
	обПослание = ДополнительныеПараметры.обПослание;
	ФПослание = ДополнительныеПараметры.ФПослание;
	
	
	РезПольз = ВыбранныйЭлемент;
	
	Если РезПольз <> Неопределено Тогда
		обПослание.Пользователь = РезПольз.Значение;
	Иначе
		Возврат;
	КонецЕсли;
	
	ОтправитьПосланиеФрагмент(ФПослание);

КонецПроцедуры

&НаКлиенте
Процедура ОтправитьПосланиеФрагмент(Знач ФПослание)
	
	ФПослание.Открыть();

КонецПроцедуры

&НаКлиенте
Процедура ПоставитьЗадачу(Команда)
	ТекОбласть = Элементы.ОргСхема.ТекущаяОбласть;
	ТекЭлем = ТекОбласть.Расшифровка;
	Если ТекЭлем = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТекЭлем) и ТипЗнч(ТекЭлем) = Тип("СправочникСсылка.ОргСхема") Тогда		
		Парам = Новый Структура("Пост", ТекЭлем);
		ОткрытьФорму("Задача.ИА_ЗадачаПланаДействий.ФормаОбъекта",Парам,ЭтаФорма,новый УникальныйИдентификатор);		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ТекущиеЗадачи(Команда)
	ТекОбласть = Элементы.ОргСхема.ТекущаяОбласть;
	ТекЭлем = ТекОбласть.Расшифровка;
	Если ТекЭлем = Неопределено Тогда
		Возврат;
