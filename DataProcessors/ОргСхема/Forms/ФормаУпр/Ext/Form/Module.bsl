&НаСервере
Процедура ПроцентыВыполненияБП_Сервер(МассивНарисованныхЭлементов)
	ПроцентыПланов = ПолучитьПроцентыВыполненияПланов();
	
	Для каждого стр из МассивНарисованныхЭлементов Цикл
		Если   (стр.ТипТерминала = ПредопределенноеЗначение("Перечисление.ТипТерминалаОргСхемы.РуководящийСостав")
		  ИЛИ  стр.ТипТерминала = ПредопределенноеЗначение("Перечисление.ТипТерминалаОргСхемы.Департамент")
		  ИЛИ  стр.ТипТерминала = ПредопределенноеЗначение("Перечисление.ТипТерминалаОргСхемы.Отдел")) И ЕстьСотрудники(стр.Ссылка) Тогда
		  
		  	ТекстБП = "НЕТ БП";
			нстроки = ПроцентыПланов.НайтиСтроки(новый структура("Пост", стр.Ссылка));
			//Для каждого стрПост из ПроцентыПланов Цикл
			//	Если стрПост.Пост = стр.Ссылка Тогда
			//		ТекстБП = формат(?(стрПост.ИтогоВремя = 0, 0, стрПост.ВыполненоВремя / стрПост.ИтогоВремя * 100),"ЧДЦ=; ЧН=")+"%"; 
			//		Прервать;
			//	КонецЕсли;
			//КонецЦикла;
			Если нстроки.количество()>0 Тогда
				ТекстБП = формат(?(нстроки[0].ИтогоВремя = 0, 0, нстроки[0].ВыполненоВремя / нстроки[0].ИтогоВремя * 100),"ЧДЦ=; ЧН=")+"%"; 
			КонецЕсли;
			
			Элем = ОргСхема.Рисунки[стр.Элемент];			
			
			ПодписьБП = ОргСхема.Рисунки.Добавить(ТипРисункаТабличногоДокумента.Текст);
			ЗаполнитьЗначенияСвойств(ПодписьБП, Элем);
			ПодписьБП.Высота = 7;
			ПодписьБП.Ширина = 20;
			ПодписьБП.Лево = Элем.Лево + Элем.Ширина - ПодписьБП.Ширина;
			
			ПодписьБП.Узор = ТипУзораТабличногоДокумента.Сплошной;
			ПодписьБП.ЦветФона = Новый Цвет(184,214,255);
			ПодписьБП.Текст = ТекстБП;
			
			ПодписьБП.Линия = новый Линия(ТипЛинииРисункаТабличногоДокумента.Сплошная,2);
			ПодписьБП.ЦветЛинии = Новый Цвет(0,10,255);
			
			ПодписьБП.Шрифт = Новый Шрифт(ПодписьБП.Шрифт,,9,истина,ложь, ложь,ложь);

		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

&НаСервере
Функция ПолучитьПроцентыВыполненияПланов()
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	СУММА(ИА_ПланыДействийШаги.Время) КАК ИтогоВремя,
	               |	СУММА(ВЫБОР
	               |			КОГДА ИА_ПланыДействийШаги.Выполнено
	               |				ТОГДА ИА_ПланыДействийШаги.Время
	               |			ИНАЧЕ 0
	               |		КОНЕЦ) КАК ВыполненоВремя,
	               |	ИА_ПланыДействийШаги.Владелец.Пост КАК Пост
	               |ИЗ
	               |	Справочник.ИА_ЗадачиПлана КАК ИА_ПланыДействийШаги
	               |ГДЕ
	               |	ИА_ПланыДействийШаги.Владелец.ПометкаУдаления = ЛОЖЬ
	               |	И ИА_ПланыДействийШаги.Владелец.ДатаНачала >= &ДатаНачала
	               |	И ИА_ПланыДействийШаги.Владелец.Родитель = ЗНАЧЕНИЕ(Справочник.ИА_ПланыДействий.ПустаяСсылка)
	               |	И ИА_ПланыДействийШаги.Пост.ТипТерминала В(&ТипТерминала)
	               |	И ИА_ПланыДействийШаги.Пост В ИЕРАРХИИ(&Пост)
	               |	И ИА_ПланыДействийШаги.ПометкаУдаления = ЛОЖЬ
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ИА_ПланыДействийШаги.Владелец.Пост";
	ТипыТ = Новый Массив;
	ТипыТ.Добавить(Перечисления.ТипТерминалаОргСхемы.РуководящийСостав);
	ТипыТ.Добавить(Перечисления.ТипТерминалаОргСхемы.Департамент);
	ТипыТ.Добавить(Перечисления.ТипТерминалаОргСхемы.Отдел);
	
	Запрос.УстановитьПараметр("ДатаНачала", ТекущаяДата() - 60*60*24*7*6);
	Запрос.УстановитьПараметр("ТипТерминала", ТипыТ);
	Запрос.УстановитьПараметр("Пост", Объект.Организация);
	
	тз = Запрос.Выполнить().Выгрузить();
	
	//ЗначениеВРеквизитФормы(тз,"ПроцентыПланов");
	возврат тз;
КонецФункции

&НаКлиенте
Процедура ОткрытьОргсхемуСекции(Команда)
	ТекОбласть = Элементы.ОргСхема.ТекущаяОбласть;
	ТекЭлем = ТекОбласть.Расшифровка;
		 		
	Форма = ПолучитьФорму("Обработка.ОргСхема.Форма.ФормаУпр",,,Истина);
	Форма.объект.организация = ПолучитьВложОргсхему(ТекЭлем);
	Форма.Открыть(); 
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьВложОргсхему(пПост)
	возврат пПост.СсылкаНаВложеннуюОргсхему;
КонецФункции

&НаКлиенте
Процедура Переместить(Команда)
	ТекОбласть = Элементы.ОргСхема.ТекущаяОбласть;
	ТекЭлем = ТекОбласть.Расшифровка;	
	Если ТекЭлем = Неопределено Тогда
		Элементы.ОргСхемаКонтекстноеМенюВывестиОтдельно.Видимость = Ложь;
		Возврат;
	КонецЕсли;
	ДанныеЭлемента = СсылкуВСтруктуру(ТекЭлем, "Ссылка, ТипТерминала,СсылкаНаВложеннуюОргсхему");
	
	Если ДанныеЭлемента.ТипТерминала = ПредопределенноеЗначение("Перечисление.ТипТерминалаОргСхемы.Учредитель") или ДанныеЭлемента.ТипТерминала = ПредопределенноеЗначение("Перечисление.ТипТерминалаОргСхемы.Организация") Тогда
		Возврат;
	КонецЕсли;

	Список = Новый СписокЗначений;
	Если ДанныеЭлемента.ТипТерминала = ПредопределенноеЗначение("Перечисление.ТипТерминалаОргСхемы.Департамент") 
		ИЛИ ДанныеЭлемента.ТипТерминала = ПредопределенноеЗначение("Перечисление.ТипТерминалаОргСхемы.Отдел")
		ИЛИ ДанныеЭлемента.ТипТерминала = ПредопределенноеЗначение("Перечисление.ТипТерминалаОргСхемы.РуководящийСостав")
		Тогда
		Список.Добавить("Влево");
		Список.Добавить("Вправо");
	Иначе
		Список.Добавить("Вверх");
		Список.Добавить("Вниз");
	КонецЕсли;
	
	Параметр = новый Структура("ТекЭлем",ТекЭлем);
	Оп = Новый ОписаниеОповещения("ПереместитьПослеВыбора", ЭтотОбъект, Параметр);
	ПоказатьВыборИзСписка(Оп, Список);
КонецПроцедуры

&НаКлиенте
Процедура ПереместитьПослеВыбора(ВыбранныйЭлемент, ДопПарам) Экспорт
	Если  ВыбранныйЭлемент = Неопределено тогда
		Возврат;
	КонецЕсли;
	
	зн = ВыбранныйЭлемент.значение;
	ТекЭлем = ДопПарам.ТекЭлем;
	Если зн  = "Влево" или зн = "Вверх" Тогда
		ПереместитьВлевоНаСервере(ТекЭлем);		
	Иначе
		ПереместитьВправоНаСервере(ТекЭлем);
	КонецЕсли;
	ОбновитьОС(МассивНарисованныхЭлементов);
КонецПроцедуры
