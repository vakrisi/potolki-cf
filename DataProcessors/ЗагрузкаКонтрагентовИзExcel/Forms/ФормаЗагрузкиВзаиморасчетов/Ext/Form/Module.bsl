
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ВалютаУчета = Константы.ВалютаУчета.Получить();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)
	
	Если ПеренестиВДокумент И НЕ ЭтаФорма.ВладелецФормы = Неопределено Тогда
		АдресВХранилище = ЗаписатьДолгиВХранилище(ЭтаФорма.ВладелецФормы.УникальныйИдентификатор);
	Иначе
		АдресВХранилище = Неопределено;
	КонецЕсли;
	
	Если АдресВХранилище <> Неопределено Тогда
		Структура = Новый Структура("АдресВХранилище", АдресВХранилище);
		ОповеститьОВыборе(Структура);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти 

&НаКлиенте
Процедура ПеренестиВДокумент(Команда)
		
	ПеренестиВДокумент = Истина;
	Закрыть(КодВозвратаДиалога.OK); 
	
КонецПроцедуры

&НаСервере
Функция ЗаписатьДолгиВХранилище(УникальныйИдентификаторВладельца) 
		
	АдресВХранилище = Неопределено;	
	Если ПеренестиВДокумент Тогда
		
		ТаблицаДолговКВозврату = ТаблицаДолгов.Выгрузить().СкопироватьКолонки();
		Для каждого СтрокаТЗ из ТаблицаДолгов Цикл
			Если НЕ ЗначениеЗаполнено(СтрокаТЗ.Контрагент) Тогда
				Продолжить;
			КонецЕсли;
			НоваяСтрока = ТаблицаДолговКВозврату.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТЗ);
		КонецЦикла;
		АдресВХранилище = ПоместитьВоВременноеХранилище(ТаблицаДолговКВозврату, УникальныйИдентификаторВладельца);
		
	КонецЕсли;
	
	Возврат АдресВХранилище;
	
КонецФункции

&НаКлиенте
Процедура ПутьКФайлуНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ДиалогВыбора = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	ДиалогВыбора.Заголовок = "Выберите файл";
	ДиалогВыбора.Фильтр = "Файл Excel (*.xlsx;*.xls)|*.xlsx;*.xls|Все файлы (*.*)|*.*";
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ПутьКФайлуНачалоВыбораЗавершение", ЭтотОбъект);
	ДиалогВыбора.Показать(ОписаниеОповещения);
	
КонецПроцедуры

&НаКлиенте
Процедура ПутьКФайлуНачалоВыбораЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Объект.ПутьКФайлу = Результат[0];
		
КонецПроцедуры

&НаКлиенте
Функция ПроверитьЗаполнениеНаФорме()
	
	Если НЕ ЗначениеЗаполнено(Объект.ПутьКФайлу) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не заполнено поле ""Путь к файлу""", , "Объект.ПутьКФайлу");
		Возврат Ложь;
	КонецЕсли;
	
	Если НомерКолонкиНаименование = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не заполнено поле Номер колонки ""Контрагент""", , , "НомерКолонкиНаименование");
		Возврат Ложь;
	КонецЕсли;
	
	Если НомерКолонкиСумма = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не заполнено поле Номер колонки ""Сумма""", , , "НомерКолонкиСумма");
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции
	
&НаКлиенте
Процедура ПрочитатьФайл(Команда)
	
	Если НЕ ПроверитьЗаполнениеНаФорме() Тогда 
		Возврат;
	КонецЕсли;
	
	//подключаемся к Excel
	Попытка
		Excel = Новый COMОбъект("Excel.Application");
		Excel.WorkBooks.Open(Объект.ПутьКФайлу);
		ПоказатьОповещениеПользователя("Обработка файла Microsoft Excel...");
	Исключение
		Сообщить("Ошибка при открытии файла с помощью Excel! Загрузка не будет произведена!");
		Сообщить(ОписаниеОшибки());
		Возврат;
	КонецПопытки;
	
	КоличествоСтрок = Excel.Cells(1,1).SpecialCells(11).Row;
	
	Если ТаблицаДолгов.Количество() > 0 Тогда
		ПоказатьОповещениеПользователя("Таблица долгов очищена");
	КонецЕсли;
	ТаблицаДолгов.Очистить();
	
	Для н = НомерСтроки по КоличествоСтрок Цикл
		Наименование = Excel.Cells(н, НомерКолонкиНаименование).Value;
		Если НЕ ПустаяСтрока(Наименование) Тогда
			
			НоваяСтрока = ТаблицаДолгов.Добавить();
			
			Контрагент = НайтиКонтрагента(Наименование);
			
			НоваяСтрока.Контрагент = Контрагент;
			НоваяСтрока.КонтрагентИзФайла = Наименование;			
			
			Если НЕ НомерКолонкиДоговор = 0 Тогда 
				НоваяСтрока.ДоговорИзФайла = Excel.Cells(н, НомерКолонкиДоговор).Value;
				Если ЗначениеЗаполнено(Контрагент) Тогда
					НоваяСтрока.Договор = ПодобратьДоговор(Контрагент, НоваяСтрока.ДоговорИзФайла);
				КонецЕсли;
			Иначе
				Если ЗначениеЗаполнено(Контрагент) Тогда
					НоваяСтрока.Договор = ПодобратьДоговор(Контрагент, "");
				КонецЕсли;
			КонецЕсли;
			
			Если НЕ НомерКолонкиВалюта = 0 Тогда 
				НоваяСтрока.ВалютаИзФайла = Excel.Cells(н, НомерКолонкиВалюта).Value;
				Если НЕ ПустаяСтрока(НоваяСтрока.ВалютаИзФайла) Тогда
					Валюта = ПодобратьВалюту(НоваяСтрока.ВалютаИзФайла);
					НоваяСтрока.Валюта = ?(Валюта.Пустая(), ВалютаУчета, Валюта);
				Иначе
					НоваяСтрока.Валюта = ВалютаУчета;
				КонецЕсли;
			Иначе
				НоваяСтрока.Валюта = ВалютаУчета;
			КонецЕсли;			
			
			Попытка
				НоваяСтрока.Сумма = Число(Excel.Cells(н, НомерКолонкиСумма).Value);
			Исключение
			КонецПопытки;
		КонецЕсли;
		
	КонецЦикла;  	
	
	//Закрыть Ексель после выполнения кода
	Excel.DisplayAlerts = 0; 
	Excel.Quit();
	Excel.DisplayAlerts = 1;
	
КонецПроцедуры

&НаСервере
Функция НайтиКонтрагента(Наименование)
	Возврат Справочники.Контрагенты.НайтиПоНаименованию(Наименование);
КонецФункции

&НаСервере
Функция ПодобратьВалюту(СтрВалюта)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Валюты.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Валюты КАК Валюты
	|ГДЕ
	|	Валюты.Код ПОДОБНО &СтрВалюта
	|	ИЛИ Валюты.Наименование ПОДОБНО &СтрВалюта";
	
	Запрос.УстановитьПараметр("СтрВалюта", СтрВалюта);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Справочники.Валюты.ПустаяСсылка();
	
КонецФункции

&НаСервере
Функция ПодобратьДоговор(Контрагент, СтрДоговор)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Договоры.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ДоговорыКонтрагентов КАК Договоры
	|ГДЕ
	|	(Договоры.Владелец = &Контрагент
	|			ИЛИ Договоры.Наименование ПОДОБНО &СтрДоговор)";
	
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Запрос.УстановитьПараметр("СтрДоговор", СтрДоговор);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;		
	КонецЕсли;
	
	Возврат Контрагент.ОсновнойДоговор;
	
КонецФункции
