&НаКлиенте
Процедура ОтборСтатусСборки()
	
	МассивРеквизитов = ПолучитьМассивРеквизитовСтатусыСборки();
	
	ЗаказПокупателяОтборПоСтатусуСборки.Очистить();
	
	Для каждого ИмяРеквизита Из МассивРеквизитов Цикл
		
		Если Элементы["СписокЗаказыПокупателейОтборСтатус" + ИмяРеквизита].Пометка Тогда
			
			Если ИмяРеквизита = "НеУказан" Тогда
				ЗаказПокупателяОтборПоСтатусуСборки.Добавить(ПредопределенноеЗначение("Справочник.СтатусыСборкиЗаказов.ПустаяСсылка"));
			Иначе
				ЗаказПокупателяОтборПоСтатусуСборки.Добавить(ПредопределенноеЗначение("Справочник.СтатусыСборкиЗаказов." + ИмяРеквизита));
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	УстановитьОтборЗаказовПокупателей();
	
КонецПроцедуры

