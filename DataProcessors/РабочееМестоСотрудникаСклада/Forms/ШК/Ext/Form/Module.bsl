Процедура ВыделитьКнопкиОтбораСтатусаСборки()
	
	МассивРеквизитов = ПолучитьМассивРеквизитовСтатусыСборки();
	
	Для каждого ИмяРеквизита Из МассивРеквизитов Цикл
		
		ЭлементКнопка = Элементы["СписокЗаказыПокупателейОтборСтатус" + ИмяРеквизита];
		
		Если ЭлементКнопка.Пометка Тогда
			ЭлементКнопка.ЦветФона = WebЦвета.Оранжевый;
		Иначе
			ЭлементКнопка.ЦветФона = WebЦвета.СветлоЖелтыйЗолотистый;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры
