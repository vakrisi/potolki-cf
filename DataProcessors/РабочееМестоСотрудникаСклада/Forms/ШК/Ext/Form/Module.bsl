
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ИспользоватьПодключаемоеОборудование = Константы.ИспользоватьПодключаемоеОборудование.Получить();
	ИспользоватьСтатусы = ПолучитьФункциональнуюОпцию("ИспользоватьСтатусыСборкиЗаказовПокупателей");
	
	ТекущийЭлемент = Элементы.ИмитацияШК;
	
	//++ №13830
	ИспользоватьСтатусыСборкиЗаказовПокупателей = ПолучитьФункциональнуюОпцию("ИспользоватьСтатусыСборкиЗаказовПокупателей");
	ИспользоватьСтатусЗакрытВЗаказеПокупателя = ПолучитьФункциональнуюОпцию("ИспользоватьСтатусЗакрытВЗаказеПокупателя"); // №14078
	
	Элементы.ГруппаЗаказПокупателяОтборыПоСтатусамСборки.Видимость = (ИспользоватьСтатусыСборкиЗаказовПокупателей);
	Элементы.ОтборСтатусЗаказаЗакрыт.Видимость = ИспользоватьСтатусЗакрытВЗаказеПокупателя; // №14078
	
	ВосстановитьНастройкиФормы();
	
	УстановитьОтборЗаказовПокупателей();
	//-- №13830
	
	// №14078
	ОбщийМодульСервер.УстановитьПериодАвтоОбновленияДляВсехДинамическихСписков(ЭтаФорма, ОбщийМодульСервер.НастройкаПользователя("ЧастотаАвтоматическогоОбновленияСписковВРабочемМестеСотрудникаСклада"));
	
	// #14908
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ДанныеСправочника.ИмяПредопределенныхДанных КАК ИмяПредопределенныхДанных
	|ИЗ
	|	Справочник.ДействияВРабочемМестеРаботникаСклада КАК ДанныеСправочника
	|ГДЕ
	|	(НЕ ДанныеСправочника.ЭтапОтображения = ЗНАЧЕНИЕ(Перечисление.ЭтапыОтображенияДействияВРабочемМестеСотрудникаСклада.ПослеСканированияШКЗаказаПокупателя)
	|		ИЛИ НЕ ДанныеСправочника.Доступно)
	|	И ДанныеСправочника.Предопределенный";
	
	Выборка = Запрос.Выполнить().Выбрать();	
	Пока Выборка.Следующий() Цикл 
		Элементы[Выборка.ИмяПредопределенныхДанных].Видимость = Ложь;
		
	    // видимость кнопок регулируется опционально
		Если ИспользоватьСтатусы Тогда
			Если Выборка.ИмяПредопределенныхДанных = "ЗаказПокупателяИзменитьСборщика" Тогда
				Элементы[Выборка.ИмяПредопределенныхДанных].Видимость = Ложь;	
			КонецЕсли;
		Иначе
			Если Выборка.ИмяПредопределенныхДанных = "ЗаказПокупателяСобранЧастично" 
				ИЛИ Выборка.ИмяПредопределенныхДанных = "ЗаказПокупателяСобранПолностью" Тогда
				Элементы[Выборка.ИмяПредопределенныхДанных].Видимость = Ложь;	
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	КнопокВНижнемРяду = 0;
	Для каждого Элемент из Элементы.ГруппаКнопкиНижнийРяд.ПодчиненныеЭлементы Цикл
		Если Элемент.Видимость Тогда
			КнопокВНижнемРяду = КнопокВНижнемРяду + 1;
		КонецЕсли;
	КонецЦикла;
	Если КнопокВНижнемРяду > 1 Тогда
		Элементы.Отмена.Видимость = Ложь;
	Иначе
		Элементы.Отмена1.Видимость = Ложь;
	КонецЕсли;
	
	//nva+++
	//ЭлементУО = УсловноеОформление.Элементы.Добавить();
	//
	//ОтборУО = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	//ОтборУО.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.СписокЗаказыПокупателей.КоличествоЗаявокНаДоставку");
	//ОтборУО.ВидСравнения = ВидСравненияКомпоновкиДанных.Заполнено;
	////ОтборУО.ПравоеЗначение = "1";
	//
	//ОформляемоеПоле = ЭлементУО.Поля.Элементы.Добавить();
	//ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("СписокЗаказыПокупателей");
	//
	//ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветФона", WebЦвета.БледноЗеленый);
	
	лУсловноеОформление = СписокЗаказыПокупателей.КомпоновщикНастроек.Настройки.УсловноеОформление.Элементы;
	МассивНастроекОформления = Новый Массив;
	НомерНастройки = 0;
	Для Каждого ЭлементУсловногоОформления Из лУсловноеОформление Цикл
		ЦветФона = Неопределено;
		Для Каждого ЭлементОформления Из ЭлементУсловногоОформления.Оформление.Элементы Цикл
			Если ЭлементОформления.Параметр = Новый ПараметрКомпоновкиДанных("ЦветФона") И ЭлементОформления.Использование Тогда
				ЦветФона = ЭлементОформления.Значение;
			КонецЕсли;	
		КонецЦикла;
		Если ЦветФона = Неопределено Тогда
			Продолжить;
		КонецЕсли;	
		НастройкаЦвета = Новый Структура("Настройка, Цвет, Подсказка, Использовать", "НастройкаОформления" + НомерНастройки, ЦветФона, ЭлементУсловногоОформления.Представление, Истина);
		МассивНастроекОформления.Добавить(НастройкаЦвета);
		НомерНастройки = НомерНастройки + 1;
	КонецЦикла;	
	Для каждого НастройкаЦвета из МассивНастроекОформления Цикл
		//НастройкаЦвета = Структура("Настройка, Цвет, Подсказка, Использовать"
		
		ИмяНастройки = НастройкаЦвета.Настройка;		
		
		Группа = Элементы.Добавить("ГруппаЗаказПокупателейОформление" + ИмяНастройки, Тип("ГруппаФормы"), Элементы.ГруппаЗаказПокупателейОформление);
		Группа.Вид = ВидГруппыФормы.ОбычнаяГруппа;
		Группа.Отображение = ОтображениеОбычнойГруппы.Нет;
		Группа.ОтображатьЗаголовок = Ложь;
		Группа.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Горизонтальная;
		
		Элемент = Элементы.Добавить("ДекорацияЦвет" + ИмяНастройки, Тип("ДекорацияФормы"), Группа);
		Элемент.Вид = ВидДекорацииФормы.Надпись;
		Элемент.Заголовок = "";
		Элемент.Ширина = 2;
		Элемент.Высота = 1;
		Элемент.ЦветФона = НастройкаЦвета.Цвет;
		
		Элемент = Элементы.Добавить("ДекорацияНадпись" + ИмяНастройки, Тип("ДекорацияФормы"), Группа);
		Элемент.Вид = ВидДекорацииФормы.Надпись;
		Элемент.Заголовок = НастройкаЦвета.Подсказка;
		Элемент.АвтоМаксимальнаяШирина = Ложь;
	КонецЦикла;
	//nva---
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
		
	МенеджерОборудованияКлиентПереопределяемый.НачатьПодключениеОборудованиеПриОткрытииФормы(ЭтаФорма, "СканерШтрихкода");
	
	ВыделитьКнопкиОтбораСтатусаСборки(); // №13830
	ВыделитьКнопкиОтбораСтатусаЗаказа(); // №14078
	ВыделитьКнопкиОтбораСтатусаОбеспечения();
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
		
	Если ЗавершениеРаботы Тогда
		Возврат;
	КонецЕсли;
	
	//СохранитьНастройкиФормы(); // №13830  // #14403 перенесено в процедуру нажатия кнопок, так как не сохраняется при закрытии через завершение работы
	
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)
	
	МенеджерОборудованияКлиентПереопределяемый.НачатьОтключениеОборудованиеПриЗакрытииФормы(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если Источник = "ПодключаемоеОборудование" И ВводДоступен() Тогда 
		Если ИмяСобытия = "ScanData" Тогда
			ОбработатьШтрихкоды(МенеджерОборудованияПотолкиКлиент.ПреобразоватьДанныеСоСканераВСтруктуру(Параметр));
			
			ПодключитьОбработчикОжидания("УстановитьТекущийЭлемент", 0.1, Истина);
		КонецЕсли;	
	КонецЕсли; 
			
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура ИмитацияШКПриИзменении(Элемент)
	
	ПараметрыКОтправке = Новый Массив;
	ПараметрыКОтправке.Добавить(ИмитацияШК);
	ПараметрыКОтправке.Добавить(Неопределено);
	ОбработкаОповещения("ScanData", ПараметрыКОтправке, "ПодключаемоеОборудование");
	ИмитацияШК = "";
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ВыборДействия(Команда)
	
	Действие = Команда.Имя;
	
	ПараметрыФормы = Новый Структура("ДокументСсылка, Действие", ДокументСсылка, Действие);
	
	Если ДействиеТребуетУказаниеСотрудника(Действие) Тогда		
		ОписаниеОповещения = Новый ОписаниеОповещения("ВыборДействияПоДокументуЗавершение", ЭтотОбъект, ПараметрыФормы);
		ОткрытьФорму("Обработка.РабочееМестоСотрудникаСклада.Форма.ШКСотрудника", ПараметрыФормы, ЭтаФорма, , , , ОписаниеОповещения);
	Иначе		
		Результат = Новый Структура("Действие", Действие);
		ДополнительныеПараметры = Новый Структура("ДокументСсылка, Сотрудник", ДокументСсылка, Неопределено);
		ВыборДействияПоДокументуЗавершение(Результат, ДополнительныеПараметры);		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура Отмена(Команда)
	
	ВернутьсяНаНачальнуюСтраницу();
	
КонецПроцедуры

#КонецОбласти

#Область ШтрихкодыИТорговоеОборудование

&НаКлиенте
Процедура ОбработатьШтрихкоды(Данные)
	
	Если Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.ГруппаНачальнаяСтраница Тогда
		// штрихкод документа
		МассивСсылок = СсылкаНаЭлементСпискаПоШтрихкоду(Данные.Штрихкод);
		Если ЗначениеЗаполнено(МассивСсылок) Тогда
			Если МассивСсылок.Количество() = 1 Тогда
				ВыборДокументаИзСпискаЗавершение(МассивСсылок[0], Неопределено);
			Иначе
				ПараметрыФормы = Новый Структура("МассивСсылок", МассивСсылок);
				ОписаниеОповещения = Новый ОписаниеОповещения("ВыборДокументаИзСпискаЗавершение", ЭтотОбъект);
				ОткрытьФорму("Обработка.РабочееМестоСотрудникаСклада.Форма.ФормаСпискаДокументовПоСсылкам", ПараметрыФормы, ЭтаФорма, , , , ОписаниеОповещения);
			КонецЕсли;			
		Иначе
			ШтрихкодированиеПечатныхФормКлиент.ОбъектНеНайден(Данные.Штрихкод);
		КонецЕсли;
		
	ИначеЕсли Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.ГруппаДокумент Тогда
		// штрихкод сотрудника
		ОчиститьСообщения();
		ДанныеПоШК = ШтрихкодированиеПотолкиКлиент.ОбработатьШтрихкод(Данные.Штрихкод, 1);		
		Если НЕ ДанныеПоШК = Неопределено Тогда
			//#14908 закомментировано
			//Если ДанныеПоШК.Операция = ПредопределенноеЗначение("Справочник.ОперацииНадДокументами.СборкаЗаказаПокупателя") Тогда				
				ПараметрыФормы = Новый Структура("ДокументСсылка, Сотрудник", ДокументСсылка, ДанныеПоШК.Сотрудник);
				ОписаниеОповещения = Новый ОписаниеОповещения("ВыборДействияПоДокументуЗавершение", ЭтотОбъект, ПараметрыФормы);
				ОткрытьФорму("Обработка.РабочееМестоСотрудникаСклада.Форма.ФормаВыбораДействияНадДокументом", ПараметрыФормы, ЭтаФорма, , , , ОписаниеОповещения);
			//КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция СсылкаНаЭлементСпискаПоШтрихкоду(Штрихкод)
	
	Менеджеры = Новый Массив;
	Менеджеры.Добавить(ПредопределенноеЗначение("Документ.ЗаказПокупателя.ПустаяСсылка")); 
	Менеджеры.Добавить(ПредопределенноеЗначение("Документ.ПеремещениеТоваров.ПустаяСсылка")); //nva
	Возврат ШтрихкодированиеПечатныхФормКлиент.ПолучитьСсылкуПоШтрихкодуТабличногоДокумента(Штрихкод, Менеджеры);
	
КонецФункции

&НаКлиенте
Процедура ВыборДокументаИзСпискаЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;		                          	
	КонецЕсли;
	
	ДокументСсылка = Результат;
	//nva+++
	Если ТипЗнч(Результат) <> Тип("ДокументСсылка.ЗаказПокупателя") Тогда
		ОткрытьЗначение(Результат);
		Возврат;
	КонецЕсли;
	//nva---
	ДанныеДокумента = ОбщийМодульВызовСервера.ЗначенияРеквизитовОбъекта(ДокументСсылка, "Контрагент, СуммаДокумента, Валюта, Сборщик, Сборщик2");
	Сборщик = ДанныеДокумента.Сборщик;
	Сборщик2 = ДанныеДокумента.Сборщик2;
	ПредставлениеПолейДокумента = СтрШаблон("Контрагент: %1, сумма %2 %3", ДанныеДокумента.Контрагент, ДанныеДокумента.СуммаДокумента, ДанныеДокумента.Валюта);
	
	Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.ГруппаДокумент;
		
КонецПроцедуры

&НаКлиенте
Процедура ВыборДействияПоДокументуЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;		                          	
	КонецЕсли; 
	
	ВернутьсяНаНачальнуюСтраницу();
	
	// на случай использования оповещения после вызова формы "ШКСотрудника"
	Если Результат.Свойство("Сотрудник") Тогда
		ДополнительныеПараметры.Вставить("Сотрудник", Результат.Сотрудник);	
	КонецЕсли;
	
	Если Результат.Действие = "ОткрытьЗаказПокупателя" Тогда
		ОткрытьЗаказПокупателя(ДополнительныеПараметры.ДокументСсылка);
	ИначеЕсли Результат.Действие = "ПечатьЗаказПокупателя" Тогда
		ПечатьЗаказПокупателя(ДополнительныеПараметры.ДокументСсылка);
		Если ПолучитьСтатусЗаказа(ДополнительныеПараметры.ДокументСсылка) = ПредопределенноеЗначение("Справочник.СтатусыСборкиЗаказов.ВыполнитьСборку") Тогда
			ИзменитьСтатусСборкиНаидетСборка(ДополнительныеПараметры.ДокументСсылка);
		КонецЕсли;		
	ИначеЕсли Результат.Действие = "ПечатьЗаказПокупателяИУстановитьСтатусИдетСборка" Тогда
		ПечатьЗаказПокупателя(ДополнительныеПараметры.ДокументСсылка);
		
	ИначеЕсли Результат.Действие = "ОтгрузитьЗаказПокупателя" Тогда
		ОтгрузитьЗаказПокупателя(ДополнительныеПараметры.ДокументСсылка);
		
	ИначеЕсли Результат.Действие = "ЗаказПокупателяИдетСборка"
		ИЛИ Результат.Действие = "ЗаказПокупателяСобранЧастично"
		ИЛИ Результат.Действие = "ЗаказПокупателяСобранПолностью"
		ИЛИ Результат.Действие = "ЗаказПокупателяСобранПолностьюОтгрузить"
		ИЛИ Результат.Действие = "ЗаказПокупателяИзменитьСборщика"
		ИЛИ Результат.Действие = "ЗаказПокупателяДобавитьСборщика"
		Тогда
		
		Если НЕ Результат.Свойство("ДобавитьСборщика") Тогда
			Если Результат.Действие = "ЗаказПокупателяИдетСборка"
				ИЛИ Результат.Действие = "ЗаказПокупателяСобранЧастично"
				ИЛИ Результат.Действие = "ЗаказПокупателяСобранПолностью"
				ИЛИ Результат.Действие = "ЗаказПокупателяСобранПолностьюОтгрузить" Тогда
					Результат.Вставить("ДобавитьСборщика", Истина);
			Иначе
				Результат.Вставить("ДобавитьСборщика", Ложь)
			КонецЕсли;	
		КонецЕсли;
		
		РезультатЗаполнения = ЗаполнитьЗаказПокупателя(ДополнительныеПараметры.ДокументСсылка, ДополнительныеПараметры.Сотрудник, 
													   Результат.ИзменитьСтатусСборки, Результат.СтатусСборки, Результат.ДобавитьСборщика);
		Если РезультатЗаполнения Тогда
			ПоказатьОповещениеПользователя("Документ сохранен", , "Сборщик в документе изменен");
			
			// #14607
			Если Результат.Отгрузить Тогда
				ОтгрузитьЗаказПокупателя(ДополнительныеПараметры.ДокументСсылка);	
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

