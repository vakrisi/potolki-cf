&НаСервереБезКонтекста
Функция ПолучитьСтатусЗаказа(Заказ)
	Возврат Заказ.СтатусСборки;	
КонецФункции

&НаСервере
Процедура ИзменитьСтатусСборкиНаидетСборка(Заказ) 
	
	Если НЕ ЗначениеЗаполнено(Заказ) ИЛИ ТипЗнч(Заказ) <> Тип("ДокументСсылка.ЗаказПокупателя") Тогда 
		Возврат;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	
	Попытка
		ЗаказОбъект = Заказ.ПолучитьОбъект();
		ЗаказОбъект.Заблокировать();
		ЗаказОбъект.СтатусСборки = Справочники.СтатусыСборкиЗаказов.ИдетСборка;
		ЗаказОбъект.Записать();
		ЗаказОбъект.Разблокировать();
	Исключение
		Сообщить(НСтр("ru = 'Невозможно заблокировать документ.';"
     + " en = 'Can't lock the document.'"));
	КонецПопытки;	
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры	

