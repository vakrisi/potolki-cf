	МассивРеквизитов.Добавить("НеОбеспечен");
	МассивРеквизитов.Добавить("Обеспечен");
	
	ЗаказПокупателяОтборПоСтатусуОбеспечения.Очистить();
	
	Для каждого ИмяРеквизита Из МассивРеквизитов Цикл
		
