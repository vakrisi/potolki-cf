				ЗаказПокупателяОтборПоСтатусуОбеспечения.Добавить("Обеспечен");
			ИначеЕсли ИмяРеквизита = "НеОбеспечен" Тогда	
			    ЗаказПокупателяОтборПоСтатусуОбеспечения.Добавить("Не обеспечен");
