#Область Печать

//++ №13830
&НаКлиенте
Процедура ПечатьЗаказПокупателя(ЗаказСсылка)

	СтруктураПечати = ПолучитьСтруктуруПечати();
	
	Если НЕ СтруктураПечати.ПечатнаяФормаУказана Тогда
		
		ПоказатьПредупреждение(, "В настройках пользователя не указана печатная форма заказа покупателя для рабочего места кладовщика.");
		Возврат;
		
	ИначеЕсли НЕ СтруктураПечати.ПечатнаяФормаНайдена Тогда
		
		ПоказатьПредупреждение(, "Не удалось найти печатную форму для заказа покупателя, указанную в настройках пользователя, необходимо выбрать актуальную печатную форму в настройках пользователя.");
		Возврат;
		
	КонецЕсли;
	
	МассивОбъектов = новый Массив;
	МассивОбъектов.Добавить(ЗаказСсылка);
	
	Если СтруктураПечати.МенеджерПечати = "СтандартныеПодсистемы.ДополнительныеОтчетыИОбработки" Тогда
		
		//СтруктураПечати.Вставить("Форма", ЭтаФорма);		
		//ДополнительныеОтчетыИОбработкиКлиент.ВыполнитьОткрытиеПечатнойФормыЗавершение(МассивОбъектов, СтруктураПечати);
		
		УправлениеПечатьюСлужебныйКлиент.ВыполнитьОткрытиеПечатнойФормы( 
			СтруктураПечати.ВыполняемаяКоманда.Ссылка,
			СтруктураПечати.ВыполняемаяКоманда.Идентификатор,
			МассивОбъектов,
			ЭтотОбъект,
			Истина);
		
	Иначе		
		
		УправлениеПечатьюКлиент.ВыполнитьКомандуПечати(СтруктураПечати.МенеджерПечати, 
			СтруктураПечати.Идентификатор,
			МассивОбъектов,
			ЭтотОбъект);
			
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьСтруктуруПечати()
	
	СтруктураДанных = новый Структура;
	СтруктураДанных.Вставить("ПечатнаяФорма", ОбщийМодульСервер.НастройкаПользователя("ПечатнаяФормаЗаказаПокупателяВРабочемМестеКладовщика"));
	СтруктураДанных.Вставить("ПечатнаяФормаУказана", ЗначениеЗаполнено(СтруктураДанных.ПечатнаяФорма));
	
	Если Не СтруктураДанных.ПечатнаяФормаУказана Тогда
		Возврат СтруктураДанных;
	КонецЕсли;
	
	КомандыПечатиЗаказаПокупателя = УправлениеПечатью.КомандыПечатиФормы("Документ.ЗаказПокупателя.Форма.ФормаДокумента").Скопировать();
	
	НайденныеСтроки = КомандыПечатиЗаказаПокупателя.НайтиСтроки(новый Структура("Идентификатор", СтруктураДанных.ПечатнаяФорма));
	
	СтруктураДанных.Вставить("ПечатнаяФормаНайдена", НайденныеСтроки.Количество() > 0);
	
	Если НЕ СтруктураДанных.ПечатнаяФормаНайдена Тогда
		Возврат СтруктураДанных;
	КонецЕсли;
	
	ДанныеКоманды = НайденныеСтроки[0];
	
	СтруктураДанных.Вставить("Идентификатор", ДанныеКоманды.Идентификатор);
	СтруктураДанных.Вставить("МенеджерПечати", ДанныеКоманды.МенеджерПечати);
	
	ВыполняемаяКоманда = новый Структура;
	
	Если СтруктураДанных.МенеджерПечати = "СтандартныеПодсистемы.ДополнительныеОтчетыИОбработки" И ТипЗнч(ДанныеКоманды.ДополнительныеПараметры) = Тип("Структура") Тогда
		
		ВыполняемаяКоманда.Вставить("Ссылка", ДанныеКоманды.ДополнительныеПараметры.Ссылка);
		ВыполняемаяКоманда.Вставить("Идентификатор", ДанныеКоманды.Идентификатор);
		
	КонецЕсли;
	
	СтруктураДанных.Вставить("ВыполняемаяКоманда", ВыполняемаяКоманда);
	
	Возврат СтруктураДанных;
	
КонецФункции



