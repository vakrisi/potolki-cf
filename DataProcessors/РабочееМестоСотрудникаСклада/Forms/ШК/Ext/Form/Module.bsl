&НаКлиенте
Процедура ВернутьсяНаНачальнуюСтраницу()
	
	ИмитацияШК = "";
	ДокументСсылка = ПредопределенноеЗначение("Документ.ЗаказПокупателя.ПустаяСсылка");
	Сборщик        = ПредопределенноеЗначение("Справочник.Сотрудники.ПустаяСсылка");
	Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.ГруппаНачальнаяСтраница;
	
	УстановитьТекущийЭлемент();
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьЗаказПокупателя(Знач ДокументСсылка)

	Если ЗначениеЗаполнено(ДокументСсылка) Тогда
		ПоказатьЗначение(Неопределено, ДокументСсылка);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ЗаполнитьЗаказПокупателя(ДокументСсылка, Сотрудник, ИзменитьСтатусСборки, СтатусСборки, ДобавитьСборщика)

	Если НЕ ЗначениеЗаполнено(ДокументСсылка) Тогда
		Возврат Ложь;	
	КонецЕсли;
	
	ДокументИзменен = Ложь;
	ДокОбъект = ДокументСсылка.ПолучитьОбъект();
		
	Если ЗначениеЗаполнено(Сотрудник) Тогда
		//nva+++
		Если ЗначениеЗаполнено(ДокОбъект.Сборщик) Тогда
			Если ДобавитьСборщика Тогда
				Если ДокОбъект.Сборщик <> Сотрудник И ДокОбъект.Сборщик2 <> Сотрудник Тогда
					ДокОбъект.Сборщик2 = Сотрудник;
					ДокументИзменен = Истина;
				КонецЕсли;	
			Иначе	
				Если ДокОбъект.Сборщик <> Сотрудник И ДокОбъект.Сборщик2 <> Сотрудник Тогда 
					ДокОбъект.Сборщик2 = Сотрудник;
					ДокументИзменен = Истина;
				ИначеЕсли ДокОбъект.Сборщик = Сотрудник И ДокОбъект.Сборщик2 <> Сотрудник Тогда
					ДокОбъект.Сборщик = ДокОбъект.Сборщик2;
					ДокОбъект.Сборщик2 = "";
					ДокументИзменен = Истина;
				ИначеЕсли ДокОбъект.Сборщик <> Сотрудник И ДокОбъект.Сборщик2 = Сотрудник Тогда
					ДокОбъект.Сборщик2 = "";
					ДокументИзменен = Истина;	
				КонецЕсли;
			КонецЕсли;	
		Иначе	
			ДокОбъект.Сборщик = Сотрудник;
			ДокументИзменен = Истина;
		КонецЕсли;
		//nva---
	КонецЕсли;
	Если ИзменитьСтатусСборки Тогда
		ДокОбъект.СтатусСборки = СтатусСборки;
		ДокументИзменен = Истина;
	КонецЕсли;

	Если ДокументИзменен Тогда
		Попытка
			ДокОбъект.Записать();		
			Сборщик = Сотрудник;
			Возврат Истина;
		Исключение		
			ТекстОшибки = ОписаниеОшибки();
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон(НСтр("ru = 'Не удалось записать документ: %1'"),
			ТекстОшибки));		
		КонецПопытки;
	Иначе
		Возврат Истина;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

&НаКлиенте
Процедура ОтгрузитьЗаказПокупателя(ЗаказСсылка)
	
	МассивСсылок = Новый Массив;
	МассивСсылок.Добавить(ЗаказСсылка);
	
	ПараметрыВыполнения = Новый Структура("ЭтоФормаОбъекта", Ложь);
	ДополнительныеПараметры = Новый Структура;
	ПараметрыВыполнения.Вставить("ОписаниеКоманды", Новый Структура("ДополнительныеПараметры", ДополнительныеПараметры));
	СозданиеНаОснованииПотолкиКлиент.РеализацияТоваровИУслугСоздатьНаОснованииЗаказаПокупателя(МассивСсылок, ПараметрыВыполнения);

КонецПроцедуры

&НаКлиенте
Процедура УстановитьТекущийЭлемент()
	
	Если Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.ГруппаНачальнаяСтраница Тогда
		ТекущийЭлемент = Элементы.ИмитацияШК;
		
	ИначеЕсли Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.ГруппаДокумент Тогда
		ТекущийЭлемент = Элементы.ИмитацияШК1;		
	КонецЕсли;
	
КонецПроцедуры

//++ №13830
&НаСервере
Процедура СохранитьНастройкиФормы()

	ПользовательскийОтбор = Новый ОтборКомпоновкиДанных();
	ОбщийМодульСервер.НовыйОтбор(ПользовательскийОтбор, "СтатусСборки", ЗаказПокупателяОтборПоСтатусуСборки);
	ОбщийМодульСервер.НовыйОтбор(ПользовательскийОтбор, "ТекущийСтатус", ЗаказПокупателяОтборПоТекущемуСтатусу); // №14078
	ОбщийМодульСервер.НовыйОтбор(ПользовательскийОтбор, "СтатусОбеспечения", ЗаказПокупателяОтборПоСтатусуОбеспечения);
	
	СтруктураНастроек = Новый Структура;	
	СтруктураНастроек.Вставить("НастройкиОтбораЗП",  Новый ХранилищеЗначения(ПользовательскийОтбор));
	
	ОбщегоНазначения.ХранилищеОбщихНастроекСохранить("РабочееМестоСотрудникаСклада", "НастройкиФормыСписка", СтруктураНастроек);
	
КонецПроцедуры

&НаСервере
Процедура ВосстановитьНастройкиФормы()

	СтруктураНастроек = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить("РабочееМестоСотрудникаСклада", "НастройкиФормыСписка");
	
	Если НЕ ТипЗнч(СтруктураНастроек) = Тип("Структура") Тогда
		Возврат;	
	КонецЕсли;
	
	ПользовательскийОтбор = СтруктураНастроек.НастройкиОтбораЗП.Получить();	
	
	МассивРеквизитовСтатусыСборки = ПолучитьМассивРеквизитовСтатусыСборки();
	МассивРеквизитовСтатусыЗаказа = ПолучитьМассивРеквизитовСтатусыЗаказа(ИспользоватьСтатусЗакрытВЗаказеПокупателя); // №14078
	МассивРеквизитовСтатусыобеспечения = Новый Массив;
	МассивРеквизитовСтатусыобеспечения.Добавить("Не обеспечен");
	МассивРеквизитовСтатусыобеспечения.Добавить("Обеспечен");
	
	Для Каждого НастройкаОтбора Из ПользовательскийОтбор.Элементы Цикл
		
		// Статусы Обеспечения
		Если НастройкаОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("СтатусОбеспечения") Тогда
			
			Для Каждого ЭлементСписка Из НастройкаОтбора.ПравоеЗначение Цикл
				
				Если НЕ МассивРеквизитовСтатусыобеспечения.Найти(ЭлементСписка.Значение) = Неопределено Тогда
					
					ЗаказПокупателяОтборПоСтатусуОбеспечения.Добавить(ЭлементСписка.Значение);
					
					Если ЭлементСписка.Значение = "Не обеспечен" Тогда
						Элементы["СписокЗаказыПокупателейОтборСтатус" + "НеОбеспечен"].Пометка = Истина;
					ИначеЕсли ЭлементСписка.Значение = "Обеспечен" Тогда	
					    Элементы["СписокЗаказыПокупателейОтборСтатус" + "Обеспечен"].Пометка = Истина;
					КонецЕсли;	
				КонецЕсли;
				
			КонецЦикла;

		КонецЕсли;
		
		// Статусы сборки
		Если НастройкаОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("СтатусСборки") Тогда
			
			Для Каждого ЭлементСписка Из НастройкаОтбора.ПравоеЗначение Цикл
				
				Если НЕ МассивРеквизитовСтатусыСборки.Найти(ЭлементСписка.Значение.ИмяПредопределенныхДанных) = Неопределено Тогда
					
					ЗаказПокупателяОтборПоСтатусуСборки.Добавить(ЭлементСписка.Значение);
					
					Элементы["СписокЗаказыПокупателейОтборСтатус" + ЭлементСписка.Значение.ИмяПредопределенныхДанных].Пометка = Истина;
					
				ИначеЕсли ЭлементСписка.Значение = Справочники.СтатусыСборкиЗаказов.ПустаяСсылка() Тогда
					
					ЗаказПокупателяОтборПоСтатусуСборки.Добавить(ЭлементСписка.Значение);
					
					Элементы["СписокЗаказыПокупателейОтборСтатусНеУказан"].Пометка = Истина;
					
				КонецЕсли;
				
			КонецЦикла;

		КонецЕсли;
		
		//++ №14078 статусы заказа
		Если НастройкаОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ТекущийСтатус") Тогда
			
			Для Каждого ЭлементСписка Из НастройкаОтбора.ПравоеЗначение Цикл
				
				Если НЕ МассивРеквизитовСтатусыЗаказа.Найти(ЭлементСписка.Значение.ИмяПредопределенныхДанных) = Неопределено Тогда
					
					ЗаказПокупателяОтборПоТекущемуСтатусу.Добавить(ЭлементСписка.Значение);
					
					Элементы["ОтборСтатусЗаказа" + ЭлементСписка.Значение.ИмяПредопределенныхДанных].Пометка = Истина;
					
				КонецЕсли;
				
			КонецЦикла;

		КонецЕсли;
		//-- №14078
		
	КонецЦикла;
	
КонецПроцедуры 
