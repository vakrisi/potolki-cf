Процедура ОтборСтатусЗаказа()
	
	МассивРеквизитов = ПолучитьМассивРеквизитовСтатусыЗаказа(ИспользоватьСтатусЗакрытВЗаказеПокупателя);
	
	ЗаказПокупателяОтборПоТекущемуСтатусу.Очистить();
	
	Для каждого ИмяРеквизита Из МассивРеквизитов Цикл
		
		Если Элементы["ОтборСтатусЗаказа" + ИмяРеквизита].Пометка Тогда
			
			ЗаказПокупателяОтборПоТекущемуСтатусу.Добавить(ПредопределенноеЗначение("Справочник.СтатусыЗаказовПокупателей." + ИмяРеквизита));
			
		КонецЕсли;
		
	КонецЦикла;
	
	УстановитьОтборЗаказовПокупателей();
	
КонецПроцедуры

