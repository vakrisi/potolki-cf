Функция ПолучитьМассивРеквизитовСтатусыСборки()
	
	МассивРеквизитов = новый Массив;
	МассивРеквизитов.Добавить("НеУказан");
	МассивРеквизитов.Добавить("ВыполнитьСборку");
	МассивРеквизитов.Добавить("СобранЧастично");
	МассивРеквизитов.Добавить("СобранПолностью");
	
	Возврат МассивРеквизитов;
	
