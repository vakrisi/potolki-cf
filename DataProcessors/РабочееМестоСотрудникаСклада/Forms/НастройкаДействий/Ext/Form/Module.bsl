&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	УстановитьУсловноеОформление();
	
	// #14908
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ИспользоватьСтатусыСборки", ПолучитьФункциональнуюОпцию("ИспользоватьСтатусыСборкиЗаказовПокупателей"));
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ДанныеСправочника.Ссылка КАК Действие,
	|	ДанныеСправочника.Наименование КАК ДействиеПредставление,
	|	ДанныеСправочника.Доступно КАК Доступно,
	|	ДанныеСправочника.ТребуетсяУказатьСотрудника КАК ТребуетсяУказатьСотрудника,
	|	ДанныеСправочника.ЭтапОтображения КАК ЭтапОтображения,
	|	ДанныеСправочника.ПояснениеДействия КАК ПояснениеДействия
	|ИЗ
	|	Справочник.ДействияВРабочемМестеРаботникаСклада КАК ДанныеСправочника
	|ГДЕ
	|	НЕ ДанныеСправочника.ПометкаУдаления
	|	И ВЫБОР
	|			КОГДА &ИспользоватьСтатусыСборки
	|				ТОГДА НЕ ДанныеСправочника.Ссылка В (ЗНАЧЕНИЕ(Справочник.ДействияВРабочемМестеРаботникаСклада.ЗаказПокупателяИзменитьСборщика))
	|			ИНАЧЕ НЕ ДанныеСправочника.Ссылка В (ЗНАЧЕНИЕ(Справочник.ДействияВРабочемМестеРаботникаСклада.ЗаказПокупателяСобранЧастично), ЗНАЧЕНИЕ(Справочник.ДействияВРабочемМестеРаботникаСклада.ЗаказПокупателяСобранПолностью))
	|		КОНЕЦ
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДанныеСправочника.РеквизитДопУпорядочивания";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = НастройкаАРМСклада.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	УсловноеОформление.Элементы.Очистить();	
	
	//#14908
	Элемент = УсловноеОформление.Элементы.Добавить();

	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.НастройкаАРМСкладаТребуетсяУказатьСотрудника.Имя);

	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("НастройкаАРМСклада.ЭтапОтображения");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Перечисления.ЭтапыОтображенияДействияВРабочемМестеСотрудникаСклада.ПослеСканированияШКСотрудника;

	Элемент.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
	Элемент.Оформление.УстановитьЗначениеПараметра("Доступность", Ложь);

КонецПроцедуры

&НаКлиенте
Процедура НастройкаАРМСкладаДоступноПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.НастройкаАРМСклада.ТекущиеДанные;
	ЗаписатьРеквизитДействияАРМСклада(ТекущиеДанные.Действие, "Доступно", ТекущиеДанные.Доступно);
	
КонецПроцедуры

&НаКлиенте
Процедура НастройкаАРМСкладаТребуетсяУказатьСотрудникаПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.НастройкаАРМСклада.ТекущиеДанные;
	ЗаписатьРеквизитДействияАРМСклада(ТекущиеДанные.Действие, "ТребуетсяУказатьСотрудника", ТекущиеДанные.ТребуетсяУказатьСотрудника);
	
КонецПроцедуры

&НаКлиенте
Процедура НастройкаАРМСкладаЭтапОтображенияПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.НастройкаАРМСклада.ТекущиеДанные;
	ЗаписатьРеквизитДействияАРМСклада(ТекущиеДанные.Действие, "ЭтапОтображения", ТекущиеДанные.ЭтапОтображения);
	
	Если ТекущиеДанные.ЭтапОтображения = ПредопределенноеЗначение("Перечисление.ЭтапыОтображенияДействияВРабочемМестеСотрудникаСклада.ПослеСканированияШКСотрудника") Тогда
		ТекущиеДанные.ТребуетсяУказатьСотрудника = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ЗаписатьРеквизитДействияАРМСклада(ДействиеСсылка, ИмяРеквизита, ЗначениеРеквизита)
	
	СпрОбъект = ДействиеСсылка.ПолучитьОбъект();
	СпрОбъект[ИмяРеквизита] = ЗначениеРеквизита;
	Попытка
		СпрОбъект.Записать();
	Исключение
		Сообщить(ОписаниеОшибки());	
	КонецПопытки;
	
КонецПроцедуры

