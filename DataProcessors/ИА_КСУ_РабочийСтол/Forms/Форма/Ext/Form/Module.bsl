&НаКлиенте
Процедура ПланировщикНеделяПриОкончанииРедактирования(Элемент, НовыйЭлемент, ОтменаРедактирования)
	ОтменаРедактирования = истина;
	
	Текстрока = Элемент.ВыделенныеЭлементы[0];
	текЗадача = Текстрока.Значение;
	Начало = НачалоДня(Текстрока.Начало);
	Конец = Начало + 60*60*24*7 -1 ;
	ЕстьПлан = ЕстьПлан(ПланировщикНеделя,Начало,Конец, текЗадача);
	
	Если ЕстьПлан ТОгда
		ПеренестиЗадачуВНедельныйПлан(текЗадача, Начало, Конец);
	Иначе
		//ПоказатьВопрос(Новый ОписаниеОповещения("ПланировщикНеделяПередСозданиемЗавершение", ЭтаФорма, новый Структура("Начало, Конец",Начало, Конец)), "Сначала необходимо создать план. Создать?",РежимДиалогаВопрос.ДаНет);	
		Сообщить("Сначала создайте недельный план");
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ПеренестиЗадачуВНедельныйПлан(Задача, Начало, Конец)
	Владелец = ПолучитьНедельныйПлан(Начало);
	Если не ЗначениеЗаполнено(Владелец) Тогда
		возврат;
	КонецЕсли;
	
	НовЗадача = Задача.Скопировать();
	НовЗадача.Владелец = Владелец;
	НовЗадача.Выполнено = ложь;
	НовЗадача.Выполнено = ложь;
	НовЗадача.ВремяФакт = Дата(1,1,1);
	НовЗадача.записать();
	
	ОбновитьНедельныеПланы();
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьНедельныйПлан(Начало)
	Запрос = Новый Запрос;
	ИА_Планы.ЗаполнитьТаблицуПлановВЗапросе(Запрос,начало,начало);	
	Запрос.Текст = "ВЫБРАТЬ
	               |	ИА_ПланыДействий.План
	               |ИЗ
	               |	НедельныеПланы КАК ИА_ПланыДействий";
	Выборка = Запрос.Выполнить().Выбрать();
	Если выборка.Следующий() Тогда
		возврат выборка.План;
	Иначе
		возврат Неопределено;
	КонецЕсли;
КонецФункции
	
