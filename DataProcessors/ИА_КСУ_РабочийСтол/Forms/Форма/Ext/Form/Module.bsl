&НаКлиенте
Процедура ПолеГлСтатистикаПриНажатии(Элемент, ДанныеСобытия, СтандартнаяОбработка)
	Если ДанныеХТМЛ_ГлавнаяСтатистика = "" Тогда
		возврат;
	КонецЕсли;
	
	Попытка
		событие = Элементы.ПолеГлСтатистика.Документ.parentWindow.CurEvent;
		НомерЭл = Элементы.ПолеГлСтатистика.Документ.parentWindow.CurEventSource;
	Исключение
		событие = Элементы.ПолеГлСтатистика.Документ.window.CurEvent;
		НомерЭл = Элементы.ПолеГлСтатистика.Документ.window.CurEventSource;
	КонецПопытки;
	
	
	Если событие<>"" Тогда
		Если событие = "report" Тогда
			ФормаСтатистик.ВывестиРасшифровку(НомерЭл);
		ИначеЕсли событие = "add" Тогда
			ФормаСтатистик.ДобавитьЗначение(НомерЭл, истина);
			ОбновитьМоиСтатистики();
		КонецЕсли;
		
		
		Попытка
			Элементы.ПолеГлСтатистика.Документ.parentWindow.setCurEvent("","");
		Исключение
			Элементы.ПолеГлСтатистика.Документ.window.setCurEvent("","");
		КонецПопытки;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаВходящиеВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	
	Попытка
		ТекСсылка = Элемент.ТекущиеДанные.Ссылка
	Исключение
		возврат;
	КонецПопытки;
	
	Если ТипЗнч(ТекСсылка) = Тип("ЗадачаСсылка.ИА_ЗадачаПланаДействий") Тогда
		Парам = Новый Структура;
		Парам.Вставить("Ключ",ТекСсылка);
		Парам.Вставить("НазваниеТаблицы",Элемент.Имя);
		ОткрытьФорму("Задача.ИА_ЗадачаПланаДействий.ФормаОбъекта",Парам);
	Иначе
		имяФормыОб = ПолучитьИмяФормы(ТекСсылка);
		парам = Новый Структура("Ключ", ТекСсылка);
		формаОб = ОткрытьФорму(имяФормыОб,парам); 
		
		формыЗадач.Добавить(формаОб);
	КонецЕсли;

КонецПроцедуры

