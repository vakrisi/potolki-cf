			Иначе
				данные = новый Структура("Группировка,Выполнено,гугл,СрокИсполнения", эл.Значение.Группировка, эл.Значение.Выполнено, ложь,эл.Значение.СрокИсполнения);
			КонецЕсли;
			ИА_Планы.ПрименитьОформлениеСтроки(данные, эл);			
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

