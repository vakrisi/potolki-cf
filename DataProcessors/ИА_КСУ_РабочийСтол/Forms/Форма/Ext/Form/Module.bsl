&НаКлиенте
Процедура ДеревоКорзинПриАктивизацииСтроки(Элемент)
	тд = Элементы.ДеревоКорзин.ТекущиеДанные;
	
	Если тд = Неопределено Тогда
		возврат;
	КонецЕсли;
	
	текКорзина = тд.Корзина;
	ОтборКорзина = Неопределено;
	Если тд.ПолучитьРодителя()<>Неопределено Тогда
		ОтборКорзина = текКорзина;
		текКорзина = тд.ПолучитьРодителя().Корзина;
	КонецЕсли;
	
	ИмяСтрКорзины = СтрЗаменить(текКорзина," ","");
	Элементы.ГруппаКоммцентр.ТекущаяСтраница = Элементы[ИмяСтрКорзины];
	Если текКорзина = ПредопределенноеЗначение("Справочник.ИА_РасширенияКомцентра.Входящие") ИЛИ текКорзина = ПредопределенноеЗначение("Справочник.ИА_РасширенияКомцентра.ВРаботе")
		ИЛИ текКорзина = ПредопределенноеЗначение("Справочник.ИА_РасширенияКомцентра.Исходящие") Тогда
		
		Если тд.ПолучитьРодителя() = Неопределено И ИА_НастройкиСПИ.ЗначениеНастройки(ТекПользователь, ПредопределенноеЗначение("ПланВидовХарактеристик.ИА_НастройкиПользователей.СкрытьЗадачиРаспределенныеВГруппы")) Тогда
			ОтборКорзина = ПредопределенноеЗначение("Справочник.ИА_ГруппыКЦ.ПустаяСсылка");
		КонецЕсли;

		ЭтаФорма["Задачи" + ИмяСтрКорзины].Параметры.УстановитьЗначениеПараметра("ОтборГруппа", ОтборКорзина);
		ОбновитьКорзину(ИмяСтрКорзины);		
	КонецЕсли;
	
	ТаблицаПриАктивизацииСтроки(Элементы["Таблица"+ИмяСтрКорзины]);
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаПриАктивизацииСтроки(Элемент)
	тд = Элемент.ТекущиеДанные;
	
	Если тд<>Неопределено Тогда
		НетСсылки = не тд.Свойство("ссылка");
		Если (НетСсылки ИЛИ тд.ссылка = ПредВыбЗадача) Тогда
			Если НетСсылки Тогда
				Предпросмотр = новый ТабличныйДокумент;
				ПредВыбЗадача = ПредопределенноеЗначение("Задача.ИА_ЗадачаПланаДействий.ПустаяСсылка");
			КонецЕсли;
			возврат;
		КонецЕсли;
	КонецЕсли;
	
	Если Элементы.Предпросмотр.Видимость Тогда
		СтруктПредставления = Новый Структура("Ссылка,Дата,Наименование,Автор,Пользователь,Пост");
		Если тд <> Неопределено Тогда
			ЗаполнитьЗначенияСвойств(СтруктПредставления, тд);
		КонецЕсли;
		
		#ЕСЛИ ВебКлиент Тогда
			ВывестиПредставление(СтруктПредставления, СоотвИДпользователей);
		#ИНАЧЕ
			табДок = ПолучитьПредставление(СтруктПредставления,Взаимодействия1с, СоотвИДпользователей);  
			Предпросмотр = табДок;
		#КОНЕЦЕСЛИ
		
		Если тд = Неопределено Тогда
			возврат;
		КонецЕсли;
		
		Обл = Предпросмотр.Область("R1C1");
		Элементы.Предпросмотр.ТекущаяОбласть = Обл;
	КонецЕсли;
	
	Если тд = Неопределено Тогда
		возврат;
	Иначе
		ПредВыбЗадача = тд.ссылка;
	КонецЕсли;
		
	Если Элемент = Элементы.ТаблицаВходящие и тд.Свойство("Ссылка") Тогда
		Если УбратьПризнакНовой(тд.Ссылка, ТекПользователь)	Тогда
			Элемент.обновить();
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ВывестиПредставление(СтруктПредставления, СоотвИДпользователей)
	табДок = ПолучитьПредставление(СтруктПредставления,Взаимодействия1с, СоотвИДпользователей);  
	Предпросмотр.Очистить();
	Предпросмотр.Вывести(табДок);
КонецПроцедуры

&НаСервереБезКонтекста
Функция УбратьПризнакНовой(задача, Пользователь)
	мен = РегистрыСведений.ИА_НовыеЗадачи.СоздатьМенеджерЗаписи();
	мен.Пользователь = Пользователь; 
	мен.Задача = задача;
	мен.Прочитать();
	
	Если мен.Выбран() Тогда
		мен.Удалить();
		возврат Истина;
	Иначе
		Возврат ложь;
	КонецЕсли;
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьПредставление(данные,Взаимодействия1с,СоотвИДпользователей)
	
	Предпросмотр = новый ТабличныйДокумент;
	Если данные.ссылка = Неопределено Тогда
		возврат Предпросмотр;
	КонецЕсли;
	
	макет = Обработки.ИА_КСУ_РабочийСтол.ПолучитьМакет("ПредставлениеЗадачи");
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	ИА_ЗадачаПланаДействий.Ссылка,	               
	               |	ИА_ЗадачаПланаДействий.Номер,
	               |	ИА_ЗадачаПланаДействий.Дата,
	               |	ИА_ЗадачаПланаДействий.Наименование,
	               |	ИА_ЗадачаПланаДействий.Содержание,
	               |	ИА_ЗадачаПланаДействий.Исполнитель,	               
	               |	ИА_ЗадачаПланаДействий.ДатаВыполнения,
	               |	ИА_ЗадачаПланаДействий.Автор,	               
	               |	ИА_ЗадачаПланаДействий.ЭтоПослание,
	               |	ИА_ЗадачаПланаДействий.ПостАвтора,
	               |	ИА_ЗадачаПланаДействий.ЭтоЗРС,
	               |	ИА_ЗадачаПланаДействий.Ситуация,
	               |	ИА_ЗадачаПланаДействий.Данные,
	               |	ИА_ЗадачаПланаДействий.ПрикрепленныйОбъект,
	               |	ИА_ЗадачаПланаДействий.ИсполнительЗРС,
	               |	ИА_ЗадачаПланаДействий.СодержаниеТекст,
	               |	ИА_ЗадачаПланаДействий.СитуацияТекст,
	               |	ИА_ЗадачаПланаДействий.ДанныеТекст,
	               |	ИА_ЗадачаПланаДействий.ДокладОбИсполнении,	               
	               |	ИА_ЗадачаПланаДействий.Пользователь,
	               |	ИА_ЗадачаПланаДействий.Пост,
	               |	ИА_ЗадачаПланаДействий.ХодВыполнения.(
	               |		Ссылка,
	               |		НомерСтроки,
	               |		Дата,
	               |		Пользователь,
	               |		Комментарий,
	               |		ЭтоКомментарий
	               |	)
	               |ИЗ
	               |	Задача.ИА_ЗадачаПланаДействий КАК ИА_ЗадачаПланаДействий
	               |ГДЕ
	               |	ИА_ЗадачаПланаДействий.Ссылка = &Ссылка";
				   
	Запрос.УстановитьПараметр("Ссылка", данные.Ссылка);				   
	Выборка = Запрос.Выполнить().Выбрать();
	ЭтоЗадача = Выборка.Следующий();
	
	// шапка
	ОблШапка = Макет.ПолучитьОбласть("Шапка");
	ЗаполнитьЗначенияСвойств(ОблШапка.Параметры, данные);	
	Автор = данные.Автор;
	Если (не ЗначениеЗаполнено(Автор) ИЛИ не ЗначениеЗаполнено(ОблШапка.Параметры.Дата)) и ЭтоЗадача ТОгда
		ЗаполнитьЗначенияСвойств(ОблШапка.Параметры, Выборка);	
		Автор = Выборка.Автор;
	КонецЕсли;
	Фото = РегистрыСведений.ИА_ДанныеФизЛиц.ПолучитьФотоПользователя(Автор,"Аватар");
	Если Фото <> Неопределено Тогда
		ОблШапка.Рисунки[0].Картинка = Новый Картинка(Фото,истина);
	КонецЕсли;
	Предпросмотр.Вывести(ОблШапка);
	
	
	Если ТипЗнч(данные.Ссылка) <> Тип("ЗадачаСсылка.ИА_ЗадачаПланаДействий") Тогда
		возврат Предпросмотр;
	КонецЕсли;
	
	// содержание
	ОблСод = Макет.ПолучитьОбласть("Содержание");
	ОблСод.Параметры.Текст = Выборка.Содержание;
	ОблСод.Параметры.Заголовок = "Содержание задачи:";	
	
	Если Выборка.ЭтоПослание Тогда
		ОблСод.Параметры.Заголовок = "Содержание послания:";	
	ИначеЕсли Выборка.ЭтоЗРС Тогда
		ОблСод.Параметры.Заголовок = "Ситуация:";	
		ОблСод.Параметры.Текст = Выборка.Ситуация;
	КонецЕсли;
	Предпросмотр.Вывести(ОблСод);
	
	Если Выборка.ЭтоЗРС Тогда
		ОблСод.Параметры.Заголовок = "Данные:";	
		ОблСод.Параметры.Текст = Выборка.Данные;		
		Предпросмотр.Вывести(ОблСод);
		
		ОблСод.Параметры.Заголовок = "Решение:";	
		ОблСод.Параметры.Текст = Выборка.Содержание;		
		Предпросмотр.Вывести(ОблСод);
	КонецЕсли;
	
	Если Выборка.ДокладОбИсполнении <> "" Тогда
		ОблСод.Параметры.Заголовок = "Доклад об исполнении:";	
		ОблСод.Параметры.Текст = Выборка.ДокладОбИсполнении;		
		Предпросмотр.Вывести(ОблСод);
	КонецЕсли;
	
	// лента
	Если не Выборка.ЭтоПослание Тогда
		
		Если Взаимодействия1с Тогда
			ход = ИА_ОбщиеПроцедуры_Технология_КоммЦентр.ПолучитьТЗСообщенийОбсужденийзадачи(данные.Ссылка,СоотвИДпользователей); 
			Если ход = Неопределено Тогда
				возврат Предпросмотр;
			КонецЕсли;
		Иначе
			ход = Выборка.ХодВыполнения.Выгрузить();
		КонецЕсли;
		
		ход.Сортировать("Дата УБЫВ");
		Если ход.Количество()>0 Тогда
			Обл1 = Макет.ПолучитьОбласть("Лента");
			Предпросмотр.Вывести(Обл1);
			
			Для каждого стр из ход Цикл
				Обл1 = Макет.ПолучитьОбласть("Ход");
				ЗаполнитьЗначенияСвойств(Обл1.Параметры, стр);	
				Фото = РегистрыСведений.ИА_ДанныеФизЛиц.ПолучитьФотоПользователя(стр.Пользователь,"Аватар");
				Если Фото <> Неопределено Тогда				
					Обл1.Рисунки[0].Картинка = Новый Картинка(Фото,истина);
				КонецЕсли;
				Предпросмотр.Вывести(Обл1);
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	
	возврат Предпросмотр;
	
КонецФункции

&НаКлиенте
Процедура ДеревоКорзинПроверкаПеретаскивания(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка, Строка, Поле)
	СтандартнаяОбработка = Ложь;
	ПараметрыПеретаскивания.Действие = ДействиеПеретаскивания.Отмена;
	
	Если ЗначениеЗаполнено(Строка) И ТипЗнч(ПараметрыПеретаскивания.Значение) = Тип("Структура") и ПараметрыПеретаскивания.Значение.Свойство("ЭтоЗадача") Тогда
		СтрокаКорз = ДеревоКорзин.НайтиПоИдентификатору(Строка);
		СтрокаРод = строкаКорз.ПолучитьРодителя();
		Если СтрокаРод <> Неопределено Тогда
			Если ЗадачаВКорзине(ПараметрыПеретаскивания.Значение.Задача, СтрокаРод.корзина, ТекПользователь) Тогда
				ПараметрыПеретаскивания.Действие = ДействиеПеретаскивания.Перемещение;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

