&НаКлиенте
Процедура ПланировщикДеньВыбор(Элемент, СтандартнаяОбработка)
	СтандартнаяОбработка = ложь;
	Если Элементы.ПланировщикДень.ВыделенныеЭлементы.Количество() > 0 Тогда		
		задача = Элементы.ПланировщикДень.ВыделенныеЭлементы[0].Значение;
		Если ТипЗнч(задача) = тип("Строка") Тогда // гугл
			возврат;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(задача) Тогда
			план = ПолучитьПланЗадачи(задача);
			
			Оп = Новый ОписаниеОповещения("ЗакрытиеДневногоПлана", ЭтаФорма, план);
			ОткрытьФорму("Справочник.ИА_ПланыДействий.ФормаОбъекта",новый структура("Ключ", План),,,,,Оп);
		КонецЕсли;		
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПланировщикДеньПриОкончанииРедактирования(Элемент, НовыйЭлемент, ОтменаРедактирования)
	Если НовыйЭлемент Тогда
		ОтменаРедактирования = истина;
	Иначе	
		Если Элемент.ВыделенныеЭлементы.Количество() = 1 Тогда
			ТекЭлем = Элемент.ВыделенныеЭлементы[0];
			Если ЗначениеЗаполнено(ТекЭлем.Значение) Тогда
				Если ТипЗнч(ТекЭлем.Значение) = тип("Строка") Тогда // гугл
					ОтменаРедактирования = истина;
					Возврат;
				КонецЕсли;

				Допуск = 60*15;
				// исправим наложения блоков друг на друга
				для каждого стрЭл из ПланировщикДень.Элементы Цикл
					Если стрЭл <> ТекЭлем и НачалоДня(стрЭл.Начало) = НачалоДня(ТекЭлем.Начало) Тогда
						В_Дельта = ИА_Планы_Клиент.ВремяВЧисло(стрЭл.Конец) - ИА_Планы_Клиент.ВремяВЧисло(ТекЭлем.Начало);
						если В_Дельта > 0 И В_Дельта < Допуск И (ТекЭлем.Начало + В_Дельта) < ТекЭлем.Конец-Допуск Тогда
							ТекЭлем.Начало = ТекЭлем.Начало + В_Дельта;
						КонецЕсли;
						
						Н_Дельта = ИА_Планы_Клиент.ВремяВЧисло(ТекЭлем.Конец) - ИА_Планы_Клиент.ВремяВЧисло(стрЭл.Начало);
						если Н_Дельта > 0 И Н_Дельта < Допуск И (ТекЭлем.Конец - Н_Дельта) < ТекЭлем.НАчало + Допуск Тогда
							ТекЭлем.Конец = ТекЭлем.Конец - Н_Дельта;
						КонецЕсли;
					КонецЕсли;
				КонецЦикла;
				//
				ДнПлан = Неопределено;
				Если ИзмененияВОдномДне(ТекЭлем.Значение,ТекЭлем.Начало) Тогда
					ЗаписатьИзмененияЗадачи(Новый Структура("Задача, ВремяНачала, ВремяКонца",ТекЭлем.Значение,ТекЭлем.Начало, ТекЭлем.Конец),ОтменаРедактирования,ДнПлан);
				Иначе
					ОтменаРедактирования = истина;
					ДнПлан = ПолучитьДневнойПлан(НачалоДня(ТекЭлем.Начало), ТекЭлем.Значение);
					
					Если ДнПлан = Неопределено Тогда
						НедПлан = ПолучитьНедельныйПлан(ДатаНачалаДневныхПланов);
						Оп = Новый ОписаниеОповещения("ЗакрытиеДневногоПлана", ЭтаФорма, НедПлан);		
						парам = Новый Структура("Родитель,ДатаДневногоПлана,ЗадачаОснование", НедПлан,НачалоДня(ТекЭлем.Начало),ТекЭлем.Значение);
						ОткрытьФорму("Справочник.ИА_ПланыДействий.ФормаОбъекта",парам,,,,,Оп);
					Иначе
						ЗаписатьИзмененияЗадачи(Новый Структура("Задача, ВремяНачала, ВремяКонца",ТекЭлем.Значение,ТекЭлем.Начало, ТекЭлем.Конец),ОтменаРедактирования,ДнПлан);
						ОбновитьДневныеПланы();
					КонецЕсли;
				КонецЕсли;
				
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаСервереБезКонтекста
Функция ИзмененияВОдномДне(задача,ВремяНачала)
	Возврат задача.Владелец.ДатаНачала = НачалоДня(ВремяНачала);
КонецФункции

&НаСервереБезКонтекста
Процедура ЗаписатьИзмененияЗадачи(данные,ОтменаРедактирования,ДнПлан)
	Если ДнПлан = Неопределено Тогда // изменения в рамках одного дневного плана
		об = данные.задача.ПолучитьОбъект();
		об.ВремяНачала = данные.ВремяНачала - ИА_Планы.ВремяВЧисло(НачалоДня(данные.ВремяНачала));
		об.ВремяКонца = данные.ВремяКонца - ИА_Планы.ВремяВЧисло(НачалоДня(данные.ВремяКонца));
		об.ВремяФакт = об.ВремяКонца - ИА_Планы.ВремяВЧисло(об.ВремяНачала);

		об.записать();
	Иначе
		об = данные.задача.Скопировать();
		об.Выполнено = ложь;
		об.владелец = ДнПлан;
		об.ВремяНачала = данные.ВремяНачала;
		об.ВремяКонца = данные.ВремяКонца;
		об.Записать();
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ВыполнитьДневнуюЗадачуСервер(пЗадача)
	об = пЗадача.получитьОБъект();
	об.Выполнено = не об.Выполнено;
