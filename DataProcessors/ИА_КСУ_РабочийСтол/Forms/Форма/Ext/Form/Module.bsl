&НаКлиенте
Процедура ДневникПеретаскивание(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка, Строка, Поле)
	СтандартнаяОбработка = Ложь;
	ПараметрыПеретаскивания.Действие = ДействиеПеретаскивания.Копирование;
	МассивВыбора = ПараметрыПеретаскивания.Значение;
	Если ТипЗнч(МассивВыбора) = Тип("Массив") или ТипЗнч(МассивВыбора) = Тип("ФиксированныйМассив") Тогда
		Выбор = МассивВыбора[0];
	Иначе
		Выбор = МассивВыбора;
	КонецЕсли;

	Если ТипЗнч(Выбор) = тип("ЭлементПланировщика") и ЗначениеЗаполнено(Выбор.значение) Тогда
		Если типзнч(Выбор.значение) = тип("Строка") Тогда
			предст = Выбор.значение;
		Иначе
			предст = ПолучитьСодержаниеЗадачи(Выбор.значение);
		КонецЕсли;
		ДобавитьСтрокуВДневникКлиент(предст);
	ИначеЕсли ТипЗнч(Выбор) = тип("Структура") Тогда
		предст = ПолучитьНаименованиеЗадачи(Выбор.Задача);
		ДобавитьСтрокуВДневникКлиент(предст);
	КонецЕсли;
	
КонецПроцедуры

