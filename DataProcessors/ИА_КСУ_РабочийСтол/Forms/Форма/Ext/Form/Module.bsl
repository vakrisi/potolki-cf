Процедура ПереместитьЗадачиВГруппу(пСсылки, пГруппа, Пользователь)
	Для каждого стрСсылка из пСсылки Цикл 
		Набор = РегистрыСведений.ИА_ГруппыКЦ.СоздатьНаборЗаписей();
		Набор.Отбор.Пользователь.Установить(Пользователь);
		Набор.Отбор.Задача.Установить(стрСсылка);
		
		мен = Набор.Добавить();
		мен.Задача = стрСсылка;
		мен.Группа = пГруппа;
		мен.Пользователь = Пользователь;
		Набор.Записать(истина);
	КонецЦикла;
