Процедура СоздатьНетиповуюЗадачу(Команда)
	индТипа = число(СтрЗаменить(Команда.Имя,"КомандаНетиповойЗадач",""));
	ТипЗадачи = ТипыЗадачСписок[индТипа].Значение;
	
	м = Новый массив;
	м.Добавить(ТипЗадачи);
	
	ОпТипа = Новый ОписаниеТипов(м);
	ПустаяСсылка = ОпТипа.ПривестиЗначение();
	имяФормыОб = ПолучитьИмяФормы(ПустаяСсылка);
