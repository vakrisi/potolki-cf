Процедура ВыполнитьДневнуюЗадачу()
	
	для каждого эл из Элементы.ПланировщикДень.ВыделенныеЭлементы цикл
		Если ЗначениеЗаполнено(эл.Значение) Тогда
			Если ТипЗнч(эл.Значение) = тип("Строка") ТОгда
				ПоказатьПредупреждение(,"События google нельзя выполнить. Только удалить.");
				Продолжить;
			Иначе
				ВыполнитьДневнуюЗадачуСервер(эл.Значение);			
				ИА_Планы_Клиент.ЗавершитьЗадачуОснование(эл.Значение);		
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	ОбновитьОформлениеДневныхЗадач();
	
КонецПроцедуры



