	РазвернутьСтатистики_сервер();
	
КонецПроцедуры

&НаСервере
Процедура РазвернутьСтатистики_сервер()	
	Если Элементы.РазвернутьСтатистики.Пометка Тогда
		Элементы.Переместить(Элементы.ГруппаПланы, Элементы.ГруппаКЦ_Стат_Пл);
	Иначе
		Элементы.Переместить(Элементы.ГруппаПланы, ЭтаФорма);
	КонецЕсли;
КонецПроцедуры


&НаКлиенте
Процедура РазвернутьПланы(Команда)
	Если Элементы.РазвернутьСтатистики.Пометка Тогда
		Элементы.РазвернутьСтатистики.Пометка = ложь;
		РазвернутьСтатистики_сервер();
	КонецЕсли;
	
	Элементы.РазвернутьПланы.Пометка = не Элементы.РазвернутьПланы.Пометка;
	РазвПл = Элементы.РазвернутьПланы.Пометка;
	Элементы.ГруппаМоиСтат.Видимость = не (РазвПл или Элементы.РазвернутьКЦ.Пометка);
	Элементы.ГруппаКЦ_Стат.Высота = ?(РазвПл, 15, 0);
	Элементы.ГруппаКЦ_Стат.РастягиватьПоВертикали = ?(РазвПл, ложь, Неопределено);
КонецПроцедуры


