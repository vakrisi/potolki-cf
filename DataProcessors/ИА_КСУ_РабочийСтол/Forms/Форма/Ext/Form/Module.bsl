		Если тд.Выполнено Тогда
			тд.ДатаВыполнения = ТекущаяДата();
		Иначе
			тд.ДатаВыполнения = Дата(1,1,1);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

