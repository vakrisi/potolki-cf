&НаСервере
Процедура ОбновитьПериодыПланов()
	НачалоНедели = Константы.ИА_НачалоНедели.Получить();
	
	текДата = ТекущаяДата();
	ДатаКонцаНедельныхПланов = ИА_Статистики.ИА_КонецНедели(текДата);
	ДатаНачалаНедельныхПланов = ДатаКонцаНедельныхПланов - 60*60*24*7+1;			
	
	ДневныеНачало = ДатаНачалаНедельныхПланов;
	ДневныеКонец = Конецдня(ДатаКонцаНедельныхПланов);
	
	Если РежимНедели = -1 Тогда
		ДатаНачалаНедельныхПланов = ДатаНачалаНедельныхПланов - 60*60*24*7;			
		ДневныеНачало = ДневныеНачало - 60*60*24*7;
		ДневныеКонец = ДневныеКонец - 60*60*24*7;
	КонецЕсли;
	
	Если РежимНедели > 0 Тогда
		ДатаКонцаНедельныхПланов = ДатаКонцаНедельныхПланов + 60*60*24*7*РежимНедели;			
		ДневныеНачало = ДневныеНачало + 60*60*24*7*РежимНедели;
		ДневныеКонец = ДневныеКонец + 60*60*24*7*РежимНедели;
	КонецЕсли;
		
	ПланировщикНеделя.ТекущиеПериодыОтображения.Очистить();
	ПланировщикНеделя.ТекущиеПериодыОтображения.Добавить(ДатаНачалаНедельныхПланов, КонецДня(ДатаКонцаНедельныхПланов));
	
	//
	
	ОбновитьДневныеПериоды(ДневныеНачало, ДневныеКонец);	
	ОбновитьДневныеПланы();
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьНедельныеПланы()
	Запрос = Новый Запрос;
	ИА_Планы.ЗаполнитьТаблицуПлановВЗапросе(Запрос,ДатаНачалаНедельныхПланов,ДатаКонцаНедельныхПланов);
	
	запрос.УстановитьПараметр("ТолькоНевып", Элементы.ТолькоНевыполненные.Пометка);
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	ИА_ЗадачиПлана.Ссылка КАК Ссылка,
	               |	ИА_ЗадачиПлана.ВерсияДанных КАК ВерсияДанных,
	               |	ИА_ЗадачиПлана.ПометкаУдаления КАК ПометкаУдаления,
	               |	ИА_ЗадачиПлана.Владелец КАК Владелец,
	               |	ИА_ЗадачиПлана.Код КАК Код,
	               |	ИА_ЗадачиПлана.Наименование КАК Наименование,
	               |	ИА_ЗадачиПлана.Группировка КАК Группировка,
	               |	ИА_ЗадачиПлана.Содержание КАК Содержание,
	               |	ИА_ЗадачиПлана.Продукт КАК Продукт,
	               |	ИА_ЗадачиПлана.СрокИсполнения КАК СрокИсполнения,
	               |	ИА_ЗадачиПлана.ВремяПлан КАК ВремяПлан,
	               |	ИА_ЗадачиПлана.ВремяФакт КАК ВремяФакт,
	               |	ИА_ЗадачиПлана.Выполнено КАК Выполнено,
	               |	ИА_ЗадачиПлана.Время КАК Время,
	               |	ИА_ЗадачиПлана.Предопределенный КАК Предопределенный,
	               |	ИА_ЗадачиПлана.ИмяПредопределенныхДанных КАК ИмяПредопределенныхДанных,
	               |	НедельныеПланы.ДатаНачала КАК ДатаНачала,
	               |	ЛОЖЬ КАК гугл
	               |ИЗ
	               |	Справочник.ИА_ЗадачиПлана КАК ИА_ЗадачиПлана
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ НедельныеПланы КАК НедельныеПланы
	               |		ПО (НедельныеПланы.План = ИА_ЗадачиПлана.Владелец)
	               |ГДЕ
	               |	ИА_ЗадачиПлана.ПометкаУдаления = ЛОЖЬ
	               |	И (ИА_ЗадачиПлана.Выполнено = ложь или &ТолькоНевып = ложь)
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ИА_ЗадачиПлана.Группировка.Порядок,
	               |	ИА_ЗадачиПлана.Порядок,
	               |	ИА_ЗадачиПлана.Код";
	
	ПланировщикНеделя.Элементы.Очистить();
	
	Выборка = Запрос.Выполнить().Выбрать();
	сч = 1;
	длительность1ед = 60*60;
	Пока Выборка.Следующий() Цикл
		ДатаНачала    = Выборка.ДатаНачала + сч * длительность1ед;
		ДатаОкончания = ДатаНачала + длительность1ед;
		НовыйЭлемент = ПланировщикНеделя.Элементы.Добавить(ДатаНачала, ДатаОкончания);
		
		Если ЗначениеЗаполнено(Выборка.ВремяФакт) Тогда
			НовыйЭлемент.Текст = Формат(Выборка.ВремяФакт,"ДФ=HH:mm")+ " ";
		ИначеЕсли ЗначениеЗаполнено(Выборка.ВремяПлан) Тогда
			НовыйЭлемент.Текст = Формат(Выборка.ВремяПлан,"ДФ=HH:mm")+ " ";
		КонецЕсли;
		НовыйЭлемент.Текст = НовыйЭлемент.Текст + Выборка.Содержание;
		Если ЗначениеЗаполнено(Выборка.Продукт) Тогда
			НовыйЭлемент.Текст = НовыйЭлемент.Текст + ". Продукт: "+ Выборка.Продукт;		
		КонецЕсли;
		
		НовыйЭлемент.Значение = выборка.ссылка;
		
		ИА_Планы.ПрименитьОформлениеСтроки(Выборка, НовыйЭлемент);
		
		
		сч = сч + 2;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция МоиПолучитьПосты()
	
	Польз = ПараметрыСеанса.ТекущийПользователь;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ИА_АдресацияЗадачПланаДействий.Пост,
	               |	ИА_АдресацияЗадачПланаДействий.Пост.ТипТерминала.Порядок КАК Порядок
	               |ИЗ
	               |	РегистрСведений.ИА_АдресацияЗадачПланаДействий КАК ИА_АдресацияЗадачПланаДействий
	               |ГДЕ
	               |	ИА_АдресацияЗадачПланаДействий.Пользователь = &Пользователь
	               |	И ИА_АдресацияЗадачПланаДействий.Пост.ПометкаУдаления = ЛОЖЬ
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ИА_АдресацияЗадачПланаДействий.Пост.ТипТерминала.Порядок";
	Запрос.УстановитьПараметр("Пользователь", польз);
	
	ТЗ = Запрос.Выполнить().Выгрузить();

	Если ТЗ.Количество() > 0 Тогда
		Возврат ТЗ.ВыгрузитьКолонку("Пост");
	Иначе
		Возврат новый Массив;
	КонецЕсли;
КонецФункции

