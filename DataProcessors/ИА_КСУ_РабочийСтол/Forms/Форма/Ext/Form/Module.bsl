&НаКлиенте
Процедура ПланировщикДеньПередСозданием(Элемент, Начало, Конец, Значения, Текст, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	
	ЕстьПлан = ЕстьПлан(ПланировщикДень,НачалоДня(Начало),КонецДня(Конец));
	Если не ЕстьПлан Тогда		
		ПоказатьВопрос(Новый ОписаниеОповещения("ПланировщикДеньПередСозданиемЗавершение", ЭтаФорма, новый Структура("Начало, Конец",Начало, Конец)), "Создать дневной план?",РежимДиалогаВопрос.ДаНет);
	Иначе
		План = ПолучитьДневнойПлан(НачалоДня(Начало),неопределено);//МРД_Вызов дневного плана из любого времени дня		
		Оп = Новый ОписаниеОповещения("ЗакрытиеДневногоПлана", ЭтаФорма, план);
		ОткрытьФорму("Справочник.ИА_ПланыДействий.ФормаОбъекта",новый структура("Ключ", План),,,,,Оп);
	КонецЕсли;
