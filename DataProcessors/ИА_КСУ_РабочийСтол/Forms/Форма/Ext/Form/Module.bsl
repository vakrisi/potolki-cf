Процедура ПланировщикДеньПередСозданиемЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		НедПлан = ПолучитьНедельныйПлан(ДатаНачалаДневныхПланов);
		Оп = Новый ОписаниеОповещения("ЗакрытиеДневногоПлана", ЭтаФорма, НедПлан);		
		парам = Новый Структура("Родитель,ДатаДневногоПлана", НедПлан,ДополнительныеПараметры.Начало);
		ОткрытьФорму("Справочник.ИА_ПланыДействий.ФормаОбъекта",парам,,,,,Оп);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ЗакрытиеДневногоПлана(Закрытие, ДопПарам) Экспорт
	ОбновитьДневныеПланы();
КонецПроцедуры

&НаКлиенте
Процедура ПланировщикДеньПеретаскивание(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка, Дата, Значения)
	СтандартнаяОбработка = ложь;
	ПараметрыПеретаскивания.Действие = ДействиеПеретаскивания.Копирование;
	МассивВыбора = ПараметрыПеретаскивания.Значение;
	Если ТипЗнч(МассивВыбора) = Тип("Массив") или ТипЗнч(МассивВыбора) = Тип("ФиксированныйМассив") Тогда
		Выбор = МассивВыбора[0];
	Иначе
		Выбор = МассивВыбора;
	КонецЕсли;
	
	ДневнойПлан = ПолучитьДневнойПлан(Дата);
	Если ТипЗнч(Выбор) = тип("ЭлементПланировщика") Тогда
		недельнаяЗадача = Выбор.Значение;
		Если ЗначениеЗаполнено(недельнаяЗадача) Тогда
			Если ДневнойПлан = Неопределено Тогда
				НедПлан = ПолучитьПланЗадачи(недельнаяЗадача);
				Оп = Новый ОписаниеОповещения("ЗакрытиеДневногоПлана", ЭтаФорма, НедПлан);		
				парам = Новый Структура("Родитель,ДатаДневногоПлана,ЗадачаОснование", НедПлан,Дата,недельнаяЗадача);
				ОткрытьФорму("Справочник.ИА_ПланыДействий.ФормаОбъекта",парам,,,,,Оп);
			Иначе
				ПеренестиЗадачуИзНедельногоВДневной(ДневнойПлан,недельнаяЗадача, дата);
			КонецЕсли;
		КонецЕсли;
	ИначеЕсли ТипЗнч(Выбор) = тип("Структура") Тогда
		Если ДневнойПлан = Неопределено Тогда
			НедПлан = ПолучитьНедельныйПлан(ДатаНачалаДневныхПланов);
			Если НедПлан = Неопределено Тогда
				сообщить("Сначала создайте недельный план!");
				возврат;
			КонецЕсли;
			
			Оп = Новый ОписаниеОповещения("ЗакрытиеДневногоПлана", ЭтаФорма, НедПлан);		
			парам = Новый Структура("Родитель,ДатаДневногоПлана,ЗадачаОснование", НедПлан,Дата,Выбор.Задача);
			ОткрытьФорму("Справочник.ИА_ПланыДействий.ФормаОбъекта",парам,,,,,Оп);
		Иначе
			ПеренестиЗадачуИзКЦВДневной(ДневнойПлан,Выбор.Задача, дата);
			ПодключитьОбработчикОжидания("ОбновитьКорзины",1,истина);
		Конецесли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьДневнойПлан(дата, ИсключаяЗадачу = Неопределено)
	для каждого эл из ПланировщикДень.Элементы Цикл
		если НачалоДня(эл.Начало) = НачалоДня(дата) и ИсключаяЗадачу<>эл.Значение и эл.Значение<>Неопределено И ТипЗнч(эл.значение)=тип("СправочникСсылка.ИА_ЗадачиПлана") Тогда
			возврат эл.значение.Владелец;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;	
КонецФункции

&НаСервере
Процедура ПеренестиЗадачуИзКЦВДневной(ДневнойПлан,ЗадачаКЦ, дата)
	Если ДневнойПлан <> Неопределено Тогда
		обЗадача = ЗадачаКЦ.получитьобъект();
		обЗадача.Отложена = истина;
		обЗадача.записать();		
		
		новЗадача = Справочники.ИА_ЗадачиПлана.СоздатьЭлемент();
		новЗадача.владелец = ДневнойПлан;
		новЗадача.ЗадачаОснование = ЗадачаКЦ;
		новЗадача.Пост = ЗадачаКЦ.Пост;
		Если новЗадача.Пост.Пустая() ТОгда
			новЗадача.Пост = ДневнойПлан.Пост;
		КонецЕсли;
		
		новЗадача.Группировка = Перечисления.ИА_ТипыЗадачБП.Задачи;
		новЗадача.Содержание = ЗадачаКЦ.Наименование;
		новЗадача.ВремяНачала = Дата - ИА_Планы.ВремяВЧисло(НачалоДня(Дата));
		новЗадача.ВремяКонца = новЗадача.ВремяНачала+ 60*60;
		новЗадача.ВремяПлан = Дата(1,1,1,1,0,0);
		новЗадача.ВремяФакт = Дата(1,1,1,0,0,0);
		новЗадача.Записать();
		
		ОбновитьДневныеПланы();
	КонецЕсли;
КонецПроцедуры


&НаСервере
Процедура ПеренестиЗадачуИзНедельногоВДневной(ДневнойПлан,недельнаяЗадача, дата)
	Если ДневнойПлан <> Неопределено Тогда
		новЗадача = недельнаяЗадача.Скопировать();
		новЗадача.Выполнено = ложь;
		новЗадача.владелец = ДневнойПлан;
		новЗадача.ВремяНачала = Дата - ИА_Планы.ВремяВЧисло(НачалоДня(Дата));
		новЗадача.ВремяКонца = новЗадача.ВремяНачала+ 60*60;
		новЗадача.ВремяПлан = Дата(1,1,1,1,0,0);
		новЗадача.ВремяФакт = Дата(1,1,1,0,0,0);
		новЗадача.Записать();
		
		ОбновитьДневныеПланы();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПланировщикДеньПроверкаПеретаскивания(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка, Дата, Значения)
