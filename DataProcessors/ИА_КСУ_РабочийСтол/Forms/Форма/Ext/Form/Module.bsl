&НаСервере
Процедура ОбновитьДневныеПериоды(Начало, Конец)
	
	ДатаНачалаДневныхПланов = Начало;
	ДатаКонцаДневныхПланов = Конец;
	
	ПланировщикДень.ТекущиеПериодыОтображения.Очистить();
	выходные = ИА_Защита_Статистика.ПолучитьВыходныеЗаПериод(Начало, Конец);
	
	ТекНачало = Начало;
	Пока ТекНачало < Конец Цикл
		если выходные.найти(ТекНачало) = Неопределено Тогда
			ПланировщикДень.ТекущиеПериодыОтображения.Добавить(ТекНачало, КонецДня(ТекНачало));
		КонецЕсли;
		ТекНачало = ТекНачало + 60*60*24;
	КонецЦикла;
	
	ПланировщикДень.ИнтервалыФона.Очистить();
	интФ = ПланировщикДень.ИнтервалыФона.Добавить(НачалоДня(ТекущаяДата()), КонецДня(ТекущаяДата()));
	интФ.Цвет = новый цвет(235,235,255);
КонецПроцедуры

&НаКлиенте
Процедура ПланировщикНеделяПередСозданием(Элемент, Начало, Конец, Значения, Текст, СтандартнаяОбработка)  // один клик на свободной области
	СтандартнаяОбработка = Ложь;
	
	ОбновитьДневныеПериоды(Начало, Конец-1);
	
	ЕстьПлан = ЕстьПлан(ПланировщикНеделя,Начало,Конец);
	Если ЕстьПлан Тогда
		ОбновитьДневныеПланы();
	Иначе
		ПоказатьВопрос(Новый ОписаниеОповещения("ПланировщикНеделяПередСозданиемЗавершение", ЭтаФорма, новый Структура("Начало, Конец",Начало, Конец)), "Создать недельный план?",РежимДиалогаВопрос.ДаНет);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ЕстьПлан(Планировщик, Начало,Конец, ИсключаяЗадачу = Неопределено)
	Для каждого эл из Планировщик.Элементы Цикл
		если эл.Начало >= Начало И эл.Конец <= Конец и ИсключаяЗадачу<>эл.Значение и эл.Значение<>Неопределено Тогда // план уже есть
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
КонецФункции

&НаКлиенте
Процедура ПланировщикНеделяПередСозданиемЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		ПредПлан = ПолучитьПредНедПлан(ДополнительныеПараметры.Начало);
		
		Оп = Новый ОписаниеОповещения("ЗакрытиеНедПлана", ЭтаФорма, ПредПлан);
		
		парам = Новый Структура("ЗначениеКопирования, Начало", ПредПлан, ДополнительныеПараметры.Начало);
		ОткрытьФорму("Справочник.ИА_ПланыДействий.ФормаОбъекта",парам,,,,,Оп);
	КонецЕсли;

КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьПредНедПлан(ТекНачало)
	ДатаКонца = ТекНачало - 1;
	ДатаНачала = ДобавитьМесяц(ДатаКонца,-1);	
	Запрос = Новый Запрос;
	ИА_Планы.ЗаполнитьТаблицуПлановВЗапросе(Запрос,ДатаНачала,ДатаКонца);
	
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	ИА_ПланыДействий.План КАК План
	               |ИЗ
	               |	НедельныеПланы КАК ИА_ПланыДействий	             
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ИА_ПланыДействий.ДатаНачала УБЫВ";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если выборка.Следующий() Тогда
		возврат Выборка.План;
	Иначе
		Возврат неопределено;
	КонецЕсли;
КонецФункции

