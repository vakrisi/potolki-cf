&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "ЗакрытиеЗадачиБП" Тогда
		
		ОбновитьВсеКорзиныПоРегистрамИУведомления();
   		
	ИначеЕсли ИмяСобытия = "ИА_ОбновитьУведомления" Тогда	
		ОбновитьУведомленияИСведенияДляЗаголовков();
	ИначеЕсли ИмяСобытия = "КСУ_ОбновитьМС" Тогда
		ОбновитьМоиСтатистики();
	ИначеЕсли ИмяСобытия = "КСУ_ОбновитьКорзины" Тогда
		ОбновитьКорзины();
	ИначеЕсли ИмяСобытия = "ОбновитьНовостиКСУ" Тогда
		ОбновитьНовости();
	КонецЕсли;
	
КонецПроцедуры

