&НаКлиенте
Перем ФормаСтатистик, ФормыЗадач, СоотвИДпользователей, ПредВыбЗадача;

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	#ЕСЛИ ВебКлиент ТОГДА
		ВебКлиент = Истина;
		Элементы.РазвернутьСтатистики.Пометка = истина;
		Элементы.РазвернутьСтатистики.Видимость = ложь;
		РазвернутьСтатистики_сервер();
		
		Элементы.ГруппаКЦ_Стат.Высота =20;
		Элементы.ГруппаПланы.Высота =20;
	#КОНЕЦЕСЛИ
	
	СоотвИДпользователей = новый Соответствие;
	
	экраны = ПолучитьИнформациюЭкрановКлиента();
	Если экраны[0].Ширина<1400 Тогда
		Элементы.Предпросмотр.Видимость = ложь;
		СкрытьЛенту = истина;
	КонецЕсли;
	
	Если экраны[0].Высота<1000 Тогда
		ЭтаФорма.ВертикальнаяПрокрутка = ВертикальнаяПрокруткаФормы.Использовать;
	КонецЕсли;


	Если не (ИА_Защита_Общий.ЛицензияДоступна("КЦ") И ИА_Защита_Общий.ЛицензияДоступна("БП") И ИА_Защита_Общий.ЛицензияДоступна("Статистика")) Тогда
		Отказ = Истина;
		возврат;
	КонецЕсли;
	
	
	Если ВебКлиент Тогда
		Элементы.ПолеГлСтатистика.Видимость = ложь;
		//Элементы.ГруппаКЦ_Стат.РастягиватьПоВертикали = ложь;
	КонецЕсли;

	
	//статистики
	ДатаКонца_МС = ТекущаяДата();
		
	Если ПериодДетализации_МС.Пустая() Тогда
		ПериодДетализации_МС = ПредопределенноеЗначение("Перечисление.ИА_ПериодыДетализации.День");
	КонецЕсли;
	
	Если КоличествоПериодов_МС = 0 Тогда
		КоличествоПериодов_МС = 21;
	КонецЕсли;
	ПересчитатьПериод(ДатаНачала_МС, ДатаКонца_МС, ПериодДетализации_МС, КоличествоПериодов_МС, ОтображатьНезавершенныеПериоды, ОтображатьОдинБудущийПериодСтатистики);
	
	//главные статистики
	ТекстСтатистики = "";
	ОбновитьМоиСтатистики();
	
	РольСтатистикиПросмотрДоступна 		 = ИА_КСУОбщийСервер.ПросмотрСтатистикДоступен();
	РольСтатистикиРедактированиеДоступна = ИА_КСУОбщийСервер.РедактированиеСтатистикДоступно();
	
	
	// Обновление корзин и уведомлений
	ОбновитьВсеКорзиныПоРегистрамИУведомления();
	
	ФормыЗадач = Новый Массив;
	ПодключитьОбработчикОжидания("ОбновитьКорзиныПоРегистрам", 30, ложь);
	ПодключитьОбработчикОжидания("ПроверитьФормыЗадач", 3, ложь);
	
	//
	
	обновитьНовыеСостояния();
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьФормыЗадач()
	сч = ФормыЗадач.Количество() -1;
	Пока сч>=0 Цикл
		ф = ФормыЗадач[сч];
		Если не ф.Открыта() Тогда
			ОбновитьВсеКорзиныПоРегистрамИУведомления();
			ФормыЗадач.Удалить(сч);
		КонецЕсли;
		
		сч = сч -1;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьКорзиныПоРегистрам()
	ТекСтр = Элементы.ГруппаКоммцентр.ТекущаяСтраница;
	Если ТекСтр = Элементы.Входящие или ТекСтр = Элементы.Исходящие или ТекСтр = Элементы.ВРаботе Тогда
		ОбновитьКорзину(ТекСтр.Имя);
	КонецЕсли;
	Если ВводДоступен() Тогда
		ОбновитьУведомленияИСведенияДляЗаголовков();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьВсеКорзиныПоРегистрамИУведомления()
	ОбновитьКорзину("Входящие");
	ОбновитьКорзину("ВРаботе");
	ОбновитьКорзину("Исходящие");
	ОбновитьУведомленияИСведенияДляЗаголовков();
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьКорзину(ИмяКорзины)
	ТипыЗадач = Неопределено;
	кол = ИА_ОбщиеПроцедуры_Технология_КоммЦентр_Сервер.ОбновитьДанныеКорзины(ИмяКорзины,ТипыЗадач);
	
	Если ТипыЗадачСписок.Количество() =0 И ИмяКорзины = "Исходящие" Тогда
		Для каждого стрТип из ТипыЗадач Цикл
			Если стрТип <> Тип("Null") и стрТип <> Тип("ЗадачаСсылка.ИА_ЗадачаПланаДействий") Тогда
				ТипыЗадачСписок.Добавить(стрТип);
			КонецЕсли;
		КонецЦикла;
		СоздатьКнопкиСозданияЗадач();
	КонецЕсли;
	
	эл = Элементы["Таблица"+ИмяКорзины];
	эл.Обновить();
	
	
	// обновление количества в дереве корзин
	корзина = ПредопределенноеЗначение("Справочник.ИА_РасширенияКомцентра."+ИмяКорзины);
	Для каждого стр из ДеревоКорзин.ПолучитьЭлементы() Цикл
		если стр.корзина = корзина Тогда
			стр.Количество = кол; 
			
			Если стр.ПолучитьЭлементы().Количество() >0 Тогда // обновить вложенные корзины
				КолВл = ПолучитьКоличествоВоВложенныхКорзинах(стр.Корзина, ТекПользователь);
				Для каждого ВлКорз из стр.ПолучитьЭлементы() Цикл
					к = КолВл.Получить(ВлКорз.Корзина);
					ВлКорз.Количество = ?(к = Неопределено, 0 , к);
				КонецЦикла;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

&НаСерверебезКонтекста
Функция ПолучитьКоличествоВоВложенныхКорзинах(Корзина, ТекПользователь)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ИА_ГруппыКЦ.Группа КАК Группа,
	               |	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ИА_ГруппыКЦ.Задача) КАК Кол
	               |ИЗ
	               |	РегистрСведений.ИА_ГруппыКЦ КАК ИА_ГруппыКЦ
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ИА_ЗадачиКЦ КАК РегистрСведенийИА_ЗадачиКЦ
	               |		ПО (РегистрСведенийИА_ЗадачиКЦ.ПользовательКЦ = ИА_ГруппыКЦ.Пользователь)
	               |			И (РегистрСведенийИА_ЗадачиКЦ.Ссылка = ИА_ГруппыКЦ.Задача)
	               |			И ИА_ГруппыКЦ.Группа.Корзина = РегистрСведенийИА_ЗадачиКЦ.Корзина
	               |ГДЕ
	               |	ИА_ГруппыКЦ.Пользователь = &Пользователь
	               |	И ИА_ГруппыКЦ.Группа.Корзина = &Корзина
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ИА_ГруппыКЦ.Группа";
	Запрос.УстановитьПараметр("Корзина", Корзина);
	Запрос.УстановитьПараметр("Пользователь", ТекПользователь);
	рез = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		рез.Вставить(Выборка.Группа, Выборка.Кол);
	КонецЦикла;
	
	Возврат рез;
КонецФункции

&НаСервере
Процедура СоздатьКнопкиСозданияЗадач()
	сч = 0;
	Для каждого стрТип из ТипыЗадачСписок Цикл
		Кмд = ЭтаФорма.Команды.Добавить("КомандаНетиповойЗадач"+сч);
		Кмд.Действие = "СоздатьНетиповуюЗадачу";
		
		НовЭл = Элементы.Добавить("КнопкаНетиповойЗадач"+сч, Тип("КнопкаФормы"), Элементы.ГруппаСоздать);
		НовЭл.Вид = ВидКнопкиФормы.ОбычнаяКнопка;
		НовЭл.ИмяКоманды = "КомандаНетиповойЗадач"+сч;
		
		НовЭл.Заголовок = стрТип;
		НовЭл.Картинка = БиблиотекаКартинок.СоздатьЭлементСписка;
		НовЭл.Отображение = ОтображениеКнопки.КартинкаИТекст;
		сч = сч + 1;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьУведомленияИСведенияДляЗаголовков()
	
	Если Взаимодействия1с Тогда
		Элементы.ДекорацияУведомления.Видимость  = ложь;
		Элементы.ДекорацияУведКартинка.Видимость = ложь;
	Иначе
		Результат = ПолучитьКоличествоУведомлений(ТекПользователь);
		КоличествоУведомлений = Результат.КоличествоУведомлений; 
		Элементы.ДекорацияУведомления.Видимость  = КоличествоУведомлений>0;
		Элементы.ДекорацияУведКартинка.Видимость = КоличествоУведомлений>0;
		Элементы.ДекорацияУведомления.Заголовок = "Уведомления ("+ КоличествоУведомлений + ")";
	КонецЕсли;
	

КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьКоличествоУведомлений(ТекПользователь)
    
	Результат =  Новый Структура;
    
    Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ИА_УведомленияКЦ.Задача
	               |ИЗ
	               |	РегистрСведений.ИА_УведомленияКЦ КАК ИА_УведомленияКЦ
	               |ГДЕ
	               |	ИА_УведомленияКЦ.Пользователь = &Пользователь";
				   
	Запрос.УстановитьПараметр("Пользователь", ТекПользователь);
    
    Результат.Вставить("КоличествоУведомлений",Запрос.Выполнить().Выбрать().Количество());
    
	Возврат Результат;
КонецФункции


&НаСервере
Процедура СформироватьКартинкуВеб(ОбъектСтрукт)
	деревоСТ = РеквизитФормыВЗначение("ДеревоСтатистик");
	ИА_Статистики.СформироватьКартинкуВеб(ЭтаФорма,ОбъектСтрукт,деревоСТ, ИСТИНА,ЛОЖЬ , ИСТИНА, ложь, ложь, Неопределено, ПериодДетализации_МС);	
	ЗначениеВРеквизитФормы(деревоСТ,"ДеревоСтатистик");
КонецПроцедуры

&НаКлиенте
Процедура СкопироватьДерево(СтрИз, СтрВ)
	Для каждого стр из СтрИз.ПолучитьЭлементы() Цикл
		НовСтр = стрВ.ПолучитьЭлементы().Добавить();
		ЗаполнитьЗначенияСвойств(НовСтр, стр,,"Данные");
		
		Для каждого стрД из стр.Данные Цикл
			НовстрД = НовСтр.Данные.Добавить();
			ЗаполнитьЗначенияСвойств(НовстрД, стрД);
		КонецЦикла;
		
		СкопироватьДерево(Стр, НовСтр)
	КонецЦикла;
КонецПроцедуры	
	
&НаКлиенте
Процедура ОбновитьМоиСтатистики()
    СписокВыбранныхНастроек = ПолучитьМоюНастройкуСтатистик();
    Если СписокВыбранныхНастроек = Неопределено ИЛИ СписокВыбранныхНастроек.Количество() = 0 Тогда
    	Возврат;
    КонецЕсли;
    МояНастройкаСтатистики = СписокВыбранныхНастроек[0];
	
	Если ФормаСтатистик = Неопределено тогда
		Попытка
			ФормаСтатистик = ПолучитьФорму("Обработка.ИА_РабочийСтолСтатистик_Упр_HTML.Форма",,,ЭтаФорма.УникальныйИдентификатор);
		Исключение
			Возврат; // скорее всего нет прав
		КонецПопытки;
	КонецЕсли;				
	
	//
	ШиринаЭкрана = 340;
	
	ФормаСтатистик.Объект.Настройка = МояНастройкаСтатистики;
    ФормаСтатистик.СписокВыбранныхНастроекСтатистик.Очистить();
    Для каждого Эл Из СписокВыбранныхНастроек Цикл
    	НовЭл = ФормаСтатистик.СписокВыбранныхНастроекСтатистик.Добавить();
		НовЭл.Настройка = Эл; 
    КонецЦикла; 
    
	ФормаСтатистик.ЗагрузитьНастройку(-1,ПериодДетализации_МС, Истина);
	ФормаСтатистик.Объект.ДатаНачала = ДатаНачала_МС;
	ФормаСтатистик.Объект.ДатаКонца = ДатаКонца_МС;
	
	ФормаСтатистик.Объект.КоличествоВСтроке = 1;
	ФормаСтатистик.sw = ШиринаЭкрана;
	//
	
	Если ВебКлиент Тогда
		ДеревоСтатистик.ПолучитьЭлементы().Очистить();
		СкопироватьДерево(ФормаСтатистик.ДеревоСтатистик, ДеревоСтатистик);
		
		ОбъектСтрукт = Новый Структура("ДатаНачала,ДатаКонца,Настройка,КоличествоВСтроке");
		ЗаполнитьЗначенияСвойств(ОбъектСтрукт, ФормаСтатистик.Объект);
		
		СформироватьКартинкуВеб(ОбъектСтрукт);	
		
		ФормаСтатистик.ДеревоСтатистик.ПолучитьЭлементы().Очистить();
		СкопироватьДерево(ДеревоСтатистик, ФормаСтатистик.ДеревоСтатистик);
	Иначе
		//ДанныеХТМЛ_текст = ПолучитьТекстПоНастройке_МоиСтатистики(МояНастройкаСтатистики, СписокВыбранныхНастроек);
		
		ДанныеХТМЛ_текст = ФормаСтатистик.СформироватьКартинку(Истина, Ложь, Истина, ,,, ПериодДетализации_МС);
		
		РезСтраницаИмя = ИА_Статистики_Клиент.ПолучитьФайлСтраницы(ДанныеХТМЛ_текст,"MS");		
			
		НадоОбновить = ДанныеХТМЛ_ГлавнаяСтатистика<>"";
		
		ДанныеХТМЛ_ГлавнаяСтатистика = РезСтраницаИмя;
		Если НадоОбновить Тогда
			Попытка
				Элементы.ПолеГлСтатистика.Документ.parentWindow.location.reload();
			Исключение
				Элементы.ПолеГлСтатистика.Документ.window.location.reload();
			КонецПопытки;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьМоюНастройкуСтатистик()
	ЗапросПоста = Новый Запрос;
	ЗапросПоста.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
                        |   ИА_АдресацияЗадачПланаДействий.Пост,
                        |   1000 КАК Уровень,
                        |   1000 КАК УровеньПоТипуТерминала,
                        |   ИА_АдресацияЗадачПланаДействий.Пост.НастройкаСтатистик КАК НастройкаСтатистик
                        |ИЗ
                        |   РегистрСведений.ИА_АдресацияЗадачПланаДействий КАК ИА_АдресацияЗадачПланаДействий
                        |ГДЕ
                        |   ИА_АдресацияЗадачПланаДействий.Пользователь = &Пользователь
                        |   И ИА_АдресацияЗадачПланаДействий.Пост <> ЗНАЧЕНИЕ(Справочник.ОргСхема.ПустаяСсылка)";
	ЗапросПоста.УстановитьПараметр("Пользователь", ТекПользователь);
	ТЗ = ЗапросПоста.Выполнить().Выгрузить();
	
	Для каждого стр из ТЗ Цикл
		стр.Уровень = стр.Пост.Уровень();
		стр.УровеньПоТипуТерминала = ПолучитьУровеньПоТипуТерминала(стр.Пост.ТипТерминала);
	КонецЦикла;
	
	Тз.Сортировать("Уровень Возр, УровеньПоТипуТерминала Возр");
	
	Если ТЗ.Количество() = 0 Тогда
		Сообщить("У вас не указаны занимаемые посты!");
		Возврат Неопределено;
	КонецЕсли;
    
    Результат = Новый Массив;
    Для каждого СтрокаТЗ Из ТЗ Цикл
        Если ЗначениеЗаполнено(СтрокаТЗ.НастройкаСтатистик) Тогда
            ИА_БФКС.Массив_ДобавитьЕслиНет(Результат, СтрокаТЗ.НастройкаСтатистик);	
        КонецЕсли;     	
    КонецЦикла;     
    
    Возврат Результат;
КонецФункции

&НаСервере
Функция ПолучитьУровеньПоТипуТерминала(ТипТерминала)
	
	Если ТипТерминала = Перечисления.ТипТерминалаОргСхемы.Организация Тогда
		Возврат 1;
	ИначеЕсли ТипТерминала = Перечисления.ТипТерминалаОргСхемы.Учредитель Тогда
		Возврат 2;
	ИначеЕсли ТипТерминала = Перечисления.ТипТерминалаОргСхемы.РуководящийСостав Тогда
		Возврат 3;
	ИначеЕсли ТипТерминала = Перечисления.ТипТерминалаОргСхемы.Департамент Тогда
		Возврат 4;
	ИначеЕсли ТипТерминала = Перечисления.ТипТерминалаОргСхемы.Отдел Тогда
		Возврат 5;
	ИначеЕсли ТипТерминала = Перечисления.ТипТерминалаОргСхемы.Секция Тогда
		Возврат 6;
	ИначеЕсли ТипТерминала = Перечисления.ТипТерминалаОргСхемы.Сотрудник Тогда
		Возврат 7;
	КонецЕсли;
	
КонецФункции

&НаСервереБезКонтекста
Процедура ПересчитатьПериод(ДатаНачала, ДатаКонца, ПериодДетализации, КоличествоПериодов, ОтображатьНезавершенныеПериод, ОтображатьОдинБудущийПериодСтатистики = ложь)
	
	текДата = ТекущаяДата();
		
	Если ПериодДетализации = Перечисления.ИА_ПериодыДетализации.День тогда
		
		ДатаКонца = НачалоДня(текДата)-1;
		
		Если ОтображатьНезавершенныеПериод ТОгда
			ДатаКонца = текДата;
		КонецЕсли;		
		
		ДатаНачала = ДатаКонца - 60*60*24 * (КоличествоПериодов-1);
		
	ИначеЕсли ПериодДетализации = Перечисления.ИА_ПериодыДетализации.Неделя  тогда
		
		НачалоНедели = Константы.ИА_НачалоНедели.Получить();
		
		Если НачалоНедели > 1 Тогда
			
			ДатаКонца = КонецНедели(текДата) - (7 - НачалоНедели + 1)*60*60*24;
			
			Если ДеньНедели(текДата) < НачалоНедели-1 и Не ОтображатьНезавершенныеПериод Тогда
				ДатаКонца = ДатаКонца - 60*60*24*7;
			КонецЕсли;
			
			ДатаНачала = ДатаКонца - 60*60*24*7 * (КоличествоПериодов) + 60*60*24;
			
		Иначе
			
			Если ОтображатьНезавершенныеПериод Тогда
				ДатаКонца = КонецНедели(текДата);
			Иначе
				ДатаКонца = НачалоНедели(текДата)-1;
			КонецЕсли;
			
			//ДатаКонца = ДатаКонца - 60*60*24*7;
			ДатаНачала = НачалоНедели(ДатаКонца) - 60*60*24*7 * (КоличествоПериодов-1);
			
		КонецЕсли;
		
	ИначеЕсли ПериодДетализации = Перечисления.ИА_ПериодыДетализации.Месяц тогда
		
		ДатаКонца = КонецМесяца(текДата);
		
		Если КонецДня(текДата) <> КонецДня(ДатаКонца) и не ОтображатьНезавершенныеПериод Тогда
			ДатаКонца = КонецМесяца(ДобавитьМесяц(НачалоМесяца(текДата),-1));
		КонецЕсли;
		
		ДатаНачала = НачалоМесяца(ДобавитьМесяц(ДатаКонца, -(КоличествоПериодов-1)));
		
	ИначеЕсли ПериодДетализации = Перечисления.ИА_ПериодыДетализации.Квартал тогда
		
		ДатаКонца = КонецКвартала(текДата);
		
		Если КонецДня(текДата) <> КонецДня(ДатаКонца) и не ОтображатьНезавершенныеПериод Тогда
			ДатаКонца = КонецМесяца(ДобавитьМесяц(НачалоМесяца(ДатаКонца),-3));
		КонецЕсли;
		
		ДатаНачала = НачалоМесяца(ДобавитьМесяц(ДатаКонца+1, -(КоличествоПериодов)*3));
		
	ИначеЕсли ПериодДетализации = Перечисления.ИА_ПериодыДетализации.Год тогда
		
		ДатаКонца = КонецГода(текДата);
		
		Если КонецДня(текДата) <> КонецДня(ДатаКонца) и не ОтображатьНезавершенныеПериод Тогда
			ДатаКонца = КонецГода(ДобавитьМесяц(текДата,-12));
		КонецЕсли;
		
		ДатаНачала = НачалоГода(ДобавитьМесяц(ДатаКонца, -(КоличествоПериодов-1)*12));		
	КонецЕсли;
	
КонецПроцедуры


&НаСервере
Процедура УстановитьЗапросКорзины(Корзина)
	
	ДанныеКорзины = Вычислить("Задачи"+Корзина);
	Расшир = Справочники.ИА_РасширенияКомцентра[Корзина];
	
	ДанныеКорзины.ТекстЗапроса = Расшир.ТекстЗапроса;
	Попытка
		ДанныеКорзины.Параметры.УстановитьЗначениеПараметра("ТекущийПользователь", ТекПользователь);
	Исключение
	КонецПопытки;
	Попытка
		ДанныеКорзины.Параметры.УстановитьЗначениеПараметра("ТекДата", ТекущаяДата());
	Исключение
	КонецПопытки;
	парам = Расшир.ТабПараметровЗапроса.Получить();
	Если парам <> Неопределено Тогда
		Для каждого стр из парам Цикл
			ДанныеКорзины.Параметры.УстановитьЗначениеПараметра(стр.ИмяПараметра, стр.Значение);
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры


&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Взаимодействия1с = Константы.КСУ_КЦ_ИспользоватьВзаимодействия1С.Получить();
	
	Элементы.ОткрытьРСВладельца.Видимость = РольДоступна("КСУ_Владелец");
	
	ТекПользователь = ПараметрыСеанса.ТекущийПользователь;
		
	ОтображатьНезавершенныеПериоды = ИА_НастройкиС.ЗначениеНастройкиТекПользователя(ПланыВидовХарактеристик.ИА_НастройкиПользователей.ОтображатьНезавершенныеПериодыНаРС);
	ОтображатьОдинБудущийПериодСтатистики = Константы.ИА_ОтображатьОдинБудущийПериодСтатистики.Получить();
	Элементы.ДекорацияЦель.Заголовок = Константы.ИА_ЦельКомпании.Получить();
	
	// коммцентр. Простые корзины - Архив и Все. Просто устанавливаем запрос и параметры
	УстановитьЗапросКорзины("Архив");
	УстановитьЗапросКорзины("Все");
	
	// сложные корзины. Обновляем данные регистра для отображение
	ЗадачиВходящие.Параметры.УстановитьЗначениеПараметра("ПользовательКЦ", ТекПользователь);
	ЗадачиВходящие.Параметры.УстановитьЗначениеПараметра("ОтборГруппа", Неопределено);
	
	ЗадачиВРаботе.Параметры.УстановитьЗначениеПараметра("ПользовательКЦ", ТекПользователь);
	ЗадачиВРаботе.Параметры.УстановитьЗначениеПараметра("ОтборГруппа", Неопределено);
	
	ЗадачиИсходящие.Параметры.УстановитьЗначениеПараметра("ПользовательКЦ", ТекПользователь);
	ЗадачиИсходящие.Параметры.УстановитьЗначениеПараметра("ОтборГруппа", Неопределено);
	//
	
	УстановитьПараметрыОтбораВсе();
	
	// коммцентр. Отборы
	СоздатьОтборыВсе();    
	
	//
	СоздатьКорзины();
	//
	Лого = Константы.ИА_ЛоготипКомпании.Получить();
	Если ЗначениеЗаполнено(лого) ТОгда
		дд = лого.Получить();
		Если ЗначениеЗаполнено(дд) Тогда
			уид1 = Новый УникальныйИдентификатор;
			АдресКартинкиЛоготип = ПоместитьВоВременноеХранилище(дд,уид1);
		КонецЕсли;
	КонецЕсли;
	Элементы.ПолеЛоготип.Видимость = АдресКартинкиЛоготип<>"";
	
	ВостановитьНастройкиДинамическихСписковИВидимости();
	
	///
	
	МоиПосты = МоиПолучитьПосты();
	Элементы.ПостДневник.СписокВыбора.ЗагрузитьЗначения(МоиПосты);
	Если МоиПосты.Количество() > 0 Тогда
		ПостДневник = МоиПосты[0];
	КонецЕсли;
	ОбновитьДневникСервер();
	//
	Элементы.ГруппаДневник.Видимость = ИА_НастройкиСПИ.ЗначениеНастройки(ПараметрыСеанса.ТекущийПользователь,ПланыВидовХарактеристик.ИА_НастройкиПользователей.ОткрыватьДневникНаРС);
	//
	ИА_Планы.УстановитьРабочееВремя(ПланировщикДень);
	//
	ОбновитьПериодыПланов();
	ОбновитьНедельныеПланы();	
	ОбновитьДневныеПланы();
	ОбновитьНовости();
КонецПроцедуры

&НаСервере
Процедура ОбновитьНовости()
	новость = КСУ_Новости.ПолучитьНовостьКСУ(ложь);
	Элементы.ДекорацияНовостиКСУ.Видимость = новость<>"";
КонецПроцедуры
	
&НаСервере
Процедура СоздатьКорзины()
	НовСтр = ДеревоКорзин.ПолучитьЭлементы().Добавить();
	НовСтр.Корзина = Справочники.ИА_РасширенияКомцентра.Входящие;
	НовСтр.ИдСтроки = 0;
	ДобавитьВложеннуюКорзину(НовСтр);
	
	НовСтр = ДеревоКорзин.ПолучитьЭлементы().Добавить();
	НовСтр.Корзина = Справочники.ИА_РасширенияКомцентра.ВРаботе;
	НовСтр.ИдСтроки = 1;
	ДобавитьВложеннуюКорзину(НовСтр);
	
	НовСтр = ДеревоКорзин.ПолучитьЭлементы().Добавить();
	НовСтр.Корзина = Справочники.ИА_РасширенияКомцентра.Исходящие;
	НовСтр.ИдСтроки = 2;
	ДобавитьВложеннуюКорзину(НовСтр);
	
	НовСтр = ДеревоКорзин.ПолучитьЭлементы().Добавить();
	НовСтр.Корзина = Справочники.ИА_РасширенияКомцентра.Архив;
	НовСтр.ИдСтроки = 3;
	
	НовСтр = ДеревоКорзин.ПолучитьЭлементы().Добавить();
	НовСтр.Корзина = Справочники.ИА_РасширенияКомцентра.Все;
	НовСтр.ИдСтроки = 4;
КонецПроцедуры

&НаСервере
Процедура ДобавитьВложеннуюКорзину(КорзинаСтр)
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ИА_ГруппыКЦ.Ссылка
	               |ИЗ
	               |	Справочник.ИА_ГруппыКЦ КАК ИА_ГруппыКЦ
	               |ГДЕ
	               |	ИА_ГруппыКЦ.Корзина = &Корзина
	               |	И ИА_ГруппыКЦ.Пользователь = &Пользователь
	               |	И ИА_ГруппыКЦ.ПометкаУдаления = ложь";
	Запрос.УстановитьПараметр("Корзина", КорзинаСтр.Корзина);
	Запрос.УстановитьПараметр("Пользователь", ТекПользователь);
	Выборка = Запрос.Выполнить().Выбрать(); 
	
	Пока Выборка.Следующий() Цикл
		Новстр = КорзинаСтр.ПолучитьЭлементы().Добавить();
		НовСтр.Корзина = Выборка.ссылка;
		НовСтр.ИдСтроки = КорзинаСтр.ИдСтроки;
	КонецЦикла;
КонецПроцедуры

