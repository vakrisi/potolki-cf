&НаКлиенте
Процедура УстановитьНапоминание(СдвигВремени)
	Если Элементы.ПланировщикДень.ВыделенныеЭлементы.Количество() = 1 и ЗначениеЗаполнено(Элементы.ПланировщикДень.ВыделенныеЭлементы[0].Значение) Тогда
		зн = Элементы.ПланировщикДень.ВыделенныеЭлементы[0].Значение;		
		СоздатьНапоминание(зн, СдвигВремени);
	КонецЕсли;
КонецПроцедуры

&НаСервереБезКонтекста
Процедура СоздатьНапоминание(ОбъектН,СдвигВремени)	
	мен = РегистрыСведений.КСУ_Напоминания.СоздатьМенеджерЗаписи();
	мен.Тема = "Напоминание!";
	мен.Пользователь = ПараметрыСеанса.ТекущийПользователь;
	мен.Объект = ОбъектН;
	
	Если ТипЗнч(ОбъектН) = тип("строка") Тогда // гугл
		менНап = РегистрыСведений.КСУ_СобытияКалендаряGoogle.СоздатьМенеджерЗаписи();
		менНап.идСобытия = ОбъектН;
		менНап.Прочитать();
		
		мен.Период = менНап.ДатаНачала - СдвигВремени;
		мен.Текст = менНап.Описание;
	Иначе
		мен.Период = ОбъектН.Владелец.ДатаНачала + ИА_Планы.ВремяВЧисло(ОбъектН.ВремяНачала) - СдвигВремени;
		мен.Текст = ОбъектН.содержание;
	КонецЕсли;

	мен.Записать();
КонецПроцедуры


&НаКлиенте
Процедура ПланировщикНеделяПеретаскивание(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка, Дата, Значения)
	СтандартнаяОбработка = ложь;
	ПараметрыПеретаскивания.Действие = ДействиеПеретаскивания.Копирование;
	МассивВыбора = ПараметрыПеретаскивания.Значение;
	Если ТипЗнч(МассивВыбора) = Тип("Массив") или ТипЗнч(МассивВыбора) = Тип("ФиксированныйМассив") Тогда
		Выбор = МассивВыбора[0];
	Иначе
		Выбор = МассивВыбора;
	КонецЕсли;
	
	Если ТипЗнч(Выбор) = тип("Структура") Тогда
		ПеренестиЗадачуИзКЦВНедельный(Выбор.Задача, дата);
		
		ПодключитьОбработчикОжидания("ОбновитьКорзины",1,истина);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ПеренестиЗадачуИзКЦВНедельный(ЗадачаКЦ, дата)
	НедПлан = ПолучитьНедельныйПланПоПроизвДате(Дата);
	Если НедПлан <> Неопределено Тогда
		обЗадача = ЗадачаКЦ.получитьобъект();
		обЗадача.Отложена = истина;
		обЗадача.записать();
		
		новЗадача = Справочники.ИА_ЗадачиПлана.СоздатьЭлемент();
		новЗадача.владелец = НедПлан;
		новЗадача.ЗадачаОснование = ЗадачаКЦ;
		новЗадача.Пост = ЗадачаКЦ.Пост;
		Если новЗадача.Пост.Пустая() ТОгда
			новЗадача.Пост = НедПлан.Пост;
		КонецЕсли;
		
		новЗадача.Группировка = Перечисления.ИА_ТипыЗадачБП.Задачи;
		новЗадача.Содержание = ЗадачаКЦ.Наименование;
		новЗадача.ВремяНачала = Дата;
		новЗадача.ВремяКонца = новЗадача.ВремяНачала+ 60*60;
		новЗадача.ВремяПлан = Дата(1,1,1,1,0,0);
		новЗадача.ВремяФакт = Дата(1,1,1,0,0,0);
		новЗадача.Записать();
		
		ОбновитьНедельныеПланы();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПланировщикНеделяПроверкаПеретаскивания(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка, Дата, Значения)
	ПараметрыПеретаскивания.Действие = ДействиеПеретаскивания.Копирование;
	МассивВыбора = ПараметрыПеретаскивания.Значение;
	Если ТипЗнч(МассивВыбора) = Тип("Массив") или ТипЗнч(МассивВыбора) = Тип("ФиксированныйМассив") Тогда
		Выбор = МассивВыбора[0];
	Иначе
		Выбор = МассивВыбора;
	КонецЕсли;
	
	Если ТипЗнч(Выбор) = тип("Структура") Тогда
		
		ПараметрыПеретаскивания.Действие = ДействиеПеретаскивания.Копирование;
		ПараметрыПеретаскивания.ДопустимыеДействия = ДопустимыеДействияПеретаскивания.Копирование;
		СтандартнаяОбработка = ложь;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция ПолучитьНедельныйПланПоПроизвДате(Начало)
	Запрос = Новый Запрос;
	ИА_Планы.ЗаполнитьТаблицуПлановВЗапросе(Запрос,ДатаНачалаНедельныхПланов,ДатаКонцаНедельныхПланов);	
	Запрос.Текст = "ВЫБРАТЬ
	               |	ИА_ПланыДействий.План
	               |ИЗ
	               |	НедельныеПланы КАК ИА_ПланыДействий ГДЕ ИА_ПланыДействий.ДатаНАчала <= &Дата и ИА_ПланыДействий.ДатаКонца >= &Дата";
	Запрос.УстановитьПараметр("Дата",Начало);
	Выборка = Запрос.Выполнить().Выбрать();
	Если выборка.Следующий() Тогда
		возврат выборка.План;
	Иначе
		возврат Неопределено;
	КонецЕсли;
КонецФункции

