&НаСервереБезКонтекста
Функция ПолучитьСписокГрупп(ГруппаИскл, корзина, ТекПользователь)
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ИА_ГруппыКЦ.Ссылка
	               |ИЗ
	               |	Справочник.ИА_ГруппыКЦ КАК ИА_ГруппыКЦ
	               |ГДЕ
	               |	ИА_ГруппыКЦ.Пользователь = &Пользователь
	               |	И ИА_ГруппыКЦ.Корзина = &Корзина
	               |	И ИА_ГруппыКЦ.Ссылка <> &Ссылка
	               |	И ИА_ГруппыКЦ.ПометкаУдаления = ложь";
	Запрос.УстановитьПараметр("Пользователь", ТекПользователь);
	Запрос.УстановитьПараметр("Ссылка", ГруппаИскл);
	Запрос.УстановитьПараметр("Корзина", Справочники.ИА_РасширенияКомцентра[корзина]);
	м = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	Рез = Новый СписокЗначений;
	Рез.ЗагрузитьЗначения(м);
	Возврат Рез;
КонецФункции

&НаСервере
Процедура СохранитьНастройкиДинамическихСписковИВидимости()
	
	СписокИменКорзин = СписокИменКорзин();
	
	СтруктураСохраняемыхНастроек = Новый Структура;
	
	//СтруктураСохраняемыхНастроек.Вставить("СтатистикиВидимость", Элементы.ГруппаМоиСтат.Видимость);
	//СтруктураСохраняемыхНастроек.Вставить("ПланыВидимость", Элементы.ГруппаПланы.Видимость);
	
	Для каждого КорзинаИзСписка Из СписокИменКорзин Цикл
		
		ИмяКорзины = КорзинаИзСписка.Значение;
		СтруктураСохраняемыхНастроекКорзины = Новый Структура;
		ДобавитьНастройкиГруппировкиВСтруктуру(СтруктураСохраняемыхНастроекКорзины, ИмяКорзины);
		
		СтруктураСохраняемыхНастроек.Вставить("Настройки" + ИмяКорзины, СтруктураСохраняемыхНастроекКорзины); 
