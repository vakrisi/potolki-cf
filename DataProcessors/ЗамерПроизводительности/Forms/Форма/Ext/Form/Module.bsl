
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЗаполнитьСписокДоступныхОбъектов();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокДоступныхОбъектов()
	
	Для Каждого ОбъектМетаданных Из Метаданные.Документы Цикл
		
		Если НЕ СтрНачинаетсяС(НРег(ОбъектМетаданных.Имя), "удалить")
			И ПравоДоступа("Изменение", ОбъектМетаданных)
		Тогда
			ДоступныеОбъектыДляИзменения.Добавить(ОбъектМетаданных.ПолноеИмя(), ОбъектМетаданных.Представление());
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура Перепровести(Команда)
	
	ПерепровестиНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ПерепровестиНаСервере()
	
	ОбработанныеДокументы.Очистить();
	Результат.Очистить();
	
	// Получим выбранные виды документов
	МассивВыбранныхОбъектов = новый Массив;
	ПредставлениеВидов = "";
	
	Для Каждого ДоступныйОбъект Из ДоступныеОбъектыДляИзменения Цикл
		
		Если ДоступныйОбъект.Пометка Тогда
			
			МассивВыбранныхОбъектов.Добавить(ДоступныйОбъект.Значение);
			ПредставлениеВидов = ПредставлениеВидов + ?(ЗначениеЗаполнено(ПредставлениеВидов), "; ", "") + ДоступныйОбъект.Представление;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если МассивВыбранныхОбъектов.Количество() = 0 Тогда
		Сообщить("Необходимо выбрать хотя бы один вид документа.");
		Возврат;
	КонецЕсли;
	
	// Сделаем запрос на выборку проведенных документов по выбранным видам документов
	Запрос = новый Запрос;
	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", ?(КонецПериода = Дата(1,1,1), ТекущаяДатаСеанса(), КонецПериода));
	
	Сч = 1;
	Для Каждого ТекущийВид Из МассивВыбранныхОбъектов Цикл
		
		ИмяВЗапросе = СтрЗаменить(ТекущийВид, ".", "");
		
		Запрос.Текст = Запрос.Текст + "ВЫБРАТЬ
		|	" + ИмяВЗапросе + ".Ссылка КАК Ссылка,
		|	ТипЗначения(" + ИмяВЗапросе + ".Ссылка) КАК ВидДокумента
		|ИЗ
		|	" + ТекущийВид + " КАК " + ИмяВЗапросе + "
		|ГДЕ
		|	" + ИмяВЗапросе + ".Проведен
		|	И " + ИмяВЗапросе + ".Дата МЕЖДУ &НачалоПериода И &КонецПериода
		|
		|";
		
		Если НЕ Сч = МассивВыбранныхОбъектов.Количество() Тогда
			
			Запрос.Текст = Запрос.Текст + "ОБЪЕДИНИТЬ ВСЕ
			|
			|";
			
		КонецЕсли;
			
		Сч = Сч + 1;
		
	КонецЦикла;
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	ДатаНачалаПерепроведения = ТекущаяДатаСеанса();
	ДатаПоследнейОбработки = ТекущаяУниверсальнаяДатаВМиллисекундах();
	
	Пока Выборка.Следующий() Цикл
		
		ВремяНачала = ДатаПоследнейОбработки;
		
		НоваяСтрока = ОбработанныеДокументы.Добавить();
		НоваяСтрока.ДокументСсылка = Выборка.Ссылка;
		
		ДокументОбъект = Выборка.Ссылка.ПолучитьОбъект();
		
		Попытка
			ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
		Исключение
		КонецПопытки;
		
		ДатаПоследнейОбработки = ТекущаяУниверсальнаяДатаВМиллисекундах(); // Обновляем дату обработки
		
		// Подсчет милисекунд
		НоваяСтрока.ЗанялоМиллисекунд = ДатаПоследнейОбработки - ВремяНачала;
		
	КонецЦикла;
	
	ДатаОкончанияПерепроведения = ТекущаяДатаСеанса();
	
	// Выводим результат в виде отчёта
	РеквизитОбъект = РеквизитФормыВЗначение("Объект");
	Макет = РеквизитОбъект.ПолучитьМакет("Макет");
	
	ОбластьМакета = Макет.ПолучитьОбласть("Шапка");
	
	ОбластьМакета.Параметры.Период = Формат(НачалоПериода, "ДФ=dd.MM.yyyy") + " - " + Формат(КонецПериода, "ДФ=dd.MM.yyyy");
	ОбластьМакета.Параметры.ВидыДокументов = ПредставлениеВидов;
	
	ОбластьМакета.Параметры.ДатаНачала = ДатаНачалаПерепроведения;
	ОбластьМакета.Параметры.ДатаОкончания = ДатаОкончанияПерепроведения;
	
	ВсегоДокументов = ОбработанныеДокументы.Количество();
	ИтогоМиллиСекунд = ОбработанныеДокументы.Итог("ЗанялоМиллисекунд");
	
	ОбластьМакета.Параметры.ВсегоДокуентов = ВсегоДокументов;
	ОбластьМакета.Параметры.ЗатраченноеВремя = СтрШаблон("%1 %2",  ИтогоМиллиСекунд / 1000, "сек.");
	
	// Вычисляем медиану
	ВременнаяТаблица = ОбработанныеДокументы.Выгрузить();
	ВременнаяТаблица.Сортировать("ЗанялоМиллисекунд УБЫВ");
	ВременнаяТаблица.Колонки.Добавить("Доля", Новый ОписаниеТипов("Число"));
	
	МедианнаяСредняя = 0;
	Если ВсегоДокументов > 0 Тогда
		
		НомерПозиции = Мин(Цел(ВсегоДокументов / 2), ВсегоДокументов);
		МедианнаяСредняя = ВременнаяТаблица[НомерПозиции].ЗанялоМиллисекунд;
		
	КонецЕсли;
	
	// Вычисляем среднюю скользящую
	КоличествоСтрок = ОбработанныеДокументы.Количество()-1;
	СредняяСкользящая = 0;
	
	Если КоличествоСтрок >= 3 Тогда
		
		СуммаСкользящей = 0;
		Для Сч = 0 По 3 Цикл
			СуммаСкользящей = СуммаСкользящей + ОбработанныеДокументы[КоличествоСтрок - Сч].ЗанялоМиллисекунд;
		КонецЦикла;
		
		СредняяСкользящая = СуммаСкользящей / 4;
		
	КонецЕсли;
		
	ОбластьМакета.Параметры.СреднееОбщее = СтрШаблон("%1 %2", Формат((ИтогоМиллиСекунд / ВсегоДокументов) / 1000, "ЧДЦ=4"), "сек.");
	ОбластьМакета.Параметры.МедианнаяСредняя = СтрШаблон("%1 %2", Формат(МедианнаяСредняя / 1000, "ЧДЦ=4"), "сек.");
	ОбластьМакета.Параметры.СредняяСкользящая = СтрШаблон("%1 %2", Формат(СредняяСкользящая / 1000, "ЧДЦ=4"), "сек.");
	
	Результат.Вывести(ОбластьМакета);
	
	Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.ГруппаСтраницаРезультат;
	
КонецПроцедуры

