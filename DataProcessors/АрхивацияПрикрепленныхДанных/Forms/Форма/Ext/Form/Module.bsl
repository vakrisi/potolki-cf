Функция ПолучитьМассивРодителейДерева()
	
	РодителиДерева = ФайлыКОбработке.Выгрузить(, "ВидОбъекта");
	РодителиДерева.Свернуть("ВидОбъекта");
	
	Возврат ОбщегоНазначения.ТаблицаЗначенийВМассив(РодителиДерева);
	
КонецФункции

&НаКлиенте
Процедура ФайлыДеревоПометкаПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ФайлыДерево.ТекущиеДанные;
	
	// Поменяли в корне, нужно все подчиненные изменить
	Если ТекущиеДанные.ПолучитьРодителя() = Неопределено Тогда
		
		Для Каждого Родитель Из ФайлыДерево.ПолучитьЭлементы() Цикл
			Если Родитель.ВидОбъекта = ТекущиеДанные.ВидОбъекта Тогда
				Для Каждого ТекущаяСтрока Из Родитель.ПолучитьЭлементы() Цикл
					Пометка = ТекущиеДанные.Пометка;
					Если ТекущаяСтрока.Архивирован Тогда
						Пометка = Ложь;
					КонецЕсли;
					ТекущаяСтрока.Пометка = Пометка;
				КонецЦикла;
			КонецЕсли;
		КонецЦикла;
		
	Иначе
		
		// Поменяли подчиненный корню элемент, если у всех подчиненных элементов один признак, установим его корню
		ПризнакиРавны = Истина;
	    Для Каждого ПодчиненныйЭлемент Из ТекущиеДанные.ПолучитьРодителя().ПолучитьЭлементы() Цикл
			Если НЕ ПодчиненныйЭлемент.Пометка = ТекущиеДанные.Пометка И НЕ ПодчиненныйЭлемент.Архивирован Тогда
				ПризнакиРавны = Ложь;
			КонецЕсли;
		КонецЦикла;
		
		Если ПризнакиРавны Тогда
			ТекущиеДанные.ПолучитьРодителя().Пометка = ТекущиеДанные.Пометка;
		Иначе
			ТекущиеДанные.ПолучитьРодителя().Пометка = Ложь;
		КонецЕсли;
	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьАрхивацию(Команда)
	
	НачатьПодключениеРасширенияРаботыСФайлами(Новый ОписаниеОповещения("КаталогВыгрузкиНачалоВыбораЗавершение1", ЭтотОбъект));
	
КонецПроцедуры

&НаКлиенте
Процедура КаталогВыгрузкиНачалоВыбораЗавершение1(Подключено, ДополнительныеПараметры) Экспорт
    
    Если Не Подключено Тогда
		ОтветОповещения = Новый ОписаниеОповещения("ВыборФайлаЗавершить", ЭтотОбъект);
		ЗадатьВопросУстановкиРасширения(ОтветОповещения);
		
        Возврат;
    КонецЕсли;
    
    Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.ВыборКаталога);
    
    Диалог.Заголовок = НСтр("ru = 'Укажите каталог архивации'");
    Диалог.Каталог = КаталогВыгрузки;
    
    Диалог.Показать(Новый ОписаниеОповещения("КаталогВыгрузкиНачалоВыбораЗавершение", ЭтотОбъект, Новый Структура("Диалог", Диалог)));

КонецПроцедуры

