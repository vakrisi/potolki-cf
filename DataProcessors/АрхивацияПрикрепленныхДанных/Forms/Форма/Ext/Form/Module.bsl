		//	КоличествоПолученныхФайлов = КоличествоПолученныхФайлов + 1;
		//КонецЕсли;
		//-- №9396 комментируем, т.к. переделано на Дерево
		
	Исключение
		
		Возврат 0;
		
	КонецПопытки;

