&НаКлиенте
Процедура АрхивироватьПрикрепленныеДанные(Команда)
	
	// Чтобы выполнить архивацию по варианту в настройках, необходимо подготовить данные
	МассивДляАрхивации = новый Массив;
	
	Для Каждого РодительДерева Из ФайлыДерево.ПолучитьЭлементы() Цикл
		
		Для Каждого ЭлементДерева Из РодительДерева.ПолучитьЭлементы() Цикл
			
			Если НЕ ЭлементДерева.Пометка Тогда
				Продолжить;
			КонецЕсли;	
			
			СтруктураДанных = Новый Структура;
			СтруктураДанных.Вставить("Период", ЭлементДерева.Период);
			СтруктураДанных.Вставить("ВидФайлаПрограммыПостроителя", ЭлементДерева.ВидФайлаПрограммыПостроителя);
			СтруктураДанных.Вставить("СсылкаНаОбъект", ЭлементДерева.СсылкаНаОбъект);
			СтруктураДанных.Вставить("ИмяФайла", ЭлементДерева.ИмяФайла);
			СтруктураДанных.Вставить("ИдентификаторСтроки", ЭлементДерева.ПолучитьИдентификатор());
			
			МассивДляАрхивации.Добавить(СтруктураДанных);
			
		КонецЦикла;
		
	КонецЦикла;
	
	РезультатАрхивации = АрхивироватьПрикрепленныеДанныеНаСервере(МассивДляАрхивации);
	
	// Переносим успешный результат на форму
	Для Каждого СтрокаРезультата Из РезультатАрхивации Цикл
		
		Если Не СтрокаРезультата.Успешно Тогда
			Продолжить;
		КонецЕсли;
		
		ЭлементДерева = ФайлыДерево.НайтиПоИдентификатору(СтрокаРезультата.ИдентификаторСтроки);
		Если НЕ ЭлементДерева = Неопределено Тогда
			
			ЭлементДерева.Архивирован = Истина;
			ЭлементДерева.Пометка = Ложь;
			
		КонецЕсли;
		
	КонецЦикла;
	
	// Обновим признаки "Архивирован" для родителей
	ОбновитьПризникАрхивированДляРодителей();
	
	ПоказатьОповещениеПользователя("Архивация завершена.");
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция АрхивироватьПрикрепленныеДанныеНаСервере(МассивДляАрхивации)
	
	ТаблицаДанных = новый ТаблицаЗначений;
	ТаблицаДанных.Колонки.Добавить("Период", 						новый ОписаниеТипов("Дата"));
	ТаблицаДанных.Колонки.Добавить("ВидФайлаПрограммыПостроителя",	новый ОписаниеТипов("СправочникСсылка.ВидыФайловПрограммыПостроителя"));
	ТаблицаДанных.Колонки.Добавить("ИмяФайла", 						новый ОписаниеТипов("Строка",,,, новый КвалификаторыСтроки(255)));
	ТаблицаДанных.Колонки.Добавить("ИдентификаторСтроки", 			новый ОписаниеТипов("Число"));
	ТаблицаДанных.Колонки.Добавить("Успешно", 						новый ОписаниеТипов("Булево"));
	
	ОписаниеТипаОбъекта = новый ОписаниеТипов;
	ОписаниеТипаОбъекта = новый ОписаниеТипов(ОписаниеТипаОбъекта, Справочники.ТипВсеСсылки().Типы());
	ОписаниеТипаОбъекта = новый ОписаниеТипов(ОписаниеТипаОбъекта, Документы.ТипВсеСсылки().Типы());
	
	ТаблицаДанных.Колонки.Добавить("СсылкаНаОбъект", ОписаниеТипаОбъекта);
	
	Для Каждого ТекущаяСтрока Из МассивДляАрхивации Цикл
		
		НоваяСтрока = ТаблицаДанных.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущаяСтрока);
		
	КонецЦикла;
	
	ОбщийМодульСервер.АрхивацияПрикрепленныхДанных(ТаблицаДанных);
	
	Возврат ОбщегоНазначения.ТаблицаЗначенийВМассив(ТаблицаДанных);
	
КонецФункции

