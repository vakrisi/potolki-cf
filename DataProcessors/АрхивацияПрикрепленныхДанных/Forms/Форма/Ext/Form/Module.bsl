КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьАрхивациюПослеУказанияКаталога()
	
	Если НЕ ЗначениеЗаполнено(КаталогВыгрузки) Тогда
		Возврат;
	КонецЕсли;
	
	СистемнаяИнформация = Новый СистемнаяИнформация;
	ПлатформаWindows = СистемнаяИнформация.ТипПлатформы = ТипПлатформы.Windows_x86
		ИЛИ СистемнаяИнформация.ТипПлатформы = ТипПлатформы.Windows_x86_64;
	
	// Сначала создадим каталоги по видам и объектам
	МассивКаталогов = ПолучитьМассивКаталогов();
	
	Для Каждого КаталогПоВиду Из МассивКаталогов Цикл
		
		// Создаем каталог по виду
		ПолноеИмяКаталогаПоВиду = КаталогВыгрузки + "\" + КаталогПоВиду.ВидОбъекта;
		ПолноеИмяКаталогаПоВиду = ПодготовитьПутьДляПлатформы(ПлатформаWindows, ПолноеИмяКаталогаПоВиду);
		КаталогСоздан = Ложь;
		Попытка
			СоздатьКаталог(ПолноеИмяКаталогаПоВиду);
			КаталогСоздан = Истина;
		Исключение
			Сообщить("Не удалось создать каталог по виду объекта: " + КаталогПоВиду + Символы.ПС + ОписаниеОшибки());
		КонецПопытки;
		
		// Если каталог по виду создан, создаем каталоги по объекту внутри
		Если КаталогСоздан Тогда
			
			Для Каждого КаталогПоОбъекту Из КаталогПоВиду.МассивПодКаталогов Цикл
				
				// Создаем каталог по виду
				ПолноеИмяКаталогаПоОбъекту = ПолноеИмяКаталогаПоВиду + "\" + УбратьЗарезервированныеСимволыВИмениКаталога(КаталогПоОбъекту);
				ПолноеИмяКаталогаПоОбъекту = ПодготовитьПутьДляПлатформы(ПлатформаWindows, ПолноеИмяКаталогаПоОбъекту);
				КаталогСоздан = Ложь;
				Попытка
					СоздатьКаталог(ПолноеИмяКаталогаПоОбъекту);
					КаталогСоздан = Истина;
				Исключение
					Сообщить("Не удалось создать каталог по объекту: " + КаталогПоОбъекту + Символы.ПС + ОписаниеОшибки());
				КонецПопытки;
				
			КонецЦикла
			
		КонецЕсли;
		
	КонецЦикла;
	
	// Теперь выгружаем файлы в каталог и удаляем из базы
	Для Каждого РодительДерева Из ФайлыДерево.ПолучитьЭлементы() Цикл
		
		Для Каждого ЭлементДерева Из РодительДерева.ПолучитьЭлементы() Цикл
			
			Если НЕ ЭлементДерева.Пометка Тогда
				Продолжить;
			КонецЕсли;	
			
			СтруктураДанных = Новый Структура;
			СтруктураДанных.Вставить("Период", ЭлементДерева.Период);
			СтруктураДанных.Вставить("ВидФайлаПрограммыПостроителя", ЭлементДерева.ВидФайлаПрограммыПостроителя);
			СтруктураДанных.Вставить("СсылкаНаОбъект", ЭлементДерева.СсылкаНаОбъект);
			СтруктураДанных.Вставить("ИмяФайла", ЭлементДерева.ИмяФайла);
			
			ДанныеФайла = ПолучитьДанныеФайла(СтруктураДанных);
			
			Если НЕ ДанныеФайла = Неопределено Тогда
				
				ИмяФайлаСРасширением = ЭлементДерева.ИмяФайла + "." + ДанныеФайла.Расширение;
				ПутьФайла = КаталогВыгрузки + "\" + ЭлементДерева.ВидОбъекта + "\" + УбратьЗарезервированныеСимволыВИмениКаталога(Строка(ЭлементДерева.СсылкаНаОбъект)) + "\" + ИмяФайлаСРасширением;
				ПутьФайла = ПодготовитьПутьДляПлатформы(ПлатформаWindows, ПутьФайла);
				
				Попытка
					ПолучитьФайл(ДанныеФайла.АдресВХранилище, ПутьФайла, Ложь);
					ЭлементДерева.Архивирован = Истина;
					ЭлементДерева.Пометка = Ложь;
					УдалитьФайлПослеАрхивации(СтруктураДанных);
				Исключение
					Сообщить("Не удалось выгрузить файл для объекта """ + ЭлементДерева.СсылкаНаОбъект + """ с наименованием: " + ИмяФайлаСРасширением + Символы.ПС + ОписаниеОшибки());
				КонецПопытки;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
	// Обновим признаки "Архивирован" для родителей
	ОбновитьПризникАрхивированДляРодителей();
	
	СформироватьЗаголовокВсегоФайлов();
	
	ПоказатьОповещениеПользователя("Архивация завершена.");
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьПризникАрхивированДляРодителей()
	
	Для Каждого РодительДерева Из ФайлыДерево.ПолучитьЭлементы() Цикл
		ВсеАрхивированы = Истина;
		Для Каждого ЭлементДерева Из РодительДерева.ПолучитьЭлементы() Цикл
			Если НЕ ЭлементДерева.Архивирован Тогда
				ВсеАрхивированы = Ложь;
			КонецЕсли;
		КонецЦикла;
		РодительДерева.Архивирован = ВсеАрхивированы;
		Если РодительДерева.Архивирован Тогда
			РодительДерева.Пометка = Ложь;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьДанныеФайла(СтруктураПоиска)	
	
	МенеджерЗаписи = РегистрыСведений.ПрикрепленныеДанные.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Период						= СтруктураПоиска.Период;
	МенеджерЗаписи.ВидФайлаПрограммыПостроителя = СтруктураПоиска.ВидФайлаПрограммыПостроителя;
	МенеджерЗаписи.СсылкаНаОбъект 				= СтруктураПоиска.СсылкаНаОбъект;
	МенеджерЗаписи.ИмяФайла 					= СтруктураПоиска.ИмяФайла;						

	Попытка
		
		МенеджерЗаписи.Прочитать();
		КВозврату = новый Структура;
		КВозврату.Вставить("Расширение", МенеджерЗаписи.Расширение);
		КВозврату.Вставить("АдресВХранилище", ПоместитьВоВременноеХранилище(МенеджерЗаписи.Данные.Получить(), ЭтаФорма.УникальныйИдентификатор));
		
		Возврат КВозврату;
		
	Исключение
		
		Возврат Неопределено;
		
	КонецПопытки;
	
КонецФункции

&НаКлиенте
Функция ПодготовитьПутьДляПлатформы(ПлатформаWindows, Путь) Экспорт
	
	Если ПлатформаWindows Тогда
		ЧтоМенять = "/";
		НаЧтоМенять = "\";
	Иначе
		ЧтоМенять = "\";
		НаЧтоМенять = "/";
	КонецЕсли;
	
	Путь = СтрЗаменить(Путь, ЧтоМенять, НаЧтоМенять);
	Возврат Путь;
	
КонецФункции

&НаСервере
Функция ПолучитьМассивКаталогов()
	
	ТаблицаКаталогов = новый ТаблицаЗначений;
	ТаблицаКаталогов.Колонки.Добавить("ВидОбъекта", новый ОписаниеТипов("Строка"));
	ТаблицаКаталогов.Колонки.Добавить("МассивПодКаталогов", новый ОписаниеТипов("Массив"));
	
	Для Каждого РодительДерева Из ФайлыДерево.ПолучитьЭлементы() Цикл
		Для Каждого ЭлементДерева Из РодительДерева.ПолучитьЭлементы() Цикл
			
			Если НЕ ЭлементДерева.Пометка Тогда
				Продолжить;
			КонецЕсли;
			
			НайденнаяСтрока = ТаблицаКаталогов.НайтиСтроки(новый Структура("ВидОбъекта", ЭлементДерева.ВидОбъекта));
			Если НайденнаяСтрока.Количество() > 0 Тогда
				НоваяСтрока = НайденнаяСтрока[0];
			Иначе
				НоваяСтрока = ТаблицаКаталогов.Добавить();
			КонецЕсли;
			НоваяСтрока.ВидОбъекта = ЭлементДерева.ВидОбъекта;
			
			Если НоваяСтрока.МассивПодКаталогов.Найти(ЭлементДерева.СсылкаНаОбъект) = Неопределено Тогда
				НоваяСтрока.МассивПодКаталогов.Добавить(ЭлементДерева.СсылкаНаОбъект);
			КонецЕсли;
			
		КонецЦикла;
	КонецЦикла;
	
	Возврат ОбщегоНазначения.ТаблицаЗначенийВМассив(ТаблицаКаталогов);
	
КонецФункции

&НаКлиенте
Функция УбратьЗарезервированныеСимволыВИмениКаталога(ИсходноеИмя)
	
	Рез = ИсходноеИмя;
    Рез = СтрЗаменить(Рез, "\", "");
    Рез = СтрЗаменить(Рез, "/", "");
    Рез = СтрЗаменить(Рез, ":", "");
    Рез = СтрЗаменить(Рез, "*", "");
    Рез = СтрЗаменить(Рез, "?", "");
    Рез = СтрЗаменить(Рез, """", "");
    Рез = СтрЗаменить(Рез, "<", "");
    Рез = СтрЗаменить(Рез, ">", "");
    Рез = СтрЗаменить(Рез, "|", "");
    Рез = СтрЗаменить(Рез, "+", "");
    
    Возврат Рез;
	
КонецФункции

&НаСервере
Процедура УдалитьФайлПослеАрхивации(ЭлементТаблицы)
	
	МенеджерЗаписи = РегистрыСведений.ПрикрепленныеДанные.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Период						= ЭлементТаблицы.Период;
	МенеджерЗаписи.ВидФайлаПрограммыПостроителя = ЭлементТаблицы.ВидФайлаПрограммыПостроителя;
	МенеджерЗаписи.СсылкаНаОбъект 				= ЭлементТаблицы.СсылкаНаОбъект;
	МенеджерЗаписи.ИмяФайла 					= ЭлементТаблицы.ИмяФайла;						
	Попытка
		МенеджерЗаписи.Прочитать();
		МенеджерЗаписи.Удалить();
	Исключение
		Сообщить(ОписаниеОшибки());
	КонецПопытки;
	
КонецПроцедуры
