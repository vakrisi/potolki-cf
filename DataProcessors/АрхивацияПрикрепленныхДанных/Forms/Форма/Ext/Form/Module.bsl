
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	СформироватьЗаголовокВсегоФайлов();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьЗаголовокВсегоФайлов(Команда)
	СформироватьЗаголовокВсегоФайлов();	
КонецПроцедуры

&НаСервере
Процедура СформироватьЗаголовокВсегоФайлов()
	
	СтруктураРезультата = ПолучитьКоличествоФайловНаСервере();
	 
	ТекстДекорации = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		"Всего файлов в базе: %1 (объем %2 Кб)",
		Формат(СтруктураРезультата.Количество, "ЧГ="), 
		Формат(СтруктураРезультата.Размер, "ЧДЦ=; ЧРГ="));
		
	Элементы.ДекорацияВсегоФайлов.Заголовок = ТекстДекорации;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьКоличествоФайловНаСервере()
	
	СтруктураРезультата = Новый Структура("Количество, Размер", 0, 0);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	КОЛИЧЕСТВО(*) КАК Количество,
	|	Сумма(ПрикрепленныеДанные.Размер) КАК Размер
	|ИЗ
	|	РегистрСведений.ПрикрепленныеДанные КАК ПрикрепленныеДанные
	|ГДЕ
	|	НЕ ПрикрепленныеДанные.Архивирован";
	
	Запрос.УстановитьПараметр("ИспользоватьДатаНачала", НачалоДатаФайла <> Дата(1, 1, 1));
	Запрос.УстановитьПараметр("ИспользоватьДатаКонца", 	КонецДатаФайла<> Дата(1, 1, 1));
	Запрос.УстановитьПараметр("ДатаНачала", 			НачалоДня(НачалоДатаФайла));
	Запрос.УстановитьПараметр("ДатаКонца", 				КонецДня(КонецДатаФайла));
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	Если Выборка.Следующий() Тогда
		СтруктураРезультата.Количество = Выборка.Количество;
		СтруктураРезультата.Размер = Выборка.Размер;
	КонецЕсли;
	
	Возврат СтруктураРезультата;
	
КонецФункции

&НаСервере
Процедура ПолучитьДанныеНаСервере()
	
	ФайлыДерево.ПолучитьЭлементы().Очистить();
	ФайлыКОбработке.Очистить();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ПрикрепленныеДанные.Период,
	|	ПрикрепленныеДанные.ИмяФайла,
	|	ПрикрепленныеДанные.ВидФайлаПрограммыПостроителя,
	|	ПрикрепленныеДанные.СсылкаНаОбъект,
	|	ПрикрепленныеДанные.Размер
	|ИЗ
	|	РегистрСведений.ПрикрепленныеДанные КАК ПрикрепленныеДанные
	|ГДЕ
	|	НЕ ПрикрепленныеДанные.Архивирован
	|	И ВЫБОР
	|			КОГДА &ИспользоватьДатаНачала
	|				ТОГДА ПрикрепленныеДанные.Период >= &ДатаНачала
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|	И ВЫБОР
	|			КОГДА &ИспользоватьДатаКонца
	|				ТОГДА ПрикрепленныеДанные.Период <= &ДатаКонца
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|	И ВЫБОР
	|		КОГДА &ИспользоватьОтборПоРазмеру
	|			ТОГДА ПрикрепленныеДанные.Размер > &РазмерБолее
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ
	|
	|УПОРЯДОЧИТЬ ПО
	|	Период";
	
	Запрос.УстановитьПараметр("ИспользоватьДатаНачала", НачалоДатаФайла <> Дата(1, 1, 1));
	Запрос.УстановитьПараметр("ИспользоватьДатаКонца", 	КонецДатаФайла<> Дата(1, 1, 1));
	Запрос.УстановитьПараметр("ДатаНачала", 			НачалоДня(НачалоДатаФайла));
	Запрос.УстановитьПараметр("ДатаКонца", 				КонецДня(КонецДатаФайла));
	Запрос.УстановитьПараметр("ИспользоватьОтборПоРазмеру", ИспользоватьОтборПоРазмеру);
	Запрос.УстановитьПараметр("РазмерБолее", РазмерБолее);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = ФайлыКОбработке.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		НоваяСтрока.ВидОбъекта = НоваяСтрока.СсылкаНаОбъект.Метаданные().Имя;
	КонецЦикла;
	Элементы.Индикатор.МаксимальноеЗначение = Выборка.Количество();
	
КонецПроцедуры

&НаСервере
