	//Если тз_Подчиненные.Количество() = 0 Тогда
	//	возврат 0;
	//Иначе
	//	тз_Подчиненные.Сортировать("УровеньДетализации УБЫВ");	
	//	возврат тз_Подчиненные[0].УровеньДетализации;
	//КонецЕсли;
	кол = 0;
	Если ЗначениеЗаполнено(СтрокаДетализации.Аналитика1) Тогда
		кол = кол + 1;
	Иначе
		Возврат кол;
	КонецЕсли;
	Если ЗначениеЗаполнено(СтрокаДетализации.Аналитика2) Тогда
