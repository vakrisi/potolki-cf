&НаКлиенте
Перем КонтрольРазмераВкл;

&НаКлиенте
Процедура Обновить(Команда)
	
	Если Объект.Настройка.Пустая() Тогда
		Возврат;
	КонецЕсли;
	
	Если Объект.ДатаНачала>Объект.ДатаКонца Тогда 
		Сообщить("Неверно указаны даты построения графиков!");
		Возврат;
	КонецЕсли;

	тз_Подчиненные.Очистить();
	ОбновитьПер = ДеревоСтатистик.ПолучитьЭлементы().Количество() = 0;
	ЗагрузитьНастройку(-1,РучнойТипПериода,ложь,ложь,ОбновитьПер, ложь,истина);
	НарисоватьДиаграммы();
	ВидимостьКнопокКонтекстногоМеню();
	
КонецПроцедуры


&НаКлиенте
Процедура НарисоватьДиаграммы(Пересчитывать = истина) Экспорт
	
	Если Объект.ДатаКонца<=Объект.ДатаНачала Тогда
		Возврат;
	КонецЕсли;
	
	       
	Если ВебКлиент Тогда
		СформироватьКартинкуВеб(Пересчитывать);
	ИНАЧЕ	
		// Определение разрешения экрана
		ОпределитьРазрешениеЭкрана();
		
		ДанныеХТМЛ_текст = СформироватьКартинку(Пересчитывать);
		РезСтраницаИмя = ИА_Статистики_Клиент.ПолучитьФайлСтраницы(ДанныеХТМЛ_текст,"stat");		
			
		НадоОбновить = ДанныеХТМЛ<>"";
		
		ДанныеХТМЛ = РезСтраницаИмя;
		Если НадоОбновить Тогда
			
			Попытка
				Элементы.ПолеХТМЛ.Документ.location.reload();
			Исключение
				Попытка
					Элементы.ПолеХТМЛ.Документ.parentWindow.location.reload();
				Исключение
					Элементы.ПолеХТМЛ.Документ.window.location.reload();
				КонецПопытки;
			КонецПопытки;
			
		КонецЕсли;
	КОНЕЦЕСЛИ
	
КонецПроцедуры

&НаСервере
Процедура СформироватьКартинкуВеб(Пересчитывать)
	деревоСТ = РеквизитФормыВЗначение("ДеревоСтатистик");
	ИА_Статистики.СформироватьКартинкуВеб(ЭтаФорма,Объект, деревоСТ, Пересчитывать, ложь , ложь, ложь, ложь, Неопределено, Неопределено);	
	ЗначениеВРеквизитФормы(деревоСТ,"ДеревоСтатистик");
КонецПроцедуры

&НаСервере
Функция СформироватьКартинку(Пересчитывать, ВызовИЦО = Ложь, ВызовМоиСтатистики = Ложь, НаПечать = Ложь, Зарплата = ложь, ДопПараметры = Неопределено, ПериодДетализации = Неопределено) Экспорт
	
	деревоСТ = РеквизитФормыВЗначение("ДеревоСтатистик");
	
	ТекстХТМЛ = ИА_Статистики.СформироватьКартинку(Объект,sw,деревоСТ, Пересчитывать, ВызовИЦО , ВызовМоиСтатистики, НаПечать, Зарплата, ДопПараметры, ПериодДетализации);	
	
	ЗначениеВРеквизитФормы(деревоСТ, "ДеревоСтатистик");
	          	
	Возврат ТекстХТМЛ;
КонецФункции

&НаКлиенте
Процедура ОпределитьРазрешениеЭкрана()	
	Попытка
		к = Элементы.ПолеХТМЛ.Документ.body.clientWidth;
		sw = к;
	Исключение
		sw = 800;
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура НастройкаПриИзменении(Элемент) Экспорт
	
	ПодключитьОбработчикОжидания("НастройкаПриИзмененииОтложенная",0.1,Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура НастройкаПриИзмененииОтложенная() Экспорт
	
	тз_Подчиненные.Очистить();
	ЗагрузитьНастройку();
		
	Если не Объект.Настройка.Пустая() И ЗначениеЗаполнено(Объект.ДатаНачала) И ЗначениеЗаполнено(Объект.ДатаКонца) Тогда
		НарисоватьДиаграммы();
	КонецЕсли;
	
	ВидимостьКнопокКонтекстногоМеню();
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьНастройкуБезПериодов() Экспорт
	
	тз_Подчиненные.Очистить();
	ЗагрузитьНастройку(,,,,Ложь);
		
	Если не Объект.Настройка.Пустая() И ЗначениеЗаполнено(Объект.ДатаНачала) И ЗначениеЗаполнено(Объект.ДатаКонца) Тогда
		НарисоватьДиаграммы();
	КонецЕсли;
	ВидимостьКнопокКонтекстногоМеню();
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьПериоды(ТипПериода)
		
	Если ДатаКонцаПредопределенная = Дата(1,1,1) Тогда
		текДата = ТекущаяДата();
	Иначе
		текДата = ДатаКонцаПредопределенная;
	КонецЕсли;
		
	Если ТипПериода = Перечисления.ИА_ПериодыДетализации.День тогда
		Если ТолькоЗавершПериоды Тогда
			Объект.ДатаКонца = КонецДня(текДата) - 60*60*24;
		Иначе
			Объект.ДатаКонца = КонецДня(текДата);
		КонецЕсли;
		
		Объект.ДатаНачала = Объект.ДатаКонца - 60*60*24 * (Объект.Настройка.КоличествоПериодов-1);
		
	ИначеЕсли ТипПериода = Перечисления.ИА_ПериодыДетализации.Неделя  тогда
		
		НачалоНедели = Константы.ИА_НачалоНедели.Получить();
		
		Если НачалоНедели > 1 Тогда
			
			Объект.ДатаКонца = ИА_Статистики.ИА_КонецНедели(текДата);
			Если ТолькоЗавершПериоды и ДеньНедели(текДата) <> НачалоНедели-1 Тогда
				Объект.ДатаКонца = Объект.ДатаКонца - 60*60*24*7;
			КонецЕсли;		
			
			Объект.ДатаНачала = Объект.ДатаКонца - 60*60*24*7 * (Объект.Настройка.КоличествоПериодов) + 60*60*24;			
		Иначе
			
			Объект.ДатаКонца = КонецНедели(текДата);
			Если ТолькоЗавершПериоды Тогда
				Объект.ДатаКонца = Объект.ДатаКонца - 60*60*24*7;
			КонецЕсли;
			
			Объект.ДатаНачала = НачалоНедели(Объект.ДатаКонца) - 60*60*24*7 * (Объект.Настройка.КоличествоПериодов-1);			
		КонецЕсли;

		
	ИначеЕсли ТипПериода = Перечисления.ИА_ПериодыДетализации.Месяц тогда 
		
		Объект.ДатаКонца = КонецМесяца(текДата);
		
		Если ТолькоЗавершПериоды и КонецДня(текДата) <> КонецДня(Объект.ДатаКонца) Тогда
			Объект.ДатаКонца = КонецМесяца(ДобавитьМесяц(НачалоМесяца(текДата),-1));
		КонецЕсли;
		
		Объект.ДатаНачала = НачалоМесяца(ДобавитьМесяц(Объект.ДатаКонца, -(Объект.Настройка.КоличествоПериодов-1)));
		
	ИначеЕсли ТипПериода = Перечисления.ИА_ПериодыДетализации.Квартал тогда
		
		Объект.ДатаКонца = КонецКвартала(текДата);
		
		Если ТолькоЗавершПериоды и КонецДня(текДата) <> КонецДня(Объект.ДатаКонца) Тогда
			Объект.ДатаКонца = КонецМесяца(ДобавитьМесяц(НачалоМесяца(Объект.ДатаКонца),-3));
		КонецЕсли;
		
		Объект.ДатаНачала = НачалоМесяца(ДобавитьМесяц(Объект.ДатаКонца+1, -(Объект.Настройка.КоличествоПериодов)*3));
		
	ИначеЕсли ТипПериода = Перечисления.ИА_ПериодыДетализации.Год тогда
		
		Объект.ДатаКонца = КонецГода(текДата);
		Если ТолькоЗавершПериоды и КонецДня(текДата) <> КонецДня(Объект.ДатаКонца) Тогда
			Объект.ДатаКонца = КонецГода(ДобавитьМесяц(текДата,-12));
		КонецЕсли;
		
		Объект.ДатаНачала = НачалоГода(ДобавитьМесяц(Объект.ДатаКонца, -(Объект.Настройка.КоличествоПериодов-1)*12));
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьНастройку(ФильтрНомерСтатистики = -1, ПериодДетализации = Неопределено, ЭтоМойРабочийСтол = Ложь, ВыводДетализации = Ложь, ОбновитьПериоды1 = Истина, ЭтоИЦО = ложь, ОбновитьКолВСтроке=истина) Экспорт
	// проверка на корректность
	Для каждого стр из Объект.Настройка.Статистики Цикл
		Если сокрлп(стр.ЗаголовокДиаграммы) = "" Тогда
			Сообщить("Должны быть заполнены заголовки диаграмм!");
			Возврат;
		КонецЕсли;
		Если стр.ПериодДетализации.Пустая() Тогда
			Сообщить("Укажите детализацию статистик!");
			Возврат;
		КонецЕсли;
	КонецЦикла;
    
    Для каждого КиЗ из СписокВыбранныхНастроекСтатистик Цикл
        Для каждого стр из КиЗ.Настройка.Статистики Цикл
            Если сокрлп(стр.ЗаголовокДиаграммы) = "" Тогда
                Сообщить("Должны быть заполнены заголовки диаграмм!");
                Возврат;
            КонецЕсли;
            Если стр.ПериодДетализации.Пустая() Тогда
                Сообщить("Укажите детализацию статистик!");
                Возврат;
            КонецЕсли;
        КонецЦикла;
	КонецЦикла;
    
	// установка периодов
	Если Объект.Настройка.КоличествоПериодов <> 0 и не Объект.Настройка.ОсновнойПериод.Пустая() И ОбновитьПериоды1 Тогда
		РучнойТипПериода = Перечисления.ИА_ПериодыДетализации.ПустаяСсылка();
		ОбновитьПериоды(Объект.Настройка.ОсновнойПериод);	
	КонецЕсли;
	
	// загрузка
	ДеревоСтатистик.ПолучитьЭлементы().Очистить();
    
	Если ВыводДетализации Тогда
		ДеревоСт = СформироватьДеревоСтатистикПоАналитикам();
	Иначе
		ДеревоСт = СформироватьДеревоСтатистик(ЭтоМойРабочийСтол, ЭтоИЦО);
	КонецЕсли;
    
	ЭлДерева = ДеревоСтатистик.ПолучитьЭлементы();
	сч = 0;
	Для каждого стр0 из ДеревоСт.Строки Цикл
		Для каждого стр1 из Стр0.Строки Цикл
			Для каждого стр2 из стр1.Строки Цикл
				Если ФильтрНомерСтатистики > -1 И сч <> ФильтрНомерСтатистики Тогда
					сч = сч + 1;
					Продолжить;
				КонецЕсли;
				Новстр2 = ЭлДерева.Добавить();
				ЗаполнитьЗначенияСвойств(Новстр2, стр2);
				Если ПериодДетализации <> Неопределено и не ПериодДетализации.Пустая() Тогда
					Новстр2.ПериодДетализации = ПериодДетализации;
				КонецЕсли;
				Для каждого стр3 из стр2.Строки Цикл
					Новстр3 = Новстр2.ПолучитьЭлементы().Добавить();
					ЗаполнитьЗначенияСвойств(Новстр3, стр3);
					Если ПериодДетализации <> Неопределено и не ПериодДетализации.Пустая() Тогда
						Новстр3.ПериодДетализации = ПериодДетализации;
					КонецЕсли;
				КонецЦикла;
				сч = сч + 1;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	
	Если (не ВыводДетализации) и ОбновитьКолВСтроке Тогда
		Объект.КоличествоВСтроке = Объект.Настройка.КоличествоВСтроке;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция СформироватьДеревоСтатистик(ЭтоМойРабочийСтол = Ложь, ЭтоИЦО = ложь)
	
    Если СписокВыбранныхНастроекСтатистик.Количество() < 2 Тогда
        Запрос = Новый Запрос;	
		Запрос.Текст = "ВЫБРАТЬ
		               |	ИА_КвотыСтатистикСрезПоследних.ВидСтатистики,
		               |	ИА_КвотыСтатистикСрезПоследних.ПериодДетализации,
		               |	ИА_КвотыСтатистикСрезПоследних.Аналитика1,
		               |	ИА_КвотыСтатистикСрезПоследних.Аналитика2,
		               |	ИА_КвотыСтатистикСрезПоследних.Аналитика3,
		               |	ИА_КвотыСтатистикСрезПоследних.ТипКвоты,
		               |	ИА_КвотыСтатистикСрезПоследних.Квота
		               |ПОМЕСТИТЬ вт
		               |ИЗ
		               |	РегистрСведений.ИА_КвотыСтатистик.СрезПоследних(&ДатаКонца, ) КАК ИА_КвотыСтатистикСрезПоследних
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ
		               |	ИА_НастройкиРабочегоСтолаСтатистикСтатистики.ЗаголовокДиаграммы КАК ЗаголовокДиаграммы,
		               |	ИА_НастройкиРабочегоСтолаСтатистикСтатистики.ВидСтатистики,
		               |	ИА_НастройкиРабочегоСтолаСтатистикСтатистики.Аналитика1,
		               |	ИА_НастройкиРабочегоСтолаСтатистикСтатистики.Аналитика2,
		               |	ИА_НастройкиРабочегоСтолаСтатистикСтатистики.Аналитика3,
		               |	ИА_НастройкиРабочегоСтолаСтатистикСтатистики.ПериодДетализации КАК ПериодДетализации,
		               |	ИА_НастройкиРабочегоСтолаСтатистикСтатистики.ЦветГрафикаХран КАК ЦветГрафика,
		               |	ИА_НастройкиРабочегоСтолаСтатистикСтатистики.ЦветГрафикаНарастающейКвотыХран КАК ЦветГрафикаНарастающейКвоты,
		               |	ИА_НастройкиРабочегоСтолаСтатистикСтатистики.НаименованиеДляЛегенды,
		               |	ИА_НастройкиРабочегоСтолаСтатистикСтатистики.ПоказыватьВИЦО КАК ПоказыватьВИЦО,
		               |	ЕСТЬNULL(вт.ТипКвоты, ЗНАЧЕНИЕ(Перечисление.ИА_ТипыКвот.ПустаяСсылка)) КАК ТипКвоты,
		               |	ЕСТЬNULL(вт.Квота, 0) КАК Квота,
		               |	ЕСТЬNULL(вт.ПериодДетализации, ЗНАЧЕНИЕ(Перечисление.ИА_ПериодыДетализации.ПустаяСсылка)) КАК ПериодДетализацииКвоты,
		               |	ИА_НастройкиРабочегоСтолаСтатистикСтатистики.ВидСтатистики.ШиринаЛинии КАК ШиринаЛинии,
		               |	ИА_НастройкиРабочегоСтолаСтатистикСтатистики.УзорТочки,
		               |	ЗНАЧЕНИЕ(Справочник.Оргсхема.ПустаяСсылка) КАК Пост,
		               |	ИА_НастройкиРабочегоСтолаСтатистикСтатистики.МаштабМинимум,
		               |	ИА_НастройкиРабочегоСтолаСтатистикСтатистики.МаштабМаксимум,
		               |	ИА_НастройкиРабочегоСтолаСтатистикСтатистики.СдвигПериода,
		               |	ИА_НастройкиРабочегоСтолаСтатистикСтатистики.ВидСдвигаПериода
		               |ИЗ
		               |	Справочник.ИА_НастройкиРабочегоСтолаСтатистик.Статистики КАК ИА_НастройкиРабочегоСтолаСтатистикСтатистики
		               |		ЛЕВОЕ СОЕДИНЕНИЕ вт КАК вт
		               |		ПО ИА_НастройкиРабочегоСтолаСтатистикСтатистики.ВидСтатистики = вт.ВидСтатистики
		               |			И ИА_НастройкиРабочегоСтолаСтатистикСтатистики.Аналитика1 = вт.Аналитика1
		               |			И ИА_НастройкиРабочегоСтолаСтатистикСтатистики.Аналитика2 = вт.Аналитика2
		               |			И ИА_НастройкиРабочегоСтолаСтатистикСтатистики.Аналитика3 = вт.Аналитика3
		               |			И ИА_НастройкиРабочегоСтолаСтатистикСтатистики.ИА_ПериодКвоты = вт.ПериодДетализации
		               |			И ИА_НастройкиРабочегоСтолаСтатистикСтатистики.ИА_ТипКвоты = вт.ТипКвоты
		               |ГДЕ
		               |	ИА_НастройкиРабочегоСтолаСтатистикСтатистики.Ссылка = &Ссылка
		               |	И ИА_НастройкиРабочегоСтолаСтатистикСтатистики.ВидСтатистики <> ЗНАЧЕНИЕ(Справочник.ИА_ВидыСтатистик.ПустаяСсылка)
		               |	И 1 = 1
		               |
		               |УПОРЯДОЧИТЬ ПО
		               |	ИА_НастройкиРабочегоСтолаСтатистикСтатистики.НомерСтроки
		               |ИТОГИ
		               |	МАКСИМУМ(ПоказыватьВИЦО),МИНИМУМ(МаштабМинимум),МАКСИМУМ(МаштабМаксимум)
		               |ПО
		               |	Пост,
		               |	ЗаголовокДиаграммы,
		               |	ПериодДетализации
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |УНИЧТОЖИТЬ вт";

        ЗАпрос.УстановитьПараметр("Ссылка", Объект.Настройка);
	иначе
		ТЗ1 = ИА_БФС.ТЗ_НоваяТаблицаЗначений(Новый Структура("Настройка, Порядок, Пост"
		,Новый ОписаниеТипов("СправочникСсылка.ИА_НастройкиРабочегоСтолаСтатистик")
		,Новый ОписаниеТипов("Число")
		,Новый ОписаниеТипов("СправочникСсылка.ОргСхема")
		));
		                           
		Ц = 0;
		Для каждого КиЗ Из СписокВыбранныхНастроекСтатистик Цикл
		    Ц = Ц + 1;
		    НовСтрока = ТЗ1.Добавить();	
		    НовСтрока.Настройка = КиЗ.Настройка;
			НовСтрока.Пост = КиЗ.Пост;
		    НовСтрока.Порядок = Ц;
		КонецЦикла;
        
        Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	ТЗ.Настройка КАК Настройка,
		               |	ТЗ.Пост КАК Пост,
		               |	ТЗ.Порядок КАК Порядок
		               |ПОМЕСТИТЬ ТЗ
		               |ИЗ
		               |	&ТЗ КАК ТЗ
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ
		               |	ИА_НастройкиРабочегоСтолаСтатистикСтатистики.ЗаголовокДиаграммы КАК ЗаголовокДиаграммы,
		               |	ИА_НастройкиРабочегоСтолаСтатистикСтатистики.ВидСтатистики,
		               |	ИА_НастройкиРабочегоСтолаСтатистикСтатистики.Аналитика1,
		               |	ИА_НастройкиРабочегоСтолаСтатистикСтатистики.Аналитика2,
		               |	ИА_НастройкиРабочегоСтолаСтатистикСтатистики.Аналитика3,
		               |	ИА_НастройкиРабочегоСтолаСтатистикСтатистики.ПериодДетализации КАК ПериодДетализации,
		               |	ИА_НастройкиРабочегоСтолаСтатистикСтатистики.ЦветГрафикаХран КАК ЦветГрафика,
		               |	ИА_НастройкиРабочегоСтолаСтатистикСтатистики.ЦветГрафикаНарастающейКвотыХран КАК ЦветГрафикаНарастающейКвоты,
		               |	ИА_НастройкиРабочегоСтолаСтатистикСтатистики.НаименованиеДляЛегенды,
		               |	ИА_НастройкиРабочегоСтолаСтатистикСтатистики.ПоказыватьВИЦО КАК ПоказыватьВИЦО,
		               |	ТЗ.Порядок * 1000 + ИА_НастройкиРабочегоСтолаСтатистикСтатистики.НомерСтроки КАК Порядок,
		               |	ИА_НастройкиРабочегоСтолаСтатистикСтатистики.ИА_ПериодКвоты,
		               |	ИА_НастройкиРабочегоСтолаСтатистикСтатистики.ИА_ТипКвоты,
		               |	ИА_НастройкиРабочегоСтолаСтатистикСтатистики.ВидСтатистики.ШиринаЛинии КАК ШиринаЛинии,
		               |	ИА_НастройкиРабочегоСтолаСтатистикСтатистики.УзорТочки,
		               |	ТЗ.Пост,
		               |	ИА_НастройкиРабочегоСтолаСтатистикСтатистики.МаштабМинимум,
		               |	ИА_НастройкиРабочегоСтолаСтатистикСтатистики.МаштабМаксимум,
		               |	ИА_НастройкиРабочегоСтолаСтатистикСтатистики.СдвигПериода,
		               |	ИА_НастройкиРабочегоСтолаСтатистикСтатистики.ВидСдвигаПериода
		               |ПОМЕСТИТЬ Таб
		               |ИЗ
		               |	Справочник.ИА_НастройкиРабочегоСтолаСтатистик.Статистики КАК ИА_НастройкиРабочегоСтолаСтатистикСтатистики
		               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТЗ КАК ТЗ
		               |		ПО ИА_НастройкиРабочегоСтолаСтатистикСтатистики.Ссылка = ТЗ.Настройка
		               |ГДЕ
		               |	ИА_НастройкиРабочегоСтолаСтатистикСтатистики.ВидСтатистики <> ЗНАЧЕНИЕ(Справочник.ИА_ВидыСтатистик.ПустаяСсылка)
		               |	И 1 = 1
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ
		               |	ИА_КвотыСтатистикСрезПоследних.ВидСтатистики,
		               |	ИА_КвотыСтатистикСрезПоследних.ПериодДетализации,
		               |	ИА_КвотыСтатистикСрезПоследних.Аналитика1,
		               |	ИА_КвотыСтатистикСрезПоследних.Аналитика2,
		               |	ИА_КвотыСтатистикСрезПоследних.Аналитика3,
		               |	ИА_КвотыСтатистикСрезПоследних.ТипКвоты,
		               |	ИА_КвотыСтатистикСрезПоследних.Квота
		               |ПОМЕСТИТЬ вт
		               |ИЗ
		               |	РегистрСведений.ИА_КвотыСтатистик.СрезПоследних(&ДатаКонца, ) КАК ИА_КвотыСтатистикСрезПоследних
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ
		               |	Т.ЗаголовокДиаграммы КАК ЗаголовокДиаграммы,
		               |	Т.ВидСтатистики,
		               |	Т.Аналитика1,
		               |	Т.Аналитика2,
		               |	Т.Аналитика3,
		               |	Т.ПериодДетализации КАК ПериодДетализации,
		               |	Т.ЦветГрафика,
		               |	Т.ЦветГрафикаНарастающейКвоты,
		               |	Т.НаименованиеДляЛегенды,
		               |	Т.ПоказыватьВИЦО КАК ПоказыватьВИЦО,
		               |	ЕСТЬNULL(вт.ТипКвоты, ЗНАЧЕНИЕ(Перечисление.ИА_ТипыКвот.ПустаяСсылка)) КАК ТипКвоты,
		               |	ЕСТЬNULL(вт.Квота, 0) КАК Квота,
		               |	ЕСТЬNULL(вт.ПериодДетализации, ЗНАЧЕНИЕ(Перечисление.ИА_ПериодыДетализации.ПустаяСсылка)) КАК ПериодДетализацииКвоты,
		               |	Т.ШиринаЛинии КАК ШиринаЛинии,
		               |	Т.УзорТочки КАК УзорТочки,
		               |	Т.Пост КАК Пост,
		               |	Т.МаштабМинимум,
		               |	Т.МаштабМаксимум,
		               |	Т.СдвигПериода,
		               |	Т.ВидСдвигаПериода,
					   |    0 как НомерТекущейДаты
		               |ИЗ
		               |	Таб КАК Т
		               |		ЛЕВОЕ СОЕДИНЕНИЕ вт КАК вт
		               |		ПО Т.ВидСтатистики = вт.ВидСтатистики
		               |			И Т.Аналитика1 = вт.Аналитика1
		               |			И Т.Аналитика2 = вт.Аналитика2
		               |			И Т.Аналитика3 = вт.Аналитика3
		               |			И Т.ИА_ПериодКвоты = вт.ПериодДетализации
		               |			И Т.ИА_ТипКвоты = вт.ТипКвоты
		               |
		               |УПОРЯДОЧИТЬ ПО
		               |	Т.Порядок
		               |ИТОГИ
		               |	МАКСИМУМ(ПоказыватьВИЦО),МИНИМУМ(МаштабМинимум),МАКСИМУМ(МаштабМаксимум)
		               |ПО
		               |	Пост,
		               |	ЗаголовокДиаграммы,
		               |	ПериодДетализации
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |УНИЧТОЖИТЬ вт";
	    Запрос.УстановитьПараметр("ТЗ", ТЗ1);
	КонецЕсли;
	
	Если ЭтоМойРабочийСтол Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "1 = 1",
			"ИА_НастройкиРабочегоСтолаСтатистикСтатистики.ИА_НеОтображатьНаРабочемСтоле = ЛОЖЬ ");
	КонецЕсли;		
	Если ЭтоИЦО Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "1 = 1",
			"ИА_НастройкиРабочегоСтолаСтатистикСтатистики.ПоказыватьВИЦО = ИСТИНА ");
	КонецЕсли;			
	
	ЗАпрос.УстановитьПараметр("ДатаКонца", КонецДня(Объект.ДатаКонца) + 1);
    ДеревоСт = Запрос.Выполнить().Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкамСИерархией);
	
	Возврат ДеревоСт;
	
