&НаСервереБезКонтекста
Функция ПолучитьАналитикиДетализации(СтрокаДерева,ОбъектДатаНачала, ОбъектДатаКонца, НомерАналитики)
	РезТЗ_Данные = ИА_Защита_Статистика.ПолучитьТЗДанныеСтатистики(СтрокаДерева, ОбъектДатаНачала, ОбъектДатаКонца);
	Аналитика = "Аналитика"+ НомерАналитики;
	
	РезТЗ_Данные.Свернуть(Аналитика);
	Рез = новый Массив;
	Для каждого стр из РезТЗ_Данные Цикл
		Если ЗначениеЗаполнено(стр[Аналитика]) Тогда
			рез.Добавить(стр[Аналитика]);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Рез;
КонецФункции

&НаСервере
Функция ПодготовитьДетализацию(номерСтатистики)
	
	деревоСТ = РеквизитФормыВЗначение("ДеревоСтатистик");
	
	СтрокиДетализации = деревоСТ.Строки[номерСтатистики].Строки;

	СтрокаДетализации = СтрокиДетализации[0];
	СтатистикаДетализации = СтрокаДетализации.ВидСтатистики;
	
	ТекУровень = ПолучитьТекУровеньДетализации(СтрокаДетализации);
	МаксУровень = ПолучитьКоличествоАналитик(СтатистикаДетализации);
	
	Если ТекУровень >= МаксУровень Тогда
		Сообщить("Достигнут максимальный уровень детализации!");
		возврат ложь;
	КонецЕсли;
	
	НомерТекущейАналитики = ТекУровень + 1;
	
	//
	ВозможныеАналитики =  ПолучитьАналитикиДетализации(СтрокаДетализации,Объект.ДатаНачала, Объект.ДатаКонца, НомерТекущейАналитики);
	Если ВозможныеАналитики.Количество() = 0 Тогда
		Сообщить("Невозможно вывести подчиненные статистики т.к. нет значений в указанном периоде по данной детализации.");
		Возврат ложь;
	КонецЕсли;
	
	Для каждого значАналитики из ВозможныеАналитики Цикл
		Новстр = тз_Подчиненные.Добавить();
		ЗаполнитьЗначенияСвойств(Новстр, СтрокаДетализации);
		Новстр["Аналитика"+НомерТекущейАналитики] = значАналитики;
		Новстр.УровеньДетализации =  НомерТекущейАналитики;
		
		Новстр.ЗаголовокДиаграммы = Новстр.ЗаголовокДиаграммы + " (" + СокрЛП(значАналитики) + ")";
	КонецЦикла;
	//
	
	тз_Подчиненные.Сортировать("ЗаголовокДиаграммы");
	инд = 1;
	Для каждого стр из тз_Подчиненные Цикл
		стр.ПорядковыйНомер = инд;
		инд = инд + 1;
	КонецЦикла;
	
	ЗагрузитьНастройку(,,,Истина,Ложь,,ложь);
	
	возврат истина;
	
КонецФункции

&НаКлиенте
Процедура НазадОтПодчиненных(Команда)
	
	ОбновитьТекущуюТЗ();
	Если тз_Подчиненные.Количество()>0 Тогда 
		ЗагрузитьНастройку(,,, Истина,Ложь,,ложь);
		НарисоватьДиаграммы(истина);
	Иначе
		ЗагрузитьНастройкуБезПериодов();
	КонецЕсли;
	
	ВидимостьКнопокКонтекстногоМеню();
	
КонецПроцедуры

&НаСервере
Функция ПолучитьТекУровеньДетализацииПоПодч()
	Если тз_Подчиненные.Количество() = 0 Тогда
		возврат 0;
	Иначе
		тз_Подчиненные.Сортировать("УровеньДетализации УБЫВ");	
		возврат тз_Подчиненные[0].УровеньДетализации;
	КонецЕсли;
КонецФункции

&НаСервере
Функция ОбновитьТекущуюТЗ()
	ТекУр = ПолучитьТекУровеньДетализацииПоПодч(); 
	сч = тз_Подчиненные.Количество() - 1;
	Пока сч>=0 Цикл
		Если тз_Подчиненные[сч].УровеньДетализации =  ТекУр Тогда
			тз_Подчиненные.Удалить(сч);
		КонецЕсли;
		сч = сч - 1;
	КонецЦикла;
КонецФункции 

&НаКлиенте
Функция ВидимостьКнопокКонтекстногоМеню()
	кнНазад = Элементы.ПолеХТМЛКонтекстноеМенюНазадОтПодчиненных;
	кнНазад.Видимость = тз_Подчиненные.Количество()>0;
КонецФункции // ВидимостьКнопокКонтекстногоМеню()


&НаСервере
Функция СформироватьДеревоСтатистикПоАналитикам()
	                    	
	Запрос = Новый Запрос; 
	Запрос.Текст = "ВЫБРАТЬ
	               |	тз.ЗаголовокДиаграммы,
	               |	тз.ВидСтатистики,
	               |	тз.Аналитика1,
	               |	тз.Аналитика2,
	               |	тз.Аналитика3,
	               |	тз.ПериодДетализации,
	               |	тз.ЦветГрафика,
	               |	тз.ЦветГрафикаНарастающейКвоты,
	               |	тз.НаименованиеДляЛегенды,
	               |	тз.ПоказыватьВИЦО,
	               |	тз.ИА_ШиринаЛинии,
	               |	тз.ПорядковыйНомер,
	               |	тз.ТипКвоты,
	               |	тз.ПериодДетализацииКвоты,
	               |	тз.УзорТочки
	               |ПОМЕСТИТЬ втТЗ
	               |ИЗ
	               |	&ТаблицаЗначений КАК тз
	               |ГДЕ
	               |	тз.УровеньДетализации = &ТекУр
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ИА_КвотыСтатистикСрезПоследних.ВидСтатистики,
	               |	ИА_КвотыСтатистикСрезПоследних.ПериодДетализации,
	               |	ИА_КвотыСтатистикСрезПоследних.Аналитика1,
	               |	ИА_КвотыСтатистикСрезПоследних.Аналитика2,
	               |	ИА_КвотыСтатистикСрезПоследних.Аналитика3,
	               |	ИА_КвотыСтатистикСрезПоследних.ТипКвоты,
	               |	ИА_КвотыСтатистикСрезПоследних.Квота
	               |ПОМЕСТИТЬ втКвоты
	               |ИЗ
	               |	РегистрСведений.ИА_КвотыСтатистик.СрезПоследних(&ДатаКонца, ) КАК ИА_КвотыСтатистикСрезПоследних
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	втТЗ.ЗаголовокДиаграммы КАК ЗаголовокДиаграммы,
	               |	втТЗ.ВидСтатистики,
	               |	втТЗ.Аналитика1,
	               |	втТЗ.Аналитика2,
	               |	втТЗ.Аналитика3,
	               |	втТЗ.ПериодДетализации КАК ПериодДетализации,
	               |	втТЗ.ЦветГрафика,
	               |	втТЗ.ЦветГрафикаНарастающейКвоты,
	               |	втТЗ.НаименованиеДляЛегенды,
	               |	втТЗ.ПоказыватьВИЦО КАК ПоказыватьВИЦО,
	               |	втТЗ.ИА_ШиринаЛинии КАК ШиринаЛинии,
	               |	втТЗ.УзорТочки КАК УзорТочки,
	               |	ЕСТЬNULL(втКвоты.ТипКвоты, ЗНАЧЕНИЕ(Перечисление.ИА_ТипыКвот.ПустаяСсылка)) КАК ТипКвоты,
	               |	ЕСТЬNULL(втКвоты.Квота, 0) КАК Квота,
	               |	ЕСТЬNULL(втКвоты.ПериодДетализации, ЗНАЧЕНИЕ(Перечисление.ИА_ПериодыДетализации.ПустаяСсылка)) КАК ПериодДетализацииКвоты,
	               |	втТЗ.ПорядковыйНомер КАК ПорядковыйНомер,
	               |	ЗНАЧЕНИЕ(Справочник.Оргсхема.ПустаяСсылка) КАК Пост
	               |ИЗ
	               |	втТЗ КАК втТЗ
	               |		ЛЕВОЕ СОЕДИНЕНИЕ втКвоты КАК втКвоты
	               |		ПО втТЗ.ВидСтатистики = втКвоты.ВидСтатистики
	               |			И втТЗ.Аналитика1 = втКвоты.Аналитика1
	               |			И втТЗ.Аналитика2 = втКвоты.Аналитика2
	               |			И втТЗ.Аналитика3 = втКвоты.Аналитика3
	               |			И втТЗ.ПериодДетализацииКвоты = втКвоты.ПериодДетализации
	               |			И втТЗ.ТипКвоты = втКвоты.ТипКвоты
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ПорядковыйНомер
	               |ИТОГИ
	               |	МАКСИМУМ(ПоказыватьВИЦО)
	               |ПО
	               |	Пост,
	               |	ПорядковыйНомер,
	               |	ПериодДетализации
	               |;
