&НаКлиенте
Процедура ИмзменитьПериодДетализации(пСобытие)
	
	Отказ = Ложь;
	
	Если пСобытие = "det_day" Тогда
		новПериод = ПредопределенноеЗначение("Перечисление.ИА_ПериодыДетализации.День");
	ИначеЕсли пСобытие = "det_week" Тогда
		новПериод = ПредопределенноеЗначение("Перечисление.ИА_ПериодыДетализации.Неделя");
	ИначеЕсли пСобытие = "det_month" Тогда
		новПериод = ПредопределенноеЗначение("Перечисление.ИА_ПериодыДетализации.Месяц");
	ИначеЕсли пСобытие = "det_year" Тогда
		новПериод = ПредопределенноеЗначение("Перечисление.ИА_ПериодыДетализации.Год");
	Иначе
		НастройкаПриИзменении(Неопределено);
		Возврат;
	КонецЕсли;
	
	РучнойТипПериода = новПериод;
	
	Для каждого стр Из ДеревоСтатистик.ПолучитьЭлементы() Цикл
		
		Если Не ТиповыеПериоды_БольшеИлиРавно(стр.ВидСдвигаПериода, новПериод) Тогда
			Отказ = Истина;
			Прервать;
		КонецЕсли;
		
		стр.ПериодДетализации = новПериод;
		Для каждого стр1 Из стр.ПолучитьЭлементы() Цикл
			
			Если Не ТиповыеПериоды_БольшеИлиРавно(стр1.ВидСдвигаПериода, новПериод) Тогда
				Отказ = Истина;
				Прервать;
			КонецЕсли;
			стр1.ПериодДетализации = новПериод;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Если Не Отказ Тогда
		//ОбновитьПериоды(новПериод);
		НарисоватьДиаграммы();
		
	Иначе 
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Нельзя вывести статистики с детализацией "+новПериод+", так у одной из статистик ""Вид сдвига периода"" меньше!";
		Сообщение.Сообщить();
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ТиповыеПериоды_БольшеИлиРавно(ТиповойПериод1, ТиповойПериод2)
	Возврат ИА_Статистики.ТиповыеПериоды_БольшеИлиРавно(ТиповойПериод1, ТиповойПериод2);
КонецФункции

&НаКлиенте
Процедура ПолеХТМЛПриНажатии(Элемент, ДанныеСобытия, СтандартнаяОбработка)
	
	Если ДанныеХТМЛ = "" Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		событие = Элементы.ПолеХТМЛ.Документ.parentWindow.CurEvent;
		НомерЭл = Элементы.ПолеХТМЛ.Документ.parentWindow.CurEventSource;
	Исключение
		событие = Элементы.ПолеХТМЛ.Документ.window.CurEvent;
		НомерЭл = Элементы.ПолеХТМЛ.Документ.window.CurEventSource;
	КонецПопытки;
	
	Если событие<>"" Тогда
		Если событие = "report" Тогда
			ВывестиРасшифровку(НомерЭл);
		ИначеЕсли событие = "add" Тогда
			ДобавитьЗначение(НомерЭл);
		ИначеЕсли событие = "incl" Тогда
			ПоказатьПодчиненные(НомерЭл);
		ИначеЕсли лев(событие,4) = "det_" Тогда
			ИмзменитьПериодДетализации(событие);
		КонецЕсли;
		Попытка
			Элементы.ПолеХТМЛ.Документ.parentWindow.setCurEvent("","");
		Исключение
			Элементы.ПолеХТМЛ.Документ.window.setCurEvent("","");
		КонецПопытки;
	КонецЕсли;
	
КонецПроцедуры
