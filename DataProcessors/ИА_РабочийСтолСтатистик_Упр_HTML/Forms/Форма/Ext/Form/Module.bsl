&НаСервере
Функция ЕстьСдвигиПериода(СтрокаГрафика) Экспорт
	
	СтрокиДетализации = СтрокаГрафика.ПолучитьЭлементы();
	Для каждого СтрДетализации Из СтрокиДетализации Цикл
		Если СтрДетализации.СдвигПериода > 0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьГраницыПериода(ПериодДетализации, ДатаНачала)
	
	Период = Новый СтандартныйПериод;
	Период.Вариант = ВариантСтандартногоПериода.ПроизвольныйПериод;
	Период.ДатаНачала = НачалоДня(ДатаНачала);
	
	Если ПериодДетализации = Перечисления.ИА_ПериодыДетализации.День тогда
		Период.ДатаОкончания = КонецДня(ДатаНачала);
	ИначеЕсли ПериодДетализации = Перечисления.ИА_ПериодыДетализации.Неделя тогда
		Период.ДатаОкончания = КонецДня(ДатаНачала + 60*60*24*6);
	ИначеЕсли ПериодДетализации = Перечисления.ИА_ПериодыДетализации.Месяц тогда
		Период.ДатаОкончания = КонецМесяца(ДатаНачала);
	ИначеЕсли ПериодДетализации = Перечисления.ИА_ПериодыДетализации.Квартал тогда
		Период.ДатаОкончания = КонецКвартала(ДатаНачала);
	ИначеЕсли ПериодДетализации = Перечисления.ИА_ПериодыДетализации.Год тогда
		Период.ДатаОкончания = КонецГода(ДатаНачала);
	КонецЕсли;
	
	Возврат Период;
	
КонецФункции

