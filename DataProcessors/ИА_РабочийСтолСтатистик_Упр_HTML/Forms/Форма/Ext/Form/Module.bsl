&НаСервере
Функция ПолучитьДеревоСтатистик()
	
	ПрНедели = Константы.ИА_ПредставлениеНедели.Получить();
	
	Цвет_Серый = RGB(190,190,190);
	Цвет_Зеленый = RGB(50,205,50);
	Цвет_Красный = RGB(255,48,48);
	Цвет_Черный = RGB(0,0,0);
	Цвет_Желтый = RGB(255,255,0);
	Цвет_Синий = RGB(50,50,255);

	
	ТипГрафика = Константы.ИА_ТипДиаграммыВЭксель.Получить();
	деревоСТ = РеквизитФормыВЗначение("ДеревоСтатистик");
	
	ДреревоСТДляКлиента = Новый Массив;

	счСтатистик = 0;
	
	Пока счСтатистик < деревоСТ.Строки.Количество() Цикл
		
		счСтрока = ИА_Защита_Статистика.ФЧ(счСтатистик);
	
		СтрокаСтатистик = деревоСТ.Строки[счСтатистик];
		СтатистикиДляПостроения = СтрокаСтатистик.Строки;
				
		Кол = СтатистикиДляПостроения[0].Данные.Количество();		 
		
		Если СтатистикиДляПостроения[0].Данные.Количество() > 0 Тогда
			МинЗн = СтатистикиДляПостроения[0].Данные[0].Значение;
			МаксЗн = СтатистикиДляПостроения[0].Данные[0].Значение;
		Иначе
			МинЗн = 0;
			МаксЗн = 0;
		КонецЕсли;
		
		Для каждого стрСтат из СтатистикиДляПостроения Цикл
			Для каждого стр из стрСтат.данные Цикл
				Если не стр.РеальныеДанные Тогда
					прервать;
				КонецЕсли;
		
				МинЗн = Мин(МинЗн, стр.Значение);
				МаксЗн = Макс(МаксЗн, стр.Значение);
			КонецЦикла;
			Если стрСтат.Квота <> 0 И стрСтат.ТипКвоты = Перечисления.ИА_ТипыКвот.Обычная Тогда 
				МаксЗн = Макс(стрСтат.Квота, МаксЗн);
			ИначеЕсли стрСтат.Квота <> 0 И стрСтат.ТипКвоты = Перечисления.ИА_ТипыКвот.Нарастающая Тогда
				МаксЗн = Макс(стрСтат.Квота, МаксЗн);
				МаксЗн = Макс(стрСтат.Данные.Итог("Значение"), МаксЗн);
			КонецЕсли;
		КонецЦикла;
		
		Если СтатистикиДляПостроения[0].ВидСтатистики.ПеревернутаяСтатистика Тогда
			//врМин = МинЗн;
			//МинЗн = -МаксЗн;
			//МаксЗн = -врМин;
		КонецЕсли;
		
		Если МаксЗн - МинЗн = 0 Тогда
			
			МаксЗн = МаксЗн * 1.1;
			Если МаксЗн = 0 Тогда
				МаксЗн = 10;
			КонецЕсли;
			МинЗн = 0;
		КонецЕсли;
		
		Если МинЗн > 0 и МаксЗн = 0 Тогда
			МаксЗн = МинЗн * 2;
		КонецЕсли;
		
		Если НЕ СтатистикиДляПостроения[0].ВидСтатистики.ПеревернутаяСтатистика И МинЗн > МаксЗн Тогда
			МаксЗн = МинЗн + МинЗн - МаксЗн;
		КонецЕсли;
		
		Если МаксЗн > 100 Тогда
			МаксЗн = Окр(МаксЗн,0);
		Иначе
			МаксЗн = Окр(МаксЗн,1);
		КонецЕсли;
		Если МаксЗн > 100 Тогда
			МинЗн = Окр(МинЗн,0);
		Иначе
			МинЗн = Окр(МинЗн,1);
		КонецЕсли;
		
		МассивГрафиков = Новый Массив;
		ЕщеСтатистика = 1;
		
		Для каждого стрСтатистик из СтатистикиДляПостроения Цикл
			Квота = 0;
			Если стрСтатистик.ТипКвоты = Перечисления.ИА_ТипыКвот.Нарастающая Тогда
				КолКвот = 2;
				Квота = стрСтатистик.Квота / (Кол -1);
			ИначеЕсли стрСтатистик.ТипКвоты = Перечисления.ИА_ТипыКвот.Обычная Тогда
				КолКвот = 1;
				Квота = стрСтатистик.Квота;
			Иначе
				КолКвот = 0;
			КонецЕсли;
			
			Для НомерКвоты = 0 по КолКвот Цикл
				сч = 0; 
				ПредЗначение = 0;
				ИтогЗнУ = 0;
				ИтогКвота = 0;
				СтруктураСтатистикиДляПостроенияДляКлиента = Новый Структура("ЗаголовокДиаграммы, Период, ЗагаловокЛегенды, МассивЦветов, МассивЗначений, МассивЦветов, МассивЗначений, ПеревернутаяСтатистика, ЦветГрафикаПустая");
				
				ТекстПодписи = "Период";
				Если СтрокаСтатистик.ПериодДетализации = Перечисления.ИА_ПериодыДетализации.День тогда
					ТекстПодписи = "День (Период)";
				ИначеЕсли СтрокаСтатистик.ПериодДетализации = Перечисления.ИА_ПериодыДетализации.Неделя тогда
					ТекстПодписи = "Неделя (Период)";
				ИначеЕсли СтрокаСтатистик.ПериодДетализации = Перечисления.ИА_ПериодыДетализации.Месяц тогда
					ТекстПодписи = "Месяц (Период)";
				ИначеЕсли СтрокаСтатистик.ПериодДетализации = Перечисления.ИА_ПериодыДетализации.Квартал тогда
					ТекстПодписи = "Квартал (Период)";
				ИначеЕсли СтрокаСтатистик.ПериодДетализации = Перечисления.ИА_ПериодыДетализации.Год тогда
					ТекстПодписи = "Год (Период)";
				КонецЕсли;
				Если СтатистикиДляПостроения.Количество() + КолКвот > 1 Тогда
					СтруктураСтатистикиДляПостроенияДляКлиента.Вставить("ЗаголовокДиаграммы",стрСтатистик.ЗаголовокДиаграммы);
				Иначе                                                      		
					СтруктураСтатистикиДляПостроенияДляКлиента.Вставить("ЗаголовокДиаграммы",стрСтатистик.ЗаголовокДиаграммы + "  " + ?(стрСтатистик.ВидСтатистики.ПеревернутаяСтатистика,-1,1)* СтатистикиДляПостроения[ЕщеСтатистика - 1].Данные.Итог("Значение"));
				КонецЕсли;	
				СтруктураСтатистикиДляПостроенияДляКлиента.Вставить("Период", ТекстПодписи);
				СтруктураСтатистикиДляПостроенияДляКлиента.Вставить("ЗагаловокЛегенды",?(ЗначениеЗаполнено(стрСтатистик.НаименованиеДляЛегенды), стрСтатистик.НаименованиеДляЛегенды,"Значение статистики"));
			
			
				МассивЦветов = Новый Массив;
				МассивЗначений = Новый Массив;
				
				Пока сч < Кол Цикл
					//Если не стрСтатистик.данные[сч].РеальныеДанные Тогда
					//	Прервать;
					//КонецЕсли; 
					Если КолКвот = 2 Тогда
						
					КонецЕсли;
					
					СтрутураЗначений = Новый Структура("Дата", "ЗНУ");
					//знУ = ?(стрСтатистик.ВидСтатистики.ПеревернутаяСтатистика,-1,1)*СтатистикиДляПостроения[ЕщеСтатистика - 1 - НомерКвоты].Данные[сч].Значение;
					знУ = СтатистикиДляПостроения[ЕщеСтатистика - 1 - НомерКвоты].Данные[сч].Значение;
					//Если ЕщеСтатистика = 1 Тогда
						ТекстПодписи = "";
						Если СтрокаСтатистик.ПериодДетализации = Перечисления.ИА_ПериодыДетализации.День тогда
							ТекстПодписи = Формат(СтатистикиДляПостроения[ЕщеСтатистика - 1 - НомерКвоты].Данные[сч].ДатаНачала,"ДФ=dd.MM");
						ИначеЕсли СтрокаСтатистик.ПериодДетализации = Перечисления.ИА_ПериодыДетализации.Неделя тогда
							Если ПрНедели = Перечисления.ИА_ПредставлениеНедели.Начало Тогда								
								ТекстПодписи = Формат(СтатистикиДляПостроения[ЕщеСтатистика - 1 - НомерКвоты].Данные[сч].ДатаНачала,"ДФ=dd.MM");
							ИначеЕсли ПрНедели = Перечисления.ИА_ПредставлениеНедели.Конец Тогда								
								ТекстПодписи = Формат(СтатистикиДляПостроения[ЕщеСтатистика - 1 - НомерКвоты].Данные[сч].ДатаКонца,"ДФ=dd.MM");
							Иначе
								ТекстПодписи = Формат(СтатистикиДляПостроения[ЕщеСтатистика - 1 - НомерКвоты].Данные[сч].ДатаНачала,"ДФ=dd.MM")+"-" + Формат(СтатистикиДляПостроения[ЕщеСтатистика - 1 - НомерКвоты].Данные[сч].ДатаКонца,"ДФ=dd.MM");
							КонецЕсли;
							
						ИначеЕсли СтрокаСтатистик.ПериодДетализации = Перечисления.ИА_ПериодыДетализации.Месяц тогда
							ТекстПодписи = Формат(СтатистикиДляПостроения[ЕщеСтатистика - 1 - НомерКвоты].Данные[сч].ДатаНачала,"ДФ=MM.yyyy");
						ИначеЕсли СтрокаСтатистик.ПериодДетализации = Перечисления.ИА_ПериодыДетализации.Квартал тогда
							ТекстПодписи = Формат(СтатистикиДляПостроения[ЕщеСтатистика - 1 - НомерКвоты].Данные[сч].ДатаНачала,"ДФ=MM.yyyy")+"-" + Формат(СтатистикиДляПостроения[ЕщеСтатистика - 1 - НомерКвоты].Данные[сч].ДатаКонца,"ДФ=MM.yyyy");
						ИначеЕсли СтрокаСтатистик.ПериодДетализации = Перечисления.ИА_ПериодыДетализации.Год тогда
							ТекстПодписи = Формат(СтатистикиДляПостроения[ЕщеСтатистика - 1 - НомерКвоты].Данные[сч].ДатаНачала,"ДФ=yyyy");
						КонецЕсли;
					
						ЗначениеСтатистики = СтатистикиДляПостроения[ЕщеСтатистика - 1 - НомерКвоты].Данные[сч].Значение;
						ЗначениеСтатистики = окр(ЗначениеСтатистики,1);
						ЗначениеПодписи = Формат(ЗначениеСтатистики,"ЧН=; ЧГ=");
						СтрутураЗначений.Вставить("Дата",ТекстПодписи);
					//КонецЕсли;
					
					ИтогЗнУ = ИтогЗнУ + знУ;
					
					Если НомерКвоты = 2 Тогда
						СтрутураЗначений.Вставить("ЗНУ",ИтогЗнУ);
					ИначеЕсли НомерКвоты = 1 И КолКвот = 1 Тогда
						СтрутураЗначений.Вставить("ЗНУ",Квота);
					ИначеЕсли НомерКвоты = 1 Тогда						
						СтрутураЗначений.Вставить("ЗНУ",ИтогКвота);
					Иначе
						СтрутураЗначений.Вставить("ЗНУ",знУ);
					КонецЕсли;
					ИтогКвота = ИтогКвота + Квота;
					
					МассивЗначений.Добавить(СтрутураЗначений);
										 
					Если ТипГрафика = Перечисления.ИА_ТипыДиаграммыВЭксель.Графики Тогда
						Если сч > 0 Тогда
							Если НомерКвоты = 2 Тогда
								МассивЦветов.Добавить(Цвет_Зеленый);
							ИначеЕсли НомерКвоты = 1 И КолКвот = 2 Тогда 
								
								Если стрСтатистик.ЦветГрафикаНарастающейКвоты="" Тогда
									МассивЦветов.Добавить(Цвет_Синий);
								Иначе
									МассивЦветов.Добавить(ПолучитьЦвет(стрСтатистик.ЦветГрафикаНарастающейКвоты));
								КонецЕсли;
							ИначеЕсли НомерКвоты = 1 Тогда
								МассивЦветов.Добавить(Цвет_Зеленый);
							Иначе								
								Если стрСтатистик.ЦветГрафика="" Тогда
									Если ?(стрСтатистик.ВидСтатистики.ПеревернутаяСтатистика,знУ < ПредЗначение,знУ > ПредЗначение) Тогда
										МассивЦветов.Добавить(Цвет_Синий);
									Иначе
										МассивЦветов.Добавить(Цвет_Красный);
									КонецЕсли;
								Иначе
									МассивЦветов.Добавить(ПолучитьЦвет(стрСтатистик.ЦветГрафика));
								КонецЕсли;	
							КонецЕсли;
						КонецЕсли;
					КонецЕсли;  
					ПредЗначение = знУ;
					сч = сч + 1;
				КонецЦикла;
				
				Если ТипГрафика = Перечисления.ИА_ТипыДиаграммыВЭксель.СОбластями Тогда
					Если НомерКвоты = 2 Тогда
						МассивЦветов.Добавить(Цвет_Зеленый);
					ИначеЕсли НомерКвоты = 1 И КолКвот = 2 Тогда 
						
						Если стрСтатистик.ЦветГрафикаНарастающейКвоты="" Тогда
							МассивЦветов.Добавить(Цвет_Синий);
						Иначе
							МассивЦветов.Добавить(ПолучитьЦвет(стрСтатистик.ЦветГрафикаНарастающейКвоты));
						КонецЕсли;
					ИначеЕсли НомерКвоты = 1 Тогда
						МассивЦветов.Добавить(Цвет_Зеленый);
					Иначе
						Если стрСтатистик.ЦветГрафика="" Тогда
							МассивЦветов.Добавить(Цвет_Синий);
						Иначе
							МассивЦветов.Добавить(ПолучитьЦвет(стрСтатистик.ЦветГрафика));	
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;
				СтруктураСтатистикиДляПостроенияДляКлиента.Вставить("МассивЦветов",МассивЦветов);
				СтруктураСтатистикиДляПостроенияДляКлиента.Вставить("МассивЗначений",МассивЗначений);   
				СтруктураСтатистикиДляПостроенияДляКлиента.Вставить("ПеревернутаяСтатистика",стрСтатистик.ВидСтатистики.ПеревернутаяСтатистика);
				СтруктураСтатистикиДляПостроенияДляКлиента.Вставить("ЦветГрафикаПустая",стрСтатистик.ЦветГрафика = "");
				МассивГрафиков.Добавить(СтруктураСтатистикиДляПостроенияДляКлиента);
				ЕщеСтатистика = ЕщеСтатистика + 1;
			КонецЦикла;
		КонецЦикла;
		СтруктураДреревоСТДляКлиента = Новый Структура("Кол, МаксЗн, МинЗн, МассивГрафиков");
		СтруктураДреревоСТДляКлиента.Вставить("Кол",Кол);
		СтруктураДреревоСТДляКлиента.Вставить("МаксЗн",МаксЗн);
		СтруктураДреревоСТДляКлиента.Вставить("МинЗн",МинЗн);
		СтруктураДреревоСТДляКлиента.Вставить("МассивГрафиков", МассивГрафиков);
		СтруктураДреревоСТДляКлиента.Вставить("МаштабМинимум", СтрокаСтатистик.МаштабМинимум);
		СтруктураДреревоСТДляКлиента.Вставить("МаштабМаксимум", СтрокаСтатистик.МаштабМаксимум);

		ДреревоСТДляКлиента.Добавить(СтруктураДреревоСТДляКлиента);
		счСтатистик = счСтатистик + 1;
	КонецЦикла;
	
	Возврат ДреревоСТДляКлиента;

КонецФункции

&НаСервере
Функция  ПолучитьПечатьВЭксель()
	Возврат Константы.ИА_ПечатьСтатистикВЭксель.Получить();
КонецФункции

&НаСервере
Функция ПолучитьВерсиюЭксель(Version) 
	Попытка
		Если Число(Лев(Version, 2)) < 15 Тогда
			Возврат Истина;
		Иначе
			Возврат Ложь;
		КонецЕсли;
	Исключение
		Возврат Истина;
	КонецПопытки;	
КонецФункции

&НаКлиенте
Процедура ВывестиВExcel()
	Если Объект.ДатаНачала > Объект.ДатаКонца Тогда          
		Возврат;
	КонецЕсли;

	ТипДиаграммыЭксель = ПолучитьТипГрафикаЭксель();
				
	счСтатистик = 0;

	Попытка
		Эксель = Новый COMОбъект("Excel.Application");
		Эксель.DisplayAlerts = Истина;
		Эксель.ScreenUpdating = 0;
		Эксель.EnableEvents = 1;
		Эксель.Visible = 0;		
		
		WorkBook=Эксель.Workbooks.Add();
		
	Исключение
		Сообщить(ОписаниеОшибки()); 
		Возврат;
	КонецПопытки;

	ВерсияЭксель = ПолучитьВерсиюЭксель(Эксель.Version);
	Эксель.ActiveSheet.Name="Данные";
	WorkBook.ActiveSheet.Range("A1:A10000").NumberFormat = "@";
	Left=1;
	Top=1;
	Height=489;
	Width=665;	

	ПоложениеЯчейки = 0;

	деревоСТ = ПолучитьДеревоСтатистик();
	Пока счСтатистик < деревоСТ.Количество() Цикл
								
		Кол = деревоСТ[счСтатистик].Кол;
		Если Кол <= 1 Тогда
			счСтатистик = счСтатистик + 1;
			Продолжить;
		КонецЕсли;
		
		Если ИспользоватьРучнойМаштабГрафиков и (деревоСТ[счСтатистик].МаштабМинимум<>0 ИЛИ деревоСТ[счСтатистик].МаштабМаксимум<>0) Тогда
			МинЗн = деревоСТ[счСтатистик].МаштабМинимум;
			МаксЗн = деревоСТ[счСтатистик].МаштабМаксимум;			
		Иначе
			МаксЗн = деревоСТ[счСтатистик].МаксЗн;
			МинЗн = деревоСТ[счСтатистик].МинЗн;
		КонецЕсли;

		ЕщеСтатистика = 1;
		
		Для каждого стрСтатистик из деревоСТ[счСтатистик].МассивГрафиков Цикл
			WorkBook.WorkSheets.Item("Данные").Select();
			сч = 0; 
			ПредЗначение = 0;
			ИтогЗнУ = 0;
			
			Если ЕщеСтатистика = 1 Тогда
				//WorkBook.WorkSheets.Item("Данные").Cells(1 + ПоложениеЯчейки,1).Value = стрСтатистик.ЗаголовокДиаграммы;
				//		
				//ПоложениеЯчейки = ПоложениеЯчейки + 1; 

				WorkBook.WorkSheets.Item("Данные").Cells(1 + ПоложениеЯчейки,1).Value = стрСтатистик.Период;
				
				WorkBook.WorkSheets.Item("Данные").Cells(1 + ПоложениеЯчейки,1 + ЕщеСтатистика).Value = стрСтатистик.ЗагаловокЛегенды;
				ПоложениеЯчейки = ПоложениеЯчейки + 1;
			Иначе
				ПоложениеЯчейки = ПоложениеЯчейки - Кол;
				WorkBook.WorkSheets.Item("Данные").Cells(0 + ПоложениеЯчейки,1 + ЕщеСтатистика).Value = стрСтатистик.ЗагаловокЛегенды;	
			КонецЕсли;
			
							
			Пока сч < Кол Цикл

				Если ЕщеСтатистика = 1 Тогда					
					WorkBook.WorkSheets.Item("Данные").Cells(1 + ПоложениеЯчейки,1).Value = стрСтатистик.МассивЗначений[сч].Дата;
					
				КонецЕсли;
				
				WorkBook.WorkSheets.Item("Данные").Cells(1 + ПоложениеЯчейки,1 + ЕщеСтатистика).Value = стрСтатистик.МассивЗначений[сч].знУ;						
				
				ПоложениеЯчейки = ПоложениеЯчейки + 1;
				
				ИтогЗнУ = ИтогЗнУ + стрСтатистик.МассивЗначений[сч].знУ; 
				ПредЗначение = стрСтатистик.МассивЗначений[сч].знУ;
				сч = сч + 1;
			КонецЦикла;
			
			Если ВерсияЭксель Тогда
				WorkBook.WorkSheets.Item(2).Select();
				Эксель.ActiveSheet.Name= "Графики";
			Иначе
				Попытка
			    	WorkBook.WorkSheets.Item("Графики").Select();
				Исключение
					 Эксель.Sheets.Add(Эксель.ActiveSheet);
	           		 WorkBook.WorkSheets.Item("Лист2").Select();
					 Эксель.ActiveSheet.Name= "Графики";
				КонецПопытки;
			КонецЕсли;			
			
			ПоложениеЯчейки1Формат = Строка(Формат(ПоложениеЯчейки+1 - Кол,"ЧГ=0"));
			ПоложениеЯчейки2Формат = Формат(ПоложениеЯчейки,"ЧГ=0");
			
			Если ЕщеСтатистика = 1 Тогда
				ОбластьГрафика = ?(ВерсияЭксель,"A", "B") + ПоложениеЯчейки1Формат + ":" + "B" + ПоложениеЯчейки2Формат;  
				XValues = "=Данные!$A$" + Строка(Формат(ПоложениеЯчейки+1 - Кол + ?(ВерсияЭксель,0,0),"ЧГ=0")) + ":$A$" + ПоложениеЯчейки2Формат + "";
				ГрафикСМаркерами = НарисоватьДиаграммуПрямоВExcel(Эксель,WorkBook,Left,Top,Height,Width,0,65,ОбластьГрафика,стрСтатистик.ЗаголовокДиаграммы,
				МаксЗн,МинЗн, стрСтатистик.МассивЦветов, стрСтатистик.ПеревернутаяСтатистика, ?(деревоСТ[счСтатистик].МассивГрафиков.Количество() > 1,Ложь,Истина), ТипДиаграммыЭксель, ВерсияЭксель, XValues, стрСтатистик.ЦветГрафикаПустая);
				Top = Top + Height + 7;
				
				ГрафикСМаркерами.SeriesCollection(1).ApplyDataLabels(2);
			Иначе
				Если ЕщеСтатистика = 2 Тогда
					ОбластьГрафика = ?(ВерсияЭксель,"A", "B") + ПоложениеЯчейки1Формат + ":" + "C" + ПоложениеЯчейки2Формат;
					//ОбластьГрафика = "A" + Строка(ПоложениеЯчейки - Кол) + ":" + "C" + ПоложениеЯчейки;
				ИначеЕсли ЕщеСтатистика = 3 Тогда
					ОбластьГрафика = ?(ВерсияЭксель,"A", "B") + ПоложениеЯчейки1Формат + ":" + "D" + ПоложениеЯчейки2Формат;
				ИначеЕсли ЕщеСтатистика = 4 Тогда
					ОбластьГрафика = ?(ВерсияЭксель,"A", "B") + ПоложениеЯчейки1Формат + ":" + "E" + ПоложениеЯчейки2Формат;
				ИначеЕсли ЕщеСтатистика = 5 Тогда
					ОбластьГрафика = ?(ВерсияЭксель,"A", "B") + ПоложениеЯчейки1Формат + ":" + "F" + ПоложениеЯчейки2Формат;
				Иначе
					ОбластьГрафика = ?(ВерсияЭксель,"A", "B") + ПоложениеЯчейки1Формат + ":" + "G" + ПоложениеЯчейки2Формат;
				КонецЕсли;
				ActiveChart=Эксель.ActiveChart;	
				
				Range=WorkBook.WorkSheets.Item("Данные").Range(ОбластьГрафика);   
				ActiveChart.SetSourceData(Range);
				
				Если Не ВерсияЭксель Тогда
			   		ActiveChart.FullSeriesCollection(1).XValues = XValues;
				КонецЕсли;
				
				Если ПолучитьТипГрафикаЭксельСравнить() Тогда
				    Если  стрСтатистик.ЦветГрафикаПустая Тогда
						Для ы=2 По ActiveChart.SeriesCollection(ЕщеСтатистика).Points().Count() Цикл
							ActiveChart.SeriesCollection(ЕщеСтатистика).Points(ы).Select();
							Эксель.Selection.Format.Line.Visible=1;
							Если  ТипЗнч(стрСтатистик.МассивЦветов)=Тип("Массив") Тогда
								//Эксель.Selection.Format.Line.ForeColor.RGB = стрСтатистик.МассивЦветов[ы-2];
								Попытка
									Эксель.Selection.Format.Line.ForeColor.RGB = стрСтатистик.МассивЦветов[ы-2];
								Исключение
									Эксель.Selection.Format.Line.ForeColor.RGB = стрСтатистик.МассивЦветов[ы-3];
								КонецПопытки;
							КонецЕсли;
						КонецЦикла;
						
						Для ы=1 По ActiveChart.SeriesCollection(ЕщеСтатистика).Points().Count() Цикл
							ActiveChart.SeriesCollection(ЕщеСтатистика).Points(ы).Select();
							Эксель.Selection.Format.Fill.Visible=1;
							Если  ТипЗнч(стрСтатистик.МассивЦветов)=Тип("Массив") Тогда
								Эксель.Selection.Format.Fill.ForeColor.RGB = RGB(0,0,0);	
							КонецЕсли;
						КонецЦикла;
					Иначе
						ActiveChart.SeriesCollection(ЕщеСтатистика).Select();
						Если  ТипЗнч(стрСтатистик.МассивЦветов)=Тип("Массив") Тогда
							Эксель.Selection.Format.Line.ForeColor.RGB = стрСтатистик.МассивЦветов[0];
						КонецЕсли;
					КонецЕсли;
				Иначе
					ActiveChart.SeriesCollection(ЕщеСтатистика).Select();
					Эксель.Selection.Format.Fill.Visible = 1;
					Эксель.Selection.Format.Fill.ForeColor.RGB = стрСтатистик.МассивЦветов[0];
					Эксель.Selection.Format.Fill.Transparency = 0.5;
					Эксель.Selection.Format.Fill.Solid();
				КонецЕсли;
				
				ActiveChart.SeriesCollection(ЕщеСтатистика).ApplyDataLabels(2);
			КонецЕсли;
			ЕщеСтатистика = ЕщеСтатистика + 1;
		КонецЦикла;	
		счСтатистик = счСтатистик + 1;
	КонецЦикла;
	WorkBook.WorkSheets.Item("Данные").Select();
	WorkBook.ActiveSheet.Columns("A:A").ColumnWidth = 20;
	WorkBook.ActiveSheet.Columns("B:B").ColumnWidth = 20;
	WorkBook.ActiveSheet.Columns("C:C").ColumnWidth = 20;
	WorkBook.ActiveSheet.Columns("D:D").ColumnWidth = 20;
	WorkBook.ActiveSheet.Columns("E:E").ColumnWidth = 20;
	WorkBook.ActiveSheet.Columns("F:F").ColumnWidth = 20;
	WorkBook.ActiveSheet.Columns("G:G").ColumnWidth = 20;

	//WorkBook.WorkSheets.Item("Данные").Range("A"+ 1 + ПоложениеЯчейки).NumberFormat = "@";

	WorkBook.WorkSheets.Item("Графики").Select();
	ActiveChart = Эксель.ActiveSheet;
	
	//Эксель.ActiveChart.SeriesCollection(1).ApplyDataLabels(2);
	
	ActiveChart.PageSetup.Orientation = 2;
	Эксель.ActiveWindow.View = 3;

	Эксель.Visible = 1;
	Эксель.ScreenUpdating = 1;
		
КонецПроцедуры

&НаКлиенте
Функция НарисоватьДиаграммуПрямоВExcel(Excel,WorkBook,Left,Top,Height,Width, xlLegendPosition=-4152,SourceSheetIndex=Неопределено,SourceData=Неопределено,Title="",МаксЗн,МинЗн, МассивЦветов, ПеревернутаяСтатистика, Легенда, ChartType, ВерсияЭксель, XValues, ЦветГрафикаПустая) Экспорт
	
	// некоторые константы Excel . Остальные есть в текстовом макете отчета.
	msoFalse=0;
	msoTrue=1;
	xlColumns=2;
	xlRows=1;
	xlCategory = 1;
	xlSeriesAxis = 3;
	xlValue = 2 ;

	WorkBook.ActiveSheet.Shapes.AddChart(ChartType,Left,Top,Width,Height).Select();

	Excel.ActiveChart.ChartArea.Format.Fill.Visible = msoFalse;  // делаем диаграмму прозрачной
	Excel.ActiveChart.ChartArea.Format.Line.Visible = msoFalse;

	ActiveChart=Excel.ActiveChart;
	Если ПолучитьТипГрафикаЭксельСравнить() Тогда
		ActiveChart.ApplyLayout (3);
	Иначе
		ActiveChart.ApplyLayout (1);
	КонецЕсли;	

	ActiveChart.Axes(xlCategory).AxisBetweenCategories = False;	

	Если ЗначениеЗаполнено(Title) Тогда
		ActiveChart.HasTitle = True; 
		ActiveChart.ChartTitle.Text = Title;
		ActiveChart.ChartTitle.Format.TextFrame2.TextRange.Font.Name  = "Arial Narrow"; // поменяйте на свой шрифт
	    ActiveChart.ChartTitle.Format.TextFrame2.TextRange.Font.Size  = 16;

	КонецЕсли;


	Если ЗначениеЗаполнено(SourceData) И ТипЗнч(SourceData)=Тип("Строка") Тогда
		
		Range=WorkBook.WorkSheets.Item("Данные").Range(SourceData);   // выделяем область данных
		ActiveChart.SetSourceData(Range);	
		
	    Если Не ВерсияЭксель Тогда
	   		ActiveChart.FullSeriesCollection(1).XValues = XValues;
		КонецЕсли;
		
		ActiveChart.ChartArea.Select();
	    ActiveChart.Axes(xlValue).Select();

	    ActiveChart.Axes(xlValue).MaximumScale = МаксЗн;
	    ActiveChart.Axes(xlValue).MinimumScale = МинЗн;
	    ActiveChart.Axes(xlValue).MajorUnit = (МаксЗн - МинЗн)/10;
	    ActiveChart.Axes(xlValue).MinorUnit = (МаксЗн - МинЗн)/10;
		//ActiveChart.PlotArea.Select();
		//Excel.Selection.Format.Fill.Visible = msoFalse;		// делаем область построения прозрачной 
				
	КонецЕсли;

	Если ПеревернутаяСтатистика Тогда
		ActiveChart.ChartArea.Select();
	    ActiveChart.Axes(xlValue).Select();
	    ActiveChart.Axes(xlValue).ReversePlotOrder = True;
	КонецЕсли;

	 	
	Если ПолучитьТипГрафикаЭксельСравнить() Тогда	
		Если  ЦветГрафикаПустая Тогда
			Для ы=2 По ActiveChart.SeriesCollection(1).Points().Count() Цикл
				ActiveChart.SeriesCollection(1).Points(ы).Select();
				Excel.Selection.Format.Line.Visible=msoTrue;
				//Excel.Selection.Format.Fill.Solid();
				Если  ТипЗнч(МассивЦветов)=Тип("Массив") Тогда
					Попытка
						Excel.Selection.Format.Line.ForeColor.RGB = МассивЦветов[ы-2];
					Исключение
						Excel.Selection.Format.Line.ForeColor.RGB = МассивЦветов[ы-3];
					КонецПопытки;
				КонецЕсли;
			КонецЦикла;
			
			Для ы=1 По ActiveChart.SeriesCollection(1).Points().Count() Цикл
				ActiveChart.SeriesCollection(1).Points(ы).Select();
				Excel.Selection.Format.Fill.Visible=msoTrue;
				//Excel.Selection.Format.Fill.Solid();
				Если  ТипЗнч(МассивЦветов)=Тип("Массив") Тогда
					Excel.Selection.Format.Fill.ForeColor.RGB = RGB(0,0,0);	
				КонецЕсли;
			КонецЦикла;
		Иначе	
			ActiveChart.SeriesCollection(1).Select();
			Если  ТипЗнч(МассивЦветов)=Тип("Массив") Тогда
				Excel.Selection.Format.Line.ForeColor.RGB = МассивЦветов[0];
			КонецЕсли;
		КонецЕсли;	
		Если Легенда Тогда
			ActiveChart.Legend.Select();
		    Excel.Selection.Delete();
		КонецЕсли;
	Иначе
		ActiveChart.Legend.Select();
		Excel.Selection.Position = - 4107;
		ActiveChart.Axes(2).AxisTitle.Select();
	   	Excel.Selection.Delete();
		ActiveChart.SeriesCollection(1).Select();
		Excel.Selection.Format.Fill.Visible = msoTrue;
	    Excel.Selection.Format.Fill.ForeColor.RGB = МассивЦветов[0];
		Excel.Selection.Format.Fill.Transparency = 0.5;
		Excel.Selection.Format.Fill.Solid();
	КонецЕсли; 

	Return ActiveChart;
КонецФункции

&НаСервереБезКонтекста
Функция RGB(Red,Green,Blue) Экспорт
	Возврат Red+Green*256+Blue*256*256;
КонецФункции


&НаКлиенте
Процедура ВывестиРасшифровку(НомерСтат) Экспорт
	
	нСт = число(номерСтат)-1; 
	СтрокиСтат = ДеревоСтатистик.ПолучитьЭлементы()[нСт].ПолучитьЭлементы();
	
	//ИА 20151026 Выведем поля по группировкам для каждого вида статистики
	СписокВидовСтатистики = Новый СписокЗначений;
	Для Каждого Стр Из СтрокиСтат Цикл
		Если СписокВидовСтатистики.НайтиПоЗначению(Стр.ВидСтатистики) = Неопределено Тогда 
			СписокВидовСтатистики.Добавить(Стр.ВидСтатистики);
		КонецЕсли;
	КонецЦикла;
	
	формаРасшифровки = ПолучитьФорму("Обработка.ИА_РабочийСтолСтатистик_Упр_HTML.Форма.ФормаРасшифровки",,ЭтаФорма);
	формаРасшифровки.НомерСтатистики = нСт;
	формаРасшифровки.СписокВидовСтатистики = СписокВидовСтатистики;
	формаРасшифровки.Открыть();
	
КонецПроцедуры

&НаСервере
Функция ПолучитьНастройкиПользователя(МассивВидовСтатистики)
	
	СоответствиеНастроек = Новый Соответствие;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ИА_НастройкиПользователей.Настройка,
	|	ИА_НастройкиПользователей.ВидСтатистики
	|ИЗ
	|	РегистрСведений.ИА_НастройкиРасшифровкиСтатистик КАК ИА_НастройкиПользователей
	|ГДЕ
	|	ИА_НастройкиПользователей.Пользователь = &Пользователь
	|	И ИА_НастройкиПользователей.ВидСтатистики В(&МассивВидовСтатистики)";
	
	Запрос.УстановитьПараметр("МассивВидовСтатистики", МассивВидовСтатистики);
	Запрос.УстановитьПараметр("Пользователь", ПараметрыСеанса.ТекущийПользователь);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		СоответствиеНастроек.Вставить(ВыборкаДетальныеЗаписи.ВидСтатистики, ВыборкаДетальныеЗаписи.Настройка.Получить());
	КонецЦикла;
	
	Возврат СоответствиеНастроек;
	
КонецФункции

&НаСервере
Процедура ВывестиОтчет_расшифровку(номерСтатистики, СоответствиеМассиваГруппировок = неопределено, Отказ = Ложь) Экспорт
	
	Макет = Обработки.ИА_РабочийСтолСтатистик_Упр_HTML.ПолучитьМакет("Расшифровка");;
	ТабДокРасшифровка.Очистить();
	
	СтрокаДереваСтатистик = ДеревоСтатистик.ПолучитьЭлементы()[номерСтатистики];
	СтрокиСтатистик       = СтрокаДереваСтатистик.ПолучитьЭлементы();
	//ИА_Арчил Тваладзе 2016.10.05
	ЕстьСдвигиПериода = ЕстьСдвигиПериода(СтрокаДереваСтатистик);
	//Конец ИА_Арчил Тваладзе 2016.10.05
	
	СводнаяТаблица = ПолучитьИзВременногоХранилища(СтрокаДереваСтатистик.СсылкаНаСводнуюТаблицу);
	
	СписокДанных = Новый СписокЗначений;
	
	ТаблицаПериодов = Неопределено;
	
	Для каждого СтрокаСтатистик Из СтрокиСтатистик Цикл
		
		Если СоответствиеМассиваГруппировок = Неопределено Тогда 
			массивПолейРасшифровки = Неопределено;
		Иначе
			массивПолейРасшифровки = СоответствиеМассиваГруппировок.Получить(СтрокаСтатистик.ВидСтатистики);
		КонецЕсли;
				
		Если массивПолейРасшифровки = Неопределено или массивПолейРасшифровки.Количество() = 0 Тогда
			массивПолейРасшифровки = Новый Массив;
			массивПолейРасшифровки.Добавить(Перечисления.ИА_ПоляРасшифровки.Период);
			Если ЗначениеЗаполнено(СтрокаСтатистик.ВидСтатистики.Аналитика1) Тогда
				массивПолейРасшифровки.Добавить(Перечисления.ИА_ПоляРасшифровки.Аналитика1);
			КонецЕсли;
			Если ЗначениеЗаполнено(СтрокаСтатистик.ВидСтатистики.Аналитика2) Тогда
				массивПолейРасшифровки.Добавить(Перечисления.ИА_ПоляРасшифровки.Аналитика2);
			КонецЕсли;
			Если ЗначениеЗаполнено(СтрокаСтатистик.ВидСтатистики.Аналитика3) Тогда
				массивПолейРасшифровки.Добавить(Перечисления.ИА_ПоляРасшифровки.Аналитика3);
			КонецЕсли;
		КонецЕсли;
		
		СтарыеДанные = СтрокаСтатистик.Данные.Выгрузить();
		СписокДанных.Добавить(СтарыеДанные,?(СокрЛП(СтрокаСтатистик.НаименованиеДляЛегенды)="", Строка(СтрокаСтатистик.ВидСтатистики), СтрокаСтатистик.НаименованиеДляЛегенды));
		
		Если СтрокаСтатистик.СдвигПериода <> 0 Тогда
			
			СдвинутыеДатыНачалаКонца = Новый Структура("ДатаНачала, ДатаКонца", Объект.ДатаНачала, Объект.ДатаКонца);
			Если Не ИА_Статистики.ПолучитьСдвинутыеДатыНачалаКонца(Объект, СтрокаСтатистик, СдвинутыеДатыНачалаКонца) Тогда
				
				Сообщение = Новый СообщениеПользователю;  
				Сообщение.Текст = "В строке "+СтрокаСтатистик.НаименованиеДляЛегенды+" ""Вид сдвига периода"" меньше ""Периода детализации""! "+Символы.ПС + "Невозможно вывести статистики!";
				Сообщение.Сообщить();
				
				Отказ = Истина;
				
				Возврат;
				
			КонецЕсли;
			
			ДатаНачала = СдвинутыеДатыНачалаКонца.ДатаНачала;
			ДатаКонца  = СдвинутыеДатыНачалаКонца.ДатаКонца;
			
		Иначе
			
			ДатаНачала = Объект.ДатаНачала;
			ДатаКонца  = Объект.ДатаКонца;
			
		КонецЕсли;
		
		ИА_Статистики.ПолучитьТаблицуПериодов(ДатаНачала, ДатаКонца, СтрокаСтатистик, Объект.Настройка);

		ТаблицаПериодов = СтрокаСтатистик.Данные.Выгрузить();
		
		ПериодДетализации = СтрокаСтатистик.ПериодДетализации;
		
		НомерТаблицы = СписокДанных.Количество();
		
		ИмяКолонкиДатаНачала = "ДатаНачала" + НомерТаблицы; 
		ИмяКолонкиЗначение   = "Значение" + НомерТаблицы; 
		
		
		грПоля = "";
		заголовокКолонки ="";
		ЭтоПервый = Истина;
		Для каждого стр из массивПолейРасшифровки Цикл
			Если не ЭтоПервый Тогда
				грПоля = грПоля + " , ";
				заголовокКолонки = заголовокКолонки + " / ";
			КонецЕсли;
			
			грПоля = грПоля + " ПодЗапрос."+стр;
			
			ПолеЗаголовка = стр;
			Если ПолеЗаголовка = Перечисления.ИА_ПоляРасшифровки.Аналитика1 тогда
				ПолеЗаголовка = СтрокаСтатистик.ВидСтатистики.Аналитика1; 
			ИначеЕсли ПолеЗаголовка = Перечисления.ИА_ПоляРасшифровки.Аналитика2 тогда
				ПолеЗаголовка = СтрокаСтатистик.ВидСтатистики.Аналитика2;
			ИначеЕсли ПолеЗаголовка = Перечисления.ИА_ПоляРасшифровки.Аналитика3 тогда
				ПолеЗаголовка = СтрокаСтатистик.ВидСтатистики.Аналитика3;
			КонецЕсли;
			
			заголовокКолонки = заголовокКолонки + ПолеЗаголовка;
			ЭтоПервый = Ложь;
		КонецЦикла;
		
		
		РезТЗ_Данные = ИА_Защита_Статистика.ПолучитьТЗДанныеСтатистики(СтрокаСтатистик, ДатаНачала, ДатаКонца);
		РезТЗ_Данные1 = ИА_БФС.ТЗ_УдалитьПустыеТипы(РезТЗ_Данные, истина,истина);
				
		// делаем итоговый запрос
		АгрФункция = "СУММА(Количество)";				
		Агрегат =    "СУММА(ПодЗапрос.Количество)";
		Если СтрокаСтатистик.ВидСтатистики.ВидИтоговЗаОдинПериод = Перечисления.ИА_ВидыИтоговЗаОдинПериод.СреднееЗначение Тогда
			АгрФункция = "СРЕДНЕЕ(Количество)";
			Агрегат =     "СРЕДНЕЕ(ПодЗапрос.Количество)";
		ИначеЕсли СтрокаСтатистик.ВидСтатистики.ВидИтоговЗаОдинПериод = Перечисления.ИА_ВидыИтоговЗаОдинПериод.КоличествоРазличных Тогда
			АгрФункция = "КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Количество)";
			Агрегат =    "КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ПодЗапрос.Количество)";
		КонецЕсли;

		ЗапросДанных = Новый Запрос;
		МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
		ЗапросДанных.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
		ЗапросДанных.Текст = "ВЫБРАТЬ
		               |	ТЗ.ДатаНачала КАК ДатаНачала,
		               |	ТЗ.ДатаКонца КАК ДатаКонца
		               |ПОМЕСТИТЬ ТЗПериоды
		               |ИЗ
		               |	&ТЗ КАК ТЗ
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ
		               |	ТЗДанные.Период КАК Период,
					   |	ТЗДанные.Аналитика1 КАК Аналитика1,
					   |	ТЗДанные.Аналитика2 КАК Аналитика2,
					   |	ТЗДанные.Аналитика3 КАК Аналитика3,
		               |	ТЗДанные.Количество КАК Количество,
					   |	ТЗДанные.Вопрос КАК Вопрос,
		               |	ТЗДанные.Ответ КАК Ответ
		               |ПОМЕСТИТЬ ТЗДанные
		               |ИЗ
		               |	&ТЗДанные КАК ТЗДанные
		               |;
		               | ";
					   
		ЗапросДанных.УстановитьПараметр("ТЗ",ТаблицаПериодов);
		ЗапросДанных.УстановитьПараметр("ТЗДанные",РезТЗ_Данные1);					   
		ЗапросДанных.Выполнить();		
		
		ЗапросДанных.Текст = "ВЫБРАТЬ Разрешенные "+грПоля+"
			   |	,"+Агрегат+" КАК Количество
			   |ИЗ
			   |	(ВЫБРАТЬ 
			   |		ТЗПериоды.ДатаНачала КАК Период,
			   |		ТЗДанные.Аналитика1 КАК Аналитика1,
			   |		ТЗДанные.Аналитика2 КАК Аналитика2,
			   |		ТЗДанные.Аналитика3 КАК Аналитика3,
			   |		ТЗДанные.Количество КАК Количество,
			   |		ТЗДанные.Вопрос КАК Вопрос,
			   |		ТЗДанные.Ответ КАК Ответ
			   |	ИЗ
			   |		ТЗДанные КАК ТЗДанные
			   |			ЛЕВОЕ СОЕДИНЕНИЕ ТЗПериоды КАК ТЗПериоды ПО (ТЗДанные.Период МЕЖДУ ТЗПериоды.ДатаНачала И ТЗПериоды.ДатаКонца)			   
			   |) КАК ПодЗапрос
			   |
			   |СГРУППИРОВАТЬ ПО
			   |	"+грПоля+"
			   |УПОРЯДОЧИТЬ ПО
			   |	"+грПоля+"
			   |ИТОГИ
			   |	"+АгрФункция+"
			   |ПО
			   |	ОБЩИЕ,
			   |	"+СтрЗаменить(грПоля,"ПодЗапрос.","");
		
				
		Итого = 0;
		Выборка = ЗапросДанных.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Итого = Выборка.Количество;
		КонецЕсли;
		
		ЕстьКвота = ЗначениеЗаполнено(СтрокаСтатистик.Квота) И ЗначениеЗаполнено(СтрокаСтатистик.ТипКвоты);
		
		ОблШапка = ?(ЕстьКвота,
					Макет.ПолучитьОбласть("ШапкаСКвотой"),
					Макет.ПолучитьОбласть("Шапка"));
		ОблШапка.Параметры.Итог = Итого;
		СреднееИСостояние = Ложь;
		ВыводитьСреднее = Истина;
		Если СтрокаСтатистик.ВидСтатистики.ВидИтогов = Перечисления.ИА_ВидыИтогов.СреднееЗначение и СтрокаСтатистик.ВидСтатистики.ЗапросОтображаетСостояние Тогда
			ОблШапка.Параметры.Итог = Итого/ТаблицаПериодов.Количество();
			СреднееИСостояние = Истина;
		КонецЕсли;
		ОблШапка.Параметры.Заголовок = заголовокКолонки;
		ОблШапка.Параметры.ЗаголовокСтатистики = ?(СокрЛП(СтрокаСтатистик.НаименованиеДляЛегенды)="", СтрокаСтатистик.ВидСтатистики, СтрокаСтатистик.НаименованиеДляЛегенды);
		Если ЕстьКвота Тогда
			ОблШапка.Параметры.Квота = Формат(СтрокаСтатистик.Квота, "ЧДЦ=2");
		КонецЕсли;
		
		ТабДокРасшифровка.Вывести(ОблШапка);
			
		дерево = ЗапросДанных.Выполнить().Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкамСИерархией);
		ТабДокРасшифровка.НачатьАвтогруппировкуСтрок();
		
		Если дерево.Строки.Количество()>0 Тогда
			тзОтклоненияКвот = Неопределено; 
			Если ЕстьКвота Тогда
				тзОтклоненияКвот = ИА_Статистики.ПолучитьОтклонениеКвоты(СтарыеДанные, СтрокаСтатистик.Квота, СтрокаСтатистик.ТипКвоты);
			КонецЕсли;	
			ВывестиСтрокиВОтчет(дерево.Строки[0].Строки,ТабДокРасшифровка,1,массивПолейРасшифровки, макет, СтрокаСтатистик.ПериодДетализации, СреднееИСостояние, ВыводитьСреднее, тзОтклоненияКвот, СтрокаСтатистик);
		КонецЕсли;
		
		ТабДокРасшифровка.ЗакончитьАвтогруппировкуСтрок();
		
		//
		СтрокаСтатистик.Данные.Загрузить(СтарыеДанные);
	КонецЦикла;
	
	// сводка по нескольким графикам по периодам
	КоличествоТаблиц = СписокДанных.Количество();
	Если СписокДанных.Количество()>1 Тогда
		ОблШапка = Макет.ПолучитьОбласть("ШапкаСводно");
		ТабДокРасшифровка.Вывести(ОблШапка);
		
		ОблШапка = Макет.ПолучитьОбласть("ШапкаТаблицыСводно");
		ТабДокРасшифровка.Вывести(ОблШапка);
		
		
		Для каждого стрСтат из СписокДанных Цикл
			ОблКолонка = Макет.ПолучитьОбласть("КолонкаСтатистика");
			ОблКолонка.Параметры.Статистика = стрСтат.Представление;
			ТабДокРасшифровка.Присоединить(ОблКолонка);
		КонецЦикла;
		
		// данные
		Для каждого стрПериод Из СводнаяТаблица Цикл
		//Для каждого стрПериод Из СводнаяТаблицаПериодов Цикл
			
			ОблКолонка = Макет.ПолучитьОбласть("СтрокаПериод");
			ПараметрыПериод = "";
			
			//ИА_Арчил Тваладзе 2016.10.05
			ПараметрыПериод = ИА_Статистики.ПолучитьПараметрПериодДляСводнойТаблицыРасшифровки(ПараметрыПериод, ЕстьСдвигиПериода, КоличествоТаблиц, ПериодДетализации, стрПериод);
			//ИА_Арчил Тваладзе 2016.10.05
			
			ОблКолонка.Параметры.Период = ПараметрыПериод;
			ТабДокРасшифровка.Вывести(ОблКолонка);
			
			Для НомерТаблицы =1 по КоличествоТаблиц Цикл
				
				ОблКолонка = Макет.ПолучитьОбласть("КолонкаЗначение");
				
				ИмяКолонкиДатаНачала = "ДатаНачала_" + НомерТаблицы; 
				ИмяКолонкиЗначение   = "Значение_"   + НомерТаблицы; 
				
				ПараметрЗначение = " ";
				СтрокаПериода = СписокДанных[НомерТаблицы-1].Значение.Найти(стрПериод[ИмяКолонкиДатаНачала], "ДатаНачала");
				Если СтрокаПериода <> Неопределено Тогда
					
					ЗначениеЗначения = СтрокаПериода.Значение;
					Если ЗначениеЗначения = null Тогда
						ЗначениеЗначения = " ";
					КонецЕсли;
					
					ПараметрЗначение = ЗначениеЗначения;
					
				КонецЕсли;
				
				ОблКолонка.Параметры.Значение = ПараметрЗначение;
				ТабДокРасшифровка.Присоединить(ОблКолонка);
				
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ВывестиСтрокиВОтчет(строки, ТабДокРасшифровка,уровень,массивПолей, макет, ПериодДет, СреднееИСостояние, ВыводитьСреднее, тзОтклоненияКвот = Неопределено, СтрокаСтатистик)
	
	ВыводитьСреднее1 = ВыводитьСреднее;
	
	Для каждого стр из строки цикл
		Если стр[строка(массивПолей[0])] = null или уровень > массивПолей.Количество() Тогда // общий итог
			Продолжить;
		КонецЕсли;
		
		Если уровень = 1 И тзОтклоненияКвот <> Неопределено Тогда
			Если массивПолей[уровень-1] = Перечисления.ИА_ПоляРасшифровки.Период Тогда			
				ОбластьСтрока = Макет.ПолучитьОбласть("ПериодСКвотой");
			ИначеЕсли массивПолей[уровень-1] = Перечисления.ИА_ПоляРасшифровки.Аналитика1 Тогда
				ОбластьСтрока = Макет.ПолучитьОбласть("Аналитика1СКвотой");
			ИначеЕсли массивПолей[уровень-1] = Перечисления.ИА_ПоляРасшифровки.Аналитика2 Тогда
				ОбластьСтрока = Макет.ПолучитьОбласть("Аналитика2СКвотой");
			ИначеЕсли массивПолей[уровень-1] = Перечисления.ИА_ПоляРасшифровки.Аналитика3 Тогда
				ОбластьСтрока = Макет.ПолучитьОбласть("Аналитика3СКвотой");
			КонецЕсли;	
			ОбластьСтрока.Параметры.Заполнить(стр);
			ПериодП = Неопределено;
			ПолучитьПериод(стр, ПериодП);
			с = тзОтклоненияКвот.Найти(ПериодП, "ДатаНачала");
			Если Не с = Неопределено Тогда
				ОбластьСтрока.Параметры.Заполнить(с);
				ОбластьСтрока.Параметры.Количество = с.Значение;
			КонецЕсли;	
		Иначе
			ОбластьСтрока = Макет.ПолучитьОбласть(Строка(массивПолей[уровень-1]));
			ОбластьСтрока.Параметры.Заполнить(стр);
		КонецЕсли; 
		
		//
		Если массивПолей[уровень-1] = Перечисления.ИА_ПоляРасшифровки.Период Тогда
			ОбластьСтрока.Параметры.Период = ПолучитьПредставлениеТочкиПериода(ПериодДет, стр.Период);
			ВыводитьСреднее1 = Ложь;	
		КонецЕсли;
		//
		Если СреднееИСостояние и ВыводитьСреднее1 и стр.Строки.Количество()>0 Тогда
			ОбластьСтрока.Параметры.Количество = стр.Количество / стр.Строки.Количество();
		КонецЕсли;
        
        //{ Вывод расшифровки
        ИА_Поле = Строка(массивПолей[уровень-1]);
        ИА_ПолеРасшифровка = ИА_Поле + "Объект";
        Если ИА_БФКС.РеквизитЕсть(ОбластьСтрока.Параметры, ИА_ПолеРасшифровка) Тогда
        	ОбластьСтрока.Параметры[ИА_ПолеРасшифровка] = ОбластьСтрока.Параметры[ИА_Поле];
        КонецЕсли; 
        //} 
		
		//ИА_Арчил Тваладзе 2016.10.05
		ВидСтатистики = СтрокаСтатистик.ВидСтатистики;
		СтруктураРасшифровки = Новый Структура("ВидСтатистики", ВидСтатистики);
		
		Для каждого Поле  Из массивПолей  Цикл
			СтруктураРасшифровки.Вставить(Строка(Поле), стр[Строка(Поле)]); 
		КонецЦикла;
		Если СтруктураРасшифровки.Свойство("Период") Тогда
			
			Если стр.Период = null Тогда
				СтруктураРасшифровки.Период = стр.Период;
			Иначе
				СтруктураРасшифровки.Период = ПолучитьГраницыПериода(ПериодДет, стр.Период);
			КонецЕсли;
			
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрокаСтатистик.Аналитика1) Тогда
			СтруктураРасшифровки.Вставить("Аналитика1", СтрокаСтатистик.Аналитика1);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрокаСтатистик.Аналитика2) Тогда
			СтруктураРасшифровки.Вставить("Аналитика2", СтрокаСтатистик.Аналитика2);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрокаСтатистик.Аналитика3) Тогда
			СтруктураРасшифровки.Вставить("Аналитика3", СтрокаСтатистик.Аналитика3);
		КонецЕсли;
		  
		ОбластьСтрока.Параметры.СтруктураРасшифровки =  СтруктураРасшифровки;
		//Конец ИА_Арчил Тваладзе 2016.10.05
		
		ОбластьСтрока.Параметры[Строка(массивПолей[уровень-1])] = Лев("          ", уровень-1) + ОбластьСтрока.Параметры[Строка(массивПолей[уровень-1])]; 
		ТабДокРасшифровка.Вывести(ОбластьСтрока, уровень,,ложь);
		
		ВывестиСтрокиВОтчет(стр.Строки,ТабДокРасшифровка,уровень + 1,массивПолей, макет, ПериодДет, СреднееИСостояние, ВыводитьСреднее1,,СтрокаСтатистик);
	КонецЦикла;
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ПолучитьПериод(стр, ПериодП)
	Если не ЗначениеЗаполнено(стр.Период) Тогда
		ПолучитьПериод(стр.Строки[0], ПериодП);
	Иначе
		ПериодП = стр.Период;
	КонецЕсли;
		
КонецПроцедуры

&НаСервере
Функция ПолучитьПредставлениеТочкиПериода(ПериодДет, ДатаНач)
	Если ПериодДет = Перечисления.ИА_ПериодыДетализации.День тогда
		Возврат Формат(ДатаНач,"ДФ=dd.MM.yy");
	ИначеЕсли ПериодДет = Перечисления.ИА_ПериодыДетализации.Неделя тогда
		Возврат Формат(ДатаНач,"ДФ=dd.MM.yy")+"-" + Формат(ДатаНач + 60*60*24*6,"ДФ=dd.MM.yy");
	ИначеЕсли ПериодДет = Перечисления.ИА_ПериодыДетализации.Месяц тогда
		Возврат Формат(ДатаНач,"ДФ=MM.yyyy");
	ИначеЕсли ПериодДет = Перечисления.ИА_ПериодыДетализации.Квартал тогда
		Возврат Формат(ДатаНач,"ДФ=MM.yyyy");
	ИначеЕсли ПериодДет = Перечисления.ИА_ПериодыДетализации.Год тогда
		Возврат Формат(ДатаНач,"ДФ=yyyy");
	КонецЕсли;
КонецФункции

&НаКлиенте
Процедура ВыборПериода(Команда)
	Период  = Новый СтандартныйПериод(Объект.ДатаНачала,Объект.ДатаКонца);
	Диалог = Новый ДиалогРедактированияСтандартногоПериода();
	Диалог.Период = Период;
	Если Диалог.Редактировать() Тогда 
		Период = Диалог.Период;
		Объект.ДатаНачала = Период.ДатаНачала;
		Объект.ДатаКонца = Период.ДатаОкончания;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура Поле2ПриИзменении(Элемент)
	НарисоватьДиаграммы(ложь);
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	Если не ИА_Защита_Общий.ЛицензияДоступна("Статистика") Тогда
		Отказ = Истина;
		возврат;
	КонецЕсли;
    
    РольСтатистикиПросмотрДоступна 		 = ИА_КСУОбщийСервер.ПросмотрСтатистикДоступен();
	РольСтатистикиРедактированиеДоступна = ИА_КСУОбщийСервер.РедактированиеСтатистикДоступно();
		
	#Если ВебКлиент Тогда
		ВебКлиент = истина;
		Элементы.Печать.Видимость = ложь;
	#КонецЕсли
	
	//////////////////////// ОТЛАДКА!!!!!!!!!!!!!!!!!
	//ВебКлиент = истина;
	////////////////////////////////////////////
	
	Если не ВебКлиент тогда
		ПодключитьОбработчикОжидания("ПроверитьИзменениеРазмераОкна",2,ложь);
		КонтрольРазмераВкл = истина;
	КонецЕсли;
	
	Элементы.ПолеХТМЛ.Видимость = не ВебКлиент;
КонецПроцедуры

&НаКлиенте
Процедура КонтрольИзмененияРазмера_Включить()
	КонтрольРазмераВкл = истина;
КонецПроцедуры

&НаКлиенте
Процедура КонтрольИзмененияРазмера_Выключить()
	КонтрольРазмераВкл = ложь;
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьИзменениеРазмераОкна()
	Если не КонтрольРазмераВкл Тогда
		Возврат;
	КонецЕсли;
	                 
	Если ДеревоСтатистик.ПолучитьЭлементы().Количество()>0 Тогда // статистики сформированы
		предРазмер = sw;
		ОпределитьРазрешениеЭкрана();
		Если предРазмер > sw + 50 ИЛИ предРазмер < sw - 50 Тогда
			НарисоватьДиаграммы(ложь);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьЗначение(номерСтатСтр, ЭтоРС = ложь) Экспорт
	номерСтат = число(номерСтатСтр)-1;
	
	Если ДеревоСтатистик.ПолучитьЭлементы()[номерСтат].ПолучитьЭлементы().Количество()>1 Тогда
		СписокДляВыбора = Новый СписокЗначений;
		Для каждого стрСтрСтат из ДеревоСтатистик.ПолучитьЭлементы()[номерСтат].ПолучитьЭлементы() Цикл 
			струкДоб = Новый Структура("ВидСтатистики,Аналитика1,Аналитика2,Аналитика3");
			ЗаполнитьЗначенияСвойств(струкДоб, стрСтрСтат);
			СписокДляВыбора.Добавить(струкДоб, Строка(струкДоб.ВидСтатистики) + "," + струкДоб.Аналитика1 + "," + струкДоб.Аналитика2 + "," + струкДоб.Аналитика3);		
		КонецЦикла;
		
		Парам = Новый Структура("СписокСтатистик",СписокДляВыбора);
		ОткрытьФорму("ОбщаяФорма.ИА_ВыборСтатистики",Парам,,,,, Новый ОписаниеОповещения("ДобавитьЗначениеЗавершение", ЭтотОбъект, Новый Структура("номерСтат, ЭтоРС", номерСтат, ЭтоРС)), РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);
        Возврат;
	Иначе
		СтрокаГраф = ДеревоСтатистик.ПолучитьЭлементы()[номерСтат].ПолучитьЭлементы()[0];
	КонецЕсли;
	
	ДобавитьЗначениеФрагмент(НомерСтат, СтрокаГраф, ЭтоРС);
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьЗначениеЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	номерСтат = ДополнительныеПараметры.номерСтат;
	ЭтоРС = ДополнительныеПараметры.ЭтоРС;
	
	
	СтрокаГраф = Результат;
	
	Если СтрокаГраф = Неопределено Тогда
		возврат;
	КонецЕсли;
	СтрокаГраф = СтрокаГраф.Значение;
	
	ДобавитьЗначениеФрагмент(НомерСтат, СтрокаГраф, ЭтоРС);

КонецПроцедуры

&НаКлиенте
Процедура ДобавитьЗначениеФрагмент(Знач НомерСтат, Знач СтрокаГраф, Знач ЭтоРС)
	
	Перем ФДок;
	
	Если не СтатистикаРучная(СтрокаГраф.ВидСтатистики) Тогда
		ПоказатьПредупреждение(,"Значения данной статистики нельзя редактировать вручную!");
		Возврат;
	КонецЕсли;
	
	Парам = Новый Структура("БыстрыйРежим,ВидСтатистики",истина,СтрокаГраф.ВидСтатистики);
	Если ЗначениеЗаполнено(СтрокаГраф.Аналитика1) Тогда
		Парам.Вставить("Аналитика1", СтрокаГраф.Аналитика1);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтрокаГраф.Аналитика2) Тогда
		Парам.Вставить("Аналитика2", СтрокаГраф.Аналитика2);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтрокаГраф.Аналитика3) Тогда
		Парам.Вставить("Аналитика3", СтрокаГраф.Аналитика3);
	КонецЕсли;
	
	ОткрытьФорму("Документ.ИА_Статистика.Форма.ФормаДокументаУпр",Парам,,,,, Новый ОписаниеОповещения("ДобавитьЗначениеФрагментЗавершение", ЭтотОбъект, Новый Структура("НомерСтат, ЭтоРС", НомерСтат, ЭтоРС)), РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);

КонецПроцедуры

&НаКлиенте
Процедура ДобавитьЗначениеФрагментЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	НомерСтат = ДополнительныеПараметры.НомерСтат;
	ЭтоРС = ДополнительныеПараметры.ЭтоРС;	
	
	Если ЭтоРС Тогда
		Оповестить("КСУ_ОбновитьМС");
	Иначе
		ПересчитатьСтатистику(НомерСтат);
		НарисоватьДиаграммы(ложь);
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция СтатистикаРучная(ВидСтатистики)
	Возврат ВидСтатистики.ВариантПолученияДанных = Перечисления.ИА_ВариантыПолученияДанныхСтатистик.ДокументомСтатистика;
КонецФункции

&НаСервере
Процедура ПересчитатьСтатистику(НомерСтат)
	деревоСТ = РеквизитФормыВЗначение("ДеревоСтатистик");
	Выходные = ИА_Защита_Статистика.ПолучитьВыходныеЗаПериод(Объект.ДатаНачала, Объект.ДатаКонца);
	
	СтрокаСтатистикИсходная = деревоСТ.Строки[НомерСтат];
	Для Каждого СтрокаСтатистик Из ДеревоСТ.Строки Цикл
		ОбновлятьСтатистику = Ложь;
		Для Каждого СтрокаСтрокаСтатистик Из СтрокаСтатистик.Строки Цикл
			Если СтрокаСтрокаСтатистик.ВидСтатистики = СтрокаСтатистикИсходная.Строки[0].ВидСтатистики Тогда
				ОбновлятьСтатистику = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Если ОбновлятьСтатистику Тогда
			ИА_Статистики.ПолучитьТочки(Объект,Выходные, СтрокаСтатистик);
			ЗначениеВРеквизитФормы(деревоСТ, "ДеревоСтатистик");
		КонецЕсли;		
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	СтарыйБраузер = Константы.ИА_СтарыйБраузер.Получить(); 
	ТолькоЗавершПериоды = истина;
	ОтображатьОдинБудущийПериодСтатистики = Константы.ИА_ОтображатьОдинБудущийПериодСтатистики.Получить();
	
	Если ОтображатьОдинБудущийПериодСтатистики Тогда
		ТолькоЗавершПериоды = Ложь;
	КонецЕсли;
	
	ВыводитьПодписиЗначенийПриПечати = ИА_НастройкиС.ЗначениеНастройкиТекПользователя(ПланыВидовХарактеристик.ИА_НастройкиПользователей.ВыводитьПодписиЗначенийПриПечати);
	ИспользоватьРучнойМаштабГрафиков = Константы.ИА_ИспользоватьРучнойМаштабГрафиков.Получить();

КонецПроцедуры


