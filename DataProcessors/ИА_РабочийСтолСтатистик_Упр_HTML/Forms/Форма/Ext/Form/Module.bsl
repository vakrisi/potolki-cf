&НаСервереБезКонтекста
Функция ПолучитьКоличествоАналитик(пВидСтатистики)
	кол = 0;
	Если ЗначениеЗаполнено(пВидСтатистики.Аналитика1) Тогда
		кол = кол + 1;
	Иначе
		Возврат кол;
	КонецЕсли;
	Если ЗначениеЗаполнено(пВидСтатистики.Аналитика2) Тогда
		кол = кол + 1;
	Иначе
		Возврат кол;
	КонецЕсли;
	Если ЗначениеЗаполнено(пВидСтатистики.Аналитика3) Тогда
		кол = кол + 1;
	Иначе
		Возврат кол;
	КонецЕсли;
	
	Возврат кол;
КонецФункции

