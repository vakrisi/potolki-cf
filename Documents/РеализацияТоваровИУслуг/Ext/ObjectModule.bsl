#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий
	
Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	Если ЭтоНовый() Тогда			
		ИнициализироватьСлужебныеРеквизиты();		
	КонецЕсли;
	
	ОбщийМодуль.ЗаполнитьШапкуДокумента(ЭтотОбъект);
	// #12298   #14947 закомментировано ПараметрыСеанса.ТекущийПользователь.Склад - склад отгрузки
	//Если ДанныеЗаполнения = Неопределено И Константы.СкладОтгрузкиПотолоковОтличаетсяОтСкладаГотовойПродукции.Получить() Тогда
	//	Склад = ПараметрыСеанса.ТекущийПользователь.СкладОтгрузки;	
	//КонецЕсли;
	
	ТипДанныхЗаполнения = ТипЗнч(ДанныеЗаполнения);
	
	Если ТипДанныхЗаполнения = Тип("Структура") Тогда
		Если ДанныеЗаполнения.Свойство("МассивДокументов") Тогда
			Если ДанныеЗаполнения.МассивДокументов.Количество() > 0 Тогда
				Если ТипЗнч(ДанныеЗаполнения.МассивДокументов[0]) = Тип("ДокументСсылка.ЗаказПокупателя") Тогда
					ЗаполнитьПоЗаказуПокупателя(ДанныеЗаполнения.МассивДокументов);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	
	ИначеЕсли ТипДанныхЗаполнения = Тип("ДокументСсылка.ПоступлениеТоваровИУслуг") Тогда
		// Заполнение шапки
		//Комментарий = ДанныеЗаполнения.Комментарий; //#5849
		Организация = ДанныеЗаполнения.Организация;
		Склад = ДанныеЗаполнения.Склад;
		Основание = ДанныеЗаполнения.Ссылка;
		НомерРозничногоДоговора	= ДанныеЗаполнения.НомерРозничногоДоговора; //#7381
		Для Каждого ТекСтрокаТовары Из ДанныеЗаполнения.Товары Цикл
			НоваяСтрока = Товары.Добавить();
			НоваяСтрока.ЕдиницаИзмерения = ТекСтрокаТовары.ЕдиницаИзмерения;
			НоваяСтрока.Количество = ТекСтрокаТовары.Количество;
			НоваяСтрока.Коэффициент = ТекСтрокаТовары.Коэффициент;
			НоваяСтрока.Номенклатура = ТекСтрокаТовары.Номенклатура;
			НоваяСтрока.СерияНоменклатуры = ТекСтрокаТовары.СерияНоменклатуры;
			НоваяСтрока.ХарактеристикаНоменклатуры = ТекСтрокаТовары.ХарактеристикаНоменклатуры;
			НоваяСтрока.СтавкаНДС = УчетНДС.СтавкаНДСПоУмолчанию(Организация);
			//2017-08-02
			НоваяСтрока.Потолок = ?(Справочники.ВидыНоменклатуры.ЭтоНоменклатураПотолкаИлиОтреза(ТекСтрокаТовары.Номенклатура), ТекСтрокаТовары.Номенклатура, Неопределено);

		КонецЦикла;
		Для Каждого ТекСтрокаУслуги Из ДанныеЗаполнения.Услуги Цикл
			НоваяСтрока = Услуги.Добавить();
			НоваяСтрока.ЕдиницаИзмерения = ТекСтрокаУслуги.ЕдиницаИзмерения;
			НоваяСтрока.Количество = ТекСтрокаУслуги.Количество;
			НоваяСтрока.Коэффициент = ТекСтрокаУслуги.Коэффициент;
			НоваяСтрока.Номенклатура = ТекСтрокаУслуги.Номенклатура;
			НоваяСтрока.СтавкаНДС = УчетНДС.СтавкаНДСПоУмолчанию(Организация);
		КонецЦикла;
		
	ИначеЕсли ТипДанныхЗаполнения = Тип("ДокументСсылка.ПеремещениеТоваров") Тогда
		// Заполнение шапки
		//Комментарий = ДанныеЗаполнения.Комментарий; //#5849
		Организация = ДанныеЗаполнения.Организация;
		Склад = ДанныеЗаполнения.СкладПолучатель;
		Основание = ДанныеЗаполнения.Ссылка;
		Для Каждого ТекСтрокаТовары Из ДанныеЗаполнения.Товары Цикл
			НоваяСтрока = Товары.Добавить();
			НоваяСтрока.ЕдиницаИзмерения = ТекСтрокаТовары.ЕдиницаИзмерения;
			НоваяСтрока.Количество = ТекСтрокаТовары.Количество;
			НоваяСтрока.Коэффициент = ТекСтрокаТовары.Коэффициент;
			НоваяСтрока.Номенклатура = ТекСтрокаТовары.Номенклатура;
			НоваяСтрока.СерияНоменклатуры = ТекСтрокаТовары.СерияНоменклатуры;
			НоваяСтрока.ХарактеристикаНоменклатуры = ТекСтрокаТовары.ХарактеристикаНоменклатуры;
			НоваяСтрока.СтавкаНДС = УчетНДС.СтавкаНДСПоУмолчанию(Организация);
			//2017-08-02
			НоваяСтрока.Потолок = ?(Справочники.ВидыНоменклатуры.ЭтоНоменклатураПотолкаИлиОтреза(ТекСтрокаТовары.Номенклатура), ТекСтрокаТовары.Номенклатура, Неопределено);
		КонецЦикла;
		
	ИначеЕсли ТипДанныхЗаполнения = Тип("ДокументСсылка.ЗаказДоговор") Тогда
		// Заполнение шапки
		//Комментарий = ДанныеЗаполнения.Комментарий; //#5849
		Организация = ДанныеЗаполнения.Организация;
		Основание = ДанныеЗаполнения.Ссылка;
		Контрагент = ДанныеЗаполнения.Контрагент;
		Валюта = ДанныеЗаполнения.Валюта;
		ДоговорКонтрагента = ДанныеЗаполнения.ДоговорКонтрагента;
		Склад = ОбщийМодульСервер.НастройкаПользователя("СкладРозница");
		
		ТекущаяКомната = Неопределено;
		Для Каждого ТекущаяСтрока Из ДанныеЗаполнения.ТоварыУслуги Цикл
			Если ТекущаяСтрока.Номенклатура.ВидНоменклатуры = Справочники.ВидыНоменклатуры.Услуга Тогда
				НоваяСтрока = Услуги.Добавить();
			Иначе
				НоваяСтрока = Товары.Добавить();
			КонецЕсли;
			
			// ищем потолок в комнате			
			Если Справочники.ВидыНоменклатуры.ЭтоНоменклатураПотолкаИлиОтреза(ТекущаяСтрока.Номенклатура) Тогда
				ТекущийПотолок = ТекущаяСтрока.Номенклатура;
			Иначе				
				Если ТекущаяСтрока.Комната <> ТекущаяКомната Тогда
					ТекущийПотолок = Неопределено;
					ПараметрыОтбора = Новый Структура("Комната", ТекущаяСтрока.Комната);
					НайденныеСтроки = ДанныеЗаполнения.ТоварыУслуги.НайтиСтроки(ПараметрыОтбора);
					Для каждого Строка Из НайденныеСтроки Цикл
						Если Справочники.ВидыНоменклатуры.ЭтоНоменклатураПотолкаИлиОтреза(Строка.Номенклатура) Тогда
							ТекущийПотолок = Строка.Номенклатура;
							Прервать;					
						КонецЕсли; 				
					КонецЦикла;	
					ТекущаяКомната = ТекущаяСтрока.Комната;
				КонецЕсли; 
			КонецЕсли;
			
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущаяСтрока);
			НоваяСтрока.СтавкаНДС = УчетНДС.СтавкаНДСПоУмолчанию(Организация);
			НоваяСтрока.СуммаНДС = УчетНДС.РассчитатьСуммуНДС(НоваяСтрока.Сумма, УчетНДС.ОрганизацияЯвляетсяПлательщикомНДС(Организация), , УчетНДС.ПолучитьСтавкуНДС(НоваяСтрока.СтавкаНДС));
			НоваяСтрока.Потолок = ТекущийПотолок;
		//КонецЕсли;
		КонецЦикла;
		
	ИначеЕсли ТипДанныхЗаполнения = Тип("ДокументСсылка.ЗаказПокупателя") Тогда
		ЗаполнитьПоЗаказуПокупателя(ДанныеЗаполнения);
	КонецЕсли;
		
	//заполним адрес доставки по адресу контрагента 	
	Если НЕ ЗначениеЗаполнено(АдресДоставки)
		И НЕ ДанныеЗаполнения = Неопределено И ТипЗнч(ДанныеЗаполнения) <> Тип("Структура") Тогда
		Если не ДанныеЗаполнения.Метаданные().Реквизиты.Найти("Контрагент") = Неопределено Тогда 
			//ТаблицаАдресов = ДанныеЗаполнения.Контрагент.АдресаДоставки.Выгрузить();
			//Если ТаблицаАдресов.Количество() > 0 Тогда 
			//	ОсновнойАдресКонтрагента = ТаблицаАдресов.Найти(Истина,"Основной");
			//	Если ОсновнойАдресКонтрагента = Неопределено Тогда 
			//		АдресДоставки = ТаблицаАдресов[0].Адрес;
			//	Иначе 
			//		АдресДоставки = ОсновнойАдресКонтрагента.Адрес;
			//	КонецЕсли;
			//КонецЕсли;
			АдресДоставки = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(ДанныеЗаполнения.Контрагент, Справочники.ВидыКонтактнойИнформации.АдресДоставкиКонтрагента);
		КонецЕсли;
	КонецЕсли;
	
	ОбщийМодуль.ОбработкаЗаполненияПодписей(ЭтотОбъект);
	
	СтатьяДоходов = ФинансыСервер.ПолучитьСтатьюДоходовРасходов(ЭтотОбъект);
	
	Если ЭтоНовый() Тогда
		ДозаполнитьПоУмолчанию();
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	
	ИнициализироватьСлужебныеРеквизиты();
	
	УчитыватьНДС = УчетНДС.ОрганизацияЯвляетсяПлательщикомНДС(Организация);
	Для каждого СтрокаТЧ из Товары Цикл	
		СтрокаТЧ.СкидкаБонусами    = 0; //#14482
		СтрокаТЧ.БонусыКНачислению = 0; //#14482
		
		ОбработкаТабличныхЧастейКлиентСервер.ПересчитатьСуммуСУчетомСкидокВСтрокеТЧ(СтрокаТЧ, Ложь, , Истина);
		ОбработкаТабличныхЧастейКлиентСервер.ПересчитатьСуммуНДСВСтрокеТЧ(СтрокаТЧ, УчитыватьНДС);
	КонецЦикла;

	Для каждого СтрокаТЧ из Услуги Цикл	
		СтрокаТЧ.СкидкаБонусами    = 0; //#14482
		СтрокаТЧ.БонусыКНачислению = 0; //#14482
		
		ОбработкаТабличныхЧастейКлиентСервер.ПересчитатьСуммуСУчетомСкидокВСтрокеТЧ(СтрокаТЧ, Ложь, , Истина);
		ОбработкаТабличныхЧастейКлиентСервер.ПересчитатьСуммуНДСВСтрокеТЧ(СтрокаТЧ, УчитыватьНДС);
	КонецЦикла;
	
	UDS_КодСкидки = "";
	UDS_СуммаСкидки = 0;
	UDS_ИдентификаторОперации = "";
	UDS_ДатаОперации = Дата(1,1,1);
	
	ДозаполнитьПоУмолчанию();

КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	Если Товары.Количество() = 0 И Услуги.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Запрещено проводить документ с пустыми табличными частями ""Товары""/""Услуги""!'"),,, "Объект.Товары", Отказ);
	КонецЕсли;
			
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Документы.ЗаказПокупателя.ПроверитьЗаполнениеНаОснованииЗаказа(ЭтотОбъект, Отказ, РежимЗаписи);
	
	Если ЭтоНовый() И ЗначениеЗаполнено(Организация) И ЗначениеЗаполнено(Контрагент) Тогда
		//#10822
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("ОрганизацияПроизводства", Организация);
		Запрос.УстановитьПараметр("КонтрагентРозницы", 		 Контрагент);
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ШапкаПланаОбмена.Ссылка КАК Узел
		|ИЗ
		|	ПланОбмена.ОбменБазаПроизводстваБазаРозницы КАК ШапкаПланаОбмена
		|ГДЕ
		|	НЕ ШапкаПланаОбмена.ЭтотУзел
		|	И ШапкаПланаОбмена.ЭтоБазаПроизводства
		|	И ШапкаПланаОбмена.ОрганизацияПроизводства = &ОрганизацияПроизводства
		|	И ШапкаПланаОбмена.КонтрагентРозницы = &КонтрагентРозницы
		|	И НЕ ШапкаПланаОбмена.ПометкаУдаления";		
			
		РезультатЗапроса = Запрос.Выполнить();
		АвтоматическиСоздатьДокументПоступленияОтПроизводстваНаРозницуУП = НЕ РезультатЗапроса.Пустой();
	КонецЕсли;
	
	//#13710
	ОбщийМодульСервер.ПроверитьИзменениеВзаиморасчетовПередЗаписью(ЭтотОбъект, РежимЗаписи);
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, Режим)

	//проверки
	Для каждого ТекущаяСтрока из Услуги Цикл
		СтруктураПараметров = Новый Структура("Ссылка, ТабличнаяЧасть, ИмяТабличнойЧасти, НомерСтроки", ЭтотОбъект, "Услуги", "Услуги", ТекущаяСтрока.НомерСтроки);
		ОбработкаТабличныхЧастейСервер.ПроверитьЦенуСтроки(ТекущаяСтрока, СтруктураПараметров, Отказ);
	КонецЦикла;	
	
	Для каждого ТекущаяСтрока из Товары Цикл
		СтруктураПараметров = Новый Структура("Ссылка, ТабличнаяЧасть, ИмяТабличнойЧасти, НомерСтроки", ЭтотОбъект, "Товары", "Товары", ТекущаяСтрока.НомерСтроки);
		ОбработкаТабличныхЧастейСервер.ПроверитьЦенуСтроки(ТекущаяСтрока, СтруктураПараметров, Отказ);
	КонецЦикла;	
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	ОрганизацияТоваров = Организация;
	Если Константы.ОбщиеСклады.Получить() Тогда
		ОрганизацияТоваров = Справочники.Организации.ПустаяСсылка();
	КонецЕсли;
	
	//ДВИЖЕНИЯ
	//списание со склада
	ДатаДвижения = Дата;
	Если ДатаДвижения = Дата(1,1,1) Тогда
		ДатаДвижения = ТекущаяДатаСеанса();
	КонецЕсли;
	Движения.ТоварыНаСкладах.Записывать = Истина;
	Отказ = НЕ Движения.ТоварыНаСкладах.КонтрольОстатков(Ссылка, ОрганизацияТоваров, Склад, Товары, ДатаДвижения);
	Если Отказ Тогда
		Возврат;
	Иначе
		//++ №8793 товары нужно свернуть, чтобы корректно списать себестоимость
		мТовары = Товары.Выгрузить();
		мТовары.Свернуть("Номенклатура, ХарактеристикаНоменклатуры, СерияНоменклатуры, ЕдиницаИзмерения, Коэффициент", "Количество"); 
		//-- №8793
		Для Каждого Товар Из мТовары Цикл
			Расход = Движения.ТоварыНаСкладах.Добавить();
			Расход.ВидДвижения = ВидДвиженияНакопления.Расход;
			Расход.Период = ДатаДвижения;
			Расход.Организация = ОрганизацияТоваров;
			Расход.Склад = Склад;
			Расход.Номенклатура = Товар.Номенклатура;
			Расход.ХарактеристикаНоменклатуры = Товар.ХарактеристикаНоменклатуры;
			Расход.СерияНоменклатуры = Товар.СерияНоменклатуры;
			Расход.Количество = Товар.Количество * Товар.Коэффициент;
			//#8288
			//Расход.Сумма = Расход.Количество * Движения.ТоварыНаСкладах.ПолучитьЦенуОстаткаНоменклатуры(ДатаДвижения, ОрганизацияТоваров, Склад, Расход.Номенклатура, Расход.ХарактеристикаНоменклатуры, Расход.СерияНоменклатуры);
			СтруктураЦенОстатков = Движения.ТоварыНаСкладах.ПолучитьЦеныОстаткаНоменклатуры(ДатаДвижения, ОрганизацияТоваров, Склад, Расход.Номенклатура, Расход.ХарактеристикаНоменклатуры, Расход.СерияНоменклатуры);
			Расход.Сумма = Расход.Количество * СтруктураЦенОстатков.Цена;
			Расход.СуммаВал = Расход.Количество * СтруктураЦенОстатков.ЦенаВал;
		КонецЦикла;
	КонецЕсли;
	
	// В случае, если основанием является заказ покупателя спишем резервы
	Если ТипЗнч(Основание) = Тип("ДокументСсылка.ЗаказПокупателя") И НЕ Основание.Пустая() Тогда
		
		Движения.ТоварыВРезервеНаСкладах.Записывать = Истина;
		
		СписокТоваров = Товары.Выгрузить();
		СписокТоваров.Очистить();
		
		Для Каждого ТекущаяСтрока Из Товары Цикл
			
