		НаборЗаписейПоВыработке = Зарплата.РассчитатьВыработкуПоДокументу(Ссылка);
	КонецЕсли;
	
	Для Каждого СтрокаВыработки Из НаборЗаписейПоВыработке Цикл
		Если СтрокаВыработки.ЭтоРозница Тогда
			Движение = Движения.ВыработкаИсполнителейРозницы.Добавить();
			ЗаполнитьЗначенияСвойств(Движение, СтрокаВыработки);
		Иначе
			Движение = Движения.ВыработкаИсполнителейПроизводства.Добавить();
			ЗаполнитьЗначенияСвойств(Движение, СтрокаВыработки);
		КонецЕсли;
	КонецЦикла;	
	
	Если Константы.ВестиРасчетыПоЗаказамПоРТиУ.Получить() Тогда
		//РасчетыПоЗаказам
		Движения.РасчетыПоЗаказам.Записывать = Истина;
		Движение = Движения.РасчетыПоЗаказам.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
		Движение.Период = Дата;
		Движение.Заказ = Ссылка;
		Движение.Сумма = СуммаДокумента;
		Движение.Контрагент = Контрагент; // №6496 добавлен контрагент в измерение
		
		//РасчетыПоЗаказам добавим расход бонусов
		Если СуммаБонусовКСписаниюПоДисконтнойКарте > 0
			И ?(СлужебныйУчетБонусовПоДисконтнымКартам, НЕ ДисконтнаяКарта.Пустая(), Истина) // №6316 нужно проверить заполнение дисконтной карты	
		Тогда
			Если ТипЗнч(Основание) = Тип("ДокументСсылка.ЗаказДоговор")
				или ТипЗнч(Основание) = Тип("ДокументСсылка.ЗаказНаПроизводство")
				или ТипЗнч(Основание) = Тип("ДокументСсылка.ЗаказПокупателя") Тогда		
				
				Движение = Движения.РасчетыПоЗаказам.Добавить();
				Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
				Движение.Период = Дата;
				Движение.Заказ = Основание;
				Движение.Сумма = СуммаБонусовКСписаниюПоДисконтнойКарте;
				Движение.Контрагент = Контрагент; // №6496 добавлен контрагент в измерение
			КонецЕсли;	
		КонецЕсли;
	КонецЕсли;			
	
	//БонусыКонтрагентов
	Если СлужебныйВидБонуснойСистемы = Перечисления.ВидыБонусныхСистем.Внутренняя Тогда
		//Если Константы.АвтоматическоеНачислениеБонусов.Получить() Тогда
		Если НачислятьБонусы 
			И ?(СлужебныйУчетБонусовПоДисконтнымКартам, НЕ ДисконтнаяКарта.Пустая(), Истина) // №6316 нужно проверить заполнение дисконтной карты
			Тогда
			Если НЕ СуммаБонусовКНачислениюПоДисконтнойКарте = 0 Тогда
				Движение = Движения.БонусыКонтрагентов.Добавить();
				Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
				Движение.Период = Дата;
				Движение.Контрагент = Контрагент;
				Движение.ДисконтнаяКарта = ДисконтнаяКарта;
				Движение.Сумма = СуммаБонусовКНачислениюПоДисконтнойКарте;
				Движение.ДокументНАНБ = ДокументНАНБ;
				Движение.КатегорияКонтрагента = КатегорияКонтрагента;
			КонецЕсли;
		КонецЕсли;
		
		Если НЕ СуммаБонусовКСписаниюПоДисконтнойКарте = 0
			И СписыватьБонусы // №13299
			И ?(СлужебныйУчетБонусовПоДисконтнымКартам, НЕ ДисконтнаяКарта.Пустая(), Истина) // №6316 нужно проверить заполнение дисконтной карты
			Тогда
			
			//#13339 
			Если НЕ РегистрыНакопления.БонусыКонтрагентов.КонтрольОстатков(Ссылка, Контрагент, ДисконтнаяКарта, СуммаБонусовКСписаниюПоДисконтнойКарте) Тогда
				Отказ = Истина;
				Возврат;
			КонецЕсли;
			
			Движение = Движения.БонусыКонтрагентов.Добавить();
			Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
			Движение.Период = Дата;
			Движение.Контрагент = Контрагент;
			Движение.ДисконтнаяКарта = ДисконтнаяКарта;
			Движение.Сумма = СуммаБонусовКСписаниюПоДисконтнойКарте;
		КонецЕсли;
		
	КонецЕсли;
	
	// регистр ДоходыРасходы
	Если ПараметрыСеанса.ФинРезультатИспользоватьВедениеУчетаДоходовРасходов Тогда
		Если ПараметрыСеанса.ФинРезультатНеКассовыйМетодВеденияУчетаДоходовРасходов Тогда
			//некассовый метод
			Метод = Перечисления.МетодыВеденияУчетаДоходовРасходов.Некассовый;
			Движения.ДоходыРасходы.Записывать = Истина;
			Для Каждого ТекущаяСтрока Из Товары Цикл
				Статья = ?(НЕ ТекущаяСтрока.СтатьяДоходов.Пустая(), ТекущаяСтрока.СтатьяДоходов, СтатьяДоходов);
				Если Статья.Пустая() ИЛИ ТекущаяСтрока.Сумма = 0 Тогда
					Продолжить;
				КонецЕсли;
				Движение = Движения.ДоходыРасходы.Добавить();
				Движение.Период 		= Дата;
				Движение.Организация 	= Организация;
				Движение.Подразделение 	= Подразделение;
				Движение.Статья 		= Статья;
				Движение.Метод		 	= Метод;
				Движение.СуммаДоходов 	= РаботаСВалютой.ПолучитьСуммуВВалютеУчетаПоДокументу(Ссылка, ТекущаяСтрока.Сумма);
				Движение.СуммаРасходов 	= 0;				
			КонецЦикла;
			
			Для Каждого ТекущаяСтрока Из Услуги Цикл
				Статья = ?(НЕ ТекущаяСтрока.СтатьяДоходов.Пустая(), ТекущаяСтрока.СтатьяДоходов, СтатьяДоходов);
				Если Статья.Пустая() ИЛИ ТекущаяСтрока.Сумма = 0 Тогда
					Продолжить;
				КонецЕсли;				
				Движение = Движения.ДоходыРасходы.Добавить();
				Движение.Период 		= Дата;
				Движение.Организация 	= Организация;
				Движение.Подразделение 	= Подразделение;
				Движение.Статья 		= Статья;
				Движение.Метод		 	= Метод;
				Движение.СуммаДоходов 	= РаботаСВалютой.ПолучитьСуммуВВалютеУчетаПоДокументу(Ссылка, ТекущаяСтрока.Сумма);
				Движение.СуммаРасходов 	= 0;				
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	//#13710
	ОбщийМодульСервер.ПроверитьИзменениеВзаиморасчетовПриЗаписи(ЭтотОбъект, Отказ);
	
КонецПроцедуры

#КонецОбласти

#Область Заполнение

Процедура ИнициализироватьСлужебныеРеквизиты()
	
	// №6960 настройки по бонусам делаем только если глобально включен учет бонусов
	Если ПолучитьФункциональнуюОпцию("УчетБонусов") Тогда
		
		//#13834 изменена настройка
		//НачислятьБонусы 						= Константы.АвтоматическоеНачислениеБонусов.Получить();
		НачислятьБонусы 						= Константы.АвтоматическиНачислятьБонусы.Получить();
		СписыватьБонусы							= Константы.СписыватьБонусыПоДокументуРеализацияТоваровИУслуг.Получить(); // №13299
		СлужебныйУчитыватьБонусы 				= Константы.УчитыватьБонусы.Получить();
		СлужебныйУчетБонусовПоДисконтнымКартам 	= Константы.УчетБонусовПоДисконтнымКартам.Получить();
		СлужебныйВидБонуснойСистемы 			= Константы.ВидБонуснойСистемы.Получить();
		
		НачислятьБонусыПоДисконтнойКартеПриЗачетеБонусовКакСкидку = Константы.НачислятьБонусыПоДисконтнойКартеПриЗачетеБонусовКакСкидку.Получить();
		
	Иначе
		НачислятьБонусы = Ложь;
		СписыватьБонусы = Ложь;
		СлужебныйУчитыватьБонусы = Ложь;
		СлужебныйУчетБонусовПоДисконтнымКартам = Ложь;
		НачислятьБонусыПоДисконтнойКартеПриЗачетеБонусовКакСкидку = Ложь;
	КонецЕсли;
	
	ДисконтнаяКарта = Справочники.ДисконтныеКарты.ПустаяСсылка();
	СуммаБонусовКНачислениюПоДисконтнойКарте = 0;
	СуммаБонусовКСписанию					 = 0;
	СуммаБонусовКСписаниюПоДисконтнойКарте	 = 0;
	
	//#14828
	СозданПриИспользованииПодразделений  = Константы.ИспользоватьПодразделения.Получить();
	
КонецПроцедуры

Процедура ДозаполнитьПоУмолчанию()
	
	//#13943
	Если Константы.СпособЗаполненияМенеджераВРеализации.Получить() = Перечисления.ВариантыЗаполненияМенеджера.ЗаполнятьСотрудникомПользователя 
		И ЗначениеЗаполнено(Автор) Тогда
		Менеджер = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Автор, "Сотрудник");
		
	ИначеЕсли Константы.СпособЗаполненияМенеджераВРеализации.Получить() = Перечисления.ВариантыЗаполненияМенеджера.ЗаполнятьМенеджеромДокументаОснования
		И ЗначениеЗаполнено(Основание)
		И ТипЗнч(Основание) = Тип("ДокументСсылка.ЗаказПокупателя") Тогда
		Менеджер = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Основание, "Менеджер");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Контрагент) Тогда
		КатегорияКонтрагента = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Контрагент, "Категория");
		
		//#13359
		Если СлужебныйВидБонуснойСистемы = Перечисления.ВидыБонусныхСистем.UDS Тогда
			UDS_ОбщийМодульСервер.ЗаполнитьРеквизитыДокумента(ЭтотОбъект);	
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьДанныеПоЗаказамВПродажах(Движение, ТекущаяСтрока)
	
	// заказ на производство
	// #13068 измерение более не используется
	//Если ЗначениеЗаполнено(ТекущаяСтрока.Потолок) Тогда
	//	Движение.ЗаказНаПроизводство = ОбщийМодуль.НайтиЗаказНаПроизводствоПоПотолку(ТекущаяСтрока.Потолок);
	//КонецЕсли;	
	
	// заказ покупателя
	Если ТипЗнч(ТекущаяСтрока.Заказ) = Тип("ДокументСсылка.ЗаказПокупателя") И НЕ ТекущаяСтрока.Заказ.Пустая() Тогда
		Движение.ЗаказПокупателя = ТекущаяСтрока.Заказ;
	ИначеЕсли ТипЗнч(Основание) = Тип("ДокументСсылка.ЗаказПокупателя") И НЕ Основание.Пустая() Тогда
		Движение.ЗаказПокупателя = Основание;
	КонецЕсли;
	
	// подразделение заказа, адрес монтажа
	//заказ на производство приоритетнее
	//Если ЗначениеЗаполнено(Движение.ЗаказНаПроизводство) Тогда
	//	//Движение.АдресМонтажа = Движение.ЗаказНаПроизводство.АдресМонтажа;
	//	Движение.ПодразделениеЗаказа = Движение.ЗаказНаПроизводство.Подразделение;
	//Иначе
	Если ЗначениеЗаполнено(Движение.ЗаказПокупателя) Тогда
		//Движение.АдресМонтажа = Движение.ЗаказПокупателя.АдресМонтажа;
		Движение.ПодразделениеЗаказа = Движение.ЗаказПокупателя.Подразделение;		
	КонецЕсли;
КонецПроцедуры

Процедура ЗаполнитьПоЗаказуПокупателя(ДанныеЗаполнения)
	
	МассивДокументов = Новый Массив;
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ЗаказПокупателя") Тогда
		МассивДокументов.Добавить(ДанныеЗаполнения);		
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("Массив") Тогда
		МассивДокументов 	= ДанныеЗаполнения;
	Иначе
		Возврат;
	КонецЕсли;
	
	Документы.ЗаказПокупателя.ПроверитьВозможностьВводаНаОснованииЗаказа(МассивДокументов, , "Реализация");
	
	Основание 			= МассивДокументов[0];
	Организация 		= МассивДокументов[0].Организация;
	Подразделение 		= МассивДокументов[0].Подразделение; //#5775
	Контрагент 			= МассивДокументов[0].Контрагент;
	ДоговорКонтрагента 	= МассивДокументов[0].ДоговорКонтрагента;
	ВидЦен 				= МассивДокументов[0].ВидЦен;
	Склад 				= МассивДокументов[0].Склад;
	Валюта 				= МассивДокументов[0].Валюта;
	АдресМонтажа 		= МассивДокументов[0].АдресМонтажа;
	Менеджер 			= МассивДокументов[0].Менеджер;
	ДисконтнаяКарта		= МассивДокументов[0].ДисконтнаяКарта; // №13705
	НомерРозничногоДоговора	= МассивДокументов[0].НомерРозничногоДоговора; //#7381
	
	СпособДоставки      = МассивДокументов[0].СпособДоставки;
	ГородДоставки       = МассивДокументов[0].ГородДоставки;
	АдресДоставки       = МассивДокументов[0].АдресДоставки;
	АдресДоставкиЗначенияПолей = МассивДокументов[0].АдресДоставкиЗначенияПолей;
	
	//++ №15928
	Если Константы.ПереноситьКомментарийИзЗаказаПокупателяПриСозданииРеализации.Получить() Тогда
		Комментарий 	= МассивДокументов[0].Комментарий;
	КонецЕсли;
	//-- №15928
	
	БонусыУчтеныПоЗаказу = Ложь; // №13299
	
	Для каждого ЭлементМассива из МассивДокументов Цикл
		
		Если Контрагент <> ЭлементМассива.Контрагент Тогда
			Текст = НСтр("ru = 'Контрагенты в выделенных документах различаются, создание реализации невозможно'");			
			ВызватьИсключение Текст;
		КонецЕсли;
		
		//#15370
		Если Организация <> ЭлементМассива.Организация Тогда
			Текст = НСтр("ru = 'Организации в выделенных документах различаются, создание реализации невозможно'");			
			ВызватьИсключение Текст;
		КонецЕсли;
		
		//++ №13299
		Если ЭлементМассива.СписыватьБонусы Тогда
			БонусыУчтеныПоЗаказу = Истина;
		КонецЕсли;
		//-- №13299
	
		Для Каждого ТекущаяСтрокаТоварыОснования Из ЭлементМассива.Товары Цикл
			
			Если ТекущаяСтрокаТоварыОснования.Номенклатура.ВидНоменклатуры = Справочники.ВидыНоменклатуры.Услуга Тогда
				НоваяСтрока = Услуги.Добавить();
			Иначе
				НоваяСтрока = Товары.Добавить();
			КонецЕсли;
			
			ЗаполнитьЗначенияСвойств(НоваяСтрока,ТекущаяСтрокаТоварыОснования);
			//НоваяСтрока.СтавкаНДС = УчетНДС.СтавкаНДСПоУмолчанию(Организация);
			//НоваяСтрока.СуммаНДС = УчетНДС.РассчитатьСуммуНДС(НоваяСтрока.Сумма, УчетНДС.ОрганизацияЯвляетсяПлательщикомНДС(Организация), , УчетНДС.ПолучитьСтавкуНДС(НоваяСтрока.СтавкаНДС));
			//НоваяСтрока.Потолок = ?(Справочники.ВидыНоменклатуры.ЭтоНоменклатураПотолкаИлиОтреза(ТекущаяСтрокаТоварыОснования.Номенклатура), ТекущаяСтрокаТоварыОснования.Номенклатура, Неопределено);
			
			Если Справочники.ВидыНоменклатуры.ЭтоНоменклатураПотолкаИлиОтреза(НоваяСтрока.Номенклатура) Тогда 
				НоваяСтрока.Потолок = НоваяСтрока.Номенклатура; 
			КонецЕсли;
			
			//НоваяСтрока.Заказ = ТекущаяСтрокаТоварыОснования.ЗаказНаПроизводство;
			//2.0
			НоваяСтрока.Заказ = ЭлементМассива;
			
		КонецЦикла;
		
	КонецЦикла;
	
	//++ №13299 если хотя бы по одному заказу установлен флаг "Списывать бонусы" - в реализации запрещаем списывать
	Если БонусыУчтеныПоЗаказу Тогда
		СписыватьБонусы = Ложь;
	КонецЕсли;
	//-- №13299
	
	//в таблицу оснований добавляем все основания кроме первого, так как он указан в шапке
	Для Инд = 1 по МассивДокументов.Количество() - 1 Цикл
		НоваяСтрока = Основания.Добавить();
		НоваяСтрока.Основание = МассивДокументов[Инд];
	КонецЦикла;	
	
	//а теперь проверим все что было отгружено по этому заказу и "вычтем" из товаров\услуг текущей реализации
	ТаблицаТоваровРеализации = Товары.Выгрузить();
	ТаблицаТоваровРеализации.Колонки.Добавить("СуммаВПересчетеНаЕдиницу", Новый ОписаниеТипов("число"));
	ТаблицаТоваровРеализации.Колонки.Добавить("СуммаСкидкиВПересчетеНаЕдиницу", Новый ОписаниеТипов("число"));
	ТаблицаТоваровРеализации.Колонки.Добавить("СуммаБонусовВПересчетеНаЕдиницу", Новый ОписаниеТипов("число")); // №13299
	
	Для Каждого ТекущаяСтрока Из ТаблицаТоваровРеализации Цикл
		Если НЕ ТекущаяСтрока.Количество = 0 Тогда
			ТекущаяСтрока.СуммаВПересчетеНаЕдиницу = ТекущаяСтрока.Сумма / ТекущаяСтрока.Количество;
			ТекущаяСтрока.СуммаСкидкиВПересчетеНаЕдиницу = ТекущаяСтрока.СуммаРучнойСкидки / ТекущаяСтрока.Количество;
			ТекущаяСтрока.СуммаБонусовВПересчетеНаЕдиницу = ТекущаяСтрока.СкидкаБонусами / ТекущаяСтрока.Количество; // №13299
		КонецЕсли;
	КонецЦикла;
	
	ТаблицаУслугРеализации = Услуги.Выгрузить();
	ТаблицаУслугРеализации.Колонки.Добавить("СуммаВПересчетеНаЕдиницу", Новый ОписаниеТипов("число"));
	ТаблицаУслугРеализации.Колонки.Добавить("СуммаСкидкиВПересчетеНаЕдиницу", Новый ОписаниеТипов("число"));
	ТаблицаУслугРеализации.Колонки.Добавить("СуммаБонусовВПересчетеНаЕдиницу", Новый ОписаниеТипов("число")); // №13299
	Для Каждого ТекущаяСтрока Из ТаблицаУслугРеализации Цикл
		Если НЕ ТекущаяСтрока.Количество = 0 Тогда
			ТекущаяСтрока.СуммаВПересчетеНаЕдиницу = ТекущаяСтрока.Сумма / ТекущаяСтрока.Количество;
			ТекущаяСтрока.СуммаСкидкиВПересчетеНаЕдиницу = ТекущаяСтрока.СуммаРучнойСкидки / ТекущаяСтрока.Количество;
			ТекущаяСтрока.СуммаБонусовВПересчетеНаЕдиницу = ТекущаяСтрока.СкидкаБонусами / ТекущаяСтрока.Количество; // №13299
		КонецЕсли;
	КонецЦикла;
	
	ЗапросОтгружено = Новый Запрос;
	ЗапросОтгружено.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЗаказыПокупателейОбороты.ЗаказНаПроизводство КАК Заказ,
	|	ЗаказыПокупателейОбороты.Номенклатура КАК Номенклатура,
	//++ #14419 если есть возврат, то есть строка КоличествоРасход с минусом
	//|	ЗаказыПокупателейОбороты.КоличествоРасход КАК КоличествоРасход
	|	СУММА(ЗаказыПокупателейОбороты.КоличествоРасход) КАК КоличествоРасход
	//-- #14419
	|ИЗ
	|	РегистрНакопления.ЗаказыПокупателей.Обороты(, , Регистратор, ЗаказНаПроизводство В (&Заказы)) КАК ЗаказыПокупателейОбороты
	|ГДЕ
	|	ВЫБОР
	|			КОГДА &ОтборПоДокументу
	|				ТОГДА НЕ ЗаказыПокупателейОбороты.Регистратор = &Ссылка
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|
	//++ #14419
	|СГРУППИРОВАТЬ ПО
	|	ЗаказыПокупателейОбороты.ЗаказНаПроизводство,
	|	ЗаказыПокупателейОбороты.Номенклатура
	//-- #14419
	|";

	ЗапросОтгружено.УстановитьПараметр("Заказы", МассивДокументов);
	ЗапросОтгружено.УстановитьПараметр("ОтборПоДокументу", НЕ Ссылка.Пустая());
	ЗапросОтгружено.УстановитьПараметр("Ссылка", Ссылка); // отбор нужен для работы кнопки заполнить по заказу покупателя на форме документа
	ТаблицаОтгружено = ЗапросОтгружено.Выполнить().Выгрузить();
	
	Для Каждого СтрокаОтгружено Из ТаблицаОтгружено Цикл
		Вычесть = СтрокаОтгружено.КоличествоРасход;
		
		Для Каждого СтрокаТовар Из ТаблицаТоваровРеализации Цикл
			Если Вычесть > 0 И СтрокаТовар.Номенклатура = СтрокаОтгружено.Номенклатура И СтрокаТовар.Заказ = СтрокаОтгружено.Заказ Тогда
				Зачтем = Мин(СтрокаТовар.Количество,Вычесть);
				СтрокаТовар.Количество = СтрокаТовар.Количество - Зачтем;
				Вычесть = Вычесть - Зачтем;
				СтрокаТовар.Сумма = СтрокаТовар.СуммаВПересчетеНаЕдиницу * СтрокаТовар.Количество;
				СтрокаТовар.СуммаРучнойСкидки = СтрокаТовар.СуммаСкидкиВПересчетеНаЕдиницу * СтрокаТовар.Количество;
				СтрокаТовар.СкидкаБонусами = СтрокаТовар.СуммаБонусовВПересчетеНаЕдиницу * СтрокаТовар.Количество; // №13299
			КонецЕсли;
		КонецЦикла;
		Для Каждого СтрокаТовар Из ТаблицаУслугРеализации Цикл
			Если Вычесть > 0 И СтрокаТовар.Номенклатура = СтрокаОтгружено.Номенклатура И СтрокаТовар.Заказ = СтрокаОтгружено.Заказ Тогда
				Зачтем = Мин(СтрокаТовар.Количество,Вычесть);
				СтрокаТовар.Количество = СтрокаТовар.Количество - Зачтем;
				Вычесть = Вычесть - Зачтем;
				СтрокаТовар.Сумма = СтрокаТовар.СуммаВПересчетеНаЕдиницу * СтрокаТовар.Количество;
				СтрокаТовар.СуммаРучнойСкидки = СтрокаТовар.СуммаСкидкиВПересчетеНаЕдиницу * СтрокаТовар.Количество;
				СтрокаТовар.СкидкаБонусами = СтрокаТовар.СуммаБонусовВПересчетеНаЕдиницу * СтрокаТовар.Количество; // №13299
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	УчитыватьНДС = УчетНДС.ОрганизацияЯвляетсяПлательщикомНДС(Организация);
	
	Товары.Очистить();
	Для Каждого СтрокаТовар Из ТаблицаТоваровРеализации Цикл
		Если СтрокаТовар.Количество > 0 Тогда
			НоваяСтрока = Товары.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТовар);
			//НоваяСтрока.СуммаНДС = УчетНДС.РассчитатьСуммуНДС(НоваяСтрока.Сумма, УчетНДС.ОрганизацияЯвляетсяПлательщикомНДС(Организация), , УчетНДС.ПолучитьСтавкуНДС(НоваяСтрока.СтавкаНДС));
			ОбработкаТабличныхЧастейСервер.ПересчитатьСуммуНДСВСтрокеТЧ(НоваяСтрока, УчитыватьНДС);
		КонецЕсли;
	КонецЦикла;
	
	Услуги.Очистить();
	Для Каждого СтрокаУслуги Из ТаблицаУслугРеализации Цикл
		Если СтрокаУслуги.Количество > 0 Тогда
			НоваяСтрока = Услуги.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаУслуги);
			//НоваяСтрока.СуммаНДС = УчетНДС.РассчитатьСуммуНДС(НоваяСтрока.Сумма, УчетНДС.ОрганизацияЯвляетсяПлательщикомНДС(Организация), , УчетНДС.ПолучитьСтавкуНДС(НоваяСтрока.СтавкаНДС));
			ОбработкаТабличныхЧастейСервер.ПересчитатьСуммуНДСВСтрокеТЧ(НоваяСтрока, УчитыватьНДС);
		КонецЕсли;
	КонецЦикла;
	
	//++ №8373 признак создания ПТиУ
	//#11380 - смотрим не на ДанныеЗаполнения, а на Основание, так как не срабатывает при групповой отгрузке 
	//Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ЗаказПокупателя") И ЗначениеЗаполнено(ДанныеЗаполнения) Тогда
		
		УстановитьПривилегированныйРежим(Истина);		
		РегламентноеЗаданиеПоИнтеркампани = РегламентныеЗадания.НайтиПредопределенное(Метаданные.РегламентныеЗадания.СозданиеПоступленийТоваровОтПроизводства);
		Если Основание.ЭтоЗаказОтРозницы 
			И (Константы.РучнойЗапускОбработкиСозданияДокументовПоступленийПотолковВРозницеОтПроизводства.Получить() ИЛИ РегламентноеЗаданиеПоИнтеркампани.Использование) Тогда
			
			АвтоматическиСоздатьДокументПоступленияОтПроизводстваНаРозницуПоИнтеркампани = Истина;
			НастройкаИнтеркампани = Основание.НастройкаИнтеркампани; //++ №7764
			
		ИначеЕсли ПолучитьФункциональнуюОпцию("СоздаватьДокументыПоступленийПоРучнымЗаказам") 
			//++ №7764 
			//И РегистрыСведений.СвязкиОрганизацийПроизводстваКонтрагентРозницы.ОтгрузкаПоСвязкеОрганизацииПроизводстваКонтрагентаРозницы(Организация, Контрагент, УДАЛИТЬ_ОрганизацияПоступления, УДАЛИТЬ_КонтрагентПоступления, УДАЛИТЬ_СкладПоступления)
			И РегистрыСведений.СвязкиОрганизацийПроизводстваКонтрагентРозницы.ОтгрузкаПоСвязкеОрганизацииПроизводстваКонтрагентаРозницы(Организация, Контрагент) Тогда
			//-- №7764						
		
			АвтоматическиСоздатьДокументПоступленияОтПроизводстваНаРозницуСозданныхВручную = Истина;			
			
		КонецЕсли;
		УстановитьПривилегированныйРежим(Ложь);
		
	//КонецЕсли;
	//-- №8373
	
	//nva+++
	НоваяСтрока = ИсторияВыдачи.Добавить();
	НоваяСтрока.Дата = ТекущаяДатаСеанса();
	НоваяСтрока.Пользователь = Пользователи.ТекущийПользователь(); 
	
	СтатусОтгрузки = Справочники.СтатусыОтгрузки.ВыполнитьСборку; 
	
	НоваяСтрока.Статус = СтатусОтгрузки;
	//nva---
	
КонецПроцедуры

Процедура ДополнитьТаблицуВыработки(ТаблицаПоВыработке)
	
	ТаблицаПоВыработке.Колонки.Добавить("Период");
	ТаблицаПоВыработке.Колонки.Добавить("Регистратор");
	ТаблицаПоВыработке.Колонки.Добавить("ОбъектВыработки");
	ТаблицаПоВыработке.Колонки.Добавить("Подразделение");
	ТаблицаПоВыработке.Колонки.Добавить("ЭтоРозница");
	
	ТаблицаПоВыработке.ЗаполнитьЗначения(?(Дата = Дата(1,1,1), ТекущаяДатаСеанса(), Дата), "Период");
	ТаблицаПоВыработке.ЗаполнитьЗначения(Ссылка, "Регистратор");
	ТаблицаПоВыработке.ЗаполнитьЗначения(Ссылка, "ОбъектВыработки");
	ТаблицаПоВыработке.ЗаполнитьЗначения(Подразделение, "Подразделение");
	ТаблицаПоВыработке.ЗаполнитьЗначения(ТипЗнч(Основание) = Тип("ДокументСсылка.ЗаказДоговор"), "ЭтоРозница");
	
КонецПроцедуры

