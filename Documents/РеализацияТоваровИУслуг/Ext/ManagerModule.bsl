Функция СформироватьПечатнуюФормуТоварнойНакладной(МассивОбъектов, ОбъектыПечати, ВключатьУслуги=Истина) Экспорт
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.АвтоМасштаб         = Истина; //#14053
	ТабличныйДокумент.ИмяПараметровПечати = "ПараметрыПечати_ТоварнаяНакладная";
	ВыводитьАртикул = Константы.ВыводитьАртикулНоменклатурыВПечатныхФормах.Получить();
	
	СтруктураДанныхДляПечати = ПолучитьДанныеДляПечатныхФорм(МассивОбъектов, Истина, ВключатьУслуги);
	ТаблицаДанныеПечати = СтруктураДанныхДляПечати.РезультатПоШапке.Выгрузить();	
	ВыборкаПоТоварам = СтруктураДанныхДляПечати.РезультатПоТабличнойЧасти.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	ДополнитьДанныеДляПечатныхФорм(ТаблицаДанныеПечати, ВыборкаПоТоварам);
    
    ПервыйДокумент = Истина;
	Для Каждого ДанныеПечати Из ТаблицаДанныеПечати Цикл
		Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.РеализацияТоваровИУслуг.ПФ_MXL_ТоварнаяНакладная");
        Если Не ПервыйДокумент Тогда
            ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
        КонецЕсли;
        ПервыйДокумент = Ложь;
        // Запомним номер строки, с которой начали выводить текущий документ.
		НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы + 1;
		
		Попытка
			ОбластьМакета = Макет.ПолучитьОбласть("Заголовок");
			ОбластьМакета.Параметры.Заполнить(ДанныеПечати);
			
			ШтрихкодированиеПечатныхФорм.ВывестиШтрихкодВТабличныйДокумент(
				ТабличныйДокумент,
				Макет,
				ОбластьМакета,
				ДанныеПечати.Ссылка);
				
			ТабличныйДокумент.Вывести(ОбластьМакета);
		Исключение
		КонецПопытки;
		
		Попытка
			ОбластьМакета = Макет.ПолучитьОбласть("Организация");
			ОбластьМакета.Параметры.Заполнить(ДанныеПечати);
			ТабличныйДокумент.Вывести(ОбластьМакета);
		Исключение
		КонецПопытки;
		
		Попытка
			ОбластьМакета = Макет.ПолучитьОбласть("Получатель");
			ОбластьМакета.Параметры.Заполнить(ДанныеПечати);
			ТабличныйДокумент.Вывести(ОбластьМакета);
		Исключение
		КонецПопытки;
		
		//добавим адрес доставки, если поле не пустое		
		Попытка
			Если НЕ ПустаяСтрока(ДанныеПечати.АдресДоставки) Тогда
				ОбластьМакета = Макет.ПолучитьОбласть("АдресДоставки");
				ОбластьМакета.Параметры.Заполнить(ДанныеПечати);
				ТабличныйДокумент.Вывести(ОбластьМакета);
			КонецЕсли;
		Исключение
		КонецПопытки;
		
		//добавим адрес монтажа, если поле не пустое		
		Попытка
			Если НЕ ПустаяСтрока(ДанныеПечати.АдресМонтажа) Тогда
				ОбластьМакета = Макет.ПолучитьОбласть("АдресМонтажа");
				ОбластьМакета.Параметры.Заполнить(ДанныеПечати);
				ТабличныйДокумент.Вывести(ОбластьМакета);
			КонецЕсли;
		Исключение
		КонецПопытки;
		
		Попытка
			ОбластьМакета = Макет.ПолучитьОбласть("Склад");
			ОбластьМакета.Параметры.Заполнить(ДанныеПечати);
			ТабличныйДокумент.Вывести(ОбластьМакета);		
		Исключение
		КонецПопытки;
		
		Попытка
			Если ЗначениеЗаполнено(ДанныеПечати.Основание) Тогда
				ОбластьМакета = Макет.ПолучитьОбласть("Основание");
				ОбластьМакета.Параметры.Заполнить(ДанныеПечати);
				ТабличныйДокумент.Вывести(ОбластьМакета);
			КонецЕсли;
		Исключение
		КонецПопытки;
		
		// Изменения размера колонки, в зависимости от вывода Артикула
		Если Не ВыводитьАртикул Тогда
			Попытка
				Макет.Область("ПерваяКолонкаТовара").ШиринаКолонки = Макет.Область("ПерваяКолонкаТовара").ШиринаКолонки + Макет.Область("Артикул").ШиринаКолонки;
			Исключение
			КонецПопытки;
		КонецЕсли;
		
		Попытка
			ОбластьМакета = Макет.ПолучитьОбласть("ШапкаТаблицы|НомерСтроки");
			ОбластьМакета.Параметры.Заполнить(ДанныеПечати);
			ТабличныйДокумент.Вывести(ОбластьМакета);
			
			Если ВыводитьАртикул Тогда
				ОбластьМакета = Макет.ПолучитьОбласть("ШапкаТаблицы|Артикул");
				ОбластьМакета.Параметры.Заполнить(ДанныеПечати);
				ТабличныйДокумент.Присоединить(ОбластьМакета);
			КонецЕсли;
			
			ОбластьМакета = Макет.ПолучитьОбласть("ШапкаТаблицы|Данные");
			ОбластьМакета.Параметры.Заполнить(ДанныеПечати);
			ТабличныйДокумент.Присоединить(ОбластьМакета);			
		Исключение
		КонецПопытки;
		
		//Сумма = 0;
		//Количество = 0;
		
		НомерСтроки = 1;
		СтруктураПоиска = Новый Структура("Ссылка", ДанныеПечати.Ссылка);
		ВыборкаПоТоварам.Сбросить();
		
		Если НЕ ВключатьУслуги Тогда
			Если ВыборкаПоТоварам.НайтиСледующий(СтруктураПоиска) Тогда				
				Выборка = ВыборкаПоТоварам.Выбрать();
				Пока Выборка.Следующий() Цикл
					Попытка
						ОбластьМакета = Макет.ПолучитьОбласть("Строка|НомерСтроки");
						ОбластьМакета.Параметры.Заполнить(ДанныеПечати);
						ОбластьМакета.Параметры.Заполнить(Выборка);
						ТабличныйДокумент.Вывести(ОбластьМакета);
						
						Если ВыводитьАртикул Тогда
							ОбластьМакета = Макет.ПолучитьОбласть("Строка|Артикул");
							ОбластьМакета.Параметры.Заполнить(ДанныеПечати);
							ОбластьМакета.Параметры.Заполнить(Выборка);
							ТабличныйДокумент.Присоединить(ОбластьМакета);
						КонецЕсли;
						
						ОбластьМакета = Макет.ПолучитьОбласть("Строка|Данные");
						ОбластьМакета.Параметры.Заполнить(ДанныеПечати);
						ОбластьМакета.Параметры.Заполнить(Выборка);
						
						//++ №12909
						//ПредставлениеНоменклатуры = Строка(Выборка.Номенклатура) + Строка(УправлениеПечатью.ПредставлениеХарактеристики(Выборка.ХарактеристикаНоменклатуры));
						ПредставлениеНоменклатуры = ОбщийМодульСервер.ПредставлениеНоменклатурыДляПечати(Выборка.Номенклатура, Выборка.ХарактеристикаНоменклатуры);
						//-- №12909
						
						ОбластьМакета.Параметры.ПредставлениеНоменклатуры = ПредставлениеНоменклатуры;
						ТабличныйДокумент.Присоединить(ОбластьМакета);

					Исключение
					КонецПопытки;		
				КонецЦикла;
			КонецЕсли;
		Иначе
			// подготовим табличную часть в зависимости от варианта формирования ПФ счета на оплату
			ВариантФормированияПФ = Константы.ВариантФормированияПФРТИУ.Получить();
		
			МассивДопРеквизитов = Новый Массив;
			МассивДопРеквизитов.Добавить(Новый Структура("Имя, Тип", "Артикул", 			Новый ОписаниеТипов("Строка")));
			МассивДопРеквизитов.Добавить(Новый Структура("Имя, Тип", "Вес", 				Новый ОписаниеТипов("Число")));
		
			МассивДопРеквизитов.Добавить(Новый Структура("Имя, Тип", "ВидНоменклатуры", 	Новый ОписаниеТипов("Число")));
			МассивДопРеквизитов.Добавить(Новый Структура("Имя, Тип", "ЕстьПотолок", 		Новый ОписаниеТипов("Число")));
			МассивДопРеквизитов.Добавить(Новый Структура("Имя, Тип", "ЭтоПотолок", 			Новый ОписаниеТипов("Булево")));
			МассивДопРеквизитов.Добавить(Новый Структура("Имя, Тип", "НомерСтрокиПотолка", 	Новый ОписаниеТипов("Число")));
			МассивДопРеквизитов.Добавить(Новый Структура("Имя, Тип", "ГруппаНоменклатуры", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"))); //#12807

			ТаблицаТоварыИУслуги = ОбщийМодульСервер.ТаблицаЗначенийПоТабличнойЧастиОбъекта("РеализацияТоваровИУслуг", "Товары", МассивДопРеквизитов);
			
			Если ВыборкаПоТоварам.НайтиСледующий(СтруктураПоиска) Тогда			
				Выборка = ВыборкаПоТоварам.Выбрать();			
				Пока Выборка.Следующий() Цикл
					ТекущаяСтрока = ТаблицаТоварыИУслуги.Добавить();
					ЗаполнитьЗначенияСвойств(ТекущаяСтрока, Выборка);
					
					Если Справочники.ВидыНоменклатуры.ЭтоНоменклатураПотолкаИлиОтреза(ТекущаяСтрока.Номенклатура) Тогда
						ТекущаяСтрока.ВидНоменклатуры = 1;
						ТекущаяСтрока.Потолок = ТекущаяСтрока.Номенклатура;
						ТекущаяСтрока.НомерСтрокиПотолка = ТекущаяСтрока.НомерСтроки;
						ТекущаяСтрока.ЭтоПотолок = Истина;
						
					ИначеЕсли Справочники.ВидыНоменклатуры.ЭтоНоменклатураУслуга(ТекущаяСтрока.Номенклатура) Тогда
						ТекущаяСтрока.ВидНоменклатуры = 3;
					Иначе
						ТекущаяСтрока.ВидНоменклатуры = 2;
					КонецЕсли;
					Если ТекущаяСтрока.Потолок.Пустая() Тогда
						ТекущаяСтрока.ЕстьПотолок = 2;
					Иначе
						ТекущаяСтрока.ЕстьПотолок = 1;
					КонецЕсли;
					
					ТекущаяСтрока.ГруппаНоменклатуры = ТекущаяСтрока.Номенклатура.Родитель; //#12807
				КонецЦикла;
			КонецЕсли;			
			
			ОтступНоменклатуры = "";
			
			//0. Потолок - товар - услуга - потолок - товар - услуга
			//1. Потолок, Потолок, Товары, Товары, услуги, услуги
			//2. Потолок - потолок - товар (все одинаковые позиции сворачиваются) - услуга (все одинаковые позиции сворачиваются)
			//3. Без группировок
			//4. По группам номенклатуры
			//5. По группам номенклатуры (одинаковые позиции объединяются)
			Если ВариантФормированияПФ = 0 Тогда
				ТаблицаТоварыИУслуги.Сортировать("ЕстьПотолок, Потолок, ВидНоменклатуры");		
			ИначеЕсли ВариантФормированияПФ = 1 Тогда
				ТаблицаТоварыИУслуги.Сортировать("ВидНоменклатуры");
			ИначеЕсли ВариантФормированияПФ = 2 Тогда
				ТаблицаТоварыИУслуги.Свернуть("Артикул, Номенклатура, ХарактеристикаНоменклатуры, ЕдиницаИзмерения, Коэффициент, Цена, ПроцентРучнойСкидки, ВидНоменклатуры", "Количество, Сумма, СуммаРучнойСкидки");
				ТаблицаТоварыИУслуги.Сортировать("ВидНоменклатуры")
			ИначеЕсли ВариантФормированияПФ = 3 Тогда	
				//не сортируем
			ИначеЕсли ВариантФормированияПФ = 4 Тогда
				ОтступНоменклатуры = "   ";
				ТаблицаТоварыИУслуги.Сортировать("ГруппаНоменклатуры");
			//++ №13374
			ИначеЕсли ВариантФормированияПФ = 5 Тогда
				ТаблицаТоварыИУслуги.Свернуть("Артикул, Номенклатура, ХарактеристикаНоменклатуры, ЕдиницаИзмерения, Коэффициент, Цена, ПроцентРучнойСкидки, ГруппаНоменклатуры", "Количество, Сумма, СуммаРучнойСкидки");
				ОтступНоменклатуры = "   ";
				ТаблицаТоварыИУслуги.Сортировать("ГруппаНоменклатуры");
			//-- №13374
			КонецЕсли;
			
			НомерСтроки = 1;
			ТекущаяГруппа = Неопределено;
		
			Для каждого Выборка из ТаблицаТоварыИУслуги Цикл 
				
				//#12807
				Если ВариантФормированияПФ = 4
					Или ВариантФормированияПФ = 5 // №13374
				Тогда
					Если НЕ ТекущаяГруппа = Выборка.ГруппаНоменклатуры Тогда
						ТекущаяГруппа = Выборка.ГруппаНоменклатуры;
						ОбластьМакета = Макет.ПолучитьОбласть("Строка|НомерСтроки");
						ТабличныйДокумент.Вывести(ОбластьМакета);
						Если ВыводитьАртикул Тогда						
							ОбластьМакета = Макет.ПолучитьОбласть("Строка|Артикул");
							ТабличныйДокумент.Присоединить(ОбластьМакета);
						КонецЕсли;					
						ОбластьМакета = Макет.ПолучитьОбласть("Строка|Данные");
						ОбластьМакета.Параметры.ПредставлениеНоменклатуры = ?(ТекущаяГруппа.Пустая(), "<...>", ТекущаяГруппа);
						
						ОбластьМакета.ТекущаяОбласть = ОбластьМакета.Область(1,1,1,1);
						ШрифтПотолка = Новый Шрифт(ОбластьМакета.ТекущаяОбласть.Шрифт,,,Истина);
						ОбластьМакета.ТекущаяОбласть.Шрифт = ШрифтПотолка;
						
						ТабличныйДокумент.Присоединить(ОбластьМакета);
					КонецЕсли;
				КонецЕсли;
				
				ДопДанныеСтроки = Новый Структура("НомерСтроки", НомерСтроки);
				
				Попытка
					ОбластьМакета = Макет.ПолучитьОбласть("Строка|НомерСтроки");
					ОбластьМакета.Параметры.Заполнить(ДанныеПечати);
					ОбластьМакета.Параметры.Заполнить(Выборка);
					ОбластьМакета.Параметры.Заполнить(ДопДанныеСтроки);
					ТабличныйДокумент.Вывести(ОбластьМакета);
					
					Если ВыводитьАртикул Тогда
						ОбластьМакета = Макет.ПолучитьОбласть("Строка|Артикул");
						ОбластьМакета.Параметры.Заполнить(ДанныеПечати);
						ОбластьМакета.Параметры.Заполнить(Выборка);
						ТабличныйДокумент.Присоединить(ОбластьМакета);
					КонецЕсли;	
					
					ОбластьМакета = Макет.ПолучитьОбласть("Строка|Данные");
					ОбластьМакета.Параметры.Заполнить(ДанныеПечати);
					ОбластьМакета.Параметры.Заполнить(Выборка);
					СтолбецНоменклатуры = 1; // номер столбца в текущей области
					Если ВариантФормированияПФ = 0 И Выборка.ВидНоменклатуры = 1 Тогда
						ОбластьМакета.ТекущаяОбласть = ОбластьМакета.Область(1, СтолбецНоменклатуры, 1, СтолбецНоменклатуры);
						ШрифтПотолка = Новый Шрифт (ОбластьМакета.ТекущаяОбласть.Шрифт,,,Истина);
						ОбластьМакета.ТекущаяОбласть.Шрифт = ШрифтПотолка;
					ИначеЕсли ВариантФормированияПФ = 0 и НЕ Выборка.Потолок.Пустая() Тогда
						ОбластьМакета.ТекущаяОбласть = ОбластьМакета.Область(1, СтолбецНоменклатуры, 1, СтолбецНоменклатуры);
						ОбластьМакета.ТекущаяОбласть.Отступ = 2;
					КонецЕсли;
					
					//++ №12909
					//Попытка
					//	ПредставлениеНоменклатуры = Строка(Выборка.Номенклатура) + Строка(УправлениеПечатью.ПредставлениеХарактеристики(Выборка.ХарактеристикаНоменклатуры));
					//Исключение
					//	ПредставлениеНоменклатуры = Строка(Выборка.Номенклатура);
					//КонецПопытки;
					ПредставлениеНоменклатуры = ОтступНоменклатуры + ОбщийМодульСервер.ПредставлениеНоменклатурыДляПечати(Выборка.Номенклатура, Выборка.ХарактеристикаНоменклатуры);
					//-- №12909
					
					ОбластьМакета.Параметры.ПредставлениеНоменклатуры = ПредставлениеНоменклатуры;
					ТабличныйДокумент.Присоединить(ОбластьМакета);					
					
				Исключение			
				КонецПопытки;
				
				НомерСтроки = НомерСтроки + 1;
				
			КонецЦикла;
		КонецЕсли; //Если НЕ ВключатьУслуги Тогда
		
		ПрефиксОбласти = ?(ДанныеПечати.ОрганизацияЯвляетсяПлательщикомНДС, "ИтогоНДС", "Итого");
		Попытка
			ОбластьМакета = Макет.ПолучитьОбласть(ПрефиксОбласти + "|НомерСтроки");
			ОбластьМакета.Параметры.Заполнить(ДанныеПечати);
			ТабличныйДокумент.Вывести(ОбластьМакета);
			
			Если ВыводитьАртикул Тогда
				ОбластьМакета = Макет.ПолучитьОбласть(ПрефиксОбласти + "|Артикул");
				ОбластьМакета.Параметры.Заполнить(ДанныеПечати);
				ТабличныйДокумент.Присоединить(ОбластьМакета);
			КонецЕсли;
			
			ОбластьМакета = Макет.ПолучитьОбласть(ПрефиксОбласти + "|Данные");
			ОбластьМакета.Параметры.Заполнить(ДанныеПечати);
			ТабличныйДокумент.Присоединить(ОбластьМакета);
		Исключение
		КонецПопытки;
		
		Попытка 
			ОбластьМакета = Макет.ПолучитьОбласть("СтрокаВсегоИПрописью");
			ОбластьМакета.Параметры.Заполнить(ДанныеПечати);
			Попытка
				ОбластьМакета.Параметры.ИтогоСуммаПрописью = 
					РаботаСВалютой.СформироватьЧислоПрописьюВсп(ДанныеПечати.ИтогоСумма, ДанныеПечати.Валюта, "Л=ru_RU;ДП=Ложь");
			Исключение
			КонецПопытки;		
			ТабличныйДокумент.Вывести(ОбластьМакета);
		Исключение
		КонецПопытки;

		Попытка
			ОбластьМакета = Макет.ПолучитьОбласть("Подписи");
			ОбластьМакета.Параметры.Заполнить(ДанныеПечати);
			ТабличныйДокумент.Вывести(ОбластьМакета);
		Исключение
		КонецПопытки;
		
		Попытка
			Если ДанныеПечати.БонусовСписано = 0 И ДанныеПечати.БонусовСписано = 0 И ДанныеПечати.БонусОстатки = 0 Тогда
				//пропускаем
			Иначе
				ОбластьМакета = Макет.ПолучитьОбласть("Бонусы");
				ОбластьМакета.Параметры.Заполнить(ДанныеПечати);
				ТабличныйДокумент.Вывести(ОбластьМакета);
			КонецЕсли;
		Исключение
		КонецПопытки;
			
		Попытка
			ОбластьМакета = Макет.ПолучитьОбласть("Долг");
			ОбластьМакета.Параметры.Заполнить(ДанныеПечати); 	
			ТабличныйДокумент.Вывести(ОбластьМакета);
		Исключение
		КонецПопытки;
		
		Попытка
			ОбластьМакета = Макет.ПолучитьОбласть("Подвал");
			ОбластьМакета.Параметры.Заполнить(ДанныеПечати);		
			ТабличныйДокумент.Вывести(ОбластьМакета);
		Исключение
		КонецПопытки;

		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабличныйДокумент, 
            НомерСтрокиНачало, ОбъектыПечати, ДанныеПечати.Ссылка);
	КонецЦикла;
	
	ТабличныйДокумент.ТолькоПросмотр = Истина;
	ТабличныйДокумент.ОтображатьЗаголовки = Ложь;
	ТабличныйДокумент.ОтображатьСетку = Ложь;
	
	Возврат ТабличныйДокумент;
	
КонецФункции

Функция СформироватьПечатнуюФормуТоварнойНакладнойЛитва(МассивОбъектов, ОбъектыПечати) Экспорт
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.АвтоМасштаб         = Истина; //#14053
	ТабличныйДокумент.ИмяПараметровПечати = "ПараметрыПечати_ТоварнаяНакладнаяЛитва";
	Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.РеализацияТоваровИУслуг.ПФ_MXL_ТоварнаяНакладнаяЛитва");
	
	//СтруктураДанныхДляПечати = ПолучитьДанныеДляПечатныхФорм(МассивОбъектов);
	//ТаблицаДанныеПечати = СтруктураДанныхДляПечати.РезультатПоШапке.Выгрузить();	
	//ВыборкаПоТоварамУслугам = СтруктураДанныхДляПечати.РезультатПоТабличнойЧасти.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	//ДополнитьДанныеДляПечатныхФорм(ТаблицаДанныеПечати, ВыборкаПоТоварамУслугам);
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапросаДляПечатиТоварнойНакладной();
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	ДополнитьДанныеДляПечатныхФорм(РезультатЗапроса);
	
	Для Каждого ТекущаяСтрока Из РезультатЗапроса Цикл
		ТекущаяСтрока.Дата = Формат(ТекущаяСтрока.ДатаДокумента,"ДФ=yyyy-MM-dd");
		//Попытка
		//	ТекущаяСтрока.Номер = ПрефиксацияОбъектовКлиентСервер.НомерНаПечать(ТекущаяСтрока.Номер);
		//Исключение
		//КонецПопытки;
		ТекущаяСтрока.ИтогоСуммаНДС = ТекущаяСтрока.Товары.Итог("СуммаНДС") + ТекущаяСтрока.Услуги.Итог("СуммаНДС");
		ТекущаяСтрока.ИтогоСуммаБезНДС = ТекущаяСтрока.СуммаДокумента - ТекущаяСтрока.ИтогоСуммаНДС;
	КонецЦикла;
    
    ПервыйДокумент = Истина;
	Для Каждого ДанныеПечати Из РезультатЗапроса Цикл
		Если Не ПервыйДокумент Тогда
            ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
        КонецЕсли;
        ПервыйДокумент = Ложь;
        НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы + 1;
		
		Попытка
			ОбластьМакета = Макет.ПолучитьОбласть("Заголовок");
			ОбластьМакета.Параметры.Заполнить(ДанныеПечати);
			ТабличныйДокумент.Вывести(ОбластьМакета);
		Исключение			
		КонецПопытки;
		
		Попытка
			ОбластьМакета = Макет.ПолучитьОбласть("Шапка");
			ОбластьМакета.Параметры.Заполнить(ДанныеПечати);
			ТабличныйДокумент.Вывести(ОбластьМакета);
		Исключение			
		КонецПопытки;
				
		Попытка
			ОбластьМакета = Макет.ПолучитьОбласть("ШапкаТаблицы");
			ОбластьМакета.Параметры.Заполнить(ДанныеПечати);
			ТабличныйДокумент.Вывести(ОбластьМакета);
		Исключение			
		КонецПопытки;
		
		// подготовим табличную часть в зависимости от варианта формирования ПФ 
		ВариантФормированияПФРТИУ = Константы.ВариантФормированияПФРТИУ.Получить();
		ТаблицаТоварыИУслуги = ДанныеПечати.Товары.Скопировать();
		ТаблицаТоварыИУслуги.Колонки.Добавить("ВидНоменклатуры");
		ТаблицаТоварыИУслуги.Колонки.Добавить("ЕстьПотолок");
		
		Для Каждого ТекущаяСтрока Из ТаблицаТоварыИУслуги Цикл
			Если Справочники.ВидыНоменклатуры.ЭтоНоменклатураПотолкаИлиОтреза(ТекущаяСтрока.Номенклатура) Тогда
				ТекущаяСтрока.ВидНоменклатуры = 1;
			Иначе
				ТекущаяСтрока.ВидНоменклатуры = 2;
			КонецЕсли;
			Если ТекущаяСтрока.Потолок.Пустая() Тогда
				ТекущаяСтрока.ЕстьПотолок = 2;
			Иначе
				ТекущаяСтрока.ЕстьПотолок = 1;
			КонецЕсли;
			
			ТекущаяСтрока.СтавкаНДСЧислом = УчетНДС.ПолучитьСтавкуНДС(ТекущаяСтрока.СтавкаНДС);
			ТекущаяСтрока.ЦенаБезНДС = ТекущаяСтрока.Цена - УчетНДС.РассчитатьСуммуНДС(ТекущаяСтрока.Цена, ТекущаяСтрока.СуммаНДС > 0, , ТекущаяСтрока.СтавкаНДСЧислом);
			
		КонецЦикла;
		Для Каждого ТекущаяСтрока Из ДанныеПечати.Услуги Цикл
			НоваяСтрока = ТаблицаТоварыИУслуги.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущаяСтрока);
			НоваяСтрока.ВидНоменклатуры = 3;
			Если ТекущаяСтрока.Потолок.Пустая() Тогда
				НоваяСтрока.ЕстьПотолок = 2;
			Иначе
				НоваяСтрока.ЕстьПотолок = 1;
			КонецЕсли;
		КонецЦикла;
		
		//0. Потолок - товар - услуга - потолок - товар - услуга
		//1. Потолок, Потолок, Товары, Товары, услуги, услуги
		//2. Потолок - потолок - товар (все одинаковые позиции сворачиваются). - услуга (все одинаковые позиции сворачиваются)
		//3. Без группировок
		Если ВариантФормированияПФРТИУ = 0 Тогда
			ТаблицаТоварыИУслуги.Сортировать("ЕстьПотолок, Потолок, ВидНоменклатуры");		
		ИначеЕсли ВариантФормированияПФРТИУ = 1 Тогда
			ТаблицаТоварыИУслуги.Сортировать("ВидНоменклатуры");
		ИначеЕсли ВариантФормированияПФРТИУ = 2 Тогда
			ТаблицаТоварыИУслуги.Свернуть("Номенклатура, ЕдиницаИзмерения, Коэффициент, Цена, ПроцентРучнойСкидки, ВидНоменклатуры", "Количество, Сумма, СуммаРучнойСкидки");
			ТаблицаТоварыИУслуги.Сортировать("ВидНоменклатуры")
		ИначеЕсли ВариантФормированияПФРТИУ = 3 Тогда	
			//не сортируем
		КонецЕсли;
		
		Сумма = 0;
		Количество = 0;
		НомерСтроки = 1;
		Для Каждого ТекущаяСтрока Из ТаблицаТоварыИУслуги Цикл //Шапка.Товары Цикл
			Попытка
				ОбластьМакета = Макет.ПолучитьОбласть("Строка");
				ЗаполнитьЗначенияСвойств(ОбластьМакета.Параметры, ТекущаяСтрока);
				
				Если ВариантФормированияПФРТИУ = 0 И ТекущаяСтрока.ВидНоменклатуры = 1 Тогда
					ОбластьМакета.ТекущаяОбласть = ОбластьМакета.Область(1,4,1,4);
					ШрифтПотолка = Новый Шрифт (ОбластьМакета.ТекущаяОбласть.Шрифт,,,Истина);
					ОбластьМакета.ТекущаяОбласть.Шрифт = ШрифтПотолка;
				ИначеЕсли ВариантФормированияПФРТИУ = 0 и НЕ ТекущаяСтрока.Потолок.Пустая() Тогда
					//ОбластьМакета.Параметры.Отступ = "  ";
					ОбластьМакета.ТекущаяОбласть = ОбластьМакета.Область(1,4,1,4);
					ОбластьМакета.ТекущаяОбласть.Отступ = 2;
				КонецЕсли;
				
				//++ №12909
				//Попытка
				//	ПредставлениеНоменклатуры = Строка(ТекущаяСтрока.Номенклатура) + Строка(УправлениеПечатью.ПредставлениеХарактеристики(ТекущаяСтрока.ХарактеристикаНоменклатуры));
				//Исключение
				//	ПредставлениеНоменклатуры = Строка(ТекущаяСтрока.Номенклатура);
				//КонецПопытки;
				ПредставлениеНоменклатуры = ОбщийМодульСервер.ПредставлениеНоменклатурыДляПечати(ТекущаяСтрока.Номенклатура, ТекущаяСтрока.ХарактеристикаНоменклатуры);
				//-- №12909
				
				ОбластьМакета.Параметры.ПредставлениеНоменклатуры = ПредставлениеНоменклатуры;
				Попытка
					ОбластьМакета.Параметры.НомерСтроки = НомерСтроки;
				Исключение
				КонецПопытки;
				ТабличныйДокумент.Вывести(ОбластьМакета);
				
				НомерСтроки = НомерСтроки + 1;			
				Количество = Количество + ТекущаяСтрока.Количество;
				Сумма = Сумма + ТекущаяСтрока.Сумма;
			Исключение			
			КонецПопытки;		
		КонецЦикла;
		
		Попытка
			ОбластьМакета = Макет.ПолучитьОбласть("Итого");
			ОбластьМакета.Параметры.Заполнить(ДанныеПечати);
			ТабличныйДокумент.Вывести(ОбластьМакета);
		Исключение
		КонецПопытки;
				
		Попытка
			ОбластьМакета = Макет.ПолучитьОбласть("Подвал");
			ОбластьМакета.Параметры.Заполнить(ДанныеПечати);				
			ТабличныйДокумент.Вывести(ОбластьМакета);
		Исключение			
		КонецПопытки;
		
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабличныйДокумент, 
            НомерСтрокиНачало, ОбъектыПечати, ДанныеПечати.Ссылка);
	КонецЦикла;
	
	ТабличныйДокумент.ТолькоПросмотр = Истина;
	ТабличныйДокумент.ОтображатьЗаголовки = Ложь;
	ТабличныйДокумент.ОтображатьСетку = Ложь;
	
	Возврат ТабличныйДокумент;
	
КонецФункции

