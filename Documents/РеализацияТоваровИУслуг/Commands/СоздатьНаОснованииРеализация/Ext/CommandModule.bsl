&НаКлиенте
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)
	
	// Свойства команды - тип параметра, множественный выбор и расположение.
	// Используем стандартный механизм ввода на основании, просто данные передаем свои.

	//#5610 проверка из обработки заполнения Ртиу вынесена на клиента
	Если ТипЗнч(ПараметрКоманды) = Тип("ДокументСсылка.ЗаказПокупателя") Тогда		
		СтруктураПроверки = ОбщийМодульВызовСервера.ЭтоЗаказИнтеркампаниСОднойОрганизацией(ПараметрКоманды);
		Если СтруктураПроверки.Результат Тогда
			ПоказатьПредупреждение(, СтруктураПроверки.ТекстОшибки);
			Возврат;
		КонецЕсли;
	ИначеЕсли ТипЗнч(ПараметрКоманды) = Тип("Массив") Тогда
		Если ПараметрКоманды.Количество() > 0 Тогда		
			Для каждого СсылкаЗаказПокупателя из ПараметрКоманды Цикл
				Если ТипЗнч(СсылкаЗаказПокупателя) = Тип("ДокументСсылка.ЗаказПокупателя") Тогда
					СтруктураПроверки = ОбщийМодульВызовСервера.ЭтоЗаказИнтеркампаниСОднойОрганизацией(СсылкаЗаказПокупателя);
					Если СтруктураПроверки.Результат Тогда
						ПоказатьПредупреждение(, СтруктураПроверки.ТекстОшибки);
						Возврат;
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;			
	
	ПараметрыФормы = Новый Структура("ЗначенияЗаполнения", Новый Структура("МассивДокументов", ПараметрКоманды));
	ОткрытьФорму("Документ.РеализацияТоваровИУслуг.ФормаОбъекта", ПараметрыФормы);
	
КонецПроцедуры
