&НаКлиенте
Перем мСуммаБонусов;

&НаКлиенте
Перем ПараметрыДляЗаписи Экспорт;

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ВалютаУчета = ПолучитьФункциональнуюОпцию("ВалютаУчета");
	
	//++ настройка видимости элементов по бонусам
	УстановитьВидимостьЭлементовПоБонусам();	
	УчетБонусовПо = ?(Объект.СлужебныйУчетБонусовПоДисконтнымКартам, 1, 0);
	//-- настройка видимости элементов по бонусам
	
	ИспользуютсяАвтоматическиеСкидки = ОбщийМодуль.ЕстьРеквизитТабЧастиОбъекта("СуммаАвтоматическойСкидки", Объект.Ссылка.Метаданные(), "Товары");
	
	ИспользоватьКонтрольКратности = ПолучитьФункциональнуюОпцию("ИспользоватьКонтрольКратностиЕдиницИзмерения");
	
	Если Параметры.Ключ.Пустая() Тогда
		
		ПриЧтенииСозданииНаСервере();	
	
		Если Объект.НачислятьБонусы Тогда
			ПересчитатьБонусыПоДокументу();
		КонецЕсли;
		
	Иначе
		ЭтаФорма.ТолькоПросмотр = ПраваПользователей.ДокументТолькоПросмотр(Объект.Ссылка);
	КонецЕсли;
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	// СтандартныеПодсистемы.УчетОригиналовПервичныхДокументов
	УчетОригиналовПервичныхДокументов.ПриСозданииНаСервере_ФормаДокумента(ЭтотОбъект, Элементы.ГруппаПодвал);
	// Конец СтандартныеПодсистемы.УчетОригиналовПервичныхДокументов 

	СофтФонСервер.ПриСозданииНаСервере(ЭтотОбъект);
	МессенджерыСервер.ПриСозданииНаСервере(ЭтотОбъект, Элементы.ГруппаКонтрагентКПМессенджеры); // должно быть до РегулировкаШириныПоляКонтрагента
	
	ОбновитьВидимостьИОстаткиВзаиморасчетов();
	
	ОбщийМодульСервер.ДополнительнаяИнформацияПоКонтрагентуНаФорме(Объект.Контрагент, Элементы.ПоказатьДополнительнуюИнформацию);
	ОбщийМодульСервер.ЕстьИндивидуальныеЦеныКонтрагентаНаФорме(Объект.Дата, Объект.Контрагент, Объект.ДоговорКонтрагента, Элементы.ЕстьИндивидуальныеЦены);
	ОбщийМодульСервер.РегулировкаШириныПоляКонтрагента(Элементы, Элементы.Контрагент, Элементы.ПоказатьДополнительнуюИнформацию, Элементы.ЕстьИндивидуальныеЦены);
	
	ЗаполнитьСтавкуНДСПоОрганизации(Ложь);
	//РассчитатьИтоговыеПоказатели();
	ОбновитьДанныеДокумента();
	
	ОпределитьВидимостьТаблицыВыработкиИРассчитатьИтог();
	
	РеквизитыПользователя = ОбщийМодульСервер.НастройкиПользователя("РазрешитьНулевыеЦены, РазрешеноМенятьМенеджераВРеализации,
									|ДополнительныеПраваЗапретРедактированияЦенВДокументах, ДополнительныеПраваЗапретПримененияСкидок");
	
	//управление доступностью элементов
	Если РеквизитыПользователя.ДополнительныеПраваЗапретРедактированияЦенВДокументах Тогда
		МассивИменЭлементов = Документы.РеализацияТоваровИУслуг.ПолучитьМассивРеквизитовПоЦенам();
		ОбщийМодульКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы, МассивИменЭлементов, "ТолькоПросмотр", Истина);
	КонецЕсли;
	//#7771
	Если РеквизитыПользователя.ДополнительныеПраваЗапретПримененияСкидок Тогда
		МассивИменЭлементов = Документы.РеализацияТоваровИУслуг.ПолучитьМассивРеквизитовПоСкидкам();
		ОбщийМодульКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы, МассивИменЭлементов, "ТолькоПросмотр", Истина);
	КонецЕсли;
		
	// при создании реализации из заказа на производства на неполный перечень товаров
	Если Параметры.ЗначенияЗаполнения.Свойство("ЕстьОстаткиТовара") Тогда 
		Если Параметры.ЗначенияЗаполнения.ЕстьОстаткиТовара Тогда 
			ПерезаполнитьТаблицыТоваровУслуг();
		КонецЕсли;
	КонецЕсли;
	
	Элементы.ПодменюПечать.Доступность = ПраваПользователей.ДоступностьПечати(Объект.Ссылка);
	ПраваПользователей.УстановитьТолькоПросмотрДляРеквизитаНомер(Элементы.Номер.ТолькоПросмотр);

	ИспользоватьПодключаемоеОборудование = ПолучитьФункциональнуюОпцию("ИспользоватьПодключаемоеОборудование");
	Элементы.ГруппаФискальныйРегистратор.Видимость = ИспользоватьПодключаемоеОборудование;
	Элементы.ФормаПечатьЧека.Видимость = ИспользоватьПодключаемоеОборудование;
	
	//#12358
	//Элементы.ГруппаВыдача.Видимость = ПолучитьФункциональнуюОпцию("ВестиУчетВыдачиТоваровПоДокументуРеализации");
	Элементы.ГруппаВыдача.Видимость = ПолучитьФункциональнуюОпцию("ИспользоватьСтатусыОтгрузки");

	Элементы.ТоварыБесплатно.ТолькоПросмотр = НЕ РеквизитыПользователя.РазрешитьНулевыеЦены;
	Элементы.УслугиБесплатно.ТолькоПросмотр = НЕ РеквизитыПользователя.РазрешитьНулевыеЦены;
	
	//2.0 чтобы не могли выбрать ЗнП
	МассивТиповЗаказов = Новый Массив();
	МассивТиповЗаказов.Добавить(Тип("ДокументСсылка.ЗаказПокупателя"));
	ОписаниеТиповЗаказов = Новый ОписаниеТипов(МассивТиповЗаказов);
	Элементы.ТоварыЗаказ.ОграничениеТипа = ОписаниеТиповЗаказов; 
	
	ФинансыСервер.УстановитьОтметкуНезаполненныхСтатейДоходовРасходов(Элементы);
	МассивЭлементов = Новый Массив;
	МассивЭлементов.Добавить("ТоварыСтатьяДоходов");
	МассивЭлементов.Добавить("УслугиСтатьяДоходов");
	ФинансыСервер.УстановитьВидимостьКолонокСтатейДиРВТабличнойЧасти(ЭтаФорма, МассивЭлементов, Истина);
	
	ОбщийМодульСервер.ДобавитьИндикаторРаботыСоСканерамиШК(ЭтотОбъект);
	
	//#4644
	Выработка.Параметры.УстановитьЗначениеПараметра("ОбъектВыработки", Объект.Ссылка);
	ОбщийМодульСервер.УстановитьВидимостьГруппыВыработки(Элементы, Объект.Ссылка);
	
	// Видимость колонки Артикул
	МассивЭлементов = новый Массив();
	МассивЭлементов.Добавить("ТоварыНоменклатураАртикул");
	МассивЭлементов.Добавить("УслугиНоменклатураАртикул");
	МассивЭлементов.Добавить("ВыработкаНоменклатураАртикул");
	МассивЭлементов.Добавить("ОбъектВыработкаНоменклатураАртикул");
	МассивЭлементов.Добавить("ВыработкаПлановаяНоменклатураАртикул");
	ОбщийМодульСервер.УстановитьВидимостьКолонкиАртикулВТабличнойЧасти(ЭтаФорма, МассивЭлементов);	
	
	//#7805
	УправлениеВидимостьюАдресаМонтажа();
	
	// №10663
	Элементы.ГруппаСсылкиНаДоставки.Видимость = ПолучитьФункциональнуюОпцию("УчитыватьДоставкуТовара");
	ЗаполнитьСсылкиНаДоставки();
	
	ФинансыСервер.ОбновитьВидимостьИКурсВалюты(ЭтотОбъект);
	
	//#13943
	Элементы.Менеджер.ТолькоПросмотр = НЕ РеквизитыПользователя.РазрешеноМенятьМенеджераВРеализации;
	
	ОбщийМодульСервер.УстановитьВидимостьПодразделения(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	МенеджерОборудованияКлиентПереопределяемый.НачатьПодключениеОборудованиеПриОткрытииФормы(ЭтаФорма, "СканерШтрихкода");
	мСуммаБонусов = Объект.СуммаБонусовКНачислениюПоДисконтнойКарте;
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	ДатыЗапретаИзменения.ОбъектПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	
	ПриЧтенииСозданииНаСервере();
	
	РассчитатьИтоговыеПоказателиСервер();
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииСозданииНаСервере()
	
	ДоговорДоИзменения = Объект.ДоговорКонтрагента;
		
	ОбщийМодульСервер.ПриЧтенииСозданииДокументовСДоставкойНаСервере(Элементы, Объект);
	
	ЗаполнитьОстаткиПоТоварам();
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	
	//#2792
	Если ИспользоватьКонтрольКратности Тогда
		ОбщийМодульСервер.ПроверитьКратностьЕдиницИзмерения(Отказ, Объект, Перечисления.ВидыДокументовПроверкиКратности.РеализацияТоваровИУслуг);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	Если ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
		Для Каждого ТекущаяСтрока Из Объект.Товары Цикл
			Если ТекущаяСтрока.Сумма < 0 Тогда
				Сообщить("В строке №" + ТекущаяСтрока.НомерСтроки + " товаров указана отрицательная сумма. Необходимо исправить строку. Проведение отменено");
				Отказ = Истина;
			КонецЕсли;
		КонецЦикла;
		Для Каждого ТекущаяСтрока Из Объект.Услуги Цикл
			Если ТекущаяСтрока.Сумма < 0 Тогда
				Сообщить("В строке №" + ТекущаяСтрока.НомерСтроки + " услуг указана отрицательная сумма. Необходимо исправить строку. Проведение отменено");
				Отказ = Истина;
			КонецЕсли;
		КонецЦикла;
		Если Отказ Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	//#13359 перенесено в ПослеЗаписи
	//Если НЕ Отказ 
	//	И ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.Проведение 
	//	И UDS_ОбщийМодульВызовСервера.ИспользуетсяUDS() Тогда
	//	UDS_ОбщийМодульКлиент.ПередатьТранзакцию(Объект, Истина, Отказ);
	//КонецЕсли;
	
	// №1083 очищаем таблицу выработки, если выключена галочка "Ручная корректировка"
	Если НЕ Объект.РучнаяКорректировкаВыработки Тогда
		Объект.Выработка.Очистить();
	КонецЕсли;
	
	Если НеВыполнятьПроверкуПередЗаписью Тогда
		НеВыполнятьПроверкуПередЗаписью = Ложь;
		Возврат;
	КонецЕсли;
	
	Если ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
		ВыполнитьПроверкиИЗадатьВопросыПередЗаписью(Отказ, ПараметрыЗаписи);
	КонецЕсли;
	
	ОбщийМодульКлиент.ЗаписатьОбъектПриНеобходимости(ЭтотОбъект, ПараметрыЗаписи, Отказ);

КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	ОбновитьДанныеДокумента();
	Если ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
		Отказ = НЕ ПраваПользователей.РазрешеноРасходоватьСоСклада(Объект.Склад);
		Если Отказ Тогда
			Сообщить("У текущего пользователя нет прав для оформления расхода по складу """ + Объект.Склад + """");
			Возврат;
		КонецЕсли;
		
		//Проверка на разрешение отгрузки
		Если Константы.ИспользоватьУчетРазрешенийНаОтгрузкуЗаказов.Получить() Тогда
			//Проверим основание
			Если Объект.Основание <> Неопределено И НЕ Объект.Основание.Пустая()
				И (ТипЗнч(Объект.Основание) = Тип("ДокументСсылка.ЗаказПокупателя")
					//ИЛИ ТипЗнч(Объект.Основание) = Тип("ДокументСсылка.ЗаказПокупателя") //переход на 2.0
					) 
					Тогда
					
					Отказ = НЕ Объект.Основание.ОтгрузкаРазрешена;
					Если Отказ Тогда
						Сообщить("По заказу в основании " + Объект.Основание + " не установлено разрешение на отгрузку!");
						Возврат;	
					КонецЕсли;	
					
			КонецЕсли;	
		КонецЕсли;
	КонецЕсли;
	
	// проверяем заполненность статей доходов/расходов
	ФинансыСервер.ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи);
	
КонецПроцедуры

&НаСервере
Процедура ПриЗаписиНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	Если ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
		//#13359
		//Если UDS_ОбщийМодульВызовСервера.ИспользуетсяUDS() Тогда
		Если Объект.СлужебныйВидБонуснойСистемы = ПредопределенноеЗначение("Перечисление.ВидыБонусныхСистем.UDS") Тогда
			СостояниеОбменаUDS = UDS_ОбщийМодульКлиент.ПередатьТранзакцию(Объект, Истина);
			Если СостояниеОбменаUDS = 0 Тогда // не требуется
				// продолжаем процедуру ПослеЗаписи
			ИначеЕсли СостояниеОбменаUDS = 1 Тогда 
				// успешно отправлено
				Записать(ПараметрыЗаписи);
				Возврат;
			Иначе
				// ошибка при отправке, пользователь получит сообщение
				ПараметрыЗаписи.ПринудительноЗакрытьФорму = Ложь;
				//Возврат;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	мСуммаБонусов = Объект.СуммаБонусовКНачислениюПоДисконтнойКарте;
	
	НужноОбновитьАрмПроизводства = Ложь;
	Для Каждого ТекСтрокаТовары Из Объект.Товары Цикл
		Если НЕ ТекСтрокаТовары.Заказ = Неопределено Тогда
			НужноОбновитьАрмПроизводства = Истина;
		КонецЕсли;
	КонецЦикла;
	
	Если НужноОбновитьАрмПроизводства Тогда
		Оповестить("ОбновитьАРМПроизводства",,"РеализацияТоваровИУслуг");
	КонецЕсли;
	
	МассивОснований = Новый Массив;
	Если ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда		
		Если ЗначениеЗаполнено(Объект.Основание) И ТипЗнч(Объект.Основание) = Тип("ДокументСсылка.ЗаказПокупателя") Тогда
			МассивОснований.Добавить(Объект.Основание);
		КонецЕсли;	
		Для каждого СтрокаОснования из Объект.Основания Цикл
			Если ТипЗнч(СтрокаОснования.Основание) = Тип("ДокументСсылка.ЗаказПокупателя") Тогда
				МассивОснований.Добавить(СтрокаОснования.Основание);
			КонецЕсли;	
		КонецЦикла;
		
		//++ №16140 Закоментирован так как есть ниже.
		// Оповестить("ЗакрытиеЗаказа", МассивОснований, Объект.Ссылка);	
	КонецЕсли;
	
	Если МассивОснований.Количество() > 0 Тогда
		Оповестить("Запись_РеализацияПоЗаказу", МассивОснований);
		
		Если ПолучитьФункциональнуюОпциюНаСервере("АвтоматическиПереводитьЗаказПокупателяВСтатусВыполненПриПолнойОтгрузке") Тогда		
			Оповестить("ЗакрытиеЗаказа", МассивОснований, Объект.Ссылка);	
		КонецЕсли;
	КонецЕсли;
	
	Выработка.Параметры.УстановитьЗначениеПараметра("ОбъектВыработки", Объект.Ссылка); // для новых документов ссылка могла быть пустой
	Элементы.Выработка.Обновить();
	ОпределитьВидимостьТаблицыВыработкиИРассчитатьИтог();
	
	//ЗаполнитьОстаткиПоТоварам();
	//ОбновитьДанныеДокумента();
	
	ОбщийМодульКлиент.ВыполнитьДействияПослеЗаписи(ЭтаФорма, Объект, ПараметрыЗаписи);
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	Элементы.ПодменюПечать.Доступность = ПраваПользователей.ДоступностьПечати(Объект.Ссылка);
	
	ЗаполнитьОстаткиПоТоварам();
	
	ОбновитьВидимостьИОстаткиВзаиморасчетов();

	Если ИспользоватьБонусы Тогда
		БонусыСервер.НастройкаЭлементов(Элементы, ТекущийОбъект);  //#16589
		БонусыСервер.ОпределитьОстатокПоДисконтнойКарте(ЭтаФорма); // №13299
	КонецЕсли;
	
КонецПроцедуры

