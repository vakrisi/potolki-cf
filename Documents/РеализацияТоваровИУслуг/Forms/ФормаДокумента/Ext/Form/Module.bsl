&НаКлиентеНаСервереБезКонтекста
Процедура РассчитатьИтоговыеПоказатели(ТаблицаТоваров, ТаблицаУслуг, ИтогСумма, ИтогСуммаНДС, ИтогСуммаДокументаБезУчетаБонусов)

	ИтогСумма = 0;
	ИтогСуммаНДС = 0;
	ИтогСуммаДокументаБезУчетаБонусов = 0;
	
	Для каждого СтрокаТабличнойЧасти из ТаблицаТоваров Цикл
		ИтогСумма = ИтогСумма + СтрокаТабличнойЧасти.Сумма;
		ИтогСуммаНДС = ИтогСуммаНДС + СтрокаТабличнойЧасти.СуммаНДС;
		
		ИтогСуммаДокументаБезУчетаБонусов = ИтогСуммаДокументаБезУчетаБонусов + (СтрокаТабличнойЧасти.Количество * СтрокаТабличнойЧасти.Цена - СтрокаТабличнойЧасти.СуммаРучнойСкидки);
	КонецЦикла;
	Для каждого СтрокаТабличнойЧасти из ТаблицаУслуг Цикл
		ИтогСумма = ИтогСумма + СтрокаТабличнойЧасти.Сумма;
		ИтогСуммаНДС = ИтогСуммаНДС + СтрокаТабличнойЧасти.СуммаНДС;
		
		ИтогСуммаДокументаБезУчетаБонусов = ИтогСуммаДокументаБезУчетаБонусов + (СтрокаТабличнойЧасти.Количество * СтрокаТабличнойЧасти.Цена - СтрокаТабличнойЧасти.СуммаРучнойСкидки);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСтавкуНДСПоОрганизации(ИзменятьСтавку = Истина)
	
	УчитыватьНДС = УчетНДС.ОрганизацияЯвляетсяПлательщикомНДС(Объект.Организация);
	СтавкаНДСПоУмолчанию = УчетНДС.СтавкаНДСПоУмолчанию(Объект.Организация);
	
	Элементы.ТоварыСуммаНДС.Видимость 	= УчитыватьНДС;
	Элементы.ТоварыСтавкаНДС.Видимость 	= УчитыватьНДС;
	Элементы.УслугиСуммаНДС.Видимость 	= УчитыватьНДС;
	Элементы.УслугиСтавкаНДС.Видимость 	= УчитыватьНДС;
	
	Элементы.ИтогСуммаНДС.Видимость 	= УчитыватьНДС;	
	
	Если ИзменятьСтавку Тогда
		Для каждого СтрокаТабличнойЧасти из Объект.Товары Цикл
			СтрокаТабличнойЧасти.СтавкаНДС = СтавкаНДСПоУмолчанию;
			ОбработкаТабличныхЧастейКлиентСервер.ПересчитатьСуммуНДСВСтрокеТЧ(СтрокаТабличнойЧасти, УчитыватьНДС);	
		КонецЦикла;
		Для каждого СтрокаТабличнойЧасти из Объект.Услуги Цикл
			СтрокаТабличнойЧасти.СтавкаНДС = СтавкаНДСПоУмолчанию;
			ОбработкаТабличныхЧастейКлиентСервер.ПересчитатьСуммуНДСВСтрокеТЧ(СтрокаТабличнойЧасти, УчитыватьНДС);	
		КонецЦикла;
		РассчитатьИтоговыеПоказателиСервер();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПолучитьДанныеОрганизацииПриИзменении()
	
	СтавкаНДСПоУмолчанию = УчетНДС.СтавкаНДСПоУмолчанию(Объект.Организация);
	
