&НаКлиенте
Процедура ТоварыПередУдалением(Элемент, Отказ)
	
	СписокВыделенныхПозиций = Элементы.Товары.ВыделенныеСтроки;
	
	СписокПозицийКУдалению = новый СписокЗначений;	
	СписокПотолков = новый СписокЗначений;
	
	Если СписокВыделенныхПозиций.Количество() > 0
		И ЭтоПотолокИУНегоЕстьУслугиВТЧ(СписокВыделенныхПозиций, СписокПотолков, СписокПозицийКУдалению) Тогда
		//Если это потолок и у него есть товары / услуги в ТЧ, зададим вопрос об удалении их из ТЧ
		ОписаниеОповещения = новый ОписаниеОповещения("ПослеВопросаОУдаленииТоваровУслугПоПотолку", ЭтотОбъект, новый Структура("Потолки", СписокПотолков));
		
		ТекстВопроса = "В табличных частях есть позиции, связанные с продукцией, удалить позиции?";
		Для Каждого ТекущаяСтрока Из СписокПотолков Цикл
			
			ТекстВопроса = ТекстВопроса + Символы.ПС + "Продукция: " + ТекущаяСтрока.Значение;
			
			Для Каждого Строка Из СписокПозицийКУдалению Цикл
				Если Строка.Значение.Потолок = ТекущаяСтрока.Значение Тогда
					ТекстВопроса = ТекстВопроса 
						+ Символы.ПС 
						+ "   " + Строка.Значение.ТЧ + " номер строки " + Строка.Значение.НомерСтроки + " "
						+ Строка.Значение.Номенклатура + " " + Строка.Значение.ХарактеристикаНоменклатуры;
				КонецЕсли;	
			КонецЦикла;
		КонецЦикла;	
		
		ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет,,, "Удаление связанных позиций по продукции");		
		
	КонецЕсли;
	
КонецПроцедуры

