&НаСервереБезКонтекста
Функция ПолучитьТекущийДолгКлиента(Знач Организация, Знач Контрагент, Знач Договор)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВзаиморасчетыСКонтрагентамиОстатки.СуммаОстаток
	|ИЗ
	|	РегистрНакопления.ВзаиморасчетыСКонтрагентами.Остатки(
	|			,
	|			Договор = &Договор
	|				И Контрагент = &Контрагент
	|				И Организация = &Организация) КАК ВзаиморасчетыСКонтрагентамиОстатки";
	Запрос.УстановитьПараметр("Организация",Организация);
	Запрос.УстановитьПараметр("Контрагент",Контрагент);
	Запрос.УстановитьПараметр("Договор",Договор);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Возврат Выборка.СуммаОстаток;
	КонецЦикла;
	
	Возврат 0;
	
КонецФункции

&НаСервере
Процедура ПерезаполнитьТаблицыТоваровУслуг()
	
	ТаблицаТоваров = Объект.Товары.Выгрузить();
	ТаблицаУслуг = Объект.Услуги.Выгрузить();
		
	ВремСписокОснований = Новый СписокЗначений;
	ВремСписокОснований.Добавить(Объект.Основание);
	
	ВремТаблицаТоваров = ТаблицаТоваров.Скопировать();
	ВремТаблицаТоваров.Свернуть("Заказ",);
	ВремТаблицаУслуг = ТаблицаУслуг.Скопировать();
	ВремТаблицаУслуг.Свернуть("Заказ",);
	Для Каждого ТекущаяСтрока Из ВремТаблицаТоваров Цикл
		Если НЕ ТекущаяСтрока.Заказ = Неопределено Тогда
			Если НЕ ТекущаяСтрока.Заказ.Пустая() Тогда
				ВремСписокОснований.Добавить(ТекущаяСтрока.Заказ);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Для Каждого ТекущаяСтрока Из ВремТаблицаУслуг Цикл
		Если НЕ ТекущаяСтрока.Заказ = Неопределено Тогда
			Если НЕ ТекущаяСтрока.Заказ.Пустая() Тогда
				ВремСписокОснований.Добавить(ТекущаяСтрока.Заказ);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЗаказыПокупателейОстатки.ЗаказНаПроизводство КАК Заказ,
	|	ЗаказыПокупателейОстатки.Номенклатура,
	|	ЗаказыПокупателейОстатки.КоличествоОстаток КАК Остаток
	|ИЗ
	|	РегистрНакопления.ЗаказыПокупателей.Остатки(, ЗаказНаПроизводство В (&ЗаказНаПроизводство)) КАК ЗаказыПокупателейОстатки";
	
	Запрос.УстановитьПараметр("ЗаказНаПроизводство", ВремСписокОснований);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если НЕ РезультатЗапроса.Пустой() Тогда 
		Объект.Товары.Очистить();
		Объект.Услуги.Очистить();
		Выборка = РезультатЗапроса.Выгрузить();
		                                                                      
		Для Каждого СтрокаТовара из ТаблицаТоваров Цикл
			ПараметрыПоиска = Новый Структура;
			ПараметрыПоиска.Вставить("Номенклатура",СтрокаТовара.Номенклатура);
			Если СтрокаТовара.Заказ = Неопределено Тогда
				ПараметрыПоиска.Вставить("Заказ",ВремСписокОснований[0].Значение);
			ИначеЕсли СтрокаТовара.Заказ.Пустая() Тогда
				ПараметрыПоиска.Вставить("Заказ",ВремСписокОснований[0].Значение);
			Иначе
				ПараметрыПоиска.Вставить("Заказ",СтрокаТовара.Заказ);
			КонецЕсли;
			
			НайденныйТовар = Выборка.НайтиСтроки(ПараметрыПоиска);
			Если НайденныйТовар.Количество() > 0 Тогда
				НоваяСтрока = Объект.Товары.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока,СтрокаТовара,,"Количество, Сумма");
				НоваяСтрока.Количество = Мин(НайденныйТовар[0].Остаток, СтрокаТовара.Количество);
				//НоваяСтрока.Сумма = (НоваяСтрока.Количество * НоваяСтрока.Цена) - ((НоваяСтрока.Количество * НоваяСтрока.Цена) * (НоваяСтрока.ПроцентРучнойСкидки / 100)) - НоваяСтрока.СуммаРучнойСкидки;
				Если НЕ НайденныйТовар[0].Остаток = СтрокаТовара.Количество Тогда
					НоваяСтрока.Сумма = (НоваяСтрока.Количество * НоваяСтрока.Цена) - НоваяСтрока.СуммаРучнойСкидки;
				Иначе
					//количество могло остаться не изменным, поэтому и сумму возьмем из основания, т.к. на нее могли быть наложены ручные скидки
					НоваяСтрока.Сумма = СтрокаТовара.Сумма;
				КонецЕсли;
				НоваяСтрока.СтавкаНДС = УчетНДС.СтавкаНДСПоУмолчанию(Объект.Организация);
				НоваяСтрока.СуммаНДС = УчетНДС.РассчитатьСуммуНДС(НоваяСтрока.Сумма, УчетНДС.ОрганизацияЯвляетсяПлательщикомНДС(Объект.Организация), , УчетНДС.ПолучитьСтавкуНДС(НоваяСтрока.СтавкаНДС));
				
			КонецЕсли;
		КонецЦикла;
		
		Для Каждого СтрокаТовара из ТаблицаУслуг Цикл
			ПараметрыПоиска = Новый Структура;
			ПараметрыПоиска.Вставить("Номенклатура",СтрокаТовара.Номенклатура);
			ПараметрыПоиска.Вставить("Заказ",СтрокаТовара.Заказ);
			
			НайденныйТовар = Выборка.НайтиСтроки(ПараметрыПоиска);
			Если НайденныйТовар.Количество() > 0 Тогда
				НоваяСтрока = Объект.Услуги.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока,СтрокаТовара,,"Количество, Сумма");
				НоваяСтрока.Количество = Мин(НайденныйТовар[0].Остаток, СтрокаТовара.Количество);
				НоваяСтрока.Сумма = НоваяСтрока.Количество * НоваяСтрока.Цена;
				НоваяСтрока.СтавкаНДС = УчетНДС.СтавкаНДСПоУмолчанию(Объект.Организация);
				НоваяСтрока.СуммаНДС = УчетНДС.РассчитатьСуммуНДС(НоваяСтрока.Сумма, УчетНДС.ОрганизацияЯвляетсяПлательщикомНДС(Объект.Организация), , УчетНДС.ПолучитьСтавкуНДС(НоваяСтрока.СтавкаНДС));
				
			КонецЕсли;
		КонецЦикла; 		
			
	КонецЕсли;
	
КонецПроцедуры

