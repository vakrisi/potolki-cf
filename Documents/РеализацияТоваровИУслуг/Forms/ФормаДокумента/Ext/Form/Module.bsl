Процедура ПересчитатьЦенуИСуммуНоменклатурыВСтрокеПоВалюте(НомерСтроки)
	ТекущаяСтрока = Объект.Товары[НомерСтроки-1];
	ВалютаУчета = Константы.ВалютаУчета.Получить();
	Если НЕ ВалютаУчета = Объект.Валюта Тогда
		ДатаДокумента = Объект.Дата;
		Если ДатаДокумента = Дата(1,1,1) Тогда
			ДатаДокумента = ТекущаяДатаСеанса();
		КонецЕсли;
		ТекущаяСтрока.Цена = РаботаСВалютой.ПересчитатьИзВалютыВВалюту(ВалютаУчета, Объект.Валюта, ДатаДокумента, ТекущаяСтрока.Цена);
		СуммаСтроки = ТекущаяСтрока.Количество * ТекущаяСтрока.Цена;
		//ТекущаяСтрока.Сумма = СуммаСтроки - (СуммаСтроки * (ТекущаяСтрока.ПроцентРучнойСкидки / 100)) - ТекущаяСтрока.СуммаРучнойСкидки;
		ТекущаяСтрока.Сумма = СуммаСтроки - ТекущаяСтрока.СуммаРучнойСкидки;
		ТекущаяСтрока.СтавкаНДС = СтавкаНДСПоУмолчанию;
		ТекущаяСтрока.СуммаНДС = УчетНДС.РассчитатьСуммуНДС(ТекущаяСтрока.Сумма, УчитыватьНДС, , УчетНДС.ПолучитьСтавкуНДС(ТекущаяСтрока.СтавкаНДС));	
	КонецЕсли;
КонецПроцедуры

