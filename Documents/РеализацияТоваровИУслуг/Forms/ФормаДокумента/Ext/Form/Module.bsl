&НаКлиенте
Процедура ДекорацияСсылкаНаДоставкуНажатие(Элемент)
	
	// в названии элемента нужно найти номер в списке
	Позиция = СтрНайти(Элемент.Имя, "Номер_");
	
	Если Позиция = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		НомерСтроки = Число(Сред(Элемент.Имя, Позиция + 6));
	Исключение
		Возврат;
	КонецПопытки;
	
	Если НомерСтроки <= Доставки.Количество()-1 Тогда
		
		СсылкаНаДокумент = Доставки.Получить(НомерСтроки);
		ОткрытьФорму("Документ.ЗаявкаНаДоставку.ФормаОбъекта", новый Структура("Ключ", СсылкаНаДокумент.Значение));
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДекорацияСоздатьДоставкуНажатие(Элемент)
	
	Если Объект.Ссылка.Пустая() Или Модифицированность Тогда
		
		ОП = Новый ОписаниеОповещения("ПослеВопросаОЗаписиДокументаПередСозданиемДоставки", ЭтаФорма);
		ПоказатьВопрос(ОП, "Необходимо записать документ, продолжить?", РежимДиалогаВопрос.ДаНет, 30,, "Запись документа");
		
	Иначе
		
		ДекорацияСоздатьДоставкуНажатиеЗавершение();
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВопросаОЗаписиДокументаПередСозданиемДоставки(Результат, Параметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Нет Тогда
        Возврат;
    КонецЕсли;

	СтруктураЗаписи = Новый Структура;
	СтруктураЗаписи.Вставить("РежимЗаписи",РежимЗаписиДокумента.Проведение);
	СтруктураЗаписи.Вставить("РежимПроведения",РежимПроведенияДокумента.Оперативный);
	
	Если Записать(СтруктураЗаписи) Тогда
		ДекорацияСоздатьДоставкуНажатиеЗавершение();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДекорацияСоздатьДоставкуНажатиеЗавершение()
	
	ПараметрыФормы = Новый Структура("Основание", Объект.Ссылка);
	ОткрытьФорму("Документ.ЗаявкаНаДоставку.ФормаОбъекта", ПараметрыФормы);
	
КонецПроцедуры

