Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если Источник = "ПодключаемоеОборудование" И ИмяСобытия = "ScanData" И ВводДоступен() И НЕ ЭтаФорма.ТолькоПросмотр Тогда		
		
		ОбработатьШтрихкод(Параметр);
		
	//++ №10663
	ИначеЕсли ИмяСобытия = "ЗаписьЗаявкиНаДоставку" Тогда
		
		ЗаполнитьСсылкиНаДоставки();
	
	//-- №10663
	КонецЕсли;

	// СтандартныеПодсистемы.УчетОригиналовПервичныхДокументов
