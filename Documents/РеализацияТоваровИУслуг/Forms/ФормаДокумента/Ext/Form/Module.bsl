&НаСервере
Функция	ЭтоПотолокИУНегоЕстьУслугиВТЧ(ВыделенныеСтроки, СписокПотолков, СписокПозицийКУдалению)
	
	УсловиеВыполнено = Ложь;
	
	Для Каждого НомерСтроки Из ВыделенныеСтроки Цикл
		
		ТекущаяСтрока = Объект.Товары.НайтиПоИдентификатору(НомерСтроки);
	
		Если Справочники.ВидыНоменклатуры.ЭтоНоменклатураПотолкаИлиОтреза(ТекущаяСтрока.Номенклатура) Тогда
			
			СписокПотолков.Добавить(ТекущаяСтрока.Номенклатура);
			
			Для Каждого СтрокаТовар Из Объект.Товары Цикл
				Если СтрокаТовар.Потолок = ТекущаяСтрока.Номенклатура И НЕ СтрокаТовар.Потолок.Пустая() И НЕ СтрокаТовар.Номенклатура = ТекущаяСтрока.Номенклатура Тогда
					УсловиеВыполнено = Истина;	
					СтрокаТоварНомерСтроки = ?(СтрокаТовар.НомерСтроки > ТекущаяСтрока.НомерСтроки, СтрокаТовар.НомерСтроки - 1, СтрокаТовар.НомерСтроки);  
					СписокПозицийКУдалению.Добавить(новый Структура("ТЧ, НомерСтроки, Номенклатура, ХарактеристикаНоменклатуры, Потолок", 
																	"Товары", СтрокаТоварНомерСтроки, СтрокаТовар.Номенклатура, СтрокаТовар.ХарактеристикаНоменклатуры, ТекущаяСтрока.Номенклатура));
				КонецЕсли;
			КонецЦикла;
			
			Для Каждого СтрокаУслуга Из Объект.Услуги Цикл
				Если СтрокаУслуга.Потолок = ТекущаяСтрока.Номенклатура И НЕ СтрокаУслуга.Потолок.Пустая() И НЕ СтрокаУслуга.Номенклатура = ТекущаяСтрока.Номенклатура Тогда
					УсловиеВыполнено = Истина;				
					СписокПозицийКУдалению.Добавить(новый Структура("ТЧ, НомерСтроки, Номенклатура, ХарактеристикаНоменклатуры, Потолок", 
																	"Услуги", СтрокаУслуга.НомерСтроки, СтрокаУслуга.Номенклатура, СтрокаУслуга.ХарактеристикаНоменклатуры, ТекущаяСтрока.Номенклатура));
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
	КонецЦикла;	
	
	Возврат УсловиеВыполнено;
	
КонецФункции

&НаКлиенте
Процедура ПослеВопросаОУдаленииТоваровУслугПоПотолку(Ответ, ДопПараметры) ЭКСПОРТ
	
	Если НЕ Ответ = КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого Потолок Из ДопПараметры.Потолки Цикл
		
		КоличествоСтрок = Объект.Товары.Количество();
		Для Индекс = 1 По КоличествоСтрок Цикл 
			СтрокаТЧ = Объект.Товары[КоличествоСтрок - Индекс];
			Если СтрокаТЧ.Потолок = Потолок.Значение И НЕ СтрокаТЧ.Потолок.Пустая() Тогда
				Объект.Товары.Удалить(СтрокаТЧ);		
			КонецЕсли;
		КонецЦикла;
		КоличествоСтрок = Объект.Услуги.Количество();
		Для Индекс = 1 По КоличествоСтрок Цикл 
			СтрокаТЧ = Объект.Услуги[КоличествоСтрок - Индекс];
			Если СтрокаТЧ.Потолок = Потолок.Значение И НЕ СтрокаТЧ.Потолок.Пустая() Тогда
				Объект.Услуги.Удалить(СтрокаТЧ);		
			КонецЕсли;
		КонецЦикла;
		
	КонецЦикла;
	
	РассчитатьИтоговыеПоказателиКлиент();
	//ОбновитьДанныеДокумента();
	
КонецПроцедуры
	
&НаСервере
Функция ПолучитьСписокПОтолковОснования()
	
	СписокПотолков = Новый СписокЗначений;
	
	Если ТипЗнч(Объект.Основание) = Тип("ДокументСсылка.ЗаказПокупателя") Тогда
		Для Каждого СтрокаОснования из Объект.Основание.Товары Цикл
			Если Справочники.ВидыНоменклатуры.ЭтоНоменклатураПотолкаИлиОтреза(СтрокаОснования.Номенклатура) Тогда
				СписокПотолков.Добавить(СтрокаОснования.Номенклатура);
			КонецЕсли;
		КонецЦикла;
	ИначеЕсли ТипЗнч(Объект.Основание) = Тип("ДокументСсылка.ЗаказДоговор") Тогда
		Для Каждого СтрокаОснования из Объект.Основание.ТоварыУслуги Цикл
			Если Справочники.ВидыНоменклатуры.ЭтоНоменклатураПотолкаИлиОтреза(СтрокаОснования.Номенклатура) Тогда
				СписокПотолков.Добавить(СтрокаОснования.Номенклатура);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Для Каждого ТекущееОснование Из Объект.Основания Цикл
		Если ТипЗнч(ТекущееОснование.Основание) = Тип("ДокументСсылка.ЗаказПокупателя") Тогда
			Для Каждого СтрокаОснования из ТекущееОснование.Основание.Товары Цикл
				Если Справочники.ВидыНоменклатуры.ЭтоНоменклатураПотолкаИлиОтреза(СтрокаОснования.Номенклатура) Тогда
					СписокПотолков.Добавить(СтрокаОснования.Номенклатура);
				КонецЕсли;
			КонецЦикла;
		ИначеЕсли ТипЗнч(ТекущееОснование.Основание) = Тип("ДокументСсылка.ЗаказДоговор") Тогда
			Для Каждого СтрокаОснования из ТекущееОснование.Основание.ТоварыУслуги Цикл
				Если Справочники.ВидыНоменклатуры.ЭтоНоменклатураПотолкаИлиОтреза(СтрокаОснования.Номенклатура) Тогда
					СписокПотолков.Добавить(СтрокаОснования.Номенклатура);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	
	Возврат СписокПотолков;
	
КонецФункции

&НаСервере
Процедура ВыборПотолкаДляЗаполненияПоОснованиюНаСервере(ВыбранныйПотолок)
	
	//удалим выбранный потолок и все что с ним связано из ТЧ Товары
	КопияТЧТовары = Объект.Товары.Выгрузить();
	Объект.Товары.Очистить();
	Для Каждого СтрокаКопии Из КопияТЧТовары Цикл
		Если СтрокаКопии.Номенклатура = ВыбранныйПотолок ИЛИ СтрокаКопии.Потолок = ВыбранныйПотолок Тогда
			продолжить;
		Иначе
			НоваяСтрока = Объект.Товары.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаКопии);
		КонецЕсли;
	КонецЦикла;
	
	КопияТЧУслуги = Объект.Услуги.Выгрузить();
	Объект.Услуги.Очистить();
	Для Каждого СтрокаКопии Из КопияТЧУслуги Цикл
		Если СтрокаКопии.Номенклатура = ВыбранныйПотолок ИЛИ СтрокаКопии.Потолок = ВыбранныйПотолок Тогда
			продолжить;
		Иначе
			НоваяСтрока = Объект.Услуги.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаКопии);
		КонецЕсли;
	КонецЦикла;

	
	//добавим выбранный потолок и все его подчиненные строки из главного основания
	Если ТипЗнч(Объект.Основание) = Тип("ДокументСсылка.ЗаказПокупателя") Тогда
		Для Каждого ТекСтрокаОснования Из Объект.Основание.Товары Цикл
			Если ТекСтрокаОснования.Номенклатура = ВыбранныйПотолок ИЛИ ТекСтрокаОснования.Потолок = ВыбранныйПотолок Тогда
				Если Справочники.ВидыНоменклатуры.ЭтоНоменклатураУслуга(ТекСтрокаОснования.Номенклатура) Тогда
					НоваяСтрока = Объект.Услуги.Добавить();
				Иначе
					НоваяСтрока = Объект.Товары.Добавить();
				КонецЕсли;
				ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрокаОснования);
			КонецЕсли;
		КонецЦикла;
	ИначеЕсли ТипЗнч(Объект.Основание) = Тип("ДокументСсылка.ЗаказДоговор") Тогда
		Для Каждого ТекСтрокаОснования Из Объект.Основание.ТоварыУслуги Цикл
			Если ТекСтрокаОснования.Номенклатура = ВыбранныйПотолок ИЛИ ТекСтрокаОснования.НомерПотолка = ВыбранныйПотолок.Потолок_НомерРасчета Тогда
				Если Справочники.ВидыНоменклатуры.ЭтоНоменклатураУслуга(ТекСтрокаОснования.Номенклатура) Тогда
					НоваяСтрока = Объект.Услуги.Добавить();
				Иначе
					НоваяСтрока = Объект.Товары.Добавить();
				КонецЕсли;
				ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрокаОснования);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	//добавим выбранный потолок и все его подчиненные строки из прочих оснований
	Для Каждого ТекОснование Из Объект.Основания Цикл
		Если ТекОснование.Основание = Объект.Основание Тогда
			Продолжить;
		КонецЕсли;
		Если ТипЗнч(ТекОснование.Основание) = Тип("ДокументСсылка.ЗаказПокупателя") Тогда
			Для Каждого ТекСтрокаОснования Из ТекОснование.Основание.Товары Цикл
				Если ТекСтрокаОснования.Номенклатура = ВыбранныйПотолок ИЛИ ТекСтрокаОснования.Потолок = ВыбранныйПотолок Тогда
					Если Справочники.ВидыНоменклатуры.ЭтоНоменклатураУслуга(ТекСтрокаОснования.Номенклатура) Тогда
						НоваяСтрока = Объект.Услуги.Добавить();
					Иначе
						НоваяСтрока = Объект.Товары.Добавить();
					КонецЕсли;
					ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрокаОснования);
				КонецЕсли;
			КонецЦикла;
		ИначеЕсли ТипЗнч(ТекОснование.Основание) = Тип("ДокументСсылка.ЗаказДоговор") Тогда
			Для Каждого ТекСтрокаОснования Из ТекОснование.Основание.ТоварыУслуги Цикл
				Если ТекСтрокаОснования.Номенклатура = ВыбранныйПотолок ИЛИ ТекСтрокаОснования.НомерПотолка = ВыбранныйПотолок.Потолок_НомерРасчета Тогда
					Если Справочники.ВидыНоменклатуры.ЭтоНоменклатураУслуга(ТекСтрокаОснования.Номенклатура) Тогда
						НоваяСтрока = Объект.Услуги.Добавить();
					Иначе
						НоваяСтрока = Объект.Товары.Добавить();
					КонецЕсли;
					ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрокаОснования);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;

	
	Объект.СуммаДокумента = Объект.Товары.Итог("Сумма")  + Объект.Услуги.Итог("Сумма");
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьНаОснованииВозвратПродукции(Команда)
			
	ПараметрыФормы = Новый Структура;
	ДопПараметры = ПодготовитьСписокТоваровДляВыбораКВозврату();
	ПараметрыФормы.Вставить("СписокПотолков", ДопПараметры.СписокПотолков);
	ПараметрыФормы.Вставить("СписокУслуг",    ДопПараметры.СписокУслуг);

	ОповещениеОЗакрытии = Новый ОписаниеОповещения("ПослеВыбораТоваровКВозврату", ЭтаФорма);
	
	ОткрытьФорму("Документ.ВозвратПродукции.Форма.ФормаВыбораПотолковКВозврату", ПараметрыФормы,,,ВариантОткрытияОкна.ОтдельноеОкно,,ОповещениеОЗакрытии);
	
КонецПроцедуры

&НаСервере
Функция ПодготовитьСписокТоваровДляВыбораКВозврату()
	Возврат Документы.ВозвратПродукции.ПодготовитьСписокТоваровДляВыбора(Объект.Ссылка);
КонецФункции

&НаКлиенте
Процедура ПослеВыбораТоваровКВозврату(Результат, ДополнительныеПараметры) Экспорт
	
	Если ТипЗнч(Результат) = Тип("Массив") Тогда
		
		Если Результат.Количество() > 0 Тогда			
			ПараметрыЗаполнения = Новый Структура;
			ПараметрыЗаполнения.Вставить("ДокументОснование", Объект.Ссылка);
			ПараметрыЗаполнения.Вставить("МассивТоваров", Результат);			
			ПараметрыФормы = Новый Структура("ЗначенияЗаполнения", ПараметрыЗаполнения);			
			ОткрытьФорму("Документ.ВозвратПродукции.Форма.ФормаДокумента", ПараметрыФормы);			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьШтрихкод(Параметр)
	
	СтруктураТовара = ОбщийМодульКлиент.ПолучитьНоменклатуруПоШтрихКоду(МенеджерОборудованияКлиентПереопределяемый.ПреобразоватьДанныеСоСканераВМассив(Параметр));
	
	Если НЕ СтруктураТовара.Номенклатура = ПредопределенноеЗначение("Справочник.Номенклатура.ПустаяСсылка") Тогда
		
		//Попробуем найти в ТЧ
		//СтруктураПоиска = новый Структура("Номенклатура, ХарактеристикаНоменклатуры, ЕдиницаИзмерения", СтруктураТовара.Номенклатура, СтруктураТовара.ХарактеристикаНоменклатуры, СтруктураТовара.ЕдиницаИзмерения);
		СтруктураПоиска = новый Структура("Номенклатура, ХарактеристикаНоменклатуры, СерияНоменклатуры, ЕдиницаИзмерения", СтруктураТовара.Номенклатура, СтруктураТовара.ХарактеристикаНоменклатуры, СтруктураТовара.СерияНоменклатуры, СтруктураТовара.ЕдиницаИзмерения);		
		НайденныеСтроки = Объект.Товары.НайтиСтроки(СтруктураПоиска);
		
		Если НайденныеСтроки.Количество() = 0 Тогда
			НоваяСтрока = Объект.Товары.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтруктураТовара);
			//НоваяСтрока.Количество = 1;
			//Если ТипЗнч(НоваяСтрока.ЕдиницаИзмерения) = Тип("СправочникСсылка.КлассификаторЕдиницИзмерения") Тогда
			//	НоваяСтрока.Коэффициент = 1;
			//Иначе
			//	НоваяСтрока.Коэффициент = ОбщийМодуль.ПолучитьКоэффициентЕдиницыИзмерения(НоваяСтрока.ЕдиницаИзмерения);
			//КонецЕсли;
			//НоваяСтрока.Цена = ПолучитьЦенуНоменклатуры(НоваяСтрока.Номенклатура, НоваяСтрока.ХарактеристикаНоменклатуры, НоваяСтрока.ЕдиницаИзмерения);
			СтруктураДанные = СтруктураДанныхПоСтрокеТабличнойЧасти(НоваяСтрока);
			СтруктураДанные = ПолучитьДанныеНоменклатурыПриИзменении(СтруктураДанные);
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтруктураДанные, "Коэффициент, Цена, Количество"); //#2792 добавлено Количество
						
			НоваяСтрока.СтавкаНДС = СтавкаНДСПоУмолчанию;			
		Иначе
			НоваяСтрока = НайденныеСтроки[0];
			НоваяСтрока.Количество = НоваяСтрока.Количество + 1;
		КонецЕсли;	
		
		//НоваяСтрока.СуммаНДС = УчетНДС.РассчитатьСуммуНДС(НоваяСтрока.Сумма, УчитыватьНДС, , УчетНДС.ПолучитьСтавкуНДС(НоваяСтрока.СтавкаНДС));		
		ОбработкаТабличныхЧастейКлиент.ПересчитатьСуммуРучнойСкидкиВСтрокеТЧ(НоваяСтрока);
		ОбработкаТабличныхЧастейКлиент.ПересчитатьСуммуСУчетомСкидокВСтрокеТЧ(НоваяСтрока, ИспользуютсяАвтоматическиеСкидки, Истина, Истина);
		ПересчитатьЦенуИСуммуНоменклатурыВСтрокеПоВалюте(НоваяСтрока.НомерСтроки);		
		ОбработкаТабличныхЧастейКлиент.ПересчитатьСуммуНДСВСтрокеТЧ(НоваяСтрока, УчитыватьНДС);
		
		РассчитатьИтоговыеПоказателиКлиент();
		//ОбновитьДанныеДокумента();
		Если ИспользоватьБонусы Тогда
			ПересчитатьБонусыПоДокументу();
		КонецЕсли;
