	КонецЦикла;
	
	//визуальные элементы
	БонусыСервер.ОпределитьОстатокПоДисконтнойКарте(ЭтаФорма);
	ДоступноПоДисконтнойКарте = Мин(МаксимальныйРазмерБонусовКСписаниюПоДокументу() / 100 * СуммаДокументаБезУчетаБонусов, ОстатокПоДисконтнойКарте);
		
