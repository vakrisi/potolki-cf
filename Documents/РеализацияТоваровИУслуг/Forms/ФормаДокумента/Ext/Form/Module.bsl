&НаКлиенте
Процедура ДоговорПриИзмененииКлиент()
	
	Если НЕ ДоговорДоИзменения = Объект.ДоговорКонтрагента Тогда
		ДоговорДоИзменения = Объект.ДоговорКонтрагента;		
		ВидЦенДоИзменения = Объект.ВидЦен;
		СкладДоИзменения = Объект.Склад;
		
		ДоговорПриИзмененииСервер();
		Если НЕ ВидЦенДоИзменения = Объект.ВидЦен Тогда
			ВидЦенПриИзмененииКлиент();
		КонецЕсли;
		Если НЕ СкладДоИзменения = Объект.Склад Тогда
			СкладПриИзмененииКлиент();
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ДоговорПриИзмененииСервер()
	
	// УстановитьВидЦенНаОснованииДоговора
	
	//сначала берем из карточки пользователя (низший приоритет)
	Объект.ВидЦен = ОбщийМодульСервер.НастройкаПользователя("ВидЦенПроизводство");
	//если задан вид цен в категории контрагента, то берем из него (средний приоритет)
	Если НЕ Объект.Контрагент.Категория.ВидЦен.Пустая() Тогда
		Объект.ВидЦен = Объект.Контрагент.Категория.ВидЦен;
	КонецЕсли;
	//если задан вид цен в договоре, то берем из него (высший приоритет)
	Если ЗначениеЗаполнено(Объект.ДоговорКонтрагента) Тогда		
		ДанныеДоговора = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект.ДоговорКонтрагента, "ВидЦен, СкладОтгрузкиТоваровПоУмолчанию"); 
		Если ЗначениеЗаполнено(ДанныеДоговора.ВидЦен) Тогда
			Объект.ВидЦен = ДанныеДоговора.ВидЦен;
		КонецЕсли;
		
	    // склад
		Если ЗначениеЗаполнено(ДанныеДоговора.СкладОтгрузкиТоваровПоУмолчанию) И НЕ ДанныеДоговора.СкладОтгрузкиТоваровПоУмолчанию = Объект.Склад Тогда
			Объект.Склад = ДанныеДоговора.СкладОтгрузкиТоваровПоУмолчанию;
		КонецЕсли;
	КонецЕсли;
	
	ОбновитьВидимостьИОстаткиВзаиморасчетов();
	
КонецПроцедуры

