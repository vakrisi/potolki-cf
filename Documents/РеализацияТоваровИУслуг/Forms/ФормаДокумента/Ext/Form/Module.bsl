&НаСервере
Процедура УстановитьВидимостьЭлементовПоБонусам()
	
	ЕстьБонусыНачислено = ?((Объект.Товары.Итог("БонусыКНачислению") + Объект.Услуги.Итог("БонусыКНачислению")) > 0 , Истина, Ложь);
	ЕстьБонусыСписано = ?((Объект.Товары.Итог("СкидкаБонусами") + Объект.Услуги.Итог("СкидкаБонусами")) > 0 , Истина, Ложь);
	
	ИспользоватьБонусы = Объект.СлужебныйУчитыватьБонусы ИЛИ Объект.НачислятьБонусы 
										ИЛИ ЕстьБонусыСписано ИЛИ ЕстьБонусыНачислено;  //#6699 
	Элементы.ГруппаБонусы.Видимость = ИспользоватьБонусы;
	
	//#13359
	БонусыСервер.НастройкаЭлементов(Элементы, Объект);
	
	Элементы.ГруппаБонусыНастройки.Видимость = ИспользоватьБонусы;
										
	Элементы.ГруппаБонусыТекущиеДанные.Видимость = Объект.СлужебныйУчитыватьБонусы;
	Элементы.ГруппаДисконтнаяКарта.Видимость = Объект.СлужебныйУчетБонусовПоДисконтнымКартам; //Константы.УчетБонусовПоДисконтнымКартам.Получить();
	
	Элементы.ТоварыСкидкаБонусами.Видимость = Объект.СлужебныйУчитыватьБонусы ИЛИ ЕстьБонусыСписано;
	Элементы.УслугиСкидкаБонусами.Видимость = Объект.СлужебныйУчитыватьБонусы ИЛИ ЕстьБонусыСписано;
		
	Элементы.ТоварыБонусыКНачислению.Видимость = Объект.НачислятьБонусы ИЛИ ЕстьБонусыНачислено;
	Элементы.УслугиБонусыКНачислению.Видимость = Объект.НачислятьБонусы ИЛИ ЕстьБонусыНачислено;
	
	Элементы.СуммаБонусовКНачислениюПоДисконтнойКарте.Видимость = Объект.НачислятьБонусы;
	
	Элементы.ГруппаБонусыТекущиеДанныеСписать.Видимость = Объект.СписыватьБонусы; // №13299
	
КонецПроцедуры

