	//ОбщийМодульСервер.РегулировкаШириныПоляКонтрагента(Элементы, Элементы.Контрагент, Элементы.ПоказатьДополнительнуюИнформацию, Элементы.ЕстьИндивидуальныеЦены);
	
	//Элементы.ЗаполнитьДокументПоЗаказуПокупателя.Видимость = (ТипЗнч(Объект.Основание) = Тип("ДокументСсылка.ЗаказПокупателя") И ЗначениеЗаполнено(Объект.Основание));
	
	//посчитаем сумму документа без учета бонусов
	СуммаДокументаБезУчетаБонусов = 0;
	Для Каждого ТекущаяСтрока Из Объект.Товары Цикл
		СуммаДокументаБезУчетаБонусов = СуммаДокументаБезУчетаБонусов + (ТекущаяСтрока.Количество * ТекущаяСтрока.Цена - ТекущаяСтрока.СуммаРучнойСкидки);
