	КонецЕсли;
		
	//цены на потолки, товары, услуги и услуги кроя задаются в заказе на производство
	Если ТипЗнч(Объект.Основание) = ТипЗнч(Документы.ЗаказНаПроизводство.ПустаяСсылка()) Тогда
		Элементы.ВидЦен.Видимость = Ложь;
