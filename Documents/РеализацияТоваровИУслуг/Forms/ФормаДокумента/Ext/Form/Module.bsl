&НаКлиенте
Процедура ПодборТовары(Команда)
	
	ПараметрыПодбора = Новый Структура;
	ПараметрыПодбора.Вставить("Дата",					Объект.Дата);
	ПараметрыПодбора.Вставить("Организация",			Объект.Организация);
	ПараметрыПодбора.Вставить("Склад",					Объект.Склад);
	ПараметрыПодбора.Вставить("ВидНоменклатуры",		ПолучитьСписокВидовНоменклатурыТовары());
	ПараметрыПодбора.Вставить("ВидЦены",				Объект.ВидЦен);
	ПараметрыПодбора.Вставить("Валюта",					Объект.Валюта);
	ПараметрыПодбора.Вставить("ЗапретРедактированияЦен",ЗапретРедактированияЦен());
	Если ИспользоватьКонтрольКратности Тогда
		ПараметрыПодбора.Вставить("ВидДокументаПроверкиКратности",ПредопределенноеЗначение("Перечисление.ВидыДокументовПроверкиКратности.РеализацияТоваровИУслуг")); //#2792
	КонецЕсли;
	
	ОткрытьФорму("ОбщаяФорма.ФормаПодбораНоменклатуры", ПараметрыПодбора, ЭтаФорма, УникальныйИдентификатор);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПотолокПоОснованию(Команда)
	
	СписокВариантов = ПолучитьСписокПОтолковОснования();
	
	Если СписокВариантов.Количество() = 0 Тогда
		ПоказатьПредупреждение(,"В документах-основаниях нет потолков");
		Возврат;
	КонецЕсли;	
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ВыборПотолкаДляЗаполненияПоОснованию", ЭтаФорма);	
	СписокВариантов.ПоказатьВыборЭлемента(ОписаниеОповещения, "Выберите потолок");
	
КонецПроцедуры

