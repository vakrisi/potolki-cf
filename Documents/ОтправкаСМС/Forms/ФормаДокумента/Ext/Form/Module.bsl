&НаСервере
Процедура ЗаполнитьПолучателейПоГруппеКатегории(ГруппаКонтрагентов, КатегорияКонтрагентов)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	КонтрагентыКонтактнаяИнформация.Ссылка КАК Контрагент,
	|	КонтрагентыКонтактнаяИнформация.Представление КАК НомерТелефона
	|ИЗ
	|	Справочник.Контрагенты.КонтактнаяИнформация КАК КонтрагентыКонтактнаяИнформация
	|ГДЕ
	|	КонтрагентыКонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Телефон)
	|	И КонтрагентыКонтактнаяИнформация.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.ТелефонКонтрагента)
	|	И НЕ КонтрагентыКонтактнаяИнформация.Ссылка.ПометкаУдаления
	|	И КонтрагентыКонтактнаяИнформация.Ссылка.НеОтправлятьСМС = ЛОЖЬ
	|	И ВЫБОР
	|			КОГДА &ФильтроватьПоГруппе
	|				ТОГДА КонтрагентыКонтактнаяИнформация.Ссылка В ИЕРАРХИИ (&ГруппаКонтрагентов)
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|	И ВЫБОР
	|			КОГДА &ФильтроватьПоКатегории
	|				ТОГДА КонтрагентыКонтактнаяИнформация.Ссылка.Категория = &КатегорияКонтрагентов
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ";
	Запрос.УстановитьПараметр("ФильтроватьПоГруппе", ?(ГруппаКонтрагентов = Неопределено, Ложь, Истина));
	Запрос.УстановитьПараметр("ГруппаКонтрагентов", ГруппаКонтрагентов);
	Запрос.УстановитьПараметр("ФильтроватьПоКатегории", ?(КатегорияКонтрагентов = Неопределено, Ложь, Истина));
	Запрос.УстановитьПараметр("КатегорияКонтрагентов", КатегорияКонтрагентов);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = Объект.Получатели.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока,Выборка);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьОсновнойТелефонКонтрагента(Контрагент)
	
	ВидТелефона = Справочники.ВидыКонтактнойИнформации.ТелефонКонтрагента;
		
	Если ТипЗнч(Контрагент) = Тип("СправочникСсылка.Сотрудники") Тогда		
		ВидТелефона = Справочники.ВидыКонтактнойИнформации.ТелефонСотрудника;		
	КонецЕсли;
	
	НомерТелефона = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(Контрагент, ВидТелефона);
	НомерТелефона = СофтФон.ОставитьТолькоЦифры(НомерТелефона);
	
КонецФункции
	
&НаКлиенте
Процедура ПолучателиКонтрагентПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.Получатели.ТекущиеДанные;
	НомерТелефона = ПолучитьОсновнойТелефонКонтрагента(ТекущиеДанные.Контрагент);	
	ТекущиеДанные.НомерТелефона = НомерТелефона;		
	ТекущиеДанные.Сумма = 0;
	
КонецПроцедуры

