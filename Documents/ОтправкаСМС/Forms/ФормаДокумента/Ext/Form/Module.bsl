&НаКлиенте
Процедура ЗаписатьИОтправитьПослеВопроса(Результат, Параметры) Экспорт
	Если Результат = КодВозвратаДиалога.Да Тогда
		Попытка			
			Объект.Отправлено = Истина;
			ЭтаФорма.Записать();			
			ВызватьПроведениеДокумента();
			ЭтаФорма.Закрыть(Объект.Ссылка);
		Исключение
			Объект.Отправлено = Ложь;
			ЭтаФорма.Записать();
		КонецПопытки;
	КонецЕсли;
