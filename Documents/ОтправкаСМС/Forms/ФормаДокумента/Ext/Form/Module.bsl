&НаСервере
Процедура ЗаполнитьПолучателейПоСуммеПродажЗаПериод(ВыбЗнач)
	 Запрос = Новый Запрос;
	 Запрос.Текст = 
	 //++ №6401 закомментировано, т.к. запрос не учитывает суммы возвратов
	 //	ниже новый запрос
	 //
	 //"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	 //|	ПродажиОбороты.Контрагент,
	 //|	ПродажиОбороты.Контрагент.ОсновнойТелефон КАК НомерТелефона,
	 //|	СУММА(ЕСТЬNULL(ПродажиОбороты.СуммаОборот, 0)) КАК Сумма
	 //|ИЗ
	 //|	РегистрНакопления.Продажи.Обороты(, , Регистратор, ) КАК ПродажиОбороты
	 //|ГДЕ
	 //|	ПродажиОбороты.СуммаОборот МЕЖДУ &НачальнаяСумма И &КонечнаяСумма
	 //|	И ПродажиОбороты.Период МЕЖДУ &НачалоПериода И &КонецПериода
	 //|
	 //|СГРУППИРОВАТЬ ПО ПродажиОбороты.Контрагент, ПродажиОбороты.Контрагент.ОсновнойТелефон";
	 
	 "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	 |	ПродажиОбороты.Контрагент КАК Контрагент,
	 |	СУММА(ЕСТЬNULL(ПродажиОбороты.СуммаОборот, 0)) КАК Сумма
	 |	
	 |ПОМЕСТИТЬ ВТ
	 |
	 |ИЗ
	 |	РегистрНакопления.Продажи.Обороты(&НачалоПериода, &КонецПериода, Регистратор, ) КАК ПродажиОбороты
	 |
	 |СГРУППИРОВАТЬ ПО
	 |	ПродажиОбороты.Контрагент
	 |	
	 |;
	 |///////////////////////////////////	
	 |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	 |	ПродажиИтого.Контрагент,
	 |	ПродажиИтого.Сумма
	 |ИЗ
	 |	ВТ КАК ПродажиИтого
	 |ГДЕ
	 |	ПродажиИтого.Сумма МЕЖДУ &НачальнаяСумма И &КонечнаяСумма
	 |	";
	 //-- №6401
	 
	 Запрос.УстановитьПараметр("НачальнаяСумма", ВыбЗнач.НачальнаяСумма);
	 Запрос.УстановитьПараметр("КонечнаяСумма", ВыбЗнач.КонечнаяСумма);
	 Запрос.УстановитьПараметр("НачалоПериода", ВыбЗнач.НачалоПериода);
	 Запрос.УстановитьПараметр("КонецПериода", ВыбЗнач.КонецПериода);
	 
	 Выборка = Запрос.Выполнить().Выбрать();
	 Пока Выборка.Следующий() Цикл
	 	НоваяСтрока = Объект.Получатели.Добавить();
	 	ЗаполнитьЗначенияСвойств(НоваяСтрока,Выборка);
		НоваяСтрока.НомерТелефона = ПолучитьОсновнойТелефонКонтрагента(Выборка.Контрагент);
	 КонецЦикла;
КонецПроцедуры	

