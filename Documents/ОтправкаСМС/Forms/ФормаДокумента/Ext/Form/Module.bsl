&НаКлиенте
Процедура ЗаписатьИОтправить(Команда)
	Доступно = ОбщийМодульКлиент.ПроверитьДоступностиРасширенногоФункционала();
	Если НЕ Доступно Тогда
		Возврат;
	КонецЕсли;
		
	ПроцедураОтправки = Новый ОписаниеОповещения("ЗаписатьИОтправитьПослеВопроса",ЭтотОбъект,Параметры);
	Режим = РежимДиалогаВопрос.ДаНет;
	ПоказатьВопрос(ПроцедураОтправки,"Отправляем СМС?",Режим);
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПоДнюРождения(Команда)	
	
	ДатаРождения = ТекущаяДата();
	ВведеннаяДата = ВвестиДату(ДатаРождения, "Введите дату рождения", ЧастиДаты.Дата);
	Если ВведеннаяДата И ДатаРождения <> Дата(1,1,1) Тогда
		ПослеЗакрытияВопросаОЗаполненииПоДатеРожденияНаСервере(ДатаРождения);
	КонецЕсли;	
	
КонецПроцедуры 

&НаСервере
Процедура ПослеЗакрытияВопросаОЗаполненииПоДатеРожденияНаСервере(ДатаРождения)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	КонтрагентыКонтактнаяИнформация.Ссылка КАК Контрагент,
	|	КонтрагентыКонтактнаяИнформация.Представление КАК НомерТелефона
	|ИЗ
	|	Справочник.Контрагенты.КонтактнаяИнформация КАК КонтрагентыКонтактнаяИнформация
	|ГДЕ
	|	КонтрагентыКонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Телефон)
	|	И КонтрагентыКонтактнаяИнформация.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.ТелефонКонтрагента)
	|	И КонтрагентыКонтактнаяИнформация.Ссылка.ВидКонтрагента = &ВидКонтрагента
	|	И КонтрагентыКонтактнаяИнформация.Ссылка.ДатаРождения = &ДатаРождения
	|	И КонтрагентыКонтактнаяИнформация.Ссылка.ПометкаУдаления = ЛОЖЬ
	|	И КонтрагентыКонтактнаяИнформация.Ссылка.НеОтправлятьСМС = ЛОЖЬ";
	Запрос.УстановитьПараметр("ВидКонтрагента", Перечисления.ВидКонтрагента.ФизЛицо);
	Запрос.УстановитьПараметр("ДатаРождения", ДатаРождения);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = Объект.Получатели.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока,Выборка);
	КонецЦикла;

КонецПроцедуры

