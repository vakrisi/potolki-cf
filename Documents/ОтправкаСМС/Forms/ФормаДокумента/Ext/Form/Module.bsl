	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВзаиморасчетыСКонтрагентамиОстатки.Контрагент КАК Контрагент,
	|	СУММА(ЕСТЬNULL(ВзаиморасчетыСКонтрагентамиОстатки.СуммаОстаток, 0)) КАК Сумма
	|ИЗ
	|	РегистрНакопления.ВзаиморасчетыСКонтрагентами.Остатки КАК ВзаиморасчетыСКонтрагентамиОстатки
	|ГДЕ
	|	ВзаиморасчетыСКонтрагентамиОстатки.СуммаОстаток МЕЖДУ &НачальнаяСумма И &КонечнаяСумма
	|
	|СГРУППИРОВАТЬ ПО
	|	ВзаиморасчетыСКонтрагентамиОстатки.Контрагент";
	Запрос.УстановитьПараметр("НачальнаяСумма", ВыбЗнач.НачальнаяСумма);
	Запрос.УстановитьПараметр("КонечнаяСумма", ВыбЗнач.КонечнаяСумма); 
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = Объект.Получатели.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока,Выборка);
		НоваяСтрока.НомерТелефона = ПолучитьОсновнойТелефонКонтрагента(Выборка.Контрагент);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПоНоменклатуре(Команда)
	ПроцедураПослеВыбора = Новый ОписаниеОповещения("ПослеУказанияНоменклатуры",ЭтотОбъект);
	ПФ = новый Структура("ТипЗаполнения", "ПоНоменклатуре");
	ОткрытьФорму("Документ.ОтправкаСМС.Форма.ФормаЗаполнения", ПФ, ЭтаФорма,,,,ПроцедураПослеВыбора);
КонецПроцедуры

&НаКлиенте
Процедура ПослеУказанияНоменклатуры(ВыбЗнач, Параметры) Экспорт
	Если ВыбЗнач <> Неопределено Тогда
        ЗаполнитьПолучателейПоПроданнойНоменклатуре(ВыбЗнач);
    КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПолучателейПоПроданнойНоменклатуре(ВыбЗнач)
	 Запрос = Новый Запрос;
	 Запрос.Текст = 
	 "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	 |	ПродажиОбороты.Контрагент
	 |ИЗ
	 |	РегистрНакопления.Продажи.Обороты(, , Регистратор, ) КАК ПродажиОбороты
	 |ГДЕ
	 |	ВЫБОР
	 |			КОГДА &Номенклатура = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	 |				ТОГДА ИСТИНА
	 |			ИНАЧЕ ПродажиОбороты.Номенклатура В ИЕРАРХИИ (&Номенклатура)
	 |		КОНЕЦ
	 |	И ВЫБОР
	 |			КОГДА &КатегорияНоменклатуры = ЗНАЧЕНИЕ(Справочник.КатегорияНоменклатуры.ПустаяСсылка)
	 |				ТОГДА ИСТИНА
	 |			ИНАЧЕ ПродажиОбороты.Номенклатура.Категория = &КатегорияНоменклатуры
	 |		КОНЕЦ
	 |	И ПродажиОбороты.Период МЕЖДУ &НачалоПериода И &КонецПериода
	 |
	 |СГРУППИРОВАТЬ ПО
	 |	ПродажиОбороты.Контрагент";
	 Запрос.УстановитьПараметр("НачалоПериода", ВыбЗнач.НачалоПериода);
	 Запрос.УстановитьПараметр("КонецПериода", ВыбЗнач.КонецПериода);
	 Запрос.УстановитьПараметр("Номенклатура", ВыбЗнач.Номенклатура);
	 Запрос.УстановитьПараметр("КатегорияНоменклатуры", ВыбЗнач.КатегорияНоменклатуры); 
	 
	 Выборка = Запрос.Выполнить().Выбрать();
	 Пока Выборка.Следующий() Цикл
	 	НоваяСтрока = Объект.Получатели.Добавить();
	 	ЗаполнитьЗначенияСвойств(НоваяСтрока,Выборка);
		НоваяСтрока.НомерТелефона = ПолучитьОсновнойТелефонКонтрагента(Выборка.Контрагент);
	КонецЦикла;
	
КонецПроцедуры

