&НаКлиенте
Функция  ОпределитьТипСравнения(ТипСравненияПоСтроке)
	
	Результат = ВидСравнения.Равно;
	
	Если ТипСравненияПоСтроке = "В списке" Тогда  		
		Результат = ВидСравнения.ВСписке;
	ИначеЕсли ТипСравненияПоСтроке = "Не в списке" Тогда
		Результат = ВидСравнения.НеВСписке;
	Иначе
		
		Если ТипСравненияПоСтроке = "Не равно" Тогда
			Результат = ВидСравнения.НеРавно;                     
		ИначеЕсли ТипСравненияПоСтроке = "В группе" Тогда
			Результат = ВидСравнения.ВИерархии;
		ИначеЕсли ТипСравненияПоСтроке = "Не в группе" Тогда
			Результат = ВидСравнения.НеВИерархии;
		ИначеЕсли ТипСравненияПоСтроке = "Меньше или равно" Тогда
			Результат = ВидСравнения.МеньшеИлиРавно;
		ИначеЕсли ТипСравненияПоСтроке = "Меньше" Тогда
			Результат = ВидСравнения.Меньше;
		ИначеЕсли ТипСравненияПоСтроке = "Больше или равно" Тогда
			Результат = ВидСравнения.БольшеИлиРавно;
		ИначеЕсли ТипСравненияПоСтроке = "Больше" Тогда
			Результат = ВидСравнения.Больше;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции //  ОпределитьТипСравнения()

