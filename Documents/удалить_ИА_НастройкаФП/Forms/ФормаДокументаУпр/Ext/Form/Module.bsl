&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	// Вставить содержимое обработчика.
	ФППоОрганизациям = Константы.ИА_ФП_ВестиФППоОрганизациям.Получить();
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Если ФППоОрганизациям ТОгда
			Объект.Организация = ИА_НастройкиС.ЗначениеНастройкиТекПользователя(ПланыВидовХарактеристик.ИА_НастройкиПользователей.ОсновнаяОрганизация);
		КонецЕсли;
    КонецЕсли;

	
	ИА_РежимРасчетаСуммыВычисляемоеВыражение = Перечисления.ИА_РежимРасчетаСуммы.ВычисляемоеВыражение;
	ОбновитьОтображениеПоНалБезнал();
	
	Для каждого стр из Объект.ПолитикаРаспределения Цикл
		УстановитьЗначениеПоУмолчаниюВЗначение(стр.НомерСтроки-1,истина,"ПолитикаРаспределения");
	КонецЦикла;
	
	Для каждого стр из Объект.ПолитикаРаспределенияПервичная Цикл
		УстановитьЗначениеПоУмолчаниюВЗначение(стр.НомерСтроки-1,истина,"ПолитикаРаспределенияПервичная");
	КонецЦикла;
	РазделятьНалБезнал = Константы.ИА_ФП_РазделятьНалИБезнал.Получить();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	// Вставить содержимое обработчика.
	Элементы.Организация.Видимость = ФППоОрганизациям;
	Модифицированность = Ложь;
	
	Элементы.ПолитикаРаспределения.ПодчиненныеЭлементы.ПолитикаРаспределенияЗначениеНал.Видимость = РазделятьНалБезнал;
	Элементы.ПолитикаРаспределения.ПодчиненныеЭлементы.ПолитикаРаспределенияЗначениеБезнал.Видимость = РазделятьНалБезнал;
	Элементы.ПолитикаРаспределения.ПодчиненныеЭлементы.ПолитикаРаспределенияЗначение.Видимость = не РазделятьНалБезнал;
	
	Элементы.ПолитикаРаспределенияПервичная.ПодчиненныеЭлементы.ПолитикаРаспределенияПервичнаяЗначениеНал.Видимость = РазделятьНалБезнал;
	Элементы.ПолитикаРаспределенияПервичная.ПодчиненныеЭлементы.ПолитикаРаспределенияПервичнаяЗначениеБезнал.Видимость = РазделятьНалБезнал;
	Элементы.ПолитикаРаспределенияПервичная.ПодчиненныеЭлементы.ПолитикаРаспределенияПервичнаяЗначение.Видимость = не РазделятьНалБезнал; 	
	
	УстановитьДоступностьЭлементов();
	ВосстановитьНастройкиСервер(КомпоновщикНастроек); 
	
КонецПроцедуры

&НаСервере
Функция ВосстановитьНастройкиСервер(КомпоновщикНастроек)

	Об = РеквизитФормыВЗначение("Объект");
	Об.ВосстановитьНастройки(КомпоновщикНастроек);
	
КонецФункции // ВосстановитьНастройкиСервер()


