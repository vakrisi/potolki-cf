
&НаСервере
Процедура УстановитьЗначениеПоУмолчаниюВЗначение(НСтрока, начальноеЗаполнение = Ложь,ИмяТаб)
	ОбъектЗн = РеквизитФормыВЗначение("Объект");
	Если ИмяТаб = "ПолитикаРаспределения" Тогда
		пСтрока = ОбъектЗн.ПолитикаРаспределения[НСтрока];
	Иначе
		пСтрока = ОбъектЗн.ПолитикаРаспределенияПервичная[НСтрока];
	КонецЕсли;
	Если пстрока.РежимРасчета = Перечисления.ИА_РежимРасчетаСуммы.Процент Тогда
		Если начальноеЗаполнение тогда			
			Если не ЗначениеЗаполнено(пстрока.Значение) Тогда
				пстрока.Значение = 0;
			КонецЕсли;
			Если не ЗначениеЗаполнено(пстрока.ЗначениеБезнал) Тогда
				пстрока.ЗначениеБезнал = 0;
			КонецЕсли;
		Иначе
			пстрока.Значение = 0;
			пстрока.ЗначениеБезнал = 0;
		КонецЕсли;
	ИначеЕсли пстрока.РежимРасчета = Перечисления.ИА_РежимРасчетаСуммы.ВычисляемоеВыражение Тогда
		Если начальноеЗаполнение тогда			
			Если не ЗначениеЗаполнено(пстрока.Значение) Тогда
				пстрока.Значение = "";
			КонецЕсли;
			Если не ЗначениеЗаполнено(пстрока.ЗначениеБезнал) Тогда
				пстрока.ЗначениеБезнал = "";
			КонецЕсли;
		Иначе
			пстрока.Значение = "";
			пстрока.ЗначениеБезнал = "";
		КонецЕсли;
	ИначеЕсли пстрока.РежимРасчета = Перечисления.ИА_РежимРасчетаСуммы.ФиксированнаяСумма Тогда
		Если начальноеЗаполнение тогда			
			Если не ЗначениеЗаполнено(пстрока.Значение) Тогда
				пстрока.Значение = 0;
			КонецЕсли;
			Если не ЗначениеЗаполнено(пстрока.ЗначениеБезнал) Тогда
				пстрока.ЗначениеБезнал = 0;
			КонецЕсли;
		Иначе
			пстрока.Значение = 0;
			пстрока.ЗначениеБезнал = 0;
		КонецЕсли;
	ИначеЕсли пстрока.РежимРасчета = Перечисления.ИА_РежимРасчетаСуммы.РучнойВвод Тогда
		Если начальноеЗаполнение тогда			
			Если не ЗначениеЗаполнено(пстрока.Значение) Тогда
				пстрока.Значение = 0;
			КонецЕсли;
			Если не ЗначениеЗаполнено(пстрока.ЗначениеБезнал) Тогда
				пстрока.ЗначениеБезнал = 0;
			КонецЕсли;
		Иначе
			пстрока.Значение = 0;
			пстрока.ЗначениеБезнал = 0;
		КонецЕсли;
	КонецЕсли;
	ЗначениеВРеквизитФормы(ОбъектЗн,"Объект");
КонецПроцедуры

