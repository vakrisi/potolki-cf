&НаКлиенте
Процедура ПолитикаРаспределенияЗначениеНалНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	// Вставить содержимое обработчика.
	тд =  Этаформа.ТекущийЭлемент.ТекущиеДанные;
	Если тд.РежимРасчета = ИА_РежимРасчетаСуммыВычисляемоеВыражение Тогда
		СтандартнаяОбработка = Ложь;
		Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
			Режим = РежимДиалогаВопрос.ДаНет;
			Ответ = Вопрос("Необходимо записать документ. Записать?", Режим, 0);
			Если Ответ=КодВозвратаДиалога.Да Тогда
				Записать();
			Иначе
				Возврат;
			КонецЕсли;
		КонецЕсли;
		фРед = ПолучитьФорму("Документ.удалить_ИА_НастройкаФП.Форма.КонструкторВыраженияУпр",,ЭтаФорма);
		фРед.ВыбПодразделение = тд.Подразделение; 
		фРед.ВыбФонд = тд.Фонд;
		фРед.Выбраздел = тд.Раздел;
		фРед.ИмяЗаполняемогоПоля = "Значение";
		фРед.Организация = Объект.Организация;                 
		фРед.ДокНастройки = Объект.Ссылка;                 
		фРед.ПолеФормула = Элемент.ТекстРедактирования;
		фРед.Открыть();
	КонецЕсли;
КонецПроцедуры

