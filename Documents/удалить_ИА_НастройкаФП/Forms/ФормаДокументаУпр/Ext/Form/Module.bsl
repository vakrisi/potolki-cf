&НаСервереБезКонтекста
Функция РазбитьСтрокуНаМассив(Знач ИсходнаяСтрока, Разделитель)
	
	мас = Новый Массив;
	НачНомер = 1;
	Позиция = 1;
	Если Найти(ИсходнаяСтрока, Разделитель) = 0 Тогда
		мас.Добавить(ИсходнаяСтрока);
		Возврат мас;
	КонецЕсли;
	
	Пока Истина Цикл
		Позиция = Найти(ИсходнаяСтрока, Разделитель);
		Если Позиция = 0 Тогда
			Прервать;
		КонецЕсли;	
		НовСтр = Сред(ИсходнаяСтрока, НачНомер, Позиция-1);
		мас.Добавить(СокрЛП(НовСтр));
		ИсходнаяСтрока = Прав(ИсходнаяСтрока, СтрДлина(ИсходнаяСтрока) - Позиция);
		
	КонецЦикла; 	
	
	Возврат мас;
	
КонецФункции // РазбитьСтрокуНаМассив()

