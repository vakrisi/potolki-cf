&НаСервере
Процедура СформироватьСписокЗначенийПараметра(ВидДохода, Параметр, ЗначенияПараметров, КлючСписка, ТипОплаты)
	
	ВременнаяТаблица = Объект.СпискиЗначенийПараметров.Выгрузить();
	Объект.СпискиЗначенийПараметров.Очистить();
	Для Каждого ТекСтрока Из ВременнаяТаблица Цикл
		Если НЕ (ТекСтрока.ВидДохода = ВидДохода 
			И ТекСтрока.Параметр = Параметр 
			И ТекСтрока.ТипОплаты = ТипОплаты
			И ТекСтрока.КлючСписка = КлючСписка) Тогда
			НоваяСтрока = Объект.СпискиЗначенийПараметров.Добавить();
			НоваяСтрока.ВидДохода	 = ТекСтрока.ВидДохода;
			НоваяСтрока.Параметр	 = ТекСтрока.Параметр;
			НоваяСтрока.Значение	 = ТекСтрока.Значение;
			НоваяСтрока.КлючСписка	 = ТекСтрока.КлючСписка;
			НоваяСтрока.ТипОплаты	 = ?(ЗначениеЗаполнено(ТекСтрока.ТипОплаты), ТекСтрока.ТипОплаты, ТипОплаты);
		КонецЕсли;
	КонецЦикла;
	
	Если ЗначенияПараметров = Неопределено Тогда
		Возврат;
	КонецЕсли;	
	
	Для Каждого ТекЗначение Из ЗначенияПараметров Цикл
		НоваяСтрока = Объект.СпискиЗначенийПараметров.Добавить();
		НоваяСтрока.ВидДохода	 = ВидДохода;
		НоваяСтрока.Параметр	 = Параметр;
		НоваяСтрока.Значение	 = ТекЗначение.Значение;
		НоваяСтрока.КлючСписка	 = КлючСписка;
		НоваяСтрока.ТипОплаты	 = ТипОплаты;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьСписокЗначенийПараметра(ВидДохода, Параметр, ТипОплаты, КлючСписка)
	//ИА_20160304
	СписокПараметров = Новый СписокЗначений;
	
	Для Каждого ТекСтрока Из Объект.СпискиЗначенийПараметров Цикл
		Если ТекСтрока.ВидДохода = ВидДохода 
			И ТекСтрока.Параметр = Параметр
			И (ТекСтрока.ТипОплаты = ТипОплаты ИЛИ НЕ ЗначениеЗаполнено(ТекСтрока.ТипОплаты))
			И ТекСтрока.КлючСписка = КлючСписка Тогда
			СписокПараметров.Добавить(ТекСтрока.Значение);			
		КонецЕсли;
	КонецЦикла;
	
	Возврат СписокПараметров;
	
КонецФункции

&НаКлиенте
Процедура Печать(Команда)
	ТабДок = ПечатьНастройкиНаСервере();
	ТабДок.Показать();;
КонецПроцедуры

&НаСервере
Функция ПечатьНастройкиНаСервере()
	Макет = РеквизитФормыВЗначение("Объект").ПолучитьМакет("ПолитикаФП");
	
	ТабДок = Новый ТабличныйДокумент;
	ТабДок.АвтоМасштаб = Истина;
	
	
	ОбластьШапка1 			= Макет.ПолучитьОбласть("Шапка1");
	ОбластьШапка2 			= Макет.ПолучитьОбласть("Шапка2");
	ОбластьСтрокаВидДохода	= Макет.ПолучитьОбласть("СтрокаВидДохода");
	ОбластьСтрокаТаб2 		= Макет.ПолучитьОбласть("СтрокаТаб2");		
	ОбластьПодвал			= Макет.ПолучитьОбласть("Подвал");
	
	ТабДок.Очистить();
	
	ОбластьШапка1.Параметры.Заголовок = "Политика по распределению денежных средств";
	ОбластьШапка1.Параметры.Организация  = Объект.Организация;
	ОбластьШапка1.Параметры.Дата 		= Объект.Дата;
	ТабДок.Вывести(ОбластьШапка1);
	
	Для каждого Строка Из Объект.Доходы Цикл
		ОбластьСтрокаВидДохода.Параметры.Номер 					= Строка.НомерСтроки;
		ОбластьСтрокаВидДохода.Параметры.ВидДохода              = Строка.ВидДохода;
		ОбластьСтрокаВидДохода.Параметры.ВариантПолученияДанных = Строка.ВидПолученияДанных;	
		Если Строка.ВидПолученияДанных = Перечисления.ИА_ВариантыПолученияДанныхВидыДоходов.Запрос Тогда
			ОбластьСтрокаВидДохода.Параметры.Значение               = "<Запрос>";
		ИначеЕсли Строка.ВидПолученияДанных = Перечисления.ИА_ВариантыПолученияДанныхВидыДоходов.ДвиженияДС Тогда
			ОбластьСтрокаВидДохода.Параметры.Значение               = Строка.ТекстВыраженияЗапросаБезнал;
		ИначеЕсли Строка.ВидПолученияДанных = Перечисления.ИА_ВариантыПолученияДанныхВидыДоходов.Вручную Тогда
			ОбластьСтрокаВидДохода.Параметры.Значение               = "";
		КонецЕсли;
		ТабДок.Вывести(ОбластьСтрокаВидДохода);
	КонецЦикла;
	
	ОбластьШапка2.Параметры.НазваниеТаблицы = "Статьи расходов, на которые будет распределяться сумма к распределению:";
	ТабДок.Вывести(ОбластьШапка2);
	
	Для каждого Строка Из Объект.ПолитикаРаспределенияПервичная Цикл
		ОбластьСтрокаТаб2.Параметры.Раздел 					= Строка.Раздел;
		ОбластьСтрокаТаб2.Параметры.Подразделение          	= Строка.Подразделение;
		ОбластьСтрокаТаб2.Параметры.Фонд 					= Строка.Фонд;	
		ОбластьСтрокаТаб2.Параметры.РежимРасчета           	= Строка.РежимРасчета;
		ОбластьСтрокаТаб2.Параметры.Наличные               	= Строка.Значение;
		ОбластьСтрокаТаб2.Параметры.Значение               	= Строка.ЗначениеБезнал;
		ОбластьСтрокаТаб2.Параметры.ПроцентРаздела         	= Строка.ПроцентОтИтогаРаздела;
		ОбластьСтрокаТаб2.Параметры.Комментарий            	= Строка.Комментарий;
		ТабДок.Вывести(ОбластьСтрокаТаб2);
	КонецЦикла;
	
	ОбластьШапка2.Параметры.НазваниеТаблицы = "Статьи расходов, на которые будет распределяться маржинальная прибыль:";
	ТабДок.Вывести(ОбластьШапка2);
	
	Для каждого Строка Из Объект.ПолитикаРаспределения Цикл
		ОбластьСтрокаТаб2.Параметры.Раздел 					= Строка.Раздел;
		ОбластьСтрокаТаб2.Параметры.Подразделение          	= Строка.Подразделение;
		ОбластьСтрокаТаб2.Параметры.Фонд 					= Строка.Фонд;	
		ОбластьСтрокаТаб2.Параметры.РежимРасчета           	= Строка.РежимРасчета;
		ОбластьСтрокаТаб2.Параметры.Наличные               	= Строка.Значение;
		ОбластьСтрокаТаб2.Параметры.Значение               	= Строка.ЗначениеБезнал;
		ОбластьСтрокаТаб2.Параметры.ПроцентРаздела         	= Строка.ПроцентОтИтогаРаздела;
		ОбластьСтрокаТаб2.Параметры.Комментарий            	= Строка.Комментарий;
		ТабДок.Вывести(ОбластьСтрокаТаб2);
	КонецЦикла;
	
	ТабДок.Вывести(ОбластьПодвал);	
	
	
	Возврат ТабДок;	
	
КонецФункции


&НаКлиенте
Процедура ВидПолученияДанныхОткрытие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ТекущаяСтрокаДоходов  =  Элемент.Родитель.ТекущиеДанные;
	
	Если ТекущаяСтрокаДоходов = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ВидПолученияДанных    = Этаформа.ТекущийЭлемент.ТекущиеДанные.ВидПолученияДанных;
	
	Если ВидПолученияДанных = ПредопределенноеЗначение("Перечисление.ИА_ВариантыПолученияДанныхВидыДоходов.Вручную") Тогда
		Возврат;
	КонецЕсли;	
	
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Режим = РежимДиалогаВопрос.ДаНет;
		Если Вопрос("Необходимо записать документ. Записать?", Режим, 0) = КодВозвратаДиалога.Да Тогда
			Записать();
		Иначе
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	
	ВидДохода             = ТекущаяСтрокаДоходов.ВидДохода;	
	Парам = Новый Структура;
	Парам.Вставить("ИмяРегистраБезнал", ТекущаяСтрокаДоходов.ИмяРегистраБезнал);
	Парам.Вставить("ПредставлениеРегистраБезнал", ТекущаяСтрокаДоходов.ТекстВыраженияЗапросаБезнал);
	Парам.Вставить("РесурсРегистраБезнал", ТекущаяСтрокаДоходов.РесурсРегистраБезНал);
	Парам.Вставить("ПолеСтатьяДДСБезнал", ТекущаяСтрокаДоходов.ПолеСтатьяДДСБезнал);
	
	Парам.Вставить("ИмяРегистраНал", ТекущаяСтрокаДоходов.ИмяРегистраНал);
	Парам.Вставить("ПредставлениеРегистраНал", ТекущаяСтрокаДоходов.ТекстВыраженияЗапросаНал);
	Парам.Вставить("РесурсРегистраНал", ТекущаяСтрокаДоходов.РесурсРегистраНал);
	Парам.Вставить("ПолеСтатьяДДСНал", ТекущаяСтрокаДоходов.ПолеСтатьяДДСНал);
	
	ФормаКонструктора = ПолучитьФорму("Документ.удалить_ИА_НастройкаФП.Форма.КонструкторВидДоходаУпр",Парам);
	
	ФормаКонструктора.РежимКонструктора  = ВидПолученияДанных;
	ФормаКонструктора.РазделятьНалБезнал = РазделятьНалБезнал;
	
	Если ВидПолученияДанных = ПредопределенноеЗначение("Перечисление.ИА_ВариантыПолученияДанныхВидыДоходов.ДвиженияДС") Тогда
		
		//ФормаКонструктора.ИмяРегистраБезнал           = ТекущаяСтрокаДоходов.ИмяРегистраБезнал;
		//ФормаКонструктора.ПредставлениеРегистраБезнал = ТекущаяСтрокаДоходов.ТекстВыраженияЗапросаБезнал;
		//ФормаКонструктора.РесурсРегистраБезнал        = ТекущаяСтрокаДоходов.РесурсРегистраБезНал;
		//ФормаКонструктора.ПолеСтатьяДДСБезнал         = ТекущаяСтрокаДоходов.ПолеСтатьяДДСБезнал;
		
		//ФормаКонструктора.ИмяРегистраНал              = ТекущаяСтрокаДоходов.ИмяРегистраНал;
		//ФормаКонструктора.ПредставлениеРегистраНал    = ТекущаяСтрокаДоходов.ТекстВыраженияЗапросаНал;
		//ФормаКонструктора.РесурсРегистраНал           = ТекущаяСтрокаДоходов.РесурсРегистраНал;
		//ФормаКонструктора.ПолеСтатьяДДСНал 
		
		Для каждого ТекСтрокаПараметров из Объект.ПараметрыВыраженияЗапроса Цикл
			
			Если НЕ ТекСтрокаПараметров.ВидДохода = ВидДохода Тогда
				Продолжить;
			КонецЕсли;
			
			Если НЕ ТекСтрокаПараметров.ВидПолученияДанных = ВидПолученияДанных Тогда
				Продолжить;
			КонецЕсли;
			
			Если ТекСтрокаПараметров.ТипОплаты = ПредопределенноеЗначение("Перечисление.ИА_ТипДвиженияДенежныхСредств.Безналичные") Тогда
				НоваяСрокаПараметров = ФормаКонструктора.ПараметрыДвиженияДСБезнал.Добавить();
			Иначе
				НоваяСрокаПараметров = ФормаКонструктора.ПараметрыДвиженияДСНал.Добавить();
			КонецЕсли;
			
			НоваяСрокаПараметров.Параметр 		    = ТекСтрокаПараметров.Параметр;
			
			Если Найти(ВРЕГ(ТекСтрокаПараметров.ТипСравнения),"СПИСКЕ")>0 Тогда
				//ИА_20160304
				НоваяСрокаПараметров.Значение 		= ПолучитьСписокЗначенийПараметра(ВидДохода, ТекСтрокаПараметров.Параметр, ТекСтрокаПараметров.ТипОплаты, ТекСтрокаПараметров.КлючСписка);
			Иначе	
				НоваяСрокаПараметров.Значение 		= ТекСтрокаПараметров.Значение;
			КонецЕсли;
			
			НоваяСрокаПараметров.ТипСравнения    	= ОпределитьТипСравнения(ТекСтрокаПараметров.ТипСравнения);
			
		КонецЦикла;
		
		
	ИначеЕсли ВидПолученияДанных = ПредопределенноеЗначение("Перечисление.ИА_ВариантыПолученияДанныхВидыДоходов.Запрос") Тогда
		
		
		ФормаКонструктора.ТекстЗапросаБезнал = ТекущаяСтрокаДоходов.ТекстВыраженияЗапросаБезнал;
		ФормаКонструктора.ТекстЗапросаНал    = ТекущаяСтрокаДоходов.ТекстВыраженияЗапросаНал;
		
		Для каждого ТекСтрокаПараметров из Объект.ПараметрыВыраженияЗапроса Цикл
			
			Если НЕ ТекСтрокаПараметров.ВидДохода = ВидДохода Тогда
				Продолжить;
			КонецЕсли;
			
			Если НЕ ТекСтрокаПараметров.ВидПолученияДанных = ВидПолученияДанных Тогда
				Продолжить;
			КонецЕсли;
			
			Если ТекСтрокаПараметров.ТипОплаты = ПредопределенноеЗначение("Перечисление.ИА_ТипДвиженияДенежныхСредств.Безналичные") Тогда
				НоваяСрокаПараметров = ФормаКонструктора.ПараметрыЗапросаБезнал.Добавить();
			Иначе
				НоваяСрокаПараметров = ФормаКонструктора.ПараметрыЗапросаНал.Добавить();
			КонецЕсли;
			
			НоваяСрокаПараметров.Параметр 		    = ТекСтрокаПараметров.Параметр;
			
			Если Найти(ВРЕГ(ТекСтрокаПараметров.ТипСравнения),"СПИСКЕ")>0 Тогда
				//ИА_20160304
				НоваяСрокаПараметров.Значение 		= ПолучитьСписокЗначенийПараметра(ВидДохода, ТекСтрокаПараметров.Параметр, ТекСтрокаПараметров.ТипОплаты, ТекСтрокаПараметров.КлючСписка)
			Иначе	
				НоваяСрокаПараметров.Значение 		= ТекСтрокаПараметров.Значение;
			КонецЕсли;
			
			
		КонецЦикла;
	КонецЕсли;
	
	Результат = ФормаКонструктора.ОткрытьМодально(); 
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;	
	
	Если ТекущаяСтрокаДоходов.ВидПолученияДанных = ПредопределенноеЗначение("Перечисление.ИА_ВариантыПолученияДанныхВидыДоходов.Запрос") Тогда	
		ТекущаяСтрокаДоходов.ТекстВыраженияЗапросаБезнал = СокрЛП(Результат.ТекстЗапросаБезнал);
		ТекущаяСтрокаДоходов.ТекстВыраженияЗапросаНал    = СокрЛП(Результат.ТекстЗапросаНал);
	Иначе	
		ТекущаяСтрокаДоходов.ТекстВыраженияЗапросаБезнал = СокрЛП(Результат.ПредставлениеРегистраБезнал);
		ТекущаяСтрокаДоходов.ТекстВыраженияЗапросаНал    = СокрЛП(Результат.ПредставлениеРегистраНал);
		ТекущаяСтрокаДоходов.ИмяРегистраБезнал           = Результат.ИмяРегистраБезнал;	
		ТекущаяСтрокаДоходов.РесурсРегистраБезНал        = Результат.РесурсРегистраБезнал;
		ТекущаяСтрокаДоходов.ИмяРегистраНал		         = Результат.ИмяРегистраНал; 
		ТекущаяСтрокаДоходов.РесурсРегистраНал   		 = Результат.РесурсРегистраНал;  
		ТекущаяСтрокаДоходов.ПолеСтатьяДДСБезнал   		 = Результат.ПолеСтатьяДДСБезнал;  
		ТекущаяСтрокаДоходов.ПолеСтатьяДДСНал   		 = Результат.ПолеСтатьяДДСНал;  
	КонецЕсли;
	
	ВременнаяПараметрыВыраженияЗапроса.Очистить();
	Для каждого СтрокаПараметров из Объект.ПараметрыВыраженияЗапроса Цикл
		СтрокаВременныхПараметров = ВременнаяПараметрыВыраженияЗапроса.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаВременныхПараметров,СтрокаПараметров);
	КонецЦикла; 
	
	Объект.ПараметрыВыраженияЗапроса.Очистить();        	
	Для Каждого ТекСтрока Из ВременнаяПараметрыВыраженияЗапроса Цикл
		
		Если  ТекСтрока.ВидДохода = ВидДохода И
			ТекСтрока.ВидПолученияДанных = ВидПолученияДанных  Тогда
			Продолжить;
		КонецЕсли;
		
		//ИА_20160304
		НоваяСтрока = Объект.ПараметрыВыраженияЗапроса.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока,ТекСтрока);
				
	КонецЦикла;
	
	КлючСписка = 0;
	
	//ИА_20160304
	//Удаляем все строки тек. вида дохода чтобы дальше актуально их заполнить
	Кол = Объект.СпискиЗначенийПараметров.Количество();
	СпискиЗначений = Объект.СпискиЗначенийПараметров;
	Для Сч = 1 По Кол Цикл
		Стр = СпискиЗначений[Кол - Сч];
		Если Стр.ВидДохода = ВидДохода Тогда 
			СпискиЗначений.Удалить(Стр);
		КонецЕсли;
	КонецЦикла;
	
	Для каждого ТекСтрокаБезнал из Результат.ПараметрыЗапросаБезнал Цикл
		
		КлючСписка = КлючСписка + 1;
		НоваяСтрока = Объект.ПараметрыВыраженияЗапроса.Добавить();
		НоваяСтрока.ВидДохода          = ВидДохода;
		НоваяСтрока.ТипОплаты          = ПредопределенноеЗначение("Перечисление.ИА_ТипДвиженияДенежныхСредств.Безналичные");
		НоваяСтрока.ВидПолученияДанных = ВидПолученияДанных;
		НоваяСтрока.Параметр           = ТекСтрокаБезнал.Параметр;
		
		Если НЕ ТекущаяСтрокаДоходов.ВидПолученияДанных = ПредопределенноеЗначение("Перечисление.ИА_ВариантыПолученияДанныхВидыДоходов.Запрос") Тогда	
			Если Найти(ВРЕГ(ТекСтрокаБезнал.ТипСравнения),"СПИСКЕ")>0 Тогда
				//ИА_20160304
				СформироватьСписокЗначенийПараметра(ВидДохода, НоваяСтрока.Параметр, ТекСтрокаБезнал.Значение,КлючСписка, НоваяСтрока.ТипОплаты);
				НоваяСтрока.КлючСписка	= КлючСписка;
			КонецЕсли;
			НоваяСтрока.ТипСравнения    = ТекСтрокаБезнал.ТипСравнения;
		КонецЕсли;
		НоваяСтрока.Значение 		    = ТекСтрокаБезнал.Значение;
		
	КонецЦикла;
	
	Для каждого ТекСтрокаНал из Результат.ПараметрыЗапросаНал Цикл
		
		КлючСписка = КлючСписка + 1;
		НоваяСтрока = Объект.ПараметрыВыраженияЗапроса.Добавить();
		НоваяСтрока.ВидДохода  = ВидДохода;
		НоваяСтрока.ТипОплаты  = ПредопределенноеЗначение("Перечисление.ИА_ТипДвиженияДенежныхСредств.Наличные");
		НоваяСтрока.ВидПолученияДанных = ВидПолученияДанных;
		НоваяСтрока.Параметр           = ТекСтрокаНал.Параметр;
		
		Если НЕ ТекущаяСтрокаДоходов.ВидПолученияДанных = ПредопределенноеЗначение("Перечисление.ИА_ВариантыПолученияДанныхВидыДоходов.Запрос") Тогда	
			Если Найти(ВРЕГ(ТекСтрокаНал.ТипСравнения),"СПИСКЕ")>0 Тогда
				//ИА_20160304
				СформироватьСписокЗначенийПараметра(ВидДохода, НоваяСтрока.Параметр, ТекСтрокаНал.Значение,КлючСписка, НоваяСтрока.ТипОплаты);
				НоваяСтрока.КлючСписка	= КлючСписка;
			КонецЕсли;                   			
			НоваяСтрока.ТипСравнения    = ТекСтрокаНал.ТипСравнения;  
		КонецЕсли;
		НоваяСтрока.Значение 		= ТекСтрокаНал.Значение;
		
	КонецЦикла;
	
	//ИА_20160304
	Для Каждого Стр Из Объект.СпискиЗначенийПараметров Цикл
		Если Не ЗначениеЗаполнено(Стр.ТипОплаты) Тогда
			Стр.ТипОплаты = ПредопределенноеЗначение("Перечисление.ИА_ТипДвиженияДенежныхСредств.Безналичные");
		КонецЕсли;
	КонецЦикла;
	СвернутьПараметрыСписков();
		
	
КонецПроцедуры

