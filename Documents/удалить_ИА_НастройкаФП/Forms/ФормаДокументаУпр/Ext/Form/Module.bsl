&НаСервереБезКонтекста
Функция ПолучитьСтруктуруТиповДанных(Источник)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 Источник323.*
					|ИЗ
					|	" + Источник + " КАК Источник323";
					
	тз = Запрос.Выполнить().Выгрузить();
	
	Струк = Новый Структура("Контрагент, Статья, Сумма, Дата",);
	масКонтрагент = Новый Массив;
	масСтатья = Новый Массив;
	масСумма = Новый Массив;
	масДата = Новый Массив;
	Для каждого колонка Из тз.Колонки Цикл
	
		Если Колонка.ТипЗначения.СодержитТип(Тип("СправочникСсылка.Контрагенты")) Тогда
			масКонтрагент.Добавить(Колонка.Имя);
		ИначеЕсли Колонка.ТипЗначения.СодержитТип(Тип("СправочникСсылка.СтатьиДвиженияДенежныхСредств")) Тогда
			масСтатья.Добавить(Колонка.Имя);
		ИначеЕсли Колонка.ТипЗначения.СодержитТип(Тип("Число")) Тогда
			масСумма.Добавить(Колонка.Имя);
		ИначеЕсли Колонка.ТипЗначения.СодержитТип(Тип("Дата")) Тогда
			масСумма.Добавить(Колонка.Имя);
		КонецЕсли;	
	
	КонецЦикла; 
	
	Струк.Вставить("Контрагент", масКонтрагент);
	Струк.Вставить("Статья", масСтатья);
	Струк.Вставить("Сумма", масСумма);
	Струк.Вставить("Дата", масДата);
	
	Возврат Струк;
	
КонецФункции // ПолучитьСтруктуруТиповДанных()

