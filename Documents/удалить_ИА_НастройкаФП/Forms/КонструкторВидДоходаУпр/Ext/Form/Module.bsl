&НаКлиенте
Процедура ЗаполнитьСписокВыбораРесурсРегистраБезнал(Элемент, СтандартнаяОбработка)
	Элемент.СписокВыбора.Очистить();
    ИмяГруппы = Элемент.Родитель.Имя;
	
	ПостФикс   = "Безнал";	
	
	Если ИмяГруппы = "ГруппаВыражениеНаличные" Тогда		
		ПостФикс   = "Нал";
	ИначеЕсли ИмяГруппы = "ГруппаВыражениеБезналичные" Тогда 
		ПостФикс   = "Безнал";
	КонецЕсли;
	Если НЕ ПредставлениеРегистраБезНал = Неопределено И
		 НЕ ИмяРегистраБезнал = "" Тогда
		Элемент.СписокВыбора.ЗагрузитьЗначения(ИА_ФП.ПолучитьСписокРеквизитов(ЭтаФорма["ИмяРегистра"+ПостФикс], "Ресурсы"));
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокВыбораВПолях()
	ПостФиксРеквизита = "Безнал";
	ПостФиксЭлемента = "";
	ОбработатьСпискиДляПолей("РесурсРегистра",ПостФиксРеквизита,ПостФиксЭлемента,"Ресурсы");
	ОбработатьСпискиДляПолей("ПолеСтатьяДДС",ПостФиксРеквизита,ПостФиксЭлемента,"Измерения");
	
	Если РазделятьНалБезнал Тогда
		ПостФиксРеквизита = "Безнал";
		ПостФиксЭлемента = "Безнал";
		ОбработатьСпискиДляПолей("РесурсРегистра",ПостФиксРеквизита,ПостФиксЭлемента,"Ресурсы");
		ОбработатьСпискиДляПолей("ПолеСтатьяДДС",ПостФиксРеквизита,ПостФиксЭлемента,"Измерения");
		
		ПостФиксРеквизита = "Нал";
		ПостФиксЭлемента = "Нал";
		ОбработатьСпискиДляПолей("РесурсРегистра",ПостФиксРеквизита,ПостФиксЭлемента,"Ресурсы");
		ОбработатьСпискиДляПолей("ПолеСтатьяДДС",ПостФиксРеквизита,ПостФиксЭлемента,"Измерения");
	КонецЕсли;
