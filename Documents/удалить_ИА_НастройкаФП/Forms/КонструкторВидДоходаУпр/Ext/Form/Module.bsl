&НаСервере
Процедура ОбработатьСпискиДляПолей(ИмяПоля, ПостФиксРеквизита,ПостФиксЭлемента, ВидРеквизита)
	ТекЭлемент = Элементы[ИмяПоля + ПостФиксЭлемента];
	ТекЭлемент.СписокВыбора.Очистить();
	
	ЗначениеПоляРегистр 			= ЭтаФорма["ИмяРегистра" + ПостФиксРеквизита];
	ПредставлениеЗначенияПоляРегистр= ЭтаФорма["ПредставлениеРегистра" + ПостФиксРеквизита];	
	
	Если НЕ ПредставлениеЗначенияПоляРегистр = Неопределено И
		 НЕ ЗначениеПоляРегистр = "" Тогда
		ТекЭлемент.СписокВыбора.ЗагрузитьЗначения(ИА_ФП.ПолучитьСписокРеквизитов(ЗначениеПоляРегистр, ВидРеквизита));
	КонецЕсли;
КонецПроцедуры
