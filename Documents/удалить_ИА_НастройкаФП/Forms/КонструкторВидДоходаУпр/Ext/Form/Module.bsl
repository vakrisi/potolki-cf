	Элементы.ГруппаЗапросы.Видимость           = РежимКонструктора = ПредопределенноеЗначение("Перечисление.ИА_ВариантыПолученияДанныхВидыДоходов.Запрос");
	
	Элементы.ГруппаЗапросБезналичные.Видимость = РазделятьНалБезнал;
	Элементы.ГруппаЗапросНаличные.Видимость    = РазделятьНалБезнал;
	Элементы.ГруппаЗапрос.Видимость            = НЕ РазделятьНалБезнал;
	
	Элементы.ГруппаВыражениеБезналичные.Видимость = РазделятьНалБезнал;
	Элементы.ГруппаВыражениеНаличные.Видимость    = РазделятьНалБезнал;
	Элементы.ГруппаВыражение.Видимость            = НЕ РазделятьНалБезнал;
	
КонецПроцедуры

&НаСервере
Функция ЗаполнитьПараметрыЗапросаНаСервере(ПостФикс)
	
	СтруктураПараметров = Новый Структура();
	ТекущийТекстЗапроса = ЭтаФорма["ТекстЗапроса"+ПостФикс];
	
	Если  НЕ (ТекущийТекстЗапроса) = "" Тогда
		Запрос = Новый Запрос(ТекущийТекстЗапроса);
		Попытка
			НайденныеПараметры = Запрос.НайтиПараметры();
		Исключение
			Возврат ОписаниеОшибки();
		КонецПопытки;
		Для каждого ПараметрЗапроса из НайденныеПараметры Цикл
			СтруктураПараметров.Вставить(ПараметрЗапроса.Имя, ПараметрЗапроса.ТипЗначения);
		КонецЦикла;
	КонецЕсли;
	Возврат СтруктураПараметров;

КонецФункции

&НаКлиенте
Процедура ЗаполнитьПараметрыЗапроса(Команда)
	
	Если Вопрос("Список параметров будет очищен. Продолжить?", РежимДиалогаВопрос.ДаНет) = КодВозвратаДиалога.Да Тогда
		СтруктураПараметровЗапроса = ЗаполнитьПараметрыЗапросаНаСервере("Безнал");
		Если ТипЗнч(СтруктураПараметровЗапроса) = Тип("Структура") Тогда
			ПараметрыЗапросаБезнал.Очистить();
			Для каждого ПараметрЗапроса из СтруктураПараметровЗапроса Цикл
				Если Найти(ПараметрЗапроса.Ключ,"ДатаКонца")>0 ИЛИ
					 Найти(ПараметрЗапроса.Ключ,"ДатаНачала")>0 Тогда
					 Продолжить;
				КонецЕсли;	 
				НовыйПараметр = ПараметрыЗапросаБезнал.Добавить();
				НовыйПараметр.Параметр = ПараметрЗапроса.Ключ;
				НовыйПараметр.Значение = ПараметрЗапроса.Значение.ПривестиЗначение(НовыйПараметр.Значение);
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПараметрыЗапросаНал(Команда)
	
	Если Вопрос("Список параметров будет очищен. Продолжить?", РежимДиалогаВопрос.ДаНет) = КодВозвратаДиалога.Да Тогда
		СтруктураПараметровЗапроса = ЗаполнитьПараметрыЗапросаНаСервере("Нал");
		Если ТипЗнч(СтруктураПараметровЗапроса) = Тип("Структура") Тогда
			ПараметрыЗапросаНал.Очистить();
			Для каждого ПараметрЗапроса из СтруктураПараметровЗапроса Цикл
				Если Найти(ПараметрЗапроса.Ключ,"ДатаКонца")>0 ИЛИ
					 Найти(ПараметрЗапроса.Ключ,"ДатаНачала")>0 Тогда
					 Продолжить;
				КонецЕсли;
				НовыйПараметр = ПараметрыЗапросаНал.Добавить();
				НовыйПараметр.Параметр = ПараметрЗапроса.Ключ;
				НовыйПараметр.Значение = ПараметрЗапроса.Значение.ПривестиЗначение(НовыйПараметр.Значение);
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры



