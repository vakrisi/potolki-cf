&НаСервере
Функция ЗаполнитьПараметрыПоВыбранномуРегистру(ИмяРегистра)
    
    ЭтоРБ = Лев(ИмяРегистра, 18) = "РегистрБухгалтерии";
	СтруктураИзмерений = Новый Структура;
	МетаданныеРегистр = Метаданные.НайтиПоПолномуИмени(ИмяРегистра);
	Ключ = 0;
	Для Каждого ИзмерениеРегистра Из МетаданныеРегистр.Измерения Цикл
		Ключ = Ключ + 1;
        Если ЭтоРБ и НЕ ИзмерениеРегистра.Балансовый Тогда
            СтруктураИзмерений.Вставить("Измерение" + Строка(Ключ), ИзмерениеРегистра.Имя + "Дт");
            Ключ = Ключ + 1;
            СтруктураИзмерений.Вставить("Измерение" + Строка(Ключ), ИзмерениеРегистра.Имя + "Кт");
        Иначе
            СтруктураИзмерений.Вставить("Измерение" + Строка(Ключ), ИзмерениеРегистра.Имя);
        КонецЕсли; 		
	КонецЦикла;
	
	Если ЭтоРБ Тогда
		Ключ = Ключ + 1;
		СтруктураИзмерений.Вставить("Измерение" + Строка(Ключ), "СчетДт");
        Ключ = Ключ + 1;
        СтруктураИзмерений.Вставить("Измерение" + Строка(Ключ), "СчетКт");
		//Ключ = Ключ + 1;
		//СтруктураИзмерений.Вставить("Измерение" + Строка(Ключ), "ВидДвижения");
		
		Для Каждого ТекРеквизит ИЗ МетаданныеРегистр.СтандартныеРеквизиты Цикл
			Если Лев(ТекРеквизит.Имя, 8) = "Субконто" Тогда
				Ключ = Ключ + 1;
				СтруктураИзмерений.Вставить("Измерение" + Строка(Ключ), ТекРеквизит.Имя + "Дт");
			КонецЕсли;
		КонецЦикла;
        
   		Для Каждого ТекРеквизит ИЗ МетаданныеРегистр.СтандартныеРеквизиты Цикл
			Если Лев(ТекРеквизит.Имя, 8) = "Субконто" Тогда
				Ключ = Ключ + 1;
				СтруктураИзмерений.Вставить("Измерение" + Строка(Ключ), ТекРеквизит.Имя + "Кт");
			КонецЕсли;
		КонецЦикла;

    Иначе
		Если МетаданныеРегистр.ВидРегистра = Метаданные.СвойстваОбъектов.ВидРегистраНакопления.Остатки Тогда
			//Ключ = Ключ + 1;
			//СтруктураИзмерений.Вставить("Измерение" + Строка(Ключ), "ВидДвижения");
			Для Каждого ТекРеквизит ИЗ МетаданныеРегистр.Реквизиты Цикл
				Ключ = Ключ + 1;
				СтруктураИзмерений.Вставить("Измерение" + Строка(Ключ), ТекРеквизит.Имя);
			КонецЦикла;
			Для Каждого ТекРеквизит ИЗ МетаданныеРегистр.СтандартныеРеквизиты Цикл
				Ключ = Ключ + 1;
				СтруктураИзмерений.Вставить("Измерение" + Строка(Ключ), ТекРеквизит.Имя);
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	
	Возврат СтруктураИзмерений;
	
КонецФункции

&НаСервере
Функция ПолучитьТипРеквизита(имяРегистра, имяРеквизита)
    ЭтоРБ = Найти(имяРегистра, "РегистрБухгалтерии.")=1;
	регистр = ИА_ФП.ПолучитьРегистрПоИмени(имяРегистра);
	Если Найти("/Счет/СчетДт/СчетКт/", имяРеквизита) > 0 Тогда
		реквТип = регистр.ПланСчетов.СтандартныеРеквизиты.Ссылка.Тип;
	Иначе	
		Попытка
            Если имяРеквизита = "ВидДвижения" Тогда
                РеквТип = Новый ОписаниеТипов("ВидДвиженияНакопления");
            Иначе
                Если ИА_БФКС.РеквизитЕсть(регистр.Измерения, имяРеквизита) Тогда
                    рекв = регистр.Измерения[имяРеквизита];
				ИначеЕсли ИА_БФКС.РеквизитЕсть(регистр.Реквизиты, имяРеквизита) Тогда
                    рекв = регистр.Реквизиты[имяРеквизита];
				ИначеЕсли ИА_БФКС.РеквизитЕсть(регистр.СтандартныеРеквизиты, имяРеквизита) Тогда
                    рекв = регистр.СтандартныеРеквизиты[имяРеквизита];
                Иначе
                    ИмяБезСуффикса = Лев(имяРеквизита, СтрДлина(имяРеквизита)-2);
                    рекв = регистр.Измерения[ИмяБезСуффикса];
                КонецЕсли; 
			    РеквТип = Рекв.Тип;
            КонецЕсли;             
		Исключение
		КонецПопытки;
	КонецЕсли;
	Возврат РеквТип;
КонецФункции

&НаКлиенте
Процедура ТаблицаПараметровДвижениеДСЗначениеНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ТекДанные = Элементы[Элемент.Родитель.Имя].ТекущиеДанные;
	
    Если Лев(ТекДанные.Параметр, 8) = "Субконто" Тогда
        Суффикс = Прав(ТекДанные.Параметр, 2);
        М = ПараметрыДвиженияДСБезнал.НайтиСтроки(Новый Структура("Параметр", "Счет" + Суффикс));
        Если М.Количество() > 0 Тогда
        	Счет = М[0].Значение;
        Иначе
            Счет = Неопределено;
		КонецЕсли;
		
        НомерСубконто = Число(Сред(ТекДанные.Параметр, 9, 1));        
        ТипРеквизита = ПолучитьТипСубконтоПоСчету(Счет, ИмяРегистраБезнал, НомерСубконто);
        Элемент.ОграничениеТипа = Новый ОписаниеТипов(ТипРеквизита);        
        
    Иначе		
		ТипРеквизита = ПолучитьТипРеквизита(ИмяРегистраБезнал, ТекДанные.Параметр);
		Элемент.ОграничениеТипа = Новый ОписаниеТипов(ТипРеквизита);
	КонецЕсли;
	
	//Особенность с подчиненными справочниками которые просто так открыть нельзя
	Если ЕстьБС() Тогда 
		СодержитБС = ТипРеквизита.СодержитТип(Тип("СправочникСсылка.БанковскиеСчета"));
	Иначе
		СодержитБС = Ложь;
	КонецЕсли;
	Если СодержитБС Тогда
		СтандартнаяОбработка = Ложь;
		СписокЗн = Новый СписокЗначений;
		Типы = ТипРеквизита.Типы();
		Для Каждого Эл Из Типы Цикл
			СписокЗн.Добавить(Эл,""+Эл);
		КонецЦикла;
		Выб = СписокЗн.ВыбратьЭлемент("Выбор типа данных");
		
		Если Выб = Неопределено Тогда 
			Возврат;
		КонецЕсли;
		
		ТипРеквизита = Выб.Значение;
		Если ТипРеквизита = Тип("СправочникСсылка.БанковскиеСчета") Тогда
			Попытка
				//обычное приложение
				Если ТекДанные.ТипСравнения = ВидСравнения.ВСписке ИЛИ ТекДанные.ТипСравнения = ВидСравнения.НеВСписке Тогда
					СтандартнаяОбработка = ложь;
					
					СЗ = Новый СписокЗначений;
					МассивТипов = Новый Массив;
					МассивТипов.Добавить(ТипРеквизита); 
					СЗ.ТипЗначения = Новый ОписаниеТипов(МассивТипов);
					
					П = Новый Структура();
					П.Вставить("ОписаниеТипа", СЗ.ТипЗначения);
					П.Вставить("СписокЗначений", ТекущийЭлемент.ТекущиеДанные.Значение);
					ф = ОткрытьФорму("Документ.удалить_ИА_НастройкаФП.Форма.ФормаВводаСпискаЗначений",П,ЭтаФорма);
					Возврат;
				Иначе
					СтандартнаяОбработка = ложь;
					ф = ПолучитьФорму("Справочник.БанковскиеСчета.ФормаВыбора");
					ф.Отбор.Владелец.Значение = ВернутьЛюбогоКонтрагента();
					ф.Отбор.Владелец.Использование = Ложь;
					рез = ф.ОткрытьМодально();
					Если Рез <> Неопределено Тогда 
						ТекущийЭлемент.ТекущиеДанные.Значение = рез;
					КонецЕсли;
					Возврат;
				КонецЕсли;
				
			Исключение
				//управляемое приложение
				СтандартнаяОбработка = Истина;
				МассивТипов = Новый Массив;
				МассивТипов.Добавить(ТипРеквизита); 
				Элемент.ОграничениеТипа = Новый ОписаниеТипов(МассивТипов);
			КонецПопытки;
		Иначе
			СтандартнаяОбработка = Истина;
			МассивТипов = Новый Массив;
			МассивТипов.Добавить(ТипРеквизита); 
			Элемент.ОграничениеТипа = Новый ОписаниеТипов(МассивТипов);
		КонецЕсли;
	КонецЕсли;
	//
	
	Если ТекДанные.ТипСравнения = ВидСравнения.ВСписке ИЛИ ТекДанные.ТипСравнения = ВидСравнения.НеВСписке Тогда
		
		Элемент.ОграничениеТипа = Новый ОписаниеТипов("СписокЗначений");
				
		СЗ = Новый СписокЗначений;
		Если Лев(ТекДанные.Параметр, 8) = "Субконто" Тогда 
			СЗ.ТипЗначения = Новый ОписаниеТипов();
		Иначе
			Попытка
				//Обычное приложение
				СЗ.ТипЗначения = ТипРеквизита;
			Исключение
				//Упр. приложение
				МассивТипов = Новый Массив;
				МассивТипов.Добавить(ТипРеквизита); 
				СЗ.ТипЗначения = Новый ОписаниеТипов(МассивТипов);;
			КонецПопытки;
			
		КонецЕсли;
		Если ТипЗнч(ТекДанные.Значение) = Тип("СписокЗначений") Тогда
			Для каждого Эл Из ТекДанные.Значение Цикл
				СЗ.Добавить(Эл.Значение);
			КонецЦикла; 
		КонецЕсли;
		
		ТекДанные.Значение = СЗ;
		
	КонецЕсли;
	
КонецПроцедуры

