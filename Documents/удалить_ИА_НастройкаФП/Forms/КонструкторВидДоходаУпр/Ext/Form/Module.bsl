&НаСервереБезконтекста
Функция ВернутьЛюбогоКонтрагента()
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Контрагенты.Ссылка
		|ИЗ
		|	Справочник.Контрагенты КАК Контрагенты
		|ГДЕ
		|	НЕ Контрагенты.ЭтоГруппа";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Возврат ВыборкаДетальныеЗаписи.Ссылка;
	КонецЦикла;
	
КонецФункции

&НаКлиенте
Процедура ТаблицаПараметровДвижениеДСЗначениеНачалоВыбораИзСписка(Элемент, СтандартнаяОбработка)
	ТекДанные = Элементы.ТаблицаПараметровДвижениеДС.ТекущиеДанные;
	Элемент.СписокВыбора.Очистить();
	Если ТекДанные.Параметр = "Вид движения" Тогда
		Элемент.КнопкаОткрытия = Ложь;
		Если Лев(ИмяРегистраБезнал, 18) = "РегистрБухгалтерии" Тогда
			Элемент.ОграничениеТипа = Новый ОписаниеТипов("Строка");
			Элемент.СписокВыбора.Вставить(0,"Дебет");
			Элемент.СписокВыбора.Вставить(1,"Кредит");
		Иначе
			Элемент.КнопкаОткрытия = Ложь;
			Элемент.ОграничениеТипа = Новый ОписаниеТипов("Строка");
			Элемент.СписокВыбора.Вставить(0,"Приход");
			Элемент.СписокВыбора.Вставить(1,"Расход");		
		КонецЕсли;
	Иначе	
		
	КонецЕсли;
КонецПроцедуры

