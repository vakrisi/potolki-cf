
&НаКлиенте
Процедура КомандаОК(Команда)
    Если РежимКонструктора = ПредопределенноеЗначение("Перечисление.ИА_ВариантыПолученияДанныхВидыДоходов.ДвиженияДС") Тогда
        Если НЕ ЗначениеЗаполнено(ИмяРегистраБезнал)
            ИЛИ НЕ ЗначениеЗаполнено(РесурсРегистраБезнал)
            Тогда
            Сообщение = Новый СообщениеПользователю;
            Сообщение.Текст = "Не заполнены обязательные поля!";
            Сообщение.Сообщить(); 
        	Возврат
        КонецЕсли; 
        
		Стр = Новый Структура();
		
		Стр.Вставить("ПредставлениеРегистраБезнал" , ПредставлениеРегистраБезнал);
		Стр.Вставить("ИмяРегистраБезнал",            ИмяРегистраБезнал);
        Стр.Вставить("РесурсРегистраБезнал",         РесурсРегистраБезнал);
        Стр.Вставить("ПараметрыЗапросаБезнал",       ПараметрыДвиженияДСБезнал);
		Стр.Вставить("ПолеСтатьяДДСБезнал",          ПолеСтатьяДДСБезнал);

		Стр.Вставить("ПредставлениеРегистраНал" ,    ПредставлениеРегистраНал);
		Стр.Вставить("ИмяРегистраНал",               ИмяРегистраНал);
        Стр.Вставить("РесурсРегистраНал",            РесурсРегистраНал);
        Стр.Вставить("ПараметрыЗапросаНал",          ПараметрыДвиженияДСНал);
		Стр.Вставить("ПолеСтатьяДДСНал",          	 ПолеСтатьяДДСНал);
		
		Закрыть(Стр);
	Иначе
		Стр = Новый Структура();
		Стр.Вставить("ТекстЗапросаБезнал",      ТекстЗапросаБезнал);
		Стр.Вставить("ПараметрыЗапросаБезнал",  ПараметрыЗапросаБезнал);
		
		Стр.Вставить("ТекстЗапросаНал",         ТекстЗапросаНал);
		Стр.Вставить("ПараметрыЗапросаНал",     ПараметрыЗапросаНал);

		Закрыть(Стр);
	КонецЕсли;
КонецПроцедуры

&НаСервере
//Наполнение дерева списком регистров из метаданных
Процедура ЗаполнитьДеревоРегистров()

	дерРег = РеквизитФормыВЗначение("ДеревоРегистров");
	
	НоваяСтрокаКорень = дерРег.Строки.Добавить();
	////НоваяСтрокаКорень.ПредставлениеРегистра = "Разделы управленческого учета";
    НоваяСтрокаКорень.ПредставлениеРегистра = "Регистры накопления";

	Для Каждого МетаданныеРегистр Из Метаданные.РегистрыНакопления Цикл

		Если МетаданныеРегистр.Ресурсы.Количество()=0 Тогда
			Продолжить;
		КонецЕсли;
		
		Регистр = НоваяСтрокаКорень.Строки.Добавить();
		Регистр.ПредставлениеРегистра=МетаданныеРегистр.Представление();
		Регистр.ИмяРегистра = "РегистрНакопления."+МетаданныеРегистр.Имя;
		
	КонецЦикла;
	
	НоваяСтрокаКорень = дерРег.Строки.Добавить();
	////НоваяСтрокаКорень.ПредставлениеРегистра = "Разделы бухгалтерского и налогового учета";
    НоваяСтрокаКорень.ПредставлениеРегистра = "Регистры бухгалтерии";

	Для Каждого МетаданныеРегистр Из Метаданные.РегистрыБухгалтерии Цикл

        Если МетаданныеРегистр.Ресурсы.Количество()=0 Тогда
			Продолжить;
		КонецЕсли;

		Регистр = НоваяСтрокаКорень.Строки.Добавить();
		Регистр.ПредставлениеРегистра = МетаданныеРегистр.Представление();
		Регистр.ИмяРегистра = "РегистрБухгалтерии."+МетаданныеРегистр.Имя;
	КонецЦикла;

	ЗначениеВРеквизитФормы(дерРег, "ДеревоРегистров");
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ЗаполнитьДеревоРегистров();
	
	ПараметрыСтруктура = Новый Структура;
	
	ПараметрыСтруктура.Вставить("ИмяРегистраБезнал", Параметры.ИмяРегистраБезнал);
	ПараметрыСтруктура.Вставить("ПредставлениеРегистраБезнал", Параметры.ПредставлениеРегистраБезнал);
	ПараметрыСтруктура.Вставить("ИмяРегистраНал", Параметры.ИмяРегистраНал);
	ПараметрыСтруктура.Вставить("ПредставлениеРегистраНал", Параметры.ПредставлениеРегистраНал);
	ПараметрыСтруктура.Вставить("РесурсРегистраБезнал", Параметры.РесурсРегистраБезнал);
	ПараметрыСтруктура.Вставить("ПолеСтатьяДДСБезнал", Параметры.ПолеСтатьяДДСБезнал);
	ПараметрыСтруктура.Вставить("РесурсРегистраНал", Параметры.РесурсРегистраНал);
	ПараметрыСтруктура.Вставить("ПолеСтатьяДДСНал", Параметры.ПолеСтатьяДДСНал);
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоРегистровВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ИмяГруппы  = Элемент.Родитель.Имя;
	
	ПостФикс = ОпределитьПостфикс();
	ПостфиксСписка = ОпределитьПостфиксСписка();
	//ПостФиксСписка - Специальный постфикс, добавлен специально для элемента формы "РесурсРегистра" т.к. к списку идет обращение только через "Элементы"
	
	Если ИмяГруппы = "ГруппаВыражениеНаличные" Тогда		
		ТекущаяСтрока = Элементы.ДеревоРегистровНаличные.ТекущиеДанные; 
	ИначеЕсли ИмяГруппы = "ГруппаВыражениеБезналичные" Тогда 
		ТекущаяСтрока = Элементы.ДеревоРегистровБезналичные.ТекущиеДанные;
	Иначе
		ТекущаяСтрока = Элементы.ДеревоРегистров.ТекущиеДанные;
	КонецЕсли;
	
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	     
	
	Если НЕ ТекущаяСтрока.ИмяРегистра = "" Тогда
		ЭтаФорма["ПредставлениеРегистра"+ПостФикс] = ТекущаяСтрока.ПредставлениеРегистра;
		ЭтаФорма["ИмяРегистра"+ПостФикс]           = ТекущаяСтрока.ИмяРегистра;
	КонецЕсли;
	
	Элементы["РесурсРегистра"+ПостФиксСписка].СписокВыбора.Очистить();
	Элементы["ПолеСтатьяДДС"+ПостФиксСписка].СписокВыбора.Очистить();
	ЗаполнитьТаблицуОтбораРегистра(ПостФикс,ПостФиксСписка);
    ЭтаФорма["РесурсРегистра"+ ПостФикс] = "";
	ЭтаФорма["ПолеСтатьяДДС"+ ПостФикс] = "";
	
	
	Постфикс = ОпределитьПостфикс();
	
	Элементы.ТаблицаПараметровДвижениеДСБезналичныеПараметр.СписокВыбора.Очистить();
	СтруктураПараметров = ЗаполнитьПараметрыПоВыбранномуРегистру(ЭтаФорма["ИмяРегистра"+ПостФикс]);  
	Для каждого ТекПараметрСтруктуры Из СтруктураПараметров Цикл
	  Элементы.ТаблицаПараметровДвижениеДСБезналичныеПараметр.СписокВыбора.Добавить(ТекПараметрСтруктуры.Значение);
    КонецЦикла; 
	
	Если ПостфиксСписка = "" Тогда
		ИмяЭлементаПоле = "ТаблицаПараметровДвижениеДСПараметр"
	Иначе
		ИмяЭлементаПоле = "ТаблицаПараметровДвижениеДС"+ПостфиксСписка+"ичныеПараметр"
	КонецЕсли;
	
	ЗаполнитьСписокВыбораЭлементаПоле("ИмяРегистра"+ПостФикс, ИмяЭлементаПоле);
	
	ЗаполнитьСписокВыбораПолеСтатьяДДСБезнал(Элементы["ПолеСтатьяДДС"+ПостфиксСписка], Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьСписокВыбораЭлементаПоле(ИмяРегистра, ИмяЭлемента)
	Если ЗначениеЗаполнено(ЭтаФорма[ИмяРегистра]) Тогда
		
		ЭлементПоле  = Элементы[ИмяЭлемента];
		СписокВыбора = ЭлементПоле.СписокВыбора;
		СписокВыбора.Очистить();
		
		СтруктураПараметров = ЗаполнитьПараметрыПоВыбранномуРегистру(ЭтаФорма[ИмяРегистра]);  
		
		Для каждого ТекПараметрСтруктуры Из СтруктураПараметров Цикл
			СписокВыбора.Добавить(ТекПараметрСтруктуры.Значение);
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры           

&НаКлиенте
Процедура ЗаполнитьТаблицуОтбораРегистра(ПостФикс = "Безнал",ПостФиксСписка)
    
   Перем НоваяСтрока, СтруктураПараметров, ТекПараметр;
	
   ТаблицаПараметровДвиженияДС = ЭтаФорма["ПараметрыДвиженияДС"+ПостФикс];
   ТаблицаПараметровДвиженияДС.Очистить(); 
   
   Если ЗначениеЗаполнено(ЭтаФорма["ИмяРегистра"+ПостФикс]) Тогда
		
		Если НЕ ЭтаФорма["ПредставлениеРегистра"+ПостФикс] = Неопределено И
    		 НЕ ЭтаФорма["ИмяРегистра"+ПостФикс] = "" Тогда
            Элементы["РесурсРегистра"+ПостФиксСписка].СписокВыбора.ЗагрузитьЗначения(ИА_ФП.ПолучитьСписокРеквизитов(ЭтаФорма["ИмяРегистра"+ПостФикс], "Ресурсы"));
    	КонецЕсли;
    	
        СтруктураПараметров = ЗаполнитьПараметрыПоВыбранномуРегистру(ЭтаФорма["ИмяРегистра"+ПостФикс]);
        
       
        Для ТекПараметр = 1 По СтруктураПараметров.Количество() Цикл
            НоваяСтрока = ТаблицаПараметровДвиженияДС.Добавить();
            НоваяСтрока.Параметр	 = СтруктураПараметров["Измерение" + ТекПараметр];
            НоваяСтрока.ТипСравнения = ВидСравнения.Равно;	
		КонецЦикла;
    КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьОтбор(Команда)
	
	Постфикс = ОпределитьПостфикс();
	ПостфиксСписка = ОпределитьПостфиксСписка();
	
	Если ЭтаФорма["ПараметрыДвиженияДС"+Постфикс].Количество() = 0 ИЛИ 
		 Вопрос("Заполнить таблицу отбора ?",РежимДиалогаВопрос.ОКОтмена) = КодВозвратаДиалога.ОК Тогда
		     		ЗаполнитьТаблицуОтбораРегистра(Постфикс,ПостфиксСписка);
	КонецЕсли; 
	
КонецПроцедуры

