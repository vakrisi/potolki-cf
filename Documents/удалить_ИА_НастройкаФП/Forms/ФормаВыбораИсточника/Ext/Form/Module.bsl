&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("ИсточникПолей") Тогда
		Параметры.ЭтоПоле = Истина;
		Параметры.Источник = Параметры.ИсточникПолей;
		ЗаполнитьДеревоАналитик(); 
	Иначе
		ЗаполнитьДеревоИсточника();
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура ДеревоИсточниковВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	ОбработкаВыбора();	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора()
	
	тд = Элементы.ДеревоИсточников.ТекущиеДанные;
	Если тд <> Неопределено И тд.Имя <> "" Тогда
		Структура = Новый Структура("Представление, Имя, Тип", тд.Представление, тд.Имя, тд.Тип);
		Закрыть(Структура);
	Иначе
		ПоказатьПредупреждение(,"Нельзя выбрать данный элемент",, "Выбор источника");
	КонецЕсли;    
	
КонецПроцедуры	

&НаСервере
Процедура ЗаполнитьДеревоАналитик()
	 
	ЗаполнитьДерево(-1, "*", Параметры.Источник);

КонецПроцедуры // ЗаполнитьДеревоАналитик()

&НаСервере
Процедура ЗаполнитьДерево(ид, ПутьКДанным, ИмяТаблицы)	
	
	Если ид = -1 Тогда
		Строки = ДеревоИсточников.ПолучитьЭлементы();
	Иначе
		Строки = ДеревоИсточников.НайтиПоИдентификатору(ид).ПолучитьЭлементы();
	КонецЕсли;
	
	Строки.Очистить();
	
	ТекстЗапр = "ВЫБРАТЬ ИсточникДанных." + ПутьКДанным + " ИЗ " + ИмяТаблицы + " КАК ИсточникДанных";
			
	Постр = Новый ПостроительОтчета(ТекстЗапр);
	Постр.ЗаполнитьНастройки();

	Поля = Постр.ДоступныеПоля;
	Если ПутьКДанным <> "*" Тогда
		Для каждого стрПоле из Поля Цикл
			Если стрПоле.Поле Тогда
				Поля = стрПоле.Поля;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Для каждого СтрПоле из Поля Цикл
		Если не СтрПоле.Поле ИЛИ не СтрПоле.Отбор Тогда
			Продолжить;
		КонецЕсли;
		
		НовСтр = Строки.Добавить();
		НовСтр.Представление = СтрПоле.Имя;
		НовСтр.Тип = СтрПоле.ТипЗначения;
		
		РезПуть = СтрПоле.Имя;
		ТекРодитель = Новстр.ПолучитьРодителя();
		Пока ТекРодитель <> Неопределено Цикл
			РезПуть = ТекРодитель.Имя + "." + РезПуть;
			ТекРодитель = ТекРодитель.ПолучитьРодителя();
			Прервать;			
		КонецЦикла;
		
		НовСтр.Имя = РезПуть;	
		
		Если Строка(СтрПоле.ТипЗначения) <> "Число" И Строка(СтрПоле.ТипЗначения) <> "Дата" 
			И Строка(СтрПоле.ТипЗначения) <> "Строка" И Строка(СтрПоле.ТипЗначения) <> "Булево" Тогда
			ВремСтрока = Новстр.ПолучитьЭлементы().Добавить();
			ВремСтрока.Имя = "1";
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ДеревоИсточниковПередРазворачиванием(Элемент, Строка, Отказ)
	Если Параметры.ЭтоПоле Тогда
		стр = ДеревоИсточников.НайтиПоИдентификатору(Строка);
		Если стр.ПолучитьЭлементы().Количество() = 1 Тогда		
			ЗаполнитьДерево(Строка, стр.Имя, Параметры.Источник);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры






