
&НаКлиенте
Процедура КомандаОК(Команда)
	
	ОбработкаВыбора();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДеревоИсточника()

	Дерево = РеквизитФормыВЗначение("ДеревоИсточников");
	
	НоваяСтрокаКорень = Дерево.Строки.Добавить();
	НоваяСтрокаКорень.Представление = "Документы";
	
	Для Каждого МетаданныеДокумент Из Метаданные.Документы Цикл
			
		//Если ПроверитьДокументТЧ(МетаданныеДокумент) Тогда
			Документ = НоваяСтрокаКорень.Строки.Добавить();
			Документ.Представление = МетаданныеДокумент.Представление();
			Документ.Имя = "Документ." + МетаданныеДокумент.Имя;
		//КонецЕсли;	
		
		Для каждого тч из МетаданныеДокумент.ТабличныеЧасти Цикл
			//Если ПроверитьДокументТЧ(тч) Тогда
				ТабЧасть = НоваяСтрокаКорень.Строки.Добавить();
				ТабЧасть.Представление = МетаданныеДокумент.Представление() + " > " + тч.Представление() + " (таб. часть)";
				ТабЧасть.Имя = "Документ." + МетаданныеДокумент.Имя + "." + тч.Имя;	
			//КонецЕсли; 			
		КонецЦикла;	
	КонецЦикла;
	
	НоваяСтрокаКорень = Дерево.Строки.Добавить();
	НоваяСтрокаКорень.Представление = "Регистры сведений";

	Для Каждого МетаданныеРегистр Из Метаданные.РегистрыСведений Цикл

		//Если Не ПроверитьРегистр(МетаданныеРегистр) Тогда
		//	Продолжить;	
		//КонецЕсли;
		
		Регистр = НоваяСтрокаКорень.Строки.Добавить();
		Регистр.Представление = МетаданныеРегистр.Представление();
		Регистр.Имя = "РегистрСведений." + МетаданныеРегистр.Имя;
		Если Не МетаданныеРегистр.ПериодичностьРегистраСведений = Метаданные.СвойстваОбъектов.ПериодичностьРегистраСведений.Непериодический Тогда
			//Регистр = НоваяСтрокаКорень.Строки.Добавить();
			//Регистр.Представление = МетаданныеРегистр.Представление() + " (срез первых)";
			//Регистр.Имя = "РегистрСведений." + МетаданныеРегистр.Имя + ".СрезПервых";
			Регистр = НоваяСтрокаКорень.Строки.Добавить();
			Регистр.Представление = МетаданныеРегистр.Представление() + " (срез последних)";
			Регистр.Имя = "РегистрСведений." + МетаданныеРегистр.Имя + ".СрезПоследних";
		КонецЕсли;	
	КонецЦикла;
	
	НоваяСтрокаКорень = Дерево.Строки.Добавить();
	НоваяСтрокаКорень.Представление = "Регистры накопления";

	Для Каждого МетаданныеРегистр Из Метаданные.РегистрыНакопления Цикл

		//Если Не ПроверитьРегистр(МетаданныеРегистр) Тогда
		//	Продолжить;		
		//КонецЕсли; 		
		
		Регистр = НоваяСтрокаКорень.Строки.Добавить();
		Регистр.Представление = МетаданныеРегистр.Представление();
		Регистр.Имя = "РегистрНакопления." + МетаданныеРегистр.Имя;
		Если МетаданныеРегистр.ВидРегистра = Метаданные.СвойстваОбъектов.ВидРегистраНакопления.Обороты Тогда
			Регистр = НоваяСтрокаКорень.Строки.Добавить();
			Регистр.Представление = МетаданныеРегистр.Представление() + " (обороты)";
			Регистр.Имя = "РегистрНакопления." + МетаданныеРегистр.Имя + ".Обороты";
		ИначеЕсли МетаданныеРегистр.ВидРегистра = Метаданные.СвойстваОбъектов.ВидРегистраНакопления.Остатки Тогда
			Регистр = НоваяСтрокаКорень.Строки.Добавить();
			Регистр.Представление = МетаданныеРегистр.Представление() + " (обороты)";
			Регистр.Имя = "РегистрНакопления." + МетаданныеРегистр.Имя + ".Обороты";
			Регистр = НоваяСтрокаКорень.Строки.Добавить();
			Регистр.Представление = МетаданныеРегистр.Представление() + " (остатки)";
			Регистр.Имя = "РегистрНакопления." + МетаданныеРегистр.Имя + ".Остатки";
			//Регистр = НоваяСтрокаКорень.Строки.Добавить();
			//Регистр.Представление = МетаданныеРегистр.Представление() + " (остатки и обороты)";
			//Регистр.Имя = "РегистрНакопления." + МетаданныеРегистр.Имя + ".ОстаткиИОбороты";
		КонецЕсли;	
			
	КонецЦикла;
		
	ЗначениеВРеквизитФормы(Дерево, "ДеревоИсточников");
КонецПроцедуры

