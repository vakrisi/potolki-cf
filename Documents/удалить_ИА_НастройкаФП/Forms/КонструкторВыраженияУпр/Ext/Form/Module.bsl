&НаКлиенте
Перем ФормаФП;

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ПриОткрытииНаСервере();
	
	Элементы.Спецдоход.Видимость = ИспользоватьСпецдоход;
	Элементы.РаспределениеСпецдохода.Видимость = ИспользоватьСпецдоход;
	
	//Элементы.ФП_РаспределениеСредствСФондов.Видимость = ИспользоватьРаспределениеСФондов;
	Элементы.ФП_РаспределениеСредствСФондов.Видимость = ложь;
	Элементы.ГруппаРСФ.Видимость = ИспользоватьРаспределениеСФондов;
	
	Элементы.ФП_ДоходыБП.Видимость = ИспользоватьСпецдоход;
	Элементы.ФП_ДоходыБП_Распределение.Видимость = ИспользоватьСпецдоход;
	
	ОбновитьОтображениеПоНалБезнал();
	
	ПроверитьФормулу(Неопределено);
	
	Заголовок = "Редактирование расчета "+ВыбРаздел+", "+ВыбПодразделение+", "+ВыбФонд;
	
	// Развернем окно. Да, вот так все сложно
	Попытка
		WSHShell = Новый COMОбъект("WScript.Shell");
    	WSHShell.SendKeys("%");
    	WSHShell.SendKeys("{LEFT}{LEFT}{ENTER}");
	Исключение
	КонецПопытки;
КонецПроцедуры

&НаСервере
Процедура ПриОткрытииНаСервере()
	// Вставить содержимое обработчика.
	// доходы
	Доходы.ЗагрузитьЗначения(ДокНастройки.Доходы.ВыгрузитьКолонку("ВидДохода"));
	
	// спецдоход
	ВыборкаВидовДох = Справочники.ИА_ВидыДоходов.Выбрать();
	Пока ВыборкаВидовДох.Следующий() Цикл
		Если не ВыборкаВидовДох.ПометкаУдаления Тогда
			РаспределениеСпецдохода.Добавить(ВыборкаВидовДох.Ссылка);
			Спецдоход.Добавить(ВыборкаВидовДох.Ссылка);
		КонецЕсли;
	КонецЦикла;
	
	//Политика
	Мен = Новый МенеджерВременныхТаблиц;
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Мен;
	Запрос.Текст = "ВЫБРАТЬ
	               |	Пол1.Раздел,
	               |	Пол1.Подразделение,
	               |	Пол1.Фонд
	               |ПОМЕСТИТЬ Пол1
	               |ИЗ
	               |	&Пол1 КАК Пол1
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	Пол2.Раздел,
	               |	Пол2.Подразделение,
	               |	Пол2.Фонд
	               |ПОМЕСТИТЬ Пол2
	               |ИЗ
	               |	&Пол2 КАК Пол2";
	Запрос.УстановитьПараметр("Пол1", ДокНастройки.ПолитикаРаспределенияПервичная.Выгрузить()); 
	Запрос.УстановитьПараметр("Пол2", ДокНастройки.ПолитикаРаспределения.Выгрузить());
	Запрос.Выполнить();
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	Политика.Фонд,
	               |	Политика.Подразделение,
	               |	Политика.Раздел КАК Раздел
	               |ИЗ
	               |	Пол1 КАК Политика
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Политика.Раздел.Наименование
	               |ИТОГИ ПО
	               |	Раздел";				   
	//Минаев
	ДеревоПолитика1Знач = ДанныеФормыВЗначение(ЭтаФорма.ДеревоПолитика1,Тип("ДеревоЗначений"));
	ДеревоПолитика1Знач = Запрос.Выполнить().Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам);
	ЗначениеВДанныеФормы(ДеревоПолитика1Знач,ЭтаФорма.ДеревоПолитика1);

	
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	Политика.Фонд,
	               |	Политика.Подразделение,
	               |	Политика.Раздел КАК Раздел
	               |ИЗ
	               |	Пол2 КАК Политика
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Политика.Раздел.Наименование
	               |ИТОГИ ПО
	               |	Раздел";				   
	//Минаев
	ДеревоПолитика2Знач = ДанныеФормыВЗначение(ЭтаФорма.ДеревоПолитика2,Тип("ДеревоЗначений"));			   
	ДеревоПолитика2Знач = Запрос.Выполнить().Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам);
 	ЗначениеВДанныеФормы(ДеревоПолитика2Знач,ЭтаФорма.ДеревоПолитика2);


КонецПроцедуры

