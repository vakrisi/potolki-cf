&НаКлиенте
Процедура ОбновитьОтображениеПоНалБезнал()
	
	Элементы.ФП_ДоходыСуммаНал.Видимость = РазделятьНалБезнал;
	Элементы.ФП_ДоходыСуммаБезнал.Видимость = РазделятьНалБезнал;
	
	Элементы.ФП_ДоходыИтого.Видимость = РазделятьНалБезнал;
	Элементы.ФП_Сумма.Видимость = не РазделятьНалБезнал;
	
	Элементы.ФП_ДеревоПолитикаПервичнаяСуммаНал.Видимость = РазделятьНалБезнал;
	Элементы.ФП_ДеревоПолитикаПервичнаяСуммаБезнал.Видимость = РазделятьНалБезнал;
	Элементы.ФП_ДеревоПолитикаПервичнаяИтого.Видимость = РазделятьНалБезнал;
	Элементы.ФП_ДеревоПолитикаПервичнаяСумма.Видимость = не РазделятьНалБезнал;
	
	Элементы.ФП_ДоходыБП_РаспределениеСуммаНал.Видимость = РазделятьНалБезнал;
	Элементы.ФП_ДоходыБП_РаспределениеСуммаБезнал.Видимость = РазделятьНалБезнал;
	Элементы.ФП_ДоходыБП_РаспределениеСумма.Видимость = не РазделятьНалБезнал;
	
	Элементы.ФП_ДоходыБПСуммаНал.Видимость = РазделятьНалБезнал;
	Элементы.ФП_ДоходыБПСуммаБезнал.Видимость = РазделятьНалБезнал;
	Элементы.ФП_ДоходыБПСумма.Видимость = не РазделятьНалБезнал;
	
	Элементы.ФП_ДеревоПолитикаСуммаНал.Видимость = РазделятьНалБезнал;
	Элементы.ФП_ДеревоПолитикаСуммаБезнал.Видимость = РазделятьНалБезнал;
	Элементы.ФП_ДеревоПолитикаИтого.Видимость = РазделятьНалБезнал;
	Элементы.ФП_ДеревоПолитикаСумма.Видимость = не РазделятьНалБезнал;
	
	Элементы.ФП_РаспределениеСредствСФондовСуммаНал.Видимость = РазделятьНалБезнал;
	Элементы.ФП_РаспределениеСредствСФондовСуммаБезНал.Видимость = РазделятьНалБезнал;
	Элементы.ФП_РаспределениеСредствСФондовСумма.Видимость = не РазделятьНалБезнал;
	
	Если не РазделятьНалБезнал Тогда
		Элементы.ФП_НадписьСуммаКРаспр1.Заголовок = СтрЗаменить(Элементы.ФП_НадписьСуммаКРаспр1.Заголовок, "(нал/безнал)", "");
		Элементы.ФП_НадписьСуммаКРаспр.Заголовок = СтрЗаменить(Элементы.ФП_НадписьСуммаКРаспр.Заголовок, "(нал/безнал)", "");
		Элементы.ФП_НадписьНераспрСумма.Заголовок = СтрЗаменить(Элементы.ФП_НадписьНераспрСумма.Заголовок, "(нал/безнал)", "");
		Элементы.ФП_НадписьМаржа.Заголовок = СтрЗаменить(Элементы.ФП_НадписьМаржа.Заголовок, "(нал/безнал)", "");
		Элементы.ФП_НадписьСуммаРаспр.Заголовок = СтрЗаменить(Элементы.ФП_НадписьСуммаРаспр.Заголовок, "(нал/безнал)", "");
		
		Элементы.ФП_Декорация2.Видимость = Ложь;
		Элементы.ФП_Декорация4.Видимость = Ложь;
		Элементы.ФП_Декорация9.Видимость = Ложь;
		Элементы.ФП_Декорация11.Видимость = Ложь;
		Элементы.ФП_Декорация13.Видимость = Ложь;
		
		Элементы.ФП_ПредварительнаяСуммаКРаспределениюИтого1.Видимость = Ложь;
		Элементы.ФП_ПредварительнаяСуммаКРаспределениюИтого.Видимость = Ложь;
		Элементы.ФП_НераспределяемаяСуммаИтого.Видимость = Ложь;
		Элементы.ФП_МаржинальнаяПрибыльИтого.Видимость = Ложь;
		Элементы.ФП_СуммаКРаспределениюИтого.Видимость = Ложь;
		
		Элементы.ФП_ПредварительнаяСуммаКРаспределениюНал.Видимость = Ложь;
		Элементы.ФП_ПредварительнаяСуммаКРаспределениюНал1.Видимость = Ложь;
		Элементы.ФП_НераспределяемаяСуммаНал.Видимость = Ложь;
		Элементы.ФП_МаржинальнаяПрибыльНал.Видимость = Ложь;
		Элементы.ФП_СуммаКРаспределениюНал.Видимость = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьСтруктДокНастройкиФП(знач Доходы_Настр, знач ПолитикаРаспределения_Настр, знач ПолитикаРаспределенияПервичная_Настр)  
	Рез = Новый Структура("Доходы,ПолитикаРаспределения,ПолитикаРаспределенияПервичная", Доходы_Настр.Выгрузить(),ПолитикаРаспределения_Настр.Выгрузить(), ПолитикаРаспределенияПервичная_Настр.Выгрузить());
	Возврат ЗначениеВСтрокуВнутр(Рез);
КонецФункции

&НаКлиенте
Процедура ПроверитьФормулу(Команда)
	//Если Вопрос("Для проверки формулы необходимо записать политику. Продолжить?", РежимДиалогаВопрос.ДаНет)<>КодВозвратаДиалога.Да Тогда
	//	Возврат;
	//КонецЕсли;
	
	ВладелецФормы.ТекущийЭлемент.ТекущиеДанные[ИмяЗаполняемогоПоля] = СокрЛП(ПолеФормула);
	//ВладелецФормы.Записать();
	
	Если ФормаФП = Неопределено Тогда
		ФормаФП = ПолучитьФорму("Документ.ИА_ФинансовоеПланирование.ФормаОбъекта",,,"НастройкаФП");
		
		ФормаФП.ИспользоватьСлужебнуюНастройку = истина;
		ФормаФП.СохранятьРассчитаныеФормыПоБезнал = ЭтоБезнал;
		ФормаФП.объект.Дата = ТекущаяДата();
		Если ФормаФП.ФППоОрганизациям Тогда
			ФормаФП.объект.Организация = Организация;
		КонецЕсли;
	КонецЕсли;
	
	ФормаФП.СлужебнаяНастройкаФП = ПолучитьСтруктДокНастройкиФП(ВладелецФормы.Объект.Доходы, ВладелецФормы.Объект.ПолитикаРаспределения,ВладелецФормы.Объект.ПолитикаРаспределенияПервичная);
	
	ФормаФП.КомандаОбновитьДокумент(Неопределено);
	
	ЗаполнитьФП();
	
	ФормаФП.ОсновнойПерерасчет(1);
	ПеренестиРезультатФПВФорму();
	
	// отобразим результат
	РезультатФормулы = "";
	Для каждого стр из ФормаФП.РассчитанныеФормулы Цикл
		если стр.Формула = ПолеФормула Тогда
			РезультатФормулы = стр.ПредставлениеФормулы + " = " + стр.Результат;
			Прервать;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ПеренестиРезультатФПВФорму()
	// очистка
	ФП_Доходы.Очистить();
	ФП_ДеревоПолитикаПервичная.ПолучитьЭлементы().Очистить();
	ФП_РаспределениеСредствСФондов.Очистить();
	ФП_ДоходыБП.Очистить();
	ФП_ДоходыБП_Распределение.Очистить();
	ФП_ДеревоПолитика.ПолучитьЭлементы().Очистить();
	
	// доходы
	Для каждого стр из ФормаФП.Объект.Доходы Цикл
		Новстр = ФП_Доходы.Добавить();
		ЗаполнитьЗначенияСвойств(Новстр, стр);
		Новстр.Итого = Новстр.СуммаНал + Новстр.СуммаБезнал;
	КонецЦикла;
	
	// Политика 1
	Для каждого стрРаздел из ФормаФП.ДеревоПолитикаПервичная.ПолучитьЭлементы() Цикл
		Новстр = ФП_ДеревоПолитикаПервичная.ПолучитьЭлементы().Добавить();
		ЗаполнитьЗначенияСвойств(Новстр, стрРаздел);
		Если Новстр.Раздел <>"СКД:" Тогда
			ПредРаздел =  Новстр.Раздел;
		Иначе
			Новстр.Раздел1 = ПредРаздел;
		КонецЕсли;
		Для каждого стрФонд из стрРаздел.ПолучитьЭлементы() Цикл
			Новстр2 = Новстр.ПолучитьЭлементы().Добавить();
			ЗаполнитьЗначенияСвойств(Новстр2, стрФонд);
		КонецЦикла;
	КонецЦикла;
	
	// Распределение средств с фондов
	Для каждого стр из ФормаФП.Объект.РаспределениеСредствСФондов Цикл
		Новстр = ФП_РаспределениеСредствСФондов.Добавить();
		ЗаполнитьЗначенияСвойств(Новстр, стр);
	КонецЦикла;
	
	// Спецдоход
	Для каждого стр из ФормаФП.Объект.ДоходыБП Цикл
		Новстр = ФП_ДоходыБП.Добавить();
		ЗаполнитьЗначенияСвойств(Новстр, стр);
	КонецЦикла;

	// Распределение Спецдохода
	Для каждого стр из ФормаФП.Объект.ДоходыБП_Распределение Цикл
		Новстр = ФП_ДоходыБП_Распределение.Добавить();
		ЗаполнитьЗначенияСвойств(Новстр, стр);
	КонецЦикла;
	
	// Политика 2
	Для каждого стрРаздел из ФормаФП.ДеревоПолитика.ПолучитьЭлементы() Цикл
		Новстр = ФП_ДеревоПолитика.ПолучитьЭлементы().Добавить();
		ЗаполнитьЗначенияСвойств(Новстр, стрРаздел);
		Если Новстр.Раздел <>"СКД:" Тогда
			ПредРаздел =  Новстр.Раздел;
		Иначе
			Новстр.Раздел1 = ПредРаздел;
		КонецЕсли;
		Для каждого стрФонд из стрРаздел.ПолучитьЭлементы() Цикл
			Новстр2 = Новстр.ПолучитьЭлементы().Добавить();
			ЗаполнитьЗначенияСвойств(Новстр2, стрФонд);
		КонецЦикла;
	КонецЦикла;
	
	// реквизиты
	ФП_МаржинальнаяПрибыльБезнал = ФормаФП.Объект.МаржинальнаяПрибыльБезнал;
	ФП_МаржинальнаяПрибыльИтого = ФормаФП.МаржинальнаяПрибыльИтого;
	ФП_МаржинальнаяПрибыльНал = ФормаФП.Объект.МаржинальнаяПрибыльНал;
	ФП_НераспределяемаяСуммаБезнал = ФормаФП.Объект.НераспределяемаяСуммаБезнал;
	ФП_НераспределяемаяСуммаИтого = ФормаФП.НераспределяемаяСуммаИтого;
	ФП_НераспределяемаяСуммаНал = ФормаФП.Объект.НераспределяемаяСуммаНал;
	ФП_ПредварительнаяСуммаКРаспределениюБезнал = ФормаФП.Объект.ПредварительнаяСуммаКРаспределениюБезнал;
	ФП_ПредварительнаяСуммаКРаспределениюБезнал1 = ФормаФП.Объект.ПредварительнаяСуммаКРаспределениюБезнал1;
	ФП_ПредварительнаяСуммаКРаспределениюИтого = ФормаФП.ПредварительнаяСуммаКРаспределениюИтого;
	ФП_ПредварительнаяСуммаКРаспределениюИтого1 = ФормаФП.ПредварительнаяСуммаКРаспределениюИтого1;
	ФП_ПредварительнаяСуммаКРаспределениюНал = ФормаФП.Объект.ПредварительнаяСуммаКРаспределениюНал;
	ФП_ПредварительнаяСуммаКРаспределениюНал1 = ФормаФП.Объект.ПредварительнаяСуммаКРаспределениюНал1;
	ФП_СуммаКРаспределениюБезнал = ФормаФП.Объект.СуммаКРаспределениюБезнал;
	ФП_СуммаКРаспределениюИтого = ФормаФП.СуммаКРаспределениюИтого;
	ФП_СуммаКРаспределениюНал = ФормаФП.Объект.СуммаКРаспределениюНал;
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьФП()
	
	// доходы
	ТекДоход = 1000000;
	Для каждого стр из ФормаФП.Объект.Доходы Цикл
		Если РазделятьНалБезнал Тогда
			стр.СуммаНал = ТекДоход; 
		КонецЕсли;
		стр.СуммаБезнал = ТекДоход;
		ТекДоход = ТекДоход + 50000;
	КонецЦикла;
	
	// политика 1
	ТекСуммаФонда = 10000;
	Для каждого стрРаздел из ФормаФП.ДеревоПолитикаПервичная.ПолучитьЭлементы() Цикл
		Для каждого стрФонд из стрРаздел.ПолучитьЭлементы() Цикл
			если стрФонд.РежимРасчета = ПредопределенноеЗначение("Перечисление.ИА_РежимРасчетаСуммы.РучнойВвод") Тогда
				Если РазделятьНалБезнал Тогда
					стрФонд.СуммаНал = ТекСуммаФонда; 
				КонецЕсли;
				стрФонд.СуммаБезнал = ТекСуммаФонда;
				стрФонд.Итого = стрФонд.СуммаНал + стрФонд.СуммаБезнал;
				ТекСуммаФонда = ТекСуммаФонда + 3000;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	// спецдоход
	ФормаФП.Объект.ДоходыБП.Очистить();
	ТекСуммаСпец = 10000;
	Для каждого стр из Спецдоход Цикл
		Новстр = ФормаФП.Объект.ДоходыБП.Добавить();
		Новстр.ВидДохода = стр.Значение;
		Новстр.СуммаБезнал = ТекСуммаСпец;
		Если РазделятьНалБезнал Тогда
			Новстр.СуммаНал = ТекСуммаСпец; 
		КонецЕсли;
		
		ТекСуммаСпец = ТекСуммаСпец + 3000;
	КонецЦикла;
	
	// распределение спецдохода
	ФормаФП.Объект.ДоходыБП_Распределение.Очистить();
	ТекСуммаСпец = 20000;
	Для каждого стр из Спецдоход Цикл
		Новстр = ФормаФП.Объект.ДоходыБП_Распределение.Добавить();
		Новстр.ВидДохода = стр.Значение;
		Новстр.СуммаБезнал = ТекСуммаСпец;
		Если РазделятьНалБезнал Тогда
			Новстр.СуммаНал = ТекСуммаСпец; 
		КонецЕсли;
		
		ТекСуммаСпец = ТекСуммаСпец + 3000;
	КонецЦикла;
	
	// политика 2
	ТекСуммаФонда = 10000;
	Для каждого стрРаздел из ФормаФП.ДеревоПолитика.ПолучитьЭлементы() Цикл
		Для каждого стрФонд из стрРаздел.ПолучитьЭлементы() Цикл
			если стрФонд.РежимРасчета = ПредопределенноеЗначение("Перечисление.ИА_РежимРасчетаСуммы.РучнойВвод") Тогда
				Если РазделятьНалБезнал Тогда
					стрФонд.СуммаНал = ТекСуммаФонда; 
				КонецЕсли;
				стрФонд.СуммаБезнал = ТекСуммаФонда;
				стрФонд.Итого = стрФонд.СуммаНал + стрФонд.СуммаБезнал;
				ТекСуммаФонда = ТекСуммаФонда + 3000;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры


&НаКлиенте
Процедура ФП_ДоходыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	Элементы.ПолеФормула.ВыделенныйТекст = "[Доход:"+Элемент.ТекущиеДанные.ВидДохода+"]";
КонецПроцедуры

&НаКлиенте
Процедура ФП_ДоходыБПВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	Элементы.ПолеФормула.ВыделенныйТекст = "[Спецдоход:"+Элемент.ТекущиеДанные.ВидДохода+"]";
КонецПроцедуры

