&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ИспользоватьРаспределениеСФондов = Константы.ИА_ИспользоватьРаспределениеСФондов.Получить();
	ИспользоватьСпецдоход = Константы.ИА_ИспользоватьСпецдоход.Получить();
	РазделятьНалБезнал            = Константы.ИА_ФП_РазделятьНалИБезнал.Получить();
КонецПроцедуры

&НаКлиенте
Процедура РаспределениеСредствСФондов(Команда)
	подр = ПредопределенноеЗначение("Справочник.ИА_ЦФО.ПустаяСсылка");
	фонд = ПредопределенноеЗначение("Справочник.ИА_Фонды.ПустаяСсылка");
	ПоказатьВводЗначения(Новый ОписаниеОповещения("РаспределениеСредствСФондовЗавершение", ЭтотОбъект, Новый Структура("фонд, подр", фонд, подр)), подр, "Выберите подразделение");
КонецПроцедуры

&НаКлиенте
Процедура РаспределениеСредствСФондовЗавершение(Значение, ДополнительныеПараметры) Экспорт
	
	фонд = ДополнительныеПараметры.фонд;
	подр = ?(Значение = Неопределено, ДополнительныеПараметры.подр, Значение);
	
	
	ПоказатьВводЗначения(Новый ОписаниеОповещения("РаспределениеСредствСФондовЗавершениеЗавершение", ЭтотОбъект, Новый Структура("Значение, подр, фонд", Значение, подр, фонд)), фонд, "Выберите фонд");

КонецПроцедуры

&НаКлиенте
Процедура РаспределениеСредствСФондовЗавершениеЗавершение(Значение1, ДополнительныеПараметры1) Экспорт
	
	Значение = ДополнительныеПараметры1.Значение;
	подр = ДополнительныеПараметры1.подр;
	фонд = ?(Значение1 = Неопределено, ДополнительныеПараметры1.фонд, Значение1);
	
	
	Если (Значение <> Неопределено) И (Значение1 <> Неопределено) тогда
		Элементы.ПолеФормула.ВыделенныйТекст = "[РСФ Сумма:"+подр+"$"+фонд+"]";
	КонецЕсли;

КонецПроцедуры

