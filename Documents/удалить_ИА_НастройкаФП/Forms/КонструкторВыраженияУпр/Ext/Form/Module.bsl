&НаКлиенте
Процедура ДеревоПолитика1Выбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	// Вставить содержимое обработчика.
	Если Элемент.ТекущиеДанные.Раздел = "СКД:" Тогда
		Элементы.ПолеФормула.ВыделенныйТекст = "[П1 Итог:"+Элемент.ТекущиеДанные.Раздел1+"]";
	ИначеЕсли Не ЗначениеЗаполнено(Элемент.ТекущиеДанные.Фонд) тогда
		Элементы.ПолеФормула.ВыделенныйТекст = "[П1 Итог:"+Элемент.ТекущиеДанные.Раздел+"]";
	Иначе
		Элементы.ПолеФормула.ВыделенныйТекст = "[П1 Сумма:"+Элемент.ТекущиеДанные.Подразделение+"$"+Элемент.ТекущиеДанные.Фонд+"]";
	КонецЕсли;
	
	СтандартнаяОбработка = Ложь;

КонецПроцедуры

