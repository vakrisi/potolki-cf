Перем ТаблицаСоответствийВидовСравнений;

Процедура УстановитьНастройкиКомпоновщика(КомпоновщикНастроек) Экспорт
		
	СКД = Документы.удалить_ИА_НастройкаФП.ПолучитьМакет("МакетСКД");
	Если ЗначениеЗаполнено(ИсточникДанных) Тогда
		СКД.НаборыДанных.НаборДанных1.Запрос = "ВЫБРАТЬ * ИЗ " + ИсточникДанных + " КАК Источник323";
	Иначе
		Возврат;
	КонецЕсли;
	
	АдресСКД = ПоместитьВоВременноеХранилище(СКД, Новый УникальныйИдентификатор);
    КомпоновщикНастроек.ЗагрузитьНастройки(СКД.НастройкиПоУмолчанию);
	КомпоновщикНастроек.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(АдресСКД)); //отвечает за доступность полей выбора
	   	
КонецПроцедуры 

Функция ПолучитьТаблицуОтборов()
	тзОтборы = Новый ТаблицаЗначений;
	тзОтборы.Колонки.Добавить("ИмяПараметра");
	тзОтборы.Колонки.Добавить("ЛевоеЗначение");
	тзОтборы.Колонки.Добавить("ВидСравнения");
	тзОтборы.Колонки.Добавить("ПравоеЗначение");
	
	КомпоновщикНастроек = Новый КомпоновщикНастроекКомпоновкиДанных;
	Настр = ПолучитьНастройкиXML();
	Если Не Настр = НЕопределено Тогда
		КомпоновщикНастроек.ЗагрузитьНастройки(Настр);
		НаборНастроек = КомпоновщикНастроек.Настройки.Отбор.Элементы;
		
		Для каждого с из НаборНастроек Цикл
			Если Не с.Использование Тогда Продолжить КонецЕсли;
			ИмяПараметра = СтрЗаменить(Строка(с.ЛевоеЗначение), ".", "");
			НовыйОтбор = тзОтборы.Добавить();
			НовыйОтбор.ИмяПараметра = ИмяПараметра;
			НовыйОтбор.ЛевоеЗначение = с.ЛевоеЗначение;
			НовыйОтбор.ВидСравнения = с.ВидСравнения;
			НовыйОтбор.ПравоеЗначение = с.ПравоеЗначение;
		КонецЦикла;
	КонецЕсли;
	
	Возврат тзОтборы;
	
КонецФункции // ПолучитьТаблицуОтборов()

Процедура ВосстановитьНастройки(КомпоновщикНастроек) Экспорт
	
	УстановитьНастройкиКомпоновщика(КомпоновщикНастроек);
	//Если Не ПустаяСтрока(СокрЛП(ИсточникНастройкаОтбора)) Тогда
	Если ИА_НастройкаОтбораХранилище.Получить()<>Неопределено Тогда
		КомпоновщикНастроек.ЗагрузитьНастройки(ПолучитьНастройкиXML());
	КонецЕсли; 
	
КонецПроцедуры 

Функция ПолучитьЗапросКонструктора()
	
	Запрос = Новый Запрос;
			                                   
	ШаблонЗапроса1 = "ВЫБРАТЬ Источник323.<Контрагент> КАК Контрагент,
	                    |Источник323.<Период> КАК Период,
						|Источник323.<Статья> КАК Продукт,
						|Источник323.<Сумма> КАК Сумма
						|ИЗ <ИсточникДанных> КАК Источник323
						|ГДЕ 1 = 1 И 2 = 2"; //шаблон запроса для простого случая
						
	ШаблонЗапроса2 = "ВЫБРАТЬ Источник323.<Контрагент> КАК Контрагент,
						|Источник323.<Период> КАК Период,
						|Источник323.<Статья> КАК Продукт,
						|Источник323.<Сумма> КАК Сумма
						|ИЗ <ИсточникДанных>(<&ДатаКонца>, 1 = 1) КАК Источник323
						|ГДЕ 2 = 2"; //шаблон запроса для Остатки, СрезПервых, СрезПоследних
						
	ШаблонЗапроса3 = "ВЫБРАТЬ Источник323.<Контрагент> КАК Контрагент,
						|Источник323.<Период> КАК Период,
						|Источник323.<Статья> КАК Продукт,
						|Источник323.<Сумма> КАК Сумма
						|ИЗ <ИсточникДанных>(<&ДатаНачала>, <&ДатаКонца>, Регистратор, 1 = 1) КАК Источник323
						|ГДЕ 2 = 2"; //шаблон запроса для Обороты
						
	
						
						
	ТекстЗапросаКонструктора = ШаблонЗапроса1;	
	НомерШаблона = 1;
	Если Найти(ИсточникДанных, ".Остатки") <> 0 
		Или Найти(ИсточникДанных, ".СрезПервых") <> 0 
		Или Найти(ИсточникДанных, ".СрезПоследних") <> 0 Тогда
		ТекстЗапросаКонструктора = ШаблонЗапроса2;
		НомерШаблона = 2;
	ИначеЕсли Найти(ИсточникДанных, ".Обороты") <> 0 Тогда
		ТекстЗапросаКонструктора = ШаблонЗапроса3;
		НомерШаблона = 3;
	КонецЕсли;	
	
	//Формируем таблицу условий					
	
	Условие1 = "";  // 1 = 1
	Условие2 = "";	// 2 = 2
	тзНаборПараметров = ПолучитьТаблицуОтборов();
	ЭтоДокумент = Найти(ИсточникДанных, "Документ.") <> 0;
	
	Если ЭтоДокумент Тогда
		ЭтоТабЧасть = СтрЧислоВхождений(ИсточникДанных, ".") = 2;
		ПутьРеквизитаДата = ?(ЗначениеЗаполнено(ИсточникДата),ИсточникДата,"Дата");
		//Если ЭтоТабЧасть Тогда
		//	ПутьРеквизитаДата = "Ссылка." + ПутьРеквизитаДата;
		//КонецЕсли;
		ТекстЗапросаКонструктора = СтрЗаменить(ТекстЗапросаКонструктора, "<Период>", ПутьРеквизитаДата); 
		Условие1 = "Источник323." + ПутьРеквизитаДата + " Между &ДатаНачала И &ДатаКонца";
		
		Для каждого с из тзНаборПараметров Цикл
			Если ПустаяСтрока(Условие2) Тогда
				Условие2 = ФормируемУсловие(с, Запрос);
			Иначе
				Условие2 = Условие2 + " И " + ФормируемУсловие(с, Запрос);
			КонецЕсли;
		КонецЦикла;	
		
	Иначе
		
		Для каждого с из тзНаборПараметров Цикл
			ЭтоИзмерение = (ЭтоИзмерениеРесурс(ИсточникДанных, Строка(с.ЛевоеЗначение)) = 1);
			Если ЭтоИзмерение Тогда   
				Если ПустаяСтрока(Условие1) Тогда
					Условие1 = ФормируемУсловие(с, Запрос);
				Иначе
					Условие1 = Условие1 + " И " + ФормируемУсловие(с, Запрос);
				КонецЕсли;	
			Иначе 
				Если ПустаяСтрока(Условие2) Тогда
					Условие2 = ФормируемУсловие(с, Запрос);
				Иначе
					Условие2 = Условие2 + " И " + ФормируемУсловие(с, Запрос);
				КонецЕсли;
			КонецЕсли;	
		КонецЦикла;
		
		//
		Если НомерШаблона <> 1 И ЗначениеЗаполнено(ИсточникДата) Тогда 
			ПутьРеквизитаДата = ИсточникДата;
			//Путь к периоду сложный, перенесем условия по дате из виртуальной таблицы в условия
			ВиртПарамДатаНачала = "";
			ВиртПарамДатаКонца = "";
			Если ПустаяСтрока(Условие2) Тогда
				Условие2 = 					  "Источник323." + ПутьРеквизитаДата + " Между &ДатаНачала И &ДатаКонца";
			Иначе
				Условие2 = Условие2 + " И " + "Источник323." + ПутьРеквизитаДата + " Между &ДатаНачала И &ДатаКонца";
			КонецЕсли;
		Иначе
			ПутьРеквизитаДата = "Период";
			ВиртПарамДатаНачала = "&ДатаНачала";
			ВиртПарамДатаКонца = "&ДатаКонца";
		КонецЕсли;
		ТекстЗапросаКонструктора = СтрЗаменить(ТекстЗапросаКонструктора, "<Период>", ПутьРеквизитаДата);
		ТекстЗапросаКонструктора = СтрЗаменить(ТекстЗапросаКонструктора, "<&ДатаНачала>", ВиртПарамДатаНачала);
		ТекстЗапросаКонструктора = СтрЗаменить(ТекстЗапросаКонструктора, "<&ДатаКонца>", ВиртПарамДатаКонца);	
		//
		
	КонецЕсли;
		
	Если ЗначениеЗаполнено(ИсточникКонтрагент) Тогда
		ТекстЗапросаКонструктора = СтрЗаменить(ТекстЗапросаКонструктора, "<Контрагент>", ИсточникКонтрагент);
	Иначе
		ТекстЗапросаКонструктора = СтрЗаменить(ТекстЗапросаКонструктора, "Источник323.<Контрагент>", "НЕОПРЕДЕЛЕНО");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ИсточникСтатья) Тогда
		ТекстЗапросаКонструктора = СтрЗаменить(ТекстЗапросаКонструктора, "<Статья>", ИсточникСтатья);
	Иначе
	    ТекстЗапросаКонструктора = СтрЗаменить(ТекстЗапросаКонструктора, "Источник323.<Статья>", "НЕОПРЕДЕЛЕНО");
	КонецЕсли;	
		
	ТекстЗапросаКонструктора = СтрЗаменить(ТекстЗапросаКонструктора, "<Сумма>", ИсточникСумма);
	ТекстЗапросаКонструктора = СтрЗаменить(ТекстЗапросаКонструктора, "<ИсточникДанных>", ИсточникДанных);
		
	Если Не ПустаяСтрока(Условие1) Тогда
		ТекстЗапросаКонструктора = СтрЗаменить(ТекстЗапросаКонструктора, "1 = 1", Условие1);
	КонецЕсли;
	Если Не ПустаяСтрока(Условие2) Тогда
		ТекстЗапросаКонструктора = СтрЗаменить(ТекстЗапросаКонструктора, "2 = 2", Условие2);
	КонецЕсли;
	
	Запрос.Текст = ТекстЗапросаКонструктора;
	
	Возврат Запрос;

КонецФункции // ПолучитьЗапрос()

Функция ФормируемУсловие(стр, Запрос)
	ИмяПараметра = стр.ИмяПараметра;
	ЛевоеЗначение = стр.ЛевоеЗначение;
	ПравоеЗначение = стр.ПравоеЗначение;
	ВидСравненияЗн = стр.ВидСравнения;	
	Условие = "";
	
	Если ВидСравнения <> ВидСравненияКомпоновкиДанных.НеЗаполнено 
		И ВидСравнения <> ВидСравненияКомпоновкиДанных.Заполнено Тогда
		Условие = Строка(ЛевоеЗначение) + ТаблицаСоответствийВидовСравнений.Получить(ВидСравненияЗн);
		Условие = СтрЗаменить(Условие, "<ИмяПараметра>", ИмяПараметра);
		Запрос.УстановитьПараметр(ИмяПараметра, ПравоеЗначение);
	Иначе
		Условие = Строка(ЛевоеЗначение) + ТаблицаСоответствийВидовСравнений.Получить(ВидСравненияЗн);
	КонецЕсли;
	
	Возврат Условие;
	
КонецФункции

