// Возвращает:
// 1 - Измерение
// 2 - Ресурс, Реквизит
Функция ЭтоИзмерениеРесурс(ИмяОбъектаМетаданных, ИмяРеквизита)
	
	Если Не Найти(ИмяОбъектаМетаданных, "Документ.") = 0 Тогда
		Возврат 2;
	ИначеЕсли Не Найти(ИмяОбъектаМетаданных, "Регистр") = 0 Тогда
		ИмяРегистра = ПреобразоватьИмяРегистра(ИмяОбъектаМетаданных);
		ИмяРеквизита = ПреобразоватьИмяРесурса(ИмяОбъектаМетаданных, ИмяРеквизита);
		ЭтоРегистрБухгалтерии = Найти(ИмяРегистра, "РегистрБухгалтерии.") <> 0;
		Если ЭтоРегистрБухгалтерии Тогда
			ПолеИзмерения = Метаданные.НайтиПоПолномуИмени(ИмяРегистра).Ресурсы.Найти(ИмяРеквизита);
			Если ПолеИзмерения = Неопределено Тогда
				Возврат 1;
			Иначе
				Возврат 2;
			КонецЕсли;
		Иначе
			ПолеИзмерения = Метаданные.НайтиПоПолномуИмени(ИмяРегистра).Измерения.Найти(ИмяРеквизита);
			Если ПолеИзмерения = Неопределено Тогда
				Возврат 2;
			Иначе
				Возврат 1;
			КонецЕсли;	
		КонецЕсли;
	КонецЕсли;    
	
	Возврат 2;

КонецФункции 

Функция ПреобразоватьИмяРегистра(Знач ИмяРегистра) Экспорт
	ИмяРегистра = СтрЗаменить(ИмяРегистра, ".ОстаткиИОбороты", "");
	ИмяРегистра = СтрЗаменить(ИмяРегистра, ".Обороты", "");
	ИмяРегистра = СтрЗаменить(ИмяРегистра, ".Остатки", "");
	ИмяРегистра = СтрЗаменить(ИмяРегистра, ".СрезПервых", "");
	ИмяРегистра = СтрЗаменить(ИмяРегистра, ".СрезПоследних", "");
	ИмяРегистра = СтрЗаменить(ИмяРегистра, ".ДвиженияССубконто", "");
	                                         
	Возврат ИмяРегистра;

КонецФункции // ПреобразоватьИмяРегистра()

Функция ПреобразоватьИмяРесурса(ИмяРегистра, Знач ИмяРесурса) Экспорт
	ДлинаИмяРесурса = СтрДлина(ИмяРесурса);
	
	Если Найти(ИмяРегистра, ".ОстаткиИОбороты") > 0 Тогда
		
		КонечныйОстаток = "КонечныйОстаток";	ДлинаКонОст = СтрДлина(КонечныйОстаток);
		НачальныйОстаток = "НачальныйОстаток";  ДлинаНачОст = СтрДлина(НачальныйОстаток);
		Оборот = "Оборот";						ДлинаОборот = СтрДлина(Оборот);
		Приход = "Приход";						ДлинаПриход = СтрДлина(Приход);
		Расход = "Расход";						ДлинаРасход = СтрДлина(Расход);
		Если Прав(ИмяРесурса, ДлинаКонОст) = КонечныйОстаток Тогда
			ИмяРесурса = Лев(ИмяРесурса, ДлинаИмяРесурса - ДлинаКонОст);
		ИначеЕсли Прав(ИмяРесурса, ДлинаНачОст) = НачальныйОстаток Тогда
			ИмяРесурса = Лев(ИмяРесурса, ДлинаИмяРесурса - ДлинаНачОст);
		ИначеЕсли Прав(ИмяРесурса, ДлинаОборот) = Оборот Тогда
			ИмяРесурса = Лев(ИмяРесурса, ДлинаИмяРесурса - ДлинаОборот);
		ИначеЕсли Прав(ИмяРесурса, ДлинаПриход) = Приход Тогда
			ИмяРесурса = Лев(ИмяРесурса, ДлинаИмяРесурса - ДлинаПриход);
		ИначеЕсли Прав(ИмяРесурса, ДлинаРасход) = Расход Тогда
			ИмяРесурса = Лев(ИмяРесурса, ДлинаИмяРесурса - ДлинаРасход);
		КонецЕсли;	
		
	ИначеЕсли Найти(ИмяРегистра, ".Остатки") > 0 Тогда
		
		Остаток = "Остаток"; 	ДлинаОстаток = СтрДлина(Остаток);
		Если Прав(ИмяРесурса, ДлинаОстаток) = Остаток Тогда
			ИмяРесурса = Лев(ИмяРесурса, ДлинаИмяРесурса - ДлинаОстаток);
		КонецЕсли;
		
	ИначеЕсли Найти(ИмяРегистра, ".Обороты") > 0 Тогда
		
		Оборот = "Оборот";		ДлинаОборот = СтрДлина(Оборот);
		Приход = "Приход";		ДлинаПриход = СтрДлина(Приход);
		Расход = "Расход";		ДлинаРасход = СтрДлина(Расход);
		Если Прав(ИмяРесурса, ДлинаОборот) = Оборот Тогда
			ИмяРесурса = Лев(ИмяРесурса, ДлинаИмяРесурса - ДлинаОборот);
		ИначеЕсли Прав(ИмяРесурса, ДлинаПриход) = Приход Тогда
			ИмяРесурса = Лев(ИмяРесурса, ДлинаИмяРесурса - ДлинаПриход);
		ИначеЕсли Прав(ИмяРесурса, ДлинаРасход) = Расход Тогда
			ИмяРесурса = Лев(ИмяРесурса, ДлинаИмяРесурса - ДлинаРасход);
		КонецЕсли;
		
	КонецЕсли;

	Возврат ИмяРесурса;  	

КонецФункции // ПреобразоватьИмяРесурса()

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	 УдалитьЛишниеПараметры();
	Запрос = ПолучитьЗапросКонструктора();
	тзПараметры = Новый ТаблицаЗначений;
	тзПараметры.Колонки.Добавить("ИмяПараметра");
	тзПараметры.Колонки.Добавить("Значение");
	Для каждого Параметр из Запрос.Параметры Цикл
		стр = тзПараметры.Добавить();
		стр.ИмяПараметра = Параметр.Ключ;
		стр.Значение = Параметр.Значение;
	КонецЦикла;
	
	ИсточникХранилищеЗапросаКонстурктора = Новый ХранилищеЗначения(Новый Структура("Текст, Параметры", Запрос.Текст, тзПараметры));

КонецПроцедуры

Процедура УдалитьЛишниеПараметры()
	ВремТаб = ПараметрыВыраженияЗапроса.ВыгрузитьКолонки();
	
	Для каждого Стр из Доходы Цикл
		Отбор = Новый Структура();
		Отбор.Вставить("ВидДохода",Стр.ВидДохода);
		Отбор.Вставить("ВидПолученияДанных",Стр.ВидПолученияДанных);
		Строки = ПараметрыВыраженияЗапроса.НайтиСтроки(Отбор);
		Для Каждого Эл Из Строки Цикл
			Новстр = ВремТаб.Добавить();
