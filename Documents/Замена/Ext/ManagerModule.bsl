#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область Печать

// Заполняет список команд печати.
// 
// Параметры:
// КомандыПечати – ТаблицаЗначений – состав полей см. в функции УправлениеПечатью.СоздатьКоллекциюКомандПечати
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт
	
	КомандаПечати = КомандыПечати.Добавить();
    КомандаПечати.МенеджерПечати = "Документ.Замена";
    КомандаПечати.Идентификатор = "Накладная";
    КомандаПечати.Представление = НСтр("ru = 'Накладная'");
    КомандаПечати.ПроверкаПроведенияПередПечатью = Истина;
	
КонецПроцедуры

// Формирует печатные формы.
//
// Параметры:
// МассивОбъектов – Массив – ссылки на объекты, которые нужно распечатать;
// ПараметрыПечати – Структура – дополнительные настройки печати;
// КоллекцияПечатныхФорм – ТаблицаЗначений – сформированные табличные документы (выходной параметр)
// ОбъектыПечати – СписокЗначений – значение – ссылка на объект;
// представление – имя области, в которой был выведен объект (выходной параметр);
// ПараметрыВывода – Структура – дополнительные параметры сформированных табличных документов (выходной параметр).
//
Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
    Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "Накладная") Тогда
        УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "Накладная", НСтр("ru = 'Накладная'"), ПечатьНакладной(МассивОбъектов, ОбъектыПечати), , "Документ.Замена.ПФ_MXL_Накладная");
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьДанныеДляПечатныхФорм(МассивОбъектов) Экспорт
    
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Замена.Ссылка,
	|	Замена.ВерсияДанных,
	|	Замена.ПометкаУдаления,
	|	Замена.Номер,
	|	Замена.Дата КАК ДатаДокумента,
	|	""01.01.2001"" КАК Дата,
	|	Замена.Проведен,
	|	Замена.Основание,
	|	Замена.Комментарий,
	|	Замена.Автор,
	|	Замена.Склад,
	|	Замена.СуммаВозврата,
	|	Замена.СуммаВыдачи,
	|	Замена.СуммаДокумента,
	|	Замена.Основание.Номер КАК ОснованиеНомер,
	|	Замена.Основание.Дата КАК ДатаДокументаОснования,
	|	""01.01.2001"" КАК ОснованиеДата,
	|	Замена.Основание.Адрес КАК ОснованиеАдрес,
	|	Замена.Основание.Валюта КАК ОснованиеВалюта,
	|	Замена.Основание.ДоговорКонтрагента КАК ОснованиеДоговорКонтрагента,
	|	Замена.Основание.ИсполнительЗамера КАК ОснованиеИсполнительЗамера,
	|	Замена.Основание.Комментарий КАК ОснованиеКомментарий,
	|	Замена.Основание.Контрагент КАК ОснованиеКонтрагент,
	|	ВЫБОР КОГДА НЕ Замена.Основание.Контрагент.НаименованиеПолное = """"
	|		ТОГДА
	|			Замена.Основание.Контрагент.НаименованиеПолное
	|		ИНАЧЕ
	|			Замена.Основание.Контрагент.Наименование
	|		КОНЕЦ КАК ПредставлениеКонтрагента,
	|	Замена.Основание.Менеджер КАК ОснованиеМенеджер,
	|	Замена.Основание.НомерДоговора КАК ОснованиеНомерДоговора,
	|	Замена.Основание.Организация КАК Организация,
	|	Замена.Основание.Контрагент КАК Контрагент,
	|	Замена.Основание.Организация КАК ОснованиеОрганизация,
	|	Замена.Основание.Автор КАК ОснованиеАвтор,
	|	Замена.Основание.Подразделение КАК ОснованиеПодразделение,
	|	Замена.Основание.СуммаДокумента КАК ОснованиеСуммаДокумента,
	|	Замена.Основание.СуммаДокументаПоПрайсу КАК ОснованиеСуммаДокументаПоПрайсу,
	|	Замена.Основание.ТекущийСтатус КАК ОснованиеТекущийСтатус,
	|	Замена.Основание.ТочкаПродаж КАК ОснованиеТочкаПродаж
	|ИЗ
	|	Документ.Замена КАК Замена
	|ГДЕ
	|	Замена.Ссылка В(&МассивОбъектов)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Замена.Ссылка,
	|	Дата
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТаблицаВозврат.Ссылка,
	|	ТаблицаВозврат.НомерСтроки,
	|	ТаблицаВозврат.Номенклатура.Артикул КАК Артикул,
	|	ТаблицаВозврат.Номенклатура,
	|	ТаблицаВозврат.ХарактеристикаНоменклатуры,
	|	ТаблицаВозврат.СерияНоменклатуры,
	|	ТаблицаВозврат.Количество,
	|	ТаблицаВозврат.ЕдиницаИзмерения,
	|	ТаблицаВозврат.Коэффициент,
	|	ТаблицаВозврат.Цена,
	|	ТаблицаВозврат.Сумма
	|ИЗ
	|	Документ.Замена.ТаблицаВозврат КАК ТаблицаВозврат
	|ГДЕ
	|	ТаблицаВозврат.Ссылка В(&МассивОбъектов)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ТаблицаВозврат.Ссылка,
	|	ТаблицаВозврат.НомерСтроки
	|ИТОГИ ПО
	|	Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТаблицаВыдача.Ссылка,
	|	ТаблицаВыдача.НомерСтроки,
	|	ТаблицаВыдача.Номенклатура.Артикул КАК Артикул,
	|	ТаблицаВыдача.Номенклатура,
	|	ТаблицаВыдача.ХарактеристикаНоменклатуры,
	|	ТаблицаВыдача.СерияНоменклатуры,
	|	ТаблицаВыдача.Количество,
	|	ТаблицаВыдача.ЕдиницаИзмерения,
	|	ТаблицаВыдача.Коэффициент,
	|	ТаблицаВыдача.Цена,
	|	ТаблицаВыдача.ПроцентСкидки,
	|	ТаблицаВыдача.СуммаСкидки,
	|	ТаблицаВыдача.Сумма
	|ИЗ
	|	Документ.Замена.ТаблицаВыдача КАК ТаблицаВыдача
	|ГДЕ
	|	ТаблицаВыдача.Ссылка В(&МассивОбъектов)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ТаблицаВыдача.Ссылка,
	|	ТаблицаВыдача.НомерСтроки
	|ИТОГИ ПО
	|	Ссылка";

	МассивРезультатов         = Запрос.ВыполнитьПакет();
	РезультатПоШапке          = МассивРезультатов[0];
	РезультатПоТабличнойЧастиВозврат = МассивРезультатов[1];
	РезультатПоТабличнойЧастиВыдачи  = МассивРезультатов[2];

	СтруктураДанныхДляПечати 	= Новый Структура("РезультатПоШапке, РезультатПоТабличнойЧастиВозврат, РезультатПоТабличнойЧастиВыдачи",
	                                               РезультатПоШапке, РезультатПоТабличнойЧастиВозврат, РезультатПоТабличнойЧастиВыдачи);
	
	Возврат СтруктураДанныхДляПечати;
	
КонецФункции

Процедура ДополнитьДанныеДляПечатныхФорм(РезультатЗапроса) Экспорт
	
	ОбщийМодульСервер.ДобавитьКолонкиКонтактнойИнформации(РезультатЗапроса);
	
	Для Каждого ТекущаяСтрока Из РезультатЗапроса Цикл
		
		ТекущаяСтрока.Дата = Формат(ТекущаяСтрока.ДатаДокумента,"ДЛФ=Д");
		ТекущаяСтрока.ОснованиеДата = Формат(ТекущаяСтрока.ДатаДокументаОснования,"ДЛФ=Д");
		Попытка
			ТекущаяСтрока.ОснованиеНомер = ПрефиксацияОбъектовКлиентСервер.НомерНаПечать(ТекущаяСтрока.ОснованиеНомер);
		Исключение
		КонецПопытки;
		Попытка
			ТекущаяСтрока.Номер = ПрефиксацияОбъектовКлиентСервер.НомерНаПечать(ТекущаяСтрока.Номер);
		Исключение
		КонецПопытки;
		
		ОбщийМодульСервер.ДополнитьДанныеДляПечатныхФормКонтактнойИнформацией(ТекущаяСтрока, ТекущаяСтрока.Организация, ТекущаяСтрока.Контрагент);
		
	КонецЦикла;
	
КонецПроцедуры

Функция ПечатьНакладной(МассивОбъектов, ОбъектыПечати) Экспорт
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.АвтоМасштаб         = Истина; //#14053
	ТабличныйДокумент.ИмяПараметровПечати = "ПараметрыПечати_Замена_Накладная";
	Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.Замена.ПФ_MXL_Накладная");
	ВыводитьАртикул = Константы.ВыводитьАртикулНоменклатурыВПечатныхФормах.Получить();

	СтруктураДанныхДляПечати = ПолучитьДанныеДляПечатныхФорм(МассивОбъектов);
	ТаблицаДанныеПечати = СтруктураДанныхДляПечати.РезультатПоШапке.Выгрузить();	
	ВыборкаПоВыдачам = СтруктураДанныхДляПечати.РезультатПоТабличнойЧастиВыдачи.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	ВыборкаПоВозвратам = СтруктураДанныхДляПечати.РезультатПоТабличнойЧастиВозврат.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	ДополнитьДанныеДляПечатныхФорм(ТаблицаДанныеПечати);
	
	ПервыйДокумент = Истина;
	Для Каждого ДанныеПечати Из ТаблицаДанныеПечати Цикл
		
		Если Не ПервыйДокумент Тогда
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		ПервыйДокумент = Ложь;
		
		Попытка
			ОбластьМакета = Макет.ПолучитьОбласть("Заголовок");
			ОбластьМакета.Параметры.Заполнить(ДанныеПечати);
			ТабличныйДокумент.Вывести(ОбластьМакета);
		Исключение
		КонецПопытки;
		
		Попытка
			ОбластьМакета = Макет.ПолучитьОбласть("Организация");
			ОбластьМакета.Параметры.Заполнить(ДанныеПечати);
			ТабличныйДокумент.Вывести(ОбластьМакета);
		Исключение
		КонецПопытки;
		
		Попытка
			ОбластьМакета = Макет.ПолучитьОбласть("Склад");
			ОбластьМакета.Параметры.Заполнить(ДанныеПечати);
			ТабличныйДокумент.Вывести(ОбластьМакета);
		Исключение
		КонецПопытки;
		
		Попытка
			ОбластьМакета = Макет.ПолучитьОбласть("Покупатель");
			ОбластьМакета.Параметры.Заполнить(ДанныеПечати);
			ТабличныйДокумент.Вывести(ОбластьМакета);
		Исключение
		КонецПопытки;
		
		Попытка
			ОбластьМакета = Макет.ПолучитьОбласть("АдресМонтажа");
			ОбластьМакета.Параметры.Заполнить(ДанныеПечати);
			ТабличныйДокумент.Вывести(ОбластьМакета);
		Исключение
		КонецПопытки;
		
		Попытка
			ОбластьМакета = Макет.ПолучитьОбласть("СуммаДокумента");
			ОбластьМакета.Параметры.Заполнить(ДанныеПечати);
			ТабличныйДокумент.Вывести(ОбластьМакета);
		Исключение
		КонецПопытки;
		
		//ВОЗВРАТ
		Попытка
			ОбластьМакета = Макет.ПолучитьОбласть("ЗаголовокТаблицы");
			ОбластьМакета.Параметры.Заполнить(ДанныеПечати);
			ОбластьМакета.Параметры.ЗаголовокТаблицы = "ВОЗВРАЩЕНО";
			ТабличныйДокумент.Вывести(ОбластьМакета);
		Исключение
		КонецПопытки;
		
		// Изменения размера колоноки, в зависимости от вывода Артикула
		Если Не ВыводитьАртикул Тогда
			Попытка
				Макет.Область("ПерваяКолонкаТовара").ШиринаКолонки = Макет.Область("ПерваяКолонкаТовара").ШиринаКолонки + Макет.Область("Артикул").ШиринаКолонки;
			Исключение
			КонецПопытки;
		КонецЕсли;
		
		Попытка
			ОбластьМакета = Макет.ПолучитьОбласть("ШапкаТаблицы|НомерСтроки");
			ОбластьМакета.Параметры.Заполнить(ДанныеПечати);
			ТабличныйДокумент.Вывести(ОбластьМакета);
			
			Если ВыводитьАртикул Тогда
				ОбластьМакета = Макет.ПолучитьОбласть("ШапкаТаблицы|Артикул");
				ОбластьМакета.Параметры.Заполнить(ДанныеПечати);
				ТабличныйДокумент.Присоединить(ОбластьМакета);
			КонецЕсли;
			
			ОбластьМакета = Макет.ПолучитьОбласть("ШапкаТаблицы|Данные");
			ОбластьМакета.Параметры.Заполнить(ДанныеПечати);
			ТабличныйДокумент.Присоединить(ОбластьМакета);
		Исключение
		КонецПопытки;
		
		Сумма = 0;
		Количество = 0;
		СтруктураПоиска = Новый Структура("Ссылка", ДанныеПечати.Ссылка);
		
		ВыборкаПоВозвратам.Сбросить();
		Если ВыборкаПоВозвратам.НайтиСледующий(СтруктураПоиска) Тогда			
			Выборка = ВыборкаПоВозвратам.Выбрать();			
			Пока Выборка.Следующий() Цикл		
				Попытка				
					ОбластьМакета = Макет.ПолучитьОбласть("Строка|НомерСтроки");
					ОбластьМакета.Параметры.Заполнить(ДанныеПечати);
					ОбластьМакета.Параметры.Заполнить(Выборка);
					ТабличныйДокумент.Вывести(ОбластьМакета);
					
					Если ВыводитьАртикул Тогда
						ОбластьМакета = Макет.ПолучитьОбласть("Строка|Артикул");
						ОбластьМакета.Параметры.Заполнить(ДанныеПечати);
						ОбластьМакета.Параметры.Заполнить(Выборка);
						ТабличныйДокумент.Присоединить(ОбластьМакета);
					КонецЕсли;
					
					ОбластьМакета = Макет.ПолучитьОбласть("Строка|Данные");
					ОбластьМакета.Параметры.Заполнить(ДанныеПечати);
					ОбластьМакета.Параметры.Заполнить(Выборка);
					
					//++ №12909
					//ПредставлениеНоменклатуры = Строка(Выборка.Номенклатура) + Строка(УправлениеПечатью.ПредставлениеХарактеристики(Выборка.ХарактеристикаНоменклатуры));
					ПредставлениеНоменклатуры = ОбщийМодульСервер.ПредставлениеНоменклатурыДляПечати(Выборка.Номенклатура, Выборка.ХарактеристикаНоменклатуры);
					//-- №12909
					
					ОбластьМакета.Параметры.Номенклатура = ПредставлениеНоменклатуры;
					ТабличныйДокумент.Присоединить(ОбластьМакета);
					Количество = Количество + Выборка.Количество;
					Сумма = Сумма + Выборка.Сумма;
				Исключение
				КонецПопытки;		
			КонецЦикла;
		КонецЕсли;
		Попытка
			ОбластьМакета = Макет.ПолучитьОбласть("ИтогоТаблицы|НомерСтроки");
			ОбластьМакета.Параметры.Заполнить(ДанныеПечати);
			ТабличныйДокумент.Вывести(ОбластьМакета);
			
			Если ВыводитьАртикул Тогда
				ОбластьМакета = Макет.ПолучитьОбласть("ИтогоТаблицы|Артикул");
				ОбластьМакета.Параметры.Заполнить(ДанныеПечати);
				ТабличныйДокумент.Присоединить(ОбластьМакета);
			КонецЕсли;
			
			ОбластьМакета = Макет.ПолучитьОбласть("ИтогоТаблицы|Данные");
			ОбластьМакета.Параметры.Заполнить(ДанныеПечати);
			ОбластьМакета.Параметры.Количество = Количество;
			ОбластьМакета.Параметры.Сумма = Сумма;
			ТабличныйДокумент.Присоединить(ОбластьМакета);
		Исключение
		КонецПопытки;
		
		Попытка
			ОбластьМакета = Макет.ПолучитьОбласть("ПустаяСтрока");
			ТабличныйДокумент.Вывести(ОбластьМакета);
		Исключение
		КонецПопытки;
		Попытка
			ОбластьМакета = Макет.ПолучитьОбласть("ПустаяСтрока");
			ТабличныйДокумент.Вывести(ОбластьМакета);
		Исключение
		КонецПопытки;		
		
		//ВЫДАЧА
		Попытка
			ОбластьМакета = Макет.ПолучитьОбласть("ЗаголовокТаблицы");
			ОбластьМакета.Параметры.Заполнить(ДанныеПечати);
			ОбластьМакета.Параметры.ЗаголовокТаблицы = "ВЫДАНО";
			ТабличныйДокумент.Вывести(ОбластьМакета);
		Исключение
		КонецПопытки;
		Попытка
			ОбластьМакета = Макет.ПолучитьОбласть("ШапкаТаблицы|НомерСтроки");
			ОбластьМакета.Параметры.Заполнить(ДанныеПечати);
			ТабличныйДокумент.Вывести(ОбластьМакета);
			
			Если ВыводитьАртикул Тогда
				ОбластьМакета = Макет.ПолучитьОбласть("ШапкаТаблицы|Артикул");
				ОбластьМакета.Параметры.Заполнить(ДанныеПечати);
				ТабличныйДокумент.Присоединить(ОбластьМакета);
			КонецЕсли;
			
			ОбластьМакета = Макет.ПолучитьОбласть("ШапкаТаблицы|Данные");
			ОбластьМакета.Параметры.Заполнить(ДанныеПечати);
			ТабличныйДокумент.Присоединить(ОбластьМакета);
		Исключение
		КонецПопытки;
		
		Сумма = 0;
		Количество = 0;
		
		ВыборкаПоВыдачам.Сбросить();
		Если ВыборкаПоВыдачам.НайтиСледующий(СтруктураПоиска) Тогда			
			Выборка = ВыборкаПоВыдачам.Выбрать();			
			Пока Выборка.Следующий() Цикл				
				Попытка
					ОбластьМакета = Макет.ПолучитьОбласть("Строка|НомерСтроки");
					ОбластьМакета.Параметры.Заполнить(ДанныеПечати);
					ОбластьМакета.Параметры.Заполнить(Выборка);
					ТабличныйДокумент.Вывести(ОбластьМакета);
					
					Если ВыводитьАртикул Тогда
						ОбластьМакета = Макет.ПолучитьОбласть("Строка|Артикул");
						ОбластьМакета.Параметры.Заполнить(ДанныеПечати);
						ОбластьМакета.Параметры.Заполнить(Выборка);
						ТабличныйДокумент.Присоединить(ОбластьМакета);
					КонецЕсли;
					
					ОбластьМакета = Макет.ПолучитьОбласть("Строка|Данные");
					ОбластьМакета.Параметры.Заполнить(ДанныеПечати);
					ОбластьМакета.Параметры.Заполнить(Выборка);
					
					//++ №12909
					//ПредставлениеНоменклатуры = Строка(Выборка.Номенклатура) + Строка(УправлениеПечатью.ПредставлениеХарактеристики(Выборка.ХарактеристикаНоменклатуры));
					ПредставлениеНоменклатуры = ОбщийМодульСервер.ПредставлениеНоменклатурыДляПечати(Выборка.Номенклатура, Выборка.ХарактеристикаНоменклатуры);
					//-- №12909
					
					ОбластьМакета.Параметры.Номенклатура = ПредставлениеНоменклатуры;
					ТабличныйДокумент.Присоединить(ОбластьМакета);
					Количество = Количество + Выборка.Количество;
					Сумма = Сумма + Выборка.Сумма;
				Исключение
				КонецПопытки;		
			КонецЦикла;
		КонецЕсли;
	
		Попытка
			ОбластьМакета = Макет.ПолучитьОбласть("ИтогоТаблицы|НомерСтроки");
			ОбластьМакета.Параметры.Заполнить(ДанныеПечати);
			ТабличныйДокумент.Вывести(ОбластьМакета);
			
			Если ВыводитьАртикул Тогда
				ОбластьМакета = Макет.ПолучитьОбласть("ИтогоТаблицы|Артикул");
				ОбластьМакета.Параметры.Заполнить(ДанныеПечати);
				ТабличныйДокумент.Присоединить(ОбластьМакета);
			КонецЕсли;
			
			ОбластьМакета = Макет.ПолучитьОбласть("ИтогоТаблицы|Данные");
			ОбластьМакета.Параметры.Заполнить(ДанныеПечати);
			ОбластьМакета.Параметры.Количество = Количество;
			ОбластьМакета.Параметры.Сумма = Сумма;
			ТабличныйДокумент.Присоединить(ОбластьМакета);
		Исключение
		КонецПопытки;
		
		Попытка
			ОбластьМакета = Макет.ПолучитьОбласть("Подписи");
			ЗаполнитьЗначенияСвойств(ОбластьМакета.Параметры, ДанныеПечати);
			ТабличныйДокумент.Вывести(ОбластьМакета);
		Исключение
		КонецПопытки;
		
	КонецЦикла;	
		
	ТабличныйДокумент.ТолькоПросмотр = Истина;
	ТабличныйДокумент.ОтображатьЗаголовки = Ложь;
	ТабличныйДокумент.ОтображатьСетку = Ложь;
	
	Возврат ТабличныйДокумент;
	
КонецФункции

