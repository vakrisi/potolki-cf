#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
	
#Область Печать

Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт
	
    КомандаПечати = КомандыПечати.Добавить();
    КомандаПечати.МенеджерПечати = "Документ.СчетФактураВыданный";
    КомандаПечати.Идентификатор = "СчетФактура";
    КомандаПечати.Представление = НСтр("ru = 'Счет-фактура'");
    КомандаПечати.ПроверкаПроведенияПередПечатью = Истина;
	
    КомандаПечати = КомандыПечати.Добавить();
    КомандаПечати.МенеджерПечати = "Документ.СчетФактураВыданный";
    КомандаПечати.Идентификатор = "УПД";
    КомандаПечати.Представление = НСтр("ru = 'Универсальный передаточный документ'");
    КомандаПечати.ПроверкаПроведенияПередПечатью = Истина; 
	
КонецПроцедуры

Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "СчетФактура") Тогда
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
			КоллекцияПечатныхФорм, 
			"СчетФактура", 
			НСтр("ru = 'Счет-фактура'"), 
			ПечатьСчетФактуры(МассивОбъектов, ОбъектыПечати));
	
	ИначеЕсли УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "УПД") Тогда
        УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
			КоллекцияПечатныхФорм, 
			"УПД", 
			НСтр("ru = 'Универсальный передаточный документ'"), 
			ПечатьУПД(МассивОбъектов, ОбъектыПечати));
	
		КонецЕсли;
		
КонецПроцедуры

Функция ПечатьСчетФактуры(МассивОбъектов, ОбъектыПечати) Экспорт
	
 	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.АвтоМасштаб         = Истина; //#14053
	ТабличныйДокумент.ОриентацияСтраницы  = ОриентацияСтраницы.Ландшафт;
    ТабличныйДокумент.ИмяПараметровПечати = "ПараметрыПечати_СчетФактура";
	//Макет = УправлениеПечатью.МакетПечатнойФормы("ОбщийМакет.ПФ_MXL_СчетФактура981"); //ПолучитьОбщийМакет("ПФ_MXL_СчетФактура981");
	
	ПервыйДокумент = Истина;
	Для каждого ДокументПечати из МассивОбъектов Цикл
		Если ТипЗнч(ДокументПечати) = Тип("ДокументСсылка.РеализацияТоваровИУслуг") Тогда
			ДокументСчетФактуры = НайтиСчетФактуру(ДокументПечати);
			Если ДокументСчетФактуры = Неопределено Тогда
				ТекстОшибки = НСтр("ru = 'Для документа %1 не введен счет-фактура'");
				ТекстОшибки = СтрЗаменить(ТекстОшибки, "%1", Строка(ДокументПечати));
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
			
				Возврат ТабличныйДокумент;
			Иначе
				ДанныеДляПечати = СобратьДанныеДляПечатиСчетФактурыПоРеализацииТоваровИУслуг(ДокументПечати, ДокументСчетФактуры);
			КонецЕсли;
			
		ИначеЕсли ТипЗнч(ДокументПечати) = Тип("ДокументСсылка.Монтаж") Тогда
			ДокументСчетФактуры = НайтиСчетФактуру(ДокументПечати);
			Если ДокументСчетФактуры = Неопределено Тогда
				ТекстОшибки = НСтр("ru = 'Для документа %1 не введен счет-фактура'");
				ТекстОшибки = СтрЗаменить(ТекстОшибки, "%1", Строка(ДокументПечати));
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
			
				Возврат ТабличныйДокумент;
			Иначе
				ДанныеДляПечати = СобратьДанныеДляПечатиСчетФактурыПоМонтажу(ДокументПечати, ДокументСчетФактуры);
			КонецЕсли;

		ИначеЕсли ТипЗнч(ДокументПечати) = Тип("ДокументСсылка.СчетФактураВыданный") Тогда
			Если ТипЗнч(ДокументПечати.Основание) = Тип("ДокументСсылка.РеализацияТоваровИУслуг") Тогда
				ДанныеДляПечати = СобратьДанныеДляПечатиСчетФактурыПоРеализацииТоваровИУслуг(ДокументПечати.Основание, ДокументПечати);
			ИначеЕсли ТипЗнч(ДокументПечати.Основание) = Тип("ДокументСсылка.Монтаж") Тогда
				ДанныеДляПечати = СобратьДанныеДляПечатиСчетФактурыПоМонтажу(ДокументПечати.Основание, ДокументПечати);
			КонецЕсли;
		КонецЕсли;
		
		ДанныеПечати = ДанныеДляПечати.Выбрать(); 
		Если ДанныеПечати.Следующий() Тогда
			
			Если ТипЗнч(ДанныеПечати.Ссылка) = Тип("ДокументСсылка.Монтаж") Тогда
				ДатаПодписанияДокумента = ОбщийМодульСервер.ПолучитьДатуПодписанияДокументаМонтажа(ДанныеПечати.Ссылка);
			Иначе
				ДатаПодписанияДокумента = ДанныеПечати.Дата;
			КонецЕсли;
			
			Если ДанныеПечати.Дата < '20210701' Тогда
				ТабличныйДокумент.ИмяПараметровПечати = "ПараметрыПечати_СчетФактура";
				Макет = УправлениеПечатью.МакетПечатнойФормы("ОбщийМакет.ПФ_MXL_СчетФактура981");
			Иначе
				ТабличныйДокумент.ИмяПараметровПечати = "ПараметрыПечати_СчетФактура534";
				Макет = УправлениеПечатью.МакетПечатнойФормы("ОбщийМакет.ПФ_MXL_СчетФактура534");				
			КонецЕсли;
	
			КоличествоСтраниц = 1;
			
			Если Не ПервыйДокумент Тогда
				ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
			КонецЕсли;
			ПервыйДокумент = Ложь;
			НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы + 1;
			
			// раньше было отдельной строкой 
			Если ДанныеПечати.Дата < '20210701' Тогда
				ОбластьМакета = Макет.ПолучитьОбласть("ЗаголовокПФ");
				ТабличныйДокумент.Вывести(ОбластьМакета);
			КонецЕсли;
			
			КоличествоСтрок = 0;			
			ТЧТовары = ДанныеПечати.Товары.Выгрузить();
			ТЧТовары.Свернуть("ТоварКодТНВЭД,Акциз,СтранаПроисхожденияКод,ПредставлениеСтраны,ПредставлениеГТД,
							|Номенклатура,ХарактеристикаНоменклатуры,СерияНоменклатуры,ЕдиницаИзмерения,ЕдиницаИзмеренияКод,Коэффициент,Цена,СтавкаНДС",
    						"Количество,Всего,СуммаНДС,Стоимость");	
			КоличествоСтрок = ТЧТовары.Количество();
			ЕстьУслуги = Ложь;
			Попытка 
				ТЧУслуги = ДанныеПечати.Услуги.Выгрузить();
				ТЧУслуги.Свернуть("ТоварКодТНВЭД,Акциз,СтранаПроисхожденияКод,ПредставлениеСтраны,ПредставлениеГТД,
							|Номенклатура,ХарактеристикаНоменклатуры,ЕдиницаИзмерения,ЕдиницаИзмеренияКод,Коэффициент,Цена,СтавкаНДС",
    						"Количество,Всего,СуммаНДС,Стоимость");	
				КоличествоСтрок = КоличествоСтрок + ТЧУслуги.Количество();
				ЕстьУслуги = Истина;
			Исключение
			КонецПопытки;
			
			ОбластьМакета = Макет.ПолучитьОбласть("Шапка");
			НомерДокумента = ПрефиксацияОбъектовКлиентСервер.НомерНаПечать(ДанныеПечати.Номер);
			СведенияОбОрганизации = ОбщийМодульСервер.СведенияОбОрганизации(ДанныеПечати.Организация, ДанныеПечати.Дата);
			СведенияОбКонтрагенте = ОбщийМодульСервер.СведенияОКонтрагенте(ДанныеПечати.Контрагент, ДанныеПечати.Дата);
			
			Если ДанныеПечати.Дата < '20210701' Тогда
				//ОбластьМакета.Параметры.Номер = "Счет-фактура № " + НомерДокумента + " от " + Формат(ДанныеПечати.Дата,"ДФ='dd MMMM yyyy ''г.'''");
				ОбластьМакета.Параметры.Номер = "Счет-фактура № " + НомерДокумента + " от " + Формат(ДатаПодписанияДокумента,"ДФ='dd MMMM yyyy ''г.'''");
				
				ОбластьМакета.Параметры.НомерИсправления = "Исправление № -- от --";
				ЗаголовокПоставщика      = "Продавец: ";
				ЗаголовокАдресПоставщика = "Адрес: ";
				ЗаголовокИННпоставщика   = "ИНН/КПП продавца: ";
				ЗаголовокГрузоотправителя = "Грузоотправитель и его адрес: ";
				ЗаголовокГрузополучателя  = "Грузополучатель и его адрес: ";
				ЗаголовокПРД = "К платежно-расчетному документу № ";
				
				ЗаголовокПокупателя      = "Покупатель: ";
				ЗаголовокАдресПокупателя = "Адрес: ";
				ЗаголовокИННПокупателя   = "ИНН/КПП покупателя: ";
				ЗаголовокВалюта = "Валюта: наименование, код ";
			Иначе
				ОбластьМакета.Параметры.Номер = НомерДокумента;
				//ОбластьМакета.Параметры.Дата = Формат(ДанныеПечати.Дата, "ДФ='dd MMMM yyyy ''г.'''");
				ОбластьМакета.Параметры.Дата = Формат(ДатаПодписанияДокумента, "ДФ='dd MMMM yyyy ''г.'''");
				ОбластьМакета.Параметры.НомерИсправления = "--";
				ОбластьМакета.Параметры.ДатаИсправления = "--";
				ЗаголовокПоставщика      = "";
				ЗаголовокАдресПоставщика = "";
				ЗаголовокИННпоставщика   = "";
				ЗаголовокГрузоотправителя = "";
				ЗаголовокГрузополучателя  = "";
				ЗаголовокПРД = "";
				
				ЗаголовокПокупателя      = "";
				ЗаголовокАдресПокупателя = "";
				ЗаголовокИННПокупателя   = "";
				
				ЗаголовокВалюта = "";		
			КонецЕсли;			
			
			ОбластьМакета.Параметры.ПредставлениеПоставщика	= ЗаголовокПоставщика + ДанныеПечати.ОрганизацияПолноеНаименование;
			ОбластьМакета.Параметры.АдресПоставщика	= ЗаголовокАдресПоставщика + СведенияОбОрганизации.ЮридическийАдрес;
			ОбластьМакета.Параметры.ИННПоставщика	= ЗаголовокИННпоставщика + ?(ЗначениеЗаполнено(ДанныеПечати.ИНН), ДанныеПечати.ИНН, "") + ?(ЗначениеЗаполнено(ДанныеПечати.КПП), "/"+ДанныеПечати.КПП, "");
			ОбластьМакета.Параметры.ПредставлениеГрузоотправителя	= ЗаголовокГрузоотправителя + "--";													
			ОбластьМакета.Параметры.ПредставлениеГрузополучателя	= ЗаголовокГрузополучателя + "--";													
			ОбластьМакета.Параметры.ПоДокументу		= ЗаголовокПРД + "-- от --";
			Если ДанныеПечати.Дата >= '20210701' Тогда
				ОбластьМакета.Параметры.ДокументыОбОтгрузке = СведенияОДокументеОтгрузки(ДанныеПечати, КоличествоСтрок);
			КонецЕсли;				
			ОбластьМакета.Параметры.ПредставлениеПокупателя	= ЗаголовокПокупателя + ДанныеПечати.КонтрагентНаименованиеПолное;
			ОбластьМакета.Параметры.АдресПокупателя	= ЗаголовокАдресПокупателя + СведенияОбКонтрагенте.ЮридическийАдрес; 
			ОбластьМакета.Параметры.ИННПокупателя	= ЗаголовокИННПокупателя + ?(ЗначениеЗаполнено(ДанныеПечати.КонтрагентИНН), ДанныеПечати.КонтрагентИНН, "") + ?(ЗначениеЗаполнено(ДанныеПечати.КонтрагентКПП), "/"+ДанныеПечати.КонтрагентКПП, "");		
			ОбластьМакета.Параметры.Валюта	= ЗаголовокВалюта + ДанныеПечати.ВалютаНаименование + ", " + ДанныеПечати.ВалютаКод;														
			ТабличныйДокумент.Вывести(ОбластьМакета);
			
			// раньше было отдельной строкой 
			Если ДанныеПечати.Дата < '20210701' Тогда
				ОбластьМакета = Макет.ПолучитьОбласть("ИдентификаторГосКонтракта");
				ОбластьМакета.Параметры.ИдентификаторГосКонтракта = "Идентификатор государственного контракта, договора (соглашения) (при наличии): " + ДанныеПечати.ИдентификаторГосКонтракта;													
				ТабличныйДокумент.Вывести(ОбластьМакета);												
			КонецЕсли;
			
			ОбластьМакета = Макет.ПолучитьОбласть("ЗаголовокТаблицы");
			ТабличныйДокумент.Вывести(ОбластьМакета);
			
			НомерСтроки = 1;
			НомерЛиста = 1;
						
			Для Каждого ТекущаяСтрока Из ТЧТовары Цикл
				ДопПараметрыСтроки = Новый Структура("НомерСтроки", НомерСтроки+1);
				ОбластьМакета = Макет.ПолучитьОбласть("Строка");
				ОбластьМакета.Параметры.Заполнить(ТекущаяСтрока);		
				ОбластьМакета.Параметры.Заполнить(ДопПараметрыСтроки);
				
				//++ №12909
				//ПредставлениеНоменклатуры = Строка(ТекущаяСтрока.Номенклатура) + Строка(УправлениеПечатью.ПредставлениеХарактеристики(ТекущаяСтрока.ХарактеристикаНоменклатуры));
				ПредставлениеНоменклатуры = ОбщийМодульСервер.ПредставлениеНоменклатурыДляПечати(ТекущаяСтрока.Номенклатура, ТекущаяСтрока.ХарактеристикаНоменклатуры);
				//-- №12909
				
				ОбластьМакета.Параметры.ТоварНаименование = ПредставлениеНоменклатуры;
				
				Если НомерСтроки > 1
					И НЕ ПроверитьВыводСчетаФактурыИУПДНаСтраницу(ТабличныйДокумент, ОбластьМакета, (НомерСтроки = КоличествоСтрок), Макет, НомерЛиста, НомерДокумента) Тогда
				
					КоличествоСтраниц = КоличествоСтраниц + 1;
				
				КонецЕсли; 				
				
				ТабличныйДокумент.Вывести(ОбластьМакета);
				НомерСтроки = НомерСтроки + 1;
			КонецЦикла;
			
			УслугиИтогСуммаНДС = 0;
			УслугиИтогВсего = 0;
			УслугиИтогСтоимость = 0;
			
			Если ЕстьУслуги Тогда
				Для Каждого ТекущаяСтрока Из ТЧУслуги Цикл
					ОбластьМакета = Макет.ПолучитьОбласть("Строка");
					ДопПараметрыСтроки = Новый Структура("НомерСтроки", НомерСтроки+1);
					ОбластьМакета = Макет.ПолучитьОбласть("Строка");
					ОбластьМакета.Параметры.Заполнить(ТекущаяСтрока);		
					ОбластьМакета.Параметры.Заполнить(ДопПараметрыСтроки);
					ПредставлениеНоменклатуры = Строка(ТекущаяСтрока.Номенклатура) + Строка(ОбщийМодульСервер.ПредставлениеХарактеристики(ТекущаяСтрока.ХарактеристикаНоменклатуры));
					ОбластьМакета.Параметры.ТоварНаименование = ПредставлениеНоменклатуры;
					
					Если НомерСтроки > 1
						И НЕ ПроверитьВыводСчетаФактурыИУПДНаСтраницу(ТабличныйДокумент, ОбластьМакета, (НомерСтроки = КоличествоСтрок), Макет, НомерЛиста, НомерДокумента) Тогда
				
						КоличествоСтраниц = КоличествоСтраниц + 1;
				
					КонецЕсли; 
				
					ТабличныйДокумент.Вывести(ОбластьМакета);
					НомерСтроки = НомерСтроки + 1;
				КонецЦикла;
				
				УслугиИтогСуммаНДС =  ТЧУслуги.Итог("СуммаНДС");
				УслугиИтогВсего = ТЧУслуги.Итог("Всего");
				УслугиИтогСтоимость = ТЧУслуги.Итог("Стоимость");
			КонецЕсли;
			
			ОбластьМакета = Макет.ПолучитьОбласть("Итого");		
			ОбластьМакета.Параметры.ИтогоСуммаНДС = ТЧТовары.Итог("СуммаНДС") + УслугиИтогСуммаНДС; 
			ОбластьМакета.Параметры.ИтогоВсего = ТЧТовары.Итог("Всего") + УслугиИтогВсего;
			ОбластьМакета.Параметры.ИтогоСтоимость = ТЧТовары.Итог("Стоимость") + УслугиИтогСтоимость ;
			ТабличныйДокумент.Вывести(ОбластьМакета);
			
			ОбластьМакета = Макет.ПолучитьОбласть("Подвал");
			ОбластьМакета.Параметры.ФИОРуководителя = ДанныеПечати.ФИОРуководителя;
			ОбластьМакета.Параметры.ФИОГлавногоБухгалтера = ДанныеПечати.ФИОГлавногоБухгалтера;													
			ТабличныйДокумент.Вывести(ОбластьМакета);

					
			УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабличныйДокумент, 
					НомерСтрокиНачало, ОбъектыПечати, ДанныеПечати.Ссылка);
		КонецЕсли;
	КонецЦикла;
	Возврат ТабличныйДокумент;
	
КонецФункции

Функция ПечатьУПД(МассивОбъектов, ОбъектыПечати) Экспорт
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.АвтоМасштаб         = Истина; //#14053
	ТабличныйДокумент.ОриентацияСтраницы  = ОриентацияСтраницы.Ландшафт;
    ТабличныйДокумент.ИмяПараметровПечати = "ПараметрыПечати_УПД";
	
	ПервыйДокумент = Истина;
	Для каждого ДокументПечати из МассивОбъектов Цикл		 
		
		СтатусУПД = 1; // №6374 статус УПД зависит от наличия СФ
		НомерСчетФатуры = ""; // Если есть СФ, необходимо выводить её номер
		Если ТипЗнч(ДокументПечати) = Тип("ДокументСсылка.РеализацияТоваровИУслуг") ИЛИ ТипЗнч(ДокументПечати) = Тип("ДокументСсылка.Монтаж") Тогда
			Если НайтиСчетФактуру(ДокументПечати) = Неопределено Тогда
				СтатусУПД = 2;
				
				// №6374 запретить формировать УПД, если нет счёт-фактуры и в документе есть позиции с НДС
				ЕстьНДС = Ложь;
				
				// Проверим по ТЧ "Товары" (РТиУ) или "ТоварыУслуги" (Монтаж)
				НаименованиеТабличнойЧасти = "Товары";
				Если ТипЗнч(ДокументПечати) = Тип("ДокументСсылка.Монтаж") Тогда
					НаименованиеТабличнойЧасти = "ТоварыУслуги";
				КонецЕсли;
				Для Каждого ТекущаяСтрока Из ДокументПечати[НаименованиеТабличнойЧасти] Цикл
					Если НЕ ТекущаяСтрока.СтавкаНДС.Пустая() И НЕ ТекущаяСтрока.СтавкаНДС = Перечисления.СтавкиНДС.БезНДС Тогда
						ЕстьНДС = Истина;
						Прервать;
					КонецЕсли;
				КонецЦикла;
				
				// Проверим по ТЧ "Услуги" (РТиУ)
				Если НЕ ЕстьНДС И ТипЗнч(ДокументПечати) = Тип("ДокументСсылка.РеализацияТоваровИУслуг") Тогда
					Для Каждого ТекущаяСтрока Из ДокументПечати.Услуги Цикл
						Если НЕ ТекущаяСтрока.СтавкаНДС.Пустая() И НЕ ТекущаяСтрока.СтавкаНДС = Перечисления.СтавкиНДС.БезНДС Тогда
							ЕстьНДС = Истина;
							Прервать;
						КонецЕсли;
					КонецЦикла;
				КонецЕсли;
				
				// Нет СФ и есть НДС, пропускаем документ
				Если ЕстьНДС Тогда
					Сообщить("В документе " + ДокументПечати + " указана ставка НДС, для печати УПД требуется наличие счёт-фактуры, документ пропущен.");
					Продолжить;
				КонецЕсли;
					
			КонецЕсли;
		КонецЕсли;		
		
		ЭтоМонтаж = Ложь;
		Если ТипЗнч(ДокументПечати) = Тип("ДокументСсылка.РеализацияТоваровИУслуг") Тогда
			ДанныеДляПечати = СобратьДанныеДляПечатиУПДПоРеализацииТоваровИУслуг(ДокументПечати);
			
		ИначеЕсли ТипЗнч(ДокументПечати) = Тип("ДокументСсылка.Монтаж") Тогда
			ДанныеДляПечати = СобратьДанныеДляПечатиУПДПоМонтажу(ДокументПечати);
			ЭтоМонтаж = Истина;

		ИначеЕсли ТипЗнч(ДокументПечати) = Тип("ДокументСсылка.СчетФактураВыданный") Тогда
			Если ТипЗнч(ДокументПечати.Основание) = Тип("ДокументСсылка.РеализацияТоваровИУслуг") Тогда
				ДанныеДляПечати = СобратьДанныеДляПечатиУПДПоРеализацииТоваровИУслуг(ДокументПечати.Основание);
			ИначеЕсли ТипЗнч(ДокументПечати.Основание) = Тип("ДокументСсылка.Монтаж") Тогда
				ДанныеДляПечати = СобратьДанныеДляПечатиУПДПоМонтажу(ДокументПечати.Основание);
				ЭтоМонтаж = Истина;
			КонецЕсли;
		КонецЕсли;
		
		ДанныеПечати = ДанныеДляПечати.Выбрать();		
			
		Если ДанныеПечати.Следующий() Тогда
			
			//++ 16688
			РасчетнаяДатаПечати = ДанныеПечати.Дата; // для варианта ПустаяСсылка / НеЗаполнять / ДатойДокумента 
			Если ЭтоМонтаж Тогда
				РасчетнаяДатаПечати = ОбщийМодульСервер.ПолучитьДатуПодписанияДокументаМонтажа(ДанныеПечати.Ссылка);
			КонецЕсли;	
			//-- 16688
		
			//Если ТипЗнч(ДокументПечати) = Тип("ДокументСсылка.Монтаж") Тогда
			//	Если ДанныеПечати.Дата = Дата(1, 1, 1)  Тогда
			//		Сообщить("Документ " + ДокументПечати + " не в статусе ""Выполнен"" / ""Закрыт"". Документ пропущен.");
			//		Продолжить;	
			//	КонецЕсли;
			//КонецЕсли;
			
			Если ДанныеПечати.Дата < '20171001' Тогда
				Макет = УправлениеПечатью.МакетПечатнойФормы("ОбщийМакет.ПФ_MXL_УПД");
			ИначеЕсли ДанныеПечати.Дата < '20210701' Тогда
				Макет = УправлениеПечатью.МакетПечатнойФормы("ОбщийМакет.ПФ_MXL_УПД981");
			Иначе
				Макет = УправлениеПечатью.МакетПечатнойФормы("ОбщийМакет.ПФ_MXL_УПД534");				
			КонецЕсли;			
			
			КоличествоСтраниц = 1;
			
			Если Не ПервыйДокумент Тогда
				ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
			КонецЕсли;
			ПервыйДокумент = Ложь;
			НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы + 1;
			
			КоличествоСтрок = 0;			
			ТЧТовары = ДанныеПечати.Товары.Выгрузить();
			ТЧТовары.Свернуть("Код,Номенклатура,ХарактеристикаНоменклатуры,СерияНоменклатуры,ЕдиницаИзмерения,ЕдиницаИзмеренияКод,Коэффициент,Цена,СтавкаНДС, ТоварКодТНВЭД,СтранаПроисхожденияКод,ПредставлениеСтраны,ПредставлениеГТД",
    						"Количество,Сумма,СуммаНДС,СуммаБезНДС");			
			КоличествоСтрок = ТЧТовары.Количество();
			ЕстьУслуги = Ложь;
			Попытка 
				ТЧУслуги = ДанныеПечати.Услуги.Выгрузить();
				ТЧУслуги.Свернуть("Код,Номенклатура,ХарактеристикаНоменклатуры,ЕдиницаИзмерения,ЕдиницаИзмеренияКод,Коэффициент,Цена,СтавкаНДС, ТоварКодТНВЭД,СтранаПроисхожденияКод,ПредставлениеСтраны,ПредставлениеГТД",
    						"Количество,Сумма,СуммаНДС,СуммаБезНДС");
				КоличествоСтрок = КоличествоСтрок + ТЧУслуги.Количество();
				ЕстьУслуги = Истина;
			Исключение
			КонецПопытки;
			
			Если ДанныеПечати.Дата >= '20210701' Тогда
				ОбластьМакета = Макет.ПолучитьОбласть("ЗаголовокПФ");
				ТабличныйДокумент.Вывести(ОбластьМакета);
			КонецЕсли;
			
			Если НачалоДня(ДанныеПечати.Дата) >= Дата(2017, 7, 1) И НачалоДня(ДанныеПечати.Дата) < Дата(2017, 10, 1) Тогда // И НЕ ТипЗнч(ДокументПечати) = Тип("ДокументСсылка.Монтаж") Тогда
				ОбластьМакета = Макет.ПолучитьОбласть("Шапка625");
			Иначе
				ОбластьМакета = Макет.ПолучитьОбласть("Шапка");
			КонецЕсли;			
			
			ОбластьМакета.Параметры.Заполнить(ДанныеПечати);
			НомерДокумента = ПрефиксацияОбъектовКлиентСервер.НомерНаПечать(ДанныеПечати.НомерДокумента);
			СведенияОбОрганизации = ОбщийМодульСервер.СведенияОбОрганизации(ДанныеПечати.Организация, РасчетнаяДатаПечати);
			СведенияОбКонтрагенте = ОбщийМодульСервер.СведенияОКонтрагенте(ДанныеПечати.Контрагент, РасчетнаяДатаПечати);
			
			ДопПараметрыШапки = Новый Структура("ПредставлениеПоставщика, АдресПоставщика, ОрганизацияЮридическийАдрес", СведенияОбОрганизации.Представление, СведенияОбОрганизации.ЮридическийАдрес, СведенияОбОрганизации.ЮридическийАдрес);
			//++16688
			// ОбластьМакета.Параметры.ДатаДокумента = Формат(ДанныеПечати.Дата,"ДЛФ=Д");
			ОбластьМакета.Параметры.ДатаДокумента = Формат(РасчетнаяДатаПечати,"ДЛФ=Д");
			//--16688
			ОбластьМакета.Параметры.НомерДокумента = НомерДокумента; // + " от " + Формат(ДанныеПечати.Дата,"ДФ='dd MMMM yyyy ''г.'''");
			//ОбластьМакета.Параметры.ОрганизацияЮридическийАдрес = СведенияОбОрганизации.ЮридическийАдрес;
			ОбластьМакета.Параметры.Заполнить(ДопПараметрыШапки);
			
			ОбластьМакета.Параметры.ИННПоставщика = ?(ЗначениеЗаполнено(ДанныеПечати.ИНН), ДанныеПечати.ИНН, "") + ?(ЗначениеЗаполнено(ДанныеПечати.КПП), "/"+ДанныеПечати.КПП, "");
			ОбластьМакета.Параметры.ПредставлениеГрузоотправителя = "он же";
			
			ОбластьМакета.Параметры.ПредставлениеГрузополучателя = Строка(ДанныеПечати.КонтрагентНаименованиеПолное) + ", " + СведенияОбКонтрагенте.ФактическийАдрес;
			ОбластьМакета.Параметры.ПредставлениеПокупателя = ДанныеПечати.КонтрагентНаименованиеПолное;
			
			Если ДанныеПечати.Дата >= '20210701' Тогда
				ОбластьМакета.Параметры.ДокументыОбОтгрузке = СведенияОДокументеОтгрузки(ДанныеПечати, КоличествоСтрок);
			КонецЕсли;
			
			ОбластьМакета.Параметры.АдресПокупателя = СведенияОбКонтрагенте.ЮридическийАдрес;
			ОбластьМакета.Параметры.ИННПокупателя = ?(ЗначениеЗаполнено(ДанныеПечати.КонтрагентИНН), ДанныеПечати.КонтрагентИНН, "") + ?(ЗначениеЗаполнено(ДанныеПечати.КонтрагентКПП), "/"+ДанныеПечати.КонтрагентКПП, "");
			
			ОбластьМакета.Параметры.СтатусУПД = СтатусУПД;
			//ОбластьМакета.Параметры.Валюта	= "Валюта: наименование, код " + ДанныеПечати.ВалютаНаименование + ", " + ДанныеПечати.ВалютаКод;
			ОбластьМакета.Параметры.Валюта	= ДанныеПечати.ВалютаНаименование + ", " + ДанныеПечати.ВалютаКод;
			
			Если ТипЗнч(ДанныеПечати.Ссылка) = Тип("ДокументСсылка.РеализацияТоваровИУслуг") Тогда
				ШтрихкодированиеПечатныхФорм.ВывестиШтрихкодВТабличныйДокумент(
					ТабличныйДокумент,
					Макет, 
					ОбластьМакета,
					ДанныеПечати.Ссылка);
			Иначе
				Попытка
					ОбластьМакета.Рисунки.Удалить(ОбластьМакета.Рисунки.КартинкаШтрихкода);
				Исключение
				КонецПопытки;
			КонецЕсли;
				
			ТабличныйДокумент.Вывести(ОбластьМакета);
			
			ОбластьМакета = Макет.ПолучитьОбласть("ЗаголовокТаблицы");
			ТабличныйДокумент.Вывести(ОбластьМакета);
			
			НомерСтроки = 1;
			НомерЛиста = 1;
			
			Для Каждого ТекущаяСтрока Из ТЧТовары Цикл
				ОбластьМакета = Макет.ПолучитьОбласть("Строка");
				ЗаполнитьЗначенияСвойств(ОбластьМакета.Параметры, ТекущаяСтрока);
				ОбластьМакета.Параметры.НомерСтроки = НомерСтроки;
				
				//++ №12909
				//ПредставлениеНоменклатуры = Строка(ТекущаяСтрока.Номенклатура) + Строка(УправлениеПечатью.ПредставлениеХарактеристики(ТекущаяСтрока.ХарактеристикаНоменклатуры));
				ПредставлениеНоменклатуры = ОбщийМодульСервер.ПредставлениеНоменклатурыДляПечати(ТекущаяСтрока.Номенклатура, ТекущаяСтрока.ХарактеристикаНоменклатуры);
				//-- №12909
				
				ОбластьМакета.Параметры.Номенклатура = ПредставлениеНоменклатуры;
				
				Если НомерСтроки > 1
					И НЕ ПроверитьВыводСчетаФактурыИУПДНаСтраницу(ТабличныйДокумент, ОбластьМакета, (НомерСтроки = КоличествоСтрок), Макет, НомерЛиста, НомерДокумента, Истина) Тогда
				
					КоличествоСтраниц = КоличествоСтраниц + 1;
				
				КонецЕсли; 
				
				ТабличныйДокумент.Вывести(ОбластьМакета);
				НомерСтроки = НомерСтроки + 1;
			КонецЦикла;
			
			УслугиИтогСуммаНДС = 0;
			УслугиИтогВсего = 0;
			УслугиИтогСуммаБезНДС = 0;
			
			Если ЕстьУслуги Тогда
				Для Каждого ТекущаяСтрока Из ТЧУслуги Цикл
					ОбластьМакета = Макет.ПолучитьОбласть("Строка");
					ЗаполнитьЗначенияСвойств(ОбластьМакета.Параметры, ТекущаяСтрока);
					ОбластьМакета.Параметры.НомерСтроки = НомерСтроки;
					
					//++ №12909
					//ПредставлениеНоменклатуры = Строка(ТекущаяСтрока.Номенклатура) + Строка(УправлениеПечатью.ПредставлениеХарактеристики(ТекущаяСтрока.ХарактеристикаНоменклатуры));
					ПредставлениеНоменклатуры = ОбщийМодульСервер.ПредставлениеНоменклатурыДляПечати(ТекущаяСтрока.Номенклатура, ТекущаяСтрока.ХарактеристикаНоменклатуры);
					//-- №12909
					
					ОбластьМакета.Параметры.Номенклатура = ПредставлениеНоменклатуры;
					
					Если НомерСтроки > 1
						И НЕ ПроверитьВыводСчетаФактурыИУПДНаСтраницу(ТабличныйДокумент, ОбластьМакета, (НомерСтроки = КоличествоСтрок), Макет, НомерЛиста, НомерДокумента, Истина) Тогда
				
						КоличествоСтраниц = КоличествоСтраниц + 1;
				
					КонецЕсли; 
				
					ТабличныйДокумент.Вывести(ОбластьМакета);
					НомерСтроки = НомерСтроки + 1;
				КонецЦикла;
				
				УслугиИтогСуммаНДС =  ТЧУслуги.Итог("СуммаНДС");
				УслугиИтогВсего = ТЧУслуги.Итог("Сумма");
				УслугиИтогСуммаБезНДС = ТЧУслуги.Итог("СуммаБезНДС");

			КонецЕсли;
			
			ОбластьМакета = Макет.ПолучитьОбласть("Итого");		
			ОбластьМакета.Параметры.ИтогоСуммаНДС = ТЧТовары.Итог("СуммаНДС") + УслугиИтогСуммаНДС; ; 
			ОбластьМакета.Параметры.ИтогоСумма = ТЧТовары.Итог("Сумма") + УслугиИтогВсего; 
			ОбластьМакета.Параметры.ИтогоСуммаБезНДС = ТЧТовары.Итог("СуммаБезНДС") + УслугиИтогСуммаБезНДС; 
			ТабличныйДокумент.Вывести(ОбластьМакета);
			
			ОбластьМакета = Макет.ПолучитьОбласть("Подвал");
			//++ 16306 2023-07-11
			Если ДанныеПечати.Организация.ВидОрганизации = Перечисления.ВидКонтрагента.ЮрЛицо Тогда
				ОбластьМакета.Параметры.ФИОРуководителя = ДанныеПечати.ФИОРуководителя;
			КонецЕсли;
			Если ДанныеПечати.Организация.ВидОрганизации = Перечисления.ВидКонтрагента.ИндивидуальныйПредприниматель Тогда
				ОбластьМакета.Параметры.ФИОПБОЮЛ = ДанныеПечати.ФИОРуководителя;
			КонецЕсли;
			//++ 16306 2023-07-11
			ОбластьМакета.Параметры.ФИОГлавногоБухгалтера = ДанныеПечати.ФИОГлавногоБухгалтера;													
			ТабличныйДокумент.Вывести(ОбластьМакета);
			
			ОбластьМакета = Макет.ПолучитьОбласть("ПодвалНакладной");
			ЗаполнитьЗначенияСвойств(ОбластьМакета.Параметры, ДанныеПечати);
			ОбластьМакета.Параметры.ДатаДокумента = Формат(РасчетнаяДатаПечати, "ДЛФ=Д");
			ОбластьМакета.Параметры.ПредставлениеОрганизации = Строка(ДанныеПечати.ОрганизацияПолноеНаименование) + ", ИНН/КПП " + ?(ЗначениеЗаполнено(ДанныеПечати.ИНН), ДанныеПечати.ИНН, "--") + ?(ЗначениеЗаполнено(ДанныеПечати.КПП), "/"+ДанныеПечати.КПП, "");
			ОбластьМакета.Параметры.ПредставлениеКонтрагента = Строка(ДанныеПечати.КонтрагентНаименованиеПолное)  + ", ИНН/КПП " + ?(ЗначениеЗаполнено(ДанныеПечати.КонтрагентИНН), ДанныеПечати.КонтрагентИНН, "--") + ?(ЗначениеЗаполнено(ДанныеПечати.КонтрагентКПП), "/"+ДанныеПечати.КонтрагентКПП, "");
			ТабличныйДокумент.Вывести(ОбластьМакета);
			
			УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабличныйДокумент, 
					НомерСтрокиНачало, ОбъектыПечати, ДанныеПечати.Ссылка);
		КонецЕсли;
	КонецЦикла;
	Возврат ТабличныйДокумент;
	
КонецФункции

Функция СобратьДанныеДляПечатиСчетФактурыПоРеализацииТоваровИУслуг(ДокументРеализации, ДокументСчетФактуры)

