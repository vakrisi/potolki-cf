#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
		
	Если Параметры.Ключ.Пустая() Тогда

	Иначе
		ЭтаФорма.ТолькоПросмотр = ПраваПользователей.ДокументТолькоПросмотр(Объект.Ссылка);		
	КонецЕсли;
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	ОтображениеПериодаРегистрации = Формат(Объект.ПериодРегистрации, "ДФ='MMMM yyyy'");
	
	ПраваПользователей.УстановитьТолькоПросмотрДляРеквизитаНомер(Элементы.Номер.ТолькоПросмотр);
	
	ВремяНачалаГрафика    = Константы.НачалоРабочегоВремениЗамеров.Получить();
	ВремяОкончанияГрафика = Константы.КонецРабочегоВремениЗамеров.Получить();
	
	ДатаНачалаГрафика = НачалоМесяца(Объект.ПериодРегистрации);
	ДатаОкончанияГрафика = КонецМесяца(Объект.ПериодРегистрации);
	
	Элементы.УстановитьМесяц.Пометка = Истина;
	
	ТекущийПользователь = Пользователи.ТекущийПользователь();
	РеквизитыПользователя = ОбщийМодульСервер.НастройкиПользователя("ФильтроватьГрафикЗамеровПоТочкеПродаж, ТочкаПродаж,
												|ОграничитьВидимостьЗамерщиковПоПодразделениюПользователя, ПодразделениеРозница", ТекущийПользователь);
	
	Если РеквизитыПользователя.ФильтроватьГрафикЗамеровПоТочкеПродаж Тогда
		ФильтрТочкаПродаж = РеквизитыПользователя.ТочкаПродаж;
		Элементы.ФильтрТочкаПродаж.Доступность = Ложь;
	КонецЕсли;
	Если ПолучитьФункциональнуюОпцию("ИспользоватьПодразделения") Тогда // #15664
		Если РеквизитыПользователя.ОграничитьВидимостьЗамерщиковПоПодразделениюПользователя Тогда
			ФильтрПодразделение = РеквизитыПользователя.ПодразделениеРозница;
			Элементы.ФильтрПодразделение.Доступность = Ложь;
		КонецЕсли;
	Иначе
		Элементы.ФильтрПодразделение.Видимость = Ложь;
	КонецЕсли;
	
	ЗаполнитьВычисляемыеРеквизитыТабличнойЧасти();
	ОтборСтрокТабличнойЧасти();
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	ДатыЗапретаИзменения.ОбъектПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ПодключитьОбработчикОжидания("ОбновитьГрафикОбработчикОжидания", 0.1, Истина);
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	ПроверкаТаблицыДокумента(Отказ);
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	ЗаполнитьВычисляемыеРеквизитыТабличнойЧасти();
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	
	Если ТипЗнч(ИсточникВыбора) = Тип("УправляемаяФорма")
		И СтрНайти(ИсточникВыбора.ИмяФормы, "ФормаКалендаря") > 0 Тогда
		
		Если НЕ Объект.ПериодРегистрации = НачалоМесяца(ВыбранноеЗначение) Тогда
			Если Объект.Сотрудники.Количество() > 0 Тогда
				ОписаниеОповещения = Новый ОписаниеОповещения("ОтображениеПериодаРегистрацииНачалоВыбораПослеВопроса", ЭтотОбъект, ВыбранноеЗначение);
				ПоказатьВопрос(ОписаниеОповещения, "Данные по периоду будут очищены. Продолжить?", РежимДиалогаВопрос.ДаНет);				
			Иначе
				ОтображениеПериодаРегистрацииНачалоВыбораЗавершение(ВыбранноеЗначение);
			КонецЕсли;
		КонецЕсли;
		
	ИначеЕсли ИсточникВыбора.ИмяФормы = "ОбщаяФорма.ФормаПодбораВГрафикРаботы" Тогда		
		ОбработкаВыбораПодборНаКлиенте(ВыбранноеЗначение);
			
	КонецЕсли;
	
КонецПроцедуры // ОбработкаВыбора()

#КонецОбласти

#Область ОбработчикиЭлементовФормы

&НаКлиенте
Процедура ОбновитьГрафикОбработчикОжидания()
	
	ОчиститьСообщения();
	ОбновитьГрафикСервер();
	
КонецПроцедуры

&НаКлиенте
Процедура ОтображениеПериодаРегистрацииРегулирование(Элемент, Направление, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	Если Объект.Сотрудники.Количество() > 0 Тогда
		ОписаниеОповещения = Новый ОписаниеОповещения("ОтображениеПериодаРегистрацииРегулированиеПослеВопроса", ЭтотОбъект, Направление);
		ПоказатьВопрос(ОписаниеОповещения, "Данные по текущему периоду будут очищены. Продолжить?", РежимДиалогаВопрос.ДаНет);
		Возврат;
	КонецЕсли;
	ОтображениеПериодаРегистрацииРегулированиеЗавершение(Направление);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтображениеПериодаРегистрацииРегулированиеПослеВопроса(Результат, ДополнительныеПараметры) Экспорт
	
	Если НЕ Результат = КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	Объект.Сотрудники.Очистить();
	ОтображениеПериодаРегистрацииРегулированиеЗавершение(ДополнительныеПараметры);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтображениеПериодаРегистрацииРегулированиеЗавершение(Направление)	
	
	ОчиститьСообщения();
	Модифицированность = Истина;
	Объект.ПериодРегистрации = ?(ЗначениеЗаполнено(Объект.ПериодРегистрации), 
							ДобавитьМесяц(Объект.ПериодРегистрации, Направление),
							ДобавитьМесяц(НачалоМесяца(ТекущаяДата()), Направление));							
	Объект.ПериодРегистрации 		= НачалоМесяца(Объект.ПериодРегистрации);
	ОтображениеПериодаРегистрации 	= Формат(Объект.ПериодРегистрации, "ДФ='MMMM yyyy'");
	ДатаНачалаГрафика = НачалоМесяца(Объект.ПериодРегистрации);
	ДатаОкончанияГрафика = КонецМесяца(Объект.ПериодРегистрации);
	
	ОбновитьГрафикСервер();
	
КонецПроцедуры

&НаКлиенте
Процедура ОтображениеПериодаРегистрацииНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка	 = Ложь;
	ДатаКалендаряПриОткрытии = ?(ЗначениеЗаполнено(Объект.ПериодРегистрации), Объект.ПериодРегистрации, ТекущаяДата());
	СтруктураПараметров 	 = Новый Структура("ДатаКалендаря, ЗакрыватьПриВыборе, МножественныйВыбор", ДатаКалендаряПриОткрытии, Истина, Ложь);
	ОткрытьФорму("ОбщаяФорма.ФормаКалендаря", СтруктураПараметров, ЭтаФорма);	
		
КонецПроцедуры

&НаКлиенте
Процедура ОтображениеПериодаРегистрацииНачалоВыбораПослеВопроса(Результат, ДополнительныеПараметры) Экспорт
	
	Если НЕ Результат = КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	Объект.Сотрудники.Очистить();
	ОтображениеПериодаРегистрацииНачалоВыбораЗавершение(ДополнительныеПараметры);
КонецПроцедуры

&НаКлиенте
Процедура ОтображениеПериодаРегистрацииНачалоВыбораЗавершение(ВыбранноеЗначение)
	
	ОчиститьСообщения();
	Модифицированность = Истина;
	Объект.ПериодРегистрации 		= НачалоМесяца(ВыбранноеЗначение);
	ОтображениеПериодаРегистрации 	= Формат(Объект.ПериодРегистрации, "ДФ='MMMM yyyy'");
	ДатаНачалаГрафика = НачалоМесяца(Объект.ПериодРегистрации);
	ДатаОкончанияГрафика = КонецМесяца(Объект.ПериодРегистрации);
	
	ОбновитьГрафикСервер();
	
КонецПроцедуры

