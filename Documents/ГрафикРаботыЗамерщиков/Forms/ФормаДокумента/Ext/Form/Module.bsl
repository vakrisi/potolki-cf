&НаКлиенте
Процедура ДобавитьКомментарий(Команда)
	Если Элементы.График.ВыделенныеЭлементы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	МассивЭлементовИзменения = Новый Массив;
	ПервоначальныйКомментарий = "";
	Для каждого СтрокаНевыхода из Элементы.График.ВыделенныеЭлементы Цикл
		Если СтрокаНевыхода.Значение.Регистратор <> Объект.Ссылка Тогда
			Сообщить("Выбраны элементы, не принадлежащие данному документу");
			Возврат;
		КонецЕсли;
		
		МассивЭлементовИзменения.Добавить(Новый Структура("Начало, Конец, Сотрудник", СтрокаНевыхода.Начало, СтрокаНевыхода.Конец, СтрокаНевыхода.ЗначенияИзмерений.Получить("Сотрудник")));
	КонецЦикла;
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ДобавитьКомментарийЗавершение", ЭтотОбъект, МассивЭлементовИзменения); 
	ПоказатьВводСтроки(ОписаниеОповещения, ПервоначальныйКомментарий);
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьКомментарийЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	МассивЭлементовИзменения = ДополнительныеПараметры;

	Для каждого ЭлементМассива из МассивЭлементовИзменения Цикл
		СтруктураОтбора = Новый Структура;
		СтруктураОтбора.Вставить("ДатаНачала", НачалоДня(ЭлементМассива.Начало));
		СтруктураОтбора.Вставить("ДатаОкончания", НачалоДня(ЭлементМассива.Конец));
		СтруктураОтбора.Вставить("ВремяНачала", Дата(1,1,1) + (ЭлементМассива.Начало - НачалоДня(ЭлементМассива.Начало)));
		СтруктураОтбора.Вставить("ВремяОкончания", Дата(1,1,1) + (ЭлементМассива.Конец - НачалоДня(ЭлементМассива.Конец)));
		СтруктураОтбора.Вставить("Сотрудник", ЭлементМассива.Сотрудник);
		НайденныеСтроки = Объект.Сотрудники.НайтиСтроки(СтруктураОтбора);
		Если НайденныеСтроки.Количество() > 0 Тогда
			НайденныеСтроки[0].Комментарий = Результат;
		КонецЕсли;
	КонецЦикла;
	
	ОбновитьГрафикСервер();
	Модифицированность = Истина;
	
КонецПроцедуры

#КонецОбласти

#Область УправлениеПериодомГрафика

&НаКлиенте
Процедура ДатаНачалаГрафикаПриИзменении(Элемент)
	
	Если ДатаНачалаГрафика = Дата(1,1,1) ИЛИ ДатаНачалаГрафика < НачалоМесяца(Объект.ПериодРегистрации) Тогда
		ДатаНачалаГрафика = НачалоМесяца(Объект.ПериодРегистрации);
	ИначеЕсли ДатаНачалаГрафика > КонецМесяца(Объект.ПериодРегистрации) Тогда
		ДатаНачалаГрафика = КонецМесяца(Объект.ПериодРегистрации);
		ДатаОкончанияГрафика = КонецМесяца(Объект.ПериодРегистрации);
	ИначеЕсли ДатаНачалаГрафика > ДатаОкончанияГрафика Тогда
		ДатаНачалаГрафика = ДатаОкончанияГрафика;
	КонецЕсли;
	
	ОбновитьСостояниеКнопокИнтервалаПриИзмененииДат();
	
	ОбновитьГрафикСервер();
		
КонецПроцедуры

&НаКлиенте
Процедура ДатаОкончанияГрафикаПриИзменении(Элемент)
	
	Если ДатаОкончанияГрафика = Дата(1,1,1) ИЛИ ДатаОкончанияГрафика > КонецМесяца(Объект.ПериодРегистрации) Тогда
		ДатаОкончанияГрафика = КонецМесяца(Объект.ПериодРегистрации);
	ИначеЕсли ДатаОкончанияГрафика < НачалоМесяца(Объект.ПериодРегистрации) Тогда
		ДатаНачалаГрафика = НачалоМесяца(Объект.ПериодРегистрации);
		ДатаОкончанияГрафика = НачалоМесяца(Объект.ПериодРегистрации);
	ИначеЕсли ДатаНачалаГрафика > ДатаОкончанияГрафика Тогда
		ДатаОкончанияГрафика = ДатаНачалаГрафика;
	КонецЕсли;
	
	ОбновитьСостояниеКнопокИнтервалаПриИзмененииДат();
	
	ОбновитьГрафикСервер();

КонецПроцедуры

&НаКлиенте
Процедура УстановитьДень(Команда)
	
	ДатаНачалаГрафика = Объект.ПериодРегистрации;
	ДатаОкончанияГрафика = Объект.ПериодРегистрации;
	
	СнятьПометкиКнопокИнтервала();             
	Элементы.УстановитьДень.Пометка = Истина;
	ОбновитьДоступностьКнопокСдвигаПриИзмененииДат();
	
	ОбновитьГрафикСервер();
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьНеделя(Команда)
	
	ДатаНачалаГрафика = Объект.ПериодРегистрации;
	ДатаОкончанияГрафика = Объект.ПериодРегистрации + 60*60*24*6;
	
	СнятьПометкиКнопокИнтервала();               
	Элементы.УстановитьНеделя.Пометка = Истина;
	ОбновитьДоступностьКнопокСдвигаПриИзмененииДат();

	ОбновитьГрафикСервер();
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьМесяц(Команда)
	
	ДатаНачалаГрафика = НачалоМесяца(Объект.ПериодРегистрации);
	ДатаОкончанияГрафика = КонецМесяца(Объект.ПериодРегистрации);
	
	СнятьПометкиКнопокИнтервала();              
	Элементы.УстановитьМесяц.Пометка = Истина;
	ОбновитьДоступностьКнопокСдвигаПриИзмененииДат();

	ОбновитьГрафикСервер();
	
КонецПроцедуры

&НаКлиенте
Процедура СнятьПометкиКнопокИнтервала()
	
	Элементы.УстановитьДень.Пометка = Ложь;  
	Элементы.УстановитьНеделя.Пометка = Ложь; 
	Элементы.УстановитьМесяц.Пометка = Ложь;  

КонецПроцедуры

&НаКлиенте
Процедура ВыбратьПериод(Команда)
	
    Диалог = Новый ДиалогРедактированияСтандартногоПериода();                                 
    Диалог.Период = Новый СтандартныйПериод(ДатаНачалаГрафика, ДатаОкончанияГрафика);        
    ОписаниеОповещенияОЗакрытии = Новый ОписаниеОповещения("ВыбратьПериодЗавершение", ЭтотОбъект);
    Диалог.Показать(ОписаниеОповещенияОЗакрытии);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьПериодЗавершение(Результат, Параметры) Экспорт
	
	ОчиститьСообщения();
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Результат.ДатаНачала > КонецМесяца(Объект.ПериодРегистрации) ИЛИ Результат.ДатаНачала < НачалоМесяца(Объект.ПериодРегистрации)
		ИЛИ Результат.ДатаОкончания > КонецМесяца(Объект.ПериодРегистрации) ИЛИ Результат.ДатаОкончания < НачалоМесяца(Объект.ПериодРегистрации) Тогда
		Возврат;			 
	КонецЕсли;
			
    ДатаНачалаГрафика = Результат.ДатаНачала;
    ДатаОкончанияГрафика = Результат.ДатаОкончания;	
	
	ОбновитьСостояниеКнопокИнтервалаПриИзмененииДат();
	ОбновитьГрафикСервер();
	
КонецПроцедуры

&НаКлиенте	
Процедура ОбновитьСостояниеКнопокИнтервалаПриИзмененииДат()
	
	СнятьПометкиКнопокИнтервала();
	Если НачалоДня(ДатаНачалаГрафика) = НачалоДня(ДатаОкончанияГрафика) Тогда
		Элементы.УстановитьДень.Пометка = Истина;
		
	ИначеЕсли НачалоДня(ДатаОкончанияГрафика) = НачалоДня(ДатаНачалаГрафика + 60*60*24*6) Тогда
		Элементы.УстановитьНеделя.Пометка = Истина;
		
	ИначеЕсли ДатаНачалаГрафика = НачалоМесяца(Объект.ПериодРегистрации) И ДатаОкончанияГрафика = КонецМесяца(Объект.ПериодРегистрации) Тогда
		Элементы.УстановитьМесяц.Пометка = Истина;
		
	КонецЕсли;
	
	ОбновитьДоступностьКнопокСдвигаПриИзмененииДат();
	
КонецПроцедуры

&НаКлиенте	
Процедура ОбновитьДоступностьКнопокСдвигаПриИзмененииДат()
	
	ДоступностьКнопокСдвига = Элементы.УстановитьДень.Пометка ИЛИ Элементы.УстановитьНеделя.Пометка ИЛИ Элементы.УстановитьМесяц.Пометка;
	Элементы.СдвинутьИнтервалВлево.Доступность  = ДоступностьКнопокСдвига;
	Элементы.СдвинутьИнтервалВправо.Доступность = ДоступностьКнопокСдвига;

КонецПроцедуры

&НаКлиенте
Процедура СдвинутьИнтервалВлево(Команда)
	СдвинутьДату(-1);
КонецПроцедуры

&НаКлиенте
Процедура СдвинутьИнтервалВправо(Команда)
	СдвинутьДату();
КонецПроцедуры

&НаКлиенте
Процедура СдвинутьДату(Знак=1)
	
	//#8387
	Если Элементы.УстановитьДень.Пометка Тогда
		Если Знак = -1 Тогда
			ДатаНачалаГрафика 	= Макс(НачалоМесяца(Объект.ПериодРегистрации), ДатаНачалаГрафика + Знак*86400);
			ДатаОкончанияГрафика = ДатаНачалаГрафика;
		Иначе
			ДатаНачалаГрафика 	= Мин(КонецМесяца(Объект.ПериодРегистрации), ДатаНачалаГрафика + Знак*86400);
			ДатаОкончанияГрафика = ДатаНачалаГрафика;
		КонецЕсли;
		
	ИначеЕсли Элементы.УстановитьНеделя.Пометка Тогда
		Если Знак = -1 Тогда
			ДатаНачалаГрафика 	= Макс(НачалоМесяца(Объект.ПериодРегистрации), ДатаНачалаГрафика + Знак*86400*7);
			ДатаОкончанияГрафика = Макс(НачалоМесяца(Объект.ПериодРегистрации), ДатаНачалаГрафика + Знак*86400*7);
		Иначе
			ДатаНачалаГрафика 	= Мин(КонецМесяца(Объект.ПериодРегистрации), ДатаНачалаГрафика + Знак*86400*7);
			ДатаОкончанияГрафика = Мин(КонецМесяца(Объект.ПериодРегистрации), ДатаНачалаГрафика + Знак*86400*7);
		КонецЕсли;
		
	ИначеЕсли Элементы.УстановитьМесяц.Пометка Тогда
		// месяцы не двигаются 
		
	КонецЕсли;
	
	ОбновитьГрафикСервер();
		
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыФункции

&НаСервере
Процедура ЗаполнитьВычисляемыеРеквизитыТабличнойЧасти()
	
	Для каждого СтрокаТЧ из Объект.Сотрудники Цикл
		СтрокаТЧ.ТочкаПродаж = СтрокаТЧ.Сотрудник.ТочкаПродаж;
		СтрокаТЧ.Подразделение = СтрокаТЧ.Сотрудник.Подразделение;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ОтборСтрокТабличнойЧасти()
	
	Элементы.Сотрудники.ОтборСтрок = Неопределено; // сначала очищаем
	Элементы.СотрудникиСотрудник.ПараметрыВыбора = Новый ФиксированныйМассив(Новый Массив);
	
	Если ФильтрТочкаПродаж.Пустая() И ФильтрПодразделение.Пустая() Тогда
		//
		
	ИначеЕсли НЕ ФильтрТочкаПродаж.Пустая() И ФильтрПодразделение.Пустая() Тогда
		Элементы.Сотрудники.ОтборСтрок = Новый ФиксированнаяСтруктура("ТочкаПродаж", ФильтрТочкаПродаж);
		
		НовыйМассив = Новый Массив();
		НовыйМассив.Добавить(Новый ПараметрВыбора("Отбор.ТочкаПродаж", ФильтрТочкаПродаж));
		Элементы.СотрудникиСотрудник.ПараметрыВыбора = Новый ФиксированныйМассив(НовыйМассив);

	ИначеЕсли ФильтрТочкаПродаж.Пустая() И НЕ ФильтрПодразделение.Пустая() Тогда
		Элементы.Сотрудники.ОтборСтрок = Новый ФиксированнаяСтруктура("Подразделение", ФильтрПодразделение);
		
		НовыйМассив = Новый Массив();
		НовыйМассив.Добавить(Новый ПараметрВыбора("Отбор.Подразделение", ФильтрПодразделение));
		Элементы.СотрудникиСотрудник.ПараметрыВыбора = Новый ФиксированныйМассив(НовыйМассив);

	ИначеЕсли НЕ ФильтрТочкаПродаж.Пустая() И НЕ ФильтрПодразделение.Пустая() Тогда
		Элементы.Сотрудники.ОтборСтрок = Новый ФиксированнаяСтруктура("ТочкаПродаж, Подразделение", ФильтрТочкаПродаж, ФильтрПодразделение);
		
		НовыйМассив = Новый Массив();
		НовыйМассив.Добавить(Новый ПараметрВыбора("Отбор.ТочкаПродаж", ФильтрТочкаПродаж));
		НовыйМассив.Добавить(Новый ПараметрВыбора("Отбор.Подразделение", ФильтрПодразделение));
		Элементы.СотрудникиСотрудник.ПараметрыВыбора = Новый ФиксированныйМассив(НовыйМассив);

	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

