КонецПроцедуры

&НаКлиенте
Процедура ГрафикПередУдалением(Элемент, Отказ)
	
	Отказ = Истина;
	
	Если Элемент.ВыделенныеЭлементы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	МассивЭлементовУдаления = Новый Массив;
	ТекстВопроса = "Для удаления выбраны элементы:" + Символы.ПС;
	Для каждого СтрокаНевыхода из Элемент.ВыделенныеЭлементы Цикл
		Если СтрокаНевыхода.Значение.Регистратор <> Объект.Ссылка Тогда
			Сообщить("Выбраны элементы, не принадлежащие данному документу");
			Возврат;
		КонецЕсли;
		
		МассивЭлементовУдаления.Добавить(Новый Структура("Начало, Конец, Сотрудник", СтрокаНевыхода.Начало, СтрокаНевыхода.Конец, СтрокаНевыхода.ЗначенияИзмерений.Получить("Сотрудник")));
		ТекстВопроса = ТекстВопроса + Строка(СтрокаНевыхода.Начало) + " - " + Строка(СтрокаНевыхода.Конец) + " " + Строка(СтрокаНевыхода.ЗначенияИзмерений.Получить("Сотрудник")) + Символы.ПС; 
	КонецЦикла;
	ТекстВопроса = ТекстВопроса + "Подтверждаете выполнение действия?";
	ОписаниеОповещения = Новый ОписаниеОповещения("УдалениеЭлементовГрафикаПослеВопроса", ЭтотОбъект, МассивЭлементовУдаления); 
	ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры

&НаКлиенте
Процедура УдалениеЭлементовГрафикаПослеВопроса(Результат, ДополнительныеПараметры) Экспорт
	
	Если НЕ Результат = КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	МассивЭлементовУдаления = ДополнительныеПараметры;
	
	Для каждого ЭлементМассива из МассивЭлементовУдаления Цикл
		СтруктураОтбора = Новый Структура;
		СтруктураОтбора.Вставить("ДатаНачала", НачалоДня(ЭлементМассива.Начало));
		СтруктураОтбора.Вставить("ДатаОкончания", НачалоДня(ЭлементМассива.Конец));
		СтруктураОтбора.Вставить("ВремяНачала", Дата(1,1,1) + (ЭлементМассива.Начало - НачалоДня(ЭлементМассива.Начало)));
		СтруктураОтбора.Вставить("ВремяОкончания", Дата(1,1,1) + (ЭлементМассива.Конец - НачалоДня(ЭлементМассива.Конец)));
		СтруктураОтбора.Вставить("Сотрудник", ЭлементМассива.Сотрудник);
		НайденныеСтроки = Объект.Сотрудники.НайтиСтроки(СтруктураОтбора);
		Если НайденныеСтроки.Количество() > 0 Тогда
			Объект.Сотрудники.Удалить(НайденныеСтроки[0].НомерСтроки-1);
		КонецЕсли;
	КонецЦикла;
	
	ОбновитьГрафикСервер();
	Модифицированность = Истина;
		
КонецПроцедуры

