#КонецОбласти

#Область ГрафикПланировщик

&НаСервере
Процедура ОбновитьГрафикСервер()
	
	Если РежимРедактированияТабличнойЧасти = 1 Тогда
		Возврат;
	КонецЕсли;
	
	// формируем таблицу с данными для вывода на графики	
	ТаблицаГрафикЗамеров.Очистить();	
	ТаблицаЗамерщиков = МодульОтчетов.ПолучитьТаблицуЗамерщиков(ФильтрТочкаПродаж, ФильтрПодразделение);
	МассивЗамерщиков = ТаблицаЗамерщиков.ВыгрузитьКолонку("Сотрудник");
	
	//получаем таблицу замеров/выездов/невыходов из регистра для отображения графика за заданный период
	ТаблицаЗамеров = МодульОтчетов.ПолучитьТаблицуЗамеров(НачалоМесяца(Объект.ПериодРегистрации), КонецМесяца(Объект.ПериодРегистрации), МассивЗамерщиков);
	
	Для каждого ЭлементЗамера из ТаблицаЗамеров Цикл		
		Если НЕ ЭлементЗамера.Регистратор = Объект.Ссылка Тогда
			НоваяСтрока = ТаблицаГрафикЗамеров.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ЭлементЗамера, 
									"Регистратор, Дата, ВремяНачала, ВремяОкончания, 
									|Город, Адрес, ИмяКлиента, Комментарий, ТелефонКлиента, Результат, Сотрудник, ЗамерВыполнен, ОтсутствиеИсполнителя, ЭтоВыезд,
									|ИДЗамера, ТочкаПродаж, КоличествоЗамерщиковПоПлану");					
			НоваяСтрока.ТекстНаГрафике = ОбщийМодуль.ПолучитьТекстДляГрафикаЗамеров(ЭлементЗамера);
			НоваяСтрока.ЗначениеНаГрафике = "";
			НоваяСтрока.Текущий = Ложь;
		КонецЕсли;
	КонецЦикла;
	
	//добавим невыходы текущего документа
	Для Каждого НевыходТекущегоДокумента Из Объект.Сотрудники Цикл
		
		НоваяСтрока = ТаблицаГрафикЗамеров.Добавить();
		НоваяСтрока.Сотрудник = НевыходТекущегоДокумента.Сотрудник;
		НоваяСтрока.ВремяНачала  = ОбщийМодульКлиентСервер.СоединитьДатуИВремя(НевыходТекущегоДокумента.ДатаНачала, НевыходТекущегоДокумента.ВремяНачала);
		НоваяСтрока.ВремяОкончания = ОбщийМодульКлиентСервер.СоединитьДатуИВремя(НевыходТекущегоДокумента.ДатаОкончания, НевыходТекущегоДокумента.ВремяОкончания);
		НоваяСтрока.ТекстНаГрафике = НевыходТекущегоДокумента.Комментарий;
		
		НоваяСтрока.Текущий = Истина;
		НоваяСтрока.ЗначениеНаГрафике = "Текущий";
		НоваяСтрока.Регистратор = Объект.Ссылка;
		НоваяСтрока.Дата = НевыходТекущегоДокумента.ДатаНачала;
 
		НоваяСтрока.Комментарий = НевыходТекущегоДокумента.Комментарий;
		НоваяСтрока.ОтсутствиеИсполнителя = Истина;
		НоваяСтрока.ТочкаПродаж = НевыходТекущегоДокумента.Сотрудник.ТочкаПродаж;
	
	КонецЦикла;
	
	ТаблицаГрафикЗамеров.Сортировать("Сотрудник Возр");
	
	//Вариант отображения (горизонтальный / вертикальный)
	Развертка = ?(ВариантОтображенияГрафика = 0, 0, 1);
	
	Если ВариантОтображенияГрафика = 0 ИЛИ ВариантОтображенияГрафика = 1 Тогда
		НастройкиГрафика = МодульОтчетов.ИнициализироватьНастройкиПланировщикаГрафикаЗамеров(График, Развертка, ДатаНачалаГрафика, КонецДня(ДатаОкончанияГрафика), Истина);				
		МодульОтчетов.ЗаполнитьГрафикЗамеровКалендарьПоЗамерщикам(График, НастройкиГрафика, ФильтрТочкаПродаж, ФильтрПодразделение, ТаблицаГрафикЗамеров, , Истина);
	КонецЕсли;
	
	Если ТаблицаЗамерщиков.Количество() = 0 Тогда
		Элементы.График.ТолькоПросмотр = Истина;
		Сообщить("Отсутствуют замерщики согласно указанным отборам!");
	Иначе
		Элементы.График.ТолькоПросмотр = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ГрафикПриАктивизации(Элемент)
	СтандартнаяОбработка = Ложь;
КонецПроцедуры

&НаКлиенте
Процедура ГрафикВыбор(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	Если Не Элементы.График.ВыделенныеЭлементы.Количество() Тогда
		Возврат;
	КонецЕсли;
	
	ВыделенныйЭлемент = Элементы.График.ВыделенныеЭлементы[0];
	ДокументРегистратор = ВыделенныйЭлемент.Значение.Регистратор;
		
	Если Не ЗначениеЗаполнено(ДокументРегистратор) Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Ключ", ДокументРегистратор);
	
	Если ТипЗнч(ДокументРегистратор) = Тип("ДокументСсылка.Лид") Тогда
		ОткрытьФорму("Документ.Лид.ФормаОбъекта", ПараметрыФормы);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ГрафикПередСозданием(Элемент, Начало, Конец, Значения, Текст, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	
	// если на графике нет сотрудников, то ничего не делаем
	Если Значения.Получить("Сотрудник") = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	//проверяем пересечения периодов
	Отказ = Ложь;
	Для Каждого СуществующаяЗапись Из ТаблицаГрафикЗамеров Цикл		
		Если СуществующаяЗапись.Сотрудник = Значения.Получить("Сотрудник") Тогда
			Если (СуществующаяЗапись.ВремяНачала > Начало ИЛИ СуществующаяЗапись.ВремяОкончания > Начало) 
				И (СуществующаяЗапись.ВремяНачала < Конец ИЛИ СуществующаяЗапись.ВремяОкончания < Конец) Тогда
				Отказ = Истина;							
			ИначеЕсли Начало = СуществующаяЗапись.ВремяНачала и Конец = СуществующаяЗапись.ВремяОкончания Тогда
				Отказ = Истина;						
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Если Отказ Тогда
		Сообщить("Выбранный интервал занят");
		Возврат;
	Иначе
		НовыйНевыход = Объект.Сотрудники.Добавить();
		НовыйНевыход.Сотрудник = Значения.Получить("Сотрудник");
		НовыйНевыход.ДатаНачала = НачалоДня(Начало);
		НовыйНевыход.ДатаОкончания = НачалоДня(Конец);
		НовыйНевыход.ВремяНачала = Дата(1,1,1) + (Начало - НачалоДня(Начало));
		НовыйНевыход.ВремяОкончания = Дата(1,1,1) + (Конец - НачалоДня(Конец));
		НовыйНевыход.ТочкаПродаж 	= ОбщийМодульВызовСервера.ЗначениеРеквизитаОбъекта(НовыйНевыход.Сотрудник, "ТочкаПродаж");
		НовыйНевыход.Подразделение 	= ОбщийМодульВызовСервера.ЗначениеРеквизитаОбъекта(НовыйНевыход.Сотрудник, "Подразделение");
			
		ОбновитьГрафикСервер();
		Модифицированность = Истина;
	КонецЕсли;
	
КонецПроцедуры

