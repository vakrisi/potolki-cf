
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Элементы.ДекорацияЕстьНевыполненныеЗамерыВыезды.Видимость = Параметры.ЕстьНевыполненныеЗамеры ИЛИ Параметры.ЕстьНевыполненныеВыезды;
	Если Параметры.ЕстьНевыполненныеЗамеры И НЕ Параметры.ЕстьНевыполненныеВыезды Тогда
		Элементы.ДекорацияЕстьНевыполненныеЗамерыВыезды.Заголовок = СтрЗаменить(Элементы.ДекорацияЕстьНевыполненныеЗамерыВыезды.Заголовок, "замеры / выезды", "замеры");	
		Элементы.ДекорацияЕстьНевыполненныеЗамерыВыезды.Заголовок = СтрЗаменить(Элементы.ДекорацияЕстьНевыполненныеЗамерыВыезды.Заголовок, "замеров / выездов", "замеров");
	ИначеЕсли НЕ Параметры.ЕстьНевыполненныеЗамеры И Параметры.ЕстьНевыполненныеВыезды Тогда
		Элементы.ДекорацияЕстьНевыполненныеЗамерыВыезды.Заголовок = СтрЗаменить(Элементы.ДекорацияЕстьНевыполненныеЗамерыВыезды.Заголовок, "замеры / выезды", "выезды");	
		Элементы.ДекорацияЕстьНевыполненныеЗамерыВыезды.Заголовок = СтрЗаменить(Элементы.ДекорацияЕстьНевыполненныеЗамерыВыезды.Заголовок, "замеров / выездов", "выездов");
	КонецЕсли;		
		
	//#8113
	ИнформацияОСтатусеЛида = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку("Статус лида: %1 -> %2", Параметры.ТекущийСтатус, Параметры.СтатусПерехода);
	
	// №9558
	ДатаСледующегоКонтакта = Параметры.ДатаСледующегоКонтакта;
	
	//#11632
	ВремяСдвигаВСекундах = ОбщийМодульСервер.ПолучитьВремяСдвигаДатыСледующегоКонтактаЛида(Перечисления.СобытияИзмененияДатыСледующегоКонтактаЛида.ОтложенныйЗамер);
	Если ВремяСдвигаВСекундах > 0 Тогда
		НоваяДатаСледующегоКонтакта = ТекущаяДатаСеанса() + ВремяСдвигаВСекундах;
		Дата = НоваяДатаСледующегоКонтакта;
		//#11632 реквизит ПоследнееВремяПерезвонить удален
		//Время = НоваяДатаСледующегоКонтакта;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ОбновитьИнформациюОДатеСледующегоКонтакта();
	
КонецПроцедуры

&НаКлиенте
Процедура Запланировать(Команда)
	
	Отказ = Ложь;
	Если Причина.Пустая() Тогда
		Отказ = Истина;
		ПоказатьОповещениеПользователя("Не указана причина");
	КонецЕсли;
	Если Дата = Дата(1,1,1) Тогда
		Отказ = Истина;
		ПоказатьОповещениеПользователя("Не указана дата");
	КонецЕсли;
	
	Если НЕ Отказ Тогда
		ПараметрыПланирования = Новый Структура;
		ПараметрыПланирования.Вставить("Дата", Дата);
		//#11632 реквизит ПоследнееВремяПерезвонить удален
		//ПараметрыПланирования.Вставить("Время",Время);
		ПараметрыПланирования.Вставить("Комментарий",Комментарий);
		ПараметрыПланирования.Вставить("Причина",Причина);
		Закрыть(ПараметрыПланирования);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Отмена(Команда)
	Закрыть();
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьИнформациюОДатеСледующегоКонтакта()
	
	//#11632 реквизит ПоследнееВремяПерезвонить удален
	//НоваяДатаСледующегоКонтакта = СокрЛП(Формат(Дата, "ДФ=dd.MM.yyyy") + " " + Формат(Время, "ДФ=HH:mm"));
	НоваяДатаСледующегоКонтакта = СокрЛП(Формат(Дата, "ДФ='dd.MM.yyyy HH:mm'"));
	ИнформацияОДатеСледующегоКонтакта = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		"Дата следующего контакта: %1 -> %2"
		, ?(ПустаяСтрока(ДатаСледующегоКонтакта), """Пустая""", ДатаСледующегоКонтакта)
		, ?(ПустаяСтрока(НоваяДатаСледующегоКонтакта), """Пустая""", НоваяДатаСледующегоКонтакта)
	);
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаПриИзменении(Элемент)
	
	ОбновитьИнформациюОДатеСледующегоКонтакта();
	
КонецПроцедуры




