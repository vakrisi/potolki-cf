Функция ЕстьЗамерИОнНеВыполнен()
	
	Результат = Ложь;
	Если Объект.Замеры.Количество() > 0 Тогда
		НомерЗамера = Объект.Замеры.Количество()-1;
		//Если НЕ ПустаяСтрока(Объект.Замеры[НомерЗамера].ИсполнительЗамера) // условие пока убрано, в случае пула здесь пусто 
		Если НЕ Объект.Замеры[НомерЗамера].ДатаЗамера = Дата(1,1,1)
			//И НЕ Объект.Замеры[НомерЗамера].ЗамерВыполнен И НЕ Объект.Замеры[НомерЗамера].Отменен Тогда
			И НЕ Объект.Замеры[НомерЗамера].ЗамерВыполнен 
			И НЕ Объект.Замеры[НомерЗамера].РезультатЗамера = ПредопределенноеЗначение("Справочник.РезультатЗамераЛида.ЗамерОтменен") 
			И НЕ Объект.Замеры[НомерЗамера].РезультатЗамера = ПредопределенноеЗначение("Справочник.РезультатЗамераЛида.ЗамерНеПроизводился") 
			Тогда
			Результат = Истина;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

