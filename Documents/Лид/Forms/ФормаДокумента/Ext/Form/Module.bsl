	Если ПоследнийЗамерПустой() Тогда
		СтруктураПараметров = новый Структура("СценарийНазначенияВыезда", Истина); // №14649
		ПоказатьВопрос(Новый ОписаниеОповещения("ПослеВопросаОПродолженииНазначенияЗамера", ЭтотОбъект, СтруктураПараметров), "Текущий замер не назначен, продолжить назначение замера?", РежимДиалогаВопрос.ДаНет);		
		Возврат;	
	КонецЕсли;
	
	Если ПоследнийВыездПустой() Тогда		
		ПоказатьВопрос(Новый ОписаниеОповещения("ПослеВопросаОПродолженииНазначенияВыезда", ЭтотОбъект), "Текущий выезд не назначен, продолжить назначение выезда?", РежимДиалогаВопрос.ДаНет);		
		Возврат;	
	КонецЕсли;
	
	Если ЕстьВыездИОнНеВыполнен() Тогда
		ОП = Новый ОписаниеОповещения("ОтветНаВопросОИзмененииВыезда", ЭтотОбъект);
		ПоказатьВопрос(ОП, "У лида уже имеется запланированный выезд. Изменить его?", РежимДиалогаВопрос.ДаНет);
	//++ №14649 если есть не выполненный замер, также предлагаем его изменить
	ИначеЕсли ЕстьЗамерИОнНеВыполнен() Тогда
		ОтветНаВопросОСозданииНовогоЗамера = Новый ОписаниеОповещения("ОтветНаВопросОоИзмененииЗамера", ЭтаФорма);
		ПоказатьВопрос(ОтветНаВопросОСозданииНовогоЗамера, "У лида имеется запланированный замер. Изменить его?", РежимДиалогаВопрос.ДаНет);
	//-- №14649
	ИначеЕсли ЕстьВыездИОнВыполнен() Тогда
		ОП = Новый ОписаниеОповещения("ОтветНаВопросОСозданииНовогоВыезда", ЭтотОбъект);
		ПоказатьВопрос(ОП, "У лида уже имеется выполненный выезд. Создать новый?", РежимДиалогаВопрос.ДаНет);
	Иначе
		НазначитьВыездЗавершение();		
