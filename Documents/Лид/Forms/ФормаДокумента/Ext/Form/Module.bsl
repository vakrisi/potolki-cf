&НаКлиенте
Процедура ЗакрытьОбращениеФрагмент(Результат, ДопПараметры) Экспорт
	
	Если НЕ ТипЗнч(Результат) = Тип("Строка") Тогда
		Возврат;
	КонецЕсли;
	
	ДобавитьЗаписьВИсториюКлиент("Закрыто обращение клиента." + ?(ПустаяСтрока(Результат), "", " Комментарий: " + Результат));
	ЗакрытьОбращениеЗавершение(ПредопределенноеЗначение("Справочник.ВидыОбращенийЛида.ПустаяСсылка"));
	Объект.ВидОбращения = ПредопределенноеЗначение("Справочник.ВидыОбращенийЛида.ПустаяСсылка");
	Объект.РезультатОбращения = ПредопределенноеЗначение("Справочник.РезультатыЛида.Закрыт");
	Объект.ДатаЗакрытияОбращения = ТекущаяДата();
	УправлениеЭлементамиФормыПоСтатусу();
	
	Модифицированность = Истина;
	
КонецПроцедуры

