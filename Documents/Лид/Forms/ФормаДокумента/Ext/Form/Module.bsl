&НаКлиенте
Процедура Отказ(Команда)
	
	//#6305
	Если НЕ РазрешенПереводСтатуса(Объект.ТекущийСтатус, ПредопределенноеЗначение("Справочник.СтатусыЛида.Отказ")) Тогда 
		Сообщить("Перевод статуса лида не предусмотрен настройками программы!");
		Возврат;
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ЕстьНезавершенныеЗамеры", ЕстьНезавершенныеЗамеры());
	ПараметрыФормы.Вставить("ТекущийСтатус", Объект.ТекущийСтатус); //#8113
	ПараметрыФормы.Вставить("СтатусПерехода", Строка(ПредопределенноеЗначение("Справочник.СтатусыЛида.Отказ"))); //#8113
	//ПараметрыФормы.Вставить("ДатаСледующегоКонтакта", СокрЛП(Формат(Объект.ПоследняяДатаПерезвонить, "ДФ=dd.MM.yyyy") + " " + Формат(Объект.ПоследнееВремяПерезвонить, "ДФ=HH:mm"))); //№9558
	ПараметрыФормы.Вставить("ДатаСледующегоКонтакта", СокрЛП(Формат(Объект.ПоследняяДатаПерезвонить, "ДФ='dd.MM.yyyy HH:mm'"))); //№9558
	ОписаниеОповещения = Новый ОписаниеОповещения("ОтказЗавершение", ЭтотОбъект);
	ОткрытьФорму("Документ.Лид.Форма.ПричинаОтказа", ПараметрыФормы, ЭтаФорма, , , , ОписаниеОповещения);
		
