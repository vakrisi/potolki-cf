Процедура НеЦелевойЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Объект.ТекущийСтатус = ПредопределенноеЗначение("Справочник.СтатусыЛида.НеЦелевой");
	Объект.ВидНецелевогоЛида = Результат.Вид;
	ТекстВИсторию = "Лид не целевой. Вид: " + Результат.Вид + ". " + ?(ПустаяСтрока(Результат.Комментарий), "", ". Комментарий: " + Результат.Комментарий);
	ДобавитьЗаписьВИсториюКлиент(ТекстВИсторию);
	Объект.ПоследнийКомментарий = ТекстВИсторию; // #17148
	ОчиститьДатуСледующегоКонтактаБезЗаписиВИсторию(); // №9558
	Модифицированность = Истина;
	УправлениеЭлементамиФормыПоСтатусу();
	
КонецПроцедуры

#КонецОбласти

#Область ВкладкаЛид

&НаКлиенте
Процедура ТекущийСтатусПриИзменении(Элемент)
	
	НовыйСтатус = Объект.ТекущийСтатус;
	Если НовыйСтатус = ПредопределенноеЗначение("Справочник.СтатусыЛида.ДоговорОформлен") Тогда
		НовыйСтатус = ПредопределенноеЗначение("Справочник.СтатусыЛида.ОформитьДоговор");
	КонецЕсли;
	Модифицированность = Ложь;
	
	Объект.ТекущийСтатус = мТекущийСтатус; //установим статус перед изменением, чтобы общая логика отработала
	
	//#6305
	Если НЕ РазрешенПереводСтатуса(Объект.ТекущийСтатус, НовыйСтатус) Тогда 
		Сообщить("Перевод статуса лида не предусмотрен настройками программы!");
		Возврат;
	КонецЕсли;

	Если НовыйСтатус = ПредопределенноеЗначение("Справочник.СтатусыЛида.ОтложенныйНазначитьЗамер") Тогда
		Перезвонить(Элемент);
	ИначеЕсли НовыйСтатус = ПредопределенноеЗначение("Справочник.СтатусыЛида.НазначитьЗамер") Тогда
		НазначитьЗамер(Элемент);
	ИначеЕсли НовыйСтатус = ПредопределенноеЗначение("Справочник.СтатусыЛида.ОформитьДоговор") Тогда
		Если мТекущийСтатус = ПредопределенноеЗначение("Справочник.СтатусыЛида.ОтложенныйЗаключитьДоговор") Тогда
			//#14448 особый случай, меняем только Статус
			Объект.ТекущийСтатус = НовыйСтатус;
			ДобавитьЗаписьВИсториюКлиент("Изменен статус на ""Оформить договор""");
			Модифицированность = Истина;
		Иначе
			ОформитьДоговор(Элемент);
		КонецЕсли;
	ИначеЕсли НовыйСтатус = ПредопределенноеЗначение("Справочник.СтатусыЛида.Обращение") Тогда
		ПеревестиВСтатусОбращение(Элемент);
	//ИначеЕсли НовыйСтатус = ПредопределенноеЗначение("Справочник.СтатусыЛида.Сервис") Тогда
	//	ОформитьСервиснуюЗаявку(Элемент);
	//ИначеЕсли НовыйСтатус = ПредопределенноеЗначение("Справочник.СтатусыЛида.Рекламация") Тогда
	//	ОформитьРекламацию(Элемент);
	ИначеЕсли НовыйСтатус = ПредопределенноеЗначение("Справочник.СтатусыЛида.Отказ") Тогда
		Отказ(Элемент);
	ИначеЕсли НовыйСтатус = ПредопределенноеЗначение("Справочник.СтатусыЛида.НеЦелевой") Тогда
		НеЦелевой(Элемент);
	Иначе
		Объект.ТекущийСтатус = НовыйСтатус;
	КонецЕсли;
	
	УправлениеЭлементамиФормыПоСтатусу();

КонецПроцедуры

&НаКлиенте
Процедура ТекущийСтатусНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	мТекущийСтатус = Объект.ТекущийСтатус;
	
	//#6305 обработка в ОбработкаПолученияДанныхВыбора справочника СтатусыЛида
	ПараметрыВыбораСтатуса = Новый Массив;
	ПараметрыВыбораСтатуса.Добавить(Новый ПараметрВыбора("ТекущийСтатус", мТекущийСтатус));
	Элемент.ПараметрыВыбора = Новый ФиксированныйМассив(ПараметрыВыбораСтатуса);

КонецПроцедуры

