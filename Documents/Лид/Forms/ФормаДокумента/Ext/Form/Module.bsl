&НаСервере
Процедура УправлениеЭлементамиФормыПоСтатусу()
	
	//#6305
	//ФормаНазначитьЗамерДоступность = Истина;
	//Если Объект.ТекущийСтатус = Справочники.СтатусыЛида.Отказ
	//	ИЛИ Объект.ТекущийСтатус = Справочники.СтатусыЛида.НеЦелевой Тогда
	//	ФормаНазначитьЗамерДоступность = Ложь;
	//КонецЕсли;
	//Элементы.ФормаНазначитьЗамер.Доступность = ФормаНазначитьЗамерДоступность;
	
	Если КэшированныеЗначения = Неопределено 
		ИЛИ (ТипЗнч(КэшированныеЗначения) = Тип("Структура") И НЕ КэшированныеЗначения.Свойство("СоответствиеСтатусовИЭлементов")) Тогда
		
		СоответствиеСтатусовИЭлементов = Новый Соответствие;
		//СоответствиеСтатусовИЭлементов.Вставить(Справочники.СтатусыЛида.НазначитьЗамер, Элементы.);
		
		//++ №14649 статус Замер/Выезд отвечает за несколько кнопок Замер и Выезд соответственно
		//СоответствиеСтатусовИЭлементов.Вставить(Справочники.СтатусыЛида.ЗаполнитьДанныеЗамера, Элементы.ФормаНазначитьЗамер);
		МассивЭлементов = Новый Массив;
		МассивЭлементов.Добавить(Элементы.ФормаНазначитьЗамер);
		МассивЭлементов.Добавить(Элементы.ФормаНазначитьВыезд);
		
		СоответствиеСтатусовИЭлементов.Вставить(Справочники.СтатусыЛида.ЗаполнитьДанныеЗамера, МассивЭлементов);
		//-- №14649
		
		//СоответствиеСтатусовИЭлементов.Вставить(Справочники.СтатусыЛида.ОформитьДоговор, Элементы.);
		СоответствиеСтатусовИЭлементов.Вставить(Справочники.СтатусыЛида.ДоговорОформлен, Элементы.ФормаОформитьДоговор);
		СоответствиеСтатусовИЭлементов.Вставить(Справочники.СтатусыЛида.ОтложенныйНазначитьЗамер, Элементы.ФормаПерезвонить);
		//СоответствиеСтатусовИЭлементов.Вставить(Справочники.СтатусыЛида.ОтложенныйЗаключитьДоговор, Элементы.);
		СоответствиеСтатусовИЭлементов.Вставить(Справочники.СтатусыЛида.Отказ, Элементы.ФормаОтказ);
		//#11332
		СоответствиеСтатусовИЭлементов.Вставить(Справочники.СтатусыЛида.Обращение, Элементы.ПеревестиВСтатусОбращение);
		//СоответствиеСтатусовИЭлементов.Вставить(Справочники.СтатусыЛида.Рекламация, Элементы.ОформитьРекламацию);
		//СоответствиеСтатусовИЭлементов.Вставить(Справочники.СтатусыЛида.Сервис, Элементы.ОформитьСервиснуюЗаявку);
		СоответствиеСтатусовИЭлементов.Вставить(Справочники.СтатусыЛида.НеЦелевой, Элементы.НеЦелевой);
		
		Если КэшированныеЗначения = Неопределено Тогда
			КэшированныеЗначения = Новый Структура;
		КонецЕсли;
		КэшированныеЗначения.Вставить("СоответствиеСтатусовИЭлементов", СоответствиеСтатусовИЭлементов);
		
	КонецЕсли;

	ДоступныеСтатусы = РегистрыСведений.ПорядокПереводаСтатусаЛида.ДоступныеДляПереводаСтатусы(Объект.ТекущийСтатус);
	Для каждого КлючЗначение из КэшированныеЗначения.СоответствиеСтатусовИЭлементов Цикл
		
		//++ №14649 статус может отвечать за несколько элементов формы
		Если ТипЗнч(КлючЗначение.Значение) = Тип("Массив") Тогда
			МассивЭлементовФормы = КлючЗначение.Значение;
		Иначе
			МассивЭлементовФормы = новый Массив;
			МассивЭлементовФормы.Добавить(КлючЗначение.Значение);
		КонецЕсли;
		//-- №14649
			
		Для Каждого ЭлементФормы Из МассивЭлементовФормы Цикл
			//ЭлементФормы = КлючЗначение.Значение;
			ЭлементФормы.Доступность = НЕ (ДоступныеСтатусы.Найти(КлючЗначение.Ключ) = Неопределено);
		КонецЦикла;
		
	КонецЦикла;
	
	//#11332 #16875 кнопки перенесены вправо
	//Элементы.КоманднаяПанельОбращение.Видимость = (Объект.ТекущийСтатус = Справочники.СтатусыЛида.Обращение);
	Элементы.ГруппаПанельОбращения1.Доступность  = (Объект.ТекущийСтатус = Справочники.СтатусыЛида.Обращение);
	Элементы.ПеревестиВСтатусОбращение.Видимость = НЕ Объект.ТекущийСтатус = Справочники.СтатусыЛида.Обращение И СтатусОбращениеИспользуется;
	Элементы.ГруппаПанельОбращения2.Видимость    = (Объект.ТекущийСтатус = Справочники.СтатусыЛида.Обращение);
	Элементы.ДатаЗакрытияОбращения.Видимость = (Объект.ТекущийСтатус = Справочники.СтатусыЛида.Обращение);
	Если Объект.ТекущийСтатус = Справочники.СтатусыЛида.Обращение Тогда
		Элементы.ОформитьПродажу.Пометка 		 = Объект.ВидОбращения = ПредопределенноеЗначение("Справочник.ВидыОбращенийЛида.Продажа"); //++ №12721
		Элементы.ОформитьСервиснуюЗаявку.Пометка = Объект.ВидОбращения = ПредопределенноеЗначение("Справочник.ВидыОбращенийЛида.СервиснаяЗаявка");
		Элементы.ОформитьРекламацию.Пометка 	 = Объект.ВидОбращения = ПредопределенноеЗначение("Справочник.ВидыОбращенийЛида.Рекламация");
		Элементы.ЗакрытьОбращение.Пометка 		 = Объект.РезультатОбращения = ПредопределенноеЗначение("Справочник.РезультатыЛида.Закрыт");
	КонецЕсли;
	
КонецПроцедуры

//#6588
&НаСервере
Процедура УправлениеЭлементамиФормыПоРезультатуЗамера()
	
	ТолькоПросмотрЭлементов = НЕ ТекущийРезультатЗамера.Пустая();
	
	// #16066
	ТолькоПросмотрЭлементовЭлементовАдреса = ТолькоПросмотрЭлементов;
	Если ТолькоПросмотрЭлементовЭлементовАдреса И РазрешеноРедактированиеАдресаВЛидахСВыполненнымЗамером Тогда
		ТолькоПросмотрЭлементовЭлементовАдреса = Ложь;	
	КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ЗамерЗаключенДоговор", 			"Доступность", НЕ ТолькоПросмотрЭлементов);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ЗамерДоговорНеЗаключен", 		"Доступность", НЕ ТолькоПросмотрЭлементов);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ЗамерНазначитьНовыйЗамер", 		"Доступность", НЕ ТолькоПросмотрЭлементов);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ДатаЗамера", 					"ТолькоПросмотр", ТолькоПросмотрЭлементов);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ЗамерыДатаЗамера1", 			"ТолькоПросмотр", ТолькоПросмотрЭлементов);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "Город", 						"ТолькоПросмотр", ТолькоПросмотрЭлементов);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "Город1", 						"ТолькоПросмотр", ТолькоПросмотрЭлементов);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "Адрес1", 						"ТолькоПросмотр", ТолькоПросмотрЭлементовЭлементовАдреса);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "Адрес", 						"ТолькоПросмотр", ТолькоПросмотрЭлементовЭлементовАдреса);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ВыбратьАдрес1", 				"Доступность", НЕ ТолькоПросмотрЭлементовЭлементовАдреса);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ВыбратьАдрес", 					"Доступность", НЕ ТолькоПросмотрЭлементовЭлементовАдреса);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ПоследнийКомментарийКЗамеру1", 	"ТолькоПросмотр", ТолькоПросмотрЭлементов);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ЗамерыКомментарийКЗамеру1", 	"ТолькоПросмотр", ТолькоПросмотрЭлементов);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ГруппаГрафик", 					"ТолькоПросмотр", ТолькоПросмотрЭлементов);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ГрафикЗамеров", 				"ТолькоПросмотр", ТолькоПросмотрЭлементов);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ГрафикТаблица", 				"ТолькоПросмотр", ТолькоПросмотрЭлементов);
	
КонецПроцедуры

//#6588
&НаСервере
Процедура УправлениеЭлементамиФормыПоРезультатуВыезда()
	
	ТолькоПросмотрЭлементов = НЕ ТекущийРезультатВыезда.Пустая(); // №14649 было: ТекущийРезультатВыезда; // признак Выполнен
	
