&НаКлиенте
Процедура ЗамерЗаключенДоговорЗавершение(Результат, ДополнительныеПараметры) Экспорт

	Если НЕ Результат = Неопределено Тогда
		ЗамерВыполнен = Истина;
		РезультатЗамера = ПредопределенноеЗначение("Справочник.РезультатЗамераЛида.ЗаключенДоговор");
		СуммаДоговораНаЗамере = Результат.СуммаДоговора;
		СуммаАвансаНаЗамере = Результат.СуммаАвансаНаЗамере;
		
		//#6588
		ТекущийРезультатЗамера = РезультатЗамера;
		Элементы.Замеры.ТекущиеДанные.ЗамерВыполнен = Истина;
		Элементы.Замеры.ТекущиеДанные.РезультатЗамера = РезультатЗамера;
		Элементы.Замеры.ТекущиеДанные.СуммаДоговораНаЗамере = Результат.СуммаДоговора;
		Элементы.Замеры.ТекущиеДанные.СуммаАвансаНаЗамере = Результат.СуммаАвансаНаЗамере;
		Элементы.Замеры.ТекущиеДанные.КомментарийЗамерщика = Результат.Комментарий;
		
		Объект.ПредполагаемыйМонтажВремя = Результат.ВремяМонтажа;
		Объект.ПредполагаемыйМонтажДата = Результат.ДатаМонтажа;
		Объект.ПредполагаемыйМонтажДатаМонтажаНеОпределена = Результат.ДатаБудетОпределенаПоЗвонку;
		Объект.ПоследнийКомментарий = Результат.Комментарий;
		Объект.ПоследнийКомментарийЗамерщика = Результат.Комментарий;
		
		ТекстМонтаж = "";
		Если Результат.ДатаБудетОпределенаПоЗвонку Тогда
			ТекстМонтаж = ТекстМонтаж + "Дата монтажа будет определена по звонку. ";
		Иначе
			ТекстМонтаж = "При замере указана дата монтажа " + Формат(Результат.ДатаМонтажа,"ДЛФ=Д") + " время: " + Формат(Результат.ВремяМонтажа,"ДЛФ=В")
		КонецЕсли;
		
		ДобавитьЗаписьВИсториюКлиент("Замер выполнен. " + ПредопределенноеЗначение("Справочник.РезультатЗамераЛида.ЗаключенДоговор") + ". Предварительная сумма: " + СуммаДоговораНаЗамере + ". Получен аванс: " + СуммаАвансаНаЗамере + ". " + ТекстМонтаж + ?(ПустаяСтрока(Результат.Комментарий),""," Комментарий: " + Результат.Комментарий));
		Модифицированность = Истина;
		Объект.ТекущийСтатус = ПредопределенноеЗначение("Справочник.СтатусыЛида.ОформитьДоговор");
		УправлениеЭлементамиФормыПоСтатусу();
	КонецЕсли;
	
	
	Если НЕ ЗамерВыполнен Тогда
		Элементы.ГруппаЗамерВыезд.ЦветФона = WebЦвета.ТемноОранжевый;
	Иначе
		Элементы.ГруппаЗамерВыезд.ЦветФона = WebЦвета.Белый;
	КонецЕсли;
	
КонецПроцедуры

