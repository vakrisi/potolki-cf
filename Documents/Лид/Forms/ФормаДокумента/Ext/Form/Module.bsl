&НаКлиенте
Процедура ОтправитьСМС(Команда)
	
	ТелефоныКлиента = УправлениеКонтактнойИнформациейКлиентПотолки.ПолучитьТелефонИзКонтактнойИнформацииФормы(ЭтотОбъект);
	Если ЗначениеЗаполнено(ТелефоныКлиента) Тогда	
		Парам = Новый Структура;
		Парам.Вставить("Основание", Объект.Ссылка);
		ОткрытьФорму("Документ.ОтправкаСМС.Форма.ФормаДокумента", Парам,,,,, Новый ОписаниеОповещения("ПослеЗакрытияФормыНовогоСМС", ЭтаФорма));
	Иначе
		ПоказатьОповещениеПользователя("Не указан номер телефона клиента. СМС не создана");
	КонецЕсли;
	ОбновитьИзображениеКомандОтправкиСообщений();
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьИзображениеКомандОтправкиСообщений()
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Основание", Объект.Ссылка);

	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ОтправкаСМС.Ссылка,
	|	1 КАК Создано,
	|	ВЫБОР
	|		КОГДА ОтправкаСМС.Отправлено
	|			ТОГДА 1
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК Отправлено
	|ИЗ
	|	Документ.ОтправкаСМС КАК ОтправкаСМС
	|ГДЕ
	|	ОтправкаСМС.Основание = &Основание";
	
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	Если РезультатЗапроса.Количество() > 0 Тогда
		РезультатЗапроса.Свернуть("", "Создано, Отправлено");
	КонецЕсли;
	
	Если РезультатЗапроса.Количество() = 0 Тогда
		Элементы.ОтправитьСМС.Картинка = БиблиотекаКартинок.ОтправитьSMS;
	Иначе
		Если РезультатЗапроса[0].Отправлено >= РезультатЗапроса[0].Создано Тогда
			Элементы.ОтправитьСМС.Картинка = БиблиотекаКартинок.ОтправленоСМС;
		Иначе
			Элементы.ОтправитьСМС.Картинка = БиблиотекаКартинок.ПриготовленоСМС;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

