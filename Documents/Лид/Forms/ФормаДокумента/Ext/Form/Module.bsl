//&НаКлиенте
//Процедура ИсторияЛидаНаФормеВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
&НаКлиенте
Процедура ИсторияДокументаВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	
	ТекущиеДанные = Элемент.ТекущиеДанные;
	
	ПараметрыНовойФормы = Новый Структура;
	ПараметрыНовойФормы.Вставить("Лид", Объект.Ссылка);
	ПараметрыНовойФормы.Вставить("Дата", ТекущиеДанные.Дата);
	ПараметрыНовойФормы.Вставить("Пользователь", ТекущиеДанные.Пользователь);
	ПараметрыНовойФормы.Вставить("ИДЗаписи", ТекущиеДанные.ИДЗаписи);
	//ТекущийКомментарий = ?(ПустаяСтрока(ТекущиеДанные.РасширенныйКомментарий), ТекущиеДанные.Комментарий, ТекущиеДанные.РасширенныйКомментарий);
	ТекущийКомментарий = ?(ПустаяСтрока(ТекущиеДанные.Комментарий), ТекущиеДанные.ПредставлениеКомментария, ТекущиеДанные.Комментарий);
	ПараметрыНовойФормы.Вставить("Комментарий", ТекущийКомментарий);
	ОткрытьФорму("Документ.Лид.Форма.ФормаКомментарий", ПараметрыНовойФормы,ЭтаФорма,,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ИсторияДокументаПриПолученииДанныхНаСервере(ИмяЭлемента, Настройки, Строки)
	
	//++ #12137
	Для каждого СтрокаДС из Строки Цикл
		КомментарийЗаписи = СтрокаДС.Значение.Данные.ПредставлениеКомментария;		
		КомментарийЗаписи = СтрЗаменить(КомментарийЗаписи, "</a>", "");
		Поз1 = СтрНайти(КомментарийЗаписи, "<a href = v8:{");
		Поз2 = СтрНайти(КомментарийЗаписи, "}>");
		Если Поз1 > 0 И Поз2 > 0 Тогда
			КомментарийЗаписи = Лев(КомментарийЗаписи, Поз1-1) + Сред(КомментарийЗаписи, Поз2+2);	
		КонецЕсли;
		СтрокаДС.Значение.Данные.ПредставлениеКомментария = КомментарийЗаписи;
	КонецЦикла;
	//-- #12137

КонецПроцедуры

