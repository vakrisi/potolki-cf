&НаКлиенте
Процедура ЗамерЗаключенДоговор(Команда)
	
	ТекущиеДанныеЗамера = Элементы.Замеры.ТекущиеДанные;
	Если НЕ ЗначениеЗаполнено(ТекущиеДанныеЗамера.ИсполнительЗамера) Тогда
		Сообщить("Необходимо указать исполнителя замера!");
		Возврат;
	КонецЕсли;
	
	Если НЕ ПроверитьУказаниеВремениЗамера() Тогда
		Возврат;
	КонецЕсли;
	
	ЭтаФорма.Записать();
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ТекущийСтатус", Объект.ТекущийСтатус); //#8113
	ПараметрыФормы.Вставить("СтатусПерехода", Строка(ПредопределенноеЗначение("Справочник.СтатусыЛида.ОформитьДоговор"))); //#8113
