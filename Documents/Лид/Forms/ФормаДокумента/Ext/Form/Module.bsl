Процедура ЗакрытьОбращение(Команда)
	
	Если Объект.РезультатОбращения = ПредопределенноеЗначение("Справочник.РезультатыЛида.Закрыт") Тогда
		Сообщить("Обращение уже закрыто");
		Возврат;
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Заголовок", "Закрыть обращение клиента?");
	ПараметрыФормы.Вставить("ЗаголовокТекста", "Комментарий");

	ОписаниеОповещения = Новый ОписаниеОповещения("ЗакрытьОбращениеФрагмент", ЭтотОбъект);
	ОткрытьФорму("ОбщаяФорма.ВводМногострочногоТекста", ПараметрыФормы, ЭтаФорма, , , , ОписаниеОповещения);
	
