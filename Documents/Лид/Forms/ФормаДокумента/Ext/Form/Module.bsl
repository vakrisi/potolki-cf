&НаКлиенте
Процедура ОформитьДоговорФрагмент(Результат, ДопПараметры) Экспорт

	Если НЕ Объект.РазрешитьОфорлениеДоговораБезЗамера И НЕ РазрешенПереводСтатуса(Объект.ТекущийСтатус, ПредопределенноеЗначение("Справочник.СтатусыЛида.ДоговорОформлен")) Тогда
		Сообщить("Перевод статуса лида не предусмотрен настройками программы!");
		Возврат;
	КонецЕсли;
	
	Если ЕстьОформленныйЗаказДоговор() Тогда
		Если НЕ Объект.ТекущийСтатус = ПредопределенноеЗначение("Справочник.СтатусыЛида.ДоговорОформлен") Тогда
			Объект.ТекущийСтатус = ПредопределенноеЗначение("Справочник.СтатусыЛида.ДоговорОформлен");
			Модифицированность = Истина;
		КонецЕсли;
		ПослеОтветаОСозданииДоговора = Новый ОписаниеОповещения("ПослеОтветаОСозданииДоговора",ЭтаФорма);
		ПоказатьВопрос(ПослеОтветаОСозданииДоговора, "По данному лиду уже оформлен заказ-договор. Создать новый?", РежимДиалогаВопрос.ДаНет);
	Иначе
		ОформитьДоговорФрагмент2();
	КонецЕсли;
			
КонецПроцедуры

&НаКлиенте
Процедура ПослеОтветаОСозданииДоговора(Результат, ДопПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
        ОформитьДоговорФрагмент2();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОформитьДоговорФрагмент2()
	
	ПараметрыНовогоДокумента = Новый Структура;
	ПараметрыНовогоДокумента.Вставить("Основание", 		Объект.Ссылка);
	ПараметрыНовогоДокумента.Вставить("Адрес", 			?(ПустаяСтрока(Объект.Город), Объект.Адрес, Строка(Объект.Город) + ", " + Объект.Адрес));
	ПараметрыНовогоДокумента.Вставить("Геометка", 		Объект.Геометка);
	ПараметрыНовогоДокумента.Вставить("Сумма", 			Объект.ПоследняяСуммаДоговораНаЗамере);
	ПараметрыНовогоДокумента.Вставить("ИмяКлиента", 	Объект.ИмяКлиента);
	
	СписокЗамеровДляОформления = ПолучитьЗамерыДляОформленияДоговора(); // №11768
	
	ИсполнительВЗаказ = ПредопределенноеЗначение("Справочник.Сотрудники.ПустаяСсылка");
	ИдентификаторЗамера = Неопределено; // №11768
	
	Если СписокЗамеровДляОформления.Количество() = 1 Тогда
		
		ИсполнительВЗаказ = СписокЗамеровДляОформления[0].ИсполнительЗамера;
		ИдентификаторЗамера = СписокЗамеровДляОформления[0].ИдентификаторЗамера;
		
	ИначеЕсли СписокЗамеровДляОформления.Количество() > 1 Тогда
		
		// несколько возможных замеров
		ОписаниеОповещения = Новый ОписаниеОповещения("ВыборЗамераДляОформленияДоговораЗавершение", ЭтотОбъект, ПараметрыНовогоДокумента);
		ОткрытьФорму("Документ.Лид.Форма.ВыборИсполнителяЗаказа", новый Структура("СписокЗамеровДляОформления", СписокЗамеровДляОформления), ЭтаФорма, , , , ОписаниеОповещения);
		Возврат;
		
	КонецЕсли;
		
	ПараметрыНовогоДокумента.Вставить("Исполнитель", ИсполнительВЗаказ);
	ПараметрыНовогоДокумента.Вставить("ИдентификаторЗамера", ИдентификаторЗамера); // №11768
	
	ОформитьДоговорЗавершение(ПараметрыНовогоДокумента);
		
КонецПроцедуры

&НаКлиенте
Процедура ВыборЗамераДляОформленияДоговораЗавершение(ВыбранноеЗначение, ДополнительныеПараметры) Экспорт
	
	Если ВыбранноеЗначение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ДополнительныеПараметры.Вставить("Исполнитель", ВыбранноеЗначение.Исполнитель);
