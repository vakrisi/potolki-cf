&НаКлиенте
Процедура СделатьОсновнымПредварительнымРасчетом(Команда)
	
	ТекущиеДанные = Элементы.ПредварительныеРасчеты.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	//++ №14089 если был основным, убираем из основного
	Если Объект.ОсновнойПредварительныйРасчет = ТекущиеДанные.Ссылка Тогда
		Объект.ОсновнойПредварительныйРасчет = ПредопределенноеЗначение("Документ.ПредварительныйРасчетЗаказДоговора.ПустаяСсылка");
	//-- №14089
	Иначе
		Объект.ОсновнойПредварительныйРасчет = ТекущиеДанные.Ссылка;
		ДобавитьВИсториюНаФормеЗаписьОбИзмененииОсновногоРасчета()
	КонецЕсли;
	
	Для Каждого ТекущаяСтрока Из ПредварительныеРасчеты Цикл
		
		ТекущаяСтрока.Основной = Ложь;
		
		Если ТекущаяСтрока.Ссылка = Объект.ОсновнойПредварительныйРасчет Тогда
			ТекущаяСтрока.Основной = Истина;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьВИсториюНаФормеЗаписьОбИзмененииОсновногоРасчета()
	СтрокаЗаписи = ИсторияЛидаНаФорме.Добавить();		
	СтрокаЗаписи.Дата = ТекущаяДатаСеанса();
	СтрокаЗаписи.Пользователь = Пользователи.ТекущийПользователь();
	СтрокаЗаписи.Комментарий = "Предварительный расчет №" + Объект.ОсновнойПредварительныйРасчет.Номер + " от " + Объект.ОсновнойПредварительныйРасчет.Дата + " установлен как основной";		
КонецПроцедуры

