Процедура НазначитьЗамерЗавершение(ЭтоИзменение=Ложь)
	
	ПланированиеЗамера = Истина;
	ПланированиеВыезда = Ложь;
	Если НЕ ЭтоИзменение Тогда
		НоваяСтрока = ДобавитьНовыйЗамер();
		ОчиститьДатуСледующегоКонтактаБезЗаписиВИсторию(); // №9558
