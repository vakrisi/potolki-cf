&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	// СтандартныеПодсистемы.Свойства
	УправлениеСвойствами.ПередЗаписьюНаСервере(ЭтотОбъект, ТекущийОбъект);
	// Конец СтандартныеПодсистемы.Свойства
	
	УправлениеКонтактнойИнформациейПотолки.ПередЗаписьюНаСервере(ЭтотОбъект, ТекущийОбъект);
	
	Если ТекущийОбъект.Замеры.Количество() > 0 Тогда	
		ПредыдущийГрафикЗамеров = ТекущийОбъект.Замеры.ВыгрузитьКолонки(); //только колонки
		Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
			ПредыдущийГрафикЗамеров = Объект.Ссылка.Замеры.Выгрузить();
		КонецЕсли;
		ТекущийГрафикЗамеров = ТекущийОбъект.Замеры.Выгрузить();
		
		ЕстьНовыеИлиИзмененныеЗамеры = ДобавитьЗаписиВИсториюПоЗамерамИВыездам(ТекущийОбъект, ПредыдущийГрафикЗамеров, ТекущийГрафикЗамеров);
		НазначенЗамер = ЕстьНовыеИлиИзмененныеЗамеры;
		Если ЕстьНовыеИлиИзмененныеЗамеры Тогда
			ТекущийОбъект.ТекущийСтатус = Справочники.СтатусыЛида.ЗаполнитьДанныеЗамера;
			СоздатьЭлектронноеПисьмоЗамерщику(ТекущийОбъект);
		КонецЕсли;
	КонецЕсли;
	
	Если ТекущийОбъект.Выезды.Количество() > 0 Тогда
		ПредыдущийГрафикВыездов = ТекущийОбъект.Выезды.ВыгрузитьКолонки(); //только колонки
		Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
			ПредыдущийГрафикВыездов = Объект.Ссылка.Выезды.Выгрузить();
		КонецЕсли;
		ТекущийГрафикВыездов = ТекущийОбъект.Выезды.Выгрузить();
		
		ЕстьНовыеИлиИзмененныеВыезды = ДобавитьЗаписиВИсториюПоЗамерамИВыездам(ТекущийОбъект, ПредыдущийГрафикВыездов, ТекущийГрафикВыездов, Истина);
		
		//++ №14649 нужно перевести в статус Замер/Выезд
		Если ЕстьНовыеИлиИзмененныеВыезды Тогда
			ТекущийОбъект.ТекущийСтатус = Справочники.СтатусыЛида.ЗаполнитьДанныеЗамера;
		КонецЕсли;
		//-- №14649
		
	КонецЕсли;
	
	//++ №14913 перенесено из ПередЗаписью
	КоличествоОтмененныхЗамеров = 0;
	Для Каждого ТекЗамер Из ТекущийОбъект.Замеры Цикл
		Если ТекЗамер.РезультатЗамера = ПредопределенноеЗначение("Справочник.РезультатЗамераЛида.ЗамерОтменен")
			ИЛИ ТекЗамер.РезультатЗамера = ПредопределенноеЗначение("Справочник.РезультатЗамераЛида.ЗамерНеПроизводился")
		Тогда
			КоличествоОтмененныхЗамеров = КоличествоОтмененныхЗамеров + 1;
		КонецЕсли;
	КонецЦикла;
	//-- №14913 перенесено из ПередЗаписью
	
	Если НЕ ТекущийОбъект.ТекущийСтатус = ПредопределенноеЗначение("Справочник.СтатусыЛида.Отказ")
		И НЕ ТекущийОбъект.ТекущийСтатус = ПредопределенноеЗначение("Справочник.СтатусыЛида.НеЦелевой") Тогда
		
		//++ №14649 Последняя дата замера заполняется по последней дате назначения замера или выезда
		ЗамерыВыездыВременная = ТекущийОбъект.Замеры.Выгрузить();
		
		Для Каждого ТекущаяСтрока Из ТекущийОбъект.Выезды Цикл
			
			НоваяСтрока = ЗамерыВыездыВременная.Добавить();
			
			НоваяСтрока.ДатаЗамера = ТекущаяСтрока.Дата;
			НоваяСтрока.ВремяНачалаЗамера = ТекущаяСтрока.ВремяНачала;
			НоваяСтрока.ВремяОкончанияЗамера = ТекущаяСтрока.ВремяОкончания;
			НоваяСтрока.ДатаНазначенияЗамера = ТекущаяСтрока.ДатаНазначения;
			
		КонецЦикла;
		
		ЗамерыВыездыВременная.Сортировать("ДатаНазначенияЗамера УБЫВ");
		
		Если ЗамерыВыездыВременная.Количество() > 0 Тогда
			
			ТекущийОбъект.ПоследняяДатаЗамера = ЗамерыВыездыВременная[0].ДатаЗамера;
			ТекущийОбъект.ПоследнееВремяНачалаЗамера = ЗамерыВыездыВременная[0].ВремяНачалаЗамера;
			ТекущийОбъект.ПоследнееВремяОкончанияЗамера = ЗамерыВыездыВременная[0].ВремяОкончанияЗамера;
			
		КонецЕсли;
		//-- №14649
		
		//++ №14913 перенесено из ПередЗаписью
		Если ТекущийОбъект.Замеры.Количество() > 0 Тогда
			
			НомерЗамера = ТекущийОбъект.Замеры.Количество()-1;
			
			ТекущийОбъект.ПоследнийИсполнительЗамера = ТекущийОбъект.Замеры[НомерЗамера].ИсполнительЗамера;
			ТекущийОбъект.ПоследнийРезультатЗамера = ТекущийОбъект.Замеры[НомерЗамера].РезультатЗамера;
			ТекущийОбъект.ПоследняяСуммаДоговораНаЗамере = ТекущийОбъект.Замеры[НомерЗамера].СуммаДоговораНаЗамере;
			ТекущийОбъект.ПоследняяСуммаАвансаНаЗамере = ТекущийОбъект.Замеры[НомерЗамера].СуммаАвансаНаЗамере;
			ТекущийОбъект.ПоследнееЗамерВыполнен = ТекущийОбъект.Замеры[НомерЗамера].ЗамерВыполнен;
			ТекущийОбъект.ПоследнийНазначилЗамер = ТекущийОбъект.Замеры[НомерЗамера].НазначилЗамер;
			ТекущийОбъект.ПоследнийДатаНазначилиЗамер = ТекущийОбъект.Замеры[НомерЗамера].ДатаНазначенияЗамера;
			ТекущийОбъект.ПоследнийКомментарийЗамерщика = ТекущийОбъект.Замеры[НомерЗамера].КомментарийЗамерщика;
			
		КонецЕсли;
		
		Если ТекущийОбъект.ТекущийСтатус = ПредопределенноеЗначение("Справочник.СтатусыЛида.ОтложенныйНазначитьЗамер") Тогда
			Если НЕ ТекущийОбъект.ПоследняяДатаЗамера = Дата(1,1,1) 
				И НЕ ТекущийОбъект.ПоследнийИсполнительЗамера.Пустая() 
				И ТекущийОбъект.ПоследнийРезультатЗамера = ПредопределенноеЗначение("Справочник.РезультатЗамераЛида.ПустаяСсылка")
				И (ТекущийОбъект.Замеры.Количество() - КоличествоОтмененныхЗамеров) > 0
				Тогда
				//для лида в статусе "ОтложенныйНазначитьЗамер" добавили замер в график, нужно лид перевести в следующий статус
				ТекущийОбъект.ТекущийСтатус = ПредопределенноеЗначение("Справочник.СтатусыЛида.ЗаполнитьДанныеЗамера");
			КонецЕсли;
		КонецЕсли; 
		
		Если НЕ ТекущийОбъект.ПоследнееЗамерВыполнен 
			И НЕ ТекущийОбъект.ПоследнийРезультатЗамера = ПредопределенноеЗначение("Справочник.РезультатЗамераЛида.ЗамерНеПроизводился") 
			И НЕ ТекущийОбъект.ПоследнийРезультатЗамера = ПредопределенноеЗначение("Справочник.РезультатЗамераЛида.ЗамерОтменен") //#11759
			И (ТекущийОбъект.Замеры.Количество() - КоличествоОтмененныхЗамеров) > 0
			И НЕ ТекущийОбъект.ТекущийСтатус = ПредопределенноеЗначение("Справочник.СтатусыЛида.ОтложенныйНазначитьЗамер")
			Тогда
			ТекущийОбъект.ТекущийСтатус = ПредопределенноеЗначение("Справочник.СтатусыЛида.ЗаполнитьДанныеЗамера");
		КонецЕсли;
		//-- №14913 перенесено из ПередЗаписью
		
	Иначе
		
		//++ №14913 перенесено из ПередЗаписью
		Для Каждого ТекущаяСтрока Из ТекущийОбъект.Замеры Цикл
			
			Если НЕ ЗначениеЗаполнено(ТекущаяСтрока.РезультатЗамера) Тогда
				
				ДобавитьЗаписьВИсториюСервер(СтрШаблон("Автоматически отменен замер Дата: %1 %2. Исполнитель: %3", Формат(ТекущаяСтрока.ДатаЗамера, "ДЛФ=Д"), Формат(ТекущаяСтрока.ВремяНачалаЗамера, "ДЛФ=В"), ТекущаяСтрока.ИсполнительЗамера));
				ТекущаяСтрока.РезультатЗамера = ПредопределенноеЗначение("Справочник.РезультатЗамераЛида.ЗамерОтменен");
				
			КонецЕсли;
			
		КонецЦикла;
		
		//++ №14649 Отменяем выезды без результата
		Для Каждого ТекущаяСтрока Из ТекущийОбъект.Выезды Цикл
			
			Если НЕ ЗначениеЗаполнено(ТекущаяСтрока.Результат) Тогда				
				
				ДобавитьЗаписьВИсториюСервер(СтрШаблон("Автоматически отменен выезд Дата: %1 %2. Исполнитель: %3", Формат(ТекущаяСтрока.Дата, "ДЛФ=Д"), Формат(ТекущаяСтрока.ВремяНачала, "ДЛФ=В"), ТекущаяСтрока.Исполнитель));
				ТекущаяСтрока.Результат = ПредопределенноеЗначение("Справочник.РезультатыВыездаЛида.ВыездОтменен");
				
			КонецЕсли;
			
		КонецЦикла;
		//-- №14649
		//-- №14913 перенесено из ПередЗаписью
		
	КонецЕсли;
	
	Если ПараметрыСеанса.НеДоступенПереводЛидаВНеЦелевой и Объект.ТекущийСтатус = Справочники.СтатусыЛида.НеЦелевой Тогда
		Отказ = Истина;
		Сообщить("Вам не доступен перевод лида в статус ""Не целевой""");
	ИначеЕсли ПараметрыСеанса.НеДоступенПереводЛидаВОтказ и Объект.ТекущийСтатус = Справочники.СтатусыЛида.Отказ Тогда
		Отказ = Истина;
		Сообщить("Вам не доступен перевод лида в статус ""Отказ""");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	Оповестить("Запись_Лид", ПараметрыЗаписи, Объект.Ссылка);
	
	Если НазначенЗамер 
		И ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
		
		// #12209 перенесено в общий модуль, так как не формируется смс при изменении через График замеров
		РаботаССМСКлиент.ПослеЗаписиЛида(Объект.Ссылка);
		
		НазначенЗамер = Ложь;
	КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(ИсторияДокумента, "Лид", Объект.Ссылка, , , Истина, РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный);
	Элементы.ИсторияДокумента.Обновить();

	Выработка.Параметры.УстановитьЗначениеПараметра("ОбъектВыработки", Объект.Ссылка); // для новых документов ссылка могла быть пустой
	Элементы.Выработка.Обновить();
	
	ОбновитьЭлементыФормыНаСервере();
	
	// если ПередЗаписью в модуле были удалены отдельные пустые записи
	Если Объект.Замеры.Количество() + Объект.Выезды.Количество() > 0 Тогда
		
		//++ №9853 добавляем позиционирование на текущем замере / выезде
		мТекущийЗамерВыезд = СоответствиеЗамеровВыездов.Получить(ТекущийЗамерВыезд);
		Если НЕ мТекущийЗамерВыезд = Неопределено Тогда
			ЗаполнитьВыборДанныхЗамераВыезда(мТекущийЗамерВыезд.ИД, мТекущийЗамерВыезд.ЗамерВыезд);
		Иначе
		//-- №9853
			ЗаполнитьВыборДанныхЗамераВыезда();
		КонецЕсли;
		
		ТекущийЗамерВыездПриИзменении(Неопределено);
		
	КонецЕсли;
	
	Если ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
		Если ИспользуетсяМобильныйКлиентЗамерщика() Тогда
			ОтправитьПУШУведомленияНаСервере();
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ИспользуетсяМобильныйКлиентЗамерщика()
	Возврат Константы.ИспользуетсяМобильныйКлиентЗамерщика.Получить();
КонецФункции

&НаСервере
Процедура ОтправитьПУШУведомленияНаСервере()
	
	МассивДанных = Новый Массив;
	СтруктураДанных = Новый Структура;
	СтруктураДанных.Вставить("Текст","");
	СтруктураДанных.Вставить("Исполнитель","");
	СтруктураДанных.Вставить("Заголовок","");
	
	//ЗАМЕРЫ /////////////////////////////////////////////////////
	
	//сначала смотрим какие замеры были до записи документа
	Для Каждого ИсходнаяСтрока Из ЗамерыДоИзменения Цикл
		Отбор = Новый Структура("ИДЗамера", ИсходнаяСтрока.ИДЗамера);
		НайденныеСтроки = Объект.Замеры.НайтиСтроки(Отбор);
		Если НайденныеСтроки.Количество() = 0 Тогда
			//теперь такого замера нет
			СтруктураДанных = Новый Структура;
			СтруктураДанных.Вставить("Текст", "Адрес: " + Объект.Адрес);
			СтруктураДанных.Вставить("Исполнитель",ИсходнаяСтрока.Исполнитель);
			СтруктураДанных.Вставить("Заголовок","Замер отменен");
			МассивДанных.Добавить(СтруктураДанных);
		Иначе
			Если НЕ ИсходнаяСтрока.Исполнитель = НайденныеСтроки[0].ИсполнительЗамера Тогда
				//у старого исполнителя замер отменен
				СтруктураДанных = Новый Структура;
				СтруктураДанных.Вставить("Текст", "Адрес: " + Объект.Адрес);
				СтруктураДанных.Вставить("Исполнитель",ИсходнаяСтрока.Исполнитель);
				СтруктураДанных.Вставить("Заголовок","Замер отменен");
				МассивДанных.Добавить(СтруктураДанных);
				//у нового исполнителя замер добавлен
				СтруктураДанных = Новый Структура;
				СтруктураДанных.Вставить("Текст","Дата: " + Формат(НайденныеСтроки[0].ДатаЗамера,"ДФ=dd.MM.yyyy") + " г. " + Формат(НайденныеСтроки[0].ВремяНачалаЗамера,"ДФ=ЧЧ:мм") + "-" + Формат(НайденныеСтроки[0].ВремяОкончанияЗамера,"ДФ=ЧЧ:мм") + " Адрес: " + Объект.Адрес);
				СтруктураДанных.Вставить("Исполнитель",НайденныеСтроки[0].ИсполнительЗамера);
				СтруктураДанных.Вставить("Заголовок","Назначен новый замер");
				МассивДанных.Добавить(СтруктураДанных);
			Иначе
				Если ИсходнаяСтрока.Дата = НайденныеСтроки[0].ДатаЗамера
					И ИсходнаяСтрока.ВремяНачала = НайденныеСтроки[0].ВремяНачалаЗамера Тогда
					//ничего не поменялось
				Иначе
					//изменилась дата\время
					СтруктураДанных = Новый Структура;
					СтруктураДанных.Вставить("Текст","Новая дата: " + Формат(НайденныеСтроки[0].ДатаЗамера,"ДФ=dd.MM.yyyy") + " г. " + Формат(НайденныеСтроки[0].ВремяНачалаЗамера,"ДФ=ЧЧ:мм") + "-" + Формат(НайденныеСтроки[0].ВремяОкончанияЗамера,"ДФ=ЧЧ:мм") + " Адрес: " + Объект.Адрес);
					СтруктураДанных.Вставить("Исполнитель",ИсходнаяСтрока.Исполнитель);
					СтруктураДанных.Вставить("Заголовок","Замер перенесен");
					МассивДанных.Добавить(СтруктураДанных);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	//теперь проверяем по новым замерам, которых не было
	Для Каждого НоваяСтрока Из Объект.Замеры Цикл
		Отбор = Новый Структура("ИДЗамера", НоваяСтрока.ИДЗамера);
		НайденныеСтроки = ЗамерыДоИзменения.НайтиСтроки(Отбор);
		Если НайденныеСтроки.Количество() = 0 Тогда
			//добавлен новый замер
			СтруктураДанных = Новый Структура;
			СтруктураДанных.Вставить("Текст","Дата: " + Формат(НоваяСтрока.ДатаЗамера,"ДФ=dd.MM.yyyy") + " г. " + Формат(НоваяСтрока.ВремяНачалаЗамера,"ДФ=ЧЧ:мм") + "-" + Формат(НоваяСтрока.ВремяОкончанияЗамера,"ДФ=ЧЧ:мм") + " Адрес: " + Объект.Адрес);
			СтруктураДанных.Вставить("Исполнитель",НоваяСтрока.ИсполнительЗамера);
			СтруктураДанных.Вставить("Заголовок","Назначен новый замер");
			МассивДанных.Добавить(СтруктураДанных);
		КонецЕсли;
	КонецЦикла;
	
	//ВЫЕЗДЫ /////////////////////////////////////////////////////
	
	//сначала смотрим какие выезды были до записи документа
	Для Каждого ИсходнаяСтрока Из ВыездыДоИзменения Цикл
		Отбор = Новый Структура("ИДЗамера", ИсходнаяСтрока.ИДЗамера);
		НайденныеСтроки = Объект.Выезды.НайтиСтроки(Отбор);
		Если НайденныеСтроки.Количество() = 0 Тогда
			//теперь такого выезда нет
			СтруктураДанных = Новый Структура;
			СтруктураДанных.Вставить("Текст", "Адрес: " + Объект.Адрес);
			СтруктураДанных.Вставить("Исполнитель",ИсходнаяСтрока.Исполнитель);
			СтруктураДанных.Вставить("Заголовок","Выезд отменен");
			МассивДанных.Добавить(СтруктураДанных);
		Иначе
			Если НЕ ИсходнаяСтрока.Исполнитель = НайденныеСтроки[0].Исполнитель Тогда
				//у старого исполнителя выезд отменен
				СтруктураДанных = Новый Структура;
				СтруктураДанных.Вставить("Текст", "Адрес: " + Объект.Адрес);
				СтруктураДанных.Вставить("Исполнитель",ИсходнаяСтрока.Исполнитель);
				СтруктураДанных.Вставить("Заголовок","Выезд отменен");
				МассивДанных.Добавить(СтруктураДанных);
				//у нового исполнителя выезд добавлен
				СтруктураДанных = Новый Структура;
				СтруктураДанных.Вставить("Текст","Дата: " + Формат(НайденныеСтроки[0].Дата,"ДФ=dd.MM.yyyy") + " г. " + Формат(НайденныеСтроки[0].ВремяНачала,"ДФ=ЧЧ:мм") + "-" + Формат(НайденныеСтроки[0].ВремяОкончания,"ДФ=ЧЧ:мм") + " Адрес: " + Объект.Адрес);
				СтруктураДанных.Вставить("Исполнитель",НайденныеСтроки[0].Исполнитель);
				СтруктураДанных.Вставить("Заголовок","Назначен новый выезд");
				МассивДанных.Добавить(СтруктураДанных);
			Иначе
				Если ИсходнаяСтрока.Дата = НайденныеСтроки[0].Дата
					И ИсходнаяСтрока.ВремяНачала = НайденныеСтроки[0].ВремяНачала Тогда
					//ничего не поменялось
				Иначе
					//изменилась дата\время
					СтруктураДанных = Новый Структура;
					СтруктураДанных.Вставить("Текст","Новая дата: " + Формат(НайденныеСтроки[0].Дата,"ДФ=dd.MM.yyyy") + " г. " + Формат(НайденныеСтроки[0].ВремяНачала,"ДФ=ЧЧ:мм") + "-" + Формат(НайденныеСтроки[0].ВремяОкончания,"ДФ=ЧЧ:мм") + " Адрес: " + Объект.Адрес);
					СтруктураДанных.Вставить("Исполнитель",ИсходнаяСтрока.Исполнитель);
					СтруктураДанных.Вставить("Заголовок","Выезд перенесен");
					МассивДанных.Добавить(СтруктураДанных);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	//теперь проверяем по новым выездам, которых не было
	Для Каждого НоваяСтрока Из Объект.Выезды Цикл
		Отбор = Новый Структура("ИДЗамера", НоваяСтрока.ИДЗамера);
		НайденныеСтроки = ВыездыДоИзменения.НайтиСтроки(Отбор);
		Если НайденныеСтроки.Количество() = 0 Тогда
			//добавлен новый замер
			СтруктураДанных = Новый Структура;
			СтруктураДанных.Вставить("Текст","Дата: " + Формат(НоваяСтрока.Дата,"ДФ=dd.MM.yyyy") + " г. " + Формат(НоваяСтрока.ВремяНачала,"ДФ=ЧЧ:мм") + "-" + Формат(НоваяСтрока.ВремяОкончания,"ДФ=ЧЧ:мм") + " Адрес: " + Объект.Адрес);
			СтруктураДанных.Вставить("Исполнитель",НоваяСтрока.Исполнитель);
			СтруктураДанных.Вставить("Заголовок","Назначен новый выезд");
			МассивДанных.Добавить(СтруктураДанных);
		КонецЕсли;
	КонецЦикла;

	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = НСтр("ru = 'Отправка PUSH уведомлений замерщикам'");
	Результат = ДлительныеОперации.ВыполнитьВФоне("МобильныйКлиент.ОтправитьPUSHУведомлениеОбИзмененияхЗамеров", МассивДанных, ПараметрыВыполнения);
		
КонецПроцедуры

