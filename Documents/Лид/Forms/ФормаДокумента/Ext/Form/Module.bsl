Процедура ОбновитьСписокПредварительныхРасчетов()
	
	ПредварительныеРасчеты.Очистить();
	
	Запрос = новый Запрос;
	Запрос.Текст =
	//++ №14089 комментируем
	////++ #14052 на случай если ПР отвязан от основного предварительного расчета
	//"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	//|	ПредварительныйРасчет.Дата КАК Дата,
	//|	ПредварительныйРасчет.Ссылка КАК Ссылка,
	//|	ПредварительныйРасчет.СуммаДокумента КАК Сумма,
	//|	ПредварительныйРасчет.Валюта КАК Валюта,
	//|	ВЫРАЗИТЬ(ПредварительныйРасчет.Комментарий КАК СТРОКА(1000)) КАК Комментарий,
	//|	ВЫБОР
	//|		КОГДА ПредварительныйРасчет.Основание = &Лид
	//|			ТОГДА ЛОЖЬ
	//|		ИНАЧЕ ИСТИНА
	//|	КОНЕЦ КАК ЕстьОшибкаПоОснованиюПР
	//|ПОМЕСТИТЬ ВТ
	//|ИЗ
	//|	Документ.ПредварительныйРасчетЗаказДоговора КАК ПредварительныйРасчет
	//|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Лид КАК ДокументЛид
	//|		ПО (ДокументЛид.ОсновнойПредварительныйРасчет = ПредварительныйРасчет.Ссылка)
	//|			И (ДокументЛид.Ссылка = &Лид)
	//|
	//|ОБЪЕДИНИТЬ
	////-- #14052
	//-- №14089 комментируем
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ПредварительныйРасчет.Дата КАК Дата,
	|	ПредварительныйРасчет.Ссылка КАК Ссылка,
	|	ПредварительныйРасчет.СуммаДокумента КАК Сумма,
	|	ПредварительныйРасчет.Валюта КАК Валюта,
	|	ВЫРАЗИТЬ(ПредварительныйРасчет.Комментарий КАК СТРОКА(1000)) КАК Комментарий,
	|	ЛОЖЬ КАК ЕстьОшибкаПоОснованиюПР
	|ПОМЕСТИТЬ ВТ
	|ИЗ
	|	Документ.ПредварительныйРасчетЗаказДоговора КАК ПредварительныйРасчет
	|ГДЕ
	|	ПредварительныйРасчет.Основание = &Лид
	|	И НЕ &Лид = ЗНАЧЕНИЕ(Документ.Лид.ПустаяСсылка)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВТ.Дата КАК Дата,
	|	ВТ.Ссылка КАК Ссылка,
	|	ВТ.Сумма КАК Сумма,
	|	ВТ.Валюта КАК Валюта,
	|	ВТ.Комментарий КАК Комментарий,
	|	ВТ.ЕстьОшибкаПоОснованиюПР КАК ЕстьОшибкаПоОснованиюПР
	|ИЗ
	|	ВТ КАК ВТ
	|
	|УПОРЯДОЧИТЬ ПО
	|	ВТ.Дата";
	
	Запрос.УстановитьПараметр("Лид", Объект.Ссылка);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		НоваяСтрока = ПредварительныеРасчеты.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		
		Если Объект.ОсновнойПредварительныйРасчет = Выборка.Ссылка Тогда
			НоваяСтрока.Основной = Истина;
		КонецЕсли;
		
	КонецЦикла;
	
	// данные заголовка
	Если ПредварительныеРасчеты.Количество() > 0 Тогда
		ПредварительныеРасчеты[0].КоличествоСтрок = ПредварительныеРасчеты.Количество();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПредварительныеРасчетыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТекущиеДанные = Элементы.ПредварительныеРасчеты.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ОткрытьФорму("Документ.ПредварительныйРасчетЗаказДоговора.ФормаОбъекта", новый Структура("Ключ", ТекущиеДанные.Ссылка));
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьНазначитьНовыйПредварительныйРасчетОсновным()
	
	ОбновитьСписокПредварительныхРасчетов();
	
	Если ПредварительныеРасчеты.Количество() = 1 И Объект.ОсновнойПредварительныйРасчет.Пустая() Тогда
		
		Объект.ОсновнойПредварительныйРасчет = ПредварительныеРасчеты[0].Ссылка;
		ПредварительныеРасчеты[0].Основной = Истина;
		Модифицированность = Истина;
		
	КонецЕсли;
	
КонецПроцедуры
//-- №10184

&НаКлиенте
Процедура ДобавитьПредварительныйРасчет(Команда)
	
	//#14050	
	Если Модифицированность ИЛИ НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда		
		ОписаниеОповещения = Новый ОписаниеОповещения("ДобавитьПредварительныйРасчетФрагмент", ЭтотОбъект);
		ТекстВопроса = "Для продолжения документ следует записать. 
						|Записать документ?";
		ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
		Возврат;
	КонецЕсли;
		
	ДобавитьПредварительныйРасчетЗавершение(Неопределено, Неопределено);
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьПредварительныйРасчетФрагмент(Результат, ДопПараметры) Экспорт
	
	Если НЕ Результат = КодВозвратаДиалога.Да Тогда
		Возврат;	
	КонецЕсли;
	
	ДействиеПослеЗаписи = Новый ОписаниеОповещения("ДобавитьПредварительныйРасчетЗавершение", ЭтотОбъект);
	
	ПараметрыЗаписи = Новый Структура;
	ПараметрыЗаписи.Вставить("РежимЗаписи", РежимЗаписиДокумента.Запись);
	
	ОчиститьСообщения();
	Результат = Записать(ПараметрыЗаписи);
	
	Если Результат Тогда
		ВыполнитьОбработкуОповещения(ДействиеПослеЗаписи, Результат);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьПредварительныйРасчетЗавершение(Результат, ДопПараметры) Экспорт
	
	ПараметрыНовогоДокумента = Новый Структура;
	ПараметрыНовогоДокумента.Вставить("Основание", Объект.Ссылка);
	
	ОткрытьФорму("Документ.ПредварительныйРасчетЗаказДоговора.ФормаОбъекта", ПараметрыНовогоДокумента);
	
КонецПроцедуры

&НаКлиенте
Процедура СкопироватьПредварительныйРасчет(Команда)
	
	ТекущиеДанные = Элементы.ПредварительныеРасчеты.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;	
	КонецЕсли;
	
	ДокументДляКопирования = ТекущиеДанные.Ссылка;
    ПараметрыФормы = Новый Структура("ЗначениеКопирования", ДокументДляКопирования);
    ОткрытьФорму("Документ.ПредварительныйРасчетЗаказДоговора.ФормаОбъекта", ПараметрыФормы, ЭтаФорма);
	
КонецПроцедуры

#КонецОбласти

#Область ВкладкаИсторияОбращений

&НаСервере
Процедура ПолучитьИсториюОбращенияКлиента()
	
	//ИсторияОбращений.Очистить();
	ИсторияОбращенияОтчет.Очистить();
	Элементы.ГруппаИстория.Заголовок = "История обращений";
	
	МассивТелефонов    = УправлениеКонтактнойИнформациейПотолки.ПолучитьТелефонИзКонтактнойИнформацииФормы(ЭтотОбъект, Ложь);	
	МассивАдресовПочты = УправлениеКонтактнойИнформациейПотолки.ПолучитьАдресПочтыИзКонтактнойИнформацииФормы(ЭтотОбъект, Ложь);
	
	Если МассивТелефонов.Количество() = 0 
		И МассивАдресовПочты.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
		
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТелефоныКлиента",  			МассивТелефонов);		
	Запрос.УстановитьПараметр("ЭлектронныеАдресаКлиента",	МассивАдресовПочты);
	Запрос.УстановитьПараметр("ПоискПоТелефону",    		ПравилоПоискаИсторииОбращений.ПоТелефону);		
	Запрос.УстановитьПараметр("ПоискПоПочте", 				ПравилоПоискаИсторииОбращений.ПоАдресуЭлектроннойПочты);
		
	Запрос.УстановитьПараметр("Ссылка", Объект.Ссылка);
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЗаказДоговор.Ссылка КАК ОснованиеСсылка,
	|	ЗаказДоговор.Дата КАК ОснованиеДата,
	|	ЗаказДоговор.ТекущийСтатус КАК ОснованиеСтатус,
	|	ЗаказДоговор.Основание КАК ЛидСсылка
	|ПОМЕСТИТЬ ВТ_ЗаказыМонтажиПоЛидам
	|ИЗ
	|	Документ.ЗаказДоговор КАК ЗаказДоговор
	|ГДЕ
	|	ЗаказДоговор.Основание ССЫЛКА Документ.Лид
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Монтаж.Ссылка,
	|	Монтаж.Дата,
	|	Монтаж.Результат,
	|	Монтаж.Основание
	|ИЗ
	|	Документ.Монтаж КАК Монтаж
	|ГДЕ
	|	Монтаж.Основание ССЫЛКА Документ.Лид
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Монтаж.Ссылка КАК МонтажСсылка,
	|	Монтаж.Результат КАК МонтажРезультат,
	|	Монтаж.Основание КАК ЗаказСсылка
	|ПОМЕСТИТЬ ВТ_МонтажиПоЗаказам
	|ИЗ
	|	Документ.Монтаж КАК Монтаж
	|ГДЕ
	|	Монтаж.Основание ССЫЛКА Документ.ЗаказДоговор
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Лид.Ссылка КАК Ссылка,
	|	Лид.Дата КАК Дата,
	|	Лид.ПометкаУдаления КАК ПометкаУдаления,
	|	Лид.Проведен КАК Проведен,
	|	ВЫРАЗИТЬ(Лид.ИмяКлиента КАК СТРОКА(500)) КАК ИмяКлиента,
	|	Лид.ТекущийСтатус КАК ТекущийСтатус,
	|	Лид.Телефоны КАК Телефоны,
	|	Лид.АдресаЭлектроннойПочты КАК АдресаЭлектроннойПочты,
	|	ВЫБОР КОГДА Лид.Ссылка = &Ссылка ТОГДА ИСТИНА ИНАЧЕ ЛОЖЬ КОНЕЦ КАК Текущий
	|ПОМЕСТИТЬ ВТ_Лиды
	|ИЗ
	|	Документ.Лид КАК Лид
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Лид.ДополнительнаяКонтактнаяИнформация КАК ЛидКИ
	|	ПО ЛидКИ.Ссылка = Лид.Ссылка
	|ГДЕ
	|	(ВЫБОР
	|				КОГДА &ПоискПоТелефону
	|					ТОГДА ЛидКИ.Представление В (&ТелефоныКлиента)
	|						И ЛидКИ.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Телефон)
	|				ИНАЧЕ ЛОЖЬ
	|			КОНЕЦ
	|			ИЛИ ВЫБОР
	|				КОГДА &ПоискПоПочте
	|					ТОГДА ЛидКИ.Представление В (&ЭлектронныеАдресаКлиента)
	|						И ЛидКИ.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.АдресЭлектроннойПочты)
	|				ИНАЧЕ ЛОЖЬ
	|			КОНЕЦ)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Лид.Ссылка КАК Ссылка,
	|	Лид.Дата КАК Дата,
	|	Лид.ПометкаУдаления КАК ПометкаУдаления,
	|	Лид.Проведен КАК Проведен,
	|	Лид.ИмяКлиента КАК ИмяКлиента,
	|	Лид.Телефоны КАК Телефоны,
	|	Лид.АдресаЭлектроннойПочты КАК АдресаЭлектроннойПочты,
	|	Лид.ТекущийСтатус КАК ТекущийСтатус,
	|	Лид.Текущий КАК Текущий,
	|	ЕСТЬNULL(ВТ_ЗаказыМонтажиПоЛидам.ОснованиеСсылка, НЕОПРЕДЕЛЕНО) КАК Основание,
	|	ЕСТЬNULL(ВТ_ЗаказыМонтажиПоЛидам.ОснованиеСтатус, НЕОПРЕДЕЛЕНО) КАК ОснованиеСтатус,
	|	ЕСТЬNULL(ВТ_МонтажиПоЗаказам.МонтажСсылка, НЕОПРЕДЕЛЕНО) КАК МонтажПоЗаказу,
	|	ЕСТЬNULL(ВТ_МонтажиПоЗаказам.МонтажРезультат, НЕОПРЕДЕЛЕНО) КАК РезультатМонтажаПоЗаказу
	|ИЗ
	|	ВТ_Лиды КАК Лид
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ЗаказыМонтажиПоЛидам КАК ВТ_ЗаказыМонтажиПоЛидам
	|		ПО Лид.Ссылка = ВТ_ЗаказыМонтажиПоЛидам.ЛидСсылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_МонтажиПоЗаказам КАК ВТ_МонтажиПоЗаказам
	|		ПО (ВТ_ЗаказыМонтажиПоЛидам.ОснованиеСсылка = ВТ_МонтажиПоЗаказам.ЗаказСсылка)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Ссылка,
	|	Дата
	|ИТОГИ
	|	МАКСИМУМ(Дата),
	|	МАКСИМУМ(ПометкаУдаления),
	|	МАКСИМУМ(Проведен),
	|	МАКСИМУМ(ИмяКлиента),
	|	МАКСИМУМ(Телефоны),
	|	МАКСИМУМ(АдресаЭлектроннойПочты),
	|	МАКСИМУМ(ТекущийСтатус),
	|	МАКСИМУМ(Текущий),
	|	МАКСИМУМ(ОснованиеСтатус)
	|ПО
	|	Ссылка,
	|	Основание
	|АВТОУПОРЯДОЧИВАНИЕ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ИсторияЛида.Лид КАК Лид,
	|	ИсторияЛида.Дата КАК Дата,
	|	ИсторияЛида.Пользователь КАК Пользователь,
	|	ИсторияЛида.Комментарий КАК Комментарий
	|ИЗ
	|	РегистрСведений.ИсторияЛида КАК ИсторияЛида
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_Лиды КАК ВТ_Лиды
	|		ПО (ВТ_Лиды.Ссылка = ИсторияЛида.Лид)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата";	
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	Макет = Документы.Лид.ПолучитьМакет("ИсторияОбращения");
	
	ОбластьЗаголовок = Макет.ПолучитьОбласть("Заголовок|Данные");
	ОбластьДругойЛид = Макет.ПолучитьОбласть("СтрокаЛида|Данные");	
	ОбластьТекущийЛид = Макет.ПолучитьОбласть("СтрокаТекущегоЛида|Данные");
	ОбластьИсторияЛида = Макет.ПолучитьОбласть("СтрокаИсторииЛида|Данные");
	ОбластьИсторияТекущегоЛида = Макет.ПолучитьОбласть("СтрокаИсторииТекущегоЛида|Данные");
	ОбластьПустаяЯчейка = Макет.ПолучитьОбласть("ПустаяЯчейка");
	ОбластьДокументЗаписан = Макет.ПолучитьОбласть("ДокументЗаписан");
	ОбластьДокументПомеченНаУдаление = Макет.ПолучитьОбласть("ДокументПомеченНаУдаление");
	ОбластьДокументПроведен = Макет.ПолучитьОбласть("ДокументПроведен");
	//ОбластьУровень2 = Макет.ПолучитьОбласть("Уровень2");
	ОбластьПустая = Макет.ПолучитьОбласть("ПустаяСтрока|Данные");
	ОбластьОснования = Макет.ПолучитьОбласть("СтрокаОснования|Данные");
	ОбластьОснования2 = Макет.ПолучитьОбласть("СтрокаОснования2|Данные");
	
	ВыборкаЛидов = РезультатЗапроса[3].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	ТЗ_ИсторияЛидов = РезультатЗапроса[4].Выгрузить();
	КоличествоОбращений = 0;
	
	ИсторияОбращенияОтчет.Вывести(ОбластьПустаяЯчейка);
	ИсторияОбращенияОтчет.Присоединить(ОбластьЗаголовок);

	Пока ВыборкаЛидов.Следующий() Цикл		
		КоличествоОбращений = КоличествоОбращений + 1;
		
		ОбластьСтатус = ?(ВыборкаЛидов.ПометкаУдаления, ОбластьДокументПомеченНаУдаление, ?(ВыборкаЛидов.Проведен, ОбластьДокументПроведен, ОбластьДокументЗаписан));
		ИсторияОбращенияОтчет.Вывести(ОбластьСтатус);
		
		ОбластьЛид = ?(ВыборкаЛидов.Текущий, ОбластьТекущийЛид, ОбластьДругойЛид);
		ОбластьИстория = ?(ВыборкаЛидов.Текущий, ОбластьИсторияТекущегоЛида, ОбластьИсторияЛида);
		
		ОбластьЛид.Параметры.Дата 			= ВыборкаЛидов.Дата;
		ПредставлениеЛида = ?(ПустаяСтрока(ВыборкаЛидов.ИмяКлиента), "", ВыборкаЛидов.ИмяКлиента); 
		ПредставлениеЛида = ПредставлениеЛида + ?(ПустаяСтрока(ВыборкаЛидов.Телефоны), "", ?(ПустаяСтрока(ПредставлениеЛида), ВыборкаЛидов.Телефоны, ", " + ВыборкаЛидов.Телефоны));
		ПредставлениеЛида = ПредставлениеЛида + ?(ПустаяСтрока(ВыборкаЛидов.АдресаЭлектроннойПочты), "", ?(ПустаяСтрока(ПредставлениеЛида), ВыборкаЛидов.АдресаЭлектроннойПочты, ", " + ВыборкаЛидов.АдресаЭлектроннойПочты));
		ПредставлениеЛида = ПредставлениеЛида + ?(ПустаяСтрока(ПредставлениеЛида), ВыборкаЛидов.ТекущийСтатус, ", " + ВыборкаЛидов.ТекущийСтатус);
		Если НЕ ПустаяСтрока(ПредставлениеЛида) Тогда
			ПредставлениеЛида = " (" + ПредставлениеЛида + ")";	
		КонецЕсли;
		ОбластьЛид.Параметры.Представление 	= Строка(ВыборкаЛидов.Ссылка) + ПредставлениеЛида;
		ОбластьЛид.Параметры.Документ 		= ВыборкаЛидов.Ссылка;
		ИсторияОбращенияОтчет.Присоединить(ОбластьЛид);
		
		НайденнаяИстория = ТЗ_ИсторияЛидов.НайтиСтроки(Новый Структура("Лид", ВыборкаЛидов.Ссылка));
		Для каждого СтрокаТЗ из НайденнаяИстория Цикл
			ИсторияОбращенияОтчет.Вывести(ОбластьПустаяЯчейка);
			ОбластьИстория.Параметры.Заполнить(СтрокаТЗ);
			ИсторияОбращенияОтчет.Присоединить(ОбластьИстория);
		КонецЦикла;
		
		ВыборкаОснований = ВыборкаЛидов.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам); 
		Пока ВыборкаОснований.Следующий() Цикл
			Если ВыборкаОснований.Основание = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			// заказы/монтажи в прямом подчинении
			РеквизитыОснования = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ВыборкаОснований.Основание, "Дата, ПометкаУдаления, Проведен");
			ОбластьСтатус = ?(РеквизитыОснования.ПометкаУдаления, ОбластьДокументПомеченНаУдаление, ?(РеквизитыОснования.Проведен, ОбластьДокументПроведен, ОбластьДокументЗаписан));
			ИсторияОбращенияОтчет.Вывести(ОбластьСтатус);
			
			ОбластьОснования.Параметры.Дата 			= РеквизитыОснования.Дата;
			
			ПредставлениеОснования = "";
			Если ТипЗнч(ВыборкаОснований.Основание) = Тип("ДокументСсылка.Монтаж") Тогда
				МонтажСсылка = ВыборкаОснований.Основание;
				Если МонтажСсылка.СрокМонтажа = Перечисления.СрокиМонтажа.МонтажНаНесколькоДней Тогда
					
					Если МонтажСсылка.ГрафикМонтажей.Количество() > 0 Тогда
						ПредставлениеОснования = " Дата начала монтажа: " + Формат(МонтажСсылка.ГрафикМонтажей[0].ДатаМонтажа, "ДФ='dd.MM.yyyy ''г.'''");	
					КонецЕсли;
				Иначе
					Если ЗначениеЗаполнено(МонтажСсылка.ДатаМонтажа) Тогда					
						ПредставлениеОснования = " Дата начала монтажа: " + Формат(МонтажСсылка.ДатаМонтажа, "ДФ='dd.MM.yyyy ''г.'''");
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
			
			ПредставлениеОснования = ПредставлениеОснования + " (" + Строка(ВыборкаОснований.ОснованиеСтатус) + ")";	
			
			ОбластьОснования.Параметры.Представление 	= Строка(ВыборкаОснований.Основание) + ПредставлениеОснования;
			ОбластьОснования.Параметры.Основание 		= ВыборкаОснований.Основание;
			ИсторияОбращенияОтчет.Присоединить(ОбластьОснования);			
			
			ВыборкаМонтажейПоЗаказам = ВыборкаОснований.Выбрать(); 
			Пока ВыборкаМонтажейПоЗаказам.Следующий() Цикл
				Если ВыборкаМонтажейПоЗаказам.МонтажПоЗаказу = Неопределено Тогда
					Продолжить;
				КонецЕсли;
				
				// монтажи по заказам (заказы в прямом подчинении)
				РеквизитыОснования = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ВыборкаМонтажейПоЗаказам.МонтажПоЗаказу, "Дата, ПометкаУдаления, Проведен, ДатаМонтажа, СрокМонтажа");
				ОбластьСтатус = ?(РеквизитыОснования.ПометкаУдаления, ОбластьДокументПомеченНаУдаление, ?(РеквизитыОснования.Проведен, ОбластьДокументПроведен, ОбластьДокументЗаписан));
				ИсторияОбращенияОтчет.Вывести(ОбластьСтатус);
				
				ОбластьОснования2.Параметры.Дата 			= РеквизитыОснования.Дата;
				ПредставлениеОснования = "";
				Если РеквизитыОснования.СрокМонтажа = Перечисления.СрокиМонтажа.МонтажНаНесколькоДней Тогда
					МонтажСсылка = ВыборкаМонтажейПоЗаказам.МонтажПоЗаказу;
					Если МонтажСсылка.ГрафикМонтажей.Количество() > 0 Тогда
						ПредставлениеОснования = " Дата начала монтажа: " + Формат(МонтажСсылка.ГрафикМонтажей[0].ДатаМонтажа, "ДФ='dd.MM.yyyy ''г.'''");	
					КонецЕсли;
				Иначе
					Если ЗначениеЗаполнено(РеквизитыОснования.ДатаМонтажа) Тогда					
						ПредставлениеОснования = " Дата начала монтажа: " + Формат(РеквизитыОснования.ДатаМонтажа, "ДФ='dd.MM.yyyy ''г.'''");
					КонецЕсли;
				КонецЕсли;
				ПредставлениеОснования = ПредставлениеОснования + " (" + Строка(ВыборкаМонтажейПоЗаказам.РезультатМонтажаПоЗаказу) + ")";	
				
				ОбластьОснования2.Параметры.Представление 	= Строка(ВыборкаМонтажейПоЗаказам.МонтажПоЗаказу) + ПредставлениеОснования;
				ОбластьОснования2.Параметры.Основание 		= ВыборкаМонтажейПоЗаказам.МонтажПоЗаказу;
				ИсторияОбращенияОтчет.Присоединить(ОбластьОснования2);				
			КонецЦикла;
			
		КонецЦикла;
		
		// разрыв
		ИсторияОбращенияОтчет.Вывести(ОбластьПустаяЯчейка);
		ИсторияОбращенияОтчет.Присоединить(ОбластьПустая);
		
	КонецЦикла;
	
	//ИсторияОбращений.Загрузить(Результат.Выгрузить());
	Элементы.ГруппаИстория.Заголовок = "История обращений" + ?(КоличествоОбращений > 0, " (" + Строка(КоличествоОбращений) + ")", "") ;
	
КонецПроцедуры

&НаКлиенте
Процедура ИсторияОбращенийВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТекущиеДанные = Элементы.ИсторияОбращений.ТекущиеДанные;
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Ключ", ТекущиеДанные.Ссылка);
	
	Если Поле.Имя = "ИсторияОбращенийДоговор" И ЗначениеЗаполнено(ТекущиеДанные.Договор) Тогда
		ПараметрыФормы.Вставить("Ключ", ТекущиеДанные.Договор);
		ОткрытьФорму("Документ.ЗаказДоговор.ФормаОбъекта", ПараметрыФормы);
	ИначеЕсли Поле.Имя = "ИсторияОбращенийМонтаж" И ЗначениеЗаполнено(ТекущиеДанные.Монтаж) Тогда
		ПараметрыФормы.Вставить("Ключ", ТекущиеДанные.Монтаж);
		ОткрытьФорму("Документ.Монтаж.ФормаОбъекта", ПараметрыФормы);
	Иначе
		ОткрытьФорму("Документ.Лид.Форма.ФормаДокумента", ПараметрыФормы);
	КонецЕсли;
	
КонецПроцедуры

