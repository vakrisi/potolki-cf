Процедура ДобавитьНовыйКомментарий(Команда)
	
	СтруктураИстории = Новый Структура;
	СтруктураИстории.Вставить("ИмяРеквизита", "НовыйКомментарий");

	ОбщийМодульКлиент.ДобавитьЗаписьВИсториюДокумента(ЭтаФорма, СтруктураИстории);
		
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьЗаписьВИсториюДокументаЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	ДобавитьЗаписьВИсториюКлиент(Результат.ТекстЗаписиИстории);
	НовыйКомментарий = "";
	
	// #11632 закомментировано
	//Объект.ДатаПоследнейРеакции = ТекущаяДатаСеанса();
	Объект.ПоследнийКомментарий = Результат.ТекстЗаписиИстории;
	Модифицированность = Истина;
		
КонецПроцедуры

&НаСервере
Процедура ДобавитьЗаписьВИсториюКлиент(НоваяЗаписьВИсторию)
	
	ДобавитьЗаписьВИсториюСервер(НоваяЗаписьВИсторию);
	Элементы.ИсторияДокумента.Обновить();
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьЗаписьВИсториюСервер(НоваяЗаписьВИсторию)
	
	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
		РегистрыСведений.ИсторияЛида.ДобавитьЗаписьВИсториюЛида(Объект.Ссылка, ТекущаяДатаСеанса(), Пользователи.ТекущийПользователь(), Новый УникальныйИдентификатор, НоваяЗаписьВИсторию);
	Иначе		
		// храним во временной таблице, пока документ не записали
		СтрокаЗаписи = ИсторияЛидаНаФорме.Добавить();		
		СтрокаЗаписи.Дата = ТекущаяДатаСеанса();
		СтрокаЗаписи.Пользователь = Пользователи.ТекущийПользователь();
		СтрокаЗаписи.Комментарий = НоваяЗаписьВИсторию;		
	КонецЕсли;
	
КонецПроцедуры

// вызывается ПослеЗаписиНаСервере - для переноса временных записей в регистр
&НаСервере
Процедура ЗаписатьИсториюЛидаНаФормеВРегистрСведенийНаСервере()
	
	//для каждого варианта данных измерений делаем отдельный отбор и запись, чтобы не стереть те записи, которые могли появиться в РС пока мы работали с документом
	Для Каждого ТекущаяСтрока Из ИсторияЛидаНаФорме Цикл
		РегистрыСведений.ИсторияЛида.ДобавитьЗаписьВИсториюЛида(Объект.Ссылка, ТекущаяСтрока.Дата, ТекущаяСтрока.Пользователь, Новый УникальныйИдентификатор, ТекущаяСтрока.Комментарий);
	КонецЦикла;
	
	ИсторияЛидаНаФорме.Очистить();
	
