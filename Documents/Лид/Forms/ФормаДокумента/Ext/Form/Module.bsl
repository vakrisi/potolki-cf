&НаКлиенте
Процедура ГруппаСтраницыОсновныеПриСменеСтраницы(Элемент, ТекущаяСтраница)
	
	ТекущееНазваниеСтраницы = Элементы.ГруппаСтраницыОсновные.ТекущаяСтраница.Имя;
	
	// Нужно проверить, возможно есть пустой замер или выезд
	Если мСтраница <> Неопределено И мСтраница = "ГруппаЗамерВыезд" И ТекущееНазваниеСтраницы <> "ГруппаЗамерВыезд" Тогда
		Если ПоследнийЗамерПустой() Тогда //проверяем всегда вне зависимости от ПланированиеЗамер = Истина		
			ПоказатьВопрос(Новый ОписаниеОповещения("ПослеВопросаОПродолженииНазначенияЗамера", ЭтотОбъект), "Текущий замер не назначен, продолжить назначение замера?", РежимДиалогаВопрос.ДаНет);		
			Возврат;	
		КонецЕсли;
		Если ПоследнийВыездПустой() Тогда		
			ПоказатьВопрос(Новый ОписаниеОповещения("ПослеВопросаОПродолженииНазначенияВыезда", ЭтотОбъект), "Текущий выезд не назначен, продолжить назначение выезда?", РежимДиалогаВопрос.ДаНет);		
			Возврат;	
		КонецЕсли;
	КонецЕсли;
	
	мСтраница = ТекущееНазваниеСтраницы;
	
	Если Элементы.ГруппаСтраницыОсновные.ТекущаяСтраница = Элементы.ГруппаЗамерВыезд Тогда
		УправлениеЭлементамиГруппыЗамерВыезд();
		Если ПланированиеЗамера Тогда
			Элементы.Замеры.ТекущаяСтрока = ТекущаяСтрокаЗамеров; //#6588 вернемся на нашу строку, если вдруг переключали
			Если НЕ Элементы.Замеры.ТекущиеДанные = Неопределено Тогда // №8012 добавлено условие
				ТекущийРезультатЗамера = Элементы.Замеры.ТекущиеДанные.РезультатЗамера;
			Иначе
				ТекущийРезультатЗамера = ПредопределенноеЗначение("Справочник.РезультатЗамераЛида.ПустаяСсылка");
			КонецЕсли;	
			УправлениеЭлементамиФормыПоРезультатуЗамера();
			
			ОбновитьЭлементыФормы();
			Если Объект.Замеры.Количество() > 0 Тогда  // №8012 добавлено условие
				ПолучитьПервоначальныеДанныеДляГрафикаЗамеров();
			КонецЕсли;
			ОбновитьГрафикЗамеров();
			
		ИначеЕсли ПланированиеВыезда Тогда
			УправлениеЭлементамиФормыПоРезультатуВыезда();
			
			//++ №14649
			Если НЕ Элементы.Выезды.ТекущиеДанные = Неопределено Тогда
				ТекущийРезультатВыезда = Элементы.Выезды.ТекущиеДанные.Результат;
			Иначе
				ТекущийРезультатВыезда = ПредопределенноеЗначение("Справочник.РезультатыВыездаЛида.ПустаяСсылка");
			КонецЕсли;
			//-- №14649
			
			ОбновитьЭлементыФормы();
			ПолучитьПервоначальныеДанныеДляГрафикаЗамеров();
			ОбновитьГрафикЗамеров();
		КонецЕсли;
	
	ИначеЕсли Элементы.ГруппаСтраницыОсновные.ТекущаяСтраница = Элементы.ГруппаКартыЯндекс Тогда
		ДатаКартыЯндекс = ДатаЗамера;
		ИнициализироватьКартуЯндекс();
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ПоследнийВыездПустой()
	
	КВозврату = Ложь;
	
	Если Объект.Выезды.Количество() = 0 Тогда
		Возврат КВозврату;
	КонецЕсли;
	
	ПоследнийВыезд = Объект.Выезды[Объект.Выезды.Количество()-1];
	
	Если ПоследнийВыезд.Дата = Дата(1,1,1) 
		//ИЛИ ПоследнийВыезд.Исполнитель.Пустая() //#6384 поле "Замерщик" в документе "Лид" не обязательное
		ИЛИ (ПоследнийВыезд.ВремяНачала = Дата(1,1,1) И ПоследнийВыезд.ВремяОкончания = Дата(1,1,1)) Тогда
		КВозврату = Истина;
	КонецЕсли;
	
	Возврат КВозврату;
	
КонецФункции

&НаКлиенте
Функция ПоследнийЗамерПустой()
	
	КВозврату = Ложь;
	
	Если Объект.Замеры.Количество() = 0 Тогда
		Возврат КВозврату;
	КонецЕсли;
	
	ПоследнийЗамер = Объект.Замеры[Объект.Замеры.Количество()-1];
	
	Если ПоследнийЗамер.ДатаЗамера = Дата(1,1,1) 
		//ИЛИ ПоследнийЗамер.ИсполнительЗамера.Пустая() //#6384 поле "Замерщик" в документе "Лид" не обязательное
		ИЛИ (ПоследнийЗамер.ВремяНачалаЗамера = Дата(1,1,1) И ПоследнийЗамер.ВремяОкончанияЗамера = Дата(1,1,1)) Тогда
		КВозврату = Истина;
	КонецЕсли;
	
	Возврат КВозврату;
	
КонецФункции

&НаКлиенте
Процедура ПослеВопросаОПродолженииНазначенияЗамераЗеркально(Ответ, ДопПараметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Да Тогда
		ПослеВопросаОПродолженииНазначенияЗамера(КодВозвратаДиалога.Нет, ДопПараметры);
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура ПослеВопросаОПродолженииНазначенияЗамера(Ответ, ДопПараметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Да Тогда
		
		// Оставляем на странице замера
		Элементы.ГруппаСтраницыОсновные.ТекущаяСтраница = Элементы.ГруппаЗамерВыезд;
		
	Иначе
		
		СценарийНазначенияВыезда = (ТипЗнч(ДопПараметры) = Тип("Структура") И ДопПараметры.Свойство("СценарийНазначенияВыезда")); // №14649
		
		// Удаляем последний пустой замер
		УдалитьПоследнийЗамер(СценарийНазначенияВыезда);
		
		НазначенЗамер = Ложь; // №8781 чтобы не совершал лишних действий (к примеру формирование СМС)
		
		//++ №14649
		Если СценарийНазначенияВыезда Тогда
			НазначитьВыезд(Неопределено);
		//-- №14649
		Иначе
			ОбновитьЭлементыФормы();
		КонецЕсли;
		
	КонецЕсли;
	
	мСтраница = Элементы.ГруппаСтраницыОсновные.ТекущаяСтраница.Имя;
	
КонецПроцедуры

&НаКлиенте
Процедура УдалитьПоследнийЗамер(СценарийНазначенияВыезда = Ложь)
	
	Если Объект.Замеры.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ПоследнийЗамер = Объект.Замеры[Объект.Замеры.Количество()-1];
	Объект.Замеры.Удалить(ПоследнийЗамер);
	
	Если Объект.Замеры.Количество() > 0 Тогда
		ПоследнийЗамер = Объект.Замеры[Объект.Замеры.Количество()-1];
		ТекущаяСтрокаЗамеров = ПоследнийЗамер.ПолучитьИдентификатор();
	КонецЕсли;
	
	Если НЕ СценарийНазначенияВыезда Тогда // №14649 добавлено условие
		
		ЗаполнитьВыборДанныхЗамераВыезда();
		ТекущийЗамерВыездПриИзменении(Неопределено);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВопросаОПродолженииНазначенияВыездаЗеркально(Ответ, ДопПараметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Да Тогда
		ПослеВопросаОПродолженииНазначенияВыезда(КодВозвратаДиалога.Нет, ДопПараметры);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВопросаОПродолженииНазначенияВыезда(Ответ, ДопПараметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Да Тогда
		
		// Оставляем на странице выезда
		Элементы.ГруппаСтраницыОсновные.ТекущаяСтраница = Элементы.ГруппаЗамерВыезд;
		
	Иначе
		
		СценарийНазначенияЗамера = ТипЗнч(ДопПараметры) = Тип("Структура") И ДопПараметры.Свойство("СценарийНазначенияЗамера"); //№14649
		
		// Удаляем последний пустой выезд
		УдалитьПоследнийВыезд(СценарийНазначенияЗамера);
		
		//++ №14649
		Если СценарийНазначенияЗамера Тогда
			НазначитьЗамер(Неопределено);
		//-- №14649
		Иначе
			ОбновитьЭлементыФормы();
		КонецЕсли;
		
	КонецЕсли;
	
	мСтраница = Элементы.ГруппаСтраницыОсновные.ТекущаяСтраница.Имя;
	
КонецПроцедуры

&НаКлиенте
Процедура УдалитьПоследнийВыезд(СценарийНазначенияЗамера)
	
	Если Объект.Выезды.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ПоследнийВыезд = Объект.Выезды[Объект.Выезды.Количество()-1];
	Объект.Выезды.Удалить(ПоследнийВыезд);
	Если Объект.Выезды.Количество() > 0 Тогда
		ПоследнийВыезд = Объект.Выезды[Объект.Выезды.Количество()-1];
		ТекущаяСтрокаВыездов = ПоследнийВыезд.ПолучитьИдентификатор();
	КонецЕсли;
	
	Если НЕ СценарийНазначенияЗамера Тогда // №14649 добавлено условие
		
		ЗаполнитьВыборДанныхЗамераВыезда();
		ТекущийЗамерВыездПриИзменении(Неопределено);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ЕстьНезавершенныеЗамеры()
	
	Результат = Ложь;
	
	Для Каждого ТекущаяСтрока Из Объект.Замеры Цикл
		// #10986 изменено условие 
		//Если НЕ ТекущаяСтрока.ЗамерВыполнен Тогда
		Если НЕ ЗначениеЗаполнено(ТекущаяСтрока.РезультатЗамера) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	//++ №14649 выезды также смотрим
	Для Каждого ТекущаяСтрока Из Объект.Выезды Цикл
		Если НЕ ЗначениеЗаполнено(ТекущаяСтрока.Результат) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	//-- №14649
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция ПолучитьЗамерыДляОформленияДоговора()
	
	МассивЗамеров = новый Массив;
	
	Для Каждого ТекущаяСтрока Из Объект.Замеры Цикл
		
		Если НЕ ТекущаяСтрока.ЗамерВыполнен И НЕ ТекущаяСтрока.РезультатЗамера = ПредопределенноеЗначение("Справочник.РезультатЗамераЛида.ЗаключенДоговор") Тогда
			Продолжить;
		КонецЕсли;
		
		СтруктураЗамера = Новый Структура("ДатаЗамера, ИсполнительЗамера, РезультатЗамера, ИдентификаторЗамера, ВремяНачалаЗамера, ВремяОкончанияЗамера, НомерЗамера");
		ЗаполнитьЗначенияСвойств(СтруктураЗамера, ТекущаяСтрока);
		
		СтруктураЗамера.ИдентификаторЗамера = ТекущаяСтрока.ИдЗамера;
		СтруктураЗамера.НомерЗамера = ТекущаяСтрока.НомерСтроки;
		
		МассивЗамеров.Добавить(СтруктураЗамера);
		
	КонецЦикла;
	
	Возврат МассивЗамеров;
	
КонецФункции

&НаКлиенте
Процедура ПослеОформленияЗаказДоговора() 
	
	Объект.ТекущийСтатус = ПредопределенноеЗначение("Справочник.СтатусыЛида.ДоговорОформлен");
	УправлениеЭлементамиФормыПоСтатусу();
	ДобавитьЗаписьВИсториюКлиент("Оформлен заказ-договор.");
	ОчиститьДатуСледующегоКонтактаБезЗаписиВИсторию(); // №9558
	ВывестиСписокДоговоров(); // №15368
	
КонецПроцедуры

&НаСервере
Функция ЕстьОформленныйЗаказДоговор()
	
	Результат = Ложь;
	
	ЕстьЗаказДоговор = Ложь;
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЗаказДоговор.Ссылка
	|ИЗ
	|	Документ.ЗаказДоговор КАК ЗаказДоговор
	|ГДЕ
	|	ЗаказДоговор.Проведен
	|	И ЗаказДоговор.Основание = &Основание
	|	И НЕ ЗаказДоговор.ДоговорРассторгнут
	|";
	Запрос.УстановитьПараметр("Основание", Объект.Ссылка);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Результат = Истина;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьСсылкуНаДоговор(СсылкаЛид)
	
	Если НЕ ЗначениеЗаполнено(СсылкаЛид) Тогда
		Возврат Документы.ЗаказДоговор.ПустаяСсылка();	
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ДокументЗаказДоговор.Ссылка
	|ИЗ
	|	Документ.ЗаказДоговор КАК ДокументЗаказДоговор
	|ГДЕ
	|	ДокументЗаказДоговор.Проведен
	|	И ДокументЗаказДоговор.Основание = &Основание
	|	И НЕ ДокументЗаказДоговор.ДоговорРассторгнут";
	Запрос.УстановитьПараметр("Основание", СсылкаЛид);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Возврат Выборка.Ссылка;
	КонецЦикла;
	
	Возврат Документы.ЗаказДоговор.ПустаяСсылка();
	
КонецФункции

