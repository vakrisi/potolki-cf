&НаКлиенте
Процедура ВыездВыполнен(Команда)	
	
	ТекущиеДанныеВыезда = Элементы.Выезды.ТекущиеДанные;
	Если НЕ ЗначениеЗаполнено(ТекущиеДанныеВыезда.Исполнитель) Тогда
		Сообщить("Необходимо указать исполнителя выезда!");
		Возврат;
	КонецЕсли;

	Если НЕ ПроверитьУказаниеВремениВыезда() ИЛИ Объект.Выезды.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
		
	ЭтаФорма.Записать();
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ВыездЗавершенЗавершение", ЭтаФорма);
	
	//++ №14649
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ТекущийСтатус", Объект.ТекущийСтатус);
	ПараметрыФормы.Вставить("СтатусПерехода", Объект.СтатусВозвратаПослеВыезда);
	ПараметрыФормы.Вставить("ДатаСледующегоКонтакта", СокрЛП(Формат(Объект.ПоследняяДатаПерезвонить, "ДФ='dd.MM.yyyy HH:mm'")));
	//-- №14649
	
	ОткрытьФорму("Документ.Лид.Форма.ФормаЗакрытияВыезда",ПараметрыФормы,ЭтаФорма,,,,ОписаниеОповещения);
		
КонецПроцедуры

&НаКлиенте
Процедура ВыездЗавершенЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
		
	ТекущиеДанные = Элементы.Выезды.ТекущиеДанные;
	
	ТекущиеДанные.Выполнен = Истина;
	ТекущиеДанные.Результат = ПредопределенноеЗначение("Справочник.РезультатыВыездаЛида.ВыездВыполнен"); // №14649
	ТекущиеДанные.КомментарийЗамерщика =  Результат.РезультатВыезда;
	
	ТекущийРезультатВыезда = ТекущиеДанные.Результат; //№14649 было: ТекущийРезультатВыезда = Истина;
	
	//++ №14649
	Объект.ПоследняяДатаПерезвонить = Результат.Дата;
	
	ДобавитьЗаписьВИсториюКлиент(СтрШаблон("Выезд выполнен. Комментарий: %1.%2", Результат.РезультатВыезда, ?(Объект.ПоследняяДатаПерезвонить = Дата(1,1,1), "", " Перезвонить: " + Формат(Объект.ПоследняяДатаПерезвонить, "ДФ='dd.MM.yyyy HH:mm'"))));
	
	Если ЗначениеЗаполнено(Объект.СтатусВозвратаПослеВыезда) Тогда
		
		Объект.ТекущийСтатус = Объект.СтатусВозвратаПослеВыезда;
		Объект.СтатусВозвратаПослеВыезда = ПредопределенноеЗначение("Справочник.СтатусыЛида.ПустаяСсылка");
		
	КонецЕсли;
	
	УправлениеЭлементамиФормыПоРезультатуВыезда();
	//-- №14649
	
КонецПроцедуры

//++ №14649
&НаКлиенте
Процедура ВыездНеВыполнен(Команда)
	
	ТекущиеДанныеВыезда = Элементы.Выезды.ТекущиеДанные;
	Если НЕ ЗначениеЗаполнено(ТекущиеДанныеВыезда.Исполнитель) Тогда
		Сообщить("Необходимо указать исполнителя выезда!");
		Возврат;
	КонецЕсли;

	Если НЕ ПроверитьУказаниеВремениВыезда() ИЛИ Объект.Выезды.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
		
	ЭтаФорма.Записать();
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ВыездНеВыполненЗавершение", ЭтаФорма);
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ТекущийСтатус", Объект.ТекущийСтатус);
	ПараметрыФормы.Вставить("СтатусПерехода", Объект.СтатусВозвратаПослеВыезда);
	ПараметрыФормы.Вставить("ДатаСледующегоКонтакта", СокрЛП(Формат(Объект.ПоследняяДатаПерезвонить, "ДФ='dd.MM.yyyy HH:mm'")));
	ПараметрыФормы.Вставить("РежимОтказа", Истина);
	
	ОткрытьФорму("Документ.Лид.Форма.ФормаЗакрытияВыезда", ПараметрыФормы, ЭтаФорма,,,, ОписаниеОповещения);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыездНеВыполненЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Модифицированность = Истина;
	
	ТекущиеДанные = Элементы.Выезды.ТекущиеДанные;
	
	ТекущиеДанные.Выполнен = Ложь;
	ТекущиеДанные.Результат = ПредопределенноеЗначение("Справочник.РезультатыВыездаЛида.ВыездНеВыполнен");
	ТекущиеДанные.КомментарийЗамерщика = Результат.РезультатВыезда;
	ТекущиеДанные.ПричинаОтказа = Результат.ПричинаОтказа;
	
	Объект.ПоследняяДатаПерезвонить = Результат.Дата;
	
	ТекущийРезультатВыезда = ТекущиеДанные.Результат;
	
	ДобавитьЗаписьВИсториюКлиент(СтрШаблон("Выезд не выполнен. Комментарий: %1.%2", Результат.РезультатВыезда, ?(Объект.ПоследняяДатаПерезвонить = Дата(1,1,1), "", " Перезвонить: " + Формат(Объект.ПоследняяДатаПерезвонить, "ДФ='dd.MM.yyyy HH:mm'"))));
	
	Если ЗначениеЗаполнено(Объект.СтатусВозвратаПослеВыезда) Тогда
		
		Объект.ТекущийСтатус = Объект.СтатусВозвратаПослеВыезда;
		Объект.СтатусВозвратаПослеВыезда = ПредопределенноеЗначение("Справочник.СтатусыЛида.ПустаяСсылка");
		
	КонецЕсли;
	
	УправлениеЭлементамиФормыПоРезультатуВыезда();
	
КонецПроцедуры
//-- №14649

&НаКлиенте
Функция ПроверитьУказаниеВремениВыезда()
	
	ТекущиеДанныеВыезда = Элементы.Выезды.ТекущиеДанные;
	Если НЕ ЗначениеЗаполнено(ТекущиеДанныеВыезда.ВремяНачала) ИЛИ НЕ ЗначениеЗаполнено(ТекущиеДанныеВыезда.ВремяОкончания) Тогда
		Сообщить("Необходимо указать время начала и окончания выезда, для его установки в выполнен!");		
		Возврат Ложь;
	КонецЕсли;
	Возврат Истина;
	
КонецФункции

#КонецОбласти

#Область Графики

&НаКлиенте
Процедура ВариантОтображенияГрафикаПриИзменении(Элемент)
	ВариантОтображенияГрафикаПриИзмененииНаСервере();
	
	ПолучитьПервоначальныеДанныеДляГрафикаЗамеров();
	ОбновитьГрафикЗамеров();
	
	ОбновитьЭлементыФормыНаСервере();
КонецПроцедуры

&НаСервере
Процедура ВариантОтображенияГрафикаПриИзмененииНаСервере()
	ХранилищеОбщихНастроек.Сохранить("ДокументЛид", "ВариантОтображенияГрафика", ВариантОтображенияГрафика);
КонецПроцедуры

&НаСервере
Функция ПолучитьМассивЗамерщиков()
	
	ТаблицаЗамерщиков = МодульОтчетов.ПолучитьТаблицуЗамерщиков(ФильтрТочкаПродаж, ФильтрПодразделение);
	МассивЗамерщиков = ТаблицаЗамерщиков.ВыгрузитьКолонку("Сотрудник");
	Если ПолучитьФункциональнуюОпцию("ИспользоватьПулЗамеров") Тогда
		МассивЗамерщиков.Добавить(Справочники.Сотрудники.ПустаяСсылка());
	КонецЕсли;
	Возврат МассивЗамерщиков;
	
КонецФункции

&НаСервере
Функция ПолучитьТаблицуЗамеров(ДатаНачалаГрафика, ДатаОкончанияГрафика, МассивЗамерщиков)
	
	ТаблицаЗамеров = МодульОтчетов.ПолучитьТаблицуЗамеров(ДатаНачалаГрафика, ДатаОкончанияГрафика, МассивЗамерщиков);
	ТаблицаЗамеров.Сортировать("Сотрудник, Дата, ВремяНачала");
	Возврат ОбщегоНазначения.ТаблицаЗначенийВМассив(ТаблицаЗамеров);
	
КонецФункции

//&НаСервере
&НаКлиенте
Процедура ПолучитьПервоначальныеДанныеДляГрафикаЗамеров()
	
	// формируем таблицу с данными для вывода на графики
	
	ТаблицаГрафикЗамеров.Очистить();
	МассивСотрудников = ПолучитьМассивЗамерщиков();
	
	ДатаНачалаГрафика = ТекущаяДата();
	
	//#6588
	Если ПланированиеЗамера Тогда
		ТекущиеДанные = Элементы.Замеры.ТекущиеДанные;
		Если НЕ ТекущиеДанные = Неопределено Тогда
			ДатаЗамераТекущиеДанные = ТекущиеДанные.ДатаЗамера;
			ВремяНачалаЗамера = ТекущиеДанные.ВремяНачалаЗамера;
			ВремяОкончанияЗамера = ТекущиеДанные.ВремяОкончанияЗамера;
			ДатаНачалаГрафика = ДатаЗамераТекущиеДанные;
		КонецЕсли;
	ИначеЕсли ПланированиеВыезда Тогда
		ТекущиеДанные = Элементы.Выезды.ТекущиеДанные;
		Если НЕ ТекущиеДанные = Неопределено Тогда
			ДатаВыездаТекущиеДанные = ТекущиеДанные.Дата;
			ВремяНачалаЗамера = ТекущиеДанные.ВремяНачала;
			ВремяОкончанияЗамера = ТекущиеДанные.ВремяОкончания; 
			ДатаНачалаГрафика = ДатаВыездаТекущиеДанные;
		КонецЕсли;
	КонецЕсли;
	
	// если в замере/выезде очистили дату
	ДатаНачалаГрафика = ?(ДатаНачалаГрафика = Дата(1,1,1), ТекущаяДата(), ДатаНачалаГрафика);
	
	Если ВариантОтображенияГрафика = 2 Тогда
		//Если НЕ ПредыдущаяДатаЗамера = Дата(1,1,1) Тогда
		//	ДатаНачалаГрафика = ПредыдущаяДатаЗамера;
		//КонецЕсли;
		
		// если новая дата начала попадает в отображаемый период, то не меняем отображаемый период
		Если НЕ ТекущаяДатаГрафика = Дата(1,1,1) Тогда
			Если ДатаНачалаГрафика >= ТекущаяДатаГрафика И ДатаНачалаГрафика <= ТекущаяДатаГрафика + ИнтервалГрафикаТаблица Тогда
				ДатаНачалаГрафика = ТекущаяДатаГрафика;
			КонецЕсли;
		КонецЕсли;
		ДатаОкончанияГрафика = ДатаНачалаГрафика + ИнтервалГрафикаТаблица;		
	Иначе
		ДатаОкончанияГрафика = ДатаНачалаГрафика;
	КонецЕсли;
	ТекущаяДатаГрафика = ДатаНачалаГрафика;
	//получаем таблицу замеров/выездов/невыходов из регистра для отображения графика за заданный период
	ТаблицаЗамеров = ПолучитьТаблицуЗамеров(ДатаНачалаГрафика, ДатаОкончанияГрафика, МассивСотрудников);
	
	Для каждого ЭлементЗамера из ТаблицаЗамеров Цикл		
		Если НЕ ЭлементЗамера.Регистратор = Объект.Ссылка Тогда
			НоваяСтрока = ТаблицаГрафикЗамеров.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ЭлементЗамера, 
									"Регистратор, Дата, ВремяНачала, ВремяОкончания, 
									|Город, Адрес, ИмяКлиента, Комментарий, ТелефонКлиента, Результат, Сотрудник, ЗамерВыполнен, ОтсутствиеИсполнителя, ЭтоВыезд,
									|ИДЗамера, ТочкаПродаж, КоличествоЗамерщиковПоПлану");					
			НоваяСтрока.ТекстНаГрафике = ОбщийМодуль.ПолучитьТекстДляГрафикаЗамеров(ЭлементЗамера);
			НоваяСтрока.ЗначениеНаГрафике = "";
			НоваяСтрока.Текущий = Ложь;
		КонецЕсли;
	КонецЦикла;

	// добавим в таблицу замерщика для отображения в графике, если его еще нет
	// зачем это??? пока убрано 
	//Для каждого ЭлементСотрудник из МассивСотрудников Цикл
	//	ЕстьСотрудник = Ложь;
	//	Для каждого ЭлементТаблицыЗамеров из ТаблицаЗамеров Цикл
	//		Если ЭлементТаблицыЗамеров.Сотрудник = ЭлементСотрудник Тогда
	//			ЕстьСотрудник = Истина;
	//			Прервать;
	//		КонецЕсли;
	//	КонецЦикла;
	//	Если НЕ ЕстьСотрудник Тогда
	//		НоваяСтрока = ТаблицаГрафикЗамеров.Добавить();
	//		НоваяСтрока.Сотрудник = ЭлементСотрудник;
	//	КонецЕсли;
	//КонецЦикла;	
	
	СтруктураДанныхДляТекстаГрафика = Новый Структура;
	СтруктураДанныхДляТекстаГрафика.Вставить("Комментарий", 	Объект.Комментарий);
	СтруктураДанныхДляТекстаГрафика.Вставить("Адрес", 			Объект.Адрес);
	СтруктураДанныхДляТекстаГрафика.Вставить("ИмяКлиента", 		Объект.ИмяКлиента);
	СтруктураДанныхДляТекстаГрафика.Вставить("Город", 			Объект.Город);
	СтруктураДанныхДляТекстаГрафика.Вставить("ТелефонКлиента",  УправлениеКонтактнойИнформациейКлиентПотолки.ПолучитьТелефонИзКонтактнойИнформацииФормы(ЭтотОбъект));
		
	//добавим замеры текущего документа
	Для Каждого ЗамерТекущегоДокумента Из Объект.Замеры Цикл
		Если ЗамерТекущегоДокумента.ДатаЗамера < ДатаНачалаГрафика 
			ИЛИ ЗамерТекущегоДокумента.ДатаЗамера > ДатаОкончанияГрафика 
			ИЛИ НЕ ЗначениеЗаполнено(ЗамерТекущегоДокумента.ДатаЗамера) Тогда
			Продолжить;
		КонецЕсли;
		
		Если ЗамерТекущегоДокумента.ВремяНачалаЗамера = Дата(1,1,1) И ЗамерТекущегоДокумента.ВремяОкончанияЗамера = Дата(1,1,1) 
			//И ЗамерТекущегоДокумента.ИсполнительЗамера.Пустая() //#6384 закомментировано
			ИЛИ ЗамерТекущегоДокумента.РезультатЗамера = ПредопределенноеЗначение("Справочник.РезультатЗамераЛида.ЗамерОтменен") 
			ИЛИ ЗамерТекущегоДокумента.РезультатЗамера = ПредопределенноеЗначение("Справочник.РезультатЗамераЛида.ЗамерНеПроизводился") 
			Тогда 
			// не нужен в графике
		Иначе
			НоваяСтрока = ТаблицаГрафикЗамеров.Добавить();
			НоваяСтрока.Сотрудник = ЗамерТекущегоДокумента.ИсполнительЗамера;
			НоваяСтрока.ВремяНачала  = ОбщийМодульКлиентСервер.СоединитьДатуИВремя(ЗамерТекущегоДокумента.ДатаЗамера, ЗамерТекущегоДокумента.ВремяНачалаЗамера);
			НоваяСтрока.ВремяОкончания = ОбщийМодульКлиентСервер.СоединитьДатуИВремя(ЗамерТекущегоДокумента.ДатаЗамера, ЗамерТекущегоДокумента.ВремяОкончанияЗамера);
			НоваяСтрока.ТекстНаГрафике = ОбщийМодуль.ПолучитьТекстДляГрафикаЗамеров(СтруктураДанныхДляТекстаГрафика, Объект.ПоследнийКомментарийКЗамеру);
			НоваяСтрока.ЗамерВыполнен = ЗамерТекущегоДокумента.ЗамерВыполнен;
			НоваяСтрока.Текущий = Истина;
			НоваяСтрока.ЗначениеНаГрафике = "Текущий";
			НоваяСтрока.Регистратор = Объект.Ссылка;
			НоваяСтрока.Новый = (ЗамерТекущегоДокумента.НомерСтроки = Объект.Замеры.Количество());
			НоваяСтрока.НазначилЗамер = ЗамерТекущегоДокумента.НазначилЗамер;
			НоваяСтрока.Дата = ЗамерТекущегоДокумента.ДатаЗамера;
			
			НоваяСтрока.Город = Объект.Город;
			НоваяСтрока.Адрес = Объект.Адрес;
			НоваяСтрока.ИмяКлиента = Объект.ИмяКлиента; 
			НоваяСтрока.Комментарий = Объект.ПоследнийКомментарийКЗамеру;
			НоваяСтрока.ТелефонКлиента = СтруктураДанныхДляТекстаГрафика.ТелефонКлиента;
			НоваяСтрока.Результат = ЗамерТекущегоДокумента.РезультатЗамера;
			
			НоваяСтрока.ИДЗамера = ЗамерТекущегоДокумента.ИДЗамера;
			НоваяСтрока.ТочкаПродаж  = Объект.ТочкаПродаж;
			НоваяСтрока.КоличествоЗамерщиковПоПлану = ПолучитьКоличествоЗамерщиковПоПлану(ЗамерТекущегоДокумента.ДатаЗамера, Объект.ТочкаПродаж);
			
		КонецЕсли;
	КонецЦикла;
	
	//добавим выезды текущего документа
	Для Каждого ВыездТекущегоДокумента Из Объект.Выезды Цикл
		Если ВыездТекущегоДокумента.Дата < ДатаНачалаГрафика 
			ИЛИ ВыездТекущегоДокумента.Дата > ДатаОкончанияГрафика 
			ИЛИ НЕ ЗначениеЗаполнено(ВыездТекущегоДокумента.Дата) Тогда
			Продолжить;
		КонецЕсли;
		
		АдресВыезда = ?(ПустаяСтрока(Объект.АдресВыезда), Объект.Адрес, Объект.АдресВыезда);
		Если ВыездТекущегоДокумента.ВремяНачала = Дата(1,1,1) и ВыездТекущегоДокумента.ВремяОкончания = Дата(1,1,1) 
			//и ВыездТекущегоДокумента.Исполнитель.Пустая() //#6384 закомментировано
			ИЛИ ВыездТекущегоДокумента.Результат = ПредопределенноеЗначение("Справочник.РезультатыВыездаЛида.ВыездОтменен") 
			ИЛИ ВыездТекущегоДокумента.Результат = ПредопределенноеЗначение("Справочник.РезультатыВыездаЛида.ВыездНеВыполнен")
			Тогда
			// не нужен в графике
		Иначе
			НоваяСтрока = ТаблицаГрафикЗамеров.Добавить();
			НоваяСтрока.Сотрудник = ВыездТекущегоДокумента.Исполнитель;
			НоваяСтрока.ВремяНачала  = ОбщийМодульКлиентСервер.СоединитьДатуИВремя(ВыездТекущегоДокумента.Дата, ВыездТекущегоДокумента.ВремяНачала);
			НоваяСтрока.ВремяОкончания = ОбщийМодульКлиентСервер.СоединитьДатуИВремя(ВыездТекущегоДокумента.Дата, ВыездТекущегоДокумента.ВремяОкончания);
			НоваяСтрока.ТекстНаГрафике = ОбщийМодуль.ПолучитьТекстДляГрафикаЗамеров(СтруктураДанныхДляТекстаГрафика, , АдресВыезда);
			НоваяСтрока.ЗамерВыполнен = ВыездТекущегоДокумента.Выполнен;
			НоваяСтрока.Текущий = Истина;
			НоваяСтрока.ЗначениеНаГрафике = "Текущий";
			НоваяСтрока.Регистратор = Объект.Ссылка;
			НоваяСтрока.Новый = (ВыездТекущегоДокумента.НомерСтроки = Объект.Выезды.Количество());
			НоваяСтрока.НазначилЗамер = ВыездТекущегоДокумента.Назначил;
			НоваяСтрока.ЭтоВыезд = Истина;
			
			НоваяСтрока.Дата  = ВыездТекущегоДокумента.Дата;
			НоваяСтрока.Город = Объект.Город;
			НоваяСтрока.Адрес = АдресВыезда;
			НоваяСтрока.ИмяКлиента = Объект.ИмяКлиента; 
			НоваяСтрока.Комментарий = "";
			НоваяСтрока.ТелефонКлиента = СтруктураДанныхДляТекстаГрафика.ТелефонКлиента;
			
			НоваяСтрока.ИДЗамера = ВыездТекущегоДокумента.ИДЗамера;
			НоваяСтрока.ТочкаПродаж  = Объект.ТочкаПродаж;
			НоваяСтрока.КоличествоЗамерщиковПоПлану = ПолучитьКоличествоЗамерщиковПоПлану(ВыездТекущегоДокумента.Дата, Объект.ТочкаПродаж);
		КонецЕсли;
		
	КонецЦикла;
	
	ТаблицаГрафикЗамеров.Сортировать("Сотрудник Возр");
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьКоличествоЗамерщиковПоПлану(ДатаЗамера, ТочкаПродаж)
	Возврат МодульОтчетов.ПолучитьКоличествоЗамерщиковПоПлану(ДатаЗамера, ДатаЗамера, ТочкаПродаж);
КонецФункции

&НаКлиенте
Процедура ОбновитьГрафикЗамеров()
	
	// ниже по датам все закомментировано: ориентируемся на реквизит формы ТекущаяДатаГрафика 	
	//ДатаЗамераТекущиеДанные = Элементы.Замеры.ТекущиеДанные.ДатаЗамера; //#6588
	ДатаНачалаГрафика = ТекущаяДатаГрафика;
	Если ВариантОтображенияГрафика = 2 Тогда
	//	Если НЕ ПредыдущаяДатаЗамера = Дата(1,1,1) Тогда
	//		ДатаНачалаГрафика = ПредыдущаяДатаЗамера;
	//	КонецЕсли;
		ДатаОкончанияГрафика = ДатаНачалаГрафика + ИнтервалГрафикаТаблица;
	Иначе
		ДатаОкончанияГрафика = ДатаНачалаГрафика;
	КонецЕсли;	
			
	ОбновитьГрафикЗамеровНаСервере(ДатаНачалаГрафика, ДатаОкончанияГрафика);
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьГрафикЗамеровНаСервере(ДатаНачалаГрафика, ДатаОкончанияГрафика)
	
	Элементы.ДекорацияПустойПланЗамерщиков.Видимость = Ложь;
	
	Если ВариантОтображенияГрафика = 2 Тогда		
		ОбновитьГрафикЗамеровТаблицаНаСервере(ДатаНачалаГрафика, ДатаОкончанияГрафика);
	Иначе	
		ОбновитьГрафикЗамеровПланировщикНаСервере(ДатаНачалаГрафика, ДатаОкончанияГрафика);
	КонецЕсли;
	
	ОписаниеЗамерщиковHTML = Документы.Лид.СформироватьОписаниеЗамерщиковHTML(ФильтрТочкаПродаж);
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьТекстНаГрафикеЗамеровНаСервере()
	Для каждого ЭлементГрафика Из ГрафикЗамеров.Элементы Цикл
		Если ЭлементГрафика.Значение.ЗначениеНаГрафике = "ТекущийЗамер" Тогда
			ЭлементГрафика.Текст = ОбщийМодуль.ПолучитьТекстДляГрафикаЗамеров(Объект, Объект.ПоследнийКомментарийКЗамеру);
		ИначеЕсли ЭлементГрафика.Значение.ЗначениеНаГрафике = "ТекущийВыезд" Тогда
			ЭлементГрафика.Текст = ОбщийМодуль.ПолучитьТекстДляГрафикаЗамеров(Объект,, ?(ПустаяСтрока(Объект.АдресВыезда), Объект.Адрес, Объект.АдресВыезда));
		КонецЕсли;
	КонецЦикла;			
КонецПроцедуры

&НаКлиенте
Процедура ПослеВопросаОбИзмененииЗамера(Результат, ДопПараметры) Экспорт
	Если Результат = КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли;
	// новый замер/выезд
	Расшифровка = ДопПараметры.Расшифровка;
	Если НЕ ПроверитьСвободныйИнтервалЗамеров(ДопПараметры.Расшифровка, Объект.Ссылка) Тогда
		Сообщить("Выбранный интервал занят");
		Возврат;
	КонецЕсли;
	Если ПланированиеВыезда Тогда
		ИзменитьДанныеТекущегоВыезда(Расшифровка.ИсполнительЗамера, Расшифровка.ВремяНачалаЗамера, Расшифровка.ВремяОкончанияЗамера, Расшифровка.ДатаЗамера);
	Иначе 	
		ИзменитьДанныеТекущегоЗамера(Расшифровка.ИсполнительЗамера, Расшифровка.ВремяНачалаЗамера, Расшифровка.ВремяОкончанияЗамера, Расшифровка.ДатаЗамера);
	КонецЕсли;	
	ОбновитьГрафикЗамеров();
	
	Модифицированность = Истина;
КонецПроцедуры

//&НаСервере
&НаКлиенте
Процедура ИзменитьДанныеТекущегоЗамера(Сотрудник, ВремяС, ВремяПо, ПараметрДатаЗамера=Неопределено)
	
	//#12459
	Если ЗначениеЗаполнено(Элементы.Замеры.ТекущиеДанные.РезультатЗамера) Тогда
		Сообщить("По замеру заполнен результат: изменение запрещено!");
		Возврат;	
	КонецЕсли;
	
	КонецМинута = Минута(ВремяПо);
	КонецЧас = Час(ВремяПо);
	КонецСекунда = Секунда(ВремяПо);
	
	ИсполнительЗамера = Сотрудник;	
	//НазначилЗамер = ПолучитьСотрудникаТекущегоПользователя(); //#6588 закомментировано 
	//ДатаНазначенияЗамера = ТекущаяДата(); //ТекущаяДатаСеанса(); //#6588 закомментировано
	ВремяНачалаЗамера = Дата(1,1,1,Час(ВремяС), Минута(ВремяС), Секунда(ВремяС));
	ВремяОкончанияЗамера = Дата(1,1,1,КонецЧас, КонецМинута, КонецСекунда);
	Если НЕ ПараметрДатаЗамера = Неопределено Тогда
		ДатаЗамера = ПараметрДатаЗамера;	
	КонецЕсли;
	
	//#6588 
	Элементы.Замеры.ТекущиеДанные.ИсполнительЗамера 		= Сотрудник;
	ЭтоНовыйЗамер = Ложь;
	Если Элементы.Замеры.ТекущиеДанные.ЭтоНовый Тогда
		ЭтоНовыйЗамер = Истина;
		Элементы.Замеры.ТекущиеДанные.ЭтоНовый = Ложь;	
	КонецЕсли;
	Если ЭтоНовыйЗамер Тогда		
		Элементы.Замеры.ТекущиеДанные.НазначилЗамер 			= ПолучитьСотрудникаТекущегоПользователя();
		Элементы.Замеры.ТекущиеДанные.НазначилЗамерПользователь = ПолучитьТекущегоПользователя(); // №13942
	КонецЕсли;
	Элементы.Замеры.ТекущиеДанные.ДатаНазначенияЗамера 		= ТекущаяДата();
	Элементы.Замеры.ТекущиеДанные.ВремяНачалаЗамера 		= Дата(1,1,1,Час(ВремяС), Минута(ВремяС), Секунда(ВремяС));
	Элементы.Замеры.ТекущиеДанные.ВремяОкончанияЗамера 		= Дата(1,1,1,КонецЧас, КонецМинута, КонецСекунда);
	
	Если НЕ ПараметрДатаЗамера = Неопределено Тогда
		Элементы.Замеры.ТекущиеДанные.ДатаЗамера = ПараметрДатаЗамера;	
	КонецЕсли;
	
	ПолучитьПервоначальныеДанныеДляГрафикаЗамеров();
	
	// №14649
	ЗаполнитьОтветственного(Сотрудник);
	// №16755
	ЗаполнитьЗамерщика(Сотрудник);
	
КонецПроцедуры
	
//++ №14649
&НаКлиенте
Процедура ЗаполнитьОтветственного(Ответственный)
	
	Если ВариантИзмененияОтветственногоВЛиде = ПредопределенноеЗначение("Перечисление.ВариантыИзмененияОтветственногоВЛиде.МенятьНаИсполнителяЗамера") Тогда
		
		Объект.Ответственный = Ответственный;
		
	ИначеЕсли ВариантИзмененияОтветственногоВЛиде = ПредопределенноеЗначение("Перечисление.ВариантыИзмененияОтветственногоВЛиде.ЗапрашиватьПодтверждение")
		И НЕ Ответственный = Объект.Ответственный Тогда
		
		ОписаниеОповещения = новый ОписаниеОповещения("ЗаполнитьОтветственногоЗавершение", ЭтотОбъект, Ответственный);
		ПоказатьВопрос(ОписаниеОповещения, "Заполнить ответственного по исполнителю замера?", РежимДиалогаВопрос.ДаНет,,, "Смена ответственного по исполнителю замера");
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьОтветственногоЗавершение(Ответ, Ответственный) Экспорт
	
	Если НЕ Ответ = КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	Объект.Ответственный = Ответственный;
	
КонецПроцедуры
//-- №14649

&НаКлиенте
Процедура ЗаполнитьЗамерщика(ИсполнительЗамера)
	
	Если ВариантИзмененияЗамерщикаВЛиде = ПредопределенноеЗначение("Перечисление.ВариантыИзмененияЗамерщикаВЛиде.МенятьНаИсполнителяЗамера") Тогда		
		Объект.Замерщик = ИсполнительЗамера;			
	КонецЕсли;
	
КонецПроцедуры

//&НаСервере
&НаКлиенте
Процедура ИзменитьДанныеТекущегоВыезда(Сотрудник, ВремяС, ВремяПо, ПараметрДатаВыезда = Неопределено)
	
	//#12459
	Если Элементы.Выезды.ТекущиеДанные.Выполнен Тогда
		Сообщить("Выезд выполнен: изменение запрещено!");
		Возврат;	
	КонецЕсли;
	
	КонецМинута = Минута(ВремяПо);
	КонецЧас = Час(ВремяПо);
	КонецСекунда = Секунда(ВремяПо);
	
	//ИсполнительВыезда = Сотрудник;		
	ВремяНачалаВыезда = Дата(1,1,1,Час(ВремяС), Минута(ВремяС), Секунда(ВремяС));
	ВремяОкончанияВыезда = Дата(1,1,1,КонецЧас, КонецМинута, КонецСекунда);
	
	//Если НЕ ПараметрДатаВыезда = Неопределено Тогда
	//	ДатаВыезда = ПараметрДатаВыезда;	
	//КонецЕсли;
	
	//НомерСтроки = Объект.Выезды.Количество()-1;
	//Объект.Выезды[НомерСтроки].Исполнитель = Сотрудник; //ИсполнительВыезда;
	//Объект.Выезды[НомерСтроки].ВремяНачала = ВремяНачалаВыезда;
	//Объект.Выезды[НомерСтроки].ВремяОкончания = ВремяОкончанияВыезда;
	//Объект.Выезды[НомерСтроки].Дата = ДатаВыезда;

	Элементы.Выезды.ТекущиеДанные.Исполнитель 			= Сотрудник; //ИсполнительВыезда;
	ЭтоНовыйВыезд = Ложь;
	Если Элементы.Выезды.ТекущиеДанные.ЭтоНовый Тогда
		ЭтоНовыйВыезд = Истина;
		Элементы.Выезды.ТекущиеДанные.ЭтоНовый = Ложь;	
	КонецЕсли;
	Если ЭтоНовыйВыезд Тогда
		Элементы.Выезды.ТекущиеДанные.Назначил 	  			= ПолучитьСотрудникаТекущегоПользователя();
		Элементы.Выезды.ТекущиеДанные.НазначилПользователь 	= ПолучитьТекущегоПользователя(); // №13942
	КонецЕсли;
	Элементы.Выезды.ТекущиеДанные.ВремяНачала 			= ВремяНачалаВыезда;
	Элементы.Выезды.ТекущиеДанные.ВремяОкончания 		= ВремяОкончанияВыезда;
	Элементы.Выезды.ТекущиеДанные.ДатаНазначения		= ТекущаяДата();
	
	Если НЕ ПараметрДатаВыезда = Неопределено Тогда
		Элементы.Выезды.ТекущиеДанные.Дата = ПараметрДатаВыезда;
	КонецЕсли;
	
	ПолучитьПервоначальныеДанныеДляГрафикаЗамеров();
	
КонецПроцедуры

