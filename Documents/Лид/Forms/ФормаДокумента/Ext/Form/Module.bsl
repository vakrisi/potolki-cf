	// #14649
	Если Элементы.ГруппаСтраницыОсновные.ТекущаяСтраница = Элементы.ГруппаЗамерВыезд Тогда
		Если ПланированиеВыезда Тогда
			Возврат;
		ИначеЕсли ПланированиеЗамера И ПоследнийЗамерПустой() Тогда
			СтруктураПараметров = новый Структура("СценарийНазначенияВыезда", Истина); // №14649
			ОписаниеОповещения = Новый ОписаниеОповещения("ПослеВопросаОПродолженииНазначенияЗамераЗеркально", ЭтотОбъект, СтруктураПараметров);
			ПоказатьВопрос(ОписаниеОповещения, "Замер не будет сохранен, назначить выезд?", РежимДиалогаВопрос.ДаНет);		
			Возврат;			
		КонецЕсли;
