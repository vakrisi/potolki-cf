#Область ГрафикПланировщик

&НаСервере
Процедура ОбновитьГрафикЗамеровПланировщикНаСервере(ДатаНачалаГрафика, ДатаОкончанияГрафика)
	
	//Вариант отображения (горизонтальный / вертикальный)
	Развертка = ?(ВариантОтображенияГрафика = 0 ИЛИ ВариантОтображенияГрафика = 3 ИЛИ ВариантОтображенияГрафика = 5, 0, 1);
	ТекущийДень = ДатаНачалаГрафика;
	СтруктураИзЛида = Новый Структура("НаСтраницеВыезд, НаСтраницеЗамер", ПланированиеВыезда, ПланированиеЗамера);
	
	НачальнаяДатаПланировщика = ОбщийМодульКлиентСервер.СоединитьДатуИВремя(ТекущийДень, ВремяНачалаЗамеров);
	КонечнаяДатаПланировщика  = ОбщийМодульКлиентСервер.СоединитьДатуИВремя(ТекущийДень, ВремяКонцаЗамеров);

	Если ВариантОтображенияГрафика = 0 ИЛИ ВариантОтображенияГрафика = 1 Тогда
		НастройкиГрафика = МодульОтчетов.ИнициализироватьНастройкиПланировщикаГрафикаЗамеров(ГрафикЗамеров, Развертка, НачальнаяДатаПланировщика, КонечнаяДатаПланировщика, Ложь);		
		МодульОтчетов.ЗаполнитьГрафикЗамеровКалендарьПоЗамерщикам(ГрафикЗамеров, НастройкиГрафика, ФильтрТочкаПродаж, ФильтрПодразделение, ТаблицаГрафикЗамеров, СтруктураИзЛида);
		
	ИначеЕсли ВариантОтображенияГрафика = 3 ИЛИ ВариантОтображенияГрафика = 4 
		ИЛИ ВариантОтображенияГрафика = 5 ИЛИ ВариантОтображенияГрафика = 6 Тогда
		
		ВыводитьРеальныхЗамерщиков = (ВариантОтображенияГрафика = 3 ИЛИ ВариантОтображенияГрафика = 4); // распределение
		НастройкиГрафика = МодульОтчетов.ИнициализироватьНастройкиПланировщикаГрафикаЗамеров(ГрафикЗамеров, Развертка, НачальнаяДатаПланировщика, КонечнаяДатаПланировщика, Ложь, ВыводитьРеальныхЗамерщиков);		
		КоличествоЗамерщиковНаДату = МодульОтчетов.ЗаполнитьГрафикЗамеровКалендарьПоПлану(ГрафикЗамеров, НастройкиГрафика, ФильтрТочкаПродаж, ТаблицаГрафикЗамеров, СтруктураИзЛида);
		
		Элементы.ДекорацияПустойПланЗамерщиков.Видимость = (КоличествоЗамерщиковНаДату = 0);
		Элементы.ГрафикЗамеров.Видимость = (НЕ КоличествоЗамерщиковНаДату = 0);
				
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ГрафикЗамеровПередСозданием(Элемент, Начало, Конец, Значения, Текст, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ОчиститьСообщения();
	
	// если на графике нет сотрудников, то ничего не делаем
	Если Значения.Получить("Сотрудник") = Неопределено Тогда
		Если ВариантОтображенияГрафика = 3 ИЛИ ВариантОтображенияГрафика = 4 Тогда
			Сообщить("Не запланировано количество замерщиков на дату");	
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	//НачалоРабочегоВремениЗамеров = НачалоРабочегоВремениЗамеров();
	//КонецРабочегоВремениЗамеров = КонецРабочегоВремениЗамеров();
	
	//ДатаЗамераТекущиеДанные = Элементы.Замеры.ТекущиеДанные.ДатаЗамера; //#6588
	ТекущийДень = ТекущаяДатаГрафика; //?(Элементы.ГруппаСтраницыОсновные.ТекущаяСтраница.Имя = "ГруппаЗамер", ДатаЗамераТекущиеДанные, ДатаВыезда); // ТекущаяДатаГрафика
	
	Если Начало < Дата(Год(ТекущийДень), Месяц(ТекущийДень), День(ТекущийДень), Час(ВремяНачалаЗамеров), Минута(ВремяНачалаЗамеров),0) 
		или Конец > Дата(Год(ТекущийДень), Месяц(ТекущийДень), День(ТекущийДень), Час(ВремяКонцаЗамеров), Минута(ВремяКонцаЗамеров) ,0) Тогда
		Возврат;
	КонецЕсли;
	
	ДлинаМинимальногоЗамераВСекундах = ПродолжительностьЗамера * 60 * 60;
	Если Начало + ДлинаМинимальногоЗамераВСекундах > Конец Тогда
		Конец = Начало + ДлинаМинимальногоЗамераВСекундах;
	КонецЕсли;
	//Конец = Конец - 1;
	
	//проверяем пересечения периодов по визуальному графику
	Отказ = Ложь;
	Для Каждого СуществующаяЗапись Из ТаблицаГрафикЗамеров Цикл
		Если НЕ РазрешеноПересечениеПериодов(СуществующаяЗапись.Сотрудник) Тогда		
			Если СуществующаяЗапись.Сотрудник = Значения.Получить("Сотрудник") Тогда
				Если НЕ СуществующаяЗапись.Новый Тогда
					//Если Начало < СуществующаяЗапись.ВремяС и Конец > СуществующаяЗапись.ВремяС Тогда
					//	Отказ = Истина;
					//	Возврат;
					//ИначеЕсли Начало > СуществующаяЗапись.ВремяС и Конец < СуществующаяЗапись.ВремяПо Тогда
					//	Отказ = Истина;
					//	Возврат;
					//ИначеЕсли Начало < СуществующаяЗапись.ВремяПо и Конец > СуществующаяЗапись.ВремяПо Тогда
					//	Отказ = Истина;
					//	Возврат;
					//ИначеЕсли Начало < СуществующаяЗапись.ВремяС и Конец > СуществующаяЗапись.ВремяПо Тогда
					//	Отказ = Истина;
					//	Возврат;
					Если (СуществующаяЗапись.ВремяНачала > Начало ИЛИ СуществующаяЗапись.ВремяОкончания > Начало) 
						И (СуществующаяЗапись.ВремяНачала < Конец ИЛИ СуществующаяЗапись.ВремяОкончания < Конец) Тогда
						Отказ = Истина;							
					ИначеЕсли Начало = СуществующаяЗапись.ВремяНачала и Конец = СуществующаяЗапись.ВремяОкончания Тогда
						Отказ = Истина;						
					КонецЕсли;		
					
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	//проверяем пересечения периодов по регистру
	Если НЕ Отказ Тогда //И ИспользуетсяПулЗамеров Тогда
		ПараметрыНовогоЗамера = Новый Структура;
		ПараметрыНовогоЗамера.Вставить("ДатаЗамера", 			НачалоДня(Начало));
		ПараметрыНовогоЗамера.Вставить("ВремяНачалаЗамера", 	Дата("00010101") + (Начало - НачалоДня(Начало)));
		ПараметрыНовогоЗамера.Вставить("ВремяОкончанияЗамера",  Дата("00010101") + (Конец - НачалоДня(Конец)));
		ПараметрыНовогоЗамера.Вставить("ИсполнительЗамера", 	Значения.Получить("Сотрудник"));
		Если НЕ ПроверитьСвободныйИнтервалЗамеров(ПараметрыНовогоЗамера, Объект.Ссылка) Тогда
			Отказ = Истина;
			
			// #9710 пересечение есть, но на визуальном графике этого еще не видно,
			// поэтому перестроим график
			ПолучитьПервоначальныеДанныеДляГрафикаЗамеров();
			ОбновитьГрафикЗамеров();
		КонецЕсли;
	КонецЕсли;
	
	Если Отказ Тогда
		//ПоказатьПредупреждение(,"Время замера не должно пересекаться с другими заплнированными замерами");
		Сообщить("Выбранный интервал занят");
		Возврат;
	Иначе
		Если ПланированиеВыезда Тогда //Элементы.ГруппаСтраницыОсновные.ТекущаяСтраница = Элементы.ГруппаВыезд Тогда
			ИзменитьДанныеТекущегоВыезда(Значения.Получить("Сотрудник"), Начало, Конец);
		ИначеЕсли ПланированиеЗамера Тогда // Замер	
			ИзменитьДанныеТекущегоЗамера(Значения.Получить("Сотрудник"), Начало, Конец);
		КонецЕсли;	
		ОбновитьГрафикЗамеров();
		Модифицированность = Истина;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ГрафикЗамеровПриОкончанииРедактирования(Элемент, НовыйЭлемент, ОтменаРедактирования)
	
	ОчиститьСообщения();
	Если Элемент.ВыделенныеЭлементы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ИдТекущегоЗамераВыезда = Новый УникальныйИдентификатор("00000000-0000-0000-0000-000000000000");
	Если ПланированиеЗамера Тогда
		ИдТекущегоЗамераВыезда = Элементы.Замеры.ТекущиеДанные.ИДЗамера;
	ИначеЕсли ПланированиеВыезда Тогда
		ИдТекущегоЗамераВыезда = Элементы.Выезды.ТекущиеДанные.ИДЗамера;
	КонецЕсли;	

	ЭлементЗамера = Элемент.ВыделенныеЭлементы[0];
	
	// разрешаем перенос только редактируемого замера/выезда
	Если НЕ ИдТекущегоЗамераВыезда = ЭлементЗамера.Значение.ИдЗамера Тогда
		ОтменаРедактирования = Истина;
		Возврат;
	КонецЕсли;

	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ДатаЗамера", 				НачалоДня(ЭлементЗамера.Начало));
	ДополнительныеПараметры.Вставить("ВремяНачалаЗамера", 		Дата('00010101') + (ЭлементЗамера.Начало - НачалоДня(ЭлементЗамера.Начало)));
	ДополнительныеПараметры.Вставить("ВремяОкончанияЗамера",  	Дата('00010101') + (ЭлементЗамера.Конец  - НачалоДня(ЭлементЗамера.Начало)));
	ДополнительныеПараметры.Вставить("ИДЗамера",				ЭлементЗамера.Значение.ИДЗамера);
	ДополнительныеПараметры.Вставить("ЭтоВыезд", 				ЭлементЗамера.Значение.ЭтоВыезд);	
	ДополнительныеПараметры.Вставить("ИсполнительЗамера", 		ЭлементЗамера.ЗначенияИзмерений["Сотрудник"]);	
	
	//Если ВариантОтображенияГрафика = 0 ИЛИ ВариантОтображенияГрафика = 1 Тогда
	Если НЕ ПроверитьСвободныйИнтервалЗамеров(ДополнительныеПараметры, Объект.Ссылка) Тогда		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Выбранный интервал занят", , , , ОтменаРедактирования);
		//#9710 обновляем график
		ОбновитьГрафикЗамеров();
		Возврат;
	КонецЕсли;
	//КонецЕсли;
			
	//ОтменаРедактирования = НЕ РезультатПланировщикПриОкончанииРедактированияНаСервере(ИдТекущегоЗамераВыезда);
	
	Если ПланированиеВыезда Тогда
		ИзменитьДанныеТекущегоВыезда(ДополнительныеПараметры.ИсполнительЗамера, ЭлементЗамера.Начало, ЭлементЗамера.Конец, ДополнительныеПараметры.ДатаЗамера);
	ИначеЕсли ПланированиеЗамера Тогда	
		ИзменитьДанныеТекущегоЗамера(ДополнительныеПараметры.ИсполнительЗамера, ЭлементЗамера.Начало, ЭлементЗамера.Конец, ДополнительныеПараметры.ДатаЗамера);
	КонецЕсли;
	
	Модифицированность = Истина;
	
	//#9710 обновляем график всегда
	//Если ВариантОтображенияГрафика = 3 ИЛИ ВариантОтображенияГрафика = 4 Тогда
		ОбновитьГрафикЗамеров();
	//КонецЕсли;
	
КонецПроцедуры

