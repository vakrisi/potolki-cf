&НаСервере
Процедура ОбновитьЭлементыФормыНаСервере() Экспорт
	
	КоличествоОтмененныхЗамеров = 0;
	Для Каждого ТекЗамер Из Объект.Замеры Цикл
		Если ТекЗамер.РезультатЗамера = ПредопределенноеЗначение("Справочник.РезультатЗамераЛида.ЗамерОтменен")
			ИЛИ ТекЗамер.РезультатЗамера = ПредопределенноеЗначение("Справочник.РезультатЗамераЛида.ЗамерНеПроизводился")
			Тогда
			КоличествоОтмененныхЗамеров = КоличествоОтмененныхЗамеров + 1;
		КонецЕсли;
	КонецЦикла;	
	Элементы.ГруппаЗамерВыезд.Видимость = (Объект.Замеры.Количество() + Объект.Выезды.Количество() > 0); //#8012 (Объект.Замеры.Количество() - КоличествоОтмененныхЗамеров > 0);
	//Элементы.ГруппаВыезд.Видимость = Объект.Выезды.Количество() > 0;
	Элементы.ДекорацияИсторияЗамеров.Видимость = (Объект.Замеры.Количество() + Объект.Выезды.Количество() > 1);
	//Элементы.ГруппаКартыЯндекс.Видимость = ИспользоватьКартыЯндекс И Элементы.ГруппаЗамер.Видимость;
	Элементы.ГруппаКартыЯндекс.Видимость = ИспользоватьКартыЯндекс;
	
	Элементы.ГрафикТаблица.Видимость = (ВариантОтображенияГрафика = 2);
	Элементы.ГрафикЗамеров.Видимость = НЕ (ВариантОтображенияГрафика = 2);
	Если (ВариантОтображенияГрафика = 3 ИЛИ ВариантОтображенияГрафика = 4) 
		И Элементы.ДекорацияПустойПланЗамерщиков.Видимость Тогда
		Элементы.ГрафикЗамеров.Видимость = Ложь;
	КонецЕсли;
	
	//#8012 закомментировано
	//Элементы.ГрафикВыездовТаблица.Видимость = (ВариантОтображенияГрафика = 2);
	//Элементы.ГрафикВыездов.Видимость = НЕ (ВариантОтображенияГрафика = 2);
	
	//#6588 закомментировано
	//Если Объект.Замеры.Количество() > 0 Тогда
	//	НомерЗамера = Объект.Замеры.Количество()-1;
	//	ИсполнительЗамера = Объект.Замеры[НомерЗамера].ИсполнительЗамера;
	//	ДатаЗамера = Объект.Замеры[НомерЗамера].ДатаЗамера;
	//	ВремяНачалаЗамера = Объект.Замеры[НомерЗамера].ВремяНачалаЗамера;
