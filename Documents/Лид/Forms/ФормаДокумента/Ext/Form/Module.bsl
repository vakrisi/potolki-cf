&НаКлиенте
Процедура Перезвонить(Команда)
	
	//#5081
	Если ПоследнийЗамерПустой() Тогда		
		// Удаляем последний пустой замер
		УдалитьПоследнийЗамер();
		//ЗаполнитьВыборДанныхЗамераВыезда(); // №8012 обновим список выбора  // обновляется при УдалитьПоследнийЗамер
		ОбновитьЭлементыФормы();
		мСтраница = Элементы.ГруппаСтраницыОсновные.ТекущаяСтраница.Имя;
		Модифицированность = Истина;
	КонецЕсли;	
	
	//#10183 При нажатии на кнопку "? Отложенный замер" если текущий статус = "Отложенный договор", 
	// то после заполнения причины, даты и времени следующего звонка так же менять и статус лида на "Отложенный замер".
	//СтатусПерехода = ?(Объект.ТекущийСтатус = ПредопределенноеЗначение("Справочник.СтатусыЛида.ОтложенныйЗаключитьДоговор"), 
	//					ПредопределенноеЗначение("Справочник.СтатусыЛида.ОтложенныйЗаключитьДоговор"), 
	//					ПредопределенноеЗначение("Справочник.СтатусыЛида.ОтложенныйНазначитьЗамер"));
	СтатусПерехода = ПредопределенноеЗначение("Справочник.СтатусыЛида.ОтложенныйНазначитьЗамер");
		
	Если НЕ РазрешенПереводСтатуса(Объект.ТекущийСтатус, СтатусПерехода) Тогда 
		Сообщить("Перевод статуса лида не предусмотрен настройками программы!");
		Возврат;
	КонецЕсли;
	
	ЕстьНевыполненныеЗамеры = Ложь;
	Для Каждого ТекущаяСтрока Из Объект.Замеры Цикл
		// смотрим на РезультатЗамера, как при отмене замера в ПерезвонитьЗавершение
		//Если НЕ ТекущаяСтрока.ЗамерВыполнен Тогда
		Если НЕ ЗначениеЗаполнено(ТекущаяСтрока.РезультатЗамера) Тогда
			ЕстьНевыполненныеЗамеры = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	ЕстьНевыполненныеВыезды = Ложь;
	Для Каждого ТекущаяСтрока Из Объект.Выезды Цикл
		Если НЕ ЗначениеЗаполнено(ТекущаяСтрока.Результат) Тогда
			ЕстьНевыполненныеВыезды = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ЕстьНевыполненныеЗамеры", ЕстьНевыполненныеЗамеры);
	ПараметрыФормы.Вставить("ЕстьНевыполненныеВыезды", ЕстьНевыполненныеВыезды); //#14649
	ПараметрыФормы.Вставить("ТекущийСтатус", Объект.ТекущийСтатус); //#8113
	ПараметрыФормы.Вставить("СтатусПерехода", Строка(СтатусПерехода)); //#8113
	//#11632 реквизит ПоследнееВремяПерезвонить удален
	//ПараметрыФормы.Вставить("ДатаСледующегоКонтакта", СокрЛП(Формат(Объект.ПоследняяДатаПерезвонить, "ДФ=dd.MM.yyyy") + " " + Формат(Объект.ПоследнееВремяПерезвонить, "ДФ=HH:mm"))); //№9558
	ПараметрыФормы.Вставить("ДатаСледующегоКонтакта", СокрЛП(Формат(Объект.ПоследняяДатаПерезвонить, "ДФ='dd.MM.yyyy HH:mm'"))); //№9558
	Оповещение = Новый ОписаниеОповещения("ПерезвонитьЗавершение", ЭтаФорма);
	ОткрытьФорму("Документ.Лид.Форма.ПланированиеПовторногоКонтакта", ПараметрыФормы, ЭтаФорма, , , , Оповещение);
	
КонецПроцедуры

&НаКлиенте
Процедура ПерезвонитьЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Модифицированность = Истина;

	СтруктураОтвета = Результат;
	
	НоваяСтрока = Объект.ПовторныеКонтакты.Добавить();
	НоваяСтрока.Причина = СтруктураОтвета.Причина;
	НоваяСтрока.Дата = СтруктураОтвета.Дата;
	//НоваяСтрока.Время = СтруктураОтвета.Время;
	НоваяСтрока.Комментарий = СтруктураОтвета.Комментарий;
	
	//#10183 При нажатии на кнопку "? Отложенный замер" если текущий статус = "Отложенный договор", 
	// то после заполнения причины, даты и времени следующего звонка так же менять и статус лида на "Отложенный замер".
	//Если Объект.ТекущийСтатус = ПредопределенноеЗначение("Справочник.СтатусыЛида.ОтложенныйЗаключитьДоговор") Тогда
	//Иначе
		Объект.ТекущийСтатус = ПредопределенноеЗначение("Справочник.СтатусыЛида.ОтложенныйНазначитьЗамер");
		УправлениеЭлементамиФормыПоСтатусу();
	//КонецЕсли;
	
	//ДобавитьЗаписьВИсторию("Запланирован повторный звонок. " + Формат(НоваяСтрока.Дата, "ДЛФ=Д") + " " + Формат(НоваяСтрока.Время, "ДЛФ=В") + ". Причина: " + СтруктураОтвета.Причина + ?(ПустаяСтрока(НоваяСтрока.Комментарий),"",".Комментарий: " + НоваяСтрока.Комментарий));
	ДобавитьЗаписьВИсториюКлиент("Запланирован повторный звонок. " + Формат(НоваяСтрока.Дата, "ДФ='dd.MM.yyyy HH:mm'") + ". Причина: " + СтруктураОтвета.Причина + ?(ПустаяСтрока(НоваяСтрока.Комментарий),"",".Комментарий: " + НоваяСтрока.Комментарий));
		
	Объект.ПричинаПерезвонить = СтруктураОтвета.Причина;
	Объект.ПоследнийКомментарий = СтруктураОтвета.Комментарий;
	Объект.ПоследняяДатаПерезвонить = СтруктураОтвета.Дата;
	//#11632 реквизит ПоследнееВремяПерезвонить удален
	//Объект.ПоследнееВремяПерезвонить = СтруктураОтвета.Время;
	
	//сбросим данные последнего замера, т.к. надо перезванивать, а не замерять
	Объект.ПоследняяДатаЗамера = Дата(1,1,1);
	Объект.ПоследнийИсполнительЗамера  = ПредопределенноеЗначение("Справочник.Сотрудники.ПустаяСсылка");
	Объект.ПоследнийНазначилЗамер = ПредопределенноеЗначение("Справочник.Сотрудники.ПустаяСсылка");
	Объект.ПоследнийДатаНазначилиЗамер = Дата(1,1,1);
	
	// отменяем замеры, если они есть и не выполнены
	НомерЗамера = Объект.Замеры.Количество()-1;
	Пока НомерЗамера >= 0 Цикл
		СтрокаЗамера = Объект.Замеры[НомерЗамера];		
		//#10986 смотрим на РезультатЗамера
		//Если НЕ СтрокаЗамера.ЗамерВыполнен И НЕ СтрокаЗамера.РезультатЗамера = ПредопределенноеЗначение("Справочник.РезультатЗамераЛида.ЗамерОтменен") Тогда
		Если НЕ ЗначениеЗаполнено(СтрокаЗамера.РезультатЗамера) Тогда
			ДобавитьЗаписьВИсториюКлиент("Автоматически отменен замер Дата: " + Формат(СтрокаЗамера.ДатаЗамера,"ДЛФ=Д") + " " + Формат(СтрокаЗамера.ВремяНачалаЗамера,"ДЛФ=В") + ". Исполнитель: " + СтрокаЗамера.ИсполнительЗамера);
			Объект.Замеры[НомерЗамера].РезультатЗамера = ПредопределенноеЗначение("Справочник.РезультатЗамераЛида.ЗамерОтменен");
		КонецЕсли;
		НомерЗамера = НомерЗамера - 1;
	КонецЦикла;
	
	//++ №14649 Отменяем выезды без результата
	Для Каждого ТекущаяСтрока Из Объект.Выезды Цикл		
		Если НЕ ЗначениеЗаполнено(ТекущаяСтрока.Результат) Тогда			
			ДобавитьЗаписьВИсториюКлиент(СтрШаблон("Автоматически отменен выезд Дата: %1 %2. Исполнитель: %3", Формат(ТекущаяСтрока.Дата, "ДЛФ=Д"), Формат(ТекущаяСтрока.ВремяНачала, "ДЛФ=В"), ТекущаяСтрока.Исполнитель));
			ТекущаяСтрока.Результат = ПредопределенноеЗначение("Справочник.РезультатыВыездаЛида.ВыездОтменен");		
		КонецЕсли;		
	КонецЦикла;
	//-- №14649
	
КонецПроцедуры

&НаКлиенте
Процедура НазначитьЗамер(Команда)
		
	// #14649
	Если Элементы.ГруппаСтраницыОсновные.ТекущаяСтраница = Элементы.ГруппаЗамерВыезд Тогда
		Если ПланированиеЗамера Тогда
			Возврат;
		ИначеЕсли ПланированиеВыезда И ПоследнийВыездПустой() Тогда
			СтруктураПараметров = новый Структура("СценарийНазначенияЗамера", Истина); // №14649
			ОписаниеОповещения = Новый ОписаниеОповещения("ПослеВопросаОПродолженииНазначенияВыездаЗеркально", ЭтотОбъект, СтруктураПараметров);
			ПоказатьВопрос(ОписаниеОповещения, "Выезд не будет сохранен, назначить замер?", РежимДиалогаВопрос.ДаНет);		
			Возврат;			
		КонецЕсли;
	КонецЕсли;
	
	//#6305
	//Если НЕ ДоступноСозданиеЗамераПоСтатусуЛида() Тогда 
	//	Сообщить("Статус лида не предполагает создание замеров");
	//	Возврат;
	//КонецЕсли;	
	Если НЕ РазрешенПереводСтатуса(Объект.ТекущийСтатус, ПредопределенноеЗначение("Справочник.СтатусыЛида.ЗаполнитьДанныеЗамера")) Тогда 
		Сообщить("Перевод статуса лида не предусмотрен настройками программы!");
		Возврат;
	КонецЕсли;
	
	Если ПоследнийЗамерПустой() Тогда		
		ПоказатьВопрос(Новый ОписаниеОповещения("ПослеВопросаОПродолженииНазначенияЗамера", ЭтотОбъект), "Текущий замер не назначен, продолжить назначение замера?", РежимДиалогаВопрос.ДаНет);		
		Возврат;	
	КонецЕсли;
	
	Если ПоследнийВыездПустой() Тогда
		СтруктураПараметров = новый Структура("СценарийНазначенияЗамера", Истина); // №14649
		ПоказатьВопрос(Новый ОписаниеОповещения("ПослеВопросаОПродолженииНазначенияВыезда", ЭтотОбъект, СтруктураПараметров), "Текущий выезд не назначен, продолжить назначение выезда?", РежимДиалогаВопрос.ДаНет);		
		Возврат;	
	КонецЕсли;
	
	Если ЕстьЗамерИОнНеВыполнен() Тогда
		ОтветНаВопросОСозданииНовогоЗамера = Новый ОписаниеОповещения("ОтветНаВопросОоИзмененииЗамера",ЭтаФорма);
		ПоказатьВопрос(ОтветНаВопросОСозданииНовогоЗамера, "У лида уже имеется запланированный замер. Изменить его?", РежимДиалогаВопрос.ДаНет);
	//++ №14649 если есть не выполненный замер, также предагаем его изменить
	ИначеЕсли ЕстьВыездИОнНеВыполнен() Тогда
		ОП = Новый ОписаниеОповещения("ОтветНаВопросОИзмененииВыезда", ЭтотОбъект);
		ПоказатьВопрос(ОП, "У лида имеется запланированный выезд. Изменить его?", РежимДиалогаВопрос.ДаНет);
	//-- №14649
	ИначеЕсли ЕстьЗамерИОнВыполнен() Тогда
		Если НЕ ЗапретитьСоздаватьНовыйЗамерПоЛидуЕслиУжеЕстьВыполненныйЗамер() Тогда
			ОтветНаВопросОСозданииНовогоЗамера = Новый ОписаниеОповещения("ОтветНаВопросОСозданииНовогоЗамера",ЭтаФорма);
			ПоказатьВопрос(ОтветНаВопросОСозданииНовогоЗамера, "У лида уже имеется выполненный замер. Создать новый?", РежимДиалогаВопрос.ДаНет);
		Иначе
			ПоказатьПредупреждение(,"Запрещено создавать новый замер, если предыдущий замер уже был выполнен");
			Возврат;
		КонецЕсли;
	Иначе
		НазначитьЗамерЗавершение();
	КонецЕсли;
	
КонецПроцедуры

