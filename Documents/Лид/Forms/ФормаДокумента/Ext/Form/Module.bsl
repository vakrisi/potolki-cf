#Область ВкладкаЗадачи

&НаСервере
Процедура ПолучитьЗадачиЛида()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Задачи.Ссылка,
		|	Задачи.Дата,
		|	Задачи.Исполнитель,
		|	Задачи.Наименование КАК Заголовок,
		|	Задачи.СрокИсполнения,
		|	Задачи.ДатаИсполнения
		|ИЗ
		|	Задача.Задачи КАК Задачи
		|ГДЕ
		|	ТИПЗНАЧЕНИЯ(Задачи.ПредметЗадачи) = ТИП(Документ.Лид)
		|	И Задачи.ПредметЗадачи = &Ссылка
		|
		|УПОРЯДОЧИТЬ ПО
		|	Задачи.Дата";
	
	Запрос.УстановитьПараметр("Ссылка", Объект.Ссылка);			
	Результат = Запрос.Выполнить();
	
	ЗадачиЛида.Очистить();
	ЗадачиЛида.Загрузить(Результат.Выгрузить());
	Элементы.ГруппаЗадачи.Заголовок = "Задачи" + ?(ЗадачиЛида.Количество() > 0, " (" + Строка(ЗадачиЛида.Количество()) + ")", "") ;
	
	// невыполненные задачи
	Если ЗадачиЛида.Количество() > 0 Тогда
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Задачи.Ссылка
		|ИЗ
		|	Задача.Задачи КАК Задачи
		|ГДЕ
		|	ТИПЗНАЧЕНИЯ(Задачи.ПредметЗадачи) = ТИП(Документ.Лид)
		|	И Задачи.ПредметЗадачи = &Ссылка
		|	И Задачи.ДатаИсполнения = ДАТАВРЕМЯ(1, 1, 1)";	
		Запрос.УстановитьПараметр("Ссылка", Объект.Ссылка);			
		Результат = Запрос.Выполнить();
		Если НЕ Результат.Пустой() Тогда
			Элементы.ГруппаЗадачи.Заголовок = Элементы.ГруппаЗадачи.Заголовок + " *";
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

