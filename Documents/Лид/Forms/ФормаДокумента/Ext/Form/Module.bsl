		ДобавитьЗаписьВИсториюКлиент("Указана дата следующего контакта: " + Формат(Объект.ПоследняяДатаПерезвонить, "ДФ='dd.MM.yyyy HH:mm'") + "." + ?(ЗначениеЗаполнено(Результат.Комментарий), " Комментарий: " + Результат.Комментарий, ""));
		
		Модифицированность = Истина;
		
	КонецЕсли;
	
КонецПроцедуры

