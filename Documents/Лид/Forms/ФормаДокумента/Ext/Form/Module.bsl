&НаСервереБезКонтекста
Функция ПроверитьНаличиеЛидаВРаботеПоТелефонам(ТелефоныКлиента, СсылкаНаТекущийЛид)
	
	СтруктураРезультата = Новый Структура("Ссылка, НомерТелефона");
	
	СтатусыЛидовВРаботе = Новый СписокЗначений;
	СтатусыЛидовВРаботе.Добавить(Справочники.СтатусыЛида.ЗаполнитьДанныеЗамера);
	СтатусыЛидовВРаботе.Добавить(Справочники.СтатусыЛида.НазначитьЗамер);
	СтатусыЛидовВРаботе.Добавить(Справочники.СтатусыЛида.ОтложенныйЗаключитьДоговор);
	СтатусыЛидовВРаботе.Добавить(Справочники.СтатусыЛида.ОтложенныйНазначитьЗамер);
	СтатусыЛидовВРаботе.Добавить(Справочники.СтатусыЛида.ОформитьДоговор);
	
	//ищем по номеру телефона клиента. Если нашли - возвращаем ссылку на него
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТекущийСтатус", 	 СтатусыЛидовВРаботе);
	Запрос.УстановитьПараметр("СсылкаНаЛид", 	 СсылкаНаТекущийЛид);
	Запрос.УстановитьПараметр("ТелефоныКлиента", ТелефоныКлиента);
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	Лид.Ссылка КАК Ссылка,
	|	ЛидКИ.Представление КАК НомерТелефона
	|ИЗ
	|	Документ.Лид КАК Лид
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Лид.ДополнительнаяКонтактнаяИнформация КАК ЛидКИ
	|		ПО (ЛидКИ.Ссылка = Лид.Ссылка)
	|ГДЕ
	|	Лид.ТекущийСтатус В(&ТекущийСтатус)
	|	И ЛидКИ.Представление В(&ТелефоныКлиента)
	|	И ЛидКИ.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Телефон)";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(СтруктураРезультата, Выборка);
	КонецЕсли;
		
	Возврат СтруктураРезультата;
	
КонецФункции

&НаСервере
Процедура СоздатьЭлектронноеПисьмоЗамерщику(ТекущийОбъект)
	
	Если НЕ ТекущийОбъект.ПоследнийИсполнительЗамера = Справочники.Сотрудники.ПустаяСсылка() и Константы.ОтправлятьEmailЗамерщикуПриПланированииЗамера.Получить() Тогда
		ОсновнойEMailЗамерщика = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(ТекущийОбъект.ПоследнийИсполнительЗамера, Справочники.ВидыКонтактнойИнформации.EmailСотрудника);
		Если НЕ ПустаяСтрока(ОсновнойEMailЗамерщика) Тогда 
			//ПисьмоОтправленное = Документы.ЭлектронноеПисьмо.НайтиПоРеквизиту("Основание",Объект.Ссылка);
			//Если ПисьмоОтправленное = Документы.ЭлектронноеПисьмо.ПустаяСсылка() Тогда 
				ЗаголовокНовогоПисьма = "Запланирован замер. Клиент: " + ТекущийОбъект.ИмяКлиента + ", Адрес: " + ТекущийОбъект.Адрес;
				ТекстПисьма = "Вам назначен замер.
				| Клиент: " + ТекущийОбъект.ИмяКлиента + "
				//| Телефон: " + Объект.СотовыйТелефонКлиента + "
				| Адрес: " + ТекущийОбъект.Адрес + "
				| Дата замера: " + Формат(ТекущийОбъект.ПоследняяДатаЗамера,"ДЛФ=DD") + " в " + Формат(ТекущийОбъект.ПоследнееВремяНачалаЗамера,"ДФ=Ч:мм") + " ч.";
				
				УчетнаяЗаписьОтправителя = ОбщийМодульСервер.НастройкаПользователя("УчетнаяЗаписьЭлектроннойПочты");
				Если УчетнаяЗаписьОтправителя.Пустая() Тогда
					УчетнаяЗаписьОтправителя = Константы.УчетнаяЗаписьЭлектроннойПочтыДляАвтоматическихРассылок.Получить();
				КонецЕсли;
				НовоеПисьмо = РаботаСЭлектроннойПочтой.СформироватьЭлектронноеПисьмо(ЗаголовокНовогоПисьма, ТекущийОбъект.ПоследнийИсполнительЗамера, ТекстПисьма, ТекущийОбъект.Ссылка, , , УчетнаяЗаписьОтправителя);
				
				Документы.ЭлектронноеПисьмо.ОтправитьЭлектронноеПисьмо(НовоеПисьмо);
				ОтправитьУведомлениеЗамерщику = Ложь;
			//КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

