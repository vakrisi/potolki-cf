&НаСервере
Функция ЕстьВыездИОнНеВыполнен()
	
	Результат = Ложь;
	Если Объект.Выезды.Количество() > 0 Тогда
		НомерВыезда = Объект.Выезды.Количество()-1;
		//Если НЕ ПустаяСтрока(Объект.Выезды[НомерВыезда].Исполнитель) // условие пока убрано, в случае пула здесь пусто
		Если НЕ Объект.Выезды[НомерВыезда].Дата = Дата(1,1,1)
			И НЕ Объект.Выезды[НомерВыезда].Выполнен
			И НЕ ЗначениеЗаполнено(Объект.Выезды[НомерВыезда].Результат) // №14649
		Тогда
			Результат = Истина;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ЕстьВыездИОнВыполнен()
	
	Результат = Ложь;
	Если Объект.Выезды.Количество() > 0 Тогда
		НомерВыезда = Объект.Выезды.Количество()-1;
		Если НЕ ПустаяСтрока(Объект.Выезды[НомерВыезда].Исполнитель) И Не Объект.Выезды[НомерВыезда].Дата = Дата(1,1,1)
			И Объект.Выезды[НомерВыезда].Выполнен
			И ЗначениеЗаполнено(Объект.Выезды[НомерВыезда].Результат) // №14649
		Тогда
			Результат = Истина;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ИзменитьДанныеЗамера(Команда)
	
	ТекОбласть = Элементы.ГрафикТаблица.ТекущаяОбласть;
	Расшифровка = Элементы.ГрафикТаблица.ТекущаяОбласть.Расшифровка;
	Если Расшифровка = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТекОбласть.Верх <= ТекОбласть.Низ Тогда
		Расшифровка.ВремяОкончанияЗамера = Мин(ОбщийМодульКлиентСервер.СоединитьДатуИВремя(Расшифровка.ДатаЗамера, ВремяКонцаЗамеров),
											Расшифровка.ВремяНачалаЗамера + (ТекОбласть.Низ - ТекОбласть.Верх + 1) * (ПродолжительностьЗамера) * 3600);
	КонецЕсли;
	
	ДопПараметры = Новый Структура("Расшифровка", Расшифровка);
	Оповещение = Новый ОписаниеОповещения("ПослеВопросаОбИзмененииЗамера", ЭтаФорма, ДопПараметры);
	ПоказатьВопрос(Оповещение, "Изменить данные замера?", РежимДиалогаВопрос.ДаНет, 0);
	
КонецПроцедуры

