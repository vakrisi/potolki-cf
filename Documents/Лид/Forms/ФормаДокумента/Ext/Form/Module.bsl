&НаКлиенте
Процедура ОформитьЗаказДоговорПоВидуЗавершение(Результат, ДопПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда		
		
		СоответствиеВидов = новый Соответствие;
		СоответствиеВидов.Вставить(ПредопределенноеЗначение("Справочник.ВидыЗаказДоговоров.Продажа"), ПредопределенноеЗначение("Справочник.ВидыОбращенийЛида.Продажа"));
		СоответствиеВидов.Вставить(ПредопределенноеЗначение("Справочник.ВидыЗаказДоговоров.Рекламация"), ПредопределенноеЗначение("Справочник.ВидыОбращенийЛида.Рекламация"));
		СоответствиеВидов.Вставить(ПредопределенноеЗначение("Справочник.ВидыЗаказДоговоров.СервиснаяЗаявка"), ПредопределенноеЗначение("Справочник.ВидыОбращенийЛида.СервиснаяЗаявка"));
		
		ОжидаетсяВидОбращения = СоответствиеВидов.Получить(ДопПараметры);
		
		ПараметрыОснования = Новый Структура;
		ПараметрыОснования.Вставить("Основание", Объект.Ссылка);
		ПараметрыОснования.Вставить("ВидЗаказа", ДопПараметры);
		ПараметрыОснования.Вставить("Адрес", 	 ?(ПустаяСтрока(Объект.Город), Объект.Адрес, Строка(Объект.Город) + ", " + Объект.Адрес)); // #16886 
		ПараметрыНовогоДокумента = Новый Структура("ЗначенияЗаполнения", ПараметрыОснования);
		
		ОткрытьФорму("Документ.ЗаказДоговор.ФормаОбъекта", ПараметрыНовогоДокумента);
		//заполнение в ОбработкаОповещения
		
	КонецЕсли;
	
КонецПроцедуры

