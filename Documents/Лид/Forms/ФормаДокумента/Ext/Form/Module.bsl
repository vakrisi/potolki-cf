&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	// №6435 проверка на заполненность замера, если пустой нужно задать вопрос о дальнейшем действии
	Если ПоследнийЗамерПустой() Тогда
		Отказ = Истина;
		ТекстВопроса = "Текущий замер не назначен, продолжить назначение замера?
			|При нажатии ""Да"" будет продолжен ввод замера на графике
			|При нажатии ""Нет"" не назначенный замер будет очищен.";
		ПоказатьВопрос(новый ОписаниеОповещения("ПослеВопросаОПродолженииНазначенияЗамера", ЭтотОбъект), ТекстВопроса, РежимДиалогаВопрос.ДаНет);
		Возврат;
	КонецЕсли;
	// #6798 аналогично для выездов
	Если ПоследнийВыездПустой() Тогда
		Отказ = Истина;
		ТекстВопроса = "Текущий выезд не назначен, продолжить назначение выезда?
			|При нажатии ""Да"" будет продолжен ввод выезда на графике
			|При нажатии ""Нет"" не назначенный выезд будет очищен.";
		ПоказатьВопрос(новый ОписаниеОповещения("ПослеВопросаОПродолженииНазначенияВыезда", ЭтотОбъект), ТекстВопроса, РежимДиалогаВопрос.ДаНет);
		Возврат;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Объект.Ссылка)
		И КонстантыКонтролироватьСозданиеЛидовПоНомеруКлиента() 
		И НЕ Объект.ТекущийСтатус = ПредопределенноеЗначение("Справочник.СтатусыЛида.Отказ") Тогда
			
