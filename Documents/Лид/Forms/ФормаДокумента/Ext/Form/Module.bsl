&НаСервере
Процедура ЗаполнитьДополнительныеСвойства()
	
	//#9756
	ТаблицаДанных = Объект.ДополнительныеСвойстваЛида.Выгрузить();
	МассивСсылок  = ТаблицаДанных.ВыгрузитьКолонку("Свойство");
			
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("МассивСсылок", МассивСсылок);
	Запрос.УстановитьПараметр("ТаблицаДанных", ТаблицаДанных);
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТаблицаДанных.Свойство КАК Свойство,
	|	ТаблицаДанных.Значение КАК Значение
	|ПОМЕСТИТЬ ВТ_Таблица
	|ИЗ
	|	&ТаблицаДанных КАК ТаблицаДанных
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВТ_Таблица.Свойство КАК Свойство,
	|	ВТ_Таблица.Значение КАК Значение
	|ПОМЕСТИТЬ ВТ_Свойства
	|ИЗ
	|	ВТ_Таблица КАК ВТ_Таблица
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВидыДополнительныхСвойствЛида.Ссылка,
	|	""""
	|ИЗ
	|	Справочник.ВидыДополнительныхСвойствЛида КАК ВидыДополнительныхСвойствЛида
	|ГДЕ
	|	НЕ ВидыДополнительныхСвойствЛида.ПометкаУдаления
	|	И НЕ ВидыДополнительныхСвойствЛида.Ссылка В (&МассивСсылок)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВТ_Свойства.Свойство КАК Свойство,
	|	ВТ_Свойства.Значение КАК Значение
	|ИЗ
	|	ВТ_Свойства КАК ВТ_Свойства
	|
	|УПОРЯДОЧИТЬ ПО
	|	Свойство
	|АВТОУПОРЯДОЧИВАНИЕ";
	
	ТаблицаДополнительныхСвойствЛида.Загрузить(Запрос.Выполнить().Выгрузить());
	
КонецПроцедуры

&НаКлиенте
Процедура ПеренестиДополнительныеСвойстваВТабличнуюЧасть()
	
	Объект.ДополнительныеСвойстваЛида.Очистить();
	Для каждого СтрокаТЗ из ТаблицаДополнительныхСвойствЛида Цикл
		Если ЗначениеЗаполнено(СтрокаТЗ.Значение) Тогда	
			НоваяСтрока = Объект.ДополнительныеСвойстваЛида.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТЗ);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура АдресВыездаОтличаетсяОтАдресаЛидаПриИзменении(Элемент)
	
	Объект.АдресВыезда = Объект.Адрес;
	Объект.ГородВыезда = Объект.Город;
	
	//++ №14051 город в выезде может отличаться
	ПолучитьИдентификаторГородаНаселенногоПунктаВыезда();
	//-- №14051
	
	ОбновитьВидимостьЭлементовЗаезды();
	
КонецПроцедуры

&НаКлиенте
Процедура ГородВыездаПриИзменении(Элемент)
	
	//++ №14051 город в выезде может отличаться
	ПолучитьИдентификаторГородаНаселенногоПунктаВыезда();
	//-- №14051
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьВидимостьЭлементовЗаезды()
	
	Элементы.ГруппаАдресВыезда.Видимость = Объект.АдресВыездаОтличаетсяОтАдресаЛида;
	Элементы.ГруппаАдресВыездаИзЛида.Видимость = НЕ Объект.АдресВыездаОтличаетсяОтАдресаЛида;
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаДополнительныхСвойствЛидаПередУдалением(Элемент, Отказ)
	Отказ = Истина;
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаДополнительныхСвойствЛидаПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	Отказ = Истина;
КонецПроцедуры

&НаКлиенте
Процедура УказатьГеометку(Команда)
	
	ОП = Новый ОписаниеОповещения("ПослеЗакрытияОкнаВыбораГеометки", ЭтотОбъект);
	
	Парам = Новый Структура;
	Парам.Вставить("Город",Объект.Город);
	Парам.Вставить("Адрес",Объект.Адрес);
	Парам.Вставить("ИспользоватьКартыЯндекс",ИспользоватьКартыЯндекс);
	Парам.Вставить("Геометка",Объект.Геометка);
	
	ОткрытьФорму("Документ.Лид.Форма.ФормаУстановкиГеометки", Парам, ЭтаФорма,,,,ОП, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияОкнаВыбораГеометки(ПолученнаяГеометка, ДопПараметры) Экспорт
	
	Если НЕ ПолученнаяГеометка = Неопределено Тогда
		Объект.Геометка = ПолученнаяГеометка;
		Модифицированность = Истина;
	КонецЕсли;
	
	ОбновитьКратинкуКнопкиГеометкиВШапкеДокумента();
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьКратинкуКнопкиГеометкиВШапкеДокумента()
	
	Если ПустаяСтрока(Объект.Геометка) Тогда
		Элементы.УказатьГеометку.Картинка = БиблиотекаКартинок.СераяМеткаКарты;
		Элементы.УказатьГеометкуСтраницаЗамера.Картинка = БиблиотекаКартинок.СераяМеткаКарты;
	Иначе
		Элементы.УказатьГеометку.Картинка = БиблиотекаКартинок.КраснаяМеткаКарты;
		Элементы.УказатьГеометкуСтраницаЗамера.Картинка = БиблиотекаКартинок.КраснаяМеткаКарты;
	КонецЕсли;
	
	Если ПустаяСтрока(Объект.ГеометкаВыезда) Тогда
		Элементы.УказатьГеометкуВыезда.Картинка = БиблиотекаКартинок.СераяМеткаКарты;
	Иначе
		Элементы.УказатьГеометкуВыезда.Картинка = БиблиотекаКартинок.КраснаяМеткаКарты;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УказатьГеометкуВыезда(Команда)
	
	ОП = Новый ОписаниеОповещения("ПослеЗакрытияОкнаВыбораГеометкиВыезда", ЭтотОбъект);
	
	Парам = Новый Структура;
	Парам.Вставить("Город",Объект.ГородВыезда);
	Парам.Вставить("Адрес",Объект.АдресВыезда);
	Парам.Вставить("ИспользоватьКартыЯндекс",ИспользоватьКартыЯндекс);
	Парам.Вставить("Геометка",Объект.ГеометкаВыезда);
	
	ОткрытьФорму("Документ.Лид.Форма.ФормаУстановкиГеометки", Парам, ЭтаФорма,,,,ОП, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияОкнаВыбораГеометкиВыезда(ПолученнаяГеометка, ДопПараметры) Экспорт
	
	Если НЕ ПолученнаяГеометка = Неопределено Тогда
		Объект.ГеометкаВыезда = ПолученнаяГеометка;
		Модифицированность = Истина;
	КонецЕсли;
	
	ОбновитьКратинкуКнопкиГеометкиВШапкеДокумента();
	
КонецПроцедуры

//++ #15368 от 27.01.2023
Процедура ВывестиСписокДоговоров()
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЗаказДоговор.Ссылка,
	|	ЗаказДоговор.Номер КАК Номер
	|ИЗ
	|	Документ.ЗаказДоговор КАК ЗаказДоговор
	|ГДЕ
	|	ЗаказДоговор.Проведен
	|	И ЗаказДоговор.Основание = &Основание
	|	И НЕ ЗаказДоговор.ДоговорРассторгнут";
	Запрос.УстановитьПараметр("Основание",Объект.Ссылка);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Количество() > 0 Тогда
		Пока Выборка.Следующий() Цикл
			НайденныйЭлемент = Элементы.Найти("Договор"+Выборка.Номер);
			Если НайденныйЭлемент = Неопределено Тогда
				ИмяЭлемента = "Договор" + СтрЗаменить(Выборка.Номер, "-", "");
				Элемент = ЭтаФорма.Элементы.Добавить(ИмяЭлемента, Тип("ДекорацияФормы"), ЭтаФорма.Элементы.ГруппаДоговора);
				СтрокаКоманды = ПолучитьНавигационнуюСсылку(Выборка.Ссылка);
				СтрокаСсылкиНаДокумент = Лев(Строка(Выборка.Ссылка), СтрНайти(Строка(Выборка.Ссылка), " ", НаправлениеПоиска.СКонца));
				Элемент.Заголовок = Новый ФорматированнаяСтрока(СтрокаСсылкиНаДокумент,,,,СтрокаКоманды);
			КонецЕсли;
		КонецЦикла;
		Элементы.ДекорацияДоговора.Видимость = Ложь;
	КонецЕсли;
КонецПроцедуры;	

