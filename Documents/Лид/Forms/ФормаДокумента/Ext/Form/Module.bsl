&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "ЗагазДоговорНеСоздан" Тогда 
		
		ПоказатьПредупреждение(,"Заказ-договор не создан, статус лида не изменен");
		
	ИначеЕсли ИмяСобытия = "ЗаказДоговорСоздан" Тогда 		
		
		Если Параметр = Объект.Номер 
			И НЕ Объект.ТекущийСтатус = ПредопределенноеЗначение("Справочник.СтатусыЛида.Обращение") // #16346
			Тогда
			ПослеОформленияЗаказДоговора();
			ПараметрыЗаписи = Новый Структура;
			ПараметрыЗаписи.Вставить("РежимЗаписиДокумента",РежимЗаписиДокумента.Проведение);
			ЭтаФорма.Записать();
		КонецЕсли;
		
	//ИначеЕсли ИмяСобытия = "ЗакрытаФормаМонтажа" Тогда  // #16242 заменено на ЗД
	ИначеЕсли ИмяСобытия = "ЗакрытаФормаЗаказДоговора" Тогда
	
		Если ЗначениеЗаполнено(ОжидаетсяВидОбращения)
			И Параметр = Объект.Ссылка 
			И ТипЗнч(Источник) = Тип("Структура") Тогда
			
			ДобавитьЗаписьВИсториюКлиент("Создан заказ-договор (" + Источник.Вид + ") №" + Источник.Номер + " от " + Источник.Дата);			
			
			ВидОбращения = ОжидаетсяВидОбращения; 
			ЗакрытьОбращениеЗавершение(ВидОбращения);
			
			ОжидаетсяВидОбращения = ПредопределенноеЗначение("Справочник.ВидыОбращенийЛида.ПустаяСсылка");
			
		КонецЕсли;
		
	//ИначеЕсли ИмяСобытия = "ЗакрытаФормаСервиснойЗаявки" Тогда 
	//	
	//	Если ТипЗнч(Параметр) = Тип("Структура") Тогда
	//		Если Параметр.Основание = Объект.Ссылка Тогда
	//			Если НЕ Параметр.Ссылка.Пустая() Тогда
	//				Объект.ТекущийСтатус = ПредопределенноеЗначение("Справочник.СтатусыЛида.НеЦелевой");
	//				ДобавитьЗаписьВИсторию("Оформлена сервисная заявка " + Параметр.Ссылка);
	//				ЭтаФорма.Записать();
	//			КонецЕсли;
	//		КонецЕсли;
	//	КонецЕсли;
		
	ИначеЕсли ИмяСобытия = "ЗадачаПоЛидуСоздана" Тогда
		
		Если Параметр = Объект.Номер Тогда
			ДобавитьЗаписьВИсториюКлиент("Назначена задача");
			ЭтаФорма.Записать();
		КонецЕсли;
		
	ИначеЕсли ИмяСобытия = "СозданПредварительныйРасчет" И Параметр = Объект.Ссылка Тогда
		
		ПроверитьНазначитьНовыйПредварительныйРасчетОсновным();
		
	ИначеЕсли ИмяСобытия = "Запись_Города" И (Источник = Объект.Город ИЛИ Источник = Объект.ГородВыезда) Тогда
		
		ПолучитьИдентификаторГородаНаселенногоПункта();
		ПолучитьИдентификаторГородаНаселенногоПунктаВыезда();		
		ПроверитьНаличиеДанныхВКлассификатореАдресов();

	КонецЕсли;
	
	// СтандартныеПодсистемы.Свойства 
	Если УправлениеСвойствамиКлиент.ОбрабатыватьОповещения(ЭтотОбъект, ИмяСобытия, Параметр) Тогда
		ОбновитьЭлементыДополнительныхРеквизитов();
		УправлениеСвойствамиКлиент.ПослеЗагрузкиДополнительныхРеквизитов(ЭтотОбъект);
	КонецЕсли;
	// Конец СтандартныеПодсистемы.Свойства
	
КонецПроцедуры

