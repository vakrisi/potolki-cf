			Объект.РекламныйИсточник = РеквизитыРА.РекламныйИсточник;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьРеквизитыРекламнойАкции()
	
	РеквизитыРА = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект.РекламнаяАкция, 
																	"Организация, Подразделение, Город,
																	|РекламныйИсточник"); //, ОчищатьРанееУстановленныеРеквизитыВЛидеПриУстановкеНовыхЗначений");		
	Если ЗначениеЗаполнено(РеквизитыРА.Подразделение) И НЕ Константы.ИспользоватьПодразделения.Получить() Тогда
		РеквизитыРА.Подразделение = Справочники.Подразделения.ПустаяСсылка();	
	КонецЕсли;
	
	Возврат РеквизитыРА;

КонецФункции

