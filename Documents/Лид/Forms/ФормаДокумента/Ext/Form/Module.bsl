&НаКлиенте
Функция ДобавитьНовыйЗамер()
	
	НоваяСтрока = Объект.Замеры.Добавить();		
	НоваяСтрока.ДатаЗамера = ТекущаяДата();
	НоваяСтрока.Портал_id = ОбщийМодуль.ПолучитьТекущееUnixTime();
	НоваяСтрока.ИДЗамера = Новый УникальныйИдентификатор;
	НоваяСтрока.ЭтоНовый = Истина;

	ТекущаяСтрокаЗамеров = НоваяСтрока.ПолучитьИдентификатор(); //#6588
	Элементы.Замеры.ТекущаяСтрока = ТекущаяСтрокаЗамеров; //#6588
	ТекущийРезультатЗамера = ПредопределенноеЗначение("Справочник.РезультатЗамераЛида.ПустаяСсылка");
	ЗаполнитьВыборДанныхЗамераВыезда(ТекущаяСтрокаЗамеров, 1); // №8012

	Возврат НоваяСтрока;
	
КонецФункции

&НаКлиенте
Функция ДобавитьНовыйВыезд()
	
	НоваяСтрока = Объект.Выезды.Добавить();		
	НоваяСтрока.Дата = ТекущаяДата();
	НоваяСтрока.ИДЗамера = Новый УникальныйИдентификатор;
	НоваяСтрока.ЭтоНовый = Истина;
	
	ТекущаяСтрокаВыездов = НоваяСтрока.ПолучитьИдентификатор(); //#6588
	Элементы.Выезды.ТекущаяСтрока = ТекущаяСтрокаВыездов; //#6588
	ТекущийРезультатВыезда = ПредопределенноеЗначение("Справочник.РезультатыВыездаЛида.ПустаяСсылка"); // №14649 было: ТекущийРезультатВыезда = Ложь;
	
	ЗаполнитьВыборДанныхЗамераВыезда(ТекущаяСтрокаВыездов, 2); // №8012

	Возврат НоваяСтрока;
	
КонецФункции

