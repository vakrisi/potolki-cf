&НаСервере
Процедура ОбновитьГрафикЗамеровТаблицаНаСервере(ДатаНачалаГрафика, ДатаОкончанияГрафика)
	
	//НаСтраницеВыезд = (Элементы.ГруппаСтраницыОсновные.ТекущаяСтраница = Элементы.ГруппаВыезд);
	//НаСтраницеЗамер = (Элементы.ГруппаСтраницыОсновные.ТекущаяСтраница = Элементы.ГруппаЗамерВыезд);
	
	//Если ПредыдущаяДатаЗамера = Дата(1,1,1) 
	//	//#6706 для перестроения графика при измении даты замера
	//	ИЛИ ДатаНачалаГрафика > ПредыдущаяДатаЗамера 
	//	Тогда
	//	//ДатаНачалаГрафика = ДатаЗамера;
	//Иначе
	//	ДатаНачалаГрафика = ПредыдущаяДатаЗамера;
	//КонецЕсли;
	//
	//Если НаСтраницеВыезд Тогда
	//	Если ПредыдущаяДатаВыезда = Дата(1,1,1) ИЛИ ДатаВыезда > ПредыдущаяДатаВыезда Тогда
	//		ДатаНачалаГрафика = ДатаВыезда;
	//	Иначе
	//		ДатаНачалаГрафика = ПредыдущаяДатаВыезда;
	//	КонецЕсли;
	//КонецЕсли;
	//ДатаОкончанияГрафика = ДатаНачалаГрафика + ИнтервалГрафикаТаблица;
	
	ЗаданнаяТаблицаГрафикЗамеров = ТаблицаГрафикЗамеров.Выгрузить();
	Колво = ЗаданнаяТаблицаГрафикЗамеров.Количество();
	Для Инд = 1 по ЗаданнаяТаблицаГрафикЗамеров.Количество() Цикл
		ЭлементЗамера = ЗаданнаяТаблицаГрафикЗамеров[Колво-Инд];
		Если ЭлементЗамера.Дата = Дата(1,1,1) Тогда
			 ЗаданнаяТаблицаГрафикЗамеров.Удалить(ЭлементЗамера);
			 Продолжить;
		 КонецЕсли;
		//ЭлементЗамера.ВремяНачала    = Дата("00010101") + (ЭлементЗамера.ВремяНачала - НачалоДня(ЭлементЗамера.ВремяНачала));
		//ЭлементЗамера.ВремяОкончания = Дата("00010101") + (ЭлементЗамера.ВремяОкончания - НачалоДня(ЭлементЗамера.ВремяОкончания));			
	КонецЦикла;
	
	СтруктураИзЛида = Новый Структура("НаСтраницеВыезд, НаСтраницеЗамер", ПланированиеВыезда, ПланированиеЗамера);
			
	ГрафикТаблица = МодульОтчетов.СформироватьГрафикЗамеровТаблица(ДатаНачалаГрафика, ДатаОкончанияГрафика, ФильтрТочкаПродаж, ФильтрПодразделение, ЗаданнаяТаблицаГрафикЗамеров, СтруктураИзЛида);
		
