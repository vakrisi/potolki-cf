&НаКлиенте
Процедура Подключаемый_ДополнительнаяКонтактнаяИнформацияПриИзменении(Элемент)
	
	УправлениеКонтактнойИнформациейКлиентПотолки.ПриИзменении(ЭтотОбъект, Элемент);
	
	НайденныеСтроки = ЭтотОбъект.ДополнительнаяКонтактнаяИнформацияОписаниеРеквизитов.НайтиСтроки(Новый Структура("ИмяРеквизита", Элемент.Имя));
	Если НайденныеСтроки.Количество() > 0 Тогда
		Если НайденныеСтроки[0].Тип = ПредопределенноеЗначение("Перечисление.ТипыКонтактнойИнформации.Телефон") Тогда
			Если НЕ ПустаяСтрока(НайденныеСтроки[0].Представление) Тогда
				НайденныеСтроки[0].Представление = СофтФон.ПолучитьНомерТелефонаВМеждународномФОрматеПользователя(Элемент.ТекстРедактирования);
				ЭтотОбъект[НайденныеСтроки[0].ИмяРеквизита] = НайденныеСтроки[0].Представление;
			Иначе
				НайденныеСтроки[0].Представление = СофтФон.ПолучитьТелефонныйКодСтраныПользователя();
				ЭтотОбъект[НайденныеСтроки[0].ИмяРеквизита] = НайденныеСтроки[0].Представление;
			КонецЕсли;
			Если ПравилоПоискаИсторииОбращений.ПоТелефону Тогда
				ПолучитьИсториюОбращенияКлиента();
			КонецЕсли;
		
		ИначеЕсли НайденныеСтроки[0].Тип = ПредопределенноеЗначение("Перечисление.ТипыКонтактнойИнформации.АдресЭлектроннойПочты") Тогда
			Если ПравилоПоискаИсторииОбращений.ПоАдресуЭлектроннойПочты Тогда
				ПолучитьИсториюОбращенияКлиента();
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	ОбновитьДатуИзмененияДанныхКлиента();
	
КонецПроцедуры

