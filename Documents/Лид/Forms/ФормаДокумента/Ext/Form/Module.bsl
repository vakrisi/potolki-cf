&НаСервере
Функция ПолучитьМассивЗамеровВыездов()
	
	// Выгружаем замеры
	Временная_ТЗ = Объект.Замеры.Выгрузить();
	Временная_ТЗ.Колонки.Добавить("ЭтоВыезд", новый ОписаниеТипов("Булево"));
	Временная_ТЗ.Колонки.Добавить("ИДСтроки", новый ОписаниеТипов("Число"));
	
	//++ №14649 делаем общую колонку с результатом
	МассивТипов = новый Массив;
	МассивТипов.Добавить("СправочникСсылка.РезультатЗамераЛида");
	МассивТипов.Добавить("СправочникСсылка.РезультатыВыездаЛида");
	
	Временная_ТЗ.Колонки.Добавить("Результат", новый ОписаниеТипов(МассивТипов));
	//-- №14649
	
	// Нумеруем сами, т.к. при вставке новой строки, исходный номер строки 0
	Сч = 1;
	Для Каждого ТекущаяСтрока Из Временная_ТЗ Цикл
		
		ТекущаяСтрока.ИсходныйНомерСтроки = Сч;
		ТекущаяСтрока.Результат = ТекущаяСтрока.РезультатЗамера; // №14649
		
		Сч = Сч + 1;
		
	КонецЦикла;
	
	// Добавляем выезды
	Сч = 1;
	Для Каждого ТекущаяСтрока Из Объект.Выезды Цикл
		
		НоваяСтрока = Временная_ТЗ.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущаяСтрока);
		
		НоваяСтрока.ДатаЗамера = ТекущаяСтрока.Дата;
		НоваяСтрока.ВремяНачалаЗамера = ТекущаяСтрока.ВремяНачала;
		НоваяСтрока.ВремяОкончанияЗамера = ТекущаяСтрока.ВремяОкончания;
		НоваяСтрока.ИсполнительЗамера = ТекущаяСтрока.Исполнитель;
		НоваяСтрока.ЗамерВыполнен = ТекущаяСтрока.Выполнен;
		НоваяСтрока.ИсходныйНомерСтроки = Сч;
		НоваяСтрока.ЭтоВыезд = Истина;
		НоваяСтрока.Результат = ТекущаяСтрока.Результат; // №14649
		
		Сч = Сч + 1;
		
	КонецЦикла;
	
	// Сортируем
	Временная_ТЗ.Сортировать("ДатаЗамера, ВремяНачалаЗамера, ЭтоВыезд");
	
	Возврат ОбщегоНазначения.ТаблицаЗначенийВМассив(Временная_ТЗ);
	
КонецФункции

&НаКлиенте
Процедура ЗаполнитьИдентификаторыЗамеровВыездов(МассивЗамеровВыездов)
	
	Для Каждого ТекущаяСтрока Из МассивЗамеровВыездов Цикл
		
		ИмяТЧ = "Замеры";
		Если ТекущаяСтрока.ЭтоВыезд Тогда
			ИмяТЧ = "Выезды";
		КонецЕсли;
		
		НайденныеСтроки = Объект[ИмяТЧ].НайтиСтроки(новый Структура("ИДЗамера", ТекущаяСтрока.ИДЗамера));
		Если НайденныеСтроки.Количество() > 0 Тогда
			
			ТекущаяСтрока.ИДСтроки = НайденныеСтроки[0].ПолучитьИдентификатор();
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ТекущийЗамерВыездПриИзменении(Элемент)
	
	ДанныеЗамераВыезда = СоответствиеЗамеровВыездов.Получить(ТекущийЗамерВыезд);
	
	//++ №8781 если ни замера ни выезда нет, будет неопределено, дальше не идём
	Если ДанныеЗамераВыезда = Неопределено Тогда
		Возврат;
	КонецЕсли;
	//-- №8781
	
	Если ДанныеЗамераВыезда.ЗамерВыезд = 1 Тогда
		ПланированиеЗамера = Истина;
		ПланированиеВыезда = Ложь;
		
		Элементы.Замеры.ТекущаяСтрока = ДанныеЗамераВыезда.ИД;
		ТекущаяСтрокаЗамеров = ДанныеЗамераВыезда.ИД;
		ТекущийРезультатЗамера = Элементы.Замеры.ТекущиеДанные.РезультатЗамера;
		УправлениеЭлементамиФормыПоРезультатуЗамера();
		
	ИначеЕсли ДанныеЗамераВыезда.ЗамерВыезд = 2 Тогда
		ПланированиеЗамера = Ложь;
		ПланированиеВыезда = Истина;
		
		Элементы.Выезды.ТекущаяСтрока = ДанныеЗамераВыезда.ИД;
		ТекущаяСтрокаВыездов = ДанныеЗамераВыезда.ИД;	
		ТекущийРезультатВыезда = Элементы.Выезды.ТекущиеДанные.Результат; // №14649 было: Элементы.Выезды.ТекущиеДанные.Выполнен;
		УправлениеЭлементамиФормыПоРезультатуВыезда();

	КонецЕсли;
	
	УправлениеЭлементамиГруппыЗамерВыезд();
	
	ПолучитьПервоначальныеДанныеДляГрафикаЗамеров();
	ОбновитьГрафикЗамеров();
	
КонецПроцедуры

