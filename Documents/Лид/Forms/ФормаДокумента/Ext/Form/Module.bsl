&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	// СтандартныеПодсистемы.Свойства
    УправлениеСвойствамиКлиент.ПослеЗагрузкиДополнительныхРеквизитов(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.Свойства
	
	Если ПараметрыСеансаТелефонияСтрана().Пустая() Тогда
		Сообщить("В настройках программы не задана страна (раздел ""Общие"") работа с лидами не доступна");
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	//++ №10184 перенесено в документ ПредварительныйРасчетЗаказДоговора	
	//мИспользоватьАвтоматическиеСкидки = ПолучитьЗначениеКонстантыАвтоматическихСкидок();
	//-- №10184 перенесено в документ ПредварительныйРасчетЗаказДоговора
	
	ОбновитьЭлементыФормы();

	//#5596	
	//Если ИзмененМенеджер Тогда
	//	ПоказатьОповещениеПользователя("Изменен менеджер", , "Изменен менеджер документа на сотрудника текущего пользователя");
	//	Модифицированность = Истина;
	//КонецЕсли;
	ОбщийМодульКлиент.ОбработатьИзменениеМенеджера(ЭтаФорма);
	
	//#6588 позиционируемся на последней строке
	Если Объект.Выезды.Количество() > 0 Тогда
		
		НомерВыезда = Объект.Выезды.Количество()-1;
		ТекущаяСтрокаВыездов = Объект.Выезды[НомерВыезда].ПолучитьИдентификатор();
		Элементы.Выезды.ТекущаяСтрока = ТекущаяСтрокаВыездов;
		
		ТекущийРезультатВыезда = Объект.Выезды[НомерВыезда].Результат; // №14649
		
		ПланированиеВыездов = Истина;
		
	КонецЕсли;
	Если Объект.Замеры.Количество() > 0 Тогда
		НомерЗамера = Объект.Замеры.Количество()-1;
		ТекущаяСтрокаЗамеров = Объект.Замеры[НомерЗамера].ПолучитьИдентификатор();
		Элементы.Замеры.ТекущаяСтрока = ТекущаяСтрокаЗамеров;
		
		ИсполнительЗамера = Объект.Замеры[НомерЗамера].ИсполнительЗамера;
		ДатаЗамера = Объект.Замеры[НомерЗамера].ДатаЗамера;
		ВремяНачалаЗамера = Объект.Замеры[НомерЗамера].ВремяНачалаЗамера;
		ВремяОкончанияЗамера = Объект.Замеры[НомерЗамера].ВремяОкончанияЗамера;
		ТекущийРезультатЗамера = Объект.Замеры[НомерЗамера].РезультатЗамера;
		
		ПланированиеЗамеров = Истина;
		ПланированиеВыездов = Ложь;
	КонецЕсли;
	Если Объект.Замеры.Количество() + Объект.Выезды.Количество() > 0 Тогда
		ЗаполнитьВыборДанныхЗамераВыезда();
		ТекущийЗамерВыездПриИзменении(Неопределено);
	КонецЕсли;
	
	// №9853
	ОбновитьВидимостьЭлементовЗаезды();
	
	// №16055
	ПодключитьОбработчикОжидания("ПриОткрытииОбработчикОжидания", 0.3, Истина);
	//ПолучитьИсториюОбращенияКлиента();
	
КонецПроцедуры

