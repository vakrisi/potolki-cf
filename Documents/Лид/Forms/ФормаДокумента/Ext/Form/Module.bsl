КонецПроцедуры

&НаКлиенте
Процедура ОбработчикОжиданияФайлыПриАктивизацииСтроки()
	
	ТекущиеДанные = Элементы.ФайлыДерево.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено Тогда
		Если НЕ ТекущиеДанные.ПолучитьРодителя() = Неопределено Тогда			
			АдресФайла = ОбщийМодульВызовСервера.ПолучитьДанныеФайла(ТекущиеДанные.Документ, ТекущиеДанные.ИмяФайла, ТекущиеДанные.Номенклатура, ЭтотОбъект.УникальныйИдентификатор);	
			ОбщийМодульКлиент.ПредпросмотрФайла(АдресФайла, ТекущиеДанные.Расширение, Предпросмотр, Элементы.Предпросмотр);
		Иначе
			Элементы.Предпросмотр.Вид = ВидПоляФормы.ПолеHTMLДокумента;
			Предпросмотр = "";
		КонецЕсли;
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьФайл(Команда)
	
	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
		ПоказатьПредупреждение(, "Документ не сохранен!");
		Возврат;
	КонецЕсли;
	
	//СписокСсылок = ПолучитьСписокПотолков()
	СписокСсылок = Новый СписокЗначений;
	ДополнитьСписокСсылокНаФайлы(СписокСсылок);
	Если СписокСсылок.Количество() > 0 Тогда
		Оп = Новый ОписаниеОповещения("ПослеВыбораСсылкиДляПрикрепленияФайла", ЭтотОбъект);
		ПоказатьВыборИзМеню(Оп, СписокСсылок, Элементы.ФайлыДобавитьФайл);		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораСсылкиДляПрикрепленияФайла(ВыбранныйЭлемент, ДополнительныеПараметры) Экспорт
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ПослеПрикрепленияФайлаЗавершение", ЭтотОбъект);
	ДопПараметры = Новый Структура("ДействиеПослеПрикрепления", ОписаниеОповещения);
	ОбщийМодульКлиент.ПослеВыбораСсылкиДляПрикрепленияФайла(ВыбранныйЭлемент.Значение, ДопПараметры);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеПрикрепленияФайлаЗавершение(СтруктураРезультата, ДополнительныеПараметры) Экспорт
	
	Если СтруктураРезультата.Результат Тогда
		ОбновитьЭлементыФормы();
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ПечататьФайл(Команда)
	
	ВыбранныеЭлементы = Элементы.ФайлыДерево.ВыделенныеСтроки;	
	
	Если ВыбранныеЭлементы.Количество() > 0 Тогда
		Для каждого ЭлементДляПечати из ВыбранныеЭлементы Цикл
			СтрФайл = ФайлыДерево.НайтиПоИдентификатору(ЭлементДляПечати);
			
			// если выделен корень дерева, то пропускаем
			Если СтрФайл.ПолучитьРодителя() = Неопределено Тогда
				Продолжить;
			КонецЕсли;

			АдресФайла = ОбщийМодульВызовСервера.ПолучитьДанныеФайла(СтрФайл.Документ, СтрФайл.ИмяФайла, СтрФайл.Номенклатура, ЭтотОбъект.УникальныйИдентификатор);
			
			Если НЕ АдресФайла = Неопределено Тогда // №7253
				ВременноеИмя = ПолучитьИмяВременногоФайла(СтрФайл.Расширение);
				ПолучитьФайл(АдресФайла, ВременноеИмя, Ложь);
				
				Shell = Новый COMОбъект("Shell.Application");
				Shell.ShellExecute(ВременноеИмя, "", "", "print", 0);
			КонецЕсли;
		КонецЦикла;
	Иначе
		ПоказатьПредупреждение(,"Выберите файл(ы) в списке");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаОбновитьСписокФайлов(Команда)
	
	//Запомним текущую строку
	ТекущиеДанные = Элементы.ФайлыДерево.ТекущиеДанные;
	
	ОбновитьСписокФайлов();
	
	ИдТекущейСтроки = Неопределено;
	КоллекцияЭлементовДерева = ЭтаФорма.ФайлыДерево.ПолучитьЭлементы();
	Для Каждого Строка Из КоллекцияЭлементовДерева Цикл    
		ИдентификаторСтроки = Строка.ПолучитьИдентификатор();
		Для Каждого ПодчиненнаяСтрока Из Строка.ПолучитьЭлементы() Цикл
			Если ТекущиеДанные <> Неопределено И ПодчиненнаяСтрока.Документ = ТекущиеДанные.Документ И ПодчиненнаяСтрока.Номенклатура = ТекущиеДанные.Номенклатура И ПодчиненнаяСтрока.ИмяФайла = ТекущиеДанные.ИмяФайла Тогда
				ИдТекущейСтроки = ПодчиненнаяСтрока.ПолучитьИдентификатор();
			КонецЕсли;
		КонецЦикла;
		Если ИдТекущейСтроки = Неопределено Тогда
			ИдТекущейСтроки = ИдентификаторСтроки;			
		КонецЕсли;
		Элементы.ФайлыДерево.Развернуть(ИдентификаторСтроки, Истина);
	КонецЦикла;
	Элементы.ФайлыДерево.ТекущаяСтрока = ИдТекущейСтроки;
	
КонецПроцедуры

