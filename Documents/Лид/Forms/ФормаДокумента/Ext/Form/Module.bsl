&НаКлиенте
Процедура ВыбратьАдрес(Команда)
		
	СуффиксРеквизита = ?(Команда.Имя = "ВыбратьАдресВыезда", "Выезда", "");
	ДополнительныеПараметры = Новый Структура("СуффиксРеквизита", СуффиксРеквизита);

	Если НЕ ЗначениеЗаполнено(ИдентификаторНаселенногоПункта) Тогда
		ПредставлениеАдресаЛида = Объект["Адрес" + СуффиксРеквизита];			
	Иначе
		ПредставлениеАдресаЛида = ПредставлениеАдресаЛида(Объект["Город" + СуффиксРеквизита], Объект["Адрес" + СуффиксРеквизита]);
	КонецЕсли;
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ОбработкаВыбораАдресаФИАС", ЭтотОбъект, ДополнительныеПараметры);
	ПараметрыАдреса = Новый Структура;
	ПараметрыАдреса.Вставить("Представление", ПредставлениеАдресаЛида);
	ПараметрыАдреса.Вставить("ОткрытаПоСценарию", Истина);
	ПараметрыАдреса.Вставить("ВидКонтактнойИнформации", Новый Структура("ПроверятьКорректность", Ложь));

	ОткрытьФорму("Обработка.РасширенныйВводКонтактнойИнформации.Форма.ВводАдреса",ПараметрыАдреса,ЭтаФорма,,,,ОписаниеОповещения);
	Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбораАдресаФИАС(ЗначениеВыбора, ДополнительныеПараметры) Экспорт

	Если ЗначениеВыбора = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СуффиксРеквизита = ДополнительныеПараметры.СуффиксРеквизита;
	
	Если ЗначениеВыбора.ВведеноВСвободнойФорме Тогда 
		Объект["Адрес" + СуффиксРеквизита] = ЗначениеВыбора.Представление;
	ИначеЕсли НЕ ЗначениеЗаполнено(ИдентификаторНаселенногоПункта) Тогда
		Объект["Адрес" + СуффиксРеквизита] = ОбщийМодульКлиентСервер.УбратьИндексВАдресе(ЗначениеВыбора.Представление);
		ОБъект["Город" + СуффиксРеквизита] = ПредопределенноеЗначение("Справочник.Города.ПустаяСсылка");
	Иначе
		ОбработкаВыбораАдресаИзКлассификатораСервер(ЗначениеВыбора.Значение, 
													Объект["Город" + СуффиксРеквизита], Объект["Адрес" + СуффиксРеквизита], ЭтотОбъект["ИдентификаторНаселенногоПункта" + СуффиксРеквизита]);
	КонецЕсли;
	
	ОбработкаСобытияАдресПриИзменении(Объект["Адрес" + СуффиксРеквизита]);
	
КонецПроцедуры

