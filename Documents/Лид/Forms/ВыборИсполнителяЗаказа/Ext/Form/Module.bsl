
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Для Каждого ЭлементМассива Из Параметры.СписокЗамеровДляОформления Цикл
		
		НоваяСтрока = ТаблицаИсполнителей.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ЭлементМассива);
		
	КонецЦикла;
	
	ТаблицаИсполнителей.Сортировать("ДатаЗамера");
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьВыборИсполнителя()
	
	ТекущиеДанные = Элементы.ТаблицаИсполнителей.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Закрыть(новый Структура("Исполнитель, ИдентификаторЗамера", ТекущиеДанные.ИсполнительЗамера, ТекущиеДанные.ИдентификаторЗамера));
			
КонецПроцедуры

&НаКлиенте
Процедура ОК(Команда)
	
	ОбработатьВыборИсполнителя();
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаИсполнителейВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)	
	
	ОбработатьВыборИсполнителя();
	
КонецПроцедуры

