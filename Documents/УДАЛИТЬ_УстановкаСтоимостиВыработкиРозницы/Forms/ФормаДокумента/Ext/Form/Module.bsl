&НаСервере
Процедура ЗаполнитьНоменклатуруПоГруппе(ГруппаНоменклатуры)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Номенклатура.Ссылка
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	Номенклатура.Ссылка В ИЕРАРХИИ(&ГруппаНоменклатура)
	|	И Номенклатура.ЭтоГруппа = Ложь";
	Запрос.УстановитьПараметр("ГруппаНоменклатура",ГруппаНоменклатуры);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = Объект.СтоимостьВыработки.Добавить();
		НоваяСтрока.Номенклатура = Выборка.Ссылка;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаДобавитьГруппуНоменклатуры(Команда)
	
    ФормаНоменклатура = ПолучитьФорму("Справочник.Номенклатура.ФормаВыбора", );
	ФормаНоменклатура.Элементы.Список.ВыборГруппИЭлементов = ИспользованиеГруппИЭлементов.ГруппыИЭлементы;
    ВыбраннаяНоменклатура = ФормаНоменклатура.ОткрытьМодально();
	Если ВыбраннаяНоменклатура <> Неопределено Тогда
		Если Объект.СтоимостьВыработки.Количество() > 0 Тогда
			Если Вопрос("Табличная часть не пустая. Очистить?",РежимДиалогаВопрос.ДаНет) = КодВозвратаДиалога.Да Тогда
				Объект.СтоимостьВыработки.Очистить();
			КонецЕсли;
		КонецЕсли;
		ЗаполнитьНоменклатуруПоГруппе(ВыбраннаяНоменклатура);
	КонецЕсли;
	
	
	
КонецПроцедуры

&НаСервере
Процедура КомандаУстановитьСтоимостьВыработкиНаСервере(НоваяСтоимость)
	Для Каждого ТекущаяСтрока Из Объект.СтоимостьВыработки Цикл
		ТекущаяСтрока.Стоимость = НоваяСтоимость;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура КомандаУстановитьСтоимостьВыработки(Команда)
	НоваяСтоимость = 0;
	ВвестиЗначение(НоваяСтоимость,"Введите стоимость", Новый ОписаниеТипов("число"));
	
	КомандаУстановитьСтоимостьВыработкиНаСервере(НоваяСтоимость);
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если Параметры.Ключ.Пустая() Тогда
		ОбщийМодуль.ЗаполнитьШапкуДокумента(Объект);
	Иначе
		ЭтаФорма.ТолькоПросмотр = ПраваПользователей.ДокументТолькоПросмотр(Объект.Ссылка);
	КонецЕсли;
	
	Элементы.СтоимостьВыработкиСтоимость.Заголовок = "Цена, " + Константы.ВалютаУчета.Получить().Наименование;
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	ДатыЗапретаИзменения.ОбъектПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
КонецПроцедуры

&НаСервере
Процедура ОбновитьЭлементыФормы()
	
	Элементы.ДекорацияВалютаУчета.Заголовок = "" + Константы.ВалютаУчета.Получить() + " за базовую ед.изм.";
	Элементы.СтоимостьВыработкиПотолка.Доступность = Объект.УстановитьСтоимостьВыработкиПотолка;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьСтоимостьВыработкиПотолкаПриИзменении(Элемент)
	ОбновитьЭлементыФормы();
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ОбновитьЭлементыФормы();
КонецПроцедуры
