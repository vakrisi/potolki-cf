&НаКлиенте
Функция ДобавитьНоменклатуруВДеревоТоваровКлиент(Номенклатура, Количество = 1, ИдКомнаты)
	
	СтрокаКомнаты = ДеревоТоваров.НайтиПоИдентификатору(ИдКомнаты);	
	СтрокиНоменклатуры = СтрокаКомнаты.ПолучитьЭлементы();
			
	СтрокаТабличнойЧасти = СтрокиНоменклатуры.Добавить();
	СтрокаТабличнойЧасти.Уровень = 1;
	СтрокаТабличнойЧасти.ИспользоватьВТекущемМонтаже = Истина;
	СтрокаТабличнойЧасти.Номенклатура = Номенклатура;
	СтрокаТабличнойЧасти.Комната = СтрокаКомнаты.Комната;
	
	//СтруктураДанные = Новый Структура("Номенклатура, ХарактеристикаНоменклатуры, Количество, ВидСкидки, ВидСпецификации", 
	//								СтрокаТабличнойЧасти.Номенклатура, СтрокаТабличнойЧасти.ХарактеристикаНоменклатуры, Количество, 
	//								Объект.ВидСкидки, ПредопределенноеЗначение("Перечисление.ВидыСпецификации.СопутствующиеМатериалы"));
									
	СтрокаТабличнойЧасти.Количество = Количество;
	СтруктураДанные = СтруктураДанныхПоСтрокеТабличнойЧасти(СтрокаТабличнойЧасти);
	
	СтруктураДанные = ОбщийМодульВызовСервера.ПолучитьДанныеНоменклатурыПриИзменении(СтруктураДанные);	
	ЗаполнитьЗначенияСвойств(СтрокаТабличнойЧасти, СтруктураДанные, "ЕдиницаИзмерения, Коэффициент, Количество, ВидНоменклатуры, Спецификация");
	
	СтруктураДанные = ПолучитьДанныеНоменклатурыПриИзменении(СтруктураДанные);
	ЗаполнитьЗначенияСвойств(СтрокаТабличнойЧасти, СтруктураДанные, "Цена, ЦенаПоПрайсу, ПроцентСкидки, СтавкаНДС, Количество"); //#16345 добавлено Количество 
	
	//СтрокаТабличнойЧасти.УИСтроки = Новый УникальныйИдентификатор;
	
	РассчитатьСуммуСтрокиДереваТоваров(СтрокаТабличнойЧасти);
	
	Элементы.ДеревоТоваров.ТекущаяСтрока = СтрокаТабличнойЧасти.ПолучитьИдентификатор();
	
	Возврат СтрокаТабличнойЧасти;
	
КонецФункции

&НаСервере
Функция ПолучитьДанныеНоменклатурыПриИзменении(СтруктураДанные)
	
	СтруктураДанные.Вставить("Цена", ПолучитьЦенуНоменклатуры(СтруктураДанные.Номенклатура, СтруктураДанные.ХарактеристикаНоменклатуры, СтруктураДанные.ЕдиницаИзмерения));
	СтруктураДанные.Вставить("ПроцентСкидки", ПолучитьПроцентВидаСкидки(СтруктураДанные.ВидСкидки));
	СтруктураДанные.Вставить("ЦенаПоПрайсу", СтруктураДанные.Цена);
	СтруктураДанные.Вставить("СтавкаНДС", ?(УчитыватьНДС, СтавкаНДСПоУмолчанию, Перечисления.СтавкиНДС.ПустаяСсылка()));
	
	Если СтруктураДанные.ИспользоватьКонтрольКратности 
		И НЕ ОбщийМодульСервер.НастройкаПользователя("РазрешитьНесоответствиеКратностиЕдиницИзмерения") Тогда
		
		СтруктураПоиска = Новый Структура("ВидДокумента, ЕдиницаИзмерения", Перечисления.ВидыДокументовПроверкиКратности.РеализацияКлиенту, СтруктураДанные.ЕдиницаИзмерения);
		НайденныеСтроки = СтруктураДанные.Номенклатура.Кратность.НайтиСтроки(СтруктураПоиска);
		Если НайденныеСтроки.Количество() > 0 Тогда		
			СтруктураДанные.Вставить("Количество", 0); //#16345
		Иначе
			СтруктураДанные.Вставить("Количество", СтруктураДанные.Количество);
		КонецЕсли;
	Иначе
		СтруктураДанные.Вставить("Количество", СтруктураДанные.Количество);
	КонецЕсли;
	
	Возврат СтруктураДанные;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьПроцентВидаСкидки(ВидСкидки)
	Если ВидСкидки.Пустая() Тогда
		Возврат 0;
	Иначе
		Возврат ВидСкидки.Процент;
	КонецЕсли;
КонецФункции

&НаКлиенте
Процедура РассчитатьСуммуСтрокиДереваТоваров(ТекущаяСтрока, НеПересчитыватьСуммуРучнойСкидки = Ложь)
	
	Если ТекущаяСтрока = Неопределено Тогда
		ТекущаяСтрока = Элементы.ДеревоТоваров.ТекущиеДанные;
	КонецЕсли;
	
	Если ТекущаяСтрока.ПроцентСкидки = 100 Тогда
		ТекущаяСтрока.Сумма = 0;
		Если НЕ НеПересчитыватьСуммуРучнойСкидки Тогда
			ТекущаяСтрока.СуммаСкидки = ТекущаяСтрока.Количество * ТекущаяСтрока.Цена;
		КонецЕсли;
	Иначе
		Если НЕ ТекущаяСтрока.ПроцентСкидки = 0 Тогда
			ТекущаяСтрока.Сумма = ТекущаяСтрока.Количество * ТекущаяСтрока.Цена * (1 - ТекущаяСтрока.ПроцентСкидки / 100);
			Если НЕ НеПересчитыватьСуммуРучнойСкидки Тогда
				ТекущаяСтрока.СуммаСкидки = (ТекущаяСтрока.Количество * ТекущаяСтрока.Цена) - ТекущаяСтрока.Сумма;
			КонецЕсли;
		Иначе
			ТекущаяСтрока.Сумма = ТекущаяСтрока.Количество * ТекущаяСтрока.Цена;
			Если НЕ НеПересчитыватьСуммуРучнойСкидки Тогда
				ТекущаяСтрока.СуммаСкидки = 0;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
		
	ТекущаяСтрока.СуммаПоПрайсу = ТекущаяСтрока.ЦенаПоПрайсу * ТекущаяСтрока.Количество;	
	ОбработкаТабличныхЧастейКлиент.ПересчитатьСуммуНДСВСтрокеТЧ(ТекущаяСтрока, УчитыватьНДС);
	
КонецПроцедуры

&НаКлиенте
Процедура УдалитьСтрокуТовара(Команда)
	
	ТекущиеДанные = Элементы.ДеревоТоваров.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;	
	КонецЕсли;
	
	РодительСтроки = ТекущиеДанные.ПолучитьРодителя();
	Если РодительСтроки = Неопределено Тогда
		Если ТекущиеДанные.ПолучитьЭлементы().Количество() = 0 Тогда
			ДеревоТоваров.ПолучитьЭлементы().Удалить(ТекущиеДанные);
		КонецЕсли;
	Иначе
		// строка товаров
		РодительСтроки.ПолучитьЭлементы().Удалить(ТекущиеДанные);
	КонецЕсли;
	
	РассчитатьИтоговыеПоказателиКлиент(Истина);
		
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандМатериалы

&НаКлиенте
Процедура ДобавитьПотолок(Команда)
	
	ВДеревоМатериалов = (СтрНайти(Команда.Имя, "ВМатериалы") > 0);
	ВСписокМатериалов = (СтрНайти(Команда.Имя, "ВСписокМатериалов") > 0);
		
	Если ВДеревоМатериалов Тогда
		ТекущиеДанные = Элементы.ДеревоМатериалов.ТекущиеДанные;
	ИначеЕсли ВСписокМатериалов Тогда
		ТекущиеДанные = Элементы.Материалы.ТекущиеДанные;
	Иначе
		ТекущиеДанные = Элементы.ДеревоТоваров.ТекущиеДанные;
	КонецЕсли;
	
	Если НЕ ВСписокМатериалов Тогда 
		Если ТекущиеДанные = Неопределено  Тогда 
			ПоказатьОповещениеПользователя("Выберите комнату");
			Возврат;
		КонецЕсли;
		
		Если ПустаяСтрока(ТекущиеДанные.Комната) Тогда
			ПоказатьОповещениеПользователя("Выберите комнату");
			Возврат;
		КонецЕсли;
	КонецЕсли; 	
		
	НаименованиеПотолкаПоНомеруДоговора = НаименованиеПотолкаСодержитНомерДоговора();
	КоличествоПотолковВДокументе = 0;
	НомерДоговора = "";
	Если НаименованиеПотолкаПоНомеруДоговора Тогда
		Если ЗначениеЗаполнено(Объект.Основание) И ТипЗнч(Объект.Основание) = Тип("ДокументСсылка.ЗаказДоговор") Тогда 
			НомерДоговора = ПолучитьНомерДоговора(Объект.Основание);
			Если ПустаяСтрока(НомерДоговора) Тогда
				ПоказатьПредупреждение(,"Не заполнен номер договора в заказ-договоре.");
				Возврат;
			КонецЕсли;
		Иначе
			ПоказатьПредупреждение(,"Основанием не является заказ-договор. Порядок формирования наименования потолка содержит Номер договора из заказа.");
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	КоличествоПотолковВДокументе = ПолучитьКоличествоПотолковВДокументе();
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("ПоНомеруДоговора", НаименованиеПотолкаПоНомеруДоговора);
	СтруктураПараметров.Вставить("НомерДоговора", НомерДоговора);
	СтруктураПараметров.Вставить("КоличествоПотолковВДокументе", КоличествоПотолковВДокументе);
	
	ДополнительныеПараметры = Новый Структура("ВДеревоМатериалов, ВСписокМатериалов, ЭтоПотолок", ВДеревоМатериалов, ВСписокМатериалов, Истина);
	Оповещение = Новый ОписаниеОповещения("ПослеВводаДанныхПродукции", ЭтотОбъект, ДополнительныеПараметры);
	ОткрытьФорму("ОбщаяФорма.ФормаДобавленияПродукции", СтруктураПараметров, ЭтотОбъект,, ВариантОткрытияОкна.ОтдельноеОкно,, Оповещение, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьПродукцию(Команда)
	
	ВДеревоМатериалов = (СтрНайти(Команда.Имя, "ВМатериалы") > 0);
	ВСписокМатериалов = (СтрНайти(Команда.Имя, "ВСписокМатериалов") > 0);
		
	Если ВДеревоМатериалов Тогда
		ТекущиеДанные = Элементы.ДеревоМатериалов.ТекущиеДанные;
	ИначеЕсли ВСписокМатериалов Тогда
		ТекущиеДанные = Элементы.Материалы.ТекущиеДанные;
	Иначе
		ТекущиеДанные = Элементы.ДеревоТоваров.ТекущиеДанные;
	КонецЕсли;
	
	Если НЕ ВСписокМатериалов Тогда 
		Если ТекущиеДанные = Неопределено  Тогда 
			ПоказатьОповещениеПользователя("Выберите комнату");
			Возврат;
		КонецЕсли;
		
		Если ПустаяСтрока(ТекущиеДанные.Комната) Тогда
			ПоказатьОповещениеПользователя("Выберите комнату");
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура("ВДеревоМатериалов, ВСписокМатериалов, ЭтоПотолок", ВДеревоМатериалов, ВСписокМатериалов, Ложь);	
	ОписаниеОповещения = Новый ОписаниеОповещения("ПослеВводаДанныхПродукции", ЭтотОбъект, ДополнительныеПараметры);
	ОткрытьФорму("ОбщаяФорма.ФормаДобавленияПродукцииПоВиду", , ЭтотОбъект,,,, ОписаниеОповещения);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВводаДанныхПродукции(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Модифицированность = Истина;
	
	ВДеревоМатериалов = ДополнительныеПараметры.ВДеревоМатериалов;
	ВСписокМатериалов = ДополнительныеПараметры.ВСписокМатериалов;
	Если ВДеревоМатериалов Тогда
		ТекущиеДанные = Элементы.ДеревоМатериалов.ТекущиеДанные;
	ИначеЕсли ВСписокМатериалов Тогда
		ТекущиеДанные = Элементы.Материалы.ТекущиеДанные;
	Иначе
		ТекущиеДанные = Элементы.ДеревоТоваров.ТекущиеДанные;
	КонецЕсли;
	
	УИСтроки = Новый УникальныйИдентификатор;
	Результат.Вставить("УИСтроки", УИСтроки);
	ВидЗаказа = ПредопределенноеЗначение("Перечисление.ВидыЗаказов.Монтаж"); 
	
	Если ВДеревоМатериалов Тогда
		ТекущаяКомната = ТекущиеДанные.Комната;
		ДобавитьМатериалНаСервере(Результат.Номенклатура, ТекущаяКомната, Результат.Количество, Результат.УИСтроки);
		//#11670
		// №13814 Если ДополнительныеПараметры.ЭтоПотолок Тогда
			ОбщийМодульКлиент.РасширеннаяОбработкаДобавленнойПродукции(ЭтаФорма, ВидЗаказа, Истина, ТекущаяКомната, Результат, НЕ ДополнительныеПараметры.ЭтоПотолок);
		//КонецЕсли;
		ПеренестиДеревоВТабличнуюЧасть();
		
		РазвернутьДеревоМатериалов(ТекущаяКомната, Результат.Номенклатура);
		ОбновитьНадписьВкладкиМатериалы();
		ДобавленнаяСтрока = НайтиСтрокуДереваМатериалов(ТекущаяКомната, Результат.Номенклатура);
		Если НЕ ДобавленнаяСтрока = Неопределено Тогда
			Элементы.ДеревоМатериалов.ТекущаяСтрока = ДобавленнаяСтрока.ПолучитьИдентификатор();
		КонецЕсли;
		
	ИначеЕсли ВСписокМатериалов Тогда
		
		Стр = Объект.Материалы.Добавить();
		Стр.Номенклатура = Результат.Номенклатура;
		Стр.Комната = "";
		
		Стр.ЕдиницаИзмерения = ПолучитьБазовуюЕдиницуИзмеренияНоменклатуры(Стр.Номенклатура);
		Стр.Коэффициент = 1;
		Стр.Количество = Результат.Количество;
		
		Стр.УИСтроки = УИСтроки; //Новый УникальныйИдентификатор;
		
		Элементы.Материалы.ТекущаяСтрока = Стр.ПолучитьИдентификатор();
		
		//#11670
		// №13814 Если ДополнительныеПараметры.ЭтоПотолок Тогда
			ОбщийМодульКлиент.РасширеннаяОбработкаДобавленнойПродукции(ЭтаФорма, ВидЗаказа, Неопределено, "", Результат, НЕ ДополнительныеПараметры.ЭтоПотолок);
		//КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область РаботаСоСпецификациями

&НаКлиенте
Процедура ЗадатьВопросОбУдаленииМатериаловПоСпецификации(Номенклатура, УИСтроки)
	
	Если НЕ СтруктураДействийПоСпецификациям.АвтоматическиЗаполнятьМатериалы Тогда
		Возврат;
	КонецЕсли;
	
	Парам = Новый Структура;
	Парам.Вставить("Номенклатура", 	Номенклатура);
	Парам.Вставить("УИСтроки", 		УИСтроки);
	
	Если СтруктураДействийПоСпецификациям.ПодтверждениеПриУдалении Тогда			
		ПослеВопросаОбУдаленииМатериаловПоСпецификации = Новый ОписаниеОповещения("ОбработкаОтветаНаВопросУдаленияМатериаловПоСпецификации", ЭтотОбъект, Парам);
		ПоказатьВопрос(ПослеВопросаОбУдаленииМатериаловПоСпецификации, "Удалить материалы по спецификации текущей позиции?", РежимДиалогаВопрос.ДаНет);
	Иначе
		УдалитьМатериалыОтносящиесяКПозицииНаСервере(Номенклатура, УИСтроки);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОтветаНаВопросУдаленияМатериаловПоСпецификации(Результат, ДопПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		УдалитьМатериалыОтносящиесяКПозицииНаСервере(ДопПараметры.Номенклатура, ДопПараметры.УИСтроки);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗадатьВопросОбУдаленииМатериаловПоСпецификациям(МассивНоменклатур)
	
	Если НЕ СтруктураДействийПоСпецификациям.АвтоматическиЗаполнятьМатериалы Тогда
		Возврат;
	КонецЕсли;
		
	Если СтруктураДействийПоСпецификациям.ПодтверждениеПриУдалении Тогда			
		ПослеВопросаОбУдаленииМатериаловПоСпецификациям = Новый ОписаниеОповещения("ОбработкаОтветаНаВопросУдаленияМатериаловПоСпецификациям", ЭтотОбъект, МассивНоменклатур);
		ПоказатьВопрос(ПослеВопросаОбУдаленииМатериаловПоСпецификациям, "Удалить материалы по спецификации текущей позиции?", РежимДиалогаВопрос.ДаНет);
	Иначе
		Для каждого СтрокаМатериала из МассивНоменклатур Цикл
			УдалитьМатериалыОтносящиесяКПозицииНаСервере(СтрокаМатериала.Номенклатура, СтрокаМатериала.УИСтроки);
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОтветаНаВопросУдаленияМатериаловПоСпецификациям(Результат, ДопПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		Для каждого СтрокаМатериала из ДопПараметры Цикл
			УдалитьМатериалыОтносящиесяКПозицииНаСервере(СтрокаМатериала.Номенклатура, СтрокаМатериала.УИСтроки);
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УдалитьМатериалыОтносящиесяКПозицииНаСервере(Номенклатура, УИСтроки)
	
	КоличествоЗаписей = Объект.Материалы.Количество();
	Для Сч = 1 По КоличествоЗаписей Цикл
		
		Если Объект.Материалы.Получить(КоличествоЗаписей-Сч).НоменклатураТоваров = Номенклатура
			И Объект.Материалы.Получить(КоличествоЗаписей-Сч).УИСтроки = УИСтроки Тогда
			Объект.Материалы.Удалить(КоличествоЗаписей-Сч);
		КонецЕсли;
		
	КонецЦикла;
	ПерестроитьДеревоНаФорме(Истина);
	
	ОбновитьНадписьВкладкиМатериалы();
	
КонецПроцедуры

// ПерезаполнитьМатериалыПоСпецификации
// Параметры
// ТекущаяСтрока - добавляемая или изменяемая строка. В случае подбора позиция текущей комнаты
// МассивНоменклатур - в случае подбора добавляемые позиции
// ОписаниеДействия - одно из значений "ДобавлениеНоменклатуры", "ИзменениеКоличества", "ИзменениеСпецификации"
&НаКлиенте
Процедура ПерезаполнитьМатериалыПоСпецификации(ТекущаяСтрока = Неопределено, МассивНоменклатур = Неопределено, ОписаниеДействия)
	
	Если НЕ СтруктураДействийПоСпецификациям.АвтоматическиЗаполнятьМатериалы Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ ТекущаяСтрока = Неопределено Тогда
		// 2 параметра нужны всегда для разворота дерева после обновления
		Позиция = Новый Структура;
		Позиция.Вставить("Комната", 		 ТекущаяСтрока.Комната);
		Позиция.Вставить("Номенклатура", 	 ТекущаяСтрока.Номенклатура);
		Позиция.Вставить("УИСтроки", 		 ТекущаяСтрока.УИСтроки);
		Позиция.Вставить("Количество", 	  	 ТекущаяСтрока.Количество);
		Позиция.Вставить("Коэффициент", 	 ТекущаяСтрока.Коэффициент);
		Позиция.Вставить("ЕдиницаИзмерения", ТекущаяСтрока.ЕдиницаИзмерения);
		Позиция.Вставить("Спецификация", 	 ТекущаяСтрока.Спецификация);
	Иначе
		Позиция = Неопределено;
	КонецЕсли;
	
	Парам = Новый Структура;
	Парам.Вставить("ТекущаяСтрока", 	Позиция);
	Парам.Вставить("МассивНоменклатур", МассивНоменклатур);
	
	Если (ОписаниеДействия = "ДобавлениеНоменклатуры" И СтруктураДействийПоСпецификациям.ПодтверждениеПриДобавленииНоменклатуры) 
		 ИЛИ (ОписаниеДействия = "ИзменениеКоличества" И СтруктураДействийПоСпецификациям.ПодтверждениеПриИзмененииКоличества)
		 ИЛИ (ОписаниеДействия = "ИзменениеСпецификации" И СтруктураДействийПоСпецификациям.ПодтверждениеПриИзмененииСпецификации)
		Тогда
			
		ПослеВопросаОПерезаполненииМатериаловПоСпецификаци = Новый ОписаниеОповещения("ОбработкаОтветаНаВопросПерезаполненииМатериаловПоСпецификации", ЭтотОбъект, Парам);
		ПоказатьВопрос(ПослеВопросаОПерезаполненииМатериаловПоСпецификаци, "Перезаполнить материалы по спецификации текущей позиции?", РежимДиалогаВопрос.ДаНет);
	Иначе
		ПерезаполнитьМатериалыПоСпецификацииНаСервере(Парам);
		
		//++ №8367 текущая строка может быть Неопределено
		Если ТекущаяСтрока = Неопределено Тогда
			РазвернутьДеревоТоваров();
		Иначе
		//-- №8367	
			РазвернутьДеревоТоваров(ТекущаяСтрока.Комната, ТекущаяСтрока.Номенклатура);
		КонецЕсли;	
		
		РазвернутьДеревоМатериалов();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОтветаНаВопросПерезаполненииМатериаловПоСпецификации(Результат, ДопПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		ПерезаполнитьМатериалыПоСпецификацииНаСервере(ДопПараметры);
		Если ДопПараметры.ТекущаяСтрока = Неопределено Тогда
			РазвернутьДеревоТоваров();
		Иначе
			РазвернутьДеревоТоваров(ДопПараметры.ТекущаяСтрока.Комната, ДопПараметры.ТекущаяСтрока.Номенклатура);
		КонецЕсли;
		РазвернутьДеревоМатериалов();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПерезаполнитьМатериалыПоСпецификацииНаСервере(ДопПараметры)
	
	Если ДопПараметры.МассивНоменклатур = Неопределено Тогда
		// при добавлении одной позиции, изменении количества/спецификации
		//Сначало удалим
		УдалитьМатериалыОтносящиесяКПозицииНаСервере(ДопПараметры.ТекущаяСтрока.Номенклатура, ДопПараметры.ТекущаяСтрока.УИСтроки);
		
		МассивПозиций = Новый Массив;	
		МассивПозиций.Добавить(ДопПараметры.ТекущаяСтрока);		
	Иначе
		// при подборе
		МассивПозиций = ДопПараметры.МассивНоменклатур;
	КонецЕсли;	
	
	//Теперь заполним		
	ЗаполнитьМатериалыПоСпецификацииНаСервере(МассивПозиций, Ложь);
	
	ОбновитьНадписьВкладкиМатериалы();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьМатериалыПоСпецификацииНаСервере(СписокПозиций, ОчиститьТЧ = Истина, ПерестроитьДерево = Истина, ДобавлятьТолькоОтсутствующиеПозиции = Ложь)
	
	Если ОчиститьТЧ Тогда
		Объект.Материалы.Очистить();
	КонецЕсли;
	
	//Дерево = ДанныеФормыВЗначение(ДеревоТоваров, Тип("ДеревоЗначений"));
	
	// зачем это? пока закомментировано
	//заполним гуиды строк по ключу Номенклатура+Характеристика+Комната
	//ТаблицаУИдов = Новый ТаблицаЗначений;
	//ТаблицаУИдов.Колонки.Добавить("Комната");
	//ТаблицаУИдов.Колонки.Добавить("Номенклатура");
	//ТаблицаУИдов.Колонки.Добавить("ХарактеристикаНоменклатуры");
	//ТаблицаУИдов.Колонки.Добавить("УИСтроки");
	//ДеревоМ = ДанныеФормыВЗначение(ДеревоМатериалов, Тип("ДеревоЗначений"));
	//Для Каждого ТекущаяСтрокаКомнаты Из ДеревоМ.Строки Цикл
	//	Для Каждого ТекущаяСтрока Из ТекущаяСтрокаКомнаты.Строки Цикл
	//		НоваяСтрока = ТаблицаУИдов.Добавить();
	//		НоваяСтрока.Комната = ТекущаяСтрока.Комната;
	//		НоваяСтрока.Номенклатура = ТекущаяСтрока.Номенклатура;
	//		НоваяСтрока.ХарактеристикаНоменклатуры = ТекущаяСтрока.ХарактеристикаНоменклатуры;
	//		НоваяСтрока.УИСтроки = ТекущаяСтрока.УИСтроки;
	//	КонецЦикла;
	//КонецЦикла;
	
	ВременнаяТаблица = Новый ТаблицаЗначений; //хранит общее количество необходимых материалов по спецификации после округления общего количества товаров
	ВременнаяТаблица.Колонки.Добавить("Номенклатура");
	ВременнаяТаблица.Колонки.Добавить("ХарактеристикаНоменклатуры");
	ВременнаяТаблица.Колонки.Добавить("ОкруглятьВБольшуюСторону");
	ВременнаяТаблица.Колонки.Добавить("ПорядокОкругленияЧислом");
	ВременнаяТаблица.Колонки.Добавить("КоличествоДоОкругления");
	ВременнаяТаблица.Колонки.Добавить("КоличествоПослеОкругления");
	ВременнаяТаблица.Колонки.Добавить("НоменклатураТоваров");
	ВременнаяТаблица.Колонки.Добавить("УИСтроки");
	
	ТаблицаМатериалов = Новый ТаблицаЗначений;
	ТаблицаМатериалов.Колонки.Добавить("Комната");
	ТаблицаМатериалов.Колонки.Добавить("Номенклатура");
	ТаблицаМатериалов.Колонки.Добавить("ХарактеристикаНоменклатуры");
	ТаблицаМатериалов.Колонки.Добавить("ЕдиницаИзмерения");
	ТаблицаМатериалов.Колонки.Добавить("Коэффициент");
	ТаблицаМатериалов.Колонки.Добавить("Количество");
	ТаблицаМатериалов.Колонки.Добавить("НоменклатураТоваров");
	ТаблицаМатериалов.Колонки.Добавить("УИСтроки");	
	
	Для Каждого ТекущаяСтрока Из СписокПозиций Цикл
		НоваяСтрока = ТаблицаМатериалов.Добавить();
		НоваяСтрока.Комната = ТекущаяСтрока.Комната;		
		Для Каждого СтрокаСпецификации Из ТекущаяСтрока.Спецификация.Состав Цикл
			КоэффициентИзменения = ?(СтрокаСпецификации.ФиксированноеКоличество, 1, ТекущаяСтрока.Количество * ТекущаяСтрока.Коэффициент);
			КоличествоКДобавлению = ОбщийМодуль.ОкруглитьЧисло(КоэффициентИзменения * СтрокаСпецификации.Количество,СтрокаСпецификации.ПорядокОкругленияЧислом,СтрокаСпецификации.ОкруглятьВБольшуюСторону); 
			Если КоличествоКДобавлению > 0 Тогда
				НоваяСтрока = ТаблицаМатериалов.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаСпецификации);
				НоваяСтрока.Комната = ТекущаяСтрока.Комната;
				НоваяСтрока.Количество = КоличествоКДобавлению;
				НоваяСтрока.НоменклатураТоваров = ТекущаяСтрока.Номенклатура;
				НоваяСтрока.УИСтроки = ТекущаяСтрока.УИСтроки;
				
				НоваяВремСтрока = ВременнаяТаблица.Добавить();
				НоваяВремСтрока.Номенклатура = СтрокаСпецификации.Номенклатура;
				НоваяВремСтрока.ХарактеристикаНоменклатуры = СтрокаСпецификации.ХарактеристикаНоменклатуры;
				НоваяВремСтрока.ОкруглятьВБольшуюСторону = СтрокаСпецификации.ОкруглятьВБольшуюСторону;
				НоваяВремСтрока.ПорядокОкругленияЧислом = СтрокаСпецификации.ПорядокОкругленияЧислом;
				НоваяВремСтрока.КоличествоДоОкругления = КоэффициентИзменения * СтрокаСпецификации.Количество;
				НоваяВремСтрока.КоличествоПослеОкругления = 0;
				НоваяВремСтрока.НоменклатураТоваров = ТекущаяСтрока.Номенклатура;
				НоваяВремСтрока.УИСтроки = ТекущаяСтрока.УИСтроки;
			КонецЕсли;
		КонецЦикла;		
	КонецЦикла;	
	
	ТаблицаМатериалов.Свернуть("Комната, Номенклатура, ХарактеристикаНоменклатуры, ЕдиницаИзмерения, Коэффициент, НоменклатураТоваров, УИСтроки","Количество");
	ВременнаяТаблица.Свернуть("Номенклатура, ХарактеристикаНоменклатуры, ОкруглятьВБольшуюСторону, ПорядокОкругленияЧислом, НоменклатураТоваров, УИСтроки", "КоличествоДоОкругления, КоличествоПослеОкругления");
	
	//посчитаем сколько какого материала должно быть итого с применением округления
	Для Каждого ТекущаяСтрока Из ВременнаяТаблица Цикл
		ТекущаяСтрока.КоличествоПослеОкругления = ОбщийМодуль.ОкруглитьЧисло(ТекущаяСтрока.КоличествоДоОкругления,ТекущаяСтрока.ПорядокОкругленияЧислом,ТекущаяСтрока.ОкруглятьВБольшуюСторону);
	КонецЦикла;
	
	//получаем итоговое количество каждого материала после всех округлений
	ВременнаяТаблица.Свернуть("Номенклатура, ХарактеристикаНоменклатуры", "КоличествоПослеОкругления");
	
	//перезаполняем количество в результирующей таблице на основании того, сколько должно было бы получиьтся при общем итоге после округления
	Для Каждого ТекущийМатериал Из ТаблицаМатериалов Цикл
		КоличествоБыло = ТекущийМатериал.Количество;
		ТекущийМатериал.Количество = 0;
		Для Каждого ТекущийИтогМатериала Из ВременнаяТаблица Цикл
			Если ТекущийМатериал.Номенклатура = ТекущийИтогМатериала.Номенклатура
				И ТекущийМатериал.ХарактеристикаНоменклатуры = ТекущийИтогМатериала.ХарактеристикаНоменклатуры Тогда //Добавлено условие по характеристике
				
				Если ТекущийИтогМатериала.КоличествоПослеОкругления >= КоличествоБыло Тогда
					ТекущийМатериал.Количество = КоличествоБыло;
					ТекущийИтогМатериала.КоличествоПослеОкругления = ТекущийИтогМатериала.КоличествоПослеОкругления - КоличествоБыло;
				Иначе
					ТекущийМатериал.Количество = ТекущийИтогМатериала.КоличествоПослеОкругления;
					ТекущийИтогМатериала.КоличествоПослеОкругления = 0;
				КонецЕсли;
				
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	//переносим таблицу в документ
	Для Каждого ТекущийМатериал Из ТаблицаМатериалов Цикл
		
		//++ №11095
		//	ранее введенные строки не трогаются, но в ТЧ материалов добавляются те материалы и в том количестве
		//	которые должны быть по спецификациям, но их нет в ТЧ "Материалы"
		Если ДобавлятьТолькоОтсутствующиеПозиции
			И Объект.Материалы.НайтиСтроки(новый Структура("Комната, Номенклатура", ТекущийМатериал.Комната, ТекущийМатериал.Номенклатура)).Количество() > 0
		Тогда
			Продолжить;
		КонецЕсли;
		//-- №11095
		
		Если НЕ ТекущийМатериал.Количество = 0 Тогда
			НоваяСтрока = Объект.Материалы.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущийМатериал);
		КонецЕсли;
		
	КонецЦикла;
	
	//ПроверитьОтсутствиеКомнатВМатериалах();  убрано в процедуру ПерестроитьДеревоНаФорме
	
	Если ПерестроитьДерево Тогда
		ПерестроитьДеревоНаФорме(Истина);
	КонецЕсли;
	
	Модифицированность = Истина;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура УстановитьЗаголовокФормы()
	
	ТекущийСтатус = "(" + Объект.Результат + ")";
	
	Если Объект.ВидОперации = Справочники.ВидыМонтажа.Рекламация Тогда
		НачалоЗаголовка = "Реализация клиенту (рекламация)";
	ИначеЕсли Объект.ВидОперации = Справочники.ВидыМонтажа.СервиснаяЗаявка Тогда
		НачалоЗаголовка = "Реализация клиенту (сервисная заявка)";
	ИначеЕсли Объект.ВидОперации = Справочники.ВидыМонтажа.Продажа Тогда // №12721
		НачалоЗаголовка = "Реализация клиенту (продажа)";
		ТекущийСтатус = "";
	Иначе
		НачалоЗаголовка = "Реализация клиенту (монтаж)";
	КонецЕсли;
	
	ВерсияМонтажа  = "";
	//Если НЕ ОтображатьТоварыИМатериалыВВидеДерева() Тогда
	Если НЕ Объект.ВидОперации = Справочники.ВидыМонтажа.Рекламация
		И НЕ Объект.ВидОперации = Справочники.ВидыМонтажа.СервиснаяЗаявка
		И ТипЗнч(Объект.Основание) = Тип("ДокументСсылка.ЗаказДоговор")
		И НЕ Объект.Основание.Пустая()
		И НЕ Объект.Основание.ЗаполнятьУИСтрок
	Тогда
		ВерсияМонтажа = "(Версия документа 1.1)";
	КонецЕсли;
	 
	ЭтаФорма.Заголовок = СокрЛП(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку("%1 %2 %3 %4",
						НачалоЗаголовка, 
						?(Объект.Ссылка.Пустая(), "(создание)", Объект.Номер + " от " + Объект.Дата),
						ТекущийСтатус, 
						ВерсияМонтажа));
	
КонецПроцедуры
					
// Функция записи и проведения документа.
//
&НаСервере
Функция ЗаписатьДокументНаСервере(ПараметрыЗаписи)
	
	Попытка
		Результат = Записать(ПараметрыЗаписи);
	Исключение
		ТекстСообщения = НСтр("ru = 'Не удалось провести документ'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьСтатьюДоходовРасходовСервер()
	Объект.СтатьяДоходов  = ФинансыСервер.ПолучитьСтатьюДоходовРасходов(Объект, "Доход");
	Объект.СтатьяРасходов = ФинансыСервер.ПолучитьСтатьюДоходовРасходов(Объект, "Расход", Ложь);
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСтавкуНДСПоОрганизацииСервер()
	
	УчитыватьНДС = УчетНДС.ОрганизацияЯвляетсяПлательщикомНДС(Объект.Организация);
	СтавкаНДСПоУмолчанию = УчетНДС.СтавкаНДСПоУмолчанию(Объект.Организация);
	
	Элементы.ДеревоТоваровСтавкаНДС.Видимость 	= УчитыватьНДС И НЕ ЭтоРекламация;
	Элементы.ДеревоТоваровСуммаНДС.Видимость 	= УчитыватьНДС И НЕ ЭтоРекламация;
	Элементы.ТоварыУслугиСуммаНДС.Видимость 	= УчитыватьНДС И НЕ ЭтоРекламация;
	Элементы.ТоварыУслугиСтавкаНДС.Видимость 	= УчитыватьНДС И НЕ ЭтоРекламация;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьСтавкуНДСПоОрганизацииКлиент(ИзменятьСтавку = Истина)
	
	ЗаполнитьСтавкуНДСПоОрганизацииСервер();
	Если ИзменятьСтавку Тогда
		ПоДереву = ОтображатьТоварыИМатериалыВВидеДерева();
		Если ПоДереву Тогда
			ЗаполнитьСтавкуНДСВДеревеТоваров();
		Иначе
			ЗаполнитьСтавкуНДСВТаблицеТоваров();
		КонецЕсли;
		РассчитатьИтоговыеПоказателиКлиент(ПоДереву);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьСтавкуНДСВТаблицеТоваров()		
		
	Для Каждого СтрокаТовара Из Объект.ТоварыУслуги Цикл
		СтрокаТовара.СтавкаНДС = СтавкаНДСПоУмолчанию;
		ОбработкаТабличныхЧастейКлиентСервер.ПересчитатьСуммуНДСВСтрокеТЧ(СтрокаТовара, УчитыватьНДС);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьСтавкуНДСВДеревеТоваров()		
	
	СтрокиКомнат = ДеревоТоваров.ПолучитьЭлементы();
	Для Каждого СтрокаКомнаты из СтрокиКомнат Цикл
		СтрокиТоваров = СтрокаКомнаты.ПолучитьЭлементы();	
		Для Каждого СтрокаТовара Из СтрокиТоваров Цикл
			СтрокаТовара.СтавкаНДС = СтавкаНДСПоУмолчанию;
			ОбработкаТабличныхЧастейКлиентСервер.ПересчитатьСуммуНДСВСтрокеТЧ(СтрокаТовара, УчитыватьНДС);
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьИтоговыеПоказателиКлиент(ПоДереву = Ложь) Экспорт
		
	ИтогСумма = 0;
	ИтогСуммаБезСкидки = 0;
	ИтогСуммаПоПрайсу = 0;
	ИтогСуммаНДС = 0;
	ИтогСуммаСкидки = 0;
	ИтогКоличествоКомнат = 0;
	
	ИтогКоличествоПотолков = 0; 
	ИтогПлощадьПотолков = 0;
	
	ТрудоемкостьВсего = 0;
	
	Если ПоДереву Тогда
		СтрокиКомнат = ДеревоТоваров.ПолучитьЭлементы();
		ИтогКоличествоКомнат = СтрокиКомнат.Количество();
		
		Для Каждого СтрокаКомнаты из СтрокиКомнат Цикл	
			СуммаПоКомнате = 0;
			//СуммаПоПрайсуКомнате = 0;
			ИтогБесплатноПоКомнате = 0;
			ИтогПлатноПоКомнате = 0;
			
			Для Каждого СтрокаТовара Из СтрокаКомнаты.ПолучитьЭлементы() Цикл
				Если НЕ СтрокаТовара.ИспользоватьВТекущемМонтаже Тогда
					Продолжить;
				КонецЕсли;
				ИтогСумма = ИтогСумма + СтрокаТовара.Сумма;
				ИтогСуммаБезСкидки = ИтогСуммаБезСкидки + СтрокаТовара.Количество * СтрокаТовара.Цена;
				//ИтогСуммаПоПрайсу = ИтогСуммаПоПрайсу + СтрокаТовара.СуммаПоПрайсу;
				ИтогСуммаНДС = ИтогСуммаНДС + СтрокаТовара.СуммаНДС;
				ИтогСуммаСкидки = ИтогСуммаСкидки + СтрокаТовара.СуммаСкидки;			
				Если ЗначениеЗаполнено(СтрокаТовара.Номенклатура) И ОбщийМодульВызовСервера.ЭтоНоменклатураПотолкаРозницы(СтрокаТовара.Номенклатура) Тогда
					ИтогКоличествоПотолков = ИтогКоличествоПотолков + 1; 
					ИтогПлощадьПотолков = ИтогПлощадьПотолков + СтрокаТовара.Количество;	
				КонецЕсли;
				
				СуммаПоКомнате = СуммаПоКомнате + СтрокаТовара.Сумма;
				//СуммаПоПрайсуКомнате = СуммаПоПрайсуКомнате + СтрокаТовара.СуммаПоПрайсу;			
				ИтогБесплатноПоКомнате = ИтогБесплатноПоКомнате + ?(СтрокаТовара.Бесплатно, 1, 0);
				ИтогПлатноПоКомнате    = ИтогПлатноПоКомнате    + ?(СтрокаТовара.Бесплатно, 0, 1);
				//#15230
				ТрудоемкостьВсего = ТрудоемкостьВсего + СтрокаТовара.Трудоемкость;
			КонецЦикла;
			
			СтрокаКомнаты.Сумма = СуммаПоКомнате;
			//СтрокаКомнаты.СуммаПоПрайсу = СуммаПоПрайсуКомнате;
			СтрокаКомнаты.Бесплатно = (ИтогБесплатноПоКомнате > 0 И ИтогПлатноПоКомнате = 0);
		КонецЦикла;
	Иначе
		ИтогСумма = Объект.ТоварыУслуги.Итог("Сумма");
		ИтогСуммаНДС = Объект.ТоварыУслуги.Итог("СуммаНДС");
	КонецЕсли;
	ИтогОтклонениеОтПрайса = ИтогСумма - ИтогСуммаПоПрайсу;	
			
	Если Объект.СуммаДокумента <> ИтогСумма Тогда 
		Объект.СуммаДокумента = ИтогСумма;
		Модифицированность = Истина;
	КонецЕсли;
	
	СуммаНДС = ИтогСуммаНДС;
	
	//#15230
	Если ОтображатьТрудоемкость Тогда
		Знаменатель = Объект.Исполнители.Итог("КоличествоВыполняемыхНормоЧасовМонтажаЗаЧасВремени");
		Если Знаменатель = 0 Тогда
			НеобходимоВремениВсего = 0;
		Иначе
			НеобходимоВремениВсего = ТрудоемкостьВсего / Знаменатель;
		КонецЕсли;
	КонецЕсли;
		
КонецПроцедуры

&НаСервере
Процедура РассчитатьИтоговыеПоказателиСервер()
		
	ИтогСумма = 0;
	//ИтогСуммаБезСкидки = 0;
	//ИтогСуммаПоПрайсу = 0;
	ИтогСуммаНДС = 0;
	//ИтогСуммаСкидки = 0;
	//ИтогКоличествоКомнат = 0;
	
	//ИтогКоличествоПотолков = 0; 
	//ИтогПлощадьПотолков = 0;
	
	ТрудоемкостьВсего = 0; //#15230
	
	ПоДереву = ОтображатьТоварыИМатериалыВВидеДерева();
	
	Если ПоДереву Тогда
		КоличествоСтрокТоваров = 0;
		Дерево = ДанныеФормыВЗначение(ДеревоТоваров, Тип("ДеревоЗначений"));
		Для Каждого СтрокаКомнаты Из Дерево.Строки Цикл
			Для Каждого СтрокаТовара Из СтрокаКомнаты.Строки Цикл
				Если
					// №7620 признак не должен участвовать в условии ЗаполнениеМатериаловПоМонтажам ИЛИ 
					СтрокаТовара.ИспользоватьВТекущемМонтаже
				Тогда
					ИтогСумма = ИтогСумма + СтрокаТовара.Сумма;
					ИтогСуммаНДС = ИтогСуммаНДС + СтрокаТовара.СуммаНДС;
					КоличествоСтрокТоваров = КоличествоСтрокТоваров + 1;
					
					//#15230
					ТрудоемкостьВсего = ТрудоемкостьВсего + СтрокаТовара.Трудоемкость;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
		
		Если КоличествоСтрокТоваров = 0 Тогда
			Элементы.ГруппаТоварыИУслугиДерево.Заголовок = "Товары и услуги";
		Иначе
			Элементы.ГруппаТоварыИУслугиДерево.Заголовок = "Товары и услуги (" + КоличествоСтрокТоваров + ")";
		КонецЕсли;	
	Иначе
		ИтогСумма = Объект.ТоварыУслуги.Итог("Сумма");
		ИтогСуммаНДС = Объект.ТоварыУслуги.Итог("СуммаНДС");
	КонецЕсли;
	
	Если НЕ Объект.СуммаДокумента = ИтогСумма Тогда
		Объект.СуммаДокумента = ИтогСумма;
		Модифицированность = Истина;
	КонецЕсли;
	
	СуммаНДС = ИтогСуммаНДС;
	
	//#15230
	Если ОтображатьТрудоемкость Тогда
		Знаменатель = Объект.Исполнители.Итог("КоличествоВыполняемыхНормоЧасовМонтажаЗаЧасВремени");
		Если Знаменатель = 0 Тогда
			НеобходимоВремениВсего = 0;
		Иначе
			НеобходимоВремениВсего = ТрудоемкостьВсего / Знаменатель;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

