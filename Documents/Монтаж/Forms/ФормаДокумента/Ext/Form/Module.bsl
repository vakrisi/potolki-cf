		Элементы.Контрагент.Доступность = Истина;  //НЕ ЕстьОснование;
		Элементы.ДоговорКонтрагента.Доступность = Истина; //НЕ ЕстьОснование;
		//-- #16810
		
		Элементы.Валюта.Доступность = НЕ ЕстьОснование;
		
		Элементы.ВидЦен.Доступность = НЕ ЕстьОснование;
		Элементы.ВидСкидки.Доступность = НЕ ЕстьОснование;
		
		Элементы.ВидЦен.Видимость = Истина;
		Элементы.ВидСкидки.Видимость = Истина;
	КонецЕсли;
	Если Объект.ВидОперации = Справочники.ВидыМонтажа.СервиснаяЗаявка ИЛИ Объект.ВидОперации = Справочники.ВидыМонтажа.Рекламация Тогда
		Элементы.Организация.Доступность = (НЕ ЕстьЗаказДоговор);
		Элементы.Контрагент.Доступность = (НЕ ЕстьЗаказДоговор);
		Элементы.Валюта.Доступность = НЕ ЕстьЗаказДоговор;
		
		Элементы.ВидЦен.Доступность = НЕ ЕстьЗаказДоговор;
		Элементы.ВидСкидки.Доступность = НЕ ЕстьЗаказДоговор;
		Элементы.ВидЦен.Видимость = (Объект.ВидОперации = Справочники.ВидыМонтажа.СервиснаяЗаявка);
		Элементы.ВидСкидки.Видимость = (Объект.ВидОперации = Справочники.ВидыМонтажа.СервиснаяЗаявка);
	КонецЕсли;	
	
	//#6385 16579 реквизит не используется
	//Элементы.ПриРасчетеВыработкиУчитыватьПроцентОтклоненияОтПрайса.Доступность = ПолучитьФункциональнуюОпцию("ПриРасчетеВыработкиПоМонтажуУчитыватьПроцентОтклоненияОтПрайса");
	                                                                            // #16579 закомментировано: функционал для всех монтажей
																				//И ((ВидМонтажИЕстьЗаказДоговор ИЛИ ВидПродажаИЕстьЗаказДоговор);
																				 
	//-- №12802 перенесено из ПриСозданииНаСервере
	
КонецПроцедуры

