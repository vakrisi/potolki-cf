		 ДатаНачала =  ТекущиеДанные.ДатаМонтажа;
		 ДатаОкончания = ДатаНачала;
		 Если Элементы.УстановитьНеделя.Пометка Тогда
			 ДатаОкончания = ДатаНачала + 86400*7;
		 ИначеЕсли Элементы.УстановитьМесяц.Пометка Тогда
			 ДатаОкончания = ДобавитьМесяц(ДатаНачала, 1);
		 КонецЕсли;
	 КонецЕсли;	 
	//--17113 
	
	СформироватьГрафик(Элементы.ГрафикМонтажей.ТекущаяСтрока);
	
