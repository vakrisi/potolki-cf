		ПараметрыНовогоМонтажа.Вставить("ВремяОкончания", 	Дата("00010101") + (Конец - НачалоДня(Конец)));
		ПараметрыНовогоМонтажа.Вставить("Бригада", 			Значения.Получить("Бригада"));
		ПараметрыНовогоМонтажа.Вставить("ИндексСтроки", 	ИндексСтроки);
		ПараметрыНовогоМонтажа.Вставить("ИДМонтажа", 		"");

		СтруктураПроверкиИнтервала = ПроверитьСвободныйИнтервалМонтажей(ПараметрыНовогоМонтажа, Объект.ГрафикМонтажей, ФильтрТочкаПродаж);
		Если НЕ СтруктураПроверкиИнтервала.Результат Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтруктураПроверкиИнтервала.ТекстОшибки, , , , Отказ);
			
			СформироватьГрафик();
		КонецЕсли;
		
	КонецЕсли;
		
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	ВыбраннаяБригада = ?(ТипЗнч(ВыбраннаяБригада) = Тип("Строка"), ПредопределенноеЗначение("Справочник.Бригады.ПустаяСсылка"), ВыбраннаяБригада);
	БригадаИзменилась = НЕ (Объект.Бригада = ВыбраннаяБригада) ИЛИ ТипЗнч(Значения.Получить("Бригада")) = Тип("Строка");		
	Объект.Бригада = ВыбраннаяБригада;
	Если ВыбраннаяБригада.Пустая() Тогда
		//#9168
		Объект.Бригадир = ПредопределенноеЗначение("Справочник.Сотрудники.ПустаяСсылка");
	КонецЕсли;
	СтараяБригада  = Объект.Бригада;
	
	//++ #14004
	Если МассивНаНесколькоДней.Количество() > 0 Тогда		
		Для Каждого ТекущаяСтрока Из МассивНаНесколькоДней Цикл			
			НоваяСтрока = Объект.ГрафикМонтажей.Добавить();
