Функция ПолучитьИмяКлиентаЗамера()
	
	Если ТипЗнч(Объект.Основание) = Тип("ДокументСсылка.ЗаказДоговор")Тогда
		Если ТипЗнч(Объект.Основание.Основание) = Тип("ДокументСсылка.Лид") Тогда
			Возврат Объект.Основание.Основание.ИмяКлиента;
		КонецЕсли;
	ИначеЕсли ТипЗнч(Объект.Основание) = Тип("ДокументСсылка.Лид") Тогда
		Возврат Объект.Основание.ИмяКлиента;
	КонецЕсли; 
	
