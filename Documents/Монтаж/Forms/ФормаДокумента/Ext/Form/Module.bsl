КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	ПредыдущийРезультат = Объект.Ссылка.Результат;
	
	Если ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
		
		Если ТипЗнч(Объект.Основание) = Тип("ДокументСсылка.ЗаказДоговор") Тогда
			Если НЕ Объект.Организация = Объект.Основание.Организация тогда
				Сообщить("Организация монтажа и заказ-договора не совпадают.");
				Отказ = Истина;
			КонецЕсли;
			Если НЕ Объект.Контрагент = Объект.Основание.Контрагент тогда
				Сообщить("Контрагент монтажа и заказ-договора не совпадают.");
				Отказ = Истина;
			КонецЕсли;
			Если НЕ Объект.ДоговорКонтрагента = Объект.Основание.ДоговорКонтрагента тогда
				Сообщить("Договор контрагента монтажа и заказ-договора не совпадают.");
				Отказ = Истина;
			КонецЕсли;
			Если НЕ Объект.Основание.Пустая() 
				И Объект.Основание.ТекущийСтатус = Справочники.СтатусыЗаказДоговоров.Отменен 
				И Объект.Результат <> Справочники.РезультатыМонтажа.Отменен 
			Тогда
				Сообщить("Основание заказ-договор находится в статусе ""Отменен"", проведение монтажа разрешено только в статусе ""Отменен"".");
				Отказ = Истина;
			КонецЕсли;
		КонецЕсли;
		Если Отказ Тогда
			Сообщить("Проведение отменено");
			Возврат;
		КонецЕсли;
		
		Отказ = НЕ ПраваПользователей.РазрешеноРасходоватьСоСклада(Объект.Склад);
		Если Отказ Тогда
			Сообщить("У текущего пользователя нет прав для оформления расхода со склада """ + Объект.Склад + """");
			Возврат;
		КонецЕсли;
		
		Отказ = НЕ ПраваПользователей.РазрешеноРасходоватьСоСклада(Объект.СкладТоваров);
		Если Отказ Тогда
			Сообщить("У текущего пользователя нет прав для оформления расхода со склада """ + Объект.СкладТоваров + """");
			Возврат;
		КонецЕсли;
		
		Если Объект.Материалы.Количество() > 0 и Объект.Склад.Пустая() Тогда
			Сообщить("Не указан склад материалов");
			Отказ = Истина;
			Возврат;
		КонецЕсли;
		
		Если Объект.ТоварыУслуги.Количество() > 0 и Объект.СкладТоваров.Пустая() Тогда
			Для Каждого ТекущаяСтрока Из Объект.ТоварыУслуги Цикл
				Если ТекущаяСтрока.Номенклатура.ВидНоменклатуры = Справочники.ВидыНоменклатуры.Материал
					или ТекущаяСтрока.Номенклатура.ВидНоменклатуры = Справочники.ВидыНоменклатуры.Отрез
					или ТекущаяСтрока.Номенклатура.ВидНоменклатуры = Справочники.ВидыНоменклатуры.Полотно
					или ТекущаяСтрока.Номенклатура.ВидНоменклатуры = Справочники.ВидыНоменклатуры.Потолок
					Тогда
					Сообщить("Не указан склад товаров");
					Отказ = Истина;
					Возврат;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
		Если (Объект.Результат = Справочники.РезультатыМонтажа.Выполнен
			или Объект.Результат = Справочники.РезультатыМонтажа.Закрыт)
			И КСписаниюНеСоответствуетКоличеству Тогда
			Для Каждого ТекущаяСтрока Из Объект.ТоварыУслуги Цикл
				Если НЕ Справочники.ВидыНоменклатуры.ЭтоНоменклатураУслуга(ТекущаяСтрока.Номенклатура)
					И ТекущаяСтрока.КоличествоКСписанию = 0 Тогда
					ТекстСообщения = "Для строки """ + ТекущаяСтрока.Номенклатура + """ не указано количество к списанию";
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,,, Отказ);	
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
		Если (Объект.Результат = Справочники.РезультатыМонтажа.Выполнен
			или Объект.Результат = Справочники.РезультатыМонтажа.Закрыт)
			И ОтображатьТоварыИМатериалыВВидеДерева() Тогда
			Дерево = ДанныеФормыВЗначение(ДеревоТоваров, Тип("ДеревоЗначений"));
			Для Каждого ТекущаяКомната Из Дерево.Строки Цикл
				Для Каждого ТекущаяНоменклатура Из ТекущаяКомната.Строки Цикл
					Если ТекущаяНоменклатура.ИспользоватьВТекущемМонтаже 
						//И НЕ ТекущаяНоменклатура.Количество = ТекущаяНоменклатура.КоличествоВЗаказДоговоре Тогда
						//#12608 поле удалено // №12860 раскомментировано
						И НЕ ТекущаяНоменклатура.Количество = Макс(0, ТекущаяНоменклатура.КоличествоВЗаказДоговоре - ТекущаяНоменклатура.КоличествоВДругихМонтажах)
						И НЕ ТекущаяНоменклатура.Количество = Макс(0, ТекущаяНоменклатура.КоличествоВЗаказДоговоре) Тогда						
						Сообщить("Перед выполнением или закрытием монтажа следует выровнять количество используемых товаров и услуг с их количеством в заказ-договоре и прочих монтажах",СтатусСообщения.Важное);
						Отказ = Истина;
	                    Возврат;
					КонецЕсли;
				КонецЦикла;
			КонецЦикла;
		КонецЕсли;
		
		//Если статус закрыт, нужно проверить оплачен ли он
		Если Объект.Результат = Справочники.РезультатыМонтажа.Закрыт Тогда	
			Запрос = Новый Запрос;
			Запрос.Текст = 
				"ВЫБРАТЬ
				|	РасчетыПоЗаказамОбороты.СуммаРасход
				|ИЗ
				|	РегистрНакопления.РасчетыПоЗаказам.Обороты КАК РасчетыПоЗаказамОбороты
				|ГДЕ
				|	РасчетыПоЗаказамОбороты.Заказ = &Ссылка";
			
			Запрос.УстановитьПараметр("Ссылка", Объект.Ссылка);
			
			Выборка = Запрос.Выполнить().Выбрать();	
			
			СуммаОплат = 0;
			Пока Выборка.Следующий() Цикл
				СуммаОплат = СуммаОплат + Выборка.СуммаРасход;
			КонецЦикла;	
			
			Если СуммаОплат < Объект.СуммаДокумента Тогда
				Отказ = Истина;
				Сообщить("Данный монтаж не оплачен (либо оплачен не полностью), перевод в статус ""Закрыт"" отменен!");
			КонецЕсли;	
		КонецЕсли;
		
		мДатаМонтажа 	= Объект.Ссылка.ДатаМонтажа;
		мВремяНачала 	= Объект.Ссылка.ВремяНачала;
		мВремяОкончания = Объект.Ссылка.ВремяОкончания;
		
		//Проверим расхождения по ЗД при закрытии монтажа
		Если (Объект.Результат = Справочники.РезультатыМонтажа.Закрыт
			ИЛИ (Объект.Результат = Справочники.РезультатыМонтажа.Выполнен И НЕ Объект.СозданПриИспользованииСтатусаЗакрыт)) // №12802 было: УДАЛИТЬ_ИспользуетсяСтатусЗакрытВМонтажах)) 
		Тогда
			
			КоллекцияЭлементовДерева = ЭтаФорма.ДеревоТоваров.ПолучитьЭлементы();
			Для Каждого Строка Из КоллекцияЭлементовДерева Цикл			
				Для Каждого СтрокаВКомнате Из Строка.ПолучитьЭлементы() Цикл
					Если СтрокаВКомнате.ИспользоватьВТекущемМонтаже Тогда
						
						Если СтрокаВКомнате.Количество <> СтрокаВКомнате.КоличествоВЗаказДоговоре
							ИЛИ СтрокаВКомнате.Сумма <> СтрокаВКомнате.СуммаВЗаказДоговоре 
							ИЛИ СтрокаВКомнате.Цена <> СтрокаВКомнате.ЦенаВЗаказДоговоре
							ИЛИ СтрокаВКомнате.ПроцентСкидки <> СтрокаВКомнате.ПроцентСкидкиВЗаказДоговоре
							ИЛИ СтрокаВКомнате.СуммаСкидки <> СтрокаВКомнате.СуммаСкидкиВЗаказДоговоре
						Тогда
							Отказ = Истина;
							Сообщить("В табличной части товары, имеются выбранные позиции на монтаж с расхождением по заказ-договору");
						КонецЕсли;
						
					КонецЕсли;
				КонецЦикла;			
			КонецЦикла;
			
			//++ №8733
			Если Объект.ТоварыУслуги.Количество() = 0 Тогда
				Отказ = Истина;
				//#9556
				//Сообщить("Для перевода в статус """ + Объект.Результат + """, необходимо выбрать хотя бы один товар.");
				Сообщить("Перед закрытием следует указать проданные товары или оказанные услуги на вкладке ""Товары и услуги""");
			КонецЕсли;
			//-- №8733
			
		КонецЕсли;	
		
	КонецЕсли;	
		
	// проверяем заполненность статей доходов/расходов
	ФинансыСервер.ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи, , Объект.СуммаДополнительныхЗатрат > 0);
	
	// СтандартныеПодсистемы.Свойства
	УправлениеСвойствами.ПередЗаписьюНаСервере(ЭтотОбъект, ТекущийОбъект);
	// Конец СтандартныеПодсистемы.Свойства
	
	//++ №11160
	Если Объект.Ссылка.Пустая() И ПолучитьФункциональнуюОпцию("ОграничитьВыборМатериаловВЗаказДоговор") Тогда
		
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("МассивНоменклатуры", Объект.Материалы.Выгрузить().ВыгрузитьКолонку("Номенклатура"));
		Запрос.УстановитьПараметр("Назначение", 2);
		Запрос.Текст = ОбщийМодульСервер.ПолучитьТекстЗапросаРазрешеннаяНоменклатураРозницы();
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Пока Выборка.Следующий() Цикл
			ТекстСообщения = "В списке материалов имеется неразрешенная позиция: " + Выборка.Ссылка;
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,,,Отказ);
		КонецЦикла;
		
	КонецЕсли;
	//-- №11160

КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	////////
	//в настройках галочка автоматическое создание документов перемещений
	////////
	//нужно получить все количества: в монтаже - перемещение выдано - перемещение возврат
	Если ИспользоватьВыдачуВозвратВДокументеМонтаж
		И ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.Проведение 
		И АвтоматическиСоздаватьДокументыПеремещения
		И НЕ Объект.Бригада.Пустая() //#9168
		Тогда
		
		ПозицииКПеремещению = ПолучитьПозицииКПеремещениюПоМонтажу();
		Если (ПозицииКПеремещению.ТЗ_КВыдаче.Количество() > 0 И ОсуществлятьПеремещениеВыдача)
			ИЛИ (ПозицииКПеремещению.ТЗ_КВозврату.Количество() > 0 И ОсуществлятьПеремещениеВозврат) Тогда		
			ПараметрыФормы = новый Структура("ПозицииКПеремещению", ПозицииКПеремещению);			
			Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопросаОСозданииПеремещения", ЭтаФорма, ПараметрыФормы);
			ОткрытьФорму("Документ.Монтаж.Форма.ФормаПеремещения", ПараметрыФормы, ЭтотОбъект,,,, Оповещение);
		КонецЕсли;	
	КонецЕсли;
	
	//++ №12802
	//Если ТребуетсяОповещениеЦентраСобытий(Объект.Результат)
	Если ТребуетсяОповещениеЦентраСобытий(Объект.Результат, Объект.СозданПриИспользованииСтатусаЗакрыт)
	//-- №12802
		И ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
		Если ЗначениеЗаполнено(Объект.Основание) И ТипЗнч(Объект.Основание) = Тип("ДокументСсылка.ЗаказДоговор") Тогда
			Оповестить("ЦентрСобытий_ЗакрытиеМонтажа", Объект.Основание, Объект.Ссылка);
		КонецЕсли;
	КонецЕсли;

	УстановитьЗаголовокФормы();
	
	ПроверитьСоответствиеЗаказДоговору();
	ОбновитьДанныеДокумента();
	
	// №5574 занести запись о соответствии в регистр
	ЗанестиЗаписьОСоответствииЗаказДоговору();
	
	Оповестить("ЗаписьМонтажа", Объект.Основание, Объект.Ссылка);

	Выработка.Параметры.УстановитьЗначениеПараметра("ОбъектВыработки", Объект.Ссылка); // для новых документов ссылка могла быть пустой
	Элементы.Выработка.Обновить();
	
	// №1083 закомментировано, т.к. расчет теперь зависит от разных таблиц
	//// №7425 расчет итога суммы выработки
	//РассчитатьСуммуВыработкиИтого(СуммаВыработки, Объект.Ссылка);
	
	ПолучитьЗаписиИсторииМонтажаИзРегистраНаСервере();
	
	ОбновитьДеревоМатериалов();
КонецПроцедуры

&НаСервере
Процедура ЗанестиЗаписьОСоответствииЗаказДоговору()
	
	// если не соответствует ЗД, нужно записать в регистр
	// если соответствует, удалить записи из регистра
	
	Если ТипЗнч(Объект.Основание) = Тип("ДокументСсылка.ЗаказДоговор") И НЕ Объект.Основание.Пустая() Тогда
		
		УстановитьПривилегированныйРежим(Истина);
		
		НаборЗаписей = РегистрыСведений.СоответствиеДоговораИМонтажей.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.ЗаказДоговор.Установить(Объект.Основание);
		НаборЗаписей.Отбор.Монтаж.Установить(Объект.Ссылка);
		НаборЗаписей.Прочитать();
		
		// Не соответствует
		Если ПоказатьКнопкуОтчетаСравненияСМонтажами Тогда			
			Если НаборЗаписей.Количество() = 0 Тогда
				НоваяЗапись = НаборЗаписей.Добавить();
				НоваяЗапись.ЗаказДоговор = Объект.Основание;
				НоваяЗапись.Монтаж = Объект.Ссылка;
				НаборЗаписей.Записать();
			КонецЕсли;
		Иначе // Соответствует
			НаборЗаписей.Очистить();
			НаборЗаписей.Записать();
		КонецЕсли;
		
		УстановитьПривилегированныйРежим(Ложь);
		
	КонецЕсли;	
	
КонецПроцедуры

