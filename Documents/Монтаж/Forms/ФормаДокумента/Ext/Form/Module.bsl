Процедура ЗаполнитьОстаткиПоМатериалам()
	
	РезультатЗапроса = ПолучитьОстаткиПоПозициям(Объект.Материалы.Выгрузить(), СкладАнализаОстатковМатериалов);
	
	Для Каждого ТекущаяСтрока Из Объект.Материалы Цикл
		
		Отбор = Новый Структура;
		Отбор.Вставить("Номенклатура", ТекущаяСтрока.Номенклатура);
		Отбор.Вставить("ХарактеристикаНоменклатуры",ТекущаяСтрока.ХарактеристикаНоменклатуры);
		Отбор.Вставить("СерияНоменклатуры",ТекущаяСтрока.СерияНоменклатуры);
		
		НайденныеСтроки = РезультатЗапроса.НайтиСтроки(Отбор);
		
		Если НайденныеСтроки.Количество() > 0 Тогда
			
			ТекущаяСтрока.ОстатокНаСкладе = НайденныеСтроки[0].ОстатокНаСкладе;
			ТекущаяСтрока.ВРезерве = НайденныеСтроки[0].КоличествоВРезерве;
			ТекущаяСтрока.ВРезервеПоТекущемуМонтажу = НайденныеСтроки[0].ВРезервеПоТекущемуМонтажу;
			ТекущаяСтрока.Доступно = ТекущаяСтрока.ОстатокНаСкладе - ТекущаяСтрока.ВРезерве + ТекущаяСтрока.ВРезервеПоТекущемуМонтажу;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

//++ №11431 унифицировано
&НаСервере
Функция ПолучитьОстаткиПоПозициям(ТаблицаПозиций, Склад)
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапросаОстатков();
	
	Запрос.УстановитьПараметр("ТаблицаДокумента",	ТаблицаПозиций);
	Запрос.УстановитьПараметр("Организация",		Объект.Организация);
	Запрос.УстановитьПараметр("Склад",				Склад);
	Запрос.УстановитьПараметр("Монтаж", 			Объект.Ссылка);
	Запрос.УстановитьПараметр("ИспользуютсяОбщиеСклады", 	Константы.ОбщиеСклады.Получить());
	Запрос.УстановитьПараметр("ИспользоватьРезервирование", Константы.ИспользоватьРезервирование.Получить());
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

&НаСервереБезКонтекста
Функция ТекстЗапросаОстатков()
	
	ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТЗ_ТаблицаДокумента.Номенклатура,
	|	ТЗ_ТаблицаДокумента.ХарактеристикаНоменклатуры,
	|	ТЗ_ТаблицаДокумента.СерияНоменклатуры,
	|	ТЗ_ТаблицаДокумента.Количество,
	|	ТЗ_ТаблицаДокумента.Коэффициент
	|ПОМЕСТИТЬ ВремТаблицаДокумента
	|ИЗ
	|	&ТаблицаДокумента КАК ТЗ_ТаблицаДокумента
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВремТаблицаДокумента.Номенклатура,
	|	ВремТаблицаДокумента.ХарактеристикаНоменклатуры,
	|	ВремТаблицаДокумента.СерияНоменклатуры,
	|	ВЫБОР
	|		КОГДА ВремТаблицаДокумента.Коэффициент <> 0
	|			ТОГДА ЕСТЬNULL(ТоварыНаСкладахОстатки.КоличествоОстаток, 0) / ВремТаблицаДокумента.Коэффициент
	|		ИНАЧЕ ЕСТЬNULL(ТоварыНаСкладахОстатки.КоличествоОстаток, 0)
	|	КОНЕЦ КАК ОстатокНаСкладе,
	|	ЕСТЬNULL(ВЫБОР		
	|		КОГДА &ИспользоватьРезервирование
	|			ТОГДА ВЫБОР
	|					КОГДА ВремТаблицаДокумента.Коэффициент <> 0
	|						ТОГДА ВРезервеОстатки.КоличествоОстаток / ВремТаблицаДокумента.Коэффициент
	|					ИНАЧЕ ВРезервеОстатки.КоличествоОстаток
	|				КОНЕЦ
	|		ИНАЧЕ 0
	|	КОНЕЦ, 0) КАК КоличествоВРезерве,
	|	ЕСТЬNULL(ВЫБОР		
	|		КОГДА &ИспользоватьРезервирование
	|			ТОГДА ВЫБОР
	|					КОГДА ВремТаблицаДокумента.Коэффициент <> 0
	|						ТОГДА ВРезервеОстаткиПодДанныйМонтаж.КоличествоОстаток / ВремТаблицаДокумента.Коэффициент
	|					ИНАЧЕ ВРезервеОстаткиПодДанныйМонтаж.КоличествоОстаток
	|				КОНЕЦ
	|		ИНАЧЕ 0
	|	КОНЕЦ, 0) КАК ВРезервеПоТекущемуМонтажу
	|ИЗ
	|	ВремТаблицаДокумента КАК ВремТаблицаДокумента
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыНаСкладах.Остатки(
	|				,
	|				ВЫБОР
	|						КОГДА &ИспользуютсяОбщиеСклады
	|							ТОГДА ИСТИНА
	|						ИНАЧЕ Организация = &Организация
	|					КОНЕЦ
	|					И Склад = &Склад) КАК ТоварыНаСкладахОстатки
	|		ПО ВремТаблицаДокумента.Номенклатура = ТоварыНаСкладахОстатки.Номенклатура
	|			И ВремТаблицаДокумента.ХарактеристикаНоменклатуры = ТоварыНаСкладахОстатки.ХарактеристикаНоменклатуры
	|			И ВремТаблицаДокумента.СерияНоменклатуры = ТоварыНаСкладахОстатки.СерияНоменклатуры
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыВРезервеНаСкладах.Остатки(,
	|				Склад = &Склад
	|					И ВЫБОР
	|						КОГДА &ИспользуютсяОбщиеСклады
	|							ТОГДА ИСТИНА
	|						ИНАЧЕ Организация = &Организация
	|					КОНЕЦ) КАК ВРезервеОстатки
	|		ПО (ВремТаблицаДокумента.Номенклатура = ВРезервеОстатки.Номенклатура)
	|			И (ВремТаблицаДокумента.ХарактеристикаНоменклатуры = ВРезервеОстатки.ХарактеристикаНоменклатуры)
	|			И (ВремТаблицаДокумента.СерияНоменклатуры = ВРезервеОстатки.СерияНоменклатуры)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыВРезервеНаСкладах.Остатки(,
	|				Склад = &Склад
	|					И ВЫБОР
	|						КОГДА &ИспользуютсяОбщиеСклады
	|							ТОГДА ИСТИНА
	|						ИНАЧЕ Организация = &Организация
	|					КОНЕЦ
	|					И ДокументРезерва = &Монтаж) КАК ВРезервеОстаткиПодДанныйМонтаж
	|		ПО (ВремТаблицаДокумента.Номенклатура = ВРезервеОстаткиПодДанныйМонтаж.Номенклатура)
	|			И (ВремТаблицаДокумента.ХарактеристикаНоменклатуры = ВРезервеОстаткиПодДанныйМонтаж.ХарактеристикаНоменклатуры)
	|			И (ВремТаблицаДокумента.СерияНоменклатуры = ВРезервеОстаткиПодДанныйМонтаж.СерияНоменклатуры)
	|";
	
	Возврат ТекстЗапроса;
	
КонецФункции
