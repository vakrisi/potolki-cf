	Элементы.ГруппаЧеклист.Видимость = (НЕ ЭтоПродажа);
	
	//#12131 Рекламация - это бесплатно
	МассивРеквизитов = Новый Массив;
	МассивРеквизитов.Добавить("ТоварыУслугиПерезаполнитьЦеныПоДоговору");
	МассивРеквизитов.Добавить("ГруппаСуммаВалюта");
	МассивРеквизитов.Добавить("ГруппаСуммаВалюта1");
	МассивРеквизитов.Добавить("ГруппаПодвалИтого");
	
	МассивРеквизитов.Добавить("ВидЦен");
	МассивРеквизитов.Добавить("ВидСкидки");
	МассивРеквизитов.Добавить("ТоварыУслугиЦена");
	МассивРеквизитов.Добавить("ТоварыУслугиПроцентСкидки");
	МассивРеквизитов.Добавить("ТоварыУслугиСуммаСкидки");
	МассивРеквизитов.Добавить("ТоварыУслугиСумма");
	МассивРеквизитов.Добавить("ТоварыУслугиБесплатно");
	МассивРеквизитов.Добавить("ТоварыУслугиСтавкаНДС");
	МассивРеквизитов.Добавить("ТоварыУслугиСуммаНДС");
	
	МассивРеквизитов.Добавить("ДеревоТоваровЦена");
	МассивРеквизитов.Добавить("ДеревоТоваровЦенаПоПрайсу");
	// №14161 МассивРеквизитов.Добавить("ДеревоТоваровЦенаВЗаказДоговоре");
	МассивРеквизитов.Добавить("ДеревоТоваровПроцентСкидки");
	// №14161 МассивРеквизитов.Добавить("ДеревоТоваровПроцентСкидкиВЗаказДоговоре");
	МассивРеквизитов.Добавить("ДеревоТоваровСуммаСкидки");
	// №14161 МассивРеквизитов.Добавить("ДеревоТоваровСуммаСкидкиВЗаказДоговоре");
	МассивРеквизитов.Добавить("ДеревоТоваровБесплатно");
	МассивРеквизитов.Добавить("ДеревоТоваровСумма");
	МассивРеквизитов.Добавить("ДеревоТоваровСуммаПоПрайсу");
	// №14161 МассивРеквизитов.Добавить("ДеревоТоваровСуммаВЗаказДоговоре");
	МассивРеквизитов.Добавить("ДеревоТоваровСтавкаНДС");
	МассивРеквизитов.Добавить("ДеревоТоваровСуммаНДС");
	
	ОбщийМодульСервер.УстановитьВидимостьЭлементовПоМассиву(
		Элементы,
		МассивРеквизитов,
		?(ЭтоРекламация, Неопределено, МассивРеквизитов));
		
	// №12802
	УправлениеФормойПоВидуМонтажаИОснованию();
	
КонецПроцедуры

&НаСервере
Процедура УправлениеФормойПоВидуМонтажаИОснованию()
	
	//++ №12802 перенесено из ПриСозданииНаСервере с регулированием видимости полей ВидЦены и ВидСкидки
	// если монтаж с видом операции "Монтаж" и указан заказ-договор, то шапочные реквизиты не доступны для редактирования, т.к. должны соответствовать основанию
	ЕстьЗаказДоговор = (НЕ Объект.ЗаказДоговор.Пустая());
	ЕстьОснование    = ЗначениеЗаполнено(Объект.Основание);
	
	Если Объект.ВидОперации = Справочники.ВидыМонтажа.Монтаж ИЛИ Объект.ВидОперации = Справочники.ВидыМонтажа.Продажа Тогда
		
		//++ #16810 убрана проверка (НЕ ЕстьОснование)
