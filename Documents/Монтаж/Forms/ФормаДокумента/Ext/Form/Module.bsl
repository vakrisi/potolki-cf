&НаСервере
Процедура УстановитьВидЦенНаОснованииДоговора(ПересчитатьЦеныБезВопросов = Ложь)
	
	//сначала берем из карточки пользователя (низший приоритет)
	Объект.ВидЦен = ОбщийМодульСервер.НастройкаПользователя("ВидЦен");
	//если задан вид цен в категории контрагента, то берем из него (средний приоритет)
	Если НЕ Объект.Контрагент.Категория.ВидЦен.Пустая() Тогда
		Объект.ВидЦен = Объект.Контрагент.Категория.ВидЦен;
	КонецЕсли;
	//если задан вид цен в договоре, то берем из него (высший приоритет)
	Если НЕ Объект.ДоговорКонтрагента.ВидЦен.Пустая() Тогда
		Объект.ВидЦен = Объект.ДоговорКонтрагента.ВидЦен;
	КонецЕсли;
	//пересчитываем цены
	Если ПересчитатьЦеныБезВопросов Тогда
		ПересчитатьЦеныПоВидуЦен();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура БригадаПриИзменении(Элемент)
	
	// #9168
	Если (Объект.Результат = ПредопределенноеЗначение("Справочник.РезультатыМонтажа.Выполнен") ИЛИ Объект.Результат = ПредопределенноеЗначение("Справочник.РезультатыМонтажа.Закрыт"))
		И НЕ ЗначениеЗаполнено(Объект.Бригада) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Запрещен перенос в пул по выполненным монтажам!");
		Объект.Бригада = СтараяБригада;
		Возврат;
	КонецЕсли;
	
	// #9168 При изменении бригады в шапке документа проверять пересечение графиков монтажей по этой бригаде на эту дату и время и если график накладывается, 
	// выдавать предупреждение и отменять изменение	
	Если СтараяБригада <> Объект.Бригада Тогда
		
		ДанныеТекущегоМонтажа = Новый Структура("ДатаМонтажа, ВремяНачала, ВремяОкончания, ИДМонтажа");
		ИндексСтроки = 0;
		Если НЕ Объект.СрокМонтажа = ПредопределенноеЗначение("Перечисление.СрокиМонтажа.МонтажНаНесколькоДней") Тогда
			ЗаполнитьЗначенияСвойств(ДанныеТекущегоМонтажа, Объект);
		Иначе
			ТекущиеДанные = Элементы.ГрафикМонтажей.ТекущиеДанные;	
			Если НЕ ТекущиеДанные = Неопределено Тогда
				ЗаполнитьЗначенияСвойств(ДанныеТекущегоМонтажа, ТекущиеДанные);	
				ИндексСтроки = ТекущиеДанные.НомерСтроки;
			КонецЕсли;
		КонецЕсли;
		ДанныеТекущегоМонтажа.Вставить("ИндексСтроки", ИндексСтроки);
		ДанныеТекущегоМонтажа.Вставить("Бригада", Объект.Бригада);
		
		СтруктураПроверкиИнтервала = ПроверитьСвободныйИнтервалМонтажей(ДанныеТекущегоМонтажа, Объект.ГрафикМонтажей, ФильтрТочкаПродаж);
		Если НЕ СтруктураПроверкиИнтервала.Результат Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтруктураПроверкиИнтервала.ТекстОшибки);
			Объект.Бригада = СтараяБригада;
			Возврат;
		КонецЕсли;
		
		СформироватьГрафик();

	КонецЕсли;
	
	БригадаПриИзмененииКлиент();
	
КонецПроцедуры
	
&НаКлиенте
Процедура БригадаПриИзмененииКлиент()
	
	БригадаПриИзмененииНаСервере();
	УправлениеФормойПоБригадеНаСервере();
	Если ЗначениеЗаполнено(Объект.Бригада) Тогда
