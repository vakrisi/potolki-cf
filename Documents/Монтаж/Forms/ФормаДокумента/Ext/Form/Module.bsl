		КонецЦикла;
	КонецЕсли;
	//-- #14004
		
	ДатаМонтажа 	= Начало; // №10185, было: ?(ЗначениеЗаполнено(ДанныеТекущегоМонтажа.ДатаМонтажа), ДанныеТекущегоМонтажа.ДатаМонтажа, Начало); 
