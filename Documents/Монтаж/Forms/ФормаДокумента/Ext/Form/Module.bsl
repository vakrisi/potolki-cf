&НаКлиенте
Процедура ДеревоМатериаловПередНачаломИзменения(Элемент, Отказ)
	
	ТекущиеДанные = Элементы.ДеревоМатериалов.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТекущиеДанные.Номенклатура.Пустая() И НЕ Элемент.ТекущийЭлемент.Имя = "ДеревоМатериаловИспользоватьВТекущемМонтаже" Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	//запрещаем редактировать строки, у которых статус монтажа = "Выполнен" или "Закрыт"
	Если НЕ ПустаяСтрока(ТекущиеДанные.УИСтроки) 
		И НЕ (Элемент.ТекущийЭлемент.Имя = "ДеревоМатериаловИспользоватьВТекущемМонтаже" 
		или Элемент.ТекущийЭлемент.Имя = "ДеревоМатериаловСерияНоменклатуры" 
		или Элемент.ТекущийЭлемент.Имя = "ДеревоМатериаловСерияНоменклатуры" 
		или Элемент.ТекущийЭлемент.Имя = "ДеревоМатериаловКоличество"
		)Тогда
		ПоказатьПредупреждение(,"Запрещено редактировать строки полученные из заказ-договора");
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

