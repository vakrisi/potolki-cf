Функция ПолучитьКоличествоПотолковВДокументе()
	Результат = 0;
	Для Каждого ТекущаяСтрока Из Объект.ТоварыУслуги Цикл
		Если ТекущаяСтрока.Номенклатура.ВидНоменклатуры = Справочники.ВидыНоменклатуры.Потолок
			или ТекущаяСтрока.Номенклатура.ВидНоменклатуры = Справочники.ВидыНоменклатуры.Отрез Тогда
			Результат = Результат + 1;
		КонецЕсли;
	КонецЦикла;
	Для Каждого ТекущаяСтрока Из Объект.Материалы Цикл
		Если ТекущаяСтрока.Номенклатура.ВидНоменклатуры = Справочники.ВидыНоменклатуры.Потолок
			или ТекущаяСтрока.Номенклатура.ВидНоменклатуры = Справочники.ВидыНоменклатуры.Отрез Тогда
			Результат = Результат + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

&НаСервере
Процедура ДобавитьМатериалНаСервере(НоменклатураМатериала, Комната, Количество, УИСтроки)
	
	Дерево = ДанныеФормыВЗначение(ДеревоМатериалов, Тип("ДеревоЗначений"));
	Для Каждого Строка из Дерево.Строки Цикл
		Если Строка.Комната = Комната Тогда
			Стр = Строка.Строки.Добавить();
			Стр.Номенклатура = НоменклатураМатериала;
			Стр.Комната = Комната;
			
			Стр.ЕдиницаИзмерения = ПолучитьБазовуюЕдиницуИзмеренияНоменклатуры(Стр.Номенклатура);
			Стр.Коэффициент = 1;
			Стр.Количество = Количество;
			
			Стр.УИСтроки = УИСтроки; //Новый УникальныйИдентификатор;
			
			ЗначениеВДанныеФормы(Дерево, ДеревоМатериалов);
			Возврат;
		КонецЕсли
	КонецЦикла;	
	
КонецПроцедуры

