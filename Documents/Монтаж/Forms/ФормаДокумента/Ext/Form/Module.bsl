&НаСервере
Процедура ПолучитьЗаписиИсторииМонтажаИзРегистраНаСервере()
	
	Если Объект.Ссылка.Пустая() Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ИсторияМонтажа.Монтаж КАК Монтаж,
	|	ИсторияМонтажа.Дата КАК Дата,
	|	ИсторияМонтажа.Пользователь КАК Пользователь,
	|	ИсторияМонтажа.ИДЗаписи КАК ИДЗаписи,
	|	ИсторияМонтажа.Комментарий КАК Комментарий
	|ИЗ
	|	РегистрСведений.ИсторияМонтажа КАК ИсторияМонтажа
	|ГДЕ
	|	ИсторияМонтажа.Монтаж = &Монтаж";
	Запрос.УстановитьПараметр("Монтаж", Объект.Ссылка);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Отбор = Новый Структура;
		Отбор.Вставить("ИДЗаписи", Выборка.ИДЗаписи);
		Отбор.Вставить("Дата", Выборка.Дата);
		НайденныеСтроки = ИсторияМонтажаНаФорме.НайтиСтроки(Отбор);
		Если НайденныеСтроки.Количество() = 0 Тогда
			СтрокаЗаписи = ИсторияМонтажаНаФорме.Добавить();
		Иначе
			СтрокаЗаписи = НайденныеСтроки[0];
		КонецЕсли;
		
		СтрокаЗаписи.Дата = Выборка.Дата;
		СтрокаЗаписи.Пользователь = Выборка.Пользователь;
		СтрокаЗаписи.ИДЗаписи = Выборка.ИДЗаписи;
		СтрокаЗаписи.Комментарий = Выборка.Комментарий;
	КонецЦикла;
	
	ИсторияМонтажаНаФорме.Сортировать("Дата Возр");
	
КонецПроцедуры

