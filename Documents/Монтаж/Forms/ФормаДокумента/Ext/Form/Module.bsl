&НаКлиенте
Процедура ВидСкидкиСервиснаяПриИзменении(Элемент)
	
	Если Объект.ВидОперации <> ПредопределенноеЗначение("Справочник.ВидыМонтажа.СервиснаяЗаявка") Тогда
		Возврат;
	КонецЕсли;
	
	ПроцентСкидки = ПолучитьПроцентВидаСкидки(Объект.ВидСкидки);
	
	Для Каждого СтрокаТабличнойЧасти Из Объект.ТоварыУслуги Цикл
		Если НЕ СтрокаТабличнойЧасти.ПроцентСкидки = ПроцентСкидки Тогда
			СтрокаТабличнойЧасти.ПроцентСкидки = ПроцентСкидки;
			СтрокаТабличнойЧасти = Элементы.ТоварыУслуги.ТекущиеДанные;
			ОбработкаТабличныхЧастейКлиентСервер.ПересчитатьСуммуРучнойСкидкиВСтрокеТЧ(СтрокаТабличнойЧасти, "ПроцентСкидки", "СуммаСкидки");
			ОбработкаТабличныхЧастейКлиентСервер.ПересчитатьСуммуСУчетомСкидокВСтрокеТЧ(СтрокаТабличнойЧасти, Ложь, "СуммаСкидки");	
			ОбработкаТабличныхЧастейКлиент.ПересчитатьСуммуНДСВСтрокеТЧ(СтрокаТабличнойЧасти, УчитыватьНДС);			
		КонецЕсли;
	КонецЦикла;
	
	ОбновитьДанныеДокумента();
	
КонецПроцедуры

&НаКлиенте
Процедура ВидОперацииПриИзменении(Элемент)
	
	ЭтоРекламация = (Объект.ВидОперации = ПредопределенноеЗначение("Справочник.ВидыМонтажа.Рекламация"));
	
	ДобавитьЗаписьВИсторию("Изменен вид монтажа на " + Объект.ВидОперации);
	ОбновитьФорму();
	
	ОбновитьДанныеДокумента();
	
	УстановитьЗаголовокФормы();
	УправлениеФормойПоВидуМонтажа();
	
	Если Объект.ВидОперации = ПредопределенноеЗначение("Справочник.ВидыМонтажа.Продажа") Тогда
		ВариантЗаполненияДатыПодписанияПоУмолчанию = ПолучитьВариантЗаполненияДатыПодписания();
		Если ВариантЗаполненияДатыПодписанияПоУмолчанию = ПредопределенноеЗначение("Перечисление.ВариантыЗаполненияДатыПодписанияВМонтаже.НеЗаполнять") Тогда
			Объект.ВариантЗаполненияДатыПодписания = ВариантЗаполненияДатыПодписанияПоУмолчанию;
		Иначе
			Объект.ВариантЗаполненияДатыПодписания = ПредопределенноеЗначение("Перечисление.ВариантыЗаполненияДатыПодписанияВМонтаже.ДатойДокумента");
		КонецЕсли;
		Элементы.ВариантЗаполненияДатыПодписания.ТолькоПросмотр = Истина;
		УправлениеЭлементамиДатыПодписания();
	Иначе	 
		Если Элементы.ВариантЗаполненияДатыПодписания.ТолькоПросмотр Тогда
			Объект.ВариантЗаполненияДатыПодписания = ВариантЗаполненияДатыПодписанияПоУмолчанию;
			УправлениеЭлементамиДатыПодписания();
		КонецЕсли;	
		Элементы.ВариантЗаполненияДатыПодписания.ТолькоПросмотр = Ложь;
	КонецЕсли;
	 
КонецПроцедуры	

