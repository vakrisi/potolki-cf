&НаКлиенте
Процедура ТоварыУслугиСпецификацияПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ТоварыУслуги.ТекущиеДанные;
	
	//Если очистили спецификацию, нужно удалить материалы
	Если мСпецификация <> Неопределено И НЕ мСпецификация.Пустая()
		И ТекущиеДанные.Спецификация.Пустая()
		И ЕстьМатериалыПоТекущейПозиции(ТекущиеДанные.Номенклатура, ТекущиеДанные.УИСтроки) Тогда
		
		ЗадатьВопросОбУдаленииМатериаловПоСпецификации(ТекущиеДанные.Номенклатура, ТекущиеДанные.УИСтроки);
		//УдалитьМатериалыОтносящиесяКПозицииНаСервере(ТекущиеДанные.Номенклатура, ТекущиеДанные.УИСтроки);
		
	ИначеЕсли НЕ ТекущиеДанные.Спецификация.Пустая() Тогда		
		
		ПерезаполнитьМатериалыПоСпецификации(ТекущиеДанные, ,"ИзменениеСпецификации");
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийТоваров_Дерево

&НаКлиенте
Процедура ДеревоТоваровПриИзменении(Элемент)
	ОбновитьДанныеДокумента();
	Элементы.ПотребностьДекорация.Видимость = Истина; // не всегда срабатывает Модифицированность
КонецПроцедуры

&НаКлиенте
Процедура ДеревоТоваровПередНачаломИзменения(Элемент, Отказ)
	
	ТекущиеДанные = Элементы.ДеревоТоваров.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	мСпецификация = ТекущиеДанные.Спецификация;
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоТоваровИспользоватьВТекущемМонтажеПриИзменении(Элемент)

	СтрокаТабличнойЧасти = Элементы.ДеревоТоваров.ТекущиеДанные;
	
	Если СтрокаТабличнойЧасти.ПолучитьРодителя() = Неопределено Тогда
		//проставляем\снимаем галочку со всех подчиненных
		ТекущаяКомната = СтрокаТабличнойЧасти.Комната;
		
		Результат = УстановитьПризнакИспользоватьВТекущемМонтажеДляВсехПодчиненныхСтрокВеткиДереваТоваров(СтрокаТабличнойЧасти.Комната, СтрокаТабличнойЧасти.ИспользоватьВТекущемМонтаже);
		Если Результат.МассивСпецификацийКУдалению.Количество() > 0 Тогда
			ЗадатьВопросОбУдаленииМатериаловПоСпецификациям(Результат.МассивСпецификацийКУдалению);	
		КонецЕсли;
		Если Результат.МассивСпецификацийКДобавлению.Количество() > 0 Тогда
			ПерезаполнитьМатериалыПоСпецификации(СтрокаТабличнойЧасти, Результат.МассивСпецификацийКДобавлению, "ИзменениеСпецификации");	
		КонецЕсли;
		
		РазвернутьДеревоТоваров(ТекущаяКомната, ПредопределенноеЗначение("Справочник.Номенклатура.ПустаяСсылка"));
		
	Иначе
		
		Если СтрокаТабличнойЧасти.ИспользоватьВТекущемМонтаже Тогда
			ОбновитьСтрокуТовараПоДаннымЗаказа(СтрокаТабличнойЧасти);
			
			Если ЗаполнениеМатериаловПоМонтажам 
				//И СтрокаТабличнойЧасти.ВидНоменклатуры = ПредопределенноеЗначение("Справочник.ВидыНоменклатуры.Услуга") // #12667 спецификация только для услуг, в рамках той же заявки отменено
				Тогда
				// №6452 необходимо установить спецификацию
				СтрокаТабличнойЧасти.Спецификация = ОбщийМодульВызовСервера.ПолучитьОсновнуюСпецификациюНоменклатуры(СтрокаТабличнойЧасти.Номенклатура, ВидСпецификацииПоУмолчанию);
				
				Если НЕ СтрокаТабличнойЧасти.Спецификация.Пустая() Тогда
					ПерезаполнитьМатериалыПоСпецификации(СтрокаТабличнойЧасти, ,"ИзменениеСпецификации");
				КонецЕсли;	
			КонецЕсли;

		Иначе
			СтрокаТабличнойЧасти.Количество = 0;			
			//Закомментировано: заполнение поля к списанию должно происходить только по кнопке в ТЧ, заявка #4227
			//Раскомментировано: заявка #4679
			СтрокаТабличнойЧасти.КоличествоКСписанию = СтрокаТабличнойЧасти.Количество;
			СтрокаТабличнойЧасти.Цена = 0;
			СтрокаТабличнойЧасти.Сумма = 0;
			СтрокаТабличнойЧасти.ПроцентСкидки = 0;
			СтрокаТабличнойЧасти.СуммаСкидки = 0;
			
			СтрокаТабличнойЧасти.КоличествоВМонтажах = СтрокаТабличнойЧасти.Количество + СтрокаТабличнойЧасти.КоличествоВДругихМонтажах; //#12608 поле удалено // №12860 раскомментировано
			СтрокаТабличнойЧасти.СуммаНДС = УчетНДС.РассчитатьСуммуНДС(СтрокаТабличнойЧасти.Сумма, УчитыватьНДС, , УчетНДС.ПолучитьСтавкуНДС(СтрокаТабличнойЧасти.СтавкаНДС));
			
			Если ЗаполнениеМатериаловПоМонтажам 
				И НЕ СтрокаТабличнойЧасти.Спецификация.Пустая() 
				И ЕстьМатериалыПоТекущейПозиции(СтрокаТабличнойЧасти.Номенклатура, СтрокаТабличнойЧасти.УИСтроки)
				Тогда		
				ЗадатьВопросОбУдаленииМатериаловПоСпецификации(СтрокаТабличнойЧасти.Номенклатура, СтрокаТабличнойЧасти.УИСтроки);
			КонецЕсли;
			
			//#15230
			Если ОтображатьТрудоемкость Тогда
				СтрокаТабличнойЧасти.Трудоемкость = 0;	
			КонецЕсли;

		КонецЕсли;
		
		//#8758
		ВсеСовпадаютВКомнате = Истина;
		ЭлементКомнаты = СтрокаТабличнойЧасти.ПолучитьРодителя();
		КоллекцияЭлементовКомнаты = ЭлементКомнаты.ПолучитьЭлементы();
		Для каждого СтрокаДерева из КоллекцияЭлементовКомнаты Цикл
			Если НЕ СтрокаДерева.ИспользоватьВТекущемМонтаже = СтрокаТабличнойЧасти.ИспользоватьВТекущемМонтаже Тогда
				ВсеСовпадаютВКомнате = Ложь;	
			КонецЕсли;
		КонецЦикла;
		Если ВсеСовпадаютВКомнате Тогда
			ЭлементКомнаты.ИспользоватьВТекущемМонтаже = СтрокаТабличнойЧасти.ИспользоватьВТекущемМонтаже;
			
		ИначеЕсли ЭлементКомнаты.ИспользоватьВТекущемМонтаже Тогда
			ЭлементКомнаты.ИспользоватьВТекущемМонтаже = Ложь;

		КонецЕсли;
	КонецЕсли;
	
	ЗаполнитьИндексПодсветкиМатериалов();
	
	ОбновитьФлагПривязаныйТоварНеВыбранВМатериалах(); // №11087
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоТоваровНоменклатураПриИзменении(Элемент)
	
	ОбновитьФлагПривязаныйТоварНеВыбранВМатериалах(); // №11087
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоТоваровСпецификацияПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ДеревоТоваров.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
		
	//корневые строки редактировать нельзя
	Если ТекущиеДанные.ПолучитьРодителя() = Неопределено Тогда
		ТекущиеДанные.Спецификация = Неопределено;
		Возврат;
	КонецЕсли;
	
	Если НЕ ТекущиеДанные.ИспользоватьВТекущемМонтаже Тогда
		Возврат;
	КонецЕсли;
	
	ПеренестиДеревоВТабличнуюЧасть();	
	
	//Если очистили спецификацию, нужно удалить материалы
	Если ЗаполнениеМатериаловПоМонтажам
		И мСпецификация <> Неопределено И НЕ мСпецификация.Пустая()
		И ТекущиеДанные.Спецификация.Пустая()
		И ЕстьМатериалыПоТекущейПозиции(ТекущиеДанные.Номенклатура, ТекущиеДанные.УИСтроки) Тогда
			
		ЗадатьВопросОбУдаленииМатериаловПоСпецификации(ТекущиеДанные.Номенклатура, ТекущиеДанные.УИСтроки);
			
	ИначеЕсли НЕ ТекущиеДанные.Спецификация.Пустая() Тогда		
			
		ПерезаполнитьМатериалыПоСпецификации(ТекущиеДанные, ,"ИзменениеСпецификации");
			
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоТоваровЕдиницаИзмеренияПриИзменении(Элемент)
	//корневые строки редактировать нельзя
	Если Элементы.ДеревоТоваров.ТекущиеДанные.ПолучитьРодителя() = Неопределено Тогда
		Элементы.ДеревоТоваров.ТекущиеДанные.ЕдиницаИзмерения = Неопределено;
		Возврат;
	КонецЕсли;
	
	СтрокаТабличнойЧасти = Элементы.ДеревоТоваров.ТекущиеДанные;
	СтрокаТабличнойЧасти.Цена = ПолучитьЦенуНоменклатуры(СтрокаТабличнойЧасти.Номенклатура, СтрокаТабличнойЧасти.ХарактеристикаНоменклатуры, СтрокаТабличнойЧасти.ЕдиницаИзмерения);
	Если ТипЗнч(СтрокаТабличнойЧасти.ЕдиницаИзмерения) = Тип("СправочникСсылка.КлассификаторЕдиницИзмерения") Тогда
		СтрокаТабличнойЧасти.Коэффициент = 1;
	Иначе
		СтрокаТабличнойЧасти.Коэффициент = ОбщийМодуль.ПолучитьКоэффициентЕдиницыИзмерения(СтрокаТабличнойЧасти.ЕдиницаИзмерения);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ДеревоТоваровЕдиницаИзмеренияНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	СтрокаТабличнойЧасти = Элементы.ДеревоТоваров.ТекущиеДанные;
	СписокЕдиниц = ОбщийМодуль.ПолучитьСписокЕдиницИзмеренияНоменклатуры(СтрокаТабличнойЧасти.Номенклатура);
	
	ДанныеВыбора = Новый СписокЗначений;
	Для Ном = 0 По СписокЕдиниц.Количество() - 1 Цикл
		ДанныеВыбора.Добавить(СписокЕдиниц[Ном]);
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ДеревоТоваровЕдиницаИзмеренияОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	СтрокаТабличнойЧасти = Элементы.ДеревоТоваров.ТекущиеДанные;
	Если ТипЗнч(ВыбранноеЗначение) = Тип("СправочникСсылка.КлассификаторЕдиницИзмерения") Тогда
		СтрокаТабличнойЧасти.Коэффициент = 1;
	Иначе
		СтрокаТабличнойЧасти.Коэффициент = ОбщийМодуль.ПолучитьКоэффициентЕдиницыИзмерения(ВыбранноеЗначение);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ДеревоТоваровЦенаПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ДеревоТоваров.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если ТекущиеДанные.ПолучитьРодителя() = Неопределено Тогда
		ТекущиеДанные.Цена = 0;
		Возврат;
	КонецЕсли;

	ТекущиеДанные.Бесплатно = Ложь;

	РассчитатьСуммуСтрокиДереваТоваров(ТекущиеДанные);	
	РассчитатьИтоговыеПоказателиКлиент(Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоТоваровКоличествоПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ДеревоТоваров.ТекущиеДанные;
	
	//корневые строки редактировать нельзя
	Если ТекущиеДанные.ПолучитьРодителя() = Неопределено Тогда
		ТекущиеДанные.Количество = 0;
		Возврат;
	КонецЕсли;
	
	РодительЭлемент = Элементы.ДеревоТоваров.ТекущиеДанные.ПолучитьРодителя();
	ИдКомнаты = РодительЭлемент.ПолучитьИдентификатор();
	
	//#16345
	Если ИспользоватьКонтрольКратности Тогда
		СтруктураДанные = СтруктураДанныхПоСтрокеТабличнойЧасти(ТекущиеДанные);
		ОтказВИзмененииКоличества = Ложь;
		ПроверитьКратностьЕдиницИзмеренияНаСервере(СтруктураДанные, ОтказВИзмененииКоличества);
		Если ОтказВИзмененииКоличества Тогда
			ТекущиеДанные.Количество = 0;
		КонецЕсли;
	КонецЕсли;
	
	ПослеИзмененияКоличестваТоваров(ТекущиеДанные, Ложь);
		
КонецПроцедуры

&НаКлиенте
Процедура ПослеИзмененияКоличестваТоваров(ТекущаяСтрока, Знач ПерезаполнитьСкидки = Истина)
	
	//проставим автоматическую скидку + скидку вида
	Если ПерезаполнитьСкидки Тогда
		ТекущаяСтрока.ПроцентСкидки = ПолучитьПроцентВидаСкидки(Объект.ВидСкидки);
	КонецЕсли;
	
	РассчитатьСуммуСтрокиДереваТоваров(ТекущаяСтрока);
	
	ТекущаяСтрока.КоличествоВыработка = ТекущаяСтрока.Количество;
	ТекущаяСтрока.КоличествоКСписанию = ТекущаяСтрока.Количество;

	РассчитатьИтоговыеПоказателиКлиент(Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоТоваровБесплатноПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ДеревоТоваров.ТекущиеДанные;	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТекущиеДанные.ПолучитьРодителя() = Неопределено Тогда
		// комната
		СтрокиТоваров = ТекущиеДанные.ПолучитьЭлементы();
		Для каждого СтрокаТовара из СтрокиТоваров Цикл
			СтрокаТовара.Бесплатно = ТекущиеДанные.Бесплатно;
			Если ТекущиеДанные.Бесплатно Тогда
				СтрокаТовара.Цена = 0;
				СтрокаТовара.ПроцентСкидки = 0;
				СтрокаТовара.СуммаСкидки = 0;
				СтрокаТовара.Сумма = 0;
				СтрокаТовара.СуммаНДС = 0;
			Иначе                            
				СтрокаТовара.Цена = ПолучитьЦенуНоменклатуры(СтрокаТовара.Номенклатура, СтрокаТовара.ХарактеристикаНоменклатуры, СтрокаТовара.ЕдиницаИзмерения);
				СтрокаТовара.ПроцентСкидки = ПолучитьПроцентВидаСкидки(Объект.ВидСкидки);
				РассчитатьСуммуСтрокиДереваТоваров(СтрокаТовара);
			КонецЕсли;	
		КонецЦикла;
	Иначе
		// номенклатура
		Если ТекущиеДанные.Бесплатно Тогда
			ТекущиеДанные.Цена = 0;
			ТекущиеДанные.ПроцентСкидки = 0;
			ТекущиеДанные.СуммаСкидки = 0;
			ТекущиеДанные.Сумма = 0;
			ТекущиеДанные.СуммаНДС = 0;
		Иначе                            
			ТекущиеДанные.Цена = ПолучитьЦенуНоменклатуры(ТекущиеДанные.Номенклатура, ТекущиеДанные.ХарактеристикаНоменклатуры, ТекущиеДанные.ЕдиницаИзмерения);
			ТекущиеДанные.ПроцентСкидки = ПолучитьПроцентВидаСкидки(Объект.ВидСкидки);
			РассчитатьСуммуСтрокиДереваТоваров(ТекущиеДанные);
		КонецЕсли;
	КонецЕсли;
	
	РассчитатьИтоговыеПоказателиКлиент(Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоТоваровСуммаПриИзменении(Элемент)
	
	СтрокаТабличнойЧасти = Элементы.ДеревоТоваров.ТекущиеДанные;	
	ОбщийМодульКлиент.Розница_ТоварыСуммаПриИзменении(ЭтотОбъект, СтрокаТабличнойЧасти);
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоТоваровПроцентСкидкиПриИзменении(Элемент)
	//корневые строки редактировать нельзя
	Если Элементы.ДеревоТоваров.ТекущиеДанные.ПолучитьРодителя() = Неопределено Тогда
		Элементы.ДеревоТоваров.ТекущиеДанные.ПроцентСкидки = 0;
		Возврат;
	КонецЕсли;
	
	РассчитатьСуммуСтрокиДереваТоваров(Элементы.ДеревоТоваров.ТекущиеДанные);
	РассчитатьИтоговыеПоказателиКлиент(Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоТоваровСуммаСкидкиПриИзменении(Элемент)
	//корневые строки редактировать нельзя
	Если Элементы.ДеревоТоваров.ТекущиеДанные.ПолучитьРодителя() = Неопределено Тогда
		Элементы.ДеревоТоваров.ТекущиеДанные.СуммаСкидки = 0;
		Возврат;
	КонецЕсли;
	
	ТекущаяСтрока = Элементы.ДеревоТоваров.ТекущиеДанные;
	Если НЕ ТекущаяСтрока.СуммаСкидки = 0 Тогда
		Если НЕ ТекущаяСтрока.Количество = 0 и НЕ ТекущаяСтрока.Цена = 0 Тогда
			ТекущаяСтрока.ПроцентСкидки = Окр((ТекущаяСтрока.СуммаСкидки / (ТекущаяСтрока.Количество * ТекущаяСтрока.Цена)) * 100,2);
			РассчитатьСуммуСтрокиДереваТоваров(ТекущаяСтрока, Истина);
		Иначе
			ТекущаяСтрока.ПроцентСкидки = 100;
			РассчитатьСуммуСтрокиДереваТоваров(ТекущаяСтрока, Истина);
		КонецЕсли;
	Иначе 
		ТекущаяСтрока.ПроцентСкидки = 0;
		РассчитатьСуммуСтрокиДереваТоваров(ТекущаяСтрока, Истина);
	КонецЕсли;
	РассчитатьИтоговыеПоказателиКлиент(Истина);
	
КонецПроцедуры

