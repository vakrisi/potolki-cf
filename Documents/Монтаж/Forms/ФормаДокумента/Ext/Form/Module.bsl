&НаСервере
Процедура ПерезаполнитьПотребность()
	
	Если НЕ ИспользоватьВыдачуВозвратВДокументеМонтаж Тогда
		Возврат;
	КонецЕсли;
	
	Потребность.Очистить();
	СтруктураПеремещений = ПолучитьПозицииКПеремещениюПоМонтажу();
		
	Для каждого СтрокаТовара из СтруктураПеремещений.ТЗ_КВыдаче Цикл
		НоваяСтрока = Потребность.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТовара);
		Если НоваяСтрока.Таблица = "Товары" Тогда
			НоваяСтрока.СкладТоваровМатериалов = Объект.СкладТоваров;
		ИначеЕсли НоваяСтрока.Таблица = "Материалы" Тогда
			НоваяСтрока.СкладТоваровМатериалов = Объект.Склад;
		КонецЕсли;
	КонецЦикла;
	
	Для каждого СтрокаТовара из СтруктураПеремещений.ТЗ_КВозврату Цикл
		НоваяСтрока = Потребность.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТовара);
		Если НоваяСтрока.Таблица = "Товары" Тогда
			НоваяСтрока.СкладТоваровМатериалов = Объект.СкладТоваров;
		ИначеЕсли НоваяСтрока.Таблица = "Материалы" Тогда
			НоваяСтрока.СкладТоваровМатериалов = Объект.Склад;
		КонецЕсли;
	КонецЦикла;
	
	Для каждого СтрокаТовара из СтруктураПеремещений.ТЗ_НеТребуется Цикл
		НоваяСтрока = Потребность.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТовара);
		Если НоваяСтрока.Таблица = "Товары" Тогда
			НоваяСтрока.СкладТоваровМатериалов = Объект.СкладТоваров;
		ИначеЕсли НоваяСтрока.Таблица = "Материалы" Тогда
			НоваяСтрока.СкладТоваровМатериалов = Объект.Склад;
		КонецЕсли;
	КонецЦикла;
	
	Потребность.Сортировать("Номенклатура");
		
КонецПроцедуры

