&НаКлиенте
Процедура ДеревоМатериаловИспользоватьВТекущемМонтажеПриИзменении(Элемент)
	
	//Модифицированность = Истина;
	
	СтрокаТабличнойЧасти = Элементы.ДеревоМатериалов.ТекущиеДанные;
	
	Если Элементы.ДеревоМатериалов.ТекущиеДанные.ПолучитьРодителя() = Неопределено Тогда
		//проставляем\снимаем галочку со всех подчиненных
		ТекущаяКомната = СтрокаТабличнойЧасти.Комната;
		
		УстановитьПризнакИспользоватьВТекущемМонтажеДляВсехПодчиненныхСтрокВеткиДереваМатериалов(СтрокаТабличнойЧасти.Комната, СтрокаТабличнойЧасти.ИспользоватьВТекущемМонтаже);
		РазвернутьДеревоМатериалов(ТекущаяКомната, ПредопределенноеЗначение("Справочник.Номенклатура.ПустаяСсылка"));
		
	Иначе		
		Если СтрокаТабличнойЧасти.ИспользоватьВТекущемМонтаже Тогда
			СтрокаТабличнойЧасти.Количество = Макс(0, СтрокаТабличнойЧасти.КоличествоВЗаказДоговоре - СтрокаТабличнойЧасти.КоличествоВДругихМонтажах);
		Иначе
			СтрокаТабличнойЧасти.Количество = 0;
		КонецЕсли;
		СтрокаТабличнойЧасти.КоличествоВМонтажах = СтрокаТабличнойЧасти.Количество + СтрокаТабличнойЧасти.КоличествоВДругихМонтажах;
		
		//#8758
		ВсеСовпадаютВКомнате = Истина;
		ЭлементКомнаты = СтрокаТабличнойЧасти.ПолучитьРодителя();
		КоллекцияЭлементовКомнаты = ЭлементКомнаты.ПолучитьЭлементы();
		Для каждого СтрокаДерева из КоллекцияЭлементовКомнаты Цикл
			Если НЕ СтрокаДерева.ИспользоватьВТекущемМонтаже = СтрокаТабличнойЧасти.ИспользоватьВТекущемМонтаже Тогда
				ВсеСовпадаютВКомнате = Ложь;	
			КонецЕсли;
		КонецЦикла;
		Если ВсеСовпадаютВКомнате Тогда
			ЭлементКомнаты.ИспользоватьВТекущемМонтаже = СтрокаТабличнойЧасти.ИспользоватьВТекущемМонтаже;
			
		ИначеЕсли ЭлементКомнаты.ИспользоватьВТекущемМонтаже Тогда
			ЭлементКомнаты.ИспользоватьВТекущемМонтаже = Ложь;
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура УстановитьПризнакИспользоватьВТекущемМонтажеДляВсехПодчиненныхСтрокВеткиДереваМатериалов(Комната = Неопределено, Установить)
	
	Дерево = ДанныеФормыВЗначение(ДеревоМатериалов, Тип("ДеревоЗначений"));
	Для Каждого ТекущаяКомната Из Дерево.Строки Цикл
		ТекущаяКомната.ИспользоватьВТекущемМонтаже = Установить;
		Если ТекущаяКомната.Комната = Комната ИЛИ Комната = Неопределено Тогда
			Для Каждого ТекущаяНоменклатура Из ТекущаяКомната.Строки Цикл
				ТекущаяНоменклатура.ИспользоватьВТекущемМонтаже = Установить;
				Если ТекущаяНоменклатура.ИспользоватьВТекущемМонтаже Тогда
					// Добавлена проверка на заполненность УИ строки, т.к. если позиция была из поступления, у неё нет количества в заказ-договоре
					Если ЗначениеЗаполнено(ТекущаяНоменклатура.УИСтроки) Тогда
						ТекущаяНоменклатура.Количество = Макс(0, ТекущаяНоменклатура.КоличествоВЗаказДоговоре - ТекущаяНоменклатура.КоличествоВДругихМонтажах);
						ТекущаяНоменклатура.КоличествоВМонтажах = ТекущаяНоменклатура.Количество + ТекущаяНоменклатура.КоличествоВДругихМонтажах;
					КонецЕсли;
				Иначе
					ТекущаяНоменклатура.Количество = 0;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	ЗначениеВДанныеФормы(Дерево, ДеревоМатериалов);
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьМатериал(Команда)
	
	Если Элементы.ДеревоМатериалов.ТекущиеДанные <> Неопределено  Тогда
		Если Не ПустаяСтрока(Элементы.ДеревоМатериалов.ТекущиеДанные.Комната) Тогда
			
			//++ №11160
			ПараметрыПодбора = новый Структура;
			ПараметрыПодбора.Вставить("ТипДокумента", 	"Монтаж");
			ПараметрыПодбора.Вставить("Назначение",		"Материалы");
			//-- №11160
			
			ОткрытьФорму("Справочник.Номенклатура.ФормаВыбора", ПараметрыПодбора,,,,,Новый ОписаниеОповещения("ПослеВыбораНоменклатурыМатериала",ЭтаФорма,Элементы.ДеревоМатериалов.ТекущиеДанные.Комната));
			
		Иначе
			ПоказатьОповещениеПользователя("Выберите комнату");
		КонецЕсли;	
	Иначе
		ПоказатьОповещениеПользователя("Выберите комнату");	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораНоменклатурыМатериала(ВыбЗнач, ДопПараметры) Экспорт
	
	Если НЕ ВыбЗнач = Неопределено Тогда
		
		ПослеВыбораНоменклатурыМатериалаНаСервере(ВыбЗнач, ДопПараметры,, Истина);
		
		//++ №13814
		ДанныеПотолкаПродукции = ПолучитьДанныеПотолкаПродукции(ВыбЗнач, ДопПараметры);
		
		Если ДанныеПотолкаПродукции.ЭтоПродукция Тогда
			
			ВидЗаказа = ПредопределенноеЗначение("Перечисление.ВидыЗаказов.Монтаж"); 
			ОбщийМодульКлиент.РасширеннаяОбработкаДобавленнойПродукции(ЭтаФорма, ВидЗаказа, Истина, ДопПараметры, ДанныеПотолкаПродукции, ДанныеПотолкаПродукции.ЭтоПродукция);
			
		КонецЕсли;
		//-- №13814
		
		ПеренестиДеревоВТабличнуюЧасть();
		ПересчитатьДеревоНаФорме();
		РазвернутьДеревоМатериалов();
		ДобавленнаяСтрока = НайтиСтрокуДереваМатериалов(ДопПараметры, ВыбЗнач);
		Если НЕ ДобавленнаяСтрока = Неопределено Тогда
			Элементы.ДеревоМатериалов.ТекущаяСтрока = ДобавленнаяСтрока.ПолучитьИдентификатор();
		КонецЕсли;
		ДобавленнаяСтрока.ИспользоватьВТекущемМонтаже = Истина;
		
		ОбновитьНадписьВкладкиМатериалы();
		
		ОбновитьФлагПривязаныйТоварНеВыбранВМатериалах(); // №11087
		
		Модифицированность = Истина; //++ №8238
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьДанныеПотолкаПродукции(Номенклатура, Комната)
	
	КВозврату = новый Структура("ЭтоПродукция", Ложь);
	
	Если Справочники.ВидыНоменклатуры.ЭтоНоменклатураУникальногоПотолкаИлиОтреза(Номенклатура)
		Или Справочники.ВидыНоменклатуры.ЭтоНоменклатураПродукция(Номенклатура) Тогда
		
		// Найдём позицию в ТЧ
		ДобавленнаяСтрока = Неопределено;
		ЭлементыДерева = ДеревоМатериалов.ПолучитьЭлементы();
		
		Для Каждого ТекЭлемент из ЭлементыДерева Цикл
			
			ПодчиненныеСтроки = ТекЭлемент.ПолучитьЭлементы();
			Для Каждого ПодчиненыйЭлемент Из ПодчиненныеСтроки Цикл
				
				Если СокрЛП(ПодчиненыйЭлемент.Комната) = СокрЛП(Комната) И ПодчиненыйЭлемент.Номенклатура = Номенклатура Тогда
					
					ДобавленнаяСтрока = ПодчиненыйЭлемент;
					Прервать;
					
				КонецеСли;
				
			КонецЦикла;
			
		КонецЦикла;
		
		Если ДобавленнаяСтрока = Неопределено Тогда
			Возврат КВозврату;
		КонецЕсли;
		
		КВозврату.ЭтоПродукция = Истина;
		
		КВозврату.Вставить("ЭтоПродукция", 		Справочники.ВидыНоменклатуры.ЭтоНоменклатураПродукция(Номенклатура));
		КВозврату.Вставить("Номенклатура", 		Номенклатура);
		КВозврату.Вставить("Количество", 		ДобавленнаяСтрока.Количество);
		КВозврату.Вставить("НомерРасчета", 		ДобавленнаяСтрока.Номенклатура.Потолок_НомерРасчета);
		КВозврату.Вставить("УИСтроки", 			ДобавленнаяСтрока.УИСтроки);
		
	КонецЕсли;
	
	Возврат КВозврату;
	
КонецФункции

&НаСервере
Процедура ПослеВыбораНоменклатурыМатериалаНаСервере(Номенклатура, Комната, СтруктураСтроки = Неопределено, РучноеДобавление = Ложь)
	
	// СтруктураСтроки - приходит структурой, когда заполнение идёт через документ (ПТиУ, перемещение, заказ покупателя)
	
	Характеристика = Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка();
	ЕдиницаИзмерения = ПолучитьБазовуюЕдиницуИзмеренияНоменклатуры(Номенклатура);
	КоличествоКДобавлению = 1;
	Коэффициент = 1;
	Если ТипЗнч(СтруктураСтроки) = Тип("Структура") Тогда
		Характеристика = СтруктураСтроки.Характеристика;
		ЕдиницаИзмерения = СтруктураСтроки.ЕдиницаИзмерения;
		КоличествоКДобавлению = СтруктураСтроки.Количество;
		Коэффициент = СтруктураСтроки.Коэффициент;
	КонецЕсли;
	
	Дерево = ДанныеФормыВЗначение(ДеревоМатериалов, Тип("ДеревоЗначений"));
	Для Каждого Строка из Дерево.Строки Цикл
		Если Строка.Комната = Комната Тогда
			
			//проверим наличе данной номенклатуры в данной комнате. если есть - увеличиваем на единицу, если нет - добавляем новую строку
			Стр = Неопределено;
			
			Для Каждого ТекущаяНоменклатура Из Строка.Строки Цикл
				Если ТекущаяНоменклатура.Номенклатура = Номенклатура
					и ТекущаяНоменклатура.ХарактеристикаНоменклатуры = Характеристика
					и ТекущаяНоменклатура.ЕдиницаИзмерения = ЕдиницаИзмерения
					и ТекущаяНоменклатура.СерияНоменклатуры = Справочники.СерииНоменклатуры.ПустаяСсылка()
					//++ №11087 увеличивать строку при ручном добавлении нужно с пустой привязкой к товарам
					И ((РучноеДобавление И НЕ ЗначениеЗаполнено(ТекущаяНоменклатура.НоменклатураТоваров)) Или НЕ РучноеДобавление)
					//-- №11087
					Тогда
					// Добавлена проверка на структуру, т.к. увеличивать можем если заполнение идёт из ПТиУ, только без УИД строки
					Если СтруктураСтроки <> Неопределено И ЗначениеЗаполнено(ТекущаяНоменклатура.УИСтроки) Тогда
						Продолжить;
					КонецЕсли;
					Стр = ТекущаяНоменклатура;
				КонецЕсли;
			КонецЦикла;
			
			Если Стр = Неопределено Тогда
				Стр = Строка.Строки.Добавить();
				
				Стр.Номенклатура = Номенклатура;
				Стр.Комната = Комната;
				Стр.ХарактеристикаНоменклатуры = Характеристика;
				
				Стр.ЕдиницаИзмерения = ЕдиницаИзмерения;
				Стр.Коэффициент = Коэффициент;
				Стр.Количество = КоличествоКДобавлению;
			Иначе
				Стр.Количество = Стр.Количество + КоличествоКДобавлению;
			КонецЕсли;
			
			// Устанавливаем признак использования в текущем монтаже, т.к. при заполнении из поступления, его нужно выставить сразу
			Если ТипЗнч(СтруктураСтроки) = Тип("Структура") Тогда
				Стр.ИспользоватьВТекущемМонтаже = СтруктураСтроки.ИспользоватьВТекущемМонтаже;
			КонецЕсли;
			
			ЗначениеВДанныеФормы(Дерево, ДеревоМатериалов);
			
			Возврат;
			
		КонецЕсли
	КонецЦикла;	
	
КонецПроцедуры

&НаКлиенте
Функция НайтиСтрокуДереваМатериалов(Комната, Номенклатура)
	ЭлементыДерева = ДеревоМатериалов.ПолучитьЭлементы();
	Для Каждого ТекЭлемент из ЭлементыДерева Цикл
		ПодчиненныеСтроки = ТекЭлемент.ПолучитьЭлементы();
		Для Каждого ПодчиненыйЭлемент Из ПодчиненныеСтроки Цикл
			Если СокрЛП(ПодчиненыйЭлемент.Комната) = СокрЛП(Комната)
				и ПодчиненыйЭлемент.Номенклатура = Номенклатура Тогда
				Возврат ПодчиненыйЭлемент;
			КонецеСли;
		КонецЦикла;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

&НаКлиенте
Процедура ДобавитьПрофильВМатериалы(Команда)
	
	МассивДляДобавленияПрофиля = ПодготовитьМассивДляДобавленияПрофиля();
	Если МассивДляДобавленияПрофиля.Количество() = 0 Тогда
		Сообщить("Для возможности автоматического добавления профиля, предварительно необходимо добавить потолки с заполненным периметром помещения в товары");
	Иначе
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("МассивДляДобавленияПрофиля", МассивДляДобавленияПрофиля);
		
		ОткрытьФорму("ОбщаяФорма.ФормаДобавленияПрофиля", ПараметрыФормы, ЭтаФорма, УникальныйИдентификатор);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПодготовитьМассивДляДобавленияПрофиля()
	
	РезультатТЗ = Новый ТаблицаЗначений;
	РезультатТЗ.Колонки.Добавить("Комната");
	РезультатТЗ.Колонки.Добавить("Количество");
	
	Дерево = ДанныеФормыВЗначение(ДеревоТоваров, Тип("ДеревоЗначений"));
	
	Для каждого ТекущаяКомната из Дерево.Строки Цикл
		Для Каждого СтрокаТЧ Из ТекущаяКомната.Строки Цикл
			Если Справочники.ВидыНоменклатуры.ЭтоНоменклатураПотолкаИлиОтреза(СтрокаТЧ.Номенклатура) 
				И (СтрокаТЧ.ИспользоватьВТекущемМонтаже ИЛИ ЗаполнениеМатериаловПоМонтажам) Тогда
				Если НЕ СтрокаТЧ.Номенклатура.Потолок_ПериметрПомещения = 0 Тогда
					НоваяСтрока = РезультатТЗ.Добавить();
					НоваяСтрока.Комната = СтрокаТЧ.Комната;
					НоваяСтрока.Количество = СтрокаТЧ.Номенклатура.Потолок_ПериметрПомещения;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	РезультатТЗ.Свернуть("Комната", "Количество");	
	Возврат ОбщегоНазначения.ТаблицаЗначенийВМассив(РезультатТЗ);
	
КонецФункции

