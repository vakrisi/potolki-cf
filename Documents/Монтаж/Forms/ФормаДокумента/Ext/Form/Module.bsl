&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	Если ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.Проведение 
		И НЕ Объект.ВидОперации = ПредопределенноеЗначение("Справочник.ВидыМонтажа.Продажа") // №12721
	Тогда
		Если НЕ Объект.СрокМонтажа = ПредопределенноеЗначение("Перечисление.СрокиМонтажа.МонтажНаНесколькоДней") Тогда
			Если НЕ Объект.СрокМонтажа = ПредопределенноеЗначение("Перечисление.СрокиМонтажа.ДатаМонтажаНеОпределена") Тогда
				Если Объект.ДатаМонтажа = Дата("00010101") Тогда
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не указана дата проведения работ!", , "Объект.ДатаМонтажа", , Отказ);
				КонецЕсли;
				Если Объект.ВремяНачала = Дата("00010101") Тогда
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не указано время начала работ!", , "Объект.ВремяНачала", , Отказ);
				КонецЕсли;
				Если Объект.ВремяОкончания = Дата("00010101") Тогда
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не указано время окончания работ!", , "Объект.ВремяОкончания", , Отказ);
				КонецЕсли;
				Если Объект.ВремяОкончания <= Объект.ВремяНачала Тогда
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Время окончания работ меньше или совпадает с временем начала!", , "Объект.ВремяОкончания", , Отказ);
				КонецЕсли;
			КонецЕсли;
		Иначе
			Если Объект.ГрафикМонтажей.Количество() = 0 Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не заполнен график монтажей на несколько дней!", , "Объект.ГрафикМонтажей", , Отказ);			
			Иначе
				Для каждого СтрокаТЧ из Объект.ГрафикМонтажей Цикл
					Если СтрокаТЧ.ВремяОкончания <= СтрокаТЧ.ВремяНачала Тогда
						ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Время окончания работ меньше или совпадает с временем начала!", , "Объект.ГрафикМонтажей[" + Строка((СтрокаТЧ.НомерСтроки -1)) + "].ВремяОкончания", , Отказ);
					КонецЕсли;
				КонецЦикла;
			
			КонецЕсли;		
		КонецЕсли;
		
	КонецЕсли;
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	//++ №12802 комментируем
	//// #11236
	//Если ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.Проведение 
	//	И (Объект.Результат = ПредопределенноеЗначение("Справочник.РезультатыМонтажа.ВРаботе")
	//		ИЛИ Объект.Результат = ПредопределенноеЗначение("Справочник.РезультатыМонтажа.ЧастичноВыполнен")) Тогда
	//	Если АвтоматическиИзменятьДатуМонтажаПриПроведенииПриИзменении И Модифицированность Тогда
	//		Объект.Дата = ТекущаяДата();	
	//	ИначеЕсли АвтоматическиИзменятьДатуМонтажаПриПроведении Тогда
	//		Объект.Дата = ТекущаяДата();
	//	КонецЕсли;
	//	ДатаПриИзмененииНаСервере();
	//КонецЕсли;
	//-- №12802
	
	// #4945
	Если ОтображатьТоварыИМатериалыВВидеДерева() Тогда
		УдаленыНеиспользуемыеСтроки = Ложь;
		КоллекцияЭлементовДерева = ЭтаФорма.ДеревоТоваров.ПолучитьЭлементы();
		Для Каждого Строка Из КоллекцияЭлементовДерева Цикл    
			КоллекцияЭлементовКомнаты = Строка.ПолучитьЭлементы();
			КоличествоЭлементов = КоллекцияЭлементовКомнаты.Количество();
			// обратный перебор для возможности удаления
			Для Индекс = 1 по КоличествоЭлементов Цикл
				СтрокаВКомнате = КоллекцияЭлементовКомнаты[КоличествоЭлементов-Индекс];
				Если НЕ СтрокаВКомнате.ИспользоватьВТекущемМонтаже И ПустаяСтрока(СтрокаВКомнате.УИСтроки) Тогда
					//Сообщить(СтрокаВКомнате.Номенклатура);
					КоллекцияЭлементовКомнаты.Удалить(СтрокаВКомнате);
					УдаленыНеиспользуемыеСтроки = Истина;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
		
		КоллекцияЭлементовДерева = ЭтаФорма.ДеревоМатериалов.ПолучитьЭлементы();
		Для Каждого Строка Из КоллекцияЭлементовДерева Цикл    
			КоллекцияЭлементовКомнаты = Строка.ПолучитьЭлементы();
			КоличествоЭлементов = КоллекцияЭлементовКомнаты.Количество();
			// обратный перебор для возможности удаления
			Для Индекс = 1 по КоличествоЭлементов Цикл
				СтрокаВКомнате = КоллекцияЭлементовКомнаты[КоличествоЭлементов-Индекс];
				Если НЕ ЗаполнениеМатериаловПоМонтажам
					И НЕ СтрокаВКомнате.ИспользоватьВТекущемМонтаже И ПустаяСтрока(СтрокаВКомнате.УИСтроки) Тогда
					//Сообщить(СтрокаВКомнате.Номенклатура);
					КоллекцияЭлементовКомнаты.Удалить(СтрокаВКомнате);
					УдаленыНеиспользуемыеСтроки = Истина;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
		
		Если УдаленыНеиспользуемыеСтроки Тогда
			ПоказатьОповещениеПользователя("Удалены позиции",,"Удалены неиспользуемые в монтаже и отсутствующие в заказ-договоре позиции");	
		КонецЕсли;	

	КонецЕсли;
	
	ПеренестиДеревоВТабличнуюЧасть();
	
	//#12131 Рекламация - это бесплатно
	Если Объект.ВидОперации = ПредопределенноеЗначение("Справочник.ВидыМонтажа.Рекламация") Тогда
		Объект.СуммаДокумента = 0;
		Для Каждого ТекущаяСтрока Из Объект.ТоварыУслуги Цикл
			ТекущаяСтрока.Цена = 0;
			ТекущаяСтрока.Сумма = 0;
			ТекущаяСтрока.ПроцентСкидки = 0;
			ТекущаяСтрока.СуммаСкидки = 0;
			ТекущаяСтрока.СуммаНДС = 0;
		КонецЦикла;
		Для Каждого ТекущаяСтрока Из Объект.Материалы Цикл
			ТекущаяСтрока.Цена = 0;
			ТекущаяСтрока.Сумма = 0;
		КонецЦикла;
	КонецЕсли;
	
	// №1083 очищаем таблицу выработки, если выключена галочка "Ручная корректировка"
	Если НЕ Объект.РучнаяКорректировкаВыработки Тогда
		Объект.Выработка.Очистить();
	КонецЕсли;
	
	СформироватьГрафик();
	
КонецПроцедуры

