Процедура ОбновитьВыделенныеСтрокиТоваров(Команда)
	
	КоллекцияЭлементовДерева = ЭтаФорма.ДеревоТоваров.ПолучитьЭлементы();
	Для Каждого Строка Из КоллекцияЭлементовДерева Цикл    
		Для Каждого СтрокаВКомнате Из Строка.ПолучитьЭлементы() Цикл
			Если СтрокаВКомнате.ИспользоватьВТекущемМонтаже Тогда
				ОбновитьСтрокуТовараПоДаннымЗаказа(СтрокаВКомнате);			
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьПоЗаказДоговору(Команда)
	Режим = РежимДиалогаВопрос.ДаНет;
	Оповещение = Новый ОписаниеОповещения("ПослеВопросаОбОбновленииТоваровПоЗаказДоговору", ЭтаФорма, Параметры);
	ПоказатьВопрос(Оповещение, "Обновить содержимое Товаров и Материалов согласно заказ-договору?", Режим, 0);
КонецПроцедуры

&НаКлиенте
Процедура ПослеВопросаОбОбновленииТоваровПоЗаказДоговору(Результат, Параметры) Экспорт
	
    Если Результат = КодВозвратаДиалога.Нет Тогда
        Возврат;
    КонецЕсли;

	ПеренестиДеревоВТабличнуюЧасть();
	ПерестроитьДеревоНаФорме(, Ложь);
	РазвернутьДеревоТоваров();
	РазвернутьДеревоМатериалов();
	
	ОбновитьДанныеДокумента();
	
	ОбновитьФлагПривязаныйТоварНеВыбранВМатериалах(); // №11087
	
	Модифицированность = Истина;
		
КонецПроцедуры

