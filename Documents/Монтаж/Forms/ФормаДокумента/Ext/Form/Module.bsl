&НаСервере
Процедура ЗаполнитьОстаткиВДереве(ИмяДерева)
	
	ПозицииВДереве = Объект.ТоварыУслуги.Выгрузить();
	ПозицииВДереве.Очистить();
	
	Для Каждого РодительДерева Из ЭтотОбъект[ИмяДерева].ПолучитьЭлементы() Цикл
		Для Каждого ЭлементДерева Из РодительДерева.ПолучитьЭлементы() Цикл
			
			НоваяСтрока = ПозицииВДереве.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ЭлементДерева);
			
		КонецЦикла;
	КонецЦикла;
	
	СкладОстатков = ?(ИмяДерева = "ДеревоТоваров", СкладАнализаОстатковТоваров, СкладАнализаОстатковМатериалов);
	
	ТаблицаСОстатками = ПолучитьОстаткиПоПозициям(ПозицииВДереве, СкладОстатков);
	
	ОбновитьОстаткиВДереве(ТаблицаСОстатками, ИмяДерева);
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьОстаткиВДереве(ТаблицаСОстатками, ИмяДерева)
	
	Для Каждого РодительДерева Из ЭтотОбъект[ИмяДерева].ПолучитьЭлементы() Цикл
		
		Для Каждого ЭлементДерева Из РодительДерева.ПолучитьЭлементы() Цикл
			
			ЭлементДерева.ОстатокНаСкладе 			= 0;
			ЭлементДерева.ВРезерве 					= 0;
			ЭлементДерева.ВРезервеПоТекущемуМонтажу = 0;
			ЭлементДерева.Доступно 					= 0;
			
			Отбор = Новый Структура;
			Отбор.Вставить("Номенклатура", 					ЭлементДерева.Номенклатура);
			Отбор.Вставить("ХарактеристикаНоменклатуры", 	ЭлементДерева.ХарактеристикаНоменклатуры);
			Отбор.Вставить("СерияНоменклатуры", 			ЭлементДерева.СерияНоменклатуры);
			
			НайденныеСтроки = ТаблицаСОстатками.НайтиСтроки(Отбор);
			
			Если НайденныеСтроки.Количество() > 0 Тогда
				
				ЭлементДерева.ОстатокНаСкладе 			= НайденныеСтроки[0].ОстатокНаСкладе;
				ЭлементДерева.ВРезерве 					= НайденныеСтроки[0].КоличествоВРезерве;
				ЭлементДерева.ВРезервеПоТекущемуМонтажу = НайденныеСтроки[0].ВРезервеПоТекущемуМонтажу;
				ЭлементДерева.Доступно 					= ЭлементДерева.ОстатокНаСкладе - ЭлементДерева.ВРезерве + ЭлементДерева.ВРезервеПоТекущемуМонтажу;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

