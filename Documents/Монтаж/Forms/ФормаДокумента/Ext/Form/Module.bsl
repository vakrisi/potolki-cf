Перем СписокВыбораКомнат;
Перем мДатаМонтажа;
Перем мВремяНачала;
Перем мВремяОкончания;

&НаКлиенте
Перем мПредыдущийИдентификатор;
&НаКлиенте
Перем мНоменклатура, мСпецификация;

&НаКлиенте
Перем мТекущийСтатус; // №7111 при переводе закрыт нужно запомнить предыдущий

&НаКлиенте
Перем мДатаВыполнения, мДатаЗакрытия; // №12802


#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ВключитьПредпросмотрФайлов = НЕ Константы.ВыключитьПредпросмотрПрикрепленныхФайловВДокументах.Получить();
	Элементы.ГруппаФайлыПредпросмотр.Видимость = ВключитьПредпросмотрФайлов;
	
	ИспользоватьКонтрольКратности = ПолучитьФункциональнуюОпцию("ИспользоватьКонтрольКратностиЕдиницИзмерения");
	
	Если Параметры.Ключ.Пустая() Тогда
		Если ЗначениеЗаполнено(Объект.Основание) Тогда								
			Элементы.ГруппаСтраниц.ТекущаяСтраница = Элементы.ГруппаСтраницаГрафик;
		КонецЕсли;		
		ДобавитьЗаписьВИсторию("Создан новый монтаж");
	Иначе
		ЭтаФорма.ТолькоПросмотр = ПраваПользователей.ДокументТолькоПросмотр(Объект.Ссылка);
		//++ №8238
		Если ЭтаФорма.ТолькоПросмотр Тогда
			УстановитьЭлементыФормыТолькоПросмотр();
		КонецЕсли;
		//-- №8238
	КонецЕсли;
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	// СтандартныеПодсистемы.УчетОригиналовПервичныхДокументов
	УчетОригиналовПервичныхДокументов.ПриСозданииНаСервере_ФормаДокумента(ЭтотОбъект, Элементы.ГруппаПодвал);
	// Конец СтандартныеПодсистемы.УчетОригиналовПервичныхДокументов 
	
	СофтФонСервер.ПриСозданииНаСервере(ЭтотОбъект);
	МессенджерыСервер.ПриСозданииНаСервере(ЭтотОбъект, Элементы.ГруппаКонтрагентКПМессенджеры);
	
	// СтандартныеПодсистемы.Свойства
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ИмяЭлементаДляРазмещения", "ГруппаДополнительныеРеквизиты");
	ДополнительныеПараметры.Вставить("ОтложеннаяИнициализация", Истина);
	УправлениеСвойствами.ПриСозданииНаСервере(ЭтотОбъект, ДополнительныеПараметры);
	// Конец СтандартныеПодсистемы.Свойства
	
	РеквизитыПользователя = ОбщийМодульСервер.НастройкиПользователя("Сотрудник, 
							|ДополнительныеПраваЗапретРедактированияЦенВДокументах, ДополнительныеПраваЗапретПримененияСкидок,
							|ФильтроватьГрафикМонтажейПоТочкеПродаж, РазрешитьНулевыеЦены,
							|РазрешеноРедактированиеСпособаРаспределенияВыработкиВМонтаже,
							|РазрешеноРедактированиеВидаБригадыВМонтаже,
							|РазрешеноРедактированиеНеконтролируемыхМатериаловВМонтажах,
							|ОграничитьВидимостьМонтажныхБригадПоПодразделениюПользователя, ПодразделениеРозница");
								
	//управление доступностью элементов
	Если РеквизитыПользователя.ДополнительныеПраваЗапретРедактированияЦенВДокументах Тогда
		МассивИменЭлементов = Документы.Монтаж.ПолучитьМассивРеквизитовПоЦенам();
		ОбщийМодульКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы, МассивИменЭлементов, "ТолькоПросмотр", Истина);
	КонецЕсли;
	//#7771
	Если РеквизитыПользователя.ДополнительныеПраваЗапретПримененияСкидок Тогда
		МассивИменЭлементов = Документы.Монтаж.ПолучитьМассивРеквизитовПоСкидкам();
		ОбщийМодульКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы, МассивИменЭлементов, "ТолькоПросмотр", Истина);
	КонецЕсли;
	
	//++ #16248 
	Если РеквизитыПользователя.ОграничитьВидимостьМонтажныхБригадПоПодразделениюПользователя Тогда
		НовыйПараметрВыбора = Новый ПараметрВыбора("Отбор.Подразделение", РеквизитыПользователя.ПодразделениеРозница);	
		МассивПараметровВыбора = Новый Массив;
		МассивПараметровВыбора.Добавить(НовыйПараметрВыбора);	
		Элементы.Бригада.ПараметрыВыбора = Новый ФиксированныйМассив(МассивПараметровВыбора);
	КонецЕсли;
	//-- #16248
					
	Элементы.ПодменюПечать.Доступность = ПраваПользователей.ДоступностьПечати(Объект.Ссылка);
	ПраваПользователей.УстановитьТолькоПросмотрДляРеквизитаНомер(Элементы.Номер.ТолькоПросмотр);
	
	УправлениеФормойНаСервере();
	
	ЭтоРекламация = (Объект.ВидОперации = Справочники.ВидыМонтажа.Рекламация);
	УправлениеФормойПоВидуМонтажа();
	
	// #16346
	УправлениеФормойПоОснованию();	
	
	//#5457
	ИспользоватьВыдачуВозвратВДокументеМонтаж = ПолучитьФункциональнуюОпцию("ИспользоватьВыдачуВозвратВДокументеМонтаж");
	Элементы.СтраницаПотребность.Видимость = ИспользоватьВыдачуВозвратВДокументеМонтаж;
	
	// заполнить список комнат
	// В "1С:Предприятии 8.3" у поля ввода не вызывается НачалоВыбораИзСписка. 
	// Это связано с появлением нового свойства поля ввода КнопкаВыпадающегоСписка
	// код по добавлению элементов в список выбора следует разместить в обработчике формы ПриСозданииНаСервере.
	Если ТипЗнч(Объект.Основание) = Тип("ДокументСсылка.ЗаказДоговор") Тогда
		ТЗ = Объект.ТоварыУслуги.Выгрузить();
		ТЗ.Свернуть("Комната");
		СписокВыбораКомнат = ТЗ.ВыгрузитьКолонку("Комната");
		Элементы.ТоварыУслугиКомната.СписокВыбора.ЗагрузитьЗначения(СписокВыбораКомнат);
		Элементы.ТоварыУслугиКомната.СписокВыбора.СортироватьПоЗначению();
		
		Элементы.МатериалыКомната.СписокВыбора.ЗагрузитьЗначения(СписокВыбораКомнат);
		Элементы.МатериалыКомната.СписокВыбора.СортироватьПоЗначению();
		
		Элементы.ДеревоТоваровКомната.СписокВыбора.ЗагрузитьЗначения(СписокВыбораКомнат);
		Элементы.ДеревоТоваровКомната.СписокВыбора.СортироватьПоЗначению();
	КонецЕсли;
	
	// заполняем список для выбора вариантов	
	СписокВариантов = МодульОтчетов.ПолучитьСписокВариантовГрафикаМонтажей();
	Для каждого ТекЭлемент из СписокВариантов Цикл
		Элементы.Вариант.СписокВыбора.Добавить(ТекЭлемент.Значение, ТекЭлемент.Представление);
	КонецЦикла;
	ВариантОтображенияГрафикаПоУмолчанию = ?(ПолучитьФункциональнуюОпцию("ИспользоватьПулМонтажей"), 4, 2); // #9168
	ВариантОтображенияГрафикаНастройка = ХранилищеОбщихНастроек.Загрузить("ДокументМонтаж", "ВариантОтображенияГрафика");
	//#9168
	//Вариант = ?(ВариантОтображенияГрафикаНастройка = Неопределено, 1, ВариантОтображенияГрафикаНастройка);
	Если ВариантОтображенияГрафикаНастройка = Неопределено Тогда
		Вариант = ВариантОтображенияГрафикаПоУмолчанию;
	ИначеЕсли СписокВариантов.НайтиПоЗначению(ВариантОтображенияГрафикаНастройка) = Неопределено Тогда
		Вариант = ВариантОтображенияГрафикаПоУмолчанию;
	Иначе
		Вариант = ВариантОтображенияГрафикаНастройка;
	КонецЕсли;
	
	//#6985
	НастройкаОформленияГрафикаМонтажей = ОбщийМодульСервер.ПолучитьНастройкуОформленияГрафикаМонтажей(); 
	НастройкиОформленияГрафикаМонтажей = ОбщийМодульСервер.ПолучитьНастройкиОформленияГрафикаМонтажей(НастройкаОформленияГрафикаМонтажей);
	ОбщийМодульСервер.ЗаполнитьГруппуГрафикОформление(ЭтаФорма, НастройкиОформленияГрафикаМонтажей, Элементы.ГруппаГрафикОфорлениеЦвета);
	//++16681
	ОбщийМодульСервер.ОбработкаЗаполненияМенеджера(ЭтаФорма, Метаданные.Документы.Монтаж, РеквизитыПользователя.Сотрудник);
	
	//ПроверитьСоответствиеЗаказДоговору(); перенесено ниже
	
	КСписаниюНеСоответствуетКоличеству = Объект.СлужебныйКоличествоКСписаниюНеСоответствуетКоличествуПроданного; //ПолучитьФункциональнуюОпцию("КоличествоТоваровКСписаниюВРозницеНеСоответствуетКоличествуПроданногоТовара");
	Элементы.ТоварыУслугиКоличествоКСписанию.Видимость = КСписаниюНеСоответствуетКоличеству;
	Элементы.ДеревоТоваровКоличествоКСписанию.Видимость = КСписаниюНеСоответствуетКоличеству;
	Элементы.ТоварыУслугиЗаполнитьКоличествоКСписанию.Видимость = КСписаниюНеСоответствуетКоличеству;
	Элементы.ДеревоТоваровЗаполнитьКоличествоКСписанию.Видимость = КСписаниюНеСоответствуетКоличеству;
	//#4679
	Если НЕ Параметры.Ключ.Пустая() 
		И ПравоДоступа("Изменение", Метаданные.Документы.Монтаж)
		И НЕ ТолькоПросмотр
		И КСписаниюНеСоответствуетКоличеству
		Тогда
		Для каждого СтрокаТабличнойЧасти из Объект.ТоварыУслуги Цикл
			Если Справочники.ВидыНоменклатуры.ЭтоНоменклатураУникальногоПотолкаИлиОтреза(СтрокаТабличнойЧасти.Номенклатура) Тогда
				Если СтрокаТабличнойЧасти.Номенклатура.Потолок_КоличествоПродукция > 0 
					И СтрокаТабличнойЧасти.КоличествоКСписанию <> СтрокаТабличнойЧасти.Номенклатура.Потолок_КоличествоПродукция Тогда
					СтрокаТабличнойЧасти.КоличествоКСписанию = СтрокаТабличнойЧасти.Номенклатура.Потолок_КоличествоПродукция;
					ИзмененоКоличествоКСписаниюПриОткрытии = Истина;
				КонецЕсли;
			КонецЕсли;	
		КонецЦикла;
	КонецЕсли;
	
	Если РеквизитыПользователя.ФильтроватьГрафикМонтажейПоТочкеПродаж Тогда
		Элементы.ФильтрТочкаПродаж.Видимость = Истина;
		ФильтрТочкаПродаж = Объект.ТочкаПродаж;
	КонецЕсли;
		
	Элементы.ГруппаФискальныйРегистратор.Видимость = Константы.ИспользоватьПодключаемоеОборудование.Получить();
	Элементы.ФормаПечатьЧека.Видимость = Элементы.ГруппаФискальныйРегистратор.Видимость;
		
	АвтоматическиСоздаватьДокументыПеремещения = Константы.АвтоматическиСоздаватьДокументыПеремещенияНаОснованииМонтажа.Получить();	
	//++16681
	//СкладАвтоматическогоПеремещения = Константы.СкладПриходРасходПриПеремещенииИзМонтажаБригадам.Получить();	 
	СкладМатериаловПеремещения = Объект.Склад;
	СкладТоваровПеремещения = Объект.СкладТоваров;;
	//--16681
	
	ОсуществлятьПеремещениеВыдача = Константы.ОсуществлятьПеремещениеПоМонтажамСВидомВыдача.Получить();
	ОсуществлятьПеремещениеВозврат = Константы.ОсуществлятьПеремещениеПоМонтажамСВидомВозврат.Получить();
	
	//Элементы.КонтрагентДополнительно.Видимость = Объект.Контрагент.ПоказыватьДопИнформацию;
	ОбщийМодульСервер.ДополнительнаяИнформацияПоКонтрагентуНаФорме(Объект.Контрагент, Элементы.ПоказатьДополнительнуюИнформацию);
	ОбщийМодульСервер.РегулировкаШириныПоляКонтрагента(Элементы, Элементы.Контрагент, Элементы.ПоказатьДополнительнуюИнформацию);
	
	//++16681
	//// №12699 добавили настройку, какой склад для анализа по умолчанию
	//Если ИспользоватьВыдачуВозвратВДокументеМонтаж
	//	И Константы.СкладДляАнализаОстатковВМонтажеПоУмолчанию.Получить() = 0
	//	И ЗначениеЗаполнено(СкладАвтоматическогоПеремещения) Тогда
	//	
	//	СкладАнализаОстатковТоваров 	= СкладАвтоматическогоПеремещения;
	//	СкладАнализаОстатковМатериалов 	= СкладАвтоматическогоПеремещения;
	//Иначе
	//	//++ №11431
	//	СкладАнализаОстатковТоваров 	= Объект.СкладТоваров;
	//	СкладАнализаОстатковМатериалов 	= Объект.Склад;
	//	//-- №11431
	//КонецЕсли;
	//--16681
	
	СкладАнализаОстатковТоваров 	= Объект.СкладТоваров;
	СкладАнализаОстатковМатериалов 	= Объект.Склад;
	
	
	ОтображатьТоварыИМатериалыВВидеДерева = ОтображатьТоварыИМатериалыВВидеДерева();
	ПереключательНаНазваниеКомнат = Константы.ИспользоватьСправочникКомнатВРознице.Получить();
	
	Если ОтображатьТоварыИМатериалыВВидеДерева Тогда
		ТаблицыКакДерево = Истина;
		Элементы.ГруппаТоварыИУслуги.Видимость = Ложь;
		Элементы.ГруппаТоварыИУслугиДерево.Видимость = Истина;
		
		// регулируется выше функцией УправлениеФормойПоВидуМонтажа
		//Элементы.ГруппаМатериалы.Видимость = Ложь;
		//Элементы.ГруппаМатериалыДерево.Видимость = Истина;
		
		ПерестроитьДеревоНаФорме();		
	Иначе
		Элементы.ГруппаТоварыИУслуги.Видимость = Истина;
		Элементы.ГруппаТоварыИУслугиДерево.Видимость = Ложь;
		
		// регулируется выше функцией УправлениеФормойПоВидуМонтажа
		//Элементы.ГруппаМатериалы.Видимость = Истина;
		//Элементы.ГруппаМатериалыДерево.Видимость = Ложь;
		
		ТаблицыКакДерево = Ложь;
	КонецЕсли;
	
	//#15230
	ОтображатьТрудоемкость = ОтображатьТоварыИМатериалыВВидеДерева И ПолучитьФункциональнуюОпцию("ОтображатьТрудоемкостьРаботИУслуг");
	Элементы.ДеревоТоваровТрудоемкость.Видимость = ОтображатьТрудоемкость;
	Элементы.ГруппаИтогоТрудоемкость.Видимость 	 = ОтображатьТрудоемкость;
	Элементы.ИсполнителиКоличествоВыполняемыхНормоЧасовМонтажаЗаЧасВремени.Видимость = ОтображатьТрудоемкость;
	
	ЗаполнитьСтавкуНДСПоОрганизацииСервер();
	
	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
		ПроверитьСоответствиеЗаказДоговору();
	КонецЕсли;
	
	РазрешеноРедактироватьВыполненныеИЗакрытыеМонтажи = ПараметрыСеанса.РазрешеноРедактироватьВыполненныеИЗакрытыеМонтажи;
	
	//проверяем право редактировать выполненные и закрытые монтажи
	// №12802 смотрим на реквизит СозданПриИспользованииСтатусаЗакрыт в документе, было:	//ИспользуетсяСтатусЗакрытВМонтажах = Константы.ИспользоватьСтатусЗакрытВМонтаже.Получить();
	Если ((Объект.СозданПриИспользованииСтатусаЗакрыт И Объект.Результат = Справочники.РезультатыМонтажа.Закрыт)
		ИЛИ (НЕ Объект.СозданПриИспользованииСтатусаЗакрыт И Объект.Результат = Справочники.РезультатыМонтажа.Выполнен))
		И НЕ РазрешеноРедактироватьВыполненныеИЗакрытыеМонтажи Тогда
		
		//++ №8238 комментируем, т.к. будем блокировать всю форму и дополнительно элементы, у которых снят 
		//	признак "Изменяет сохраняемые данные" и они с отложенным действием
		//
		//Элементы.ГруппаСтраницаМонтаж.ТолькоПросмотр = Истина;
		//Элементы.ГруппаСодержание.ТолькоПросмотр = Истина;
		//Элементы.ГруппаСтраницаГрафик.ТолькоПросмотр = Истина;
		//Элементы.ГруппаИсполнители.ТолькоПросмотр = Истина;
		//Элементы.ГруппаТоварыИУслуги.ТолькоПросмотр = Истина;
