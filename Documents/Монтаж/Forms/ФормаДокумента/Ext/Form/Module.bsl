			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
		
	Модифицированность = Истина;
	
	СформироватьГрафик(ТекущаяСтрока);		
	
КонецПроцедуры

&НаКлиенте
Процедура РезультатПланировщикПриОкончанииРедактирования(Элемент, НовыйЭлемент, ОтменаРедактирования)
	
	ОчиститьСообщения();
	
	Если Элемент.ВыделенныеЭлементы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если Элемент.ВыделенныеЭлементы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ИндексСтроки = 0;
	//СтруктураДанныхМонтажа = Новый Структура("ДатаМонтажа, ВремяНачала, ВремяОкончания");
	ТекущийОбъект = Неопределено;
	Если НЕ Объект.СрокМонтажа = ПредопределенноеЗначение("Перечисление.СрокиМонтажа.МонтажНаНесколькоДней") Тогда
		ТекущийОбъект = Объект;
	Иначе
		ТекущиеДанные = Элементы.ГрафикМонтажей.ТекущиеДанные;	
		Если НЕ ТекущиеДанные = Неопределено Тогда
			ТекущийОбъект = ТекущиеДанные;
			ИндексСтроки = ТекущиеДанные.НомерСтроки;
		КонецЕсли;
	КонецЕсли;
	Если НЕ ТекущийОбъект = Неопределено Тогда
		//ЗаполнитьЗначенияСвойств(СтруктураДанныхМонтажа, ТекущийОбъект);
	Иначе
		ОтменаРедактирования = Истина;
		Возврат;
	КонецЕсли;
	
	ЭлементМонтажа = Элемент.ВыделенныеЭлементы[0];
	
	// разрешаем перенос только редактируемого монтажа
	Если НЕ Объект.Ссылка = ЭлементМонтажа.Значение.Регистратор ИЛИ НЕ ИндексСтроки = ЭлементМонтажа.Значение.ИндексСтроки Тогда
		ОтменаРедактирования = Истина;
		Возврат;
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ДатаМонтажа", 			НачалоДня(ЭлементМонтажа.Начало));
	ДополнительныеПараметры.Вставить("ВремяНачала", 			Дата('00010101') + (ЭлементМонтажа.Начало - НачалоДня(ЭлементМонтажа.Начало)));
	ДополнительныеПараметры.Вставить("ВремяОкончания",  		Дата('00010101') + (ЭлементМонтажа.Конец  - НачалоДня(ЭлементМонтажа.Начало)));
	ДополнительныеПараметры.Вставить("ИндексСтроки",			ЭлементМонтажа.Значение.ИндексСтроки);	
	ДополнительныеПараметры.Вставить("Бригада", 				ЭлементМонтажа.ЗначенияИзмерений["Бригада"]);
	ДополнительныеПараметры.Вставить("ИДМонтажа", 				ЭлементМонтажа.Значение.ИДМонтажа);		
	
	// #9168
	Если (Объект.Результат = ПредопределенноеЗначение("Справочник.РезультатыМонтажа.Выполнен") ИЛИ Объект.Результат = ПредопределенноеЗначение("Справочник.РезультатыМонтажа.Закрыт"))
		И НЕ ТипЗнч(ДополнительныеПараметры.Бригада) = Тип("СправочникСсылка.Бригады") Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Запрещен перенос в пул по выполненным монтажам!", , , , ОтменаРедактирования);
		Возврат;
	КонецЕсли;
	
	//++ №14004 если растянули на несколько дней, автоматически взводим галочку "На несколько дней" и добавляем выбранные даты в график
	МассивНаНесколькоДней = новый Массив;
	
	Если НЕ Объект.СрокМонтажа = ПредопределенноеЗначение("Перечисление.СрокиМонтажа.МонтажНаНесколькоДней") И (НачалоДня(ЭлементМонтажа.Конец) - НачалоДня(ЭлементМонтажа.Начало)) > 0 Тогда
		
		КоличествоДней = (НачалоДня(ЭлементМонтажа.Конец) - НачалоДня(ЭлементМонтажа.Начало)) / 86400;
		
		Для Сч = 0 По КоличествоДней Цикл
			
			ВремяНачала = ?(Сч = 0,
				Дата('00010101') + (ЭлементМонтажа.Начало - НачалоДня(ЭлементМонтажа.Начало)),
				НастройкиГрафика.ВремяНачалаМонтажей
			);
				
			ВремяОкончания = ?(Сч = КоличествоДней,
				Дата('00010101') + (ЭлементМонтажа.Конец  - НачалоДня(ЭлементМонтажа.Конец)),
				НастройкиГрафика.ВремяКонцаМонтажей
			);
			
			ДопПараметры = Новый Структура;
			ДопПараметры.Вставить("ДатаМонтажа", 			НачалоДня(ЭлементМонтажа.Начало) + (Сч * 86400));
			ДопПараметры.Вставить("ВремяНачала", 			ВремяНачала);
			ДопПараметры.Вставить("ВремяОкончания",  		ВремяОкончания);
			ДопПараметры.Вставить("ИндексСтроки",			ЭлементМонтажа.Значение.ИндексСтроки);
			ДопПараметры.Вставить("Бригада", 				ЭлементМонтажа.ЗначенияИзмерений["Бригада"]);
			ДопПараметры.Вставить("ИДМонтажа", 				ЭлементМонтажа.Значение.ИДМонтажа);
			
			СтруктураПроверкиИнтервала = ПроверитьСвободныйИнтервалМонтажей(ДопПараметры, Объект.ГрафикМонтажей, ФильтрТочкаПродаж);
			
			Если НЕ СтруктураПроверкиИнтервала.Результат Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтруктураПроверкиИнтервала.ТекстОшибки, , , , ОтменаРедактирования);
				//++17113
				//СформироватьГрафик();
				СформироватьГрафик(Элементы.ГрафикМонтажей.ТекущаяСтрока);
				//++17113
				Возврат;
			КонецЕсли;
			
			МассивНаНесколькоДней.Добавить(ДопПараметры);
			
		КонецЦикла;
		
	КонецЕсли;
	//-- №14004
	
	СтруктураПроверкиИнтервала = ПроверитьСвободныйИнтервалМонтажей(ДополнительныеПараметры, Объект.ГрафикМонтажей, ФильтрТочкаПродаж);
	Если НЕ СтруктураПроверкиИнтервала.Результат Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтруктураПроверкиИнтервала.ТекстОшибки, , , , ОтменаРедактирования);
		//++17113
		//СформироватьГрафик();
		СформироватьГрафик(Элементы.ГрафикМонтажей.ТекущаяСтрока);
		//++17113
		Возврат;
	КонецЕсли;
		
	Если ОтменаРедактирования Тогда
		Возврат;
	КонецЕсли;
	
	ВыбраннаяБригада = ?(ТипЗнч(ДополнительныеПараметры.Бригада) = Тип("Строка"), ПредопределенноеЗначение("Справочник.Бригады.ПустаяСсылка"), ДополнительныеПараметры.Бригада);
	ТребуетсяСобытиеБригадаПриИзменении = (ВыбраннаяБригада <> Объект.Бригада);
	Объект.Бригада = ВыбраннаяБригада;
	Если ВыбраннаяБригада.Пустая() Тогда
		//#9168
		Объект.Бригадир = ПредопределенноеЗначение("Справочник.Сотрудники.ПустаяСсылка");
	КонецЕсли;
	СтараяБригада = Объект.Бригада;
	
	ТекущийОбъект = Неопределено;
	
	//++ №14004 если растянули на несколько дней, автоматически взводим галочку "На несколько дней" и добавляем выбранные даты в график
	Если МассивНаНесколькоДней.Количество() > 0 Тогда
		
		Объект.НаНесколькоДней = Истина;
		Объект.ГрафикМонтажей.Очистить(); // ? 
		
		Для Каждого ТекущаяСтрока Из МассивНаНесколькоДней Цикл
			
			НоваяСтрока = Объект.ГрафикМонтажей.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущаяСтрока);
			
		КонецЦикла;
		
		УправлениеФормойНаСервере();
		
	//-- №14004
	ИначеЕсли НЕ Объект.СрокМонтажа = ПредопределенноеЗначение("Перечисление.СрокиМонтажа.МонтажНаНесколькоДней") Тогда
		
		ЗаполнитьЗначенияСвойств(Объект, ДополнительныеПараметры, "ДатаМонтажа, ВремяНачала, ВремяОкончания");
		//ТребуетсяСобытиеБригадаПриИзменении = Истина;
		
	Иначе
		ТекущиеДанные = Элементы.ГрафикМонтажей.ТекущиеДанные;	
		Если НЕ ТекущиеДанные = Неопределено Тогда
			ЗаполнитьЗначенияСвойств(ТекущиеДанные, ДополнительныеПараметры, "ДатаМонтажа, ВремяНачала, ВремяОкончания");
			//ТребуетсяСобытиеБригадаПриИзменении = (ТекущиеДанные.НомерСтроки = 1);
		КонецЕсли;
	КонецЕсли;
	
	Если ТребуетсяСобытиеБригадаПриИзменении Тогда
		БригадаПриИзмененииКлиент();
	КонецЕсли;
	Модифицированность = Истина;
	
	//#9168 актуализируем график
	//++17113
	//СформироватьГрафик();
	СформироватьГрафик(Элементы.ГрафикМонтажей.ТекущаяСтрока);
	//++17113

	
КонецПроцедуры

