		Возврат;
	КонецЕсли;	
	//Если ТекущиеДанные.ДатаМонтажа >= ДатаНачала И ТекущиеДанные.ДатаМонтажа <= ДатаОкончания Тогда
	//	Возврат;	
	//КонецЕсли;
	//++17113
	// ОбщийМодульКлиент.ПриИзмененииДатыНачалаГрафика(ЭтотОбъект);
	
