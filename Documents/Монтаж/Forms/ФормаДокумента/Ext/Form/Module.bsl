&НаКлиенте
Процедура ВариантЗаполненияДатыПодписанияПриИзменении(Элемент)
	
	Если Объект.ВариантЗаполненияДатыПодписания = ПредопределенноеЗначение("Перечисление.ВариантыЗаполненияДатыПодписанияВМонтаже.ПустаяСсылка") Тогда
		Объект.ВариантЗаполненияДатыПодписания = ПредопределенноеЗначение("Перечисление.ВариантыЗаполненияДатыПодписанияВМонтаже.НеЗаполнять");
	КонецЕсли;

	Если НЕ Объект.ВариантЗаполненияДатыПодписания = ПредопределенноеЗначение("Перечисление.ВариантыЗаполненияДатыПодписанияВМонтаже.ПроизвольнаяДата") Тогда
		Объект.ДатаПодписанияДокументов = Дата(1,1,1);
	КонецЕсли;
		
	УправлениеЭлементамиДатыПодписания();
	
КонецПроцедуры

&НаСервере
Процедура УправлениеЭлементамиДатыПодписания()
	
	Элементы.ВариантЗаполненияДатыПодписания.ТолькоПросмотр = (Объект.ВидОперации = ПредопределенноеЗначение("Справочник.ВидыМонтажа.Продажа"));
			
	Элементы.НадписьДатаДокумента.Видимость = Ложь;
	Элементы.НадписьДатойВыполненияМонтажа.Видимость = Ложь;
	Элементы.НадписьПлановойДатойНачалаМонтажа.Видимость = Ложь;
	Элементы.НадписьПлановаяДатаОкончанияМонтажа.Видимость = Ложь;
	Элементы.ДатаПодписанияДокументов.Видимость = Ложь;
	
	Если Объект.ВариантЗаполненияДатыПодписания = Перечисления.ВариантыЗаполненияДатыПодписанияВМонтаже.ДатойДокумента Тогда
		Элементы.НадписьДатаДокумента.Видимость = Истина;

	ИначеЕсли Объект.ВариантЗаполненияДатыПодписания = Перечисления.ВариантыЗаполненияДатыПодписанияВМонтаже.ДатойВыполненияМонтажа Тогда
		Элементы.НадписьДатойВыполненияМонтажа.Видимость = Истина;

	ИначеЕсли Объект.ВариантЗаполненияДатыПодписания = Перечисления.ВариантыЗаполненияДатыПодписанияВМонтаже.ПлановойДатойНачалаМонтажа Тогда
		Элементы.НадписьПлановойДатойНачалаМонтажа.Видимость = Истина;

	ИначеЕсли Объект.ВариантЗаполненияДатыПодписания = Перечисления.ВариантыЗаполненияДатыПодписанияВМонтаже.ПлановойДатойЗавершенияМонтажа Тогда
		РасчетнаяДатаПодписанияДокументов = Дата(1,1,1);
		Если Объект.СрокМонтажа = Перечисления.СрокиМонтажа.МонтажНаНесколькоДней Тогда
			Для каждого Запись из Объект.ГрафикМонтажей Цикл
				РасчетнаяДатаПодписанияДокументов = ?(РасчетнаяДатаПодписанияДокументов < Запись.ДатаМонтажа, Запись.ДатаМонтажа, РасчетнаяДатаПодписанияДокументов);
			КонецЦикла
		Иначе	
			РасчетнаяДатаПодписанияДокументов = Объект.ДатаВыполнения;
		КонецЕсли;
		Элементы.НадписьПлановаяДатаОкончанияМонтажа.Видимость = Истина;

	ИначеЕсли Объект.ВариантЗаполненияДатыПодписания = Перечисления.ВариантыЗаполненияДатыПодписанияВМонтаже.НеЗаполнять  Тогда
	
	ИначеЕсли Объект.ВариантЗаполненияДатыПодписания = Перечисления.ВариантыЗаполненияДатыПодписанияВМонтаже.ПроизвольнаяДата Тогда
		Элементы.ДатаПодписанияДокументов.Видимость = Истина;
		
	КонецЕсли;
	
КонецПроцедуры
