#КонецОбласти

//проверяет соответствие товаров и услуг монтажа товарам и услугам заказ-договора
//если монтажей еще нет, поле "Результат" окрашивается в желтый цвет
//если количество и состав номенклатуры по комнатам полностью соответствует заказ договору, поле "Результат" окрашивается в зеленый цвет, иначе - в красный
&НаСервере
Процедура ПроверитьСоответствиеЗаказДоговору()
	
	// #16346 проверяем для всех, если на основании ЗД
	//Если НЕ Объект.ВидОперации = Справочники.ВидыМонтажа.Монтаж Тогда
	//	ПоказатьКнопкуОтчетаСравненияСМонтажами = Ложь;
	//	Возврат;
	//КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Объект.Основание)
		ИЛИ НЕ ТипЗнч(Объект.Основание) = тип("ДокументСсылка.ЗаказДоговор") Тогда
		ПоказатьКнопкуОтчетаСравненияСМонтажами = Ложь;
		Возврат;
	КонецЕсли;
	Если Объект.ВидОперации = Справочники.ВидыМонтажа.Монтаж и НЕ Объект.Основание.ВидЗаказа = Справочники.ВидыЗаказДоговоров.Договор Тогда
		ПоказатьКнопкуОтчетаСравненияСМонтажами = Истина;
		Возврат;
	КонецЕсли;
	Если Объект.ВидОперации = Справочники.ВидыМонтажа.Рекламация и НЕ Объект.Основание.ВидЗаказа = Справочники.ВидыЗаказДоговоров.Рекламация Тогда
		ПоказатьКнопкуОтчетаСравненияСМонтажами = Истина;
		Возврат;
	КонецЕсли;
	Если Объект.ВидОперации = Справочники.ВидыМонтажа.СервиснаяЗаявка и НЕ Объект.Основание.ВидЗаказа = Справочники.ВидыЗаказДоговоров.СервиснаяЗаявка Тогда
		ПоказатьКнопкуОтчетаСравненияСМонтажами = Истина;
		Возврат;
	КонецЕсли;
	
	
	
	Если ОтображатьТоварыИМатериалыВВидеДерева() Тогда
		
		ПоказатьКнопкуОтчетаСравненияСМонтажами = Ложь;
		
		// #16346 проверяем также вид операции
		Если НЕ Объект.ВидОперации = Справочники.ВидыМонтажа.Продажа Тогда
			ВидЗаказа = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Основание, "ВидЗаказа");
			СоответствующийВидОперацииМонтажа = ОбщийМодульСервер.ВидОперацииМонтажаПоВидуЗаказа(ВидЗаказа);
		    Если НЕ Объект.ВидОперации = СоответствующийВидОперацииМонтажа Тогда
				ПоказатьКнопкуОтчетаСравненияСМонтажами = Истина;
				Возврат; 
			КонецЕсли;
		КонецЕсли;
		
		Дерево = ДанныеФормыВЗначение(ДеревоТоваров, Тип("ДеревоЗначений"));
		Для Каждого РодительскаяСтрока Из Дерево.Строки Цикл
			Для Каждого ТекСтрока Из РодительскаяСтрока.Строки Цикл
				Если ТекСтрока.ИспользоватьВТекущемМонтаже Тогда
					Если НЕ ТекСтрока.КоличествоВМонтажах = ТекСтрока.КоличествоВЗаказДоговоре
						ИЛИ НЕ ТекСтрока.Цена = ТекСтрока.ЦенаВЗаказДоговоре
						ИЛИ НЕ ТекСтрока.Сумма = ТекСтрока.СуммаВЗаказДоговоре
						ИЛИ НЕ ТекСтрока.ПроцентСкидки = ТекСтрока.ПроцентСкидкиВЗаказДоговоре
						ИЛИ НЕ ТекСтрока.СуммаСкидки = ТекСтрока.СуммаСкидкиВЗаказДоговоре
						Тогда
							ПоказатьКнопкуОтчетаСравненияСМонтажами = Истина;
							Прервать;
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
		
	Иначе
		
		Если ТипЗнч(Объект.Основание) = Тип("ДокументСсылка.ЗаказДоговор") Тогда
			
			ПолноеСоответсвтие = Истина;
			
			ТаблицаТоваровМонтажа = Новый ТаблицаЗначений;
			ТаблицаТоваровМонтажа.Колонки.Добавить("Комната");
			ТаблицаТоваровМонтажа.Колонки.Добавить("Номенклатура");
			ТаблицаТоваровМонтажа.Колонки.Добавить("Количество");
			ТаблицаТоваровМонтажа.Колонки.Добавить("Сумма");
			ТаблицаТоваровМонтажа.Колонки.Добавить("Цена");
			ТаблицаТоваровМонтажа.Колонки.Добавить("ПроцентСкидки");
			ТаблицаТоваровМонтажа.Колонки.Добавить("СуммаСкидки");
			ТаблицаТоваровМонтажа.Колонки.Добавить("ХарактеристикаНоменклатуры");
			
			ТаблицаТоваровДоговора = Новый ТаблицаЗначений;
			ТаблицаТоваровДоговора.Колонки.Добавить("Комната");
			ТаблицаТоваровДоговора.Колонки.Добавить("Номенклатура");
			ТаблицаТоваровДоговора.Колонки.Добавить("Количество");
			ТаблицаТоваровДоговора.Колонки.Добавить("Сумма");
			ТаблицаТоваровДоговора.Колонки.Добавить("Цена");
			ТаблицаТоваровДоговора.Колонки.Добавить("ПроцентСкидки");
			ТаблицаТоваровДоговора.Колонки.Добавить("СуммаСкидки");
			ТаблицаТоваровДоговора.Колонки.Добавить("ХарактеристикаНоменклатуры");

			
			СписокКомнат = ПолучитьСписокКомнтат();
			
			Для Каждого СтрокаНоменклатуры Из Объект.ТоварыУслуги Цикл
				Если НЕ СписокКомнат.НайтиПоЗначению(СтрокаНоменклатуры.Комната) = Неопределено Тогда
					НоваяСтрока = ТаблицаТоваровМонтажа.Добавить();
					НоваяСтрока.Комната = СтрокаНоменклатуры.Комната;
					НоваяСтрока.Номенклатура = СтрокаНоменклатуры.Номенклатура;
					НоваяСтрока.Количество = СтрокаНоменклатуры.Количество * СтрокаНоменклатуры.Коэффициент;
					НоваяСтрока.Сумма = СтрокаНоменклатуры.Сумма;
					НоваяСтрока.Цена = СтрокаНоменклатуры.Цена;
					НоваяСтрока.ПроцентСкидки = СтрокаНоменклатуры.ПроцентСкидки;
					НоваяСтрока.СуммаСкидки = СтрокаНоменклатуры.СуммаСкидки;
					НоваяСтрока.ХарактеристикаНоменклатуры = СтрокаНоменклатуры.ХарактеристикаНоменклатуры;
				КонецЕсли;
			КонецЦикла;
			
			Для Каждого СтрокаНоменклатуры Из Объект.Основание.ТоварыУслуги Цикл
				Если НЕ СписокКомнат.НайтиПоЗначению(СтрокаНоменклатуры.Комната) = Неопределено Тогда
					НоваяСтрока = ТаблицаТоваровДоговора.Добавить();
					НоваяСтрока.Комната = СтрокаНоменклатуры.Комната;
					НоваяСтрока.Номенклатура = СтрокаНоменклатуры.Номенклатура;
					НоваяСтрока.Количество = СтрокаНоменклатуры.Количество * СтрокаНоменклатуры.Коэффициент;
					НоваяСтрока.Сумма = СтрокаНоменклатуры.Сумма;
					НоваяСтрока.Цена = СтрокаНоменклатуры.Цена;
					НоваяСтрока.ПроцентСкидки = СтрокаНоменклатуры.ПроцентСкидки;
					НоваяСтрока.СуммаСкидки = СтрокаНоменклатуры.СуммаСкидки;
					НоваяСтрока.ХарактеристикаНоменклатуры = СтрокаНоменклатуры.ХарактеристикаНоменклатуры;
				КонецЕсли;
			КонецЦикла;

			
			ТаблицаТоваровМонтажа.Свернуть("Комната, Номенклатура, Цена, ПроцентСкидки, ХарактеристикаНоменклатуры","Количество, Сумма, СуммаСкидки");
			ТаблицаТоваровДоговора.Свернуть("Комната, Номенклатура, Цена, ПроцентСкидки, ХарактеристикаНоменклатуры","Количество, Сумма, СуммаСкидки");
			ТаблицаТоваровДоговора.Колонки.Добавить("Разобран",Новый ОписаниеТипов("булево"));
			
			Для Каждого СтрокаТоварыМонтажа Из ТаблицаТоваровМонтажа Цикл
				Отбор = Новый Структура;
				Отбор.Вставить("Комната",СтрокаТоварыМонтажа.Комната);
				Отбор.Вставить("Номенклатура",СтрокаТоварыМонтажа.Номенклатура);
				Отбор.Вставить("Цена",СтрокаТоварыМонтажа.Цена);
				Отбор.Вставить("ПроцентСкидки",СтрокаТоварыМонтажа.ПроцентСкидки);
				Отбор.Вставить("ХарактеристикаНоменклатуры",СтрокаТоварыМонтажа.ХарактеристикаНоменклатуры);
				Отбор.Вставить("Количество",СтрокаТоварыМонтажа.Количество);
				Отбор.Вставить("Сумма",СтрокаТоварыМонтажа.Сумма);
				Отбор.Вставить("СуммаСкидки",СтрокаТоварыМонтажа.СуммаСкидки);
				Отбор.Вставить("Разобран",Ложь);
				НайденныеСтроки = ТаблицаТоваровДоговора.НайтиСтроки(Отбор);
				Если НайденныеСтроки.Количество() = 0 тогда
					ПолноеСоответсвтие = Ложь;
					Прервать;
				Иначе
					НайденныеСтроки[0].Разобран = Истина;
				КонецЕсли;
			КонецЦикла;
			
			Если ПолноеСоответсвтие Тогда
				//Элементы.Результат.ЦветФона = WebЦвета.БледноЗеленый;
				ПоказатьКнопкуОтчетаСравненияСМонтажами = Ложь;
			Иначе
				//Элементы.Результат.ЦветФона = WebЦвета.Лосось;
				ПоказатьКнопкуОтчетаСравненияСМонтажами = Истина;
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьСписокКомнтат()
	
	ВремКомнаты = Объект.ТоварыУслуги.Выгрузить(,"Комната");
	ВремКомнаты.Свернуть("Комната");
	
	СписокКомнат = Новый СписокЗначений;
	Для Каждого ВремСтрока Из ВремКомнаты Цикл
		СписокКомнат.Добавить(ВремСтрока.Комната);
	КонецЦикла;
	
	Возврат СписокКомнат;
	
КонецФункции

&НаКлиенте
Процедура ПоказатьОтчетСравнениеСМонтажами(Команда)
	
	
	ПараметрыОтчета  = Новый Структура;
	ПараметрыОтчета.Вставить("ЗаказДоговор", Объект.Основание);
	ПараметрыОтчета.Вставить("Монтаж", Объект.Ссылка);
	ПараметрыОтчета.Вставить("Комнаты", ПолучитьСписокКомнтат());
	ОткрытьФорму("Отчет.СравнениеЗаказДоговораСМонтажами.ФормаОбъекта", ПараметрыОтчета);
	
КонецПроцедуры

