&НаСервере
Процедура ПослеОтветаОПерезаполненииЦенНаСервере()
	
	Для Каждого ТекущаяСтрока Из Объект.ТоварыУслуги Цикл
		
		ТекущаяСтрока.Цена = 0;
		ТекущаяСтрока.ПроцентСкидки = 0;
		ТекущаяСтрока.СуммаСкидки = 0;
		ТекущаяСтрока.Сумма = 0;
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЗаказДоговорТоварыУслуги.Количество КАК Количество,
		|	ЗаказДоговорТоварыУслуги.Цена КАК Цена,
		|	ЗаказДоговорТоварыУслуги.ПроцентСкидки КАК ПроцентСкидки,
		|	ЗаказДоговорТоварыУслуги.СуммаСкидки КАК СуммаСкидки,
		|	ЗаказДоговорТоварыУслуги.Сумма КАК Сумма
		|ИЗ
		|	Документ.ЗаказДоговор.ТоварыУслуги КАК ЗаказДоговорТоварыУслуги
		|ГДЕ
		|	ЗаказДоговорТоварыУслуги.Ссылка = &Ссылка
		|	И ЗаказДоговорТоварыУслуги.Комната = &Комната
		|	И ЗаказДоговорТоварыУслуги.Номенклатура = &Номенклатура";
		Запрос.УстановитьПараметр("Ссылка", Объект.Основание);
		Запрос.УстановитьПараметр("Комната", ТекущаяСтрока.Комната);
		Запрос.УстановитьПараметр("Номенклатура", ТекущаяСтрока.Номенклатура);
		ВыборкаТЗ = Запрос.Выполнить().Выгрузить();
		Если ВыборкаТЗ.Количество() > 0 Тогда
			// сначала ищем совпадение по количеству на случай наличия одинаковых позиций
			НайденныеСтроки = ВыборкаТЗ.НайтиСтроки(Новый Структура("Количество", ТекущаяСтрока.Количество));
			Если НайденныеСтроки.Количество() > 0 Тогда
				//Тут нужна проверка для более 2х записей, что уже заполнено с таким количество и ценой.
				//Может быть ситуация: две позиции с одной номенклатурой и с одним количеством но разными ценами
				Если НайденныеСтроки.Количество() = 1 Тогда
					ЗаполнитьЗначенияСвойств(ТекущаяСтрока, НайденныеСтроки[0]);
				Иначе
					//Попробуем найти в ТЧ такую строчку, если уже есть пропускаем
					Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
						СтруткураПоиска = новый Структура("Комната, Номенклатура, Количество, Цена", 
							ТекущаяСтрока.Комната, ТекущаяСтрока.Номенклатура, ТекущаяСтрока.Количество, НайденнаяСтрока.Цена);
						НайденныеПоКоличествуИЦене = Объект.ТоварыУслуги.НайтиСтроки(СтруткураПоиска);
						Если НайденныеПоКоличествуИЦене.Количество() = 0 Тогда
							ЗаполнитьЗначенияСвойств(ТекущаяСтрока, НайденнаяСтрока);
							Прервать;
						КонецЕсли;	
					КонецЦикла;
				КонецЕсли;	
			// иначе берем первую найденную
			Иначе
				ЗаполнитьЗначенияСвойств(ТекущаяСтрока, ВыборкаТЗ[0]);
			КонецЕсли;		
			
		КонецЕсли;			
		
		ТекущаяСтрока.СтавкаНДС = СтавкаНДСПоУмолчанию;
		ТекущаяСтрока.СуммаНДС = УчетНДС.РассчитатьСуммуНДС(ТекущаяСтрока.Сумма, УчитыватьНДС, , УчетНДС.ПолучитьСтавкуНДС(ТекущаяСтрока.СтавкаНДС));

	КонецЦикла;
	
	ОбновитьДанныеДокумента();
	
КонецПроцедуры

