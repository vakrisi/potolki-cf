&НаСервере
Функция ПолучитьТаблицуИспользованияВДругихМонтажах()
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Основание", Объект.Основание);
	Запрос.УстановитьПараметр("Ссылка", Объект.Ссылка);
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СУММА(МонтажМатериалы.Количество) КАК Количество,
	|	МонтажМатериалы.УИСтроки КАК УИСтроки,
	|	""Материалы"" КАК Назначение
	|ИЗ
	|	Документ.Монтаж.Материалы КАК МонтажМатериалы
	|ГДЕ
	|	МонтажМатериалы.Ссылка.Проведен
	|	И МонтажМатериалы.Ссылка <> &Ссылка
	|	И МонтажМатериалы.Ссылка.Основание = &Основание
	|	И МонтажМатериалы.УИСтроки <> """"
	|
	|СГРУППИРОВАТЬ ПО
	|	МонтажМатериалы.УИСтроки
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	СУММА(МонтажТоварыУслуги.Количество),
	|	МонтажТоварыУслуги.УИСтроки,
	|	""Товары""
	|ИЗ
	|	Документ.Монтаж.ТоварыУслуги КАК МонтажТоварыУслуги
	|ГДЕ
	|	МонтажТоварыУслуги.Ссылка.Проведен
	|	И МонтажТоварыУслуги.Ссылка <> &Ссылка
	|	И МонтажТоварыУслуги.Ссылка.Основание = &Основание
	|	И МонтажТоварыУслуги.УИСтроки <> """"
	|
	|СГРУППИРОВАТЬ ПО
	|	МонтажТоварыУслуги.УИСтроки
	|";
	
	Возврат Запрос.Выполнить().Выгрузить();
			
КонецФункции

&НаСервере
Процедура ПерестроитьДеревоНаФорме(ТолькоМатериалы = Ложь, ОбновлятьТоварыПоДаннымМонтажа = Истина)
	
	Если НЕ ТаблицыКакДерево Тогда 
		Возврат; 
	КонецЕсли;
	
	ТаблицаИспользованияВДругихМонтажах = ПолучитьТаблицуИспользованияВДругихМонтажах();
	//ТОВАРЫ И УСЛУГИ
	//ключ строки дерева: комната
	
	ТЗ_ТаблицаДокумента = Новый ТаблицаЗначений;
	ТЗ_ТаблицаДокумента = Объект.ТоварыУслуги.Выгрузить();
	ТЗ_ТаблицаДокумента.Очистить();
	
	Дерево = ДанныеФормыВЗначение(ДеревоТоваров, Тип("ДеревоЗначений"));
	Дерево.Строки.Очистить();
	
	//добавляем по данным заказ-договора
	Если ТипЗнч(Объект.Основание) = Тип("ДокументСсылка.ЗаказДоговор") Тогда
		Для Каждого Стр Из Объект.Основание.ТоварыУслуги Цикл
			//строки с товаром еще нет в монтаже добавим строку
			КомнатаСтроки = Стр.Комната;
			НоваяСтрока = Неопределено;
			Если ПустаяСтрока(КомнатаСтроки) Тогда
				//комната не указана, добавим строку вне комнат
				НоваяСтрока = Дерево.Строки.Добавить();
			Иначе
				//ищем комнату
				Для Каждого СтрокаКомнаты Из Дерево.Строки Цикл
					Если СтрокаКомнаты.Комната = КомнатаСтроки Тогда
						НоваяСтрока = СтрокаКомнаты.Строки.Добавить();
					КонецЕсли;
				КонецЦИкла;
				Если НоваяСтрока = Неопределено Тогда
					//не нашли такую комнату - создаем строку с комнатой и в ней строку с номенклатурой
					СтрДерево = Дерево.Строки.Добавить();
					СтрДерево.Комната = КомнатаСтроки;
					
					НоваяСтрока = СтрДерево.Строки.Добавить();
				КонецЕсли;
			КонецЕсли;
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Стр);
			НоваяСтрока.ВидНоменклатуры = НоваяСтрока.Номенклатура.ВидНоменклатуры;
			НоваяСтрока.КоличествоВЗаказДоговоре = НоваяСтрока.Количество;
			//++ №10821 единица и коэффициент, так же участвуют в сопоставлении
			НоваяСтрока.ЕдиницаИзмеренияВЗаказДоговоре = НоваяСтрока.ЕдиницаИзмерения;
			НоваяСтрока.КоэффициентВЗаказДоговоре = НоваяСтрока.Коэффициент;
			//-- №10821
			НоваяСтрока.ЦенаВЗаказДоговоре = НоваяСтрока.Цена;
			НоваяСтрока.СуммаВЗаказДоговоре = НоваяСтрока.Сумма;
			НоваяСтрока.ПроцентСкидкиВЗаказДоговоре = НоваяСтрока.ПроцентСкидки;
			НоваяСтрока.СуммаСкидкиВЗаказДоговоре = НоваяСтрока.СуммаСкидки;
			НоваяСтрока.СтавкаНДСВЗаказДоговоре = НоваяСтрока.СтавкаНДС;
			НоваяСтрока.СуммаНДСВЗаказДоговоре = НоваяСтрока.СуммаНДС;
			НоваяСтрока.Количество = 0;
			
			НоваяСтрока.Уровень = 1;
			
			ТЗ_Строка = ТЗ_ТаблицаДокумента.Добавить();
			ЗаполнитьЗначенияСвойств(ТЗ_Строка, НоваяСтрока);	
		КонецЦикла;
	КонецЕсли;
	
	//обновляем по данным монтажа
	Для Каждого Стр из Объект.ТоварыУслуги Цикл
		Если НЕ Стр.Номенклатура.Пустая() Тогда
			СтрокаДерева = ПолучитьСтрокуДересаПоУИСтроки(Дерево, Стр.УИСтроки, Стр.Номенклатура, Стр.ХарактеристикаНоменклатуры, Стр.Комната
				, Стр.ЕдиницаИзмерения, Стр.Коэффициент // №10821
			);
			
			Если НЕ СтрокаДерева = Неопределено Тогда
				//обновляем по данным монтажа
				Если ОбновлятьТоварыПоДаннымМонтажа Тогда
					ЗаполнитьЗначенияСвойств(СтрокаДерева, Стр);
				КонецЕсли;
				СтрокаДерева.ИспользоватьВТекущемМонтаже = Истина;
				СтрокаДерева.ВидНоменклатуры = СтрокаДерева.Номенклатура.ВидНоменклатуры;
			Иначе
				// строки нет в ЗД
				КомнатаСтроки = Стр.Комната;
				НоваяСтрока = Неопределено;
				Если ПустаяСтрока(КомнатаСтроки) Тогда
					//комната не указана, добавим строку вне комнат
					НоваяСтрока = Дерево.Строки.Добавить();
				Иначе
					//ищем комнату
					Для Каждого СтрокаКомнаты Из Дерево.Строки Цикл
						Если СтрокаКомнаты.Комната = КомнатаСтроки Тогда
							НоваяСтрока = СтрокаКомнаты.Строки.Добавить();
						КонецЕсли;
					КонецЦИкла;
					Если НоваяСтрока = Неопределено Тогда
						//не нашли такую комнату - создаем строку с комнатой и в ней строку с номенклатурой
						СтрДерево = Дерево.Строки.Добавить();
						СтрДерево.Комната = КомнатаСтроки;
						
						НоваяСтрока = СтрДерево.Строки.Добавить();
					КонецЕсли;
				КонецЕсли;
				ЗаполнитьЗначенияСвойств(НоваяСтрока, Стр);
				НоваяСтрока.ВидНоменклатуры = НоваяСтрока.Номенклатура.ВидНоменклатуры;			
				НоваяСтрока.КоличествоВЗаказДоговоре = 0;
				НоваяСтрока.ИспользоватьВТекущемМонтаже = Истина;
				НоваяСтрока.УИСтроки = ""; // используется как признак присутствия в заказ-договоре, используется в процедуре ПередЗаписью дял проерки наличия в ЗД
				
				НоваяСтрока.Уровень = 1;
				
				ТЗ_Строка = ТЗ_ТаблицаДокумента.Добавить();
				ЗаполнитьЗначенияСвойств(ТЗ_Строка, НоваяСтрока);
				
			КонецЕсли;	 
		КонецЕсли;
	КонецЦикла;

	// #8758
	Для Каждого ТекущаяКомната Из Дерево.Строки Цикл
		ИспользоватьВТекущемМонтаже = 0;
		НеИспользоватьВТекущемМонтаже = 0;
		Для Каждого ТекущаяНоменклатура Из ТекущаяКомната.Строки Цикл
			Если ТекущаяНоменклатура.ИспользоватьВТекущемМонтаже Тогда
				ИспользоватьВТекущемМонтаже = ИспользоватьВТекущемМонтаже + 1;
			Иначе
				НеИспользоватьВТекущемМонтаже = НеИспользоватьВТекущемМонтаже + 1;
			КонецЕсли;
		КонецЦикла;
		Если ИспользоватьВТекущемМонтаже > 0 И НеИспользоватьВТекущемМонтаже = 0 Тогда
			ТекущаяКомната.ИспользоватьВТекущемМонтаже = Истина;
		КонецЕсли;		
	КонецЦикла;
	
	// Узнаем остатки на складах и заполним реквизит дерева
	
	// №11431 вынесено в отдельную функцию
	ТаблицаСОстатками = ПолучитьОстаткиПоПозициям(ТЗ_ТаблицаДокумента, СкладАнализаОстатковТоваров);
	
	Для Каждого ТекущаяКомната Из Дерево.Строки Цикл
		
		Для Каждого ТекущаяНоменклатура Из ТекущаяКомната.Строки Цикл
			
			Отбор = Новый Структура;
			Отбор.Вставить("Номенклатура", ТекущаяНоменклатура.Номенклатура);
			Отбор.Вставить("ХарактеристикаНоменклатуры", ТекущаяНоменклатура.ХарактеристикаНоменклатуры);
			Отбор.Вставить("СерияНоменклатуры", ТекущаяНоменклатура.СерияНоменклатуры);
			
			НайденныеСтроки = ТаблицаСОстатками.НайтиСтроки(Отбор);
			
			Если НайденныеСтроки.Количество() > 0 Тогда
				
				ТекущаяНоменклатура.ОстатокНаСкладе = НайденныеСтроки[0].ОстатокНаСкладе;
				ТекущаяНоменклатура.ВРезерве = НайденныеСтроки[0].КоличествоВРезерве;
				ТекущаяНоменклатура.ВРезервеПоТекущемуМонтажу = НайденныеСтроки[0].ВРезервеПоТекущемуМонтажу;
				ТекущаяНоменклатура.Доступно = ТекущаяНоменклатура.ОстатокНаСкладе - ТекущаяНоменклатура.ВРезерве + ТекущаяНоменклатура.ВРезервеПоТекущемуМонтажу;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
	// КоличествоВДругихМонтажах  //#12608 поле удалено // №12860 раскомментировано
	Для Каждого ТекущаяКомната Из Дерево.Строки Цикл
		Если ТекущаяКомната.Номенклатура = Неопределено Или ТекущаяКомната.Номенклатура.Пустая() Тогда
			Для Каждого ТекущаяНоменклатура Из ТекущаяКомната.Строки Цикл
				Отбор = Новый Структура;
				Отбор.Вставить("УИСтроки", ТекущаяНоменклатура.УИСтроки);
				Отбор.Вставить("Назначение","Товары");
				НайденныеСтроки = ТаблицаИспользованияВДругихМонтажах.НайтиСтроки(Отбор);
				Если НайденныеСтроки.Количество() > 0 Тогда
					ТекущаяНоменклатура.КоличествоВДругихМонтажах = НайденныеСтроки[0].Количество;				
				Иначе
					ТекущаяНоменклатура.КоличествоВДругихМонтажах = 0;
				КонецЕсли;
				ТекущаяНоменклатура.КоличествоВМонтажах = ТекущаяНоменклатура.Количество + ТекущаяНоменклатура.КоличествоВДругихМонтажах;
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	
	// Ообеспеченность (по заказ-договору) - вынесено в отдельную процедуру
	ОбновитьОбеспеченностьПоТоварам(Дерево);

	Если НЕ ТолькоМатериалы Тогда	
		ЗначениеВДанныеФормы(Дерево, ДеревоТоваров);
	КонецЕсли;
	ДеревоТ = Дерево;
	
	//МАТЕРИАЛЫ
	//ключ строки дерева: комната
	
	ТЗ_ТаблицаДокумента = Новый ТаблицаЗначений;
	ТЗ_ТаблицаДокумента = Объект.Материалы.Выгрузить();
	ТЗ_ТаблицаДокумента.Очистить();
	
	Дерево = ДанныеФормыВЗначение(ДеревоМатериалов, Тип("ДеревоЗначений"));
	Дерево.Строки.Очистить();
	
	// переделана процедура построения дерева по заявке 3792
	// чтобы порядок комнат и позиций в ЗД и монтаже совпадал
	
	//принудительно добавим все комнаты из дерева товаров
	Для Каждого СтрТовары Из ДеревоТ.Строки Цикл
		Нашли=Ложь;
		Для Каждого СтрМатериалы Из Дерево.Строки Цикл
			Если СтрТовары.Комната = СтрМатериалы.Комната Тогда
				Нашли = Истина;
			КонецЕсли;
		КонецЦикла;
		Если НЕ Нашли Тогда
			СтрДерево = Дерево.Строки.Добавить();
			СтрДерево.Комната = СтрТовары.Комната;
		КонецЕсли;
	КонецЦикла;

	//добавляем/обновляем по данным заказ-договора
	Если ТипЗнч(Объект.Основание) = Тип("ДокументСсылка.ЗаказДоговор") 
		И НЕ ЗаполнениеМатериаловПоМонтажам //#5456
		Тогда
		Для Каждого Стр Из Объект.Основание.Материалы Цикл
			Если Стр.Номенклатура = Неопределено ИЛИ Стр.Номенклатура.Пустая() Тогда
				Продолжить;
			КонецЕсли;
			//строки с материалом пока нет в монтаже добавим строку
			КомнатаСтроки = Стр.Комната;
			НоваяСтрока = Неопределено;
			Если ПустаяСтрока(КомнатаСтроки) Тогда
				//комната не указана, добавим строку вне комнат
				НоваяСтрока = Дерево.Строки.Добавить();
			Иначе
				//ищем комнату
				Для Каждого СтрокаКомнаты Из Дерево.Строки Цикл
					Если СтрокаКомнаты.Комната = КомнатаСтроки Тогда
						НоваяСтрока = СтрокаКомнаты.Строки.Добавить();
					КонецЕсли;
				КонецЦИкла;
				Если НоваяСтрока = Неопределено Тогда
					//не нашли такую комнату - создаем строку с комнатой и в ней строку с номенклатурой
					СтрДерево = Дерево.Строки.Добавить();
					СтрДерево.Комната = КомнатаСтроки;
					
					НоваяСтрока = СтрДерево.Строки.Добавить();
				КонецЕсли;
			КонецЕсли;
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Стр);
			НоваяСтрока.КоличествоВЗаказДоговоре = НоваяСтрока.Количество;
			НоваяСтрока.Количество = 0;
			
			ТЗ_Строка = ТЗ_ТаблицаДокумента.Добавить();
			ЗаполнитьЗначенияСвойств(ТЗ_Строка, НоваяСтрока);
			
		КонецЦикла;
	КонецЕсли;
	
	//обновляем по данным монтажа
	Для Каждого Стр из Объект.Материалы Цикл
		Если НЕ Стр.Номенклатура.Пустая() Тогда
			СтрокаДерева = ПолучитьСтрокуДересаПоУИСтроки(Дерево, Стр.УИСтроки, Стр.Номенклатура,  Стр.ХарактеристикаНоменклатуры, Стр.Комната
				, Стр.ЕдиницаИзмерения, Стр.Коэффициент // №10821
			);
			
			Если НЕ СтрокаДерева = Неопределено Тогда
				//обновляем по данным монтажа
				ЗаполнитьЗначенияСвойств(СтрокаДерева, Стр);
				СтрокаДерева.ИспользоватьВТекущемМонтаже = Истина;
			Иначе
				// строки нет в ЗД
				КомнатаСтроки = Стр.Комната;
				НоваяСтрока = Неопределено;
				Если ПустаяСтрока(КомнатаСтроки) Тогда
					//комната не указана, добавим строку вне комнат
					НоваяСтрока = Дерево.Строки.Добавить();
				Иначе
					//ищем комнату
					Для Каждого СтрокаКомнаты Из Дерево.Строки Цикл
						Если СтрокаКомнаты.Комната = КомнатаСтроки Тогда
							НоваяСтрока = СтрокаКомнаты.Строки.Добавить();
						КонецЕсли;
					КонецЦИкла;
					Если НоваяСтрока = Неопределено Тогда
						//не нашли такую комнату - создаем строку с комнатой и в ней строку с номенклатурой
						СтрДерево = Дерево.Строки.Добавить();
						СтрДерево.Комната = КомнатаСтроки;
						
						НоваяСтрока = СтрДерево.Строки.Добавить();
					КонецЕсли;
				КонецЕсли;
				ЗаполнитьЗначенияСвойств(НоваяСтрока, Стр);
				//НоваяСтрока.ВидНоменклатуры = НоваяСтрока.Номенклатура.ВидНоменклатуры;			
				НоваяСтрока.КоличествоВЗаказДоговоре = 0;
				НоваяСтрока.ИспользоватьВТекущемМонтаже = Истина;
				//++ №8367 комментируем, т.к. УИС нам нужен в любом случае
				//Если НЕ ЗаполнениеМатериаловПоМонтажам Тогда
				//	НоваяСтрока.УИСтроки = ""; // используется как признак присутствия в заказ-договоре, используется в процедуре ПередЗаписью для проверки наличия в ЗД 
				//КонецЕсли;
				//-- №8367
				
				ТЗ_Строка = ТЗ_ТаблицаДокумента.Добавить();
				ЗаполнитьЗначенияСвойств(ТЗ_Строка, НоваяСтрока);
				
			КонецЕсли;	 
		КонецЕсли;
	КонецЦикла;
	
	// #8758
	Для Каждого ТекущаяКомната Из Дерево.Строки Цикл
		ИспользоватьВТекущемМонтаже = 0;
		НеИспользоватьВТекущемМонтаже = 0;
		Для Каждого ТекущаяНоменклатура Из ТекущаяКомната.Строки Цикл
			Если ТекущаяНоменклатура.ИспользоватьВТекущемМонтаже Тогда
				ИспользоватьВТекущемМонтаже = ИспользоватьВТекущемМонтаже + 1;
			Иначе
				НеИспользоватьВТекущемМонтаже = НеИспользоватьВТекущемМонтаже + 1;
			КонецЕсли;
		КонецЦикла;
		Если ИспользоватьВТекущемМонтаже > 0 И НеИспользоватьВТекущемМонтаже = 0 Тогда
			ТекущаяКомната.ИспользоватьВТекущемМонтаже = Истина;
		КонецЕсли;		
	КонецЦикла;
	
	// Узнаем остатки на складах и заполним реквизит дерева
	// №11431 вынесено в отдельную функцию
	ТаблицаСОстатками = ПолучитьОстаткиПоПозициям(ТЗ_ТаблицаДокумента, СкладАнализаОстатковМатериалов);
	
	Для Каждого ТекущаяКомната Из Дерево.Строки Цикл
		
		Для Каждого ТекущаяНоменклатура Из ТекущаяКомната.Строки Цикл
			
			Отбор = Новый Структура;
			Отбор.Вставить("Номенклатура", ТекущаяНоменклатура.Номенклатура);
			Отбор.Вставить("ХарактеристикаНоменклатуры", ТекущаяНоменклатура.ХарактеристикаНоменклатуры);
			Отбор.Вставить("СерияНоменклатуры", ТекущаяНоменклатура.СерияНоменклатуры);
			
			НайденныеСтроки = ТаблицаСОстатками.НайтиСтроки(Отбор);
			
			Если НайденныеСтроки.Количество() > 0 Тогда
				
				ТекущаяНоменклатура.ОстатокНаСкладе = НайденныеСтроки[0].ОстатокНаСкладе;
				ТекущаяНоменклатура.ВРезерве = НайденныеСтроки[0].КоличествоВРезерве;
				ТекущаяНоменклатура.ВРезервеПоТекущемуМонтажу = НайденныеСтроки[0].ВРезервеПоТекущемуМонтажу;
				ТекущаяНоменклатура.Доступно = ТекущаяНоменклатура.ОстатокНаСкладе - ТекущаяНоменклатура.ВРезерве + ТекущаяНоменклатура.ВРезервеПоТекущемуМонтажу;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
	//КоличествоВДругихМонтажах
	Для Каждого ТекущаяКомната Из Дерево.Строки Цикл
		Если ТекущаяКомната.Номенклатура = Неопределено Или ТекущаяКомната.Номенклатура.Пустая() Тогда
			Для Каждого ТекущаяНоменклатура Из ТекущаяКомната.Строки Цикл
				Отбор = Новый Структура;
				Отбор.Вставить("УИСтроки", ТекущаяНоменклатура.УИСтроки);
				Отбор.Вставить("Назначение","Материалы");
				НайденныеСтроки = ТаблицаИспользованияВДругихМонтажах.НайтиСтроки(Отбор);
				Если НайденныеСтроки.Количество() > 0 Тогда
					ТекущаяНоменклатура.КоличествоВДругихМонтажах = НайденныеСтроки[0].Количество;
				Иначе
					ТекущаяНоменклатура.КоличествоВДругихМонтажах = 0;
				КонецЕсли;
				ТекущаяНоменклатура.КоличествоВМонтажах = ТекущаяНоменклатура.Количество + ТекущаяНоменклатура.КоличествоВДругихМонтажах;
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	
	// Обеспеченность (по заказ-договору) - вынесено в отдельную процедуру
	ОбновитьОбеспеченностьПоМатериалам(Дерево);
	
	ЗначениеВДанныеФормы(Дерево, ДеревоМатериалов);
	
КонецПроцедуры

