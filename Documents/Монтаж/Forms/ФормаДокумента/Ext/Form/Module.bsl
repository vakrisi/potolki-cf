&НаКлиенте
Процедура СформироватьПеремещениеВыдачаВозврат(Выдача = Ложь)
	
	ПозицииКПеремещению = ПолучитьПозицииКПеремещениюПоМонтажу();	
	
	Если Выдача Тогда
		Позиции = ПозицииКПеремещению.ТЗ_КВыдаче;
	Иначе	
		Позиции = ПозицииКПеремещению.ТЗ_КВозврату;
	КонецЕсли;	
	
	РазделятьПоНазначению = РазделятьПеремещениеПоНазначению();	
	
	ПараметрыОснования = Новый Структура("Основание, Выдача, РазделятьПоНазначению, Склад", Объект.Ссылка, Выдача, РазделятьПоНазначению, Объект.Склад);
	Если НЕ РазделятьПоНазначению Тогда		
		ПараметрыОснования.Вставить("ПозицииКПеремещению", Позиции);
		//ПараметрыОснования.Вставить("ТаблицаНазначения", "ТоварыИМатериалы");  // #13841 реквизит удален	
		СтруктураОснования = Новый Структура("ЗначенияЗаполнения", ПараметрыОснования);
		ОткрытьФорму("Документ.ПеремещениеТоваров.ФормаОбъекта", СтруктураОснования);
	Иначе	
		
		//Разделяем позиции
		МассивМатериалы = новый Массив;
		МассивТовары = новый Массив;
		
		Для Каждого Материал Из Позиции Цикл		
			Если Материал.Таблица = "Материалы" Тогда
				МассивМатериалы.Добавить(Материал);	
			КонецЕсли;		
		КонецЦикла;
		
		Для Каждого Товар Из Позиции Цикл		
			Если Товар.Таблица = "Товары" Тогда
				МассивТовары.Добавить(Товар);	
			КонецЕсли;		
		КонецЦикла;
		
		//Нужно открыть минимум один новый документ перемещения для создания
		//Если идёт разделение по назначению их будет два, но если позиций в одном не будет, не нужно его открывать
		Если МассивМатериалы.Количество() > 0 ИЛИ Позиции.Количество() = 0 Тогда
			ПараметрыОснования.Вставить("ПозицииКПеремещению", МассивМатериалы);
			//ПараметрыОснования.Вставить("ТаблицаНазначения", "Материалы");  // #13841 реквизит удален		
			СтруктураОснования = Новый Структура("ЗначенияЗаполнения", ПараметрыОснования);
			ОткрытьФорму("Документ.ПеремещениеТоваров.ФормаОбъекта", СтруктураОснования,, новый УникальныйИдентификатор);			
		КонецЕсли;
		
		Если МассивТовары.Количество() > 0 Тогда
			ПараметрыОснования.Вставить("ПозицииКПеремещению", МассивТовары);
			//ПараметрыОснования.Вставить("ТаблицаНазначения", "Товары");  // #13841 реквизит удален
			ПараметрыОснования.Вставить("Склад", Объект.СкладТоваров);		
			СтруктураОснования = Новый Структура("ЗначенияЗаполнения", ПараметрыОснования);
			ОткрытьФорму("Документ.ПеремещениеТоваров.ФормаОбъекта", СтруктураОснования,, новый УникальныйИдентификатор);
		КонецЕсли;	
		
	КонецЕсли;
	
КонецПроцедуры

