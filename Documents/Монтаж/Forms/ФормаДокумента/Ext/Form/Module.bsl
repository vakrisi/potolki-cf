&НаКлиенте
Процедура ПриЗакрытии()
	
	Оповестить("ЗакрытаФормаМонтажа",,"Монтаж");
	
	Если ЗначениеЗаполнено(Объект.Ссылка)
		И ЗначениеЗаполнено(Объект.Основание)
		И ТипЗнч(Объект.Основание) = Тип("ДокументСсылка.Лид") 
		И Объект.Проведен Тогда
		Оповестить("ЗакрытаФормаМонтажа", Объект.Основание, Новый Структура("Номер, Дата, Вид", Объект.Номер, Объект.Дата, Объект.ВидОперации));
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "ОбновлениеТЧТоварыИУслугиЗаказДоговора" И Источник = Объект.Основание Тогда
		
		ПеренестиДеревоВТабличнуюЧасть();
		ПерестроитьДеревоНаФорме();
		
		РазвернутьДеревоТоваров();
		РазвернутьДеревоМатериалов();
		
		ПроверитьСоответствиеЗаказДоговору();
		
		ОбновитьДанныеДокумента();
		Модифицированность = Истина;
		ПоказатьОповещениеПользователя("Обновлены позиции",,"Обновлены позиции по заказ-договору");
		
	ИначеЕсли ИмяСобытия = "ОбновитьПотребностьПоМонтажу" И Параметр = Объект.Ссылка Тогда
		
		ПерезаполнитьПотребность();
		
	ИначеЕсли ИмяСобытия = "ЗаписьДокументаОбеспеченияРозницы" И Параметр = Объект.Ссылка Тогда
		
		ОбновитьОбеспеченностьНаСервере();
		
		Комната = Неопределено;
		Номенклатура = Неопределено;
		ТекДанные = Элементы.ДеревоТоваров.ТекущиеДанные;
		Если НЕ ТекДанные = Неопределено Тогда
			Комната = ТекДанные.Комната;
			Номенклатура = ТекДанные.Номенклатура;
		КонецЕсли;
		РазвернутьДеревоТоваров(Комната, Номенклатура);
		
		Комната = Неопределено;
		Номенклатура = Неопределено;
		ТекДанные = Элементы.ДеревоМатериалов.ТекущиеДанные;
		Если НЕ ТекДанные = Неопределено Тогда
			Комната = ТекДанные.Комната;
			Номенклатура = ТекДанные.Номенклатура;
		КонецЕсли;
		РазвернутьДеревоМатериалов(Комната, Номенклатура);
		
	ИначеЕсли ИмяСобытия = "ОбновитьСписокФайлов" Тогда
		
		ОбновитьСписокФайлов();
		
	ИначеЕсли ИмяСобытия = "ЗаписьДокументовПоРезервам" Тогда
		
		Если ТаблицыКакДерево Тогда
			
			ТоварыКомната = Неопределено;
			ТоварыНоменклатура = Неопределено;
			ТекДанные = Элементы.ДеревоТоваров.ТекущиеДанные;
			Если НЕ ТекДанные = Неопределено Тогда
				ТоварыКомната = ТекДанные.Комната;
				ТоварыНоменклатура = ТекДанные.Номенклатура;
			КонецЕсли;
			
			МатериалыКомната = Неопределено;
			МатериалыНоменклатура = Неопределено;
			ТекДанные = Элементы.ДеревоМатериалов.ТекущиеДанные;
			Если НЕ ТекДанные = Неопределено Тогда
				МатериалыКомната = ТекДанные.Комната;
				МатериалыНоменклатура = ТекДанные.Номенклатура;
			КонецЕсли;
			
			ПеренестиДеревоВТабличнуюЧасть();
			ПерестроитьДеревоНаФорме();
			
			РазвернутьДеревоТоваров(ТоварыКомната, ТоварыНоменклатура);
			РазвернутьДеревоМатериалов(МатериалыКомната, МатериалыНоменклатура);
			
		Иначе
			
			ОбновитьДанныеДокумента();
			
		КонецЕсли;
		
	КонецЕсли;
	
	// СтандартныеПодсистемы.Свойства 
	Если УправлениеСвойствамиКлиент.ОбрабатыватьОповещения(ЭтотОбъект, ИмяСобытия, Параметр) Тогда
		ОбновитьЭлементыДополнительныхРеквизитов();
		УправлениеСвойствамиКлиент.ПослеЗагрузкиДополнительныхРеквизитов(ЭтотОбъект);
	КонецЕсли;
	// Конец СтандартныеПодсистемы.Свойства
	
	// СтандартныеПодсистемы.УчетОригиналовПервичныхДокументов
	УчетОригиналовПервичныхДокументовКлиент.ОбработчикОповещенияФормаДокумента(ИмяСобытия, ЭтотОбъект);
	// Конец СтандартныеПодсистемы.УчетОригиналовПервичныхДокументов

КонецПроцедуры

&НаСервере
Процедура ОбновитьОбеспеченностьНаСервере()
	
	Дерево = ДанныеФормыВЗначение(ДеревоТоваров, Тип("ДеревоЗначений"));
	ОбновитьОбеспеченностьПоТоварам(Дерево);
	ЗначениеВДанныеФормы(Дерево, ДеревоТоваров);
	
	Дерево = ДанныеФормыВЗначение(ДеревоМатериалов, Тип("ДеревоЗначений"));
	ОбновитьОбеспеченностьПоМатериалам(Дерево);
	ЗначениеВДанныеФормы(Дерево, ДеревоМатериалов);
		
КонецПроцедуры	

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	
	Если ИсточникВыбора.ИмяФормы = "ОбщаяФорма.ФормаДобавленияПрофиля" Тогда	
		ОбработкаДобавленияПрофиляСервер(ВыбранноеЗначение);
		ЗаполнитьОстаткиПоМатериалам();
		РазвернутьДеревоМатериалов();
		ОбновитьНадписьВкладкиМатериалы();
		Модифицированность = Истина; //++ №8238
		
	ИначеЕсли ИсточникВыбора.ИмяФормы = "Справочник.НазваниеКомнат.Форма.ФормаВыбора" И ТипЗнч(ВыбранноеЗначение) = Тип("Структура") Тогда
		ОбщийМодульКлиент.Розница_ДобавитьКомнатуЗавершение(Новый Структура("Форма", ЭтаФорма), ВыбранноеЗначение);
	
	КонецЕсли;
	
	Если Окно <> Неопределено Тогда
		Окно.Активизировать();
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура ДатаПриИзменении(Элемент)
	ДатаПриИзмененииНаСервере();
КонецПроцедуры

&НаСервере
Процедура ДатаПриИзмененииНаСервере()
	
	УстановитьЗаголовокФормы();
	ФинансыСервер.ОбновитьВидимостьИКурсВалюты(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ВалютаПриИзменении(Элемент)
	
	ВалютаПриИзмененииНаСервере();
	ЗадатьВопросОПересчетеЦен();
	
КонецПроцедуры

&НаСервере
Процедура ВалютаПриИзмененииНаСервере()

	ФинансыСервер.ОбновитьВидимостьИКурсВалюты(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура РезультатПриИзменении(Элемент)
	
	ТекстПродолженияИстории = ""; // №12802
	
	Если Объект.Результат = ПредопределенноеЗначение("Справочник.РезультатыМонтажа.Выполнен") Тогда
		
		ДатаВыполнен = ТекущаяДата();
		Если НЕ НачалоДня(Объект.Дата) = НачалоДня(ТекущаяДата()) Тогда
			
			// №7111 закомментировано, т.к. нужно предложить текущую дату
			//ДатаВыполнен = Дата(1,1,1);
			
			Массив = Новый Массив;
			Массив.Добавить(Тип("Дата"));
			КД = Новый КвалификаторыДаты(ЧастиДаты.Дата);
			ОписаниеТипов = Новый ОписаниеТипов(Массив,,,,,КД);
			
			Если НЕ ВвестиЗначение(ДатаВыполнен, "Введите дату выполнения монтажа", ОписаниеТипов) Тогда
				Объект.Результат = ПредопределенноеЗначение("Справочник.РезультатыМонтажа.ВРаботе");
				Возврат;
			КонецЕсли;
			
			Если ДатаВыполнен = Дата(1,1,1) Тогда
				ДатаВыполнен = ТекущаяДата();
			ИначеЕсли НачалоДня(ДатаВыполнен) < НачалоДня(ТекущаяДата()) Тогда
				ДатаВыполнен = КонецДня(ДатаВыполнен);
			Иначе
				ДатаВыполнен = ТекущаяДата();
			КонецЕсли;
		КонецЕсли;
		
		//++ №12802 комментируем, т.к. нужно менять только дату выполнения
		////Нужно проверить год из даты документа сходится с текущим годом
		//Если Год(Объект.Дата) = Год(ДатаВыполнен) Тогда 
		//	Объект.Дата = ДатаВыполнен;
		//Иначе			
		//	Объект.Дата = ДатаВыполнен;
		//	УстановитьНовыйНомерНаСервере();			
		//КонецЕсли;	
		//-- №12802
		
		Объект.ДатаВыполнения = ДатаВыполнен;
		
		мДатаВыполнения = Объект.ДатаВыполнения; // №12802
		
		//#11206 при переводе в "Выполнен" очищать дату закрытия.
		Если ЗначениеЗаполнено(Объект.ДатаЗакрытия) Тогда
			Объект.ДатаЗакрытия = Дата(1,1,1);
			мДатаЗакрытия = Объект.ДатаЗакрытия; // №12802
		КонецЕсли;
		
		ТекстПродолженияИстории = "установлена дата выполнения " + Объект.ДатаВыполнения; // №12802
		
	ИначеЕсли Объект.Результат = ПредопределенноеЗначение("Справочник.РезультатыМонтажа.Закрыт") Тогда
		
		// №7111 дату закрытия устанавливаем в текущую дату, если она равна дате документа
		// иначе предлагаем пользователю ввести дату закрытия
		Если НачалоДня(Объект.Дата) = НачалоДня(ТекущаяДата()) Тогда
			
			Объект.ДатаЗакрытия = ТекущаяДата();
			мДатаЗакрытия = Объект.ДатаЗакрытия; // №12802
			
		Иначе
			
			ДатаЗакрытия = ТекущаяДата();
			
			Массив = Новый Массив;
			Массив.Добавить(Тип("Дата"));
			КД = Новый КвалификаторыДаты(ЧастиДаты.Дата);
			ОписаниеТипов = Новый ОписаниеТипов(Массив,,,,,КД);
			
			Если НЕ ВвестиЗначение(ДатаЗакрытия, "Введите дату закрытия монтажа", ОписаниеТипов) Тогда
				Объект.Результат = мТекущийСтатус;
				Возврат;
			КонецЕсли;
			
			ДатаЗакрытия = КонецДня(ДатаЗакрытия);
			
			Если НачалоДня(ДатаЗакрытия) < НачалоДня(Объект.Дата) Тогда
				ТекстСообщения = НСтр("ru = 'Дата закрытия не может быть раньше даты документа!'");
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
				Объект.Результат = мТекущийСтатус;
				Возврат;
			ИначеЕсли ЗначениеЗаполнено(Объект.ДатаВыполнения) И (НачалоДня(ДатаЗакрытия) < НачалоДня(Объект.ДатаВыполнения)) Тогда
				ТекстСообщения = НСтр("ru = 'Дата закрытия не может быть раньше даты выполнения монтажа!'");
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
				Объект.Результат = мТекущийСтатус;
				Возврат;
			КонецЕсли;
			
			Объект.ДатаЗакрытия = ДатаЗакрытия;
			мДатаЗакрытия = Объект.ДатаЗакрытия; // №12802
			
		КонецЕсли;
		
		//++ №12802 если дата выполнения не заполнена (сразу перевели в статус "Закрыт" минуя статус "Выполнен")
		АвтоматическиСмененаДатаВыполнения = Ложь;
		Если Не ЗначениеЗаполнено(Объект.ДатаВыполнения) Тогда
			
			АвтоматическиСмененаДатаВыполнения = Истина;
			
			Объект.ДатаВыполнения = Объект.ДатаЗакрытия;
			мДатаВыполнения = Объект.ДатаВыполнения;
			
		КонецЕсли;
		
		ТекстПродолженияИстории = "установлена дата закрытия " + ?(АвтоматическиСмененаДатаВыполнения, "и дата выполнения ", "") + Объект.ДатаЗакрытия;
		//-- №12802
		
	ИначеЕсли Объект.Результат = ПредопределенноеЗначение("Справочник.РезультатыМонтажа.ВРаботе") Тогда
		
		//#11206 при переводе выполненного/закрытого монтажа обратно в статус "В работе" (из выполнен/закрыт), очищать дату выполнения / закрытия.
		Если ЗначениеЗаполнено(Объект.ДатаВыполнения) Тогда
			Объект.ДатаВыполнения = Дата(1,1,1);
			мДатаВыполнения = Объект.ДатаВыполнения; // №12802
		КонецЕсли;
		Если ЗначениеЗаполнено(Объект.ДатаЗакрытия) Тогда
			Объект.ДатаЗакрытия = Дата(1,1,1);
			мДатаЗакрытия = Объект.ДатаЗакрытия; // №12802
		КонецЕсли;
		
	КонецЕсли;
	
	// №12802
	//ДобавитьЗаписьВИсторию("Переведен в статус: " + Объект.Результат);
	ДобавитьЗаписьВИсторию("Переведен в статус: " + Объект.Результат + ?(ЗначениеЗаполнено(ТекстПродолженияИстории), ", " + ТекстПродолженияИстории, ""));
	
	ОбновитьФорму();
	ОбновитьДанныеДокумента();
КонецПроцедуры

