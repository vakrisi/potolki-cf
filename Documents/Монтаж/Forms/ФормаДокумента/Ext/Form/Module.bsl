		КонецЕсли;
	Иначе
		//++ #14004 
		БылНаНесколькоДней = (Объект.СрокМонтажа = ПредопределенноеЗначение("Перечисление.СрокиМонтажа.МонтажНаНесколькоДней"));
		НаКакойСрокБыл = Объект.СрокМонтажа;
		Если НЕ Объект.СрокМонтажа = ПредопределенноеЗначение("Перечисление.СрокиМонтажа.МонтажНаНесколькоДней") Тогда
			Объект.СрокМонтажа = ПредопределенноеЗначение("Перечисление.СрокиМонтажа.МонтажНаНесколькоДней");
			УправлениеФормойНаСервере();
		Иначе
			// было на несколько дней и еще добавили несколько дней
			// удаляем строку, на которой стоим
			Если НЕ ТекущиеДанные = Неопределено Тогда
				Объект.ГрафикМонтажей.Удалить(ТекущиеДанные.НомерСтроки - 1);
			КонецЕсли;
		КонецЕсли;
	
		КоличествоДней = (НачалоДня(Конец) - НачалоДня(Начало)) / 86400;
		
