&НаКлиенте
Процедура ЗаполнитьПоСпецификациям(Команда)
	
	ПоДеревуМатериалов = (Команда.Имя = "ЗаполнитьПоСпецификациямДерево");
	Если ПоДеревуМатериалов Тогда
		ПеренестиДеревоВТабличнуюЧасть();
	КонецЕсли;
	
	СпецификацииЕсть = СпецификацииЕсть();
	Если СпецификацииЕсть Тогда
		Если Объект.Материалы.Количество() > 0 Тогда
			
			//++ №11095 нужно предложить несколько вариантов заполнения
			ВариантыОтветов = Новый СписокЗначений;
			ВариантыОтветов.Добавить(Истина, "Очистить все ранее введенные материалы");
			ВариантыОтветов.Добавить(Ложь, "Дополнить только отсутствующими материалами по спецификации");
			ВариантыОтветов.Добавить(Неопределено, "Отмена");
			//-- №11095
			
			Оповещение = Новый ОписаниеОповещения("ЗаполнитьПоСпецификациямПослеВопроса", ЭтаФорма, ПоДеревуМатериалов);
			
			//++ №11095 меняем вопрос и варианты
			//ПоказатьВопрос(Оповещение, "Таблица материалов будет очищена и заменена значениями в соответствии со спецификациями. Продолжить?", РежимДиалогаВопрос.ДаНет);
			ПоказатьВопрос(Оповещение, "Выберите вариант заполнения материалов по спецификации:", ВариантыОтветов);
			//-- №11095
			
		Иначе
			ЗаполнитьПоСпецификациямНаСервере(ПоДеревуМатериалов);
			Если ПоДеревуМатериалов Тогда
				РазвернутьДеревоМатериалов();
			КонецЕсли;
		КонецЕсли;
	Иначе 
		Сообщить("Отсутствуют товары со спецификациями");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПоСпецификациямПослеВопроса(Результат, Параметры) Экспорт
	
	//++ №11095 добавлены варианты заполнения и отмена
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ОчиститьТЧ = (Результат = Истина);
	ДобавлятьТолькоОтсутствующиеПозиции = НЕ ОчиститьТЧ;
	//-- №11095
	
	ПоДеревуМатериалов = Параметры;
	
	//++ №11095 условие теперь не нужное
	//Если Результат = КодВозвратаДиалога.Нет Тогда
	//    Возврат;
	//КонецЕсли;
	//-- №11095
	
	ЗаполнитьПоСпецификациямНаСервере(ПоДеревуМатериалов, ОчиститьТЧ, ДобавлятьТолькоОтсутствующиеПозиции);
	Если ПоДеревуМатериалов Тогда
		РазвернутьДеревоМатериалов();
	КонецЕсли;
	
	Модифицированность = Истина; //++ №8238
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПоСпецификациямНаСервере(ПоДеревуМатериалов = Ложь, ОчиститьТЧ = Истина, ДобавлятьТолькоОтсутствующиеПозиции = Ложь)
	
	// #8471 заменено на единую функцию, так как не учитывались УИС. код который был (ниже) пока закомментирован
	МассивПозиций = Новый Массив;
	Для Каждого СтрокаТЧ Из Объект.ТоварыУслуги Цикл
		Если НЕ СтрокаТЧ.Спецификация.Пустая() Тогда
			Позиция = Новый Структура("Комната,Номенклатура,УИСтроки,Количество,Коэффициент,ЕдиницаИзмерения,Спецификация");
