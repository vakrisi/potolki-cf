&НаСервере
Процедура УправлениеФормойНаСервере()
	//++16681
	Элементы.ГруппаДатаМонтажаОдиночный.Видимость = (Объект.СрокМонтажа = Перечисления.СрокиМонтажа.МонтажНаОдинДень);
	Элементы.ГруппаДатаМонтажаСписком.Видимость   = (Объект.СрокМонтажа = Перечисления.СрокиМонтажа.МонтажНаНесколькоДней);
	//--16681
КонецПроцедуры

&НаКлиенте
Процедура ДатаМонтажаПриИзменении(Элемент)
	
	Если ЗначениеЗаполнено(Объект.ДатаМонтажа) Тогда
		Если НЕ Объект.ДатаМонтажа >= ДатаНачала ИЛИ НЕ Объект.ДатаМонтажа <= ДатаОкончания Тогда
			ДатаНачала = Объект.ДатаМонтажа;	
			ДатаОкончания = Объект.ДатаМонтажа;
			ОбщийМодульКлиент.УстановитьПериодГрафикаДень(ЭтотОбъект, , Ложь);
		КонецЕсли;
	КонецЕсли;
	
	// #16697 изменил даты - выбери новое время
	Объект.ВремяНачала = Дата(1,1,1,0,0,0);
	Объект.ВремяОкончания = Дата(1,1,1,0,0,0);
		
	СформироватьГрафик();
	ДатаМонтажаПриИзмененииНаСервере();
	
КонецПроцедуры

