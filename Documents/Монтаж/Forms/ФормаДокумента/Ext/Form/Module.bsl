	//-- №10698
	|	СРЕДНЕЕ(ЕСТЬNULL(ТоварыМонтажДокумент.Количество, 0)) КАК КоличествоМонтаж,
	|	СРЕДНЕЕ(ЕСТЬNULL(ПеремещениеВыдача.Количество, 0)) КАК Выдано,
	|	СРЕДНЕЕ(ЕСТЬNULL(ПеремещениеВозврат.Количество, 0)) КАК Возврат,
	|	СРЕДНЕЕ(ЕСТЬNULL(ТоварыМонтажДокумент.Количество, 0) - (ЕСТЬNULL(ПеремещениеВыдача.Количество, 0) - ЕСТЬNULL(ПеремещениеВозврат.Количество, 0))) КАК Осталось
	|ИЗ
	|	ВТ_ТоварыНоменклатура КАК ТоварыМонтаж
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ТоварыКоличество КАК ТоварыМонтажДокумент
	|		ПО ТоварыМонтаж.Номенклатура = ТоварыМонтажДокумент.Номенклатура
	|			И ТоварыМонтаж.ХарактеристикаНоменклатуры = ТоварыМонтажДокумент.ХарактеристикаНоменклатуры
	|			И ТоварыМонтаж.СерияНоменклатуры = ТоварыМонтажДокумент.СерияНоменклатуры
	|			И ТоварыМонтаж.ТаблицаНазначения = ТоварыМонтажДокумент.ТаблицаНазначения
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ПеремещениеВыдача КАК ПеремещениеВыдача
	|		ПО ТоварыМонтаж.Номенклатура = ПеремещениеВыдача.Номенклатура
	|			И ТоварыМонтаж.ХарактеристикаНоменклатуры = ПеремещениеВыдача.ХарактеристикаНоменклатуры
	|			И ТоварыМонтаж.СерияНоменклатуры = ПеремещениеВыдача.СерияНоменклатуры
	|			И (ПеремещениеВыдача.СкладПолучатель = &СкладТоваров)
	|			И ТоварыМонтаж.ТаблицаНазначения = ПеремещениеВыдача.ТаблицаНазначения
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ПеремещениеВозврат КАК ПеремещениеВозврат
	|		ПО ТоварыМонтаж.Номенклатура = ПеремещениеВозврат.Номенклатура
	|			И ТоварыМонтаж.ХарактеристикаНоменклатуры = ПеремещениеВозврат.ХарактеристикаНоменклатуры
	|			И ТоварыМонтаж.СерияНоменклатуры = ПеремещениеВозврат.СерияНоменклатуры
	|			И (ПеремещениеВозврат.СкладОтправитель = &СкладТоваров)
	|			И ТоварыМонтаж.ТаблицаНазначения = ПеремещениеВозврат.ТаблицаНазначения
	//++#6297
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Монтаж.НеконтролируемыеМатериалы КАК НеконтролируемыеМатериалы
	|		ПО НеконтролируемыеМатериалы.Ссылка = &Монтаж
	|			И ТоварыМонтаж.Номенклатура = НеконтролируемыеМатериалы.Номенклатура
	|	
	|ГДЕ
	| 	НеконтролируемыеМатериалы.Номенклатура ЕСТЬ NULL
	//--#6297
	|
	|СГРУППИРОВАТЬ ПО
	|	ТоварыМонтаж.Номенклатура,
	|	ТоварыМонтаж.ХарактеристикаНоменклатуры,
	|	ТоварыМонтаж.СерияНоменклатуры,
	//++ №10698
	//|	ТоварыМонтаж.Номенклатура.БазоваяЕдиницаИзмерения
	|	ТоварыМонтаж.ЕдиницаИзмерения,
	|	ТоварыМонтаж.Коэффициент
	//-- №10698
	|";
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	Выборка = РезультатЗапроса[6].Выбрать();
	ВыборкаТоваров = РезультатЗапроса[7].Выбрать();
	
	////Создадим таблицу значений с материалами к выдаче - переделано на массивы со структурой, чтобы можно было между клиентом и сервером гулять
	//ТЗ_КВыдаче = новый ТаблицаЗначений;
	//ТЗ_КВыдаче.Колонки.Добавить("Номенклатура",,"Номенклатура");
	//ТЗ_КВыдаче.Колонки.Добавить("ХарактеристикаНоменклатуры",,"ХарактеристикаНоменклатуры");
	//ТЗ_КВыдаче.Колонки.Добавить("СерияНоменклатуры",,"СерияНоменклатуры");
	//ТЗ_КВыдаче.Колонки.Добавить("ЕдиницаИзмерения",,"ЕдиницаИзмерения");
	//ТЗ_КВыдаче.Колонки.Добавить("Коэффициент",,"Коэффициент");
	//ТЗ_КВыдаче.Колонки.Добавить("Количество",,"Количество");
	//ТЗ_КВыдаче.Колонки.Добавить("Таблица",,"Таблица");
	//
	////Создадим таблицу значений с материалами к возврату
	//ТЗ_КВозврату = новый ТаблицаЗначений;
	//ТЗ_КВозврату.Колонки.Добавить("Номенклатура",,"Номенклатура");
	//ТЗ_КВозврату.Колонки.Добавить("ХарактеристикаНоменклатуры",,"ХарактеристикаНоменклатуры");
	//ТЗ_КВозврату.Колонки.Добавить("СерияНоменклатуры",,"СерияНоменклатуры");
	//ТЗ_КВозврату.Колонки.Добавить("ЕдиницаИзмерения",,"ЕдиницаИзмерения");
	//ТЗ_КВозврату.Колонки.Добавить("Коэффициент",,"Коэффициент");
	//ТЗ_КВозврату.Колонки.Добавить("Количество",,"Количество");
	//ТЗ_КВозврату.Колонки.Добавить("Таблица",,"Таблица");
	
	ТЗ_КВыдаче 	 	= Новый Массив;
	ТЗ_КВозврату 	= Новый Массив;
	ТЗ_НеТребуется 	= Новый Массив;
	
	Пока Выборка.Следующий() Цикл
		НовСтрока = ПолучитьСтруктуруСтрокиДляПеремещения();
		Если Выборка.Осталось > 0 Тогда
			//НовСтрока = ТЗ_КВыдаче.Добавить();			
			ЗаполнитьЗначенияСвойств(НовСтрока, Выборка);
			НовСтрока.Количество = Выборка.Осталось;
			НовСтрока.Таблица = "Материалы";
			ТЗ_КВыдаче.Добавить(НовСтрока);
		ИначеЕсли Выборка.Осталось < 0 Тогда
			//НовСтрока = ТЗ_КВозврату.Добавить();
			ЗаполнитьЗначенияСвойств(НовСтрока, Выборка);
			НовСтрока.Количество = -Выборка.Осталось;
			НовСтрока.Таблица = "Материалы";
			ТЗ_КВозврату.Добавить(НовСтрока);
		Иначе // = 0
			ЗаполнитьЗначенияСвойств(НовСтрока, Выборка);
			НовСтрока.Количество = Выборка.Осталось;
			НовСтрока.Таблица = "Материалы";
			ТЗ_НеТребуется.Добавить(НовСтрока);
		КонецЕсли;
	КонецЦикла;
	
	Пока ВыборкаТоваров.Следующий() Цикл
		НовСтрока = ПолучитьСтруктуруСтрокиДляПеремещения();
		Если ВыборкаТоваров.Осталось > 0 Тогда
			//НовСтрока = ТЗ_КВыдаче.Добавить();
			ЗаполнитьЗначенияСвойств(НовСтрока, ВыборкаТоваров);
			НовСтрока.Количество = ВыборкаТоваров.Осталось;
			НовСтрока.Таблица = "Товары";
			ТЗ_КВыдаче.Добавить(НовСтрока);
		ИначеЕсли ВыборкаТоваров.Осталось < 0 Тогда
			//НовСтрока = ТЗ_КВозврату.Добавить();
			ЗаполнитьЗначенияСвойств(НовСтрока, ВыборкаТоваров);
			НовСтрока.Количество = -ВыборкаТоваров.Осталось;
			НовСтрока.Таблица = "Товары";
			ТЗ_КВозврату.Добавить(НовСтрока);
		Иначе // = 0
			ЗаполнитьЗначенияСвойств(НовСтрока, ВыборкаТоваров);
			НовСтрока.Количество = ВыборкаТоваров.Осталось;
			НовСтрока.Таблица = "Товары";
			ТЗ_НеТребуется.Добавить(НовСтрока);
		КонецЕсли;
	КонецЦикла;	
		
	Возврат Новый Структура("ТЗ_КВыдаче, ТЗ_КВозврату, ТЗ_НеТребуется", ТЗ_КВыдаче, ТЗ_КВозврату, ТЗ_НеТребуется);

КонецФункции

&НаСервере
Функция ПолучитьСтруктуруСтрокиДляПеремещения()
	
	Возврат Новый Структура("Номенклатура, ХарактеристикаНоменклатуры, СерияНоменклатуры, ЕдиницаИзмерения, Коэффициент, Количество, Таблица,
							|КоличествоМонтаж, Выдано, Возврат, Осталось,
	                        |СкладТоваровМатериалов");
	
КонецФункции

&НаСервере
Функция СоздатьДокументПеремещениеТоваров(ТоварыМатериалы, Выдача = Ложь); 	
	
	МассивСозданныхДокументов = Новый Массив;
	
	РазделятьПоНазначению = Константы.РазделятьПоНазначениюНоменклатурыПриПеремещенииИзМонтажа.Получить() 
							ИЛИ (Объект.СкладТоваров <> Объект.Склад);  //добавлено условие, если склады отличаются, одназначно нужно разделение
	
	// Если задана настройка разделять, то будут созданы два документа: один для материалов, другой для товаров	
	// перемещение материалов либо всего
	НовДокумент = Документы.ПеремещениеТоваров.СоздатьДокумент();
	НовДокумент.Дата = ТекущаяДатаСеанса();
	НовДокумент.Основание = Объект.Ссылка;
	НовДокумент.Назначение = Объект.Ссылка;
	//НовДокумент.ТаблицаНазначения = ?(РазделятьПоНазначению, "Материалы", "ТоварыИМатериалы"); // #13841 реквизит удален
	НовДокумент.Организация = Объект.Организация;
	НовДокумент.Автор = Пользователи.ТекущийПользователь();  	
	
	НовДокумент.ВидПеремещения = Справочники.ВидыПеремещений.ПеремещениеНаСкладМонтажнойБригады;  //#14793
	Если Выдача Тогда
		НовДокумент.ВидОперации = Перечисления.ВидыОперацийПеремещениеТоваров.Выдача;
		НовДокумент.СкладОтправитель = СкладАвтоматическогоПеремещения; 
		НовДокумент.СкладПолучатель = Объект.Склад;
	Иначе	
		НовДокумент.ВидОперации = Перечисления.ВидыОперацийПеремещениеТоваров.Возврат;
		НовДокумент.СкладПолучатель = СкладАвтоматическогоПеремещения; 
		НовДокумент.СкладОтправитель = Объект.Склад;
	КонецЕсли;
	
	Для Каждого Материал Из ТоварыМатериалы Цикл
		
		Если РазделятьПоНазначению И НЕ Материал.Таблица = "Материалы" Тогда
			Продолжить;
		КонецЕсли;
		
		НовСтрока = НовДокумент.Товары.Добавить();
		ЗаполнитьЗначенияСвойств(НовСтрока, Материал);
		НовСтрока.ТаблицаНазначения = Материал.Таблица;
		
	КонецЦикла;		
	
	Если НовДокумент.Товары.Количество() > 0 Тогда		
		Попытка
			НовДокумент.Записать();
			МассивСозданныхДокументов.Добавить(НовДокумент.Ссылка);
			Сообщить("Создан документ перемещения материалов " + ?(РазделятьПоНазначению, "", "и товаров ") 
						+ ?(Выдача, "с видом операции ""Выдача"" ", "с видом операции ""Возврат"" ") + НовДокумент.Ссылка);
		Исключение
			Сообщить("Не удалось записать документ перемещения товаров");
			Сообщить(ОписаниеОшибки());
		КонецПопытки;
	КонецЕсли;
	
	Если РазделятьПоНазначению Тогда
		
		//перемещение товаров
		НовДокумент = Документы.ПеремещениеТоваров.СоздатьДокумент();
		НовДокумент.Дата = ТекущаяДатаСеанса();
		НовДокумент.Основание = Объект.Ссылка;
		НовДокумент.Назначение = Объект.Ссылка;
		//НовДокумент.ТаблицаНазначения = "Товары"; // #13841 реквизит удален
		НовДокумент.Организация = Объект.Организация;
		НовДокумент.Автор = Пользователи.ТекущийПользователь();
		
		НовДокумент.ВидПеремещения = Справочники.ВидыПеремещений.ПеремещениеНаСкладМонтажнойБригады;  //#14793
		Если Выдача Тогда
			НовДокумент.ВидОперации = Перечисления.ВидыОперацийПеремещениеТоваров.Выдача;
			НовДокумент.СкладОтправитель = СкладАвтоматическогоПеремещения; //Константы.СкладПриходРасходПриПеремещенииИзМонтажаБригадам.Получить();
			НовДокумент.СкладПолучатель = Объект.СкладТоваров;
		Иначе	
			НовДокумент.ВидОперации = Перечисления.ВидыОперацийПеремещениеТоваров.Возврат;
			НовДокумент.СкладПолучатель = СкладАвтоматическогоПеремещения; //Константы.СкладПриходРасходПриПеремещенииИзМонтажаБригадам.Получить();
			НовДокумент.СкладОтправитель = Объект.СкладТоваров;
		КонецЕсли;
		
		Для Каждого Материал Из ТоварыМатериалы Цикл
			Если Материал.Таблица = "Товары" Тогда
				НовСтрока = НовДокумент.Товары.Добавить();
				ЗаполнитьЗначенияСвойств(НовСтрока, Материал);
				НовСтрока.ТаблицаНазначения = Материал.Таблица;
			КонецЕсли;
		КонецЦикла;		
		
		Если НовДокумент.Товары.Количество() > 0 Тогда
			Попытка
				НовДокумент.Записать();
				МассивСозданныхДокументов.Добавить(НовДокумент.Ссылка);
				Сообщить("Создан документ перемещения товаров " + ?(Выдача, "с видом операции ""Выдача"" ", "с видом операции ""Возврат"" ") + НовДокумент.Ссылка);
			Исключение
				Сообщить("Не удалось записать документ перемещения товаров");
				Сообщить(ОписаниеОшибки());
			КонецПопытки;
		КонецЕсли;
		
	КонецЕсли;	
	
	Возврат МассивСозданныхДокументов;
	
КонецФункции	

&НаКлиенте
Процедура ЗаполнитьМатериалыПоДоговору(Команда)
	
	Если Объект.Материалы.Количество() > 0 Тогда
		ОписаниеОповещения = Новый ОписаниеОповещения("ПослеВопросаОбОчисткеМатериаловПередЗаполнениемПоДоговору",ЭтаФорма);
		ПоказатьВопрос(ОписаниеОповещения, "Очистить таблицу материалов?",РежимДиалогаВопрос.ДаНет);
	Иначе
		ЗаполнитьМатериалыПоДоговоруНаСервере(Истина);
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВопросаОбОчисткеМатериаловПередЗаполнениемПоДоговору(Результат, Параметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
        ЗаполнитьМатериалыПоДоговоруНаСервере(Истина);
	Иначе
		ЗаполнитьМатериалыПоДоговоруНаСервере(Ложь);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьМатериалыПоДоговоруНаСервере(ОчиститьМатериалы = Ложь)
	
	Если ОчиститьМатериалы Тогда
		Объект.Материалы.Очистить();
	КонецЕсли;
	
	Если ТипЗнч(Объект.Основание) = Тип("ДокументСсылка.ЗаказДоговор") Тогда
		Для Каждого МатериалОснования Из Объект.Основание.Материалы Цикл
			Если НЕ МатериалОснования.Номенклатура.Пустая() Тогда
				НоваяСтрока = Объект.Материалы.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, МатериалОснования);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыУслугиКомнатаОкончаниеВводаТекста(Элемент, Текст, ДанныеВыбора, ПараметрыПолученияДанных, СтандартнаяОбработка)
	Если Элементы.ТоварыУслугиКомната.СписокВыбора.НайтиПоЗначению(Текст) = Неопределено Тогда  
		Элементы.ТоварыУслугиКомната.СписокВыбора.Добавить(Текст);
		Элементы.МатериалыКомната.СписокВыбора.Добавить(Текст);
	КонецЕсли;	
	Элементы.ТоварыУслугиКомната.СписокВыбора.СортироватьПоЗначению();
	Элементы.МатериалыКомната.СписокВыбора.СортироватьПоЗначению();
КонецПроцедуры

&НаКлиенте
Процедура МатериалыКомнатаОкончаниеВводаТекста(Элемент, Текст, ДанныеВыбора, ПараметрыПолученияДанных, СтандартнаяОбработка)
	Если Элементы.МатериалыКомната.СписокВыбора.НайтиПоЗначению(Текст) = Неопределено Тогда  
		Элементы.ТоварыУслугиКомната.СписокВыбора.Добавить(Текст);
		Элементы.МатериалыКомната.СписокВыбора.Добавить(Текст);
	КонецЕсли;	
	Элементы.ТоварыУслугиКомната.СписокВыбора.СортироватьПоЗначению();
	Элементы.МатериалыКомната.СписокВыбора.СортироватьПоЗначению();
КонецПроцедуры
		
