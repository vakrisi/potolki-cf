&НаКлиенте
Процедура ПослеВыбораДокументаЗаполненияДерева(Результат, ДопПараметры) Экспорт
	
	Если ТипЗнч(Результат) = Тип("ДокументСсылка.ЗаказПокупателя") 
		ИЛИ ТипЗнч(Результат) = Тип("ДокументСсылка.ПеремещениеТоваров") 
		ИЛИ ТипЗнч(Результат) = Тип("ДокументСсылка.ПоступлениеТоваровИУслуг") Тогда
		
		МассивТоваровМонтажа = Новый Массив;
		СтрокиКомнат = ДеревоТоваров.ПолучитьЭлементы(); 
		Для каждого СтрокаКомнаты из СтрокиКомнат Цикл
			СтрокиТоваров = СтрокаКомнаты.ПолучитьЭлементы();
			Для каждого СтрокаТовара из СтрокиТоваров Цикл
				МассивТоваровМонтажа.Добавить(Новый Структура("Комната, Номенклатура, ХарактеристикаНоменклатуры", СтрокаКомнаты.Комната, СтрокаТовара.Номенклатура, СтрокаТовара.ХарактеристикаНоменклатуры));
			КонецЦикла;										
		КонецЦикла;
	
		// Нужно проставить комнаты
		СписокКомнат = ПолучитьСписокКомнатПоМатериаламПоДереву();
		Оповещение = Новый ОписаниеОповещения("ПослеУстановкиКомнатыПриЗаполненииМатериалами", ЭтотОбъект);
		ПараметрыФормы = Новый Структура("ДокументИсточник, СписокКомнат, МассивТоваровМонтажа", Результат, СписокКомнат, МассивТоваровМонтажа);
		ОткрытьФорму("Документ.Монтаж.Форма.ФормаУстановкиКомнаты", ПараметрыФормы, ЭтаФорма,,,, Оповещение, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьСписокКомнатПоМатериаламПоДереву()
	
	СписокКомнат = Новый СписокЗначений;

	ВремДеревоМатериалов = РеквизитФормыВЗначение("ДеревоМатериалов");
	Для Каждого СтрокаКомнат Из ВремДеревоМатериалов.Строки Цикл
		СписокКомнат.Добавить(СтрокаКомнат.Комната);
	КонецЦикла;
	
	Возврат СписокКомнат;
	
КонецФункции	

&НаКлиенте
Процедура ПослеУстановкиКомнатыПриЗаполненииМатериалами(Результат, ДопПараметры) Экспорт
	
	Если НЕ ТипЗнч(Результат) = Тип("Массив") Тогда
		Возврат;
	КонецЕсли;
	
	//#9958
	ТекстВопроса = "";
	СтрокиКомнат = ДеревоТоваров.ПолучитьЭлементы();
	Для Каждого СтруктураСтроки Из Результат Цикл 
		Для каждого СтрокаКомнаты из СтрокиКомнат Цикл
			Если СтрокаКомнаты.Комната = СтруктураСтроки.Комната Тогда
				СтрокиТоваров = СтрокаКомнаты.ПолучитьЭлементы();
				Для каждого СтрокаТовара из СтрокиТоваров Цикл
					Если СтруктураСтроки.Номенклатура = СтрокаТовара.Номенклатура
						И СтруктураСтроки.Характеристика = СтрокаТовара.ХарактеристикаНоменклатуры Тогда
						ТекстВопроса = ТекстВопроса + 
								Строка(СтруктураСтроки.Номенклатура) + 
								?(ЗначениеЗаполнено(СтруктураСтроки.Характеристика), " (" + Строка(СтруктураСтроки.Характеристика) + ")", "") +
								Символы.ПС;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;						
		КонецЦикла;	
	КонецЦикла;
	
	Если ПустаяСтрока(ТекстВопроса) Тогда
		ПослеУстановкиКомнатыПриЗаполненииМатериаламиЗавершение(Результат);
	Иначе
		ТекстВопроса = "ВНИМАНИЕ! В выбранных к переносу в материалы позициях имеется номенклатура, присутствующая в товарах монтажа:" + 
				Символы.ПС + ТекстВопроса + "Продолжить?";
		ОписаниеОповещения = Новый ОписаниеОповещения("ПослеУстановкиКомнатыПриЗаполненииМатериаламиФрагмент", ЭтаФорма, Результат);
		ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеУстановкиКомнатыПриЗаполненииМатериаламиФрагмент(Ответ, ДополнительныеПараметры) Экспорт

	Если Ответ = КодВозвратаДиалога.Да Тогда
		ПослеУстановкиКомнатыПриЗаполненииМатериаламиЗавершение(ДополнительныеПараметры);	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеУстановкиКомнатыПриЗаполненииМатериаламиЗавершение(Результат)

	ЗаполнитьМатериалыПоВыбранномуДокументуНаСервере(Результат);
	
	ПеренестиДеревоВТабличнуюЧасть();
	ПерестроитьДеревоНаФорме(Истина);
	ОбновитьДанныеДокумента();
	РазвернутьДеревоМатериалов();
	
	ОбновитьНадписьВкладкиМатериалы();
	
	Модифицированность = Истина; //++ №8238
	
КонецПроцедуры	

&НаСервере
Процедура ЗаполнитьМатериалыПоВыбранномуДокументуНаСервере(СписокПозиций)
	
	Для Каждого ТекущаяСтрока Из СписокПозиций Цикл
		ПослеВыбораНоменклатурыМатериалаНаСервере(ТекущаяСтрока.Номенклатура, ТекущаяСтрока.Комната, ТекущаяСтрока);
	КонецЦикла;
	
КонецПроцедуры	

&НаСервереБезКонтекста
Функция ТребуетсяОповещениеЦентраСобытий(Результат, СозданПриИспользованииСтатусаЗакрыт)
	
	// №12802 было: ИспользоватьСтатусЗакрыт = Константы.ИспользоватьСтатусЗакрытВМонтаже.Получить();
	Если ПолучитьФункциональнуюОпцию("АвтоматическиПереводитьЗаказДоговорВСтатусВыполнен") Тогда		
		Если (Результат = Справочники.РезультатыМонтажа.Выполнен И НЕ СозданПриИспользованииСтатусаЗакрыт)
			ИЛИ (Результат = Справочники.РезультатыМонтажа.Закрыт И СозданПриИспользованииСтатусаЗакрыт) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЕсли;
	Возврат Ложь;
	
КонецФункции

&НаСервере
Процедура УправлениеФормойПоБригадеНаСервере()
	
	БригадаЗаполнена = НЕ Объект.Бригада.Пустая();
	
	Элементы.Бригада.ТолькоПросмотр  = Ложь;
	Элементы.Бригадир.ТолькоПросмотр = Ложь;
	
	Элементы.ГруппаИсполнители.ТолькоПросмотр = НЕ БригадаЗаполнена;
	Элементы.Исполнители.КоманднаяПанель.Доступность = БригадаЗаполнена;
	
	Элементы.СтраницаПотребность.ТолькоПросмотр = НЕ БригадаЗаполнена;
	Элементы.ПотребностьКоманднаяПанельКоманды.Доступность = БригадаЗаполнена;
	
	Элементы.ГруппаВыработка.ТолькоПросмотр = НЕ БригадаЗаполнена;
	Элементы.РучнаяКорректировкаВыработки.Доступность = Элементы.РучнаяКорректировкаВыработки.Доступность И БригадаЗаполнена;
	
	//#9168
	Если ИспользуетсяПулМонтажей 
		И НЕ БригадаЗаполнена 
		И (ЗначениеЗаполнено(Объект.ВремяНачала) ИЛИ Объект.ГрафикМонтажей.Количество() > 0) Тогда
		Элементы.Бригада.ТолькоПросмотр  = Истина;
		Элементы.Бригадир.ТолькоПросмотр = Истина;		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПодобратьМатериалы(Команда)
	
	ТекущиеДанные = Элементы.ДеревоМатериалов.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		ПоказатьОповещениеПользователя("Выберите комнату");
		Возврат;
	КонецЕсли;
	
	Если ПустаяСтрока(ТекущиеДанные.Комната) Тогда
		ПоказатьОповещениеПользователя("Выберите комнату");
		Возврат;
	КонецЕсли;
	
	ПараметрыПодбора = Новый Структура;
	ПараметрыПодбора.Вставить("Дата",					Объект.Дата);
	ПараметрыПодбора.Вставить("Организация",		Объект.Организация);
	ПараметрыПодбора.Вставить("Склад",				Объект.Склад);
	ПараметрыПодбора.Вставить("ВидЦены",			Объект.ВидЦен);
	ПараметрыПодбора.Вставить("НеЗапрашиватьЦену",	Истина);
	
	//++ №11160
	ПараметрыПодбора.Вставить("ТипДокумента", 		"Монтаж");
	ПараметрыПодбора.Вставить("Назначение",			"Материалы");
	//-- №11160
	
	// Подготовим доступные виды номенклатуры для выбор
	СписокВидов = новый СписокЗначений;
	СписокВидов.Добавить(ПредопределенноеЗначение("Справочник.ВидыНоменклатуры.Материал"));
	СписокВидов.Добавить(ПредопределенноеЗначение("Справочник.ВидыНоменклатуры.ОстатокПленки"));
	СписокВидов.Добавить(ПредопределенноеЗначение("Справочник.ВидыНоменклатуры.Отрез"));
	СписокВидов.Добавить(ПредопределенноеЗначение("Справочник.ВидыНоменклатуры.Полотно"));
	СписокВидов.Добавить(ПредопределенноеЗначение("Справочник.ВидыНоменклатуры.ТиповойОтрез"));
	СписокВидов.Добавить(ПредопределенноеЗначение("Справочник.ВидыНоменклатуры.Потолок"));
	ПараметрыПодбора.Вставить("ВидНоменклатуры", СписокВидов);
	
	ОП = новый ОписаниеОповещения("ПослеПодбораМатериалов", ЭтотОбъект, новый Структура("Комната", Элементы.ДеревоМатериалов.ТекущиеДанные.Комната));
	
	ОткрытьФорму("ОбщаяФорма.ФормаПодбораНоменклатуры", ПараметрыПодбора, ЭтотОбъект,,,, ОП);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеПодбораМатериалов(ВозвращенноеЗначение, ДопПараметры) Экспорт
	
	Если Не ЗначениеЗаполнено(ВозвращенноеЗначение) Тогда
		Возврат;
	КонецЕсли;
	
	ДобавленнаяНоменклатура = ОбработкаВыбораПодборМатериаловНаСервере(ВозвращенноеЗначение, ДопПараметры);
	
	ПеренестиДеревоВТабличнуюЧасть();
	ЗаполнитьОстаткиПоМатериалам();
	ПерезаполнитьПотребность();
	ПерестроитьДеревоНаФорме();
	РазвернутьДеревоМатериалов();
	
	ДобавленнаяСтрока = Неопределено;
	Если НЕ ДобавленнаяНоменклатура = Неопределено Тогда
		ДобавленнаяСтрока = НайтиСтрокуДереваМатериалов(ДопПараметры.Комната, ДобавленнаяНоменклатура);
	КонецЕсли;
	Если НЕ ДобавленнаяСтрока = Неопределено Тогда
		Элементы.ДеревоМатериалов.ТекущаяСтрока = ДобавленнаяСтрока.ПолучитьИдентификатор();
	КонецЕсли;
	
	ОбновитьНадписьВкладкиМатериалы();
	
	Модифицированность = Истина; //++ №8238
	
КонецПроцедуры

&НаСервере
Функция ОбработкаВыбораПодборМатериаловНаСервере(ВыбранноеЗначение, ДопПараметры)
	
	ТаблицаМатериалов = ПолучитьИзВременногоХранилища(ВыбранноеЗначение.АдресВХранилище);
	
	ДобавленнаяНоменклатура = Неопределено;
	
	Для Каждого ТекущаяСтрока Из ТаблицаМатериалов Цикл
		СтруктураСтроки = новый Структура("Характеристика, ЕдиницаИзмерения, Количество, Коэффициент, ИспользоватьВТекущемМонтаже", ТекущаяСтрока.ХарактеристикаНоменклатуры, ТекущаяСтрока.ЕдиницаИзмерения, ТекущаяСтрока.Количество, ТекущаяСтрока.Коэффициент, Истина);
			
		ПослеВыбораНоменклатурыМатериалаНаСервере(ТекущаяСтрока.Номенклатура, ДопПараметры.Комната, СтруктураСтроки);
		ДобавленнаяНоменклатура = ТекущаяСтрока.Номенклатура;
	КонецЦикла;
	
	Возврат ДобавленнаяНоменклатура;
	
КонецФункции

&НаКлиенте
Процедура ДеревоМатериаловЕдиницаИзмеренияПриИзменении(Элемент)
	
	//корневые строки редактировать нельзя
	Если Элементы.ДеревоМатериалов.ТекущиеДанные.ПолучитьРодителя() = Неопределено Тогда
		Элементы.ДеревоМатериалов.ТекущиеДанные.ЕдиницаИзмерения = Неопределено;
		Возврат;
	КонецЕсли;
	
	СтрокаТабличнойЧасти = Элементы.ДеревоМатериалов.ТекущиеДанные;
	Если ТипЗнч(СтрокаТабличнойЧасти.ЕдиницаИзмерения) = Тип("СправочникСсылка.КлассификаторЕдиницИзмерения") Тогда
		СтрокаТабличнойЧасти.Коэффициент = 1;
	Иначе
		СтрокаТабличнойЧасти.Коэффициент = ОбщийМодуль.ПолучитьКоэффициентЕдиницыИзмерения(СтрокаТабличнойЧасти.ЕдиницаИзмерения);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоМатериаловЕдиницаИзмеренияНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	СтрокаТабличнойЧасти = Элементы.ДеревоМатериалов.ТекущиеДанные;
	СписокЕдиниц = ОбщийМодуль.ПолучитьСписокЕдиницИзмеренияНоменклатуры(СтрокаТабличнойЧасти.Номенклатура);
	
	ДанныеВыбора = Новый СписокЗначений;
	Для Ном = 0 По СписокЕдиниц.Количество() - 1 Цикл
		ДанныеВыбора.Добавить(СписокЕдиниц[Ном]);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ГруппаСтраницПриСменеСтраницы(Элемент, ТекущаяСтраница)
	
	// СтандартныеПодсистемы.Свойства
	Если ТекущаяСтраница.Имя = "ГруппаДополнительно"
		И Не ЭтотОбъект.ПараметрыСвойств.ВыполненаОтложеннаяИнициализация Тогда
		СвойстваВыполнитьОтложеннуюИнициализацию();
		УправлениеСвойствамиКлиент.ПослеЗагрузкиДополнительныхРеквизитов(ЭтотОбъект);
	КонецЕсли;
	// Конец СтандартныеПодсистемы.Свойства

КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьДанныеНоменклатуры(ПозицияНоменклатуры)
	
	СтруктураОтвета = Новый Структура;
	СтруктураОтвета.Вставить("ЭтоПотолок", Справочники.ВидыНоменклатуры.ЭтоНоменклатураПотолкаИлиОтреза(ПозицияНоменклатуры));
	СтруктураОтвета.Вставить("ЭтоУникальныйПотолок", Справочники.ВидыНоменклатуры.ЭтоНоменклатураУникальногоПотолкаИлиОтреза(ПозицияНоменклатуры));
	СтруктураОтвета.Вставить("Потолок_КоличествоПродукция", ПозицияНоменклатуры.Потолок_КоличествоПродукция);
	Возврат СтруктураОтвета;
	
КонецФункции

&НаКлиенте
Процедура СкопироватьМатериалыВДругуюКомнату(Команда)
		
	ВыделенныеСтроки = Элементы.ДеревоМатериалов.ВыделенныеСтроки;
	Если ВыделенныеСтроки.Количество() = 0 Тогда
		ПоказатьПредупреждение(, "Выберите материалы, которые нужно скопировать");
		Возврат;
	КонецЕсли;
	
	Для каждого ТекущаяСтрока из ВыделенныеСтроки Цикл
		СтрокаТЧ = ДеревоМатериалов.НайтиПоИдентификатору(ТекущаяСтрока);
		
		Если СтрокаТЧ.Номенклатура.Пустая() Тогда
			ПоказатьПредупреждение(,"Выберите материалы, которые нужно скопировать");
			Возврат;
		КонецЕсли;
	
		ДанныеНоменклатуры = ПолучитьДанныеНоменклатуры(СтрокаТЧ.Номенклатура);
		Если ДанныеНоменклатуры.ЭтоУникальныйПотолок Тогда
			ПоказатьПредупреждение(,"Копирование потолков запрещено!");
			Возврат;
		КонецЕсли;
	КонецЦикла;	
	
	СписокКомнат = ОбщийМодульКлиент.ПолучитьСписокКомнатПоДереву(ДеревоМатериалов);	
	ДопПараметры = Новый Структура;
	
	СкопироватьВДругуюКомнатуПодтверждение = Новый ОписаниеОповещения("СкопироватьМатериалыВДругуюКомнатуПодтверждение", ЭтаФорма, ДопПараметры);
	СписокКомнат.ПоказатьВыборЭлемента(СкопироватьВДругуюКомнатуПодтверждение, "Выберите комнату");
	
КонецПроцедуры

&НаКлиенте
Процедура СкопироватьМатериалыВДругуюКомнатуПодтверждение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИмяКомнаты = Результат.Значение;
	Если ИмяКомнаты = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	НоваяСтрока = Неопределено;
	ЭлементыДерева = ДеревоМатериалов.ПолучитьЭлементы();
	Для Каждого ТекЭлемент из ЭлементыДерева Цикл
		Если СокрЛП(ТекЭлемент.Комната) = СокрЛП(ИмяКомнаты) Тогда			
			ВыделенныеСтроки = Элементы.ДеревоМатериалов.ВыделенныеСтроки;	
			Для каждого ТекущаяСтрока из ВыделенныеСтроки Цикл
				СтрокаТЧ = ДеревоМатериалов.НайтиПоИдентификатору(ТекущаяСтрока);
				
				НоваяСтрока = ТекЭлемент.ПолучитьЭлементы().Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТЧ, , "Комната, УИСтроки, КоличествоВЗаказДоговоре, КоличествоВДругихМонтажах, КоличествоВМонтажах, Заказано");
				НоваяСтрока.Комната = ИмяКомнаты;
				НоваяСтрока.ИспользоватьВТекущемМонтаже = Истина;
		
			КонецЦикла;
			
			// на случай, если в комнате не было позиций
			ИдентификаторСтроки = ТекЭлемент.ПолучитьИдентификатор();
			Элементы.ДеревоМатериалов.Развернуть(ИдентификаторСтроки);
			
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	ПеренестиДеревоВТабличнуюЧасть();
	
	ОбновитьНадписьВкладкиМатериалы();
	
	Если НоваяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

