#КонецОбласти

&НаСервере
Процедура ОбработкаДобавленияПрофиляСервер(МассивМатериалов)
	Если ОтображатьТоварыИМатериалыВВидеДерева() Тогда 
		Дерево = ДанныеФормыВЗначение(ДеревоМатериалов, Тип("ДеревоЗначений"));
		Для каждого ЭлементМассива из МассивМатериалов Цикл
			ДобавленоПоКомнате = Ложь;
			
			Для Каждого Строка из Дерево.Строки Цикл
				Если НЕ ДобавленоПоКомнате И Строка.Комната = ЭлементМассива.Комната Тогда
					Стр = Строка.Строки.Добавить();
					Стр.Номенклатура = ЭлементМассива.Номенклатура;
					Стр.Комната = ЭлементМассива.Комната;
					Стр.Количество = ЭлементМассива.Количество;
					
					Стр.ЕдиницаИзмерения = ПолучитьБазовуюЕдиницуИзмеренияНоменклатуры(Стр.Номенклатура);
					Стр.Коэффициент = 1;
					
					Стр.ИспользоватьВТекущемМонтаже = Истина;
					ДобавленоПоКомнате = Истина;					
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
		ЗначениеВДанныеФормы(Дерево, ДеревоМатериалов);
	Иначе
		Для каждого ЭлементМассива из МассивМатериалов Цикл
			НоваяСтрока = Объект.Материалы.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ЭлементМассива);
			НоваяСтрока.ЕдиницаИзмерения = НоваяСтрока.Номенклатура.БазоваяЕдиницаИзмерения;
			НоваяСтрока.Коэффициент = 1;
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура СформироватьГрафик(ИдентификаторСтроки = Неопределено, ЭтоИзменениеДатОтображенияГрафика = Ложь)
	
	ДанныеТекущегоМонтажа = Новый Структура("ДатаМонтажа, ВремяНачала, ВремяОкончания, НомерСтроки");
	Если НЕ Объект.СрокМонтажа = ПредопределенноеЗначение("Перечисление.СрокиМонтажа.МонтажНаНесколькоДней") Тогда
		ЗаполнитьЗначенияСвойств(ДанныеТекущегоМонтажа, Объект);
		ДанныеТекущегоМонтажа.НомерСтроки = Неопределено;
	Иначе
		ТекущиеДанные = Неопределено;
		Если НЕ ИдентификаторСтроки = Неопределено Тогда
			ТекущиеДанные = Объект.ГрафикМонтажей.НайтиПоИдентификатору(ИдентификаторСтроки);
		ИначеЕсли Объект.ГрафикМонтажей.Количество() > 0 Тогда
			ТекущиеДанные = Объект.ГрафикМонтажей[0];
		КонецЕсли;
		
		Если НЕ ТекущиеДанные = Неопределено Тогда
			ЗаполнитьЗначенияСвойств(ДанныеТекущегоМонтажа, ТекущиеДанные);		
		КонецЕсли;
	КонецЕсли;
	СформироватьГрафикНаСервере(ДанныеТекущегоМонтажа, ЭтоИзменениеДатОтображенияГрафика);
	ОбновитьОтображениеДанных();
	
	ОбновитьБригадуВГрафикеМонтажей(); // №10185
	
КонецПроцедуры

&НаСервере
Процедура ПолучитьПервоначальныеДанныеДляГрафикаМонтажей(ДанныеТекущегоМонтажа) 
	
	// формируем таблицу с данными для вывода на график	
	ТаблицаМонтажей.Очистить();
	ТаблицаБригад = МодульОтчетов.ПолучитьТаблицуБригад(ФильтрТочкаПродаж);
	МассивБригад  = ТаблицаБригад.ВыгрузитьКолонку("Бригада");
	Если ПолучитьФункциональнуюОпцию("ИспользоватьПулМонтажей") Тогда
		МассивБригад.Добавить(Справочники.Бригады.ПустаяСсылка());
	КонецЕсли;
	
	ОтображаемаяДатаМонтажа = ?(ЗначениеЗаполнено(ДанныеТекущегоМонтажа.ДатаМонтажа), ДанныеТекущегоМонтажа.ДатаМонтажа, ТекущаяДатаСеанса());
	
	//получаем таблицу из регистра для отображения графика за заданный период
	//++ №10185 теперь график строится на несколько дней
	//ТаблицаМонтажейВрем = МодульОтчетов.ПолучитьТаблицуМонтажей(ОтображаемаяДатаМонтажа, ОтображаемаяДатаМонтажа, МассивБригад);
	ТаблицаМонтажейВрем = МодульОтчетов.ПолучитьТаблицуМонтажей(ДатаНачала, КонецДня(ДатаОкончания), МассивБригад);
	//-- №10185
	
	Для каждого СтрокаТЗ из ТаблицаМонтажейВрем Цикл		
		Если НЕ СтрокаТЗ.Регистратор = Объект.Ссылка Тогда
			НоваяСтрока = ТаблицаМонтажей.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТЗ, 
									"Регистратор, Бригада, Дата, ВремяНачала, ВремяОкончания, 
									|Адрес, Контрагент, КомментарийКМонтажу,
									|ИндексСтроки, Основание, Порядок, ИДМонтажа");
		КонецЕсли;
	КонецЦикла;
	
	Если НЕ Объект.СрокМонтажа = Перечисления.СрокиМонтажа.МонтажНаНесколькоДней Тогда
		Если НЕ Объект.СрокМонтажа = Перечисления.СрокиМонтажа.ДатаМонтажаНеОпределена Тогда
			НоваяСтрока = ТаблицаМонтажей.Добавить();
			НоваяСтрока.Регистратор = Объект.Ссылка;
			НоваяСтрока.Дата = Объект.ДатаМонтажа;
			НоваяСтрока.ВремяНачала    = ОбщийМодульКлиентСервер.СоединитьДатуИВремя(Объект.ДатаМонтажа, Объект.ВремяНачала);
			НоваяСтрока.ВремяОкончания = ОбщийМодульКлиентСервер.СоединитьДатуИВремя(Объект.ДатаМонтажа, Объект.ВремяОкончания);
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Объект, "Бригада, Адрес, Контрагент, КомментарийКМонтажу, Основание");
			НоваяСтрока.Выделять = Истина;
			НоваяСтрока.ИДМонтажа = Строка(Объект.ИДМонтажа);
		КонецЕсли;
	Иначе
		Для каждого СтрокаТЧ из объект.ГрафикМонтажей Цикл
			Если ЗначениеЗаполнено(СтрокаТЧ.ДатаМонтажа) И ЗначениеЗаполнено(СтрокаТЧ.ВремяНачала) Тогда
				//И НачалоДня(СтрокаТЧ.ДатаМонтажа) = НачалоДня(ОтображаемаяДатаМонтажа) Тогда // №10185 комментируем, т.к. график строится на несколько дней
				НоваяСтрока = ТаблицаМонтажей.Добавить();
				НоваяСтрока.Регистратор = Объект.Ссылка;
				НоваяСтрока.Дата = СтрокаТЧ.ДатаМонтажа;
				НоваяСтрока.ВремяНачала    = ОбщийМодульКлиентСервер.СоединитьДатуИВремя(СтрокаТЧ.ДатаМонтажа, СтрокаТЧ.ВремяНачала);
				НоваяСтрока.ВремяОкончания = ОбщийМодульКлиентСервер.СоединитьДатуИВремя(СтрокаТЧ.ДатаМонтажа, СтрокаТЧ.ВремяОкончания);
				НоваяСтрока.ИндексСтроки = СтрокаТЧ.НомерСтроки;
				ЗаполнитьЗначенияСвойств(НоваяСтрока, Объект, "Бригада, Адрес, Контрагент, КомментарийКМонтажу, Основание");
				
				НоваяСтрока.Выделять = (ДанныеТекущегоМонтажа.ДатаМонтажа = СтрокаТЧ.ДатаМонтажа И ДанныеТекущегоМонтажа.ВремяНачала = СтрокаТЧ.ВремяНачала);
				НоваяСтрока.ИДМонтажа = Строка(СтрокаТЧ.ИДМонтажа);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;	
	
КонецПроцедуры

&НаСервере
Процедура СформироватьГрафикНаСервере(ДанныеТекущегоМонтажа, ЭтоИзменениеДатОтображенияГрафика)
	
	Элементы.ДекорацияПустойПланБригад.Видимость = Ложь;
	
	ПолучитьПервоначальныеДанныеДляГрафикаМонтажей(ДанныеТекущегоМонтажа);
	Если Вариант = 1 ИЛИ Вариант = 2 
		ИЛИ Вариант = 3 ИЛИ Вариант = 4 
		ИЛИ Вариант = 5 ИЛИ Вариант = 6 
		ИЛИ Вариант = 7 ИЛИ Вариант = 8 ИЛИ Вариант = 9 
		Тогда
		СформироватьГрафикМонтажейКалендарь(ДанныеТекущегоМонтажа, ЭтоИзменениеДатОтображенияГрафика);
		//ДобавитьМонтажВКалендарь(ДанныеТекущегоМонтажа);		
	КонецЕсли;
	
	ОписаниеБригадHTML = Документы.Монтаж.СформироватьОписаниеБригадHTML(ФильтрТочкаПродаж);	
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьИсполнителейБригады()
	
	Объект.Бригадир = Объект.Бригада.Бригадир;
	Объект.Исполнители.Очистить();
	Для Каждого ТекущийСотрудник Из Объект.Бригада.Сотрудники Цикл
		
		НоваяСтрока = Объект.Исполнители.Добавить();
		НоваяСтрока.Сотрудник = ТекущийСотрудник.Сотрудник;
		НоваяСтрока.Коэффициент = ТекущийСотрудник.Коэффициент;
		НоваяСтрока.ТарифИсполнителя = ТекущийСотрудник.ТарифИсполнителя;
		
		//#15230
		Если ОтображатьТрудоемкость Тогда
			РеквизитыСотрудника = ПолучитьРеквизитыСотрудника(ТекущийСотрудник.Сотрудник, "КоличествоВыполняемыхНормоЧасовМонтажаЗаЧасВремени");
			НоваяСтрока.КоличествоВыполняемыхНормоЧасовМонтажаЗаЧасВремени = РеквизитыСотрудника.КоличествоВыполняемыхНормоЧасовМонтажаЗаЧасВремени;
		КонецЕсли;
	
	КонецЦикла;
	ПересчитатьПроцентУчастияКТУИсполнителей();
	РассчитатьИтоговыеПоказателиСервер(); //#15230
	
КонецПроцедуры

&НаСервере
Процедура ПересчитатьПроцентУчастияКТУИсполнителей()
	
	// по аналогии с модулем зарплаты
	СуммаКоэффициентов = Объект.Исполнители.Итог("Коэффициент");
	
	Для Каждого ТекущаяСтрока Из Объект.Исполнители Цикл
		ТекущаяСтрока.ПроцентУчастия = ?(СуммаКоэффициентов = 0, 0, Окр(ТекущаяСтрока.Коэффициент / СуммаКоэффициентов, 4)*100);
	КонецЦикла;
		
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПроверитьСвободныйИнтервалМонтажей(ПараметрыНовогоМонтажа, Знач ТаблицаГрафикМонтажей, Знач ФильтрТочкаПродаж)
	
	//Возврат МодульОтчетов.ПроверитьСвободныйИнтервалМонтажей(ПараметрыНовогоМонтажа, ВариантГрафика, ФильтрТочкаПродаж);
	
	ВариантГрафика = 0;
	СтруктураПроверки = Новый Структура("Результат, ТекстОшибки", Истина, "");
	Результат = Истина;
	ТекстОшибки = "";
	ШаблонТекстаОшибки = "Интервал %1 %2-%3 для бригады ""%4"" занят!";
	
	Если НЕ ПолучитьФункциональнуюОпцию("ИспользоватьПулМонтажей") Тогда
		Результат = МодульОтчетов.ПроверитьСвободныйИнтервалМонтажей(ПараметрыНовогоМонтажа, ВариантГрафика, ФильтрТочкаПродаж);
		Если НЕ Результат Тогда
			ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонТекстаОшибки, Формат(ПараметрыНовогоМонтажа.ДатаМонтажа, "ДЛФ=D"), Формат(ПараметрыНовогоМонтажа.ВремяНачала, "ДЛФ=T"), Формат(ПараметрыНовогоМонтажа.ВремяОкончания, "ДЛФ=T"), ПараметрыНовогоМонтажа.Бригада);
			Возврат Новый Структура("Результат, ТекстОшибки", Ложь, ТекстОшибки);
		КонецЕсли;
	Иначе
		Если ПараметрыНовогоМонтажа.ИндексСтроки = 0 Тогда	
			Результат = МодульОтчетов.ПроверитьСвободныйИнтервалМонтажей(ПараметрыНовогоМонтажа, ВариантГрафика, ФильтрТочкаПродаж);
			Если НЕ Результат Тогда
				ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонТекстаОшибки, Формат(ПараметрыНовогоМонтажа.ДатаМонтажа, "ДЛФ=D"), Формат(ПараметрыНовогоМонтажа.ВремяНачала, "ДЛФ=T"), Формат(ПараметрыНовогоМонтажа.ВремяОкончания, "ДЛФ=T"), ПараметрыНовогоМонтажа.Бригада);
				Возврат Новый Структура("Результат, ТекстОшибки", Ложь, ТекстОшибки);
			КонецЕсли;
		Иначе		
			// Проверка: для монтажей на несколько дней надо проверить свободный интервал на каждый промежуток
			Для каждого СтрокаМонтажа из ТаблицаГрафикМонтажей Цикл
				Если СтрокаМонтажа.НомерСтроки = ПараметрыНовогоМонтажа.ИндексСтроки Тогда
					Результат = МодульОтчетов.ПроверитьСвободныйИнтервалМонтажей(ПараметрыНовогоМонтажа, ВариантГрафика, ФильтрТочкаПродаж);
					Если НЕ Результат Тогда
						ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонТекстаОшибки, Формат(ПараметрыНовогоМонтажа.ДатаМонтажа, "ДЛФ=D"), Формат(ПараметрыНовогоМонтажа.ВремяНачала, "ДЛФ=T"), Формат(ПараметрыНовогоМонтажа.ВремяОкончания, "ДЛФ=T"), ПараметрыНовогоМонтажа.Бригада);
						Возврат Новый Структура("Результат, ТекстОшибки", Ложь, ТекстОшибки);
					КонецЕсли;
					
				Иначе
					ПараметрыПроверкиМонтажа = Новый Структура("ИндексСтроки, ДатаМонтажа, ВремяНачала, ВремяОкончания, Бригада, ИДМонтажа",
																СтрокаМонтажа.НомерСтроки, 
																СтрокаМонтажа.ДатаМонтажа,
																СтрокаМонтажа.ВремяНачала, СтрокаМонтажа.ВремяОкончания,
																ПараметрыНовогоМонтажа.Бригада,
																СтрокаМонтажа.ИДМонтажа);
					Результат = МодульОтчетов.ПроверитьСвободныйИнтервалМонтажей(ПараметрыПроверкиМонтажа, ВариантГрафика, ФильтрТочкаПродаж);							
					
					Если НЕ Результат Тогда
						ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонТекстаОшибки, Формат(ПараметрыПроверкиМонтажа.ДатаМонтажа, "ДЛФ=D"), Формат(ПараметрыПроверкиМонтажа.ВремяНачала, "ДЛФ=T"), Формат(ПараметрыПроверкиМонтажа.ВремяОкончания, "ДЛФ=T"), ПараметрыПроверкиМонтажа.Бригада);
						Возврат Новый Структура("Результат, ТекстОшибки", Ложь, ТекстОшибки);
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
		
	Возврат Новый Структура("Результат, ТекстОшибки", Результат, ТекстОшибки);
		
КонецФункции

