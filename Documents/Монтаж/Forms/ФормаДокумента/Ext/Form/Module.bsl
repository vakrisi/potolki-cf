&НаКлиенте
Процедура ГрафикМонтажейПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Если НоваяСтрока Тогда
		Элемент.ТекущиеДанные.ИДМонтажа = Новый УникальныйИдентификатор;
		КолСтрок = Объект.ГрафикМонтажей.Количество();
		Если КолСтрок > 1 Тогда
        	Элемент.ТекущиеДанные.ДатаМонтажа = Объект.ГрафикМонтажей[КолСтрок-2].ДатаМонтажа + 86400;
		Иначе
			Элемент.ТекущиеДанные.ДатаМонтажа = ТекущаяДата();
		КонецЕсли;
		ГрафикМонтажейПриАктивизацииСтроки(Элемент);
	КонецЕсли;
	
	СтараяДатаМонтажа = Элемент.ТекущиеДанные.ДатаМонтажа;
	
КонецПроцедуры

&НаКлиенте
Процедура ГрафикМонтажейПередОкончаниемРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования, Отказ)
	
	ТекущиеДанные = Элементы.ГрафикМонтажей.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено И НЕ ОтменаРедактирования Тогда

		ПараметрыЭлемента = Новый Структура("МонтажСсылка, Бригада, ДатаМонтажа, ВремяНачала, ВремяОкончания, ИдМонтажа, ИндексСтроки",
										Объект.Ссылка, Объект.Бригада,
										ТекущиеДанные.ДатаМонтажа, ТекущиеДанные.ВремяНачала, ТекущиеДанные.ВремяОкончания, ТекущиеДанные.ИдМонтажа, ТекущиеДанные.НомерСтроки);
										
		Если ЗначениеЗаполнено(ТекущиеДанные.ДатаМонтажа) И ЗначениеЗаполнено(ТекущиеДанные.ВремяНачала) И ЗначениеЗаполнено(ТекущиеДанные.ВремяОкончания) Тогда
			СтруктураПроверкиИнтервала = ПроверитьСвободныйИнтервалМонтажей(ПараметрыЭлемента, Объект.ГрафикМонтажей, ФильтрТочкаПродаж);
			Если НЕ СтруктураПроверкиИнтервала.Результат Тогда
				ТекущиеДанные.ДатаМонтажа = СтараяДатаМонтажа;
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтруктураПроверкиИнтервала.ТекстОшибки, , , , Отказ);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура ГрафикМонтажейДатаМонтажаПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ГрафикМонтажей.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
