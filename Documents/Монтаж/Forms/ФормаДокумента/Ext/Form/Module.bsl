			СтруктураПроверкиИнтервала = ПроверитьСвободныйИнтервалМонтажей(ДопПараметры, Объект.ГрафикМонтажей, ФильтрТочкаПродаж);
			
			Если НЕ СтруктураПроверкиИнтервала.Результат Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтруктураПроверкиИнтервала.ТекстОшибки); //, , , , Отказ);
				
				Если НЕ БылНаНесколькоДней Тогда
					Объект.СрокМонтажа = НаКакойСрокБыл;
					УправлениеФормойНаСервере();	
				КонецЕсли;
				
				СформироватьГрафик();
				Возврат;
			КонецЕсли;
			
			МассивНаНесколькоДней.Добавить(ДопПараметры);
			
		КонецЦикла;
		//-- #14004
	КонецЕсли;
	
	//проверяем пересечения периодов
	Отказ = Ложь;
	//++17113 Не проверяем пересечение в текущем графике
	//Для Каждого СуществующаяЗапись Из ТаблицаМонтажей Цикл
	//	Если (НЕ СуществующаяЗапись.Бригада.Пустая() И НЕ ОбщийМодульВызовСервера.ЗначениеРеквизитаОбъекта(СуществующаяЗапись.Бригада, "НеПроверятьПересечениеМонтажейВГрафике"))
	//		ИЛИ СуществующаяЗапись.Бригада.Пустая() Тогда		
	//		Если СуществующаяЗапись.Бригада = Значения.Получить("Бригада") Тогда
	//			Если (СуществующаяЗапись.ВремяНачала > Начало ИЛИ СуществующаяЗапись.ВремяОкончания > Начало) 
	//				И (СуществующаяЗапись.ВремяНачала < Конец ИЛИ СуществующаяЗапись.ВремяОкончания < Конец) Тогда
	//				Отказ = Истина;							
	//			ИначеЕсли Начало = СуществующаяЗапись.ВремяНачала и Конец = СуществующаяЗапись.ВремяОкончания Тогда
	//				Отказ = Истина;						
	//			КонецЕсли;					
	//		КонецЕсли;
	//	КонецЕсли;
	//КонецЦикла;		
	//--17113
	
	Если НЕ Отказ Тогда //И ИспользуетсяПулМонтажей Тогда
		
		ПараметрыНовогоМонтажа = Новый Структура;
		ПараметрыНовогоМонтажа.Вставить("ТекущийМонтаж", 		Объект.Ссылка);
		ПараметрыНовогоМонтажа.Вставить("ДатаМонтажа", 		НачалоДня(Начало));
