//++ №11087
&НаКлиенте
Процедура ОбновитьФлагПривязаныйТоварНеВыбранВМатериалах()
	
	// Сначала получим все выбранные товары по комнатам
	СоответствиеКомнатТоваров = Новый Соответствие;
	Для Каждого ТекущаяКомната Из ДеревоТоваров.ПолучитьЭлементы() Цикл
		
		СоответствиеКомнатТоваров.Вставить(ТекущаяКомната.Комната, новый Массив);
		
		Для Каждого ТекущаяПозиция Из ТекущаяКомната.ПолучитьЭлементы() Цикл
			
			Если НЕ ТекущаяПозиция.ИспользоватьВТекущемМонтаже Тогда
				Продолжить;
			КонецЕсли;
			
			СоответствиеКомнатТоваров[ТекущаяКомната.Комната].Добавить(ТекущаяПозиция.Номенклатура);
			
		КонецЦикла;
		
	КонецЦикла;
	
	//	Если строка привязана к товарам, но этот товар\услуга в ТЧ товары не выбрана, то строку материалов подсвечивать красным
	Для Каждого ТекущаяКомната Из ДеревоМатериалов.ПолучитьЭлементы() Цикл
		Для Каждого ТекущаяПозиция Из ТекущаяКомната.ПолучитьЭлементы() Цикл
			
			ТекущаяПозиция.ПривязанныйТоварНеВыбран = Ложь;
			ТоварыКомнаты = СоответствиеКомнатТоваров.Получить(ТекущаяПозиция.Комната);
			
			Если ТоварыКомнаты = Неопределено Тогда
				ТоварыКомнаты = новый Массив;
			КонецЕсли;
			
			Если (ТекущаяПозиция.ИспользоватьВТекущемМонтаже Или ЗаполнениеМатериаловПоМонтажам)
				И ЗначениеЗаполнено(ТекущаяПозиция.НоменклатураТоваров)
				И ТоварыКомнаты.Найти(ТекущаяПозиция.НоменклатураТоваров) = Неопределено
			Тогда
			
				ТекущаяПозиция.ПривязанныйТоварНеВыбран = Истина;
			
			КонецЕсли;
			
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоМатериаловНоменклатураТоваровПриИзменении(Элемент)
	
	ОбновитьФлагПривязаныйТоварНеВыбранВМатериалах();
	
