Процедура УправлениеФормойПоВидуМонтажа()
	
	ЭтоМонтаж  = (Объект.ВидОперации = ПредопределенноеЗначение("Справочник.ВидыМонтажа.Монтаж"));
	ЭтоПродажа = (Объект.ВидОперации = ПредопределенноеЗначение("Справочник.ВидыМонтажа.Продажа"));
	
	Элементы.ГруппаСодержание.Видимость = НЕ ЭтоМонтаж;
	
	//++ №12721
	
	ОтображатьТоварыИМатериалыВВидеДерева = ОтображатьТоварыИМатериалыВВидеДерева();
	
	Элементы.ГруппаРезультат.Видимость = НЕ ЭтоПродажа; // #16346
	Элементы.ГруппаДоговор.Видимость = ЭтоМонтаж ИЛИ ЭтоПродажа; 
	Элементы.ГруппаЗаказДоговор.Видимость = НЕ ЭтоМонтаж И НЕ ЭтоПродажа;
	
	Элементы.Адрес.АвтоОтметкаНезаполненного = (НЕ ЭтоПродажа);
	Элементы.Адрес.ОтметкаНезаполненного = (НЕ ЭтоПродажа);
	
	//++16681
	//Элементы.КомментарийКМонтажу.Заголовок = ?(ЭтоПродажа, "Комментарий к продаже", "Комментарий к монтажу");
	//---16681
	
	Элементы.ГруппаСуммаКПолучениюНаМонтаже.Видимость = (НЕ ЭтоПродажа);
	
	Элементы.ГруппаБригада.Видимость = (НЕ ЭтоПродажа);
	Элементы.ГруппаСтраницаГрафик.Видимость = (НЕ ЭтоПродажа);
	Элементы.ГруппаИсполнители.Видимость = (НЕ ЭтоПродажа);
	
	Элементы.ГруппаМатериалы.Видимость = (НЕ ОтображатьТоварыИМатериалыВВидеДерева И НЕ ЭтоПродажа);
	Элементы.ГруппаМатериалыДерево.Видимость = (ОтображатьТоварыИМатериалыВВидеДерева И НЕ ЭтоПродажа);
