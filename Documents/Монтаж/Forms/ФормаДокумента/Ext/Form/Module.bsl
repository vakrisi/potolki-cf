	КонецЕсли;
	
	// #16697 изменил даты - выбери новое время
	ТекущиеДанные.ВремяНачала = Дата(1,1,1,0,0,0);
	ТекущиеДанные.ВремяОкончания = Дата(1,1,1,0,0,0);
	
