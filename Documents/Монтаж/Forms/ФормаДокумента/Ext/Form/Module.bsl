&НаКлиенте
Процедура СрокМонтажаПриИзменении(Элемент)
	Если Объект.СрокМонтажа = ПредопределенноеЗначение("Перечисление.СрокиМонтажа.ДатаМонтажаНеОпределена") Тогда
		Объект.ДатаМонтажа 	  = Дата(1,1,1);
		Объект.ВремяНачала 	  = Дата(1,1,1,0,0,0);
		Объект.ВремяОкончания = Дата(1,1,1,0,0,0);		
		Объект.Бригада 		  = ПредопределенноеЗначение("Справочник.Бригады.ПустаяСсылка");
		Объект.Бригадир 	  = ПредопределенноеЗначение("Справочник.Сотрудники.ПустаяСсылка");
		БригадаПриИзмененииКлиент();
	ИначеЕсли Объект.СрокМонтажа = ПредопределенноеЗначение("Перечисление.СрокиМонтажа.МонтажНаОдинДень") Тогда
		Если Объект.ГрафикМонтажей.Количество() > 0 Тогда
			Объект.ДатаМонтажа 	  = Объект.ГрафикМонтажей[0].ДатаМонтажа;
			Объект.ВремяНачала 	  = Объект.ГрафикМонтажей[0].ВремяНачала;
			Объект.ВремяОкончания = Объект.ГрафикМонтажей[0].ВремяОкончания;
			Объект.ИДМонтажа 	  = Объект.ГрафикМонтажей[0].ИДМонтажа;
			Объект.ГрафикМонтажей.Очистить();	
		КонецЕсли;
	ИначеЕсли Объект.СрокМонтажа = ПредопределенноеЗначение("Перечисление.СрокиМонтажа.МонтажНаНесколькоДней") Тогда	
		Если ЗначениеЗаполнено(Объект.ДатаМонтажа) Тогда
			НоваяСтрока = Объект.ГрафикМонтажей.Добавить();
			НоваяСтрока.ДатаМонтажа 	= Объект.ДатаМонтажа;
			НоваяСтрока.ВремяНачала 	= Объект.ВремяНачала;
			НоваяСтрока.ВремяОкончания 	= Объект.ВремяОкончания;
			НоваяСтрока.ИДМонтажа 		= Объект.ИДМонтажа;
		КонецЕсли;
	КонецЕсли;	
	
	ОбновитьФорму();
	УправлениеФормойНаСервере();
	СформироватьГрафик();
	
КонецПроцедуры
