	КонецЕсли;
	
	РеквизитыСотрудника = ПолучитьРеквизитыСотрудника(ТекущиеДанные.Сотрудник, "ТарифМонтажа, КоличествоВыполняемыхНормоЧасовМонтажаЗаЧасВремени");
	ТекущиеДанные.ТарифИсполнителя = РеквизитыСотрудника.ТарифМонтажа;
	//#15230
	Если ОтображатьТрудоемкость Тогда
		ТекущиеДанные.КоличествоВыполняемыхНормоЧасовМонтажаЗаЧасВремени = РеквизитыСотрудника.КоличествоВыполняемыхНормоЧасовМонтажаЗаЧасВремени;
	КонецЕсли;
	
	РассчитатьИтоговыеПоказателиКлиент(); //#15230
	
КонецПроцедуры

