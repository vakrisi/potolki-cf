			ВремяОкончания = ?(Сч = КоличествоДней, Дата('00010101') + (Конец  - НачалоДня(Конец)), НастройкиГрафика.ВремяКонцаМонтажей);
			ДатаМонтажа = НачалоДня(Начало) + (Сч * 86400);
			
			ДопПараметры = Новый Структура;
