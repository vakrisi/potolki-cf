#Область ДляРисованияГрафика

&НаСервере
Процедура СформироватьГрафикМонтажейКалендарь(ДанныеТекущегоМонтажа, ЭтоИзменениеДатОтображенияГрафика) 	
	
	//Вариант отображения (горизонтальный / вертикальный)
	Развертка = 0;
	Если Вариант = 1 ИЛИ Вариант = 3 ИЛИ Вариант = 5 Тогда
		Развертка = 0;
	ИначеЕсли Вариант = 2 ИЛИ Вариант = 4 ИЛИ Вариант = 6 Тогда
		Развертка = 1;	
	ИначеЕсли Вариант = 7 ИЛИ Вариант = 8 ИЛИ Вариант = 9 Тогда
		Развертка = 2;
	КонецЕсли;
	
	ЭтоГрафик 		 = (Вариант = 1 ИЛИ Вариант = 2 ИЛИ Вариант = 7);
	ЭтоПул 			 = (Вариант = 5 ИЛИ Вариант = 6 ИЛИ Вариант = 8);
	ЭтоРаспределение = (Вариант = 3 ИЛИ Вариант = 4 ИЛИ Вариант = 9);
	
	// периоды отображения и время (часы) для отображения
	ВремяНачала = НастройкиГрафика.ВремяНачалаМонтажей;
	ВремяКонца  = НастройкиГрафика.ВремяКонцаМонтажей;
	ДлинаМонтажаПоУмолчанию = Константы.КоличествоЧасовНеобходимыхНаМонтаж.Получить()*60*60;
	
	//++ №10185 график теперь строится по отдельным датам для просмотра графика
	//ОтображаемаяДатаМонтажа = ?(ЗначениеЗаполнено(ДанныеТекущегоМонтажа.ДатаМонтажа), ДанныеТекущегоМонтажа.ДатаМонтажа, ТекущаяДатаСеанса());
	//-- №10185
	
	// #12952 если монтаж на несколько дней автоматически пролистывать на эту дату
	РазницаГрафика = ДатаОкончания - ДатаНачала;
	Если ЗначениеЗаполнено(ДанныеТекущегоМонтажа.ДатаМонтажа)
		// #16697 меняем если только данные текущего монтажа не по падают в отображаемый период
		И (НЕ ДанныеТекущегоМонтажа.ДатаМонтажа >= ДатаНачала ИЛИ НЕ ДанныеТекущегоМонтажа.ДатаМонтажа <= ДатаОкончания)
		// #16697 если изменяем интервал отображения, то график перестраиваем в любом случае
		И НЕ ЭтоИзменениеДатОтображенияГрафика
		Тогда
		ДатаНачала = ДанныеТекущегоМонтажа.ДатаМонтажа;
		ДатаОкончания = ДатаНачала + РазницаГрафика;
	КонецЕсли;
	
	НачальнаяДатаПланировщика = ОбщийМодульКлиентСервер.СоединитьДатуИВремя(ДатаНачала, ВремяНачала); // №10185 график по дате просмотра, было: ОтображаемаяДатаМонтажа, ВремяНачала);
	КонечнаяДатаПланировщика  = ОбщийМодульКлиентСервер.СоединитьДатуИВремя(ДатаОкончания, ВремяКонца); // №10185 график по дате просмотра, было: ОтображаемаяДатаМонтажа, ВремяКонца);
	
	Если ЭтоГрафик Тогда
		
		//++ №10185
		//НастройкиГрафикаКалендарь = МодульОтчетов.ИнициализироватьНастройкиПланировщикаГрафикаМонтажей(РезультатПланировщик, Развертка, НачальнаяДатаПланировщика, КонечнаяДатаПланировщика, Ложь);
		НастройкиГрафикаКалендарь = МодульОтчетов.ИнициализироватьНастройкиПланировщикаГрафикаМонтажей(РезультатПланировщик, Развертка, НачалоДня(НачальнаяДатаПланировщика), КонецДня(КонечнаяДатаПланировщика));
		//-- №10185
		
		МодульОтчетов.ЗаполнитьГрафикМонтажейКалендарьПоМонтажникам(РезультатПланировщик, НастройкиГрафикаКалендарь, ФильтрТочкаПродаж,, ТаблицаМонтажей,, Объект.Ссылка);
		
	ИначеЕсли ЭтоПул ИЛИ ЭтоРаспределение Тогда
	
		//++ №10185
		//НастройкиГрафикаКалендарь = МодульОтчетов.ИнициализироватьНастройкиПланировщикаГрафикаМонтажей(РезультатПланировщик, Развертка, НачальнаяДатаПланировщика, КонечнаяДатаПланировщика, Ложь);
		НастройкиГрафикаКалендарь = МодульОтчетов.ИнициализироватьНастройкиПланировщикаГрафикаМонтажей(РезультатПланировщик, Развертка, НачалоДня(НачальнаяДатаПланировщика), КонецДня(КонечнаяДатаПланировщика));
		Если ЭтоПул Тогда
			НастройкиГрафикаКалендарь.Вставить("НеВыводитьРеальныеБригады", Истина);
		КонецЕсли;
		//-- №10185
		
		КоличествоБригадНаДату = МодульОтчетов.ЗаполнитьГрафикМонтажейКалендарьПоПлану(РезультатПланировщик, НастройкиГрафикаКалендарь, ФильтрТочкаПродаж, ТаблицаМонтажей);
		
		Элементы.ДекорацияПустойПланБригад.Видимость = (КоличествоБригадНаДату = 0);
		Элементы.ГруппаРезультатПланировщик.Видимость = (НЕ КоличествоБригадНаДату = 0);
		
	КонецЕсли;
	
	//++ №10185 если монтаж на нескольк дней и бригада документа заполнена, то все остальные бригады закрашиваем серым
	ЦветФонаСерый = (Объект.СрокМонтажа = Перечисления.СрокиМонтажа.МонтажНаНесколькоДней И ЗначениеЗаполнено(Объект.Бригада) И Объект.ГрафикМонтажей.Количество() > 1);
		
	Для Каждого ТекущееИзмерение Из РезультатПланировщик.Измерения[0].Элементы Цикл
			
		Если ЦветФонаСерый И НЕ ТекущееИзмерение.Значение = Объект.Бригада Тогда
			ТекущееИзмерение.ЦветФона = WebЦвета.Серый;
		Иначе
			ТекущееИзмерение.ЦветФона = WebЦвета.Белый;
		КонецЕсли;
			
	КонецЦикла;
	//-- №10185
	
КонецПроцедуры

