&НаСервере
Функция ПолучитьСтрокуДересаПоУИСтроки(Дерево, УИСтроки, Номенклатура,  ХарактеристикаНоменклатуры, Комната
	, ЕдиницаИзмерения, Коэффициент // №10821
)
	
	// пробежимся по всем строкам (по всем строкам одного уровня, которые были переданы!)
	Для каждого Строка из Дерево.Строки Цикл
 
		// Вот наше условие, значение Выгружать у строки равно 1:
		Если Строка.УИСтроки = УИСтроки 
			И Строка.Номенклатура = Номенклатура 
			И Строка.ХарактеристикаНоменклатуры = ХарактеристикаНоменклатуры
			И Строка.Комната = Комната
			//++ №10821
			И Строка.ЕдиницаИзмерения = ЕдиницаИзмерения
			И Строка.Коэффициент = Коэффициент
			//-- №10821
			Тогда
			// Если условие сработало, возвращаем строку
			Возврат Строка;
		КонецЕсли;
	КонецЦикла;
 
	// Если не нашли строку, смотрим под-строки каждой строки
	Для каждого Строка из Дерево.Строки Цикл
 
		// Здесь осуществляется рекурсивный вызов
		НайденнаяСтрока = ПолучитьСтрокуДересаПоУИСтроки(Строка, УИСтроки, Номенклатура, ХарактеристикаНоменклатуры, Комната
			, ЕдиницаИзмерения, Коэффициент // №1082
		);
		Если НайденнаяСтрока <> неопределено Тогда
			// Если нашли, возвращается строка
			Возврат НайденнаяСтрока;
		КонецЕсли;
 
	КонецЦикла;
 
	// Не нашли строку по условию, возвращаем неопределено
	Возврат неопределено;
	
КонецФункции

&НаСервере
Процедура ПеренестиДеревоВТабличнуюЧасть()
	
	Если НЕ ОтображатьТоварыИМатериалыВВидеДерева() Тогда
		Возврат;
	КонецЕсли;
	
	//ТОВАРЫ И УСЛУГИ
	СуммаДокумента = 0;
	Объект.ТоварыУслуги.Очистить();
	Дерево = ДанныеФормыВЗначение(ДеревоТоваров, Тип("ДеревоЗначений"));
	Для Каждого Строка из Дерево.Строки Цикл
		Для Каждого СтрНоменклатура из Строка.Строки Цикл
			Если НЕ СтрНоменклатура.Номенклатура.Пустая() И СтрНоменклатура.ИспользоватьВТекущемМонтаже Тогда
				Стр = Объект.ТоварыУслуги.Добавить();
				ЗаполнитьЗначенияСвойств(Стр, СтрНоменклатура);
				СуммаДокумента = СуммаДокумента + СтрНоменклатура.Сумма;
			КонецЕсли;
			
		КонецЦикла;	
	КонецЦикла;
	Объект.СуммаДокумента = СуммаДокумента;
	
	//МАТЕРИАЛЫ
	Объект.Материалы.Очистить();
	Дерево = ДанныеФормыВЗначение(ДеревоМатериалов, Тип("ДеревоЗначений"));
	Для Каждого Строка из Дерево.Строки Цикл
		Для Каждого СтрНоменклатура из Строка.Строки Цикл
			Если НЕ СтрНоменклатура.Номенклатура.Пустая() 
				И (СтрНоменклатура.ИспользоватьВТекущемМонтаже ИЛИ ЗаполнениеМатериаловПоМонтажам) Тогда
				Стр = Объект.Материалы.Добавить();
				ЗаполнитьЗначенияСвойств(Стр, СтрНоменклатура);
			КонецЕсли;
		КонецЦикла;	
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ЭтоУслуга(Номенклатура)
	
	Если Номенклатура = Неопределено Или Номенклатура.Пустая() Тогда
		Возврат Ложь;
	ИначеЕсли Номенклатура.ВидНоменклатуры = Справочники.ВидыНоменклатуры.Услуга Тогда
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Процедура ОбновитьСтрокуТовараПоДаннымЗаказа(СтрокаТабличнойЧасти)
	
	СтрокаТабличнойЧасти.Количество = СтрокаТабличнойЧасти.КоличествоВЗаказДоговоре - СтрокаТабличнойЧасти.КоличествоВДругихМонтажах; //#12608 // №12860 раскомментировано
	//Добавлено
	СтрокаТабличнойЧасти.Цена = СтрокаТабличнойЧасти.ЦенаВЗаказДоговоре;
	СтрокаТабличнойЧасти.Сумма = СтрокаТабличнойЧасти.СуммаВЗаказДоговоре;
	СтрокаТабличнойЧасти.СуммаСкидки = СтрокаТабличнойЧасти.СуммаСкидкиВЗаказДоговоре;
	СтрокаТабличнойЧасти.ПроцентСкидки = СтрокаТабличнойЧасти.ПроцентСкидкиВЗаказДоговоре;
	
	//++ №10821
	СтрокаТабличнойЧасти.ЕдиницаИзмерения = СтрокаТабличнойЧасти.ЕдиницаИзмеренияВЗаказДоговоре;
	СтрокаТабличнойЧасти.Коэффициент = СтрокаТабличнойЧасти.КоэффициентВЗаказДоговоре;
	//-- №10821
	
	СтрокаТабличнойЧасти.СтавкаНДС = СтрокаТабличнойЧасти.СтавкаНДСВЗаказДоговоре;
	СтрокаТабличнойЧасти.СуммаНДС = СтрокаТабличнойЧасти.СуммаНДСВЗаказДоговоре;
	
	//Закомментировано: заполнение поля к списанию должно происходить только по кнопке в ТЧ, заявка #4227
	//Раскомментировано: заявка #4679
	Если ЭтоУслуга(СтрокаТабличнойЧасти.Номенклатура) Тогда
		СтрокаТабличнойЧасти.КоличествоКСписанию = 0;
	ИначеЕсли ЭтоНоменклатураПотолкаИлиОтреза(СтрокаТабличнойЧасти.Номенклатура) Тогда
		СтрокаТабличнойЧасти.КоличествоКСписанию = ПолучитьКоличествоКСписаниюПотолка(СтрокаТабличнойЧасти.Номенклатура);
	Иначе
		СтрокаТабличнойЧасти.КоличествоКСписанию = СтрокаТабличнойЧасти.Количество;
	КонецЕсли;
	
	СтрокаТабличнойЧасти.КоличествоВМонтажах = СтрокаТабличнойЧасти.Количество + СтрокаТабличнойЧасти.КоличествоВДругихМонтажах; //#12608 // №12860 раскомментировано
	//СтрокаТабличнойЧасти.СуммаНДС = УчетНДС.РассчитатьСуммуНДС(СтрокаТабличнойЧасти.Сумма, УчитыватьНДС, , УчетНДС.ПолучитьСтавкуНДС(СтрокаТабличнойЧасти.СтавкаНДС));	
	
	//#15230
	Если ОтображатьТрудоемкость Тогда
		РеквизитыНоменклатуры = ПолучитьРеквизитыНоменклатуры(СтрокаТабличнойЧасти.Номенклатура, "ТрудоемкостьЕдиницыРаботВНормоЧасах");
		СтрокаТабличнойЧасти.Трудоемкость = РеквизитыНоменклатуры.ТрудоемкостьЕдиницыРаботВНормоЧасах * СтрокаТабличнойЧасти.Количество;	
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция УстановитьПризнакИспользоватьВТекущемМонтажеДляВсехПодчиненныхСтрокВеткиДереваТоваров(Комната=Неопределено, Установить)
	
	МассивСпецификацийКУдалению = Новый Массив;
	МассивСпецификацийКДобавлению = Новый Массив;
	
	Дерево = ДанныеФормыВЗначение(ДеревоТоваров, Тип("ДеревоЗначений"));
	Для Каждого ТекущаяКомната Из Дерево.Строки Цикл
		
		Если ТекущаяКомната.Комната = Комната ИЛИ Комната=Неопределено Тогда
			ТекущаяКомната.ИспользоватьВТекущемМонтаже = Установить; //#8758;
			
			Для Каждого ТекущаяНоменклатура Из ТекущаяКомната.Строки Цикл
				
				//#12608 // №12860 раскомментировано
				Если Установить И ТекущаяНоменклатура.КоличествоВДругихМонтажах > 0 Тогда
					ТекущаяКомната.ИспользоватьВТекущемМонтаже = Ложь; // общую галку по комнате снимаем
					Продолжить;
				КонецЕсли;	
					
				ТекущаяНоменклатура.ИспользоватьВТекущемМонтаже = Установить;
				Если ТекущаяНоменклатура.ИспользоватьВТекущемМонтаже Тогда
					ТекущаяНоменклатура.Количество = ТекущаяНоменклатура.КоличествоВЗаказДоговоре - ТекущаяНоменклатура.КоличествоВДругихМонтажах; //#12608 // №12860 раскомментировано
					ТекущаяНоменклатура.КоличествоВМонтажах = ТекущаяНоменклатура.Количество + ТекущаяНоменклатура.КоличествоВДругихМонтажах;      //#12608 // №12860 раскомментировано
					//Закомментировано: заполнение поля к списанию должно происходить только по кнопке в ТЧ, заявка #4227
					//Раскомментировано: заявка #4679
					Если ЭтоУслуга(ТекущаяНоменклатура.Номенклатура) Тогда
						ТекущаяНоменклатура.КоличествоКСписанию = 0;
					ИначеЕсли ЭтоНоменклатураПотолкаИлиОтреза(ТекущаяНоменклатура.Номенклатура) Тогда
						ТекущаяНоменклатура.КоличествоКСписанию = ПолучитьКоличествоКСписаниюПотолка(ТекущаяНоменклатура.Номенклатура);
					Иначе
						ТекущаяНоменклатура.КоличествоКСписанию = ТекущаяНоменклатура.Количество;
					КонецЕсли;
					
					// №6452 необходимо установить спецификацию
					Если ЗаполнениеМатериаловПоМонтажам 
						//И Справочники.ВидыНоменклатуры.ЭтоНоменклатураУслуга(ТекущаяНоменклатура.Номенклатура)  // #12667 спецификация только для услуг, в рамках той же заявки отменено
						Тогда
						ТекущаяНоменклатура.Спецификация = ОбщийМодульВызовСервера.ПолучитьОсновнуюСпецификациюНоменклатуры(ТекущаяНоменклатура.Номенклатура, ВидСпецификацииПоУмолчанию);
					КонецЕсли;	
					
					Если ЗаполнениеМатериаловПоМонтажам 
						И НЕ ТекущаяНоменклатура.Спецификация.Пустая()
						Тогда
						Позиция = Новый Структура("Комната,Номенклатура,УИСтроки,Количество,Коэффициент,ЕдиницаИзмерения,Спецификация");
						ЗаполнитьЗначенияСвойств(Позиция, ТекущаяНоменклатура);
						МассивСпецификацийКДобавлению.Добавить(Позиция);
					КонецЕсли;
					
					//#15230
					Если ОтображатьТрудоемкость Тогда
						ТекущаяНоменклатура.Трудоемкость = ТекущаяНоменклатура.Номенклатура.ТрудоемкостьЕдиницыРаботВНормоЧасах * ТекущаяНоменклатура.Количество;	
					КонецЕсли;
				Иначе
					ТекущаяНоменклатура.Количество = 0;
					ТекущаяНоменклатура.КоличествоКСписанию = ТекущаяНоменклатура.Количество;
					
					Если ЗаполнениеМатериаловПоМонтажам 
						И НЕ ТекущаяНоменклатура.Спецификация.Пустая() 
						//И ЕстьМатериалыПоТекущейПозиции(ТекущаяНоменклатура.Номенклатура, ТекущаяНоменклатура.УИСтроки)
						Тогда
						Позиция = Новый Структура("Комната,Номенклатура,УИСтроки,Количество,Коэффициент,ЕдиницаИзмерения,Спецификация");
						ЗаполнитьЗначенияСвойств(Позиция, ТекущаяНоменклатура);
						МассивСпецификацийКУдалению.Добавить(Позиция);
					//	ЗадатьВопросОбУдаленииМатериаловПоСпецификации(ТекущаяНоменклатура.Номенклатура, ТекущаяНоменклатура.УИСтроки);
					КонецЕсли;
				
					//#15230
					Если ОтображатьТрудоемкость Тогда
						ТекущаяНоменклатура.Трудоемкость = 0;	
					КонецЕсли;

				КонецЕсли;
				
				//Добавлено
				ТекущаяНоменклатура.Цена = ТекущаяНоменклатура.ЦенаВЗаказДоговоре;
				ТекущаяНоменклатура.Сумма = ТекущаяНоменклатура.СуммаВЗаказДоговоре;
				ТекущаяНоменклатура.СуммаСкидки = ТекущаяНоменклатура.СуммаСкидкиВЗаказДоговоре;
				ТекущаяНоменклатура.ПроцентСкидки = ТекущаяНоменклатура.ПроцентСкидкиВЗаказДоговоре;
				ТекущаяНоменклатура.СуммаНДС = УчетНДС.РассчитатьСуммуНДС(ТекущаяНоменклатура.Сумма,
								УчитыватьНДС, ,
								УчетНДС.ПолучитьСтавкуНДС(ТекущаяНоменклатура.СтавкаНДС));
				
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	ЗначениеВДанныеФормы(Дерево, ДеревоТоваров);

	Возврат Новый Структура("МассивСпецификацийКУдалению, МассивСпецификацийКДобавлению", МассивСпецификацийКУдалению, МассивСпецификацийКДобавлению);
	
КонецФункции

