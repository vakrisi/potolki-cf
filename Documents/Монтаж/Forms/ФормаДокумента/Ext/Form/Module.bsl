&НаСервере
Функция ПолучитьСписокПотолков()
	
	СписокНоменклатуры = Новый СписокЗначений;
	Для Каждого СтрокаНоменклатура Из Объект.ТоварыУслуги Цикл
		Если Справочники.ВидыНоменклатуры.ЭтоНоменклатураПотолкаИлиОтреза(СтрокаНоменклатура.Номенклатура) Тогда
			СписокНоменклатуры.Добавить(СтрокаНоменклатура.Номенклатура);
		КонецЕсли;
	КонецЦикла;		
	Для Каждого СтрокаНоменклатура Из Объект.Материалы Цикл
		Если Справочники.ВидыНоменклатуры.ЭтоНоменклатураПотолкаИлиОтреза(СтрокаНоменклатура.Номенклатура) Тогда
			СписокНоменклатуры.Добавить(СтрокаНоменклатура.Номенклатура);
		КонецЕсли;
	КонецЦикла;
		
	Возврат СписокНоменклатуры;
	
КонецФункции

&НаКлиенте
Процедура ПечататьФайл(Команда)
	
	ВыбранныеЭлементы = Элементы.ФайлыДерево.ВыделенныеСтроки;	
	
	Если ВыбранныеЭлементы.Количество() > 0 Тогда
		Для каждого ЭлементДляПечати из ВыбранныеЭлементы Цикл
			СтрФайл = ФайлыДерево.НайтиПоИдентификатору(ЭлементДляПечати);
			
			// если выделен корень дерева, то пропускаем
			Если СтрФайл.ПолучитьРодителя() = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			АдресФайла = ОбщийМодульВызовСервера.ПолучитьДанныеФайла(СтрФайл.Документ, СтрФайл.ИмяФайла, СтрФайл.Номенклатура, ЭтотОбъект.УникальныйИдентификатор);
			
			Если НЕ АдресФайла = Неопределено Тогда // №7253
				ВременноеИмя = ПолучитьИмяВременногоФайла(СтрФайл.Расширение);
				ПолучитьФайл(АдресФайла, ВременноеИмя, Ложь);
				
				Shell = Новый COMОбъект("Shell.Application");
				Shell.ShellExecute(ВременноеИмя, "", "", "print", 0);
			КонецЕсли;
		КонецЦикла;
	Иначе
		ПоказатьПредупреждение(,"Выберите файл(ы) в списке");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаОбновитьСписокФайлов(Команда)
	
	//Запомним текущую строку
	ТекущиеДанные = Элементы.ФайлыДерево.ТекущиеДанные;
	
	ОбновитьСписокФайлов();
	
	ИдТекущейСтроки = Неопределено;
	КоллекцияЭлементовДерева = ЭтаФорма.ФайлыДерево.ПолучитьЭлементы();
	Для Каждого Строка Из КоллекцияЭлементовДерева Цикл    
		ИдентификаторСтроки = Строка.ПолучитьИдентификатор();
		Для Каждого ПодчиненнаяСтрока Из Строка.ПолучитьЭлементы() Цикл
			Если ТекущиеДанные <> Неопределено И ПодчиненнаяСтрока.Документ = ТекущиеДанные.Документ И ПодчиненнаяСтрока.Номенклатура = ТекущиеДанные.Номенклатура И ПодчиненнаяСтрока.ИмяФайла = ТекущиеДанные.ИмяФайла Тогда
				ИдТекущейСтроки = ПодчиненнаяСтрока.ПолучитьИдентификатор();
			КонецЕсли;
		КонецЦикла;
		Если ИдТекущейСтроки = Неопределено Тогда
			ИдТекущейСтроки = ИдентификаторСтроки;			
		КонецЕсли;
		Элементы.ФайлыДерево.Развернуть(ИдентификаторСтроки, Истина);
	КонецЦикла;
	Элементы.ФайлыДерево.ТекущаяСтрока = ИдТекущейСтроки;
	
КонецПроцедуры

