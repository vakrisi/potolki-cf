&НаКлиенте
Процедура ОтметитьСнятьВсеТовары(Команда)
	
	Установить = ?(Команда.Имя = "ОтметитьВсеТовары", Истина, Ложь);
	
	Результат = УстановитьПризнакИспользоватьВТекущемМонтажеДляВсехПодчиненныхСтрокВеткиДереваТоваров(, Установить);
	Если Результат.МассивСпецификацийКУдалению.Количество() > 0 Тогда
		ЗадатьВопросОбУдаленииМатериаловПоСпецификациям(Результат.МассивСпецификацийКУдалению);		
	КонецЕсли;
	Если Результат.МассивСпецификацийКДобавлению.Количество() > 0 Тогда
		ПерезаполнитьМатериалыПоСпецификации(, Результат.МассивСпецификацийКДобавлению, "ИзменениеСпецификации");		
	КонецЕсли;

	РазвернутьДеревоТоваров();
	ОбновитьДанныеДокумента();
	
	ЗаполнитьИндексПодсветкиМатериалов();
	
	ОбновитьФлагПривязаныйТоварНеВыбранВМатериалах(); // №11087
	
КонецПроцедуры


&НаКлиенте
Процедура СформироватьОтчетСравненияЗаказДоговораСМонтажом(Команда)
	ПараметрыОтчета  = Новый Структура;
	ПараметрыОтчета.Вставить("ЗаказДоговор", Объект.Основание);
	ПараметрыОтчета.Вставить("Монтаж", Объект.Ссылка);
	ПараметрыОтчета.Вставить("Комнаты", ПолучитьСписокКомнтат());
	ОткрытьФорму("Отчет.СравнениеЗаказДоговораСМонтажами.ФормаОбъекта", ПараметрыОтчета);
КонецПроцедуры

