&НаСервере
Процедура ПроверитьИОбновитьШапкуДокументаПоОснованию()
	
	Если НЕ Объект.Организация = Объект.Основание.Организация Тогда
		Объект.Организация = Объект.Основание.Организация;
		Модифицированность = Истина;
	КонецЕсли;
	Если НЕ Объект.ВидЦен = Объект.Основание.ВидЦен Тогда
		Объект.ВидЦен = Объект.Основание.ВидЦен;
		Модифицированность = Истина;
	КонецЕсли;
	Если НЕ Объект.ВидСкидки = Объект.Основание.ВидСкидки Тогда
		Объект.ВидСкидки = Объект.Основание.ВидСкидки;
		Модифицированность = Истина;
	КонецЕсли;
	Если НЕ Объект.Контрагент = Объект.Основание.Контрагент Тогда
		Объект.Контрагент = Объект.Основание.Контрагент;
		Модифицированность = Истина;
	КонецЕсли;
	Если НЕ Объект.ДоговорКонтрагента = Объект.Основание.ДоговорКонтрагента Тогда
		Объект.ДоговорКонтрагента = Объект.Основание.ДоговорКонтрагента;
		Модифицированность = Истина;
	КонецЕсли;
	Если НЕ Объект.Валюта = Объект.Основание.Валюта Тогда
		Объект.Валюта = Объект.Основание.Валюта;
		Модифицированность = Истина;
	КонецЕсли;
	
КонецПроцедуры

