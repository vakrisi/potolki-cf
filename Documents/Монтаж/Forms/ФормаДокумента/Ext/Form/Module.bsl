&НаСервере
Процедура ОбновитьСписокФайлов()
	
	ФайлыДерево.ПолучитьЭлементы().Очистить();
	
	СписокСсылок = Новый СписокЗначений;
	ВремДеревоТоваров = РеквизитФормыВЗначение("ДеревоТоваров");
	Для Каждого СтрокаКомнат Из ВремДеревоТоваров.Строки Цикл
		Для Каждого СтрокаНоменклатура Из СтрокаКомнат.Строки Цикл
			СписокСсылок.Добавить(СтрокаНоменклатура.Номенклатура);
		КонецЦикла;
	КонецЦикла;
	ВремДеревоМатериалов = РеквизитФормыВЗначение("ДеревоМатериалов");
	Для Каждого СтрокаКомнат Из ВремДеревоМатериалов.Строки Цикл
		Для Каждого СтрокаНоменклатура Из СтрокаКомнат.Строки Цикл
			СписокСсылок.Добавить(СтрокаНоменклатура.Номенклатура);
		КонецЦикла;
	КонецЦикла;
	
	ДополнитьСписокСсылокНаФайлы(СписокСсылок, Истина);
	
	ОбщийМодульСервер.ОбновитьСписокФайлов(ЭтотОбъект, СписокСсылок);	
	
КонецПроцедуры

&НаСервере
Процедура ДополнитьСписокСсылокНаФайлы(СписокСсылок, СписокДляПросмотра = Ложь)
	// если СписокДляПросмотра, то получаем список ссылок для формирования списка файлов
	// иначе                       получаем список ссылок для добавления файлов (добавление только к текущему документу)
	
	//Текущий документ
	СписокСсылок.Добавить(Объект.Ссылка, "Текущий документ");
	
	Если СписокДляПросмотра Тогда
		//Добавление Заказ-договора и Лида
		Если ТипЗнч(Объект.Основание) = Тип("ДокументСсылка.ЗаказДоговор") И НЕ Объект.Основание.Пустая() Тогда
			
			//Добавим ЗД
			СписокСсылок.Добавить(Объект.Основание);
			
			//Добавляем Монтажи
			Запрос = новый Запрос;
			Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	Монтажи.Ссылка
			|ИЗ
			|	Документ.Монтаж КАК Монтажи
			|ГДЕ
			|   Монтажи.Основание = &ДокументОснование
			|   И НЕ Монтажи.Ссылка = &ТекущийМонтаж";
			Запрос.УстановитьПараметр("ДокументОснование", Объект.Основание);
			Запрос.УстановитьПараметр("ТекущийМонтаж", Объект.Ссылка);
			Выборка = Запрос.Выполнить().Выбрать();
			
			Пока Выборка.Следующий() Цикл
				СписокСсылок.Добавить(Выборка.Ссылка);
			КонецЦикла;
			
			//Добавляем Лид
			Если ТипЗнч(Объект.Основание.Основание) = Тип("ДокументСсылка.Лид") И НЕ Объект.Основание.Основание.Пустая() Тогда
				СписокСсылок.Добавить(Объект.Основание.Основание);
			КонецЕсли;	
			
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ФайлыДеревоВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ТекущиеДанные = Элементы.ФайлыДерево.ТекущиеДанные;
	Если ТекущиеДанные.ПолучитьРодителя() = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	АдресФайла = ОбщийМодульВызовСервера.ПолучитьДанныеФайла(ТекущиеДанные.Документ, ТекущиеДанные.ИмяФайла, ТекущиеДанные.Номенклатура, ЭтотОбъект.УникальныйИдентификатор);
	
	Если НЕ АдресФайла = Неопределено Тогда // №7253
		ВременноеИмя = ПолучитьИмяВременногоФайла(ТекущиеДанные.Расширение);
	    ПолучитьФайл(АдресФайла, ВременноеИмя, Истина);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ФайлыДеревоПриАктивизацииСтроки(Элемент)
	
	//Предпросмотр = "";

	Если НЕ ВключитьПредпросмотрФайлов ИЛИ Элементы.ФайлыДерево.ТекущиеДанные = Неопределено Тогда //ИЛИ Элементы.ФайлыДерево.ТекущиеДанные.ПолучитьРодителя() = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если мПредыдущийИдентификатор = Элементы.ФайлыДерево.ТекущиеДанные.ПолучитьИдентификатор() Тогда
		Возврат;
	Иначе
		мПредыдущийИдентификатор = Элементы.ФайлыДерево.ТекущиеДанные.ПолучитьИдентификатор();
	КонецЕсли;
	
	ПодключитьОбработчикОжидания("ОбработчикОжиданияФайлыПриАктивизацииСтроки", 0.1, Истина);
	
КонецПроцедуры

