&НаКлиенте
Процедура ПотребностьСоздатьПеремещениеСОтбором(ЭтоВыдача = Истина)
	
	Если Потребность.Количество() = 0 Тогда
		ПоказатьОповещениеПользователя("Таблица пустая",, "Таблица ""Потребность"" пустая");
		Возврат;
	КонецЕсли;
	
	МассивПозицийКПеремещению = Новый Массив;
	Для каждого СтрокаПотребности из Потребность Цикл
		Если (ЭтоВыдача И СтрокаПотребности.Осталось > 0) 
			ИЛИ (НЕ ЭтоВыдача И СтрокаПотребности.Осталось < 0) Тогда
			НовСтрока = ПолучитьСтруктуруСтрокиДляПеремещения();
			ЗаполнитьЗначенияСвойств(НовСтрока, СтрокаПотребности);
			МассивПозицийКПеремещению.Добавить(НовСтрока);
		КонецЕсли;
	КонецЦикла;

	Если МассивПозицийКПеремещению.Количество() = 0 Тогда
		Сообщить("Нет позиций к перемещению с видом """ + ?(ЭтоВыдача, "Выдача", "Возврат") + """");
		Возврат;
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура("ПозицииКПеремещению, ПоКоманде", МассивПозицийКПеремещению, Истина);			
	Оповещение = Новый ОписаниеОповещения("ПослеВыбораПозицийКПеремещению", ЭтаФорма, ЭтоВыдача);
	ОткрытьФорму("Документ.Монтаж.Форма.ФормаПеремещения", ПараметрыФормы, ЭтотОбъект, ,,, Оповещение);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораПозицийКПеремещению(Результат, ДопПараметры) Экспорт
	
	ОчиститьСообщения();
	Если ТипЗнч(Результат) = Тип("Массив") Тогда
		Если Результат.Количество() = 0 Тогда			
			Сообщить("Нет позиций к перемещению с видом """ + ?(ДопПараметры, "Выдача", "Возврат") + """");
			Возврат;
		КонецЕсли;
	Иначе
		Возврат;
	КонецЕсли;
			
	МассивСозданныхДокументов = СоздатьДокументПеремещениеТоваров(Результат, ДопПараметры);
	
	Для каждого ДокументСсылка из МассивСозданныхДокументов Цикл
		ПоказатьЗначение(,ДокументСсылка);
	КонецЦикла;
	
КонецПроцедуры

