&НаКлиенте
Процедура РезультатПланировщикПередСозданием(Элемент, Начало, Конец, Значения, Текст, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ОчиститьСообщения();
	
	// если на графике нет бригад, то ничего не делаем
	Если Значения.Получить("Бригада") = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	//НастройкиГрафика = Новый Структура;
	//НастройкиГрафика.ВремяНачалаМонтажей = Константы.НачалоРабочегоВремениМонтажей.Получить();
	//НастройкиГрафика.ВремяКонцаМонтажей = Возврат Константы.КонецРабочегоВремениМонтажей.Получить();
	//НастройкиГрафика.ДлинаМонтажаПоУмолчаниюВЧасах = Возврат Константы.КоличествоЧасовНеобходимыхНаМонтаж.Получить();
	//НастройкиГрафика.ДлинаМонтажаПоУмолчаниюВСекундах = ДлинаМонтажаПоУмолчаниюВЧасах*60*60;
	
	//++17113
	ПараметрОтбора = Новый Структура;
	ПараметрОтбора.Вставить("ДатаМонтажа", НачалоДня(Начало));
	СтрокаМонтажа = Объект.ГрафикМонтажей.НайтиСтроки(ПараметрОтбора);
	Если СтрокаМонтажа.Количество() > 0 Тогда
		ИдентификаторСтроки = СтрокаМонтажа[0].ПолучитьИдентификатор();
		Элементы.ГрафикМонтажей.ТекущаяСтрока = ИдентификаторСтроки;
	КонецЕсли;	
	//--17113
	
	
	ДанныеТекущегоМонтажа = Новый Структура("ДатаМонтажа, ВремяНачала, ВремяОкончания");
	ИндексСтроки = 0;
	//++16681
	Если Объект.СрокМонтажа = ПредопределенноеЗначение("Перечисление.СрокиМонтажа.МонтажНаОдинДень") Тогда
	        ЗаполнитьЗначенияСвойств(ДанныеТекущегоМонтажа, Объект);
	КонецЕсли;
	
	Если Объект.СрокМонтажа = ПредопределенноеЗначение("Перечисление.СрокиМонтажа.ДатаМонтажаНеОпределена") Тогда
		ДанныеТекущегоМонтажа.ДатаМонтажа = НачалоДня(Начало);;	
		ДанныеТекущегоМонтажа.ВремяНачала=Начало-ДанныеТекущегоМонтажа.ДатаМонтажа;
		ДанныеТекущегоМонтажа.ВремяОкончания=Конец-ДанныеТекущегоМонтажа.ДатаМонтажа;
		ЗаполнитьЗначенияСвойств(Объект, ДанныеТекущегоМонтажа);
                Объект.СрокМонтажа = ПредопределенноеЗначение("Перечисление.СрокиМонтажа.МонтажНаОдинДень");
		СрокМонтажаПриИзменении(Неопределено);
	КонецЕсли;
	//--16681
	
	Если Объект.СрокМонтажа = ПредопределенноеЗначение("Перечисление.СрокиМонтажа.МонтажНаНесколькоДней") Тогда
		ТекущиеДанные = Элементы.ГрафикМонтажей.ТекущиеДанные;	
		Если НЕ ТекущиеДанные = Неопределено Тогда
			ЗаполнитьЗначенияСвойств(ДанныеТекущегоМонтажа, ТекущиеДанные);	
			ИндексСтроки = ТекущиеДанные.НомерСтроки;
		КонецЕсли;
	КонецЕсли;
	
	
	
	
	//++ №10185 комментируем, т.к. теперь график строится на несколько дней
	//Если Начало < Дата(Год(ДанныеТекущегоМонтажа.ДатаМонтажа), Месяц(ДанныеТекущегоМонтажа.ДатаМонтажа), День(ДанныеТекущегоМонтажа.ДатаМонтажа), Час(НастройкиГрафика.ВремяНачалаМонтажей), Минута(НастройкиГрафика.ВремяНачалаМонтажей),0) 
	//	или Конец > Дата(Год(ДанныеТекущегоМонтажа.ДатаМонтажа), Месяц(ДанныеТекущегоМонтажа.ДатаМонтажа), День(ДанныеТекущегоМонтажа.ДатаМонтажа), Час(НастройкиГрафика.ВремяКонцаМонтажей), Минута(НастройкиГрафика.ВремяКонцаМонтажей) ,0) Тогда
	//	Возврат;
	//КонецЕсли;
	//-- №10185
	
	ВыбраннаяБригада = Значения.Получить("Бригада");
	
	ТекущиеДанные = Элементы.ГрафикМонтажей.ТекущиеДанные;
	Если Объект.СрокМонтажа = ПредопределенноеЗначение("Перечисление.СрокиМонтажа.МонтажНаНесколькоДней") И НЕ ТекущиеДанные = Неопределено И ТипЗнч(ВыбраннаяБригада) = Тип("СправочникСсылка.Бригады") Тогда
		//++ №10185 меняем условие, на несколько дней график разрешаем менять бригаду только у одной записи в ТЧ
		//Если ТекущиеДанные.НомерСтроки > 1 Тогда
		Если Объект.ГрафикМонтажей.Количество() > 1 Тогда
		//-- №10185
