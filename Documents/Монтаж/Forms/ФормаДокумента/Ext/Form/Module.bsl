&НаСервере
Процедура ДобавитьЗаписьВИсторию(Комментарий)
	
	НоваяСтрока = ИсторияМонтажаНаФорме.Добавить();
	НоваяСтрока.Дата = ТекущаяДатаСеанса();
	НоваяСтрока.Пользователь = Пользователи.ТекущийПользователь();
	НоваяСтрока.Комментарий = Комментарий;
	НоваяСтрока.ИДЗаписи = Новый УникальныйИдентификатор;
	
КонецПроцедуры

&НаСервере
Процедура ЗаписатьИсториюМонтажаНаФормеВРегистрСведенийНаСервере();
	
	//для каждого варианта данных измерений делаем отдельный отбор и запись, чтобы не стереть те записи, которые могли появиться в РС пока мы работали с документом
	Для Каждого ТекущаяСтрока Из ИсторияМонтажаНаФорме Цикл
		НаборЗаписей = РегистрыСведений.ИсторияМонтажа.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Монтаж.Установить(Объект.Ссылка); 
		НаборЗаписей.Отбор.Дата.Установить(ТекущаяСтрока.Дата); 
		НаборЗаписей.Отбор.Пользователь.Установить(ТекущаяСтрока.Пользователь); 
		НаборЗаписей.Отбор.ИДЗаписи.Установить(ТекущаяСтрока.ИДЗаписи); 
		//НаборЗаписей.Прочитать();
		
		НоваяЗапись = НаборЗаписей.Добавить(); 
		НоваяЗапись.Монтаж = Объект.Ссылка; 
		НоваяЗапись.Дата = ТекущаяСтрока.Дата;
		НоваяЗапись.Пользователь = ТекущаяСтрока.Пользователь;
		НоваяЗапись.Комментарий = ТекущаяСтрока.Комментарий;
		НоваяЗапись.ИДЗаписи = ТекущаяСтрока.ИДЗаписи;
		
		НаборЗаписей.Записать();
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ИсторияМонтажаНаФормеВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	ПараметрыНовойФормы = Новый Структура;
	ПараметрыНовойФормы.Вставить("Монтаж", Объект.Ссылка);
	ПараметрыНовойФормы.Вставить("Дата", Элементы.ИсторияМонтажаНаФорме.ТекущиеДанные.Дата);
	ПараметрыНовойФормы.Вставить("Пользователь", Элементы.ИсторияМонтажаНаФорме.ТекущиеДанные.Пользователь);
	ПараметрыНовойФормы.Вставить("Комментарий", Элементы.ИсторияМонтажаНаФорме.ТекущиеДанные.Комментарий);
	ОткрытьФорму("Документ.Монтаж.Форма.ФормаКомментарий", ПараметрыНовойФормы,ЭтаФорма,,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры

