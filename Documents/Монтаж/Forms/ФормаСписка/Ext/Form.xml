	<Attributes>
		<Attribute name="Список" id="1">
			<Type>
				<v8:Type>cfg:DynamicList</v8:Type>
			</Type>
			<MainAttribute>true</MainAttribute>
			<UseAlways>
				<Field>~Список.Ref</Field>
				<Field>Список.ОбщееСостояние</Field>
				<Field>Список.СостояниеОригиналаПервичногоДокумента</Field>
				<Field>Список.Ссылка</Field>
			</UseAlways>
			<Settings xsi:type="DynamicList">
				<ManualQuery>true</ManualQuery>
				<DynamicDataRead>false</DynamicDataRead>
				<QueryText>ВЫБРАТЬ РАЗРЕШЕННЫЕ
	ДокументМонтаж.Ссылка КАК Ссылка,
	ДокументМонтаж.ПометкаУдаления КАК ПометкаУдаления,
	ДокументМонтаж.Номер КАК Номер,
	ДокументМонтаж.Дата КАК Дата,
	ДокументМонтаж.Проведен КАК Проведен,
	ДокументМонтаж.Адрес КАК Адрес,
	ДокументМонтаж.Бригада КАК Бригада,
	ДокументМонтаж.Бригадир КАК Бригадир,
	ДокументМонтаж.Валюта КАК Валюта,
	ДокументМонтаж.ВидЦен КАК ВидЦен,
	ДокументМонтаж.ВремяНачала КАК ВремяНачала,
	ДокументМонтаж.ВремяОкончания КАК ВремяОкончания,
	ДокументМонтаж.ДатаМонтажа КАК ДатаМонтажа,
	ВЫБОР 
	    КОГДА ДокументМонтаж.СрокМонтажа = ЗНАЧЕНИЕ(Перечисление.СрокиМонтажа.ДатаМонтажаНеОпределена)
	    ТОГДА ИСТИНА
	    ИНАЧЕ ЛОЖЬ
	КОНЕЦ КАК ДатаМонтажаНеОпределена,
	ВЫБОР 
		КОГДА ДокументМонтаж.СрокМонтажа = ЗНАЧЕНИЕ(Перечисление.СрокиМонтажа.МонтажНаНесколькоДней)
		ТОГДА ИСТИНА
		ИНАЧЕ ЛОЖЬ
	КОНЕЦ КАК НаНесколькоДней,	
	ДокументМонтаж.СрокМонтажа КАК СрокМонтажа,
	// №12802 ДокументМонтаж.ДатаСоздания КАК ДатаСоздания,
	ДокументМонтаж.ДисконтнаяКарта КАК ДисконтнаяКарта,
	ДокументМонтаж.ДоговорКонтрагента КАК ДоговорКонтрагента,
	ДокументМонтаж.КомментарийКМонтажу КАК КомментарийКМонтажу,
	ДокументМонтаж.Контрагент КАК Контрагент,
	ДокументМонтаж.Организация КАК Организация,
	ДокументМонтаж.Основание КАК Основание,
	ДокументМонтаж.Автор КАК Автор,
	ДокументМонтаж.Подразделение КАК Подразделение,
	ДокументМонтаж.Результат КАК Результат,
	ДокументМонтаж.Склад КАК Склад,
	ДокументМонтаж.СкладТоваров КАК СкладТоваров,
	ДокументМонтаж.СтатьяДоходов КАК СтатьяДоходов,
	ДокументМонтаж.СтатьяРасходов КАК СтатьяРасходов,
	ДокументМонтаж.СуммаДокумента КАК СуммаДокумента,
	ДокументМонтаж.СуммаДополнительныхЗатрат КАК СуммаДополнительныхЗатрат,
	ДокументМонтаж.УДАЛИТЬ_ДатаВыполнения КАК УДАЛИТЬ_ДатаВыполнения,
	ДокументМонтаж.МоментВремени КАК МоментВремени,
	ВЫБОР
		КОГДА ПотребностьВМатериалахДляМонтажаОбороты.КоличествоПриход = 0
			ТОГДА -1
		КОГДА ПотребностьВМатериалахДляМонтажаОбороты.КоличествоРасход = 0
			ТОГДА 2
		КОГДА ПотребностьВМатериалахДляМонтажаОбороты.КоличествоПриход = ПотребностьВМатериалахДляМонтажаОбороты.КоличествоРасход
			ТОГДА 0
		КОГДА ПотребностьВМатериалахДляМонтажаОбороты.КоличествоПриход &gt; ПотребностьВМатериалахДляМонтажаОбороты.КоличествоРасход
			ТОГДА 1
		КОГДА ПотребностьВМатериалахДляМонтажаОбороты.КоличествоПриход &lt; ПотребностьВМатериалахДляМонтажаОбороты.КоличествоРасход
			ТОГДА 5
		ИНАЧЕ -1
	КОНЕЦ КАК ОбеспечениеМатериалами,
	ДокументМонтаж.ВидОперации КАК ВидОперации,
	ВЫБОР
		КОГДА СоответствиеДоговораИМонтажей.Монтаж ЕСТЬ NULL
			ТОГДА -1
		ИНАЧЕ 0
	КОНЕЦ КАК СоответствиеДоговору,
	ДокументМонтаж.ДатаВыполнения КАК ДатаВыполнения,
	ДокументМонтаж.ДатаЗакрытия КАК ДатаЗакрытия,
	//++ №11520 дата и время монтажа вместе
	ДОБАВИТЬКДАТЕ(ДокументМонтаж.ДатаМонтажа, СЕКУНДА, РАЗНОСТЬДАТ(ДАТАВРЕМЯ(1,1,1), ДокументМонтаж.ВремяНачала, СЕКУНДА)) КАК ДатаНачалаМонтажа,
	ВЫБОР
		КОГДА ДокументМонтаж.СрокМонтажа = ЗНАЧЕНИЕ(Перечисление.СрокиМонтажа.МонтажНаНесколькоДней)
			ТОГДА ЕСТЬNULL(ДатыМонтажей.ДатаОкончания, ДАТАВРЕМЯ(1,1,1))
		ИНАЧЕ ДОБАВИТЬКДАТЕ(ДокументМонтаж.ДатаМонтажа, СЕКУНДА, РАЗНОСТЬДАТ(ДАТАВРЕМЯ(1,1,1), ДокументМонтаж.ВремяОкончания, СЕКУНДА))
	КОНЕЦ КАК ДатаОкончанияМонтажа ,
	//-- №11520
	
	ВЫБОР
		КОГДА ЕСТЬNULL(ДокументМонтаж.СуммаДокумента, 0) = 0
				ИЛИ ЕСТЬNULL(РасчетыПоЗаказамОбороты.СуммаРасход, 0) = 0
			ТОГДА 2
		ИНАЧЕ ВЫБОР
				КОГДА ЕСТЬNULL(ДокументМонтаж.СуммаДокумента, 0) &lt;= ЕСТЬNULL(РасчетыПоЗаказамОбороты.СуммаРасход, 0)
						И ЕСТЬNULL(РасчетыПоЗаказамОбороты.СуммаРасход, 0) &gt; 0
					ТОГДА 0
				ИНАЧЕ 1
			КОНЕЦ
	КОНЕЦ КАК СостояниеОплаты,
	
	NULL КАК СостояниеОригиналаПервичногоДокумента,
	ИСТИНА КАК ОбщееСостояние,
	0 КАК СостояниеОригиналПолучен
ИЗ
	Документ.Монтаж КАК ДокументМонтаж
		
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ПотребностьВМатериалахДляМонтажа.Обороты() КАК ПотребностьВМатериалахДляМонтажаОбороты
		ПО ДокументМонтаж.Ссылка = ПотребностьВМатериалахДляМонтажаОбороты.Монтаж
		
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СоответствиеДоговораИМонтажей КАК СоответствиеДоговораИМонтажей
		ПО ДокументМонтаж.Ссылка = СоответствиеДоговораИМонтажей.Монтаж
		
		{ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.РасчетыПоЗаказам.Обороты КАК РасчетыПоЗаказамОбороты
		ПО ДокументМонтаж.Ссылка = РасчетыПоЗаказамОбороты.Заказ}
		
		//++ №11520 дата окончания монтажа может быть другой, если он на несколько дней
		ЛЕВОЕ СОЕДИНЕНИЕ (
			ВЫБРАТЬ
				ГрафикМонтажей.Ссылка КАК МонтажСсылка,
				МАКСИМУМ(ДОБАВИТЬКДАТЕ(ГрафикМонтажей.ДатаМонтажа, СЕКУНДА, РАЗНОСТЬДАТ(ДАТАВРЕМЯ(1,1,1), ГрафикМонтажей.ВремяОкончания, СЕКУНДА))) КАК ДатаОкончания
			ИЗ
				Документ.Монтаж.ГрафикМонтажей КАК ГрафикМонтажей
			
			СГРУППИРОВАТЬ ПО
				ГрафикМонтажей.Ссылка) КАК ДатыМонтажей
		ПО ДокументМонтаж.Ссылка = ДатыМонтажей.МонтажСсылка
		//-- №11520
		</QueryText>
				<MainTable>Document.Монтаж</MainTable>
				<ListSettings>
					<dcsset:filter>
						<dcsset:viewMode>Normal</dcsset:viewMode>
						<dcsset:userSettingID>dfcece9d-5077-440b-b6b3-45a5cb4538eb</dcsset:userSettingID>
					</dcsset:filter>
					<dcsset:order>
						<dcsset:item xsi:type="dcsset:OrderItemField">
							<dcsset:field>Дата</dcsset:field>
							<dcsset:orderType>Asc</dcsset:orderType>
						</dcsset:item>
