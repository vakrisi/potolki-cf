	//	ИЛИ ВидОперации = Справочники.ВидыМонтажа.СервиснаяЗаявка  //#16242
	//	Тогда
	//	
	//	//Для Каждого ТекущаяСтрока Из ДанныеЗаполнения.ТоварыУслуги Цикл
	//	//	
	//	//	НоваяСтрока = ТоварыУслуги.Добавить();
	//	//	ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущаяСтрока);
	//	//	
	//	//КонецЦикла;
	//	
	////-- №12721
	//ИначеЕсли НЕ ВидОперации = Справочники.ВидыМонтажа.Монтаж Тогда
	//	Возврат;
	//КонецЕсли;
	
	Если НЕ ДанныеЗаполнения.ЗаполнятьУИСтрок Тогда
		//таблица материалов
		ЗаполнитьМатериалыПоЗаказДоговору();	
		//таблица товаров и услуг
		ЗаполнитьТоварыПоЗаказДоговору();
