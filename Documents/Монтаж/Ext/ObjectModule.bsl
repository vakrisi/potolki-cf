Процедура ЗаполнитьТоварыПоЗаказДоговору() Экспорт
	
	Если НЕ ТипЗнч(Основание) = Тип("ДокументСсылка.ЗаказДоговор") Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТоварыДоговора.Комната КАК Комната,
	|	ТоварыДоговора.Номенклатура КАК Номенклатура,
	|	ТоварыДоговора.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	|	ТоварыДоговора.НомерПотолка КАК НомерПотолка,
	|	ЕСТЬNULL(ТоварыДоговора.Количество, 0) - ЕСТЬNULL(ТоварыМонтажа.Количество, 0) КАК Количество,
	|	ТоварыДоговора.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	ТоварыДоговора.Коэффициент КАК Коэффициент,
	|	ТоварыДоговора.Цена КАК Цена,
	|	ТоварыДоговора.Бесплатно КАК Бесплатно,
	|	ЕСТЬNULL(ТоварыДоговора.Сумма, 0) - ЕСТЬNULL(ТоварыМонтажа.Сумма, 0) КАК Сумма,
	|	ТоварыДоговора.Спецификация КАК Спецификация,
	//|	ТоварыДоговора.ЦветФактуры КАК ЦветФактуры,
	|	ТоварыДоговора.УИСтроки КАК УИСтроки
	|ИЗ
	|	(ВЫБРАТЬ
	|		ЗаказДоговорТоварыУслуги.Ссылка КАК Ссылка,
	|		ЗаказДоговорТоварыУслуги.Комната КАК Комната,
	|		ЗаказДоговорТоварыУслуги.Номенклатура КАК Номенклатура,
	|		ЗаказДоговорТоварыУслуги.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	|		ЗаказДоговорТоварыУслуги.НомерПотолка КАК НомерПотолка,
	|		СУММА(ЗаказДоговорТоварыУслуги.Количество) КАК Количество,
	|		ЗаказДоговорТоварыУслуги.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|		ЗаказДоговорТоварыУслуги.Коэффициент КАК Коэффициент,
	|		ЗаказДоговорТоварыУслуги.Цена КАК Цена,
	|		СУММА(ЗаказДоговорТоварыУслуги.Сумма) КАК Сумма,
	|		ЗаказДоговорТоварыУслуги.Бесплатно КАК Бесплатно,
	|		ЗаказДоговорТоварыУслуги.Спецификация КАК Спецификация,
	//|		ЗаказДоговорТоварыУслуги.ЦветФактуры КАК ЦветФактуры,
	|		ЗаказДоговорТоварыУслуги.УИСтроки КАК УИСтроки
	|	ИЗ
	|		Документ.ЗаказДоговор.ТоварыУслуги КАК ЗаказДоговорТоварыУслуги
	|	
	|	СГРУППИРОВАТЬ ПО
	|		ЗаказДоговорТоварыУслуги.Комната,
	|		ЗаказДоговорТоварыУслуги.Номенклатура,
	|		ЗаказДоговорТоварыУслуги.ХарактеристикаНоменклатуры,
	|		ЗаказДоговорТоварыУслуги.НомерПотолка,
	|		ЗаказДоговорТоварыУслуги.Ссылка,
	|		ЗаказДоговорТоварыУслуги.Спецификация,
	//|		ЗаказДоговорТоварыУслуги.ЦветФактуры,
	|		ЗаказДоговорТоварыУслуги.ЕдиницаИзмерения,
	|		ЗаказДоговорТоварыУслуги.Коэффициент,
	|		ЗаказДоговорТоварыУслуги.Цена,
	|		ЗаказДоговорТоварыУслуги.Бесплатно,
	|		ЗаказДоговорТоварыУслуги.УИСтроки) КАК ТоварыДоговора
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			МонтажТоварыУслуги.Комната КАК Комната,
	|			МонтажТоварыУслуги.Номенклатура КАК Номенклатура,
	|			МонтажТоварыУслуги.НомерПотолка КАК НомерПотолка,
	|			СУММА(МонтажТоварыУслуги.Количество) КАК Количество,
	|			МонтажТоварыУслуги.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|			МонтажТоварыУслуги.Коэффициент КАК Коэффициент,
	|			МонтажТоварыУслуги.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	|			МонтажТоварыУслуги.СерияНоменклатуры КАК СерияНоменклатуры,
	|			МонтажТоварыУслуги.Цена КАК Цена,
	|			СУММА(МонтажТоварыУслуги.Сумма) КАК Сумма,
	|			МонтажТоварыУслуги.Бесплатно КАК Бесплатно,
	|			МонтажТоварыУслуги.Спецификация КАК Спецификация,
	|			МонтажТоварыУслуги.УИСтроки КАК УИСтроки
	|		ИЗ
	|			Документ.Монтаж.ТоварыУслуги КАК МонтажТоварыУслуги
	|		ГДЕ
	|			МонтажТоварыУслуги.Ссылка.Проведен
	|			И МонтажТоварыУслуги.Ссылка.Основание = &ЗаказДоговор
	|			И НЕ МонтажТоварыУслуги.Ссылка = &Монтаж
	|		
	|		СГРУППИРОВАТЬ ПО
	|			МонтажТоварыУслуги.Комната,
	|			МонтажТоварыУслуги.Номенклатура,
	|			МонтажТоварыУслуги.НомерПотолка,
	|			МонтажТоварыУслуги.ЕдиницаИзмерения,
	|			МонтажТоварыУслуги.Коэффициент,
	|			МонтажТоварыУслуги.ХарактеристикаНоменклатуры,
	|			МонтажТоварыУслуги.СерияНоменклатуры,
	|			МонтажТоварыУслуги.Цена,
	|			МонтажТоварыУслуги.Бесплатно,
	|			МонтажТоварыУслуги.Спецификация,
	|			МонтажТоварыУслуги.УИСтроки) КАК ТоварыМонтажа
	|		ПО ТоварыДоговора.Комната = ТоварыМонтажа.Комната
	|			И ТоварыДоговора.Номенклатура = ТоварыМонтажа.Номенклатура
	|			И ТоварыДоговора.ХарактеристикаНоменклатуры = ТоварыМонтажа.ХарактеристикаНоменклатуры
	|			И ТоварыДоговора.Коэффициент = ТоварыМонтажа.Коэффициент
	|			И ТоварыДоговора.ЕдиницаИзмерения = ТоварыМонтажа.ЕдиницаИзмерения
	|			И ТоварыДоговора.Цена = ТоварыМонтажа.Цена
	|			И ТоварыДоговора.Спецификация = ТоварыМонтажа.Спецификация
	|ГДЕ
	|	ТоварыДоговора.Ссылка = &ЗаказДоговор
	|
	|УПОРЯДОЧИТЬ ПО
	|	ТоварыДоговора.Комната";
	
	Запрос.УстановитьПараметр("ЗаказДоговор", Основание);
	Запрос.УстановитьПараметр("Монтаж", Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда 
		Возврат;
	КонецЕсли;
	
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		Если НЕ Выборка.Номенклатура.Пустая() Тогда
			Если Выборка.Количество > 0 Тогда 
				НоваяСтрока = ТоварыУслуги.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
				СуммаБезСкидки = НоваяСтрока.Цена * НоваяСтрока.Количество;
				НоваяСтрока.СуммаСкидки = СуммаБезСкидки - НоваяСтрока.Сумма;
				Если НоваяСтрока.СуммаСкидки > 0 Тогда 
					Если СуммаБезСкидки > 0  Тогда 						
						НоваяСтрока.ПроцентСкидки = НоваяСтрока.СуммаСкидки / СуммаБезСкидки * 100;
					КонецЕсли;
				КонецЕсли; 				
				//НоваяСтрока.КоличествоВыработка = Документы.Монтаж.ПолучитьКоличествоВыработка(НоваяСтрока.Количество);
				//Закомментировано: Заполнение поля к списанию должно происходить только по кнопке в ТЧ, заявка #4227
				//Раскомментировано: заявка #4679
				Если Справочники.ВидыНоменклатуры.ЭтоНоменклатураПотолкаИлиОтреза(НоваяСтрока.Номенклатура) Тогда  
					НоваяСтрока.КоличествоКСписанию = НоваяСтрока.Номенклатура.Потолок_КоличествоПродукция;
				ИначеЕсли Справочники.ВидыНоменклатуры.ЭтоНоменклатураУслуга(НоваяСтрока.Номенклатура) Тогда  
					НоваяСтрока.КоличествоКСписанию = 0;
				Иначе
					НоваяСтрока.КоличествоКСписанию = НоваяСтрока.Количество;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьМатериалыПоЗаказДоговору() Экспорт
	
	Если НЕ ТипЗнч(Основание) = Тип("ДокументСсылка.ЗаказДоговор") Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	МатериалыДоговора.Комната КАК Комната,
	|	МатериалыДоговора.Номенклатура КАК Номенклатура,
	|	МатериалыДоговора.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	|	МатериалыДоговора.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	МатериалыДоговора.Коэффициент КАК Коэффициент,
	|	ЕСТЬNULL(МатериалыДоговора.Количество, 0) - ЕСТЬNULL(МатериалыМонтажа.Количество, 0) КАК Количество
	|ИЗ
	|	(ВЫБРАТЬ
	|		ЗаказДоговорМатериалы.Ссылка КАК Ссылка,
	|		ЗаказДоговорМатериалы.Комната КАК Комната,
	|		ЗаказДоговорМатериалы.Номенклатура КАК Номенклатура,
	|		ЗаказДоговорМатериалы.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	|		СУММА(ЗаказДоговорМатериалы.Количество) КАК Количество,
	|		ЗаказДоговорМатериалы.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|		ЗаказДоговорМатериалы.Коэффициент КАК Коэффициент
	|	ИЗ
	|		Документ.ЗаказДоговор.Материалы КАК ЗаказДоговорМатериалы
	|	
	|	СГРУППИРОВАТЬ ПО
	|		ЗаказДоговорМатериалы.Ссылка,
	|		ЗаказДоговорМатериалы.Комната,
	|		ЗаказДоговорМатериалы.Номенклатура,
	|		ЗаказДоговорМатериалы.ХарактеристикаНоменклатуры,
	|		ЗаказДоговорМатериалы.ЕдиницаИзмерения,
	|		ЗаказДоговорМатериалы.Коэффициент) КАК МатериалыДоговора
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			МонтажМатериалы.Ссылка КАК Ссылка,
	|			МонтажМатериалы.Комната КАК Комната,
	|			МонтажМатериалы.Номенклатура КАК Номенклатура,
	|			МонтажМатериалы.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	|			МонтажМатериалы.СерияНоменклатуры КАК СерияНоменклатуры,
	|			МонтажМатериалы.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|			МонтажМатериалы.Коэффициент КАК Коэффициент,
	|			СУММА(МонтажМатериалы.Количество) КАК Количество,
	|			СУММА(МонтажМатериалы.Цена) КАК Цена,
	|			СУММА(МонтажМатериалы.Сумма) КАК Сумма
	|		ИЗ
	|			Документ.Монтаж.Материалы КАК МонтажМатериалы
	|		ГДЕ
	|			МонтажМатериалы.Ссылка.Проведен
	|		
	|		СГРУППИРОВАТЬ ПО
	|			МонтажМатериалы.Ссылка,
	|			МонтажМатериалы.Комната,
	|			МонтажМатериалы.Номенклатура,
	|			МонтажМатериалы.ХарактеристикаНоменклатуры,
	|			МонтажМатериалы.СерияНоменклатуры,
	|			МонтажМатериалы.ЕдиницаИзмерения,
	|			МонтажМатериалы.Коэффициент) КАК МатериалыМонтажа
	|		ПО МатериалыДоговора.Ссылка = МатериалыМонтажа.Ссылка.Основание
	|			И МатериалыДоговора.Комната = МатериалыМонтажа.Комната
	|			И МатериалыДоговора.Номенклатура = МатериалыМонтажа.Номенклатура
	|			И МатериалыДоговора.ХарактеристикаНоменклатуры = МатериалыМонтажа.ХарактеристикаНоменклатуры
	|			И МатериалыДоговора.Коэффициент = МатериалыМонтажа.Коэффициент
	|			И МатериалыДоговора.ЕдиницаИзмерения = МатериалыМонтажа.ЕдиницаИзмерения
	|ГДЕ
	|	МатериалыДоговора.Ссылка = &Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	МатериалыДоговора.Комната";
	Запрос.УстановитьПараметр("Ссылка", Основание);
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда 
		Возврат;
	КонецЕсли;
	
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		Если НЕ Выборка.Номенклатура.Пустая() Тогда
			Если Выборка.Количество > 0 Тогда 
				НоваяСтрока = Материалы.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Функция ЗаполнитьСкладыПоБригаде() Экспорт
	
	Склад = Бригада.Склад;
	Если Склад.Пустая() Тогда
		Если ТипЗнч(Основание) = Тип("ДокументСсылка.ЗаказДоговор") Тогда
			Склад = Основание.ТочкаПродаж.МонтажСкладМатериалов;
		КонецЕсли;
	КонецЕсли;
	Если Склад.Пустая() Тогда
		Склад = ПараметрыСеанса.Пользователь.СкладМатериаловРозница;
	КонецЕсли;
	
	СкладТоваров = Бригада.СкладТоваров;
	Если СкладТоваров.Пустая() Тогда
		Если ТипЗнч(Основание) = Тип("ДокументСсылка.ЗаказДоговор") Тогда
			СкладТоваров = Основание.ТочкаПродаж.МонтажСкладТоваров;
		КонецЕсли;
	КонецЕсли;
	Если СкладТоваров.Пустая() Тогда
		СкладТоваров = ПараметрыСеанса.Пользователь.СкладРозница;
	КонецЕсли;

КонецФункции

Процедура ДополнитьТаблицуВыработки(ТаблицаПоВыработке, ДатаВыработки)
	
	ТаблицаПоВыработке.Колонки.Добавить("Период");
	ТаблицаПоВыработке.Колонки.Добавить("Регистратор");
	ТаблицаПоВыработке.Колонки.Добавить("ОбъектВыработки");
	
	ТаблицаПоВыработке.ЗаполнитьЗначения(ДатаВыработки, "Период");
	ТаблицаПоВыработке.ЗаполнитьЗначения(Ссылка, "Регистратор");
	ТаблицаПоВыработке.ЗаполнитьЗначения(Ссылка, "ОбъектВыработки");
	
КонецПроцедуры

#КонецОбласти

