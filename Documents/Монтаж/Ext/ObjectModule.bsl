	//ПриРасчетеВыработкиУчитыватьПроцентОтклоненияОтПрайса = ПолучитьФункциональнуюОпцию("ПриРасчетеВыработкиПоМонтажуУчитыватьПроцентОтклоненияОтПрайса");
	
	// №1083
	СозданПриИспользованииСтатусаЗакрыт = Константы.ИспользоватьСтатусЗакрытВМонтаже.Получить();
	
	//#6297
	СлужебныйИспользоватьИсключенияИзКонтроляВыдачиВозврата = ПолучитьФункциональнуюОпцию("ИспользоватьВыдачуВозвратВДокументеМонтаж") 
																И Константы.ИспользоватьИсключенияИзКонтроляВыдачиВозвратаПоМонтажам.Получить();
	Если СлужебныйИспользоватьИсключенияИзКонтроляВыдачиВозврата Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Исключения.Номенклатура КАК Номенклатура
		|ИЗ
		|	РегистрСведений.ИсключенияИзКонтроляВыдачиВозвратаМатериаловПоМонтажам КАК Исключения";
		НеконтролируемыеМатериалы.Загрузить(Запрос.Выполнить().Выгрузить());
	КонецЕсли;
	
	//#14828
	СозданПриИспользованииПодразделений  = Константы.ИспользоватьПодразделения.Получить();
	
	//#16741
	ВариантЗаполненияДатыПодписания = Перечисления.ВариантыЗаполненияДатыПодписанияВМонтаже.НеЗаполнять;
	
КонецПроцедуры

Процедура ДозаполнитьПоУмолчанию()
	
	// #16346
	Если ВидОперации = Справочники.ВидыМонтажа.Продажа Тогда
		Результат = Справочники.РезультатыМонтажа.ПустаяСсылка();
		//#16741
