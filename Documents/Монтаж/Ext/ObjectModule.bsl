Функция ДобавитьЗаписиВИсториюПоМонтажам(Знач ПредыдущаяТаблица, Знач ТекущаяТаблица)
	
	ЗаписиВРегистрИстории = Новый ТаблицаЗначений;
	Для каждого ИзмерениеРегистра из метаданные.РегистрыСведений.ИсторияМонтажа.Измерения Цикл
		ЗаписиВРегистрИстории.Колонки.Добавить(ИзмерениеРегистра.Имя);
	КонецЦикла;
	Для каждого РесурсРегистра из метаданные.РегистрыСведений.ИсторияМонтажа.Ресурсы Цикл
		ЗаписиВРегистрИстории.Колонки.Добавить(РесурсРегистра.Имя);
	КонецЦикла;
	
	ИмяПоляДата 	 = "ДатаМонтажа";
	ИмяПоляНачала 	 = "ВремяНачала";
	ИмяПоляОкончания = "ВремяОкончания";
	ИмяПоляИсполнитель = "Бригада";
	
	ЕстьИзменения = Ложь;
	
	Для каждого СтрокаМонтажа из ПредыдущаяТаблица Цикл
		НайденныеСтроки = ТекущаяТаблица.НайтиСтроки(Новый Структура("ИДМонтажа", СтрокаМонтажа.ИДМонтажа));
		Если НайденныеСтроки.Количество() = 0 Тогда	
			ТекстВИсторию = "Удален %1. Дата: %2 %3 (%4)";
			ТекстВИсторию = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстВИсторию,
									"монтаж",
									Формат(СтрокаМонтажа[ИмяПоляДата],"ДЛФ=Д"),
									Формат(СтрокаМонтажа[ИмяПоляНачала],"ДЛФ=В"),
									СтрокаМонтажа[ИмяПоляИсполнитель]);
			ДобавитьЗаписьВИсторию(ТекстВИсторию);
			ЕстьИзменения = Истина;
		КонецЕсли;
	КонецЦикла;
	
	Для каждого СтрокаМонтажа из ТекущаяТаблица Цикл
		НайденныеСтроки = ПредыдущаяТаблица.НайтиСтроки(Новый Структура("ИДМонтажа", СтрокаМонтажа.ИДМонтажа));
		Если НайденныеСтроки.Количество() > 0 Тогда	
			Если НЕ СтрокаМонтажа[ИмяПоляДата] = НайденныеСтроки[0][ИмяПоляДата] 
				ИЛИ НЕ СтрокаМонтажа[ИмяПоляНачала] = НайденныеСтроки[0][ИмяПоляНачала] 
				ИЛИ НЕ СтрокаМонтажа[ИмяПоляИсполнитель] = НайденныеСтроки[0][ИмяПоляИсполнитель] Тогда
				
				ТекстВИсторию = "%1 перенесен. Старые значения Дата: %2 %3 (%4). Новые значения Дата: %5 %6 (%7)";
				ТекстВИсторию = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстВИсторию,
									"Монтаж",
									Формат(НайденныеСтроки[0][ИмяПоляДата],"ДЛФ=Д"),
									Формат(НайденныеСтроки[0][ИмяПоляНачала],"ДЛФ=В"),
									НайденныеСтроки[0][ИмяПоляИсполнитель],
									Формат(СтрокаМонтажа[ИмяПоляДата],"ДЛФ=Д"),
									Формат(СтрокаМонтажа[ИмяПоляНачала],"ДЛФ=В"),
									СтрокаМонтажа[ИмяПоляИсполнитель]);
				ДобавитьЗаписьВИсторию(ТекстВИсторию);
				ЕстьИзменения = Истина;
			КонецЕсли;
		Иначе
			ТекстВИсторию = "Назначен %1. Дата: %2 %3 (%4)";
			ТекстВИсторию = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстВИсторию,
									"монтаж",
									Формат(СтрокаМонтажа[ИмяПоляДата],"ДЛФ=Д"),
									Формат(СтрокаМонтажа[ИмяПоляНачала],"ДЛФ=В"),
									СтрокаМонтажа[ИмяПоляИсполнитель]);
			ДобавитьЗаписьВИсторию(ТекстВИсторию);
			ЕстьИзменения = Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат ЕстьИзменения;
	
КонецФункции

Процедура ДобавитьЗаписьВИсторию(Комментарий)
	
	НоваяСтрока = ЗаписиВРегистрИстории.Добавить();
	НоваяСтрока.Дата = ТекущаяДатаСеанса();
	НоваяСтрока.Пользователь = Пользователи.ТекущийПользователь();
	НоваяСтрока.Комментарий = Комментарий;
	НоваяСтрока.ИДЗаписи = Новый УникальныйИдентификатор;
	
КонецПроцедуры

Функция ЗаменитьПараметрыВШаблоне(ТекстСМС, ЭтоНоваяСмс = Ложь)
	
	Если ПустаяСтрока(ТекстСМС) Тогда
		Сообщить ("ВНИМАНИЕ!!! В системе не заданы шаблоны СМС для монтажей!!!",СтатусСообщения.ОченьВажное);
		ТекстСМС = "Вам назначен монтаж потолков";
	КонецЕсли;
	
	ТекстСМС = СтрЗаменить(ТекстСМС, "%Адрес", Адрес);
	ТекстСМС = СтрЗаменить(ТекстСМС, "%Контрагент", Контрагент.Наименование);
	
	//++ №9547 если дата будет определена по звонку, зануляем параметры даты и времени монтажа и добавляем текст "Дата будет определена по звонку"
	Если СрокМонтажа = Перечисления.СрокиМонтажа.ДатаМонтажаНеОпределена Тогда
		
		ТекстСМС = СтрЗаменить(ТекстСМС, "%Дата", "");
		ТекстСМС = СтрЗаменить(ТекстСМС, "%ВремяНачала", "");
		
		//++ №11843
		//ТекстСМС = ТекстСМС + " " + ?(ЭтоНоваяСмс, "Дата монтажа будет определена по звонку.", "Дата монтажа изменилась и будет определена по звонку.");
		ТекстСМС = ТекстСМС + " " + ?(ЭтоНоваяСмс, "Дата монтажа не определена.", "Дата монтажа стала не определена.");
		//-- №11843
		
	//-- №9547
	Иначе
	
		ТекстСМС = СтрЗаменить(ТекстСМС, "%Дата", Лев(ДатаМонтажа,10));
		ТекстСМС = СтрЗаменить(ТекстСМС, "%ВремяНачала", Формат(ВремяНачала,"ДФ=Ч:мм"));
		
	КонецЕсли;
	
	Возврат ТекстСМС;
	
КонецФункции

Функция ДатаМонтажаНазначена()
	Если ДатаМонтажа > Дата(2010, 01, 01) Тогда 
		Возврат Истина;
	ИначеЕсли СрокМонтажа = Перечисления.СрокиМонтажа.ДатаМонтажаНеОпределена Тогда 
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;
КонецФункции

Функция СМСОтправляласьРанее(Регистр, ДокументОснование, Контрагент, ПризнакСМС)
	
	Запрос = новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	РегистрСМС.ТекстСообщения
	|ИЗ
	|   РегистрСведений." + Регистр + " КАК РегистрСМС
	|ГДЕ
	|	РегистрСМС.ДокументОснование = &ДокументОснование
	|	И РегистрСМС.Контрагент = &Контрагент
	|	И РегистрСМС.ПризнакСМС = &ПризнакСМС";
	Запрос.УстановитьПараметр("ДокументОснование", ДокументОснование);
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Запрос.УстановитьПараметр("ПризнакСМС", ПризнакСМС);
	
	РезультатЗапроса = Запрос.Выполнить();
	Если НЕ РезультатЗапроса.Пустой()Тогда
		Возврат Истина;
	КонецЕсли;
	
	Возврат Ложь;

КонецФункции

