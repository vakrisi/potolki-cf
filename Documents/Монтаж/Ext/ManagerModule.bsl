	|	ДанныеТабличнойЧасти.Коэффициент КАК Коэффициент,
	|	ДанныеТабличнойЧасти.Количество КАК Количество,
	|	ДанныеТабличнойЧасти.Цена КАК Цена,
	|	ДанныеТабличнойЧасти.СуммаСкидки КАК СуммаСкидки,
	|	ДанныеТабличнойЧасти.Сумма КАК Сумма,
	|	ДанныеТабличнойЧасти.СтавкаНДС КАК СтавкаНДС,
	|	ДанныеТабличнойЧасти.СуммаНДС КАК СуммаНДС,
	|	ДанныеТабличнойЧасти.ПроцентСкидки КАК ПроцентСкидки,
	|	ДанныеТабличнойЧасти.Сумма + ДанныеТабличнойЧасти.СуммаСкидки КАК СуммаБезСкидки,
	|	ДанныеТабличнойЧасти.СуммаСкидки КАК Скидка,
	|	ДанныеТабличнойЧасти.Сумма - ДанныеТабличнойЧасти.СуммаНДС КАК СуммаБезНДС,
	|	ДанныеТабличнойЧасти.Сумма КАК СуммаСНДС,
	|	ДанныеТабличнойЧасти.ЕдиницаИзмерения.Код КАК ЕдиницаИзмеренияКод
	|ИЗ
	|	Документ.Монтаж.ТоварыУслуги КАК ДанныеТабличнойЧасти
	|ГДЕ
	|	ДанныеТабличнойЧасти.Ссылка В(&МассивОбъектов)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДанныеТабличнойЧасти.Ссылка,
	|	ДанныеТабличнойЧасти.НомерСтроки
	|ИТОГИ ПО
	|	Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
    |ВЫБРАТЬ РАЗРЕШЕННЫЕ
    |	ДанныеТабличнойЧасти.Ссылка КАК Ссылка,
    |	ДанныеТабличнойЧасти.НомерСтроки КАК НомерСтроки,
	|	ДанныеТабличнойЧасти.Номенклатура.Артикул КАК Артикул,
    |	ДанныеТабличнойЧасти.Номенклатура КАК Номенклатура,
    |	ДанныеТабличнойЧасти.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
    |	ДанныеТабличнойЧасти.Количество КАК Количество,
    |	ДанныеТабличнойЧасти.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
    |	ДанныеТабличнойЧасти.Коэффициент КАК Коэффициент,
    |	ДанныеТабличнойЧасти.Комната КАК Комната,
    |	ДанныеТабличнойЧасти.УИСтроки КАК УИСтроки,
    |	ДанныеТабличнойЧасти.НоменклатураТоваров КАК НоменклатураТоваров
    |ИЗ
    |	Документ.Монтаж.Материалы КАК ДанныеТабличнойЧасти
    |ГДЕ
    |	ДанныеТабличнойЧасти.Ссылка В(&МассивОбъектов)
    |
    |УПОРЯДОЧИТЬ ПО
    |	ДанныеТабличнойЧасти.Ссылка,
    |	ДанныеТабличнойЧасти.НомерСтроки
    |ИТОГИ ПО
    |	Ссылка
    |";
	
	МассивРезультатов         = Запрос.ВыполнитьПакет();
	РезультатПоШапке          = МассивРезультатов[0];
	РезультатПоТабличнойЧасти = МассивРезультатов[1];
	РезультатПоТабличнойЧастиМатериалы = МассивРезультатов[2];
	
	СтруктураДанныхДляПечати 	= Новый Структура("РезультатПоШапке, РезультатПоТабличнойЧасти, РезультатПоТабличнойЧастиМатериалы",
	                                               РезультатПоШапке, РезультатПоТабличнойЧасти, РезультатПоТабличнойЧастиМатериалы);
	
	Возврат СтруктураДанныхДляПечати;
    
КонецФункции

Процедура ДополнитьДанныеДляПечатныхФорм(РезультатЗапроса, ВыборкаПоТоварам=Неопределено) Экспорт
	
	КЧ = Новый КвалификаторыЧисла(15, 2);
	Массив = Новый Массив;
	Массив.Добавить(Тип("Число"));
	ОписаниеТиповЧисло15_2 = Новый ОписаниеТипов(Массив, , ,КЧ);

	РезультатЗапроса.Колонки.Добавить("ДатаФормат");
	РезультатЗапроса.Колонки.Добавить("ДатаДокументаФормат");
	
	РезультатЗапроса.Колонки.Добавить("ДатаВыполнения", Новый ОписаниеТипов("Дата"));
	РезультатЗапроса.Колонки.Добавить("ПредставлениеРеквизитов");
	РезультатЗапроса.Колонки.Добавить("ПредставлениеЮридическогоАдреса");
	РезультатЗапроса.Колонки.Добавить("ПаспортПредставление");	
	РезультатЗапроса.Колонки.Добавить("ДатаМонтажаФормат");
	РезультатЗапроса.Колонки.Добавить("ВремяНачалаФормат");
	РезультатЗапроса.Колонки.Добавить("ВремяОкончанияФормат");
	РезультатЗапроса.Колонки.Добавить("ОснованиеДатаФормат");
	РезультатЗапроса.Колонки.Добавить("СуммаНДС", ОписаниеТиповЧисло15_2);
	РезультатЗапроса.Колонки.Добавить("СуммаИтогСкидка", ОписаниеТиповЧисло15_2);
	РезультатЗапроса.Колонки.Добавить("СуммаДокументаБезСкидки");
	РезультатЗапроса.Колонки.Добавить("СуммаОплаченоПоЗаказу");
	РезультатЗапроса.Колонки.Добавить("СуммаПредоплатыПоЗаказу");
	РезультатЗапроса.Колонки.Добавить("СуммаКОплатеОстатокПоЗаказу");	
	РезультатЗапроса.Колонки.Добавить("СуммаКОплатеПоЗаказу");
	РезультатЗапроса.Колонки.Добавить("СуммаОплачено"); 
	РезультатЗапроса.Колонки.Добавить("СуммаПредоплаты"); 			
	РезультатЗапроса.Колонки.Добавить("СуммаКОплатеОстаток"); 
	РезультатЗапроса.Колонки.Добавить("СуммаКОплате");
	РезультатЗапроса.Колонки.Добавить("ПлощадьЗаказа");
	
	РезультатЗапроса.Колонки.Добавить("ИтогоСумма");
	//зультатЗапроса.Колонки.Добавить("ИтогоСуммаНДС"); - есть в запросе
	РезультатЗапроса.Колонки.Добавить("ИтогоСуммаСкидки");
	РезультатЗапроса.Колонки.Добавить("ИтогоСуммаБезСкидки");
	РезультатЗапроса.Колонки.Добавить("ИтоговаяСтрока");
	РезультатЗапроса.Колонки.Добавить("СуммаДокументаПрописью");
	
	РезультатЗапроса.Колонки.Добавить("ЗамерщикКонтактныйТелефон");
	РезультатЗапроса.Колонки.Добавить("ЗамерщикЛичныйТелефон");	 

	РезультатЗапроса.Колонки.Добавить("ДатаПечати");
	РезультатЗапроса.Колонки.Добавить("ВремяФормированияПФ");
	РезультатЗапроса.Колонки.Добавить("ДатаПодписанияДокумента");
	
	ОбщийМодульСервер.ДобавитьКолонкиКонтактнойИнформации(РезультатЗапроса);

	//ДатаПоследнегоПлатежаПоРассрочке = Неопределено;
	
	Для Каждого ТекущаяСтрока Из РезультатЗапроса Цикл
		//Если ТекущаяСтрока.Результат = Справочники.РезультатыМонтажа.Закрыт ИЛИ ТекущаяСтрока.Результат = Справочники.РезультатыМонтажа.Выполнен Тогда
		//	ТекущаяСтрока.ДатаФормат = Формат(ТекущаяСтрока.ДатаДокумента,"ДЛФ=Д");
		//Иначе
		//	ТекущаяСтрока.ДатаФормат = "";
		//КонецЕсли;
		
		//++16953
		Если ТипЗнч(ТекущаяСтрока.Ссылка) = Тип("ДокументСсылка.Монтаж") Тогда
				ТекущаяСтрока.ДатаПодписанияДокумента = ОбщийМодульСервер.ПолучитьДатуПодписанияДокументаМонтажа(ТекущаяСтрока.Ссылка);
			Иначе
				ТекущаяСтрока.ДатаПодписанияДокумента = ТекущаяСтрока.ДатаДокумента;
		КонецЕсли;
		
		//ТекущаяСтрока.ДатаФормат = Формат(ТекущаяСтрока.Дата, "ДЛФ=D; ДП='""___"" ______________ 20____ г.'");
		ТекущаяСтрока.ДатаФормат = Формат(ТекущаяСтрока.ДатаПодписанияДокумента, "ДЛФ=D; ДП='""___"" ______________ 20____ г.'");
		//++16953
		ТекущаяСтрока.ДатаДокументаФормат = Формат(ТекущаяСтрока.ДатаПодписанияДокумента, "ДЛФ=D");
		
		ТекущаяСтрока.ДатаМонтажаФормат = Формат(ТекущаяСтрока.ДатаМонтажаДокумента,"ДЛФ=D");
		Попытка
			ТекущаяСтрока.Номер = ПрефиксацияОбъектовКлиентСервер.НомерНаПечать(ТекущаяСтрока.Номер);
		Исключение
		КонецПопытки;
		Попытка
			ТекущаяСтрока.ОснованиеНомер = ПрефиксацияОбъектовКлиентСервер.НомерНаПечать(ТекущаяСтрока.ОснованиеНомер);
			ТекущаяСтрока.ОснованиеДатаФормат = Формат(ТекущаяСтрока.ОснованиеДатаВремя, "ДЛФ=D");
		Исключение
		КонецПопытки;
		
		//Если ТекущаяСтрока.Результат = Справочники.РезультатыМонтажа.Выполнен ИЛИ ТекущаяСтрока.Результат = Справочники.РезультатыМонтажа.Закрыт Тогда
		//	ТекущаяСтрока.ДатаВыполнения = ТекущаяСтрока.Дата;
		//КонецЕсли;
		
		Попытка	
		    ТекущаяСтрока.ДатаМонтажаФормат = Формат(ТекущаяСтрока.ДатаМонтажа, "ДЛФ=D");
			ТекущаяСтрока.ВремяНачалаФормат = Формат(ТекущаяСтрока.ВремяНачала, "ДЛФ=T");
			ТекущаяСтрока.ВремяОкончанияФормат = Формат(ТекущаяСтрока.ВремяОкончания, "ДЛФ=T");
		Исключение
		КонецПопытки;
		
		Если ТекущаяСтрока.Контрагент.ВидКонтрагента = Перечисления.ВидКонтрагента.ФизЛицо Тогда
			ТекущаяСтрока.ПаспортПредставление = "Документ: " + ТекущаяСтрока.ПаспортВид + " серия: " + ТекущаяСтрока.ПаспортСерия
				+ " номер: " + ТекущаяСтрока.ПаспортНомер + ", выдан: " + ТекущаяСтрока.ПаспортКемВыдан + " " + Формат(ТекущаяСтрока.ПаспортДатаВыдачи,"ДЛФ=Д");
		КонецЕсли;
		
		СведенияОКонтрагенте = ОбщийМодульСервер.СведенияОКонтрагенте(ТекущаяСтрока.Контрагент);
		
		ТекущаяСтрока.ПредставлениеЮридическогоАдреса = ОбщийМодульСервер.ПредставлениеЮридическогоАдреса(СведенияОКонтрагенте.ЮридическийАдрес, (ТекущаяСтрока.Контрагент.ВидКонтрагента = Перечисления.ВидКонтрагента.ЮрЛицо));	
	
		Если ТекущаяСтрока.Контрагент.ВидКонтрагента = Перечисления.ВидКонтрагента.ЮрЛицо Тогда
			Сведения = "ИНН, КПП, НомерСчета, Банк, БИК, КоррСчет, ТекстКорреспондента";
			ТекущаяСтрока.ПредставлениеРеквизитов = ОбщийМодульСервер.ОписаниеОрганизации(СведенияОКонтрагенте, Сведения); 
		Иначе
			Сведения = "ИНН";
			ПредставлениеРеквизитов = ОбщийМодульСервер.ОписаниеОрганизации(СведенияОКонтрагенте, Сведения);
			Если НЕ ПустаяСтрока(ТекущаяСтрока.ПаспортПредставление) Тогда		
				ПредставлениеРеквизитов = ПредставлениеРеквизитов + ?(ПустаяСтрока(ПредставлениеРеквизитов), "", ", ") + ТекущаяСтрока.ПаспортПредставление;
			КонецЕсли;
			ТекущаяСтрока.ПредставлениеРеквизитов = ПредставлениеРеквизитов;
		КонецЕсли;
		
		ТекущаяСтрока.СуммаНДС = ТекущаяСтрока.Ссылка.ТоварыУслуги.Итог("СуммаНДС");
		ТекущаяСтрока.ИтогоСуммаНДС = ТекущаяСтрока.Ссылка.ТоварыУслуги.Итог("СуммаНДС");
		ТекущаяСтрока.ИтогоСумма = ТекущаяСтрока.Ссылка.ТоварыУслуги.Итог("Сумма");
		
		ТекущаяСтрока.СуммаИтогСкидка = ТекущаяСтрока.Ссылка.ТоварыУслуги.Итог("СуммаСкидки");
		ТекущаяСтрока.ИтогоСуммаСкидки = ТекущаяСтрока.СуммаИтогСкидка;
		ТекущаяСтрока.СуммаДокументаБезСкидки = ТекущаяСтрока.СуммаДокумента + ТекущаяСтрока.СуммаИтогСкидка;
		
		ТекущаяСтрока.ИтогоСуммаБезСкидки = ТекущаяСтрока.ИтогоСумма + ТекущаяСтрока.ИтогоСуммаСкидки;
		
		ТекущаяСтрока.СуммаДокументаПрописью = РаботаСВалютой.СформироватьЧислоПрописью(ТекущаяСтрока.СуммаДокумента, ТекущаяСтрока.Валюта, Ложь);
		
		Попытка
			ПлощадьЗаказа = 0;
			Для Каждого ПодСтрока Из ТекущаяСтрока.Ссылка.ТоварыУслуги Цикл
				Если ПодСтрока.Номенклатура.ВидНоменклатуры = Справочники.ВидыНоменклатуры.Потолок Тогда
					ПлощадьЗаказа = ПлощадьЗаказа + ПодСтрока.Количество;
				КонецЕсли;
			КонецЦикла;
			ТекущаяСтрока.ПлощадьЗаказа = ПлощадьЗаказа;
		Исключение
		КонецПопытки;
		
		ТекущаяСтрока.СуммаОплаченоПоЗаказу = ПолучитьСуммуОплат(ТекущаяСтрока.Основание); 	
		ТекущаяСтрока.СуммаПредоплатыПоЗаказу = ПолучитьСуммуОплат(ТекущаяСтрока.Основание, ТекущаяСтрока.ДатаВыполнения);
		
		ТекущаяСтрока.СуммаКОплатеОстатокПоЗаказу = ТекущаяСтрока.ОснованиеСуммаДокумента - ТекущаяСтрока.СуммаОплаченоПоЗаказу;
		ТекущаяСтрока.СуммаКОплатеПоЗаказу = ТекущаяСтрока.ОснованиеСуммаДокумента - ТекущаяСтрока.СуммаПредоплатыПоЗаказу;
		
		Попытка
			ТекущаяСтрока.СуммаОплачено = ПолучитьСуммуОплат(ТекущаяСтрока.Ссылка);
			ТекущаяСтрока.СуммаПредоплаты = ПолучитьСуммуОплат(ТекущаяСтрока.Ссылка, ТекущаяСтрока.ДатаВыполнения);	
			
			ТекущаяСтрока.СуммаКОплатеОстаток = ТекущаяСтрока.СуммаДокумента - ТекущаяСтрока.СуммаОплачено;
			ТекущаяСтрока.СуммаКОплате = ТекущаяСтрока.СуммаДокумента - ТекущаяСтрока.СуммаПредоплаты;
		Исключение
		КонецПопытки;
		
		ТекущаяСтрока.ИтоговаяСтрока = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru='Всего наименований %1, на сумму %2 %3'"),
			ТекущаяСтрока.Ссылка.ТоварыУслуги.Количество(),
			Формат(ТекущаяСтрока.СуммаДокумента, "ЧДЦ=2"),
			ТекущаяСтрока.Валюта);
			
		ТекущаяСтрока.ДатаПечати = Формат(ТекущаяДатаСеанса(), "ДЛФ=Д");
		
		Если ЗначениеЗаполнено(ТекущаяСтрока.ОснованиеИсполнительЗамера) Тогда		
			ТекущаяСтрока.ЗамерщикКонтактныйТелефон = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(ТекущаяСтрока.ОснованиеИсполнительЗамера, Справочники.ВидыКонтактнойИнформации.ТелефонСотрудника);
			ТекущаяСтрока.ЗамерщикЛичныйТелефон     = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(ТекущаяСтрока.ОснованиеИсполнительЗамера, Справочники.ВидыКонтактнойИнформации.ЛичныйТелефонСотрудника);
		КонецЕсли;
		
		ОбщийМодульСервер.ДополнитьДанныеДляПечатныхФормКонтактнойИнформацией(ТекущаяСтрока, ТекущаяСтрока.Организация, ТекущаяСтрока.Контрагент);
		
		ТекущаяСтрока.ДатаПечати = Формат(ТекущаяДатаСеанса(), "ДЛФ=Д");
		ТекущаяСтрока.ВремяФормированияПФ = ТекущаяДатаСеанса();
		
	КонецЦикла;
	
КонецПроцедуры

Функция ПечатьАктаВыполненныхРабот(МассивОбъектов, ОбъектыПечати, ПересчетЦеныПоСкидке = Ложь, СБланкомОПлаты = Ложь)
	
	Возврат ОбщийМодульСервер.ПечатьРозницаАктВыполненныхРабот(МассивОбъектов, ОбъектыПечати, ПересчетЦеныПоСкидке, СБланкомОПлаты);
	
	//// Создаем табличный документ и устанавливаем имя параметров печати.
