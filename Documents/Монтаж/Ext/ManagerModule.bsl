// #14160  
Функция ПечатьВыработкиИсполнителей(МассивОбъектов, ОбъектыПечати)
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.АвтоМасштаб         = Истина; 
	ТабличныйДокумент.ИмяПараметровПечати = "ПараметрыПечати_ВыработкаИсполнителей";
	Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.Монтаж.ПФ_MXL_ВыработкаИсполнителей");
	
	МенеджерОбъекта = Документы.Монтаж;
	
	СтруктураДанныхДляПечати = МенеджерОбъекта.ПолучитьДанныеДляПечатныхФорм(МассивОбъектов);
	ТаблицаДанныеПечати      = СтруктураДанныхДляПечати.РезультатПоШапке.Выгрузить();
	МенеджерОбъекта.ДополнитьДанныеДляПечатныхФорм(ТаблицаДанныеПечати);

	ПервыйДокумент = Истина;
	Для каждого ДанныеПечати из ТаблицаДанныеПечати Цикл
	    Если Не ПервыйДокумент Тогда
	        // Все документы нужно выводить на разных страницах.
	        ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
	    КонецЕсли;
	    ПервыйДокумент = Ложь;
	    // Запомним номер строки, с которой начали выводить текущий документ.
	    НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы + 1;
						
		//заголовок			
		Попытка
			ОбластьМакета = Макет.ПолучитьОбласть("Заголовок");
			ОбластьМакета.Параметры.Заполнить(ДанныеПечати);
			Попытка			
				ТекстЗаголовка = ДанныеПечати.Ссылка.Метаданные().Синоним + " №" + ПрефиксацияОбъектовКлиентСервер.НомерНаПечать(ДанныеПечати.Номер) + " от " + ДанныеПечати.ДатаФормат;
				ОбластьМакета.Параметры.ТекстЗаголовка = ТекстЗаголовка;
			Исключение
			КонецПопытки;
			ТабличныйДокумент.Вывести(ОбластьМакета);
		Исключение
		КонецПопытки;
		
		СтруктураВыработки = ОбщийМодульСервер.ПолучитьТаблицуВыработкиПоМонтажуДляПФ(ДанныеПечати.Ссылка);
		ТаблицаВыработки = СтруктураВыработки.ТаблицаВыработки;

		ТаблицаВыработки.Свернуть("Сотрудник, ВидНачисления, Номенклатура", "Количество, Стоимость");
		
		ЗаголовокТаблицы  = "Выработка по исполнителям";
		Если СтруктураВыработки.Плановая Тогда
			ЗаголовокТаблицы = ЗаголовокТаблицы + " (плановая)";	
		КонецЕсли;
		
		ВыведенаШапка = Ложь;
		СуммаСотрудникИтог = 0;
		СотрудникИтог = Неопределено;
		
		//выводим только исполнителей монтажа
		Для каждого Исполнитель Из ДанныеПечати.Ссылка.Исполнители Цикл
			
			НайденныеСтроки = ТаблицаВыработки.НайтиСтроки(Новый Структура("Сотрудник", Исполнитель.Сотрудник));
			Если НайденныеСтроки.Количество() > 0 Тогда
				Если НЕ ВыведенаШапка Тогда
					ОбластьМакета = Макет.ПолучитьОбласть("ШапкаВыработки");																																
					ЗаполнитьЗначенияСвойств(ОбластьМакета.Параметры, ДанныеПечати);
					ОбластьМакета.Параметры.ЗаголовокТаблицы = ЗаголовокТаблицы;
					ТабличныйДокумент.Вывести(ОбластьМакета);
					ВыведенаШапка = Истина;
				КонецЕсли;
				
				СуммаСотрудникИтог = 0;
				Для каждого НайденнаяСтрока Из НайденныеСтроки Цикл
					ОбластьМакета = Макет.ПолучитьОбласть("СтрокаВыработки");
					ЗаполнитьЗначенияСвойств(ОбластьМакета.Параметры, НайденнаяСтрока);
					ТабличныйДокумент.Вывести(ОбластьМакета);
					СуммаСотрудникИтог = СуммаСотрудникИтог + НайденнаяСтрока.Стоимость;
				КонецЦикла;
				Попытка
					ОбластьМакета = Макет.ПолучитьОбласть("СтрокаВыработкиИтог");
					ОбластьМакета.Параметры.Стоимость = СуммаСотрудникИтог;
					ТабличныйДокумент.Вывести(ОбластьМакета);							
				Исключение							
				КонецПопытки;
			КонецЕсли;
		КонецЦикла;
		
		Если ВыведенаШапка Тогда
			ОбластьМакета = Макет.ПолучитьОбласть("ИтогоВыработки");
			ЗаполнитьЗначенияСвойств(ОбластьМакета.Параметры, ДанныеПечати);
			ТабличныйДокумент.Вывести(ОбластьМакета);
		КонецЕсли;	
	
		// В табличном документе необходимо задать имя области, в которую был 
	    // выведен объект. Нужно для возможности печати комплектов документов.
	    УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабличныйДокумент, НомерСтрокиНачало, ОбъектыПечати, ДанныеПечати.Ссылка);
		
	КонецЦикла;
			
	Возврат ТабличныйДокумент;
	
КонецФункции

#КонецОбласти

Процедура ПодготовитьТаблицуСписанияМатериалыИТовары(Знач Организация, Знач Материалы, Знач ТоварыУслуги, Знач Дата, Знач Склад, пТаблицаСписанияМатериалы = Неопределено, пТаблицаСписанияТовары = Неопределено,
	пСебестоимостьПотолков, пСебестоимостьТоваров)
	
	ОрганизацияТоваров = Организация;
	Если Константы.ОбщиеСклады.Получить() Тогда
		ОрганизацияТоваров = Справочники.Организации.ПустаяСсылка();
	КонецЕсли;
	
	пСебестоимостьПотолков = 0;
	пСебестоимостьТоваров = 0;												 
	пМонтажКакРеализация = Истина; //Константы.МонтажКакРеализация.Получить();
	пКоличествоТоваровКСписаниюВМонтажеНеСоответствуетКоличествуПроданногоТовара = Константы.КоличествоТоваровКСписаниюВМонтажеНеСоответствуетКоличествуПроданногоТовара.Получить();
	пДатаДвижения = Дата;
	
	Если ТипЗнч(Материалы) = Тип("ТаблицаЗначений") Тогда
		//таблица значений
		пТаблицаСписанияМатериалы = Материалы.Скопировать();
	Иначе
		//табличная часть
		пТаблицаСписанияМатериалы = Материалы.Выгрузить();
	КонецЕсли;
	пТаблицаСписанияМатериалы.Очистить();
	Для Каждого ТекущаяСтрока Из Материалы Цикл
		Если НЕ ТекущаяСтрока.Номенклатура.ВидНоменклатуры = Справочники.ВидыНоменклатуры.Услуга Тогда
			НоваяСтрока = пТаблицаСписанияМатериалы.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущаяСтрока);
		КонецЕсли;
	КонецЦикла;
	
	Если НЕ пТаблицаСписанияМатериалы.Количество() = 0 Тогда
		Для Каждого Товар Из пТаблицаСписанияМатериалы Цикл
			сКоличество = Товар.Количество * Товар.Коэффициент;				
			сСумма = сКоличество * РегистрыНакопления.ТоварыНаСкладах.ПолучитьСебестоимостьНоменклатурыОрганизации(пДатаДвижения, ОрганизацияТоваров, Товар.Номенклатура, Склад, Товар.ХарактеристикаНоменклатуры, Товар.СерияНоменклатуры); 
			Если Товар.Номенклатура.ВидНоменклатуры = Справочники.ВидыНоменклатуры.Материал
				или Товар.Номенклатура.ВидНоменклатуры = Справочники.ВидыНоменклатуры.Полотно Тогда
				пСебестоимостьПотолков = пСебестоимостьПотолков + сСумма;
			Иначе
				пСебестоимостьТоваров = пСебестоимостьТоваров + сСумма;
			КонецЕсли;
			
		КонецЦикла;
	КонецЕсли;
	
	
	//товары
	Если пМонтажКакРеализация Тогда
		Если ТипЗнч(ТоварыУслуги) = Тип("ТаблицаЗначений") Тогда
			//таблица значений
			пТаблицаСписанияТовары = ТоварыУслуги.Скопировать();
		Иначе
			//табличная часть
			пТаблицаСписанияТовары = ТоварыУслуги.Выгрузить();
		КонецЕсли;
		пТаблицаСписанияТовары.Очистить();
		Для Каждого ТекущаяСтрока Из ТоварыУслуги Цикл
			Если НЕ ТекущаяСтрока.Номенклатура.ВидНоменклатуры = Справочники.ВидыНоменклатуры.Услуга Тогда
				НоваяСтрока = пТаблицаСписанияТовары.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущаяСтрока);
				Если пКоличествоТоваровКСписаниюВМонтажеНеСоответствуетКоличествуПроданногоТовара Тогда
					НоваяСтрока.Количество = ТекущаяСтрока.КоличествоКСписанию;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		
		Если НЕ пТаблицаСписанияТовары.Количество() = 0 Тогда
			Для Каждого Товар Из пТаблицаСписанияТовары Цикл
				сКоличество = Товар.Количество * Товар.Коэффициент;
				сСумма = сКоличество * РегистрыНакопления.ТоварыНаСкладах.ПолучитьСебестоимостьНоменклатурыОрганизации(пДатаДвижения, ОрганизацияТоваров, Товар.Номенклатура, Склад, Товар.ХарактеристикаНоменклатуры, Товар.СерияНоменклатуры); 
				Если Товар.Номенклатура.ВидНоменклатуры = Справочники.ВидыНоменклатуры.Материал
					или Товар.Номенклатура.ВидНоменклатуры = Справочники.ВидыНоменклатуры.Полотно Тогда
					пСебестоимостьПотолков = пСебестоимостьПотолков + сСумма;
				Иначе
					пСебестоимостьТоваров = пСебестоимостьТоваров + сСумма;
				КонецЕсли;
				
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьСуммуОплат(ДокументСсылка, ДатаОстатка = Неопределено)

	// если дата не найдена, берем все по текущую дату
	ДатаОстатка = ?(ЗначениеЗаполнено(ДатаОстатка), ДатаОстатка, КонецДня(ТекущаяДатаСеанса()));  
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	РасчетыПоЗаказамОбороты.СуммаРасход КАК СуммаРасход
	|ИЗ
	|	РегистрНакопления.РасчетыПоЗаказам.Обороты(, &Дата, , Заказ = &Заказ) КАК РасчетыПоЗаказамОбороты";
	
	Запрос.УстановитьПараметр("Заказ", ДокументСсылка);
	Запрос.УстановитьПараметр("Дата",  ДатаОстатка);
	
	РезультатЗапроса = Запрос.Выполнить();	
	Выборка = РезультатЗапроса.Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.СуммаРасход;
	КонецЕсли;
	
	Возврат 0;	
	
КонецФункции

