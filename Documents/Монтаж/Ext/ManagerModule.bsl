Функция СформироватьОписаниеБригадHTML(ФильтрТочкаПродаж) Экспорт
	
	ОписаниеБригадHTMLНачало = 
	"<!DOCTYPE html>
	|  <html lang='ru'>
	|    <head>
	|      <meta charset='utf-8'>
	|  <style>
	|  table {
	|    font-family: ""Arial"", Sans-Serif;
	|  	font-size: 14px;
	|  	color: #666666;
	|  	border-collapse: collapse;
	|  }
	|  th, td {
	|  	background: #FFEF9C;
	|  	color: #635129;
	|  	padding: 10px 20px;
	|  }
	|  td {
	|  	border-style: solid;
	|  	border-width: 0 1px 1px 0;
	|  	border-color: white;
	|    padding: 5px 5px;
	|  }
	|  td {
	|  	background: #F7F3DE;
	|  }
	|  a {
	|  	color: #635129;
	|  }
	|  </style>
	|    
	|    </head>
	|  <body>
	|    <table>
	|    <tr>
	|      <th>Бригада</th>
	|      <th>Описание бригады </th>
	|  
	|      </tr>";

	ОписаниеБригад = МодульОтчетов.ПолучитьТаблицуБригад(ФильтрТочкаПродаж);
	
	ОписаниеБригадHTMLПродолжение = "";
	Если ОписаниеБригад.Количество() >0 Тогда
		Для каждого СтрокаБригады из ОписаниеБригад Цикл
			Если НЕ ПустаяСтрока(СтрокаБригады.Описание) Тогда
				СсылкаНаЭлемент = ЗначениеВСтрокуВнутр(СтрокаБригады.Бригада);
				ОписаниеБригадHTMLПродолжение = ОписаниеБригадHTMLПродолжение +
				"     <tr>
				|      <td><a href = v8:" + СсылкаНаЭлемент + ">" + СтрокаБригады.Бригада + "</a></td>
				|      <td>" + СтрЗаменить(СтрокаБригады.Описание, Символы.ПС, "<br>") + "</td>
				|     </tr>";
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;

	ОписаниеБригадHTMLПродолжение = ОписаниеБригадHTMLПродолжение +
	"</table></body></html>";
	
	ОписаниеБригадHTML = ОписаниеБригадHTMLНачало + ОписаниеБригадHTMLПродолжение;
	
	Возврат ОписаниеБригадHTML;
	
КонецФункции	

