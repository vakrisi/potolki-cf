#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ОбработкаПолученияПолейПредставления(Поля, СтандартнаяОбработка)
	
	//#10806
	Поля.Добавить("ВидОперации");
 	Поля.Добавить("Дата");
	Поля.Добавить("Номер");
	СтандартнаяОбработка = Ложь;
 
КонецПроцедуры

Процедура ОбработкаПолученияПредставления(Данные, Представление, СтандартнаяОбработка)
	
	//#10806
	СтандартнаяОбработка = Ложь;
	
	СоответствиеПредставлений = Новый Соответствие;
	СоответствиеПредставлений.Вставить(Справочники.ВидыМонтажа.ПустаяСсылка(), "Монтаж");
	СоответствиеПредставлений.Вставить(Справочники.ВидыМонтажа.Монтаж, "Реализация клиенту (монтаж)");
	СоответствиеПредставлений.Вставить(Справочники.ВидыМонтажа.Продажа, "Реализация клиенту (продажа)");
	СоответствиеПредставлений.Вставить(Справочники.ВидыМонтажа.Рекламация, "Реализация клиенту (рекламация)");
	СоответствиеПредставлений.Вставить(Справочники.ВидыМонтажа.СервиснаяЗаявка, "Реализация клиенту (сервисная заявка)");

    Представление = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
        НСтр("ru = '%1 №%2 от %3'"),
        СоответствиеПредставлений.Получить(Данные.ВидОперации),
        Данные.Номер,
        Данные.Дата // №12802 дату выводим с временем, было: Формат(Данные.Дата, "ДЛФ=D")
	);
		
КонецПроцедуры

#КонецОбласти

#Область ПечатьДокумента

// Заполняет список команд печати.
// 
// Параметры:
// КомандыПечати – ТаблицаЗначений – состав полей см. в функции УправлениеПечатью.СоздатьКоллекциюКомандПечати
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт
	
	//Акт выполненных работ
    КомандаПечати = КомандыПечати.Добавить();
    КомандаПечати.МенеджерПечати = "Документ.Монтаж";
    КомандаПечати.Идентификатор = "АктВыполненныхРабот";
    КомандаПечати.Представление = НСтр("ru = 'Акт выполненных работ'");
    КомандаПечати.ПроверкаПроведенияПередПечатью = Истина;
	
	Если ПолучитьФункциональнуюОпцию("ИспользоватьПечатныеФормыМонтажаБезСкидок") Тогда
		КомандаПечати = КомандыПечати.Добавить();
		КомандаПечати.МенеджерПечати = "Документ.Монтаж";
		КомандаПечати.Идентификатор = "АктВыполненныхРабот_ПересчетЦены";
		КомандаПечати.Представление = НСтр("ru = 'Акт выполненных работ (пересчет цены по скидке)'");
		КомандаПечати.ПроверкаПроведенияПередПечатью = Истина;	
	КонецЕсли;
	
	//Акт выполненных работ с бланком оплаты //#14460
	КомандаПечати = КомандыПечати.Добавить();
    КомандаПечати.МенеджерПечати = "Документ.Монтаж";
    КомандаПечати.Идентификатор = "АктВыполненныхРаботСБланкомОплаты";
    КомандаПечати.Представление = НСтр("ru = 'Акт выполненных работ с бланком оплаты'");
    КомандаПечати.ПроверкаПроведенияПередПечатью = Истина;
	
	//Выработка исполнителей талон // #14160
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати = "Документ.Монтаж";
	КомандаПечати.Идентификатор = "ВыработкаИсполнителей";
	КомандаПечати.Представление = НСтр("ru = 'Выработка исполнителей монтажа'");
	КомандаПечати.ПроверкаПроведенияПередПечатью = Истина;
	
	//Гарантийный талон // №6296 перенесен из ЗД
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати = "Документ.Монтаж";
	КомандаПечати.Идентификатор = "ГарантийныйТалон";
	КомандаПечати.Представление = НСтр("ru = 'Гарантийный талон'");
	КомандаПечати.ПроверкаПроведенияПередПечатью = Истина;
	
	//Комплект для монтажников
    КомандаПечати = КомандыПечати.Добавить();
    КомандаПечати.МенеджерПечати = "Документ.Монтаж";
    КомандаПечати.Идентификатор = "КомплектДляМонтажников";
    КомандаПечати.Представление = НСтр("ru = 'Комплект для монтажников'");
    КомандаПечати.ПроверкаПроведенияПередПечатью = Истина;
	Если ПолучитьФункциональнуюОпцию("ИспользоватьПечатныеФормыМонтажаБезСкидок") Тогда
		КомандаПечати = КомандыПечати.Добавить();
		КомандаПечати.МенеджерПечати = "Документ.Монтаж";
		КомандаПечати.Идентификатор = "КомплектДляМонтажников_ПересчетЦены";
		КомандаПечати.Представление = НСтр("ru = 'Комплект для монтажников (пересчет цены по скидке)'");
		КомандаПечати.ПроверкаПроведенияПередПечатью = Истина;	
	КонецЕсли;
	
	//#14602  //#15514 убрано условие проверки настройки
	//Если ПолучитьФункциональнуюОпцию("ЗаполнениеМатериаловРозницы") = 1 Тогда
		КомандаПечати = КомандыПечати.Добавить();
		КомандаПечати.МенеджерПечати = "Документ.Монтаж";
		КомандаПечати.Идентификатор = "Материалы";
		КомандаПечати.Представление = НСтр("ru = 'Материалы'"); 
		КомандаПечати.ЗаголовокФормы = НСтр("ru = 'Материалы'");	
	//КонецЕсли;

	//Счет-фактура	
	КомандаПечати = КомандыПечати.Добавить();
    КомандаПечати.МенеджерПечати = "Документ.Монтаж";
    КомандаПечати.Идентификатор = "СчетФактура";
    КомандаПечати.Представление = НСтр("ru = 'Счет-фактура'");
    КомандаПечати.ПроверкаПроведенияПередПечатью = Истина;
	
	КомандаПечати = КомандыПечати.Добавить();
    КомандаПечати.МенеджерПечати = "Документ.Монтаж";
    КомандаПечати.Идентификатор = "ТоварнаяНакладнаяСУслугами";
    КомандаПечати.Представление = НСтр("ru = 'Товарная накладная с услугами'");
    КомандаПечати.ПроверкаПроведенияПередПечатью = Истина;
	
	КомандаПечати = КомандыПечати.Добавить();
    КомандаПечати.МенеджерПечати = "Документ.Монтаж";
    КомандаПечати.Идентификатор = "ТоварнаяНакладная";
    КомандаПечати.Представление = НСтр("ru = 'Товарная накладная'");
    КомандаПечати.ПроверкаПроведенияПередПечатью = Истина;

	КомандаПечати = КомандыПечати.Добавить();
    КомандаПечати.МенеджерПечати = "Документ.Монтаж";
    КомандаПечати.Идентификатор = "ТОРГ12";
    КомандаПечати.Представление = НСтр("ru = 'ТОРГ-12'");
    КомандаПечати.ПроверкаПроведенияПередПечатью = Истина;
	
	КомандаПечати = КомандыПечати.Добавить();
    КомандаПечати.МенеджерПечати = "Документ.Монтаж";
    КомандаПечати.Идентификатор = "УПД";
    КомандаПечати.Представление = НСтр("ru = 'Универсальный передаточный документ'");
    КомандаПечати.ПроверкаПроведенияПередПечатью = Истина;
		
КонецПроцедуры

// Формирует печатные формы.
//
// Параметры:
// МассивОбъектов – Массив – ссылки на объекты, которые нужно распечатать;
// ПараметрыПечати – Структура – дополнительные настройки печати;
// КоллекцияПечатныхФорм – ТаблицаЗначений – сформированные табличные документы (выходной параметр)
// ОбъектыПечати – СписокЗначений – значение – ссылка на объект;
// представление – имя области, в которой был выведен объект (выходной параметр);
// ПараметрыВывода – Структура – дополнительные параметры сформированных табличных документов (выходной параметр).
//
Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
    Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "АктВыполненныхРабот") Тогда
        УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "АктВыполненныхРабот", НСтр("ru = 'Акт выполненных работ'"), 
				ПечатьАктаВыполненныхРабот(МассивОбъектов, ОбъектыПечати));				
	ИначеЕсли УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "АктВыполненныхРабот_ПересчетЦены") Тогда
        УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "АктВыполненныхРабот_ПересчетЦены", НСтр("ru = 'Акт выполненных работ (пересчет цены по скидке)'"), 
				ПечатьАктаВыполненныхРабот(МассивОбъектов, ОбъектыПечати, Истина));
	ИначеЕсли УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "АктВыполненныхРаботСБланкомОплаты") Тогда
        УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "АктВыполненныхРаботСБланкомОплаты", НСтр("ru = 'Акт выполненных работ с бланком оплаты'"), 
				ПечатьАктаВыполненныхРабот(МассивОбъектов, ОбъектыПечати, Ложь, Истина));							
	ИначеЕсли УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "КомплектДляМонтажников") Тогда
        УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "КомплектДляМонтажников", НСтр("ru = 'Комплект для монтажников'"),
        		ПечатьКомплектДляМонтажников(МассивОбъектов, ОбъектыПечати));				
	ИначеЕсли УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "КомплектДляМонтажников_ПересчетЦены") Тогда
        УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "КомплектДляМонтажников_ПересчетЦены", НСтр("ru = 'Комплект для монтажников (пересчет цены по скидке)'"),
        		ПечатьКомплектДляМонтажников(МассивОбъектов, ОбъектыПечати, Истина));
				
	ИначеЕсли УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "СчетФактура") Тогда
        УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "СчетФактура", НСтр("ru = 'Счет-фактура'"), 
				ПечатьСчетФактуры(МассивОбъектов, ОбъектыПечати));	
		
	ИначеЕсли УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "УПД") Тогда
        УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "УПД", НСтр("ru = 'Универсальный передаточный документ'"), 
				ПечатьУПД(МассивОбъектов, ОбъектыПечати));
				
	ИначеЕсли УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ТОРГ12") Тогда
        УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "ТОРГ12", НСтр("ru = 'ТОРГ-12'"), 
				ПечатьТОРГ12(МассивОбъектов, ОбъектыПечати));
		
	ИначеЕсли УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ТоварнаяНакладная") Тогда
        УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "ТоварнаяНакладная", НСтр("ru = 'Товарная накладная'"),
				ПечатьТоварнойНакладной(МассивОбъектов, ОбъектыПечати));
		
	ИначеЕсли УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ТоварнаяНакладнаяСУслугами") Тогда
        УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "ТоварнаяНакладнаяСУслугами", НСтр("ru = 'Товарная накладная с услугами'"), 
				ПечатьТоварнойНакладной(МассивОбъектов, ОбъектыПечати, Истина));
				
	ИначеЕсли УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ГарантийныйТалон") Тогда // №6296 перенесен из ЗД
        УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
        КоллекцияПечатныхФорм,
        "ГарантийныйТалон",
        НСтр("ru = 'Гарантийный талон'"),
        ПечатьГарантийныйТалон(МассивОбъектов, ОбъектыПечати),
        ,
        "Документ.Монтаж.ПФ_MXL_ГарантийныйТалон");
		
	ИначеЕсли УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ВыработкаИсполнителей") Тогда
        УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "ВыработкаИсполнителей", НСтр("ru = 'Выработка исполнителей'"), 
				ПечатьВыработкиИсполнителей(МассивОбъектов, ОбъектыПечати));
				
	ИначеЕсли УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "Материалы") Тогда
        УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "Материалы", НСтр("ru = 'Материалы'"),
        	ОбщийМодульСервер.ПечатьРозницаМатериалы(МассивОбъектов, ОбъектыПечати, "Документ.Монтаж.ПФ_MXL_Материалы"));
			
    КонецЕсли;
	
КонецПроцедуры

// делаем экспортную для возможности использования во внешних печатных формах
Функция ПолучитьТекстЗапросаДляПечати() Экспорт
	
	Возврат 
	 "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	 |	Монтаж.Ссылка КАК Ссылка,
	 |	Монтаж.Номер КАК Номер,
	 |	Монтаж.Дата КАК ДатаДокумента,
	 |	""текстовая строка"" КАК Дата,
	 |	Монтаж.Дата КАК Дата1,
	 |	Монтаж.Проведен КАК Проведен,
	 |	Монтаж.Организация.ПолноеНаименование КАК Организация,
	 |	Монтаж.Организация.ЯвляетсяПлательщикомНДС КАК ЯвляетсяПлательщикомНДС,
	 |	Монтаж.Бригада КАК Бригада,
	 |	Монтаж.Бригадир КАК Бригадир,
	 |	Монтаж.Контрагент КАК Контрагент,
	 |	ВЫБОР
	 |		КОГДА НЕ Монтаж.Контрагент.НаименованиеПолное = """"
	 |			ТОГДА Монтаж.Контрагент.НаименованиеПолное
	 |		ИНАЧЕ Монтаж.Контрагент.Наименование
	 |	КОНЕЦ КАК ПредставлениеКонтрагента,
	 |	Монтаж.Адрес КАК Адрес,
	 |	Монтаж.ДатаМонтажа КАК ДатаМонтажаДокумента,
	 |	""текстовая строка"" КАК ДатаМонтажа,
	 |	0 КАК СуммаОплачено,
	 |	0 КАК СуммаПредоплаты,
	 |	0 КАК СуммаКОплате,
	 |	0 КАК СуммаКОплатеОстаток,
	 |	0 КАК СуммаОплаченоПоЗаказу,
	 |	0 КАК СуммаПредоплатыПоЗаказу,
	 |	0 КАК СуммаКОплатеПоЗаказу,
	 |	0 КАК СуммаКОплатеОстатокПоЗаказу,
	 |	0 КАК СуммаИтогСкидка,
	 |	0 КАК СуммаДокументаБезСкидки,
	 |	0 КАК ПлощадьЗаказа,
	 |	Монтаж.ВремяНачала КАК ВремяНачала,
	 |	Монтаж.ВремяОкончания КАК ВремяОкончания,
	 |	Монтаж.СрокМонтажа КАК СрокМонтажа,
	 |	""01.01.0001"" КАК ДатаМонтажаФормат,
	 |	""00:00:00"" КАК ВремяНачалаФормат,
	 |	""00:00:00"" КАК ВремяОкончанияФормат,
	 |	ЕСТЬNULL(Монтаж.СуммаДокумента, 0) КАК СуммаДокумента,
	 |	Монтаж.Результат КАК Результат,
	 |	Монтаж.ДоговорКонтрагента КАК ДоговорКонтрагента,
	 |	Монтаж.Склад КАК Склад,
	 |	Монтаж.Основание КАК Основание,
	 |	Монтаж.СкладТоваров КАК СкладТоваров,
	 |	Монтаж.ВидЦен КАК ВидЦен,
	 |	Монтаж.Валюта КАК Валюта,
	 |	Монтаж.КомментарийКМонтажу КАК КомментарийКМонтажу,
	 |	Монтаж.Результат КАК Результат1,
	 |	Монтаж.Исполнители.(
	 |		Ссылка КАК Ссылка,
	 |		НомерСтроки КАК НомерСтроки,
	 |		Сотрудник КАК Сотрудник,
	 |		Коэффициент КАК Коэффициент
	 |	) КАК Исполнители,
	 |	Монтаж.Материалы.(
	 |		Ссылка КАК Ссылка,
	 |		НомерСтроки КАК НомерСтроки,
	 |		Номенклатура.Артикул КАК Артикул,
	 |		Номенклатура КАК Номенклатура,
	 |		ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	 |		СерияНоменклатуры КАК СерияНоменклатуры,
	 |		Номенклатура.ВидНоменклатуры КАК ВидНоменклатуры,
	 |		ЕдиницаИзмерения КАК ЕдиницаИзмерения,
