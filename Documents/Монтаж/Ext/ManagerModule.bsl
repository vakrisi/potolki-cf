#Область ПроверкиВводаНаОсновании

Процедура ПроверитьВозможностьВводаНаОсновании(МассивМонтажей, ТипСоздаваемогоДокумента=Неопределено) Экспорт
	
	МассивДокументов = Новый Массив;
	Если НЕ ТипЗнч(МассивМонтажей) = Тип("Массив") Тогда
		МассивДокументов.Добавить(МассивМонтажей);
	Иначе
		МассивДокументов = МассивМонтажей;
	КонецЕсли;
	
	Для каждого ДокументСсылка из МассивДокументов Цикл
		Если ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.Монтаж") Тогда
			Если НЕ ДокументСсылка.Проведен Тогда				
				ТекстОшибки = НСтр("ru='Документ %Документ% не проведен. Ввод на основании разрешен только в проведенном состоянии'");
				ТекстОшибки = СтрЗаменить(ТекстОшибки, "%Документ%", ДокументСсылка);	
				ВызватьИсключение ТекстОшибки;
			КонецЕсли;
			
			//#9168
			Если ДокументСсылка.Бригада.Пустая() Тогда
				Если ТипСоздаваемогоДокумента = Тип("ДокументСсылка.НачислениеЗарплаты") 
					ИЛИ ТипСоздаваемогоДокумента = Тип("ДокументСсылка.Премия")	
					ИЛИ ТипСоздаваемогоДокумента = Тип("ДокументСсылка.Штраф")
					Тогда				
					ТекстОшибки = НСтр("ru='В документе %Документ% не заполнена бригада. Ввод на основании не разрешен'");
					ТекстОшибки = СтрЗаменить(ТекстОшибки, "%Документ%", ДокументСсылка);	
					ВызватьИсключение ТекстОшибки;
				КонецЕсли;			
			КонецЕсли;					
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли
	