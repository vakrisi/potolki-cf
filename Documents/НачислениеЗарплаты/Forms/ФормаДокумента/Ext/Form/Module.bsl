&НаКлиенте
Процедура ОбновитьСуммуИНадписьНачисления()
		
	ОбновитьСуммуКНачислению();	
	ОбновитьНадписьВалюты(); 
	
КонецПроцедуры

//Сумма к начислению высчитывается если валюта во всех строках задана одинаковая. 
//Если хотя бы одна строка отличается - Сумма не выводится.
&НаСервере
Процедура ОбновитьСуммуКНачислению()
	
	//Проверим, все ли валюты одинаковы
	Если Объект.Начисление.Количество() = 0 Тогда		
		СуммаКНачислению = 0;
		Возврат;
	КонецЕсли;
		
	//Сравниваем валюты всех строк с валютой первой строки.	
	ВалютаОдинаковая = Истина;
	Для Каждого СтрокаТаблицы из Объект.Начисление Цикл
		Если не СтрокаТаблицы.Валюта = Объект.Начисление[0].Валюта Тогда 
			ВалютаОдинаковая = Ложь;
		КонецЕсли;
	КонецЦикла;
	
	//Если валюты одинаковые, вычисляем сумму и обновляем надпись 
	//если не одинаковые, сумму обнуляем, обработку прирываем
	Если ВалютаОдинаковая Тогда 
		СуммаКНачислению = Объект.Начисление.Итог("Сумма");		
	Иначе				
		СуммаКНачислению = 0;		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьНадписьВалюты()
	Если СуммаКНачислению = 0 Тогда 
		Элементы.СуммаКНачислению.Видимость = Ложь;
		Элементы.ДекорацияВалюта.Заголовок = "";
	Иначе
		Элементы.ДекорацияВалюта.Заголовок = Объект.Начисление[0].Валюта;
		Элементы.СуммаКНачислению.Видимость = Истина;		
	КонецЕсли;  	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьВалютуУчета()
	Возврат Константы.ВалютаУчета.Получить();
КонецФункции

#КонецОбласти

#Область ОбработчикиЭлементовДереваНачислений

&НаКлиенте
Процедура ДеревоНачисленийПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	
	Отказ = Истина;
	
	ТекущиеДанные = Элемент.ТекущиеДанные;
	ПараметрыФормы = Новый Структура("Валюта", ОбщийМодульВызовСервера.ВалютаУчета());
	Если Копирование Тогда
		Если ТекущиеДанные = Неопределено Тогда
			//
		ИначеЕсли ТекущиеДанные.Уровень = 1 Тогда
			ПараметрыФормы.Вставить("Сотрудник", ТекущиеДанные.Сотрудник);
			
		ИначеЕсли ТекущиеДанные.Уровень = 2 Тогда
			Если ЗначениеЗаполнено(ТекущиеДанные.Валюта) Тогда
				ПараметрыФормы.Вставить("Валюта", ТекущиеДанные.Валюта);
			КонецЕсли;
			Если ГруппировкаПоВидуНачисления Тогда
				ПараметрыФормы.Вставить("ВидНачисления", ТекущиеДанные.ВидНачисления);
				СотрудникЭлемента = ТекущиеДанные.ПолучитьРодителя();
				ПараметрыФормы.Вставить("Сотрудник", СотрудникЭлемента.Сотрудник);
			Иначе
				СотрудникЭлемента = ТекущиеДанные.ПолучитьРодителя();
				ПараметрыФормы.Вставить("Сотрудник", СотрудникЭлемента.Сотрудник);
			КонецЕсли;
			
		ИначеЕсли ТекущиеДанные.Уровень = 3 Тогда
			Если ЗначениеЗаполнено(ТекущиеДанные.Валюта) Тогда
				ПараметрыФормы.Вставить("Валюта", ТекущиеДанные.Валюта);
			КонецЕсли;
			ВидНачисленияЭлемента = ТекущиеДанные.ПолучитьРодителя();
			ПараметрыФормы.Вставить("ВидНачисления", ВидНачисленияЭлемента.ВидНачисления);		
			СотрудникЭлемента = ВидНачисленияЭлемента.ПолучитьРодителя();
			ПараметрыФормы.Вставить("Сотрудник", СотрудникЭлемента.Сотрудник);
			
		КонецЕсли;
	КонецЕсли;
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ДеревоНачисленийПередНачаломДобавленияЗавершение", ЭтотОбъект);
	ОткрытьФорму("Документ.НачислениеЗарплаты.Форма.ФормаДобавленияСтроки", ПараметрыФормы, ЭтотОбъект,,,, ОписаниеОповещения);
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоНачисленийПередНачаломДобавленияЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если НЕ ТипЗнч(Результат) = Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	Модифицированность = Истина;
	
	Валюта = ДополнительныеПараметры;
	
	Если ГруппировкаПоВидуНачисления Тогда
		СтрокаСотрудникДобавление 		= НайтиСтрокуДереваПоЗначениюПоля(ДеревоНачислений, 		 	 "Сотрудник", 	  Результат.Сотрудник, 1);
		СтрокаВидНачисленияДобавление 	= НайтиСтрокуДереваПоЗначениюПоля(СтрокаСотрудникДобавление, 	 "ВидНачисления", Результат.ВидНачисления, 2);
		СтрокаДокументДобавление 	    = НайтиСтрокуДереваПоЗначениюПоля(СтрокаВидНачисленияДобавление, "ОбъектВыработки", Результат.ОбъектВыработки, 3);
	Иначе
	    СтрокаСотрудникДобавление 		= НайтиСтрокуДереваПоЗначениюПоля(ДеревоНачислений, 		 	 "Сотрудник", 	  Результат.Сотрудник, 1);
		//СтрокаДокументДобавление 	    = НайтиСтрокуДереваПоЗначениюПоля(СтрокаСотрудникДобавление, 	 "ОбъектВыработки", Результат.ОбъектВыработки, 2);
		СтрокаДокументДобавление        = СтрокаСотрудникДобавление.ПолучитьЭлементы().Добавить();
		СтрокаДокументДобавление.ОбъектВыработки = Результат.ОбъектВыработки;
		СтрокаДокументДобавление.Уровень = 2;
	КонецЕсли;
	СтрокаДокументДобавление.Сумма  = Результат.Сумма; 
	СтрокаДокументДобавление.Валюта = Результат.Валюта;
	СтрокаДокументДобавление.ВидНачисления = Результат.ВидНачисления;
	
	РассчитатьСуммыСтрокИДокумента();
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоНачисленийПередУдалением(Элемент, Отказ)
	
	ТекущиеДанные = Элемент.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	УровеньУдаляемойСтроки = ТекущиеДанные.Уровень;
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоНачисленийПослеУдаления(Элемент)
	
	ТекущиеДанные = Элемент.Текущиеданные;
	Если ТекущиеДанные = Неопределено Тогда 
		РассчитатьСуммыСтрокИДокумента();
		Возврат;
	КонецЕсли;
	
	УровеньТекущейСтроки = ТекущиеДанные.Уровень; // если 1,2 то удаляем все что выше
	Если УровеньУдаляемойСтроки = УровеньТекущейСтроки Тогда
		РассчитатьСуммыСтрокИДокумента();
		Возврат;		
	КонецЕсли;

	ИдентификаторСтроки = Элемент.ТекущаяСтрока;
	ТекущаяСтрока       = ДеревоНачислений.НайтиПоИдентификатору(ИдентификаторСтроки);	
	
	Если (УровеньТекущейСтроки <= 2 И ГруппировкаПоВидуНачисления)
		ИЛИ (УровеньТекущейСтроки <= 1 И НЕ ГруппировкаПоВидуНачисления) Тогда
		СтрокаРодитель = ТекущиеДанные;
		
		Пока НЕ СтрокаРодитель = Неопределено Цикл
			
			СтрокаРодитель      = ТекущаяСтрока.ПолучитьРодителя();			
			Если СтрокаРодитель = Неопределено Тогда
				ДеревоНачислений.ПолучитьЭлементы().Удалить(ТекущаяСтрока);
			Иначе
				ЭлементыДерева = СтрокаРодитель.ПолучитьЭлементы();
				ЭлементыДерева.Удалить(ТекущаяСтрока);
				ТекущаяСтрока = СтрокаРодитель;
			КонецЕсли;
			
		КонецЦикла;
	КонецЕсли;
	
	РассчитатьСуммыСтрокИДокумента();
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоНачисленийВидНачисленияПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ДеревоНачислений.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда 
		Возврат;
	КонецЕсли;
	
	ЭлементыДокумент = ТекущиеДанные.ПолучитьЭлементы();
	Для Каждого СтрокаДокумент Из ЭлементыДокумент Цикл
		СтрокаДокумент.ВидНачисления = ТекущиеДанные.ВидНачисления;					
	КонецЦикла;
			
КонецПроцедуры

&НаКлиенте
Процедура ДеревоНачисленийСуммаПриИзменении(Элемент)
	РассчитатьСуммыСтрокИДокумента();
КонецПроцедуры

&НаКлиенте
Процедура ДеревоНачисленийВалютаПриИзменении(Элемент)
	РассчитатьСуммыСтрокИДокумента();
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьНачисления(Команда)
	
	//Если Объект.Начисление.Количество() > 0 Тогда
	Если ДеревоНачислений.ПолучитьЭлементы().Количество() > 0 Тогда
		Оповещение = Новый ОписаниеОповещения("ПослеВопросаОбОчисткеДляЗаполненияПоПериоду", ЭтаФорма);
		ПоказатьВопрос(Оповещение, "Перед заполнением табличная часть будет очищена, продолжить?", РежимДиалогаВопрос.ДаНет);	
	Иначе
	    ОткрытьФормуЗаполненияНачисления();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВопросаОбОчисткеДляЗаполненияПоПериоду(Результат, ДополнительныеПараметры) Экспорт
	
    Если Результат = КодВозвратаДиалога.Да Тогда
        ОткрытьФормуЗаполненияНачисления();
    КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуЗаполненияНачисления()
	
	Объект.Начисление.Очистить();
	
	ПараметрыФормы = Новый Структура("ПериодРегистрации", Объект.ПериодРегистрации);
	ОписаниеОповещения = новый ОписаниеОповещения("ПослеЗакрытияФормыЗаполнить", ЭтотОбъект);
	ОткрытьФорму("Документ.НачислениеЗарплаты.Форма.ФормаЗаполненияНачисления", ПараметрыФормы, ЭтотОбъект,,,, ОписаниеОповещения);
	
КонецПроцедуры	

&НаКлиенте
Процедура ПослеЗакрытияФормыЗаполнить(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат <> Неопределено Тогда
		ЗаполнитьНачисленияНаСервере(Результат.ТипНачисления, Результат.ДатаС, Результат.ДатаПо);
		РассчитатьСуммыСтрокИДокумента();
		Модифицированность = Истина;
	КонецЕсли;
	
КонецПроцедуры	

&НаСервере
Процедура ЗаполнитьНачисленияНаСервере(ТипНачисления, ДатаС, ДатаПо)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Выработка.Сотрудник КАК Сотрудник,
	|	Выработка.ВидНачисления КАК ВидНачисления,
	|	Выработка.СтоимостьОборот КАК Сумма,
	//#7426
	|	Выработка.ОбъектВыработки КАК ОбъектВыработки
	|ПОМЕСТИТЬ ВТ_Выработка
	|ИЗ
	|	РегистрНакопления.ВыработкаИсполнителейРозницы.Обороты(&НачалоПериода, &КонецПериода, , ) КАК Выработка
	|ГДЕ
	|	&ТипНачисления = 1
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Выработка.Сотрудник,
	|	Выработка.ВидНачисления,
	|	Выработка.СтоимостьОборот,
	//#7426
	|	Выработка.ОбъектВыработки
	|ИЗ
	|	РегистрНакопления.ВыработкаИсполнителейПроизводства.Обороты(&НачалоПериода, &КонецПериода, , ) КАК Выработка
	|ГДЕ
	|	&ТипНачисления = 0
	|
	//++ №14125 комментируем, т.к. регистр больше не используется
	//|ОБЪЕДИНИТЬ ВСЕ
	//|
	//|ВЫБРАТЬ
	//|	Выработка.Сотрудник,
	//|	ЗНАЧЕНИЕ(Справочник.ВидыНачислений.ШтрафЗаБрак),
	//|	-Выработка.СуммаОборот,
	////#7426
	//|	Выработка.Регистратор
	//|ИЗ
	//|	РегистрНакопления.ОтветственностьЗаБракиНаПроизводстве.Обороты(&НачалоПериода, &КонецПериода, Регистратор, ) КАК Выработка
	//|ГДЕ
	//|	&ТипНачисления = 0
	//-- №14125
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВТ_Выработка.Сотрудник КАК Сотрудник,
	|	ВТ_Выработка.ВидНачисления КАК ВидНачисления,
	|	ВТ_Выработка.ОбъектВыработки КАК ОбъектВыработки,
	|	СУММА(ВТ_Выработка.Сумма) КАК Сумма
	|ИЗ
	|	ВТ_Выработка КАК ВТ_Выработка
	//++ #7426
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.НачислениеЗарплаты.Начисление КАК НачисленоРанее
	|		ПО (НачисленоРанее.Ссылка.Проведен)
	|			И (НачисленоРанее.Ссылка.ПериодРегистрации = &ПериодРегистрации)
	|			И (НачисленоРанее.Сотрудник = ВТ_Выработка.Сотрудник)
	|			И (НачисленоРанее.ВидНачисления = ВТ_Выработка.ВидНачисления)
	|			И (НачисленоРанее.ОбъектВыработки = ВТ_Выработка.ОбъектВыработки)
	|ГДЕ
	|	НачисленоРанее.Ссылка ЕСТЬ NULL ИЛИ &ПериодРегистрации = НЕОПРЕДЕЛЕНО
	//-- #7426
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_Выработка.Сотрудник,
	|	ВТ_Выработка.ВидНачисления,
	|	ВТ_Выработка.ОбъектВыработки
	|
	|УПОРЯДОЧИТЬ ПО
	|	ВТ_Выработка.Сотрудник,
	|	ВТ_Выработка.ВидНачисления";
	
	Запрос.УстановитьПараметр("ТипНачисления", ТипНачисления);
	Если Константы.ОтражатьДвиженияПоРасчетуСПерсоналомПоПериодуРегистрации.Получить() Тогда
		Запрос.УстановитьПараметр("ПериодРегистрации", Объект.ПериодРегистрации);
	Иначе
		Запрос.УстановитьПараметр("ПериодРегистрации", Неопределено);
	КонецЕсли;
	Запрос.УстановитьПараметр("НачалоПериода", НачалоДня(ДатаС));
	Запрос.УстановитьПараметр("КонецПериода",  КонецДня(ДатаПо));
		
	Выборка = Запрос.Выполнить().Выбрать();
	ВалютаУчета = ПолучитьФункциональнуюОпцию("ВалютаУчета");
		
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = Объект.Начисление.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		НоваяСтрока.Валюта = ВалютаУчета;
	КонецЦикла;
	
	ЗагрузитьТабличнуюЧастьВДерево();
	
КонецПроцедуры	

&НаКлиенте
Процедура ГруппировкаПоВидуНачисления(Команда)
	ГруппировкаПоВидуНачисленияНаСервере();
КонецПроцедуры

&НаСервере
Процедура ГруппировкаПоВидуНачисленияНаСервере()
	
	ПоместитьНачисленияВТабличнуюЧасть(Объект);
	
	ГруппировкаПоВидуНачисления = НЕ ГруппировкаПоВидуНачисления;
	Элементы.ДеревоНачисленийГруппировкаПоВидуНачисления.Пометка = ГруппировкаПоВидуНачисления;
	ХранилищеОбщихНастроек.Сохранить("ДокументНачислениеЗарплаты", "ГруппировкаПоВидуНачисления", ГруппировкаПоВидуНачисления);
	
	Элементы.ДеревоНачисленийВидНачисления.Видимость  = ГруппировкаПоВидуНачисления;
	Элементы.ДеревоНачисленийВидНачисления1.Видимость = НЕ ГруппировкаПоВидуНачисления;
		
	ЗагрузитьТабличнуюЧастьВДерево();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыДеревоНачислений

&НаСервере
Процедура ЗагрузитьТабличнуюЧастьВДерево()
	
	ТаблицаНачислений = Объект.Начисление.Выгрузить();
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТаблицаНачислений", ТаблицаНачислений);
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТаблицаНачислений.Сотрудник КАК Сотрудник,
	|	ТаблицаНачислений.ВидНачисления КАК ВидНачисления,
	|	ТаблицаНачислений.Валюта КАК Валюта,
	|	ТаблицаНачислений.ОбъектВыработки КАК ОбъектВыработки,
	|	ТаблицаНачислений.Сумма КАК Сумма
	|ПОМЕСТИТЬ ВТ_ТаблицаНачислений
	|ИЗ
	|	&ТаблицаНачислений КАК ТаблицаНачислений
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВТ_ТаблицаНачислений.Сотрудник КАК Сотрудник,
	|	ВТ_ТаблицаНачислений.Валюта КАК Валюта,
	|	ВТ_ТаблицаНачислений.ВидНачисления КАК ВидНачисления,
	|	ВТ_ТаблицаНачислений.ОбъектВыработки КАК ОбъектВыработки,
	|	ВТ_ТаблицаНачислений.Сумма КАК Сумма
	|ИЗ
	|	ВТ_ТаблицаНачислений КАК ВТ_ТаблицаНачислений
	|ИТОГИ
	|	СУММА(Сумма)
	|ПО
	|	Сотрудник,
	|	ВидНачисления
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВТ_ТаблицаНачислений.Сотрудник КАК Сотрудник,
	|	ВТ_ТаблицаНачислений.Валюта КАК Валюта,
	|	ВТ_ТаблицаНачислений.ВидНачисления КАК ВидНачисления,
	|	ВТ_ТаблицаНачислений.ОбъектВыработки КАК ОбъектВыработки,
	|	ВТ_ТаблицаНачислений.Сумма КАК Сумма
	|ИЗ
	|	ВТ_ТаблицаНачислений КАК ВТ_ТаблицаНачислений
	|ИТОГИ
	|	СУММА(Сумма)
	|ПО
	|	Сотрудник
	|";
	
	ЭлементыДерева = ДеревоНачислений.ПолучитьЭлементы();
	ЭлементыДерева.Очистить();
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	Если ГруппировкаПоВидуНачисления Тогда
		ВыборкаСотрудников = РезультатЗапроса[1].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаСотрудников.Следующий() Цикл
			СтрокаСотрудник = ЭлементыДерева.Добавить();	
			ЗаполнитьЗначенияСвойств(СтрокаСотрудник, ВыборкаСотрудников, "Сотрудник, Сумма");
			СтрокаСотрудник.Уровень = 1;
			
			ВыборкаВидов = ВыборкаСотрудников.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			ЭлементыСотрудник = СтрокаСотрудник.ПолучитьЭлементы();
			Пока ВыборкаВидов.Следующий() Цикл
				СтрокаВид = ЭлементыСотрудник.Добавить();	
				ЗаполнитьЗначенияСвойств(СтрокаВид, ВыборкаВидов, "ВидНачисления, Сумма");
				СтрокаВид.Уровень = 2;
				
				Выборка = ВыборкаВидов.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
				ЭлементыВид = СтрокаВид.ПолучитьЭлементы();
				Пока Выборка.Следующий() Цикл
					СтрокаДокумент = ЭлементыВид.Добавить();	
					ЗаполнитьЗначенияСвойств(СтрокаДокумент, Выборка, "ОбъектВыработки, ВидНачисления, Сумма, Валюта");
					СтрокаДокумент.Уровень = 3;
				КонецЦикла;
			КонецЦикла;
		КонецЦикла;
		
	Иначе
		ВыборкаСотрудников = РезультатЗапроса[2].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаСотрудников.Следующий() Цикл
			СтрокаСотрудник = ЭлементыДерева.Добавить();	
			ЗаполнитьЗначенияСвойств(СтрокаСотрудник, ВыборкаСотрудников, "Сотрудник, Сумма");
			СтрокаСотрудник.Уровень = 1;
			
			Выборка = ВыборкаСотрудников.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			ЭлементыСотрудник = СтрокаСотрудник.ПолучитьЭлементы();
			Пока Выборка.Следующий() Цикл
				СтрокаДокумент = ЭлементыСотрудник.Добавить();	
				ЗаполнитьЗначенияСвойств(СтрокаДокумент, Выборка, "ОбъектВыработки, ВидНачисления, Сумма, Валюта");
				СтрокаДокумент.Уровень = 2;
			КонецЦикла;
		КонецЦикла;		
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПоместитьНачисленияВТабличнуюЧасть(ТекущийОбъект)
	
	ТекущийОбъект.Начисление.Очистить();
	
	Если ГруппировкаПоВидуНачисления Тогда
		
		ЭлементыСотрудник = ДеревоНачислений.ПолучитьЭлементы();
		Для Каждого СтрокаСотрудник Из ЭлементыСотрудник Цикл		
			ЭлементыВид = СтрокаСотрудник.ПолучитьЭлементы();
			Для Каждого СтрокаВид Из ЭлементыВид Цикл				
				ЭлементыДокумент = СтрокаВид.ПолучитьЭлементы();
				Для Каждого СтрокаДокумент Из ЭлементыДокумент Цикл
					НоваяСтрока = ТекущийОбъект.Начисление.Добавить();
