#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура СоздатьСписаниеСРасчетногоСчета(Команда)
	
	Если Модифицированность ИЛИ НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Сообщить("Документ предварительно должен быть записан!");	
	КонецЕсли;
	
	Если Объект.ЗарплатныйПроект Тогда
		//один документ списание с р/с
		ПараметрыЗаполнения = новый Структура;
		ПараметрыЗаполнения.Вставить("Ссылка", Объект.Ссылка);			
		
		ПараметрыФормы = новый Структура;
		ПараметрыФормы.Вставить("ЗначенияЗаполнения", ПараметрыЗаполнения);
		ОткрытьФорму("Документ.СписаниеСРасчетногоСчета.Форма.ФормаДокумента", ПараметрыФормы, ЭтаФорма);
	Иначе
		//на каждого сотрудника свой документ списание с р/с
		СоздатьСписаниеСРасчетногоСчетаНаСервере();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура СоздатьСписаниеСРасчетногоСчетаНаСервере()
	ВременнаяТаблица = Новый ТаблицаЗначений;
	ВременнаяТаблица.Колонки.Добавить("Сотрудник");	
	ВременнаяТаблица.Колонки.Добавить("Сумма");
	ВременнаяТаблица.Колонки.Добавить("Валюта");
	
	Для Каждого ТекущаяСтрока Из Объект.Начисление Цикл
		НоваяСтрока = ВременнаяТаблица.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущаяСтрока);
	КонецЦикла;
	ВременнаяТаблица.Свернуть("Сотрудник, Валюта", "Сумма");
	
	Для Каждого ТекСотрудник Из ВременнаяТаблица Цикл
		Если ТекСотрудник.Сотрудник.Пустая() Тогда
			Сообщить("В строке " + ТекСотрудник.НомерСтроки + " не заполнен сотрудник, документ списание с р/с для него создан не будет!");
			Продолжить;
		КонецЕсли;	
		НовыйДокумент = Документы.СписаниеСРасчетногоСчета.СоздатьДокумент();
		НовыйДокумент.ВидОперации = Перечисления.ВидыОперацийСписаниеСРасчетногоСчета.ЗарплатаСотруднику;
		НовыйДокумент.Основание = Объект.Ссылка;
		НовыйДокумент.Дата = ТекущаяДатаСеанса();
		НовыйДокумент.Организация = Объект.Организация;
		НовыйДокумент.Подразделение = Объект.Подразделение; // №12857
		НовыйДокумент.Валюта = ТекСотрудник.Валюта;
		НовыйДокумент.Контрагент = ТекСотрудник.Сотрудник;
		НовыйДокумент.СчетКонтрагента = ФинансыСервер.ПолучитьСчетСотрудника(ТекСотрудник.Сотрудник);
		НовыйДокумент.Сумма = ТекСотрудник.Сумма;
		НовыйДокумент.ОчередностьПлатежа = 3;
		НовыйДокумент.ПериодРегистрации = Объект.ПериодРегистрации;
		Попытка
			НовыйДокумент.Записать();
			Сообщить("Создан и записан документ списание с р/с для сотрудника " + ТекСотрудник.Сотрудник);
		Исключение	
			Сообщить(ОписаниеОшибки());
		КонецПопытки;	
	КонецЦикла;	
КонецПроцедуры

