Функция НайтиСтрокуДереваПоЗначениюПоля(Родитель, ИмяПоля, ИскомоеЗначение, Уровень)
	
	ЭлементыДерева = Родитель.ПолучитьЭлементы();
	СтрокаПоиска = Неопределено;
	Для Каждого СтрокаДерева Из ЭлементыДерева Цикл
		Если СтрокаДерева[ИмяПоля] = ИскомоеЗначение Тогда
			СтрокаПоиска = СтрокаДерева;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если СтрокаПоиска = Неопределено Тогда
		СтрокаПоиска = ЭлементыДерева.Добавить();
		СтрокаПоиска[ИмяПоля] = ИскомоеЗначение;
		СтрокаПоиска.Уровень = Уровень;
	КонецЕсли;
	
	Возврат СтрокаПоиска;
	
КонецФункции

