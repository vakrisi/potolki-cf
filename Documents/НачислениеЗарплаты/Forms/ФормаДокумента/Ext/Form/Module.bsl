&НаКлиенте
Процедура ПерезаполнитьПоОснованию(Команда)
	
	Если НЕ ЗначениеЗаполнено(Объект.Основание) Тогда
		ПоказатьПредупреждение(, "Основание документа не указано!");
		Возврат;
	КонецЕсли;
	
	Если ДеревоНачислений.ПолучитьЭлементы().Количество() > 0 Тогда
		Оповещение = Новый ОписаниеОповещения("ПослеВопросаОбОчисткеПерезаполнениеПоОснованию", ЭтаФорма);
		ПоказатьВопрос(Оповещение, "Перед заполнением табличная часть будет очищена, продолжить?", РежимДиалогаВопрос.ДаНет);	
	Иначе
	    ПерезаполнитьПоОснованиюНаСервере();
		РассчитатьСуммыСтрокИДокумента();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВопросаОбОчисткеПерезаполнениеПоОснованию(Результат, ДополнительныеПараметры) Экспорт
	
    Если Результат = КодВозвратаДиалога.Да Тогда
		
		ПерезаполнитьПоОснованиюНаСервере();
		РассчитатьСуммыСтрокИДокумента();
		
    КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ПерезаполнитьПоОснованиюНаСервере()
	
	Объект.Начисление.Очистить();
	
	мОбъект = РеквизитФормыВЗначение("Объект");
	мОбъект.ЗаполнитьТабличнуюЧастьПоРегиструВыработки(мОбъект.Основание);
	
	ЗначениеВРеквизитФормы(мОбъект, "Объект");
	
	ЗагрузитьТабличнуюЧастьВДерево();
	
	Модифицированность = Истина;
	
КонецПроцедуры

