Процедура РассчитатьСуммыСтрокИДокумента() //#15983
	
	СуммаДокумента = 0;
	Если ГруппировкаПоВидуНачисления Тогда
		ЭлементыСотрудник = ДеревоНачислений.ПолучитьЭлементы();
		Для Каждого СтрокаСотрудник Из ЭлементыСотрудник Цикл
			СуммаПоСотруднику = 0;
			ЭлементыВид = СтрокаСотрудник.ПолучитьЭлементы();
			Для Каждого СтрокаВид Из ЭлементыВид Цикл				
				ЭлементыДокумент = СтрокаВид.ПолучитьЭлементы();
				СуммаПоВиду = 0;
				Для Каждого СтрокаДокумент Из ЭлементыДокумент Цикл
					СуммаДокумента      = СуммаДокумента + СтрокаДокумент.Сумма;
					СуммаПоВиду 		= СуммаПоВиду + СтрокаДокумент.Сумма;					
					СуммаПоСотруднику 	= СуммаПоСотруднику + СтрокаДокумент.Сумма;
				КонецЦикла;
				СтрокаВид.Сумма = СуммаПоВиду;
			КонецЦикла;
			СтрокаСотрудник.Сумма = СуммаПоСотруднику;
		КонецЦикла;
	Иначе
		ЭлементыСотрудник = ДеревоНачислений.ПолучитьЭлементы();
		Для Каждого СтрокаСотрудник Из ЭлементыСотрудник Цикл
			СуммаПоСотруднику = 0;				
			ЭлементыДокумент = СтрокаСотрудник.ПолучитьЭлементы();			
			Для Каждого СтрокаДокумент Из ЭлементыДокумент Цикл
				СуммаДокумента      = СуммаДокумента + СтрокаДокумент.Сумма;					
				СуммаПоСотруднику 	= СуммаПоСотруднику + СтрокаДокумент.Сумма;
			КонецЦикла;			
			СтрокаСотрудник.Сумма = СуммаПоСотруднику;
		КонецЦикла;
	КонецЕсли;	
	
	Объект.СуммаДокумента = СуммаДокумента;
	
КонецПроцедуры

