&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("Сотрудник") Тогда
		Сотрудник = Параметры.Сотрудник;
	КонецЕсли;
	
	Если Параметры.Свойство("ВидНачисления") Тогда
		ВидНачисления = Параметры.ВидНачисления;
	КонецЕсли; 
	
	Если Параметры.Свойство("Валюта") Тогда
		Валюта = Параметры.Валюта;
	КонецЕсли;
	
	УправлениеФормой();
	
	// №12788 комментируем ЗаполнитьСуммуНаСервере();

КонецПроцедуры

&НаСервере
Процедура УправлениеФормой()
	
	Элементы.ОбъектВыработки.Доступность = ЗначениеЗаполнено(ВидНачисления);

КонецПроцедуры

&НаКлиенте
Процедура ВидНачисленияПриИзменении(Элемент)
	
	Если НЕ ЗначениеЗаполнено(ВидНачисления) Тогда
		ОбъектВыработки = Неопределено;
	КонецЕсли;
	УправлениеФормой();
	
	// №12788 комментируем ЗаполнитьСуммуНаСервере();
	
КонецПроцедуры

