#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	
	Если ЭтоНовый() Тогда		
		ИнициализироватьСлужебныеРеквизиты();		
	КонецЕсли;
	
	ОбщийМодуль.ЗаполнитьШапкуДокумента(ЭтотОбъект);	
	
	ПериодРегистрации = НачалоМесяца(ТекущаяДатаСеанса());
	
	ТипДанныеЗаполнения = ТипЗнч(ДанныеЗаполнения);
	
	// №1083 раскомментировано
	//#4644 закомментировано
	Если ТипДанныеЗаполнения = Тип("ДокументСсылка.ВыпускПродукции") 
		ИЛИ ТипДанныеЗаполнения = Тип("ДокументСсылка.Лид") 
		ИЛИ ТипДанныеЗаполнения = Тип("ДокументСсылка.Монтаж") 
		ИЛИ ТипДанныеЗаполнения = Тип("ДокументСсылка.ЗаказПокупателя") 
		ИЛИ ТипДанныеЗаполнения = Тип("ДокументСсылка.РеализацияТоваровИУслуг") 
		Тогда
		
		Если ТипДанныеЗаполнения = Тип("ДокументСсылка.Монтаж") Тогда
			Документы.Монтаж.ПроверитьВозможностьВводаНаОсновании(ДанныеЗаполнения, Тип("ДокументСсылка.НачислениеЗарплаты"));
		КонецЕсли;
		
		Организация = ДанныеЗаполнения.Организация;
		Основание = ДанныеЗаполнения;
		Если НЕ ТипДанныеЗаполнения = Тип("ДокументСсылка.Лид") Тогда
			Подразделение = ДанныеЗаполнения.Подразделение;
		КонецЕсли;
		ЗаполнитьТабличнуюЧастьПоРегиструВыработки(ДанныеЗаполнения);
	КонецЕсли;
	
	СтатьяРасходов = ФинансыСервер.ПолучитьСтатьюДоходовРасходов(ЭтотОбъект, , Ложь);
	
	Если ЭтоНовый() Тогда
		ДозаполнитьПоУмолчанию();
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	
	ИнициализироватьСлужебныеРеквизиты(); 
	
	ДозаполнитьПоУмолчанию();
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	ПолеПериодРегистрацииОбязательно = Константы.ОтражатьДвиженияПоРасчетуСПерсоналомПоПериодуРегистрации.Получить();
	
	Если Не ЗначениеЗаполнено(ПериодРегистрации) И ПолеПериодРегистрацииОбязательно Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
         	НСтр("ru = 'Не указан Период регистрации!'"), ,
        	"ОтображениеПериодаРегистрации",,Отказ);	
	КонецЕсли;
		
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	//++ №9919 на основании монтажа запрещено создавать более одного документа начисления
	Если ТипЗнч(Основание) = Тип("ДокументСсылка.Монтаж") И НЕ Основание.Пустая() Тогда
		
		СуществующийДокументНачисления = ОбщийМодульВызовСервера.УжеЕстьДокументНачисленияЗарплатыПоМонтажу(Основание, Ссылка);
		
		Если ЗначениеЗаполнено(СуществующийДокументНачисления) Тогда
			
			Отказ = Истина;
			Сообщить("По документу " + Основание + ", уже существует документ " + СуществующийДокументНачисления + ", запись отменена.");
			
		КонецЕсли;
		
	КонецЕсли;
	//-- №9919
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, Режим)
	
	ВалютаУчета = Константы.ВалютаУчета.Получить();
	ИспользуетсяПериодРегистрации = Константы.ОтражатьДвиженияПоРасчетуСПерсоналомПоПериодуРегистрации.Получить();
	
	// регистр РасчетыСПерсоналом Приход
	Движения.РасчетыСПерсоналом.Записывать = Истина;
	Для Каждого ТекСтрокаНачисление Из Начисление Цикл
		Движение = Движения.РасчетыСПерсоналом.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
		Движение.Период = Дата; //?(НЕ ПериодРегистрацииКакДатаДвижения, Дата, ПериодРегистрации);
		Движение.ПериодРегистрации = ?(ИспользуетсяПериодРегистрации, ПериодРегистрации, Дата(1,1,1));
		Движение.Организация = Организация;
		Движение.Сотрудник = ТекСтрокаНачисление.Сотрудник;
		Движение.ВидНачисления = ТекСтрокаНачисление.ВидНачисления;
		Движение.ОбъектВыработки = ТекСтрокаНачисление.ОбъектВыработки; //#7426
		Движение.Сумма = РаботаСВалютой.ПересчитатьИзВалютыВВалюту(ТекСтрокаНачисление.Валюта, ВалютаУчета, Ссылка.Дата, ТекСтрокаНачисление.Сумма);
	КонецЦикла;
	
	Если НЕ СтатьяРасходов.Пустая() И ПараметрыСеанса.ФинРезультатИспользоватьВедениеУчетаДоходовРасходов Тогда
		Если ПараметрыСеанса.ФинРезультатНеКассовыйМетодВеденияУчетаДоходовРасходов Тогда
			Метод = Перечисления.МетодыВеденияУчетаДоходовРасходов.Некассовый;
			Движения.ДоходыРасходы.Записывать = Истина;			
			Для Каждого ТекущаяСтрока Из Начисление Цикл
				СуммаНачисления = РаботаСВалютой.ПересчитатьИзВалютыВВалюту(ТекущаяСтрока.Валюта, ВалютаУчета, Дата, ТекущаяСтрока.Сумма);
				
				Если СуммаНачисления <> 0 Тогда
					Движение = Движения.ДоходыРасходы.Добавить();
					Движение.Период 		= Дата;
					Движение.Организация 	= Организация;
					Движение.Подразделение 	= Подразделение;
					Движение.Статья 		= СтатьяРасходов;
					Движение.Метод		 	= Метод;
					Движение.СуммаДоходов 	= 0;
					Движение.СуммаРасходов 	= СуммаНачисления;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область Заполнение

Процедура ИнициализироватьСлужебныеРеквизиты()
	
	ЗарплатныйПроект = Константы.ЗарплатныйПроект.Получить();
	СлужебныйИспользоватьНачислениеЗаработнойПлатыНаОснованииМонтажа = ПолучитьФункциональнуюОпцию("ИспользоватьНачислениеЗаработнойПлатыНаОснованииМонтажа");
	
	//#14828
	СозданПриИспользованииПодразделений  = Константы.ИспользоватьПодразделения.Получить();
	
КонецПроцедуры

Процедура ДозаполнитьПоУмолчанию()
	
КонецПроцедуры

//#4644
Процедура ЗаполнитьТабличнуюЧастьПоРегиструВыработки(Основание) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Валюта", Константы.ВалютаУчета.Получить());
	Запрос.УстановитьПараметр("ОбъектВыработки", Основание);
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Выработка.Сотрудник КАК Сотрудник,
	|	Выработка.ВидНачисления КАК ВидНачисления,
	|	Выработка.СтоимостьОборот КАК Сумма,
	|	Выработка.ОбъектВыработки КАК ОбъектВыработки
	|ПОМЕСТИТЬ ВТ_Выработка
	|ИЗ
	|	РегистрНакопления.ВыработкаИсполнителейРозницы.Обороты(, , , ОбъектВыработки = &ОбъектВыработки) КАК Выработка
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Выработка.Сотрудник,
	|	Выработка.ВидНачисления,
	|	Выработка.СтоимостьОборот,
	|	Выработка.ОбъектВыработки
	|ИЗ
	|	РегистрНакопления.ВыработкаИсполнителейПроизводства.Обороты(, , , ОбъектВыработки = &ОбъектВыработки) КАК Выработка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Выработка.Сотрудник КАК Сотрудник,
	|	ВТ_Выработка.ВидНачисления КАК ВидНачисления,
	|	СУММА(ВТ_Выработка.Сумма) КАК Сумма,
	|	&Валюта КАК Валюта,
	|	ВТ_Выработка.ОбъектВыработки КАК ОбъектВыработки
	|ИЗ
	|	ВТ_Выработка КАК ВТ_Выработка
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_Выработка.Сотрудник,
	|	ВТ_Выработка.ВидНачисления,
	|	ВТ_Выработка.ОбъектВыработки
	|
	|УПОРЯДОЧИТЬ ПО
	|	ВТ_Выработка.Сотрудник,
	|	ВТ_Выработка.ВидНачисления";
		
	Выборка = Запрос.Выполнить().Выбрать();
	ВалютаУчета = Константы.ВалютаУчета.Получить();
		
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = Начисление.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли