
&НаКлиенте
Перем мНоваяСтрока;

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Ключ.Пустая() Тогда
		
	Иначе
		ЭтаФорма.ТолькоПросмотр = ПраваПользователей.ДокументТолькоПросмотр(Объект.Ссылка);
	КонецЕсли;
		
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	Элементы.ПодменюПечать.Доступность = ПраваПользователей.ДоступностьПечати(Объект.Ссылка);
	ПраваПользователей.УстановитьТолькоПросмотрДляРеквизитаНомер(Элементы.Номер.ТолькоПросмотр);
	
	ВалютаУчета = Константы.ВалютаУчета.Получить();
	
	ОбщийМодульСервер.УстановитьВидимостьПодразделения(ЭтотОбъект);
	
	ОграничитьВыборСтатусаПроверен();

КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	 ДатыЗапретаИзменения.ОбъектПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	 
	 // СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
КонецПроцедуры

#КонецОбласти

#Область СтандартныеПодсистемы

// СтандартныеПодсистемы.ПодключаемыеКоманды
&НаКлиенте
Процедура Подключаемый_ВыполнитьКоманду(Команда)
	ОчиститьСообщения();
	ПодключаемыеКомандыКлиент.ВыполнитьКоманду(ЭтотОбъект, Команда, Объект);
КонецПроцедуры

&НаСервере
Процедура Подключаемый_ВыполнитьКомандуНаСервере(Контекст, Результат) Экспорт
	ПодключаемыеКоманды.ВыполнитьКоманду(ЭтотОбъект, Контекст, Объект, Результат);
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ОбновитьКоманды()
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект);
КонецПроцедуры
// Конец СтандартныеПодсистемы.ПодключаемыеКоманды

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Оставляет статус "Проверен" в списке выбора только пользователям, у которых есть
// дополнительное право "Разрешено устанавливать статус ""Проверен"" в штрафах".
// Окончательная проверка выполняется в модуле объекта, в обработчике ПередЗаписью.
&НаСервере
Процедура ОграничитьВыборСтатусаПроверен()

	Если РольДоступна("ПолныеПрава")
		ИЛИ РольДоступна("АдминистраторСистемы")
		ИЛИ ОбщийМодульСервер.НастройкаПользователя("РазрешеноУстанавливатьСтатусПроверенВШтрафах") Тогда
		Возврат;
	КонецЕсли;

	СписокВыбора = Элементы.ТекущийСтатус.СписокВыбора;
	СписокВыбора.Очистить();
	СписокВыбора.Добавить(Перечисления.ТекущийСтатусШтрафы.НаПроверке);
	Если Объект.ТекущийСтатус = Перечисления.ТекущийСтатусШтрафы.Проверен Тогда
		СписокВыбора.Добавить(Перечисления.ТекущийСтатусШтрафы.Проверен);
	КонецЕсли;
	Элементы.ТекущийСтатус.РежимВыбораИзСписка = Истина;

КонецПроцедуры

#КонецОбласти

&НаКлиенте
Процедура ШтрафыПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	мНоваяСтрока = 1;
КонецПроцедуры

&НаКлиенте
Процедура ШтрафыПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.Штрафы.ТекущиеДанные;
	Если мНоваяСтрока <> Неопределено Тогда
		ТекущиеДанные.КДокументу = Объект.Основание;
		ТекущиеДанные.Валюта = ВалютаУчета;
		ТекущиеДанные.ВидНачисления = ПредопределенноеЗначение("Справочник.ВидыНачислений.Штраф");
		мНоваяСтрока = Неопределено;
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ШтрафыСуммаПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.Штрафы.ТекущиеДанные;
	Если ТекущиеДанные.Сумма < 0 Тогда
		ТекущиеДанные.Сумма = -ТекущиеДанные.Сумма;
	КонецЕсли;
	
КонецПроцедуры



