#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	
	Если ЭтоНовый() Тогда
		ИнициализироватьСлужебныеРеквизиты();
		Автор = Пользователи.ТекущийПользователь();		
	КонецЕсли;
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ЗаказДоговор") Тогда		
		ЗаказДоговор = ДанныеЗаполнения;
		Организация  = ДанныеЗаполнения.Организация;
		Подразделение = ДанныеЗаполнения.Подразделение;
		ЗаполнитьТоварыПоДоговору();
		ЗаполнитьМатериалыПоДоговору();
		
	КонецЕсли;
	
	СтатьяДоходов  = ФинансыСервер.ПолучитьСтатьюДоходовРасходов(ЭтотОбъект, "Доход");
	СтатьяРасходов = ФинансыСервер.ПолучитьСтатьюДоходовРасходов(ЭтотОбъект, "Расход", Ложь);

	Если ЭтоНовый() Тогда
		ДозаполнитьПоУмолчанию();
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	
	ИнициализироватьСлужебныеРеквизиты(); 
	
	ДозаполнитьПоУмолчанию();
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	Если ТоварыУслуги.Количество() = 0 И НЕ ПроверяемыеРеквизиты.Найти("СкладСписанияТоваров") = Неопределено Тогда
		ПроверяемыеРеквизиты.Удалить(ПроверяемыеРеквизиты.Найти("СкладСписанияТоваров"));
	КонецЕсли;
	
	Если Материалы.Количество() = 0 И НЕ ПроверяемыеРеквизиты.Найти("СкладСписанияМатериалов") = Неопределено Тогда
		ПроверяемыеРеквизиты.Удалить(ПроверяемыеРеквизиты.Найти("СкладСписанияМатериалов"));
	КонецЕсли;
	
	Если СуммаДокумента = 0 И НЕ ПроверяемыеРеквизиты.Найти("СтатьяДоходов") = Неопределено Тогда
		ПроверяемыеРеквизиты.Удалить(ПроверяемыеРеквизиты.Найти("СтатьяДоходов"));
	КонецЕсли;
	
	// #13826 
	Для Индекс = 0 по Материалы.Количество()-1 Цикл
		СтрокаТабличнойЧасти = Материалы[Индекс];
		Если Справочники.ВидыНоменклатуры.ЭтоНоменклатураУслуга(СтрокаТабличнойЧасти.Номенклатура) Тогда
			ТекстОшибки = "В строке " + Строка(Индекс+1) + " таблицы ""Материалы"" выбрана номенклатура-услуга";
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки, ЭтотОбъект, "Материалы["+Формат(Индекс, "ЧГ=0")+"].Номенклатура", , Отказ);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	СуммаДокумента = ТоварыУслуги.Итог("Сумма");
					
	// Необходимо проверить, что ещё нет документа расторжения
	УстановитьПривилегированныйРежим(Истина);
	Запрос = новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СоглашениеОРасторженииДоговора.Ссылка
	|ИЗ
	|	Документ.СоглашениеОРасторженииДоговора КАК СоглашениеОРасторженииДоговора
	|ГДЕ
	|	СоглашениеОРасторженииДоговора.ЗаказДоговор = &ЗаказДоговор
	|	И НЕ СоглашениеОРасторженииДоговора.Ссылка = &ТекущийДокумент";
	Запрос.УстановитьПараметр("ЗаказДоговор", ЗаказДоговор);
	Запрос.УстановитьПараметр("ТекущийДокумент", Ссылка);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Сообщить("По указанному договору уже имеется документ " + Выборка.Ссылка);
		Отказ = Истина;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Ложь);
	//#6303
	Если РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда 	
		ЕстьМонтажВРаботеИлиВыполнен = Документы.ЗаказДоговор.ЕстьПроведенныйМонтажВРаботеИлиВыполнен(ЗаказДоговор);
		Если НЕ ПометкаУдаления И ЕстьМонтажВРаботеИлиВыполнен Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
         			"По заказ-договору " + ЗаказДоговор + " имеются монтажи в работе или выполненные монтажи. Проведение соглашения о расторжении невозможно!", , , , Отказ);	
		КонецЕсли;
	КонецЕсли;	

	//#13710
	ОбщийМодульСервер.ПроверитьИзменениеВзаиморасчетовПередЗаписью(ЭтотОбъект, РежимЗаписи);
	
КонецПроцедуры

