		//-- №8793
		
		Если НЕ ТаблицаСписанияТовары.Количество() = 0 Тогда
			Отказ = НЕ Движения.ТоварыНаСкладах.КонтрольОстатков(Ссылка, Организация, СкладСписанияТоваров, ТаблицаСписанияТовары, Дата);
			Если Отказ Тогда
				Возврат;
			Иначе
				Для Каждого Товар Из ТаблицаСписанияТовары Цикл
					Расход = Движения.ТоварыНаСкладах.Добавить();
					Расход.ВидДвижения = ВидДвиженияНакопления.Расход;
					Расход.Период = Дата;
					Расход.Организация = Организация;
					Расход.Склад = СкладСписанияТоваров;
					Расход.Номенклатура = Товар.Номенклатура;
					Расход.ХарактеристикаНоменклатуры = Товар.ХарактеристикаНоменклатуры;						
					Расход.Количество = Товар.Количество * Товар.Коэффициент;
					//#8288
					//Расход.Сумма = Расход.Количество * Движения.ТоварыНаСкладах.ПолучитьЦенуОстаткаНоменклатуры(Дата, Организация, СкладСписанияТоваров, Расход.Номенклатура, Расход.ХарактеристикаНоменклатуры, Расход.СерияНоменклатуры);											
					СтруктураЦенОстатков = Движения.ТоварыНаСкладах.ПолучитьЦеныОстаткаНоменклатуры(Дата, Организация, СкладСписанияТоваров, Расход.Номенклатура, Расход.ХарактеристикаНоменклатуры, Расход.СерияНоменклатуры);
					Расход.Сумма = Расход.Количество * СтруктураЦенОстатков.Цена;
					Расход.СуммаВал = Расход.Количество * СтруктураЦенОстатков.ЦенаВал;
				КонецЦикла;
			КонецЕсли;
		КонецЕсли;		
	КонецЕсли;
	
	//продажи
	ВалютаУчета = Константы.ВалютаУчета.Получить();
	Движения.Продажи.Записывать = Истина;		
	Для Каждого ТекущаяСтрока Из ТоварыУслуги Цикл
		Движение = Движения.Продажи.Добавить();
		Движение.Период = Дата;
		Движение.Организация = Организация;
		Движение.Склад = СкладСписанияТоваров; //#12367
		Движение.ДоговорКонтрагента = ЗаказДоговор.ДоговорКонтрагента;
		Движение.ДокументПродажи = ЗаказДоговор; // №12975 было: Ссылка;
		Движение.Количество = ТекущаяСтрока.Количество * ТекущаяСтрока.Коэффициент;
		Движение.Контрагент = ЗаказДоговор.Контрагент;
		Движение.Номенклатура = ТекущаяСтрока.Номенклатура; 
		Движение.ХарактеристикаНоменклатуры = ТекущаяСтрока.ХарактеристикаНоменклатуры;
		Движение.ЕдиницаИзмерения = ТекущаяСтрока.ЕдиницаИзмерения;         //#14300
		Движение.КоличествоВЕдиницахДокумента = ТекущаяСтрока.Количество;	//#14300
		Движение.Сумма = РаботаСВалютой.ПересчитатьИзВалютыВВалюту(ЗаказДоговор.Валюта, ВалютаУчета, Дата, ТекущаяСтрока.Сумма);
		Движение.СуммаВал = РаботаСВалютой.ПолучитьСуммуВДопВалютеУчетаПоДокументу(Ссылка, ТекущаяСтрока.Сумма, ЗаказДоговор.Валюта); //#8288
	КонецЦикла;
	
	// регистр ДоходыРасходы
	Если ПараметрыСеанса.ФинРезультатИспользоватьВедениеУчетаДоходовРасходов И ПараметрыСеанса.ФинРезультатНеКассовыйМетодВеденияУчетаДоходовРасходов Тогда
		//метод "по начислению"
		Метод = Перечисления.МетодыВеденияУчетаДоходовРасходов.Некассовый;
		Движения.ДоходыРасходы.Записывать = Истина;		
		Для Каждого ТекущаяСтрока Из ТоварыУслуги Цикл
			Статья = ?(НЕ ТекущаяСтрока.СтатьяДоходов.Пустая(), ТекущаяСтрока.СтатьяДоходов, СтатьяДоходов);
			Если Статья.Пустая() ИЛИ ТекущаяСтрока.Сумма = 0 Тогда
				Продолжить;
			КонецЕсли;
			Движение = Движения.ДоходыРасходы.Добавить();
			Движение.Период 		= Дата;
			Движение.Организация 	= Организация;
			Движение.Подразделение 	= ЗаказДоговор.Подразделение;
			Движение.Статья 		= Статья;
			Движение.Метод		 	= Метод;
			Движение.СуммаДоходов 	= РаботаСВалютой.ПолучитьСуммуВВалютеУчетаПоДокументу(Ссылка, ТекущаяСтрока.Сумма);
			Движение.СуммаРасходов 	= 0;
		КонецЦикла;	
		
		Если НЕ СтатьяРасходов.Пустая() И СуммаДополнительныхЗатрат > 0 Тогда
			Движение = Движения.ДоходыРасходы.Добавить();
			Движение.Период 		= Дата;
			Движение.Организация 	= Организация;
			Движение.Подразделение 	= ЗаказДоговор.Подразделение;
			Движение.Статья 		= СтатьяРасходов;
			Движение.Метод		 	= Метод;
			Движение.СуммаДоходов 	= 0;
			Движение.СуммаРасходов 	= РаботаСВалютой.ПолучитьСуммуВВалютеУчетаПоДокументу(Ссылка, СуммаДополнительныхЗатрат);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	//#13710
	ОбщийМодульСервер.ПроверитьИзменениеВзаиморасчетовПриЗаписи(ЭтотОбъект, Отказ);
	
КонецПроцедуры

