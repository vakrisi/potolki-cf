	МассивИменЭлементов = Новый Массив;
	
	МассивИменЭлементов.Добавить("ДеревоТоваровЦена");
	МассивИменЭлементов.Добавить("ДеревоТоваровСумма");
	
	Возврат МассивИменЭлементов;
	
КонецФункции
	
Функция ПолучитьМассивРеквизитовПоСкидкам() Экспорт
	
	МассивИменЭлементов = Новый Массив;
	
	МассивИменЭлементов.Добавить("ДеревоТоваровПроцентСкидки");
