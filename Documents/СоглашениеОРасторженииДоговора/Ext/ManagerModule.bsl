#Область Печать

Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт
	
	//Договор
    КомандаПечати = КомандыПечати.Добавить();
    КомандаПечати.МенеджерПечати = "Документ.ЗаказДоговор";
    КомандаПечати.Идентификатор = "Договор";
    КомандаПечати.Представление = НСтр("ru = 'Договор'");
    КомандаПечати.ПроверкаПроведенияПередПечатью = Истина; 
	КомандаПечати.Порядок = 1;
	
	//Договор в рассрочку
    КомандаПечати = КомандыПечати.Добавить();
    КомандаПечати.МенеджерПечати = "Документ.ЗаказДоговор";
    КомандаПечати.Идентификатор = "ДоговорРассрочка";
    КомандаПечати.Представление = НСтр("ru = 'Договор (рассрочка)'");
    КомандаПечати.ПроверкаПроведенияПередПечатью = Истина; 
	КомандаПечати.Порядок = 2;
		
	//Приложение (по комнатам)
    КомандаПечати = КомандыПечати.Добавить();
    КомандаПечати.МенеджерПечати = "Документ.ЗаказДоговор";
    КомандаПечати.Идентификатор = "Смета";
    КомандаПечати.Представление = НСтр("ru = 'Смета'");
    КомандаПечати.ПроверкаПроведенияПередПечатью = Истина; 
	КомандаПечати.Порядок = 3;
	
	Если ПолучитьФункциональнуюОпцию("ПечатьФормМонтажаИзЗаказДоговора") Тогда
		//Акт выполненных работ 
		КомандаПечати = КомандыПечати.Добавить();
		КомандаПечати.МенеджерПечати = "Документ.ЗаказДоговор";
		КомандаПечати.Идентификатор = "АктВыполненныхРабот";
		КомандаПечати.Представление = НСтр("ru = 'Акт выполненных работ'");
		КомандаПечати.ПроверкаПроведенияПередПечатью = Истина; 
		КомандаПечати.Порядок = 4;
		
		//Гарантийный талон 
		КомандаПечати = КомандыПечати.Добавить();
		КомандаПечати.МенеджерПечати = "Документ.ЗаказДоговор";
		КомандаПечати.Идентификатор = "ГарантийныйТалон";
		КомандаПечати.Представление = НСтр("ru = 'Гарантийный талон'");
		КомандаПечати.ПроверкаПроведенияПередПечатью = Истина; 
		КомандаПечати.Порядок = 5;
		
		//Комплект для монтажников
		КомандаПечати = КомандыПечати.Добавить();
		КомандаПечати.МенеджерПечати = "Документ.ЗаказДоговор";
		КомандаПечати.Идентификатор = "КомплектДляМонтажников";
		КомандаПечати.Представление = НСтр("ru = 'Комплект для монтажников'");
		КомандаПечати.ПроверкаПроведенияПередПечатью = Истина; 
		КомандаПечати.Порядок = 7;
	КонецЕсли;

	//Комплект для клиента
    КомандаПечати = КомандыПечати.Добавить();
    КомандаПечати.МенеджерПечати = "Документ.ЗаказДоговор";
    КомандаПечати.Идентификатор = "КомплектДляКлиента";
    КомандаПечати.Представление = НСтр("ru = 'Комплект для клиента'");
    КомандаПечати.ПроверкаПроведенияПередПечатью = Истина; 
	КомандаПечати.Порядок = 6;
	
КонецПроцедуры

Функция ПолучитьТекстЗапроса(СДаннымиПоМонтажу=Ложь) Экспорт
	
	ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ДокументРасторжение.Ссылка,
	|	ДокументРасторжение.ВерсияДанных,
	|	ДокументРасторжение.ПометкаУдаления,
	|	ДокументРасторжение.Номер,
	|	ДокументРасторжение.Дата КАК ДатаДокумента,
	|	ВЫРАЗИТЬ("""" КАК Строка(15)) КАК Дата,
	|	ДокументРасторжение.Проведен,
	|	ДокументРасторжение.ЗаказДоговор.Адрес КАК Адрес,
	|	ДокументРасторжение.ЗаказДоговор.Валюта КАК Валюта,
	|	ДокументРасторжение.ЗаказДоговор.ВидСкидки КАК ВидСкидки,
	|	ДокументРасторжение.ЗаказДоговор.ИсполнительЗамера КАК ИсполнительЗамера,
	|	ДокументРасторжение.Комментарий,
	|	ДокументРасторжение.ЗаказДоговор.Контрагент КАК Контрагент,
	|	ВЫБОР КОГДА НЕ ДокументРасторжение.ЗаказДоговор.Контрагент.НаименованиеПолное = """"
	|		ТОГДА
	|			ДокументРасторжение.ЗаказДоговор.Контрагент.НаименованиеПолное
	|		ИНАЧЕ
	|			ДокументРасторжение.ЗаказДоговор.Контрагент.Наименование
	|		КОНЕЦ КАК ПредставлениеКонтрагента,
	|	ДокументРасторжение.ЗаказДоговор.Контрагент.КонтактноеЛицоПодписант КАК КонтрагентПодписант,
	|	ДокументРасторжение.ЗаказДоговор.Контрагент.КонтактноеЛицоПодписант.Должность КАК КонтрагентПодписантДолжность,
	|	ДокументРасторжение.ЗаказДоговор.Менеджер КАК Менеджер,
	|	ДокументРасторжение.ЗаказДоговор.НомерДоговора КАК НомерДоговора,
	|	ДокументРасторжение.ЗаказДоговор КАК Основание,
	|	ДокументРасторжение.Автор,
	|	ДокументРасторжение.СуммаДокумента,
	|	ИСТИНА КАК ДоговорРассторгнут,
	|	ДокументРасторжение.ПричинаРасторженияДоговора,
	|	ДокументРасторжение.Организация КАК Организация,
	|	ДокументРасторжение.Организация.ПолноеНаименование КАК ОрганизацияПолноеНаименование,
	|	ДокументРасторжение.Организация.ЯвляетсяПлательщикомНДС КАК ЯвляетсяПлательщикомНДС,
	|	ДокументРасторжение.Организация.Руководитель КАК ОрганизацияПодписант,
	|	ДокументРасторжение.Организация.Руководитель.Должность КАК ОрганизацияПодписантДолжность,
	|	ДокументРасторжение.ЗаказДоговор.ВидЦен КАК ВидЦен,
	|	ДокументРасторжение.ТоварыУслуги.(
	|		Ссылка,
	|		НомерСтроки,
	|		Номенклатура.Артикул КАК Артикул,
	|		Номенклатура,
	|		ХарактеристикаНоменклатуры,
	|		Номенклатура.ВидНоменклатуры КАК ВидНоменклатуры,
	|		Количество,
	|		ЕдиницаИзмерения,
	|		Коэффициент,
	|		Цена,
	|		Сумма,
	|		СтавкаНДС,
	|		СуммаНДС,
	|		ПроцентСкидки,
	|		СуммаСкидки,
	|		ЦветФактуры,
	|		НомерПотолка,
	|		Комната
	|	) КАК ТоварыУслуги,
	|	ДокументРасторжение.Материалы.(
	|		Ссылка,
	|		НомерСтроки,
	|		Номенклатура.Артикул КАК Артикул,
	|		Номенклатура,
	|		ХарактеристикаНоменклатуры,
	|		Номенклатура.ВидНоменклатуры КАК ВидНоменклатуры,
	|		Количество,
	|		ЕдиницаИзмерения,
	|		Коэффициент
	|	) КАК Материалы,
	|	ДокументРасторжение.ЗаказДоговор.Представители.(
	|		Ссылка,
	|		НомерСтроки,
	|		ФИО,
	|		КонтактныйТелефон,
	|		Комментарий
	|	),
	|	ДокументРасторжение.ЗаказДоговор.ГрафикОплат.(
	|		Ссылка,
	|		НомерСтроки,
	|		ДатаПлатежа КАК ДатаПлатежаДокумент,
	|		""текстовая строка"" КАК ДатаПлатежа,
	|		Сумма
	|	) КАК ГрафикОплат,
	|	ДокументРасторжение.Представление,
	|	ДокументРасторжение.МоментВремени,
	|	РасчетыПоЗаказамОстатки.СуммаОстаток КАК ДолгПоДоговору,
	|	ВзаиморасчетыСКонтрагентамиОстатки.СуммаОстаток КАК ОбщийДолг,
	|	ДокументыУдостоверяющиеЛичность.Вид КАК ПаспортВид,
	|	ДокументыУдостоверяющиеЛичность.Серия КАК ПаспортСерия,
	|	ДокументыУдостоверяющиеЛичность.Номер КАК ПаспортНомер,
	|	ДокументыУдостоверяющиеЛичность.КемВыдан КАК ПаспортКемВыдан,
	|	ДокументыУдостоверяющиеЛичность.ДатаВыдачи КАК ПаспортДатаВыдачи,
	|	ВалютаУчета.Значение.Ссылка КАК ВалютаУчета";
	
	Если СДаннымиПоМонтажу Тогда
		ТекстЗапроса = ТекстЗапроса +
		",
		|	Монтаж.Бригада КАК Бригада,
		|	Монтаж.Бригадир КАК Бригадир,
		|	Монтаж.ДатаМонтажа КАК ДатаМонтажа,
		|	Монтаж.ВремяНачала КАК ВремяНачала,
		|	Монтаж.ВремяОкончания КАК ВремяОкончания,
		|	""01.01.0001"" КАК ДатаМонтажаФормат,
		|	""00:00:00"" КАК ВремяНачалаФормат,
		|	""00:00:00"" КАК ВремяОкончанияФормат";
	КонецЕсли;
	
	ТекстЗапроса = ТекстЗапроса +
	" ИЗ
	|	Документ.СоглашениеОРасторженииДоговора КАК ДокументРасторжение
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ВзаиморасчетыСКонтрагентами.Остатки КАК ВзаиморасчетыСКонтрагентамиОстатки
    |		ПО ДокументРасторжение.ЗаказДоговор.Контрагент = ВзаиморасчетыСКонтрагентамиОстатки.Контрагент
    |			И ДокументРасторжение.Организация = ВзаиморасчетыСКонтрагентамиОстатки.Организация
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ДокументыУдостоверяющиеЛичность КАК ДокументыУдостоверяющиеЛичность
	|		ПО ДокументРасторжение.ЗаказДоговор.Контрагент.ДокументУдостоверяющийЛичность = ДокументыУдостоверяющиеЛичность.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.РасчетыПоЗаказам.Остатки КАК РасчетыПоЗаказамОстатки
    |		ПО ДокументРасторжение.ЗаказДоговор = РасчетыПоЗаказамОстатки.Заказ";
	
	Если СДаннымиПоМонтажу Тогда
		ТекстЗапроса = ТекстЗапроса +
		"		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Монтаж КАК Монтаж
		|		ПО (Монтаж.Основание = ДокументРасторжение.ЗаказДоговор)
		|		И НЕ Монтаж.ПометкаУдаления";
	КонецЕсли;
	ТекстЗапроса = ТекстЗапроса + ", Константа.ВалютаУчета КАК ВалютаУчета";
	
	ТекстЗапроса = ТекстЗапроса +
	" ГДЕ
	|	ДокументРасторжение.Ссылка В(&МассивОбъектов)";	

	Возврат ТекстЗапроса;
КонецФункции

Функция ПолучитьДанныеДляПечатныхФорм(МассивОбъектов, ВключатьДанныеМонтажей = Истина) Экспорт
    
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	Запрос.УстановитьПараметр("ВключатьДанныеМонтажей", ВключатьДанныеМонтажей);
	Запрос.УстановитьПараметр("КолонкаАртикул", Константы.ВыводитьАртикулНоменклатурыВПечатныхФормах.Получить());
	Запрос.Текст = 	
    "ВЫБРАТЬ РАЗРЕШЕННЫЕ
    |	ДокументРасторжение.Ссылка КАК Ссылка,
    |	ДокументРасторжение.ВерсияДанных КАК ВерсияДанных,
    |	ДокументРасторжение.ПометкаУдаления КАК ПометкаУдаления,
    |	ДокументРасторжение.Номер КАК Номер,
    |	ДокументРасторжение.Дата КАК ДатаДокумента,
    |	ВЫРАЗИТЬ("""" КАК Строка(15)) КАК Дата,
    |	ДокументРасторжение.Проведен КАК Проведен,
    |	ДокументРасторжение.ЗаказДоговор.Адрес КАК Адрес,
    |	ДокументРасторжение.ЗаказДоговор.Валюта КАК Валюта,
    |	ДокументРасторжение.ЗаказДоговор.ВидСкидки КАК ВидСкидки,
    |	ДокументРасторжение.ЗаказДоговор.ИсполнительЗамера КАК ИсполнительЗамера,
    |	ДокументРасторжение.Комментарий КАК Комментарий,
    |	ДокументРасторжение.ЗаказДоговор.Контрагент КАК Контрагент,
    |	ВЫБОР
    |		КОГДА НЕ ДокументРасторжение.ЗаказДоговор.Контрагент.НаименованиеПолное = """"
    |			ТОГДА ДокументРасторжение.ЗаказДоговор.Контрагент.НаименованиеПолное
    |		ИНАЧЕ ДокументРасторжение.ЗаказДоговор.Контрагент.Наименование
    |	КОНЕЦ КАК ПредставлениеКонтрагента,
    |	ДокументРасторжение.ЗаказДоговор.Контрагент.КонтактноеЛицоПодписант КАК КонтрагентПодписант,
    |	ДокументРасторжение.ЗаказДоговор.Контрагент.КонтактноеЛицоПодписант.Должность КАК КонтрагентПодписантДолжность,
    |	ДокументРасторжение.ЗаказДоговор.Менеджер КАК Менеджер,
    |	ДокументРасторжение.ЗаказДоговор.НомерДоговора КАК НомерДоговора,
    |	ДокументРасторжение.ЗаказДоговор КАК Основание,
    |	ДокументРасторжение.Автор КАК Автор,
    |	ДокументРасторжение.ЗаказДоговор.Менеджер КАК МенеджерДоговора,
    |	ДокументРасторжение.СуммаДокумента КАК СуммаДокумента,
    |	ДокументРасторжение.СуммаДокумента КАК Сумма,
    |	ИСТИНА КАК ДоговорРассторгнут,
    |	ДокументРасторжение.ПричинаРасторженияДоговора КАК ПричинаРассторженияДоговора,
	|	ДокументРасторжение.ПричинаРасторженияДоговора КАК ПричинаРасторженияДоговора,
	|	ДокументРасторжение.Организация КАК Организация,
    |	ДокументРасторжение.Организация.ПолноеНаименование КАК ОрганизацияПолноеНаименование,
    |	ДокументРасторжение.Организация.ЯвляетсяПлательщикомНДС КАК ЯвляетсяПлательщикомНДС,
    |	ДокументРасторжение.Организация.Руководитель КАК ОрганизацияПодписант,
    |	ДокументРасторжение.Организация.Руководитель.Должность КАК ОрганизацияПодписантДолжность,
    |	ДокументРасторжение.ЗаказДоговор.ВидЦен КАК ВидЦен,
    |	ДокументРасторжение.Представление КАК Представление,
    |	ДокументРасторжение.МоментВремени КАК МоментВремени,
    |	ЕСТЬNULL(РасчетыПоЗаказамОстатки.СуммаОстаток, 0) КАК ДолгПоДоговору,
    |	ЕСТЬNULL(ВзаиморасчетыСКонтрагентамиОстатки.СуммаОстаток, 0) КАК ОбщийДолг,
    |	ДокументыУдостоверяющиеЛичность.Вид КАК ПаспортВид,
    |	ДокументыУдостоверяющиеЛичность.Серия КАК ПаспортСерия,
    |	ДокументыУдостоверяющиеЛичность.Номер КАК ПаспортНомер,
    |	ДокументыУдостоверяющиеЛичность.КемВыдан КАК ПаспортКемВыдан,
    |	ДокументыУдостоверяющиеЛичность.ДатаВыдачи КАК ПаспортДатаВыдачи,
    |	ВалютаУчета.Значение.Ссылка КАК ВалютаУчета,
    |	Монтаж.Бригада КАК Бригада,
    |	Монтаж.Бригадир КАК Бригадир,
    |	Монтаж.ДатаМонтажа КАК ДатаМонтажа,
    |	Монтаж.ВремяНачала КАК ВремяНачала,
    |	Монтаж.ВремяОкончания КАК ВремяОкончания,
	|	0 КАК ИтогоСуммаНДС
    |ИЗ
    |	Документ.СоглашениеОРасторженииДоговора КАК ДокументРасторжение
    |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ВзаиморасчетыСКонтрагентами.Остатки КАК ВзаиморасчетыСКонтрагентамиОстатки
    |		ПО ДокументРасторжение.ЗаказДоговор.Контрагент = ВзаиморасчетыСКонтрагентамиОстатки.Контрагент
    |			И ДокументРасторжение.Организация = ВзаиморасчетыСКонтрагентамиОстатки.Организация
    |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ДокументыУдостоверяющиеЛичность КАК ДокументыУдостоверяющиеЛичность
    |		ПО ДокументРасторжение.ЗаказДоговор.Контрагент.ДокументУдостоверяющийЛичность = ДокументыУдостоверяющиеЛичность.Ссылка
    |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.РасчетыПоЗаказам.Остатки КАК РасчетыПоЗаказамОстатки
    |		ПО ДокументРасторжение.ЗаказДоговор = РасчетыПоЗаказамОстатки.Заказ
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Монтаж КАК Монтаж
    |		ПО &ВключатьДанныеМонтажей
	|			И (Монтаж.Основание = ДокументРасторжение.ЗаказДоговор)
    |			И (НЕ Монтаж.ПометкаУдаления),
    |	Константа.ВалютаУчета КАК ВалютаУчета
    |ГДЕ
    |	ДокументРасторжение.Ссылка В(&МассивОбъектов)
    |
    |УПОРЯДОЧИТЬ ПО
    |	ДокументРасторжение.Ссылка
    |;
    |
    |////////////////////////////////////////////////////////////////////////////////
    |ВЫБРАТЬ РАЗРЕШЕННЫЕ
    |	ДанныеТабличнойЧасти.Ссылка КАК Ссылка,
    |	ДанныеТабличнойЧасти.НомерСтроки КАК НомерСтроки,
    |	ДанныеТабличнойЧасти.Комната КАК Комната,
    |	ВЫБОР
    |		КОГДА &КолонкаАртикул
    |			ТОГДА ДанныеТабличнойЧасти.Номенклатура.Артикул
    |		ИНАЧЕ ДанныеТабличнойЧасти.Номенклатура.Код
    |	КОНЕЦ КАК Код,
    |	ДанныеТабличнойЧасти.Номенклатура.Артикул КАК Артикул,
    |	ДанныеТабличнойЧасти.Номенклатура КАК Номенклатура,
    |	ДанныеТабличнойЧасти.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
    |	ДанныеТабличнойЧасти.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
    |	ДанныеТабличнойЧасти.Коэффициент КАК Коэффициент,
    |	ДанныеТабличнойЧасти.Количество КАК Количество,
    |	ДанныеТабличнойЧасти.Цена КАК Цена,
    |	ДанныеТабличнойЧасти.СуммаСкидки КАК СуммаСкидки,
    |	ДанныеТабличнойЧасти.Сумма КАК Сумма,
    |	ДанныеТабличнойЧасти.СтавкаНДС КАК СтавкаНДС,
    |	ДанныеТабличнойЧасти.СуммаНДС КАК СуммаНДС,
    |	ДанныеТабличнойЧасти.ПроцентСкидки КАК ПроцентСкидки,
    |	ДанныеТабличнойЧасти.Сумма + ДанныеТабличнойЧасти.СуммаСкидки КАК СуммаБезСкидки,
    |	ДанныеТабличнойЧасти.СуммаСкидки КАК Скидка,
    |	ДанныеТабличнойЧасти.Сумма - ДанныеТабличнойЧасти.СуммаНДС КАК СуммаБезНДС,
    |	ДанныеТабличнойЧасти.Сумма КАК СуммаСНДС,
    |	ДанныеТабличнойЧасти.ЕдиницаИзмерения.Код КАК ЕдиницаИзмеренияКод
	|ИЗ
    |	Документ.СоглашениеОРасторженииДоговора.ТоварыУслуги КАК ДанныеТабличнойЧасти
    |ГДЕ
    |	ДанныеТабличнойЧасти.Ссылка В(&МассивОбъектов)
    |
    |УПОРЯДОЧИТЬ ПО
    |	ДанныеТабличнойЧасти.Ссылка,
    |	ДанныеТабличнойЧасти.НомерСтроки
    |ИТОГИ ПО
    |	Ссылка";
    
	
	МассивРезультатов         = Запрос.ВыполнитьПакет();
	РезультатПоШапке          = МассивРезультатов[0];
	РезультатПоТабличнойЧасти = МассивРезультатов[1];
	
	СтруктураДанныхДляПечати 	= Новый Структура("РезультатПоШапке, РезультатПоТабличнойЧасти",
	                                               РезультатПоШапке, РезультатПоТабличнойЧасти);
	
	Возврат СтруктураДанныхДляПечати;
    
КонецФункции

Процедура ДополнитьДанныеДляПечатныхФорм(РезультатЗапроса, ВыборкаПоТоварам=Неопределено) Экспорт
	
	Документы.ЗаказДоговор.ДополнитьДанныеДляПечатныхФорм(РезультатЗапроса);
	
КонецПроцедуры

