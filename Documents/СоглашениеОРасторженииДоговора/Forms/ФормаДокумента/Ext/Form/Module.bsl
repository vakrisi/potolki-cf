		ОП = Новый ОписаниеОповещения("ПроцедураПослеВВодаСкидки", ЭтаФорма, ПараметрыПроцедуры);
		ПоказатьВводЗначения(ОП, УстановитьСкидку, "Введите % скидки на товары");
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ПроцедураПослеВВодаСкидки(ВыбЗнач, Параметры) Экспорт
	
	ТекущаяКомната = Элементы.ДеревоТоваров.ТекущиеДанные.Комната;
	ТекущаяНоменклатура = Элементы.ДеревоТоваров.ТекущиеДанные.Номенклатура;
	
	ПроцедураПослеВВодаСкидкиНаСервере(ВыбЗнач, Параметры);
	ПеренестиДеревоВТабличнуюЧасть();
	Состояние("Скидка установлена");
	
	ОбновитьОтображениеЭлементовФормы(ТекущаяКомната, ТекущаяНоменклатура);
	
КонецПроцедуры

&НаСервере
Процедура ПроцедураПослеВВодаСкидкиНаСервере(ВыбЗнач, Параметры)
	
	Если ВыбЗнач<>Неопределено Тогда
		Дерево = ДанныеФормыВЗначение(ДеревоТоваров, Тип("ДеревоЗначений"));
		Предмет = "";
		Если Параметры.Свойство("Предмет",Предмет) Тогда
			Если Предмет = "Товары" Тогда
				Для Каждого ТекСтрокаДерева Из Дерево.Строки Цикл
					Для Каждого ТекущаяСтрока Из ТекСтрокаДерева.Строки Цикл
						Если ЭтоТовар(ТекущаяСтрока.Номенклатура) Тогда
							ТекущаяСтрока.ПроцентСкидки = ВыбЗнач;
							РассчитатьСуммуСтрокиНаСервере(ТекущаяСтрока);
						КонецЕсли;
					КонецЦикла;
				КонецЦикла;
			ИначеЕсли Предмет = "Услуги" Тогда
				Для Каждого ТекСтрокаДерева Из Дерево.Строки Цикл
					Для Каждого ТекущаяСтрока Из ТекСтрокаДерева.Строки Цикл
						Если ЭтоУслуга(ТекущаяСтрока.Номенклатура) Тогда
							ТекущаяСтрока.ПроцентСкидки = ВыбЗнач;
							РассчитатьСуммуСтрокиНаСервере(ТекущаяСтрока);
						КонецЕсли;
					КонецЦикла;
				КонецЦикла;
			ИначеЕсли Предмет = "Потолок" Тогда
				Для Каждого ТекСтрокаДерева Из Дерево.Строки Цикл
					Для Каждого ТекущаяСтрока Из ТекСтрокаДерева.Строки Цикл
						Если ЭтоПотолок(ТекущаяСтрока.Номенклатура) Тогда
							ТекущаяСтрока.ПроцентСкидки = ВыбЗнач;
							РассчитатьСуммуСтрокиНаСервере(ТекущаяСтрока);
						КонецЕсли;
					КонецЦикла;
				КонецЦикла;
			КонецЕсли;
		КонецЕсли;
		ЗначениеВДанныеФормы(Дерево, ДеревоТоваров);
		Модифицированность = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ЭтоТовар(Номенклатура)
	Если Номенклатура.ВидНоменклатуры = Справочники.ВидыНоменклатуры.Материал Тогда
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;
КонецФункции

&НаСервере
Функция ЭтоУслуга(Номенклатура)
	Если Номенклатура.ВидНоменклатуры = Справочники.ВидыНоменклатуры.Услуга Тогда
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;
КонецФункции

&НаСервере
Функция ЭтоПотолок(Номенклатура)
	Возврат Справочники.ВидыНоменклатуры.ЭтоНоменклатураПотолкаИлиОтреза(Номенклатура);
КонецФункции

&НаКлиенте
Процедура ОчиститьСкидки(Команда)
	
	ОчиститьСкидкиНаСервере();
	ОбновитьОтображениеЭлементовФормы();
	
КонецПроцедуры

&НаСервере
Процедура ОчиститьСкидкиНаСервере()
	
	Дерево = ДанныеФормыВЗначение(ДеревоТоваров, Тип("ДеревоЗначений"));
	Для Каждого Строка из Дерево.Строки Цикл
		Для Каждого СтрНоменклатура из Строка.Строки Цикл
			СтрНоменклатура.ПроцентСкидки = 0;
			РассчитатьСуммуСтрокиНаСервере(СтрНоменклатура);
		КонецЦикла;
	КонецЦикла;
	ЗначениеВДанныеФормы(Дерево, ДеревоТоваров);
	ПеренестиДеревоВТабличнуюЧасть();
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьМатериал(Команда)
	
	Если СписокКомнат.Количество() = 0 Тогда
		ПоказатьОповещениеПользователя("В табличной части ""Товары и услуги"" не определены комнаты.");
		Возврат;
	КонецЕсли;
	
	ОткрытьФорму("ОбщаяФорма.ВыборИзСписка", новый Структура("ДоступныеЗначения", СписокКомнат), ЭтотОбъект,,,, новый ОписаниеОповещения("ПослеВыбораКомнатыПриДобавленииМатериала", ЭтотОбъект));
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораКомнатыПриДобавленииМатериала(ВыбранноеЗначение, ДопПараметры) Экспорт
	
	Если ВыбранноеЗначение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ПустаяСтрока(ВыбранноеЗначение) Тогда
		ПараметрыПодбора = Новый Структура;
		ПараметрыПодбора.Вставить("ТипДокумента",		"ЗаказДоговор");
		ПараметрыПодбора.Вставить("Назначение",			"Материалы");
		ОткрытьФорму("Справочник.Номенклатура.ФормаВыбора", ПараметрыПодбора,,,,, Новый ОписаниеОповещения("ПослеВыбораНоменклатурыМатериала", ЭтотОбъект, ВыбранноеЗначение));
	КонецЕсли;
	
КонецПроцедуры	

&НаКлиенте
Процедура ПослеВыбораНоменклатурыМатериала(ВыбЗнач, ДопПараметры) Экспорт
	
	Если НЕ ВыбЗнач = Неопределено Тогда
		ДобавитьМатериалНаСервере(ВыбЗнач, ДопПараметры);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьМатериалНаСервере(НоменклатураМатериала, Комната)
	
	СтрокаТабличнойЧасти = Объект.Материалы.Добавить();
	СтрокаТабличнойЧасти.Номенклатура = НоменклатураМатериала;
	СтрокаТабличнойЧасти.Комната = Комната;
	
	СтруктураДанные = Новый Структура;
	СтруктураДанные.Вставить("Номенклатура, Количество", СтрокаТабличнойЧасти.Номенклатура, 1);
	СтруктураДанные = ОбщийМодульВызовСервера.ПолучитьДанныеНоменклатурыПриИзменении(СтруктураДанные);	
	ЗаполнитьЗначенияСвойств(СтрокаТабличнойЧасти, СтруктураДанные, "ЕдиницаИзмерения, Коэффициент, Количество");
		
КонецПроцедуры

&НаКлиенте
Процедура ПодобратьМатериалы(Команда)
	
	Если СписокКомнат.Количество() = 0 Тогда
		ПоказатьОповещениеПользователя("В табличной части ""Товары и услуги"" не определены комнаты.");
		Возврат;
	КонецЕсли;
	
	ОткрытьФорму("ОбщаяФорма.ВыборИзСписка", новый Структура("ДоступныеЗначения", СписокКомнат), ЭтотОбъект,,,, новый ОписаниеОповещения("ПослеВыбораКомнатыПриПодбореМатериала", ЭтотОбъект));
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораКомнатыПриПодбореМатериала(ВыбранноеЗначение, ДопПараметры) Экспорт
	
	Если ВыбранноеЗначение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ПустаяСтрока(ВыбранноеЗначение) Тогда
		
		ПараметрыПодбора = Новый Структура;
		ПараметрыПодбора.Вставить("Организация",		Объект.Организация);
		ПараметрыПодбора.Вставить("ВидЦены",			ПолучитьВидЦенПоДоговору());
		ПараметрыПодбора.Вставить("ТипДокумента",		"ЗаказДоговор");
		ПараметрыПодбора.Вставить("Назначение",			"Материалы");
		
		ОткрытьФорму("ОбщаяФорма.ФормаПодбораНоменклатуры", ПараметрыПодбора,,,,, новый ОписаниеОповещения("ПослеПодбораМатериалов", ЭтотОбъект, ВыбранноеЗначение));
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеПодбораМатериалов(ВозвращенноеЗначение, Комната) Экспорт
	
	Если НЕ ВозвращенноеЗначение = Неопределено Тогда
		ОбработатьПодборМатериаловНаСервере(ВозвращенноеЗначение, Комната);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбработатьПодборМатериаловНаСервере(ВозвращенноеЗначение, ТекущаяКомната)
	
	Для Каждого ТекущаяСтрока из ВозвращенноеЗначение Цикл
		Стр = Объект.Материалы.Добавить();
		ЗаполнитьЗначенияСвойств(Стр, ТекущаяСтрока);
		Стр.Комната = ТекущаяКомната;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ПереименоватьКомнату(Команда)
	
	ТекущееНаименование = Элементы.ДеревоТоваров.ТекущиеДанные.Комната;
	
	ПараметрыПереименования = Новый Структура;
	ПараметрыПереименования.Вставить("СтароеНаименование",ТекущееНаименование);
	
	ПослеВводаНовогоНаименованияКомнаты = Новый ОписаниеОповещения("ПослеВводаНовогоНаименованияКомнаты",ЭтаФорма,ПараметрыПереименования);
	ПоказатьВводСтроки(ПослеВводаНовогоНаименованияКомнаты,ТекущееНаименование,"Введите название комнаты");
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВводаНовогоНаименованияКомнаты(Строка, Параметры) Экспорт
	
	Если НЕ Строка = Неопределено Тогда
        //проверим на наличие такого наименования
		ПараметрыПереименования = Новый Структура;
		ПараметрыПереименования.Вставить("НовоеНаименование",Строка);
		ПараметрыПереименования.Вставить("СтароеНаименование",Параметры.СтароеНаименование);
		
		Отбор = Новый Структура("Комната", Строка);
		НайденныеСтроки = Объект.ТоварыУслуги.НайтиСтроки(Отбор);
		Если НайденныеСтроки.Количество() > 0 Тогда
			ПереименоватьКомнатуПодтверждение = Новый ОписаниеОповещения("ПереименоватьКомнатуПодтверждение", ЭтаФорма, ПараметрыПереименования);
			ПоказатьВопрос(ПереименоватьКомнатуПодтверждение,"В документе уже есть комната """+Строка+""""+Символы.ПС
			+"Если присвоить такое же наименование, все товары текущей комнаты будут добавлены к существующей."
			+Символы.ПС+"Продолжить?",РежимДиалогаВопрос.ДаНет)
		Иначе
			ПереименоватьКомнатуПодтверждение(КодВозвратаДиалога.Да, ПараметрыПереименования);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПереименоватьКомнатуПодтверждение(Результат, Параметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Нет Тогда
        Возврат;
	КонецЕсли;
	
	ПереименоватьКомнатуПодтверждениеНаСервере(Параметры);
	РазвернутьДеревоТоваров(Параметры.НовоеНаименование, );
	
КонецПроцедуры

&НаСервере
Процедура ПереименоватьКомнатуПодтверждениеНаСервере(Параметры) Экспорт
	
	//товары и услуги
	Дерево = ДанныеФормыВЗначение(ДеревоТоваров, Тип("ДеревоЗначений"));
	Для Каждого ТекущаяСтрокаДерева Из Дерево.Строки Цикл
		Если ТекущаяСтрокаДерева.Комната = Параметры.СтароеНаименование Тогда
			ТекущаяСтрокаДерева.Комната = Параметры.НовоеНаименование;
		КонецЕсли;
		Для Каждого ТекущаяСтрока Из ТекущаяСтрокаДерева.Строки Цикл
			Если ТекущаяСтрока.Комната = Параметры.СтароеНаименование Тогда
				ТекущаяСтрока.Комната = Параметры.НовоеНаименование;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	ЗначениеВДанныеФормы(Дерево, ДеревоТоваров);
	
	//материалы
	Для Каждого ТекущаяСтрока Из Объект.Материалы Цикл
		Если ТекущаяСтрока.Комната = Параметры.СтароеНаименование Тогда
			ТекущаяСтрока.Комната = Параметры.НовоеНаименование;
		КонецЕсли;
	КонецЦикла;
	
	ПеренестиДеревоВТабличнуюЧасть();
	Модифицированность = Истина;

КонецПроцедуры

&НаКлиенте
Процедура ПеренестиВДругуюКомнату(Команда)
	ТекущаяНоменклатура = Элементы.ДеревоТоваров.ТекущиеДанные.Номенклатура;
	ТекущаяКомната = Элементы.ДеревоТоваров.ТекущиеДанные.Комната;
	Если ТекущаяНоменклатура.Пустая() Тогда
		ПоказатьПредупреждение(,"Выберите товар или услугу комнаты, который нужно перенести");
	Иначе
		СписокКомнат = ПолучитьСписокКомнат();
		
		ДопПараметры = Новый Структура;
		ДопПараметры.Вставить("ТекущаяНоменклатура",ТекущаяНоменклатура);
		ДопПараметры.Вставить("ТекущаяКомната",ТекущаяКомната);
		
		ПеренестиВДругуюКомнатуПодтверждение = Новый ОписаниеОповещения("ПеренестиВДругуюКомнатуПодтверждение",ЭтаФорма,ДопПараметры);
		СписокКомнат.ПоказатьВыборЭлемента(ПеренестиВДругуюКомнатуПодтверждение,"Выберите комнату");
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция ПолучитьСписокКомнат()
	
	СписокКомнат = Новый СписокЗначений;
	
	Дерево = ДанныеФормыВЗначение(ДеревоТоваров, Тип("ДеревоЗначений"));
	Для Каждого ТекущаяСтрокаДерева Из Дерево.Строки Цикл
		Если СписокКомнат.НайтиПоЗначению(ТекущаяСтрокаДерева.Комната) = Неопределено Тогда
			СписокКомнат.Добавить(ТекущаяСтрокаДерева.Комната);
		КонецЕсли;
		Для Каждого ТекущаяСтрока Из ТекущаяСтрокаДерева.Строки Цикл
			Если СписокКомнат.НайтиПоЗначению(ТекущаяСтрока.Комната) = Неопределено Тогда
				СписокКомнат.Добавить(ТекущаяСтрока.Комната);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	Возврат СписокКомнат;
	
КонецФункции

&НаКлиенте
Процедура ПеренестиВДругуюКомнатуПодтверждение(ВыбранныйЭлемент, СписокПараметров) Экспорт
    Если ВыбранныйЭлемент <> Неопределено Тогда
       ПеренестиВДругуюКомнатуПодтверждениеНаСервере(ВыбранныйЭлемент.Значение, СписокПараметров);
    КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ПеренестиВДругуюКомнатуПодтверждениеНаСервере(ВыбранныйЭлемент, СписокПараметров)
    Если ВыбранныйЭлемент <> Неопределено Тогда
		Дерево = ДанныеФормыВЗначение(ДеревоТоваров, Тип("ДеревоЗначений"));
		
		//Нужно найти родителя
		РодительНовойКомнаты = Неопределено;
		Для Каждого ТекущаяСтрокаДерева Из Дерево.Строки Цикл
			Если ТекущаяСтрокаДерева.Комната = ВыбранныйЭлемент Тогда 
				РодительНовойКомнаты = ТекущаяСтрокаДерева;
			КонецЕсли;
		КонецЦикла;
		
		Если РодительНовойКомнаты = Неопределено Тогда
			Возврат;
		КонецЕсли;
		
		Для Каждого ТекущаяСтрокаДерева Из Дерево.Строки Цикл
			Для Каждого ТекущаяСтрока Из ТекущаяСтрокаДерева.Строки Цикл
				Если (ТекущаяСтрока.Комната = СписокПараметров.ТекущаяКомната)
					и (ТекущаяСтрока.Номенклатура = СписокПараметров.ТекущаяНоменклатура) Тогда
					
					ТекущаяСтрока.Комната = ВыбранныйЭлемент;												
					НоваяСтрока = РодительНовойКомнаты.Строки.Добавить();
					ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущаяСтрока);
					
					ТекущаяСтрокаДерева.Строки.Удалить(ТекущаяСтрока);
					
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
			
		ЗначениеВДанныеФормы(Дерево, ДеревоТоваров);
		ПеренестиДеревоВТабличнуюЧасть();
		Модифицированность = Истина;
    КонецЕсли;
КонецПроцедуры

#КонецОбласти

&НаКлиенте
Процедура ДобавитьПотолок(Команда)
	
	СписокПотолковДоговора = ПолучитьСписокПотолковДоговора();
	
	Если СписокПотолковДоговора.Количество() = 0 Тогда
		ПоказатьОповещениеПользователя("В договоре не найдены потолки.");
		Возврат;
	КонецЕсли;
	
	ОткрытьФорму("ОбщаяФорма.ВыборИзСписка", новый Структура("ДоступныеЗначения", СписокПотолковДоговора),,,,, новый ОписаниеОповещения("ПослеВыбораПотолкаДоговора", ЭтотОбъект));
	
КонецПроцедуры

&НаСервере
Функция ПолучитьСписокПотолковДоговора()
	
	КВозврату = новый СписокЗначений;
	
	Для Каждого ТекущаяСтрока Из Объект.ЗаказДоговор.ТоварыУслуги Цикл
		Если Справочники.ВидыНоменклатуры.ЭтоНоменклатураУникальногоПотолкаИлиОтреза(ТекущаяСтрока.Номенклатура) Тогда
			КВозврату.Добавить(ТекущаяСтрока.Номенклатура);
		КонецЕсли;
	КонецЦикла;
	
	Возврат КВозврату;
	
КонецФункции

&НаКлиенте
Процедура ПослеВыбораПотолкаДоговора(ВыбранноеЗначение, ДопПараметры) Экспорт
	
	Если ВыбранноеЗначение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПослеВыбораПотолкаДоговораНаСервере(ВыбранноеЗначение);
	ПерестроитьДеревоНаФорме();
	РазвернутьДеревоТоваров();
	
КонецПроцедуры

&НаСервере
Процедура ПослеВыбораПотолкаДоговораНаСервере(ВыбранноеЗначение)
	
	Если НЕ ЗначениеЗаполнено(ВыбранноеЗначение.Потолок_НомерРасчета) Тогда
		Возврат;
	КонецЕсли;
	
	НайденныеСтрокиВДоговоре = Объект.ЗаказДоговор.ТоварыУслуги.НайтиСтроки(новый Структура("НомерПотолка", ВыбранноеЗначение.Потолок_НомерРасчета));
	
	Для Каждого ТекущаяСтрока Из НайденныеСтрокиВДоговоре Цикл
		НоваяСтрока = Объект.ТоварыУслуги.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущаяСтрока);
	КонецЦикла;
	
КонецПроцедуры	

&НаКлиенте
Процедура РассчитатьИтоговыеПоказателиКлиент(ФормаТолькоПросмотр = Ложь) Экспорт
	//#7556
		
	ИтогСумма = 0;
	ИтогСуммаБезСкидки = 0;
	ИтогСуммаПоПрайсу = 0;
	ИтогСуммаНДС = 0;
	ИтогСуммаСкидки = 0;
	ИтогКоличествоКомнат = 0;
	
	ИтогКоличествоПотолков = 0; // реквизит формы
	ИтогПлощадьПотолков = 0; // реквизит формы
	
	ЭлементыДерева = ДеревоТоваров.ПолучитьЭлементы();
	ИтогКоличествоКомнат = ЭлементыДерева.Количество();
	
	Для Каждого СтрокаКомнаты из ЭлементыДерева Цикл
		
		СуммаПоКомнате = 0;
		СуммаПоПрайсуКомнате = 0;
		ИтогБесплатноПоКомнате = 0;
		ИтогПлатноПоКомнате = 0;
		
		Для Каждого СтрокаТовара Из СтрокаКомнаты.ПолучитьЭлементы() Цикл
			ИтогСумма = ИтогСумма + СтрокаТовара.Сумма;
			ИтогСуммаБезСкидки = ИтогСуммаБезСкидки + СтрокаТовара.Количество * СтрокаТовара.Цена;
			ИтогСуммаПоПрайсу = ИтогСуммаПоПрайсу + СтрокаТовара.СуммаПоПрайсу;
			ИтогСуммаНДС = ИтогСуммаНДС + СтрокаТовара.СуммаНДС;
			ИтогСуммаСкидки = ИтогСуммаСкидки + СтрокаТовара.СуммаСкидки;			
			Если ЗначениеЗаполнено(СтрокаТовара.Номенклатура) И ОбщийМодульВызовСервера.ЭтоНоменклатураПотолкаРозницы(СтрокаТовара.Номенклатура) Тогда
				ИтогКоличествоПотолков = ИтогКоличествоПотолков + 1; 
				ИтогПлощадьПотолков = ИтогПлощадьПотолков + СтрокаТовара.Количество;	
			КонецЕсли;
			
			СуммаПоКомнате = СуммаПоКомнате + СтрокаТовара.Сумма;
			СуммаПоПрайсуКомнате = СуммаПоПрайсуКомнате + СтрокаТовара.СуммаПоПрайсу;			
			ИтогБесплатноПоКомнате = ИтогБесплатноПоКомнате + ?(СтрокаТовара.Бесплатно, 1, 0);
			ИтогПлатноПоКомнате    = ИтогПлатноПоКомнате    + ?(СтрокаТовара.Бесплатно, 0, 1);
		КонецЦикла;
		
		СтрокаКомнаты.Сумма = СуммаПоКомнате;
		СтрокаКомнаты.СуммаПоПрайсу = СуммаПоПрайсуКомнате;
		СтрокаКомнаты.Бесплатно = (ИтогБесплатноПоКомнате > 0 И ИтогПлатноПоКомнате = 0);
	КонецЦикла;
	ИтогОтклонениеОтПрайса = ИтогСумма - ИтогСуммаПоПрайсу; //как в отчете по эффективностям
	
	Если НЕ ФормаТолькоПросмотр Тогда
		//Если Объект.КоличествоКомнат <> ИтогКоличествоКомнат Тогда
		//	Объект.КоличествоКомнат = ИтогКоличествоКомнат;
		//	Модифицированность = Истина;
		//КонецЕсли;
		
		Если Объект.СуммаДокумента <> ИтогСумма Тогда 
			Объект.СуммаДокумента = ИтогСумма;
			Модифицированность = Истина;
		КонецЕсли;
		//Если Объект.СуммаДокументаПоПрайсу <> ИтогСуммаПоПрайсу Тогда
		//	Объект.СуммаДокументаПоПрайсу = ИтогСуммаПоПрайсу;
		//	Модифицированность = Истина;
		//КонецЕсли;
		//Если Объект.ОтклонениеОтПрайса <> ИтогОтклонениеОтПрайса Тогда
		//	Объект.ОтклонениеОтПрайса = ИтогОтклонениеОтПрайса;
		//	Модифицированность = Истина;
		//КонецЕсли;
		//Если Объект.СуммаСкидки <> ИтогСуммаСкидки Тогда
		//	Объект.СуммаСкидки = ИтогСуммаСкидки;
		//	Объект.ПроцентСкидки = ИтогСуммаСкидки;
		//	Если ИтогСуммаБезСкидки <> 0 Тогда
		//		Объект.ПроцентСкидки = Окр(100*ИтогСуммаСкидки / (ИтогСуммаБезСкидки), 2);
		//	Иначе
		//		Объект.ПроцентСкидки = 0;
		//	КонецЕсли;
		//	Модифицированность = Истина;
		//КонецЕсли;
	КонецЕсли;

	СуммаНДС = ИтогСуммаНДС;	
	//Если УчитыватьНДС Тогда
	//	Элементы.ИтогиВсегоНДС.Заголовок = Формат(ИтогСуммаНДС, "ЧРГ=; ЧН=0,00");
	//КонецЕсли;
		
КонецПроцедуры


