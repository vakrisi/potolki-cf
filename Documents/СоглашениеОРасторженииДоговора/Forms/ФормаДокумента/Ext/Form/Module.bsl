
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если НЕ Параметры.Ключ.Пустая() Тогда
		ЭтаФорма.ТолькоПросмотр = ПраваПользователей.ДокументТолькоПросмотр(Объект.Ссылка);
	КонецЕсли;
	
	УстановитьУсловноеОформление();
	
	Элементы.ПодменюПечать.Доступность = ПраваПользователей.ДоступностьПечати(Объект.Ссылка);
	ПраваПользователей.УстановитьТолькоПросмотрДляРеквизитаНомер(Элементы.Номер.ТолькоПросмотр);
	
	ФинансыСервер.УстановитьОтметкуНезаполненныхСтатейДоходовРасходов(Элементы);
	МассивЭлементов = Новый Массив;
	МассивЭлементов.Добавить("ДеревоТоваровСтатьяДоходов");
	ФинансыСервер.УстановитьВидимостьКолонокСтатейДиРВТабличнойЧасти(ЭтаФорма, МассивЭлементов, Истина);
	
	ВидСпецификацииПоУмолчанию = Перечисления.ВидыСпецификации.СопутствующиеМатериалы;
	
	// Видимость колонки Артикул
	МассивЭлементов = новый Массив();
	МассивЭлементов.Добавить("ДеревоТоваровНоменклатураАртикул");
	МассивЭлементов.Добавить("МатериалыНоменклатураАртикул");
	ОбщийМодульСервер.УстановитьВидимостьКолонкиАртикулВТабличнойЧасти(ЭтаФорма, МассивЭлементов);
	
	РеквизитыПользователя = ОбщийМодульСервер.НастройкиПользователя("ДополнительныеПраваЗапретРедактированияЦенВДокументах, ДополнительныеПраваЗапретПримененияСкидок");
	
	//управление доступностью элементов
	Если РеквизитыПользователя.ДополнительныеПраваЗапретРедактированияЦенВДокументах Тогда
		МассивИменЭлементов = Документы.СоглашениеОРасторженииДоговора.ПолучитьМассивРеквизитовПоЦенам();
		ОбщийМодульКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы, МассивИменЭлементов, "ТолькоПросмотр", Истина);
	КонецЕсли;
	//#7771
	Если РеквизитыПользователя.ДополнительныеПраваЗапретПримененияСкидок Тогда
		МассивИменЭлементов = Документы.СоглашениеОРасторженииДоговора.ПолучитьМассивРеквизитовПоСкидкам();
		ОбщийМодульКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы, МассивИменЭлементов, "ТолькоПросмотр", Истина);
	КонецЕсли;
	
	//построим дерево
	ПерестроитьДеревоНаФорме();
	
	ПереключательНаНазваниеКомнат = Константы.ИспользоватьСправочникКомнатВРознице.Получить();
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	// видимость СуммаДополнительныхЗатрат
	Элементы.СуммаДополнительныхЗатрат.Видимость = ПолучитьФункциональнуюОпцию("ИспользоватьВедениеУчетаДоходовРасходов");
	
	ОбщийМодульСервер.УстановитьВидимостьПодразделения(ЭтотОбъект);
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	ДатыЗапретаИзменения.ОбъектПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	мИспользоватьАвтоматическиеСкидки = ПолучитьЗначениеКонстантыАвтоматическихСкидок();
	ОбновитьВидимостьИДоступностьЭлементов();
	
	ОбновитьОтображениеЭлементовФормы();
	
КонецПроцедуры

&НаСервере 
Функция ПолучитьЗначениеКонстантыАвтоматическихСкидок()
	Возврат Константы.ИспользоватьАвтоматическиеСкидки.Получить();
КонецФункции

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	//проверки
	Если ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
		ДеревоТовары = ДанныеФормыВЗначение(ДеревоТоваров, Тип("ДеревоЗначений"));
		
		Для Каждого ТекущаяКомната из ДеревоТовары.Строки Цикл
			Для Каждого ТекущаяНоменклатура из ТекущаяКомната.Строки Цикл
				
				ТекстСообщения = ("Товары и услуги. Комната: " + ТекущаяНоменклатура.Комната + ", Номенклатура: " + ТекущаяНоменклатура.Номенклатура + " не указана цена");
				СтруктураПараметров = Новый Структура("Ссылка, ТабличнаяЧасть, ИмяТабличнойЧасти, ТекстСообщения", Объект.Ссылка, "ТоварыУслуги", "", ТекстСообщения);
				ОбработкаТабличныхЧастейСервер.ПроверитьЦенуСтроки(ТекущаяНоменклатура, СтруктураПараметров, Отказ);
				
				Если ТекущаяНоменклатура.Количество = 0 Тогда
					Отказ = Истина;
					Сообщить("Товары и услуги. Комната: " + ТекущаяНоменклатура.Комната + ", Номенклатура: " + ТекущаяНоменклатура.Номенклатура + " не указано количество");
				КонецЕсли;
				Если ПустаяСтрока(ТекущаяНоменклатура.ЕдиницаИзмерения) Тогда
					Отказ = Истина;
					Сообщить("Товары и услуги. Комната: " + ТекущаяНоменклатура.Комната + ", Номенклатура: " + ТекущаяНоменклатура.Номенклатура + " не указана единица измерения");
				КонецЕсли;
				Если ТекущаяНоменклатура.Коэффициент = 0 Тогда
					Отказ = Истина;
					Сообщить("Товары и услуги. Комната: " + ТекущаяНоменклатура.Комната + ", Номенклатура: " + ТекущаяНоменклатура.Номенклатура + " не указан коэффициент единицы измерения");
				КонецЕсли;
			КонецЦикла;	
		КонецЦикла;
		
		Для Каждого ТекущаяНоменклатура из Объект.Материалы Цикл
			Если ТекущаяНоменклатура.Количество = 0 Тогда
				Отказ = Истина;
				Сообщить("Материалы. Комната: " + ТекущаяНоменклатура.Комната + ", Номенклатура: " + ТекущаяНоменклатура.Номенклатура + " не указано количество");
			КонецЕсли;
			Если ПустаяСтрока(ТекущаяНоменклатура.ЕдиницаИзмерения) Тогда
				Отказ = Истина;
				Сообщить("Материалы. Комната: " + ТекущаяНоменклатура.Комната + ", Номенклатура: " + ТекущаяНоменклатура.Номенклатура + " не указана единица измерения");
			КонецЕсли;
			Если ТекущаяНоменклатура.Коэффициент = 0 Тогда
				Отказ = Истина;
				Сообщить("Материалы. Комната: " + ТекущаяНоменклатура.Комната + ", Номенклатура: " + ТекущаяНоменклатура.Номенклатура + " не указан коэффициент единицы измерения");
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	// проверяем заполненность статей доходов/расходов
	ФинансыСервер.ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи, , Объект.СуммаДополнительныхЗатрат > 0);
	
КонецПроцедуры

