Процедура ДеревоТоваровКоэффициентПриИзменении(Элемент)
	//корневые строки редактировать нельзя
	Если Элементы.ДеревоТоваров.ТекущиеДанные.ПолучитьРодителя() = Неопределено Тогда
		Элементы.ДеревоТоваров.ТекущиеДанные.Коэффициент = 0;
		Возврат;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ДеревоТоваровБесплатноПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ДеревоТоваров.ТекущиеДанные;
	Если НЕ ТекущиеДанные = Неопределено Тогда
		Если ТекущиеДанные.Бесплатно Тогда
			ТекущиеДанные.Цена = 0;
			ТекущиеДанные.ПроцентСкидки = 0;
			ТекущиеДанные.СуммаСкидки = 0;
			ТекущиеДанные.Сумма = 0;
			ТекущиеДанные.СуммаНДС = 0;
			ПеренестиДеревоВТабличнуюЧасть();
			ПересчитатьСуммуДокумента();
		Иначе                            
			ТекущиеДанные.Цена = ПолучитьЦенуНоменклатуры(ТекущиеДанные.Номенклатура, ТекущиеДанные.ХарактеристикаНоменклатуры, ТекущиеДанные.ЕдиницаИзмерения);
			ТекущиеДанные.ПроцентСкидки = ПолучитьПроцентВидаСкидки() + ПолучитьПроцентАвтоматическойСкидкиСервер(ТекущиеДанные.Номенклатура, ТекущиеДанные.Количество);
			РассчитатьСуммуСтроки(Элементы.ДеревоТоваров.ТекущиеДанные);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоТоваровСтавкаНДСПриИзменении(Элемент)
	
	ТекущаяСтрока = Элементы.ДеревоТоваров.ТекущиеДанные;
	РассчитатьСуммуНДСТабЧасти(ТекущаяСтрока);
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоТоваровНомерПотолкаПриИзменении(Элемент)
	
	//корневые строки редактировать нельзя
	Если Элементы.ДеревоТоваров.ТекущиеДанные.ПолучитьРодителя() = Неопределено Тогда
		Элементы.ДеревоТоваров.ТекущиеДанные.НомерПотолка = "";
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьКомнату(Команда)
		
	Если ПереключательНаНазваниеКомнат Тогда
		ОписаниеОповещения = Новый ОписаниеОповещения("ПослеВыбораКомнаты", ЭтотОбъект);
		ОткрытьФорму("Справочник.НазваниеКомнат.ФормаВыбора",,,,,, ОписаниеОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	Иначе
		ДобавитьКомнатуЗавершение(Неопределено);
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораКомнаты(Результат, ДопПараметры)  Экспорт
	
    Если Результат = Неопределено Тогда
        Возврат;
	КонецЕсли;	
	ДобавитьКомнатуЗавершение(Результат);
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьКомнатуЗавершение(НазваниеКомнаты)
	
	ИмяНовойКомнаты = ДобавитьКомнатуНаСервере(НазваниеКомнаты);
	ЗаполнитьДанныеКОтгрузкеИОстаткиПоТоварам(); 
	РазвернутьДеревоТоваров(ИмяНовойКомнаты, ПредопределенноеЗначение("Справочник.Номенклатура.ПустаяСсылка"));
	
КонецПроцедуры

&НаСервере
Функция ДобавитьКомнатуНаСервере(НазваниеКомнаты)
	
	//добавим комнату в товары
	НоваяСтрокаТовары = Объект.ТоварыУслуги.Добавить();
	НоваяСтрокаТовары.Комната = ПолучитьНаименованиеНовойКомнаты(НазваниеКомнаты);
	
	////добавим комнату в материалах
	//НоваяСтрокаМатериалы = Объект.Материалы.Добавить();
	//НоваяСтрокаМатериалы.Комната = НоваяСтрокаТовары.Комната;
	
	ПерестроитьДеревоНаФорме();
	
	Возврат НоваяСтрокаТовары.Комната;
	
КонецФункции

&НаСервере
Функция ПолучитьНаименованиеНовойКомнаты(НазваниеКомнаты)
	
	Дерево = ДанныеФормыВЗначение(ДеревоТоваров, Тип("ДеревоЗначений"));
	
	ТаблицаНомеров = Новый ТаблицаЗначений;
	ТаблицаНомеров.Колонки.Добавить("Номер", Новый ОписаниеТипов("Число"));	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	НазваниеКомнат.Наименование КАК НазКомнаты
	|ИЗ
	|	Справочник.НазваниеКомнат КАК НазваниеКомнат";
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	Для Каждого ТекущаяСтрока Из Дерево.Строки Цикл
		НоваяСтрока = ТаблицаНомеров.Добавить();
		Попытка
			СтрокаЗамены = СтрЗаменить(ТекущаяСтрока.Комната, "Комната ", "");
			Выборка.Сбросить();
			Пока Выборка.Следующий() Цикл
				Если Найти(СтрокаЗамены, Выборка.НазКомнаты) Тогда
					СтрокаЗамены = СтрЗаменить(СтрокаЗамены, " - " + Выборка.НазКомнаты, "");
					СтрокаЗамены = СтрЗаменить(СтрокаЗамены, Выборка.НазКомнаты, "");
					СтрокаЗамены = СтрЗаменить(СтрокаЗамены, " ", "");
				КонецЕсли;
			КонецЦикла;
			
			НоваяСтрока.Номер = Число(СтрокаЗамены);
			
		Исключение
		КонецПопытки;
	КонецЦикла;
	
	ТаблицаНомеров.Свернуть("Номер");
	ТаблицаНомеров.Сортировать("Номер Убыв");
	
	Если НЕ НазваниеКомнаты = Неопределено Тогда
		Если ТаблицаНомеров.Количество() > 0 Тогда
			Возврат "Комната " + СтрЗаменить(Строка(ТаблицаНомеров[0].Номер+1), Символ(160), "") + " - " + НазваниеКомнаты;
		Иначе
			Возврат "Комната 1" + " - " + НазваниеКомнаты;
		КонецЕсли;
	Иначе
		Если ТаблицаНомеров.Количество() > 0 Тогда
			Возврат "Комната " + СтрЗаменить(Строка(ТаблицаНомеров[0].Номер+1), Символ(160), "");
		Иначе
			Возврат "Комната 1";
		КонецЕсли;
	КонецЕсли;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьДанныеКОтгрузкеИОстаткиПоТоварам()
	
	//заполняем данные по остаткам на складах
	
	Дерево = ДанныеФормыВЗначение(ДеревоТоваров, Тип("ДеревоЗначений"));
	
	ВремТаблицаТоваров = Объект.ТоварыУслуги.Выгрузить();
	ВремТаблицаТоваров.Свернуть("Номенклатура, ХарактеристикаНоменклатуры, Коэффициент, НомерПотолка","Количество");
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТаблицаДокумента",		ВремТаблицаТоваров);
	Запрос.УстановитьПараметр("Организация",			Объект.Организация);
	Запрос.УстановитьПараметр("Склад",					ОбщийМодульСервер.НастройкаПользователя("СкладРозница"));
	Запрос.УстановитьПараметр("ЗаказДоговор",			Объект.ЗаказДоговор);
	Запрос.УстановитьПараметр("ИспользуютсяОбщиеСклады",Константы.ОбщиеСклады.Получить());
	Запрос.УстановитьПараметр("ИспользоватьРезервирование", Константы.ИспользоватьРезервирование.Получить());
	
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТЗЗаказПокупателяТовары.Номенклатура КАК Номенклатура,
	|	ТЗЗаказПокупателяТовары.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	|	ТЗЗаказПокупателяТовары.Количество КАК Количество,
	|	ТЗЗаказПокупателяТовары.Коэффициент КАК Коэффициент,
	|	ТЗЗаказПокупателяТовары.НомерПотолка КАК НомерПотолка
	|ПОМЕСТИТЬ ВремЗаказПокупателяТоварыДоп
	|ИЗ
	|	&ТаблицаДокумента КАК ТЗЗаказПокупателяТовары
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВремЗаказПокупателяТоварыДоп.Номенклатура КАК Номенклатура,
	|	ВремЗаказПокупателяТоварыДоп.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	|	ВремЗаказПокупателяТоварыДоп.Количество КАК Количество,
	|	ВремЗаказПокупателяТоварыДоп.Коэффициент КАК Коэффициент,
	|	ВремЗаказПокупателяТоварыДоп.НомерПотолка КАК НомерПотолка,
	|	ЕСТЬNULL(СправочникНоменклатура.Ссылка, ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)) КАК Потолок
	|ПОМЕСТИТЬ ВремЗаказПокупателяТовары
	|ИЗ
	|	ВремЗаказПокупателяТоварыДоп КАК ВремЗаказПокупателяТоварыДоп
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК СправочникНоменклатура
	|		ПО (СправочникНоменклатура.Потолок_НомерРасчета = ВремЗаказПокупателяТоварыДоп.НомерПотолка)
	|			И (СправочникНоменклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Справочник.ВидыНоменклатуры.Потолок))
	|			И (НЕ ВремЗаказПокупателяТоварыДоп.НомерПотолка = """")
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЗаказПокупателяТовары.Номенклатура КАК Номенклатура,
	|	ЗаказПокупателяТовары.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	|	ЗаказПокупателяТовары.Потолок КАК Потолок,
	|	ЕСТЬNULL(ЗаказыПоПотолкам.КоличествоПриход, 0) > 0 КАК ЕстьЗаказПокупателяПоПотолку,
	|	ВЫБОР
	|		КОГДА ЗаказПокупателяТовары.Коэффициент <> 0
	|			ТОГДА ТоварыНаСкладахОстатки.КоличествоОстаток / ЗаказПокупателяТовары.Коэффициент
	|		ИНАЧЕ ТоварыНаСкладахОстатки.КоличествоОстаток
	|	КОНЕЦ КАК ОстатокНаСкладе,
	|	ЕСТЬNULL(ВЫБОР		
	|		КОГДА &ИспользоватьРезервирование
	|			ТОГДА ВЫБОР
	|					КОГДА ЗаказПокупателяТовары.Коэффициент <> 0
	|						ТОГДА ВРезервеОстатки.КоличествоОстаток / ЗаказПокупателяТовары.Коэффициент
	|					ИНАЧЕ ВРезервеОстатки.КоличествоОстаток
	|				КОНЕЦ
	|		ИНАЧЕ 0
	|	КОНЕЦ, 0) КАК ВРезерве,
	|	ВЫБОР
	|		КОГДА ЗаказПокупателяТовары.Коэффициент <> 0
	|			ТОГДА ЗаказПокупателяТовары.Количество - ЕСТЬNULL(ЗаказыПокупателейОбороты.КоличествоРасход, 0) / ЗаказПокупателяТовары.Коэффициент
	|		ИНАЧЕ ЗаказПокупателяТовары.Количество - ЕСТЬNULL(ЗаказыПокупателейОбороты.КоличествоРасход, 0)
	|	КОНЕЦ КАК КОтгрузке
	|ИЗ
	|	ВремЗаказПокупателяТовары КАК ЗаказПокупателяТовары
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыНаСкладах.Остатки(
	|				,
	|				ВЫБОР
	|						КОГДА &ИспользуютсяОбщиеСклады
	|							ТОГДА ИСТИНА
	|						ИНАЧЕ Организация = &Организация
	|					КОНЕЦ
	|					И Склад = &Склад) КАК ТоварыНаСкладахОстатки
	|		ПО ЗаказПокупателяТовары.Номенклатура = ТоварыНаСкладахОстатки.Номенклатура
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ЗаказыПокупателей.Обороты(, , , ЗаказНаПроизводство = &ЗаказДоговор) КАК ЗаказыПокупателейОбороты
	|		ПО ЗаказПокупателяТовары.Номенклатура = ЗаказыПокупателейОбороты.Номенклатура
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ЗаказыПокупателей.Обороты(, , , ЗаказНаПроизводство <> &ЗаказДоговор) КАК ЗаказыПоПотолкам
	|		ПО ЗаказПокупателяТовары.Потолок = ЗаказыПоПотолкам.Номенклатура
	|			И (НЕ ЗаказПокупателяТовары.Потолок = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка))
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыВРезервеНаСкладах.Остатки(,
	|				Склад = &Склад
	|					И ВЫБОР
	|						КОГДА &ИспользуютсяОбщиеСклады
	|							ТОГДА ИСТИНА
	|						ИНАЧЕ Организация = &Организация
	|					КОНЕЦ) КАК ВРезервеОстатки
	|		ПО (ЗаказПокупателяТовары.Номенклатура = ВРезервеОстатки.Номенклатура)
	|			И (ЗаказПокупателяТовары.ХарактеристикаНоменклатуры = ВРезервеОстатки.ХарактеристикаНоменклатуры)";
	
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	
	Для Каждого ТекущаяСтрокаКомната Из Дерево.Строки Цикл
		Для Каждого ТекущаяСтрока Из ТекущаяСтрокаКомната.Строки Цикл
			Отбор = Новый Структура;
			Отбор.Вставить("Номенклатура",ТекущаяСтрока.Номенклатура);
			Отбор.Вставить("ХарактеристикаНоменклатуры",ТекущаяСтрока.ХарактеристикаНоменклатуры);
			НайденныеСтроки = РезультатЗапроса.НайтиСтроки(Отбор);
			Если НайденныеСтроки.Количество() > 0 Тогда
				ЗаполнитьЗначенияСвойств(ТекущаяСтрока, НайденныеСтроки[0],
					"КОтгрузке, ОстатокНаСкладе, ЕстьЗаказПокупателяПоПотолку, ВРезерве");
				ТекущаяСтрока.Доступно = ТекущаяСтрока.ОстатокНаСкладе - ТекущаяСтрока.ВРезерве;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
			
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ЗаказДоговор", Объект.ЗаказДоговор);
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ОбеспечениеЗаказовРозницы.Комната КАК Комната,
	|	ОбеспечениеЗаказовРозницы.Номенклатура КАК Номенклатура,
	|	ОбеспечениеЗаказовРозницы.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	|	СУММА(ОбеспечениеЗаказовРозницы.КоличествоПоФакту) КАК Заказано
	|ИЗ
	|	РегистрНакопления.ОбеспечениеЗаказовРозницы КАК ОбеспечениеЗаказовРозницы
	|ГДЕ
	|	ОбеспечениеЗаказовРозницы.Заказ = &ЗаказДоговор
	|	И ОбеспечениеЗаказовРозницы.Назначение = ""Товары""
	|
	|СГРУППИРОВАТЬ ПО
	|	ОбеспечениеЗаказовРозницы.Комната,
	|	ОбеспечениеЗаказовРозницы.Номенклатура,
	|	ОбеспечениеЗаказовРозницы.ХарактеристикаНоменклатуры";
	
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	Если РезультатЗапроса.Количество() > 0 Тогда
		Для Каждого ТекущаяСтрокаКомната Из Дерево.Строки Цикл
			Для Каждого ТекущаяСтрока Из ТекущаяСтрокаКомната.Строки Цикл
				Отбор = Новый Структура;
				Отбор.Вставить("Комната",ТекущаяСтрока.Комната);
				Отбор.Вставить("Номенклатура",ТекущаяСтрока.Номенклатура);
				Отбор.Вставить("ХарактеристикаНоменклатуры",ТекущаяСтрока.ХарактеристикаНоменклатуры);
				НайденныеСтроки = РезультатЗапроса.НайтиСтроки(Отбор);
				Если НайденныеСтроки.Количество() > 0 Тогда
					ЗаполнитьЗначенияСвойств(ТекущаяСтрока, НайденныеСтроки[0]);			
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;	
	
	ЗначениеВДанныеФормы(Дерево, ДеревоТоваров);

КонецПроцедуры

&НаКлиенте
Процедура РазвернутьДеревоТоваров(Комната = Неопределено, Номенклатура = Неопределено, ИдСтроки = Неопределено)
	
	Если Номенклатура = Неопределено Тогда
		Номенклатура = ПредопределенноеЗначение("Справочник.Номенклатура.ПустаяСсылка");
	КонецЕсли;
	Если Комната = Неопределено Тогда
		Комната = "";
	КонецЕсли;
	
	КоллекцияЭлементовДерева = ЭтаФорма.ДеревоТоваров.ПолучитьЭлементы();
	Если НЕ ИдСтроки = Неопределено Тогда
		Для Каждого Строка Из КоллекцияЭлементовДерева Цикл    
			ИдентификаторСтроки = Строка.ПолучитьИдентификатор();
			Элементы.ДеревоТоваров.Развернуть(ИдентификаторСтроки, Истина);
		КонецЦикла;	
		Элементы.ДеревоТоваров.ТекущаяСтрока = ИдСтроки;
	Иначе		
		ИдТекущейСтроки = Неопределено;
		Для Каждого Строка Из КоллекцияЭлементовДерева Цикл    
			ИдентификаторСтроки = Строка.ПолучитьИдентификатор();
			Для Каждого СтрокаВКомнате Из Строка.ПолучитьЭлементы() Цикл
				Если СтрокаВКомнате.Комната = Комната И СтрокаВКомнате.Номенклатура = Номенклатура Тогда
					ИдТекущейСтроки = СтрокаВКомнате.ПолучитьИдентификатор();
				КонецЕсли;
			КонецЦикла;
			// для случаев добавления новой комнаты / переименования
			Если Строка.Комната = Комната И (Строка.ПолучитьЭлементы().Количество() = 0 ИЛИ Номенклатура = Неопределено ИЛИ Номенклатура = ПредопределенноеЗначение("Справочник.Номенклатура.ПустаяСсылка")) Тогда
				ИдТекущейСтроки = ИдентификаторСтроки;			
			КонецЕсли;
			Элементы.ДеревоТоваров.Развернуть(ИдентификаторСтроки, Истина);
		КонецЦикла;
		Элементы.ДеревоТоваров.ТекущаяСтрока = ИдТекущейСтроки;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ДобавитьНоменклатуру(Команда)
	
	ТекущиеДанные = Элементы.ДеревоТоваров.ТекущиеДанные;
	Если НЕ ОбщийМодульКлиент.Розница_КомнатаЗаполнена(ТекущиеДанные) Тогда
		ПоказатьОповещениеПользователя("Выберите комнату");
		Возврат;
	КонецЕсли;
	
	СтрокаКомнаты = ТекущиеДанные;
	Если НЕ ТекущиеДанные.ПолучитьРодителя() = Неопределено Тогда	
		СтрокаКомнаты = ТекущиеДанные.ПолучитьРодителя();
	КонецЕсли;
	
	ИдКомнаты = СтрокаКомнаты.ПолучитьИдентификатор();
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ПослеВыбораНоменклатуры", ЭтотОбъект, ИдКомнаты);
	
	ПараметрыПодбора = Новый Структура;
	ПараметрыПодбора.Вставить("ТипДокумента",		"ЗаказДоговор");
	ПараметрыПодбора.Вставить("Назначение",			"Товары");
	ОткрытьФорму("Справочник.Номенклатура.ФормаВыбора",ПараметрыПодбора,,,,,ОписаниеОповещения);
		
	Модифицированность = Истина;
		
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораНоменклатуры(ВыбранноеЗначение, ДополнительныеПараметры) Экспорт
		
	Если ВыбранноеЗначение = Неопределено Тогда
		Возврат;
	КонецЕсли;	
	
	Если ТипЗнч(ВыбранноеЗначение) = Тип("Структура") Тогда
		ДобавленнаяСтрока = ДобавитьНоменклатуруВДеревоТоваровКлиент(ВыбранноеЗначение.Номенклатура, ВыбранноеЗначение.Количество, ДополнительныеПараметры);
	Иначе
		// ДополнительныеПараметры = Имя комнаты
		ДобавленнаяСтрока = ДобавитьНоменклатуруВДеревоТоваровКлиент(ВыбранноеЗначение, , ДополнительныеПараметры)
	КонецЕсли;
	
	ПеренестиДеревоВТабличнуюЧасть();
	ЗаполнитьДанныеКОтгрузкеИОстаткиПоТоварам();
	
	//РассчитатьИтоговыеПоказателиКлиент();
	
	Если НЕ ДобавленнаяСтрока = Неопределено Тогда
		ОбновитьОтображениеЭлементовФормы(ДобавленнаяСтрока.Комната, ДобавленнаяСтрока.Номенклатура);	
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПослеВыбораНоменклатурыНаСервере(ВыбЗнач, ДопПараметры)
	
	Дерево = ДанныеФормыВЗначение(ДеревоТоваров, Тип("ДеревоЗначений"));
	Для Каждого Строка из Дерево.Строки Цикл
		Если Строка.Комната = ДопПараметры Тогда
			Стр = Строка.Строки.Добавить();
			Стр.Номенклатура = ВыбЗнач;
			Стр.Комната = ДопПараметры;
			
			СтруктураДанные = Новый Структура;
			СтруктураДанные.Вставить("Номенклатура", Стр.Номенклатура);
			СтруктураДанные = ОбщийМодульВызовСервера.ПолучитьДанныеНоменклатурыПриИзменении(СтруктураДанные);			
			ЗаполнитьЗначенияСвойств(Стр, СтруктураДанные, "ЕдиницаИзмерения, Коэффициент, СтатьяДоходов");

			Стр.Количество = 1;
			Стр.Цена = ПолучитьЦенуНоменклатуры(Стр.Номенклатура, Стр.ХарактеристикаНоменклатуры, Стр.ЕдиницаИзмерения);
			Стр.ПроцентСкидки = ПолучитьПроцентВидаСкидки() + ПолучитьПроцентАвтоматическойСкидкиСервер(Стр.Номенклатура, Стр.Количество);
			Стр.ЦенаПоПрайсу = Стр.Цена;
			РассчитатьСуммуСтрокиНаСервере(Стр);
			
			ЗначениеВДанныеФормы(Дерево, ДеревоТоваров);
			Возврат;
		КонецЕсли
	КонецЦикла;	
	
КонецПроцедуры

&НаКлиенте
Функция ДобавитьНоменклатуруВДеревоТоваровКлиент(Номенклатура, Количество = 1, ИдКомнаты)
	
	СтрокаКомнаты = ДеревоТоваров.НайтиПоИдентификатору(ИдКомнаты);	
	СтрокиНоменклатуры = СтрокаКомнаты.ПолучитьЭлементы();
			
	СтрокаТабличнойЧасти = СтрокиНоменклатуры.Добавить();
	СтрокаТабличнойЧасти.Номенклатура = Номенклатура;
	СтрокаТабличнойЧасти.Комната = СтрокаКомнаты.Комната;
	
	СтруктураДанные = Новый Структура("Номенклатура, ХарактеристикаНоменклатуры, ВидСпецификации, Количество, ВидСкидки", 
									СтрокаТабличнойЧасти.Номенклатура, СтрокаТабличнойЧасти.ХарактеристикаНоменклатуры, ВидСпецификацииПоУмолчанию, Количество, ПолучитьВидаСкидки());
	СтруктураДанные = ОбщийМодульВызовСервера.ПолучитьДанныеНоменклатурыПриИзменении(СтруктураДанные);	
	ЗаполнитьЗначенияСвойств(СтрокаТабличнойЧасти, СтруктураДанные, "ЕдиницаИзмерения, Коэффициент, Количество, ВидНоменклатуры");
	
	СтруктураДанные = ПолучитьДанныеНоменклатурыПриИзменении(СтруктураДанные);
	ЗаполнитьЗначенияСвойств(СтрокаТабличнойЧасти, СтруктураДанные, "Цена, ЦенаПоПрайсу, ПроцентСкидки"); 
	
	РассчитатьСуммуСтроки(СтрокаТабличнойЧасти);
	
	Элементы.ДеревоТоваров.ТекущаяСтрока = СтрокаТабличнойЧасти.ПолучитьИдентификатор();
	
	Возврат СтрокаТабличнойЧасти;
	
КонецФункции

&НаСервере
Функция ПолучитьДанныеНоменклатурыПриИзменении(СтруктураДанные)
	
	СтруктураДанные.Вставить("Цена", ПолучитьЦенуНоменклатуры(СтруктураДанные.Номенклатура, СтруктураДанные.ХарактеристикаНоменклатуры, СтруктураДанные.ЕдиницаИзмерения));
	СтруктураДанные.Вставить("ПроцентСкидки", ПолучитьПроцентВидаСкидки(СтруктураДанные.ВидСкидки));
	СтруктураДанные.Вставить("ЦенаПоПрайсу", СтруктураДанные.Цена);
	
	Возврат СтруктураДанные;
	
КонецФункции


&НаСервере
Процедура РассчитатьСуммуСтрокиНаСервере(ТекущаяСтрока = Неопределено)
	
	Если ТекущаяСтрока = Неопределено Тогда
		ТекущаяСтрока = Элементы.ТоварыУслуги.ТекущиеДанные;
	КонецЕсли;
	
	Если ТекущаяСтрока.ПроцентСкидки = 100 Тогда
		ТекущаяСтрока.Сумма = 0;
		ТекущаяСтрока.СуммаСкидки = ТекущаяСтрока.Количество * ТекущаяСтрока.Цена;
	Иначе
		Если НЕ ТекущаяСтрока.ПроцентСкидки = 0 Тогда
			ТекущаяСтрока.Сумма = ТекущаяСтрока.Количество * ТекущаяСтрока.Цена * (1 - ТекущаяСтрока.ПроцентСкидки / 100);
			ТекущаяСтрока.СуммаСкидки = (ТекущаяСтрока.Количество * ТекущаяСтрока.Цена) - ТекущаяСтрока.Сумма;
		Иначе
			ТекущаяСтрока.Сумма = ТекущаяСтрока.Количество * ТекущаяСтрока.Цена;
			ТекущаяСтрока.СуммаСкидки = 0;
		КонецЕсли;
	КонецЕсли;
	ТекущаяСтрока.СуммаПоПрайсу = ТекущаяСтрока.Количество * ТекущаяСтрока.ЦенаПоПрайсу;
	
КонецПроцедуры

&НаКлиенте
Функция НайтиСтрокуДерева(ДеревоПоиска, Комната, Номенклатура, Характеристика = Неопределено, ЕдиницаИзмерения = Неопределено)
	
	ЭлементыДерева = ДеревоПоиска.ПолучитьЭлементы();
	Для Каждого ТекЭлемент из ЭлементыДерева Цикл
		ПодчиненныеСтроки = ТекЭлемент.ПолучитьЭлементы();
		Для Каждого ПодчиненыйЭлемент Из ПодчиненныеСтроки Цикл
			Если СокрЛП(ПодчиненыйЭлемент.Комната) = СокрЛП(Комната)
				и ПодчиненыйЭлемент.Номенклатура = Номенклатура
				//Добавлено услове по ед. измерения и характестики при добавлении по ШК
				И (?(Характеристика = Неопределено, Истина, ПодчиненыйЭлемент.ХарактеристикаНоменклатуры = Характеристика И ПодчиненыйЭлемент.ЕдиницаИзмерения = ЕдиницаИзмерения))
			Тогда
				Возврат ПодчиненыйЭлемент;
			КонецеСли;
		КонецЦикла;
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции

&НаСервере
Функция ЗапретРедактированияЦен()
	Возврат ОбщийМодульСервер.НастройкаПользователя("ДополнительныеПраваЗапретРедактированияЦенВДокументах");	
КонецФункции

&НаКлиенте
Процедура ПодобратьНоменклатуру(Команда)
	
	Если Элементы.ДеревоТоваров.ТекущиеДанные <> Неопределено  Тогда
		Если Не ПустаяСтрока(Элементы.ДеревоТоваров.ТекущиеДанные.Комната) Тогда
			ПараметрыПодбора = Новый Структура;
			ПараметрыПодбора.Вставить("Дата",				Объект.Дата);
			ПараметрыПодбора.Вставить("Организация",		Объект.Организация);
			ПараметрыПодбора.Вставить("ВидЦены",			ПолучитьВидЦенПоДоговору());
			ПараметрыПодбора.Вставить("ТипДокумента",		"ЗаказДоговор");
			ПараметрыПодбора.Вставить("Назначение",			"Товары");
			ПараметрыПодбора.Вставить("ЗапретРедактированияЦен",ЗапретРедактированияЦен());
			ОткрытьФорму("ОбщаяФорма.ФормаПодбораНоменклатуры", ПараметрыПодбора, ЭтаФорма, УникальныйИдентификатор);
		Иначе
			ПоказатьОповещениеПользователя("Выберите комнату");
		КонецЕсли;	
	Иначе
		ПоказатьОповещениеПользователя("Выберите комнату");	
	КонецЕсли;
	Модифицированность = Истина;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьВидЦенПоДоговору()
	Возврат Объект.ЗаказДоговор.ВидЦен;
КонецФункции	

&НаСервере
Процедура ОбработатьПодборНаСервере(ВыбранноеЗначение, ТекущаяКомната)
	
	ТаблицаТоваров = ПолучитьИзВременногоХранилища(ВыбранноеЗначение.АдресВХранилище);
	
	Дерево = ДанныеФормыВЗначение(ДеревоТоваров, Тип("ДеревоЗначений"));
	Для Каждого Строка из Дерево.Строки Цикл
		Если Строка.Комната = ТекущаяКомната Тогда
			Для Каждого ТекущаяСтрока из ТаблицаТоваров Цикл
				СтрокаТабличнойЧасти = Строка.Строки.Добавить();
				ЗаполнитьЗначенияСвойств(СтрокаТабличнойЧасти, ТекущаяСтрока);
				
				СтруктураДанные = Новый Структура("Номенклатура, ВидСпецификации", СтрокаТабличнойЧасти.Номенклатура, ВидСпецификацииПоУмолчанию);
				СтруктураДанные = ОбщийМодульВызовСервера.ПолучитьДанныеНоменклатурыПриИзменении(СтруктураДанные);	
				ЗаполнитьЗначенияСвойств(СтрокаТабличнойЧасти, СтруктураДанные, "ВидНоменклатуры");

				СтрокаТабличнойЧасти.Комната = ТекущаяКомната;
				СтрокаТабличнойЧасти.ПроцентСкидки = ПолучитьПроцентВидаСкидки();
				Если Справочники.ВидыНоменклатуры.ЭтоНоменклатураПотолкаИлиОтреза(СтрокаТабличнойЧасти.Номенклатура) Тогда
					СтрокаТабличнойЧасти.Цена = ПолучитьЦенуНоменклатуры(СтрокаТабличнойЧасти.Номенклатура);
				КонецЕсли;	
				СтрокаТабличнойЧасти.ЦенаПоПрайсу = ПолучитьЦенуНоменклатуры(СтрокаТабличнойЧасти.Номенклатура, СтрокаТабличнойЧасти.ХарактеристикаНоменклатуры, СтрокаТабличнойЧасти.ЕдиницаИзмерения);
				РассчитатьСуммуСтрокиНаСервере(СтрокаТабличнойЧасти);
			КонецЦикла;
			
			ЗначениеВДанныеФормы(Дерево, ДеревоТоваров);
			Возврат;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	
	Если ИсточникВыбора.ИмяФормы = "ОбщаяФорма.ФормаПодбораНоменклатуры" Тогда	
		ОбработкаВыбораПодборНаКлиенте(ВыбранноеЗначение);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбораПодборНаКлиенте(ВыбранноеЗначение)
	
	Если Не ЗначениеЗаполнено(ВыбранноеЗначение) Тогда
		Возврат;
	КонецЕсли;
			
	ТекущаяСтрока = Элементы.ДеревоТоваров.ТекущиеДанные;
	ТекущаяКомната = ТекущаяСтрока.Комната;
	
	ОбработатьПодборНаСервере(ВыбранноеЗначение, ТекущаяКомната);
	ПеренестиДеревоВТабличнуюЧасть();
	ЗаполнитьДанныеКОтгрузкеИОстаткиПоТоварам();
	РазвернутьДеревоТоваров();
	ОбновитьОтображениеЭлементовФормы(ТекущаяКомната, Неопределено);
	
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьСкидкуНаПотолок(Команда)
	
	Если ДеревоТоваров.ПолучитьЭлементы().Количество() > 0 Тогда
		УстановитьСкидку = 0;
		ПараметрыПроцедуры = Новый Структура;
		ПараметрыПроцедуры.Вставить("Предмет","Потолок");
		ОП = Новый ОписаниеОповещения("ПроцедураПослеВВодаСкидки", ЭтаФорма, ПараметрыПроцедуры);
		ПоказатьВводЗначения(ОП, УстановитьСкидку, "Введите % скидки на полотно");
	КонецЕсли;	
	
КонецПроцедуры

