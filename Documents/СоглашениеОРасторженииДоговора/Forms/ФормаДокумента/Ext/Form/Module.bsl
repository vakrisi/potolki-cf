&НаКлиенте
Процедура ЗаполнитьТоварыПоМонтажу(Команда)
	
	СписокМонтажей = ПолучитьСписокМонтажейНаСервере();
	
	Если СписокМонтажей.Количество() = 0 Тогда
		ПоказатьПредупреждение(, "По договору не были найдены монтажи.");
		Возврат;
	КонецЕсли;
	
	ПараметрыЗаполнения = новый Структура("СписокМонтажей, НазваниеТЧ, ОчищатьТЧ, ТипДокумента", СписокМонтажей, "ТоварыУслуги", Истина, Тип("ДокументСсылка.Монтаж"));
	Если Объект.ТоварыУслуги.Количество() > 0 Тогда
		ПоказатьВопросОбОчищенииТабличнойЧасти(ПараметрыЗаполнения);
	Иначе
		ПоказатьВыборМонтажаДляЗаполнения(ПараметрыЗаполнения);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьСписокМонтажейНаСервере()
	
	УстановитьПривилегированныйРежим(Истина);
	Запрос = новый Запрос();
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Монтажи.Ссылка
		|ИЗ 
		|   Документ.Монтаж КАК Монтажи
		|ГДЕ
		|	Монтажи.Основание = &ЗаказДоговор
		|	И НЕ Монтажи.Основание = Значение(Документ.ЗаказДоговор.ПустаяСсылка)";
	Запрос.УстановитьПараметр("ЗаказДоговор", Объект.ЗаказДоговор);
	
	СписокМонтажей = новый СписокЗначений;
	СписокМонтажей.ЗагрузитьЗначения(Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка"));
	
	Возврат СписокМонтажей;
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецФункции

&НаКлиенте
Процедура ПоказатьВопросОбОчищенииТабличнойЧасти(ПараметрыЗаполнения)
	
	ОП = Новый ОписаниеОповещения("ПослеВопросаОбОчищенииТабличнойЧасти", ЭтотОбъект, ПараметрыЗаполнения);
	ПоказатьВопрос(ОП, "В табличной части """ + ПараметрыЗаполнения.НазваниеТЧ + """ присутствуют позиции, очистить данные?
		| Да = очистить
		| Нет = дополнить данные
		| Отмена = отменить действие", РежимДиалогаВопрос.ДаНетОтмена);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВопросаОбОчищенииТабличнойЧасти(Ответ, ДопПараметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Да ИЛИ Ответ = КодВозвратаДиалога.Нет Тогда
		ДопПараметры.ОчищатьТЧ = (Ответ = КодВозвратаДиалога.Да);
		Если ДопПараметры.ТипДокумента = Тип("ДокументСсылка.Монтаж") Тогда
			ПоказатьВыборМонтажаДляЗаполнения(ДопПараметры);
		ИначеЕсли ДопПараметры.ТипДокумента = Тип("ДокументСсылка.ПоступлениеТоваровИУслуг") Тогда
			ПоказатьВыборПоступленияДляЗаполнения(ДопПараметры);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьВыборМонтажаДляЗаполнения(ПараметрыЗаполнения)
	
	Если ПараметрыЗаполнения.СписокМонтажей.Количество() = 1 Тогда
		ЗаполнитьТоварыПоМонтажуНаСервере(ПараметрыЗаполнения.СписокМонтажей[0].Значение, ПараметрыЗаполнения);
	Иначе
		ОП = Новый ОписаниеОповещения("ПослеВыбораМонтажаДляЗаполнения", ЭтотОбъект, ПараметрыЗаполнения);
		ОткрытьФорму("ОбщаяФорма.ВыборИзСписка", новый Структура("ДоступныеЗначения", ПараметрыЗаполнения.СписокМонтажей), ЭтотОбъект,,,, ОП);
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораМонтажаДляЗаполнения(ВыбранноеЗначение, ДопПараметры) Экспорт
	
	Если ТипЗнч(ВыбранноеЗначение) = Тип("ДокументСсылка.Монтаж") Тогда
		
		ЗаполнитьТоварыПоМонтажуНаСервере(ВыбранноеЗначение, ДопПараметры);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТоварыПоМонтажуНаСервере(Монтаж, ПараметрыЗаполнения)
	
	Если ПараметрыЗаполнения.ОчищатьТЧ Тогда
		Объект[ПараметрыЗаполнения.НазваниеТЧ].Очистить();
	КонецЕсли;
	
	Для Каждого ТекущаяСтрока Из Монтаж[ПараметрыЗаполнения.НазваниеТЧ] Цикл
		
		Если ТекущаяСтрока.Номенклатура.ВидНоменклатуры = Справочники.ВидыНоменклатуры.Услуга Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока = Объект[ПараметрыЗаполнения.НазваниеТЧ].Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущаяСтрока);
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьМатериалыПоМонтажу(Команда)
	
	СписокМонтажей = ПолучитьСписокМонтажейНаСервере();
	
	Если СписокМонтажей.Количество() = 0 Тогда
		ПоказатьПредупреждение(, "По договору не были найдены монтажи.");
		Возврат;
	КонецЕсли;
	
	ПараметрыЗаполнения = новый Структура("СписокМонтажей, НазваниеТЧ, ОчищатьТЧ, ТипДокумента", СписокМонтажей, "Материалы", Истина, Тип("ДокументСсылка.Монтаж"));
	Если Объект.Материалы.Количество() > 0 Тогда
		ПоказатьВопросОбОчищенииТабличнойЧасти(ПараметрыЗаполнения);
	Иначе
		ПоказатьВыборМонтажаДляЗаполнения(ПараметрыЗаполнения);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура МатериалыНоменклатураПриИзменении(Элемент)
	
	СтрокаТабличнойЧасти = Элементы.Материалы.ТекущиеДанные;
	СтруктураДанные = Новый Структура;
	СтруктураДанные.Вставить("Номенклатура, Количество", СтрокаТабличнойЧасти.Номенклатура, 1);
	СтруктураДанные = ОбработкаТабличныхЧастейКлиент.ПолучитьДанныеНоменклатурыПриИзменении(СтруктураДанные);	
	ЗаполнитьЗначенияСвойств(СтрокаТабличнойЧасти, СтруктураДанные, "ЕдиницаИзмерения, Коэффициент, Количество");
	
КонецПроцедуры

&НаКлиенте
Процедура МатериалыЕдиницаИзмеренияПриИзменении(Элемент)
	
	СтрокаТабличнойЧасти = Элементы.Материалы.ТекущиеДанные;
	Если ТипЗнч(СтрокаТабличнойЧасти.ЕдиницаИзмерения) = Тип("СправочникСсылка.КлассификаторЕдиницИзмерения") Тогда
		СтрокаТабличнойЧасти.Коэффициент = 1;
	Иначе
		СтрокаТабличнойЧасти.Коэффициент = ОбщийМодуль.ПолучитьКоэффициентЕдиницыИзмерения(СтрокаТабличнойЧасти.ЕдиницаИзмерения);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура МатериалыЕдиницаИзмеренияНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	СтрокаТабличнойЧасти = Элементы.Материалы.ТекущиеДанные;
	СписокЕдиниц = ОбщийМодуль.ПолучитьСписокЕдиницИзмеренияНоменклатуры(СтрокаТабличнойЧасти.Номенклатура);
	
	ДанныеВыбора = Новый СписокЗначений;
	Для Ном = 0 По СписокЕдиниц.Количество() - 1 Цикл
		ДанныеВыбора.Добавить(СписокЕдиниц[Ном]);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура МатериалыЕдиницаИзмеренияОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	СтрокаТабличнойЧасти = Элементы.Материалы.ТекущиеДанные;
	Если ТипЗнч(ВыбранноеЗначение) = Тип("СправочникСсылка.КлассификаторЕдиницИзмерения") Тогда
		СтрокаТабличнойЧасти.Коэффициент = 1;
	Иначе
		СтрокаТабличнойЧасти.Коэффициент = ОбщийМодуль.ПолучитьКоэффициентЕдиницыИзмерения(ВыбранноеЗначение);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ЗаказДоговорВСтатусеОтменен()
	
	Возврат (Объект.ЗаказДоговор.ТекущийСтатус = Справочники.СтатусыЗаказДоговоров.Отменен);
	
КонецФункции

&НаКлиенте
Процедура ПослеВопросаОПереводеЗаказДоговорВСтатусРасторгнут(Ответ, ДопПараметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Да Тогда
		ПеревестиДоговорВСтатусРасторгнут();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПеревестиДоговорВСтатусРасторгнут()
	
	ДокументОбъект = Объект.ЗаказДоговор.ПолучитьОбъект();
	ДокументОбъект.ТекущийСтатус = Справочники.СтатусыЗаказДоговоров.Отменен;
	
	Попытка
		ДокументОбъект.Записать(?(ДокументОбъект.Проведен, РежимЗаписиДокумента.Проведение, РежимЗаписиДокумента.Запись));
	Исключение
		Сообщить("Не удалось перевести договор в статус ""Расторгнут""." + Символы.ПС + ОписаниеОшибки());
	КонецПопытки;
	
КонецПроцедуры	

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	ПеренестиДеревоВТабличнуюЧасть();
	
	// Проверка на выполненные или монтажи в работе
	Если ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
		
		Статусы = новый Массив;
		Статусы.Добавить(ПредопределенноеЗначение("Справочник.РезультатыМонтажа.Выполнен"));
		Статусы.Добавить(ПредопределенноеЗначение("Справочник.РезультатыМонтажа.ЧастичноВыполнен"));
		Статусы.Добавить(ПредопределенноеЗначение("Справочник.РезультатыМонтажа.Закрыт"));
		
		ВыполненныеМонтажи = ПолучитьМонтажиВСтатусе(Статусы);
		
		Если ВыполненныеМонтажи.Количество() > 0 Тогда
			Отказ = Истина;
			ПоказатьПредупреждение(, "По заказ-договору имеются выполненные (закрытые) монтажи. Проведение документа отменено.");
			Возврат;
		КонецЕсли;
		
		Статусы.Очистить();
		Статусы.Добавить(ПредопределенноеЗначение("Справочник.РезультатыМонтажа.ВРаботе"));
		
		МонтажиВРаботе = ПолучитьМонтажиВСтатусе(Статусы);
		
		Если МонтажиВРаботе.Количество() > 0 Тогда
			Отказ = Истина;
			ПоказатьВопрос(новый ОписаниеОповещения("ПослеВопросаОбОтменеМонтажейВРаботе", ЭтотОбъект, новый Структура("МонтажиВРаботе", МонтажиВРаботе)), "По заказ-договору имеются монтажи в работе. Для проведения документа необходимо их отменить.
				|Отменить монтажи по данному заказ-договору в работе?", РежимДиалогаВопрос.ДаНет);
			Возврат;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьМонтажиВСтатусе(Статусы)
	
	Запрос = новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Монтажи.Ссылка
		|ИЗ
		|   Документ.Монтаж КАК Монтажи
		|ГДЕ
		|   Монтажи.Основание = &ЗаказДоговор
		|	И Монтажи.Результат В (&Статусы)
		|	И НЕ Монтажи.ПометкаУдаления
		|	И НЕ Монтажи.Основание = Значение(Документ.ЗаказДоговор.ПустаяСсылка)";
	Запрос.УстановитьПараметр("ЗаказДоговор", Объект.ЗаказДоговор);
	
	Запрос.УстановитьПараметр("Статусы", Статусы);
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
КонецФункции

&НаКлиенте
Процедура ПослеВопросаОбОтменеМонтажейВРаботе(Ответ, ДопПараметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Да Тогда
		
		//Необходимо перевести монтажи в работе в статус "Отменен"
		ПеревестиМонтажиВРаботеВСтатусОтменен(ДопПараметры.МонтажиВРаботе);	
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПеревестиМонтажиВРаботеВСтатусОтменен(МонтажиВРаботе)
	
	Успешно = Истина;
	
	Для Каждого Монтаж Из МонтажиВРаботе Цикл
		ДокОбъект = Монтаж.ПолучитьОбъект();
		ДокОбъект.Результат = Справочники.РезультатыМонтажа.Отменен;
		Попытка
			Если ДокОбъект.Проведен Тогда
				ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
			Иначе
				ДокОбъект.Записать();
			КонецЕсли;
		Исключение
			Успешно = Ложь;
			Сообщить("Ошибка при переводе монтажа " + Монтаж + " в статус ""Отменен"": " + ОписаниеОшибки());
		КонецПопытки;
	КонецЦикла;	
		
	Если Успешно Тогда
		Сообщить("Монтажи в работе успешно переведены в статус ""Отменен"".");
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаказДоговорПриИзмененииНаСервере()
	Объект.Организация = Объект.ЗаказДоговор.Организация;
	Объект.Подразделение = Объект.ЗаказДоговор.Подразделение;
	ЗаполнитьСтатьюДоходовРасходовСервер();
КонецПроцедуры

&НаКлиенте
Процедура ЗаказДоговорПриИзменении(Элемент)
	ЗаказДоговорПриИзмененииНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьМатериалыПоПоступлениямДоговора(Команда)
	
	Если Не ЗначениеЗаполнено(Объект.ЗаказДоговор) Тогда
		ПоказатьПредупреждение(, "Необходимо выбрать договор");
		Возврат;
	КонецЕсли;
	
	СписокПоступленийПоДоговору = ПолучитьСписокПоступленийПоДоговору();
	
	Если СписокПоступленийПоДоговору.Количество() = 0 Тогда
		ПоказатьПредупреждение(, "По договору не были найдены документы ""Поступление товаров и услуг"".");
		Возврат;
	КонецЕсли;
	
	ПараметрыЗаполнения = новый Структура("СписокПоступлений, НазваниеТЧ, ОчищатьТЧ, ТипДокумента", СписокПоступленийПоДоговору, "Материалы", Истина, Тип("ДокументСсылка.ПоступлениеТоваровИУслуг"));
	Если Объект.Материалы.Количество() > 0 Тогда
		ПоказатьВопросОбОчищенииТабличнойЧасти(ПараметрыЗаполнения);
	Иначе
		ПоказатьВыборПоступленияДляЗаполнения(ПараметрыЗаполнения);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьСписокПоступленийПоДоговору()
	
	УстановитьПривилегированныйРежим(Истина);
	Запрос = новый Запрос();
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ПоступлениеТоваровИУслуг.Ссылка
		|ИЗ 
		|   Документ.ПоступлениеТоваровИУслуг КАК ПоступлениеТоваровИУслуг
		|ГДЕ
		|	ПоступлениеТоваровИУслуг.Основание = &ЗаказДоговор
		|	И НЕ ПоступлениеТоваровИУслуг.Основание = Значение(Документ.ЗаказДоговор.ПустаяСсылка)";
	Запрос.УстановитьПараметр("ЗаказДоговор", Объект.ЗаказДоговор);
	
	СписокПоступлений = новый СписокЗначений;
	СписокПоступлений.ЗагрузитьЗначения(Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка"));
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат СписокПоступлений;
	
КонецФункции

&НаКлиенте
Процедура ПоказатьВыборПоступленияДляЗаполнения(ПараметрыЗаполнения)
	
	// Если документ для заполнения один, то сразу по нему и заполним
	Если ПараметрыЗаполнения.СписокПоступлений.Количество() = 1 Тогда
		ЗаполнитьМатериалыПоПоступлениямДоговораНаСервере(ПараметрыЗаполнения.СписокПоступлений[0].Значение, ПараметрыЗаполнения);
	Иначе	
		ОП = Новый ОписаниеОповещения("ПослеВыбораПоступленияДляЗаполнения", ЭтотОбъект, ПараметрыЗаполнения);
		ОткрытьФорму("ОбщаяФорма.ВыборИзСписка", новый Структура("ДоступныеЗначения", ПараметрыЗаполнения.СписокПоступлений), ЭтотОбъект,,,, ОП);
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораПоступленияДляЗаполнения(ВыбранноеЗначение, ДопПараметры) Экспорт
	
	Если ТипЗнч(ВыбранноеЗначение) = Тип("ДокументСсылка.ПоступлениеТоваровИУслуг") Тогда
		
		ЗаполнитьМатериалыПоПоступлениямДоговораНаСервере(ВыбранноеЗначение, ДопПараметры);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьМатериалыПоПоступлениямДоговораНаСервере(ДокументПоступления, ПараметрыЗаполнения)
	
	Если ПараметрыЗаполнения.ОчищатьТЧ Тогда
		Объект[ПараметрыЗаполнения.НазваниеТЧ].Очистить();
	КонецЕсли;
		
	Для Каждого ТекущаяСтрока Из ДокументПоступления.Товары Цикл
		
		Если ТекущаяСтрока.Номенклатура.ВидНоменклатуры = Справочники.ВидыНоменклатуры.Услуга Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока = Объект[ПараметрыЗаполнения.НазваниеТЧ].Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущаяСтрока);
		
	КонецЦикла;
	
КонецПроцедуры

