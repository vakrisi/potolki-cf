		ОП = Новый ОписаниеОповещения("ПроцедураПослеВВодаСкидки", ЭтаФорма, ПараметрыПроцедуры);
		ПоказатьВводЗначения(ОП, УстановитьСкидку, "Введите % скидки на услуги");
	КонецЕсли;	
	
КонецПроцедуры

