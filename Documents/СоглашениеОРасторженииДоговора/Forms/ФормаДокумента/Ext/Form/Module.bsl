&НаСервере
Процедура ПерестроитьДеревоНаФорме()
	
	//ТОВАРЫ И УСЛУГИ
	//ключ строки дерева: комната
	ТЗКомнаты = Объект.ТоварыУслуги.Выгрузить(, "Комната");
	Для Каждого Стр из Объект.Материалы Цикл
		НоваяСтрока = ТЗКомнаты.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Стр);
	КонецЦикла;
	ТЗКомнаты.Свернуть("Комната");
	// сортировку не делаем, при наличии комнат более 10 будет сортировка по строкам, а не по числам, что приведет к "проблеме"
	
	СписокКомнат.ЗагрузитьЗначения(ТЗКомнаты.ВыгрузитьКолонку("Комната"));
	
	Комната = "";
	Дерево = ДанныеФормыВЗначение(ДеревоТоваров, Тип("ДеревоЗначений"));
	Дерево.Строки.Очистить();
	
	Для каждого СтрокаКомнаты из ТЗКомнаты Цикл
		СтрДерево = Дерево.Строки.Добавить();
		СтрДерево.Комната = СтрокаКомнаты.Комната;
		Комната = СтрокаКомнаты.Комната;
	КонецЦикла;
	
	Для Каждого Стр из Объект.ТоварыУслуги Цикл
		//Если Стр.Комната <> Комната Тогда
		//	СтрДерево = Дерево.Строки.Добавить();
		//	СтрДерево.Комната = Стр.Комната;
		//	Комната = Стр.Комната;
		//КонецЕсли;
		СтрДерево = Дерево.Строки.Найти(Стр.Комната, "Комната");
		Если НЕ Стр.Номенклатура.Пустая() Тогда
			СтрДеревоВид = СтрДерево.Строки.Добавить();
			ЗаполнитьЗначенияСвойств(СтрДеревоВид, Стр);
			СтрДеревоВид.ВидНоменклатуры = Стр.Номенклатура.ВидНоменклатуры;
		КонецЕсли;
	КонецЦикла;
	ЗначениеВДанныеФормы(Дерево, ДеревоТоваров);
	
КонецПроцедуры

