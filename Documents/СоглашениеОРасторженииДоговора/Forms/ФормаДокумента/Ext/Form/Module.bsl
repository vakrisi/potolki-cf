&НаКлиенте
Процедура ДеревоТоваровСуммаСкидкиПриИзменении(Элемент)
	
	//корневые строки редактировать нельзя
	Если Элементы.ДеревоТоваров.ТекущиеДанные.ПолучитьРодителя() = Неопределено Тогда
		Элементы.ДеревоТоваров.ТекущиеДанные.СуммаСкидки = 0;
		Возврат;
	КонецЕсли;
	
	ТекущаяСтрока = Элементы.ДеревоТоваров.ТекущиеДанные;
	Если НЕ ТекущаяСтрока.СуммаСкидки = 0 Тогда
		Если НЕ ТекущаяСтрока.Количество = 0 и НЕ ТекущаяСтрока.Цена = 0 Тогда
			ТекущаяСтрока.ПроцентСкидки = Окр((ТекущаяСтрока.СуммаСкидки / (ТекущаяСтрока.Количество * ТекущаяСтрока.Цена)) * 100,2);
			РассчитатьСуммуСтроки(ТекущаяСтрока, Истина);
		Иначе
			ТекущаяСтрока.ПроцентСкидки = 100;
			РассчитатьСуммуСтроки(ТекущаяСтрока, Истина);
		КонецЕсли;
	Иначе 
		ТекущаяСтрока.ПроцентСкидки = 0;
		РассчитатьСуммуСтроки(ТекущаяСтрока, Истина);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоТоваровПриИзменении(Элемент)
	
	//в этом методе нелья вызывать ПеренестиДеревоВТабличнуюЧасть(), т.к. иначе если при обрабтке изменения значения реквизита вызвать асинхронный дилог вопроса, то 
	//к тому времени как пользователь даст ответ на вопрос, его внесенные данные будут затерты в дереве
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьСуммуСтроки(ТекущаяСтрока = Неопределено, НеПересчитыватьСуммуРучнойСкидки = Ложь)
	
	Если ТекущаяСтрока = Неопределено Тогда
		ТекущаяСтрока = Элементы.ДеревоТоваров.ТекущиеДанные;
	КонецЕсли;
	
	Если ТекущаяСтрока.ПроцентСкидки = 100 Тогда
		ТекущаяСтрока.Сумма = 0;
		Если НЕ НеПересчитыватьСуммуРучнойСкидки Тогда
			ТекущаяСтрока.СуммаСкидки = ТекущаяСтрока.Количество * ТекущаяСтрока.Цена;
		КонецЕсли;
	Иначе
		Если НЕ ТекущаяСтрока.ПроцентСкидки = 0 Тогда
			ТекущаяСтрока.Сумма = ТекущаяСтрока.Количество * ТекущаяСтрока.Цена * (1 - ТекущаяСтрока.ПроцентСкидки / 100);
			Если НЕ НеПересчитыватьСуммуРучнойСкидки Тогда
				ТекущаяСтрока.СуммаСкидки = (ТекущаяСтрока.Количество * ТекущаяСтрока.Цена) - ТекущаяСтрока.Сумма;
			КонецЕсли;
		Иначе
			ТекущаяСтрока.Сумма = ТекущаяСтрока.Количество * ТекущаяСтрока.Цена;
			Если НЕ НеПересчитыватьСуммуРучнойСкидки Тогда
				ТекущаяСтрока.СуммаСкидки = 0;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	ТекущаяСтрока.СуммаПоПрайсу = ТекущаяСтрока.ЦенаПоПрайсу * ТекущаяСтрока.Количество;
	
	РассчитатьСуммуНДСТабЧасти(ТекущаяСтрока);
	
	ПеренестиДеревоВТабличнуюЧасть();
	ПересчитатьСуммуДокумента();
	
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьСуммуНДСТабЧасти(СтрокаТабличнойЧасти)
	
	ОбработкаТабличныхЧастейКлиент.ПересчитатьСуммуНДСВСтрокеТЧ(СтрокаТабличнойЧасти, УчитыватьНДС);
	
	ПеренестиДеревоВТабличнуюЧасть();												   
	Если УчитыватьНДС Тогда
		Элементы.ИтогиВсегоНДС.Заголовок = Объект.ТоварыУслуги.Итог("СуммаНДС");
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПеренестиДеревоВТабличнуюЧасть()
	
	//ТОВАРЫ И УСЛУГИ
	Объект.ТоварыУслуги.Очистить();
	Дерево = ДанныеФормыВЗначение(ДеревоТоваров, Тип("ДеревоЗначений"));
	Для Каждого Строка из Дерево.Строки Цикл
		Для Каждого СтрНоменклатура из Строка.Строки Цикл
			Если НЕ СтрНоменклатура.Номенклатура.Пустая() Тогда				
				Стр = Объект.ТоварыУслуги.Добавить();
				ЗаполнитьЗначенияСвойств(Стр, СтрНоменклатура);
				Стр.СуммаПоПрайсу = Стр.ЦенаПоПрайсу * Стр.Количество;
			КонецЕсли;
		КонецЦикла;	
	КонецЦикла;
	
	ПересчитатьСуммуДокументаНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьСуммуДокумента()
	ПересчитатьСуммуДокументаНаСервере();
КонецПроцедуры

&НаСервере
Процедура ПересчитатьСуммуДокументаНаСервере()
	
	Объект.СуммаДокумента = Объект.ТоварыУслуги.Итог("Сумма");
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьОтображениеЭлементовФормы(Знач ТекущаяКомната = Неопределено, Знач ТекущаяНоменклатура = Неопределено)
	
	Если НЕ Элементы.ДеревоТоваров.ТекущиеДанные = Неопределено Тогда
		Если ТекущаяКомната = Неопределено Тогда
			ТекущаяКомната = Элементы.ДеревоТоваров.ТекущиеДанные.Комната;
		КонецЕсли;
		Если ТекущаяНоменклатура = Неопределено Тогда
			ТекущаяНоменклатура = Элементы.ДеревоТоваров.ТекущиеДанные.Номенклатура;
		КонецЕсли;
	КонецЕсли;
	ЗаполнитьДанныеКОтгрузкеИОстаткиПоТоварам();	
	РазвернутьДеревоТоваров(ТекущаяКомната,ТекущаяНоменклатура);
	
	УчитыватьНДС = УчетНДС.ОрганизацияЯвляетсяПлательщикомНДС(Объект.Организация);
	Элементы.ДеревоТоваровСтавкаНДС.Видимость 	= УчитыватьНДС;
	Элементы.ДеревоТоваровСуммаНДС.Видимость 	= УчитыватьНДС;
	Элементы.ГруппаНДС.Видимость				= УчитыватьНДС;
	Если УчитыватьНДС Тогда
		Элементы.ИтогиВсегоНДС.Заголовок = Объект.ТоварыУслуги.Итог("СуммаНДС");
	КонецЕсли;
	
КонецПроцедуры	

