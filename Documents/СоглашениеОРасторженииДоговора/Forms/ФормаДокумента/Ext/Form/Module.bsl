&НаКлиенте
Процедура ДеревоТоваровПередУдалением(Элемент, Отказ)
	
	ТекущиеДанные = Элементы.ДеревоТоваров.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТекущиеДанные.ПолучитьЭлементы().Количество() > 0 Тогда
		//не даем удалить саму комнату, иначе нижние проверки не сработают
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	СтруктураОтвета = ПолучитьКомнатуИНоменклатуруСледущийСтроки();
	ВремТекущаяКомната = СтруктураОтвета.ТекущаяКомната;
	ВремТекущаяНоменклатура = СтруктураОтвета.ТекущаяНоменклатура;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьКомнатуИНоменклатуруСледущийСтроки()
	
	СтруктураОтвета = Новый Структура;
	СтруктураОтвета.Вставить("ТекущаяКомната","");
	СтруктураОтвета.Вставить("ТекущаяНоменклатура",Неопределено);
	Нашли = Ложь;
	
	ВремДеревоТоваров = РеквизитФормыВЗначение("ДеревоТоваров");
	Для Каждого ТекущаяСтрокаКомната Из ВремДеревоТоваров.Строки Цикл
		Если ТекущаяСтрокаКомната.Комната = ВремТекущаяКомната и ТекущаяСтрокаКомната.Номенклатура = ВремТекущаяНоменклатура Тогда
			Нашли = Истина;
			Продолжить;
		Иначе
			Если Нашли Тогда
				СтруктураОтвета.ТекущаяКомната = ТекущаяСтрокаКомната.Комната;
				СтруктураОтвета.ТекущаяНоменклатура = Неопределено;
				Возврат СтруктураОтвета;
			КонецЕсли;
		КонецЕсли;
		
		Для Каждого ТекущаяСтрокаНоменклатура Из ТекущаяСтрокаКомната.Строки Цикл
			Если ТекущаяСтрокаНоменклатура.Комната = ВремТекущаяКомната и ТекущаяСтрокаНоменклатура.Номенклатура = ВремТекущаяНоменклатура Тогда
				Нашли = Истина;
			Иначе
				Если Нашли Тогда
					СтруктураОтвета.ТекущаяКомната = ТекущаяСтрокаНоменклатура.Комната;
					СтруктураОтвета.ТекущаяНоменклатура = ТекущаяСтрокаНоменклатура.Номенклатура;
					Возврат СтруктураОтвета;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	//случай удаления самой последней строки дерева
	Для Каждого ТекущаяСтрокаКомната Из ВремДеревоТоваров.Строки Цикл
		
		Если ТекущаяСтрокаКомната.Комната = ВремТекущаяКомната и ТекущаяСтрокаКомната.Номенклатура = ВремТекущаяНоменклатура Тогда
			Продолжить;
		Иначе
			СтруктураОтвета.ТекущаяКомната = ТекущаяСтрокаКомната.Комната;
			СтруктураОтвета.ТекущаяНоменклатура = Неопределено;
		КонецЕсли;
		
		Для Каждого ТекущаяСтрокаНоменклатура Из ТекущаяСтрокаКомната.Строки Цикл
			Если ТекущаяСтрокаНоменклатура.Комната = ВремТекущаяКомната и ТекущаяСтрокаНоменклатура.Номенклатура = ВремТекущаяНоменклатура Тогда
			Иначе
				СтруктураОтвета.ТекущаяКомната = ТекущаяСтрокаНоменклатура.Комната;
				СтруктураОтвета.ТекущаяНоменклатура = ТекущаяСтрокаНоменклатура.Номенклатура;
			КонецЕсли;
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат СтруктураОтвета;
	
КонецФункции

&НаКлиенте
Процедура ДеревоТоваровПослеУдаления(Элемент)
	
	ПеренестиДеревоВТабличнуюЧасть();
	ПерестроитьДеревоНаФорме();
	ЗаполнитьДанныеКОтгрузкеИОстаткиПоТоварам();
	РазвернутьДеревоТоваров(ВремТекущаяКомната, ВремТекущаяНоменклатура);
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоТоваровНоменклатураПриИзменении(Элемент)
	
	//корневые строки редактировать нельзя
	Если Элементы.ДеревоТоваров.ТекущиеДанные.ПолучитьРодителя() = Неопределено Тогда
		Элементы.ДеревоТоваров.ТекущиеДанные.Номенклатура = Неопределено;
		Возврат;
	КонецЕсли;
	
	СтрокаТабличнойЧасти = Элементы.ДеревоТоваров.ТекущиеДанные;
	СтруктураДанные = Новый Структура;
	СтруктураДанные.Вставить("Номенклатура", СтрокаТабличнойЧасти.Номенклатура);
	СтруктураДанные = ОбработкаТабличныхЧастейКлиент.ПолучитьДанныеНоменклатурыПриИзменении(СтруктураДанные);	
	ЗаполнитьЗначенияСвойств(СтрокаТабличнойЧасти, СтруктураДанные, "ЕдиницаИзмерения, Коэффициент, СтатьяДоходов, ВидНоменклатуры");
	
	СтрокаТабличнойЧасти.Количество = ПолучитьКоличествоНоменклатуры(СтрокаТабличнойЧасти.Номенклатура);
	СтрокаТабличнойЧасти.Цена = ПолучитьЦенуНоменклатуры(СтрокаТабличнойЧасти.Номенклатура, СтрокаТабличнойЧасти.ХарактеристикаНоменклатуры, СтрокаТабличнойЧасти.ЕдиницаИзмерения);
	СтрокаТабличнойЧасти.ПроцентСкидки = ПолучитьПроцентВидаСкидки();
	СтрокаТабличнойЧасти.ЦенаПоПрайсу = СтрокаТабличнойЧасти.Цена;
	РассчитатьСуммуСтроки(СтрокаТабличнойЧасти);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьКоличествоНоменклатуры(Номенклатура)
	
	Если Справочники.ВидыНоменклатуры.ЭтоНоменклатураПотолкаИлиОтреза(Номенклатура) Тогда
		Если Номенклатура.Потолок_КоличествоПродукция > 0 Тогда
			Возврат Номенклатура.Потолок_КоличествоПродукция;
		КонецЕсли;
	КонецЕсли;
	
	Возврат 1;
	
КонецФункции

&НаКлиенте
Процедура ДеревоТоваровХарактеристикаНоменклатурыПриИзменении(Элемент)
	
	//корневые строки редактировать нельзя
	Если Элементы.ДеревоТоваров.ТекущиеДанные.ПолучитьРодителя() = Неопределено Тогда
		Элементы.ДеревоТоваров.ТекущиеДанные.Номенклатура = Неопределено;
		Возврат;
	КонецЕсли;
	
	СтрокаТабличнойЧасти = Элементы.ДеревоТоваров.ТекущиеДанные;
	СтрокаТабличнойЧасти.Цена = ПолучитьЦенуНоменклатуры(СтрокаТабличнойЧасти.Номенклатура, СтрокаТабличнойЧасти.ХарактеристикаНоменклатуры, СтрокаТабличнойЧасти.ЕдиницаИзмерения);
	СтрокаТабличнойЧасти.ЦенаПоПрайсу = СтрокаТабличнойЧасти.Цена;
	РассчитатьСуммуСтроки(СтрокаТабличнойЧасти);
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоТоваровКоличествоПриИзменении(Элемент)
	
	//корневые строки редактировать нельзя
	Если Элементы.ДеревоТоваров.ТекущиеДанные.ПолучитьРодителя() = Неопределено Тогда
		Элементы.ДеревоТоваров.ТекущиеДанные.Количество = 0;
		Возврат;
	КонецЕсли;
	
	ПроцентАвтоматическойСкидки = ПолучитьПроцентАвтоматическойСкидкиСервер(Элементы.ДеревоТоваров.ТекущиеДанные.Номенклатура, Элементы.ДеревоТоваров.ТекущиеДанные.Количество);
	Если НЕ ПроцентавтоматическойСкидки = 0 Тогда
		ПоказатьВопрос(Новый ОписаниеОповещения("ПослеВопросаОбИзмененииАвтоматическойСкидки",ЭтаФорма, Элементы.ДеревоТоваров.ТекущиеДанные), "Изменить скидку согласно настроек автоматических скидок?",РежимДиалогаВопрос.ДаНет);
	Иначе
		ПослеИзмененияКоличестваТоваров(Элементы.ДеревоТоваров.ТекущиеДанные, Ложь);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВопросаОбИзмененииАвтоматическойСкидки(Результат, ТекущаяСтрока) Экспорт
    Если Результат = КодВозвратаДиалога.Нет Тогда
        ПослеИзмененияКоличестваТоваров(ТекущаяСтрока, Ложь);
	Иначе
		ПослеИзмененияКоличестваТоваров(ТекущаяСтрока, Истина);
    КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПослеИзмененияКоличестваТоваров(ТекущаяСтрока, Знач ПерезаполнитьСкидки = Истина)
	
	//проставим автоматическую скидку + скидку вида
	Если ПерезаполнитьСкидки Тогда
		ТекущаяСтрока.ПроцентСкидки = ПолучитьПроцентАвтоматическойСкидкиСервер(ТекущаяСтрока.Номенклатура, ТекущаяСтрока.Количество) + ПолучитьПроцентВидаСкидки();
	КонецЕсли;
	
	РассчитатьСуммуСтроки(ТекущаяСтрока);
	
КонецПроцедуры

&НаСервере
Функция ПолучитьЦенуНоменклатуры(Номенклатура, ХарактеристикаНоменклатуры = Неопределено, ЕдиницаИзмерения = Неопределено,
	//#12539 , Фактура = "", ЦветФактуры = "")
	Количество = 1)
												
	Возврат ЦеныКомпании.ПолучитьЦенуНоменклатуры(Номенклатура, ХарактеристикаНоменклатуры, ЕдиницаИзмерения, Количество,
												Объект.Дата, Объект.ЗаказДоговор.ВидЦен, Объект.ЗаказДоговор.Валюта, 												 
												Объект.Организация, Объект.Подразделение, 
												Объект.ЗаказДоговор.Контрагент, Объект.ЗаказДоговор.ДоговорКонтрагента);
												
КонецФункции

&НаСервере
Функция ПолучитьПроцентВидаСкидки(ВидСкидки = Неопределено)
	
	Если НЕ ВидСкидки = Неопределено Тогда
		Если ВидСкидки.Пустая() Тогда
			Возврат 0;
		Иначе
			Возврат ВидСкидки.Процент;
		КонецЕсли;
	КонецЕсли;

	Если Объект.ЗаказДоговор.ВидСкидки.Пустая() Тогда
		Возврат 0;
	Иначе
		Возврат Объект.ЗаказДоговор.ВидСкидки.Процент;
	КонецЕсли;
	
КонецФункции

&НаСервере
Функция ПолучитьВидаСкидки()
	
	Возврат Объект.ЗаказДоговор.ВидСкидки;
	
КонецФункции

&НаСервере
Функция ПолучитьПроцентАвтоматическойСкидкиСервер(Номенклатура,Количество)
	
	Скидка = 0;
	
	Если мИспользоватьАвтоматическиеСкидки Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЗначенияАвтоматическихСкидокСрезПоследних.КоличествоОт,
		|	ЗначенияАвтоматическихСкидокСрезПоследних.РазмерСкидки
		|ИЗ
		|	РегистрСведений.ЗначенияАвтоматическихСкидок.СрезПоследних(&Дата, Номенклатура = &Номенклатура) КАК ЗначенияАвтоматическихСкидокСрезПоследних";
		Запрос.УстановитьПараметр("Дата", Объект.Дата);
		Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
		РезультатЗапроса = Запрос.Выполнить();
		
		Если РезультатЗапроса.Пустой() Тогда 
			Возврат Скидка;
		КонецЕсли;
		
		ТаблицаСкидок = РезультатЗапроса.Выгрузить();
		ТаблицаСкидок.Сортировать("КоличествоОт");
		Для Каждого Стр из ТаблицаСкидок Цикл
			Если Количество >= Стр.КоличествоОт Тогда 
				Скидка = Стр.РазмерСкидки;
			КонецЕсли;		
		КонецЦикла;
	КонецЕсли;
	
	Возврат Скидка;
	
	
КонецФункции

