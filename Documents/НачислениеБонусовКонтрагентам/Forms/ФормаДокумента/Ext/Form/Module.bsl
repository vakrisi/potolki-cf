КонецПроцедуры

//++ 16254
&НаСервере
Процедура ЗаполнитьПоОстаткамНаСервере(ДатаСписания)
	
	// Ищем бонусы контрагентов с бонусами больше нуля
	Запрос = Новый Запрос;
	Если УчетБонусовПо = 1 Тогда
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	БонусыКонтрагентовОстатки.Контрагент КАК Контрагент,
		|	БонусыКонтрагентовОстатки.ДисконтнаяКарта КАК ДисконтнаяКарта,
		|	БонусыКонтрагентовОстатки.СуммаОстаток КАК Сумма
		|ИЗ
		|	РегистрНакопления.БонусыКонтрагентов.Остатки(&Период, ) КАК БонусыКонтрагентовОстатки
		|ГДЕ
		|	БонусыКонтрагентовОстатки.СуммаОстаток > 0
		|	И НЕ БонусыКонтрагентовОстатки.ДисконтнаяКарта = ЗНАЧЕНИЕ(Справочник.ДисконтныеКарты.ПустаяСсылка)";
	Иначе
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	БонусыКонтрагентовОстатки.Контрагент КАК Контрагент,
		|	БонусыКонтрагентовОстатки.ДисконтнаяКарта КАК ДисконтнаяКарта,
		|	БонусыКонтрагентовОстатки.СуммаОстаток КАК Сумма
		|ИЗ
		|	РегистрНакопления.БонусыКонтрагентов.Остатки(&Период, ) КАК БонусыКонтрагентовОстатки
		|ГДЕ
		|	БонусыКонтрагентовОстатки.СуммаОстаток > 0
		|	И БонусыКонтрагентовОстатки.ДисконтнаяКарта = ЗНАЧЕНИЕ(Справочник.ДисконтныеКарты.ПустаяСсылка)";
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Период", ДатаСписания);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Количество() = 0 Тогда
		Сообщить("Не удалось найти начисленных бонусов на дату " + ДатаСписания);
		Возврат;
	КонецЕсли;	
	Объект.СписаниеБонусов.Очистить();
	Пока Выборка.Следующий() Цикл
		НоваяЗапись = Объект.СписаниеБонусов.Добавить();
		НоваяЗапись.Контрагент = Выборка.Контрагент;
		НоваяЗапись.ДисконтнаяКарта = Выборка.ДисконтнаяКарта;
		НоваяЗапись.Сумма = Выборка.Сумма;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВводаДаты(Результат, ДополнительныеПараметры) Экспорт
	Если Результат = Неопределено ИЛИ НЕ ЗначениеЗаполнено(Результат.ВведеннаяДата) Тогда
		Возврат;
	КонецЕсли;
	ВведеннаяДата = Результат.ВведеннаяДата; 
	ЗаполнитьПоОстаткамНаСервере(ВведеннаяДата);
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПоОстаткам(Команда)
	ОповещениеПослеВводаДаты = Новый ОписаниеОповещения("ПослеВводаДаты", ЭтаФорма);
	ПараметрыФормыВводаДаты = Новый Структура("ДатаПоУмолчанию, Заголовок", ТекущаяДата(), "Введите дату на которую" + Символы.ПС + "будет определяться остаток");
	ОткрытьФорму("ОбщаяФорма.ФормаВводаДаты", ПараметрыФормыВводаДаты, ЭтаФорма, , , , ОповещениеПослеВводаДаты, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры

