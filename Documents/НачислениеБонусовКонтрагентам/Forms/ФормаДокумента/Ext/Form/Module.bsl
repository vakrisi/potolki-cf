#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Ключ.Пустая() Тогда
		
	Иначе
		ЭтаФорма.ТолькоПросмотр = ПраваПользователей.ДокументТолькоПросмотр(Объект.Ссылка);
	КонецЕсли;
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	ВидимостьДисконтнойКарты = Объект.СлужебныйУчетБонусовПоДисконтнымКартам; //Константы.УчетБонусовПоДисконтнымКартам.Получить();
	Элементы.БонусыДисконтнаяКарта.Видимость = ВидимостьДисконтнойКарты;
	Элементы.СписаниеБонусовДисконтнаяКарта.Видимость = ВидимостьДисконтнойКарты;
	
	ПраваПользователей.УстановитьТолькоПросмотрДляРеквизитаНомер(Элементы.Номер.ТолькоПросмотр);
	
	УчетБонусовПо = ?(Объект.СлужебныйУчетБонусовПоДисконтнымКартам, 1, 0);

КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	ДатыЗапретаИзменения.ОбъектПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ДобавитьПоГруппе(Команда)
	
	//ГруппаКонтрагентов = ОткрытьФормуМодально("Справочник.Контрагенты.ФормаВыбораГруппы");
	//Если ЗначениеЗаполнено(ГруппаКонтрагентов) Тогда 
	//	ДобавитьПоГруппеНаСервере(ГруппаКонтрагентов);
	//КонецЕсли;
	ИмяТЧ = "Бонусы";
	Если Команда.Имя = "ДобавитьПоГруппеСписание" Тогда
		ИмяТЧ = "СписаниеБонусов";
	КонецЕсли;
	ОписаниеОповещения = Новый ОписаниеОповещения("ДобавитьПоГруппеПриЗавершенииВыбора", ЭтотОбъект, ИмяТЧ);
	ОткрытьФорму("Справочник.Контрагенты.ФормаВыбораГруппы", , ЭтаФорма, ,,, ОписаниеОповещения);
	
КонецПроцедуры
	
&НаКлиенте
Процедура ДобавитьПоГруппеПриЗавершенииВыбора(Результат, ДопПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ДобавитьПоГруппеНаСервере(Результат, ДопПараметры);
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьПоГруппеНаСервере(ГруппаКонтрагентов, ИмяТЧ)
	
	//Если Константы.УчетБонусовПоКонтрагентам.Получить() Тогда
	Если НЕ Объект.СлужебныйУчетБонусовПоДисконтнымКартам Тогда	
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	Контрагенты.Ссылка КАК Контрагент
		|ИЗ
		|	Справочник.Контрагенты КАК Контрагенты
		|ГДЕ
		|	Контрагенты.Ссылка В ИЕРАРХИИ(&ГруппаКонтрагентов)";
		Запрос.УстановитьПараметр("ГруппаКонтрагентов",ГруппаКонтрагентов);
		
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			НоваяСтрока = Объект[ИмяТЧ].Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		КонецЦикла;
		
	//ИначеЕсли Константы.УчетБонусовПоДисконтнымКартам.Получить() Тогда
	Иначе	
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ДисконтныеКарты.Ссылка КАК ДисконтнаяКарта,
		|	ДисконтныеКарты.Владелец КАК Контрагент
		|ИЗ
		|	Справочник.ДисконтныеКарты КАК ДисконтныеКарты
		|ГДЕ
		|	ДисконтныеКарты.Владелец В ИЕРАРХИИ(&ГруппаКонтрагентов)";
		Запрос.УстановитьПараметр("ГруппаКонтрагентов",ГруппаКонтрагентов);
		
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			НоваяСтрока = Объект[ИмяТЧ].Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

