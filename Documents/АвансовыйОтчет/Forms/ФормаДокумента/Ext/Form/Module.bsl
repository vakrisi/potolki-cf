&НаСервере
Процедура ЗаполнитьКолонкиПоВыданнымАвансам()
	
	Для Каждого СтрокаАванса Из Объект.ВыданныеАвансы Цикл
		РеквизитыАванса = ПолучитьРеквизитыАванса(СтрокаАванса.Документ);
		ЗаполнитьЗначенияСвойств(СтрокаАванса, РеквизитыАванса);		
	КонецЦикла;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьДоговорКонтрагента(КонтрагентСсылка)
	Если ЗначениеЗаполнено(КонтрагентСсылка) Тогда 
		Возврат КонтрагентСсылка.ОсновнойДоговор;
	Иначе
		Возврат Справочники.ДоговорыКонтрагентов.ПустаяСсылка();
	КонецЕсли;
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьРеквизитыАванса(Знач ДокументСсылка)
	
	// РКО или СРС
	
	РеквизитыАванса = Новый Структура("Валюта, СуммаВыданная, ОсталосьРаспределить", Справочники.Валюты.ПустаяСсылка(), 0, 0);
	
	Если ЗначениеЗаполнено(ДокументСсылка) Тогда
		РеквизитыАванса = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументСсылка, Новый Структура("Валюта, СуммаВыданная", "Валюта", "Сумма"));
		РеквизитыАванса.Вставить("ОсталосьРаспределить", 0);
		
		ЗапросОстатка = Новый Запрос;
		ЗапросОстатка.УстановитьПараметр("ДокументВыдачиДС", ДокументСсылка);
		ЗапросОстатка.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РасчетыОстатки.СуммаОстаток КАК ОсталосьРаспределить
		|ИЗ
		|	РегистрНакопления.РасчетыСПодотчетникамиПоДокументамАвансов.Остатки(, ДокументВыдачиДС = &ДокументВыдачиДС) КАК РасчетыОстатки";
		ВыборкаОстатка = ЗапросОстатка.Выполнить().Выбрать();
		Если ВыборкаОстатка.Следующий() Тогда
			РеквизитыАванса.ОсталосьРаспределить = ВыборкаОстатка.ОсталосьРаспределить;
		КонецЕсли;
	КонецЕсли;
	
	Возврат РеквизитыАванса;
	
КонецФункции

// Функция помещает табличную часть ВыданныеАвансы во временное хранилище
// и возвращает адрес
//
&НаСервере
Функция ПоместитьВыданныеАвансыВХранилище()
	
	Возврат ПоместитьВоВременноеХранилище(
		Объект.ВыданныеАвансы.Выгрузить(,
			"Документ,
			|Сумма"
		),
		УникальныйИдентификатор
	);
	
КонецФункции // ПоместитьВыданныеАвансыВХранилище()

// Функция получает табличную часть ВыданныеАвансы из временного хранилища.
//
&НаСервере
Процедура ПолучитьВыданныеАвансыИзХранилища(АдресВыданныеАвансыВХранилище)
	
	ТаблицаВыданныеАвансы = ПолучитьИзВременногоХранилища(АдресВыданныеАвансыВХранилище);
	Объект.ВыданныеАвансы.Очистить();
	Для каждого СтрокаВыданныеАвансы Из ТаблицаВыданныеАвансы Цикл
		Строка = Объект.ВыданныеАвансы.Добавить();
		ЗаполнитьЗначенияСвойств(Строка, СтрокаВыданныеАвансы);
		
		//#14021
		РеквизитыАванса = ПолучитьРеквизитыАванса(Строка.Документ);
		ЗаполнитьЗначенияСвойств(Строка, РеквизитыАванса);
	КонецЦикла;
	
КонецПроцедуры // ПолучитьВыданныеАвансыИзХранилища()

&НаСервере
Процедура УстановитьОтметкуНезаполненногоСклада()
	
	ЗаполнениеОбязательно = Объект.Товары.Количество() > 0;	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "Склад",  "АвтоОтметкаНезаполненного", ЗаполнениеОбязательно);
	Если Не ЗаполнениеОбязательно Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "Склад",  "ОтметкаНезаполненного", Ложь);
	КонецЕсли;
	
КонецПроцедуры

