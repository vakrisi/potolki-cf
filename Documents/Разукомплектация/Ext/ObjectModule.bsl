#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
	
#Область ОбработкаСобытий
	
Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	ОбщийМодуль.ЗаполнитьШапкуДокумента(ЭтотОбъект);
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, Режим)
		
	ОбщаяДоляСтоимости = Товары.Итог("ДоляСтоимости");
	Если НЕ ОбщаяДоляСтоимости = 100 Тогда
		Сообщить("Доля стоимости всех получаемых товаров должна составлять 100%. В документе указано " + ОбщаяДоляСтоимости + "%");
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	//регистр ТоварыНаСкладах Расход Источника
	ТаблицаНоменклатур = Новый ТаблицаЗначений;
	ТаблицаНоменклатур.Колонки.Добавить("Номенклатура");
	ТаблицаНоменклатур.Колонки.Добавить("ХарактеристикаНоменклатуры");
	ТаблицаНоменклатур.Колонки.Добавить("СерияНоменклатуры");
	ТаблицаНоменклатур.Колонки.Добавить("Количество");
	ТаблицаНоменклатур.Колонки.Добавить("Коэффициент");
	
	НоваяСтрока = ТаблицаНоменклатур.Добавить();
	НоваяСтрока.Номенклатура = НоменклатураИсточник;
	НоваяСтрока.ХарактеристикаНоменклатуры = ХарактеристикаНоменклатурыИсточника;
	НоваяСтрока.СерияНоменклатуры = СерияНоменклатурыИсточника;
	НоваяСтрока.Количество = КоличествоИсточника;
	НоваяСтрока.Коэффициент = КоэффициентИсточника;
	
	//++ №8793 нужно свернуть, чтобы корректно списать себестоимость
	ТаблицаНоменклатур.Свернуть("Номенклатура, ХарактеристикаНоменклатуры, СерияНоменклатуры, Коэффициент", "Количество"); 
	//-- №8793
	
	ОрганизацияТоваров = Организация;
	Если Константы.ОбщиеСклады.Получить() Тогда
		ОрганизацияТоваров = Справочники.Организации.ПустаяСсылка();
	КонецЕсли;
	
	ДатаДвижения = Дата;
	Если ДатаДвижения = Дата(1,1,1) Тогда
		ДатаДвижения = ТекущаяДатаСеанса();
	КонецЕсли;
	Движения.ТоварыНаСкладах.Записывать = Истина;
	Отказ = НЕ Движения.ТоварыНаСкладах.КонтрольОстатков(Ссылка, ОрганизацияТоваров, СкладИсточник, ТаблицаНоменклатур, ДатаДвижения);
	Если Отказ Тогда
		Возврат;
	Иначе
		Для Каждого Товар Из ТаблицаНоменклатур Цикл
			Расход = Движения.ТоварыНаСкладах.Добавить();
			Расход.ВидДвижения = ВидДвиженияНакопления.Расход;
			Расход.Период = ДатаДвижения;
			Расход.Организация = ОрганизацияТоваров;
			Расход.Склад = СкладИсточник;
			Расход.Номенклатура = Товар.Номенклатура;
			Расход.ХарактеристикаНоменклатуры = Товар.ХарактеристикаНоменклатуры;
			Расход.СерияНоменклатуры = Товар.СерияНоменклатуры;
			Расход.Количество = Товар.Количество * Товар.Коэффициент;
			//#8288
			//Расход.Сумма = Расход.Количество * Движения.ТоварыНаСкладах.ПолучитьЦенуОстаткаНоменклатуры(ДатаДвижения, ОрганизацияТоваров, СкладИсточник, Расход.Номенклатура, Расход.ХарактеристикаНоменклатуры, Расход.СерияНоменклатуры);
			СтруктураЦенОстатков = Движения.ТоварыНаСкладах.ПолучитьЦеныОстаткаНоменклатуры(ДатаДвижения, ОрганизацияТоваров, СкладИсточник, Расход.Номенклатура, Расход.ХарактеристикаНоменклатуры, Расход.СерияНоменклатуры);
			Расход.Сумма = Расход.Количество * СтруктураЦенОстатков.Цена;
			Расход.СуммаВал = Расход.Количество * СтруктураЦенОстатков.ЦенаВал;
		КонецЦикла;
	КонецЕсли;
	
	//приход товаров-приемников
	ОбщаяСтоимостьСписания = Движения.ТоварыНаСкладах.ПолучитьЦенуОстаткаНоменклатуры(Дата, ОрганизацияТоваров, СкладИсточник, НоменклатураИсточник, ХарактеристикаНоменклатурыИсточника, СерияНоменклатурыИсточника);
	ОбщаяСтоимостьСписания = ОбщаяСтоимостьСписания * КоличествоИсточника * КоэффициентИсточника;
	
	ТаблицаНоменклатур = Новый ТаблицаЗначений;
	ТаблицаНоменклатур.Очистить();
	ТаблицаНоменклатур.Колонки.Добавить("Номенклатура");
	ТаблицаНоменклатур.Колонки.Добавить("ХарактеристикаНоменклатуры");
	ТаблицаНоменклатур.Колонки.Добавить("СерияНоменклатуры");
	ТаблицаНоменклатур.Колонки.Добавить("Количество");
	ТаблицаНоменклатур.Колонки.Добавить("Коэффициент");
	ТаблицаНоменклатур.Колонки.Добавить("Сумма");
	ТаблицаНоменклатур.Колонки.Добавить("ДоляСтоимости");
	
	Для Каждого ТекущаяСтрока Из Товары Цикл
		НоваяСтрока = ТаблицаНоменклатур.Добавить();
		НоваяСтрока.Номенклатура = ТекущаяСтрока.Номенклатура;
		НоваяСтрока.ХарактеристикаНоменклатуры = ТекущаяСтрока.ХарактеристикаНоменклатуры;
		НоваяСтрока.СерияНоменклатуры = ТекущаяСтрока.СерияНоменклатуры;
		НоваяСтрока.Количество = ТекущаяСтрока.Количество;
		НоваяСтрока.Коэффициент = ТекущаяСтрока.Коэффициент;
		НоваяСтрока.ДоляСтоимости = ТекущаяСтрока.ДоляСтоимости;
		НоваяСтрока.Сумма = (ТекущаяСтрока.ДоляСтоимости / 100) * ОбщаяСтоимостьСписания;
	КонецЦикла;
	
	Если НЕ ОбщаяСтоимостьСписания = ТаблицаНоменклатур.Итог("Сумма") Тогда
		ТаблицаНоменклатур[ТаблицаНоменклатур.Количество()].Сумма = ТаблицаНоменклатур[ТаблицаНоменклатур.Количество()].Сумма + (ОбщаяСтоимостьСписания - ТаблицаНоменклатур.Итог("Сумма"))
	КонецЕсли;
	
	Движения.ТоварыНаСкладах.Записывать = Истина;
	Для Каждого Товар Из ТаблицаНоменклатур Цикл
		Приход = Движения.ТоварыНаСкладах.Добавить();
		Приход.ВидДвижения = ВидДвиженияНакопления.Приход;
		Приход.Период = Дата;
		Приход.Организация = ОрганизацияТоваров;
		Приход.Склад = СкладПриемник;
		Приход.Номенклатура = Товар.Номенклатура;
		Приход.ХарактеристикаНоменклатуры = Товар.ХарактеристикаНоменклатуры;
		Приход.СерияНоменклатуры = Товар.СерияНоменклатуры;
		Приход.Количество = Товар.Количество * Товар.Коэффициент;
		Приход.Сумма = РаботаСВалютой.ПолучитьСуммуВВалютеУчетаПоДокументу(Ссылка, Товар.Сумма);
		Приход.СуммаВал = РаботаСВалютой.ПолучитьСуммуВДопВалютеУчетаПоДокументу(Ссылка, Товар.Сумма); //#8288
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли