&НаКлиенте
Процедура Печать(Команда)
	
	
	табД = ПечатьНаСервере();
	табД.Показать();
КонецПроцедуры

&НаСервере
Функция ПечатьНаСервере()
	
	
	ТабДок = Новый ТабличныйДокумент;	
	
	Макет = РеквизитФормыВЗначение("Объект").ПолучитьМакет("Макет");

	ОбластьМакета = Макет.ПолучитьОбласть("Шапка");
	ОбластьМакета.Параметры.Дата = формат(Объект.Дата, "ДФ=dd.MM.yyyy");
	ТабДок.Вывести(ОбластьМакета);
	
	Для каждого стр из Объект.ПрисутствиеРуководителей Цикл
		ОбластьМакета = Макет.ПолучитьОбласть("Участник");
		ОбластьМакета.Параметры.Участник = стр.Отделение.Наименование;
		ТабДок.Вывести(ОбластьМакета);
	КонецЦикла;
	
	ОбластьМакета = Макет.ПолучитьОбласть("Шапка2");
	ТабДок.Вывести(ОбластьМакета);
	
	Для каждого стр из Объект.ГлавныеСтатистики Цикл
		ОбластьМакета = Макет.ПолучитьОбласть("Статистика");
		ЗаполнитьЗначенияСвойств(ОбластьМакета.Параметры,стр);
		ТабДок.Вывести(ОбластьМакета);
	КонецЦикла;
	
	ОбластьМакета = Макет.ПолучитьОбласть("Шапка3");
	ТабДок.Вывести(ОбластьМакета);

	ОбластьМакета = Макет.ПолучитьОбласть("План");
	ТЗЗадачиБП = ВернутьПредставлениеБП();
	Для Каждого Стр Из ТЗЗадачиБП Цикл
		ОбластьМакета.Параметры.Заполнить(Стр);
		ТабДок.Вывести(ОбластьМакета);
	КонецЦикла;
	
	ОбластьМакета = Макет.ПолучитьОбласть("Шапка4");
	ОбластьМакета.Параметры.БлагодарностиШтрафы = Объект.БлагодарностиШтрафы;
	ТабДок.Вывести(ОбластьМакета);

	
	Возврат ТабДок;
		
КонецФункции

&НаСервере
Функция ВернутьПредставлениеБП()
		
	БоевойПланПредыдущий.Очистить();
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ИА_ПротоколЕженедельногоСобрания.Ссылка
	|ИЗ
	|	Документ.ИА_ПротоколЕженедельногоСобрания КАК ИА_ПротоколЕженедельногоСобрания
	|ГДЕ
	|	ИА_ПротоколЕженедельногоСобрания.Дата < &ДатаДок
	|	И НЕ ИА_ПротоколЕженедельногоСобрания.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	ИА_ПротоколЕженедельногоСобрания.Дата УБЫВ";
	
	ДатаДок = ?(ЗначениеЗаполнено(Объект.Ссылка),Объект.Дата, ТекущаяДата());
	Запрос.УстановитьПараметр("ДатаДок", ДатаДок);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	БоевойПланПредыдущий.Очистить();
	Если Выборка.Следующий() Тогда
		ЗначениеВРеквизитФормы(Выборка.Ссылка.БоевойПлан.Выгрузить(,"Отделение,План"),"БоевойПланПредыдущий");
	КонецЕсли;

	
	тзПредПланы = РеквизитФормыВЗначение("БоевойПланПредыдущий");
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	тзПредПланы.Отделение,
	|	тзПредПланы.План
	|ПОМЕСТИТЬ тзПредПланы
	|ИЗ
	|	&ТЗПред КАК тзПредПланы
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	тзТекПланы.Отделение,
	|	тзТекПланы.Проблемы,
	|	тзТекПланы.Достижения,
	|	тзТекПланы.План
	|ПОМЕСТИТЬ тзТекПланы
	|ИЗ
	|	&ТЗТек КАК тзТекПланы
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	тзТекПланы.Отделение КАК ОтдСсылка,
	|	тзТекПланы.План КАК ТекПлан,
	|	тзТекПланы.Проблемы,
	|	тзТекПланы.Достижения,
	|	тзПредПланы.План КАК ПредПлан
	|ИЗ
	|	тзТекПланы КАК тзТекПланы
	|		ЛЕВОЕ СОЕДИНЕНИЕ тзПредПланы КАК тзПредПланы
	|		ПО тзТекПланы.Отделение = тзПредПланы.Отделение";
	
	Запрос.УстановитьПараметр("ТЗПред", тзПредПланы);
	Запрос.УстановитьПараметр("ТЗТек", Объект.БоевойПлан.Выгрузить());
	
	Выборка = Запрос.Выполнить().Выбрать();	
	ТЗБП = Новый ТаблицаЗначений;
	ТЗБП.Колонки.Добавить("Отделение");
	ТЗБП.Колонки.Добавить("ПланПрошлый");
	ТЗБП.Колонки.Добавить("План");
	ТЗБП.Колонки.Добавить("Проблемы");
	ТЗБП.Колонки.Добавить("Достижения");
	
	Пока Выборка.Следующий() Цикл
		Новстр = ТЗБП.Добавить();		
		Новстр.Отделение = Выборка.ОтдСсылка.наименование;
		Новстр.Проблемы = Выборка.Проблемы;
		Новстр.Достижения = Выборка.Достижения;
		Если ЗначениеЗаполнено(Выборка.ПредПлан) Тогда
			Новстр.ПланПрошлый = ВернутьЗадачиБП(Выборка.ПредПлан,Истина);
		КонецЕсли;
		Новстр.План = ВернутьЗадачиБП(Выборка.ТекПлан,Ложь);
	КонецЦикла;
	
	Возврат ТЗБП;
КонецФункции

Функция ВернутьЗадачиБП(ПланСсылка, ВыгружатьТолькоВыполненные);
	ЗадачиБП = "";
	Шаги = Справочники.ИА_ЗадачиПлана.Выбрать(,ПланСсылка);
	
	Пока Шаги.Следующий() Цикл
		Если не шаги.ПометкаУдаления Тогда
			Если Шаги.Выполнено ИЛИ не ВыгружатьТолькоВыполненные Тогда
				ЗадачиБП = ЗадачиБП + Шаги.Содержание + "; ";
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Возврат ЗадачиБП;
КонецФункции

