&НаСервере
Процедура ДобавитьТекущуюЗаявкуВКалендарь()
	Если ЗначениеЗаполнено(Объект.ДатаРабот) И ЗначениеЗаполнено(Объект.ВремяНачалаРабот) Тогда	
		ЭлементыГрафика = РезультатПланировщик.Элементы;
		СоответствиеЗначений = Новый Соответствие;
		СоответствиеЗначений.Вставить("СервиснаяБригада", Объект.СервиснаяБригада);
		
		НовыйЭлемент = 
		ЭлементыГрафика.Добавить(СоединитьДатуИВремя(Объект.ДатаРабот , Объект.ВремяНачалаРабот), СоединитьДатуИВремя(Объект.ДатаРабот , Объект.ВремяОкончанияРабот));
		НовыйЭлемент.ЗначенияИзмерений  = Новый ФиксированноеСоответствие(СоответствиеЗначений);
		НовыйЭлемент.Значение = Неопределено;
		НовыйЭлемент.Текст    = Объект.Контрагент.Наименование + " (" + Объект.Адрес + ")";		
		НовыйЭлемент.ЦветФона = WebЦвета.СветлоЗеленый;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция ЗапланироватьРаботуПоЗаявке(ВремяНачалаРаботы = Неопределено, ВремяОкончанияРаботы=Неопределено, БригадаРаботы=Неопределено)
	
	//ВремяНачала = Константы.НачалоРабочегоВремениМонтажей.Получить();
	//ВремяКонца  = Константы.КонецРабочегоВремениМонтажей.Получить();
	//КоличествоИНтервалов30минут = (Число(Формат(ВремяКонца,"ДФ=ЧЧ")) - Число(Формат(ВремяНачала,"ДФ=ЧЧ"))) * 2;
	//
	//ВыбраннаяБригада = БригадаРаботы;
	//ВыбранноеВремя = Дата(0001,01,01,Час(ВремяНачала),Минута(ВремяНачала),Секунда(ВремяНачала)); 
	//
	//
	////определяем можно ли добавить замер определеной длины в выбраннй интервал
	//ДлинаМонтажаПоУмолчаниюВЧасах = Константы.КоличествоЧасовНеобходимыхНаМонтаж.Получить();
	//ВремяОкончанияМонтажа = ВыбранноеВремя + (Дата(1,1,1,Цел(ДлинаМонтажаПоУмолчаниюВЧасах),(ДлинаМонтажаПоУмолчаниюВЧасах - Цел(ДлинаМонтажаПоУмолчаниюВЧасах))*60,0)-Дата(1,1,1,0,0,0));
	///
	вр_ВремяНачалаРаботы = Дата(0001,01,01, Час(ВремяНачалаРаботы), Минута(ВремяНачалаРаботы), Секунда(ВремяНачалаРаботы));
	вр_ВремяОкончанияРаботы = Дата(0001,01,01, Час(ВремяОкончанияРаботы), Минута(ВремяОкончанияРаботы), Секунда(ВремяОкончанияРаботы));
	
	ИнтервалСвободный = ПроверитьСвободныйИнтервал(Дата(ВремяНачалаРаботы), вр_ВремяНачалаРаботы, вр_ВремяОкончанияРаботы, БригадаРаботы);
	Если НЕ ИнтервалСвободный Тогда
		Сообщить("В выбранное время заявку добавить нельзя, т.к. периоды заявок пересекаются", СтатусСообщения.Важное);
		Возврат Ложь;
	Иначе
		Объект.СервиснаяБригада = БригадаРаботы;
		Объект.ДатаРабот = Дата(ВремяНачалаРаботы); 
		Объект.ВремяНачалаРабот = ВремяНачалаРаботы;
		Объект.ВремяОкончанияРабот = ВремяОкончанияРаботы;
		ЗаполнитьИсполнителейБригады();
		ЭтаФорма.Модифицированность = Истина;
		Возврат Истина;
	КонецЕсли;
	
КонецФункции

&НаСервере
Функция ПроверитьСвободныйИнтервал(Дата, ВремяНачала, ВремяОкончания, Бригада)
	ИнтервалСвободный = Истина;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	УДАЛИТЬ_СервисныеЗаявки.Ссылка
	|ИЗ
	|	Документ.УДАЛИТЬ_СервисныеЗаявки КАК УДАЛИТЬ_СервисныеЗаявки
	|ГДЕ
	|	НАЧАЛОПЕРИОДА(УДАЛИТЬ_СервисныеЗаявки.ДатаРабот, ДЕНЬ) = НАЧАЛОПЕРИОДА(&Дата, ДЕНЬ)
	|	И УДАЛИТЬ_СервисныеЗаявки.СервиснаяБригада = &Бригада
	|	И (УДАЛИТЬ_СервисныеЗаявки.ВремяНачалаРабот >= &ВремяНачала    ИЛИ УДАЛИТЬ_СервисныеЗаявки.ВремяОкончанияРабот >= &ВремяНачала)
	|	И (УДАЛИТЬ_СервисныеЗаявки.ВремяНачалаРабот <= &ВремяОкончания ИЛИ УДАЛИТЬ_СервисныеЗаявки.ВремяОкончанияРабот <= &ВремяОкончания)
	|	И УДАЛИТЬ_СервисныеЗаявки.Ссылка <> &Ссылка
	|";
	Запрос.УстановитьПараметр("Дата", 			Дата);
	Запрос.УстановитьПараметр("Бригада",		Бригада);
	Запрос.УстановитьПараметр("ВремяНачала",	ВремяНачала + 1);
	Запрос.УстановитьПараметр("ВремяОкончания",	ВремяОкончания-1);
	Запрос.УстановитьПараметр("Ссылка", 		Объект.Ссылка);
	
	Выборка = Запрос.Выполнить().Выгрузить();
	Если Выборка.Количество() > 0 тогда
		ИнтервалСвободный = Ложь;
	Иначе
		ИнтервалСвободный = Истина;
	КонецЕсли;
	
	Возврат ИнтервалСвободный;
	
КонецФункции

