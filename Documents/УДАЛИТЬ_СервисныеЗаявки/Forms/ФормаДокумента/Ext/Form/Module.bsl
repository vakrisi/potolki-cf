&НаСервере
Функция СоединитьДатуИВремя(Дата, Время) 	
	ДатаСтрока = Формат(Дата, "ДФ=""ггггММдд""");
	ВремяСтрока = Формат(Время, "ДФ=""ЧЧммсс""");
	Рез = Дата(ДатаСтрока + ВремяСтрока);	
	Возврат Рез;	
КонецФункции

