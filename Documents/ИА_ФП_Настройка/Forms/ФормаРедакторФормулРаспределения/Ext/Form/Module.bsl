&НаСервере
Функция ЗаполнениеТаблицыПолитики(ТаблицаПолитика, ДеревоФомы, вхСальдо)
	ТЗ = ТаблицаПолитика.Выгрузить();
	
    ТЗ.Свернуть("Раздел,Подразделение,Статья");
    ТЗ.Колонки.Добавить("СуммаНал");
    ТЗ.Колонки.Добавить("СуммаБезнал"); 
    
    Сумма = 10000;
    Для каждого Стр Из ТЗ Цикл
    	Стр.СуммаБезнал = Сумма;
		Стр.СуммаНал = 0;
        Сумма = Сумма + 5000;
	КонецЦикла;
	
	ТабРазделы = ТЗ.Скопировать();
    ТабРазделы.Свернуть("Раздел", "СуммаНал, СуммаБезнал");
    
    Дерево = РеквизитФормыВЗначение(ДеревоФомы);
    Дерево.Строки.Очистить();
	Для каждого СтрРаздел Из ТабРазделы Цикл
		Если ИспРазделы Тогда
	    	ВеткаРаздел = Дерево.Строки.Добавить();
	        ЗаполнитьЗначенияСвойств(ВеткаРаздел, СтрРаздел);
			
			Если ДеревоФомы = "ДеревоПолитика1" Тогда
	        	ВеткаРаздел.Параметр = "[П1 Итог:"+СтрРаздел.Раздел+"]";
			Иначе
				ВеткаРаздел.Параметр = "[П2 Итог:"+СтрРаздел.Раздел+"]";
			КонецЕсли;
		Иначе
			ВеткаРаздел = Дерево;
		КонецЕсли;
        ТабДетали = ИА_БФС.ТЗ_ФильтрПоОтбору(ТЗ, Новый Структура("Раздел", СтрРаздел.Раздел));
        
        Для каждого Стр Из ТабДетали Цикл
        	СтрДетали = ВеткаРаздел.Строки.Добавить();
            ЗаполнитьЗначенияСвойств(СтрДетали, Стр);
			
			Если ДеревоФомы = "ДеревоПолитика1" Тогда
            	СтрДетали.Параметр = "[П1 Сумма:" + СтрДетали.Подразделение + "$" + СтрДетали.Статья + "]";
			Иначе
				СтрДетали.Параметр = "[П2 Сумма:" + СтрДетали.Подразделение + "$" + СтрДетали.Статья + "]";
			КонецЕсли;
			
			вхСальдо = вхСальдо - Стр.СуммаБезнал;
		КонецЦикла;  
		
		Если ИспРазделы Тогда
			СтрСКД = Дерево.Строки.Добавить();
			СтрСКД.Раздел = "СКД:";
			СтрСКД.СуммаБезнал = вхСальдо;
			Если ДеревоФомы = "ДеревоПолитика1" Тогда
	        	СтрСКД.Параметр = "[П1 СКД:"+СтрРаздел.Раздел+"]";
			Иначе
				СтрСКД.Параметр = "[П2 СКД:"+СтрРаздел.Раздел+"]";
			КонецЕсли;
		КонецЕсли;
    КонецЦикла;  
    ЗначениеВРеквизитФормы(Дерево, ДеревоФомы);
КонецФункции

