&НаКлиенте
Процедура СохранитьСостояниеМатрицыП1()
	Модифицированность = Истина;
	объект.Политика1.Очистить();
	
	Если ИспДоходыПодр Тогда
		для каждого стрПодр из МатрицаПолитика1.ПолучитьЭлементы() Цикл
			СохранитьСостояниеСтрокиМатрицыП1(стрПодр);
		КонецЦикла;
	Иначе
		СохранитьСостояниеСтрокиМатрицыП1(МатрицаПолитика1);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьСостояниеСтрокиМатрицыП1(СтрокаМатр)
		
	для каждого стрФонд из СтрокаМатр.ПолучитьЭлементы() Цикл
		Если не стрФонд.Фонд.пустая() Тогда
			ОбДоходы = новый массив;
			Для каждого стрДоход из Объект.ВидыДоходов Цикл
				Если ОбДоходы.Найти(стрДоход.ИДСтроки) = Неопределено Тогда
					ОбДоходы.Добавить(стрДоход.ИДСтроки);
				Иначе
					Продолжить;
				КонецЕсли;
				
				Если ИспДоходыПодр Тогда
					СтрокиДохПоПодр = Объект.ВидыДоходов.НайтиСтроки(Новый Структура("Подразделение, ВидДохода", СтрокаМатр.Подразделение, стрДоход.ВидДохода));	
					Если СтрокиДохПоПодр.Количество() = 0 тогда
						Продолжить;
					КонецЕсли;
				КонецЕсли;
				
				Новстр = Объект.Политика1.Добавить();
				ЗаполнитьЗначенияСвойств(Новстр, стрДоход);
				ЗаполнитьЗначенияСвойств(Новстр, стрФонд);
				Новстр.Статья =  стрФонд.Фонд;
				
				Если стрФонд["СпособРасчета_"+стрДоход.ИДСтроки].Пустая() Тогда
					стрФонд["СпособРасчета_"+стрДоход.ИДСтроки] = предопределенноезначение("Перечисление.ИА_РежимРасчетаСуммы.Процент");
					стрФонд["Картинка_"+стрДоход.ИДСтроки] = 2;
				КонецЕсли;
				
				Новстр.СпособРасчета =  стрФонд["СпособРасчета_"+стрДоход.ИДСтроки];		
				Новстр.Значение =  стрФонд["Значение_"+стрДоход.ИДСтроки];
				Новстр.Сумма =  стрФонд["Сумма_"+стрДоход.ИДСтроки];
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура МатрицаПолитика1ПриАктивизацииЯчейки(Элемент)
	ТекСтрока = Элементы.МатрицаПолитика1.ТекущиеДанные;
	Если ТекСтрока <> Неопределено Тогда
		ТекЭл = Элемент.ТекущийЭлемент;
				
		Если найти(ТекЭл.Имя,"МатрицаПолитика1Значение_")>0 и не (ИспДоходыПодр и ТекСтрока.ПолучитьРодителя() = Неопределено) Тогда
			ид = прав(ТекЭл.Имя,32);
			способ = ТекСтрока["СпособРасчета_"+ид];
			
			элемЗнач = элементы["МатрицаПолитика1Значение_"+ид];
			//элемЗнач.ТолькоПросмотр = Ложь;
			Если    способ = ПредопределенноеЗначение("Перечисление.ИА_РежимРасчетаСуммы.Процент")
			    ИЛИ способ = ПредопределенноеЗначение("Перечисление.ИА_РежимРасчетаСуммы.ФиксированнаяСумма")
			    ИЛИ способ = ПредопределенноеЗначение("Перечисление.ИА_РежимРасчетаСуммы.РучнойВвод")
			    Тогда
				квЧ =  Новый КвалификаторыЧисла(15,2);
			    элемЗнач.ОграничениеТипа = Новый ОписаниеТипов("Число", квЧ);
			ИначеЕсли    способ = ПредопределенноеЗначение("Перечисление.ИА_РежимРасчетаСуммы.ВычисляемоеВыражение") Тогда
			    элемЗнач.ОграничениеТипа = Новый ОписаниеТипов("Строка",,Новый КвалификаторыСтроки(0));
			Иначе
			    элемЗнач.ОграничениеТипа = Новый ОписаниеТипов();
				элемЗнач.ТолькоПросмотр = истина;
			КонецЕсли; 
		КонецЕсли; 
		
    КонецЕсли;
КонецПроцедуры


&НаКлиенте
Процедура МатрицаПолитика1СуммаПриИзменении(Элемент)
	ОбновитьИтогиМатрицы();
	ПересчитатьРасходы();
	ЗаполнитьДеревоРасходы();
	ОбновитьИтогиРасходов();
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьИтогиМатрицы()
	Если ИспДоходыПодр Тогда
		ОбщийИтог = 0;
		для каждого стр из МатрицаПолитика1.ПолучитьЭлементы() Цикл
			врИтог = ОбновитьИтогиМатрицыПоСтроке(стр);
			стр.Итого = врИтог;
			ОбщийИтог = ОбщийИтог + врИтог;
		КонецЦикла;
	Иначе
		ОбщийИтог = ОбновитьИтогиМатрицыПоСтроке(МатрицаПолитика1);
	КонецЕсли;
	
	Элементы.МатрицаПолитика1Итого.ТекстПодвала = Формат(ОбщийИтог,"ЧДЦ=2; ЧН=");
	
	для каждого стрДоход из Объект.ВидыДоходов Цикл		
		ид = стрДоход.ИДСтроки;
		Если ид="" Тогда
			Продолжить;
		КонецЕсли;
		
		ИтогДоход = 0;
		ИмяКолСумма = "Сумма_"+ид;
		Если ИспДоходыПодр ТОгда
			для каждого стрПодр из МатрицаПолитика1.ПолучитьЭлементы() Цикл							
				ИтогПоПодр = 0;
				для каждого стрФонд из стрПодр.ПолучитьЭлементы() Цикл							
					ИтогПоПодр = ИтогПоПодр + стрФонд[ИмяКолСумма];
				КонецЦикла;
				стрПодр[ИмяКолСумма] = ИтогПоПодр;
				ИтогДоход = ИтогДоход + ИтогПоПодр;
			КонецЦикла;
		Иначе
			для каждого стрФонд из МатрицаПолитика1.ПолучитьЭлементы() Цикл							
				ИтогДоход = ИтогДоход + стрФонд[ИмяКолСумма];
			КонецЦикла;
		КонецЕсли;
		
		Элементы["МатрицаПолитика1"+ИмяКолСумма].ТекстПодвала = Формат(ИтогДоход,"ЧДЦ=2; ЧН=");
		
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Функция ОбновитьИтогиМатрицыПоСтроке(строкаМатр)
	ОбщийИтог = 0;
	для каждого стрФонд из строкаМатр.ПолучитьЭлементы() Цикл
		ИтогФонда = 0;
		СущИд = новый массив;
		для каждого стрДоход из Объект.ВидыДоходов Цикл
			ид = стрДоход.ИДСтроки;
			Если ид = "" или СущИд.Найти(ид)<>Неопределено тогда 
				Продолжить;
			КонецЕсли;
			
			ИмяКолСумма = "Сумма_"+ид;
			ИтогФонда = ИтогФонда + стрФонд[ИмяКолСумма];
			
			СущИд.Добавить(ид);
		КонецЦикла;
		стрФонд.Итого = ИтогФонда;
		ОбщийИтог = ОбщийИтог +ИтогФонда; 
	КонецЦикла;
	
	Возврат ОбщийИтог;
КонецФункции

&НаКлиенте
Процедура МатрицаПолитика1Выбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	если найти(поле.имя,"Картинка_")>0 Тогда
		СтандартнаяОбработка = ложь;
		
		ид = прав(поле.имя,32);
		Если не МатрицаПолитика1.НайтиПоИдентификатору(ВыбраннаяСтрока)["Доступность_" + ид] Тогда
			возврат;
		КонецЕсли;
			
		допПарам = Новый Структура("ид,ВыбраннаяСтрока",ид,ВыбраннаяСтрока);
		оп = новый ОписаниеОповещения("ИзменениеСпособаРед", ЭтотОбъект, допПарам);
		
		сп = новый СписокЗначений;
		//сп.Добавить(ПредопределенноеЗначение("Перечисление.ИА_РежимРасчетаСуммы.РучнойВвод"));
		//сп.Добавить(ПредопределенноеЗначение("Перечисление.ИА_РежимРасчетаСуммы.ФиксированнаяСумма"));
		сп.Добавить(ПредопределенноеЗначение("Перечисление.ИА_РежимРасчетаСуммы.Процент"));
		сп.Добавить(ПредопределенноеЗначение("Перечисление.ИА_РежимРасчетаСуммы.ВычисляемоеВыражение"));		
		
		ПоказатьВыборИзСписка(оп,сп,Поле);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ИзменениеСпособаРед(выбЗн, дп) Экспорт
	Если выбЗн <> Неопределено Тогда
		стр = МатрицаПолитика1.НайтиПоИдентификатору(дп.ВыбраннаяСтрока);
		стр["СпособРасчета_"+ дп.ид] = выбЗн.Значение;
		стр["Картинка_"+ дп.ид] = НомерКартинки(выбЗн.Значение);
		//СохранитьСостояниеМатрицыП1();
		МатрицаПолитика1ПриИзменении(Неопределено);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьСкрытьСуммы(Команда)
	Элементы.МатрицаПолитика1ПоказатьСкрытьСуммы.Пометка = не Элементы.МатрицаПолитика1ПоказатьСкрытьСуммы.Пометка;
	для каждого видД из Объект.ВидыДоходов Цикл
		Элементы["МатрицаПолитика1Сумма_"+видД.ИдСтроки].видимость = Элементы.МатрицаПолитика1ПоказатьСкрытьСуммы.Пометка;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьРасход(Команда)
	
	тд = Элементы.Расходы.ТекущиеДанные;
	Если тд = Неопределено Тогда 
		возврат;
	КонецЕсли;
	
	
	Если тд.ТипСтроки = ПредопределенноеЗначение("Перечисление.КСУ_ВидыСтрокТБ.ПеременныеРасходы")  Тогда
		ПоказатьПредупреждение(,"Переменные расходы настраиваются выше, в разеделе ""Добавление и настройка переменных расходов""!");
		Возврат;
	КонецЕсли;
	
	Если тд.ТипСтроки = ПредопределенноеЗначение("Перечисление.КСУ_ВидыСтрокТБ.МаржинальнаяПрибыль")  Тогда
		ПоказатьПредупреждение(,"Это рассчитанная строка маржинальной прибыли. В нее фонды нельзя добавлять!");
		Возврат;
	КонецЕсли;
	
	Если тд.ТипСтроки = ПредопределенноеЗначение("Перечисление.КСУ_ВидыСтрокТБ.ИтогКЗаливке") Тогда
		ПоказатьПредупреждение(,"Это итоговая строка. В нее фонды нельзя добавлять!");
		Возврат;
	КонецЕсли;

	
	Если не (тд.ТипСтроки = ПредопределенноеЗначение("Перечисление.КСУ_ВидыСтрокТБ.ПостоянныеРасходы") 
		ИЛИ тд.ТипСтроки = ПредопределенноеЗначение("Перечисление.КСУ_ВидыСтрокТБ.УчредительскиеФонды")) Тогда
		ПоказатьПредупреждение(,"Добавлять фонды можно только в разделы: Постоянные расходы, Учредительские фонды!");
		Возврат;
	КонецЕсли;
	
	ТекРод = тд.ПолучитьРодителя();
	Если ТекРод <> Неопределено и тд.ТипСтроки = ТекРод.ТипСтроки Тогда
		тд = ТекРод;
	КонецЕсли;
	
	//  
	если ИспПодразделения и не ИспДоходыПодр Тогда
		Парам = новый Структура("тд", тд);
		Оповещение = Новый ОписаниеОповещения("ПослеВводаЗначенияПодразделенияВРасходы", ЭтотОбъект, Парам);
		зн = ПредопределенноеЗначение("Справочник.ИА_ЦФО.ПустаяСсылка");
		ПоказатьВводЗначения(Оповещение,зн,"Выберите подразделение");
	Иначе
		ДобавитьФОндВРасходы(тд, тд.Подразделение);
	КонецЕсли;
	
	//
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВводаЗначенияПодразделенияВРасходы(ВыбЗнач, Параметры) Экспорт
	Если ВыбЗнач<>Неопределено Тогда
		ДобавитьФОндВРасходы(Параметры.тд, ВыбЗнач);
    КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьФОндВРасходы(тд, Подр = Неопределено)
	ИсключитьФонды = ПолучитьИсключаемыеФондыРасходов(Неопределено, Подр);
	ОпОп = Новый ОписаниеОповещения("ВводФондаВРасходыЗавершение",ЭтотОбъект, Новый Структура("ТекРод, Подразделение", тд, Подр));
	отборФ = новый Структура("ПометкаУдаления", Ложь);
	ОткрытьФорму("Справочник.ИА_Фонды.ФормаВыбора", Новый структура("ИсключитьФонды, отбор",ИсключитьФонды,отборФ), ЭтаФорма,,,, ОпОп, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры

&НаКлиенте
Процедура ВводФондаВРасходыЗавершение(ВыбЗн, ДопПарам) Экспорт
	Если ВыбЗн <> Неопределено ТОгда
		тд = ДопПарам.ТекРод;
		
		новстр = тд.ПолучитьЭлементы().Добавить();

		Если ИспДоходыПодр ТОгда	
			новстр.подразделение = тд.ПолучитьРодителя().Подразделение;
			новстр.ПодразделениеСтрока = строка(новстр.Подразделение);
		Иначе
			новстр.подразделение = ДопПарам.Подразделение;
		КонецЕсли;
		новстр.ТипСтроки = тд.ТипСтроки;
		новстр.Фонд = ВыбЗн;
		
		СохранитьРасходы();
		
		Элементы.Расходы.ТекущаяСтрока = новстр.ПолучитьИдентификатор();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура РасходыПриАктивизацииСтроки(Элемент)
	тд = Элементы.Расходы.ТекущиеДанные;
	
	доступноДоб = тд <> Неопределено и 
	(тд.ТипСтроки = ПредопределенноеЗначение("Перечисление.КСУ_ВидыСтрокТБ.ПостоянныеРасходы") ИЛИ тд.ТипСтроки = ПредопределенноеЗначение("Перечисление.КСУ_ВидыСтрокТБ.УчредительскиеФонды"));
	
	//Элементы.РасходыДобавить.Доступность = доступноДоб; 
	Элементы.РасходыПереместитьВверх.Доступность = доступноДоб И тд.ЭтоЗаголовок = ложь;
	Элементы.РасходыПереместитьВниз.Доступность = доступноДоб И тд.ЭтоЗаголовок = ложь;
	Элементы.РасходыУдалить.Доступность = доступноДоб И тд.ЭтоЗаголовок = ложь;
	
КонецПроцедуры

&НаКлиенте
Процедура РасходыПередУдалением(Элемент, Отказ)
	тд = Элементы.Расходы.ТекущиеДанные;
	МожноУдалить = 
	(тд.ТипСтроки = ПредопределенноеЗначение("Перечисление.КСУ_ВидыСтрокТБ.ПостоянныеРасходы") 
	ИЛИ тд.ТипСтроки = ПредопределенноеЗначение("Перечисление.КСУ_ВидыСтрокТБ.УчредительскиеФонды")) и тд.ЭтоЗаголовок = ложь;
	если МожноУдалить = ложь Тогда
		отказ = Истина;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура РасходыПриИзменении(Элемент)
	СохранитьРасходы();
	ОбновитьИтогиРасходов();
КонецПроцедуры

&НаКлиенте
Процедура СохранитьРасходы()
	Модифицированность = Истина;
	объект.Расчет.Очистить();
	объект.УчредительскиеФонды.Очистить();
	объект.ИтогоКЗаливке.Очистить();
	
	Если ИспДоходыПодр Тогда
		для каждого стрПодр из Расходы.ПолучитьЭлементы() Цикл
			ЗаписатьРасходы(стрПодр.ПолучитьЭлементы());
		КонецЦикла;
	Иначе
		ЗаписатьРасходы(Расходы.ПолучитьЭлементы());
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьРасходы(источникСтроки)
	Для каждого стр из источникСтроки Цикл
		Если стр.ТипСтроки = ПредопределенноеЗначение("Перечисление.КСУ_ВидыСтрокТБ.ПостоянныеРасходы") Тогда;
			для каждого стрФонд из стр.ПолучитьЭлементы() Цикл
				Новстр = Объект.Расчет.Добавить();
				ЗаполнитьЗначенияСвойств(Новстр, стрФонд);
			КонецЦикла;
		ИначеЕсли стр.ТипСтроки = ПредопределенноеЗначение("Перечисление.КСУ_ВидыСтрокТБ.УчредительскиеФонды") Тогда;
			для каждого стрФонд из стр.ПолучитьЭлементы() Цикл
				Новстр = Объект.УчредительскиеФонды.Добавить();
				ЗаполнитьЗначенияСвойств(Новстр, стрФонд);
			КонецЦикла;
		ИначеЕсли стр.ТипСтроки = ПредопределенноеЗначение("Перечисление.КСУ_ВидыСтрокТБ.ИтогКЗаливке") Тогда;
			Новстр = Объект.ИтогоКЗаливке.Добавить();
			ЗаполнитьЗначенияСвойств(Новстр, стр);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура РасходыПослеУдаления(Элемент)
	СохранитьРасходы();
	
	ПересчитатьИтогоКРаспределению();
	
	ОбновитьИтогиРасходов();
	
	Модифицированность = истина;
КонецПроцедуры

&НаКлиенте
Процедура РасходыСуммаПриИзменении(Элемент)
	// сумма может меняться только по постоянным расходам. Пересчет постоянных расходов	
	тд = Элементы.Расходы.ТекущиеДанные; 
	
	СтрРодитель = тд.ПолучитьРодителя().ПолучитьРодителя();
	Если СтрРодитель = Неопределено Тогда
		СтрРодитель = Расходы;
	КонецЕсли;
	СтрИтогоКРаспр = Неопределено;
	Для каждого стрРаздел из СтрРодитель.ПолучитьЭлементы() Цикл
		Если стрРаздел.ТипСтроки = ПредопределенноеЗначение("Перечисление.КСУ_ВидыСтрокТБ.ИтогКЗаливке") Тогда
			СтрИтогоКРаспр = стрРаздел;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если СтрИтогоКРаспр = Неопределено тогда
		возврат;
	КонецЕсли;
	
	
	ИтогоПоНеделям = 0;
	для счНед = 1 по КолНедель Цикл
		если СтрИтогоКРаспр.Сумма = 0 Тогда
			тд["Неделя" + счНед] = 0;
		Иначе
			тд["Неделя" + счНед] = окр(тд.Сумма * (СтрИтогоКРаспр["Неделя" + счНед] / СтрИтогоКРаспр.Сумма));
		КонецЕсли;
		ИтогоПоНеделям = ИтогоПоНеделям + тд["Неделя" + счНед];
	КонецЦикла;
	
	// корректировка округления. Последняя неделя
	тд["Неделя" + КолНедель] = тд["Неделя" + КолНедель] + (тд.Сумма - ИтогоПоНеделям);
	
КонецПроцедуры

