&НаКлиенте
Функция Итог(имяТЧ,ИмяКолонки)
	рез = 0;
	для каждого стр из Объект[имяТЧ] Цикл
		рез = рез + стр[ИмяКолонки];
	КонецЦикла;
	Возврат рез;
КонецФункции
	
&НаКлиенте
Функция ОбновитьИтогКолонкиРасхода(Строки, кол)
	ИтогКолонки = 0;
	для каждого СТРполитика из Строки Цикл
		
		Если СТРполитика.ТипСтроки = ПредопределенноеЗначение("Перечисление.КСУ_ВидыСтрокТБ.МаржинальнаяПрибыль") ИЛИ
			СТРполитика.ТипСтроки = ПредопределенноеЗначение("Перечисление.КСУ_ВидыСтрокТБ.ИтогКЗаливке") Тогда
			Продолжить;
		КонецЕсли;
		ИтогПолитики = 0;
		для каждого СТРфонд из СТРполитика.ПолучитьЭлементы() Цикл
			
			Если СТРфонд.ТипСтроки = ПредопределенноеЗначение("Перечисление.КСУ_ВидыСтрокТБ.МаржинальнаяПрибыль") ИЛИ
				СТРфонд.ТипСтроки = ПредопределенноеЗначение("Перечисление.КСУ_ВидыСтрокТБ.ИтогКЗаливке") Тогда
				Продолжить;
			КонецЕсли;
		
			ИтогКолонки = ИтогКолонки + СТРфонд[кол];
			ИтогПолитики = ИтогПолитики + СТРфонд[кол];
			СТРфонд.ПодразделениеСтрока = строка(СТРфонд.Подразделение);
		КонецЦикла;
		СТРполитика[кол] = ИтогПолитики;
		//СТРполитика.ПодразделениеСтрока = строка(СТРполитика.Подразделение);
	КонецЦикла;
	
	возврат ИтогКолонки;
КонецФункции

&НаСервереБезКонтекста
Процедура ПечатьТБ_серверВывестиДоходы(макет, табдок, КолНедель, строки, ИспДоходыПодр=ложь)
	для каждого стрДоход из строки Цикл
		обл = макет.ПолучитьОбласть("КолонкаГруппа");
		обл.Параметры.КолонкаГруппа = ?(ИспДоходыПодр, "- ","") + стрДоход.ВидДохода;
		табДок.Вывести(Обл);
		
		обл = макет.ПолучитьОбласть("КолонкаСумма");
		обл.Параметры.Сумма = стрДоход["Сумма"];
		табДок.Присоединить(обл);
		Для сч = 1 по КолНедель Цикл
			обл = макет.ПолучитьОбласть("КолонкаСумма");
			обл.Параметры.Сумма = стрДоход["Неделя"+сч];
			табДок.Присоединить(обл);
		КонецЦикла;
	КонецЦикла;		
КонецПроцедуры
	
&НаСервере
Функция ПечатьТБ_сервер()
		
	табДок = Новый ТабличныйДокумент;
	Макет = Документы.ИА_ФП_Настройка.ПолучитьМакет("Макет");
	
	обл = макет.ПолучитьОбласть("Шапка");
	обл.Параметры.Номер = Объект.Номер;
	обл.Параметры.месяц = врег(формат(Объект.Месяц,"ДФ='MMMM yyyy'"));
	табДок.Вывести(Обл);
	
	обл = макет.ПолучитьОбласть("Заголовок");
	обл.Параметры.Заголовок = "ДОХОДЫ:";
	табДок.Вывести(Обл);
	
	
	//// ДОХОДЫ шапка
	обл = макет.ПолучитьОбласть("КолонкаГруппаШапка");
	обл.Параметры.КолонкаГруппа = "Вид дохода";
	табДок.Вывести(Обл);
	обл = макет.ПолучитьОбласть("КолонкаСуммаШапка");
	обл.Параметры.Сумма = "Сумма";
	табДок.Присоединить(обл);
	
	ИмяЭлДоходы = ?(ИспДоходыПодр, "ВидыДоходовПодрНеделя", "ВидыДоходовНеделя");

	для счСкр = 1 по КолНедель Цикл
		ИмяКолонки = ИмяЭлДоходы +счСкр;
		элем = Элементы[ИмяКолонки];
		
		обл = макет.ПолучитьОбласть("КолонкаСуммаШапка");
		обл.Параметры.Сумма = элем.Заголовок;
		табДок.Присоединить(обл);	
	КонецЦикла;
	
	//// ДОХОДЫ Строки
	Если ИспДоходыПодр Тогда
		тзПодр = Объект.ВидыДоходов.Выгрузить();
		тзПодр.Свернуть("Подразделение");
		для каждого стрПодр из тзПодр Цикл
			строкиДохода = Объект.ВидыДоходов.НайтиСтроки(новый Структура("Подразделение",стрПодр.Подразделение)); 
			
			обл = макет.ПолучитьОбласть("КолонкаГруппаЖ");
			обл.Параметры.КолонкаГруппа = стрПодр.Подразделение;
			табДок.Вывести(Обл);
			
			////////////// итоги
			// сумма
			обл = макет.ПолучитьОбласть("КолонкаСуммаЖ");
			ИтогоСуммаПодр = 0;
			для каждого стрД из строкиДохода Цикл
				ИтогоСуммаПодр = ИтогоСуммаПодр + стрД.Сумма;
			КонецЦикла;
			обл.Параметры.Сумма = ИтогоСуммаПодр;
			табДок.Присоединить(обл);
			
			// недели
			Для сч = 1 по КолНедель Цикл
				обл = макет.ПолучитьОбласть("КолонкаСуммаЖ");
				ИтогоСуммаПодр = 0;
				для каждого стрД из строкиДохода Цикл
					ИтогоСуммаПодр = ИтогоСуммаПодр + стрД["Неделя"+сч];
				КонецЦикла;
				обл.Параметры.Сумма = ИтогоСуммаПодр;
				табДок.Присоединить(обл);
			КонецЦикла;

			////////// строки
			ПечатьТБ_серверВывестиДоходы(макет, табдок, КолНедель, строкиДохода, истина);
		КонецЦикла;
	Иначе
		ПечатьТБ_серверВывестиДоходы(макет, табдок, КолНедель, Объект.ВидыДоходов);
	КонецЕсли;
	
	///////////// РАСХОДЫ
	
	обл = макет.ПолучитьОбласть("Заголовок");
	обл.Параметры.Заголовок = "РАСХОДЫ:";
	табДок.Вывести(Обл);
	
	
	//// РАСХОДЫ шапка
	постф = ?(ИспПодразделения, "Подр", "");
	
	обл = макет.ПолучитьОбласть("КолонкаГруппаШапка"+постф);
	обл.Параметры.КолонкаГруппа = "Фонд";
	табДок.Вывести(Обл);
	обл = макет.ПолучитьОбласть("КолонкаСуммаШапка");
	обл.Параметры.Сумма = "Сумма";
	табДок.Присоединить(обл);
	
	для счСкр = 1 по КолНедель Цикл
		ИмяКолонки = ИмяЭлДоходы+счСкр;
		элем = Элементы[ИмяКолонки];
		
		обл = макет.ПолучитьОбласть("КолонкаСуммаШапка");
		обл.Параметры.Сумма = элем.Заголовок;
		табДок.Присоединить(обл);				
	КонецЦикла;
	
	//// РАСХОДЫ Строки
	для каждого стрПолитика из Расходы.ПолучитьЭлементы() Цикл
		обл = макет.ПолучитьОбласть("КолонкаГруппаЖ"+постф);
		обл.Параметры.КолонкаГруппа = ?(ИспПодразделения, стрПолитика.Подразделение, стрПолитика.Фонд);
		табДок.Вывести(Обл);
		
		обл = макет.ПолучитьОбласть("КолонкаСуммаЖ");
		обл.Параметры.Сумма = стрПолитика["Сумма"];
		табДок.Присоединить(обл);
		Для сч = 1 по КолНедель Цикл
			обл = макет.ПолучитьОбласть("КолонкаСуммаЖ");
			обл.Параметры.Сумма = стрПолитика["Неделя"+сч];
			табДок.Присоединить(обл);
		КонецЦикла;
		
		Для каждого стрФонд из стрПолитика.получитьЭлементы() Цикл
			обл = макет.ПолучитьОбласть("КолонкаГруппа"+постф);
			Если ИспПодразделения Тогда
				обл.Параметры.Подразделение = стрФонд.Подразделение;
				обл.Параметры.Фонд = стрФонд.Фонд;
			Иначе
				обл.Параметры.КолонкаГруппа = " -" + стрФонд.Фонд;
			КонецЕсли;
			табДок.Вывести(Обл);
			
			обл = макет.ПолучитьОбласть("КолонкаСумма");
			обл.Параметры.Сумма = стрФонд["Сумма"];
			табДок.Присоединить(обл);
			Для сч = 1 по КолНедель Цикл
				обл = макет.ПолучитьОбласть("КолонкаСумма");
				обл.Параметры.Сумма = стрФонд["Неделя"+сч];
				табДок.Присоединить(обл);
			КонецЦикла;
			
			Если ИспДоходыПодр Тогда
				Для каждого стрФонд1 из стрФонд.получитьЭлементы() Цикл
					обл = макет.ПолучитьОбласть("КолонкаГруппа"+постф);
					обл.Параметры.Фонд = стрФонд1.Фонд;
					табДок.Вывести(Обл);
					
					обл = макет.ПолучитьОбласть("КолонкаСумма");
					обл.Параметры.Сумма = стрФонд1["Сумма"];
					табДок.Присоединить(обл);
					Для сч = 1 по КолНедель Цикл
						обл = макет.ПолучитьОбласть("КолонкаСумма");
						обл.Параметры.Сумма = стрФонд1["Неделя"+сч];
						табДок.Присоединить(обл);
					КонецЦикла;
				КонецЦикла;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	
	обл = макет.ПолучитьОбласть("Подвал");
	табДок.Вывести(Обл);
	
	табДок.АвтоМасштаб = Истина;
	возврат табДок;
КонецФункции

