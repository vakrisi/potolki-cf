&НаСервере
Процедура ЗаполнитьСуммыНаСервере()
	ИсточникЗаполнения = Новый Соответствие;
    Для каждого Стр Из Объект.ВидыДоходов Цикл
    	ИсточникЗаполнения.Вставить(Стр.ИДСтроки, Стр.ВидДохода);
    КонецЦикла;       
    Для каждого Стр Из Объект.Политика1 Цикл
    	Стр.ВидДохода = ИсточникЗаполнения [Стр.ИДСтроки]; 
	КонецЦикла;	
	ДокНастройка = РеквизитФормыВЗначение("Объект");	
	//
	
	ДокФП = Документы.ИА_ФинансовоеПланирование.СоздатьДокумент();
	ДокФП.Дата = ТекущаяДата();
	ДокФП.Организация = объект.Организация;
	
	Для счНед = 1 по КолНедель Цикл
		КолонкаНед = "Неделя"+счНед;
		
		ДокФП.ДоходыИтого.Очистить();
		для каждого стр из объект.ДоходыИтого Цикл
			новстр = ДокФП.ДоходыИтого.Добавить();
			новстр.ВидДохода = стр.ВидДохода;
			новстр.Подразделение = стр.Подразделение;
			//новстр.СуммаБезнал = стр.сумма;
			новстр.СуммаБезнал = стр[КолонкаНед];
		КонецЦикла;
		
		ИА_ФПСервер.ЗаполнитьДокумент(ДокФП, ложь, ложь, истина, ложь, ложь, ложь, Неопределено, истина, ДокНастройка, ИспДоходыПодр);
		
		для каждого стр из ДокФП.Политика1 цикл
			отбор = Новый структура("ВидДохода,Подразделение,Статья", стр.ВидДохода, стр.Подразделение, стр.Статья);
			Нстроки = Объект.Политика1.НайтиСтроки(отбор);
			Если Нстроки.количество()>0 ТОгда
				//Нстроки[0].Сумма = стр.Сумма;
				Нстроки[0][КолонкаНед] = стр.Сумма;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	// итоговая сумма
	для каждого стрП1 из Объект.Политика1 цикл
		стрП1.сумма = 0;
		Для счНед = 1 по КолНедель Цикл
			КолонкаНед = "Неделя"+счНед;
			стрП1.сумма = стрП1.сумма + стрП1[КолонкаНед];
		КонецЦикла;
	КонецЦикла;
	
	//
	ЗагрузитьДанныеМатрицы();
КонецПроцедуры

