&НаСервере
Процедура ОтметитьПревышение(Подразделение, ВидДохода, обнулить = ложь)
	Отб = новый Структура("Подразделение,ВидДохода", Подразделение, ВидДохода);
	нсСТроки = объект.ОтложенныйДоход.НайтиСтроки(Отб);
	Для каждого стр из нсСТроки Цикл
		стр.Превышение = истина;
		Если обнулить Тогда
			Сообщить("Сумма отложенного дохода превышает сумму дохода!");
			стр.Сумма = 0;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры
	
&НаСервере
Процедура ПересчитатьДоходыИтого()
	
	Объект.ДоходыИтого.Очистить();
	Для каждого стр из Объект.ВидыДоходов Цикл
		Новстр = Объект.ДоходыИтого.Добавить();
		ЗаполнитьЗначенияСвойств(Новстр, стр, , "СуммаОтложенныйДоход");
		Новстр.СуммаПлан = стр.Сумма;
	КонецЦикла;
	
	// подготовка таблицы отложенного дохода
	Для каждого стр из Объект.ОтложенныйДоход Цикл
		стр.превышение = ложь;	
	КонецЦикла;
	
	тзОтложДок = Объект.ОтложенныйДоход.Выгрузить();
	тзОтлож = Новый ТаблицаЗначений;
	тзОтлож.Колонки.Добавить("Подразделение");
	тзОтлож.Колонки.Добавить("ВидДохода");
	тзОтлож.Колонки.Добавить("Сумма");
	Для каждого стр из тзОтложДок Цикл
		Новстр = тзОтлож.Добавить();
		ЗаполнитьЗначенияСвойств(Новстр, стр);
		
		Если стр.ТипОперации = Перечисления.КСУ_ОперацииСОтложеннымДоходом.Отложить Тогда
			Новстр.Сумма = - Новстр.Сумма;
		КонецЕсли;
	КонецЦикла;
	тзОтлож.Свернуть("Подразделение, ВидДохода", "Сумма");
	
	// заполнение колонки отложенного дохода
	Для каждого стр из тзОтлож Цикл
		Если стр.Сумма = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Если ИспПодразделения Тогда
			нСтр = Объект.ДоходыИтого.НайтиСтроки(новый структура("Подразделение,ВидДохода", Стр.Подразделение, стр.ВидДохода));
		Иначе
			нСтр = Объект.ДоходыИтого.НайтиСтроки(новый структура("ВидДохода", стр.ВидДохода));
		КонецЕсли;
		
		Если нстр.количество() = 0 Тогда
			Если стр.Сумма > 0 Тогда
				тд = Объект.ДоходыИтого.Добавить();
				тд.ВидДохода = стр.ВидДохода;
				тд.Подразделение = стр.Подразделение;
			Иначе
				//Сообщить("Доход "+стр.ВидДохода+" не должен быть отрицательным. Сначала добавьте данный вид дохода в раздел Доходы, затем его можно будет отложить!");
				ОтметитьПревышение(стр.Подразделение, стр.ВидДохода , истина);
				Продолжить;
			КонецЕсли;
		Иначе
			тд = нстр[0];
		КонецЕсли;
		
		тд.СуммаОтложенныйДоход = стр.Сумма;
	КонецЦикла;

			
	// Пересчет сумм таблицы доходов
	Для каждого стр из Объект.ДоходыИтого Цикл
		Если стр.СуммаОтложенныйДоход = 0 Тогда // ничего не надо делать
			Продолжить;
		КонецЕсли;
		
		Если стр.СуммаПлан + стр.СуммаОтложенныйДоход < 0 Тогда
			//Сообщить("Доход "+стр.ВидДохода+" не должен быть отрицательным. Отложенный доход больше самого дохода!");
			ОтметитьПревышение(стр.Подразделение, стр.ВидДохода);
		КонецЕсли;
		
		стр.Сумма = стр.СуммаПлан + стр.СуммаОтложенныйДоход;
		
		ВсеНули = истина;
		для счНед = 1 по КолНедель Цикл
			Если стр["неделя"+счНед] <> 0 Тогда
				ВсеНули = ложь;
				прервать;
			КонецЕсли;
		КонецЦикла;
		ЗаполнитьНедельныеСуммыСтрокиПропорционально(стр, ВсеНули);
		//КонецЕсли;
	КонецЦикла;
	
	ОбновитьИтогоВЗаливку();
КонецПроцедуры

