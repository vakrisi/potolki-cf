Процедура МесяцПриИзмененииНаСервере()
	Запрос = новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	МИНИМУМ(ИА_РаспределениеНедель.Период) КАК Период,
	               |	МАКСИМУМ(ИА_РаспределениеНедель.КонецНедели) КАК КонецНедели
	               |ИЗ
	               |	РегистрСведений.ИА_РаспределениеНедель КАК ИА_РаспределениеНедель
	               |ГДЕ
	               |	ИА_РаспределениеНедель.Месяц = &Месяц";
	Запрос.УстановитьПараметр("Месяц", Объект.Месяц);
	Выборка = запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Объект.ДатаНачала = Выборка.Период;
		Объект.ДатаКонца = Выборка.КонецНедели;
	КонецЕсли;
	
	ОбновитьНедельныеПредставленияКолонок();
	ЗаполнитьДеревоРасходы();
	
