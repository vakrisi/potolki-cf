		эл.КнопкаВыбора = истина;
		эл.Ширина = 6;
		эл.РастягиватьПоГоризонтали = ложь;
		эл.ГоризонтальноеПоложениеВШапке=ГоризонтальноеПоложениеЭлемента.Центр;

		
		эл = СоздатьЭлементКолонку(ИмяКолКарт, ГруппаВд, цв);
		эл.Вид = ВидПоляФормы.ПолеКартинки;
		эл.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Нет;
		эл.ГоризонтальноеПоложениеВШапке=ГоризонтальноеПоложениеЭлемента.Центр;
		эл.КартинкаЗначений = БиблиотекаКартинок.КСУ_СпособыЗаполненияПолитики1;
		эл.РастягиватьПоГоризонтали = ложь;
		эл.Ширина = 1;
		
				
		эл = СоздатьЭлементКолонку(ИмяКолСумма, ГруппаВд, цв);		
		эл.толькоПросмотр = истина;
		эл.ГоризонтальноеПоложениеВПодвале = ГоризонтальноеПоложениеЭлемента.Право;
		эл.УстановитьДействие("ПриИзменении", "МатрицаПолитика1СуммаПриИзменении"); 		
		//эл.Шрифт = новый Шрифт(эл.Шрифт,,,,ложь,истина);
		эл.формат = "ЧДЦ=2";
		эл.Ширина = 9;
		эл.РастягиватьПоГоризонтали = ложь;
		эл.Видимость = ФП_По_ТБ;
		эл.ТолькоПросмотр = истина;
		эл.ГоризонтальноеПоложениеВШапке=ГоризонтальноеПоложениеЭлемента.Центр;
		
		// уо
		ЭлементОформления = УсловноеОформление.Элементы.Добавить();
		ЭлементОтбора = ЭлементОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("МатрицаПолитика1." + ИмяКолДоступность); 
		ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		ЭлементОтбора.ПравоеЗначение = ложь;
		ЭлементОтбора.Использование = Истина;

		ЭлементОформления.Оформление.УстановитьЗначениеПараметра("ЦветФона", Новый Цвет(230,230,230));
		ЭлементОформления.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", истина);

		ПолеОформления = ЭлементОформления.Поля.Элементы.Добавить();
		ПолеОформления.Поле = Новый ПолеКомпоновкиДанных("МатрицаПолитика1" + ИмяКолСР);
		ПолеОформления.Использование = Истина;
		
		ПолеОформления = ЭлементОформления.Поля.Элементы.Добавить();
		ПолеОформления.Поле = Новый ПолеКомпоновкиДанных("МатрицаПолитика1" + ИмяКолКарт);
		ПолеОформления.Использование = Истина;
		
		ПолеОформления = ЭлементОформления.Поля.Элементы.Добавить();
		ПолеОформления.Поле = Новый ПолеКомпоновкиДанных("МатрицаПолитика1" + ИмяКолЗН);
		ПолеОформления.Использование = Истина;
		
		ПолеОформления = ЭлементОформления.Поля.Элементы.Добавить();
		ПолеОформления.Поле = Новый ПолеКомпоновкиДанных("МатрицаПолитика1" + ИмяКолСумма);
		ПолеОформления.Использование = Истина;
	КонецЦикла;
	
	
КонецПроцедуры

&НаКлиенте
Процедура МатрицаЗначениеНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	ТекСтрока = Элементы.МатрицаПолитика1.ТекущиеДанные;
	Если ТекСтрока <> Неопределено Тогда
		ид = прав(Элемент.Имя,32);
		способ = ТекСтрока["СпособРасчета_"+ид];
		Если способ = ПредопределенноеЗначение("Перечисление.ИА_РежимРасчетаСуммы.ВычисляемоеВыражение") Тогда
		   	СтандартнаяОбработка = Ложь;      
			ПараметрыФормулы = СформироватьПараметрыФормулы(Элемент.ТекстРедактирования);
			Данные = Неопределено;
			
			ОткрытьФорму("Документ.ИА_ФП_Настройка.Форма.ФормаРедакторФормулРаспределения", 
					Новый Структура("ПараметрыФормулы", ПараметрыФормулы),ЭтаФорма,,,, 
					Новый ОписаниеОповещения("Распределение1ЗначениеНачалоВыбораЗавершение", ЭтотОбъект, Новый Структура("ТекСтрока,ИД", ТекСтрока,ид)), РежимОткрытияОкнаФормы.БлокироватьОкноВладельца); 
	    КонецЕсли; 
	КонецЕсли;       
КонецПроцедуры

&НаСервере
Функция СоздатьЭлементКолонку(ИмяКол, ГруппаВд, цв)
	НовыйЭлементФормы = Элементы.Добавить("МатрицаПолитика1" + ИмяКол, Тип("ПолеФормы"),ГруппаВд);
	НовыйЭлементФормы.Вид = ВидПоляФормы.ПолеВвода;
	НовыйЭлементФормы.ПутьКДанным = "МатрицаПолитика1." + ИмяКол;
	//НовыйЭлементФормы.ЦветФонаЗаголовка = цв;
	//НовыйЭлементФормы.ЦветФонаПодвала = цв;
	НовыйЭлементФормы.АвтоМаксимальнаяШирина = ложь;
	
	возврат НовыйЭлементФормы;
КонецФункции

&НаСервере
Процедура ОбновитьНедельныеПредставленияКолонок()
	Если не ФП_По_ТБ Тогда
		возврат;
	КонецЕсли;
	
	Если Объект.ДатаНачала = дата(1,1,1) ИЛИ Объект.ДатаКонца = дата(1,1,1) ИЛИ Объект.ДатаКонца<Объект.ДатаНачала Тогда
		Возврат;
	КонецЕсли;
	
	колДней = (Объект.ДатаКонца - Объект.ДатаНачала) / (60*60*24) + 1;
	ЗапросНед = ПолучитьЗапросСНеделями();
	
	//ОбновитьНедельноеПредставлениеДоходов(ЗапросНед, ОбновитьДоходы);
	ЗапросНед.Текст = "ВЫБРАТЬ
	                  |	Недели.НачалоНедели КАК НачалоНедели,
	                  |	Недели.КонецНедели КАК КонецНедели,
	                  |	Недели.КолДней КАК КолДней
	                  |ИЗ
	                  |	Недели КАК Недели
	                  |УПОРЯДОЧИТЬ ПО
	                  |	НачалоНедели";	
		
	ТЗ = ЗапросНед.Выполнить().Выгрузить();
	ЗначениеВРеквизитФормы(тз, "Тз_Недели");
	КолНедель = ТЗ.количество();
	
	ОбновитьЗаголовкиИВидимостьКолонок(ЗапросНед);
КонецПроцедуры


&НаСервере
Процедура ОбновитьЗаголовкиИВидимостьКолонок(ЗапросНед)
		
	// видимость колонок, заголовки
	для счСкр = 1 по 12 Цикл
		
		// ДОХОДЫ
		ИмяКолонкиДанных = "Неделя"+счСкр;
		Если ИспДоходыПодр Тогда
			ИмяКолонкиЭл = "ВидыДоходовПодрНеделя"+счСкр;
		Иначе
			ИмяКолонкиЭл = "ВидыДоходовНеделя"+счСкр;
		КонецЕсли;
		ИмяКолДоходыИтого = "ИтогоВЗаливкуНеделя"+счСкр;
				
		Если счСкр<=КолНедель Тогда
			Элементы[ИмяКолонкиЭл].Видимость = истина;
			Элементы[ИмяКолДоходыИтого].Видимость = истина;
			
			стрНед = Тз_Недели[счСкр-1];
			колДнейВНеделе = (стрНед.КонецНедели - стрНед.НачалоНедели) / (60*60*24) + 1;
			ЗагКолонки = формат(стрНед.НачалоНедели,"ДФ=dd.MM") + " - " + формат(стрНед.КонецНедели,"ДФ=dd.MM") + " ( "+колДнейВНеделе+" дн )";
			Элементы[ИмяКолонкиЭл].Заголовок = ЗагКолонки;
			Элементы[ИмяКолДоходыИтого].Заголовок = ЗагКолонки;
		ИНаче
			Элементы[ИмяКолонкиЭл].Видимость = ложь;
			Элементы[ИмяКолДоходыИтого].Видимость = ложь;

			для каждого стрДох из объект.ВидыДоходов Цикл
				стрДох[ИмяКолонкиДанных] = 0;
			КонецЦикла;
			для каждого стрДох из объект.ДоходыИтого Цикл
				стрДох[ИмяКолонкиДанных] = 0;
			КонецЦикла;
		КонецЕсли;
		
		Элементы[ИмяКолонкиЭл].ТекстПодвала = формат(объект.ВидыДоходов.Итог(ИмяКолонкиДанных),"ЧДЦ=0; ЧН=");
		
		// РАСХОДЫ
		
		Если счСкр > КолНедель Тогда
			для каждого стрП1 из объект.Политика1 Цикл
				стрП1[ИмяКолонкиДанных] = 0;
			КонецЦикла;
			для каждого стрП1 из объект.Маржа Цикл
				стрП1[ИмяКолонкиДанных] = 0;
			КонецЦикла;
			для каждого стрП1 из объект.УчредительскиеФонды Цикл
				стрП1[ИмяКолонкиДанных] = 0;
			КонецЦикла;
			для каждого стрП1 из объект.ИтогоКЗаливке Цикл
				стрП1[ИмяКолонкиДанных] = 0;
			КонецЦикла;
			для каждого стрП1 из объект.Расчет Цикл
				стрП1[ИмяКолонкиДанных] = 0;
			КонецЦикла;
		КонецЕсли;
			
		ИмяКолонки = "РасходыНеделя"+счСкр;
		Элементы[ИмяКолонки].Видимость = счСкр<= КолНедель;
		
		Если счСкр<=КолНедель Тогда
			ЗагКолонки = формат(стрНед.НачалоНедели,"ДФ=dd.MM") + " - " + формат(стрНед.КонецНедели,"ДФ=dd.MM")+ " ( "+колДнейВНеделе+" дн )";
			Элементы[ИмяКолонки].Заголовок = ЗагКолонки;
		ИНаче
			для каждого стрп из Расходы.ПолучитьЭлементы() Цикл
				для каждого стрФ из стрп.ПолучитьЭлементы() Цикл
					стрФ["Неделя"+счСкр] = 0;
					для каждого стрФ1 из стрФ.ПолучитьЭлементы() Цикл
						стрФ1["Неделя"+счСкр] = 0;
					КонецЦикла;
				КонецЦикла;
			КонецЦикла;
		КонецЕсли;

	КонецЦикла;	
КонецПроцедуры


&НаСервере
Функция ПолучитьЗапросСНеделями() 
		
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = новый МенеджерВременныхТаблиц;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ИА_РаспределениеНедель.Период КАК НачалоНедели,
	               |	ИА_РаспределениеНедель.КонецНедели КАК КонецНедели,
	               |	КОЛИЧЕСТВО(Периоды.Период) КАК КолДней
	               |ПОМЕСТИТЬ Недели
	               |ИЗ
	               |	РегистрСведений.ИА_РаспределениеНедель КАК ИА_РаспределениеНедель
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИА_Календарь КАК Периоды
	               |		ПО (Периоды.Период МЕЖДУ ИА_РаспределениеНедель.Период И ИА_РаспределениеНедель.КонецНедели)
	               |ГДЕ
	               |	ИА_РаспределениеНедель.Месяц = &Месяц
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ИА_РаспределениеНедель.Период,
	               |	ИА_РаспределениеНедель.КонецНедели";
	Запрос.УстановитьПараметр("Месяц", Объект.Месяц);	
	Запрос.Выполнить();
	
	Возврат Запрос;
	
КонецФункции


