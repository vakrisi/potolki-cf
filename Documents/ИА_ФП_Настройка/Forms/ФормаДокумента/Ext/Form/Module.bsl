&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
		
    ОчиститьМатрицуП1(); 
	
	Если ФП_По_ТБ и ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
		
		/////
		// Доходы
		/////
		ИтогоДоход = 0;
		ДЛя каждого стр из Объект.ВидыДоходов Цикл
			Если стр.Сумма <> (стр.Неделя1 + стр.Неделя2 + стр.Неделя3 + стр.Неделя4 + стр.Неделя5 + стр.Неделя6
				+стр.Неделя7 + стр.Неделя8 + стр.Неделя9 + стр.Неделя10 + стр.Неделя11 + стр.Неделя12) ТОгда
				ПоказатьПредупреждение(,"В строке дохода "+ стр.ВидДохода + " сумма за месяц не совпадает с суммой по неделям!");
				Отказ = Истина;
				Возврат;
			КонецЕсли;
			ИтогоДоход = ИтогоДоход + стр.Сумма;
		КонецЦикла;
		
		Если ИтогоДоход = 0 и ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
			ПоказатьПредупреждение(,"В ТБ указаны нулевые доходы или нет источников дохода вообще. Проверьте раздел доходов.");
			Отказ = Истина;
			Возврат;
		КонецЕсли;
		
		/////
		// переменные расходы
		/////
		
		мФонды = новый Соответствие;
		ДЛя каждого стр из Объект.Политика1 Цикл
			СтрИд = строка(стр.Статья) + строка(стр.Подразделение);
			Если мФонды.Получить(СтрИд) = Неопределено тогда
				мФонды.Вставить(СтрИд, ложь);
			КонецЕсли;
			
			Если ЗначениеЗаполнено(стр.Значение) тогда
				мФонды[СтрИд] = истина;
			КонецЕсли;
			
			Если стр.Сумма <> (стр.Неделя1 + стр.Неделя2 + стр.Неделя3 + стр.Неделя4 + стр.Неделя5 + стр.Неделя6
				+стр.Неделя7 + стр.Неделя8 + стр.Неделя9 + стр.Неделя10 + стр.Неделя11 + стр.Неделя12) ТОгда
				ПоказатьПредупреждение(,"В строке переменных расходов "+ стр.Статья + " сумма за месяц не совпадает с суммой по неделям!");
				Отказ = Истина;
				Возврат;
			КонецЕсли;
		КонецЦикла;
		
		Для каждого КлФонд из мФонды цикл
			если КлФонд.Значение = ложь тогда
				ПоказатьПредупреждение(, "В разделе ""ПЕРМЕННЫЕ РАСХОДЫ"" обнаружены фонды без правил заливки. Каждый фонд в этом разделе должен иметь хотя бы одно правило заливки, либо он должен быть исключен из списка фондов в этом разделе.");
				Отказ = Истина;
				возврат;
			КонецЕсли;
		КонецЦикла;
		
		/////
		// постоянные расходы
		/////
		
		мФонды = новый Соответствие;
		ДЛя каждого стр из Объект.Расчет Цикл
			СтрИд = строка(стр.Фонд) + строка(стр.Подразделение);
			Если мФонды.Получить(СтрИд) = Неопределено тогда
				мФонды.Вставить(СтрИд, ложь);
			КонецЕсли;
			
			Если ЗначениеЗаполнено(стр.Сумма) тогда
				мФонды[СтрИд] = истина;
			КонецЕсли;
			
			Если стр.Сумма <> (стр.Неделя1 + стр.Неделя2 + стр.Неделя3 + стр.Неделя4 + стр.Неделя5 + стр.Неделя6
				+стр.Неделя7 + стр.Неделя8 + стр.Неделя9 + стр.Неделя10 + стр.Неделя11 + стр.Неделя12) ТОгда
				ПоказатьПредупреждение(,"В строке постоянных расходов "+ стр.Фонд + " сумма за месяц не совпадает с суммой по неделям!");
				Отказ = Истина;
				Возврат;
			КонецЕсли;
		КонецЦикла;
		
		Для каждого КлФонд из мФонды цикл
			если КлФонд.Значение = ложь тогда
				ПоказатьПредупреждение(, "В разделе ""ПОСТОЯННЫЕ РАСХОДЫ"" обнаружены фонды с нулевыми расходами на месяц. ТБ будет утверждена с нулями. Если вы решите исправить это, отмените ТБ, внесите правки, а затем снова утвердите ТБ.");
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		итогоДоходы = 0;
		итогоРасходы = 0;
		
		Для каждого стр из Объект.ДоходыИтого Цикл
			итогоДоходы = итогоДоходы + стр.Сумма;
		КонецЦикла;
		
		Для каждого стр из Объект.Политика1 Цикл
			итогоРасходы = итогоРасходы + стр.Сумма;
		КонецЦикла;
		
		/////
		// Фонды из маржи
		/////
		
		мФонды = новый Соответствие;
		Для каждого стр из Объект.УчредительскиеФонды Цикл
			СтрИд = строка(стр.Фонд) + строка(стр.Подразделение);
			Если мФонды.Получить(СтрИд) = Неопределено тогда
				мФонды.Вставить(СтрИд, ложь);
			КонецЕсли;
			
			Если ЗначениеЗаполнено(стр.Процент) тогда
				мФонды[СтрИд] = истина;
			КонецЕсли;
			
			итогоРасходы = итогоРасходы + стр.Сумма;
		КонецЦикла;
		
		Для каждого КлФонд из мФонды цикл
			если КлФонд.Значение = ложь тогда
				ПоказатьПредупреждение(, "В разделе ""ФОНДЫ ИЗ МАРЖИ"" обнаружены фонды без указания % от маржи. У каждый фонда в этом разделе должен быть указан % от маржи, либо он должен быть исключен из списка фондов в этом разделе.");
				Отказ = Истина;
				возврат;
			КонецЕсли;
		КонецЦикла;
		
		
		///////////////
		
		Для каждого стр из Объект.Расчет Цикл						
			итогоРасходы = итогоРасходы + стр.Сумма;
		КонецЦикла;
		
		Если итогоДоходы<>итогоРасходы Тогда
			ПоказатьПредупреждение(,"Внимание! Расходы не совпадают с доходами");
			Отказ = Истина;
			Возврат;
		КонецЕсли;
	
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура Распределение1ПриАктивизацииЯчейки(Элемент)
    УстановкаОтбораТипа_Распределение1();
КонецПроцедуры


&НаКлиенте
Процедура Распределение1ЗначениеНачалоВыбораЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	ТекСтрока = ДополнительныеПараметры.ТекСтрока;	
	ид = ДополнительныеПараметры.ид;	
	Данные = Результат;
	Если ТипЗнч(Данные) = Тип("Структура") Тогда
		ТекСтрока["Значение_"+ид] = Данные.ТекстФормулы;
		//СохранитьСостояниеМатрицыП1();
		МатрицаПолитика1ПриИзменении(Неопределено);
		Модифицированность = Истина;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция СформироватьПараметрыФормулы(ТекЗначение)	
    ПараметрыФормулы = Новый Структура();
	
	ПараметрыФормулы.Вставить("ТекстФормулы", ТекЗначение);
	
	Результат = Объект.ВидыДоходов.Выгрузить().ВыгрузитьКолонку("ВидДохода");	
	ПараметрыФормулы.Вставить("Доходы", результат);
	
	Результат = ИА_БФС.ТЗ2ТЗФ(Объект.Политика1.Выгрузить());	
	ПараметрыФормулы.Вставить("Политика1", Истина);
	ПараметрыФормулы.Вставить("ТаблицаПолитика1", результат);
	
	Результат = ИА_БФС.ТЗ2ТЗФ(Объект.Политика2.Выгрузить());	
	ПараметрыФормулы.Вставить("Политика2", Истина);
	ПараметрыФормулы.Вставить("ТаблицаПолитика2", результат);
	
	ПараметрыФормулы.Вставить("ФП_По_ТБ", ФП_По_ТБ);
	
    Возврат ПараметрыФормулы;

КонецФункции

&НаКлиенте
Процедура ВидыДоходовПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
