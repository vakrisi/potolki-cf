&НаКлиенте
Функция ПолучитьИсключаемыеДоходы(тс)
	ИсключитьДоходы = новый массив;
	
	для каждого стр из Объект.ВидыДоходов Цикл
		Если ЗначениеЗаполнено(стр.ВидДохода) и стр <> тс Тогда
			ИсключитьДоходы.Добавить(стр.ВидДохода);
		КонецЕсли;
	КонецЦикла;
	
	Возврат ИсключитьДоходы;
КонецФункции

&НаКлиенте
Процедура ВидыДоходовВидДоходаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СтандартнаяОбработка = ложь;
	
	тс = Элементы.ВидыДоходов.ТекущиеДанные;
	ИсключитьДоходы = ПолучитьИсключаемыеДоходы(тс);
	
	Парам = Новый Структура("ИсключитьДоходы", ИсключитьДоходы);
	оп = новый ОписаниеОповещения("ЗавершениеВыбораДохода", ЭтотОбъект, новый Структура("НоваяСтрока", ложь));
	ОткрытьФорму("Справочник.ИА_ВидыДоходов.ФормаВыбора", Парам, ЭтаФорма, , ,, оп, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры

&НаКлиенте
Процедура ЗавершениеВыбораДохода(РезультатЗакрытия, ДопПарам) Экспорт
	Если РезультатЗакрытия<>Неопределено Тогда
		Если ДопПарам.НоваяСтрока Тогда
			Новстр = Объект.ВидыДоходов.Добавить();
			Новстр.ВидДохода = РезультатЗакрытия;
			Новстр.ИДСтроки = иа_БФКС.СформироватьУИД();
			Новстр.СпособЗаполнения = ПредопределенноеЗначение("Перечисление.ИА_ВариантыПолученияДанныхВидыДоходов.Вручную");
			
			Элементы.ВидыДоходов.ТекущаяСтрока = Новстр.ПолучитьИдентификатор();
		Иначе
			Элементы.ВидыДоходов.ТекущиеДанные.ВидДохода = РезультатЗакрытия;
		КонецЕсли;
		
		ВидыДоходовВидДоходаПриИзменении(Неопределено);
		ВидыДоходовПриИзменении(Неопределено);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ВидыДоходовПодрВидДоходаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	тд = Элементы.ВидыДоходовПодр.ТекущиеДанные;
	Если тд<>Неопределено И тд.получитьРодителя() <> Неопределено Тогда // строка с видом дохода
		СтандартнаяОбработка = ложь;
		
		ИсключитьДоходы = новый массив;
		для каждого стр из тд.получитьРодителя().ПолучитьЭлементы() Цикл
			Если ЗначениеЗаполнено(стр.ВидДохода) и стр <> тд Тогда
				ИсключитьДоходы.Добавить(стр.ВидДохода);
			КонецЕсли;
		КонецЦикла;
	
		ПарамФорм = Новый Структура("ИсключитьДоходы", ИсключитьДоходы);
		ПарамОп = новый Структура("тд", тд);
		оп = новый ОписаниеОповещения("ПослеВводаЗначенияВидаДохода1", ЭтотОбъект, ПарамОп);
		ОткрытьФорму("Справочник.ИА_ВидыДоходов.ФормаВыбора", ПарамФорм, ЭтаФорма, , ,, оп, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПослеВводаЗначенияВидаДохода1(ВыбЗнач, Параметры) Экспорт
	Если ВыбЗнач<>Неопределено Тогда
		тд = Параметры.тд;
		    	
		тд.ВидДохода = ВыбЗнач;
		тд.ИДСтроки = СформироватьУИДДохода(ВыбЗнач);
		
		ВидыДоходовПриИзменении(Неопределено);
		
		Элементы.ВидыДоходовПодр.ТекущаяСтрока = тд.получитьИдентификатор();
    КонецЕсли;
КонецПроцедуры


&НаКлиенте
Процедура ОтложенныйДоходВидДоходаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	масс = новый массив;
	ДЛя каждого стр из Объект.ВидыДоходов Цикл
		Если масс.Найти(стр.ВидДохода) = Неопределено Тогда
			масс.Добавить(стр.ВидДохода);
		КонецЕсли;
	КонецЦикла;
	
	Элемент.СписокВыбора.ЗагрузитьЗначения(масс);
