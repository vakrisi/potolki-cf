&НаКлиенте
Процедура ПредставлениеПериодаРегистрацииНачалоВыбораЗавершение(ВыбранныйПериод, ДополнительныеПараметры) Экспорт 
	
	Если ВыбранныйПериод <> Неопределено Тогда
		
		Объект.Месяц = ВыбранныйПериод;
		ОбновитьПредставлениеМесяца();
		
		//
		МесяцПриИзмененииНаСервере();
		Объект.Дата = Объект.ДатаНачала;
		ОбновитьПредставлениеДиапазона();
		//
		Если ИспДоходыПодр Тогда
			ЗаполнитьДеревоДоходыПоПодразделениям();
			
			Для каждого стрПодр из Доходы.ПолучитьЭлементы() цикл
				Для каждого стр из стрПодр.ПолучитьЭлементы() цикл
					стр.НезависимыйРежим = ложь;
					ЗаполнитьНедельныеСуммыПропорционально(стр.ПолучитьИдентификатор(), "Доходы");
				КонецЦикла;
			КонецЦикла;
			ВидыДоходовПриИзменении(Элементы.ВидыДоходовПодр);
		Иначе
			Для каждого стр из Объект.ВидыДоходов цикл
				стр.НезависимыйРежим = ложь;
				ЗаполнитьНедельныеСуммыПропорционально(стр.ПолучитьИдентификатор(), "ВидыДоходов");
			КонецЦикла;
			
			ВидыДоходовПриИзменении(Элементы.ВидыДоходов);
		КонецЕсли;
		//
		ОбновитьИтогиРасходов();
		//
		
		Элементы.ГруппаТело.Доступность = ЗначениеЗаполнено(объект.Месяц);

		
		ОбновитьНадписьКнопкиОтДохода();
		
	КонецЕсли;
	
