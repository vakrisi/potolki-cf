&НаКлиенте
Процедура МатрицаПолитика1ПриИзменении(Элемент)
	
	тд = Элементы.МатрицаПолитика1.ТекущиеДанные;
	текФонд = Неопределено;
	Если тд <> Неопределено Тогда
		текФонд = тд.Фонд;
		текПодр = тд.Подразделение;
	КонецЕсли;
	
	СохранитьСостояниеМатрицыП1();
	ЗаполнитьСуммыНаСервере();
	
	АктуализироватьДоступностьМатрицы();
	ОбновитьИтогиМатрицы();
	ПересчитатьРасходы();
	ЗаполнитьДеревоРасходы();
	ОбновитьИтогиРасходов();
	
	// восстановление тек строки
	Если текФонд <> Неопределено Тогда
		КоллСтрок = МатрицаПолитика1.ПолучитьЭлементы();
		Если ИспДоходыПодр Тогда
			для каждого стрПодр из КоллСтрок Цикл
				Если стрПодр.Подразделение = текПодр Тогда
					КоллСтрок = стрПодр.ПолучитьЭлементы();
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		для каждого стрФонд из КоллСтрок Цикл
			Если стрФонд.Фонд = текФонд Тогда
				Элементы.МатрицаПолитика1.ТекущаяСтрока = стрФонд.получитьИдентификатор();
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	//ПоказатьСкрытьМатрицу_Глюк();
КонецПроцедуры

