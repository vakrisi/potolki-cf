	Элементы.ВидыДоходов.ТолькоПросмотр = объект.Проведен;
	Элементы.ВидыДоходов.КонтекстноеМеню.Доступность = не объект.Проведен;
	Элементы.ВидыДоходовНезависимыйРежим.Доступность = не объект.Проведен;
	Элементы.ВидыДоходовСбросРежима.Доступность = не объект.Проведен;
	
	Элементы.ГруппаКПДоходыПодр.Доступность = не объект.Проведен;
	Элементы.ВидыДоходовПодр.ТолькоПросмотр = объект.Проведен;
	Элементы.ВидыДоходовПодр.КонтекстноеМеню.Доступность = не объект.Проведен;
	Элементы.ВидыДоходовПодрНезависимыйРежим.Доступность = не объект.Проведен;
	Элементы.ВидыДоходовПодрСбросРежима.Доступность = не объект.Проведен;
	
	Элементы.ОтложенныйДоход.КоманднаяПанель.Доступность = не объект.Проведен;
	Элементы.ОтложенныйДоход.ТолькоПросмотр = объект.Проведен;
	
	Элементы.МатрицаПолитика1.КоманднаяПанель.Доступность = не объект.Проведен;
	Элементы.МатрицаПолитика1.ТолькоПросмотр = объект.Проведен;
	
	Элементы.Расходы.КоманднаяПанель.Доступность = не объект.Проведен;
	Элементы.Расходы.ТолькоПросмотр = объект.Проведен;
	
	Элементы.Дата.ТолькоПросмотр = объект.Проведен;
	Элементы.Организация.ТолькоПросмотр = объект.Проведен;
	Элементы.ПредставлениеМесяца.ТолькоПросмотр = объект.Проведен;

КонецПроцедуры
	
&НаКлиенте
Процедура ПриОткрытии(Отказ)
	#ЕСЛИ ВебКлиент ТОГДА
		ЭтоВеб = Истина;
	#КОНЕЦЕСЛИ
	
	Элементы.ГруппаТело.Доступность = ЗначениеЗаполнено(объект.Месяц);
	
	ОбновитьМатрицуП1();
	УстановитьОтбор_Распределение1();
	ОбновитьИтогиМатрицы();
	ОбновитьИтогиТаблицыДоходов();
	ОбновитьИтогиДереваДоходов();
	ОбновитьИтогиРасходов();
	
	ОбновитьВидимостьКнопкиПроведения();
	ОбновитьПредставлениеМесяца();
	ОбновитьПредставлениеДиапазона();
	
	ПоказатьНастройкиДохода = Объект.ВидыДоходов.Количество() = 0;
	ОбновитьВидимостьНастроекДохода();
	
	ДоступностьФормыПоПроведению();
	
	Если Объект.Ссылка.Пустая() и Объект.Месяц<>Дата(1,1,1) Тогда // копирование
		МесяцПриИзмененииНаСервере();
		ВидыДоходовПриИзменении(Неопределено);
	КонецЕсли;
	ПодключитьОбработчикОжидания("ПоказатьСкрытьМатрицу_Глюк", 0.3, истина);
КонецПроцедуры

&НаКлиенте
