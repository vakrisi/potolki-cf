&НаКлиенте
Процедура ВидыДоходовНеделя1ПриИзменении(Элемент)
	НомерНедели = число(прав(Элемент.Имя,1));
	тд = Элемент.Родитель.ТекущиеДанные;
	
	Если НомерНедели = КолНедель или тд.НезависимыйРежим Тогда // пересчитываем месячную квоту как сумму недель
		ПересчетСуммИтогДоходов(тд);
	Иначе
		ПересчетСуммНедель(тд, НомерНедели);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПересчетСуммНедель(тд, ВыбНеделя)
	итогСуммаУжеРаспр = 0;
	Для сч = 1 по ВыбНеделя цикл
		итогСуммаУжеРаспр = итогСуммаУжеРаспр + тд["Неделя"+сч];
	КонецЦикла;
	
	ОсталосьРаспределить = тд.сумма - итогСуммаУжеРаспр;
	
	Если ОсталосьРаспределить < 0 Тогда
		Для сч = ВыбНеделя + 1 по КолНедель цикл
			тд["Неделя" + сч] = 0;
		КонецЦикла;
		тд.сумма = тд.сумма - ОсталосьРаспределить;
		Возврат;
	КонецЕсли;
	
	// распределеяем пропорционально уже введенным суммам
	СуммаДо = 0;
	для счНед = ВыбНеделя + 1  по КолНедель Цикл
		СуммаДо = СуммаДо + тд["Неделя" + счНед];
	КонецЦикла;
	
	ИтогоПоНеделям = итогСуммаУжеРаспр;
	Для сч = ВыбНеделя + 1 по КолНедель цикл
		тд["Неделя" + сч] = окр(ОсталосьРаспределить * (тд["Неделя" + сч] / СуммаДо));
		ИтогоПоНеделям = ИтогоПоНеделям + тд["Неделя" + сч];
	КонецЦикла;
	
	// корректировка округления. Последняя неделя
	тд["Неделя" + КолНедель] = тд["Неделя" + КолНедель] + (тд.Сумма - ИтогоПоНеделям);
КонецПроцедуры

&НаКлиенте
Процедура ПересчетСуммДоходовПоНеделям(тд, источникДанных)
	ВсеНули = истина;
	для счНед = 1 по КолНедель Цикл
		Если тд["неделя"+счНед] <> 0 Тогда
			ВсеНули = ложь;
			прервать;
		КонецЕсли;
	КонецЦикла;
	
	ЗаполнитьНедельныеСуммыПропорционально(тд.ПолучитьИдентификатор(), источникДанных, ВсеНули);
	
КонецПроцедуры

&НаКлиенте
Процедура ПересчетСуммИтогДоходов(тд)
	итогСумма = 0;
	Для сч = 1 по КолНедель цикл
		итогСумма = итогСумма + тд["Неделя"+сч];
	КонецЦикла;
	
	тд.сумма = итогСумма; 
	//тд.СуммаПлан = тд.сумма - тд.СуммаОтложенныйДоход;
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьНедельныеСуммыПропорционально(ИДСтроки, источникДанных, поДнямНедель = истина)
	Если источникДанных = "ВидыДоходов" тогда
		СтрокаДанных = объект.ВидыДоходов.НайтиПоИдентификатору(ИДСтроки);
	Иначе
		СтрокаДанных = ЭтаФорма[источникДанных].НайтиПоИдентификатору(ИДСтроки);
	КонецЕсли;
	
	ЗаполнитьНедельныеСуммыСтрокиПропорционально(СтрокаДанных, поДнямНедель);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьНедельныеСуммыСтрокиПропорционально(СтрокаДанных, поДнямНедель)
	
	ИтогоПоНеделям = 0;
	Если поДнямНедель Тогда
		для счНед = 1 по КолНедель Цикл
			СтрокаНед = Тз_Недели[счНед-1];
			СтрокаДанных["Неделя" + счНед] = окр(СтрокаДанных.Сумма / колДней * СтрокаНед.КолДней);
			
			ИтогоПоНеделям = ИтогоПоНеделям + СтрокаДанных["Неделя" + счНед];
		КонецЦикла;
	Иначе
		СуммаДо = 0;
		для счНед = 1 по КолНедель Цикл
			СуммаДо = СуммаДо + СтрокаДанных["Неделя" + счНед];
		КонецЦикла;
		
		
		для счНед = 1 по КолНедель Цикл
			СтрокаДанных["Неделя" + счНед] = окр(СтрокаДанных.Сумма * (СтрокаДанных["Неделя" + счНед] / СуммаДо));
			ИтогоПоНеделям = ИтогоПоНеделям + СтрокаДанных["Неделя" + счНед];
		КонецЦикла;
	КонецЕсли;
	
	// корректировка округления. Последняя неделя
	СтрокаДанных["Неделя" + КолНедель] = СтрокаДанных["Неделя" + КолНедель] + (СтрокаДанных.Сумма - ИтогоПоНеделям);
	
	//ОбновитьНедельныеПредставленияКолонок();
	
КонецПроцедуры

