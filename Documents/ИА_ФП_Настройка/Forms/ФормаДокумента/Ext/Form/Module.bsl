		Элемент.ТекущиеДанные.ИДСтроки = иа_БФКС.СформироватьУИД();
		УстановитьОтбор_Распределение1();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ВидыДоходовЗначениеНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
    ТекСтрока = Элемент.Родитель.ТекущиеДанные;
    Если ТекСтрока <> Неопределено Тогда
    	Если Текстрока.СпособЗаполнения = ПредопределенноеЗначение("Перечисление.ИА_ВариантыПолученияДанныхВидыДоходов.ВычисляемоеВыражение") Тогда
        	СтандартнаяОбработка = Ложь;
            
            ПараметрыФормулы = Новый Структура("ТекстФормулы, Политика1", ТекСтрока.Значение, Ложь);
			ПараметрыФормулы.Вставить("ФП_По_ТБ", ФП_По_ТБ);
			
            Данные = Неопределено;

			
            ОткрытьФорму("Документ.ИА_ФП_Настройка.Форма.ФормаРедакторФормулРаспределения", Новый Структура("ПараметрыФормулы", ПараметрыФормулы),ЭтаФорма,,,, Новый ОписаниеОповещения("ВидыДоходовЗначениеНачалоВыбораЗавершение", ЭтотОбъект, Новый Структура("ТекСтрока", ТекСтрока)), РежимОткрытияОкнаФормы.БлокироватьОкноВладельца); 
        КонецЕсли; 
    КонецЕсли; 
КонецПроцедуры

&НаКлиенте
Процедура ВидыДоходовЗначениеНачалоВыбораЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	ТекСтрока = ДополнительныеПараметры.ТекСтрока;
	
	
	Данные = Результат;
	
	Если ТипЗнч(Данные) = Тип("Структура") Тогда
		ТекСтрока.Значение = Данные.ТекстФормулы;
		ПеренестиВОбъектДоходы();
		Модифицированность = Истина;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ВидыДоходовПараметрыСтрНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	ТекСтрока = Элемент.Родитель.ТекущиеДанные;
	Если ТекСтрока <> Неопределено Тогда
		Если Текстрока.СпособЗаполнения = ПредопределенноеЗначение("Перечисление.ИА_ВариантыПолученияДанныхВидыДоходов.ВычисляемоеВыражение") ИЛИ
		 	Текстрока.СпособЗаполнения = ПредопределенноеЗначение("Перечисление.ИА_ВариантыПолученияДанныхВидыДоходов.Запрос")
			Тогда  
				СтандартнаяОбработка = Ложь;
				ПолучениеПараметровИзФормы(ТекСтрока, СтрЗаменить(ТекСтрока.ИДСтроки," ", ""));	 
		КонецЕсли; 
	КонецЕсли;
КонецПроцедуры 

&НаКлиенте
Процедура Распределение1ПараметрыСтрНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	ТекСтрока = Элемент.Родитель.ТекущиеДанные;
	Если ТекСтрока <> Неопределено Тогда
		Если ТекСтрока.СпособРасчета = ПредопределенноеЗначение("Перечисление.ИА_РежимРасчетаСуммы.ВычисляемоеВыражение") Тогда 
			ПолучениеПараметровИзФормы(ТекСтрока, СтрЗаменить(ТекСтрока.ИДСтрокиРаспределения," ", ""));
		КонецЕсли;
	КонецЕсли; 
КонецПроцедуры

&НаКлиенте
Процедура ПолучениеПараметровИзФормы(ТекСтрока, ИДСтроки) 	
	ВсеПараметры = ПолучитьИзВременногоХранилища(АдресПараметров);

	Если ВсеПараметры <> Неопределено Тогда
		Если ВсеПараметры.Свойство(ИДСтроки) Тогда
			ПараметрыДляСтроки = ВсеПараметры[ИДСтроки];
		Иначе ПараметрыДляСтроки = Новый Структура; 
		КонецЕсли;
	Иначе 
		ВсеПараметры = Новый Структура;
		ПараметрыДляСтроки = Новый Структура; 
	КонецЕсли;

	Данные = Неопределено;

	ОткрытьФорму("Документ.ИА_ФП_Настройка.Форма.ФормаПараметров", Новый Структура("ЗначенияПараметров", ПараметрыДляСтроки),ЭтаФорма,,,, Новый ОписаниеОповещения("ПолучениеПараметровИзФормыЗавершение", ЭтотОбъект, Новый Структура("ВсеПараметры, ИДСтроки, ТекСтрока", ВсеПараметры, ИДСтроки, ТекСтрока)), РежимОткрытияОкнаФормы.БлокироватьОкноВладельца); 	
КонецПроцедуры

&НаКлиенте
Процедура ПолучениеПараметровИзФормыЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	ВсеПараметры = ДополнительныеПараметры.ВсеПараметры;
	ИДСтроки = ДополнительныеПараметры.ИДСтроки;
	ТекСтрока = ДополнительныеПараметры.ТекСтрока;
	
	
	Данные = Результат;
	
	Если ТипЗнч(Данные) = Тип("Структура") Тогда
		Если Данные.Количество() > 0 Тогда 
			СтрокаПараметров = "";
			Для Каждого ПараметрОтФормы Из Данные Цикл
				СтрокаПараметров = СтрокаПараметров + " " + ПараметрОтФормы.Ключ + ",";
			КонецЦикла;
			СтрокаПараметров = Лев(СтрокаПараметров, СтрДлина(СтрокаПараметров) - 1);
			ТекСтрока.ПараметрыСтр = СокрЛП(СтрокаПараметров);
			Модифицированность = Истина;
		Иначе 
			СтрокаПараметров = "";
		КонецЕсли; 
		ВсеПараметры.Вставить(ИДСтроки, Данные);
		ПоместитьВоВременноеХранилище(ВсеПараметры, АдресПараметров);	
		
		ПеренестиВОбъектДоходы();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	Если ФП_По_ТБ ТОгда
		Объект.Политика2.Очистить();
	КонецЕсли;
	ЗаписатьХранилищеПараметров(ТекущийОбъект);
КонецПроцедуры

&НаСервере
Процедура ЗаписатьХранилищеПараметров(ТекущийОбъект) 
	
	Если ЗначениеЗаполнено(АдресПараметров) Тогда
		СохраняемыеПараметры = ПолучитьИзВременногоХранилища(АдресПараметров);
		ХранилищеПараметров = Новый ХранилищеЗначения(СохраняемыеПараметры);
		ТекущийОбъект.ХранилищеПараметров = ХранилищеПараметров;	
	КонецЕсли; 

КонецПроцедуры

&НаКлиенте
Процедура Распределение2ПриАктивизацииЯчейки(Элемент)

	ТекСтрока = Элемент.ТекущиеДанные;
    Если ТекСтрока <> Неопределено Тогда
        Если    Текстрока.СпособРасчета = ПредопределенноеЗначение("Перечисление.ИА_РежимРасчетаСуммы.Процент")
            ИЛИ Текстрока.СпособРасчета = ПредопределенноеЗначение("Перечисление.ИА_РежимРасчетаСуммы.ФиксированнаяСумма")
