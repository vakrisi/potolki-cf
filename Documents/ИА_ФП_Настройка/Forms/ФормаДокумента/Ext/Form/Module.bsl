&НаКлиенте
Процедура ДобавитьПеремРасход(Команда)
	Если ИспПодразделения и не ИспДоходыПодр Тогда
		Парам = новый Структура;
		Оповещение = Новый ОписаниеОповещения("ПослеВводаЗначенияПодразделения1ВМатр", ЭтотОбъект, Парам);
		зн = ПредопределенноеЗначение("Справочник.ИА_ЦФО.ПустаяСсылка");
		ПоказатьВводЗначения(Оповещение,зн,"Выберите подразделение");
	Иначе
		ДобавитьФондПеремРасход();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьФондПеремРасход(Подр = Неопределено)
	
	ИсключитьФонды = новый массив;
	для каждого стр из МатрицаПолитика1.ПолучитьЭлементы() Цикл
		Если ЗначениеЗаполнено(стр.Фонд) и (Подр = Неопределено или стр.Подразделение = Подр) Тогда
			ИсключитьФонды.Добавить(стр.Фонд);
		КонецЕсли;
		
		для каждого стр1 из стр.ПолучитьЭлементы() Цикл
			Если ЗначениеЗаполнено(стр1.Фонд) и (Подр = Неопределено или стр1.Подразделение = Подр) Тогда
				ИсключитьФонды.Добавить(стр1.Фонд);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	отборФ = новый Структура("ПометкаУдаления", Ложь);
	Парам = Новый Структура("ИсключитьФонды,Подразделение,отбор", ИсключитьФонды,Подр,отборФ);
	оп = новый ОписаниеОповещения("ЗавершениеВыбораФондаНс", ЭтотОбъект, Парам);
	ОткрытьФорму("Справочник.ИА_Фонды.ФормаВыбора", Парам, ЭтаФорма, , ,, оп, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
КонецПроцедуры

&НаКлиенте
Процедура ЗавершениеВыбораФондаНс(РезультатЗакрытия, ДопПарам) Экспорт
	Если РезультатЗакрытия<>Неопределено Тогда
		Новстр = МатрицаПолитика1.ПолучитьЭлементы().Добавить();
		Новстр.Фонд = РезультатЗакрытия;
		Новстр.Подразделение = ДопПарам.Подразделение;
		МатрицаПолитика1ПриИзменении(Неопределено);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура МатрицаПолитика1ПодразделениеФондПриИзменении(Элемент)
	ТекСтрока = Элементы.МатрицаПолитика1.ТекущиеДанные;
	ЭтоПодр = ТекСтрока.ПолучитьРодителя() = Неопределено;
	
	Если ЭтоПодр Тогда 
		ТекСтрока.Подразделение = ТекСтрока.ПодразделениеФонд;
		Для каждого стрФ из ТекСтрока.ПолучитьЭлементы() Цикл
			стрФ.Подразделение = ТекСтрока.ПодразделениеФонд;
		КонецЦикла;
	Иначе
		ТекСтрока.Фонд = ТекСтрока.ПодразделениеФонд;
	КонецЕсли;
	
КонецПроцедуры

