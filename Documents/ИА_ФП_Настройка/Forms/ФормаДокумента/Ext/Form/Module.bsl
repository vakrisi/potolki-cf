		//ГруппаВд = Элементы.Вставить("МатрицаПолитика1Группа"+ид, Тип("ГруппаФормы"), Элементы.МатрицаПолитика1, Элементы.МатрицаПолитика1Итого);
		ГруппаВд = Элементы.Вставить("МатрицаПолитика1Группа"+ид, Тип("ГруппаФормы"), Элементы.МатрицаПолитика1, Элементы.МатрицаПолитика1ДопКолонка);
		ГруппаВд.Вид = ВидГруппыФормы.ГруппаКолонок;
		ГруппаВд.Заголовок = стрВидДохода.ВидДохода;
		ГруппаВд.Группировка = ГруппировкаКолонок.Горизонтальная;		
		ГруппаВд.ОтображатьВШапке = истина;
		ГруппаВд.ГоризонтальноеПоложениеВШапке=ГоризонтальноеПоложениеЭлемента.Центр;
		Если не ЭтоВеб Тогда
			//ГруппаВд.ЦветФонаЗаголовка = цв;		
		КонецЕсли;	
		ГруппаВд.ШрифтЗаголовка = новый Шрифт(ГруппаВд.ШрифтЗаголовка,,,истина);
		ГруппаВд.ЦветТекстаЗаголовка = новый цвет(0,0,255);
		
