            Тогда
            Элементы.Распределение2Значение.ОграничениеТипа = Новый ОписаниеТипов("Число");
        ИначеЕсли    Текстрока.СпособРасчета = ПредопределенноеЗначение("Перечисление.ИА_РежимРасчетаСуммы.ВычисляемоеВыражение") Тогда
            Элементы.Распределение2Значение.ОграничениеТипа = Новый ОписаниеТипов("Строка",,Новый КвалификаторыСтроки(0));
        Иначе
            Элементы.Распределение2Значение.ОграничениеТипа = Новый ОписаниеТипов();
