&НаКлиенте
Функция ПолучитьИсключаемыеФондыРасходов(тс, текПодр = Неопределено)
	ИсключитьФонды = новый массив;
	
	для каждого стр из Расходы.ПолучитьЭлементы() Цикл
		Если ЗначениеЗаполнено(стр.Фонд) и стр <> тс и 
			(ИспПодразделения = ложь или ((тс = Неопределено или стр.Подразделение = тс.Подразделение)   и (текПодр = Неопределено или стр.Подразделение = текПодр)))  Тогда
			ИсключитьФонды.Добавить(стр.Фонд);
		КонецЕсли;
		
		для каждого стр1 из стр.ПолучитьЭлементы() Цикл
			Если ЗначениеЗаполнено(стр1.Фонд) и стр1 <> тс и 
				(ИспПодразделения = ложь или ((тс = Неопределено или стр1.Подразделение = тс.Подразделение)  и (текПодр = Неопределено или стр1.Подразделение = текПодр)))  Тогда
				ИсключитьФонды.Добавить(стр1.Фонд);
			КонецЕсли;
			для каждого стр2 из стр1.ПолучитьЭлементы() Цикл
				Если ЗначениеЗаполнено(стр2.Фонд) и стр2 <> тс и 
					(ИспПодразделения = ложь или ((тс = Неопределено или стр2.Подразделение = тс.Подразделение)   и (текПодр = Неопределено или стр2.Подразделение = текПодр)))  Тогда
					ИсключитьФонды.Добавить(стр2.Фонд);
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	
	Возврат ИсключитьФонды;
КонецФункции

