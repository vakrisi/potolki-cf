Процедура РасходыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	тд = Расходы.НайтиПоИдентификатору(ВыбраннаяСтрока);
	Если (поле = Элементы.РасходыФонд ИЛИ поле = Элементы.РасходыПодразделениеСтрока)
		и (тд.ТипСтроки = ПредопределенноеЗначение("Перечисление.КСУ_ВидыСтрокТБ.УчредительскиеФонды") ИЛИ тд.ТипСтроки = ПредопределенноеЗначение("Перечисление.КСУ_ВидыСтрокТБ.ПостоянныеРасходы"))
		И тд.ЭтоЗаголовок Тогда
		ДобавитьРасход(Неопределено);
		СтандартнаяОбработка = ложь;
	КонецЕсли;
