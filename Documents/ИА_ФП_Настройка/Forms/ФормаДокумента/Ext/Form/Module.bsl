	Элементы.ГруппаМатрицаП1.Показать();
КонецПроцедуры
	
&НаКлиенте
Процедура ОбновитьВидимостьНастроекДохода()
	Элементы.ВидыДоходовПоказатьСкрытьНастрокиДоходов.Пометка = ПоказатьНастройкиДохода;
	Элементы.ВидыДоходовПодрПоказатьСкрытьНастрокиДоходов.Пометка = ПоказатьНастройкиДохода;
	
	Элементы.ВидыДоходовСпособЗаполнения.Видимость = ПоказатьНастройкиДохода;
	Элементы.ВидыДоходовЗначение.Видимость = ПоказатьНастройкиДохода;
	Элементы.ВидыДоходовПараметрыСтр.Видимость = ПоказатьНастройкиДохода и ИндПарам;
	
	Элементы.ВидыДоходовПодрСпособЗаполнения.Видимость = ПоказатьНастройкиДохода;
	Элементы.ВидыДоходовПодрЗначение.Видимость = ПоказатьНастройкиДохода;
	Элементы.ВидыДоходовПодрПараметрыСтр.Видимость = ПоказатьНастройкиДохода и ИндПарам;
КонецПроцедуры

