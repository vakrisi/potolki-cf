&НаКлиенте
Процедура Распределение2ЗначениеНачалоВыбораЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	ТекСтрока = ДополнительныеПараметры.ТекСтрока;
	
	
	Данные = Результат;
	Если ТипЗнч(Данные) = Тип("Структура") Тогда
		ТекСтрока.Значение = Данные.ТекстФормулы;
		Модифицированность = Истина;
	КонецЕсли;

КонецПроцедуры


Функция Распределение2ЗначениеНачалоВыбора_СформироватьПараметрыФормулы(ТекСтрокаИД)
    ТекСтрока = Объект.Политика2.НайтиПоИдентификатору(ТекСтрокаИД);
    
    ПараметрыФормулы = Новый Структура;
	ПараметрыФормулы.Вставить("ТекстФормулы", ТекСтрока.Значение);
	
	Результат = Объект.ВидыДоходов.Выгрузить().ВыгрузитьКолонку("ВидДохода");	
	ПараметрыФормулы.Вставить("Доходы", результат);
	
	ПараметрыФормулы.Вставить("Политика1", истина);
	ПараметрыФормулы.Вставить("ТаблицаПолитика1", ИА_БФС.ТЗ2ТЗФ(Объект.Политика1.Выгрузить()));
		
	Результат = ИА_БФС.ТЗ2ТЗФ(Объект.Политика2.Выгрузить());
	
	ПараметрыФормулы.Вставить("Политика2", Истина);
	ПараметрыФормулы.Вставить("ТаблицаПолитика2", результат);
	
	ПараметрыФормулы.Вставить("ФП_По_ТБ", ФП_По_ТБ);
    
    Возврат ПараметрыФормулы;
КонецФункции

