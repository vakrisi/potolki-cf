	<Attributes>
		<Attribute name="Список" id="1">
			<Type>
				<v8:Type>cfg:DynamicList</v8:Type>
			</Type>
			<MainAttribute>true</MainAttribute>
			<UseAlways>
				<Field>Список.ГраницыМесяца</Field>
				<Field>Список.ДатаКонца</Field>
				<Field>Список.ДатаНачала</Field>
				<Field>Список.КолДней</Field>
				<Field>Список.Проведен</Field>
				<Field>Список.Утверждено</Field>
			</UseAlways>
			<Settings xsi:type="DynamicList">
				<ManualQuery>true</ManualQuery>
				<DynamicDataRead>false</DynamicDataRead>
				<QueryText>ВЫБРАТЬ
	ДокументИА_ФП_Настройка.Ссылка КАК Ссылка,
	ДокументИА_ФП_Настройка.ПометкаУдаления КАК ПометкаУдаления,
	ДокументИА_ФП_Настройка.Номер КАК Номер,
	ДокументИА_ФП_Настройка.Дата КАК Дата,
	ДокументИА_ФП_Настройка.Проведен КАК Проведен,
	ДокументИА_ФП_Настройка.Организация КАК Организация,
	ДокументИА_ФП_Настройка.Ответственный КАК Ответственный,
	ДокументИА_ФП_Настройка.Комментарий КАК Комментарий,
	ДокументИА_ФП_Настройка.ХранилищеПараметров КАК ХранилищеПараметров,
	ДокументИА_ФП_Настройка.Месяц КАК Месяц,
	ДокументИА_ФП_Настройка.ДатаНачала КАК ДатаНачала,
	ДокументИА_ФП_Настройка.ДатаКонца КАК ДатаКонца,
	ДокументИА_ФП_Настройка.Утверждено КАК Утверждено,
	ДокументИА_ФП_Настройка.НомерВеб КАК НомерВеб,
	ДокументИА_ФП_Настройка.МоментВремени КАК МоментВремени,
	//ВЫРАЗИТЬ(ВЫБОР
	//		КОГДА ДокументИА_ФП_Настройка.Проведен
	//			ТОГДА &amp;ФотоСтатусУтв
	//		ИНАЧЕ &amp;ФотоСтатусЧерн
	//	КОНЕЦ КАК СТРОКА(300)) КАК КартинкаСтатус,
	ДокументИА_ФП_Настройка.Проведен КАК КартинкаСтатус,
	"                                                   " КАК ГраницыМесяца,
	РАЗНОСТЬДАТ(ДокументИА_ФП_Настройка.ДатаНачала, ДокументИА_ФП_Настройка.ДатаКонца, ДЕНЬ) + 1 КАК КолДней,
	ЕСТЬNULL(ЗапросДохода.ДоходПлан, 0) КАК ДоходПлан,
	ЕСТЬNULL(ЗапросДохода.ДоходФакт, 0) КАК ДоходФакт,
	ВЫБОР
		КОГДА ДокиФП.МесяцТБ ЕСТЬ NULL
			ТОГДА ""
		ИНАЧЕ "Показать"
	КОНЕЦ КАК СвязанныеФП,
	ЕСТЬNULL(КСУ_ПланФактМаржинальнойПрибылиОбороты.СуммаПриход, 0) КАК МаржаПлан,
	ЕСТЬNULL(КСУ_ПланФактМаржинальнойПрибылиОбороты.СуммаРасход, 0) КАК МаржаФакт,
	ВЫБОР КОГДА ДокументИА_ФП_Настройка.Проведен ТОГДА "Утвержден" ИНАЧЕ "Черновик" КОНЕЦ КАК Статус
ИЗ
	Документ.ИА_ФП_Настройка КАК ДокументИА_ФП_Настройка
		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			КСУ_РаспределениеДоходовТБОбороты.Организация КАК Организация,
			СУММА(КСУ_РаспределениеДоходовТБОбороты.СуммаПриход) КАК ДоходПлан,
			СУММА(КСУ_РаспределениеДоходовТБОбороты.СуммаРасход) КАК ДоходФакт,
			ИА_РаспределениеНедель.Месяц КАК Месяц
		ИЗ
			РегистрНакопления.КСУ_РаспределениеДоходовТБ.Обороты КАК КСУ_РаспределениеДоходовТБОбороты
				ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ИА_РаспределениеНедель КАК ИА_РаспределениеНедель
				ПО КСУ_РаспределениеДоходовТБОбороты.Неделя = ИА_РаспределениеНедель.Период
		
		СГРУППИРОВАТЬ ПО
			ИА_РаспределениеНедель.Месяц,
			КСУ_РаспределениеДоходовТБОбороты.Организация) КАК ЗапросДохода
		ПО (ЗапросДохода.Месяц = ДокументИА_ФП_Настройка.Месяц)
			И (ЗапросДохода.Организация = ДокументИА_ФП_Настройка.Организация)
		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			ИА_ФинансовоеПланирование.МесяцТБ КАК МесяцТБ,
			ИА_ФинансовоеПланирование.Организация КАК Организация
		ИЗ
			Документ.ИА_ФинансовоеПланирование КАК ИА_ФинансовоеПланирование
		ГДЕ
			ИА_ФинансовоеПланирование.ПометкаУдаления = ЛОЖЬ
			И ИА_ФинансовоеПланирование.МесяцТБ &lt;&gt; ДАТАВРЕМЯ(1, 1, 1)
		
		СГРУППИРОВАТЬ ПО
			ИА_ФинансовоеПланирование.МесяцТБ,
			ИА_ФинансовоеПланирование.Организация) КАК ДокиФП
		ПО (ДокиФП.МесяцТБ = ДокументИА_ФП_Настройка.Месяц)
			И (ДокиФП.Организация = ДокументИА_ФП_Настройка.Организация)
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.КСУ_ПланФактМаржинальнойПрибыли.Обороты КАК КСУ_ПланФактМаржинальнойПрибылиОбороты
		ПО ДокументИА_ФП_Настройка.Организация = КСУ_ПланФактМаржинальнойПрибылиОбороты.Организация
			И ДокументИА_ФП_Настройка.Месяц = КСУ_ПланФактМаржинальнойПрибылиОбороты.Месяц
ГДЕ
	(ДокументИА_ФП_Настройка.ПометкаУдаления = ЛОЖЬ
			ИЛИ &amp;ПоказатьПомеченные = ИСТИНА)</QueryText>
				<MainTable>Document.ИА_ФП_Настройка</MainTable>
				<ListSettings>
					<dcsset:filter>
						<dcsset:viewMode>Normal</dcsset:viewMode>
						<dcsset:userSettingID>dfcece9d-5077-440b-b6b3-45a5cb4538eb</dcsset:userSettingID>
					</dcsset:filter>
					<dcsset:order>
						<dcsset:viewMode>Normal</dcsset:viewMode>
						<dcsset:userSettingID>88619765-ccb3-46c6-ac52-38e9c992ebd4</dcsset:userSettingID>
					</dcsset:order>
					<dcsset:conditionalAppearance>
						<dcsset:viewMode>Normal</dcsset:viewMode>
						<dcsset:userSettingID>b75fecce-942b-4aed-abc9-e6a02e460fb3</dcsset:userSettingID>
					</dcsset:conditionalAppearance>
					<dcsset:itemsViewMode>Normal</dcsset:itemsViewMode>
					<dcsset:itemsUserSettingID>911b6018-f537-43e8-a417-da56b22f9aec</dcsset:itemsUserSettingID>
				</ListSettings>
			</Settings>
		</Attribute>
		<Attribute name="ФотоСтатусУтв" id="2">
			<Title>
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Фото статус утв</v8:content>
				</v8:item>
