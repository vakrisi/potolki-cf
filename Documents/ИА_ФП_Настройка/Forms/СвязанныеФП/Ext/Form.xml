				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Документы ФП</v8:content>
				</v8:item>
			</Title>
			<Type>
				<v8:Type>cfg:DynamicList</v8:Type>
			</Type>
			<UseAlways>
				<Field>ДокументыФП.Дата</Field>
				<Field>ДокументыФП.КолДней</Field>
				<Field>ДокументыФП.КонецНедели</Field>
				<Field>ДокументыФП.МесяцТБ</Field>
				<Field>ДокументыФП.НачалоНедели</Field>
				<Field>ДокументыФП.Номер</Field>
				<Field>ДокументыФП.НомерНедели</Field>
			</UseAlways>
			<Settings xsi:type="DynamicList">
				<ManualQuery>true</ManualQuery>
				<DynamicDataRead>true</DynamicDataRead>
				<QueryText>ВЫБРАТЬ
	ДокументИА_ФинансовоеПланирование.Ссылка КАК Ссылка,
	ДокументИА_ФинансовоеПланирование.ПометкаУдаления КАК ПометкаУдаления,
	ДокументИА_ФинансовоеПланирование.Номер КАК Номер,
	ДокументИА_ФинансовоеПланирование.Дата КАК Дата,
	ДокументИА_ФинансовоеПланирование.НеделяТБ КАК НачалоНедели,
	НомераНедель.КонецНедели КАК КонецНедели,
	РАЗНОСТЬДАТ(ДокументИА_ФинансовоеПланирование.НеделяТБ, НомераНедель.КонецНедели, ДЕНЬ) + 1 КАК КолДней,
	ДокументИА_ФинансовоеПланирование.МесяцТБ КАК МесяцТБ,
	НомераНедель.НомерНедели КАК НомерНедели,
	"                                                                     " КАК Документ
ИЗ
	Документ.ИА_ФинансовоеПланирование КАК ДокументИА_ФинансовоеПланирование
		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			ИА_РаспределениеНедель.Период КАК Период,
			ИА_РаспределениеНедель.КонецНедели КАК КонецНедели,
			КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ИА_РаспределениеНедель1.Период) КАК НомерНедели
		ИЗ
			РегистрСведений.ИА_РаспределениеНедель КАК ИА_РаспределениеНедель
				ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИА_РаспределениеНедель КАК ИА_РаспределениеНедель1
				ПО ИА_РаспределениеНедель.Месяц = ИА_РаспределениеНедель1.Месяц
					И (ИА_РаспределениеНедель1.Период &lt;= ИА_РаспределениеНедель.Период)
		ГДЕ
			ИА_РаспределениеНедель.Месяц = &amp;МесяцТБ
		
		СГРУППИРОВАТЬ ПО
			ИА_РаспределениеНедель.Период,
			ИА_РаспределениеНедель.КонецНедели) КАК НомераНедель
		ПО ДокументИА_ФинансовоеПланирование.НеделяТБ = НомераНедель.Период
ГДЕ
	ДокументИА_ФинансовоеПланирование.ПометкаУдаления = ЛОЖЬ
	И ДокументИА_ФинансовоеПланирование.МесяцТБ = &amp;МесяцТБ
	И ДокументИА_ФинансовоеПланирование.Организация = &amp;Организация</QueryText>
