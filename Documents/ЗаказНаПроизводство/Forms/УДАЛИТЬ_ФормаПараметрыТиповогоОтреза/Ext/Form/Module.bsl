
&НаКлиенте
Процедура КомандаОтмена(Команда)
	Закрыть(Неопределено);
КонецПроцедуры

&НаКлиенте
Процедура КомандаГотово(Команда)
	СтруктураОтвета = Новый Структура;
	СтруктураОтвета.Вставить("Фактура",Фактура);
	СтруктураОтвета.Вставить("Цвет",Цвет);
	СтруктураОтвета.Вставить("Количество",Количество);
	Закрыть(СтруктураОтвета);
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Фактура = Параметры.Фактура;
	Цвет = Параметры.Цвет;
	Количество = Параметры.Количество;
КонецПроцедуры
