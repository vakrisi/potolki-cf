	<Attributes>
		<Attribute name="Список" id="1">
			<Type>
				<v8:Type>cfg:DynamicList</v8:Type>
			</Type>
			<MainAttribute>true</MainAttribute>
			<Settings xsi:type="DynamicList">
				<ManualQuery>true</ManualQuery>
				<DynamicDataRead>true</DynamicDataRead>
				<QueryText>ВЫБРАТЬ РАЗРЕШЕННЫЕ
	ЗаказНаПроизводствоДокумент.Ссылка,
	ЗаказНаПроизводствоДокумент.Подразделение КАК Подразделение,
	ЗаказНаПроизводствоДокумент.Дата,
	ЗаказНаПроизводствоДокумент.Номер,
	//ЕСТЬNULL(ЗаказНаПроизводствоДокумент.ПродукцияКоличество, 0) КАК КоличествоПроизведено,
	ЕСТЬNULL(ВыработкаПроизводстваОбороты.КоличествоОборот, 0) КАК КоличествоВыработка,
	ВЫБОР
		КОГДА РасходМатериаловНаПроизводствеОбороты.ЕдиницаИзмерения ССЫЛКА Справочник.ЕдиницыИзмерений
			ТОГДА ЕСТЬNULL(РасходМатериаловНаПроизводствеОбороты.ЕдиницаИзмерения.Коэффициент * РасходМатериаловНаПроизводствеОбороты.КоличествоОборот, 0)
		ИНАЧЕ ЕСТЬNULL(РасходМатериаловНаПроизводствеОбороты.КоличествоОборот, 0)
	КОНЕЦ КАК КоличествоПленки,
	//ВЫБОР
	//	КОГДА РасходМатериаловНаПроизводствеОбороты1.ЕдиницаИзмерения ССЫЛКА Справочник.ЕдиницыИзмерений
	//		ТОГДА ЕСТЬNULL(РасходМатериаловНаПроизводствеОбороты1.ЕдиницаИзмерения.Коэффициент * РасходМатериаловНаПроизводствеОбороты1.КоличествоОборот, 0)
	//	ИНАЧЕ ЕСТЬNULL(РасходМатериаловНаПроизводствеОбороты1.КоличествоОборот, 0)
	//КОНЕЦ КАК КоличествоОстатка,
	ЕСТЬNULL(ЗаказНаПроизводствоДокумент.ПродукцияСумма, 0) КАК СтоимостьПотолков,
	//ЗаказНаПроизводствоДокумент.Услуги.(
	//	Сумма
	//) КАК ТаблицаУслуг,
	ЗакНаПроОбороты.КоличествоРасход КАК КоличествоПроизведеноФакт,
	ЗаказНаПроизводствоДокумент.СуммаДокумента,
	ЗаказНаПроизводствоДокумент.Организация
ИЗ
	Документ.ЗаказНаПроизводство КАК ЗаказНаПроизводствоДокумент
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ВыработкаПроизводства.Обороты(, , Регистратор, ) КАК ВыработкаПроизводстваОбороты
		ПО ЗаказНаПроизводствоДокумент.Ссылка = ВыработкаПроизводстваОбороты.ЗаказНаПроизводство
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.РасходМатериаловНаПроизводстве.Обороты(
				,
				,
				Регистратор,
				Номенклатура.ВидНоменклатуры В (&amp;ПолотноИОстатокПленки)
					//И Номенклатура &lt;&gt; &amp;Остаток
					) КАК РасходМатериаловНаПроизводствеОбороты
		ПО ЗаказНаПроизводствоДокумент.ПродукцияНоменклатура = РасходМатериаловНаПроизводствеОбороты.Регистратор.ПродукцияНоменклатура
		//ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.РасходМатериаловНаПроизводстве.Обороты(, , Регистратор, Номенклатура = &amp;Остаток) КАК РасходМатериаловНаПроизводствеОбороты1
		//ПО ЗаказНаПроизводствоДокумент.ПродукцияНоменклатура = РасходМатериаловНаПроизводствеОбороты1.Регистратор.ПродукцияНоменклатура
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ЗаказыНаПроизводство.Обороты(,, Регистратор) КАК ЗакНаПроОбороты
		ПО ЗаказНаПроизводствоДокумент.Ссылка = ЗакНаПроОбороты.ЗаказНаПроизводство
ГДЕ
	ВЫБОР 
		КОГДА &amp;ПоДатеПроизводства
			ТОГДА ГОД(ЗаказНаПроизводствоДокумент.Дата) = &amp;Год
		ИНАЧЕ
			ГОД(ЗакНаПроОбороты.Регистратор.Дата) = &amp;Год	
	КОНЕЦ	
	И ЗаказНаПроизводствоДокумент.Подразделение = &amp;Подразделение
	И ЗаказНаПроизводствоДокумент.Проведен = ИСТИНА
	//Начало изменен при переходе на 2.0
	//И ЗаказНаПроизводствоДокумент.ТекущийСтатус = &amp;Отгружен
	И ЗаказНаПроизводствоДокумент.ТекущийСтатус = &amp;Произведен
	//Конец изменен при переходе на 2.0
	И ВЫБОР
			КОГДА &amp;ОтборПоМесяцу
				ТОГДА 
					ВЫБОР 
						КОГДА &amp;ПоДатеПроизводства
							ТОГДА МЕСЯЦ(ЗаказНаПроизводствоДокумент.Дата) = &amp;Месяц
						ИНАЧЕ МЕСЯЦ(ЗакНаПроОбороты.Регистратор.Дата) = &amp;Месяц
						КОНЕЦ
			ИНАЧЕ ИСТИНА
		КОНЕЦ</QueryText>
				<MainTable>Document.ЗаказНаПроизводство</MainTable>
				<ListSettings>
					<dcsset:filter>
						<dcsset:viewMode>Normal</dcsset:viewMode>
						<dcsset:userSettingID>dfcece9d-5077-440b-b6b3-45a5cb4538eb</dcsset:userSettingID>
					</dcsset:filter>
					<dcsset:order>
						<dcsset:item xsi:type="dcsset:OrderItemField">
							<dcsset:field>Подразделение</dcsset:field>
							<dcsset:orderType>Asc</dcsset:orderType>
						</dcsset:item>
						<dcsset:item xsi:type="dcsset:OrderItemField">
							<dcsset:field>Дата</dcsset:field>
							<dcsset:orderType>Asc</dcsset:orderType>
						</dcsset:item>
						<dcsset:viewMode>Normal</dcsset:viewMode>
						<dcsset:userSettingID>88619765-ccb3-46c6-ac52-38e9c992ebd4</dcsset:userSettingID>
					</dcsset:order>
					<dcsset:conditionalAppearance>
						<dcsset:viewMode>Normal</dcsset:viewMode>
						<dcsset:userSettingID>b75fecce-942b-4aed-abc9-e6a02e460fb3</dcsset:userSettingID>
					</dcsset:conditionalAppearance>
					<dcsset:itemsViewMode>Normal</dcsset:itemsViewMode>
					<dcsset:itemsUserSettingID>911b6018-f537-43e8-a417-da56b22f9aec</dcsset:itemsUserSettingID>
				</ListSettings>
			</Settings>
		</Attribute>
	</Attributes>
	<Parameters>
		<Parameter name="Полотно">
			<Type>
				<v8:Type>cfg:CatalogRef.ВидыНоменклатуры</v8:Type>
			</Type>
		</Parameter>
		<Parameter name="Остаток">
			<Type>
				<v8:Type>xs:string</v8:Type>
				<v8:StringQualifiers>
					<v8:Length>0</v8:Length>
					<v8:AllowedLength>Variable</v8:AllowedLength>
				</v8:StringQualifiers>
			</Type>
		</Parameter>
		<Parameter name="Произведен">
			<Type>
				<v8:Type>cfg:CatalogRef.СтатусыЗаказовНаПроизводство</v8:Type>
			</Type>
		</Parameter>
		<Parameter name="Год">
			<Type>
				<v8:Type>xs:decimal</v8:Type>
				<v8:NumberQualifiers>
					<v8:Digits>4</v8:Digits>
					<v8:FractionDigits>0</v8:FractionDigits>
					<v8:AllowedSign>Any</v8:AllowedSign>
				</v8:NumberQualifiers>
			</Type>
			<KeyParameter>true</KeyParameter>
		</Parameter>
		<Parameter name="Подразделение">
			<Type>
				<v8:Type>cfg:CatalogRef.Подразделения</v8:Type>
			</Type>
			<KeyParameter>true</KeyParameter>
		</Parameter>
		<Parameter name="ОтборПоМесяцу">
			<Type>
				<v8:Type>xs:boolean</v8:Type>
			</Type>
			<KeyParameter>true</KeyParameter>
		</Parameter>
		<Parameter name="Месяц">
			<Type>
				<v8:Type>xs:decimal</v8:Type>
				<v8:NumberQualifiers>
					<v8:Digits>2</v8:Digits>
					<v8:FractionDigits>0</v8:FractionDigits>
					<v8:AllowedSign>Any</v8:AllowedSign>
				</v8:NumberQualifiers>
			</Type>
			<KeyParameter>true</KeyParameter>
		</Parameter>
		<Parameter name="ПоДатеПроизводства">
			<Type>
				<v8:Type>xs:boolean</v8:Type>
			</Type>
		</Parameter>
	</Parameters>
