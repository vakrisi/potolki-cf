
&НаКлиенте
Процедура ВыбратьВсе(Команда)
	Для Каждого ТекущаяСтрока Из Товары Цикл
		ТекущаяСтрока.Перемещать = Истина;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ОтменитьВсе(Команда)
	Для Каждого ТекущаяСтрока Из Товары Цикл
		ТекущаяСтрока.Перемещать = Ложь;
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Для НомерСтроки = 0 По Параметры.СписокТоваров.Количество() - 1 Цикл
		НоваяСтрока = Товары.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Параметры.СписокТоваров.Получить(НомерСтроки).Значение);
		НоваяСтрока.Перемещать = Истина;
	КонецЦикла;          
	Организация = Параметры.Организация;
	СкладОтправитель = Параметры.СкладОтправитель;
	СкладПолучатель = Параметры.СкладПолучатель;
	
	// Видимость колонки Артикул
	ОбщийМодульСервер.УстановитьВидимостьКолонкиАртикулВТабличнойЧасти(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ОК(Команда)
	
	Выбраны = Ложь;
	Для Каждого ТекСтрока Из Товары Цикл
		Если ТекСтрока.Перемещать Тогда
			Выбраны = Истина;
		КонецЕсли;
	КонецЦикла;
	Если НЕ Выбраны Тогда
		ПоказатьПредупреждение(,"Не выбран ни один товар");
		Возврат;
	КонецЕсли;
	
	Если СкладПолучатель.Пустая() Тогда
		ПоказатьПредупреждение(,"Не выбран склад-получатель");
		Возврат;
	КонецЕсли;
	
	ПараметрыНовогоДокумента = Новый Структура;
	ПараметрыНовогоДокумента.Вставить("ПоЗаказамНаПроизводство",Истина); 
	ПараметрыНовогоДокумента.Вставить("Организация",Организация); 
	ПараметрыНовогоДокумента.Вставить("СкладОтправитель", СкладОтправитель); 
	ПараметрыНовогоДокумента.Вставить("СкладПолучатель", СкладПолучатель); 
	
	//СписокТоваров = Новый СписокЗначений;
	СписокТоваров = Новый Массив;
	Для Каждого СтрокаТоварЗаказа Из Товары Цикл
		Если СтрокаТоварЗаказа.Перемещать Тогда
			СтруктураТовара = Новый Структура;
			СтруктураТовара.Вставить("Заказ", СтрокаТоварЗаказа.Заказ);
			СтруктураТовара.Вставить("Номенклатура", СтрокаТоварЗаказа.Номенклатура);
			СтруктураТовара.Вставить("Количество", СтрокаТоварЗаказа.Количество);
			СтруктураТовара.Вставить("ЕдиницаИзмерения", СтрокаТоварЗаказа.ЕдиницаИзмерения);
			СтруктураТовара.Вставить("ХарактеристикаНоменклатуры", СтрокаТоварЗаказа.ХарактеристикаНоменклатуры);
			СтруктураТовара.Вставить("СерияНоменклатуры", СтрокаТоварЗаказа.СерияНоменклатуры);
			СписокТоваров.Добавить(СтруктураТовара);
		КонецЕсли;
	КонецЦикла;
	ПараметрыНовогоДокумента.Вставить("Товары", СписокТоваров); 
	
	ПараметрыФормы = Новый Структура("ЗначенияЗаполнения", ПараметрыНовогоДокумента);
	
	ОткрытьФорму("Документ.ПеремещениеТоваров.Форма.ФормаДокумента", ПараметрыФормы, ЭтаФорма,,ВариантОткрытияОкна.ОтдельноеОкно);
	Закрыть();
	
КонецПроцедуры
