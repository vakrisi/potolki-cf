Процедура ТоварыПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	ОбновитьДанныеДокумента();
	ЗаполнитьДанныеКОтгрузкеИОстаткиПоТоварам();
КонецПроцедуры

&НаКлиенте
Процедура УслугиПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	ОбновитьДанныеДокумента();
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияВопросаОПересчетеЦен(Результат, Параметры) Экспорт
	Если Результат = КодВозвратаДиалога.Да Тогда
		ПересчитатьЦеныПоВидуЦен();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ЗадатьВопросОПересчетеЦен()
	Если НЕ НеУчитыватьСтоимость Тогда
		Если Объект.Товары.Количество() > 0 ИЛИ Объект.Услуги.Количество() > 0 ИЛИ НЕ Объект.ПродукцияНоменклатура.Пустая() Тогда
			ПоказатьВопрос(Новый ОписаниеОповещения("ПослеЗакрытияВопросаОПересчетеЦен", ЭтаФорма, Параметры), "Пересчитать цены товаров и услуг? Услуги раскроя будут перезаполнены. Будут учтены скидки на основании договора.", РежимДиалогаВопрос.ДаНет,,,,);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ВидЦенПриИзменении(Элемент)
	Если ПраваПользователей.ВидЦенДоступенПользователю(Объект.ВидЦен) Тогда
		ЗадатьВопросОПересчетеЦен();
	Иначе
		Объект.ВидЦен = "";
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ТоварыПослеУдаления(Элемент)
	ОбновитьДанныеДокумента();
	ОбновитьСписокФайлов();
КонецПроцедуры

&НаКлиенте
Процедура УслугиПослеУдаления(Элемент)
	ОбновитьДанныеДокумента();
КонецПроцедуры

&НаКлиенте
Процедура ДанныеФайлаИмпорта(Команда)
	Парам = Новый Структура;
	Парам.Вставить("ДанныеФайлаИмпорта",Объект.ДанныеФайлаИмпорта);
	ОткрытьФорму("Документ.ЗаказНаПроизводство.Форма.ФормаДанныхИмпорта",Парам);
КонецПроцедуры

&НаКлиенте
Процедура УслугиПроцентРучнойСкидкиПриИзменении(Элемент)	
	ТекущаяСтрока = Элементы.Услуги.ТекущиеДанные;
	СуммаБезСкидки = ТекущаяСтрока.Количество * ТекущаяСтрока.Цена;
	ТекущаяСтрока.СуммаРучнойСкидки = СуммаБезСкидки * ТекущаяСтрока.ПроцентРучнойСкидки/100;
	ТекущаяСтрока.Сумма = СуммаБезСкидки - ТекущаяСтрока.СуммаРучнойСкидки;
КонецПроцедуры

&НаКлиенте
Процедура УслугиСуммаРучнойСкидкиПриИзменении(Элемент)
	ТекущаяСтрока = Элементы.Услуги.ТекущиеДанные;
	СуммаБезСкидки = ТекущаяСтрока.Количество * ТекущаяСтрока.Цена;
	Если СуммаБезСкидки = 0 Тогда
		ТекущаяСтрока.ПроцентРучнойСкидки = 0;
		ТекущаяСтрока.Сумма = СуммаБезСкидки;
	Иначе
		ТекущаяСтрока.ПроцентРучнойСкидки = (ТекущаяСтрока.СуммаРучнойСкидки * 100)/СуммаБезСкидки;		
		ТекущаяСтрока.Сумма = СуммаБезСкидки - ТекущаяСтрока.СуммаРучнойСкидки;
	КонецЕсли;  	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыПроцентРучнойСкидкиПриИзменении(Элемент)
	ТекущаяСтрока = Элементы.Товары.ТекущиеДанные;
	СуммаБезСкидки = ТекущаяСтрока.Количество * ТекущаяСтрока.Цена;
	ТекущаяСтрока.СуммаРучнойСкидки = СуммаБезСкидки * ТекущаяСтрока.ПроцентРучнойСкидки/100;
	ТекущаяСтрока.Сумма = СуммаБезСкидки - ТекущаяСтрока.СуммаРучнойСкидки;
КонецПроцедуры

&НаКлиенте
Процедура УстановитьПроцентРучнойСкидкиУслуги(Команда)
	ОП = Новый ОписаниеОповещения("ПослеЗапросаПроцентаРучнойСкидки", ЭтотОбъект, "Услуги");
	ПоказатьВводЧисла(ОП, Объект.Услуги[0].ПроцентРучнойСкидки,"Введите % скидки",10,2);	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьПроцентРучнойСкидкиТовары(Команда)
	ОП = Новый ОписаниеОповещения("ПослеЗапросаПроцентаРучнойСкидки", ЭтотОбъект, "Товары");
	ПоказатьВводЧисла(ОП, Объект.Товары[0].ПроцентРучнойСкидки,"Введите % скидки",10,2);
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗапросаПроцентаРучнойСкидки(ПроцентСкидки,Параметр) Экспорт
	Для Каждого ТекущаяСтрока из Объект[Параметр] Цикл
		ТекущаяСтрока.ПроцентРучнойСкидки = ПроцентСкидки;
		СуммаБезСкидки = ТекущаяСтрока.Количество * ТекущаяСтрока.Цена;
		ТекущаяСтрока.СуммаРучнойСкидки = СуммаБезСкидки * ТекущаяСтрока.ПроцентРучнойСкидки/100;
		ТекущаяСтрока.Сумма = СуммаБезСкидки - ТекущаяСтрока.СуммаРучнойСкидки;
	КонецЦикла;
	ОбновитьДанныеДокумента();
КонецПроцедуры

&НаКлиенте
Процедура ТоварыСуммаРучнойСкидкиПриИзменении(Элемент)
	ТекущаяСтрока = Элементы.Товары.ТекущиеДанные;
	СуммаБезСкидки = ТекущаяСтрока.Количество * ТекущаяСтрока.Цена;
	Если СуммаБезСкидки = 0 Тогда
		ТекущаяСтрока.ПроцентРучнойСкидки = 0;
		ТекущаяСтрока.Сумма = СуммаБезСкидки;
	Иначе
		ТекущаяСтрока.ПроцентРучнойСкидки = (ТекущаяСтрока.СуммаРучнойСкидки * 100)/СуммаБезСкидки;		
		ТекущаяСтрока.Сумма = СуммаБезСкидки - ТекущаяСтрока.СуммаРучнойСкидки;
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьСуммуРучнойСкидкиУслуги(Команда)
