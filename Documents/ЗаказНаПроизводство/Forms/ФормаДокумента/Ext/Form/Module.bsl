&НаКлиенте
Процедура ДополнительнаяФактураВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	Если НЕ Элементы.ФактураПотолка.ТекущиеДанные = Неопределено Тогда
		Фактура = Элементы.ФактураПотолка.ТекущиеДанные.ПродукцияФактура;
		Цвет = Элементы.ФактураПотолка.ТекущиеДанные.ПродукцияЦвет;
		Если Поле.Имя = "ДополнительнаяФактураПродукцияФактура" Тогда
			Если НЕ Фактура.Пустая() Тогда
				ОткрытьФорму("Справочник.Фактура.ФормаОбъекта",Новый Структура("Ключ", Фактура));
			КонецЕсли;
		ИначеЕсли Поле.Имя = "ДополнительнаяФактураПродукцияЦвет" Тогда
			Если НЕ Цвет.Пустая() Тогда
				ОткрытьФорму("Справочник.ЦветФактуры.ФормаОбъекта",Новый Структура("Ключ", Цвет));
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция ПолучитьШиринуФактуры(Фактура)
	Возврат Фактура.ШиринаПолотна;
КонецФункции

&НаКлиенте
Процедура КомандаТиповойОтрез(Команда)
	
	ПараметрыФормы = Новый Структура("РежимДобавленияТиповогоОтреза", Истина);
	Если Объект.ФактураПотолка.Количество() > 0 Тогда
		ПараметрыФормы.Вставить("Фактура",Объект.ФактураПотолка[0].ПродукцияФактура);
		ПараметрыФормы.Вставить("Цвет",Объект.ФактураПотолка[0].ПродукцияЦвет);
		//ПараметрыФормы.Вставить("Количество",0);
		ПараметрыФормы.Вставить("Длина",0);
		//ШиринаПолотна = ПолучитьШиринуФактуры(Объект.ФактураПотолка[0].ПродукцияФактура) / 100;
		ШиринаПолотна = ПолучитьШиринуФактуры(Объект.ФактураПотолка[0].ПродукцияФактура);;
		Если НЕ ШиринаПолотна = 0 Тогда
			//ПараметрыФормы.Вставить("Количество",Окр(Объект.ПродукцияНоменклатураКоличество / ШиринаПолотна,2));
			ПараметрыФормы.Вставить("Длина",Окр(Объект.ПродукцияНоменклатураКоличество*10000 / ШиринаПолотна,2));
		КонецЕсли;
	КонецЕсли;
	ОписаниеОповещения = Новый ОписаниеОповещения("ПослеВводаПараметровОтреза", ЭтотОбъект, ПараметрыФормы);
	//ОткрытьФорму("Документ.ЗаказНаПроизводство.Форма.ФормаПараметрыТиповогоОтреза",ПараметрыФормы,,,ВариантОткрытияОкна.ОтдельноеОкно,,ОписаниеОповещения);	
	ОткрытьФорму("ОбщаяФорма.ФормаДобавленияПродукции", ПараметрыФормы, ЭтотОбъект, ,,, ОписаниеОповещения);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВводаПараметровОтреза(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Объект.ФактураПотолка.Очистить();
	НоваяСтрока = Объект.ФактураПотолка.Добавить();
	НоваяСтрока.Основная = Истина;
	НоваяСтрока.ПродукцияФактура = Результат.Фактура;
	НоваяСтрока.ПродукцияЦвет = Результат.Цвет;
	
	//НоваяСтрока.ПродукцияКоличество = Результат.Количество * ПолучитьШиринуФактуры(НоваяСтрока.ПродукцияФактура)/100;	
	//Объект.ПродукцияНоменклатураКоличество = Результат.Количество * ПолучитьШиринуФактуры(НоваяСтрока.ПродукцияФактура)/100;
	//Объект.ПродукцияНомерРасчета = ОбменСEasyCeiling.ПолучитьНомерТиповогоОтреза(СтрЗаменить(Результат.Количество*100,Символ(160),""),ПолучитьШиринуФактуры(НоваяСтрока.ПродукцияФактура));	
	//РезультатСозданияНоменклатуры = СоздатьНоменклатуруТиповогоОтрезаНаСервере();
	//Состояние(РезультатСозданияНоменклатуры);
	
	НоваяСтрока.ПродукцияКоличество = Результат.Количество;	
	Объект.ПродукцияНоменклатураКоличество = Результат.Количество;
	Объект.ПродукцияНомерРасчета = Результат.НомерПотолка;	
	Объект.ПродукцияНоменклатура = Результат.Номенклатура;
	Объект.ПродукцияНоменклатураКоэффициент = 1;
	Объект.ПродукцияНоменклатураЕдиницаИзмерения = ПолучитьБазовуюЕдиницуИзмеренияНоменклатуры(Объект.ПродукцияНоменклатура);
	
	ЗаполнитьМатериалыТиповогоОтреза();
	ЗаполнитьДанныеОстаткиПоМатериалам();
	Состояние("Таблица материалов перезаполнена");
	
	ОбновитьСписокФайлов();
		
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьМатериалыТиповогоОтреза()
	
	Объект.Материалы.Очистить();
	Для Каждого ТекущаяСтрока Из Объект.ФактураПотолка Цикл
		НоваяСтрока = Объект.Материалы.Добавить();
		НоваяСтрока.Номенклатура = ТекущаяСтрока.ПродукцияЦвет.Номенклатура;
		НоваяСтрока.ЕдиницаИзмерения = ПолучитьБазовуюЕдиницуИзмеренияНоменклатуры(НоваяСтрока.Номенклатура);
		НоваяСтрока.Коэффициент = 1;
		Если НоваяСтрока.ЕдиницаИзмерения = Справочники.КлассификаторЕдиницИзмерения.МетрПогонный Тогда
			ШиринаПолотна = ПолучитьШиринуФактуры(ТекущаяСтрока.ПродукцияФактура) / 100;
			Если НЕ ШиринаПолотна = 0 Тогда
				НоваяСтрока.Количество = Окр(Объект.ПродукцияНоменклатураКоличество / ШиринаПолотна,2);
			Иначе
				НоваяСтрока.Количество = 0;
			КонецЕсли;
		Иначе
			НоваяСтрока.Количество = Объект.ПродукцияНоменклатураКоличество;
		КонецЕсли;
		НоваяСтрока.КоличествоКВыработке = НоваяСтрока.Количество;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ПродукцияЕдиницаИзмеренияПриИзменении(Элемент)
	СтрокаТабличнойЧасти = Элементы.Продукция.ТекущиеДанные;
	Если ТипЗнч(СтрокаТабличнойЧасти.ЕдиницаИзмерения) = Тип("СправочникСсылка.КлассификаторЕдиницИзмерения") Тогда
