&НаКлиенте
Процедура ПослеВводаОбщегоПроцентаСкидки(РазмерСкидки, Параметры) Экспорт
    Если НЕ РазмерСкидки = Неопределено Тогда
		
		//продукция типового производства
		Для Каждого ТекущаяСтрока Из Объект.Продукция Цикл
			ТекущаяСтрока.ПроцентРучнойСкидки = РазмерСкидки;
			СуммаБезСкидки = ТекущаяСтрока.Количество * ТекущаяСтрока.Цена;
			ТекущаяСтрока.СуммаРучнойСкидки = СуммаБезСкидки * ТекущаяСтрока.ПроцентРучнойСкидки/100;
			ТекущаяСтрока.Сумма = СуммаБезСкидки - ТекущаяСтрока.СуммаРучнойСкидки;
		КонецЦикла;
		
		//продукция потолка
		Объект.ПродукцияПроцентРучнойСкидки = РазмерСкидки;
		СуммаБезСкидки = Объект.ПродукцияНоменклатураКоличество * Объект.ПродукцияЦена;
		Объект.ПродукцияСуммаРучнойСкидки = СуммаБезСкидки * Объект.ПродукцияПроцентРучнойСкидки/100;
		Объект.ПродукцияСумма = СуммаБезСкидки - Объект.ПродукцияСуммаРучнойСкидки;
		
		//товары
		Для Каждого ТекущаяСтрока Из Объект.Товары Цикл
			ТекущаяСтрока.ПроцентРучнойСкидки = РазмерСкидки;
			СуммаБезСкидки = ТекущаяСтрока.Количество * ТекущаяСтрока.Цена;
			ТекущаяСтрока.СуммаРучнойСкидки = СуммаБезСкидки * ТекущаяСтрока.ПроцентРучнойСкидки/100;
			ТекущаяСтрока.Сумма = СуммаБезСкидки - ТекущаяСтрока.СуммаРучнойСкидки;
		КонецЦикла;
		
		//услуги
		Для Каждого ТекущаяСтрока Из Объект.Услуги Цикл
			ТекущаяСтрока.ПроцентРучнойСкидки = РазмерСкидки;
			СуммаБезСкидки = ТекущаяСтрока.Количество * ТекущаяСтрока.Цена;
			ТекущаяСтрока.СуммаРучнойСкидки = СуммаБезСкидки * ТекущаяСтрока.ПроцентРучнойСкидки/100;
			ТекущаяСтрока.Сумма = СуммаБезСкидки - ТекущаяСтрока.СуммаРучнойСкидки;
		КонецЦикла;
	
		ОбновитьДанныеДокумента();

    КонецЕсли;
КонецПроцедуры

&НаСервере
Функция НаценкаЗаСрочностьНаСервере()
	
	УслугаСрочность = Константы.СрочностьУслуга.Получить();
	Если УслугаСрочность.Пустая() Тогда
		Возврат "В настройках программы не задана услуга срочности";
	КонецЕсли;
	
	ПроцентСрочность = Константы.СрочностьПроцент.Получить();
	Если ПроцентСрочность = 0 Тогда
		Возврат "В настройках программы не указана стоимость в % за срочность";
	КонецЕсли;
	
	//получим стоимость продукции + товары
	СтоимостьЗаказа = Объект.Продукция.Итог("Сумма") + Объект.ПродукцияСумма + Объект.Товары.Итог("Сумма");
	//получим стоимость услуг без стоимости срочности
	СтрокаСрочность = Неопределено;
	Для Каждого ТекущаяСтрока Из Объект.Услуги Цикл
		Если ТекущаяСтрока.Номенклатура = УслугаСрочность Тогда
			СтрокаСрочность = ТекущаяСтрока;
		Иначе
			СтоимостьЗаказа = СтоимостьЗаказа + ТекущаяСтрока.Сумма;
		КонецЕсли;
	КонецЦикла;
	
	Если НЕ СтрокаСрочность = Неопределено Тогда
		СтрокаСрочность.ЕдиницаИзмерения = СтрокаСрочность.Номенклатура.БазоваяЕдиницаИзмерения;
		СтрокаСрочность.Количество = 1;
		СтрокаСрочность.Коэффициент = 1;
		СтрокаСрочность.Цена = СтоимостьЗаказа * ПроцентСрочность / 100;
		СтрокаСрочность.Сумма = СтрокаСрочность.Цена;
		Результат = "Стоимость за срочность обновлена";
	Иначе
		НоваяСтрока = Объект.Услуги.Добавить();
		НоваяСтрока.Номенклатура = УслугаСрочность;
		НоваяСтрока.ЕдиницаИзмерения = НоваяСтрока.Номенклатура.БазоваяЕдиницаИзмерения;
		НоваяСтрока.Количество = 1;
		НоваяСтрока.Коэффициент = 1;
		НоваяСтрока.Цена = СтоимостьЗаказа * ПроцентСрочность / 100;
		НоваяСтрока.Сумма = НоваяСтрока.Цена;
		Результат = "Установлена стоимость за срочность";
	КонецЕсли;
	
	ОбновитьДанныеДокумента();
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура НаценкаЗаСрочность(Команда)
	Результат = НаценкаЗаСрочностьНаСервере();
	ПоказатьПредупреждение(,Результат);
КонецПроцедуры

&НаКлиенте
Процедура ТоварыХарактеристикаНоменклатурыПриИзменении(Элемент)
	СтрокаТабличнойЧасти = Элементы.Товары.ТекущиеДанные;
	СтрокаТабличнойЧасти.Цена = ПолучитьЦенуНоменклатуры(СтрокаТабличнойЧасти.Номенклатура, СтрокаТабличнойЧасти.ХарактеристикаНоменклатуры, СтрокаТабличнойЧасти.ЕдиницаИзмерения);
	СтрокаТабличнойЧасти.Сумма = СтрокаТабличнойЧасти.Цена * СтрокаТабличнойЧасти.Количество;
