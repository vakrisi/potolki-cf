&НаСервере
Функция ПроверитьПоступлениеТоваровПоТоварамМожноПереводить()
	Запрос = новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	 	|   ЗаказНаПроизводство.Номенклатура,
		|   ЕСТЬNULL(ЗаказНаПроизводство.Количество, 0) КАК Оформлено,
		|	ЕСТЬNULL(ПоступлениеТоваров.Количество, 0) КАК Поступило		
		|ИЗ	
		|   Документ.ЗаказНаПроизводство.Товары КАК ЗаказНаПроизводство
		|
		|ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПоступлениеТоваровИУслуг.Товары КАК ПоступлениеТоваров		
		|ПО ЗаказНаПроизводство.Ссылка = ПоступлениеТоваров.Ссылка.Основание
		|	И ЗаказНаПроизводство.Номенклатура = ПоступлениеТоваров.Номенклатура
		|
		|ГДЕ ЗаказНаПроизводство.Ссылка = &ЗаказНаПроизводство";
	Запрос.УстановитьПараметр("ЗаказНаПроизводство", Объект.Ссылка);
	Выборка = Запрос.Выполнить().Выбрать();
	ПеревестиСтатус = Истина;
	Пока Выборка.Следующий() Цикл
		 Если (Выборка.Оформлено - Выборка.Поступило) > 0 Тогда			
			ПеревестиСтатус = Ложь;
		КонецЕсли;	
	КонецЦикла;
	
	Возврат ПеревестиСтатус;
	 
КонецФункции

&НаСервере
Функция ПолучитьДокументОснование(Заказ)
	
	Результат = Неопределено;
	
	Попытка
		Результат = Заказ.ДокументОснование;
	Исключение
		Результат = Неопределено
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ДокументПродажиОформленНаВсеТовары(Ссылка)
	
	Если ТипЗнч(Ссылка) = Тип("ДокументСсылка.ЗаказНаПроизводство") Тогда
		СписокЗаказов = Новый СписокЗначений;
		СписокЗаказов.Добавить(Ссылка);
	ИначеЕсли ТипЗнч(Ссылка) = Тип("СписокЗначений") Тогда
		СписокЗаказов = Ссылка;
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЗаказыПокупателейОстатки.ЗаказНаПроизводство КАК ЗаказНаПроизводство,
	|	ЗаказыПокупателейОстатки.Номенклатура КАК Номенклатура,
	|	ЗаказыПокупателейОстатки.КоличествоОстаток КАК КоличествоОстаток
	|ИЗ
	|	РегистрНакопления.ЗаказыПокупателей.Остатки(, ЗаказНаПроизводство В (&ЗаказНаПроизводство)) КАК ЗаказыПокупателейОстатки";
	Запрос.УстановитьПараметр("ЗаказНаПроизводство", СписокЗаказов);
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда 
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;
		
КонецФункции

&НаСервере 
Функция ЕстьДокументПродажиПоЗаказу(Ссылка)
	
	Результат = Ложь;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЗаказыНаПроизводствоОбороты.Регистратор
	|ИЗ
	|	РегистрНакопления.ЗаказыПокупателей.Обороты(, , Регистратор, ЗаказНаПроизводство = &ЗаказНаПроизводство) КАК ЗаказыНаПроизводствоОбороты
	|ГДЕ
	|	ЗаказыНаПроизводствоОбороты.КоличествоРасход > 0";
	Запрос.УстановитьПараметр("ЗаказНаПроизводство",Ссылка);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат = Истина;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ПеревестиВСтатусОтменен(Команда)

	Режим = РежимДиалогаВопрос.ДаНет;
	Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопросаОбОтменеЗаказа", ЭтаФорма, Параметры);
	ПоказатьВопрос(Оповещение, "Перевести заказ на производство в статус ""ОТМЕНЕН""?"+Символы.ПС+"Документ будет автоматически записан после смены статуса",РежимДиалогаВопрос.ДаНет);

