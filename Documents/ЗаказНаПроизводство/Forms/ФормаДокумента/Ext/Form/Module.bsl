	СтрокаТабличнойЧасти.Цена = ПолучитьЦенуНоменклатуры(СтрокаТабличнойЧасти.Номенклатура, Неопределено, СтрокаТабличнойЧасти.ЕдиницаИзмерения, Истина);
	//заккоментирована потому что добавлены скидки по договору
	//СтрокаТабличнойЧасти.Сумма = СтрокаТабличнойЧасти.Цена;
	СуммаБезСкидки = СтрокаТабличнойЧасти.Количество * СтрокаТабличнойЧасти.Цена;
	Если Объект.СкидкаНаУслуги <> 0 Тогда
		СтрокаТабличнойЧасти.ПроцентРучнойСкидки = Объект.СкидкаНаУслуги;		
		СтрокаТабличнойЧасти.СуммаРучнойСкидки = СуммаБезСкидки * СтрокаТабличнойЧасти.ПроцентРучнойСкидки/100;
	Иначе
		СтрокаТабличнойЧасти.ПроцентРучнойСкидки = 0;
		СтрокаТабличнойЧасти.СуммаРучнойСкидки = 0;		
	КонецЕсли;		
	
	СтрокаТабличнойЧасти.Сумма = СуммаБезСкидки - СтрокаТабличнойЧасти.СуммаРучнойСкидки;
	//СтрокаТабличнойЧасти.КоличествоКВыработке = 1;
	
КонецПроцедуры

&НаКлиенте
Процедура УслугиЕдиницаИзмеренияПриИзменении(Элемент)
	
	СтрокаТабличнойЧасти = Элементы.Услуги.ТекущиеДанные;
	Если ТипЗнч(СтрокаТабличнойЧасти.ЕдиницаИзмерения) = Тип("СправочникСсылка.КлассификаторЕдиницИзмерения") Тогда
		СтрокаТабличнойЧасти.Коэффициент = 1;
	Иначе
		СтрокаТабличнойЧасти.Коэффициент = ОбщийМодуль.ПолучитьКоэффициентЕдиницыИзмерения(СтрокаТабличнойЧасти.ЕдиницаИзмерения);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УслугиЕдиницаИзмеренияНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	СтрокаТабличнойЧасти = Элементы.Услуги.ТекущиеДанные;
	СписокЕдиниц = ОбщийМодуль.ПолучитьСписокЕдиницИзмеренияНоменклатуры(СтрокаТабличнойЧасти.Номенклатура);
	
	ДанныеВыбора = Новый СписокЗначений;
	Для Ном = 0 По СписокЕдиниц.Количество() - 1 Цикл
		ДанныеВыбора.Добавить(СписокЕдиниц[Ном]);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура УслугиЕдиницаИзмеренияОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	СтрокаТабличнойЧасти = Элементы.Услуги.ТекущиеДанные;
	Если ТипЗнч(ВыбранноеЗначение) = Тип("СправочникСсылка.КлассификаторЕдиницИзмерения") Тогда
		СтрокаТабличнойЧасти.Коэффициент = 1;
	Иначе
		СтрокаТабличнойЧасти.Коэффициент = ОбщийМодуль.ПолучитьКоэффициентЕдиницыИзмерения(ВыбранноеЗначение);
	КонецЕсли;
	
КонецПроцедуры
	
&НаКлиенте
Процедура ПродукцияЦенаПриИзменении(Элемент)
	СуммаБезСкидки = Объект.ПродукцияНоменклатураКоличество * Объект.ПродукцияЦена;
	Объект.ПродукцияСуммаРучнойСкидки = СуммаБезСкидки * Объект.ПродукцияПроцентРучнойСкидки/100;
	Объект.ПродукцияСумма = СуммаБезСкидки - Объект.ПродукцияСуммаРучнойСкидки;
	
	ОбновитьДанныеДокумента();
	ЗаполнитьДанныеКОтгрузкеИОстаткиПоПродукции();
КонецПроцедуры

&НаКлиенте
Процедура ПродукцияСуммаПриИзменении(Элемент)
	СуммаБезСкидки = Объект.ПродукцияНоменклатураКоличество * Объект.ПродукцияЦена;
	Если СуммаБезСкидки = 0 Тогда
		Объект.ПродукцияСуммаРучнойСкидки = 0;
		Объект.ПродукцияПроцентРучнойСкидки = 0;
	Иначе
		Объект.ПродукцияСуммаРучнойСкидки = СуммаБезСкидки - Объект.ПродукцияСумма;
		Объект.ПродукцияПроцентРучнойСкидки = (Объект.ПродукцияСуммаРучнойСкидки * 100) / СуммаБезСкидки;  
	КонецЕсли;
	
	ОбновитьДанныеДокумента();
	ЗаполнитьДанныеКОтгрузкеИОстаткиПоПродукции();
КонецПроцедуры

&НаКлиенте
Процедура ПрикрепитьФайл(Команда)
	
	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
		ПоказатьПредупреждение(, "Документ не сохранен!");
		Возврат;
	КонецЕсли;
	
	ОбщийМодульКлиент.ПослеВыбораСсылкиДляПрикрепленияФайла(Объект.Ссылка);
	
КонецПроцедуры

&НаСервере
Процедура РассчитатьЦентровкуШваНаСервере()
	
	//УслугаЦентровки = Справочники.ЦеныУслугРаскроя.ПолучитьНоменклатуруУслугиЦентровкиШва(Перечисления.ВидыОперацийУстановкиЦенНаУслугиПроизводства.ПоВидуЦен, Объект.ВидЦен, Объект.Дата, Объект.Валюта);
	//ПроцентЗаЦентровку = Справочники.ЦеныУслугРаскроя.ПолучитьСтоимостьУслугиЦентровкиШва(Перечисления.ВидыОперацийУстановкиЦенНаУслугиПроизводства.ПоВидуЦен, Объект.ВидЦен, Объект.Дата, Объект.Валюта) / 100;
	//НеВключатьУслуги = Справочники.ЦеныУслугРаскроя.СтоимостьЦентровкиШваНеВключаетСтоимостьУслуг(Перечисления.ВидыОперацийУстановкиЦенНаУслугиПроизводства.ПоВидуЦен, Объект.ВидЦен, Объект.Дата, Объект.Валюта);
	ДанныеЦентровки = Справочники.ЦеныУслугРаскроя.ПолучитьДанныеУслугиЦентровкиШва(Объект.Дата, Объект.Валюта, Справочники.ВидыНоменклатуры.Потолок, Перечисления.ВидыОперацийУстановкиЦенНаУслугиПроизводства.ПоВидуЦен, Объект.ВидЦен, Объект.ДоговорКонтрагента);
	УслугаЦентровки 	= ДанныеЦентровки.НоменклатураУслугиЦентровкиШва;
	ПроцентЗаЦентровку 	= ДанныеЦентровки.СтоимостьУслугиЦентровкиШва;
	НеВключатьУслуги    = ДанныеЦентровки.СтоимостьЦентровкиШваНеВключаетСтоимостьУслуг;
	
	//Если ПроцентЗаЦентровку = 0 Тогда
	//	ПроцентЗаЦентровку = Константы.СтоимостьУслугиЦентровкиШва.Получить() / 100;
	//КонецЕсли;
	
	УслугаСрочность = Константы.СрочностьУслуга.Получить();
		
	//сначала проверим, есть ли что рассчитывать
	НужноРасчитывать = Ложь;
	Для Каждого Услуга Из Объект.Услуги Цикл
		Если Услуга.Номенклатура = УслугаЦентровки Тогда
			НужноРасчитывать = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если НЕ НужноРасчитывать Тогда
		Сообщить("В документе нет услуги по центровке швов.");
		Возврат;
	КонецЕсли;
	
	//проверим, оценена ли продукция
	НужноРасчитывать = Истина;
	Для Каждого Товары Из Объект.Товары Цикл
		Если Товары.Сумма = 0 Тогда
			НужноРасчитывать = Ложь;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если НЕ Объект.ПродукцияФактура.Пустая() тогда
		Если Объект.ПродукцияСумма = 0 Тогда
			НужноРасчитывать = Ложь;
		КонецЕсли;
	КонецЕсли;
	Если НЕ НужноРасчитывать Тогда
		Сообщить("В документе имеется продукция или товар без стоимости. Расчет остановлен.");
		Возврат;
	КонецЕсли;
	
	ТекСтоимостьУслуг = 0;
	Для Каждого ТекущаяСтрока Из Объект.Услуги Цикл
		Если НЕ ТекущаяСтрока.Номенклатура = УслугаЦентровки
			И НЕ ТекущаяСтрока.Номенклатура = УслугаСрочность Тогда
			ТекСтоимостьУслуг = ТекСтоимостьУслуг + ТекущаяСтрока.Сумма;
		КонецЕсли;
	КонецЦикла;
	
	Если НеВключатьУслуги Тогда
		ТекСтоимостьУслуг = Объект.ПродукцияСумма;
	Иначе
		ТекСтоимостьУслуг = ТекСтоимостьУслуг + Объект.ПродукцияСумма;
	КонецЕсли;
	ТекСтоимостьЦентровки = ТекСтоимостьУслуг * ПроцентЗаЦентровку;
	
	Для Каждого Услуга Из Объект.Услуги Цикл
		Если Услуга.Номенклатура = УслугаЦентровки Тогда
			Услуга.Сумма = ТекСтоимостьЦентровки;
			Если НЕ Услуга.Количество = 0 Тогда
				Услуга.Цена = Услуга.Сумма / Услуга.Количество;
			КонецЕсли;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьЦентровкуШва(Команда)
	РассчитатьЦентровкуШваНаСервере();
