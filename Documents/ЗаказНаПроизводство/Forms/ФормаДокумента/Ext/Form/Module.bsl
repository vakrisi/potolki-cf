&НаКлиенте
Процедура УстановитьСуммуРучнойСкидкиТовары(Команда)
	ОП = Новый ОписаниеОповещения("ПослеЗапросаСуммыРучнойСкидки", ЭтотОбъект, "Товары");
	ПоказатьВводЧисла(ОП, 0,"Введите сумму скидки в каждой строке",10,2);
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗапросаСуммыРучнойСкидки(СуммаСкидки,Параметр) Экспорт
	Для Каждого ТекущаяСтрока из Объект[Параметр] Цикл 		
		ТекущаяСтрока.СуммаРучнойСкидки = СуммаСкидки;
		СуммаБезСкидки = ТекущаяСтрока.Количество * ТекущаяСтрока.Цена;
		Если СуммаБезСкидки = 0 Тогда
			ТекущаяСтрока.ПроцентРучнойСкидки = 0;
			ТекущаяСтрока.Сумма = СуммаБезСкидки;
		Иначе
			ТекущаяСтрока.ПроцентРучнойСкидки = (ТекущаяСтрока.СуммаРучнойСкидки * 100)/СуммаБезСкидки;		
			ТекущаяСтрока.Сумма = СуммаБезСкидки - ТекущаяСтрока.СуммаРучнойСкидки;
		КонецЕсли;
	КонецЦикла;
	ОбновитьДанныеДокумента();
КонецПроцедуры

&НаКлиенте
Процедура ПродукцияНоменклатураКоличествоПриИзменении(Элемент)
	
	//Если Объект.ПродукцияНоменклатураКоличество < ПродукцияНоменклатураКоличествоПредыдущееЗначение Тогда
	//	ПоказатьПредупреждение(,"Количество потолка можно изменить только в большую сторону");
	//	Объект.ПродукцияНоменклатураКоличество = ПродукцияНоменклатураКоличествоПредыдущееЗначение;
	//Иначе
	//	ПродукцияНоменклатураКоличествоПредыдущееЗначение = Объект.ПродукцияНоменклатураКоличество;
	//КонецЕсли;
	
	СуммаБезСкидки = Объект.ПродукцияНоменклатураКоличество * Объект.ПродукцияЦена;
	Объект.ПродукцияСуммаРучнойСкидки = СуммаБезСкидки * Объект.ПродукцияПроцентРучнойСкидки/100;
	Объект.ПродукцияСумма = СуммаБезСкидки - Объект.ПродукцияСуммаРучнойСкидки;
	
	ОбновитьДанныеДокумента();
	ЗаполнитьДанныеКОтгрузкеИОстаткиПоПродукции();	
	
КонецПроцедуры

&НаКлиенте
Процедура ПродукцияПроцентРучнойСкидкиПриИзменении(Элемент)
	
	СуммаБезСкидки = Объект.ПродукцияНоменклатураКоличество * Объект.ПродукцияЦена;
	Объект.ПродукцияСуммаРучнойСкидки = СуммаБезСкидки * Объект.ПродукцияПроцентРучнойСкидки/100;
	Объект.ПродукцияСумма = СуммаБезСкидки - Объект.ПродукцияСуммаРучнойСкидки;
	
	ОбновитьДанныеДокумента();
	ЗаполнитьДанныеКОтгрузкеИОстаткиПоПродукции();
	
КонецПроцедуры

&НаКлиенте
Процедура ПродукцияСуммаРучнойСкидкиПриИзменении(Элемент)
	
	СуммаБезСкидки = Объект.ПродукцияНоменклатураКоличество * Объект.ПродукцияЦена;
	Если СуммаБезСкидки = 0 Тогда
		Объект.ПродукцияПроцентРучнойСкидки = 0;
		Объект.ПродукцияСумма = СуммаБезСкидки;
	Иначе
		Объект.ПродукцияПроцентРучнойСкидки = (Объект.ПродукцияСуммаРучнойСкидки * 100)/СуммаБезСкидки;		
		Объект.ПродукцияСумма = СуммаБезСкидки - Объект.ПродукцияСуммаРучнойСкидки;
	КонецЕсли;
	
	ОбновитьДанныеДокумента();
	ЗаполнитьДанныеКОтгрузкеИОстаткиПоПродукции();
	
КонецПроцедуры

&НаСервере
Процедура ВосстановитьКоличествоПродукцииПоДаннымПостроителяНаСервере()
	
	НомерСимволаНачалаСтроки = СтрНайти(Объект.ДанныеФайлаИмпорта, "КоличествоПродукция");
	Если НомерСимволаНачалаСтроки > 0 Тогда
		НомерСимволаКонцаСтроки = СтрНайти(Объект.ДанныеФайлаИмпорта, Символы.ПС, , НомерСимволаНачалаСтроки);
		Если НомерСимволаКонцаСтроки > 0 Тогда
			СтрокаСКоличеством = Сред(Объект.ДанныеФайлаИмпорта,НомерСимволаНачалаСтроки,НомерСимволаКонцаСтроки-НомерСимволаНачалаСтроки);
			Если НЕ ПустаяСтрока(СтрокаСКоличеством) Тогда
				НомерСимволаРавно = СтрНайти(СтрокаСКоличеством,"=");
				Если НомерСимволаРавно > 0 Тогда
					СтрокаКоличество = СокрЛП(Сред(СтрокаСКоличеством, НомерСимволаРавно+1, СтрДлина(СтрокаСКоличеством)-НомерСимволаРавно));
					Попытка
						Объект.ПродукцияНоменклатураКоличество = СтрЗаменить(СтрокаКоличество," ","");
					Исключение
					КонецПопытки;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВосстановитьКоличествоПродукцииПоДаннымПостроителя(Команда)
	ВосстановитьКоличествоПродукцииПоДаннымПостроителяНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ОтчетДетализацияВзаиморасчетов(Команда)
	ПараметрыОтчета = Новый Структура("Отбор, СформироватьПриОткрытии", 
                                    Новый Структура("Контрагент", Объект.Контрагент), 
                                    Истина);
	//ПараметрыОтчета = Новый Структура;
	//ПараметрыОтчета.Вставить("Контрагент",Объект.Контрагент);
	ОткрытьФорму("Отчет.ДетализацияВзаиморасчетовСКонтрагентом.Форма",ПараметрыОтчета);
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДанныеКОтгрузкеИОстаткиПоПродукции()
	
	СкладПараметр = Объект.Склад;
	Если СкладОтгрузкиПотолоковОтличаетсяОтСкладаГотовойПродукции
		 И ОбщийМодульСервер.НастройкаПользователя("ВЗаказеНаПроизводствоПодсветкаОстатковПоСкладуОтгрузки") Тогда
		СкладПараметр = Объект.СкладОтгрузки;		
	КонецЕсли;

	Если Объект.ВидЗаказа = Перечисления.ВидыЗаказовНаПроизводство.ТиповоеПроизводство Тогда
		
		//продукция типового производства
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТЗЗаказПокупателяТовары.Номенклатура,
		|	ТЗЗаказПокупателяТовары.Количество,
		|	ТЗЗаказПокупателяТовары.Коэффициент
		|ПОМЕСТИТЬ ВремЗаказПокупателяТовары
		|ИЗ
		|	&ТаблицаДокумента КАК ТЗЗаказПокупателяТовары
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ЗаказПокупателяТовары.Номенклатура,
		|	ВЫБОР
		|		КОГДА ЗаказПокупателяТовары.Коэффициент <> 0
		|			ТОГДА ТоварыНаСкладахОстатки.КоличествоОстаток / ЗаказПокупателяТовары.Коэффициент
		|		ИНАЧЕ ТоварыНаСкладахОстатки.КоличествоОстаток
		|	КОНЕЦ КАК ОстатокНаСкладе,
		|	ЕСТЬNULL(ВЫБОР		
		|		КОГДА &ИспользоватьРезервирование
		|			ТОГДА ВЫБОР
		|					КОГДА ЗаказПокупателяТовары.Коэффициент <> 0
		|						ТОГДА ВРезервеОстатки.КоличествоОстаток / ЗаказПокупателяТовары.Коэффициент
		|					ИНАЧЕ ВРезервеОстатки.КоличествоОстаток
		|				КОНЕЦ
		|		ИНАЧЕ 0
		|	КОНЕЦ, 0) КАК КоличествоВРезерве
		|ИЗ
		|	ВремЗаказПокупателяТовары КАК ЗаказПокупателяТовары
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыНаСкладах.Остатки(
		|				,
		|				ВЫБОР
		|						КОГДА &ИспользуютсяОбщиеСклады
		|							ТОГДА ИСТИНА
		|						ИНАЧЕ Организация = &Организация
		|					КОНЕЦ
		|					И Склад = &Склад) КАК ТоварыНаСкладахОстатки
		|		ПО ЗаказПокупателяТовары.Номенклатура = ТоварыНаСкладахОстатки.Номенклатура
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыВРезервеНаСкладах.Остатки(,
		|				Склад = &Склад
		|					И ВЫБОР
		|						КОГДА &ИспользуютсяОбщиеСклады
		|							ТОГДА ИСТИНА
		|						ИНАЧЕ Организация = &Организация
		|					КОНЕЦ) КАК ВРезервеОстатки
		|		ПО (ЗаказПокупателяТовары.Номенклатура = ВРезервеОстатки.Номенклатура)";
		Запрос.УстановитьПараметр("ТаблицаДокумента",Объект.Продукция.Выгрузить());
		Запрос.УстановитьПараметр("Организация",Объект.Организация);
		Запрос.УстановитьПараметр("Склад", СкладПараметр); //?(НЕ СкладОтгрузкиПотолоковОтличаетсяОтСкладаГотовойПродукции,Объект.Склад,Объект.СкладОтгрузки));
		Запрос.УстановитьПараметр("ЗаказНаПроизводство",Объект.Ссылка);
		Запрос.УстановитьПараметр("ИспользуютсяОбщиеСклады", Константы.ОбщиеСклады.Получить());
		Запрос.УстановитьПараметр("ИспользоватьРезервирование", Константы.ИспользоватьРезервирование.Получить());
		
		РезультатЗапроса = Запрос.Выполнить().Выгрузить();
		
		Для Каждого ТекущаяСтрока Из Объект.Продукция Цикл
			Отбор = Новый Структура;
			Отбор.Вставить("Номенклатура",ТекущаяСтрока.Номенклатура);
			НайденныеСтроки = РезультатЗапроса.НайтиСтроки(Отбор);
			Если НайденныеСтроки.Количество() > 0 Тогда
				ТекущаяСтрока.ОстатокНаСкладе = НайденныеСтроки[0].ОстатокНаСкладе;
				ТекущаяСтрока.ВРезерве = НайденныеСтроки[0].КоличествоВРезерве;
