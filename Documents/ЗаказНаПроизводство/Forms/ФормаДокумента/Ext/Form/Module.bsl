&НаКлиенте
Процедура ОтправитьВсеВложенныеФайлыНаПринтер(Команда)
	
	Если Объект.Ссылка.Пустая() Или Модифицированность Тогда
		
		Оповещение = Новый ОписаниеОповещения("ПослеВопросаОЗаписиДокументаПриОтправкеВсехФайловНаПринтер", ЭтаФорма);
		
		ПоказатьВопрос(Оповещение, "Для продолжения необходимо записать документ, продолжить?", РежимДиалогаВопрос.ДаНет);
		
	Иначе
		
		ОбщийМодульКлиент.ОтправитьВсеВложенныеФайлыЗаказаНаПроизводствоНаПринтер(Объект.Ссылка, ЭтотОбъект.УникальныйИдентификатор);
		
		УстановитьГалочкуНачалиПроизводство();
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВопросаОЗаписиДокументаПриОтправкеВсехФайловНаПринтер(Ответ, ДополнительныеПараметры) Экспорт
	
	Если НЕ Ответ = КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	Если Записать() Тогда
	
		ОбщийМодульКлиент.ОтправитьВсеВложенныеФайлыЗаказаНаПроизводствоНаПринтер(Объект.Ссылка, ЭтотОбъект.УникальныйИдентификатор);
		
		УстановитьГалочкуНачалиПроизводство();
		
	КонецЕсли;
	
КонецПроцедуры
