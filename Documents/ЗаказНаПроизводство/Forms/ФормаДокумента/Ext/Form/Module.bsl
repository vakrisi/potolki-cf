&НаСервере
Функция ПолучитьОсновнуюФактуруИЦвет()
	
	СтруктураОтвета = Новый Структура;
	СтруктураОтвета.Вставить("ПродукцияФактура",Справочники.Фактура.ПустаяСсылка()); 
	СтруктураОтвета.Вставить("ПродукцияЦвет",Справочники.ЦветФактуры.ПустаяСсылка());
	
	Для Каждого ТекущаяСтрока Из Объект.ФактураПотолка Цикл
		Если ТекущаяСтрока.Основная Тогда
			СтруктураОтвета.ПродукцияФактура = ТекущаяСтрока.ПродукцияФактура;
			СтруктураОтвета.ПродукцияЦвет = ТекущаяСтрока.ПродукцияЦвет;
		КонецЕсли;
	КонецЦикла;
	
	Возврат СтруктураОтвета;
	
КонецФункции

&НаСервере 
Функция НайтиДокументВыпускаПродукции()
	
	Результат = Документы.ВыпускПродукции.ПустаяСсылка();
	
	ОсновнаяФактура = ПолучитьОсновнуюФактуруИЦвет();
	
	//подберем последний документ выпуска продукции по данному заказу на производство
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЗаказыНаПроизводствоОбороты.Регистратор
	|ИЗ
	|	РегистрНакопления.ЗаказыНаПроизводство.Обороты(, , Регистратор, ЗаказНаПроизводство = &ЗаказНаПроизводство) КАК ЗаказыНаПроизводствоОбороты
	|ГДЕ
	|	ЗаказыНаПроизводствоОбороты.КоличествоРасход > 0
	|	И ЗаказыНаПроизводствоОбороты.Фактура = &Фактура
	|	И ЗаказыНаПроизводствоОбороты.ЦветФактуры = &ЦветФактуры
	|	И ЗаказыНаПроизводствоОбороты.НомерРасчета = &НомерРасчета";
	Запрос.УстановитьПараметр("ЗаказНаПроизводство",Объект.Ссылка);
	Запрос.УстановитьПараметр("Фактура",ОсновнаяФактура.ПродукцияФактура);
	Запрос.УстановитьПараметр("ЦветФактуры",ОсновнаяФактура.ПродукцияЦвет);
	Запрос.УстановитьПараметр("НомерРасчета",Объект.ПродукцияНомерРасчета);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ВыпускПродукции = Выборка.Регистратор;
		Результат = Выборка.Регистратор;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

