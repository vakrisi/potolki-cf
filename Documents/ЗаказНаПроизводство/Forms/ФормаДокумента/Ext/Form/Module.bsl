&НаКлиенте
Процедура ДобавитьПростойПотолок(Команда)
	
	ОП = Новый ОписаниеОповещения("ПослеВводаДанныхПотолка", ЭтотОбъект);
	ОткрытьФорму("ОбщаяФорма.ФормаДобавленияПродукции",, ЭтотОбъект,, ВариантОткрытияОкна.ОтдельноеОкно,, ОП);
	
КонецПроцедуры

Процедура ПослеВводаДанныхПотолка(Парам1, ДопПараметры) Экспорт
	
	Если НЕ Парам1 = Неопределено Тогда
		
		Объект.ПродукцияНомерРасчета = Парам1.НомерПотолка;
		Объект.ПродукцияНоменклатура = Парам1.Номенклатура;
		Объект.ПродукцияНоменклатураКоличество = Парам1.Количество;
		Объект.ПродукцияНоменклатураЕдиницаИзмерения = ПолучитьБазовуюЕдиницуИзмеренияНоменклатуры(Объект.ПродукцияНоменклатура);
		Объект.ПродукцияНоменклатураКоэффициент = 1;
		Объект.ПродукцияЦена = ПолучитьЦенуПростогоПотолка(Объект.ПродукцияНоменклатура, Объект.ПродукцияНоменклатураЕдиницаИзмерения);
		СуммаСтроки = Объект.ПродукцияНоменклатураКоличество * Объект.ПродукцияЦена;
		Объект.ПродукцияСумма = СуммаСтроки - (СуммаСтроки * (Объект.ПродукцияПроцентРучнойСкидки / 100)) - Объект.ПродукцияСуммаРучнойСкидки;		
		
		Объект.ФактураПотолка.Очистить();
		Для Каждого ФактураЦвет Из Объект.ПродукцияНоменклатура.Потолок_Фактура Цикл
			НоваяСтрока = Объект.ФактураПотолка.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ФактураЦвет);
		КонецЦикла;
				
		Модифицированность = Истина;
		
		ОбновитьДанныеДокумента();
		
	КонецЕсли;	
	
КонецПроцедуры

&НаСервере
Функция ПолучитьЦенуПростогоПотолка(Номенклатура, ЕдиницаИзмерения = Неопределено)
	
	ФактураПотолка = Справочники.Номенклатура.ПолучитьОсновнуюФактуруИЦветПотолка(Номенклатура);
	
	СФотопечатью = НЕ (Номенклатура.Потолок_ПлощадьФотопечати = 0); 

	ПараметрыПродукции = Новый Структура;
	ПараметрыПродукции.Вставить("ВидНоменклатуры", 	Номенклатура.ВидНоменклатуры);
	ПараметрыПродукции.Вставить("Фактура", 			ФактураПотолка.ПродукцияФактура);
	ПараметрыПродукции.Вставить("ЦветФактуры", 		ФактураПотолка.ПродукцияЦвет);			
	ПараметрыПродукции.Вставить("СФотопечатью", 	СФотопечатью);
	
	Возврат ЦеныКомпании.ПолучитьЦенуПродукции(ПараметрыПродукции, Объект.Дата, Объект.ВидЦен, Объект.Валюта, Объект.Контрагент, Объект.ДоговорКонтрагента);
	
КонецФункции

&НаКлиенте
Процедура СоздатьНаОснованииВозвратПродукции(Команда)
			
	ПараметрыФормы = Новый Структура;
	ДопПараметры = ПодготовитьСписокТоваровДляВыбораКВозврату();
	ПараметрыФормы.Вставить("СписокПотолков", ДопПараметры.СписокПотолков);
	ПараметрыФормы.Вставить("СписокУслуг",    ДопПараметры.СписокУслуг);

	ОповещениеОЗакрытии = Новый ОписаниеОповещения("ПослеВыбораТоваровКВозврату", ЭтаФорма);
	
	ОткрытьФорму("Документ.ВозвратПродукции.Форма.ФормаВыбораПотолковКВозврату", ПараметрыФормы,,,ВариантОткрытияОкна.ОтдельноеОкно,,ОповещениеОЗакрытии);
	
КонецПроцедуры

&НаСервере
Функция ПодготовитьСписокТоваровДляВыбораКВозврату()
	Возврат Документы.ВозвратПродукции.ПодготовитьСписокТоваровДляВыбора(Объект.Ссылка);
КонецФункции

&НаКлиенте
Процедура ПослеВыбораТоваровКВозврату(Результат, ДополнительныеПараметры) Экспорт
	
	Если ТипЗнч(Результат) = Тип("Массив") Тогда
		
		Если Результат.Количество() > 0 Тогда			
			ПараметрыЗаполнения = Новый Структура;
			ПараметрыЗаполнения.Вставить("ДокументОснование", ОБъект.Ссылка);
			ПараметрыЗаполнения.Вставить("МассивТоваров", Результат);			
			ПараметрыФормы = Новый Структура("ЗначенияЗаполнения", ПараметрыЗаполнения);			
			ОткрытьФорму("Документ.ВозвратПродукции.Форма.ФормаДокумента", ПараметрыФормы);			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СтраницыПриСменеСтраницы(Элемент, ТекущаяСтраница)
	Если НЕ ТекущаяСтраница.Имя = "ТаблицаФайлы" Тогда
		Элементы.Предпросмотр.Вид = ВидПоляФормы.ПолеКартинки;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура СкладМатериаловПриИзменении(Элемент)
	ЗаполнитьДанныеОстаткиПоМатериалам();
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьПоИнтеркампаниИВнутреннемуЗаказу()
	
	//++ #13200 
	ОбщаяВидимостьЭлементов = Новый Массив;
	
	ОбщаяВидимостьЭлементов.Добавить(Элементы.ПродукцияЦена1);
	ОбщаяВидимостьЭлементов.Добавить(Элементы.ПродукцияПроцентРучнойСкидки1);
	ОбщаяВидимостьЭлементов.Добавить(Элементы.ПродукцияСуммаРучнойСкидки1);
	ОбщаяВидимостьЭлементов.Добавить(Элементы.ПродукцияСумма1);
	ОбщаяВидимостьЭлементов.Добавить(Элементы.ПродукцияУстановитьПроцентРучнойСкидкиПродукция);
	ОбщаяВидимостьЭлементов.Добавить(Элементы.ПродукцияУстановитьСуммуРучнойСкидкиПродукция);
	
	ОбщаяВидимостьЭлементов.Добавить(Элементы.УслугиЦена);
	ОбщаяВидимостьЭлементов.Добавить(Элементы.УслугиПроцентРучнойСкидки);
	ОбщаяВидимостьЭлементов.Добавить(Элементы.УслугиСуммаРучнойСкидки);
	ОбщаяВидимостьЭлементов.Добавить(Элементы.УслугиСумма);
	ОбщаяВидимостьЭлементов.Добавить(Элементы.УслугиУстановитьПроцентРучнойСкидкиУслуги);
	ОбщаяВидимостьЭлементов.Добавить(Элементы.УслугиУстановитьСуммуРучнойСкидкиУслуги);

	Для каждого Элемент Из ОбщаяВидимостьЭлементов Цикл
		Элемент.Видимость = Ложь;
	КонецЦикла;
	//-- #13200
	
	ЭлементыВидимостьПоКонтрагенту = Новый Массив;
	ЭлементыВидимостьПоЦенам = Новый Массив;

	ЭлементыВидимостьПоКонтрагенту.Добавить(Элементы.ГруппаКонтрагент);	
	ЭлементыВидимостьПоКонтрагенту.Добавить(Элементы.ДоговорКонтрагента);
	
	ЭлементыВидимостьПоЦенам.Добавить(Элементы.ГруппаСуммаДокумента);
	//Продукция //#13200 закомментировано, убрано выше
	//ЭлементыВидимостьПоЦенам.Добавить(Элементы.ПродукцияЦена1);
	//ЭлементыВидимостьПоЦенам.Добавить(Элементы.ПродукцияПроцентРучнойСкидки1);
	//ЭлементыВидимостьПоЦенам.Добавить(Элементы.ПродукцияСуммаРучнойСкидки1);
	//ЭлементыВидимостьПоЦенам.Добавить(Элементы.ПродукцияСумма1);
	//ЭлементыВидимостьПоЦенам.Добавить(Элементы.ПродукцияУстановитьПроцентРучнойСкидкиПродукция);
	//ЭлементыВидимостьПоЦенам.Добавить(Элементы.ПродукцияУстановитьСуммуРучнойСкидкиПродукция);
	
	//Потолок
	ЭлементыВидимостьПоЦенам.Добавить(Элементы.ПродукцияЦена);
	ЭлементыВидимостьПоЦенам.Добавить(Элементы.ПродукцияПроцентРучнойСкидки);
	ЭлементыВидимостьПоЦенам.Добавить(Элементы.ПродукцияСуммаРучнойСкидки);
	ЭлементыВидимостьПоЦенам.Добавить(Элементы.ПродукцияСумма);
	
	//Товары (старая версия)
	ЭлементыВидимостьПоЦенам.Добавить(Элементы.ТоварыЦена);
	ЭлементыВидимостьПоЦенам.Добавить(Элементы.ТоварыПроцентРучнойСкидки);
	ЭлементыВидимостьПоЦенам.Добавить(Элементы.ТоварыСуммаРучнойСкидки);
	ЭлементыВидимостьПоЦенам.Добавить(Элементы.ТоварыСумма);
	
	//Услуги  //#13200 закомментировано, убрано выше
	//ЭлементыВидимостьПоЦенам.Добавить(Элементы.УслугиЦена);
	//ЭлементыВидимостьПоЦенам.Добавить(Элементы.УслугиПроцентРучнойСкидки);
	//ЭлементыВидимостьПоЦенам.Добавить(Элементы.УслугиСуммаРучнойСкидки);
	//ЭлементыВидимостьПоЦенам.Добавить(Элементы.УслугиСумма);
	//ЭлементыВидимостьПоЦенам.Добавить(Элементы.УслугиУстановитьПроцентРучнойСкидкиУслуги);
	//ЭлементыВидимостьПоЦенам.Добавить(Элементы.УслугиУстановитьСуммуРучнойСкидкиУслуги);
	ЭлементыВидимостьПоЦенам.Добавить(Элементы.УслугиНаценкаЗаСрочность);
	
	//Товары из ЗП  //#15716 поля убраны
	//ЭлементыВидимостьПоЦенам.Добавить(Элементы.ТоварыЗаказаПокупателяЦена);
	//ЭлементыВидимостьПоЦенам.Добавить(Элементы.ТоварыЗаказаПокупателяПроцентРучнойСкидки);
	//ЭлементыВидимостьПоЦенам.Добавить(Элементы.ТоварыЗаказаПокупателяСуммаРучнойСкидки);
	//ЭлементыВидимостьПоЦенам.Добавить(Элементы.ТоварыЗаказаПокупателяСумма);	
	
	Для каждого Элемент Из ЭлементыВидимостьПоКонтрагенту Цикл
		Элемент.Видимость = Истина;
	КонецЦикла;
	Для каждого Элемент Из ЭлементыВидимостьПоЦенам Цикл
		Элемент.Видимость = Истина;
	КонецЦикла;	
	
	ОднаОрганизацияПроизводстваИПродажиПотолков = Ложь;
	Если НЕ Объект.НастройкаИнтеркампани.Пустая() Тогда
		ОднаОрганизацияПроизводстваИПродажиПотолков = Объект.НастройкаИнтеркампани.ОднаОрганизацияПроизводстваИПродажиПотолков;
		Если ОднаОрганизацияПроизводстваИПродажиПотолков Тогда
			Если НЕ Объект.НастройкаИнтеркампани.УказыватьКонтрагентаРозницыВЗаказахНаПроизводство Тогда
				Для каждого Элемент Из ЭлементыВидимостьПоКонтрагенту Цикл
					Элемент.Видимость = Ложь;
				КонецЦикла;
			КонецЕсли;	
			
			Для каждого Элемент Из ЭлементыВидимостьПоЦенам Цикл
				Элемент.Видимость = Ложь;
			КонецЦикла;
		КонецЕсли;		
	КонецЕсли;
	
	НаборКонстант = Константы.СоздатьНабор("ОтображатьКонтрагентаВоВнутреннихЗаказах, ОтображатьЦеныВоВнутреннихЗаказах"); 
	НаборКонстант.Прочитать();
	Если Объект.ВнутреннийЗаказ Тогда
		Для каждого Элемент Из ЭлементыВидимостьПоКонтрагенту Цикл
			Элемент.Видимость = НаборКонстант.ОтображатьКонтрагентаВоВнутреннихЗаказах;
		КонецЦикла;
		Для каждого Элемент Из ЭлементыВидимостьПоЦенам Цикл
			Элемент.Видимость = НаборКонстант.ОтображатьЦеныВоВнутреннихЗаказах;
		КонецЦикла;
	КонецЕсли;
		
	Элементы.НастройкаИнтеркампани.Доступность = НЕ Объект.ВнутреннийЗаказ;
		
КонецПроцедуры

&НаКлиенте
Процедура НастройкаИнтеркампаниПриИзменении(Элемент)
