	ИскомаяНоменклатура = ОбменСEasyCeiling.НайтиНоменклатуруПотолка(Объект.ПродукцияНомерРасчета, НаименованиеНоменклатурыДляПоиска, ГруппаНоменклатурыДляПоиска);
	
	Объект.ПродукцияНоменклатура = ИскомаяНоменклатура;
	//Объект.ПродукцияНоменклатураКоличество = Объект.ПродукцияНоменклатураКоличество;
	Объект.ПродукцияНоменклатураКоэффициент = 1;
	Объект.ПродукцияНоменклатураЕдиницаИзмерения = ПолучитьБазовуюЕдиницуИзмеренияНоменклатуры(Объект.ПродукцияНоменклатура);
	
КонецПроцедуры

&НаСервере
Функция СоздатьНоменклатуруПродукцияНаСервере()
	
	БазоваяЕдИзм = Справочники.КлассификаторЕдиницИзмерения.МетрКвадратный;
	Если БазоваяЕдИзм.Пустая() Тогда
		Возврат "Ошибка!"+Символы.ПС+"В справочнике ""Классификатор единиц измерения"" не найдена единица с наименованием ""м2""";
	КонецЕсли;
	
	ОсновнаяФактура = ПолучитьОсновнуюФактуруИЦвет();
	
	Отказ = Ложь;
	Если ПустаяСтрока(Объект.ПродукцияНомерРасчета) Тогда
		Отказ = Истина;
		Сообщить("В документе следует указать номер расчета");
	КонецЕсли;
	Если ПустаяСтрока(ОсновнаяФактура.ПродукцияЦвет) Тогда
		Отказ = Истина;
		Сообщить("В документе следует указать цвет основной фактуры");
	КонецЕсли;
	Если Отказ Тогда
		Возврат "Номенклатура не создана";
	КонецЕсли;
	
	НаименованиеНоменклатурыДляСоздания = ОбменСEasyCeiling.ПолучитьНаименованиеПотолка(Объект.ПродукцияНомерРасчета, ОсновнаяФактура.ПродукцияЦвет, ОсновнаяФактура.ПродукцияЦвет.Владелец);
	ГруппаНоменклатурыДляСоздания = Константы.ГруппаНоменклатурыПродукция.Получить();
	
	Попытка
		НоваяНоменклатура = Справочники.Номенклатура.СоздатьЭлемент();
		НоваяНоменклатура.ВидНоменклатуры = Справочники.ВидыНоменклатуры.Потолок;
		НоваяНоменклатура.БазоваяЕдиницаИзмерения = БазоваяЕдИзм.Ссылка;
		НоваяНоменклатура.Наименование = НаименованиеНоменклатурыДляСоздания;
		НоваяНоменклатура.Родитель = ГруппаНоменклатурыДляСоздания;
		НоваяНоменклатура.Потолок_НомерРасчета = Объект.ПродукцияНомерРасчета;
		
		НоваяНоменклатура.Потолок_Фактура.Очистить();
		НоваяСтрока = НоваяНоменклатура.Потолок_Фактура.Добавить();
		НоваяСтрока.Основная = Истина;
		НоваяСтрока.ПродукцияФактура = ОсновнаяФактура.ПродукцияЦвет.Владелец;
		НоваяСтрока.ПродукцияЦвет = ОсновнаяФактура.ПродукцияЦвет;
		
		НоваяНоменклатура.Записать();
	
		Объект.ПродукцияНоменклатура = НоваяНоменклатура.Ссылка;
		//Объект.ПродукцияНоменклатураКоличество = Объект.ПродукцияНоменклатураКоличество;
		Объект.ПродукцияНоменклатураКоэффициент = 1;
		Объект.ПродукцияНоменклатураЕдиницаИзмерения = ПолучитьБазовуюЕдиницуИзмеренияНоменклатуры(Объект.ПродукцияНоменклатура);
		Возврат "Создана новая номенклатура " + НоваяНоменклатура.Ссылка;
	Исключение
		Возврат "Ошибка!" + Символы.ПС + ОписаниеОшибки();
	КонецПопытки;
	
КонецФункции

&НаСервере
Функция ПолучитьЦенуМатериала(ДатаЗапроса, Цвет, ВидЦен, ПродукцияНоменклатура) Экспорт
	
	СФотопечатью = НЕ (ПродукцияНоменклатура.Потолок_ПлощадьФотопечати = 0);

	ПараметрыПродукции = Новый Структура;
	ПараметрыПродукции.Вставить("ВидНоменклатуры", 	ПродукцияНоменклатура.ВидНоменклатуры);
	ПараметрыПродукции.Вставить("Фактура", 			Цвет.Владелец);
	ПараметрыПродукции.Вставить("ЦветФактуры", 		Цвет);			
	ПараметрыПродукции.Вставить("СФотопечатью", 	СФотопечатью);
	
	Возврат ЦеныКомпании.ПолучитьЦенуПродукции(ПараметрыПродукции, Объект.Дата, ВидЦен, Объект.Валюта, Объект.Контрагент, Объект.ДоговорКонтрагента);
			
КонецФункции

