//++ №14862
&НаКлиенте
Процедура ЗагрузитьМатериалыИзПостроителя(Команда)
	
	Если Не ЗначениеЗаполнено(Объект.ПродукцияНоменклатура) Тогда
		ПоказатьПредупреждение(, "Не указана продукция.");
		Возврат;
	КонецЕсли;
	
	Если НЕ ОбщийМодульКлиент.ПроверитьДоступностиРасширенногоФункционала() тогда
		Возврат;
	КонецЕсли;
	
	ОписаниеОповещения = новый ОписаниеОповещения("ЗагрузитьМатериалыИзПостроителяФрагмент", ЭтотОбъект);
	ПоказатьВопрос(ОписаниеОповещения, "Обновить файлы макетов к потолку?", РежимДиалогаВопрос.ДаНетОтмена);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьМатериалыИзПостроителяФрагмент(Ответ, ДополнительныеПараметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Отмена Тогда
		Возврат;
	КонецЕсли;
	
	Оповещение = Новый ОписаниеОповещения("ЗагрузитьМатериалыИзПостроителяПослеВыбораФайлов", ЭтотОбъект, новый Структура("ОбновитьФайлыМакетов", (Ответ = КодВозвратаДиалога.Да)));	
	ОбщийМодульКлиент.ВыборФайловПостроителя(ЭтаФорма, Оповещение);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьМатериалыИзПостроителяПослеВыбораФайлов(ВыбранныеФайлы, ДополнительныеПараметры) Экспорт
	
	Если ВыбранныеФайлы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ВыбранныеФайлы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ВыбранноеИмяФайла = ВыбранныеФайлы[0];
	
	СписокПутейКФайламКУдалению = Новый СписокЗначений;
	СписокДвоичныхДанныхФайлов = Новый СписокЗначений;
	
	СтруктураФайла = ОбменСПостроителемКлиентСервер.ПрочитатьФайлПостроителя(ВыбранноеИмяФайла);	
	ОбменСПостроителемКлиентСервер.СформироватьСписокПутейКФайлам(СтруктураФайла, СписокПутейКФайламКУдалению, СписокДвоичныхДанныхФайлов);
	
	Если ЗагрузитьМатериалыИзПостроителяНаСервере(СтруктураФайла, СписокДвоичныхДанныхФайлов, ДополнительныеПараметры.ОбновитьФайлыМакетов) Тогда
		
		Состояние("Данные загружены.");
		Модифицированность = Истина;
		
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ЗагрузитьМатериалыИзПостроителяНаСервере(СтруктураФайла, СписокДвоичныхДанныхФайлов, ОбновитьФайлыМакетов)
	
	// Получаем исходную структуру потолка по данным файла импорта
	СтруктураИсходная = ПолучитьСтруктуруТекущегоПотолкаПоДаннымИмпорта();
	
	Если СтруктураИсходная = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	// Получаем новую структуру потолка по выбранному файлу потолка
	СтруктураКонечная = ПолучитьСтруктуруПотолкаПоДаннымИмпорта(СтруктураФайла, СписокДвоичныхДанныхФайлов);
	
	Если СтруктураКонечная = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	// Сверяем структуры
	// Разрешается различие только реквизитов в фактурах по полям "Фактура", "Цвет" и "Количество расход"
	РазрешенныеРеквизиты = новый Массив;
	РазрешенныеРеквизиты.Добавить("МатериалМатериал");
	РазрешенныеРеквизиты.Добавить("МатериалЦвет");
	РазрешенныеРеквизиты.Добавить("ПродукцияФактура");
	РазрешенныеРеквизиты.Добавить("ПродукцияЦвет");
	РазрешенныеРеквизиты.Добавить("ШиринаПолотна");
	РазрешенныеРеквизиты.Добавить("КоличествоРасход");
	РазрешенныеРеквизиты.Добавить("ДанныеФайла");
	
	Различаются = Ложь;
	
	Для Каждого ИсходноеСвойство Из СтруктураИсходная Цикл
		
		Если ТипЗнч(ИсходноеСвойство.Значение) = Тип("Структура") Тогда
			
			// Свойство с типом "Структура"
			Для Каждого ИсходноеСвойствоСекции Из ИсходноеСвойство.Значение Цикл
				
				Если РазрешенныеРеквизиты.Найти(ИсходноеСвойствоСекции.Ключ) = Неопределено
					И Не ИсходноеСвойствоСекции.Значение = СтруктураКонечная[ИсходноеСвойство.Ключ][ИсходноеСвойствоСекции.Ключ] Тогда
					
					Различаются = Истина;
					Сообщить(СтрШаблон("Значение параметра ""%1"" потолка в секции ""%2"" отличается, в исходных данных ""%3"", в выбранном файле ""%4"".",
						ИсходноеСвойствоСекции.Ключ,
						ИсходноеСвойство.Ключ,
						ИсходноеСвойствоСекции.Значение,
						СтруктураКонечная[ИсходноеСвойство.Ключ][ИсходноеСвойствоСекции.Ключ]
					));
					
				КонецЕсли;
				
			КонецЦикла;
			
		ИначеЕсли ТипЗнч(ИсходноеСвойство.Значение) = Тип("Массив") Тогда
			
			// Свойство с типом "Массив"
			Если НЕ ИсходноеСвойство.Значение.Количество() = СтруктураКонечная[ИсходноеСвойство.Ключ].Количество() Тогда
				
				Сообщить(СтрШаблон("Количество фактур потолка отличается, в исходных данных ""%1"", в выбранном файле ""%2"".",
					ИсходноеСвойство.Значение.Количество(),
					СтруктураКонечная[ИсходноеСвойство.Ключ].Количество()
				));
				Продолжить;
				
			КонецЕсли;
			
			НомерСтроки = 0;
			Для Каждого СтрокаФактуры Из ИсходноеСвойство.Значение Цикл
				
				Для Каждого СвойствоФактурыИсходное Из СтрокаФактуры Цикл
					
					Если РазрешенныеРеквизиты.Найти(СвойствоФактурыИсходное.Ключ) = Неопределено
						И Не СвойствоФактурыИсходное.Значение = СтруктураКонечная[ИсходноеСвойство.Ключ][НомерСтроки][СвойствоФактурыИсходное.Ключ] Тогда
						
						Различаются = Истина;
						Сообщить(СтрШаблон("Значение параметра ""%1"" потолка в секции ""%2"" отличается, по номеру строки %3, в исходных данных ""%4"", в выбранном файле ""%5"".",
						СвойствоФактурыИсходное.Ключ,
						ИсходноеСвойство.Ключ,
						НомерСтроки + 1,
						СвойствоФактурыИсходное.Значение,
						СтруктураКонечная[ИсходноеСвойство.Ключ][НомерСтроки][СвойствоФактурыИсходное.Ключ]
						));
						
					КонецЕсли;
					
				КонецЦикла;
				
				НомерСтроки = НомерСтроки + 1;
				
			КонецЦикла;
			
		Иначе
			
			// Шапочные свойства
			Если РазрешенныеРеквизиты.Найти(ИсходноеСвойство.Ключ) = Неопределено
				И НЕ ИсходноеСвойство.Значение = СтруктураКонечная[ИсходноеСвойство.Ключ] Тогда
				
				Различаются = Истина;
				Сообщить(СтрШаблон("Значение параметра ""%1"" потолка отличается, в исходных данных ""%2"", в выбранном файле ""%3"".",
					ИсходноеСвойство.Ключ,
					ИсходноеСвойство.Значение,
					СтруктураКонечная[ИсходноеСвойство.Ключ]
				));
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если Различаются Тогда
		
		Сообщить("Действие отменено.");
		Возврат Ложь;
		
	КонецЕсли;
	
	Объект.Материалы.Очистить();
	
	// Получаем структуру заказа, чтобы были отработаны расширенные правила
	ДанныеЗаказа = ОбменСEasyCeiling.СтруктураДанныхЗаказа(
		Объект.Организация,
		Объект.Подразделение,
		Объект.НастройкаИнтеркампани,
		Объект.ВидЦен,
		Объект.Валюта,
		?(Объект.Дата = Дата(1,1,1), ТекущаяДатаСеанса(), Объект.Дата)
		,
		,
		,
		Объект.ДоговорКонтрагента,
		Объект.ВнутреннийЗаказ
	);
	
	// Структуру получаем как по заказу покупателя, чтобы расширенные правила отработали для этого документа
	// #14862 не так: получаем как дял заказа на производство 
	//СтруктураЗаказа = ОбменСEasyCeiling.ПолучитьСтруктуруЗаказа(СтруктураКонечная, Перечисления.ВидыЗаказов.ЗаказПокупателя, ДанныеЗаказа);
	СтруктураЗаказа = ОбменСEasyCeiling.ПолучитьСтруктуруЗаказа(СтруктураКонечная, Перечисления.ВидыЗаказов.ЗаказНаПроизводство, ДанныеЗаказа);
	
	Для Каждого СтрокаМатериалов Из СтруктураЗаказа.Материалы Цикл
		
		НоваяСтрока = Объект.Материалы.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаМатериалов);
		
		НоваяСтрока.ЗагруженоИзПостроителя = Истина;
		НоваяСтрока.УИСтроки = Объект.ПродукцияУИСтроки;
		
	КонецЦикла;
	
	Объект.РучнаяКорректировкаМатериалов = Истина;
	
	// Обновляем файлы макетов, если пользователь согласился их обновлять
	Если ОбновитьФайлыМакетов Тогда
		
		МассивСообщений = новый Массив;
		
		ОбменСEasyCeiling.ЗагрузитьФайлыКПотолку(СтруктураКонечная, СписокДвоичныхДанныхФайлов, МассивСообщений);
		
		// Если есть сообщения с ошибками - выводим их
		Для Каждого ТекущаяСтрока Из МассивСообщений Цикл
			
			Если НЕ ТекущаяСтрока.ЭтоОшибка Тогда
				Продолжить;
			КонецЕсли;
				
			Сообщить(ТекущаяСтрока.ТекстСообщения);
			
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

&НаСервере
Функция ПолучитьСтруктуруПотолкаПоДаннымИмпорта(СтруктураФайла, СписокДвоичныхДанныхФайлов)
	
	СтруктураПотолка = ОбменСEasyCeiling.ПолучитьСтруктуруПотолка(СтруктураФайла, СписокДвоичныхДанныхФайлов, Объект.ПродукцияНоменклатура,,,,,,,, Истина);
	
	Если СтруктураПотолка = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	НайтиИЗаполнитьФактурыПоДаннымИмпорта(СтруктураПотолка);
	
	Возврат СтруктураПотолка;
	
КонецФункции

&НаСервере
Функция ПолучитьСтруктуруТекущегоПотолкаПоДаннымИмпорта()
	
	ДанныеФайлаИмпорта = Объект.ПродукцияНоменклатура.Потолок_ДанныеФайлаИмпорта;
	
	Если Не ЗначениеЗаполнено(ДанныеФайлаИмпорта) Тогда
		
		Сообщить("В карточке продукции не указаны данные файла импорта.");
		Возврат Неопределено;
		
	КонецЕсли;
	
	ТипJson = СтрНайти(ДанныеФайлаИмпорта, "{") > 0 И СтрНайти(ДанныеФайлаИмпорта, "СписокЗаказов") > 0;
	
	ИмяВременногоФайла = ПолучитьИмяВременногоФайла(?(ТипJson, ".json", ".ini"));
	
	ТекстФайл = Новый ТекстовыйДокумент;
	ТекстФайл.УстановитьТекст(ДанныеФайлаИмпорта);
	//ТекстФайл.Записать(ИмяВременногоФайла, ОбменСEasyCeiling.ФорматФайловПостроителя());
	ФорматФайловПостроителя = ОбменСEasyCeiling.ФорматФайловПостроителя();
	Если ПустаяСтрока(ФорматФайловПостроителя) Тогда
		ТекстФайл.Записать(ИмяВременногоФайла);
	Иначе
		ТекстФайл.Записать(ИмяВременногоФайла, ФорматФайловПостроителя);
	КонецЕсли;
	
	СтруктураФайла = ОбменСПостроителемКлиентСервер.ПрочитатьФайлПостроителя(ИмяВременногоФайла);

	СтруктураПотолка = ОбменСEasyCeiling.ПолучитьСтруктуруПотолка(СтруктураФайла,, Объект.ПродукцияНоменклатура,,,,,,,, Истина);
	
	Если СтруктураПотолка = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	НайтиИЗаполнитьФактурыПоДаннымИмпорта(СтруктураПотолка);
	
	Возврат СтруктураПотолка;
	
КонецФункции

Процедура НайтиИЗаполнитьФактурыПоДаннымИмпорта(СтруктураПотолка)
	
	Для Каждого ТекущаяСтрока Из СтруктураПотолка.Фактуры Цикл
		
		ТекущаяСтрока.ПродукцияФактура = Справочники.Фактура.НайтиПоНаименованиюИШирине(СокрЛП(ТекущаяСтрока.МатериалМатериал), СокрЛП(ТекущаяСтрока.ШиринаПолотна));
		ТекущаяСтрока.ПродукцияЦвет = Справочники.ЦветФактуры.НайтиПоНаименованию(ТекущаяСтрока.МатериалЦвет, Истина, , ТекущаяСтрока.ПродукцияФактура);
		
	КонецЦикла;
	
КонецПроцедуры
