&НаКлиенте
Процедура ПослеВыбораМатериаловГарпуна(ВозвПараметры, ДопПараметр) Экспорт
	Если ВозвПараметры <> Неопределено Тогда
		ПерекройНаСервере(ВозвПараметры);
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ПерекройНаСервере(ВозвПараметры)
	//Нужно заменить полотна/пленку на материалы заказчика
	Для Каждого Материал Из Объект.Материалы Цикл
		Если Материал.Номенклатура.ВидНоменклатуры = ПредопределенноеЗначение("Справочник.ВидыНоменклатуры.Полотно")
			ИЛИ Материал.Номенклатура.ВидНоменклатуры = ПредопределенноеЗначение("Справочник.ВидыНоменклатуры.ОстатокПленки")
		Тогда	
			Материал.Номенклатура 				= ПредопределенноеЗначение("Справочник.Номенклатура.ПолотноЗаказчика");
			Материал.ХарактеристикаНоменклатуры = ПредопределенноеЗначение("Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка");
			Материал.СерияНоменклатуры 			= ПредопределенноеЗначение("Справочник.СерииНоменклатуры.ПустаяСсылка");			
			Материал.ЕдиницаИзмерения 			= Материал.Номенклатура.БазоваяЕдиницаИзмерения;
			
			Модифицированность = Истина;
		КонецЕсли;
	КонецЦикла;
	
	//Заменим количество гарпуна
	Если ТипЗнч(ВозвПараметры.Материалы) = Тип("Массив") Тогда
		Для Каждого ТекГарпун Из ВозвПараметры.Материалы Цикл
					
			СтруктураПоиска = новый Структура("НомерСтроки, Номенклатура, ХарактеристикаНоменклатуры, СерияНоменклатуры", 
											   ТекГарпун.НомерСтроки, ТекГарпун.Номенклатура, ТекГарпун.ХарактеристикаНоменклатуры, ТекГарпун.СерияНоменклатуры);
			НайденнаяСтрока = Объект.Материалы.НайтиСтроки(СтруктураПоиска);
			Если НайденнаяСтрока.Количество() > 0 Тогда
				НайденнаяСтрока[0].Количество = ВозвПараметры.КоличествоГарпун;
				НайденнаяСтрока[0].КоличествоКВыработке = ВозвПараметры.КоличествоГарпун;
				
				Модифицированность = Истина;				
			КонецЕсли;	
		
		КонецЦикла;
	КонецЕсли;	
	
КонецПроцедуры	

&НаКлиенте
Процедура ЗаполнитьИсполнителейПоСмене(Команда)
	
	//++ №6687 теперь способ определяется в документе
	//Если НЕ ИсполнителиПоОперациям() Тогда
	Если Объект.СпособНачисленияВыработки = ПредопределенноеЗначение("Перечисление.СпособыНачисленияВыработки.Бригадная") Тогда
	//-- №6687	
		Если Объект.Исполнители.Количество() > 0 Тогда
			Если Вопрос("Очистить табличную часть исполнителей?",РежимДиалогаВопрос.ДаНет) = КодВозвратаДиалога.Да тогда
				Объект.Исполнители.Очистить();
			КонецЕсли;
		КонецЕсли;
	Иначе
		Если Объект.ИсполнителиПоОперациям.Количество() > 0 Тогда
			Если Вопрос("Очистить табличную часть исполнителей?",РежимДиалогаВопрос.ДаНет) = КодВозвратаДиалога.Да тогда
				Объект.ИсполнителиПоОперациям.Очистить();
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	ЗаполнитьИсполнителейПоСменеНаСервере();
	ОбновитьДанныеДокумента();
КонецПроцедуры

