&НаСервере
Процедура ПерезаполнитьМатериалыПоЗаказуПокупателя()
	
	Если НЕ ТипЗнч(Объект.ДокументОснование) = Тип("ДокументСсылка.ЗаказПокупателя") Тогда
		Возврат;
	КонецЕсли;
		
	Объект.Материалы.Очистить();
	
	МассивПродукции = новый Массив;
		
	Если Объект.ВидЗаказа = Перечисления.ВидыЗаказовНаПроизводство.ПроизводствоПотолка Тогда
		МассивПродукции.Добавить(Объект.ПродукцияНоменклатура);
	Иначе
		Для Каждого ТекущаяСтрока Из Объект.Продукция Цикл
			МассивПродукции.Добавить(ТекущаяСтрока.Номенклатура);
		КонецЦикла;
	КонецЕсли;
	
	Для Каждого ТекущаяСтрока Из Объект.ДокументОснование.Материалы Цикл
		
		Если МассивПродукции.Найти(ТекущаяСтрока.Потолок) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока = Объект.Материалы.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущаяСтрока);
		
	КонецЦикла;
	
	ВремРучнаяКорректировкаМатериалов = Объект.РучнаяКорректировкаМатериалов;
	
КонецПроцедуры
