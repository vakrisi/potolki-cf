&НаКлиенте
Процедура ВывестиПотолокВТабличнойЧасти()
	
	Потолок.Очистить();
	
	Если Объект.ВидЗаказа = ПредопределенноеЗначение("Перечисление.ВидыЗаказовНаПроизводство.ПроизводствоПотолка") Тогда
		
		// Потолок
		НоваяСтрока = Потолок.Добавить();
		НоваяСтрока.НомерСтроки = 1;
		НоваяСтрока.НомерРасчета = Объект.ПродукцияНомерРасчета;
		НоваяСтрока.Номенклатура = Объект.ПродукцияНоменклатура;
		НоваяСтрока.Количество = Объект.ПродукцияНоменклатураКоличество;
		НоваяСтрока.ЕдиницаИзмерения = Объект.ПродукцияНоменклатураЕдиницаИзмерения;
		НоваяСтрока.Коэффициент = Объект.ПродукцияНоменклатураКоэффициент;
		
	КонецЕсли;
		
	ОбновитьВидимостьТабличнойЧастиФактуры();
	
КонецПроцедуры

&НаКлиенте
Процедура ПеренестиПотолокИзТабличнойЧасти(ТекущиеДанные)
	
	Объект.ПродукцияНомерРасчета = ТекущиеДанные.НомерРасчета;
	Объект.ПродукцияНоменклатура = ТекущиеДанные.Номенклатура;
	Объект.ПродукцияНоменклатураКоличество = ТекущиеДанные.Количество;
	Объект.ПродукцияНоменклатураЕдиницаИзмерения = ТекущиеДанные.ЕдиницаИзмерения;
	Объект.ПродукцияНоменклатураКоэффициент = ТекущиеДанные.Коэффициент;
	
КонецПроцедуры

&НаКлиенте
Процедура ПотолокНоменклатураПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.Потолок.ТекущиеДанные;
	ТекущиеДанные.ЕдиницаИзмерения = ПолучитьБазовуюЕдиницуИзмеренияНоменклатуры(ТекущиеДанные.Номенклатура);
	ТекущиеДанные.Коэффициент = 1;
	
	ПеренестиПотолокИзТабличнойЧасти(ТекущиеДанные);
	ОбновитьСписокФайлов();
	ОбновитьВидимостьТабличнойЧастиФактуры();
	
КонецПроцедуры

&НаКлиенте
Процедура ПотолокЕдиницаИзмеренияПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.Потолок.ТекущиеДанные;
	Если ТипЗнч(ТекущиеДанные.ЕдиницаИзмерения) = Тип("СправочникСсылка.КлассификаторЕдиницИзмерения") Тогда
		ТекущиеДанные.Коэффициент = 1;
	Иначе
		ТекущиеДанные.Коэффициент = ОбщийМодуль.ПолучитьКоэффициентЕдиницыИзмерения(ТекущиеДанные.ЕдиницаИзмерения);
	КонецЕсли;
	
	ПеренестиПотолокИзТабличнойЧасти(ТекущиеДанные);
	
КонецПроцедуры

&НаКлиенте
Процедура ПотолокКоличествоПриИзменении(Элемент)
	
	ПеренестиПотолокИзТабличнойЧасти(Элементы.Потолок.ТекущиеДанные);
	
КонецПроцедуры

&НаКлиенте
Процедура ПотолокНомерРасчетаПриИзменении(Элемент)
	
	ПеренестиПотолокИзТабличнойЧасти(Элементы.Потолок.ТекущиеДанные);
	
КонецПроцедуры

&НаКлиенте
Процедура ПотолокЕдиницаИзмеренияНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ТекущиеДанные = Элементы.Потолок.ТекущиеДанные;
	СписокЕдиниц = ОбщийМодуль.ПолучитьСписокЕдиницИзмеренияНоменклатуры(ТекущиеДанные.Номенклатура);
	
	ДанныеВыбора = Новый СписокЗначений;
	Для Ном = 0 По СписокЕдиниц.Количество() - 1 Цикл
		ДанныеВыбора.Добавить(СписокЕдиниц[Ном]);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ПотолокЕдиницаИзмеренияОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	ТекущиеДанные = Элементы.Потолок.ТекущиеДанные;
	Если ТипЗнч(ВыбранноеЗначение) = Тип("СправочникСсылка.КлассификаторЕдиницИзмерения") Тогда
		ТекущиеДанные.Коэффициент = 1;
	Иначе
		ТекущиеДанные.Коэффициент = ОбщийМодуль.ПолучитьКоэффициентЕдиницыИзмерения(ВыбранноеЗначение);
	КонецЕсли;
	
	ПеренестиПотолокИзТабличнойЧасти(Элементы.Потолок.ТекущиеДанные);
	
КонецПроцедуры

