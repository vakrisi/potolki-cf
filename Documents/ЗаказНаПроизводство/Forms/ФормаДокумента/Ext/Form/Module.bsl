	Иначе
		ВызватьДиалогПодбораОстатков(Ложь);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеОтветаНаВопросОЗаменеПолотенНаОстатокПоштучно(Результат, Параметры) Экспорт
	Если Результат = КодВозвратаДиалога.Да Тогда
        ВызватьДиалогПодбораОстатков(Истина);
	Иначе
		ВызватьДиалогПодбораОстатков(Ложь);
    КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ВызватьДиалогПодбораОстатковНаСервере(ЗаменитьПолотнаВДокументе, ВозвращенноеЗначение)
	
	ВременнаяТаблица = Новый ТаблицаЗначений;
	ВременнаяТаблица.Колонки.Добавить("Номенклатура");
	ВременнаяТаблица.Колонки.Добавить("Количество");
	ВременнаяТаблица.Колонки.Добавить("ЕдиницаИзмерения");
	ВременнаяТаблица.Колонки.Добавить("Коэффициент");
	ВременнаяТаблица.Колонки.Добавить("Цена");
	ВременнаяТаблица.Колонки.Добавить("Сумма");
	ВременнаяТаблица.Колонки.Добавить("ХарактеристикаНоменклатуры");
	ВременнаяТаблица.Колонки.Добавить("Фактура");
	ВременнаяТаблица.Колонки.Добавить("Цвет");
	ВременнаяТаблица.Колонки.Добавить("НоменклатураКЗамене", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	
	Для Каждого ТекСтрока Из ВозвращенноеЗначение Цикл
		НоваяСтрока = ВременнаяТаблица.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
	КонецЦикла;
	
	
	Для Каждого ТекМатериал Из Объект.Материалы Цикл
		Если ТекМатериал.Номенклатура.ВидНоменклатуры = ПредопределенноеЗначение("Справочник.ВидыНоменклатуры.Полотно") Тогда
			Для Каждого ТекОстаток Из ВременнаяТаблица Цикл
				Если ТекОстаток.НоменклатураКЗамене.Пустая() Тогда
					ТекОстаток.НоменклатураКЗамене = ТекМатериал.Номенклатура;
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого ТекущаяСтрока из ВременнаяТаблица Цикл
		Если ТекущаяСтрока.НоменклатураКЗамене.Пустая() Тогда
			НоваяСтрока = Объект.Материалы.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущаяСтрока);
		Иначе
			Отбор = Новый Структура;
			Отбор.Вставить("Номенклатура", ТекущаяСтрока.НоменклатураКЗамене);
			НайденныеСтроки = Объект.Материалы.НайтиСтроки(Отбор);
			Если НайденныеСтроки.Количество() > 0 Тогда
				ЗаполнитьЗначенияСвойств(НайденныеСтроки[0], ТекущаяСтрока);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	//++ №14311
	Объект.РучнаяКорректировкаМатериалов = Истина;
	ВремРучнаяКорректировкаМатериалов = Объект.РучнаяКорректировкаМатериалов;
	//-- №14311

КонецПроцедуры

&НаКлиенте 
Процедура ВызватьДиалогПодбораОстатков(ЗаменитьПолотнаВДокументе)
	
	ПараметрыПодбора = Новый Структура;
	ПараметрыПодбора.Вставить("Организация",			Объект.Организация);
	//ПараметрыПодбора.Вставить("Склад",					Объект.СкладМатериалов);
	ПараметрыПодбора.Вставить("ВидНоменклатуры",		ПолучитьСписокВидовНоменклатурыОстаткиПленки());
	ПараметрыПодбора.Вставить("ТолькоВНаличии",			Истина);
	ПараметрыПодбора.Вставить("НеЗапрашиватьЦену",		Истина);
	ПараметрыПодбора.Вставить("ВАльтернативнойЕдиницеИзмерения",		Истина);
	ВозвращенноеЗначение = ОткрытьФормуМодально("ОбщаяФорма.ФормаПодбораНоменклатуры",ПараметрыПодбора);
	
	Если НЕ ВозвращенноеЗначение = Неопределено Тогда
		ВызватьДиалогПодбораОстатковНаСервере(ЗаменитьПолотнаВДокументе, ВозвращенноеЗначение)
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьСписокВидовНоменклатурыОстаткиПленки()
	
	Список = Новый СписокЗначений;
	Список.Добавить(Справочники.ВидыНоменклатуры.ОстатокПленки);
	Возврат Список;
	
КонецФункции

