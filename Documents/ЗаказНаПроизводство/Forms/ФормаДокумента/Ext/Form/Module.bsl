	Если Ответ = КодВозвратаДиалога.Да Тогда
		ПерезаполнитьМатериалыПоЗаказуПокупателя();
	Иначе
		Объект.РучнаяКорректировкаМатериалов = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗадатьВопросОПересчетеКоличестваКВыработке(СтрокаТабличнойЧасти)
	
	// Если предыдущие значения "К выработке" <> "Количество" и "К выработке" <> 0, то после изменения "Количество" предлагать "К выработке" предыдущее значение
	Если НЕ мПрерыдущееКоличество = Неопределено
		И НЕ мПредыдущееКоличествоКВыработке = Неопределено
		И мПрерыдущееКоличество > 0
		И мПредыдущееКоличествоКВыработке > 0
		И НЕ мПрерыдущееКоличество = мПредыдущееКоличествоКВыработке Тогда
		
		КоличествоКВыработке = мПредыдущееКоличествоКВыработке;
		
		ОписаниеОповещения = новый ОписаниеОповещения("ПослеВводаЗначенияКоличествоКВыработке", ЭтотОбъект, Новый Структура("ИдТекущейСтроки", СтрокаТабличнойЧасти.ПолучитьИдентификатор()));
		ПоказатьВводЧисла(ОписаниеОповещения, КоличествоКВыработке, "Подтвердите значение ""К выработке"".", 15, 2);
		
	Иначе
		
		СтрокаТабличнойЧасти.КоличествоКВыработке = СтрокаТабличнойЧасти.Количество;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВводаЗначенияКоличествоКВыработке(Значение, ДополнительныеПараметры) Экспорт
	
	Если Значение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Элементы.Материалы.ТекущаяСтрока = ДополнительныеПараметры.ИдТекущейСтроки;
	
	ТекущаяСтрока = Элементы.Материалы.ТекущиеДанные;
	
	ТекущаяСтрока.КоличествоКВыработке = Значение;
	
КонецПроцедуры
