	Отбор = Новый Структура;
	Отбор.Вставить("Ключ", ПолучитьВидЦенРаскрояПоВидуЦен());
	ОткрытьФорму("Справочник.ЦеныУслугРаскроя.ФормаОбъекта",Отбор);
	
