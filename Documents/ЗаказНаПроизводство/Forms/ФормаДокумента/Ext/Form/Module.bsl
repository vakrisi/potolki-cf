&НаСервере
Процедура ПересчитатьЦенуИСуммуНоменклатурыВСтрокеПоВалюте(НомерСтроки)
	ТекущаяСтрока = Объект.Товары[НомерСтроки-1];
	ВалютаУчета = Константы.ВалютаУчета.Получить();
	Если НЕ ВалютаУчета = Объект.Валюта Тогда
		ДатаДокумента = Объект.Дата;
		Если ДатаДокумента = Дата(1,1,1) Тогда
			ДатаДокумента = ТекущаяДатаСеанса();
		КонецЕсли;
		ТекущаяСтрока.Цена = РаботаСВалютой.ПересчитатьИзВалютыВВалюту(ВалютаУчета, Объект.Валюта, ДатаДокумента, ТекущаяСтрока.Цена);
		СуммаСтроки = ТекущаяСтрока.Количество * ТекущаяСтрока.Цена;
		ТекущаяСтрока.Сумма = СуммаСтроки - (СуммаСтроки * (ТекущаяСтрока.ПроцентРучнойСкидки / 100)) - ТекущаяСтрока.СуммаРучнойСкидки;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура КомандаПодобратьТовары(Команда)
	ПараметрыПодбора = Новый Структура;
	ПараметрыПодбора.Вставить("Дата",					Объект.Дата);
	ПараметрыПодбора.Вставить("Организация",			Объект.Организация);
	ПараметрыПодбора.Вставить("Склад",					Объект.Склад);
	ПараметрыПодбора.Вставить("ВидНоменклатуры",		ПолучитьСписокВидовНоменклатурыТовары());
	ПараметрыПодбора.Вставить("ВидЦены",				Объект.ВидЦен);
	ВозвращенноеЗначение = ОткрытьФормуМодально("ОбщаяФорма.ФормаПодбораНоменклатуры",ПараметрыПодбора);
	
	Если НЕ ВозвращенноеЗначение = Неопределено Тогда
		Для Каждого ТекущаяСтрока из ВозвращенноеЗначение Цикл
			НоваяСтрока = Объект.Товары.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущаяСтрока);
			ПересчитатьЦенуИСуммуНоменклатурыВСтрокеПоВалюте(НоваяСтрока.НомерСтроки);
		КонецЦикла;
	КонецЕсли;
	
	ОбновитьДанныеДокумента();
	ЗаполнитьДанныеКОтгрузкеИОстаткиПоТоварам();
КонецПроцедуры

&НаКлиенте
Процедура КомандаПодобратьМатериалы(Команда)
	
	ПараметрыПодбора = Новый Структура;
	ПараметрыПодбора.Вставить("Организация",			Объект.Организация);
	ПараметрыПодбора.Вставить("Склад",					Объект.Склад);
	ПараметрыПодбора.Вставить("ВидНоменклатуры",		ПолучитьСписокВидовНоменклатурыТовары());
	
	ВозвращенноеЗначение = ОткрытьФормуМодально("ОбщаяФорма.ФормаПодбораНоменклатуры",ПараметрыПодбора);
	
	Если НЕ ВозвращенноеЗначение = Неопределено Тогда
		Для Каждого ТекущаяСтрока из ВозвращенноеЗначение Цикл
			
			НоваяСтрока = Объект.Материалы.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущаяСтрока);
			
			НоваяСтрока.КоличествоКВыработке = НоваяСтрока.Количество; // №14311
			
		КонецЦикла;
	КонецЕсли;
	
	//++ №14311
	Объект.РучнаяКорректировкаМатериалов = Истина;
	ВремРучнаяКорректировкаМатериалов = Объект.РучнаяКорректировкаМатериалов;
	//-- №14311
	
	ОбновитьДанныеДокумента();

КонецПроцедуры

