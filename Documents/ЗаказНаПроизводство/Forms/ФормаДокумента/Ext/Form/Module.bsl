&НаКлиенте
Процедура ПечататьФайл(Команда)
	
	ВыбранныеЭлементы = Элементы.Файлы.ВыделенныеСтроки;
	
	Если ВыбранныеЭлементы.Количество() > 0 Тогда
		
		Для каждого ЭлементДляПечати из ВыбранныеЭлементы Цикл
			
			СтрФайл = Файлы.НайтиПоИдентификатору(ЭлементДляПечати);
			
			АдресФайла = ПолучитьДанные(СтрФайл.Номенклатура, СтрФайл.ИмяФайла);
			ВременноеИмя = ПолучитьИмяВременногоФайла(СтрФайл.Расширение);
			ПолучитьФайл(АдресФайла, ВременноеИмя, Ложь);
			
			Shell = Новый COMОбъект("Shell.Application");
			Shell.ShellExecute(ВременноеИмя, "", "", "print", 0);
			
		КонецЦикла;
		
		УстановитьГалочкуНачалиПроизводство();
		
	Иначе
		
		ПоказатьПредупреждение(,"Выберите файл(ы) в списке");
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПеревестиВСтатусВПроизводстве(Команда)
				
	Если Объект.ТекущийСтатус = ПредопределенноеЗначение("Справочник.СтатусыЗаказовНаПроизводство.ВПроизводстве") Тогда
		Состояние("Документ находится в статусе ""В производстве""!");
		Возврат;
	КонецЕсли;
	Если Не Объект.Проведен Тогда
		ПоказатьПредупреждение(,"Перед изменением статуса документа, его следует провести");
		Возврат;
	КонецЕсли;
			
	Оповещение = Новый ОписаниеОповещения("ПослеВопросаОПереводеВПроизводство", ЭтаФорма);
	ПоказатьВопрос(Оповещение, 
			"Перевести выбранные заказы в статус ""В производстве""?"+Символы.ПС+"Документ будет автоматически сохранен после смены статуса.",
			РежимДиалогаВопрос.ДаНет);
		
КонецПроцедуры

&НаКлиенте
Процедура ПослеВопросаОПереводеВПроизводство(Результат, Параметры) Экспорт
	
    Если Результат = КодВозвратаДиалога.Да Тогда
        ПеревестиВСтатусВПроизводствеНаСервере();
		Оповестить("ЗаписанЗаказНаПроизводство",Объект.ДокументОснование,"ЗаказНаПроизводство");
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПеревестиВСтатусВПроизводствеНаСервере()
	
	ДокументОбъект = РеквизитФормыВЗначение("Объект");
	
	Если Объект.ВидЗаказа = Перечисления.ВидыЗаказовНаПроизводство.ТиповоеПроизводство 
		ИЛИ Объект.ВидЗаказа = Перечисления.ВидыЗаказовНаПроизводство.ПроизводствоПотолка Тогда
		Если ДокументОбъект.ПроверитьЗаполнение() Тогда
			ДокументОбъект.ТекущийСтатус = Справочники.СтатусыЗаказовНаПроизводство.ВПроизводстве;
			ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
		КонецЕсли;
	КонецЕсли;
	
	ЗначениеВРеквизитФормы(ДокументОбъект, "Объект");
	
КонецПроцедуры

&НаКлиенте
Процедура ПеревестиВСтатусПроизведен(Команда)
	СозданиеНаОснованииПотолкиКлиент.ВыпускПродукцииСоздатьНаОснованииЗаказаНаПроизводство(Объект.Ссылка, Неопределено);
КонецПроцедуры

