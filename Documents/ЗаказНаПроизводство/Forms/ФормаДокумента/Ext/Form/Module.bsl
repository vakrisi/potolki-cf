Функция ПересчитатьЦеныПоВидуЦен()
	
	Если Объект.ВидЗаказа = Перечисления.ВидыЗаказовНаПроизводство.ПроизводствоПотолка Тогда
		//новый код с использованием универсальных функций
		ОписаниеОшибки = "";
		СтруктураПотолка = ОбменСEasyCeiling.ПолучитьСтруктуруПотолка(Объект.ПродукцияНоменклатура,,,,,,, ОписаниеОшибки);
		Если СтруктураПотолка = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
		Если ЗначениеЗаполнено(ОписаниеОшибки) Тогда
			Сообщить(ОписаниеОшибки);
			Возврат Неопределено;
		КонецЕсли;
		//СтруктураЗаказа = ОбменСEasyCeiling.ПолучитьСтруктуруЗаказа(СтруктураПотолка,Объект.НастройкаИнтеркампани, Объект.ВидЦен, Объект.Валюта, ?(Объект.Дата=Дата(1,1,1),ТекущаяДатаСеанса(),Объект.Дата), Перечисления.ВидыЗаказов.ЗаказНаПроизводство,,,Объект.ДоговорКонтрагента);
		ДанныеЗаказа = ОбменСEasyCeiling.СтруктураДанныхЗаказа(Объект.Организация, Объект.Подразделение, Объект.НастройкаИнтеркампани,
							  				 Объект.ВидЦен, Объект.Валюта, ?(Объект.Дата=Дата(1,1,1),ТекущаяДатаСеанса(),Объект.Дата), , , Объект.ДоговорКонтрагента, Объект.ВнутреннийЗаказ);
		СтруктураЗаказа = ОбменСEasyCeiling.ПолучитьСтруктуруЗаказа(СтруктураПотолка, Перечисления.ВидыЗаказов.ЗаказНаПроизводство, ДанныеЗаказа);
				
		Объект.ПродукцияСумма = СтруктураЗаказа.Сумма;
		Объект.ПродукцияНоменклатураКоличество = СтруктураЗаказа.Количество;
		Объект.ПродукцияЦена = СтруктураЗаказа.Цена;
		Если Объект.СкидкаНаПотолки <> 0 Тогда
			Объект.ПродукцияПроцентРучнойСкидки = Объект.СкидкаНаПотолки;			
		КонецЕсли;		
		Объект.ПродукцияСуммаРучнойСкидки = Объект.ПродукцияСумма * Объект.ПродукцияПроцентРучнойСкидки / 100;
		Объект.ПродукцияСумма = Объект.ПродукцияСумма - Объект.ПродукцияСуммаРучнойСкидки;	
		
		Объект.Услуги.Очистить();
		Для Каждого СтрокаТовар Из СтруктураЗаказа.Услуги Цикл
			НоваяСтрока = Объект.Услуги.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТовар);
		КонецЦикла;
		
		Для Каждого ТекущаяСтрока Из Объект.Товары Цикл
			ТекущаяСтрока.Цена = ПолучитьЦенуНоменклатуры(ТекущаяСтрока.Номенклатура, ТекущаяСтрока.ХарактеристикаНоменклатуры, ТекущаяСтрока.ЕдиницаИзмерения);
			
			СуммаБезСкидки = ТекущаяСтрока.Количество * ТекущаяСтрока.Цена;
			Если Объект.СкидкаНаТовары <> 0 Тогда
				ТекущаяСтрока.ПроцентРучнойСкидки = Объект.СкидкаНаТовары;
			КонецЕсли;	
			ТекущаяСтрока.СуммаРучнойСкидки = СуммаБезСкидки * ТекущаяСтрока.ПроцентРучнойСкидки/100;
			ТекущаяСтрока.Сумма = СуммаБезСкидки - ТекущаяСтрока.СуммаРучнойСкидки;	
		КонецЦикла;
		
	Иначе
		//старый код, может уже и не нужен и его надо удалть?
		
		ТаблицаЦен = Новый ТаблицаЗначений;
		ТаблицаЦен.Колонки.Добавить("Количество");
		ТаблицаЦен.Колонки.Добавить("Цена");
		ТаблицаЦен.Колонки.Добавить("Сумма");

		
		Если Объект.ФактураПотолка.Количество() > 0 Тогда
			Для Каждого ТекушаяСтрока Из Объект.ФактураПотолка Цикл
				НоваяСтрока = ТаблицаЦен.Добавить();
				НоваяСтрока.Количество = ТекушаяСтрока.ПродукцияКоличество;
				НоваяСтрока.Цена = ПолучитьЦенуМатериала(КонецДня(Объект.Дата), ТекушаяСтрока.ПродукцияЦвет,Объект.ВидЦен, Объект.ПродукцияНоменклатура);
				НоваяСтрока.Сумма = НоваяСтрока.Количество * НоваяСтрока.Цена;
			КонецЦикла;
		КонецЕсли;

		
		ТаблицаЦен.Свернуть(,"Сумма");
		Если ТаблицаЦен.Количество() > 0 Тогда
			Объект.ПродукцияСумма = ТаблицаЦен[0].Сумма;
		КонецЕсли;
		Если НЕ Объект.ПродукцияНоменклатураКоличество = 0 Тогда
			Объект.ПродукцияЦена = Объект.ПродукцияСумма / Объект.ПродукцияНоменклатураКоличество;
		КонецЕсли;







		//НАЧАЛО Переход на 2.0
		//округлим стоимость потолка и пересчитаем цену по факту
		//Объект.ПродукцияСумма = ОбщийМодуль.ОкруглитьЧисло(Объект.ПродукцияНоменклатураКоличество * Объект.ПродукцияЦена,Объект.ВидЦен.ПорядокОкругленияСтоимостиПроизводимыхПотолков,Объект.ВидЦен.ОкруглятьВБольшуюСторонуСтоимостьПроизводимыхПотолков);
		//КОНЕЦ  Переход на 2.0

		Объект.ПродукцияСумма = Объект.ПродукцияНоменклатураКоличество * Объект.ПродукцияЦена;
		Если НЕ Объект.ПродукцияНоменклатураКоличество = 0 Тогда
			Объект.ПродукцияЦена = Объект.ПродукцияСумма /  Объект.ПродукцияНоменклатураКоличество;
			
			Если Объект.СкидкаНаПотолки <> 0 Тогда
				Объект.ПродукцияПроцентРучнойСкидки = Объект.СкидкаНаПотолки;			
			КонецЕсли;		
			
			Объект.ПродукцияСуммаРучнойСкидки = Объект.ПродукцияСумма * Объект.ПродукцияПроцентРучнойСкидки / 100;
			
			Объект.ПродукцияСумма = Объект.ПродукцияСумма - Объект.ПродукцияСуммаРучнойСкидки;	
			
			
		КонецЕсли;
		
		
		Для Каждого ТекущаяСтрока Из Объект.Товары Цикл
			ТекущаяСтрока.Цена = ПолучитьЦенуНоменклатуры(ТекущаяСтрока.Номенклатура, ТекущаяСтрока.ХарактеристикаНоменклатуры, ТекущаяСтрока.ЕдиницаИзмерения);
			
			СуммаБезСкидки = ТекущаяСтрока.Количество * ТекущаяСтрока.Цена;
			Если Объект.СкидкаНаТовары <> 0 Тогда
				ТекущаяСтрока.ПроцентРучнойСкидки = Объект.СкидкаНаТовары;
			КонецЕсли;	
			ТекущаяСтрока.СуммаРучнойСкидки = СуммаБезСкидки * ТекущаяСтрока.ПроцентРучнойСкидки/100;
			ТекущаяСтрока.Сумма = СуммаБезСкидки - ТекущаяСтрока.СуммаРучнойСкидки;	
		КонецЦикла;
		Для Каждого ТекущаяСтрока Из Объект.Услуги Цикл
			ТекущаяСтрока.Цена = ПолучитьЦенуНоменклатуры(ТекущаяСтрока.Номенклатура, Неопределено, ТекущаяСтрока.ЕдиницаИзмерения, Истина);
			
			СуммаБезСкидки = ТекущаяСтрока.Количество * ТекущаяСтрока.Цена;
			Если Объект.СкидкаНаУслуги <> 0 Тогда
				ТекущаяСтрока.ПроцентРучнойСкидки = Объект.СкидкаНаУслуги;
			КонецЕсли;
			ТекущаяСтрока.СуммаРучнойСкидки = СуммаБезСкидки * ТекущаяСтрока.ПроцентРучнойСкидки/100;
			ТекущаяСтрока.Сумма = СуммаБезСкидки - ТекущаяСтрока.СуммаРучнойСкидки;			
		КонецЦикла;
		//ПерезаполнитьУслугиРаскрояПоДаннымФайлаИмпорта();
		
		Для Каждого ТекущаяСтрока Из Объект.Продукция Цикл
			ТекущаяСтрока.Цена = ПолучитьЦенуНоменклатуры(ТекущаяСтрока.Номенклатура, Неопределено, ТекущаяСтрока.ЕдиницаИзмерения);
			
			СуммаБезСкидки = ТекущаяСтрока.Количество * ТекущаяСтрока.Цена;
			СуммаБезСкидки = ТекущаяСтрока.Количество * ТекущаяСтрока.Цена;
			Если Объект.СкидкаНаПотолки <> 0 Тогда
				ТекущаяСтрока.ПроцентРучнойСкидки = Объект.СкидкаНаПотолки;
			КонецЕсли;
			ТекущаяСтрока.СуммаРучнойСкидки = СуммаБезСкидки * ТекущаяСтрока.ПроцентРучнойСкидки/100;
			ТекущаяСтрока.Сумма = СуммаБезСкидки - ТекущаяСтрока.СуммаРучнойСкидки;	
		КонецЦикла;
	КонецЕсли;

	ОбновитьДанныеДокумента();	

КонецФункции

&НаСервере
Процедура ПеревестиФормуВТолькоПросмотр(ТолькоПросмотр)
	
	ЭтаФорма.ТолькоПросмотр = ТолькоПросмотр;
	ЭтаФорма.КоманднаяПанель.ТолькоПросмотр = ТолькоПросмотр;
	Элементы.ПодменюСоздатьНаОсновании.ТолькоПросмотр = ТолькоПросмотр;
	
	Элементы.ГруппаСуммаДокумента.ТолькоПросмотр = ТолькоПросмотр;
	ПеревестиВсеПодчиненныеЭлементыВТолькоПРосмотр(Элементы.ГруппаСуммаДокумента, ТолькоПросмотр);
	
	Элементы.ФормаГруппаСменаСтатуса.ТолькоПросмотр = ТолькоПросмотр;
	ПеревестиВсеПодчиненныеЭлементыВТолькоПРосмотр(Элементы.ФормаГруппаСменаСтатуса, ТолькоПросмотр);
	
	//++ №12232 комментируем, т.к. больше не используется
	//Элементы.ГруппаПродукцияНоменклатураКнопки.ТолькоПросмотр = ТолькоПросмотр;
	//ПеревестиВсеПодчиненныеЭлементыВТолькоПРосмотр(Элементы.ГруппаПродукцияНоменклатураКнопки, ТолькоПросмотр);
	//-- №12232
	
	ПеревестиВсеПодчиненныеЭлементыВТолькоПРосмотр(Элементы.УслугиГруппаКнопок, ТолькоПросмотр);
	ПеревестиВсеПодчиненныеЭлементыВТолькоПРосмотр(Элементы.МатериалыГруппаКнопок, ТолькоПросмотр);
	
	ПеревестиВсеПодчиненныеЭлементыВТолькоПРосмотр(Элементы.Исполнители.КоманднаяПанель, ТолькоПросмотр);
	ПеревестиВсеПодчиненныеЭлементыВТолькоПРосмотр(Элементы.ИсполнителиПоУчасткам.КоманднаяПанель, ТолькоПросмотр);
	ПеревестиВсеПодчиненныеЭлементыВТолькоПРосмотр(Элементы.ГруппаФайлыКнопки, ТолькоПросмотр);
	
КонецПроцедуры

&НаСервере
Процедура ПеревестиВсеПодчиненныеЭлементыВТолькоПРосмотр(РодительскийЭлемент, ТолькоПросмотр)
	
	Для Каждого ПодчиненныйЭлемент Из РодительскийЭлемент.ПодчиненныеЭлементы Цикл
		Попытка
			Если ПодчиненныйЭлемент.Вид = ВидКнопкиФормы.ОбычнаяКнопка 
				или ПодчиненныйЭлемент.Вид = ВидКнопкиФормы.КнопкаКоманднойПанели
				или ПодчиненныйЭлемент.Вид = ВидГруппыФормы.Подменю
				Тогда
				ПодчиненныйЭлемент.Доступность = Не ТолькоПросмотр;
			Иначе
				ПодчиненныйЭлемент.ТолькоПросмотр = ТолькоПросмотр;
			КонецЕсли;
		Исключение
		КонецПопытки
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура НачалоПерезаполненияЗаказаНаПроизводствоПоОснованию(Результат, Параметры) Экспорт
	
	Если Результат = Истина Тогда
		
		РезультатОбработки = ОбновитьЗаказНаПроизводствоПоЗаказуПокупателя();
				
		//Если НЕ ЕстьВыпускПоЗаказу Тогда
		//	ПеревестиФормуВТолькоПросмотр(Ложь);
		//КонецЕсли;
		Если РезультатОбработки Тогда
        	ЭтотОбъект.Прочитать();			
		КонецЕсли;
		ПриОткрытии(Ложь);
		
    КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ОбновитьЗаказНаПроизводствоПоЗаказуПокупателя(ПоОбъекту = Ложь)
	
	ДоступноИзменениеПриНаличииВыпуска = Ложь;
	Если ТипЗнч(ПараметрыФормыПросмотраРазличий) = Тип("Структура")
		И ПараметрыФормыПросмотраРазличий.Свойство("ДоступноИзменениеПриНаличииВыпуска") Тогда
		ДоступноИзменениеПриНаличииВыпуска = ПараметрыФормыПросмотраРазличий.ДоступноИзменениеПриНаличииВыпуска;
	КонецЕсли;
	
	Если ПоОбъекту Тогда
		ТекущийОбъект = РеквизитФормыВЗначение("Объект");		
		РезультатОбработки = ОбщийМодуль.ОбновитьЗаказНаПроизводствоПоЗаказуПокупателя(ТекущийОбъект, ДоступноИзменениеПриНаличииВыпуска);		
		ЗначениеВРеквизитФормы(ТекущийОбъект, "Объект");
	Иначе
		РезультатОбработки = ОбщийМодуль.ОбновитьЗаказНаПроизводствоПоЗаказуПокупателя(Объект.Ссылка, ДоступноИзменениеПриНаличииВыпуска);
	КонецЕсли;
	
	Возврат РезультатОбработки;
	
КонецФункции

