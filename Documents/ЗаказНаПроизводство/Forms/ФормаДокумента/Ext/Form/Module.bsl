&НаКлиенте
Процедура ВыполнитьПроверкиИЗадатьВопросыПередЗаписью(Отказ, ПараметрыЗаписи)
	
	//ДополнительныеПараметры = Новый Структура;
	//ДополнительныеПараметры.Вставить("ПараметрыЗаписи", ПараметрыЗаписи);
	//ДополнительныеПараметры.Вставить("ЭтотОбъект", ЭтотОбъект);
	//		
	//Отказ = Истина;
	//ОписаниеОповещения = Новый ОписаниеОповещения("ПодтверждениеПередЗаписью", ЭтотОбъект, ДополнительныеПараметры);
	//
	//ТекстВопроса = СтрШаблон("Изменения ранее %1 документа ""Установка стоимости выработки"" 
	//				|может привести к расхождениям в начислении выработки во всех документах, 
	//				|оформленных датой позднее текущего документа ""Установка стоимости выработки"". 
	//				|Продолжить?", ?(ОбщийМодульВызовСервера.ДокументПроведен(Объект.Ссылка), "проведенного", "непроведенного"));
	//ПоказатьВопрос(
	//	ОписаниеОповещения,
	//	ТекстВопроса,
	//	РежимДиалогаВопрос.ДаНет);
		
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ПараметрыЗаписи", ПараметрыЗаписи);
	ДополнительныеПараметры.Вставить("ЭтотОбъект", ЭтотОбъект);
	
	Отказ = Ложь;
	
	//#14923 проверка соответствия заказа на производство заказу покупателя, если он указан в основании
	Если ЗначениеЗаполнено(Объект.Ссылка)                                                                                        
		И НЕ Объект.ТекущийСтатус = ПредопределенноеЗначение("Справочник.СтатусыЗаказовНаПроизводство.Отменен") 
		И ТипЗнч(Объект.ДокументОснование) = Тип("ДокументСсылка.ЗаказПокупателя")
		И НЕ Объект.ДокументОснование.Пустая()		
		И ОбщийМодульВызовСервера.ЗаказНаПроизводствоСвязанСЗаказомПокупателя(Объект.Ссылка)
		Тогда
		
		ОписаниеОповещения = Новый ОписаниеОповещения("ПодтверждениеПередЗаписью", ЭтотОбъект, ДополнительныеПараметры);
		ВыполнитьПроверкуСоответствияЗаказуПокупателя("ПередЗаписью", ОписаниеОповещения, Отказ);
		
	Иначе
		ДополнительныеПараметры.Вставить("Отказ", Отказ);
		ОбщийМодульКлиент.ЗаписатьОбъектПриНеобходимости(ЭтотОбъект, ДополнительныеПараметры.ПараметрыЗаписи,, Истина);
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура ПодтверждениеПередЗаписью(ОтветНаВопрос, ДополнительныеПараметры) Экспорт
	
	Отказ = Ложь;
	
	Если ОтветНаВопрос = Истина Тогда
		РезультатОбработки = ОбновитьЗаказНаПроизводствоПоЗаказуПокупателя(Истина);
		Если РезультатОбработки Тогда
			//ЭтотОбъект.Прочитать();
			Отказ = Ложь;
		Иначе			
			Сообщить("Не удалось обновить заказ на производство по заказу покупателя");
			Возврат;
		КонецЕсли;
	Иначе
		Возврат;
	КонецЕсли;
	
	ДополнительныеПараметры.Вставить("Отказ", Отказ);
	ОбщийМодульКлиент.ЗаписатьОбъектПриНеобходимости(ЭтотОбъект, ДополнительныеПараметры.ПараметрыЗаписи,, Истина);
	
КонецПроцедуры

&НаСервере
Функция ВыполнитьПроверкуСоответствияЗаказуПокупателяСервер(Режим)
	
	Если Режим = "ПередЗаписью" Тогда
		ТекущийОбъект = РеквизитФормыВЗначение("Объект");
		СтруктураПроверки = ОбщийМодуль.ЗаказНаПроизводствоСоответствуетЗаказуПокупателя(ТекущийОбъект, Объект.ДокументОснование);
	Иначе
	    СтруктураПроверки = ОбщийМодуль.ЗаказНаПроизводствоСоответствуетЗаказуПокупателя(Объект.Ссылка, Объект.ДокументОснование);
	КонецЕсли;
	
	Возврат СтруктураПроверки;
	
КонецФункции

// Процедура - Выполнить проверку соответствия заказу покупателя
//
// Параметры:
//  ИзменятьСвойствоТолькоПросмотр	- при открытии - Истина, перед записью - Ложь 
//  ОтложенныйВопрос	 			- при открытии - Истина, перед записью - Ложь
//
&НаКлиенте
Процедура ВыполнитьПроверкуСоответствияЗаказуПокупателя(Режим, ОписаниеОповещения = Неопределено, Отказ = Ложь)
	 
	ИзменятьСвойствоТолькоПросмотр = Истина;
	ОтложенныйВопрос = Истина;
	Если Режим = "ПередЗаписью" Тогда
		ИзменятьСвойствоТолькоПросмотр = Ложь;
		ОтложенныйВопрос = Ложь;	
	КонецЕсли;
	
	СтруктураПроверки = ВыполнитьПроверкуСоответствияЗаказуПокупателяСервер(Режим);
	 
	Если СтруктураПроверки.Результат Тогда
		// ошибок нет
		ЗаблокироватьОбъект();
		
	Иначе
		Отказ = Истина;
		
		//проверка соответствия заказа на производство потолка заказу покупателя, если он указан в основании
		Если Объект.ВидЗаказа = ПредопределенноеЗначение("Перечисление.ВидыЗаказовНаПроизводство.ПроизводствоПотолка") Тогда	
			
			Если СтруктураПроверки.ЕстьПотолок Тогда
				
				ПараметрыФормыПросмотраРазличий = Новый Структура;
				ПараметрыФормыПросмотраРазличий.Вставить("МассивСравнения", СтруктураПроверки.МассивСравнения);
				
				ПараметрыФормыПросмотраРазличий.Вставить("Документ1", Объект.ДокументОснование);
				ПараметрыФормыПросмотраРазличий.Вставить("Документ2", Объект.Ссылка);
				ПараметрыФормыПросмотраРазличий.Вставить("МассивРазличийРеквизитов", СтруктураПроверки.МассивРазличийРеквизитов);
				ПараметрыФормыПросмотраРазличий.Вставить("ДоступноИзменениеПриНаличииВыпуска", СтруктураПроверки.ДоступноИзменениеПриНаличииВыпуска); //#13200
				ПараметрыФормыПросмотраРазличий.Вставить("ЕстьВыпуск", СтруктураПроверки.ЕстьВыпуск); //#13200
				//ПараметрыФормыПросмотраРазличий.Вставить("ТолькоПросмотр", ТолькоПросмотр); - вожможность перезаполнить должна быть и с проведенным выпуском
				ПараметрыФормыПросмотраРазличий.Вставить("ТолькоПросмотр", Ложь);
				
				Если ИзменятьСвойствоТолькоПросмотр Тогда
					Если НЕ ТолькоПросмотр Тогда
						// №14923 на просмотр переводим только если есть выпуск
						// по другому: учитываем наличие права пользователя
						//Если СтруктураПроверки.ЕстьВыпуск Тогда
						Если Объект.ТекущийСтатус = ПредопределенноеЗначение("Справочник.СтатусыЗаказовНаПроизводство.Произведен")
							И НЕ РазрешеноРедактироватьПроизведенныеЗаказыНаПроизводство Тогда
							ПеревестиФормуВТолькоПросмотр(Истина);
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;
				
				ТекстСообщения = ОбщийМодульКлиент.ТекстВопросаПерезаполненииЗаказаНаПроизводствоПоОснованию(СтруктураПроверки);
				ПараметрыФормыПросмотраРазличий.Вставить("ТекстСообщения",    ТекстСообщения);
				
				Если ОтложенныйВопрос Тогда
					ПодключитьОбработчикОжидания("ПоказатьВопросПриОткрытии", 0.3, Истина);					
				Иначе
					ОткрытьФорму("ОбщаяФорма.ПросмотрРазличийДокументов", ПараметрыФормыПросмотраРазличий, ЭтотОбъект,,,,ОписаниеОповещения);
				КонецЕсли;
			Иначе
				Сообщить("В заказе покупателя (основании) отсутствует данный потолок!");
			КонецЕсли;
		
		ИначеЕсли Объект.ВидЗаказа = ПредопределенноеЗначение("Перечисление.ВидыЗаказовНаПроизводство.ТиповоеПроизводство") Тогда
		//проверка соответствия заказа на типовое производство заказу покупателя, если он указан в основании
					
			ПараметрыФормыПросмотраРазличий = Новый Структура;
			ПараметрыФормыПросмотраРазличий.Вставить("МассивСравнения", СтруктураПроверки.МассивСравнения);
			
			ПараметрыФормыПросмотраРазличий.Вставить("Документ1", Объект.ДокументОснование);
			ПараметрыФормыПросмотраРазличий.Вставить("Документ2", Объект.Ссылка);
			ПараметрыФормыПросмотраРазличий.Вставить("МассивРазличийРеквизитов", СтруктураПроверки.МассивРазличийРеквизитов);
			ПараметрыФормыПросмотраРазличий.Вставить("ДоступноИзменениеПриНаличииВыпуска", СтруктураПроверки.ДоступноИзменениеПриНаличииВыпуска); //#13200
			ПараметрыФормыПросмотраРазличий.Вставить("ЕстьВыпуск", СтруктураПроверки.ЕстьВыпуск); //#13200
			//ПараметрыФормыПросмотраРазличий.Вставить("ТолькоПросмотр", ТолькоПросмотр);  - вожможность перезаполнить должна быть и с проведенным выпуском
			ПараметрыФормыПросмотраРазличий.Вставить("ТолькоПросмотр", Ложь);
			
			Если ИзменятьСвойствоТолькоПросмотр Тогда
				Если НЕ ТолькоПросмотр Тогда
					// №14923 на просмотр переводим только если есть выпуск
					// по другому: учитываем наличие права пользователя
					//Если СтруктураПроверки.ЕстьВыпуск Тогда
					Если Объект.ТекущийСтатус = ПредопределенноеЗначение("Справочник.СтатусыЗаказовНаПроизводство.Произведен")
						И НЕ РазрешеноРедактироватьПроизведенныеЗаказыНаПроизводство Тогда
						ПеревестиФормуВТолькоПросмотр(Истина);
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
			
			ТекстСообщения = ОбщийМодульКлиент.ТекстВопросаПерезаполненииЗаказаНаПроизводствоПоОснованию(СтруктураПроверки);
			
			ПараметрыФормыПросмотраРазличий.Вставить("ТекстСообщения",    ТекстСообщения);
			
			Если ОтложенныйВопрос Тогда
				ПодключитьОбработчикОжидания("ПоказатьВопросПриОткрытии", 0.3, Истина);					
			Иначе
				ОткрытьФорму("ОбщаяФорма.ПросмотрРазличийДокументов", ПараметрыФормыПросмотраРазличий, ЭтотОбъект,,,,ОписаниеОповещения);
			КонецЕсли;
				
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

