&НаКлиенте
Процедура ТоварыНоменклатураПриИзменении(Элемент)
	
	СтрокаТабличнойЧасти = Элементы.Товары.ТекущиеДанные;
	СтрокаТабличнойЧасти.ЕдиницаИзмерения = ПолучитьБазовуюЕдиницуИзмеренияНоменклатуры(СтрокаТабличнойЧасти.Номенклатура);
	СтрокаТабличнойЧасти.Коэффициент = 1;
	СтрокаТабличнойЧасти.Количество = 1;
	СтрокаТабличнойЧасти.Цена = ПолучитьЦенуНоменклатуры(СтрокаТабличнойЧасти.Номенклатура, СтрокаТабличнойЧасти.ХарактеристикаНоменклатуры, СтрокаТабличнойЧасти.ЕдиницаИзмерения);
	//заккоментирована потому что добавлены скидки по договору
	//СтрокаТабличнойЧасти.Сумма = СтрокаТабличнойЧасти.Цена;
	СуммаБезСкидки = СтрокаТабличнойЧасти.Количество * СтрокаТабличнойЧасти.Цена;
	Если Объект.СкидкаНаТовары <> 0 Тогда
		СтрокаТабличнойЧасти.ПроцентРучнойСкидки = Объект.СкидкаНаТовары;		
		СтрокаТабличнойЧасти.СуммаРучнойСкидки = СуммаБезСкидки * СтрокаТабличнойЧасти.ПроцентРучнойСкидки/100;
	Иначе
		СтрокаТабличнойЧасти.ПроцентРучнойСкидки = 0;
		СтрокаТабличнойЧасти.СуммаРучнойСкидки = 0;		
	КонецЕсли;		
	
	СтрокаТабличнойЧасти.Сумма = СуммаБезСкидки - СтрокаТабличнойЧасти.СуммаРучнойСкидки;	
	
	ОбновитьСписокФайлов();
	
КонецПроцедуры

