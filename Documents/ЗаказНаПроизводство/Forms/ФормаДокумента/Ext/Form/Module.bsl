Процедура ПродукцияЕдиницаИзмеренияОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	СтрокаТабличнойЧасти = Элементы.Продукция.ТекущиеДанные;
	Если ТипЗнч(ВыбранноеЗначение) = Тип("СправочникСсылка.КлассификаторЕдиницИзмерения") Тогда
		СтрокаТабличнойЧасти.Коэффициент = 1;
	Иначе
		СтрокаТабличнойЧасти.Коэффициент = ОбщийМодуль.ПолучитьКоэффициентЕдиницыИзмерения(ВыбранноеЗначение);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПродукцияНоменклатура1ПриИзменении(Элемент)
	
	СтрокаТабличнойЧасти = Элементы.Продукция.ТекущиеДанные;
	
	СтруктураДанные = Новый Структура("Номенклатура, ВидСпецификации", СтрокаТабличнойЧасти.Номенклатура, ВидСпецификацииПоУмолчанию);
	СтруктураДанные = ОбработкаТабличныхЧастейКлиент.ПолучитьДанныеНоменклатурыПриИзменении(СтруктураДанные);	
	ЗаполнитьЗначенияСвойств(СтрокаТабличнойЧасти, СтруктураДанные, "ЕдиницаИзмерения, Коэффициент, Спецификация");
	
	//СтрокаТабличнойЧасти.ЕдиницаИзмерения = ПолучитьБазовуюЕдиницуИзмеренияНоменклатуры(СтрокаТабличнойЧасти.Номенклатура);
	//СтрокаТабличнойЧасти.Коэффициент = 1;
	СтрокаТабличнойЧасти.Количество = 1;
	//СтрокаТабличнойЧасти.Спецификация = ПолучитьОсновнуюСпецификациюНоменклатуры(СтрокаТабличнойЧасти.Номенклатура);
	
	РассчитатьЦенуИСуммуТиповойПродукции(СтрокаТабличнойЧасти);
	
	Если ПустаяСтрока(СтрокаТабличнойЧасти.УИСтроки) Тогда
		СтрокаТабличнойЧасти.УИСтроки = Новый УникальныйИдентификатор;
	КонецЕсли;
	
	ОбновитьДанныеДокумента();
	
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьЦенуИСуммуТиповойПродукции(СтрокаТабличнойЧасти)
	
	СтрокаТабличнойЧасти.Цена = ПолучитьЦенуНоменклатуры(СтрокаТабличнойЧасти.Номенклатура, Неопределено, СтрокаТабличнойЧасти.ЕдиницаИзмерения);
	//заккоментирована потому что добавлены скидки по договору
	//СтрокаТабличнойЧасти.Сумма = СтрокаТабличнойЧасти.Цена;
	
	СуммаБезСкидки = СтрокаТабличнойЧасти.Количество * СтрокаТабличнойЧасти.Цена;
	Если Объект.СкидкаНаПотолки <> 0 Тогда
		СтрокаТабличнойЧасти.ПроцентРучнойСкидки = Объект.СкидкаНаПотолки;		
		СтрокаТабличнойЧасти.СуммаРучнойСкидки = СуммаБезСкидки * СтрокаТабличнойЧасти.ПроцентРучнойСкидки/100;
	Иначе
		СтрокаТабличнойЧасти.ПроцентРучнойСкидки = 0;
		СтрокаТабличнойЧасти.СуммаРучнойСкидки = 0;		
	КонецЕсли;		
	
	СтрокаТабличнойЧасти.Сумма = СуммаБезСкидки - СтрокаТабличнойЧасти.СуммаРучнойСкидки;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьМатериалыПоСпецификациямНаСервере()
	
	Объект.Материалы.Очистить();
	
	ВременнаяТаблица = Новый ТаблицаЗначений; //хранит общее количество необходимых материалов по спецификации после округления общего количества товаров
	ВременнаяТаблица.Колонки.Добавить("Номенклатура");
	ВременнаяТаблица.Колонки.Добавить("ХарактеристикаНоменклатуры");
	ВременнаяТаблица.Колонки.Добавить("ОкруглятьВБольшуюСторону");
	ВременнаяТаблица.Колонки.Добавить("ПорядокОкругленияЧислом");
	ВременнаяТаблица.Колонки.Добавить("КоличествоДоОкругления");
	ВременнаяТаблица.Колонки.Добавить("КоличествоПослеОкругления");
	
	ТаблицаМатериалов = Новый ТаблицаЗначений;
	ТаблицаМатериалов.Колонки.Добавить("Номенклатура");
	ТаблицаМатериалов.Колонки.Добавить("ХарактеристикаНоменклатуры");
	ТаблицаМатериалов.Колонки.Добавить("ЕдиницаИзмерения");
	ТаблицаМатериалов.Колонки.Добавить("Коэффициент");
	ТаблицаМатериалов.Колонки.Добавить("Количество");
	
	
	Для Каждого ТекущаяСтрока Из Объект.Продукция Цикл
		НоваяСтрока = ТаблицаМатериалов.Добавить();
		Если НЕ ТекущаяСтрока.Спецификация.Пустая() Тогда
			Для Каждого СтрокаСпецификации Из ТекущаяСтрока.Спецификация.Состав Цикл
				КоэффициентИзменения = ?(СтрокаСпецификации.ФиксированноеКоличество, 1, ТекущаяСтрока.Количество * ТекущаяСтрока.Коэффициент);
				КоличествоКДобавлению = ОбщийМодуль.ОкруглитьЧисло(КоэффициентИзменения * СтрокаСпецификации.Количество,СтрокаСпецификации.ПорядокОкругленияЧислом,СтрокаСпецификации.ОкруглятьВБольшуюСторону); 
				Если КоличествоКДобавлению > 0 Тогда
					НоваяСтрока = ТаблицаМатериалов.Добавить();
					ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаСпецификации);
					НоваяСтрока.Количество = КоличествоКДобавлению;
					
					НоваяВремСтрока = ВременнаяТаблица.Добавить();
					НоваяВремСтрока.Номенклатура = СтрокаСпецификации.Номенклатура;
					НоваяВремСтрока.ХарактеристикаНоменклатуры = СтрокаСпецификации.ХарактеристикаНоменклатуры;
					НоваяВремСтрока.ОкруглятьВБольшуюСторону = СтрокаСпецификации.ОкруглятьВБольшуюСторону;
					НоваяВремСтрока.ПорядокОкругленияЧислом = СтрокаСпецификации.ПорядокОкругленияЧислом;
					НоваяВремСтрока.КоличествоДоОкругления = ТекущаяСтрока.Количество * ТекущаяСтрока.Коэффициент * СтрокаСпецификации.Количество;
					НоваяВремСтрока.КоличествоПослеОкругления = 0;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	
	ТаблицаМатериалов.Свернуть("Номенклатура, ХарактеристикаНоменклатуры, ЕдиницаИзмерения, Коэффициент","Количество");
	ВременнаяТаблица.Свернуть("Номенклатура, ХарактеристикаНоменклатуры, ОкруглятьВБольшуюСторону, ПорядокОкругленияЧислом", "КоличествоДоОкругления, КоличествоПослеОкругления");
	
	//посчитаем сколько какого материала должно быть итого с применением округления
	Для Каждого ТекущаяСтрока Из ВременнаяТаблица Цикл
		ТекущаяСтрока.КоличествоПослеОкругления = ОбщийМодуль.ОкруглитьЧисло(ТекущаяСтрока.КоличествоДоОкругления,ТекущаяСтрока.ПорядокОкругленияЧислом,ТекущаяСтрока.ОкруглятьВБольшуюСторону);
	КонецЦикла;
	
	//получаем итоговое количество каждого материала после всех округлений
	ВременнаяТаблица.Свернуть("Номенклатура, ХарактеристикаНоменклатуры", "КоличествоПослеОкругления");
	
	//перезаполняем количество в результирующей таблице на основании того, сколько должно было бы получиьтся при общем итоге после округления
	Для Каждого ТекущийМатериал Из ТаблицаМатериалов Цикл
		КоличествоБыло = ТекущийМатериал.Количество;
		ТекущийМатериал.Количество = 0;
		Для Каждого ТекущийИтогМатериала Из ВременнаяТаблица Цикл
			Если ТекущийМатериал.Номенклатура = ТекущийИтогМатериала.Номенклатура Тогда
				Если ТекущийИтогМатериала.КоличествоПослеОкругления >= КоличествоБыло Тогда
					ТекущийМатериал.Количество = КоличествоБыло;
					ТекущийИтогМатериала.КоличествоПослеОкругления = ТекущийИтогМатериала.КоличествоПослеОкругления - КоличествоБыло;
				Иначе
					ТекущийМатериал.Количество = ТекущийИтогМатериала.КоличествоПослеОкругления;
					ТекущийИтогМатериала.КоличествоПослеОкругления = 0;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла
	КонецЦикла;
	
	//переносим таблицу в документ
	Для Каждого ТекущийМатериал Из ТаблицаМатериалов Цикл
		Если НЕ ТекущийМатериал.Количество = 0 Тогда
			НоваяСтрока = Объект.Материалы.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущийМатериал);
			НоваяСтрока.КоличествоКВыработке = НоваяСтрока.Количество;
		КонецЕсли;
	КонецЦикла;
	
	//находим в списке материалов типовые отрезы и меняем их на соответствуюущую пленку
	Для Каждого СтрокаМатериала Из Объект.Материалы Цикл
		Если СтрокаМатериала.Номенклатура.ВидНоменклатуры = Справочники.ВидыНоменклатуры.ТиповойОтрез Тогда
			НоменклатураОтреза = СтрокаМатериала.Номенклатура;
			КоличествоОтреза = СтрокаМатериала.Количество;
			ЕдиницаИзмеренияОтреза = СтрокаМатериала.ЕдиницаИзмерения;
			
			ВремНоменклатура = Справочники.Номенклатура.ПолучитьОсновнуюФактуруИЦветПотолка(НоменклатураОтреза).ПродукцияЦвет.Номенклатура;
			Если НЕ ВремНоменклатура.Пустая() Тогда
				СтрокаМатериала.Номенклатура = ВремНоменклатура;
				СтрокаМатериала.ЕдиницаИзмерения = ПолучитьБазовуюЕдиницуИзмеренияНоменклатуры(СтрокаМатериала.Номенклатура);
				СтрокаМатериала.Коэффициент = 1;
				Если СтрокаМатериала.ЕдиницаИзмерения = Справочники.КлассификаторЕдиницИзмерения.МетрПогонный Тогда
					ШиринаПолотна = НоменклатураОтреза.Фактура.ШиринаПолотна / 100;
					Если НЕ ШиринаПолотна = 0 Тогда
						СтрокаМатериала.Количество = Окр(КоличествоОтреза / ШиринаПолотна,2);
					Иначе
						СтрокаМатериала.Количество = 0;
					КонецЕсли;
				Иначе
					СтрокаМатериала.Количество = КоличествоОтреза;
				КонецЕсли;
				СтрокаМатериала.КоличествоКВыработке = КоличествоОтреза;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	//++ №14311
	Объект.РучнаяКорректировкаМатериалов = Истина;
	ВремРучнаяКорректировкаМатериалов = Объект.РучнаяКорректировкаМатериалов;
	//-- №14311
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьМатериалыПоСпецификациям(Команда)
	ЗаполнитьМатериалыПоСпецификациямНаСервере();
	ОбновитьДанныеДокумента();
КонецПроцедуры

&НаКлиенте
Процедура ПродукцияЦена1ПриИзменении(Элемент)
	ТекущаяСтрока = Элементы.Продукция.ТекущиеДанные;
	СуммаБезСкидки = ТекущаяСтрока.Количество * ТекущаяСтрока.Цена;
	ТекущаяСтрока.СуммаРучнойСкидки = СуммаБезСкидки * ТекущаяСтрока.ПроцентРучнойСкидки/100;
	ТекущаяСтрока.Сумма = СуммаБезСкидки - ТекущаяСтрока.СуммаРучнойСкидки;
	ОбновитьДанныеДокумента();
