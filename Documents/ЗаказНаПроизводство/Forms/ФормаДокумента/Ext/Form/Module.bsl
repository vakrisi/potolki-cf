		или Объект.ВидЗаказа = Перечисления.ВидыЗаказовНаПроизводство.ТиповоеПроизводство 
			или Объект.ВидЗаказа = Перечисления.ВидыЗаказовНаПроизводство.Перезаказ Тогда
			
		Объект.ПродукцияЦена = 0;
		Объект.ПродукцияСуммаРучнойСкидки = 0;
		Объект.ПродукцияПроцентРучнойСкидки = 0;
		Объект.ПродукцияСумма = 0;
		
	КонецЕсли;
	
