		//Иначе
		//	//заказ на типовое производство, не привязанный к основанию
		//	Элементы.Материалы.ТолькоПросмотр = Ложь;
		//	Элементы.МатериалыГруппаКнопок.Видимость = Истина;
		//КонецЕсли;
		//-- №13770 комментируем
		
	Иначе
		
		//++ №13770 комментируем
		//Элементы.Материалы.ТолькоПросмотр = Истина;
		//Элементы.МатериалыГруппаКнопок.Видимость = Ложь;
		//-- №13770 комментируем
		
		Объект.Продукция.Очистить();
		
