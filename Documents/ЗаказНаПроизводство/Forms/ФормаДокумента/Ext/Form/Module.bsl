Процедура Перекрой(Команда)	
	
	Если Модифицированность Тогда
		Сообщить("Предварительно документ необходимо записать");
	Иначе
		Если Объект.ТекущийСтатус = ПредопределенноеЗначение("Справочник.СтатусыЗаказовНаПроизводство.Произведен") 
			//Начало изменен при переходе на 2.0
			//ИЛИ Объект.ТекущийСтатус = ПредопределенноеЗначение("Справочник.СтатусыЗаказовНаПроизводство.Отгружен")
		Тогда
			//Сообщить("Запрещено осуществлять перекрой в статусах ""Произведен"" и ""Отгружен""!");
			Сообщить("Запрещено осуществлять перекрой в статусах ""Произведен""!");
			//Конец изменен при переходе на 2.0
		Иначе	
			ОП = новый ОписаниеОповещения("ПослеВыбораМатериаловГарпуна", ЭтотОбъект);
			ПараметрыФормы = новый Структура;
			ПараметрыФормы.Вставить("Материалы", ПолучитьМассивМатериаловНаКлиенте());
			ОткрытьФорму("Документ.ЗаказНаПроизводство.Форма.ФормаПерекрой", ПараметрыФормы, ЭтотОбъект, новый УникальныйИдентификатор(),,, ОП);
		КонецЕсли;		
	КонецЕсли;	
КонецПроцедуры

