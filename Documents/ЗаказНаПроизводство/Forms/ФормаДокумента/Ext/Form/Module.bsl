			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	ПодобратьНоменклатуруПродукцияНаСервере();
	Если Объект.ПродукцияНоменклатура.Пустая() Тогда
		Если Вопрос("Подходящая под данный заказ покупателя номенклатура не найдена, создать новую?",РежимДиалогаВопрос.ДаНет) = КодВозвратаДиалога.Да Тогда
			Результат = СоздатьНоменклатуруПродукцияНаСервере();
			Состояние(Результат);
		КонецЕсли;
	КонецЕсли;
	//ЗаменитьНоменклатуруПотолкаВЗаказДоговоре();
КонецПроцедуры

