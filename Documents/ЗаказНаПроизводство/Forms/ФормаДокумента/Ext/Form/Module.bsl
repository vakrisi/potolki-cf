&НаСервере
Процедура ОбновитьДанныеДокумента()
	
	Если НЕ НеУчитыватьСтоимость Тогда
		СуммаДокументаВрем = Объект.Товары.Итог("Сумма") + Объект.Услуги.Итог("Сумма") + Объект.ПродукцияСумма + Объект.Продукция.Итог("Сумма");
		//Если НЕ Объект.СуммаДокумента = СуммаДокументаВрем Тогда
		Объект.СуммаДокумента = СуммаДокументаВрем;
		//КонецЕсли;
		//Элементы.КонтрагентДополнительно.Видимость = Объект.Контрагент.ПоказыватьДопИнформацию;
		ОбщийМодульСервер.ДополнительнаяИнформацияПоКонтрагентуНаФорме(Объект.Контрагент, Элементы.ПоказатьДополнительнуюИнформацию);
		ОбщийМодульСервер.РегулировкаШириныПоляКонтрагента(Элементы, Элементы.Контрагент, Элементы.ПоказатьДополнительнуюИнформацию);
		ОбновитьДолгКонтрагента();
	Иначе
		//Если НЕ Объект.СуммаДокумента = 0 Тогда
		Объект.СуммаДокумента = 0;
		//КонецЕсли;
	КонецЕсли;	
	
	Если Объект.Исполнители.Количество() > 0 тогда
		Элементы.ГруппаИсполнители.Заголовок = "Исполнители ("+Объект.Исполнители.Количество()+")";
	Иначе
		Элементы.ГруппаИсполнители.Заголовок = "Исполнители";
	КонецЕсли;
	Если Объект.ИсполнителиПоОперациям.Количество() > 0 тогда
		Элементы.ГруппаИсполнителиПоОперациям.Заголовок = "Исполнители по операциям ("+Объект.ИсполнителиПоОперациям.Количество()+")";
	Иначе
		Элементы.ГруппаИсполнителиПоОперациям.Заголовок = "Исполнители по операциям";
	КонецЕсли;
	
	ПоказыватьКнопкуУстановитеЦеныРаскроя = Ложь;
	Для каждого ТекущаяСтрока Из Объект.Услуги Цикл
		Если ТекущаяСтрока.Номенклатура.Пустая() Тогда
			ПоказыватьКнопкуУстановитеЦеныРаскроя = Истина;
		КонецЕсли; 
	КонецЦикла; 
	Элементы.УслугиУстановитеЦеныНаУслугиРаскроя.Видимость = ПоказыватьКнопкуУстановитеЦеныРаскроя;
	
	ВидимостьГруппыПродукцияНазначение = Объект.ДокументОснование <> Неопределено 
											И НЕ Объект.ДокументОснование.Пустая()
											И ТипЗнч(Объект.ДокументОснование) = Тип("ДокументСсылка.ЗаказДоговор");
											
	//++ №12232 теперь данные в колонке ТЧ
	//Элементы.ГруппаПродукцияНазначение.Видимость = ВидимостьГруппыПродукцияНазначение;
	Элементы.ПотолокКомната.Видимость = ВидимостьГруппыПродукцияНазначение;
	Элементы.ПотолокНазначение.Видимость = ВидимостьГруппыПродукцияНазначение;
	//-- №12232
	
	Элементы.ТоварыКомната.Видимость = ВидимостьГруппыПродукцияНазначение;
	Элементы.ТоварыНазначение.Видимость = ВидимостьГруппыПродукцияНазначение;
	
	ОбновитьСписокФайлов();
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьВидимостьЭлементов()
	
	Элементы.СкладОтгрузки.Видимость = СкладОтгрузкиПотолоковОтличаетсяОтСкладаГотовойПродукции;
	Элементы.Цех.Видимость = Объект.НесколькоТочекПроизводства;
	
	Если Объект.ВидЗаказа = Перечисления.ВидыЗаказовНаПроизводство.ЗаказНаПродажу 
		ИЛИ Объект.ВидЗаказа = Перечисления.ВидыЗаказовНаПроизводство.Перезаказ Тогда
		Элементы.ГруппаТиповаяПродукция.Видимость = Ложь;
		Элементы.ГруппаПродукция.Видимость = Ложь;
		Элементы.ГруппаМатериалы.Видимость = Ложь;
		Элементы.АдресМонтажа.Видимость = Ложь;
		
		// №14968 Элементы.УДАЛИТЬ_ФормаПеревестиВСтатусВПроизводстве.Доступность = Ложь;
		Элементы.ФормаПеревестиВСтатусПроизведен.Доступность = Ложь;
		
		Если НЕ НеУчитыватьСтоимость Тогда
			Элементы.УслугиРассчитатьЦентровкуШва.Видимость = Ложь;
		КонецЕсли;
		
		Элементы.Склад.Заголовок = "Склад";
		//Элементы.Склад.Заголовок = "Склад                  ";
	ИначеЕсли Объект.ВидЗаказа = Перечисления.ВидыЗаказовНаПроизводство.ТиповоеПроизводство Тогда
		Элементы.ГруппаТиповаяПродукция.Видимость = Истина;
		Элементы.ГруппаПродукция.Видимость = Ложь;
		Элементы.ГруппаМатериалы.Видимость = Истина;
		Элементы.АдресМонтажа.Видимость = Истина; //Ложь; #10898
		
		// №14968 Элементы.УДАЛИТЬ_ФормаПеревестиВСтатусВПроизводстве.Доступность = Истина;
		Элементы.ФормаПеревестиВСтатусПроизведен.Доступность = Истина;
		
		Если НЕ НеУчитыватьСтоимость Тогда
			Элементы.УслугиРассчитатьЦентровкуШва.Видимость = Ложь;
		КонецЕсли;
		
		Элементы.ЗаполнитьМатериалыПоФактуре.Видимость = Ложь;
		Элементы.МатериалыЗаполнитьМатериалыПоСпецификациям.Видимость = Истина;
		Элементы.МатериалыДобавитьРулонПоНомеру.Видимость = Ложь;
		Элементы.МатериалыГруппаЗаменитьМатериалы.Видимость = Ложь;
		
		Элементы.Склад.Заголовок = "Склад";
		//Элементы.Склад.Заголовок = "Склад                 ";		
	Иначе
		Элементы.ГруппаТиповаяПродукция.Видимость = Ложь;
		Элементы.ГруппаПродукция.Видимость = Истина;
		Элементы.ГруппаМатериалы.Видимость = Истина;
		Элементы.АдресМонтажа.Видимость = Истина;
		
		// №14968 Элементы.УДАЛИТЬ_ФормаПеревестиВСтатусВПроизводстве.Доступность = Истина;
