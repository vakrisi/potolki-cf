#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ВключитьПредпросмотрФайлов = НЕ Константы.ВыключитьПредпросмотрПрикрепленныхФайловВДокументах.Получить();
	Элементы.ГруппаФайлыПредпросмотр.Видимость = ВключитьПредпросмотрФайлов;
	
	СкладОтгрузкиПотолоковОтличаетсяОтСкладаГотовойПродукции = Константы.СкладОтгрузкиПотолоковОтличаетсяОтСкладаГотовойПродукции.Получить();
	
	Если Параметры.Ключ.Пустая() Тогда
		
		Объект.ВидЗаказа = Параметры.ВидЗаказа;
		Если Объект.ВидЗаказа.Пустая() Тогда
			Объект.ВидЗаказа = Перечисления.ВидыЗаказовНаПроизводство.ТиповоеПроизводство;
		КонецЕсли;
		
	Иначе
		ЭтаФорма.ТолькоПросмотр = ПраваПользователей.ДокументТолькоПросмотр(Объект.Ссылка);
		
	КонецЕсли;
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	СофтФонСервер.ПриСозданииНаСервере(ЭтотОбъект);
	МессенджерыСервер.ПриСозданииНаСервере(ЭтотОбъект, Элементы.ГруппаКонтрагентКПМессенджеры);

	//Если ПравоДоступа("Добавление", Метаданные.Документы.ВозвратПродукции)
	//	И Элементы.ПодменюСоздатьНаОсновании.ПодчиненныеЭлементы.Количество() > 5 Тогда
	//	Элементы.Переместить(Элементы.ФормаОформитьВыпускПродукции, Элементы.ПодменюСоздатьНаОсновании, Элементы.ПодменюСоздатьНаОсновании.ПодчиненныеЭлементы[5]);
	//КонецЕсли;
	
	//++ №6687 теперь способ определяется в документе
	//Если Константы.РасчетЗарплатыПроизводстваПоОперациям.Получить() Тогда
	//Если Объект.СпособНачисленияВыработки = Перечисления.СпособыНачисленияВыработки.ПроизводственныеОперации Тогда
	////-- №6687
	//	Элементы.ГруппаИсполнителиПоОперациям.Видимость = Истина;
	//	Элементы.ГруппаИсполнители.Видимость = Ложь;
	//Иначе
	//	Элементы.ГруппаИсполнителиПоОперациям.Видимость = Ложь;
	//	Элементы.ГруппаИсполнители.Видимость = Истина;
	//КонецЕсли;
	
	Если НЕ Константы.ИспользоватьПроизводственныеБригады.Получить() Тогда
		Элементы.Бригада.Видимость = Ложь;
	КонецЕсли;
	
	РеквизитыПользователя = ОбщийМодульСервер.НастройкиПользователя("ДополнительныеПраваЗапретРедактированияЦенВДокументах, 
																	|ДополнительныеПраваЗапретПримененияСкидок,
																	|РазрешеноРедактироватьПроизведенныеЗаказыНаПроизводство,
																	|РазрешеноМенятьСпособНачисленияВыработкиВДокументеЗаказНаПроизводство");

	// №6687
	Элементы.СпособНачисленияВыработки.Доступность = РеквизитыПользователя.РазрешеноМенятьСпособНачисленияВыработкиВДокументеЗаказНаПроизводство;
	
	
	РазрешеноРедактироватьПроизведенныеЗаказыНаПроизводство = РеквизитыПользователя.РазрешеноРедактироватьПроизведенныеЗаказыНаПроизводство;
	
	ОбновитьДанныеДокумента();
	ОбновитьВидимостьЭлементов();
	ОбновитьСписокФайлов();
	ЗаполнитьДанныеКОтгрузкеИОстаткиПоТоварам();
	ЗаполнитьДанныеКОтгрузкеИОстаткиПоПродукции();
	ЗаполнитьДанныеОстаткиПоМатериалам();
	
	//управление доступностью элементов
	Если РеквизитыПользователя.ДополнительныеПраваЗапретРедактированияЦенВДокументах Тогда
		МассивИменЭлементов = Документы.ЗаказНаПроизводство.ПолучитьМассивРеквизитовПоЦенам();
		ОбщийМодульКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы, МассивИменЭлементов, "ТолькоПросмотр", Истина);
	КонецЕсли;
	//#7771
	Если РеквизитыПользователя.ДополнительныеПраваЗапретПримененияСкидок Тогда
		МассивИменЭлементов = Документы.ЗаказНаПроизводство.ПолучитьМассивРеквизитовПоСкидкам();
		ОбщийМодульКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы, МассивИменЭлементов, "ТолькоПросмотр", Истина);
	КонецЕсли;
		
	ИсходныйСтатус = Объект.ТекущийСтатус;
	
	Элементы.ПодменюПечать.Доступность = ПраваПользователей.ДоступностьПечати(Объект.Ссылка);
	ПраваПользователей.УстановитьТолькоПросмотрДляРеквизитаНомер(Элементы.Номер.ТолькоПросмотр);
	
	ПродукцияНоменклатураКоличествоПредыдущееЗначение = Объект.ПродукцияНоменклатураКоличество;
	
	ОбновитьДоступностьНастройкиОтгрузкаРазрешена();
	
	Если Объект.Проведен Тогда
		ЭтаФорма.ИспользоватьРежимПроведения=ИспользованиеРежимаПроведения.Неоперативный;
	КонецЕсли;
	
	ОснованиеЗаказПокупателя = ТипЗнч(Объект.ДокументОснование) = Тип("ДокументСсылка.ЗаказПокупателя");
	//Элементы.ФормаПечатьЗаказаПокупателя.Видимость  = ОснованиеЗаказПокупателя;
	Элементы.ГруппаТоварыЗаказаПокупателя.Видимость = ОснованиеЗаказПокупателя;
	// #15716 Динамический список в Таблицу значений
	//ТоварыЗаказаПокупателя.Параметры.УстановитьЗначениеПараметра("СсылкаНаЗаказПокупателя", ?(ОснованиеЗаказПокупателя, Объект.ДокументОснование, Документы.ЗаказПокупателя.ПустаяСсылка()));
	ОбщийМодульСервер.ЗаполнитьТоварыЗаказаПокупателя(ТоварыЗаказаПокупателя, Объект.ДокументОснование);
	
	//Начало добавлен при переходе на 2.0
	//Приведем реквизит ДокументОснование к типу для выбора Заказ Покупателя	
	ОписаниеТипов = новый ОписаниеТипов("ДокументСсылка.ЗаказПокупателя");	
	
	Элементы.ДокументОснование.ОграничениеТипа = ОписаниеТипов;	
	Элементы.ДокументОснование.ОграничениеТипа.ПривестиЗначение(Элементы.ДокументОснование);
	//Конец добавлен при переходе на 2.0
	
	УстановитьВидимостьПоИнтеркампаниИВнутреннемуЗаказу();
	
	// Видимость колонки Артикул
	МассивЭлементов = новый Массив();
	МассивЭлементов.Добавить("ПродукцияНоменклатураАртикул");
	МассивЭлементов.Добавить("УслугиНоменклатураАртикул");
	МассивЭлементов.Добавить("МатериалыНоменклатураАртикул");
	МассивЭлементов.Добавить("ТоварыНоменклатураАртикул");
	//МассивЭлементов.Добавить("ТоварыЗаказаПокупателяНоменклатураАртикул");
	ОбщийМодульСервер.УстановитьВидимостьКолонкиАртикулВТабличнойЧасти(ЭтаФорма, МассивЭлементов);
	
	//Если Документы.ЗаказНаПроизводство.ЕстьВыпускПоЗаказу(Объект.Ссылка) Тогда
	Если Объект.ТекущийСтатус = ПредопределенноеЗначение("Справочник.СтатусыЗаказовНаПроизводство.Произведен")
		И НЕ РазрешеноРедактироватьПроизведенныеЗаказыНаПроизводство Тогда
		//ЕстьВыпускПоЗаказу = Истина;
		ПеревестиФормуВТолькоПросмотр(Истина);
		//Сообщить("По документу имеется проведенный выпуск продукции, документ находится в режиме просмотра");
		Сообщить("Документ в статусе ""Произведен"": находится в режиме просмотра");
	КонецЕсли;
	
	// №6283 видимость колонок и расчет процента в ТЧ ИсполнителиПоОперациям
	ОбщийМодульСервер.УстановитьВидимостьКолонокВТабличнойЧастиИсполнителиПоОперациям(ЭтаФорма);
	ПересчитатьПроцентУчастияИсполнителейПоОперациям();
	ПересчитатьПроцентУчастияКТУИсполнителей();
	
	ВидСпецификацииПоУмолчанию = Перечисления.ВидыСпецификации.СпецификацияПродукции;
	
	ФинансыСервер.ОбновитьВидимостьИКурсВалюты(ЭтотОбъект);
	
	ВремРучнаяКорректировкаМатериалов = Объект.РучнаяКорректировкаМатериалов; // №14311
	
	ОбщийМодульСервер.УстановитьВидимостьПодразделения(ЭтотОбъект);
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	ДатыЗапретаИзменения.ОбъектПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ВидЗаказаПриИзмененииНаСервере();
	ОповеститьОбИзменении(Объект.ПродукцияНоменклатура);
	ОбновитьДанныеДокумента();
	
	//проверка соответствия заказа на производство заказу покупателя, если он указан в основании
	Если НЕ Объект.Ссылка.Пустая() 
		И Объект.Проведен                                                                                       //#14923
		И НЕ Объект.ТекущийСтатус = ПредопределенноеЗначение("Справочник.СтатусыЗаказовНаПроизводство.Отменен") //#14923
		И ТипЗнч(Объект.ДокументОснование) = Тип("ДокументСсылка.ЗаказПокупателя")
		И НЕ Объект.ДокументОснование.Пустая()
		//#14923
		И ОбщийМодульВызовСервера.ЗаказНаПроизводствоСвязанСЗаказомПокупателя(Объект.Ссылка)
		Тогда
		
		ВыполнитьПроверкуСоответствияЗаказуПокупателя("ПриОткрытии");
		
	Иначе
		ЗаблокироватьОбъект();			
	КонецЕсли;
	
	ВывестиПотолокВТабличнойЧасти(); // №12232

КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	Если НеВыполнятьПроверкуПередЗаписью Тогда
		НеВыполнятьПроверкуПередЗаписью = Ложь;
		Возврат;
	КонецЕсли;
	
	Если ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
		ВыполнитьПроверкиИЗадатьВопросыПередЗаписью(Отказ, ПараметрыЗаписи);
	КонецЕсли;
	
	ОбщийМодульКлиент.ЗаписатьОбъектПриНеобходимости(ЭтотОбъект, ПараметрыЗаписи, Отказ);
		
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	Если Объект.ВидЗаказа = Перечисления.ВидыЗаказовНаПроизводство.ЗаказНаПродажу
		ИЛИ Объект.ВидЗаказа = Перечисления.ВидыЗаказовНаПроизводство.Перезаказ Тогда
		Объект.ПродукцияСумма = 0;
	КонецЕсли;
	
	ОбновитьДанныеДокумента();
	
	Если ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.Проведение И Объект.НесколькоТочекПроизводства И Объект.Цех.Пустая() Тогда
		Отказ = Истина;
		ТекстОшибки = НСтр("ru='Следует заполнить поле ""Цех""'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки, Объект.Ссылка, "Цех", , Отказ);
	КонецЕсли;
	
	Если НЕ Объект.Ссылка.Пустая() Тогда
		//проверим сколько отгружено по заказу. Если отгружено больше чем заказано в заказе - отказываем в проведении (защита от удаления товаров из заказа после его отгрузки)
		//в регистре заказы покупателей получим все расходы где участвует данный заказ
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|		ЗаказыПокупателейОбороты.Номенклатура,
		|		ЕСТЬNULL(ЗаказыПокупателейОбороты.КоличествоРасход, 0) КАК Отгружено	
		|	ИЗ
		|		РегистрНакопления.ЗаказыПокупателей.Обороты(, , , ЗаказНаПроизводство = &ДокументЗаказ) КАК ЗаказыПокупателейОбороты";
		Запрос.УстановитьПараметр("ДокументЗаказ", Объект.Ссылка);
			
		//создадим временную таблицу куда поместим все товары, услуги, продукцию, потолкок
		Временная_ТЗ = новый ТаблицаЗначений;
		Временная_ТЗ.Колонки.Добавить("Номенклатура",,"Номенклатура");	
		Временная_ТЗ.Колонки.Добавить("Количество",,"Количество");
		
		//поместим товары
		Для Каждого ТекСтрока Из Объект.Товары Цикл
			НоваяСтрока = Временная_ТЗ.Добавить();
			НоваяСтрока.Номенклатура = ТекСтрока.Номенклатура;
			НоваяСтрока.Количество = ТекСтрока.Количество * ТекСтрока.Коэффициент;
		КонецЦикла;	
		
		//поместим услуги
		Для Каждого ТекСтрока Из Объект.Услуги Цикл
			НоваяСтрока = Временная_ТЗ.Добавить();
			НоваяСтрока.Номенклатура = ТекСтрока.Номенклатура;
			НоваяСтрока.Количество = ТекСтрока.Количество * ТекСтрока.Коэффициент;
		КонецЦикла;	
		
		//поместим продукцию
		Для Каждого ТекСтрока Из Объект.Продукция Цикл
			НоваяСтрока = Временная_ТЗ.Добавить();
			НоваяСтрока.Номенклатура = ТекСтрока.Номенклатура;
			НоваяСтрока.Количество = ТекСтрока.Количество * ТекСтрока.Коэффициент;
		КонецЦикла;
		
		//поместим потолок
		Если НЕ Объект.ПродукцияНоменклатура.Пустая() Тогда
			НоваяСтрока = Временная_ТЗ.Добавить();
			НоваяСтрока.Номенклатура = Объект.ПродукцияНоменклатура;
			НоваяСтрока.Количество = Объект.ПродукцияНоменклатураКоличество * Объект.ПродукцияНоменклатураКоэффициент;
		КонецЕсли;
		
		//свернем временную таблицу со всеми товарами, услугами, продукцией, потолками
		Временная_ТЗ.Свернуть("Номенклатура", "Количество");
		
		//теперь пройдемся по всем полученным расходным движениям и 
		//если количество расход больше текущего количества в заказе, отказ в проведении
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			//нужно найти номенлатуру во временной ТЗ
			СтруктураПоиска = новый Структура;
			СтруктураПоиска.Вставить("Номенклатура", Выборка.Номенклатура);
			НайденноеЗначение = Временная_ТЗ.НайтиСтроки(СтруктураПоиска);
			
			Если НайденноеЗначение.Количество() = 0 Тогда
				//в расходе есть а в текущем заказе нет, отказ			
				Сообщить("По данному заказу номенклатуры """ + Выборка.Номенклатура + """ отгружено на " + Выборка.Отгружено + " ед. больше, чем заказано.");
				Если ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
					Отказ = Истина;
				КонецЕсли;			
			Иначе
				Перегруз = Выборка.Отгружено - НайденноеЗначение[0].Количество;
				Если Перегруз > 0 Тогда
					Сообщить("По данному заказу номенклатуры """ + Выборка.Номенклатура + """ отгружено на " + Перегруз + " ед. больше, чем заказано.");
					
					Если ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
						Отказ = Истина;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;	
		КонецЦикла; 
		
		Если Отказ Тогда
			Сообщить("Документ не проведен");
			Возврат;
		КонецЕсли;
	КонецЕсли;	
	
	//++ №14311 контроль материалов в производстве по документу настройки
	Если ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.Проведение
		И ТипЗнч(Объект.ДокументОснование) = Тип("ДокументСсылка.ЗаказПокупателя")
		И ЗначениеЗаполнено(Объект.ДокументОснование)
		И НЕ Объект.РучнаяКорректировкаМатериалов
	Тогда
		
		// из заказа покупателя, возьмем только те материалы, которые относятся к продукции ЗнП
