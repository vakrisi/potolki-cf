&НаСервере
Функция ЭтоЗаказНаПроизводствоПотолка(ЗаказНаПроизводство)
	
	Результат = Ложь;
	
	Если ТипЗнч(ЗаказНаПроизводство) = Тип("ДокументСсылка.ЗаказНаПроизводство") Тогда
		Если ЗаказНаПроизводство.ВидЗаказа = Перечисления.ВидыЗаказовНаПроизводство.ПроизводствоПотолка Тогда
			Результат = Истина;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ПослеВопросаОПерезаполненииВыпуска(Результат, Параметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		//пользователь согласился с перезаполнением документа
		ПараметрыОповещенияПослеЗакрытия = Новый Структура;
		ПараметрыОповещенияПослеЗакрытия.Вставить("Дата", Параметры.Дата);
		ПараметрыОповещенияПослеЗакрытия.Вставить("Номер", Параметры.Номер);
		ПараметрыОповещенияПослеЗакрытия.Вставить("ИмяСписка", Параметры.ИмяСписка);
		ПараметрыОповещенияПослеЗакрытия.Вставить("Основание", Параметры.Основание);				
		ПараметрыОповещенияПослеЗакрытия.Вставить("Ключ", Параметры.Ключ);
		ОткрытьФорму("Документ.ВыпускПродукции.Форма.ФормаДокумента", Параметры,,,,,Новый ОписаниеОповещения("ПослеСозданияДокументаВыпуска",ЭтаФорма,ПараметрыОповещенияПослеЗакрытия));
	Иначе
		//пользователь отказался
		ПоказатьПредупреждение(,"Выпуск должен соответствовать заказу");
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ВыпускСоответствуетЗаказу(Выпуск, Заказ)
	
	Если Заказ.ВидЗаказа = Перечисления.ВидыЗаказовНаПроизводство.ПроизводствоПотолка Тогда
		Если Выпуск.ПродукцияНоменклатура = Заказ.ПродукцияНоменклатура
			и Выпуск.ПродукцияНомерРасчета = Заказ.ПродукцияНомерРасчета Тогда
			Возврат Истина;
		Иначе
			Возврат Ложь;
		КонецЕсли;
	Иначе
		ТаблицаВыпуска = Выпуск.Продукция.Выгрузить();
		ТаблицаВыпуска.Свернуть("Номенклатура, ЕдиницаИзмерения","Количество");
		ТаблицаВыпуска.Сортировать("Номенклатура Возр, ЕдиницаИзмерения Возр, Количество Возр");
		ТаблицаЗаказа = Заказ.Продукция.Выгрузить();
		ТаблицаЗаказа.Свернуть("Номенклатура, ЕдиницаИзмерения","Количество");
		ТаблицаЗаказа.Сортировать("Номенклатура Возр, ЕдиницаИзмерения Возр, Количество Возр");
		Если НЕ ТаблицаВыпуска.Количество() = ТаблицаЗаказа.Количество() Тогда
			Возврат Ложь;
		Иначе
			Для НомерСтроки = 0 По ТаблицаВыпуска.Количество()-1 Цикл
				Если НЕ ТаблицаВыпуска[НомерСтроки].Номенклатура = ТаблицаЗаказа[НомерСтроки].Номенклатура
					ИЛИ НЕ ТаблицаВыпуска[НомерСтроки].ЕдиницаИзмерения = ТаблицаЗаказа[НомерСтроки].ЕдиницаИзмерения
					ИЛИ НЕ ТаблицаВыпуска[НомерСтроки].Количество = ТаблицаЗаказа[НомерСтроки].Количество Тогда
						Возврат Ложь;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		ВозВрат Истина;
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Процедура ПослеСозданияДокументаВыпуска(Результат, Параметры) Экспорт
	
	Заказ = Параметры.Основание;
	Выпуск = НайтиДокументВыпускаПродукции(Параметры.Основание);
	
	Если Выпуск = Неопределено или Выпуск = ПредопределенноеЗначение("Документ.ВыпускПродукции.ПустаяСсылка") Тогда
		ПоказатьПредупреждение(,"Перевод в статус ""Произведен"" отменен - нет документа выпуска");
	ИначеЕсли ВыпускСоответствуетЗаказу(Выпуск, Заказ) Тогда
		Номер = "";
		Дата = "";
		ИмяСписка = "";
		Параметры.Свойство("Номер",Номер);
		Параметры.Свойство("Дата",Дата);
		Параметры.Свойство("ИмяСписка",ИмяСписка);
		Если Не Номер = "" и НЕ Дата = ""и НЕ ИмяСписка = "" Тогда
			ОбщийМодульВызовСервера.ИзменитьСтатусЗаказаНаПроизводствоНаПроизведен(, Номер, Дата);
			Элементы[ИмяСписка].Обновить();
		КонецЕсли;
	Иначе
		ПоказатьПредупреждение(,"Заказ на производство не может быть переведен в статус ""Произведен"", т.к. выпуск не полностью соответствует заказу");
	КонецЕсли;
	
	Оповестить("ЗаписанЗаказНаПроизводство",Заказ,"ЗаказНаПроизводство");
				
КонецПроцедуры

&НаСервере
Функция ПолучитьССылкуНаЗаказНаПроизводство(Номер, Дата)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЗаказНаПроизводство.Ссылка
	|ИЗ
	|	Документ.ЗаказНаПроизводство КАК ЗаказНаПроизводство
	|ГДЕ
	|	ЗаказНаПроизводство.Номер = &Номер
	|	И ЗаказНаПроизводство.Дата = &Дата";
	Запрос.УстановитьПараметр("Номер",Номер);
	Запрос.УстановитьПараметр("Дата",Дата);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Возврат Выборка.Ссылка;
	КонецЦикла;

	
КонецФункции

&НаСервере
Функция ЕстьДокументВыпускаПоЭтомуЗаказу(СсылкаНаЗаказНаПроизводство)
	Результат = Ложь;
	НайденныйДокументВыпуска = НайтиДокументВыпускаПродукции(СсылкаНаЗаказНаПроизводство);
	Если НайденныйДокументВыпуска = Документы.ВыпускПродукции.ПустаяСсылка() Тогда
		Результат = Ложь;
	Иначе
		Результат = Истина;
	КонецЕсли;
	Возврат Результат;
КонецФункции

&НаСервере 
Функция НайтиДокументВыпускаПродукции(СсылкаНаЗаказНаПроизводство)
	
	Результат = Документы.ВыпускПродукции.ПустаяСсылка();
	
	Если СсылкаНаЗаказНаПроизводство.ВидЗаказа = Перечисления.ВидыЗаказовНаПроизводство.ПроизводствоПотолка Тогда
		//подберем последний документ выпуска продукции по данному заказу на производство
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЗаказыНаПроизводствоОбороты.Регистратор
		|ИЗ
		|	РегистрНакопления.ЗаказыНаПроизводство.Обороты(, , Регистратор, ЗаказНаПроизводство = &ЗаказНаПроизводство) КАК ЗаказыНаПроизводствоОбороты
		|ГДЕ
		|	ЗаказыНаПроизводствоОбороты.КоличествоРасход > 0
		|	И ЗаказыНаПроизводствоОбороты.ЗаказНаПроизводство.ПродукцияНоменклатура = &ПродукцияНоменклатура";
		Запрос.УстановитьПараметр("ЗаказНаПроизводство",СсылкаНаЗаказНаПроизводство);
		Запрос.УстановитьПараметр("ПродукцияНоменклатура",СсылкаНаЗаказНаПроизводство.ПродукцияНоменклатура);
		
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			ВыпускПродукции = Выборка.Регистратор;
			Результат = Выборка.Регистратор;
		КонецЦикла;
	Иначе
		//подберем последний документ выпуска продукции по данному заказу на производство
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЗаказыНаПроизводствоОбороты.Регистратор
		|ИЗ
		|	РегистрНакопления.ЗаказыНаТиповоеПроизводство.Обороты(, , Регистратор, ЗаказНаПроизводство = &ЗаказНаПроизводство) КАК ЗаказыНаПроизводствоОбороты
		|ГДЕ
		|	ЗаказыНаПроизводствоОбороты.КоличествоРасход > 0";
		Запрос.УстановитьПараметр("ЗаказНаПроизводство",СсылкаНаЗаказНаПроизводство);
		
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			ВыпускПродукции = Выборка.Регистратор;
			Результат = Выборка.Регистратор;
		КонецЦикла;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ЕстьНеПроведенныйДокументВыпускаПоЭтомуЗаказу(СсылкаНаЗаказНаПроизводство)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВыпускПродукции.Ссылка
	|ИЗ
	|	Документ.ВыпускПродукции КАК ВыпускПродукции
	|ГДЕ
	|	ВыпускПродукции.Основание = &СсылкаНаЗаказНаПроизводство
	|	И НЕ ВыпускПродукции.ПометкаУдаления
	|	И НЕ ВыпускПродукции.Проведен";
	Запрос.УстановитьПараметр("СсылкаНаЗаказНаПроизводство",СсылкаНаЗаказНаПроизводство);
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда 
		Возврат Документы.ВыпускПродукции.ПустаяСсылка();
	Иначе
		ВыборкаЗапроса = РезультатЗапроса.Выбрать();
		Пока ВыборкаЗапроса.Следующий() Цикл
			Возврат ВыборкаЗапроса.Ссылка;
		КонецЦикла;
	КонецЕсли;
	
КонецФункции

