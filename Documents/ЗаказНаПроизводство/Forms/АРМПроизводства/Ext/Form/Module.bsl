&НаСервереБезКонтекста
Процедура УстановитьГалочкуНачалиПроизводствоВДокументеЗаказНаПроизводство(ДокументСсылка)
	
	Если НЕ Константы.АвтоматическиУстанавливатьГалочкуНачалиПроизводствоВДокументеЗаказНаПроизводство.Получить() Тогда
		Возврат;
	КонецЕсли;
	
	Если ДокументСсылка.НачалиПроизводство Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		
		ДокументОбъект = ДокументСсылка.ПолучитьОбъект();
		
		ДокументОбъект.НачалиПроизводство = Истина;
		
		ДокументОбъект.Записать(); // Просто запись, т.к. на движения не влияет
		
	Исключение
		
		Сообщить(СтрШаблон("Не удалось автоматически установить галочу ""Начали производство"" по %1: %2", ДокументСсылка, ОписаниеОшибки()));
		
	КонецПопытки;
	
КонецПроцедуры
