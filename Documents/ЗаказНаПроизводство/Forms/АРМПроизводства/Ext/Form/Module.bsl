&НаКлиенте
Процедура ОтправитьНаДругойСклад(Команда)
	
	//Начало изменен при переходе на 2.0
	//Если Элементы.Группа1.ТекущаяСтраница.Имя = "ГруппаПроизведено" Тогда
	//	ИмяСписка = "СписокПроизведено";
	ИмяСписка = "СписокВсе";
	//Иначе
	//	Возврат;
	//КонецЕсли;
	//Конец изменен при переходе на 2.0
	
	Если Элементы[ИмяСписка].ВыделенныеСтроки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	СписокОснований = Новый СписокЗначений;
	Для НомерСтроки = 0 По Элементы[ИмяСписка].ВыделенныеСтроки.Количество()-1 Цикл
		СписокОснований.Добавить(Элементы[ИмяСписка].ВыделенныеСтроки.Получить(НомерСтроки));
	КонецЦикла;
	
	Если НЕ ПроверитьВозможностьПеремещенияПоОрганизациям(СписокОснований) Тогда
		ПоказатьПредупреждение(,"Следует выбрать заказы на производство по одной органиации");
		Возврат;
	КонецЕсли;
	
	Если НЕ ПроверитьВозможностьПеремещенияПоСкладам(СписокОснований) Тогда
		ПоказатьПредупреждение(,"Следует выбрать заказы на производство по одному складу");
		Возврат;
	КонецЕсли;
	
	Если НЕ СтатусПроизведенПоСпискуЗаказов(СписокОснований) Тогда
		ПоказатьПредупреждение(,"Следует выбрать заказы на производство в статусе ""Произведен""");
		Возврат;
	КонецЕсли;
	
	ПараметрыНовойФормы = Новый Структура;
	РеквизитыЗНП = РеквизитыЗаказаНаПроизводство(СписокОснований.Получить(0).Значение);
	ПараметрыНовойФормы.Вставить("СписокТоваров", 	 ПолучитьСписокТоваровДляПеремещения(СписокОснований)); 
	ПараметрыНовойФормы.Вставить("Организация", 	 РеквизитыЗНП.Организация); 
	ПараметрыНовойФормы.Вставить("СкладОтправитель", РеквизитыЗНП.Склад); 
	ПараметрыНовойФормы.Вставить("СкладПолучатель",  РеквизитыЗНП.СкладОтгрузки); 
	ОткрытьФорму("Документ.ЗаказНаПроизводство.Форма.ФормаОтправкиНаДругойСклад", ПараметрыНовойФормы, ЭтаФорма,,ВариантОткрытияОкна.ОтдельноеОкно,,,);
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьНачалиПроизводство(Команда)
	//Начало изменен при переходе на 2.0
	//Если Элементы.Группа1.ТекущаяСтраница.Имя = "ГруппаВПроизводстве" Тогда
		УстановитьНачалиПроизводствоНаСервере();
		Элементы.СписокВсе.Обновить();
	//КонецЕсли;	
	//Конец изменен при переходе на 2.0
КонецПроцедуры

&НаСервере
Процедура УстановитьНачалиПроизводствоНаСервере()
	
	//Начало изменен при переходе на 2.0
	//ВыделенныеСтроки = Элементы.СписокВПроизводстве.ВыделенныеСтроки;
	ВыделенныеСтроки = Элементы.СписокВсе.ВыделенныеСтроки;
	//Конец изменен при переходе на 2.0
	НачатьТранзакцию();
	Для Каждого ТекСтрока из ВыделенныеСтроки Цикл	
		
		//Начало добавлен при переходе на 2.0
		Если ТекСтрока.ТекущийСтатус <> Справочники.СтатусыЗаказовНаПроизводство.ВПроизводстве Тогда
			Сообщить("При установке галочки ""Начали производство"" был пропущен " + ТекСтрока.Ссылка + ", т.к. его статус не ""В производстве""");
			Продолжить;
		КонецЕсли;	
		//Конец добавлен при переходе на 2.0
		
		ДокументОбъект = ТекСтрока.Ссылка.ПолучитьОбъект();
		ДокументОбъект.НачалиПроизводство = Истина;		
		
		Попытка
			ДокументОбъект.Записать();
		Исключение
			Сообщить("Не удалось записать документ " + ТекСтрока.Ссылка + " при установке галочки ""Начали производство""");
		КонецПопытки;
			
	КонецЦикла;	
	ЗафиксироватьТранзакцию();
	//Начало изменен при переходе на 2.0
	//Элементы.СписокВПроизводстве.Обновить();
	//Элементы.СписокВсе.Обновить();
	//Конец изменен при переходе на 2.0
		
КонецПроцедуры

&НаКлиенте
Процедура ОтправитьВсеВложенныеФайлыЗНПНаПринтер(Команда)
	
	Для НомерСтроки = 0 По Элементы.СписокВсе.ВыделенныеСтроки.Количество()-1 Цикл
		
		Заказ = Элементы.СписокВсе.ВыделенныеСтроки.Получить(НомерСтроки);
		
		//++ №13833 унифицируем, чтобы из формы документа ЗнП можно было вызывать
		//ФайлыЗаказа = ПолучитьМассивФайловЗНП(Заказ);
		//
		//Для Каждого ДанныеФайла Из ФайлыЗаказа Цикл
		//	
