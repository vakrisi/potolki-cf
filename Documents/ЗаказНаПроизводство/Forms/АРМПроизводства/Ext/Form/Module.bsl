&НаКлиенте
Процедура ПеревестиВСтатусВПроизводстве(Команда)
	
	ИзменитьСтатусЗаказовНаПроизводство("ПослеВопросаИзменитьСтатусЗаказовНаПроизводствоНаВПроизводстве", "В производстве");
	
КонецПроцедуры

&НаКлиенте
Процедура ПеревестиВСтатусПроизведен(Команда)
	
	ИзменитьСтатусЗаказовНаПроизводство("ПослеВопросаИзменитьСтатусЗаказовНаПроизводствоНаПроизведен", "Произведен", Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьСтатусЗаказовНаПроизводство(ИмяПроцедурыПослеВопроса, СтатусТекстом, ЗадаватьВопрос = Истина)

	ОчиститьСообщения();
	
	ИмяСписка = "СписокВсе";
	МассивЗаказов = Новый Массив;
	
	Если Элементы[ИмяСписка].ВыделенныеСтроки.Количество() = 0 Тогда
		Сообщить("Нет выделенных заказов");
		Возврат;
	КонецЕсли;
	
	Для НомерСтроки = 0 По Элементы[ИмяСписка].ВыделенныеСтроки.Количество()-1 Цикл			
		МассивЗаказов.Добавить(Элементы[ИмяСписка].ВыделенныеСтроки.Получить(НомерСтроки)); 
	КонецЦикла;	
		
	ДополнительныеПараметры = Новый Структура("МассивЗаказов", МассивЗаказов);
	ОписаниеОповещения = Новый ОписаниеОповещения(ИмяПроцедурыПослеВопроса, ЭтотОбъект, ДополнительныеПараметры);
	Если ЗадаватьВопрос Тогда
		ТекстСообщения = "Перевести выбранные заказы в количестве " + МассивЗаказов.Количество() + " шт. в статус """ + СтатусТекстом + """? 
		|Документы будут автоматически записаны.";
		ПоказатьВопрос(ОписаниеОповещения, ТекстСообщения, РежимДиалогаВопрос.ДаНет);
	Иначе
		Результат = КодВозвратаДиалога.Да;
		Выполнить(ИмяПроцедурыПослеВопроса + "(Результат, ДополнительныеПараметры);");
	КонецЕсли;
				
КонецПроцедуры

&НаКлиенте
Процедура ПослеВопросаИзменитьСтатусЗаказовНаПроизводствоНаВПроизводстве(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли;
	
	МассивЗаказов = ДополнительныеПараметры.МассивЗаказов;
	Для каждого СсылкаЗаказ из МассивЗаказов Цикл
		Если Не ДокументПроведен(СсылкаЗаказ) Тогда
			ПоказатьПредупреждение(,"Не все выбранные заказы проведены. Перед изменением статуса документа, его следует провести");
			Возврат;
		Иначе			
			ПеревестиЗаказНаПроизводствоВСтатусВПроизводстве(СсылкаЗаказ);
			Оповестить("ЗаписанЗаказНаПроизводство", СсылкаЗаказ, "ЗаказНаПроизводство");	
		КонецЕсли;
	КонецЦикла;
	Элементы.СписокВсе.Обновить();
	ПоказатьОповещениеПользователя("Выполнено");
		
КонецПроцедуры

