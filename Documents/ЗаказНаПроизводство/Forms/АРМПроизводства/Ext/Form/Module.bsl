Процедура ОформитьЗаказНаПроизводство(Команда)
	
	КоличествоЗаказов = Элементы.СписокЗаказыПокупателей.ВыделенныеСтроки.Количество();
	Если КоличествоЗаказов = 0 Тогда
		Сообщить("Нет выделенных заказов!");
		Возврат;
	КонецЕсли;
	
	//#9376	
	МассивСсылок = Новый Массив;
	Для НомерСтроки = 0 По КоличествоЗаказов - 1 Цикл
		СсылкаЗаказ = Элементы.СписокЗаказыПокупателей.ВыделенныеСтроки.Получить(НомерСтроки);
		МассивСсылок.Добавить(СсылкаЗаказ);
	КонецЦикла;
	ПараметрыВыполнения = Новый Структура("ЭтоФормаОбъекта", Ложь);
	ДополнительныеПараметры = Новый Структура;
	ПараметрыВыполнения.Вставить("ОписаниеКоманды", Новый Структура("ДополнительныеПараметры", ДополнительныеПараметры));
	СозданиеНаОснованииПотолкиКлиент.ЗаказНаПроизводствоСоздатьНаОснованииЗаказаПокупателя(МассивСсылок, ПараметрыВыполнения);
		
