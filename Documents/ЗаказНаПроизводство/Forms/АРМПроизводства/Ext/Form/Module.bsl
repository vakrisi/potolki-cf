			ОтборЦех = НастройкаОтбора.ПравоеЗначение;
			
		// #16544 отбор убран
		//ИначеЕсли НастройкаОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Автор") Тогда
		//	ОтборАвтор = НастройкаОтбора.ПравоеЗначение;
			
		ИначеЕсли НастройкаОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Контрагент") Тогда
			ОтборКонтрагент = НастройкаОтбора.ПравоеЗначение;
			
		ИначеЕсли НастройкаОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("СтатусДоставки") Тогда
			ОтборСтатусДоставкиНаСкладОтгрузки = НастройкаОтбора.ПравоеЗначение;
			
		ИначеЕсли НастройкаОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("НомерПотолка") Тогда
			ОтборНомерПотолка = НастройкаОтбора.ПравоеЗначение;
			
		ИначеЕсли НастройкаОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("НачалиПроизводство") Тогда
			ОтборНачалиПроизводство = НастройкаОтбора.ПравоеЗначение;
			
		ИначеЕсли НастройкаОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("АдресМонтажа") Тогда
			ОтборАдресМонтажа = НастройкаОтбора.ПравоеЗначение;
			
		КонецЕсли;
	КонецЦикла;
	
