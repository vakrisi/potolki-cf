
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(СписокЗаказыПокупателей, "ТекДата",  ТекущаяДатаСеанса());
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(СписокВсе, "ТекДата",  ТекущаяДатаСеанса());
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(СписокЗаказыПокупателей, "ОбщиеСклады", Константы.ОбщиеСклады.Получить());
		
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПараметрыРазмещения = ПодключаемыеКоманды.ПараметрыРазмещения();
	ПараметрыРазмещения.Источники = Новый ОписаниеТипов("ДокументСсылка.ЗаказНаПроизводство");
	ПараметрыРазмещения.КоманднаяПанель = Элементы.ФормаКоманднаяПанель;
	ПараметрыРазмещения.ПрефиксГрупп = "ЗаказНаПроизводство"; 	
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект, ПараметрыРазмещения);
	
	ПараметрыРазмещения = ПодключаемыеКоманды.ПараметрыРазмещения();
	ПараметрыРазмещения.Источники = Новый ОписаниеТипов("ДокументСсылка.ЗаказПокупателя");
	ПараметрыРазмещения.КоманднаяПанель = Элементы.ФормаКоманднаяПанель;
	ПараметрыРазмещения.ПрефиксГрупп = "ЗаказПокупателя"; 	
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект, ПараметрыРазмещения);
	
	ПараметрыРазмещения = ПодключаемыеКоманды.ПараметрыРазмещения();
	ПараметрыРазмещения.Источники = Новый ОписаниеТипов("ДокументСсылка.ЗаявкаНаДоставку");
	ПараметрыРазмещения.КоманднаяПанель = Элементы.ФормаКоманднаяПанель;
	ПараметрыРазмещения.ПрефиксГрупп = "ЗаявкаНаДоставку"; 	
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект, ПараметрыРазмещения);

	ПараметрыРазмещения = ПодключаемыеКоманды.ПараметрыРазмещения();
	ПараметрыРазмещения.Источники = Новый ОписаниеТипов("ДокументСсылка.ВозвратПродукции");
	ПараметрыРазмещения.КоманднаяПанель = Элементы.ФормаКоманднаяПанель;
	ПараметрыРазмещения.ПрефиксГрупп = "ВозвратПродукции"; 	
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект, ПараметрыРазмещения);

	ПараметрыРазмещения = ПодключаемыеКоманды.ПараметрыРазмещения();
	ПараметрыРазмещения.Источники = Новый ОписаниеТипов("ДокументСсылка.ВозвратТовараОтПокупателя");
	ПараметрыРазмещения.КоманднаяПанель = Элементы.ФормаКоманднаяПанель;
	ПараметрыРазмещения.ПрефиксГрупп = "ВозвратТовараОтПокупателя"; 	
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект, ПараметрыРазмещения);
	
	ПараметрыРазмещения = ПодключаемыеКоманды.ПараметрыРазмещения();
	ПараметрыРазмещения.Источники = Новый ОписаниеТипов("ДокументСсылка.ВыпускПродукции");
	ПараметрыРазмещения.КоманднаяПанель = Элементы.ФормаКоманднаяПанель;
	ПараметрыРазмещения.ПрефиксГрупп = "ВыпускПродукции"; 	
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект, ПараметрыРазмещения);
	
	ПараметрыРазмещения = ПодключаемыеКоманды.ПараметрыРазмещения();
	ПараметрыРазмещения.Источники = Новый ОписаниеТипов("ДокументСсылка.РеализацияТоваровИУслуг");
	ПараметрыРазмещения.КоманднаяПанель = Элементы.ФормаКоманднаяПанель;
	ПараметрыРазмещения.ПрефиксГрупп = "РеализацияТоваровИУслуг"; 	
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект, ПараметрыРазмещения);
	
    // Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	// СтандартныеПодсистемы.УчетОригиналовПервичныхДокументов
	УчетОригиналовПервичныхДокументов.ПриСозданииНаСервере_ФормаСписка(ЭтотОбъект, Элементы.СписокРеализаций);
	УчетОригиналовПервичныхДокументов.ПриСозданииНаСервере_ФормаСписка(ЭтотОбъект, Элементы.СписокЗаказыПокупателей);
	// Конец СтандартныеПодсистемы.УчетОригиналовПервичныхДокументов
	
	ИспользоватьРезервирование = ПолучитьФункциональнуюОпцию("ИспользоватьРезервирование");
	
	РеквизитыПользователя = ОбщийМодульСервер.НастройкиПользователя("Цех, ЧастотаАвтоматическогоОбновленияСписковВАРМПроизводства");

	НесколькоТочекПроизводства = Константы.НесколькоТочекПроизводства.Получить();
	Элементы.СписокВсеЦех.Видимость = НесколькоТочекПроизводства;
	Элементы.ОтборЦех.Видимость = НесколькоТочекПроизводства;
	Если НесколькоТочекПроизводства Тогда
		ОтборЦех = РеквизитыПользователя.Цех;
	КонецЕсли;	
	
	НастройкаОбщиеСклады = Константы.ОбщиеСклады.Получить();
	СписокЗаказыПокупателей.КомпоновщикНастроек.Настройки.ДополнительныеСвойства.Вставить("НастройкаОбщиеСклады", НастройкаОбщиеСклады);
	
	ФильтрДоставкиТекущийСтатус = Справочники.СтатусыЗаявокНаДоставку.Заявка; // №10663 заменено на справочник, было: ОтборДоставкиСтатус = Перечисления.СтатусыДоставкиТовара.Заявка;
	Элементы.ГруппаДоставки.Видимость = ПолучитьФункциональнуюОпцию("УчитыватьДоставкуТовара");
	УстановитьОтборыСпискаДоставки(); // №10663 заменено на новые фильтры, было: ДоставкиОтборПоСтатусуУстановить(ОтборДоставкиСтатус);
	
	СкладОтгрузкиПотолоковОтличаетсяОтСкладаГотовойПродукции = Константы.СкладОтгрузкиПотолоковОтличаетсяОтСкладаГотовойПродукции.Получить();
	
	СписокЗаказыПокупателейТекстЗапроса = СписокЗаказыПокупателей.ТекстЗапроса;
	//Отбор по статусу ЗП
	НачальныйСтатусЗП = Справочники.СтатусыЗаказовПокупателей.НачальныйСтатус();
	//#13253
	СписокСтатусовЗаказовПокупателей = Справочники.СтатусыЗаказовПокупателей.СписокСтатусов();
	
	//#13344
	Если ПолучитьФункциональнуюОпцию("ИспользоватьСтатусыСборкиЗаказовПокупателей") Тогда
		СписокСтатусовСборкиЗаказовПокупателей = Справочники.СтатусыСборкиЗаказов.СписокСтатусов();
		//#13387
		СписокСтатусовСборкиЗаказовПокупателей.Вставить(0, Справочники.СтатусыСборкиЗаказов.ПустаяСсылка(), "(статус не указан)");
	Иначе
		Элементы.ЗаказПокупателяОтборПоСтатусуСборки.Видимость = Ложь;
	КонецЕсли;
	
	НастройкиПользователяИнициированы = Ложь;
	ВосстановитьНастройкиФормы(НастройкиПользователяИнициированы);	
	
	Если НЕ НастройкиПользователяИнициированы Тогда
		ЗаказПокупателяОтборПоСтатусу.Добавить(НачальныйСтатусЗП);
	КонецЕсли;	
	
	Для каждого ЭлементСписка из ЗаказПокупателяОтборПоСтатусу Цикл		
		НачЭлементСписка = СписокСтатусовЗаказовПокупателей.НайтиПоЗначению(ЭлементСписка.Значение);
		Если НЕ НачЭлементСписка = Неопределено Тогда
			НачЭлементСписка.Пометка = Истина;
		КонецЕсли;
	КонецЦикла;
	Если ПолучитьФункциональнуюОпцию("ИспользоватьСтатусыСборкиЗаказовПокупателей") Тогда
		Для каждого ЭлементСписка из ЗаказПокупателяОтборПоСтатусуСборки Цикл		
			НачЭлементСписка = СписокСтатусовСборкиЗаказовПокупателей.НайтиПоЗначению(ЭлементСписка.Значение);
			Если НЕ НачЭлементСписка = Неопределено Тогда
				НачЭлементСписка.Пометка = Истина;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;	
	
	ЗаказПокупателяОтборПоОплате = -1;	
	ЗаказПокупателяОтборПоПроизводству = -2;
	ЗаказПокупателяОтборПоЗакупке = -2;
	ЗаказПокупателяОтборПоОбеспеченности = -1;	
	ЗаказПокупателяОтборПоОтгрузке = -1;
	УстановитьОтборЗаказовПокупателей();
	
	Если НЕ Константы.СкладОтгрузкиПотолоковОтличаетсяОтСкладаГотовойПродукции.Получить() Тогда
		//Элементы.СкладОтгрузки.Видимость = Ложь;
		Элементы.СписокВсеСкладОтгрузки.Видимость = Ложь;		
		Элементы.ОтборСкладОтгрузки.Видимость = Ложь;
	КонецЕсли;
	
	Если НЕ НастройкиПользователяИнициированы Тогда
		ПоказыватьЗаказыПроизводства = Истина;
		ПоказыватьЗаказыРозницы = Истина;
		ОтборСтатус = ПредопределенноеЗначение("Справочник.СтатусыЗаказовНаПроизводство.ВПроизводстве");
	КонецЕсли;
	
	//++15605
	Элементы.ЗаказПокупателяОтборПоПодразделению.Видимость = Константы.ИспользоватьПодразделения.Получить();
	Элементы.ОтборПодразделение.Видимость = Константы.ИспользоватьПодразделения.Получить();
	//--#15605
	
	УстановитьОтборЗаказовНаПроизводство();
	
	ОтборВозвратыСтатус = Справочники.СтатусыВозвратаПродукции.НаПроверке;
	УстановитьОтборВозвратов();
	
	ОбновитьЭлементыФормы();
	
	//Если РольДоступна("АдминистраторСистемы") 
	//	или РольДоступна("ПолныеПрава")
	//	или РольДоступна("ДокументЗаказПокупателяЧтение")
	//	или РольДоступна("ДокументЗаказПокупателяРедактирование")
	//	Тогда
	//	//есть доступ к документу "Заказ покупателя"
	//	Элементы.ГруппаЗаказыПокупателей.Видимость = Истина;
	//Иначе
	//	//нет доступа к документу "Заказ покупателя"
	//	Элементы.ГруппаЗаказыПокупателей.Видимость = Ложь;
	//КонецЕсли;
	//
	//Если РольДоступна("АдминистраторСистемы") 
	//	или РольДоступна("ПолныеПрава")
	//	или РольДоступна("ДокументВозвратПродукцииРедактирование")
	//	или РольДоступна("ДокументВозвратПродукцииЧтение")
	//	Тогда
	//	//есть доступ к документу "Возврат продукции"
	//	Элементы.ГруппаВозвраты.Видимость = Истина;
	//Иначе
	//	//нет доступа к документу "Возврат продукции"
	//	Элементы.ГруппаВозвраты.Видимость = Ложь;
	//КонецЕсли;
	
	Элементы.ГруппаЗаказыПокупателей.Видимость 	= ПравоДоступа("Просмотр", Метаданные.Документы.ЗаказПокупателя);
	Элементы.ГруппаВозвратыПродукции.Видимость 	= ПравоДоступа("Просмотр", Метаданные.Документы.ВозвратПродукции);
	//#11630
	Элементы.ГруппаРеализации.Видимость 		= ПравоДоступа("Просмотр", Метаданные.Документы.РеализацияТоваровИУслуг) И ПолучитьФункциональнуюОпцию("ИспользоватьСтатусыОтгрузки");
	
	Элементы.ГруппаВыпуски.Видимость 			= ПравоДоступа("Просмотр", Метаданные.Документы.ВыпускПродукции);
	
	Элементы.СписокЗаказыПокупателейСМСОтправлено.Видимость = Константы.АвтоматическаяРассылкаСМС.Получить();
	Элементы.СписокЗаказыПокупателейОтправитьСМС.Видимость = Элементы.СписокЗаказыПокупателейСМСОтправлено.Видимость;
	
	ВидимостьРеквизитовПереводаЗНПНаДругойСклад = Константы.СкладОтгрузкиПотолоковОтличаетсяОтСкладаГотовойПродукции.Получить();
	Элементы.ОтборСтатусДоставкиНаСкладОтгрузки.Видимость = ВидимостьРеквизитовПереводаЗНПНаДругойСклад;
	Элементы.СписокВсеДоставленНаСкладОтгрузки.Видимость = ВидимостьРеквизитовПереводаЗНПНаДругойСклад;
	
	//ИспользоватьСтатусНовыйВЗаказеПокупателя = ПолучитьФункциональнуюОпцию("ИспользоватьСтатусНовыйВЗаказеПокупателя");
	ИспользоватьСтатусНовыйВЗаказеПокупателя = Справочники.СтатусыЗаказовПокупателей.Новый.Использовать;
	//Элементы.УДАЛИТЬ_ГруппаЗаказПокупателейОформлениеНовый.Видимость = ИспользоватьСтатусНовыйВЗаказеПокупателя;
	//Элементы.СписокЗаказыПокупателейИзменитьСтатусЗаказаПокупателяНаВРаботе.Видимость = ИспользоватьСтатусНовыйВЗаказеПокупателя;
	
	ИспользоватьСтатусЗакрытВЗаказеПокупателя = ПолучитьФункциональнуюОпцию("ИспользоватьСтатусЗакрытВЗаказеПокупателя");
	Элементы.СписокЗаказыПокупателейИзменитьСтатусЗаказаПокупателяНаЗакрыт.Видимость = ИспользоватьСтатусЗакрытВЗаказеПокупателя;
	
	// подсказка к оформлению
	ВремяПодсветкиЗППоДатеОжидаемойОтгрузки = Константы.ВремяПодсветкиЗППоДатеОжидаемойОтгрузки.Получить();
	ПодсвечиватьЗППоДатеОжидаемойОтгрузки = Ложь; //ПолучитьФункциональнуюОпцию("ПодсвечиватьЗППоДатеОжидаемойОтгрузки") И ВремяПодсветкиЗППоДатеОжидаемойОтгрузки > 0;
	ВремяПодсветкиЗнППоДатеОжидаемойОтгрузки = Константы.ВремяПодсветкиЗППоДатеОжидаемойОтгрузки.Получить();
	ПодсвечиватьЗнППоДатеОжидаемойОтгрузки = Ложь; //ПолучитьФункциональнуюОпцию("ПодсвечиватьЗнППоДатеОжидаемойОтгрузки") И ВремяПодсветкиЗнППоДатеОжидаемойОтгрузки > 0;
	НастройкаОформленияЗаказов = ОбщийМодульСервер.ПолучитьНастройкуОформленияЗаказов(); 
	НастройкиОформленияЗаказов = ОбщийМодульСервер.ПолучитьНастройкиОформленияЗаказов(НастройкаОформленияЗаказов);	
	НастройкиОформленияЗаказовПокупателей.ЗагрузитьЗначения(НастройкиОформленияЗаказов.ЗП);	
	НастройкиОформленияЗаказовНаПроизводство.ЗагрузитьЗначения(НастройкиОформленияЗаказов.ЗНП);	
	Для каждого НастройкаЦвета из НастройкиОформленияЗаказов.ЗП Цикл
		//НастройкаЦвета = Структура("Настройка, Цвет, Подсказка, Использовать"
		
		Если НЕ НастройкаЦвета.Использовать Тогда
			Продолжить;
		КонецЕсли;

		ИмяНастройки = НастройкаЦвета.Настройка;
		
		Если НЕ ИспользоватьСтатусНовыйВЗаказеПокупателя И ИмяНастройки = "Новый" Тогда
		 	Продолжить;
	 	КонецЕсли;
	    Если НЕ ИспользоватьСтатусЗакрытВЗаказеПокупателя И ИмяНастройки = "Закрыт" Тогда
		 	Продолжить;
		КонецЕсли;

		Если ИмяНастройки = "ОжидаетОтгрузку" Тогда
			ПодсвечиватьЗППоДатеОжидаемойОтгрузки = Истина;
		КонецЕсли;		
		
		Группа = Элементы.Добавить("ГруппаЗаказПокупателейОформление" + ИмяНастройки, Тип("ГруппаФормы"), Элементы.ГруппаЗаказПокупателейОформление);
		Группа.Вид = ВидГруппыФормы.ОбычнаяГруппа;
		Группа.Отображение = ОтображениеОбычнойГруппы.Нет;
		Группа.ОтображатьЗаголовок = Ложь;
		Группа.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Горизонтальная;
		
		Элемент = Элементы.Добавить("ДекорацияЦвет" + ИмяНастройки, Тип("ДекорацияФормы"), Группа);
		Элемент.Вид = ВидДекорацииФормы.Надпись;
		Элемент.Заголовок = "";
		Элемент.Ширина = 2;
		Элемент.Высота = 1;
		Элемент.ЦветФона = НастройкаЦвета.Цвет;
		
		Элемент = Элементы.Добавить("ДекорацияНадпись" + ИмяНастройки, Тип("ДекорацияФормы"), Группа);
		Элемент.Вид = ВидДекорацииФормы.Надпись;
		Элемент.Заголовок = НастройкаЦвета.Подсказка;
		Элемент.АвтоМаксимальнаяШирина = Ложь;
	КонецЦикла;	
	Для каждого НастройкаЦвета из НастройкиОформленияЗаказов.ЗП Цикл
		//НастройкаЦвета = Структура("Настройка, Цвет, Подсказка, Использовать"	
		Если НастройкаЦвета.Использовать И НастройкаЦвета.Настройка = "ОжидаетОтгрузку" Тогда
			ПодсвечиватьЗНППоДатеОжидаемойОтгрузки = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	УстановитьУсловноеОформление();
	
	// №13388
