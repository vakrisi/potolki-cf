&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	// ПодключаемоеОборудование
	Если Источник = "ПодключаемоеОборудование" И ВводДоступен() Тогда
		Если ИмяСобытия = "ScanData" И МенеджерОборудованияПотолкиКлиент.ЕстьНеобработанноеСобытие() Тогда
			ОбработатьШтрихкоды(МенеджерОборудованияПотолкиКлиент.ПреобразоватьДанныеСоСканераВСтруктуру(Параметр));
		КонецЕсли;
	КонецЕсли;
	// Конец ПодключаемоеОборудование
	
	Если ИмяСобытия =  "ОбновитьАРМПроизводства" Тогда
		Если Источник = "ЗаказПокупателя" 
			ИЛИ Источник = "РеализацияТоваровИУслуг" 
			ИЛИ Источник = "ПеремещениеТоваров"
			ИЛИ Источник = "ПриходныйКассовыйОрдер"
			ИЛИ Источник = "ОплатаБанковскойКартой"
			ИЛИ Источник = "ЗаказНаПроизводство"
			ИЛИ Источник = "ВыпускПродукции"
			
			ИЛИ Источник = "СтруктураПодчиненности"  // #12457
			Тогда
			Элементы["СписокВсе"].Обновить();
			Элементы["СписокЗаказыПокупателей"].Обновить();
		КонецЕсли;
		
		Если Источник = "ЗаказДоговор"
			ИЛИ Источник = "Монтаж" Тогда
			Элементы["СписокЗаказыПокупателей"].Обновить();
		КонецЕсли;
		
	// #12457
	ИначеЕсли ИмяСобытия =  "Запись_ПоступлениеТоваровИУслугСписок"
		ИЛИ ИмяСобытия = "Запись_ПоступлениеТоваровИУслуг"
		ИЛИ ИмяСобытия =  "Запись_ЗаказПоставщикуСписок"
		ИЛИ ИмяСобытия = "Запись_ЗаказПоставщику"
