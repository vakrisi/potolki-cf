&НаКлиенте
Процедура Подключаемый_ВыполнитьКоманду(Команда)
	ОчиститьСообщения();
	//ПодключаемыеКомандыКлиент.ВыполнитьКоманду(ЭтотОбъект, Команда, Элементы.СписокЗаказыПокупателей);
	
	Если Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.ГруппаВсе Тогда
		Список = Элементы.СписокВсе;
	ИначеЕсли Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.ГруппаЗаказыПокупателей Тогда
		Список = Элементы.СписокЗаказыПокупателей;
	ИначеЕсли Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.ГруппаДоставки Тогда
		Список = Элементы.СписокДоставки;
	ИначеЕсли Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.ГруппаВозвратыПродукции Тогда
		Список = Элементы.СписокВозвраты;
	ИначеЕсли Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.ГруппаРеализации Тогда	
		Список = Элементы.СписокРеализаций;
	ИначеЕсли Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.ГруппаВозвратТовараОтПокупателя Тогда	
		Список = Элементы.СписокВозвратТовараОтПокупателя;
	ИначеЕсли Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.ГруппаВыпуски Тогда	
		Список = Элементы.СписокВыпуски;
	КонецЕсли;
	
	ПодключаемыеКомандыКлиент.ВыполнитьКоманду(ЭтотОбъект, Команда, Список);
	
КонецПроцедуры

