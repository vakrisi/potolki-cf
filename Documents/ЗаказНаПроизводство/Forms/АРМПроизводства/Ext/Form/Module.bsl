&НаКлиенте
Процедура ИзменитьСтатусЗаказовПокупателей(ИмяПроцедурыПослеВопроса, СтатусТекстом)

	ОчиститьСообщения();
	
	ИмяСписка = "СписокЗаказыПокупателей";
	МассивЗаказовПокупателей = Новый Массив;
	
	Если Элементы[ИмяСписка].ВыделенныеСтроки.Количество() = 0 Тогда
		Сообщить("Нет выделенных заказов");
		Возврат;
	КонецЕсли;
		
	Для НомерСтроки = 0 По Элементы[ИмяСписка].ВыделенныеСтроки.Количество()-1 Цикл			
		МассивЗаказовПокупателей.Добавить(Элементы[ИмяСписка].ВыделенныеСтроки.Получить(НомерСтроки)); 
	КонецЦикла;	
	
	ДополнительныеПараметры = Новый Структура("МассивЗаказовПокупателей", МассивЗаказовПокупателей);
	ОписаниеОповещения = Новый ОписаниеОповещения(ИмяПроцедурыПослеВопроса, ЭтотОбъект, ДополнительныеПараметры);
	ТекстСообщения = "Перевести заказы покупателей в количестве " + МассивЗаказовПокупателей.Количество() + " шт. в статус """ + СтатусТекстом + """? 
					|Документы будут автоматически записаны.";
	ПоказатьВопрос(ОписаниеОповещения, ТекстСообщения, РежимДиалогаВопрос.ДаНет);
				
КонецПроцедуры

&НаКлиенте
Процедура ПослеВопросаИзменитьСтатусЗаказовПокупателейНаВРаботе(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли;
	
	МассивЗаказовПокупателей = ДополнительныеПараметры.МассивЗаказовПокупателей;
	ИзменитьСтатусЗаказовПокупателейНаСервере(МассивЗаказовПокупателей, ПредопределенноеЗначение("Справочник.СтатусыЗаказовПокупателей.ВРаботе"));
	Элементы.СписокЗаказыПокупателей.Обновить();
	ПоказатьОповещениеПользователя("Выполнено");
		
