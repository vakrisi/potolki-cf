&НаСервере
Процедура СохранитьНастройкиФормы()

	ПользовательскийОтбор = Новый ОтборКомпоновкиДанных();
	ОбщийМодульСервер.НовыйОтбор(ПользовательскийОтбор, "Подразделение", 	ЗаказПокупателяОтборПоПодразделению);
	ОбщийМодульСервер.НовыйОтбор(ПользовательскийОтбор, "ТекущийСтатус", 	ЗаказПокупателяОтборПоСтатусу);
	ОбщийМодульСервер.НовыйОтбор(ПользовательскийОтбор, "СтатусСборки", 	ЗаказПокупателяОтборПоСтатусуСборки);
	ОбщийМодульСервер.НовыйОтбор(ПользовательскийОтбор, "Контрагент", 		ЗаказПокупателяОтборПоКонтрагенту);
	ОбщийМодульСервер.НовыйОтбор(ПользовательскийОтбор, "НомераПотолков", 	ЗаказПокупателяОтборПоНомеруПотолка);
	
	ПользовательскийОтборЗНП = Новый ОтборКомпоновкиДанных();
	ОбщийМодульСервер.НовыйОтбор(ПользовательскийОтборЗНП, "ПоказыватьЗаказыПроизводства", 	ПоказыватьЗаказыПроизводства);
	ОбщийМодульСервер.НовыйОтбор(ПользовательскийОтборЗНП, "ПоказыватьЗаказыРозницы", 		ПоказыватьЗаказыРозницы);
	ОбщийМодульСервер.НовыйОтбор(ПользовательскийОтборЗНП, "Статус", 					ОтборСтатус);
	ОбщийМодульСервер.НовыйОтбор(ПользовательскийОтборЗНП, "Подразделение", 			ОтборПодразделение);
	ОбщийМодульСервер.НовыйОтбор(ПользовательскийОтборЗНП, "Цех", 						ОтборЦех);
	// #16544 отбор убран
	//ОбщийМодульСервер.НовыйОтбор(ПользовательскийОтборЗНП, "Автор", 					ОтборАвтор);
	ОбщийМодульСервер.НовыйОтбор(ПользовательскийОтборЗНП, "Контрагент", 				ОтборКонтрагент);
	ОбщийМодульСервер.НовыйОтбор(ПользовательскийОтборЗНП, "СтатусДоставки", 			ОтборСтатусДоставкиНаСкладОтгрузки);
	ОбщийМодульСервер.НовыйОтбор(ПользовательскийОтборЗНП, "НомерПотолка", 				ОтборНомерПотолка);
	ОбщийМодульСервер.НовыйОтбор(ПользовательскийОтборЗНП, "НачалиПроизводство", 		ОтборНачалиПроизводство);
	ОбщийМодульСервер.НовыйОтбор(ПользовательскийОтборЗНП, "АдресМонтажа", 				ОтборАдресМонтажа);	
	
	СтруктураНастроек = Новый Структура;	
	СтруктураНастроек.Вставить("НастройкиОтбораЗП",  Новый ХранилищеЗначения(ПользовательскийОтбор));
	СтруктураНастроек.Вставить("НастройкиОтбораЗНП", Новый ХранилищеЗначения(ПользовательскийОтборЗНП));
	ОбщегоНазначения.ХранилищеОбщихНастроекСохранить("АРМПроизводства", "НастройкиФормыСписка", СтруктураНастроек);
	
КонецПроцедуры 

&НаСервере
Процедура ВосстановитьНастройкиФормы(НастройкиПользователяИнициированы)

	СтруктураНастроек = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить("АРМПроизводства", "НастройкиФормыСписка");
	Если НЕ ТипЗнч(СтруктураНастроек) = Тип("Структура") Тогда
		Возврат;	
	КонецЕсли;
	
	НастройкиПользователяИнициированы = Истина;
	
	ПользовательскийОтбор = СтруктураНастроек.НастройкиОтбораЗП.Получить();	
	Для каждого НастройкаОтбора из ПользовательскийОтбор.Элементы Цикл
		Если НастройкаОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Подразделение") Тогда
			ЗаказПокупателяОтборПоПодразделению = НастройкаОтбора.ПравоеЗначение;			
			
		ИначеЕсли НастройкаОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Контрагент") Тогда
			ЗаказПокупателяОтборПоКонтрагенту = НастройкаОтбора.ПравоеЗначение;
			
		ИначеЕсли НастройкаОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("НомераПотолков") Тогда
			ЗаказПокупателяОтборПоНомеруПотолка = НастройкаОтбора.ПравоеЗначение;
			
		ИначеЕсли НастройкаОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ТекущийСтатус") Тогда
			Для каждого ЭлементСписка из НастройкаОтбора.ПравоеЗначение Цикл
				Если НЕ СписокСтатусовЗаказовПокупателей.НайтиПоЗначению(ЭлементСписка.Значение) = Неопределено Тогда
					ЗаказПокупателяОтборПоСтатусу.Добавить(ЭлементСписка.Значение);
				КонецЕсли;
			КонецЦикла;
			
		ИначеЕсли НастройкаОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("СтатусСборки") Тогда
			Для каждого ЭлементСписка из НастройкаОтбора.ПравоеЗначение Цикл
				Если НЕ СписокСтатусовСборкиЗаказовПокупателей.НайтиПоЗначению(ЭлементСписка.Значение) = Неопределено Тогда
					Если ЭлементСписка.Значение = Справочники.СтатусыСборкиЗаказов.ПустаяСсылка() Тогда
						ЗаказПокупателяОтборПоСтатусуСборки.Добавить(ЭлементСписка.Значение, "(статус не указан)");
					Иначе	
						ЗаказПокупателяОтборПоСтатусуСборки.Добавить(ЭлементСписка.Значение);
					КонецЕсли;
				КонецЕсли;
