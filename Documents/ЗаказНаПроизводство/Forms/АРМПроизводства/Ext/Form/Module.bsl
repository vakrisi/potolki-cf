// #12778 группа отборов, требующих подмены текста запроса Динамического списка заказов покупателей
&НаСервере
Процедура ЗаказПокупателяОсобыйОтборПриИзмененииНаСервере()
	
	// ПРИ ИЗМЕНЕНИИ ЗАПРОСОВ ПРОВЕРИТЬ ПРОЦЕДУРУ ЗаказПокупателяОсобыйОтборПриИзмененииНаСервере()
	// В Документы.ЗаказПокупателя.ПолучитьТекстЗапросаСписка()
	
	// применяем стандартный текст запроса
	ТекстЗапроса = СписокЗаказыПокупателейТекстЗапроса;
	
	СписокЗаказыПокупателей.КомпоновщикНастроек.Настройки.ДополнительныеСвойства.Вставить("ОтборПоОплате", ЗаказПокупателяОтборПоОплате);
	СписокЗаказыПокупателей.КомпоновщикНастроек.Настройки.ДополнительныеСвойства.Вставить("ОтборПоОтгрузке", ЗаказПокупателяОтборПоОтгрузке);
	СписокЗаказыПокупателей.КомпоновщикНастроек.Настройки.ДополнительныеСвойства.Вставить("ОтборПоПроизводству", ЗаказПокупателяОтборПоПроизводству);
	СписокЗаказыПокупателей.КомпоновщикНастроек.Настройки.ДополнительныеСвойства.Вставить("ОтборПоЗакупке", ЗаказПокупателяОтборПоЗакупке);
	СписокЗаказыПокупателей.КомпоновщикНастроек.Настройки.ДополнительныеСвойства.Вставить("ОтборПоОбеспеченности", ЗаказПокупателяОтборПоОбеспеченности); 	
	
	// если задан отбор по состоянию оплаты:
	Если НЕ ЗаказПокупателяОтборПоОплате = -1 Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "2 КАК СостояниеОплаты", 
		"	ВЫБОР
		|		КОГДА ЕСТЬNULL(ДокументЗаказПокупателя.СуммаДокумента, 0) = 0
		|				ИЛИ ЕСТЬNULL(РасчетыПоЗаказамОбороты.СуммаРасход, 0) = 0
		|			ТОГДА 2
		|		КОГДА ЕСТЬNULL(ДокументЗаказПокупателя.СуммаДокумента, 0) = ЕСТЬNULL(РасчетыПоЗаказамОбороты.СуммаРасход, 0)
		|				И ЕСТЬNULL(РасчетыПоЗаказамОбороты.СуммаРасход, 0) > 0
		|			ТОГДА 0
		|		КОГДА ЕСТЬNULL(ДокументЗаказПокупателя.СуммаДокумента, 0) < ЕСТЬNULL(РасчетыПоЗаказамОбороты.СуммаРасход, 0)
		|				И ЕСТЬNULL(РасчетыПоЗаказамОбороты.СуммаРасход, 0) > 0
		|			ТОГДА 7
		|		ИНАЧЕ 1			
		|	КОНЕЦ КАК СостояниеОплаты");
		
		ТекстЗапроса = ТекстЗапроса + 
		"
		|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.РасчетыПоЗаказам.Обороты КАК РасчетыПоЗаказамОбороты
		|	ПО ДокументЗаказПокупателя.Ссылка = РасчетыПоЗаказамОбороты.Заказ
		|";
		
	КонецЕсли;
	
	// если задан отбор по состоянию отгрузки:
	Если НЕ ЗаказПокупателяОтборПоОтгрузке = -1 Тогда
		
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "2 КАК Отгружен", 
		"	ВЫБОР
		|		КОГДА ЕСТЬNULL(ЗаказыПокупателейОбороты.КоличествоРасход, 0) = 0
		|			ТОГДА 2
		|		КОГДА ЕСТЬNULL(ЗаказыПокупателейОбороты.КоличествоПриход, 0) > 0 
		|			И ЕСТЬNULL(ЗаказыПокупателейОбороты.КоличествоРасход, 0) = ЕСТЬNULL(ЗаказыПокупателейОбороты.КоличествоПриход, 0)
		|			ТОГДА 0
		|		ИНАЧЕ 1
		|	КОНЕЦ КАК Отгружен");
				
		ТекстЗапроса = ТекстЗапроса + 
		"
		|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ЗаказыПокупателей.Обороты КАК ЗаказыПокупателейОбороты
		|	ПО ДокументЗаказПокупателя.Ссылка = ЗаказыПокупателейОбороты.ЗаказНаПроизводство
		|";
		
	КонецЕсли;
	
	// если задан отбор по "Производство" 
	Если НЕ ЗаказПокупателяОтборПоПроизводству = -2 Тогда
		
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "-1 КАК Производство", 
		"	ВЫБОР
		|		КОГДА ЕСТЬNULL(ЗаказыПокупателейВПроизводствеОбороты.КоличествоПриход, 0) > 0
		|				И ЕСТЬNULL(ЗаказыПокупателейВПроизводствеОбороты.КоличествоРасход, 0) = 0
		|			ТОГДА 2
		|		КОГДА ЕСТЬNULL(ЗаказыПокупателейВПроизводствеОбороты.КоличествоПриход, 0) > 0
		|				И ЕСТЬNULL(ЗаказыПокупателейВПроизводствеОбороты.КоличествоРасход, 0) < ЕСТЬNULL(ЗаказыПокупателейВПроизводствеОбороты.КоличествоПриход, 0)
		|			ТОГДА 1
		|		КОГДА ЕСТЬNULL(ЗаказыПокупателейВПроизводствеОбороты.КоличествоПриход, 0) > 0
		|				И ЕСТЬNULL(ЗаказыПокупателейВПроизводствеОбороты.КоличествоРасход, 0) >= ЕСТЬNULL(ЗаказыПокупателейВПроизводствеОбороты.КоличествоПриход, 0)
		|			ТОГДА 0
		|		ИНАЧЕ -1
		|	КОНЕЦ КАК Производство");
				
		ТекстЗапроса = ТекстЗапроса + 
		"
		|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ЗаказыПокупателейВПроизводстве.Обороты КАК ЗаказыПокупателейВПроизводствеОбороты
		|	ПО ДокументЗаказПокупателя.Ссылка = ЗаказыПокупателейВПроизводствеОбороты.ЗаказПокупателя
		|";
		
	КонецЕсли;
	
	// если задан отбор по "Статус закупки" 
	Если НЕ ЗаказПокупателяОтборПоЗакупке = -2 Тогда
		
		ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|   ВЫРАЗИТЬ(ЗаказыПоставщикамОбороты.ЗаказПоставщику.Основание КАК Документ.ЗаказПокупателя) КАК ЗаказПокупателя,
		|	СУММА(ЗаказыПоставщикамОбороты.КоличествоПриход) КАК КоличествоПриход,
		|	СУММА(ЗаказыПоставщикамОбороты.КоличествоРасход) КАК КоличествоРасход
		|ПОМЕСТИТЬ ВТ_ЗаказыПоставщикамОбороты
		|ИЗ
		|	РегистрНакопления.ЗаказыПоставщикам.Обороты(, , , ) КАК ЗаказыПоставщикамОбороты
		|
		|СГРУППИРОВАТЬ ПО
		|	ВЫРАЗИТЬ(ЗаказыПоставщикамОбороты.ЗаказПоставщику.Основание КАК Документ.ЗаказПокупателя)
		|;
		|////////////////////////////////////////////////////////////////////////////////
		|" + ТекстЗапроса;
		
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "-1 КАК СтатусЗакупки", 
		"	ВЫБОР
		|		КОГДА ЕСТЬNULL(ЗаказыПоставщикамОбороты.КоличествоПриход, 0) > 0
		|				И ЕСТЬNULL(ЗаказыПоставщикамОбороты.КоличествоРасход, 0) = 0
		|			ТОГДА 2
		|		КОГДА ЕСТЬNULL(ЗаказыПоставщикамОбороты.КоличествоПриход, 0) > 0
		|				И ЕСТЬNULL(ЗаказыПоставщикамОбороты.КоличествоРасход, 0) < ЕСТЬNULL(ЗаказыПоставщикамОбороты.КоличествоПриход, 0)
		|			ТОГДА 1
		|		КОГДА (ЕСТЬNULL(ЗаказыПоставщикамОбороты.КоличествоПриход, 0) > 0
		|				И ЕСТЬNULL(ЗаказыПоставщикамОбороты.КоличествоРасход, 0) >= ЕСТЬNULL(ЗаказыПоставщикамОбороты.КоличествоПриход, 0))
		|					ИЛИ (ЕСТЬNULL(ПоступлениеТоваровИУслугПоЗаказуПокупателя.КоличествоОборот, 0) > 0)
		|			ТОГДА 0		
		|		ИНАЧЕ -1
		|	КОНЕЦ КАК СтатусЗакупки");
				
		ТекстЗапроса = ТекстЗапроса + 
		"
		//|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ЗаказыПоставщикам.Обороты() КАК ЗаказыПоставщикамОбороты
		//|   ПО ДокументЗаказПокупателя.Ссылка = ЗаказыПоставщикамОбороты.ЗаказПоставщику.Основание
		|	ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ЗаказыПоставщикамОбороты КАК ЗаказыПоставщикамОбороты
		|   ПО ДокументЗаказПокупателя.Ссылка = ЗаказыПоставщикамОбороты.ЗаказПокупателя
		|	
		|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.Закупки.Обороты(,, Регистратор) КАК ПоступлениеТоваровИУслугПоЗаказуПокупателя
		|   ПО ДокументЗаказПокупателя.Ссылка = ПоступлениеТоваровИУслугПоЗаказуПокупателя.Регистратор.Основание		
		|";
		
	КонецЕсли;
	
	// если задан отбор по "К отгрузке" 
	Если НЕ ЗаказПокупателяОтборПоОбеспеченности = -1 Тогда
		
		ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВЫРАЗИТЬ(ВТ.ЗаказНаПроизводство КАК Документ.ЗаказПокупателя) КАК ДокументЗаказ,
		|	ВТ.Номенклатура КАК Номенклатура,
		|	ВТ.ХарактеристикаНоменклатуры,
		|	ВТ.СерияНоменклатуры,
		|	ВЫБОР КОГДА ВТ.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Справочник.ВидыНоменклатуры.Услуга) ТОГДА ИСТИНА ИНАЧЕ ЛОЖЬ КОНЕЦ ЭтоУслуга,
		|	ЕСТЬNULL(ТоварыНаСкладахОстатки.КоличествоОстаток, 0) КАК КоличествоОстаток,
		|	ЕСТЬNULL(ВТ.КоличествоОстаток, 0) КАК Потребность,
		|	ЕСТЬNULL(ТоварыВРезервеПоЗаказуОстатки.КоличествоОстаток, 0) КАК ВРезервеПодЗаказ,
		|	ЕСТЬNULL(ТоварыВРезервеПоЗаказамОстатки.КоличествоОстаток, 0) КАК ВРезервеОбщее
		|ПОМЕСТИТЬ ВТ_ОбеспеченностьВрем
		|ИЗ 
		|	РегистрНакопления.ЗаказыПокупателей.Остатки
		|												(,
		|												ВЫРАЗИТЬ(ЗаказНаПроизводство КАК Документ.ЗаказПокупателя).ТекущийСтатус = ЗНАЧЕНИЕ(Справочник.СтатусыЗаказовПокупателей.ВРаботе)
		//|												И НЕ Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Справочник.ВидыНоменклатуры.Услуга)
		|	) КАК ВТ
		
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыНаСкладах.Остатки КАК ТоварыНаСкладахОстатки
		|		ПО (ТоварыНаСкладахОстатки.Номенклатура = ВТ.Номенклатура)
		|			И (ТоварыНаСкладахОстатки.ХарактеристикаНоменклатуры = ВТ.ХарактеристикаНоменклатуры)
		|			И (ТоварыНаСкладахОстатки.СерияНоменклатуры = ВТ.СерияНоменклатуры)
		|			//И (ТоварыНаСкладахОстатки.Склад = ВТ.Ссылка.Склад)
		|			И (ТоварыНаСкладахОстатки.Склад = ВЫРАЗИТЬ(ВТ.ЗаказНаПроизводство КАК Документ.ЗаказПокупателя).Склад)
		|			И (ВЫБОР
		|					КОГДА &ОбщиеСклады
		|						ТОГДА ИСТИНА
		|					ИНАЧЕ ТоварыНаСкладахОстатки.Организация = ВЫРАЗИТЬ(ВТ.ЗаказНаПроизводство КАК Документ.ЗаказПокупателя).Организация
		|				КОНЕЦ)
		|			
		|		//++ #12484					
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыВРезервеНаСкладах.Остатки КАК ТоварыВРезервеПоЗаказуОстатки
		|		ПО (ТоварыВРезервеПоЗаказуОстатки.Номенклатура = ВТ.Номенклатура)
		|			И (ТоварыВРезервеПоЗаказуОстатки.ХарактеристикаНоменклатуры = ВТ.ХарактеристикаНоменклатуры)
		|			И (ТоварыВРезервеПоЗаказуОстатки.СерияНоменклатуры = ВТ.СерияНоменклатуры)
		|			//И (ТоварыВРезервеПоЗаказуОстатки.ДокументРезерва = ВТ.Ссылка)
		|			И (ТоварыВРезервеПоЗаказуОстатки.ДокументРезерва = ВЫРАЗИТЬ(ВТ.ЗаказНаПроизводство КАК Документ.ЗаказПокупателя))
		|				
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыВРезервеНаСкладах.Остатки КАК ТоварыВРезервеПоЗаказамОстатки
		|		ПО (ТоварыВРезервеПоЗаказамОстатки.Номенклатура = ВТ.Номенклатура)
		|			И (ТоварыВРезервеПоЗаказамОстатки.ХарактеристикаНоменклатуры = ВТ.ХарактеристикаНоменклатуры)
		|			И (ТоварыВРезервеПоЗаказамОстатки.СерияНоменклатуры = ВТ.СерияНоменклатуры)
		|		//-- #12484
		|		
		|ГДЕ
		|	ЕСТЬNULL(ВТ.КоличествоОстаток, 0) > 0 // #12484
		|
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВТ_ОбеспеченностьВрем.ДокументЗаказ КАК ДокументЗаказ,		
		|	СУММА(ВЫБОР
		|			КОГДА НЕ ВТ_ОбеспеченностьВрем.ЭтоУслуга 
		|				И ((ВТ_ОбеспеченностьВрем.Потребность > ВТ_ОбеспеченностьВрем.КоличествоОстаток)
		|				ИЛИ (ВТ_ОбеспеченностьВрем.Потребность > ВТ_ОбеспеченностьВрем.КоличествоОстаток - (ВТ_ОбеспеченностьВрем.ВРезервеОбщее - ВТ_ОбеспеченностьВрем.ВРезервеПодЗаказ)))
		|				ТОГДА 1 // позиция не обеспечена
		|			ИНАЧЕ 0
		|		КОНЕЦ) КАК КоличествоНеобеспеченных,
		|	СУММА(1) КАК КоличествоПозиций,
		|	СУММА(ВЫБОР КОГДА ВТ_ОбеспеченностьВрем.ЭтоУслуга ТОГДА 1 ИНАЧЕ 0 КОНЕЦ) КАК КоличествоУслуг
		|ПОМЕСТИТЬ ВТ_Обеспеченность
		|ИЗ
		|	ВТ_ОбеспеченностьВрем КАК ВТ_ОбеспеченностьВрем
		|
		|СГРУППИРОВАТЬ ПО
		|	ВТ_ОбеспеченностьВрем.ДокументЗаказ
		|;
		|////////////////////////////////////////////////////////////////////////////////
		|" + ТекстЗапроса;
	
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "-1 КАК СостояниеОбеспеченности", 
		"	ВЫБОР
		|       КОГДА НЕ ДокументЗаказПокупателя.Проведен 
		|			ТОГДА -1
		|       // все остатки по заказу - это услуги
		|		КОГДА ЕСТЬNULL(ВТ_Обеспеченность.КоличествоПозиций, 0) = ЕСТЬNULL(ВТ_Обеспеченность.КоличествоУслуг, 0)
		|			ТОГДА -1
		|       // все позиции не обеспечены
		// #15215
		//|		КОГДА ЕСТЬNULL(ВТ_Обеспеченность.КоличествоПозиций, 0) = ЕСТЬNULL(ВТ_Обеспеченность.КоличествоНеобеспеченных, 0)
		|		КОГДА ЕСТЬNULL(ВТ_Обеспеченность.КоличествоПозиций, 0) - ЕСТЬNULL(ВТ_Обеспеченность.КоличествоУслуг, 0)
		|			= ЕСТЬNULL(ВТ_Обеспеченность.КоличествоНеобеспеченных, 0)
		|			ТОГДА 2
		|		// обеспечен полностью
		|		КОГДА ЕСТЬNULL(ВТ_Обеспеченность.КоличествоНеобеспеченных, 1) = 0
		// #14816 закомментировано: услуги тоже влияют на показатель КоличествоНеобеспеченных
		//|			ИЛИ (ЕСТЬNULL(ВТ_Обеспеченность.КоличествоПозиций, 0) - ЕСТЬNULL(ВТ_Обеспеченность.КоличествоУслуг, 0) = ЕСТЬNULL(ВТ_Обеспеченность.КоличествоНеобеспеченных, 0))
		|			ТОГДА 0 // обеспечен полностью
		|		КОГДА НЕ ЕСТЬNULL(ВТ_Обеспеченность.КоличествоНеобеспеченных, 1) = 0
		|			И ДокументЗаказПокупателя.ТекущийСтатус = ЗНАЧЕНИЕ(Справочник.СтатусыЗаказовПокупателей.ВРаботе)
		|			И ДокументЗаказПокупателя.Проведен
		|		    ТОГДА 1
		|		ИНАЧЕ -1 
		|	КОНЕЦ КАК СостояниеОбеспеченности");
		
		ТекстЗапроса = ТекстЗапроса + 
		"
		|	ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Обеспеченность КАК ВТ_Обеспеченность
		|	ПО ДокументЗаказПокупателя.Ссылка = ВТ_Обеспеченность.ДокументЗаказ		
		|";
	КонецЕсли;
	
	СписокЗаказыПокупателей.ТекстЗапроса = ТекстЗапроса;
	
КонецПроцедуры

