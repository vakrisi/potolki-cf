&НаСервере
Функция ЭтоЗаказНаПроизводствоНаОснованииЗаказаПокупателя(СсылкаЗаказ)
	Если ТипЗнч(СсылкаЗаказ) = Тип("ДокументСсылка.ЗаказНаПроизводство") Тогда
		Если ТипЗнч(СсылкаЗаказ.ДокументОснование) = Тип("ДокументСсылка.ЗаказПокупателя") Тогда
			Возврат Истина;
		Иначе
			Возврат Ложь;
		КонецЕсли;
	Иначе
		Возврат Ложь;
	КонецЕсли;
КонецФункции

&НаСервере 
Функция НайтиДокументПродажиПоЗаказуНаПроизводство(ЗаказНаПроизводство)
	
	ПродажаТовара = Документы.РеализацияТоваровИУслуг.ПустаяСсылка();
	
	//подберем последний документ выпуска продукции по данному заказу на производство
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЗаказыНаПроизводствоОбороты.Регистратор
	|ИЗ
	|	РегистрНакопления.ЗаказыПокупателей.Обороты(, , Регистратор, ЗаказНаПроизводство = &ЗаказНаПроизводство) КАК ЗаказыНаПроизводствоОбороты
	|ГДЕ
	|	ЗаказыНаПроизводствоОбороты.КоличествоРасход > 0";
	Запрос.УстановитьПараметр("ЗаказНаПроизводство",ЗаказНаПроизводство.Ссылка);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ПродажаТовара = Выборка.Регистратор;
	КонецЦикла;
	
	Возврат ПродажаТовара;
	
КонецФункции

