	ИначеЕсли ИмяСобытия = "ПеревестиЗаказВСтатусПроизведен" 
		И Источник = "ШКИсполнители" Тогда
		
		//Начало изменен при переходе на 2.0
		//Элементы.СписокВПроизводстве.ТекущаяСтрока = Параметр;
		Элементы.СписокВсе.ТекущаяСтрока = Параметр;
		//Если Элементы.СписокВПроизводстве.ТекущаяСтрока = Параметр Тогда			
		Если Элементы.СписокВсе.ТекущаяСтрока = Параметр Тогда			
		//Конец изменен при переходе на 2.0	
			ПеревестиВСтатусПроизведен(Неопределено);
		КонецЕсли;
		
	// 2.0.1 Убрано в Общую форму Центр событий	
	//ИначеЕсли ИмяСобытия = "ЗакрытиеЗаказа" Тогда
	//	// Параметр - Новый Структура("ОтгрузкаИзАРМ, МассивОснований"
	//	Если НЕ Параметр.ОтгрузкаИзАРМ Тогда
	//		//#5032
	//		Возврат;
	//	КонецЕсли;
	//	МассивВыполненныхЗаказов = Новый Массив;
	//	Для каждого ЭлементМассива из Параметр.МассивОснований Цикл
	//		СтатусЗаказа = ПредопределенноеЗначение("Справочник.СтатусыЗаказовПокупателей.Выполнен");
	//		ВсеТоварыПоЗаказуОтгружены = Ложь;
	//		Попытка
	//			СтатусЗаказа = СтатусЗаказаПокупателя(ЭлементМассива);
	//			ВсеТоварыПоЗаказуОтгружены = ВсеТоварыПоЗаказуОтгружены(ЭлементМассива);
	//		Исключение
	//			//Возврат;
	//		КонецПопытки;
	//		
	//		Если СтатусЗаказа = ПредопределенноеЗначение("Справочник.СтатусыЗаказовПокупателей.ВРаботе") И ВсеТоварыПоЗаказуОтгружены Тогда
	//			МассивВыполненныхЗаказов.Добавить(ЭлементМассива);
	//		КонецЕсли;
	//	КонецЦикла;
	//	
	//	Если МассивВыполненныхЗаказов.Количество() > 0 Тогда		
	//		
	//		//Если БлокировкаОбъекта(Параметр, Истина) Тогда
	//		//	БлокировкаОбъекта(Параметр, Ложь);
	//		
	//		ОписаниеОповещения = Новый ОписаниеОповещения("ПеревестиЗаказВСтатусВыполнен", ЭтаФорма, Новый Структура("МассивВыполненныхЗаказов", МассивВыполненныхЗаказов));
	//		//ПоказатьВопрос(ОписаниеОповещения,"По заказу " + Параметр + " отгружены все товары. Перевести заказ в статус ""Выполнен""?
	//		ПоказатьВопрос(ОписаниеОповещения, "По заказам покупателей в количестве " + МассивВыполненныхЗаказов.Количество() + " шт. отгружены все товары. Перевести заказы в статус ""Выполнен""? 
	//		|Документы будут автоматически записаны.", РежимДиалогаВопрос.ДаНет);
	//		
	//	КонецЕсли;	
	КонецЕсли;
	
	// СтандартныеПодсистемы.УчетОригиналовПервичныхДокументов
	УчетОригиналовПервичныхДокументовКлиент.ОбработчикОповещенияФормаСписка(ИмяСобытия, ЭтотОбъект, Элементы.СписокРеализаций);
	УчетОригиналовПервичныхДокументовКлиент.ОбработчикОповещенияФормаСписка(ИмяСобытия, ЭтотОбъект, Элементы.СписокЗаказыПокупателей);
	// Конец СтандартныеПодсистемы.УчетОригиналовПервичныхДокументов

