&НаКлиенте
Процедура ДоставкиОтборПоСтатусуОчистить()
	
	ПолеКомпоновки = Новый ПолеКомпоновкиДанных("ТекущийСтатус");
	
	Для Каждого ЭлементОтбора Из СписокДоставки.Отбор.Элементы Цикл
		Если ТипЗнч(ЭлементОтбора) = Тип("ЭлементОтбораКомпоновкиДанных")
			И ЭлементОтбора.ЛевоеЗначение = ПолеКомпоновки Тогда
			СписокДоставки.Отбор.Элементы.Удалить(ЭлементОтбора);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ПеревестиВСтатусОтменен(Команда)
	
	ТекущиеДанные = Элементы.СписокВсе.ТекущиеДанные;
	ИмяСписка = "СписокВсе";
	
	Если Вопрос("Перевести заказ на производство №" + ТекущиеДанные.номер + " в статус ""ОТМЕНЕН""?",РежимДиалогаВопрос.ДаНет) = КодВозвратаДиалога.Да Тогда
		ПеревестиЗаказНаПроизводствоВСтатусОтменен(ТекущиеДанные.Ссылка);
		Элементы[ИмяСписка].Обновить();
	КонецЕсли;

КонецПроцедуры

