		СписокДоставки
		, "ОжидаемаяДатаОтправкиБезВремени"
		, ФильтрДоставкиОжидаемаяДатаОтправки
		, ВидСравненияКомпоновкиДанных.Равно
		,
		, ЗначениеЗаполнено(ФильтрДоставкиОжидаемаяДатаОтправки)
	);
	
	// Получатель
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(
		СписокДоставки
		, "Получатель"
