		, ВидСравненияКомпоновкиДанных.Равно
		,
		, ЗначениеЗаполнено(ФильтрДоставкиПолучатель)
	);
	
	// Город
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(
		СписокДоставки
		, "Город"
		, ФильтрДоставкиГород
		, ВидСравненияКомпоновкиДанных.Равно
		,
		, ЗначениеЗаполнено(ФильтрДоставкиГород)
	); 
	//nva+++
	// Склад
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(
		СписокДоставки
		, "ЗаказПокупателяСклад"
		, ФильтрДоставкиСклад
		, ВидСравненияКомпоновкиДанных.Равно
		,
		, ЗначениеЗаполнено(ФильтрДоставкиСклад)
	);
	//nva---									
КонецПроцедуры

