&НаСервере
Функция ПолучитьСписокТоваровДляПеремещения(СписокДокЗаказов)
	
	//ТолькоПродукция = Константы.ОтправлятьНаСкладОтгрузкиИзПроизводстваТолькоПродукцию.Получить(); //переход на 2.0
	СписокТоваров = Новый СписокЗначений;
	Для НомерДокумента = 0 По СписокДокЗаказов.Количество() - 1 Цикл
		ДокЗаказ = СписокДокЗаказов.Получить(НомерДокумента).Значение;
		Если ДокЗаказ.ВидЗаказа = Перечисления.ВидыЗаказовНаПроизводство.ПроизводствоПотолка Тогда
			СтруктураТовара = Новый Структура;
			СтруктураТовара.Вставить("Заказ", ДокЗаказ);
			СтруктураТовара.Вставить("Номенклатура", ДокЗаказ.ПродукцияНоменклатура);
			СтруктураТовара.Вставить("Количество", ДокЗаказ.ПродукцияНоменклатураКоличество);
			СтруктураТовара.Вставить("ЕдиницаИзмерения", ДокЗаказ.ПродукцияНоменклатураЕдиницаИзмерения);
			СтруктураТовара.Вставить("ХарактеристикаНоменклатуры", Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка());
			СтруктураТовара.Вставить("СерияНоменклатуры", Справочники.СерииНоменклатуры.ПустаяСсылка());
			СписокТоваров.Добавить(СтруктураТовара);
			
			//Если НЕ ТолькоПродукция Тогда //переход на 2.0
				Для Каждого СтрокаТоварЗаказа Из ДокЗаказ.Товары Цикл
					СтруктураТовара = Новый Структура;
					СтруктураТовара.Вставить("Заказ", ДокЗаказ);
					СтруктураТовара.Вставить("Номенклатура", СтрокаТоварЗаказа.Номенклатура);
					СтруктураТовара.Вставить("Количество", СтрокаТоварЗаказа.Количество);
					СтруктураТовара.Вставить("ЕдиницаИзмерения", СтрокаТоварЗаказа.ЕдиницаИзмерения);
					СтруктураТовара.Вставить("ХарактеристикаНоменклатуры", СтрокаТоварЗаказа.ХарактеристикаНоменклатуры);
					СтруктураТовара.Вставить("СерияНоменклатуры", СтрокаТоварЗаказа.СерияНоменклатуры);
					СписокТоваров.Добавить(СтруктураТовара);
				КонецЦикла;
			//КонецЕсли; //переход на 2.0
		ИначеЕсли ДокЗаказ.ВидЗаказа = Перечисления.ВидыЗаказовНаПроизводство.ТиповоеПроизводство Тогда
			Для Каждого СтрокаТоварЗаказа Из ДокЗаказ.Продукция Цикл
				СтруктураТовара = Новый Структура;
				СтруктураТовара.Вставить("Заказ", ДокЗаказ);
				СтруктураТовара.Вставить("Номенклатура", СтрокаТоварЗаказа.Номенклатура);
				СтруктураТовара.Вставить("Количество", СтрокаТоварЗаказа.Количество);
				СтруктураТовара.Вставить("ЕдиницаИзмерения", СтрокаТоварЗаказа.ЕдиницаИзмерения);
				СтруктураТовара.Вставить("ХарактеристикаНоменклатуры", Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка());
				СтруктураТовара.Вставить("СерияНоменклатуры", Справочники.СерииНоменклатуры.ПустаяСсылка());
				СписокТоваров.Добавить(СтруктураТовара);
			КонецЦикла;
			//Если НЕ ТолькоПродукция Тогда //переход на 2.0
				Для Каждого СтрокаТоварЗаказа Из ДокЗаказ.Товары Цикл
					СтруктураТовара = Новый Структура;
					СтруктураТовара.Вставить("Заказ", ДокЗаказ);
					СтруктураТовара.Вставить("Номенклатура", СтрокаТоварЗаказа.Номенклатура);
					СтруктураТовара.Вставить("Количество", СтрокаТоварЗаказа.Количество);
					СтруктураТовара.Вставить("ЕдиницаИзмерения", СтрокаТоварЗаказа.ЕдиницаИзмерения);
					СтруктураТовара.Вставить("ХарактеристикаНоменклатуры", СтрокаТоварЗаказа.ХарактеристикаНоменклатуры);
					СтруктураТовара.Вставить("СерияНоменклатуры", СтрокаТоварЗаказа.СерияНоменклатуры);
					СписокТоваров.Добавить(СтруктураТовара);
				КонецЦикла;
			//КонецЕсли; //переход на 2.0
		КонецЕсли;
	КонецЦикла;
	
	Возврат СписокТоваров;
	
КонецФункции

&НаКлиенте
Процедура ГруппаСтраницыПриСменеСтраницы(Элемент, ТекущаяСтраница)
		
	Элементы.ЗаказНаПроизводствоКоманднаяПанель.Видимость 	  = (ТекущаяСтраница = Элементы.ГруппаВсе);
	Элементы.ЗаказПокупателяКоманднаяПанель.Видимость 		  = (ТекущаяСтраница = Элементы.ГруппаЗаказыПокупателей);														 
	Элементы.ЗаявкаНаДоставкуКоманднаяПанель.Видимость 		  = (ТекущаяСтраница = Элементы.ГруппаДоставки);
	Элементы.ВозвратПродукцииКоманднаяПанель.Видимость 		  = (ТекущаяСтраница = Элементы.ГруппаВозвратыПродукции);
	Элементы.РеализацияТоваровИУслугКоманднаяПанель.Видимость   = (ТекущаяСтраница = Элементы.ГруппаРеализации);
	Элементы.ВозвратТовараОтПокупателяКоманднаяПанель.Видимость = (ТекущаяСтраница = Элементы.ГруппаВозвратТовараОтПокупателя);
	Элементы.ВыпускПродукцииКоманднаяПанель.Видимость 		  = (ТекущаяСтраница = Элементы.ГруппаВыпуски);
	
	Если ТекущаяСтраница = Элементы.ГруппаВсе  Тогда
		
		// №13525 Активизируемся на списке
		ЭтаФорма.ТекущийЭлемент = Элементы.СписокВсе;
			
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтправитьСМС(Команда)
	Если ОбщийМодульВызовСервера.ЕстьТелефонКонтрагента(Элементы.СписокЗаказыПокупателей.ТекущиеДанные.Ссылка) Тогда	
		Парам = Новый Структура;
		Парам.Вставить("Основание", Элементы.СписокЗаказыПокупателей.ТекущиеДанные.Ссылка);
		ОткрытьФорму("Документ.ОтправкаСМС.Форма.ФормаДокумента",Парам);		
	Иначе
		ПоказатьОповещениеПользователя("У контрагента в карточке не указан номер телефона. СМС не создана");
	КонецЕсли;
КонецПроцедуры

