&НаКлиенте
Процедура ПослеВопросаИзменитьСтатусЗаказовПокупателейНаОтменен(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли;
	
	МассивЗаказовПокупателей = ДополнительныеПараметры.МассивЗаказовПокупателей;
	
	//#16857
	Если ИспользоватьРезервирование Тогда
		
		Для каждого ЗаказСсылка из МассивЗаказовПокупателей Цикл		
			
			ОстаткиПоРезервам = ОстаткиПоРезервам(ЗаказСсылка);
			Если ОстаткиПоРезервам.Количество() > 0 Тогда	
				
				ДополнительныеПараметры = Новый Структура;
				ДополнительныеПараметры.Вставить("ЗаказСсылка", ЗаказСсылка);
				ДополнительныеПараметры.Вставить("ОстаткиПоРезервам", ОстаткиПоРезервам);
				
				Отказ = Истина;
				ОписаниеОповещения = Новый ОписаниеОповещения("СписаниеРезервовПриОтменеПодтверждениеПередЗаписью", ЭтотОбъект, ДополнительныеПараметры);
				
				ТекстВопроса = СтрШаблон("По заказу %1 числятся неисполненные резервы:%2", ЗаказСсылка, Символы.ПС);
				
				Для каждого Выборка из ОстаткиПоРезервам Цикл
					ТекстВопроса = ТекстВопроса + СтрШаблон("%1%2%3, склад %4, в количестве %5",
						Выборка.Номенклатура,
						?(НЕ ЗначениеЗаполнено(Выборка.ХарактеристикаНоменклатуры), "", ", Характеристика: " + Выборка.ХарактеристикаНоменклатуры),
						?(НЕ ЗначениеЗаполнено(Выборка.СерияНоменклатуры), "", ", Серия: " + Выборка.СерияНоменклатуры),
						Выборка.Склад,
						Выборка.Количество)
						+ Символы.ПС;
				КонецЦикла;
				ТекстВопроса = ТекстВопроса + Символы.ПС + "Создать документ ""Снятие резервов""?";	
				
				ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
									
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	// в результате выполнения процедуры в МассивЗаказовПокупателей остаются заказы, по которым удалось изменить статус
	ИзменитьСтатусЗаказовПокупателейНаСервере(МассивЗаказовПокупателей, ПредопределенноеЗначение("Справочник.СтатусыЗаказовПокупателей.Отменен"));
	Элементы.СписокЗаказыПокупателей.Обновить();
	ПоказатьОповещениеПользователя("Выполнено");
	Если МассивЗаказовПокупателей.Количество() > 0 Тогда
		
		МассивЗНПКОтмене = ПолучитьСписокЗаказовНаПроизводствоКОтмене(МассивЗаказовПокупателей);		
		Если МассивЗНПКОтмене.Количество() > 0 Тогда		
			ОбщийМодульКлиент.ПеревестиЗаказыНаПроизводствоВСтатусОтменен(МассивЗНПКОтмене);
		КонецЕсли;
		
	КонецЕсли;
		
КонецПроцедуры

&НаСервере
Функция ПолучитьСписокЗаказовНаПроизводствоКОтмене(МассивЗаказовПокупателей)
	
	Возврат ОбщийМодульВызовСервера.ПолучитьСписокЗаказовНаПроизводствоКОтмене(МассивЗаказовПокупателей);
	
КонецФункции

&НаКлиенте
Процедура СписаниеРезервовПриОтменеПодтверждениеПередЗаписью(ОтветНаВопрос, ДополнительныеПараметры) Экспорт
	
	// если пользователь отказался снимать резервы, то все равно переводим в "Отменен"
		
	Отказ = Ложь;
	
	Если ОтветНаВопрос = КодВозвратаДиалога.Да Тогда
		ФормаСР = ПолучитьФорму("Документ.СнятиеРезервов.ФормаОбъекта", , , Новый УникальныйИдентификатор);	
		ДанныеФормы = ФормаСР.Объект; 
		ЗаполнитьДокументСнятиеРезервовНаСервере(ДанныеФормы, ДополнительныеПараметры.ЗаказСсылка);
		КопироватьДанныеФормы(ДанныеФормы, ФормаСР.Объект);
		ФормаСР.Открыть();
	КонецЕсли;

КонецПроцедуры

&НаСервереБезКонтекста
Процедура ЗаполнитьДокументСнятиеРезервовНаСервере(ДанныеФормы, ЗаказСсылка)
	
	НовыйДокумент = Документы.СнятиеРезервов.СоздатьДокумент();
	НовыйДокумент.Дата = ТекущаяДата();   
	НовыйДокумент.Заполнить(ЗаказСсылка);
	
	ЗначениеВДанныеФормы(НовыйДокумент, ДанныеФормы); 
	
КонецПроцедуры

#КонецОбласти

&НаКлиенте
Процедура СписокЗаказыПокупателейВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	// СтандартныеПодсистемы.УчетОригиналовПервичныхДокументов
	УчетОригиналовПервичныхДокументовКлиент.СписокВыбор(Поле.Имя, ЭтотОбъект, Элементы.СписокЗаказыПокупателей, СтандартнаяОбработка);
	// Конец СтандартныеПодсистемы.УчетОригиналовПервичныхДокументов

	Если Поле.Имя = "СписокЗаказыПокупателейЗаказанВПроизводство" Тогда
		СтандартнаяОбработка = Ложь;
		ЗначениеОтбора = Новый Структура("ДокументОснование", ВыбраннаяСтрока);
		ПараметрыВыбора = Новый Структура("Отбор", ЗначениеОтбора);
		
		ОткрытьФорму("Документ.ЗаказНаПроизводство.ФормаСписка", ПараметрыВыбора,,Новый УникальныйИдентификатор);
	КонецЕсли;
	
КонецПроцедуры
		
&НаСервереБезКонтекста
Процедура СписокЗаказыПокупателейПриПолученииДанныхНаСервере(ИмяЭлемента, Настройки, Строки)
	
	// СтандартныеПодсистемы.УчетОригиналовПервичныхДокументов
	УчетОригиналовПервичныхДокументов.ПриПолученииДанныхНаСервере(Строки); 
	// Конец СтандартныеПодсистемы.УчетОригиналовПервичныхДокументов

	МассивСсылок = Строки.ПолучитьКлючи();
	Если МассивСсылок.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	НастройкаОбщиеСклады = Настройки.ДополнительныеСвойства.НастройкаОбщиеСклады;
	
	// когда ЕстьОтборПо..., то заменяется текст запроса и колонка вычисляется в запросе
	ЕстьОтборПоОплате = Настройки.ДополнительныеСвойства.Свойство("ОтборПоОплате") И НЕ Настройки.ДополнительныеСвойства.ОтборПоОплате = -1;
	ЕстьОтборПоОтгрузке = Настройки.ДополнительныеСвойства.Свойство("ОтборПоОтгрузке") И НЕ Настройки.ДополнительныеСвойства.ОтборПоОтгрузке = -1;
	ЕстьОтборПоПроизводству = Настройки.ДополнительныеСвойства.Свойство("ОтборПоПроизводству") И НЕ Настройки.ДополнительныеСвойства.ОтборПоОтгрузке = -2;
	ЕстьОтборПоЗакупке = Настройки.ДополнительныеСвойства.Свойство("ОтборПоЗакупке") И НЕ Настройки.ДополнительныеСвойства.ОтборПоЗакупке = -2;
	ЕстьОтборПоОбеспеченности = Настройки.ДополнительныеСвойства.Свойство("ОтборПоОбеспеченности") И НЕ Настройки.ДополнительныеСвойства.ОтборПоОбеспеченности = -1;

	КэшКолонок = Новый Структура;
	СтрокаДС = Строки.Получить(МассивСсылок[0]);
	КэшКолонок.Вставить("ЕстьКолонкаОплачено", 	СтрокаДС.Данные.Свойство("Оплачено"));
	КэшКолонок.Вставить("ЕстьКолонкаКОплате",  	СтрокаДС.Данные.Свойство("КОплате"));	
	КэшКолонок.Вставить("ЕстьКолонкаСостояниеОплаты",  	СтрокаДС.Данные.Свойство("СостояниеОплаты") И НЕ ЕстьОтборПоОплате); 
	КэшКолонок.Вставить("ЕстьКолонкиОплат",    	КэшКолонок.ЕстьКолонкаОплачено ИЛИ КэшКолонок.ЕстьКолонкаКОплате ИЛИ КэшКолонок.ЕстьКолонкаСостояниеОплаты);	
	КэшКолонок.Вставить("ЕстьКолонкаДолг",  	СтрокаДС.Данные.Свойство("ДолгКонтрагента"));
	КэшКолонок.Вставить("ЕстьКолонкаДолгСЗаказамиВРаботе", СтрокаДС.Данные.Свойство("ДолгСУчетомЗаказовВРаботе"));
	КэшКолонок.Вставить("ЕстьКолонкиДолга",    	КэшКолонок.ЕстьКолонкаДолг ИЛИ КэшКолонок.ЕстьКолонкаДолгСЗаказамиВРаботе);
	КэшКолонок.Вставить("ЕстьКолонкаОтгружен",  СтрокаДС.Данные.Свойство("Отгружен"));
	КэшКолонок.Вставить("ЕстьКолонкаПроизводство",  СтрокаДС.Данные.Свойство("Производство"));
	КэшКолонок.Вставить("ЕстьКолонкаСМС", 		СтрокаДС.Данные.Свойство("СМСОтправлено"));
	КэшКолонок.Вставить("ЕстьКолонкаПотолкиВНаличии", СтрокаДС.Данные.Свойство("ПотолкиВНаличии"));
	КэшКолонок.Вставить("ЕстьКолонкаСтатусЗакупки",   СтрокаДС.Данные.Свойство("СтатусЗакупки"));
	КэшКолонок.Вставить("ЕстьКолонкаСостояниеОбеспеченности",   СтрокаДС.Данные.Свойство("СостояниеОбеспеченности"));

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("МассивСсылок", МассивСсылок);
	Запрос.УстановитьПараметр("ОбщиеСклады",  НастройкаОбщиеСклады);
	МассивНеобходимыхЗапросов = Новый Массив;
	// оплаты
	Если КэшКолонок.ЕстьКолонкиОплат Тогда
		МассивНеобходимыхЗапросов.Добавить(0); 	
	КонецЕсли;
	// долг контрагента и долг с учетом заказов в работе
	Если КэшКолонок.ЕстьКолонкиДолга Тогда
		МассивНеобходимыхЗапросов.Добавить(1);
	КонецЕсли;
	// показатель "Отгружен"
	// условие "НЕ ЕстьОтборПоОтгрузке" помещаем сюда а не в вычисление КэшКолонок.ЕстьКолонкаОтгружен, так как КэшКолонок.ЕстьКолонкаОтгружен используется не только здесь
	Если КэшКолонок.ЕстьКолонкаОтгружен И НЕ ЕстьОтборПоОтгрузке Тогда
		МассивНеобходимыхЗапросов.Добавить(3); 
	КонецЕсли;	
	// показатель "СМС отправлено"
	Если КэшКолонок.ЕстьКолонкаСМС Тогда
		МассивНеобходимыхЗапросов.Добавить(4); 
	КонецЕсли;
	// показатель "ПотолкиВНаличии"
	Если КэшКолонок.ЕстьКолонкаПотолкиВНаличии Тогда
		МассивНеобходимыхЗапросов.Добавить(5); 
	КонецЕсли;
	
	// по интеркампани
	Если КэшКолонок.ЕстьКолонкаПроизводство И КэшКолонок.ЕстьКолонкаОтгружен Тогда
		МассивНеобходимыхЗапросов.Добавить(6); 
	КонецЕсли;
	
	// показатель "СтатусЗакупки"
	Если КэшКолонок.ЕстьКолонкаСтатусЗакупки И НЕ ЕстьОтборПоЗакупке Тогда
		МассивНеобходимыхЗапросов.Добавить(7); 
	КонецЕсли;
	
	// показатель "Производство"
	// условие "НЕ ЕстьОтборПоПроизводству" помещаем сюда а не в вычисление КэшКолонок.ЕстьКолонкаПроизводство, так как КэшКолонок.ЕстьКолонкаПроизводство используется не только здесь
	Если КэшКолонок.ЕстьКолонкаПроизводство И НЕ ЕстьОтборПоПроизводству Тогда
		МассивНеобходимыхЗапросов.Добавить(8); 
	КонецЕсли;
	
	Если КэшКолонок.ЕстьКолонкаСостояниеОбеспеченности И НЕ ЕстьОтборПоОбеспеченности Тогда
		МассивНеобходимыхЗапросов.Добавить(9); 
	КонецЕсли;	
	
	Если МассивНеобходимыхЗапросов.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Запрос.Текст = Документы.ЗаказПокупателя.ПолучитьТекстЗапросаСписка(МассивНеобходимыхЗапросов);
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	УказательЗапроса = 1;
	
	Если КэшКолонок.ЕстьКолонкиОплат Тогда
		ВыборкаОплачено = РезультатЗапроса[УказательЗапроса].Выбрать();
		Пока ВыборкаОплачено.Следующий() Цикл
			СтрокаСписка = Строки[ВыборкаОплачено.Ссылка];
			Если КэшКолонок.ЕстьКолонкаОплачено Тогда
				СтрокаСписка.Данные["Оплачено"] = ВыборкаОплачено.Оплачено;
			КонецЕсли;
			Если КэшКолонок.ЕстьКолонкаКОплате Тогда
				СтрокаСписка.Данные["КОплате"] = ВыборкаОплачено.КОплате;
			КонецЕсли;
			Если КэшКолонок.ЕстьКолонкаСостояниеОплаты Тогда
				СтрокаСписка.Данные["СостояниеОплаты"] = ВыборкаОплачено.СостояниеОплаты;
			КонецЕсли;
		КонецЦикла;
		
		УказательЗапроса = УказательЗапроса + 1;
	КонецЕсли;
	
	Если КэшКолонок.ЕстьКолонкиДолга Тогда
		УказательЗапроса = УказательЗапроса + 1; // в запросе есть вспомогательный запрос
		ВыборкаДолг = РезультатЗапроса[УказательЗапроса].Выбрать();
		Пока ВыборкаДолг.Следующий() Цикл
			СтрокаСписка = Строки[ВыборкаДолг.Ссылка];
			Если КэшКолонок.ЕстьКолонкаДолг Тогда
				СтрокаСписка.Данные["ДолгКонтрагента"] = ВыборкаДолг.ДолгКонтрагента;
			КонецЕсли;
			Если КэшКолонок.ЕстьКолонкаДолгСЗаказамиВРаботе Тогда
				СтрокаСписка.Данные["ДолгСУчетомЗаказовВРаботе"] = ВыборкаДолг.ДолгСУчетомЗаказовВРаботе;
			КонецЕсли;
		КонецЦикла;
		
		УказательЗапроса = УказательЗапроса + 1;
	КонецЕсли;
		
	Если КэшКолонок.ЕстьКолонкаОтгружен И НЕ ЕстьОтборПоОтгрузке Тогда
		ВыборкаОтгружено = РезультатЗапроса[УказательЗапроса].Выбрать();
		Пока ВыборкаОтгружено.Следующий() Цикл
			СтрокаСписка = Строки[ВыборкаОтгружено.Ссылка];
			СтрокаСписка.Данные["Отгружен"] = ВыборкаОтгружено.Отгружен;
		КонецЦикла;
		
		УказательЗапроса = УказательЗапроса + 1;
	КонецЕсли;
	
	////возвращено в запрос списка для возможности фильтрации. заявка #3948
	////Пока ВыборкаПроизведен.Следующий() Цикл
	////	СтрокаСписка = Строки[ВыборкаПроизведен.Ссылка];
	////	Если СтрокаСписка.Данные.Свойство("Произведен") Тогда
	////		СтрокаСписка.Данные["Произведен"] = ВыборкаПроизведен.Произведен;
	////	Иначе
	////		Прервать;
	////	КонецЕсли;
	////КонецЦикла;

	Если КэшКолонок.ЕстьКолонкаСМС Тогда
		ВыборкаСМСОтправлено = РезультатЗапроса[УказательЗапроса].Выбрать();
		Пока ВыборкаСМСОтправлено.Следующий() Цикл
			СтрокаСписка = Строки[ВыборкаСМСОтправлено.Ссылка];
			СтрокаСписка.Данные["СМСОтправлено"] = ВыборкаСМСОтправлено.СМСОтправлено;
		КонецЦикла;
		
		УказательЗапроса = УказательЗапроса + 1;
	КонецЕсли;
	
	Если КэшКолонок.ЕстьКолонкаПотолкиВНаличии Тогда
		УказательЗапроса = УказательЗапроса + 1; // в запросе есть вспомогательный запрос
		ВыборкаПотолкиВНаличии = РезультатЗапроса[УказательЗапроса].Выбрать();
		Пока ВыборкаПотолкиВНаличии.Следующий() Цикл
			СтрокаСписка = Строки[ВыборкаПотолкиВНаличии.Ссылка];
			СтрокаСписка.Данные["ПотолкиВНаличии"] = ВыборкаПотолкиВНаличии.ПотолкиВНаличии;
			
			// №7702 комментируем, т.к. индикация "ЗаказВПроизводство" переведена в "Производство"
			//Если СтрокаСписка.Данные.Свойство("ЗаказанВПроизводство") Тогда
			//	СтрокаСписка.Данные["ЗаказанВПроизводство"] = ВыборкаПотолкиВНаличии.ЗаказанВПроизводство;
			//КонецЕсли;
		КонецЦикла;
		
		УказательЗапроса = УказательЗапроса + 1;
	КонецЕсли;
	
	//Индикация "Отгружен" если в интеркампани одна организация производит и продаёт
	Если КэшКолонок.ЕстьКолонкаПроизводство И КэшКолонок.ЕстьКолонкаОтгружен Тогда
		ВыборкаОтгруженоОднаОрганизацияПроизводитИПродает = РезультатЗапроса[УказательЗапроса].Выбрать(); 
		Пока ВыборкаОтгруженоОднаОрганизацияПроизводитИПродает.Следующий() Цикл
			СтрокаСписка = Строки[ВыборкаОтгруженоОднаОрганизацияПроизводитИПродает.Ссылка];
			// №7702 комментируем, т.к. индикация "ЗаказВПроизводство" и "Произведен" переведена в единый "Производство"
			//Если СтрокаСписка.Данные.Свойство("ЗаказанВПроизводство") И СтрокаСписка.Данные.Свойство("Произведен") Тогда
			//	Если СтрокаСписка.Данные["ЗаказанВПроизводство"] = 0 И СтрокаСписка.Данные["Произведен"] = 0 Тогда
			//		СтрокаСписка.Данные["Отгружен"]	= 0;
			//	КонецЕсли;
			//КонецЕсли;
			Если СтрокаСписка.Данные["Производство"] = 0 Тогда
				СтрокаСписка.Данные["Отгружен"]	= 0;
			КонецЕсли;
		КонецЦикла;
		УказательЗапроса = УказательЗапроса + 1;
	КонецЕсли;
	
	// №7702 индикация закупки
	Если КэшКолонок.ЕстьКолонкаСтатусЗакупки  И НЕ ЕстьОтборПоЗакупке Тогда
		УказательЗапроса = УказательЗапроса + 1; // в запросе есть вспомогательный запрос
		
		ВыборкаСтатусЗакупки = РезультатЗапроса[УказательЗапроса].Выбрать();
		Пока ВыборкаСтатусЗакупки.Следующий() Цикл
			СтрокаСписка = Строки[ВыборкаСтатусЗакупки.Ссылка];
			СтрокаСписка.Данные["СтатусЗакупки"] = ВыборкаСтатусЗакупки.СтатусЗакупки;
		КонецЦикла;
		
		УказательЗапроса = УказательЗапроса + 1;
	КонецЕсли;
	
	Если КэшКолонок.ЕстьКолонкаПроизводство И НЕ ЕстьОтборПоПроизводству Тогда
		ВыборкаПроизводство = РезультатЗапроса[УказательЗапроса].Выбрать();
		Пока ВыборкаПроизводство.Следующий() Цикл
			СтрокаСписка = Строки[ВыборкаПроизводство.Ссылка];
			СтрокаСписка.Данные["Производство"] = ВыборкаПроизводство.Производство;
		КонецЦикла;
		
		УказательЗапроса = УказательЗапроса + 1;
	КонецЕсли;
	
	Если КэшКолонок.ЕстьКолонкаСостояниеОбеспеченности И НЕ ЕстьОтборПоОбеспеченности Тогда
		//++ №13231
		//УказательЗапроса = УказательЗапроса + 2; // в запросе есть вспомогательные запросы
		УказательЗапроса = УказательЗапроса + 3; // в запросе есть вспомогательные запросы
		//-- №13231
		ВыборкаОбеспеченность = РезультатЗапроса[УказательЗапроса].Выбрать();
		Пока ВыборкаОбеспеченность.Следующий() Цикл
			СтрокаСписка = Строки[ВыборкаОбеспеченность.Ссылка];
			СтрокаСписка.Данные["СостояниеОбеспеченности"] = ВыборкаОбеспеченность.СостояниеОбеспеченности;
		КонецЦикла;
		
		УказательЗапроса = УказательЗапроса + 1;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

