&НаСервере
Функция ПроверитьВозможностьПеремещенияПоОрганизациям(СписокДокЗаказов)
	
	Если Константы.ОбщиеСклады.Получить() Тогда
		Возврат Истина;
	КонецЕсли;
	
	Если СписокДокЗаказов.Количество() = 0 Тогда
		Возврат Истина;
	КонецЕсли;
	
	ВремОрганизация = СписокДокЗаказов.Получить(0).Значение.Организация;
	Для НомерСтроки = 0 По СписокДокЗаказов.Количество()-1 Цикл
		Если НЕ ВремОрганизация = СписокДокЗаказов.Получить(НомерСтроки).Значение.Организация Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

&НаСервере
Функция ПроверитьВозможностьПеремещенияПоСкладам(СписокДокЗаказов)
	
	Если СписокДокЗаказов.Количество() = 0 Тогда
		Возврат Истина;
	КонецЕсли;
	
	ВремСклад = СписокДокЗаказов.Получить(0).Значение.Склад;
	Для НомерСтроки = 0 По СписокДокЗаказов.Количество()-1 Цикл
		Если НЕ ВремСклад = СписокДокЗаказов.Получить(НомерСтроки).Значение.Склад Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

