&НаКлиенте
Процедура СписокВсеПриАктивизацииСтроки(Элемент)
	
	ТекущиеДанные = Элемент.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	// #10994 если для списка настроена группировка (Еще - Настроить список - вкладка Группировка),
	// то у строки группировки не будет реквизита
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ТекущиеДанные, "ВидЗаказа") Тогда 		
		Если (ТекущиеДанные.ВидЗаказа = ПредопределенноеЗначение("Перечисление.ВидыЗаказовНаПроизводство.ЗаказНаПродажу") 
			ИЛИ ТекущиеДанные.ВидЗаказа = ПредопределенноеЗначение("Перечисление.ВидыЗаказовНаПроизводство.Перезаказ")) Тогда
			//Элементы.СписокВРаботеПеревестиВСтатусВПроизводстве3.Доступность = Ложь;
			Элементы.СписокВРаботеПеревестиВСтатусПроизведен4.Доступность = Ложь;
		Иначе
			//Элементы.СписокВРаботеПеревестиВСтатусВПроизводстве3.Доступность = Истина;
			Элементы.СписокВРаботеПеревестиВСтатусПроизведен4.Доступность = Истина;
		КонецЕсли;
	Иначе
		//Элементы.СписокВРаботеПеревестиВСтатусВПроизводстве3.Доступность = Ложь;
		Элементы.СписокВРаботеПеревестиВСтатусПроизведен4.Доступность = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура СписокВсеПриПолученииДанныхНаСервере(ИмяЭлемента, Настройки, Строки)
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("МассивСсылок",Строки.ПолучитьКлючи());
	
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЗаказыОбороты.ЗаказНаПроизводство КАК Ссылка,
	|	ВЫБОР
	|		КОГДА ЗаказыОбороты.КоличествоПриход > 0
	|				И ЗаказыОбороты.КоличествоРасход = ЗаказыОбороты.КоличествоПриход
	|			ТОГДА 0
	|		КОГДА ЗаказыОбороты.КоличествоПриход > 0
	|				И ЗаказыОбороты.КоличествоРасход > 0
	|				И ЗаказыОбороты.КоличествоРасход < ЗаказыОбороты.КоличествоПриход
	|			ТОГДА 1
	|		ИНАЧЕ 2
	|	КОНЕЦ КАК СостояниеВыпуска
	|ИЗ
	|	РегистрНакопления.ЗаказыНаПроизводство.Обороты(, , , ЗаказНаПроизводство В (&МассивСсылок)) КАК ЗаказыОбороты";
	
	//РезультатЗапроса = Запрос.ВыполнитьПакет();	
	РезультатЗапроса = Запрос.Выполнить();
		
	//ВыборкаПроизведен = РезультатЗапроса[0].Выбрать();
	ВыборкаПроизведен = РезультатЗапроса.Выбрать();
		
	Пока ВыборкаПроизведен.Следующий() Цикл
		СтрокаСписка = Строки[ВыборкаПроизведен.Ссылка];
		Если СтрокаСписка.Данные.Свойство("СостояниеВыпуска") Тогда
			СтрокаСписка.Данные["СостояниеВыпуска"] = ВыборкаПроизведен.СостояниеВыпуска;
		Иначе
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

