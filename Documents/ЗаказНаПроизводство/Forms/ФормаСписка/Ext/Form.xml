	<Attributes>
		<Attribute name="Список" id="1">
			<Type>
				<v8:Type>cfg:DynamicList</v8:Type>
			</Type>
			<MainAttribute>true</MainAttribute>
			<UseAlways>
				<Field>~Список.Ref</Field>
				<Field>Список.АдресМонтажаЗаказаПокупателя</Field>
				<Field>Список.ДокументОснование</Field>
				<Field>Список.Ссылка</Field>
			</UseAlways>
			<Settings xsi:type="DynamicList">
				<ManualQuery>true</ManualQuery>
				<DynamicDataRead>true</DynamicDataRead>
				<QueryText>ВЫБРАТЬ
	ДокументЗаказНаПроизводство.Ссылка КАК Ссылка,
	ДокументЗаказНаПроизводство.ПометкаУдаления КАК ПометкаУдаления,
	ДокументЗаказНаПроизводство.Номер КАК Номер,
	ДокументЗаказНаПроизводство.Дата КАК Дата,
	ДокументЗаказНаПроизводство.Проведен КАК Проведен,
	ВЫРАЗИТЬ(ДокументЗаказНаПроизводство.АдресМонтажа КАК Строка(500)) КАК АдресМонтажа,
	ДокументЗаказНаПроизводство.Валюта КАК Валюта,
	ДокументЗаказНаПроизводство.ВидЦен КАК ВидЦен,
	ДокументЗаказНаПроизводство.ДоговорКонтрагента КАК ДоговорКонтрагента,
	ДокументЗаказНаПроизводство.Комментарий КАК Комментарий,
	ДокументЗаказНаПроизводство.Контрагент КАК Контрагент,
	ДокументЗаказНаПроизводство.ОжидаемаяДатаОтгрузки КАК ОжидаемаяДатаОтгрузки,
	ДокументЗаказНаПроизводство.ОжидаемоеВремяОтгрузки КАК ОжидаемоеВремяОтгрузки,
	ДокументЗаказНаПроизводство.Организация КАК Организация,
	ДокументЗаказНаПроизводство.Автор КАК Автор,
	ДокументЗаказНаПроизводство.Подразделение КАК Подразделение,
	ДокументЗаказНаПроизводство.Склад КАК Склад,
	ДокументЗаказНаПроизводство.СуммаДокумента КАК СуммаДокумента,
	ДокументЗаказНаПроизводство.ТекущийСтатус КАК ТекущийСтатус,
	ДокументЗаказНаПроизводство.ДокументОснование КАК ДокументОснование,
	
	ВЫБОР КОГДА ДокументЗаказНаПроизводство.ДокументОснование ССЫЛКА Документ.ЗаказПокупателя
		ТОГДА ВЫРАЗИТЬ((ВЫРАЗИТЬ(ДокументЗаказНаПроизводство.ДокументОснование КАК Документ.ЗаказПокупателя)).АдресМонтажа КАК Строка(500))
		ИНАЧЕ ""
	КОНЕЦ КАК АдресМонтажаЗаказаПокупателя,
	
	ДокументЗаказНаПроизводство.ЭтоЗаказОтРозницы КАК ЭтоЗаказОтРозницы,
	ДокументЗаказНаПроизводство.ЗаказЗагруженИзПрограммыПостроителя КАК ЗаказЗагруженИзПрограммыПостроителя,
	ДокументЗаказНаПроизводство.ВидЗаказа КАК ВидЗаказа,
	ДОБАВИТЬКДАТЕ(ДокументЗаказНаПроизводство.ОжидаемаяДатаОтгрузки, МИНУТА, МИНУТА(ДокументЗаказНаПроизводство.ОжидаемоеВремяОтгрузки) + ЧАС(ДокументЗаказНаПроизводство.ОжидаемоеВремяОтгрузки) * 60) КАК ДатаОтгрузкиПлановая,
	ВЫБОР
		КОГДА ДокументЗаказНаПроизводство.ВидЗаказа = ЗНАЧЕНИЕ(Перечисление.ВидыЗаказовНаПроизводство.ПроизводствоПотолка)
				ИЛИ ДокументЗаказНаПроизводство.ВидЗаказа = ЗНАЧЕНИЕ(Перечисление.ВидыЗаказовНаПроизводство.ЗаказНаПродажу)
			ТОГДА ВТ_ВыпускПродукци.ДатаОтгрузкиФактическая
		ИНАЧЕ ДАТАВРЕМЯ(1, 1, 1)
	КОНЕЦ КАК ДатаОтгрузкиФактическая,
	ВЫБОР
		КОГДА ДокументЗаказНаПроизводство.ВидЗаказа = ЗНАЧЕНИЕ(Перечисление.ВидыЗаказовНаПроизводство.ПроизводствоПотолка)
			ТОГДА ДокументЗаказНаПроизводство.ПродукцияНоменклатура.Потолок_КоличествоПродукция
	КОНЕЦ КАК ПлощадьПотолка,
	ВЫБОР
		КОГДА ДокументЗаказНаПроизводство.ВидЗаказа = ЗНАЧЕНИЕ(Перечисление.ВидыЗаказовНаПроизводство.ПроизводствоПотолка)
			ТОГДА ДокументЗаказНаПроизводство.ПродукцияНоменклатура.Потолок_КоличествоГарпун
	КОНЕЦ КАК ДлинаГарпуна,
	ДокументЗаказНаПроизводство.Цех КАК Цех,
	ДокументЗаказНаПроизводство.ПродукцияНомерРасчета КАК НомерРасчета
ИЗ
	Документ.ЗаказНаПроизводство КАК ДокументЗаказНаПроизводство
