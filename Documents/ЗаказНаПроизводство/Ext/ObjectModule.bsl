	// №6283
	ИспользоватьКТУВПроизводственныхОперациях = Константы.ИспользоватьКТУВПроизводственныхОперациях.Получить();
	
	СМСОтправлятьПриПереводеВСтатусПроизведен = РаботаССМС.ИспользоватьОтправкуСМС() И РаботаССМС.ОтправлятьСМСКонтрагентуПриПереводеЗаказаНаПроизводствоВСтатусПроизведен();
	
	//#14828
	СозданПриИспользованииПодразделений  = Константы.ИспользоватьПодразделения.Получить();
	
КонецПроцедуры

Процедура ДозаполнитьПоУмолчанию(ДанныеЗаполнения=Неопределено)
	
	Если НЕ ЗначениеЗаполнено(ДанныеЗаполнения) Тогда
		
		РеквизитыПользователя = ОбщийМодульСервер.НастройкиПользователя("Склад, СкладПродукции");
		
		Склад = РеквизитыПользователя.СкладПродукции;
		
		Если Константы.СкладОтгрузкиПотолоковОтличаетсяОтСкладаГотовойПродукции.Получить() Тогда
			//#14947 изменено
			//Объект.СкладОтгрузки = ПараметрыСеанса.ТекущийПользователь.СкладОтгрузки;
			СкладОтгрузки = РеквизитыПользователя.Склад;
		Иначе
			СкладОтгрузки = Склад;
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

