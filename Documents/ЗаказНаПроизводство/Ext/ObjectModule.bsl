Процедура ЗаполнитьПоЗаказуПокупателя(ДанныеЗаполнения, ДопДанныеЗаполнения)
	
	Документы.ЗаказПокупателя.ПроверитьВозможностьВводаНаОснованииЗаказа(ДанныеЗаполнения, , "ЗаказНаПроизводство");
	
	ЭтоПерезаполнение = ДопДанныеЗаполнения.Свойство("ЭтоПерезаполнение") И ДопДанныеЗаполнения.ЭтоПерезаполнение;
	
	ВидЗаказа = ДопДанныеЗаполнения.ВидЗаказа;
	
	ДокументОснование 		= ДанныеЗаполнения;
	Организация 			= ДанныеЗаполнения.Организация;
	Подразделение 			= ДанныеЗаполнения.Подразделение;
	
	Контрагент 				= ДанныеЗаполнения.Контрагент;
	ДоговорКонтрагента 		= ДанныеЗаполнения.ДоговорКонтрагента;
	
	Валюта 					= ДанныеЗаполнения.Валюта;
	Если Валюта.Пустая() Тогда
		Валюта = ПолучитьФункциональнуюОпцию("ВалютаУчета");
	КонецЕсли;

	ВидЦен 					= ДанныеЗаполнения.ВидЦен;
	ЭтоЗаказОтРозницы 		= ДанныеЗаполнения.ЭтоЗаказОтРозницы;
	НастройкаИнтеркампани 	= ДанныеЗаполнения.НастройкаИнтеркампани;
	ВнутреннийЗаказ 		= ДанныеЗаполнения.ВнутреннийЗаказ;
		
	Если Константы.ПереноситьКомментарийИзЗаказаПокупателяВЗаказНаПроизводство.Получить() Тогда
		Комментарий 		= ДанныеЗаполнения.Комментарий;
	КонецЕсли;
	
	СкладМатериалов 		= ДанныеЗаполнения.СкладМатериалов;
	СкладОтгрузки 			= ДанныеЗаполнения.Склад;
	Если НЕ Константы.СкладОтгрузкиПотолоковОтличаетсяОтСкладаГотовойПродукции.Получить() Тогда
		Склад = СкладОтгрузки;
	Иначе
		Если НЕ ЭтоПерезаполнение И ДопДанныеЗаполнения.Свойство("Склад") Тогда
			Склад = ДопДанныеЗаполнения.Склад;
		КонецЕсли;
	КонецЕсли;
	
	Если ДопДанныеЗаполнения.Свойство("Срочно") Тогда		
		СрочныйЗаказ = ДопДанныеЗаполнения.Срочно; // №13803 было: ДанныеЗаполнения.СрочныйЗаказ; 
	КонецЕсли; 
	
	ЗаказЗагруженИзПрограммыПостроителя = Ложь;					
	Если ДопДанныеЗаполнения.Свойство("АдресМонтажа") Тогда		
		АдресМонтажа = ДопДанныеЗаполнения.АдресМонтажа; 
	КонецЕсли; 
	
	Если ЭтоПерезаполнение Тогда	
		//++ №14923 если это перезаполнение, значит мы намеренно разрешили перезаполнить заказ на производство
		// поэтому меняем статус на "В производстве"
		// не меняем в рамках той же заявки 
		//ТекущийСтатус = Справочники.СтатусыЗаказовНаПроизводство.ВПроизводстве;		
		//-- №14923
	Иначе
		Если НесколькоТочекПроизводства И ДопДанныеЗаполнения.Свойство("Цех") Тогда
			Цех = ДопДанныеЗаполнения.Цех;
		КонецЕсли;
		
		//++ 13265 дата отгрузки идёт из формы
		Если ДопДанныеЗаполнения.Свойство("ДатаОтгрузки") Тогда
			ОжидаемаяДатаОтгрузки = ДопДанныеЗаполнения.ДатаОтгрузки;
			ОжидаемоеВремяОтгрузки = ДопДанныеЗаполнения.ДатаОтгрузки;
		КонецЕсли;
		//-- №13265
	КонецЕсли;
	
	//ПРОДУКЦИЯ
	Продукция.Очистить();
	
	Если ВидЗаказа = Перечисления.ВидыЗаказовНаПроизводство.ПроизводствоПотолка Тогда
		
		//ПОТОЛОК 
		ПродукцияНоменклатура = ДопДанныеЗаполнения.Номенклатура;
		ПродукцияНоменклатураКоэффициент = ДопДанныеЗаполнения.Коэффициент;
		ПродукцияНоменклатураЕдиницаИзмерения = ДопДанныеЗаполнения.ЕдиницаИзмерения;
		ПродукцияНоменклатураКоличество = ДопДанныеЗаполнения.Количество;
		ПродукцияЦена  = ДопДанныеЗаполнения.Цена;
		ПродукцияСумма = ДопДанныеЗаполнения.Сумма;
		ПродукцияПроцентРучнойСкидки = ДопДанныеЗаполнения.ПроцентРучнойСкидки;
		ПродукцияСуммаРучнойСкидки 	 = ДопДанныеЗаполнения.СуммаРучнойСкидки;
		ПродукцияУИСтроки = ДопДанныеЗаполнения.УИСтроки;
		
		ПродукцияНомерРасчета = ДопДанныеЗаполнения.Номенклатура.Потолок_НомерРасчета;
		Если Справочники.ВидыНоменклатуры.ЭтоНоменклатураПродукция(ДопДанныеЗаполнения.Номенклатура) Тогда
			// №12232 конструкция просто добавляется
		
		Иначе			
			ОписаниеОшибки = "";
			Потолок = ОбменСEasyCeiling.ПолучитьСтруктуруПотолка(ДопДанныеЗаполнения.Номенклатура,,, Ложь,,,, ОписаниеОшибки);
			Если Потолок = Неопределено Тогда
				ТекстОшибки = "Не удалось получить параметры потолка по номенклатуре " + ДопДанныеЗаполнения.Номенклатура;
				//Сообщить(ТекстОшибки); 
				//Продолжить;
				ВызватьИсключение ТекстОшибки;
			КонецЕсли;
			Если ЗначениеЗаполнено(ОписаниеОшибки) Тогда
				//Сообщить(ОписаниеОшибки);
				//Возврат СтруктураРезультата;
				ВызватьИсключение ОписаниеОшибки;
			КонецЕсли;
			
			ПродукцияНомерРасчета = Потолок.НомерРасчетаЗаказа;
			ДанныеФайлаИмпорта = Потолок.ДанныеФайла;
			
			Покупатель = СокрЛП(ОбменСEasyCeiling.ПолучитьЗначениеРеквизита(Потолок,"Контрагент"));
			
			// Загружаем фактуру
			ФактураПотолка.Очистить();
			
			Для Каждого СтрокаФактуры Из Потолок.Фактуры Цикл 				
				НоваяСтрокаФактуры = ФактураПотолка.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрокаФактуры, СтрокаФактуры);
				НоваяСтрокаФактуры.ПродукцияКоличество = СтрокаФактуры.КоличествоПродукция;				
			КонецЦикла;
			
		КонецЕсли;
					
	ИначеЕсли ВидЗаказа = Перечисления.ВидыЗаказовНаПроизводство.ТиповоеПроизводство Тогда
		
		НоваяСтрока = Продукция.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ДопДанныеЗаполнения, "Номенклатура, ХарактеристикаНоменклатуры, Количество, ЕдиницаИзмерения, Коэффициент, 
																	|Цена, ПроцентРучнойСкидки, СуммаРучнойСкидки, Сумма, 
																	|УИСтроки, Спецификация");
	КонецЕсли;
	
	//ТОВАРЫ
	Товары.Очистить();
	
	//УСЛУГИ
	Услуги.Очистить();
	//++ #7717 добавим "производственные" услуги
	Для Каждого СтрокаТовара Из ДанныеЗаполнения.Товары Цикл
		Если Справочники.ВидыНоменклатуры.ЭтоНоменклатураУслуга(СтрокаТовара.Номенклатура) 
			И СтрокаТовара.УИСтрокиРодителя = ДопДанныеЗаполнения.УИСтроки
			//И НЕ СтрокаТовара.УИСтрокиРодителя = СтрокаТовара.УИСтроки //???
			Тогда
			СтрокаДокумента = Услуги.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаДокумента, СтрокаТовара);
			СтрокаДокумента.УИСтроки = ДопДанныеЗаполнения.УИСтроки;  
		КонецЕсли;
	КонецЦикла;
	
	//МАТЕРИАЛЫ
	Если НЕ РучнаяКорректировкаМатериалов Тогда
		Материалы.Очистить();
		Для Каждого СтрокаМатериала Из ДанныеЗаполнения.Материалы Цикл
			Если СтрокаМатериала.УИСтроки = ДопДанныеЗаполнения.УИСтроки Тогда
				СтрокаДокумента = Материалы.Добавить();
				ЗаполнитьЗначенияСвойств(СтрокаДокумента, СтрокаМатериала);
				СтрокаДокумента.КоличествоКВыработке = СтрокаМатериала.КоличествоКВыработке;
			КонецЕсли;	
		КонецЦикла;
	КонецЕсли;
	
	//применим, если нужно, скидку на заказ на производство
	Если ДопДанныеЗаполнения.Свойство("ПроцентРучнойСкидки") И НЕ ДопДанныеЗаполнения.ПроцентРучнойСкидки = 0 Тогда
		
		//продукция типового производства
		Для Каждого СтрокаТЧ Из Продукция Цикл
			СтрокаТЧ.ПроцентРучнойСкидки = ДопДанныеЗаполнения.ПроцентРучнойСкидки;
			СуммаБезСкидки = СтрокаТЧ.Количество * СтрокаТЧ.Цена;
			СтрокаТЧ.СуммаРучнойСкидки = СуммаБезСкидки * СтрокаТЧ.ПроцентРучнойСкидки/100;
			СтрокаТЧ.Сумма = СуммаБезСкидки - СтрокаТЧ.СуммаРучнойСкидки;
		КонецЦикла;
		
	КонецЕсли;
	
	//пересчитываем сумму документа
	ПересчитатьСуммуДокумента();
				
					
КонецПроцедуры

Процедура ПересчитатьСуммуДокумента() Экспорт
	
	СуммаДокумента = ПродукцияСумма + Продукция.Итог("Сумма") + Товары.Итог("Сумма") + Услуги.Итог("Сумма");

КонецПроцедуры

#КонецОбласти

#КонецЕсли