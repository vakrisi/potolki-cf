Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	// #13826 
	Для Индекс = 0 по Материалы.Количество()-1 Цикл
		СтрокаТабличнойЧасти = Материалы[Индекс];
		Если Справочники.ВидыНоменклатуры.ЭтоНоменклатураУслуга(СтрокаТабличнойЧасти.Номенклатура) Тогда
			ТекстОшибки = "В строке " + Строка(Индекс+1) + " таблицы ""Материалы"" выбрана номенклатура-услуга";
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки, ЭтотОбъект, "Материалы["+Формат(Индекс, "ЧГ=0")+"].Номенклатура", , Отказ);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Документы.ЗаказПокупателя.ПроверитьЗаполнениеНаОснованииЗаказа(ЭтотОбъект, Отказ, РежимЗаписи);
		
	Если НЕ ВидЗаказа = Перечисления.ВидыЗаказовНаПроизводство.ПроизводствоПотолка Тогда
		ПродукцияНоменклатура = Справочники.Номенклатура.ПустаяСсылка();
		ПродукцияНоменклатураЕдиницаИзмерения = Справочники.ЕдиницыИзмерений.ПустаяСсылка();
		ПродукцияНоменклатураКоличество  = 0;
		ПродукцияНоменклатураКоэффициент = 0;
		ПродукцияНомерРасчета 			 = "";
		ПродукцияПроцентРучнойСкидки	 = 0;
		ПродукцияСумма 					 = 0;
		ПродукцияСуммаРучнойСкидки 		 = 0;
		ПродукцияЦена 					 = 0;
		ФактураПотолка.Очистить();
	КонецЕсли;
	
	//ЗаполнитьНомераПотолков(); 
	
	Если РежимЗаписи = РежимЗаписиДокумента.Проведение 
		И ВидЗаказа = Перечисления.ВидыЗаказовНаПроизводство.ПроизводствоПотолка Тогда
		
		Если Справочники.ВидыНоменклатуры.ЭтоНоменклатураУникальногоПотолкаИлиОтреза(ПродукцияНоменклатура)
			И НЕ ПустаяСтрока(ПродукцияНомерРасчета) Тогда
			
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ЗаказНаПроизводство.Ссылка КАК Ссылка
			|ИЗ
			|	Документ.ЗаказНаПроизводство КАК ЗаказНаПроизводство
			|ГДЕ
			|	ЗаказНаПроизводство.Проведен
			|	И ЗаказНаПроизводство.ПродукцияНомерРасчета = &ПродукцияНомерРасчета
			|	И ЗаказНаПроизводство.ТекущийСтатус <> &ТекущийСтатус
			|	И ЗаказНаПроизводство.Ссылка <> &Ссылка";
			Запрос.УстановитьПараметр("ПродукцияНомерРасчета",ПродукцияНомерРасчета);
			Запрос.УстановитьПараметр("ТекущийСтатус",Справочники.СтатусыЗаказовНаПроизводство.Отменен);
			Запрос.УстановитьПараметр("Ссылка",Ссылка);
			Количество = Запрос.Выполнить().Выбрать().Количество();
			Если Количество > 0 Тогда
				Отказ = Истина;
				Сообщить("По номеру расчета " + ПродукцияНомерРасчета + " уже имеется оформленный заказ на производство. Проведение отменено");
				Возврат;
			КонецЕсли;
			
			
		КонецЕсли;
		
		Если ТекущийСтатус = Справочники.СтатусыЗаказовНаПроизводство.Отменен Тогда
			Если Документы.ЗаказНаПроизводство.ЕстьВыпускПоЗаказу(Ссылка) Тогда
				ТекстОшибки = НСтр("ru='По документу %Заказ% имеется проведенный выпуск продукции. Перевод в статус ""Отменен"" не разрешен'");
				ТекстОшибки = СтрЗаменить(ТекстОшибки, "%Заказ%", Ссылка);	
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки,ЭтотОбъект,,,Отказ);
				Возврат;
			КонецЕсли;
			
		КонецЕсли;
	КонецЕсли;	
	
	//проверим, если нужно, количество запланированных на это время потолков
	Если Константы.КонтролироватьМаксимальноеКоличествоПотолковВЧасКОтгрузке.Получить()
		И НЕ ОжидаемаяДатаОтгрузки = Дата(1,1,1)
		И НЕ ОжидаемоеВремяОтгрузки = Дата(1,1,1)
		И РежимЗаписи = РежимЗаписиДокумента.Проведение
		И ТекущийСтатус = Справочники.СтатусыЗаказовНаПроизводство.ВПроизводстве
 
		Тогда
		
		МаксКоличество = Константы.МаксимальноеКоличествоПотолковВЧасКОтгрузке.Получить();
		МаксЕдиницаИзмерения = Константы.МаксимальноеКоличествоПотолковЕдиницаИзмерения.Получить();
		
		ОжидаемоеВремяОтгрузки_НАЧАЛО = Дата(1, 1, 1, Час(ОжидаемоеВремяОтгрузки), 0, 0);
		ОжидаемоеВремяОтгрузки_КОНЕЦ = 	Дата(1, 1, 1, Час(ОжидаемоеВремяОтгрузки), 59, 59);		
		
		//узнаем количество потолков запланированное на эту дату и этот час / день
		УстановитьПривилегированныйРежим(Истина);
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("ОжидаемаяДатаОтгрузки",			ОжидаемаяДатаОтгрузки);
		Запрос.УстановитьПараметр("ОжидаемоеВремяОтгрузки_НАЧАЛО",	ОжидаемоеВремяОтгрузки_НАЧАЛО);
		Запрос.УстановитьПараметр("ОжидаемоеВремяОтгрузки_КОНЕЦ",	ОжидаемоеВремяОтгрузки_КОНЕЦ);
		Запрос.УстановитьПараметр("ТекущийДокумент",				Ссылка);
		Запрос.УстановитьПараметр("МаксЕдиницаИзмерения",			МаксЕдиницаИзмерения);
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЗаказНаПроизводство.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.ЗаказНаПроизводство КАК ЗаказНаПроизводство
		|ГДЕ
		|	ЗаказНаПроизводство.Проведен
		|	И НЕ ЗаказНаПроизводство.Ссылка = &ТекущийДокумент
		|	И ЗаказНаПроизводство.ОжидаемаяДатаОтгрузки МЕЖДУ НАЧАЛОПЕРИОДА(&ОжидаемаяДатаОтгрузки, ДЕНЬ) И КОНЕЦПЕРИОДА(&ОжидаемаяДатаОтгрузки, ДЕНЬ)
		|	И ВЫБОР
		|			КОГДА &МаксЕдиницаИзмерения = 0
		|				ТОГДА ЗаказНаПроизводство.ОжидаемоеВремяОтгрузки >= &ОжидаемоеВремяОтгрузки_НАЧАЛО
		|						И ЗаказНаПроизводство.ОжидаемоеВремяОтгрузки <= &ОжидаемоеВремяОтгрузки_КОНЕЦ
		|			ИНАЧЕ ИСТИНА
		|		КОНЕЦ";		
		
		Количество = Запрос.Выполнить().Выбрать().Количество();
		
		Если Количество >= МаксКоличество Тогда
			ТекстОшибки = "Допустимое количество заказов к отгрузке в " + ?(МаксЕдиницаИзмерения = 0, "час", "день") + " = " + Формат(МаксКоличество,"ЧГ=") + " шт. Уже запланировано " + Количество + ". Проведение отменено";	
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки,ЭтотОбъект,,,Отказ);
			Возврат;
		КонецЕсли;
		
	КонецЕсли;

	
	Если РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения ИЛИ ПометкаУдаления Тогда
		Если Документы.ЗаказНаПроизводство.ЕстьВыпускПоЗаказу(Ссылка) Тогда
			ТекстОшибки = НСтр("ru='По документу %Заказ% имеется проведенный выпуск продукции. Пометка удаления или отмена проведения не разрешена'");
			ТекстОшибки = СтрЗаменить(ТекстОшибки, "%Заказ%", Ссылка);	
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки,ЭтотОбъект,,,Отказ);
			Возврат;
		КонецЕсли;		
	КонецЕсли;
		
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, Режим)
	
	//проверки
	ПроверятьЗаполнениеКонтрагента = Истина;
	ОднаОрганизацияПроизводстваИПродажиПотолков = Ложь;
	Если НЕ НастройкаИнтеркампани.Пустая() Тогда
		ОднаОрганизацияПроизводстваИПродажиПотолков = НастройкаИнтеркампани.ОднаОрганизацияПроизводстваИПродажиПотолков;
		ПроверятьЗаполнениеКонтрагента 	= НЕ ОднаОрганизацияПроизводстваИПродажиПотолков;
	КонецЕсли;	
	//#7806
	Если ВнутреннийЗаказ Тогда
		НаборКонстант = Константы.СоздатьНабор("ОтображатьКонтрагентаВоВнутреннихЗаказах, ОтображатьЦеныВоВнутреннихЗаказах"); 
		НаборКонстант.Прочитать();
		Если ПроверятьЗаполнениеКонтрагента И НЕ НаборКонстант.ОтображатьКонтрагентаВоВнутреннихЗаказах Тогда
			ПроверятьЗаполнениеКонтрагента = Ложь;
		КонецЕсли;
	КонецЕсли;
	
	//проверим заполнение контрагента
	Если ПроверятьЗаполнениеКонтрагента Тогда
		Если Контрагент.Пустая() Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не заполнено поле ""Контрагент""", ЭтотОбъект, "Контрагент", , Отказ);
			Возврат;
		КонецЕсли;
		
		Если ДоговорКонтрагента.Пустая() Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не заполнено поле ""Договор контрагента""", ЭтотОбъект, "ДоговорКонтрагента", , Отказ);
			Возврат;
		КонецЕсли;
	КонецЕсли;
		
	//НеПроверятьЗаполнениеЦен = НастройкаИнтеркампани.НеУчитыватьСтоимостьВЗаказахНаПроизводство; //Перехо на 2.0
	//Если НЕ НеПроверятьЗаполнениеЦен Тогда //переход на 2.0
	
	//Если НЕ НеПроверятьЗаполнениеЦен Тогда //переход на 2.0
	//Если ВидЦен.Пустая() Тогда
	//	Сообщение = Новый СообщениеПользователю();
	//	Сообщение.Текст = "Не указан вид цен";
	//	Сообщение.Поле = "ВидЦен";
	//	Сообщение.УстановитьДанные(ЭтотОбъект);
	//	Сообщение.Сообщить();
	//	Отказ = Истина;
	//	Возврат;
	//КонецЕсли;
	//КонецЕсли; //переход на 2.0
	
	Если ВидЗаказа = Перечисления.ВидыЗаказовНаПроизводство.ПроизводствоПотолка Тогда
		
		//#12751 закомментировано
		//Если Подразделение.Пустая() Тогда
		//	ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не заполнено поле ""Подразделение""", ЭтотОбъект, "Подразделение", , Отказ);
		//	Возврат;
		//КонецЕсли;
		
		Если ПродукцияНоменклатураКоличество = 0 Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не заполнено поле ""Количество продукции""", ЭтотОбъект, "ПродукцияНоменклатураКоличество", , Отказ);
			Возврат;
		КонецЕсли;
		
		//Если НЕ НеПроверятьЗаполнениеЦен Тогда //переход на 2.0
		//Если НЕ ПродукцияНоменклатура.ВидНоменклатуры = Справочники.ВидыНоменклатуры.ТиповойОтрез Тогда
		//	Если ПродукцияЦена = 0 Тогда
