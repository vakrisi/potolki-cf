#Область АвтоматическоеФормированиеПеремещения

// Формирует или актуализирует документ "Перемещение товаров" при проведении заказа на производство.
//
// Перемещение формируется, когда одновременно выполнены условия:
//   - основанием заказа на производство является заказ покупателя;
//   - склад продукции ("Склад") отличается от склада отгрузки ("СкладОтгрузки") заказа на производство;
//   - текущий статус заказа на производство — "В производстве".
//
// Перемещается только продукция заказа на производство со склада продукции на склад отгрузки.
//
// При повторном проведении заказа:
//   - изменившиеся склады заказа переносятся в склады перемещения;
//   - если склады совпали — перемещение переводится в статус "Отменен";
//   - если склады снова различаются — перемещение возвращается в статус "Заявка".
//
// Заполнение перемещения выполняется штатной обработкой заполнения документа
// "Перемещение товаров" по основанию-заказу на производство.
//
// Параметры:
//   ЗаказОбъект - ДокументОбъект.ЗаказНаПроизводство - проводимый заказ на производство.
//
Процедура СформироватьПеремещениеТоваровПоЗаказу(ЗаказОбъект) Экспорт

	// Условие 1: основание — заказ покупателя.
	ДокументОснование = ЗаказОбъект.ДокументОснование;
	Если НЕ ЗначениеЗаполнено(ДокументОснование)
		ИЛИ НЕ ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.ЗаказПокупателя") Тогда
		Возврат;
	КонецЕсли;

	// Условие 3: статус заказа — "В производстве".
	Если НЕ ЗаказОбъект.ТекущийСтатус = Справочники.СтатусыЗаказовНаПроизводство.ВПроизводстве Тогда
		Возврат;
	КонецЕсли;

	// Перемещение формируется автоматически — снимаем ограничения прав доступа.
	// Привилегированный режим автоматически сбрасывается при выходе из процедуры.
	УстановитьПривилегированныйРежим(Истина);

	СкладОтправитель = ЗаказОбъект.Склад;
	СкладПолучатель  = ЗаказОбъект.СкладОтгрузки;

	// Условие 2: склад продукции отличается от склада отгрузки.
	ТребуетсяПеремещение = ЗначениеЗаполнено(СкладОтправитель)
		И ЗначениеЗаполнено(СкладПолучатель)
		И НЕ СкладОтправитель = СкладПолучатель;

	ПеремещениеСсылка = ПеремещениеТоваровПоЗаказу(ЗаказОбъект.Ссылка);

	Если ТребуетсяПеремещение Тогда
		Если ЗначениеЗаполнено(ПеремещениеСсылка) Тогда
			АктуализироватьПеремещениеТоваров(ПеремещениеСсылка, СкладОтправитель, СкладПолучатель);
		Иначе
			СоздатьПеремещениеТоваровПоЗаказу(ЗаказОбъект.Ссылка);
		КонецЕсли;
	ИначеЕсли ЗначениеЗаполнено(ПеремещениеСсылка) Тогда
		// Склады совпали — отменяем ранее созданное перемещение.
		ОтменитьПеремещениеТоваров(ПеремещениеСсылка);
	КонецЕсли;

КонецПроцедуры

// Возвращает ссылку на ранее сформированное перемещение товаров по заказу на производство.
// Связь определяется по реквизиту "Заказ" табличной части "Товары".
//
// Параметры:
//   ЗаказСсылка - ДокументСсылка.ЗаказНаПроизводство
//
// Возвращаемое значение:
//   ДокументСсылка.ПеремещениеТоваров - найденное перемещение либо пустая ссылка.
//
Функция ПеремещениеТоваровПоЗаказу(ЗаказСсылка)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Заказ", ЗаказСсылка);
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	ПеремещениеТоваровТовары.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ПеремещениеТоваров.Товары КАК ПеремещениеТоваровТовары
	|ГДЕ
	|	ПеремещениеТоваровТовары.Заказ = &Заказ
	|	И НЕ ПеремещениеТоваровТовары.Ссылка.ПометкаУдаления";

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;

	Возврат Документы.ПеремещениеТоваров.ПустаяСсылка();

КонецФункции

// Создаёт и записывает новое перемещение товаров в статусе "Заявка".
// Заполнение (склады, продукция, реквизит "Заказ") выполняет обработка заполнения
// документа "Перемещение товаров" по основанию-заказу на производство.
//
// Параметры:
//   ЗаказСсылка - ДокументСсылка.ЗаказНаПроизводство - заказ-источник для заполнения перемещения.
//
Процедура СоздатьПеремещениеТоваровПоЗаказу(ЗаказСсылка)

	ПеремещениеОбъект = Документы.ПеремещениеТоваров.СоздатьДокумент();
	ПеремещениеОбъект.Заполнить(ЗаказСсылка);

	// Перемещать нечего — документ не создаём.
	Если ПеремещениеОбъект.Товары.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(ПеремещениеОбъект.Дата) Тогда
		ПеремещениеОбъект.Дата = ТекущаяДатаСеанса();
	КонецЕсли;

	// Документ — заявка на перемещение: движений по регистрам не формирует.
	ПеремещениеОбъект.СозданПриИспользованииСтатусовПеремещений = Истина;
	ПеремещениеОбъект.ТекущийСтатус = Перечисления.СтатусыПеремещений.Заявка;

	ПеремещениеОбъект.Записать(РежимЗаписиДокумента.Запись);

КонецПроцедуры

// Актуализирует склады перемещения и возвращает его в статус "Заявка", если он был отменён.
//
// Параметры:
//   ПеремещениеСсылка - ДокументСсылка.ПеремещениеТоваров
//   СкладОтправитель  - СправочникСсылка.Склады - актуальный склад продукции заказа на производство.
//   СкладПолучатель   - СправочникСсылка.Склады - актуальный склад отгрузки заказа на производство.
//
Процедура АктуализироватьПеремещениеТоваров(ПеремещениеСсылка, СкладОтправитель, СкладПолучатель)

	ПеремещениеОбъект = ПеремещениеСсылка.ПолучитьОбъект();

	// Отправленные и полученные перемещения автоматически не изменяем.
	Если НЕ ПеремещениеУправляемоеПоСтатусу(ПеремещениеОбъект.ТекущийСтатус) Тогда
		Возврат;
	КонецЕсли;

	ЕстьИзменения = Ложь;

	Если НЕ ПеремещениеОбъект.СкладОтправитель = СкладОтправитель Тогда
		ПеремещениеОбъект.СкладОтправитель = СкладОтправитель;
		ЕстьИзменения = Истина;
	КонецЕсли;

	Если НЕ ПеремещениеОбъект.СкладПолучатель = СкладПолучатель Тогда
		ПеремещениеОбъект.СкладПолучатель = СкладПолучатель;
		ЕстьИзменения = Истина;
	КонецЕсли;

	// Склады снова различаются — возвращаем заявку из отмены.
	Если ПеремещениеОбъект.ТекущийСтатус = Перечисления.СтатусыПеремещений.Отменен Тогда
		ПеремещениеОбъект.СозданПриИспользованииСтатусовПеремещений = Истина;
		ПеремещениеОбъект.ТекущийСтатус = Перечисления.СтатусыПеремещений.Заявка;
		ЕстьИзменения = Истина;
	КонецЕсли;

	Если ЕстьИзменения Тогда
		ПеремещениеОбъект.Записать(РежимЗаписиДокумента.Запись);
	КонецЕсли;

КонецПроцедуры

// Переводит перемещение в статус "Отменен" (склады заказа совпали).
//
// Параметры:
//   ПеремещениеСсылка - ДокументСсылка.ПеремещениеТоваров
//
Процедура ОтменитьПеремещениеТоваров(ПеремещениеСсылка)

	ПеремещениеОбъект = ПеремещениеСсылка.ПолучитьОбъект();

	Если ПеремещениеОбъект.ТекущийСтатус = Перечисления.СтатусыПеремещений.Отменен Тогда
		Возврат;
	КонецЕсли;

	// Отправленные и полученные перемещения автоматически не отменяем.
	Если НЕ ПеремещениеУправляемоеПоСтатусу(ПеремещениеОбъект.ТекущийСтатус) Тогда
		Возврат;
	КонецЕсли;

	ПеремещениеОбъект.СозданПриИспользованииСтатусовПеремещений = Истина;
	ПеремещениеОбъект.ТекущийСтатус = Перечисления.СтатусыПеремещений.Отменен;
	ПеремещениеОбъект.Записать(РежимЗаписиДокумента.Запись);

КонецПроцедуры

// Истина, если перемещение находится в статусе, допускающем автоматическую актуализацию
// (не заполнен / "Заявка" / "Собран" / "Отменен"). Статусы "Отправлен" и "Получен" не изменяем.
//
// Параметры:
//   ТекущийСтатус - ПеречислениеСсылка.СтатусыПеремещений
//
// Возвращаемое значение:
//   Булево
//
Функция ПеремещениеУправляемоеПоСтатусу(ТекущийСтатус)

	Возврат НЕ ЗначениеЗаполнено(ТекущийСтатус)
		ИЛИ ТекущийСтатус = Перечисления.СтатусыПеремещений.Заявка
		ИЛИ ТекущийСтатус = Перечисления.СтатусыПеремещений.Собран
		ИЛИ ТекущийСтатус = Перечисления.СтатусыПеремещений.Отменен;

КонецФункции

#КонецОбласти

#КонецЕсли