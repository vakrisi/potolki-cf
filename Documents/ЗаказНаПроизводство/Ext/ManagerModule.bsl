Функция ЕстьВыпускПоЗаказу(ДокументСсылка) Экспорт
	
	Если НЕ ЗначениеЗаполнено(ДокументСсылка) Тогда
		Возврат Ложь;	
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Выпуск.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ВыпускПродукции КАК Выпуск
	|ГДЕ
	|	Выпуск.Проведен
	|	И Выпуск.Основание = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	
	Возврат НЕ Запрос.Выполнить().Пустой();
	
КонецФункции

Функция ПолучитьВыпускПоЗаказу(ДокументСсылка) Экспорт
	
	Результат = Документы.ВыпускПродукции.ПустаяСсылка();
	Если НЕ ЗначениеЗаполнено(ДокументСсылка) Тогда
		Возврат Результат;	
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Выпуск.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ВыпускПродукции КАК Выпуск
	|ГДЕ
	|	НЕ Выпуск.ПометкаУдаления
	|	И Выпуск.Основание = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ЕстьПеремещениеГотовойПродукции(ДокументСсылка) Экспорт

	Если НЕ ЗначениеЗаполнено(ДокументСсылка) Тогда
		Возврат Ложь;	
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ДокументЗаказНаПроизводство.Ссылка КАК Ссылка,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(ТоварыПроизводстваВПутиОбороты.КоличествоОтправленоОборот, 0) > 0
	|			ТОГДА ИСТИНА 
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ЕстьПеремещение
	|ИЗ
	|	Документ.ЗаказНаПроизводство КАК ДокументЗаказНаПроизводство
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыПроизводстваВПути.Обороты КАК ТоварыПроизводстваВПутиОбороты
	|		ПО ДокументЗаказНаПроизводство.Ссылка = ТоварыПроизводстваВПутиОбороты.Заказ
	|			И ДокументЗаказНаПроизводство.СкладОтгрузки = ТоварыПроизводстваВПутиОбороты.СкладПолучатель
	|ГДЕ
	|	ДокументЗаказНаПроизводство.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.ЕстьПеремещение;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

