#Область ПеременныеФормы

&НаКлиенте
Перем СтараяСуммаДокумента Экспорт;

&НаКлиенте
Перем мСуммаБонусов;

&НаКлиенте
Перем ПараметрыДляЗаписи Экспорт;

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ВалютаУчета = Константы.ВалютаУчета.Получить();
	ЗаполнитьСтавкуНДСПоОрганизации(Истина);
	
	ДобавлятьЗаказыВторогоПорядкаВРаспределение = НЕ Константы.НеДобавлятьЗаказыВторогоПорядкаВРаспределение.Получить();
	ДобавлятьДокументыПродажиПоЗаказамПокупателей = ПолучитьФункциональнуюОпцию("ДобавлятьДокументПродажиПоЗаказуПриДобавленииЗаказаВРаспределение")
										И Константы.ВестиРасчетыПоЗаказамПоРТиУ.Получить();
	ДобавлятьДокументыПродажиПоЗаказДоговорам = ПолучитьФункциональнуюОпцию("ДобавлятьДокументПродажиПоЗаказуПриДобавленииЗаказаВРаспределение")
										И Константы.ВестиРасчетыПоЗаказамПоМонтажу.Получить();
										
	Если Параметры.Ключ.Пустая() тогда		
		ПересчитатьБонусыПоДокументу();
		//ЗаполнитьОснованияПоРаспределению(); //Заккоментировано по заявке #5186
		ПриЧтенииСозданииНаСервере(); // №11237
	Иначе
		ЭтаФорма.ТолькоПросмотр = ПраваПользователей.ДокументТолькоПросмотр(Объект.Ссылка);
	КонецЕсли;
		
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	МессенджерыСервер.ПриСозданииНаСервере(ЭтотОбъект, Элементы.ГруппаКонтрагентКПМессенджеры);
	
	УстановитьЗаголовок();
	
	Элементы.ГруппаФискальныйРегистратор.Видимость = Константы.ИспользоватьПодключаемоеОборудование.Получить();
	Элементы.ФормаПечатьЧека.Видимость = Элементы.ГруппаФискальныйРегистратор.Видимость;
	Элементы.ФормаПоказатьТовары.Видимость = Элементы.ГруппаФискальныйРегистратор.Видимость;
	
	ОбновитьЭлементыФормы();
	
	ПраваПользователей.УстановитьТолькоПросмотрДляРеквизитаНомер(Элементы.Номер.ТолькоПросмотр);
	УстановитьВидимостьКнопокРаспределения();
		
	//Элементы.КонтрагентДополнительно.Видимость = Объект.Контрагент.ПоказыватьДопИнформацию;
	ОбщийМодульСервер.ДополнительнаяИнформацияПоКонтрагентуНаФорме(Объект.Контрагент, Элементы.ПоказатьДополнительнуюИнформацию);
	ОбщийМодульСервер.РегулировкаШириныПоляКонтрагента(Элементы, Элементы.Контрагент, Элементы.ПоказатьДополнительнуюИнформацию);

	ОбщийМодульСервер.УстановитьВидимостьПодразделения(ЭтотОбъект);
	
	УправлениеВидимостьюЭлементов();
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	ДатыЗапретаИзменения.ОбъектПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	
	ПриЧтенииСозданииНаСервере(); // №11237
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииСозданииНаСервере()
	
	ВалютаДокумента = Объект.Валюта;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ОбновитьВидимостьГруппыБонусов();
	СтараяСуммаДокумента = Объект.Сумма;
	мСуммаБонусов = Объект.СуммаБонусовКНачислениюПоДисконтнойКарте;
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	Если НеВыполнятьПроверкуПередЗаписью Тогда
		НеВыполнятьПроверкуПередЗаписью = Ложь;
		Возврат;
	КонецЕсли;
	
	Если ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
		ВыполнитьПроверкиИЗадатьВопросыПередЗаписью(Отказ, ПараметрыЗаписи);
	КонецЕсли;
	
	ОбщийМодульКлиент.ЗаписатьОбъектПриНеобходимости(ЭтотОбъект, ПараметрыЗаписи, Отказ);
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
		
	ФинансыСервер.ПроверитьСуммуРаспределенияПоТипамДокументов(Объект, , Объект.Сумма, Отказ, ПараметрыЗаписи.РежимЗаписи);
	
	// #15647
	Если ЗаписьПослеПробития Тогда
		ЗаписьПослеПробития = Ложь;
		ТекущийОбъект.ДополнительныеСвойства.Вставить("ПропуститьПроверкуЗапретаИзмененияПроведенногоДокумента", Истина);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	мСуммаБонусов = Объект.СуммаБонусовКНачислениюПоДисконтнойКарте;
	Оповестить("ОбновитьАРМПроизводства",,"ОплатаБанковскойКартой");
	Оповестить("Запись_ДокументОплаты", , Объект.Ссылка);
	
	ОбщийМодульКлиент.ВыполнитьДействияПослеЗаписи(ЭтаФорма, Объект, ПараметрыЗаписи);
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	УстановитьЗаголовок();
	ОбновитьЭлементыФормы();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура ДатаПриИзменении(Элемент)
	ДатаПриИзмененииНаСервере();
КонецПроцедуры

&НаСервере
Процедура ДатаПриИзмененииНаСервере()
	
	Если НЕ Объект.Валюта = ВалютаУчета Тогда
		ОбновитьЭлементыФормы();
		//пересчитаем сумму распределения в валюте документа, т.к. сменился курс валюты
		ОбработкаТабличныхЧастейСервер.ПересчитатьИзВалютыВВалюту(Объект.РаспределениеПлатежа, Объект.Валюта, Объект.Дата);
	КонецЕсли;
	ФинансыСервер.ОбновитьВидимостьИКурсВалюты(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура КонтрагентПриИзменении(Элемент)
	
	КонтрагентПриИзмененииНаСервере();
	ПересчитатьБонусыПоДокументу();
	
КонецПроцедуры

&НаСервере
Процедура КонтрагентПриИзмененииНаСервере()
	
	Если ЗначениеЗаполнено(Объект.Контрагент) Тогда
		РеквизитыКонтрагента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект.Контрагент, "ОсновнойДоговор, Категория");	
		Объект.Договор = РеквизитыКонтрагента.ОсновнойДоговор;
		Объект.КатегорияКонтрагента = РеквизитыКонтрагента.Категория;
	Иначе
		Объект.Договор = Справочники.ДоговорыКонтрагентов.ПустаяСсылка();
		Объект.КатегорияКонтрагента = Справочники.КатегорииКонтрагентов.ПустаяСсылка();
	КонецЕсли;
	
	//Элементы.КонтрагентДополнительно.Видимость = Объект.Контрагент.ПоказыватьДопИнформацию;
	ОбщийМодульСервер.ДополнительнаяИнформацияПоКонтрагентуНаФорме(Объект.Контрагент, Элементы.ПоказатьДополнительнуюИнформацию);
	ОбщийМодульСервер.РегулировкаШириныПоляКонтрагента(Элементы, Элементы.Контрагент, Элементы.ПоказатьДополнительнуюИнформацию);
	
КонецПроцедуры

&НаКлиенте
Процедура ВидПлатежнойКартыНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ДанныеВыбора = ПолучитьСписокДоступныхВидовПлатежныхКарт(Объект.ЭквайринговыйТерминал);
	
КонецПроцедуры

&НаКлиенте
Процедура ВидПлатежнойКартыПриИзменении(Элемент)
	
	ЗаполнитьПроцентКомиссии();
	ОбновитьЭлементыФормы();
	
КонецПроцедуры

&НаКлиенте
Процедура СуммаПриИзменении(Элемент)
			
	ДополнительныеПараметры = Новый Структура("СтараяСуммаДокумента", СтараяСуммаДокумента);
	ВыполнитьРаспределениеОплаты(ДополнительныеПараметры);
	
	СуммаПриИзмененииКлиент();
	 
КонецПроцедуры

// Экспорт - вызывается из ФинансыКлиент 
&НаКлиенте
Процедура СуммаПриИзмененииКлиент() Экспорт
	
	Объект.Комиссия = Объект.Сумма * (Объект.ПроцентКомиссии / 100);
	
	СтараяСуммаДокумента = Объект.Сумма;
	
	ФинансыКлиентСервер.ПересчитатьСуммуНДС(Объект, УчитыватьНДС);
	ПересчитатьБонусыПоДокументу();
	 
КонецПроцедуры

&НаКлиенте
Процедура ПроцентКомиссииПриИзменении(Элемент)
	
	Объект.Комиссия = Объект.Сумма * (Объект.ПроцентКомиссии / 100);
	
КонецПроцедуры

&НаКлиенте
Процедура КомиссияПриИзменении(Элемент)
	
	Если НЕ Объект.Сумма = 0 Тогда
		Объект.ПроцентКомиссии = Окр(Объект.Комиссия / Объект.Сумма,2);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДоговорПриИзменении(Элемент)
	ОбновитьЭлементыФормы();
КонецПроцедуры

&НаКлиенте
Процедура ВалютаПриИзменении(Элемент)
	
	//++ №11237 нужно пересчитать из валюты в валюту если она поменялась, предварительно уточнив у пользователя
	//ОбновитьЭлементыФормы();
	Если ЗначениеЗаполнено(Объект.Валюта) И НЕ ВалютаДокумента = Объект.Валюта Тогда
		
		ТекстВопроса = "Пересчитать суммы документа по курсу новой валюты?";
		ОписаниеОповещения = Новый ОписаниеОповещения("ВалютаПриИзмененииФрагмент", ЭтотОбъект);
		ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
		
	Иначе
		
		ВалютаПриИзмененииЗавершение();
		
	КонецЕсли;
	//-- №11237
	
КонецПроцедуры

//++ №11237
&НаКлиенте
Процедура ВалютаПриИзмененииФрагмент(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		ВалютаПриИзмененииСервер(Объект.Валюта,	Истина);		
	Иначе
		Объект.Валюта = ВалютаДокумента;
	КонецЕсли;
	
	ВалютаПриИзмененииЗавершение();
		
КонецПроцедуры

&НаКлиенте
Процедура ВалютаПриИзмененииЗавершение()
	
	ВалютаДокумента = Объект.Валюта;
	
	ОбновитьЭлементыФормы();
		
КонецПроцедуры 

&НаСервере
Процедура ВалютаПриИзмененииСервер(НоваяВалюта, ПересчитатьСуммы = Истина)
		
	Если ПересчитатьСуммы Тогда 
		
		СтараяВалюта = ВалютаДокумента;
		ДатаКурса    = ?(ЗначениеЗаполнено(Объект.Дата), Объект.Дата, ТекущаяДатаСеанса());
		
		Объект.Сумма = РаботаСВалютой.ПересчитатьИзВалютыВВалюту(СтараяВалюта, НоваяВалюта, ДатаКурса, Объект.Сумма);
		РаспределитьСуммуОплатыПоДокументам();
		
	КонецЕсли;
		
КонецПроцедуры
//-- №11237

&НаКлиенте
Процедура ОрганизацияПриИзменении(Элемент)
	
	ЗаполнитьСтавкуНДСПоОрганизации();
	ПересчитатьБонусыПоДокументу();
	
КонецПроцедуры

&НаКлиенте
Процедура КассаПриИзменении(Элемент)
	// №6876 ПересчитатьБонусыПоДокументу(); расчет бонусов теперь по эквайрингу
КонецПроцедуры

&НаСервере
Процедура ЭквайринговыйТерминалПриИзмененииНаСервере()
	
	Объект.ВидПлатежнойКарты = Справочники.ВидыПлатежныхКарт.ПустаяСсылка();
	Если ЗначениеЗаполнено(Объект.ЭквайринговыйТерминал) Тогда
		ОтборСтрок = Новый Структура("Основная", Истина);
		НайденныеСтроки = Объект.ЭквайринговыйТерминал.ВидыПлатежныхКарт.НайтиСтроки(ОтборСтрок);
		Если НайденныеСтроки.Количество() > 0 Тогда
			Объект.ВидПлатежнойКарты = НайденныеСтроки[0].ВидПлатежнойКарты; 	
			Объект.ПроцентКомиссии = НайденныеСтроки[0].ПроцентКомиссии;
		КонецЕсли;
	КонецЕсли;
	Объект.БанкВозвращаетКомиссиюПриВозвратеОплаты = Объект.ЭквайринговыйТерминал.БанкВозвращаетКомиссиюПриВозвратеОплаты;

КонецПроцедуры

&НаКлиенте
Процедура ЭквайринговыйТерминалПриИзменении(Элемент)
	ЭквайринговыйТерминалПриИзмененииНаСервере();
	ПроцентКомиссииПриИзменении(Неопределено);
	ПересчитатьБонусыПоДокументу(); // №6876
КонецПроцедуры

&НаКлиенте
Процедура ДисконтнаяКартаПриИзменении(Элемент)
	ПересчитатьБонусыПоДокументу();
КонецПроцедуры

&НаКлиенте
Процедура СтавкаНДСПриИзменении(Элемент)
	ФинансыКлиентСервер.ПересчитатьСуммуНДС(Объект, УчитыватьНДС);	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТЧРаспределение

&НаКлиенте
Процедура РаспределениеПлатежаДатаПлатежаПоРассрочкеНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ТекущиеДанные = Элементы.РаспределениеПлатежа.ТекущиеДанные;
	Если ТипЗнч(ТекущиеДанные.Документ) = Тип("ДокументСсылка.ЗаказДоговор") Тогда
		СписокВариантов = ПолучитьДатыОплатыПоДоговоруРассрочки(ТекущиеДанные.Документ);
		ОписаниеОповещения = Новый ОписаниеОповещения("ВыборДатыПлатежаПоРассрочке", ЭтаФорма);
		ПоказатьВыборИзМеню(ОписаниеОповещения, СписокВариантов, Элемент);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыборДатыПлатежаПоРассрочке(ВыбранныйЭлемент, ДополнительныеПараметры) Экспорт 
	
	Если ВыбранныйЭлемент = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Элементы.РаспределениеПлатежа.ТекущиеДанные.ДатаПлатежаПоРассрочке = ВыбранныйЭлемент.Значение;
	
КонецПроцедуры

&НаКлиенте
Процедура РаспределениеПлатежаДатаПлатежаПоРассрочкеНачалоВыбораИзСписка(Элемент, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
КонецПроцедуры

&НаКлиенте
Процедура РаспределениеПлатежаДатаПлатежаПоРассрочкеОкончаниеВводаТекста(Элемент, Текст, ДанныеВыбора, ПараметрыПолученияДанных, СтандартнаяОбработка)
	
	ПоказатьОповещениеПользователя("Сообщение", , "Дату следует выбирать согласно предложенных вариантов");
	Элементы.РаспределениеПлатежа.ТекущиеДанные.ДатаПлатежаПоРассрочке = Дата(1,1,1);
	Возврат;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийИКоманд_ТЧРаспределение

&НаКлиенте
Процедура Распределение_Документ(Команда)
	ФинансыКлиент.Распределение_Документ(Команда, ЭтаФорма);
КонецПроцедуры

&НаКлиенте
Процедура РаспределениеПлатежаОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
//Процедура ПослеВыбораДокумента(ВыбранныйДокумент, ДополнительныеПараметры) Экспорт
	
	Для каждого ВыбранныйДокумент из ВыбранноеЗначение Цикл
		Если НЕ ВыбранныйДокумент.Пустая() Тогда
			НоваяСтрока = Объект.РаспределениеПлатежа.Добавить();
			НоваяСтрока.Документ = ВыбранныйДокумент;
			//НоваяСтрока.Сумма = ПолучитьСуммуДокумента(НоваяСтрока.Документ);
			НоваяСтрока.Сумма = Объект.Сумма;
			
			Если ДобавлятьЗаказыВторогоПорядкаВРаспределение Тогда
				ДобавитьОснованиеЗаказаСервер(НоваяСтрока.Документ);
			КонецЕсли;			
			//#7709
			Если ДобавлятьДокументыПродажиПоЗаказамПокупателей ИЛИ ДобавлятьДокументыПродажиПоЗаказДоговорам Тогда
				ДобавитьДокументыПродажиПоЗаказамСервер(НоваяСтрока.Документ);	
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Если ВыбранноеЗначение.Количество() > 0 Тогда
		РаспределениеОплаты(Неопределено);
		ОбновитьЭлементыФормы();
	КонецЕсли;	
КонецПроцедуры

