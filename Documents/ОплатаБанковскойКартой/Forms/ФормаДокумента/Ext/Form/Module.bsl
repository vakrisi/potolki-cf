&НаСервере
Процедура УправлениеВидимостьюЭлементов()
	
	ОперацияОплатаКартой = (Объект.ВидОперации = Перечисления.ВидыОперацийОплатаБанковскойКартой.ОплатаБанковскойКартой)
					   ИЛИ (Объект.ВидОперации = Перечисления.ВидыОперацийОплатаБанковскойКартой.ВозвратОплатыКлиенту);
	
	Элементы.КредитныйДоговор.Видимость 	 = (НЕ ОперацияОплатаКартой);
	Элементы.ВидПлатежнойКарты.Видимость  	 = ОперацияОплатаКартой;
	Элементы.ЭквайринговыйТерминал.Видимость = ОперацияОплатаКартой;
	
	Элементы.БанкВозвращаетКомиссиюПриВозвратеОплаты.Видимость = (Объект.ВидОперации = Перечисления.ВидыОперацийОплатаБанковскойКартой.ВозвратОплатыКлиенту);
	
	//#11129
	//Элементы.СтатьяРасходов.Видимость = (Объект.ВидОперации = Перечисления.ВидыОперацийОплатаБанковскойКартой.ВозвратОплатыКлиенту);
	//Элементы.СтатьяДоходов.Видимость  = НЕ Элементы.СтатьяРасходов.Видимость;
	Элементы.СтатьяРасходов.Видимость = Ложь;
	Элементы.СтатьяДоходов.Видимость  = Ложь;
	
	УстанавливаетсяКомиссия = НЕ Объект.ВидОперации = Перечисления.ВидыОперацийОплатаБанковскойКартой.ВозвратОплатыКлиенту 
								ИЛИ Объект.БанкВозвращаетКомиссиюПриВозвратеОплаты;
	Элементы.ПроцентКомиссии.Доступность = УстанавливаетсяКомиссия;
	Элементы.Комиссия.Доступность = УстанавливаетсяКомиссия;
		
КонецПроцедуры

&НаСервере
Процедура УстановитьЗаголовок()
	
	АвтоЗаголовок = Ложь;
	Заголовок = Документы.ОплатаБанковскойКартой.ЗаголовокДокументаПоВидуОперации(Объект.Ссылка,
																						  Объект.Номер,
																						  Объект.Дата,
																						  Объект.ВидОперации);
	
КонецПроцедуры

