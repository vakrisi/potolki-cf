#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПечатьЧека

// Возвращает предварительные параметры фискализации чека для документа.
//
// Параметры:
//   ДокументСсылка - ДокументСсылка.ПриходныйКассовыйОрдер - Документ.
//   ВерсияФФД - Строка - Версия ФФД.
//
// ВозвращаемоеЗначение:
//  Неопределено, Структура - см. функцию МенеджерОборудованияКлиентСервер.ПараметрыОперацииФискализацииЧека().
//
Функция ПараметрыОперацииФискализацииЧека(ДокументСсылка, ВерсияФФД = Неопределено, ЭкземплярПодключаемогоОборудования = Неопределено) Экспорт
	
	// Общие параметры чека
	ОбщиеПараметры = МенеджерОборудованияКлиентСервер.ПараметрыОперацииФискализацииЧека();
			
	// Общие реквизиты для всех типов оборудования.
	ПотолкиКассыОнлайн.ЗаполнитьОбщиеРеквизиты(ДокументСсылка, ОбщиеПараметры, ЭкземплярПодключаемогоОборудования);
			
	// Товарные позиции И Таблица оплат	
	Если ВерсияФФД = "1.0" Тогда
		ДополнитьТоварамиПараметрыПриПробитииЧека_1_0(ДокументСсылка, ОбщиеПараметры);
	Иначе
		Если ДокументСсылка.ВидОперации = Перечисления.ВидыОперацийОплатаБанковскойКартой.ВозвратОплатыКлиенту Тогда
			НомерСтрокиТовара = 0;
			МассивДокументовВозврата = Новый Массив;			
		    Для каждого СтрокаТЧ из ДокументСсылка.Основания Цикл
				Если ТипЗнч(СтрокаТЧ.Основание) = Тип("ДокументСсылка.ВозвратТовараОтПокупателя") Тогда
					МассивДокументовВозврата.Добавить(Новый Структура("Документ, СуммаДокумента, СуммаРаспределения", СтрокаТЧ.Основание, СтрокаТЧ.Основание.СуммаДокумента, СтрокаТЧ.Основание.СуммаДокумента));
				КонецЕсли;
			КонецЦикла;
			Если МассивДокументовВозврата.Количество() > 0 Тогда
				// возврат оплаты по документам Возврат от покупателя
				НомерСтрокиТовара = 0;
				ПризнакСпособаРасчета = Перечисления.ПризнакиСпособаРасчета.ОплатаКредита;
				ПризнакПредметаРасчета = Перечисления.ПризнакиПредметаРасчета.ПлатежВыплата;
				ПотолкиКассыОнлайн.ДобавитьПозицииЧекаПоДокументамРасчетов(МассивДокументовВозврата, ОбщиеПараметры, НомерСтрокиТовара, ПризнакСпособаРасчета, ПризнакПредметаРасчета);			
				ПотолкиКассыОнлайн.ДобавитьСтрокуОплаты(ОбщиеПараметры, ПредопределенноеЗначение("Перечисление.ТипыОплатыККТ.Электронно"), ДокументСсылка.Сумма); // #12169 исправление  
			Иначе
				// возврат оплаты - аванса
				// возврат оплаты по заказу (заказ - в ТЧ Распределение)
				// возврат оплаты по реализации (реализация - в ТЧ Распределение)
				ПотолкиКассыОнлайн.ДополнитьТоварамиПараметрыПриПробитииЧека(ДокументСсылка, ОбщиеПараметры);
			КонецЕсли;
		Иначе
			// поступление ДС
			ПотолкиКассыОнлайн.ДополнитьТоварамиПараметрыПриПробитииЧека(ДокументСсылка, ОбщиеПараметры);
		КонецЕсли;
	КонецЕсли;

	Возврат ОбщиеПараметры;
	
КонецФункции

#КонецОбласти

#Область ПечатьЧекаФФД_1_0

Процедура ДополнитьТоварамиПараметрыПриПробитииЧека_1_0(ДокументСсылка, ОбщиеПараметры)
	
	ТаблицаТоваров = ЗаполнитьТаблицуТоваровПоОснованию(ДокументСсылка);
	
	Для Каждого СтрокаТЧ Из ТаблицаТоваров Цикл
		//СтрокаПозицииЧека = Новый Структура();
		//СтрокаПозицииЧека.Вставить("ФискальнаяСтрока");
		СтрокаПозицииЧека = МенеджерОборудованияКлиентСервер.ПараметрыФискальнойСтрокиЧека();
		Если ПустаяСтрока(Строка(СтрокаТЧ.Номенклатура)) Тогда
			СтрокаПозицииЧека.Вставить("Наименование", "Предоплата");
		Иначе
			СтрокаПозицииЧека.Вставить("Наименование", Строка(СтрокаТЧ.Номенклатура));
		КонецЕсли;
		СтрокаПозицииЧека.Вставить("Количество"  , СтрокаТЧ.Количество);
		СтрокаПозицииЧека.Вставить("Цена"        , СтрокаТЧ.Цена);
		СтрокаПозицииЧека.Вставить("Сумма"       , СтрокаТЧ.Сумма);
		СтрокаПозицииЧека.Вставить("НомерСекции" , СтрокаТЧ.НомерСекции);
		СтрокаПозицииЧека.Вставить("СтавкаНДС"   , ВернутьСтавкуНДС(СтрокаТЧ.СтавкаНДС));
		ОбщиеПараметры.ПозицииЧека.Добавить(СтрокаПозицииЧека);
	КонецЦикла;
	
	// Подготовка таблицы оплат
	СуммаВидаОплаты = ДокументСсылка.Сумма;	
	Если СуммаВидаОплаты <> 0 Тогда
		СтрокаОплаты = Новый Структура();
		//СтрокаОплаты.Вставить("ТипОплаты", 1);
		СтрокаОплаты.Вставить("ТипОплаты", ПредопределенноеЗначение("Перечисление.ТипыОплатыККТ.Электронно"));
		СтрокаОплаты.Вставить("Наименование", "Платежная карта");
		СтрокаОплаты.Вставить("Сумма", СуммаВидаОплаты);
		ОбщиеПараметры.ТаблицаОплат.Добавить(СтрокаОплаты);
	КонецЕсли;
	
КонецПроцедуры

Функция ЗаполнитьТаблицуТоваровПоОснованию(ДокументСсылка) Экспорт
	
