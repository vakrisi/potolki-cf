Функция ЭтоПолнаяОплата(ДокументСсылка)
	
	Результат = Ложь;
	
	ДокументСсылкаОснование = Неопределено;
	Если ДокументСсылка.Основания.Количество() > 0 Тогда
		ДокументСсылкаОснование = ДокументСсылка.Основания[0].Основание;
	КонецЕсли;
	
	Если НЕ ДокументСсылкаОснование = Неопределено Тогда
		Если ТипЗнч(ДокументСсылкаОснование) = Тип("ДокументСсылка.ЗаявкаНаДоставку") Тогда
			Если ДокументСсылка.Сумма = ДокументСсылкаОснование.СтоимостьДоставки Тогда
				Результат = Истина;
			КонецЕсли;
		Иначе
			Если ДокументСсылка.Сумма = ДокументСсылкаОснование.СуммаДокумента Тогда
				Результат = Истина;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Функция преобразования значения реквизита СтавкаНДС к типу Число.
Функция ВернутьСтавкуНДС(СтавкаНДС)
	
	Если СтавкаНДС = ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС10") Тогда
		Ставка = 10;
	ИначеЕсли СтавкаНДС = ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС18") Тогда
		Ставка = 18;
	ИначеЕсли СтавкаНДС = ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС0") Тогда
		Ставка = 0;
	Иначе
		Ставка = Неопределено;
	КонецЕсли;
	
	Возврат Ставка;
	
КонецФункции

#КонецОбласти

Функция ЗаголовокДокументаПоВидуОперации(Документ, НомерДокумента, ДатаДокумента, ВидОперации) Экспорт
	
	Заголовок = "";
	
	Если ВидОперации = Перечисления.ВидыОперацийОплатаБанковскойКартой.ОплатаБанковскойКартой Тогда
			Заголовок = ?(ЗначениеЗаполнено(Документ.Ссылка),
							НСтр("ru = 'Оплата банковской картой %1 от %2'"),
							НСтр("ru = 'Оплата банковской картой (создание)'"));

	ИначеЕсли ВидОперации = Перечисления.ВидыОперацийОплатаБанковскойКартой.ВозвратОплатыКлиенту Тогда
			Заголовок = ?(ЗначениеЗаполнено(Документ.Ссылка),
							НСтр("ru = 'Оплата банковской картой (возврат) %1 от %2'"),
							НСтр("ru = 'Оплата банковской картой (возврат) (создание)'"));
							
	ИначеЕсли ВидОперации = Перечисления.ВидыОперацийОплатаБанковскойКартой.Кредит Тогда
			Заголовок = ?(ЗначениеЗаполнено(Документ.Ссылка),
							НСтр("ru = 'Оплата кредитом  %1 от %2'"),
							НСтр("ru = 'Оплата кредитом (создание)'"));
							
	КонецЕсли;
	
	Возврат СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Заголовок, НомерДокумента, ДатаДокумента);
	
КонецФункции

#Область СозданиеНаОсновании

// Определяет список команд создания на основании.
//
// Параметры:
//   КомандыСозданияНаОсновании - ТаблицаЗначений - Таблица с командами создания на основании. Для изменения.
//       См. описание 1 параметра процедуры СозданиеНаОснованииПереопределяемый.ПередДобавлениемКомандСозданияНаОсновании().
//   Параметры - Структура - Вспомогательные параметры. Для чтения.
//       См. описание 2 параметра процедуры СозданиеНаОснованииПереопределяемый.ПередДобавлениемКомандСозданияНаОсновании().
//
Процедура ДобавитьКомандыСозданияНаОсновании(КомандыСозданияНаОсновании, Параметры) Экспорт
	
	Документы.ОплатаБанковскойКартой.ДобавитьКомандуСоздатьНаОсновании(КомандыСозданияНаОсновании, Истина);
		
КонецПроцедуры

// Добавляет команду создания данного документа
//
// Параметры:
//   КомандыСозданияНаОсновании - ТаблицаЗначений - Таблица с командами создания на основании. Для изменения.
//       См. описание 1 параметра процедуры СозданиеНаОснованииПереопределяемый.ПередДобавлениемКомандСозданияНаОсновании().
//
Функция ДобавитьКомандуСоздатьНаОсновании(КомандыСозданияНаОсновании, ЭтоВозврат = Ложь, Порядок = 0) Экспорт
	
	Если ПравоДоступа("Добавление", Метаданные.Документы.ОплатаБанковскойКартой) Тогда
		КомандаСоздатьНаОсновании = КомандыСозданияНаОсновании.Добавить();
		КомандаСоздатьНаОсновании.Менеджер = Метаданные.Документы.ОплатаБанковскойКартой.ПолноеИмя();
		КомандаСоздатьНаОсновании.Представление = Метаданные.Документы.ОплатаБанковскойКартой.Представление() + ?(ЭтоВозврат, " (возврат)", "");
		КомандаСоздатьНаОсновании.РежимЗаписи = "Проводить";
		КомандаСоздатьНаОсновании.Порядок = Порядок;
		
		Возврат КомандаСоздатьНаОсновании;
	КонецЕсли;

	Возврат Неопределено;
	
КонецФункции

// Добавляет команду создания документа "Оплата банковской картой".
//
