#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("Структура") Тогда
		Если ДанныеЗаполнения.Свойство("ВидОперации") Тогда
			ВидОперации = ДанныеЗаполнения.ВидОперации;
		КонецЕсли;
		// закомментировано: не менять ДанныеЗаполнения, так как ниже ломается создание на основании
		// при необходимости обрабатывать в блоках Если ТипЗнч(ДанныеЗаполнения)
		//Если ДанныеЗаполнения.Свойство("Основание") Тогда
		//	ДанныеЗаполнения = ДанныеЗаполнения.Основание;
		//КонецЕсли;
	КонецЕсли;	
	
	Если ЭтоНовый() Тогда		
		ИнициализироватьСлужебныеРеквизиты();		
	КонецЕсли;
	
	ОбщийМодуль.ЗаполнитьШапкуДокумента(ЭтотОбъект);
	//#11129 закомментировано
	//СтатьяДоходов = ФинансыСервер.ПолучитьСтатьюДоходовРасходов(Метаданные().Имя, ВидОперации);
	ЭквайринговыйТерминалПоУмолчанию = ОбщийМодульСервер.НастройкаПользователя("ЭквайринговыйТерминал");
	Если ЗначениеЗаполнено(Организация) Тогда
		Если Организация = ЭквайринговыйТерминалПоУмолчанию.Владелец Тогда
			ЭквайринговыйТерминал = ЭквайринговыйТерминалПоУмолчанию;
		КонецЕсли;
	Иначе
		Если ЗначениеЗаполнено(ЭквайринговыйТерминалПоУмолчанию) Тогда
			ЭквайринговыйТерминал = ЭквайринговыйТерминалПоУмолчанию;
			Организация = ЭквайринговыйТерминалПоУмолчанию.Владелец;
		КонецЕсли;	
	КонецЕсли;
	Если ЗначениеЗаполнено(ЭквайринговыйТерминал) Тогда
		ОтборСтрок = Новый Структура("Основная", Истина);
		НайденныеСтроки = ЭквайринговыйТерминал.ВидыПлатежныхКарт.НайтиСтроки(ОтборСтрок);
		Если НайденныеСтроки.Количество() > 0 Тогда
			ВидПлатежнойКарты = НайденныеСтроки[0].ВидПлатежнойКарты; 	
		КонецЕсли;
	КонецЕсли;
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("Структура") Тогда
		Если ДанныеЗаполнения.Свойство("МассивДокументов") Тогда
			Если ДанныеЗаполнения.МассивДокументов.Количество() > 0 Тогда
				Если ТипЗнч(ДанныеЗаполнения.МассивДокументов[0]) = Тип("ДокументСсылка.ЗаказПокупателя") Тогда
					ЗаполнитьПоЗаказуПокупателя(ДанныеЗаполнения.МассивДокументов);
				ИначеЕсли ТипЗнч(ДанныеЗаполнения.МассивДокументов[0]) = Тип("ДокументСсылка.ЗаказДоговор") Тогда
					ЗаполнитьПоЗаказДоговору(ДанныеЗаполнения.МассивДокументов);
				ИначеЕсли ТипЗнч(ДанныеЗаполнения.МассивДокументов[0]) = Тип("ДокументСсылка.Монтаж") Тогда
					ЗаполнитьПоМонтажу(ДанныеЗаполнения.МассивДокументов);	
				ИначеЕсли ТипЗнч(ДанныеЗаполнения.МассивДокументов[0]) = Тип("ДокументСсылка.СчетНаОплату") Тогда
					ЗаполнитьПоСчетуНаОплату(ДанныеЗаполнения.МассивДокументов);
				ИначеЕсли ТипЗнч(ДанныеЗаполнения.МассивДокументов[0]) = Тип("ДокументСсылка.РеализацияТоваровИУслуг") Тогда
					ЗаполнитьПоРеализации(ДанныеЗаполнения.МассивДокументов);	
				КонецЕсли;
			КонецЕсли;
			
		ИначеЕсли ДанныеЗаполнения.Свойство("Основание") Тогда
			
			Если ТипЗнч(ДанныеЗаполнения.Основание) = Тип("ДокументСсылка.ЗаказДоговор")
				И ДанныеЗаполнения.Свойство("РассрочкаДатаПлатежа") 
				И ДанныеЗаполнения.Свойство("РассрочкаСумма") Тогда
				ЗаполнитьПоЗаказДоговору(ДанныеЗаполнения.Основание, ДанныеЗаполнения.РассрочкаДатаПлатежа, ДанныеЗаполнения.РассрочкаСумма);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
			
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ЗаказПокупателя") Тогда
		ЗаполнитьПоЗаказуПокупателя(ДанныеЗаполнения);
		
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ЗаказДоговор") Тогда
		ЗаполнитьПоЗаказДоговору(ДанныеЗаполнения);
		
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.Монтаж") Тогда
		ЗаполнитьПоМонтажу(ДанныеЗаполнения);
		
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.СчетНаОплату") Тогда
		ЗаполнитьПоСчетуНаОплату(ДанныеЗаполнения);
		
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.РеализацияТоваровИУслуг") Тогда
		ЗаполнитьПоРеализации(ДанныеЗаполнения);
		
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ВозвратТовараОтПокупателя") Тогда
		ЗаполнитьПоВозвратуОтПокупателя(ДанныеЗаполнения);
		
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ВозвратПродукции") Тогда
		ЗаполнитьПоВозвратуПродукции(ДанныеЗаполнения);
		
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ОплатаБанковскойКартой") Тогда
		ЗаполнитьПоОплатеБанковскойКартой(ДанныеЗаполнения);

	КонецЕсли;
	
	Если НЕ ВидОперации = Перечисления.ВидыОперацийОплатаБанковскойКартой.ВозвратОплатыКлиенту 
		ИЛИ ЭквайринговыйТерминал.БанкВозвращаетКомиссиюПриВозвратеОплаты Тогда
		ЗаполнитьПроцентКомиссии();
	КонецЕсли;
	БанкВозвращаетКомиссиюПриВозвратеОплаты = ЭквайринговыйТерминал.БанкВозвращаетКомиссиюПриВозвратеОплаты;
	
	Если ЗначениеЗаполнено(Контрагент) Тогда
		КатегорияКонтрагента = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Контрагент, "Категория");	
	КонецЕсли;
	
	Если ЭтоНовый() Тогда
		ДозаполнитьПоУмолчанию();
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	
	ИнициализироватьСлужебныеРеквизиты();
	
	РаспределениеПлатежа.Очистить();	
	ЧекФискализирован = Ложь;
	НомерСменыККМ = 0;
	НомерЧекаККМ = 0;
	ОплатаВыполнена = Ложь;
	
	ДозаполнитьПоУмолчанию();
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	Если ВидОперации = Перечисления.ВидыОперацийОплатаБанковскойКартой.ОплатаБанковскойКартой 
		ИЛИ ВидОперации = Перечисления.ВидыОперацийОплатаБанковскойКартой.ВозвратОплатыКлиенту
		Тогда
		Если ПроверяемыеРеквизиты.Найти("КредитныйДоговор") <> Неопределено Тогда
			ПроверяемыеРеквизиты.Удалить(ПроверяемыеРеквизиты.Найти("КредитныйДоговор"));
		КонецЕсли;	
	Иначе
		Если ПроверяемыеРеквизиты.Найти("ВидПлатежнойКарты") <> Неопределено Тогда
			ПроверяемыеРеквизиты.Удалить(ПроверяемыеРеквизиты.Найти("ВидПлатежнойКарты"));
		КонецЕсли;
		Если ПроверяемыеРеквизиты.Найти("ЭквайринговыйТерминал") <> Неопределено Тогда
			ПроверяемыеРеквизиты.Удалить(ПроверяемыеРеквизиты.Найти("ЭквайринговыйТерминал"));
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Документы.ЗаказПокупателя.ПроверитьЗаполнениеНаОснованииЗаказа(ЭтотОбъект, Отказ, РежимЗаписи);
	
	//#13710
	ОбщийМодульСервер.ПроверитьИзменениеВзаиморасчетовПередЗаписью(ЭтотОбъект, РежимЗаписи);
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, Режим)
	
	ДоговорКонтрагента = Справочники.ДоговорыКонтрагентов.ПустаяСсылка();
	Если ТипЗнч(Договор.Ссылка) = Тип("СправочникСсылка.ДоговорыКонтрагентов") Тогда
		ДоговорКонтрагента = Договор.Ссылка;
	ИначеЕсли ТипЗнч(Договор.Ссылка) = Тип("ДокументСсылка.ЗаказДоговор") Тогда
		ДоговорКонтрагента = Договор.ДоговорКонтрагента.Ссылка;
	КонецЕсли;
	
	// регистр ВзаиморасчетыСКонтрагентами Расход
	Движения.ВзаиморасчетыСКонтрагентами.Записывать = Истина;
	Движение = Движения.ВзаиморасчетыСКонтрагентами.Добавить();
	Движение.ВидДвижения = ?(НЕ ВидОперации = Перечисления.ВидыОперацийОплатаБанковскойКартой.ВозвратОплатыКлиенту, ВидДвиженияНакопления.Расход, ВидДвиженияНакопления.Приход);
	Движение.Период = Дата;
	Движение.Организация = Организация;
	Движение.Контрагент = Контрагент;
	Движение.Договор = ДоговорКонтрагента;
	//Движение.Документ = Ссылка;
	Движение.Сумма = Сумма;
	
	//Взаиморасчеты с контрагентами в валюте
	Движения.ВзаиморасчетыСКонтрагентамиВВалюте.Записывать = Истина;
	Движение = Движения.ВзаиморасчетыСКонтрагентамиВВалюте.Добавить();
	Движение.ВидДвижения = ?(НЕ ВидОперации = Перечисления.ВидыОперацийОплатаБанковскойКартой.ВозвратОплатыКлиенту, ВидДвиженияНакопления.Расход, ВидДвиженияНакопления.Приход);
	Движение.Период = Дата;
	Движение.Организация = Организация;
	Движение.Контрагент = Контрагент;
	Движение.Договор = ДоговорКонтрагента;
	Движение.Валюта = ?(ЗначениеЗаполнено(Валюта), Валюта, Константы.ВалютаУчета.Получить());
	Движение.Сумма = Сумма;  	
	
	// регистр РасчетыПоЭквайрингу Приход
	Движения.РасчетыПоЭквайрингу.Записывать = Истина;
	Движение = Движения.РасчетыПоЭквайрингу.Добавить();
	Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
	// если ИспользоватьРаспределениеПоЭквайрингу, то учет ведется с заполнением измерения ВидОперации и возврат отражается как Приход
	// иначе Возврат как Расход - для простой схемы без распределения
	Если ВидОперации = Перечисления.ВидыОперацийОплатаБанковскойКартой.ВозвратОплатыКлиенту И НЕ ПолучитьФункциональнуюОпцию("ИспользоватьРаспределениеПоЭквайрингу") Тогда
		Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
	КонецЕсли;
	Движение.Период = Дата;
	Движение.Организация = Организация;
	Движение.ЭквайринговыйТерминал = ?(НЕ ВидОперации = Перечисления.ВидыОперацийОплатаБанковскойКартой.Кредит, ЭквайринговыйТерминал, КредитныйДоговор);
	Если ПолучитьФункциональнуюОпцию("ИспользоватьРаспределениеПоЭквайрингу") Тогда
		Движение.Документ = Ссылка; //#6440
		Движение.ВидОперации = ВидОперации; //#7342
	КонецЕсли;
	Движение.Сумма = Сумма; //Сумма - Комиссия; //#7342 пишем всю сумму без минуса комиссии
	Если НЕ ВидОперации = Перечисления.ВидыОперацийОплатаБанковскойКартой.ВозвратОплатыКлиенту 
		ИЛИ БанкВозвращаетКомиссиюПриВозвратеОплаты Тогда
		Движение.КомиссияБанка = Комиссия;
	КонецЕсли;
	
	//регистр ДолгиПоРассрочкам
	Движения.ДолгиПоРассрочкам.Записывать = Истина;
	Для Каждого СтрокаРаспределения Из РаспределениеПлатежа Цикл
		Если ТипЗнч(СтрокаРаспределения.Документ) = Тип("ДокументСсылка.ЗаказДоговор") Тогда
			Если НЕ СтрокаРаспределения.Документ.Пустая() Тогда
				Если НЕ СтрокаРаспределения.ДатаПлатежаПоРассрочке = Дата(1,1,1) Тогда
					Движение = Движения.ДолгиПоРассрочкам.Добавить();
					Движение.Период = Дата;
					Движение.ВидДвижения = ?(НЕ ВидОперации = Перечисления.ВидыОперацийОплатаБанковскойКартой.ВозвратОплатыКлиенту, ВидДвиженияНакопления.Расход, ВидДвиженияНакопления.Приход);
					Движение.СрокПлатежа = СтрокаРаспределения.ДатаПлатежаПоРассрочке;
					Движение.ЗаказДоговор = СтрокаРаспределения.Документ;
					//#9779
					//Движение.Сумма = СтрокаРаспределения.Сумма;
					Если СтрокаРаспределения.Документ.Валюта = Валюта ИЛИ СтрокаРаспределения.СуммаВВалютеДокумента = 0 Тогда 
						Движение.Сумма = СтрокаРаспределения.Сумма;
					Иначе
						Движение.Сумма = СтрокаРаспределения.СуммаВВалютеДокумента; 
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
		
	//Распределение РасчетыПоЗаказам
	СписокВидовДокументовПоКоторымВедутсяРасчеты = ОбщийМодуль.ПолучитьМассивТиповДокументовПоКоторымВедутсяРасчетыПоЗаказам();
	Движения.РасчетыПоЗаказам.Записывать = Истина;
	Для Каждого ТекущаяСтрока Из РаспределениеПлатежа Цикл
		НайденныйВидДокумента = СписокВидовДокументовПоКоторымВедутсяРасчеты.Найти(ТипЗнч(ТекущаяСтрока.Документ));
		Если НайденныйВидДокумента <> Неопределено Тогда
			Движение = Движения.РасчетыПоЗаказам.Добавить();
			Движение.Период = Дата;
			// #16759 вид движения всегда расход, знак зависит от вида операции
			//Движение.ВидДвижения = ?(НЕ ВидОперации = Перечисления.ВидыОперацийОплатаБанковскойКартой.ВозвратОплатыКлиенту, ВидДвиженияНакопления.Расход, ВидДвиженияНакопления.Приход);
			Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
			Движение.Заказ = ТекущаяСтрока.Документ;
			//Движение.Сумма = ТекущаяСтрока.Сумма;
			Если ТекущаяСтрока.Документ.Валюта = Валюта ИЛИ ТекущаяСтрока.СуммаВВалютеДокумента = 0 Тогда 
				//Движение.Сумма = ТекущаяСтрока.Сумма;
				Движение.Сумма = ?(НЕ ВидОперации = Перечисления.ВидыОперацийОплатаБанковскойКартой.ВозвратОплатыКлиенту, ТекущаяСтрока.Сумма, -ТекущаяСтрока.Сумма);
			Иначе
				//Движение.Сумма = ТекущаяСтрока.СуммаВВалютеДокумента;
				Движение.Сумма = ?(НЕ ВидОперации = Перечисления.ВидыОперацийОплатаБанковскойКартой.ВозвратОплатыКлиенту, ТекущаяСтрока.СуммаВВалютеДокумента, -ТекущаяСтрока.СуммаВВалютеДокумента);
			КонецЕсли;
			Движение.Контрагент = Контрагент; // №6496 добавлен контрагент в измерение
		КонецЕсли;	
	КонецЦикла;
	
	//регистр ВзаиморасчетыСКонтрагентамиПоЗаказам Расход
	Движения.ВзаиморасчетыСКонтрагентамиПоЗаказам.Записывать = Истина;
	Для Каждого ТекущаяСтрока Из РаспределениеПлатежа Цикл
		Если ТипЗнч(ТекущаяСтрока.Документ) = Тип("ДокументСсылка.ЗаказДоговор") Тогда
			Движение = Движения.ВзаиморасчетыСКонтрагентамиПоЗаказам.Добавить();
			Движение.ВидДвижения = ?(НЕ ВидОперации = Перечисления.ВидыОперацийОплатаБанковскойКартой.ВозвратОплатыКлиенту, ВидДвиженияНакопления.Расход, ВидДвиженияНакопления.Приход);
			Движение.Период = Дата;
			Движение.Заказ = ТекущаяСтрока.Документ;
			Движение.Сумма = РаботаСВалютой.ПолучитьСуммуВВалютеУчетаПоДокументу(Ссылка, ТекущаяСтрока.Сумма);
		КонецЕсли;					
	КонецЦикла;
	
	//ДоходыРасходы
	// #11129 закомментировано: ОБК не должна двигать доходы и расходы кассовым методом, т.к. потом по ОБК будет оформлено ПнРС, 
