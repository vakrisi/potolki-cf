	ЗаполнитьЗначенияСвойств(ЭтотОбъект, ДанныеЗаполнения, , "Дата, Номер, ВидОперации, Комментарий, Комиссия, 
															| НомерСменыККМ, НомерЧекаККМ, ПроцентКомиссии, 
															| НачислятьБонусы, СлужебныйУчетБонусовПоДисконтнымКартам, 
															| ЧекФискализирован, КодАвторизации, ОплатаВыполнена");
	ВидОперации = Перечисления.ВидыОперацийОплатаБанковскойКартой.ВозвратОплатыКлиенту;	
	//#11129 закомментировано
	//СтатьяРасходов = ФинансыСервер.ПолучитьСтатьюДоходовРасходов(Метаданные().Имя, ВидОперации, Ложь);
	
	ОбщийМодульСервер.ЗагрузитьВТаблицуЗначений(ДанныеЗаполнения.РаспределениеПлатежа, ЭтотОбъект.РаспределениеПлатежа, Истина);
	
	ДобавитьОснование(ДанныеЗаполнения);
	
КонецПроцедуры

Процедура ЗаполнитьПоВозвратуОтПокупателя(ДанныеЗаполнения)
	
	ВидОперации = Перечисления.ВидыОперацийОплатаБанковскойКартой.ВозвратОплатыКлиенту;
	
	МассивДокументов = Новый Массив;
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ВозвратТовараОтПокупателя") Тогда
		МассивДокументов.Добавить(ДанныеЗаполнения);		
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("Массив") Тогда
		МассивДокументов = ДанныеЗаполнения;
	Иначе
		Возврат;
	КонецЕсли;
	
	Контрагент 		= МассивДокументов[0].Контрагент;		
	Организация 	= МассивДокументов[0].Организация;
	Подразделение 	= МассивДокументов[0].Подразделение; // №12857
	Договор 		= МассивДокументов[0].ДоговорКонтрагента;
	Валюта 			= МассивДокументов[0].Валюта;
	
	СуммаДокумента = 0;
	Для каждого ЭлементМассива из МассивДокументов Цикл
		Если Контрагент <> ЭлементМассива.Контрагент Тогда
			Текст = НСтр("ru = 'Контрагенты в выделенных документах различаются, создание документа невозможно'");			
			ВызватьИсключение Текст;
		КонецЕсли;
		
		ДобавитьОснование(ЭлементМассива);
		СуммаДокумента = СуммаДокумента + ЭлементМассива.СуммаДокумента;
	КонецЦикла;
	
	Сумма = СуммаДокумента;
	
КонецПроцедуры

