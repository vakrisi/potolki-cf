&НаКлиенте
Процедура КассаПриИзменении(Элемент)
	Если НЕ КассаПриИзмененииНаСервере() Тогда
		ПоказатьПредупреждение(,"Выбран счет, не принадлежащая организации");
		Возврат;
	КонецЕсли;
	ПересчитатьБонусыПоДокументу();
КонецПроцедуры

&НаСервере
Функция КассаПриИзмененииНаСервере()
	
	Если НЕ Объект.Счет.Владелец = Объект.Организация Тогда
		Объект.Счет = Неопределено;
		Возврат Ложь;
	КонецЕсли;
	
	Если НЕ Объект.Счет.Валюта.Пустая() тогда
		Объект.Валюта = Объект.Счет.Валюта;
	Иначе
		Объект.Валюта = Константы.ВалютаУчета.Получить();
	КонецЕсли;
	
	Если НЕ Объект.Валюта = ВалютаДокумента Тогда // №11237 пересчитываем если валюта была другая, было: Если НЕ Объект.Валюта = ВалютаУчета Тогда
		
		//++ №11237 сумму документа также пересчитываем
		ДатаКурса    = ?(ЗначениеЗаполнено(Объект.Дата), Объект.Дата, ТекущаяДатаСеанса());
		Объект.Сумма = РаботаСВалютой.ПересчитатьИзВалютыВВалюту(ВалютаДокумента, Объект.Валюта, ДатаКурса, Объект.Сумма);
		//-- №11237
		
		//пересчитаем сумму распределения в валюте документа, т.к. сменился курс валюты
		ОбработкаТабличныхЧастейСервер.ПересчитатьИзВалютыВВалюту(Объект.РаспределениеПлатежа, Объект.Валюта, Объект.Дата, Истина);
		
		ВалютаДокумента = Объект.Валюта; // №11237
		
	КонецЕсли;
	
	Возврат Истина;

КонецФункции

&НаКлиенте
Процедура СуммаПриИзменении(Элемент)
	
	Если Объект.Сумма > 0 И Объект.Сумма > Объект.СуммаОсновногоТелаЗайма Тогда
		Объект.СуммаОсновногоТелаЗайма = Объект.Сумма - Объект.СуммаПроцентовПоЗайму;
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура("СтараяСуммаДокумента", СтараяСуммаДокумента);
	ВыполнитьРаспределениеОплаты(ДополнительныеПараметры);
	
	СуммаПриИзмененииКлиент();
	
	СтараяСуммаДокумента = Объект.Сумма;
	
КонецПроцедуры

// Экспорт - вызывается из ФинансыКлиент 
&НаКлиенте
Процедура СуммаПриИзмененииКлиент() Экспорт
		
	СтараяСуммаДокумента = Объект.Сумма;
	
	ФинансыКлиентСервер.ПересчитатьСуммуНДС(Объект, УчитыватьНДС);
	ПересчитатьБонусыПоДокументу();
	 
КонецПроцедуры

&НаКлиенте
Процедура ВалютаПриИзменении(Элемент)
	
	//++ №11237 нужно пересчитать из валюты в валюту если она поменялась, предварительно уточнив у пользователя
	//ОбновитьДанные();
	Если ЗначениеЗаполнено(Объект.Валюта) И НЕ ВалютаДокумента = Объект.Валюта Тогда
		Если (Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийПоступлениеНаРасчетныйСчет.ОплатаОтПокупателя")
				ИЛИ Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийПоступлениеНаРасчетныйСчет.ВозвратОтПоставщика")
				ИЛИ Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийПоступлениеНаРасчетныйСчет.ПрочееПоступление"))
		Тогда
			ТекстВопроса = "Пересчитать суммы документа по курсу новой валюты?";
			ОписаниеОповещения = Новый ОписаниеОповещения("ВалютаПриИзмененииФрагмент", ЭтотОбъект);
			ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
		Иначе
			ВалютаПриИзмененииЗавершение();
		КонецЕсли;
	Иначе
		ВалютаПриИзмененииЗавершение();
	КонецЕсли;
	//-- №11237
	
КонецПроцедуры

//++ №11237
&НаКлиенте
Процедура ВалютаПриИзмененииФрагмент(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		ВалютаПриИзмененииСервер(Объект.Валюта,	Истина);		
	Иначе
		Объект.Валюта = ВалютаДокумента;
	КонецЕсли;
	
	ВалютаПриИзмененииЗавершение();
		
КонецПроцедуры

&НаКлиенте
Процедура ВалютаПриИзмененииЗавершение()
	
	ВалютаДокумента = Объект.Валюта;
	
	ОбновитьДанные();
		
КонецПроцедуры 

&НаСервере
Процедура ВалютаПриИзмененииСервер(НоваяВалюта, ПересчитатьСуммы = Истина)
		
	Если ПересчитатьСуммы Тогда 
		
		СтараяВалюта = ВалютаДокумента;
		ДатаКурса    = ?(ЗначениеЗаполнено(Объект.Дата), Объект.Дата, ТекущаяДатаСеанса());
		
		Объект.Сумма = РаботаСВалютой.ПересчитатьИзВалютыВВалюту(СтараяВалюта, НоваяВалюта, ДатаКурса, Объект.Сумма);
		РаспределитьСуммуОплатыПоДокументам();
		
	КонецЕсли;
		
КонецПроцедуры
