&НаСервереБезКонтекста
Функция ПолучитьСтоимостьЗаказовВРаботе(Знач Контрагент, Знач ВалютаДокумента, Дата)
	
	ТекущийСтатус = Новый СписокЗначений;
	ТекущийСтатус.Добавить(Справочники.СтатусыЗаказовПокупателей.ВРаботе);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	//|	ЗаказыПокупателей.ЗаказНаПроизводство КАК ЗаказНаПроизводство,
	|	ЗаказыПокупателей.ЗаказНаПроизводство.Валюта КАК Валюта,
	//|	ЗаказыПокупателей.ЗаказНаПроизводство.ТекущийСтатус КАК ТекущийСтатус,
	//|	ЗаказыПокупателей.ЗаказНаПроизводство.СуммаДокумента КАК СуммаДокумента,
	//|	ЗаказыПокупателей.ЗаказНаПроизводство.Комментарий КАК Комментарий,
	|	ЗаказыПокупателей.СуммаОстаток КАК СуммаОстаток
	|ИЗ
	|	РегистрНакопления.ЗаказыПокупателей.Остатки(
	|			&ТекущаяДата,
	|			ЗаказНаПроизводство.Контрагент = &Контрагент
	|				И ЗаказНаПроизводство.ТекущийСтатус В (&ТекущийСтатус)) КАК ЗаказыПокупателей";
	Запрос.УстановитьПараметр("ТекущаяДата",КонецДня(ТекущаяДатаСеанса()));
	Запрос.УстановитьПараметр("Контрагент",Контрагент);
	Запрос.УстановитьПараметр("ТекущийСтатус",ТекущийСтатус);
	
	// №7373 сумму долга показываем в валюте текущего документа, если валюта отличается от валюты учета
	//ОжидаемаяСумма = Запрос.Выполнить().Выгрузить().Итог("СуммаДокумента");
	ОжидаемаяСумма = 0;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ПересчитаннаяСумма = Выборка.СуммаОстаток; //Выборка.СуммаДокумента;
		Если НЕ ВалютаДокумента = Выборка.Валюта Тогда
			ПересчитаннаяСумма = Окр(РаботаСВалютой.ПересчитатьИзВалютыВВалюту(Выборка.Валюта, ВалютаДокумента, Дата, ПересчитаннаяСумма), 2);
		КонецЕсли;
		ОжидаемаяСумма = ОжидаемаяСумма + ПересчитаннаяСумма;
	КонецЦикла;	
	
	Возврат ОжидаемаяСумма;
	
КонецФункции
