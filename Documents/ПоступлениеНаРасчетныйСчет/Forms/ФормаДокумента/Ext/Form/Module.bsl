#Область ПечатьЧека

&НаКлиенте
Процедура ПечатьЧека(Команда)
	
	Если Объект.ЧекФискализирован Тогда
		ТекстСообщения = НСтр("ru = 'Чек уже пробит на оборудовании!'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		Возврат;
	КонецЕсли;
	
	//++ №7951 необходимо проверить права на объекты распределения, как минимум должно быть чтение
	Если НЕ ПотолкиКассыОнлайн.ПроверитьДоступКДокументамРаспределения(Объект) Тогда
		Возврат;
	КонецЕсли;	
	//-- №7951
		
	ОбработчикОповещения = Новый ОписаниеОповещения("ОповещениеВопросПроведениеПередПечатьюЧека", ЭтотОбъект);	
	Если ПотолкиКассыОнлайнКлиент.ПроверитьВозможностьПечатиЧека(ОбработчикОповещения, ЭтотОбъект) Тогда
		ПечатьЧекаКлиент();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПечатьЧекаКлиент()
	
	ПараметрыОперации = Новый Структура;
	ПараметрыОперации.Вставить("ДокументСсылка",           Объект.Ссылка);
	ПараметрыОперации.Вставить("Партнер",                  Объект.Контрагент);
	ПараметрыОперации.Вставить("Организация",              Объект.Организация);
	ПараметрыОперации.Вставить("ПодключенноеОборудование", Неопределено); //ФискальнаяОперацияПодключенноеОборудование);
		
	ОписаниеОповещенияПриЗавершении = Новый ОписаниеОповещения("ФискализацияЧека_Завершение", ЭтотОбъект);
	ОткрытьФорму(
			"Обработка.ПредпросмотрЧека.Форма",
			ПараметрыОперации,
			ЭтотОбъект,,,,
			ОписаниеОповещенияПриЗавершении);
			
КонецПроцедуры

&НаКлиенте
Процедура ОповещениеВопросПроведениеПередПечатьюЧека(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		Если Записать(Новый Структура("РежимЗаписи", РежимЗаписиДокумента.Проведение)) Тогда
			ПечатьЧекаКлиент();
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ФискализацияЧека_Завершение(РезультатВыполнения, Параметры) Экспорт
	
	Если НЕ РезультатВыполнения = Неопределено И НЕ РезультатВыполнения = КодВозвратаДиалога.Отмена Тогда
		Если РезультатВыполнения.Результат Тогда
			// Установить полученное значение номера чека реквизиту документа.
			Объект.НомерСменыККМ = РезультатВыполнения.НомерСмены;
			Объект.НомерЧекаККМ = РезультатВыполнения.НомерЧекаККМ;
			
			Объект.ЧекФискализирован = Истина;;
			Объект.Дата = МенеджерОборудованияКлиентПереопределяемый.ДатаСеанса();
			Если Не ЗначениеЗаполнено(Объект.НомерЧекаККМ) Тогда
				Объект.НомерЧекаККМ = 1;
			КонецЕсли;
						
			ПараметрыЗаписи = Новый Структура("РежимЗаписи, РежимПроведения", РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Оперативный);
			Если НЕ ЗаписатьДокументНаФорме(ПараметрыЗаписи) Тогда
				ТекстСообщения = НСтр("ru = 'Ошибка записи документа'");
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
			КонецЕсли;
		Иначе
			ТекстСообщения = РезультатВыполнения.ОписаниеОшибки;
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаписьЖурналаФискальныхОпераций(Команда)
	
	ФискальнаяОперацияДанныеЖурнала = Неопределено;
	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
		ФискальнаяОперацияДанныеЖурнала = ПотолкиКассыОнлайн.ДанныеЖурналаФискальныхОпераций(Объект.Ссылка);
	КонецЕсли;
	Если ФискальнаяОперацияДанныеЖурнала = Неопределено Тогда
		Сообщить("Документ не проведен, не пробит чек или отсутствует запись в журнале");
	Иначе
		ПотолкиКассыОнлайнКлиент.ОткрытьЗаписьЖурналаФискальныхОпераций(ЭтотОбъект, ФискальнаяОперацияДанныеЖурнала);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ОбновитьДанные()
	
	Элементы.ГруппаКонтрагент.Видимость = Ложь;
	Элементы.ГруппаЭквайринговыйТерминал.Видимость = Ложь;
	Элементы.ГруппаЭквайринговыеОперации.Видимость = Ложь; //#6440 
	Элементы.ОснованияЗаполнитьОснованияПоРаспределению.Видимость = Истина;
	Элементы.ГруппаРаспределениеПлатежа.Видимость = Ложь;
	Элементы.РаспределениеПлатежаДатаПлатежаПоРассрочке.Видимость = Ложь;
	Элементы.ГруппаСуммыРаспределения.Видимость = Ложь;
	Элементы.СуммаОсновногоТелаЗайма.Видимость = Ложь;  
	Элементы.СуммаПроцентовПоЗайму.Видимость = Ложь;  
	Элементы.РаспределениеПлатежаГруппаВозврат.Видимость = Ложь; //#7080
	Элементы.РаспределениеПлатежаГруппаОплата.Видимость = Ложь;  //#7080
	
	//#9708
	Элементы.СтатьяДоходовПоНачислению.Видимость = ПолучитьФункциональнуюОпцию("НекассовыйМетодВеденияУчетаДоходовРасходов") 
									И Объект.ВидОперации = Перечисления.ВидыОперацийПоступлениеНаРасчетныйСчет.ПрочееПоступление
									//++ №13755
									И ЗначениеЗаполнено(Объект.Ссылка)
									И НЕ (Объект.СтатьяДоходов = Объект.СтатьяДоходовПоНачислению);
									//-- №13755
									
	Элементы.СтатьяДоходов.Видимость = Истина; // #12545								
	//управляем видимостью элементов в зависимости от того, какой вид операции
	Если Объект.ВидОперации = Перечисления.ВидыОперацийПоступлениеНаРасчетныйСчет.ОплатаОтПокупателя Тогда
		Элементы.ГруппаРаспределениеПлатежа.Видимость = Истина;
		Элементы.РаспределениеПлатежаДатаПлатежаПоРассрочке.Видимость = Истина;
		Элементы.РаспределениеПлатежаГруппаОплата.Видимость = Истина;
		Элементы.ГруппаСуммыРаспределения.Видимость = Истина;
		Элементы.ГруппаКонтрагент.Видимость = Истина;
		Элементы.ДекорацияСуммаДолга.Заголовок = ПолучитьСтоимостьЗаказовВРаботе(Объект.Контрагент, Объект.Валюта, ТекущаяДатаСеанса()) +    //nva
			ПолучитьТекущийДолгКлиента(Объект.Организация, Объект.Контрагент, Объект.Договор, Объект.Валюта, ВалютаУчета, Объект.Дата);
		// №7373 валюту показываем выбранную в текущем документе
		Элементы.ДекорацияНадписьВалютаДолга.Заголовок = Объект.Валюта;
		
	ИначеЕсли Объект.ВидОперации = Перечисления.ВидыОперацийПоступлениеНаРасчетныйСчет.ПолучениеКредита ИЛИ Объект.ВидОперации = Перечисления.ВидыОперацийПоступлениеНаРасчетныйСчет.ВозвратЗайма Тогда
		Элементы.ГруппаРаспределениеПлатежа.Видимость = Ложь;
		Элементы.РаспределениеПлатежаДатаПлатежаПоРассрочке.Видимость = Истина;
		Элементы.РаспределениеПлатежаГруппаОплата.Видимость = Истина;
		Элементы.ГруппаСуммыРаспределения.Видимость = Истина;
		Элементы.ГруппаКонтрагент.Видимость = Истина;
		Элементы.ОснованияЗаполнитьОснованияПоРаспределению.Видимость = Ложь;
		Элементы.ДекорацияСуммаДолга.Заголовок = ПолучитьСтоимостьЗаказовВРаботе(Объект.Контрагент, Объект.Валюта, ТекущаяДатаСеанса()) +    //nva
			ПолучитьТекущийДолгКлиента(Объект.Организация, Объект.Контрагент, Объект.Договор, Объект.Валюта, ВалютаУчета, Объект.Дата);
		// №7373 валюту показываем выбранную в текущем документе
		Элементы.ДекорацияНадписьВалютаДолга.Заголовок = Объект.Валюта;
	    Элементы.СтатьяДоходов.Видимость = Ложь;
		Если Объект.ВидОперации = Перечисления.ВидыОперацийПоступлениеНаРасчетныйСчет.ВозвратЗайма Тогда
			Элементы.СтатьяДоходов.Видимость = Истина;
			Элементы.СуммаОсновногоТелаЗайма.Видимость = Истина;  
			Элементы.СуммаПроцентовПоЗайму.Видимость = Истина;  
	    КонецЕсли;
		
	ИначеЕсли Объект.ВидОперации = Перечисления.ВидыОперацийПоступлениеНаРасчетныйСчет.ИнкассацияВБанк Тогда
		// контрагент в перации не нужен
		//Элементы.ГруппаКонтрагент.Видимость = Истина;
		//Элементы.ДекорацияСуммаДолга.Заголовок = ПолучитьТекущийДолгКлиента(Объект.Организация, Объект.Контрагент, Объект.Договор, Объект.Валюта, ВалютаУчета, Объект.Дата);
		// №7373 валюту показываем выбранную в текущем документе
		Элементы.ДекорацияНадписьВалютаДолга.Заголовок = Объект.Валюта; //Константы.ВалютаУчета.Получить();
		Элементы.СтатьяДоходов.Видимость = Ложь; // #12545
		
	ИначеЕсли Объект.ВидОперации = Перечисления.ВидыОперацийПоступлениеНаРасчетныйСчет.ПоступлениеПоБанковскимКартам Тогда
		Элементы.ГруппаЭквайринговыйТерминал.Видимость = Истина;
		Элементы.ОснованияЗаполнитьОснованияПоРаспределению.Видимость = Ложь;
		Элементы.ГруппаЭквайринговыеОперации.Видимость = ПолучитьФункциональнуюОпцию("ИспользоватьРаспределениеПоЭквайрингу"); //#6440
		
	ИначеЕсли Объект.ВидОперации = Перечисления.ВидыОперацийПоступлениеНаРасчетныйСчет.ПрочееПоступление Тогда
		// №12420 контрагент не нужен Элементы.ГруппаКонтрагент.Видимость = Истина;
		Элементы.ГруппаРаспределениеПлатежа.Видимость = Истина;
		Элементы.РаспределениеПлатежаГруппаОплата.Видимость = Истина;
		// №12420 контрагент не нужен Элементы.ДекорацияСуммаДолга.Заголовок = ПолучитьТекущийДолгКлиента(Объект.Организация, Объект.Контрагент, Объект.Договор, Объект.Валюта, ВалютаУчета, Объект.Дата);
		// №7373 валюту показываем выбранную в текущем документе
		Элементы.ДекорацияНадписьВалютаДолга.Заголовок = Объект.Валюта;
		
	//#7080	
	ИначеЕсли Объект.ВидОперации = Перечисления.ВидыОперацийПоступлениеНаРасчетныйСчет.ВозвратОтПоставщика Тогда
		Элементы.ГруппаКонтрагент.Видимость = Истина;
		Элементы.ГруппаРаспределениеПлатежа.Видимость = Истина;
		Элементы.РаспределениеПлатежаГруппаВозврат.Видимость = Истина;
		Элементы.ДекорацияСуммаДолга.Заголовок = ПолучитьСтоимостьЗаказовВРаботе(Объект.Контрагент, Объект.Валюта, ТекущаяДатаСеанса()) +    //nva
			ПолучитьТекущийДолгКлиента(Объект.Организация, Объект.Контрагент, Объект.Договор, Объект.Валюта, ВалютаУчета, Объект.Дата);
		// №7373 валюту показываем выбранную в текущем документе
		Элементы.ДекорацияНадписьВалютаДолга.Заголовок = Объект.Валюта;
		
	КонецЕсли;
	//Элементы.ГруппаРаспределениеПлатежа.Видимость = НЕ (Объект.ВидОперации = Перечисления.ВидыОперацийПоступлениеНаРасчетныйСчет.ПоступлениеПоБанковскимКартам); 
	
	// №7373 нужно определить различие в валютах, чтобы корректно отображать определенные колонки и суммы
	ВалютаЗаказаРавнаВалютеДокумента = ФинансыСервер.ОпределитьРазличиеВалютыЗаказаИВалютыДокумента(Объект);
	
	СписокДокументовРаспределения = Объект.РаспределениеПлатежа.Выгрузить(,"Документ");
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	РасчетыПоЗаказамОстатки.СуммаОстаток КАК ОсталосьРаспределить,
	|	РасчетыПоЗаказамОстатки.Заказ КАК Заказ,
	|	РасчетыПоЗаказамОстатки.Заказ.СуммаДокумента КАК СуммаДокумента,
	|	РасчетыПоЗаказамОстатки.Заказ.Валюта КАК Валюта
	|ИЗ
	|	РегистрНакопления.РасчетыПоЗаказам.Остатки(, Заказ В (&Заказ)) КАК РасчетыПоЗаказамОстатки";
	Запрос.УстановитьПараметр("Заказ", СписокДокументовРаспределения);
	ТаблицаПоДокументам = Запрос.Выполнить().Выгрузить();
	Для Каждого СтрокаРаспределения Из Объект.РаспределениеПлатежа Цикл
		Отбор = Новый Структура;
		Отбор.Вставить("Заказ", СтрокаРаспределения.Документ);
		НайденныеСтроки = ТаблицаПоДокументам.НайтиСтроки(Отбор);
		Если НайденныеСтроки.Количество() > 0 Тогда
			Если Объект.Валюта = ВалютаУчета И ВалютаЗаказаРавнаВалютеДокумента Тогда 
				ЗаполнитьЗначенияСвойств(СтрокаРаспределения, НайденныеСтроки[0]);
			Иначе
				СтрокаРаспределения.ВалютаДокумента = НайденныеСтроки[0].Валюта; 
				СтрокаРаспределения.СуммаДокументаВВалютеДокумента = НайденныеСтроки[0].СуммаДокумента;
				СтрокаРаспределения.СуммаДокумента = РаботаСВалютой.ПересчитатьИзВалютыВВалюту(НайденныеСтроки[0].Валюта, Объект.Валюта, Объект.Дата, НайденныеСтроки[0].СуммаДокумента);
				СтрокаРаспределения.ОсталосьРаспределить = РаботаСВалютой.ПересчитатьИзВалютыВВалюту(НайденныеСтроки[0].Валюта, Объект.Валюта, Объект.Дата, НайденныеСтроки[0].ОсталосьРаспределить);
			КонецЕсли;
		Иначе
			Попытка
				Если Объект.Валюта = ВалютаУчета И ВалютаЗаказаРавнаВалютеДокумента Тогда
					СтрокаРаспределения.СуммаДокумента = СтрокаРаспределения.Документ.СуммаДокумента;
				Иначе
					СтрокаРаспределения.ВалютаДокумента = СтрокаРаспределения.Документ.Валюта; 
					СтрокаРаспределения.СуммаДокументаВВалютеДокумента = СтрокаРаспределения.Документ.СуммаДокумента;
					СтрокаРаспределения.СуммаДокумента = РаботаСВалютой.ПересчитатьИзВалютыВВалюту(СтрокаРаспределения.Документ.Валюта, Объект.Валюта, Объект.Дата, СтрокаРаспределения.Документ.СуммаДокумента);
				КонецЕсли;
			Исключение
			КонецПопытки;
		КонецЕсли;
	КонецЦикла;
	
	//Элементы.КонтрагентДополнительно.Видимость = Объект.Контрагент.ПоказыватьДопИнформацию;
	ОбщийМодульСервер.ДополнительнаяИнформацияПоКонтрагентуНаФорме(Объект.Контрагент, Элементы.ПоказатьДополнительнуюИнформацию);
	ОбщийМодульСервер.РегулировкаШириныПоляКонтрагента(Элементы, Элементы.Контрагент, Элементы.ПоказатьДополнительнуюИнформацию);
	
	ФинансыСервер.ОбновитьНадписиРаспеределениеПлатежа(ЭтаФорма, Объект, , ВалютаУчета, ВалютаЗаказаРавнаВалютеДокумента);
	ФинансыСервер.ОбновитьВидимостьИКурсВалюты(ЭтотОбъект);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьКнопокРаспределения()
	Элементы.РаспределениеПлатежаРаспределение_ЗаказДоговор.Видимость 		 = Константы.ВестиРасчетыПоЗаказамПоЗаказДоговору.Получить();
	Элементы.ГруппаРаспределениеЗаказДоговор.Видимость = Элементы.РаспределениеПлатежаРаспределение_ЗаказДоговор.Видимость;
	
	Элементы.РаспределениеПлатежаРаспределение_СчетНаОплату.Видимость 		 = Константы.ВестиРасчетыПоЗаказамПоСчетуНаОплату.Получить();
	Элементы.ГруппаРаспределениеСчетНаОплату.Видимость = Элементы.РаспределениеПлатежаРаспределение_СчетНаОплату.Видимость;
	
