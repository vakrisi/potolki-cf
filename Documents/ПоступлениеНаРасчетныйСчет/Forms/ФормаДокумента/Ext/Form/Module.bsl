&НаКлиенте
Процедура ЭквайринговыеОперации_ЗаполнитьПоПериоду(Команда)
	
	ВыполнитьВозврат = ПроверитьРеквизитыПередЗаполнениемТабличнойЧастиЭквайринговыеОперации();
	Если ВыполнитьВозврат Тогда
		Возврат;
	КонецЕсли;
	
	ОписаниеОповещенияОЗавершении = Новый ОписаниеОповещения("ЭквайринговыеОперации_ЗаполнитьПоПериодуЗавершение", ЭтотОбъект);
	Если Объект.ЭквайринговыеОперации.Количество() > 0 Тогда
		ПоказатьВопрос(ОписаниеОповещенияОЗавершении, НСтр("ru='Эквайринговые операции будут полностью перезаполнены. Продолжить?'"), РежимДиалогаВопрос.ДаНет,, КодВозвратаДиалога.Да);
	Иначе
		ОткрытьФормуВыбораПериодаРасчета();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЭквайринговыеОперации_ЗаполнитьПоПериодуЗавершение(Результат, Параметры) Экспорт
	
	Если Результат <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	ОткрытьФормуВыбораПериодаРасчета();
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуВыбораПериодаРасчета()
	
	ПараметрыЗаполнения = Новый Структура;
	ПараметрыЗаполнения.Вставить("ПериодДатаОкончания", Объект.Дата);	
	
	ОписаниеОповещенияОЗавершении = Новый ОписаниеОповещения("ОткрытьФормуВыбораПериодаРасчетаЗавершение", ЭтотОбъект);
	ОткрытьФорму("ОбщаяФорма.ФормаВыбораПериода", ПараметрыЗаполнения, ЭтотОбъект, УникальныйИдентификатор,,, ОписаниеОповещенияОЗавершении, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуВыбораПериодаРасчетаЗавершение(Результат, Параметры) Экспорт
	
	Если ТипЗнч(Результат) = Тип("Структура") Тогда
		ЭквайринговыеОперации_ЗаполнитьПоПериодуНаСервере(Результат.ПериодДатаНачала, Результат.ПериодДатаОкончания);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЭквайринговыеОперации_ЗаполнитьПоПериодуНаСервере(ДатаНачала = '00010101', ДатаОкончания = '00010101')
	
	Модифицированность = Истина;
	
	//схожий запрос в общей форме подбора долгов по эквайрингу
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДатаНачала", НачалоДня(ДатаНачала));
	Запрос.УстановитьПараметр("ДатаОкончания", КонецДня(ДатаОкончания));
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	Запрос.УстановитьПараметр("ЭквайринговыйТерминал", Объект.ЭквайринговыйТерминал);
	Запрос.УстановитьПараметр("Регистратор", Объект.Ссылка);
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	РасчетыПоЭквайрингу.Документ КАК Документ,
	|	СУММА(ВЫБОР
	|			КОГДА РасчетыПоЭквайрингу.Документ ССЫЛКА Документ.ОплатаБанковскойКартой
	|					И РасчетыПоЭквайрингу.Документ.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийОплатаБанковскойКартой.ВозвратОплатыКлиенту)
	|				ТОГДА 0
	|			ИНАЧЕ РасчетыПоЭквайрингу.СуммаПриход - РасчетыПоЭквайрингу.СуммаРасход
	|		КОНЕЦ) КАК Сумма,
	|	СУММА(ВЫБОР
	|			КОГДА РасчетыПоЭквайрингу.Документ ССЫЛКА Документ.ОплатаБанковскойКартой
	|					И РасчетыПоЭквайрингу.Документ.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийОплатаБанковскойКартой.ВозвратОплатыКлиенту)
	|				ТОГДА 0
	|			ИНАЧЕ РасчетыПоЭквайрингу.КомиссияБанкаПриход - РасчетыПоЭквайрингу.КомиссияБанкаРасход
	|		КОНЕЦ) КАК СуммаКомиссии,
	|	СУММА(ВЫБОР
	|			КОГДА РасчетыПоЭквайрингу.Документ ССЫЛКА Документ.ОплатаБанковскойКартой
	|					И РасчетыПоЭквайрингу.Документ.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийОплатаБанковскойКартой.ВозвратОплатыКлиенту)
	|				ТОГДА РасчетыПоЭквайрингу.СуммаПриход - РасчетыПоЭквайрингу.СуммаРасход
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК СуммаВозврата,
	|	СУММА(ВЫБОР
	|			КОГДА РасчетыПоЭквайрингу.Документ ССЫЛКА Документ.ОплатаБанковскойКартой
	|					И РасчетыПоЭквайрингу.Документ.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийОплатаБанковскойКартой.ВозвратОплатыКлиенту)
	|				ТОГДА РасчетыПоЭквайрингу.КомиссияБанкаПриход - РасчетыПоЭквайрингу.КомиссияБанкаРасход
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК СуммаКомиссииВозврата
	|ИЗ
	|	РегистрНакопления.РасчетыПоЭквайрингу.Обороты(
	|			,
	|			,
	|			Регистратор,
	|			Организация = &Организация
	|				И ЭквайринговыйТерминал = &ЭквайринговыйТерминал
	|				И (Документ.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания)) КАК РасчетыПоЭквайрингу
	|ГДЕ
	|	РасчетыПоЭквайрингу.Регистратор <> &Регистратор
	|
	|СГРУППИРОВАТЬ ПО
	|	РасчетыПоЭквайрингу.Документ
	|
	|ИМЕЮЩИЕ
	|	СУММА(РасчетыПоЭквайрингу.СуммаПриход - РасчетыПоЭквайрингу.СуммаРасход) > 0";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Объект.ЭквайринговыеОперации.Загрузить(РезультатЗапроса.Выгрузить());
	
	// сумму документа меняем, если только она равна 0
	СуммаОпераций = Объект.ЭквайринговыеОперации.Итог("Сумма") - Объект.ЭквайринговыеОперации.Итог("СуммаВозврата");
	СуммаКомиссий = Объект.ЭквайринговыеОперации.Итог("СуммаКомиссии") - Объект.ЭквайринговыеОперации.Итог("СуммаКомиссииВозврата");	
	Если Объект.Сумма = 0 Тогда
		Объект.Сумма = СуммаОпераций - СуммаКомиссий;
		Объект.КомиссияБанка = СуммаКомиссий;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЭквайринговыеОперации_Подбор(Команда)
	
	ВыполнитьВозврат = ПроверитьРеквизитыПередЗаполнениемТабличнойЧастиЭквайринговыеОперации();
	Если ВыполнитьВозврат Тогда
		Возврат;
	КонецЕсли;
	
	АдресЭквайринговыеОперацииВХранилище = ПоместитьЭквайринговыеОперацииВХранилище();
	
	ПараметрыПодбора = Новый Структура(
		"АдресЭквайринговыеОперацииВХранилище,
		|Организация,
		|Дата,
		|Ссылка,
		|Валюта,
		|СуммаДокумента,
		|ЭквайринговыйТерминал",
		АдресЭквайринговыеОперацииВХранилище,
		Объект.Организация,
		Объект.Дата,
		Объект.Ссылка,
		Объект.Валюта,
		Объект.Сумма,
		Объект.ЭквайринговыйТерминал
	);
	
	ОписаниеОповещенияОЗавершении = Новый ОписаниеОповещения("ЭквайрингПодборЗавершение", ЭтотОбъект, Новый Структура("АдресЭквайринговыеОперацииВХранилище", АдресЭквайринговыеОперацииВХранилище));
	ОткрытьФорму("ОбщаяФорма.ФормаПодбораДолговПоЭквайрингу", ПараметрыПодбора,,,,,ОписаниеОповещенияОЗавершении);
	
КонецПроцедуры

&НаСервере
Функция ПоместитьЭквайринговыеОперацииВХранилище() 
	
	Возврат ПоместитьВоВременноеХранилище(
		Объект.ЭквайринговыеОперации.Выгрузить(),
		УникальныйИдентификатор
	);
	
КонецФункции // ПоместитьЭквайринговыеОперацииВХранилище()

&НаКлиенте
Процедура ЭквайрингПодборЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	АдресЭквайринговыеОперацииВХранилище = ДополнительныеПараметры.АдресЭквайринговыеОперацииВХранилище;
	
	Если Результат = КодВозвратаДиалога.OK Тогда
		
		ПолучитьЭквайринговыеОперацииИзХранилища(АдресЭквайринговыеОперацииВХранилище);
		
		СуммаОпераций = Объект.ЭквайринговыеОперации.Итог("Сумма") - Объект.ЭквайринговыеОперации.Итог("СуммаВозврата");
		СуммаКомиссий = Объект.ЭквайринговыеОперации.Итог("СуммаКомиссии") - Объект.ЭквайринговыеОперации.Итог("СуммаКомиссииВозврата");	
		Объект.Сумма = СуммаОпераций - СуммаКомиссий;
		Объект.КомиссияБанка = СуммаКомиссий;
	
	КонецЕсли;

КонецПроцедуры // ЭквайрингПодборЗавершение()

&НаСервере
Процедура ПолучитьЭквайринговыеОперацииИзХранилища(АдресЭквайринговыеОперацииВХранилище)
	
	ТаблицаЭквайринговыеОперации = ПолучитьИзВременногоХранилища(АдресЭквайринговыеОперацииВХранилище);
	Объект.ЭквайринговыеОперации.Очистить();
	Для каждого СтрокаЭквайринговыеОперации Из ТаблицаЭквайринговыеОперации Цикл
		Строка = Объект.ЭквайринговыеОперации.Добавить();
		ЗаполнитьЗначенияСвойств(Строка, СтрокаЭквайринговыеОперации);
	КонецЦикла;
	
КонецПроцедуры // ПолучитьРасшифровкаПлатежаИзХранилища()

