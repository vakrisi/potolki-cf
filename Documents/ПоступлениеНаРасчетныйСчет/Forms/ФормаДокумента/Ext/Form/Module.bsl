	ВыполнитьВозврат = Ложь;
	Если Объект.Организация.Пустая() Тогда
		ТекстСообщения = НСтр("ru = 'Укажите организацию!'");		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,, "Организация", "Объект", ВыполнитьВозврат);
