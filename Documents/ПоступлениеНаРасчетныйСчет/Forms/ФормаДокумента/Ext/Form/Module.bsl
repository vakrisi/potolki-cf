		ТекстСообщения = НСтр("ru = 'Укажите эквайринговый терминал!'");		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,, "ЭквайринговыйТерминал", "Объект", ВыполнитьВозврат);
	КонецЕсли;
	
	Возврат ВыполнитьВозврат;
	
