Функция ПолучитьСуммуТекущегоДолга()
	
	Результат = 0;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	РасчетыПоЗаказамОстатки.СуммаОстаток
	|ИЗ
	|	РегистрНакопления.РасчетыПоЗаказам.Остатки КАК РасчетыПоЗаказамОстатки
	|ГДЕ
	|	РасчетыПоЗаказамОстатки.Заказ = &ЗаказДоговор";
	Запрос.УстановитьПараметр("ЗаказДоговор",Объект.Ссылка);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат = Выборка.СуммаОстаток;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

