&НаКлиенте
Процедура ПодобратьМатериалы(Команда)
	
	ТекущиеДанные = Элементы.ДеревоТоваров.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		ПоказатьОповещениеПользователя("Выберите комнату");
		Возврат;
	КонецЕсли;	
	
	Если ПустаяСтрока(ТекущиеДанные.Комната) Тогда		
		ПоказатьОповещениеПользователя("Выберите комнату");
		Возврат;
	КонецЕсли;
	
	ПодборВМатериалы = Истина;
	ПараметрыПодбора = ПараметрыПодбора();
	ОткрытьФорму("ОбщаяФорма.ФормаПодбораНоменклатуры", ПараметрыПодбора, ЭтаФорма, УникальныйИдентификатор);
		
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбораПодборМатериаловНаКлиенте(ВыбранноеЗначение)

	Если Не ЗначениеЗаполнено(ВыбранноеЗначение) Тогда
		Возврат;
	КонецЕсли;
	
	ТекущаяСтрока = Элементы.ДеревоМатериалов.ТекущиеДанные;
	ТекущаяКомната = ТекущаяСтрока.Комната;
	
	ОбработатьПодборМатериаловНаСервере(ВыбранноеЗначение, ТекущаяКомната);
	ПеренестиДеревоВТабличнуюЧасть();
	ЗаполнитьВычисляемыеДанныеПоМатериалам();
			
КонецПроцедуры

&НаСервере
Процедура ОбработатьПодборМатериаловНаСервере(ВыбранноеЗначение, ТекущаяКомната)
	
	ТаблицаТоваров = ПолучитьИзВременногоХранилища(ВыбранноеЗначение.АдресВХранилище);
	
	Дерево = ДанныеФормыВЗначение(ДеревоМатериалов, Тип("ДеревоЗначений"));
	Для Каждого Строка из Дерево.Строки Цикл
		Если Строка.Комната = ТекущаяКомната Тогда
			Для Каждого ТекущаяСтрока из ТаблицаТоваров Цикл
				Стр = Строка.Строки.Добавить();
				ЗаполнитьЗначенияСвойств(Стр, ТекущаяСтрока);
				Стр.Комната = ТекущаяКомната;
				Стр.УИСтроки = Новый УникальныйИдентификатор;
			КонецЦикла;
			
			ЗначениеВДанныеФормы(Дерево, ДеревоМатериалов);
			Возврат;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

