&НаКлиенте
Функция НайтиСтрокуДерева(ДеревоПоиска, Комната, Номенклатура, Характеристика = Неопределено, ЕдиницаИзмерения = Неопределено)
	ЭлементыДерева = ДеревоПоиска.ПолучитьЭлементы();
	Для Каждого ТекЭлемент из ЭлементыДерева Цикл
		ПодчиненныеСтроки = ТекЭлемент.ПолучитьЭлементы();
		Для Каждого ПодчиненыйЭлемент Из ПодчиненныеСтроки Цикл
			Если СокрЛП(ПодчиненыйЭлемент.Комната) = СокрЛП(Комната)
				и ПодчиненыйЭлемент.Номенклатура = Номенклатура
				//Добавлено услове по ед. измерения и характестики при добавлении по ШК
				И (?(Характеристика = Неопределено, Истина, ПодчиненыйЭлемент.ХарактеристикаНоменклатуры = Характеристика И ПодчиненыйЭлемент.ЕдиницаИзмерения = ЕдиницаИзмерения))
			Тогда
				Возврат ПодчиненыйЭлемент;
			КонецеСли;
		КонецЦикла;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

&НаКлиенте
Функция НайтиСтрокуДереваМатериалов(Комната, Номенклатура, Характеристика = Неопределено, ЕдиницаИзмерения = Неопределено)
	ЭлементыДерева = ДеревоМатериалов.ПолучитьЭлементы();
	Для Каждого ТекЭлемент из ЭлементыДерева Цикл
		ПодчиненныеСтроки = ТекЭлемент.ПолучитьЭлементы();
		Для Каждого ПодчиненыйЭлемент Из ПодчиненныеСтроки Цикл
			Если СокрЛП(ПодчиненыйЭлемент.Комната) = СокрЛП(Комната)
				и ПодчиненыйЭлемент.Номенклатура = Номенклатура
				//Добавлено услове по ед. измерения и характестики при добавлении по ШК
				И (?(Характеристика = Неопределено, Истина, ПодчиненыйЭлемент.ХарактеристикаНоменклатуры = Характеристика И ПодчиненыйЭлемент.ЕдиницаИзмерения = ЕдиницаИзмерения))
			Тогда
				Возврат ПодчиненыйЭлемент;
			КонецеСли;
		КонецЦикла;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

&НаКлиенте
Процедура ДобавитьПродукцию(Команда)
	
	ВМатериалы = (СтрНайти(Команда.Имя, "ВМатериалы") > 0);
	
	ТекущиеДанные = Элементы.ДеревоТоваров.ТекущиеДанные;	
	Если ВМатериалы Тогда
		ТекущиеДанные = Элементы.ДеревоМатериалов.ТекущиеДанные;
	КонецЕсли;
	
	Если НЕ ОбщийМодульКлиент.Розница_КомнатаЗаполнена(ТекущиеДанные) Тогда
		ПоказатьОповещениеПользователя("Выберите комнату");
		Возврат;
	КонецЕсли;	
		
	СтруктураПараметров = Новый Структура;	
	ОписаниеОповещения = Новый ОписаниеОповещения("ПослеВводаДанныхПродукцииПоВиду", ЭтотОбъект, ВМатериалы);
	ОткрытьФорму("ОбщаяФорма.ФормаДобавленияПродукцииПоВиду", СтруктураПараметров, ЭтотОбъект,,,, ОписаниеОповещения);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВводаДанныхПродукцииПоВиду(СтруктураОтвета, ДополнительныеПараметры) Экспорт
	
	Если СтруктураОтвета = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Модифицированность = Истина;
	
	ВМатериалы = ДополнительныеПараметры;
	ТекущиеДанные = Элементы.ДеревоТоваров.ТекущиеДанные;	
	Если ВМатериалы Тогда
		ТекущиеДанные = Элементы.ДеревоМатериалов.ТекущиеДанные;
	КонецЕсли;
	
	ТекущаяКомната = ТекущиеДанные.Комната;
	
	//++ №13814
	УИСтроки = Новый УникальныйИдентификатор;
	СтруктураОтвета.Вставить("УИСтроки", УИСтроки);
	ВидЗаказа = ПредопределенноеЗначение("Перечисление.ВидыЗаказов.ЗаказДоговор");
	//-- №13814
	
	Если НЕ ВМатериалы Тогда
		
		СтрокаКомнаты = ТекущиеДанные;
		Если НЕ ТекущиеДанные.ПолучитьРодителя() = Неопределено Тогда	
			СтрокаКомнаты = ТекущиеДанные.ПолучитьРодителя();
		КонецЕсли;
		
		ИдКомнаты = СтрокаКомнаты.ПолучитьИдентификатор();
	
		ДополнительныеПараметрыДобавления = Новый Структура("Комната, Количество", ТекущаяКомната, СтруктураОтвета.Количество);
		
		// №13814
		ОбщийМодульКлиент.РасширеннаяОбработкаДобавленнойПродукции(ЭтаФорма, ВидЗаказа, ВМатериалы, ТекущиеДанные.Комната, СтруктураОтвета, Истина);
		
		ПослеВыбораНоменклатуры(СтруктураОтвета, ИдКомнаты);
		
	Иначе		
		
		ДобавитьМатериалНаКлиенте(Новый Структура("Комната, Номенклатура, Количество", ТекущаяКомната, СтруктураОтвета.Номенклатура, СтруктураОтвета.Количество));
		
		// №13814
		ОбщийМодульКлиент.РасширеннаяОбработкаДобавленнойПродукции(ЭтаФорма, ВидЗаказа, ВМатериалы, ТекущиеДанные.Комната, СтруктураОтвета, Истина);
		
		ПеренестиДеревоВТабличнуюЧасть();			

		ОбновитьОтображениеЭлементовФормы();
		
	КонецЕсли;
	
КонецПроцедуры

