Функция ЗапретРедактированияЦен()
	Возврат ОбщийМодульСервер.НастройкаПользователя("ДополнительныеПраваЗапретРедактированияЦенВДокументах");	
КонецФункции

&НаКлиенте
Процедура ПослеВопросаОбИзмененииАвтоматическойСкидки(Результат, ТекущаяСтрока) Экспорт
    Если Результат = КодВозвратаДиалога.Нет Тогда
        ПослеИзмененияКоличестваТоваров(ТекущаяСтрока, Ложь);
	Иначе
		ПослеИзмененияКоличестваТоваров(ТекущаяСтрока, Истина);
    КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПослеИзмененияКоличестваТоваров(ТекущаяСтрока, Знач ПерезаполнитьСкидки = Истина)
	
	//проставим автоматическую скидку + скидку вида
	Если ПерезаполнитьСкидки Тогда
		ТекущаяСтрока.ПроцентСкидки = ПолучитьПроцентАвтоматическойСкидкиСервер(ИспользоватьАвтоматическиеСкидки, Объект.Дата, ТекущаяСтрока.Номенклатура, ТекущаяСтрока.Количество) + ПолучитьПроцентВидаСкидки(Объект.ВидСкидки);
	КонецЕсли;
	
	//Если мИспользоватьАвтоматическиеСкидки Тогда
	//	Если ИспользоватьАвтоматическиеСкидкиВРазрезеКомнат() Тогда 
	//		РассчитатьСуммуСтроки(Элементы.ДеревоТоваров.ТекущиеДанные);
	//	Иначе			
	//		РасчетПроцентаАвтоматическойСкидки(Элементы.ДеревоТоваров.ТекущиеДанные);
	//	КонецЕсли;		
	//Иначе
	РассчитатьСуммуСтроки(ТекущаяСтрока);
	//КонецЕсли;
	
	//ТекущаяСтрока.КоличествоВыработка = ПолучитьКоличествоВыработка(ТекущаяСтрока.Количество);

	РассчитатьИтоговыеПоказателиКлиент();
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоТоваровЦенаПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ДеревоТоваров.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если ТекущиеДанные.ПолучитьРодителя() = Неопределено Тогда
		ТекущиеДанные.Цена = 0;
		Возврат;
	КонецЕсли;

	ТекущиеДанные.Бесплатно = Ложь;

	РассчитатьСуммуСтроки(ТекущиеДанные);	
	РассчитатьИтоговыеПоказателиКлиент();
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоТоваровПроцентСкидкиПриИзменении(Элемент)
	//корневые строки редактировать нельзя
	Если Элементы.ДеревоТоваров.ТекущиеДанные.ПолучитьРодителя() = Неопределено Тогда
		Элементы.ДеревоТоваров.ТекущиеДанные.ПроцентСкидки = 0;
		Возврат;
	КонецЕсли;
	
	РассчитатьСуммуСтроки(Элементы.ДеревоТоваров.ТекущиеДанные);
	РассчитатьИтоговыеПоказателиКлиент();
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоТоваровСуммаПриИзменении(Элемент)
	
	СтрокаТабличнойЧасти = Элементы.ДеревоТоваров.ТекущиеДанные;	
	ОбщийМодульКлиент.Розница_ТоварыСуммаПриИзменении(ЭтотОбъект, СтрокаТабличнойЧасти);
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоТоваровСуммаСкидкиПриИзменении(Элемент)
	//корневые строки редактировать нельзя
	Если Элементы.ДеревоТоваров.ТекущиеДанные.ПолучитьРодителя() = Неопределено Тогда
		Элементы.ДеревоТоваров.ТекущиеДанные.СуммаСкидки = 0;
		Возврат;
	КонецЕсли;
	
	ТекущаяСтрока = Элементы.ДеревоТоваров.ТекущиеДанные;
	Если НЕ ТекущаяСтрока.СуммаСкидки = 0 Тогда
		Если НЕ ТекущаяСтрока.Количество = 0 и НЕ ТекущаяСтрока.Цена = 0 Тогда
			ТекущаяСтрока.ПроцентСкидки = Окр((ТекущаяСтрока.СуммаСкидки / (ТекущаяСтрока.Количество * ТекущаяСтрока.Цена)) * 100,2);
			РассчитатьСуммуСтроки(ТекущаяСтрока, Истина);
		Иначе
			ТекущаяСтрока.ПроцентСкидки = 100;
			РассчитатьСуммуСтроки(ТекущаяСтрока, Истина);
		КонецЕсли;
	Иначе 
		ТекущаяСтрока.ПроцентСкидки = 0;
		РассчитатьСуммуСтроки(ТекущаяСтрока, Истина);
	КонецЕсли;
	РассчитатьИтоговыеПоказателиКлиент();
	
КонецПроцедуры

&НаСервере
Функция ДобавитьПотолокНаСервере(ДопПараметры, Номенклатура = "", Количество, НомерПотолка = "", Фактура = "", Цвет = "", УИСтроки)
	
	Дерево = ДанныеФормыВЗначение(ДеревоТоваров, Тип("ДеревоЗначений"));
	Для Каждого Строка из Дерево.Строки Цикл
		Если Строка.Комната = ДопПараметры Тогда
			Стр = Строка.Строки.Добавить();
			Стр.Уровень = 1;
			
			//Если НЕ ПустаяСтрока(Номенклатура) Тогда
			Стр.Номенклатура = Номенклатура;
			//Иначе
			//	Стр.Номенклатура = Справочники.Номенклатура.Потолок;  // #12540 удалено
			//КонецЕсли;
			Стр.Комната = ДопПараметры;
			
			Стр.НомерПотолка = НомерПотолка;
			//Стр.НомерПотолка = Фактура;
			//Стр.ЦветФактуры = Цвет; //#12539
			
			СтруктураДанные = Новый Структура("Номенклатура, ВидСпецификации", Стр.Номенклатура, ВидСпецификацииПоУмолчанию);
			СтруктураДанные = ОбщийМодульВызовСервера.ПолучитьДанныеНоменклатурыПриИзменении(СтруктураДанные);	
			ЗаполнитьЗначенияСвойств(Стр, СтруктураДанные, "ЕдиницаИзмерения, Коэффициент, ВидНоменклатуры, УчитыватьКакПотолок");
			
			//Стр.ЕдиницаИзмерения = ПолучитьБазовуюЕдиницуИзмеренияНоменклатуры(Стр.Номенклатура);
			//Стр.Коэффициент = 1;
			//Если Справочники.ВидыНоменклатуры.ЭтоНоменклатураУслуга(Стр.Номенклатура) Тогда // #12667 спецификация только для услуг, в рамках той же заявки отменено
			Стр.Спецификация = ?(ЗаполнениеМатериаловПоЗаказам, СтруктураДанные.Спецификация, ПредопределенноеЗначение("Справочник.Спецификации.ПустаяСсылка"));
			//КонецЕсли;	
			Стр.Количество = Количество;
			Стр.Цена = ПолучитьЦенуНоменклатуры(Стр.Номенклатура, Стр.ХарактеристикаНоменклатуры, Стр.ЕдиницаИзмерения); //, Цвет.Владелец, Цвет);
			Стр.ПроцентСкидки = ПолучитьПроцентВидаСкидки(Объект.ВидСкидки);
			Стр.ЦенаПоПрайсу = Стр.Цена;
			Стр.СтавкаНДС = Объект.СтавкаНДС;
			РассчитатьСуммуСтрокиНаСервере(Стр);
			//Стр.КоличествоВыработка = ПолучитьКоличествоВыработка(Стр.Количество);
			Стр.УИСтроки = УИСтроки; //Новый УникальныйИдентификатор;
			//Стр.ВидНоменклатуры = Стр.Номенклатура.ВидНоменклатуры;
			
			ЗначениеВДанныеФормы(Дерево, ДеревоТоваров);
			Возврат Стр.Номенклатура;
		КонецЕсли
	КонецЦикла;
	
КонецФункции

&НаСервере
Функция НаименованиеПотолкаСодержитНомерДоговора()
	Если Константы.ПорядокФормированияНаименованияПотолкаРозницы.Получить() = 1 Тогда
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;
КонецФункции

&НаСервере
Функция ПолучитьКоличествоПотолковВДокументе()
	Результат = 0;
	Для Каждого ТекущаяСтрока Из Объект.ТоварыУслуги Цикл
		Если ТекущаяСтрока.Номенклатура.ВидНоменклатуры = Справочники.ВидыНоменклатуры.Потолок
			или ТекущаяСтрока.Номенклатура.ВидНоменклатуры = Справочники.ВидыНоменклатуры.Отрез Тогда
			Результат = Результат + 1;
		КонецЕсли;
	КонецЦикла;
	Для Каждого ТекущаяСтрока Из Объект.Материалы Цикл
		Если ТекущаяСтрока.Номенклатура.ВидНоменклатуры = Справочники.ВидыНоменклатуры.Потолок
			или ТекущаяСтрока.Номенклатура.ВидНоменклатуры = Справочники.ВидыНоменклатуры.Отрез Тогда
			Результат = Результат + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

&НаКлиенте
Процедура ДобавитьПотолок(Команда)
	
	ВМатериалы = (СтрНайти(Команда.Имя, "ВМатериалы") > 0);
	
	ТекущиеДанные = Элементы.ДеревоТоваров.ТекущиеДанные;	
	Если ВМатериалы Тогда
		ТекущиеДанные = Элементы.ДеревоМатериалов.ТекущиеДанные;
	КонецЕсли;
	
	Если НЕ ОбщийМодульКлиент.Розница_КомнатаЗаполнена(ТекущиеДанные) Тогда
		ПоказатьОповещениеПользователя("Выберите комнату");
		Возврат;
	КонецЕсли;
	
	НаименованиеПотолкаПоНомеруДоговора = НаименованиеПотолкаСодержитНомерДоговора();
	КоличествоПотолковВДокументе = 0;
	Если НаименованиеПотолкаПоНомеруДоговора Тогда
		Если ПустаяСтрока(Объект.НомерДоговора) Тогда
			ПоказатьПредупреждение(,"Не заполнен номер договора. Если номера договора присваиваются автоматически, вам следует сначала записать документ");
			Возврат;
		Иначе
			КоличествоПотолковВДокументе = ПолучитьКоличествоПотолковВДокументе();
		КонецЕсли;
	КонецЕсли;
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("ПоНомеруДоговора",НаименованиеПотолкаПоНомеруДоговора);
	СтруктураПараметров.Вставить("НомерДоговора",Объект.НомерДоговора);
	СтруктураПараметров.Вставить("КоличествоПотолковВДокументе",КоличествоПотолковВДокументе);
	
	Оповещение = Новый ОписаниеОповещения("ПослеВводаДанныхПотолка", ЭтотОбъект, ВМатериалы);
	ОткрытьФорму("ОбщаяФорма.ФормаДобавленияПродукции", СтруктураПараметров, ЭтотОбъект,, ВариантОткрытияОкна.ОтдельноеОкно,, Оповещение, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);	
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВводаДанныхПотолка(СтруктураОтвета, ДопПараметры) Экспорт
	
	Если НЕ СтруктураОтвета = Неопределено Тогда
		
		Модифицированность = Истина;
		
		ВМатериалы = ДопПараметры;
		ТекущиеДанные = Элементы.ДеревоТоваров.ТекущиеДанные;	
		Если ВМатериалы Тогда
			ТекущиеДанные = Элементы.ДеревоМатериалов.ТекущиеДанные;
		КонецЕсли;
		
		УИСтроки = Новый УникальныйИдентификатор;
		СтруктураОтвета.Вставить("УИСтроки", УИСтроки);
	    ВидЗаказа = ПредопределенноеЗначение("Перечисление.ВидыЗаказов.ЗаказДоговор");
		
		ТекущаяКомната = ТекущиеДанные.Комната;
		Если НЕ ВМатериалы Тогда			
			ДобавленнаяНоменклатура = ДобавитьПотолокНаСервере(Элементы.ДеревоТоваров.ТекущиеДанные.Комната, СтруктураОтвета.Номенклатура, СтруктураОтвета.Количество, СтруктураОтвета.НомерПотолка, СтруктураОтвета.Фактура, СтруктураОтвета.Цвет, УИСтроки);	
			//#11670
			ОбщийМодульКлиент.РасширеннаяОбработкаДобавленнойПродукции(ЭтаФорма, ВидЗаказа, ВМатериалы, ТекущиеДанные.Комната, СтруктураОтвета);
			
			ПеренестиДеревоВТабличнуюЧасть();			
			ЗаполнитьДанныеКОтгрузкеИОстаткиПоТоварам();
			РазвернутьДеревоТоваров(ТекущаяКомната, ДобавленнаяНоменклатура);
			ОбновитьОтображениеЭлементовФормы();
			РассчитатьИтоговыеПоказателиКлиент();
			ДобавленнаяСтрока = НайтиСтрокуДерева(ДеревоТоваров, ТекущаяКомната, ДобавленнаяНоменклатура);
			Если НЕ ДобавленнаяСтрока = Неопределено Тогда
				Элементы.ДеревоТоваров.ТекущаяСтрока = ДобавленнаяСтрока.ПолучитьИдентификатор();
			КонецЕсли;
		Иначе
			ДобавитьМатериалНаКлиенте(Новый Структура("Номенклатура, Комната", СтруктураОтвета.Номенклатура, ТекущаяКомната));
			//#11670
			ОбщийМодульКлиент.РасширеннаяОбработкаДобавленнойПродукции(ЭтаФорма, ВидЗаказа, ВМатериалы, ТекущиеДанные.Комната, СтруктураОтвета);
			ПеренестиДеревоВТабличнуюЧасть();			
			
			//РазвернутьДеревоМатериалов(ТекущаяКомната, СтруктураОтвета.Номенклатура);
			ОбновитьОтображениеЭлементовФормы();
