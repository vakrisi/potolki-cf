&НаКлиенте
Процедура ПослеВводаНовойСуммыДокумента(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	НоваяСуммаДокумента = Результат.НоваяСуммаДокумента; 
	СброситьРанееУстановленныеСкидки = Результат.СброситьРанееУстановленныеСкидки;
	ПрименятьСкидкуНаПотолки = Результат.ПрименятьСкидкуНаПотолки;	
	ПрименятьСкидкуНаТовары = Результат.ПрименятьСкидкуНаТовары;	
	ПрименятьСкидкуНаУслуги = Результат.ПрименятьСкидкуНаУслуги;	
	
	Если НоваяСуммаДокумента = Объект.СуммаДокумента Тогда
		Возврат;
	КонецЕсли;
			
	//ТекущаяКомната = Элементы.ДеревоТоваров.ТекущиеДанные.Комната;
	//ТекущаяНоменклатура = Элементы.ДеревоТоваров.ТекущиеДанные.Номенклатура;	
	ТекущаяКомната = Неопределено;
	ТекущаяНоменклатура = Неопределено;	
	ТекущиеДанные = Элементы.ДеревоТоваров.ТекущиеДанные;
	Если НЕ ТекущиеДанные = Неопределено Тогда			
		ТекущаяКомната 		= ТекущиеДанные.Комната;
		ТекущаяНоменклатура = ТекущиеДанные.Номенклатура;
	КонецЕсли;
	
	ПослеВводаНовойСуммыДокументаНаСервере(НоваяСуммаДокумента, СброситьРанееУстановленныеСкидки, ПрименятьСкидкуНаПотолки, ПрименятьСкидкуНаТовары, ПрименятьСкидкуНаУслуги);
	ПеренестиДеревоВТабличнуюЧасть();
	ПоказатьОповещениеПользователя("Сумма документа изменена");
			
	ОбновитьОтображениеЭлементовФормы(ТекущаяКомната, ТекущаяНоменклатура);
	РассчитатьИтоговыеПоказателиКлиент();
	
КонецПроцедуры

&НаСервере
Процедура ПослеВводаНовойСуммыДокументаНаСервере(НоваяСуммаДокумента, СброситьСкидки, СкидкаПотолки, СкидкаТовары, СкидкаУслуги)
	
	Если СброситьСкидки Тогда
		Дерево = ДанныеФормыВЗначение(ДеревоТоваров, Тип("ДеревоЗначений"));
		
		СтрокаСНаибольшейСуммой = Неопределено;
		НаибольшаяСумма = 0;
		СуммаДокументаПослеИзменения = 0;
		
		//сначала переопределим скидку по шапке документа
		СуммаДокумента = 0;
		СуммаДокументаПоСкидочнымПозициям = 0;
		
		Для Каждого Строка из Дерево.Строки Цикл
			Для Каждого СтрНоменклатура из Строка.Строки Цикл
				СтрНоменклатура.ПроцентСкидки = ПолучитьПроцентВидаСкидки(Объект.ВидСкидки);
				РассчитатьСуммуСтрокиНаСервере(СтрНоменклатура);
				//РассчитатьСуммуНДСТабЧастиНаСервере(СтрНоменклатура);
				ОбработкаТабличныхЧастейКлиентСервер.ПересчитатьСуммуНДСВСтрокеТЧ(СтрНоменклатура, УчитыватьНДС);
				
				СуммаДокумента = СуммаДокумента + СтрНоменклатура.Сумма;
				
				Если (СкидкаПотолки И СтрНоменклатура.ВидНоменклатуры = ПредопределенноеЗначение("Справочник.ВидыНоменклатуры.Потолок"))
					ИЛИ (СкидкаПотолки И СтрНоменклатура.ВидНоменклатуры = ПредопределенноеЗначение("Справочник.ВидыНоменклатуры.Отрез"))
					ИЛИ (СкидкаТовары И СтрНоменклатура.ВидНоменклатуры = ПредопределенноеЗначение("Справочник.ВидыНоменклатуры.Материал"))	
					ИЛИ (СкидкаУслуги И СтрНоменклатура.ВидНоменклатуры = ПредопределенноеЗначение("Справочник.ВидыНоменклатуры.Услуга")) Тогда
					СуммаДокументаПоСкидочнымПозициям = СуммаДокументаПоСкидочнымПозициям + СтрНоменклатура.Сумма;
				КонецЕсли;
								
			КонецЦикла;	
		КонецЦикла;
		
		СуммаДокументаДоИзменения = СуммаДокумента;
		Разница = СуммаДокументаДоИзменения - НоваяСуммаДокумента;
		
		Если СуммаДокументаПоСкидочнымПозициям = 0 Тогда
			Сообщить("В данном документе отсутствуют позиции выбранного вида. Изменение суммы документа отменено");
			Возврат;
		КонецЕсли;	
		
		Если СуммаДокументаПоСкидочнымПозициям < Разница Тогда
			Сообщить("Объем скидки больше суммы товаров и услуг по выбранным категориям");
			СуммаДокументаПоСкидочнымПозициям = 0;
		КонецЕсли;	
		
		//изменим скидки
		Если НЕ СуммаДокументаПоСкидочнымПозициям = 0 Тогда 
			КоэффициентИзменения = Разница / СуммаДокументаПоСкидочнымПозициям;
			Для Каждого ТекущаяКомната Из Дерево.Строки Цикл
				Для Каждого ТекущийТовар Из ТекущаяКомната.Строки Цикл
					
					Если (СкидкаПотолки И ТекущийТовар.ВидНоменклатуры = ПредопределенноеЗначение("Справочник.ВидыНоменклатуры.Потолок"))
					 ИЛИ (СкидкаПотолки И ТекущийТовар.ВидНоменклатуры = ПредопределенноеЗначение("Справочник.ВидыНоменклатуры.Отрез"))	
					 ИЛИ (СкидкаТовары И ТекущийТовар.ВидНоменклатуры = ПредопределенноеЗначение("Справочник.ВидыНоменклатуры.Материал"))	
					 ИЛИ (СкидкаУслуги И ТекущийТовар.ВидНоменклатуры = ПредопределенноеЗначение("Справочник.ВидыНоменклатуры.Услуга")) Тогда
						Если ТекущийТовар.Сумма >= НаибольшаяСумма Тогда
							НаибольшаяСумма = ТекущийТовар.Сумма;
							СтрокаСНаибольшейСуммой = ТекущийТовар;
						КонецЕсли;
						ТекущийТовар.ПроцентСкидки = ТекущийТовар.ПроцентСкидки + (КоэффициентИзменения*100);
						РассчитатьСуммуСтрокиНаСервере(ТекущийТовар);
						//РассчитатьСуммуНДСТабЧастиНаСервере(ТекущийТовар);
						ОбработкаТабличныхЧастейКлиентСервер.ПересчитатьСуммуНДСВСтрокеТЧ(ТекущийТовар, УчитыватьНДС);
						СуммаДокументаПослеИзменения = СуммаДокументаПослеИзменения + ТекущийТовар.Сумма;
					Иначе
						РассчитатьСуммуСтрокиНаСервере(ТекущийТовар);
						ОбработкаТабличныхЧастейКлиентСервер.ПересчитатьСуммуНДСВСтрокеТЧ(ТекущийТовар, УчитыватьНДС);
						СуммаДокументаПослеИзменения = СуммаДокументаПослеИзменения + ТекущийТовар.Сумма;
					КонецЕсли;
					
				КонецЦикла;
			КонецЦикла;
			
			//пересчитаем строку с наибольшей суммой, если после пересчета по строкам итог не сошелся с желаемым
			Если НЕ СуммаДокументаПослеИзменения = НоваяСуммаДокумента Тогда
				Если НЕ СтрокаСНаибольшейСуммой = Неопределено Тогда
					Разница = НоваяСуммаДокумента - СуммаДокументаПослеИзменения;
					СтрокаСНаибольшейСуммой.Сумма = СтрокаСНаибольшейСуммой.Сумма + Разница;
					//СуммаБезРучнойСкидки = СтрокаСНаибольшейСуммой.Цена * СтрокаСНаибольшейСуммой.Количество - (СтрокаСНаибольшейСуммой.Цена * СтрокаСНаибольшейСуммой.Количество * (СтрокаСНаибольшейСуммой.ПроцентАвтоматическойСкидки/100));
					СуммаБезРучнойСкидки = СтрокаСНаибольшейСуммой.Цена * СтрокаСНаибольшейСуммой.Количество;
					Если НЕ СуммаБезРучнойСкидки = 0 Тогда
						СтрокаСНаибольшейСуммой.ПроцентСкидки = 100 - (СтрокаСНаибольшейСуммой.Сумма / СуммаБезРучнойСкидки)*100;
						СтрокаСНаибольшейСуммой.СуммаСкидки = СуммаБезРучнойСкидки * СтрокаСНаибольшейСуммой.ПроцентСкидки / 100;
					КонецЕсли;
					//РассчитатьСуммуНДСТабЧастиНаСервере(СтрокаСНаибольшейСуммой);
					ОбработкаТабличныхЧастейКлиентСервер.ПересчитатьСуммуНДСВСтрокеТЧ(СтрокаСНаибольшейСуммой, УчитыватьНДС);
				КонецЕсли;
			КонецЕсли;
			
			ЗначениеВДанныеФормы(Дерево, ДеревоТоваров);
			Модифицированность = Истина;
		КонецЕсли;
		
	Иначе
		//#5374
		Дерево = ДанныеФормыВЗначение(ДеревоТоваров, Тип("ДеревоЗначений"));
				
		//определим сумму строк, участвующих в пересчете
		// Скидку 100% и выше не увеличивать.
		СуммаДокументаПоСкидочнымПозициям = 0;
		СуммаКРаспределению = НоваяСуммаДокумента; // в этой переменной учтем новую сумму документа с учетом строк, не участвующих в изменении
		СуммаДокумента = 0;
		КоличествоИзменяемыхСтрок = 0 ;
		КоличествоИзменяемыхСтрокПоКатегориям = 0 ;
		Для Каждого Строка из Дерево.Строки Цикл
			Для Каждого СтрНоменклатура из Строка.Строки Цикл
				
				Если СтрНоменклатура.ПроцентСкидки >= 100 ИЛИ НЕ ((СкидкаПотолки И СтрНоменклатура.ВидНоменклатуры = ПредопределенноеЗначение("Справочник.ВидыНоменклатуры.Потолок"))
					ИЛИ (СкидкаПотолки И СтрНоменклатура.ВидНоменклатуры = ПредопределенноеЗначение("Справочник.ВидыНоменклатуры.Отрез"))
					ИЛИ (СкидкаТовары И СтрНоменклатура.ВидНоменклатуры = ПредопределенноеЗначение("Справочник.ВидыНоменклатуры.Материал"))	
					ИЛИ (СкидкаУслуги И СтрНоменклатура.ВидНоменклатуры = ПредопределенноеЗначение("Справочник.ВидыНоменклатуры.Услуга"))) Тогда
					СуммаКРаспределению  = СуммаКРаспределению - СтрНоменклатура.Сумма;
				Иначе
					КоличествоИзменяемыхСтрок = КоличествоИзменяемыхСтрок + 1;
				КонецЕсли;
				
				Если ((СкидкаПотолки И СтрНоменклатура.ВидНоменклатуры = ПредопределенноеЗначение("Справочник.ВидыНоменклатуры.Потолок"))
					ИЛИ (СкидкаПотолки И СтрНоменклатура.ВидНоменклатуры = ПредопределенноеЗначение("Справочник.ВидыНоменклатуры.Отрез"))
					ИЛИ (СкидкаТовары И СтрНоменклатура.ВидНоменклатуры = ПредопределенноеЗначение("Справочник.ВидыНоменклатуры.Материал"))	
					ИЛИ (СкидкаУслуги И СтрНоменклатура.ВидНоменклатуры = ПредопределенноеЗначение("Справочник.ВидыНоменклатуры.Услуга"))) Тогда
					КоличествоИзменяемыхСтрокПоКатегориям = КоличествоИзменяемыхСтрокПоКатегориям + 1;
				КонецЕсли;
				
				СуммаДокумента = СуммаДокумента + СтрНоменклатура.Сумма;
				
			КонецЦикла;	
		КонецЦикла;
		СуммаПропорции = СуммаДокумента - (НоваяСуммаДокумента - СуммаКРаспределению); // сумма старых строк, участвующих в изменении
		Если КоличествоИзменяемыхСтрок = 0 Тогда
			Если КоличествоИзменяемыхСтрокПоКатегориям = 0 Тогда
				Сообщить("В данном документе отсутствуют позиции выбранного вида. Изменение суммы документа отменено");
			Иначе
				Сообщить("Во всех строках выбранных категорий указаны скидки более 100%, изменение не выполнено");
			КонецЕсли;
			Возврат;
		КонецЕсли;
		
		ПозицияИзменяемойСтроки = 1;
		КоэффициентИзменения = СуммаКРаспределению / СуммаПропорции;
		Для Каждого Строка из Дерево.Строки Цикл
			Для Каждого СтрНоменклатура из Строка.Строки Цикл
				
				Если СтрНоменклатура.ПроцентСкидки >= 100 ИЛИ НЕ ((СкидкаПотолки И СтрНоменклатура.ВидНоменклатуры = ПредопределенноеЗначение("Справочник.ВидыНоменклатуры.Потолок"))
					ИЛИ (СкидкаПотолки И СтрНоменклатура.ВидНоменклатуры = ПредопределенноеЗначение("Справочник.ВидыНоменклатуры.Отрез"))
					ИЛИ (СкидкаТовары И СтрНоменклатура.ВидНоменклатуры = ПредопределенноеЗначение("Справочник.ВидыНоменклатуры.Материал"))	
					ИЛИ (СкидкаУслуги И СтрНоменклатура.ВидНоменклатуры = ПредопределенноеЗначение("Справочник.ВидыНоменклатуры.Услуга"))) Тогда
						// ничего не делаем
					Иначе
						Если ПозицияИзменяемойСтроки = КоличествоИзменяемыхСтрок Тогда  // исправить ошибку в сумме распределения
							СтрНоменклатура.Сумма = СуммаКРаспределению;
						Иначе
							СтрНоменклатура.Сумма = СтрНоменклатура.Сумма * КоэффициентИзменения;
						КонецЕсли;
						СтрНоменклатура.СуммаСкидки = СтрНоменклатура.Цена * СтрНоменклатура.Количество - СтрНоменклатура.Сумма;
						ОбработкаТабличныхЧастейКлиентСервер.ПересчитатьПроцентРучнойСкидкиВСтрокеТЧ(СтрНоменклатура, "ПроцентСкидки", "СуммаСкидки");
						ОбработкаТабличныхЧастейКлиентСервер.ПересчитатьСуммуНДСВСтрокеТЧ(СтрНоменклатура, УчитыватьНДС);
						ПозицияИзменяемойСтроки = ПозицияИзменяемойСтроки + 1;					
						СуммаКРаспределению = СуммаКРаспределению - СтрНоменклатура.Сумма;				
					КонецЕсли;
				
			КонецЦикла;	
		КонецЦикла;
		
		ЗначениеВДанныеФормы(Дерево, ДеревоТоваров);
		Модифицированность = Истина;
		
	КонецЕсли;
	
КонецПроцедуры

