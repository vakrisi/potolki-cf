//++ №9868
&НаСервере
Процедура ЗаполнитьСсылкиНаМонтажи()
	
	Монтажи.Очистить();
	
	Если Объект.Ссылка.Пустая() Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ДокументМонтаж.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.Монтаж КАК ДокументМонтаж
	|ГДЕ
	|	ДокументМонтаж.Основание = &ЗаказДоговор
	|	И НЕ ДокументМонтаж.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДокументМонтаж.ДатаМонтажа";
	Запрос.УстановитьПараметр("ЗаказДоговор", Объект.Ссылка);
	
	Монтажи.ЗагрузитьЗначения(Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка"));
	
	// Если монтажей нет, выводим декорацию
	Элементы.ДекорацияМонтажиНеНазначены.Видимость = (Монтажи.Количество() = 0);
	
	// Существующие элементы декорации скроем (если они есть уже)
	Для Каждого ТекущаяСтрока Из Элементы.ГруппаСсылкиНаМонтажи.ПодчиненныеЭлементы Цикл
		
		Если СтрНайти(ТекущаяСтрока.Имя, "ДекорацияСсылкаНаМонтажНомер") > 0 Тогда
			ТекущаяСтрока.Видимость = Ложь;
		КонецЕсли;
		
	КонецЦикла;
	
	// Прорисуем элементы формы
	Сч = 0;
	УстановитьПривилегированныйРежим(Истина);
	Для Каждого ТекущаяСтрока Из Монтажи Цикл
		
		ИмяЭлемента = "ДекорацияСсылкаНаМонтажНомер_" + Сч;
		
		Если Элементы.Найти(ИмяЭлемента) = Неопределено Тогда
			НовыйЭлемент = Элементы.Вставить(ИмяЭлемента, Тип("ДекорацияФормы"), Элементы.ГруппаСсылкиНаМонтажи);
		Иначе
			НовыйЭлемент = Элементы[ИмяЭлемента];
		КонецЕсли;
		
		МонтажСсылка = ТекущаяСтрока.Значение;
		
		ДатаЗаголовка = "";
		
		//++ №12721
		МонтажПродажа = (МонтажСсылка.ВидОперации = Справочники.ВидыМонтажа.Продажа);
		
		Если МонтажСсылка.ВидОперации = Справочники.ВидыМонтажа.Продажа Тогда
			ДатаЗаголовка = Формат(МонтажСсылка.Дата, "ДФ=dd.MM.yyyy");
		//-- №12721
		ИначеЕсли МонтажСсылка.СрокМонтажа = Перечисления.СрокиМонтажа.ДатаМонтажаНеОпределена Тогда
			ДатаЗаголовка = "(дата не определена)"; // №11843 было: "(по звонку)";
		Иначе
			ДатаЗаголовка = Формат(МонтажСсылка.ДатаМонтажа, "ДФ=dd.MM.yyyy");
		КонецЕсли;
		
		НовыйЭлемент.Видимость = Истина;
		НовыйЭлемент.Заголовок = ?(МонтажПродажа, "Продажа от ", "Монтаж на ") + ДатаЗаголовка;
		НовыйЭлемент.Гиперссылка = Истина;
		
		НовыйЭлемент.УстановитьДействие("Нажатие", "ДекорацияСсылкаНаМонтажНажатие");
		
		Сч = Сч + 1;
		
	КонецЦикла;
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура ДекорацияСсылкаНаМонтажНажатие(Элемент)
	
	// в названии элемента нужно найти номер в списке монтажей
	Позиция = СтрНайти(Элемент.Имя, "Номер_");
	
	Если Позиция = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		НомерСтроки = Число(Сред(Элемент.Имя, Позиция + 6));
	Исключение
		Возврат;
	КонецПопытки;
	
	Если НомерСтроки <= Монтажи.Количество()-1 Тогда
		
		СсылкаНаМонтаж = Монтажи.Получить(НомерСтроки);
		ОткрытьФорму("Документ.Монтаж.ФормаОбъекта", новый Структура("Ключ", СсылкаНаМонтаж.Значение));
		
	КонецЕсли;
	
КонецПроцедуры

