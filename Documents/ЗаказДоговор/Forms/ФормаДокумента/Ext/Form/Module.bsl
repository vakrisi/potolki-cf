&НаСервере
Процедура ДобавитьЗаписьВИсториюСервер(Знач ТекстЗаписиИстории, ДатаСледующегоКонтакта, ИзменениеДатыСледующегоКонтакта = Ложь)
	
	ТекущаяДата = ТекущаяДатаСеанса();
	Объект.ПоследнийКомментарий = ТекстЗаписиИстории;	
	Если ИзменениеДатыСледующегоКонтакта Тогда			
		Объект.ПоследняяДатаКонтакта           = ТекущаяДата;	
		Объект.ПоследняяДатаСледующегоКонтакта = ДатаСледующегоКонтакта;
		Если ЗначениеЗаполнено(ДатаСледующегоКонтакта) Тогда			
			ТекстЗаписиИстории = СтрШаблон("Указана дата следующего контакта: %1. Комментарий: %2", 
											Формат(ДатаСледующегоКонтакта, "ДФ='dd.MM.yyyy HH:mm'"),
											ТекстЗаписиИстории);
		КонецЕсли;
	КонецЕсли;

	РегистрыСведений.ИсторияЗаказа.ДобавитьЗаписьВИсторию(Объект.Ссылка, ТекущаяДата, Пользователи.ТекущийПользователь(), ТекстЗаписиИстории, , ДатаСледующегоКонтакта);
	
