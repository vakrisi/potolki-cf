&НаКлиенте
Процедура СкопироватьВДругуюКомнату(Команда)
		
	ВыделенныеСтроки = Элементы.ДеревоТоваров.ВыделенныеСтроки;
	Если ВыделенныеСтроки.Количество() = 0 Тогда
		ПоказатьПредупреждение(, "Выберите товар или услугу комнаты, который нужно скопировать");
		Возврат;
	КонецЕсли;
	
	Для каждого ТекущаяСтрока из ВыделенныеСтроки Цикл
		СтрокаТЧ = ДеревоТоваров.НайтиПоИдентификатору(ТекущаяСтрока);
		
		Если СтрокаТЧ.Номенклатура.Пустая() Тогда
			ПоказатьПредупреждение(,"Выберите товар или услугу комнаты, который нужно скопировать");
			Возврат;
		КонецЕсли;
	
		ДанныеНоменклатуры = ПолучитьДанныеНоменклатуры(СтрокаТЧ.Номенклатура);
		Если ДанныеНоменклатуры.ЭтоУникальныйПотолок Тогда
			ПоказатьПредупреждение(,"Копирование потолков запрещено!");
			Возврат;
		КонецЕсли;
	КонецЦикла;	
	
	СписокКомнат = ОбщийМодульКлиент.ПолучитьСписокКомнатПоДереву(ДеревоТоваров);	
	ДопПараметры = Новый Структура;
	
	СкопироватьВДругуюКомнатуПодтверждение = Новый ОписаниеОповещения("СкопироватьВДругуюКомнатуПодтверждение", ЭтаФорма, ДопПараметры);
	СписокКомнат.ПоказатьВыборЭлемента(СкопироватьВДругуюКомнатуПодтверждение, "Выберите комнату");
	
КонецПроцедуры

&НаКлиенте
Процедура СкопироватьВДругуюКомнатуПодтверждение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИмяКомнаты = Результат.Значение;
	Если ИмяКомнаты = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	НоваяСтрока = Неопределено;
	ЭлементыДерева = ДеревоТоваров.ПолучитьЭлементы();
	Для Каждого ТекЭлемент из ЭлементыДерева Цикл
		Если СокрЛП(ТекЭлемент.Комната) = СокрЛП(ИмяКомнаты) Тогда			
			ВыделенныеСтроки = Элементы.ДеревоТоваров.ВыделенныеСтроки;	
			Для каждого ТекущаяСтрока из ВыделенныеСтроки Цикл
				СтрокаТЧ = ДеревоТоваров.НайтиПоИдентификатору(ТекущаяСтрока);
				
				НоваяСтрока = ТекЭлемент.ПолучитьЭлементы().Добавить();
				//ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТЧ, , "Комната, Спецификация, УИСтроки");
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТЧ, , "Комната, УИСтроки, МонтажСтатус, Монтаж, КоличествоВМонтажах, Заказано");
				НоваяСтрока.Комната = ИмяКомнаты;
				НоваяСтрока.УИСтроки = Новый УникальныйИдентификатор;
				
				Если Объект.ЗаполнятьУИСтрок И НЕ НоваяСтрока.Спецификация.Пустая() И ЗаполнениеМатериаловПоЗаказам Тогда
					ПерезаполнитьМатериалыПоСпецификации(НоваяСтрока, , "ДобавлениеНоменклатуры");
				КонецЕсли;
			КонецЦикла;
			
			// на случай, если в комнате не было позиций
			ИдентификаторСтроки = ТекЭлемент.ПолучитьИдентификатор();
			Элементы.ДеревоТоваров.Развернуть(ИдентификаторСтроки);
			
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	РассчитатьИтоговыеПоказателиКлиент();
	//ПеренестиДеревоВТабличнуюЧасть();
	
	//Если НоваяСтрока = Неопределено Тогда
	//	Возврат;
	//КонецЕсли;
	//
	//Если Объект.ЗаполнятьУИСтрок И НЕ НоваяСтрока.Спецификация.Пустая() И ЗаполнениеМатериаловПоЗаказам Тогда
	//	ПерезаполнитьМатериалыПоСпецификации(НоваяСтрока, , "ДобавлениеНоменклатуры");
	//КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СкопироватьМатериалыВДругуюКомнату(Команда)
		
	ВыделенныеСтроки = Элементы.ДеревоМатериалов.ВыделенныеСтроки;
	Если ВыделенныеСтроки.Количество() = 0 Тогда
		ПоказатьПредупреждение(, "Выберите материалы, которые нужно скопировать");
		Возврат;
	КонецЕсли;
	
	Для каждого ТекущаяСтрока из ВыделенныеСтроки Цикл
		СтрокаТЧ = ДеревоМатериалов.НайтиПоИдентификатору(ТекущаяСтрока);
		
		Если СтрокаТЧ.Номенклатура.Пустая() Тогда
			ПоказатьПредупреждение(,"Выберите материалы, которые нужно скопировать");
			Возврат;
		КонецЕсли;
	
		ДанныеНоменклатуры = ПолучитьДанныеНоменклатуры(СтрокаТЧ.Номенклатура);
		Если ДанныеНоменклатуры.ЭтоУникальныйПотолок Тогда
			ПоказатьПредупреждение(,"Копирование потолков запрещено!");
			Возврат;
		КонецЕсли;
	КонецЦикла;	
	
	СписокКомнат = ОбщийМодульКлиент.ПолучитьСписокКомнатПоДереву(ДеревоТоваров);	
	ДопПараметры = Новый Структура;
	
	СкопироватьВДругуюКомнатуПодтверждение = Новый ОписаниеОповещения("СкопироватьМатериалыВДругуюКомнатуПодтверждение", ЭтаФорма, ДопПараметры);
	СписокКомнат.ПоказатьВыборЭлемента(СкопироватьВДругуюКомнатуПодтверждение, "Выберите комнату");
	
КонецПроцедуры

&НаКлиенте
Процедура СкопироватьМатериалыВДругуюКомнатуПодтверждение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
