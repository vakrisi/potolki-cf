	Для Каждого Потолок Из Врем_Потолки Цикл
		ОписаниеОшибки = "";
		Документы.ЗаказДоговор.СоздатьНоменклатуруПоФайлуНаСервере(Объект, Потолок.Номенклатура,, Потолок.Комната, УчитыватьНДС, , ОписаниеОшибки);
		Если ЗначениеЗаполнено(ОписаниеОшибки) Тогда
			Сообщить(ОписаниеОшибки);
		КонецЕсли;
	КонецЦикла;				
	
	//Переоценим товары не относящиеся к потолкам
	Для Каждого ТекущаяСтрока Из Объект.ТоварыУслуги Цикл
		Если ТекущаяСтрока.Бесплатно Тогда
			Продолжить;
		КонецЕсли;
		//++#6986
		// цена на простые потолки
		Если (ЗначениеЗаполнено(ТекущаяСтрока.НомерПотолка) 
			И Справочники.ВидыНоменклатуры.ЭтоНоменклатураУникальногоПотолкаИлиОтреза(ТекущаяСтрока.Номенклатура) 
			И НЕ ТекущаяСтрока.ЗагруженоИзПостроителя)		
		//--#6986
			ИЛИ НЕ ЗначениеЗаполнено(ТекущаяСтрока.НомерПотолка) Тогда
			ТекущаяСтрока.Цена = ПолучитьЦенуНоменклатуры(ТекущаяСтрока.Номенклатура, ТекущаяСтрока.ХарактеристикаНоменклатуры, ТекущаяСтрока.ЕдиницаИзмерения);
			ТекущаяСтрока.ЦенаПоПрайсу = ТекущаяСтрока.Цена;
			РассчитатьСуммуСтрокиНаСервере(ТекущаяСтрока);
		КонецЕсли;
	КонецЦикла;
	
	ПерестроитьДеревоНаФорме();	
	//Конец изменен при переходе на 2.0
КонецФункции

&НаКлиенте
Процедура ТоварыУслугиСуммаСкидкиПриИзменении(Элемент)
	
	ТекущаяСтрока = Элементы.ТоварыУслуги.ТекущиеДанные;
	Если НЕ ТекущаяСтрока.СуммаСкидки = 0 Тогда
		Если НЕ ТекущаяСтрока.Количество = 0 и НЕ ТекущаяСтрока.Цена = 0 Тогда
			ТекущаяСтрока.ПроцентСкидки = Окр((ТекущаяСтрока.СуммаСкидки / (ТекущаяСтрока.Количество * ТекущаяСтрока.Цена)) * 100,2);
			РассчитатьСуммуСтроки(ТекущаяСтрока);
		Иначе
			ТекущаяСтрока.ПроцентСкидки = 100;
			РассчитатьСуммуСтроки(ТекущаяСтрока);
		КонецЕсли;
	Иначе 
		ТекущаяСтрока.ПроцентСкидки = 0;
		РассчитатьСуммуСтроки(ТекущаяСтрока);
	КонецЕсли;
	РассчитатьИтоговыеПоказателиКлиент();
	
КонецПроцедуры

