&НаСервере
Процедура ПерестроитьДеревоНаФорме()
	//ТОВАРЫ И УСЛУГИ
	//ключ строки дерева: комната
	
	//#5010 добавляем все комнаты из товаров и материалов
	ТЗКомнаты = Объект.ТоварыУслуги.Выгрузить(, "Комната");
	Для Каждого Стр из Объект.Материалы Цикл
		НоваяСтрока = ТЗКомнаты.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Стр);
	КонецЦикла;
	ТЗКомнаты.Свернуть("Комната");
	// сортировку не делаем, при наличии комнат более 10 будет сортировка по строкам, а не по числам, что приведет к "проблеме"
		
	Комната = "";
	Дерево = ДанныеФормыВЗначение(ДеревоТоваров, Тип("ДеревоЗначений"));
	Дерево.Строки.Очистить();
	
	Для каждого СтрокаКомнаты из ТЗКомнаты Цикл
		СтрДерево = Дерево.Строки.Добавить();
		СтрДерево.Комната = СтрокаКомнаты.Комната;
		Комната = СтрокаКомнаты.Комната;
	КонецЦикла;
	
	КоличествоСтрокТоваров = 0;
	Для Каждого Стр из Объект.ТоварыУслуги Цикл
		//Если Стр.Комната <> Комната Тогда
		//	СтрДерево = Дерево.Строки.Добавить();
		//	СтрДерево.Комната = Стр.Комната;
		//	Комната = Стр.Комната;
		//КонецЕсли;
		СтрДерево = Дерево.Строки.Найти(Стр.Комната, "Комната");
		Если НЕ Стр.Номенклатура.Пустая() Тогда
			СтрДеревоВид = СтрДерево.Строки.Добавить();
			СтрДеревоВид.Уровень = 1;
			ЗаполнитьЗначенияСвойств(СтрДеревоВид, Стр);
			Если Стр.Номенклатура.ВидНоменклатуры = Справочники.ВидыНоменклатуры.Потолок Тогда
				//НАЧАЛО Переход на 2.0 R2
				//СтрДеревоВид.СтатусПроизводства = ПолучитьСтатусПроизводства(Стр.Номенклатура, Стр.ЗаказНаПроизводство);
				СтрДеревоВид.СтатусПроизводства = ПолучитьСтатусПроизводства(Стр.Номенклатура);
				//КОНЕЦ  Переход на 2.0 R2
			КонецЕсли;
			СтрДеревоВид.ВидНоменклатуры = Стр.Номенклатура.ВидНоменклатуры;
			СтрДеревоВид.УчитыватьКакПотолок = Стр.Номенклатура.УчитыватьКакПотолокВОтчетахПоЭффективности; // №14690;
			Если ПустаяСтрока(Стр.УИСтроки) Тогда
				//по какой-то причине УИ пустой - заполним
				Стр.УИСтроки = Новый УникальныйИдентификатор;
				СтрДерево.УИСтроки = Стр.УИСтроки;
			КонецЕсли;
			КоличествоСтрокТоваров = КоличествоСтрокТоваров + 1;
		КонецЕсли;
	КонецЦикла;
	ЗначениеВДанныеФормы(Дерево, ДеревоТоваров);
	
	//МАТЕРИАЛЫ
	
	
	ДеревоТ = Дерево;	
	Комната = "";
	Дерево = ДанныеФормыВЗначение(ДеревоМатериалов, Тип("ДеревоЗначений"));
	Дерево.Строки.Очистить();
	
	//принудительно добавим все комнаты из дерева товаров - замена процедуре ПроверитьОтсутствиеКомнатВМатериалах
	Для Каждого СтрТовары Из ДеревоТ.Строки Цикл
		Нашли=Ложь;
		Для Каждого СтрМатериалы Из Дерево.Строки Цикл
			Если СтрТовары.Комната = СтрМатериалы.Комната Тогда
				Нашли = Истина;
			КонецЕсли;
		КонецЦикла;
		Если НЕ Нашли Тогда
			СтрДерево = Дерево.Строки.Добавить();
			СтрДерево.Комната = СтрТовары.Комната;
		КонецЕсли;
	КонецЦикла;
	
	КоличествоСтрокМатериалов = 0;

	Для Каждого Стр из Объект.Материалы Цикл
		СтрДерево = Дерево.Строки.Найти(Стр.Комната, "Комната");
		Если СтрДерево = Неопределено Тогда
			СтрДерево = Дерево.Строки.Добавить();
			СтрДерево.Комната = Стр.Комната;
			Комната = Стр.Комната;
		КонецЕсли;
		
		Если НЕ Стр.Номенклатура.Пустая() Тогда
			СтрДеревоВид = СтрДерево.Строки.Добавить();
			СтрДеревоВид.Уровень = 1;
			ЗаполнитьЗначенияСвойств(СтрДеревоВид, Стр);			
			Если ПустаяСтрока(Стр.УИСтроки) Тогда
				//по какой-то причине УИ пустой - заполним
				Стр.УИСтроки = Новый УникальныйИдентификатор;
				СтрДерево.УИСтроки = Стр.УИСтроки;
			КонецЕсли;
			КоличествоСтрокМатериалов = КоличествоСтрокМатериалов + 1;
		КонецЕсли;
	КонецЦикла;
	ЗначениеВДанныеФормы(Дерево, ДеревоМатериалов);
	
КонецПроцедуры

