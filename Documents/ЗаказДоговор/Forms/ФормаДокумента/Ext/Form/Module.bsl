&НаСервере
Процедура Был_ЗаполнитьПустыеУИСДерева(ДеревоНоменклатуры)
	Если Объект.ЗаполнятьУИСтрок Тогда
		ЭлементыДерева = ДеревоНоменклатуры.ПолучитьЭлементы();
		Для Каждого ТекЭлемент из ЭлементыДерева Цикл
			ПодчиненныеСтроки = ТекЭлемент.ПолучитьЭлементы();
			Для Каждого ПодчиненыйЭлемент Из ПодчиненныеСтроки Цикл			
				Если НЕ ПодчиненыйЭлемент.Номенклатура.Пустая() И ПустаяСтрока(ПодчиненыйЭлемент.УИСтроки) Тогда
					//по какой-то причине УИ пустой - заполним
					ПодчиненыйЭлемент.УИСтроки = Новый УникальныйИдентификатор;
				КонецЕсли;			
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПустыеУИСДерева(ДеревоНоменклатуры)
	Если Объект.ЗаполнятьУИСтрок Тогда
		
		Для Каждого Строка из ДеревоНоменклатуры.Строки Цикл
			Для Каждого СтрНоменклатура из Строка.Строки Цикл
				Если НЕ СтрНоменклатура.Номенклатура.Пустая() И ПустаяСтрока(СтрНоменклатура.УИСтроки) Тогда				
					//по какой-то причине УИ пустой - заполним
					СтрНоменклатура.УИСтроки = Новый УникальныйИдентификатор;
				КонецЕсли;
			КонецЦикла;	
		КонецЦикла;
		
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПеревестиДокументВВерсию20(Команда)
	
	Если Модифицированность Тогда
		ПоказатьПредупреждение(,"Предварительно следует записать документ");
		Возврат;
	КонецЕсли;
	
	РезультатПроверки = ПроверитьЧтоЗаказДоговорМожноПеревестиВВерсию20();
	Если НЕ РезультатПроверки.МожноПереводитьВ20 Тогда
		ПоказатьПредупреждение(,"Данный документ нельзя перевести в версию 2.0:" + Символы.ПС + РезультатПроверки.Причина);
	Иначе
		РезультатОбработки = ПеревестиЗаказДоговорВВерсию20();
		Если РезультатОбработки.Успешно Тогда
			ПоказатьПредупреждение(,"Успешно выполнен перевод документа в версию 2.0");
			Прочитать();
			ОбновитьОтображениеЭлементовФормы();
		Иначе
			ПоказатьПредупреждение(,"Ошибка перевода в версию 2.0: " + Символы.ПС + РезультатОбработки.ОписаниеОшибки);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПроверитьЧтоЗаказДоговорМожноПеревестиВВерсию20()
	//проверим что ЗД можно переводить в версию 2.0
	Возврат ОбработкаОбновлений.ЗаказДоговорМожноПеревестиВВерсию20(Объект.Ссылка);
КонецФункции

