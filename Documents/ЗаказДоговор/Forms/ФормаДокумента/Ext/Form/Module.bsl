&НаКлиенте
Процедура ДеревоТоваровПередНачаломИзменения(Элемент, Отказ)
	
	ТекущиеДанные = Элементы.ДеревоТоваров.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТекущиеДанные.ПолучитьРодителя() = Неопределено Тогда
		//#10932
		Если Элемент.ТекущийЭлемент.Имя = "ДеревоТоваровБесплатно" Тогда
			// разрешаем ставить галку "Бесплатно" на комнате	
		Иначе
			Отказ = Истина;
			Возврат;	
		КонецЕсли;		
	КонецЕсли;
	
	//Если ТекущиеДанные.Номенклатура.Пустая() Тогда
	//	Отказ = Истина;
	//	Возврат;
	//КонецЕсли;
	
	мСпецификация = ТекущиеДанные.Спецификация;
	мНоменклатура = ТекущиеДанные.Номенклатура;
	
	//запрещаем редактировать строки, у которых статус монтажа = "Выполнен" или "Закрыт"
	Если ТекущиеДанные.МонтажСтатус = ПредопределенноеЗначение("Справочник.РезультатыМонтажа.Выполнен") или ТекущиеДанные.МонтажСтатус = ПредопределенноеЗначение("Справочник.РезультатыМонтажа.Закрыт") Тогда
		ПоказатьПредупреждение(,"Запрещено редактировать строки по выполненным или закрытым монтажам");
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	//// #5185 событие установки пометки удаления заказа покупателя
	//Если ПроверитьНеобходимостьОбновитьДанныеПослеУдаленияЗаказаПокупателя() Тогда
	//	СнятьПризнакНеобходимостиОбновленияДанныхПослеУдаленияЗаказаПокупателя();
	ТекущиеДанные.ЕстьЗаказПокупателяПоПотолку = ПолучитьПризнакЕстьЗаказПокупателяПоПотолку(ТекущиеДанные.Номенклатура, ТекущиеДанные.ХарактеристикаНоменклатуры, ТекущиеДанные.НомерПотолка);
	//КонецЕсли;
	
	//НАЧАЛО переход на 2.0
	Если ТекущиеДанные.ЕстьЗаказПокупателяПоПотолку	Тогда
		Отказ = Истина;
		ПоказатьПредупреждение(,"По данному потолку имеется заказ покупателя (на производство). Редактирование не доступно." + Символы.ПС + "Предварительно следует отменить заказ покупателя.");
		//Возврат;
	КонецЕсли;
	
	Если НЕ ПустаяСтрока(ТекущиеДанные.НомерПотолка) Тогда 
		
		Потолок = ПолучитьНоменклатуруПотолкаДереваПоНомеруПотолка(ТекущиеДанные.НомерПотолка);
		
		Отбор = Новый Структура;
		Отбор.Вставить("Потолок", Потолок);
		НайденныеСтроки = ПодчиненныеДокументыПоПотолку.НайтиСтроки(Отбор);
		Если НайденныеСтроки.Количество() > 0 Тогда
			
			ТекстВопроса = "По " + Потолок + " имеются проведенные документы: " + Символы.ПС;
			Для чНом = 0 По НайденныеСтроки.Количество() - 1 Цикл
				ТекстВопроса = ТекстВопроса + НайденныеСтроки[чНом].Документ + Символы.ПС;
			КонецЦикла;
			ТекстВопроса = ТекстВопроса + "Продолжить?";
			
			ЗадатьВопросПередИзменениемСтроки(Отказ, Элемент, ТекстВопроса);
			
		КонецЕсли;
		
	Иначе
		Отбор = Новый Структура;
		Отбор.Вставить("Потолок", ТекущиеДанные.Номенклатура);
		НайденныеСтроки = ПодчиненныеДокументыПоПотолку.НайтиСтроки(Отбор);
		Если НайденныеСтроки.Количество() > 0 Тогда
			
			ТекстВопроса = "По " + ТекущиеДанные.Номенклатура + " имеются проведенные документы: " + Символы.ПС;
			Для чНом = 0 По НайденныеСтроки.Количество() - 1 Цикл
				ТекстВопроса = ТекстВопроса + НайденныеСтроки[чНом].Документ + Символы.ПС;
			КонецЦикла;
			ТекстВопроса = ТекстВопроса + "Продолжить?";
			
			ЗадатьВопросПередИзменениемСтроки(Отказ, Элемент, ТекстВопроса);
			
		КонецЕсли;
	КонецЕсли;
	//КОНЕЦ переход на 2.0
	
	//++ №12269 запрещаем редактировать количество если "Площадь потолка" заполнена
	Если Элемент.ТекущийЭлемент.Имя = "ДеревоТоваровКоличество" И ВНоменклатуреУказанаПлощадьПотолка(ТекущиеДанные.Номенклатура) Тогда
		Отказ = Истина;
	КонецЕсли;
	//-- №12269
		
КонецПроцедуры

