Процедура ПерестроитьДеревоМатериалыНаФорме()
	
	//МАТЕРИАЛЫ	
	Дерево = ДанныеФормыВЗначение(ДеревоТоваров, Тип("ДеревоЗначений"));
	ДеревоТ = Дерево;	
	Комната = "";
	Дерево = ДанныеФормыВЗначение(ДеревоМатериалов, Тип("ДеревоЗначений"));
	Дерево.Строки.Очистить();
	
	//принудительно добавим все комнаты из дерева товаров - замена процедуре ПроверитьОтсутствиеКомнатВМатериалах
	Для Каждого СтрТовары Из ДеревоТ.Строки Цикл
		Нашли=Ложь;
		Для Каждого СтрМатериалы Из Дерево.Строки Цикл
			Если СтрТовары.Комната = СтрМатериалы.Комната Тогда
				Нашли = Истина;
			КонецЕсли;
		КонецЦикла;
		Если НЕ Нашли Тогда
			СтрДерево = Дерево.Строки.Добавить();
			СтрДерево.Комната = СтрТовары.Комната;
		КонецЕсли;
	КонецЦикла;

	КоличествоСтрокМатериалов = 0; // №10963 добавлено вычисление для шапки
	
	Для Каждого Стр из Объект.Материалы Цикл
		СтрДерево = Дерево.Строки.Найти(Стр.Комната, "Комната");
		Если СтрДерево = Неопределено Тогда
			СтрДерево = Дерево.Строки.Добавить();
			СтрДерево.Комната = Стр.Комната;
			Комната = Стр.Комната;
		КонецЕсли;
		
		Если НЕ Стр.Номенклатура.Пустая() Тогда
			СтрДеревоВид = СтрДерево.Строки.Добавить();
			ЗаполнитьЗначенияСвойств(СтрДеревоВид, Стр);			
			Если ПустаяСтрока(Стр.УИСтроки) Тогда
				//по какой-то причине УИ пустой - заполним
				Стр.УИСтроки = Новый УникальныйИдентификатор;
				СтрДерево.УИСтроки = Стр.УИСтроки;
			КонецЕсли;
			КоличествоСтрокМатериалов = КоличествоСтрокМатериалов + 1; // №10963 добавлено вычисление для шапки
		КонецЕсли;
	КонецЦикла;
	ЗначениеВДанныеФормы(Дерево, ДеревоМатериалов);
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьСтатусПроизводства(Номенклатура)
	//НАЧАЛО Переход на 2.0 R2
	//, ЗаказНаПроизводство)
	//КОНЕЦ  Переход на 2.0 R2

	//НАЧАЛО Переход на 2.0 R2
	//Если ТипЗнч(ЗаказНаПроизводство) = Тип("ДокументСсылка.ЗаказНаПроизводство") Тогда
	//	Если НЕ ЗаказНаПроизводство.Пустая() Тогда
	//		Возврат ЗаказНаПроизводство.ТекущийСтатус;
	//	КонецЕсли;
	//КонецЕсли;
	//КОНЕЦ  Переход на 2.0 R2
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЗаказНаПроизводство.Ссылка КАК Ссылка,
	|	ЗаказНаПроизводство.ТекущийСтатус КАК ТекущийСтатус
	|ИЗ
	|	Документ.ЗаказНаПроизводство КАК ЗаказНаПроизводство
	|ГДЕ
	|	ЗаказНаПроизводство.ПродукцияНоменклатура = &Номенклатура
	|	И НЕ ЗаказНаПроизводство.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда 
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЗаказПоставщикуТовары.Ссылка,
		|	ЗаказПоставщикуТовары.Ссылка.ТекущийСтатус
		|ИЗ
		|	Документ.ЗаказПоставщику.Товары КАК ЗаказПоставщикуТовары
		|ГДЕ
		|	ЗаказПоставщикуТовары.Номенклатура = &Номенклатура
		|	И НЕ ЗаказПоставщикуТовары.Ссылка.ПометкаУдаления";
		
		РезультатЗапроса = Запрос.Выполнить();
		Если РезультатЗапроса.Пустой() Тогда 
			Возврат Справочники.СтатусыЗаказовНаПроизводство.ПустаяСсылка();
		КонецЕсли;
	КонецЕсли;
	
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		Возврат Выборка.ТекущийСтатус;
	КонецЦикла;
	
КонецФункции

