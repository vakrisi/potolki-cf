//проверяет соответствие товаров и услуг монтажей товарам и услугам заказ-договора
//если монтажей еще нет, поле "Текущий статус" окрашивается в желтый цвет
//если количество и состав номенклатуры по комнатам полностью соответствует заказ договору, поле "Текущий статус" окрашивается в зеленый цвет, иначе - в красный
&НаСервере
Процедура ПроверитьСоответствиеМонтажей()
	
	
	Запрос = Новый Запрос;
	//Запрос.Текст = - из-за RLS выборку делаем из документов + этот регистр теперь больше не используется (раньше использовался в АРМ Розницы для формирования заголовков по фильтрам) 
	//"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	//|	ВыполнениеМонтажейПоДоговорамОбороты.Регистратор КАК Монтаж
	//|ИЗ
	//|	РегистрНакопления.ВыполнениеМонтажейПоДоговорам.Обороты(, , Регистратор, ЗаказДоговор = &ЗаказДоговор) КАК ВыполнениеМонтажейПоДоговорамОбороты";
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Монтажи.Ссылка КАК Монтаж
	|ИЗ
	|	Документ.Монтаж КАК Монтажи
	|ГДЕ
	|	Монтажи.Основание = &ЗаказДоговор
	|	И НЕ Монтажи.Результат = ЗНАЧЕНИЕ(Справочник.РезультатыМонтажа.Отменен)
	|	И НЕ Монтажи.ПометкаУдаления";
	Запрос.УстановитьПараметр("ЗаказДоговор", Объект.Ссылка);
	ВыборкаМонтажи = Запрос.Выполнить().Выбрать();
	
	Если ВыборкаМонтажи.Количество() = 0 Тогда
		
		// закомментировано в рамках заявки #16346
		//Элементы.ТекущийСтатус.ЦветФона = WebЦвета.Желтый;
		
	Иначе
		
		ТаблицаТоваровИУслуг = Новый ТаблицаЗначений;
		ТаблицаТоваровИУслуг.Колонки.Добавить("Комната");
		ТаблицаТоваровИУслуг.Колонки.Добавить("Номенклатура");
		ТаблицаТоваровИУслуг.Колонки.Добавить("Количество");
		//++ №10821 единица и коэффициент, так же участвуют в сопоставлении
		ТаблицаТоваровИУслуг.Колонки.Добавить("ЕдиницаИзмерения");
		ТаблицаТоваровИУслуг.Колонки.Добавить("Коэффициент");
		//-- №10821
		ТаблицаТоваровИУслуг.Колонки.Добавить("Сумма");
		
		ВремДеревоТоваров = РеквизитФормыВЗначение("ДеревоТоваров");
		Для Каждого СтрокаКомнаты Из ВремДеревоТоваров.Строки Цикл
			Для Каждого СтрокаНоменклатуры Из СтрокаКомнаты.Строки Цикл
				НоваяСтрока = ТаблицаТоваровИУслуг.Добавить();
				НоваяСтрока.Комната = СтрокаНоменклатуры.Комната;
				НоваяСтрока.Номенклатура = СтрокаНоменклатуры.Номенклатура;
				//++ №10821
				//НоваяСтрока.Количество = СтрокаНоменклатуры.Количество * СтрокаНоменклатуры.Коэффициент;
				НоваяСтрока.Количество = СтрокаНоменклатуры.Количество;
				НоваяСтрока.ЕдиницаИзмерения = СтрокаНоменклатуры.ЕдиницаИзмерения;
				НоваяСтрока.Коэффициент = СтрокаНоменклатуры.Коэффициент;
				//-- №10821
				НоваяСтрока.Сумма = СтрокаНоменклатуры.Сумма;
			КонецЦикла;
		КонецЦикла;
		
		ТаблицаТоваровИУслуг.Свернуть("Комната, Номенклатура, ЕдиницаИзмерения, Коэффициент", "Количество, Сумма"); // №10821 добавлена единица и коэффициет
		
		Пока ВыборкаМонтажи.Следующий() Цикл
			
			//++16703
			МонтажОбъект = ВыборкаМонтажи.Монтаж.ПолучитьОбъект();
			Если Объект.ВидЗаказа = Справочники.ВидыЗаказДоговоров.Договор И НЕ (МонтажОбъект.ВидОперации = Справочники.ВидыМонтажа.Монтаж ИЛИ МонтажОбъект.ВидОперации = Справочники.ВидыМонтажа.Продажа) Тогда
				ПоказатьКнопкуОтчетаСравненияСМонтажами = Истина;
				Возврат;
			КонецЕсли;
			Если Объект.ВидЗаказа = Справочники.ВидыЗаказДоговоров.Продажа И НЕ МонтажОбъект.ВидОперации = Справочники.ВидыМонтажа.Продажа Тогда
				ПоказатьКнопкуОтчетаСравненияСМонтажами = Истина;
				Возврат;
			КонецЕсли;
			Если Объект.ВидЗаказа = Справочники.ВидыЗаказДоговоров.Рекламация И НЕ (МонтажОбъект.ВидОперации = Справочники.ВидыМонтажа.Рекламация ИЛИ МонтажОбъект.ВидОперации = Справочники.ВидыМонтажа.Продажа)   Тогда
				ПоказатьКнопкуОтчетаСравненияСМонтажами = Истина;
				Возврат;
			КонецЕсли;
			Если Объект.ВидЗаказа = Справочники.ВидыЗаказДоговоров.СервиснаяЗаявка И НЕ (МонтажОбъект.ВидОперации = Справочники.ВидыМонтажа.СервиснаяЗаявка ИЛИ МонтажОбъект.ВидОперации = Справочники.ВидыМонтажа.Продажа)  Тогда
				ПоказатьКнопкуОтчетаСравненияСМонтажами = Истина;
				Возврат;
			КонецЕсли;
			//++16703
			
			Для Каждого СтрокаТоварыМонтажа Из ВыборкаМонтажи.Монтаж.ТоварыУслуги Цикл
				Отбор = Новый Структура;
				Отбор.Вставить("Комната",СтрокаТоварыМонтажа.Комната);
				Отбор.Вставить("Номенклатура",СтрокаТоварыМонтажа.Номенклатура);
				//++ №10821
				Отбор.Вставить("ЕдиницаИзмерения", СтрокаТоварыМонтажа.ЕдиницаИзмерения);
				Отбор.Вставить("Коэффициент", СтрокаТоварыМонтажа.Коэффициент);
				//-- №10821
				НайденныеСтроки = ТаблицаТоваровИУслуг.НайтиСтроки(Отбор);
				Если НайденныеСтроки.Количество() > 0 тогда
					НайденныеСтроки[0].Количество = НайденныеСтроки[0].Количество - СтрокаТоварыМонтажа.Количество; // №10821 перемножать на коэффициент теперь не нужно *СтрокаТоварыМонтажа.Коэффициент;
					НайденныеСтроки[0].Сумма = НайденныеСтроки[0].Сумма - СтрокаТоварыМонтажа.Сумма;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
		
		ПолноеСоответсвтие = Истина;
		Для Каждого ТекущаяСтрока Из ТаблицаТоваровИУслуг Цикл
			Если Не ТекущаяСтрока.Количество = 0 или НЕ ТекущаяСтрока.Сумма = 0 Тогда
				ПолноеСоответсвтие = Ложь;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Если ПолноеСоответсвтие Тогда
			//Элементы.ТекущийСтатус.ЦветФона = WebЦвета.БледноЗеленый;
			ПоказатьКнопкуОтчетаСравненияСМонтажами = Ложь;
		Иначе
			//Элементы.ТекущийСтатус.ЦветФона = WebЦвета.Лосось;
			ПоказатьКнопкуОтчетаСравненияСМонтажами = Истина;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьОтчетСравнениеСМонтажами(Команда)
	ПараметрыОтчета  = Новый Структура;
	ПараметрыОтчета.Вставить("ЗаказДоговор", Объект.Ссылка);
	ОткрытьФорму("Отчет.СравнениеЗаказДоговораСМонтажами.ФормаОбъекта", ПараметрыОтчета);
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьНаименованиеВременныхПотолков(Команда)
	Если НЕ ТипЗнч(Объект.Основание) = Тип("ДокументСсылка.Лид") или Объект.Основание.Пустая() Тогда
		ПоказатьПредупреждение(,"Не указан лид-основание. Переименование невозможно");
		Возврат;
	КонецЕсли;
	Если ПустаяСтрока(Объект.НомерДоговора) Тогда
		ПоказатьПредупреждение(,"Не указан номер договора. Переименование невозможно");
		Возврат;
	КонецЕсли;
	Если Модифицированность Тогда
		ПоказатьПредупреждение(,"Предварительно следует записать документ");
		Возврат;
	КонецЕсли;
	ОписаниеОповещенияВопрос = Новый ОписаниеОповещения("ПослеОтветаНаВопросОПереименованииВременныхПотолков", ЭтаФорма);
	ПоказатьВопрос(ОписаниеОповещенияВопрос, "Изменить временные наименования потолков, присвоенные в расчете лида?", РежимДиалогаВопрос.ДаНет);
КонецПроцедуры

&НаКлиенте
Процедура ПослеОтветаНаВопросОПереименованииВременныхПотолков(Результат, Параметры) Экспорт
	Если Результат = КодВозвратаДиалога.Да Тогда
        ИзменитьНаименованиеВременныхПотолковНаСервере();
		Для Каждого ТекущаяСтрока Из Объект.ТоварыУслуги Цикл
			ОповеститьОбИзменении(ТекущаяСтрока.Номенклатура);
		КонецЦикла;
		ПоказатьПредупреждение(,"Переименование потолков завершено");
    КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ИзменитьНаименованиеВременныхПотолковНаСервере()
	
	НомерДляПоиска = "л" + Объект.Основание.Номер;
	
	Для Каждого ТекущаяСтрока Из Объект.ТоварыУслуги Цикл
		Если Справочники.ВидыНоменклатуры.ЭтоНоменклатураПотолкаИлиОтреза(ТекущаяСтрока.Номенклатура) Тогда
			Если СтрНайти(ТекущаяСтрока.Номенклатура.Наименование, НомерДляПоиска) > 0 Тогда
				//переименовываем
				спрОбъект = ТекущаяСтрока.Номенклатура.ПолучитьОбъект();
				СтароеНаименование = спрОбъект.Наименование;
				
				НовоеНаименование = Сред(СтароеНаименование,13,СтрДлина(СтароеНаименование)-1); //Убираем из наименования часть строки вида "Потолок 1017"
				НовоеНаименование = СтрЗаменить(НовоеНаименование,НомерДляПоиска,Объект.НомерДоговора);
				
				спрОбъект.Наименование = НовоеНаименование;
				Попытка
					спрОбъект.Записать();
					Сообщить("[" + СтароеНаименование + "] переименован в [" + НовоеНаименование + "]");
				Исключение
					Сообщить("Не удалось переименовать [" + СтароеНаименование + "]. " + ОписаниеОшибки());
				КонецПопытки;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
		
КонецПроцедуры

&НаКлиенте
Процедура ПредупредитьОбУдаленииСтрокиДереваТовары(ТабличнаяЧасть, ИндексСтроки, ТекстВопроса)
   
   ПоказатьВопрос(Новый ОписаниеОповещения("ПредупредитьОбУдаленииСтрокиДереваТоварыЗавершение", ЭтотОбъект, 
                   Новый Структура("ТабличнаяЧасть, ИндексСтроки", ТабличнаяЧасть, ИндексСтроки)),
                   ТекстВопроса,РежимДиалогаВопрос.ДаНет); 
   
КонецПроцедуры                       
 
&НаКлиенте
Процедура ПредупредитьОбУдаленииСтрокиДереваТоварыЗавершение(Ответ, Параметры) Экспорт
 
   ОтказОтУдаления = (Ответ = КодВозвратаДиалога.Да);
   Если Ответ = КодВозвратаДиалога.Да Тогда
	   ИдентификаторСтроки = Параметры.ИндексСтроки;
	   ТекущаяСтрока       = ДеревоТоваров.НайтиПоИдентификатору(ИдентификаторСтроки);
	   СтрокаРодитель      = ТекущаяСтрока.ПолучитьРодителя();
	   
	   Если СтрокаРодитель = Неопределено Тогда
		   ДеревоТоваров.ПолучитьЭлементы().Удалить(ТекущаяСтрока);
	   Иначе
		   СтрокаРодитель.ПолучитьЭлементы().Удалить(ТекущаяСтрока);
	   КонецЕсли;
	   
	   ПеренестиДеревоВТабличнуюЧасть();
	   ПерестроитьДеревоНаФорме();
	   РазвернутьДеревоТоваров(ВремТекущаяКомната, ВремТекущаяНоменклатура);
	   РазвернутьДеревоМатериалов();
	   
   КонецЕсли; 
   
КонецПроцедуры

&НаСервере
Функция ПолучитьКомнатуИНоменклатуруСледущийСтроки()
	
	СтруктураОтвета = Новый Структура;
	СтруктураОтвета.Вставить("ТекущаяКомната","");
	СтруктураОтвета.Вставить("ТекущаяНоменклатура",Неопределено);
	Нашли = Ложь;
	
	ВремДеревоТоваров = РеквизитФормыВЗначение("ДеревоТоваров");
	Для Каждого ТекущаяСтрокаКомната Из ВремДеревоТоваров.Строки Цикл
		Если ТекущаяСтрокаКомната.Комната = ВремТекущаяКомната и ТекущаяСтрокаКомната.Номенклатура = ВремТекущаяНоменклатура Тогда
			Нашли = Истина;
			Продолжить;
		Иначе
			Если Нашли Тогда
				СтруктураОтвета.ТекущаяКомната = ТекущаяСтрокаКомната.Комната;
				СтруктураОтвета.ТекущаяНоменклатура = Неопределено;
				Возврат СтруктураОтвета;
			КонецЕсли;
		КонецЕсли;
		
		Для Каждого ТекущаяСтрокаНоменклатура Из ТекущаяСтрокаКомната.Строки Цикл
			Если ТекущаяСтрокаНоменклатура.Комната = ВремТекущаяКомната и ТекущаяСтрокаНоменклатура.Номенклатура = ВремТекущаяНоменклатура Тогда
				Нашли = Истина;
			Иначе
				Если Нашли Тогда
					СтруктураОтвета.ТекущаяКомната = ТекущаяСтрокаНоменклатура.Комната;
					СтруктураОтвета.ТекущаяНоменклатура = ТекущаяСтрокаНоменклатура.Номенклатура;
					Возврат СтруктураОтвета;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	//случай удаления самой последней строки дерева
	Для Каждого ТекущаяСтрокаКомната Из ВремДеревоТоваров.Строки Цикл
		
		Если ТекущаяСтрокаКомната.Комната = ВремТекущаяКомната и ТекущаяСтрокаКомната.Номенклатура = ВремТекущаяНоменклатура Тогда
			Продолжить;
		Иначе
			СтруктураОтвета.ТекущаяКомната = ТекущаяСтрокаКомната.Комната;
			СтруктураОтвета.ТекущаяНоменклатура = Неопределено;
		КонецЕсли;
		
		Для Каждого ТекущаяСтрокаНоменклатура Из ТекущаяСтрокаКомната.Строки Цикл
			Если ТекущаяСтрокаНоменклатура.Комната = ВремТекущаяКомната и ТекущаяСтрокаНоменклатура.Номенклатура = ВремТекущаяНоменклатура Тогда
			Иначе
				СтруктураОтвета.ТекущаяКомната = ТекущаяСтрокаНоменклатура.Комната;
				СтруктураОтвета.ТекущаяНоменклатура = ТекущаяСтрокаНоменклатура.Номенклатура;
			КонецЕсли;
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат СтруктураОтвета;
	
КонецФункции



