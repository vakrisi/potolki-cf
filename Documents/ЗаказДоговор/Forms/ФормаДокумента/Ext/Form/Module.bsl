&НаСервере
Функция ЗаполнитьДокументПоПредварительномуРасчету(ПредварительныйРасчет)
	Если ЗначениеЗаполнено(ПредварительныйРасчет) Тогда
		РеквизитыПР = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ПредварительныйРасчет, "Ссылка, Организация, Подразделение, ВидЦен, ВидСкидки, Валюта, СуммаДокумента", Истина);;
		Если ЗначениеЗаполнено(РеквизитыПР.Ссылка) Тогда
			//ЗаполнитьЗначенияСвойств(ЭтотОбъект, РеквизитыПР);
			ЗаполнитьЗначенияСвойств(Объект, РеквизитыПР);
		КонецЕсли;
	КонецЕсли;
	Если ЗначениеЗаполнено(ПредварительныйРасчет) И ЗначениеЗаполнено(РеквизитыПР.Ссылка) Тогда
		Объект.ТоварыУслуги.Очистить();;
		Для Каждого СтрокаТаблицы Из ПредварительныйРасчет.ТоварыУслуги Цикл
			НоваяСтрока = Объект.ТоварыУслуги.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы);
			НоваяСтрока.УИСтроки = Новый УникальныйИдентификатор;
			НоваяСтрока.СтавкаНДС = УчетНДС.СтавкаНДСПоУмолчанию(Объект.Организация);
			НоваяСтрока.СуммаНДС = УчетНДС.РассчитатьСуммуНДС(НоваяСтрока.Сумма, УчитыватьНДС, , УчетНДС.ПолучитьСтавкуНДС(НоваяСтрока.СтавкаНДС));
		КонецЦикла;
		Объект.Материалы.Очистить();
		Для Каждого СтрокаТаблицы Из ПредварительныйРасчет.Материалы Цикл
			НоваяСтрока = Объект.Материалы.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы);
			НоваяСтрока.УИСтроки = Новый УникальныйИдентификатор;
		КонецЦикла;	
	КонецЕсли;
	ПерестроитьДеревоНаФорме();
КонецФункции	

&НаКлиенте
Процедура ДобавитьКонструкцию(Команда)
	
	ВМатериалы = (СтрНайти(Команда.Имя, "ВМатериалы") > 0);
	
	ТекущиеДанные = Элементы.ДеревоТоваров.ТекущиеДанные;	
	Если ВМатериалы Тогда
		ТекущиеДанные = Элементы.ДеревоМатериалов.ТекущиеДанные;
	КонецЕсли;
	
	Если НЕ ОбщийМодульКлиент.Розница_КомнатаЗаполнена(ТекущиеДанные) Тогда
		ПоказатьОповещениеПользователя("Выберите комнату");
		Возврат;
	КонецЕсли;	
	
	ПараметрыФормы = Новый Структура("РежимДобавленияКонструкции", Истина);
	ОписаниеОповещения = Новый ОписаниеОповещения("ПослеВводаДанныхПродукцииПоВиду", ЭтотОбъект, ВМатериалы);
	ОткрытьФорму("ОбщаяФорма.ФормаДобавленияПродукцииПоВиду", ПараметрыФормы, ЭтотОбъект,,,, ОписаниеОповещения);
	
КонецПроцедуры

