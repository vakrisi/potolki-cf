&НаКлиенте
Процедура ДеревоТоваровПередУдалением(Элемент, Отказ)
	
	Для Каждого ВыделеннаяСтрока Из Элементы.ДеревоТоваров.ВыделенныеСтроки Цикл
		ТекущиеДанные = ДеревоТоваров.НайтиПоИдентификатору(ВыделеннаяСтрока);
		
		Если ТекущиеДанные.ПолучитьЭлементы().Количество() > 0 Тогда
			//не даем удалить саму комнату, иначе нижние проверки не сработают
			Отказ = Истина;
			Возврат;
		КонецЕсли;
		
		мСпецификация = ТекущиеДанные.Спецификация;
		мНоменклатура = ТекущиеДанные.Номенклатура;
		
		//запрещаем удалять строки, у которых статус монтажа = "Выполнен" или "Закрыт"
		Если ТекущиеДанные.МонтажСтатус = ПредопределенноеЗначение("Справочник.РезультатыМонтажа.Выполнен") или ТекущиеДанные.МонтажСтатус = ПредопределенноеЗначение("Справочник.РезультатыМонтажа.Закрыт") Тогда
			ПоказатьПредупреждение(,"Запрещено редактировать строки по выполненным или закрытым монтажам");
			Отказ = Истина;
			Возврат;
		КонецЕсли;
		
		// #5185 событие установки пометки удаления заказа покупателя
		Если ПроверитьНеобходимостьОбновитьДанныеПослеУдаленияЗаказаПокупателя() Тогда
			СнятьПризнакНеобходимостиОбновленияДанныхПослеУдаленияЗаказаПокупателя();
			ТекущиеДанные.ЕстьЗаказПокупателяПоПотолку = ПолучитьПризнакЕстьЗаказПокупателяПоПотолку(ТекущиеДанные.Номенклатура, ТекущиеДанные.ХарактеристикаНоменклатуры, ТекущиеДанные.НомерПотолка);
		КонецЕсли;
		
		//НАЧАЛО переход на 2.0
		Если ТекущиеДанные.ЕстьЗаказПокупателяПоПотолку	Тогда
			Отказ = Истина;
			ПоказатьПредупреждение(,"По данному потолку имеется заказ покупателя (на производство). Редактирование не доступно." + Символы.ПС + "Предварительно следует отменить заказ покупателя.");
			Возврат;
		КонецЕсли;
		
		Если НЕ ПустаяСтрока(ТекущиеДанные.НомерПотолка) Тогда 
			
			Потолок = ПолучитьНоменклатуруПотолкаДереваПоНомеруПотолка(ТекущиеДанные.НомерПотолка);
			
			Отбор = Новый Структура;
			Отбор.Вставить("Потолок", Потолок);
			НайденныеСтроки = ПодчиненныеДокументыПоПотолку.НайтиСтроки(Отбор);
			Если НайденныеСтроки.Количество() > 0 Тогда
				
				ТекстВопроса = "По " + Потолок + " имеются проведенные документы: " + Символы.ПС;
				Для чНом = 0 По НайденныеСтроки.Количество() - 1 Цикл
					ТекстВопроса = ТекстВопроса + НайденныеСтроки[чНом].Документ + Символы.ПС;
				КонецЦикла;
				ТекстВопроса = ТекстВопроса + "Продолжить?";
				
				Отказ = Истина;
				ПредупредитьОбУдаленииСтрокиДереваТовары("ДеревоТоваров", Элементы.ДеревоТоваров.ТекущаяСтрока, ТекстВопроса);
				
			КонецЕсли;
			
		Иначе
			Отбор = Новый Структура;
			Отбор.Вставить("Потолок", ТекущиеДанные.Номенклатура);
			НайденныеСтроки = ПодчиненныеДокументыПоПотолку.НайтиСтроки(Отбор);
			Если НайденныеСтроки.Количество() > 0 Тогда
				
				ТекстВопроса = "По " + ТекущиеДанные.Номенклатура + " имеются проведенные документы: " + Символы.ПС;
				Для чНом = 0 По НайденныеСтроки.Количество() - 1 Цикл
					ТекстВопроса = ТекстВопроса + НайденныеСтроки[чНом].Документ + Символы.ПС;
				КонецЦикла;
				ТекстВопроса = ТекстВопроса + "Продолжить?";
				
				Отказ = Истина;
				ПредупредитьОбУдаленииСтрокиДереваТовары("ДеревоТоваров", Элементы.ДеревоТоваров.ТекущаяСтрока, ТекстВопроса);
				
			КонецЕсли;
		КонецЕсли;
		
		//КОНЕЦ переход на 2.0
		
		Если Объект.ЗаполнятьУИСтрок И НЕ ТекущиеДанные.Спецификация.Пустая() И ЗаполнениеМатериаловПоЗаказам Тогда
			ЗадатьВопросОбУдаленииМатериаловПоСпецификации(ТекущиеДанные.Номенклатура, ТекущиеДанные.УИСтроки);
		КонецЕсли;
		
		ВремТекущаяКомната = ТекущиеДанные.Комната;
		ВремТекущаяНоменклатура = ТекущиеДанные.Номенклатура;
		
	КонецЦикла;
	
	СтруктураОтвета = ПолучитьКомнатуИНоменклатуруСледущийСтроки();
	ВремТекущаяКомната = СтруктураОтвета.ТекущаяКомната;
	ВремТекущаяНоменклатура = СтруктураОтвета.ТекущаяНоменклатура;
	
	Если НЕ Отказ И СтруктураДействийПоСТ.АвтоматическиДобавлятьСопутствующиеТоварыИУслуги	Тогда
		МассивСопутствующихТоваровНаУдаление = ОбщийМодульКлиент.ПолучитьСвязанныеСопутствующиеТоварыПоВыделеннымСтрокам(Элементы.ДеревоТоваров, ДеревоТоваров);
		Если МассивСопутствующихТоваровНаУдаление.Количество() > 0 Тогда 		
			Если СтруктураДействийПоСТ.ЗапрашиватьПодтверждениеПриУдаленииНоменклатуры Тогда
				ДопПараметры = Новый Структура("МассивСопутствующихТоваровНаУдаление", МассивСопутствующихТоваровНаУдаление);
				Если ЗначениеЗаполнено(ТекущиеДанные.ХарактеристикаНоменклатуры) Тогда
					ДляВопросаОНоменклатуре = ", характеристика: """ + ТекущиеДанные.ХарактеристикаНоменклатуры + """";
				Иначе
					ДляВопросаОНоменклатуре = "";
				КонецЕсли;
				ПоказатьВопрос(Новый ОписаниеОповещения("ВопросУдалениеСопутствующейНоменклатуры", ЭтотОбъект, ДопПараметры), "Удалить сопутствующие товары и услуги для номенклатуры: """ + ТекущиеДанные.Номенклатура + """" + ДляВопросаОНоменклатуре + "?", РежимДиалогаВопрос.ДаНет);			
			Иначе
				ОбщийМодульКлиент.УдалитьСопутствующиеТовары(ДеревоТоваров, МассивСопутствующихТоваровНаУдаление);
				МассивСопутствующихТоваровНаУдаление.Очистить();
				РассчитатьИтоговыеПоказателиКлиент();
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоТоваровНоменклатураОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	СтрокаТабличнойЧасти = Элементы.ДеревоТоваров.ТекущиеДанные;
	
	// Если номенклатура фактически не изменилась тогда ничего не делаем
	Если  СтрокаТабличнойЧасти.Номенклатура = ВыбранноеЗначение Тогда
		СтандартнаяОбработка = Ложь;
		Возврат;
	КонецЕсли;	
	
	Если СтруктураДействийПоСТ.АвтоматическиДобавлятьСопутствующиеТоварыИУслуги	Тогда
		МассивСопутствующихТоваровНаУдаление = ОбщийМодульКлиент.ПолучитьСвязанныеСопутствующиеТоварыПоВыделеннымСтрокам(Элементы.ДеревоТоваров, ДеревоТоваров);
		Если МассивСопутствующихТоваровНаУдаление.Количество() > 0 Тогда 		
			Если СтруктураДействийПоСТ.ЗапрашиватьПодтверждениеПриИзмененииНоменклатуры Тогда
				ДопПараметры = Новый Структура;
				ДопПараметры.Вставить("МассивСопутствующихТоваровНаУдаление", МассивСопутствующихТоваровНаУдаление);
				ДопПараметры.Вставить("СтрокаТабличнойЧасти", СтрокаТабличнойЧасти);
				ПоказатьВопрос(Новый ОписаниеОповещения("ВопросУдалениеСопутствующейНоменклатуры", ЭтотОбъект, ДопПараметры), "Удалить сопутствующие товары и услуги" + Символы.ПС + "измененной номенклатуры """ + СтрокаТабличнойЧасти.Номенклатура + """" +  ?(ЗначениеЗаполнено(СтрокаТабличнойЧасти.ХарактеристикаНоменклатуры), Символы.ПС + "Характеристика """ + СтрокаТабличнойЧасти.ХарактеристикаНоменклатуры + """", "") + "?", РежимДиалогаВопрос.ДаНет);			
				СтрокаТабличнойЧасти.Номенклатура = ВыбранноеЗначение;
				СтандартнаяОбработка = Ложь;
			Иначе
				ОбщийМодульКлиент.УдалитьСопутствующиеТовары(ДеревоТоваров, МассивСопутствующихТоваровНаУдаление);
				МассивСопутствующихТоваровНаУдаление.Очистить();
				РассчитатьИтоговыеПоказателиКлиент();
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ВопросУдалениеСопутствующейНоменклатуры(РезультатВопроса, ДополнительныеПараметры) Экспорт	
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		ОбщийМодульКлиент.УдалитьСопутствующиеТовары(ДеревоТоваров, ДополнительныеПараметры.МассивСопутствующихТоваровНаУдаление);
		РассчитатьИтоговыеПоказателиКлиент();
	КонецЕсли;
	Если ДополнительныеПараметры.Свойство("СтрокаТабличнойЧасти") Тогда
		    Элементы.ДеревоТоваров.ТекущаяСтрока = ДополнительныеПараметры.СтрокаТабличнойЧасти.ПолучитьИдентификатор();
			ДеревоТоваровНоменклатураПриИзменении(ДополнительныеПараметры.СтрокаТабличнойЧасти);
	КонецЕсли;	
	Если ДополнительныеПараметры.Свойство("СтрокаХарактеристикиТабличнойЧасти") Тогда
		    Элементы.ДеревоТоваров.ТекущаяСтрока = ДополнительныеПараметры.СтрокаХарактеристикиТабличнойЧасти.ПолучитьИдентификатор();
			ДеревоТоваровХарактеристикаНоменклатурыПриИзменении(ДополнительныеПараметры.СтрокаХарактеристикиТабличнойЧасти);
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоТоваровПослеУдаления(Элемент)
	
	ПеренестиДеревоВТабличнуюЧасть();
	//ПерестроитьДеревоНаФорме();
	//ЗаполнитьДанныеКОтгрузкеИОстаткиПоТоварам();
	//РазвернутьДеревоТоваров(ВремТекущаяКомната, ВремТекущаяНоменклатура);
	//РазвернутьДеревоМатериалов();
	РассчитатьИтоговыеПоказателиКлиент();
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоТоваровНоменклатураПриИзменении(Элемент)
	
	СтрокаТабличнойЧасти = Элементы.ДеревоТоваров.ТекущиеДанные;
	СтрокаТабличнойЧасти.ХарактеристикаНоменклатуры = Неопределено;
	
	//корневые строки редактировать нельзя
	Если СтрокаТабличнойЧасти.ПолучитьРодителя() = Неопределено Тогда
		СтрокаТабличнойЧасти.Номенклатура = Неопределено;
		Возврат;
	КонецЕсли;
	
	Если Объект.ЗаполнятьУИСтрок И мСпецификация <> Неопределено И НЕ мСпецификация.Пустая() И ЗаполнениеМатериаловПоЗаказам Тогда
		УдалитьМатериалыОтносящиесяКПозицииНаСервере(мНоменклатура, СтрокаТабличнойЧасти.УИСтроки);
		СтрокаТабличнойЧасти.Спецификация = ПредопределенноеЗначение("Справочник.Спецификации.ПустаяСсылка");
	КонецЕсли;
	
	СтрокаТабличнойЧасти.Количество = ПолучитьКоличествоНоменклатуры(СтрокаТабличнойЧасти.Номенклатура); //1;
	
	СтруктураДанные = СтруктураДанныхПоСтрокеТабличнойЧасти(СтрокаТабличнойЧасти);
