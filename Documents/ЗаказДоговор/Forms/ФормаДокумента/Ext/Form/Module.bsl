&НаКлиенте
Процедура ДеревоТоваровБесплатноПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ДеревоТоваров.ТекущиеДанные;	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТекущиеДанные.ПолучитьРодителя() = Неопределено Тогда
		// комната
		СтрокиТоваров = ТекущиеДанные.ПолучитьЭлементы();
		Для каждого СтрокаТовара из СтрокиТоваров Цикл
			СтрокаТовара.Бесплатно = ТекущиеДанные.Бесплатно;
			Если ТекущиеДанные.Бесплатно Тогда
				СтрокаТовара.Цена = 0;
				СтрокаТовара.ПроцентСкидки = 0;
				СтрокаТовара.СуммаСкидки = 0;
				СтрокаТовара.Сумма = 0;
				СтрокаТовара.СуммаНДС = 0;
			Иначе                            
				СтрокаТовара.Цена = ПолучитьЦенуНоменклатуры(СтрокаТовара.Номенклатура, СтрокаТовара.ХарактеристикаНоменклатуры, СтрокаТовара.ЕдиницаИзмерения);
				СтрокаТовара.ПроцентСкидки = ПолучитьПроцентВидаСкидки(Объект.ВидСкидки) + ПолучитьПроцентАвтоматическойСкидкиСервер(ИспользоватьАвтоматическиеСкидки, Объект.Дата, СтрокаТовара.Номенклатура, СтрокаТовара.Количество);
				РассчитатьСуммуСтроки(СтрокаТовара);
			КонецЕсли;	
		КонецЦикла;
	Иначе
		// номенклатура
		Если ТекущиеДанные.Бесплатно Тогда
			ТекущиеДанные.Цена = 0;
			ТекущиеДанные.ПроцентСкидки = 0;
			ТекущиеДанные.СуммаСкидки = 0;
			ТекущиеДанные.Сумма = 0;
			ТекущиеДанные.СуммаНДС = 0;
		Иначе                            
			ТекущиеДанные.Цена = ПолучитьЦенуНоменклатуры(ТекущиеДанные.Номенклатура, ТекущиеДанные.ХарактеристикаНоменклатуры, ТекущиеДанные.ЕдиницаИзмерения);
			ТекущиеДанные.ПроцентСкидки = ПолучитьПроцентВидаСкидки(Объект.ВидСкидки) + ПолучитьПроцентАвтоматическойСкидкиСервер(ИспользоватьАвтоматическиеСкидки, Объект.Дата, ТекущиеДанные.Номенклатура, ТекущиеДанные.Количество);
			РассчитатьСуммуСтроки(ТекущиеДанные);
		КонецЕсли;
	КонецЕсли;
	
	РассчитатьИтоговыеПоказателиКлиент();
	
КонецПроцедуры

&НаКлиенте
Функция ЕстьМатериалыПоТекущейПозиции(Номенклатура, УИСтроки)
	
	Есть = Ложь;
	
	Для Каждого	ТекущаяСтрока Из Объект.Материалы Цикл
		Если ТекущаяСтрока.НоменклатураТоваров = Номенклатура И ТекущаяСтрока.УИСтроки = УИСтроки Тогда
			Есть = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;		
		
	Возврат Есть;	
	
КонецФункции

// ПерезаполнитьМатериалыПоСпецификации
// Параметры
// ТекущаяСтрока - добавляемая или изменяемая строка. В случае подбора позиция текущей комнаты
// МассивНоменклатур - в случае подбора добавляемые позиции
// ОписаниеДействия - одно из значений "ДобавлениеНоменклатуры", "ИзменениеКоличества", "ИзменениеСпецификации"
&НаКлиенте
Процедура ПерезаполнитьМатериалыПоСпецификации(ТекущаяСтрока, МассивНоменклатур = Неопределено, ОписаниеДействия)
	
	Если НЕ СтруктураДействийПоСпецификациям.АвтоматическиЗаполнятьМатериалы Тогда
		Возврат;
	КонецЕсли;
	
	Позиция = Новый Структура;
	// 2 параметра нужны всегда для разворота дерева после обновления
	Позиция.Вставить("Комната", 		 ТекущаяСтрока.Комната);
	Позиция.Вставить("Номенклатура", 	 ТекущаяСтрока.Номенклатура);
	Если МассивНоменклатур = Неопределено Тогда
		Позиция.Вставить("УИСтроки", 		 ТекущаяСтрока.УИСтроки);
		Позиция.Вставить("Количество", 	  	 ТекущаяСтрока.Количество);
		Позиция.Вставить("Коэффициент", 	 ТекущаяСтрока.Коэффициент);
		Позиция.Вставить("ЕдиницаИзмерения", ТекущаяСтрока.ЕдиницаИзмерения);
		Позиция.Вставить("Спецификация", 	 ТекущаяСтрока.Спецификация);
	КонецЕсли;
	
	Парам = новый Структура;
	Парам.Вставить("ТекущаяСтрока", 	Позиция);
	Парам.Вставить("МассивНоменклатур", МассивНоменклатур);
	
	Если (ОписаниеДействия = "ДобавлениеНоменклатуры" И СтруктураДействийПоСпецификациям.ПодтверждениеПриДобавленииНоменклатуры) 
		 ИЛИ (ОписаниеДействия = "ИзменениеКоличества" И СтруктураДействийПоСпецификациям.ПодтверждениеПриИзмененииКоличества)
		 ИЛИ (ОписаниеДействия = "ИзменениеСпецификации" И СтруктураДействийПоСпецификациям.ПодтверждениеПриИзмененииСпецификации)
		Тогда
			
		ПослеВопросаОПерезаполненииМатериаловПоСпецификаци = Новый ОписаниеОповещения("ОбработкаОтветаНаВопросПерезаполненииМатериаловПоСпецификации", ЭтотОбъект, Парам);
		ПоказатьВопрос(ПослеВопросаОПерезаполненииМатериаловПоСпецификаци, "Перезаполнить материалы по спецификации текущей позиции?", РежимДиалогаВопрос.ДаНет);
	Иначе
		ПерезаполнитьМатериалыПоСпецификацииНаСервере(Парам);
		РазвернутьДеревоТоваров(ТекущаяСтрока.Комната, ТекущаяСтрока.Номенклатура);
		РазвернутьДеревоМатериалов();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОтветаНаВопросПерезаполненииМатериаловПоСпецификации(Результат, ДопПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		ПерезаполнитьМатериалыПоСпецификацииНаСервере(ДопПараметры);
		РазвернутьДеревоТоваров(ДопПараметры.ТекущаяСтрока.Комната, ДопПараметры.ТекущаяСтрока.Номенклатура);
		РазвернутьДеревоМатериалов();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПерезаполнитьМатериалыПоСпецификацииНаСервере(ДопПараметры)
	
	ПеренестиДеревоВТабличнуюЧасть(Ложь,Истина);
	
	Если ДопПараметры.МассивНоменклатур = Неопределено Тогда
		// при добавлении одной позиции, изменении количества/спецификации
		//Сначало удалим
		УдалитьМатериалыОтносящиесяКПозицииНаСервере(ДопПараметры.ТекущаяСтрока.Номенклатура, ДопПараметры.ТекущаяСтрока.УИСтроки);
		
		МассивПозиций = Новый Массив;	
		МассивПозиций.Добавить(ДопПараметры.ТекущаяСтрока);		
	Иначе
		// при подборе
		МассивПозиций = ДопПараметры.МассивНоменклатур;
	КонецЕсли;	
	
	//Теперь заполним		
	ЗаполнитьМатериалыПоСпецификацииНаСервере(МассивПозиций, Ложь);	
	
КонецПроцедуры

&НаКлиенте
Процедура ЗадатьВопросОбУдаленииМатериаловПоСпецификации(Номенклатура, УИСтроки)
	
	Если НЕ СтруктураДействийПоСпецификациям.АвтоматическиЗаполнятьМатериалы Тогда
		Возврат;
	КонецЕсли;
	
	Парам = Новый Структура;
	Парам.Вставить("Номенклатура", 	Номенклатура);
	Парам.Вставить("УИСтроки", 		УИСтроки);
	
	Если СтруктураДействийПоСпецификациям.ПодтверждениеПриУдалении Тогда			
		ПослеВопросаОбУдаленииМатериаловПоСпецификации = Новый ОписаниеОповещения("ОбработкаОтветаНаВопросУдаленияМатериаловПоСпецификации", ЭтотОбъект, Парам);
		ПоказатьВопрос(ПослеВопросаОбУдаленииМатериаловПоСпецификации, "Удалить материалы по спецификации позиции """ + Строка(Номенклатура) + """?", РежимДиалогаВопрос.ДаНет);
	Иначе
		УдалитьМатериалыОтносящиесяКПозицииНаСервере(Номенклатура, УИСтроки);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОтветаНаВопросУдаленияМатериаловПоСпецификации(Результат, ДопПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		УдалитьМатериалыОтносящиесяКПозицииНаСервере(ДопПараметры.Номенклатура, ДопПараметры.УИСтроки);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УдалитьМатериалыОтносящиесяКПозицииНаСервере(Номенклатура, УИСтроки)
	
	КоличествоЗаписей = Объект.Материалы.Количество();
	Для Сч = 1 По КоличествоЗаписей Цикл
		
		Если Объект.Материалы.Получить(КоличествоЗаписей-Сч).НоменклатураТоваров = Номенклатура
			И Объект.Материалы.Получить(КоличествоЗаписей-Сч).УИСтроки = УИСтроки Тогда
			Объект.Материалы.Удалить(КоличествоЗаписей-Сч);
		КонецЕсли;
		
	КонецЦикла;
	ПерестроитьДеревоМатериалыНаФорме();
	
КонецПроцедуры

&НаСервере
Функция ПолучитьСписокПозицийДляПерезаполненияМатериаловПоСпецификации()
	
	СписокПозиций = Новый Массив;
	
	Дерево = ДанныеФормыВЗначение(ДеревоТоваров, Тип("ДеревоЗначений"));
	
	Для Каждого ТекущаяСтрокаКомнаты Из Дерево.Строки Цикл
		Для Каждого ТекущаяСтрока Из ТекущаяСтрокаКомнаты.Строки Цикл			
			Если НЕ ТекущаяСтрока.Спецификация.Пустая() Тогда
				СписокПозиций.Добавить(новый Структура("Комната, Номенклатура, ХарактеристикаНоменклатуры, ЕдиницаИзмерения, Количество, Коэффициент, Спецификация, УИСтроки",
					ТекущаяСтрока.Комната, ТекущаяСтрока.Номенклатура, ТекущаяСтрока.ХарактеристикаНоменклатуры, ТекущаяСтрока.ЕдиницаИзмерения,
					ТекущаяСтрока.Количество, ТекущаяСтрока.Коэффициент, ТекущаяСтрока. Спецификация, ТекущаяСтрока.УИСтроки));				
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;	
	
	Возврат СписокПозиций;
	
КонецФункции

&НаКлиенте
Процедура СкопироватьФайлыИзЛида(Команда)
	
	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
		ОП = новый ОписаниеОповещения("ПослеВыборкаФайловЛида", ЭтотОбъект);
		
		ОткрытьФорму("РегистрСведений.ПрикрепленныеДанные.Форма.ФормаВыбораФайлов", Новый Структура("СсылкаНаДокумент", Объект.Основание)
					,ЭтотОбъект, ЭтотОбъект.УникальныйИдентификатор,,, ОП);
	Иначе
		ПоказатьПредупреждение(, "Предварительно документ необходимо записать");
	КонецЕсли;	
	
КонецПроцедуры
			
&НаКлиенте
Процедура ПослеВыборкаФайловЛида(ВозвращенноеЗначение, ДопПараметры) Экспорт
	
	Если ВозвращенноеЗначение <> Неопределено И ТипЗнч(ВозвращенноеЗначение) = Тип("Массив") Тогда
		ПрисоединитьФайлыИзЛидаНаСервере(ВозвращенноеЗначение);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПрисоединитьФайлыИзЛидаНаСервере(СписокФайлов)
	
	Успешно = Истина;
	
	Для Каждого ТекущаяСтрока Из СписокФайлов Цикл
		Если НЕ ОбщийМодульВызовСервера.СкопироватьЭкземплярПрикрепленныхДанных(ТекущаяСтрока.СсылкаНаОбъект, Объект.Ссылка, ТекущаяСтрока.ИмяФайла, ТекущаяСтрока.Расширение, ТекущаяСтрока.ДатаПрикрепления) Тогда
			Успешно = Ложь;		
		КонецЕсли;
	КонецЦикла;
	
	Если Успешно Тогда
		Сообщить("Файлы успешно прикреплены");
		ОбновитьОтображениеЭлементовФормы();
	Иначе
		Сообщить("Не удалось прикрепить файл(ы)!", СтатусСообщения.Важное);	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыделитьПоМонтажу(Команда)
	
	СписокМонтажей = ПолучитьСписокМонтажей();

	Если НЕ СписокМонтажей.Количество() = 0 Тогда
		ОписаниеОповещения = Новый ОписаниеОповещения("ВыборМонтажаДляВыделенияСтрок", ЭтотОбъект);
		//СП: В качестве этого параметра нельзя указывать кнопки, расположенные в командной панели или подменю. 
		//ПоказатьВыборИзМеню(ОписаниеОповещения, СписокМонтажей, Элементы.ДеревоТоваровВыделитьПоМонтажу);
		// поэтому используем форму
		ПараметрыФормыВыбора = Новый Структура;
		ПараметрыФормыВыбора.Вставить("ДоступныеЗначения", СписокМонтажей);
		ОткрытьФорму("ОбщаяФорма.ВыборИзСписка", ПараметрыФормыВыбора, ЭтаФорма, , , , ОписаниеОповещения);	
		//ОткрытьФорму("ОбщаяФорма.ВыборИзСписка", , ЭтаФорма, , , , ОписаниеОповещения);
	Иначе
		ПоказатьПредупреждение(,"Отсутствуют монтажи по договору");
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьСписокМонтажей()
	
	СписокМонтажей = Новый СписокЗначений;
	ВремДеревоТоваров = РеквизитФормыВЗначение("ДеревоТоваров");
	Для Каждого СтрокаКомнат Из ВремДеревоТоваров.Строки Цикл
		Для Каждого СтрокаНоменклатура Из СтрокаКомнат.Строки Цикл
			Если ЗначениеЗаполнено(СтрокаНоменклатура.Монтаж) Тогда
				Если СписокМонтажей.НайтиПоЗначению(СтрокаНоменклатура.Монтаж) = Неопределено Тогда
				ПредставлениеМонтажа = ПрефиксацияОбъектовКлиентСервер.НомерНаПечать(СтрокаНоменклатура.Монтаж.Номер) + " от " + Формат(СтрокаНоменклатура.Монтаж.Дата, "ДЛФ=Д");
				СписокМонтажей.Добавить(СтрокаНоменклатура.Монтаж, ПредставлениеМонтажа);
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	Возврат СписокМонтажей;
	
КонецФункции

&НаКлиенте
Процедура ВыборМонтажаДляВыделенияСтрок(Результат, ДополнительныеПараметры) Экспорт 
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ВыбранныйМонтаж = Результат;	
	Элементы.ДеревоТоваров.ВыделенныеСтроки.Очистить();
	
	КоллекцияЭлементовДерева = ЭтаФорма.ДеревоТоваров.ПолучитьЭлементы();
	Для Каждого СтрокаКомната Из КоллекцияЭлементовДерева Цикл    
		Для Каждого СтрокаНоменклатура Из СтрокаКомната.ПолучитьЭлементы() Цикл
			Если СтрокаНоменклатура.Монтаж = ВыбранныйМонтаж Тогда
				Элементы.ДеревоТоваров.ВыделенныеСтроки.Добавить(СтрокаНоменклатура.ПолучитьИдентификатор());
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьШтрихкод(Параметр)
	
	//Сперва проверим что комната введена
	Если Элементы.ГруппаТабличныеЧасти.ТекущаяСтраница.Имя = "ГруппаМатериалы" Тогда
		//В материалах
		Если Элементы.ДеревоМатериалов.ТекущиеДанные = Неопределено ИЛИ  ПустаяСтрока(Элементы.ДеревоМатериалов.ТекущиеДанные.Комната) Тогда		
			ПоказатьОповещениеПользователя("Выберите комнату");		
			Возврат;		
		КонецЕсли;
		ТекущаяКомната = Элементы.ДеревоМатериалов.ТекущиеДанные.Комната;
	Иначе
		//В товарах
		Если Элементы.ДеревоТоваров.ТекущиеДанные = Неопределено ИЛИ  ПустаяСтрока(Элементы.ДеревоТоваров.ТекущиеДанные.Комната) Тогда		
			ПоказатьОповещениеПользователя("Выберите комнату");		
			Возврат;		
		КонецЕсли;
		ТекущаяКомната = Элементы.ДеревоТоваров.ТекущиеДанные.Комната;
	КонецЕсли;	
	
	СтруктураТовара = ОбщийМодульКлиент.ПолучитьНоменклатуруПоШтрихКоду(МенеджерОборудованияКлиентПереопределяемый.ПреобразоватьДанныеСоСканераВМассив(Параметр));
	СтруктураТовара.Вставить("Комната", ТекущаяКомната);
	
	Если НЕ СтруктураТовара.Номенклатура = ПредопределенноеЗначение("Справочник.Номенклатура.ПустаяСсылка") Тогда
		
		Если Элементы.ГруппаТабличныеЧасти.ТекущаяСтраница.Имя = "ГруппаМатериалы" Тогда
			
			//Добавление в материалы
			ДобавитьПозициюВМатериалыПоШтрихКоду(СтруктураТовара);			
						
		Иначе
			
			//Добавление в товары			
			ДобавитьПозициюВТоварыПоШтрихКоду(СтруктураТовара);
						
		КонецЕсли;		
		
		Модифицированность = Истина;
	Иначе
		Сообщить("Не удалось найти номенклатуру со штрих-кодом " + СтруктураТовара.ШтрихКод);
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьПозициюВТоварыПоШтрихКоду(СтруктураТовара) 
	
	ДобавитьПозициюВТоварыПоШтрихКодуНаСервере(СтруктураТовара);
	ПеренестиДеревоВТабличнуюЧасть();
	ЗаполнитьДанныеКОтгрузкеИОстаткиПоТоварам();
	РазвернутьДеревоТоваров();
	РассчитатьИтоговыеПоказателиКлиент();
	ДобавленнаяСтрока = НайтиСтрокуДерева(ДеревоТоваров, СтруктураТовара.Комната, СтруктураТовара.Номенклатура, СтруктураТовара.ХарактеристикаНоменклатуры, СтруктураТовара.ЕдиницаИзмерения);
	Если НЕ ДобавленнаяСтрока = Неопределено Тогда
		Элементы.ДеревоТоваров.ТекущаяСтрока = ДобавленнаяСтрока.ПолучитьИдентификатор();			
		ОбновитьОтображениеЭлементовФормы(Элементы.ДеревоТоваров.ТекущиеДанные.Комната, Элементы.ДеревоТоваров.ТекущиеДанные.Номенклатура);	
		Если Объект.ЗаполнятьУИСтрок И НЕ ДобавленнаяСтрока.Спецификация.Пустая() И ЗаполнениеМатериаловПоЗаказам Тогда
			ПерезаполнитьМатериалыПоСпецификации(ДобавленнаяСтрока, , "ДобавлениеНоменклатуры");
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьПозициюВТоварыПоШтрихКодуНаСервере(СтруктураТовара)
	
	ЭтоНоваяСтрока = Истина;
	ТекущаяКомната = Неопределено;
	
	Дерево = ДанныеФормыВЗначение(ДеревоТоваров, Тип("ДеревоЗначений"));
	Для Каждого Строка из Дерево.Строки Цикл
		Если Строка.Комната = СтруктураТовара.Комната Тогда
			//Запомним текущую строку с комнатой
			ТекущаяКомната = Строка;
			//Попробуем найти позицию в дереве, если уже есть, обновим её иначе добавим новую строку
			Для Каждого ТекущаяСтрока Из Строка.Строки Цикл
				Если ТекущаяСтрока.Номенклатура = СтруктураТовара.Номенклатура 
					И ТекущаяСтрока.ЕдиницаИзмерения = СтруктураТовара.ЕдиницаИзмерения
					И ТекущаяСтрока.ХарактеристикаНоменклатуры = СтруктураТовара.ХарактеристикаНоменклатуры
				Тогда
					ЭтоНоваяСтрока = Ложь;
					ТекущаяСтрока.Количество = ТекущаяСтрока.Количество + 1;					
					РассчитатьСуммуСтрокиНаСервере(ТекущаяСтрока);
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли
	КонецЦикла;
	
	Если ТекущаяКомната <> Неопределено И ЭтоНоваяСтрока Тогда
		Стр = ТекущаяКомната.Строки.Добавить();		
		ЗаполнитьЗначенияСвойств(Стр, СтруктураТовара);
		
		СтруктураДанные = Новый Структура("Номенклатура, ВидСпецификации", Стр.Номенклатура, ВидСпецификацииПоУмолчанию);
		СтруктураДанные = ОбщийМодульВызовСервера.ПолучитьДанныеНоменклатурыПриИзменении(СтруктураДанные);	
		ЗаполнитьЗначенияСвойств(Стр, СтруктураДанные, "ВидНоменклатуры, Спецификация, УчитыватьКакПотолок");
	
		//Стр.ВидНоменклатуры = Стр.Номенклатура.ВидНоменклатуры;
		Стр.Количество = 1;
		Если ТипЗнч(Стр.ЕдиницаИзмерения) = Тип("СправочникСсылка.КлассификаторЕдиницИзмерения") Тогда
			Стр.Коэффициент = 1;
		Иначе
			Стр.Коэффициент = ОбщийМодуль.ПолучитьКоэффициентЕдиницыИзмерения(Стр.ЕдиницаИзмерения);
		КонецЕсли;
		//Если Справочники.ВидыНоменклатуры.ЭтоНоменклатураУслуга(Стр.Номенклатура) Тогда // #12667 спецификация только для услуг
		Стр.Спецификация = ?(ЗаполнениеМатериаловПоЗаказам, СтруктураДанные.Спецификация, ПредопределенноеЗначение("Справочник.Спецификации.ПустаяСсылка"));
		//КонецЕсли;
		Стр.Цена = ПолучитьЦенуНоменклатуры(Стр.Номенклатура, Стр.ХарактеристикаНоменклатуры, Стр.ЕдиницаИзмерения);
		Стр.ПроцентСкидки = ПолучитьПроцентВидаСкидки(Объект.ВидСкидки) + ПолучитьПроцентАвтоматическойСкидкиСервер(ИспользоватьАвтоматическиеСкидки, Объект.Дата, Стр.Номенклатура, Стр.Количество);
		Стр.ЦенаПоПрайсу = Стр.Цена;
		//Стр.КоличествоВыработка = ПолучитьКоличествоВыработка(Стр.Количество);
		Стр.УИСтроки = Новый УникальныйИдентификатор;	
		РассчитатьСуммуСтрокиНаСервере(Стр);
	КонецЕсли;
		
	ЗначениеВДанныеФормы(Дерево, ДеревоТоваров);
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьПозициюВМатериалыПоШтрихКоду(СтруктураТовара) 
	
	ДобавитьПозициюВМатериалыПоШтрихКодуНаСервере(СтруктураТовара);
	ПеренестиДеревоВТабличнуюЧасть();
	РазвернутьДеревоМатериалов();
	ДобавленнаяСтрока = НайтиСтрокуДереваМатериалов(СтруктураТовара.Комната, СтруктураТовара.Номенклатура, СтруктураТовара.ХарактеристикаНоменклатуры, СтруктураТовара.ЕдиницаИзмерения);
	Если НЕ ДобавленнаяСтрока = Неопределено Тогда
		Элементы.ДеревоМатериалов.ТекущаяСтрока = ДобавленнаяСтрока.ПолучитьИдентификатор();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьПозициюВМатериалыПоШтрихКодуНаСервере(СтруктураТовара)
	
	ЭтоНоваяСтрока = Истина;
	ТекущаяКомната = Неопределено;
	
	Дерево = ДанныеФормыВЗначение(ДеревоМатериалов, Тип("ДеревоЗначений"));
	Для Каждого Строка из Дерево.Строки Цикл
		Если Строка.Комната = СтруктураТовара.Комната Тогда
			//Запомним текущую строку с комнатой
			ТекущаяКомната = Строка;
			//Попробуем найти позицию в дереве, если уже есть, обновим её иначе добавим новую строку
			Для Каждого ТекущаяСтрока Из Строка.Строки Цикл
				Если ТекущаяСтрока.Номенклатура = СтруктураТовара.Номенклатура 
					И ТекущаяСтрока.ЕдиницаИзмерения = СтруктураТовара.ЕдиницаИзмерения
					И ТекущаяСтрока.ХарактеристикаНоменклатуры = СтруктураТовара.ХарактеристикаНоменклатуры
				Тогда
					ЭтоНоваяСтрока = Ложь;
					ТекущаяСтрока.Количество = ТекущаяСтрока.Количество + 1;
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли
	КонецЦикла;	
	
	Если ТекущаяКомната <> Неопределено И ЭтоНоваяСтрока Тогда
		Стр = ТекущаяКомната.Строки.Добавить();
		ЗаполнитьЗначенияСвойств(Стр, СтруктураТовара);
		Стр.Количество = 1;
		Если ТипЗнч(Стр.ЕдиницаИзмерения) = Тип("СправочникСсылка.КлассификаторЕдиницИзмерения") Тогда
			Стр.Коэффициент = 1;
		Иначе
			Стр.Коэффициент = ОбщийМодуль.ПолучитьКоэффициентЕдиницыИзмерения(Стр.ЕдиницаИзмерения);
		КонецЕсли;
		Стр.УИСтроки = Новый УникальныйИдентификатор;		
	КонецЕсли;	
	
	ЗначениеВДанныеФормы(Дерево, ДеревоМатериалов);
	
КонецПроцедуры

&НаКлиенте
Процедура ПричинаРассторженияДоговораПриИзменении(Элемент)
	ОбновитьОтображениеЭлементовФормы();
