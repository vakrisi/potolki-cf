&НаКлиенте
Процедура ДобавитьНоменклатуру(Команда)
	
	ТекущиеДанные = Элементы.ДеревоТоваров.ТекущиеДанные;
	Если НЕ ОбщийМодульКлиент.Розница_КомнатаЗаполнена(ТекущиеДанные) Тогда
		ПоказатьОповещениеПользователя("Выберите комнату");
		Возврат;
	КонецЕсли;
	
	СтрокаКомнаты = ТекущиеДанные;
	Если НЕ ТекущиеДанные.ПолучитьРодителя() = Неопределено Тогда	
		СтрокаКомнаты = ТекущиеДанные.ПолучитьРодителя();
	КонецЕсли;
	
	ИдКомнаты = СтрокаКомнаты.ПолучитьИдентификатор();
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ПослеВыбораНоменклатуры", ЭтотОбъект, ИдКомнаты);
	
	ПараметрыПодбора = Новый Структура;
	ПараметрыПодбора.Вставить("ТипДокумента",		"ЗаказДоговор");
	ПараметрыПодбора.Вставить("Назначение",			"Товары");
	ОткрытьФорму("Справочник.Номенклатура.ФормаВыбора", ПараметрыПодбора,,,,,ОписаниеОповещения);
		
	Модифицированность = Истина;
		
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораНоменклатуры(ВыбранноеЗначение, ДополнительныеПараметры) Экспорт
	
	Если ВыбранноеЗначение = Неопределено Тогда
		Возврат;
	КонецЕсли;	
	
	Если ТипЗнч(ВыбранноеЗначение) = Тип("Структура") Тогда
		//ДобавитьНоменклатуруВДеревоНаСервере(ВыбЗнач, ДополнительныеПараметры.Комната, ДополнительныеПараметры.Количество);
		//ИмяКомнаты = ДополнительныеПараметры.Комната;
		//Если НЕ ВыбранноеЗначение.Свойство("УИСтроки")  Тогда
		//	ВыбранноеЗначение.Вставить("УИСтроки", Неопределено);
		//КонецЕсли;
		ВозвращеннаяСтрока = ДобавитьНоменклатуруВДеревоТоваровКлиент(ВыбранноеЗначение.Номенклатура, , ВыбранноеЗначение.Количество, Неопределено, ДополнительныеПараметры);
		ДобавленнаяСтрока = ВозвращеннаяСтрока.Строка;
	Иначе
		// ДополнительныеПараметры = Имя комнаты
		//ДобавитьНоменклатуруВДеревоНаСервере(ВыбЗнач, ДополнительныеПараметры);
		//ИмяКомнаты = ДополнительныеПараметры;
		ВозвращеннаяСтрока = ДобавитьНоменклатуруВДеревоТоваровКлиент(ВыбранноеЗначение, , , , ДополнительныеПараметры);
		ДобавленнаяСтрока = ВозвращеннаяСтрока.Строка;
	КонецЕсли;
	
	ПеренестиДеревоВТабличнуюЧасть();	
	
	//ДобавленнаяСтрока = НайтиСтрокуДерева(ДеревоТоваров, ИмяКомнаты, ВыбЗнач);
	Если НЕ ДобавленнаяСтрока = Неопределено Тогда
		//Элементы.ДеревоТоваров.ТекущаяСтрока = ДобавленнаяСтрока.ПолучитьИдентификатор();
		//2017-10-18
		//ОбновитьОтображениеЭлементовФормы(Элементы.ДеревоТоваров.ТекущиеДанные.Комната, Элементы.ДеревоТоваров.ТекущиеДанные.Номенклатура);	
		Если Объект.ЗаполнятьУИСтрок И НЕ ДобавленнаяСтрока.Спецификация.Пустая() И ЗаполнениеМатериаловПоЗаказам Тогда
			ПерезаполнитьМатериалыПоСпецификации(ДобавленнаяСтрока, , "ДобавлениеНоменклатуры");
		КонецЕсли;
	КонецЕсли;		
	
	//++ #16036
	Если НЕ ДобавленнаяСтрока = Неопределено
		И СтруктураДействийПоСТ.АвтоматическиДобавлятьСопутствующиеТоварыИУслуги
		И ОбщийМодульВызовСервера.ЕстьСопутствующаяНоменклатураВРегистре(ДобавленнаяСтрока.Номенклатура, ДобавленнаяСтрока.ХарактеристикаНоменклатуры) Тогда
		Если СтруктураДействийПоСТ.ЗапрашиватьПодтверждениеПриДобавленииНоменклатуры Тогда
			ДопПараметры = Новый Структура;
			ДопПараметры.Вставить("Номенклатура", ДобавленнаяСтрока.Номенклатура); 
			ДопПараметры.Вставить("ХарактеристикаНоменклатуры", ДобавленнаяСтрока.ХарактеристикаНоменклатуры); 
			ДопПараметры.Вставить("УИСтроки", ДобавленнаяСтрока.УИСтроки); 
			ДопПараметры.Вставить("Количество", ДобавленнаяСтрока.Количество); 
			ДопПараметры.Вставить("ИДКомнаты", ДополнительныеПараметры);
			ПоказатьВопрос(Новый ОписаниеОповещения("ВопросДобавлениеСопутствующейНоменклатуры", ЭтотОбъект, ДопПараметры), "Добавить сопутствующие товары и услуги для" + Символы.ПС + "номенклатуры: """ + ДобавленнаяСтрока.Номенклатура + """?", РежимДиалогаВопрос.ДаНет);
		Иначе
			ПодборСопутствующейНоменклатуры(ДополнительныеПараметры);
		КонецЕсли;
	КонецЕсли;	
	//-- #16036
	
	ЗаполнитьДанныеКОтгрузкеИОстаткиПоТоварам();
	РассчитатьИтоговыеПоказателиКлиент();
	
КонецПроцедуры

&НаКлиенте
Процедура ВопросДобавлениеСопутствующейНоменклатуры(РезультатВопроса, ДополнительныеПараметры) Экспорт	
	
	Если НЕ РезультатВопроса = КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	ПодборСопутствующейНоменклатуры(ДополнительныеПараметры.ИДКомнаты);
	ЗаполнитьДанныеКОтгрузкеИОстаткиПоТоварам();
	РассчитатьИтоговыеПоказателиКлиент();	
	
КонецПроцедуры

&НаКлиенте
Процедура ПодборСопутствующейНоменклатуры(ИДКомнаты)
	
	ТекущиеДанные = Элементы.ДеревоТоваров.ТекущиеДанные;
	ИдентификаторСтрокиРодителя = ТекущиеДанные.ПолучитьИдентификатор();
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Позиция = Новый Структура;
	Позиция.Вставить("Номенклатура",								ТекущиеДанные.Номенклатура);
	Позиция.Вставить("ХарактеристикаНоменклатуры",		ТекущиеДанные.ХарактеристикаНоменклатуры);
	Позиция.Вставить("УИСтроки",										ТекущиеДанные.УИСтроки);
	Позиция.Вставить("Количество",									ТекущиеДанные.Количество);
	
	ТаблицаСопутствующейНоменклатуры = СопутствующиеТоварыВызовСервера.ПодборСопутствующейНоменклатурыНаСервере(Позиция);
	ОбработатьДобавлениеСННаСервере(ТаблицаСопутствующейНоменклатуры, ТекущиеДанные.УИСтроки);
	РазвернутьДеревоТоваров();
	
	Элементы.ДеревоТоваров.ТекущаяСтрока =  ОбщийМодульКлиент.ПолучитьИдентификаторПоУИстроки(ДеревоТоваров, Позиция.УИСтроки);
	
КонецПроцедуры

&НаСервере
Процедура ОбработатьДобавлениеСННаСервере(ТаблицаТоваров, УИСтрокиРодителя)
	Дерево = ДанныеФормыВЗначение(ДеревоТоваров, Тип("ДеревоЗначений"));
	СтрокиКомнат = Дерево.Строки;
	ИндексСтроки = 0;
	СтрокаТекущегоРодителя = СтрокиКомнат.Найти(УИСтрокиРодителя, "УИСтроки", Истина);
	СтрокаКомнаты = СтрокаТекущегоРодителя.Родитель;
	ИндексСтроки = СтрокаКомнаты.Строки.Индекс(СтрокаТекущегоРодителя) + 1;
	
	Для Каждого ТекущаяСтрока из ТаблицаТоваров Цикл
		// Проверяем наличие номенклатуры в дереве (в случае добавления недостающей номенклатуры)
		ПараметрыПоиска = Новый Структура;
		ПараметрыПоиска.Вставить("Номенклатура",ТекущаяСтрока.Номенклатура);
		ПараметрыПоиска.Вставить("ХарактеристикаНоменклатуры",ТекущаяСтрока.Характеристика);
		ПараметрыПоиска.Вставить("УИСтрокиРодителя",ТекущаяСтрока.УИСтрокиРодителя);
		//поиск строк
		СтрокиСТВДереве = СтрокиКомнат.НайтиСтроки(ПараметрыПоиска, Истина);
		Если СтрокиСТВДереве.Количество() > 0 Тогда
				СтрокиСТВДереве[0].УИСтроки = ТекущаяСтрока.УИСтроки;
			   ИндексСтроки = ИндексСтроки + 1;
			   Продолжить;
		КонецЕсли;	
		
		СтрокаРодителя = Дерево.Строки.Найти(ТекущаяСтрока.УИСтрокиРодителя, "УИСтроки", Истина);
		Если НЕ СтрокаТекущегоРодителя = СтрокаРодителя Тогда
			СтрокаТекущегоРодителя = СтрокиКомнат.Найти(ТекущаяСтрока.УИСтрокиРодителя, "УИСтроки", Истина);
			ИндексСтроки = СтрокаКомнаты.Строки.Индекс(СтрокаТекущегоРодителя) + 1;
		Иначе
			ИндексСтроки = ИндексСтроки + 1;
		КонецЕсли;	
		
		СтрокиПозиций = СтрокаКомнаты.Строки;
		СтрокаТабличнойЧасти = СтрокиПозиций.Вставить(ИндексСтроки);
		ЗаполнитьЗначенияСвойств(СтрокаТабличнойЧасти, ТекущаяСтрока);
		СтрокаТабличнойЧасти.ХарактеристикаНоменклатуры = ТекущаяСтрока.Характеристика;
		СтрокаТабличнойЧасти.Комната = СтрокаКомнаты.Комната;
		
		СтрокаТабличнойЧасти.Уровень = 1;
		
		СтруктураДанные = СтруктураДанныхПоСтрокеТабличнойЧастиСервер(СтрокаТабличнойЧасти);
		СтруктураДанные = ОбщийМодульВызовСервера.ПолучитьДанныеНоменклатурыПриИзменении(СтруктураДанные);	
		ЗаполнитьЗначенияСвойств(СтрокаТабличнойЧасти, СтруктураДанные, "ВидНоменклатуры, Спецификация, УчитыватьКакПотолок");
		
		СтруктураДанные = ПолучитьДанныеНоменклатурыПриИзменении(СтруктураДанные);
		
		ЗаполнитьЗначенияСвойств(СтрокаТабличнойЧасти, СтруктураДанные, "ЦенаПоПрайсу, ПроцентСкидки");
		РассчитатьСуммуСтрокиНаСервере(СтрокаТабличнойЧасти);
		
		Если ПустаяСтрока(СтрокаТабличнойЧасти.УИСтроки) Тогда
			// при подборе сопутствующих уже заполнено
			СтрокаТабличнойЧасти.УИСтроки = Новый УникальныйИдентификатор;
		КонецЕсли;
		
	КонецЦикла;
	ЗначениеВДанныеФормы(Дерево, ДеревоТоваров);
КонецПроцедуры


&НаКлиенте
Функция ДобавитьСопутствующуюНоменклатуру(Номенклатура, Характеристика = Неопределено, УИСтрокиРодителя, Количество = 1, ИДкомнаты, Уровень, МассивДобавленнойСП = Неопределено)
	Если МассивДобавленнойСП = Неопределено Тогда
		МассивДобавленнойСП = Новый Массив;
	КонецЕсли;	
	Если Уровень < СтруктураДействийПоСТ.ДопустимаяГлубинаВложенностиСопутствующихТоваров Тогда
		МассивЗаписей = ОбщийМодульВызовСервера.ПолучитьСписокСопутствующихТоваров(Номенклатура, Характеристика, Количество);
		Если МассивЗаписей.Количество() > 0 Тогда
			Для Каждого Запись из МассивЗаписей Цикл
				ВозвращеннаяСтрока = ДобавитьНоменклатуруВДеревоТоваровКлиент(Запись.Номенклатура, Запись.Характеристика, Запись.Количество, УИСтрокиРодителя, ИДкомнаты);
				Если ВозвращеннаяСтрока.Новая  Тогда
					ДобавленнаяСтрока = ВозвращеннаяСтрока.Строка;
					МассивДобавленнойСП.Добавить(ДобавленнаяСтрока);
					ДобавитьСопутствующуюНоменклатуру(ДобавленнаяСтрока.Номенклатура, ДобавленнаяСтрока.ХарактеристикаНоменклатуры, ДобавленнаяСтрока.УИСтроки, ДобавленнаяСтрока.Количество, ИДкомнаты, Уровень+1, МассивДобавленнойСП);
				Иначе
					СуществующаяСтрока = ВозвращеннаяСтрока.Строка;
					ДобавитьСопутствующуюНоменклатуру(СуществующаяСтрока.Номенклатура, СуществующаяСтрока.ХарактеристикаНоменклатуры, СуществующаяСтрока.УИСТроки, СуществующаяСтрока.Количество, ИДкомнаты, Уровень+1, МассивДобавленнойСП);
				КонецЕсли;		
			КонецЦикла;	
		КонецЕсли;	
	КонецЕсли;
	Возврат МассивДобавленнойСП;
КонецФункции

&НаКлиенте
Функция ДобавитьНоменклатуруВДеревоТоваровКлиент(Номенклатура, Характеристика = Неопределено, Количество = 1, УИСтрокиРодителя, ИдКомнаты)
	
	ВозвращаемСтроку = Новый Структура;
	СтрокаКомнаты = ДеревоТоваров.НайтиПоИдентификатору(ИдКомнаты);	
	СтрокиНоменклатуры = СтрокаКомнаты.ПолучитьЭлементы();
	
	// Проверяе наличие сопуствующей номенклатуры в дереве чтобы не добавить дубликат или чтобц не затереть параметры номенклатуры в дереве
	Для каждого Строка	Из СтрокиНоменклатуры Цикл 
		Если Строка.Номенклатура = Номенклатура И Строка.ХарактеристикаНоменклатуры = Характеристика И Строка.УИСтрокиРодителя = УИСтрокиРодителя Тогда
			ВозвращаемСтроку.Вставить("Строка", Строка);
			ВозвращаемСтроку.Вставить("Новая", Ложь);
			Возврат ВозвращаемСтроку;
		КонецЕсли;	
	КонецЦикла;
	
	СтрокаТабличнойЧасти = СтрокиНоменклатуры.Добавить();
	СтрокаТабличнойЧасти.Номенклатура = Номенклатура;
	СтрокаТабличнойЧасти.ХарактеристикаНоменклатуры = Характеристика;
	СтрокаТабличнойЧасти.УИСтрокиРодителя = УИСтрокиРодителя;
	СтрокаТабличнойЧасти.Комната = СтрокаКомнаты.Комната;
	
	//СтруктураДанные = Новый Структура("Номенклатура, ХарактеристикаНоменклатуры, ВидСпецификации, Количество, ВидСкидки", 
	//								СтрокаТабличнойЧасти.Номенклатура, СтрокаТабличнойЧасти.ХарактеристикаНоменклатуры, ВидСпецификацииПоУмолчанию, Количество, Объект.ВидСкидки);
	СтрокаТабличнойЧасти.Количество = Количество;
	СтруктураДанные = СтруктураДанныхПоСтрокеТабличнойЧасти(СтрокаТабличнойЧасти);
	
	СтруктураДанные = ОбщийМодульВызовСервера.ПолучитьДанныеНоменклатурыПриИзменении(СтруктураДанные);	
	ЗаполнитьЗначенияСвойств(СтрокаТабличнойЧасти, СтруктураДанные, "ЕдиницаИзмерения, Коэффициент, Количество, ВидНоменклатуры, Спецификация, УчитыватьКакПотолок");
	
	СтруктураДанные = ПолучитьДанныеНоменклатурыПриИзменении(СтруктураДанные);
	ЗаполнитьЗначенияСвойств(СтрокаТабличнойЧасти, СтруктураДанные, "Цена, ЦенаПоПрайсу, ПроцентСкидки, СтавкаНДС, Количество"); //#16345 добавлено Количество 
	
	//++ №13814
	Если ТипЗнч(ИдКомнаты) = Тип("Структура") И ИдКомнаты.Свойство("УИСтроки") Тогда
		СтрокаТабличнойЧасти.УИСтроки = ИдКомнаты.УИСтроки;
	//-- №13814
	Иначе
		СтрокаТабличнойЧасти.УИСтроки = Новый УникальныйИдентификатор;
	КонецЕсли;
	
	РассчитатьСуммуСтроки(СтрокаТабличнойЧасти);
	
	Элементы.ДеревоТоваров.ТекущаяСтрока = СтрокаТабличнойЧасти.ПолучитьИдентификатор();
	
	ВозвращаемСтроку.Вставить("Строка", СтрокаТабличнойЧасти);
	ВозвращаемСтроку.Вставить("Новая", Истина);
	Возврат ВозвращаемСтроку;
	
КонецФункции

&НаСервере
Функция ПолучитьДанныеНоменклатурыПриИзменении(СтруктураДанные)
	
	Если ЭтоРекламация Тогда
		СтруктураДанные.Вставить("Цена", 0);
	Иначе
		СтруктураДанные.Вставить("Цена", ПолучитьЦенуНоменклатуры(СтруктураДанные.Номенклатура, СтруктураДанные.ХарактеристикаНоменклатуры, СтруктураДанные.ЕдиницаИзмерения));
	КонецЕсли;
	//СтруктураДанные.Вставить("ПроцентСкидки", ПолучитьПроцентВидаСкидки(СтруктураДанные.ВидСкидки));
	СтруктураДанные.Вставить("ЦенаПоПрайсу", СтруктураДанные.Цена);
	СтруктураДанные.Вставить("СтавкаНДС", ?(УчитыватьНДС, Объект.СтавкаНДС, Перечисления.СтавкиНДС.ПустаяСсылка()));
	
	//#16345
	Если СтруктураДанные.ИспользоватьКонтрольКратности 
		И НЕ ОбщийМодульСервер.НастройкаПользователя("РазрешитьНесоответствиеКратностиЕдиницИзмерения") Тогда
		
		СтруктураПоиска = Новый Структура("ВидДокумента, ЕдиницаИзмерения", Перечисления.ВидыДокументовПроверкиКратности.ЗаказКлиента, СтруктураДанные.ЕдиницаИзмерения);
		НайденныеСтроки = СтруктураДанные.Номенклатура.Кратность.НайтиСтроки(СтруктураПоиска);
		Если НайденныеСтроки.Количество() > 0 Тогда		
			СтруктураДанные.Вставить("Количество", 0); //#16345
		Иначе
			СтруктураДанные.Вставить("Количество", СтруктураДанные.Количество);
		КонецЕсли;
	Иначе
		СтруктураДанные.Вставить("Количество", СтруктураДанные.Количество);
	КонецЕсли;
	
	СтруктураДанные.Вставить("ПроцентСкидки", ПолучитьПроцентСкидки(СтруктураДанные.ИспользоватьАвтоматическиеСкидки, СтруктураДанные.ВидСкидки, СтруктураДанные.Дата, СтруктураДанные.Номенклатура, СтруктураДанные.Количество));
	
	Возврат СтруктураДанные;
	
КонецФункции

