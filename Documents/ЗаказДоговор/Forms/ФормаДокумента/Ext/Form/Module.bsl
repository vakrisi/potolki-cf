		ПоказатьПредупреждение(, "Заказ должен быть записан!");
		Возврат;
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура("ИзменениеДатыСледующегоКонтакта", Истина);
	ОписаниеОповещения = Новый ОписаниеОповещения("ИзменениеДатыСледующегоКонтактаЗавершение", ЭтотОбъект, ДополнительныеПараметры);
