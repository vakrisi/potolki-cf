&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	ЕстьИзмененияВТЧ = Ложь;
	Для каждого СтрокаТЧ из Объект.ТоварыУслуги Цикл
		СтруктураПоиска = ПолучитьСтруктуруСтрокиТЧ();
		ЗаполнитьЗначенияСвойств(СтруктураПоиска, СтрокаТЧ);
	 	НайденныеСтроки = Объект.Ссылка.ТоварыУслуги.НайтиСтроки(СтруктураПоиска);
		Если НайденныеСтроки.Количество() = 0 Тогда
			ЕстьИзмененияВТЧ = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если НЕ ЕстьИзмененияВТЧ Тогда
		Для каждого СтрокаТЧ из Объект.Ссылка.ТоварыУслуги Цикл
			СтруктураПоиска = ПолучитьСтруктуруСтрокиТЧ();
			ЗаполнитьЗначенияСвойств(СтруктураПоиска, СтрокаТЧ);
			НайденныеСтроки = Объект.ТоварыУслуги.НайтиСтроки(СтруктураПоиска);
			Если НайденныеСтроки.Количество() = 0 Тогда
				ЕстьИзмененияВТЧ = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
		
	Если Объект.Ссылка.Пустая() Тогда
		Если ПолучитьФункциональнуюОпцию("ОграничитьВыборТоваровВЗаказДоговор") Тогда
			
			Запрос = Новый Запрос;
			Запрос.УстановитьПараметр("МассивНоменклатуры", Объект.ТоварыУслуги.Выгрузить().ВыгрузитьКолонку("Номенклатура"));
			Запрос.УстановитьПараметр("Назначение", 1);
			Запрос.Текст = ОбщийМодульСервер.ПолучитьТекстЗапросаРазрешеннаяНоменклатураРозницы();
			// №7114 комментируем, т.к. этот запрос не учитывает группы номенклатуры и дублируется ниже
			//"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			//|	ДанныеСправочника.Ссылка КАК Ссылка
			//|ИЗ
			//|	Справочник.Номенклатура КАК ДанныеСправочника
			//|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РазрешеннаяНоменклатураРозницы КАК РазрешеннаяНоменклатураРозницы
			//|		ПО (РазрешеннаяНоменклатураРозницы.Номенклатура = ДанныеСправочника.Ссылка)
			//|ГДЕ
			//|	ДанныеСправочника.Ссылка В(&МассивНоменклатуры)
			//|	И ДанныеСправочника.ВидНоменклатуры В (ЗНАЧЕНИЕ(Справочник.ВидыНоменклатуры.Материал), ЗНАЧЕНИЕ(Справочник.ВидыНоменклатуры.Услуга))
			//|	И РазрешеннаяНоменклатураРозницы.Номенклатура ЕСТЬ NULL";
			Выборка = Запрос.Выполнить().Выбрать();
			Пока Выборка.Следующий() Цикл
				ТекстСообщения = "В списке товаров имеется неразрешенная позиция: " + Выборка.Ссылка;
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,,,Отказ);
			КонецЦикла;
						
		КонецЕсли;
		Если ПолучитьФункциональнуюОпцию("ОграничитьВыборМатериаловВЗаказДоговор") Тогда
			
			Запрос = Новый Запрос;
			Запрос.УстановитьПараметр("МассивНоменклатуры", Объект.Материалы.Выгрузить().ВыгрузитьКолонку("Номенклатура"));
			Запрос.УстановитьПараметр("Назначение", 2);
			Запрос.Текст = ОбщийМодульСервер.ПолучитьТекстЗапросаРазрешеннаяНоменклатураРозницы();
			// №7114 комментируем, т.к. этот запрос не учитывает группы номенклатуры и дублируется выше
			//"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			//|	ДанныеСправочника.Ссылка КАК Ссылка
			//|ИЗ
			//|	Справочник.Номенклатура КАК ДанныеСправочника
			//|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РазрешеннаяНоменклатураРозницы КАК РазрешеннаяНоменклатураРозницы
			//|		ПО (РазрешеннаяНоменклатураРозницы.Номенклатура = ДанныеСправочника.Ссылка)
			//|ГДЕ
			//|	ДанныеСправочника.Ссылка В(&МассивНоменклатуры)
			//|	И ДанныеСправочника.ВидНоменклатуры В (ЗНАЧЕНИЕ(Справочник.ВидыНоменклатуры.Материал), ЗНАЧЕНИЕ(Справочник.ВидыНоменклатуры.Услуга))
			//|	И РазрешеннаяНоменклатураРозницы.Номенклатура ЕСТЬ NULL";
			Выборка = Запрос.Выполнить().Выбрать();
			Пока Выборка.Следующий() Цикл
				ТекстСообщения = "В списке материалов имеется неразрешенная позиция: " + Выборка.Ссылка;
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,,,Отказ);
			КонецЦикла;

		КонецЕсли;
	КонецЕсли; 	
		
	//проверки
	Если ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
		ДеревоТовары = ДанныеФормыВЗначение(ДеревоТоваров, Тип("ДеревоЗначений"));
		ДеревоМатериалы = ДанныеФормыВЗначение(ДеревоМатериалов, Тип("ДеревоЗначений"));
		
		Для Каждого ТекущаяКомната из ДеревоТовары.Строки Цикл
			Для Каждого ТекущаяНоменклатура из ТекущаяКомната.Строки Цикл
				
				Если НЕ ЭтоРекламация Тогда
					ТекстСообщения = ("Товары и услуги. Комната: " + ТекущаяНоменклатура.Комната + ", Номенклатура: " + ТекущаяНоменклатура.Номенклатура + " не указана цена");
					СтруктураПараметров = Новый Структура("Ссылка, ТабличнаяЧасть, ИмяТабличнойЧасти, ТекстСообщения", Объект.Ссылка, "ТоварыУслуги", "", ТекстСообщения);
					ОбработкаТабличныхЧастейСервер.ПроверитьЦенуСтроки(ТекущаяНоменклатура, СтруктураПараметров, Отказ);
				КонецЕсли;
				
				Если ТекущаяНоменклатура.Количество = 0 Тогда
					ТекстСообщения = "Товары и услуги. Комната: " + ТекущаяНоменклатура.Комната + ", Номенклатура: " + ТекущаяНоменклатура.Номенклатура + " не заполнено поле ""Количество""";
					//Отказ = Истина;
					//Сообщить(ТекстСообщения);
					ПолеДанных = "ДеревоТоваров"; //[" + Формат(1, "ЧГ=0") + "].Количество";
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, Объект.Ссылка, , ПолеДанных, Отказ);
				КонецЕсли;
				Если ПустаяСтрока(ТекущаяНоменклатура.ЕдиницаИзмерения) Тогда
					Отказ = Истина;
					Сообщить("Товары и услуги. Комната: " + ТекущаяНоменклатура.Комната + ", Номенклатура: " + ТекущаяНоменклатура.Номенклатура + " не указана единица измерения");
				КонецЕсли;
				Если ТекущаяНоменклатура.Коэффициент = 0 Тогда
					Отказ = Истина;
					Сообщить("Товары и услуги. Комната: " + ТекущаяНоменклатура.Комната + ", Номенклатура: " + ТекущаяНоменклатура.Номенклатура + " не указан коэффициент единицы измерения");
				КонецЕсли;
			КонецЦикла;	
		КонецЦикла;
		
		Для Каждого ТекущаяКомната из ДеревоМатериалы.Строки Цикл
			Для Каждого ТекущаяНоменклатура из ТекущаяКомната.Строки Цикл
				Если ТекущаяНоменклатура.Количество = 0 Тогда
					Отказ = Истина;
					Сообщить("Материалы. Комната: " + ТекущаяНоменклатура.Комната + ", Номенклатура: " + ТекущаяНоменклатура.Номенклатура + " не указано количество");
				КонецЕсли;
				Если ПустаяСтрока(ТекущаяНоменклатура.ЕдиницаИзмерения) Тогда
					Отказ = Истина;
					Сообщить("Материалы. Комната: " + ТекущаяНоменклатура.Комната + ", Номенклатура: " + ТекущаяНоменклатура.Номенклатура + " не указана единица измерения");
				КонецЕсли;
				Если ТекущаяНоменклатура.Коэффициент = 0 Тогда
					Отказ = Истина;
					Сообщить("Материалы. Комната: " + ТекущаяНоменклатура.Комната + ", Номенклатура: " + ТекущаяНоменклатура.Номенклатура + " не указан коэффициент единицы измерения");
				КонецЕсли;
			КонецЦикла;	
		КонецЦикла;
	КонецЕсли;
	
	Если НЕ Отказ И ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.Проведение И НЕ Объект.Ссылка.Пустая() Тогда
		
		СтруктураПроверки = Документы.ЗаказДоговор.ВсеТоварыПоЗаказуОтгружены1(Объект.Ссылка, Объект.ТоварыУслуги);
		Отказ = НЕ СтруктураПроверки.Результат;
		
		Если Отказ Тогда
			Сообщить(СтруктураПроверки.Описание, СтатусСообщения.Важное);
			Сообщить("Документ не проведен");
			Возврат;
		КонецЕсли;
		
	КонецЕсли;
	
	//Проверка на полную отгрузку по документу
	Если НЕ Отказ И ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.Проведение И Объект.ТекущийСтатус = Справочники.СтатусыЗаказДоговоров.Выполнен Тогда
		
		СтруктураПроверки = Документы.ЗаказДоговор.ВсеТоварыПоЗаказуОтгружены2(Объект.Ссылка, Объект.ТоварыУслуги);
		Отказ = НЕ СтруктураПроверки.Результат;
		
		Если Отказ Тогда
			Сообщить(СтруктураПроверки.Описание, СтатусСообщения.Важное);
			Возврат;
		КонецЕсли;
		
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ТекущийОбъект.Ссылка) Тогда
		ТекущийОбъект.ДополнительныеСвойства.Вставить("ДатаСоздания", ДатаСоздания);
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура ПослеВопросаОбОтменеМонтажейВРаботе(Ответ, ДопПараметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Да Тогда
		
		//Необходимо перевести монтажи в работе в статус "Отменен"
		ПеревестиМонтажиВРаботеВСтатусОтменен(ДопПараметры.МонтажиВРаботе);	
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПеревестиМонтажиВРаботеВСтатусОтменен(МонтажиВРаботе)
	
	Успешно = Истина;
	
	Для Каждого Монтаж Из МонтажиВРаботе Цикл
		ДокОбъект = Монтаж.ПолучитьОбъект();
		ДокОбъект.Результат = Справочники.РезультатыМонтажа.Отменен;
		Попытка
			ДокОбъект.Записать();
		Исключение
			Успешно = Ложь;
			Сообщить("Ошибка при переводе монтажа " + Монтаж + " в статус ""Отменен"": " + ОписаниеОшибки());
		КонецПопытки;
	КонецЦикла;	
		
	Если Успешно Тогда
		Сообщить("Монтажи в работе успешно переведены в статус ""Отменен"".");
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьМонтажиВСтатусе(Статусы)
	
	Запрос = новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Монтажи.Ссылка
		|ИЗ
		|   Документ.Монтаж КАК Монтажи
		|ГДЕ
		|   Монтажи.Основание = &ЗаказДоговор
		|	И Монтажи.Результат В (&Статусы)
		|	И НЕ Монтажи.ПометкаУдаления";
	Запрос.УстановитьПараметр("ЗаказДоговор", Объект.Ссылка);
	
	Запрос.УстановитьПараметр("Статусы", Статусы);
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
КонецФункции

