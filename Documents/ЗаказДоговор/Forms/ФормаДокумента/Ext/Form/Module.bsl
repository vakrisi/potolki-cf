	МассивРеквизитов.Добавить("ГруппаСуммаДокументаИСуммаДолга");
	МассивРеквизитов.Добавить("СтавкаНДС");
	
	МассивРеквизитов.Добавить("ДеревоТоваровИзменитьСкидкуНаПотолок");
	МассивРеквизитов.Добавить("ДеревоТоваровИзменитьСкидкуНаУслуги");
	МассивРеквизитов.Добавить("ДеревоТоваровИзменитьСкидкуТовары");
	МассивРеквизитов.Добавить("ДеревоТоваровИзменитьСкидкуНаВсе");
	МассивРеквизитов.Добавить("ДеревоТоваровОчиститьСкидки");
	
	МассивРеквизитов.Добавить("ДеревоТоваровЦена");
	МассивРеквизитов.Добавить("ДеревоТоваровПроцентСкидки");
	МассивРеквизитов.Добавить("ДеревоТоваровСуммаСкидки");
	МассивРеквизитов.Добавить("ДеревоТоваровСумма");
	МассивРеквизитов.Добавить("ДеревоТоваровСуммаПоПрайсу");
