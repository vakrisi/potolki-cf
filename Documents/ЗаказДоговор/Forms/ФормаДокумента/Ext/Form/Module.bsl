&НаКлиенте
Процедура ДеревоТоваровВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если НЕ Элемент = Неопределено И Поле.Имя = "ДеревоТоваровМонтаж" Тогда
		СсылкаМонтаж = Элементы.ДеревоТоваров.ТекущиеДанные.Монтаж;
		Если НЕ СсылкаМонтаж = Неопределено И НЕ СсылкаМонтаж.Пустая() Тогда
			ПарамДок = Новый Структура;
			ПарамДок.Вставить("Ключ", СсылкаМонтаж);
			ОткрытьФорму("Документ.Монтаж.ФормаОбъекта",ПарамДок);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоТоваровПриАктивизацииСтроки(Элемент)
	
	ТекущиеДанные = Элементы.ДеревоТоваров.ТекущиеДанные;	
	Если ТекущиеДанные = Неопределено Тогда
		Элементы.ДопИнфоПлощадьПотолка.Заголовок = "";
		Возврат;
	КонецЕсли;
	
	// корневая строка
	Если ТекущиеДанные.ПолучитьРодителя() = Неопределено Тогда
		Элементы.ДопИнфоПлощадьПотолка.Заголовок = "";
		Возврат;
	КонецЕсли;
	
	СтруктураДанных = ПолучитьДанныеНоменклатуры(ТекущиеДанные.Номенклатура);
	Если СтруктураДанных.ЭтоПотолок Тогда		
		Элементы.ДопИнфоПлощадьПотолка.Заголовок = "Площадь выбранного потолка: " + Строка(СтруктураДанных.Потолок_КоличествоПродукция);
	Иначе
		Элементы.ДопИнфоПлощадьПотолка.Заголовок = "";
	КонецЕсли;
	
КонецПроцедуры

