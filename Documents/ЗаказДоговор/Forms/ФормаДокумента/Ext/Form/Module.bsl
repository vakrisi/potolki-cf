&НаСервере
Процедура УстановитьЗаголовокФормы()
	
	НачалоЗаголовка = "Заказ клиента";
	Если Объект.ВидЗаказа = Справочники.ВидыЗаказДоговоров.Договор Тогда
		НачалоЗаголовка = "Заказ клиента (договор)";
	ИначеЕсли Объект.ВидЗаказа = Справочники.ВидыЗаказДоговоров.Рекламация Тогда
		НачалоЗаголовка = "Заказ клиента (рекламация)";
	ИначеЕсли Объект.ВидЗаказа = Справочники.ВидыЗаказДоговоров.СервиснаяЗаявка Тогда
		НачалоЗаголовка = "Заказ клиента (сервисная заявка)";
	ИначеЕсли Объект.ВидЗаказа = Справочники.ВидыЗаказДоговоров.Продажа Тогда
		НачалоЗаголовка = "Заказ клиента (продажа)";
	КонецЕсли;
	
	ВерсияЗаказа  = "";
	Если НЕ Объект.ЗаполнятьУИСтрок Тогда
		ВерсияЗаказа = "(Версия документа 1.1)";
	КонецЕсли;
	 
	ЭтаФорма.Заголовок = СокрЛП(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку("%1 %2 %3",
						НачалоЗаголовка, 
						?(Объект.Ссылка.Пустая(), "(создание)", Объект.Номер + " от " + Объект.Дата), 
						ВерсияЗаказа));
	
КонецПроцедуры
					
