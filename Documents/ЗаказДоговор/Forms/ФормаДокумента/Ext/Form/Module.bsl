&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)	
	
	УстановитьЗаголовокФормы();
	
	ВключитьПредпросмотрФайлов = НЕ Константы.ВыключитьПредпросмотрПрикрепленныхФайловВДокументах.Получить();
	Элементы.ГруппаФайлыПредпросмотр.Видимость = ВключитьПредпросмотрФайлов;
	
	УОТекущаяДата = НачалоДня(ТекущаяДатаСеанса());
	
	ИспользоватьКонтрольКратности = ПолучитьФункциональнуюОпцию("ИспользоватьКонтрольКратностиЕдиницИзмерения");
	
	ОтключитьДоступностьГруппыПечать = Ложь;
	Если Параметры.Ключ.Пустая() Тогда
		ЭтоНовый = Истина;
		НомерЛида = ПолучитьНомерЛидаОснования();
		
		ДатаСоздания = ТекущаяДатаСеанса();
		
		ПриСозданииЧтенииНаСервере();
	Иначе
		ЭтаФорма.ТолькоПросмотр = ПраваПользователей.ДокументТолькоПросмотр(Объект.Ссылка);
		ЭтоНовый = Ложь;
		
		СтруктураСоглашениеОРасторжении = Документы.ЗаказДоговор.ЕстьСоглашениеОРасторжении(Объект.Ссылка);
		СоглашениеОРасторженииДоговора = СтруктураСоглашениеОРасторжении.Документ;
		Если НЕ ЭтаФорма.ТолькоПросмотр И СтруктураСоглашениеОРасторжении.ЕстьСоглашениеОРасторжении Тогда
			ТолькоПросмотр = Истина;
			ОтключитьДоступностьГруппыПечать = Истина;
		КонецЕсли;
		//1.1.1.0
		Если НЕ ЭтаФорма.ТолькоПросмотр Тогда
			ОбщийМодульВызовСервера.ЗаблокироватьОбъектДляРедактирования(Объект.Ссылка, ЭтаФорма, Элементы.ПодменюСоздатьНаОсновании);
		КонецЕсли;
		
	КонецЕсли;
	
	СтруктураДействийПоСпецификациям = ОбщийМодульСервер.СтруктураДействийПоСпецификациямВЗаказДоговоре();
	СтруктураДействийПоСТ = СопутствующиеТоварыСервер.СтруктураДействийПоСопутствующимТоварамВРознице();
	
	//++15925
	СтруктураСпособовДобавленияПродукции = ОбщийМодульСервер.СтруктураСпособовДобавленияПродукции();
	Элементы.ДеревоТоваровЗагрузитьПотолокИзEasyCeiling.Видимость = СтруктураСпособовДобавленияПродукции.СпособДобавленияПродукцииЗагрузитьИзПостроителя; 
	Элементы.ДеревоТоваровДобавитьУстановкуПотолка.Видимость = СтруктураСпособовДобавленияПродукции.СпособДобавленияПродукцииВыбратьПотолок;
	Элементы.ДеревоТоваровДобавитьПотолок.Видимость = СтруктураСпособовДобавленияПродукции.СпособДобавленияПродукцииСоздатьПотолок;
	Элементы.ДеревоТоваровДобавитьПродукцию.Видимость = СтруктураСпособовДобавленияПродукции.СпособДобавленияПродукцииСоздатьПродукцию;
	Элементы.ДеревоТоваровДобавитьКонструкцию.Видимость = СтруктураСпособовДобавленияПродукции.СпособДобавленияПродукцииСоздатьКонструкцию;
	//--15925
	
	//ПроверитьОтсутствиеКомнатВМатериалах(); убрано в процедуру ПерестроитьДеревоНаФорме
		
	//построим дерево
	ПерестроитьДеревоНаФорме();

	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	// СтандартныеПодсистемы.УчетОригиналовПервичныхДокументов
	УчетОригиналовПервичныхДокументов.ПриСозданииНаСервере_ФормаДокумента(ЭтотОбъект, Элементы.ГруппаПодвалПрочее);
	// Конец СтандартныеПодсистемы.УчетОригиналовПервичныхДокументов 
	
	// СтандартныеПодсистемы.ВерсионированиеОбъектов
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ВерсионированиеОбъектов
	
	//#8481
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(ИсторияЗаказа, "Заказ", Объект.Ссылка, , , Истина, РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный);
	
	СофтФонСервер.ПриСозданииНаСервере(ЭтотОбъект);
	СофтФонСервер.ПриСозданииНаСервере(ЭтотОбъект, Элементы.ГруппаЗвонокЗамерщику, "Замерщику");
	МессенджерыСервер.ПриСозданииНаСервере(ЭтотОбъект, Элементы.ГруппаКонтрагентКПМессенджеры);
	
	РеквизитыПользователя = ОбщийМодульСервер.НастройкиПользователя("ДоступнаУстановкаПроцентаЗамерщику, 
							|ДополнительныеПраваЗапретРедактированияЦенВДокументах, ДополнительныеПраваЗапретПримененияСкидок,
							|РазрешеноМенятьДатуЗаказДоговора, РазрешитьНулевыеЦены, РазрешеноМенятьМенеджераВЗаказДоговоре");
	
	Элементы.КомандаПроцентЗамерщику.Видимость = РеквизитыПользователя.ДоступнаУстановкаПроцентаЗамерщику;
	Если Элементы.ГруппаЗвонокЗамерщику.ПодчиненныеЭлементы.Количество() = 0 И НЕ Элементы.КомандаПроцентЗамерщику.Видимость Тогда
		Элементы.ИсполнительЗамера.АвтоМаксимальнаяШирина = Истина;
	ИначеЕсли Элементы.ГруппаЗвонокЗамерщику.ПодчиненныеЭлементы.Количество() = 0 И Элементы.КомандаПроцентЗамерщику.Видимость Тогда
		Элементы.ИсполнительЗамера.АвтоМаксимальнаяШирина = Ложь;
		Элементы.ИсполнительЗамера.МаксимальнаяШирина = 30;
	ИначеЕсли Элементы.ГруппаЗвонокЗамерщику.ПодчиненныеЭлементы.Количество() > 0 И Элементы.КомандаПроцентЗамерщику.Видимость Тогда
		Элементы.ИсполнительЗамера.АвтоМаксимальнаяШирина = Ложь;
		Элементы.ИсполнительЗамера.МаксимальнаяШирина = 26;
	ИначеЕсли Элементы.ГруппаЗвонокЗамерщику.ПодчиненныеЭлементы.Количество() > 0 И НЕ Элементы.КомандаПроцентЗамерщику.Видимость Тогда
		Элементы.ИсполнительЗамера.АвтоМаксимальнаяШирина = Ложь;
		Элементы.ИсполнительЗамера.МаксимальнаяШирина = 36;
	КонецЕсли;
	
	//управление доступностью элементов
	Если РеквизитыПользователя.ДополнительныеПраваЗапретРедактированияЦенВДокументах Тогда
		МассивИменЭлементов = Документы.ЗаказДоговор.ПолучитьМассивРеквизитовПоЦенам();
		ОбщийМодульКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы, МассивИменЭлементов, "ТолькоПросмотр", Истина);
	КонецЕсли;
	//#7771
	Если РеквизитыПользователя.ДополнительныеПраваЗапретПримененияСкидок Тогда
		МассивИменЭлементов = Документы.ЗаказДоговор.ПолучитьМассивРеквизитовПоСкидкам();
		ОбщийМодульКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы, МассивИменЭлементов, "ТолькоПросмотр", Истина);
	КонецЕсли;
	
	//Изменять дату можно только у нового документа либо с разрешением
	Если ЗначениеЗаполнено(Объект.Ссылка) И НЕ РеквизитыПользователя.РазрешеноМенятьДатуЗаказДоговора Тогда
		Элементы.Дата.ТолькоПросмотр = Истина;
	КонецЕсли;	
	
	Элементы.ПодменюПечать.Доступность = ПраваПользователей.ДоступностьПечати(Объект.Ссылка);
	ПраваПользователей.УстановитьТолькоПросмотрДляРеквизитаНомер(Элементы.Номер.ТолькоПросмотр);
	
	ПроверитьСоответствиеМонтажей();
	
	ПереключательНаНазваниеКомнат = Константы.ИспользоватьСправочникКомнатВРознице.Получить();
	
	RVY_ИспользоватьИнтеграцию = Константы.RVY_ИспользоватьИнтеграцию.Получить();
	
	Если РольДоступна("ОтчетПредварительнаяСебестоимостьЗаказДоговораПросмотр") 
		или РольДоступна("АдминистраторСистемы") 
		или РольДоступна("ПолныеПрава") Тогда
		Элементы.ФормаПредварительныйРасчет.Видимость = Истина;
	Иначе
		Элементы.ФормаПредварительныйРасчет.Видимость = Ложь;
	КонецЕсли;
	
	УправлениеФормойПоВидуЗаказа();
	УправлениеФормойПоЗаказу();
	
	//Элементы.КонтрагентДополнительно.Видимость = Объект.Контрагент.ПоказыватьДопИнформацию;
	ОбщийМодульСервер.ДополнительнаяИнформацияПоКонтрагентуНаФорме(Объект.Контрагент, Элементы.ПоказатьДополнительнуюИнформацию);
	ОбщийМодульСервер.РегулировкаШириныПоляКонтрагента(Элементы, Элементы.Контрагент, Элементы.ПоказатьДополнительнуюИнформацию, , 32);
		
	Элементы.ДеревоТоваровБесплатно.ТолькоПросмотр = НЕ РеквизитыПользователя.РазрешитьНулевыеЦены;
	
	//++ №11768
	//Если ТипЗнч(Объект.Основание) = Тип("ДокументСсылка.Лид") И ЗначениеЗаполнено(Объект.Основание) Тогда
	//	ИмяКлиентаЛида = Объект.Основание.ИмяКлиента;
	//	АдресКлиентаЛида = Объект.Основание.Адрес;
	//	СуммаДоговораНаЗамере = Объект.Основание.ПоследняяСуммаДоговораНаЗамере;
	//КонецЕсли;
	ОбновитьИнформациюПоЗамеруЛида();
	//-- №11768
	
	ОбновитьДопИнформацию();
	
	Элементы.ФормаПеревестиДокументВВерсию20.Доступность = НЕ Объект.ЗаполнятьУИСтрок;
	
	ИспользоватьПодключаемоеОборудование = Константы.ИспользоватьПодключаемоеОборудование.Получить();
	
	ОбщийМодульСервер.ДобавитьИндикаторРаботыСоСканерамиШК(ЭтотОбъект);
	
	Элементы.ДопИнфоПлощадьПотолка.Заголовок = "";
	
	//#5456
	ЗаполнениеМатериаловПоЗаказам = (Объект.СлужебныйЗаполнениеМатериаловРозницы = 0);
	Элементы.ГруппаМатериалы.Видимость 			 = ЗаполнениеМатериаловПоЗаказам;
	Элементы.ДеревоТоваровСпецификация.Видимость = ЗаполнениеМатериаловПоЗаказам;
	
	//#5456
	// при переходе на 3.1 перенесено в процедуры формирования меню
	//ФлагСоздатьНаОсновании = ПолучитьФункциональнуюОпцию("ОбеспеченностьРозницыПоЗаказДоговорам");
	//Элементы.ФормаОформитьЗаказПокупателя.Видимость = ФлагСоздатьНаОсновании И ПравоДоступа("Изменение", Метаданные.Документы.ЗаказПокупателя);
	//Элементы.ФормаОформитьЗаказПоставщику.Видимость = ФлагСоздатьНаОсновании И ПравоДоступа("Изменение", Метаданные.Документы.ЗаказПоставщику);
	//Если ПравоДоступа("Изменение", Метаданные.Документы.ПоступлениеТоваровИУслуг) Тогда // проверка для типовой команды
	//	Элементы.ФормаДокументПоступлениеТоваровИУслугСоздатьНаОсновании.Видимость = ФлагСоздатьНаОсновании;
	//КонецЕсли;
	
	// Видимость колонки Артикул
	МассивЭлементов = новый Массив();
	МассивЭлементов.Добавить("ДеревоТоваровНоменклатураАртикул");
	МассивЭлементов.Добавить("ДеревоМатериаловНоменклатураАртикул");
	ОбщийМодульСервер.УстановитьВидимостьКолонкиАртикулВТабличнойЧасти(ЭтаФорма, МассивЭлементов);
	
	Если ОтключитьДоступностьГруппыПечать Тогда
		Элементы.ПодменюПечать.Доступность = Ложь;
		Элементы.ДеревоТоваров.ТолькоПросмотр = Истина;
		Элементы.ДеревоМатериалов.ТолькоПросмотр = Истина;
	КонецЕсли;
	
	УстановитьОтметкуНезаполненногоИсполнителяЗамера();
	УстановитьОтметкуНезаполненногоАдреса();
	
	ЗаполнитьСсылкиНаМонтажи(); // №9868
	
	ИспользоватьКартыЯндекс = НЕ ПустаяСтрока(Константы.КлючAPIЯндексКарты.Получить());
	Если ИспользоватьКартыЯндекс 
		ИЛИ Константы.ИспользуетсяМобильныйКлиентЗамерщика.Получить()
		ИЛИ Константы.ИспользуетсяМобильныйКлиентМонтажника.Получить()
		Тогда
		Элементы.УказатьГеометку.Видимость = Истина;
		ОбновитьКратинкуКнопкиГеометкиВШапкеДокумента();
	Иначе 
		Элементы.УказатьГеометку.Видимость = Ложь;
	КонецЕсли;
	
	ФинансыСервер.ОбновитьВидимостьИКурсВалюты(ЭтотОбъект);
	
	ВидСпецификацииПоУмолчанию = Перечисления.ВидыСпецификации.СопутствующиеМатериалы;
	
	//#13943
	Элементы.Менеджер.ТолькоПросмотр = НЕ РеквизитыПользователя.РазрешеноМенятьМенеджераВЗаказДоговоре;
	
	ДоговорДоИзменения = Объект.ДоговорКонтрагента; // №14073
	
	//#14675
	УчетОбеспеченностиРозницыПоКомнатам = Константы.УчетОбеспеченностиРозницыПоКомнатам.Получить();
	Элементы.ДеревоТоваровЗаказано.Видимость = УчетОбеспеченностиРозницыПоКомнатам;
	Элементы.ДеревоМатериаловЗаказано.Видимость = УчетОбеспеченностиРозницыПоКомнатам;
	
	ОбщийМодульСервер.УстановитьВидимостьПодразделения(ЭтотОбъект);
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	ДатыЗапретаИзменения.ОбъектПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	ОбновитьКолонкуГрафикОплатОплачено();
	
	ПриСозданииЧтенииНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ПриСозданииЧтенииНаСервере()
	
	ЭтоРекламация = (Объект.ВидЗаказа = ПредопределенноеЗначение("Справочник.ВидыЗаказДоговоров.Рекламация"));
	
	ЗаполнитьСтавкуНДСПоОрганизацииСервер();
	ИспользоватьАвтоматическиеСкидки = ПолучитьЗначениеКонстантыАвтоматическихСкидок();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	МенеджерОборудованияКлиентПереопределяемый.НачатьПодключениеОборудованиеПриОткрытииФормы(ЭтаФорма, "СканерШтрихкода");
	//мИспользоватьАвтоматическиеСкидки = ПолучитьЗначениеКонстантыАвтоматическихСкидок();
	ОбновитьОтображениеЭлементовФормы();
	РазвернутьДеревоМатериалов();
	
	//ОбновитьКолонкуГрафикОплатОплачено();
	
	Если НЕ Объект.ЗаполнятьУИСтрок Тогда
		ЭтаФорма.Заголовок = ЭтаФорма.Заголовок + " (Версия документа 1.1)";
	КонецЕсли;
	
	//Если НЕ ТолькоПросмотр Тогда // #10508  // закомментировано: перенесено в параметр функции
	РассчитатьИтоговыеПоказателиКлиент(ТолькоПросмотр);
	//КонецЕсли;
	
	//#13148
	Если RVY_ИспользоватьИнтеграцию Тогда
		RVY_ОбновитьСтатус();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	Если ЭтоРекламация Тогда
		Для Каждого СтрокаКомнаты из ДеревоТоваров.ПолучитьЭлементы() Цикл		
			Для Каждого СтрокаТовара Из СтрокаКомнаты.ПолучитьЭлементы() Цикл
				СтрокаТовара.Цена = 0;
				СтрокаТовара.ЦенаПоПрайсу = 0;
				СтрокаТовара.Сумма = 0;
				СтрокаТовара.СуммаПоПрайсу = 0;
				СтрокаТовара.ПроцентСкидки = 0;
				СтрокаТовара.СуммаСкидки = 0;
				СтрокаТовара.СуммаНДС = 0;
			КонецЦикла;
		КонецЦикла;
		РассчитатьИтоговыеПоказателиКлиент();
	КонецЕсли;

	ПеренестиДеревоВТабличнуюЧасть();
	
	Если ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
		Если НЕ ЗначениеЗаполнено(Объект.Контрагент) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не заполнено поле ""Контрагент""", , "Контрагент", "Объект", Отказ);
		КонецЕсли;
