&НаКлиенте
Процедура ВвестиОплатуРассрочки(Наличными = Истина)
	
	ТекущиеДанные = Элементы.ГрафикОплат.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТекущиеДанные.Сумма = ТекущиеДанные.Оплачено Тогда
		Предупреждение("По данной строке оплата полностью произведена. Выберите другую строку!");
		Возврат;	
	КонецЕсли;
		
	ОповещениеПослеПринятияОплаты = Новый ОписаниеОповещения("ПослеПринятияОплаты",ЭтаФорма);
		
	ПараметрыНовогоДокумента = Новый Структура;
	ПараметрыНовогоДокумента.Вставить("Основание", Объект.Ссылка);
	ПараметрыНовогоДокумента.Вставить("РассрочкаДатаПлатежа", Элементы.ГрафикОплат.ТекущиеДанные.ДатаПлатежа);
	ПараметрыНовогоДокумента.Вставить("РассрочкаСумма", Элементы.ГрафикОплат.ТекущиеДанные.Сумма - Элементы.ГрафикОплат.ТекущиеДанные.Оплачено);
	ПараметрыЗаполнения = Новый Структура("ЗначенияЗаполнения", ПараметрыНовогоДокумента);

	ИмяФормыОснования = "Документ.ПриходныйКассовыйОрдер.Форма.ФормаДокумента";
	Если НЕ Наличными Тогда
		ИмяФормыОснования = "Документ.ОплатаБанковскойКартой.Форма.ФормаДокумента";
	КонецЕсли;
	ОткрытьФорму(ИмяФормыОснования, ПараметрыЗаполнения,,,,,ОповещениеПослеПринятияОплаты);
	
КонецПроцедуры

