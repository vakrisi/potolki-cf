Процедура ОбновитьКолонкуГрафикОплатОплачено()
	//2017-06-23
	// для заполнения добавленных вручную колонок "Оплачено" и "Дата оплаты" 
	//Запрос = Новый Запрос(	
	//"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	//|	ДолгиПоРассрочкамОстаткиИОбороты.СрокПлатежа КАК СрокПлатежа,
	//|	ДолгиПоРассрочкамОстаткиИОбороты.СуммаРасход КАК Оплачено,
	//|	ДолгиПоРассрочкамОстаткиИОбороты.ПериодДень КАК ДатаОплаты
	//|ИЗ
	//|	РегистрНакопления.ДолгиПоРассрочкам.ОстаткиИОбороты(, , Авто, , ) КАК ДолгиПоРассрочкамОстаткиИОбороты
	//|ГДЕ
	//|	ДолгиПоРассрочкамОстаткиИОбороты.ЗаказДоговор В(&ЗаказДоговор)
	//|УПОРЯДОЧИТЬ ПО
	//|	СрокПлатежа
	//|");
	Запрос = Новый Запрос(	
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ДолгиПоРассрочкамОстаткиИОбороты.СрокПлатежа КАК СрокПлатежа,
	|	СУММА(ДолгиПоРассрочкамОстаткиИОбороты.СуммаРасход) КАК Оплачено,
	|	МАКСИМУМ(ДолгиПоРассрочкамОстаткиИОбороты.ПериодДень) КАК ДатаОплаты
	|ИЗ
	|	РегистрНакопления.ДолгиПоРассрочкам.ОстаткиИОбороты(, , Авто, , ) КАК ДолгиПоРассрочкамОстаткиИОбороты
	|ГДЕ
	|	ДолгиПоРассрочкамОстаткиИОбороты.ЗаказДоговор В(&ЗаказДоговор)
	|
	|СГРУППИРОВАТЬ ПО
	|	ДолгиПоРассрочкамОстаткиИОбороты.СрокПлатежа
	|
	|УПОРЯДОЧИТЬ ПО
	|	СрокПлатежа");
	Запрос.УстановитьПараметр("ЗаказДоговор", Объект.Ссылка);
	Выборка = Запрос.Выполнить().Выбрать();
	Для Каждого Стр Из Объект.ГрафикОплат Цикл
		Если Выборка.НайтиСледующий(Стр.ДатаПлатежа, "СрокПлатежа") Тогда
			Стр.Оплачено = Выборка.Оплачено;
			Стр.ДатаОплаты = Выборка.ДатаОплаты;
		Иначе
			Стр.Оплачено = 0;
			Стр.ДатаОплаты = Неопределено;
		КонецЕсли;
		Выборка.Сбросить();
	КонецЦикла;
КонецПроцедуры

