&НаСервере
Функция ПараметрыПодбора()
	
	ПараметрыПодбора = Новый Структура;
	ПараметрыПодбора.Вставить("Дата",						Объект.Дата);
	ПараметрыПодбора.Вставить("Организация",				Объект.Организация);
	ПараметрыПодбора.Вставить("ВидЦены",					Объект.ВидЦен);
	ПараметрыПодбора.Вставить("Валюта",						Объект.Валюта);
	ПараметрыПодбора.Вставить("ТипДокумента",				"ЗаказДоговор");
	ПараметрыПодбора.Вставить("ЗапретРедактированияЦен",	ЗапретРедактированияЦен());
	
	Если ПодборВМатериалы Тогда
		
		ПараметрыПодбора.Вставить("Назначение",			"Материалы");
		ПараметрыПодбора.Вставить("НеЗапрашиватьЦену",  Истина);
		ПараметрыПодбора.Вставить("Склад", 				ОбщийМодульСервер.НастройкаПользователя("СкладМатериаловРозница")); // №14875
		
	Иначе	
		
		ПараметрыПодбора.Вставить("Назначение",			"Товары");
		ПараметрыПодбора.Вставить("Склад", 				ОбщийМодульСервер.НастройкаПользователя("СкладРозница")); // №14875
		ПараметрыПодбора.Вставить("НеЗапрашиватьЦену",  ЭтоРекламация);
		//#16345
		Если ИспользоватьКонтрольКратности Тогда
			ПараметрыПодбора.Вставить("ВидДокументаПроверкиКратности",ПредопределенноеЗначение("Перечисление.ВидыДокументовПроверкиКратности.ЗаказКлиента")); 
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ПараметрыПодбора;
	
КонецФункции
	
&НаКлиенте
Процедура ЗаполнитьСтавкуНДСПоОрганизацииКлиент(ИзменятьСтавку = Истина)
	
	ЗаполнитьСтавкуНДСПоОрганизацииСервер();
	Если ИзменятьСтавку Тогда
		ЗаполнитьСтавкуНДСВДеревеТоваров(СтавкаНДСПоУмолчанию);
		РассчитатьИтоговыеПоказателиКлиент();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьСтавкуНДСВДеревеТоваров(СтавкаНДС, ПропускатьСтрокиСВыполненнымиМонтажами = Ложь)		
	
	ЕстьСтрокиСВыполненнымиМонтажами = Ложь;
	
	СтрокиКомнат = ДеревоТоваров.ПолучитьЭлементы();
	Для Каждого СтрокаКомнаты из СтрокиКомнат Цикл
		СтрокиТоваров = СтрокаКомнаты.ПолучитьЭлементы();	
		Для Каждого СтрокаТовара Из СтрокиТоваров Цикл
			
			Если ПропускатьСтрокиСВыполненнымиМонтажами
				И (СтрокаТовара.МонтажСтатус = ПредопределенноеЗначение("Справочник.РезультатыМонтажа.Выполнен")
			      ИЛИ СтрокаТовара.МонтажСтатус = ПредопределенноеЗначение("Справочник.РезультатыМонтажа.Закрыт")) Тогда
				ЕстьСтрокиСВыполненнымиМонтажами = Истина;
				Продолжить;
			КонецЕсли;
			СтрокаТовара.СтавкаНДС = СтавкаНДС;
			ОбработкаТабличныхЧастейКлиентСервер.ПересчитатьСуммуНДСВСтрокеТЧ(СтрокаТовара, УчитыватьНДС);
		КонецЦикла;
	КонецЦикла;
		
	Если ЕстьСтрокиСВыполненнымиМонтажами Тогда
		Сообщить("При изменении ставки НДС были пропущены строки с выполненными и закрытыми монтажами");
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСтавкуНДСПоОрганизацииСервер()
	
	УчитыватьНДС = УчетНДС.ОрганизацияЯвляетсяПлательщикомНДС(Объект.Организация);
	СтавкаНДСПоУмолчанию = УчетНДС.СтавкаНДСПоУмолчанию(Объект.Организация);
	
	Элементы.ДеревоТоваровСтавкаНДС.Видимость 	= УчитыватьНДС;
	Элементы.ДеревоТоваровСуммаНДС.Видимость 	= УчитыватьНДС;
	Элементы.СтавкаНДС.Видимость 				= УчитыватьНДС;
	
КонецПроцедуры

&НаКлиенте
Процедура RVY_ОбновитьСтатус()
	
	RVY_СостояниеДокумента = RVY_ОбщийМодульВызовСервера.ПолучитьСостояниеДокумента(Объект.Ссылка);
	
	Если RVY_СостояниеДокумента.Состояние = 0 Тогда
		Элементы.RVY_Отправить.Картинка = БиблиотекаКартинок.RVY_Логотип;
	ИначеЕсли RVY_СостояниеДокумента.Состояние = 1 Тогда
		Элементы.RVY_Отправить.Картинка = БиблиотекаКартинок.RVY_Подготовлено;
	ИначеЕсли RVY_СостояниеДокумента.Состояние = 2 Тогда
		Элементы.RVY_Отправить.Картинка = БиблиотекаКартинок.RVY_Отправлено;
	КонецЕсли;
	
КонецПроцедуры

