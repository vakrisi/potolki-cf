Процедура ОчиститьДатуСледующегоКонтакта(Команда)
	
	Если ЗначениеЗаполнено(Объект.ПоследняяДатаСледующегоКонтакта) Тогда
		
		Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
			ПоказатьПредупреждение(, "Заказ должен быть записан!");
			Возврат;
		КонецЕсли;
		
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("ОчисткаДаты", Истина);
		ПараметрыФормы.Вставить("Комментарий", "Отмена даты следующего контакта: ");
		ОписаниеОповещения = Новый ОписаниеОповещения("ИзменениеДатыСледующегоКонтактаЗавершение", ЭтотОбъект);
		ОткрытьФорму("Документ.ЗаказДоговор.Форма.ФормаДобавленияЗаписиИстории", ПараметрыФормы, ЭтаФорма, , , , ОписаниеОповещения);
		
	Иначе
		Сообщить("Дата следующего контакта не заполнена");
	КонецЕсли;
	
КонецПроцедуры

