Процедура ОбновитьИнформациюПоЗамеруЛида()
	
	ДатаЗамера 			= Дата(1, 1, 1);
	ВремяНачалаЗамера 	= Дата(1, 1, 1);
	РезультатЗамера 	= Справочники.РезультатЗамераЛида.ПустаяСсылка();
	
	Если ЗначениеЗаполнено(Объект.ИдентификаторЗамера) И ТипЗнч(Объект.Основание) = Тип("ДокументСсылка.Лид") И ЗначениеЗаполнено(Объект.Основание) Тогда
		
		НайденнаяСтрока = Объект.Основание.Замеры.НайтиСтроки(новый Структура("ИДЗамера", Объект.ИдентификаторЗамера));
		Если НайденнаяСтрока.Количество() > 0 Тогда
			
			ДатаЗамера 			= НайденнаяСтрока[0].ДатаЗамера;
			ВремяНачалаЗамера 	= НайденнаяСтрока[0].ВремяНачалаЗамера;
			РезультатЗамера 	= НайденнаяСтрока[0].РезультатЗамера;
			
		КонецЕсли;
		
		//++ #15107 от 28.11.2022
		Если Параметры.Ключ.Пустая() Тогда
			Объект.ОжидаемаяДатаОтгрузки = Объект.Основание.ПредполагаемыйМонтажДата;
			Объект.ОжидаемоеВремяОтгрузки = Объект.Основание.ПредполагаемыйМонтажВремя;
		КонецЕсли;
		//-- #15107 от 28.11.2022
		
	КонецЕсли;
	
	Элементы.ИсполнительЗамера.ТолькоПросмотр = (ЗначениеЗаполнено(Объект.ИдентификаторЗамера));
	
КонецПроцедуры
