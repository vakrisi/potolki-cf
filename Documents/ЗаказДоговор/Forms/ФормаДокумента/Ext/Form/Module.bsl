&НаКлиенте
Процедура ПеревестиЗаказВСтатусВыполнен() 	
	
	ТекущаяКомната = Неопределено;
	ТекущаяНоменклатура = Неопределено;
	Если НЕ Элементы.ДеревоТоваров.ТекущиеДанные = Неопределено Тогда
		Если ТекущаяКомната = Неопределено Тогда
			ТекущаяКомната = Элементы.ДеревоТоваров.ТекущиеДанные.Комната;
		КонецЕсли;
		Если ТекущаяНоменклатура = Неопределено Тогда
			ТекущаяНоменклатура = Элементы.ДеревоТоваров.ТекущиеДанные.Номенклатура;
		КонецЕсли;
	КонецЕсли;
	
	Объект.ТекущийСтатус = ПредопределенноеЗначение("Справочник.СтатусыЗаказДоговоров.Выполнен");
	ЭтотОбъект.Записать();
	
	ПерестроитьДеревоНаФорме();
	ЗаполнитьДанныеКОтгрузкеИОстаткиПоТоварам();
	РазвернутьДеревоТоваров(ТекущаяКомната, ТекущаяНоменклатура);

КонецПроцедуры

&НаКлиенте
Процедура ПеревестиЗаказВСтатусРасторгнут(ДокументСОРД) 	
	
	ТекущаяКомната = Неопределено;
	ТекущаяНоменклатура = Неопределено;
	Если НЕ Элементы.ДеревоТоваров.ТекущиеДанные = Неопределено Тогда
		Если ТекущаяКомната = Неопределено Тогда
			ТекущаяКомната = Элементы.ДеревоТоваров.ТекущиеДанные.Комната;
		КонецЕсли;
		Если ТекущаяНоменклатура = Неопределено Тогда
			ТекущаяНоменклатура = Элементы.ДеревоТоваров.ТекущиеДанные.Номенклатура;
		КонецЕсли;
	КонецЕсли;
	
	СоглашениеОРасторженииДоговора = ДокументСОРД;
	Объект.ТекущийСтатус = ПредопределенноеЗначение("Справочник.СтатусыЗаказДоговоров.Отменен");
	ЭтотОбъект.Записать();
	ТолькоПросмотр = Истина;
			
	ПерестроитьДеревоНаФорме();
	ЗаполнитьДанныеКОтгрузкеИОстаткиПоТоварам();
	РазвернутьДеревоТоваров(ТекущаяКомната, ТекущаяНоменклатура);

КонецПроцедуры

&НаСервере
Процедура ОбработкаДобавленияПрофиляСервер(МассивМатериалов)
	
	Дерево = ДанныеФормыВЗначение(ДеревоМатериалов, Тип("ДеревоЗначений"));
	Для каждого ЭлементМассива из МассивМатериалов Цикл
		ДобавленоПоКомнате = Ложь;
			
		Для Каждого Строка из Дерево.Строки Цикл
			Если НЕ ДобавленоПоКомнате И Строка.Комната = ЭлементМассива.Комната Тогда
				Стр = Строка.Строки.Добавить();
				Стр.Номенклатура = ЭлементМассива.Номенклатура;
				Стр.Комната = ЭлементМассива.Комната;
				Стр.Количество = ЭлементМассива.Количество;
				
				Стр.ЕдиницаИзмерения = ПолучитьБазовуюЕдиницуИзмеренияНоменклатуры(Стр.Номенклатура);
				Стр.Коэффициент = 1;
				
				Стр.УИСтроки = Новый УникальныйИдентификатор;
				ДобавленоПоКомнате = Истина;					
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	ЗначениеВДанныеФормы(Дерево, ДеревоМатериалов);
	
КонецПроцедуры

&НаСервере
Процедура ПерезаполнитьСтавкуНДСВТабличнойЧастиДокумента()
	
	ЕстьСтрокиСВыполненнымиМонтажами = Ложь;
	
	Дерево = ДанныеФормыВЗначение(ДеревоТоваров, Тип("ДеревоЗначений"));
	Для Каждого Строка из Дерево.Строки Цикл
		Для Каждого СтрНоменклатура из Строка.Строки Цикл
			Если СтрНоменклатура.МонтажСтатус = Справочники.РезультатыМонтажа.Выполнен или СтрНоменклатура.МонтажСтатус = Справочники.РезультатыМонтажа.Закрыт Тогда
				ЕстьСтрокиСВыполненнымиМонтажами = Истина;
			Иначе
				СтрНоменклатура.СтавкаНДС = Объект.СтавкаНДС;
				СтрНоменклатура.СуммаНДС = УчетНДС.РассчитатьСуммуНДС(СтрНоменклатура.Сумма, УчитыватьНДС, , УчетНДС.ПолучитьСтавкуНДС(СтрНоменклатура.СтавкаНДС));
			КонецЕсли;
		КонецЦикла;	
	КонецЦикла;
	ЗначениеВДанныеФормы(Дерево, ДеревоТоваров);
	ПеренестиДеревоВТабличнуюЧасть();
	
	Если ЕстьСтрокиСВыполненнымиМонтажами Тогда
		Сообщить("При изменении ставки НДС были пропущены строки с выполненными и закрытыми монтажами");
	КонецЕсли;

КонецПроцедуры

