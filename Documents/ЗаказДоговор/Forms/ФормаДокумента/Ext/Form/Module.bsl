	РазвернутьДеревоТоваров();
	РазвернутьДеревоМатериалов();
	
	Если НЕ Элементы.ДеревоТоваров.ТекущиеДанные = Неопределено Тогда 
		ТекущаяКомната = Элементы.ДеревоТоваров.ТекущиеДанные.Комната;
		ТекущаяНоменклатура = Элементы.ДеревоТоваров.ТекущиеДанные.Номенклатура;
		ОбновитьОтображениеЭлементовФормы(ТекущаяКомната, ТекущаяНоменклатура);
	Иначе 
		ОбновитьОтображениеЭлементовФормы();
	КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(ИсторияЗаказа, "Заказ", Объект.Ссылка, , , Истина, РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный);
	Элементы.ИсторияЗаказа.Обновить();
	
	// №5574 занести запись о соответствии в регистр
	ЗанестиЗаписьОСоответствииЗаказДоговору();
	
	Если ЕстьИзмененияВТЧ Тогда
		Оповестить("ОбновлениеТЧТоварыИУслугиЗаказДоговора",,Объект.Ссылка);
	КонецЕсли;
	
	Если ЭтоНовый Тогда		
		Если Объект.Ссылка.Пустая() Тогда 
			Оповестить("ЗаказДоговорНеСоздан",НомерЛида);
		Иначе
			Оповестить("ЗаказДоговорСоздан",НомерЛида);
		КонецЕсли;
		ЭтоНовый = Ложь;
	КонецЕсли;
	Оповестить("ЗакрытаФормаЗаказДоговора",,"ЗаказДоговор");

КонецПроцедуры

&НаСервере
Процедура ЗанестиЗаписьОСоответствииЗаказДоговору()
	
	ПолностьюСоответствуют = Истина;
	МассивМонтажейНеСоответствуют = новый Массив;
		
	//++16703
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Монтажи.Ссылка КАК Монтаж
	|ИЗ
	|	Документ.Монтаж КАК Монтажи
	|ГДЕ
	|	Монтажи.Основание = &ЗаказДоговор
	|	И НЕ Монтажи.Результат = ЗНАЧЕНИЕ(Справочник.РезультатыМонтажа.Отменен)
	|	И НЕ Монтажи.ПометкаУдаления";
	Запрос.УстановитьПараметр("ЗаказДоговор", Объект.Ссылка);
	ВыборкаМонтажи = Запрос.Выполнить().Выбрать();
	
	Если ВыборкаМонтажи.Количество() >  0 Тогда
		Пока ВыборкаМонтажи.Следующий() Цикл	
			МонтажОбъект = ВыборкаМонтажи.Монтаж.ПолучитьОбъект();
			Если Объект.ВидЗаказа = Справочники.ВидыЗаказДоговоров.Договор и НЕ (МонтажОбъект.ВидОперации = Справочники.ВидыМонтажа.Монтаж  ИЛИ МонтажОбъект.ВидОперации = Справочники.ВидыМонтажа.Продажа) Тогда
				ПолностьюСоответствуют = Ложь;
				МассивМонтажейНеСоответствуют.Добавить(ВыборкаМонтажи.Монтаж);
			КонецЕсли;
			Если Объект.ВидЗаказа = Справочники.ВидыЗаказДоговоров.Продажа и НЕ МонтажОбъект.ВидОперации = Справочники.ВидыМонтажа.Продажа Тогда
				ПолностьюСоответствуют = Ложь;
				МассивМонтажейНеСоответствуют.Добавить(ВыборкаМонтажи.Монтаж);
			КонецЕсли;
			Если Объект.ВидЗаказа = Справочники.ВидыЗаказДоговоров.Рекламация и НЕ (МонтажОбъект.ВидОперации = Справочники.ВидыМонтажа.Рекламация  ИЛИ МонтажОбъект.ВидОперации = Справочники.ВидыМонтажа.Продажа) Тогда
				ПолностьюСоответствуют = Ложь;
				МассивМонтажейНеСоответствуют.Добавить(ВыборкаМонтажи.Монтаж);
			КонецЕсли;
			Если Объект.ВидЗаказа = Справочники.ВидыЗаказДоговоров.СервиснаяЗаявка и НЕ (МонтажОбъект.ВидОперации = Справочники.ВидыМонтажа.СервиснаяЗаявка ИЛИ МонтажОбъект.ВидОперации = Справочники.ВидыМонтажа.Продажа) Тогда
				ПолностьюСоответствуют = Ложь;
				МассивМонтажейНеСоответствуют.Добавить(ВыборкаМонтажи.Монтаж);
			КонецЕсли;
		КонецЦикла;	
	КонецЕсли;
	//--16703
	
	// Получим данные монтажей для сверки
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТоварыУслугиМонтажа.Ссылка,
	|	ТоварыУслугиМонтажа.УИСтроки,
	|	ТоварыУслугиМонтажа.Комната,
	|	ТоварыУслугиМонтажа.Номенклатура,
	|	ТоварыУслугиМонтажа.ХарактеристикаНоменклатуры,
	|	ТоварыУслугиМонтажа.Цена,
	|	ТоварыУслугиМонтажа.ПроцентСкидки,
	|	СУММА(ТоварыУслугиМонтажа.Количество * ТоварыУслугиМонтажа.Коэффициент) КАК Количество,
	|	СУММА(ТоварыУслугиМонтажа.Сумма) КАК Сумма,
	|	СУММА(ТоварыУслугиМонтажа.СуммаСкидки) КАК СуммаСкидки
	|ИЗ
	|	Документ.Монтаж.ТоварыУслуги КАК ТоварыУслугиМонтажа
	|ГДЕ
	|	ТоварыУслугиМонтажа.Ссылка.Основание = &ЗаказДоговор
	|	И НЕ ТоварыУслугиМонтажа.Ссылка.Результат = ЗНАЧЕНИЕ(Справочник.РезультатыМонтажа.Отменен)
	|	И НЕ ТоварыУслугиМонтажа.Ссылка.ПометкаУдаления
	// #12246
	//|	И ТоварыУслугиМонтажа.Ссылка.ВидОперации = ЗНАЧЕНИЕ(Справочник.ВидыМонтажа.Монтаж) //#БезЗаявки. теперь сверяем для всех видов
	|
	|СГРУППИРОВАТЬ ПО
	|	ТоварыУслугиМонтажа.Ссылка,
	|	ТоварыУслугиМонтажа.УИСтроки,
	|	ТоварыУслугиМонтажа.Комната,
	|	ТоварыУслугиМонтажа.Номенклатура,
	|	ТоварыУслугиМонтажа.ХарактеристикаНоменклатуры,
	|	ТоварыУслугиМонтажа.Цена,
	|	ТоварыУслугиМонтажа.ПроцентСкидки
	|
	|ИТОГИ ПО ТоварыУслугиМонтажа.Ссылка";
	Запрос.УстановитьПараметр("ЗаказДоговор", Объект.Ссылка);
	ВыборкаМонтажи = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам, "Ссылка");
	
	// Если есть монтажи, подготовим позиции ЗД для сверки
	Если ВыборкаМонтажи.Количество() > 0 Тогда
		
		ТаблицаТоваровИУслуг = Новый ТаблицаЗначений;
		ТаблицаТоваровИУслуг.Колонки.Добавить("УИСтроки");
		ТаблицаТоваровИУслуг.Колонки.Добавить("Комната");
		ТаблицаТоваровИУслуг.Колонки.Добавить("Номенклатура");
		ТаблицаТоваровИУслуг.Колонки.Добавить("Количество");
		ТаблицаТоваровИУслуг.Колонки.Добавить("Сумма");
		ТаблицаТоваровИУслуг.Колонки.Добавить("Цена");
		ТаблицаТоваровИУслуг.Колонки.Добавить("ПроцентСкидки");
		ТаблицаТоваровИУслуг.Колонки.Добавить("СуммаСкидки");
		ТаблицаТоваровИУслуг.Колонки.Добавить("ХарактеристикаНоменклатуры");
		
		ВремДеревоТоваров = РеквизитФормыВЗначение("ДеревоТоваров");
		Для Каждого СтрокаКомнаты Из ВремДеревоТоваров.Строки Цикл
			Для Каждого СтрокаНоменклатуры Из СтрокаКомнаты.Строки Цикл
				НоваяСтрока = ТаблицаТоваровИУслуг.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаНоменклатуры);
				НоваяСтрока.Количество = СтрокаНоменклатуры.Количество * СтрокаНоменклатуры.Коэффициент;
			КонецЦикла;
		КонецЦикла;
		
		ТаблицаТоваровИУслуг.Свернуть("УИСтроки, Комната, Номенклатура, Цена, ПроцентСкидки, ХарактеристикаНоменклатуры", "Количество, Сумма, СуммаСкидки");
		ТаблицаТоваровИУслуг.Колонки.Добавить("Разобран", Новый ОписаниеТипов("Булево"));
		
	КонецЕсли;	
	
	// Сверяем по монтажам
	Пока ВыборкаМонтажи.Следующий() Цикл
		
		ВыборкаПозицийМонтажа = ВыборкаМонтажи.Выбрать();
		
		Пока ВыборкаПозицийМонтажа.Следующий() Цикл
			Отбор = Новый Структура;
			Отбор.Вставить("УИСтроки", ВыборкаПозицийМонтажа.УИСтроки);
			Отбор.Вставить("Комната", ВыборкаПозицийМонтажа.Комната);
			Отбор.Вставить("Номенклатура", ВыборкаПозицийМонтажа.Номенклатура);
			Отбор.Вставить("Цена", ВыборкаПозицийМонтажа.Цена);
			Отбор.Вставить("ПроцентСкидки", ВыборкаПозицийМонтажа.ПроцентСкидки);
			Отбор.Вставить("ХарактеристикаНоменклатуры", ВыборкаПозицийМонтажа.ХарактеристикаНоменклатуры);
			Отбор.Вставить("Количество", ВыборкаПозицийМонтажа.Количество);
			Отбор.Вставить("Сумма", ВыборкаПозицийМонтажа.Сумма);
			Отбор.Вставить("СуммаСкидки", ВыборкаПозицийМонтажа.СуммаСкидки);
			Отбор.Вставить("Разобран", Ложь);
			НайденныеСтроки = ТаблицаТоваровИУслуг.НайтиСтроки(Отбор);
			Если НайденныеСтроки.Количество() = 0 тогда
				МассивМонтажейНеСоответствуют.Добавить(ВыборкаМонтажи.Ссылка);
				ПолностьюСоответствуют = Ложь;
				Прервать;
			Иначе
				НайденныеСтроки[0].Разобран = Истина;
			КонецЕсли;
		КонецЦикла;
		
	КонецЦикла;
	
	// если не соответствует Монтажам, нужно записать в регистр
	// если соответствует, удалить записи из регистра
	УстановитьПривилегированныйРежим(Истина);
	
	НаборЗаписей = РегистрыСведений.СоответствиеДоговораИМонтажей.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.ЗаказДоговор.Установить(Объект.Ссылка);
	НаборЗаписей.Прочитать();
	НаборЗаписей.Очистить();
	
	// Соответствует
	Если ПолностьюСоответствуют Тогда			
		
		// Очищаем записи по ЗД
		НаборЗаписей.Записать();
		
	Иначе // Не соответствует
		
		Для Каждого ТекущаяМонтаж Из МассивМонтажейНеСоответствуют Цикл
			
			НоваяЗапись = НаборЗаписей.Добавить();
			НоваяЗапись.ЗаказДоговор = Объект.Ссылка;
			НоваяЗапись.Монтаж = ТекущаяМонтаж;			
						
		КонецЦикла;
		
		НаборЗаписей.Записать();
		
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Ложь);
		
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	УстановитьЗаголовокФормы();
	
	Элементы.ПодменюПечать.Доступность = ПраваПользователей.ДоступностьПечати(Объект.Ссылка);
	Если Объект.Проведен Тогда
		//ЭтаФорма.ИспользоватьРежимПроведения=ИспользованиеРежимаПроведения.Неоперативный;
		ПроверитьСоответствиеМонтажей();
	КонецЕсли;
	
	ОбновитьКолонкуГрафикОплатОплачено();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)
	
	Если ЗавершениеРаботы Тогда
		Возврат;
	КонецЕсли;
		
	//++ №11171 разблокировка объекта, если не завершение работы
	РазблокироватьОбъект(Объект.Ссылка, ЭтаФорма.УникальныйИдентификатор); 
		
	МенеджерОборудованияКлиентПереопределяемый.НачатьОтключениеОборудованиеПриЗакрытииФормы(ЭтаФорма);
	
	//#9067 - перенесено в ПослеЗаписи
	//Если ЭтоНовый Тогда		
	//	Если Объект.Ссылка.Пустая() Тогда 
	//		Оповестить("ЗаказДоговорНеСоздан",НомерЛида);
	//	Иначе
	//		Оповестить("ЗаказДоговорСоздан",НомерЛида);
	//	КонецЕсли;
	//	ЭтоНовый = Ложь;
	//КонецЕсли;
	//Оповестить("ЗакрытаФормаЗаказДоговора",,"ЗаказДоговор");
	
	Если ЗначениеЗаполнено(Объект.Ссылка)
		И ЗначениеЗаполнено(Объект.Основание)
		И ТипЗнч(Объект.Основание) = Тип("ДокументСсылка.Лид") 
		И Объект.Проведен Тогда
		Оповестить("ЗакрытаФормаЗаказДоговора", Объект.Основание, Новый Структура("Номер, Дата, Вид", Объект.Номер, Объект.Дата, Объект.ВидЗаказа));
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	
	Если ИсточникВыбора.ИмяФормы = "ОбщаяФорма.ФормаДобавленияПрофиля" Тогда	
		ОбработкаДобавленияПрофиляСервер(ВыбранноеЗначение);	
		ПеренестиДеревоВТабличнуюЧасть();
		РазвернутьДеревоМатериалов();
		
	ИначеЕсли ТипЗнч(ВыбранноеЗначение) = Тип("СправочникСсылка.Контрагенты") Тогда
		Объект.Контрагент = ВыбранноеЗначение;
		КонтрагентПриИзменении(Неопределено);
	
	ИначеЕсли ИсточникВыбора.ИмяФормы = "ОбщаяФорма.ФормаПодбораНоменклатуры" Тогда	
		Если НЕ ПодборВМатериалы Тогда
			ОбработкаВыбораПодборНаКлиенте(ВыбранноеЗначение, "Подбор");
		Иначе
			ПодборВМатериалы = Ложь;
			ОбработкаВыбораПодборМатериаловНаКлиенте(ВыбранноеЗначение);
		КонецЕсли;
	
	ИначеЕсли ИсточникВыбора.ИмяФормы = "Справочник.ШаблоныКомнатДляЗаказДоговора.Форма.ФормаПодбора" Тогда		 
		ОповещениеЗаполнитьКомнатуПоШаблонуЗавершение = Новый ОписаниеОповещения("ЗаполнитьКомнатуПоШаблонуЗавершение", ЭтотОбъект);
		ОбщийМодульКлиент.Розница_ОбработкаВыбораЗаполненияПоШаблону(ЭтотОбъект, ОповещениеЗаполнитьКомнатуПоШаблонуЗавершение, ВыбранноеЗначение);
		
	// #10992
	ИначеЕсли ИсточникВыбора.ИмяФормы = "Справочник.НазваниеКомнат.Форма.ФормаВыбора" И ТипЗнч(ВыбранноеЗначение) = Тип("Структура") Тогда
		ОбщийМодульКлиент.Розница_ДобавитьКомнатуЗавершение(Новый Структура("Форма", ЭтаФорма), ВыбранноеЗначение);
		
	ИначеЕсли ИсточникВыбора.ИмяФормы = "РегистрСведений.СопутствующиеТоварыИУслуги.Форма.ФормаПодбора" Тогда	
		
		//Удаляем сопутствующие товары для текущей номенклатуры без подтверждения
		МассивСопутствующихТоваровНаУдаление = ОбщийМодульКлиент.ПолучитьСвязанныеСопутствующиеТоварыПоВыделеннымСтрокам(Элементы.ДеревоТоваров, ДеревоТоваров);
		ОбщийМодульКлиент.УдалитьСопутствующиеТовары(ДеревоТоваров, МассивСопутствующихТоваровНаУдаление);
	
		ОбработкаВыбораПодборНаКлиенте(ВыбранноеЗначение, "ДобавлениеСопутки", Ложь, Истина);

	КонецЕсли;
	
	Если Окно <> Неопределено Тогда
		Окно.Активизировать();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)	
		
	Если ИмяСобытия = "ОповеститьПриИзмененииВерсииДокумента" Тогда
		ПерестроитьДеревоНаФорме();
	ИначеЕсли ИмяСобытия = "ЗаписьМонтажа" и ТипЗнч(Источник) = Тип("ДокументСсылка.Монтаж") И Параметр = Объект.Ссылка Тогда
		
		ТекущаяКомната = Неопределено;
		ТекущаяНоменклатура = Неопределено;
		Если НЕ Элементы.ДеревоТоваров.ТекущиеДанные = Неопределено Тогда
			Если ТекущаяКомната = Неопределено Тогда
				ТекущаяКомната = Элементы.ДеревоТоваров.ТекущиеДанные.Комната;
			КонецЕсли;
			Если ТекущаяНоменклатура = Неопределено Тогда
				ТекущаяНоменклатура = Элементы.ДеревоТоваров.ТекущиеДанные.Номенклатура;
			КонецЕсли;
		КонецЕсли;
		
		//ПерестроитьДеревоНаФорме();
		ЗаполнитьДанныеКОтгрузкеИОстаткиПоТоварам();
		РазвернутьДеревоТоваров(ТекущаяКомната, ТекущаяНоменклатура);
		
		ПроверитьСоответствиеМонтажей();
		ОбновитьОтображениеЭлементовФормы(ТекущаяКомната, ТекущаяНоменклатура);
		
		ЗаполнитьСсылкиНаМонтажи(); // №9868
		
	ИначеЕсли ИмяСобытия = "Запись_ЗаказПокупателя" И Параметр = Объект.Ссылка Тогда
		
		ЗаполнитьДанныеКОтгрузкеИОстаткиПоТоварам();
		РазвернутьДеревоТоваров(ТекущаяКомната, ТекущаяНоменклатура);
		
	ИначеЕсли ИмяСобытия = "ЗаписанЗаказПоставщику" И Параметр = Объект.Ссылка
		ИЛИ ИмяСобытия = "ЗаписанПоступлениеТоваровИУслуг" И Параметр = Объект.Ссылка
		Тогда
		ПолучитьВсеПодчиненныеДокументыПоПотолкам();
		
	ИначеЕсли ИмяСобытия = "ЗаказПокупателяСоздатьНаОснованииДокументаРозницыЗавершение" И Источник = Объект.Ссылка Тогда
		ЗаказПокупателяСоздатьНаОснованииДокументаРозницыЗавершение(Параметр);
		
	ИначеЕсли ИмяСобытия = "ЗаписьДокументаОбеспеченияРозницы" И Параметр = Объект.Ссылка Тогда
		
		ТекущаяКомната = Неопределено;
		ТекущаяНоменклатура = Неопределено;
		Если НЕ Элементы.ДеревоТоваров.ТекущиеДанные = Неопределено Тогда
			Если ТекущаяКомната = Неопределено Тогда
				ТекущаяКомната = Элементы.ДеревоТоваров.ТекущиеДанные.Комната;
			КонецЕсли;
			Если ТекущаяНоменклатура = Неопределено Тогда
				ТекущаяНоменклатура = Элементы.ДеревоТоваров.ТекущиеДанные.Номенклатура;
			КонецЕсли;
		КонецЕсли;
		
		ТекущаяКомнатаМатериалы = Неопределено;
		ТекущаяНоменклатураМатериалы = Неопределено;
		Если НЕ Элементы.ДеревоМатериалов.ТекущиеДанные = Неопределено Тогда
			Если ТекущаяКомнатаМатериалы = Неопределено Тогда
				ТекущаяКомнатаМатериалы = Элементы.ДеревоМатериалов.ТекущиеДанные.Комната;
			КонецЕсли;
			Если ТекущаяНоменклатураМатериалы = Неопределено Тогда
				ТекущаяНоменклатураМатериалы = Элементы.ДеревоМатериалов.ТекущиеДанные.Номенклатура;
			КонецЕсли;
		КонецЕсли;
		
		//ПерестроитьДеревоНаФорме();
		ЗаполнитьДанныеКОтгрузкеИОстаткиПоТоварам();
		РазвернутьДеревоТоваров(ТекущаяКомната, ТекущаяНоменклатура);
		
		ЗаполнитьВычисляемыеДанныеПоМатериалам();
		РазвернутьДеревоМатериалов(ТекущаяКомнатаМатериалы, ТекущаяНоменклатураМатериалы);

	ИначеЕсли Источник = "ПодключаемоеОборудование" И ИмяСобытия = "ScanData" И ВводДоступен() И НЕ ЭтаФорма.ТолькоПросмотр Тогда		
		ОбработатьШтрихкод(Параметр);
		
	ИначеЕсли ИмяСобытия = "ЗакрытиеЗаказДоговораОтЦентраСобытий" 
		И Параметр = Объект.Ссылка
		И Объект.ТекущийСтатус = ПредопределенноеЗначение("Справочник.СтатусыЗаказДоговоров.ВРаботе") Тогда
		ПеревестиЗаказВСтатусВыполнен();
		Оповестить("ОбновитьАРМРозницы",,"ЗаказДоговор");
		
	ИначеЕсли ИмяСобытия = "ОбновитьСписокФайлов" Тогда
		ОбновитьСписокФайлов();
		
	ИначеЕсли ИмяСобытия = "РасторжениеЗаказДоговораОтЦентраСобытий" 
		И Параметр = Объект.Ссылка
		И НЕ Объект.ТекущийСтатус = ПредопределенноеЗначение("Справочник.СтатусыЗаказДоговоров.Отменен") Тогда
		// Параметр - Ссылка на заказ
		// Источник - СОРД
		ПеревестиЗаказВСтатусРасторгнут(Источник);
		
	//#13148
	ИначеЕсли ИмяСобытия = "ОтправитьДокументВRevvy" 
		И Параметр = Объект.Ссылка Тогда
		RVY_ОбновитьСтатус();
	КонецЕсли;	
	
	// СтандартныеПодсистемы.УчетОригиналовПервичныхДокументов
	УчетОригиналовПервичныхДокументовКлиент.ОбработчикОповещенияФормаДокумента(ИмяСобытия, ЭтотОбъект);
	// Конец СтандартныеПодсистемы.УчетОригиналовПервичныхДокументов

КонецПроцедуры

