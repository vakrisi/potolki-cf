		//КоличествоМонтажах
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("Основание", ТекущийЗаказ);
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СУММА(МонтажТоварыУслуги.Количество) КАК Количество,
		|	МонтажТоварыУслуги.УИСтроки КАК УИСтроки,
		|	""Товары"" КАК Назначение
		|ИЗ
		|	Документ.Монтаж.ТоварыУслуги КАК МонтажТоварыУслуги
		|ГДЕ
		|	МонтажТоварыУслуги.Ссылка.Проведен
		|	И МонтажТоварыУслуги.Ссылка.Основание = &Основание
		|	И МонтажТоварыУслуги.УИСтроки <> """"
		|
		|СГРУППИРОВАТЬ ПО
		|	МонтажТоварыУслуги.УИСтроки";
		
		ТаблицаИспользованияВДругихМонтажах = Запрос.Выполнить().Выгрузить();
		
		Для Каждого ТекущаяНоменклатура Из ТаблицаТоваров Цикл
			Отбор = Новый Структура;
			Отбор.Вставить("УИСтроки", ТекущаяНоменклатура.УИСтроки);
			Отбор.Вставить("Назначение","Товары");
			НайденныеСтроки = ТаблицаИспользованияВДругихМонтажах.НайтиСтроки(Отбор);
			Если НайденныеСтроки.Количество() > 0 Тогда
				ТекущаяНоменклатура.КоличествоВМонтажах = НайденныеСтроки[0].Количество;				
			Иначе
				ТекущаяНоменклатура.КоличествоВМонтажах = 0;
			КонецЕсли;
		КонецЦикла;
		
		
	КонецЕсли; //Если ЗначениеЗаполнено(ТекущийЗаказ) Тогда
		
	//ЗначениеВДанныеФормы(Дерево, ДеревоТоваров);
	
	Возврат ОбщегоНазначения.ТаблицаЗначенийВМассив(ТаблицаТоваров);

КонецФункции

&НаСервере
Процедура ЗаполнитьВычисляемыеДанныеПоМатериалам()
			
	Дерево = ДанныеФормыВЗначение(ДеревоМатериалов, Тип("ДеревоЗначений"));
	
	//НАЧАЛО Переход на 2.0 R2
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ЗаказДоговор", Объект.Ссылка);
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ОбеспечениеЗаказовРозницы.Комната КАК Комната,
	|	ОбеспечениеЗаказовРозницы.Номенклатура КАК Номенклатура,
	|	ОбеспечениеЗаказовРозницы.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	|	СУММА(ОбеспечениеЗаказовРозницы.КоличествоПоФакту) КАК Заказано
	|ИЗ
	|	РегистрНакопления.ОбеспечениеЗаказовРозницы КАК ОбеспечениеЗаказовРозницы
	|ГДЕ
	|	ОбеспечениеЗаказовРозницы.Заказ = &ЗаказДоговор
	|	И ОбеспечениеЗаказовРозницы.Назначение = ""Материалы""
	|
	|СГРУППИРОВАТЬ ПО
	|	ОбеспечениеЗаказовРозницы.Комната,
	|	ОбеспечениеЗаказовРозницы.Номенклатура,
	|	ОбеспечениеЗаказовРозницы.ХарактеристикаНоменклатуры";
	
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	Если РезультатЗапроса.Количество() > 0 Тогда
		Для Каждого ТекущаяСтрокаКомната Из Дерево.Строки Цикл
			Для Каждого ТекущаяСтрока Из ТекущаяСтрокаКомната.Строки Цикл
				Отбор = Новый Структура;
				Отбор.Вставить("Комната",ТекущаяСтрока.Комната);
				Отбор.Вставить("Номенклатура",ТекущаяСтрока.Номенклатура);
				Отбор.Вставить("ХарактеристикаНоменклатуры",ТекущаяСтрока.ХарактеристикаНоменклатуры);
				НайденныеСтроки = РезультатЗапроса.НайтиСтроки(Отбор);
				Если НайденныеСтроки.Количество() > 0 Тогда
					ЗаполнитьЗначенияСвойств(ТекущаяСтрока, НайденныеСтроки[0],	"Заказано");			
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;	
	//КОНЕЦ  Переход на 2.0 R2	
	
	//КоличествоМонтажах
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Основание", Объект.Ссылка);
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СУММА(МонтажМатериалы.Количество) КАК Количество,
	|	МонтажМатериалы.Номенклатура КАК Номенклатура,
	|	МонтажМатериалы.УИСтроки КАК УИСтроки,
	|	""Материалы"" КАК Назначение
	|ИЗ
	|	Документ.Монтаж.Материалы КАК МонтажМатериалы
	|ГДЕ
	|	МонтажМатериалы.Ссылка.Проведен
	|	И МонтажМатериалы.Ссылка.Основание = &Основание
	|	И МонтажМатериалы.УИСтроки <> """"
	|
	|СГРУППИРОВАТЬ ПО
	|	МонтажМатериалы.Номенклатура, 
	|	МонтажМатериалы.УИСтроки";
	
	ТаблицаИспользованияВДругихМонтажах = Запрос.Выполнить().Выгрузить();
	
	Для Каждого ТекущаяКомната Из Дерево.Строки Цикл
		Если ТекущаяКомната.Номенклатура = Неопределено Или ТекущаяКомната.Номенклатура.Пустая() Тогда
			Для Каждого ТекущаяНоменклатура Из ТекущаяКомната.Строки Цикл
				Отбор = Новый Структура;
				Отбор.Вставить("УИСтроки", ТекущаяНоменклатура.УИСтроки);
				Отбор.Вставить("Номенклатура",ТекущаяНоменклатура.Номенклатура);
				Отбор.Вставить("Назначение","Материалы");
				НайденныеСтроки = ТаблицаИспользованияВДругихМонтажах.НайтиСтроки(Отбор);
				Если НайденныеСтроки.Количество() > 0 Тогда
					ТекущаяНоменклатура.КоличествоВМонтажах = НайденныеСтроки[0].Количество;				
				Иначе
					ТекущаяНоменклатура.КоличествоВМонтажах = 0;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	
	ЗначениеВДанныеФормы(Дерево, ДеревоМатериалов);

КонецПроцедуры

&НаСервере
Функция УстановитьВидЦенНаОснованииДоговора()
	
	//++ №14073 комментируем, т.к. если дальше нигде не указан, обнуляется
	//сначала берем из карточки пользователя (низший приоритет)
	//ВидЦен = ПараметрыСеанса.ТекущийПользователь.ВидЦен;
	//-- №14073
	
	ВидЦен = Объект.ВидЦен; // №14073 запоминаем текущий вид цен, перед возможным изменением
	
	//если задан вид цен в категории контрагента, то берем из него (средний приоритет)
	Если ЗначениеЗаполнено(Объект.Контрагент) Тогда
		Если НЕ Объект.Контрагент.Категория.ВидЦен.Пустая() Тогда
			ВидЦен = Объект.Контрагент.Категория.ВидЦен;
		КонецЕсли;
	КонецЕсли;
	//если задан вид цен в договоре, то берем из него (высший приоритет)
	Если ЗначениеЗаполнено(Объект.ДоговорКонтрагента) Тогда
		Если НЕ Объект.ДоговорКонтрагента.ВидЦен.Пустая() Тогда
			ВидЦен = Объект.ДоговорКонтрагента.ВидЦен;
		КонецЕсли;
	КонецЕсли;
	
	Если Объект.ВидЦен = ВидЦен Тогда
		Возврат Ложь;
	Иначе
		Объект.ВидЦен = ВидЦен;
		Возврат Истина;
	КонецЕсли;
	
КонецФункции  

&НаКлиенте
Процедура ПослеВопросаОбОтменеМонтажей(Результат, Параметры) Экспорт
    Если Результат = КодВозвратаДиалога.Да Тогда
        ОтменитьНевыполненныеМонтажиНаСервере();
    КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ОтменитьНевыполненныеМонтажиНаСервере()
	
	НетОшибок = Истина;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Монтаж.Ссылка
	|ИЗ
	|	Документ.Монтаж КАК Монтаж
	|ГДЕ
	|	Монтаж.Основание = &Основание
	|	И Монтаж.Результат = &Результат
	|	И НЕ Монтаж.ПометкаУдаления";
	Запрос.УстановитьПараметр("Основание",Объект.Ссылка);
	Запрос.УстановитьПараметр("Результат",Справочники.РезультатыМонтажа.ВРаботе);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ДокОбъект = Выборка.Ссылка.ПолучитьОбъект();
		ДокОбъект.Результат = Справочники.РезультатыМонтажа.Отменен;
		Попытка
			Если Выборка.Ссылка.Проведен Тогда
				ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
			Иначе
				ДокОбъект.Записать();
			КонецЕсли;
			Сообщить("ОТМЕНЕН " + Выборка.Ссылка);
		Исключение
			Сообщить("Не удалось отменить " + Выборка.Ссылка + " - " + ОписаниеОшибки());
			НетОшибок = Ложь;
		КонецПопытки;
	КонецЦикла;
	
	Если НетОшибок Тогда
		ПроверитьНеобходимостьОтменыМонтажей = Ложь;
	КонецЕсли;
	
КонецПроцедуры

