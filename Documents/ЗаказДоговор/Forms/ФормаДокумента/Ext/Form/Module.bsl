	Список.Добавить("ИзЮридическогоАдреса", "Из юридического адреса контрагента");
	ОповещениеМеню = Новый ОписаниеОповещения("ЗаполнитьАдресПослеВыбораИзМеню", ЭтотОбъект, Параметры);
