					ТекущаяСтрока.МонтажСтатус = НайденныеСтроки[0].Результат;
				КонецЕсли;			
			КонецЦикла;
			
		КонецЕсли;		
	
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("ЗаказДоговор", ТекущийЗаказ);
