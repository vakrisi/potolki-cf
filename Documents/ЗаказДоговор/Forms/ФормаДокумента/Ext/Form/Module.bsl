&НаСервере
Функция ПолучитьПризнакЕстьЗаказПокупателяПоПотолку(Номенклатура, ХарактеристикаНоменклатуры, НомерПотолка)
	
	КВозврату = Ложь;
	
	Если Не ЗначениеЗаполнено(НомерПотолка) Тогда
		Возврат КВозврату;
	КонецЕсли;
	
	Запрос = новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЗаказыПоПотолкам.Номенклатура КАК Номенклатура,
	|	ЗаказыПоПотолкам.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	|	ЕСТЬNULL(ЗаказыПоПотолкам.КоличествоПриход, 0) > 0 КАК ЕстьЗаказПокупателяПоПотолку
	|ИЗ
	|	РегистрНакопления.ЗаказыПокупателей.Обороты(
	|			,
	|			,
	|			Регистратор,
	|			ЗаказНаПроизводство <> &ЗаказДоговор
	|				И Номенклатура.Потолок_НомерРасчета = &НомерПотолка
	|				И Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Справочник.ВидыНоменклатуры.Потолок)) КАК ЗаказыПоПотолкам
	|ГДЕ
	|	ЗаказыПоПотолкам.Регистратор ССЫЛКА Документ.ЗаказПокупателя
	|	И ЗаказыПоПотолкам.Регистратор.Основание = &ЗаказДоговор";
	
	//"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	//	|	ЗаказыПоПотолкам.Номенклатура КАК Номенклатура,
	//	|	ЗаказыПоПотолкам.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,	
	//	|	ЕСТЬNULL(ЗаказыПоПотолкам.КоличествоПриход, 0) > 0 КАК ЕстьЗаказПокупателяПоПотолку,
	//	|	ЕСТЬNULL(СправочникНоменклатура.Ссылка, ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)) КАК Потолок
	//	|ИЗ
	//	|	РегистрНакопления.ЗаказыПокупателей.Обороты(, ,Регистратор , ЗаказНаПроизводство <> &ЗаказДоговор) КАК ЗаказыПоПотолкам
	//	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК СправочникНоменклатура
	//	|		ПО (СправочникНоменклатура.Потолок_НомерРасчета = &НомерПотолка)
	//	|			И (СправочникНоменклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Справочник.ВидыНоменклатуры.Потолок))
	//	|ГДЕ	
	//	|	ЗаказыПоПотолкам.Номенклатура = &Номенклатура
	//	|   И ЗаказыПоПотолкам.ХарактеристикаНоменклатуры = &ХарактеристикаНоменклатуры
	//	|	И ЕСТЬNULL(СправочникНоменклатура.Ссылка, ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)) <> ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	//	|   И ЗаказыПоПотолкам.Регистратор ССЫЛКА Документ.ЗаказПокупателя
	//	|   И ЗаказыПоПотолкам.Регистратор.Основание = &ЗаказДоговор";
	Запрос.УстановитьПараметр("ЗаказДоговор", Объект.Ссылка);
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("ХарактеристикаНоменклатуры", ХарактеристикаНоменклатуры);
	Запрос.УстановитьПараметр("НомерПотолка", НомерПотолка);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		КВозврату = Выборка.ЕстьЗаказПокупателяПоПотолку;
	КонецЕсли;
	
	Возврат КВозврату;

КонецФункции

&НаСервереБезКонтекста
Функция ПроверитьНеобходимостьОбновитьДанныеПослеУдаленияЗаказаПокупателя()
	
	КВозврату = Ложь;
	
	УстановитьПривилегированныйРежим(Истина);
	Настройка = ХранилищеОбщихНастроек.Загрузить("УстановленаПометкаУдаленияНаЗаказПокупателя",,, Строка(Пользователи.ТекущийПользователь()));	
	Если ТипЗнч(Настройка) = Тип("Булево") Тогда
		КВозврату = Настройка;	
	КонецЕсли;
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат КВозврату;
	
КонецФункции

&НаСервереБезКонтекста
Процедура СнятьПризнакНеобходимостиОбновленияДанныхПослеУдаленияЗаказаПокупателя()
	
	УстановитьПривилегированныйРежим(Истина);
	ХранилищеОбщихНастроек.Сохранить("УстановленаПометкаУдаленияНаЗаказПокупателя",, Ложь,, Строка(Пользователи.ТекущийПользователь()));
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗадатьВопросПередИзменениемСтроки(Отказ, Элемент, ТекстВопроса)
	
	Если НЕ РазрешитьРедактированиеСтроки Тогда
		
        Отказ            = Истина;
        
        ПараметрыОповещения    = Новый Структура;
        ПараметрыОповещения.Вставить("Элемент", Элемент);
        
        Оповещение        = Новый ОписаниеОповещения("ПослеОтветаПользователяПередИзменениемСтроки", ЭтаФорма, ПараметрыОповещения);
        ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте 
Процедура ПослеОтветаПользователяПередИзменениемСтроки(Ответ, ДополнительныеПараметры) Экспорт 
	
	Если Ответ = КодВозвратаДиалога.Да Тогда
		
        РазрешитьРедактированиеСтроки    = Истина;
        
        ТекЭлемент    = ДополнительныеПараметры.Элемент;    
        ТекЭлемент.ИзменитьСтроку();
		
		РазрешитьРедактированиеСтроки    = Ложь;
			
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ГрафикОплатПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	Если НоваяСтрока Тогда
		ТекущиеДанные = Элементы.ГрафикОплат.ТекущиеДанные;
		ТекущиеДанные.Сумма = Объект.СуммаДокумента - Объект.ГрафикОплат.Итог("Сумма");
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура СоздатьКонтрагента(Команда)
	
	ОповещениеОЗакрытии = Новый ОписаниеОповещения("ПослеВопросаОСозданииКонтрагента", ЭтотОбъект);	
	ПоказатьВопрос(ОповещениеОЗакрытии, "Создать нового контрагента?",РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВопросаОСозданииКонтрагента(Результат, Параметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда			
		ПараметрыНовогоКонтрагента = ПараметрыНовогоКонтрагентаНаСервере();
		ПараметрыФормы = Новый Структура("Основание, ВыборНового", ПараметрыНовогоКонтрагента, Истина);
		ОткрытьФорму("Справочник.Контрагенты.ФормаОбъекта", ПараметрыФормы, ЭтаФорма, УникальныйИдентификатор); //, ЭтаФорма.Окно);
		// получение контрагента в процедуре ОбработкаВыбора				
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ПараметрыНовогоКонтрагентаНаСервере()

	ПараметрыНовогоКонтрагента = Новый Структура;
	ПараметрыНовогоКонтрагента.Вставить("Родитель", Константы.ГруппаНовыхКонтрагентовРозницы.Получить());
	ПараметрыНовогоКонтрагента.Вставить("Розница", Истина);
	ПараметрыНовогоКонтрагента.Вставить("Покупатель", Истина); // #6381
	Если ТипЗнч(Объект.Основание) = Тип("ДокументСсылка.Лид") И ЗначениеЗаполнено(Объект.Основание) Тогда	
		РеквизитыЛида = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект.Основание, "ИмяКлиента, Город, Адрес");
		ПараметрыНовогоКонтрагента.Вставить("Наименование", 		 РеквизитыЛида.ИмяКлиента);
		ГородЛида = Строка(РеквизитыЛида.Город);
		АдресЛида = СтрШаблон("%1%2", ?(ПустаяСтрока(ГородЛида), "", ГородЛида + ", "), РеквизитыЛида.Адрес);
		//ПараметрыНовогоКонтрагента.Вставить("ЮридическийАдрес", 	 АдресЛида);  // #16044 закомментировано
		ПараметрыНовогоКонтрагента.Вставить("ФактическийАдрес", 	 АдресЛида);
		ПараметрыНовогоКонтрагента.Вставить("ДополнительнаяКонтактнаяИнформация", ОбщегоНазначения.ТаблицаЗначенийВМассив(Объект.Основание.ДополнительнаяКонтактнаяИнформация.Выгрузить()));
	КонецЕсли;
	Возврат ПараметрыНовогоКонтрагента;
	
КонецФункции

&НаСервере
Функция ПолучитьНомерЛидаОснования()
	Если ТипЗнч(Объект.Основание) = Тип("ДокументСсылка.Лид") Тогда
		Возврат Объект.Основание.Номер;
	Иначе
		Возврат "";
	КонецЕсли;
КонецФункции

&НаКлиенте
Процедура ЗаполнитьДанныеКОтгрузкеИОстаткиПоТоварам()
	
	//заполняем данные по остаткам на складах
	
	МассивТоваров = Новый Массив;
	Для Каждого ТекущаяСтрокаКомната Из ДеревоТоваров.ПолучитьЭлементы() Цикл
		Для Каждого ТекущаяСтрока Из ТекущаяСтрокаКомната.ПолучитьЭлементы() Цикл
			НоваяСтрока = Новый Структура("Комната, Номенклатура, ХарактеристикаНоменклатуры, Коэффициент, НомерПотолка, Количество, УИСтроки");			
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущаяСтрока);
			МассивТоваров.Добавить(НоваяСтрока);
		КонецЦикла;
	КонецЦикла;
	
	ПоказателиПоТовару = ПолучитьПоказателиПоТоваруСервер(Объект.Организация, Объект.Ссылка, МассивТоваров, Объект.ЗаполнятьУИСтрок);
		
	Для Каждого ТекущаяСтрокаКомната Из ДеревоТоваров.ПолучитьЭлементы() Цикл
		Для Каждого ТекущаяСтрока Из ТекущаяСтрокаКомната.ПолучитьЭлементы() Цикл
			
			СтрокаТовара = Новый Структура("Комната, Номенклатура, ХарактеристикаНоменклатуры, УИСтроки");
			ЗаполнитьЗначенияСвойств(СтрокаТовара, ТекущаяСтрока);
			
			Для каждого СтрокаПоказателейТЗ из ПоказателиПоТовару Цикл
				СтрокаПоказателя = Новый Структура("Комната, Номенклатура, ХарактеристикаНоменклатуры, УИСтроки");			
				ЗаполнитьЗначенияСвойств(СтрокаПоказателя, СтрокаПоказателейТЗ);
			
				Если ОбщийМодульКлиентСервер.СтруктурыСовпадают(СтрокаТовара, СтрокаПоказателя) Тогда
					ЗаполнитьЗначенияСвойств(ТекущаяСтрока, СтрокаПоказателейТЗ, "КОтгрузке, ОстатокНаСкладе, Доступно, ВРезерве, ЕстьЗаказПокупателяПоПотолку, Монтаж, МонтажСтатус, Заказано, КоличествоВМонтажах");	
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьПоказателиПоТоваруСервер(Организация, ТекущийЗаказ, МассивТоваров, ЗаполнятьУИСтрок)
	
	ТаблицаТоваров = Новый ТаблицаЗначений();
	ТаблицаТоваров.Колонки.Добавить("Комната", 						Новый ОписаниеТипов("Строка", , , , Новый КвалификаторыСтроки(25)));
	ТаблицаТоваров.Колонки.Добавить("Номенклатура", 				Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ТаблицаТоваров.Колонки.Добавить("ХарактеристикаНоменклатуры", 	Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры"));
	ТаблицаТоваров.Колонки.Добавить("Коэффициент", 					Новый ОписаниеТипов("Число", , , Новый КвалификаторыЧисла(10, 4)));
	ТаблицаТоваров.Колонки.Добавить("НомерПотолка", 				Новый ОписаниеТипов("Строка", , , , Новый КвалификаторыСтроки(50)));
