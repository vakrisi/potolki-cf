&НаСервереБезКонтекста
Функция ПроверитьИспользованиеКомнатыВДокументах(ЗаказСсылка, НаименованиеКомнаты)
	
	УстановитьПривилегированныйРежим(Истина);
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Заказ", ЗаказСсылка);
	Запрос.УстановитьПараметр("Комната", НаименованиеКомнаты);
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ОбеспечениеЗаказовРозницы.Регистратор КАК Регистратор,
		|	ОбеспечениеЗаказовРозницы.Комната КАК Комната
		|ИЗ
		|	РегистрНакопления.ОбеспечениеЗаказовРозницы КАК ОбеспечениеЗаказовРозницы
		|ГДЕ
		|	ОбеспечениеЗаказовРозницы.Заказ = &Заказ
		|	И ОбеспечениеЗаказовРозницы.Комната = &Комната";
	
		
	Выборка = Запрос.Выполнить().Выбрать();	
	Если Выборка.Следующий() Тогда
		Возврат Истина;
	КонецЕсли;
	
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ДанныеДокумента.Ссылка КАК Регистратор,
	|	ДанныеДокумента.Комната КАК Комната
	|ИЗ
	|	Документ.Монтаж.ТоварыУслуги КАК ДанныеДокумента
	|ГДЕ
	|	НЕ ДанныеДокумента.Ссылка.ПометкаУдаления
	|	И ДанныеДокумента.Ссылка.Основание = &Заказ
	|	И ДанныеДокумента.Комната = &Комната
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ДанныеДокумента.Ссылка,
	|	ДанныеДокумента.Комната
	|ИЗ
	|	Документ.Монтаж.Материалы КАК ДанныеДокумента
	|ГДЕ
	|	НЕ ДанныеДокумента.Ссылка.ПометкаУдаления
	|	И ДанныеДокумента.Ссылка.Основание = &Заказ
	|	И ДанныеДокумента.Комната = &Комната";
		
	Выборка = Запрос.Выполнить().Выбрать();	
	Если Выборка.Следующий() Тогда
		Возврат Истина;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

&НаКлиенте
Процедура ПереименоватьКомнату(Команда)
	
	ТекущиеДанные = Элементы.ДеревоТоваров.ТекущиеДанные;
	ТекущиеДанные = Элементы.ДеревоТоваров.ТекущиеДанные;
	ИдТекущейСтрокиКомнаты = ТекущиеДанные.ПолучитьИдентификатор();
	Если НЕ ТекущиеДанные.ПолучитьРодителя() = Неопределено Тогда
		ИдТекущейСтрокиКомнаты = ТекущиеДанные.ПолучитьРодителя().ПолучитьИдентификатор();
	КонецЕсли;

	ТекущееНаименование = ТекущиеДанные.Комната;
	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
		РезультатОтказ = ПроверитьИспользованиеКомнатыВДокументах(Объект.Ссылка, ТекущееНаименование);
		Если РезультатОтказ Тогда
			ПоказатьПредупреждение(Неопределено, "По данной комнате имеются оформленные документы, переименование недоступно!");
			Возврат;	
		КонецЕсли;		
	КонецЕсли;
	
	ПараметрыПереименования = Новый Структура;
	ПараметрыПереименования.Вставить("Форма", ЭтаФорма);
	ПараметрыПереименования.Вставить("СтароеНаименование", ТекущееНаименование);
	ПараметрыПереименования.Вставить("ИдТекущейСтрокиКомнаты", ИдТекущейСтрокиКомнаты);
	
	ОбщийМодульКлиент.Розница_ПереименоватьКомнату(ПараметрыПереименования);
	
	//ПослеВводаНовогоНаименованияКомнаты = Новый ОписаниеОповещения("ПослеВводаНовогоНаименованияКомнаты",ЭтаФорма,ПараметрыПереименования);
	//ПоказатьВводСтроки(ПослеВводаНовогоНаименованияКомнаты,ТекущееНаименование,"Введите название комнаты");
	
КонецПроцедуры

