&НаСервере
Функция ПолучитьСписокДоступныхСтатусов(ТекущийСтатус)
	
	Результат = Новый СписокЗначений;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СтатусыЗаказДоговоров.Ссылка
	|ИЗ
	|	Справочник.СтатусыЗаказДоговоров КАК СтатусыЗаказДоговоров
	|ГДЕ
	|	СтатусыЗаказДоговоров.Ссылка <> ЗНАЧЕНИЕ(Справочник.СтатусыЗаказДоговоров.Отменен)";
	Запрос.УстановитьПараметр("Ссылка", ТекущийСтатус);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Добавить(Выборка.Ссылка);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

