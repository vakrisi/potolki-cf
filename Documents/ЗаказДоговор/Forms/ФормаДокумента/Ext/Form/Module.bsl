&НаКлиенте
Процедура ДеревоМатериаловПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	Отказ = Истина;
КонецПроцедуры

&НаКлиенте
Процедура ДеревоМатериаловПередНачаломИзменения(Элемент, Отказ)
	
	ТекущиеДанные = Элементы.ДеревоМатериалов.ТекущиеДанные;
	
	Если ТекущиеДанные.ПолучитьРодителя() = Неопределено Тогда
		Отказ = Истина;
	КонецЕсли;
	
	//++ №12269 запрещаем редактировать количество если "Площадь потолка" заполнена
	Если Элемент.ТекущийЭлемент.Имя = "ДеревоМатериаловКоличество" И ВНоменклатуреУказанаПлощадьПотолка(ТекущиеДанные.Номенклатура) Тогда
		Отказ = Истина;
	КонецЕсли;
	//-- №12269
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоМатериаловПередУдалением(Элемент, Отказ)
	
	//ТекущиеДанные = Элементы.ДеревоМатериалов.ТекущиеДанные;
	Для Каждого ВыделеннаяСтрока Из Элементы.ДеревоМатериалов.ВыделенныеСтроки Цикл
		ТекущиеДанные = ДеревоМатериалов.НайтиПоИдентификатору(ВыделеннаяСтрока);
		Если ТекущиеДанные.ПолучитьРодителя() = Неопределено Тогда
		//Если ТекущиеДанные.Номенклатура.Пустая() Тогда
			Отказ = Истина;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоМатериаловПередОкончаниемРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования, Отказ)
	
	ТекущиеДанные = Элементы.ДеревоМатериалов.ТекущиеДанные;
	
	// Новая строка добавлена программно.
	// При отмене редактирования ее требуется удалить.
	Если СтрокаМатериаловДобавлена И ОтменаРедактирования Тогда
		ДеревоМатериалов.ПолучитьЭлементы().Удалить(ТекущиеДанные);
		СтрокаМатериаловДобавлена = Ложь;
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоМатериаловПослеУдаления(Элемент)
	
	ПеренестиДеревоВТабличнуюЧасть(Ложь, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоМатериаловНоменклатураПриИзменении(Элемент)
	
	//корневые строки редактировать нельзя
	Если Элементы.ДеревоМатериалов.ТекущиеДанные.ПолучитьРодителя() = Неопределено Тогда
		Элементы.ДеревоМатериалов.ТекущиеДанные.Номенклатура = Неопределено;
		Возврат;
	КонецЕсли;
	
	СтрокаТабличнойЧасти = Элементы.ДеревоМатериалов.ТекущиеДанные;
	СтрокаТабличнойЧасти.ЕдиницаИзмерения = ПолучитьБазовуюЕдиницуИзмеренияНоменклатуры(СтрокаТабличнойЧасти.Номенклатура);
	СтрокаТабличнойЧасти.Коэффициент = 1;
	СтрокаТабличнойЧасти.Количество = ПолучитьКоличествоНоменклатуры(СтрокаТабличнойЧасти.Номенклатура); //1;
	СтрокаТабличнойЧасти.УИСтроки = Новый УникальныйИдентификатор;
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоМатериаловЕдиницаИзмеренияПриИзменении(Элемент)
	//корневые строки редактировать нельзя
	Если Элементы.ДеревоМатериалов.ТекущиеДанные.ПолучитьРодителя() = Неопределено Тогда
		Элементы.ДеревоМатериалов.ТекущиеДанные.ЕдиницаИзмерения = Неопределено;
		Возврат;
	КонецЕсли;
	
	СтрокаТабличнойЧасти = Элементы.ДеревоМатериалов.ТекущиеДанные;
	Если ТипЗнч(СтрокаТабличнойЧасти.ЕдиницаИзмерения) = Тип("СправочникСсылка.КлассификаторЕдиницИзмерения") Тогда
		СтрокаТабличнойЧасти.Коэффициент = 1;
	Иначе
		СтрокаТабличнойЧасти.Коэффициент = ОбщийМодуль.ПолучитьКоэффициентЕдиницыИзмерения(СтрокаТабличнойЧасти.ЕдиницаИзмерения);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ДеревоМатериаловЕдиницаИзмеренияНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	СтрокаТабличнойЧасти = Элементы.ДеревоМатериалов.ТекущиеДанные;
	СписокЕдиниц = ОбщийМодуль.ПолучитьСписокЕдиницИзмеренияНоменклатуры(СтрокаТабличнойЧасти.Номенклатура);
	
	ДанныеВыбора = Новый СписокЗначений;
	Для Ном = 0 По СписокЕдиниц.Количество() - 1 Цикл
		ДанныеВыбора.Добавить(СписокЕдиниц[Ном]);
	КонецЦикла;
КонецПроцедуры

