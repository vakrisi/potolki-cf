&НаКлиенте
Процедура РаспределитьОплатыГрафика(Команда)
	
	//#16286 	
	ОписаниеОповещения = Новый ОписаниеОповещения("ПослеВыбораПараметровГрафикаОплат", ЭтотОбъект);
	ПараметрыФормыРГ = Новый Структура("ДатаНачала, СуммаДокумента, Валюта", Объект.ДатаДоговора, Объект.СуммаДокумента, Объект.Валюта);
	ОткрытьФорму("Документ.ЗаказДоговор.Форма.ФормаРаспределенияГрафикаОплат", ПараметрыФормыРГ, ЭтаФорма, , , , ОписаниеОповещения);
		
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораПараметровГрафикаОплат(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Результат.Вставить("Сумма", Объект.СуммаДокумента);
	ГрафикРаспределения = ОбщийМодульКлиентСервер.РаспределитьГрафикОплат(Результат);

	Если Объект.ГрафикОплат.Количество() > 0 Тогда
		КнопкиВопроса = Новый СписокЗначений;
		КнопкиВопроса.Добавить(КодВозвратаДиалога.Да, "Очистить");
		КнопкиВопроса.Добавить(КодВозвратаДиалога.Нет, "Нет, дополнить таблицу");
		КнопкиВопроса.Добавить(КодВозвратаДиалога.Отмена, "Отмена");
		
		ОписаниеОповещения = Новый ОписаниеОповещения("РаспределитьОплатыГрафикаПослеВопроса", ЭтотОбъект, ГрафикРаспределения);
		ПоказатьВопрос(ОписаниеОповещения, "Очистить таблицу ""График оплат""?", КнопкиВопроса, , КодВозвратаДиалога.Да);
		
	Иначе
		РаспределитьОплатыГрафикаЗавершение(ГрафикРаспределения);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура РаспределитьОплатыГрафикаПослеВопроса(Результат, ДополнительныеПараметры) Экспорт

	Если Результат = КодВозвратаДиалога.Да Тогда
		Объект.ГрафикОплат.Очистить();
		РаспределитьОплатыГрафикаЗавершение(ДополнительныеПараметры);
		
	ИначеЕсли Результат = КодВозвратаДиалога.Нет Тогда
		РаспределитьОплатыГрафикаЗавершение(ДополнительныеПараметры);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РаспределитьОплатыГрафикаЗавершение(ГрафикРаспределения)

	Для каждого ЭлементМассива из ГрафикРаспределения Цикл
		НоваяСтрока = Объект.ГрафикОплат.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ЭлементМассива);
	КонецЦикла;
	
КонецПроцедуры


