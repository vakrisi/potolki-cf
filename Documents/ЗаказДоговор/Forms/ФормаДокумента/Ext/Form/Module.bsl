	Элементы.RVY_Отправить.Видимость = RVY_ИспользоватьИнтеграцию;
	ТекущийСтатусМаксимальнаяШирина = 40;
	ТекущийСтатусМаксимальнаяШирина = ТекущийСтатусМаксимальнаяШирина - ?(ПоказатьКнопкуОтчетаСравненияСМонтажами, 4, 0);
	ТекущийСтатусМаксимальнаяШирина = ТекущийСтатусМаксимальнаяШирина - ?(RVY_ИспользоватьИнтеграцию, 4, 0);
	Элементы.ТекущийСтатус.МаксимальнаяШирина = ТекущийСтатусМаксимальнаяШирина;
	
	//УчитыватьНДС = УчетНДС.ОрганизацияЯвляетсяПлательщикомНДС(Объект.Организация);
	//Элементы.СтавкаНДС.Видимость 				= УчитыватьНДС;
	//Элементы.ДеревоТоваровСтавкаНДС.Видимость 	= УчитыватьНДС;
	//Элементы.ДеревоТоваровСуммаНДС.Видимость 	= УчитыватьНДС;
	//Элементы.ГруппаНДС.Видимость				= УчитыватьНДС;
	//Если УчитыватьНДС Тогда
	//	Элементы.ИтогиВсегоНДС.Заголовок = Объект.ТоварыУслуги.Итог("СуммаНДС");
	//КонецЕсли;
	
	Элементы.ДеревоТоваровМонтаж.Видимость = Объект.ЗаполнятьУИСтрок;
	
	ПолучитьВсеПодчиненныеДокументыПоПотолкам();
	
	// №6303 закомментировано - переведен в документ "Расторжение договора"
	//// Расторжение
	//Элементы.ГруппаРасторжениеТовары.Видимость 				= Объект.РасторжениеБезВозвратаДенегКлиенту;
	//Элементы.ГруппаРасторжениеМатериалы.Видимость 			= Объект.РасторжениеБезВозвратаДенегКлиенту;
	//Элементы.РасторжениеСкладСписанияТоваров.Доступность 	= Объект.РасторжениеСписатьТовары;
	//Элементы.РасторжениеСкладСписанияМатериалов.Доступность = Объект.РасторжениеСписатьМатериалы;	
	//Элементы.ГруппаРасторжение.Видимость 					= (Объект.ТекущийСтатус = ПредопределенноеЗначение("Справочник.СтатусыЗаказДоговоров.Отменен"));
		
	//Если ПустаяСтрока(Объект.ПричинаРассторженияДоговора) Тогда
	//	Элементы.ГруппаРасторжение.Картинка = БиблиотекаКартинок.Предупреждение;
	//Иначе
	//	Элементы.ГруппаРасторжение.Картинка = Новый Картинка;
	//КонецЕсли;
	
	// №6828
	Если Объект.ТекущийСтатус = ПредопределенноеЗначение("Справочник.СтатусыЗаказДоговоров.Отменен") 
		//#16242
		И Объект.ВидЗаказа = ПредопределенноеЗначение("Справочник.ВидыЗаказДоговоров.Договор") Тогда
		Если ЗначениеЗаполнено(СоглашениеОРасторженииДоговора) Тогда  // #12168
			Элементы.ДекорацияДоговорРасторгнут.Видимость = Истина;
			Элементы.ГруппаТекущийСтатус.Видимость = Ложь;
			Элементы.ДекорацияДоговорРасторгнут.Заголовок = "Отменен: " + СоглашениеОРасторженииДоговора;
		Иначе	
			Элементы.ДекорацияДоговорРасторгнут.Видимость = Ложь;
			Элементы.ГруппаТекущийСтатус.Видимость = Истина;
			Сообщить("Заказ-договор в статусе ""Отменен"", но не найдено проведенное соглашение о расторжении договора");
		КонецЕсли;
	Иначе
		Элементы.ДекорацияДоговорРасторгнут.Видимость = Ложь;
		Элементы.ГруппаТекущийСтатус.Видимость = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьТекстовоеПредставлениеСостоянияПроизводстваПотолка(ЗаказДоговор)
	
	Заказан = 0;
	Произведен = 0;
	Отгружен = 0;
	Получен = 0;
	Потребность = 0;
	
	Результат = "";
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЗаказыРозницыВПроизводствеОбороты.ЗаказанОборот КАК Заказан,
	|	ЗаказыРозницыВПроизводствеОбороты.ПроизведенОборот КАК Произведен,
	|	ЗаказыРозницыВПроизводствеОбороты.ОтгруженОборот КАК Отгружен,
	|	ЗаказыРозницыВПроизводствеОбороты.ПолученОборот КАК Получен,
	|	ЗаказыРозницыВПроизводствеОбороты.ПотребностьОборот КАК Потребность
	|ИЗ
	|	РегистрНакопления.ЗаказыРозницыВПроизводстве.Обороты(, , , ЗаказДоговор = &ЗаказДоговор) КАК ЗаказыРозницыВПроизводствеОбороты";
	Запрос.УстановитьПараметр("ЗаказДоговор",ЗаказДоговор);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Заказан 	= Выборка.Заказан;
		Произведен 	= Выборка.Произведен;
		Отгружен 	= Выборка.Отгружен;
		Получен 	= Выборка.Получен;
		Потребность = Выборка.Потребность;
	КонецЦикла;
	
	Если Потребность = 0 Тогда
		//на производство ничего не собирались заказывать
		Возврат "";
	Иначе
		Если Получен >= Потребность Тогда
			Возврат "получен на склад";
		ИначеЕсли Отгружен >= Потребность Тогда
			Возврат "отгружен с производства";
		ИначеЕсли Произведен >= Потребность Тогда
			Возврат "произведен на производстве";
		ИначеЕсли Заказан >= Потребность Тогда
			Возврат "заказан в производство";
		Иначе
			Возврат "требуется оформить заказ на производство";
		КонецЕсли;
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

&НаСервере
Процедура ПеренестиДеревоВТабличнуюЧасть(ПеренестиТовары = Истина, ПеренестиМатериалы = Истина)
	
	//ТОВАРЫ И УСЛУГИ
	//ЗаполнитьПустыеУИСДерева(ДеревоТоваров);
	Если ПеренестиТовары Тогда
		Объект.ТоварыУслуги.Очистить();
		Дерево = ДанныеФормыВЗначение(ДеревоТоваров, Тип("ДеревоЗначений"));
		ЗаполнитьПустыеУИСДерева(Дерево);
		Для Каждого Строка из Дерево.Строки Цикл
			Для Каждого СтрНоменклатура из Строка.Строки Цикл
				Если НЕ СтрНоменклатура.Номенклатура.Пустая() Тогда				
					Стр = Объект.ТоварыУслуги.Добавить();
					ЗаполнитьЗначенияСвойств(Стр, СтрНоменклатура);
					Стр.СуммаПоПрайсу = Стр.ЦенаПоПрайсу * Стр.Количество;
				КонецЕсли;
			КонецЦикла;	
		КонецЦикла;
		
		ПересчитатьСуммуДокументаНаСервере();
		КоличествоСтрокТоваров    = Объект.ТоварыУслуги.Количество();
	КонецЕсли;
	
	//КомнатыТоваров = Объект.ТоварыУслуги.Выгрузить(); //нужна для отслеживания удаленных комнат в товарах
	//КомнатыТоваров.Свернуть("Комната");
	
	//МАТЕРИАЛЫ
	Если ПеренестиМатериалы Тогда
		Объект.Материалы.Очистить();
		Если ЗаполнениеМатериаловПоЗаказам Тогда
			Дерево = ДанныеФормыВЗначение(ДеревоМатериалов, Тип("ДеревоЗначений"));
			ЗаполнитьПустыеУИСДерева(Дерево);
			Для Каждого Строка из Дерево.Строки Цикл
				//НайденнаяКомната = КомнатыТоваров.Найти(Строка.Комната, "Комната");
				//Если НЕ НайденнаяКомната = Неопределено Тогда //переносим данные только по тем комнатам, что есть в товарах  // #5010 не только
				Для Каждого СтрНоменклатура из Строка.Строки Цикл
					Если НЕ СтрНоменклатура.Номенклатура.Пустая() Тогда
						Стр = Объект.Материалы.Добавить();
						ЗаполнитьЗначенияСвойств(Стр, СтрНоменклатура);
					КонецЕсли;
				КонецЦикла;	
				//КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
		КоличествоСтрокМатериалов = Объект.Материалы.Количество();
	КонецЕсли;

КонецПроцедуры

