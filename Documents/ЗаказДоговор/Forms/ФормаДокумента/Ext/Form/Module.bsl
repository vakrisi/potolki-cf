&НаКлиенте
Процедура ДекорацияДанныеЗамераНажатие(Элемент)
	
	СтандартнаяОбработка = Ложь;
	
	ПараметрыФормы = Новый Структура();
	ПараметрыФормы.Вставить("ТолькоПросмотр",               ТолькоПросмотр);
	//++ №11768 комментируем, т.к. информация будет в отдельной форме
	//ПараметрыФормы.Вставить("ИмяКлиентаЛида",               ИмяКлиентаЛида);
	//ПараметрыФормы.Вставить("АдресКлиентаЛида",           	АдресКлиентаЛида);
	//ПараметрыФормы.Вставить("СуммаДоговораНаЗамере",        СуммаДоговораНаЗамере);
	//-- №11768 комментируем, т.к. информация будет в отдельной форме
	ПараметрыФормы.Вставить("ПредполагаемыйМонтажДатаМонтажаНеОпределена", Объект.ПредполагаемыйМонтажДатаМонтажаНеОпределена);
	ПараметрыФормы.Вставить("ПредполагаемыйМонтажДата",     Объект.ОжидаемаяДатаОтгрузки);
	ПараметрыФормы.Вставить("ПредполагаемыйМонтажВремя",    Объект.ОжидаемоеВремяОтгрузки);
	
	//++ №11768
	ПараметрыФормы.Вставить("ИдентификаторЗамера", Объект.ИдентификаторЗамера);
	ПараметрыФормы.Вставить("Лид", Объект.Основание);
	ПараметрыФормы.Вставить("ЗамерщикВДоговоре", Объект.ИсполнительЗамера);
	//-- №11768
	
	ДополнительныеПараметры = Новый Структура;
	Оповещение = Новый ОписаниеОповещения("НадписьДанныеЗамераНажатиеЗавершение", ЭтотОбъект, ДополнительныеПараметры);
	
	ОткрытьФорму("Документ.ЗаказДоговор.Форма.ФормаДанныеЗамера", 
		ПараметрыФормы,
		ЭтаФорма,,,,
		Оповещение,
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры
	
&НаКлиенте
Процедура НадписьДанныеЗамераНажатиеЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат <> Неопределено Тогда
		
		Модифицированность = Истина;
		
		Объект.ОжидаемаяДатаОтгрузки  = Результат.ПредполагаемыйМонтажДата;
		Объект.ОжидаемоеВремяОтгрузки = Результат.ПредполагаемыйМонтажВремя;
		Объект.ПредполагаемыйМонтажДатаМонтажаНеОпределена = Результат.ПредполагаемыйМонтажДатаМонтажаНеОпределена;
		
		//++ №11768
		Объект.ИдентификаторЗамера = Результат.ИдентификаторЗамера;
		
		Если ЗначениеЗаполнено(Результат.Замерщик) Тогда
			Объект.ИсполнительЗамера = Результат.Замерщик;
		КонецЕсли;
		
		ОбновитьИнформациюПоЗамеруЛида();
		//-- №11768
		
		СформироватьНадписьПредварительныеДанныеЗамера();
		
	КонецЕсли;
	
КонецПроцедуры

