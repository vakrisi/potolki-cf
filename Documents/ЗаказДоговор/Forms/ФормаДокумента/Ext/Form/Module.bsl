&НаСервере
Процедура УстановитьОтметкуНезаполненногоИсполнителяЗамера()
	
	ЗаполнениеОбязательно = НЕ Объект.ДоговорБезЗамера;
	Если ЗаполнениеОбязательно 
		И НЕ Объект.ВидЗаказа = Справочники.ВидыЗаказДоговоров.Договор Тогда
		ЗаполнениеОбязательно = Ложь;	
	КонецЕсли;
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ИсполнительЗамера",  "АвтоОтметкаНезаполненного", ЗаполнениеОбязательно);
	Если Не ЗаполнениеОбязательно Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ИсполнительЗамера",  "ОтметкаНезаполненного", Ложь);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьОтметкуНезаполненногоАдреса()
	
	ЗаполнениеОбязательно = НЕ Объект.ВидЗаказа = Справочники.ВидыЗаказДоговоров.Продажа;
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "Адрес", "АвтоОтметкаНезаполненного", ЗаполнениеОбязательно);
	Если Не ЗаполнениеОбязательно Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "Адрес", "ОтметкаНезаполненного", Ложь);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьИтоговыеПоказателиКлиент(ФормаТолькоПросмотр = Ложь) Экспорт
	//#7556
		
	ИтогСумма = 0;
	ИтогСуммаБезСкидки = 0;
	ИтогСуммаПоПрайсу = 0;
	ИтогСуммаНДС = 0;
	ИтогСуммаСкидки = 0;
	ИтогКоличествоКомнат = 0;
	
	ИтогКоличествоПотолков = 0; // реквизит формы
	ИтогПлощадьПотолков = 0; // реквизит формы
	
	ЭлементыДерева = ДеревоТоваров.ПолучитьЭлементы();
	ИтогКоличествоКомнат = ЭлементыДерева.Количество();
	
	Для Каждого СтрокаКомнаты из ЭлементыДерева Цикл
		
		СуммаПоКомнате = 0;
		СуммаПоПрайсуКомнате = 0;
		ИтогБесплатноПоКомнате = 0;
		ИтогПлатноПоКомнате = 0;
		
		Для Каждого СтрокаТовара Из СтрокаКомнаты.ПолучитьЭлементы() Цикл
			ИтогСумма = ИтогСумма + СтрокаТовара.Сумма;
			ИтогСуммаБезСкидки = ИтогСуммаБезСкидки + СтрокаТовара.Количество * СтрокаТовара.Цена;
			ИтогСуммаПоПрайсу = ИтогСуммаПоПрайсу + СтрокаТовара.СуммаПоПрайсу;
			ИтогСуммаНДС = ИтогСуммаНДС + СтрокаТовара.СуммаНДС;
			ИтогСуммаСкидки = ИтогСуммаСкидки + СтрокаТовара.СуммаСкидки;			
			Если ЗначениеЗаполнено(СтрокаТовара.Номенклатура) И ОбщийМодульВызовСервера.ЭтоНоменклатураПотолкаРозницы(СтрокаТовара.Номенклатура) Тогда
				ИтогКоличествоПотолков = ИтогКоличествоПотолков + 1; 
				ИтогПлощадьПотолков = ИтогПлощадьПотолков + СтрокаТовара.Количество;	
			КонецЕсли;
			
			СуммаПоКомнате = СуммаПоКомнате + СтрокаТовара.Сумма;
			СуммаПоПрайсуКомнате = СуммаПоПрайсуКомнате + СтрокаТовара.СуммаПоПрайсу;			
			ИтогБесплатноПоКомнате = ИтогБесплатноПоКомнате + ?(СтрокаТовара.Бесплатно, 1, 0);
			ИтогПлатноПоКомнате    = ИтогПлатноПоКомнате    + ?(СтрокаТовара.Бесплатно, 0, 1);
		КонецЦикла;
		
		СтрокаКомнаты.Сумма = СуммаПоКомнате;
		СтрокаКомнаты.СуммаПоПрайсу = СуммаПоПрайсуКомнате;
		СтрокаКомнаты.Бесплатно = (ИтогБесплатноПоКомнате > 0 И ИтогПлатноПоКомнате = 0);
	КонецЦикла;
	ИтогОтклонениеОтПрайса = ИтогСумма - ИтогСуммаПоПрайсу; //как в отчете по эффективностям
	
	Если НЕ ФормаТолькоПросмотр Тогда
		Если Объект.КоличествоКомнат <> ИтогКоличествоКомнат Тогда
			Объект.КоличествоКомнат = ИтогКоличествоКомнат;
			Модифицированность = Истина;
		КонецЕсли;
		
		Если Объект.СуммаДокумента <> ИтогСумма И НЕ Объект.ТекущийСтатус = ПредопределенноеЗначение("Справочник.СтатусыЗаказДоговоров.Отменен") Тогда // для расторгнутых сумма документа устанавливается из суммы СОРД (модуль объекта)
			Объект.СуммаДокумента = ИтогСумма;
			Модифицированность = Истина;
		КонецЕсли;
		Если Объект.СуммаДокументаПоПрайсу <> ИтогСуммаПоПрайсу Тогда
			Объект.СуммаДокументаПоПрайсу = ИтогСуммаПоПрайсу;
			Модифицированность = Истина;
		КонецЕсли;
		Если Объект.ОтклонениеОтПрайса <> ИтогОтклонениеОтПрайса Тогда
			Объект.ОтклонениеОтПрайса = ИтогОтклонениеОтПрайса;
			Модифицированность = Истина;
		КонецЕсли;
		Если Объект.СуммаСкидки <> ИтогСуммаСкидки Тогда
			Объект.СуммаСкидки = ИтогСуммаСкидки;
			Объект.ПроцентСкидки = ИтогСуммаСкидки;
			Если ИтогСуммаБезСкидки <> 0 Тогда
				Объект.ПроцентСкидки = Окр(100*ИтогСуммаСкидки / (ИтогСуммаБезСкидки), 2);
			Иначе
				Объект.ПроцентСкидки = 0;
			КонецЕсли;
			Модифицированность = Истина;
		КонецЕсли;
	КонецЕсли;

	СуммаНДС = ИтогСуммаНДС;	
	//Если УчитыватьНДС Тогда
