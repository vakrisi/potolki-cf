	Если ВыбранныйЭлемент = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Объект.Контрагент) Тогда
		ПоказатьОповещениеПользователя("Не выбран контрагент!");
		Возврат;
	КонецЕсли;
	
	Объект.Адрес = АдресКонтрагента(Объект.Контрагент, ВыбранныйЭлемент.Значение);
	Модифицированность = Истина;
	
