&НаСервере
Процедура ДополнитьСписокСсылокНаФайлы(СписокСсылок, СписокДляПросмотра = Ложь)
	// если СписокДляПросмотра, то получаем список ссылок для формирования списка файлов
	// иначе                       получаем список ссылок для добавления файлов (добавление только к текущему документу)
	
	//Текущий документ
	СписокСсылок.Добавить(Объект.Ссылка, Объект.Ссылка); //"Текущий документ");
	
	Если СписокДляПросмотра Тогда
		// добавление Лида
		Если ТипЗнч(Объект.Основание) = Тип("ДокументСсылка.Лид") И НЕ Объект.Основание.Пустая() Тогда
			СписокСсылок.Добавить(Объект.Основание);
		КонецЕсли;	
		
		// добавление монтажей
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Монтажи.Ссылка
		|ИЗ
		|	Документ.Монтаж КАК Монтажи
		|ГДЕ
		|   Монтажи.Основание = &ДокументОснование";
		Запрос.УстановитьПараметр("ДокументОснование", Объект.Ссылка);
		Выборка = Запрос.Выполнить().Выбрать();
		
		Пока Выборка.Следующий() Цикл
			СписокСсылок.Добавить(Выборка.Ссылка);
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ФайлыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ТекущиеДанные = Элементы.ФайлыДерево.ТекущиеДанные;
	Если ТекущиеДанные.ПолучитьРодителя() = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	АдресФайла = ОбщийМодульВызовСервера.ПолучитьДанныеФайла(ТекущиеДанные.Документ, ТекущиеДанные.ИмяФайла, ТекущиеДанные.Номенклатура, ЭтотОбъект.УникальныйИдентификатор);
	
	Если НЕ АдресФайла = Неопределено Тогда // №7253
		ВременноеИмя = ПолучитьИмяВременногоФайла(ТекущиеДанные.Расширение);
	    ПолучитьФайл(АдресФайла, ВременноеИмя, Истина);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ФайлыПриАктивизацииСтроки(Элемент)
	
	Если НЕ ВключитьПредпросмотрФайлов ИЛИ Элементы.ФайлыДерево.ТекущиеДанные = Неопределено Тогда //ИЛИ Элементы.ФайлыДерево.ТекущиеДанные.ПолучитьРодителя() = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если мПредыдущийИдентификатор = Элементы.ФайлыДерево.ТекущиеДанные.ПолучитьИдентификатор() Тогда
		Возврат;
	Иначе
		мПредыдущийИдентификатор = Элементы.ФайлыДерево.ТекущиеДанные.ПолучитьИдентификатор();
	КонецЕсли;
	
	ПодключитьОбработчикОжидания("ОбработчикОжиданияФайлыПриАктивизацииСтроки", 0.1, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ФайлыДеревоПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	Отказ = Истина;
КонецПроцедуры

&НаКлиенте
Процедура ФайлыДеревоПередУдалением(Элемент, Отказ)
	Отказ = Истина;
КонецПроцедуры

&НаКлиенте
Процедура ОбработчикОжиданияФайлыПриАктивизацииСтроки()
	
	ТекущиеДанные = Элементы.ФайлыДерево.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено Тогда
		Если НЕ ТекущиеДанные.ПолучитьРодителя() = Неопределено Тогда			
			АдресФайла = ОбщийМодульВызовСервера.ПолучитьДанныеФайла(ТекущиеДанные.Документ, ТекущиеДанные.ИмяФайла, ТекущиеДанные.Номенклатура, ЭтотОбъект.УникальныйИдентификатор);	
			ОбщийМодульКлиент.ПредпросмотрФайла(АдресФайла, ТекущиеДанные.Расширение, Предпросмотр, Элементы.Предпросмотр);
		Иначе
			Элементы.Предпросмотр.Вид = ВидПоляФормы.ПолеHTMLДокумента;
			Предпросмотр = "";
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ДобавитьФайл(Команда)
	
	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
		ПоказатьПредупреждение(, "Документ не сохранен!");
		Возврат;
	КонецЕсли;
	
	СписокПотолков = ПолучитьСписокПотолков();
	ДополнитьСписокСсылокНаФайлы(СписокПотолков);
	Если НЕ СписокПотолков.Количество() = 0 Тогда
		Оп = Новый ОписаниеОповещения("ПослеВыбораСсылкиДляПрикрепленияФайла", ЭтотОбъект);
		ПоказатьВыборИзМеню(Оп, СписокПотолков, Элементы.ФайлыДобавитьФайл);
		ОбновитьОтображениеЭлементовФормы();
	//Иначе
	//	ПоказатьПредупреждение(,"В товарах и материалах нет потолков и отрезов");
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьСписокПотолков()
	
	СписокНоменклатуры = Новый СписокЗначений;
	ВремДеревоТоваров = РеквизитФормыВЗначение("ДеревоТоваров");
	Для Каждого СтрокаКомнат Из ВремДеревоТоваров.Строки Цикл
		Для Каждого СтрокаНоменклатура Из СтрокаКомнат.Строки Цикл
			Если Справочники.ВидыНоменклатуры.ЭтоНоменклатураПотолкаИлиОтреза(СтрокаНоменклатура.Номенклатура) Тогда
				СписокНоменклатуры.Добавить(СтрокаНоменклатура.Номенклатура);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	ВремДеревоМатериалов = РеквизитФормыВЗначение("ДеревоМатериалов");
	Для Каждого СтрокаКомнат Из ВремДеревоМатериалов.Строки Цикл
		Для Каждого СтрокаНоменклатура Из СтрокаКомнат.Строки Цикл
			Если Справочники.ВидыНоменклатуры.ЭтоНоменклатураПотолкаИлиОтреза(СтрокаНоменклатура.Номенклатура) Тогда
				СписокНоменклатуры.Добавить(СтрокаНоменклатура.Номенклатура);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	Возврат СписокНоменклатуры;
	
КонецФункции

&НаКлиенте
Процедура ПослеВыбораСсылкиДляПрикрепленияФайла(ВыбранныйЭлемент, ДополнительныеПараметры) Экспорт 
	
	Если ВыбранныйЭлемент = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ПослеПрикрепленияФайлаЗавершение", ЭтотОбъект);
	ДопПараметры = Новый Структура("ДействиеПослеПрикрепления", ОписаниеОповещения);
	ОбщийМодульКлиент.ПослеВыбораСсылкиДляПрикрепленияФайла(ВыбранныйЭлемент.Значение, ДопПараметры);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеПрикрепленияФайлаЗавершение(СтруктураРезультата, ДополнительныеПараметры) Экспорт
	
	Если СтруктураРезультата.Результат Тогда
		ОбновитьОтображениеЭлементовФормы();
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ПечататьФайл(Команда)
	
	ВыбранныеЭлементы = Элементы.ФайлыДерево.ВыделенныеСтроки;
	
	//Если НЕ Элементы.Файлы.ТекущиеДанные = Неопределено Тогда
	Если ВыбранныеЭлементы.Количество() > 0 Тогда
		Для каждого ЭлементДляПечати из ВыбранныеЭлементы Цикл
			СтрФайл = ФайлыДерево.НайтиПоИдентификатору(ЭлементДляПечати);
			
			// если выделен корень дерева, то пропускаем
			Если СтрФайл.ПолучитьРодителя() = Неопределено Тогда
				Продолжить;
			КонецЕсли;

			АдресФайла = ОбщийМодульВызовСервера.ПолучитьДанныеФайла(СтрФайл.Документ, СтрФайл.ИмяФайла, СтрФайл.Номенклатура, ЭтотОбъект.УникальныйИдентификатор);
			Если НЕ АдресФайла = Неопределено Тогда // №7253
				ВременноеИмя = ПолучитьИмяВременногоФайла(СтрФайл.Расширение);
				ПолучитьФайл(АдресФайла, ВременноеИмя, Ложь);
				
				Shell = Новый COMОбъект("Shell.Application");
				Shell.ShellExecute(ВременноеИмя, "", "", "print", 0);
			КонецЕсли;
		КонецЦикла;
	Иначе
		ПоказатьПредупреждение(,"Выберите файл(ы) в списке");
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура КомандаОбновитьСписокФайлов(Команда)
	
	//Запомним текущую строку
	ТекущиеДанные = Элементы.ФайлыДерево.ТекущиеДанные;
	
	ОбновитьСписокФайлов();
	
	ИдТекущейСтроки = Неопределено;
	КоллекцияЭлементовДерева = ЭтаФорма.ФайлыДерево.ПолучитьЭлементы();
	Для Каждого Строка Из КоллекцияЭлементовДерева Цикл    
		ИдентификаторСтроки = Строка.ПолучитьИдентификатор();
		Для Каждого ПодчиненнаяСтрока Из Строка.ПолучитьЭлементы() Цикл
			Если ТекущиеДанные <> Неопределено И ПодчиненнаяСтрока.Документ = ТекущиеДанные.Документ И ПодчиненнаяСтрока.Номенклатура = ТекущиеДанные.Номенклатура И ПодчиненнаяСтрока.ИмяФайла = ТекущиеДанные.ИмяФайла Тогда
				ИдТекущейСтроки = ПодчиненнаяСтрока.ПолучитьИдентификатор();
			КонецЕсли;
		КонецЦикла;
		Если ИдТекущейСтроки = Неопределено Тогда
			ИдТекущейСтроки = ИдентификаторСтроки;			
		КонецЕсли;
		Элементы.ФайлыДерево.Развернуть(ИдентификаторСтроки, Истина);
	КонецЦикла;
	Элементы.ФайлыДерево.ТекущаяСтрока = ИдТекущейСтроки;
	
КонецПроцедуры

&НаКлиенте
Процедура УдалитьФайл(Команда)
	
	ОбщийМодульКлиент.УдалитьФайлыВДереве(ЭтаФорма, ФайлыДерево, Элементы.ФайлыДерево);
		
КонецПроцедуры

&НаКлиенте
Процедура ПослеВопросаОбУдаленииФайловВДереве(Результат, Параметры) Экспорт
	
    Если Результат = КодВозвратаДиалога.Нет Тогда
        Возврат;
	КонецЕсли;
	ОбщийМодульВызовСервера.УдалитьФайлыВДереве(Параметры.МассивФайловКУдалению);	
	КомандаОбновитьСписокФайлов(Неопределено);
	
КонецПроцедуры

