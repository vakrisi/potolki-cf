	ЗаполнитьЗначенияСвойств(СтрокаТабличнойЧасти, СтруктураДанные, "ЕдиницаИзмерения, Коэффициент, ВидНоменклатуры, УчитыватьКакПотолок");
	
	//Если СтруктураДанные.ВидНоменклатуры = ПредопределенноеЗначение("Справочник.ВидыНоменклатуры.Услуга") Тогда // #12667 спецификация только для услуг, в рамках той же заявки отменено 
	СтрокаТабличнойЧасти.Спецификация = ?(ЗаполнениеМатериаловПоЗаказам, СтруктураДанные.Спецификация, ПредопределенноеЗначение("Справочник.Спецификации.ПустаяСсылка"));
	//КонецЕсли;
	
	СтруктураДанные = ПолучитьДанныеНоменклатурыПриИзменении(СтруктураДанные);
	ЗаполнитьЗначенияСвойств(СтрокаТабличнойЧасти, СтруктураДанные, "Цена, ЦенаПоПрайсу, ПроцентСкидки, Количество"); //#16345 добавлено Количество 
	
	СтрокаТабличнойЧасти.Бесплатно = Ложь;
	//СтрокаТабличнойЧасти.Цена = ПолучитьЦенуНоменклатуры(СтрокаТабличнойЧасти.Номенклатура, СтрокаТабличнойЧасти.ХарактеристикаНоменклатуры, СтрокаТабличнойЧасти.ЕдиницаИзмерения);
	//СтрокаТабличнойЧасти.ПроцентСкидки = ПолучитьПроцентСкидки(СтрокаТабличнойЧасти.Номенклатура, СтрокаТабличнойЧасти.Количество);
	//СтрокаТабличнойЧасти.ЦенаПоПрайсу = СтрокаТабличнойЧасти.Цена;
	СтрокаТабличнойЧасти.УИСтроки = Новый УникальныйИдентификатор;
	СтрокаТабличнойЧасти.УИСтрокиРодителя = Новый УникальныйИдентификатор;
	РассчитатьСуммуСтроки(СтрокаТабличнойЧасти);
	
	Если Объект.ЗаполнятьУИСтрок И НЕ СтрокаТабличнойЧасти.Спецификация.Пустая() И ЗаполнениеМатериаловПоЗаказам Тогда
		ПерезаполнитьМатериалыПоСпецификации(СтрокаТабличнойЧасти, , "ДобавлениеНоменклатуры");
	КонецЕсли;
	
	СтрокаКомнаты = СтрокаТабличнойЧасти;
	Если НЕ СтрокаТабличнойЧасти.ПолучитьРодителя() = Неопределено Тогда	
		СтрокаКомнаты = СтрокаТабличнойЧасти.ПолучитьРодителя();
	КонецЕсли;
	ИдКомнаты = СтрокаКомнаты.ПолучитьИдентификатор();
	
	Если НЕ СтрокаТабличнойЧасти = Неопределено
		И СтруктураДействийПоСТ.АвтоматическиДобавлятьСопутствующиеТоварыИУслуги
		И ОбщийМодульВызовСервера.ЕстьСопутствующаяНоменклатураВРегистре(СтрокаТабличнойЧасти.Номенклатура, СтрокаТабличнойЧасти.ХарактеристикаНоменклатуры) Тогда
		Если СтруктураДействийПоСТ.ЗапрашиватьПодтверждениеПриИзмененииНоменклатуры Тогда
			ДопПараметры = Новый Структура;
			ДопПараметры.Вставить("Номенклатура", СтрокаТабличнойЧасти.Номенклатура); 
			ДопПараметры.Вставить("ХарактеристикаНоменклатуры", СтрокаТабличнойЧасти.ХарактеристикаНоменклатуры); 
			ДопПараметры.Вставить("УИСтроки", СтрокаТабличнойЧасти.УИСтроки); 
			ДопПараметры.Вставить("Количество", СтрокаТабличнойЧасти.Количество); 
			ДопПараметры.Вставить("ИДКомнаты", ИдКомнаты);
			ПоказатьВопрос(Новый ОписаниеОповещения("ВопросДобавлениеСопутствующейНоменклатуры", ЭтотОбъект, ДопПараметры), "Добавить сопутствующие товары и услуги для номенклтатуры: """ + СтрокаТабличнойЧасти.Номенклатура + """?", РежимДиалогаВопрос.ДаНет);
		Иначе
			ПодборСопутствующейНоменклатуры(ИдКомнаты);
			
			//МассивДобавленнойСП = ДобавитьСопутствующуюНоменклатуру(СтрокаТабличнойЧасти.Номенклатура, СтрокаТабличнойЧасти.ХарактеристикаНоменклатуры, СтрокаТабличнойЧасти.УИСтроки, 	СтрокаТабличнойЧасти.Количество, ИДКомнаты, 0);
			//Для каждого ЭлементДерева Из 	МассивДобавленнойСП Цикл
			//	//ОбновитьОтображениеЭлементовФормы(ЭлементДерева.Комната, ЭлементДерева.Номенклатура);	
			//	Если Объект.ЗаполнятьУИСтрок И НЕ ЭлементДерева.Спецификация.Пустая() И ЗаполнениеМатериаловПоЗаказам Тогда
			//		ПерезаполнитьМатериалыПоСпецификации(ЭлементДерева, , "ДобавлениеНоменклатуры");
			//	КонецЕсли;
			//КонецЦикла;										  
			
		КонецЕсли;
	КонецЕсли;	
	
	ЗаполнитьДанныеКОтгрузкеИОстаткиПоТоварам();
	РассчитатьИтоговыеПоказателиКлиент();
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоТоваровХарактеристикаНоменклатурыОкончаниеВводаТекста(Элемент, Текст, ДанныеВыбора, ПараметрыПолученияДанных, СтандартнаяОбработка)
	
	СтрокаТабличнойЧасти = Элементы.ДеревоТоваров.ТекущиеДанные;
	// Необходимо для обработки выбора пустого значения.
	Если ПараметрыПолученияДанных.СтрокаПоиска="" И НЕ СтрокаТабличнойЧасти.ХарактеристикаНоменклатуры = ПредопределенноеЗначение("Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка")  Тогда
		Элементы.ДеревоТоваров.ЗакончитьРедактированиеСтроки (Ложь); 
		ДеревоТоваровХарактеристикаНоменклатурыОбработкаВыбора(Элемент, ПредопределенноеЗначение("Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка"), СтандартнаяОбработка);
		//СтандартнаяОбработка = Ложь;
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоТоваровХарактеристикаНоменклатурыОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	СтрокаТабличнойЧасти = Элементы.ДеревоТоваров.ТекущиеДанные;
	// Если характеристика фактически не изменилась тогда ничего не делаем
	Если СтрокаТабличнойЧасти.ХарактеристикаНоменклатуры <> ВыбранноеЗначение Тогда
		Если СтруктураДействийПоСТ.АвтоматическиДобавлятьСопутствующиеТоварыИУслуги	Тогда
			МассивСопутствующихТоваровНаУдаление = ОбщийМодульКлиент.ПолучитьСвязанныеСопутствующиеТоварыПоВыделеннымСтрокам(Элементы.ДеревоТоваров, ДеревоТоваров);	
			Если МассивСопутствующихТоваровНаУдаление.Количество() > 0 Тогда 
				Если СтруктураДействийПоСТ.ЗапрашиватьПодтверждениеПриИзмененииНоменклатуры Тогда
					ДопПараметры = Новый Структура;
					ДопПараметры.Вставить("МассивСопутствующихТоваровНаУдаление", МассивСопутствующихТоваровНаУдаление);
					ДопПараметры.Вставить("СтрокаХарактеристикиТабличнойЧасти", СтрокаТабличнойЧасти);
					ПоказатьВопрос(Новый ОписаниеОповещения("ВопросУдалениеСопутствующейНоменклатуры", ЭтотОбъект, ДопПараметры), "Удалить сопутствующие товары и услуги" + Символы.ПС + "измененной номенклатуры """ + СтрокаТабличнойЧасти.Номенклатура + """" +  ?(ЗначениеЗаполнено(СтрокаТабличнойЧасти.ХарактеристикаНоменклатуры), Символы.ПС + "Характеристика """ + СтрокаТабличнойЧасти.ХарактеристикаНоменклатуры + """", "") + "?", РежимДиалогаВопрос.ДаНет);			
					СтрокаТабличнойЧасти.ХарактеристикаНоменклатуры = ВыбранноеЗначение;
					СтандартнаяОбработка = Ложь;
				Иначе
					ОбщийМодульКлиент.УдалитьСопутствующиеТовары(ДеревоТоваров, МассивСопутствующихТоваровНаУдаление);
					МассивСопутствующихТоваровНаУдаление.Очистить();
					РассчитатьИтоговыеПоказателиКлиент();
				КонецЕсли;
			Иначе
				СтрокаТабличнойЧасти.ХарактеристикаНоменклатуры = ВыбранноеЗначение;
				ДеревоТоваровХарактеристикаНоменклатурыПриИзменении(СтрокаТабличнойЧасти);
				СтандартнаяОбработка = Ложь;
			КонецЕсли;
		Иначе
			СтрокаТабличнойЧасти.ХарактеристикаНоменклатуры = ВыбранноеЗначение;
			ДеревоТоваровХарактеристикаНоменклатурыПриИзменении(СтрокаТабличнойЧасти);
			СтандартнаяОбработка = Ложь;
		КонецЕсли;	
	Иначе
		СтандартнаяОбработка = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоТоваровХарактеристикаНоменклатурыПриИзменении(Элемент)
	
	//корневые строки редактировать нельзя
	Если Элементы.ДеревоТоваров.ТекущиеДанные.ПолучитьРодителя() = Неопределено Тогда
		Элементы.ДеревоТоваров.ТекущиеДанные.Номенклатура = Неопределено;
		Возврат;
	КонецЕсли;
	
	СтрокаТабличнойЧасти = Элементы.ДеревоТоваров.ТекущиеДанные;
	СтрокаТабличнойЧасти.Цена = ПолучитьЦенуНоменклатуры(СтрокаТабличнойЧасти.Номенклатура, СтрокаТабличнойЧасти.ХарактеристикаНоменклатуры, СтрокаТабличнойЧасти.ЕдиницаИзмерения);
	СтрокаТабличнойЧасти.ЦенаПоПрайсу = СтрокаТабличнойЧасти.Цена;
	СтрокаТабличнойЧасти.УИСтроки = Новый УникальныйИдентификатор;
	СтрокаТабличнойЧасти.УИСтрокиРодителя = Неопределено;
	РассчитатьСуммуСтроки(СтрокаТабличнойЧасти);
	
	СтрокаКомнаты = СтрокаТабличнойЧасти;
	Если НЕ СтрокаТабличнойЧасти.ПолучитьРодителя() = Неопределено Тогда	
		СтрокаКомнаты = СтрокаТабличнойЧасти.ПолучитьРодителя();
	КонецЕсли;
	ИдКомнаты = СтрокаКомнаты.ПолучитьИдентификатор();
	
	Если НЕ СтрокаТабличнойЧасти = Неопределено
		И СтруктураДействийПоСТ.АвтоматическиДобавлятьСопутствующиеТоварыИУслуги
		И ОбщийМодульВызовСервера.ЕстьСопутствующаяНоменклатураВРегистре(СтрокаТабличнойЧасти.Номенклатура, СтрокаТабличнойЧасти.ХарактеристикаНоменклатуры) Тогда
		Если СтруктураДействийПоСТ.ЗапрашиватьПодтверждениеПриДобавленииНоменклатуры Тогда
			ДопПараметры = Новый Структура;
			ДопПараметры.Вставить("Номенклатура", СтрокаТабличнойЧасти.Номенклатура); 
			ДопПараметры.Вставить("ХарактеристикаНоменклатуры", СтрокаТабличнойЧасти.ХарактеристикаНоменклатуры); 
			ДопПараметры.Вставить("УИСтроки", СтрокаТабличнойЧасти.УИСтроки); 
			ДопПараметры.Вставить("Количество", СтрокаТабличнойЧасти.Количество); 
			ДопПараметры.Вставить("ИДКомнаты", ИдКомнаты);
			Если ЗначениеЗаполнено(СтрокаТабличнойЧасти.ХарактеристикаНоменклатуры) Тогда
				ДляВопросаОНоменклатуре = ", характеристика: """ + СтрокаТабличнойЧасти.ХарактеристикаНоменклатуры + """";
			Иначе
				ДляВопросаОНоменклатуре = "";
			КонецЕсли;
			ПоказатьВопрос(Новый ОписаниеОповещения("ВопросДобавлениеСопутствующейНоменклатуры", ЭтотОбъект, ДопПараметры), "Добавить сопутствующие товары и услуги для" + Символы.ПС + "номенклатуры: """ + СтрокаТабличнойЧасти.Номенклатура + """" + ДляВопросаОНоменклатуре + "?", РежимДиалогаВопрос.ДаНет);
		Иначе
			ПодборСопутствующейНоменклатуры(ИдКомнаты);
			
			//МассивДобавленнойСП = ДобавитьСопутствующуюНоменклатуру(СтрокаТабличнойЧасти.Номенклатура, СтрокаТабличнойЧасти.ХарактеристикаНоменклатуры, СтрокаТабличнойЧасти.УИСтроки, 	СтрокаТабличнойЧасти.Количество, ИДКомнаты, 0);
			//Для каждого ЭлементДерева Из МассивДобавленнойСП Цикл
			//	//ОбновитьОтображениеЭлементовФормы(ЭлементДерева.Комната, ЭлементДерева.Номенклатура);	
			//	Если Объект.ЗаполнятьУИСтрок И НЕ ЭлементДерева.Спецификация.Пустая() И ЗаполнениеМатериаловПоЗаказам Тогда
			//		ПерезаполнитьМатериалыПоСпецификации(ЭлементДерева, , "ДобавлениеНоменклатуры");
			//	КонецЕсли;
			//КонецЦикла;										  
			
		КонецЕсли;
	КонецЕсли;	
	
	ЗаполнитьДанныеКОтгрузкеИОстаткиПоТоварам();
	РассчитатьИтоговыеПоказателиКлиент();
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоТоваровЕдиницаИзмеренияПриИзменении(Элемент)
	//корневые строки редактировать нельзя
	Если Элементы.ДеревоТоваров.ТекущиеДанные.ПолучитьРодителя() = Неопределено Тогда
		Элементы.ДеревоТоваров.ТекущиеДанные.ЕдиницаИзмерения = Неопределено;
		Возврат;
	КонецЕсли;
	
	СтрокаТабличнойЧасти = Элементы.ДеревоТоваров.ТекущиеДанные;
	СтрокаТабличнойЧасти.Цена = ПолучитьЦенуНоменклатуры(СтрокаТабличнойЧасти.Номенклатура, СтрокаТабличнойЧасти.ХарактеристикаНоменклатуры, СтрокаТабличнойЧасти.ЕдиницаИзмерения);
	Если ТипЗнч(СтрокаТабличнойЧасти.ЕдиницаИзмерения) = Тип("СправочникСсылка.КлассификаторЕдиницИзмерения") Тогда
		СтрокаТабличнойЧасти.Коэффициент = 1;
	Иначе
		СтрокаТабличнойЧасти.Коэффициент = ОбщийМодуль.ПолучитьКоэффициентЕдиницыИзмерения(СтрокаТабличнойЧасти.ЕдиницаИзмерения);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ДеревоТоваровЕдиницаИзмеренияНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	СтрокаТабличнойЧасти = Элементы.ДеревоТоваров.ТекущиеДанные;
	СписокЕдиниц = ОбщийМодуль.ПолучитьСписокЕдиницИзмеренияНоменклатуры(СтрокаТабличнойЧасти.Номенклатура);
	
	ДанныеВыбора = Новый СписокЗначений;
	Для Ном = 0 По СписокЕдиниц.Количество() - 1 Цикл
		ДанныеВыбора.Добавить(СписокЕдиниц[Ном]);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоТоваровЕдиницаИзмеренияОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	СтрокаТабличнойЧасти = Элементы.ДеревоТоваров.ТекущиеДанные;
	Если ТипЗнч(ВыбранноеЗначение) = Тип("СправочникСсылка.КлассификаторЕдиницИзмерения") Тогда
		СтрокаТабличнойЧасти.Коэффициент = 1;
	Иначе
		СтрокаТабличнойЧасти.Коэффициент = ОбщийМодуль.ПолучитьКоэффициентЕдиницыИзмерения(ВыбранноеЗначение);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ДеревоТоваровКоличествоПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ДеревоТоваров.ТекущиеДанные;
	
	//корневые строки редактировать нельзя
	Если ТекущиеДанные.ПолучитьРодителя() = Неопределено Тогда
		ТекущиеДанные.Количество = 0;
		Возврат;
	КонецЕсли;
	
	РодительЭлемент = ТекущиеДанные.ПолучитьРодителя();
	ИдКомнаты = РодительЭлемент.ПолучитьИдентификатор();
	
	//#16345
	Если ИспользоватьКонтрольКратности Тогда
		СтруктураДанные = СтруктураДанныхПоСтрокеТабличнойЧасти(ТекущиеДанные);
		ОтказВИзмененииКоличества = Ложь;
		ПроверитьКратностьЕдиницИзмеренияНаСервере(СтруктураДанные, ОтказВИзмененииКоличества);
		Если ОтказВИзмененииКоличества Тогда
			ТекущиеДанные.Количество = 0;
		КонецЕсли;
	КонецЕсли;
	
	ПроцентАвтоматическойСкидки = ПолучитьПроцентАвтоматическойСкидкиСервер(ИспользоватьАвтоматическиеСкидки, Объект.Дата, ТекущиеДанные.Номенклатура, ТекущиеДанные.Количество);
	Если НЕ ПроцентАвтоматическойСкидки = 0 Тогда
		ПоказатьВопрос(Новый ОписаниеОповещения("ПослеВопросаОбИзмененииАвтоматическойСкидки",ЭтаФорма, ТекущиеДанные), "Изменить скидку согласно настроек автоматических скидок?",РежимДиалогаВопрос.ДаНет);
	Иначе
		ПослеИзмененияКоличестваТоваров(ТекущиеДанные, Ложь);
	КонецЕсли;
	
	ТекущаяСтрока = Элементы.ДеревоТоваров.ТекущиеДанные;
	
	Если НЕ ТекущаяСтрока.Спецификация.Пустая() 
		//И ЕстьМатериалыПоТекущейПозиции(ТекущаяСтрока.Номенклатура, ТекущаяСтрока.УИСтроки) 
		И ЗаполнениеМатериаловПоЗаказам Тогда
		ПерезаполнитьМатериалыПоСпецификации(ТекущаяСтрока, , "ИзменениеКоличества");
	КонецЕсли;
	
	Если СтруктураДействийПоСТ.АвтоматическиДобавлятьСопутствующиеТоварыИУслуги	Тогда
		МассивСопутствующихТоваров = ОбщийМодульКлиент.ПолучитьСвязанныеСопутствующиеТоварыПоВыделеннымСтрокам(Элементы.ДеревоТоваров, ДеревоТоваров);
		КоличествоСопутствующихТоваровВРегистре = ОбщийМодульВызовСервера.ЕстьСопутствующаяНоменклатураВРегистре(ТекущиеДанные.Номенклатура, ТекущиеДанные.ХарактеристикаНоменклатуры, Истина);
		ТребуетсяДополнить = ?(МассивСопутствующихТоваров.Количество() < КоличествоСопутствующихТоваровВРегистре, Истина, Ложь);
		Если МассивСопутствующихТоваров.Количество() > 0 Тогда		
			Если СтруктураДействийПоСТ.ЗапрашиватьПодтверждениеПриИзмененииКоличества Тогда
				ДопПараметры = Новый Структура;
				ДопПараметры.Вставить("Номенклатура", ТекущаяСтрока.Номенклатура); 
				ДопПараметры.Вставить("ХарактеристикаНоменклатуры", ТекущаяСтрока.ХарактеристикаНоменклатуры); 
				ДопПараметры.Вставить("УИСтроки", ТекущаяСтрока.УИСтроки); 
				ДопПараметры.Вставить("Количество", ТекущаяСтрока.Количество); 
				ДопПараметры.Вставить("ИДКомнаты", ИДкомнаты);
				ДопПараметры.Вставить("ТребуетсяДополнить", ТребуетсяДополнить);
				Если ЗначениеЗаполнено(ТекущаяСтрока.ХарактеристикаНоменклатуры) Тогда
					ДляВопросаОНоменклатуре = ", характеристика: """ + ТекущаяСтрока.ХарактеристикаНоменклатуры + """";
				Иначе
					ДляВопросаОНоменклатуре = "";
				КонецЕсли;
				ПоказатьВопрос(Новый ОписаниеОповещения("ВопросИзменениеКоличестваСопутствующейНоменклатуры", ЭтотОбъект, ДопПараметры), "Изменить количество сопутствующих товаров и услуг для" + Символы.ПС + "номенклатуры: """ + ТекущаяСтрока.Номенклатура + """" + ДляВопросаОНоменклатуре + "?", РежимДиалогаВопрос.ДаНет);
			Иначе
				Если ТребуетсяДополнить Тогда
					Если СтруктураДействийПоСТ.ЗапрашиватьПодтверждениеПриДобавленииНоменклатуры Тогда
						ДопПараметры = Новый Структура;
						ДопПараметры.Вставить("Номенклатура", ТекущаяСтрока.Номенклатура); 
						ДопПараметры.Вставить("ХарактеристикаНоменклатуры", ТекущаяСтрока.ХарактеристикаНоменклатуры); 
						ДопПараметры.Вставить("УИСтроки", ТекущаяСтрока.УИСтроки); 
						ДопПараметры.Вставить("Количество", ТекущаяСтрока.Количество); 
						ДопПараметры.Вставить("ИДКомнаты", ИдКомнаты);
						ПоказатьВопрос(Новый ОписаниеОповещения("ВопросДобавлениеСопутствующейНоменклатуры", ЭтотОбъект, ДопПараметры), "Добавить сопутствующие товары и услуги для номенклтатуры: """ + ТекущаяСтрока.Номенклатура + """?", РежимДиалогаВопрос.ДаНет);
					Иначе
						ПодборСопутствующейНоменклатуры(ИДКомнаты);
						ЗаполнитьДанныеКОтгрузкеИОстаткиПоТоварам();
						РассчитатьИтоговыеПоказателиКлиент();
					КонецЕсли;
				КонецЕсли;	
				// Изменяем количество сопуттвующей номенклатуры с дополнением отсутствующей
				ИзмененныеСтроки = ОбщийМодульКлиент.ИзменитьКоличествоСопутствущихТоваров(ДеревоТоваров, ТекущаяСтрока.Номенклатура, ТекущаяСтрока.ХарактеристикаНоменклатуры, ТекущаяСтрока.УИСтроки, ТекущаяСтрока.Количество, ИдКомнаты);
				Для каждого СтрокаТовара Из ИзмененныеСтроки Цикл
					ПослеИзмененияКоличестваТоваров(СтрокаТовара, Ложь);
				КонецЦикла;	
			КонецЕсли;
		Иначе
			Если ОбщийМодульВызовСервера.ЕстьСопутствующаяНоменклатураВРегистре(ТекущаяСтрока.Номенклатура, ТекущаяСтрока.ХарактеристикаНоменклатуры) Тогда
				Если СтруктураДействийПоСТ.ЗапрашиватьПодтверждениеПриДобавленииНоменклатуры Тогда
					ДопПараметры = Новый Структура;
					ДопПараметры.Вставить("Номенклатура", ТекущаяСтрока.Номенклатура); 
					ДопПараметры.Вставить("ХарактеристикаНоменклатуры", ТекущаяСтрока.ХарактеристикаНоменклатуры); 
					ДопПараметры.Вставить("УИСтроки", ТекущаяСтрока.УИСтроки); 
					ДопПараметры.Вставить("Количество", ТекущаяСтрока.Количество); 
					ДопПараметры.Вставить("ИДКомнаты", ИДкомнаты);
					Если ЗначениеЗаполнено(ТекущаяСтрока.ХарактеристикаНоменклатуры) Тогда
						ДляВопросаОНоменклатуре = ", характеристика: """ + ТекущаяСтрока.ХарактеристикаНоменклатуры + """";
					Иначе
						ДляВопросаОНоменклатуре = "";
					КонецЕсли;
					ПоказатьВопрос(Новый ОписаниеОповещения("ВопросДобавлениеСопутствующейНоменклатуры", ЭтотОбъект, ДопПараметры), "Добавить сопутствующие товары и услуги для" + Символы.ПС + "номенклатуры: """ + ТекущаяСтрока.Номенклатура + """" + ДляВопросаОНоменклатуре +"?", РежимДиалогаВопрос.ДаНет);
				Иначе
					ПодборСопутствующейНоменклатуры(ИДКомнаты);
					ЗаполнитьДанныеКОтгрузкеИОстаткиПоТоварам();
					РассчитатьИтоговыеПоказателиКлиент();	
				КонецЕсли;
			КонецЕсли;	
		КонецЕсли;
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ВопросИзменениеКоличестваСопутствующейНоменклатуры(РезультатВопроса, ДополнительныеПараметры) Экспорт	
	
	// Если не нужно изменять количество сопутствующей номенклатуры и не требуется дополнять недостающую номенклатуру
	Если НЕ РезультатВопроса = КодВозвратаДиалога.Да И НЕ ДополнительныеПараметры.ТребуетсяДополнить Тогда
		Возврат;
	КонецЕсли;
	
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		ИзмененныеСтроки = ОбщийМодульКлиент.ИзменитьКоличествоСопутствущихТоваров(ДеревоТоваров, ДополнительныеПараметры.Номенклатура, ДополнительныеПараметры.ХарактеристикаНоменклатуры, ДополнительныеПараметры.УИСтроки, ДополнительныеПараметры.Количество, ДополнительныеПараметры.ИдКомнаты);
		Для каждого СтрокаТовара Из ИзмененныеСтроки Цикл
			ПослеИзмененияКоличестваТоваров(СтрокаТовара, Ложь);
		КонецЦикла;	
	КонецЕсли;
	
	Если ДополнительныеПараметры.ТребуетсяДополнить Тогда
		Если ЗначениеЗаполнено(ДополнительныеПараметры.ХарактеристикаНоменклатуры) Тогда
			ДляВопросаОНоменклатуре = ", характеристика: """ + ДополнительныеПараметры.ХарактеристикаНоменклатуры + """";
		Иначе
			ДляВопросаОНоменклатуре = "";
		КонецЕсли;
		ПоказатьВопрос(Новый ОписаниеОповещения("ВопросДобавлениеНедостающейСопутствующейНоменклатуры", ЭтотОбъект, ДополнительныеПараметры), "Добавить недостающие сопутствующие товары и услуги для" + Символы.ПС + "номенклатуры: """ + ДополнительныеПараметры.Номенклатура + """" + ДляВопросаОНоменклатуре + "?", РежимДиалогаВопрос.ДаНет);
	КонецЕсли;
	
КонецПроцедуры


&НаКлиенте
Процедура ВопросДобавлениеНедостающейСопутствующейНоменклатуры(РезультатВопроса, ДополнительныеПараметры) Экспорт	
	
	Если РезультатВопроса = КодВозвратаДиалога.Да  Тогда
		// МассивДобавленнойСП = ДобавитьСопутствующуюНоменклатуру(ДополнительныеПараметры.Номенклатура, ДополнительныеПараметры.ХарактеристикаНоменклатуры, ДополнительныеПараметры.УИСтроки, ДополнительныеПараметры.Количество, ДополнительныеПараметры.ИДКомнаты, 0);
		ПодборСопутствующейНоменклатуры(ДополнительныеПараметры.ИДКомнаты);
		//Для каждого ЭлементДерева Из МассивДобавленнойСП Цикл
		//	//ОбновитьОтображениеЭлементовФормы(ЭлементДерева.Комната, ЭлементДерева.Номенклатура);	
		//	Если Объект.ЗаполнятьУИСтрок И НЕ ЭлементДерева.Спецификация.Пустая() И ЗаполнениеМатериаловПоЗаказам Тогда
		//		ПерезаполнитьМатериалыПоСпецификации(ЭлементДерева, , "ДобавлениеНоменклатуры");
		//	КонецЕсли;
		//КонецЦикла;
		ЗаполнитьДанныеКОтгрузкеИОстаткиПоТоварам();
		РассчитатьИтоговыеПоказателиКлиент();
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандДереваТоваров

&НаКлиенте
Процедура ДобавитьКомнату(Команда)
	
	ПараметрыДобавления = Новый Структура;
	ПараметрыДобавления.Вставить("Форма", ЭтаФорма);
	ПараметрыДобавления.Вставить("ПереключательНаНазваниеКомнат", ПереключательНаНазваниеКомнат);
	ОбщийМодульКлиент.Розница_ДобавитьКомнату(ПараметрыДобавления);
	
КонецПроцедуры

&НаКлиенте
Процедура ПодобратьНоменклатуру(Команда)
	
	ТекущиеДанные = Элементы.ДеревоТоваров.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		ПоказатьОповещениеПользователя("Выберите комнату");
		Возврат;
	КонецЕсли;	
	
	Если ПустаяСтрока(ТекущиеДанные.Комната) Тогда		
		ПоказатьОповещениеПользователя("Выберите комнату");
		Возврат;
	КонецЕсли;
	
	ПараметрыПодбора = ПараметрыПодбора();
	ОткрытьФорму("ОбщаяФорма.ФормаПодбораНоменклатуры", ПараметрыПодбора, ЭтаФорма, УникальныйИдентификатор);
	
КонецПроцедуры

// вызывается:
// - по ОбработкаВыбора из формы подбора                      ИсточникВызова = "Подбор"
// - по ЗаполнитьКомнатуПоШаблонуЗавершение                                    "ЗаполнениеПоШаблону"
// - по ОбработкаВыбора из формы СопутствующиеТоварыИУслуги                    "ДобавлениеСопутки"
&НаКлиенте
Процедура ОбработкаВыбораПодборНаКлиенте(ВыбранноеЗначение, ИсточникВызова, ЗаполнятьПоСпецификации = Истина, ПерезаполнятьЦены = Ложь)

	Если Не ЗначениеЗаполнено(ВыбранноеЗначение) Тогда
		Возврат;
	КонецЕсли;
	
	ТекущаяСтрока = Элементы.ДеревоТоваров.ТекущиеДанные;
	ТекущаяКомната = ТекущаяСтрока.Комната;	
	
	//Удаляем сопутствующие товары для текущей номенклатуры без подтверждения
	//МассивСопутствующихТоваровНаУдаление = ОбщийМодульКлиент.ПолучитьСвязанныеСопутствующиеТоварыПоВыделеннымСтрокам(Элементы.ДеревоТоваров, ДеревоТоваров);
	//ОбщийМодульКлиент.УдалитьСопутствующиеТовары(ДеревоТоваров, МассивСопутствующихТоваровНаУдаление);
	
	МассивНоменклатурДляЗаполненияПоСпецификации = ОбработатьПодборНаСервере(ВыбранноеЗначение, ТекущаяКомната, ИсточникВызова, ПерезаполнятьЦены);
		
	ПеренестиДеревоВТабличнуюЧасть();
	ЗаполнитьДанныеКОтгрузкеИОстаткиПоТоварам();
	РазвернутьДеревоТоваров(ТекущаяКомната);
	РассчитатьИтоговыеПоказателиКлиент();
	ОбновитьОтображениеЭлементовФормы(ТекущаяКомната, Неопределено);
	
	Если ЗаполнятьПоСпецификации
		И Объект.ЗаполнятьУИСтрок 
		И МассивНоменклатурДляЗаполненияПоСпецификации.Количество() > 0 
		И ЗаполнениеМатериаловПоЗаказам Тогда
		ПерезаполнитьМатериалыПоСпецификации(ТекущаяСтрока, МассивНоменклатурДляЗаполненияПоСпецификации, "ДобавлениеНоменклатуры");
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ОбработатьПодборНаСервере(ВыбранноеЗначение, ИмяТекущейКомнаты, ИсточникВызова, ПерезаполнятьЦены = Ложь)
	
	МассивНоменклатурДляЗаполненияПоСпецификации = Новый Массив;
	ТаблицаТоваров = ПолучитьИзВременногоХранилища(ВыбранноеЗначение.АдресВХранилище);
	
	//++ #16036 
	//ТаблицаТоваров.Колонки.Добавить("Уровень");
	//ТаблицаТоваров.Колонки.Добавить("Родитель");
	//Для каждого Строка из ТаблицаТоваров Цикл
	//	Строка.Уровень = 0;
	//КонецЦикла;	
	//
	//Индекс = 0;
	//Если ДобавлятьСопуствующуюНоменклатуру Тогда
	//	Пока Индекс < ТаблицаТоваров.Количество() Цикл
	//		Если ТаблицаТоваров[Индекс].Уровень < Константы.ДопустимаяГлубинаВложенностиСопутствующихТоваровИУслуг.Получить() Тогда
	//			ДобавитьСопуствующуюНоменклатуру(ТаблицаТоваров, Индекс);
	//		КонецЕсли;
	//		Индекс =Индекс + 1;
	//	КонецЦикла
	//КонецЕсли;
	//-- #16036 
		
	Дерево = ДанныеФормыВЗначение(ДеревоТоваров, Тип("ДеревоЗначений"));
	СтрокиКомнат = Дерево.Строки;
	
	СтрокаКомнаты = СтрокиКомнат.Найти(ИмяТекущейКомнаты, "Комната", Ложь);
	
	УИСтрокиПодбора = Неопределено;
	
	//Для Каждого Строка из Дерево.Строки Цикл
	Для Каждого ТекущаяСтрока из ТаблицаТоваров Цикл
		Если ИсточникВызова = "ДобавлениеСопутки" Тогда
			// комнату определяем на каждом шаге, так как могла выделить разные позиции разных комнат
			СтрокаРодителяСТ = СтрокиКомнат.Найти(ТекущаяСтрока.УИСтрокиРодителя, "УИСтроки", Истина);
			СтрокаКомнаты = СтрокаРодителяСТ.Родитель;
			
			Если НЕ ТекущаяСтрока.УИСтрокиПодбора = УИСтрокиПодбора Тогда
				УИСтрокиПодбора = ТекущаяСтрока.УИСтрокиПодбора;
				ИндексСтроки = СтрокаКомнаты.Строки.Индекс(СтрокаРодителяСТ) + 1;
			Иначе
				ИндексСтроки = ИндексСтроки + 1;
			КонецЕсли;			
		КонецЕсли;
		
		СтрокиПозиций = СтрокаКомнаты.Строки;
		
		Если ИсточникВызова = "ДобавлениеСопутки" Тогда
			СтрокаТабличнойЧасти = СтрокиПозиций.Вставить(ИндексСтроки);
		Иначе
			СтрокаТабличнойЧасти = СтрокиПозиций.Добавить();			
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(СтрокаТабличнойЧасти, ТекущаяСтрока);
		СтрокаТабличнойЧасти.Комната = СтрокаКомнаты.Комната;
		СтрокаТабличнойЧасти.Уровень = 1;
		
		//СтруктураДанные = Новый Структура("Номенклатура, ВидСпецификации", СтрокаТабличнойЧасти.Номенклатура, ВидСпецификацииПоУмолчанию);
		СтруктураДанные = СтруктураДанныхПоСтрокеТабличнойЧастиСервер(СтрокаТабличнойЧасти);
		СтруктураДанные = ОбщийМодульВызовСервера.ПолучитьДанныеНоменклатурыПриИзменении(СтруктураДанные);	
		ЗаполнитьЗначенияСвойств(СтрокаТабличнойЧасти, СтруктураДанные, "ВидНоменклатуры, УчитыватьКакПотолок");
		
		СтруктураДанные = ПолучитьДанныеНоменклатурыПриИзменении(СтруктураДанные);
		Если ИсточникВызова = "Подбор" ИЛИ ИсточникВызова = "ДобавлениеСопутки" Тогда //ЭтоПодбор Тогда
			ЗаполнитьЗначенияСвойств(СтрокаТабличнойЧасти, СтруктураДанные, "ЦенаПоПрайсу, ПроцентСкидки");
		Иначе
			ЗаполнитьЗначенияСвойств(СтрокаТабличнойЧасти, СтруктураДанные, "ЦенаПоПрайсу, ПроцентСкидки, Количество"); //#16345 добавлено количество
		КонецЕсли;
		
		//СтрокаТабличнойЧасти.ПроцентСкидки = ПолучитьПроцентСкидки(СтрокаТабличнойЧасти.Номенклатура, СтрокаТабличнойЧасти.Количество);
		//Если Справочники.ВидыНоменклатуры.ЭтоНоменклатураУслуга(СтрокаТабличнойЧасти.Номенклатура) Тогда // #12667 спецификация только для услуг, в рамках той же заявки отменено
		СтрокаТабличнойЧасти.Спецификация = ?(ЗаполнениеМатериаловПоЗаказам, СтруктураДанные.Спецификация, ПредопределенноеЗначение("Справочник.Спецификации.ПустаяСсылка"));				
		//КонецЕсли;
		Если Справочники.ВидыНоменклатуры.ЭтоНоменклатураПотолкаИлиОтреза(СтрокаТабличнойЧасти.Номенклатура) 
			ИЛИ ПерезаполнятьЦены Тогда
			СтрокаТабличнойЧасти.Цена = СтруктураДанные.Цена;
		КонецЕсли;
		
		Если УчитыватьНДС Тогда
			СтрокаТабличнойЧасти.СтавкаНДС = Объект.СтавкаНДС;
		КонецЕсли;
		
		//РассчитатьСуммуСтрокиНаСервере(Стр);
		ОбработкаТабличныхЧастейКлиентСервер.ПересчитатьСуммуРучнойСкидкиВСтрокеТЧ(СтрокаТабличнойЧасти, "ПроцентСкидки", "СуммаСкидки");
		ОбработкаТабличныхЧастейКлиентСервер.ПересчитатьСуммуСУчетомСкидокВСтрокеТЧ(СтрокаТабличнойЧасти, Ложь, "СуммаСкидки");
		ОбработкаТабличныхЧастейКлиентСервер.ПересчитатьСуммуПоПрайсуВСтрокеТЧ(СтрокаТабличнойЧасти);
		ОбработкаТабличныхЧастейКлиентСервер.ПересчитатьСуммуНДСВСтрокеТЧ(СтрокаТабличнойЧасти, УчитыватьНДС);
		
		Если ПустаяСтрока(СтрокаТабличнойЧасти.УИСтроки) Тогда
			// при подборе сопутствующих уже заполнено
			СтрокаТабличнойЧасти.УИСтроки = Строка(Новый УникальныйИдентификатор);
		КонецЕсли;
		Если НЕ СтрокаТабличнойЧасти.Спецификация.Пустая() Тогда
			МассивНоменклатурДляЗаполненияПоСпецификации.Добавить(
					Новый Структура("Комната, Номенклатура, ХарактеристикаНоменклатуры, ЕдиницаИзмерения, Количество, Коэффициент, Спецификация, УИСтроки",
			СтрокаТабличнойЧасти.Комната, СтрокаТабличнойЧасти.Номенклатура, СтрокаТабличнойЧасти.ХарактеристикаНоменклатуры, СтрокаТабличнойЧасти.ЕдиницаИзмерения,
			СтрокаТабличнойЧасти.Количество, СтрокаТабличнойЧасти.Коэффициент, СтрокаТабличнойЧасти.Спецификация, СтрокаТабличнойЧасти.УИСтроки));					
		КонецЕсли;
										
	КонецЦикла;			

	ЗначениеВДанныеФормы(Дерево, ДеревоТоваров);	
	
	Возврат МассивНоменклатурДляЗаполненияПоСпецификации;
	
КонецФункции

