	МассивРеквизитов.Добавить("ДеревоТоваровСтавкаНДС");
	МассивРеквизитов.Добавить("ДеревоТоваровСуммаНДС");
		
	ОбщийМодульСервер.УстановитьВидимостьЭлементовПоМассиву(
		Элементы,
		МассивРеквизитов,
		?(ЭтоРекламация, Неопределено, МассивРеквизитов));
		
