	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьНадписьТекущегоДолгаКонтрагента()
	ТекущийДолг = ПолучитьСуммуТекущегоДолга();
	ТекущийДолгОбщий = ПолучитьСуммуТекущегоОбщегоДолга();
	Если ТекущийДолг > 0 Тогда
		Элементы.ТекущийДолг.ЦветТекста = WebЦвета.Красный;
		Элементы.ТекущийДолг.Шрифт = Новый Шрифт(Элементы.ТекущийДолг.Шрифт, ,,Истина);
	Иначе
		Элементы.ТекущийДолг.ЦветТекста = WebЦвета.ТемноЗеленый;
		Элементы.ТекущийДолг.Шрифт = Новый Шрифт(Элементы.ТекущийДолг.Шрифт, ,,Ложь);
	КонецЕсли;
	Если ТекущийДолгОбщий > 0 Тогда
		Элементы.ТекущийДолгОбщий.ЦветТекста = WebЦвета.Красный;
		Элементы.ТекущийДолгОбщий.Шрифт = Новый Шрифт(Элементы.ТекущийДолгОбщий.Шрифт, ,,Истина);
	Иначе
		Элементы.ТекущийДолгОбщий.ЦветТекста = WebЦвета.ТемноЗеленый;
		Элементы.ТекущийДолгОбщий.Шрифт = Новый Шрифт(Элементы.ТекущийДолгОбщий.Шрифт, ,,Ложь);
	КонецЕсли;
	
	Если РаботаСВалютой.ОтображатьЗадолженностьКонтрагентаВВалюте() Тогда
		Элементы.ДолгВВалюте.Видимость = Истина;
		ДолгВВалюте = РаботаСВалютой.ПолучитьТекстНадписиДолгаКонтрагентаВВалютеОтображенияЗадолженности(, Объект.Контрагент, Объект.Организация);
	Иначе
		Элементы.ДолгВВалюте.Видимость = Ложь;
	КонецЕсли;
КонецПроцедуры

