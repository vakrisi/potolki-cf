&НаСервереБезКонтекста
Функция ПолучитьПроцентАвтоматическойСкидкиСервер(ИспользоватьАвтоматическиеСкидки, Дата, Номенклатура, Количество)
	//ВыборкаСкидок = РегистрыСведений.ЗначенияАвтоматическихСкидок.ПолучитьПоследнее(Объект.Дата, Новый Структура("Номенклатура", Номенклатура));
	
	Скидка = 0;
	
	Если ИспользоватьАвтоматическиеСкидки Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЗначенияАвтоматическихСкидокСрезПоследних.КоличествоОт,
		|	ЗначенияАвтоматическихСкидокСрезПоследних.РазмерСкидки
		|ИЗ
		|	РегистрСведений.ЗначенияАвтоматическихСкидок.СрезПоследних(&Дата, Номенклатура = &Номенклатура) КАК ЗначенияАвтоматическихСкидокСрезПоследних";
		Запрос.УстановитьПараметр("Дата", Дата);
		Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
		РезультатЗапроса = Запрос.Выполнить();
		
		Если РезультатЗапроса.Пустой() Тогда 
			Возврат Скидка;
		КонецЕсли;
		
		ТаблицаСкидок = РезультатЗапроса.Выгрузить();
		ТаблицаСкидок.Сортировать("КоличествоОт");
		Для Каждого Стр из ТаблицаСкидок Цикл
			Если Количество >= Стр.КоличествоОт Тогда 
				Скидка = Стр.РазмерСкидки;
			КонецЕсли;		
		КонецЦикла;
	КонецЕсли;
	
	Возврат Скидка;
	
КонецФункции

&НаСервереБезКонтекста
