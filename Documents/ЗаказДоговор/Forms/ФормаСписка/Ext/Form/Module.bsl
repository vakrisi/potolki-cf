#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	УстановитьУсловноеОформление();
	
	//#13035
	ВедутсяРасчетыПоДокументу = Константы.ВестиРасчетыПоЗаказамПоЗаказДоговору.Получить();
	Элементы.СостояниеОплаты.Видимость = ВедутсяРасчетыПоДокументу;
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	// СтандартныеПодсистемы.УчетОригиналовПервичныхДокументов
	УчетОригиналовПервичныхДокументов.ПриСозданииНаСервере_ФормаСписка(ЭтотОбъект, Элементы.Список);
	// Конец СтандартныеПодсистемы.УчетОригиналовПервичныхДокументов
	
	// колонки пока убраны
	//Элементы.СтатусЗаказаРозницыНаПроизводство.Видимость = ПолучитьФункциональнуюОпцию("ОбеспеченностьРозницыПоЗаказДоговорам");
	//Элементы.СтатусЗаказаРозницыПоставщикам.Видимость    = ПолучитьФункциональнуюОпцию("ОбеспеченностьРозницыПоЗаказДоговорам");
	
	// отборы заказ-договоров
	Элементы.ЗаказДоговорОтборПоПодразделению.Видимость = ПолучитьФункциональнуюОпцию("ИспользоватьПодразделения");
	СписокЗаказДоговоровТекстЗапроса = Список.ТекстЗапроса;
	ЗаказДоговорОтборПоОплате = -9;
	ЗаказДоговорОтборПоПозициямВМонтажах = -9;
	ЗаказДоговорОтборПоВыполнениюМонтажей = -9;
	УстановитьОтборЗаказДоговоров();
	
	//#16281: на форме списка документов "Заказ-договор" убрать все поля быстрых фильтров
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "ЗакрытаФормаМонтажа" и Источник = "Монтаж" Тогда
		Элементы.Список.Обновить();
		
	ИначеЕсли ИмяСобытия = "Запись_ДокументОплаты" Тогда
		Элементы.Список.Обновить();
		
	КонецЕсли;
	
	// СтандартныеПодсистемы.УчетОригиналовПервичныхДокументов
	УчетОригиналовПервичныхДокументовКлиент.ОбработчикОповещенияФормаСписка(ИмяСобытия, ЭтотОбъект, Элементы.Список);
	// Конец СтандартныеПодсистемы.УчетОригиналовПервичныхДокументов
	
КонецПроцедуры

#КонецОбласти

