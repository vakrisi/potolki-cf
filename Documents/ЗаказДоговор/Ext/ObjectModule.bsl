Процедура ПриЗаписи(Отказ)
	
	//#13969
	Если ДополнительныеСвойства.Свойство("ДатаСоздания") Тогда
		// при программном создании / записи заказа свойство заполняется в "ИнициализироватьСлужебныеРеквизиты"
		// при создании через форму в "ПередЗаписьюНаСервере"
		ТекстКомментария = "Создан новый заказ";
		РегистрыСведений.ИсторияЗаказа.ДобавитьЗаписьВИсторию(Ссылка, ДополнительныеСвойства.ДатаСоздания, Пользователи.ТекущийПользователь(), ТекстКомментария);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область Заполнение

Процедура ИнициализироватьСлужебныеРеквизиты()
	
	ДатаДоговора = ТекущаяДатаСеанса();
	ВидЗаказа = Справочники.ВидыЗаказДоговоров.Договор;
	
	ЗаполнятьУИСтрок = Истина; //автоматически устанавливаем только для новых документов. у старых документов это значение может быть не заполнено
	
	СлужебныйЗаполнениеМатериаловРозницы = ПолучитьФункциональнуюОпцию("ЗаполнениеМатериаловРозницы");
	//СлужебныйОбеспечениеПоДокументу = ПолучитьФункциональнуюОпцию("ОбеспеченностьРозницыПоЗаказДоговорам");
	
	//#14828
	СозданПриИспользованииПодразделений  = Константы.ИспользоватьПодразделения.Получить();
	
	ДополнительныеСвойства.Вставить("ДатаСоздания", ТекущаяДатаСеанса());
	
КонецПроцедуры

Процедура ДозаполнитьПоУмолчанию()
	
	Если Константы.СпособЗаполненияМенеджераВЗаказДоговоре.Получить() = Перечисления.ВариантыЗаполненияМенеджера.ЗаполнятьСотрудникомПользователя 
		И ЗначениеЗаполнено(Автор) Тогда
		Менеджер = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Автор, "Сотрудник");
		
	ИначеЕсли Константы.СпособЗаполненияМенеджераВЗаказДоговоре.Получить() = Перечисления.ВариантыЗаполненияМенеджера.ЗаполнятьМенеджеромДокументаОснования
		И ЗначениеЗаполнено(Основание)
		И ТипЗнч(Основание) = Тип("ДокументСсылка.Лид") Тогда
		Менеджер = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Основание, "Менеджер");
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьПоЛиду(ДанныеЗаполнения)
	
	//#11323
	Если НЕ Константы.РазрешитьНесколькоДоговоровПоЛиду.Получить() Тогда
		ЕстьДругиеЗаказыПоЛиду = ОбщийМодульСервер.ПроверитьНаличиеДругихЗаказовПоЛиду(ДанныеЗаполнения, Ссылка);
		Если ЕстьДругиеЗаказыПоЛиду Тогда
			Текст = "Настройками программы запрещено создание нескольких заказ-договоров по лиду!";			
			ВызватьИсключение Текст;
		КонецЕсли;
	КонецЕсли;
	
	Основание = ДанныеЗаполнения;
	
	//++ №10184 предварительный расчет выведен в отдельный документ (данные реквизита теперь там)
	//ВидЦен = ДанныеЗаполнения.ВидЦен;
	//ВидСкидки = ДанныеЗаполнения.ВидСкидки;
	//Валюта = ДанныеЗаполнения.Валюта;
	//СуммаДокумента = ДанныеЗаполнения.СуммаДокумента;	
	//ОсновнойПредварительныйРасчет = ДанныеЗаполнения.ОсновнойПредварительныйРасчет;
	ОсновнойПредварительныйРасчет = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДанныеЗаполнения, "ОсновнойПредварительныйРасчет", Истина);
	Если ЗначениеЗаполнено(ОсновнойПредварительныйРасчет) Тогда
		РеквизитыПР = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ОсновнойПредварительныйРасчет, "Ссылка, Организация, Подразделение, Контрагент,
																								|ВидЦен, ВидСкидки, Валюта, СуммаДокумента", Истина);
		Если ЗначениеЗаполнено(РеквизитыПР.Ссылка) Тогда
			ЗаполнитьЗначенияСвойств(ЭтотОбъект, РеквизитыПР);
		КонецЕсли;
		//#16308
		Если ЗначениеЗаполнено(Контрагент) Тогда
			ДоговорКонтрагента = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Контрагент, "ОсновнойДоговор", Истина);;
		КонецЕсли;
	КонецЕсли;
	//-- №10184 предварительный расчет выведен в отдельный документ (данные реквизита теперь там)
	
	ТочкаПродаж = ДанныеЗаполнения.ТочкаПродаж;
	ОжидаемоеВремяОтгрузки = ДанныеЗаполнения.ПредполагаемыйМонтажВремя;
	ОжидаемаяДатаОтгрузки = ДанныеЗаполнения.ПредполагаемыйМонтажДата; 
	ПредполагаемыйМонтажДатаМонтажаНеОпределена = ДанныеЗаполнения.ПредполагаемыйМонтажДатаМонтажаНеОпределена;
	
	//++ №8429 комментируем, т.к. в лиде добавили реквизит Подразделение, заполняем по нему а не по точке продаж
	//Если НЕ ТочкаПродаж.Пустая() Тогда
	//	Если НЕ ТочкаПродаж.Подразделение.Пустая() Тогда
	//		Подразделение = ТочкаПродаж.Подразделение;
	//	Иначе
	//		Подразделение = ПараметрыСеанса.ТекущийПользователь.Подразделение;
	//	КонецЕсли;
	//Иначе
	//	Подразделение = ПараметрыСеанса.ТекущийПользователь.Подразделение;
	//КонецЕсли;
	//-- №8429
	
	//++ №8429 заполнение подразделения по новому (Если в лиде заполнено из него, иначе из нового реквизита ПодразделениеРозница пользователя)
	Если НЕ ЗначениеЗаполнено(Подразделение) И ЗначениеЗаполнено(ДанныеЗаполнения.Подразделение) Тогда
		Подразделение = ДанныеЗаполнения.Подразделение;
	//Иначе
	//	Подразделение = ПараметрыСеанса.ТекущийПользователь.ПодразделениеРозница;
	КонецЕсли;
	//-- №8429	
	
	УчитыватьНДС = УчетНДС.ОрганизацияЯвляетсяПлательщикомНДС(Организация);
	
	Если ЗначениеЗаполнено(ОсновнойПредварительныйРасчет) 
		И ЗначениеЗаполнено(РеквизитыПР.Ссылка) 
		И НЕ ВидЗаказа = Справочники.ВидыЗаказДоговоров.Рекламация
		И НЕ ВидЗаказа = Справочники.ВидыЗаказДоговоров.СервиснаяЗаявка
		Тогда
		Для Каждого СтрокаТаблицы Из ОсновнойПредварительныйРасчет.ТоварыУслуги Цикл //++ №10184 предварительный расчет выведен в отдельный документ (данные реквизита теперь там), было: Для Каждого СтрокаТаблицы Из ДанныеЗаполнения.ТоварыУслуги Цикл
			НоваяСтрока = ТоварыУслуги.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы);
			НоваяСтрока.УИСтроки = Новый УникальныйИдентификатор;
			НоваяСтрока.СтавкаНДС = УчетНДС.СтавкаНДСПоУмолчанию(Организация);
			НоваяСтрока.СуммаНДС = УчетНДС.РассчитатьСуммуНДС(НоваяСтрока.Сумма, УчитыватьНДС, , УчетНДС.ПолучитьСтавкуНДС(НоваяСтрока.СтавкаНДС));
		КонецЦикла;
		
		Для Каждого СтрокаТаблицы Из ОсновнойПредварительныйРасчет.Материалы Цикл //++ №10184 предварительный расчет выведен в отдельный документ (данные реквизита теперь там), было: Для Каждого СтрокаТаблицы Из ДанныеЗаполнения.Материалы Цикл
			НоваяСтрока = Материалы.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы);
			НоваяСтрока.УИСтроки = Новый УникальныйИдентификатор;
		КонецЦикла;	
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыФункции

Функция ПолучитьСписокКОбеспечениюРозницы()
	
	НастройкаИнтеркампани = ОбщийМодуль.ПолучитьНастройкуИнтеркампани(ТочкаПродаж, Подразделение, Организация);
	
	СписокКОбеспечению = ТоварыУслуги.Выгрузить(, "Комната, Номенклатура, ХарактеристикаНоменклатуры, Количество");
	СписокКОбеспечению.Очистить();	
	СписокКОбеспечению.Колонки.Добавить("Назначение", новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(25)));
	
	Для Каждого ТекущаяСтрока Из ТоварыУслуги Цикл
		
		Если НЕ ЗначениеЗаполнено(ТекущаяСтрока.Номенклатура) Тогда
			// строка комнаты
			Продолжить;
		КонецЕсли;
			
		Если  Справочники.ВидыНоменклатуры.ЭтоНоменклатураУслуга(ТекущаяСтрока.Номенклатура) Тогда 
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока = СписокКОбеспечению.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущаяСтрока);
		НоваяСтрока.Назначение = "Товары";
		
	КонецЦикла;
	
	Если НастройкаИнтеркампани.ЗаказПоставщикуЗаказыватьМатериалы Тогда
		Для Каждого ТекущаяСтрока Из Материалы Цикл
			
			Если НЕ ЗначениеЗаполнено(ТекущаяСтрока.Номенклатура) Тогда
				// строка комнаты
				Продолжить;
			КонецЕсли;		
			
			Если  Справочники.ВидыНоменклатуры.ЭтоНоменклатураУслуга(ТекущаяСтрока.Номенклатура) Тогда 
				Продолжить;
			КонецЕсли;
			
			НоваяСтрока = СписокКОбеспечению.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущаяСтрока);
			НоваяСтрока.Назначение = "Материалы";		
			
		КонецЦикла;	
	КонецЕсли;
	
	Возврат СписокКОбеспечению;	

КонецФункции	

#КонецОбласти

#КонецЕсли