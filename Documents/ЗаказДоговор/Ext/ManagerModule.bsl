Функция ПолучитьСуммуПоступленийНаДатуВыполненияМонтажа(ДокументСсылка)
	
	// определим дату выполнения монтажа
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	МИНИМУМ(Монтаж.Дата) КАК ДатаВыполнения
	|ИЗ
	|	Документ.Монтаж КАК Монтаж
	|ГДЕ
	|	Монтаж.Основание = &Заказ
	|	И НЕ Монтаж.ПометкаУдаления <> ИСТИНА
	|	И Монтаж.Дата <> ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
	|	И (Монтаж.Результат = ЗНАЧЕНИЕ(Справочник.РезультатыМонтажа.Выполнен)
	|			ИЛИ Монтаж.Результат = ЗНАЧЕНИЕ(Справочник.РезультатыМонтажа.Закрыт))";
	
	Запрос.УстановитьПараметр("Заказ", ДокументСсылка);	
	РезультатЗапроса = Запрос.Выполнить();	
	Выборка = РезультатЗапроса.Выбрать();
	
	Если Выборка.Следующий() Тогда
		ДатаВыполненияМонтажа = Выборка.ДатаВыполнения
	КонецЕсли;
	
	// если дата не найдена, берем все по текущую дату
	ДатаВыполненияМонтажа = ?(ЗначениеЗаполнено(ДатаВыполненияМонтажа), ДатаВыполненияМонтажа, КонецДня(ТекущаяДатаСеанса()));  
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	РасчетыПоЗаказамОбороты.СуммаРасход
	|ИЗ
	|	РегистрНакопления.РасчетыПоЗаказам.Обороты(, &Дата,, Заказ = &Заказ) КАК РасчетыПоЗаказамОбороты";
	
	Запрос.УстановитьПараметр("Заказ", 	ДокументСсылка);
	Запрос.УстановитьПараметр("Дата", ДатаВыполненияМонтажа);
	
	РезультатЗапроса = Запрос.Выполнить();	
	Выборка = РезультатЗапроса.Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.СуммаРасход;
	КонецЕсли;
	
	Возврат 0;	
	
КонецФункции
	
Функция РассчитатьПлощадьПотолков(ТабличнаяЧасть) Экспорт
	
	ПлощадьПотолков = 0;
	Для Каждого СтрокаТабличнойЧасти Из ТабличнаяЧасть Цикл
		Если Справочники.ВидыНоменклатуры.ЭтоНоменклатураПотолкаИлиОтреза(СтрокаТабличнойЧасти.Номенклатура) Тогда
			ПлощадьПотолков = ПлощадьПотолков + СтрокаТабличнойЧасти.Количество;
		КонецЕсли;
	КонецЦикла;
	Возврат ПлощадьПотолков;
	
КонецФункции

Функция ПолучитьМассивКомнатДоговора(ЗаказСсылка) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	ТаблицаКомнат = ЗаказСсылка.ТоварыУслуги.Выгрузить(, "Комната");
	ТаблицаКомнат.Свернуть("Комната");
	ТаблицаКомнат.ВыгрузитьКолонку("Комната");
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат ТаблицаКомнат.ВыгрузитьКолонку("Комната");
	
КонецФункции

Функция ПолучитьПотолокОснованияПоНомеру(ТабличнаяЧастьЗаказДоговора, НомерПотолка) Экспорт
	
	Если НЕ ПустаяСтрока(НомерПотолка) Тогда
		Для Каждого ТекущаяСтрока Из ТабличнаяЧастьЗаказДоговора Цикл
			Если ТекущаяСтрока.Номенклатура.Потолок_НомерРасчета = НомерПотолка Тогда
				Возврат ТекущаяСтрока.Номенклатура;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Возврат Справочники.Номенклатура.ПустаяСсылка();
	
КонецФункции

Процедура ПроверитьКомнатыПоЗаказу(ДокументОбъект, Отказ, РежимЗаписи) Экспорт
	
	ДокументЗаказ = Неопределено;
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ДокументОбъект, "Основание") Тогда
		ДокументЗаказ = ДокументОбъект.Основание;
	ИначеЕсли ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ДокументОбъект, "ДокументОснование") Тогда
		ДокументЗаказ = ДокументОбъект.ДокументОснование;
	КонецЕсли;	
	
	Если РежимЗаписи = РежимЗаписиДокумента.Проведение И ТипЗнч(ДокументЗаказ) = Тип("ДокументСсылка.ЗаказДоговор") И ЗначениеЗаполнено(ДокументЗаказ) Тогда			
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДанныеДокумента.Комната КАК Комната
		|ИЗ
		|	Документ." + ДокументОбъект.Метаданные().Имя + ".Товары КАК ДанныеДокумента
		|ГДЕ
		|	ДанныеДокумента.Ссылка = &Ссылка
		|	И НЕ ДанныеДокумента.Комната В (&Комната)
		|	И ДанныеДокумента.Комната <> """"
		|СГРУППИРОВАТЬ ПО
		|	ДанныеДокумента.Комната";
		
		Запрос.УстановитьПараметр("Ссылка", ДокументОбъект.Ссылка);
		Запрос.УстановитьПараметр("Комната", ПолучитьМассивКомнатДоговора(ДокументЗаказ));
		
		Выборка = Запрос.Выполнить().Выбрать();	
		ТекстОшибки = "";
		Пока Выборка.Следующий() Цикл
			ТекстОшибки = ТекстОшибки + ?(ПустаяСтрока(ТекстОшибки), "", ", ") + Выборка.Комната;
		КонецЦикла;
		
		Если НЕ ПустаяСтрока(ТекстОшибки) Тогда
			ТекстОшибки = "Комнаты " + ТекстОшибки + " отсутствуют в основании заказ-договоре!";
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки, ДокументОбъект); //, , , Отказ); пока без запрета проведения	
		КонецЕсли;
				
	КонецЕсли;
				
КонецПроцедуры			

// Функция - СоздатьНоменклатуруПоФайлуНаСервере
//
// Параметры:
//  ДокументОбъект				 - 	 - 
//  Данные						 - 	 номенклатура или структура файла построителя 
//  СписокДвоичныхДанныхЧертежей - 	 список двоичных данных приложенных файлов 
//  Комната						 - 	 наименвание комнаты 
//  УчитыватьНДС				 - 	 - 
//  ВМатериалы					 - 	 - 
//  ОписаниеОшибки				 - 	 - 
// 
// Возвращаемое значение:
//   - 
//
// Вызовы: 
// - форма документа "Заказ-договор" 
// - общая форма "ФормаЗагрузкиИзПостроителя"
//
Функция СоздатьНоменклатуруПоФайлуНаСервере(ДокументОбъект, Знач Данные, 
											Знач СписокДвоичныхДанныхЧертежей = Неопределено, 
											Знач Комната = Неопределено, 
											УчитыватьНДС=Ложь, 
											ВМатериалы = Ложь,
											ОписаниеОшибки = "") Экспорт  // #12872 +ОписаниеОшибки
	
	//ОписаниеОшибки = "";
	СтруктураПотолок = ОбменСEasyCeiling.ПолучитьСтруктуруПотолка(Данные, СписокДвоичныхДанныхЧертежей,,,,,, ОписаниеОшибки); 
	Если СтруктураПотолок = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если ЗначениеЗаполнено(ОписаниеОшибки) Тогда
		//Сообщить(ОписаниеОшибки);
		Возврат Неопределено;
	КонецЕсли;
	СтруктураПотолок.Вставить("Организация", ДокументОбъект.Организация);
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ДокументОбъект, "Контрагент") Тогда
		СтруктураПотолок.Вставить("Контрагент", ДокументОбъект.Контрагент);
	Иначе
		СтруктураПотолок.Вставить("Контрагент", Справочники.Контрагенты.ПустаяСсылка());
	КонецЕсли;
	
	ВидЗаказа = ?(ТипЗнч(ДокументОбъект.Ссылка) = Тип("ДокументСсылка.Монтаж"), Перечисления.ВидыЗаказов.Монтаж, Перечисления.ВидыЗаказов.ЗаказДоговор); // №5793 
	//#6413 при загрузке потолка не учитываем интеркампани, привязываемся к ВидуЦен
	//ТабличныеЧастиДляДокумента = ОбменСEasyCeiling.ПолучитьСтруктуруЗаказа(СтруктураПотолок,ДокументОбъект.ТочкаПродаж.ОсновнаяНастройкаИнтеркампани,
	//ТабличныеЧастиДляДокумента = ОбменСEasyCeiling.ПолучитьСтруктуруЗаказа(СтруктураПотолок,,
	//																		ДокументОбъект.ВидЦен, ДокументОбъект.Валюта, ДокументОбъект.Дата, 
	//																		ВидЗаказа, УчитыватьНДС,, ДокументОбъект.ДоговорКонтрагента);
	ДоговорКонтрагента = Неопределено;
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ДокументОбъект, "ДоговорКонтрагента") Тогда
		ДоговорКонтрагента = ДокументОбъект.ДоговорКонтрагента	
	КонецЕсли;
	ДанныеЗаказа = ОбменСEasyCeiling.СтруктураДанныхЗаказа(ДокументОбъект.Организация, ДокументОбъект.Подразделение, , ДокументОбъект.ВидЦен, ДокументОбъект.Валюта, ДокументОбъект.Дата, УчитыватьНДС, , ДоговорКонтрагента);
	ТабличныеЧастиДляДокумента = ОбменСEasyCeiling.ПолучитьСтруктуруЗаказа(СтруктураПотолок, ВидЗаказа, ДанныеЗаказа);
	
	Если ТабличныеЧастиДляДокумента = Неопределено Тогда
		Возврат Неопределено;	
	КонецЕсли;
	
	// добавляем потолок
	Потолок = Новый Структура("Номенклатура, Комната,Количество,ЕдиницаИзмерения,Коэффициент,НомерПотолка,ЦветФактуры,ЗагруженоИзПостроителя",
	                               	ТабличныеЧастиДляДокумента.ПродукцияНоменклатура, Комната, ТабличныеЧастиДляДокумента.Количество, 
									ТабличныеЧастиДляДокумента.ПродукцияНоменклатура.БазоваяЕдиницаИзмерения, 1,
	                             	СтруктураПотолок.НомерРасчетаЗаказа, СтруктураПотолок.Фактуры[0].ПродукцияЦвет, Истина);
	//Новый параметры Продукции	
	ЗагружатьКалькуляциюВЗаказДоговорИзПостроителя = Константы.ЗагружатьКалькуляциюВЗаказДоговорИзПостроителя.Получить();
	Если ЗагружатьКалькуляциюВЗаказДоговорИзПостроителя Тогда
		Потолок.Вставить("Цена", 		  СтруктураПотолок.ЦенаПродукция);
		Потолок.Вставить("ПроцентСкидки", СтруктураПотолок.ПроцентСкидкиПродукция);
		Потолок.Вставить("СуммаСкидки",   СтруктураПотолок.СуммаСкидкиПродукция);
		Потолок.Вставить("Сумма", 		  СтруктураПотолок.СуммаПродукция);
	КонецЕсли;
	
	Потолок.Вставить("УИСтроки", Строка(Новый УникальныйИдентификатор));
	
	Если НЕ ВМатериалы Тогда
		
		//++ #15176		
		Для Каждого ТекущаяСтрока Из ДокументОбъект.ТоварыУслуги Цикл			
			Если ТекущаяСтрока.Номенклатура = Потолок.Номенклатура 
				И НЕ ТекущаяСтрока.Комната = Потолок.Комната Тогда
				ОписаниеОшибки = СтрШаблон("Продукция ""%1"" уже имеется в комнате ""%2"".", Потолок.Номенклатура, ТекущаяСтрока.Комната);
				Возврат Неопределено;				
			КонецЕсли;			
		КонецЦикла;
		//--
		
		НоваяСтрокаДокумента = ОбработкаТабличныхЧастейСервер.ДобавитьОбновитьПотолокВТЧДокументаРозницы(ДокументОбъект, "ТоварыУслуги", Потолок);
		//НоваяСтрокаДокумента.КоличествоВыработка = ПолучитьКоличествоВыработка(НоваяСтрокаДокумента.Количество);
		ОбработкаТабличныхЧастейСервер.ПроставитьИРассчитатьДанныеПоПрайсу(НоваяСтрокаДокумента);
		
		//Начало добавлен при переходе на 2.0
		//Услуги и товары относящиеся к потолку загоним во временную ТЗ, чтобы потом лишнее удалить
		Врем_ТЗ = новый ТаблицаЗначений;
		Врем_ТЗ.Колонки.Добавить("Номенклатура");	
		Врем_ТЗ.Колонки.Добавить("НомерПотолка");
		
		Для Каждого ТекущаяСтрока Из ДокументОбъект.ТоварыУслуги Цикл			
			
			Если ТекущаяСтрока.НомерПотолка = Потолок.НомерПотолка И ТекущаяСтрока.Номенклатура <> Потолок.Номенклатура Тогда
				
				//Услуга или товар потолка
				НоваяСтрока = Врем_ТЗ.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущаяСтрока);
				
			КонецЕсли;	
			
		КонецЦикла;
		//Конец добавлен при переходе на 2.0
		
		ИтогСуммаТовары = 0;
		Для Каждого ТекЭлемент Из ТабличныеЧастиДляДокумента.Товары Цикл
			Если ТекЭлемент.ЭтоУслугаРаскроя Тогда
				ИтогСуммаТовары = ИтогСуммаТовары + ТекЭлемент.Сумма;
			КонецЕсли;
		КонецЦикла;
		ИтогСуммаУслуги = 0;
		Для Каждого ТекЭлемент Из ТабличныеЧастиДляДокумента.Услуги Цикл
			Если ТекЭлемент.ЭтоУслугаРаскроя Тогда
				ИтогСуммаУслуги = ИтогСуммаУслуги + ТекЭлемент.Сумма;
			КонецЕсли;
		КонецЦикла;
		
		//Если включена настройка загружать калькуляцию из файла, то строго грузим потолок, его цены, скидки, суммы из файла (заполнение было выше), услуги раскроя не участвуют
		Если НЕ ЗагружатьКалькуляциюВЗаказДоговорИзПостроителя Тогда
			
			//теперь определим итоговую стоимость потолка и цену за 1 ед.
			Если НЕ Константы.ВыделятьУслугиРаскрояИзПотолкаПриЗагрузкеИзПостроителяВЗаказДоговор.Получить() Тогда //ТабличныеЧастиДляДокумента.ВыделятьУслугиРаскрояИзПотолка Тогда
				//потолок содержит стоимость услуг		
				НоваяСтрокаДокумента.Сумма = ТабличныеЧастиДляДокумента.Сумма + ИтогСуммаУслуги + ИтогСуммаТовары;
				Если НЕ НоваяСтрокаДокумента.Количество = 0 Тогда
					НоваяСтрокаДокумента.Цена = НоваяСтрокаДокумента.Сумма / НоваяСтрокаДокумента.Количество;
					ОбработкаТабличныхЧастейСервер.ПроставитьИРассчитатьДанныеПоПрайсу(НоваяСтрокаДокумента);				
				КонецЕсли;		
			Иначе
				//услуги раскроя выделяются отдельно
				НоваяСтрокаДокумента.Сумма = ТабличныеЧастиДляДокумента.Сумма;		
				Если НЕ НоваяСтрокаДокумента.Количество = 0 Тогда
					НоваяСтрокаДокумента.Цена = НоваяСтрокаДокумента.Сумма / НоваяСтрокаДокумента.Количество;
					ОбработкаТабличныхЧастейСервер.ПроставитьИРассчитатьДанныеПоПрайсу(НоваяСтрокаДокумента);
				КонецЕсли;		
				
				Для Каждого ТекУслуга Из ТабличныеЧастиДляДокумента.Услуги Цикл
					Если ТекУслуга.ЭтоУслугаРаскроя Тогда
						ДанныеСтроки = Новый Структура("Комната, НомерПотолка, Цена, ЦенаПоПрайсу, ЗагруженоИзПостроителя, УИСтроки",
														Комната, СтруктураПотолок.НомерРасчетаЗаказа, ТекУслуга.Цена, ТекУслуга.Цена, Истина, Строка(Новый УникальныйИдентификатор));								
						НоваяСтрокаДокумента = ОбработкаТабличныхЧастейСервер.ДобавитьОбновитьСтрокуВТЧЗаказДоговора(ДокументОбъект.ТоварыУслуги, ТекУслуга, ДанныеСтроки);
						//НоваяСтрокаДокумента.КоличествоВыработка = ПолучитьКоличествоВыработка(НоваяСтрокаДокумента.Количество);
						ОбработкаТабличныхЧастейСервер.ПроставитьИРассчитатьДанныеПоПрайсу(НоваяСтрокаДокумента);
						
						//Начало добавлен при переходе на 2.0
						//Удалим из Врем_ТЗ услугу, если найдем (она там должна быть)
						УдалитьУслугиТоварКПотолкуИзВремТЗ(Потолок.НомерПотолка, ТекУслуга.Номенклатура, Врем_ТЗ);
						//Конец добавлен при переходе на 2.0
					КонецЕсли;
				КонецЦикла;
				
				Для Каждого ТекУслуга Из ТабличныеЧастиДляДокумента.Товары Цикл
					Если ТекУслуга.ЭтоУслугаРаскроя Тогда
						ДанныеСтроки = Новый Структура("Комната, НомерПотолка, Цена, ЦенаПоПрайсу, ЗагруженоИзПостроителя, УИСтроки",
														Комната, СтруктураПотолок.НомерРасчетаЗаказа, ТекУслуга.Цена, ТекУслуга.Цена, Истина, Строка(Новый УникальныйИдентификатор));								
						НоваяСтрокаДокумента = ОбработкаТабличныхЧастейСервер.ДобавитьОбновитьСтрокуВТЧЗаказДоговора(ДокументОбъект.ТоварыУслуги, ТекУслуга, ДанныеСтроки);
						//НоваяСтрокаДокумента.КоличествоВыработка = ПолучитьКоличествоВыработка(НоваяСтрокаДокумента.Количество);
						ОбработкаТабличныхЧастейСервер.ПроставитьИРассчитатьДанныеПоПрайсу(НоваяСтрокаДокумента);
						
						//Начало добавлен при переходе на 2.0
						//Удалим из Врем_ТЗ услугу, если найдем (она там должна быть)
						УдалитьУслугиТоварКПотолкуИзВремТЗ(Потолок.НомерПотолка, ТекУслуга.Номенклатура, Врем_ТЗ);
						//Конец добавлен при переходе на 2.0
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
			
		КонецЕсли;	
		
		//прочие товары и услуги
		Для Каждого ТекУслуга Из ТабличныеЧастиДляДокумента.Товары Цикл
			Если НЕ ТекУслуга.ЭтоУслугаРаскроя Тогда
				ДанныеСтроки = Новый Структура("Комната ,НомерПотолка, Цена, ЦенаПоПрайсу,ЗагруженоИзПостроителя, УИСтроки",
												Комната, СтруктураПотолок.НомерРасчетаЗаказа, ТекУслуга.Цена, ТекУслуга.Цена, Истина, Строка(Новый УникальныйИдентификатор));								
				НоваяСтрокаДокумента = ОбработкаТабличныхЧастейСервер.ДобавитьОбновитьСтрокуВТЧЗаказДоговора(ДокументОбъект.ТоварыУслуги, ТекУслуга, ДанныеСтроки);
				//НоваяСтрокаДокумента.КоличествоВыработка = ПолучитьКоличествоВыработка(НоваяСтрокаДокумента.Количество);
				ОбработкаТабличныхЧастейСервер.ПроставитьИРассчитатьДанныеПоПрайсу(НоваяСтрокаДокумента);
				
				//Начало добавлен при переходе на 2.0
				//Удалим из Врем_ТЗ услугу, если найдем (она там должна быть)
				УдалитьУслугиТоварКПотолкуИзВремТЗ(Потолок.НомерПотолка, ТекУслуга.Номенклатура, Врем_ТЗ);
				//Конец добавлен при переходе на 2.0
			КонецЕсли;
		КонецЦикла;
		Для Каждого ТекУслуга Из ТабличныеЧастиДляДокумента.Услуги Цикл
			Если НЕ ТекУслуга.ЭтоУслугаРаскроя Тогда
				ДанныеСтроки = Новый Структура("Комната, НомерПотолка, Цена, ЦенаПоПрайсу, ЗагруженоИзПостроителя, УИСтроки",
												Комната, СтруктураПотолок.НомерРасчетаЗаказа, ТекУслуга.Цена, ТекУслуга.Цена, Истина, Строка(Новый УникальныйИдентификатор));								
				НоваяСтрокаДокумента = ОбработкаТабличныхЧастейСервер.ДобавитьОбновитьСтрокуВТЧЗаказДоговора(ДокументОбъект.ТоварыУслуги, ТекУслуга, ДанныеСтроки);
				//НоваяСтрокаДокумента.КоличествоВыработка = ПолучитьКоличествоВыработка(НоваяСтрокаДокумента.Количество);
				ОбработкаТабличныхЧастейСервер.ПроставитьИРассчитатьДанныеПоПрайсу(НоваяСтрокаДокумента);
				
				//Начало добавлен при переходе на 2.0
				//Удалим из Врем_ТЗ услугу, если найдем (она там должна быть)
				УдалитьУслугиТоварКПотолкуИзВремТЗ(Потолок.НомерПотолка, ТекУслуга.Номенклатура, Врем_ТЗ);
				//Конец добавлен при переходе на 2.0
			КонецЕсли;
		КонецЦикла;
		
		//2.0
		// применим при необходимости округление
		ПорядокОкругления = Константы.ПорядокОкругленияЧисломСтоимостиПотолковРозница.Получить();
		//ТребуетсяОкругление = (ПорядокОкругления > 0);
		ТребуетсяОкругление = Константы.ОкруглятьСтоимостьПотолка.Получить() И (ПорядокОкругления > 0);
		Если ТребуетсяОкругление Тогда		
			ОкруглятьВБольшуюСторону = Константы.ОкруглятьВБольшуюСторонуСтоимостьПотолковРозница.Получить();
			СпособОкругления = Константы.СпособОкругленияСтоимостиПотолковРозница.Получить();
			ВариантОкругления = Константы.ВариантОкругленияСтоимостиПотолковРозница.Получить();
			ТребуетсяОкруглениеСоставляющих = ТребуетсяОкругление И СпособОкругления = 1;
			ТребуетсяОкруглениеПотолка    = ТребуетсяОкругление И СпособОкругления = 0;
			НайденныеСтроки = ДокументОбъект.ТоварыУслуги.НайтиСтроки(Новый Структура("НомерПотолка", СтруктураПотолок.НомерРасчетаЗаказа));
			
			Если ТребуетсяОкруглениеСоставляющих Тогда
				Для каждого СтрокаТЧ из НайденныеСтроки Цикл
					ОбработкаТабличныхЧастейСервер.ОкруглитьСтрокуТЧ(СтрокаТЧ, ПорядокОкругления, ОкруглятьВБольшуюСторону, ВариантОкругления, "ПроцентСкидки", "СуммаСкидки");
				КонецЦикла;
			ИначеЕсли ТребуетсяОкруглениеПотолка Тогда
				ИтоговаяСуммаПотолка = 0;
				Для каждого СтрокаТЧ из НайденныеСтроки Цикл
					ИтоговаяСуммаПотолка = ИтоговаяСуммаПотолка + СтрокаТЧ.Сумма;
				КонецЦикла;
				ОкругленнаяИтоговаяСуммаПотолка = ОбщийМодуль.ОкруглитьЧисло(ИтоговаяСуммаПотолка, ПорядокОкругления, ОкруглятьВБольшуюСторону);
				НайденнаяСтрокаПотолка = ДокументОбъект.ТоварыУслуги.НайтиСтроки(Новый Структура("Номенклатура", ТабличныеЧастиДляДокумента.ПродукцияНоменклатура));
				Если НайденнаяСтрокаПотолка.Количество() > 0  Тогда
					НайденнаяСтрокаПотолка[0].Сумма = НайденнаяСтрокаПотолка[0].Сумма - (ИтоговаяСуммаПотолка - ОкругленнаяИтоговаяСуммаПотолка); 
					
					Если ВариантОкругления = 0 Тогда
						//изменять цену после округления
						Если НЕ НайденнаяСтрокаПотолка[0].Количество = 0 Тогда
							СуммаБезСкидки = НайденнаяСтрокаПотолка[0].Сумма + НайденнаяСтрокаПотолка[0].СуммаСкидки;
							НайденнаяСтрокаПотолка[0].Цена = Окр(СуммаБезСкидки / НайденнаяСтрокаПотолка[0].Количество, 2);
						КонецЕсли;
					Иначе
						//изменять сумму ручной скидки
						НайденнаяСтрокаПотолка[0].СуммаСкидки = НайденнаяСтрокаПотолка[0].СуммаСкидки + (ИтоговаяСуммаПотолка - ОкругленнаяИтоговаяСуммаПотолка);
						ОбработкаТабличныхЧастейСервер.ПересчитатьПроцентРучнойСкидкиВСтрокеТЧ(НайденнаяСтрокаПотолка[0], "ПроцентСкидки", "СуммаСкидки");					
					КонецЕсли;
					
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		//Начало добавлен при переходе на 2.0
		//Удалим товары и услуги в ТЧ Товары позиции, которые относятся к потолку и сейчас не были загружены
		Если Врем_ТЗ.Количество() > 0 Тогда	
			Для Каждого ТекСтрока Из Врем_ТЗ Цикл				
				СтруктураПоиска = новый Структура("Номенклатура, НомерПотолка", ТекСтрока.Номенклатура, ТекСтрока.НомерПотолка);
				НайденныеСтроки = ДокументОбъект.ТоварыУслуги.НайтиСтроки(СтруктураПоиска);		
				Если НайденныеСтроки.Количество() > 0 Тогда
					Для Сч = НайденныеСтроки.Количество()-1 По 0 Цикл						
						ДокументОбъект.ТоварыУслуги.Удалить(НайденныеСтроки[Сч]);						
					КонецЦикла;					
				КонецЕсли;				
			КонецЦикла;
		КонецЕсли;
		//Конец добавлен при переходе на 2.0
		
		// РезультатРасширеннойОбработки по материалам
		ЕстьРеквизитСлужебныйЗаполнениеМатериаловРозницы = ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ДокументОбъект, "СлужебныйЗаполнениеМатериаловРозницы"); 
		Если (ЕстьРеквизитСлужебныйЗаполнениеМатериаловРозницы И ДокументОбъект.СлужебныйЗаполнениеМатериаловРозницы = 0) //#5456 ЗаполнениеМатериаловПоЗаказам = (СлужебныйЗаполнениеМатериаловРозницы = 0);
			ИЛИ НЕ ЕстьРеквизитСлужебныйЗаполнениеМатериаловРозницы  // предварительный расчет
			Тогда
			ТЧМатериалыСлужебная = ?(ТипЗнч(ДокументОбъект.Ссылка) = Тип("ДокументСсылка.ЗаказДоговор"), ДокументОбъект.МатериалыСлужебная, Неопределено);
			ОбработкаТабличныхЧастейСервер.ОбработатьЗагрузкуМатериаловВДокументРозницы(ТабличныеЧастиДляДокумента.ПродукцияНоменклатура, Комната, ДокументОбъект.Материалы, ТЧМатериалыСлужебная, ТабличныеЧастиДляДокумента.Материалы);			
		КонецЕсли;
	Иначе
		// добавление потолка в Материалы
		
		//++ #15176		
		Для Каждого ТекущаяСтрока Из ДокументОбъект.Материалы Цикл			
			Если ТекущаяСтрока.Номенклатура = Потолок.Номенклатура 
				И НЕ ТекущаяСтрока.Комната = Потолок.Комната Тогда
				ОписаниеОшибки = СтрШаблон("Продукция ""%1"" уже имеется в комнате ""%2"".", Потолок.Номенклатура, ТекущаяСтрока.Комната);
				Возврат Неопределено;				
			КонецЕсли;			
		КонецЦикла;
		//--

		// пока только сам потолок
		//Потолок.Вставить("УИСтроки", Новый УникальныйИдентификатор); - перенесено выше
		НоваяСтрокаДокумента = ОбработкаТабличныхЧастейСервер.ДобавитьОбновитьПотолокВТЧДокументаРозницы(ДокументОбъект, "Материалы", Потолок);
		
		// №5793 расширенные правила загрузки для монтажа, только ТЧ Материалы
		Если ТипЗнч(ДокументОбъект.Ссылка) = Тип("ДокументСсылка.Монтаж") Тогда
			ОбработкаТабличныхЧастейСервер.ОбработатьЗагрузкуМатериаловВМонтаж(ТабличныеЧастиДляДокумента.ПродукцияНоменклатура, Комната, ДокументОбъект.Материалы, ТабличныеЧастиДляДокумента.Материалы);
		КонецЕсли;
		
	КонецЕсли;

	Возврат ТабличныеЧастиДляДокумента.ПродукцияНоменклатура;
	
КонецФункции

Процедура УдалитьУслугиТоварКПотолкуИзВремТЗ(НомерПотолка, Номенклатура, Врем_ТЗ)
	
	//Удалим из Врем_ТЗ услугу, если найдем (она там должна быть)
	СтруктураПоиска = новый Структура("Номенклатура, НомерПотолка", Номенклатура, НомерПотолка);
	НайденныеСтрокиВрем = Врем_ТЗ.НайтиСтроки(СтруктураПоиска);
	Если НайденныеСтрокиВрем.Количество() > 0 Тогда								
		Для Сч = НайденныеСтрокиВрем.Количество()-1 По 0 Цикл		
			Врем_ТЗ.Удалить(НайденныеСтрокиВрем[Сч]);		
		КонецЦикла;	
	КонецЕсли;
	
КонецПроцедуры

Функция ВсеТоварыПоЗаказуОтгружены1(СсылкаНаЗаказ, ТоварыТЧ) Экспорт
	
	СтруктураВозврата = Новый Структура("Результат, Описание", Истина, "");
	
	//проверим сколько отгружено по заказу. Если отгружено больше чем заказано в заказе - отказываем в проведении (защита от удаления товаров из заказа после его отгрузки)
	//в регистре заказы покупателей получим все расходы где участвует данный заказ
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|		ЗаказыПокупателейОбороты.Номенклатура,
	|		СУММА(ЕСТЬNULL(ЗаказыПокупателейОбороты.КоличествоРасход, 0)) КАК Отгружено	
	|	ИЗ
	|		РегистрНакопления.ЗаказыПокупателей.Обороты(, , Регистратор, ЗаказНаПроизводство = &ДокументЗаказ) КАК ЗаказыПокупателейОбороты
	|
	//++ №10764 добавлен регистратор и исключение рекламационных и сервисных монтажей
	|ГДЕ
	|	ВЫБОР
	|		КОГДА ЗаказыПокупателейОбороты.Регистратор ССЫЛКА Документ.Монтаж 
	|				И (ЗаказыПокупателейОбороты.Регистратор.ВидОперации = Значение(Справочник.ВидыМонтажа.Рекламация)
	|					ИЛИ ЗаказыПокупателейОбороты.Регистратор.ВидОперации = Значение(Справочник.ВидыМонтажа.СервиснаяЗаявка))
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ
	|
	|СГРУППИРОВАТЬ ПО
	|	ЗаказыПокупателейОбороты.Номенклатура
	//-- №10764
	|";
	Запрос.УстановитьПараметр("ДокументЗаказ", СсылкаНаЗаказ);
	
	//создадим временную таблицу куда поместим все товары, услуги
	Временная_ТЗ = новый ТаблицаЗначений;
	Временная_ТЗ.Колонки.Добавить("Номенклатура",,"Номенклатура");	
	Временная_ТЗ.Колонки.Добавить("Количество",,"Количество");
	
	//поместим товары и услуги
	Для Каждого ТекСтрока Из ТоварыТЧ Цикл
		НоваяСтрока = Временная_ТЗ.Добавить();
		НоваяСтрока.Номенклатура = ТекСтрока.Номенклатура;
		НоваяСтрока.Количество = ТекСтрока.Количество * ТекСтрока.Коэффициент;
	КонецЦикла;	
	
	//свернем временную таблицу со всеми товарами, услугами, продукцией, потолками
	Временная_ТЗ.Свернуть("Номенклатура", "Количество");
	
	//теперь пройдемся по всем полученным расходным движениям и 
	//если количество расход больше текущего количества в заказе, отказ в проведении
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		//нужно найти номенлатуру во временной ТЗ
		СтруктураПоиска = новый Структура;
		СтруктураПоиска.Вставить("Номенклатура", Выборка.Номенклатура);
		НайденноеЗначение = Временная_ТЗ.НайтиСтроки(СтруктураПоиска);
		
		Если НайденноеЗначение.Количество() = 0 Тогда
			//в расходе есть а в текущем заказе нет, отказ
			СтруктураВозврата.Результат = Ложь;
			СтруктураВозврата.Описание = СтруктураВозврата.Описание +
			"По данному заказу номенклатуры """ + Выборка.Номенклатура + """ отгружено на " + Выборка.Отгружено + " ед. больше, чем заказано." + Символы.ПС;			
		Иначе
			Перегруз = Выборка.Отгружено - НайденноеЗначение[0].Количество;
			Если Перегруз > 0 Тогда
				СтруктураВозврата.Результат = Ложь;
				СтруктураВозврата.Описание = СтруктураВозврата.Описание + 
				"По данному заказу номенклатуры """ + Выборка.Номенклатура + """ отгружено на " + Перегруз + " ед. больше, чем заказано." + Символы.ПС;
			КонецЕсли;
		КонецЕсли;	
	КонецЦикла;
	
	Возврат СтруктураВозврата;
	
КонецФункции

Функция ВсеТоварыПоЗаказуОтгружены2(СсылкаНаЗаказ, ТоварыТЧ) Экспорт
	
	СтруктураВозврата = Новый Структура("Результат, Описание", Истина, "");

	УстановитьПривилегированныйРежим(Истина);
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТоварыУслугиЗД.Номенклатура,
	|	ЕСТЬNULL(ТоварыУслугиЗД.Количество, 0) КАК Количество
	|
	|ПОМЕСТИТЬ ВТ_ТоварыУслугиЗДВрем
	|
	|ИЗ
	|  	&ТоварыУслугиЗД КАК ТоварыУслугиЗД
	|
	|;
	|///////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТоварыУслугиЗД.Номенклатура,
	|	СУММА(ЕСТЬNULL(ТоварыУслугиЗД.Количество, 0)) КАК Количество
	|
	|ПОМЕСТИТЬ ВТ_ТоварыУслугиЗД
	|
	|ИЗ
	|  	ВТ_ТоварыУслугиЗДВрем КАК ТоварыУслугиЗД
	|
	|СГРУППИРОВАТЬ ПО
	|	ТоварыУслугиЗД.Номенклатура
	|
	|;
	|///////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТоварыУслугиЗД.Номенклатура,
	|	ЕСТЬNULL(ТоварыУслугиЗД.Количество, 0) КАК Количество,
	|	ЕСТЬNULL(ЗаказыПокупателейОбороты.КоличествоРасход, 0) КАК Отгружено,
	|	ЕСТЬNULL(ТоварыУслугиЗД.Количество, 0) - ЕСТЬNULL(ЗаказыПокупателейОбороты.КоличествоРасход, 0) КАК Остаток
	|ИЗ
	|	ВТ_ТоварыУслугиЗД КАК ТоварыУслугиЗД
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ЗаказыПокупателей.Обороты(, , , ЗаказНаПроизводство = &ДокументЗаказ) КАК ЗаказыПокупателейОбороты
	|		ПО ТоварыУслугиЗД.Номенклатура = ЗаказыПокупателейОбороты.Номенклатура
	|ГДЕ
	|	(ЕСТЬNULL(ТоварыУслугиЗД.Количество, 0) - ЕСТЬNULL(ЗаказыПокупателейОбороты.КоличествоРасход, 0)) > 0";
	
	Запрос.УстановитьПараметр("ДокументЗаказ",  СсылкаНаЗаказ);
	Запрос.УстановитьПараметр("ТоварыУслугиЗД", ТоварыТЧ.Выгрузить(, "Номенклатура, Количество"));
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если НЕ РезультатЗапроса.Пустой() Тогда			
		ТекстОшибки = "По данному заказу отгружены не все позиции:";			
		Выборка = РезультатЗапроса.Выбрать();
		Пока Выборка.Следующий() Цикл			
			ТекстОшибки = ТекстОшибки + Символы.ПС + Выборка.Номенклатура + " в заказе " + Выборка.Количество + " ед., отгружено " + Выборка.Отгружено + " ед., остаток " + Выборка.Остаток + " ед.";				
		КонецЦикла;
		
		СтруктураВозврата.Результат = Ложь;
		СтруктураВозврата.Описание = ТекстОшибки;
		
	КонецЕсли;
	
	Возврат СтруктураВозврата;
	
КонецФункции

Функция ЕстьСоглашениеОРасторжении(СсылкаНаЗаказ) Экспорт
	
	СтруктураВозврата = новый Структура("СуммаРасторжения, ЕстьСоглашениеОРасторжении, Документ", 0, Ложь, Документы.СоглашениеОРасторженииДоговора.ПустаяСсылка());
		
	УстановитьПривилегированныйРежим(Истина);
	Запрос = новый Запрос;		
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СоглашениеОРасторженииДоговора.Ссылка,
	|	СоглашениеОРасторженииДоговора.СуммаДокумента
	|ИЗ
	|   Документ.СоглашениеОРасторженииДоговора КАК СоглашениеОРасторженииДоговора
	|ГДЕ
	|	СоглашениеОРасторженииДоговора.ЗаказДоговор = &ЗаказДоговор
	|	И СоглашениеОРасторженииДоговора.Проведен";
	Запрос.УстановитьПараметр("ЗаказДоговор", СсылкаНаЗаказ);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		СтруктураВозврата.ЕстьСоглашениеОРасторжении = Истина;
		СтруктураВозврата.СуммаРасторжения = Выборка.СуммаДокумента;
		СтруктураВозврата.Документ = Выборка.Ссылка;
	КонецЕсли;	
	
	Возврат СтруктураВозврата;
	
КонецФункции

Функция ЕстьПроведенныйМонтажВРаботеИлиВыполнен(СсылкаНаЗаказ) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	Запрос = новый Запрос;		
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ДанныеДокумента.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.Монтаж КАК ДанныеДокумента
	|ГДЕ
	|	ДанныеДокумента.Результат В (ЗНАЧЕНИЕ(Справочник.РезультатыМонтажа.Выполнен), ЗНАЧЕНИЕ(Справочник.РезультатыМонтажа.Закрыт), ЗНАЧЕНИЕ(Справочник.РезультатыМонтажа.ВРаботе), ЗНАЧЕНИЕ(Справочник.РезультатыМонтажа.ЧастичноВыполнен))
	|	И ДанныеДокумента.Основание = &ЗаказДоговор
	|	И ДанныеДокумента.Проведен";
	Запрос.УстановитьПараметр("ЗаказДоговор", СсылкаНаЗаказ);
	РезультатЗапроса = Запрос.Выполнить();
	Возврат НЕ РезультатЗапроса.Пустой();
	
КонецФункции

