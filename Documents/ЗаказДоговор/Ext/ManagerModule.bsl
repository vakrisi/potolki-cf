#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ОбработкаПолученияПолейПредставления(Поля, СтандартнаяОбработка)
	
	//#16346
	Поля.Добавить("ВидЗаказа");
 	Поля.Добавить("Дата");
	Поля.Добавить("Номер");
	СтандартнаяОбработка = Ложь;
 
КонецПроцедуры

Процедура ОбработкаПолученияПредставления(Данные, Представление, СтандартнаяОбработка)
	
	//#16346
	СтандартнаяОбработка = Ложь;
	
	СоответствиеПредставлений = Новый Соответствие;
	СоответствиеПредставлений.Вставить(Справочники.ВидыЗаказДоговоров.ПустаяСсылка(), "Заказ клиента");
	СоответствиеПредставлений.Вставить(Справочники.ВидыЗаказДоговоров.Договор, "Заказ клиента (договор)");
	СоответствиеПредставлений.Вставить(Справочники.ВидыЗаказДоговоров.Продажа, "Заказ клиента (продажа)");
	СоответствиеПредставлений.Вставить(Справочники.ВидыЗаказДоговоров.Рекламация, "Заказ клиента (рекламация)");
	СоответствиеПредставлений.Вставить(Справочники.ВидыЗаказДоговоров.СервиснаяЗаявка, "Заказ клиента (сервисная заявка)");
	
    Представление = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
        НСтр("ru = '%1 №%2 от %3'"),
        СоответствиеПредставлений.Получить(Данные.ВидЗаказа),
        Данные.Номер,
        Данные.Дата
	);
		
КонецПроцедуры

#КонецОбласти

#Область Печать

// Заполняет список команд печати.
// 
// Параметры:
// КомандыПечати – ТаблицаЗначений – состав полей см. в функции УправлениеПечатью.СоздатьКоллекциюКомандПечати
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт
	
	//Договор
    КомандаПечати = КомандыПечати.Добавить();
    КомандаПечати.МенеджерПечати = "Документ.ЗаказДоговор";
    КомандаПечати.Идентификатор = "Договор";
    КомандаПечати.Представление = НСтр("ru = 'Договор'");
    КомандаПечати.ПроверкаПроведенияПередПечатью = Истина; 
	КомандаПечати.Порядок = 10;
	
	//Договор в рассрочку
    КомандаПечати = КомандыПечати.Добавить();
    КомандаПечати.МенеджерПечати = "Документ.ЗаказДоговор";
    КомандаПечати.Идентификатор = "ДоговорРассрочка";
    КомандаПечати.Представление = НСтр("ru = 'Договор (рассрочка)'");
    КомандаПечати.ПроверкаПроведенияПередПечатью = Истина; 
	КомандаПечати.Порядок = 20;
		
	//Приложение (по комнатам)
    КомандаПечати = КомандыПечати.Добавить();
    КомандаПечати.МенеджерПечати = "Документ.ЗаказДоговор";
    КомандаПечати.Идентификатор = "Смета";
    КомандаПечати.Представление = НСтр("ru = 'Смета'");
    КомандаПечати.ПроверкаПроведенияПередПечатью = Истина; 
	КомандаПечати.Порядок = 30;
	
	Если ПолучитьФункциональнуюОпцию("ПечатьФормМонтажаИзЗаказДоговора") Тогда
		//Акт выполненных работ 
		КомандаПечати = КомандыПечати.Добавить();
		КомандаПечати.МенеджерПечати = "Документ.ЗаказДоговор";
		КомандаПечати.Идентификатор = "АктВыполненныхРабот";
		КомандаПечати.Представление = НСтр("ru = 'Акт выполненных работ'");
		КомандаПечати.ПроверкаПроведенияПередПечатью = Истина; 
		КомандаПечати.Порядок = 40;
		Если ПолучитьФункциональнуюОпцию("ИспользоватьПечатныеФормыМонтажаБезСкидок") Тогда
			КомандаПечати = КомандыПечати.Добавить();
			КомандаПечати.МенеджерПечати = "Документ.ЗаказДоговор";
			КомандаПечати.Идентификатор = "АктВыполненныхРабот_ПересчетЦены";
			КомандаПечати.Представление = НСтр("ru = 'Акт выполненных работ (пересчет цены по скидке)'");
			КомандаПечати.ПроверкаПроведенияПередПечатью = Истина;
			КомандаПечати.Порядок = 45;
		КонецЕсли;
		
		//Гарантийный талон 
		КомандаПечати = КомандыПечати.Добавить();
		КомандаПечати.МенеджерПечати = "Документ.ЗаказДоговор";
		КомандаПечати.Идентификатор = "ГарантийныйТалон";
		КомандаПечати.Представление = НСтр("ru = 'Гарантийный талон'");
		КомандаПечати.ПроверкаПроведенияПередПечатью = Истина; 
		КомандаПечати.Порядок = 50;
		
		//Комплект для монтажников
		КомандаПечати = КомандыПечати.Добавить();
		КомандаПечати.МенеджерПечати = "Документ.ЗаказДоговор";
		КомандаПечати.Идентификатор = "КомплектДляМонтажников";
		КомандаПечати.Представление = НСтр("ru = 'Комплект для монтажников'");
		КомандаПечати.ПроверкаПроведенияПередПечатью = Истина; 
		КомандаПечати.Порядок = 70;
		Если ПолучитьФункциональнуюОпцию("ИспользоватьПечатныеФормыМонтажаБезСкидок") Тогда
			КомандаПечати = КомандыПечати.Добавить();
			КомандаПечати.МенеджерПечати = "Документ.ЗаказДоговор";
			КомандаПечати.Идентификатор = "КомплектДляМонтажников_ПересчетЦены";
			КомандаПечати.Представление = НСтр("ru = 'Комплект для монтажников (пересчет цены по скидке)'");
			КомандаПечати.ПроверкаПроведенияПередПечатью = Истина;
			КомандаПечати.Порядок = 75;
		КонецЕсли;
	КонецЕсли;

	//Комплект для клиента
    КомандаПечати = КомандыПечати.Добавить();
    КомандаПечати.МенеджерПечати = "Документ.ЗаказДоговор";
    КомандаПечати.Идентификатор = "КомплектДляКлиента";
    КомандаПечати.Представление = НСтр("ru = 'Комплект для клиента'");
    КомандаПечати.ПроверкаПроведенияПередПечатью = Истина; 
	КомандаПечати.Порядок = 60;
	Если ПолучитьФункциональнуюОпцию("ИспользоватьПечатныеФормыМонтажаБезСкидок") Тогда
		КомандаПечати = КомандыПечати.Добавить();
		КомандаПечати.МенеджерПечати = "Документ.ЗаказДоговор";
		КомандаПечати.Идентификатор = "КомплектДляКлиента_ПересчетЦены";
		КомандаПечати.Представление = НСтр("ru = 'Комплект для клиента (пересчет цены по скидке)'");
		КомандаПечати.ПроверкаПроведенияПередПечатью = Истина;
		КомандаПечати.Порядок = 65;
	КонецЕсли;
	
	//#14602
	Если ПолучитьФункциональнуюОпцию("ЗаполнениеМатериаловРозницы") = 0 Тогда
		КомандаПечати = КомандыПечати.Добавить();
		КомандаПечати.МенеджерПечати = "Документ.ЗаказДоговор";
		КомандаПечати.Идентификатор = "Материалы";
		КомандаПечати.Представление = НСтр("ru = 'Материалы'");
		КомандаПечати.Порядок = 77; 
		КомандаПечати.ЗаголовокФормы = НСтр("ru = 'Материалы'");	
	КонецЕсли;
	
	//Счет на оплату
    КомандаПечати = КомандыПечати.Добавить();
    КомандаПечати.МенеджерПечати = "Документ.ЗаказДоговор";
    КомандаПечати.Идентификатор = "СчетНаОплату";
    КомандаПечати.Представление = НСтр("ru = 'Счет на оплату'");
	КомандаПечати.Порядок = 80;
    //КомандаПечати.ПроверкаПроведенияПередПечатью = Истина; 
	КомандаПечати.ЗаголовокФормы = НСтр("ru = 'Счет на оплату'");
	
	// Счет на оплату (с печатью и подписями) 
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати = "Документ.ЗаказДоговор";
	КомандаПечати.Идентификатор  = "СчетНаОплатуСПечатью";
	КомандаПечати.Представление  = НСтр("ru = 'Счет на оплату (с печатью и подписями) '");
	КомандаПечати.Порядок = 85;
	//КомандаПечати.ПроверкаПроведенияПередПечатью = Истина; 
	КомандаПечати.ЗаголовокФормы = НСтр("ru = 'Счет на оплату'");
	
КонецПроцедуры

// Формирует печатные формы.
//
// Параметры:
// МассивОбъектов – Массив – ссылки на объекты, которые нужно распечатать;
// ПараметрыПечати – Структура – дополнительные настройки печати;
// КоллекцияПечатныхФорм – ТаблицаЗначений – сформированные табличные документы (выходной параметр)
// ОбъектыПечати – СписокЗначений – значение – ссылка на объект;
// представление – имя области, в которой был выведен объект (выходной параметр);
// ПараметрыВывода – Структура – дополнительные параметры сформированных табличных документов (выходной параметр).
//
Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
		
    Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "Договор") Тогда
        УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
        КоллекцияПечатныхФорм,
        "Договор",
        НСтр("ru = 'Договор'"),
        ПечатьДоговор(МассивОбъектов, ОбъектыПечати),
        ,
        "Документ.ЗаказДоговор.ПФ_MXL_Договор");
	ИначеЕсли УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ДоговорРассрочка") Тогда
        УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
        КоллекцияПечатныхФорм,
        "ДоговорРассрочка",
        НСтр("ru = 'Договор (рассрочка)'"),
        ПечатьДоговор(МассивОбъектов, ОбъектыПечати, Истина),
        ,
        "Документ.ЗаказДоговор.ПФ_MXL_ДоговорРассрочка");
		
	ИначеЕсли УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "АктВыполненныхРабот") Тогда 
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "АктВыполненныхРабот", НСтр("ru = 'Акт выполненных работ'"),
	    	ПечатьАктаВыполненныхРабот(МассивОбъектов, ОбъектыПечати));
	ИначеЕсли УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "АктВыполненныхРабот_ПересчетЦены") Тогда 
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "АктВыполненныхРабот_ПересчетЦены", НСтр("ru = 'Акт выполненных работ (пересчет цены по скидке)'"),
	    	ПечатьАктаВыполненныхРабот(МассивОбъектов, ОбъектыПечати, Истина));
		
	ИначеЕсли УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "Смета") Тогда
        УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
        КоллекцияПечатныхФорм,
        "Смета",
        НСтр("ru = 'Смета'"),
        ПечатьПриложениеПоКомнатам(МассивОбъектов, ОбъектыПечати),
        ,
		"Документ.ЗаказДоговор.ПФ_MXL_СметаСоСкидкой");
	ИначеЕсли УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ГарантийныйТалон") Тогда 
	    УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
	    КоллекцияПечатныхФорм,
	    "ГарантийныйТалон",
	    НСтр("ru = 'Гарантийный талон'"),
	    ПечатьГарантийныйТалон(МассивОбъектов, ОбъектыПечати),
	    ,
	    "Документ.Монтаж.ПФ_MXL_ГарантийныйТалон");
		
	ИначеЕсли УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "КомплектДляКлиента") Тогда
        УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "КомплектДляКлиента", НСтр("ru = 'Комплект для клиента'"),
        	ПечатьКомплектДляКлиента(МассивОбъектов, ОбъектыПечати));
	ИначеЕсли УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "КомплектДляКлиента_ПересчетЦены") Тогда
        УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "КомплектДляКлиента_ПересчетЦены", НСтр("ru = 'Комплект для клиента (пересчет цены по скидке)'"),
        	ПечатьКомплектДляКлиента(МассивОбъектов, ОбъектыПечати, Истина));
		
	ИначеЕсли УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "КомплектДляМонтажников") Тогда
        УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "КомплектДляМонтажников", НСтр("ru = 'Комплект для монтажников'"),
        		ПечатьКомплектДляМонтажников(МассивОбъектов, ОбъектыПечати));				
	ИначеЕсли УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "КомплектДляМонтажников_ПересчетЦены") Тогда
        УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "КомплектДляМонтажников_ПересчетЦены", НСтр("ru = 'Комплект для монтажников (пересчет цены по скидке)'"),
        		ПечатьКомплектДляМонтажников(МассивОбъектов, ОбъектыПечати, Истина));
				
	ИначеЕсли УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "СчетНаОплату") Тогда		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "СчетНаОплату", НСтр("ru = 'Счет на оплату'"),
        		ПечатьСчетНаОплату(МассивОбъектов, ОбъектыПечати));		
	ИначеЕсли УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "СчетНаОплатуСПечатью") Тогда		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "СчетНаОплатуСПечатью", НСтр("ru = 'Счет на оплату (с печатью и подписями)'"),
        		ПечатьСчетНаОплату(МассивОбъектов, ОбъектыПечати, Истина));
				
	ИначеЕсли УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "Материалы") Тогда
        УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "Материалы", НСтр("ru = 'Материалы'"),
        	ОбщийМодульСервер.ПечатьРозницаМатериалы(МассивОбъектов, ОбъектыПечати, "Документ.ЗаказДоговор.ПФ_MXL_Материалы"));
			
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьТекстЗапроса(СДаннымиПоМонтажу=Ложь)
	ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ДокументЗаказДоговор.Ссылка,
	|	ДокументЗаказДоговор.ВерсияДанных,
	|	ДокументЗаказДоговор.ПометкаУдаления,
	|	ДокументЗаказДоговор.Номер,
	|	ДокументЗаказДоговор.Дата КАК ДатаДокумента,
	|	ВЫРАЗИТЬ("""" КАК Строка(15)) КАК Дата,
	|	ДокументЗаказДоговор.Проведен,
	|	ДокументЗаказДоговор.Адрес,
	|	ДокументЗаказДоговор.Валюта,
	|	ДокументЗаказДоговор.ВидСкидки,
	|	ДокументЗаказДоговор.ИсполнительЗамера,
	|	ДокументЗаказДоговор.Комментарий,
	|	ДокументЗаказДоговор.Контрагент,
	|	ВЫБОР КОГДА НЕ ДокументЗаказДоговор.Контрагент.НаименованиеПолное = """"
	|		ТОГДА
	|			ДокументЗаказДоговор.Контрагент.НаименованиеПолное
	|		ИНАЧЕ
	|			ДокументЗаказДоговор.Контрагент.Наименование
	|		КОНЕЦ КАК ПредставлениеКонтрагента,	
	|	ДокументЗаказДоговор.Контрагент.КонтактноеЛицоПодписант КАК КонтрагентПодписант,
	|	ДокументЗаказДоговор.Контрагент.КонтактноеЛицоПодписант.Должность КАК КонтрагентПодписантДолжность,
	|	ДокументЗаказДоговор.Менеджер,
	|	ДокументЗаказДоговор.НомерДоговора,
	|	ДокументЗаказДоговор.Основание,
	|	ДокументЗаказДоговор.Автор,
	|	ДокументЗаказДоговор.СуммаДокумента,
	|	ДокументЗаказДоговор.ДоговорРассторгнут,
	|	СоглашениеОРасторженииДоговора.ПричинаРасторженияДоговора,
	|	ДокументЗаказДоговор.Организация КАК Организация,
	|	ДокументЗаказДоговор.Организация.ПолноеНаименование КАК ОрганизацияПолноеНаименование,
	|	ДокументЗаказДоговор.Организация.ЯвляетсяПлательщикомНДС КАК ЯвляетсяПлательщикомНДС,
	|	ДокументЗаказДоговор.Организация.Руководитель КАК ОрганизацияПодписант,
	|	ДокументЗаказДоговор.Организация.Руководитель.Должность КАК ОрганизацияПодписантДолжность,
	|	ДокументЗаказДоговор.ВидЦен,
	|	ДокументЗаказДоговор.ТоварыУслуги.(
	|		Ссылка,
	|		НомерСтроки,
	|		Номенклатура.Артикул КАК Артикул,
	|		Номенклатура,
	|		ХарактеристикаНоменклатуры,
	|		Номенклатура.ВидНоменклатуры КАК ВидНоменклатуры,
	|		Количество,
	|		ЕдиницаИзмерения,
	|		Коэффициент,
	|		Цена,
	|		Сумма,
	|		СтавкаНДС,
	|		СуммаНДС,
	|		Спецификация,
	|		ПроцентСкидки,
	|		СуммаСкидки,
	//|		ЦветФактуры,
	|		НомерПотолка,
	|		Комната
	|	) КАК ТоварыУслуги,
	|	ДокументЗаказДоговор.Материалы.(
	|		Ссылка,
	|		НомерСтроки,
	|		Номенклатура.Артикул КАК Артикул,
	|		Номенклатура,
	|		ХарактеристикаНоменклатуры,
	|		Номенклатура.ВидНоменклатуры КАК ВидНоменклатуры,
	|		Количество,
	|		ЕдиницаИзмерения,
	|		Коэффициент
	|	) КАК Материалы,
	|	ДокументЗаказДоговор.Представители.(
	|		Ссылка,
	|		НомерСтроки,
	|		ФИО,
	|		КонтактныйТелефон,
	|		Комментарий
	|	),
	|	ДокументЗаказДоговор.ГрафикОплат.(
	|		Ссылка,
	|		НомерСтроки,
	|		ДатаПлатежа КАК ДатаПлатежаДокумент,
	|		""текстовая строка"" КАК ДатаПлатежа,
	|		Сумма
	|	) КАК ГрафикОплат,
	|	ДокументЗаказДоговор.Представление,
	|	ДокументЗаказДоговор.МоментВремени,
	|	РасчетыПоЗаказамОстатки.СуммаОстаток КАК ДолгПоДоговору,
	|	ВзаиморасчетыСКонтрагентамиОстатки.СуммаОстаток КАК ОбщийДолг,
	|	ДокументыУдостоверяющиеЛичность.Вид КАК ПаспортВид,
	|	ДокументыУдостоверяющиеЛичность.Серия КАК ПаспортСерия,
	|	ДокументыУдостоверяющиеЛичность.Номер КАК ПаспортНомер,
	|	ДокументыУдостоверяющиеЛичность.КемВыдан КАК ПаспортКемВыдан,
	|	ДокументыУдостоверяющиеЛичность.ДатаВыдачи КАК ПаспортДатаВыдачи,
	|	ВалютаУчета.Значение.Ссылка КАК ВалютаУчета";
	
	Если СДаннымиПоМонтажу Тогда
		ТекстЗапроса = ТекстЗапроса +
		",
		|	Монтаж.Бригада КАК Бригада,
		|	Монтаж.Бригадир КАК Бригадир,
		|	Монтаж.ДатаМонтажа КАК ДатаМонтажа,
		|	Монтаж.ВремяНачала КАК ВремяНачала,
		|	Монтаж.ВремяОкончания КАК ВремяОкончания,
		|	""01.01.0001"" КАК ДатаМонтажаФормат,
		|	""00:00:00"" КАК ВремяНачалаФормат,
		|	""00:00:00"" КАК ВремяОкончанияФормат";
	КонецЕсли;
	
	ТекстЗапроса = ТекстЗапроса +
	" ИЗ
	|	Документ.ЗаказДоговор КАК ДокументЗаказДоговор
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ВзаиморасчетыСКонтрагентами.Остатки КАК ВзаиморасчетыСКонтрагентамиОстатки
    |		ПО ДокументЗаказДоговор.Контрагент = ВзаиморасчетыСКонтрагентамиОстатки.Контрагент
    |			И ДокументЗаказДоговор.Организация = ВзаиморасчетыСКонтрагентамиОстатки.Организация
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ДокументыУдостоверяющиеЛичность КАК ДокументыУдостоверяющиеЛичность
	|		ПО ДокументЗаказДоговор.Контрагент.ДокументУдостоверяющийЛичность = ДокументыУдостоверяющиеЛичность.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.РасчетыПоЗаказам.Остатки КАК РасчетыПоЗаказамОстатки
    |		ПО ДокументЗаказДоговор.Ссылка = РасчетыПоЗаказамОстатки.Заказ
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.СоглашениеОРасторженииДоговора КАК СоглашениеОРасторженииДоговора
	|		ПО ДокументЗаказДоговор.Ссылка = СоглашениеОРасторженииДоговора.ЗаказДоговор";
	
	Если СДаннымиПоМонтажу Тогда
		ТекстЗапроса = ТекстЗапроса +
		"		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Монтаж КАК Монтаж
		|		ПО (Монтаж.Основание = ДокументЗаказДоговор.Ссылка)
		|		И НЕ Монтаж.ПометкаУдаления";
	КонецЕсли;
	ТекстЗапроса = ТекстЗапроса + ", Константа.ВалютаУчета КАК ВалютаУчета";
	
	ТекстЗапроса = ТекстЗапроса +
	" ГДЕ
	|	ДокументЗаказДоговор.Ссылка В(&МассивОбъектов)";	

	Возврат ТекстЗапроса;
КонецФункции

