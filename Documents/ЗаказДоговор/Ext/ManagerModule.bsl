	|	ВЫБОР
    |		КОГДА ДанныеТабличнойЧасти.Номенклатура.УчитыватьКакПотолокВОтчетахПоЭффективности
    |				ИЛИ ДанныеТабличнойЧасти.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Справочник.ВидыНоменклатуры.Потолок)
    |				ИЛИ ДанныеТабличнойЧасти.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Справочник.ВидыНоменклатуры.Отрез)
    |				ИЛИ ДанныеТабличнойЧасти.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Справочник.ВидыНоменклатуры.ТиповойОтрез)
    |			ТОГДА ДанныеТабличнойЧасти.Количество
    |		ИНАЧЕ 0
    |	КОНЕЦ КАК ПлощадьПотолков,
    |	ВЫБОР
    |		КОГДА ДанныеТабличнойЧасти.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Справочник.ВидыНоменклатуры.Материал)
    |			ТОГДА ИСТИНА
    |		ИНАЧЕ ЛОЖЬ
    |	КОНЕЦ КАК ЭтоТовар,
	|	ВЫБОР
    |		КОГДА ДанныеТабличнойЧасти.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Справочник.ВидыНоменклатуры.Материал)
    |			ТОГДА ДанныеТабличнойЧасти.Сумма
    |		ИНАЧЕ 0
    |	КОНЕЦ КАК СуммаТоваров,
    |	ВЫБОР
    |		КОГДА ДанныеТабличнойЧасти.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Справочник.ВидыНоменклатуры.Услуга)
    |			ТОГДА ИСТИНА
    |		ИНАЧЕ ЛОЖЬ
    |	КОНЕЦ КАК ЭтоУслуга,
	|	ВЫБОР
    |		КОГДА ДанныеТабличнойЧасти.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Справочник.ВидыНоменклатуры.Услуга)
    |			ТОГДА ДанныеТабличнойЧасти.Сумма
    |		ИНАЧЕ 0
    |	КОНЕЦ КАК СуммаУслуг
    |ИЗ
    |	Документ.ЗаказДоговор.ТоварыУслуги КАК ДанныеТабличнойЧасти
    |ГДЕ
    |	ДанныеТабличнойЧасти.Ссылка В(&МассивОбъектов)
    |
    |УПОРЯДОЧИТЬ ПО
    |	ДанныеТабличнойЧасти.Ссылка,
    |	ДанныеТабличнойЧасти.НомерСтроки
    |ИТОГИ
	|	СУММА(Сумма),
	|	СУММА(СуммаНДС),
	|	СУММА(СуммаСкидки),
	|	СУММА(СуммаТоваров),
	|	СУММА(СуммаУслуг),
	|	СУММА(ПлощадьПотолков),
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ КоличествоКомнат)
	|ПО
    |	Ссылка
    |;
    |
    |////////////////////////////////////////////////////////////////////////////////
    |ВЫБРАТЬ РАЗРЕШЕННЫЕ
    |	ДанныеТабличнойЧасти.Ссылка КАК Ссылка,
    |	ДанныеТабличнойЧасти.НомерСтроки КАК НомерСтроки,
    |	ДанныеТабличнойЧасти.Номенклатура.Артикул КАК Артикул,
    |	ДанныеТабличнойЧасти.Номенклатура КАК Номенклатура,
    |	ДанныеТабличнойЧасти.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
    |	ДанныеТабличнойЧасти.Количество КАК Количество,
    |	ДанныеТабличнойЧасти.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
    |	ДанныеТабличнойЧасти.Коэффициент КАК Коэффициент,
    |	ДанныеТабличнойЧасти.Комната КАК Комната,
    |	ДанныеТабличнойЧасти.УИСтроки КАК УИСтроки,
    |	ДанныеТабличнойЧасти.НоменклатураТоваров КАК НоменклатураТоваров
    |ИЗ
    |	Документ.ЗаказДоговор.Материалы КАК ДанныеТабличнойЧасти
    |ГДЕ
    |	ДанныеТабличнойЧасти.Ссылка В(&МассивОбъектов)
    |
    |УПОРЯДОЧИТЬ ПО
    |	ДанныеТабличнойЧасти.Ссылка,
    |	ДанныеТабличнойЧасти.НомерСтроки
    |ИТОГИ ПО
    |	Ссылка
    |;
    |
    |////////////////////////////////////////////////////////////////////////////////
    |ВЫБРАТЬ РАЗРЕШЕННЫЕ
    |	ДанныеТабличнойЧасти.Ссылка КАК Ссылка,
    |	ДанныеТабличнойЧасти.НомерСтроки КАК НомерСтроки,
    |	ДанныеТабличнойЧасти.ДатаПлатежа КАК ДатаПлатежа,
    |	ДанныеТабличнойЧасти.Сумма КАК Сумма
    |ИЗ
    |	Документ.ЗаказДоговор.ГрафикОплат КАК ДанныеТабличнойЧасти
    |ГДЕ
    |	ДанныеТабличнойЧасти.Ссылка В(&МассивОбъектов)
    |
    |УПОРЯДОЧИТЬ ПО
    |	ДанныеТабличнойЧасти.Ссылка,
    |	ДанныеТабличнойЧасти.НомерСтроки
    |ИТОГИ ПО
    |	Ссылка
    |;
    |
    |////////////////////////////////////////////////////////////////////////////////
    |ВЫБРАТЬ РАЗРЕШЕННЫЕ
    |	ДанныеТабличнойЧасти.Ссылка КАК Ссылка,
    |	ДанныеТабличнойЧасти.НомерСтроки КАК НомерСтроки,
    |	ДанныеТабличнойЧасти.ФИО КАК ФИО,
    |	ДанныеТабличнойЧасти.КонтактныйТелефон КАК КонтактныйТелефон,
    |	ДанныеТабличнойЧасти.Комментарий КАК Комментарий
    |ИЗ
    |	Документ.ЗаказДоговор.Представители КАК ДанныеТабличнойЧасти
    |ГДЕ
    |	ДанныеТабличнойЧасти.Ссылка В(&МассивОбъектов)
    |
    |УПОРЯДОЧИТЬ ПО
    |	ДанныеТабличнойЧасти.Ссылка,
    |	ДанныеТабличнойЧасти.НомерСтроки
    |ИТОГИ ПО
    |	Ссылка";
    	
	МассивРезультатов         = Запрос.ВыполнитьПакет();
	РезультатПоШапке          = МассивРезультатов[0];
	РезультатПоТабличнойЧасти = МассивРезультатов[1];
	РезультатПоТабличнойЧастиМатериалы = МассивРезультатов[2];
	РезультатПоТабличнойЧастиГрафик = МассивРезультатов[3];
	РезультатПоТабличнойЧастиПредставители = МассивРезультатов[4];
	
	СтруктураДанныхДляПечати 	= Новый Структура("РезультатПоШапке, РезультатПоТабличнойЧасти, РезультатПоТабличнойЧастиТовары, РезультатПоТабличнойЧастиМатериалы, РезультатПоТабличнойЧастиГрафик, РезультатПоТабличнойЧастиПредставители",
	                                               РезультатПоШапке, РезультатПоТабличнойЧасти, РезультатПоТабличнойЧасти,       РезультатПоТабличнойЧастиМатериалы, РезультатПоТабличнойЧастиГрафик, РезультатПоТабличнойЧастиПредставители);
	
	Возврат СтруктураДанныхДляПечати;
    
КонецФункции

Процедура ДополнитьДанныеДляПечатныхФорм(РезультатЗапроса, ВыборкаПоТоварам=Неопределено) Экспорт
	
	РезультатЗапроса.Колонки.Добавить("ДатаФормат");
	РезультатЗапроса.Колонки.Добавить("ДатаДокументаФормат");
	РезультатЗапроса.Колонки.Добавить("ДатаДоговораФормат");
	
	РезультатЗапроса.Колонки.Добавить("ПредставлениеРеквизитов"); //++ 2019-04-04
	РезультатЗапроса.Колонки.Добавить("ПредставлениеЮридическогоАдреса"); //++ 2019-04-04
	РезультатЗапроса.Колонки.Добавить("ПаспортПредставление");
	//РезультатЗапроса.Колонки.Добавить("СуммаИтогСкидка");
	//РезультатЗапроса.Колонки.Добавить("СуммаНДС");
	
	//РезультатЗапроса.Колонки.Добавить("ИтогоСумма");
	//РезультатЗапроса.Колонки.Добавить("ИтогоСуммаСкидки");
	РезультатЗапроса.Колонки.Добавить("ИтогоСуммаБезСкидки");
	РезультатЗапроса.Колонки.Добавить("ИтоговаяСтрока");
	
	РезультатЗапроса.Колонки.Добавить("СуммаДокументаБезСкидки");   
	РезультатЗапроса.Колонки.Добавить("СуммаПредоплаты");
	РезультатЗапроса.Колонки.Добавить("СуммаКОплате");	
	РезультатЗапроса.Колонки.Добавить("СуммаДокументаПрописью");   
	РезультатЗапроса.Колонки.Добавить("СуммаПредоплатыПрописью"); 
	//РезультатЗапроса.Колонки.Добавить("ПлощадьЗаказа");

	Если РезультатЗапроса.Колонки.Найти("ДатаМонтажаФормат") = Неопределено Тогда
		РезультатЗапроса.Колонки.Добавить("ДатаМонтажаФормат");
	КонецЕсли;
	Если РезультатЗапроса.Колонки.Найти("ВремяНачалаФормат") = Неопределено Тогда
		РезультатЗапроса.Колонки.Добавить("ВремяНачалаФормат");
	КонецЕсли;
	Если РезультатЗапроса.Колонки.Найти("ВремяОкончанияФормат") = Неопределено Тогда
		РезультатЗапроса.Колонки.Добавить("ВремяОкончанияФормат");
	КонецЕсли;
	
	РезультатЗапроса.Колонки.Добавить("ЗамерщикКонтактныйТелефон");
	РезультатЗапроса.Колонки.Добавить("ЗамерщикЛичныйТелефон");
	
	РезультатЗапроса.Колонки.Добавить("ДатаПечати");
	РезультатЗапроса.Колонки.Добавить("ВремяФормированияПФ");
	
	ОбщийМодульСервер.ДобавитьКолонкиКонтактнойИнформации(РезультатЗапроса);
	
	Для Каждого ТекущаяСтрока Из РезультатЗапроса Цикл
		
		ТекущаяСтрока.ДатаФормат = Формат(ТекущаяСтрока.Дата, "ДЛФ=D");
		ТекущаяСтрока.ДатаДокументаФормат = Формат(ТекущаяСтрока.ДатаДокумента, "ДЛФ=D");
		ТекущаяСтрока.ДатаДоговораФормат = Формат(ТекущаяСтрока.ДатаДоговора, "ДЛФ=D");
		
		Если НЕ РезультатЗапроса.Колонки.Найти("ГрафикОплат") = Неопределено Тогда
			Для Каждого ПодСтрока Из ТекущаяСтрока.ГрафикОплат Цикл
				ПодСтрока.ДатаПлатежа = Формат(ПодСтрока.ДатаПлатежаДокумент, "ДЛФ=D");
			КонецЦикла;
		КонецЕсли;	
		
		Попытка
			ТекущаяСтрока.Номер = ПрефиксацияОбъектовКлиентСервер.НомерНаПечать(ТекущаяСтрока.Номер);
		Исключение
		КонецПопытки;
		Попытка	
		    ТекущаяСтрока.ДатаМонтажаФормат = Формат(ТекущаяСтрока.ДатаМонтажа,"ДЛФ=Д");
			ТекущаяСтрока.ВремяНачалаФормат = Формат(ТекущаяСтрока.ВремяНачала, "ДФ=""ЧЧ:мм:сс""");
			ТекущаяСтрока.ВремяОкончанияФормат = Формат(ТекущаяСтрока.ВремяОкончания, "ДФ=""ЧЧ:мм:сс""");
		Исключение
		КонецПопытки;
		Если ТекущаяСтрока.Контрагент.ВидКонтрагента = Перечисления.ВидКонтрагента.ФизЛицо Тогда
			Если НЕ ПустаяСтрока(ТекущаяСтрока.ПаспортНомер) Тогда
				ТекущаяСтрока.ПаспортПредставление = "Документ: " + ТекущаяСтрока.ПаспортВид + " серия: " + ТекущаяСтрока.ПаспортСерия
					+ " номер: " + ТекущаяСтрока.ПаспортНомер + ", выдан: " + ТекущаяСтрока.ПаспортКемВыдан + " " + Формат(ТекущаяСтрока.ПаспортДатаВыдачи,"ДЛФ=Д");
			КонецЕсли;
		КонецЕсли;
		
		Если НЕ ВыборкаПоТоварам = Неопределено Тогда
			СтруктураПоиска = Новый Структура("Ссылка", ТекущаяСтрока.Ссылка);
			ВыборкаПоТоварам.Сбросить();
			Если ВыборкаПоТоварам.НайтиСледующий(СтруктураПоиска) Тогда
				ТекущаяСтрока.СуммаСкидки = ВыборкаПоТоварам.СуммаСкидки;
				ТекущаяСтрока.Скидка = ВыборкаПоТоварам.СуммаСкидки;
				ТекущаяСтрока.СуммаИтогСкидка = ВыборкаПоТоварам.СуммаСкидки;
				ТекущаяСтрока.ИтогоСуммаСкидки = ВыборкаПоТоварам.СуммаСкидки;
				ТекущаяСтрока.СуммаТоваров = ВыборкаПоТоварам.СуммаТоваров;
				ТекущаяСтрока.СуммаУслуг = ВыборкаПоТоварам.СуммаУслуг;
				ТекущаяСтрока.ПлощадьПотолков = ВыборкаПоТоварам.ПлощадьПотолков;
				ТекущаяСтрока.ПлощадьЗаказа = ВыборкаПоТоварам.ПлощадьПотолков;
				ТекущаяСтрока.КоличествоКомнат = ВыборкаПоТоварам.КоличествоКомнат;	
				ТекущаяСтрока.КолвоПозиций = ВыборкаПоТоварам.НомерСтроки;
				ТекущаяСтрока.СуммаНДС = ВыборкаПоТоварам.СуммаНДС;
				ТекущаяСтрока.ИтогоСуммаНДС = ВыборкаПоТоварам.СуммаНДС;
				ТекущаяСтрока.ИтогоСумма = ВыборкаПоТоварам.Сумма;
			КонецЕсли;						
		КонецЕсли;
		//ТекущаяСтрока.СуммаНДС = ТекущаяСтрока.Ссылка.ТоварыУслуги.Итог("СуммаНДС");
		//ТекущаяСтрока.ИтогоСуммаНДС = ТекущаяСтрока.Ссылка.ТоварыУслуги.Итог("СуммаНДС");
		//ТекущаяСтрока.ИтогоСумма = ТекущаяСтрока.Ссылка.ТоварыУслуги.Итог("Сумма");
		
		//ТекущаяСтрока.СуммаИтогСкидка = ТекущаяСтрока.Ссылка.ТоварыУслуги.Итог("СуммаСкидки");
		ТекущаяСтрока.ИтогоСуммаСкидки = ТекущаяСтрока.СуммаИтогСкидка;
		ТекущаяСтрока.СуммаДокументаБезСкидки = ТекущаяСтрока.СуммаДокумента + ТекущаяСтрока.СуммаИтогСкидка;
		
		ТекущаяСтрока.ИтогоСуммаБезСкидки = ТекущаяСтрока.ИтогоСумма + ТекущаяСтрока.ИтогоСуммаСкидки; 
		
		ТекущаяСтрока.СуммаПредоплаты = ПолучитьСуммуПоступленийНаДатуВыполненияМонтажа(ТекущаяСтрока.Ссылка);
		ТекущаяСтрока.СуммаКОплате = ТекущаяСтрока.СуммаДокумента - ТекущаяСтрока.СуммаПредоплаты;
		
		ТекущаяСтрока.СуммаДокументаПрописью = РаботаСВалютой.СформироватьЧислоПрописью(ТекущаяСтрока.СуммаДокумента, ТекущаяСтрока.Валюта, Ложь);		
		ТекущаяСтрока.СуммаПредоплатыПрописью = РаботаСВалютой.СформироватьЧислоПрописью(ТекущаяСтрока.СуммаПредоплаты, ТекущаяСтрока.Валюта, Ложь);

		СведенияОКонтрагенте = ОбщийМодульСервер.СведенияОКонтрагенте(ТекущаяСтрока.Контрагент);
		
		ТекущаяСтрока.ПредставлениеЮридическогоАдреса = ОбщийМодульСервер.ПредставлениеЮридическогоАдреса(СведенияОКонтрагенте.ЮридическийАдрес, (ТекущаяСтрока.Контрагент.ВидКонтрагента = Перечисления.ВидКонтрагента.ЮрЛицо));
	
		Если ТекущаяСтрока.Контрагент.ВидКонтрагента = Перечисления.ВидКонтрагента.ЮрЛицо Тогда
			Сведения = "ИНН, КПП, НомерСчета, Банк, БИК, КоррСчет, ТекстКорреспондента";
			ТекущаяСтрока.ПредставлениеРеквизитов = ОбщийМодульСервер.ОписаниеОрганизации(СведенияОКонтрагенте, Сведения); 
		Иначе
			Сведения = "ИНН";
			ПредставлениеРеквизитов = ОбщийМодульСервер.ОписаниеОрганизации(СведенияОКонтрагенте, Сведения);
			Если НЕ ПустаяСтрока(ТекущаяСтрока.ПаспортПредставление) Тогда		
				ПредставлениеРеквизитов = ПредставлениеРеквизитов + ?(ПустаяСтрока(ПредставлениеРеквизитов), "", ", ") + ТекущаяСтрока.ПаспортПредставление;
			КонецЕсли;
			ТекущаяСтрока.ПредставлениеРеквизитов = ПредставлениеРеквизитов;
		КонецЕсли;
		
		//ТекущаяСтрока.ПлощадьЗаказа = РассчитатьПлощадьПотолков(ТекущаяСтрока.Ссылка.ТоварыУслуги);
		
		ТекущаяСтрока.ИтоговаяСтрока = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru='Всего наименований %1, на сумму %2 %3'"),
			//ТекущаяСтрока.Ссылка.ТоварыУслуги.Количество(),
			ТекущаяСтрока.КолвоПозиций,
			Формат(ТекущаяСтрока.СуммаДокумента, "ЧДЦ=2"),
			ТекущаяСтрока.Валюта);	
			
		Если ТекущаяСтрока.ИтогоСуммаНДС = 0 Тогда			
			ТекущаяСтрока.НДС = "Без налога (НДС)";		
		Иначе			
			ТекущаяСтрока.НДС = "В том числе НДС:";	
		КонецЕсли;

		ТекущаяСтрока.ЗамерщикКонтактныйТелефон = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(ТекущаяСтрока.ИсполнительЗамера, Справочники.ВидыКонтактнойИнформации.ТелефонСотрудника);
		ТекущаяСтрока.ЗамерщикЛичныйТелефон     = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(ТекущаяСтрока.ИсполнительЗамера, Справочники.ВидыКонтактнойИнформации.ЛичныйТелефонСотрудника);
		
		ОбщийМодульСервер.ДополнитьДанныеДляПечатныхФормКонтактнойИнформацией(ТекущаяСтрока, ТекущаяСтрока.Организация, ТекущаяСтрока.Контрагент);
		
		ТекущаяСтрока.ДатаПечати = Формат(ТекущаяДатаСеанса(), "ДЛФ=Д");
		ТекущаяСтрока.ВремяФормированияПФ = ТекущаяДатаСеанса();
		
	КонецЦикла;
	
КонецПроцедуры

Функция ПечатьДоговор(МассивОбъектов, ОбъектыПечати, ДоговорВРассрочку = Ложь)
	
    // Создаем табличный документ и устанавливаем имя параметров печати.
    ТабличныйДокумент = Новый ТабличныйДокумент;
    ТабличныйДокумент.ИмяПараметровПечати = "ПараметрыПечати_ЗаказДоговор";
	ТабличныйДокумент.АвтоМасштаб         = Истина;
	ВыводитьАртикул = Константы.ВыводитьАртикулНоменклатурыВПечатныхФормах.Получить();

	// №6303 определяем из какого документа получить данные ЗД или СоРД
	МенеджерОбъекта = ОбщегоНазначения.МенеджерОбъектаПоСсылке(МассивОбъектов[0]);
	СтруктураДанныхДляПечати = МенеджерОбъекта.ПолучитьДанныеДляПечатныхФорм(МассивОбъектов, Истина);
	ТаблицаДанныеПечати      = СтруктураДанныхДляПечати.РезультатПоШапке.Выгрузить();
	МенеджерОбъекта.ДополнитьДанныеДляПечатныхФорм(ТаблицаДанныеПечати);
	ВыборкаПоТоварам 	 	 = СтруктураДанныхДляПечати.РезультатПоТабличнойЧасти.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	ВыборкаПоГрафику = Неопределено;
	ВыборкаПоПредставителям = Неопределено;
	Если СтруктураДанныхДляПечати.Свойство("РезультатПоТабличнойЧастиГрафик") Тогда
		ВыборкаПоГрафику         = СтруктураДанныхДляПечати.РезультатПоТабличнойЧастиГрафик.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	КонецЕсли;
	Если СтруктураДанныхДляПечати.Свойство("РезультатПоТабличнойЧастиПредставители") Тогда
		ВыборкаПоПредставителям  = СтруктураДанныхДляПечати.РезультатПоТабличнойЧастиПредставители.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	КонецЕсли;
	
	// №6303 определяем из какого документа получить данные ЗД или СоРД
	//ПечатьИзДоговора = (МассивОбъектов.Количество() > 0 И ТипЗнч(МассивОбъектов[0]) = Тип("ДокументСсылка.ЗаказДоговор"));
	
	Если НЕ ДоговорВРассрочку Тогда
		Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.ЗаказДоговор.ПФ_MXL_Договор");
	Иначе	
		Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.ЗаказДоговор.ПФ_MXL_ДоговорРассрочка");
	КонецЕсли;
    // Получаем запросом необходимые данные.
	//Запрос = Новый Запрос();
	//Если ПечатьИзДоговора Тогда
	//	Запрос.Текст = ПолучитьТекстЗапроса(Истина);
	//Иначе
	//	Запрос.Текст = Документы.СоглашениеОРасторженииДоговора.ПолучитьТекстЗапроса(Истина);
	//КонецЕсли;
	//Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	
	//подготовим итоговую таблицу с данными
	//РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	//
	//ДополнитьДанныеДляПечатныхФорм(РезультатЗапроса);
	    
    ПервыйДокумент = Истина;
    Для Каждого ДанныеПечати Из ТаблицаДанныеПечати Цикл
        Если Не ПервыйДокумент Тогда
            // Все документы нужно выводить на разных страницах.
            ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
        КонецЕсли;
        ПервыйДокумент = Ложь;
        // Запомним номер строки, с которой начали выводить текущий документ.
        НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы + 1;
		
		ЕстьСекция_СтрокаТабличнойЧастиТовары = Ложь;
		ЕстьСекция_СтрокаТабличнойЧастиПредставители = Ложь;
		ЕстьСекция_СтрокаТабличнойЧастиГрафикПлатежей = Ложь;		
		
		Попытка
			ОбластьМакета  = Макет.ПолучитьОбласть("СтрокаТабличнойЧастиТовары");
			ЕстьСекция_СтрокаТабличнойЧастиТовары = Истина;
		Исключение
		КонецПопытки;
		Попытка
			ОбластьМакета  = Макет.ПолучитьОбласть("СтрокаТабличнойЧастиПредставители");
			ЕстьСекция_СтрокаТабличнойЧастиПредставители = Истина;
		Исключение
		КонецПопытки;
		Попытка
			ОбластьМакета  = Макет.ПолучитьОбласть("СтрокаТабличнойЧастиГрафикПлатежей");
			ЕстьСекция_СтрокаТабличнойЧастиГрафикПлатежей = Истина;
		Исключение
		КонецПопытки;
		
		//шапка 
		Попытка
			ОбластьМакета = Макет.ПолучитьОбласть("Шапка");
			ОбластьМакета.Параметры.Заполнить(ДанныеПечати);
			//если номер договора заполнен подставим его
			Если ЗначениеЗаполнено(ДанныеПечати.НомерДоговора) Тогда
				Попытка
					ОбластьМакета.Параметры.Номер = ДанныеПечати.НомерДоговора;
				Исключение
				КонецПопытки;
			КонецЕсли;	
			ТабличныйДокумент.Вывести(ОбластьМакета);
		Исключение
		КонецПопытки;
		
		// Изменения размера колоноки, в зависимости от вывода Артикула
		Если Не ВыводитьАртикул Тогда
			Попытка
				Макет.Область("ПерваяКолонкаТовара").ШиринаКолонки = Макет.Область("ПерваяКолонкаТовара").ШиринаКолонки + Макет.Область("Артикул").ШиринаКолонки;
			Исключение
			КонецПопытки;
		КонецЕсли;
		
		СтруктураПоиска = Новый Структура("Ссылка", ДанныеПечати.Ссылка);
		//таблица товаров и услуг
		Если ЕстьСекция_СтрокаТабличнойЧастиТовары Тогда
			Попытка
				ОбластьМакета = Макет.ПолучитьОбласть("ШапкаТаблицыТовары|НомерСтроки");
				ОбластьМакета.Параметры.Заполнить(ДанныеПечати);
				ТабличныйДокумент.Вывести(ОбластьМакета);
				
				Если ВыводитьАртикул Тогда
					ОбластьМакета = Макет.ПолучитьОбласть("ШапкаТаблицыТовары|Артикул");
					ОбластьМакета.Параметры.Заполнить(ДанныеПечати);
					ТабличныйДокумент.Присоединить(ОбластьМакета);
				КонецЕсли;
				
				ОбластьМакета = Макет.ПолучитьОбласть("ШапкаТаблицыТовары|Данные");
				ОбластьМакета.Параметры.Заполнить(ДанныеПечати);
				ТабличныйДокумент.Присоединить(ОбластьМакета);
				
				Если ВыборкаПоТоварам.НайтиСледующий(СтруктураПоиска) Тогда						
					Выборка = ВыборкаПоТоварам.Выбрать();
					Пока Выборка.Следующий() Цикл
						ОбластьМакета = Макет.ПолучитьОбласть("СтрокаТабличнойЧастиТовары|НомерСтроки");
						ОбластьМакета.Параметры.Заполнить(ДанныеПечати);
						ОбластьМакета.Параметры.Заполнить(Выборка);
						ТабличныйДокумент.Вывести(ОбластьМакета);
						
						Если ВыводитьАртикул Тогда
							ОбластьМакета = Макет.ПолучитьОбласть("СтрокаТабличнойЧастиТовары|Артикул");
							ОбластьМакета.Параметры.Заполнить(ДанныеПечати);
							ОбластьМакета.Параметры.Заполнить(Выборка);
							ТабличныйДокумент.Присоединить(ОбластьМакета);
						КонецЕсли;
						
						ОбластьМакета = Макет.ПолучитьОбласть("СтрокаТабличнойЧастиТовары|Данные");
						ОбластьМакета.Параметры.Заполнить(ДанныеПечати);
						ОбластьМакета.Параметры.Заполнить(Выборка);
						
						//++ №12909
						//ПредставлениеНоменклатуры = Строка(Выборка.Номенклатура) + Строка(УправлениеПечатью.ПредставлениеХарактеристики(Выборка.ХарактеристикаНоменклатуры));
						ПредставлениеНоменклатуры = ОбщийМодульСервер.ПредставлениеНоменклатурыДляПечати(Выборка.Номенклатура, Выборка.ХарактеристикаНоменклатуры);
						//-- №12909
						
						ОбластьМакета.Параметры.Номенклатура = ПредставлениеНоменклатуры;
						ТабличныйДокумент.Присоединить(ОбластьМакета);
					КонецЦикла;
				КонецЕсли;
			
				ОбластьМакета = Макет.ПолучитьОбласть("ПодвалТабличнойЧастиТовары|НомерСтроки");
				ОбластьМакета.Параметры.Заполнить(ДанныеПечати);
				ТабличныйДокумент.Вывести(ОбластьМакета);
				
				Если ВыводитьАртикул Тогда
					ОбластьМакета = Макет.ПолучитьОбласть("ПодвалТабличнойЧастиТовары|Артикул");
					ОбластьМакета.Параметры.Заполнить(ДанныеПечати);
					ТабличныйДокумент.Присоединить(ОбластьМакета);
				КонецЕсли;
				
				ОбластьМакета = Макет.ПолучитьОбласть("ПодвалТабличнойЧастиТовары|Данные");
				ОбластьМакета.Параметры.Заполнить(ДанныеПечати);
				ТабличныйДокумент.Присоединить(ОбластьМакета);

			Исключение
			КонецПопытки
		КонецЕсли;
		
		//таблица график платежей
		Если ЕстьСекция_СтрокаТабличнойЧастиГрафикПлатежей И НЕ ВыборкаПоГрафику = Неопределено Тогда
			Попытка
				ОбластьМакета = Макет.ПолучитьОбласть("ШапкаТаблицыГрафикПлатежей");
				ОбластьМакета.Параметры.Заполнить(ДанныеПечати);
				ТабличныйДокумент.Вывести(ОбластьМакета);
				
				СтрокаДолгНаНачало = ДанныеПечати.СуммаДокумента;
				СтрокаДолгНаКонец  = ДанныеПечати.СуммаДокумента;
				Если ВыборкаПоГрафику.НайтиСледующий(СтруктураПоиска) Тогда						
					Выборка = ВыборкаПоГрафику.Выбрать();
					Пока Выборка.Следующий() Цикл
						ОбластьМакета = Макет.ПолучитьОбласть("СтрокаТабличнойЧастиГрафикПлатежей");
						ОбластьМакета.Параметры.Заполнить(ДанныеПечати);
						ОбластьМакета.Параметры.Заполнить(Выборка);
						Попытка											
							ОбластьМакета.Параметры.СтрокаДолгНаНачало = СтрокаДолгНаНачало;
							СтрокаДолгНаНачало = СтрокаДолгНаНачало - Выборка.Сумма;
						Исключение					
						КонецПопытки;
						Попытка					
							СтрокаДолгНаКонец = СтрокаДолгНаКонец - Выборка.Сумма;
							ОбластьМакета.Параметры.СтрокаДолгНаКонец = СтрокаДолгНаКонец;										
						Исключение					
						КонецПопытки;
						ТабличныйДокумент.Вывести(ОбластьМакета);
					КонецЦикла;
				КонецЕсли;
				
				ОбластьМакета = Макет.ПолучитьОбласть("ПодвалТабличнойЧастиГрафикПлатежей");
				ОбластьМакета.Параметры.Заполнить(ДанныеПечати);
				ТабличныйДокумент.Вывести(ОбластьМакета);
				
			Исключение
			КонецПопытки
		КонецЕсли;
		
		//таблица представителей
		Если ЕстьСекция_СтрокаТабличнойЧастиПредставители И НЕ ВыборкаПоПредставителям = Неопределено Тогда
			Попытка
				ОбластьМакета = Макет.ПолучитьОбласть("ШапкаТаблицыПредставители");
				ОбластьМакета.Параметры.Заполнить(ДанныеПечати);
				ТабличныйДокумент.Вывести(ОбластьМакета);
				
				Если ВыборкаПоПредставителям.НайтиСледующий(СтруктураПоиска) Тогда						
					Выборка = ВыборкаПоТоварам.Выбрать();
					Пока Выборка.Следующий() Цикл
						ОбластьМакета = Макет.ПолучитьОбласть("СтрокаТабличнойЧастиПредставители");
						ОбластьМакета.Параметры.Заполнить(ДанныеПечати);
						ОбластьМакета.Параметры.Заполнить(Выборка);
						ТабличныйДокумент.Вывести(ОбластьМакета);
					КонецЦикла;
				КонецЕсли;
				ОбластьМакета = Макет.ПолучитьОбласть("ПодвалТабличнойЧастиПредставители");
				ОбластьМакета.Параметры.Заполнить(ДанныеПечати);
				ТабличныйДокумент.Вывести(ОбластьМакета);
				
			Исключение
			КонецПопытки
		КонецЕсли;
		
		//подвал
		Попытка 
			ОбластьМакета = Макет.ПолучитьОбласть("Подвал");
			ОбластьМакета.Параметры.Заполнить(ДанныеПечати);
			ТабличныйДокумент.Вывести(ОбластьМакета);
		Исключение
		КонецПопытки;
		
        // В табличном документе необходимо задать имя области, в которую был 
        // выведен объект. Нужно для возможности печати комплектов документов.
        УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабличныйДокумент, 
            НомерСтрокиНачало, ОбъектыПечати, ДанныеПечати.Ссылка);
	КонецЦикла;
		
    Возврат ТабличныйДокумент;
	
КонецФункции

// не используется
Функция СформироватьПечатнуюФормуПриложения(Ссылка, ВыводитьМатериалы = Ложь) Экспорт
	
	Таб = Новый ТабличныйДокумент;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЗаказДоговор.Номер,
	|	ЗаказДоговор.Дата,
	|	ЗаказДоговор.Валюта,
	|	ЗаказДоговор.ТоварыУслуги.(
	|		НомерСтроки,
	|		Номенклатура,
	|		ХарактеристикаНоменклатуры,
	|		Количество,
	|		ЕдиницаИзмерения,
	|		Коэффициент,
	|		Цена,
	|		Сумма,
	|		ПроцентСкидки,
	|		СуммаСкидки,
	//|		ЦветФактуры,
	|		НомерПотолка,
	|		Комната
	|	),
	|	ЗаказДоговор.Организация.ПолноеНаименование КАК Организация,
	|	ЗаказДоговор.Контрагент,
	|	ВЫБОР КОГДА НЕ ЗаказДоговор.Контрагент.НаименованиеПолное = """"
	|		ТОГДА
	|			ЗаказДоговор.Контрагент.НаименованиеПолное
	|		ИНАЧЕ
	|			ЗаказДоговор.Контрагент.Наименование
	|		КОНЕЦ КАК ПредставлениеКонтрагента,	
	|	ЗаказДоговор.Адрес,
	|	ЗаказДоговор.НомерДоговора,
	|	ЗаказДоговор.Материалы.(
	|		НомерСтроки,
	|		Номенклатура,
	|		ХарактеристикаНоменклатуры,
	|		Количество,
	|		ЕдиницаИзмерения,
	|		Коэффициент
	|	)

	|ИЗ
	|	Документ.ЗаказДоговор КАК ЗаказДоговор
	|ГДЕ
	|	ЗаказДоговор.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Шапка = Запрос.Выполнить().Выбрать();
	
	Пока Шапка.Следующий() Цикл
		
		ЕстьСкидка = Ложь;
		ВремТовары = Шапка.ТоварыУслуги.Выгрузить();
		Если НЕ ВремТовары.Итог("СуммаСкидки") = 0 тогда
			ЕстьСкидка = Истина;
		КонецЕсли;
		
		Если ЕстьСкидка Тогда
			Макет = ПолучитьМакет("ПриложениеКДоговоруСоСкидками");
		Иначе
			Макет = ПолучитьМакет("ПриложениеКДоговору");
		КонецЕсли;
		
		ТекстЗаголовка = "Заказ-договор №" + ПрефиксацияОбъектовКлиентСервер.НомерНаПечать(Шапка.Номер) + " от " + Формат(Шапка.Дата, "ДЛф=Д");
	
		ОбластьМакета = Макет.ПолучитьОбласть("Заголовок");
		ОбластьМакета.Параметры.ТекстЗаголовка = ТекстЗаголовка;
		Таб.Вывести(ОбластьМакета);
		
		ОбластьМакета = Макет.ПолучитьОбласть("Организация");
		ОбластьМакета.Параметры.Организация = Шапка.Организация;
		ОбластьМакета.Параметры.НомерДоговора = Шапка.НомерДоговора;
		Таб.Вывести(ОбластьМакета);
		
		ОбластьМакета = Макет.ПолучитьОбласть("Покупатель");
		ОбластьМакета.Параметры.Контрагент = Шапка.Контрагент;
		ОбластьМакета.Параметры.Адрес = Шапка.Адрес;
		Таб.Вывести(ОбластьМакета);
	
		ОбластьМакета = Макет.ПолучитьОбласть("ШапкаТаблицы|КолонкаНоменклатура");
		Таб.Вывести(ОбластьМакета);
		Если ЕстьСкидка Тогда
			ОбластьМакета = Макет.ПолучитьОбласть("ШапкаТаблицы|КолонкаСкидка");
			Таб.Присоединить(ОбластьМакета);
		КонецЕсли;
		ОбластьМакета = Макет.ПолучитьОбласть("ШапкаТаблицы|КолонкаСумма");
		Таб.Присоединить(ОбластьМакета);
		
		Сумма = 0;
		Товары = Шапка.ТоварыУслуги.Выбрать();
		Пока Товары.Следующий() Цикл
			ОбластьМакета = Макет.ПолучитьОбласть("Строка|КолонкаНоменклатура");
			ЗаполнитьЗначенияСвойств(ОбластьМакета.Параметры, Товары);
			ПредставлениеНоменклатуры = Строка(Товары.Номенклатура) + Строка(ОбщийМодульСервер.ПредставлениеХарактеристики(Товары.ХарактеристикаНоменклатуры));
			ОбластьМакета.Параметры.Номенклатура = ПредставлениеНоменклатуры;
			Таб.Вывести(ОбластьМакета);
			
			Если ЕстьСкидка Тогда
				ОбластьМакета = Макет.ПолучитьОбласть("Строка|КолонкаСкидка");
				ЗаполнитьЗначенияСвойств(ОбластьМакета.Параметры, Товары);
				Таб.Присоединить(ОбластьМакета);
			КонецЕсли;
			
			ОбластьМакета = Макет.ПолучитьОбласть("Строка|КолонкаСумма");
			ЗаполнитьЗначенияСвойств(ОбластьМакета.Параметры, Товары);
			Таб.Присоединить(ОбластьМакета);
			
			Сумма = Сумма + Товары.Сумма;
		КонецЦикла;
		
		ОбластьМакета = Макет.ПолучитьОбласть("Итого|КолонкаНоменклатура");
		ОбластьМакета.Параметры.Сумма = Сумма;
		ОбластьМакета.Параметры.Валюта = Шапка.Валюта;
		Таб.Вывести(ОбластьМакета);
		
		Если ЕстьСкидка Тогда
			ОбластьМакета = Макет.ПолучитьОбласть("Итого|КолонкаСкидка");
			Таб.Присоединить(ОбластьМакета);
		КонецЕсли;
		ОбластьМакета = Макет.ПолучитьОбласть("Итого|КолонкаСумма");
		Таб.Присоединить(ОбластьМакета);
		
		Если ВыводитьМатериалы Тогда
			ОбластьМакета = Макет.ПолучитьОбласть("ШапкаМатериалы");
			Таб.Вывести(ОбластьМакета);
			Материалы = Шапка.Материалы.Выбрать();
			НомерСтроки = 1;
			Пока Материалы.Следующий() Цикл
				Если НЕ Материалы.Номенклатура.Пустая() Тогда
					ОбластьМакета = Макет.ПолучитьОбласть("СтрокаМатериалы");
					ЗаполнитьЗначенияСвойств(ОбластьМакета.Параметры, Материалы);
					ПредставлениеНоменклатуры = Строка(Материалы.Номенклатура) + Строка(ОбщийМодульСервер.ПредставлениеХарактеристики(Материалы.ХарактеристикаНоменклатуры));
					ОбластьМакета.Параметры.Номенклатура = ПредставлениеНоменклатуры;
					ОбластьМакета.Параметры.НомерСтроки = НомерСтроки;
					Таб.Вывести(ОбластьМакета);
					НомерСтроки = НомерСтроки + 1;
				КонецЕсли;
			КонецЦикла;
			ОбластьМакета = Макет.ПолучитьОбласть("ИтогоМатериалы");
			Таб.Вывести(ОбластьМакета);
		КонецЕсли;

		
	КонецЦикла;
	
	Таб.ТолькоПросмотр = Истина;
	Таб.ОтображатьЗаголовки = Ложь;
	Таб.ОтображатьСетку = Ложь;
	
	Возврат Таб;
	
КонецФункции

