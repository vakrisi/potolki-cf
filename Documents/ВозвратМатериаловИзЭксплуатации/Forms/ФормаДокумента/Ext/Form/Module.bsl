&НаКлиенте
Процедура ЗаполнитьПоОстаткам(Команда)
	Если Объект.Товары.Количество() > 0 Тогда
		ЗаполнитьПоОстаткамПослеВопроса = Новый ОписаниеОповещения("ЗаполнитьПоОстаткамПослеВопроса", ЭтаФорма);
		ПоказатьВопрос(ЗаполнитьПоОстаткамПослеВопроса,"Очистить табличную часть товаров?", РежимДиалогаВопрос.ДаНет);
	Иначе
		ЗаполнитьПоОстаткамНаСервере(Ложь);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПоОстаткамПослеВопроса(Результат, Параметры) Экспорт
    Если Результат = КодВозвратаДиалога.Да Тогда
        ЗаполнитьПоОстаткамНаСервере(Истина);
	Иначе
		ЗаполнитьПоОстаткамНаСервере(Ложь);
    КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПоОстаткамНаСервере(Знач ОчиститьТовары = Ложь)
	
	Если ОчиститьТовары Тогда
		Объект.Товары.Очистить();
	КонецЕсли;
	
	ДатаЗапроса = Объект.Дата;
	Если НЕ ДатаЗапроса = Дата(1,1,1) Тогда
		ДатаЗапроса = ТекущаяДатаСеанса();
	КонецЕсли;
	Если КонецДня(ДатаЗапроса) = КонецДня(Объект.Дата) Тогда
		ДатаЗапроса = КонецДня(ДатаЗапроса);
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	МатериалыВЭксплуатацииОстатки.Организация,
	|	МатериалыВЭксплуатацииОстатки.Ответственный,
	|	МатериалыВЭксплуатацииОстатки.Номенклатура,
	|	МатериалыВЭксплуатацииОстатки.ХарактеристикаНоменклатуры,
	|	МатериалыВЭксплуатацииОстатки.СерияНоменклатуры,
	|	МатериалыВЭксплуатацииОстатки.КоличествоОстаток КАК Количество
	|ИЗ
	|	РегистрНакопления.МатериалыВЭксплуатации.Остатки(
	|			&ДатаЗапроса,
	|			Организация = &Организация
	|				И Ответственный = &Ответственный) КАК МатериалыВЭксплуатацииОстатки";
	Запрос.УстановитьПараметр("ДатаЗапроса",ДатаЗапроса);
	Запрос.УстановитьПараметр("Организация",Объект.Организация);
	Запрос.УстановитьПараметр("Ответственный",Объект.Возвращает);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = Объект.Товары.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока,Выборка);
		НоваяСтрока.ЕдиницаИзмерения = НоваяСтрока.Номенклатура.БазоваяЕдиницаИзмерения;
		НоваяСтрока.Коэффициент = 1;
	КонецЦикла;
	
КонецПроцедуры