&НаСервере
Процедура ОбновитьФормуДокумента()
	
	ВалютаУчета = Константы.ВалютаУчета.Получить();
	
	Элементы.НастройкаПоВидамНоменклатурыБонусСуммой.Заголовок = "" + ВалютаУчета + " за единицу товара";
	Элементы.НастройкаПоНоменклатуреБонусСуммой.Заголовок = "" + ВалютаУчета + " за единицу товара";
	
	Если Объект.НастройкаПоВидамНоменклатуры.Количество() = 0 Тогда
		Элементы.ГруппаНастройкаПоВидамНоменклатуры.Заголовок = "По виду номенклатуры";
	Иначе
		Элементы.ГруппаНастройкаПоВидамНоменклатуры.Заголовок = "По виду номенклатуры ("+Объект.НастройкаПоВидамНоменклатуры.Количество()+")";
	КонецЕсли;
	Если Объект.НастройкаПоНоменклатуре.Количество() = 0 Тогда
		Элементы.ГруппаНастройкаПоНоменклатуре.Заголовок = "Номенклатура";
	Иначе
		Элементы.ГруппаНастройкаПоНоменклатуре.Заголовок = "Номенклатура ("+Объект.НастройкаПоНоменклатуре.Количество()+")";
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Ключ.Пустая() или не Объект.Проведен Тогда
		
	КонецЕсли;
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	ОбновитьФормуДокумента();
	
	ПраваПользователей.УстановитьТолькоПросмотрДляРеквизитаНомер(Элементы.Номер.ТолькоПросмотр);
	
	// Видимость колонки Артикул
	ОбщийМодульСервер.УстановитьВидимостьКолонкиАртикулВТабличнойЧасти(ЭтаФорма, "НастройкаПоНоменклатуреНоменклатураАртикул");

КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
КонецПроцедуры

