КонецФункции

&НаСервереБезКонтекста
Функция СохранитьПрикрепленныеДанные(Ссылка, ИмяФайла, Расширение, Данные)
	Результат = Истина;
	Попытка
		
		МенеджерЗаписи = РегистрыСведений.ПрикрепленныеДанные.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.Период = ТекущаяДатаСеанса();
		МенеджерЗаписи.Данные = Новый ХранилищеЗначения(Десериализовать(Данные));
		МенеджерЗаписи.ИмяФайла = ИмяФайла;
		МенеджерЗаписи.Расширение = Расширение;
		МенеджерЗаписи.СсылкаНаОбъект = Ссылка;
		МенеджерЗаписи.Записать(Ложь);
		
	Исключение
		Результат = Ложь;
		Сообщить(" " + ОписаниеОшибки());
	КонецПопытки;
	Возврат Результат;
КонецФункции

//ПРОЦЕДУРЫ И ФУНКЦИИ НА СЕРВЕРЕ
&НаСервере
Функция МоджноЗаписатьДокумент()
	Отказ = Ложь;
	
	Если НЕ Объект.Результат = ПолучитьРезультатОтказПоЗвонку() Тогда
		Если Объект.ВремяНачалаЗамера < Константы.НачалоРабочегоВремениЗамеров.Получить() Тогда
			Сообщить("Время начала замера должно быть не менее " + Формат(Константы.НачалоРабочегоВремениЗамеров.Получить(),"ДЛФ=В") + ". Возможное время начала и завершения замеров указывается в настройках",СтатусСообщения.Важное);
			Отказ = Истина;
		КонецЕсли;
		
		Если Объект.ВремяНачалаЗамера >= Константы.КонецРабочегоВремениЗамеров.Получить() Тогда
			Сообщить("Время начала замера должно быть не более " + Формат(Константы.КонецРабочегоВремениЗамеров.Получить(),"ДЛФ=В") + ". Возможное время начала и завершения замеров указывается в настройках",СтатусСообщения.Важное);
			Отказ = Истина;
		КонецЕсли;
	КонецЕсли;
			
	Если Отказ Тогда 
		Возврат Ложь;
	Иначе
		Возврат Истина;
	КонецЕсли;

КонецФункции

&НаСервере
Функция ПолучитьОсновнойТелефонКонтрагента(Контрагент)
	Возврат "";
КонецФункции

&НаСервере
Функция ПолучитьКонтактыОснования(Основание)
	Если НЕ Основание = Неопределено Тогда
		КонтактыОснования = "ФИО: " + Основание.ИмяКлиента + ". Телефон: " + Основание.СотовыйТелефонКлиента;
		Возврат КонтактыОснования;
	КонецЕсли;
КонецФункции

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Ключ.Пустая() Тогда
		ОбщийМодуль.ЗаполнитьШапкуДокумента(Объект);
		Элементы.ОтказПоЗвонку.Видимость = Ложь;
		Объект.ДатаЗамера = ТекущаяДатаСеанса();
		Объект.ОтветственныйМенеджер = Объект.Ответственный.Сотрудник;
	Иначе
		Элементы.ОтказПоЗвонку.Видимость = Истина;
		ЭтаФорма.ТолькоПросмотр = ПраваПользователей.ДокументТолькоПросмотр(Объект.Ссылка);
	КонецЕсли;

	Если НЕ Параметры.Основание = Неопределено Тогда
		Если НЕ Параметры.Основание.Пустая() Тогда
			Объект.Основание = Параметры.Основание;
			Объект.ИмяКлиента = Параметры.Основание.ИмяКлиента;
			Объект.СотовыйТелефонКлиента = Параметры.Основание.СотовыйТелефонКлиента;
		КонецЕсли;
	КонецЕсли;
	
	ПраваПользователей.УстановитьТолькоПросмотрДляРеквизитаНомер(Элементы.Номер.ТолькоПросмотр);
	
КонецПроцедуры

&НаСервере
Функция СформироватьГрафик()
	Возврат МодульОтчетов.СформироватьГрафикЗамеров(Объект.ДатаЗамера, ТаблицаДанных);
КонецФункции

&НаСервере
Функция ПроверитьСвободныйИнтервалЗамеров(ДатаЗамера, Сотрудник, ВремяНачала, ВремяОкончания)
	
	Возврат ОбщийМодуль.ПроверитьСвободныйИнтервалЗамеров(ДатаЗамера, Сотрудник, ВремяНачала, ВремяОкончания);
	
КонецФункции

&НаСервере
Функция ЗапланироватьЗамер(ИмяЯчейки)
	
	ВремяНачалаЗамеров = Константы.НачалоРабочегоВремениЗамеров.Получить();
	ВремяКонцаЗамеров = Константы.КонецРабочегоВремениЗамеров.Получить();
	КоличествоИНтервалов30минут = (Число(Формат(ВремяКонцаЗамеров,"ДФ=ЧЧ")) - Число(Формат(ВремяНачалаЗамеров,"ДФ=ЧЧ"))) * 2;
	
	//надо разобрать имя вида R99C99 на индекс колонки и индекс строки ТаблицыДанных
	НачалоР = Найти(ИмяЯчейки,"R");
	НачалоС = Найти(ИмяЯчейки,"C");
	ИндексКолонки = Сред(ИмяЯчейки,НачалоС+1,СтрДлина(ИмяЯчейки)-НачалоР-НачалоС+1)-1;
	ИндексСтроки = Сред(ИмяЯчейки,2,НачалоС-НачалоР-1)-6;
	
	Если ИндексКолонки < 0 или ИндексСтроки < 0 или ИндексКолонки>(КоличествоИНтервалов30минут+1) или ИндексСтроки > (ТаблицаДанных.Количество()-1) Тогда
		Возврат Ложь;
	КонецЕсли;
		
	ВыбранныйСотрудник = ТаблицаДанных[ИндексСтроки].Сотрудник;
	//ВыбранноеВремя = НачалоДня(Объект.ДатаЗамера);
	ВыбранноеВремя = ВремяНачалаЗамеров + (ИндексКолонки-1)*60*30;
	
	//определяем можно ли добавить замер определеной длины в выбраннй интервал
	ДлиназамераПоУмолчаниюВЧасах = Константы.КоличествоЧасовНеобходимыхНаЗамер.Получить();
	ВремяОкончанияЗамера = ВыбранноеВремя + (Дата(1,1,1,Цел(ДлиназамераПоУмолчаниюВЧасах),(ДлиназамераПоУмолчаниюВЧасах - Цел(ДлиназамераПоУмолчаниюВЧасах))*60,0)-Дата(1,1,1,0,0,0));
	ИнтервалСвободный = ПроверитьСвободныйИнтервалЗамеров(Объект.ДатаЗамера, ВыбранныйСотрудник, ВыбранноеВремя, ВремяОкончанияЗамера);
	Если НЕ ИнтервалСвободный Тогда
		Сообщить("В выбранное время замер добавить нельзя, т.к. периоды замеров пересекаются",СтатусСообщения.Важное);
		Возврат Ложь;
	Иначе
		Объект.Исполнитель = ВыбранныйСотрудник;
		Объект.ВремяНачалаЗамера = ВыбранноеВремя;
		Объект.ВремяОкончанияЗамера = ВремяОкончанияЗамера;
		Возврат Истина;
	КонецЕсли;
	
КонецФункции

&НаСервере
Функция ПолучитьСписокПоясненийРезультата()
	
	Результат = Новый СписокЗначений;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ПоясненияРезультатаЗамера.Ссылка
	|ИЗ
	|	Справочник.ПоясненияРезультатаЗамера КАК ПоясненияРезультатаЗамера
	|ГДЕ
	|	ПоясненияРезультатаЗамера.ПометкаУдаления = ЛОЖЬ";
	
	РезультатЗапроса = Запрос.Выполнить().Выбрать();
	Пока РезультатЗапроса.Следующий() Цикл
		Результат.Добавить(РезультатЗапроса.Ссылка);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

//ПРОЦЕДУРЫ И ФУНКЦИИ НА КЛИЕНТЕ
&НаКлиенте
Процедура ОбновитьФорму()
	
	Элементы.ДатаМонтажа.Доступность = НЕ (Объект.СрокМонтажа = ПредопределенноеЗначение("Перечисление.СрокиМонтажа.ДатаМонтажаНеОпределена"));
	Элементы.ВремяМонтажа.Доступность = НЕ (Объект.СрокМонтажа = ПредопределенноеЗначение("Перечисление.СрокиМонтажа.ДатаМонтажаНеОпределена"));
	Элементы.ДекорацияКонтактыОснования.Заголовок = "Контакты, указанные в основании: " + ПолучитьКонтактыОснования(Объект.Основание);
	//ВывестиГрафик();
	
	Если ПраваПользователей.РазрешеноИспользованиеСофтФона() Тогда
		Элементы.ПозвонитьПоНомеру.Видимость = Истина;
	Иначе
		Элементы.ПозвонитьПоНомеру.Видимость = Ложь;
	КонецЕсли;
	
	ПолучитьПервончальныеДанныеДляГрафикаЗамеров();
	ОбновитьГрафикЗамеровНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ОбновитьФорму();	
КонецПроцедуры

&НаКлиенте
Процедура ВывестиГрафик()
	График = СформироватьГрафик();
	ЭтаФорма.ОбновитьОтображениеДанных();
КонецПроцедуры

&НаКлиенте
Процедура ГрафикВыбор(Элемент, Область, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Массив = Элементы.График.ПолучитьВыделенныеОбласти();
	ЗапланироватьЗамер(Массив[0].Имя);
	
КонецПроцедуры

&НаКлиенте
Процедура ГруппаСтраницыДокументаПриСменеСтраницы(Элемент, ТекущаяСтраница)
	Если ТекущаяСтраница.Имя = "ГруппаГрафик" Тогда
		График = СформироватьГрафик();
		ЭтаФорма.ОбновитьОтображениеДанных();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	Если Объект.ВремяОкончанияЗамера < Объект.ВремяНачалаЗамера Тогда
		Сообщить("Время окончания замера меньше времени начала. Необходимо исправить.",СтатусСообщения.Важное);
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	Если (Секунда(Объект.ВремяОкончанияЗамера) = 0) или (Секунда(Объект.ВремяОкончанияЗамера) = 30) Тогда
		Объект.ВремяОкончанияЗамера = Объект.ВремяОкончанияЗамера - 1;
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ЗаключенДоговор(Команда)
	
	Отказ = Ложь;
	Если Объект.СуммаДокумента = 0 Тогда
		Сообщить("Не указана сумма договора!",СтатусСообщения.Важное);
		Отказ = Истина;
	КонецЕсли;
	Если НЕ Объект.СрокМонтажа = ПредопределенноеЗначение("Перечисление.СрокиМонтажа.ДатаМонтажаНеОпределена") Тогда
		Если Объект.ДатаМонтажа = Дата("00010101") или Объект.ВремяМонтажа = Дата("00010101") Тогда
			Сообщить("Не указана планируемые дата и время монтажа!",СтатусСообщения.Важное);
			Отказ = Истина;
		КонецЕсли;
	КонецЕсли;
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	Если МоджноЗаписатьДокумент() Тогда
		Попытка
			Объект.Результат = ПолучитьРезультатЗаключениеДоговора();
			Объект.ПояснениеРезультата = "";
			
			ПараметрыЗаписи = Новый Структура;
			ПараметрыЗаписи.Вставить("РежимЗаписи", РежимЗаписиДокумента.Проведение);
			ЭтаФорма.Записать(ПараметрыЗаписи);
			
			ЭтаФорма.Закрыть(Объект.Ссылка);
		Исключение
		КонецПопытки;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыборРезультатаОтказНаЗамере(ВыбранныйЭлемент, ДополнительныеПараметры) Экспорт 
	Попытка
		Объект.Результат = ПолучитьРезультатОтказНаЗамере();
		Объект.ПояснениеРезультата = ВыбранныйЭлемент.Значение;
		
		ПараметрыЗаписи = Новый Структура;
		ПараметрыЗаписи.Вставить("РежимЗаписи", РежимЗаписиДокумента.Проведение);
		ЭтаФорма.Записать(ПараметрыЗаписи);
		
		ЭтаФорма.Закрыть(Объект.Ссылка);
	Исключение
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура ВыборРезультатаОтказПоЗвонку(ВыбранныйЭлемент, ДополнительныеПараметры) Экспорт 
	Попытка
		Объект.Результат = ПолучитьРезультатОтказПоЗвонку();
		Объект.ПояснениеРезультата = ВыбранныйЭлемент.Значение;
		//зачищаем данные, чтобы освободить график
		Объект.Исполнитель = "";
		Объект.ДатаЗамера = "";
		Объект.ВремяНачалаЗамера = "";
		Объект.ВремяОкончанияЗамера = "";
		
		ПараметрыЗаписи = Новый Структура;
		ПараметрыЗаписи.Вставить("РежимЗаписи", РежимЗаписиДокумента.Проведение);
		ЭтаФорма.Записать(ПараметрыЗаписи);
		
		ЭтаФорма.Закрыть(Объект.Ссылка);
	Исключение
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура ОтказНаЗамере(Команда)
	
	Если МоджноЗаписатьДокумент() Тогда
		СписокВариантов = ПолучитьСписокПоясненийРезультата();
		
		Если СписокВариантов.Количество() = 0 Тогда
			ПоказатьПредупреждение(,"В настройках программы не заданы причины отказов на замере");
			Возврат;
		КонецЕсли;
			
		
		Оп = Новый ОписаниеОповещения("ВыборРезультатаОтказНаЗамере", ЭтаФорма);
		ПоказатьВыборИзМеню(Оп, СписокВариантов, Элементы.ОтказНаЗамере);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтказПоЗвонку(Команда)
	
	Если МоджноЗаписатьДокумент() Тогда
		СписокВариантов = ПолучитьСписокПоясненийРезультата();
		
		Оп = Новый ОписаниеОповещения("ВыборРезультатаОтказПоЗвонку", ЭтаФорма);
		ПоказатьВыборИзМеню(Оп, СписокВариантов, Элементы.ОтказПоЗвонку);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КонтрагентПриИзменении(Элемент)
	ОбновитьФорму();
КонецПроцедуры

&НаКлиенте
Процедура ДатаЗамераПриИзменении(Элемент)
	//ВывестиГрафик();
	ПолучитьПервончальныеДанныеДляГрафикаЗамеров();
	ОбновитьГрафикЗамеровНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ПрикрепитьФайл(Команда)
	
	Режим = РежимДиалогаВыбораФайла.Открытие;
	ДиалогОткрытияФайла = Новый ДиалогВыбораФайла(Режим);
	ДиалогОткрытияФайла.ПолноеИмяФайла = "";
	ДиалогОткрытияФайла.МножественныйВыбор = Истина;
	ДиалогОткрытияФайла.Заголовок = "Выберите файлы";
	Если ДиалогОткрытияФайла.Выбрать() Тогда
		МассивФайлов = ДиалогОткрытияФайла.ВыбранныеФайлы;
		Для Каждого ИмяФайла Из МассивФайлов Цикл
			ВыбФайл = Новый Файл(ИмяФайла);
			Если СохранитьПрикрепленныеДанные(Объект.Ссылка,ВыбФайл.ИмяБезРасширения,ВыбФайл.Расширение,Сериализовать(Новый ДвоичныеДанные(ИмяФайла))) Тогда
				Сообщить("Файлы успешно прикреплены");
			Иначе
				Сообщить("Не удалось прикрепить файлы!",СтатусСообщения.Важное);
			КонецЕсли;
		КонецЦикла;
	Иначе
		Предупреждение(НСтр("ru = 'Файл(ы) не выбран!'; en = 'File(s) not selected!'"));
	КонецЕсли;
	
	
КонецПроцедуры

&НаСервере
Функция ЕстьОформленныйЗаказДоговор()
	
	Результат = Ложь;
	
	ЕстьЗаказДоговор = Ложь;
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЗаключениеЗаказаДоговора.ОформленЗаказДоговор
	|ИЗ
	|	РегистрСведений.ЗаключениеЗаказаДоговора КАК ЗаключениеЗаказаДоговора
	|ГДЕ
	|	ЗаключениеЗаказаДоговора.Замер = &Замер";
	Запрос.УстановитьПараметр("Замер",Объект.Ссылка);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Выборка.ОформленЗаказДоговор Тогда
			ЕстьЗаказДоговор = Истина;
		КонецЕсли;
	КонецЦикла;
	Если ЕстьЗаказДоговор тогда
		Результат = Истина;
	Иначе
		Результат = Ложь;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ОформитьЗаказДоговор(Команда)
	
	Если Объект.СуммаДокумента = 0 Тогда
		ПоказатьПредупреждение(,"Не указана сумма договора!",,"Отказ");
		Возврат;
	КонецЕсли;
	
	Если НЕ Объект.Результат = ПредопределенноеЗначение("Справочник.РезультатыЗамера.ЗаключениеДоговора") Тогда
		ПоказатьПредупреждение(,"Замер предварительно должен быть переведен в статус ""Заключение договора""",,"Отказ");
		Возврат;
	КонецЕсли;
	
	Если ЕстьОформленныйЗаказДоговор() Тогда
		ПоказатьПредупреждение(,"По данному замеру уже оформлен заказ-договор",,"Отказ");
		Возврат;
	КонецЕсли;
	
	Если МоджноЗаписатьДокумент() Тогда
		Попытка
			Объект.Результат = ПолучитьРезультатЗаключениеДоговора();
			Объект.ПояснениеРезультата = "";
			
			ПараметрыЗаписи = Новый Структура;
			ПараметрыЗаписи.Вставить("РежимЗаписи", РежимЗаписиДокумента.Проведение);
			ЭтаФорма.Записать(ПараметрыЗаписи);
			
			ПараметрыНовогоДокумента = Новый Структура;
			ПараметрыНовогоДокумента.Вставить("ЗаполнениеНаОсновании", Истина);
			ПараметрыНовогоДокумента.Вставить("Основание", Объект.Ссылка);
			ПараметрыНовогоДокумента.Вставить("Адрес", Объект.Адрес);
			ПараметрыНовогоДокумента.Вставить("Сумма", Объект.СуммаДокумента);
			ПараметрыНовогоДокумента.Вставить("Исполнитель", Объект.Исполнитель);
			ПараметрыНовогоДокумента.Вставить("ИмяКлиента", Объект.ИмяКлиента);
			
			ОткрытьФорму("Документ.ЗаказДоговор.Форма.ФормаДокумента", ПараметрыНовогоДокумента);
			ЭтаФорма.Закрыть(Объект.Ссылка);
		Исключение
			ПоказатьПредупреждение(,ОписаниеОшибки(),,"Ошибка");
		КонецПопытки;
	КонецЕсли;
	
КонецПроцедуры


