&НаКлиенте
Процедура ГрафикЗамераПередСозданием(Элемент, Начало, Конец, Значения, Текст, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	
	НачалоРабочегоВремениЗамеров = НачалоРабочегоВремениЗамеров();
	КонецРабочегоВремениЗамеров = КонецРабочегоВремениЗамеров();
	Если Начало < Дата(Год(Объект.ДатаЗамера), Месяц(Объект.ДатаЗамера), День(Объект.ДатаЗамера), Час(НачалоРабочегоВремениЗамеров), Минута(НачалоРабочегоВремениЗамеров),0) 
		или Конец > Дата(Год(Объект.ДатаЗамера), Месяц(Объект.ДатаЗамера), День(Объект.ДатаЗамера), Час(КонецРабочегоВремениЗамеров), Минута(КонецРабочегоВремениЗамеров) ,0) Тогда
		Возврат;
	КонецЕсли;
	
	ДлинаМинимальногоЗамераВСекундах = КоличествоЧасовНеобходимыхНаЗамер()*60*60;
	Если Начало + ДлинаМинимальногоЗамераВСекундах > Конец Тогда
		Конец = Начало + ДлинаМинимальногоЗамераВСекундах;
	КонецЕсли;
	Конец = Конец - 1;
	
	//проверяем пересечения периодов
	Отказ = Ложь;
	Для Каждого СуществующаяЗапись Из ТаблицаГрафикЗамеров Цикл
		Если СуществующаяЗапись.Сотрудник = Значения.Получить("Сотрудник") Тогда
			Если НЕ СуществующаяЗапись.Новый Тогда
				Если Начало < СуществующаяЗапись.ВремяС и Конец > СуществующаяЗапись.ВремяС Тогда
					Отказ = Истина;
					Возврат;
				ИначеЕсли Начало > СуществующаяЗапись.ВремяС и Конец < СуществующаяЗапись.ВремяПо Тогда
					Отказ = Истина;
					Возврат;
				ИначеЕсли Начало < СуществующаяЗапись.ВремяПо и Конец > СуществующаяЗапись.ВремяПо Тогда
					Отказ = Истина;
					Возврат;
				ИначеЕсли Начало < СуществующаяЗапись.ВремяС и Конец > СуществующаяЗапись.ВремяПо Тогда
					Отказ = Истина;
					Возврат;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Если Отказ Тогда
		//ПоказатьПредупреждение(,"Время замера не должно пересекаться с другими заплнированными замерами");
	Иначе
		ДобавитьНовыйЗамер(Значения.Получить("Сотрудник"), Начало, Конец);
		ОбновитьГрафикЗамеровНаСервере();
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ДобавитьНовыйЗамер(Сотрудник, ВремяС, ВремяПо)
	
	КонецМинута = Минута(ВремяПо);
	КонецЧас = Час(ВремяПо);
	КонецСекунда = Секунда(ВремяПо);
	
	Объект.Исполнитель = Сотрудник;
	Объект.ВремяНачалаЗамера = Дата(1,1,1,Час(ВремяС), Минута(ВремяС), Секунда(ВремяС));
	Объект.ВремяОкончанияЗамера = Дата(1,1,1,КонецЧас, КонецМинута, КонецСекунда);
	
	ПолучитьПервончальныеДанныеДляГрафикаЗамеров();
	
КонецПроцедуры

