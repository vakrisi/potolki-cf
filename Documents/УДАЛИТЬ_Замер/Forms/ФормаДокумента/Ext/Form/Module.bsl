//ПРОЦЕДУРЫ И ФУНКЦИИ НА СЕРВЕРЕ БЕЗ КОНТЕКСТА
&НаСервереБезКонтекста
Функция Десериализовать(XMLОбъект)
	
	ЧтениеXMLДанных = Новый ЧтениеXML;
	ЧтениеXMLДанных.УстановитьСтроку(XMLОбъект);
	ПолученныйОбъект = СериализаторXDTO.ПрочитатьXML(ЧтениеXMLДанных);
	ЧтениеXMLДанных.Закрыть();
	Возврат ПолученныйОбъект;
	
КонецФункции

&НаСервереБезКонтекста
Функция Сериализовать(ОбъектСериализации)
	
	ДеревоВОбъектеXDTO = СериализаторXDTO.ЗаписатьXDTO(ОбъектСериализации);
	ЗаписьXMLДанных = Новый ЗаписьXML;
	ЗаписьXMLДанных.УстановитьСтроку();
	ФабрикаXDTO.ЗаписатьXML(ЗаписьXMLДанных,ДеревоВОбъектеXDTO);
	Возврат ЗаписьXMLДанных.Закрыть();
	
КонецФункции

