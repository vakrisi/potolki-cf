#Область ОтправкаСМСОЗамере

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	Если ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда 
		Если ИспользоватьОтправкуСМС() Тогда
			
			//СМС Клиенту
			Если ОтправлятьСМСКлиенту() Тогда 
				НомерТелефона = СокрЛП(Объект.СотовыйТелефонКлиента);		
				
				Если не ПустаяСтрока(НомерТелефона) Тогда
					//Проверяем отправлялась ли СМС клиенту
					Если СМСНеОтправлялось(Объект.ИмяКлиента) Тогда
						ТекстСМС = ПолучитьСМСКлиенту();
						ТекстСМС = СтрЗаменить(ТекстСМС, "%НомерТелефона", Объект.СотовыйТелефонКлиента);
						ТекстСМС = СтрЗаменить(ТекстСМС, "%Контрагент", Объект.ИмяКлиента);
						ТекстСМС = СтрЗаменить(ТекстСМС, "%Адрес", Объект.Адрес);
						ТекстСМС = СтрЗаменить(ТекстСМС, "%Время", Формат(Объект.ВремяНачалаЗамера,"ДФ=ЧЧ:мм"));
						ТекстСМС = СтрЗаменить(ТекстСМС, "%Дата", Формат(Объект.ДатаЗамера,"ДФ=дд ММММ"));
						ПоставитьСМСВОчередь(Объект.ИмяКлиента,НомерТелефона,ТекстСМС);
					Иначе 							
						Ответ = Вопрос("Отправить повторный СМС клиенту о замере?",РежимДиалогаВопрос.ДаНет);
						Если Ответ = КодВозвратаДиалога.Да Тогда
							ТекстСМС = ПолучитьСМСКлиенту();
							ТекстСМС = СтрЗаменить(ТекстСМС, "%НомерТелефона", Объект.СотовыйТелефонКлиента);
							ТекстСМС = СтрЗаменить(ТекстСМС, "%Контрагент", Объект.ИмяКлиента);
							ТекстСМС = СтрЗаменить(ТекстСМС, "%Адрес", Объект.Адрес);
							ТекстСМС = СтрЗаменить(ТекстСМС, "%Время", Формат(Объект.ВремяНачалаЗамера,"ДФ=ЧЧ:мм"));
							ТекстСМС = СтрЗаменить(ТекстСМС, "%Дата", Формат(Объект.ДатаЗамера,"ДФ=дд ММММ"));
							ПоставитьСМСВОчередь(Объект.ИмяКлиента,НомерТелефона,ТекстСМС);
						КонецЕсли;			
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
			
			//СМС Замерщику
			Если ОтправлятьСМСЗамерщику() Тогда 
				НомерТелефона = СокрЛП(ПолучитьТелефонСотрудника());		
								
				Если не ПустаяСтрока(НомерТелефона) Тогда
					//Проверяем отправлялась ли СМС замерщику
					Если СМСНеОтправлялось(Объект.Ответственный) Тогда
						ТекстСМС = ПолучитьСМСЗамерщику();
						ТекстСМС = СтрЗаменить(ТекстСМС, "%НомерТелефона", Объект.СотовыйТелефонКлиента);
						ТекстСМС = СтрЗаменить(ТекстСМС, "%Контрагент", Объект.ИмяКлиента);
						ТекстСМС = СтрЗаменить(ТекстСМС, "%Адрес", Объект.Адрес);
						ТекстСМС = СтрЗаменить(ТекстСМС, "%Время", Формат(Объект.ВремяНачалаЗамера,"ДФ=ЧЧ:мм"));
						ТекстСМС = СтрЗаменить(ТекстСМС, "%Дата", Формат(Объект.ДатаЗамера,"ДФ=дд ММММ"));
						ПоставитьСМСВОчередь(Объект.Ответственный,НомерТелефона,ТекстСМС);
					Иначе						
						Ответ = Вопрос("Отправить повторный СМС замерщику о замере?",РежимДиалогаВопрос.ДаНет);
						Если Ответ = КодВозвратаДиалога.Да Тогда
							ТекстСМС = ПолучитьСМСЗамерщику();
							ТекстСМС = СтрЗаменить(ТекстСМС, "%НомерТелефона", Объект.СотовыйТелефонКлиента);
							ТекстСМС = СтрЗаменить(ТекстСМС, "%Контрагент", Объект.ИмяКлиента);
							ТекстСМС = СтрЗаменить(ТекстСМС, "%Адрес", Объект.Адрес);
							ТекстСМС = СтрЗаменить(ТекстСМС, "%Время", Формат(Объект.ВремяНачалаЗамера,"ДФ=ЧЧ:мм"));
							ТекстСМС = СтрЗаменить(ТекстСМС, "%Дата", Формат(Объект.ДатаЗамера,"ДФ=дд ММММ"));
							ПоставитьСМСВОчередь(Объект.Ответственный,НомерТелефона,ТекстСМС);
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
			
			
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры


&НаСервере
Функция СМСНеОтправлялось(Контрагент)
	
	Запрос = новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	СМСОтправленные.Контрагент
	               |ИЗ
	               |	РегистрСведений.СМСОтправленные КАК СМСОтправленные
	               |ГДЕ
	               |	СМСОтправленные.Контрагент = &Контрагент
	               |	И СМСОтправленные.ДокументОснование = &Основание";
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Запрос.УстановитьПараметр("Основание", Объект.Ссылка);
	РезультатЗапроса = Запрос.Выполнить();
	Возврат РезультатЗапроса.Пустой();
	
