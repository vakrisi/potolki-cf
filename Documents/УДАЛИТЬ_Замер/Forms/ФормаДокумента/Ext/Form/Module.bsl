//РАБОТА С ГРАФИКОМ ЗАМЕРОВ
&НаСервере
Процедура ПолучитьПервончальныеДанныеДляГрафикаЗамеров()
	
	ТаблицаГрафикЗамеров.Очистить();
	
	ТекущийГод = Год(Объект.ДатаЗамера);
	ТекущийМесяц = Месяц(Объект.ДатаЗамера);
	ТекущееЧисло = День(Объект.ДатаЗамера);
	
	ТаблицаГрафикЗамеров.Очистить();
	
	ЗапросСотрудники = Новый Запрос;
	ЗапросСотрудники.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Сотрудники.Ссылка КАК Сотрудник
	|ИЗ
	|	Справочник.Сотрудники КАК Сотрудники
	|ГДЕ
	|	Сотрудники.ВыполняетЗамеры
	|	И НЕ Сотрудники.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	Сотрудники.Наименование";
	СписокСотрудников = ЗапросСотрудники.Выполнить().Выгрузить().ВыгрузитьКолонку("Сотрудник");
	
	Для НомерСотрудника = 0 По СписокСотрудников.Количество()-1 Цикл
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Замеры.Адрес,
		|	Замеры.ВремяНачала,
		|	Замеры.ВремяОкончания,
		|	Замеры.Регистратор
		|ИЗ
		|	РегистрСведений.Замеры КАК Замеры
		|ГДЕ
		|	Замеры.Дата = &Дата
		|	И Замеры.Сотрудник = &Сотрудник";
		Запрос.УстановитьПараметр("Дата",Объект.ДатаЗамера);
		Запрос.УстановитьПараметр("Сотрудник",СписокСотрудников[НомерСотрудника]);
		Выборка = Запрос.Выполнить().Выбрать();
		Если НЕ Выборка.Количество() = 0 Тогда
			Пока Выборка.Следующий() Цикл
				Если НЕ Выборка.Регистратор = Объект.Ссылка Тогда
					НоваяСтрока = ТаблицаГрафикЗамеров.Добавить();
					НоваяСтрока.Сотрудник = СписокСотрудников[НомерСотрудника];
					НоваяСтрока.ВремяС = Дата(ТекущийГод, ТекущийМесяц, ТекущееЧисло, Час(Выборка.ВремяНачала), Минута(Выборка.ВремяНачала), 0);
					НоваяСтрока.ВремяПо = Дата(ТекущийГод, ТекущийМесяц, ТекущееЧисло, Час(Выборка.ВремяОкончания), Минута(Выборка.ВремяОкончания), 0);
					НоваяСтрока.Адрес = Выборка.Адрес;
				Иначе
					НоваяСтрока = ТаблицаГрафикЗамеров.Добавить();
					НоваяСтрока.Сотрудник = СписокСотрудников[НомерСотрудника];
				КонецЕсли;
			КонецЦикла;
		Иначе
			НоваяСтрока = ТаблицаГрафикЗамеров.Добавить();
			НоваяСтрока.Сотрудник = СписокСотрудников[НомерСотрудника];
		КонецЕсли;
	КонецЦикла;
	
	
	//добавим замер текущего документа
	Если Объект.ВремяНачалаЗамера = Дата(1,1,1) и Объект.ВремяОкончанияЗамера = Дата(1,1,1) и Объект.Исполнитель.Пустая() Тогда
	Иначе
		НоваяСтрока = ТаблицаГрафикЗамеров.Добавить();
		НоваяСтрока.Сотрудник = Объект.Исполнитель;
		НоваяСтрока.ВремяС = Дата(ТекущийГод, ТекущийМесяц, ТекущееЧисло, Час(Объект.ВремяНачалаЗамера), Минута(Объект.ВремяНачалаЗамера), 0);
		НоваяСтрока.ВремяПо = Дата(ТекущийГод, ТекущийМесяц, ТекущееЧисло, Час(Объект.ВремяОкончанияЗамера), Минута(Объект.ВремяОкончанияЗамера), 0);
		НоваяСтрока.Адрес = Объект.Адрес;
		НоваяСтрока.Новый = Истина;
	КонецЕсли;
	
	ТаблицаГрафикЗамеров.Сортировать("Сотрудник Возр");
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьГрафикЗамеровНаСервере()
	
	ТекущийГод = Год(Объект.ДатаЗамера);
	ТекущийМесяц = Месяц(Объект.ДатаЗамера);
	ТекущееЧисло = День(Объект.ДатаЗамера);
	
	Для Каждого ТекущаяШкалаВремени Из ГрафикЗамеров.ШкалаВремени.Элементы Цикл
		КратностьГрафика = Константы.РазмерИнтервалаВГрафикеЗамеров.Получить();
		Если КратностьГрафика = 0 Тогда
			КратностьГрафика = 30;
		КонецЕсли;
		ТекущаяШкалаВремени.Кратность = КратностьГрафика;
	КонецЦикла;
	
	
	ГрафикЗамеров.ТекущиеПериодыОтображения.Очистить();
	
	//рисуем шкалу времени
	ВремяНачалаЗамеров = Константы.НачалоРабочегоВремениЗамеров.Получить();
	ВремяКонцаЗамеров = Константы.КонецРабочегоВремениЗамеров.Получить();
	НачальнаяДатаПланировщика = Дата(ТекущийГод, ТекущийМесяц, ТекущееЧисло, Час(ВремяНачалаЗамеров), Минута(ВремяНачалаЗамеров), 0);
	КонечнаяДатаПланировщика = Дата(ТекущийГод, ТекущийМесяц, ТекущееЧисло, Час(ВремяКонцаЗамеров), Минута(ВремяКонцаЗамеров), 0);
	
	ГрафикЗамеров.ТекущиеПериодыОтображения.Добавить(НачальнаяДатаПланировщика, КонечнаяДатаПланировщика);
	
	//добавляем замерщиков
	ГрафикЗамеров.Измерения.Очистить();
	Сотрудники = ГрафикЗамеров.Измерения.Добавить("Сотрудник");
	
	ТаблицаСотрудников = ТаблицаГрафикЗамеров.Выгрузить();
	ТаблицаСотрудников.Свернуть("Сотрудник");
	Для Каждого Выборка Из ТаблицаСотрудников Цикл
		НовыйСотрудник = Сотрудники.Элементы.Добавить(Выборка.Сотрудник);
    	НовыйСотрудник.Текст = Выборка.Сотрудник.Наименование;
	КонецЦикла;
	
	//отмечаем запланированные замеры
	ЭлементыГрафика = ГрафикЗамеров.Элементы;
    ЭлементыГрафика.Очистить();
	
	Для Каждого ТекущийЗамер Из ТаблицаГрафикЗамеров Цикл   
		
		// Связка записей с измерениями выполняется через соответствия
        СоответствиеЗначений = Новый Соответствие;
        СоответствиеЗначений.Вставить("Сотрудник",   ТекущийЗамер.Сотрудник);

        // Добавление новой записи в промежуток времени
        НовыйЭлемент = ЭлементыГрафика.Добавить(ТекущийЗамер.ВремяС, ТекущийЗамер.ВремяПо);
        НовыйЭлемент.ЗначенияИзмерений  = Новый ФиксированноеСоответствие(СоответствиеЗначений);
        НовыйЭлемент.Текст              = ТекущийЗамер.Адрес;
		Если НЕ ТекущийЗамер.Новый Тогда
			НовыйЭлемент.ЦветФона			= WebЦвета.Серый;
		Иначе
			НовыйЭлемент.ЦветФона			= WebЦвета.Зеленый;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

