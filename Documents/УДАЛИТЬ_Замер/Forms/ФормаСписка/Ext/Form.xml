			</Type>
			<MainAttribute>true</MainAttribute>
			<Settings xsi:type="DynamicList">
				<ManualQuery>true</ManualQuery>
				<DynamicDataRead>true</DynamicDataRead>
				<QueryText>ВЫБРАТЬ
	ДокументЗамер.Ссылка,
	ДокументЗамер.ПометкаУдаления,
	ДокументЗамер.Номер,
	ДокументЗамер.Дата,
	ДокументЗамер.Проведен,
	ДокументЗамер.Адрес,
	ДокументЗамер.ДатаЗамера,
	ДокументЗамер.ВремяНачалаЗамера,
	ДокументЗамер.ВремяОкончанияЗамера,
	ДокументЗамер.Исполнитель,
	ДокументЗамер.Результат,
	ДокументЗамер.СуммаДокумента,
	ДокументЗамер.Основание,
	ДокументЗамер.ПояснениеРезультата,
	ДокументЗамер.Комментарий,
	ДокументЗамер.ИмяКлиента,
	ДокументЗамер.МоментВремени,
	ВЫБОР
		КОГДА ЗаключениеЗаказаДоговора.ОформленЗаказДоговор = ИСТИНА
			ТОГДА 0
		ИНАЧЕ ВЫБОР
				КОГДА ДокументЗамер.Результат = ЗНАЧЕНИЕ(Справочник.РезультатыЗамера.ОтказНаЗамере)
						ИЛИ ДокументЗамер.Результат = ЗНАЧЕНИЕ(Справочник.РезультатыЗамера.ОтказПоЗвонку)
					ТОГДА 6
				ИНАЧЕ ВЫБОР
						КОГДА ДокументЗамер.Результат = ЗНАЧЕНИЕ(Справочник.РезультатыЗамера.ЗаключениеДоговора)
							ТОГДА 2
						ИНАЧЕ 4
					КОНЕЦ
			КОНЕЦ
	КОНЕЦ КАК НомерКартинкиСостояниеЗамера,
	ВЫБОР
		КОГДА ЗапланированМонтажСведения.ЗапланированМонтаж = ИСТИНА
			ТОГДА 0
		ИНАЧЕ ВЫБОР
				КОГДА ДокументЗамер.Результат = ЗНАЧЕНИЕ(Справочник.РезультатыЗамера.ОтказНаЗамере)
						ИЛИ ДокументЗамер.Результат = ЗНАЧЕНИЕ(Справочник.РезультатыЗамера.ОтказПоЗвонку)
					ТОГДА 6
				ИНАЧЕ 4
			КОНЕЦ
	КОНЕЦ КАК НомерКартинкиЗапланированМонтаж
ИЗ
	Документ.Замер КАК ДокументЗамер
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗаключениеЗаказаДоговора КАК ЗаключениеЗаказаДоговора
		ПО ДокументЗамер.Ссылка = ЗаключениеЗаказаДоговора.Замер
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УДАЛИТЬ_ОформлениеМонтажа КАК ЗапланированМонтажСведения
		ПО ДокументЗамер.Ссылка = ЗапланированМонтажСведения.Замер</QueryText>
				<MainTable>Document.УДАЛИТЬ_Замер</MainTable>
				<ListSettings>
					<dcsset:filter>
						<dcsset:viewMode>Normal</dcsset:viewMode>
						<dcsset:userSettingID>dfcece9d-5077-440b-b6b3-45a5cb4538eb</dcsset:userSettingID>
					</dcsset:filter>
					<dcsset:order>
						<dcsset:viewMode>Normal</dcsset:viewMode>
						<dcsset:userSettingID>88619765-ccb3-46c6-ac52-38e9c992ebd4</dcsset:userSettingID>
					</dcsset:order>
					<dcsset:conditionalAppearance>
						<dcsset:viewMode>Normal</dcsset:viewMode>
						<dcsset:userSettingID>b75fecce-942b-4aed-abc9-e6a02e460fb3</dcsset:userSettingID>
					</dcsset:conditionalAppearance>
					<dcsset:itemsViewMode>Normal</dcsset:itemsViewMode>
					<dcsset:itemsUserSettingID>911b6018-f537-43e8-a417-da56b22f9aec</dcsset:itemsUserSettingID>
				</ListSettings>
			</Settings>
		</Attribute>
