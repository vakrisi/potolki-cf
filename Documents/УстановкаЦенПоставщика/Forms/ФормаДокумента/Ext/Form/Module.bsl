Процедура ДатаПриИзмененииНаСервере()
	
	ФинансыСервер.ОбновитьВидимостьИКурсВалюты(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ВалютаПриИзменении(Элемент)
	ВалютаПриИзмененииНаСервере();
КонецПроцедуры

&НаСервере
Процедура ВалютаПриИзмененииНаСервере()
	
	ФинансыСервер.ОбновитьВидимостьИКурсВалюты(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура КонтрагентПриИзменении(Элемент)
	КонтрагентПриИзмененииНаСервере();
КонецПроцедуры

&НаСервере
Процедура КонтрагентПриИзмененииНаСервере()
	//Элементы.КонтрагентДополнительно.Видимость = Объект.Контрагент.ПоказыватьДопИнформацию;
	ОбщийМодульСервер.ДополнительнаяИнформацияПоКонтрагентуНаФорме(Объект.Контрагент, Элементы.ПоказатьДополнительнуюИнформацию);
	ОбщийМодульСервер.РегулировкаШириныПоляКонтрагента(Элементы, Элементы.Контрагент, Элементы.ПоказатьДополнительнуюИнформацию);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТабличнойЧасти

&НаКлиенте
Процедура ТоварыЕдиницаИзмеренияНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	СтрокаТабличнойЧасти = Элементы.Товары.ТекущиеДанные;
	СписокЕдиниц = ОбщийМодуль.ПолучитьСписокЕдиницИзмеренияНоменклатуры(СтрокаТабличнойЧасти.Номенклатура);
	
	ДанныеВыбора = Новый СписокЗначений;
	Для Ном = 0 По СписокЕдиниц.Количество() - 1 Цикл
		ДанныеВыбора.Добавить(СписокЕдиниц[Ном]);
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПоказатьДополнительнуюИнформацию(Команда)
	
	ОбщийМодульКлиент.ФормаДополнительнойИнформацииКонтрагента(Объект.Контрагент);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПоГруппе(Команда)
	
	ОткрытьФорму("Справочник.Номенклатура.ФормаВыбораГруппы",,ЭтаФорма,,,,
		Новый ОписаниеОповещения("ЗаполнитьПоГруппеПриЗавершенииВыбора",ЭтотОбъект));
		
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПоГруппеПриЗавершенииВыбора(Результат, ДопПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ЗаполнитьПоГруппеНоменклатурыНаСервере(Результат);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПоГруппеНоменклатурыНаСервере(ГруппаНоменклатуры)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СправочникНоменклатура.Ссылка КАК Номенклатура,
	|	ЕСТЬNULL(ХарактеристикиНоменклатуры.Ссылка, ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)) КАК ХарактеристикаНоменклатуры,
	|	СправочникНоменклатура.БазоваяЕдиницаИзмерения КАК ЕдиницаИзмерения
	|ИЗ
	|	Справочник.Номенклатура КАК СправочникНоменклатура
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ХарактеристикиНоменклатуры КАК ХарактеристикиНоменклатуры
	|		ПО (ХарактеристикиНоменклатуры.Владелец = СправочникНоменклатура.Ссылка)
	|ГДЕ
	|	СправочникНоменклатура.Ссылка В ИЕРАРХИИ(&ГруппаНоменклатуры)
	|	И НЕ СправочникНоменклатура.ЭтоГруппа";
	
	Запрос.УстановитьПараметр("ГруппаНоменклатуры",ГруппаНоменклатуры);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СтруктураОтбора = Новый Структура("Номенклатура, ХарактеристикаНоменклатуры");
		ЗаполнитьЗначенияСвойств(СтруктураОтбора, Выборка);
		Если Объект.Товары.НайтиСтроки(СтруктураОтбора).Количество() = 0 Тогда
			НоваяСтрока = Объект.Товары.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьЦеныПоВидуЦен(Команда)
	
	ОписаниеОповещенияВыбора = Новый ОписаниеОповещения("ПослеВыбораТипаЦен", ЭтаФорма);
	ПоказатьВводЗначения(ОписаниеОповещенияВыбора, ПредопределенноеЗначение("Справочник.ВидыЦен.ПустаяСсылка"),"Выберите вид цен");
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораТипаЦен(ВидЦен, Параметры) Экспорт
    Если НЕ ВидЦен = Неопределено Тогда
        УстановитьЦеныПоВидуЦенНаСервере(ВидЦен);
		ПоказатьПредупреждение(,"Цены изменены");
    КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура УстановитьЦеныПоВидуЦенНаСервере(ВидЦен)
	
	Для Каждого ТекущаяСтрока Из Объект.Товары Цикл
		ТекущаяСтрока.Цена = РегистрыСведений.ЦеныНоменклатуры.ПолучитьЦенуНоменклатурыВВалюте(?(Объект.Дата=Дата(1,1,1), ТекущаяДатаСеанса(), Объект.Дата), ВидЦен, ТекущаяСтрока.Номенклатура, Неопределено, ТекущаяСтрока.ЕдиницаИзмерения, Объект.Валюта);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьОбщуюЦену(Команда)
	
	ОписаниеОповещенияВопрос = Новый ОписаниеОповещения("ОтветУстановитьОбщуюЦену", ЭтаФорма);
	ПоказатьВопрос(ОписаниеОповещенияВопрос, "Установить общую цену на все позиции?", РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтветУстановитьОбщуюЦену(Результат, Параметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Нет Тогда
        Возврат;
    КонецЕсли;

	ОписаниеОповещенияВыборЦены = Новый ОписаниеОповещения("УстановитьЦенуПослеВыбора",ЭтаФорма);
	ПоказатьВводЗначения(ОписаниеОповещенияВыборЦены, 0, "Введите цену");

КонецПроцедуры

&НаКлиенте
Процедура УстановитьЦенуПослеВыбора(ВыбЗнач, Параметры) Экспорт
	
	Если НЕ ВыбЗнач = Неопределено Тогда
		
		Для Каждого ТекущаяСтрока Из Объект.Товары Цикл
			ТекущаяСтрока.Цена = ВыбЗнач;
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьИзExcel(Команда)

	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ИспользоватьСумму", Ложь);
	ПараметрыФормы.Вставить("ИспользоватьКоличество", Ложь);
	ПараметрыФормы.Вставить("ИспользоватьСтатьи", Ложь);
	
	ОткрытьФорму(
		"Обработка.ЗагрузкаНоменклатурыИзExcel.Форма.ЗагрузкаВТабличнуюЧасть",
		ПараметрыФормы,
		ЭтаФорма,
		УникальныйИдентификатор);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ПолучитьЗагруженныеТоварыИзХранилища(АдресТоваровВХранилище)
	
	ТаблицаНоменклатуры = ПолучитьИзВременногоХранилища(АдресТоваровВХранилище);	
	Для Каждого СтрокаНоменклатуры из ТаблицаНоменклатуры Цикл		
		
		СтруктураПоиска = Новый Структура("Номенклатура, ХарактеристикаНоменклатуры, ЕдиницаИзмерения");
		ЗаполнитьЗначенияСвойств(СтруктураПоиска, СтрокаНоменклатуры);
		НайденныеСтроки = Объект.Товары.НайтиСтроки(СтруктураПоиска);
		Если НайденныеСтроки.Количество() > 0 Тогда
			НайденныеСтроки[0].Цена = СтрокаНоменклатуры.Цена;
		Иначе
			НоваяСтрока = Объект.Товары.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаНоменклатуры);
		КонецЕсли;	
		
	КонецЦикла;
		
КонецПроцедуры

#КонецОбласти

