#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Ключ.Пустая() Тогда
	Иначе
		ЭтаФорма.ТолькоПросмотр = ПраваПользователей.ДокументТолькоПросмотр(Объект.Ссылка);
	КонецЕсли;
	
	УстановитьУсловноеОформление();
	
	ПраваПользователей.УстановитьТолькоПросмотрДляРеквизитаНомер(Элементы.Номер.ТолькоПросмотр);
	
	ЕстьИспользуемыеЦены = УстановкаЦенСервер.ЗаполнитьИспользуемыеВидыЦен(ЭтаФорма, Объект.ВидыЦен);
		
	//ОбновитьЭлементыФормы();
	
	УстановкаЦенСервер.ПостроитьТаблицуЦенФактур(ЭтаФорма, , Объект.Валюта);
	//УстановитьУсловноеОформление();
	ЗагрузитьТабличнуюЧасть();
	Если ЕстьИспользуемыеЦены Тогда
		Элементы.ГруппаВидыЦен.Видимость = Ложь;
		Элементы.ГруппаЦены.Видимость = Истина;	
	КонецЕсли;
	
	Элементы.ВидНоменклатуры.СписокВыбора.Очистить();
	Элементы.ВидНоменклатуры.СписокВыбора.Добавить(Справочники.ВидыНоменклатуры.Продукция); //#6265
	Элементы.ВидНоменклатуры.СписокВыбора.Добавить(Справочники.ВидыНоменклатуры.Отрез);
	Элементы.ВидНоменклатуры.СписокВыбора.Добавить(Справочники.ВидыНоменклатуры.Потолок);
	// №12232 Элементы.ВидНоменклатуры.СписокВыбора.Добавить(Справочники.ВидыНоменклатуры.ТиповойОтрез);
	
	УправлениеФормой();
	
	ФинансыСервер.ОбновитьВидимостьИКурсВалюты(ЭтотОбъект);
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	ДатыЗапретаИзменения.ОбъектПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	//#13646
	// для новых документов
	ПодключитьОбработчикОжидания("РазвернутьДеревоВидовЦен", 0.1, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	Если ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
		НомерСтроки = 0;
		Для каждого СтрокаТЗ из Цены Цикл
			НомерСтроки = НомерСтроки + 1;
			Если ЭтоПотолокОтрез И НЕ ЗначениеЗаполнено(СтрокаТЗ.Фактура) Тогда
				ТекстОшибки = НСтр("ru='Не заполнена колонка ""Фактура"" в строке ""%НомерСтроки%"" списка ""Таблица цен""'");
				ТекстОшибки = СтрЗаменить(ТекстОшибки, "%НомерСтроки%", НомерСтроки);
			
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
						ТекстОшибки,
						Объект.Ссылка,
						ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("Цены", НомерСтроки, "Фактура"),
						,
						Отказ);
			КонецЕсли;
			Если ЭтоПродукция И ЦеныНаПродукциюПоШаблону И НЕ ЗначениеЗаполнено(СтрокаТЗ.Шаблон) Тогда
				ТекстОшибки = НСтр("ru='Не заполнена колонка ""Шаблон"" в строке ""%НомерСтроки%"" списка ""Таблица цен""'");
				ТекстОшибки = СтрЗаменить(ТекстОшибки, "%НомерСтроки%", НомерСтроки);
			
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
						ТекстОшибки,
						Объект.Ссылка,
						ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("Цены", НомерСтроки, "Шаблон"),
						,
						Отказ);
			КонецЕсли;
			Если ЭтоПродукция И ЦеныНаПродукциюПоНоменклатуре И НЕ ЗначениеЗаполнено(СтрокаТЗ.Номенклатура) Тогда
				ТекстОшибки = НСтр("ru='Не заполнена колонка ""Номенклатура"" в строке ""%НомерСтроки%"" списка ""Таблица цен""'");
				ТекстОшибки = СтрЗаменить(ТекстОшибки, "%НомерСтроки%", НомерСтроки);
			
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
						ТекстОшибки,
						Объект.Ссылка,
						ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("Цены", НомерСтроки, "Номенклатура"),
						,
						Отказ);
			КонецЕсли;		
		КонецЦикла;
	КонецЕсли;	
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	ТекущийОбъект.ВидыЦен.Очистить();
	Для Каждого ТекущаяСтрока Из ВидыЦен Цикл
		Если ТекущаяСтрока.Устанавливать Тогда
			НоваяСтрока = ТекущийОбъект.ВидыЦен.Добавить();
			НоваяСтрока.ВидЦены = ТекущаяСтрока.ВидЦены;
		КонецЕсли;
	КонецЦикла;
	
	ТекущийОбъект.Материалы.Очистить();
	ПоместитьЦеныВТабличнуюЧасть(ТекущийОбъект.Материалы);

КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	
	Если ИсточникВыбора.ИмяФормы = "ОбщаяФорма.ФормаПодбораФактуры" Тогда	
		ОбработкаВыбораПодборНаКлиенте(ВыбранноеЗначение);
		
	ИначеЕсли ИсточникВыбора.ИмяФормы = "ОбщаяФорма.ФормаПодбораШаблоновПродукции" Тогда	
		ОбработкаВыбораПодборНаКлиенте(ВыбранноеЗначение);
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

