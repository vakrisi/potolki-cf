&НаКлиенте
Процедура ЗаполнитьТекущимиЦенами(Команда)
		
	Если Цены.Количество() = 0 Тогда
		Сообщить ("Таблица цен пустая");
		Возврат;
	КонецЕсли;
	
	ОписаниеОповещенияВопрос = Новый ОписаниеОповещения("ЗаполнитьТекущимиЦенамиЗавершение",ЭтаФорма);
	ПоказатьВопрос(ОписаниеОповещенияВопрос,"Очистить цены и заполнить текущими значениями?",РежимДиалогаВопрос.ДаНет);	
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьТекущимиЦенамиЗавершение(Результат, Параметры) Экспорт
	
    Если НЕ Результат = КодВозвратаДиалога.Да Тогда
        Возврат;
    КонецЕсли;

    ЗаполнитьТекущимиЦенамиНаСервере();

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТекущимиЦенамиНаСервере()
	
	ДатаЦены = Объект.Дата;
	Если ДатаЦены = Дата(1,1,1) Тогда
		ДатаЦены = ТекущаяДатаСеанса();
	КонецЕсли;
	
	ПоместитьЦеныВТабличнуюЧасть();
	
	ПараметрыПродукции = Новый Структура;
	ПараметрыПродукции.Вставить("ВидНоменклатуры", Объект.ВидНоменклатуры);
		
	Если НЕ ЭтоПродукция Тогда
		// по фактуре
		Для Каждого ТекущаяСтрока Из Объект.Материалы Цикл
			ПараметрыПродукции.Вставить("Фактура", ТекущаяСтрока.Фактура);
			ПараметрыПродукции.Вставить("ЦветФактуры", ТекущаяСтрока.ЦветФактуры);
			
			ПараметрыПродукции.Вставить("СФотопечатью", Ложь);
			ТекущаяСтрока.Цена = ЦеныКомпании.ПолучитьЦенуПродукцииВВалюте(ПараметрыПродукции, ДатаЦены, ТекущаяСтрока.ВидЦены, Объект.Валюта);

			ПараметрыПродукции.Вставить("СФотопечатью", Истина);			
			ТекущаяСтрока.Цена = ЦеныКомпании.ПолучитьЦенуПродукцииВВалюте(ПараметрыПродукции, ДатаЦены, ТекущаяСтрока.ВидЦены, Объект.Валюта);
		КонецЦикла;
	Иначе
		// по шаблону
		Для Каждого ТекущаяСтрока Из Объект.Материалы Цикл			
			ПараметрыПродукции.Вставить("Шаблон", ТекущаяСтрока.Шаблон);
			ТекущаяСтрока.Цена = ЦеныКомпании.ПолучитьЦенуПродукцииВВалюте(ПараметрыПродукции, ДатаЦены, ТекущаяСтрока.ВидЦены, Объект.Валюта);
		КонецЦикла;
	КонецЕсли;	
	
	ЗагрузитьТабличнуюЧасть();
	
КонецПроцедуры

