&НаКлиенте
Процедура ПоказатьФормуВыбораВидаЦен(ОписаниеОповещения)
	
	Если Цены.Количество() = 0 Тогда
		Сообщить ("Таблица цен пустая");
	Иначе
		СписокВидовЦен = Новый Массив;
		Для Каждого ТекущаяСтрока Из ВидыЦен Цикл
			Если ТекущаяСтрока.Устанавливать Тогда
				СписокВидовЦен.Добавить(ТекущаяСтрока.ВидЦены);
			КонецЕсли;
		КонецЦикла;
		
		ПараметрыФормы = Новый Структура;
		//ПараметрыФормы.Вставить("ВидыЦен", СписокВидовЦен);
		//
		//ОткрытьФорму("Документ.УстановкаЦенМатериалов.Форма.ФормаВыборВидаЦен", ПараметрыФормы, ЭтаФорма,,,,ОписаниеОповещения);
		
		ПараметрыФормы.Вставить("ИспользуемыеВидыЦен",	СписокВидовЦен);
		ПараметрыФормы.Вставить("ВыбранныеВидыЦен",		Новый Массив);
	
		ОткрытьФорму("Справочник.ВидыЦен.Форма.ФормаПодбора", ПараметрыФормы, ЭтотОбъект, , , , ОписаниеОповещения);

	КонецЕсли;
	
КонецПроцедуры

