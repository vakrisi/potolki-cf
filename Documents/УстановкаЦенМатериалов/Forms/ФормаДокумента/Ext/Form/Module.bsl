Процедура ДеревоВидовЦенПередУдалением(Элемент, Отказ)
	Отказ = Истина;
КонецПроцедуры

&НаКлиенте
Процедура ДеревоВидовЦенУстанавливатьПриИзменении(Элемент)
	
	//#13646
	ТекущиеДанные = Элементы.ДеревоВидовЦен.ТекущиеДанные;	
	УстановкаЦенКлиент.ДеревоВидовЦенУстанавливатьПриИзменении(ДеревоВидовЦен, ТекущиеДанные, ВидыЦен);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПерейтиКСпискуВидовЦен(Команда)
	
	Элементы.ГруппаВидыЦен.Видимость = Истина;
	Элементы.ГруппаЦены.Видимость = Ложь;
	
	//#13646
	ПодключитьОбработчикОжидания("РазвернутьДеревоВидовЦен", 0.1, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура РазвернутьДеревоВидовЦен()

	УстановкаЦенКлиент.РазвернутьДерево(Элементы, ДеревоВидовЦен, "ДеревоВидовЦен");
	
КонецПроцедуры

&НаКлиенте
Процедура ПереместитьВидЦены(Команда)
	
	Направление = ?(Команда.Имя = "ПереместитьВидЦеныВверх", -1, 1);
		
	РезультатПроверки = УстановкаЦенКлиент.ПроверитьДоступностьСдвигаВидаЦены(ДеревоВидовЦен, Элементы.ДеревоВидовЦен, ВидыЦен, Направление);
	ЦеныИзменены = Истина;
	
	ПодключитьОбработчикОжидания("ДеревоВидовЦенПриАктивизацииСтрокиОбработчикОжидания", 0.1, Истина);
	
КонецПроцедуры

