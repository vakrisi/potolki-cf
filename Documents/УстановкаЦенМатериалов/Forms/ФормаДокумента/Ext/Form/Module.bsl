//#14259
&НаКлиенте
Процедура РассчитатьЦены(Команда)
	
	Если Цены.Количество() = 0 Тогда 
		Сообщить("Таблица цен пустая, расчет цен не будет выполнен");
		Возврат;
	КонецЕсли;
	
	сз_ВидыЦен = Новый СписокЗначений;
	сз_ВсеВидыЦен = Новый СписокЗначений;
	сз_РазрешенныеВидыЦен = Новый СписокЗначений;	
	ЗаполнитьСпискиВидовЦен(сз_ВидыЦен, сз_ВсеВидыЦен, сз_РазрешенныеВидыЦен);
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("УстановкаЦенНаПродукцию",	Истина);
	ПараметрыФормы.Вставить("ВсеВидыЦен",			сз_ВсеВидыЦен);
	ПараметрыФормы.Вставить("ИспользуемыеВидыЦен",	сз_ВидыЦен);
	ПараметрыФормы.Вставить("РазрешенныеВидыЦен",	сз_РазрешенныеВидыЦен);
	 
	ОписаниеОповещения = Новый ОписаниеОповещения("РассчитатьЦеныФрагмент", ЭтотОбъект);
	ОткрытьФорму("Документ.УстановкаЦенНоменклатуры.Форма.ФормаРасчетаЦен", ПараметрыФормы, ЭтаФорма, , , , ОписаниеОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьЦеныФрагмент(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ Результат.КонечныйВидЦен = Неопределено
		И НЕ Результат.ПроцентНаценки = Неопределено Тогда
		ОписаниеОповещения = Новый ОписаниеОповещения("РассчитатьЦеныЗавершение", ЭтотОбъект, Результат); 
		ТекстВопроса = "Виды цен """ + СтрСоединить(Результат.КонечныйВидЦен, ", ") + """ будут перерассчитаны. Продолжить?";
		ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьЦеныЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		Модифицированность = Истина;
		РассчитатьЦеныНаСервере(ДополнительныеПараметры);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура РассчитатьЦеныНаСервере(ПараметрыРасчета)
	
	ВидИсходныхДанных = ПараметрыРасчета.ВидИсходныхДанных;
	ИсходныйВидЦен = ПараметрыРасчета.ИсходныйВидЦен; 
	ИсходныйВидЦенДокумента = ПараметрыРасчета.ИсходныйВидЦенДокумента; 
	МассивКонечныхВидовЦен = ПараметрыРасчета.КонечныйВидЦен;
	ПроцентНаценки = ПараметрыРасчета.ПроцентНаценки;	
	
	Если ЗначениеЗаполнено(ИсходныйВидЦен) Тогда
		ИмяКолонкиИсточник = УстановкаЦенСервер.ИмяКолонкиПоВидуЦены(ИсходныйВидЦен);
		ИмяКолонкиИсточникФ = ИмяКолонкиИсточник + "Фото";
		
	ИначеЕсли ЗначениеЗаполнено(ИсходныйВидЦенДокумента) Тогда
		ИмяКолонкиИсточник = УстановкаЦенСервер.ИмяКолонкиПоВидуЦены(ИсходныйВидЦенДокумента);
		ИмяКолонкиИсточникФ = ИмяКолонкиИсточник + "Фото";
	КонецЕсли;
	
	Для каждого КонечныйВидЦен из МассивКонечныхВидовЦен Цикл
		
		ИмяКолонкиПриемник = УстановкаЦенСервер.ИмяКолонкиПоВидуЦены(КонечныйВидЦен);
		ИмяКолонкиПриемникФ = ИмяКолонкиПриемник + "Фото";
			
		Если ВидИсходныхДанных = 3 Тогда
			//наценка на указанный вид цен документа
						
			Для Каждого ТекСтрока Из Цены Цикл
				ТекСтрока[ИмяКолонкиПриемник] = ТекСтрока[ИмяКолонкиИсточник] * (1 + ПроцентНаценки/100);
				Если ЭтоПотолокОтрез Тогда
					ТекСтрока[ИмяКолонкиПриемникФ] = ТекСтрока[ИмяКолонкиИсточникФ] * (1 + ПроцентНаценки/100);
				КонецЕсли;
			КонецЦикла;
			
		ИначеЕсли ВидИсходныхДанных = 4 Тогда
			//наценка на указанный вид цен		
			
			Запрос = Новый Запрос;
			Запрос.УстановитьПараметр("ДатаЗапроса",?(Объект.Дата = Дата(1,1,1),ТекущаяДатаСеанса(),Объект.Дата));
			Запрос.УстановитьПараметр("ВидЦены", ИсходныйВидЦен);
			Запрос.УстановитьПараметр("Валюта", Объект.Валюта);
			Запрос.УстановитьПараметр("ВидНоменклатуры", Объект.ВидНоменклатуры);
			Запрос.УстановитьПараметр("ТаблицаДокумента", Цены.Выгрузить());
			Запрос.Текст =
			"ВЫБРАТЬ
			|	ТаблицаДокумента.Фактура КАК Фактура,
			|	ТаблицаДокумента.ЦветФактуры КАК ЦветФактуры,
			|	ТаблицаДокумента.Шаблон КАК Шаблон
			|ПОМЕСТИТЬ ВТ_Позиции
			|ИЗ
			|	&ТаблицаДокумента КАК ТаблицаДокумента
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ЦеныСрезПоследних.Валюта КАК Валюта,
			|	ЦеныСрезПоследних.ВидЦен КАК ВидЦены,
			|	ЦеныСрезПоследних.Фактура КАК Фактура,
			|	ЦеныСрезПоследних.ЦветФактуры КАК ЦветФактуры,
			|	ЦеныСрезПоследних.Шаблон КАК Шаблон,
			|	ЦеныСрезПоследних.Цена КАК Цена,
			|	ЦеныСрезПоследних.ЦенаСФотопечатью КАК ЦенаСФотопечатью
			|ИЗ
			|	РегистрСведений.ЦеныМатериалов.СрезПоследних(
			|			&ДатаЗапроса,
			|			ВидЦен = &ВидЦены
			|				И Валюта = &Валюта
			|				И ВидНоменклатуры = &ВидНоменклатуры
			|				И (Фактура, ЦветФактуры, Шаблон) В
			|					(ВЫБРАТЬ
			|						ВТ_Позиции.Фактура,
			|						ВТ_Позиции.ЦветФактуры,
			|						ВТ_Позиции.Шаблон
			|					ИЗ
			|						ВТ_Позиции)) КАК ЦеныСрезПоследних";
			ТаблицаИсходныхЦен = Запрос.Выполнить().Выгрузить();
			
			Для Каждого ТекСтрока Из Цены Цикл
				
				ОтборИсходные = Новый Структура;
				ОтборИсходные.Вставить("Фактура", ТекСтрока.Фактура);
				ОтборИсходные.Вставить("ЦветФактуры", ТекСтрока.ЦветФактуры);
				ОтборИсходные.Вставить("Шаблон", ТекСтрока.Шаблон);
				ТоварыИсходные = ТаблицаИсходныхЦен.НайтиСтроки(ОтборИсходные);
				
				Если ТоварыИсходные.Количество() > 0 Тогда	
					ТекСтрока[ИмяКолонкиПриемник]  = ТоварыИсходные[0].Цена * (1 + ПроцентНаценки/100);
					Если ЭтоПотолокОтрез Тогда
						ТекСтрока[ИмяКолонкиПриемникФ] = ТоварыИсходные[0].ЦенаСФотопечатью * (1 + ПроцентНаценки/100);
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
			
		КонецЕсли;
	КонецЦикла;
		
КонецПроцедуры

#КонецОбласти

#Область СлужебныеФункцииПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	УсловноеОформление.Элементы.Очистить();
	
	УстановкаЦенСервер.УстановитьУсловноеОформление(УсловноеОформление.Элементы);
	
КонецПроцедуры

&НаСервере
Процедура ПереформироватьТаблицуЦен()
	
	ПоместитьЦеныВТабличнуюЧасть();
	УстановкаЦенСервер.ПостроитьТаблицуЦенФактур(ЭтаФорма, , Объект.Валюта);
	ЗагрузитьТабличнуюЧасть();
	
	УправлениеФормой();
	
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьТабличнуюЧасть()
	
	ТаблицаМатериалов = Объект.Материалы.Выгрузить();	
	
	Для Каждого ТекМатериал Из ТаблицаМатериалов Цикл
		
		Отбор = Новый Структура("Фактура, ЦветФактуры, Шаблон, ПараметрПродукции", ТекМатериал.Фактура, ТекМатериал.ЦветФактуры, ТекМатериал.Шаблон, ТекМатериал.ПараметрПродукции);	
		МассивСтрок = Цены.НайтиСтроки(Отбор);
		Если МассивСтрок.Количество() > 0 Тогда
			НайденнаяСтрока = МассивСтрок[0];			
		Иначе
			НайденнаяСтрока = Цены.Добавить();
			ЗаполнитьЗначенияСвойств(НайденнаяСтрока, ТекМатериал, "Фактура, ЦветФактуры, Шаблон, ПараметрПродукции");
		КонецЕсли;	
		
		Если Не ЗначениеЗаполнено(ТекМатериал.ВидЦены) Тогда
			Продолжить;
		КонецЕсли;
		
		ИмяКолонки = УстановкаЦенСервер.ИмяКолонкиПоВидуЦены(ТекМатериал.ВидЦены);		
		НайденнаяСтрока[ИмяКолонки] = ТекМатериал.Цена;
		НайденнаяСтрока[ИмяКолонки+"Фото"] = ТекМатериал.ЦенаСФотопечатью;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ПоместитьЦеныВТабличнуюЧасть(ТабличнаяЧасть=Неопределено)
	
	Если ТабличнаяЧасть=Неопределено Тогда
		ТабличнаяЧасть = Объект.Материалы;
	КонецЕсли;	
	ТабличнаяЧасть.Очистить();	
	
	Для Каждого СтрокаЦен Из Цены Цикл
				
		Для Каждого ВидЦены Из ВидыЦен Цикл			
			Если ВидЦены.Устанавливать Тогда				
				ИмяКолонки = УстановкаЦенСервер.ИмяКолонкиПоВидуЦены(ВидЦены.ВидЦены);
				ЕстьКолонкаЦены = СтрокаЦен.Свойство(ИмяКолонки);
				Если ЕстьКолонкаЦены Тогда
					Цена = СтрокаЦен[ИмяКолонки];
					ЦенаСФото = СтрокаЦен[ИмяКолонки+"Фото"];
				КонецЕсли;			
				
				НоваяСтрока = ТабличнаяЧасть.Добавить();
				НоваяСтрока.Фактура = СтрокаЦен.Фактура;
				НоваяСтрока.ЦветФактуры = СтрокаЦен.ЦветФактуры;
				НоваяСтрока.Шаблон = СтрокаЦен.Шаблон;
				НоваяСтрока.ПараметрПродукции = СтрокаЦен.ПараметрПродукции;
				НоваяСтрока.Номенклатура = СтрокаЦен.Номенклатура;
				НоваяСтрока.ЕдиницаИзмерения = СтрокаЦен.ЕдиницаИзмерения;
				НоваяСтрока.ВидЦены = ВидЦены.ВидЦены;			
				
				Если ЕстьКолонкаЦены Тогда
					НоваяСтрока.Цена = Цена;								
					НоваяСтрока.ЦенаСФотопечатью = ЦенаСФото;
				КонецЕсли;		
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;		
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьЭлементыФормы()
	
	Элементы.МатериалыЦена.Заголовок = "Цена, " + Объект.Валюта;
	
КонецПроцедуры

&НаСервере
Процедура УправлениеФормой() 
	
	ЭтоПродукция = Ложь;
	Если Объект.ВидНоменклатуры = ПредопределенноеЗначение("Справочник.ВидыНоменклатуры.Продукция") Тогда
		ЭтоПродукция = Истина;
		ВидПродукцииЗаполнен = ЗначениеЗаполнено(Объект.ВидПродукции);
	КонецЕсли;
	
	ЦеныНаПродукциюПоШаблону    = Объект.СпособОпределенияСтоимости = Перечисления.СпособыОпределенияСтоимостиПродукции.ПоШаблону;
	ЦеныНаПродукциюПоПараметрам = Объект.СпособОпределенияСтоимости = Перечисления.СпособыОпределенияСтоимостиПродукции.ПоПараметрам;
	ЦеныНаПродукциюПоНоменклатуре = Объект.СпособОпределенияСтоимости = Перечисления.СпособыОпределенияСтоимостиПродукции.ПоНоменклатуре;
	
	ЭтоПотолокОтрез = (Объект.ВидНоменклатуры = ПредопределенноеЗначение("Справочник.ВидыНоменклатуры.Потолок")
				       ИЛИ Объект.ВидНоменклатуры = ПредопределенноеЗначение("Справочник.ВидыНоменклатуры.Отрез"));
				  
	Элементы.ЦеныГруппаФактура.Видимость = ЭтоПотолокОтрез;
	Элементы.ЦеныГруппаЦвет.Видимость    = ЭтоПотолокОтрез;
	Элементы.ЦеныГруппаШаблон.Видимость  = ЭтоПродукция И ВидПродукцииЗаполнен И ЦеныНаПродукциюПоШаблону;
	Элементы.ЦеныГруппаПараметры.Видимость = ЭтоПродукция И ВидПродукцииЗаполнен И ЦеныНаПродукциюПоПараметрам;
	Элементы.ГруппаПараметрыПродукции.Видимость = ЭтоПродукция;
	
	Элементы.ГруппаКомандПотолки.Видимость   = ЭтоПотолокОтрез;
	Элементы.ГруппаКомандПоШаблонам.Видимость = ЭтоПродукция И ЦеныНаПродукциюПоШаблону;
	
	Элементы.ЦеныГруппаНоменклатура.Видимость = ЭтоПродукция И ВидПродукцииЗаполнен И ЦеныНаПродукциюПоНоменклатуре;
	
	//#12615	
	Элементы.ЦенаСФотопечатьюОтличается.Видимость = ЭтоПотолокОтрез;
	
	Для каждого ГруппаКолонокЦен из Элементы.Цены.ПодчиненныеЭлементы Цикл
		Если Лев(ГруппаКолонокЦен.Имя, 17) = "ГруппаЦеныВидЦены" Тогда
			Для каждого КолонкаЦена из ГруппаКолонокЦен.ПодчиненныеЭлементы Цикл
				Если Прав(КолонкаЦена.Имя, 4) = "Фото" Тогда
					КолонкаЦена.Видимость = ЭтоПотолокОтрез И Объект.ЦенаСФотопечатьюОтличается;
				Иначе
					КолонкаЦена.Заголовок = ?(ЭтоПотолокОтрез, "Цена за кв.м.", "Цена");
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Функция ЗаполнитьСпискиВидовЦен(сз_ВидыЦен, сз_ВсеВидыЦен, сз_РазрешенныеВидыЦен)
	
	Для каждого Строка Из ВидыЦен Цикл
		сз_ВсеВидыЦен.Добавить(Строка.ВидЦены);
		Если Строка.Устанавливать тогда
			сз_видыЦен.Добавить(Строка.ВидЦены);
		КонецЕсли;
		
		Если НЕ Строка.Запрещенный И Строка.Устанавливать Тогда
			сз_РазрешенныеВидыЦен.Добавить(Строка.ВидЦены);
		КонецЕсли;
	КонецЦикла;
	
	Возврат сз_ВидыЦен;
	
КонецФункции

#КонецОбласти
