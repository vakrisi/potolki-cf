		Основание 	= ДанныеЗаполнения;
		
	//-- №8498
	КонецЕсли;
	
	Если СуммаДокумента > 0 И ЗначениеЗаполнено(Организация) Тогда
		УчитыватьНДС = УчетНДС.ОрганизацияЯвляетсяПлательщикомНДС(Организация);
		СтавкаНДС = УчетНДС.СтавкаНДСПоУмолчанию(Организация);
		СуммаНДС = УчетНДС.РассчитатьСуммуНДС(СуммаДокумента,
	                                          УчитыватьНДС, ,
	                                          УчетНДС.ПолучитьСтавкуНДС(СтавкаНДС));
	КонецЕсли;								

	ФинансыСервер.ДокументРасходаОбработкаЗаполнения(ЭтотОбъект, ДанныеЗаполнения);
	
	Если ВидОперацииРКО.Пустая() Тогда
		ВидОперацииРКО = Перечисления.ВидыОперацийРасходныйКассовыйОрдер.ОплатаПоставщику;
	КонецЕсли;
	
	Если ВидОперацииСРС.Пустая() Тогда
		ВидОперацииСРС = Перечисления.ВидыОперацийСписаниеСРасчетногоСчета.ОплатаПоставщику;
	КонецЕсли;
	
	Если ТипДенежныхСредств = Перечисления.ТипыДенежныхСредств.Наличные Тогда
		СтатьяРасходов = ФинансыСервер.ПолучитьСтатьюДоходовРасходов(ЭтотОбъект, ВидОперацииРКО, Ложь);
		СтатьяРасходовПоНачислению = СтатьяРасходов; //#9708
	Иначе
		СтатьяРасходов = ФинансыСервер.ПолучитьСтатьюДоходовРасходов(ЭтотОбъект, ВидОперацииСРС, Ложь);
		СтатьяРасходовПоНачислению = СтатьяРасходов; //#9708
	КонецЕсли;
	
	Если ЭтоНовый() Тогда
		ДозаполнитьПоУмолчанию();
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	
	ИнициализироватьСлужебныеРеквизиты();
	
	Автор = Пользователи.ТекущийПользователь();
	СтатусУтвержденияПлатежа = Перечисления.СтатусыУтвержденияПлатежей.НеУтвержден;
	ЖелательнаяДатаПлатежа = Дата(1, 1, 1);
	Основание = Неопределено;
	
	ДозаполнитьПоУмолчанию();
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	ПолеСтатьяДДСОбязательно = Константы.ОбязательноеЗаполнениеСтатьиВДенежныхДокументах.Получить();	
	Если НЕ ЗначениеЗаполнено(Статья) И ПолеСтатьяДДСОбязательно Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
         	НСтр("ru = 'Не заполнена статья движения денежных средств!'"), ЭтотОбъект,
        	"Статья",,Отказ);
	КонецЕсли;
		
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Если СтатусУтвержденияПлатежа = Перечисления.СтатусыУтвержденияПлатежей.Утвержден Тогда
		Если Ссылка.СтатусУтвержденияПлатежа <> СтатусУтвержденияПлатежа Тогда 
			ОтветственныйУтвердил = Пользователи.ТекущийПользователь();
		КонецЕсли;
	Иначе
		ОтветственныйУтвердил = Справочники.Пользователи.ПустаяСсылка();
	КонецЕсли;
	
	КассовыйДокумент = (ТипДенежныхСредств = Перечисления.ТипыДенежныхСредств.Наличные);
	ВидОперации = ?(КассовыйДокумент, ВидОперацииРКО, ВидОперацииСРС);
	ФинансыСервер.ДокументРасходаПередЗаписью(ЭтотОбъект, КассовыйДокумент, ВидОперации, Отказ, РежимЗаписи, РежимПроведения);
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)

	// регистр ДенежныеСредстваКВыплате Приход
	Движения.ДенежныеСредстваКВыплате.Записывать = Истина;
	Движение = Движения.ДенежныеСредстваКВыплате.Добавить();
	Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
	Движение.Период = Дата;
	Движение.Заявка = Ссылка;
	Движение.Сумма  = СуммаДокумента;

КонецПроцедуры

