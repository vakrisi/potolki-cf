		ВалютаДокумента = ДанныеЗаполнения.Валюта;
		
		НоваяСтрока = РаспределениеПлатежа.Добавить();
		НоваяСтрока.Документ = ДанныеЗаполнения.Ссылка;
		НоваяСтрока.Сумма = СуммаДокумента;
		
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.НачислениеЗарплаты") Тогда
		ТипДенежныхСредств = Перечисления.ТипыДенежныхСредств.Наличные;
		//Комментарий = ДанныеЗаполнения.Комментарий; //#5849
		СуммаДокумента = ДанныеЗаполнения.Начисление.Итог("Сумма");
		Организация = ДанныеЗаполнения.Организация;
		Основание = ДанныеЗаполнения.Ссылка;
		ВидОперацииРКО = Перечисления.ВидыОперацийРасходныйКассовыйОрдер.ЗарплатаСотрудникам;
		ВидОперацииСРС = Перечисления.ВидыОперацийСписаниеСРасчетногоСчета.ЗарплатаСотрудникам;
		ПериодРегистрации = ДанныеЗаполнения.ПериодРегистрации;
