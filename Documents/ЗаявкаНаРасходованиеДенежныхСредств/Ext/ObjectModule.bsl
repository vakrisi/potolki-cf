			НоваяСтрока = ЗарплатаСотрудникам.Добавить();
			НоваяСтрока.Сотрудник = ТекСтрокаНачисление.Сотрудник;
			//НоваяСтрока.УДАЛИТЬ_ВидНачисления = ТекСтрокаНачисление.ВидНачисления; //#6576
			НоваяСтрока.Сумма = ТекСтрокаНачисление.Сумма;
			НоваяСтрока.СчетСотрудника = ФинансыСервер.ПолучитьСчетСотрудника(ТекСтрокаНачисление.Сотрудник);
		КонецЦикла;
		
