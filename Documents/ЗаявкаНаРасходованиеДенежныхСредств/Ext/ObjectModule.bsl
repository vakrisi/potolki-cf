		Организация = ДанныеЗаполнения.Организация;
		Контрагент = ДанныеЗаполнения.Экспедитор;
		Договор = ДанныеЗаполнения.Экспедитор.ОсновнойДоговор;
		СуммаДокумента = ДанныеЗаполнения.СтоимостьДоставки;
		ВалютаДокумента = ДанныеЗаполнения.Валюта;
		
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ВозвратТовараОтПокупателя") Тогда
		ТипДенежныхСредств = Перечисления.ТипыДенежныхСредств.Наличные;
