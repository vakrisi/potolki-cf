
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ОтображениеПериодаРегистрации = Формат(Объект.ПериодРегистрации, "ДФ='MMMM yyyy'");
	ОтображатьПериодРегистрации = Константы.ОтражатьДвиженияПоРасчетуСПерсоналомПоПериодуРегистрации.Получить();
	
	Если Параметры.Ключ.Пустая() Тогда		
		
	Иначе
		ЭтаФорма.ТолькоПросмотр = ПраваПользователей.ДокументТолькоПросмотр(Объект.Ссылка);
	КонецЕсли;
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
		
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		ПриЧтенииСозданииНаСервере();
	КонецЕсли;
	
	Элементы.ПодменюПечать.Доступность = ПраваПользователей.ДоступностьПечати(Объект.Ссылка);
	ПраваПользователей.УстановитьТолькоПросмотрДляРеквизитаНомер(Элементы.Номер.ТолькоПросмотр);
	Элементы.Статья.АвтоОтметкаНезаполненного = Константы.ОбязательноеЗаполнениеСтатьиВДенежныхДокументах.Получить();
	
	Если ТипЗнч(Объект.Контрагент) = Тип("СправочникСсылка.Контрагенты") Тогда
		//Элементы.КонтрагентДополнительно.Видимость = Объект.Контрагент.ПоказыватьДопИнформацию;
		//КонтрагентДополнительно = Объект.Контрагент.Дополнительно;
		ОбщийМодульСервер.ДополнительнаяИнформацияПоКонтрагентуНаФорме(Объект.Контрагент, Элементы.ПоказатьДополнительнуюИнформацию);
	Иначе
		//Элементы.КонтрагентДополнительно.Видимость = Ложь;
		Элементы.ПоказатьДополнительнуюИнформацию.Видимость = Ложь;
	КонецЕсли;
	ОбщийМодульСервер.РегулировкаШириныПоляКонтрагента(Элементы, Элементы.Контрагент, Элементы.ПоказатьДополнительнуюИнформацию);
	
	ОбщийМодульСервер.УстановитьВидимостьПодразделения(ЭтотОбъект);
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	ДатыЗапретаИзменения.ОбъектПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	ПриЧтенииСозданииНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииСозданииНаСервере()
	
	СостояниеОплачено = Объект.Проведен И РегистрыНакопления.ДенежныеСредстваКВыплате.ОпределитьСостояниеОплаты(Объект.Ссылка);
	ПравоУтверждения = РольДоступна("УтверждениеЗаявокНаРасходованиеДенежныхСредств")
					   ИЛИ РольДоступна("ПолныеПрава")
					   ИЛИ РольДоступна("АдминистраторСистемы");
	УстановитьСписокСтатусов();
	УстановитьДоступностьЭлементовПоСтатусу();	
	УстановитьВидимостьЭлементовПоТипуДС();
	УстановитьВидимостьЭлементовПоВидуРКО();
	УстановитьВидимостьЭлементовПоВидуСРС();
	УстановитьВидимостьЭлементовПоНДС();
	
	УправлениеПоказателямиПлатежаВБюджет();
	
	ФинансыСервер.ЗаполнитьСписокКодовВидаДохода(Элементы.КодВидаДохода, Объект.ВидОперацииСРС);
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	Если Объект.РаспределениеПлатежа.Количество() > 0 Тогда
		Если Объект.РаспределениеПлатежа.Итог("Сумма") > Объект.СуммаДокумента Тогда
			ТекстОшибки = "Сумма распределения превышает сумму документа";
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки, ТекущийОбъект, "РаспределениеПлатежа", , Отказ);
			Возврат;
		КонецЕсли;
	КонецЕсли;	
	
	Если Объект.ТипДенежныхСредств = Перечисления.ТипыДенежныхСредств.Наличные Тогда
		Если НЕ ЗначениеЗаполнено(Объект.Контрагент) 
			И Объект.ВидОперацииРКО = Перечисления.ВидыОперацийРасходныйКассовыйОрдер.ВыдачаПодотчетнику Тогда
			ТекстОшибки = "Не заполнен сотрудник (подотчетное лицо)";
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки, ТекущийОбъект, "Контрагент", , Отказ);
			Возврат;
		КонецЕсли;
			
		Если Объект.ВидОперацииРКО <> Перечисления.ВидыОперацийРасходныйКассовыйОрдер.ОплатаПоставщику 
			И Объект.РаспределениеПлатежа.Количество() > 0 Тогда
			Объект.РаспределениеПлатежа.Очистить();
		КонецЕсли;
	КонецЕсли;
	
	Если Объект.ТипДенежныхСредств = Перечисления.ТипыДенежныхСредств.Безналичные Тогда	
		Если Объект.Счет.Пустая() Тогда
			ТекстОшибки = "Не заполнен банковский счет организации";
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки, ТекущийОбъект, "Касса", , Отказ);
			Возврат;
		КонецЕсли;
			
		Если Объект.ВидОперацииСРС <> Перечисления.ВидыОперацийСписаниеСРасчетногоСчета.ОплатаПоставщику 
			И Объект.РаспределениеПлатежа.Количество() > 0 Тогда
			Объект.РаспределениеПлатежа.Очистить();
		КонецЕсли;
	КонецЕсли;
	
	//++ №7928 проверка сумм по виду операции "Зарплата сотрудникам"
	ФинансыСервер.ПроверитьСуммуЗарплатыСотрудникамПоСуммеДокумента(Объект, Отказ, ПараметрыЗаписи.РежимЗаписи);
	//-- №7928	
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	
	Если ТипЗнч(ИсточникВыбора) = Тип("УправляемаяФорма")
		И СтрНайти(ИсточникВыбора.ИмяФормы, "ФормаКалендаря") > 0 Тогда
		
		Объект.ПериодРегистрации 		= НачалоМесяца(ВыбранноеЗначение);
		ОтображениеПериодаРегистрации 	= Формат(Объект.ПериодРегистрации, "ДФ='MMMM yyyy'");
		Модифицированность = Истина;
		
	ИначеЕсли ИсточникВыбора.ИмяФормы = "ОбщаяФорма.ФормаПодбораПоРасчетамСКонтрагентами" Тогда
		
		ПолучитьРаспределениеПлатежаИзХранилища(ВыбранноеЗначение.АдресПлатежейВХранилище);
	
	КонецЕсли;
	
	Если Окно <> Неопределено Тогда
		Окно.Активизировать();
	КонецЕсли;
	
КонецПроцедуры // ОбработкаВыбора()

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура ДатаПриИзменении(Элемент)
	
	// #14544 на случай если включат данную настройку, чтобы в документе был корректный период = дате документа
	Если НЕ ОтображатьПериодРегистрации И ЗначениеЗаполнено(Объект.Дата) Тогда
		Объект.ПериодРегистрации = НачалоМесяца(Объект.Дата);
	КонецЕсли;
	
	ДатаПриИзмененииНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ДатаПриИзмененииНаСервере()
	
	ФинансыСервер.ОбновитьВидимостьИКурсВалюты(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ВалютаПриИзменении(Элемент)
	ВалютаПриИзмененииНаСервере();
КонецПроцедуры

&НаСервере
Процедура ВалютаПриИзмененииНаСервере()
	
	ФинансыСервер.ОбновитьВидимостьИКурсВалюты(ЭтотОбъект, "ВалютаДокумента");
	
КонецПроцедуры

&НаКлиенте
Процедура ПодразделениеПриИзменении(Элемент)
	ЗаполнитьСтатьюДоходовРасходовСервер();
КонецПроцедуры

&НаКлиенте
Процедура КонтрагентПриИзменении(Элемент)
	КонтрагентПриИзмененииНаСервере();
КонецПроцедуры

&НаСервере
Процедура КонтрагентПриИзмененииНаСервере()
	
	Если ЗначениеЗаполнено(Объект.Контрагент) И ТипЗнч(Объект.Контрагент) = Тип("СправочникСсылка.Контрагенты") Тогда
		Объект.Договор = Объект.Контрагент.ОсновнойДоговор;
		//Элементы.КонтрагентДополнительно.Видимость = Объект.Контрагент.ПоказыватьДопИнформацию;
		//КонтрагентДополнительно = Объект.Контрагент.Дополнительно;
		ОбщийМодульСервер.ДополнительнаяИнформацияПоКонтрагентуНаФорме(Объект.Контрагент, Элементы.ПоказатьДополнительнуюИнформацию);
	Иначе
		//Элементы.КонтрагентДополнительно.Видимость = Ложь;
		Элементы.ПоказатьДополнительнуюИнформацию.Видимость = Ложь;
	КонецЕсли;
	ОбщийМодульСервер.РегулировкаШириныПоляКонтрагента(Элементы, Элементы.Контрагент, Элементы.ПоказатьДополнительнуюИнформацию);
	
КонецПроцедуры

&НаСервере
Процедура КассаПриИзмененииНаСервере()
	Если НЕ Объект.Касса.Валюта.Пустая() Тогда
		Объект.ВалютаДокумента = Объект.Касса.Валюта;
	Иначе
		Объект.ВалютаДокумента = Константы.ВалютаУчета.Получить();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура КассаПриИзменении(Элемент)
	КассаПриИзмененииНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ВидОперацииРКОПриИзменении(Элемент)
	
	// #14544 на случай если включат данную настройку, чтобы в документе был корректный период = дате документа
	Если НЕ ОтображатьПериодРегистрации И ЗначениеЗаполнено(Объект.Дата) Тогда
		Объект.ПериодРегистрации = НачалоМесяца(Объект.Дата);
	КонецЕсли;
	
	//ОбновитьДанные();
	ВидОперацииРКОПриИзмененииНаСервере();
	УстановитьВидимостьЭлементовПоВидуРКО();
	
КонецПроцедуры

&НаСервере
Процедура ВидОперацииРКОПриИзмененииНаСервере()
	Если НЕ Объект.ВидОперацииРКО.Пустая() Тогда
    	Объект.СтатьяРасходов = ФинансыСервер.ПолучитьСтатьюДоходовРасходов(Объект, Объект.ВидОперацииРКО, Ложь);
		Объект.СтатьяРасходовПоНачислению = Объект.СтатьяРасходов; //#9708
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ВидОперацииСРСПриИзменении(Элемент)
	
	// #14544 на случай если включат данную настройку, чтобы в документе был корректный период = дате документа
	Если НЕ ОтображатьПериодРегистрации И ЗначениеЗаполнено(Объект.Дата) Тогда
		Объект.ПериодРегистрации = НачалоМесяца(Объект.Дата);
	КонецЕсли;
	
	//ОбновитьДанные();
	ВидОперацииСРСПриИзмененииНаСервере();
	УстановитьВидимостьЭлементовПоВидуСРС();
	УстановитьВидимостьЭлементовПоНДС();
	
КонецПроцедуры

&НаСервере
Процедура ВидОперацииСРСПриИзмененииНаСервере()
	Если НЕ Объект.ВидОперацииСРС.Пустая() Тогда
    	Объект.СтатьяРасходов = ФинансыСервер.ПолучитьСтатьюДоходовРасходов(Объект, Объект.ВидОперацииСРС, Ложь);
		Объект.СтатьяРасходовПоНачислению = Объект.СтатьяРасходов; //#9708
	КонецЕсли;
	ФинансыСервер.ЗаполнитьСписокКодовВидаДохода(Элементы.КодВидаДохода, Объект.ВидОперацииСРС);
	Если Объект.ВидОперации = Перечисления.ВидыОперацийСписаниеСРасчетногоСчета.ЗарплатаСотруднику
		И Объект.КодВидаДохода = "" Тогда
		Объект.КодВидаДохода = "1";
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура СтатусУтвержденияПлатежаПриИзменении(Элемент)
	УстановитьДоступностьЭлементовПоСтатусу();
КонецПроцедуры

&НаКлиенте
Процедура ТипДенежныхСредствПриИзменении(Элемент)
	
	УстановитьВидимостьЭлементовПоТипуДС();
	УстановитьВидимостьЭлементовПоВидуРКО();
	УстановитьВидимостьЭлементовПоВидуСРС();
	УправлениеПоказателямиПлатежаВБюджет();
	
КонецПроцедуры

&НаКлиенте
Процедура ОрганизацияПриИзменении(Элемент)
	УстановитьВидимостьЭлементовПоНДС();
	ЗаполнитьСтатьюДоходовРасходовСервер();
КонецПроцедуры

&НаКлиенте
Процедура СуммаДокументаПриИзменении(Элемент)
	Если Объект.РаспределениеПлатежа.Количество() = 1 Тогда
		Если Объект.РаспределениеПлатежа[0].Документ = Объект.Основание Тогда
			Объект.РаспределениеПлатежа[0].Сумма = Объект.СуммаДокумента;
		КонецЕсли;
	КонецЕсли;
	
	РассчитатьСуммуНДС();
КонецПроцедуры

&НаКлиенте
Процедура СтавкаНДСПриИзменении(Элемент)
	РассчитатьСуммуНДС();
КонецПроцедуры

&НаКлиенте
Процедура СуммаНДСПриИзменении(Элемент)
	РассчитатьСуммуНДС();
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьСуммуНДС()
	Объект.СуммаНДС = УчетНДС.РассчитатьСуммуНДС(Объект.СуммаДокумента,
	                                             УчитыватьНДС, ,
	                                             УчетНДС.ПолучитьСтавкуНДС(Объект.СтавкаНДС));	
КонецПроцедуры

&НаКлиенте
Процедура УказатьВНазначении(Команда)

	ПозицияСуммы = СтрНайти(Объект.НазначениеПлатежа, "Сумма ");
	Если ПозицияСуммы = 0 И ЗначениеЗаполнено(Объект.НазначениеПлатежа) Тогда
		ТекстНазначение = Объект.НазначениеПлатежа;
	Иначе
		ТекстНазначение = СокрЛП(Лев(Объект.НазначениеПлатежа, ПозицияСуммы - 1));
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ТекстНазначение) Тогда
		ТекстНазначение = Объект.НазначениеПлатежа;
	КонецЕсли;
	
	ТекстСумма = Строка(Формат(Объект.СуммаДокумента, "ЧЦ=15; ЧДЦ=2; ЧРД=-; ЧН=0-00; ЧГ="));
	
	ТекстНДС = "";
	ЧислоСтавкаНДС = УчетНДС.ПолучитьСтавкуНДС(Объект.СтавкаНДС);
	
	Если УчитыватьНДС И ЗначениеЗаполнено(Объект.СтавкаНДС) И ЧислоСтавкаНДС > 0 Тогда
		ТекстНДС = НСтр("ru = 'НДС(%СтавкаНДС%) %СуммаНДС%'");
		ТекстНДС = СтрЗаменить(ТекстНДС, "%СтавкаНДС%", Строка(Объект.СтавкаНДС));
		ТекстНДС = СтрЗаменить(ТекстНДС, "%СуммаНДС%", Строка(Формат(Объект.СуммаНДС, "ЧЦ=15; ЧДЦ=2; ЧРД=-; ЧН=0-00; ЧГ=")));
	КонецЕсли;
	
	Если УчитыватьНДС Тогда
		ТекстНазначениеПлатежа = НСтр("ru = '%ТекстНазначение% %ТекстСумма% %ЗначениеСтавкиНДС% %ТекстНДС%'");
	Иначе
		ТекстНазначениеПлатежа = НСтр("ru = '%ТекстНазначение% %ТекстСумма%'");
	КонецЕсли;
	
	ТекстНазначениеПлатежа = СтрЗаменить(ТекстНазначениеПлатежа, "%ТекстНазначение%", ТекстНазначение);
	ТекстНазначениеПлатежа = СтрЗаменить(ТекстНазначениеПлатежа, "%ТекстСумма%", "Сумма "+ТекстСумма);
	ТекстНазначениеПлатежа = СтрЗаменить(ТекстНазначениеПлатежа, "%ЗначениеСтавкиНДС%", ?(ЧислоСтавкаНДС > 0, НСтр("ru = 'в т.ч.'"), НСтр("ru = 'Без налога (НДС)'")));
	ТекстНазначениеПлатежа = СтрЗаменить(ТекстНазначениеПлатежа, "%ТекстНДС%", ТекстНДС);
	
	Объект.НазначениеПлатежа = СокрЛП(ТекстНазначениеПлатежа);
	Модифицированность = Истина;
		
КонецПроцедуры

&НаКлиенте
Процедура НадписьРеквизитыПлатежаВБюджетНажатие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ТолькоПросмотр",         ЭтаФорма.ТолькоПросмотр);
	ПараметрыФормы.Вставить("КодБК",                  Объект.КодБК);
	ПараметрыФормы.Вставить("КодОКАТО",               Объект.КодОКАТО);
	ПараметрыФормы.Вставить("ПоказательДаты",         Объект.ПоказательДаты);
	ПараметрыФормы.Вставить("ПоказательНомера",       Объект.ПоказательНомера);
	ПараметрыФормы.Вставить("ПоказательОснования",    Объект.ПоказательОснования);
	ПараметрыФормы.Вставить("ПоказательПериода",      Объект.ПоказательПериода);
	ПараметрыФормы.Вставить("ПоказательТипа",         Объект.ПоказательТипа);
	ПараметрыФормы.Вставить("СтатусСоставителя",      Объект.СтатусСоставителя);
	//ПараметрыФормы.Вставить("ТекущаяДата",            ТекущаяДата);
	
	Оповещение = Новый ОписаниеОповещения("НадписьРеквизитыПлатежаВБюджетНажатиеЗавершение", ЭтотОбъект);
	
	ОткрытьФорму(
		"ОбщаяФорма.РеквизитыПлатежаВБюджет",
		ПараметрыФормы,
		ЭтотОбъект,,,,
		Оповещение,
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
КонецПроцедуры

&НаКлиенте
Процедура НадписьРеквизитыПлатежаВБюджетНажатиеЗавершение(РеквизитыПлатежаВБюджет, ДополнительныеПараметры) Экспорт
	
	Если РеквизитыПлатежаВБюджет <> Неопределено Тогда	
		Модифицированность = Истина;		
		ЗаполнитьЗначенияСвойств(Объект, РеквизитыПлатежаВБюджет);		
		УправлениеПоказателямиПлатежаВБюджет();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПеречислениеВБюджетПриИзмененииНаСервере()

	Если Объект.ПеречислениеВБюджет Тогда
		Если ПустаяСтрока(Объект.КодОКАТО) Тогда
			Объект.КодОКАТО = Объект.Организация.КодПоОКТМО;
		КонецЕсли;
	КонецЕсли;
	
	УправлениеПоказателямиПлатежаВБюджет();
	
КонецПроцедуры

&НаКлиенте
Процедура ПеречислениеВБюджетПриИзменении(Элемент)
	ПеречислениеВБюджетПриИзмененииНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ЗарплатаСотрудникамПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	Объект.СуммаДокумента = Объект.ЗарплатаСотрудникам.Итог("Сумма");
КонецПроцедуры

&НаКлиенте
Процедура ОтображениеПериодаРегистрацииРегулирование(Элемент, Направление, СтандартнаяОбработка)
	
	Объект.ПериодРегистрации = ?(ЗначениеЗаполнено(Объект.ПериодРегистрации), 
							ДобавитьМесяц(Объект.ПериодРегистрации, Направление),
							ДобавитьМесяц(НачалоМесяца(ТекущаяДата()), Направление));							
	Объект.ПериодРегистрации 		= НачалоМесяца(Объект.ПериодРегистрации);
	ОтображениеПериодаРегистрации 	= Формат(Объект.ПериодРегистрации, "ДФ='MMMM yyyy'");
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтображениеПериодаРегистрацииНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка	 = Ложь;	
	ДатаКалендаряПриОткрытии = ?(ЗначениеЗаполнено(Объект.ПериодРегистрации), Объект.ПериодРегистрации, ТекущаяДата());
	СтруктураПараметров 	 = Новый Структура("ДатаКалендаря, ЗакрыватьПриВыборе, МножественныйВыбор", ДатаКалендаряПриОткрытии, Истина, Ложь);
	ОткрытьФорму("ОбщаяФорма.ФормаКалендаря", СтруктураПараметров, ЭтаФорма);
	
КонецПроцедуры

#КонецОбласти

#Область УправлениеЭлементамиФормы

&НаСервере
Процедура УстановитьСписокСтатусов()
	
	СписокВыбора = Элементы.СтатусУтвержденияПлатежа.СписокВыбора;
	Если Не ПравоУтверждения Тогда		
		СписокВыбора.Очистить();
		СписокВыбора.Добавить(Перечисления.СтатусыУтвержденияПлатежей.НеУтвержден);
		
		Если Объект.СтатусУтвержденияПлатежа = Перечисления.СтатусыУтвержденияПлатежей.Утвержден Тогда
			СписокВыбора.Добавить(Перечисления.СтатусыУтвержденияПлатежей.Утвержден);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьДоступностьЭлементовПоСтатусу()
	ТолькоПросмотрЭлементов = Ложь;
	
	Если Объект.СтатусУтвержденияПлатежа = Перечисления.СтатусыУтвержденияПлатежей.Утвержден Тогда	
		ТолькоПросмотрЭлементов = Истина;
	КонецЕсли;
		
	ЭлементыТолькоПросмотр = Новый Массив;
	ЭлементыТолькоПросмотр.Добавить(Элементы.Номер);
	ЭлементыТолькоПросмотр.Добавить(Элементы.Дата);
	ЭлементыТолькоПросмотр.Добавить(Элементы.ТипДенежныхСредств);
	ЭлементыТолькоПросмотр.Добавить(Элементы.ГруппаПраво);
	ЭлементыТолькоПросмотр.Добавить(Элементы.СтатусУтвержденияПлатежа);
	ЭлементыТолькоПросмотр.Добавить(Элементы.ГруппаОрганизация);
	ЭлементыТолькоПросмотр.Добавить(Элементы.ГруппаСуммаДокумента);
	ЭлементыТолькоПросмотр.Добавить(Элементы.ГруппаНДС);
	ЭлементыТолькоПросмотр.Добавить(Элементы.ГруппаПеречислениеВБюджет);
	ЭлементыТолькоПросмотр.Добавить(Элементы.ГруппаУИНОчередность);
	ЭлементыТолькоПросмотр.Добавить(Элементы.НазначениеПлатежа);
	ЭлементыТолькоПросмотр.Добавить(Элементы.Страницы);
	ЭлементыТолькоПросмотр.Добавить(Элементы.ГруппаДополнительно);
	
	Для каждого Элемент Из ЭлементыТолькоПросмотр Цикл
		Элемент.ТолькоПросмотр = ТолькоПросмотрЭлементов;
	КонецЦикла;
	
	ЭлементыДоступность = Новый Массив;
	ЭлементыДоступность.Добавить(Элементы.УказатьВНазначении);
	
	Для каждого Элемент Из ЭлементыДоступность Цикл
		Элемент.Доступность = Не ТолькоПросмотрЭлементов;
	КонецЦикла;
		
	Если ПравоУтверждения 
		И Объект.СтатусУтвержденияПлатежа = Перечисления.СтатусыУтвержденияПлатежей.Утвержден
		И НЕ СостояниеОплачено Тогда
		Элементы.СтатусУтвержденияПлатежа.ТолькоПросмотр = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьЭлементовПоТипуДС()
	
	ВидимостьНаличные = (Объект.ТипДенежныхСредств = Перечисления.ТипыДенежныхСредств.Наличные); 
	
	ЭлементыНаличные = Новый Массив;
	ЭлементыНаличные.Добавить(Элементы.ВидОперацииРКО);
	ЭлементыНаличные.Добавить(Элементы.Касса);
	
	Для каждого Элемент Из ЭлементыНаличные Цикл
		Элемент.Видимость = ВидимостьНаличные;
	КонецЦикла;

	ЭлементыБезналичные = Новый Массив;
	ЭлементыБезналичные.Добавить(Элементы.ВидОперацииСРС);
	ЭлементыБезналичные.Добавить(Элементы.Счет);
	ЭлементыБезналичные.Добавить(Элементы.СчетКонтрагента);
	ЭлементыБезналичные.Добавить(Элементы.СтавкаНДС);
	ЭлементыБезналичные.Добавить(Элементы.СуммаНДС);
	ЭлементыБезналичные.Добавить(Элементы.НазначениеПлатежа);
	ЭлементыБезналичные.Добавить(Элементы.ПеречислениеВБюджет);
	ЭлементыБезналичные.Добавить(Элементы.НадписьРеквизитыПлатежаВБюджет);
	ЭлементыБезналичные.Добавить(Элементы.ИдентификаторПлатежа);
	ЭлементыБезналичные.Добавить(Элементы.ОчередностьПлатежа);
	ЭлементыБезналичные.Добавить(Элементы.КодВидаДохода);
	ЭлементыБезналичные.Добавить(Элементы.УказатьВНазначении);
	
	Для каждого Элемент Из ЭлементыБезналичные Цикл
		Элемент.Видимость = НЕ ВидимостьНаличные;
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьЭлементовПоНДС()
	Если Объект.ВидОперацииСРС = ПредопределенноеЗначение("Перечисление.ВидыОперацийСписаниеСРасчетногоСчета.ОплатаПоставщику") Тогда
		УчитыватьНДС = УчетНДС.ОрганизацияЯвляетсяПлательщикомНДС(Объект.Организация);
	Иначе
		УчитыватьНДС = Ложь;
	КонецЕсли;
	Элементы.ГруппаНДС.Видимость = УчитыватьНДС;
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьЭлементовПоВидуРКО()
	
	Если Объект.ТипДенежныхСредств = Перечисления.ТипыДенежныхСредств.Безналичные Тогда
		Возврат;
	КонецЕсли;
	
	Элементы.Контрагент.Видимость = Ложь;
	Элементы.Договор.Видимость = Ложь;
	Элементы.ГруппаЗарплатаСотрудникам.Видимость = Ложь;
	Элементы.ОтображениеПериодаРегистрации.Видимость = Ложь;
	Элементы.ГруппаРаспределениеПлатежа.Видимость = Ложь;
	Элементы.СуммаДокумента.ТолькоПросмотр = Ложь;
	//Элементы.ГруппаВидНачисленияСотрудника.Видимость = Ложь; //#6576 
	Элементы.РаспределениеПлатежаГруппаВозвратПокупателю.Видимость = Ложь;
	Элементы.РаспределениеПлатежаГруппаОплатаПоставщику.Видимость = Ложь;
	
	//#9708
	Элементы.СтатьяРасходовПоНачислению.Видимость = ПолучитьФункциональнуюОпцию("НекассовыйМетодВеденияУчетаДоходовРасходов") 
									И Объект.ВидОперацииРКО = Перечисления.ВидыОперацийРасходныйКассовыйОрдер.ПрочееСписание;
									
	Элементы.СтатьяРасходов.Видимость = Истина;	// #12545
	
	Если Объект.ВидОперацииРКО = Перечисления.ВидыОперацийРасходныйКассовыйОрдер.ОплатаПоставщику Тогда
		Элементы.Контрагент.Видимость = Истина;
		Элементы.Договор.Видимость = Истина;
		Элементы.ГруппаРаспределениеПлатежа.Видимость = Истина;
		Элементы.РаспределениеПлатежаГруппаОплатаПоставщику.Видимость = Истина;
		Если НЕ ЗначениеЗаполнено(Объект.Контрагент) ИЛИ НЕ ТипЗнч(Объект.Контрагент) = Тип("СправочникСсылка.Контрагенты") Тогда
			Объект.Контрагент = Справочники.Контрагенты.ПустаяСсылка();
		КонецЕсли;
		
	ИначеЕсли Объект.ВидОперацииРКО = Перечисления.ВидыОперацийРасходныйКассовыйОрдер.ВозвратПокупателю Тогда
		Элементы.Контрагент.Видимость = Истина;
		Элементы.Договор.Видимость = Истина;
		Элементы.ГруппаРаспределениеПлатежа.Видимость = Истина;
		Элементы.РаспределениеПлатежаГруппаВозвратПокупателю.Видимость = Истина;
		
		Если НЕ ЗначениеЗаполнено(Объект.Контрагент) ИЛИ НЕ ТипЗнч(Объект.Контрагент) = Тип("СправочникСсылка.Контрагенты") Тогда
			Объект.Контрагент = Справочники.Контрагенты.ПустаяСсылка();
		КонецЕсли;
		
	ИначеЕсли Объект.ВидОперацииРКО = Перечисления.ВидыОперацийРасходныйКассовыйОрдер.ВыдачаПодотчетнику Тогда
		Элементы.Контрагент.Видимость = Истина;
		Если НЕ ЗначениеЗаполнено(Объект.Контрагент) ИЛИ НЕ ТипЗнч(Объект.Контрагент) = Тип("СправочникСсылка.Сотрудники") Тогда
			Объект.Контрагент = Справочники.Сотрудники.ПустаяСсылка();
		КонецЕсли;
		
	ИначеЕсли Объект.ВидОперацииРКО = Перечисления.ВидыОперацийРасходныйКассовыйОрдер.ЗарплатаСотрудникам Тогда
		Элементы.ГруппаЗарплатаСотрудникам.Видимость = Истина;
		Элементы.ОтображениеПериодаРегистрации.Видимость = ОтображатьПериодРегистрации;
		Элементы.СуммаДокумента.ТолькоПросмотр = Истина;
		Объект.СуммаДокумента = Объект.ЗарплатаСотрудникам.Итог("Сумма");
		
	ИначеЕсли Объект.ВидОперацииРКО = Перечисления.ВидыОперацийРасходныйКассовыйОрдер.Инкассация Тогда
		Элементы.СтатьяРасходов.Видимость = Ложь; // #12545
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьЭлементовПоВидуСРС()
	
	Если Объект.ТипДенежныхСредств = Перечисления.ТипыДенежныхСредств.Наличные Тогда
		Возврат;
	КонецЕсли;
	
	Элементы.ГруппаКонтрагент.Видимость = Истина;
	Элементы.Контрагент.Видимость = Ложь;
	Элементы.Договор.Видимость = Ложь;
	Элементы.СчетКонтрагента.Видимость = Ложь;	
	Элементы.ГруппаЗарплатаСотрудникам.Видимость = Ложь;
	Элементы.ОтображениеПериодаРегистрации.Видимость = Ложь;
	Элементы.ГруппаРаспределениеПлатежа.Видимость = Ложь;
	Элементы.СуммаДокумента.ТолькоПросмотр = Ложь;
	Элементы.ГруппаПеречислениеВБюджет.Видимость = Ложь;
	//Элементы.ГруппаВидНачисленияСотрудника.Видимость = Ложь; //#6576
	Элементы.РаспределениеПлатежаГруппаВозвратПокупателю.Видимость = Ложь;
	Элементы.РаспределениеПлатежаГруппаОплатаПоставщику.Видимость = Ложь;
	
	//#9708
	Элементы.СтатьяРасходовПоНачислению.Видимость = ПолучитьФункциональнуюОпцию("НекассовыйМетодВеденияУчетаДоходовРасходов") 
									И Объект.ВидОперацииСРС = Перечисления.ВидыОперацийСписаниеСРасчетногоСчета.ПрочееСписание;
									
	Элементы.СтатьяРасходов.Видимость = Истина; // #12545
	
	Если Объект.ВидОперацииСРС = Перечисления.ВидыОперацийСписаниеСРасчетногоСчета.ОплатаПоставщику Тогда
		Элементы.Контрагент.Видимость = Истина;
		Элементы.Договор.Видимость = Истина;
		Элементы.СчетКонтрагента.Видимость = Истина;
		Элементы.ГруппаРаспределениеПлатежа.Видимость = Истина;	
		Элементы.РаспределениеПлатежаГруппаОплатаПоставщику.Видимость = Истина;
		
	ИначеЕсли Объект.ВидОперацииСРС = Перечисления.ВидыОперацийСписаниеСРасчетногоСчета.ВозвратПокупателю Тогда
		Элементы.Контрагент.Видимость = Истина;
		Элементы.Договор.Видимость = Истина;
		Элементы.СчетКонтрагента.Видимость = Истина;
		Элементы.ГруппаРаспределениеПлатежа.Видимость = Истина;
		Элементы.РаспределениеПлатежаГруппаВозвратПокупателю.Видимость = Истина;
				
	ИначеЕсли Объект.ВидОперацииСРС = Перечисления.ВидыОперацийСписаниеСРасчетногоСчета.ПеречислениеНалоговИВзносов Тогда
		Элементы.Контрагент.Видимость = Истина;
		Элементы.Договор.Видимость = Истина;
		Элементы.СчетКонтрагента.Видимость = Истина;
		Элементы.ГруппаПеречислениеВБюджет.Видимость = Истина;
		Если НЕ ЗначениеЗаполнено(Объект.Контрагент) ИЛИ НЕ ТипЗнч(Объект.Контрагент) = Тип("СправочникСсылка.Контрагенты") Тогда
			Объект.Контрагент = Справочники.Контрагенты.ПустаяСсылка();
		КонецЕсли;
	ИначеЕсли Объект.ВидОперацииСРС = Перечисления.ВидыОперацийСписаниеСРасчетногоСчета.ИнкассацияИзБанка Тогда
		Элементы.ГруппаКонтрагент.Видимость = Ложь;
		Элементы.СтатьяРасходов.Видимость = Ложь; // #12545
		
	ИначеЕсли Объект.ВидОперацииСРС = Перечисления.ВидыОперацийСписаниеСРасчетногоСчета.ЗарплатаСотрудникам Тогда
		Элементы.ГруппаЗарплатаСотрудникам.Видимость = Истина;
		Элементы.ОтображениеПериодаРегистрации.Видимость = ОтображатьПериодРегистрации;
		Если Объект.ЗарплатаСотрудникам.Количество() > 0 Тогда
			Элементы.СуммаДокумента.ТолькоПросмотр = Истина;
			Объект.СуммаДокумента = Объект.ЗарплатаСотрудникам.Итог("Сумма");
		КонецЕсли;	
		//Элементы.Контрагент.Видимость = Истина;           //#13333 закомментировано
		//Элементы.СчетКонтрагента.Видимость = Истина;
	ИначеЕсли Объект.ВидОперацииСРС = Перечисления.ВидыОперацийСписаниеСРасчетногоСчета.ЗарплатаСотруднику Тогда
		Элементы.Контрагент.Видимость = Истина;
		Элементы.СчетКонтрагента.Видимость = Истина;	
		Элементы.ОтображениеПериодаРегистрации.Видимость = ОтображатьПериодРегистрации;
		//Элементы.ГруппаВидНачисленияСотрудника.Видимость = Истина; //#6576 
	ИначеЕсли Объект.ВидОперацииСРС = Перечисления.ВидыОперацийСписаниеСРасчетногоСчета.ВыдачаПодотчетнику Тогда
		Элементы.Контрагент.Видимость = Истина;
		Элементы.СчетКонтрагента.Видимость = Истина;
		Если НЕ ЗначениеЗаполнено(Объект.Контрагент) ИЛИ НЕ ТипЗнч(Объект.Контрагент) = Тип("СправочникСсылка.Сотрудники") Тогда
			Объект.Контрагент = Справочники.Сотрудники.ПустаяСсылка();
		КонецЕсли;
	КонецЕсли;
	
	Элементы.КодВидаДохода.Видимость = ФинансыСервер.ВозможноВзысканиеСПеречисленияФизлицу(Объект.Дата, Объект.ВидОперацииСРС);
	
КонецПроцедуры

&НаСервере
Процедура УправлениеПоказателямиПлатежаВБюджет()
	
	Элементы.НадписьРеквизитыПлатежаВБюджет.Видимость = Объект.ПеречислениеВБюджет;
	
	Если Объект.ПеречислениеВБюджет Тогда
		Элементы.ИдентификаторПлатежа.Заголовок = НСтр("ru = 'УИН'");
		Элементы.ИдентификаторПлатежа.Подсказка = НСтр("ru = 'Уникальный идентификатор начисления указывается, если предоставлен получателем (администратором) платежа.'");
	Иначе
		Элементы.ИдентификаторПлатежа.Заголовок = НСтр("ru = 'УИП'");
		Элементы.ИдентификаторПлатежа.Подсказка = НСтр("ru = 'Уникальный идентификатор платежа указывается, если это предусмотрено договором с получателем платежа.'");
	КонецЕсли;
		
	УстановитьНадписьРеквизитовПлатежаВБюджет();
	
КонецПроцедуры

&НаСервере
Процедура УстановитьНадписьРеквизитовПлатежаВБюджет() Экспорт
		 
	Если НЕ ПустаяСтрока(СокрЛП(Объект.КодБК)) Тогда
		КБК = Объект.КодБК;
	Иначе
		КБК = НСтр("ru = '<КБК не указан>'");
	КонецЕсли;
	
	Если НЕ ПустаяСтрока(СокрЛП(Объект.КодОКАТО)) Тогда
		КодТерритории = Объект.КодОКАТО;
	Иначе
		КодТерритории = НСтр("ru = '<ОКТМО не указан>'");
	КонецЕсли;
	
	Если НЕ ПустаяСтрока(СокрЛП(Объект.СтатусСоставителя)) Тогда
		СтатусСоставителя = Объект.СтатусСоставителя;
	Иначе
		СтатусСоставителя = НСтр("ru = '<Статус составителя не указан>'");
	КонецЕсли;
	
	ЭтаФорма.НадписьРеквизитыПлатежаВБюджет = КБК + "; "
		+ КодТерритории + "; "
		+ СтатусСоставителя + "; "
		+ Объект.ПоказательОснования + "; "
		+ Объект.ПоказательПериода + "; "
		+ Объект.ПоказательНомера + "; "
		+ Объект.ПоказательДаты + "; ";
	
КонецПроцедуры

