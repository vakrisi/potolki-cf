&НаСервере
Процедура ЗаполнитьСтатьюДоходовРасходовСервер()
	
	Если Объект.ТипДенежныхСредств = Перечисления.ТипыДенежныхСредств.Наличные И НЕ Объект.ВидОперацииРКО.Пустая() Тогда
		Объект.СтатьяРасходов = ФинансыСервер.ПолучитьСтатьюДоходовРасходов(Объект, Объект.ВидОперацииРКО, Ложь);
		Объект.СтатьяРасходовПоНачислению = Объект.СтатьяРасходов; //#9708
		
	ИначеЕсли Объект.ТипДенежныхСредств = Перечисления.ТипыДенежныхСредств.Безналичные И НЕ Объект.ВидОперацииСРС.Пустая() Тогда
		Объект.СтатьяРасходов = ФинансыСервер.ПолучитьСтатьюДоходовРасходов(Объект, Объект.ВидОперацииСРС, Ложь);
		Объект.СтатьяРасходовПоНачислению = Объект.СтатьяРасходов; //#9708
	КонецЕсли;
	
КонецПроцедуры

