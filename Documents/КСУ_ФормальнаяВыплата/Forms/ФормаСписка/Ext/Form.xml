			</UseAlways>
			<Settings xsi:type="DynamicList">
				<ManualQuery>true</ManualQuery>
				<DynamicDataRead>true</DynamicDataRead>
				<QueryText>ВЫБРАТЬ
	ДокументКСУ_ФормальнаяВыплата.Ссылка КАК Ссылка,
	ДокументКСУ_ФормальнаяВыплата.ПометкаУдаления КАК ПометкаУдаления,
	ДокументКСУ_ФормальнаяВыплата.Номер КАК Номер,
	ДокументКСУ_ФормальнаяВыплата.Дата КАК Дата,
	ДокументКСУ_ФормальнаяВыплата.Проведен КАК Проведен,
	ДокументКСУ_ФормальнаяВыплата.Организация КАК Организация,
	ДокументКСУ_ФормальнаяВыплата.Комментарий КАК Комментарий,
	ДокументКСУ_ФормальнаяВыплата.СуммаДокумента КАК СуммаДокумента,
	ДокументКСУ_ФормальнаяВыплата.ПредставлениеЗаказов КАК ПредставлениеЗаказов,
	ДокументКСУ_ФормальнаяВыплата.Проведен КАК КартинкаСтатус,
	ВЫБОР
		КОГДА ДокументКСУ_ФормальнаяВыплата.Проведен
			ТОГДА "Утвержден"
		ИНАЧЕ "Черновик"
	КОНЕЦ КАК Статус,
	НаЗаказы.Сумма КАК НаЗаказыСумма,
	НаФонды.Сумма КАК НаФондыСумма
ИЗ
	Документ.КСУ_ФормальнаяВыплата КАК ДокументКСУ_ФормальнаяВыплата
		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			КСУ_ФормальнаяВыплатаиа_ЗаказыНаПриобретение.Ссылка КАК Ссылка,
			СУММА(КСУ_ФормальнаяВыплатаиа_ЗаказыНаПриобретение.Сумма) КАК Сумма
		ИЗ
			Документ.КСУ_ФормальнаяВыплата.иа_ЗаказыНаПриобретение КАК КСУ_ФормальнаяВыплатаиа_ЗаказыНаПриобретение
		
		СГРУППИРОВАТЬ ПО
			КСУ_ФормальнаяВыплатаиа_ЗаказыНаПриобретение.Ссылка) КАК НаЗаказы
		ПО (НаЗаказы.Ссылка = ДокументКСУ_ФормальнаяВыплата.Ссылка)
		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			иа_Фонды.Ссылка КАК Ссылка,
			СУММА(иа_Фонды.Сумма) КАК Сумма
		ИЗ
			Документ.КСУ_ФормальнаяВыплата.иа_Фонды КАК иа_Фонды
		
