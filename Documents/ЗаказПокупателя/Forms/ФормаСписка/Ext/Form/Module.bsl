#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	НачальныйСтатусЗП = Справочники.СтатусыЗаказовПокупателей.НачальныйСтатус();
	//#13253
	СписокСтатусовЗаказовПокупателей = Справочники.СтатусыЗаказовПокупателей.СписокСтатусов();

	//#13387
	НастройкиПользователяИнициированы = Ложь;
	ВосстановитьНастройкиФормы(НастройкиПользователяИнициированы);	
	
	Если НЕ НастройкиПользователяИнициированы Тогда
		ЗаказПокупателяОтборПоСтатусу.Добавить(НачальныйСтатусЗП);
	КонецЕсли;	
	
	Для каждого ЭлементСписка из ЗаказПокупателяОтборПоСтатусу Цикл		
		НачЭлементСписка = СписокСтатусовЗаказовПокупателей.НайтиПоЗначению(ЭлементСписка.Значение);
		Если НЕ НачЭлементСписка = Неопределено Тогда
			НачЭлементСписка.Пометка = Истина;
		КонецЕсли;
	КонецЦикла;
			
	////УстановитьОтбор(ЭтаФорма, "Список", "ТекущийСтатус",  ОтборПоСтатусу, Истина, "ТекущийСтатус");
	//ОбщийМодуль.УстановитьОтборДинамическогоСписка(ЭтаФорма, "Список", "ТекущийСтатус", ФильтрСтатус);
	
	//Список.Параметры.УстановитьЗначениеПараметра("ТекДата", ТекущаяДатаСеанса());
	//Список.Параметры.УстановитьЗначениеПараметра("ТекущийСтатус", Справочники.СтатусыЗаявокНаДоставку.Заявка); // №10663 заменено на справочник, было: Перечисления.СтатусыДоставкиТовара.Заявка);
	
	//#13035
	ВедутсяРасчетыПоДокументу = Константы.ВестиРасчетыПоЗаказамПоЗаказуПокупателя.Получить();
	Элементы.СостояниеОплаты.Видимость = ВедутсяРасчетыПоДокументу;
	Элементы.Оплачено.Видимость = ВедутсяРасчетыПоДокументу;
	Элементы.КОплате.Видимость = ВедутсяРасчетыПоДокументу;
		
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды

	// СтандартныеПодсистемы.УчетОригиналовПервичныхДокументов
	УчетОригиналовПервичныхДокументов.ПриСозданииНаСервере_ФормаСписка(ЭтотОбъект, Элементы.Список);
	// Конец СтандартныеПодсистемы.УчетОригиналовПервичныхДокументов

	ИспользоватьПодключаемоеОборудование = Константы.ИспользоватьПодключаемоеОборудование.Получить();
	
	//Элементы.СМСОтправлено.Видимость = Константы.АвтоматическаяРассылкаСМС.Получить();#12778 убрано
	//Элементы.ФормаОтправитьСМС.Видимость = Элементы.СМСОтправлено.Видимость;
	
	//Элементы.ПотолкиВНаличии.Видимость = Константы.СкладОтгрузкиПотолоковОтличаетсяОтСкладаГотовойПродукции.Получить(); #12778 убрано

	СофтФонСервер.ПриСозданииНаСервере(ЭтотОбъект, Элементы.СписокКоманднаяПанель);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	МенеджерОборудованияКлиентПереопределяемый.НачатьПодключениеОборудованиеПриОткрытииФормы(ЭтаФорма, "СканерШтрихкода");
	
	//УстановитьФильтрыСписка(Неопределено); // №11277
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	Если ЗавершениеРаботы Тогда
		Возврат;
	КонецЕсли;
	
	//#13387
	СохранитьНастройкиФормы();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)
		
	МенеджерОборудованияКлиентПереопределяемый.НачатьОтключениеОборудованиеПриЗакрытииФормы(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	// ПодключаемоеОборудование
	Если Источник = "ПодключаемоеОборудование" И ВводДоступен() Тогда
		Если ИмяСобытия = "ScanData" И МенеджерОборудованияПотолкиКлиент.ЕстьНеобработанноеСобытие() Тогда
			ОбработатьШтрихкоды(МенеджерОборудованияПотолкиКлиент.ПреобразоватьДанныеСоСканераВСтруктуру(Параметр));
		КонецЕсли;
	КонецЕсли;
	// Конец ПодключаемоеОборудование
	
	// СтандартныеПодсистемы.УчетОригиналовПервичныхДокументов
	УчетОригиналовПервичныхДокументовКлиент.ОбработчикОповещенияФормаСписка(ИмяСобытия, ЭтотОбъект, Элементы.Список);
	// Конец СтандартныеПодсистемы.УчетОригиналовПервичныхДокументов
	
	Если ИмяСобытия = "ОбновитьАРМПроизводства" Тогда
		Элементы.Список.Обновить();
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

