&НаСервере
Процедура СохранитьНастройкиФормы()

	ПользовательскийОтбор = Новый ОтборКомпоновкиДанных();
	ОбщийМодульСервер.НовыйОтбор(ПользовательскийОтбор, "Подразделение", 	ФильтрПодразделение);
	ОбщийМодульСервер.НовыйОтбор(ПользовательскийОтбор, "ИсточникЗаказа", 	ФильтрИсточникЗаказа);
	ОбщийМодульСервер.НовыйОтбор(ПользовательскийОтбор, "ТекущийСтатус", 	ЗаказПокупателяОтборПоСтатусу);
	ОбщийМодульСервер.НовыйОтбор(ПользовательскийОтбор, "Контрагент", 		ФильтрКонтрагент);
	ОбщийМодульСервер.НовыйОтбор(ПользовательскийОтбор, "НомераПотолков", 	ФильтрНомерПотолка);
	
	СтруктураНастроек = Новый Структура;	
	СтруктураНастроек.Вставить("НастройкиОтбора", Новый ХранилищеЗначения(ПользовательскийОтбор));
	ОбщегоНазначения.ХранилищеОбщихНастроекСохранить("СписокЗаказовПокупателей", "НастройкиФормыСписка", СтруктураНастроек);
	
КонецПроцедуры 

&НаСервере
Процедура ВосстановитьНастройкиФормы(НастройкиПользователяИнициированы)

	СтруктураНастроек = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить("СписокЗаказовПокупателей", "НастройкиФормыСписка");
	Если НЕ ТипЗнч(СтруктураНастроек) = Тип("Структура") Тогда
		Возврат;	
	КонецЕсли;
	
	ПользовательскийОтбор = СтруктураНастроек.НастройкиОтбора.Получить();
	НастройкиПользователяИнициированы = Истина;
	Для каждого НастройкаОтбора из ПользовательскийОтбор.Элементы Цикл
		Если НастройкаОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Подразделение") Тогда
			ФильтрПодразделение = НастройкаОтбора.ПравоеЗначение;
			
		ИначеЕсли НастройкаОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ИсточникЗаказа") Тогда
			ФильтрИсточникЗаказа = НастройкаОтбора.ПравоеЗначение;			
			
		ИначеЕсли НастройкаОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Контрагент") Тогда
			ФильтрКонтрагент = НастройкаОтбора.ПравоеЗначение;
			
		ИначеЕсли НастройкаОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("НомераПотолков") Тогда
			ФильтрНомерПотолка = НастройкаОтбора.ПравоеЗначение;
			
		ИначеЕсли НастройкаОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ТекущийСтатус") Тогда
			Для каждого ЭлементСписка из НастройкаОтбора.ПравоеЗначение Цикл
				Если НЕ СписокСтатусовЗаказовПокупателей.НайтиПоЗначению(ЭлементСписка.Значение) = Неопределено Тогда
					ЗаказПокупателяОтборПоСтатусу.Добавить(ЭлементСписка.Значение);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры 

&НаКлиенте
Процедура СоздатьНаОснованииПриходныйКассовыйОрдер(Команда)
	
	Если Элементы.Список.ТекущиеДанные <> Неопределено Тогда	
		Основание = Элементы.Список.ТекущиеДанные.Ссылка;	
		СписокОснований = Новый СписокЗначений;
		Для НомерСтроки = 0 По Элементы.Список.ВыделенныеСтроки.Количество()-1 Цикл
			СсылкаЗаказ = Элементы.Список.ВыделенныеСтроки.Получить(НомерСтроки);
			Если Основание <> СсылкаЗаказ Тогда
				СписокОснований.Добавить(Элементы.Список.ВыделенныеСтроки.Получить(НомерСтроки));		
			КонецЕсли;
		КонецЦикла;
		
		ПараметрыНовойФормы = Новый Структура;
		ПараметрыНовойФормы.Вставить("Основание", Основание);
		Если СписокОснований.Количество() > 0 Тогда
			ПараметрыНовойФормы.Вставить("СписокОснований", СписокОснований);
		КонецЕсли;
		ОткрытьФорму("Документ.ПриходныйКассовыйОрдер.ФормаОбъекта", ПараметрыНовойФормы);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтправитьСМС(Команда)
	Если ОбщийМодульВызовСервера.ЕстьТелефонКонтрагента(Элементы.Список.ТекущиеДанные.Ссылка) Тогда	
		Парам = Новый Структура;
		Парам.Вставить("Основание", Элементы.Список.ТекущиеДанные.Ссылка);
		ОткрытьФорму("Документ.ОтправкаСМС.Форма.ФормаДокумента",Парам);		
	Иначе
		ПоказатьОповещениеПользователя("У контрагента в карточке не указан номер телефона. СМС не создана");
	КонецЕсли;
КонецПроцедуры

//++ №11277
&НаКлиенте
Процедура УстановитьФильтрыСписка(Элемент)
	
	// Подразделение
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(
		Список
		, "Подразделение"
		, ФильтрПодразделение
		, ВидСравненияКомпоновкиДанных.Равно
		,
		, ЗначениеЗаполнено(ФильтрПодразделение)
	);
	
	// Источник
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(
		Список
		, "ИсточникЗаказа"
		, ФильтрИсточникЗаказа
		, ВидСравненияКомпоновкиДанных.Равно
		,
		, ЗначениеЗаполнено(ФильтрИсточникЗаказа)
	);
	
	// Статус
	//ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(
	//	Список
	//	, "ТекущийСтатус"
	//	, ФильтрСтатус
	//	, ВидСравненияКомпоновкиДанных.Равно
	//	,
	//	, ЗначениеЗаполнено(ФильтрСтатус)
	//);
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Список,
			"ТекущийСтатус", ЗаказПокупателяОтборПоСтатусу, ВидСравненияКомпоновкиДанных.ВСписке,, ЗаказПокупателяОтборПоСтатусу.Количество() > 0);
	
	// Контрагент
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(
		Список
		, "Контрагент"
		, ФильтрКонтрагент
		, ВидСравненияКомпоновкиДанных.Равно
		,
		, ЗначениеЗаполнено(ФильтрКонтрагент)
	);
	
	// Номер потолка
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(
		Список
		, "НомераПотолков"
		, ФильтрНомерПотолка
		, ВидСравненияКомпоновкиДанных.Содержит
		,
		, ЗначениеЗаполнено(ФильтрНомерПотолка)
	);
	
КонецПроцедуры

//-- №11277

&НаКлиенте
Процедура ЗаказПокупателяОтборПоСтатусуНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	//#13253
	СтандартнаяОбработка = Ложь;
	Обработчик = Новый ОписаниеОповещения("ЗаказПокупателяОтборПоСтатусуЗавершениеВыбора", ЭтотОбъект);
	ЗаголовокДиалога = НСтр("ru = 'Выберите статусы к отбору'");
	СписокСтатусовЗаказовПокупателей.ПоказатьОтметкуЭлементов(Обработчик, ЗаголовокДиалога);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаказПокупателяОтборПоСтатусуЗавершениеВыбора(ПредставлениеСтатуса, Переменные) Экспорт

	Если ПредставлениеСтатуса = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЗаказПокупателяОтборПоСтатусу.Очистить();
	Для каждого КлючЗначение из ПредставлениеСтатуса Цикл
		Если КлючЗначение.Пометка Тогда
			ЗаказПокупателяОтборПоСтатусу.Добавить(КлючЗначение.Значение);
		КонецЕсли;
	КонецЦикла;
	
	УстановитьФильтрыСписка(Неопределено);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаказПокупателяОтборПоСтатусуОчистка(Элемент, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	ЗаказПокупателяОтборПоСтатусу.Очистить();
	УстановитьФильтрыСписка(Неопределено);
	Для каждого КлючЗначение из СписокСтатусовЗаказовПокупателей Цикл
		КлючЗначение.Пометка = Ложь;
	КонецЦикла;
	
КонецПроцедуры



