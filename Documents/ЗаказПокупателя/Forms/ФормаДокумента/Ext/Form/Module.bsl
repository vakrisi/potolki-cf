&НаСервере
Функция НастройкиФормы()
	
	НастройкиФормы = Новый Структура;
	//#14934
	НастройкиФормы.Вставить("РежимПодробнаяИнформацияПоТоварам", РежимПодробнаяИнформацияПоТоварам);
	
	Возврат НастройкиФормы;
	
КонецФункции

&НаСервере
Процедура УстановитьЗначенияПоНастройкамФормы();
	
	РежимПодробнаяИнформацияПоТоварам = Истина; // значение по умолчанию
	
	// Если есть сохраненные настройки, то установить значения по настройкам.
	Настройки = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить(КодФормы,  "");
	
	Если Настройки <> Неопределено Тогда
		
		//#14934
		Если Настройки.Свойство("РежимПодробнаяИнформацияПоТоварам") Тогда
			РежимПодробнаяИнформацияПоТоварам = Настройки.РежимПодробнаяИнформацияПоТоварам;
		КонецЕсли;
				
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура СохранитьНастройкиФормыНаСервере()
	
	НастройкиФормы = НастройкиФормы();
	ОбщегоНазначения.ХранилищеОбщихНастроекСохранить(КодФормы, "", НастройкиФормы);
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьОтображениеКолонокТоваров()
	
	МассивКолонок = Новый Массив;
	Если ТоварыКакДерево Тогда
		МассивКолонок.Добавить("ТоварыДеревоКОтгрузке");
		МассивКолонок.Добавить("ТоварыДеревоВРезервеПодДанныйЗаказ");
		МассивКолонок.Добавить("ТоварыДеревоОстатокНаСкладе");
		МассивКолонок.Добавить("ТоварыДеревоДоступноНаСкладе");
		МассивКолонок.Добавить("ТоварыДеревоДоступноКОтгрузке");
	Иначе                       		
		МассивКолонок.Добавить("ТоварыКОтгрузке");
		МассивКолонок.Добавить("ТоварыВРезервеПодДанныйЗаказ");
		МассивКолонок.Добавить("ТоварыОстатокНаСкладе");
		МассивКолонок.Добавить("ТоварыДоступноНаСкладе");
		МассивКолонок.Добавить("ТоварыДоступноКОтгрузке");
	КонецЕсли;
	
	Для каждого ИмяКолонки из МассивКолонок Цикл
		Элементы[ИмяКолонки].Видимость = РежимПодробнаяИнформацияПоТоварам;
		Элементы[ИмяКолонки].ЦветФона = WebЦвета.СеребристоСерый;
	КонецЦикла;
	
	Элементы.ТоварыСкрытьПодробнуюИнформациюПоТоварам.Пометка = НЕ РежимПодробнаяИнформацияПоТоварам;
	Элементы.ТоварыДеревоСкрытьПодробнуюИнформациюПоТоварам.Пометка = НЕ РежимПодробнаяИнформацияПоТоварам;
		
	Если НЕ РежимПодробнаяИнформацияПоТоварам Тогда		
		Элементы.ТоварыДеревоСкрытьПодробнуюИнформациюПоТоварам.ЦветФона = ЦветаСтиля.ЦветФонаПодсказки;
		Элементы.ТоварыСкрытьПодробнуюИнформациюПоТоварам.ЦветФона = ЦветаСтиля.ЦветФонаПодсказки;
	Иначе		
		Элементы.ТоварыДеревоСкрытьПодробнуюИнформациюПоТоварам.ЦветФона = Новый Цвет;
		Элементы.ТоварыСкрытьПодробнуюИнформациюПоТоварам.ЦветФона = Новый Цвет;
	КонецЕсли;
	
КонецПроцедуры

