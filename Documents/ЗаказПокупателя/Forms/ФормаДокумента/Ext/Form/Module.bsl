	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СправочникХарактеристикиНоменклатуры.Ссылка КАК ХарактеристикаНоменклатуры,
	|	ПРЕДСТАВЛЕНИЕ(СправочникХарактеристикиНоменклатуры.Ссылка) КАК ПредставлениеХарактеристикаНоменклатуры,
	|	ЕСТЬNULL(ТоварыНаСкладахОстатки.КоличествоОстаток, 0) - ЕСТЬNULL(ТоварыВРезервеНаСкладахОстатки.КоличествоОстаток, 0)КАК ОстатокНаСкладе
	|ИЗ
	|	Справочник.ХарактеристикиНоменклатуры КАК СправочникХарактеристикиНоменклатуры
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыНаСкладах.Остатки(
	|				,
	|				Номенклатура = &Номенклатура
	|					И Склад = &Склад
	|					И ВЫБОР
	|						КОГДА &ИспользуютсяОбщиеСклады
	|							ТОГДА ИСТИНА
	|						ИНАЧЕ Организация = &Организация
	|					КОНЕЦ) КАК ТоварыНаСкладахОстатки
	|		ПО СправочникХарактеристикиНоменклатуры.Владелец = ТоварыНаСкладахОстатки.Номенклатура
	|			И СправочникХарактеристикиНоменклатуры.Ссылка = ТоварыНаСкладахОстатки.ХарактеристикаНоменклатуры
	// #16738
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыВРезервеНаСкладах.Остатки(
	|				,
	|				Номенклатура = &Номенклатура
	|					И Склад = &Склад
	|					И ВЫБОР
	|						КОГДА &ИспользуютсяОбщиеСклады
	|							ТОГДА ИСТИНА
	|						ИНАЧЕ Организация = &Организация
	|					КОНЕЦ) КАК ТоварыВРезервеНаСкладахОстатки
	|		ПО СправочникХарактеристикиНоменклатуры.Владелец = ТоварыВРезервеНаСкладахОстатки.Номенклатура
	|			И СправочникХарактеристикиНоменклатуры.Ссылка = ТоварыВРезервеНаСкладахОстатки.ХарактеристикаНоменклатуры
	
	|ГДЕ
	|	СправочникХарактеристикиНоменклатуры.Владелец = &Номенклатура
	|	И НЕ СправочникХарактеристикиНоменклатуры.Архивная";
	
	Запрос.УстановитьПараметр("Номенклатура",			 Номенклатура);
	Запрос.УстановитьПараметр("Организация",			 Организация);
	Запрос.УстановитьПараметр("Склад",					 Склад);
	Запрос.УстановитьПараметр("ИспользуютсяОбщиеСклады", ИспользуютсяОбщиеСклады);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		ДанныеВыбора.Добавить(Выборка.ХарактеристикаНоменклатуры, 
							  Строка(Выборка.ПредставлениеХарактеристикаНоменклатуры) + " (остаток: " + Выборка.ОстатокНаСкладе + ")"); 		
	КонецЦикла;

	Возврат ДанныеВыбора;
	
КонецФункции

&НаКлиенте
Процедура ТоварыПотолокНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	СписокПродукции = Новый СписокЗначений;
	Для Каждого ТекущаяСтрока Из Объект.Товары Цикл
		Если ЭтоУникальнаяПродукцияСервер(ТекущаяСтрока.Номенклатура)	Тогда
			//Если ВыпущенныеПотолки.НайтиПоЗначению(ТекущаяСтрока.Номенклатура) = Неопределено Тогда
			Если НЕ ЕстьДокументВыпускаПоПродукции(ТекущаяСтрока.Номенклатура, ТекущаяСтрока.ХарактеристикаНоменклатуры) Тогда
				//показываем на выбор только не выпущенные потолки
				СтруктураПродукции = Новый Структура;
				СтруктураПродукции.Вставить("Номенклатура",ТекущаяСтрока.Номенклатура);
				СтруктураПродукции.Вставить("УИСтроки",ТекущаяСтрока.УИСтроки);
				СписокПродукции.Добавить(СтруктураПродукции);
			КонецЕсли;
		//#13063	
		ИначеЕсли ОбщийМодульВызовСервера.ЭтоНоменклатураПродукция(ТекущаяСтрока.Номенклатура) Тогда
			СтруктураПродукции = Новый Структура;
			СтруктураПродукции.Вставить("Номенклатура",ТекущаяСтрока.Номенклатура);
			СтруктураПродукции.Вставить("УИСтроки",ТекущаяСтрока.УИСтроки);
			СписокПродукции.Добавить(СтруктураПродукции);
		КонецЕсли;
	КонецЦикла;
	
	СписокПараметров = Новый Структура;
	СписокПараметров.Вставить("СписокПродукции", СписокПродукции); 
	
	ОткрытьФорму("Документ.ЗаказПокупателя.Форма.ФормаВыбораРодительскойНоменклатуры", СписокПараметров, ЭтаФорма, , , , Новый ОписаниеОповещения("ПослеВыбораРодительскойНоменклатуры", ЭтаФорма, Элементы.Товары.ТекущиеДанные), РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
 
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораРодительскойНоменклатуры(ВозвращенноеЗначение, СтрокаТоваров) Экспорт
	
	Если ВозвращенноеЗначение <> Неопределено Тогда
		
		СтрокаТоваров.Потолок = ВозвращенноеЗначение.Номенклатура;
		СтрокаТоваров.УИСтрокиРодителя = ВозвращенноеЗначение.УИСтроки;
		
	Иначе
		
		СтрокаТоваров.Потолок = "";
		СтрокаТоваров.УИСтрокиРодителя = "";
		
	КонецЕсли;
	
	Если ТоварыКакДерево Тогда
		ПеренестиДеревоВТабличнуюЧасть();
		ПостроитьДеревоНаФорме();
	КонецЕсли;	
	
	Модифицированность = Истина;
	
КонецПроцедуры

