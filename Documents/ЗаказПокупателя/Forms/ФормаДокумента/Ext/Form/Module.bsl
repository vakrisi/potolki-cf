		Если ТекущиеДанные.Потолок.Пустая() и ЭтоУникальнаяПродукцияКлиент(ТекущиеДанные.ВидНоменклатуры) Тогда			
			Отказ = Истина;
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	мСпецификация = ТекущиеДанные.Спецификация;
	мНоменклатура = ТекущиеДанные.Номенклатура;
	
