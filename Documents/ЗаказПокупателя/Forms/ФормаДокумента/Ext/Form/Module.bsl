&НаСервере
Функция ПроверитьСписокЗаказовПокупателейСЭтойПродукцией(НоменклатураПродукции)
	
	Если ТипЗнч(НоменклатураПродукции) = Тип("СправочникСсылка.Номенклатура") Тогда
		//Если Потолок.ВидНоменклатуры = Справочники.ВидыНоменклатуры.Потолок Тогда
		Если Справочники.ВидыНоменклатуры.ЭтоНоменклатураУникальногоПотолкаИлиОтреза(НоменклатураПродукции) 
			ИЛИ Справочники.ВидыНоменклатуры.ЭтоНоменклатураПродукцияУникальная(НоменклатураПродукции) Тогда //#12667 
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ЗаказПокупателяТовары.Ссылка
			|ИЗ
			|	Документ.ЗаказПокупателя.Товары КАК ЗаказПокупателяТовары
			|ГДЕ
			|	ЗаказПокупателяТовары.Номенклатура = &Номенклатура
			|	И НЕ ЗаказПокупателяТовары.Ссылка = &Ссылка
			|	И НЕ ЗаказПокупателяТовары.Ссылка.ПометкаУдаления
			|	И НЕ ЗаказПокупателяТовары.Ссылка.ТекущийСтатус = Значение(Справочник.СтатусыЗаказовПокупателей.Отменен)";			
			
			Запрос.УстановитьПараметр("Номенклатура", НоменклатураПродукции);
			Запрос.УстановитьПараметр("Ссылка", Объект.Ссылка);
			Выборка = Запрос.Выполнить().Выбрать();
			Пока Выборка.Следующий() Цикл
				Сообщить("Внимание! Данная позиция """ + НоменклатураПродукции + """ уже указана в документе " + Выборка.Ссылка + " Действие отменено.");
			КонецЦикла;
			
			Если Выборка.Количество() > 0 Тогда 
				Возврат Ложь;			
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

&НаСервере
Функция ПолучитьСтатусПроизводства(Номенклатура)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЗаказНаПроизводство.Ссылка КАК Ссылка,
	|	ВЫБОР
	|		КОГДА
	|   		ЗаказНаПроизводство.ВидЗаказа = Значение(Перечисление.ВидыЗаказовНаПроизводство.ЗаказНаПродажу)
	|		ТОГДА ""Перезаказ""
	|	ИНАЧЕ ЗаказНаПроизводство.ТекущийСтатус
	|	КОНЕЦ КАК ТекущийСтатус 
	|ИЗ
	|	Документ.ЗаказНаПроизводство КАК ЗаказНаПроизводство
	|ГДЕ
	|	ЗаказНаПроизводство.ПродукцияНоменклатура = &Номенклатура
	|	И ЗаказНаПроизводство.ДокументОснование = &ДокументОснование
	|	И ЗаказНаПроизводство.Проведен
	|
	|УПОРЯДОЧИТЬ ПО
	|	ЗаказНаПроизводство.Дата УБЫВ";
	
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("ДокументОснование", Объект.Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда 
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЗаказПоставщикуТовары.Ссылка,
		|	ЗаказПоставщикуТовары.Ссылка.ТекущийСтатус
		|ИЗ
		|	Документ.ЗаказПоставщику.Товары КАК ЗаказПоставщикуТовары
		|ГДЕ
		|	ЗаказПоставщикуТовары.Номенклатура = &Номенклатура
		|	И ЗаказПоставщикуТовары.Ссылка.Основание = &ДокументОснование
		|	И ЗаказПоставщикуТовары.Ссылка.Проведен";
		
		РезультатЗапроса = Запрос.Выполнить();
		Если РезультатЗапроса.Пустой() Тогда 
			Возврат Справочники.СтатусыЗаказовНаПроизводство.ПустаяСсылка();
		КонецЕсли;
	КонецЕсли;
	
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		Возврат Выборка.ТекущийСтатус;
	КонецЦикла;
	
КонецФункции

