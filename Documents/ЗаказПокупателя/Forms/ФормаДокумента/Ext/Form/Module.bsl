&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	// #13609
	//ДокументМодифицирован = ЗначениеЗаполнено(Объект.Ссылка) И Модифицированность;
	
	Если ТоварыКакДерево Тогда
		ПеренестиДеревоВТабличнуюЧасть();	
	КонецЕсли;
	
	Если ИзменяетсяСтатусНаОтменен()
		И ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
		ЕстьДокументыНаОсновании = ЕстьДокументыНаОсновании();
		Если ЕстьДокументыНаОсновании Тогда
			ТекстПредупреждения = "Документ переводится в статус ""Отменен"", при этом имеются проведенные документы, введенные на основании заказа.";
			//ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстПредупреждения);	
			//ПоказатьОповещениеПользователя(ТекстПредупреждения);
			ПоказатьПредупреждение(,ТекстПредупреждения);
		КонецЕсли;
	КонецЕсли;
	
	// №1083 очищаем таблицу выработки, если выключена галочка "Ручная корректировка"
	Если НЕ Объект.РучнаяКорректировкаВыработки Тогда
		Объект.Выработка.Очистить();
	КонецЕсли;
	
	//nva+++	
	Если Не ЗначениеЗаполнено(Объект.Склад) ИЛИ Не ЗначениеЗаполнено(Объект.СкладМатериалов) Тогда                                                
		Если Не ЗначениеЗаполнено(Объект.Склад) Тогда
			ИмяПоля = "Склад";
			ТекстСообщения = "Не заполнен " + ИмяПоля + "!";
			ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения, , ИмяПоля, "Объект." + ИмяПоля, Отказ);
		КонецЕсли;	
		Если Не ЗначениеЗаполнено(Объект.СкладМатериалов) И Объект.Материалы.Количество() > 0 Тогда
			ИмяПоля = "СкладМатериалов";
			ТекстСообщения = "Не заполнен " + ИмяПоля + "!";
			ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения, , ИмяПоля, "Объект." + ИмяПоля, Отказ);
		КонецЕсли;	
	КонецЕсли;
	
	Если Объект.ОтключитьОкруглениеСуммыЗаказа <> Истина И Объект.ТекущийСтатус <> ПредопределенноеЗначение("Справочник.СтатусыЗаказовПокупателей.Отменен") И 
		Объект.ТекущийСтатус <> ПредопределенноеЗначение("Справочник.СтатусыЗаказовПокупателей.Выполнен") И 
		Объект.ТекущийСтатус <> ПредопределенноеЗначение("Справочник.СтатусыЗаказовПокупателей.Закрыт") Тогда  
		СтруктураОкругления = Новый Структура("ВариантОкругления, ОкруглятьВБольшуюСторону, ПорядокОкругления, СпособОкругления",1, Истина, 1, 2);
		ОкруглитьСтоимостьНаСервере(СтруктураОкругления);
		ПостроитьДеревоНаФорме();
		ОбновитьДанныеДокумента();
		РазвернутьДеревоТоваров();
	КонецЕсли;
	ПредыдущийСтатусОбъект = ПолучитьСтатусДокументаОбъект(Объект.Ссылка);
	Если ПредыдущийСтатусОбъект = ПредопределенноеЗначение("Справочник.СтатусыЗаказовПокупателей.Новый") 
		И Объект.ТекущийСтатус <> ПредопределенноеЗначение("Справочник.СтатусыЗаказовПокупателей.Новый") 
		И Объект.ТекущийСтатус <> ПредопределенноеЗначение("Справочник.СтатусыЗаказовПокупателей.Отменен") Тогда
		//проверяем кредитные лимиты по контрагенту 
		КредитныйЛимит = ПолучитьКредитныйЛимитКонтрагента(Объект.Контрагент);
		Если КредитныйЛимит > 0 И НЕ РазрешеноПользователюПревышениеЛимита() Тогда
			ТекущийДолг = ПолучитьСтоимостьЗаказовВРаботе(Объект.Контрагент, Объект.Валюта, ТекущаяДата()) +    //nva
			ПолучитьТекущийДолгКлиента(Объект.Организация, Объект.Контрагент, Объект.ДоговорКонтрагента);
			Если ТекущийДолг + Объект.СуммаДокумента > КредитныйЛимит Тогда
				Отказ = Истина;
				Сообщ = Новый СообщениеПользователю;
				ОстатокЛимита = КредитныйЛимит - ТекущийДолг;
				Сообщ.Текст = "Сумма заказа: " + Объект.СуммаДокумента + " превышает кредитный лимит: " + КредитныйЛимит + ", остаток лимита: " + ОстатокЛимита;
				Сообщ.Сообщить();
			КонецЕсли;	
		КонецЕсли;	
	КонецЕсли;	
	//nva---
	
	Если НеВыполнятьПроверкуПередЗаписью Тогда
		НеВыполнятьПроверкуПередЗаписью = Ложь;
		Возврат;
	КонецЕсли;
	//nva+++
	//Если ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
		//ВыполнитьПроверкиИЗадатьВопросыПередЗаписью(Отказ, ПараметрыЗаписи);
		//так как у нас автоматическое создание резервов и отмена их, проверку не выполняем и вопросов не задаем
	//КонецЕсли;
	//nva---
	
	ОбщийМодульКлиент.ЗаписатьОбъектПриНеобходимости(ЭтотОбъект, ПараметрыЗаписи, Отказ);
	
КонецПроцедуры

