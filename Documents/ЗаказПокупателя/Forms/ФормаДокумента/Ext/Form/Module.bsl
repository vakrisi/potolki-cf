&НаКлиенте
Процедура ПодтверждениеОбновитьЗаказНаПроизводство(Результат, Параметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Нет Тогда
        Возврат;
    КонецЕсли;

    Успех = ПодтверждениеОбновитьЗаказНаПроизводствоНаСервере(Параметры);
	Если Успех Тогда
		//Состояние(" " + Параметры.Заказ + " обновлен");
		Сообщить("Обновлен " + Параметры.Заказ);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ПодтверждениеОбновитьЗаказНаПроизводствоНаСервере(Параметры) 
	
	ОписаниеОшибки = "";
	СтруктураПотолок = ОбменСEasyCeiling.ПолучитьСтруктуруПотолка(Параметры.Потолок,,,,,,, ОписаниеОшибки);
	Если СтруктураПотолок = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если ЗначениеЗаполнено(ОписаниеОшибки) Тогда
		Сообщить(ОписаниеОшибки);
		Возврат Неопределено;
	КонецЕсли;
	//СтруктураЗаказа = ОбменСEasyCeiling.ПолучитьСтруктуруЗаказа(СтруктураПотолок, Параметры.Заказ.НастройкаИнтеркампани, Параметры.Заказ.ВидЦен, Параметры.Заказ.Валюта, Параметры.Дата, Перечисления.ВидыЗаказов.ЗаказПокупателя,,, Объект.ДоговорКонтрагента);
	ДанныеЗаказа = ОбменСEasyCeiling.СтруктураДанныхЗаказа(Объект.Организация, Объект.Подразделение, Параметры.Заказ.НастройкаИнтеркампани,
							  				 Параметры.Заказ.ВидЦен, Параметры.Заказ.Валюта, Параметры.Заказ.Дата, , , Объект.ДоговорКонтрагента, Объект.ВнутреннийЗаказ);
	СтруктураЗаказа = ОбменСEasyCeiling.ПолучитьСтруктуруЗаказа(СтруктураПотолок, Перечисления.ВидыЗаказов.ЗаказПокупателя, ДанныеЗаказа);
		
	ДокЗаказ = Параметры.Заказ.ПолучитьОбъект();
	ДокЗаказ.ПродукцияНоменклатура = СтруктураЗаказа.ПродукцияНоменклатура;
	ДокЗаказ.ПродукцияНоменклатураКоличество = СтруктураЗаказа.Количество;
	ДокЗаказ.ПродукцияНоменклатураЕдиницаИзмерения = СтруктураЗаказа.ЕдиницаИзмерения;
	ДокЗаказ.ПродукцияНоменклатураКоэффициент = СтруктураЗаказа.Коэффициент;
	ДокЗаказ.ПродукцияЦена = СтруктураЗаказа.Цена;
	ДокЗаказ.ПродукцияСумма = СтруктураЗаказа.Сумма;
	ДокЗаказ.ПродукцияПроцентРучнойСкидки = 0;
	ДокЗаказ.ПродукцияСуммаРучнойСкидки = 0;
	
	ДокЗаказ.Услуги.Очистить();
	Для Каждого ТекущаяСтрока Из СтруктураЗаказа.Услуги Цикл
		НоваяСтрока = ДокЗаказ.Услуги.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущаяСтрока);
	КонецЦикла;
	
	ДокЗаказ.Товары.Очистить();
	Для Каждого ТекущаяСтрока Из СтруктураЗаказа.Товары Цикл
		НоваяСтрока = ДокЗаказ.Товары.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущаяСтрока);
	КонецЦикла;
	
	ДокЗаказ.Материалы.Очистить();
	Для Каждого ТекущаяСтрока Из СтруктураЗаказа.Материалы Цикл
		НоваяСтрока = ДокЗаказ.Материалы.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущаяСтрока);
	КонецЦикла;
	
	ДокЗаказ.СуммаДокумента = ДокЗаказ.ПродукцияСумма + ДокЗаказ.Товары.Итог("Сумма") + ДокЗаказ.Услуги.Итог("Сумма");
	ДокЗаказ.АдресМонтажа = СтруктураЗаказа.АдресМонтажа;
	
	Успех = Ложь;
	Попытка
		ДокЗаказ.Записать(РежимЗаписиДокумента.Проведение);
		Успех = Истина;
	Исключение
		Сообщить("Не удалось обновить " + ДокЗаказ.Ссылка + ". " + ОписаниеОшибки());
	КонецПопытки;
	
	Возврат Успех;
	
КонецФункции

&НаСервере
Функция ПолучитьСтруктуруЗаказаНаПроизводствоДляОбновленияНаСервере(Заказ, Потолок)
	
	СтруктураОтвета = Новый Структура;
	//Начало изменен при переходе на 2.0
	//СтруктураОтвета.Вставить("РазрешитьОбновлятьЗаказНаПроизводствоПриЗагрузкеИзИзиСилинг", Константы.РазрешитьОбновлятьЗаказНаПроизводствоПриЗагрузкеИзИзиСилинг.Получить());
	СтруктураОтвета.Вставить("РазрешитьОбновлятьПотолокЕслиОнРанееБылЗагружен", Константы.РазрешитьОбновлятьПотолокЕслиОнРанееБылЗагружен.Получить());
	//Конец изменен при переходе на 2.0
	СтруктураОтвета.Вставить("Заказ", Заказ);
	//Начало исключен при переходе на 2.0
	//СтруктураОтвета.Вставить("НеОбновлятьПриЗагрузкиИзПостроителя", Заказ.ТекущийСтатус.НеОбновлятьПриЗагрузкиИзПостроителя);
