&НаКлиенте
Процедура ЗаполнитьСтавкуНДСВТоварах()
	
	Если ТоварыКакДерево Тогда
		
		СтрокиПродукции = ТоварыДерево.ПолучитьЭлементы();
		Для Каждого СтрокаПродукции из СтрокиПродукции Цикл
			СтрокиТоваров = СтрокаПродукции.ПолучитьЭлементы();
			
			Если СтрокиТоваров.Количество() > 0 Тогда				
				Для Каждого СтрокаТабличнойЧасти Из СтрокиТоваров Цикл
					СтрокаТабличнойЧасти.СтавкаНДС = Объект.СтавкаНДС;
					ОбработкаТабличныхЧастейКлиентСервер.ПересчитатьСуммуНДСВСтрокеТЧ(СтрокаТабличнойЧасти, УчитыватьНДС);
				КонецЦикла;
			Иначе
				СтрокаПродукции.СтавкаНДС = Объект.СтавкаНДС;
				ОбработкаТабличныхЧастейКлиентСервер.ПересчитатьСуммуНДСВСтрокеТЧ(СтрокаПродукции, УчитыватьНДС);				
			КонецЕсли;
		КонецЦикла;
		
	Иначе
		Для каждого СтрокаТабличнойЧасти из Объект.Товары Цикл
			СтрокаТабличнойЧасти.СтавкаНДС = Объект.СтавкаНДС;
			ОбработкаТабличныхЧастейКлиентСервер.ПересчитатьСуммуНДСВСтрокеТЧ(СтрокаТабличнойЧасти, УчитыватьНДС);	
		КонецЦикла;
	КонецЕсли;
	
	Если ТоварыКакДерево Тогда		
		ПеренестиДеревоВТабличнуюЧасть();
	КонецЕсли;	
		
	РассчитатьИтоговыеПоказателиКлиент();
		
КонецПроцедуры
	
