		ЗаказНаПроизводство = ПредопределенноеЗначение("Документ.ЗаказНаПроизводство.ПустаяСсылка");
		
		//Если ТоварыКакДерево Тогда
		//	ПодчиненныеСтрокиУказатель = ТоварыДерево.НайтиПоИдентификатору(Элементы.ТоварыДерево.ТекущаяСтрока).ПолучитьРодителя();
		//	Если НЕ ПодчиненныеСтрокиУказатель = Неопределено Тогда
		//		ПодчиненныеСтроки = ПодчиненныеСтрокиУказатель.ПолучитьЭлементы();
		//		Для Каждого ТекСтрока Из ПодчиненныеСтроки Цикл
		//			Если ТекСтрока.УИСтроки = ТекущиеДанные.УИСтрокиРодителя Тогда
		//				ЗаказНаПроизводство = ТекСтрока.ЗаказНаПроизводство;
		//			КонецЕсли;
		//		КонецЦикла;
		//	КонецЕсли;
		//Иначе
		//	Отбор = Новый Структура;
		//	Отбор.Вставить("УИСтроки", ТекущиеДанные.УИСтрокиРодителя);
		//	НайденныеСтроки = Объект.Товары.НайтиСтроки(Отбор);
		//	Если НайденныеСтроки.Количество() > 0 Тогда
		//		ЗаказНаПроизводство = НайденныеСтроки[0].ЗаказНаПроизводство;
		//	КонецЕсли;
		//КонецЕсли;
		СтрокаТЧ = НайтиСтрокуПродукцииПоУИС(ТекущиеДанные.УИСтрокиРодителя);
		Если НЕ СтрокаТЧ = Неопределено Тогда
			ЗаказНаПроизводство = СтрокаТЧ.ЗаказНаПроизводство;	
		КонецЕсли;	
			
		Если ЗначениеЗаполнено(ЗаказНаПроизводство) Тогда
			Если ТекущийСтатусЗаказаНаПроизводствоПроизведен(ЗаказНаПроизводство) Тогда
				//есть выпуск, запрещаем редактировать количество и ед изм
				
				// №6277, если это НЕ: Потолок, Отрез, Типовой отрез, услуга - изменение разрешаем
				Если ЭтоУникальнаяПродукцияКлиент(ТекущиеДанные.ВидНоменклатуры) ИЛИ ЭтоУслугаКлиент(ТекущиеДанные.ВидНоменклатуры) Тогда
					
					Если ЗапрещенноеДляРедактированияИмяКолонки(ЭлементТовары.ТекущийЭлемент.Имя) Тогда
						Если (ЭлементТовары.ТекущийЭлемент.Имя = "ТоварыНоменклатура"
							ИЛИ ЭлементТовары.ТекущийЭлемент.Имя =  "ТоварыДеревоНоменклатура") 
							И ЗначениеЗаполнено(мНоменклатура) Тогда
							ПоказатьЗначение(, мНоменклатура);
						КонецЕсли;
						Отказ = Истина;
						Возврат;
					КонецЕсли;
					
					ТекстВопроса = "По " + ТекущиеДанные.Потолок + " указан " + ЗаказНаПроизводство + ", который находится в статусе ""Произведен"". Продолжить?";
					ЗадатьВопросПередИзменениемСтроки(Отказ, Элемент, ТекстВопроса);
					
				КонецЕсли;
				
			Иначе
				
				// №6277, если это НЕ: Потолок, Отрез, Типовой отрез, услуга - изменение разрешаем
