&НаКлиенте
Процедура МатериалыНоменклатураПриИзменении(Элемент)
	
	СтрокаТабличнойЧасти = Элементы.Материалы.ТекущиеДанные;
	
	Если СтрокаТабличнойЧасти = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СтрокаТабличнойЧасти.ЕдиницаИзмерения = ОбщийМодульВызовСервера.ПолучитьБазовуюЕдиницуИзмеренияНоменклатуры(СтрокаТабличнойЧасти.Номенклатура);
	СтрокаТабличнойЧасти.Коэффициент = 1;
	СтрокаТабличнойЧасти.Количество = 1;
	
	СтрокаТабличнойЧасти.КоличествоКВыработке = СтрокаТабличнойЧасти.Количество; // №14311
		
КонецПроцедуры

&НаКлиенте
Процедура МатериалыЕдиницаИзмеренияПриИзменении(Элемент)
	
	СтрокаТабличнойЧасти = Элементы.Материалы.ТекущиеДанные;
	
	Если СтрокаТабличнойЧасти = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(СтрокаТабличнойЧасти.ЕдиницаИзмерения) = Тип("СправочникСсылка.КлассификаторЕдиницИзмерения") Тогда
		СтрокаТабличнойЧасти.Коэффициент = 1;
	Иначе
		СтрокаТабличнойЧасти.Коэффициент = ОбщийМодуль.ПолучитьКоэффициентЕдиницыИзмерения(СтрокаТабличнойЧасти.ЕдиницаИзмерения);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьМатериалыПоПотолкам(Команда)
	
	МассивПотолковЗаказа = ПолучитьУникальныеПотолкиОтрезыЗаказа();
	Если МассивПотолковЗаказа.Количество() = 0 Тогда
		ПоказатьПредупреждение(,"В товарах заказа отсутствуют потолки");
		Возврат;
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура("МассивПотолковЗаказа", МассивПотолковЗаказа);
	Оповещение = Новый ОписаниеОповещения("ПослеВопросаОЗаполненииМатериаловПоПотокам", ЭтаФорма, ДополнительныеПараметры);
	ПоказатьВопрос(Оповещение, НСтр("ru = 'Заполнить материалы по потолкам в товарах?'"), РежимДиалогаВопрос.ДаНет, 0);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВопросаОЗаполненииМатериаловПоПотокам(Результат, ДополнительныеПараметры) Экспорт
	
    Если Результат = КодВозвратаДиалога.Нет Тогда
        Возврат;
    КонецЕсли;

    Для Каждого Потолок Из ДополнительныеПараметры.МассивПотолковЗаказа Цикл
		ЗаполнитьМатериалыПоПотолкамНаСервере(Потолок.Номенклатура, Потолок.УИСтроки);				
	КонецЦикла;
	ЗаполнитьДанныеОстаткиПоМатериалам(); //2022-05-23

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьМатериалыПоПотолкамНаСервере(НоменклатураПотолка, УИСтроки)
	
	ОписаниеОшибки = "";
	СтруктураПотолок = ОбменСEasyCeiling.ПолучитьСтруктуруПотолка(НоменклатураПотолка,,,,,,, ОписаниеОшибки); 
	Если СтруктураПотолок = Неопределено ИЛИ ЗначениеЗаполнено(ОписаниеОшибки) Тогда
		Возврат;
	КонецЕсли;
	СтруктураПотолок.Вставить("Организация", Объект.Организация);
	СтруктураПотолок.Вставить("Контрагент",  Объект.Контрагент);
	
	//СтруктураЗаказа = ОбменСEasyCeiling.ПолучитьСтруктуруЗаказа(СтруктураПотолок,, Объект.ВидЦен, Объект.Валюта, Объект.Дата, Перечисления.ВидыЗаказов.ЗаказПокупателя,УчитыватьНДС,,Объект.ДоговорКонтрагента);
	ДанныеЗаказа = ОбменСEasyCeiling.СтруктураДанныхЗаказа(Объект.Организация, Объект.Подразделение, ,
							  				 Объект.ВидЦен, Объект.Валюта, Объект.Дата, УчитыватьНДС, , Объект.ДоговорКонтрагента, Объект.ВнутреннийЗаказ);
	СтруктураЗаказа = ОбменСEasyCeiling.ПолучитьСтруктуруЗаказа(СтруктураПотолок, Перечисления.ВидыЗаказов.ЗаказПокупателя, ДанныеЗаказа);
	
	Для Каждого СтрокаМатериалов Из СтруктураЗаказа.Материалы Цикл	
		ОбработкаТабличныхЧастейСервер.ДобавитьОбновитьСтрокуВТЧЗаказПокупателя(Объект.Материалы, СтрокаМатериалов, Новый Структура("Потолок, УИСтроки", НоменклатураПотолка, УИСтроки));		
	КонецЦикла;
	
КонецПроцедуры
 
&НаСервере
Функция ПолучитьУникальныеПотолкиОтрезыЗаказа()
	
	МассивПотолковЗаказа = Новый Массив;
	Для Каждого ТекущаяСтрока Из Объект.Товары Цикл
		Если Справочники.ВидыНоменклатуры.ЭтоНоменклатураУникальногоПотолкаИлиОтреза(ТекущаяСтрока.Номенклатура) Тогда
			// №7545 добавлено количество
			МассивПотолковЗаказа.Добавить(Новый Структура("Номенклатура, УИСтроки, Количество", ТекущаяСтрока.Номенклатура, ТекущаяСтрока.УИСтроки, ТекущаяСтрока.Количество));
		КонецЕсли;
	КонецЦикла;	
	
	Возврат МассивПотолковЗаказа;
	
КонецФункции

&НаКлиенте
Процедура ТоварыСпецификацияПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.Товары.ТекущиеДанные;
	
	//Если очистили спецификацию, предложим удалить материалы
	Если мСпецификация <> Неопределено И НЕ мСпецификация.Пустая()
		И ТекущиеДанные.Спецификация.Пустая()
		И ЕстьМатериалыПоТекущейПозиции(ТекущиеДанные.Номенклатура, ТекущиеДанные.УИСтроки) Тогда
		
		//ЗадатьВопросОбУдаленииМатериаловПоПозиции(ТекущиеДанные.Номенклатура, ТекущиеДанные.УИСтроки); - решили не справшивать, а сразу удалять
		УдалитьМатериалыОтносящиесяКПозицииНаСервере(ТекущиеДанные.Номенклатура, ТекущиеДанные.УИСтроки);
		
	ИначеЕсли НЕ ТекущиеДанные.Спецификация.Пустая() Тогда		
		
		ЗадатьВопросОПерезаполненииМатериловПоСпецификации(ТекущиеДанные.Номенклатура, ТекущиеДанные.УИСтроки);	
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ЕстьМатериалыПоТекущейПозиции(Номенклатура, УИСтроки)
	
	Есть = Ложь;
	
	Для Каждого	ТекущаяСтрока Из Объект.Материалы Цикл
		Если ТекущаяСтрока.Потолок = Номенклатура И ТекущаяСтрока.УИСтроки = УИСтроки Тогда
			Есть = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;		
		
	Возврат Есть;	
	
КонецФункции

&НаКлиенте
Процедура ЗадатьВопросОбУдаленииМатериаловПоПозиции(Номенклатура, УИСтроки)
	
	Парам = Новый Структура;
	Парам.Вставить("Номенклатура", Номенклатура);
	Парам.Вставить("УИСтроки", УИСтроки);
	
	ПослеВопросаОбУдаленииМатериаловПоПозиции = Новый ОписаниеОповещения("ОбработкаОтветаНаВопросУдаленияМатериаловПоПозиции", ЭтотОбъект, Парам);
	ПоказатьВопрос(ПослеВопросаОбУдаленииМатериаловПоПозиции, "Удалить из документа все материалы, относящиеся к данной позиции?", РежимДиалогаВопрос.ДаНет);	
	
КонецПроцедуры	

