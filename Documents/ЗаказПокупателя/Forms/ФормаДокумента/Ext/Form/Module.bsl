&НаСервере
Процедура ЗаполнитьМатериалыОтрезаНаСервере(НоменклатураПродукции, УИСтроки)
	
	ОписаниеОшибки = "";
	СтруктураОтреза = ОбменСEasyCeiling.ПолучитьСтруктуруПотолка(НоменклатураПродукции,,,,,,, ОписаниеОшибки);
	
	Если СтруктураОтреза <> Неопределено И Не ЗначениеЗаполнено(ОписаниеОшибки) Тогда
		
		//СтруктураЗаказа = ОбменСEasyCeiling.ПолучитьСтруктуруЗаказа(СтруктураОтреза, Объект.НастройкаИнтеркампани, Объект.ВидЦен, Объект.Валюта, Объект.Дата, ПредопределенноеЗначение("Перечисление.ВидыЗаказов.ЗаказПокупателя"),,,Объект.ДоговорКонтрагента);
		ДанныеЗаказа = ОбменСEasyCeiling.СтруктураДанныхЗаказа(Объект.Организация, Объект.Подразделение, Объект.НастройкаИнтеркампани,
							  				 Объект.ВидЦен, Объект.Валюта, Объект.Дата, , , Объект.ДоговорКонтрагента, Объект.ВнутреннийЗаказ);
		СтруктураЗаказа = ОбменСEasyCeiling.ПолучитьСтруктуруЗаказа(СтруктураОтреза, ПредопределенноеЗначение("Перечисление.ВидыЗаказов.ЗаказПокупателя"), ДанныеЗаказа);
		
		//#11670 убрано ниже
		//Для Каждого ТекущийМатериал Из СтруктураЗаказа.Материалы Цикл
		//	НоваяСтрокаМатериал = Объект.Материалы.Добавить();
		//	ЗаполнитьЗначенияСвойств(НоваяСтрокаМатериал, ТекущийМатериал);
		//	НоваяСтрокаМатериал.Потолок = НоменклатураОтреза;
		//	НоваяСтрокаМатериал.УИСтроки = УИСтроки;
		//КонецЦикла;
		
		//#11670 обработка по расширенным правилам
		Для Каждого ТекущаяСтрока Из СтруктураЗаказа.Товары Цикл
			
			Если НЕ ТекущаяСтрока.РасширеннаяОбработка Тогда
				Продолжить;
			КонецЕсли;
			
			НоваяСтрока = Объект.Товары.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущаяСтрока);
			НоваяСтрока.Потолок = НоменклатураПродукции;
			НоваяСтрока.УИСтроки = УИСтроки;
			
			//++ №13815 для услуг заполняем количество к выработке
			// №14311 Если ЭтоУслуга(НоваяСтрока.Номенклатура) Тогда
				НоваяСтрока.КоличествоКВыработке = НоваяСтрока.Количество;
			//КонецЕсли;
			//-- №13815
			
		КонецЦикла;
		
		Для Каждого ТекущаяСтрока Из СтруктураЗаказа.Услуги Цикл
			
			Если НЕ ТекущаяСтрока.РасширеннаяОбработка Тогда
				Продолжить;
			КонецЕсли;
			
			НоваяСтрока = Объект.Товары.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущаяСтрока);
			НоваяСтрока.Потолок = НоменклатураПродукции;
			НоваяСтрока.УИСтроки = УИСтроки;
			
			//++ №13815 для услуг заполняем количество к выработке
			// №14311 Если ЭтоУслуга(НоваяСтрока.Номенклатура) Тогда
				НоваяСтрока.КоличествоКВыработке = НоваяСтрока.Количество;
			//КонецЕсли;
			//-- №13815
			
		КонецЦикла;
		
		Для Каждого ТекущаяСтрока Из СтруктураЗаказа.Материалы Цикл
			
			// грузим все материалы
			//Если НЕ ТекущаяСтрока.РасширеннаяОбработка Тогда
			//	Продолжить;
			//КонецЕсли;
			
			НоваяСтрока = Объект.Материалы.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущаяСтрока);
			
			НоваяСтрока.Потолок = НоменклатураПродукции;
			НоваяСтрока.УИСтроки = УИСтроки;
			
			НоваяСтрока.КоличествоКВыработке = НоваяСтрока.Количество * НоваяСтрока.Коэффициент; // №14311 // #16594 добавлен " * НоваяСтрока.Коэффициент"
			
		КонецЦикла;

		
	ИначеЕсли ЗначениеЗаполнено(ОписаниеОшибки) Тогда
		Сообщить(ОписаниеОшибки);
	КонецЕсли;	
	
КонецПроцедуры	
