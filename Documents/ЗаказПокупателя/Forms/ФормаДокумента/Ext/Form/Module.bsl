Процедура ОкруглитьТекущуюСтроку(Номенклатура, ЕдиницаИзмерения)
	
ТаблицаТоваров = Новый ТаблицаЗначений;
ТаблицаТоваров.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
ТаблицаТоваров.Колонки.Добавить("ЕдиницаИзмерения", Новый ОписаниеТипов("СправочникСсылка.КлассификаторЕдиницИзмерения"));
НоваяСтрока = ТаблицаТоваров.Добавить();
НоваяСтрока.Номенклатура = Номенклатура;
НоваяСтрока.ЕдиницаИзмерения = ЕдиницаИзмерения;


Запрос = Новый Запрос;
Запрос.УстановитьПараметр("ТаблицаТоваров", ТаблицаТоваров);
Запрос.Текст = 
"ВЫБРАТЬ
|	доп_ПараметрыОкругленияЕдиницИзмерения.Номенклатура КАК Номенклатура,
|	доп_ПараметрыОкругленияЕдиницИзмерения.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
|	доп_ПараметрыОкругленияЕдиницИзмерения.ПорогСрабатывания КАК ПорогСрабатывания,
|	доп_ПараметрыОкругленияЕдиницИзмерения.ЗначениеУстановки КАК ЗначениеУстановки,
|	доп_ПараметрыОкругленияЕдиницИзмерения.МинимальнаяЦена КАК МинимальнаяЦена
|ПОМЕСТИТЬ ВТ_Параметры
|ИЗ
|	РегистрСведений.доп_ПараметрыОкругленияЕдиницИзмерения КАК доп_ПараметрыОкругленияЕдиницИзмерения
|;
|
|////////////////////////////////////////////////////////////////////////////////
|ВЫБРАТЬ
|	ТаблицаТоваров.Номенклатура КАК Номенклатура,
|	ТаблицаТоваров.ЕдиницаИзмерения КАК ЕдиницаИзмерения
|ПОМЕСТИТЬ ВТ_Товары
|ИЗ
|	&ТаблицаТоваров КАК ТаблицаТоваров
|;
|
|////////////////////////////////////////////////////////////////////////////////
|ВЫБРАТЬ
|	ВТ_Товары.Номенклатура КАК Номенклатура,
|	ЕСТЬNULL(ВТ_Параметры.ПорогСрабатывания, 0) КАК ПорогСрабатывания,
|	ЕСТЬNULL(ВТ_Параметры.ЗначениеУстановки, 0) КАК ЗначениеУстановки,
|	ЕСТЬNULL(ВТ_Товары.ЕдиницаИзмерения, ЗНАЧЕНИЕ(Справочник.КлассификаторЕдиницИзмерения.ПустаяСсылка)) КАК ЕдиницаИзмерения,
|	ЕСТЬNULL(ВТ_Параметры.МинимальнаяЦена, 0) КАК МинЦена
|ИЗ
|	ВТ_Товары КАК ВТ_Товары
|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Параметры КАК ВТ_Параметры
|		ПО ВТ_Товары.ЕдиницаИзмерения = ВТ_Параметры.ЕдиницаИзмерения
|ГДЕ
|	ВТ_Товары.Номенклатура В ИЕРАРХИИ
|			(ВЫБРАТЬ
|				ВТ_Параметры.Номенклатура
|			ИЗ
|				ВТ_Параметры)";
Выборка = Запрос.Выполнить().Выбрать();

Пока Выборка.Следующий() Цикл
	
	Отбор = Новый Структура;
	Отбор.Вставить("Номенклатура", Выборка.Номенклатура);
	Отбор.Вставить("ЕдиницаИзмерения", Выборка.ЕдиницаИзмерения);
	НайденныеСтроки = Объект.Товары.НайтиСтроки(Отбор);
	
	Если НайденныеСтроки.Количество() > 0 Тогда 
		Для каждого НСтрока из НайденныеСтроки Цикл
			
			Если Выборка.ПорогСрабатывания > НСтрока.Количество Тогда 
				НСтрока.Количество = Выборка.ЗначениеУстановки;
			КонецЕсли;
			
			Если Выборка.МинЦена > НСтрока.Цена Тогда 
				НСтрока.Цена = Выборка.МинЦена;
			КонецЕсли;

			
		КонецЦикла;
	КонецЕсли;
	
КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура РегистрацияИзменений(Команда)
	Если Объект.Ссылка = Неопределено Тогда
		Объект.Ссылка = ЭтаФорма.Ссылка;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Сообщ = Новый СообщениеПользователю;
		Сообщ.Текст = "Объект не записан, сначала запишите объект, а потом повторите текущее действие.";
		НСтр("RU = 'Объект не записан, сначала запишите объект, а потом повторите текущее действие'; de = 'Das Objekt wird nicht aufgezeichnet, das Objekt zuerst speichern und dann die aktuelle Aktion wiederholen'");
		Сообщ.Сообщить();
		Возврат;
	КонецЕсли;
		
	ФормаОтчета = ПолучитьФорму("Отчет.Лен_ХронологияИзмененияРеквизитовУправл.Форма.ФормаОтчета1");	
	Отчет1 = ФормаОтчета.Отчет;	
	Отчет1.АнализируемыйОбъект = Объект.Ссылка;	
	Отчет1.АтоматическийРежим = Истина;	
	ФормаОтчета.Открыть();     
	
	//Никифоров
	ФормаОтчета.СформироватьОтчетИзОбъекта(ФормаОтчета.Результат, ФормаОтчета.ДанныеРасшифровки);
КонецПроцедуры

&НаКлиенте
Процедура СоздатьПКО(Команда)
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Заказ", 			Объект.Ссылка);
	ПараметрыФормы.Вставить("Сумма", 			Объект.СуммаДокумента);

	ОповещениеОЗакрытии = Новый ОписаниеОповещения("ПослеСозданияПКООповещения", ЭтаФорма);
	ОткрытьФорму("Документ.ЗаказПокупателя.Форма.ФормаОплатыЗаказа",ПараметрыФормы,ЭтаФорма,,ВариантОткрытияОкна.ОтдельноеОкно,,ОповещениеОЗакрытии);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеСозданияПКООповещения(ВозвращенноеЗначение, ДопПараметры) Экспорт
	
	Если ВозвращенноеЗначение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(ВозвращенноеЗначение) = Тип("СправочникСсылка.СпособыОплатыЗаказа") Тогда
		Если Объект.СпособОплаты <> ВозвращенноеЗначение Тогда
			Объект.СпособОплаты = ВозвращенноеЗначение;
			Записать();
		КонецЕсли;	
	КонецЕсли;
	
КонецПроцедуры
