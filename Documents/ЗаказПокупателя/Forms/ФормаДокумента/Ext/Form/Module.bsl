Процедура ЗадатьВопросОПерезаполненииМатериловПоСпецификации(Номенклатура = Неопределено, УИСтроки = Неопределено, МассивНоменклатур = Неопределено)
	
	Парам = Новый Структура;	
	Парам.Вставить("Номенклатура", Номенклатура);
	Парам.Вставить("УИСтроки", УИСтроки);
	Парам.Вставить("МассивНоменклатур", МассивНоменклатур);	
	
	ПослеВопросаОПерезаполненииМатериаловПоСпецификаци = Новый ОписаниеОповещения("ОбработкаОтветаНаВопросПерезаполненииМатериаловПоСпецификации", ЭтотОбъект, Парам);
	ПоказатьВопрос(ПослеВопросаОПерезаполненииМатериаловПоСпецификаци, "Перезаполнить материалы по спецификации текущей позиции?", РежимДиалогаВопрос.ДаНет);	
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОтветаНаВопросПерезаполненииМатериаловПоСпецификации(Результат, ДопПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		ОбработкаОтветаНаВопросПерезаполненииМатериаловПоСпецификацииНаСервере(ДопПараметры);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаОтветаНаВопросПерезаполненииМатериаловПоСпецификацииНаСервере(ДопПараметры)
	
	Если ДопПараметры.МассивНоменклатур = Неопределено Тогда		
		//Сначало удалим
		УдалитьМатериалыОтносящиесяКПозицииНаСервере(ДопПараметры.Номенклатура, ДопПараметры.УИСтроки);
		
		ТаблицаПродукции = Новый ТаблицаЗначений;
		ТаблицаПродукции.Колонки.Добавить("Потолок");
		ТаблицаПродукции.Колонки.Добавить("УИСтроки");		
	
		НоваяСтрока = ТаблицаПродукции.Добавить();
		НоваяСтрока.Потолок = ДопПараметры.Номенклатура;
		НоваяСтрока.УИСтроки = ДопПараметры.УИСтроки;
	Иначе
		ТаблицаПродукции = ДопПараметры.МассивНоменклатур;
	КонецЕсли;	
	
	//Теперь заполним		
	ЗаполнитьМатериалыПоСпецификациямНаСервере(ТаблицаПродукции, Ложь);	
	
КонецПроцедуры

&НаСервере
Процедура ПеренестиДеревоВТабличнуюЧасть()
	
	СуммаДокумента = 0;
	Объект.Товары.Очистить();
	Дерево = ДанныеФормыВЗначение(ТоварыДерево, Тип("ДеревоЗначений"));
	Для Каждого Строка из Дерево.Строки Цикл
		//Если НЕ Справочники.ВидыНоменклатуры.ЭтоНоменклатураПотолкаИлиОтреза(Строка.Номенклатура) Тогда
		Если НЕ ПустаяСтрока(Строка.УИСтрокиРодителя) Тогда
			НоваяСтрокаДокумента = Объект.Товары.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрокаДокумента, Строка, , "НомерСтроки");
			Если ПустаяСтрока(НоваяСтрокаДокумента.УИСтроки) Тогда
				НоваяСтрокаДокумента.УИСтроки = новый УникальныйИдентификатор;
			КонецЕсли;
			СуммаДокумента = СуммаДокумента + НоваяСтрокаДокумента.Сумма;
		КонецЕсли;
		
		Для Каждого СтрНоменклатура из Строка.Строки Цикл
			НоваяСтрокаДокумента = Объект.Товары.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрокаДокумента, СтрНоменклатура, , "НомерСтроки");
			Если ПустаяСтрока(НоваяСтрокаДокумента.УИСтроки) Тогда
				НоваяСтрокаДокумента.УИСтроки = новый УникальныйИдентификатор;
			КонецЕсли;
			СуммаДокумента = СуммаДокумента + НоваяСтрокаДокумента.Сумма;
		КонецЦикла;	
		
	КонецЦикла;
	Объект.СуммаДокумента = СуммаДокумента;
	
	ПерезаполнитьНомераПотолковПоДеревуНаСервере();
	
КонецПроцедуры

&НаСервере
Функция ПолучитьУказательНаСтрокуСПотолком(Дерево, Потолок, УИСтрокиРодителя)
	
	Если Потолок = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
		
	Для Каждого СтрокаДерева Из Дерево.Строки Цикл
		Если СтрокаДерева.Номенклатура = Потолок
			И СтрокаДерева.УИСтроки = УИСтрокиРодителя
			Тогда
			Возврат СтрокаДерева;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции

&НаСервере
Процедура ПостроитьДеревоНаФорме()
	
	Если НЕ ТоварыКакДерево Тогда
		Возврат;
	КонецЕсли;
	
	Дерево = ДанныеФормыВЗначение(ТоварыДерево, Тип("ДеревоЗначений"));
	Дерево.Строки.Очистить();
	
	Для Каждого ТекущаяСтрока Из Объект.Товары Цикл
		Если ТекущаяСтрока.Потолок.Пустая() И Справочники.ВидыНоменклатуры.ЭтоНоменклатураПотолкаИлиОтреза(ТекущаяСтрока.Номенклатура) Тогда
			ТекущаяСтрока.Потолок = ТекущаяСтрока.Номенклатура;
		КонецЕсли;
	КонецЦикла;
	
	//добавляем независимые позиции и потолки в корень
	Для Каждого ТекущаяСтрокаДокумента Из Объект.Товары Цикл
		Если Справочники.ВидыНоменклатуры.ЭтоНоменклатураПотолкаИлиОтреза(ТекущаяСтрокаДокумента.Номенклатура) 
			ИЛИ Справочники.ВидыНоменклатуры.ЭтоНоменклатураПродукция(ТекущаяСтрокаДокумента.Номенклатура) Тогда //#13145
			// это продукция
			СтрокаПродукции = Дерево.Строки.Добавить();
			СтрокаПродукции.Номенклатура = ТекущаяСтрокаДокумента.Номенклатура;
			СтрокаПродукции.Количество = ТекущаяСтрокаДокумента.Количество;
			СтрокаПродукции.ЕдиницаИзмерения = ТекущаяСтрокаДокумента.ЕдиницаИзмерения;
			СтрокаПродукции.Коэффициент = ТекущаяСтрокаДокумента.Коэффициент;
			СтрокаПродукции.УИСтроки = ТекущаяСтрокаДокумента.УИСтроки;
			Если ПустаяСтрока(СтрокаПродукции.УИСтроки) Тогда
				СтрокаПродукции.УИСтроки = новый УникальныйИдентификатор;
			КонецЕсли;
			СтрокаПродукции.Сумма = ТекущаяСтрокаДокумента.Сумма;
			
			// добавим эту продукцию в подчинение корневой продукции
			НоваяПодчиненнаяСтрока = СтрокаПродукции.Строки.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяПодчиненнаяСтрока, ТекущаяСтрокаДокумента);
			НоваяПодчиненнаяСтрока.УИСтрокиРодителя = ТекущаяСтрокаДокумента.УИСтроки;			
			
		ИначеЕсли ПустаяСтрока(ТекущаяСтрокаДокумента.УИСтрокиРодителя) ИЛИ ТекущаяСтрокаДокумента.УИСтрокиРодителя = ТекущаяСтрокаДокумента.УИСтроки Тогда
			//это товар или услуга, не подчиненная никому
			НоваяСтрокаДерева = Дерево.Строки.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрокаДерева, ТекущаяСтрокаДокумента);
			Если ПустаяСтрока(НоваяСтрокаДерева.УИСтроки) Тогда
				НоваяСтрокаДерева.УИСтроки = новый УникальныйИдентификатор;
			КонецЕсли;
			НоваяСтрокаДерева.УИСтрокиРодителя = НоваяСтрокаДерева.УИСтроки; //подчиняем такую строку саму себе
			
		КонецЕсли;
	КонецЦикла;
	
	// добавляем зависимые позиции в подчиненные строки второго уровня
	Для Каждого ТекущаяСтрокаДокумента Из Объект.Товары Цикл
