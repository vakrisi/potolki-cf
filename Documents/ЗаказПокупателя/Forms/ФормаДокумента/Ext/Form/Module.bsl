&НаКлиентеНаСервереБезКонтекста
Процедура РассчитатьИтоговыеПоказатели(ТаблицаТоваров, ИтогСумма, ИтогСуммаНДС, ИтогПериметрПомещения, ИтогСуммаДокументаБезУчетаБонусов)

	ИтогСумма = 0;
	ИтогСуммаНДС = 0;
	ИтогПериметрПомещения = 0;
	ИтогСуммаДокументаБезУчетаБонусов = 0;
	
	Для каждого СтрокаТабличнойЧасти из ТаблицаТоваров Цикл
		ИтогСумма = ИтогСумма + СтрокаТабличнойЧасти.Сумма;
		ИтогСуммаНДС = ИтогСуммаНДС + СтрокаТабличнойЧасти.СуммаНДС;
		ИтогПериметрПомещения = ИтогПериметрПомещения + СтрокаТабличнойЧасти.ПериметрПомещения;
		
		ИтогСуммаДокументаБезУчетаБонусов = ИтогСуммаДокументаБезУчетаБонусов + (СтрокаТабличнойЧасти.Количество * СтрокаТабличнойЧасти.Цена - СтрокаТабличнойЧасти.СуммаРучнойСкидки);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыДеревоИтоговыеПоказателиКлиент() 
		
	ИтогСумма = 0;
	
	ЭлементыДерева = ТоварыДерево.ПолучитьЭлементы();
	ИтогКоличествоКомнат = ЭлементыДерева.Количество();
	
	Для Каждого СтрокаПродукции из ЭлементыДерева Цикл		
		
		СуммаПоПродукции = 0;
		
		КоличествоПодчиненных = СтрокаПродукции.ПолучитьЭлементы();
		Если КоличествоПодчиненных.Количество() = 0 Тогда
			ИтогСумма = ИтогСумма + СтрокаПродукции.Сумма;
		Иначе
			Для Каждого СтрокаТовара Из СтрокаПродукции.ПолучитьЭлементы() Цикл
				ИтогСумма = ИтогСумма + СтрокаТовара.Сумма;			
				СуммаПоПродукции = СуммаПоПродукции + СтрокаТовара.Сумма;
			КонецЦикла;
			//++ №14183 Сумму продукции итоговую ставим только у потолков, отрезов, конструкций
			//СтрокаПродукции.Сумма = СуммаПоПродукции;
			Если ЭтоНоменклатураПотолкаИлиОтрезаИлиПродукции(СтрокаПродукции.ВидНоменклатуры) Тогда
				СтрокаПродукции.Сумма = СуммаПоПродукции;
			Иначе
				ИтогСумма = ИтогСумма + СтрокаПродукции.Сумма;
			КонецЕсли;
			//-- №14183
		КонецЕсли;
	КонецЦикла;
		
	Если Объект.СуммаДокумента <> ИтогСумма Тогда 
		Объект.СуммаДокумента = ИтогСумма;
	КонецЕсли;
		
КонецПроцедуры

&НаСервере
Процедура ОпределитьВидимостьТаблицыВыработкиИРассчитатьИтог() Экспорт
	
	// №1083 видимость определенных таблиц по выработке
	ОбщийМодульСервер.ОпределитьВидимостьТаблицыВыработкиИРассчитатьИтог(ЭтаФорма);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьРеквизитыНоменклатурыТовара()
	
	ТаблицаТоваров = Новый ТаблицаЗначений;
	ТаблицаТоваров.Колонки.Добавить("НомерСтроки", Новый ОписаниеТипов("Число"));
	ТаблицаТоваров.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	
	Если НЕ ТоварыКакДерево Тогда
		ТаблицаТоваров = Объект.Товары.Выгрузить(, "НомерСтроки, Номенклатура");	
	Иначе
	    СтрокиПродукции = ТоварыДерево.ПолучитьЭлементы();
		Для каждого СтрокаПродукции из СтрокиПродукции Цикл
			НоваяСтрока = ТаблицаТоваров.Добавить();
			НоваяСтрока.НомерСтроки = СтрокаПродукции.ПолучитьИдентификатор();
			НоваяСтрока.Номенклатура = СтрокаПродукции.Номенклатура;
			
			СтрокиТоваров = СтрокаПродукции.ПолучитьЭлементы();
			Для каждого СтрокаТовара из СтрокиТоваров Цикл
				НоваяСтрока = ТаблицаТоваров.Добавить();
				НоваяСтрока.НомерСтроки = СтрокаТовара.ПолучитьИдентификатор();
				НоваяСтрока.Номенклатура = СтрокаТовара.Номенклатура;
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;

	Если ТаблицаТоваров.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЗаказПокупателяТовары.НомерСтроки КАК НомерСтроки,
	|	ЗаказПокупателяТовары.Номенклатура КАК Номенклатура
	|ПОМЕСТИТЬ ВТ_Товары
	|ИЗ
	|	&ЗаказПокупателяТовары КАК ЗаказПокупателяТовары
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВТ_Товары.НомерСтроки КАК НомерСтроки,
	|	ВТ_Товары.Номенклатура КАК Номенклатура,
	|	СпрНоменклатура.ВидНоменклатуры КАК ВидНоменклатуры,
	|	СпрНоменклатура.Потолок_ПериметрПомещения КАК ПериметрПомещения,
	|	СпрНоменклатура.Потолок_НомерРасчета КАК НомерРасчета,
	|	СпрНоменклатура.Потолок_ИндексПотолка КАК ИндексПотолка
	|ИЗ
	|	ВТ_Товары КАК ВТ_Товары
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК СпрНоменклатура
	|		ПО ВТ_Товары.Номенклатура = СпрНоменклатура.Ссылка";
	
	Запрос.УстановитьПараметр("ЗаказПокупателяТовары", ТаблицаТоваров);
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Если НЕ ТоварыКакДерево Тогда
			СтрокаТЧ = Объект.Товары[Выборка.НомерСтроки - 1];			
		Иначе
			СтрокаТЧ = ТоварыДерево.НайтиПоИдентификатору(Выборка.НомерСтроки);
		КонецЕсли;
		ЗаполнитьЗначенияСвойств(СтрокаТЧ, Выборка, "ВидНоменклатуры, ПериметрПомещения, НомерРасчета, ИндексПотолка");
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСтавкуНДСПоОрганизации(Изменять = Истина)
	
	УчитыватьНДС = УчетНДС.ОрганизацияЯвляетсяПлательщикомНДС(Объект.Организация);
	СтавкаНДСПоУмолчанию = УчетНДС.СтавкаНДСПоУмолчанию(Объект.Организация);
	Если Изменять И НЕ СтавкаНДСПоУмолчанию = Объект.СтавкаНДС Тогда
		Объект.СтавкаНДС = СтавкаНДСПоУмолчанию;
	КонецЕсли;
	
	Элементы.ТоварыСуммаНДС.Видимость 			= УчитыватьНДС;
	Элементы.ТоварыСтавкаНДС.Видимость 			= УчитыватьНДС;
	Элементы.ТоварыДеревоСуммаНДС.Видимость 	= УчитыватьНДС;
	Элементы.ТоварыДеревоСтавкаНДС.Видимость 	= УчитыватьНДС;
	//Элементы.ДекорацияНДС.Видимость 			= УчитыватьНДС;
	//Элементы.ИтогиВсегоНДС.Видимость			= УчитыватьНДС;
	Элементы.ИтогСуммаНДС.Видимость				= УчитыватьНДС;
	Элементы.СтавкаНДС.Видимость 				= УчитыватьНДС;
	
КонецПроцедуры

