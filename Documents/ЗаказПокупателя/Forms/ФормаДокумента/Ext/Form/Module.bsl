Процедура ДобавитьПодчиненнуюНоменклатуру(Команда)
	
	// #7717 не только потолки
	//СписокНоменклатуры = ПолучитьСписокУникальныхПотолков();		
	СписокНоменклатуры = ПолучитьСписокУникальныхПозиций();
	Если СписокНоменклатуры.Количество() > 0 Тогда	
		ОписаниеОповещения = Новый ОписаниеОповещения("ПослеВыбораПотолкаДобавитьПодчиненнуюНоменклатуру", ЭтотОбъект);
		ПараметрыФормы = Новый Структура("СписокПотолков, ТолькоОдноЗначение", СписокНоменклатуры, Истина);		
		ОткрытьФорму("Документ.ЗаказПокупателя.Форма.ФормаВыбораПотолка", ПараметрыФормы, ЭтаФорма,,,, ОписаниеОповещения);		
	Иначе		
		//Сообщить("В табличной части товары не были найдены потолки и отрезы либо по некоторым из них есть выпуски продукции");		
		Сообщить("В табличной части не найдена продукция, либо по некоторым из них есть выпуски продукции, либо не было найдено неподчиненных товаров");
	КонецЕсли;	
	
