&НаСервере
Функция ПолучитьНоменклатуруПоСкладу ()
	
	ОбщиеСклады = Константы.ОбщиеСклады.Получить();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТоварыВРезервеНаСкладахОстатки.Номенклатура КАК Номенклатура,
		|	ТоварыВРезервеНаСкладахОстатки.КоличествоОстаток КАК Резерв,
		|	ТоварыВРезервеНаСкладахОстатки.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
		|	ТоварыВРезервеНаСкладахОстатки.СерияНоменклатуры КАК СерияНоменклатуры
		|ПОМЕСТИТЬ ВТВРезерве
		|ИЗ
		|	РегистрНакопления.ТоварыВРезервеНаСкладах.Остатки(
		|			,
		|			Склад = &Склад
		|				И Организация = &Организация) КАК ТоварыВРезервеНаСкладахОстатки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ТоварыНаСкладахОстатки.Номенклатура КАК Номенклатура,
		|	ТоварыНаСкладахОстатки.Номенклатура.БазоваяЕдиницаИзмерения КАК ЕдиницаИзмерения,
		|	ТоварыНаСкладахОстатки.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
		|	ТоварыНаСкладахОстатки.СерияНоменклатуры КАК СерияНоменклатуры,
		|	ВЫБОР
		|		КОГДА ТоварыНаСкладахОстатки.КоличествоОстаток > ЕСТЬNULL(ВТВРезерве.Резерв, 0)
		|			ТОГДА ТоварыНаСкладахОстатки.КоличествоОстаток - ЕСТЬNULL(ВТВРезерве.Резерв, 0)
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК Количество,
		|	1 КАК Коэффициент
		|ИЗ
		|	РегистрНакопления.ТоварыНаСкладах.Остатки(
		|			,
		|			Склад = &Склад
		|				И ВЫБОР
		|					КОГДА &ОбщиеСклады
		|						ТОГДА ИСТИНА
		|					ИНАЧЕ Организация = &Организация
		|				КОНЕЦ) КАК ТоварыНаСкладахОстатки
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТВРезерве КАК ВТВРезерве
		|		ПО ТоварыНаСкладахОстатки.Номенклатура = ВТВРезерве.Номенклатура
		|			И ТоварыНаСкладахОстатки.ХарактеристикаНоменклатуры = ВТВРезерве.ХарактеристикаНоменклатуры
		|			И ТоварыНаСкладахОстатки.СерияНоменклатуры = ВТВРезерве.СерияНоменклатуры
		|ГДЕ
		|	ТоварыНаСкладахОстатки.КоличествоОстаток > 0";
	
	
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	Запрос.УстановитьПараметр("ОбщиеСклады", ОбщиеСклады);
	Запрос.УстановитьПараметр("Склад", Объект.Склад);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	АдресВХранилище = ПоместитьВоВременноеХранилище(РезультатЗапроса.Выгрузить(), УникальныйИдентификатор);
	Возврат Новый Структура("АдресВХранилище", АдресВХранилище);
	
КонецФункции

#КонецОбласти

#Область ОбработчикиСобытийВкладкиФайлы

&НаСервере
Процедура ОбновитьСписокФайлов()
	
	Файлы.Очистить();
	СписокНоменклатуры = Объект.Товары.Выгрузить().ВыгрузитьКолонку("Номенклатура");

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ПрикрепленныеДанные.СсылкаНаОбъект КАК Номенклатура,
	|	ПрикрепленныеДанные.ИмяФайла,
	|	ПрикрепленныеДанные.Расширение,
	|	ПрикрепленныеДанные.ИмяФайла + ""."" + ПрикрепленныеДанные.Расширение КАК НаименованиеФайла,
	|	ПрикрепленныеДанные.ВидФайлаПрограммыПостроителя,
	|	ПрикрепленныеДанные.Период КАК ДатаПрикрепления
	|ИЗ
	|	РегистрСведений.ПрикрепленныеДанные КАК ПрикрепленныеДанные
	|ГДЕ
	|	ПрикрепленныеДанные.СсылкаНаОбъект В(&СсылкаНаОбъект)";
	Запрос.УстановитьПараметр("СсылкаНаОбъект", СписокНоменклатуры);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = Файлы.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
	КонецЦикла;
	
	Если Файлы.Количество() > 0 Тогда
		Элементы.ТаблицаФайлы.Заголовок = "Файлы (" + Файлы.Количество() + ")";
	Иначе
		Элементы.ТаблицаФайлы.Заголовок = "Файлы";
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ФайлыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ТекущиеДанные = Элементы.Файлы.ТекущиеДанные;
	АдресФайла = ОбщийМодульВызовСервера.ПолучитьДанныеФайла(ТекущиеДанные.Номенклатура, ТекущиеДанные.ИмяФайла,, ЭтотОбъект.УникальныйИдентификатор);
	
	Если НЕ АдресФайла = Неопределено Тогда // №7253
		//ВременноеИмя=ПолучитьИмяВременногоФайла(ТекущиеДанные.Расширение);
		ВременноеИмя = КаталогВременныхФайлов() + Строка(Новый УникальныйИдентификатор()) + "." + ТекущиеДанные.Расширение;
		ЗАписатьОшибку(ВременноеИмя);
	    ПолучитьФайл(АдресФайла, ВременноеИмя, Истина);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ЗАписатьОшибку(ВременноеИмя)
	
	ЗаписьЖурналаРегистрации("Тест", УровеньЖурналаРегистрации.Ошибка,,, ВременноеИмя);
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьФайл(Команда)
	
	СписокПотолков = ПолучитьСписокПотолковДляФайлов();
	Если НЕ СписокПотолков.Количество() = 0 Тогда
		Оп = Новый ОписаниеОповещения("ВыборПотолкаДляПрикрепленияФайла", ЭтотОбъект);
		ПоказатьВыборИзМеню(Оп, СписокПотолков, Элементы.ФайлыДобавитьФайл);
	Иначе
		ПоказатьПредупреждение(,"В продукции и товарах нет потолков и отрезов");
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьСписокПотолковДляФайлов()
	
	СписокНоменклатуры = Новый СписокЗначений;
	
	Для Каждого Строка Из Объект.Товары Цикл
		Если Справочники.ВидыНоменклатуры.ЭтоНоменклатураПотолкаИлиОтреза(Строка.Номенклатура)
			 И СписокНоменклатуры.НайтиПоЗначению(Строка.Номенклатура) = Неопределено Тогда
			СписокНоменклатуры.Добавить(Строка.Номенклатура);
		КонецЕсли;
	КонецЦикла;

	Возврат СписокНоменклатуры;	
КонецФункции

&НаКлиенте
Процедура ВыборПотолкаДляПрикрепленияФайла(ВыбранныйЭлемент, ДополнительныеПараметры) Экспорт
	
	Если ВыбранныйЭлемент = Неопределено Тогда
		Возврат;
	КонецЕсли;
		
	ОписаниеОповещения = Новый ОписаниеОповещения("ПослеПрикрепленияФайлаЗавершение", ЭтотОбъект);
	ДопПараметры = Новый Структура("ДействиеПослеПрикрепления", ОписаниеОповещения);
	ОбщийМодульКлиент.ПослеВыбораСсылкиДляПрикрепленияФайла(ВыбранныйЭлемент.Значение, ДопПараметры);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеПрикрепленияФайлаЗавершение(СтруктураРезультата, ДополнительныеПараметры) Экспорт
	
	Если СтруктураРезультата.Результат Тогда
		ОбновитьСписокФайлов();
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ПечататьФайл(Команда)
	ВыбранныеЭлементы = Элементы.Файлы.ВыделенныеСтроки;
	
	//Если НЕ Элементы.Файлы.ТекущиеДанные = Неопределено Тогда
	Если ВыбранныеЭлементы.Количество() > 0 Тогда
		Для каждого ЭлементДляПечати из ВыбранныеЭлементы Цикл
			СтрФайл = Файлы.НайтиПоИдентификатору(ЭлементДляПечати);
			
			АдресФайла = ОбщийМодульВызовСервера.ПолучитьДанныеФайла(СтрФайл.Номенклатура, СтрФайл.ИмяФайла,, ЭтотОбъект.УникальныйИдентификатор);
			
			Если НЕ АдресФайла = Неопределено Тогда // №7253
				//ВременноеИмя = ПолучитьИмяВременногоФайла(СтрФайл.Расширение);
				ВременноеИмя = КаталогВременныхФайлов() + Строка(Новый УникальныйИдентификатор()) + "." + СтрФайл.Расширение;
				ЗАписатьОшибку(ВременноеИмя);
			    ПолучитьФайл(АдресФайла, ВременноеИмя, Ложь);
				
				Shell = Новый COMОбъект("Shell.Application");
				Shell.ShellExecute(ВременноеИмя, "", "", "print", 0);
			КонецЕсли;
		КонецЦикла;
	Иначе
		ПоказатьПредупреждение(,"Выберите файл(ы) в списке");
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ФайлыПриАктивизацииСтроки(Элемент)
	
	Если НЕ ВключитьПредпросмотрФайлов ИЛИ Элементы.Файлы.ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если мПредыдущийИдентификатор = Элементы.Файлы.ТекущиеДанные.ПолучитьИдентификатор() Тогда
		Возврат;
	Иначе
		мПредыдущийИдентификатор = Элементы.Файлы.ТекущиеДанные.ПолучитьИдентификатор();
	КонецЕсли;
	
	ПодключитьОбработчикОжидания("ОбработчикОжиданияФайлыПриАктивизацииСтроки", 0.1, Истина);
КонецПроцедуры

&НаКлиенте
Процедура ОбработчикОжиданияФайлыПриАктивизацииСтроки()
	
	АдресФайла = ОбщийМодульВызовСервера.ПолучитьДанныеФайла(Объект.Ссылка, Элементы.Файлы.ТекущиеДанные.ИмяФайла, Элементы.Файлы.ТекущиеДанные.Номенклатура, ЭтотОбъект.УникальныйИдентификатор);
	
	ОбщийМодульКлиент.ПредпросмотрФайла(АдресФайла, Элементы.Файлы.ТекущиеДанные.Расширение, Предпросмотр, Элементы.Предпросмотр);	
	
КонецПроцедуры

