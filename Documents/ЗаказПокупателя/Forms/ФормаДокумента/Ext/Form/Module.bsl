Процедура ОкруглитьСтоимостьПотолков(Команда)
	
	Режим = РежимДиалогаВопрос.ДаНет;
	Оповещение = Новый ОписаниеОповещения("ПослеВопросаОбОкругленииПотолков", ЭтаФорма);
	ПоказатьВопрос(Оповещение, "Округлить стоимость потолков (составляющих) согласно настройкам программы?", Режим, 0);
	
