Функция ПересчитатьЦеныПоВидуЦен()
	
	//сбросим скидки. в связи с особенностью заполнения потолка, скидки нужно устанавливать всегда после переоценки потолка
	УстановитьСкидкуНаСервере(0);
	
	//Перезагрузим потолоки для переоценки
	Врем_Потолки = ПолучитьУникальныеПотолкиОтрезыЗаказа();
	
	Для Каждого Потолок Из Врем_Потолки Цикл
		// №7545 для простого потолка, нужно указать количество из ТЧ
		КоличествоПростогоПотолка = Неопределено;
		Если ПустаяСтрока(Потолок.Номенклатура.Потолок_ДанныеФайлаИмпорта) Тогда
			КоличествоПростогоПотолка = Потолок.Количество;
		КонецЕсли;
		ОбновитьНоменклатуруПотолкаНаСервере(Потолок.Номенклатура, Потолок.УИСтроки, КоличествоПростогоПотолка);
	КонецЦикла;				
	
	//Переоценим товары не относящиеся к потолкам
	Для Каждого ТекущаяСтрока Из Объект.Товары Цикл
		Если ТекущаяСтрока.Потолок.Пустая() Тогда
			//ТекущаяСтрока.Цена = ПолучитьЦенуНоменклатуры(ТекущаяСтрока.Номенклатура, ТекущаяСтрока.ХарактеристикаНоменклатуры, ТекущаяСтрока.ЕдиницаИзмерения);
			//ТекущаяСтрока.Сумма = ТекущаяСтрока.Количество * ТекущаяСтрока.Цена;
			
			СтруктураДанные = СтруктураДанныхПоСтрокеТабличнойЧастиСервер(ТекущаяСтрока);
			СтруктураДанные = ПолучитьДанныеНоменклатурыПриИзменении(СтруктураДанные);
			ЗаполнитьЗначенияСвойств(ТекущаяСтрока, СтруктураДанные, "Цена, ЦенаВал");
			
			ОбработкаТабличныхЧастейСервер.ПересчитатьСуммуРучнойСкидкиВСтрокеТЧ(ТекущаяСтрока);			
	        ОбработкаТабличныхЧастейСервер.ПересчитатьСуммуСУчетомСкидокВСтрокеТЧ(ТекущаяСтрока, ИспользуютсяАвтоматическиеСкидки, Истина, Истина);
			ОбработкаТабличныхЧастейСервер.ПересчитатьСуммуНДСВСтрокеТЧ(ТекущаяСтрока, УчитыватьНДС);
		КонецЕсли;
	КонецЦикла;
	
	Если НЕ Объект.ВидСкидки.Пустая() Тогда
		УстановитьСкидкуНаСервере(Объект.ВидСкидки.Процент);
	КонецЕсли;
	
	ПостроитьДеревоНаФорме();
	
	//ОбновитьДанныеДокумента();
	Если РежимПодробнаяИнформацияПоТоварам Тогда
		ЗаполнитьДанныеКОтгрузкеИОстаткиПоТоварам();
	КонецЕсли;
	РассчитатьИтоговыеПоказателиСервер();
	
КонецФункции

&НаСервере
Функция ОбновитьСтрокиПоПотолкамПоИнтеркампаниИВнутреннемуЗаказу()
	
	//Перезагрузим потолоки для переоценки
	Врем_Потолки = ПолучитьУникальныеПотолкиОтрезыЗаказа();
		
	Для Каждого Потолок Из Врем_Потолки Цикл
		ОбновитьНоменклатуруПотолкаНаСервере(Потолок.Номенклатура, Потолок.УИСтроки);				
	КонецЦикла;				
		
	ПостроитьДеревоНаФорме();
		
КонецФункции

//Начало добавлен при переходе на 2.0
&НаСервере
Процедура ОбновитьНоменклатуруПотолкаНаСервере(Данные, Знач УИСтроки = "", КоличествоПростогоПотолка = Неопределено)
	
	ОписаниеОшибки = "";
	СтруктураПотолок = ОбменСEasyCeiling.ПолучитьСтруктуруПотолка(Данные,,,,,,, ОписаниеОшибки); 
	Если СтруктураПотолок = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если ЗначениеЗаполнено(ОписаниеОшибки) Тогда
		Сообщить(ОписаниеОшибки);
		Возврат;
	КонецЕсли;
	СтруктураПотолок.Вставить("Организация", Объект.Организация);
	СтруктураПотолок.Вставить("Контрагент", Объект.Контрагент);
	
	ДанныеЗаказа = ОбменСEasyCeiling.СтруктураДанныхЗаказа(Объект.Организация, Объект.Подразделение, Объект.НастройкаИнтеркампани,
							  				 Объект.ВидЦен, Объект.Валюта, Объект.Дата, УчитыватьНДС, , Объект.ДоговорКонтрагента, Объект.ВнутреннийЗаказ);
	СтруктураЗаказа = ОбменСEasyCeiling.ПолучитьСтруктуруЗаказа(СтруктураПотолок, Перечисления.ВидыЗаказов.ЗаказПокупателя, ДанныеЗаказа);
	
	Потолок = Новый Структура("Номенклатура, Количество, ЕдиницаИзмерения, Коэффициент, АдресМонтажа, ЗагруженоИзПостроителя, КоличествоКВыработке",
									СтруктураЗаказа.ПродукцияНоменклатура, СтруктураЗаказа.Количество, 
									СтруктураЗаказа.ПродукцияНоменклатура.БазоваяЕдиницаИзмерения, 1,
									СтруктураЗаказа.АдресМонтажа, Истина,
									СтруктураЗаказа.КоличествоВыработка);
	// #5236 введенное в форме простого потолка количество								
	Если КоличествоПростогоПотолка <> Неопределено Тогда
		Потолок.Количество = КоличествоПростогоПотолка;
		Потолок.КоличествоКВыработке = КоличествоПростогоПотолка;
		// №7545 стоимость простого потолка в структуре заказа пустая (т.к. площадь потолка не переносится в карточку при создании), поэтому определим её здесь
		СтруктураЗаказа.Сумма = СтруктураЗаказа.Цена * Потолок.Количество;
	КонецЕсли;
			
	СтрокаПотолок = ОбработкаТабличныхЧастейСервер.ДобавитьОбновитьПотолокВТЧЗаказПокупателя(Объект.Товары, Неопределено, Потолок, УИСтроки); 
	
	//Услуги и товары относящиеся к потолку загоним во временную ТЗ, чтобы потом лишнее удалить
	Врем_ТЗ = новый ТаблицаЗначений;
	Врем_ТЗ.Колонки.Добавить("Номенклатура");
	Врем_ТЗ.Колонки.Добавить("Потолок");
	
	Для Каждого ТекущаяСтрока Из Объект.Товары Цикл			
		
		Если ТекущаяСтрока.Потолок = Потолок.Номенклатура И ТекущаяСтрока.Номенклатура <> Потолок.Номенклатура Тогда
			
			//Услуга или товар потолка
			НоваяСтрока = Врем_ТЗ.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущаяСтрока);
			
		КонецЕсли;	
		
	КонецЦикла;
	
	//услуги раскроя выделяются отдельно
	
	//потолок
	СтрокаПотолок.Сумма = СтруктураЗаказа.Сумма;
	Если НЕ СтрокаПотолок.Количество = 0 Тогда
		СтрокаПотолок.Цена = СтрокаПотолок.Сумма / СтрокаПотолок.Количество;
	КонецЕсли;
	ОбработкаТабличныхЧастейСервер.ПересчитатьСуммуРучнойСкидкиВСтрокеТЧ(СтрокаПотолок);			
	ОбработкаТабличныхЧастейСервер.ПересчитатьСуммуСУчетомСкидокВСтрокеТЧ(СтрокаПотолок, ИспользуютсяАвтоматическиеСкидки, Истина, Истина);
	ОбработкаТабличныхЧастейСервер.ПересчитатьСуммуНДСВСтрокеТЧ(СтрокаПотолок, УчитыватьНДС);
	
	//услуги раскроя
	Для Каждого ТекУслуга Из СтруктураЗаказа.Услуги Цикл
		Если ТекУслуга.ЭтоУслугаРаскроя Тогда
			ДанныеСтроки = Новый Структура("Потолок,ЗагруженоИзПостроителя",
			СтруктураЗаказа.ПродукцияНоменклатура, Истина);
			//++ №14059 добавлена вставка после потолка
			//НоваяСтрокаТовары = ОбработкаТабличныхЧастейСервер.ДобавитьОбновитьСтрокуВТЧЗаказПокупателя(Объект.Товары, ТекУслуга, ДанныеСтроки);
			НоваяСтрокаТовары = ОбработкаТабличныхЧастейСервер.ДобавитьОбновитьСтрокуВТЧЗаказПокупателя(Объект.Товары, ТекУслуга, ДанныеСтроки, СтрокаПотолок.НомерСтроки);
			//-- №14059
			
			Если ПустаяСтрока(НоваяСтрокаТовары.УИСтроки) Тогда
				НоваяСтрокаТовары.УИСтроки = Новый УникальныйИдентификатор;
				НоваяСтрокаТовары.ПроцентРучнойСкидки = ОбщийМодульВызовСервера.ПолучитьСкидкуПоВидуСкидки(Объект.ВидСкидки);
			КонецЕсли;
			НоваяСтрокаТовары.УИСтрокиРодителя = СтрокаПотолок.УИСтроки;
			
			// ожидаем заполненные значения в СтруктураЗаказа
			//Если ТекУслуга.КоличествоКВыработке = 0 ИЛИ НоваяСтрокаТовары.КоличествоКВыработке = 0 Тогда  //#12319 добавлены условия
			//	НоваяСтрокаТовары.КоличествоКВыработке = НоваяСтрокаТовары.Количество;
			//КонецЕсли;
			
			//Удалим из Врем_ТЗ услугу, если найдем (она там должна быть)
			УдалитьУслугиТоварКПотолкуИзВремТЗ(Потолок.Номенклатура, ТекУслуга.Номенклатура, Врем_ТЗ);
			
		КонецЕсли;
	КонецЦикла;
	
	//товары
	Для Каждого ТекУслуга Из СтруктураЗаказа.Товары Цикл
		Если ТекУслуга.ЭтоУслугаРаскроя Тогда
			ДанныеСтроки = Новый Структура("Потолок,ЗагруженоИзПостроителя",
			СтруктураЗаказа.ПродукцияНоменклатура, Истина);
			//++ №14059 добавлена вставка после потолка
			//НоваяСтрокаТовары = ОбработкаТабличныхЧастейСервер.ДобавитьОбновитьСтрокуВТЧЗаказПокупателя(Объект.Товары, ТекУслуга, ДанныеСтроки);
			НоваяСтрокаТовары = ОбработкаТабличныхЧастейСервер.ДобавитьОбновитьСтрокуВТЧЗаказПокупателя(Объект.Товары, ТекУслуга, ДанныеСтроки, СтрокаПотолок.НомерСтроки);
			//-- №14059
			
			Если ПустаяСтрока(НоваяСтрокаТовары.УИСтроки) Тогда
				НоваяСтрокаТовары.УИСтроки = Новый УникальныйИдентификатор;
				НоваяСтрокаТовары.ПроцентРучнойСкидки = ОбщийМодульВызовСервера.ПолучитьСкидкуПоВидуСкидки(Объект.ВидСкидки);
				ОбработкаТабличныхЧастейСервер.ПересчитатьСуммуРучнойСкидкиВСтрокеТЧ(НоваяСтрокаТовары);			
				ОбработкаТабличныхЧастейСервер.ПересчитатьСуммуСУчетомСкидокВСтрокеТЧ(НоваяСтрокаТовары, ИспользуютсяАвтоматическиеСкидки, Истина, Истина);
				ОбработкаТабличныхЧастейСервер.ПересчитатьСуммуНДСВСтрокеТЧ(НоваяСтрокаТовары, УчитыватьНДС);
			КонецЕсли;
			НоваяСтрокаТовары.УИСтрокиРодителя = СтрокаПотолок.УИСтроки;
			
			//++ №13815 для услуг заполняем количество к выработке
			// №14311 Если ЭтоУслуга(НоваяСтрокаТовары.Номенклатура) Тогда
			// ожидаем заполненные значения в СтруктураЗаказа: по расширенным правилам КоличествоКВыработке заполняется на этапе формирования таблицы
			//	НоваяСтрокаТовары.КоличествоКВыработке = НоваяСтрокаТовары.Количество;
			//КонецЕсли;
			//-- №13815
			
			//Удалим из Врем_ТЗ услугу, если найдем (она там должна быть)
			УдалитьУслугиТоварКПотолкуИзВремТЗ(Потолок.Номенклатура, ТекУслуга.Номенклатура, Врем_ТЗ);
			
		КонецЕсли;
	КонецЦикла;
	//КонецЕсли;
	
	//прочие товары и услуги (не услуги раскроя), в частности по расширенным правилам
	Для Каждого ТекТовар Из СтруктураЗаказа.Товары Цикл
		Если НЕ ТекТовар.ЭтоУслугаРаскроя Тогда
			ДанныеСтроки = Новый Структура("Потолок,ЗагруженоИзПостроителя",
			СтруктураЗаказа.ПродукцияНоменклатура, Истина);
			//++ №14059 добавлена вставка после потолка
			//НоваяСтрокаТовары = ОбработкаТабличныхЧастейСервер.ДобавитьОбновитьСтрокуВТЧЗаказПокупателя(Объект.Товары, ТекТовар, ДанныеСтроки);
			НоваяСтрокаТовары = ОбработкаТабличныхЧастейСервер.ДобавитьОбновитьСтрокуВТЧЗаказПокупателя(Объект.Товары, ТекТовар, ДанныеСтроки, СтрокаПотолок.НомерСтроки);
			//-- №14059
			
			Если ПустаяСтрока(НоваяСтрокаТовары.УИСтроки) Тогда
				НоваяСтрокаТовары.УИСтроки = Новый УникальныйИдентификатор;
				НоваяСтрокаТовары.ПроцентРучнойСкидки = ОбщийМодульВызовСервера.ПолучитьСкидкуПоВидуСкидки(Объект.ВидСкидки);
				ОбработкаТабличныхЧастейСервер.ПересчитатьСуммуРучнойСкидкиВСтрокеТЧ(НоваяСтрокаТовары);			
				ОбработкаТабличныхЧастейСервер.ПересчитатьСуммуСУчетомСкидокВСтрокеТЧ(НоваяСтрокаТовары, ИспользуютсяАвтоматическиеСкидки, Истина, Истина);
				ОбработкаТабличныхЧастейСервер.ПересчитатьСуммуНДСВСтрокеТЧ(НоваяСтрокаТовары, УчитыватьНДС);
			КонецЕсли;
			НоваяСтрокаТовары.УИСтрокиРодителя = СтрокаПотолок.УИСтроки;
			
			//++ №13815 для услуг заполняем количество к выработке
			// №14311 
			// ожидаем заполненные значения в СтруктураЗаказа
			// Если ЭтоУслуга(НоваяСтрокаТовары.Номенклатура) Тогда
			//	НоваяСтрокаТовары.КоличествоКВыработке = НоваяСтрокаТовары.Количество;
			//КонецЕсли;
			//-- №13815
			
			//Удалим из Врем_ТЗ услугу, если найдем (она там должна быть)
			УдалитьУслугиТоварКПотолкуИзВремТЗ(Потолок.Номенклатура, ТекТовар.Номенклатура, Врем_ТЗ);
			
		КонецЕсли;
	КонецЦикла;
	Для Каждого ТекУслуга Из СтруктураЗаказа.Услуги Цикл
		Если НЕ ТекУслуга.ЭтоУслугаРаскроя Тогда
			ДанныеСтроки = Новый Структура("Потолок,ЗагруженоИзПостроителя",
			СтруктураЗаказа.ПродукцияНоменклатура, , Истина);
			//++ №14059 добавлена вставка после потолка
			//НоваяСтрокаТовары = ОбработкаТабличныхЧастейСервер.ДобавитьОбновитьСтрокуВТЧЗаказПокупателя(Объект.Товары, ТекУслуга, ДанныеСтроки);
			НоваяСтрокаТовары = ОбработкаТабличныхЧастейСервер.ДобавитьОбновитьСтрокуВТЧЗаказПокупателя(Объект.Товары, ТекУслуга, ДанныеСтроки, СтрокаПотолок.НомерСтроки);
			//-- №14059
			
			//++ №13815 исправление заполнения количества к выработке
			//НоваяСтрокаТовары.КоличествоКВыработке = НоваяСтрокаТовары.Количество = 0;
			//НоваяСтрокаТовары.КоличествоКВыработке = НоваяСтрокаТовары.Количество;
			//-- №13815
			
			Если ПустаяСтрока(НоваяСтрокаТовары.УИСтроки) Тогда
				НоваяСтрокаТовары.УИСтроки = Новый УникальныйИдентификатор;
				НоваяСтрокаТовары.ПроцентРучнойСкидки = ОбщийМодульВызовСервера.ПолучитьСкидкуПоВидуСкидки(Объект.ВидСкидки);
				ОбработкаТабличныхЧастейСервер.ПересчитатьСуммуРучнойСкидкиВСтрокеТЧ(НоваяСтрокаТовары);			
				ОбработкаТабличныхЧастейСервер.ПересчитатьСуммуСУчетомСкидокВСтрокеТЧ(НоваяСтрокаТовары, ИспользуютсяАвтоматическиеСкидки, Истина, Истина);
				ОбработкаТабличныхЧастейСервер.ПересчитатьСуммуНДСВСтрокеТЧ(НоваяСтрокаТовары, УчитыватьНДС);
			КонецЕсли;
			НоваяСтрокаТовары.УИСтрокиРодителя = СтрокаПотолок.УИСтроки;
			
			//Удалим из Врем_ТЗ услугу, если найдем (она там должна быть)
			УдалитьУслугиТоварКПотолкуИзВремТЗ(Потолок.Номенклатура, ТекУслуга.Номенклатура, Врем_ТЗ);
			
		КонецЕсли;
	КонецЦикла;
	
	//Удалим товары и услуги в ТЧ Товары позиции, которые относятся к потолку и сейчас не были загружены
	Если Врем_ТЗ.Количество() > 0 Тогда						
		
		Для Каждого ТекСтрока Из Врем_ТЗ Цикл
			
			СтруктураПоиска = новый Структура("Номенклатура, Потолок", ТекСтрока.Номенклатура, ТекСтрока.Потолок);
			НайденныеСтроки = Объект.Товары.НайтиСтроки(СтруктураПоиска);
			
			Если НайденныеСтроки.Количество() > 0 Тогда						
				
				Для Сч = НайденныеСтроки.Количество()-1 По 0 Цикл
					
					Объект.Товары.Удалить(НайденныеСтроки[Сч]);
					
				КонецЦикла;
				
			КонецЕсли; 				
			
		КонецЦикла; 		
		
	КонецЕсли;
	
	// 2.0 R14 перенесено в общий модуль 
	ОбработкаТабличныхЧастейСервер.ОкруглитьСтоимостьПотолковВЗаказеПокупателя(Объект.Товары, Потолок.Номенклатура);
	
	// ЗАГРУЗКА МАТЕРИАЛОВ	
	КоличествоСтрокМатериалы = Объект.Материалы.Количество();
	Для Сч = 1 По КоличествоСтрокМатериалы Цикл
		
		СтрокаМатериалов = Объект.Материалы.Получить(КоличествоСтрокМатериалы-Сч);
		Если СтрокаМатериалов.Потолок = Потолок.Номенклатура Тогда
			Объект.Материалы.Удалить(КоличествоСтрокМатериалы-Сч);
		КонецЕсли;	
		
	КонецЦикла;	
	
	Для Каждого СтрокаМатериалов Из СтруктураЗаказа.Материалы Цикл
		
		СтрокаДокумента = Объект.Материалы.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаДокумента, СтрокаМатериалов);
		СтрокаДокумента.ЗагруженоИзПостроителя = Истина;
		СтрокаДокумента.Потолок = Потолок.Номенклатура;
		СтрокаДокумента.УИСтроки = СтрокаПотолок.УИСтроки; 
		
		// №14311
		// пока не трогаем, берем из СтруктураЗаказа
		//СтрокаДокумента.КоличествоКВыработке = СтрокаДокумента.Количество; 
		
	КонецЦикла;

	
КонецПроцедуры	
