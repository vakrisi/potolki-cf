&НаКлиенте
Процедура ОтправитьСМС(Команда)
	Если ОбщийМодульВызовСервера.ЕстьТелефонКонтрагента(Объект.Ссылка) Тогда	
		Парам = Новый Структура;
		Парам.Вставить("Основание", Объект.Ссылка);
		ОткрытьФорму("Документ.ОтправкаСМС.Форма.ФормаДокумента",Парам,,,,,Новый ОписаниеОповещения("ПослеЗакрытияФормыНовогоСМС",ЭтаФорма));		
	Иначе
		ПоказатьОповещениеПользователя("У контрагента в карточке не указан номер телефона. СМС не создана");
	КонецЕсли;
	ОбновитьИзображениеКомандОтправкиСообщений(Ложь, Истина);
КонецПроцедуры

&НаКлиенте
Процедура ОтправитьЭлектронноеПисьмо(Команда)
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ОтправитьЭлектронноеПисьмоЗавершение", ЭтотОбъект);
	ПоказатьВопрос(ОписаниеОповещения, "Создать новое электронное письмо?", РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтправитьЭлектронноеПисьмоЗавершение(Результат, ДополнительныеПараметры) Экспорт

	Если НЕ Результат = КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	НовоеПисьмо = РаботаСЭлектроннойПочтой.СформироватьЭлектронноеПисьмо("Заказ покупателя", Объект.Контрагент, , Объект.Ссылка);		
	Парам = Новый Структура("Ключ", НовоеПисьмо);
	ОткрытьФорму("Документ.ЭлектронноеПисьмо.ФормаОбъекта", Парам);		
	
	ОбновитьИзображениеКомандОтправкиСообщений(Истина, Ложь);
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьИзображениеКомандОтправкиСообщений(ПоПочте = Истина, ПоСМС = Истина)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Основание", Объект.Ссылка);

	// письмо
	Если ПоПочте Тогда
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЭлектронноеПисьмо.Ссылка
		|ИЗ
		|	Документ.ЭлектронноеПисьмо КАК ЭлектронноеПисьмо
		|ГДЕ
		|	ЭлектронноеПисьмо.Основание = &Основание";
		РезультатЗапроса = Запрос.Выполнить();
		
		Если НЕ РезультатЗапроса.Пустой() Тогда
			Элементы.ОтправитьЭлектронноеПисьмо.Картинка = БиблиотекаКартинок.ОтправленоПисьмо;
		КонецЕсли;
	КонецЕсли;
		
	// смс
	Если ПоСМС Тогда
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ОтправкаСМС.Ссылка,
		|	1 КАК Создано,
		|	ВЫБОР
		|		КОГДА ОтправкаСМС.Отправлено
		|			ТОГДА 1
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК Отправлено
		|ИЗ
		|	Документ.ОтправкаСМС КАК ОтправкаСМС
		|ГДЕ
		|	ОтправкаСМС.Основание = &Основание";
		
		РезультатЗапроса = Запрос.Выполнить().Выгрузить();
		Если РезультатЗапроса.Количество() > 0 Тогда
			РезультатЗапроса.Свернуть("","Создано, Отправлено");
		КонецЕсли;
		
		Если РезультатЗапроса.Количество() = 0 Тогда
			Элементы.ОтправитьСМС.Картинка = БиблиотекаКартинок.ОтправитьSMS;
		Иначе
			Если РезультатЗапроса[0].Отправлено >= РезультатЗапроса[0].Создано Тогда
				Элементы.ОтправитьСМС.Картинка = БиблиотекаКартинок.ОтправленоСМС;
			Иначе
				Элементы.ОтправитьСМС.Картинка = БиблиотекаКартинок.ПриготовленоСМС;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

