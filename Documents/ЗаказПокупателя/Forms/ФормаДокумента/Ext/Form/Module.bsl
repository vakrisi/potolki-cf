&НаКлиенте
Процедура ТоварыДеревоПотолокНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	
	МассивРазрешенныхНоменклатур = ПолучитьНоменклатуруКЗаказуНаПроизводствоПоОтбору(); // №14932
	
	СписокПродукции = Новый СписокЗначений;
	Для Каждого ТекущаяСтрока Из Объект.Товары Цикл
		//++ №14932 смотрим теперь по настройке
		//Если ЗаказыватьТоварыВПроизводство() И НЕ ЭтоУслуга(ТекущаяСтрока.Номенклатура) Тогда
		Если НЕ МассивРазрешенныхНоменклатур.Найти(ТекущаяСтрока.Номенклатура) = Неопределено
			И НЕ ЭтоУслугаСервер(ТекущаяСтрока.Номенклатура) Тогда
		//-- №14932
			Если (ЭтоУникальнаяПродукцияСервер(ТекущаяСтрока.Номенклатура) ИЛИ ОбщийМодульВызовСервера.ЭтоНоменклатураПродукция(ТекущаяСтрока.Номенклатура)) 
				//И ВыпущенныеПотолки.НайтиПоЗначению(ТекущаяСтрока.Номенклатура) = Неопределено
				И НЕ ЕстьДокументВыпускаПоПродукции(ТекущаяСтрока.Номенклатура, ТекущаяСтрока.ХарактеристикаНоменклатуры)
				Тогда
				//показываем на выбор только не выпущенные потолки
				СтруктураПродукции = Новый Структура;
				СтруктураПродукции.Вставить("Номенклатура",ТекущаяСтрока.Номенклатура);
				СтруктураПродукции.Вставить("УИСтроки",ТекущаяСтрока.УИСтроки);
				СписокПродукции.Добавить(СтруктураПродукции);
			ИначеЕсли ТекущаяСтрока.Потолок.Пустая() Тогда
				СтруктураПродукции = Новый Структура;
				СтруктураПродукции.Вставить("Номенклатура",ТекущаяСтрока.Номенклатура);
				СтруктураПродукции.Вставить("УИСтроки",ТекущаяСтрока.УИСтроки);
				СписокПродукции.Добавить(СтруктураПродукции);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	СписокПараметров = Новый Структура;
	СписокПараметров.Вставить("СписокПродукции", СписокПродукции); 
	
	ОткрытьФорму("Документ.ЗаказПокупателя.Форма.ФормаВыбораРодительскойНоменклатуры", СписокПараметров, ЭтаФорма, , , , Новый ОписаниеОповещения("ПослеВыбораРодительскойНоменклатуры", ЭтаФорма, Элементы.ТоварыДерево.ТекущиеДанные), РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры

