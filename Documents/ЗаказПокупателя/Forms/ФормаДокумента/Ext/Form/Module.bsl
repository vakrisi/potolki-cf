    	КонецЦикла;
		ОбщийМодульКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы, МассивИменЭлементов, "Доступность", Ложь);
		МассивИменЭлементов.Очистить();
		МассивИменЭлементов.Добавить("Комментарий"); 
		МассивИменЭлементов.Добавить("Примечание");
		МассивИменЭлементов.Добавить("ФормаПровестиИЗакрыть");  
		МассивИменЭлементов.Добавить("ФормаЗаписать");
		МассивИменЭлементов.Добавить("ФормаПровести"); 
