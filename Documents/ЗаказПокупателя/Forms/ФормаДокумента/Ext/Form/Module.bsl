&НаКлиенте
Процедура ДекорацияСоздатьДоставкуНажатиеЗавершение()
	
	ЕстьНоменклатураДоставка = Ложь;
	Если Объект.Товары.Количество() > 0 Тогда
		Для Каждого СтрокаТЧ Из Объект.Товары Цикл
			Если СтрокаТЧ.Номенклатура = ПредопределенноеЗначение("Справочник.Номенклатура.Доставка") ИЛИ
				СтрокаТЧ.Номенклатура = ПредопределенноеЗначение("Справочник.Номенклатура.Доставка2") ИЛИ
				СтрокаТЧ.Номенклатура = ПредопределенноеЗначение("Справочник.Номенклатура.Доставка3") ИЛИ
				СтрокаТЧ.Номенклатура = ПредопределенноеЗначение("Справочник.Номенклатура.Доставка4") ИЛИ
				СтрокаТЧ.Номенклатура = ПредопределенноеЗначение("Справочник.Номенклатура.Доставка5") Тогда
				ЕстьНоменклатураДоставка = Истина;
				НоменклатураДоставка = СтрокаТЧ.Номенклатура;
				Прервать;
			КонецЕсли;
		КонецЦикла;	
	Иначе	
		ЕстьНоменклатураДоставка = Ложь;
	КонецЕсли;
	
	Если НЕ ЕстьНоменклатураДоставка Тогда 	
		ОбщегоНазначенияКлиент.СообщитьПользователю("Не добавлена ""Доставка"" в табличну часть", Объект.Ссылка, "Товары");
		Возврат;
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура("Основание", Объект.Ссылка);
	ОткрытьФорму("Документ.ЗаявкаНаДоставку.ФормаОбъекта", ПараметрыФормы);
	
КонецПроцедуры
