			ПараметрыФормыПросмотраРазличий = Новый Структура;
			ПараметрыФормыПросмотраРазличий.Вставить("ТолькоПросмотр", Ложь);
			ПараметрыФормыПросмотраРазличий.Вставить("ТекстСообщения", ТекстСообщения);
			ПараметрыФормыПросмотраРазличий.Вставить("МассивДокументов", МассивДокументов);
			
			ОписаниеОповещения = Новый ОписаниеОповещения("НачалоПерезаполненияЗаказовНаПроизводствоПоЗаказуПокупателя", ЭтотОбъект, МассивДокументов);
			ОткрытьФорму("ОбщаяФорма.ПросмотрРазличийДокументов", ПараметрыФормыПросмотраРазличий, ЭтотОбъект,,,, ОписаниеОповещения);
			
		КонецЕсли;
		
	КонецЕсли;
	//-- №14311
	
	ОбщийМодульКлиент.ВыполнитьДействияПослеЗаписи(ЭтаФорма, Объект, ПараметрыЗаписи);
	
