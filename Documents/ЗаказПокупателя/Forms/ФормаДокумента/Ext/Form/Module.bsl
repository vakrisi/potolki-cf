&НаСервере
Процедура ОбновитьДанныеДокумента()
	
	МассивНоменклатуры = Новый Массив;
	
	Если ТоварыКакДерево Тогда	
		Дерево = ДанныеФормыВЗначение(ТоварыДерево, Тип("ДеревоЗначений"));
		КоличествоСтрок = 0;
		СуммаДокументаВрем = 0;
		Для Каждого СтрокаПродукции Из Дерево.Строки Цикл
			КоличествоПодчиненныхСтрок = СтрокаПродукции.Строки.Количество();
			//Если НЕ Справочники.ВидыНоменклатуры.ЭтоНоменклатураПотолкаИлиОтреза(ТекСтрока1.Номенклатура) Тогда
			Если КоличествоПодчиненныхСтрок = 0	Тогда
				СуммаДокументаВрем = СуммаДокументаВрем + СтрокаПродукции.Сумма;
			//КонецЕсли;
				КоличествоСтрок = КоличествоСтрок + 1;
				МассивНоменклатуры.Добавить(СтрокаПродукции.Номенклатура);
			Иначе
				
				//++ №14183 сумма по товару или материалу с подчиненными строками
				Если НЕ ЭтоНоменклатураПотолкаИлиОтрезаИлиПродукции(СтрокаПродукции.ВидНоменклатуры) Тогда
					
					СуммаДокументаВрем = СуммаДокументаВрем + СтрокаПродукции.Сумма;
					КоличествоСтрок = КоличествоСтрок + 1;
					
					МассивНоменклатуры.Добавить(СтрокаПродукции.Номенклатура);
					
				КонецЕсли;
				//-- №14183
				
				Для Каждого ПодчиненнаяСтрока Из СтрокаПродукции.Строки Цикл
					СуммаДокументаВрем = СуммаДокументаВрем + ПодчиненнаяСтрока.Сумма;
					КоличествоСтрок = КоличествоСтрок + 1;
					
					МассивНоменклатуры.Добавить(СтрокаПродукции.Номенклатура);
				КонецЦикла;
			КонецЕсли;
		КонецЦикла;
		Если НЕ Объект.СуммаДокумента = СуммаДокументаВрем Тогда
			Объект.СуммаДокумента = СуммаДокументаВрем;
		КонецЕсли;
	Иначе
		СуммаДокументаВрем = Объект.Товары.Итог("Сумма");
		Если НЕ Объект.СуммаДокумента = СуммаДокументаВрем Тогда
			Объект.СуммаДокумента = СуммаДокументаВрем;
		КонецЕсли;
		
		Для Каждого СтрокаТЧ Из Объект.Товары Цикл			
			МассивНоменклатуры.Добавить(СтрокаТЧ.Номенклатура);
		КонецЦикла;
	КонецЕсли;
	
	// №9649 переделано на реквизит формы, т.к. не срабатывало событие ТоварыПриНачалеРедактирования
	// было: Элементы.ИтогиВсегоНДС.Заголовок = Объект.Товары.Итог("СуммаНДС");
	//ИтогСуммаНДС = Объект.Товары.Итог("СуммаНДС");  убрано в РассчитатьИтоговыеПоказатели
		
	// #14068
	//убрано в РассчитатьИтоговыеПоказатели
	//Запрос = Новый Запрос;
	//Запрос.Текст = 
	//"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	//|	СУММА(Номенклатура.Потолок_ПериметрПомещения) КАК ПериметрПомещения
	//|ИЗ
	//|	Справочник.Номенклатура КАК Номенклатура
	//|ГДЕ
	//|	Номенклатура.Ссылка В(&МассивНоменклатуры)";
	//
	//Запрос.УстановитьПараметр("МассивНоменклатуры", МассивНоменклатуры);
	//Выборка = Запрос.Выполнить().Выбрать();
	//Если Выборка.Следующий() Тогда
	//	ИтогПериметрПотолков = Выборка.ПериметрПомещения;
	//Иначе
	//	ИтогПериметрПотолков = 0;
	//КонецЕсли;
	
