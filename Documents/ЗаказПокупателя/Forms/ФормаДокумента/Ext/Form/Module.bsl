	КонецЕсли;
	//-- #9777
	
	//#16334
	ОбщийМодульСервер.ОбработкаЗаполненияМенеджера(ЭтаФорма, Метаданные.Документы.ЗаказПокупателя, РеквизитыПользователя.Сотрудник);
	
	// №10663
	Элементы.ГруппаСсылкиНаДоставки.Видимость = ПолучитьФункциональнуюОпцию("УчитыватьДоставкуТовара");
	ЗаполнитьСсылкиНаДоставки();
	
	ФинансыСервер.ОбновитьВидимостьИКурсВалюты(ЭтотОбъект);
	
	ВидСпецификацииПоУмолчанию = Перечисления.ВидыСпецификации.СпецификацияПродукции;
	
	//#13943
	Элементы.Менеджер.ТолькоПросмотр = НЕ РеквизитыПользователя.РазрешеноМенятьМенеджераВЗаказеПокупателя;
	
	ОбщийМодульСервер.УстановитьВидимостьПодразделения(ЭтотОбъект);
	
	ОбновитьОтображениеКолонокТоваров();
	
	//nva+++
	ОтображатьМаржуВЗаказеПокупателя = РеквизитыПользователя.ОтображатьМаржуВЗаказеПокупателя;
	Если ОтображатьМаржуВЗаказеПокупателя Тогда
		Элементы.ГруппаМаржинальность.Видимость = ОтображатьМаржуВЗаказеПокупателя;
		Элементы.ТоварыМаржа.Видимость = ОтображатьМаржуВЗаказеПокупателя;
	КонецЕсли;	
	//nva---
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	ДатыЗапретаИзменения.ОбъектПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	
	// СтандартныеПодсистемы.Свойства
	УправлениеСвойствами.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	// Конец СтандартныеПодсистемы.Свойства
	
	ПриЧтенииСозданииНаСервере();
	
	//ОбновитьДанныеДокумента(); // отказ от общей процедуры 
	Если РежимПодробнаяИнформацияПоТоварам Тогда
		ЗаполнитьДанныеКОтгрузкеИОстаткиПоТоварам();
	КонецЕсли;
	ЗаполнитьСтатусыПроизводстваПоТоварам();
	РассчитатьИтоговыеПоказателиСервер();
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииСозданииНаСервере()
	
	КодФормы = "ФормаЗаказаПокупателя";
	УстановитьЗначенияПоНастройкамФормы();
	
	ИспользоватьРезервирование = ПолучитьФункциональнуюОпцию("ИспользоватьРезервирование");
	
	ТоварыКакДерево = Константы.ОтображатьТоварыКакДеревоВЗаказеПокупателя.Получить();
	Если ТоварыКакДерево Тогда
		ПостроитьДеревоНаФорме();
	КонецЕсли;
	ДоговорДоИзменения = Объект.ДоговорКонтрагента;
	
	ОбщийМодульСервер.ПриЧтенииСозданииДокументовСДоставкойНаСервере(Элементы, Объект);
	
	ЗаполнитьРеквизитыНоменклатурыТовара();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	МенеджерОборудованияКлиентПереопределяемый.НачатьПодключениеОборудованиеПриОткрытииФормы(ЭтаФорма, "СканерШтрихкода");
	
	// СтандартныеПодсистемы.Свойства
    УправлениеСвойствамиКлиент.ПослеЗагрузкиДополнительныхРеквизитов(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.Свойства
	
	ОповеститьПотолкиОбИзменении();
	//ОбновитьДанныеДокумента();
	РазвернутьДеревоТоваров(Неопределено, Неопределено);
	
	//++ #4212	
	Если ИзмененСтатус Тогда
		ПоказатьОповещениеПользователя("Изменен статус", , "Изменен статус с ""Новый"" на ""В работе""");
		Модифицированность = Истина;
	КонецЕсли;
	
	//#16334	
	ОбщийМодульКлиент.ОбработатьИзменениеМенеджера(ЭтаФорма);
	
	Элементы.ТекущийСтатус.АвтоМаксимальнаяШирина = Истина;
	Элементы.ТекущийСтатус.МаксимальнаяШирина = 36;
	Элементы.ПеревестиВСтатусВРаботе.Видимость = Ложь;
	Если Объект.ТекущийСтатус = ОбщегоНазначенияКлиентСервер.ПредопределенныйЭлемент("Справочник.СтатусыЗаказовПокупателей.Новый") Тогда
		Элементы.ТекущийСтатус.АвтоМаксимальнаяШирина = Ложь;
		Элементы.ПеревестиВСтатусВРаботе.Видимость = Истина;
	КонецЕсли;	
	
КонецПроцедуры

