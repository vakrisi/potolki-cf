&НаКлиенте
Процедура ОбработкаВыбораПодборНаКлиенте(ВыбранноеЗначение, ЗаполнятьПоСпецификации = Истина, ПерезаполнитьЦены = Ложь)
	
	Если Не ЗначениеЗаполнено(ВыбранноеЗначение) Тогда
		Возврат;
	КонецЕсли;
	
	Если ПодборВМатериалы Тогда
		ПодборВМатериалы = Ложь;
		ОбработкаВыбораПодборМатериаловНаСервере(ВыбранноеЗначение);
		Возврат;
	КонецЕсли;
		
	МассивНоменклатурДляЗаполненияПоСпецификации = ОбработкаВыбораПодборНаСервере(ВыбранноеЗначение, ПерезаполнитьЦены);
	
	Если ТоварыКакДерево Тогда
		ПостроитьДеревоНаФорме();
	КонецЕсли;
	
	//ОбновитьДанныеДокумента();
	Если РежимПодробнаяИнформацияПоТоварам Тогда
		ЗаполнитьДанныеКОтгрузкеИОстаткиПоТоварам();
	КонецЕсли;
	РассчитатьИтоговыеПоказателиКлиент();
	
	Если ИспользоватьБонусы Тогда
		ПересчитатьБонусыПоДокументу(); // №13299
	КонецЕсли;
	
	РазвернутьДеревоТоваров(Неопределено, Неопределено);
	
	Если ЗаполнятьПоСпецификации И МассивНоменклатурДляЗаполненияПоСпецификации.Количество() > 0 Тогда
		ЗадатьВопросОПерезаполненииМатериловПоСпецификации(,, МассивНоменклатурДляЗаполненияПоСпецификации);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ОбработкаВыбораПодборНаСервере(ВыбранноеЗначение, ПерезаполнитьЦены = Ложь)
	
	ТаблицаТоваров = ПолучитьИзВременногоХранилища(ВыбранноеЗначение.АдресВХранилище);
	МассивНоменклатурДляЗаполненияПоСпецификации = новый Массив;
	
	// №14840 колонка есть в форме подбора номенклатуры, по сопутствующим позициям товары из спецификаций не добавляем
	ЕстьКолонкаЭтоСопутствующийТовар = (НЕ ТаблицаТоваров.Колонки.Найти("ЭтоСопутствующийТовар") = Неопределено);
	
	Для Каждого ТекущаяСтрока из ТаблицаТоваров Цикл
		
		НоваяСтрока = Объект.Товары.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущаяСтрока);
		
		НоваяСтрока.УИСтроки = новый УникальныйИдентификатор;
		
		СтруктураДанные = СтруктураДанныхПоСтрокеТабличнойЧастиСервер(НоваяСтрока);
		СтруктураДанные = ОбщийМодульВызовСервера.ПолучитьДанныеНоменклатурыПриИзменении(СтруктураДанные);	
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтруктураДанные, "ВидНоменклатуры, Спецификация");
	
		Если ПерезаполнитьЦены Тогда
			СтруктураДанные = СтруктураДанныхПоСтрокеТабличнойЧастиСервер(НоваяСтрока);
			СтруктураДанные = ПолучитьДанныеНоменклатурыПриИзменении(СтруктураДанные);
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтруктураДанные, "Цена, ЦенаВал");
		КонецЕсли;
		
		//ПересчитатьЦенуИСуммуНоменклатурыВСтрокеПоВалюте(НоваяСтрока.НомерСтроки); //-- #7698
		НоваяСтрока.СтавкаНДС = Объект.СтавкаНДС;
		НоваяСтрока.ПроцентРучнойСкидки = ОбщийМодульВызовСервера.ПолучитьСкидкуПоВидуСкидки(Объект.ВидСкидки);
		ОбработкаТабличныхЧастейКлиентСервер.ПересчитатьСуммуРучнойСкидкиВСтрокеТЧ(НоваяСтрока);
		
		//++ №13299
		//ОбработкаТабличныхЧастейКлиентСервер.ПересчитатьСуммуСУчетомСкидокВСтрокеТЧ(НоваяСтрока, ИспользуютсяАвтоматическиеСкидки);
		ОбработкаТабличныхЧастейСервер.ПересчитатьСуммуСУчетомСкидокВСтрокеТЧ(НоваяСтрока, ИспользуютсяАвтоматическиеСкидки, Истина, Истина);
		//-- №13299
		
		ОбработкаТабличныхЧастейКлиентСервер.ПересчитатьСуммуНДСВСтрокеТЧ(НоваяСтрока, УчитыватьНДС);
		
		//НоваяСтрока.Спецификация = ОбщийМодульВызовСервера.ПолучитьОсновнуюСпецификациюНоменклатуры(НоваяСтрока.Номенклатура, ВидСпецификацииПоУмолчанию);
		
		// №14840
		ЗаполнятьТоварыИзСпецификации = Истина;
		Если ЕстьКолонкаЭтоСопутствующийТовар И ТекущаяСтрока.ЭтоСопутствующийТовар Тогда
			ЗаполнятьТоварыИзСпецификации = (НЕ ТекущаяСтрока.ЭтоСопутствующийТовар);
		КонецЕсли;
		
		Если НЕ НоваяСтрока.Спецификация.Пустая()
			И ЗаполнятьТоварыИзСпецификации // №14840
		Тогда
			МассивНоменклатурДляЗаполненияПоСпецификации.Добавить(новый Структура("Потолок, УИСтроки", НоваяСтрока.Номенклатура, НоваяСтрока.УИСтроки));
		КонецЕсли;
		
		Если ПодборКПотолку Тогда
			НоваяСтрока.Потолок = ДанныеСтрокиПотолка.Потолок;
			НоваяСтрока.УИСтрокиРодителя = ДанныеСтрокиПотолка.УИСтроки;
			//++ №14311 комментируем, т.к. количество к выработке ставим в любом случае
			//Если ЭтоУслуга(НоваяСтрока.Номенклатура) Тогда
			//	НоваяСтрока.КоличествоКВыработке = НоваяСтрока.Количество;	
			//КонецЕсли;
			//-- №14311
		КонецЕсли;
		
		НоваяСтрока.КоличествоКВыработке = НоваяСтрока.Количество; // №14311
		
	КонецЦикла;
	
	ПодборКПотолку = Ложь;
	
	Возврат МассивНоменклатурДляЗаполненияПоСпецификации;
	
КонецФункции

