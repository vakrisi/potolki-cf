Процедура НачалоПерезаполненияЗаказовНаПроизводствоПоЗаказуПокупателя(Результат, МассивДокументов) Экспорт
	
	Если Результат = Истина Тогда
		
		Для Каждого ТекущийДокумент Из МассивДокументов Цикл
			
			УспешноПроведен = Ложь;
			
			//Если ТекущийДокумент.ВидЗаказа = ПредопределенноеЗначение("Перечисление.ВидыЗаказовНаПроизводство.ПроизводствоПотолка") Тогда
			//	//производство потолка
			//	ОбщийМодуль.ОбновитьЗаказНаПроизводствоПоПотолкуПоЗаказуПокупателя(ТекущийДокумент.ЗаказНаПроизводство, ТекущийДокумент.ПродукцияНоменклатура, ТекущийДокумент.ЗаказПокупателя, УспешноПроведен, ТекущийДокумент.ПродукцияУИСтроки, ТекущийДокумент.ДоступноИзменениеПриНаличииВыпуска);
			//Иначе
			//	//типовое производство
			//	ОбщийМодуль.ОбновитьЗаказНаТиповоеПроизводствоПоЗаказуПокупателя(ТекущийДокумент.ЗаказНаПроизводство, ТекущийДокумент.ЗаказПокупателя, УспешноПроведен, ТекущийДокумент.ДоступноИзменениеПриНаличииВыпуска);
			//КонецЕсли;                                   
			
			//Пропадает склад продукции в защищённом модуле 
			СкладПродукцииВЗаказеНаПроизводство = ПолучитьСклад(ТекущийДокумент.ЗаказНаПроизводство);
			ОбщийМодуль.ОбновитьЗаказНаПроизводствоПоЗаказуПокупателя(ТекущийДокумент.ЗаказНаПроизводство, ТекущийДокумент.ДоступноИзменениеПриНаличииВыпуска, УспешноПроведен);
			СкладПродукцииВЗаказеНаПроизводствоПосле = ПолучитьСклад(ТекущийДокумент.ЗаказНаПроизводство);
			Если УспешноПроведен И СкладПродукцииВЗаказеНаПроизводство <> СкладПродукцииВЗаказеНаПроизводствоПосле Тогда
				ЗаписатьСкладВЗаказеНаПроизводство(ТекущийДокумент.ЗаказНаПроизводство, СкладПродукцииВЗаказеНаПроизводство);
			КонецЕсли;	
			
			Если УспешноПроведен Тогда
				Сообщить(СтрШаблон("Обновлен ""%1"" по данным заказа покупателя", ТекущийДокумент.ЗаказНаПроизводство));	
			КонецЕсли;
			
		КонецЦикла;
		
    КонецЕсли;

КонецПроцедуры
