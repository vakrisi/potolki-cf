Процедура ОбработкаОтветаНаВопросУдаленияМатериаловПоПозиции(Результат, ДопПараметры) Экспорт
	Если Результат = КодВозвратаДиалога.Да Тогда
		УдалитьМатериалыОтносящиесяКПозиции(ДопПараметры.Номенклатура, ДопПараметры.УИСтроки);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ТоварыДеревоСпецификацияПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ТоварыДерево.ТекущиеДанные;
	
	//Если очистили спецификацию, предложим удалить материалы
	Если мСпецификация <> Неопределено И НЕ мСпецификация.Пустая()
		И ТекущиеДанные.Спецификация.Пустая()
		И ЕстьМатериалыПоТекущейПозиции(ТекущиеДанные.Номенклатура, ТекущиеДанные.УИСтроки) Тогда
		
		//ЗадатьВопросОбУдаленииМатериаловПоПозиции(ТекущиеДанные.Номенклатура, ТекущиеДанные.УИСтроки); - решили не справшивать, а сразу удалять
		УдалитьМатериалыОтносящиесяКПозицииНаСервере(ТекущиеДанные.Номенклатура, ТекущиеДанные.УИСтроки);
		
	ИначеЕсли НЕ ТекущиеДанные.Спецификация.Пустая() Тогда		
		
		ЗадатьВопросОПерезаполненииМатериловПоСпецификации(ТекущиеДанные.Номенклатура, ТекущиеДанные.УИСтроки);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьСписокУникальныхПотолков()
	                   
	СписокПотолков = новый СписокЗначений;	
	
	Для Каждого ТекущаяСтрока Из Объект.Товары Цикл
		
		ЕстьДокументВыпускаПоПродукции = ЕстьДокументВыпускаПоПродукции(ТекущаяСтрока.Номенклатура, ТекущаяСтрока.ХарактеристикаНоменклатуры);

		Если Справочники.ВидыНоменклатуры.ЭтоНоменклатураУникальногоПотолкаИлиОтреза(ТекущаяСтрока.Номенклатура) Тогда
			ЕстьДокументВыпускаПоПродукции = ЕстьДокументВыпускаПоПродукции(ТекущаяСтрока.Номенклатура, ТекущаяСтрока.ХарактеристикаНоменклатуры);
			//Если НЕ ТекущаяСтрока.ЕстьДокументВыпускаПоПотолку Тогда
			Если НЕ ЕстьДокументВыпускаПоПродукции Тогда
				СтруктураСтрокиПотолка = Новый Структура;
				СтруктураСтрокиПотолка.Вставить("Потолок",ТекущаяСтрока.Номенклатура);
				СтруктураСтрокиПотолка.Вставить("УИСтроки",ТекущаяСтрока.УИСтроки);
				СписокПотолков.Добавить(СтруктураСтрокиПотолка);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Возврат СписокПотолков;
	
КонецФункции

//#7717
&НаСервере
Функция ПолучитьСписокУникальныхПозиций()
	
	СписокНоменклатуры = новый СписокЗначений;	
	Для Каждого ТекущаяСтрока Из Объект.Товары Цикл
		
		Если Справочники.ВидыНоменклатуры.ЭтоНоменклатураУникальногоПотолкаИлиОтреза(ТекущаяСтрока.Номенклатура) Тогда
			ЕстьДокументВыпускаПоПродукции = ЕстьДокументВыпускаПоПродукции(ТекущаяСтрока.Номенклатура, ТекущаяСтрока.ХарактеристикаНоменклатуры);
			//Если НЕ ТекущаяСтрока.ЕстьДокументВыпускаПоПотолку Тогда
			Если НЕ ЕстьДокументВыпускаПоПродукции Тогда
				СтруктураСтрокиПотолка = Новый Структура;
				СтруктураСтрокиПотолка.Вставить("Потолок",ТекущаяСтрока.Номенклатура);
				СтруктураСтрокиПотолка.Вставить("УИСтроки",ТекущаяСтрока.УИСтроки);
				СписокНоменклатуры.Добавить(СтруктураСтрокиПотолка);
			КонецЕсли;
		ИначеЕсли НЕ Справочники.ВидыНоменклатуры.ЭтоНоменклатураУслуга(ТекущаяСтрока.Номенклатура) Тогда
			Если ПустаяСтрока(ТекущаяСтрока.УИСтрокиРодителя) 
				ИЛИ ТекущаяСтрока.УИСтроки = ТекущаяСтрока.УИСтрокиРодителя Тогда
				СтруктураСтрокиПотолка = Новый Структура;
				СтруктураСтрокиПотолка.Вставить("Потолок", ТекущаяСтрока.Номенклатура);
				СтруктураСтрокиПотолка.Вставить("УИСтроки", ТекущаяСтрока.УИСтроки);
				СписокНоменклатуры.Добавить(СтруктураСтрокиПотолка);
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат СписокНоменклатуры;
	
КонецФункции


