			КонецЕсли;
		КонецЦикла;
		Если ЕстьСвязанныйЗнП Тогда	
			ЗаполнитьСтатусыПроизводстваПоТоварам();
			Если РежимПодробнаяИнформацияПоТоварам Тогда
				ЗаполнитьДанныеКОтгрузкеИОстаткиПоТоварам();
			КонецЕсли;
		КонецЕсли;
		
	ИначеЕсли ИмяСобытия = "Запись_РеализацияПоЗаказу" И НЕ Параметр.Найти(Объект.Ссылка) = Неопределено Тогда
		Если РежимПодробнаяИнформацияПоТоварам Тогда
			ЗаполнитьДанныеКОтгрузкеИОстаткиПоТоварам();
		КонецЕсли;
			
	ИначеЕсли Источник = "ПодключаемоеОборудование" И ИмяСобытия = "ScanData" И ВводДоступен() И НЕ ЭтаФорма.ТолькоПросмотр Тогда		
		ОбработатьШтрихкод(Параметр);
		
	ИначеЕсли ИмяСобытия = "ЗаписьДокументовПоРезервам" Тогда
		Если РежимПодробнаяИнформацияПоТоварам Тогда
			ЗаполнитьДанныеКОтгрузкеИОстаткиПоТоварам();
		КонецЕсли;
		
	ИначеЕсли ИмяСобытия = "ОбновитьСписокФайлов" Тогда
		ОбновитьСписокФайлов();
		
	//#9376
	ИначеЕсли ИмяСобытия = "ОбновитьЗаказПокупателяПослеСозданияЗаказовНаПроизводство" И Параметр = Объект.Ссылка Тогда

		// Формируем/актуализируем перемещение товаров по заказу покупателя после создания заказов
		// на производство (в главной сессии, последовательно — без дублей перемещений).
		СформироватьПеремещениеТоваровПоЗаказуНаСервере(Объект.Ссылка);
		ЭтотОбъект.Прочитать();

	//++ №10663
	ИначеЕсли ИмяСобытия = "ЗаписьЗаявкиНаДоставку" Тогда
		
		ЗаполнитьСсылкиНаДоставки();
	
	//-- №10663 
	
	ИначеЕсли ИмяСобытия = "ЗагрузкаДанныхИзПостроителяЗавершение" Тогда
	
		ЗагрузитьПотолокИзПостроителяЗавершение(Неопределено, Неопределено);	
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	
	Если ИсточникВыбора.ИмяФормы = "ОбщаяФорма.ФормаПодбораНоменклатуры" Тогда	
