&НаКлиенте
Процедура ЗагрузитьПотолокИзПостроителяПослеВыбораФайлов(ВыбранныеФайлы, ДополнительныеПараметры) Экспорт
	
	Если ВыбранныеФайлы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ВыбранныеФайлы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ОповещениеПослеЗакрытия = Новый ОписаниеОповещения("ЗагрузитьПотолокИзПостроителяЗавершение", ЭтаФорма);			
	ПараметрыФормыЗагрузки = Новый Структура;
	ПараметрыФормыЗагрузки.Вставить("ЗапускатьПриОткрытии", Истина);
	ПараметрыФормыЗагрузки.Вставить("НаКлиенте", Истина);
	СписокФайлов = Новый СписокЗначений;
	СписокФайлов.ЗагрузитьЗначения(ВыбранныеФайлы);
	ПараметрыФормыЗагрузки.Вставить("СписокФайлов", СписокФайлов);
	ПараметрыФормыЗагрузки.Вставить("ПоВладельцу", Истина);
	#Если ВебКлиент Тогда
		ОткрытьФорму("ОбщаяФорма.ФормаЗагрузкиДанныхИзПостроителя", ПараметрыФормыЗагрузки, ЭтаФорма,,,,ОповещениеПослеЗакрытия);
	#Иначе
		ОткрытьФорму("ОбщаяФорма.ФормаЗагрузкиИзПостроителя", ПараметрыФормыЗагрузки, ЭтаФорма,,,,ОповещениеПослеЗакрытия);
	#КонецЕсли
	

КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьПотолокИзПостроителяЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	//ЭтаФорма.Прочитать();
	
	Модифицированность = Истина;
	
	Если ТоварыКакДерево Тогда
		ПостроитьДеревоНаФорме();
	КонецЕсли;
	
	ЗаполнитьРеквизитыНоменклатурыТовара();
	
	//Объект.СуммаДокумента = Объект.Товары.Итог("Сумма");
	//ОбновитьДанныеДокумента();
	РассчитатьИтоговыеПоказателиКлиент();
	Если РежимПодробнаяИнформацияПоТоварам Тогда
		ЗаполнитьДанныеКОтгрузкеИОстаткиПоТоварам();
	КонецЕсли;
	ЗаполнитьДанныеОстаткиПоМатериалам(); //2022-05-23
		
	ПоказатьОповещениеПользователя("Данные загружены");
	
	ОповеститьПотолкиОбИзменении(); // на случай если изменились правила формирования наименования потолков 	
	
	ПерезаполнитьНомераПотолковПоТабличнойЧасти();
	Оповестить("ОбновитьСписокФайлов"); //#6233
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьПотолок(Команда)
	
	ПараметрыФормы = Новый Структура("РежимДобавленияПотолка", Истина);
	ОписаниеОповещения = Новый ОписаниеОповещения("ПослеВводаДанныхПотолкаОтреза", ЭтотОбъект, ПараметрыФормы);
	ОткрытьФорму("ОбщаяФорма.ФормаДобавленияПродукции",, ЭтотОбъект, ,,, ОписаниеОповещения);
	
