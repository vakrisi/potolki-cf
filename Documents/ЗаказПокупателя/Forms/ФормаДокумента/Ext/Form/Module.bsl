&НаКлиенте
Процедура ВыполнитьПроверкиИЗадатьВопросыПередЗаписью(Отказ, ПараметрыЗаписи)
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ПараметрыЗаписи", ПараметрыЗаписи);
	ДополнительныеПараметры.Вставить("ЭтотОбъект", ЭтотОбъект);
	
	Отказ = Ложь;
	
	//#16857
	Если ЗначениеЗаполнено(Объект.Ссылка)
		И Объект.ТекущийСтатус = ПредопределенноеЗначение("Справочник.СтатусыЗаказовПокупателей.Отменен")
		И ИспользоватьРезервирование Тогда
		
		ОстаткиПоРезервам = ОстаткиПоРезервам(Объект.Ссылка);
		Если ОстаткиПоРезервам.Количество() > 0 Тогда	
		
			ДополнительныеПараметры.Вставить("ОстаткиПоРезервам", ОстаткиПоРезервам);
			
			Отказ = Истина;
			ОписаниеОповещения = Новый ОписаниеОповещения("СписаниеРезервовПриОтменеПодтверждениеПередЗаписью", ЭтотОбъект, ДополнительныеПараметры);
			
			ТекстВопроса = "По заказу числятся неисполненные резервы:" + Символы.ПС;
			
			Для каждого Выборка из ОстаткиПоРезервам Цикл
				ТекстВопроса = ТекстВопроса + СтрШаблон("%1%2%3, склад %4, в количестве %5",
					Выборка.Номенклатура,
					?(НЕ ЗначениеЗаполнено(Выборка.ХарактеристикаНоменклатуры), "", ", Характеристика: " + Выборка.ХарактеристикаНоменклатуры),
					?(НЕ ЗначениеЗаполнено(Выборка.СерияНоменклатуры), "", ", Серия: " + Выборка.СерияНоменклатуры),
					Выборка.Склад,
					Выборка.Количество)
					+ Символы.ПС;
			КонецЦикла;
			ТекстВопроса = ТекстВопроса + Символы.ПС + "Создать документ ""Снятие резервов""?";	
				
			ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
		
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СписаниеРезервовПриОтменеПодтверждениеПередЗаписью(ОтветНаВопрос, ДополнительныеПараметры) Экспорт
	
	// если пользователь отказался снимать резервы, то все равно переводим в "Отменен"
		
	Отказ = Ложь;
	
	Если ОтветНаВопрос = КодВозвратаДиалога.Да Тогда
		ФормаСР = ПолучитьФорму("Документ.СнятиеРезервов.ФормаОбъекта");
		ДанныеФормы = ФормаСР.Объект; 
		ЗаполнитьДокументСнятиеРезервовНаСервере(ДанныеФормы, Объект.Ссылка);
		КопироватьДанныеФормы(ДанныеФормы, ФормаСР.Объект);
		ФормаСР.Открыть();
	КонецЕсли;
	//
	ДополнительныеПараметры.Вставить("Отказ", Отказ);
	ОбщийМодульКлиент.ЗаписатьОбъектПриНеобходимости(ЭтотОбъект, ДополнительныеПараметры.ПараметрыЗаписи,, Истина);
	
КонецПроцедуры

