&НаСервере
Процедура УдалитьУслугиТоварКПотолкуИзВремТЗ(Потолок, Номенклатура, Врем_ТЗ)
	
	//Удалим из Врем_ТЗ услугу, если найдем (она там должна быть)
	СтруктураПоиска = новый Структура("Номенклатура, Потолок", Номенклатура, Потолок);
	НайденныеСтрокиВрем = Врем_ТЗ.НайтиСтроки(СтруктураПоиска);
	Если НайденныеСтрокиВрем.Количество() > 0 Тогда						
		
		Для Сч = НайденныеСтрокиВрем.Количество()-1 По 0 Цикл
			
			Врем_ТЗ.Удалить(НайденныеСтрокиВрем[Сч]);
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры	

