Процедура КомандаОтгрузитьИПринятьОплату(Команда)
	
	Если Объект.ПометкаУдаления Тогда
		ПоказатьПредупреждение(,"Помеченный на удаление документ не может быть отгружен и оплачен");
		Возврат;
	КонецЕсли;
	Если Объект.ТекущийСтатус = ПредопределенноеЗначение("Справочник.СтатусыЗаказовПокупателей.Отменен") Тогда
		ПоказатьПредупреждение(,"Отмененный заказ не может быть отгружен и оплачен");
		Возврат;
	КонецЕсли;
	
	Если Модифицированность или НЕ Объект.Проведен Тогда
		ОП = Новый ОписаниеОповещения("ПослеВопросаОЗаписиДокументаПередЗакрытиемСДелки",ЭтаФорма);
		ПоказатьВопрос(ОП, "Перед закрытием сделки документ должен быть проведен." + Символы.ПС + "Провести документ?",РежимДиалогаВопрос.ДаНет,30,, "Провести документ?",);
	Иначе
		ОткрытьФормуЗакрытияСделки();
	КонецЕсли;	
		
КонецПроцедуры

