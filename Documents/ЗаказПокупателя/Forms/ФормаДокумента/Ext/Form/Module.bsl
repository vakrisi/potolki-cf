		//ОП = Новый ОписаниеОповещения("ПослеВопросаОЗаписиДокументаПередСозданиемДоставки", ЭтаФорма);
		//ПоказатьВопрос(ОП, "Необходимо записать документ, продолжить?", РежимДиалогаВопрос.ДаНет, 30,, "Запись документа");
		СтруктураЗаписи = Новый Структура;
		СтруктураЗаписи.Вставить("РежимЗаписи",РежимЗаписиДокумента.Проведение);
		СтруктураЗаписи.Вставить("РежимПроведения",РежимПроведенияДокумента.Оперативный);
	
		Если Записать(СтруктураЗаписи) Тогда
			ДекорацияСоздатьДоставкуНажатиеЗавершение();
		КонецЕсли;
		
	Иначе	
		
		ДекорацияСоздатьДоставкуНажатиеЗавершение();
		
	КонецЕсли;
	
КонецПроцедуры

