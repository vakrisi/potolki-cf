Функция ПолучитьЗаказНаПроизводствоПоПотолкуНаСервере(Потолок)
	
	ЗаказНаПроизводство = Документы.ЗаказНаПроизводство.ПустаяСсылка();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЗаказНаПроизводство.Ссылка
	|ИЗ
	|	Документ.ЗаказНаПроизводство КАК ЗаказНаПроизводство
	|ГДЕ
	|	ЗаказНаПроизводство.Проведен
	|	И ЗаказНаПроизводство.ПродукцияНоменклатура = &ПродукцияНоменклатура
	|
	|УПОРЯДОЧИТЬ ПО
	|	ЗаказНаПроизводство.Дата";
	Запрос.УстановитьПараметр("ПродукцияНоменклатура", Потолок);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ЗаказНаПроизводство = Выборка.Ссылка;
	КонецЦикла;
	
	Возврат ЗаказНаПроизводство;
	
