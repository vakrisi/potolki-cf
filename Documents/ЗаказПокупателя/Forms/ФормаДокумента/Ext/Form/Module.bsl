&НаКлиенте
Процедура ПослеВводаДанныхПотолкаОтреза(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	РежимДобавленияПотолка = ДополнительныеПараметры.Свойство("РежимДобавленияПотолка") И ДополнительныеПараметры.РежимДобавленияПотолка;
	// №12523 типового теперь нет, было: РежимДобавленияТиповогоОтреза = ДополнительныеПараметры.Свойство("РежимДобавленияТиповогоОтреза") И ДополнительныеПараметры.РежимДобавленияТиповогоОтреза;
	РежимДобавленияОтреза = ДополнительныеПараметры.Свойство("РежимДобавленияОтреза") И ДополнительныеПараметры.РежимДобавленияОтреза;

	// №12523 отрез тоже проверяем, было: Если РежимДобавленияПотолка
	Если НЕ ПроверитьНаличиеУникальнойПродукцииВТекущемЗаказе(Результат.Номенклатура, Ложь) Тогда
		Возврат;
	КонецЕсли;
	
	НоваяСтрока = Объект.Товары.Добавить();
	НоваяСтрока.Номенклатура = Результат.Номенклатура;
	НоваяСтрока.Количество = Результат.Количество;
	
	СтруктураДанные = СтруктураДанныхПоСтрокеТабличнойЧасти(НоваяСтрока);
	СтруктураДанные = ОбработкаТабличныхЧастейКлиент.ПолучитьДанныеНоменклатурыПриИзменении(СтруктураДанные);	
	
	ЗаполнитьЗначенияСвойств(НоваяСтрока, СтруктураДанные, "ЕдиницаИзмерения, Коэффициент, Спецификация");
	
	//++ №14537
	//НоваяСтрока.КоличествоКВыработке = НоваяСтрока.Количество; // №14311
	НоваяСтрока.КоличествоКВыработке = СтруктураДанные.Потолок_КоличествоВыработка;
	//-- №14537
	
	//НоваяСтрока.ЕдиницаИзмерения = ПолучитьБазовуюЕдиницуИзмеренияНоменклатуры(НоваяСтрока.Номенклатура);
	//НоваяСтрока.Коэффициент = 1;
	НоваяСтрока.СтавкаНДС = Объект.СтавкаНДС;

	СтруктураДанные = ПолучитьДанныеНоменклатурыПриИзменении(СтруктураДанные);
	ЗаполнитьЗначенияСвойств(НоваяСтрока, СтруктураДанные, "Цена, ЦенаВал");
	
	НоваяСтрока.ПроцентРучнойСкидки = ОбщийМодульВызовСервера.ПолучитьСкидкуПоВидуСкидки(Объект.ВидСкидки);
	ОбработкаТабличныхЧастейКлиент.ПересчитатьСуммуРучнойСкидкиВСтрокеТЧ(НоваяСтрока);
	
	//++ №13299
	//ОбработкаТабличныхЧастейКлиент.ПересчитатьСуммуСУчетомСкидокВСтрокеТЧ(НоваяСтрока, ИспользуютсяАвтоматическиеСкидки);
	ОбработкаТабличныхЧастейКлиент.ПересчитатьСуммуСУчетомСкидокВСтрокеТЧ(НоваяСтрока, ИспользуютсяАвтоматическиеСкидки,, Истина);
	//-- №13299
	
	ОбработкаТабличныхЧастейКлиент.ПересчитатьСуммуНДСВСтрокеТЧ(НоваяСтрока, УчитыватьНДС);
	
	НоваяСтрока.УИСтроки = Новый УникальныйИдентификатор;
	НоваяСтрока.УИСтрокиРодителя = НоваяСтрока.УИСтроки; //подчиним самому себе
	
	Если РежимДобавленияПотолка Тогда
		ОбновитьНоменклатуруПотолкаНаСервере(НоваяСтрока.Номенклатура, НоваяСтрока.УИСтроки, НоваяСтрока.Количество);
	КонецЕсли;
		
	// №12523 нужно отдельно выполнить для отреза, т.к. ОбновитьНоменклатуруПотолкаНаСервере теперь вызывается и для отреза
	// было: ИначеЕсли РежимДобавленияОтреза ИЛИ РежимДобавленияТиповогоОтреза Тогда
	Если РежимДобавленияОтреза Тогда
		ЗаполнитьМатериалыОтрезаНаСервере(НоваяСтрока.Номенклатура, НоваяСтрока.УИСтроки);
	КонецЕсли;
				
	//НоваяСтрока.Спецификация = ОбщийМодуль.ПолучитьОсновнуюСпецификациюНоменклатуры(НоваяСтрока.Номенклатура);
	Если НЕ НоваяСтрока.Спецификация.Пустая() Тогда
		ЗадатьВопросОПерезаполненииМатериловПоСпецификации(НоваяСтрока.Номенклатура, НоваяСтрока.УИСтроки);
	КонецЕсли;
				
	Модифицированность = Истина;			
	ПостроитьДеревоНаФорме();
	
	//ОбновитьДанныеДокумента();
	Если РежимПодробнаяИнформацияПоТоварам Тогда
		ЗаполнитьДанныеКОтгрузкеИОстаткиПоТоварам();
	КонецЕсли;
	РассчитатьИтоговыеПоказателиКлиент();

КонецПроцедуры

