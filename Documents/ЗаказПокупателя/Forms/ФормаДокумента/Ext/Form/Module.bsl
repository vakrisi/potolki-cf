&НаКлиенте
Процедура ДобавитьТоварыПоСпецификации(Команда)
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ВидСпецификации", ПредопределенноеЗначение("Перечисление.ВидыСпецификации.СпецификацияПродукции"));
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ДобавитьТоварыПоСпецификацииЗавершение", ЭтотОбъект);
	ОткрытьФорму("Справочник.Спецификации.Форма.ФормаПодбора", ПараметрыФормы, ЭтаФорма, , , , ОписаниеОповещения);
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьТоварыПоСпецификацииЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Модифицированность = Истина;
	ДобавитьПоСпецификацииНаСервере(Результат);
	ПостроитьДеревоНаФорме();	
	РазвернутьДеревоТоваров(Неопределено, Неопределено);
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьПоСпецификацииНаСервере(ВозвращенноеЗначение)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", ВозвращенноеЗначение.Спецификация);
	Запрос.УстановитьПараметр("КоличествоПользователя", ВозвращенноеЗначение.Количество);
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СпецификацииСостав.Номенклатура,
	|	СпецификацииСостав.ХарактеристикаНоменклатуры,
	|	СпецификацииСостав.ЕдиницаИзмерения,
	|	СпецификацииСостав.Коэффициент,
	|	СпецификацииСостав.Количество * &КоличествоПользователя КАК Количество
	|ИЗ
	|	Справочник.Спецификации.Состав КАК СпецификацииСостав
	|ГДЕ
	|	СпецификацииСостав.Ссылка = &Ссылка";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл 
		
		НоваяСтрока = Объект.Товары.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		
		НоваяСтрока.УИСтроки = новый УникальныйИдентификатор;
		
		СтруктураДанные = СтруктураДанныхПоСтрокеТабличнойЧастиСервер(НоваяСтрока);
		СтруктураДанные = ПолучитьДанныеНоменклатурыПриИзменении(СтруктураДанные);
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтруктураДанные, "Цена, ЦенаВал");
		ОбработкаТабличныхЧастейСервер.ПересчитатьСуммуСУчетомСкидокВСтрокеТЧ(НоваяСтрока, ИспользуютсяАвтоматическиеСкидки, , Истина);
			
		ПересчитатьЦенуИСуммуНоменклатурыВСтрокеПоВалюте(НоваяСтрока.НомерСтроки);
		НоваяСтрока.СтавкаНДС = Объект.СтавкаНДС;
		
		ОбработкаТабличныхЧастейСервер.ПересчитатьСуммуНДСВСтрокеТЧ(НоваяСтрока, УчитыватьНДС);
		
		НоваяСтрока.КоличествоКВыработке = НоваяСтрока.Количество; // №14311
		
	КонецЦикла;
		
	//ОбновитьДанныеДокумента();
	Если РежимПодробнаяИнформацияПоТоварам Тогда
		ЗаполнитьДанныеКОтгрузкеИОстаткиПоТоварам();
	КонецЕсли;
	РассчитатьИтоговыеПоказателиСервер();
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьНаценкуЗаСрочность(Команда)
	
	Результат = ДобавитьНаценкуЗаСрочностьНаСервере();
	ПоказатьПредупреждение(,Результат);
	
	Если ТоварыКакДерево Тогда 
		РазвернутьДеревоТоваров();
		СтруктураСтрокиПотолка = Новый Структура;
		СтруктураСтрокиПотолка.Вставить("Потолок", ПредопределенноеЗначение("Справочник.Номенклатура.ПустаяСсылка"));
		СтруктураСтрокиПотолка.Вставить("УИСтроки", "");
		
		ДобавленнаяСтрока = НайтиСтрокуДереваТоваровУслуг(КонстантыСрочностьУслугаПолучить(), СтруктураСтрокиПотолка);
		Если НЕ ДобавленнаяСтрока = Неопределено Тогда
			Элементы.ТоварыДерево.ТекущаяСтрока = ДобавленнаяСтрока.ПолучитьИдентификатор();
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ДобавитьНаценкуЗаСрочностьНаСервере()
	
	УслугаСрочность = Константы.СрочностьУслуга.Получить();
	Если УслугаСрочность.Пустая() Тогда
		Возврат "В настройках программы не задана услуга срочности";
	КонецЕсли;
	
	ПроцентСрочность = Константы.СрочностьПроцент.Получить();
	Если ПроцентСрочность = 0 Тогда
		Возврат "В настройках программы не указана стоимость в % за срочность";
	КонецЕсли;
	
	СтрокаНаценкаЗаСрочность = Неопределено;
	СуммаЗаказаБезНаценкиЗаСрочность = 0;
	
	Если ТоварыКакДерево Тогда
		
		Дерево = ДанныеФормыВЗначение(ТоварыДерево, Тип("ДеревоЗначений"));
		
		Для Каждого ВерхняяСтрока Из Дерево.Строки Цикл
			Если ВерхняяСтрока.Строки.Количество() = 0 Тогда
				Если НЕ ВерхняяСтрока.Номенклатура = УслугаСрочность Тогда
					СуммаЗаказаБезНаценкиЗаСрочность = СуммаЗаказаБезНаценкиЗаСрочность + ВерхняяСтрока.Сумма;
				Иначе
					СтрокаНаценкаЗаСрочность = ВерхняяСтрока;
				КонецЕсли;
			Иначе
				Для Каждого ПодчиненнаяСтрока Из ВерхняяСтрока.Строки Цикл
					Если НЕ ПодчиненнаяСтрока.Номенклатура = УслугаСрочность Тогда
						СуммаЗаказаБезНаценкиЗаСрочность = СуммаЗаказаБезНаценкиЗаСрочность + ПодчиненнаяСтрока.Сумма;
					Иначе
						СтрокаНаценкаЗаСрочность = ПодчиненнаяСтрока;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
		КонецЦикла;
		
		Если НЕ СтрокаНаценкаЗаСрочность = Неопределено Тогда
			СтрокаНаценкаЗаСрочность.ЕдиницаИзмерения = СтрокаНаценкаЗаСрочность.Номенклатура.БазоваяЕдиницаИзмерения;
			СтрокаНаценкаЗаСрочность.Количество = 1;
			СтрокаНаценкаЗаСрочность.Коэффициент = 1;
			СтрокаНаценкаЗаСрочность.Цена = СуммаЗаказаБезНаценкиЗаСрочность * ПроцентСрочность / 100;
			СтрокаНаценкаЗаСрочность.Сумма = СтрокаНаценкаЗаСрочность.Цена;
			Если ПустаяСтрока(СтрокаНаценкаЗаСрочность.УИСтроки) Тогда
				СтрокаНаценкаЗаСрочность.УИСтроки = новый УникальныйИдентификатор;
			КонецЕсли;
			СтрокаНаценкаЗаСрочность.СтавкаНДС = Объект.СтавкаНДС;
			ОбработкаТабличныхЧастейСервер.ПересчитатьСуммуНДСВСтрокеТЧ(СтрокаНаценкаЗаСрочность, УчитыватьНДС);
			Результат = "Обновлена стоимость за срочность";
		Иначе
			НоваяСтрока = Дерево.Строки.Добавить();
			НоваяСтрока.Номенклатура = УслугаСрочность;
			НоваяСтрока.ЕдиницаИзмерения = НоваяСтрока.Номенклатура.БазоваяЕдиницаИзмерения;
			НоваяСтрока.Количество = 1;
			НоваяСтрока.Коэффициент = 1;
			НоваяСтрока.Цена = СуммаЗаказаБезНаценкиЗаСрочность * ПроцентСрочность / 100;
			НоваяСтрока.Сумма = НоваяСтрока.Цена;
			НоваяСтрока.УИСтроки = новый УникальныйИдентификатор;
			НоваяСтрока.СтавкаНДС = Объект.СтавкаНДС;
			ОбработкаТабличныхЧастейСервер.ПересчитатьСуммуНДСВСтрокеТЧ(НоваяСтрока, УчитыватьНДС);
			Результат = "Добавлена стоимость за срочность";
			СтрокаНаценкаЗаСрочность = НоваяСтрока;
		КонецЕсли;
		
		ЗначениеВДанныеФормы(Дерево, ТоварыДерево);
		
		ПеренестиДеревоВТабличнуюЧасть();

	Иначе
		
		Для Каждого ТекущаяСтрока Из Объект.Товары Цикл
			Если НЕ ТекущаяСтрока.Номенклатура = УслугаСрочность Тогда
				СуммаЗаказаБезНаценкиЗаСрочность = СуммаЗаказаБезНаценкиЗаСрочность + ТекущаяСтрока.Сумма;
			Иначе
				СтрокаНаценкаЗаСрочность = ТекущаяСтрока;
			КонецЕсли;
		КонецЦикла;
		
		Если НЕ СтрокаНаценкаЗаСрочность = Неопределено Тогда
			СтрокаНаценкаЗаСрочность.ЕдиницаИзмерения = СтрокаНаценкаЗаСрочность.Номенклатура.БазоваяЕдиницаИзмерения;
			СтрокаНаценкаЗаСрочность.Количество = 1;
			СтрокаНаценкаЗаСрочность.Коэффициент = 1;
			СтрокаНаценкаЗаСрочность.Цена = СуммаЗаказаБезНаценкиЗаСрочность * ПроцентСрочность / 100;
			СтрокаНаценкаЗаСрочность.Сумма = СтрокаНаценкаЗаСрочность.Цена;
			Если ПустаяСтрока(СтрокаНаценкаЗаСрочность.УИСтроки) Тогда
				СтрокаНаценкаЗаСрочность.УИСтроки = новый УникальныйИдентификатор;
			КонецЕсли;
			СтрокаНаценкаЗаСрочность.СтавкаНДС = Объект.СтавкаНДС;
			ОбработкаТабличныхЧастейСервер.ПересчитатьСуммуНДСВСтрокеТЧ(СтрокаНаценкаЗаСрочность, УчитыватьНДС);
			Результат = "Обновлена стоимость за срочность";
		Иначе
			НоваяСтрока = Объект.Товары.Добавить();
			НоваяСтрока.Номенклатура = УслугаСрочность;
			НоваяСтрока.ЕдиницаИзмерения = НоваяСтрока.Номенклатура.БазоваяЕдиницаИзмерения;
			НоваяСтрока.Количество = 1;
			НоваяСтрока.Коэффициент = 1;
			НоваяСтрока.Цена = СуммаЗаказаБезНаценкиЗаСрочность * ПроцентСрочность / 100;
			НоваяСтрока.Сумма = НоваяСтрока.Цена;
			НоваяСтрока.УИСтроки = новый УникальныйИдентификатор;
			НоваяСтрока.СтавкаНДС = Объект.СтавкаНДС;
			ОбработкаТабличныхЧастейСервер.ПересчитатьСуммуНДСВСтрокеТЧ(НоваяСтрока, УчитыватьНДС);
			Результат = "Добавлена стоимость за срочность";
		КонецЕсли;
		
	КонецЕсли;
	
	Модифицированность = Истина;
	
	Если РежимПодробнаяИнформацияПоТоварам Тогда
		ЗаполнитьДанныеКОтгрузкеИОстаткиПоТоварам();
	КонецЕсли;
	РассчитатьИтоговыеПоказателиСервер();
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура РаспределитьПоПотребностиЗаказДоговора(Команда)
	
	Если НЕ ТипЗнч(Объект.Основание) = Тип("ДокументСсылка.ЗаказДоговор") ИЛИ НЕ ЗначениеЗаполнено(Объект.Основание) Тогда
		ПоказатьПредупреждение(,"Документ не на основании заказ-договора");
		Возврат;
	КонецЕсли;
	
	Режим = РежимДиалогаВопрос.ДаНет;
	Оповещение = Новый ОписаниеОповещения("ПослеВопросаОРаспределенииПоОбеспечению", ЭтаФорма);
	ПоказатьВопрос(Оповещение, "Распределить по потребности заказ-договора?", Режим, 0);

КонецПроцедуры

&НаКлиенте
Процедура ПослеВопросаОРаспределенииПоОбеспечению(Результат, Параметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
        РаспределитьПоПотребностиЗаказДоговораНаСервере();
		Модифицированность = Истина;
		
		
		ПостроитьДеревоНаФорме();
		РазвернутьДеревоТоваров();		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура РаспределитьПоПотребностиЗаказДоговораНаСервере()
	
	ТоварыДокумента = Объект.Товары.Выгрузить();
	ТоварыРаспределение = ТоварыДокумента.СкопироватьКолонки();
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("Основание", Объект.Основание);
	СтруктураПараметров.Вставить("Ссылка", Объект.Ссылка);
	СтруктураПараметров.Вставить("УчетОбеспеченностиРозницыПоКомнатам", Объект.СозданПриИспользованииНастройкиУчетОбеспеченностиРозницыПоКомнатам);
	
	ОбработкаТабличныхЧастейСервер.РаспределитьПоПотребностиЗаказДоговора(ТоварыДокумента, ТоварыРаспределение, СтруктураПараметров); 
		
	Объект.Товары.Загрузить(ТоварыРаспределение);
		
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьСкидки(Команда)
	
	УстановитьСкидкуНаСервере(0);
	Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура Округлить(Команда)

	ОповещениеОЗакрытии = Новый ОписаниеОповещения("ПослеВыбораПравилОкругления", ЭтаФорма);
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ТипВладельца", "ЗаказПокупателя");
	ПараметрыФормы.Вставить("ЗапретИзмененияЦен", ЗапретИзмененияЦен); //#15422
	ПараметрыФормы.Вставить("ЗапретСкидок", ЗапретСкидок);             //#15422
	ОткрытьФорму("ОбщаяФорма.ФормаНастроекОкругления",ПараметрыФормы,,,,,ОповещениеОЗакрытии);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораПравилОкругления(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ОкруглитьСтоимостьНаСервере(Результат);
	ПостроитьДеревоНаФорме();
	ОбновитьДанныеДокумента();
	РазвернутьДеревоТоваров();
	Модифицированность = Истина;
		
КонецПроцедуры

&НаСервере
Процедура ОкруглитьСтоимостьНаСервере(НастройкиОкругления)
	
	//НастройкиОкругления = Структура - "ПорядокОкругления, ОкруглятьВБольшуюСторону, СпособОкругления, ВариантОкругления"
	// СпособОкругления  - Округление сумм по строкам(0), Округление цен по строкам(1), Округление общей суммы(2)
	// ВариантОкругления - Изменять цену(0), Изменять сумму ручной скидки(1)
	
	Если НастройкиОкругления.СпособОкругления = 0 Тогда	
		Для каждого СтрокаТЧ из Объект.Товары Цикл
			ОбработкаТабличныхЧастейСервер.ОкруглитьСтрокуТЧ(СтрокаТЧ, 
												НастройкиОкругления.ПорядокОкругления, НастройкиОкругления.ОкруглятьВБольшуюСторону, НастройкиОкругления.ВариантОкругления, 
												"ПроцентРучнойСкидки", "СуммаРучнойСкидки");
		КонецЦикла;
		
	ИначеЕсли НастройкиОкругления.СпособОкругления = 1 Тогда		
		Для каждого СтрокаТЧ из Объект.Товары Цикл
			СтрокаТЧ.Цена = ОбщийМодуль.ОкруглитьЧисло(СтрокаТЧ.Цена, НастройкиОкругления.ПорядокОкругления, НастройкиОкругления.ОкруглятьВБольшуюСторону);
			
			ОбработкаТабличныхЧастейСервер.ПересчитатьСуммуРучнойСкидкиВСтрокеТЧ(СтрокаТЧ);
			ОбработкаТабличныхЧастейСервер.ПересчитатьСуммуСУчетомСкидокВСтрокеТЧ(СтрокаТЧ, ИспользуютсяАвтоматическиеСкидки, Истина, Истина);
			ОбработкаТабличныхЧастейСервер.ПересчитатьСуммуНДСВСтрокеТЧ(СтрокаТЧ, УчитыватьНДС);
			
			Если Объект.ЦенаВДополнительнойВалютеУчетаЗапасов Тогда
				СтруктураДанные = СтруктураДанныхПоСтрокеТабличнойЧастиСервер(СтрокаТЧ);
				ОбработкаТабличныхЧастейКлиентСервер.ПересчитатьЦенуВалПоЦенеВСтрокеТЧ(СтрокаТЧ, СтруктураДанные);
			КонецЕсли;
		КонецЦикла;
		
	ИначеЕсли НастройкиОкругления.СпособОкругления = 2 Тогда
		СуммаДокументаДоОкругления = Объект.СуммаДокумента;
		Если СуммаДокументаДоОкругления = 0 Тогда
			Возврат;
		КонецЕсли;
		СуммаДокумента = ОбщийМодуль.ОкруглитьЧисло(СуммаДокументаДоОкругления, НастройкиОкругления.ПорядокОкругления, НастройкиОкругления.ОкруглятьВБольшуюСторону);
		Для каждого СтрокаТЧ из Объект.Товары Цикл
			Если СтрокаТЧ.НомерСтроки = Объект.Товары.Количество() Тогда
				СтрокаТЧ.Сумма = СуммаДокумента - (Объект.Товары.Итог("Сумма") - СтрокаТЧ.Сумма);
			Иначе
				СтрокаТЧ.Сумма = СуммаДокумента * СтрокаТЧ.Сумма / СуммаДокументаДоОкругления;
			КонецЕсли;
			ОбработкаТабличныхЧастейСервер.ПересчитатьСуммуНДСВСтрокеТЧ(СтрокаТЧ, УчитыватьНДС);
			
			Если НастройкиОкругления.ВариантОкругления = 0 Тогда
				ОбработкаТабличныхЧастейСервер.ПересчитатьПроцентРучнойСкидкиВСтрокеТЧ(СтрокаТЧ);
				СуммаБезСкидки = СтрокаТЧ.Сумма + СтрокаТЧ.СуммаРучнойСкидки;
				Если НЕ СтрокаТЧ.Количество = 0 Тогда
					СтрокаТЧ.Цена = Окр(СуммаБезСкидки / СтрокаТЧ.Количество, 2);
					Если Объект.ЦенаВДополнительнойВалютеУчетаЗапасов Тогда
						СтруктураДанные = СтруктураДанныхПоСтрокеТабличнойЧастиСервер(СтрокаТЧ);
						ОбработкаТабличныхЧастейКлиентСервер.ПересчитатьЦенуВалПоЦенеВСтрокеТЧ(СтрокаТЧ, СтруктураДанные);
					КонецЕсли;

				КонецЕсли;
			Иначе
				СтрокаТЧ.СуммаРучнойСкидки = СтрокаТЧ.Количество*СтрокаТЧ.Цена - СтрокаТЧ.Сумма;
				ОбработкаТабличныхЧастейСервер.ПересчитатьПроцентРучнойСкидкиВСтрокеТЧ(СтрокаТЧ);
			КонецЕсли;
		КонецЦикла;

	КонецЕсли;
	
КонецПроцедуры

