&НаСервере
Процедура ПерезаполнитьНомераПотолковПоДеревуНаСервере()
	
	ТаблицаНомеров = Новый ТаблицаЗначений;
	ТаблицаНомеров.Колонки.Добавить("Номер");
	
	Дерево = ДанныеФормыВЗначение(ТоварыДерево, Тип("ДеревоЗначений"));
	Для Каждого ВерхняяСтрока Из Дерево.Строки Цикл
		Если ВерхняяСтрока.Строки.Количество() > 0 Тогда
			Для Каждого НижняяСтрока Из ВерхняяСтрока.Строки Цикл
				НомерПотолка = НижняяСтрока.Номенклатура.Потолок_НомерРасчета;
				Если НЕ ПустаяСтрока(НижняяСтрока.Номенклатура.Потолок_ИндексПотолка) Тогда
					НомерПотолка = НижняяСтрока.Номенклатура.Потолок_ИндексПотолка+"-"+НомерПотолка;
				КонецЕсли;
				Если НЕ ПустаяСтрока(НомерПотолка) Тогда
					НоваяСтрока = ТаблицаНомеров.Добавить();
					НоваяСтрока.Номер = НомерПотолка;
				КонецЕсли;
			КонецЦикла;
		Иначе
			НомерПотолка = ВерхняяСтрока.Номенклатура.Потолок_НомерРасчета;
			Если НЕ ПустаяСтрока(ВерхняяСтрока.Номенклатура.Потолок_ИндексПотолка) Тогда
				НомерПотолка = ВерхняяСтрока.Номенклатура.Потолок_ИндексПотолка+"-"+НомерПотолка;
			КонецЕсли;
			Если НЕ ПустаяСтрока(НомерПотолка) Тогда
				НоваяСтрока = ТаблицаНомеров.Добавить();
				НоваяСтрока.Номер = НомерПотолка;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	ТаблицаНомеров.Свернуть("Номер");
	Объект.НомераПотолков = "";
	Ном = 0;
	Для Каждого СтрокаНомер Из ТаблицаНомеров Цикл
		Если Ном > 0 Тогда
			Объект.НомераПотолков = Объект.НомераПотолков + "; ";
		КонецЕсли;
		Объект.НомераПотолков = Объект.НомераПотолков + СтрокаНомер.Номер;
		Ном = Ном + 1;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ПерезаполнитьНомераПотолковПоТабличнойЧастиНаСервере()
	
	ТаблицаНомеров = Новый ТаблицаЗначений;
	ТаблицаНомеров.Колонки.Добавить("Номер");
	
	Для Каждого ВерхняяСтрока Из Объект.Товары Цикл
		НомерПотолка = ВерхняяСтрока.Номенклатура.Потолок_НомерРасчета;
		Если НЕ ПустаяСтрока(ВерхняяСтрока.Номенклатура.Потолок_ИндексПотолка) Тогда
			НомерПотолка = ВерхняяСтрока.Номенклатура.Потолок_ИндексПотолка+"-"+НомерПотолка;
		КонецЕсли;
		Если НЕ ПустаяСтрока(НомерПотолка) Тогда
			НоваяСтрока = ТаблицаНомеров.Добавить();
			НоваяСтрока.Номер = НомерПотолка;
		КонецЕсли;
	КонецЦикла;
	
	ТаблицаНомеров.Свернуть("Номер");
	Объект.НомераПотолков = "";
	Ном = 0;
	Для Каждого СтрокаНомер Из ТаблицаНомеров Цикл
		Если Ном > 0 Тогда
			Объект.НомераПотолков = Объект.НомераПотолков + "; ";
		КонецЕсли;
		Объект.НомераПотолков = Объект.НомераПотолков + СтрокаНомер.Номер;
		Ном = Ном + 1;
	КонецЦикла;
		
КонецПроцедуры

&НаКлиенте
Процедура ПерезаполнитьНомераПотолковПоТабличнойЧасти()
	
	МассивНомеров = Новый Массив;
	
	Для Каждого СтрокаТЧ Из Объект.Товары Цикл
		НомерПотолка = СтрокаТЧ.НомерРасчета;
		Если НЕ ПустаяСтрока(СтрокаТЧ.ИндексПотолка) Тогда
			НомерПотолка = СтрокаТЧ.ИндексПотолка + "-" + НомерПотолка;
		КонецЕсли;
		Если НЕ ПустаяСтрока(НомерПотолка) И МассивНомеров.Найти(НомерПотолка)  = Неопределено Тогда
			МассивНомеров.Добавить(НомерПотолка);
		КонецЕсли;
	КонецЦикла;
	
	Объект.НомераПотолков = СтрСоединить(МассивНомеров, "; ");
		
КонецПроцедуры

