&НаКлиенте
Процедура РазвернутьДеревоТоваров(Потолок = Неопределено, Номенклатура = Неопределено)
	
	Если НЕ ТоварыКакДерево Тогда
		Возврат;
	КонецЕсли;
		
	ИдТекущейСтроки = Неопределено;
	КоллекцияЭлементовДерева = ЭтаФорма.ТоварыДерево.ПолучитьЭлементы();
	Для Каждого СтрокаПотолок Из КоллекцияЭлементовДерева Цикл    
		ИдВерхнейСтроки = СтрокаПотолок.ПолучитьИдентификатор();
		Если СтрокаПотолок.Потолок = Потолок И СтрокаПотолок.Номенклатура = Номенклатура Тогда
			ИдТекущейСтроки = СтрокаПотолок.ПолучитьИдентификатор();
		Иначе
			Для Каждого СтрокаНоменклатура Из СтрокаПотолок.ПолучитьЭлементы() Цикл
				Если СтрокаНоменклатура.Потолок = Потолок И СтрокаНоменклатура.Номенклатура = Номенклатура Тогда
					ИдТекущейСтроки = СтрокаНоменклатура.ПолучитьИдентификатор();
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		Элементы.ТоварыДерево.Развернуть(ИдВерхнейСтроки, Истина);
	КонецЦикла;
	
	Элементы.ТоварыДерево.ТекущаяСтрока = ИдТекущейСтроки;
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьСтрокуТоварыДерево(Команда)
	
	Если НЕ Элементы.ТоварыДерево.ТекущиеДанные = Неопределено Тогда
		ТекПотолок = Элементы.ТоварыДерево.ТекущиеДанные.Потолок;
		УИстроки = Элементы.ТоварыДерево.ТекущиеДанные.УИстроки;
	Иначе 
		ТекПотолок = Неопределено;
		УИстроки = "";
	КонецЕсли;
	
	Если НЕ ТекПотолок = Неопределено Тогда
		//Если И НЕ ВыпущенныеПотолки.НайтиПоЗначению(ТекПотолок) = Неопределено Тогда
		Если ЕстьДокументВыпускаПоПродукции(ТекПотолок) Тогда
			ПоказатьПредупреждение(,"По данному потолку уже имеется выпуск. Редактирование не доступно. Предварительно следует отменить выпуск продукции");
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	СтруктураСтрокиПотолка = Новый Структура;
	СтруктураСтрокиПотолка.Вставить("Потолок", ТекПотолок);
	СтруктураСтрокиПотолка.Вставить("УИСтроки", УИстроки);
	
	ОткрытьФорму("Справочник.Номенклатура.ФормаВыбора",,,,,,Новый ОписаниеОповещения("ПослеВыбораНоменклатурыДляСтрокиДерева", ЭтаФорма, СтруктураСтрокиПотолка));
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораНоменклатурыДляСтрокиДерева(ВыбранноеЗначение, ДопПараметры) Экспорт
	
	Если ВыбранноеЗначение = Неопределено Тогда
		Возврат;
	КонецЕсли;	
	
	Если ПроверитьСписокЗаказовПокупателейСЭтойПродукцией(ВыбранноеЗначение)
		И ПроверитьНаличиеУникальнойПродукцииВТекущемЗаказе(ВыбранноеЗначение, Ложь) Тогда
		
		Спецификация = ПредопределенноеЗначение("Справочник.Спецификации.ПустаяСсылка");
		УИСтроки = "";
		
		ПослеВыбораНоменклатурыНаСервере(ВыбранноеЗначение, ДопПараметры, Спецификация, УИСтроки);
		
		ПеренестиДеревоВТабличнуюЧасть();
		
		//Если это потолок, его нужно расщепить на услуги, материалы и товары так как это делается через построитель
		Если ЭтоНоменклатураУникальногоПотолкаИлиОтреза(ВыбранноеЗначение) Тогда
			ОбновитьНоменклатуруПотолкаНаСервере(ВыбранноеЗначение, УИСтроки);				
		КонецЕсли;
		
		Если РежимПодробнаяИнформацияПоТоварам Тогда
			ЗаполнитьДанныеКОтгрузкеИОстаткиПоТоварам();
		КонецЕсли;
		
		//ОбновитьДанныеДокумента();
		Модифицированность = Истина;
		
		РазвернутьДеревоТоваров();
		ДобавленнаяСтрока = НайтиСтрокуДереваТоваровУслуг(ВыбранноеЗначение, ДопПараметры); //ПредопределенноеЗначение("Справочник.Номенклатура.ПустаяСсылка"));
		Если НЕ ДобавленнаяСтрока = Неопределено Тогда
			Элементы.ТоварыДерево.ТекущаяСтрока = ДобавленнаяСтрока.ПолучитьИдентификатор();				
		КонецЕсли;		
		
		Если НЕ Спецификация.Пустая() Тогда
			ЗадатьВопросОПерезаполненииМатериловПоСпецификации(ВыбранноеЗначение, УИСтроки);
		КонецЕсли;
		
	КонецЕсли; 		
		
КонецПроцедуры

&НаКлиенте
Функция НайтиСтрокуДереваТоваровУслуг(Номенклатура, СтруктураСтрокиПотолка)
	ЭлементыДерева = ТоварыДерево.ПолучитьЭлементы();
	Для Каждого ТекЭлемент из ЭлементыДерева Цикл
		Если ТекЭлемент.Номенклатура = Номенклатура и ТекЭлемент.Потолок = СтруктураСтрокиПотолка.Потолок И ТекЭлемент.УИСтроки = СтруктураСтрокиПотолка.УИСтроки Тогда
			Возврат ТекЭлемент;
		Иначе
			ПодчиненныеСтроки = ТекЭлемент.ПолучитьЭлементы();
			Для Каждого ПодчиненыйЭлемент Из ПодчиненныеСтроки Цикл
				Если ПодчиненыйЭлемент.Потолок = СтруктураСтрокиПотолка.Потолок
					и ПодчиненыйЭлемент.Номенклатура = Номенклатура
					и ПодчиненыйЭлемент.УИСтроки = СтруктураСтрокиПотолка.УИСтроки
					Тогда
					Возврат ПодчиненыйЭлемент;
				КонецеСли;
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

&НаСервере
Процедура ПослеВыбораНоменклатурыНаСервере(ВыбЗнач, ДопПараметры, Спецификация, УИСтроки)
	
	Дерево = ДанныеФормыВЗначение(ТоварыДерево, Тип("ДеревоЗначений"));
	
	СтрокаПотолка = ПолучитьУказательНаСтрокуСПотолком(Дерево, ДопПараметры.Потолок, ДопПараметры.УИСтроки);
	Если СтрокаПотолка = Неопределено Тогда
		Стр = Дерево.Строки.Добавить();
		Стр.УИСтрокиРодителя = ДопПараметры.УИСтроки;
		Стр.УИСтроки = Новый УникальныйИдентификатор;
		Стр.УИСтрокиРодителя = Стр.УИСтроки;
	Иначе
		Стр = СтрокаПотолка.Строки.Добавить();
		Стр.УИСтроки = Новый УникальныйИдентификатор;
		Стр.УИСтрокиРодителя = СтрокаПотолка.УИСтроки;
	КонецЕсли;

	Если Справочники.ВидыНоменклатуры.ЭтоНоменклатураПотолкаИлиОтреза(ВыбЗнач) Тогда //**
		Стр.Номенклатура = ВыбЗнач;
		Стр.ВидНоменклатуры = Стр.Номенклатура.ВидНоменклатуры; 
		Стр.ЕдиницаИзмерения = ОбщийМодульВызовСервера.ПолучитьБазовуюЕдиницуИзмеренияНоменклатуры(Стр.Номенклатура);
		Стр.Коэффициент = 1;
		Стр.Количество = 1;
		
		Стр = Стр.Строки.Добавить();
		Стр.Потолок = ВыбЗнач;
	Иначе
		Стр.Потолок = ДопПараметры.Потолок;	
	КонецЕсли;
	
	Стр.Номенклатура = ВыбЗнач;
	
	//Стр.ВидНоменклатуры = Стр.Номенклатура.ВидНоменклатуры; 
	//Стр.ЕдиницаИзмерения = ПолучитьБазовуюЕдиницуИзмеренияНоменклатуры(Стр.Номенклатура);
	//Стр.Коэффициент = 1;
	Стр.Количество = 1;
	//Стр.Цена = ПолучитьЦенуНоменклатуры(Стр.Номенклатура, Стр.ХарактеристикаНоменклатуры, Стр.ЕдиницаИзмерения);
	
	СтруктураДанные = СтруктураДанныхПоСтрокеТабличнойЧастиСервер(Стр);
	СтруктураДанные = ОбщийМодульВызовСервера.ПолучитьДанныеНоменклатурыПриИзменении(СтруктураДанные);	
	ЗаполнитьЗначенияСвойств(Стр, СтруктураДанные, "ЕдиницаИзмерения, Коэффициент, ВидНоменклатуры, Спецификация");
	
	СтруктураДанные = ПолучитьДанныеНоменклатурыПриИзменении(СтруктураДанные);
	ЗаполнитьЗначенияСвойств(Стр, СтруктураДанные, "Цена, ЦенаВал, Коэффициент, Количество"); //#2792 добавлено количество 

    Стр.СтавкаНДС = Объект.СтавкаНДС;
	
	// №14311 Если ЭтоУслуга(Стр.Номенклатура) Тогда
		Стр.КоличествоКВыработке = Стр.Количество;
	//КонецЕсли;
	
	Стр.ПроцентРучнойСкидки = ОбщийМодульВызовСервера.ПолучитьСкидкуПоВидуСкидки(Объект.ВидСкидки);
	ОбработкаТабличныхЧастейСервер.ПересчитатьСуммуРучнойСкидкиВСтрокеТЧ(Стр);			
	
	ОбработкаТабличныхЧастейСервер.ПересчитатьСуммуСУчетомСкидокВСтрокеТЧ(Стр, ИспользуютсяАвтоматическиеСкидки, Истина, Истина);
	ОбработкаТабличныхЧастейСервер.ПересчитатьСуммуНДСВСтрокеТЧ(Стр, УчитыватьНДС);
	
	//Стр.Спецификация = ОбщийМодуль.ПолучитьОсновнуюСпецификациюНоменклатуры(Стр.Номенклатура);
	Спецификация = Стр.Спецификация;
	УИСтроки = Стр.УИСтроки;
	
	ЗначениеВДанныеФормы(Дерево, ТоварыДерево);
		
КонецПроцедуры

