&НаКлиенте
Процедура ЗадатьВопросОПересчетеКоличестваКВыработке(СтрокаТабличнойЧасти, ВМатериалы = Ложь)
	
	// Если предыдущие значения "К выработке" <> "Количество" и "К выработке" <> 0, то после изменения "Количество" предлагать "К выработке" предыдущее значение
	Если НЕ мПрерыдущееКоличество = Неопределено
		И НЕ мПредыдущееКоличествоКВыработке = Неопределено
		И мПрерыдущееКоличество > 0
		И мПредыдущееКоличествоКВыработке > 0
		И НЕ мПрерыдущееКоличество = мПредыдущееКоличествоКВыработке Тогда
		
		КоличествоКВыработке = мПредыдущееКоличествоКВыработке; // было (расчет по пропорции): СтрокаТабличнойЧасти.Количество * (мПредыдущееКоличествоКВыработке / мПрерыдущееКоличество);
		
		ОписаниеОповещения = новый ОписаниеОповещения("ПослеВводаЗначенияКоличествоКВыработке", ЭтотОбъект, Новый Структура("ИдТекущейСтроки, ВМатериалы", СтрокаТабличнойЧасти.ПолучитьИдентификатор(), ВМатериалы));
		ПоказатьВводЧисла(ОписаниеОповещения, КоличествоКВыработке, "Подтвердите значение ""К выработке"".", 15, 2);
		
	Иначе
		
		СтрокаТабличнойЧасти.КоличествоКВыработке = СтрокаТабличнойЧасти.Количество;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВводаЗначенияКоличествоКВыработке(Значение, ДополнительныеПараметры) Экспорт
	
	Если Значение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ДополнительныеПараметры.ВМатериалы Тогда
		
		Элементы.Материалы.ТекущаяСтрока = ДополнительныеПараметры.ИдТекущейСтроки;
		ТекущаяСтрока = Элементы.Материалы.ТекущиеДанные;
		
	Иначе
		
		Если ТоварыКакДерево Тогда
			
			Элементы.ТоварыДерево.ТекущаяСтрока = ДополнительныеПараметры.ИдТекущейСтроки;
			ТекущаяСтрока = Элементы.ТоварыДерево.ТекущиеДанные;
			
		Иначе
			
			Элементы.Товары.ТекущаяСтрока = ДополнительныеПараметры.ИдТекущейСтроки;
			ТекущаяСтрока = Элементы.Товары.ТекущиеДанные;
			
		КонецЕсли;
		
	КонецЕсли;
	
	ТекущаяСтрока.КоличествоКВыработке = Значение;
	
КонецПроцедуры

