&НаКлиенте
Процедура ВнутреннийЗаказПриИзменении(Элемент)
//#7806

	УстановитьВидимостьПоИнтеркампаниИВнутреннемуЗаказу();
	
	Если Объект.ВнутреннийЗаказ Тогда
		Объект.НастройкаИнтеркампани = ПредопределенноеЗначение("Справочник.НастройкиИнтеркампани.ПустаяСсылка");
		
		Если НЕ ОтображатьКонтрагентаВоВнутреннихЗаказах Тогда
			Если НЕ Объект.Контрагент.Пустая() Тогда
				Объект.Контрагент = ПредопределенноеЗначение("Справочник.Контрагенты.ПустаяСсылка");
			КонецЕсли;
			Если НЕ Объект.ДоговорКонтрагента.Пустая() Тогда
				Объект.ДоговорКонтрагента = ПредопределенноеЗначение("Справочник.ДоговорыКонтрагентов.ПустаяСсылка");
			КонецЕсли;
		КонецЕсли;
		
		Если НЕ ОтображатьЦеныВоВнутреннихЗаказах Тогда
			Если НЕ Объект.ВидЦен.Пустая() Тогда
				Объект.ВидЦен = ПредопределенноеЗначение("Справочник.ВидыЦен.ПустаяСсылка");
			КонецЕсли;
			
			Объект.СуммаДокумента = 0;
			Для Каждого СтрокаТовары Из Объект.Товары Цикл
				СтрокаТовары.Цена = 0;
				СтрокаТовары.ЦенаВал = 0;
				СтрокаТовары.СуммаРучнойСкидки = 0;
				СтрокаТовары.ПроцентРучнойСкидки = 0;
				СтрокаТовары.Сумма = 0;
				СтрокаТовары.СуммаНДС = 0;
			КонецЦикла;
			Если ТоварыКакДерево Тогда				
				КоллекцияЭлементовДерева = ТоварыДерево.ПолучитьЭлементы();
				Для Каждого СтрокаПотолок Из КоллекцияЭлементовДерева Цикл    
					Для Каждого СтрокаТовары Из СтрокаПотолок.ПолучитьЭлементы() Цикл
						СтрокаТовары.Цена = 0;
						СтрокаТовары.ЦенаВал = 0;
						СтрокаТовары.СуммаРучнойСкидки = 0;
						СтрокаТовары.ПроцентРучнойСкидки = 0;
						СтрокаТовары.Сумма = 0;
						СтрокаТовары.СуммаНДС = 0;
					КонецЦикла;
				КонецЦикла;
			КонецЕсли;			
		КонецЕсли;
	
	    Врем_Потолки = ПолучитьУникальныеПотолкиОтрезыЗаказа();
		Если Врем_Потолки.Количество() > 0 Тогда
			Если (НЕ ТоварыКакДерево И Объект.Товары.Количество() > 0)
				ИЛИ (ТоварыКакДерево И ТоварыДерево.ПолучитьЭлементы().Количество() > 0) Тогда
				ПоказатьВопрос(Новый ОписаниеОповещения("ПослеВопросаОбОбновленииПотолков", ЭтаФорма, Параметры), "Установлен признак внутреннего заказа. Обновить строки по потолкам?", РежимДиалогаВопрос.ДаНет);
			КонецЕсли;
		КонецЕсли;
	
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ТекущийСтатусПриИзменении(Элемент)
	
	Если Объект.ТекущийСтатус = ПредопределенноеЗначение("Справочник.СтатусыЗаказовПокупателей.Отменен") Тогда
		Если НЕ ВозможенПереводВСтатусОтменен() Тогда
			ПоказатьПредупреждение(,"Перевод в статус ""Отменен"" не доступен");
			Объект.ТекущийСтатус = ПредыдущийСтатус;
			Возврат;
		КонецЕсли;
				
		МассивЗаказовКОтмене = ПолучитьСписокЗаказовНаПроизводствоКОтмене();
		Если МассивЗаказовКОтмене.Количество() > 0 Тогда			
			ОбщийМодульКлиент.ПеревестиЗаказыНаПроизводствоВСтатусОтменен(МассивЗаказовКОтмене);
		КонецЕсли;
	КонецЕсли;	
	
	Если Объект.ТекущийСтатус = ПредопределенноеЗначение("Справочник.СтатусыЗаказовПокупателей.Новый") Тогда 
		Элементы.ТекущийСтатус.АвтоМаксимальнаяШирина = Ложь;
		Элементы.ПеревестиВСтатусВРаботе.Видимость = Истина;
	Иначе
		Элементы.ТекущийСтатус.АвтоМаксимальнаяШирина = Истина;
		Элементы.ПеревестиВСтатусВРаботе.Видимость = Ложь;
	КонецЕсли;	
	
	ТекущийСтатусПриИзмененииФрагмент();
	
КонецПроцедуры

&НаКлиенте
Процедура ТекущийСтатусПриИзмененииФрагмент()

	//#9777
	Если (Объект.СозданПриИспользованииСтатусаЗакрыт	
		И ПредыдущийСтатус = ПредопределенноеЗначение("Справочник.СтатусыЗаказовПокупателей.Закрыт")
		И НЕ Объект.ТекущийСтатус = ПредыдущийСтатус 
		И НЕ Объект.ТекущийСтатус = ПредопределенноеЗначение("Справочник.СтатусыЗаказовПокупателей.Отменен"))
		ИЛИ
		(НЕ Объект.СозданПриИспользованииСтатусаЗакрыт	
		И ПредыдущийСтатус = ПредопределенноеЗначение("Справочник.СтатусыЗаказовПокупателей.Выполнен")
		И НЕ Объект.ТекущийСтатус = ПредыдущийСтатус 
		И НЕ Объект.ТекущийСтатус = ПредопределенноеЗначение("Справочник.СтатусыЗаказовПокупателей.Закрыт")
		И НЕ Объект.ТекущийСтатус = ПредопределенноеЗначение("Справочник.СтатусыЗаказовПокупателей.Отменен"))		
		Тогда
		
		Если ОбщийМодульВызовСервера.ЕстьВыработкаПроизводстваПоДокументу(Объект.Ссылка) Тогда		
			ТекстВопроса = "После сохранения документа начисление выработки будет очищено. Подтверждаете изменение статуса?";
			ОписаниеОповещения = Новый ОписаниеОповещения("ТекущийСтатусПриИзмененииФрагмент2", ЭтотОбъект);
			ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
		Иначе
			ТекущийСтатусПриИзмененииЗавершение();
		КонецЕсли;
	Иначе
		ТекущийСтатусПриИзмененииЗавершение();
	КонецЕсли;
	
КонецПроцедуры

