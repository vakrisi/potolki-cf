//++ №13814
&НаСервере
Процедура ОбработатьРасширенныеПравилаПоПродукции(Номенклатура, УИСтроки)
	
	ТаблицаТоваров = Объект.Товары.Выгрузить();
	ТаблицаТоваров.Очистить();
	
	ТаблицаТоваров.Колонки.Добавить("РасширеннаяОбработка", новый ОписаниеТипов("Булево"));
	
	ТаблицаУслуг = ТаблицаТоваров.Скопировать();
	
	ТаблицаМатериалов = Объект.Материалы.Выгрузить();
	ТаблицаМатериалов.Очистить();
	
	ТаблицаМатериалов.Колонки.Добавить("РасширеннаяОбработка", новый ОписаниеТипов("Булево"));
	
	ДанныеЗаказа = ОбменСEasyCeiling.СтруктураДанныхЗаказа(Объект.Организация, Объект.Подразделение, Объект.НастройкаИнтеркампани,
		Объект.ВидЦен, Объект.Валюта, Объект.Дата, УчитыватьНДС, Объект.СтавкаНДС, Объект.ДоговорКонтрагента, Объект.ВнутреннийЗаказ);
		
	СтруктураПродукции = новый Структура("ПродукцияНоменклатура, ВидНоменклатурыПотолка", Номенклатура, Справочники.ВидыНоменклатуры.Продукция);
		
	РасширеннаяОбработкаВыполнена = ОбменСEasyCeiling.РасширеннаяОбработкаПараметровФайла(ПредопределенноеЗначение("Перечисление.ВидыЗаказов.ЗаказПокупателя"),,
		СтруктураПродукции, ТаблицаТоваров, ТаблицаУслуг, ТаблицаМатериалов, ДанныеЗаказа.Дата, ДанныеЗаказа.ВидЦены, ДанныеЗаказа.Валюта, ДанныеЗаказа.УчитыватьНДС, ДанныеЗаказа.СтавкаНДСПоУмолчанию);
		
	Если НЕ РасширеннаяОбработкаВыполнена Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого ТекущаяСтрока Из ТаблицаТоваров Цикл
		
		НоваяСтрока = Объект.Товары.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущаяСтрока);
		
		НоваяСтрока.Потолок = Номенклатура;
		НоваяСтрока.УИСтроки = новый УникальныйИдентификатор;
		НоваяСтрока.УИСтрокиРодителя = УИСтроки;
		
		// №14311 Если ЭтоУслуга(НоваяСтрока.Номенклатура) Тогда
			НоваяСтрока.КоличествоКВыработке = НоваяСтрока.Количество;
		//КонецЕсли;
		
	КонецЦикла;
	
	Для Каждого ТекущаяСтрока Из ТаблицаУслуг Цикл
		
		НоваяСтрока = Объект.Товары.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущаяСтрока);
		
		НоваяСтрока.Потолок = Номенклатура;
		НоваяСтрока.УИСтроки = новый УникальныйИдентификатор;
		НоваяСтрока.УИСтрокиРодителя = УИСтроки;
		
		// №14311 Если ЭтоУслуга(НоваяСтрока.Номенклатура) Тогда
			НоваяСтрока.КоличествоКВыработке = НоваяСтрока.Количество;
		//КонецЕсли;
		
	КонецЦикла;
	
	Для Каждого ТекущаяСтрока Из ТаблицаМатериалов Цикл
		
		НоваяСтрока = Объект.Материалы.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущаяСтрока);
		
		НоваяСтрока.Потолок = Номенклатура;
		НоваяСтрока.УИСтроки = УИСтроки;
		
		НоваяСтрока.КоличествоКВыработке = НоваяСтрока.Количество; // №14311
		
	КонецЦикла;
	
КонецПроцедуры
