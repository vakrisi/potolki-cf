&НаКлиенте
Процедура УдалитьМатериалыОтносящиесяКПозиции(Потолок, УИСтроки)
	
	УдалитьМатериалыОтносящиесяКПозицииНаСервере(Потолок, УИСтроки)
	
КонецПроцедуры

&НаСервере
Процедура УдалитьМатериалыОтносящиесяКПозицииНаСервере(Потолок, УИСтроки)
	
	КоличествоЗаписей = Объект.Материалы.Количество();
	Для Сч = 1 По КоличествоЗаписей Цикл
		
		Если Объект.Материалы.Получить(КоличествоЗаписей-Сч).Потолок = Потолок
			И Объект.Материалы.Получить(КоличествоЗаписей-Сч).УИСтроки = УИСтроки Тогда
			Объект.Материалы.Удалить(КоличествоЗаписей-Сч);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗадатьВопросОбУдаленииУслугПотолока(Номенклатура)
	
	Парам = Новый Структура;
	Парам.Вставить("Номенклатура", Номенклатура);	
	
	ПослеВопросаОбУдаленииУслугПотолка = Новый ОписаниеОповещения("ОбработкаОтветаНаВопросУдаленияУслугПотолка", ЭтотОбъект, Парам);
	ПоказатьВопрос(ПослеВопросаОбУдаленииУслугПотолка, "Удалить из документа все услуги раскроя, относящиеся к данному потолку?", РежимДиалогаВопрос.ДаНет);	
	
КонецПроцедуры	
//Конец добавлен при переходе на 2.0

&НаКлиенте
Процедура ОбработкаОтветаНаВопросУдаленияУслугПотолка(Результат, ДопПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		
		УдалитьИзТоваровУслугиОтносящиесяКПотолку(ДопПараметры.Номенклатура, ДопПараметры.УИСтроки);
		
		// №9856 перенесено из УдалитьИзТоваровУслугиОтносящиесяКПотолку, т.к. там убрано
		//ОбновитьДанныеДокумента();
		РассчитатьИтоговыеПоказателиКлиент();
		
	КонецЕсли;
	
КонецПроцедуры

// №9856 &НаСервере
&НаКлиенте
Процедура УдалитьИзТоваровУслугиОтносящиесяКПотолку(Потолок, УИСТроки)
	
	КоличествоЗаписей = Объект.Товары.Количество()-1;
	Для Сч = 0 По КоличествоЗаписей Цикл
		
		Если Объект.Товары.Получить(КоличествоЗаписей-Сч).Потолок = Потолок И Объект.Товары.Получить(КоличествоЗаписей-Сч).УИСТрокиРодителя = УИСТроки Тогда
			Объект.Товары.Удалить(КоличествоЗаписей-Сч);
		КонецЕсли;
		
	КонецЦикла;
	
	//++ №9856 комментируем т.к. в эту процедуру приходят из клиентских событий, в которых нельзя использовать &НаСервере
	//ОбновитьДанныеДокумента();
	//-- №9856
	
	// #15557 закомментировано
	//Если ТоварыКакДерево Тогда
	//	ПостроитьДеревоНаФорме();
	//КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыКомнатаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ДанныеВыбора = Новый СписокЗначений;
	ДанныеВыбора.ЗагрузитьЗначения(СписокКомнатОснования.ВыгрузитьЗначения());
	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыНоменклатураПриИзменении(Элемент)
	
	Если ТоварыКакДерево Тогда
		ТекущиеДанные = Элементы.ТоварыДерево.ТекущиеДанные;
	Иначе
		ТекущиеДанные = Элементы.Товары.ТекущиеДанные;
	КонецЕсли;
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	НоменклатураТоварыПриИзменении(ТекущиеДанные);
	
	Если РежимПодробнаяИнформацияПоТоварам Тогда
		ЗаполнитьДанныеКОтгрузкеИОстаткиПоТоварам();
	КонецЕсли;
	
КонецПроцедуры
		
&НаКлиенте
Процедура НоменклатураТоварыПриИзменении(ТекущиеДанные, Количество = Неопределено, ПроверятьПотолки = Истина, БезусловноеПерезаполнениеМатериаловПоСпецификации = Ложь)
	
	РезультатПроверки = Истина;
	Если ПроверятьПотолки Тогда
		РезультатПроверки = ПроверитьСписокЗаказовПокупателейСЭтойПродукцией(ТекущиеДанные.Номенклатура)
							И ПроверитьНаличиеУникальнойПродукцииВТекущемЗаказе(ТекущиеДанные.Номенклатура, Истина);
	КонецЕсли;						
	
	Если РезультатПроверки Тогда
		
		СтруктураДанные = СтруктураДанныхПоСтрокеТабличнойЧасти(ТекущиеДанные);
		
		СтруктураДанные = ОбработкаТабличныхЧастейКлиент.ПолучитьДанныеНоменклатурыПриИзменении(СтруктураДанные);	
		ЗаполнитьЗначенияСвойств(ТекущиеДанные, СтруктураДанные, "ЕдиницаИзмерения, Коэффициент, 
																 |ВидНоменклатуры, Спецификация, 
																 |ПериметрПомещения, НомерРасчета, ИндексПотолка, СтавкаНДС"); //nva
	
		Если Количество = Неопределено Тогда      //#2792 при проверке кратности
			ТекущиеДанные.Количество = 1;
			СтруктураДанные.Количество = 1;
		Иначе
			ТекущиеДанные.Количество = Количество;
		КонецЕсли;
		
		//ТекущиеДанные.Цена = ПолучитьЦенуНоменклатуры(ТекущиеДанные.Номенклатура, ТекущиеДанные.ХарактеристикаНоменклатуры, ТекущиеДанные.ЕдиницаИзмерения);
		
		СтруктураДанные = ПолучитьДанныеНоменклатурыПриИзменении(СтруктураДанные);
		ЗаполнитьЗначенияСвойств(ТекущиеДанные, СтруктураДанные, "Цена, ЦенаВал, Количество");
		//Если Количество = Неопределено Тогда  //#2792 
		//	ТекущиеДанные.Количество = СтруктураДанные.Количество;
		//КонецЕсли;
		Если НЕ Количество = Неопределено Тогда  //#2792 
			ТекущиеДанные.Количество = Количество; //СтруктураДанные.Количество;
		КонецЕсли;
	
		ТекущиеДанные.Сумма = ТекущиеДанные.Количество * ТекущиеДанные.Цена;
		ТекущиеДанные.ПроцентРучнойСкидки = ОбщийМодульВызовСервера.ПолучитьСкидкуПоВидуСкидки(Объект.ВидСкидки);
		//nva+++
		ОкруглитьТекущуюСтроку(ТекущиеДанные.Номенклатура, ТекущиеДанные.ЕдиницаИзмерения);
		//nva---
		ОбработкаТабличныхЧастейКлиент.ПересчитатьСуммуРучнойСкидкиВСтрокеТЧ(ТекущиеДанные);
		
		//++ №13299
		//ОбработкаТабличныхЧастейКлиент.ПересчитатьСуммуСУчетомСкидокВСтрокеТЧ(ТекущиеДанные, ИспользуютсяАвтоматическиеСкидки);
		ОбработкаТабличныхЧастейКлиент.ПересчитатьСуммуСУчетомСкидокВСтрокеТЧ(ТекущиеДанные, ИспользуютсяАвтоматическиеСкидки, Истина, Истина);
		//-- №13299
		
		ТекущиеДанные.СтавкаНДС = Объект.СтавкаНДС;
		ОбработкаТабличныхЧастейКлиент.ПересчитатьСуммуНДСВСтрокеТЧ(ТекущиеДанные, УчитыватьНДС);
		//ТекущиеДанные.Спецификация = ОбщийМодуль.ПолучитьОсновнуюСпецификациюНоменклатуры(ТекущиеДанные.Номенклатура); // убрано выше
		
		// №14311 Если ЭтоУслуга(ТекущиеДанные.Номенклатура) Тогда
			ТекущиеДанные.КоличествоКВыработке = ТекущиеДанные.Количество;
		//КонецЕсли;
		
		Если ПустаяСтрока(ТекущиеДанные.УИСтроки) Тогда
			ТекущиеДанные.УИСтроки = Строка(Новый УникальныйИдентификатор);
			ТекущиеДанные.УИСтрокиРодителя = ТекущиеДанные.УИСтроки;
		КонецЕсли;
		
		Если мСпецификация <> Неопределено И НЕ мСпецификация.Пустая() Тогда
			УдалитьМатериалыОтносящиесяКПозицииНаСервере(мНоменклатура, ТекущиеДанные.УИСтроки);
		КонецЕсли;
		
		Если НЕ ТекущиеДанные.Спецификация.Пустая() Тогда
			Если НЕ БезусловноеПерезаполнениеМатериаловПоСпецификации Тогда
				ЗадатьВопросОПерезаполненииМатериловПоСпецификации(ТекущиеДанные.Номенклатура, ТекущиеДанные.УИСтроки);
			Иначе
				// #12667 при добавлении конструкции не спрашивать "Перезаполнить материалы?", а безусловно это делать
				Если ТоварыКакДерево Тогда
					ПеренестиДеревоВТабличнуюЧасть();
				КонецЕсли;
				ДополнительныеПараметры = Новый Структура;	
				ДополнительныеПараметры.Вставить("Номенклатура", ТекущиеДанные.Номенклатура);
				ДополнительныеПараметры.Вставить("УИСтроки", ТекущиеДанные.УИСтроки);
				ДополнительныеПараметры.Вставить("МассивНоменклатур", Неопределено);
				ОбработкаОтветаНаВопросПерезаполненииМатериаловПоСпецификацииНаСервере(ДополнительныеПараметры);
			КонецЕсли;
		КонецЕсли;
		
		//Если это потолок, его нужно расщепить на услуги, материалы и товары так как это делается через построитель
		Если ЭтоНоменклатураУникальногоПотолкаИлиОтреза(ТекущиеДанные.Номенклатура) Тогда			
			ОбновитьНоменклатуруПотолкаНаСервере(ТекущиеДанные.Номенклатура, ТекущиеДанные.УИСтроки);
		//++ №13814
		ИначеЕсли ЭтоНоменклатураПродукция(ТекущиеДанные.Номенклатура) Тогда
			ОбработатьРасширенныеПравилаПоПродукции(ТекущиеДанные.Номенклатура, ТекущиеДанные.УИСтроки);
		//-- №13814
		КонецЕсли;	
	
	
		ПерезаполнитьНомераПотолковПоТабличнойЧасти();
		РассчитатьИтоговыеПоказателиКлиент();
	Иначе
		
		ТекущиеДанные.Номенклатура = мНоменклатура;
		
	КонецЕсли;
	
	ОбновитьСписокФайлов();
	
КонецПроцедуры

&НаСервере
Функция ПроверитьНаличиеУникальнойПродукцииВТекущемЗаказе(Номенклатура, УчитыватьТЧ)
	
	Если Справочники.ВидыНоменклатуры.ЭтоНоменклатураУникальногоПотолкаИлиОтреза(Номенклатура) 
		ИЛИ Справочники.ВидыНоменклатуры.ЭтоНоменклатураПродукцияУникальная(Номенклатура) Тогда //#12667 
		СтруктураПоиска = новый Структура("Номенклатура", Номенклатура);	
		НайденныеСтроки = Объект.Товары.НайтиСтроки(СтруктураПоиска);
		
		Минимум = 0;
		Если УчитыватьТЧ Тогда
			Минимум = 1;			
		КонецЕсли;
		
		Если НайденныеСтроки.Количество() > Минимум Тогда //может быть 1 т.к. он уже заменился в ТЧ Товары			
			Сообщить("Внимание! Позиция """ + Номенклатура + """ уже указана в текущем документе. Действие отменено.");
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Истина;	
	
КонецФункции

&НаКлиенте
Процедура ТоварыХарактеристикаНоменклатурыПриИзменении(Элемент)
	
	Если ТоварыКакДерево Тогда
		СтрокаТабличнойЧасти = Элементы.ТоварыДерево.ТекущиеДанные;
	Иначе
		СтрокаТабличнойЧасти = Элементы.Товары.ТекущиеДанные;
	КонецЕсли;
	Если СтрокаТабличнойЧасти = Неопределено Тогда 
		Возврат 
	КонецЕсли;
	
	//ТекущаяСтрока.Цена = ПолучитьЦенуНоменклатуры(ТекущаяСтрока.Номенклатура, ТекущаяСтрока.ХарактеристикаНоменклатуры, ТекущаяСтрока.ЕдиницаИзмерения);
	СтруктураДанные = СтруктураДанныхПоСтрокеТабличнойЧасти(СтрокаТабличнойЧасти);
	СтруктураДанные = ПолучитьДанныеНоменклатурыПриИзменении(СтруктураДанные);
	ЗаполнитьЗначенияСвойств(СтрокаТабличнойЧасти, СтруктураДанные, "Цена, ЦенаВал");
	
	//++ №13299
	//ОбработкаТабличныхЧастейКлиент.ПересчитатьСуммуСУчетомСкидокВСтрокеТЧ(СтрокаТабличнойЧасти, ИспользуютсяАвтоматическиеСкидки);
	ОбработкаТабличныхЧастейКлиент.ПересчитатьСуммуСУчетомСкидокВСтрокеТЧ(СтрокаТабличнойЧасти, ИспользуютсяАвтоматическиеСкидки, Истина, Истина);
	//-- №13299
	
	ОбработкаТабличныхЧастейКлиент.ПересчитатьСуммуНДСВСтрокеТЧ(СтрокаТабличнойЧасти, УчитыватьНДС);

	Если РежимПодробнаяИнформацияПоТоварам Тогда
		ЗаполнитьДанныеКОтгрузкеИОстаткиПоТоварам();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыКоличествоПриИзменении(Элемент)
	
	Если ТоварыКакДерево Тогда
		СтрокаТабличнойЧасти = Элементы.ТоварыДерево.ТекущиеДанные;
	Иначе
		СтрокаТабличнойЧасти = Элементы.Товары.ТекущиеДанные;
	КонецЕсли;
	
	//#2792
	Если ИспользоватьКонтрольКратности Тогда
		СтруктураДанные = СтруктураДанныхПоСтрокеТабличнойЧасти(СтрокаТабличнойЧасти);
		ОтказВИзмененииКоличества = Ложь;
		ПроверитьКратностьЕдиницИзмеренияНаСервере(СтруктураДанные, ОтказВИзмененииКоличества);
		Если ОтказВИзмененииКоличества Тогда
			СтрокаТабличнойЧасти.Количество = 0;
		КонецЕсли;
	КонецЕсли;

	ОбработкаТабличныхЧастейКлиент.ПересчитатьСуммуРучнойСкидкиВСтрокеТЧ(СтрокаТабличнойЧасти);
	
	//++ №13299
	//ОбработкаТабличныхЧастейКлиент.ПересчитатьСуммуСУчетомСкидокВСтрокеТЧ(СтрокаТабличнойЧасти, ИспользуютсяАвтоматическиеСкидки);
