&НаКлиенте
Функция НайтиСтрокуПродукцииПоУИС(УИСтроки) 
	
	Если ТоварыКакДерево Тогда
		СтрокиПродукций = ТоварыДерево.ПолучитьЭлементы();
		Для каждого СтрокаПродукции из СтрокиПродукций Цикл
			ПодчиненныеСтроки = СтрокаПродукции.ПолучитьЭлементы();
			Для Каждого ТекСтрока Из ПодчиненныеСтроки Цикл
				Если ТекСтрока.УИСтроки = УИСтроки Тогда
					Возврат ТекСтрока;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	Иначе
		Отбор = Новый Структура;
		Отбор.Вставить("УИСтроки", УИСтроки);
		НайденныеСтроки = Объект.Товары.НайтиСтроки(Отбор);
		Если НайденныеСтроки.Количество() > 0 Тогда
			Возврат НайденныеСтроки[0];
		КонецЕсли;
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Процедура ПеревестиВСтатусВРаботе(Команда)
	Объект.ТекущийСтатус = ПредопределенноеЗначение("Справочник.СтатусыЗаказовПокупателей.ВРаботе");
	Попытка
		СтруктураЗаписи = Новый Структура;
		СтруктураЗаписи.Вставить("РежимЗаписи",РежимЗаписиДокумента.Проведение);
		СтруктураЗаписи.Вставить("РежимПроведения",РежимПроведенияДокумента.Оперативный);
		Если Записать(СтруктураЗаписи) Тогда
			Элементы.ТекущийСтатус.АвтоМаксимальнаяШирина = Истина;
			Элементы.ПеревестиВСтатусВРаботе.Видимость = Ложь;
		Иначе   
			Объект.ТекущийСтатус = ПредопределенноеЗначение("Справочник.СтатусыЗаказовПокупателей.Новый");   
		КонецЕсли;
	Исключение
		Сообщить("Невозможно провести документ т.к.:");
		Сообщить(ОписаниеОшибки());
		Объект.ТекущийСтатус = ПредопределенноеЗначение("Справочник.СтатусыЗаказовПокупателей.Новый");
	КонецПопытки;		
КонецПроцедуры

