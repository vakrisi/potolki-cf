	|					(ВЫБРАТЬ
	|						ВремЗаказПокупателяТовары.Номенклатура
	|					ИЗ
	|						ВремЗаказПокупателяТовары)
	|				И ЗаказНаПроизводство = &Ссылка) КАК ЗаказыПокупателейОбороты
	|		ПО ЗаказПокупателяТовары.Номенклатура = ЗаказыПокупателейОбороты.Номенклатура
	|			И ЗаказПокупателяТовары.ХарактеристикаНоменклатуры = ЗаказыПокупателейОбороты.ХарактеристикаНоменклатуры
				
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыВРезервеНаСкладах.Остатки(,
	|				Номенклатура В
	|					(ВЫБРАТЬ
	|						ВремЗаказПокупателяТовары.Номенклатура
	|					ИЗ
	|						ВремЗаказПокупателяТовары)
	|				И Склад = &Склад
	|				И ВЫБОР
	|						КОГДА &ИспользуютсяОбщиеСклады
	|							ТОГДА ИСТИНА
	|						ИНАЧЕ Организация = &Организация
	|					КОНЕЦ) КАК ВРезервеОстатки
	|		ПО (ЗаказПокупателяТовары.Номенклатура = ВРезервеОстатки.Номенклатура)
	|			И (ЗаказПокупателяТовары.ХарактеристикаНоменклатуры = ВРезервеОстатки.ХарактеристикаНоменклатуры)
	|			И (ЗаказПокупателяТовары.СерияНоменклатуры = ВРезервеОстатки.СерияНоменклатуры)
	|			И &ИспользоватьРезервирование
	
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыВРезервеНаСкладах.Остатки(,
	|				Номенклатура В
	|					(ВЫБРАТЬ
	|						ВремЗаказПокупателяТовары.Номенклатура
	|					ИЗ
	|						ВремЗаказПокупателяТовары)
	|				И Склад = &Склад
	|				И ВЫБОР
	|						КОГДА &ИспользуютсяОбщиеСклады
	|							ТОГДА ИСТИНА
	|						ИНАЧЕ Организация = &Организация
	|					КОНЕЦ
	|					И ДокументРезерва = &Ссылка) КАК ВРезервеОстаткиПодДанныйЗаказ
	|		ПО (ЗаказПокупателяТовары.Номенклатура = ВРезервеОстаткиПодДанныйЗаказ.Номенклатура)
	|			И (ЗаказПокупателяТовары.ХарактеристикаНоменклатуры = ВРезервеОстаткиПодДанныйЗаказ.ХарактеристикаНоменклатуры)
	|			И (ЗаказПокупателяТовары.СерияНоменклатуры = ВРезервеОстаткиПодДанныйЗаказ.СерияНоменклатуры)
	|	 		И &ИспользоватьРезервирование
	|";
	
