Функция ПараметрыПодбораНоменклатуры()
	
	ПараметрыПодбора = Новый Структура;
	ПараметрыПодбора.Вставить("Организация",			Объект.Организация);
	Если Объект.Склад = ПредопределенноеЗначение("Справочник.Склады.ПустаяСсылка") Тогда 
		ПараметрыПодбора.Вставить("Склад", 				ПолучитьСкладТекущегоПользователя());
	Иначе
		ПараметрыПодбора.Вставить("Склад",				Объект.Склад);
	КонецЕсли;
	
	Если НЕ ТребуетсяЗаполнениеЦен() Тогда
		ПараметрыПодбора.Вставить("НеЗапрашиватьЦену", Истина);
	КонецЕсли;	
	
	//ПараметрыПодбора.Вставить("ВидНоменклатуры",		ПолучитьСписокВидовНоменклатурыТовары()); // #9888 убран отбор 
	ПараметрыПодбора.Вставить("Дата",					Объект.Дата);
	ПараметрыПодбора.Вставить("ВидЦены",				Объект.ВидЦен);
	ПараметрыПодбора.Вставить("Валюта",					Объект.Валюта);
	ПараметрыПодбора.Вставить("Контрагент",				Объект.Контрагент);
	ПараметрыПодбора.Вставить("ДоговорКонтрагента",		Объект.ДоговорКонтрагента);
	ПараметрыПодбора.Вставить("ЗапретРедактированияЦен",ЗапретРедактированияЦен());
	Если ИспользоватьКонтрольКратности Тогда
		ПараметрыПодбора.Вставить("ВидДокументаПроверкиКратности",ПредопределенноеЗначение("Перечисление.ВидыДокументовПроверкиКратности.ЗаказПокупателя")); //#2792
	КонецЕсли;
	ПараметрыПодбора.Вставить("ПредлагатьСопутствующиеТоварыПриПодборе", Константы.ПредлагатьСопутствующиеТоварыПриПодбореВЗаказПокупателя.Получить());

	Возврат ПараметрыПодбора;
	
КонецФункции

