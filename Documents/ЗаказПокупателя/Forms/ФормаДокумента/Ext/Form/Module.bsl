&НаКлиенте
Процедура ПослеВыбораПотолкаПодборМатериалов(ВозвращенноеЗначение, ДопПараметры) Экспорт
	
	Если ВозвращенноеЗначение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыПодбора = ПараметрыПодбораНоменклатуры();
	ПараметрыПодбора.Вставить("ВидНоменклатуры",   ПолучитьСписокВидовНоменклатурыТовары());
	ПараметрыПодбора.Вставить("НеЗапрашиватьЦену", Истина);
	
	ПодборВМатериалы = Истина;
	ДанныеСтрокиПотолка = Новый Структура("Потолок, УИСтроки", ВозвращенноеЗначение.Потолок, ВозвращенноеЗначение.УИСтроки);
		
	ОткрытьФорму("ОбщаяФорма.ФормаПодбораНоменклатуры", ПараметрыПодбора, ЭтотОбъект, УникальныйИдентификатор);
		
КонецПроцедуры	

&НаСервере
Процедура ОбработкаВыбораПодборМатериаловНаСервере(ВыбранноеЗначение)
	
	ТаблицаТоваров = ПолучитьИзВременногоХранилища(ВыбранноеЗначение.АдресВХранилище);
	
	Для Каждого ТекущаяСтрока из ТаблицаТоваров Цикл			
		
		НоваяСтрока = Объект.Материалы.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущаяСтрока);
		
		НоваяСтрока.Потолок = ДанныеСтрокиПотолка.Потолок;
		НоваяСтрока.УИСтроки = ДанныеСтрокиПотолка.УИСтроки;
		
		НоваяСтрока.КоличествоКВыработке = ТекущаяСтрока.Количество; // №14311
		
	КонецЦикла;
	
	ЗаполнитьДанныеОстаткиПоМатериалам(); //2022-05-23
	Модифицированность = Истина;
	ОбновитьДанныеДокумента();		
	
КонецПроцедуры

&НаСервере
Функция ПолучитьСписокПотолков(Знач ВыбиратьТоварыКПроизводству = Ложь)
	
	СписокПотолков = новый СписокЗначений;
	
	//++ №14932 смотрим теперь по настройке
	//ЗаказыватьТовары = Константы.ЗаказыватьТоварыПриОформленииЗаказаНаПроизводствоНаОснованииЗаказаПокупателя.Получить();
	МассивРазрешенныхНоменклатур = ПолучитьНоменклатуруКЗаказуНаПроизводствоПоОтбору();
	//-- №14932
	
	Для Каждого ТекущаяСтрока Из Объект.Товары Цикл
		
		ЭтоНоменклатураПотолка = Справочники.ВидыНоменклатуры.ЭтоНоменклатураПотолкаИлиОтреза(ТекущаяСтрока.Номенклатура);
		ЕстьДокументВыпускаПоПродукции = ЕстьДокументВыпускаПоПродукции(ТекущаяСтрока.Номенклатура, ТекущаяСтрока.ХарактеристикаНоменклатуры);
		
		Если 
			(ЭтоНоменклатураПотолка
				//И НЕ ТекущаяСтрока.ЕстьДокументВыпускаПоПотолку)
				И НЕ ЕстьДокументВыпускаПоПродукции)
			ИЛИ
			(НЕ ЭтоНоменклатураПотолка
				И ВыбиратьТоварыКПроизводству
				//++ №14932 смотрим теперь по настройке
				//И ЗаказыватьТовары
				И НЕ МассивРазрешенныхНоменклатур.Найти(ТекущаяСтрока.Номенклатура) = Неопределено
				//-- №14932
				И НЕ ЭтоУслугаСервер(ТекущаяСтрока.Номенклатура))
		Тогда
			СтруктураСтрокиПотолка = Новый Структура;
			СтруктураСтрокиПотолка.Вставить("Потолок",ТекущаяСтрока.Номенклатура);
			СтруктураСтрокиПотолка.Вставить("УИСтроки",ТекущаяСтрока.УИСтроки);
			СписокПотолков.Добавить(СтруктураСтрокиПотолка);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат СписокПотолков;
	
КонецФункции

&НаКлиенте
Процедура ЗаполнитьМатериалыПоФактуре(Команда)  	
	
	СписокПотолков = ПолучитьСписокПотолков();	
	
	Если СписокПотолков.Количество() > 0 Тогда
	
		ОП = новый ОписаниеОповещения("ПослеВыбораПотолкаЗаполнитьМатериалыПоФактуре", ЭтотОбъект);	
		
		ОткрытьФорму("Документ.ЗаказПокупателя.Форма.ФормаВыбораПотолка", новый Структура("СписокПотолков", СписокПотолков), ЭтотОбъект,,,, ОП);
		
	Иначе
		
		Сообщить("В табличной части товары не были найдены потолки и отрезы");
		
	КонецЕсли;
			
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораПотолкаЗаполнитьМатериалыПоФактуре(ВозвращенныеЗначения, ДопПараметры) Экспорт
	
	Если ВозвращенныеЗначения <> Неопределено И ТипЗнч(ВозвращенныеЗначения) = Тип("Массив") Тогда
		
		Для Каждого ТекЗначение Из ВозвращенныеЗначения Цикл
			ЗаполнитьМатериалыПоФактуреНаСервере(ТекЗначение);
		КонецЦикла;
		
		ЗаполнитьДанныеОстаткиПоМатериалам(); //2022-05-23		
		Модифицированность = Истина;
		
	КонецЕсли;
	
КонецПроцедуры	

&НаСервере
Процедура ЗаполнитьМатериалыПоФактуреНаСервере(СтруктураСтрокиПотолка)
	
	ОсновнаяФактура = ПолучитьОсновнуюФактуруИЦвет(СтруктураСтрокиПотолка.Потолок);
	
	НоваяСтрока = Объект.Материалы.Добавить();
	НоваяСтрока.Номенклатура = ОсновнаяФактура.ПродукцияЦвет.Номенклатура;
	НоваяСтрока.ЕдиницаИзмерения = ОбщийМодульВызовСервера.ПолучитьБазовуюЕдиницуИзмеренияНоменклатуры(НоваяСтрока.Номенклатура);
	НоваяСтрока.Коэффициент = 1;
	НоваяСтрока.Потолок = СтруктураСтрокиПотолка.Потолок;
	НоваяСтрока.УИСтроки = СтруктураСтрокиПотолка.УИстроки;
	//++16102
	НайденноеЗначение = Объект.Товары.НайтиСтроки(Новый Структура("УИСтроки", СтруктураСтрокиПотолка.УИстроки));
	НоваяСтрока.Количество = НайденноеЗначение[0].Количество;
	//--16102
КонецПроцедуры

&НаСервере
Функция ПолучитьОсновнуюФактуруИЦвет(Потолок)
	
	СтруктураОтвета = Новый Структура;
	СтруктураОтвета.Вставить("ПродукцияФактура", Справочники.Фактура.ПустаяСсылка()); 
	СтруктураОтвета.Вставить("ПродукцияЦвет", Справочники.ЦветФактуры.ПустаяСсылка());
	
	Для Каждого ТекущаяСтрока Из Потолок.Потолок_Фактура Цикл
		Если ТекущаяСтрока.Основная Тогда
			СтруктураОтвета.ПродукцияФактура = ТекущаяСтрока.ПродукцияФактура;
			СтруктураОтвета.ПродукцияЦвет = ТекущаяСтрока.ПродукцияЦвет;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Возврат СтруктураОтвета;
	
КонецФункции

&НаКлиенте
Процедура ДобавитьРулонПоНомеру(Команда)
	
	СписокПотолков = ПолучитьСписокПотолков();
	
	Если СписокПотолков.Количество() > 0 Тогда
	
		ОП = новый ОписаниеОповещения("ПослеВыбораПотолкаДобавитьРулонПоНомеру", ЭтотОбъект);	
			
		ОткрытьФорму("Документ.ЗаказПокупателя.Форма.ФормаВыбораПотолка", новый Структура("СписокПотолков, ТолькоОдноЗначение", СписокПотолков, Истина), ЭтотОбъект,,,, ОП);
		
	Иначе
		
		Сообщить("В табличной части товары не были найдены потолки и отрезы");
		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораПотолкаДобавитьРулонПоНомеру(ВозвращенноеЗначение, ДопПараметры) Экспорт
	
	Перем ВыбЗнач;

	Если ВозвращенноеЗначение <> Неопределено Тогда
		
		Массив = Новый Массив;
		//Массив.Добавить(Тип("Число"));
		//КЧ = Новый КвалификаторыЧисла(12);
		Массив.Добавить(Тип("Строка"));
		КС = Новый КвалификаторыСтроки(150);
		ОписаниеТипов = Новый ОписаниеТипов(Массив, , КС);
		//ОписаниеТипов = Новый ОписаниеТипов(Массив, КЧ);
		Оповещение = Новый ОписаниеОповещения("ПослеВводаНомераРулона", ЭтотОбъект, новый Структура("Потолок,Уистроки", ВозвращенноеЗначение.Потолок, ВозвращенноеЗначение.УИСтроки));
		ПоказатьВводЗначения(Оповещение, ВыбЗнач, "Введите номер/наименование рулона", ОписаниеТипов);	
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВводаНомераРулона(НаименованиеРулона, ДопПараметры) Экспорт
	
	Если НаименованиеРулона <> Неопределено Тогда
		
		НомерРулона = 0;
		Попытка
			НомерРулона = Число(НаименованиеРулона);
		Исключение	
		КонецПопытки;
		
		ДобавитьВМатериалыРулонПоНомеру(НомерРулона, НаименованиеРулона, ДопПараметры.Потолок, ДопПараметры.УИСтроки);
		ЗаполнитьДанныеОстаткиПоМатериалам(); //2022-05-23
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьВМатериалыРулонПоНомеру(Знач НомерРулона, НаименованиеРулона, Знач Потолок, Знач УИСтроки)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СерииНоменклатуры.Владелец,
	|	СерииНоменклатуры.Ссылка,
	|	СерииНоменклатуры.Владелец.БазоваяЕдиницаИзмерения КАК БазоваяЕдиницаИзмерения
	|ИЗ
	|	Справочник.СерииНоменклатуры КАК СерииНоменклатуры
	|ГДЕ
	|	НЕ СерииНоменклатуры.ПометкаУдаления
	|	И (СерииНоменклатуры.Наименование = &Наименование
	|			ИЛИ &Номер > 0
	|				И СерииНоменклатуры.НомерСерии = &Номер)";
	Запрос.УстановитьПараметр("Номер", НомерРулона);
	Запрос.УстановитьПараметр("Наименование", СокрЛП(НаименованиеРулона));
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		НоваяСтрока = Объект.Материалы.Добавить();
		НоваяСтрока.Номенклатура = Выборка.Владелец;
		НоваяСтрока.СерияНоменклатуры = Выборка.Ссылка;
		НоваяСтрока.ЕдиницаИзмерения = Выборка.БазоваяЕдиницаИзмерения;
		НоваяСтрока.Коэффициент = 1;
		
		//проверим характеристики. если только одна - укажем ее тоже
		ЗапросХарактеристики = Новый Запрос;
		ЗапросХарактеристики.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ХарактеристикиНоменклатуры.Ссылка
		|ИЗ
		|	Справочник.ХарактеристикиНоменклатуры КАК ХарактеристикиНоменклатуры
		|ГДЕ
		|	ХарактеристикиНоменклатуры.Владелец = &Владелец
		|	И ХарактеристикиНоменклатуры.ПометкаУдаления = ЛОЖЬ";
		ЗапросХарактеристики.УстановитьПараметр("Владелец",Выборка.Владелец);
		ВыборкаХарактеристики = ЗапросХарактеристики.Выполнить().Выгрузить();
		Если ВыборкаХарактеристики.Количество() = 1 Тогда
			НоваяСтрока.ХарактеристикаНоменклатуры = ВыборкаХарактеристики[0].Ссылка;
		КонецЕсли;
		
		НоваяСтрока.Потолок = Потолок;
		НоваяСтрока.УИСтроки = УИСтроки;
		
		Модифицированность = Истина;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура СделаноИзОстатков(Команда)
	
	СписокПотолков = ПолучитьСписокПотолков();
	
	Если СписокПотолков.Количество() > 0 Тогда
	
		ОП = новый ОписаниеОповещения("ПослеВыбораПотолкаСделаноИзОстатков", ЭтотОбъект);	
			
		ОткрытьФорму("Документ.ЗаказПокупателя.Форма.ФормаВыбораПотолка", новый Структура("СписокПотолков, ТолькоОдноЗначение", СписокПотолков, Истина), ЭтотОбъект,,,, ОП);
		
	Иначе
		
		Сообщить("В табличной части товары не были найдены потолки и отрезы");
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораПотолкаСделаноИзОстатков(ВозвращенноеЗначение, ДопПараметры) Экспорт
	
	Если ВозвращенноеЗначение <> Неопределено Тогда
		
		СтруктураПоиска = новый Структура("Потолок, УИСтроки", ВозвращенноеЗначение.Потолок, ВозвращенноеЗначение.УИСтроки);
		НайденныеМатериалыПотолка = Объект.Материалы.НайтиСтроки(СтруктураПоиска);
		
		Если НайденныеМатериалыПотолка.Количество() > 0 Тогда
		
			ПараметрыОП = Новый Структура("ЭтоОстаток, Потолок, УИСтроки", Истина, ВозвращенноеЗначение.Потолок, ВозвращенноеЗначение.УИСтроки);		
			ПоказатьВопрос(Новый ОписаниеОповещения("ПослеОтветаНаВопросОЗаменеПолотен", ЭтотОбъект, ПараметрыОП) ,"Заменить полотна на ""Остаток""?", РежимДиалогаВопрос.ДаНет);
			
		Иначе		
			
			ДобавитьОстатокВМатериалы(Ложь, Истина, ВозвращенноеЗначение.Потолок, ВозвращенноеЗначение.УИСтроки);
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеОтветаНаВопросОЗаменеПолотен(Результат, ДопПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
        ДобавитьОстатокВМатериалы(Истина, ДопПараметры.ЭтоОстаток, ДопПараметры.Потолок, ДопПараметры.УИСтроки);
	Иначе
		ДобавитьОстатокВМатериалы(Ложь, ДопПараметры.ЭтоОстаток, ДопПараметры.Потолок, ДопПараметры.УИСТроки);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьОстатокВМатериалы(ЗаменитьПолотна = Ложь, Знач ЭтоОстаток = Истина, Потолок, УИСтроки)
	
	Если ЭтоОстаток Тогда
		НоваяНоменклатура = Справочники.Номенклатура.ОстаткиПленки;
	Иначе
		НоваяНоменклатура = Справочники.Номенклатура.ПолотноЗаказчика;
	КонецЕсли;
	
	Если ЗаменитьПолотна Тогда
		Для Каждого ТекущаяСтрока Из Объект.Материалы Цикл
			Если ТекущаяСтрока.Номенклатура.ВидНоменклатуры = Справочники.ВидыНоменклатуры.Полотно И ТекущаяСтрока.Потолок = Потолок И ТекущаяСтрока.УИСтроки = УИСтроки Тогда
				
				СтараяНоменклатура = ТекущаяСтрока.Номенклатура;

				ТекущаяСтрока.Номенклатура = НоваяНоменклатура;
				ТекущаяСтрока.СерияНоменклатуры = Справочники.СерииНоменклатуры.ПустаяСсылка();
				ТекущаяСтрока.ХарактеристикаНоменклатуры = Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка();
				
				// У остатка / материала закзчика всегда базовая единица измерения
				// и коэффициент 1, старое количество переумножаем на коэффициент
				ТекущаяСтрока.ЕдиницаИзмерения = ТекущаяСтрока.Номенклатура.БазоваяЕдиницаИзмерения;
				ТекущаяСтрока.Количество = ТекущаяСтрока.Количество * ТекущаяСтрока.Коэффициент;
				ТекущаяСтрока.Коэффициент = 1;
				
				ТекущаяСтрока.КоличествоКВыработке = ТекущаяСтрока.Количество; // №14311
				
			КонецЕсли;
		КонецЦикла;
	Иначе
		НоваяСтрока = Объект.Материалы.Добавить();
		НоваяСтрока.Номенклатура = НоваяНоменклатура;
		НоваяСтрока.ЕдиницаИзмерения = НоваяСтрока.Номенклатура.БазоваяЕдиницаИзмерения;
		НоваяСтрока.Коэффициент = 1;
		НоваяСтрока.Потолок = Потолок;
		НоваяСтрока.УИСтроки = УИСтроки;
	КонецЕсли;
	
	ЗаполнитьДанныеОстаткиПоМатериалам(); //2022-05-23
	Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
