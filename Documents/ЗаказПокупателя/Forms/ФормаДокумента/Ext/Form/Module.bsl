		ОткрытьФорму("Документ.ЗаказПокупателя.Форма.ФормаВыбораПотолка", новый Структура("СписокПотолков, ТолькоОдноЗначение", СписокПотолков, Истина), ЭтотОбъект,,,, ОП);		
	Иначе		
		Сообщить("В табличной части товары не были найдены потолки и отрезы");		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораПотолкаСделаноИзМатериаловЗаказчика(ВозвращенноеЗначение, ДопПараметры) Экспорт
	
	Если ВозвращенноеЗначение <> Неопределено Тогда		
		СтруктураПоиска = новый Структура("Потолок, УИСтроки", ВозвращенноеЗначение.Потолок, ВозвращенноеЗначение.УИСтроки);
		НайденныеМатериалыПотолка = Объект.Материалы.НайтиСтроки(СтруктураПоиска);	
		Если НайденныеМатериалыПотолка.Количество() > 0 Тогда	
			ПараметрыОП = Новый Структура("ЭтоОстаток, Потолок, УИСтроки", Ложь, ВозвращенноеЗначение.Потолок, ВозвращенноеЗначение.УИСтроки);		
			ПоказатьВопрос(Новый ОписаниеОповещения("ПослеОтветаНаВопросОЗаменеПолотен", ЭтотОбъект, ПараметрыОП) , "Заменить полотна на ""Материал заказчика""?", РежимДиалогаВопрос.ДаНет);		
		Иначе				
			ДобавитьОстатокВМатериалы(Ложь, Ложь, ВозвращенноеЗначение.Потолок, ВозвращенноеЗначение.УИСтроки);		
		КонецЕсли;		
	КонецЕсли;
	
КонецПроцедуры   

&НаКлиенте
Процедура ПодобратьОстаткиПленки(Команда)
	
	СписокПотолков = ПолучитьСписокПотолков();
	
	Если СписокПотолков.Количество() > 0 Тогда
	
		ОП = новый ОписаниеОповещения("ПослеВыбораПотолкаПодобратьОстаткиПленки", ЭтотОбъект);	
			
		ОткрытьФорму("Документ.ЗаказПокупателя.Форма.ФормаВыбораПотолка", новый Структура("СписокПотолков, ТолькоОдноЗначение", СписокПотолков, Истина), ЭтотОбъект,,,, ОП);
		
	Иначе
		
		Сообщить("В табличной части товары не были найдены потолки и отрезы");
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораПотолкаПодобратьОстаткиПленки(ВозвращенноеЗначение, ДопПараметры) Экспорт
	
	Если ВозвращенноеЗначение <> Неопределено Тогда
		
		СтруктураПоиска = новый Структура("Потолок,УИСтроки", ВозвращенноеЗначение.Потолок, ВозвращенноеЗначение.УИСтроки);
		НайденныеМатериалыПотолка = Объект.Материалы.НайтиСтроки(СтруктураПоиска);
		
		Если НайденныеМатериалыПотолка.Количество() > 0 Тогда
		
			ПараметрыОП = Новый Структура("Потолок, УИСтроки", ВозвращенноеЗначение.Потолок, ВозвращенноеЗначение.УИСтроки);
			ПоказатьВопрос(Новый ОписаниеОповещения("ПослеОтветаНаВопросОЗаменеПолотенНаОстатокПоштучно", ЭтотОбъект, ПараметрыОП) ,"Заменить полотна на ""Остаток""?", РежимДиалогаВопрос.ДаНет);
			
		Иначе					
			
			ВызватьДиалогПодбораОстатков(Ложь, ВозвращенноеЗначение.Потолок, ВозвращенноеЗначение.УИСтроки);
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеОтветаНаВопросОЗаменеПолотенНаОстатокПоштучно(Ответ, ДопПараметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Да Тогда
        ВызватьДиалогПодбораОстатков(Истина, ДопПараметры.Потолок, ДопПараметры.УИСТроки);
	Иначе
		ВызватьДиалогПодбораОстатков(Ложь, ДопПараметры.Потолок, ДопПараметры.УИСТроки);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте 
Процедура ВызватьДиалогПодбораОстатков(ЗаменитьПолотнаВДокументе, Потолок, УИСтроки)
	
	ПараметрыПодбора = Новый Структура;
	ПараметрыПодбора.Вставить("Организация",			Объект.Организация);	
	ПараметрыПодбора.Вставить("ВидНоменклатуры",		ПолучитьСписокВидовНоменклатурыОстаткиПленки());
	ПараметрыПодбора.Вставить("ТолькоВНаличии",			Истина);
	ПараметрыПодбора.Вставить("НеЗапрашиватьЦену",		Истина);
	ПараметрыПодбора.Вставить("ВАльтернативнойЕдиницеИзмерения", Истина);
	
	ОП = новый ОписаниеОповещения("ПослеПодбораОстатков", ЭтотОбъект, новый Структура("Потолок, ЗаменитьПолотнаВДокументе, УИСтроки", Потолок, ЗаменитьПолотнаВДокументе, УИСтроки));
	ОткрытьФорму("ОбщаяФорма.ФормаПодбораНоменклатуры", ПараметрыПодбора, ЭтотОбъект,,,, ОП);		
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеПодбораОстатков(ВозвращенноеЗначение, ДопПараметры) Экспорт
	
	Если ВозвращенноеЗначение <> Неопределено Тогда
		
		ВызватьДиалогПодбораОстатковНаСервере(ДопПараметры.ЗаменитьПолотнаВДокументе, ВозвращенноеЗначение, ДопПараметры.Потолок, ДопПараметры.УИСтроки)
		
	КонецЕсли;
	
КонецПроцедуры	

&НаСервере
Функция ПолучитьСписокВидовНоменклатурыОстаткиПленки()
	
	Список = Новый СписокЗначений;
	Список.Добавить(Справочники.ВидыНоменклатуры.ОстатокПленки);
	Возврат Список;
	
КонецФункции

&НаСервере
Процедура ВызватьДиалогПодбораОстатковНаСервере(ЗаменитьПолотнаВДокументе, ВозвращенноеЗначение, Потолок, УИСтроки)
	
	ВременнаяТаблица = Новый ТаблицаЗначений;
	ВременнаяТаблица.Колонки.Добавить("Номенклатура");
	ВременнаяТаблица.Колонки.Добавить("Количество");
	ВременнаяТаблица.Колонки.Добавить("ЕдиницаИзмерения");
	ВременнаяТаблица.Колонки.Добавить("Коэффициент");
	ВременнаяТаблица.Колонки.Добавить("Цена");
	ВременнаяТаблица.Колонки.Добавить("Сумма");
	ВременнаяТаблица.Колонки.Добавить("ХарактеристикаНоменклатуры");
	ВременнаяТаблица.Колонки.Добавить("Фактура");
	ВременнаяТаблица.Колонки.Добавить("Цвет");
	ВременнаяТаблица.Колонки.Добавить("НоменклатураКЗамене", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	
	Для Каждого ТекСтрока Из ВозвращенноеЗначение Цикл
		НоваяСтрока = ВременнаяТаблица.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
	КонецЦикла;
	
	
	Для Каждого ТекМатериал Из Объект.Материалы Цикл
		Если ТекМатериал.Номенклатура.ВидНоменклатуры = ПредопределенноеЗначение("Справочник.ВидыНоменклатуры.Полотно") И ТекМатериал.Потолок = Потолок И ТекМатериал.УИСтроки = УИСтроки Тогда
			Для Каждого ТекОстаток Из ВременнаяТаблица Цикл
				Если ТекОстаток.НоменклатураКЗамене.Пустая() Тогда
					ТекОстаток.НоменклатураКЗамене = ТекМатериал.Номенклатура;
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого ТекущаяСтрока из ВременнаяТаблица Цикл
		Если ТекущаяСтрока.НоменклатураКЗамене.Пустая() Тогда
			НоваяСтрока = Объект.Материалы.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущаяСтрока);
			НоваяСтрока.Потолок = Потолок;
			НоваяСтрока.УИСтроки = УИСтроки;
			НоваяСтрока.КоличествоКВыработке = НоваяСтрока.Количество; // №14311
		Иначе
			Отбор = Новый Структура;
			Отбор.Вставить("Номенклатура", ТекущаяСтрока.НоменклатураКЗамене);
			Отбор.Вставить("Потолок", Потолок);
			Отбор.Вставить("УИСтроки", УИСтроки);
			НайденныеСтроки = Объект.Материалы.НайтиСтроки(Отбор);
			Если НайденныеСтроки.Количество() > 0 Тогда
				ЗаполнитьЗначенияСвойств(НайденныеСтроки[0], ТекущаяСтрока);
				НайденныеСтроки[0].КоличествоКВыработке = НайденныеСтроки[0].Количество; // №14311
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	ЗаполнитьДанныеОстаткиПоМатериалам(); //2022-05-23	
	Модифицированность = Истина;

КонецПроцедуры

&НаСервере
Функция ПолучитьСписокТиповыхОтрезов()
	
	СписокТиповыхОтрезов = новый СписокЗначений;
	
	//++ №14932 смотрим теперь по настройке
	//ЗаказыватьТовары = Константы.ЗаказыватьТоварыПриОформленииЗаказаНаПроизводствоНаОснованииЗаказаПокупателя.Получить();
	МассивРазрешенныхНоменклатур = ПолучитьНоменклатуруКЗаказуНаПроизводствоПоОтбору();
	//-- №14932
	
	Для Каждого ТекущаяСтрока Из Объект.Товары Цикл
		
		ЭтоТиповойОтрез = (ТекущаяСтрока.Номенклатура.ВидНоменклатуры = Справочники.ВидыНоменклатуры.ТиповойОтрез);
		ЕстьДокументВыпускаПоПродукции = ЕстьДокументВыпускаПоПродукции(ТекущаяСтрока.Номенклатура, ТекущаяСтрока.ХарактеристикаНоменклатуры);
		
		Если (ЭтоТиповойОтрез 
				//И НЕ ТекущаяСтрока.ЕстьДокументВыпускаПоПотолку)
				И НЕ ЕстьДокументВыпускаПоПродукции)
			ИЛИ 
			(НЕ ЭтоТиповойОтрез
				//++ №14932 смотрим теперь по настройке
				//ЗаказыватьТовары
				И НЕ МассивРазрешенныхНоменклатур.Найти(ТекущаяСтрока.Номенклатура) = Неопределено
				//-- №14932
				И НЕ ЭтоУслугаСервер(ТекущаяСтрока.Номенклатура) 
				И НЕ ТекущаяСтрока.Номенклатура.ВидНоменклатуры = Справочники.ВидыНоменклатуры.Потолок
			)
			Тогда
			
			СтруктураСтрокиПотолка = Новый Структура;
			СтруктураСтрокиПотолка.Вставить("Потолок",ТекущаяСтрока.Номенклатура);
			СтруктураСтрокиПотолка.Вставить("УИСтроки",ТекущаяСтрока.УИСтроки);
			СписокТиповыхОтрезов.Добавить(СтруктураСтрокиПотолка);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат СписокТиповыхОтрезов;
	
КонецФункции

&НаКлиенте
Процедура ЗаполнитьМатериалыПоСпецификациям(Команда)
	
	СписокТиповыхОтрезов = ПолучитьСписокТиповыхОтрезов();
	
	Если СписокТиповыхОтрезов.Количество() > 0 Тогда
	
		ОП = новый ОписаниеОповещения("ПослеВыбораТиповыхОтрезовЗаполнитьМатериалыПоСпецификациям", ЭтотОбъект);	
			
		ОткрытьФорму("Документ.ЗаказПокупателя.Форма.ФормаВыбораПотолка", новый Структура("СписокПотолков", СписокТиповыхОтрезов), ЭтотОбъект,,,, ОП);
		
	Иначе
		
		Сообщить("В табличной части товары не были найдены товары по которым можно произвести заполнение по спецификации");
		
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораТиповыхОтрезовЗаполнитьМатериалыПоСпецификациям(ВозвращенныеЗначения, ДопПараметры) Экспорт
	
	Если ВозвращенныеЗначения <> Неопределено И ТипЗнч(ВозвращенныеЗначения) = Тип("Массив") Тогда
		
		Если Объект.Материалы.Количество() > 0 Тогда
			ОП = новый ОписаниеОповещения("ПослеВопросаОбОчисткеМатериаловПриЗаполненииПоСпецицикациям", ЭтотОбъект, новый Структура("СписокТиповыхОтрезов", ВозвращенныеЗначения));
			ПоказатьВопрос(ОП, "Очистить табличную часть материалы?", РежимДиалогаВопрос.ДаНет);
		Иначе
			ЗаполнитьМатериалыПоСпецификациямНаСервере(ВозвращенныеЗначения, Ложь);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВопросаОбОчисткеМатериаловПриЗаполненииПоСпецицикациям(Ответ, ДопПараметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Да Тогда
		ЗаполнитьМатериалыПоСпецификациямНаСервере(ДопПараметры.СписокТиповыхОтрезов, Истина);
	ИначеЕсли Ответ = КодВозвратаДиалога.Нет Тогда
		ЗаполнитьМатериалыПоСпецификациямНаСервере(ДопПараметры.СписокТиповыхОтрезов, Ложь);	
	КонецЕсли;	
	
КонецПроцедуры	

&НаСервере
Процедура ЗаполнитьМатериалыПоСпецификациямНаСервере(СписокТиповыхОтрезов, ОчиститьТЧ)
	
	Если ОчиститьТЧ Тогда
		Объект.Материалы.Очистить();
	КонецЕсли;	
	
	ВременнаяТаблица = Новый ТаблицаЗначений; //хранит общее количество необходимых материалов по спецификации после округления общего количества товаров
	ВременнаяТаблица.Колонки.Добавить("Номенклатура");
	ВременнаяТаблица.Колонки.Добавить("ХарактеристикаНоменклатуры");
	ВременнаяТаблица.Колонки.Добавить("ОкруглятьВБольшуюСторону");
	ВременнаяТаблица.Колонки.Добавить("ПорядокОкругленияЧислом");
	ВременнаяТаблица.Колонки.Добавить("КоличествоДоОкругления");
	ВременнаяТаблица.Колонки.Добавить("КоличествоПослеОкругления");
	ВременнаяТаблица.Колонки.Добавить("Потолок");
	ВременнаяТаблица.Колонки.Добавить("УИСтроки"); //хранит УИСТроки потолка, к которому относится
	
	ТаблицаМатериалов = Новый ТаблицаЗначений;
	ТаблицаМатериалов.Колонки.Добавить("Номенклатура");
	ТаблицаМатериалов.Колонки.Добавить("ХарактеристикаНоменклатуры");
	ТаблицаМатериалов.Колонки.Добавить("ЕдиницаИзмерения");
	ТаблицаМатериалов.Колонки.Добавить("Коэффициент");
	ТаблицаМатериалов.Колонки.Добавить("Количество");
	ТаблицаМатериалов.Колонки.Добавить("Потолок");
	ТаблицаМатериалов.Колонки.Добавить("УИСтроки"); //хранит УИСТроки потолка, к которому относится
	
	
	//Для Каждого ТекущаяСтрока Из Объект.Продукция Цикл
	Для Каждого ТиповойОтрез Из СписокТиповыхОтрезов Цикл
		
		СтруктураПоиска = новый Структура("Номенклатура,УИСтроки", ТиповойОтрез.Потолок, ТиповойОтрез.УИСтроки);
		НайденныеСтроки = Объект.Товары.НайтиСтроки(СтруктураПоиска);
		
		Если НайденныеСтроки.Количество() > 0 Тогда
			
			ТекущаяСтрока = НайденныеСтроки[0];
			//НоваяСтрока = ТаблицаМатериалов.Добавить(); - не понятно зачем пустую строку добавляет?
			
			Если НЕ ТекущаяСтрока.Спецификация.Пустая() Тогда
				Для Каждого СтрокаСпецификации Из ТекущаяСтрока.Спецификация.Состав Цикл
					КоэффициентИзменения = ?(СтрокаСпецификации.ФиксированноеКоличество, 1, ТекущаяСтрока.Количество * ТекущаяСтрока.Коэффициент);
					КоличествоКДобавлению = ОбщийМодуль.ОкруглитьЧисло(КоэффициентИзменения * СтрокаСпецификации.Количество,СтрокаСпецификации.ПорядокОкругленияЧислом,СтрокаСпецификации.ОкруглятьВБольшуюСторону); 
					Если КоличествоКДобавлению > 0 Тогда
						НоваяСтрока = ТаблицаМатериалов.Добавить();
						ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаСпецификации);
						НоваяСтрока.Количество = КоличествоКДобавлению;
						НоваяСтрока.Потолок = ТиповойОтрез.Потолок;
						НоваяСтрока.УИСтроки = ТиповойОтрез.УИСтроки;
						
						НоваяВремСтрока = ВременнаяТаблица.Добавить();
						НоваяВремСтрока.Номенклатура = СтрокаСпецификации.Номенклатура;
						НоваяВремСтрока.ХарактеристикаНоменклатуры = СтрокаСпецификации.ХарактеристикаНоменклатуры;
						НоваяВремСтрока.ОкруглятьВБольшуюСторону = СтрокаСпецификации.ОкруглятьВБольшуюСторону;
						НоваяВремСтрока.ПорядокОкругленияЧислом = СтрокаСпецификации.ПорядокОкругленияЧислом;
						НоваяВремСтрока.КоличествоДоОкругления = КоэффициентИзменения * СтрокаСпецификации.Количество;
						НоваяВремСтрока.КоличествоПослеОкругления = 0;
						НоваяВремСтрока.Потолок = ТиповойОтрез.Потолок;
						НоваяВремСтрока.УИСтроки = ТиповойОтрез.УИСтроки;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
			
		КонецЕсли;	
			
	КонецЦикла;
	
	ТаблицаМатериалов.Свернуть("Потолок, УИСтроки, Номенклатура, ХарактеристикаНоменклатуры, ЕдиницаИзмерения, Коэффициент", "Количество");
	ВременнаяТаблица.Свернуть("Потолок, УИСтроки, Номенклатура, ХарактеристикаНоменклатуры, ОкруглятьВБольшуюСторону, ПорядокОкругленияЧислом", "КоличествоДоОкругления, КоличествоПослеОкругления");
	
	//посчитаем сколько какого материала должно быть итого с применением округления
	Для Каждого ТекущаяСтрока Из ВременнаяТаблица Цикл
		ТекущаяСтрока.КоличествоПослеОкругления = ОбщийМодуль.ОкруглитьЧисло(ТекущаяСтрока.КоличествоДоОкругления, ТекущаяСтрока.ПорядокОкругленияЧислом, ТекущаяСтрока.ОкруглятьВБольшуюСторону);
	КонецЦикла;
	
	//получаем итоговое количество каждого материала после всех округлений
	ВременнаяТаблица.Свернуть("Потолок, УИСтроки, Номенклатура, ХарактеристикаНоменклатуры", "КоличествоПослеОкругления");
	
	//перезаполняем количество в результирующей таблице на основании того, сколько должно было бы получиьтся при общем итоге после округления
	Для Каждого ТекущийМатериал Из ТаблицаМатериалов Цикл
		КоличествоБыло = ТекущийМатериал.Количество;
		ТекущийМатериал.Количество = 0;
		Для Каждого ТекущийИтогМатериала Из ВременнаяТаблица Цикл
			Если ТекущийМатериал.Номенклатура = ТекущийИтогМатериала.Номенклатура И ТекущийМатериал.УИСтроки = ТекущийИтогМатериала.УИСтроки Тогда
				Если ТекущийИтогМатериала.КоличествоПослеОкругления >= КоличествоБыло Тогда
					ТекущийМатериал.Количество = КоличествоБыло;
					ТекущийИтогМатериала.КоличествоПослеОкругления = ТекущийИтогМатериала.КоличествоПослеОкругления - КоличествоБыло;
				Иначе
					ТекущийМатериал.Количество = ТекущийИтогМатериала.КоличествоПослеОкругления;
					ТекущийИтогМатериала.КоличествоПослеОкругления = 0;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла
	КонецЦикла;
	
	//переносим таблицу в документ
	Для Каждого ТекущийМатериал Из ТаблицаМатериалов Цикл
		Если НЕ ТекущийМатериал.Количество = 0 Тогда
			НоваяСтрока = Объект.Материалы.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущийМатериал);
			НоваяСтрока.КоличествоКВыработке = НоваяСтрока.Количество;
		КонецЕсли;
	КонецЦикла;
	
	//находим в списке материалов типовые отрезы и меняем их на соответствуюущую пленку
	Для Каждого СтрокаМатериала Из Объект.Материалы Цикл
		Если СтрокаМатериала.Номенклатура.ВидНоменклатуры = Справочники.ВидыНоменклатуры.ТиповойОтрез Тогда
			НоменклатураОтреза = СтрокаМатериала.Номенклатура;
			КоличествоОтреза = СтрокаМатериала.Количество;
			ЕдиницаИзмеренияОтреза = СтрокаМатериала.ЕдиницаИзмерения;
			
			ВремНоменклатура = Справочники.Номенклатура.ПолучитьОсновнуюФактуруИЦветПотолка(НоменклатураОтреза).ПродукцияЦвет.Номенклатура;
			Если НЕ ВремНоменклатура.Пустая() Тогда
				СтрокаМатериала.Номенклатура = ВремНоменклатура;
				СтрокаМатериала.ЕдиницаИзмерения = ОбщийМодульВызовСервера.ПолучитьБазовуюЕдиницуИзмеренияНоменклатуры(СтрокаМатериала.Номенклатура);
				СтрокаМатериала.Коэффициент = 1;
				Если СтрокаМатериала.ЕдиницаИзмерения = Справочники.КлассификаторЕдиницИзмерения.МетрПогонный Тогда
					ШиринаПолотна = НоменклатураОтреза.Фактура.ШиринаПолотна / 100;
					Если НЕ ШиринаПолотна = 0 Тогда
						СтрокаМатериала.Количество = Окр(КоличествоОтреза / ШиринаПолотна,2);
					Иначе
						СтрокаМатериала.Количество = 0;
					КонецЕсли;
				Иначе
					СтрокаМатериала.Количество = КоличествоОтреза;
				КонецЕсли;
				СтрокаМатериала.КоличествоКВыработке = КоличествоОтреза;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	ЗаполнитьДанныеОстаткиПоМатериалам(); //2022-05-23
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДанныеОстаткиПоМатериалам()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТЗЗаказПокупателяМатериалы.Номенклатура КАК Номенклатура,
	|	ТЗЗаказПокупателяМатериалы.ХарактеристикаНоменклатуры,
	|	ТЗЗаказПокупателяМатериалы.СерияНоменклатуры,
	|	ТЗЗаказПокупателяМатериалы.Количество КАК Количество,
	|	ТЗЗаказПокупателяМатериалы.Коэффициент КАК Коэффициент,
	|	ТЗЗаказПокупателяМатериалы.Потолок КАК Потолок
	|ПОМЕСТИТЬ ВремЗаказПокупателяТовары
	|ИЗ
	|	&ТаблицаДокумента КАК ТЗЗаказПокупателяМатериалы
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЗаказПокупателяМатериалы.Номенклатура КАК Номенклатура,
	|	ЗаказПокупателяМатериалы.ХарактеристикаНоменклатуры,
	|	ЗаказПокупателяМатериалы.СерияНоменклатуры,
	|	ВЫБОР
	|		КОГДА ЗаказПокупателяМатериалы.Коэффициент <> 0
	|			ТОГДА ТоварыНаСкладахОстатки.КоличествоОстаток / ЗаказПокупателяМатериалы.Коэффициент
	|		ИНАЧЕ ТоварыНаСкладахОстатки.КоличествоОстаток
	|	КОНЕЦ КАК ОстатокНаСкладе,
	|	ЕСТЬNULL(ВЫБОР		
	|		КОГДА &ИспользоватьРезервирование
	|			ТОГДА ВЫБОР
	|					КОГДА ЗаказПокупателяМатериалы.Коэффициент <> 0
	|						ТОГДА ВРезервеОстатки.КоличествоОстаток / ЗаказПокупателяМатериалы.Коэффициент
	|					ИНАЧЕ ВРезервеОстатки.КоличествоОстаток
	|				КОНЕЦ
	|		ИНАЧЕ 0
	|	КОНЕЦ, 0) КАК КоличествоВРезерве
	//|	ЗаказПокупателяМатериалы.Потолок КАК Потолок,
	//|	ВЫБОР
	//|		КОГДА ОстаткиОбороты.Регистратор ССЫЛКА Документ.ВыпускПродукции
	//|			ТОГДА ЕСТЬNULL(ОстаткиОбороты.КоличествоПриход, 0)
	//|		ИНАЧЕ 0
	//|	КОНЕЦ КАК ВыпускПотолка
	|ИЗ
	|	ВремЗаказПокупателяТовары КАК ЗаказПокупателяМатериалы
	
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыНаСкладах.Остатки(
	|				,
	|				ВЫБОР
	|						КОГДА &ИспользуютсяОбщиеСклады
	|							ТОГДА ИСТИНА
	|						ИНАЧЕ Организация = &Организация
	|					КОНЕЦ
	|					И Склад = &Склад) КАК ТоварыНаСкладахОстатки
	|		ПО ЗаказПокупателяМатериалы.Номенклатура = ТоварыНаСкладахОстатки.Номенклатура
	
	//|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыНаСкладах.Обороты(, , Регистратор, ) КАК ОстаткиОбороты
	//|		ПО ЗаказПокупателяМатериалы.Потолок = ОстаткиОбороты.Номенклатура
	
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыВРезервеНаСкладах.Остатки(,
	|				Склад = &Склад
	|					И ВЫБОР
	|						КОГДА &ИспользуютсяОбщиеСклады
	|							ТОГДА ИСТИНА
	|						ИНАЧЕ Организация = &Организация
	|					КОНЕЦ) КАК ВРезервеОстатки
	|		ПО (ЗаказПокупателяМатериалы.Номенклатура = ВРезервеОстатки.Номенклатура)
	|			И (ЗаказПокупателяМатериалы.ХарактеристикаНоменклатуры = ВРезервеОстатки.ХарактеристикаНоменклатуры)
	|			И (ЗаказПокупателяМатериалы.СерияНоменклатуры = ВРезервеОстатки.СерияНоменклатуры)
	|";
	Запрос.УстановитьПараметр("ТаблицаДокумента", Объект.Материалы.Выгрузить());
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	Запрос.УстановитьПараметр("Склад", Объект.СкладМатериалов);
	Запрос.УстановитьПараметр("ИспользуютсяОбщиеСклады", Константы.ОбщиеСклады.Получить());
	Запрос.УстановитьПараметр("ИспользоватьРезервирование", ИспользоватьРезервирование);
	Запрос.УстановитьПараметр("ТекущийЗаказ", Объект.Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	
	Для Каждого ТекущаяСтрока Из Объект.Материалы Цикл
		Отбор = Новый Структура;
		Отбор.Вставить("Номенклатура", ТекущаяСтрока.Номенклатура);
		Отбор.Вставить("ХарактеристикаНоменклатуры", ТекущаяСтрока.ХарактеристикаНоменклатуры);
		Отбор.Вставить("СерияНоменклатуры", ТекущаяСтрока.СерияНоменклатуры);
		НайденныеСтроки = РезультатЗапроса.НайтиСтроки(Отбор);
		Если НайденныеСтроки.Количество() > 0 Тогда
			ТекущаяСтрока.ОстатокНаСкладе = НайденныеСтроки[0].ОстатокНаСкладе;		
			ТекущаяСтрока.ВРезерве 		  = НайденныеСтроки[0].КоличествоВРезерве;
			ТекущаяСтрока.Доступно 		  = ТекущаяСтрока.ОстатокНаСкладе - ТекущаяСтрока.ВРезерве;
			//Если НЕ ТекущаяСтрока.Потолок = Неопределено И НЕ ТекущаяСтрока.Потолок.Пустая() и ЭтоНоменклатураУникальногоПотолкаИлиОтреза(ТекущаяСтрока.Потолок) Тогда				
			//	//если это номенклатура, привязанная к выпуску потолка, заполняем наличие выпуска потолка
			//	Если НайденныеСтроки[0].ВыпускПотолка > 0 Тогда
			//		ТекущаяСтрока.ЕстьДокументВыпускаПоПотолку = Истина;
			//	Иначе
			//		ТекущаяСтрока.ЕстьДокументВыпускаПоПотолку = Ложь;
			//	КонецЕсли;
			//ИначеЕсли НЕ ТекущаяСтрока.Потолок = Неопределено И НЕ ТекущаяСтрока.Потолок.Пустая() и НЕ ЭтоНоменклатураУникальногоПотолкаИлиОтреза(ТекущаяСтрока.Потолок) Тогда
			//	//если это номенклатура, привязанная к выпуску типового товара (материала или типового отреза), считаемб что выпуск есть, если есть заказ на производство в статусе Произведен
			//	Отбор = Новый Структура;
			//	Отбор.Вставить("УИСтроки",ТекущаяСтрока.УИСтроки);
			//	НайденныеСтроки = Объект.Товары.НайтиСтроки(Отбор);
			//	Если НайденныеСтроки.Количество() > 0 Тогда
			//		ЗаказНаПроизводство = НайденныеСтроки[0].ЗаказНаПроизводство;
			//		Если НЕ ЗаказНаПроизводство = Неопределено И НЕ ЗаказНаПроизводство.Пустая() Тогда
			//			Если ЗаказНаПроизводство.ТекущийСтатус = Справочники.СтатусыЗаказовНаПроизводство.Произведен Тогда
			//				ТекущаяСтрока.ЕстьДокументВыпускаПоПотолку = Истина;
			//			Иначе
			//				ТекущаяСтрока.ЕстьДокументВыпускаПоПотолку = Ложь;
			//			КонецЕсли;
			//		Иначе
			//			ТекущаяСтрока.ЕстьДокументВыпускаПоПотолку = Ложь;
			//		КонецЕсли;
			//	КонецЕсли;
			//	
			//КонецЕсли;			
		Иначе
			ТекущаяСтрока.ОстатокНаСкладе = 0;
			ТекущаяСтрока.ВРезерве 		  = 0;
			ТекущаяСтрока.Доступно 		  = 0;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура МатериалыПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	ЗаполнитьДанныеОстаткиПоМатериалам();
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВопросаОбОтменеЗНП(Результат, ДополнительныеПараметры) Экспорт
	
	Если НЕ Результат = КодВозвратаДиалога.Да Тогда
		Возврат;	
	КонецЕсли;
	
	ЗНПОтменен = ОбщийМодульВызовСервера.ИзменитьСтатусЗаказНаПроизводство(ДополнительныеПараметры.ЗаказНаПроизводство, ПредопределенноеЗначение("Справочник.СтатусыЗаказовНаПроизводство.Отменен"));
	
	Если ЗНПОтменен Тогда
		ПредупредитьОбУдаленииСтрокиЗавершение(КодВозвратаДиалога.Да, ДополнительныеПараметры);	
	КонецЕсли;
	
КонецПроцедуры
				
&НаКлиенте
Процедура ПредупредитьОбУдаленииСтроки(ТабличнаяЧасть, ИдентификаторСтроки, ТекстВопроса, ЭтоНоменклатураПотолкаИлиОтреза = Ложь, Номенклатура = Неопределено, УИСтроки = Неопределено)
   
   ПоказатьВопрос(Новый ОписаниеОповещения("ПредупредитьОбУдаленииСтрокиЗавершение", ЭтотОбъект, 
                   Новый Структура("ТабличнаяЧасть, ИдентификаторСтроки, ЭтоНоменклатураПотолкаИлиОтреза, Номенклатура, УИСтроки", ТабличнаяЧасть, ИдентификаторСтроки, ЭтоНоменклатураПотолкаИлиОтреза, Номенклатура, УИСтроки)),
                   ТекстВопроса,РежимДиалогаВопрос.ДаНет); 
   
КонецПроцедуры                       
 
&НаКлиенте
Процедура ПредупредитьОбУдаленииСтрокиЗавершение(Ответ, ДопПараметры) Экспорт	
	
	ОтказОтУдаления = (Ответ = КодВозвратаДиалога.Да);
	Если Ответ = КодВозвратаДиалога.Да Тогда
		ИдентификаторСтроки = ДопПараметры.ИдентификаторСтроки;
		Если ДопПараметры.ТабличнаяЧасть = "ТоварыДерево" Тогда
		   	ТекущаяСтрока       = ТоварыДерево.НайтиПоИдентификатору(ИдентификаторСтроки);
			СтрокаРодитель      = ТекущаяСтрока.ПолучитьРодителя();

			Если СтрокаРодитель = Неопределено Тогда
			   ТоварыДерево.ПолучитьЭлементы().Удалить(ТекущаяСтрока);
			Иначе
			   СтрокаРодитель.ПолучитьЭлементы().Удалить(ТекущаяСтрока);
		   КонецЕсли;
		   
		    ПеренестиДеревоВТабличнуюЧасть();
		Иначе				
			ТекущаяСтрока = Объект[ДопПараметры.ТабличнаяЧасть].НайтиПоИдентификатору(ИдентификаторСтроки);
			Объект[ДопПараметры.ТабличнаяЧасть].Удалить(ТекущаяСтрока);
		КонецЕсли;
		
		УдалитьИзТоваровУслугиОтносящиесяКПотолку(ДопПараметры.Номенклатура, ДопПараметры.УИСтроки);
		УдалитьМатериалыОтносящиесяКПозиции(ДопПараметры.Номенклатура, ДопПараметры.УИСтроки);
		
		Модифицированность = Истина;		
		ОбновитьДанныеДокумента();

	КонецЕсли; 
   
КонецПроцедуры

&НаКлиенте
Процедура МатериалыПередНачаломИзменения(Элемент, Отказ)
	
	ТекущиеДанные = Элементы.Материалы.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
		
	Если ЗначениеЗаполнено(ТекущиеДанные.Потолок) Тогда
		// материал относится к продукции
		
		ЭтоМатериалУникальнойПродукции = ЭтоУникальнаяПродукцияСервер(ТекущиеДанные.Потолок);
		
		ЕстьДокументВыпускаПоПродукции = Ложь;
		ЕстьЗНПВСтатусеНеОтменен = Ложь;
		СтрокаПродукции = НайтиСтрокуПродукцииПоУИС(ТекущиеДанные.УИСтроки);
		Если НЕ СтрокаПродукции = Неопределено Тогда				
			Если ЭтоМатериалУникальнойПродукции Тогда
				ЕстьДокументВыпускаПоПродукции = ЕстьДокументВыпускаПоПродукции(СтрокаПродукции.Номенклатура, СтрокаПродукции.ХарактеристикаНоменклатуры);
			Иначе
				ЕстьДокументВыпускаПоПродукции = ЕстьДокументВыпускаПоПродукцииПоЗНП(СтрокаПродукции.ЗаказНаПроизводство);
			КонецЕсли;
			ЕстьЗНПВСтатусеНеОтменен = ЕстьДокументЗНПВСтатусеНеОтменен(СтрокаПродукции.ЗаказНаПроизводство);
		КонецЕсли;

		//обработка если материал привязан к уникальному потолку
		Если ЕстьДокументВыпускаПоПродукции Тогда
			//если уже был выпуск, запрашиваем подтверждение на удаление
			ТекстВопроса = "По продукции " + ТекущиеДанные.Потолок + " имеется проведенный документ выпуска. Продолжить?"; 
			ЗадатьВопросПередИзменениемСтроки(Отказ, Элемент, ТекстВопроса);
			
		ИначеЕсли ЕстьЗНПВСтатусеНеОтменен Тогда
			//выпуска не было, но есть заказ на производство в статусе "В производстве"
			ТекстВопроса = "По продукции " + ТекущиеДанные.Потолок + " имеется Заказ на производство в работе. Продолжить?"; 
			ЗадатьВопросПередИзменениемСтроки(Отказ, Элемент, ТекстВопроса);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

