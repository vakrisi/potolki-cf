	//Если ДокументМодифицирован И Объект.Проведен Тогда
	Если Объект.Проведен Тогда
			
		МассивДокументов = ПолучитьМассивДокументовРазличийСЗаказамиНаПроизводство(Объект.Ссылка);
		
		Если МассивДокументов.Количество() > 0 Тогда
			
			ТекстСообщения = "Сведения в заказе покупателя, являющемся основанием для заказов на производство отличаются.
				|Необходимо перезаполнить заказы на производство по текущему заказу покупателя.
