КонецФункции

&НаСервереБезКонтекста
Функция ПродукцияВозвращенаПолностью(Знач Номенклатура, Знач ХарактеристикаНоменклатуры, Заказ)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Номенклатура",				Номенклатура);
	Запрос.УстановитьПараметр("ХарактеристикаНоменклатуры",	ХарактеристикаНоменклатуры);
	Запрос.УстановитьПараметр("Заказ",						Заказ);
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВыпускПотолков.Номенклатура КАК Номенклатура,
	|	ЕСТЬNULL(ВыпускПотолков.КоличествоПриход, 0) КАК ВыпускПродукции,
	|	ЕСТЬNULL(ВозвратыПродукции.КоличествоРасход, 0) КАК КоличествоВозврат
	|ИЗ
	|	РегистрНакопления.ТоварыНаСкладах.Обороты(
	|			,
	|			,
	|			Регистратор,
	|			Номенклатура = &Номенклатура
	|				И ХарактеристикаНоменклатуры = &ХарактеристикаНоменклатуры) КАК ВыпускПотолков
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ЗаказыПокупателей.Обороты(
	|				,
	|				,
	|				Регистратор,
	|				Номенклатура = &Номенклатура
	|					И ХарактеристикаНоменклатуры = &ХарактеристикаНоменклатуры
	|					И ЗаказНаПроизводство = &Заказ) КАК ВозвратыПродукции
	|		ПО ВыпускПотолков.Номенклатура = ВозвратыПродукции.Номенклатура
	|			И ВыпускПотолков.ХарактеристикаНоменклатуры = ВозвратыПродукции.ХарактеристикаНоменклатуры
	|			И (ВозвратыПродукции.Регистратор ССЫЛКА Документ.ВозвратПродукции)
	|ГДЕ
	|	ВыпускПотолков.Регистратор ССЫЛКА Документ.ВыпускПродукции"; 
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Если Выборка.ВыпускПродукции > 0 И Выборка.ВыпускПродукции = Выборка.КоличествоВозврат Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Ложь;

КонецФункции

&НаСервереБезКонтекста
Функция ЕстьДокументЗНПВСтатусеНеОтменен(Знач ЗаказНаПроизводство)
	
	Если НЕ ЗначениеЗаполнено(ЗаказНаПроизводство) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	РеквизитыЗНП = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ЗаказНаПроизводство, "Проведен, ТекущийСтатус");		
	
	Если РеквизитыЗНП.Проведен И НЕ РеквизитыЗНП.ТекущийСтатус = Справочники.СтатусыЗаказовНаПроизводство.Отменен Тогда
		Возврат Истина;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

&НаСервереБезКонтекста
Функция ЕстьДокументВыпускаПоПродукцииПоЗНП(Знач ЗаказНаПроизводство)
	
	Результат = Ложь;
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ВыпускПродукции.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ВыпускПродукции КАК ВыпускПродукции
	|ГДЕ
	|	ВыпускПродукции.Основание = &Основание
	|	И ВыпускПродукции.Проведен";
	Запрос.УстановитьПараметр("Основание", ЗаказНаПроизводство);
	
	Результат = Запрос.Выполнить().Выбрать().Количество() > 0;
	
	Возврат Результат;
	
КонецФункции

