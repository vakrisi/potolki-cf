&НаСервере
Процедура УстановитьВидимостьЭлементовРозницы()

	ВидимостьГруппыКомнатаНазначение = Объект.Основание <> Неопределено 
											И НЕ Объект.Основание.Пустая()
											И (ТипЗнч(Объект.Основание) = Тип("ДокументСсылка.ЗаказДоговор") ИЛИ ТипЗнч(Объект.Основание) = Тип("ДокументСсылка.Монтаж"));	
	Элементы.ТоварыКомната.Видимость = ВидимостьГруппыКомнатаНазначение И Объект.СозданПриИспользованииНастройкиУчетОбеспеченностиРозницыПоКомнатам;
	Элементы.ТоварыНазначение.Видимость = ВидимостьГруппыКомнатаНазначение;
	Элементы.ТоварыДеревоКомната.Видимость = ВидимостьГруппыКомнатаНазначение И Объект.СозданПриИспользованииНастройкиУчетОбеспеченностиРозницыПоКомнатам;
	Элементы.ТоварыДеревоНазначение.Видимость = ВидимостьГруппыКомнатаНазначение;
	
	Элементы.НастройкаИнтеркампани.Доступность = Объект.ЭтоЗаказОтРозницы;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьРеквизитовДляИнтернетОплаты()
	
	Элементы.ГруппаРеквизитыДляИнтернетОплаты.Видимость = ИспользоватьИнтернетПлатежи 
		И Объект.БанковскийСчет.ИспользоватьИнтернетПлатежи 
		И Объект.Контрагент.ВидКонтрагента = Перечисления.ВидКонтрагента.ФизЛицо;
		
КонецПроцедуры

&НаСервере
Процедура УстановитьДоступностьОтгрузки()
	
	Если Объект.ПометкаУдаления 
		ИЛИ Объект.ТекущийСтатус = ПредопределенноеЗначение("Справочник.СтатусыЗаказовПокупателей.Отменен") 
		ИЛИ Объект.ТекущийСтатус = ПредопределенноеЗначение("Справочник.СтатусыЗаказовПокупателей.Закрыт") 
		Тогда
		Элементы.ФормаКомандаОтгрузитьИПринятьОплату.Доступность = Ложь;
	Иначе
		Элементы.ФормаКомандаОтгрузитьИПринятьОплату.Доступность = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура РассчитатьИтоговыеПоказателиСервер()
	
	ИтогСумма = 0;
	РассчитатьИтоговыеПоказатели(Объект.Товары, ИтогСумма, ИтогСуммаНДС, ИтогПериметрПотолков, СуммаДокументаБезУчетаБонусов);
	Если НЕ Объект.СуммаДокумента = ИтогСумма Тогда
		Объект.СуммаДокумента = ИтогСумма;
	КонецЕсли;
	
	//nva+++
	РасчитатьИтоговыеПоказателиМаржиСервер();	
	//nva---
	
КонецПроцедуры

