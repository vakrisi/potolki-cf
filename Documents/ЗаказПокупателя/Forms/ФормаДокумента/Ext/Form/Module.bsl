&НаСервереБезКонтекста
Функция ПолучитьДанныеНоменклатурыПриИзменении(СтруктураДанные)
	
	//СтруктураДанные.Вставить("Номенклатура");
	//СтруктураДанные.Вставить("ХарактеристикаНоменклатуры");
	//СтруктураДанные.Вставить("ЕдиницаИзмерения");
	//СтруктураДанные.Вставить("Дата");
	//СтруктураДанные.Вставить("ВидЦен");
	//СтруктураДанные.Вставить("Валюта");
	//СтруктураДанные.Вставить("Контрагент");
	//СтруктураДанные.Вставить("ДоговорКонтрагента");
	//СтруктураДанные.Вставить("ДопВалюта");
	//СтруктураДанные.Вставить("ЦеныВДопВалюте");
	
	Цена = 0;
	ВалютаЦены = ?(СтруктураДанные.ЦеныВДопВалюте, СтруктураДанные.ДопВалюта, СтруктураДанные.Валюта);
	
	Цена = ЦеныКомпании.ПолучитьЦенуНоменклатуры(СтруктураДанные.Номенклатура, СтруктураДанные.ХарактеристикаНоменклатуры, СтруктураДанные.ЕдиницаИзмерения, СтруктураДанные.Количество,
										     	  СтруктураДанные.Дата, СтруктураДанные.ВидЦен, ВалютаЦены,
												  СтруктураДанные.Организация, СтруктураДанные.Подразделение,
												  СтруктураДанные.Контрагент, СтруктураДанные.ДоговорКонтрагента);
					  
	Если НЕ СтруктураДанные.ЦеныВДопВалюте Тогда
		СтруктураДанные.Вставить("Цена", Цена);
		СтруктураДанные.Вставить("ЦенаВал", 0);
	Иначе
		СтруктураДанные.Вставить("Цена", РаботаСВалютой.ПересчитатьИзВалютыВВалюту(СтруктураДанные.ДопВалюта, СтруктураДанные.Валюта, СтруктураДанные.Дата, Цена));
		СтруктураДанные.Вставить("ЦенаВал", Цена);
	КонецЕсли;
	
	Если ТипЗнч(СтруктураДанные.ЕдиницаИзмерения) = Тип("СправочникСсылка.КлассификаторЕдиницИзмерения") Тогда
		СтруктураДанные.Вставить("Коэффициент", 1);
	Иначе
		Если ЗначениеЗаполнено(СтруктураДанные.ЕдиницаИзмерения) Тогда
			СтруктураДанные.Вставить("Коэффициент", ОбщийМодуль.ПолучитьКоэффициентЕдиницыИзмерения(СтруктураДанные.ЕдиницаИзмерения));
		Иначе
			СтруктураДанные.Вставить("Коэффициент", 1);
		КонецЕсли;	
	КонецЕсли;
		
	Если СтруктураДанные.ИспользоватьКонтрольКратности 
		И НЕ ОбщийМодульСервер.НастройкаПользователя("РазрешитьНесоответствиеКратностиЕдиницИзмерения") Тогда
		
		СтруктураПоиска = Новый Структура("ВидДокумента, ЕдиницаИзмерения", Перечисления.ВидыДокументовПроверкиКратности.ЗаказПокупателя, СтруктураДанные.ЕдиницаИзмерения);
		НайденныеСтроки = СтруктураДанные.Номенклатура.Кратность.НайтиСтроки(СтруктураПоиска);
		Если НайденныеСтроки.Количество() > 0 Тогда		
			СтруктураДанные.Вставить("Количество", 0); //#2792
		Иначе
			СтруктураДанные.Вставить("Количество", СтруктураДанные.Количество);
		КонецЕсли;
	Иначе
		СтруктураДанные.Вставить("Количество", СтруктураДанные.Количество);
	КонецЕсли;
	
	Возврат СтруктураДанные;
	
КонецФункции

