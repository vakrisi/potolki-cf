Процедура ДекорацияСсылкаНаДоставкуНажатие(Элемент)
	
	// в названии элемента нужно найти номер в списке
	Позиция = СтрНайти(Элемент.Имя, "Номер_");
	
	Если Позиция = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		НомерСтроки = Число(Сред(Элемент.Имя, Позиция + 6));
	Исключение
		Возврат;
	КонецПопытки;
	
	Если НомерСтроки <= Доставки.Количество()-1 Тогда
		
		СсылкаНаДокумент = Доставки.Получить(НомерСтроки);
		ОткрытьФорму("Документ.ЗаявкаНаДоставку.ФормаОбъекта", новый Структура("Ключ", СсылкаНаДокумент.Значение));
		
	КонецЕсли;
	
КонецПроцедуры

