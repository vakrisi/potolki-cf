	Иначе
		НоваяСтрока = Объект.Товары.Добавить();
		ИмяЭлемента = "Товары";
	КонецЕсли;
	
	НоваяСтрока.Номенклатура = Результат.Номенклатура;
	ИдНовойСтроки = НоваяСтрока.ПолучитьИдентификатор();
	Элементы[ИмяЭлемента].ТекущаяСтрока = ИдНовойСтроки;
	
	НоменклатураТоварыПриИзменении(Элементы[ИмяЭлемента].ТекущиеДанные, Результат.Количество, Ложь, Истина);
	
	//Если ТоварыКакДерево Тогда		
	//	ТоварыДеревоПриИзменении(Неопределено);
	//Иначе
	//	ТоварыПриИзменении(Неопределено);
	//КонецЕсли;
	Если РежимПодробнаяИнформацияПоТоварам Тогда
		ЗаполнитьДанныеКОтгрузкеИОстаткиПоТоварам();
	КонецЕсли;
	РассчитатьИтоговыеПоказателиКлиент();

КонецПроцедуры

