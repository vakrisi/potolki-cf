&НаКлиенте
Процедура ПослеВыбораПотолкаДобавитьПодчиненнуюНоменклатуру(ВозвращенноеЗначение, ДопПараметры) Экспорт
	
	Если ВозвращенноеЗначение <> Неопределено Тогда
		
		ПараметрыПодбора = ПараметрыПодбораНоменклатуры();
		//ПараметрыПодбора = Новый Структура;
		//ПараметрыПодбора.Вставить("Организация",			Объект.Организация);
		//Если Объект.Склад = ПредопределенноеЗначение("Справочник.Склады.ПустаяСсылка") Тогда 
		//	ПараметрыПодбора.Вставить("Склад", 				ПолучитьСкладТекущегоПользователя());
		//Иначе
		//	ПараметрыПодбора.Вставить("Склад",				Объект.Склад);
		//КонецЕсли;	
		СписокВидовНоменклатуры = ПолучитьСписокВидовНоменклатурыТовары();
		СписокВидовНоменклатуры.Добавить(ПредопределенноеЗначение("Справочник.ВидыНоменклатуры.Услуга"));
		ПараметрыПодбора.Вставить("ВидНоменклатуры",		СписокВидовНоменклатуры);
		//ПараметрыПодбора.Вставить("ВидЦены",				Объект.ВидЦен);
		//ПараметрыПодбора.Вставить("Валюта",					Объект.Валюта);
		//Если НЕ ТребуетсяЗаполнениеЦен() Тогда
		//	ПараметрыПодбора.Вставить("НеЗапрашиватьЦену", Истина);
		//КонецЕсли;

		ПодборКПотолку = Истина;
		ДанныеСтрокиПотолка = Новый Структура("Потолок, УИСтроки", ВозвращенноеЗначение.Потолок, ВозвращенноеЗначение.УИСтроки);
		
		ОткрытьФорму("ОбщаяФорма.ФормаПодбораНоменклатуры", ПараметрыПодбора, ЭтотОбъект, УникальныйИдентификатор);	
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаменитьНаАналог(Команда)
	
	Если ТоварыКакДерево Тогда
		ТекущаяСтрока = Элементы.ТоварыДерево.ТекущиеДанные;
	Иначе
		ТекущаяСтрока = Элементы.Товары.ТекущиеДанные;
	КонецЕсли;
	
	Если ТекущаяСтрока = Неопределено Тогда
		Сообщить("Не выбрана позиция");
		Возврат;
	КонецЕсли;
	
	ПараметрыПодбора = Новый Структура;
	ПараметрыПодбора.Вставить("Номенклатура",			ТекущаяСтрока.Номенклатура);
	ПараметрыПодбора.Вставить("Организация",			Объект.Организация);
	Если Объект.Склад = ПредопределенноеЗначение("Справочник.Склады.ПустаяСсылка") Тогда 
		ПараметрыПодбора.Вставить("Склад", 				ПолучитьСкладТекущегоПользователя());
	Иначе
		ПараметрыПодбора.Вставить("Склад",				Объект.Склад);
	КонецЕсли;
	ПараметрыПодбора.Вставить("ВидЦены",				Объект.ВидЦен);
	ПараметрыПодбора.Вставить("Контрагент",				Объект.Контрагент);
	ПараметрыПодбора.Вставить("ДоговорКонтрагента",		Объект.ДоговорКонтрагента);
	
	ОписаниеОповещенияОЗакрытии = Новый ОписаниеОповещения("ПослеВыбораАналога", ЭтаФорма, ТекущаяСтрока.ПолучитьИдентификатор());
	ОткрытьФорму("РегистрСведений.АналогиНоменклатуры.Форма.ФормаВыбораАналога", ПараметрыПодбора, ЭтаФорма,,,,ОписаниеОповещенияОЗакрытии);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораАналога(Результат, ИдТекущейСтроки) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;		
	КонецЕсли;
	
	Если ТоварыКакДерево Тогда
		Элементы.ТоварыДерево.ТекущаяСтрока = ИдТекущейСтроки;
		ТекущаяСтрока = Элементы.ТоварыДерево.ТекущиеДанные;
	Иначе
		Элементы.Товары.ТекущаяСтрока = ИдТекущейСтроки;
		ТекущаяСтрока = Элементы.Товары.ТекущиеДанные;
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(ТекущаяСтрока, Результат);
	ТекущаяСтрока.УИСтроки = Новый УникальныйИдентификатор;
	ТекущаяСтрока.ПроцентРучнойСкидки = 0;
	ТекущаяСтрока.СуммаРучнойСкидки = 0;
	
	//++ №13299
	//ОбработкаТабличныхЧастейКлиент.ПересчитатьСуммуСУчетомСкидокВСтрокеТЧ(ТекущаяСтрока, ИспользуютсяАвтоматическиеСкидки);
	ОбработкаТабличныхЧастейКлиент.ПересчитатьСуммуСУчетомСкидокВСтрокеТЧ(ТекущаяСтрока, ИспользуютсяАвтоматическиеСкидки,, Истина);
	//-- №13299
	
	ОбработкаТабличныхЧастейКлиент.ПересчитатьСуммуНДСВСтрокеТЧ(ТекущаяСтрока, УчитыватьНДС);
	
	ТекПотолок = ТекущаяСтрока.Потолок;
	ТекНоменклатура = ТекущаяСтрока.Номенклатура;
		
	Если ТоварыКакДерево Тогда
		ПеренестиДеревоВТабличнуюЧасть();
	КонецЕсли;
	
	//ОбновитьДанныеДокумента();
	Если РежимПодробнаяИнформацияПоТоварам Тогда
		ЗаполнитьДанныеКОтгрузкеИОстаткиПоТоварам();
	КонецЕсли;
	РассчитатьИтоговыеПоказателиКлиент();
	
	Если ТоварыКакДерево Тогда
		РазвернутьДеревоТоваров(ТекПотолок, ТекНоменклатура);
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьСопутствующиеТовары(Команда)
	
	Если ТоварыКакДерево Тогда
		ТекущаяСтрока = Элементы.ТоварыДерево.ТекущиеДанные;
	Иначе
		ТекущаяСтрока = Элементы.Товары.ТекущиеДанные;
	КонецЕсли;
	
	Если ТекущаяСтрока = Неопределено Тогда
		Сообщить("Не выбрана позиция");
		Возврат;
	КонецЕсли;
	
	ПараметрыПодбора = Новый Структура;
	ПараметрыПодбора.Вставить("Номенклатура",			ТекущаяСтрока.Номенклатура);
	ПараметрыПодбора.Вставить("ХарактеристикаНоменклатуры",			ТекущаяСтрока.ХарактеристикаНоменклатуры);
	ПараметрыПодбора.Вставить("Количество",			ТекущаяСтрока.Количество);	
	
	ОткрытьФорму("РегистрСведений.СопутствующиеТоварыИУслуги.Форма.ФормаПодбора", ПараметрыПодбора, ЭтаФорма, УникальныйИдентификатор);
	
КонецПроцедуры

&НаКлиенте
Процедура ПодборТовары(Команда)
	
	ПараметрыПодбора = ПараметрыПодбораНоменклатуры();
	ОткрытьФорму("ОбщаяФорма.ФормаПодбораНоменклатуры", ПараметрыПодбора, ЭтаФорма, УникальныйИдентификатор);
	
КонецПроцедуры

&НаКлиенте
Процедура СкрытьПодробнуюИнформациюПоТоварам(Команда)
	
	РежимПодробнаяИнформацияПоТоварам = Не РежимПодробнаяИнформацияПоТоварам;
		
	ОбновитьОтображениеКолонокТоваров();
	
	Если РежимПодробнаяИнформацияПоТоварам Тогда
		ЗаполнитьДанныеКОтгрузкеИОстаткиПоТоварам();	
	КонецЕсли;
	
