Процедура ТоварыДеревоПриИзменении(Элемент)
	
	ТекПотолок = Неопределено;
	
	ТекНоменклатура = Неопределено;
	Если НЕ Элементы.ТоварыДерево.ТекущиеДанные = Неопределено Тогда
		ТекПотолок = Элементы.ТоварыДерево.ТекущиеДанные.Потолок;
		ТекНоменклатура = Элементы.ТоварыДерево.ТекущиеДанные.Номенклатура;
	КонецЕсли;
	
	Модифицированность = Истина;
	ПеренестиДеревоВТабличнуюЧасть();
	ТоварыДеревоИтоговыеПоказателиКлиент();
	
	ОбновитьДанныеДокумента();
	РазвернутьДеревоТоваров(ТекПотолок, ТекНоменклатура);
	
	ПерезаполнитьНомераПотолковПоДереву();

	НомерСтроки = 1;
	Для каждого СтрокаПродукции из ТоварыДерево.ПолучитьЭлементы() Цикл
		СтрокаПродукции.НомерСтроки = НомерСтроки;
		НомерСтроки = НомерСтроки + 1;
		Для каждого СтрокаНоменклатуры из СтрокаПродукции.ПолучитьЭлементы() Цикл
			СтрокаНоменклатуры.НомерСтроки = НомерСтроки;
			НомерСтроки = НомерСтроки + 1;	
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

