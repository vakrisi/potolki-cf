Процедура КонтрагентПриИзмененииКлиент()
	
	Если НЕ ЗначениеЗаполнено(Объект.Контрагент) Тогда
		ОбщийМодульКлиентСервер.ОчиститьРеквизитыДоставки(Элементы, Объект);
	КонецЕсли;
	
	КонтрагентПриИзмененииСервер();
	ДоговорПриИзмененииКлиент();	
	//ПредыдущийВидЦены = Объект.ВидЦен;
	//УстановитьВидЦенНаОснованииДоговора();
	//Если НЕ ПредыдущийВидЦены = Объект.ВидЦен Тогда
	//	ЗадатьВопросОПересчетеЦен();
	//КонецЕсли;
	//ОбновитьДанныеДокумента();
	Если ИспользоватьБонусы Тогда
		ПересчитатьБонусыПоДокументу(); // №13299
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура КонтрагентПриИзмененииСервер()
	
	Объект.ДоговорКонтрагента = Объект.Контрагент.ОсновнойДоговор;
	Если ТребуетсяЗаполнениеЦен() Тогда
		ВидСкидки = Объект.Контрагент.Категория.ВидСкидки;
		ВидСкидкиИзменился = (Объект.ВидСкидки = ВидСкидки);
		Объект.ВидСкидки = ВидСкидки;
		Если ВидСкидкиИзменился Тогда
			УстановитьСкидкуНаСервере(Объект.ВидСкидки.Процент);	
		КонецЕсли;	
	КонецЕсли;
	
	УстановитьВидимостьРеквизитовДляИнтернетОплаты();
	
	ОбновитьВидимостьИОстаткиВзаиморасчетов();
	
	ОбщийМодульСервер.ДополнительнаяИнформацияПоКонтрагентуНаФорме(Объект.Контрагент, Элементы.ПоказатьДополнительнуюИнформацию);
	ОбщийМодульСервер.ЕстьИндивидуальныеЦеныКонтрагентаНаФорме(Объект.Дата, Объект.Контрагент, Объект.ДоговорКонтрагента, Элементы.ЕстьИндивидуальныеЦены);
	ОбщийМодульСервер.РегулировкаШириныПоляКонтрагента(Элементы, Элементы.Контрагент, Элементы.ПоказатьДополнительнуюИнформацию, Элементы.ЕстьИндивидуальныеЦены);
	
	Если ИспользоватьБонусы Тогда
		БонусыСервер.ОпределитьОстатокПоДисконтнойКарте(ЭтаФорма); // №13299
	КонецЕсли;
	
	ОбщийМодульСервер.ЗаполнитьРеквизитыДоставки(Элементы, Объект);
	
	//#13359
	UDS_ОбщийМодульСервер.ЗаполнитьРеквизитыДокумента(Объект);
	
КонецПроцедуры

