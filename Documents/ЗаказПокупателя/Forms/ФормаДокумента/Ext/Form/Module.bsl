&НаСервере
Процедура РасчитатьИтоговыеПоказателиМаржиСервер()
	
	РеквизитыПользователя = ОбщийМодульСервер.НастройкиПользователя("РасчитыватьИтоговыеПоказателиМаржи");
	Если НЕ РеквизитыПользователя.РасчитыватьИтоговыеПоказателиМаржи Тогда
		Возврат;
	КонецЕсли;	
	
	СуммаКомплектующих = 0;
	СебестоимостьКомплектующих = 0;
	НаценкаКомплектующих = 0;
	МаржаКомплектующих = 0;
	
	ТаблицаНоменклатуры = Новый ТаблицаЗначений;
	ТаблицаНоменклатуры.Колонки.Добавить("Номенклатура",
		Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ТаблицаНоменклатуры.Колонки.Добавить("ХарактеристикаНоменклатуры",
		Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры"));
	
	Для каждого СтрокаТабличнойЧасти из Объект.Товары Цикл
		Если СтрокаТабличнойЧасти.Номенклатура.ВидНоменклатуры <> Справочники.ВидыНоменклатуры.Материал
			И СтрокаТабличнойЧасти.Номенклатура.ВидНоменклатуры <> Справочники.ВидыНоменклатуры.Полотно Тогда
			СтрокаТабличнойЧасти.Маржа = 0;
			Продолжить;
		КонецЕсли;
		НоваяСтрока = ТаблицаНоменклатуры.Добавить();
		НоваяСтрока.Номенклатура = СтрокаТабличнойЧасти.Номенклатура;
		НоваяСтрока.ХарактеристикаНоменклатуры = СтрокаТабличнойЧасти.ХарактеристикаНоменклатуры;
	КонецЦикла;
	
	СебестоимостиПоНоменклатуре = ПолучитьСебестоимостиПоНоменклатуре(ТаблицаНоменклатуры, Объект.Организация);
	
	Для каждого СтрокаТабличнойЧасти из Объект.Товары Цикл
		Если СтрокаТабличнойЧасти.Номенклатура.ВидНоменклатуры <> Справочники.ВидыНоменклатуры.Материал
			И СтрокаТабличнойЧасти.Номенклатура.ВидНоменклатуры <> Справочники.ВидыНоменклатуры.Полотно Тогда
			Продолжить;
		КонецЕсли;
		Если СтрокаТабличнойЧасти.Сумма = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		ПоХарактеристике = СебестоимостиПоНоменклатуре[СтрокаТабличнойЧасти.Номенклатура];
		Себестоимость = 0;
		Если ПоХарактеристике <> Неопределено Тогда
			ЗначСебестоимости = ПоХарактеристике[СтрокаТабличнойЧасти.ХарактеристикаНоменклатуры];
			Если ЗначСебестоимости <> Неопределено Тогда
				Себестоимость = ЗначСебестоимости;
			КонецЕсли;
		КонецЕсли;
		
		СтрокаТабличнойЧасти.Маржа = (СтрокаТабличнойЧасти.Сумма - СтрокаТабличнойЧасти.Количество * СтрокаТабличнойЧасти.Коэффициент * Себестоимость) / СтрокаТабличнойЧасти.Сумма * 100;
		СуммаКомплектующих = СуммаКомплектующих + СтрокаТабличнойЧасти.Сумма;
		СебестоимостьКомплектующих = СебестоимостьКомплектующих + СтрокаТабличнойЧасти.Количество * СтрокаТабличнойЧасти.Коэффициент * Себестоимость;
	КонецЦикла;
	
	НаценкаКомплектующих = СуммаКомплектующих - СебестоимостьКомплектующих;
	Если СуммаКомплектующих = 0 Тогда
		МаржаКомплектующих = 0;
	Иначе
		МаржаКомплектующих = (СуммаКомплектующих - СебестоимостьКомплектующих) / СуммаКомплектующих * 100;
	КонецЕсли;
	
КонецПроцедуры

// Возвращает соответствие: Номенклатура -> (Характеристика -> Себестоимость)
// Для каждой пары берётся себестоимость из последнего документа с приоритетом:
// реализация > поступление > оприходование > ввод остатков
Функция ПолучитьСебестоимостиПоНоменклатуре(ТаблицаНоменклатуры, Организация)
	
	Результат = Новый Соответствие;
	Если ТаблицаНоменклатуры.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = ЗапросДляРасчетаМаржиПоНоменклатуре();
	Запрос.УстановитьПараметр("ТаблицаНоменклатуры", ТаблицаНоменклатуры);
	Запрос.УстановитьПараметр("Организация", Организация);
	
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Номенклатура  = ВыборкаДетальныеЗаписи.Номенклатура;
		Характеристика = ВыборкаДетальныеЗаписи.ХарактеристикаНоменклатуры;
		
		ПоХарактеристике = Результат[Номенклатура];
		Если ПоХарактеристике = Неопределено Тогда
			ПоХарактеристике = Новый Соответствие;
			Результат[Номенклатура] = ПоХарактеристике;
		КонецЕсли;
		
		// Запрос упорядочен по Порядку, берём первую запись (наивысший приоритет)
		Если ПоХарактеристике[Характеристика] = Неопределено Тогда
			ПоХарактеристике[Характеристика] = ВыборкаДетальныеЗаписи.Себестоимость;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ЗапросДляРасчетаМаржиПоНоменклатуре()
	ТекстЗапроса =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТаблицаНоменклатуры.Номенклатура КАК Номенклатура,
	|	ТаблицаНоменклатуры.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры
	|ПОМЕСТИТЬ ВТ_Номенклатуры
	|ИЗ
	|	&ТаблицаНоменклатуры КАК ТаблицаНоменклатуры
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Товары.Номенклатура КАК Номенклатура,
	|	Товары.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	|	МАКСИМУМ(Товары.Ссылка.Дата) КАК МаксДата
	|ПОМЕСТИТЬ ВТ_МаксДатаРеализаций
	|ИЗ
	|	Документ.РеализацияТоваровИУслуг.Товары КАК Товары
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_Номенклатуры КАК ВТ_Номенклатуры
	|		ПО Товары.Номенклатура = ВТ_Номенклатуры.Номенклатура
	|			И Товары.ХарактеристикаНоменклатуры = ВТ_Номенклатуры.ХарактеристикаНоменклатуры
	|ГДЕ
	|	Товары.Ссылка.Организация = &Организация
	|
	|СГРУППИРОВАТЬ ПО
	|	Товары.Номенклатура,
	|	Товары.ХарактеристикаНоменклатуры
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	0 КАК Порядок,
	|	ТоварыНаСкладахОбороты.Период КАК Период,
	|	ТоварыНаСкладахОбороты.Регистратор КАК Регистратор,
	|	ТоварыНаСкладахОбороты.Номенклатура КАК Номенклатура,
	|	ТоварыНаСкладахОбороты.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	|	ТоварыНаСкладахОбороты.КоличествоРасход КАК КоличествоРасход,
	|	ТоварыНаСкладахОбороты.СуммаРасход КАК СуммаРасход,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(ТоварыНаСкладахОбороты.КоличествоРасход, 0) = 0
	|			ТОГДА 0
	|		ИНАЧЕ ЕСТЬNULL(ТоварыНаСкладахОбороты.СуммаРасход, 0) / ЕСТЬNULL(ТоварыНаСкладахОбороты.КоличествоРасход, 0)
	|	КОНЕЦ КАК Себестоимость
	|ПОМЕСТИТЬ ВТ_Реализации
	|ИЗ
	|	Документ.РеализацияТоваровИУслуг.Товары КАК Товары
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_МаксДатаРеализаций КАК ВТ_МаксДата
	|		ПО Товары.Номенклатура = ВТ_МаксДата.Номенклатура
	|			И Товары.ХарактеристикаНоменклатуры = ВТ_МаксДата.ХарактеристикаНоменклатуры
