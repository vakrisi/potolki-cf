Процедура ЗаполнитьДокументСнятиеРезервовНаСервере(ДанныеФормы, ЗаказСсылка)
	
	НовыйДокумент = Документы.СнятиеРезервов.СоздатьДокумент();
	НовыйДокумент.Дата = ТекущаяДата();   
	НовыйДокумент.Заполнить(ЗаказСсылка);
	
	ЗначениеВДанныеФормы(НовыйДокумент, ДанныеФормы); 
	
