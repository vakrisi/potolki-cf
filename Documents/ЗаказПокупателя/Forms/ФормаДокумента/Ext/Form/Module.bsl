	Если ТоварыКакДерево Тогда
		ЭлементТовары = Элементы.ТоварыДерево;
	Иначе		
		ЭлементТовары = Элементы.Товары;
	КонецЕсли;
	
	ТекущиеДанные = ЭлементТовары.ТекущиеДанные;

	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТоварыКакДерево Тогда
