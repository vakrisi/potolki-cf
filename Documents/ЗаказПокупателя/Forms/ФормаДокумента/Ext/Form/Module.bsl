//++ №14311
&НаСервереБезКонтекста
Функция ПолучитьМассивДокументовРазличийСЗаказамиНаПроизводство(ЗаказСсылка)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("СсылкаЗаказПокупателя", ЗаказСсылка);
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	ДокументЗаказНаПроизводство.Ссылка КАК ЗаказНаПроизводство,
	|	ДокументЗаказНаПроизводство.ВидЗаказа КАК ВидЗаказа,
	|	ДокументЗаказНаПроизводство.ПродукцияНоменклатура КАК ПродукцияНоменклатура,
	|	ДокументЗаказНаПроизводство.ПродукцияУИСтроки КАК ПродукцияУИСтроки,
	|	ДокументЗаказНаПроизводство.ДокументОснование КАК ЗаказПокупателя
	|ИЗ
	|	Документ.ЗаказНаПроизводство КАК ДокументЗаказНаПроизводство
	
	//#14923 по тем ЗНП, которые указаны в ТЧ "Товары и услуги" в ЗП
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаказПокупателя.Товары КАК ТоварыЗП
	|		ПО (ТоварыЗП.Ссылка = &СсылкаЗаказПокупателя)
	|			И (ТоварыЗП.ЗаказНаПроизводство = ДокументЗаказНаПроизводство.Ссылка)
	
	|ГДЕ
	|	ДокументЗаказНаПроизводство.Проведен
	|	И ДокументЗаказНаПроизводство.ДокументОснование = &СсылкаЗаказПокупателя
	|	И НЕ ДокументЗаказНаПроизводство.ТекущийСтатус = ЗНАЧЕНИЕ(Справочник.СтатусыЗаказовНаПроизводство.Отменен)";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	МассивДокументов = новый Массив;
	
	Пока Выборка.Следующий() Цикл
		
		СтруктураПроверки = ОбщийМодуль.ЗаказНаПроизводствоСоответствуетЗаказуПокупателя(Выборка.ЗаказНаПроизводство, Выборка.ЗаказПокупателя);
		
		Если НЕ СтруктураПроверки.Результат
			И (НЕ СтруктураПроверки.ЕстьВыпуск ИЛИ СтруктураПроверки.ДоступноИзменениеПриНаличииВыпуска) Тогда
			
			СтруктураДокументов = новый Структура;
			СтруктураДокументов.Вставить("ВидЗаказа", 							Выборка.ВидЗаказа);
			СтруктураДокументов.Вставить("ЗаказНаПроизводство", 				Выборка.ЗаказНаПроизводство);
			СтруктураДокументов.Вставить("ПродукцияНоменклатура", 				Выборка.ПродукцияНоменклатура);
			СтруктураДокументов.Вставить("ЗаказПокупателя", 					Выборка.ЗаказПокупателя);
			СтруктураДокументов.Вставить("ПродукцияУИСтроки", 					Выборка.ПродукцияУИСтроки);
			СтруктураДокументов.Вставить("ДоступноИзменениеПриНаличииВыпуска", 	СтруктураПроверки.ДоступноИзменениеПриНаличииВыпуска);
			СтруктураДокументов.Вставить("МассивСравнения", 					СтруктураПроверки.МассивСравнения);
			СтруктураДокументов.Вставить("МассивРазличийРеквизитов", 			СтруктураПроверки.МассивРазличийРеквизитов);
			
			МассивДокументов.Добавить(СтруктураДокументов);
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат МассивДокументов;
	
КонецФункции
