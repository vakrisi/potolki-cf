	Запрос.УстановитьПараметр("Организация",				Объект.Организация);
	Запрос.УстановитьПараметр("Склад",						Объект.Склад);
	Запрос.УстановитьПараметр("Ссылка",						Объект.Ссылка);
	Запрос.УстановитьПараметр("ИспользоватьРезервирование", ИспользоватьРезервирование);
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	
	Если НЕ ТоварыКакДерево Тогда
		Для Каждого ТекущаяСтрока Из Объект.Товары Цикл			
			ЗаполнитьВСтрокеОстаткиИКОтгрузке(РезультатЗапроса, ТекущаяСтрока);			
		КонецЦикла;
	
	Иначе

		Для Каждого СтрокаПотолок Из Дерево.Строки Цикл			
			ЗаполнитьВСтрокеОстаткиИКОтгрузке(РезультатЗапроса, СтрокаПотолок);			
			Для Каждого СтрокаНоменклатура Из СтрокаПотолок.Строки Цикл				
				ЗаполнитьВСтрокеОстаткиИКОтгрузке(РезультатЗапроса, СтрокаНоменклатура);				
			КонецЦикла;			
		КонецЦикла;
		
		ЗначениеВДанныеФормы(Дерево, ТоварыДерево);
		
	КонецЕсли;	

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьВСтрокеОстаткиИКОтгрузке(РезультатЗапроса, ТекущаяСтрока)
		
	Отбор = Новый Структура;
	Отбор.Вставить("Номенклатура", ТекущаяСтрока.Номенклатура);
	Отбор.Вставить("ХарактеристикаНоменклатуры", ТекущаяСтрока.ХарактеристикаНоменклатуры);
	Отбор.Вставить("СерияНоменклатуры", ТекущаяСтрока.СерияНоменклатуры);
	
	Остаток = 0;
	ДоступноНаСкладе = 0;
	ВРезерве = 0;
	КОтгрузке = 0;
	Отгружено = 0;
	ВРезервеПодДанныйЗаказ = 0;
	ДоступноКОтгрузке = 0;
	
	НайденныеСтроки = РезультатЗапроса.НайтиСтроки(Отбор);
	Если НайденныеСтроки.Количество() > 0 Тогда
		Если ТекущаяСтрока.Коэффициент > 1 Тогда			
			ОтгруженоБЕ = Мин(НайденныеСтроки[0].ОтгруженоВБазовыхЕдиницах, ТекущаяСтрока.Количество * ТекущаяСтрока.Коэффициент);
			КОтгрузкеБЕ = Макс(0, ТекущаяСтрока.Количество * ТекущаяСтрока.Коэффициент - ОтгруженоБЕ);
			
			Отгружено = Мин(НайденныеСтроки[0].ОтгруженоВБазовыхЕдиницах / ТекущаяСтрока.Коэффициент, ТекущаяСтрока.Количество);
			КОтгрузке = Макс(0, ТекущаяСтрока.Количество - Отгружено);
			
			Остаток = НайденныеСтроки[0].ОстатокВБазовыхЕдиницах / ТекущаяСтрока.Коэффициент;
			ДоступноНаСкладе = НайденныеСтроки[0].ДоступноНаСкладеВБазовыхЕдиницах / ТекущаяСтрока.Коэффициент;
			ВРезерве = НайденныеСтроки[0].ВРезервеВБазовыхЕдиницах / ТекущаяСтрока.Коэффициент;
			
			//ВРезервеПодДанныйЗаказ = НайденныеСтроки[0].ВРезервеПодДанныйЗаказВБазовыхЕдиницах / ТекущаяСтрока.Коэффициент;
			ВРезервеПодДанныйЗаказБЕ = Мин(НайденныеСтроки[0].ВРезервеПодДанныйЗаказВБазовыхЕдиницах, КОтгрузкеБЕ);
			ВРезервеПодДанныйЗаказ = Мин(НайденныеСтроки[0].ВРезервеПодДанныйЗаказВБазовыхЕдиницах / ТекущаяСтрока.Коэффициент, КОтгрузке);
			
			ДоступноКОтгрузке = Мин(КОтгрузке, НайденныеСтроки[0].ДоступноВБазовыхЕдиницах / ТекущаяСтрока.Коэффициент);
			ДоступноКОтгрузке = Макс(0, ДоступноКОтгрузке);
			
			// уменьшаем остаток для строк
			НайденныеСтроки[0].ОтгруженоВБазовыхЕдиницах = НайденныеСтроки[0].ОтгруженоВБазовыхЕдиницах - ОтгруженоБЕ;
			НайденныеСтроки[0].ДоступноВБазовыхЕдиницах = НайденныеСтроки[0].ДоступноВБазовыхЕдиницах - КОтгрузкеБЕ;
			НайденныеСтроки[0].ДоступноВБазовыхЕдиницах = Макс(0, НайденныеСтроки[0].ДоступноВБазовыхЕдиницах);
			НайденныеСтроки[0].ВРезервеПодДанныйЗаказВБазовыхЕдиницах = НайденныеСтроки[0].ВРезервеПодДанныйЗаказВБазовыхЕдиницах - ВРезервеПодДанныйЗаказБЕ;
		Иначе
			// данные в базовой единице
			Отгружено = Мин(НайденныеСтроки[0].ОтгруженоВБазовыхЕдиницах, ТекущаяСтрока.Количество);
			КОтгрузке = Макс(0, ТекущаяСтрока.Количество - Отгружено);
			
			Остаток = НайденныеСтроки[0].ОстатокВБазовыхЕдиницах;
			ДоступноНаСкладе = НайденныеСтроки[0].ДоступноНаСкладеВБазовыхЕдиницах;
			ВРезерве = НайденныеСтроки[0].ВРезервеВБазовыхЕдиницах;
			
			//ВРезервеПодДанныйЗаказ = НайденныеСтроки[0].ВРезервеПодДанныйЗаказВБазовыхЕдиницах;
			ВРезервеПодДанныйЗаказ = Мин(НайденныеСтроки[0].ВРезервеПодДанныйЗаказВБазовыхЕдиницах, КОтгрузке);
			
			ДоступноКОтгрузке = Мин(КОтгрузке, НайденныеСтроки[0].ДоступноВБазовыхЕдиницах);
			ДоступноКОтгрузке = Макс(0, ДоступноКОтгрузке);
			
			// уменьшаем остаток для строк
			НайденныеСтроки[0].ОтгруженоВБазовыхЕдиницах = НайденныеСтроки[0].ОтгруженоВБазовыхЕдиницах - Отгружено;
			НайденныеСтроки[0].ДоступноВБазовыхЕдиницах = НайденныеСтроки[0].ДоступноВБазовыхЕдиницах - КОтгрузке;
			НайденныеСтроки[0].ДоступноВБазовыхЕдиницах = Макс(0, НайденныеСтроки[0].ДоступноВБазовыхЕдиницах);
			НайденныеСтроки[0].ВРезервеПодДанныйЗаказВБазовыхЕдиницах = НайденныеСтроки[0].ВРезервеПодДанныйЗаказВБазовыхЕдиницах - ВРезервеПодДанныйЗаказ;
		КонецЕсли;			
		
	КонецЕсли;
	
	ТекущаяСтрока.ОстатокНаСкладе = Остаток;
	ТекущаяСтрока.ДоступноНаСкладе = ДоступноНаСкладе;
	ТекущаяСтрока.ВРезерве = ВРезерве;
	ТекущаяСтрока.ВРезервеПодДанныйЗаказ = ВРезервеПодДанныйЗаказ;
	ТекущаяСтрока.ДоступноКОтгрузке = ДоступноКОтгрузке;
	ТекущаяСтрока.КОтгрузке = КОтгрузке;		
	
	ЗаполнитьСтатусИКоличествоЗаказаНаПроизводство(ТекущаяСтрока);
		
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСтатусыПроизводстваПоТоварам()
		
	Если НЕ ТоварыКакДерево Тогда
		Для Каждого ТекущаяСтрока Из Объект.Товары Цикл			
			ЗаполнитьСтатусИКоличествоЗаказаНаПроизводство(ТекущаяСтрока);			
		КонецЦикла;
	
	Иначе

		Дерево = ДанныеФормыВЗначение(ТоварыДерево, Тип("ДеревоЗначений"));
		
		Для Каждого СтрокаПотолок Из Дерево.Строки Цикл			
			ЗаполнитьСтатусИКоличествоЗаказаНаПроизводство(СтрокаПотолок);		
			Для Каждого СтрокаНоменклатура Из СтрокаПотолок.Строки Цикл				
				ЗаполнитьСтатусИКоличествоЗаказаНаПроизводство(СтрокаНоменклатура);				
			КонецЦикла;			
		КонецЦикла;
		
		ЗначениеВДанныеФормы(Дерево, ТоварыДерево);
		
	КонецЕсли;	
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСтатусИКоличествоЗаказаНаПроизводство(ТекущаяСтрока)
		
	ЗаказНаПроизводство = ТекущаяСтрока.ЗаказНаПроизводство;
	РеквизитыЗНП = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ЗаказНаПроизводство, "Ссылка, Проведен, ТекущийСтатус, ВидЗаказа, ПродукцияНоменклатураКоличество");
	
	//Если указан Заказ на производство вернем статус	
	Если ЗначениеЗаполнено(РеквизитыЗНП.Ссылка) И РеквизитыЗНП.Проведен Тогда	
		
		ТекущаяСтрока.СтатусПроизводства = РеквизитыЗНП.ТекущийСтатус;
		
		//Если Потолок то количество Продукции
		//Если Типовое, нужно найти в ТЧ Продукция
		Если РеквизитыЗНП.ВидЗаказа = Перечисления.ВидыЗаказовНаПроизводство.ПроизводствоПотолка Тогда
			//#14934 закомментировано
			//ТекущаяСтрока.КоличествоЗаказанноеВПроизводство = РеквизитыЗНП.ПродукцияНоменклатураКоличество;
		ИначеЕсли РеквизитыЗНП.ВидЗаказа = Перечисления.ВидыЗаказовНаПроизводство.ТиповоеПроизводство Тогда
			
			НайденнаяПродукция = ЗаказНаПроизводство.Продукция.НайтиСтроки(новый Структура("Номенклатура", ТекущаяСтрока.Номенклатура));
			
			//#14934 закомментировано
			//Если НайденнаяПродукция.Количество() > 0 Тогда
			//	ТекущаяСтрока.КоличествоЗаказанноеВПроизводство = НайденнаяПродукция[0].Количество;
			//КонецЕсли;
			
		КонецЕсли;	
		
	//Также статус нужно указывать у услуг привязанных к потолку
	ИначеЕсли ЭтоУслугаСервер(ТекущаяСтрока.Номенклатура) И НЕ ТекущаяСтрока.Потолок.Пустая() Тогда	
		
		//Найдём потолок в табличной части
		НайденныйПотолок = Объект.Товары.НайтиСтроки(новый Структура("Номенклатура", ТекущаяСтрока.Потолок));
		Если НайденныйПотолок.Количество() > 0 Тогда
			
			ЗаказНаПроизводство = НайденныйПотолок[0].ЗаказНаПроизводство;
			РеквизитыЗНП = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ЗаказНаПроизводство, "Проведен, ТекущийСтатус");
			
			Если НЕ ЗаказНаПроизводство.Пустая() И РеквизитыЗНП.Проведен Тогда
				
				НайденнаяУслуга = ЗаказНаПроизводство.Услуги.НайтиСтроки(новый Структура("Номенклатура", ТекущаяСтрока.Номенклатура)); 
				//Нужно проверить наличие услуги в данном ЗнП
				Если НайденнаяУслуга.Количество() > 0 Тогда
				
					ТекущаяСтрока.СтатусПроизводства = РеквизитыЗНП.ТекущийСтатус;
					//#14934 закомментировано
					//ТекущаяСтрока.КоличествоЗаказанноеВПроизводство = НайденнаяУслуга[0].Количество;
					
				КонецЕсли;
				
			КонецЕсли;
		КонецЕсли;
	
	КонецЕсли;
	
КонецПроцедуры	

&НаСервереБезКонтекста
Функция ЕстьДокументВыпускаПоПродукции(Знач Номенклатура, Знач ХарактеристикаНоменклатуры = Неопределено)
	
	Если ХарактеристикаНоменклатуры = Неопределено Тогда
		ХарактеристикаНоменклатуры = Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка();
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВыпускПотолков.Номенклатура КАК Номенклатура,
	|	ЕСТЬNULL(ВыпускПотолков.КоличествоПриход, 0) КАК ВыпускПродукции
	|ИЗ
	|	РегистрНакопления.ТоварыНаСкладах.Обороты(
	|			,
	|			,
	|			Регистратор,
	|			Номенклатура = &Номенклатура
	|				И ХарактеристикаНоменклатуры = &ХарактеристикаНоменклатуры) КАК ВыпускПотолков
	|ГДЕ
	|	ВыпускПотолков.Регистратор ССЫЛКА Документ.ВыпускПродукции"; 
	Запрос.УстановитьПараметр("Номенклатура",				Номенклатура);
	Запрос.УстановитьПараметр("ХарактеристикаНоменклатуры",	ХарактеристикаНоменклатуры);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.ВыпускПродукции > 0;		
	КонецЕсли;
	
	Возврат Ложь;

КонецФункции

