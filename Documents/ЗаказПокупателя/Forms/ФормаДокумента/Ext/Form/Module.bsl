					ТекстВопроса = "По " + ТекущиеДанные.Потолок + " имеется " + ЗаказНаПроизводство + ". Продолжить?";
					ЗадатьВопросПередИзменениемСтроки(Отказ, Элемент, ТекстВопроса);
				КонецЕсли;					
				
			КонецЕсли;
		КонецЕсли;
	Иначе
		//независимая строка
		Если ЗначениеЗаполнено(ЗаказНаПроизводство) Тогда
			Если ЭтоУникальнаяПродукцияКлиент(ТекущиеДанные.ВидНоменклатуры) Тогда			
				Если ТекущийСтатусЗаказаНаПроизводствоПроизведен(ТекущиеДанные.ЗаказНаПроизводство) Тогда
					Если ЗапрещенноеДляРедактированияИмяКолонки(ЭлементТовары.ТекущийЭлемент.Имя) Тогда
						Отказ = Истина;
						Возврат;
					КонецЕсли;
					
					ТекстВопроса = "По " + ТекущиеДанные.Номенклатура + " указан " + ТекущиеДанные.ЗаказНаПроизводство + ", который находится в статусе ""Произведен"". Продолжить?";
					ЗадатьВопросПередИзменениемСтроки(Отказ, Элемент, ТекстВопроса);
					
				Иначе					
					//Если НЕ ТекущиеДанные.ЗаказНаПроизводство.Пустая() Тогда
					ТекстВопроса = "По " + ТекущиеДанные.Номенклатура + " имеется " + ТекущиеДанные.ЗаказНаПроизводство + ". Продолжить?";
					ЗадатьВопросПередИзменениемСтроки(Отказ, Элемент, ТекстВопроса);
					//КонецЕсли;					
				КонецЕсли;
			Иначе //Если НЕ ТекущиеДанные.ЗаказНаПроизводство.Пустая()	Тогда
			
				Если ТекущийСтатусЗаказаНаПроизводствоПроизведен(ТекущиеДанные.ЗаказНаПроизводство) Тогда
					Если ЗапрещенноеДляРедактированияИмяКолонки(ЭлементТовары.ТекущийЭлемент.Имя) Тогда
						Отказ = Истина;
						Возврат;
					КонецЕсли;
				
					ТекстВопроса = "По " + ТекущиеДанные.Номенклатура + " указан " + ТекущиеДанные.ЗаказНаПроизводство + ", который находится в статусе ""Произведен"". Продолжить?";
					ЗадатьВопросПередИзменениемСтроки(Отказ, Элемент, ТекстВопроса);			
				Иначе
					ТекстВопроса = "По " + ТекущиеДанные.Номенклатура + " имеется " + ТекущиеДанные.ЗаказНаПроизводство + " в производстве, Продолжить?";
					ЗадатьВопросПередИзменениемСтроки(Отказ, Элемент, ТекстВопроса);
				КонецЕсли;
			КонецЕсли;	
		КонецЕсли;
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура ТоварыПередУдалением(Элемент, Отказ)
	
	ОчиститьСообщения();
	
	ИмяЭлемента = "Товары";
	КоллекцияТоваров = Объект.Товары;
	Если ТоварыКакДерево Тогда
		ИмяЭлемента = "ТоварыДерево";
		КоллекцияТоваров = ТоварыДерево;
	КонецЕсли;
		
	Для Каждого ВыделеннаяСтрока Из Элементы[ИмяЭлемента].ВыделенныеСтроки Цикл
		
		ТекущиеДанные = КоллекцияТоваров.НайтиПоИдентификатору(ВыделеннаяСтрока);
		
		//++ №13255 выделенная строка могла быть удалена как подчиненная потолку
		Если ТекущиеДанные = Неопределено Тогда
			Возврат;
		КонецЕсли;
		//-- №13255
		
		Если ТоварыКакДерево Тогда
			Если ТекущиеДанные.ПолучитьЭлементы().Количество() > 0 Тогда
				//не даем удалить строку с потолком, иначе нижние проверки не сработают
				Отказ = Истина;
				Возврат;
			КонецЕсли;
		КонецЕсли;	
		
		Если ЭтоУникальнаяПродукцияКлиент(ТекущиеДанные.ВидНоменклатуры) Тогда
			//ПродукцияВозвращенаПолностью   = ПродукцияВозвращенаПолностью(ТекущиеДанные.Номенклатура, ТекущиеДанные.ХарактеристикаНоменклатуры, Объект.Ссылка);
			//ЕстьДокументВыпускаПоПродукции = ЕстьДокументВыпускаПоПродукции(ТекущиеДанные.Номенклатура, ТекущиеДанные.ХарактеристикаНоменклатуры);
			ЕстьПриходНаСкладПоПродукции = ЕстьПриходНаСкладПоПродукции(ТекущиеДанные.Номенклатура, ТекущиеДанные.ХарактеристикаНоменклатуры);
			ЕстьЗНПВСтатусеНеОтменен = ЕстьДокументЗНПВСтатусеНеОтменен(ТекущиеДанные.ЗаказНаПроизводство);
			
			//при попытке удалить строку потолка
			// №8749 если у потолка нет подчиненных строк, при этом есть заказ на производство, есть выпуск продукции, есть реализация потолка и есть возврат продукции этого потолка в статусе "Проверено"
			//Если ЕстьДокументВыпускаПоПродукции Тогда
			Если ЕстьПриходНаСкладПоПродукции Тогда
				Если НЕ РазрешеноУдалятьОприходованнуюПродукцию Тогда //#15206
					
				// #15206 проверка на возвращенность продукции пока закомментирована
				//Если ПродукцияВозвращенаПолностью // Был возвращен, значит и отгрузка была
				//	И ОтсутствуютПодчиненныеСтрокиПоПотолку(ТекущиеДанные.Номенклатура, ТекущиеДанные.УИСтроки)
				//	Тогда
				//	// Не отказываем
				//	
				//Иначе
					ПоказатьПредупреждение(,"По " + ТекущиеДанные.Номенклатура + " имеется выпуск продукции: удаление строки невозможно.");				
					Отказ = Истина;
					Возврат;
				КонецЕсли;
				
			ИначеЕсли ЕстьЗНПВСтатусеНеОтменен Тогда
				//если не было выпуска но есть заказ на производство, то просим сначала перевести заказ на производство в статус "Отменен", чтобы потолок не выпустили
				
				//ПоказатьПредупреждение(,"По " + ТекущиеДанные.Номенклатура + " имеется Заказ на производство в производстве. Предварительно переведите его в статус ""Отменен""");
				ТекстВопроса = "По продукции " + ТекущиеДанные.Номенклатура + " имеется Заказ на производство в производстве. Перевести его в статус ""Отменен"" и УДАЛИТЬ СТРОКУ?";
				
				ДополнительныеПараметры = Новый Структура;
				ДополнительныеПараметры.Вставить("ТабличнаяЧасть", "Товары");
				ДополнительныеПараметры.Вставить("Номенклатура", ТекущиеДанные.Номенклатура);
				ДополнительныеПараметры.Вставить("ЗаказНаПроизводство", ТекущиеДанные.ЗаказНаПроизводство);
				ДополнительныеПараметры.Вставить("УИСтроки", ТекущиеДанные.УИСтроки);
				ДополнительныеПараметры.Вставить("ИдентификаторСтроки", ВыделеннаяСтрока);				
				   
				ОписаниеОповещения = Новый ОписаниеОповещения("ОбработкаВопросаОбОтменеЗНП", ЭтотОбъект, ДополнительныеПараметры);
				ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
				
				Отказ = Истина;
				Возврат;
				
			КонецЕсли;
			
			//при попытке удалить строку, подчиненную продукции
		ИначеЕсли НЕ ПустаяСтрока(ТекущиеДанные.УИСтрокиРодителя) 
			И НЕ ТекущиеДанные.УИСтрокиРодителя = ТекущиеДанные.УИСтроки Тогда
			
			СтрокаПродукции = НайтиСтрокуПродукцииПоУИС(ТекущиеДанные.УИСтрокиРодителя);
			Если НЕ СтрокаПродукции = Неопределено Тогда
				ЕстьДокументВыпускаПоПродукции = ЕстьДокументВыпускаПоПродукции(СтрокаПродукции.Номенклатура, СтрокаПродукции.ХарактеристикаНоменклатуры);	
				Если ЕстьДокументВыпускаПоПродукции Тогда
					
					// №6277, если это НЕ: услуга - удаление разрешаем
					Если ЭтоУслугаКлиент(ТекущиеДанные.ВидНоменклатуры) Тогда
						ПоказатьПредупреждение(,"По " + ТекущиеДанные.Номенклатура + " имеется выпуск продукции: удаление услуги невозможно.");
						Отказ = Истина;
						Возврат;	
					КонецЕсли;
					
				Иначе
					// не было выпуска (ничего не делаем). При открытии формы Заказа на производство или при попытке оформить выпуск, 
					// он будет проверен на соответствие заказ покупателя и перезаполнен
				КонецЕсли;
			КонецЕсли;
		Иначе
			//при попытке удалить строку товара (не подчинен продукции), если по строке есть заказ на производство
			Если ЗначениеЗаполнено(ТекущиеДанные.ЗаказНаПроизводство) Тогда
				ЕстьДокументВыпускаПоПродукции = ЕстьДокументВыпускаПоПродукцииПоЗНП(ТекущиеДанные.ЗаказНаПроизводство);
				ЕстьЗНПВСтатусеНеОтменен = ЕстьДокументЗНПВСтатусеНеОтменен(ТекущиеДанные.ЗаказНаПроизводство);
				
				Если ЕстьДокументВыпускаПоПродукции Тогда
					ПоказатьПредупреждение(,"По " + ТекущиеДанные.ЗаказНаПроизводство + " имеется выпуск продукции: удаление строки невозможно.");
					Отказ = Истина;
					Возврат;
					
				ИначеЕсли ЕстьЗНПВСтатусеНеОтменен Тогда
					//если выпуска не было, но заказ на производство в статусе "ВПроизводстве", просим отменить заказ на производство
					//ПоказатьПредупреждение(,"По " + ТекущиеДанные.Номенклатура + " имеется Заказ на производство в производстве. Предварительно переведите его в статус ""Отменен""");
					
					ТекстВопроса = "По " + ТекущиеДанные.Номенклатура + " имеется Заказ на производство в производстве. Перевести его в статус ""Отменен"" и УДАЛИТЬ СТРОКУ?";
					
					ДополнительныеПараметры = Новый Структура;
					ДополнительныеПараметры.Вставить("ТабличнаяЧасть", "Товары");
					ДополнительныеПараметры.Вставить("Номенклатура", ТекущиеДанные.Номенклатура);
					ДополнительныеПараметры.Вставить("ЗаказНаПроизводство", ТекущиеДанные.ЗаказНаПроизводство);
					ДополнительныеПараметры.Вставить("УИСтроки", ТекущиеДанные.УИСтроки);
					ДополнительныеПараметры.Вставить("ИдентификаторСтроки", ВыделеннаяСтрока);				
					
					ОписаниеОповещения = Новый ОписаниеОповещения("ОбработкаВопросаОбОтменеЗНП", ЭтотОбъект, ДополнительныеПараметры);
					ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
					
					Отказ = Истина;
					Возврат;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;			
		
		// удалить и все подчиненные строки и материалы
		Если НЕ Отказ Тогда
			УдалитьИзТоваровУслугиОтносящиесяКПотолку(ТекущиеДанные.Номенклатура, ТекущиеДанные.УИСтроки);
			УдалитьМатериалыОтносящиесяКПозиции(ТекущиеДанные.Номенклатура, ТекущиеДанные.УИСтроки);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	ТекущиеДанные = Элемент.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
		
	Если НоваяСтрока Тогда
		Если Копирование Тогда
			//++ №9649 для новой строки при копировании присвоим новый УИС
			// УИС родителя заполняем по схеме:
			//	- если это типовой отрез, тогда свой УИС
			//	- если это номенклатура подчиненная потолку, оставляем УИС родителя
			//	- в других ситуациях присваиваем свой УИС
			Если НоваяСтрока И Копирование Тогда				
				ТекущиеДанные.УИСтроки = новый УникальныйИдентификатор;
				ТекущиеДанные.ЗагруженоИзПостроителя = Ложь;
				
				Если НЕ ЗначениеЗаполнено(ТекущиеДанные.Потолок) Тогда
					ТекущиеДанные.УИСтрокиРодителя = ТекущиеДанные.УИСтроки;
				КонецЕсли;				
			КонецЕсли;
			//-- №9649	
		Иначе			
			ТекущиеДанные.СтавкаНДС = Объект.СтавкаНДС;
		КонецЕсли;
	КонецЕсли;
	
	//++ №13815	
	мПрерыдущееКоличество = Элемент.ТекущиеДанные.Количество;
	мПредыдущееКоличествоКВыработке = Элемент.ТекущиеДанные.КоличествоКВыработке;
	//-- №13815
	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	
	Если ТоварыКакДерево Тогда
		ТекущиеДанные = Элементы.ТоварыДерево.ТекущиеДанные;
	Иначе
		ТекущиеДанные = Элементы.Товары.ТекущиеДанные;
	КонецЕсли;

	Если НоваяСтрока 
		И НЕ ОтменаРедактирования 
		И НЕ ТекущиеДанные = Неопределено Тогда
		
		Если ПустаяСтрока(ТекущиеДанные.УИСтроки) Тогда // #6371 добавлено доп.проверка, иначе происходила подмена УИС для новых позиций со спецификациями, по которым есть материалы с другим УИС
			ТекущиеДанные.УИСтроки = Строка(Новый УникальныйИдентификатор);
			ТекущиеДанные.УИСтрокиРодителя = ТекущиеДанные.УИСтроки;
		КонецЕсли;
		
		Если РежимПодробнаяИнформацияПоТоварам Тогда
			// если скопировали строку
			ЗаполнитьДанныеКОтгрузкеИОстаткиПоТоварам();
		КонецЕсли;

	КонецЕсли;
	Если ТоварыКакДерево Тогда
		ПеренестиДеревоВТабличнуюЧасть();
	КонецЕсли;
	
	//ОбновитьДанныеДокумента();
	РассчитатьИтоговыеПоказателиКлиент();
	Если ИспользоватьБонусы Тогда
		ПересчитатьБонусыПоДокументу(); // №13299
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыПослеУдаления(Элемент)
	
	Если ТоварыКакДерево Тогда
		Модифицированность = Истина;
		ПеренестиДеревоВТабличнуюЧасть();
		ПостроитьДеревоНаФорме();
	КонецЕсли;
	
	//ОбновитьДанныеДокумента();
	Если РежимПодробнаяИнформацияПоТоварам Тогда
		ЗаполнитьДанныеКОтгрузкеИОстаткиПоТоварам();
	КонецЕсли;
		
	Если ИспользоватьБонусы Тогда	
		ПересчитатьБонусыПоДокументу(); // №13299
	КонецЕсли;
	
	ПерезаполнитьНомераПотолковПоТабличнойЧасти();
	РассчитатьИтоговыеПоказателиКлиент();
	
	ОбновитьСписокФайлов();
	
КонецПроцедуры

