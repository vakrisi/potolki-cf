
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Для чНом = 0 По Параметры.СписокПродукции.Количество()-1 Цикл
		НоваяСтрока = ТаблицаПродукции.Добавить();
		НоваяСтрока.Номенклатура = Параметры.СписокПродукции[чНом].Значение.Номенклатура; 
		НоваяСтрока.УИСтроки = Параметры.СписокПродукции[чНом].Значение.УИСтроки;		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаПродукцииВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТекущиеДанные = Элементы.ТаблицаПродукции.ТекущиеДанные;
	Если НЕ ТекущиеДанные = Неопределено Тогда
		СтруктураОтвета = Новый Структура;
		СтруктураОтвета.Вставить("Номенклатура", ТекущиеДанные.Номенклатура);
		СтруктураОтвета.Вставить("УИСтроки", ТекущиеДанные.УИСтроки);
		Закрыть(СтруктураОтвета);
	КонецЕсли;
	
КонецПроцедуры
