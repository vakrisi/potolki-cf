&НаКлиенте
Процедура ОтметитьСтрокиПоВидуНоменклатуры(Команда)
	
	Назначение = СтрЗаменить(Команда.Имя, "Отметить", "");	
	ОтметитьСтроки(Назначение, Истина);
	
КонецПроцедуры
	
&НаКлиенте
Процедура ОтметитьСтроки(Назначение = "Все", Заказывать = Истина, Инвертировать = Ложь)
	
	Если Назначение = "Все" Тогда		
		Для Каждого ТекущаяСтрока Из СписокТоваров Цикл
			ЗначениеГалки = ?(Инвертировать, НЕ ТекущаяСтрока.Заказывать, Заказывать); 
			ТекущаяСтрока.Заказывать = ЗначениеГалки;
			Если РегистрироватьВыпуск Тогда
				ТекущаяСтрока.РегистрироватьВыпуск = ЗначениеГалки;
			КонецЕсли;
		КонецЦикла;
	
	Иначе
		Для Каждого ТекущаяСтрока Из СписокТоваров Цикл
			Если (ТекущаяСтрока.ВидНоменклатуры = ПредопределенноеЗначение("Справочник.ВидыНоменклатуры.Материал") И Назначение = "Товары")
				ИЛИ (ТекущаяСтрока.ВидНоменклатуры = ПредопределенноеЗначение("Справочник.ВидыНоменклатуры.Потолок") И Назначение = "Потолки")
				ИЛИ (ТекущаяСтрока.ВидНоменклатуры = ПредопределенноеЗначение("Справочник.ВидыНоменклатуры.Отрез") И Назначение = "Отрезы")
				ИЛИ (ТекущаяСтрока.ВидНоменклатуры = ПредопределенноеЗначение("Справочник.ВидыНоменклатуры.Продукция") И Назначение = "Продукцию")
				Тогда
				
				ТекущаяСтрока.Заказывать = Заказывать;
				Если РегистрироватьВыпуск Тогда
					ТекущаяСтрока.РегистрироватьВыпуск = Заказывать;
				КонецЕсли;
				
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьСкладПродукции(Команда)
	
	Оповещение = Новый ОписаниеОповещения("ПослеВыбораСклада", ЭтаФорма);
	ОткрытьФорму("Справочник.Склады.ФормаВыбора",,,,,,Оповещение);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораСклада(Результат, Параметры) Экспорт
	
	Если Результат <> Неопределено Тогда
		Для каждого СтрокаТабличнойЧасти из СписокТоваров Цикл
			СтрокаТабличнойЧасти.СкладПродукции = Результат;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьЦех(Команда)
	
	Оповещение = Новый ОписаниеОповещения("ПослеВыбораЦеха", ЭтаФорма);
	ОткрытьФорму("Справочник.Цехи.ФормаВыбора",,,,,,Оповещение);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораЦеха(Результат, Параметры) Экспорт
	
	Если Результат <> Неопределено Тогда
		Для каждого СтрокаТабличнойЧасти из СписокТоваров Цикл
			СтрокаТабличнойЧасти.Цех = Результат;
			СтрокаТабличнойЧасти.СкладПродукции = ПолучитьСкладПриИзмененииЦехаНаСервере(СтрокаТабличнойЧасти.Цех, СтрокаТабличнойЧасти.СкладПродукции); // №7875
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

//++ №13265
&НаКлиенте
Процедура ЗаполнитьДатуОтгрузки(Команда)
	
	Оповещение = Новый ОписаниеОповещения("ПослеВыбораДатыОтгрузки", ЭтаФорма);
	ПоказатьВводДаты(Оповещение, ТекущаяДата(),, ЧастиДаты.ДатаВремя);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораДатыОтгрузки(Результат, Параметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого ТекущаяСтрока из СписокТоваров Цикл
		ТекущаяСтрока.ДатаОтгрузки = Результат;
	КонецЦикла;
	
КонецПроцедуры
//-- №13265

&НаКлиенте
Процедура Заказать(Команда)
	
	//#13249
	Отказ = Ложь;
	//Если НесколькоТочекПроизводства Тогда
		Для Индекс = 0 По СписокТоваров.Количество()-1 Цикл
			ТекущаяСтрока = СписокТоваров[Индекс];
			Если ТекущаяСтрока.Заказывать И НЕ ТекущаяСтрока.ПодчиненнаяСтрока Тогда
				//Если НЕ ЗначениеЗаполнено(ТекущаяСтрока.Цех) Тогда
				//	ТекстСообщения = "В строке " + Строка(Индекс+1) + " не заполнено значение колонки ""Цех""";
				//	ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, , "СписокТоваров[" + Строка(Индекс) + "].Цех", , Отказ);
				//КонецЕсли;
				Если НЕ ЗначениеЗаполнено(ТекущаяСтрока.СкладПродукции)
					И СкладыОтличаются // №13855
				Тогда
					ТекстСообщения = "В строке " + Строка(Индекс+1) + " не заполнено значение колонки ""Склад продукции""";
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, , "СписокТоваров[" + Строка(Индекс) + "].СкладПродукции", , Отказ);
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	//КонецЕсли;
	
	Если Отказ Тогда
		Возврат;	
	КонецЕсли;
	
	СписокЗаказать = Новый Массив;
	Для Каждого ТекущаяСтрока Из СписокТоваров Цикл
		Если ТекущаяСтрока.Заказывать И НЕ ТекущаяСтрока.ПодчиненнаяСтрока Тогда
			СтруктураТовара = Новый Структура;
			СтруктураТовара.Вставить("Номенклатура", ТекущаяСтрока.Номенклатура);
			СтруктураТовара.Вставить("ХарактеристикаНоменклатуры", ТекущаяСтрока.ХарактеристикаНоменклатуры);
			СтруктураТовара.Вставить("Количество", ТекущаяСтрока.Количество);
			СтруктураТовара.Вставить("ЕдиницаИзмерения", ТекущаяСтрока.ЕдиницаИзмерения);
			СтруктураТовара.Вставить("Спецификация", ТекущаяСтрока.Спецификация);
			СтруктураТовара.Вставить("НомерСтроки", ТекущаяСтрока.НомерСтроки);
			СтруктураТовара.Вставить("ЗаказНаПроизводство", ТекущаяСтрока.ЗаказНаПроизводство);
