&НаКлиенте
Процедура СписокТоваровПриИзменении(Элемент)
	
	ТекДанные = Элементы.СписокТоваров.ТекущиеДанные;
	Если ЭтоПотолок(ТекДанные.Номенклатура) Тогда
		ОтметитьУслугиИТоварыПотолка(ТекДанные.Заказывать, ТекДанные.Номенклатура, ТекДанные.УИСтроки);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СписокТоваровПриАктивизацииСтроки(Элемент)
	
	ТекущиеДанные = Элементы.СписокТоваров.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Отбор = Новый Структура("Потолок", ПредопределенноеЗначение("Справочник.Номенклатура.ПустаяСсылка"));
	Иначе
		Отбор = Новый Структура("Потолок,УИстроки", ТекущиеДанные.Номенклатура, ТекущиеДанные.УИСтроки);
	КонецЕсли;	
		
	Элементы.СписокМатериалов.ОтборСтрок = новый ФиксированнаяСтруктура(Отбор);
	
	
	Если ТекущиеДанные = Неопределено Тогда
		Отбор = Новый Структура("Потолок", ПредопределенноеЗначение("Справочник.Номенклатура.ПустаяСсылка"));
	Иначе
		Отбор = Новый Структура("Потолок,УИстрокиРодителя", ТекущиеДанные.Номенклатура, ТекущиеДанные.УИСтроки);
	КонецЕсли;
	
	Элементы.СписокУслуг.ОтборСтрок = новый ФиксированнаяСтруктура(Отбор);

КонецПроцедуры

&НаКлиенте
Процедура СписокТоваровЗаказыватьПриИзменении(Элемент)
	
	ТекДанные = Элементы.СписокТоваров.ТекущиеДанные;
	Если РегистрироватьВыпуск Тогда
		ТекДанные.РегистрироватьВыпуск = ТекДанные.Заказывать;
	КонецЕсли;
	Если ЭтоПотолок(ТекДанные.Номенклатура) Тогда
		ОтметитьУслугиИТоварыПотолка(ТекДанные.Заказывать, ТекДанные.Номенклатура, ТекДанные.УИСтроки);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СписокТоваровЦехПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.СписокТоваров.ТекущиеДанные;
	ТекущиеДанные.СкладПродукции = ПолучитьСкладПриИзмененииЦехаНаСервере(ТекущиеДанные.Цех, ТекущиеДанные.СкладПродукции);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ОтметитьУслугиИТоварыПотолка(Заказывать, Потолок, УИСтроки)
	
	Для Каждого ТекущаяСтрока Из СписокТоваров Цикл
		Если ТекущаяСтрока.Потолок = Потолок 
			И ТекущаяСтрока.УИСтроки = УИСтроки
			Тогда
			ТекущаяСтрока.Заказывать = Заказывать;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ПерестроитьСписокТоваровНаФорме()
	
	//таблица нужна, чтобы вернуть установленную ранее галочку, если позиция после перестроения так и остается на форме и у нее была галочка
	ВремСписокТоваров.Очистить();
	Для Каждого ТекСтрока Из СписокТоваров Цикл
		НоваяСтрока = ВремСписокТоваров.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
	КонецЦикла;
		
	СписокТоваров.Очистить();
	Для Каждого ТекущаяСтрока Из СписокТоваровИзначальный Цикл
		Если ТекущаяСтрока.ВидНоменклатуры = ПредопределенноеЗначение("Справочник.ВидыНоменклатуры.Материал") И ЗаказыватьТовары
			или ТекущаяСтрока.ВидНоменклатуры = ПредопределенноеЗначение("Справочник.ВидыНоменклатуры.Потолок") И ЗаказыватьПотолки
			или ТекущаяСтрока.ВидНоменклатуры = ПредопределенноеЗначение("Справочник.ВидыНоменклатуры.Отрез") И ЗаказыватьОтрезы
			или ТекущаяСтрока.ВидНоменклатуры = ПредопределенноеЗначение("Справочник.ВидыНоменклатуры.ТиповойОтрез") И ЗаказыватьТиповыеОтрезы
			или ТекущаяСтрока.ВидНоменклатуры = ПредопределенноеЗначение("Справочник.ВидыНоменклатуры.Продукция") И ЗаказыватьПродукцию
			Тогда
			
			НоваяСтрока = СписокТоваров.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущаяСтрока);
			
			Отбор = Новый Структура;
			Отбор.Вставить("УИСтроки",НоваяСтрока.УИСтроки);
			НайденныеСтроки = ВремСписокТоваров.НайтиСтроки(Отбор);
			Если НайденныеСтроки.Количество() > 0 Тогда
				НоваяСтрока.Заказывать = НайденныеСтроки[0].Заказывать;
			КонецЕсли;
		
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьСкладПриИзмененииЦехаНаСервере(Цех, СкладПродукции)
	
	СкладПродукцииПользователя = ОбщийМодульСервер.НастройкаПользователя("СкладПродукции");
	
	Если ЗначениеЗаполнено(Цех.СкладГотовойПродукции) Тогда
		Возврат Цех.СкладГотовойПродукции;
	//++ #14947
	//ИначеЕсли ЗначениеЗаполнено(ПараметрыСеанса.ТекущийПользователь.Склад) Тогда
		//Возврат ПараметрыСеанса.ТекущийПользователь.Склад;
	ИначеЕсли ЗначениеЗаполнено(СкладПродукцииПользователя) Тогда
		Возврат СкладПродукцииПользователя;
	//-- #14947
	ИначеЕсли ЗначениеЗаполнено(СкладПродукции) Тогда
		Возврат СкладПродукции;

	КонецЕсли;
	
КонецФункции

&НаСервере
Функция ЭтоПотолок(Номенклатура)
	Возврат Справочники.ВидыНоменклатуры.ЭтоНоменклатураПотолкаИлиОтреза(Номенклатура);
КонецФункции

&НаКлиенте
Процедура СписокТоваровВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	//++ №12001
	ТекущиеДанные = Элементы.СписокТоваров.ТекущиеДанные;
	
	Если Элемент.ТекущийЭлемент.Имя = "СписокТоваровСтатусПроизводства"
		И НЕ ТекущиеДанные = Неопределено
		И ЗначениеЗаполнено(ТекущиеДанные.ЗаказНаПроизводство)
	Тогда
	
		ОткрытьФорму("Документ.ЗаказНаПроизводство.ФормаОбъекта", новый Структура("Ключ", ТекущиеДанные.ЗаказНаПроизводство));
		
	КонецЕсли;
	//-- №12001
	
