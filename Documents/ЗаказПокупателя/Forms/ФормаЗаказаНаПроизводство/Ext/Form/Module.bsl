#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЗаказыватьОтрезы = Истина;
	ЗаказыватьПотолки = Истина;
	ЗаказыватьТиповыеОтрезы = Истина;
	ЗаказыватьТовары = Истина;
	ЗаказыватьПродукцию = Истина; //#6265
	
	СкладыОтличаются = Константы.СкладОтгрузкиПотолоковОтличаетсяОтСкладаГотовойПродукции.Получить();
	НесколькоТочекПроизводства = Константы.НесколькоТочекПроизводства.Получить();
	//Параметры.Свойство("Склад", СкладОтгрузки);
	
	//#10918
	РегистрироватьВыпуск = ПолучитьФункциональнуюОпцию("АвтоматическиРегистрироватьВыпускПриЗаказеНаПроизводство");
	Элементы.СписокТоваровРегистрироватьВыпуск.Видимость = РегистрироватьВыпуск;
	
	РеквизитыПользователя = ОбщийМодульСервер.НастройкиПользователя("Склад, СкладПродукции, Цех");

	Если НЕ Параметры.СписокПотолков = Неопределено Тогда
		МассивПотолков = Параметры.СписокПотолков;
		Для НомерСтроки = 0 По МассивПотолков.Количество() - 1 Цикл
			НоваяСтрока = СписокТоваровИзначальный.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, МассивПотолков[НомерСтроки], 
				"СкладОтгрузки, ЗаказНаПроизводство, СтатусПроизводства,
				|НомерСтроки, Номенклатура, ХарактеристикаНоменклатуры, Количество, ЕдиницаИзмерения, Коэффициент, ПроцентРучнойСкидки, СуммаРучнойСкидки, Цена, Сумма, 
				|Спецификация, Потолок, УИСтроки, Назначение, КоличествоКВыработке, Заказ, АдресМонтажа, Срочно");
			НоваяСтрока.ВидНоменклатуры = НоваяСтрока.Номенклатура.ВидНоменклатуры;
			//НоваяСтрока.СкладОтгрузки = СкладОтгрузки; //2021-09-17 берем из таблицы
			
			Если НЕ Параметры.НастройкаИнтеркампани.Пустая() Тогда 
				НоваяСтрока.СкладПродукции = Параметры.НастройкаИнтеркампани.ПроизводствоСклад;
				
			ИначеЕсли СкладыОтличаются Тогда
				//НоваяСтрока.СкладПродукции = ПараметрыСеанса.ТекущийПользователь.Склад;
				//НоваяСтрока.СкладПродукции = РеквизитыПользователя.СкладПродукции; 
				НоваяСтрока.СкладПродукции = МассивПотолков[НомерСтроки].Заказ.СкладМатериалов;
			КонецЕсли;
			
			Если НесколькоТочекПроизводства Тогда
				НоваяСтрока.Цех = РеквизитыПользователя.Цех;
			КонецЕсли;
			
			//++ №7875 в колонке "Склад продукции" ставить склад из цеха, если он указан
			Если СкладыОтличаются И НесколькоТочекПроизводства И ЗначениеЗаполнено(НоваяСтрока.Цех.СкладГотовойПродукции) Тогда
				НоваяСтрока.СкладПродукции = НоваяСтрока.Цех.СкладГотовойПродукции;
			КонецЕсли;
			//-- №7875
			
			//++ №13265
			Если ЗначениеЗаполнено(НоваяСтрока.Заказ.ОжидаемаяДатаОтгрузки) Тогда				
				НоваяСтрока.ДатаОтгрузки = НоваяСтрока.Заказ.ОжидаемаяДатаОтгрузки + (НоваяСтрока.Заказ.ОжидаемоеВремяОтгрузки - Дата(1,1,1));				
			Иначе
				// 2022-05-23 Ильнур, закомментировано
				//ПланируемаяДата = ОбменСEasyCeiling.ПолучитьЗначениеРеквизита(НоваяСтрока.Номенклатура, "Потолок_ПланируемаяДата");
				//ПланируемоеВремя = ОбменСEasyCeiling.ПолучитьЗначениеРеквизита(НоваяСтрока.Номенклатура, "Потолок_ПланируемоеВремя");
				//
				//НоваяСтрока.ДатаОтгрузки = ПланируемаяДата + (ПланируемоеВремя - Дата(1,1,1));				
			КонецЕсли;
			//-- №13265
			
			//НоваяСтрока.РегистрироватьВыпуск = РегистрироватьВыпуск; //#10918
									
			//добавляем подчиненные строки по услугам
			МассивУслуг = Параметры.СписокУслуг;
			Для НомерСтрокиУслуги = 0 По МассивУслуг.Количество() - 1 Цикл
				Если МассивУслуг[НомерСтрокиУслуги].Потолок = НоваяСтрока.Номенклатура
					И МассивУслуг[НомерСтрокиУслуги].УИСтроки = НоваяСтрока.УИСтроки
					Тогда
					НоваяПодчиненнаяСтрока = СписокТоваровИзначальный.Добавить();
					ЗаполнитьЗначенияСвойств(НоваяПодчиненнаяСтрока, МассивУслуг[НомерСтрокиУслуги]);
					НоваяПодчиненнаяСтрока.ВидНоменклатуры = НоваяПодчиненнаяСтрока.Номенклатура.ВидНоменклатуры;
					НоваяПодчиненнаяСтрока.ПодчиненнаяСтрока = Истина;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;
	
	Если НЕ Параметры.СписокУслуг = Неопределено Тогда
		МассивУслуг = Параметры.СписокУслуг;
		Для НомерСтроки = 0 По МассивУслуг.Количество() - 1 Цикл
			НоваяСтрока = СписокУслуг.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, МассивУслуг[НомерСтроки]);
			НоваяСтрока.ВидНоменклатуры = НоваяСтрока.Номенклатура.ВидНоменклатуры;
		КонецЦикла;
	КонецЕсли;
	
	Если НЕ Параметры.СписокМатериалов = Неопределено Тогда
		МассивМатериалов = Параметры.СписокМатериалов;
		Для НомерСтроки = 0 По МассивМатериалов.Количество() - 1 Цикл
			НоваяСтрока = СписокМатериалов.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, МассивМатериалов[НомерСтроки]);
			НоваяСтрока.ВидНоменклатуры = НоваяСтрока.Номенклатура.ВидНоменклатуры;
		КонецЦикла;
	КонецЕсли;
	
	//Начало исключен при переходе на 2.0
	//Элементы.СписокТоваровОтметитьТовары.Видимость = Параметры.ЗаказыватьТовары;
	//Конец исключен при переходе на 2.0
	
	Элементы.СписокТоваровЗаполнитьСкладПродукции.Видимость = СкладыОтличаются;
	Элементы.СписокТоваровСкладПродукции.Видимость = СкладыОтличаются;
	
	//++ №7875 закомментировано, т.к. склад показываем всегда, просто меняем заголовок
	//Элементы.СписокТоваровСкладОтгрузки.Видимость = СкладыОтличаются;
	Элементы.СписокТоваровСкладОтгрузки.Заголовок = ?(СкладыОтличаются, "Склад отгрузки", "Склад отгрузки и продукции");
	//-- №7875
	
	Элементы.СписокТоваровЦех.Видимость = НесколькоТочекПроизводства;
	Элементы.СписокТоваровЗаполнитьЦех.Видимость = НесколькоТочекПроизводства;
	
	// Видимость колонки Артикул
	МассивЭлементов = новый Массив();
	МассивЭлементов.Добавить("СписокТоваровНоменклатураАртикул");
	МассивЭлементов.Добавить("СписокМатериаловНоменклатураАртикул");
	МассивЭлементов.Добавить("СписокУслугНоменклатураАртикул");
	ОбщийМодульСервер.УстановитьВидимостьКолонкиАртикулВТабличнойЧасти(ЭтаФорма, МассивЭлементов);
		
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ПерестроитьСписокТоваровНаФорме();
КонецПроцедуры

#КонецОбласти

