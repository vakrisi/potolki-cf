		Возврат;
	КонецЕсли;
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;

	//#9194, #9989 (удалено)
	//Если НЕ Отказ И ПолучитьФункциональнуюОпцию("ОтправлятьДетализациюВзаиморасчетовПриВыполненииЗаказа") Тогда
