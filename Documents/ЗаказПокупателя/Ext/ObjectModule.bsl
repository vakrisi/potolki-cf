	//		МенеджерЗаписи.Документ 	= Ссылка;
	//		МенеджерЗаписи.ВидЗадания 	= Перечисления.ВидыЗаданийНаОтправкуЭлектронныхПисем.ОтправкаДетализацииВзаиморасчетов;
	//		МенеджерЗаписи.Прочитать();
	//		Если НЕ МенеджерЗаписи.Выбран() Тогда
	//			МенеджерЗаписи.Документ 	= Ссылка;
	//			МенеджерЗаписи.ВидЗадания 	= Перечисления.ВидыЗаданийНаОтправкуЭлектронныхПисем.ОтправкаДетализацииВзаиморасчетов;
	//			МенеджерЗаписи.Организация 	= Организация;
	//			МенеджерЗаписи.Контрагент 	= Контрагент;
	//			МенеджерЗаписи.Записать();
	//		КонецЕсли;
	//		
	//	КонецЕсли;
	//КонецЕсли;
	
	//#13969
	Если ДополнительныеСвойства.Свойство("ДатаСоздания") Тогда
		// при программном создании / записи заказа свойство заполняется в "ИнициализироватьСлужебныеРеквизиты"
		// при создании через форму в "ПередЗаписьюНаСервере"
