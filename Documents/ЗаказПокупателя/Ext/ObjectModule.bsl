	КонецЕсли;
	
	//#13969
	Если ДополнительныеСвойства.Свойство("ПредыдущийСтатус")
		И НЕ ТекущийСтатус = ДополнительныеСвойства.ПредыдущийСтатус Тогда
		
		ТекстКомментария = СтрШаблон("Изменен статус с ""%1"" на ""%2""", ДополнительныеСвойства.ПредыдущийСтатус, ТекущийСтатус);
		РегистрыСведений.ИсторияЗаказаПокупателя.ДобавитьЗаписьВИсторию(Ссылка, ТекущаяДатаСеанса(), Пользователи.ТекущийПользователь(), ТекстКомментария);
