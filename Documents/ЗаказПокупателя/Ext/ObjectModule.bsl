Процедура ОбработкаРезервированияЗаказаПокупателя(ЗаказПокупателя, ВТ_Товары)
	//Получим Остатки по резервам
	УстановитьПривилегированныйРежим(Истина);
	Если НЕ Константы.ИспользоватьРезервирование.Получить() Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	ТоварыВРезервеНаСкладахОстатки.Номенклатура КАК Номенклатура,
	               |	ТоварыВРезервеНаСкладахОстатки.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	               |	ТоварыВРезервеНаСкладахОстатки.СерияНоменклатуры КАК СерияНоменклатуры,
	               |	ЕСТЬNULL(ТоварыВРезервеНаСкладахОстатки.КоличествоОстаток, 0) КАК Количество,
	               |	ТоварыВРезервеНаСкладахОстатки.Номенклатура.БазоваяЕдиницаИзмерения КАК ЕдиницаИзмерения,
	               |	1 КАК Коэффициент,
	               |	ТоварыВРезервеНаСкладахОстатки.Склад КАК Склад
	               |ИЗ
	               |	РегистрНакопления.ТоварыВРезервеНаСкладах.Остатки(
	               |			,
	               |			ДокументРезерва = &ДокументРезерва
	               |				И ВидТабличнойЧасти = &ВидТЧ
	               |				И Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Справочник.ВидыНоменклатуры.Материал)) КАК ТоварыВРезервеНаСкладахОстатки";
	Запрос.УстановитьПараметр("ДокументРезерва", ЗаказПокупателя);
	Запрос.УстановитьПараметр("ВидТЧ", Перечисления.ВидыТабличнойЧасти.Товары);
	РезультатЗапроса = Запрос.Выполнить();
		
	Если НЕ РезультатЗапроса.Пустой() Тогда
			
		ТЗ_Резервы = РезультатЗапроса.Выгрузить();
			
	КонецЕсли;
	
	// Учёт изменения склада в заказе:
	// если по заказу есть резервы на складе, отличном от текущего склада заказа,
	// снимаем все резервы заказа (на их фактических складах) и резервируем товары заново на новом складе.
	// Выполняем только для статуса "В работе".
	Если ТекущийСтатус = Справочники.СтатусыЗаказовПокупателей.ВРаботе
		И ТЗ_Резервы <> Неопределено И ТЗ_Резервы.Количество() > 0 Тогда

		ЕстьРезервНаДругомСкладе = Ложь;
		Для Каждого СтрокаРезерва Из ТЗ_Резервы Цикл
			Если ЗначениеЗаполнено(СтрокаРезерва.Склад) И СтрокаРезерва.Склад <> Склад Тогда
				ЕстьРезервНаДругомСкладе = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;

		Если ЕстьРезервНаДругомСкладе Тогда
			//снимаем весь остаток резервов по заказу на их фактических складах (склад берётся из строки резерва)
			СоздатьДокументСнятиеРезервирования(Ссылка, ТЗ_Резервы);
			//резервируем товары заказа заново на новом складе
			СоздатьДокументРезервирование(Ссылка, ВТ_Товары);
			УстановитьПривилегированныйРежим(Ложь);
			Возврат;
		КонецЕсли;
	КонецЕсли;

	Если (ТекущийСтатус = Справочники.СтатусыЗаказовПокупателей.Новый
		ИЛИ ТекущийСтатус = Справочники.СтатусыЗаказовПокупателей.Отменен)
		И (ТЗ_Резервы = Неопределено ИЛИ ТЗ_Резервы.Количество() = 0) Тогда
		//Резервов нет, снимать ничего не надо
	ИначеЕсли (ТекущийСтатус = Справочники.СтатусыЗаказовПокупателей.Новый
		ИЛИ ТекущийСтатус = Справочники.СтатусыЗаказовПокупателей.Отменен) 
		И (ТЗ_Резервы <> Неопределено И ТЗ_Резервы.Количество() > 0) Тогда
		//надо снять все резервы, заказ был переведен в статусы Новый или Отменен из других статусов
		СоздатьДокументСнятиеРезервирования(Ссылка, ТЗ_Резервы);
	ИначеЕсли ТекущийСтатус = Справочники.СтатусыЗаказовПокупателей.ВРаботе 
		И (ТЗ_Резервы = Неопределено ИЛИ ТЗ_Резервы.Количество() = 0) Тогда 
		СоздатьДокументРезервирование(Ссылка, ВТ_Товары);
	ИначеЕсли ТекущийСтатус = Справочники.СтатусыЗаказовПокупателей.ВРаботе 
		И (ТЗ_Резервы <> Неопределено ИЛИ ТЗ_Резервы.Количество() <> 0) Тогда
		ВремТаблицаТовары = ВТ_Товары.СкопироватьКолонки();
		Для Каждого ТекущаяСтрока Из Товары Цикл
			НоваяСтрока = ВремТаблицаТовары.Добавить();
			НоваяСтрока.Количество = ТекущаяСтрока.Количество * ТекущаяСтрока.Коэффициент;
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущаяСтрока, "Номенклатура, ХарактеристикаНоменклатуры, СерияНоменклатуры");
		КонецЦикла;
		ВремТаблицаТовары.Свернуть("Номенклатура, ХарактеристикаНоменклатуры, СерияНоменклатуры, ЕдиницаИзмерения, Коэффициент", "Количество");
		//надо проверить, что надо снять с резерва, а что зарезервировать
		ТЗ_СнятьРезерв = ВремТаблицаТовары.СкопироватьКолонки();
		ТЗ_Зарезервировать = ВремТаблицаТовары.СкопироватьКолонки();
		
		Для Каждого СтрокаЗаказаПокупателя Из ВремТаблицаТовары Цикл 
			Если СтрокаЗаказаПокупателя.Номенклатура.ВидНоменклатуры <> Справочники.ВидыНоменклатуры.Материал Тогда
				Продолжить;
			КонецЕсли;
			НайденныеСтрокиВРезервах =  ТЗ_Резервы.НайтиСтроки(Новый Структура("Номенклатура, ХарактеристикаНоменклатуры, СерияНоменклатуры", 
			СтрокаЗаказаПокупателя.Номенклатура, СтрокаЗаказаПокупателя.ХарактеристикаНоменклатуры, СтрокаЗаказаПокупателя.СерияНоменклатуры));
			Если НайденныеСтрокиВРезервах.Количество() > 0 Тогда
				НайденнаяСтрока = НайденныеСтрокиВРезервах[0]; 
				Если СтрокаЗаказаПокупателя.Количество > НайденнаяСтрока.Количество Тогда
					НоваяСтрока = ТЗ_Зарезервировать.Добавить(); 
					НоваяСтрока.Количество = СтрокаЗаказаПокупателя.Количество - НайденнаяСтрока.Количество;
					НоваяСтрока.ЕдиницаИзмерения = СтрокаЗаказаПокупателя.Номенклатура.БазоваяЕдиницаИзмерения;
					НоваяСтрока.Коэффициент = 1;
					ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаЗаказаПокупателя, "Номенклатура, ХарактеристикаНоменклатуры, СерияНоменклатуры");
				ИначеЕсли СтрокаЗаказаПокупателя.Количество < НайденнаяСтрока.Количество Тогда
					НоваяСтрока = ТЗ_СнятьРезерв.Добавить(); 
					НоваяСтрока.Количество = НайденнаяСтрока.Количество - СтрокаЗаказаПокупателя.Количество;
					НоваяСтрока.ЕдиницаИзмерения = СтрокаЗаказаПокупателя.Номенклатура.БазоваяЕдиницаИзмерения;
					НоваяСтрока.Коэффициент = 1;
					ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаЗаказаПокупателя, "Номенклатура, ХарактеристикаНоменклатуры, СерияНоменклатуры");
				Иначе
					//ничего не делаем, так как уже все зарезервировано
				КонецЕсли;
			Иначе 
				//резервируем, так как в резервах нет этой строки
				НоваяСтрока = ТЗ_Зарезервировать.Добавить(); 
				НоваяСтрока.Количество = СтрокаЗаказаПокупателя.Количество;
				НоваяСтрока.ЕдиницаИзмерения = СтрокаЗаказаПокупателя.Номенклатура.БазоваяЕдиницаИзмерения;
				НоваяСтрока.Коэффициент = 1;
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаЗаказаПокупателя, "Номенклатура, ХарактеристикаНоменклатуры, СерияНоменклатуры");
			КонецЕсли;
		КонецЦикла;
		
		Для Каждого СтрокаРезерва Из ТЗ_Резервы Цикл
			НайденныеСтрокиВЗаказе =  ВремТаблицаТовары.НайтиСтроки(Новый Структура("Номенклатура, ХарактеристикаНоменклатуры, СерияНоменклатуры",
			СтрокаРезерва.Номенклатура, СтрокаРезерва.ХарактеристикаНоменклатуры, СтрокаРезерва.СерияНоменклатуры));
			Если НайденныеСтрокиВЗаказе.Количество() > 0 Тогда
				//если строки есть, то их мы обработали в предыдущем цикле
				Продолжить;
			КонецЕсли;	                                                  
			НоваяСтрока = ТЗ_СнятьРезерв.Добавить(); 
			НоваяСтрока.Количество = СтрокаРезерва.Количество;
			НоваяСтрока.ЕдиницаИзмерения = СтрокаРезерва.Номенклатура.БазоваяЕдиницаИзмерения;
			НоваяСтрока.Коэффициент = 1;
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаРезерва, "Номенклатура, ХарактеристикаНоменклатуры, СерияНоменклатуры");		
		КонецЦикла;
		//снять резерв
		СоздатьДокументСнятиеРезервирования(Ссылка, ТЗ_СнятьРезерв);
		//поставить резерв
		СоздатьДокументРезервирование(Ссылка, ТЗ_Зарезервировать);
	ИначеЕсли (ТекущийСтатус = Справочники.СтатусыЗаказовПокупателей.Выполнен
		ИЛИ ТекущийСтатус = Справочники.СтатусыЗаказовПокупателей.Закрыт) Тогда
		// тут резервов быть не должно проверяется в процедуре ПередЗаписью()
	КонецЕсли;	

	УстановитьПривилегированныйРежим(Ложь);
КонецПроцедуры

Процедура СоздатьДокументРезервирование(ДокументРезерва, ВТ_Товары)
	
	Если ВТ_Товары = Неопределено ИЛИ ВТ_Товары.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ВТ_Товары = СкорректироватьПоОстатку(ДокументРезерва, ВТ_Товары);
	
	Если ВТ_Товары.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ДокРезервированиеОбъект = Документы.Резервирование.СоздатьДокумент();
	ДокРезервированиеОбъект.Автор = Пользователи.ТекущийПользователь();
	ДокРезервированиеОбъект.Дата = ТекущаяДата();
	ДокРезервированиеОбъект.ДокументРезерва = ДокументРезерва;
	ДокРезервированиеОбъект.Комментарий = "Документ резерва: " + ДокументРезерва + " был переведен в статус: " + ДокументРезерва.ТекущийСтатус;
	ДокРезервированиеОбъект.Контрагент = ДокументРезерва.Контрагент;
	ДокРезервированиеОбъект.УстановитьНовыйНомер();
	ДокРезервированиеОбъект.Организация = ДокументРезерва.Организация;
	ДокРезервированиеОбъект.Склад = ДокументРезерва.Склад;
	ДокРезервированиеОбъект.ТекущийСтатус = Справочники.СтатусыРезервирований.Выполнен;
	
	Для Каждого СтрокаТовар Из ВТ_Товары Цикл
		НовСтрокаТовар = ДокРезервированиеОбъект.Товары.Добавить();
		НовСтрокаТовар.Номенклатура = СтрокаТовар.Номенклатура;
		НовСтрокаТовар.ХарактеристикаНоменклатуры = СтрокаТовар.ХарактеристикаНоменклатуры; 
		НовСтрокаТовар.СерияНоменклатуры = СтрокаТовар.СерияНоменклатуры;
		НовСтрокаТовар.ЕдиницаИзмерения = СтрокаТовар.ЕдиницаИзмерения;
		НовСтрокаТовар.Коэффициент = СтрокаТовар.Коэффициент;
		НовСтрокаТовар.Количество = СтрокаТовар.Количество;
		НовСтрокаТовар.ВидТабличнойЧасти = Перечисления.ВидыТабличнойЧасти.Товары;
	КонецЦикла;
	
	ДокРезервированиеОбъект.Записать(РежимЗаписиДокумента.Проведение);

КонецПроцедуры

Процедура СоздатьДокументСнятиеРезервирования(ДокументРезерва, ВТ_Товары)
	
	Если ВТ_Товары = Неопределено ИЛИ ВТ_Товары.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;	
	ДокСнятиеРезервированияОбъект = Документы.СнятиеРезервов.СоздатьДокумент();
	ДокСнятиеРезервированияОбъект.Автор = Пользователи.ТекущийПользователь();
	ДокСнятиеРезервированияОбъект.Дата = ТекущаяДата();
	ДокСнятиеРезервированияОбъект.Комментарий = "Документ резерва: " + ДокументРезерва + " был переведен в статус: " + ДокументРезерва.ТекущийСтатус;
	ДокСнятиеРезервированияОбъект.Контрагент = ДокументРезерва.Контрагент;
	ДокСнятиеРезервированияОбъект.УстановитьНовыйНомер();
	ДокСнятиеРезервированияОбъект.Организация = ДокументРезерва.Организация;

	//если в таблице передан склад резерва (например, при переносе резервов со старого склада),
	//снимаем резерв именно с этого склада, иначе — со склада документа
	ЕстьКолонкаСклад = НЕ ВТ_Товары.Колонки.Найти("Склад") = Неопределено;

	Для Каждого СтрокаТовар Из ВТ_Товары Цикл
		НовСтрокаТовар = ДокСнятиеРезервированияОбъект.Товары.Добавить();
		НовСтрокаТовар.Номенклатура = СтрокаТовар.Номенклатура;
		НовСтрокаТовар.ХарактеристикаНоменклатуры = СтрокаТовар.ХарактеристикаНоменклатуры;
		НовСтрокаТовар.СерияНоменклатуры = СтрокаТовар.СерияНоменклатуры;
		НовСтрокаТовар.ЕдиницаИзмерения = СтрокаТовар.ЕдиницаИзмерения;
		НовСтрокаТовар.Коэффициент = СтрокаТовар.Коэффициент;
		НовСтрокаТовар.Количество = СтрокаТовар.Количество;
		Если ЕстьКолонкаСклад И ЗначениеЗаполнено(СтрокаТовар.Склад) Тогда
			НовСтрокаТовар.Склад = СтрокаТовар.Склад;
		Иначе
			НовСтрокаТовар.Склад = ДокументРезерва.Склад;
		КонецЕсли;
		НовСтрокаТовар.ДокументРезерва = ДокументРезерва;
		НовСтрокаТовар.ВидТабличнойЧасти = Перечисления.ВидыТабличнойЧасти.Товары;
	КонецЦикла;
	
	ДокСнятиеРезервированияОбъект.Записать(РежимЗаписиДокумента.Проведение);
	
КонецПроцедуры

Функция СкорректироватьПоОстатку(ДокументРезерва, ВТ_Товары)
	
	ВТ_Товары_Результат = ВТ_Товары.СкопироватьКолонки();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Товары.Номенклатура КАК Номенклатура,
		|	Товары.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
		|	Товары.СерияНоменклатуры КАК СерияНоменклатуры,
		|	Товары.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
		|	Товары.Коэффициент КАК Коэффициент,
		|	ЕСТЬNULL(Товары.Количество, 0) КАК КРезервированию
		|ПОМЕСТИТЬ ВТ_Товары
		|ИЗ
		|	&Товары КАК Товары
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ТоварыВРезервеНаСкладахОстатки.Номенклатура КАК Номенклатура,
		|	ТоварыВРезервеНаСкладахОстатки.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
		|	ТоварыВРезервеНаСкладахОстатки.СерияНоменклатуры КАК СерияНоменклатуры,
		|	СУММА(ТоварыВРезервеНаСкладахОстатки.КоличествоОстаток) КАК КоличествоОстаток
		|ПОМЕСТИТЬ ВТ_Резервы
		|ИЗ
		|	РегистрНакопления.ТоварыВРезервеНаСкладах.Остатки(
		|			&ДатаОстатков,
		|			Склад = &Склад
		|				И Организация = &Организация
		|				И ВидТабличнойЧасти = ЗНАЧЕНИЕ(перечисление.ВидыТабличнойЧасти.Товары)) КАК ТоварыВРезервеНаСкладахОстатки
		|// Учитываются ВСЕ резервы склада, в том числе резервы самого документа-основания:
		|// они точно так же занимают остаток на складе. Иначе повторное проведение заказа
		|// резервирует один и тот же свободный остаток заново (заказ 100, склад 10 - плюс 10 за проведение).
		|
		|СГРУППИРОВАТЬ ПО
		|	ТоварыВРезервеНаСкладахОстатки.Номенклатура,
		|	ТоварыВРезервеНаСкладахОстатки.ХарактеристикаНоменклатуры,
		|	ТоварыВРезервеНаСкладахОстатки.СерияНоменклатуры
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Продажи.Номенклатура КАК Номенклатура,
		|	Продажи.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
		|	Продажи.СерияНоменклатуры КАК СерияНоменклатуры,
		|	СУММА(Продажи.Количество) КАК КоличествоОтгружено
		|ПОМЕСТИТЬ ВТ_Отгружено
		|ИЗ
		|	РегистрНакопления.Продажи КАК Продажи
		|ГДЕ
		|	Продажи.ЗаказПокупателя = &ДокументРезерва
		|
		|СГРУППИРОВАТЬ ПО
		|	Продажи.Номенклатура,
		|	Продажи.ХарактеристикаНоменклатуры,
		|	Продажи.СерияНоменклатуры
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_Товары.Номенклатура КАК Номенклатура,
		|	ВТ_Товары.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
		|	ВТ_Товары.СерияНоменклатуры КАК СерияНоменклатуры,
		|	ВТ_Товары.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
		|	ВТ_Товары.Коэффициент КАК Коэффициент,
		|	ВЫБОР
		|		КОГДА ЕСТЬNULL(ТоварыНаСкладахОстатки.КоличествоОстаток, 0) - ЕСТЬNULL(ВТ_Резервы.КоличествоОстаток, 0) <= 0
		|			ТОГДА 0
		|		ИНАЧЕ ЕСТЬNULL(ТоварыНаСкладахОстатки.КоличествоОстаток, 0) - ЕСТЬNULL(ВТ_Резервы.КоличествоОстаток, 0)
		|	КОНЕЦ КАК КоличествоОстаток,
		|	ВЫБОР
		|		КОГДА ЕСТЬNULL(ВТ_Товары.КРезервированию, 0) - ЕСТЬNULL(ВТ_Отгружено.КоличествоОтгружено, 0) > 0
		|			ТОГДА ЕСТЬNULL(ВТ_Товары.КРезервированию, 0) - ЕСТЬNULL(ВТ_Отгружено.КоличествоОтгружено, 0)
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК КРезервированию
		|ИЗ
		|	ВТ_Товары КАК ВТ_Товары
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыНаСкладах.Остатки(
		|				&ДатаОстатков,
		|				Склад = &Склад
		|					И Организация = &Организация) КАК ТоварыНаСкладахОстатки
		|		ПО ВТ_Товары.Номенклатура = ТоварыНаСкладахОстатки.Номенклатура
		|			И ВТ_Товары.ХарактеристикаНоменклатуры = ТоварыНаСкладахОстатки.ХарактеристикаНоменклатуры
		|			И ВТ_Товары.СерияНоменклатуры = ТоварыНаСкладахОстатки.СерияНоменклатуры
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Резервы КАК ВТ_Резервы
		|		ПО ВТ_Товары.ХарактеристикаНоменклатуры = ВТ_Резервы.ХарактеристикаНоменклатуры
		|			И ВТ_Товары.СерияНоменклатуры = ВТ_Резервы.СерияНоменклатуры
		|			И ВТ_Товары.Номенклатура = ВТ_Резервы.Номенклатура
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Отгружено КАК ВТ_Отгружено
		|		ПО ВТ_Товары.ХарактеристикаНоменклатуры = ВТ_Отгружено.ХарактеристикаНоменклатуры
		|			И ВТ_Товары.СерияНоменклатуры = ВТ_Отгружено.СерияНоменклатуры
		|			И ВТ_Товары.Номенклатура = ВТ_Отгружено.Номенклатура";
	
	Запрос.УстановитьПараметр("ДатаОстатков", ТекущаяДата());
	Запрос.УстановитьПараметр("Организация", ДокументРезерва.Организация);
	Запрос.УстановитьПараметр("Склад", ДокументРезерва.Склад);
	Запрос.УстановитьПараметр("Товары", ВТ_Товары);
	Запрос.УстановитьПараметр("ДокументРезерва", ДокументРезерва);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		 
		Количество = 0;
		Если ВыборкаДетальныеЗаписи.КоличествоОстаток = 0 ИЛИ ВыборкаДетальныеЗаписи.КРезервированию = 0 Тогда
			Продолжить;
		ИначеЕсли ВыборкаДетальныеЗаписи.КРезервированию > ВыборкаДетальныеЗаписи.КоличествоОстаток Тогда
			Количество = ВыборкаДетальныеЗаписи.КоличествоОстаток;
		ИначеЕсли ВыборкаДетальныеЗаписи.КРезервированию <= ВыборкаДетальныеЗаписи.КоличествоОстаток Тогда
			Количество = ВыборкаДетальныеЗаписи.КРезервированию
		КонецЕсли;	  
		НовСтрока = ВТ_Товары_Результат.Добавить();
		НовСтрока.Количество = Количество;	
		ЗаполнитьЗначенияСвойств(НовСтрока, ВыборкаДетальныеЗаписи, "Номенклатура, ХарактеристикаНоменклатуры, СерияНоменклатуры, ЕдиницаИзмерения, Коэффициент");	
		
	КонецЦикла;
	
	Возврат ВТ_Товары_Результат;
	
КонецФункции	

Процедура ИзменитьСуммуДоставкиВЗаявкеНаДоставку(ЗаказПокупателя, СуммаДоставкиВЗаказеПокупателя)
	//получим все заявки, если их больше одной то меняем в последней

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ЗаявкаНаДоставкуОснования.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.ЗаявкаНаДоставку.Основания КАК ЗаявкаНаДоставкуОснования
		|ГДЕ
		|	ЗаявкаНаДоставкуОснования.Основание = &Основание
		|	И ЗаявкаНаДоставкуОснования.Ссылка.Результат <> ЗНАЧЕНИЕ(Справочник.СтатусыЗаявокНаДоставку.Отправлено)
		|			И ЗаявкаНаДоставкуОснования.Ссылка.Результат <> ЗНАЧЕНИЕ(Справочник.СтатусыЗаявокНаДоставку.Доставлено)
		|
		|УПОРЯДОЧИТЬ ПО
		|	ЗаявкаНаДоставкуОснования.Ссылка.Дата УБЫВ";
	
	Запрос.УстановитьПараметр("Основание", ЗаказПокупателя);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда 
		ЗаявкаНаДоставку = ВыборкаДетальныеЗаписи.Ссылка;
		СуммаДоставкиВЗаявкеНаДоставку = ЗаявкаНаДоставку.СтоимостьДоставки;
		Если СуммаДоставкиВЗаказеПокупателя <> СуммаДоставкиВЗаявкеНаДоставку тогда
			ЗаявкаНаДоставкуОбъект = ЗаявкаНаДоставку.ПолучитьОбъект();
			ЗаявкаНаДоставкуОбъект.СтоимостьДоставки = СуммаДоставкиВЗаказеПокупателя;
			ЗаявкаНаДоставкуОбъект.Записать(РежимЗаписиДокумента.Проведение);
		КонецЕсли;	
	Иначе
		//менять нечего заявки на достаку нет
	КонецЕсли;;
	
КонецПроцедуры	
