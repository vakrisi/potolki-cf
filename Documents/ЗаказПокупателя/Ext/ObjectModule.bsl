#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	Если ЭтоНовый() Тогда		
		ИнициализироватьСлужебныеРеквизиты();
	КонецЕсли;
	
	ОбщийМодуль.ЗаполнитьШапкуДокумента(ЭтотОбъект);
		
	//#13943
	Если ЭтоНовый() Тогда		
		ДозаполнитьПоУмолчанию();
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	
	ИнициализироватьСлужебныеРеквизиты(); //#14482
	
	//#15125 убираем уникальную продукцию
	МассивПродукции = Новый Массив;
	Для каждого СтрокаТЧ из Товары Цикл
		Если НЕ ЗначениеЗаполнено(СтрокаТЧ.Номенклатура) Тогда
			Продолжить;	
		КонецЕсли;
		ВидНоменклатуры = СтрокаТЧ.Номенклатура.ВидНоменклатуры;
		Если ВидНоменклатуры = Справочники.ВидыНоменклатуры.Потолок
			ИЛИ ВидНоменклатуры = Справочники.ВидыНоменклатуры.Отрез
			ИЛИ ВидНоменклатуры = Справочники.ВидыНоменклатуры.Продукция Тогда
			МассивПродукции.Добавить(СтрокаТЧ.Номенклатура);
		КонецЕсли;
	КонецЦикла;
	КоличествоСтрок = Материалы.Количество();
	Для Индекс = 1 По КоличествоСтрок Цикл
		Если НЕ МассивПродукции.Найти(Материалы[КоличествоСтрок-Индекс].Потолок) = Неопределено Тогда	
			Материалы.Удалить(КоличествоСтрок-Индекс);
		КонецЕсли;
	КонецЦикла;
	КоличествоСтрок = Товары.Количество();
	Для Индекс = 1 По КоличествоСтрок Цикл
		Если НЕ МассивПродукции.Найти(Товары[КоличествоСтрок-Индекс].Номенклатура) = Неопределено 
			ИЛИ НЕ МассивПродукции.Найти(Товары[КоличествоСтрок-Индекс].Потолок) = Неопределено Тогда	
			Товары.Удалить(КоличествоСтрок-Индекс);
		КонецЕсли;
	КонецЦикла;
	
	//#10918
	УчитыватьНДС = УчетНДС.ОрганизацияЯвляетсяПлательщикомНДС(Организация);
	Для каждого СтрокаТЧ из Товары Цикл
		СтрокаТЧ.ЗаказНаПроизводство = Документы.ЗаказНаПроизводство.ПустаяСсылка();
		
		СтрокаТЧ.СкидкаБонусами    = 0; //#14482
		СтрокаТЧ.БонусыКНачислению = 0; //#14482
		
		ОбработкаТабличныхЧастейКлиентСервер.ПересчитатьСуммуСУчетомСкидокВСтрокеТЧ(СтрокаТЧ, Ложь, , Истина);
		ОбработкаТабличныхЧастейКлиентСервер.ПересчитатьСуммуНДСВСтрокеТЧ(СтрокаТЧ, УчитыватьНДС);
	КонецЦикла;
	СоответствиеРодительскихУИС = Новый Соответствие;
	Для каждого СтрокаТЧ из Товары Цикл
		Если НЕ ПустаяСтрока(СтрокаТЧ.УИСтроки) Тогда
			НовыйУИ = СоответствиеРодительскихУИС.Получить(СтрокаТЧ.УИСтроки);
			Если НовыйУИ = Неопределено Тогда
				НовыйУИ = Строка(Новый УникальныйИдентификатор);
				СоответствиеРодительскихУИС.Вставить(СтрокаТЧ.УИСтроки, НовыйУИ);
				СтрокаТЧ.УИСтроки = НовыйУИ;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Для каждого СтрокаТЧ из Товары Цикл
		Если НЕ ПустаяСтрока(СтрокаТЧ.УИСтрокиРодителя) Тогда
			СтрокаТЧ.УИСтрокиРодителя = СоответствиеРодительскихУИС.Получить(СтрокаТЧ.УИСтрокиРодителя);
		КонецЕсли;		
	КонецЦикла;
	Для каждого СтрокаТЧ из Материалы Цикл
		Если НЕ ПустаяСтрока(СтрокаТЧ.УИСтроки) Тогда
			СтрокаТЧ.УИСтроки = СоответствиеРодительскихУИС.Получить(СтрокаТЧ.УИСтроки);
		КонецЕсли;		
	КонецЦикла;
	
	UDS_КодСкидки = "";
	UDS_СуммаСкидки = 0;
	UDS_ИдентификаторОперации = "";
	UDS_ДатаОперации = Дата(1,1,1);
	
	ДозаполнитьПоУмолчанию();
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	Если ТипЗнч(Основание) = Тип("ДокументСсылка.ЗаказДоговор") И НЕ Основание.Пустая() Тогда
		//Всё ок, проверяемые реквизиты комната и назначение оставляем
		
		//#4679
		Если ПолучитьФункциональнуюОпцию("КоличествоТоваровКСписаниюВРозницеНеСоответствуетКоличествуПроданногоТовара") Тогда
			РеквизитКоличество = ПроверяемыеРеквизиты.Найти("Товары.Количество");
			Если НЕ РеквизитКоличество = Неопределено Тогда
				ПроверяемыеРеквизиты.Удалить(РеквизитКоличество);
			КонецЕсли;
		КонецЕсли;
		
		Если НЕ СозданПриИспользованииНастройкиУчетОбеспеченностиРозницыПоКомнатам 
			И ПроверяемыеРеквизиты.Найти("Товары.Комната") <> Неопределено Тогда			
			ПроверяемыеРеквизиты.Удалить(ПроверяемыеРеквизиты.Найти("Товары.Комната"));
		КонецЕсли;
	Иначе
		Если ПроверяемыеРеквизиты.Найти("Товары.Комната") <> Неопределено Тогда			
			ПроверяемыеРеквизиты.Удалить(ПроверяемыеРеквизиты.Найти("Товары.Комната"));
		КонецЕсли;
		Если ПроверяемыеРеквизиты.Найти("Товары.Назначение") <> Неопределено Тогда
			ПроверяемыеРеквизиты.Удалить(ПроверяемыеРеквизиты.Найти("Товары.Назначение"));
		КонецЕсли;
	КонецЕсли;
	
	ПроверятьЗаполнениеКонтрагента = Истина;
	Если НЕ НастройкаИнтеркампани.Пустая() И ЭтоЗаказОтРозницы Тогда
		ПроверятьЗаполнениеКонтрагента 	= НЕ НастройкаИнтеркампани.ОднаОрганизацияПроизводстваИПродажиПотолков; 
	КонецЕсли;
	Если ПроверятьЗаполнениеКонтрагента 
		И ВнутреннийЗаказ
		И НЕ Константы.ОтображатьКонтрагентаВоВнутреннихЗаказах.Получить() Тогда
		ПроверятьЗаполнениеКонтрагента = Ложь;
	КонецЕсли;
	//#13967
	Если ТекущийСтатус = Справочники.СтатусыЗаказовПокупателей.Новый Тогда
		ПроверятьЗаполнениеКонтрагента = Ложь;
		
		РеквизитСклад = ПроверяемыеРеквизиты.Найти("Склад");
		Если НЕ РеквизитСклад = Неопределено Тогда
			ПроверяемыеРеквизиты.Удалить(РеквизитСклад);
		КонецЕсли;
	КонецЕсли;	
	Если НЕ ПроверятьЗаполнениеКонтрагента Тогда
		РеквизитКонтрагент = ПроверяемыеРеквизиты.Найти("Контрагент");
		Если НЕ РеквизитКонтрагент = Неопределено Тогда
			ПроверяемыеРеквизиты.Удалить(РеквизитКонтрагент);
		КонецЕсли;
		РеквизитДоговор = ПроверяемыеРеквизиты.Найти("ДоговорКонтрагента");
		Если НЕ РеквизитДоговор = Неопределено Тогда
			ПроверяемыеРеквизиты.Удалить(РеквизитДоговор);
		КонецЕсли;
	КонецЕсли;
	
	// #13826 
	Для Индекс = 0 по Материалы.Количество()-1 Цикл
		СтрокаТабличнойЧасти = Материалы[Индекс];
		Если Справочники.ВидыНоменклатуры.ЭтоНоменклатураУслуга(СтрокаТабличнойЧасти.Номенклатура) Тогда
			ТекстОшибки = "В строке " + Строка(Индекс+1) + " таблицы ""Материалы"" выбрана номенклатура-услуга";
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки, ЭтотОбъект, "Материалы["+Формат(Индекс, "ЧГ=0")+"].Номенклатура", , Отказ);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	//// #5185, т.к. отловить событие установки пометки удаления в форме никак нельзя, будем запоминать необходимость обновления данных для Заказ-договора в модуле объекта
	// Пока убрали этот код
	//Если ЭтоЗаказОтРозницы И НЕ Ссылка.ПометкаУдаления И ПометкаУдаления Тогда	
	//	УстановитьПривилегированныйРежим(Истина);
	//	ХранилищеОбщихНастроек.Сохранить("УстановленаПометкаУдаленияНаЗаказПокупателя",, Истина,, Строка(ПараметрыСеанса.ТекущийПользователь));
	//	УстановитьПривилегированныйРежим(Ложь);
	//КонецЕсли;	
	
	Если НЕ ТекущийСтатус = Справочники.СтатусыЗаказовПокупателей.Отменен
		И НЕ ПометкаУдаления Тогда
		//если заказ покупателя не помечен на удаление и не имеет статус "Отменен", проверяем, что указанные в нем потолки отсутствуют в других неотмененных заказах покупателей
		
		Потолки_НомераРасчета = Новый СписокЗначений;
		Продукция_НомераРасчета = Новый СписокЗначений;
		
		Для Каждого ТекущаяСтрока Из Товары Цикл
			
			Если Справочники.ВидыНоменклатуры.ЭтоНоменклатураУникальногоПотолкаИлиОтреза(ТекущаяСтрока.Номенклатура) Тогда
				
				//++ №12541 проверку делаем по номеру расчета
				//СписокПотолков.Добавить(ТекущаяСтрока.Номенклатура);
				Потолки_НомераРасчета.Добавить(ТекущаяСтрока.Номенклатура.Потолок_НомерРасчета + "-" + ТекущаяСтрока.Номенклатура.Потолок_ИндексПотолка);
				//-- №12541
				
			//#12667
			ИначеЕсли Справочники.ВидыНоменклатуры.ЭтоНоменклатураПродукцияУникальная(ТекущаяСтрока.Номенклатура) Тогда
				Продукция_НомераРасчета.Добавить(ТекущаяСтрока.Номенклатура.Потолок_НомерРасчета + "-" + ТекущаяСтрока.Номенклатура.Потолок_ИндексПотолка);
			КонецЕсли;
			
		КонецЦикла;
		
		УстановитьПривилегированныйРежим(Истина);
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЗаказПокупателяТовары.Ссылка КАК Ссылка,
		|	ЗаказПокупателяТовары.Номенклатура КАК Номенклатура
		|ИЗ
		|	Документ.ЗаказПокупателя.Товары КАК ЗаказПокупателяТовары
		|ГДЕ
		|	НЕ ЗаказПокупателяТовары.Ссылка.ПометкаУдаления
		|	И НЕ ЗаказПокупателяТовары.Ссылка.ТекущийСтатус = Значение(Справочник.СтатусыЗаказовПокупателей.Отменен)
		|	И НЕ ЗаказПокупателяТовары.Ссылка = &Ссылка
		//++ №12541 проверку делаем по номеру расчета
		//|	И ЗаказПокупателяТовары.Номенклатура В(&Номенклатура)
		|	И (
		|		((ЗаказПокупателяТовары.Номенклатура.ВидНоменклатуры = Значение(Справочник.ВидыНоменклатуры.Потолок)
		|			Или ЗаказПокупателяТовары.Номенклатура.ВидНоменклатуры = Значение(Справочник.ВидыНоменклатуры.Отрез))
		|				И ЗаказПокупателяТовары.Номенклатура.Потолок_НомерРасчета + ""-"" + ЗаказПокупателяТовары.Номенклатура.Потолок_ИндексПотолка В(&Потолки_НомераРасчета)
		|		)
		//-- №12541
		|		ИЛИ
		|			(ЗаказПокупателяТовары.Номенклатура.ВидНоменклатуры = Значение(Справочник.ВидыНоменклатуры.Продукция)
		|				И ЗаказПокупателяТовары.Номенклатура.Потолок_НомерРасчета + ""-"" + ЗаказПокупателяТовары.Номенклатура.Потолок_ИндексПотолка В(&Продукция_НомераРасчета)
		|			)
		|	  )
		|";
		Запрос.УстановитьПараметр("Ссылка", Ссылка);
		Запрос.УстановитьПараметр("Потолки_НомераРасчета", Потолки_НомераРасчета);
		Запрос.УстановитьПараметр("Продукция_НомераРасчета", Продукция_НомераРасчета); //#12667
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Пока Выборка.Следующий() Цикл
			Отказ = Истина;
			Сообщить("По продукции """ + Выборка.Номенклатура + """ имеется другой оформленный заказ - " + Выборка.Ссылка);
		КонецЦикла;
		
		УстановитьПривилегированныйРежим(Ложь);
		
		Если Отказ Тогда 
			Возврат;
		КонецЕсли;
		
	КонецЕсли;
	
	Если ТекущийСтатус = Справочники.СтатусыЗаказовПокупателей.Закрыт Тогда	
		Если ДатаЗакрытия = Дата(1,1,1) Тогда
			ДатаЗакрытия = ТекущаяДатаСеанса();
		КонецЕсли;
		//#9777
		Если ДатаВыполнения = Дата(1,1,1) Тогда
			ДатаВыполнения = ДатаЗакрытия; //ТекущаяДатаСеанса();
		КонецЕсли;
	КонецЕсли;
	//#9777
	Если Ссылка.ТекущийСтатус = Справочники.СтатусыЗаказовПокупателей.Закрыт
		И НЕ ТекущийСтатус = Справочники.СтатусыЗаказовПокупателей.Закрыт 
		И НЕ ДатаЗакрытия = Дата(1,1,1) Тогда
		ДатаЗакрытия = Дата(1,1,1);
	КонецЕсли;
	//#9777
	Если Ссылка.ТекущийСтатус = Справочники.СтатусыЗаказовПокупателей.Выполнен
		И НЕ ТекущийСтатус = Справочники.СтатусыЗаказовПокупателей.Выполнен 
		И НЕ ТекущийСтатус = Справочники.СтатусыЗаказовПокупателей.Закрыт
		И НЕ ДатаВыполнения = Дата(1,1,1) Тогда
		ДатаВыполнения = Дата(1,1,1);
	КонецЕсли;
	//#9777
	Если Ссылка.ТекущийСтатус = Справочники.СтатусыЗаказовПокупателей.Закрыт
		И НЕ ТекущийСтатус = Справочники.СтатусыЗаказовПокупателей.Выполнен 
		И НЕ ТекущийСтатус = Справочники.СтатусыЗаказовПокупателей.Закрыт
		И НЕ ДатаВыполнения = Дата(1,1,1) Тогда
		ДатаВыполнения = Дата(1,1,1);
	КонецЕсли;

		
	//НАЧАЛО: Переход на 2.0
	Если РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
		
		Если НЕ ВнутреннийЗаказ Тогда // #11831 для внутренних заказов проверки не выполняем
			Если (ТекущийСтатус = Справочники.СтатусыЗаказовПокупателей.Выполнен
				ИЛИ ТекущийСтатус = Справочники.СтатусыЗаказовПокупателей.Закрыт) Тогда
				
				Если Ссылка.Организация <> Организация ИЛИ Ссылка.Контрагент <> Контрагент Тогда
					Отказ = Истина;
					Сообщить ("Изменение организации или контрагента невозможно при текущем статусе ""Выполнен"" или ""Закрыт""");
					Возврат;
				КонецЕсли;	
				
				СтруктураВозврата = Документы.ЗаказПокупателя.ВсеТоварыПоЗаказуОтгружены(Ссылка, Товары);
				Если НЕ СтруктураВозврата.Результат Тогда
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтруктураВозврата.Описание,,,,Отказ);
					Возврат;
				КонецЕсли;
				
			КонецЕсли;
			
			Если СозданПриИспользованииСтатусаЗакрыт // №1083 переделано, раньше было ПолучитьФункциональнуюОпцию("ИспользоватьСтатусЗакрытВЗаказеПокупателя")
				И ТекущийСтатус = Справочники.СтатусыЗаказовПокупателей.Закрыт Тогда
				
				Если ПолучитьФункциональнуюОпцию("ЗапретитьПереводЗаказаВСтатусЗакрытПриНеполнойОплате") Тогда			
					Результат = РегистрыНакопления.РасчетыПоЗаказам.ЗаказОплаченПолностью(Ссылка);
					Если НЕ Результат Тогда
						ТекстОшибки = "Заказ оплачен не полностью. Настройками программы запрещен перевод в статус ""Закрыт""";
						ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки,,,,Отказ);
						Возврат;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		Если ТекущийСтатус = Справочники.СтатусыЗаказовПокупателей.Отменен Тогда		
			Если НЕ Документы.ЗаказПокупателя.ВозможенПереводВСтатусОтменен(Ссылка) Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Действие отменено.",,,,Отказ);
				Возврат;
			КонецЕсли;
		КонецЕсли;
		
		//++ №9324
		Если НЕ СозданПриИспользованииСтатусаЗакрыт И ТекущийСтатус = Справочники.СтатусыЗаказовПокупателей.Закрыт Тогда
			
			Сообщить("Запрещено переводить заказ в статус ""Закрыт"", т.к. документ создан без использования статуса ""Закрыт"".");
			Отказ = Истина;
			
		КонецЕсли;
		//-- №9324
		
		//++ №9385 установим время выполнения
		Если ТекущийСтатус = Справочники.СтатусыЗаказовПокупателей.Выполнен И НЕ Ссылка.ТекущийСтатус = Справочники.СтатусыЗаказовПокупателей.Выполнен 
			И ДатаВыполнения = Дата(1,1,1) Тогда
			ДатаВыполнения = ТекущаяДатаСеанса();
		КонецЕсли;
		//-- №9385
		
	ИначеЕсли (РежимЗаписи = РежимЗаписиДокумента.Запись И ПометкаУдаления) 
		ИЛИ РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения Тогда
		
		//проверяем отсутствие отгрузок по данному заказу
		Если Документы.ЗаказПокупателя.ЕстьРеализацииПоЗаказу(Ссылка) Тогда
			Сообщить("Действие отменено.");
			Отказ = Истина;
			Возврат;
		КонецЕсли;
		
		//проверяем отсутствие выпусков по данному заказу
		Если Документы.ЗаказПокупателя.ЕстьВыпускиПродукцииПоПотолкамЗаказа(Ссылка) Тогда
			Если НЕ ОбщийМодульСервер.НастройкаПользователя("РазрешеноПереводитьЗаказыПокупателейВСтатусОтмененПриНаличииВыпускаПотолков") Тогда
				Сообщить("Действие отменено.");
				Отказ = Истина;
				Возврат;
			КонецЕсли;
		КонецЕсли;			
		
	КонецЕсли;
	//КОНЕЦ: Переход на 2.0
	
	Если НЕ ТекущийСтатус = Справочники.СтатусыЗаказовПокупателей.Отменен Тогда
		Документы.ЗаказДоговор.ПроверитьКомнатыПоЗаказу(ЭтотОбъект, Отказ, РежимЗаписи);
	КонецЕсли;
	
	// Проверяем остатки по резервам, их быть не должно
	Если Константы.ИспользоватьРезервирование.Получить()
		И РежимЗаписи = РежимЗаписиДокумента.Проведение 
		И (ТекущийСтатус = Справочники.СтатусыЗаказовПокупателей.Выполнен
			ИЛИ ТекущийСтатус = Справочники.СтатусыЗаказовПокупателей.Закрыт) Тогда			
		
		//Запрос = новый Запрос;
		//Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		//	//++ №13386
		//	|	ТоварыВРезервеНаСкладахОстатки.Склад,
		//	//-- №13386
		//	|	ТоварыВРезервеНаСкладахОстатки.Номенклатура,
		//	|	ТоварыВРезервеНаСкладахОстатки.ХарактеристикаНоменклатуры,
		//	|	ТоварыВРезервеНаСкладахОстатки.СерияНоменклатуры,
		//	|	ЕСТЬNULL(ТоварыВРезервеНаСкладахОстатки.КоличествоОстаток, 0) КАК Количество
		//	|ИЗ
		//	|   РегистрНакопления.ТоварыВРезервеНаСкладах.Остатки(, ДокументРезерва = &ДокументРезерва) КАК ТоварыВРезервеНаСкладахОстатки";
		//Запрос.УстановитьПараметр("ДокументРезерва", Ссылка);
		//РезультатЗапроса = Запрос.Выполнить();
		
		ОстаткиПоРезервам = Документы.ЗаказПокупателя.ОстаткиПоРезервам(Ссылка);
		
		Если НЕ ОстаткиПоРезервам.Количество() = 0 Тогда
			
			Сообщить("Не удалось перевести заказ покупателя в статус """ + ТекущийСтатус +" "", т.к. по данному заказу числятся неисполненные резервы:");
			
			Для каждого Выборка из ОстаткиПоРезервам Цикл
				Сообщить(СтрШаблон("%1%2%3, склад %4, в количестве %5",
					Выборка.Номенклатура,
					?(Выборка.ХарактеристикаНоменклатуры.Пустая(), "", ", Характеристика: " + Выборка.ХарактеристикаНоменклатуры),
					?(Выборка.СерияНоменклатуры.Пустая(), "", ", Серия: " + Выборка.СерияНоменклатуры),
					Выборка.Склад,
					Выборка.Количество),
				СтатусСообщения.Важное);
			КонецЦикла;
			
			Отказ = Истина;
			
		КонецЕсли;
			
	КонецЕсли;
	
	//nva+++
	Если НЕ ЭтоНовый() И ТекущийСтатус <> Справочники.СтатусыЗаказовПокупателей.Новый Тогда
		Если НЕ Документы.ЗаказПокупателя.ЕстьЗаказныеПозицииИСозданЗаказПоставщику(Ссылка, Товары) Тогда
			Сообщить("Действие отменено.");
			Отказ = Истина;
			Возврат;
		КонецЕсли;
	КонецЕсли;
	//nva---	
	
	Если НЕ ЭтоНовый() Тогда
		ДополнительныеСвойства.Вставить("ПредыдущийСтатус", Ссылка.ТекущийСтатус);
		ДополнительныеСвойства.Вставить("ПредыдущийСборщик", Ссылка.Сборщик);
		ДополнительныеСвойства.Вставить("ПредыдущийСтатусСборки", Ссылка.СтатусСборки);
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, Режим)
	
	//проверки
	ПроверятьЗаполнениеЦен = Истина;
	//ПроверятьЗаполнениеКонтрагента = Истина;
	
	ОднаОрганизацияПроизводстваИПродажиПотолков = Ложь;
	Если НЕ НастройкаИнтеркампани.Пустая() И ЭтоЗаказОтРозницы Тогда
		ОднаОрганизацияПроизводстваИПродажиПотолков = НастройкаИнтеркампани.ОднаОрганизацияПроизводстваИПродажиПотолков;
		ПроверятьЗаполнениеЦен 			= НЕ ОднаОрганизацияПроизводстваИПродажиПотолков;
		//ПроверятьЗаполнениеКонтрагента 	= НЕ ОднаОрганизацияПроизводстваИПродажиПотолков; 
		//Если НастройкаИнтеркампани.НеУчитыватьСтоимостьВЗаказахНаПроизводство Тогда
		//	ПроверятьЗаполнениеЦен = Ложь;
		//КонецЕсли;
	КонецЕсли;
	
	//#7806
	Если ВнутреннийЗаказ Тогда
		//Если ПроверятьЗаполнениеКонтрагента И НЕ Константы.ОтображатьКонтрагентаВоВнутреннихЗаказах.Получить() Тогда
		//	ПроверятьЗаполнениеКонтрагента = Ложь;
		//КонецЕсли;
		Если ПроверятьЗаполнениеЦен И НЕ Константы.ОтображатьЦеныВоВнутреннихЗаказах.Получить() Тогда
			ПроверятьЗаполнениеЦен = Ложь;
		КонецЕсли;
	КонецЕсли;
	
	//проверим заполнение контрагента
	//Если ПроверятьЗаполнениеКонтрагента И Контрагент.Пустая() Тогда
	//	ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не заполнен контрагент", ЭтотОбъект, "Контрагент", , Отказ);		
	//КонецЕсли;
		
	Если ПроверятьЗаполнениеЦен Тогда
		Для каждого ТекущаяСтрока из Товары Цикл
			СтруктураПараметров = Новый Структура("Ссылка, ТабличнаяЧасть, ИмяТабличнойЧасти, НомерСтроки", ЭтотОбъект, "Товары", "Товары", ТекущаяСтрока.НомерСтроки);
			ОбработкаТабличныхЧастейСервер.ПроверитьЦенуСтроки(ТекущаяСтрока, СтруктураПараметров, Отказ);
		КонецЦикла;
	КонецЕсли; 	
		
	Если Отказ Тогда
		//Сообщить("Документ не проведен");
		Возврат;
	КонецЕсли;
	
	//nva+++
	//делаем резерв на все товары в заказе 
	ВТ_Товары = Товары.ВыгрузитьКолонки();
	Для Каждого ТекущаяСтрока Из Товары Цикл
		Если ТекущаяСтрока.Номенклатура.ВидНоменклатуры <> Справочники.ВидыНоменклатуры.Материал Тогда
			Продолжить;
		КонецЕсли;	
		НоваяСтрока = ВТ_Товары.Добавить();
		НоваяСтрока.Количество = ТекущаяСтрока.Количество * ТекущаяСтрока.Коэффициент;
		НоваяСтрока.ЕдиницаИзмерения =  ТекущаяСтрока.Номенклатура.БазоваяЕдиницаИзмерения; 
		НоваяСтрока.Коэффициент =  1;
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущаяСтрока, "Номенклатура, ХарактеристикаНоменклатуры, СерияНоменклатуры");
	КонецЦикла;
	ВТ_Товары.Свернуть("Номенклатура, ХарактеристикаНоменклатуры, СерияНоменклатуры, ЕдиницаИзмерения, Коэффициент", "Количество"); 
	ОбработкаРезервированияЗаказаПокупателя(Ссылка, ВТ_Товары);
	
	//Если изменилась сумма доставки в ТЧ, то меняем сумма в заявке на доставку
	СуммаДоставки = 0;
	Для Каждого ТекущаяСтрока Из Товары Цикл
		Если ТекущаяСтрока.Номенклатура = Справочники.Номенклатура.Доставка Тогда
			СуммаДоставки = СуммаДоставки + ТекущаяСтрока.Сумма;
		КонецЕсли;
	КонецЦикла;
	ИзменитьСуммуДоставкиВЗаявкеНаДоставку(Ссылка, СуммаДоставки);
	//nva---
	
	//При проведении в статусе "Отменен" документ не делает никаких движений по регистрам.
	Если ТекущийСтатус = Справочники.СтатусыЗаказовПокупателей.Отменен Тогда // Добавлено условие если заказ отменен
		Возврат;
	КонецЕсли;
	
	
	Если РегистрыНакопления.ОбеспечениеЗаказовРозницы.ТребуетсяЗаписьПоОснованию(Основание)
		И ( ТекущийСтатус = Справочники.СтатусыЗаказовПокупателей.Новый
		ИЛИ ТекущийСтатус = Справочники.СтатусыЗаказовПокупателей.Выполнен
		ИЛИ ТекущийСтатус = Справочники.СтатусыЗаказовПокупателей.Закрыт
		ИЛИ ТекущийСтатус = Справочники.СтатусыЗаказовПокупателей.ВРаботе) Тогда 
		Движения.ОбеспечениеЗаказовРозницы.Записывать = Истина;
		Для Каждого ТекущаяСтрока Из Товары Цикл
			Если (НЕ ЗначениеЗаполнено(ТекущаяСтрока.Комната) И СозданПриИспользованииНастройкиУчетОбеспеченностиРозницыПоКомнатам)
				ИЛИ НЕ ЗначениеЗаполнено(ТекущаяСтрока.Назначение)
				ИЛИ НЕ ЗначениеЗаполнено(ТекущаяСтрока.Номенклатура) 
				ИЛИ (ЗначениеЗаполнено(ТекущаяСтрока.Потолок) И НЕ ТекущаяСтрока.Номенклатура = ТекущаяСтрока.Потолок) // расщепленная в процессе загрузки потолка строка, которой нет в заказ-договоре
				Тогда
				Продолжить;
			КонецЕсли;
			
			Движение = Движения.ОбеспечениеЗаказовРозницы.Добавить();
			Движение.Заказ = Основание;
			Движение.Период = Дата;
			Движение.Номенклатура = ТекущаяСтрока.Номенклатура;
			//++ #15731
			Движение.ХарактеристикаНоменклатуры = ТекущаяСтрока.ХарактеристикаНоменклатуры;
			//-- #15731
			Движение.Комната = ТекущаяСтрока.Комната;
			Движение.Назначение = ТекущаяСтрока.Назначение;
			Движение.Количество = ТекущаяСтрока.Количество;
			Движение.КоличествоПоФакту = ТекущаяСтрока.Количество;
			//#4679
			Если Справочники.ВидыНоменклатуры.ЭтоНоменклатураПотолкаИлиОтреза(ТекущаяСтрока.Номенклатура) Тогда 
				Движение.Количество = 1;
			КонецЕсли;
		КонецЦикла;		
	КонецЕсли;
	
	
	//ДВИЖЕНИЯ
	//заказы покупателей
	//для товаров таблицу нужно свернуть
	ВремТаблицаТовары = Товары.ВыгрузитьКолонки();
	Для Каждого ТекущаяСтрока Из Товары Цикл
		НоваяСтрока = ВремТаблицаТовары.Добавить();
		НоваяСтрока.Количество = ТекущаяСтрока.Количество * ТекущаяСтрока.Коэффициент;
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущаяСтрока, "Номенклатура, ХарактеристикаНоменклатуры, СерияНоменклатуры, Сумма");
	КонецЦикла;
	ВремТаблицаТовары.Свернуть("Номенклатура, ХарактеристикаНоменклатуры, СерияНоменклатуры", "Количество, Сумма"); 
	
	Движения.ЗаказыПокупателей.Записывать = Истина;
	Для Каждого ТекущаяСтрока Из ВремТаблицаТовары Цикл
		Движение = Движения.ЗаказыПокупателей.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
		Движение.Период = Дата;
		Движение.ЗаказНаПроизводство = Ссылка;
		Движение.Организация = Организация;
		Движение.Контрагент = Контрагент;
		Движение.Номенклатура = ТекущаяСтрока.Номенклатура;
		Движение.ХарактеристикаНоменклатуры = ТекущаяСтрока.ХарактеристикаНоменклатуры;
		Движение.СерияНоменклатуры = ТекущаяСтрока.СерияНоменклатуры;
		Движение.Количество = ТекущаяСтрока.Количество;
		Движение.Сумма = ТекущаяСтрока.Сумма; //#9777
	КонецЦикла;
	Если (ОднаОрганизацияПроизводстваИПродажиПотолков ИЛИ ВнутреннийЗаказ)
		И (ТекущийСтатус = Справочники.СтатусыЗаказовПокупателей.Выполнен ИЛИ ТекущийСтатус = Справочники.СтатусыЗаказовПокупателей.Закрыт) Тогда  
		// если ОднаОрганизацияПроизводстваИПродажиПотолков ИЛИ ВнутреннийЗаказ, то РТиУ не будет, делаем и расход
		Движения.ЗаказыПокупателей.Записывать = Истина;
		Для Каждого ТекущаяСтрока Из ВремТаблицаТовары Цикл
			Движение = Движения.ЗаказыПокупателей.Добавить();
			Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
			Движение.Период = Дата;
			Движение.ЗаказНаПроизводство = Ссылка;
			Движение.Организация = Организация;
			Движение.Контрагент = Контрагент;			
			Движение.Номенклатура = ТекущаяСтрока.Номенклатура;
			Движение.ХарактеристикаНоменклатуры = ТекущаяСтрока.ХарактеристикаНоменклатуры;
			Движение.СерияНоменклатуры = ТекущаяСтрока.СерияНоменклатуры;
			Движение.Количество = ТекущаяСтрока.Количество;
			Движение.Сумма = ТекущаяСтрока.Сумма; //#9777
		КонецЦикла;
	КонецЕсли;
	
	//расчеты по заказам
	Если Константы.ВестиРасчетыПоЗаказамПоЗаказуПокупателя.Получить() И СуммаДокумента <> 0 Тогда
		Движения.РасчетыПоЗаказам.Записывать = Истина;
		Движение = Движения.РасчетыПоЗаказам.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
		Движение.Период = Дата;
		Движение.Заказ = Ссылка;
		Движение.Сумма = СуммаДокумента;
		Движение.Контрагент = Контрагент; // №6496 добавлен контрагент в измерение
	КонецЕсли;	
	
		
	// №1083 добавлено условие начисления от статуса
	// #9426 выработка по заказу покупателя должна начисляться в ситуациях:
	// 1. признак "Создан при использовании статуса "Закрыт"" = Истина, значит выработка начисляется только в статусе "Закрыт"
	// 2. признак "Создан при использовании статуса "Закрыт"" = Ложь, значит выработка начисляется как в статусе "Выполнен", так и в статусе "Закрыт".
	//Если (СозданПриИспользованииСтатусаЗакрыт И ТекущийСтатус = Справочники.СтатусыЗаказовПокупателей.Закрыт)
	Если (ТекущийСтатус = Справочники.СтатусыЗаказовПокупателей.Закрыт)
		ИЛИ (НЕ СозданПриИспользованииСтатусаЗакрыт И ТекущийСтатус = Справочники.СтатусыЗаказовПокупателей.Выполнен)
	Тогда
	
		//начисление выработки
		Если 
			//ПолучитьФункциональнуюОпцию("ИспользоватьСтатусЗакрытВЗаказеПокупателя") // №1083 переделано на СозданПриИспользованииСтатусаЗакрыт		
			СозданПриИспользованииСтатусаЗакрыт	И ТекущийСтатус = Справочники.СтатусыЗаказовПокупателей.Закрыт Тогда
			ДатаВыработки = ДатаЗакрытия; //Расчёт по дате закрытия
		Иначе
			ДатаВыработки = ДатаВыполнения; // №9385 если не используется статус закрыт, выработка на дату выполнения
		КонецЕсли;
		
		//если нет даты, то проводить нельзя
		Если ДатаВыработки = Дата(1,1,1) Тогда
			Отказ = Истина;
			Сообщить("Не определена дата начисления выработки. Укажите дату выполнения или дату закрытия заказа!");
			Возврат;
		КонецЕсли;
		
		Движения.ВыработкаИсполнителейПроизводства.Записывать = Истина;
		Движения.ВыработкаИсполнителейРозницы.Записывать = Истина;
		
		Если РучнаяКорректировкаВыработки Тогда // №1083 теперь доступно ручное изменение зарплаты
			НаборЗаписейПоВыработке = Выработка.Выгрузить();
			ДополнитьТаблицуВыработки(НаборЗаписейПоВыработке, ДатаВыработки);
		Иначе	
			НаборЗаписейПоВыработке = Зарплата.РассчитатьВыработкуПоДокументу(Ссылка, ДатаВыработки);
		КонецЕсли;
		
		РегистрВыработки = ?(ЭтоЗаказОтРозницы, Движения.ВыработкаИсполнителейРозницы, Движения.ВыработкаИсполнителейПроизводства); 
		Для Каждого СтрокаВыработки Из НаборЗаписейПоВыработке Цикл
			Движение = РегистрВыработки.Добавить();
			ЗаполнитьЗначенияСвойств(Движение, СтрокаВыработки);
		КонецЦикла;			
		
	КонецЕсли;	
	
	//++ №13299 Бонусы контрагентов
	Если СлужебныйВидБонуснойСистемы = Перечисления.ВидыБонусныхСистем.Внутренняя Тогда
		Движения.БонусыКонтрагентов.Записывать = Истина;
		
		Если ТекущийСтатус = Справочники.СтатусыЗаказовПокупателей.ВРаботе
			Или ТекущийСтатус = Справочники.СтатусыЗаказовПокупателей.Выполнен
			Или ТекущийСтатус = Справочники.СтатусыЗаказовПокупателей.Закрыт Тогда
			
			//++ на будущее
			//Если НачислятьБонусы 
			//	И ?(СлужебныйУчетБонусовПоДисконтнымКартам, НЕ ДисконтнаяКарта.Пустая(), Истина)
			//	И НЕ СуммаБонусовКНачислениюПоДисконтнойКарте = 0 Тогда
			//	
			//	Движение = Движения.БонусыКонтрагентов.Добавить();
			//	Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
			//	Движение.Период = Дата;
			//	Движение.Контрагент = Контрагент;
			//	Движение.ДисконтнаяКарта = ДисконтнаяКарта;
			//	Движение.Сумма = СуммаБонусовКНачислениюПоДисконтнойКарте;
			//	
			//КонецЕсли;
			//-- на будущее
			
			Если СписыватьБонусы
				И НЕ СуммаБонусовКСписаниюПоДисконтнойКарте = 0
				И ?(СлужебныйУчетБонусовПоДисконтнымКартам, НЕ ДисконтнаяКарта.Пустая(), Истина) Тогда
				
				Если НЕ РегистрыНакопления.БонусыКонтрагентов.КонтрольОстатков(Ссылка, Контрагент, ДисконтнаяКарта, СуммаБонусовКСписаниюПоДисконтнойКарте) Тогда
					Отказ = Истина;
					Возврат;
				КонецЕсли;
				
				Движение = Движения.БонусыКонтрагентов.Добавить();
				Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
				Движение.Период = Дата;
				Движение.Контрагент = Контрагент;
				Движение.ДисконтнаяКарта = ДисконтнаяКарта;
				Движение.Сумма = СуммаБонусовКСписаниюПоДисконтнойКарте;
				
			КонецЕсли;
			
		КонецЕсли;
	КонецЕсли;
	//-- №13299 Бонусы контрагентов

КонецПроцедуры

Процедура ДополнитьТаблицуВыработки(ТаблицаПоВыработке, ДатаВыработки)
	
	ТаблицаПоВыработке.Колонки.Добавить("Период");
	ТаблицаПоВыработке.Колонки.Добавить("Регистратор");
	ТаблицаПоВыработке.Колонки.Добавить("ОбъектВыработки");
	ТаблицаПоВыработке.Колонки.Добавить("Подразделение");
	
	ТаблицаПоВыработке.ЗаполнитьЗначения(ДатаВыработки, "Период");
	ТаблицаПоВыработке.ЗаполнитьЗначения(Ссылка, "Регистратор");
	ТаблицаПоВыработке.ЗаполнитьЗначения(Ссылка, "ОбъектВыработки");
	ТаблицаПоВыработке.ЗаполнитьЗначения(Подразделение, "Подразделение");
	
КонецПроцедуры

