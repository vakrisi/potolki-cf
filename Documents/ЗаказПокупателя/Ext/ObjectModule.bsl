Процедура ИнициализироватьСлужебныеРеквизиты()
	
	ТекущийСтатус = Справочники.СтатусыЗаказовПокупателей.НачальныйСтатус();
	
	// №1083
	СозданПриИспользованииСтатусаЗакрыт = Константы.ИспользоватьСтатусЗакрытВЗаказеПокупателя.Получить();
	
	//++ №13299
	Если ПолучитьФункциональнуюОпцию("УчетБонусов") Тогда
		
		СлужебныйУчитыватьБонусы 				= Константы.УчитыватьБонусы.Получить();
		СлужебныйУчетБонусовПоДисконтнымКартам 	= Константы.УчетБонусовПоДисконтнымКартам.Получить();
		СлужебныйВидБонуснойСистемы 			= Константы.ВидБонуснойСистемы.Получить();
		
		СписыватьБонусы = Константы.СписыватьБонусыПоДокументуЗаказПокупателя.Получить();
		
		//++ на будущее
		//НачислятьБонусы
		//НачислятьБонусыПоДисконтнойКартеПриЗачетеБонусовКакСкидку
		//-- на будущее
		
	Иначе
		СлужебныйУчитыватьБонусы = Ложь;
		СлужебныйУчетБонусовПоДисконтнымКартам = Ложь;
		СписыватьБонусы = Ложь;
	КонецЕсли;
	//-- №13299
	
	ДисконтнаяКарта = Справочники.ДисконтныеКарты.ПустаяСсылка();
	СуммаБонусовКНачислениюПоДисконтнойКарте = 0;
	СуммаБонусовКСписаниюПоДисконтнойКарте	 = 0;
		
	//#14675
	СозданПриИспользованииНастройкиУчетОбеспеченностиРозницыПоКомнатам  = Константы.УчетОбеспеченностиРозницыПоКомнатам.Получить();
	
	//#14828
	СозданПриИспользованииПодразделений  = Константы.ИспользоватьПодразделения.Получить();
	
	ДополнительныеСвойства.Вставить("ДатаСоздания", ТекущаяДатаСеанса());
	 
КонецПроцедуры

Процедура ДозаполнитьПоУмолчанию()
	
	РеквизитыПользователя = ОбщийМодульСервер.НастройкиПользователя("Склад, СкладМатериалов");
	
	// #14947 изменено	
	//Если Константы.СкладОтгрузкиПотолоковОтличаетсяОтСкладаГотовойПродукции.Получить() Тогда
	//	Склад = ПараметрыСеанса.ТекущийПользователь.СкладОтгрузки;		
	//Иначе
	//	Склад = ПараметрыСеанса.ТекущийПользователь.Склад;
	//КонецЕсли;
	Склад = РеквизитыПользователя.Склад;
	
	СкладМатериалов = РеквизитыПользователя.СкладМатериалов;
	Если СкладМатериалов.Пустая() Тогда
		СкладМатериалов = Склад;
	КонецЕсли;
		
	Если Константы.СпособЗаполненияМенеджераВЗаказеПокупателя.Получить() = Перечисления.ВариантыЗаполненияМенеджера.ЗаполнятьСотрудникомПользователя 
		И ЗначениеЗаполнено(Автор) Тогда
		Менеджер = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Автор, "Сотрудник");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Контрагент) Тогда
		КатегорияКонтрагента = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Контрагент, "Категория");
		Если ЗначениеЗаполнено(КатегорияКонтрагента) Тогда
			ВидСкидки = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(КатегорияКонтрагента, "ВидСкидки");
		КонецЕсли;
	КонецЕсли;
	
	СтавкаНДС = УчетНДС.СтавкаНДСПоУмолчанию(Организация);
	
КонецПроцедуры

#КонецОбласти

