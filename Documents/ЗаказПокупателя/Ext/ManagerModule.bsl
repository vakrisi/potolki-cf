// Определяет список команд создания на основании.
//
// Параметры:
//   КомандыСозданияНаОсновании - ТаблицаЗначений - Таблица с командами создания на основании. Для изменения.
//       См. описание 1 параметра процедуры СозданиеНаОснованииПереопределяемый.ПередДобавлениемКомандСозданияНаОсновании().
//   Параметры - Структура - Вспомогательные параметры. Для чтения.
//       См. описание 2 параметра процедуры СозданиеНаОснованииПереопределяемый.ПередДобавлениемКомандСозданияНаОсновании().
//
Процедура ДобавитьКомандыСозданияНаОсновании(КомандыСозданияНаОсновании, Параметры) Экспорт
	
	Документы.ВозвратПродукции.ДобавитьКомандуСоздатьНаОснованииЗаказаПокупателя(КомандыСозданияНаОсновании);
	
	Документы.ВозвратТовараОтПокупателя.ДобавитьКомандуСоздатьНаОсновании(КомандыСозданияНаОсновании);
	
	БизнесПроцессы.Задание.ДобавитьКомандуСоздатьНаОсновании(КомандыСозданияНаОсновании);
	
	Документы.ЗаказНаПроизводство.ДобавитьКомандуСоздатьНаОснованииЗаказаПокупателя(КомандыСозданияНаОсновании);
	
	Документы.ЗаказПоставщику.ДобавитьКомандуСоздатьНаОсновании(КомандыСозданияНаОсновании);
	
	Документы.ЗаявкаНаДоставку.ДобавитьКомандуСоздатьНаОсновании(КомандыСозданияНаОсновании);

	Документы.ЗаявкаНаРасходованиеДенежныхСредств.ДобавитьКомандуСоздатьНаОсновании(КомандыСозданияНаОсновании);
		
	Документы.НачислениеЗарплаты.ДобавитьКомандуСоздатьНаОсновании(КомандыСозданияНаОсновании);
	
	Документы.ОплатаБанковскойКартой.ДобавитьКомандуСоздатьНаОснованииМножественныйВыбор(КомандыСозданияНаОсновании);
	Документы.ОплатаБанковскойКартой.ДобавитьКомандуСоздатьНаОснованииОплатаКредитомМножественныйВыбор(КомандыСозданияНаОсновании);
	
	Документы.ОтправкаСМС.ДобавитьКомандуСоздатьНаОсновании(КомандыСозданияНаОсновании);
	
	Документы.ПеремещениеТоваров.ДобавитьКомандуСоздатьНаОсновании(КомандыСозданияНаОсновании);
	
	Документы.ПлатежноеПоручениеИсходящее.ДобавитьКомандуСоздатьНаОсновании(КомандыСозданияНаОсновании);
	
	Документы.ПоступлениеНаРасчетныйСчет.ДобавитьКомандуСоздатьНаОснованииМножественныйВыбор(КомандыСозданияНаОсновании);
	
	Документы.ПоступлениеТоваровИУслуг.ДобавитьКомандуСоздатьНаОсновании(КомандыСозданияНаОсновании);
	
	Документы.ПриходныйКассовыйОрдер.ДобавитьКомандуСоздатьНаОснованииМножественныйВыбор(КомандыСозданияНаОсновании);
	
	Документы.РасходныйКассовыйОрдер.ДобавитьКомандуСоздатьНаОсновании(КомандыСозданияНаОсновании);
	
	Документы.РеализацияТоваровИУслуг.ДобавитьКомандуСоздатьНаОснованииЗаказаПокупателя(КомандыСозданияНаОсновании);
	
	Документы.Резервирование.ДобавитьКомандуСоздатьНаОсновании(КомандыСозданияНаОсновании);
	
	Документы.СнятиеРезервов.ДобавитьКомандуСоздатьНаОснованииМножественныйВыбор(КомандыСозданияНаОсновании);
	
	Документы.СписаниеСРасчетногоСчета.ДобавитьКомандуСоздатьНаОсновании(КомандыСозданияНаОсновании);
	
	Документы.СчетНаОплату.ДобавитьКомандуСоздатьНаОснованииМножественныйВыбор(КомандыСозданияНаОсновании);  
	
	Документы.Штраф.ДобавитьКомандуСоздатьНаОсновании(КомандыСозданияНаОсновании);
	
КонецПроцедуры

// Добавляет команду создания документа "Заказ покупателя".
//
// Параметры:
//   КомандыСозданияНаОсновании - ТаблицаЗначений - Таблица с командами создания на основании. Для изменения.
//       См. описание 1 параметра процедуры СозданиеНаОснованииПереопределяемый.ПередДобавлениемКомандСозданияНаОсновании().
//
Функция ДобавитьКомандуСоздатьНаОсновании(КомандыСозданияНаОсновании) Экспорт
	Если ПравоДоступа("Добавление", Метаданные.Документы.ЗаказПокупателя) Тогда
		КомандаСоздатьНаОсновании = КомандыСозданияНаОсновании.Добавить();
		КомандаСоздатьНаОсновании.Менеджер = Метаданные.Документы.ЗаказПокупателя.ПолноеИмя();
		КомандаСоздатьНаОсновании.Представление = Метаданные.Документы.ЗаказПокупателя.Представление();
		КомандаСоздатьНаОсновании.РежимЗаписи = "Проводить";
		
		Возврат КомандаСоздатьНаОсновании;
	КонецЕсли;

	Возврат Неопределено;
КонецФункции

// Добавляет команду создания документа "Заказ покупателя" для документов "Заказ-договор" и "Монтаж".
//
// Параметры:
//   КомандыСозданияНаОсновании - ТаблицаЗначений - Таблица с командами создания на основании. Для изменения.
//       См. описание 1 параметра процедуры СозданиеНаОснованииПереопределяемый.ПередДобавлениемКомандСозданияНаОсновании().
//
Функция ДобавитьКомандуСоздатьНаОснованииДляДокументаРозницы(КомандыСозданияНаОсновании, ФункциональныеОпции="") Экспорт
	Если ПравоДоступа("Добавление", Метаданные.Документы.ЗаказПокупателя) Тогда
		КомандаСоздатьНаОсновании = КомандыСозданияНаОсновании.Добавить();
		КомандаСоздатьНаОсновании.Обработчик = "СозданиеНаОснованииПотолкиКлиент.ЗаказПокупателяСоздатьНаОснованииДокументаРозницы";
		КомандаСоздатьНаОсновании.Представление = "Заказ покупателя (на производство)"; //Метаданные.Документы.ЗаказПокупателя.Представление();
		КомандаСоздатьНаОсновании.РежимЗаписи = "Проводить";		
		КомандаСоздатьНаОсновании.МножественныйВыбор = Ложь;
		КомандаСоздатьНаОсновании.ФункциональныеОпции = ФункциональныеОпции;
		КомандаСоздатьНаОсновании.ВидимостьВФормах = "ФормаДокумента"; // !!! не отображаем в форме списка
		
		Возврат КомандаСоздатьНаОсновании;
		
	КонецЕсли;
	
	Возврат Неопределено;
КонецФункции

#КонецОбласти

#Область ПроверкиВводаНаОсновании

Процедура ПроверитьВозможностьВводаНаОснованииЗаказа(МассивЗаказов, Знач ИсключитьПроверкуСтатусаНовый = Ложь, ТипСоздаваемогоДокумента="") Экспорт
	
	МассивДокументов = Новый Массив;
	Если НЕ ТипЗнч(МассивЗаказов) = Тип("Массив") Тогда
		МассивДокументов.Добавить(МассивЗаказов);
	Иначе
		МассивДокументов = МассивЗаказов;
	КонецЕсли;
	
	Если ТипСоздаваемогоДокумента = "ЗаказНаПроизводство" Тогда
		ИсключитьПроверкуСтатусаНовый = Истина;
	КонецЕсли;
	
	Для каждого ДокументЗаказ из МассивДокументов Цикл
		Если НЕ ТипЗнч(ДокументЗаказ) = Тип("ДокументСсылка.ЗаказПокупателя") Тогда
			Продолжить;
		КонецЕсли;
		
		Если НЕ ДокументЗаказ.Проведен Тогда				
			ТекстОшибки = НСтр("ru='Документ %Документ% не проведен. Ввод на основании разрешен только в проведенном состоянии'");
			ТекстОшибки = СтрЗаменить(ТекстОшибки, "%Документ%", ДокументЗаказ);	
			ВызватьИсключение ТекстОшибки;
		КонецЕсли;
		
		Если ДокументЗаказ.ТекущийСтатус = Справочники.СтатусыЗаказовПокупателей.Новый И НЕ ИсключитьПроверкуСтатусаНовый Тогда				
			ТекстОшибки = НСтр("ru='Документ %Документ% находится в статусе ""%Статус%"". Ввод на основании в текущем статусе не разрешен'");
			ТекстОшибки = СтрЗаменить(ТекстОшибки, "%Документ%", ДокументЗаказ);
			ТекстОшибки = СтрЗаменить(ТекстОшибки, "%Статус%",   ДокументЗаказ.ТекущийСтатус);	
			ВызватьИсключение ТекстОшибки;
		КонецЕсли;
		
		//Если ДокументЗаказ.ТекущийСтатус = Справочники.СтатусыЗаказовПокупателей.Отменен Тогда				
		//	ТекстОшибки = НСтр("ru='Документ %Документ% находится в статусе ""%Статус%"". Ввод на основании в текущем статусе не разрешен'");
		//	ТекстОшибки = СтрЗаменить(ТекстОшибки, "%Документ%", ДокументЗаказ);
		//	ТекстОшибки = СтрЗаменить(ТекстОшибки, "%Статус%",   ДокументЗаказ.ТекущийСтатус);	
		//	ВызватьИсключение ТекстОшибки;
		//КонецЕсли;
		
		Если ТипСоздаваемогоДокумента = "ЗаказНаПроизводство" Тогда
			Если НЕ ДокументЗаказ.ТекущийСтатус = Справочники.СтатусыЗаказовПокупателей.ВРаботе Тогда				
				ТекстОшибки = НСтр("ru='Документ %Документ% находится в статусе ""%Статус%"". Ввод на основании в текущем статусе не разрешен'");
				ТекстОшибки = СтрЗаменить(ТекстОшибки, "%Документ%", ДокументЗаказ);
				ТекстОшибки = СтрЗаменить(ТекстОшибки, "%Статус%",   ДокументЗаказ.ТекущийСтатус);	
				ВызватьИсключение ТекстОшибки;
			КонецЕсли;
			
		ИначеЕсли ТипСоздаваемогоДокумента = "Реализация" Тогда
			Если ЗначениеЗаполнено(ДокументЗаказ.НастройкаИнтеркампани) Тогда
				Если ДокументЗаказ.НастройкаИнтеркампани.ОднаОрганизацияПроизводстваИПродажиПотолков Тогда
					ТекстОшибки = НСтр("ru='Документ %Документ% с настройкой интеркампани с одной организацией производства и продажи. Ввод реализации не требуется'");
					ТекстОшибки = СтрЗаменить(ТекстОшибки, "%Документ%", ДокументЗаказ);	
					ВызватьИсключение ТекстОшибки;
				КонецЕсли;
			КонецЕсли;
			//#7806
			Если ДокументЗаказ.ВнутреннийЗаказ Тогда
				ТекстОшибки = НСтр("ru='Документ %Документ% является внутренним заказом. Ввод реализации не требуется'");
				ТекстОшибки = СтрЗаменить(ТекстОшибки, "%Документ%", ДокументЗаказ);	
				ВызватьИсключение ТекстОшибки;
			КонецЕсли;
			
			
		ИначеЕсли ТипСоздаваемогоДокумента = "Резервирование" Тогда
			Если ЗначениеЗаполнено(ДокументЗаказ.НастройкаИнтеркампани) Тогда
				Если ДокументЗаказ.НастройкаИнтеркампани.ОднаОрганизацияПроизводстваИПродажиПотолков Тогда
					ТекстОшибки = НСтр("ru='Документ %Документ% с настройкой интеркампани с одной организацией производства и продажи. Ввод резервирования не требуется'");
					ТекстОшибки = СтрЗаменить(ТекстОшибки, "%Документ%", ДокументЗаказ);	
					ВызватьИсключение ТекстОшибки;
				КонецЕсли;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ПроверитьЗаполнениеНаОснованииЗаказа(ДокументОбъект, Отказ, РежимЗаписи, ТипДокументаСтрокой="") Экспорт
	
	ДокументЗаказ = Неопределено;
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ДокументОбъект, "Основание") Тогда
		ДокументЗаказ = ДокументОбъект.Основание;
	ИначеЕсли ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ДокументОбъект, "ДокументОснование") Тогда
		ДокументЗаказ = ДокументОбъект.ДокументОснование;
	ИначеЕсли ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ДокументОбъект, "ЗаказПокупателя") Тогда
		ДокументЗаказ = ДокументОбъект.ЗаказПокупателя;
	КонецЕсли;	
	
	Если РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
		//проверка по основанию
		Если ТипЗнч(ДокументЗаказ) = Тип("ДокументСсылка.ЗаказПокупателя") 
			И ЗначениеЗаполнено(ДокументЗаказ) Тогда			
			Если НЕ ДокументЗаказ.Проведен Тогда				
				ТекстОшибки = НСтр("ru='Документ %Документ% не проведен. Ввод на основании разрешен только в проведенном состоянии'");
				ТекстОшибки = СтрЗаменить(ТекстОшибки, "%Документ%", ДокументЗаказ);	
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки, ДокументОбъект, , , Отказ);
			КонецЕсли;
			
			//Если ДокументЗаказ.ТекущийСтатус = Справочники.СтатусыЗаказовПокупателей.Отменен Тогда				
			//	ТекстОшибки = НСтр("ru='Документ %Документ% находится в статусе ""%Статус%"". Ввод на основании в текущем статусе не разрешен'");
			//	ТекстОшибки = СтрЗаменить(ТекстОшибки, "%Документ%", ДокументЗаказ);
			//	ТекстОшибки = СтрЗаменить(ТекстОшибки, "%Статус%",   ДокументЗаказ.ТекущийСтатус);	
			//	ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки, ДокументОбъект, , , Отказ);
			//КонецЕсли;
			
			Если ТипДокументаСтрокой = "Резервирование" И ЗначениеЗаполнено(ДокументЗаказ.НастройкаИнтеркампани) Тогда
				Если ДокументЗаказ.НастройкаИнтеркампани.ОднаОрганизацияПроизводстваИПродажиПотолков Тогда
					ТекстОшибки = НСтр("ru='Документ %Документ% с настройкой интеркампани с одной организацией производства и продажи. Ввод резервирования не требуется'");
					ТекстОшибки = СтрЗаменить(ТекстОшибки, "%Документ%", ДокументЗаказ);	
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки, ДокументОбъект, , , Отказ);
				КонецЕсли;
			КонецЕсли;
			
		КонецЕсли;
		
		// по табличной части
		ТЧОснования = Неопределено;
		Если ОбщийМодуль.ЕстьРеквизитТабЧастиОбъекта("Основание", ДокументОбъект.Метаданные(), "Основания") Тогда
			ТЧОснования = ДокументОбъект.Основания;
			ИмяРеквизитаОснования = "Основание";
		КонецЕсли;
		Если ОбщийМодуль.ЕстьРеквизитТабЧастиОбъекта("Документ", ДокументОбъект.Метаданные(), "ДокументыОснования") Тогда
			ТЧОснования = ДокументОбъект.ДокументыОснования;
			ИмяРеквизитаОснования = "Документ";
		КонецЕсли;
		Если ОбщийМодуль.ЕстьРеквизитТабЧастиОбъекта("Документ", ДокументОбъект.Метаданные(), "РаспределениеПлатежа") Тогда
			ТЧОснования = ДокументОбъект.РаспределениеПлатежа;
			ИмяРеквизитаОснования = "Документ";
		КонецЕсли;
		
		Если НЕ ТЧОснования = Неопределено Тогда
			Для каждого ДокументОснование из ТЧОснования Цикл
				ДокументЗаказОснование = ДокументОснование[ИмяРеквизитаОснования];
				
				Если ТипЗнч(ДокументЗаказОснование) = Тип("ДокументСсылка.ЗаказПокупателя") 
					И ЗначениеЗаполнено(ДокументЗаказОснование) Тогда
					
					Если НЕ ДокументЗаказОснование.Проведен Тогда				
						ТекстОшибки = НСтр("ru='Документ %Документ% не проведен. Ввод на основании разрешен только в проведенном состоянии'");
						ТекстОшибки = СтрЗаменить(ТекстОшибки, "%Документ%", ДокументЗаказОснование);	
						ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки, ДокументОбъект, , , Отказ);
					КонецЕсли;
					
					//Если ДокументЗаказОснование.ТекущийСтатус = Справочники.СтатусыЗаказовПокупателей.Отменен Тогда				
					//	ТекстОшибки = НСтр("ru='Документ %Документ% находится в статусе ""%Статус%"". Ввод на основании в текущем статусе не разрешен'");
					//	ТекстОшибки = СтрЗаменить(ТекстОшибки, "%Документ%", ДокументЗаказОснование);
					//	ТекстОшибки = СтрЗаменить(ТекстОшибки, "%Статус%",   ДокументЗаказОснование.ТекущийСтатус);	
					//	ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки, ДокументОбъект, , , Отказ);
					//КонецЕсли;
					
				КонецЕсли;			
			КонецЦикла;				
		КонецЕсли;		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеФункцииИПроцедуры

Функция ПодготовитьСписокТоваровДляВыбораПользователемКПроизводству(СсылкаНаОбъект) Экспорт
	
	// №14932 ЗаказыватьТовары = Константы.ЗаказыватьТоварыПриОформленииЗаказаНаПроизводствоНаОснованииЗаказаПокупателя.Получить();
	
	РезультатыПараметры = Новый Структура("СписокПотолков, СписокУслуг, СписокМатериалов, НастройкаИнтеркампани");
	
	СписокПотолков   = Новый Массив;
	СписокУслуг      = Новый Массив;
	СписокМатериалов = Новый Массив;
	СписокТоваров = Новый Массив;
	
	ДобавлятьКомнату = Константы.ДобавлятьНаименованиеКомнатыВАдресПриСозданииЗаказаНаПроизводство.Получить(); //#10994
	
	// №14932
	МассивРазрешенныхНоменклатур = ПолучитьНоменклатуруКЗаказуНаПроизводствоПоОтбору(СсылкаНаОбъект.Товары.Выгрузить(, "Номенклатура").ВыгрузитьКолонку("Номенклатура"));
	
	Для Каждого ТекущаяСтрока Из СсылкаНаОбъект.Товары Цикл
		
		//++ №14932 смотрим по настройкам
		//ЭтоНоменклатураПотолок = Справочники.ВидыНоменклатуры.ЭтоНоменклатураПотолкаИлиОтреза(ТекущаяСтрока.Номенклатура);
		////Начало изменен при переходе на 2.0
		////Если ЭтоНоменклатураПотолок	ИЛИ ЗаказыватьТовары Тогда
		//Если ЭтоНоменклатураПотолок //потолки всегда добавляем в список
		//	ИЛИ (ЗаказыватьТовары И ТекущаяСтрока.Номенклатура.ВидНоменклатуры = Справочники.ВидыНоменклатуры.Материал И ТекущаяСтрока.Потолок.Пустая()) //если разрешено, в таблицу потолков добавляем товары из корня дерева
		//	//
		//	ИЛИ Справочники.ВидыНоменклатуры.ЭтоНоменклатураПродукция(ТекущаяСтрока.Номенклатура)
		//	//
		//	Тогда
		//	//Конец изменен при переходе на 2.0	
		
		Если МассивРазрешенныхНоменклатур.Найти(ТекущаяСтрока.Номенклатура) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		// Если это не (потолок / отрез / конструкция) - нужно проверить, что у этой позиции нет привязки к продукции
		Если Не Справочники.ВидыНоменклатуры.ЭтоНоменклатураУникальногоПотолкаИлиОтреза(ТекущаяСтрока.Номенклатура)
			И Не Справочники.ВидыНоменклатуры.ЭтоНоменклатураПродукция(ТекущаяСтрока.Номенклатура)
			И Не ТекущаяСтрока.Потолок.Пустая() Тогда
			Продолжить;
		КонецЕсли;
		//-- №14932
			
		СтруктураТовара = Новый Структура;
		СтруктураТовара.Вставить("Номенклатура", 		ТекущаяСтрока.Номенклатура);
		СтруктураТовара.Вставить(
			"ХарактеристикаНоменклатуры", 				ТекущаяСтрока.ХарактеристикаНоменклатуры);
		СтруктураТовара.Вставить("Количество", 			ТекущаяСтрока.Количество);
		СтруктураТовара.Вставить("ЕдиницаИзмерения", 	ТекущаяСтрока.ЕдиницаИзмерения);
		СтруктураТовара.Вставить("Спецификация", 		ТекущаяСтрока.Спецификация);
		СтруктураТовара.Вставить("НомерСтроки", 		ТекущаяСтрока.НомерСтроки);
		СтруктураТовара.Вставить("ЗаказНаПроизводство", ТекущаяСтрока.ЗаказНаПроизводство);
		СтруктураТовара.Вставить("СтатусПроизводства",  ТекущаяСтрока.ЗаказНаПроизводство.ТекущийСтатус);
		СтруктураТовара.Вставить("Коэффициент", 		ТекущаяСтрока.Коэффициент);
		СтруктураТовара.Вставить("ПроцентРучнойСкидки", ТекущаяСтрока.ПроцентРучнойСкидки);
		СтруктураТовара.Вставить("Цена", 				ТекущаяСтрока.Цена);
		СтруктураТовара.Вставить("СуммаРучнойСкидки", 	ТекущаяСтрока.СуммаРучнойСкидки);
		СтруктураТовара.Вставить("Сумма", 				ТекущаяСтрока.Сумма);
		СтруктураТовара.Вставить("Потолок", 			ТекущаяСтрока.Потолок);
		СтруктураТовара.Вставить("УИСтроки", 			ТекущаяСтрока.УИСтроки);
		СтруктураТовара.Вставить("КоличествоКВыработке",ТекущаяСтрока.КоличествоКВыработке); //Переход на 2.0
		СтруктураТовара.Вставить("Назначение", 			"Потолок");
		СтруктураТовара.Вставить("Заказ", 				СсылкаНаОбъект);
		АдресМонтажа = ?(НЕ ПустаяСтрока(СсылкаНаОбъект.АдресМонтажа), СсылкаНаОбъект.АдресМонтажа, ТекущаяСтрока.АдресМонтажа); //#10994 адрес с шапки приоритетно
		Если ДобавлятьКомнату И НЕ ПустаяСтрока(ТекущаяСтрока.Комната) Тогда
			АдресМонтажа = АдресМонтажа + ?(НЕ ПустаяСтрока(АдресМонтажа), ", ", "") + ТекущаяСтрока.Комната;                    //#10994
		КонецЕсли;
		СтруктураТовара.Вставить("АдресМонтажа", 		АдресМонтажа);
		СтруктураТовара.Вставить("СкладОтгрузки", 		СсылкаНаОбъект.Склад);	//20210917
		СтруктураТовара.Вставить("Срочно",		 		СсылкаНаОбъект.СрочныйЗаказ); // №13803
		
		СписокПотолков.Добавить(СтруктураТовара);
		
		//формируем массив услуг по потолку
		Для каждого СтрокаУслуги Из СсылкаНаОбъект.Товары Цикл
			ЭтоУслуга = Справочники.ВидыНоменклатуры.ЭтоНоменклатураУслуга(СтрокаУслуги.Номенклатура);
			Если ЭтоУслуга и СтрокаУслуги.Потолок = ТекущаяСтрока.Номенклатура 
				И СтрокаУслуги.УИСтрокиРодителя = ТекущаяСтрока.УИСтроки
				Тогда
				
				СтруктураТовара = Новый Структура;
				СтруктураТовара.Вставить("Номенклатура", 		СтрокаУслуги.Номенклатура);
				СтруктураТовара.Вставить("Количество", 			СтрокаУслуги.Количество);
				СтруктураТовара.Вставить("ЕдиницаИзмерения", 	СтрокаУслуги.ЕдиницаИзмерения);
				СтруктураТовара.Вставить("Спецификация", 		ТекущаяСтрока.Спецификация);
				СтруктураТовара.Вставить("НомерСтроки", 		СтрокаУслуги.НомерСтроки);
				СтруктураТовара.Вставить("ЗаказНаПроизводство", СтрокаУслуги.ЗаказНаПроизводство);
				СтруктураТовара.Вставить("Коэффициент", 		СтрокаУслуги.Коэффициент);
				СтруктураТовара.Вставить("ПроцентРучнойСкидки", СтрокаУслуги.ПроцентРучнойСкидки);
				СтруктураТовара.Вставить("Цена", 				СтрокаУслуги.Цена);
				СтруктураТовара.Вставить("СуммаРучнойСкидки", 	СтрокаУслуги.СуммаРучнойСкидки);
				СтруктураТовара.Вставить("Сумма", 				СтрокаУслуги.Сумма);
				СтруктураТовара.Вставить("Потолок", 			СтрокаУслуги.Потолок);
				СтруктураТовара.Вставить("КоличествоКВыработке",СтрокаУслуги.КоличествоКВыработке); //Переход на 2.0
				СтруктураТовара.Вставить("УИСтроки", 			СтрокаУслуги.УИСтроки);
				СтруктураТовара.Вставить("УИСтрокиРодителя",	СтрокаУслуги.УИСтрокиРодителя);
				СтруктураТовара.Вставить("Назначение", 			"Услуги");
				СтруктураТовара.Вставить("Заказ", 				СсылкаНаОбъект);
				СтруктураТовара.Вставить("АдресМонтажа", 		АдресМонтажа);
				СписокУслуг.Добавить(СтруктураТовара);
			КонецЕсли;
		КонецЦикла;
		
		//формируем массив материалов по потолку
		Для Каждого СтрокаМатериал Из СсылкаНаОбъект.Материалы Цикл				
			Если СтрокаМатериал.Потолок = ТекущаяСтрока.Номенклатура
				И СтрокаМатериал.УИСтроки = ТекущаяСтрока.УИСтроки
				Тогда
				
				СтруктураТовара = Новый Структура;
				СтруктураТовара.Вставить("Номенклатура", 		СтрокаМатериал.Номенклатура);
				СтруктураТовара.Вставить("Количество", 			СтрокаМатериал.Количество);
				СтруктураТовара.Вставить("ЕдиницаИзмерения", 	СтрокаМатериал.ЕдиницаИзмерения);
				СтруктураТовара.Вставить("НомерСтроки", 		СтрокаМатериал.НомерСтроки);					
				СтруктураТовара.Вставить("Коэффициент", 		СтрокаМатериал.Коэффициент);					
				СтруктураТовара.Вставить("Потолок", 			СтрокаМатериал.Потолок);
				СтруктураТовара.Вставить("УИСтроки", 			СтрокаМатериал.УИСтроки);
				СтруктураТовара.Вставить("КоличествоКВыработке",СтрокаМатериал.КоличествоКВыработке); //Переход на 2.0
				СтруктураТовара.Вставить("Назначение", 			"Материалы");
				СтруктураТовара.Вставить("Заказ", 				СсылкаНаОбъект);
				СтруктураТовара.Вставить("АдресМонтажа", 		АдресМонтажа);
				
				СписокМатериалов.Добавить(СтруктураТовара);
			КонецЕсли;
		КонецЦикла;
			
		//КонецЕсли;	
	КонецЦикла;
	РезультатыПараметры.СписокПотолков = СписокПотолков;
	РезультатыПараметры.СписокУслуг = СписокУслуг;
	РезультатыПараметры.СписокМатериалов = СписокМатериалов;
	РезультатыПараметры.НастройкаИнтеркампани = СсылкаНаОбъект.НастройкаИнтеркампани;

	Возврат РезультатыПараметры;
	
КонецФункции

//++ №14932 определяем номенклатуру по отбору для заказа в производство
Функция ПолучитьНоменклатуруКЗаказуНаПроизводствоПоОтбору(МассивИсходныхНоменклатур) Экспорт
	
	СхемаКД = ПолучитьОбщийМакет("СхемаНастроекПоНоменклатуреКПроизводству");
	
	НастройкиКомпоновкиДанных = Константы.НастройкиКомпоновкиПоНоменклатуреКПроизводству.Получить().Получить();
	
	КомпоновщикНастроек = Новый КомпоновщикНастроекКомпоновкиДанных;
	КомпоновщикНастроек.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(СхемаКД)); 
	
	Если ЗначениеЗаполнено(НастройкиКомпоновкиДанных) Тогда
		КомпоновщикНастроек.ЗагрузитьНастройки(НастройкиКомпоновкиДанных);
		КомпоновщикНастроек.Восстановить(СпособВосстановленияНастроекКомпоновкиДанных.ПроверятьДоступность);
	Иначе
		КомпоновщикНастроек.ЗагрузитьНастройки(СхемаКД.НастройкиПоУмолчанию);
	КонецЕсли;
	
	СписокНоменклатуры = новый СписокЗначений;
	//СписокНоменклатуры.ЗагрузитьЗначения(ТаблицаТоваровИсходная.Выгрузить().ВыгрузитьКолонку("Номенклатура"));
	СписокНоменклатуры.ЗагрузитьЗначения(МассивИсходныхНоменклатур);
	
	Для Каждого ТекПараметрСКД Из КомпоновщикНастроек.Настройки.ПараметрыДанных.Элементы Цикл	
		Если ТекПараметрСКД.Параметр = Новый ПараметрКомпоновкиДанных("Номенклатура") Тогда		
			ТекПараметрСКД.Использование = Истина;
			ТекПараметрСКД.Значение = СписокНоменклатуры;			
		КонецЕсли;		
	КонецЦикла;
	
	//Для Каждого ТекОтборСКД Из КомпоновщикНастроек.Настройки.Отбор.Элементы Цикл		
	//	ТекОтборСКД.Использование = ЗначениеЗаполнено(ТекОтборСКД.ПравоеЗначение);		
	//КонецЦикла;
	
	Запрос = Новый Запрос;
	
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных();
	
	МакетКомпоновкиДанных = КомпоновщикМакета.Выполнить(СхемаКД, КомпоновщикНастроек.ПолучитьНастройки(),,, Тип("ГенераторМакетаКомпоновкиДанных"));
	Запрос.Текст = МакетКомпоновкиДанных.НаборыДанных.ОсновнойНаборДанных.Запрос;
	
	Для Каждого Параметр Из МакетКомпоновкиДанных.ЗначенияПараметров Цикл
		Запрос.Параметры.Вставить(Параметр.Имя, Параметр.Значение);
	КонецЦикла;
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Номенклатура");
	
КонецФункции
//-- №14932

Функция ВсеТоварыПоЗаказуОтгружены(СсылкаНаЗаказ, ТоварыТЧ) Экспорт
	
	СтруктураВозврата = Новый Структура("Результат, Описание", Истина, "");
	
	ОднаОрганизацияПроизводстваИПродажиПотолков = Ложь;
	Если НЕ СсылкаНаЗаказ.НастройкаИнтеркампани.Пустая() Тогда		
		ОднаОрганизацияПроизводстваИПродажиПотолков = СсылкаНаЗаказ.НастройкаИнтеркампани.ОднаОрганизацияПроизводстваИПродажиПотолков;
	КонецЕсли;
	Если ОднаОрганизацияПроизводстваИПродажиПотолков Тогда 
		// Если ОднаОрганизация, то РТИУ не будет и поэтому надо разрешить проводить без проверки отгруженности
	    Возврат СтруктураВозврата;
	КонецЕсли;
	
	ТоварыТЗ = ТоварыТЧ.Выгрузить();
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Товары", ТоварыТЗ);
	Запрос.УстановитьПараметр("Заказ", СсылкаНаЗаказ);
	Запрос.УстановитьПараметр("Организация", СсылкаНаЗаказ.Организация);
	Запрос.УстановитьПараметр("Контрагент", СсылкаНаЗаказ.Контрагент);
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Товары.Номенклатура КАК Номенклатура,
	|	ВЫРАЗИТЬ(Товары.Количество * Товары.Коэффициент КАК ЧИСЛО(15, 2)) КАК Заказано,
	|	ВЫРАЗИТЬ(Товары.Сумма КАК ЧИСЛО(15, 2)) КАК СуммаЗаказано
	|ПОМЕСТИТЬ ВТ_ТоварыВрем
	|ИЗ
	|	&Товары КАК Товары
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВТ_ТоварыВрем.Номенклатура КАК Номенклатура,
	|	СУММА(ВТ_ТоварыВрем.Заказано) КАК Заказано,
	|	СУММА(ВТ_ТоварыВрем.СуммаЗаказано) КАК СуммаЗаказано
	|ПОМЕСТИТЬ ВТ_Товары
	|ИЗ
	|	ВТ_ТоварыВрем КАК ВТ_ТоварыВрем
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_ТоварыВрем.Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|
	//++ №8749 те позиции что отгружены, а потом возвращены покупателем и при этом отсутствуют в заказе покупателя не мешали провести документ
	|	ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЗаказыПокупателейОбороты.Номенклатура КАК Номенклатура,
	//++ №12533 переделываем, т.к. не учитывал частичный возврат
	//|	СУММА(ВЫБОР
	//|			КОГДА ЗаказыПокупателейОбороты.Регистратор ССЫЛКА Документ.ВозвратТовараОтПокупателя
	//|					ИЛИ ЗаказыПокупателейОбороты.Регистратор ССЫЛКА Документ.ВозвратПродукции
	//|				ТОГДА -1 * ЕСТЬNULL(ЗаказыПокупателейОбороты.КоличествоРасход, 0)
	//|			ИНАЧЕ 0
	//|		КОНЕЦ) КАК КоличествоВозврат,
	//|	СУММА(ВЫБОР
	//|			КОГДА ЗаказыПокупателейОбороты.Регистратор ССЫЛКА Документ.ВозвратТовараОтПокупателя
	//|					ИЛИ ЗаказыПокупателейОбороты.Регистратор ССЫЛКА Документ.ВозвратПродукции
	//|				ТОГДА 0
	//|			ИНАЧЕ ЕСТЬNULL(ЗаказыПокупателейОбороты.КоличествоРасход, 0)
	//|		КОНЕЦ) КАК КоличествоОтгружено,
	//|	СУММА(ВЫБОР
	//|			КОГДА ЗаказыПокупателейОбороты.Регистратор ССЫЛКА Документ.ВозвратТовараОтПокупателя
	//|					ИЛИ ЗаказыПокупателейОбороты.Регистратор ССЫЛКА Документ.ВозвратПродукции
	//|				ТОГДА -1 * ЕСТЬNULL(ЗаказыПокупателейОбороты.СуммаРасход, 0)
	//|			ИНАЧЕ 0
	//|		КОНЕЦ) КАК СуммаВозврат,
	//|	СУММА(ВЫБОР
	//|			КОГДА ЗаказыПокупателейОбороты.Регистратор ССЫЛКА Документ.ВозвратТовараОтПокупателя
	//|					ИЛИ ЗаказыПокупателейОбороты.Регистратор ССЫЛКА Документ.ВозвратПродукции
	//|				ТОГДА 0
	//|			ИНАЧЕ ЕСТЬNULL(ЗаказыПокупателейОбороты.СуммаРасход, 0)
	//|		КОНЕЦ) КАК СуммаОтгружено
	|	СУММА(ЕСТЬNULL(ЗаказыПокупателейОбороты.КоличествоРасход, 0)) КАК КоличествоОтгружено,
	|	СУММА(ЕСТЬNULL(ЗаказыПокупателейОбороты.СуммаРасход, 0)) КАК СуммаОтгружено
	//-- №12533 переделываем, т.к. не учитывал частичный возврат
	|ПОМЕСТИТЬ ВТ_ЗаказыПокупателейОбороты
	|ИЗ
	|	РегистрНакопления.ЗаказыПокупателей.Обороты(, , Регистратор, ЗаказНаПроизводство = &Заказ И Организация = &Организация И Контрагент = &Контрагент) КАК ЗаказыПокупателейОбороты
	|СГРУППИРОВАТЬ ПО
	|	ЗаказыПокупателейОбороты.Номенклатура
	|;
	|///////////////////////////////////////////////////////////////////////////////
	//-- №8749
	|
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЕСТЬNULL(ВТ_Товары.Номенклатура, ЗаказыПокупателейОбороты.Номенклатура) КАК Номенклатура,
	//++ №8749
