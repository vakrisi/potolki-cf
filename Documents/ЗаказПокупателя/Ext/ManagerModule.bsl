#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область Печать

// Заполняет список команд печати.
// 
// Параметры:
// КомандыПечати – ТаблицаЗначений – состав полей см. в функции УправлениеПечатью.СоздатьКоллекциюКомандПечати
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт
	
	//Счет на оплату
    КомандаПечати = КомандыПечати.Добавить();
    КомандаПечати.МенеджерПечати = "Документ.ЗаказПокупателя";
    КомандаПечати.Идентификатор = "СчетНаОплату";
    КомандаПечати.Представление = НСтр("ru = 'Счет на оплату'");
    //КомандаПечати.ПроверкаПроведенияПередПечатью = Истина; 
	КомандаПечати.ЗаголовокФормы = НСтр("ru = 'Счет на оплату'");
	КомандаПечати.СписокФорм = "ФормаДокумента,ФормаСписка,ФормаВыбора"; // чтобы не выводилось в АРМ
	
	// Счет на оплату (с печатью и подписями) 
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати = "Документ.ЗаказПокупателя";
	КомандаПечати.Идентификатор  = "СчетНаОплатуСПечатью";
	КомандаПечати.Представление  = НСтр("ru = 'Счет на оплату (с печатью и подписями) '");
	//КомандаПечати.ПроверкаПроведенияПередПечатью = Истина; 
	КомандаПечати.ЗаголовокФормы = НСтр("ru = 'Счет на оплату'");
	КомандаПечати.СписокФорм = "ФормаДокумента,ФормаСписка,ФормаВыбора";

	Если ПолучитьФункциональнуюОпцию("ДополнительнаяОценкаЗапасовВВалюте") Тогда
		//Счет на оплату (вал)
		КомандаПечати = КомандыПечати.Добавить();
		КомандаПечати.МенеджерПечати = "Документ.ЗаказПокупателя";
		КомандаПечати.Идентификатор = "СчетНаОплатуВал";
		КомандаПечати.Представление = НСтр("ru = 'Счет на оплату (вал.)'");
		//КомандаПечати.ПроверкаПроведенияПередПечатью = Истина; 
		КомандаПечати.ЗаголовокФормы = НСтр("ru = 'Счет на оплату (вал.)'");
		КомандаПечати.СписокФорм = "ФормаДокумента,ФормаСписка,ФормаВыбора";
		
		// Счет на оплату (с печатью и подписями) (вал) 
		КомандаПечати = КомандыПечати.Добавить();
		КомандаПечати.МенеджерПечати = "Документ.ЗаказПокупателя";
		КомандаПечати.Идентификатор  = "СчетНаОплатуСПечатьюВал";
		КомандаПечати.Представление  = НСтр("ru = 'Счет на оплату (с печатью и подписями) (вал.)'"); 
		КомандаПечати.ЗаголовокФормы = НСтр("ru = 'Счет на оплату (вал.)'");
		КомандаПечати.СписокФорм = "ФормаДокумента,ФормаСписка,ФормаВыбора";
	КонецЕсли;

	//Товарная накладная с весом
    КомандаПечати = КомандыПечати.Добавить();
    КомандаПечати.МенеджерПечати 	= "Документ.ЗаказПокупателя";
    КомандаПечати.Идентификатор 	= "ЗаказПокупателя";
    КомандаПечати.Представление 	= НСтр("ru = 'Заказ покупателя'");
    //КомандаПечати.ПроверкаПроведенияПередПечатью = Истина; 
	КомандаПечати.ЗаголовокФормы 	= НСтр("ru = 'Заказ покупателя'");
	
	//Упаковка
    КомандаПечати = КомандыПечати.Добавить();
    КомандаПечати.МенеджерПечати 	= "Документ.ЗаказПокупателя";
    КомандаПечати.Идентификатор 	= "Упаковка";
    КомандаПечати.Представление 	= НСтр("ru = 'Упаковка'");
    //КомандаПечати.ПроверкаПроведенияПередПечатью = Истина; 
	КомандаПечати.ЗаголовокФормы 	= НСтр("ru = 'Упаковка'");
	КомандаПечати.СписокФорм = "ФормаДокумента,ФормаСписка,ФормаВыбора";
	
	//
    КомандаПечати = КомандыПечати.Добавить();
    КомандаПечати.МенеджерПечати 	= "Документ.ЗаказПокупателя";
    КомандаПечати.Идентификатор 	= "ЗаказПокупателяСводно";
    КомандаПечати.Представление 	= НСтр("ru = 'Заказы сводно'"); 
	КомандаПечати.СписокФорм = "АРМПроизводства";
	
КонецПроцедуры

// Формирует печатные формы.
//
// Параметры:
// МассивОбъектов – Массив – ссылки на объекты, которые нужно распечатать;
// ПараметрыПечати – Структура – дополнительные настройки печати;
// КоллекцияПечатныхФорм – ТаблицаЗначений – сформированные табличные документы (выходной параметр)
// ОбъектыПечати – СписокЗначений – значение – ссылка на объект;
// представление – имя области, в которой был выведен объект (выходной параметр);
// ПараметрыВывода – Структура – дополнительные параметры сформированных табличных документов (выходной параметр).
//
Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт

	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ЗаказПокупателя") Тогда
         УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
        														КоллекцияПечатныхФорм,
        														"ЗаказПокупателя",
        														НСтр("ru = 'Заказ покупателя'"),
        														ПечатьЗаказПокупателя(МассивОбъектов, ОбъектыПечати),
        														,
        														"Документ.ЗаказПокупателя.ПФ_MXL_ЗаказПокупателя");
	КонецЕсли;
															
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ЗаказПокупателяСводно") Тогда
        УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
        	КоллекцияПечатныхФорм,
        	"ЗаказПокупателяСводно",
        	НСтр("ru = 'ЗаказПокупателяСводно'"),
        	СформироватьПечатнуюФормуЗаказаПокупателяСводно(МассивОбъектов, ОбъектыПечати));
	КонецЕсли;

	
    Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "Упаковка") Тогда
         УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
        														КоллекцияПечатныхФорм,
        														"Упаковка",
        														НСтр("ru = 'Упаковка'"),
        														ПечатьУпаковка(МассивОбъектов, ОбъектыПечати, Ложь),
       															,
        														"Документ.ЗаказПокупателя.ПФ_MXL_Упаковка");
	КонецЕсли;
															
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "СчетНаОплату") Тогда
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
        КоллекцияПечатныхФорм,
        "СчетНаОплату",
        НСтр("ru = 'Счет на оплату'"),
        ПечатьСчетНаОплату(МассивОбъектов, ОбъектыПечати));
		
	ИначеЕсли УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "СчетНаОплатуСПечатью") Тогда
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
        КоллекцияПечатныхФорм,
        "СчетНаОплатуСПечатью",
        НСтр("ru = 'Счет на оплату (с печатью и подписями)'"),
        ПечатьСчетНаОплату(МассивОбъектов, ОбъектыПечати, Истина));
		
	ИначеЕсли УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "СчетНаОплатуВал") Тогда
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
        КоллекцияПечатныхФорм,
        "СчетНаОплатуВал",
        НСтр("ru = 'Счет на оплату (вал.)'"),
        ПечатьСчетНаОплату(МассивОбъектов, ОбъектыПечати, , Истина));
		
	ИначеЕсли УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "СчетНаОплатуСПечатьюВал") Тогда
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
        КоллекцияПечатныхФорм,
        "СчетНаОплатуСПечатьюВал",
        НСтр("ru = 'Счет на оплату (с печатью и подписями) (вал.)'"),
        ПечатьСчетНаОплату(МассивОбъектов, ОбъектыПечати, Истина, Истина));
		
	КонецЕсли;

КонецПроцедуры

Функция ПолучитьДанныеДляПечатныхФорм(МассивОбъектов) Экспорт
    
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ДанныеДокумента.Ссылка КАК Ссылка,
	|	ДанныеДокумента.Номер КАК Номер,
	|	ДанныеДокумента.Дата КАК ДатаДокумента,
	|	""01.01.0001"" КАК Дата,
	|	ДанныеДокумента.АдресМонтажа КАК АдресМонтажа,
	|	ДанныеДокумента.Валюта КАК Валюта,
	|	ДанныеДокумента.ВидЦен КАК ВидЦен,
	|	ДанныеДокумента.Организация КАК Организация,
	|	ВЫБОР
	|		КОГДА НЕ ДанныеДокумента.Организация.ПолноеНаименование = """"
	|			ТОГДА ДанныеДокумента.Организация.ПолноеНаименование
	|		ИНАЧЕ ДанныеДокумента.Организация.Наименование
	|	КОНЕЦ КАК ПредставлениеОрганизации,
	|	ДанныеДокумента.Склад КАК Склад,
	|	ДанныеДокумента.БанковскийСчет КАК БанковскийСчет,
	|	ДанныеДокумента.БанковскийСчет.НомерСчета КАК БанковскийСчетНомерСчета,
	|	ДанныеДокумента.БанковскийСчет.БИК КАК БанковскийСчетБИК,
	|	ДанныеДокумента.БанковскийСчет.КоррСчет КАК БанковскийСчетКоррСчет,
	|	ДанныеДокумента.БанковскийСчет.НаименованиеБанка КАК БанковскийСчетНаименованиеБанка,
	|	ДанныеДокумента.ИнтернетОплатаСсылка КАК ИнтернетОплатаСсылка,
	|	ДанныеДокумента.ИнтернетОплатаНомерТелефонаПлательщика КАК ИнтернетОплатаНомерТелефонаПлательщика,
	|	ДанныеДокумента.ИнтернетОплатаЭлектроннаяПочтаПлательщика КАК ИнтернетОплатаЭлектроннаяПочтаПлательщика,
	|	ДанныеДокумента.Организация.ИНН КАК ИНН,
	|	ДанныеДокумента.Организация.КПП КАК КПП,
	|	ДанныеДокумента.Организация.Руководитель КАК ОрганизацияРуководитель,
	|	ДанныеДокумента.Организация.ГлавныйБухгалтер КАК ОрганизацияГлавныйБухгалтер,
	|	ДанныеДокумента.Организация.ПолноеНаименование КАК ОрганизацияПолноеНаименование,
	|	ДанныеДокумента.Организация.ЯвляетсяПлательщикомНДС КАК ОрганизацияЯвляетсяПлательщикомНДС,
	|	ДанныеДокумента.Контрагент КАК Контрагент,
	|	ДанныеДокумента.ДоговорКонтрагента КАК ДоговорКонтрагента,
	|	ВЫБОР
	|		КОГДА НЕ ДанныеДокумента.Контрагент.НаименованиеПолное = """"
	|			ТОГДА ДанныеДокумента.Контрагент.НаименованиеПолное
	|		ИНАЧЕ ДанныеДокумента.Контрагент.Наименование
	|	КОНЕЦ КАК ПредставлениеКонтрагента,
	|	ВЫБОР
	|		КОГДА НЕ ДанныеДокумента.Контрагент.НаименованиеПолное = """"
	|			ТОГДА ДанныеДокумента.Контрагент.НаименованиеПолное
	|		ИНАЧЕ ДанныеДокумента.Контрагент.Наименование
	|	КОНЕЦ КАК КонтрагентНаименованиеПолное,
	|	ДанныеДокумента.Контрагент.ИНН КАК КонтрагентИНН,
	|	ДанныеДокумента.Комментарий КАК Комментарий,
	|	ДанныеДокумента.Автор КАК Автор,
	|	ДанныеДокумента.СуммаДокумента КАК СуммаДокумента,
	|	ДанныеДокумента.СуммаБонусовКСписаниюПоДисконтнойКарте КАК СуммаБонусовКСписанию,
	|	""текст расшифровки НДС"" КАК НДС,
	|	0 КАК ИтогоСуммаНДС,
	|	0 КАК ИтогоСуммаБезНДС,
	|	0 КАК СуммаРучнойСкидки,
	|	0 КАК Скидка,
	|	0 КАК ИтогоВес,
	|	0 КАК Вес,
	|	0 КАК Сумма,
	|	0 КАК КолвоПозиций,
	|	ДанныеДокумента.Примечание КАК Примечание
	|ИЗ
	|	Документ.ЗаказПокупателя КАК ДанныеДокумента
	|ГДЕ
	|	ДанныеДокумента.Ссылка В(&МассивОбъектов)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДанныеДокумента.Ссылка,
	|	ДанныеДокумента.Дата
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ДанныеДокумента.Ссылка КАК Ссылка,
	|	ДанныеДокумента.НомерСтроки КАК НомерСтроки,
	|	ДанныеДокумента.АдресМонтажа КАК АдресМонтажа,
	|	ДанныеДокумента.Номенклатура.Артикул КАК Артикул,
	|	ДанныеДокумента.Номенклатура КАК Номенклатура,
	|	ДанныеДокумента.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	|	ДанныеДокумента.СерияНоменклатуры КАК СерияНоменклатуры,
	|	ДанныеДокумента.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	ДанныеДокумента.Коэффициент КАК Коэффициент,
	|	ДанныеДокумента.Количество КАК Количество,
	|	ДанныеДокумента.Цена КАК Цена,
	|	ДанныеДокумента.ЦенаВал КАК ЦенаВал,
	|	ДанныеДокумента.Сумма КАК Сумма,
	|	ДанныеДокумента.ПроцентРучнойСкидки КАК ПроцентРучнойСкидки,
	|	ДанныеДокумента.СуммаРучнойСкидки КАК СуммаРучнойСкидки,
	
	// #15133 добавлен учет бонусов
	//|	ДанныеДокумента.СуммаРучнойСкидки КАК РучнаяСкидка,
	//|	ДанныеДокумента.Сумма + ДанныеДокумента.СуммаРучнойСкидки КАК СуммаБезСкидки,
	|	ДанныеДокумента.СуммаРучнойСкидки + ДанныеДокумента.СкидкаБонусами КАК Скидка,
	|	ДанныеДокумента.СкидкаБонусами КАК СкидкаБонусами,
	|	ДанныеДокумента.Сумма + ДанныеДокумента.СуммаРучнойСкидки + ДанныеДокумента.СкидкаБонусами КАК СуммаБезСкидки,
	
	|	ДанныеДокумента.ЗаказНаПроизводство КАК ЗаказНаПроизводство,
	|	ДанныеДокумента.НомерУпаковки КАК НомерУпаковки,
	|	ВЫБОР
	|		КОГДА ТИПЗНАЧЕНИЯ(ДанныеДокумента.ЕдиницаИзмерения) = ТИП(Справочник.ЕдиницыИзмерений)
	|			ТОГДА ДанныеДокумента.ЕдиницаИзмерения.Вес * ДанныеДокумента.Количество
	|		ИНАЧЕ ДанныеДокумента.Номенклатура.Вес * ДанныеДокумента.Количество
	|	КОНЕЦ КАК Вес,
	|	ДанныеДокумента.Потолок КАК Потолок,
	|	ДанныеДокумента.СтавкаНДС КАК СтавкаНДС,
	|	ДанныеДокумента.СуммаНДС КАК СуммаНДС
	|ИЗ
	|	Документ.ЗаказПокупателя.Товары КАК ДанныеДокумента
	|ГДЕ
	|	ДанныеДокумента.Ссылка В(&МассивОбъектов)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДанныеДокумента.Ссылка,
	|	ДанныеДокумента.НомерСтроки
	|ИТОГИ
	|	КОЛИЧЕСТВО(НомерСтроки),
	|	СУММА(Сумма),
	|	СУММА(СуммаРучнойСкидки),
	|	СУММА(Скидка),
	|	СУММА(Вес),
	|	СУММА(СуммаНДС)
	|ПО
	|	Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	ДанныеДокумента.Ссылка КАК Ссылка,
	|	ДанныеДокумента.НомерУпаковки КАК НомерУпаковки
	|ИЗ
	|	Документ.ЗаказПокупателя.Товары КАК ДанныеДокумента
	|ГДЕ
	|	ДанныеДокумента.Ссылка В(&МассивОбъектов)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДанныеДокумента.Ссылка
	|ИТОГИ ПО
	|	Ссылка";

	МассивРезультатов         = Запрос.ВыполнитьПакет();
	РезультатПоШапке          = МассивРезультатов[0];
	РезультатПоТабличнойЧастиТовары = МассивРезультатов[1];
	РезультатПоНомерамУпаковки      = МассивРезультатов[2];
	
	СтруктураДанныхДляПечати 	= Новый Структура("РезультатПоШапке, РезультатПоТабличнойЧастиТовары, РезультатПоНомерамУпаковки",
	                                               РезультатПоШапке, РезультатПоТабличнойЧастиТовары, РезультатПоНомерамУпаковки);
	
	Возврат СтруктураДанныхДляПечати;
	
КонецФункции

Процедура ДополнитьДанныеДляПечатныхФорм(РезультатЗапроса, ВыборкаПоТоварам=Неопределено) Экспорт
	
	ОбщийМодульСервер.ДобавитьКолонкиКонтактнойИнформации(РезультатЗапроса);
	
	РезультатЗапроса.Колонки.Добавить("РасширенноеПредставлениеОрганизации");
	РезультатЗапроса.Колонки.Добавить("РасширенноеПредставлениеКонтрагента");
	
	РезультатЗапроса.Колонки.Добавить("ВремяФормированияПФ");
	РезультатЗапроса.Колонки.Добавить("ВалютаУчета");
	РезультатЗапроса.Колонки.Добавить("ТекущийДолг"); 
	РезультатЗапроса.Колонки.Добавить("ОстатокПоЗаказам");	

	Для Каждого ТекущаяСтрока Из РезультатЗапроса Цикл
		
		ТекущаяСтрока.Дата = Формат(ТекущаяСтрока.ДатаДокумента, "ДЛФ=Д");		
		Попытка
			ТекущаяСтрока.Номер = ПрефиксацияОбъектовКлиентСервер.НомерНаПечать(ТекущаяСтрока.Номер);
		Исключение
		КонецПопытки;
		
		Если НЕ ВыборкаПоТоварам = Неопределено Тогда
			СтруктураПоиска = Новый Структура("Ссылка", ТекущаяСтрока.Ссылка);
			ВыборкаПоТоварам.Сбросить();
			Если ВыборкаПоТоварам.НайтиСледующий(СтруктураПоиска) Тогда
				ТекущаяСтрока.СуммаРучнойСкидки = ВыборкаПоТоварам.СуммаРучнойСкидки;
				ТекущаяСтрока.Скидка = ВыборкаПоТоварам.Скидка;
				ТекущаяСтрока.ИтогоВес = ВыборкаПоТоварам.Вес;
				ТекущаяСтрока.Вес = ВыборкаПоТоварам.Вес;
				ТекущаяСтрока.ИтогоСуммаНДС = ВыборкаПоТоварам.СуммаНДС;
				ТекущаяСтрока.ИтогоСуммаБезНДС = ВыборкаПоТоварам.Сумма - ВыборкаПоТоварам.СуммаНДС;
				ТекущаяСтрока.Сумма = ВыборкаПоТоварам.Сумма;	
				ТекущаяСтрока.КолвоПозиций = ВыборкаПоТоварам.НомерСтроки;
			КонецЕсли;						
		КонецЕсли;
		
		Если ТекущаяСтрока.ИтогоСуммаНДС = 0 Тогда			
			ТекущаяСтрока.НДС = "Без налога (НДС)";		
		Иначе			
			ТекущаяСтрока.НДС = "В том числе НДС:";	
		КонецЕсли;
		
		СведенияОбОрганизации = ОбщийМодульСервер.СведенияОбОрганизации(ТекущаяСтрока.Организация, ТекущаяСтрока.ДатаДокумента);
		СведенияОКонтрагенте  = ОбщийМодульСервер.СведенияОКонтрагенте(ТекущаяСтрока.Контрагент, ТекущаяСтрока.ДатаДокумента);
		
		Сведения = "ПолноеНаименование,ИНН,КПП,ЮридическийАдрес,Телефоны";
		ТекущаяСтрока.РасширенноеПредставлениеОрганизации = ОбщийМодульСервер.ОписаниеОрганизации(СведенияОбОрганизации, Сведения);
		ТекущаяСтрока.РасширенноеПредставлениеКонтрагента = ОбщийМодульСервер.ОписаниеОрганизации(СведенияОКонтрагенте, Сведения);
		
		//#13516
		ТекущаяСтрока.ВремяФормированияПФ = ТекущаяДатаСеанса();
		ТекущаяСтрока.ВалютаУчета = Константы.ВалютаУчета.Получить().Наименование;
		// в валюте учета
		ТекущаяСтрока.ТекущийДолг = ОбщийМодульСервер.ПолучитьТекущийДолгКлиента(ТекущаяСтрока.ВремяФормированияПФ, ТекущаяСтрока.Организация, ТекущаяСтрока.Контрагент, ТекущаяСтрока.ДоговорКонтрагента);
		ТекущаяСтрока.ОстатокПоЗаказам = ОбщийМодульСервер.ПолучитьОстатокПоЗаказамПокупателей(ТекущаяСтрока.ВремяФормированияПФ, ТекущаяСтрока.Организация, ТекущаяСтрока.Контрагент);

		ОбщийМодульСервер.ДополнитьДанныеДляПечатныхФормКонтактнойИнформацией(ТекущаяСтрока, ТекущаяСтрока.Организация, ТекущаяСтрока.Контрагент);
	КонецЦикла;		
	
КонецПроцедуры

Функция ПечатьЗаказПокупателя(МассивОбъектов, ОбъектыПечати = Неопределено) Экспорт
    
    ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.АвтоМасштаб         = Истина; //#14053
    ТабличныйДокумент.ИмяПараметровПечати = "ПараметрыПечати_ТоварнаяНакладнаяСВесом";
	Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.ЗаказПокупателя.ПФ_MXL_ЗаказПокупателя");
	ВыводитьАртикул = Константы.ВыводитьАртикулНоменклатурыВПечатныхФормах.Получить();
	
	СтруктураДанныхДляПечати = ПолучитьДанныеДляПечатныхФорм(МассивОбъектов);
	ТаблицаДанныеПечати = СтруктураДанныхДляПечати.РезультатПоШапке.Выгрузить();
	ВыборкаПоТоварам = СтруктураДанныхДляПечати.РезультатПоТабличнойЧастиТовары.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	ДополнитьДанныеДляПечатныхФорм(ТаблицаДанныеПечати, ВыборкаПоТоварам);
	
	// Изменения размера колоноки, в зависимости от вывода Артикула
	Если Не ВыводитьАртикул Тогда
		Попытка
			Макет.Область("ПерваяКолонкаТовара").ШиринаКолонки = Макет.Область("ПерваяКолонкаТовара").ШиринаКолонки + Макет.Область("Артикул").ШиринаКолонки;
		Исключение
		КонецПопытки;
	КонецЕсли;
		
    ПервыйДокумент = Истина;
	Для Каждого ДанныеПечати Из ТаблицаДанныеПечати Цикл
		
        Если Не ПервыйДокумент Тогда
            // Все документы нужно выводить на разных страницах.
            ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
        КонецЕсли;
        ПервыйДокумент = Ложь;
        // Запомним номер строки, с которой начали выводить текущий документ.
        НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы + 1;
		
		ЕстьСкидка = ДанныеПечати.СуммаРучнойСкидки > 0;		
		ЕстьБонусы = ДанныеПечати.СуммаБонусовКСписанию > 0;		
		
		ВставкаСкидок = ?(ЕстьСкидка, "Скидка","");
		ВставкаСкидок = ?(ЕстьБонусы, ВставкаСкидок+"Бонус", ВставкаСкидок);
		
		ТекстЗаголовка = "Заказ покупателя №" + ПрефиксацияОбъектовКлиентСервер.НомерНаПечать(ДанныеПечати.Номер) + " от " + Формат(ДанныеПечати.ДатаДокумента, "ДЛФ=DD");
		
		Попытка
			ОбластьМакета = Макет.ПолучитьОбласть("Заголовок");
			ОбластьМакета.Параметры.Заполнить(ДанныеПечати);
			Попытка				
				ОбластьМакета.Параметры.ТекстЗаголовка = ТекстЗаголовка;
			Исключение
			КонецПопытки;
			
			ШтрихкодированиеПечатныхФорм.ВывестиШтрихкодВТабличныйДокумент(
				ТабличныйДокумент,
				Макет,
				ОбластьМакета,
				ДанныеПечати.Ссылка);
			
			ТабличныйДокумент.Вывести(ОбластьМакета);
		Исключение
		КонецПопытки;
		
		Попытка
			ОбластьМакета = Макет.ПолучитьОбласть("Организация");
			ОбластьМакета.Параметры.Заполнить(ДанныеПечати);
			ТабличныйДокумент.Вывести(ОбластьМакета);
		Исключение
		КонецПопытки;
		
		//#13343 
		Попытка
			ОбластьМакета = Макет.ПолучитьОбласть("Склад");
			ОбластьМакета.Параметры.Заполнить(ДанныеПечати);
			ТабличныйДокумент.Вывести(ОбластьМакета);
		Исключение
		КонецПопытки;
		
		Попытка
			ОбластьМакета = Макет.ПолучитьОбласть("Покупатель");
			ОбластьМакета.Параметры.Заполнить(ДанныеПечати);
			ТабличныйДокумент.Вывести(ОбластьМакета);
		Исключение
		КонецПопытки;
		
		//#13343 
		Если ЗначениеЗаполнено(ДанныеПечати.АдресМонтажа) Тогда
			Попытка
				ОбластьМакета = Макет.ПолучитьОбласть("АдресМонтажа");
				ОбластьМакета.Параметры.Заполнить(ДанныеПечати);
				ТабличныйДокумент.Вывести(ОбластьМакета);
			Исключение
			КонецПопытки;
		КонецЕсли;
		
		//// Изменения размера колоноки, в зависимости от вывода Артикула
		//Если Не ВыводитьАртикул Тогда
		//	Попытка
		//		Макет.Область("ПерваяКолонкаТовара").ШиринаКолонки = Макет.Область("ПерваяКолонкаТовара").ШиринаКолонки + Макет.Область("Артикул").ШиринаКолонки;
		//	Исключение
		//	КонецПопытки;
		//КонецЕсли;
		
		Попытка
			ОбластьМакета = Макет.ПолучитьОбласть("ШапкаТаблицы"+ВставкаСкидок+"|НомерСтроки");
			ОбластьМакета.Параметры.Заполнить(ДанныеПечати);
			ТабличныйДокумент.Вывести(ОбластьМакета);
			
			Если ВыводитьАртикул Тогда
				ОбластьМакета = Макет.ПолучитьОбласть("ШапкаТаблицы"+ВставкаСкидок+"|Артикул");
				ОбластьМакета.Параметры.Заполнить(ДанныеПечати);
				ТабличныйДокумент.Присоединить(ОбластьМакета);
			КонецЕсли;	
			
			ОбластьМакета = Макет.ПолучитьОбласть("ШапкаТаблицы"+ВставкаСкидок+"|Данные");
			ОбластьМакета.Параметры.Заполнить(ДанныеПечати);
			ТабличныйДокумент.Присоединить(ОбластьМакета);
				
		Исключение
		КонецПопытки;
		
		// подготовим табличную часть в зависимости от варианта формирования ПФ счета на оплату
		ВариантФормированияПФЗаказаПокупателя = Константы.ВариантФормированияПФЗаказаПокупателя.Получить();
		
		МассивДопРеквизитов = Новый Массив;
		МассивДопРеквизитов.Добавить(Новый Структура("Имя, Тип", "Артикул", 			Новый ОписаниеТипов("Строка")));
		МассивДопРеквизитов.Добавить(Новый Структура("Имя, Тип", "Вес", 				Новый ОписаниеТипов("Число")));
		МассивДопРеквизитов.Добавить(Новый Структура("Имя, Тип", "Скидка", 				Новый ОписаниеТипов("Число")));
		МассивДопРеквизитов.Добавить(Новый Структура("Имя, Тип", "СуммаБезСкидки", 		Новый ОписаниеТипов("Число")));
		
		МассивДопРеквизитов.Добавить(Новый Структура("Имя, Тип", "ВидНоменклатуры", 	Новый ОписаниеТипов("Число")));
		МассивДопРеквизитов.Добавить(Новый Структура("Имя, Тип", "ЕстьПотолок", 		Новый ОписаниеТипов("Число")));
		МассивДопРеквизитов.Добавить(Новый Структура("Имя, Тип", "ЭтоПотолок", 			Новый ОписаниеТипов("Булево")));
		МассивДопРеквизитов.Добавить(Новый Структура("Имя, Тип", "НомерСтрокиПотолка", 	Новый ОписаниеТипов("Число")));

		ТаблицаТоварыИУслуги = ОбщийМодульСервер.ТаблицаЗначенийПоТабличнойЧастиОбъекта("ЗаказПокупателя", "Товары", МассивДопРеквизитов);
		СтруктураПоиска = Новый Структура("Ссылка", ДанныеПечати.Ссылка);		
		ВыборкаПоТоварам.Сбросить();
		
		СоответствиеНомеровСтрокПотолков = Новый Соответствие;
		Если ВыборкаПоТоварам.НайтиСледующий(СтруктураПоиска) Тогда			
			Выборка = ВыборкаПоТоварам.Выбрать();			
			Пока Выборка.Следующий() Цикл
				ТекущаяСтрока = ТаблицаТоварыИУслуги.Добавить();
				ЗаполнитьЗначенияСвойств(ТекущаяСтрока, Выборка);
				
				Если Справочники.ВидыНоменклатуры.ЭтоНоменклатураПотолкаИлиОтреза(ТекущаяСтрока.Номенклатура) Тогда
					ТекущаяСтрока.ВидНоменклатуры = 1;
					ТекущаяСтрока.Потолок = ТекущаяСтрока.Номенклатура;
					ТекущаяСтрока.НомерСтрокиПотолка = ТекущаяСтрока.НомерСтроки;
					СоответствиеНомеровСтрокПотолков.Вставить(ТекущаяСтрока.Номенклатура, ТекущаяСтрока.НомерСтрокиПотолка);
					ТекущаяСтрока.ЭтоПотолок = Истина;
					
				ИначеЕсли Справочники.ВидыНоменклатуры.ЭтоНоменклатураУслуга(ТекущаяСтрока.Номенклатура) Тогда
					ТекущаяСтрока.ВидНоменклатуры = 3;
				Иначе
					ТекущаяСтрока.ВидНоменклатуры = 2;
				КонецЕсли;
				Если ТекущаяСтрока.Потолок.Пустая() Тогда
					ТекущаяСтрока.ЕстьПотолок = 2;
				Иначе
					ТекущаяСтрока.ЕстьПотолок = 1;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;		
		
		Если ВариантФормированияПФЗаказаПокупателя = 0 ИЛИ ВариантФормированияПФЗаказаПокупателя = 4 Тогда
			Для Каждого ТекущаяСтрока Из ТаблицаТоварыИУслуги Цикл
				Если НЕ СоответствиеНомеровСтрокПотолков.Получить(ТекущаяСтрока.Потолок) = Неопределено Тогда
					ТекущаяСтрока.НомерСтрокиПотолка = СоответствиеНомеровСтрокПотолков.Получить(ТекущаяСтрока.Потолок);
				Иначе
					ТекущаяСтрока.НомерСтрокиПотолка = ТекущаяСтрока.НомерСтроки;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
		//0. Потолок - товар - услуга - потолок - товар - услуга
		//4. Потолок - товар - услуга - ПОДЫТОГ - потолок - товар - услуга - ПОДЫТОГ
		//1. Потолок, Потолок, Товары, Товары, услуги, услуги
		//2. Потолок - потолок - товар (все одинаковые позиции сворачиваются). - услуга (все одинаковые позиции сворачиваются)
		//3. Без сортировки
		Если ВариантФормированияПФЗаказаПокупателя = 0 Тогда
			//#11059
			//ТаблицаТоварыИУслуги.Сортировать("ЕстьПотолок, Потолок, ВидНоменклатуры");
			ТаблицаТоварыИУслуги.Сортировать("НомерСтрокиПотолка, НомерСтроки");
		ИначеЕсли ВариантФормированияПФЗаказаПокупателя = 4 Тогда			
			//ТаблицаТоварыИУслуги.Сортировать("ЕстьПотолок, НомерСтрокиПотолка, ЭтоПотолок Убыв, НомерСтроки");
			ТаблицаТоварыИУслуги.Сортировать("НомерСтрокиПотолка, ЭтоПотолок Убыв, НомерСтроки");
		ИначеЕсли ВариантФормированияПФЗаказаПокупателя = 1 Тогда
			ТаблицаТоварыИУслуги.Сортировать("ВидНоменклатуры");
		ИначеЕсли ВариантФормированияПФЗаказаПокупателя = 2 Тогда
			ТаблицаТоварыИУслуги.Свернуть("АдресМонтажа, Артикул, Номенклатура, ХарактеристикаНоменклатуры, СерияНоменклатуры, ЕдиницаИзмерения, Коэффициент, Цена, ПроцентРучнойСкидки, СуммаРучнойСкидки, ВидНоменклатуры", "Вес, Количество, Сумма");
			ТаблицаТоварыИУслуги.Сортировать("ВидНоменклатуры")
		ИначеЕсли ВариантФормированияПФЗаказаПокупателя = 3 Тогда	
			//не сортируем
		КонецЕсли;
		
		ИтогоВес = 0;
		Сумма = 0;
		НомерСтроки = 1;
		
		СуммаПодытог = 0;
		ВесПодытог = 0;
		
		ТекНомерСтрокиПотолка = 1;
		
		Для каждого Товары из ТаблицаТоварыИУслуги Цикл //Шапка.Товары Цикл
			Попытка
				
				ОбластьМакета = Макет.ПолучитьОбласть("Строка"+ВставкаСкидок+"|НомерСтроки");
				
				ОбластьМакета.Параметры.Заполнить(Товары);
				ОбластьМакета.Параметры.НомерСтроки = НомерСтроки;
				ТабличныйДокумент.Вывести(ОбластьМакета);
				
				Если ВыводитьАртикул Тогда
					ОбластьМакета = Макет.ПолучитьОбласть("Строка"+ВставкаСкидок+"|Артикул");
					ОбластьМакета.Параметры.Заполнить(Товары);
					ТабличныйДокумент.Присоединить(ОбластьМакета);
				КонецЕсли;
				
				ОбластьМакета = Макет.ПолучитьОбласть("Строка"+ВставкаСкидок+"|Данные");
				ОбластьМакета.Параметры.Заполнить(Товары);
				
				//++ №12909
				//ПредставлениеНоменклатуры = Строка(Товары.Номенклатура) + Строка(УправлениеПечатью.ПредставлениеХарактеристики(Товары.ХарактеристикаНоменклатуры));
				ПредставлениеНоменклатуры = ОбщийМодульСервер.ПредставлениеНоменклатурыДляПечати(Товары.Номенклатура, Товары.ХарактеристикаНоменклатуры);
				//-- №12909
				
				Если (ВариантФормированияПФЗаказаПокупателя = 0 ИЛИ ВариантФормированияПФЗаказаПокупателя = 4)
					И НЕ Товары.ЭтоПотолок 
					И Товары.ЕстьПотолок = 1 Тогда
					ПредставлениеНоменклатуры = "    " + ПредставлениеНоменклатуры;	
				КонецЕсли;
				ОбластьМакета.Параметры.Номенклатура = ПредставлениеНоменклатуры;
				
				Если (ВариантФормированияПФЗаказаПокупателя = 0 ИЛИ ВариантФормированияПФЗаказаПокупателя = 4)
					И Товары.ВидНоменклатуры = 1 Тогда
					//ОбластьМакета.ТекущаяОбласть = ОбластьМакета.Область(1,4,1,4);
					ОбластьМакета.ТекущаяОбласть = ОбластьМакета.Область(1,1,1,1);
					ШрифтПотолка = Новый Шрифт (ОбластьМакета.ТекущаяОбласть.Шрифт,,,Истина);
					ОбластьМакета.ТекущаяОбласть.Шрифт = ШрифтПотолка;
				КонецЕсли;

				//Вес = Товары.Вес * Товары.Количество;
				//Попытка
				//	ОбластьМакета.Параметры.Вес = Вес;
				//Исключение
				//КонецПопытки;
								
				ТабличныйДокумент.Присоединить(ОбластьМакета);
				
				НомерСтроки = НомерСтроки + 1;

				ИтогоВес = ИтогоВес + Товары.Вес;
				Сумма = Сумма + Товары.Сумма;
			Исключение
			КонецПопытки;
			
			Если ВариантФормированияПФЗаказаПокупателя = 4 Тогда
				ТребуетсяВыводПодытога = Ложь;
				Если Товары.ЕстьПотолок = 1 Тогда
					Если ТаблицаТоварыИУслуги.Индекс(Товары)+1 = ТаблицаТоварыИУслуги.Количество() Тогда // последняя строка
						ТребуетсяВыводПодытога = Истина;
					Иначе
						СледующаяСТрокаТЗ = ТаблицаТоварыИУслуги[ТаблицаТоварыИУслуги.Индекс(Товары)+1];
						Если НЕ СледующаяСТрокаТЗ.НомерСтрокиПотолка = Товары.НомерСтрокиПотолка Тогда
							ТребуетсяВыводПодытога = Истина;
							ТекНомерСтрокиПотолка = СледующаяСТрокаТЗ.НомерСтрокиПотолка;
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;
				
				ВесПодытог   = ВесПодытог + Товары.Вес;
				СуммаПодытог = СуммаПодытог + Товары.Сумма;
					
				Если ТребуетсяВыводПодытога Тогда
					
					Попытка
						ОбластьМакета = Макет.ПолучитьОбласть("СтрокаПодытог"+ВставкаСкидок+"|НомерСтроки");
						ОбластьМакета.Параметры.Заполнить(ДанныеПечати);
						ОбластьМакета.Параметры.Заполнить(Товары);
						ТабличныйДокумент.Вывести(ОбластьМакета);
						
						Если ВыводитьАртикул Тогда
							ОбластьМакета = Макет.ПолучитьОбласть("СтрокаПодытог"+ВставкаСкидок+"|Артикул");
							ОбластьМакета.Параметры.Заполнить(ДанныеПечати);
							ОбластьМакета.Параметры.Заполнить(Товары);
							ТабличныйДокумент.Присоединить(ОбластьМакета);
						КонецЕсли;	
						
						ОбластьМакета = Макет.ПолучитьОбласть("СтрокаПодытог"+ВставкаСкидок+"|Данные");
						ОбластьМакета.Параметры.Заполнить(ДанныеПечати);
						ОбластьМакета.Параметры.Заполнить(Товары);
						ОбластьМакета.Параметры.Сумма = СуммаПодытог;
						ОбластьМакета.Параметры.Вес   = ВесПодытог;
						ТабличныйДокумент.Присоединить(ОбластьМакета);
						
					Исключение
					КонецПопытки;
					
					СуммаПодытог = 0;
					ВесПодытог = 0;
				Иначе
					//ВесПодытог   = ВесПодытог + Вес;
					//СуммаПодытог = СуммаПодытог + Товары.Сумма;	
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		
		ПрефиксОбласти = ?(ДанныеПечати.ОрганизацияЯвляетсяПлательщикомНДС, "ИтогоНДС", "Итого");
			  
		Попытка
			ОбластьМакета = ?(НЕ ЕстьСкидка, Макет.ПолучитьОбласть(ПрефиксОбласти + "|НомерСтроки"), Макет.ПолучитьОбласть(ПрефиксОбласти + "Скидка|НомерСтроки"));
			ОбластьМакета.Параметры.Заполнить(ДанныеПечати);
			ТабличныйДокумент.Вывести(ОбластьМакета);
			
			Если ВыводитьАртикул Тогда
				ОбластьМакета = ?(НЕ ЕстьСкидка, Макет.ПолучитьОбласть(ПрефиксОбласти + "|Артикул"), Макет.ПолучитьОбласть(ПрефиксОбласти + "Скидка|Артикул"));
				ОбластьМакета.Параметры.Заполнить(ДанныеПечати);
				ТабличныйДокумент.Присоединить(ОбластьМакета);
			КонецЕсли;	
			
			ОбластьМакета = ?(НЕ ЕстьСкидка, Макет.ПолучитьОбласть(ПрефиксОбласти + "|Данные"), Макет.ПолучитьОбласть(ПрефиксОбласти + "Скидка|Данные"));
			ОбластьМакета.Параметры.Заполнить(ДанныеПечати);
			Попытка
				Если ДанныеПечати.ОрганизацияЯвляетсяПлательщикомНДС И ДанныеПечати.ИтогоСуммаНДС = 0 Тогда			
					ОбластьМакета.Параметры.ИтогоСуммаНДС = "-";
				КонецЕсли;
			Исключение
			КонецПопытки;
			ТабличныйДокумент.Присоединить(ОбластьМакета);
		Исключение
		КонецПопытки;
		
		Попытка 
			ОбластьМакета = Макет.ПолучитьОбласть("СтрокаВсегоИПрописью");
			ОбластьМакета.Параметры.Заполнить(ДанныеПечати);
			Попытка
				ОбластьМакета.Параметры.СуммаДокументаПрописью = 
					РаботаСВалютой.СформироватьЧислоПрописьюВсп(ДанныеПечати.СуммаДокумента, ДанныеПечати.Валюта, "Л=ru_RU;ДП=Ложь");
			Исключение
			КонецПопытки;		
			ТабличныйДокумент.Вывести(ОбластьМакета);
		Исключение
		КонецПопытки;
		
		// #13343 		
		Если ЗначениеЗаполнено(ДанныеПечати.Примечание) Тогда
			Попытка
				ОбластьМакета = Макет.ПолучитьОбласть("Примечание");
				ОбластьМакета.Параметры.Заполнить(ДанныеПечати);
				ТабличныйДокумент.Вывести(ОбластьМакета);
			Исключение
			КонецПопытки;
		КонецЕсли;
		
		Попытка
			ОбластьМакета = Макет.ПолучитьОбласть("Подписи");
			ОбластьМакета.Параметры.Заполнить(ДанныеПечати);
			ТабличныйДокумент.Вывести(ОбластьМакета);
		Исключение
		КонецПопытки;
		
		Попытка
			ОбластьМакета = Макет.ПолучитьОбласть("Подвал");
			ОбластьМакета.Параметры.Заполнить(ДанныеПечати);
			ТабличныйДокумент.Вывести(ОбластьМакета);
		Исключение
		КонецПопытки;

        // В табличном документе необходимо задать имя области, в которую был 
        // выведен объект. Нужно для возможности печати комплектов документов.
		Если НЕ ОбъектыПечати = Неопределено Тогда
	        УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабличныйДокумент, 
	            НомерСтрокиНачало, ОбъектыПечати, ДанныеПечати.Ссылка);
		КонецЕсли;	
    КонецЦикла;
    Возврат ТабличныйДокумент;
	
КонецФункции

Функция СформироватьПечатнуюФормуЗаказаПокупателяСводно(МассивОбъектов, ОбъектыПечати) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	ДанныеДокумента.Контрагент КАК Контрагент
	|ИЗ
	|	Документ.ЗаказПокупателя КАК ДанныеДокумента
	|ГДЕ
	|	ДанныеДокумента.Ссылка В(&МассивОбъектов)";

	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Если Выборка.Количество() > 1 Тогда
		ВызватьИсключение "Контрагенты в выделенных документах различаются, печать сводной таблицы невозможна.";	
	КонецЕсли;
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.АвтоМасштаб         = Истина; //#14053
	ТабличныйДокумент.ИмяПараметровПечати 	= "ПараметрыПечати_ЗаказПокупателя_Сводно";
	Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.ЗаказПокупателя.ПФ_MXL_ЗаказПокупателя");
	ВыводитьАртикул = Константы.ВыводитьАртикулНоменклатурыВПечатныхФормах.Получить();
	
	СтруктураДанныхДляПечати = ПолучитьДанныеДляПечатныхФорм(МассивОбъектов);
	ТаблицаДанныеПечати = СтруктураДанныхДляПечати.РезультатПоШапке.Выгрузить();
	ВыборкаПоТоварам = СтруктураДанныхДляПечати.РезультатПоТабличнойЧастиТовары.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	ДополнитьДанныеДляПечатныхФорм(ТаблицаДанныеПечати);
	
	ШапкаОрганизация = "";
	ШапкаПредставлениеКонтрагента = "";
	Если ТаблицаДанныеПечати.Количество() > 0 Тогда
		 ШапкаОрганизация = ТаблицаДанныеПечати[0].Организация;
	     ШапкаПредставлениеКонтрагента = ТаблицаДанныеПечати[0].ПредставлениеКонтрагента;
	 КонецЕсли;
	 
	ИтогоСумма = 0;
	
	Попытка
		ОбластьЗаголовок 	= Макет.ПолучитьОбласть("Заголовок");
		ТекстЗаголовка = "Заказы покупателей";
		ОбластьЗаголовок.Параметры.ТекстЗаголовка = ТекстЗаголовка;
		ТабличныйДокумент.Вывести(ОбластьЗаголовок);
	Исключение
	КонецПопытки;
	
	Попытка
		ОбластьОрганизация 	= Макет.ПолучитьОбласть("Организация");
		ОбластьОрганизация.Параметры.РасширенноеПредставлениеОрганизации = ШапкаОрганизация; // №12321 было: ОбластьОрганизация.Параметры.Организация = ШапкаОрганизация;
		ТабличныйДокумент.Вывести(ОбластьОрганизация);
	Исключение
	КонецПопытки;
	
	Попытка
		ОбластьКонтрагент 	= Макет.ПолучитьОбласть("Покупатель");
		ОбластьКонтрагент.Параметры.РасширенноеПредставлениеКонтрагента = ШапкаПредставлениеКонтрагента; // №12321 было: ОбластьКонтрагент.Параметры.ПредставлениеКонтрагента = ШапкаПредставлениеКонтрагента;
		ТабличныйДокумент.Вывести(ОбластьКонтрагент);
	Исключение
	КонецПопытки;
	
	// Изменения размера колоноки, в зависимости от вывода Артикула
	Если Не ВыводитьАртикул Тогда
		Попытка
			Макет.Область("ПерваяКолонкаТовара").ШиринаКолонки = Макет.Область("ПерваяКолонкаТовара").ШиринаКолонки + Макет.Область("Артикул").ШиринаКолонки;
		Исключение
		КонецПопытки;
	КонецЕсли;
	
	ОбластьШапкаТаблицы = Макет.ПолучитьОбласть("ШапкаТаблицы|НомерСтроки");
	ТабличныйДокумент.Вывести(ОбластьШапкаТаблицы);
	
	Если ВыводитьАртикул Тогда
		ОбластьШапкаТаблицы = Макет.ПолучитьОбласть("ШапкаТаблицы|Артикул");
		ТабличныйДокумент.Присоединить(ОбластьШапкаТаблицы);
	КонецЕсли;	
	
	ОбластьШапкаТаблицы = Макет.ПолучитьОбласть("ШапкаТаблицы|Данные");
	ТабличныйДокумент.Присоединить(ОбластьШапкаТаблицы);
	
	Для каждого ДанныеПечати из ТаблицаДанныеПечати Цикл
		
		Попытка 
			НомерЧисло = ПрефиксацияОбъектовКлиентСервер.НомерНаПечать(ДанныеПечати.Номер);
		Исключение
			НомерЧисло = ДанныеПечати.Номер;
		КонецПопытки;
		
		ОбластьСтрокаСводно = Макет.ПолучитьОбласть("СтрокаСводно|НомерСтроки");
		ОбластьСтрокаСводно.Параметры.Заполнить(ДанныеПечати);
		Попытка 
			ОбластьСтрокаСводно.Параметры.Номер = НомерЧисло;
			ОбластьСтрокаСводно.Параметры.ДатаФормат = Формат(ДанныеПечати.ДатаДокумента, "ДЛФ=D");
		Исключение
		КонецПопытки;
		ТабличныйДокумент.Вывести(ОбластьСтрокаСводно);
		
		Если ВыводитьАртикул Тогда
			ОбластьСтрокаСводно = Макет.ПолучитьОбласть("СтрокаСводно|Артикул");
			ОбластьСтрокаСводно.Параметры.Заполнить(ДанныеПечати);
			ТабличныйДокумент.Присоединить(ОбластьСтрокаСводно);
		КонецЕсли;
		
		ОбластьСтрокаСводно = Макет.ПолучитьОбласть("СтрокаСводно|Данные");
		ОбластьСтрокаСводно.Параметры.Заполнить(ДанныеПечати);
		ТабличныйДокумент.Присоединить(ОбластьСтрокаСводно);
				
		ИтогоСумма = ИтогоСумма + ДанныеПечати.СуммаДокумента;
		НомерСтроки = 1;
		
		СтруктураПоиска = Новый Структура("Ссылка", ДанныеПечати.Ссылка);		
		ВыборкаПоТоварам.Сбросить();
		Если ВыборкаПоТоварам.НайтиСледующий(СтруктураПоиска) Тогда			
			Выборка = ВыборкаПоТоварам.Выбрать();			
			Пока Выборка.Следующий() Цикл				
				
				ОбластьСтрока = Макет.ПолучитьОбласть("Строка|НомерСтроки");
				ОбластьСтрока.Параметры.Заполнить(Выборка);
				ОбластьСтрока.Параметры.НомерСтроки = НомерСтроки;
				ТабличныйДокумент.Вывести(ОбластьСтрока);
				
				Если ВыводитьАртикул Тогда
					ОбластьСтрока = Макет.ПолучитьОбласть("Строка|Артикул");
					ОбластьСтрока.Параметры.Заполнить(Выборка);
					ТабличныйДокумент.Присоединить(ОбластьСтрока);
				КонецЕсли;
				
				ОбластьСтрока = Макет.ПолучитьОбласть("Строка|Данные");
				ОбластьСтрока.Параметры.Заполнить(Выборка);
				ПредставлениеНоменклатуры = Строка(Выборка.Номенклатура) + Строка(ОбщийМодульСервер.ПредставлениеХарактеристики(Выборка.ХарактеристикаНоменклатуры));
				ОбластьСтрока.Параметры.Номенклатура = ПредставлениеНоменклатуры;
				
				Попытка
					Вес = Выборка.Вес * Выборка.Количество;
					ОбластьСтрока.Параметры.Вес = Вес;
				Исключение
				КонецПопытки;
				ТабличныйДокумент.Присоединить(ОбластьСтрока);
				
				НомерСтроки = НомерСтроки + 1;
			КонецЦикла;
		КонецЕсли;		
	КонецЦикла;
	
	Попытка
		ОбластьИтогоСводно = Макет.ПолучитьОбласть("ИтогоСводно|НомерСтроки");
		ОбластьИтогоСводно.Параметры.Заполнить(ДанныеПечати);
		ТабличныйДокумент.Вывести(ОбластьИтогоСводно);
		
		Если ВыводитьАртикул Тогда
			ОбластьИтогоСводно = Макет.ПолучитьОбласть("ИтогоСводно|Артикул");
			ОбластьИтогоСводно.Параметры.Заполнить(ДанныеПечати);
			ТабличныйДокумент.Присоединить(ОбластьИтогоСводно);
		КонецЕсли;
		
