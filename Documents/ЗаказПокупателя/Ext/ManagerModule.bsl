	МассивИменЭлементов.Добавить("ТоварыСуммаРучнойСкидки");
		
	МассивИменЭлементов.Добавить("ТоварыДеревоОчиститьСкидки");
	МассивИменЭлементов.Добавить("ТоварыДеревоОкруглить");
	МассивИменЭлементов.Добавить("ТоварыДеревоОкруглитьСтоимостьПотолков");

	МассивИменЭлементов.Добавить("ТоварыОчиститьСкидки");
	МассивИменЭлементов.Добавить("ТоварыОкруглить");
	МассивИменЭлементов.Добавить("ТоварыОкруглитьСтоимостьПотолков");
	
	МассивИменЭлементов.Добавить("ВидСкидки");
	МассивИменЭлементов.Добавить("УстановитьОбщийПроцентСкидки");
	
	Возврат МассивИменЭлементов;
	
КонецФункции

#КонецОбласти

#Область АвтоматическоеФормированиеПеремещения

// Формирует или актуализирует документ "Перемещение товаров" по заказу покупателя.
//
// Перемещение содержит продукцию заказа — номенклатуру с видом "Потолок" или "Отрез", у которой
// заполнен реквизит "ЗаказНаПроизводство", а связанный заказ на производство в статусе "В производстве".
//
// Склады перемещения: отправитель = ЗаказПокупателя.СкладМатериалов, получатель = ЗаказПокупателя.Склад.
// Если склад товаров совпадает со складом материалов, перемещение не требуется (не создаётся,
// а имеющееся помечается на удаление).
// Синхронизируются склады и строки (добавление/удаление/количество); если подходящих строк
// не осталось — перемещение помечается на удаление.
//
// Создание нового документа выполняется только при СоздаватьНовое = Истина (вызывается по завершении
// оформления заказов на производство). При проведении заказа покупателя (СоздаватьНовое = Ложь)
// лишь актуализируется ранее созданное перемещение — это исключает дубли при пакетном
// (поочерёдном) оформлении заказов на производство.
//
// Параметры:
//   Заказ          - ДокументОбъект.ЗаказПокупателя, ДокументСсылка.ЗаказПокупателя - заказ покупателя.
//   СоздаватьНовое - Булево - создавать перемещение, если оно ещё не существует.
//
Процедура СформироватьПеремещениеТоваровПоЗаказу(Заказ, СоздаватьНовое = Истина) Экспорт

	// Обязательное условие: статус заказа покупателя — "В работе".
	Если НЕ Заказ.ТекущийСтатус = Справочники.СтатусыЗаказовПокупателей.ВРаботе Тогда
		Возврат;
	КонецЕсли;

	// Перемещение формируется автоматически — снимаем ограничения прав доступа.
	// Привилегированный режим автоматически сбрасывается при выходе из процедуры.
	УстановитьПривилегированныйРежим(Истина);

	// Перемещение нужно только если склад товаров отличается от склада материалов.
	// При совпадении складов продукцию считаем пустой: новое не создаётся, а имеющееся
	// очищается и помечается на удаление в АктуализироватьПеремещениеТоваров.
	Если Заказ.Склад = Заказ.СкладМатериалов Тогда
		СтрокиПродукции = Новый Массив;
	Иначе
		СтрокиПродукции = ПродукцияВПроизводстве(Заказ);
	КонецЕсли;

	ПеремещениеСсылка = ПеремещениеТоваровПоЗаказу(Заказ.Ссылка);

	Если ЗначениеЗаполнено(ПеремещениеСсылка) Тогда
		АктуализироватьПеремещениеТоваров(ПеремещениеСсылка, Заказ, СтрокиПродукции);
	ИначеЕсли СоздаватьНовое И СтрокиПродукции.Количество() > 0 Тогда
		СоздатьПеремещениеТоваровПоЗаказу(Заказ, СтрокиПродукции);
	КонецЕсли;

КонецПроцедуры

// Возвращает продукцию заказа покупателя — потолки/отрезы, привязанные к заказу на производство
// в статусе "В производстве".
//
// Данные читаются ЗАПРОСОМ (а не через Заказ.Товары): при пакетном оформлении реквизит строки
// "ЗаказНаПроизводство" проставляется фоновыми заданиями (другими сессиями), и кэш объектов по
// ссылке в текущей сессии может быть устаревшим — запрос всегда возвращает актуальные данные из БД.
//
// Параметры:
//   Заказ - ДокументОбъект.ЗаказПокупателя, ДокументСсылка.ЗаказПокупателя
//
// Возвращаемое значение:
//   Массив из Структур с полями строки: Номенклатура, ХарактеристикаНоменклатуры, СерияНоменклатуры,
//   ЕдиницаИзмерения, Коэффициент, Количество, ЗаказНаПроизводство.
//
Функция ПродукцияВПроизводстве(Заказ)

	Результат = Новый Массив;

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Заказ", Заказ.Ссылка);
	Запрос.УстановитьПараметр("Статус", Справочники.СтатусыЗаказовНаПроизводство.ВПроизводстве);
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТоварыЗаказа.Номенклатура КАК Номенклатура,
	|	ТоварыЗаказа.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	|	ТоварыЗаказа.СерияНоменклатуры КАК СерияНоменклатуры,
	|	ТоварыЗаказа.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	ТоварыЗаказа.Коэффициент КАК Коэффициент,
	|	ТоварыЗаказа.Количество КАК Количество,
	|	ТоварыЗаказа.ЗаказНаПроизводство КАК ЗаказНаПроизводство
	|ИЗ
	|	Документ.ЗаказПокупателя.Товары КАК ТоварыЗаказа
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаказНаПроизводство КАК ЗаказПроизводства
	|		ПО ТоварыЗаказа.ЗаказНаПроизводство = ЗаказПроизводства.Ссылка
	|			И ЗаказПроизводства.ТекущийСтатус = &Статус
	|ГДЕ
	|	ТоварыЗаказа.Ссылка = &Заказ
	|
	|УПОРЯДОЧИТЬ ПО
	|	ТоварыЗаказа.НомерСтроки";

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если НЕ Справочники.ВидыНоменклатуры.ЭтоНоменклатураПотолкаИлиОтреза(Выборка.Номенклатура) Тогда
			Продолжить;
		КонецЕсли;
		СтрокаПродукции = Новый Структура("Номенклатура, ХарактеристикаНоменклатуры, СерияНоменклатуры, ЕдиницаИзмерения, Коэффициент, Количество, ЗаказНаПроизводство");
		ЗаполнитьЗначенияСвойств(СтрокаПродукции, Выборка);
		Результат.Добавить(СтрокаПродукции);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Возвращает ссылку на ранее сформированное автоматически перемещение по заказу покупателя.
// Автоматическое перемещение определяется по реквизитам шапки: "Основание" = заказ покупателя
// и "ВидПеремещения" = "Перемещение готовой продукции".
//
// Параметры:
//   ЗаказСсылка - ДокументСсылка.ЗаказПокупателя
//
// Возвращаемое значение:
//   ДокументСсылка.ПеремещениеТоваров - найденное перемещение либо пустая ссылка.
//
Функция ПеремещениеТоваровПоЗаказу(ЗаказСсылка)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Основание", ЗаказСсылка);
	Запрос.УстановитьПараметр("ВидПеремещения", Справочники.ВидыПеремещений.ПеремещениеГотовойПродукции);
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	ПеремещениеТоваров.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ПеремещениеТоваров КАК ПеремещениеТоваров
	|ГДЕ
	|	ПеремещениеТоваров.Основание = &Основание
	|	И ПеремещениеТоваров.ВидПеремещения = &ВидПеремещения
	|	И НЕ ПеремещениеТоваров.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	ПеремещениеТоваров.Дата,
	|	ПеремещениеТоваров.Ссылка";

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;

	Возврат Документы.ПеремещениеТоваров.ПустаяСсылка();

КонецФункции

// Создаёт и записывает новое перемещение товаров в статусе "Заявка".
//
// Параметры:
//   ЗаказОбъект     - ДокументОбъект.ЗаказПокупателя - заказ-источник.
//   СтрокиПродукции - Массив - строки ТЧ "Товары" заказа (потолки/отрезы в производстве).
//
Процедура СоздатьПеремещениеТоваровПоЗаказу(ЗаказОбъект, СтрокиПродукции)

	ПеремещениеОбъект = Документы.ПеремещениеТоваров.СоздатьДокумент();
	ОбщийМодуль.ЗаполнитьШапкуДокумента(ПеремещениеОбъект);

	Если НЕ ЗначениеЗаполнено(ПеремещениеОбъект.Дата) Тогда
		ПеремещениеОбъект.Дата = ТекущаяДатаСеанса();
	КонецЕсли;

	ПеремещениеОбъект.Организация = ЗаказОбъект.Организация;
	ПеремещениеОбъект.ВидПеремещения = Справочники.ВидыПеремещений.ПеремещениеГотовойПродукции;
	ПеремещениеОбъект.СкладОтправитель = ЗаказОбъект.СкладМатериалов;
	ПеремещениеОбъект.СкладПолучатель = ЗаказОбъект.Склад;
	ПеремещениеОбъект.Основание = ЗаказОбъект.Ссылка;

	// Документ — заявка на перемещение: движений по регистрам не формирует.
	ПеремещениеОбъект.СозданПриИспользованииСтатусовПеремещений = Истина;
	ПеремещениеОбъект.ТекущийСтатус = Перечисления.СтатусыПеремещений.Заявка;

	ЗаполнитьСтрокиПеремещения(ПеремещениеОбъект, СтрокиПродукции);

	ПеремещениеОбъект.Записать(РежимЗаписиДокумента.Запись);

КонецПроцедуры

// Заполняет табличную часть "Товары" перемещения строками продукции заказа покупателя.
// Существующие строки очищаются.
//
// Параметры:
//   ПеремещениеОбъект - ДокументОбъект.ПеремещениеТоваров
//   СтрокиПродукции   - Массив - строки ТЧ "Товары" заказа покупателя.
//
Процедура ЗаполнитьСтрокиПеремещения(ПеремещениеОбъект, СтрокиПродукции)

	ПеремещениеОбъект.Товары.Очистить();

	Для Каждого СтрокаЗаказа Из СтрокиПродукции Цикл
		НоваяСтрока = ПеремещениеОбъект.Товары.Добавить();
		НоваяСтрока.Номенклатура = СтрокаЗаказа.Номенклатура;
		НоваяСтрока.ХарактеристикаНоменклатуры = СтрокаЗаказа.ХарактеристикаНоменклатуры;
		НоваяСтрока.СерияНоменклатуры = СтрокаЗаказа.СерияНоменклатуры;
		НоваяСтрока.ЕдиницаИзмерения = СтрокаЗаказа.ЕдиницаИзмерения;
		НоваяСтрока.Коэффициент = СтрокаЗаказа.Коэффициент;
		НоваяСтрока.Количество = СтрокаЗаказа.Количество;
		НоваяСтрока.Заказ = СтрокаЗаказа.ЗаказНаПроизводство;
	КонецЦикла;

КонецПроцедуры

// Актуализирует ранее созданное перемещение при повторном проведении заказа покупателя:
// обновляет склады и синхронизирует строки (добавление/удаление/количество).
// Если подходящих строк не осталось — помечает перемещение на удаление.
// Отправленные, полученные и отменённые перемещения не изменяются.
//
// Параметры:
//   ПеремещениеСсылка - ДокументСсылка.ПеремещениеТоваров
//   ЗаказОбъект       - ДокументОбъект.ЗаказПокупателя - проводимый заказ покупателя.
//   СтрокиПродукции   - Массив - актуальные строки продукции заказа (потолки/отрезы в производстве).
//
Процедура АктуализироватьПеремещениеТоваров(ПеремещениеСсылка, ЗаказОбъект, СтрокиПродукции)

	ПеремещениеОбъект = ПеремещениеСсылка.ПолучитьОбъект();

	Если НЕ ПеремещениеМожноИзменять(ПеремещениеОбъект.ТекущийСтатус) Тогда
		Возврат;
	КонецЕсли;

	ЕстьИзменения = Ложь;

	Если НЕ ПеремещениеОбъект.ВидПеремещения = Справочники.ВидыПеремещений.ПеремещениеГотовойПродукции Тогда
		ПеремещениеОбъект.ВидПеремещения = Справочники.ВидыПеремещений.ПеремещениеГотовойПродукции;
		ЕстьИзменения = Истина;
	КонецЕсли;

	Если НЕ ПеремещениеОбъект.СкладОтправитель = ЗаказОбъект.СкладМатериалов Тогда
		ПеремещениеОбъект.СкладОтправитель = ЗаказОбъект.СкладМатериалов;
		ЕстьИзменения = Истина;
	КонецЕсли;

	Если НЕ ПеремещениеОбъект.СкладПолучатель = ЗаказОбъект.Склад Тогда
		ПеремещениеОбъект.СкладПолучатель = ЗаказОбъект.Склад;
		ЕстьИзменения = Истина;
	КонецЕсли;

	Если НЕ СтрокиПеремещенияСовпадают(ПеремещениеОбъект.Товары, СтрокиПродукции) Тогда
		ЗаполнитьСтрокиПеремещения(ПеремещениеОбъект, СтрокиПродукции);
		ЕстьИзменения = Истина;
	КонецЕсли;

	// Строк не осталось — перемещение больше не нужно, помечаем на удаление.
	Если ПеремещениеОбъект.Товары.Количество() = 0 И НЕ ПеремещениеОбъект.ПометкаУдаления Тогда
		ПеремещениеОбъект.ПометкаУдаления = Истина;
		ЕстьИзменения = Истина;
	КонецЕсли;

	Если ЕстьИзменения Тогда
		ПеремещениеОбъект.Записать(РежимЗаписиДокумента.Запись);
	КонецЕсли;

КонецПроцедуры

// Сравнивает строки перемещения с актуальными строками продукции заказа
// (по номенклатуре, характеристике, серии, единице, коэффициенту, заказу на производство и количеству).
//
// Параметры:
//   ТоварыПеремещения - ТабличнаяЧастьДокумента.ПеремещениеТоваров.Товары
//   СтрокиПродукции   - Массив - строки ТЧ "Товары" заказа покупателя.
//
// Возвращаемое значение:
//   Булево - Истина, если наборы строк совпадают.
//
Функция СтрокиПеремещенияСовпадают(ТоварыПеремещения, СтрокиПродукции)

	Если ТоварыПеремещения.Количество() <> СтрокиПродукции.Количество() Тогда
		Возврат Ложь;
	КонецЕсли;

	ПодписиТекущие  = ПодписиСтрок(ТоварыПеремещения, "Заказ");
	ПодписиЖелаемые = ПодписиСтрок(СтрокиПродукции, "ЗаказНаПроизводство");

	Если ПодписиТекущие.Количество() <> ПодписиЖелаемые.Количество() Тогда
		Возврат Ложь;
	КонецЕсли;

	Для Каждого Элемент Из ПодписиЖелаемые Цикл
		Если ПодписиТекущие[Элемент.Ключ] <> Элемент.Значение Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;

КонецФункции

// Строит соответствие "подпись строки" -> "количество вхождений" для набора строк.
//
// Параметры:
//   Коллекция          - Массив, ТабличнаяЧасть - строки с реквизитами номенклатуры и количества.
//   ИмяРеквизитаЗаказ  - Строка - имя реквизита ссылки на заказ на производство в строке.
//
// Возвращаемое значение:
//   Соответствие - ключ: строковая подпись строки, значение: число повторов.
//
Функция ПодписиСтрок(Коллекция, ИмяРеквизитаЗаказ)

	Подписи = Новый Соответствие;

	Для Каждого Строка Из Коллекция Цикл
		Подпись = XMLСтрока(Строка.Номенклатура) + "|"
			+ XMLСтрока(Строка.ХарактеристикаНоменклатуры) + "|"
			+ XMLСтрока(Строка.СерияНоменклатуры) + "|"
			+ XMLСтрока(Строка.ЕдиницаИзмерения) + "|"
			+ XMLСтрока(Строка.Коэффициент) + "|"
			+ XMLСтрока(Строка.Количество) + "|"
			+ XMLСтрока(Строка[ИмяРеквизитаЗаказ]);
		Подписи[Подпись] = ?(Подписи[Подпись] = Неопределено, 0, Подписи[Подпись]) + 1;
	КонецЦикла;

	Возврат Подписи;

КонецФункции

// Истина, если перемещение в статусе, допускающем автоматическую актуализацию складов
// (не заполнен / "Заявка" / "Собран"). Статусы "Отправлен", "Получен", "Отменен" не изменяем.
//
// Параметры:
//   ТекущийСтатус - ПеречислениеСсылка.СтатусыПеремещений
//
// Возвращаемое значение:
//   Булево
//
Функция ПеремещениеМожноИзменять(ТекущийСтатус)

	Возврат НЕ ЗначениеЗаполнено(ТекущийСтатус)
		ИЛИ ТекущийСтатус = Перечисления.СтатусыПеремещений.Заявка
		ИЛИ ТекущийСтатус = Перечисления.СтатусыПеремещений.Собран;

КонецФункции

#КонецОбласти

#КонецЕсли