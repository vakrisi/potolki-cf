	//|	ВЫБОР
	// в заказе нет товара, он отгружен и полностью возвращен, такую позицию пропускаем
	//++ №12533 переделываем, т.к. не учитывал частичный возврат
	//|		КОГДА ЕСТЬNULL(ВТ_Товары.Заказано, 0) = 0 И ЕСТЬNULL(ЗаказыПокупателейОбороты.КоличествоВозврат, 0) > 0
	//|			И ЕСТЬNULL(ЗаказыПокупателейОбороты.КоличествоВозврат, 0) = ЕСТЬNULL(ЗаказыПокупателейОбороты.КоличествоОтгружено, 0)
	//|				ТОГДА 0
	//|		ИНАЧЕ ЕСТЬNULL(ВТ_Товары.Заказано, 0) - ЕСТЬNULL(ЗаказыПокупателейОбороты.КоличествоОтгружено, 0)
	//|	КОНЕЦ КАК КоличествоОстаток,
	//|	ВЫБОР
	//|		КОГДА ЕСТЬNULL(ВТ_Товары.СуммаЗаказано, 0) = 0 И ЕСТЬNULL(ЗаказыПокупателейОбороты.СуммаВозврат, 0) > 0
	//|			И ЕСТЬNULL(ЗаказыПокупателейОбороты.СуммаВозврат, 0) = ЕСТЬNULL(ЗаказыПокупателейОбороты.СуммаОтгружено, 0)
	//|				ТОГДА 0
	//|		ИНАЧЕ ЕСТЬNULL(ВТ_Товары.СуммаЗаказано, 0) - ЕСТЬNULL(ЗаказыПокупателейОбороты.СуммаОтгружено, 0)
	//|	КОНЕЦ КАК СуммаОстаток
	|	ЕСТЬNULL(ВТ_Товары.Заказано, 0) - ЕСТЬNULL(ЗаказыПокупателейОбороты.КоличествоОтгружено, 0) КАК КоличествоОстаток,
	|	ЕСТЬNULL(ВТ_Товары.СуммаЗаказано, 0) - ЕСТЬNULL(ЗаказыПокупателейОбороты.СуммаОтгружено, 0) КАК СуммаОстаток
	//++ №12533 переделываем, т.к. не учитывал частичный возврат
	|
	//-- №8749
	|ИЗ
	|	ВТ_Товары КАК ВТ_Товары
	//++ №8749
	//|		ПОЛНОЕ СОЕДИНЕНИЕ РегистрНакопления.ЗаказыПокупателей.Обороты(, , , ЗаказНаПроизводство = &Заказ) КАК ЗаказыПокупателейОбороты
	//|		ПО ВТ_Товары.Номенклатура = ЗаказыПокупателейОбороты.Номенклатура
	|
	|	ПОЛНОЕ СОЕДИНЕНИЕ ВТ_ЗаказыПокупателейОбороты КАК ЗаказыПокупателейОбороты
	|	ПО ВТ_Товары.Номенклатура = ЗаказыПокупателейОбороты.Номенклатура
	//-- №8749
	|
	|
	|";
		
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		Если Выборка.КоличествоОстаток > 0 Тогда
			СтруктураВозврата.Результат = Ложь;
			СтруктураВозврата.Описание = СтруктураВозврата.Описание + 
				"По данному заказу номенклатуры """ + Выборка.Номенклатура + """ отгружено на " + Выборка.КоличествоОстаток + " ед. меньше, чем заказано." + Символы.ПС;
			
		//++ #9777	
		ИначеЕсли Выборка.СуммаОстаток > 0 Тогда
			СтруктураВозврата.Результат = Ложь;
			СтруктураВозврата.Описание = СтруктураВозврата.Описание + 
				"По данному заказу номенклатуры """ + Выборка.Номенклатура + """ отгружено на сумму " + Выборка.СуммаОстаток + " меньше, чем заказано." + Символы.ПС;
		//-- #9777
		
		ИначеЕсли Выборка.КоличествоОстаток  < 0 Тогда
			СтруктураВозврата.Результат = Ложь;
			СтруктураВозврата.Описание = СтруктураВозврата.Описание + 
				"По данному заказу номенклатуры """ + Выборка.Номенклатура + """ отгружено на " + (-1)*Выборка.КоличествоОстаток + " ед. больше, чем заказано." + Символы.ПС;			
			
		//++ #9777
		ИначеЕсли Выборка.СуммаОстаток  < 0 Тогда
			СтруктураВозврата.Результат = Ложь;
			СтруктураВозврата.Описание = СтруктураВозврата.Описание + 
				"По данному заказу номенклатуры """ + Выборка.Номенклатура + """ отгружено на сумму " + (-1)*Выборка.СуммаОстаток + " больше, чем заказано." + Символы.ПС;
		//-- #9777	
		КонецЕсли;
			
	КонецЦикла;
	
	Возврат СтруктураВозврата;
	
КонецФункции

//возвращает "Истина" при наличии РТиУ по заказу
Функция ЕстьРеализацииПоЗаказу(Знач ЗаказПокупателя, Знач ВыдаватьСообщения = Истина) Экспорт
	
	Если НЕ ТипЗнч(ЗаказПокупателя) = Тип("ДокументСсылка.ЗаказПокупателя") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Результат = Ложь;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЗаказыПокупателейОбороты.Регистратор КАК Регистратор
	|ИЗ
	|	РегистрНакопления.ЗаказыПокупателей.Обороты(, , Регистратор, ЗаказНаПроизводство = &ЗаказПокупателя) КАК ЗаказыПокупателейОбороты
	|
	//++ №8460 не учитываем реализации, по которым полностью возвращены товары
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.Продажи.Обороты() КАК Продажи
	|		ПО ЗаказыПокупателейОбороты.Регистратор = Продажи.ДокументПродажи
	|		И НЕ Продажи.Номенклатура.ВидНоменклатуры = Значение(Справочник.ВидыНоменклатуры.Услуга)
	//-- №8460
	|
	|ГДЕ
	|	ЗаказыПокупателейОбороты.КоличествоРасход > 0
	//++ №8460
	|	И НЕ ЕСТЬNULL(Продажи.КоличествоОборот, 0) = 0
	//-- №8460
	|";
	Запрос.УстановитьПараметр("ЗаказПокупателя", ЗаказПокупателя);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат = Истина;
		Если ВыдаватьСообщения Тогда
			Сообщить("По " + ЗаказПокупателя + " имеется документ расхода - " + Выборка.Регистратор);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

//возвращает "Истина" при наличии выпусков продукции по потолкам, присутствубщим в данном заказе
Функция ЕстьВыпускиПродукцииПоПотолкамЗаказа(Знач ЗаказПокупателя, Знач ВыдаватьСообщения = Истина) Экспорт
	
	Если НЕ ТипЗнч(ЗаказПокупателя) = Тип("ДокументСсылка.ЗаказПокупателя") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	СписокПотолков = Новый СписокЗначений;
	
	Для Каждого ТекущаяСтрока Из ЗаказПокупателя.Товары Цикл
		Если Справочники.ВидыНоменклатуры.ЭтоНоменклатураУникальногоПотолкаИлиОтреза(ТекущаяСтрока.Номенклатура) Тогда
			СписокПотолков.Добавить(ТекущаяСтрока.Номенклатура);
		КонецЕсли;
	КонецЦикла;
	
	Результат = Ложь;
	
	Запрос = Новый Запрос;
	//++ №13857
	//
	// прежний вариант:
	//Запрос.Текст = 
	//"ВЫБРАТЬ
	//|	ТоварыНаСкладахОбороты.Регистратор КАК Регистратор,
	//|	ТоварыНаСкладахОбороты.Номенклатура КАК Номенклатура
	//|ИЗ
	//|	РегистрНакопления.ТоварыНаСкладах.Обороты(, , Регистратор, Номенклатура В (&СписокПотолков)) КАК ТоварыНаСкладахОбороты
	//|ГДЕ
	//|	ТоварыНаСкладахОбороты.Регистратор ССЫЛКА Документ.ВыпускПродукции
	//|	И ТоварыНаСкладахОбороты.КоличествоПриход > 0";
	
	// новый вариант:
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТоварыНаСкладахОбороты.Регистратор КАК Регистратор,
	|	ТоварыНаСкладахОбороты.Номенклатура КАК Номенклатура
	|ИЗ
	|	РегистрНакопления.ТоварыНаСкладах.Обороты(, , Регистратор, Номенклатура В (&СписокПотолков)) КАК ТоварыНаСкладахОбороты
	|
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.ЗаказыПокупателейВПроизводстве.Обороты(,, Регистратор, Номенклатура В (&СписокПотолков) И ЗаказПокупателя = &ЗаказПокупателя) КАК ЗаказыПокупателейВПроизводствеОбороты
	|		ПО ТоварыНаСкладахОбороты.Регистратор = ЗаказыПокупателейВПроизводствеОбороты.Регистратор
	|
	|ГДЕ
	|	ТоварыНаСкладахОбороты.Регистратор ССЫЛКА Документ.ВыпускПродукции
	|	И ТоварыНаСкладахОбороты.КоличествоПриход > 0";
	//-- №13857
	
	Запрос.УстановитьПараметр("СписокПотолков", СписокПотолков);
	Запрос.УстановитьПараметр("ЗаказПокупателя", ЗаказПокупателя); // №13857
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат = Истина;
		Если ВыдаватьСообщения Тогда
			Сообщить("По " + Выборка.Номенклатура + " имеется документ выпуска - " + Выборка.Регистратор);
		КонецЕсли;
	КонецЦикла;
	
	Возврат  Результат;
	
КонецФункции

//возвращает "Истина" при наличии РТиУ по заказу
Функция ЕстьЗаказыНаПроизводствоВработе(Знач ЗаказПокупателя, Знач ВыдаватьСообщения = Истина) Экспорт
	
	Если НЕ ТипЗнч(ЗаказПокупателя) = Тип("ДокументСсылка.ЗаказПокупателя") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Результат = Ложь;
	
	//проверяем на отсутствие ЗнП или РТиУ по данному заказу
	СписокСтатусовЗнП = Новый СписокЗначений;
	СписокСтатусовЗнП.Добавить(Справочники.СтатусыЗаказовНаПроизводство.ВПроизводстве);
	СписокСтатусовЗнП.Добавить(Справочники.СтатусыЗаказовНаПроизводство.Произведен);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЗаказНаПроизводство.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ЗаказНаПроизводство КАК ЗаказНаПроизводство
	|ГДЕ
	|	ЗаказНаПроизводство.ДокументОснование = &ДокументОснование
	|	И ЗаказНаПроизводство.Проведен
	|	И ЗаказНаПроизводство.ТекущийСтатус В(&ТекущийСтатус)";
	Запрос.УстановитьПараметр("ДокументОснование", ЗаказПокупателя);
	Запрос.УстановитьПараметр("ТекущийСтатус", СписокСтатусовЗнП);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат = Истина;
		Если ВыдаватьСообщения Тогда
			Сообщить("По данному заказу имеется - " + Выборка.Ссылка + ", который находится в статусе ""В производстве"" или ""Произведен""");
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ВозможенПереводВСтатусОтменен(Знач ЗаказПокупателя, Знач ВыдаватьСообщения = Истина) Экспорт
	
	Результат = Истина;
	
	//проверяем на отсутствие ЗнП или РТиУ по данному заказу
	Если ЕстьЗаказыНаПроизводствоВработе(ЗаказПокупателя, ВыдаватьСообщения) Тогда
		Результат = Ложь;
	КонецЕсли;
	
	//проверяем отсутствие отгрузок по данному заказу
	Если ЕстьРеализацииПоЗаказу(ЗаказПокупателя, ВыдаватьСообщения) Тогда
		Результат = Ложь;
	КонецЕсли;
	
	//проверяем отсутствие выпусков по данному заказу
	Если ЕстьВыпускиПродукцииПоПотолкамЗаказа(ЗаказПокупателя, ВыдаватьСообщения) Тогда
		Если НЕ ОбщийМодульСервер.НастройкаПользователя("РазрешеноПереводитьЗаказыПокупателейВСтатусОтмененПриНаличииВыпускаПотолков") Тогда
			Результат = Ложь;
		КонецЕсли;
	КонецЕсли;

	Возврат Результат;
	
КонецФункции

//nva+++
Функция ЕстьЗаказныеПозицииИСозданЗаказПоставщику(ЗаказПокупателя, Товары, ВыдаватьСообщения = Истина) Экспорт
	
	Если НЕ ТипЗнч(ЗаказПокупателя) = Тип("ДокументСсылка.ЗаказПокупателя") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Результат = Ложь;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВТ_Товары.Номенклатура КАК Номенклатура,
	|	ВТ_Товары.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	|	ВТ_Товары.Количество КАК Количество
	|ПОМЕСТИТЬ ВТ_Товары
	|ИЗ
	|	&ВТ_Товары КАК ВТ_Товары
	|ГДЕ
	|	ВТ_Товары.Номенклатура В ИЕРАРХИИ(&ГруппаЗаказныхТоваров)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВТ_Товары.Номенклатура КАК Номенклатура,
	|	ВТ_Товары.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	|	ВТ_Товары.Количество КАК ЗаказПокупателяКоличество,
	|	ЗаказПоставщикуТовары.Количество КАК ЗаказПоставщикуКоличество
	|ИЗ
	|	ВТ_Товары КАК ВТ_Товары
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаказПоставщику.Товары КАК ЗаказПоставщикуТовары
	|		ПО ВТ_Товары.Номенклатура = ЗаказПоставщикуТовары.Номенклатура
	|			И ВТ_Товары.ХарактеристикаНоменклатуры = ЗаказПоставщикуТовары.ХарактеристикаНоменклатуры
	|ГДЕ
	|	ЗаказПоставщикуТовары.Ссылка.Основание = &ЗаказПокупателя
	|	И ЗаказПоставщикуТовары.Ссылка.ТекущийСтатус <> ЗНАЧЕНИЕ(Справочник.СтатусыЗаказовПоставщику.Отменен)";
	Запрос.УстановитьПараметр("ЗаказПокупателя", ЗаказПокупателя);
	Запрос.УстановитьПараметр("ВТ_Товары", Товары);
	Запрос.УстановитьПараметр("ГруппаЗаказныхТоваров",  Справочники.Номенклатура.НайтиПоКоду("000382380")); //Заказные товары
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Выборка.ЗаказПокупателяКоличество <> Выборка.ЗаказПоставщикуКоличество Тогда
			Результат = Ложь;
			Если ВыдаватьСообщения Тогда
				Сообщить("По номенклатуре """ + Выборка.Номенклатура + """ не создан документ ""Заказ поставщику"" или не соответствует количество");
			КонецЕсли;
		КонецЕсли;	
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции
//nva---

Функция ПолучитьТекстЗапросаСписка(МассивУказателей) Экспорт
	
	// ПРИ ИЗМЕНЕНИИ ЗАПРОСОВ ПРОВЕРИТЬ ПРОЦЕДУРУ ЗаказПокупателяОсобыйОтборПриИзмененииНаСервере()
	// В АРМ ПРОИЗВОДСТВА
	
	ТекстЗапроса = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЗаказПокупателя.Ссылка КАК Ссылка,
	|	ЗаказПокупателя.Организация КАК Организация,
	|	ЗаказПокупателя.Контрагент КАК Контрагент,
	|	ЗаказПокупателя.СуммаДокумента КАК СуммаДокумента,
	|	ЗаказПокупателя.НастройкаИнтеркампани КАК НастройкаИнтеркампани
	|ПОМЕСТИТЬ ВТ_Заказы
	|ИЗ
	|	Документ.ЗаказПокупателя КАК ЗаказПокупателя
	|ГДЕ
	|	ЗаказПокупателя.Ссылка В(&МассивСсылок)
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|";
	
	// оплата
	Если НЕ МассивУказателей.Найти(0) = Неопределено Тогда
		
		ТекстЗапроса = ТекстЗапроса + 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДанныеРегистра.Заказ КАК Ссылка,
		|	ЕСТЬNULL(ДанныеРегистра.СуммаРасход, 0) КАК Оплачено ,
		|	ЕСТЬNULL(ДанныеРегистра.СуммаПриход, 0) - ЕСТЬNULL(ДанныеРегистра.СуммаРасход, 0) КАК КОплате,
		|	ВЫБОР
		|		КОГДА ЕСТЬNULL(ВТ_Заказы.СуммаДокумента, 0) = 0
		|				ИЛИ ЕСТЬNULL(ДанныеРегистра.СуммаРасход, 0) = 0
		|			ТОГДА 2
		|		КОГДА ЕСТЬNULL(ВТ_Заказы.СуммаДокумента, 0) = ЕСТЬNULL(ДанныеРегистра.СуммаРасход, 0)
		|				И ЕСТЬNULL(ДанныеРегистра.СуммаРасход, 0) > 0
		|			ТОГДА 0
		|		КОГДА ЕСТЬNULL(ВТ_Заказы.СуммаДокумента, 0) < ЕСТЬNULL(ДанныеРегистра.СуммаРасход, 0)
		|				И ЕСТЬNULL(ДанныеРегистра.СуммаРасход, 0) > 0
		|			ТОГДА 7
		|		ИНАЧЕ 1
		|	КОНЕЦ КАК СостояниеОплаты
		|ИЗ
		|	ВТ_Заказы КАК ВТ_Заказы
		|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.РасчетыПоЗаказам.Обороты(, , , Заказ В (&МассивСсылок)) КАК ДанныеРегистра
		|	ПО ВТ_Заказы.Ссылка = ДанныеРегистра.Заказ
		|;
		|////////////////////////////////////////////////////////////////////////////////
		|";
	
	КонецЕсли;
	
	// долг контрагента и долг контрагента с учетом заказов в работе
	Если НЕ МассивУказателей.Найти(1) = Неопределено Тогда
		
		// ВНИМАНИЕ: в запросе есть вспомогательный запрос (временная таблица),
		// это учтено при переборе результатов пакета в формах списков заказов покупателей
		ТекстЗапроса = ТекстЗапроса +
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВТ_Заказы.Ссылка КАК Ссылка,
		|	СУММА(ЕСТЬNULL(ЗаказыПокупателейОстатки.СуммаОстаток, 0)) КАК СуммаЗаказовВРаботе
		|ПОМЕСТИТЬ ВТ_СтоимостьЗаказовВРаботе
		|ИЗ
		|	ВТ_Заказы КАК ВТ_Заказы
		|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ЗаказыПокупателей.Остатки(
		|			,
		|			ВЫРАЗИТЬ(ЗаказНаПроизводство КАК Документ.ЗаказПокупателя).ТекущийСтатус = ЗНАЧЕНИЕ(Справочник.СтатусыЗаказовПокупателей.ВРаботе)) КАК ЗаказыПокупателейОстатки
		|	ПО ВТ_Заказы.Контрагент = ВЫРАЗИТЬ(ЗаказыПокупателейОстатки.ЗаказНаПроизводство КАК Документ.ЗаказПокупателя).Контрагент
		|
		|СГРУППИРОВАТЬ ПО
		|	ВТ_Заказы.Ссылка
		|;
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВТ_Заказы.Ссылка КАК Ссылка,
		|	ЕСТЬNULL(ДанныеРегистра.СуммаОстаток, 0) КАК ДолгКонтрагента,
		|	ЕСТЬNULL(ДанныеРегистра.СуммаОстаток, 0) + ЕСТЬNULL(ЗаказыВРаботе.СуммаЗаказовВРаботе, 0) КАК ДолгСУчетомЗаказовВРаботе
		|ИЗ
		|	ВТ_Заказы КАК ВТ_Заказы
		|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ВзаиморасчетыСКонтрагентами.Остатки КАК ДанныеРегистра
		|	ПО ВТ_Заказы.Контрагент = ДанныеРегистра.Контрагент
		|		И ВТ_Заказы.Организация = ДанныеРегистра.Организация
		|	ЛЕВОЕ СОЕДИНЕНИЕ ВТ_СтоимостьЗаказовВРаботе КАК ЗаказыВРаботе
		|	ПО ВТ_Заказы.Ссылка = ЗаказыВРаботе.Ссылка
		|;
		|////////////////////////////////////////////////////////////////////////////////
		|";
	
	КонецЕсли;
		
	// доставка
	Если НЕ МассивУказателей.Найти(2) = Неопределено Тогда
		
		ТекстЗапроса = ТекстЗапроса + 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЗаявкаНаДоставку.Основание КАК Ссылка,
		|	ВЫБОР
		|		КОГДА НЕ МАКСИМУМ(ЗаявкаНаДоставку.Ссылка.ОжидаемаяДатаОтправки) = ДАТАВРЕМЯ(1, 1, 1)
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК ЕстьДоставкаСегодня
		|ИЗ
		|	Документ.ЗаявкаНаДоставку.Основания КАК ЗаявкаНаДоставку
		|ГДЕ
