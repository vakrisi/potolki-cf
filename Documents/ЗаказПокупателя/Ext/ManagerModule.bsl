Функция ПолучитьТекстЗапросаСпискаВыбора() Экспорт
			
	Возврат 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЗаказПокупателя.Ссылка КАК Ссылка,
	|	РасчетыПоЗаказамОстатки.СуммаОстаток КАК КОплате,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(РасчетыПоЗаказамОстатки.СуммаОстаток, 0) = 0
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК Оплачен,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(РасчетыПоЗаказамОстатки.СуммаОстаток, 0) > 0 И ЕСТЬNULL(РасчетыПоЗаказамОстатки.СуммаОстаток, 0) < ЗаказПокупателя.СуммаДокумента
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ЧастичноОплачен
	|ИЗ
	|	Документ.ЗаказПокупателя КАК ЗаказПокупателя 
	|
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.РасчетыПоЗаказам.Остатки КАК РасчетыПоЗаказамОстатки
	|		ПО ЗаказПокупателя.Ссылка = РасчетыПоЗаказамОстатки.Заказ
	|ГДЕ
	|	ЗаказПокупателя.Ссылка В (&МассивСсылок)
	|";

КонецФункции

Функция ТребуетсяЗаполнениеЦен(Знач ОбъектЗаказПокупателя) Экспорт
	
	ТребуетсяЗаполнениеЦен = Истина;
	
	ОднаОрганизацияПроизводстваИПродажиПотолков = Ложь;
	Если НЕ ОбъектЗаказПокупателя.НастройкаИнтеркампани.Пустая() Тогда //И ОбъектЗаказПокупателя.ЭтоЗаказОтРозницы Тогда
		ТребуетсяЗаполнениеЦен = НЕ ОбъектЗаказПокупателя.НастройкаИнтеркампани.ОднаОрганизацияПроизводстваИПродажиПотолков;
	КонецЕсли;
	
	//#7806
	Если ОбъектЗаказПокупателя.ВнутреннийЗаказ Тогда
		Если ТребуетсяЗаполнениеЦен И НЕ Константы.ОтображатьЦеныВоВнутреннихЗаказах.Получить() Тогда
			ТребуетсяЗаполнениеЦен = Ложь;
		КонецЕсли;
	КонецЕсли;
	
	Возврат ТребуетсяЗаполнениеЦен;
	
КонецФункции

Функция ОстаткиПоРезервам(Знач ЗаказПокупателяСсылка) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТоварыВРезервеНаСкладахОстатки.Склад,
	|	ТоварыВРезервеНаСкладахОстатки.Номенклатура,
	|	ТоварыВРезервеНаСкладахОстатки.ХарактеристикаНоменклатуры,
	|	ТоварыВРезервеНаСкладахОстатки.СерияНоменклатуры,
	|	ЕСТЬNULL(ТоварыВРезервеНаСкладахОстатки.КоличествоОстаток, 0) КАК Количество
	|ИЗ
	|   РегистрНакопления.ТоварыВРезервеНаСкладах.Остатки(, ДокументРезерва = &ДокументРезерва) КАК ТоварыВРезервеНаСкладахОстатки";
	Запрос.УстановитьПараметр("ДокументРезерва", ЗаказПокупателяСсылка);
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	
	Возврат ОбщегоНазначения.ТаблицаЗначенийВМассив(РезультатЗапроса);
	
КонецФункции
	
