Процедура ПриУстановкеНовогоНомера(СтандартнаяОбработка, Префикс)
	Префикс = прав(год(Дата),2)+".";
КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	ДЛя каждого стр из ОтложенныйДоход Цикл
		Если стр.ТипОперации = Перечисления.КСУ_ОперацииСОтложеннымДоходом.Отложить Тогда
			Если не стр.ид.Пустая() Тогда
				ИстОб = стр.ид.ПолучитьОбъект();
				ИстОб.НаименованиеИД = "#" + Номер+ "-" + стр.НомерСтроки + "/ОД";
				ИстОб.Записать();
			КонецЕсли;			 
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	для каждого стр из ЗаказыНаПриобретение Цикл
		Движение = РегистрыСведений.КСУ_ЛентаСобытий.СоздатьМенеджерЗаписи();
		Движение.ПериодСобытия = Дата;
		Движение.ДатаСобытия = ТекущаяДата();
		Движение.Объект = стр.Заказ;		
		Движение.Событие = "Отмена проведения ФП №" + Номер+". В ФП был статус заказа "+ стр.Статус;
		Движение.Ответственный = ПараметрыСеанса.ТекущийПользователь;
		Движение.Записать();
	КонецЦикла;
КонецПроцедуры
