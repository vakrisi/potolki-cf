&НаКлиенте
Процедура ЗаймыСФондаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	масс = новый массив;
	тд = Элементы.Займы.ТекущиеДанные;
	
	ДЛя каждого стр из ВыходнаяТаблица Цикл
		Если стр.фонд = ФондДБП Тогда
			Продолжить;
		КонецЕсли;
		
		ТекОст = стр.ПослеФП_Остаток;
		Если стр.Подразделение = тд.СПодразделения И стр.фонд = тд.СФонда Тогда
			ТекОст = ТекОст + тд.Сумма;
		КонецЕсли;
		
		Если масс.Найти(стр.фонд) = Неопределено и стр.Подразделение = тд.СПодразделения И ТекОст > 0  Тогда
			масс.Добавить(стр.фонд);
		КонецЕсли;
	КонецЦикла;
	
	Элемент.СписокВыбора.ЗагрузитьЗначения(масс);

КонецПроцедуры

