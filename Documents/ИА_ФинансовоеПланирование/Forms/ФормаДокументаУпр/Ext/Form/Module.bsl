&НаСервереБезКонтекста
Функция ПолучитьВсеФонды(ФондДБП)
	Запрос = новый запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ИА_Фонды.Ссылка КАК фонд
	               |ИЗ
	               |	Справочник.ИА_Фонды КАК ИА_Фонды
	               |ГДЕ
	               |	ИА_Фонды.ПометкаУдаления = ложь
	               |	И ИА_Фонды.Ссылка <> &ФондДБП
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ИА_Фонды.Наименование";
	Запрос.УстановитьПараметр("ФондДБП", ФондДБП);
	тз = запрос.Выполнить().выгрузить();
	возврат тз.ВыгрузитьКолонку("Фонд");
КонецФункции

&НаКлиенте
Процедура ЗаймыНаФондНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	масс = новый массив;
	тд = Элементы.Займы.ТекущиеДанные;
	
	ВсеФонды = ПолучитьВсеФонды(ФондДБП);
	ДЛя каждого Фонд из ВсеФонды Цикл		
		масс.Добавить(Фонд);		
	КонецЦикла;
	
	Если масс.Найти(тд.НаФонд) = Неопределено  Тогда
		масс.Добавить(тд.НаФонд);
	КонецЕсли;
	
	Элемент.СписокВыбора.ЗагрузитьЗначения(масс);
КонецПроцедуры

