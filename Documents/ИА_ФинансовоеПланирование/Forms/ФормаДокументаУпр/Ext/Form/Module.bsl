&НаСервере
Процедура ОбновитьСреднееФП1(ОтборПодр = Неопределено, ОтборСтатья = Неопределено)
	Если ОтборПодр = Неопределено Тогда
		Для каждого стр из Объект.ФП1 Цикл
			стр.СуммаСреднее = 0;
			стр.СуммаОтклонение = 0;
		КонецЦикла;	
	Иначе
		Отбор = Новый Структура("Подразделение,Фонд", ОтборПодр, ОтборСтатья);
		НайдСтр = Объект.ФП1.НайтиСтроки(Отбор);
		Для каждого стр из НайдСтр Цикл
			стр.СуммаСреднее = 0;
			стр.СуммаОтклонение = 0;
		КонецЦикла;	
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	СУММА(ИА_ФинансовоеПланированиеФП1.СуммаБезнал + ИА_ФинансовоеПланированиеФП1.СуммаНал) КАК Сумма,
	|	ИА_ФинансовоеПланированиеФП1.Подразделение,
	|	ИА_ФинансовоеПланированиеФП1.Фонд
	|ИЗ
	|	Документ.ИА_ФинансовоеПланирование.ФП1 КАК ИА_ФинансовоеПланированиеФП1
	|ГДЕ
	|	ИА_ФинансовоеПланированиеФП1.Ссылка.Дата МЕЖДУ &ДатаНачала И &ДатаКонца
	|	И ИА_ФинансовоеПланированиеФП1.Ссылка.Проведен
	|	И (ИА_ФинансовоеПланированиеФП1.Подразделение = &Подразделение
	|			ИЛИ &Подразделение = НЕОПРЕДЕЛЕНО)
	|	И (ИА_ФинансовоеПланированиеФП1.Фонд = &Фонд
	|			ИЛИ &Фонд = НЕОПРЕДЕЛЕНО)
	|	И (ИА_ФинансовоеПланированиеФП1.Ссылка.Организация = &Организация или &Организация = неопределено)
	|
	|СГРУППИРОВАТЬ ПО
	|	ИА_ФинансовоеПланированиеФП1.Подразделение,
	|	ИА_ФинансовоеПланированиеФП1.Фонд";
	Запрос.УстановитьПараметр("Организация", ?(ФППоОрганизациям, Объект.Организация, Неопределено));
	Запрос.УстановитьПараметр("ДатаНачала", Объект.ПериодФП1);
	Запрос.УстановитьПараметр("ДатаКонца", Объект.Дата - 1);
	Запрос.УстановитьПараметр("Подразделение", ОтборПодр);
	Запрос.УстановитьПараметр("Фонд", ОтборСтатья);
	
	Выборка = Запрос.Выполнить().Выбрать();
	КолДней = (НачалоДня(Объект.Дата) - Объект.ПериодФП1)/ (24*60*60) + 1;
	Коэф = 7 / КолДней;
	
	Пока Выборка.Следующий() Цикл
		Отбор = Новый Структура("Подразделение,Фонд", Выборка.Подразделение, Выборка.Фонд);
		НайдСтр = Объект.ФП1.НайтиСтроки(Отбор);
		Для каждого стр из НайдСтр Цикл
			стр.СуммаСреднее = Выборка.Сумма * Коэф;
			стр.СуммаОтклонение = стр.СуммаБезнал + стр.СуммаНал - стр.СуммаСреднее;
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ПериодФП1ПриИзменении(Элемент)
	Если Объект.ПериодФП1>= НачалоДня(Объект.Дата) Тогда
		Объект.ПериодФП1 = НачалоДня(Объект.Дата) - 1;
	КонецЕсли;
	ОбновитьСреднееФП1();
КонецПроцедуры


&НаКлиенте
Процедура ФП1ПодразделениеПриИзменении(Элемент)
	тд = Элементы.ФП1.ТекущиеДанные;
	ОбновитьСреднееФП1(тд.Подразделение, тд.Фонд);
КонецПроцедуры

