&НаКлиенте
Процедура ДеревоЗПВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	Если поле.имя <> "ДеревоЗПСтатус" и поле.имя <> "ДеревоЗПУтвержденнаяСумма" и поле.имя <> "ДеревоЗПНачислениеВФонд" 
		и поле.имя <> "ДеревоЗППричинаОтказа" и поле.имя <> "ДеревоЗПВыбрать" и поле.имя <> "ДеревоЗПСтатусНомер"  и поле.имя <> "ДеревоЗПКомментарийСФП" Тогда 
		СтандартнаяОбработка = ложь;
		КомандаОткрытьЗП(Неопределено);
		Возврат;
	КонецЕсли;
	
	тд = Элементы.ДеревоЗП.ТекущиеДанные;
	Если поле.имя = "ДеревоЗПСтатусНомер" и ЗначениеЗаполнено(тд.Заказ) и не объект.Проведен Тогда 
		СтандартнаяОбработка = ложь;
		
		ОпОп = новый ОписаниеОповещения("ЗавершениеВыбораСтатуса", ЭтотОбъект, новый Структура("идСтроки", тд.ПолучитьИдентификатор()));
		СпСтатусов = получитьДоступныеНовыеСтатусы(тд);
		ПоказатьВыборИзСписка(ОпОп, спСтатусов);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Функция получитьДоступныеНовыеСтатусы(тд)
	Рез = новый СписокЗначений;
	
	рез.Добавить("Одобрить");

	// возможные исходные статусы: РассмотретьНаФП, ОдобренЧастично_НетВыплат, ОдобренЧастично_ЧастичныеВыплаты, ОдобренЧастично_ВсёВыплачено 
	Если тд.СтатусИсходный = ПредопределенноеЗначение("Перечисление.ИА_СостояниеЗаказа.РассмотретьНаФП") или тд.СтатусИсходный = ПредопределенноеЗначение("Перечисление.ИА_СостояниеЗаказа.ПереносНаСледующееФП") Тогда
		рез.Добавить("Отклонить");
		рез.Добавить("На следующее ФП");
	Иначе // если ранее уже одобряли, то добавим возможность закрытия
		//рез.Добавить("Закрыть")	
	КонецЕсли;
	
	Возврат рез;
КонецФункции

// Команда - строка: Одобрить, Отклонить, Закрыть
&НаКлиенте
Процедура ОбработатьСменуСтатусаСтрокиЗаказа(тд, команда, одобреннаяСумма)
	// возможные исходные статусы: РассмотретьНаФП, ОдобренЧастично_НетВыплат, ОдобренЧастично_ЧастичныеВыплаты, ОдобренЧастично_ВсёВыплачено 
	Если команда = "Одобрить" Тогда
		Если тд.СтатусИсходный = ПредопределенноеЗначение("Перечисление.ИА_СостояниеЗаказа.РассмотретьНаФП") ИЛИ тд.СтатусИсходный = ПредопределенноеЗначение("Перечисление.ИА_СостояниеЗаказа.ПереносНаСледующееФП")
				ИЛИ тд.СтатусИсходный = ПредопределенноеЗначение("Перечисление.ИА_СостояниеЗаказа.ОдобренЧастично_НетВыплат") Тогда
			Если одобреннаяСумма >= тд.Сумма Тогда
				тд.Статус = ПредопределенноеЗначение("Перечисление.ИА_СостояниеЗаказа.ОдобренПолностью_НетВыплат");
			Иначе
				тд.Статус = ПредопределенноеЗначение("Перечисление.ИА_СостояниеЗаказа.ОдобренЧастично_НетВыплат");
			КонецЕсли;
		ИначеЕсли тд.СтатусИсходный = ПредопределенноеЗначение("Перечисление.ИА_СостояниеЗаказа.ОдобренЧастично_ЧастичныеВыплаты")
				ИЛИ тд.СтатусИсходный = ПредопределенноеЗначение("Перечисление.ИА_СостояниеЗаказа.ОдобренЧастично_ВсёВыплачено") Тогда
			Если одобреннаяСумма >= тд.Сумма Тогда
				тд.Статус = ПредопределенноеЗначение("Перечисление.ИА_СостояниеЗаказа.ОдобренПолностью_ЧастичныеВыплаты");
			Иначе
				тд.Статус = ПредопределенноеЗначение("Перечисление.ИА_СостояниеЗаказа.ОдобренЧастично_ЧастичныеВыплаты");
			КонецЕсли;
		КонецЕсли;		
	ИначеЕсли команда = "Отклонить" Тогда // отклонение возможно только в статусе РассмотретьНаФП
		Если тд.СтатусИсходный = ПредопределенноеЗначение("Перечисление.ИА_СостояниеЗаказа.РассмотретьНаФП") или тд.СтатусИсходный = ПредопределенноеЗначение("Перечисление.ИА_СостояниеЗаказа.ПереносНаСледующееФП") Тогда
			тд.Статус = ПредопределенноеЗначение("Перечисление.ИА_СостояниеЗаказа.Отклонен");
		КонецЕсли;
	ИначеЕсли команда = "На следующее ФП" Тогда 
		Если тд.СтатусИсходный = ПредопределенноеЗначение("Перечисление.ИА_СостояниеЗаказа.РассмотретьНаФП") или тд.СтатусИсходный = ПредопределенноеЗначение("Перечисление.ИА_СостояниеЗаказа.ПереносНаСледующееФП") Тогда
			тд.Статус = ПредопределенноеЗначение("Перечисление.ИА_СостояниеЗаказа.ПереносНаСледующееФП");
		КонецЕсли;
	Иначе // Закрыть
		//Если тд.СтатусИсходный = ПредопределенноеЗначение("Перечисление.ИА_СостояниеЗаказа.ОдобренЧастично_ЧастичныеВыплаты") 
		//	ИЛИ тд.СтатусИсходный = ПредопределенноеЗначение("Перечисление.ИА_СостояниеЗаказа.ОдобренЧастично_ВсёВыплачено") Тогда
		//	тд.Статус = ПредопределенноеЗначение("Перечисление.ИА_СостояниеЗаказа.ОдобренЧастично_Закрыт"); // одобрение было, выплаты были
		//Иначе
		//	тд.Статус = ПредопределенноеЗначение("Перечисление.ИА_СостояниеЗаказа.Закрыт"); // одобрение было, но не было выплат
		//КонецЕсли;
	КонецЕсли;
КонецПроцедуры
	
&НаКлиенте
Процедура ЗавершениеВыбораСтатуса(ВыбЗн, допПарам) Экспорт
	Если ВыбЗн <> Неопределено Тогда
		тд = ДеревоЗП.НайтиПоИдентификатору(допПарам.идСтроки);
		
		ОбработатьСменуСтатусаСтрокиЗаказа(тд, ВыбЗн.Значение, тд.Сумма);
		//тд.Статус = ВыбЗн.Значение;
		
		Если СостояниеЗаказаОдобренКлиент.найти(тд.Статус)<> Неопределено тогда
			тд.УтвержденнаяСумма = тд.Сумма;
		Иначе
			тд.УтвержденнаяСумма = 0;
		КонецЕсли;
		
		тд.ОстатокПоЗаказу = тд.Сумма - тд.УтвержденнаяСумма;
		тд.СтатусНомер = НомерСтатуса(тд.Статус);
		
		ДеревоЗВСИзменение();
	КонецЕсли;
КонецПроцедуры
	
