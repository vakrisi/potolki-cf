&НаСервере
Процедура ОбновитьЗНО_Сервер()
	ТаблицаЗНО.Очистить();
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ИА_ЗаявкаНаОбязательства.Ссылка КАК Заказ,
	               |	ИА_ЗаявкаНаОбязательства.Подразделение,
	               |	ИА_ЗаявкаНаОбязательства.Сумма,
	               |	ИА_ЗаявкаНаОбязательства.ПредметЗаказа,
	               |	ИА_ЗаявкаНаОбязательства.Фонд,
	               |	ИА_ЗаявкаНаОбязательства.ДатаОплаты,
	               |	ИА_ЗаявкаНаОбязательства.Ситуация,
	               |	ИА_ЗаявкаНаОбязательства.Данные,
	               |	ИА_ЗаявкаНаОбязательства.Решение,
	               |	ИА_СтатусыЗНОСрезПоследних.Статус
	               |ИЗ
	               |	Документ.ИА_ЗаявкаНаОбязательства КАК ИА_ЗаявкаНаОбязательства
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИА_ИсторияСтатусовЗВС.СрезПоследних(&Дата, ) КАК ИА_СтатусыЗНОСрезПоследних
	               |		ПО ИА_ЗаявкаНаОбязательства.Ссылка = ИА_СтатусыЗНОСрезПоследних.ЗВС
	               |ГДЕ
	               |	ИА_ЗаявкаНаОбязательства.Проведен = ИСТИНА
	               |	И ИА_ЗаявкаНаОбязательства.Дата <= &Дата
	               |	И ИА_СтатусыЗНОСрезПоследних.Статус = ЗНАЧЕНИЕ(Перечисление.ИА_СостояниеЗаказа.РассмотретьНаФП)
	               |	И ИА_ЗаявкаНаОбязательства.Организация = &Организация";
	
	
	Запрос.УстановитьПараметр("Дата", Объект.Дата-1);
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Новстр = ТаблицаЗНО.Добавить();
		ЗаполнитьЗначенияСвойств(Новстр, Выборка);
	КонецЦикла;
	
КонецПроцедуры


