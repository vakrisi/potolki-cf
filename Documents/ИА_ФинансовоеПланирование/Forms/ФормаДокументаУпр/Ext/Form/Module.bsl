&НаКлиенте
Процедура КомандаОткрытьЗНО(Команда)
	ТекущиеДанные = Элементы.ТаблицаЗНО.ТекущиеДанные;
	Если (ТекущиеДанные <> Неопределено) и (ЗаказЗаполнен(ТекущиеДанные.Заказ)) Тогда
		ПоказатьЗначение(,ТекущиеДанные.Заказ);
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаЗНОПриАктивизацииСтроки(Элемент)
	тд = Элементы.ТаблицаЗНО.ТекущиеДанные;
	ОписаниеЗНО = "";
	Если тд <> Неопределено Тогда		
		Если  ЗначениеЗаполнено(тд.Заказ) Тогда
			ОписаниеЗНО = ПолучитьПредставлениеЗНО(тд.Заказ);	
		Иначе
			ОписаниеЗНО = "";
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьПредставлениеЗНО(зно)
	ОписаниеЗНО1 = "ЗНО "+СокрЛП(зно.номер) +" от " + формат(зно.дата,"ДФ=dd.MM.yyyy")+", срок оплаты " + формат(зно.ДатаОплаты,"ДФ=dd.MM.yyyy") + Символы.ПС +  "Ситуация: " + зно.Ситуация + Символы.ПС + "Данные: " + зно.Данные + Символы.ПС + "Решение: " + зно.Решение;
	Возврат ОписаниеЗНО1;
КонецФункции

