Процедура ЗаполнитьЗНО_Док()
	Для каждого стр из Объект.ЗНО Цикл
		Новстр = ТаблицаЗНО.Добавить();
		ЗаполнитьЗначенияСвойств(Новстр, стр);
		ЗаполнитьЗначенияСвойств(Новстр, стр.Заказ,,"Статус,ПричинаОтказа");
	КонецЦикла;
КонецПроцедуры

