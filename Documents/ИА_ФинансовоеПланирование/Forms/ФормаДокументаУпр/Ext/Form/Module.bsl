&НаСервере
Процедура ПриОткрытииНаСервере1()
	
	Если ФП_по_ТБ Тогда
		ЗаполнитьДеревоДоходов();
		ЗаполнитьДеревоДоходовЧистых();
		ОбновитьНеделиДоходыЧистые();
		ПересчитатьДоходыИтого();
		ОбновитьИтогоВЗаливку();
		ОбновитьЗаливку();
		ПоказатьНедели();
	КонецЕсли;
	
	ЗаполнитьТаблицуЗП(Объект.Проведен);
	ЗаполнитьЗНО_Док();
	
	Политика_ВДерево(1);
	Если не ФП_по_ТБ Тогда
		Политика_ВДерево(2);
	КонецЕсли;
	ОбновитьИтогиПолитик();
	
	УстановитьПараметрыСпискаВДПС();
	
