&НаКлиенте
Процедура ПроверитьИзменениеРазмераОкна()
	Если Элементы.ГруппаГлавная.ТекущаяСтраница = Элементы.ГруппаСтатистики и ЕстьСтатистики Тогда
		
		предРазмер = sw;
		ОпределитьРазрешениеЭкрана();
		
		РазницаМеждуСтарымИНовымРазмером = предРазмер - sw;
		Если Абс(РазницаМеждуСтарымИНовымРазмером) < 20 Тогда
			Возврат;
		КонецЕсли;
		
		ОбновитьСтатистикиФП_Статистики();
	КонецЕсли;
КонецПроцедуры

