	Элементы.ОтложенныйДоход.ТолькоПросмотр = Объект.Проведен;
	Элементы.Дата.ТолькоПросмотр = Объект.Проведен;
	Элементы.Организация.ТолькоПросмотр = Объект.Проведен;
	
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьВидимостьКнопкиПроведения()
	Если Элементы.Найти("ФормаКнопкаПровести") <> Неопределено тогда
		Элементы.ФормаКнопкаПровести.Видимость = не объект.Проведен;
		Элементы.ФормаКнопкаПровести.Доступность = ПравоУтверждения;
	КонецЕсли;
	
	Если Элементы.Найти("ФормаКнопкаОтменаПроведения") <> Неопределено тогда
		Элементы.ФормаКнопкаОтменаПроведения.Видимость = объект.Проведен;
		Элементы.ФормаКнопкаОтменаПроведения.Доступность = ПравоУтверждения;
	КонецЕсли;
КонецПроцедуры

