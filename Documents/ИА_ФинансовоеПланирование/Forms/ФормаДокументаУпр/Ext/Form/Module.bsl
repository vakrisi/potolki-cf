Процедура ЗанятьИзОтложенногоДохода(Команда)
	
	Записать();
	Парам = новый Структура("Док,	Организация,	ИспДоходыПоПодразделениям, 	Только1, 	ДатаОстатков, ВключитьТекДок",
				          Объект.Ссылка, Объект.Организация, ИспДоходыПоПодразделениям, ложь, Объект.Дата, истина);

	ОткрытьФорму("Документ.ИА_ФинансовоеПланирование.Форма.ФормаПодбораДБПУпр", Парам,,,,, Новый ОписаниеОповещения("КомандаПодобратьОтлДоходЗавершение", ЭтотОбъект), РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаПодобратьОтлДоходЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	рез = Результат;
	
	Если ТипЗнч(рез) = тип("Массив") Тогда
		Для каждого стр из рез Цикл
			Новстр = Займы.Добавить();
			Новстр.СФонда = ФондДБП;
			Если ИспПодразделения Тогда
				Если ИспДоходыПоПодразделениям тогда
					Новстр.СПодразделения = стр.Подразделение;
				Иначе
					Новстр.СПодразделения = ПодрОтлДохода();
				КонецЕсли;
			КонецЕсли;
			
			Новстр.Сумма = стр.Сумма;
			Новстр.ИсточникОтложенногоДохода = стр.Источник;			
			новстр.ЗаймВозврат = ПредопределенноеЗначение("Перечисление.ИА_ЗаймВозврат.Займ");
			Новстр.ПричинаЗайма = ПредопределенноеЗначение("Справочник.КСУ_ПричиныЗайма.ПустаяСсылка");
			
		КонецЦикла;
		
		ИзменениеЗаймовВозвратов();
		Модифицированность = истина;
	КонецЕсли;

КонецПроцедуры

