	               |		
	               |		СГРУППИРОВАТЬ ПО
	               |			ВЫБОР КОГДА &ИспПодр ТОГДА КСУ_ПорядокРаспределенияПоФондамСрезПоследних.Подразделение ИНАЧЕ НЕОПРЕДЕЛЕНО КОНЕЦ,
	               |			КСУ_ПорядокРаспределенияПоФондамСрезПоследних.Фонд) КАК КСУ_ПорядокРаспределенияПоФондамСрезПоследних
	               |		ПО (ВТСводнаяТаблица.Подразделение = КСУ_ПорядокРаспределенияПоФондамСрезПоследних.Подразделение
	               |				ИЛИ НЕ &ИспПодр)
	               |			И ВТСводнаяТаблица.Фонд = КСУ_ПорядокРаспределенияПоФондамСрезПоследних.Фонд
	               |ГДЕ
	               |	(ВТСводнаяТаблица.Фонд.Защищенный = ложь
	               |			ИЛИ &ЭтоРСФ)       
	               |УПОРЯДОЧИТЬ ПО
	               |	*ПОРЯДОК*
	               |ИТОГИ
	               |	СУММА(Сумма),
				   |	СУММА(РанееВыделено),
				   |	СУММА(ОстатокПоЗаказу),
	               |	СУММА(УтвержденнаяСумма),
	               |	СУММА(ИсходнаяСумма),
	               |	СУММА(НачислениеВФонд),
	               |	МИНИМУМ(ФондКод),
				   |	МИНИМУМ(ВыбратьСтр)
	               |ПО
	               |	*ИТОГИ*";
	
	
	ТестПорядка = "ФондКод";
	ТекстИтогов = "Фонд";
	Если ИспПодразделения Тогда
		ТекстИтогов = "Подразделение, " + ТекстИтогов;
		ТестПорядка = "ПодразделениеНаименование, " + ТестПорядка;
	КонецЕсли;
	Если ВыводитьГруппировкуПоСчетам Тогда				
		ТекстИтогов = "Счет, " + ТекстИтогов;		
		ТестПорядка = "СчетПорядок, " + ТестПорядка;
	КонецЕсли;		
	ТестПорядка = ТестПорядка + ", СрокОплаты";
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"*ИТОГИ*", ТекстИтогов);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"*ПОРЯДОК*", ТестПорядка);
		
	Запрос.Текст = ТекстЗапроса;
	СостояниеЗаказаОдобрен     = ИА_ФП.СтатусыОдобрено();
	
	Запрос.УстановитьПараметр("Дата",            ?(Объект.Дата = Дата(1,1,1), ТекущаяДата(), КонецДня(Объект.Дата)));
	Запрос.УстановитьПараметр("ТекДок",          Объект.Ссылка);
	Запрос.УстановитьПараметр("ПоТекДоку",       поТекДокументу);
	Запрос.УстановитьПараметр("Организация",     Объект.Организация);
	Запрос.УстановитьПараметр("НеРазделять",     Не ФППоОрганизациям);
	Запрос.УстановитьПараметр("ЭтоРСФ",          ЭтоРСФ);
	Запрос.УстановитьПараметр("ФП_ТБ",           ФП_по_ТБ);
	Запрос.УстановитьПараметр("ИспПодр",          ИспПодразделения);
	Запрос.УстановитьПараметр("ОдобрСтатусы",    СостояниеЗаказаОдобрен);
	Запрос.УстановитьПараметр("ДатаДок",            ?(Объект.Дата = Дата(1,1,1), ТекущаяДата(), Объект.Дата - 1));
	
	
	ДеревоЗПЗнач = Запрос.Выполнить().Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам);	
	ЗаполнитьСтрокуТабЗП(ДеревоЗПЗнач);	
	
	ДеревоЗПЗнач.Колонки.Удалить("ФондКод");
	ДеревоЗПЗнач.Колонки.Удалить("ПодразделениеНаименование");
	
	ИА_ТабДеревоСтарое = ИА_БФС.ДЗ2ТЗ(РеквизитФормыВЗначение("ДеревоЗП"));
	ПеренестиИзСтарогоДерВНовое(ИА_ТабДеревоСтарое, ДеревоЗПЗнач);
		
	ДеревоЗПИсходнаяСумма = ДеревоЗПЗнач.Строки.Итог("ИсходнаяСумма",ложь);
	ДеревоЗПНачислениеВФонд = ДеревоЗПЗнач.Строки.Итог("НачислениеВФонд",ложь);
	ДеревоЗПСумма = ДеревоЗПЗнач.Строки.Итог("Сумма",ложь);
	ДеревоЗПУтвержденнаяСумма = ДеревоЗПЗнач.Строки.Итог("УтвержденнаяСумма",ложь);
	ДеревоЗПРанееВыделено = ДеревоЗПЗнач.Строки.Итог("РанееВыделено",ложь);
	ДеревоЗПОстатокПоЗаказу = ДеревоЗПЗнач.Строки.Итог("ОстатокПоЗаказу",ложь);
	
	ДеревоЗПЗнач.Колонки.Добавить("СерыйВыбор", новый ОписаниеТипов("Булево"));

	ЗначениеВРеквизитФормы(ДеревоЗПЗнач, "ДеревоЗП");
	
КонецПроцедуры

&НаСервере
Процедура ПеренестиИзСтарогоДерВНовое(СтароеДерево, НовоеДерево)
	
	Для каждого Стр Из НовоеДерево.Строки Цикл
		Если стр.Заказ <> NULL Тогда // строка с заказом	
			//Если ИспПодразделения ТОгда
			//	Отбор = Новый Структура("Подразделение,Фонд,Заказ");
			//Иначе
			//	Отбор = Новый Структура("Фонд,Заказ");
			//КонецЕсли;
			Отбор = Новый Структура("Заказ");
			ЗаполнитьЗначенияСвойств(Отбор, стр);
			Вложения = "";
			Для каждого стрВлож из стр.Заказ.Файлы Цикл
				Если Вложения <> "" Тогда
					Вложения = Вложения+ ", ";
				КонецЕсли;
				Вложения = Вложения+ стрВлож.Имя;
			КонецЦикла;
			стр.Вложения = ?(Вложения = "", "нет", Вложения);
			
			Если СтароеДерево.Количество() = 0 Тогда // при открытии документа 
				Таб = ИА_БФС.ТЗ_ФильтрПоОтбору(объект.ЗаказыНаПриобретение, Отбор);
			Иначе
				Таб = ИА_БФС.ТЗ_ФильтрПоОтбору(СтароеДерево, Отбор);
			КонецЕсли;
	        Если Таб.Количество() > 0 Тогда
				ЗаполнитьЗначенияСвойств(стр, Таб[0], "Статус,УтвержденнаяСумма,ПричинаОтказа,КомментарийСФП");
				
				стр.ОстатокПоЗаказу = стр.Сумма - стр.УтвержденнаяСумма;
				//
				Если стр.УтвержденнаяСумма > 0 Тогда
					Если стр.СтатусИсходный = Перечисления.ИА_СостояниеЗаказа.РассмотретьНаФП ИЛИ стр.СтатусИсходный = Перечисления.ИА_СостояниеЗаказа.ПереносНаСледующееФП
							ИЛИ стр.СтатусИсходный = Перечисления.ИА_СостояниеЗаказа.ОдобренЧастично_НетВыплат Тогда
						Если стр.УтвержденнаяСумма >= стр.Сумма Тогда
							стр.Статус = Перечисления.ИА_СостояниеЗаказа.ОдобренПолностью_НетВыплат;
						Иначе
							стр.Статус = Перечисления.ИА_СостояниеЗаказа.ОдобренЧастично_НетВыплат;
						КонецЕсли;
					ИначеЕсли стр.СтатусИсходный = Перечисления.ИА_СостояниеЗаказа.ОдобренЧастично_ЧастичныеВыплаты
							ИЛИ стр.СтатусИсходный = Перечисления.ИА_СостояниеЗаказа.ОдобренЧастично_ВсёВыплачено Тогда
						Если стр.УтвержденнаяСумма >= стр.Сумма Тогда
							стр.Статус = Перечисления.ИА_СостояниеЗаказа.ОдобренПолностью_ЧастичныеВыплаты;
						Иначе
							стр.Статус = Перечисления.ИА_СостояниеЗаказа.ОдобренЧастично_ЧастичныеВыплаты;
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;
				//
				стр.СтатусНомер = НомерСтатусаСервер(стр.Статус);
	        КонецЕсли;
		ИначеЕсли стр.фонд <> NULL Тогда  // строка с фондом
			Если ИспПодразделения Тогда
				Отбор = Новый Структура("Подразделение,Фонд");
			Иначе
				Отбор = Новый Структура("Фонд");
			КонецЕсли;
			ЗаполнитьЗначенияСвойств(Отбор, стр);
			Таб = ИА_БФС.ТЗ_ФильтрПоОтбору(СтароеДерево, Отбор);
	        Если Таб.Количество() > 0 Тогда
				стр.НачислениеВФонд = Таб[0].НачислениеВФонд
	        КонецЕсли; 
		КонецЕсли;
		
		ПеренестиИзСтарогоДерВНовое(СтароеДерево, стр);
	КонецЦикла;
	
КонецПроцедуры


&НаСервере
Процедура ЗаполнитьСтрокуТабЗП(СтрокаДер)
	
	Для каждого стр из СтрокаДер.Строки Цикл
		Если стр.Заказ <> NULL Тогда			
			стр.ПодразделениеФонд = "№" + строка(число(стр.Номер)) + " " +ВРЕГ(стр.ПредметЗаказа);									
		ИначеЕсли стр.фонд <> NULL Тогда
			стр.ПодразделениеФонд = "фонд: " + строка(стр.Фонд);
			Если стр.Строки.Количество()>0 Тогда
				//Если не ЗначениеЗаполнено(стр.Строки[0].Заказ) Тогда // это строка с доп фондом без заказов
				//	стр.Строки.Очистить();
				//КонецЕсли;
				
				сч = стр.Строки.Количество() -1;
				Пока сч>= 0 Цикл
					Если не ЗначениеЗаполнено(стр.Строки[сч].Заказ) Тогда // это строка с доп фондом без заказов
						стр.Строки.Удалить(сч);
					КонецЕсли;
					сч = сч - 1;
				КонецЦикла;
			КонецЕсли;
		ИначеЕсли стр.Подразделение <> NULL Тогда
			стр.ПодразделениеФонд = Строка(стр.Подразделение);
		ИначеЕсли стр.Счет <> NULL Тогда
			стр.ПодразделениеФонд = Строка(стр.Счет);
		КонецЕсли;
		
		ЗаполнитьСтрокуТабЗП(стр);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ПересчитатьСальдоСредствКРаспределению()
	
	Объект.ВаловаяПрибыльСуммаБезнал = Объект.ДоходыИтого.Итог("СуммаБезнал") - Объект.Политика1.Итог("Сумма");
	
	Если ФП_по_ТБ ТОгда
		Объект.СуммаКРаспределениюБезнал = 0;
	Иначе
		Объект.СуммаКРаспределениюБезнал = Объект.ВаловаяПрибыльСуммаБезнал - Объект.Политика2.Итог("Сумма") - Объект.ЗаливкаФондов.Итог("Сумма");
	КонецЕсли;
	
	Объект.СуммаКРаспределениюСОстаткомБезнал = Объект.СуммаКРаспределениюБезнал;
		
	ИтогоНачисление = 0;
	Для каждого стр из ДеревоЗП.ПолучитьЭлементы() цикл		
		ИтогоНачисление = ИтогоНачисление + стр.НачислениеВФонд;	
	КонецЦикла;
	
	СальдоСредствКРаспределениюБезналВрем = Объект.СуммаКРаспределениюСОстаткомБезнал - ИтогоНачисление;
		
	Если Объект.СальдоСредствКРаспределениюБезнал <> СальдоСредствКРаспределениюБезналВрем Тогда
		Объект.СальдоСредствКРаспределениюБезнал = СальдоСредствКРаспределениюБезналВрем;
	КонецЕсли;
	
	Если Объект.СальдоСредствКРаспределениюБезнал < 0 Тогда
		Элементы.СальдоСредствКРаспределениюИтого.ЦветФона = Новый Цвет(255,140,140);
	Иначе
		Элементы.СальдоСредствКРаспределениюИтого.ЦветФона = Новый Цвет(255,255,255);
	КонецЕсли;
КонецПроцедуры

&НаСервереБезКонтекста
Функция ЕстьВДПСилиФормВыплаты(орг, ДоДаты)
	Запрос = новый запрос;
	запрос.Текст = "ВЫБРАТЬ
	               |	КСУ_ВнедоходноеПоступлениеСредств.Ссылка КАК Ссылка
	               |ИЗ
	               |	Документ.КСУ_ВнедоходноеПоступлениеСредств КАК КСУ_ВнедоходноеПоступлениеСредств
	               |ГДЕ
	               |	КСУ_ВнедоходноеПоступлениеСредств.Проведен
	               |	И КСУ_ВнедоходноеПоступлениеСредств.Дата < &ДоДаты
	               |	И КСУ_ВнедоходноеПоступлениеСредств.Организация = &Организация
	               |	И КСУ_ВнедоходноеПоступлениеСредств.Основание = НЕОПРЕДЕЛЕНО
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	КСУ_ФормальнаяВыплата.Ссылка
	               |ИЗ
	               |	Документ.КСУ_ФормальнаяВыплата КАК КСУ_ФормальнаяВыплата
	               |ГДЕ
	               |	КСУ_ФормальнаяВыплата.Проведен
	               |	И КСУ_ФормальнаяВыплата.Дата < &ДоДаты
	               |	И КСУ_ФормальнаяВыплата.Организация = &Организация";
	Запрос.УстановитьПараметр("ДоДаты", ДоДаты);
	Запрос.УстановитьПараметр("Организация", орг);
	
	выборка = запрос.Выполнить().Выбрать();
	
	Возврат выборка.Следующий();
КонецФункции
	
&НаСервере
Процедура ОбновитьОтчетПоСотояниюФондов(ВывестиВТабДок = ложь, табД = Неопределено, ЭтоСостояние = ложь) Экспорт
	
	ДеревоЗПЗнач = РеквизитФормыВЗначение("ДеревоЗП");
	ДеревоПолитика2Знач = РеквизитФормыВЗначение("ДеревоПолитика2");
	ДеревоПолитика1Знач = РеквизитФормыВЗначение("ДеревоПолитика1");
	
	РезЗапроса = ИА_Защита_ФП.ПолучитьРезультатЗапроса(Объект, ФППоОрганизациям, ДеревоЗПЗнач, ДеревоПолитика2Знач, ДеревоПолитика1Знач, ВывестиВТабДок, ВыводитьГруппировкуПоСчетам);
	
	Если ВывестиВТабДок Тогда       
		
		ГС_Оборот = 0;
		Макет = ПолучитьОбщийМакет("СостояниеФондовСвернуто");	
		ТабДок = ПолеТабДок;
		ТабДок.Очистить();
		
		Если ЭтоСостояние Тогда
			ОблШапкаС = Макет.ПолучитьОбласть("ЗаголовокСостояние");
			ОблШапкаС.Параметры.Дата =  формат(объект.Дата,"ДФ=dd.MM.yyyy");
			ОблШапкаС.Параметры.Номер =  объект.Номер;
			ТабДок.Вывести(ОблШапкаС);
		КонецЕсли;		
		
		ОблШапка = Макет.ПолучитьОбласть("Шапка");
		ОблШапка.Параметры.Заголовок = "Дата формирования отчета " + ТекущаяДата() +". Отчет сформирован по состоянию на " + объект.Дата +". В случае внесения в ФП любых изменений после формирования отчета необходимо обновить отчёт для получения актуальных данных.";
		
		ГруппировкаСтр = "Фонд";
		Если ИспПодразделения ТОгда
			ГруппировкаСтр = "Подразделение/" + ГруппировкаСтр;
		КонецЕсли;
		Если ВыводитьГруппировкуПоСчетам Тогда
			ГруппировкаСтр = "Счет/" + ГруппировкаСтр;
		КонецЕсли;
		ОблШапка.Параметры.СчетПодразделениеФонд =  ГруппировкаСтр;
		ТабДок.Вывести(ОблШапка);
		
		ТабДок.ФиксацияСверху = 2;		
		ТабДок.ФиксацияСлева = 2;
		
		ВыводитьИтог =Ложь;
		ОстатокПоФондамБезНал = 0;
		
		ДеревоРез = РезЗапроса.Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкамСИерархией);
		
		Для каждого стр из ДеревоРез.Строки Цикл
			Если ВыводитьИтог = ложь Тогда // первая запись - общий итог
				ВыводитьИтог = истина;
				ОблСтрокаИтог = Макет.ПолучитьОбласть("СтрокаИтог");
				ОблСтрокаИтог.Параметры.Заполнить(стр);
				ОблСтрокаИтог.Параметры.Фонд = "ИТОГО";
				ОстатокПоФондамБезНал = стр.ПослеФП_Остаток_Итого;
			КонецЕсли;
			
			ВывестиСтрокуОтчетаПоСоcтояниюФондов(стр, Макет, ТабДок);
			
		КонецЦикла;
		
		Если ВыводитьИтог Тогда
			ТабДок.Вывести(ОблСтрокаИтог);
		КонецЕсли;
		
		// ОСТАТКИ ДС
		ОстаткиДС = ПолучитьОстатокДС();
		ОблСтрока = Макет.ПолучитьОбласть("Сравнение");
		ОстатокДС = ОстаткиДС.СуммаНал + ОстаткиДС.СуммаБезНал;
		
		Если ОстатокДС<> ОстатокПоФондамБезНал Тогда
			если ЕстьВДПСилиФормВыплаты(объект.Организация, объект.Дата) ТОгда
				ОблСтрока = Макет.ПолучитьОбласть("СравнениеКрасноеЕстьВДПС");
			Иначе
				ОблСтрока = Макет.ПолучитьОбласть("СравнениеКрасное");
			КонецЕсли;
			ОблСтрока.Параметры.СуммаФондов = ОстатокПоФондамБезНал; 
			ОблСтрока.Параметры.СуммаДС = ОстатокДС;
			ТабДок.Вывести(ОблСтрока);
			
			
			Если ОстатокДС > ОстатокПоФондамБезНал Тогда
				ОблСтрока = Макет.ПолучитьОбласть("ПояснениеОшибкиДС1");
				ОблСтрока.Параметры.СуммаДС = ОстатокДС - ОстатокПоФондамБезНал;
			Иначе
				ОблСтрока = Макет.ПолучитьОбласть("ПояснениеОшибкиДС2");
				ОблСтрока.Параметры.СуммаДС = ОстатокПоФондамБезНал - ОстатокДС;
				ОблСтрока.Параметры.СсылкаНаОтчет = "e1cib/app/Отчет.ИА_КонтрольПлатежейВнеФондов";
			КонецЕсли;
			ТабДок.Вывести(ОблСтрока);
		Иначе
			ОблСтрока.Параметры.СуммаФондов = ОстатокПоФондамБезНал; 
			ОблСтрока.Параметры.СуммаДС = ОстатокДС;
			ТабДок.Вывести(ОблСтрока);
		КонецЕсли;
		
		
		// ЗАЙМЫ
		тзЗаймов = ИА_ФПСервер.ПолучитьТЗЗаймов(Объект.Дата, Объект.Организация, не ФППоОрганизациям, Объект.РаспределениеПоФондам.Выгрузить()); 
		Если тзЗаймов.Количество() > 0 Тогда
			Если ИспПодразделения Тогда
				ОблСтрока = Макет.ПолучитьОбласть("ШапкаЗаймы");
				ОблСтрокаИтог = Макет.ПолучитьОбласть("СтрокаЗаймыИтогПодр");
			Иначе
				ОблСтрока = Макет.ПолучитьОбласть("ШапкаЗаймыБезПодр");
				ОблСтрокаИтог = Макет.ПолучитьОбласть("СтрокаЗаймыИтог");
			КонецЕсли;
			ТабДок.Вывести(ОблСтрока);
			
			Для каждого стрПодр из тзЗаймов Цикл
				ОблСтрока = Макет.ПолучитьОбласть("СтрокаЗаймы");
				Если ИспПодразделения Тогда
					ОблСтрока = Макет.ПолучитьОбласть("СтрокаЗаймы");
					ОблСтрока.Параметры.НаПодразделение = стрПодр.Подразделение;
					ОблСтрока.Параметры.НаФонд = стрПодр.Фонд;
				Иначе
					ОблСтрока = Макет.ПолучитьОбласть("СтрокаЗаймыБезПодр");
				КонецЕсли;
				ЗаполнитьЗначенияСвойств(ОблСтрока.Параметры, стрПодр);
				ОблСтрока.Параметры.НаФОнд = стрПодр.Фонд;
				ТабДок.Вывести(ОблСтрока);
			КонецЦикла;
			
			// итог
			ОблСтрокаИтог.Параметры.Сумма = тзЗаймов.Итог("Сумма");
			ТабДок.Вывести(ОблСтрокаИтог);
		КонецЕсли;

		ОблПодвал = Макет.ПолучитьОбласть("ПодвалЗаливка");
		ТабДок.Вывести(ОблПодвал);
		
		Если ЭтоСостояние Тогда
			ОблПодвалС = Макет.ПолучитьОбласть("ПодвалСостояние");			
			ТабДок.Вывести(ОблПодвалС);
		КонецЕсли;
		
		Если табД = Неопределено Тогда
			ПолеТабДок1.Очистить();
			ПолеТабДок1.Вывести(ТабДок.ПолучитьОбласть());
		Иначе
			табД.Очистить();
			табД.Вывести(ТабДок.ПолучитьОбласть());
		КонецЕсли;
		
	Иначе
		ВыхТаблицаЗнач = РезЗапроса.Выгрузить();
		Если не ВыводитьГруппировкуПоСчетам Тогда
			ВыхТаблицаЗнач.ЗаполнитьЗначения(Справочники.ИА_Счета.ПустаяСсылка() ,"Счет");
			ВыхТаблицаЗнач.Свернуть("Подразделение, Фонд, Счет", "ДоФП_Остаток,ДоФП_Резерв,ФП_Резерв,ФП_Приход,ПослеФП_Остаток,ПослеФП_Резерв");
		КонецЕсли;
		Если не ИспПодразделения Тогда
			ВыхТаблицаЗнач.ЗаполнитьЗначения(Справочники.ИА_ЦФО.ПустаяСсылка() ,"Подразделение");
			ВыхТаблицаЗнач.Свернуть("Подразделение, Фонд, Счет", "ДоФП_Остаток,ДоФП_Резерв,ФП_Резерв,ФП_Приход,ПослеФП_Остаток,ПослеФП_Резерв");
		КонецЕсли;
		ЗначениеВРеквизитФормы(ВыхТаблицаЗнач, "ВыходнаяТаблица");
		
		// Заполнение таблицы с состоянием фондов
		Запрос = новый запрос;
		Запрос.УстановитьПараметр("ТаблицаФондов", ВыхТаблицаЗнач);
		ЗапросТекст = "ВЫБРАТЬ
		               |	ТаблицаФондов.Счет КАК Счет,
		               |	ТаблицаФондов.Подразделение КАК Подразделение,
		               |	ТаблицаФондов.Фонд КАК Фонд,
		               |	ТаблицаФондов.ПослеФП_Резерв КАК Зарезервировано,
		               |	ТаблицаФондов.ПослеФП_Остаток КАК СвободныеСредства,
		               |	ТаблицаФондов.ПослеФП_Остаток + ТаблицаФондов.ПослеФП_Резерв КАК ИтогоНаФонде
		               |ПОМЕСТИТЬ ТаблицаФондов
		               |ИЗ
		               |	&ТаблицаФондов КАК ТаблицаФондов
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ
		               |	ТаблицаФондов.Счет КАК Счет,
		               |	ТаблицаФондов.Подразделение КАК Подразделение,
		               |	ТаблицаФондов.Фонд КАК Фонд,
		               |	ТаблицаФондов.Зарезервировано КАК Зарезервировано,
		               |	ТаблицаФондов.СвободныеСредства КАК СвободныеСредства,
		               |	ТаблицаФондов.ИтогоНаФонде КАК ИтогоНаФонде
		               |ИЗ
		               |	ТаблицаФондов КАК ТаблицаФондов
		               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ИА_ЦФО КАК ИА_ЦФО
		               |		ПО ТаблицаФондов.Подразделение = ИА_ЦФО.Ссылка
		               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ИА_Фонды КАК ИА_Фонды
		               |		ПО ТаблицаФондов.Фонд = ИА_Фонды.Ссылка
		               |
		               |УПОРЯДОЧИТЬ ПО
		               |	Счет,
		               |	ИА_ЦФО.Наименование,
		               |	ИА_Фонды.Наименование
		               |ИТОГИ
		               |	СУММА(Зарезервировано),
		               |	СУММА(СвободныеСредства),
		               |	СУММА(ИтогоНаФонде)
		               |ПО
		               |	%СтрокаГруппировки%";
		СтрокаГруппировки = "Фонд";
		МассивГрупп = Новый массив;
		МассивГрупп.Добавить("Фонд");
		Если ИспПодразделения Тогда
			СтрокаГруппировки = "Подразделение," + СтрокаГруппировки;
			МассивГрупп.Вставить(0,"Подразделение");
		КонецЕсли;
		Если ВыводитьГруппировкуПоСчетам Тогда
			СтрокаГруппировки = "Счет," + СтрокаГруппировки;
			МассивГрупп.Вставить(0,"Счет");
		КонецЕсли;
		
		ЗапросТекст = СтрЗаменить(ЗапросТекст, "%СтрокаГруппировки%", СтрокаГруппировки);
		Запрос.Текст = ЗапросТекст;
		ДеревоСостФонд = Запрос.Выполнить().Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам);
		ДеревоСостФонд.Колонки.Добавить("СчетПодразделениеФонд");
		ДеревоСостФонд.Колонки.Добавить("ЭтоЗаголовок");
		
		ЕстьМинус = ложь;
		Для каждого стрУр1 из ДеревоСостФонд.Строки Цикл
			стрУр1.СчетПодразделениеФонд = стрУр1[МассивГрупп[0]];
			
			Если стрУр1.СвободныеСредства < 0 или стрУр1.ИтогоНаФонде < 0 Тогда
				ЕстьМинус = истина;
			КонецЕсли;
			
			Если МассивГрупп.Количество() > 1 Тогда
				стрУр1.ЭтоЗаголовок = истина;
				
				Для каждого стрУр2 из стрУр1.Строки Цикл
					стрУр2.СчетПодразделениеФонд = стрУр2[МассивГрупп[1]];
					
					Если стрУр2.СвободныеСредства < 0 или стрУр2.ИтогоНаФонде < 0 Тогда
						ЕстьМинус = истина;
					КонецЕсли;
					
					Если МассивГрупп.Количество() > 2 Тогда
						стрУр2.ЭтоЗаголовок = истина;
						
						Для каждого стрУр3 из стрУр2.Строки Цикл
							стрУр3.СчетПодразделениеФонд = стрУр3[МассивГрупп[2]];
							
							Если стрУр3.СвободныеСредства < 0 или стрУр3.ИтогоНаФонде < 0 Тогда
								ЕстьМинус = истина;
							КонецЕсли;
					
							стрУр3.Строки.Очистить();
						КонецЦикла;
					Иначе
						стрУр2.Строки.Очистить();
					КонецЕсли;
				КонецЦикла;
			Иначе
				стрУр1.Строки.Очистить();
			КонецЕсли;
		КонецЦикла;
		
		Элементы.ДекорацияЕстьМинус.Видимость = ЕстьМинус;
		Элементы.ДекорацияЕстьМинус1.Видимость = ЕстьМинус;
		
		ДеревоСостФонд.Колонки.Удалить("Счет");
		ДеревоСостФонд.Колонки.Удалить("Подразделение");
		ДеревоСостФонд.Колонки.Удалить("Фонд");
		
		ЗначениеВРеквизитФормы(ДеревоСостФонд, "ДеревоСостояниеФондов");
		
		ЗаголовокКол = "";
		Для каждого УрГр из МассивГрупп Цикл
			Если ЗаголовокКол <> "" Тогда
				ЗаголовокКол = ЗаголовокКол + " / ";	
			КонецЕсли;
			
			ЗаголовокКол = ЗаголовокКол + УрГр;
		КонецЦикла;
		Элементы.ДеревоСостояниеФондовСчетПодразделениеФонд.Заголовок = ЗаголовокКол;
		Элементы.ДеревоСостояниеФондовСчетПодразделениеФонд1.Заголовок = ЗаголовокКол;
		
		ЕстьОстатки = ДеревоСостФонд.Строки.Количество()>0;
		
		Элементы.ДеревоСостояниеФондов.Видимость = ЕстьОстатки;
		Элементы.ДеревоСостояниеФондов1.Видимость = ЕстьОстатки;
		
		Элементы.ДекорацияНетДенег.Видимость = не ЕстьОстатки;
		Элементы.ДекорацияНетДенег1.Видимость = не ЕстьОстатки;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ВывестиСтрокуОтчетаПоСоcтояниюФондов(СтрокаДер, Макет, ТабДок)
	
	Для каждого стр из СтрокаДер.Строки Цикл
		Если стр.фонд <> NULL Тогда
			ОблСтрока = Макет.ПолучитьОбласть("СтрокаФонд");			
			//Если стр.ПослеФП_Остаток < 0 Тогда
			//	ОблСтрока = Макет.ПолучитьОбласть("СтрокаКраснаяФонд");
			//КонецЕсли;
			
			ОблСтрока.Параметры.Заполнить(стр);
			ОблСтрока.Параметры.Фонд = "- " + стр.Фонд;                
			
			ПараметрПозиционирования = строка(стр.Фонд);
			Если ИспПодразделения Тогда
				ПараметрПозиционирования = строка(стр.Подразделение) + "/" + ПараметрПозиционирования;
			КонецЕсли;
			Если ВыводитьГруппировкуПоСчетам Тогда
				ПараметрПозиционирования = строка(стр.Счет) + "/" + ПараметрПозиционирования;
			КонецЕсли;
			ОблСтрока.Параметры.Фонд_Р = ПараметрПозиционирования; 
			ТабДок.Вывести(ОблСтрока, 2);
			Если стр.счет = Справочники.ИА_Счета.ГлавныйСчет Тогда
				ГС_Оборот = ГС_Оборот + стр.ФП_Приход; 
			КонецЕсли;
			
			Продолжить;
		ИначеЕсли стр.Подразделение <> NULL Тогда
			ОблСтрока = Макет.ПолучитьОбласть("СтрокаПодразделение");		
			//Если стр.ПослеФП_Остаток < 0 Тогда
			//	ОблСтрока = Макет.ПолучитьОбласть("СтрокаКраснаяПодразделение");
			//КонецЕсли;			
			ОблСтрока.Параметры.Заполнить(стр);
			ОблСтрока.Параметры.Фонд   = стр.Подразделение;			
			Если ВыводитьГруппировкуПоСчетам Тогда
				ПараметрПозиционирования = "" + стр.Счет + "/" + стр.Подразделение;
			Иначе	
				ПараметрПозиционирования = "" + стр.Подразделение
			КонецЕсли;
			ОблСтрока.Параметры.Фонд_Р = ПараметрПозиционирования;			
			ТабДок.Вывести(ОблСтрока, 1);
		ИначеЕсли стр.Счет <> NULL Тогда
			ОблСтрока = Макет.ПолучитьОбласть("СтрокаСчет");
			ОблСтрока.Параметры.Заполнить(стр);
			ОблСтрока.Параметры.Фонд = стр.Счет;
			ОблСтрока.Параметры.Фонд_Р = "" + стр.Счет;
			ТабДок.Вывести(ОблСтрока, 0);
		КонецЕсли;
		
		ВывестиСтрокуОтчетаПоСоcтояниюФондов(стр, Макет, ТабДок);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьОстатокДС()
	
	МассивОрганизаций = МассивОрганизацийФП();
	Запрос= Новый Запрос;
	Запрос.УстановитьПараметр("НаДату", Объект.Дата+1);
	
	Рез = Новый Структура("СуммаНал, СуммаБезнал",0,0);
	
	//Арчил Тваладзе 21.04.2016
	//настроки заполнения реквизитов, заполняются в зависимости от базовой конфигурации, в Настройки
	СтруктураНастройкиРеквизитов = ИА_ФП_ПовторИсп.ПолучитьЗначениеКонстанты_ФП_НастройкиРеквизитов(); 
	
	Если СтруктураНастройкиРеквизитов.Свойство("ТипРегистраДенежныеСредства") и ЗначениеЗаполнено(СтруктураНастройкиРеквизитов.ТипРегистраДенежныеСредства) Тогда
		ТипРегистраДенежныеСредства = СтруктураНастройкиРеквизитов.ТипРегистраДенежныеСредства;
	Иначе
		Сообщить("Заполните настройки реквизитов ФП!");
		Возврат Рез;
	КонецЕсли;
	
	Если ТипРегистраДенежныеСредства = "РегистрНакопления"  Тогда
		
		СтруктураРегистраДенежныеСредства   = СтруктураНастройкиРеквизитов.СтруктураРегистраДенежныеСредства;
		КоличествоРегистровДенежныеСредства = СтруктураРегистраДенежныеСредства.КоличествоРегистровДенежныеСредства;
		
		Если КоличествоРегистровДенежныеСредства = 2 Тогда
			ИмяРегистраНаличные               = СтруктураРегистраДенежныеСредства.ИмяРегистраДенежныеСредстваНаличные;
			ИмяРегистраБезНаличные            = СтруктураРегистраДенежныеСредства.ИмяРегистраДенежныеСредстваБезНаличные;
			ИмяРесурсаСуммаУпрНаличные        = СтруктураРегистраДенежныеСредства.ИмяРесурсаСуммаУпрНаличные;
			ИмяРесурсаСуммаУпрБезНаличные     = СтруктураРегистраДенежныеСредства.ИмяРесурсаСуммаУпрБезНаличные;
		иначе 
			
			ИмяРегистраНаличные               = СтруктураРегистраДенежныеСредства.ИмяРегистраДенежныеСредства;
			ИмяРегистраБезНаличные            = СтруктураРегистраДенежныеСредства.ИмяРегистраДенежныеСредства;
			ИмяИзмеренияТипДенежныхСредств    = СтруктураРегистраДенежныеСредства.ИмяИзмеренияТипДенежныхСредств;
			ИмяПеречисленияТипДенежныхСредств = СтруктураРегистраДенежныеСредства.ИмяПеречисленияТипДенежныхСредств;
			ИмяРесурсаСуммаУпрНаличные        = СтруктураРегистраДенежныеСредства.ИмяРесурсаСуммаУпр;
			ИмяРесурсаСуммаУпрБезНаличные     = СтруктураРегистраДенежныеСредства.ИмяРесурсаСуммаУпр;
			
		КонецЕсли;
		
		Если КоличествоРегистровДенежныеСредства = 1 Тогда
			
			ФильтрПоТипуДенежныхСредств = "" + ИмяИзмеренияТипДенежныхСредств+" = Значение(Перечисление."+ИмяПеречисленияТипДенежныхСредств+".%ШаблонТипаДС%)";
			Если ФППоОрганизациям Тогда
				ФильтрПоОрганизации = ?(ФППоОрганизациям, " И Организация В (&Организация)","");
			КонецЕсли;
			
		иначе
			
			ФильтрПоТипуДенежныхСредств = "";
			Если ФППоОрганизациям Тогда
				ФильтрПоОрганизации = ?(ФППоОрганизациям, "Организация В (&Организация)","");
			КонецЕсли;
			
		КонецЕсли;
		
		ШаблонТекстаЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДенежныеСредстваОстатки.%ШаблонИмяРесурсаСуммаУпр%Остаток
		|ИЗ
		|	РегистрНакопления.%ШаблонИмяРегистра%.Остатки(&НаДату, "+ФильтрПоТипуДенежныхСредств + ФильтрПоОрганизации + ") КАК ДенежныеСредстваОстатки";
		
		// наличные
		ТекстЗапроса = СтрЗаменить(ШаблонТекстаЗапроса, "%ШаблонИмяРесурсаСуммаУпр%", ИмяРесурсаСуммаУпрНаличные);
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса,        "%ШаблонИмяРегистра%",        ИмяРегистраНаличные);
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса,        "%ШаблонТипаДС%",             "Наличные");
		Запрос.Текст =ТекстЗапроса;
		
		Если ФППоОрганизациям Тогда
			Запрос.УстановитьПараметр("Организация", МассивОрганизаций);
		КонецЕсли;
		
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Рез.СуммаНал = Выборка[ИмяРесурсаСуммаУпрНаличные+"Остаток"];
		КонецЦикла;
		
		// безналичные
