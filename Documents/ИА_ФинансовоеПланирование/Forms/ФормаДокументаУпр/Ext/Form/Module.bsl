&НаКлиенте
Процедура ЗаказыДоступностьСвернутьРазвернуть() Экспорт
	ЕстьСвернутые = ложь;
	Естьразвернутые = ложь;
	
	для каждого стр из ДеревоЗП.ПолучитьЭлементы() Цикл
		Если стр.получитьЭлементы().Количество() > 0 Тогда
			если Элементы.ДеревоЗП.Развернут(стр.получитьИдентификатор()) Тогда
				Естьразвернутые = истина;
			Иначе
				ЕстьСвернутые = истина;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Элементы.Заказы_РазвернутьВсеРазделы.Видимость = ЕстьСвернутые;
	Элементы.Заказы_СвернутьВсеРазделы.Видимость = Естьразвернутые;
КонецПроцедуры

