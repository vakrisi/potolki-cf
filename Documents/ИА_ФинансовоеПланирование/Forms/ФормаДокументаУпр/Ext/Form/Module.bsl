&НаКлиенте
Процедура ДоступностьСвернутьРазвернуть() Экспорт
	ЕстьСвернутые = ложь;
	Естьразвернутые = ложь;
	
	для каждого стр из ЗаливкаИтого.ПолучитьЭлементы() Цикл
		Если стр.получитьЭлементы().Количество() > 0 Тогда
			если Элементы.ЗаливкаФондов_Итого.Развернут(стр.получитьИдентификатор()) Тогда
				Естьразвернутые = истина;
			Иначе
				ЕстьСвернутые = истина;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Элементы.ЗаливкаФондов_ИтогоРазвернутьВсеРазделы.Видимость = ЕстьСвернутые;
	Элементы.ЗаливкаФондов_ИтогоСвернутьВсеРазделы.Видимость = Естьразвернутые;
КонецПроцедуры

&НаКлиенте
Процедура Заказы_СвернутьВсеРазделы(Команда)
	ОбновлятьДоступностьСвернутьРазвернутьЗаказы = ложь;
	
	Для каждого стр из ДеревоЗП.ПолучитьЭлементы() Цикл
		Для каждого стр1 из стр.ПолучитьЭлементы() Цикл
			Элементы.ДеревоЗП.Свернуть(стр1.получитьИдентификатор());
		КонецЦикла;
		Элементы.ДеревоЗП.Свернуть(стр.получитьИдентификатор());
	КонецЦикла;
	
	Элементы.Заказы_РазвернутьВсеРазделы.Видимость = истина;
	Элементы.Заказы_СвернутьВсеРазделы.Видимость = Ложь;
	
	ОбновлятьДоступностьСвернутьРазвернутьЗаказы = истина;
КонецПроцедуры

