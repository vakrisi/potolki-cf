&НаСервереБезКонтекста
Функция ПолучитьТабДокОписаниеЗаказа(тд, ОбъектОрганизация)
	ТабДокЛев = новый ТабличныйДокумент;
	ТабДокПрав = новый ТабличныйДокумент;
	макет = Документы.ИА_ФинансовоеПланирование.ПолучитьМакет("ОписаниеЗаказа");
	
	обл = макет.ПолучитьОбласть("ШапкаЛев");
	ЗаполнитьЗначенияСвойств(обл.Параметры, тд);
	обл.Параметры.Номер = УбратьНули(тд.Номер);
	обл.Параметры.ПредметЗаказа = ВРЕГ(тд.ПредметЗаказа);
	ТабДокЛев.Вывести(обл);
	
	обл = макет.ПолучитьОбласть("ШапкаПрав");
	ЗаполнитьЗначенияСвойств(обл.Параметры, тд);
	Если ЗначениеЗаполнено(тд.ОрганизацияДочерняя) и тд.ОрганизацияДочерняя <> ОбъектОрганизация ТОгда
		обл.Параметры.Организация = строка(тд.ОрганизацияДочерняя) + " / " + строка(ОбъектОрганизация);
	ИначеЕсли сокрлп(тд.Номер) = "" Тогда
		обл.Параметры.Организация = "";
	Иначе
		обл.Параметры.Организация = строка(ОбъектОрганизация);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(тд.Заказ) ТОгда
		обл.Параметры.Контрагент = тд.Заказ.Контрагент;
	КонецЕсли;
	
	ТабДокПрав.Вывести(обл);
	
	возврат Новый Структура("Левый, Правый", ТабДокЛев, ТабДокПрав);
КонецФункции

&НаСервереБезКонтекста
Функция УбратьНули(номер)
	Если не ЗначениеЗаполнено(номер) Тогда
		возврат "";
	КонецЕсли;
	
	рез = номер; 
	Пока Лев(рез, 1) = "0" Цикл 
	    рез = Прав(рез, СтрДлина(рез) - 1);
	КонецЦикла;
	Возврат рез;
КонецФункции
	
&НаКлиенте 
Процедура НайтиСтрокуДерева(КоллекцияЭлементовДерева, ТекущиеДанные, ИдентификаторСтроки, ПрекратитьПоиск) 
	
	Для Каждого СтрокаДерева Из КоллекцияЭлементовДерева Цикл 
		Если ПрекратитьПоиск Тогда 
			Возврат; 
		КонецЕсли; 
		
		Если СтрокаДерева = ТекущиеДанные Тогда 
			ИдентификаторСтроки = СтрокаДерева.ПолучитьИдентификатор(); 
			ПрекратитьПоиск = Истина; 
			Возврат; 
		КонецЕсли; 
		
		КоллекцияЭлементов = СтрокаДерева.ПолучитьЭлементы(); 
		
		Если КоллекцияЭлементов.Количество() > 0 Тогда 
			НайтиСтрокуДерева(КоллекцияЭлементов, ТекущиеДанные, ИдентификаторСтроки, ПрекратитьПоиск); 
		КонецЕсли; 
	КонецЦикла; 
	
КонецПроцедуры 

