&НаКлиенте
Процедура ОтложенныйДоходСуммаПриИзменении(Элемент)
	тд = Элементы.ОтложенныйДоход.ТекущиеДанные;
	Если тд = Неопределено тогда
		возврат;
	КонецЕсли;
	
	Если тд.ТипОперации = ПредопределенноеЗначение("Перечисление.КСУ_ОперацииСОтложеннымДоходом.Отложить") Тогда
		тд.Сумма = ПроверитьСуммуОтлДохода(тд.Подразделение, тд.ВидДохода , тд.Сумма);
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция ПроверитьСуммуОтлДохода(подр, вд, сумма)
	ДохСтроки = объект.Доходы.НайтиСтроки(Новый Структура("Подразделение,ВидДохода", подр, вд));	
	Если ДохСтроки.количество() = 0 тогда
		Сообщить("Данного вида дохода нет в таблице с доходами!");
		возврат 0;
	КонецЕсли;
	
	отл = объект.ОтложенныйДоход.Выгрузить();
	отл.Свернуть("Подразделение,ВидДохода,ТипОперации", "Сумма");
	
	отлСтроки = отл.НайтиСтроки(Новый Структура("Подразделение,ВидДохода, ТипОперации", подр, вд, Перечисления.КСУ_ОперацииСОтложеннымДоходом.Отложить));	
	СуммаОткл = отлСтроки[0].Сумма;
	
	Если СуммаОткл > ДохСтроки[0].СуммаБезнал Тогда
		Сообщить("Отложенный доход превышает сам доход!");
		Возврат сумма - (СуммаОткл - ДохСтроки[0].СуммаБезнал);
	Иначе
		возврат сумма;
	КонецЕсли;
КонецФункции

