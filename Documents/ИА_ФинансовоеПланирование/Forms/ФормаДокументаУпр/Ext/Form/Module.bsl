Процедура ДоходыПриАктивизацииСтроки(Элемент)
	
	Если Элемент.ТекущиеДанные <> Неопределено Тогда
		Элемент.ТекущиеДанные.Итого = Элемент.ТекущиеДанные.СуммаБезнал + Элемент.ТекущиеДанные.СуммаНал;
	КонецЕсли;
	Элементы.ДоходыЧистые.ТекстПодвала = Объект.Доходы.Итог("СуммаНал") + Объект.Доходы.Итог("СуммаБезнал");
КонецПроцедуры


&НаКлиенте
Процедура ЗаполнитьДатуФП1()
	Объект.ПериодФП1 = КонецДня(Объект.Дата - 12 * 7 * 24 * 60 * 60) + 1;
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	#ЕСЛИ ВебКлиент ТОГДА
		ЭтоВеб = истина;
	#КОНЕЦЕСЛИ	
		
	Если не ИА_Защита_Общий.ЛицензияДоступна("ФП") Тогда
		Отказ = Истина;
		возврат;
	КонецЕсли;
	
	СостояниеЗаказаОдобренКлиент     = ИА_ФП.СтатусыОдобрено();
	
	ЕстьСтатистики = ИА_КСУОбщийСервер.ЕстьСтатистики();
	Элементы.ПолеТабДокСтатистики.Видимость = ЕстьСтатистики;
	Элементы.ОбновитьГрафики.Видимость = ЕстьСтатистики;
	Элементы.РаскрытьНаВесьЭкранГрафики.Видимость = ЕстьСтатистики;
	Элементы.ДекорацияНетСтатистик.Видимость = не ЕстьСтатистики;
	
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Если  ФППоОрганизациям = ложь или объект.Организация.Пустая() = ложь тогда 
			ОбновитьДокументКлиент();
			ОбновитьЗНО_Сервер();
		КонецЕсли;
	Иначе
		ПриОткрытииНаСервере1();
		ПересчитатьСальдоСредствКРаспределению();
	КонецЕсли;
	
	Если Объект.ПериодФП1 = Дата(1,1,1) Тогда
		ЗаполнитьДатуФП1();
	КонецЕсли;
	
	Элементы.Организация.Видимость = ФППоОрганизациям;
	ОбновитьОтображениеИтого();
	
	Если  ФППоОрганизациям = ложь или объект.Организация.Пустая() = ложь тогда
		ОбновитьОтчетПоСотояниюФондов();
	Иначе
		Элементы.ГруппаГлавная.Доступность = ложь;
	КонецЕсли;
	
	ПодключитьОбработчикОжидания("ПроверитьИзменениеРазмераОкна", 1, ложь);	
	
	Попытка
		#ЕСЛИ ВебКлиент ТОГДА
			ЭтоВеб = истина;
			Элементы.ПолеСтатистика.Видимость = ложь;
			Элементы.ПолеТабДокСтатистики.Видимость = ложь;
		#ИНАЧЕ
			ФормаСтатистик = ПолучитьФорму("Обработка.ИА_РабочийСтолСтатистик_Упр_HTML.Форма",,, ЭтаФорма.УникальныйИдентификатор);
		#КОНЕЦЕСЛИ
	Исключение
	КонецПопытки;
    
    Политика_Развернуть(1);
	Политика_Развернуть(2);
	
	// заглушка для отрисовки статистик
	sw = 1000;
	
	ОбновитьДоступностьПоУтверждению();
	ОбновитьВидимостьКнопкиПроведения();
	
	ВысотаЧистыхДоходов();
	ПоказатьСкрытьДеталиСостоянияФондов(Неопределено);
	ПоказатьСкрытьДеталиСостоянияФондов1(Неопределено);
	
	если ЕстьОшибкаВерсииТБ Тогда
		Оп = Новый ОписаниеОповещения("ЗакрытиеОшибкиВерсииТБ", ЭтотОбъект);
		ОткрытьФорму("Документ.ИА_ФинансовоеПланирование.Форма.ОшибкаВерсииТБ", , ЭтаФорма,,,, Оп, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	КонецЕсли;
	
	КолонкиВертикальноГоризонтально(Неопределено);
	ЗаказыДоступностьСвернутьРазвернуть();
	ОбновлятьДоступностьСвернутьРазвернутьЗаказы = истина;
	
	Элементы.ГруппироватьПоСчетам.Пометка = ВыводитьГруппировкуПоСчетам;
	
	ОбновитьОписаниеЗаказа();
	ОбновитьТекстАвтостатус();
	
	Доходы_ДатаНачала1 = ПолучитьДатуНачалаДоходов();
	Если объект.ЕстьАвтодоходы И не объект.Ссылка.Пустая() и не объект.РучнойПериодДоходов и ЗначениеЗаполнено(объект.Доходы_ДатаНачала) и объект.Доходы_ДатаНачала <> Доходы_ДатаНачала1 и не объект.Проведен Тогда
		ПоказатьПредупреждение(,"Левая граница интервала автоматического сбора доходов 
								|отличается от сохраненной. Возможно, были изменены более 
								|ранние документы ФП. Интервал будет изменен автоматически 
								|во избежание пропуска поступления средств.");
		ОбновитьПериодыДоходов();
		ОбновитьДокумент();
	Иначе
		ОбновитьПериодыДоходов(ложь);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ЗакрытиеОшибкиВерсииТБ(рез, дп) Экспорт
	Если рез<> Неопределено и рез Тогда
		ОбновитьДокументКлиент();
	Иначе
		Закрыть();
	КонецЕсли;
