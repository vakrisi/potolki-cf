&НаКлиенте
Процедура СпозиционироватсяНаСтрокеДереваЗП(СсылкаЗВС)
	
	Если ЗначениеЗаполнено(СсылкаЗВС) Тогда
		
		ТекущаяСтрока =Неопределено;
		НайденЭлемент=ложь;
		
		ТекущаяСтрока = ПолучитьСтрокуЗП(ДеревоЗП, СсылкаЗВС);
		
	КонецЕсли;
	
	Если Не ТекущаяСтрока=Неопределено Тогда 
		Элементы.ДеревоЗП.ТекущаяСтрока=ТекущаяСтрока.ПолучитьИдентификатор();	 
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ПолучитьСтрокуЗП(Родитель, СсылкаЗВС)
	
	ЭлементыДереваЗП = Родитель.ПолучитьЭлементы();
	
	Для каждого ЭлементДереваЗП  Из ЭлементыДереваЗП Цикл
		Если ЭлементДереваЗП.Заказ = СсылкаЗВС Тогда
			ТекущаяСтрока = ЭлементДереваЗП;
			Возврат  ТекущаяСтрока;
		иначе
			ТекущаяСтрока = ПолучитьСтрокуЗП(ЭлементДереваЗП, СсылкаЗВС);
			Если ТекущаяСтрока <> Неопределено Тогда
				Возврат ТекущаяСтрока;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
КонецФункции

