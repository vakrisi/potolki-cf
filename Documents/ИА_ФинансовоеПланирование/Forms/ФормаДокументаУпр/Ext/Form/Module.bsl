&НаКлиенте
Процедура ОбновитьДокументКлиент()

	ПредФпСтрукт = ПолучитьПоследнееФП();
	
	ОбновитьПериодыДоходов();
	
	Объект.ОтложенныйДоход.Очистить();
	
	ОбновитьДокумент();
	
