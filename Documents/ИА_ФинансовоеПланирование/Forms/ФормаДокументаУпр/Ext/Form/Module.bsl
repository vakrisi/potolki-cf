&НаКлиенте
Процедура РедактироватьЗначениеПолитики1Обрабочик(данные, дп) Экспорт
	Если ТипЗнч(Данные) = Тип("Массив") Тогда
        Отбор = Новый Структура("ВидДохода, Раздел, Подразделение, Статья");
        
        Для каждого Стр Из Данные Цикл
            ЗаполнитьЗначенияСвойств(Отбор, Стр);
            
            М = Объект.Политика1.НайтиСтроки(Отбор);
            Для каждого СтрП1 Из М Цикл
                ЗаполнитьЗначенияСвойств(СтрП1, Стр, "Сумма");
                СтрП1.Вручную = Истина;
            КонецЦикла;  
        КонецЦикла;  
        
		ЗаполнитьДоходыИПолитикиСервер(ложь, ложь,истина,истина, ложь, истина);
		Политика_Развернуть(1,Отбор);
		Политика_Развернуть(2);
    КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура РедактироватьЗначениеПолитики1(ТекСтрока)
	Если ФП_по_ТБ Тогда
		М = Объект.Политика1.НайтиСтроки(Новый Структура("Подразделение, Статья" ,ТекСтрока.Подразделение, ТекСтрока.Фонд));
	Иначе
	    М = Объект.Политика1.НайтиСтроки(Новый Структура("Раздел, Подразделение, Статья" ,ТекСтрока.Раздел, ТекСтрока.Подразделение, ТекСтрока.Статья));
	КонецЕсли;
    
    Колонки = "Раздел, Подразделение, Статья, ВидДохода, СуммаАвто, Сумма";
    
    ТЗФ = Новый Массив;
    Для каждого Стр Из М Цикл
        ТЗФ.Добавить(ИА_БФКС.Струк_Новый(Колонки, Стр));
    КонецЦикла;  
	
	парам = Новый Структура("Распределение1", ТЗФ);
	опов = Новый ОписаниеОповещения("РедактироватьЗначениеПолитики1Обрабочик",ЭтаФорма);
    ОткрытьФорму("Документ.ИА_ФинансовоеПланирование.Форма.ФормаРедактированияРаспределенияПолитики1", парам,ЭтаФорма,,,,опов, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
 
КонецПроцедуры

