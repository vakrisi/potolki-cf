&НаКлиенте
Процедура ДеревоСостояниеФондовПриАктивизацииСтроки(Элемент)
	
	Если НеПозиционировать Тогда
		НеПозиционировать = ложь;
		возврат;
	КонецЕсли;
	
	тд = Элементы.ДеревоСостояниеФондов.ТекущиеДанные;
	
	Если тд = Неопределено Тогда
		возврат;
	КонецЕсли;
	
	Если ТипЗнч(тд.СчетПодразделениеФонд) = тип("СправочникСсылка.ИА_Фонды") Тогда
		тдЗ = Элементы.ДеревоЗП.ТекущиеДанные;
		
		Если тдЗ = Неопределено Тогда
			возврат;
		КонецЕсли;
		
		Если тдЗ.Фонд = тд.СчетПодразделениеФонд Тогда
			возврат;
		КонецЕсли;
		
		ОтборФонд = тд.СчетПодразделениеФонд;
		ОтборПодр = ПредопределенноеЗначение("Справочник.ИА_ЦФО.ПустаяСсылка");
		ОтборСчет = ПредопределенноеЗначение("Справочник.ИА_Счета.ПустаяСсылка");
		
		текР = тд.ПолучитьРодителя();
		Если текР<>Неопределено Тогда
			Если ТипЗнч(текР.СчетПодразделениеФонд) = тип("СправочникСсылка.ИА_ЦФО") Тогда
				ОтборПодр = текР.СчетПодразделениеФонд;
			ИначеЕсли ТипЗнч(текР.СчетПодразделениеФонд) = тип("СправочникСсылка.ИА_Счета") Тогда
				ОтборСчет = текР.СчетПодразделениеФонд;
			КонецЕсли;
			
			текР1 = текР.ПолучитьРодителя();
			Если текР1<>Неопределено и ТипЗнч(текР1.СчетПодразделениеФонд) = тип("СправочникСсылка.ИА_Счета") Тогда
				ОтборСчет = текР1.СчетПодразделениеФонд;
			КонецЕсли;
		КонецЕсли;
		ДанныеЗП = новый Структура("счет, подразделение, фонд", ОтборСчет, ОтборПодр, ОтборФонд);
		НайдСтрокаФонд = НайтиСтрокуФондВДереверЗП(ДанныеЗП, ложь);			
		
		Если НайдСтрокаФонд <> Неопределено Тогда
			Элементы.ДеревоЗП.ТекущаяСтрока = НайдСтрокаФонд.получитьИдентификатор();
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

