&НаКлиенте
Процедура СохранитьИтогиВОбъект()
	Объект.Доходы.Очистить();
	Для каждого стрПодр из ДоходыДерево.ПолучитьЭлементы() Цикл
		если ИспДоходыПоПодразделениям Тогда
			Для каждого стрДоход из стрПодр.ПолучитьЭлементы() Цикл
				Новстр = Объект.Доходы.Добавить();
				ЗаполнитьЗначенияСвойств(новстр, стрДоход);
				Новстр.Подразделение = стрПодр.ВидДохода; 
			КонецЦикла;
		ИНаче
			Новстр = Объект.Доходы.Добавить();
			ЗаполнитьЗначенияСвойств(новстр, стрПодр);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

