Процедура ФП1ФондПриИзменении(Элемент)
	тд = Элементы.ФП1.ТекущиеДанные;
	ОбновитьСреднееФП1(тд.Подразделение, тд.Фонд);
КонецПроцедуры

////////////// +ДИРЕКТИВА ФП
&НаСервере
Функция СформироватьПФ_ДирективаФП_ТБ(ДокФП)
	ТабДок = Новый ТабличныйДокумент;
	Макет = Документы.ИА_ФинансовоеПланирование.ПолучитьМакет("Директива");
	
	Запрос = новый запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ИА_РаспределениеНедель.КонецНедели
	               |ИЗ
	               |	РегистрСведений.ИА_РаспределениеНедель КАК ИА_РаспределениеНедель
	               |ГДЕ
	               |	ИА_РаспределениеНедель.Период = &Период";
	Запрос.УстановитьПараметр("Период",объект.НеделяТБ);
	выборка = запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	
	Обл = Макет.ПолучитьОбласть("Шапка");
	//обл.Параметры.Дата = объект.Дата;
	обл.Параметры.Шапка1 = "ФП №"+ объект.Номер + " от " + формат(объект.Дата, "ДФ=dd.MM.yyyy")+ ", статус " + ?(объект.Проведен, """Утверждено""", """Черновик""");
	Если ФП_по_ТБ Тогда
		обл.Параметры.Шапка2 = "ТБ №"+ объект.ТБ.Номер +", " + нрег(формат(объект.тб.Месяц, "ДФ='ММММ yyyy'"));
	КонецЕсли;
	обл.Параметры.ДатаОтчета = ТекущаяДата();
	обл.Параметры.НеделяТБ = формат(объект.НеделяТБ, "ДФ=dd.MM.yyyy");
	обл.Параметры.КонецНедели = формат(Выборка.КонецНедели, "ДФ=dd.MM.yyyy");
	ТабДок.Вывести(обл);
	
	///////////////// Внедоходные
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	ДокументКСУ_ВнедоходноеПоступлениеСредств.Ссылка КАК Ссылка,
	               |	ДокументКСУ_ВнедоходноеПоступлениеСредств.Номер КАК Номер,
	               |	ДокументКСУ_ВнедоходноеПоступлениеСредств.Дата КАК Дата,
	               |	ДокументКСУ_ВнедоходноеПоступлениеСредств.ТипИсточникаСредств КАК ТипИсточникаСредств,
	               |	ДокументКСУ_ВнедоходноеПоступлениеСредств.ИсточникСредств КАК ИсточникСредств,
	               |	ДокументКСУ_ВнедоходноеПоступлениеСредств.Комментарий КАК Комментарий,
	               |	ДокументКСУ_ВнедоходноеПоступлениеСредств.СуммаДокумента КАК Сумма,
	               |	ЕСТЬNULL(НаФонды.Сумма, 0) КАК ВФонды,
	               |	ЕСТЬNULL(НаЗаказы.Сумма, 0) КАК НаЗаказы
	               |ИЗ
	               |	Документ.КСУ_ВнедоходноеПоступлениеСредств КАК ДокументКСУ_ВнедоходноеПоступлениеСредств
	               |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	               |			КСУ_ВнедоходноеПоступлениеСредствИА_Фонды.Ссылка КАК Ссылка,
	               |			СУММА(КСУ_ВнедоходноеПоступлениеСредствИА_Фонды.Сумма) КАК Сумма
	               |		ИЗ
	               |			Документ.КСУ_ВнедоходноеПоступлениеСредств.ИА_Фонды КАК КСУ_ВнедоходноеПоступлениеСредствИА_Фонды
	               |		
	               |		СГРУППИРОВАТЬ ПО
	               |			КСУ_ВнедоходноеПоступлениеСредствИА_Фонды.Ссылка) КАК НаФонды
	               |		ПО (НаФонды.Ссылка = ДокументКСУ_ВнедоходноеПоступлениеСредств.Ссылка)
	               |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	               |			ИА_ЗаказыНаПриобретение.Ссылка КАК Ссылка,
	               |			СУММА(ИА_ЗаказыНаПриобретение.Сумма) КАК Сумма
	               |		ИЗ
	               |			Документ.КСУ_ВнедоходноеПоступлениеСредств.ИА_ЗаказыНаПриобретение КАК ИА_ЗаказыНаПриобретение
	               |		
	               |		СГРУППИРОВАТЬ ПО
	               |			ИА_ЗаказыНаПриобретение.Ссылка) КАК НаЗаказы
	               |		ПО (НаЗаказы.Ссылка = ДокументКСУ_ВнедоходноеПоступлениеСредств.Ссылка)
	               |ГДЕ
	               |	(ДокументКСУ_ВнедоходноеПоступлениеСредств.Организация = &Организация
	               |			ИЛИ &НеПоОрг)
	               |	И ДокументКСУ_ВнедоходноеПоступлениеСредств.Дата МЕЖДУ &ДатаНачалаТБ И &ДатаКонцаТБ
	               |	И ДокументКСУ_ВнедоходноеПоступлениеСредств.Проведен";
	для каждого п из ВнедоходныеПоступления.Параметры.Элементы цикл
		запрос.УстановитьПараметр(п.Параметр, п.Значение);
	КонецЦикла;
	тз = запрос.Выполнить().Выгрузить();
	
	Обл = Макет.ПолучитьОбласть("ВДШапка");
	ТабДок.Вывести(обл);
	Для каждого стр из тз Цикл
		Обл = Макет.ПолучитьОбласть("ВДСтрока");
		ЗаполнитьЗначенияСвойств(Обл.Параметры, стр);
		Обл.Параметры.НомерТип = стр.Номер + " / " + стр.ТипИсточникаСредств + " / " + стр.ИсточникСредств;
		ТабДок.Вывести(обл);
	КонецЦикла;
	Обл = Макет.ПолучитьОбласть("ВДСтрокаИтого");
	Обл.Параметры.Дата = "Итого:";
	Обл.Параметры.Сумма = тз.Итог("Сумма");
	Обл.Параметры.НаЗаказы = тз.Итог("НаЗаказы");
	Обл.Параметры.ВФонды = тз.Итог("ВФонды");
	ТабДок.Вывести(обл);

	
	///////////////// ДОХОДЫ
	ДоходыЧистыеДер = РеквизитФормыВЗначение("ДоходыЧистые");
	
	Обл = Макет.ПолучитьОбласть("ДоходыШапка");
	ТабДок.Вывести(обл);
	Если ИспДоходыПоПодразделениям Тогда
		Для каждого стрПодр из ДоходыЧистые.ПолучитьЭлементы() Цикл
			Обл = Макет.ПолучитьОбласть("ДоходыСтрока");
			ЗаполнитьЗначенияСвойств(Обл.Параметры, стрПодр);
			Обл.Параметры.НедельныйПлан = стрПодр["СуммаПлан"+НомерТекущейНедели];
			Обл.Параметры.НедельныйФакт = стрПодр["СуммаФакт"+НомерТекущейНедели];
			Обл.Параметры.ПроцентНедельный = стрПодр["Процент"+НомерТекущейНедели];
			ТабДок.Вывести(обл);
