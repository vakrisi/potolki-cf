&НаКлиенте
Функция ПроверкаНаДобавлениеЗаказа(рез)
	
	ТекущаяСтрока =Неопределено;
	
	Если ЗначениеЗаполнено(рез) Тогда
		ТекущаяСтрока = ПолучитьСтрокуЗП(ДеревоЗП, рез);
	КонецЕсли;
	
	Если ТекущаяСтрока=Неопределено Тогда 
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции


&НаКлиенте
Процедура КомандаДобавитьОбработчик(рез, дп) Экспорт
	новстр = Неопределено;
	
	рез = формаНовогоЗаказа.Объект.Ссылка;
	Если ЗначениеЗаполнено(рез) Тогда
		Если ПроверкаНаДобавлениеЗаказа(рез) Тогда
			
			// добавим строки дерева
			ДанныеЗП = ПолучитьДанныеИзЗаказа(рез);
			Если (ИспПодразделения и ДанныеЗП.Подразделение.пустая()) или ДанныеЗП.Фонд.пустая() Тогда 
				ПоказатьПредупреждение(,"В заказе должны быть указаны подразделение и фонд!");
				Возврат;
			КонецЕсли;
									
			НайдСтрокаФонд = НайтиСтрокуФондВДереверЗП(ДанныеЗП);			
			
			// ДОБАВИМ ЗАКАЗ
			Новстр = НайдСтрокаФонд.ПолучитьЭлементы().Добавить();
			новстр.Фонд = ДанныеЗП.Фонд;
			новстр.Статья = ДанныеЗП.Статья;
			//новстр.ПодразделениеФонд = Строка(ДанныеЗП.Фонд); 
			новстр.ПодразделениеФонд = "№" + строка(число(ДанныеЗП.Номер)) + " " +ВРЕГ(ДанныеЗП.ПредметЗаказа);									
			Новстр.Заказ = рез;
			Новстр.ПредметЗаказа = ДанныеЗП.ПредметЗаказа;
			Новстр.Ситуация = ДанныеЗП.Ситуация;
			Новстр.Данные = ДанныеЗП.Данные;
			Новстр.Решение = ДанныеЗП.Решение;
			Новстр.Дата = ДанныеЗП.Дата;
			Новстр.Номер = ДанныеЗП.Номер;
			Новстр.СрокОплаты = ДанныеЗП.СрокОплаты;
			
			Если ВыводитьГруппировкуПоСчетам Тогда
				Новстр.Счет = ДанныеЗП.Счет;
			КонецЕсли;
			Если ИспПодразделения Тогда
				новстр.Подразделение = ДанныеЗП.Подразделение;
			КонецЕсли;
			
			ДеревоЗПЗаказПриИзменении(Новстр);
			СохранитьДеревоЗаказов();
		Иначе
			ПоказатьПредупреждение(,"Заказ уже добавлен!");
		КонецЕсли;
	КонецЕсли;
	
	Если новстр <> Неопределено Тогда
		Элементы.ДеревоЗП.ТекущаяСтрока = новстр.ПолучитьИдентификатор();
	КонецЕсли;

КонецПроцедуры
	
&НаКлиенте
Процедура КомандаДобавить(Команда)
		
	тд = Элементы.ДеревоЗП.ТекущиеДанные;
	
	ПараметрыОтбора = Новый Структура;	
	ПараметрыОтбора.Вставить("Организация", Объект.Организация);
	ПараметрыОтбора.Вставить("НеОповещать", истина);
	если тд<>Неопределено Тогда
		ПараметрыОтбора.Вставить("Фонд", тд.Фонд);
		ПараметрыОтбора.Вставить("Подразделение", тд.Подразделение);
	КонецЕсли;
	ПараметрыОтбора.Вставить("Статус", ПредопределенноеЗначение("Перечисление.ИА_СостояниеЗаказа.РассмотретьНаФП"));
	ПараметрыОтбора.Вставить("Дата", Объект.Дата - 60);
		
	формаНовогоЗаказа = ОткрытьФорму("Документ.ИА_ЗаказНаПриобретение.Форма.ФормаДокументаУпр", ПараметрыОтбора, ЭтаФорма,,,,Новый ОписаниеОповещения("КомандаДобавитьОбработчик",ЭтаФорма), РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Функция НайтиСтрокуФондВДереверЗП(ДанныеЗП, создавать = истина)
	
	ТекСтрока =  ДеревоЗП;
	Если ВыводитьГруппировкуПоСчетам Тогда	
		Найдено = ложь;
		для каждого стр из ТекСтрока.ПолучитьЭлементы() Цикл
			Если стр.счет =  ДанныеЗП.Счет Тогда
				ТекСтрока = стр;
				Найдено = истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если не найдено Тогда
			Если создавать Тогда
				ТекСтрока = ТекСтрока.ПолучитьЭлементы().Добавить();
				ТекСтрока.Счет = ДанныеЗП.Счет;
				ТекСтрока.ПодразделениеФонд = Строка(ДанныеЗП.Счет);
			Иначе
				возврат Неопределено;
			КонецЕсли;
		КонецЕсли;		
	КонецЕсли;
	
	Если ИспПодразделения Тогда	
		Найдено = ложь;
		для каждого стр из ТекСтрока.ПолучитьЭлементы() Цикл
			Если стр.Подразделение =  ДанныеЗП.Подразделение Тогда
				ТекСтрока = стр;
				Найдено = истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если не найдено Тогда
			Если создавать ТОгда
				ТекСтрока = ТекСтрока.ПолучитьЭлементы().Добавить();
				ТекСтрока.Подразделение = ДанныеЗП.Подразделение;
				Если ВыводитьГруппировкуПоСчетам Тогда
					ТекСтрока.Счет = ДанныеЗП.Счет;
				КонецЕсли;
				ТекСтрока.ПодразделениеФонд = Строка(ДанныеЗП.Подразделение);
			Иначе
				возврат Неопределено;
			КонецЕсли;
		КонецЕсли;		
	КонецЕсли;
	

	Найдено = ложь;
	для каждого стр из ТекСтрока.ПолучитьЭлементы() Цикл
		Если стр.Фонд =  ДанныеЗП.Фонд Тогда
			ТекСтрока = стр;
			Найдено = истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если не найдено Тогда
		Если создавать тогда
			ТекСтрока = ТекСтрока.ПолучитьЭлементы().Добавить();
			ТекСтрока.Фонд = ДанныеЗП.Фонд;
			Если ИспПодразделения Тогда
				ТекСтрока.Подразделение = ДанныеЗП.Подразделение;
			КонецЕсли;
			Если ВыводитьГруппировкуПоСчетам Тогда
					ТекСтрока.Счет = ДанныеЗП.Счет;
				КонецЕсли;
			ТекСтрока.ПодразделениеФонд = Строка(ДанныеЗП.Фонд);
		Иначе
			возврат Неопределено;
		КонецЕсли;
	КонецЕсли;
		
	Возврат ТекСтрока;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьДанныеИзЗаказа(пЗаказ)
	Возврат Новый Структура("ПредметЗаказа, Ситуация,Данные,Решение,Дата,СрокОплаты,Номер,Подразделение, Фонд, Счет, Статья", 
							пЗаказ.ПредметЗаказа, пЗаказ.Ситуация, пЗаказ.Данные, пЗаказ.Решение, пЗаказ.Дата, пЗаказ.ДатаОплаты, пЗаказ.Номер,пЗаказ.Подразделение, пЗаказ.Фонд, пЗаказ.Фонд.Счет,  пЗаказ.Статья);
КонецФункции	

&НаСервере
Функция ПолучитьДанныеПоСтрокеЗВС(ИзменениеСтатусаСуммыУтв = Ложь, СтрукТекСтр = Неопределено)	
	
	БылиИзменения = Ложь;
	ЕстьОшибка = Ложь;
	НехваткаСуммы = 0;
	
	СостояниеЗаказаОдобрен     = ИА_ФП.СтатусыОдобрено();
	
	Если ИзменениеСтатусаСуммыУтв и СтрукТекСтр <> Неопределено Тогда
		Если ЗначениеЗаполнено(СтрукТекСтр.Заказ) и (СостояниеЗаказаОдобрен.найти(СтрукТекСтр.Статус) <> Неопределено) Тогда // проконтролируем сумму
			//ВыходнаяТаблица = Новый ТаблицаЗначений;
			ОбновитьОтчетПоСотояниюФондов(ложь);
			СтрПоиска = Новый Структура("Фонд,Подразделение", СтрукТекСтр.Фонд, СтрукТекСтр.Подразделение);
			НСтроки = ВыходнаяТаблица.НайтиСтроки(СтрПоиска); 
			Если НСтроки.Количество()>0 Тогда
				СтрокаСостояния = НСтроки[0];				
				Если СтрокаСостояния.ПослеФП_Остаток < 0 Тогда
					ЕстьОшибка = Истина;
					НехваткаСуммы = -СтрокаСостояния.ПослеФП_Остаток; 
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Струк = Новый Структура("НехваткаСуммы,ЕстьОшибка", НехваткаСуммы,ЕстьОшибка);
	Возврат Струк;
	
КонецФункции


&НаКлиенте
Процедура КомандаПомощникПополненияФондаОбработчик(рез, дп) Экспорт
	БылиИзменения = Ложь;
	ТекСтрока = Элементы.ДеревоЗП.ТекущиеДанные;
	Если рез <> Неопределено Тогда
		
		Если рез.СальдоСредствКРаспределениюВзять > 0 Тогда
			БылиИзменения = Истина;			
			ТекСтрока.ПолучитьРодителя().НачислениеВФонд = ТекСтрока.ПолучитьРодителя().НачислениеВФонд + рез.СальдоСредствКРаспределениюВзять;
		КонецЕсли;
							
		Для каждого стрТ из рез.ТаблицаФондов Цикл
			Если стрТ.Взять>0 Тогда
				БылиИзменения = Истина;
				
				Новстр = Займы.Добавить();
				Новстр.НаПодразделение = ТекСтрока.Подразделение;
				Новстр.НаФонд = ТекСтрока.Фонд;
				Новстр.СПодразделения = стрТ.Подразделение;
				Новстр.СФонда = стрТ.Фонд;
				Новстр.Сумма = стрТ.Взять;					
				
				Если рез.Займ Тогда
					Новстр.ЗаймВозврат = ПредопределенноеЗначение("Перечисление.ИА_ЗаймВозврат.Займ");
					Новстр.ПричинаЗайма = рез.ПричинаЗайма;
					Новстр.Комментарий = рез.Комментарий;
					Новстр.КрайнийСрок = рез.КрайнийСрок;
				Иначе
					Новстр.ЗаймВозврат = ПредопределенноеЗначение("Перечисление.ИА_ЗаймВозврат.Перемещение");
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
	ПересчитатьДерево();
	Если БылиИзменения Тогда
		ЗаймыПриИзменении(Неопределено);
		ПересчитатьСальдоСредствКРаспределению();
	КонецЕсли;
	ОбновитьОтчетПоСотояниюФондов();
	
	ПредВыдОбл = Неопределено;
	ДеревоЗППриАктивизацииСтроки(Неопределено);
КонецПроцедуры
	
	
&НаКлиенте
Процедура КомандаПомощникПополненияФонда(Команда)
	
	тд = Элементы.ДеревоЗП.ТекущиеДанные;
	
	Если Элементы.ДеревоЗП.ТекущаяСтрока <> Неопределено Тогда
		подр = ?(ИспПодразделения,тд.Подразделение,ПредопределенноеЗначение("Справочник.ИА_ЦФО.ПустаяСсылка"));
		СтрукТекСтр = Новый Структура("Фонд,Подразделение,Статус,Заказ", тд.Фонд,подр , тд.Статус,тд.Заказ);
		стр = ПолучитьДанныеПоСтрокеЗВС(истина,СтрукТекСтр);
		// возвращаем текущую строку
		ИдентификаторСтроки = 0; 
		ПрекратитьПоиск = Ложь; 
		НайтиСтрокуДерева(ДеревоЗП.ПолучитьЭлементы(), тд, ИдентификаторСтроки, ПрекратитьПоиск); 
		Элементы.ДеревоЗП.ТекущаяСтрока = ИдентификаторСтроки;
		
		БылиИзменения = Ложь;
		Если стр.ЕстьОшибка Тогда
			ПараметрыИзФормы = Новый Структура;	
			ПараметрыИзФормы.Вставить("ВыходнаяТаблица", ВыходнаяТаблица);
			ПараметрыИзФормы.Вставить("Подразделение", подр);
			ПараметрыИзФормы.Вставить("Фонд", тд.Фонд);
			ПараметрыИзФормы.Вставить("СальдоСредствКРаспределению",  Объект.СальдоСредствКРаспределениюБезнал);
			ПараметрыИзФормы.Вставить("ИсходнаяСумма", стр.НехваткаСуммы);
			ПараметрыОтбора = Новый Структура("ПараметрыОтбора", ПараметрыИзФормы);
			
			рез = ОткрытьФорму("Документ.ИА_ФинансовоеПланирование.Форма.ФормаПомощникПоЗаказуУпр",ПараметрыОтбора,ЭтаФорма,,,,Новый ОписаниеОповещения("КомандаПомощникПополненияФондаОбработчик", ЭтаФорма),РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);		
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры


