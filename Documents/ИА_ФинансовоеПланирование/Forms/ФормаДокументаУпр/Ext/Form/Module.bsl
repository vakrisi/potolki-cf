&НаКлиенте
Перем ПредВыдОбл, МассивПредЦветов,ФормаСтатистик, формаНовогоЗаказа, СостояниеЗаказаОдобренКлиент;

&НаСервере
Процедура ЗаполнитьДеревоДоходов()

	дер = РеквизитФормыВЗначение("ДоходыДерево");
	дер.Строки.Очистить();
	Для каждого стр из Объект.Доходы Цикл
		Если ИспДоходыПоПодразделениям Тогда
			стрПодр = дер.Строки.Найти(стр.Подразделение, "ВидДохода");
			Если стрПодр = Неопределено Тогда
				стрПодр = дер.Строки.Добавить();
				стрПодр.ВидДохода = стр.Подразделение; 
			КонецЕсли;
		Иначе
			стрПодр = дер;
		КонецЕсли;
		
		стрДоход = стрПодр.Строки.Добавить();
		ЗаполнитьЗначенияСвойств(стрДоход, стр);
	КонецЦикла;
	
	Если ИспДоходыПоПодразделениям ТОгда
		ЗаполнитьИтогиДеревоДоходов(дер);
	КонецЕсли;
	ЗначениеВРеквизитФормы(дер,"ДоходыДерево");

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьИтогиДеревоДоходов(дер)
	Для каждого стр из дер.Строки Цикл
		стр.СуммаБезнал = стр.строки.итог("СуммаБезнал");
	КонецЦикла;
	
	Элементы.ДоходыДеревоСуммаБезнал.ТекстПодвала = формат(дер.строки.итог("СуммаБезнал", ложь),"ЧДЦ=2; ЧН=");
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДеревоДоходовЧистых()
	
	дер = РеквизитФормыВЗначение("ДоходыЧистые");
	дер.Строки.Очистить();
	
	Для каждого стр из Объект.Доходы Цикл
		Если ИспДоходыПоПодразделениям Тогда
			стрПодр = дер.Строки.Найти(стр.Подразделение, "ВидДохода");
			Если стрПодр = Неопределено Тогда
				стрПодр = дер.Строки.Добавить();
				стрПодр.ВидДохода = стр.Подразделение; 
				стрПодр.ЭтоПодразделение = истина;
			КонецЕсли;
		Иначе
			стрПодр = дер;
		КонецЕсли;
		
		стрДоход = стрПодр.Строки.Добавить();
		ЗаполнитьЗначенияСвойств(стрДоход, стр);
		стрДоход.Сумма = стр.СуммаБезнал;
	КонецЦикла;
	ЗначениеВРеквизитФормы(дер,"ДоходыЧистые");

КонецПроцедуры
	 
 &НаСервере
Процедура ЗаполнитьДоходыИПолитикиСервер(ЗаполнитьДоходы, ЗаполнитьДоходыИтого, ЗаполнитьПолитику1, ЗаполнитьПолитику2, ЗаполнитьЗапросы = ложь, НеОчищатьРучные = Ложь)
	
	Если Объект.Организация.Пустая() и ФППоОрганизациям Тогда
		возврат;
	КонецЕсли;
	
	Об = РеквизитФормыВЗначение("Объект");    
    ИА_ФПСервер.ЗаполнитьДокумент(Об, ЗаполнитьДоходы, ЗаполнитьДоходыИтого, ЗаполнитьПолитику1, ЗаполнитьПолитику2,ЗаполнитьЗапросы, НеОчищатьРучные, ПредФп, ФП_по_ТБ,,ИспДоходыПоПодразделениям);
    ЗначениеВРеквизитФормы(Об, "Объект");
	
	ЗаполнитьДеревоДоходов();
	ЗаполнитьДеревоДоходовЧистых();
	Если ФП_по_ТБ Тогда
		ОбновитьНеделиДоходыЧистые();
		ПересчитатьДоходыИтого();
		ОбновитьИтогоВЗаливку();
	КонецЕсли;

	ПересчитатьСальдоСредствКРаспределению();
	
	Если ЗаполнитьПолитику1 Тогда
    	Политика_ВДерево(1);
	КонецЕсли;	
	
	Если ЗаполнитьПолитику2 тогда
		Если ФП_по_ТБ Тогда		
			ОбновитьЗаливку();
			ПоказатьНедели();
		Иначе
			Политика_ВДерево(2);
		КонецЕсли;		
	КонецЕсли;
	
	ОбновитьФинПоказатели();
		
	ОбновитьИтогиПолитик();
	
	ОбновитьОтчетПоСотояниюФондов();
	ОбновитьНадписьТБ();
	УстановитьПараметрыСпискаВДПС();

КонецПроцедуры

&НаСервере
Процедура УстановитьПараметрыСпискаВДПС()
	ВнедоходныеПоступления.Параметры.УстановитьЗначениеПараметра("Организация", объект.Организация);
	ВнедоходныеПоступления.Параметры.УстановитьЗначениеПараметра("НеПоОрг", не ФППоОрганизациям);
	
	СтрНед = тзНедели.НайтиСтроки(Новый Структура("НачалоНедели", Объект.НеделяТБ));
	
	Если СтрНед.Количество() = 0 Тогда
		ВнедоходныеПоступления.Параметры.УстановитьЗначениеПараметра("ДатаНачалаТБ", ДатаПредыдущегоФП);
		ВнедоходныеПоступления.Параметры.УстановитьЗначениеПараметра("ДатаКонцаТБ", Объект.Дата-1);
	Иначе
		ВнедоходныеПоступления.Параметры.УстановитьЗначениеПараметра("ДатаНачалаТБ", СтрНед[0].НачалоНедели);
		ВнедоходныеПоступления.Параметры.УстановитьЗначениеПараметра("ДатаКонцаТБ", КонецДня(СтрНед[0].КонецНедели));
	КонецЕсли;
КонецПроцедуры
	
&НаСервере
Процедура ОбновитьНеделиДоходыЧистые()
	ДохДер = РеквизитФормыВЗначение("ДоходыЧистые");
	
	для сч = 1 по 12 цикл
		Элементы["ДоходыЧистыеГруппа"+сч].Видимость = ложь;
		Элементы["ИтогоВЗаливкуНеделя"+сч].Видимость = ложь;
		Элементы["ДоходыИтогоГруппа"+сч].Видимость = ложь;
		
		Если ЭтоВеб ТОгда
			Элементы["ДоходыЧистыеГруппа"+сч].ЦветфонаЗаголовка = новый цвет();
		КонецЕсли;
		для каждого стр из ДохДер.Строки Цикл
			стр["СуммаПлан"+сч] = 0;
			стр["СуммаФакт"+сч] = 0;
			для каждого стр1 из стр.Строки Цикл
				стр1["СуммаПлан"+сч] = 0;
				стр1["СуммаФакт"+сч] = 0;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	
	долги = новый ТаблицаЗначений;
	долги.Колонки.Добавить("Подразделение");
	долги.Колонки.Добавить("ВидДохода");
	долги.Колонки.Добавить("Сумма");
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	Запрос.УстановитьПараметр("ДатаДок", Объект.Дата+1);
	Запрос.УстановитьПараметр("Ссылка", Объект.Ссылка);
	Запрос.УстановитьПараметр("ТекМесяц", Объект.МесяцТБ);
	Запрос.УстановитьПараметр("ТекНеделя", Объект.НеделяТБ);
	Запрос.УстановитьПараметр("тзДох", Объект.Доходы.Выгрузить());
	Запрос.Текст = "ВЫБРАТЬ
	               |	&ТекНеделя КАК Неделя,
	               |	ТЗ_Доходы.Подразделение КАК Подразделение,
	               |	ТЗ_Доходы.ВидДохода КАК ВидДохода,
	               |	ТЗ_Доходы.СуммаБезнал КАК Сумма
	               |ПОМЕСТИТЬ ТЗ_Доходы
	               |ИЗ
	               |	&тзДох КАК ТЗ_Доходы
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	Подзапрос.ВидДохода КАК ВидДохода,
	               |	Подзапрос.Подразделение КАК Подразделение,
	               |	Подзапрос.Неделя КАК Неделя,
	               |	СУММА(Подзапрос.СуммаПлан) КАК СуммаПлан,
	               |	СУММА(Подзапрос.СуммаФакт) КАК СуммаФакт
	               |ИЗ
	               |	(ВЫБРАТЬ
	               |		Обороты.ВидДохода КАК ВидДохода,
	               |		Обороты.Подразделение КАК Подразделение,
	               |		Обороты.Неделя КАК Неделя,
	               |		Обороты.СуммаПриход КАК СуммаПлан,
	               |		Обороты.СуммаРасход КАК СуммаФакт
	               |	ИЗ
	               |		РегистрНакопления.КСУ_РаспределениеДоходовТБ.Обороты(
	               |				,
	               |				&ДатаДок,
	               |				Регистратор,
	               |				Организация = &Организация
	               |					ИЛИ &Организация = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)) КАК Обороты
	               |			ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ИА_РаспределениеНедель КАК ИА_РаспределениеНедель
	               |			ПО Обороты.Неделя = ИА_РаспределениеНедель.Период
	               |				И (ИА_РаспределениеНедель.Месяц = &ТекМесяц)
	               |	ГДЕ
	               |		Обороты.Регистратор <> &Ссылка
	               |	
	               |	ОБЪЕДИНИТЬ ВСЕ
	               |	
	               |	ВЫБРАТЬ
	               |		ТЗ_Доходы.ВидДохода,
	               |		ТЗ_Доходы.Подразделение,
	               |		ТЗ_Доходы.Неделя,
	               |		0,
	               |		ЕСТЬNULL(ТЗ_Доходы.Сумма, 0)
	               |	ИЗ
	               |		ТЗ_Доходы КАК ТЗ_Доходы) КАК Подзапрос
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	Подзапрос.ВидДохода,
	               |	Подзапрос.Подразделение,
	               |	Подзапрос.Неделя";
	Рез = Запрос.Выполнить().Выгрузить();
	Запрос.Текст = "ВЫБРАТЬ
	               |	ИА_РаспределениеНедель.Период КАК НачалоНедели,
	               |	ИА_РаспределениеНедель.КонецНедели КАК КонецНедели,
	               |	РАЗНОСТЬДАТ(ИА_РаспределениеНедель.Период, ИА_РаспределениеНедель.КонецНедели, ДЕНЬ) + 1 КАК КолДней
	               |ИЗ
	               |	РегистрСведений.ИА_РаспределениеНедель КАК ИА_РаспределениеНедель
	               |ГДЕ
	               |	ИА_РаспределениеНедель.Месяц = &ТекМесяц
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	НачалоНедели";
	тзНедель = Запрос.Выполнить().Выгрузить();
	
	КолНед = тзНедель.Количество();
	НомерКолонки = 1;
	ТекНедНомер = 0;
	Пока ТекНедНомер < КолНед Цикл
		неделя = тзНедель[ТекНедНомер];
		
		//// ДАННЫЕ
		СтрокиДох = Рез.НайтиСтроки(Новый Структура("Неделя",неделя.НачалоНедели));
		для каждого стрДох из СтрокиДох Цикл
			Если ИспДоходыПоПодразделениям ТОгда
				отбор = новый структура("ВидДохода", стрДох.Подразделение);
			Иначе
				отбор = новый структура("ВидДохода", стрДох.ВидДохода);
			КонецЕсли;
			Нстроки = ДохДер.Строки.НайтиСтроки(отбор);
			Если Нстроки.количество() = 0 ТОгда
				ТекСтрока = ДохДер.Строки.Добавить();
				Если ИспДоходыПоПодразделениям ТОгда
					ТекСтрока.ВидДохода = стрДох.Подразделение;
				Иначе
					ТекСтрока.ВидДохода = стрДох.ВидДохода;
				КонецЕсли;
			Иначе
				ТекСтрока = Нстроки[0];		
			КонецЕсли;
			
			Если ИспДоходыПоПодразделениям ТОгда
				отбор = новый структура("ВидДохода", стрДох.ВидДохода);
				Нстроки = ТекСтрока.Строки.НайтиСтроки(отбор);
				Если Нстроки.количество() = 0 ТОгда
					ТекСтрока = ТекСтрока.Строки.Добавить();		
					ТекСтрока.ВидДохода = стрДох.ВидДохода;
				Иначе
					ТекСтрока = Нстроки[0];		
				КонецЕсли;

			КонецЕсли;
						
			ТекСтрока["СуммаПлан"+НомерКолонки] = стрДох.СуммаПлан;
			ТекСтрока["СуммаФакт"+НомерКолонки] = стрДох.СуммаФакт;
		КонецЦикла;	
		
		//// КОЛОНКА
		ЭлКолонка = Элементы["ДоходыЧистыеГруппа"+НомерКолонки];
		ЭлКолонкаВЗаливку = Элементы["ИтогоВЗаливкуНеделя"+НомерКолонки];
		ЭлКолонкаДохИтого = Элементы["ДоходыИтогоГруппа"+НомерКолонки];
		ЭлКолонкаИтогоНеделя = Элементы["ДоходыИтогоНеделя"+НомерКолонки];
		ЭлКолонкаФакт = Элементы["ДоходыИтогоСуммаФакт"+НомерКолонки];
		
		ЭлКолонкаФакт.Формат = ?(неделя.НачалоНедели <= Объект.НеделяТБ, "ЧДЦ=2; ЧН=", "ЧДЦ=2; ЧН=-");
		
		ЭлКолонка.Видимость = истина;
		ЭлКолонка.Заголовок = Формат(неделя.НачалоНедели,"ДФ=dd.MM")+"-"+Формат(неделя.КонецНедели,"ДФ=dd.MM")+ " ( "+неделя.колДней+" дн )";
		
		ЭлКолонкаВЗаливку.Видимость = истина;
		ЭлКолонкаВЗаливку.Заголовок = Формат(неделя.НачалоНедели,"ДФ=dd.MM")+"-"+Формат(неделя.КонецНедели,"ДФ=dd.MM");
		
		ЭлКолонкаДохИтого.Видимость = истина;
		ЭлКолонкаДохИтого.Заголовок = ЭлКолонкаВЗаливку.Заголовок;
		
		Если Объект.НеделяТБ = неделя.НачалоНедели Тогда 
			ЭлКолонка.ШрифтЗаголовка = новый шрифт(ЭлКолонка.ШрифтЗаголовка,,,истина);
			ЭлКолонка.ЦветФонаЗаголовка = новый цвет(220,220,255);
			
			ЭлКолонкаВЗаливку.ШрифтЗаголовка = новый шрифт(ЭлКолонкаВЗаливку.ШрифтЗаголовка,,,истина);
			ЭлКолонкаВЗаливку.Шрифт = новый шрифт(ЭлКолонкаВЗаливку.Шрифт,,,истина);
			ЭлКолонкаВЗаливку.ЦветФонаЗаголовка = новый цвет(220,220,255);
			ЭлКолонкаВЗаливку.ЦветФона = новый цвет(240,240,255);
			
			ЭлКолонкаДохИтого.ШрифтЗаголовка = новый шрифт(ЭлКолонкаДохИтого.ШрифтЗаголовка,,,истина);
			ЭлКолонкаДохИтого.ЦветФонаЗаголовка = новый цвет(220,220,255);
			
			ЭлКолонкаИтогоНеделя.ШрифтПодвала = новый шрифт(ЭлКолонкаИтогоНеделя.ШрифтПодвала,,,истина);
			
			НомерТекущейНедели = ТекНедНомер + 1;
		Иначе
			ЭлКолонка.ШрифтЗаголовка = новый шрифт(ЭлКолонка.ШрифтЗаголовка,,,ложь);
			ЭлКолонка.ЦветФонаЗаголовка = новый цвет();
			
			ЭлКолонкаВЗаливку.ШрифтЗаголовка = новый шрифт(ЭлКолонкаВЗаливку.ШрифтЗаголовка,,,ложь);
			ЭлКолонкаВЗаливку.Шрифт = новый шрифт(ЭлКолонкаВЗаливку.Шрифт,,,ложь);
			ЭлКолонкаВЗаливку.ЦветФонаЗаголовка = новый цвет();
			ЭлКолонкаВЗаливку.ЦветФона = новый цвет();
			
			ЭлКолонкаДохИтого.ШрифтЗаголовка = новый шрифт(ЭлКолонкаДохИтого.ШрифтЗаголовка,,,ложь);
			ЭлКолонкаДохИтого.ЦветФонаЗаголовка = новый цвет();
			
			ЭлКолонкаИтогоНеделя.ШрифтПодвала = новый шрифт(ЭлКолонкаИтогоНеделя.ШрифтПодвала,,,ложь);
		КонецЕсли;
		
		
		для каждого подчЭл из Элементы["ДоходыЧистыеГруппа"+НомерКолонки].ПодчиненныеЭлементы Цикл
			Если Объект.НеделяТБ = неделя.НачалоНедели Тогда
				Если найти(подчЭл.Имя, "ДоходыИтогоСуммаФакт")>0 Тогда
					подчЭл.Шрифт = новый шрифт(подчЭл.Шрифт,,,истина);
					подчЭл.ШрифтЗаголовка = новый шрифт(подчЭл.ШрифтЗаголовка,,,истина);
				КонецЕсли;
				подчЭл.ЦветФона = новый цвет(240,240,255);
				
				подчЭл.ЦветФонаЗаголовка = новый цвет(220,220,255);
			Иначе
				подчЭл.Шрифт = новый шрифт(подчЭл.Шрифт,,,ложь);
				подчЭл.ШрифтЗаголовка = новый шрифт(подчЭл.ШрифтЗаголовка,,,ложь);
				подчЭл.ЦветФона = новый Цвет();
				
				подчЭл.ЦветФонаЗаголовка = новый цвет();
			КонецЕсли;
		КонецЦикла;
		
		для каждого подчЭл из ЭлКолонкаДохИтого.ПодчиненныеЭлементы Цикл
			Если Объект.НеделяТБ = неделя.НачалоНедели Тогда
				подчЭл.ЦветФона = новый цвет(240,240,255);
				подчЭл.ЦветФонаЗаголовка = новый цвет(220,220,255);
			Иначе
				подчЭл.ЦветФона = новый Цвет();
				подчЭл.ЦветФонаЗаголовка = новый цвет();
			КонецЕсли;
		КонецЦикла;
		
		//// /КОЛОНКА
		
		ТекНедНомер = ТекНедНомер + 1;
		НомерКолонки = НомерКолонки + 1;
	КонецЦикла;
	
	/// Пересчет долгов
	счН = 0;
	ВсегоРеалНед = тзНедель.Количество();
	Пока счН < ВсегоРеалНед Цикл
		НомерКолонки = счН + 1;
		ОсталосьНедель = ВсегоРеалНед - (счН + 1);
		
		Если ИспДоходыПоПодразделениям Тогда
			для каждого СтрПодр из ДохДер.Строки Цикл
				для каждого стрДоход из СтрПодр.Строки Цикл
					ПересчетСтрокиДоходыИтого(стрДоход, долги, НомерКолонки, ОсталосьНедель, тзНедель, счН);	
				КонецЦикла;	
			КонецЦикла;
		Иначе
			для каждого стрДоход из ДохДер.Строки Цикл
				ПересчетСтрокиДоходыИтого(стрДоход, долги, НомерКолонки, ОсталосьНедель, тзНедель, счН);	
			КонецЦикла;
		КонецЕсли;
		счН = счН + 1;
	КонецЦикла;
	
	/// Итоги по неделям
	для сч = 1 по тзНедель.Количество() цикл	// было до 12
		неделя = тзНедель[сч-1];
		
		Если ИспДоходыПоПодразделениям Тогда
			Для каждого СтрПодр из ДохДер.Строки Цикл
				сумПлИтого = СтрПодр.Строки.Итог("СуммаПлан"+сч);
				сумФкИтого = СтрПодр.Строки.Итог("СуммаФакт"+сч);
				СтрПодр["СуммаПлан"+сч] = сумПлИтого;
				СтрПодр["СуммаФакт"+сч] = сумФкИтого;
				процИтого = 0;
				Если сумПлИтого> 0 ТОгда
					процИтого = сумФкИтого * 100 / сумПлИтого;
				КонецЕсли;
				СтрПодр["Процент"+сч] = формат(процИтого,"ЧДЦ=2; ЧН=");
			КонецЦикла;
		КонецЕсли;
		
		сумПлИтого = ДохДер.Строки.Итог("СуммаПлан"+сч, ложь);
		сумФкИтого = ДохДер.Строки.Итог("СуммаФакт"+сч, ложь);
		
		Если неделя.НачалоНедели > объект.НеделяТБ Тогда
			Элементы["ДоходыИтогоСуммаФакт"+сч].ТекстПодвала = "-";
		ИНаче
			Элементы["ДоходыИтогоСуммаФакт"+сч].ТекстПодвала = формат(сумФкИтого,"ЧДЦ=2; ЧН=");
		КонецЕсли;
		процИтого = 0;
		Если сумПлИтого> 0 ТОгда
			Элементы["ДоходыИтогоСуммаПлан"+сч].ТекстПодвала = формат(сумПлИтого,"ЧДЦ=2; ЧН=");
			процИтого = сумФкИтого * 100 / сумПлИтого;
		Иначе
			Элементы["ДоходыИтогоСуммаПлан"+сч].ТекстПодвала = "0,00";
		КонецЕсли;
		
		Если неделя.НачалоНедели > объект.НеделяТБ Тогда
			Элементы["ДоходыИтогоПроцент"+сч].ТекстПодвала = "";
		Иначе
			Элементы["ДоходыИтогоПроцент"+сч].ТекстПодвала = формат(процИтого,"ЧДЦ=2; ЧН=");
			Если процИтого < 100 Тогда
				Элементы["ДоходыИтогоПроцент"+сч].ЦветТекстаПодвала = Новый цвет(255,0,0);
			Иначе
				Элементы["ДоходыИтогоПроцент"+сч].ЦветТекстаПодвала = Новый цвет(60, 167, 94);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	// проценты, итоги по подр-ям
	Рез.Свернуть("Подразделение,ВидДохода","СуммаПлан,СуммаФакт");
	Если ИспДоходыПоПодразделениям Тогда
		Для каждого стрПодр из ДохДер.Строки Цикл
			ПересчетПроцентаСтрокиДохода(Рез, стрПодр.Строки, ВсегоРеалНед, тзНедель);
			стрПодр.Сумма = стрПодр.Строки.Итог("Сумма");
		КонецЦикла;
	Иначе
		ПересчетПроцентаСтрокиДохода(Рез, ДохДер.Строки, ВсегоРеалНед, тзНедель);
	КонецЕсли;
	
	итПлан = Рез.Итог("СуммаПлан");
	Если итПлан>0 Тогда
		итФакт = Рез.Итог("СуммаФакт");
		итОтклонение = итФакт - итПлан;
		
		Элементы.ДоходыИтогоПроцентВыполнения.ТекстПодвала = формат(итФакт*100/итПлан,"ЧДЦ=2; ЧН=");	
		Элементы.ДоходыЧистыеСуммаПлан.ТекстПодвала = формат(итПлан,"ЧДЦ=2; ЧН=");
		Элементы.ДоходыЧистыеСуммаФакт.ТекстПодвала = формат(итФакт,"ЧДЦ=2; ЧН=");
		Элементы.ДоходыЧистыеСуммаОтклонение.ТекстПодвала = формат(итОтклонение,"ЧДЦ=2; ЧН=");
	
	КонецЕсли;
	
	Если НомерТекущейНедели > 0 Тогда
		объект.ПланЧистогоДоходаТекНедели = ДохДер.Строки.Итог("СуммаПлан"+НомерТекущейНедели);
	КонецЕсли;
	
	ЗначениеВРеквизитФормы(ДохДер,"ДоходыЧистые");
	ЗначениеВРеквизитФормы(тзНедель, "тзНедели");
КонецПроцедуры

&НаСервере
Процедура ПересчетПроцентаСтрокиДохода(Рез, строки, ВсегоРеалНед, тзНедель)
		
	ИтогоПлан = 0;
	ИтогоФакт = 0;
	Для каждого стр из Строки Цикл
		стр.СуммаПлан = 0;
		стр.СуммаФакт = 0;
		стр.СуммаОтклонение = 0;
		
		Если ИспДоходыПоПодразделениям Тогда
			нСтроки = Рез.НайтиСтроки(новый Структура("Подразделение,ВидДохода", стр.Родитель.ВидДохода, стр.ВидДохода));
		Иначе
			нСтроки = Рез.НайтиСтроки(новый Структура("ВидДохода", стр.ВидДохода));
		КонецЕсли;
			
		Если нСтроки.Количество()>0 Тогда
			СтрокаПланФакт = нСтроки[0];
			
			стр.СуммаПлан = СтрокаПланФакт.СуммаПлан;
			стр.СуммаФакт = СтрокаПланФакт.СуммаФакт;
			стр.СуммаОтклонение = стр.СуммаФакт - стр.СуммаПлан;
			Если нСтроки[0].суммаПлан > 0 Тогда
				стр.ПроцентВыполнения = СтрокаПланФакт.СуммаФакт*100/СтрокаПланФакт.СуммаПлан;
			КонецЕсли;
			ИтогоПлан = ИтогоПлан + СтрокаПланФакт.СуммаПлан;
			ИтогоФакт = ИтогоФакт + СтрокаПланФакт.СуммаФакт;
		Иначе
			стр.ПроцентВыполнения = "--";
		КонецЕсли;
		
		// Округление
		ИтогоПланПоСтроке = 0;
		Для счН = 1 по ВсегоРеалНед Цикл
			Если тзНедель[счН - 1].НачалоНедели <= объект.НеделяТБ Тогда
				Если счН = ВсегоРеалНед ТОгда // последняя - текущая
					ИтогоПланПоСтроке = ИтогоПланПоСтроке + стр["СуммаПлан" + счН];	
				Иначе
					ИтогоПланПоСтроке = ИтогоПланПоСтроке + стр["СуммаФакт" + счН];
				КонецЕсли;
			Иначе
				ИтогоПланПоСтроке = ИтогоПланПоСтроке + стр["СуммаПлан" + счН];	
			КонецЕсли;			
		КонецЦикла;
		Дельта = ИтогоПланПоСтроке - стр.СуммаПлан;
		Если ВсегоРеалНед > 0 Тогда
			стр["СуммаПлан" + ВсегоРеалНед] = стр["СуммаПлан" + ВсегоРеалНед] -  Дельта;
			ИтогоПлан = ИтогоПлан -  Дельта;
		КонецЕсли;
	КонецЦикла;

	Если ИтогоПлан >0 и ИспДоходыПоПодразделениям Тогда
		строки.родитель.ПроцентВыполнения = ИтогоФакт*100/ИтогоПлан;
		строки.родитель.СуммаПлан = ИтогоПлан;
		строки.родитель.СуммаФакт = ИтогоФакт;
		строки.родитель.СуммаОтклонение = ИтогоФакт - ИтогоПлан;
	КонецЕсли;
КонецПроцедуры
	
&НаСервере
Процедура ПересчетСтрокиДоходыИтого(стрДоход, долги, НомерКолонки, ОсталосьНедель, тзНедель, счН)
	Если ИспДоходыПоПодразделениям Тогда
		нСтрокиДолг = долги.НайтиСтроки(новый Структура("Подразделение,ВидДохода", стрДоход.Родитель.ВидДохода, стрДоход.ВидДохода));
	ИНаче
		нСтрокиДолг = долги.НайтиСтроки(новый Структура("ВидДохода", стрДоход.ВидДохода));
	КонецЕсли;
	долг =0 ;
	Если нСтрокиДолг.Количество()>0 Тогда
		СтрокаДолг = нСтрокиДолг[0];
		долг = СтрокаДолг.сумма;
	Иначе
		СтрокаДолг = долги.Добавить();
		СтрокаДолг.ВидДохода = стрДоход.ВидДохода;
		Если ИспДоходыПоПодразделениям Тогда
			СтрокаДолг.Подразделение = стрДоход.Родитель.ВидДохода;
		КонецЕсли;
		СтрокаДолг.Сумма = 0;
	КонецЕсли;
		
	КолДней = (тзНедель[счН].КонецНедели - тзНедель[счН].НачалоНедели) / (60*60*24) + 1;
	стрДоход["СуммаПлан"+НомерКолонки] = стрДоход["СуммаПлан"+НомерКолонки] + долг*КолДней;
	
	Если ОсталосьНедель > 0 и тзНедель[счН].НачалоНедели<=Объект.НеделяТБ Тогда
		КолНед = тзНедель.Количество();
		Коэф = (тзНедель[КолНед-1].КонецНедели - тзНедель[КолНед - ОсталосьНедель].НачалоНедели) / (60*60*24) + 1;
		СтрокаДолг.сумма = СтрокаДолг.сумма + (стрДоход["СуммаПлан"+НомерКолонки] - стрДоход["СуммаФакт"+НомерКолонки])/Коэф;
	КонецЕсли;
	
	Если стрДоход["СуммаПлан"+НомерКолонки]>0 Тогда
		стрДоход["Процент"+НомерКолонки] =стрДоход["СуммаФакт"+НомерКолонки] * 100 /стрДоход["СуммаПлан"+НомерКолонки];
	Иначе
		Если стрДоход["СуммаФакт"+НомерКолонки] > 0 Тогда
			стрДоход["Процент"+НомерКолонки] = -1;
		Иначе
			стрДоход["Процент"+НомерКолонки] = 0;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаСервереБезКонтекста
Процедура СоздатьСтрокиПолитик(СтрокиДерева, ИспПодразделения)
	// Переменные расходы
	п1Строка = СтрокиДерева.добавить();
	Если ИспПодразделения Тогда
		п1Строка.Подразделение = "ПЕРЕМЕННЫЕ РАСХОДЫ";
	Иначе
		п1Строка.Фонд = "ПЕРЕМЕННЫЕ РАСХОДЫ";
	КонецЕсли;
	п1Строка.ТипСтроки = Перечисления.КСУ_ВидыСтрокТБ.ПеременныеРасходы;
	п1Строка.ЭтоЗаголовок = Истина;
	
	// Маржа
	мСтрока = СтрокиДерева.добавить();
	Если ИспПодразделения Тогда
		мСтрока.Подразделение = "МАРЖИНАЛЬНАЯ ПРИБЫЛЬ";
	Иначе
		мСтрока.Фонд = "МАРЖИНАЛЬНАЯ ПРИБЫЛЬ";
	КонецЕсли;
	мСтрока.ТипСтроки = Перечисления.КСУ_ВидыСтрокТБ.МаржинальнаяПрибыль;
	мСтрока.ЭтоЗаголовок = Истина;
	
	// учредительские фонды
	УФСтрока = СтрокиДерева.добавить();
	Если ИспПодразделения Тогда
		УФСтрока.Подразделение = "ФОНДЫ ИЗ МАРЖИ";
	Иначе
		УФСтрока.Фонд = "ФОНДЫ ИЗ МАРЖИ";
	КонецЕсли;
	УФСтрока.ТипСтроки = Перечисления.КСУ_ВидыСтрокТБ.УчредительскиеФонды;
	УФСтрока.ЭтоЗаголовок = Истина;
	
	// Итого на заливку
	иСтрока = СтрокиДерева.добавить();
	Если ИспПодразделения Тогда
		иСтрока.Подразделение = "ИТОГО К РАСПРЕДЕЛЕНИЮ";
	Иначе
		иСтрока.Фонд = "ИТОГО К РАСПРЕДЕЛЕНИЮ";
	КонецЕсли;
	иСтрока.ТипСтроки = Перечисления.КСУ_ВидыСтрокТБ.ИтогКЗаливке;
	иСтрока.ЭтоЗаголовок = Истина;
		
	// ПОстоянные расходы
	ЗалСтрока = СтрокиДерева.добавить();
	Если ИспПодразделения Тогда
		ЗалСтрока.Подразделение = "ПОСТОЯННЫЕ РАСХОДЫ";
	Иначе
		ЗалСтрока.Фонд = "ПОСТОЯННЫЕ РАСХОДЫ";
	КонецЕсли;
	ЗалСтрока.ТипСтроки = Перечисления.КСУ_ВидыСтрокТБ.ПостоянныеРасходы;
	ЗалСтрока.ЭтоЗаголовок = Истина;
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьСтрокуПоТипуСтроки(Дерево, ТипСтроки)
	Для каждого стр из Дерево.Строки Цикл
		Если стр.ТипСтроки = ТипСтроки Тогда
			возврат стр;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Неопределено;
КонецФункции

&НаСервере
Процедура ОбновитьЗаливку()
	
	ДеревоРасходы = РеквизитФормыВЗначение("ЗаливкаИтого");
	ДеревоРасходы.строки.Очистить();
	
	// убираем видимость колонок
	для сч = 1 по 14 цикл
		ВидимостьКолонок[сч - 1].Видимость = ложь;
		ВидимостьКолонок[сч - 1].ТекущаяНеделя = ложь;
	КонецЦикла;
	
	// получаем праметры недели: ТекМесяц, ТекНеделя, ЭтоПоследняяНеделя, КолНедельДоКонца, ДатаФП, ПоследняяНеделя, ДатаДокФП
	ТекПарам = ИА_ФПСервер.ПолучитьПараметрыТекРаспределения(Объект.Организация, Объект.Дата);
	Если ТекПарам = Неопределено Тогда 
		Возврат; 
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = новый МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("ДокСсылка", Объект.Ссылка);	
	Запрос.УстановитьПараметр("Организация", Объект.Организация);	
	Запрос.УстановитьПараметр("ДатаФП", ТекПарам.ДатаФП); // дата со сдвигом по константе - начало или конец дня
	Запрос.УстановитьПараметр("ДатаДокФП", ТекПарам.ДатаДокФП); // дата документа
	Запрос.УстановитьПараметр("КолНедельДоКонца", ТекПарам.КолНедельДоКонца);	
	Запрос.УстановитьПараметр("ТекМесяц", ТекПарам.ТекМесяц);	
	Запрос.УстановитьПараметр("ТекНеделя", ТекПарам.ТекНеделя);		
	Запрос.УстановитьПараметр("ИспПодр", ИспПодразделения);		
	ЗаливкаФондовТЗ = Объект.ЗаливкаФондов.Выгрузить();
	//
	если ЗаливкаФондовТЗ.Количество() = 0 Тогда
		Новстр = ЗаливкаФондовТЗ.Добавить();
		Новстр.неделя = ТекПарам.ТекНеделя;
	КонецЕсли;
	//
	Запрос.УстановитьПараметр("тз", ЗаливкаФондовТЗ);
	
	тзП1 = Объект.Политика1.Выгрузить();
	тзП1.Свернуть("Подразделение,Статья","Сумма");
	Запрос.УстановитьПараметр("тзПолитика1", тзП1);
	Запрос.УстановитьПараметр("тзУчредФонды", Объект.УчредительскиеФонды.Выгрузить());
	//////////////////////////////////////////////////////////////////////////
	
	// Таблица недель
	//Запрос.Текст = "ВЫБРАТЬ
	//               |	ИА_РаспределениеНедель.Период КАК НачалоНедели,
	//               |	ИА_РаспределениеНедель.КонецНедели
	//               |ИЗ
	//               |	РегистрСведений.ИА_РаспределениеНедель КАК ИА_РаспределениеНедель
	//               |ГДЕ
	//               |	ИА_РаспределениеНедель.Месяц = &ТекМесяц
	//               |
	//               |УПОРЯДОЧИТЬ ПО
	//               |	НачалоНедели";
	//тзНедель = Запрос.Выполнить().Выгрузить();
	тзНедель = РеквизитФормыВЗначение("тзНедели");

	
	// временные таблицы с заливкой текущего документ	
	Запрос.Текст = "ВЫБРАТЬ
	               |	тз.Неделя КАК Неделя,
	               |	тз.Подразделение КАК Подразделение,
	               |	тз.Фонд КАК Фонд,
	               |	тз.Сумма КАК Сумма
	               |ПОМЕСТИТЬ ТЗ_Заливка
	               |ИЗ
	               |	&тз КАК тз
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	&ТекНеделя КАК Неделя,
	               |	тзПолитика1.Подразделение КАК Подразделение,
	               |	тзПолитика1.Статья КАК Фонд,
	               |	тзПолитика1.Сумма КАК Сумма
	               |ПОМЕСТИТЬ ТЗ_Политика1
	               |ИЗ
	               |	&тзПолитика1 КАК тзПолитика1
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	&ТекНеделя КАК Неделя,
	               |	тзУчредФонды.Подразделение КАК Подразделение,
	               |	тзУчредФонды.Фонд КАК Фонд,
	               |	тзУчредФонды.Сумма КАК Сумма
	               |ПОМЕСТИТЬ ТЗ_УчредФонды
	               |ИЗ
	               |	&тзУчредФонды КАК тзУчредФонды";	
	Запрос.Выполнить();
	
	// Расчет Политики1 (переменные расходы)
	Запрос.Текст = "ВЫБРАТЬ
	               |	Подзапрос.Подразделение КАК Подразделение,
	               |	Подзапрос.Фонд КАК Фонд,
	               |	Подзапрос.Неделя КАК Неделя,
	               |	Подзапрос.СуммаПлан КАК СуммаПлан,
	               |	Подзапрос.СуммаФакт + ЕСТЬNULL(ТЗ_Политика1.Сумма, 0) КАК СуммаФакт
	               |ИЗ
	               |	(ВЫБРАТЬ
	               |		Обороты.Подразделение КАК Подразделение,
	               |		Обороты.Фонд КАК Фонд,
	               |		Обороты.Неделя КАК Неделя,
	               |		СУММА(Обороты.СуммаПриход) КАК СуммаПлан,
	               |		СУММА(ВЫБОР
	               |				КОГДА Обороты.Неделя > &ТекНеделя
	               |						ИЛИ Обороты.Период > &ДатаДокФП
	               |					ТОГДА 0
	               |				ИНАЧЕ ЕСТЬNULL(Обороты.СуммаРасход, 0)
	               |			КОНЕЦ) КАК СуммаФакт
	               |	ИЗ
	               |		РегистрНакопления.КСУ_ЗаливкаПолитики1.Обороты(
	               |				,
	               |				,
	               |				Регистратор,
	               |				Организация = &Организация
	               |					ИЛИ &Организация = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)) КАК Обороты
	               |			ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ИА_РаспределениеНедель КАК ИА_РаспределениеНедель
	               |			ПО Обороты.Неделя = ИА_РаспределениеНедель.Период
	               |				И (ИА_РаспределениеНедель.Месяц = &ТекМесяц)
	               |	ГДЕ
	               |		Обороты.Регистратор <> &ДокСсылка
	               |	
	               |	СГРУППИРОВАТЬ ПО
	               |		Обороты.Подразделение,
	               |		Обороты.Фонд,
	               |		Обороты.Неделя) КАК Подзапрос
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ТЗ_Политика1 КАК ТЗ_Политика1
	               |		ПО Подзапрос.Подразделение = ТЗ_Политика1.Подразделение
	               |			И Подзапрос.Фонд = ТЗ_Политика1.Фонд
	               |			И Подзапрос.Неделя = ТЗ_Политика1.Неделя
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КСУ_ПорядокРаспределенияПоФондам.СрезПоследних(
	               |				&ДатаДокФП,
	               |				НомерПолитики = 1
	               |					И (Организация = &Организация
	               |						ИЛИ &Организация = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка))) КАК ПорядокФондов
	               |		ПО Подзапрос.Подразделение = ПорядокФондов.Подразделение
	               |			И Подзапрос.Фонд = ПорядокФондов.Фонд
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ПорядокФондов.Порядок";
	тзРезП1 = Запрос.Выполнить().Выгрузить();
	
	// Расчет учредительских фондоы
	Запрос.Текст = "ВЫБРАТЬ
	               |	Подзапрос.Подразделение КАК Подразделение,
	               |	Подзапрос.Фонд КАК Фонд,
	               |	Подзапрос.Неделя КАК Неделя,
	               |	Подзапрос.СуммаПлан КАК СуммаПлан,
	               |	Подзапрос.СуммаФакт + ЕСТЬNULL(ТЗ_УчредФонды.Сумма, 0) КАК СуммаФакт
	               |ИЗ
	               |	(ВЫБРАТЬ
	               |		ВЫБОР
	               |			КОГДА &ИспПодр
	               |				ТОГДА Обороты.Подразделение
	               |			ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ИА_ЦФО.ПустаяСсылка)
	               |		КОНЕЦ КАК Подразделение,
	               |		Обороты.Фонд КАК Фонд,
	               |		Обороты.Неделя КАК Неделя,
	               |		СУММА(Обороты.СуммаПриход) КАК СуммаПлан,
	               |		СУММА(ВЫБОР
	               |				КОГДА Обороты.Неделя > &ТекНеделя
	               |						ИЛИ Обороты.Период > &ДатаДокФП
	               |					ТОГДА 0
	               |				ИНАЧЕ ЕСТЬNULL(Обороты.СуммаРасход, 0)
	               |			КОНЕЦ) КАК СуммаФакт
	               |	ИЗ
	               |		РегистрНакопления.КСУ_УчредительскиеФонды.Обороты(
	               |				,
	               |				,
	               |				Регистратор,
	               |				Организация = &Организация
	               |					ИЛИ &Организация = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)) КАК Обороты
	               |			ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ИА_РаспределениеНедель КАК ИА_РаспределениеНедель
	               |			ПО Обороты.Неделя = ИА_РаспределениеНедель.Период
	               |				И (ИА_РаспределениеНедель.Месяц = &ТекМесяц)
	               |	ГДЕ
	               |		Обороты.Регистратор <> &ДокСсылка
	               |	
	               |	СГРУППИРОВАТЬ ПО
	               |		Обороты.Подразделение,
	               |		Обороты.Фонд,
	               |		Обороты.Неделя) КАК Подзапрос
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ТЗ_УчредФонды КАК ТЗ_УчредФонды
	               |		ПО Подзапрос.Подразделение = ТЗ_УчредФонды.Подразделение
	               |			И Подзапрос.Фонд = ТЗ_УчредФонды.Фонд
	               |			И Подзапрос.Неделя = ТЗ_УчредФонды.Неделя
	               |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	               |			ВЫБОР
	               |				КОГДА &ИспПодр
	               |					ТОГДА КСУ_ПорядокРаспределенияПоФондамСрезПоследних.Подразделение
	               |				ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ИА_ЦФО.ПустаяСсылка)
	               |			КОНЕЦ КАК Подразделение,
	               |			КСУ_ПорядокРаспределенияПоФондамСрезПоследних.Фонд КАК Фонд,
	               |			МИНИМУМ(КСУ_ПорядокРаспределенияПоФондамСрезПоследних.Порядок) КАК Порядок
	               |		ИЗ
	               |			РегистрСведений.КСУ_ПорядокРаспределенияПоФондам.СрезПоследних(
	               |					&ДатаДокФП,
	               |					Организация = &Организация
	               |						ИЛИ &Организация = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)) КАК КСУ_ПорядокРаспределенияПоФондамСрезПоследних
	               |		
	               |		СГРУППИРОВАТЬ ПО
	               |			КСУ_ПорядокРаспределенияПоФондамСрезПоследних.Подразделение,
	               |			КСУ_ПорядокРаспределенияПоФондамСрезПоследних.Фонд) КАК ПорядокФондов
	               |		ПО Подзапрос.Подразделение = ПорядокФондов.Подразделение
	               |			И Подзапрос.Фонд = ПорядокФондов.Фонд
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ПорядокФондов.Порядок";
	тзРезУчредФонды = Запрос.Выполнить().Выгрузить();
	
	// Расчет заливки
	Запрос.Текст = "ВЫБРАТЬ
	               |	Подзапрос.Неделя КАК Неделя,
	               |	Подзапрос.Подразделение КАК Подразделение,
	               |	Подзапрос.Фонд КАК Фонд,
	               |	СУММА(Подзапрос.Сумма) КАК Сумма
	               |ПОМЕСТИТЬ ЗаливкаФакт
	               |ИЗ
	               |	(ВЫБРАТЬ
	               |		КСУ_РаспределениеТБ.Неделя КАК Неделя,
	               |		КСУ_РаспределениеТБ.Подразделение КАК Подразделение,
	               |		КСУ_РаспределениеТБ.Фонд КАК Фонд,
	               |		КСУ_РаспределениеТБ.Сумма КАК Сумма
	               |	ИЗ
	               |		РегистрНакопления.КСУ_РаспределениеТБ КАК КСУ_РаспределениеТБ
	               |			ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ИА_РаспределениеНедель КАК ИА_РаспределениеНедель
	               |			ПО КСУ_РаспределениеТБ.Неделя = ИА_РаспределениеНедель.Период
	               |				И (ИА_РаспределениеНедель.Месяц = &ТекМесяц)
	               |	ГДЕ
	               |		КСУ_РаспределениеТБ.ВидДвижения = ЗНАЧЕНИЕ(виддвижениянакопления.расход)
	               |		И КСУ_РаспределениеТБ.Период < &ДатаДокФП
	               |		И (КСУ_РаспределениеТБ.Организация = &Организация
	               |				ИЛИ &Организация = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка))
	               |	
	               |	ОБЪЕДИНИТЬ ВСЕ
	               |	
	               |	ВЫБРАТЬ
	               |		ТЗ_Заливка.Неделя,
	               |		ТЗ_Заливка.Подразделение,
	               |		ТЗ_Заливка.Фонд,
	               |		ТЗ_Заливка.Сумма
	               |	ИЗ
	               |		ТЗ_Заливка КАК ТЗ_Заливка) КАК Подзапрос
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	Подзапрос.Неделя,
	               |	Подзапрос.Подразделение,
	               |	Подзапрос.Фонд
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	КСУ_РаспределениеТБ.Неделя КАК Неделя,
	               |	КСУ_РаспределениеТБ.Подразделение КАК Подразделение,
	               |	КСУ_РаспределениеТБ.Фонд КАК Фонд,
	               |	МАКСИМУМ(КСУ_РаспределениеТБ.СуммаПриход) КАК Сумма
	               |ПОМЕСТИТЬ ЗаливкаПлан
	               |ИЗ
	               |	РегистрНакопления.КСУ_РаспределениеТБ.Обороты(
	               |			,
	               |			,
	               |			,
	               |			Организация = &Организация
	               |				ИЛИ &Организация = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)) КАК КСУ_РаспределениеТБ
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ИА_РаспределениеНедель КАК ИА_РаспределениеНедель
	               |		ПО КСУ_РаспределениеТБ.Неделя = ИА_РаспределениеНедель.Период
	               |			И (ИА_РаспределениеНедель.Месяц = &ТекМесяц)
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	КСУ_РаспределениеТБ.Неделя,
	               |	КСУ_РаспределениеТБ.Подразделение,
	               |	КСУ_РаспределениеТБ.Фонд
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	План.Неделя КАК Неделя,
	               |	План.Подразделение КАК Подразделение,
	               |	План.Фонд КАК Фонд,
	               |	План.Сумма КАК СуммаПлан,
	               |	ЕСТЬNULL(Заливка.Сумма, 0) КАК СуммаЗаливка
	               |ИЗ
	               |	ЗаливкаПлан КАК План
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ЗаливкаФакт КАК Заливка
	               |		ПО План.Неделя = Заливка.Неделя
	               |			И План.Подразделение = Заливка.Подразделение
	               |			И План.Фонд = Заливка.Фонд
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КСУ_ПорядокРаспределенияПоФондам.СрезПоследних(
	               |				&ДатаДокФП,
	               |				НомерПолитики = 2
	               |					И (Организация = &Организация
	               |						ИЛИ &Организация = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка))) КАК ПорядокФондов
	               |		ПО План.Подразделение = ПорядокФондов.Подразделение
	               |			И План.Фонд = ПорядокФондов.Фонд
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Неделя,
	               |	ПорядокФондов.Порядок";
	Заливка = запрос.Выполнить().Выгрузить();
		
	долги = новый ТаблицаЗначений;
	долги.Колонки.Добавить("Подразделение");
	долги.Колонки.Добавить("Фонд");
	долги.Колонки.Добавить("Сумма");
	
	Переливка = новый ТаблицаЗначений;
	Переливка.Колонки.Добавить("Неделя");
	Переливка.Колонки.Добавить("Подразделение");
	Переливка.Колонки.Добавить("Фонд");
	Переливка.Колонки.Добавить("Сумма");

	// добавим строки политик
	Если ИспДоходыПоПодразделениям Тогда
		тзПодр = Заливка.Скопировать();
		тзПодр.Свернуть("Подразделение");
		Для каждого стрПодр из тзПодр Цикл
			НовстрПодр = ДеревоРасходы.строки.добавить(); 
			НовстрПодр.Подразделение = стрПодр.Подразделение;
			
			СоздатьСтрокиПолитик(НовстрПодр.строки, ИспПодразделения);
		КонецЦикла;
	Иначе
		СоздатьСтрокиПолитик(ДеревоРасходы.строки, ИспПодразделения);
	КонецЕсли;
	//
	
	КолНед = тзНедель.Количество();
	ТекНедНомер = 0;
	НомерКолонки = 1;
	Пока ТекНедНомер < КолНед Цикл
		неделя = тзНедель[ТекНедНомер];
		ТекНеделя = неделя.НачалоНедели;
		
		/// КОЛОНКА
		ВидимостьКолонок[НомерКолонки - 1].Видимость = истина;
		ЭлКолонка = Элементы["ЗаливкаФондовИтогоГруппа"+НомерКолонки];
		ЭлКолонка.Заголовок = Формат(неделя.НачалоНедели,"ДФ=dd.MM")+"-"+Формат(неделя.КонецНедели,"ДФ=dd.MM");
		
		ЭлКолонкаФакт = Элементы["ЗаливкаФондов_ИтогоСуммаФакт"+НомерКолонки];		
		ЭлКолонкаФакт.Формат = ?(неделя.НачалоНедели <= ТекПарам.ТекНеделя, "ЧДЦ=2; ЧН=", "ЧДЦ=2; ЧН=-");
		
		Если ТекПарам.ТекНеделя = неделя.НачалоНедели Тогда
			НомерТекущейНедели = НомерКолонки;
			ЭлКолонка.ШрифтЗаголовка = новый шрифт(ЭлКолонка.ШрифтЗаголовка,,,истина);
		Иначе
			ЭлКолонка.ШрифтЗаголовка = новый шрифт(ЭлКолонка.ШрифтЗаголовка,,,ложь);
		КонецЕсли;
		
		для каждого подчЭл из ЭлКолонка.ПодчиненныеЭлементы Цикл
			Если ТекПарам.ТекНеделя = неделя.НачалоНедели Тогда
				Если найти(подчЭл.Имя, "ЗаливкаФондов_ИтогоСуммаФакт")>0 Тогда
					//подчЭл.Шрифт = новый шрифт(подчЭл.Шрифт,,,истина);
					//подчЭл.ШрифтЗаголовка = новый шрифт(подчЭл.ШрифтЗаголовка,,,истина);
				КонецЕсли;
				подчЭл.ЦветФона = новый цвет(240,240,255);
				подчЭл.ЦветФонаЗаголовка = новый цвет(220,220,255);
				ЭлКолонка.ЦветФонаЗаголовка = новый цвет(220,220,255);
				//
				ВидимостьКолонок[НомерКолонки - 1].ТекущаяНеделя = истина;
			Иначе
				подчЭл.Шрифт = новый шрифт(подчЭл.Шрифт,,,ложь);
				подчЭл.ШрифтЗаголовка = новый шрифт(подчЭл.ШрифтЗаголовка,,,ложь);
				подчЭл.ЦветФона = новый Цвет();
				подчЭл.ЦветФонаЗаголовка = новый Цвет();
				ЭлКолонка.ЦветФонаЗаголовка = новый Цвет();
			КонецЕсли;
		КонецЦикла;

		
		///////
		/// Политика 1
		///////
		СтрокиП1 = тзРезП1.НайтиСтроки(Новый Структура("Неделя",неделя.НачалоНедели));
		для каждого стрП1 из СтрокиП1 Цикл
			ТекСтрока = Неопределено;
			
			// найдем строку с фондом или добавим ее
			Если ИспДоходыПоПодразделениям ТОгда
				стрПодр = ДеревоРасходы.Строки.Найти(стрП1.Подразделение);
				Если стрПодр <> Неопределено И стрПодр.Строки.Количество() > 0 Тогда
					СтрДерП1 = ПолучитьСтрокуПоТипуСтроки(стрПодр, Перечисления.КСУ_ВидыСтрокТБ.ПеременныеРасходы);
					
					отбор = новый структура("Фонд", стрП1.Фонд);
					Нстроки = СтрДерП1.строки.НайтиСтроки(отбор);
					Если Нстроки.Количество() = 0 Тогда
						ТекСтрока = СтрДерП1.строки.добавить(); 
						ЗаполнитьЗначенияСвойств(ТекСтрока,стрП1);
						ТекСтрока.номерПолитики = 1;
						ТекСтрока.типСтроки = Перечисления.КСУ_ВидыСтрокТБ.ПеременныеРасходы;
					Иначе
						ТекСтрока = Нстроки[0];
					КонецЕсли;
				КонецЕсли;
			Иначе
				СтрДерП1 = ПолучитьСтрокуПоТипуСтроки(ДеревоРасходы, Перечисления.КСУ_ВидыСтрокТБ.ПеременныеРасходы);
				
				отбор = новый структура("Подразделение, Фонд", стрП1.Подразделение, стрП1.Фонд);
				Нстроки = СтрДерП1.строки.НайтиСтроки(отбор);
				Если Нстроки.Количество() = 0 Тогда
					ТекСтрока = СтрДерП1.строки.добавить(); 
					ЗаполнитьЗначенияСвойств(ТекСтрока,стрП1);
					ТекСтрока.номерПолитики = 1;
					ТекСтрока.типСтроки = Перечисления.КСУ_ВидыСтрокТБ.ПеременныеРасходы;
				Иначе
					ТекСтрока = Нстроки[0];
				КонецЕсли;
				
			КонецЕсли;
			
			Если ТекСтрока <> Неопределено тогда
				ТекСтрока["СуммаПоФП"+НомерКолонки] = стрП1.СуммаПлан;
				ТекСтрока["Сумма"+НомерКолонки] = стрП1.СуммаФакт;
			КонецЕсли;
		КонецЦикла;

		///////
		// МАРЖА
		///////
		
		Если ИспДоходыПоПодразделениям Тогда
			Для каждого стрПодр из тзПодр Цикл
				СтрДохИт = Объект.ДоходыИтого.НайтиСтроки(Новый структура("Подразделение" ,стрПодр.Подразделение));
				стрПодрДер = ДеревоРасходы.Строки.Найти(стрПодр.Подразделение);
				
				СтрДерП1 = ПолучитьСтрокуПоТипуСтроки(стрПодрДер, Перечисления.КСУ_ВидыСтрокТБ.ПеременныеРасходы);
				СтрДерМаржа = ПолучитьСтрокуПоТипуСтроки(стрПодрДер, Перечисления.КСУ_ВидыСтрокТБ.МаржинальнаяПрибыль);
				СтрДерМаржа["Сумма" + НомерКолонки] = 0;
					
				Если стрПодрДер <> Неопределено И стрПодрДер.Строки.Количество() > 0 И СтрДохИт.Количество() > 0 Тогда
					
					ДоходИтого = 0;
					Для каждого стрДохНайд из СтрДохИт Цикл
						ДоходИтого = ДоходИтого + стрДохНайд["Неделя" + НомерКолонки];
					КонецЦикла;
					
					РасходыП1 = СтрДерП1.Строки.Итог("Сумма" + НомерКолонки);
					СтрДерМаржа["Сумма" + НомерКолонки] = ДоходИтого - РасходыП1;
				КонецЕсли;
			КонецЦикла;
		Иначе
			ДоходИтого = Объект.ДоходыИтого.Итог("Неделя" + НомерКолонки);
			
			СтрДерП1 = ПолучитьСтрокуПоТипуСтроки(ДеревоРасходы, Перечисления.КСУ_ВидыСтрокТБ.ПеременныеРасходы);
			РасходыП1 = СтрДерП1.Строки.Итог("Сумма" + НомерКолонки);
			
			СтрДерМаржа = ПолучитьСтрокуПоТипуСтроки(ДеревоРасходы, Перечисления.КСУ_ВидыСтрокТБ.МаржинальнаяПрибыль);
			СтрДерМаржа["Сумма" + НомерКолонки] = ДоходИтого - РасходыП1;
		КонецЕсли;
		
		///////
		// УЧРЕДИТЕЛЬСКИЕ ФОНДЫ
		///////
		
		СтрокиУФ = тзРезУчредФонды.НайтиСтроки(Новый Структура("Неделя",неделя.НачалоНедели));
		для каждого стрУФ из СтрокиУФ Цикл
			ТекСтрока = Неопределено;
			
			// найдем строку с фондом или добавим ее
			Если ИспДоходыПоПодразделениям ТОгда
				стрПодр = ДеревоРасходы.Строки.Найти(стрУФ.Подразделение);
				Если стрПодр <> Неопределено И стрПодр.Строки.Количество() > 0 Тогда
					СтрДерУФ = ПолучитьСтрокуПоТипуСтроки(стрПодр, Перечисления.КСУ_ВидыСтрокТБ.УчредительскиеФонды);
					
					отбор = новый структура("Фонд", стрУФ.Фонд);
					Нстроки = СтрДерУФ.строки.НайтиСтроки(отбор);
					Если Нстроки.Количество() = 0 Тогда
						ТекСтрока = СтрДерУФ.строки.добавить(); 
						ЗаполнитьЗначенияСвойств(ТекСтрока,стрУФ);
						ТекСтрока.номерПолитики = 3;
						ТекСтрока.типСтроки = Перечисления.КСУ_ВидыСтрокТБ.УчредительскиеФонды;
					Иначе
						ТекСтрока = Нстроки[0];
					КонецЕсли;
				КонецЕсли;
			Иначе
				СтрДерУФ = ПолучитьСтрокуПоТипуСтроки(ДеревоРасходы, Перечисления.КСУ_ВидыСтрокТБ.УчредительскиеФонды);
				
				отбор = новый структура("Подразделение, Фонд", стрУФ.Подразделение, стрУФ.Фонд);
				Нстроки = СтрДерУФ.строки.НайтиСтроки(отбор);
				Если Нстроки.Количество() = 0 Тогда
					ТекСтрока = СтрДерУФ.строки.добавить(); 
					ЗаполнитьЗначенияСвойств(ТекСтрока, стрУФ);
					ТекСтрока.номерПолитики = 3;
					ТекСтрока.типСтроки = Перечисления.КСУ_ВидыСтрокТБ.УчредительскиеФонды;
				Иначе
					ТекСтрока = Нстроки[0];
				КонецЕсли;
				
			КонецЕсли;
			
			Если ТекСтрока <> Неопределено тогда
				ТекСтрока["СуммаПоФП"+НомерКолонки] = стрУФ.СуммаПлан;
				ТекСтрока["Сумма"+НомерКолонки] = стрУФ.СуммаФакт;
			КонецЕсли;
		КонецЦикла;
		
		
		///////
		// ИТОГО К РАСПРЕДЕЛЕНИЮ
		///////
		
		Если ИспДоходыПоПодразделениям Тогда
			Для каждого стрПодр из тзПодр Цикл
			    стрПодрДер = ДеревоРасходы.Строки.Найти(стрПодр.Подразделение);
				Если стрПодрДер <> Неопределено И стрПодрДер.Строки.Количество() > 0 Тогда
					СтрМаржа = ПолучитьСтрокуПоТипуСтроки(стрПодрДер, Перечисления.КСУ_ВидыСтрокТБ.МаржинальнаяПрибыль);
					СтрУчред = ПолучитьСтрокуПоТипуСтроки(стрПодрДер, Перечисления.КСУ_ВидыСтрокТБ.УчредительскиеФонды);
					
					СтрИтогоКРаспр = ПолучитьСтрокуПоТипуСтроки(стрПодрДер, Перечисления.КСУ_ВидыСтрокТБ.ИтогКЗаливке);
					СтрИтогоКРаспр["Сумма" + НомерКолонки] = СтрМаржа["Сумма" + НомерКолонки] - СтрУчред.Строки.итог("Сумма" + НомерКолонки);
				КонецЕсли;
			КонецЦикла;
		Иначе
			СтрМаржа = ПолучитьСтрокуПоТипуСтроки(ДеревоРасходы, Перечисления.КСУ_ВидыСтрокТБ.МаржинальнаяПрибыль);
			СтрУчред = ПолучитьСтрокуПоТипуСтроки(ДеревоРасходы, Перечисления.КСУ_ВидыСтрокТБ.УчредительскиеФонды);
			
			СтрИтогоКРаспр = ПолучитьСтрокуПоТипуСтроки(ДеревоРасходы, Перечисления.КСУ_ВидыСтрокТБ.ИтогКЗаливке);
			СтрИтогоКРаспр["Сумма" + НомерКолонки] = СтрМаржа["Сумма" + НомерКолонки] - СтрУчред.Строки.итог("Сумма" + НомерКолонки);
		КонецЕсли;

		
		///////
		/// ЗАЛИВКА
		///////
		
		СтрокиЗаливки = Заливка.НайтиСтроки(новый Структура("неделя", ТекНеделя));
		
		для каждого стрСуммаФП из СтрокиЗаливки Цикл
						
			// найдем строку с фондом или добавим ее
			Если ИспДоходыПоПодразделениям ТОгда
				стрПодр = ДеревоРасходы.Строки.Найти(стрСуммаФП.Подразделение);
				
				СтрП2 = ПолучитьСтрокуПоТипуСтроки(стрПодр, Перечисления.КСУ_ВидыСтрокТБ.ПостоянныеРасходы);
				
				отбор = новый структура("Фонд", стрСуммаФП.Фонд);
				Нстроки = СтрП2.строки.НайтиСтроки(отбор);
				Если Нстроки.Количество() = 0 Тогда
					ТекСтрока = СтрП2.строки.добавить(); 
					ЗаполнитьЗначенияСвойств(ТекСтрока,стрСуммаФП);
					ТекСтрока.номерПолитики = 2;
					ТекСтрока.типСтроки = Перечисления.КСУ_ВидыСтрокТБ.ПостоянныеРасходы;
				Иначе
					ТекСтрока = Нстроки[0];
				КонецЕсли;
			Иначе
				отбор = новый структура("Подразделение, Фонд", стрСуммаФП.Подразделение, стрСуммаФП.Фонд);
				
				СтрП2 = ПолучитьСтрокуПоТипуСтроки(ДеревоРасходы, Перечисления.КСУ_ВидыСтрокТБ.ПостоянныеРасходы);
				
				Нстроки = СтрП2.строки.НайтиСтроки(отбор);
				Если Нстроки.Количество() = 0 Тогда
					ТекСтрока = СтрП2.строки.добавить(); 
					ЗаполнитьЗначенияСвойств(ТекСтрока,стрСуммаФП);
					ТекСтрока.номерПолитики = 2;
					ТекСтрока.типСтроки = Перечисления.КСУ_ВидыСтрокТБ.ПостоянныеРасходы;
				Иначе
					ТекСтрока = Нстроки[0];
				КонецЕсли;
			КонецЕсли;
									
			// заполним суммы			
			долг =0 ;
			Перелив =0 ;
									
			нСтрокиДолг = долги.НайтиСтроки(новый Структура("Подразделение,Фонд", стрСуммаФП.Подразделение,стрСуммаФП.Фонд));			
			Если нСтрокиДолг.Количество()>0 Тогда
				долг = нСтрокиДолг[0].сумма;
			КонецЕсли;
		
			ТекСтрока["СуммаПоФП"+НомерКолонки] = стрСуммаФП.СуммаПлан + долг;
			ТекСтрока["Сумма"+НомерКолонки] = стрСуммаФП.СуммаЗаливка;													
			
			Если ТекНеделя <= ТекПарам.ТекНеделя Тогда // Заполним долги
				ОсталосьНедель = КолНед - (ТекНедНомер + 1); // ТекНедНомер - начинается с 0
				Если ТекСтрока["Сумма"+НомерКолонки] < ТекСтрока["СуммаПоФП"+НомерКолонки] и ОсталосьНедель > 0 Тогда 			
					долг = ТекСтрока["СуммаПоФП"+НомерКолонки] - ТекСтрока["Сумма"+НомерКолонки];				
					Новстр = долги.Добавить();
					ЗаполнитьЗначенияСвойств(Новстр,стрСуммаФП);
					Новстр.Сумма = долг / ОсталосьНедель;								
				КонецЕсли;
			КонецЕсли;
			
		КонецЦикла;
		
		ТекНедНомер = ТекНедНомер + 1;
		НомерКолонки = НомерКолонки + 1;
		
		долги.Свернуть("Подразделение, Фонд", "Сумма");
	КонецЦикла;
	
	///// Пересчет плана переменных расходов
	счН = 0;
	долги.Очистить();
	Пока счН < КолНед Цикл
		НомерКолонки = счН + 1;
		ОсталосьНедель = КолНед - (счН + 1);
		
		Если ИспДоходыПоПодразделениям Тогда
			Для каждого стрПодр из тзПодр Цикл
				стрПодр1 = ДеревоРасходы.Строки.Найти(стрПодр.Подразделение);
				
				СтрП1 = ПолучитьСтрокуПоТипуСтроки(стрПодр1, Перечисления.КСУ_ВидыСтрокТБ.ПеременныеРасходы);

				ПересчетПланаП1Заливки(СтрП1.строки, долги, ДеревоРасходы, НомерКолонки, счН, ОсталосьНедель, тзНедель, ТекПарам);
			КонецЦикла;
		Иначе
			СтрП1 = ПолучитьСтрокуПоТипуСтроки(ДеревоРасходы, Перечисления.КСУ_ВидыСтрокТБ.ПеременныеРасходы);
			
			ПересчетПланаП1Заливки(СтрП1.строки, долги, ДеревоРасходы, НомерКолонки, счН, ОсталосьНедель, тзНедель, ТекПарам);
		КонецЕсли;
		
		счН = счН + 1;
	КонецЦикла;

	//////
	
	//итоги по неделям
	для сч = 1 по 14 цикл
		Если ИспДоходыПоПодразделениям ТОгда
			для каждого стрПодр из ДеревоРасходы.Строки Цикл
				ПересчетИтогиПоНеделямЗаливки(стрПодр, ДеревоРасходы, сч);
				
				ИтСуммФакт = 0;
				ИтСуммПлан = 0;
				Для каждого стрПодчПодр из стрПодр.строки Цикл
					Если стрПодчПодр.ТипСтроки = Перечисления.КСУ_ВидыСтрокТБ.МаржинальнаяПрибыль или стрПодчПодр.ТипСтроки = Перечисления.КСУ_ВидыСтрокТБ.ИтогКЗаливке Тогда
						Продолжить;
					КонецЕсли;
					
					ИтСуммФакт = ИтСуммФакт + стрПодчПодр["Сумма"+сч];
					ИтСуммПлан = ИтСуммПлан + стрПодчПодр["СуммаПоФП"+сч];
					
				КонецЦикла;
				
				стрПодр["Сумма"+сч] = ИтСуммФакт;
				стрПодр["СуммаПоФП"+сч] = ИтСуммПлан;
			КонецЦикла;
		Иначе
			ПересчетИтогиПоНеделямЗаливки(ДеревоРасходы, ДеревоРасходы, сч);
		КонецЕсли;
		
		ИтогоСумма = 0;
		ИтогоСуммаПоФП = 0;
		Для каждого стрДР из ДеревоРасходы.строки Цикл
			Если стрДР.ТипСтроки = Перечисления.КСУ_ВидыСтрокТБ.МаржинальнаяПрибыль или стрДР.ТипСтроки = Перечисления.КСУ_ВидыСтрокТБ.ИтогКЗаливке Тогда
				Продолжить;
			КонецЕсли;
			
			ИтогоСумма = ИтогоСумма + стрДР["Сумма"+сч];
			ИтогоСуммаПоФП = ИтогоСуммаПоФП + стрДР["СуммаПоФП"+сч];
		КонецЦикла;
		
		//Элементы["ЗаливкаФондов_ИтогоСуммаФакт"+сч].ТекстПодвала = формат(ДеревоРасходы.строки.Итог("Сумма"+сч, ложь),"ЧДЦ=2; ЧН=");
		//Элементы["ЗаливкаФондов_ИтогоСуммаПоФП"+сч].ТекстПодвала = формат(ДеревоРасходы.Строки.Итог("СуммаПоФП"+сч, ложь),"ЧДЦ=2; ЧН=");
		
		Элементы["ЗаливкаФондов_ИтогоСуммаФакт"+сч].ТекстПодвала = формат(ИтогоСумма,"ЧДЦ=2; ЧН=");
		Элементы["ЗаливкаФондов_ИтогоСуммаПоФП"+сч].ТекстПодвала = формат(ИтогоСуммаПоФП,"ЧДЦ=2; ЧН=");
		
		
		Если сч > НомерТекущейНедели Тогда
			Если ИтогоСумма = 0 Тогда
				Элементы["ЗаливкаФондов_ИтогоСуммаФакт"+сч].ТекстПодвала = "-";
			КонецЕсли;
		Иначе
			Если ИтогоСумма < ИтогоСуммаПоФП Тогда
				Элементы["ЗаливкаФондов_ИтогоСуммаФакт"+сч].ЦветТекстаПодвала = Новый цвет(255,0,0);
			Иначе
				Элементы["ЗаливкаФондов_ИтогоСуммаФакт"+сч].ЦветТекстаПодвала = Новый цвет(60, 167, 94);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	// Проценты 
	Для каждого стр1 из ДеревоРасходы.Строки Цикл
		РасчетПроцентаСтроки(стр1, КолНед, тзРезП1, Заливка, ИспДоходыПоПодразделениям);
	КонецЦикла;
		
	ЗначениеВРеквизитФормы(ДеревоРасходы,"ЗаливкаИтого");
КонецПроцедуры


&НаСервереБезКонтекста
Процедура РасчетПроцентаСтроки(стр, КолНед, тзРезП1, Заливка, ИспДоходыПоПодразделениям)
	Если стр.ТипСтроки = Перечисления.КСУ_ВидыСтрокТБ.ИтогКЗаливке или стр.ТипСтроки = Перечисления.КСУ_ВидыСтрокТБ.МаржинальнаяПрибыль ТОгда // они без плана
		возврат;
	КонецЕсли;
	
	план = 0;
	факт = 0;
	Если стр.ТипСтроки = Перечисления.КСУ_ВидыСтрокТБ.ПеременныеРасходы Тогда // по ним особый расчет т.к. план у них плавает
		Если стр.ЭтоЗаголовок Тогда
			Если ИспДоходыПоПодразделениям ТОгда
				Нстроки = тзРезП1.найтиСтроки(Новый структура("Подразделение", стр.Родитель.Подразделение));
			Иначе
				Нстроки = тзРезП1;
			КонецЕсли;
		ИНаче
			Нстроки = тзРезП1.найтиСтроки(Новый структура("Подразделение,Фонд", стр.Подразделение, стр.Фонд));
		КонецЕсли;
		для каждого стрп1 из Нстроки Цикл
			план = план + стрп1.СуммаПлан;
			факт = факт + стрп1.СуммаФакт;
		КонецЦикла;
	ИначеЕсли стр.ТипСтроки = Перечисления.КСУ_ВидыСтрокТБ.ПостоянныеРасходы Тогда 
		Если стр.ЭтоЗаголовок Тогда
			Если ИспДоходыПоПодразделениям ТОгда
				Нстроки = Заливка.найтиСтроки(Новый структура("Подразделение", стр.Родитель.Подразделение));
			Иначе
				Нстроки = Заливка;
			КонецЕсли;
		ИНаче
			Нстроки = Заливка.найтиСтроки(Новый структура("Подразделение,Фонд", стр.Подразделение, стр.Фонд));
		КонецЕсли;
		для каждого стрп1 из Нстроки Цикл
			план = план + стрп1.СуммаПлан;
			факт = факт + стрп1.СуммаЗаливка;
		КонецЦикла;
	Иначе
		для сч = 1 по КолНед Цикл
			план = план + стр["СуммаПоФП"+сч];
			факт = факт + стр["Сумма"+сч];
		КонецЦикла;
	КонецЕсли;
	
	стр.СуммаПлан = план;
	стр.СуммаФакт = факт;
	стр.СуммаОтклонение = факт - план;
	стр.ПроцентВыполнения = ?(план = 0, 0, (факт / план) * 100);
	
	Для каждого стр2 из стр.Строки Цикл
		РасчетПроцентаСтроки(стр2, КолНед, тзРезП1, Заливка, ИспДоходыПоПодразделениям);
	КонецЦикла;
КонецПроцедуры
	
&НаСервере
Процедура ПересчетИтогиПоНеделямЗаливки(СтрокаРасчета, тзЗаливка, сч)
	
	Для каждого стр из СтрокаРасчета.Строки Цикл
		Если стр.ТипСтроки = Перечисления.КСУ_ВидыСтрокТБ.МаржинальнаяПрибыль или стр.ТипСтроки = Перечисления.КСУ_ВидыСтрокТБ.ИтогКЗаливке Тогда
			Продолжить;
		КонецЕсли;
		стр["СуммаПоФП"+сч] = стр.строки.итог("СуммаПоФП"+сч);
		стр["Сумма"+сч] = стр.строки.итог("Сумма"+сч);
	КонецЦикла;	
КонецПроцедуры


&НаСервере
Процедура ПересчетПланаП1Заливки(СтрокиП1, долги, тзЗаливка, НомерКолонки, счН, ОсталосьНедель, тзНедели, ТекПарам)
	для каждого стрФонд из СтрокиП1 Цикл
		нСтрокиДолг = долги.НайтиСтроки(новый Структура("Подразделение,Фонд", стрФонд.Подразделение,стрФонд.Фонд));
		долг =0 ;
		Если нСтрокиДолг.Количество()>0 Тогда
			СтрокаДолг = нСтрокиДолг[0];
			долг = СтрокаДолг.сумма;
		Иначе
			СтрокаДолг = долги.Добавить();
			СтрокаДолг.Подразделение = стрФонд.Подразделение; 
			СтрокаДолг.Фонд = стрФонд.Фонд;
			СтрокаДолг.Сумма = 0;
		КонецЕсли;
		
		стрФонд["СуммаПоФП"+НомерКолонки] = стрФонд["СуммаПоФП"+НомерКолонки] + долг;
		
		Если ОсталосьНедель > 0 и тзНедели[счН].НачалоНедели<=ТекПарам.ТекНеделя Тогда
			СтрокаДолг.сумма = СтрокаДолг.сумма + (стрФонд["СуммаПоФП"+НомерКолонки] - стрФонд["Сумма"+НомерКолонки])/ОсталосьНедель;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры
	
&НаСервере
Процедура Политика_ВДерево(НомерПолитики)
	
	Об = РеквизитФормыВЗначение("ДеревоПолитика"+НомерПолитики);
	ТабПолитика = Объект["Политика"+НомерПолитики].Выгрузить();
    Об.Строки.Очистить(); 
    
    
    //ТабРазделы   = ИА_БФС.ТЗ_Свернуть(ТабПолитика, "Раздел", "СуммаНал, СуммаБезнал");
	ТабРазделы = ТабПолитика.Скопировать();
	ТабРазделы.Свернуть("Раздел", "Сумма");
	
    Отбор = Новый Структура("Раздел");
	
	
	Если НомерПолитики = 1 Тогда
		Итоги = Новый Структура("Сумма", Объект.ДоходыИтого.Итог("СуммаБезнал"));
	Иначе
    	Итоги = Новый Структура("Сумма", Объект.ВаловаяПрибыльСуммаБезнал);
	КонецЕсли;
    
    
	Для каждого СтрРаздел Из ТабРазделы Цикл
		Если ИспользоватьРазделы Тогда
    		СтрокаРаздел = Об.Строки.Добавить();
        	ЗаполнитьЗначенияСвойств(СтрокаРаздел, СтрРаздел);
		Иначе
			СтрокаРаздел = Об;
		КонецЕсли;
        
        Таб = ИА_БФС.ТЗ_ФильтрПоОтбору(ТабПолитика, Новый Структура("Раздел", СтрРаздел.Раздел));
		Таб.Свернуть("Раздел,Подразделение,Статья","Сумма");
        
        Для каждого Стр Из Таб Цикл
        	СтрокаДетали = СтрокаРаздел.Строки.Добавить();
            ЗаполнитьЗначенияСвойств(СтрокаДетали, Стр);
        КонецЦикла;  
		
		Если ИспользоватьРазделы Тогда
	        Итоги.Сумма   = Итоги.Сумма - Таб.Итог("Сумма");
	        СтрокаРаздел.Сумма = Таб.Итог("Сумма");
	        
	    	СтрокаСКД = Об.Строки.Добавить();
	        СтрокаСКД.Раздел = "СКД:";
			СтрокаСКД.Сумма = Итоги.Сумма;	
		КонецЕсли;
    КонецЦикла;    
	
	ЗначениеВРеквизитФормы(Об, "ДеревоПолитика"+НомерПолитики); 
    
КонецПроцедуры
 
&НаКлиенте
Процедура Политика_Развернуть(НомерПолитики, ТекСтрока = Неопределено)
	Если НомерПолитики = 1 Тогда
		Рекв = ДеревоПолитика1;
		Элем = Элементы.ДеревоПолитика1;
	Иначе
		Рекв = ДеревоПолитика2;
		Элем = Элементы.ДеревоПолитика2;
	КонецЕсли;
	
    ИА_БФК.ДФ_РазвернутьВсеВетки(Рекв, Элем);
	
	Если ТекСтрока <> Неопределено Тогда
		ПредСтрока = ПолучитьСтрокуПолитика(ТекСтрока.Раздел, ТекСтрока.Статья, ТекСтрока.Подразделение, НомерПолитики);
		Если ПредСтрока <> Неопределено Тогда
			Элем.ТекущаяСтрока = ПредСтрока;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

