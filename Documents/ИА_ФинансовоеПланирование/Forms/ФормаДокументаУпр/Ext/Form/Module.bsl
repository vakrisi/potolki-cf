			ЗаполнитьЗначенияСвойств(Новстр, стр);
			Новстр.ид = стр.Источник;
			//Если ИА_БФКС.РеквизитЕсть(Новстр, "ВидДоходаПолучатель") Тогда
			//	Новстр.ВидДоходаПолучатель = Стр.ВидДохода;
			//КонецЕсли; 
		КонецЦикла;
		ПересчитатьПриИзменДоходов();
	КонецЕсли;

КонецПроцедуры

