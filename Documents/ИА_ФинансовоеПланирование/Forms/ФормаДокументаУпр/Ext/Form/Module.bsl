&НаКлиенте
Процедура ДоходыБППриАктивизацииСтроки(Элемент)
	тд = Элементы.ДоходыБП.ТекущиеДанные;
	Если тд = Неопределено Тогда
		возврат;
	КонецЕсли;
	
	масс = Новый Массив;
	массПодр = новый Массив;
	ФильтроватьПоПодр = ИспДоходыПоПодразделениям и ЗначениеЗаполнено(тд.Подразделение);
	для каждого стр из Объект.Доходы Цикл
		Если стр.СуммаБезнал > 0 Тогда
			Если масс.Найти(стр.виддохода) = Неопределено И  стр.Подразделение = тд.Подразделение или не ФильтроватьПоПодр Тогда
				масс.Добавить(стр.виддохода);
			КонецЕсли;
			Если массПодр.Найти(стр.Подразделение) = Неопределено Тогда 
				массПодр.Добавить(стр.Подразделение);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	элементы.ДоходыБП1ВидДохода.СписокВыбора.ЗагрузитьЗначения(масс);
	элементы.ДоходыБППодразделение.СписокВыбора.ЗагрузитьЗначения(массПодр);
КонецПроцедуры

&НаКлиенте
Процедура ДоходыДеревоСуммаБезналОткрытие(Элемент, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	ТекСтрока = Элементы.ДоходыДерево.ТекущиеДанные;
	Если ТекСтрока <> Неопределено и ЗначениеЗаполнено(ТекСтрока.ВидДохода) Тогда
		Если ИспДоходыПоПодразделениям Тогда
			Если типзнч(ТекСтрока.ВидДохода) = тип("СправочникСсылка.ИА_ВидыДоходов") ТОгда
				Данные = СформироватьОтчетРасшифровкиВидаДохода(ТекСтрока.ВидДохода, ТекСтрока.ПолучитьРодителя().ВидДохода);
			КонецЕсли;
		ИНаче
	    	Данные = СформироватьОтчетРасшифровкиВидаДохода(ТекСтрока.ВидДохода, ПредопределенноеЗначение("Справочник.ИА_ЦФО.ПустаяСсылка"));
		КонецЕсли;
	    
	    Если Данные.Сформирован Тогда
	    	ИА_БФКС.ТабДок_Показать(Данные.ТабДок, Данные.Заголовок);
	    Иначе
			ПоказатьПредупреждение(,"Нет данных расшифровки по виду дохода '" + ТекСтрока.ВидДохода + "'");
	    КонецЕсли; 
	КонецЕсли;
КонецПроцедуры

