&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если НЕ Параметры.ЗначениеКопирования.Пустая() Тогда
    	Отказ = Истина; 
		СтандартнаяОбработка = Ложь;
		возврат;
	КонецЕсли;
	
	Если Объект.Ссылка.Пустая() ТОгда
		Объект.Дата = НачалоДня(ТекущаяДата())-1;  
		объект.АвтоотклонениеЗаказовПослеФП = Константы.КСУ_АвтоотклонениеЗаказовПослеФП.Получить();
		объект.АвтосборДоходов = истина;
		объект.ДатаСоздания = ТекущаяДата();
	КонецЕсли;
	
	для сч = 1 по 14 Цикл
		Новстр = ВидимостьКолонок.Добавить();
	КонецЦикла;
	
	ФП_по_ТБ = ИА_ФП_ПовторИсп.ФП_по_ТБ(Объект.Дата);
	ИспПодразделения = Константы.КСУ_ФП_ИспользоватьПодразделения.Получить();
	ФпНаСледДень = не Константы.ИА_ФП_НачалоПланирования.Получить();
	ИспДоходыПоПодразделениям = Константы.КСУ_ДоходыПоПодразделениям.Получить();
	ФондДБП = Константы.ИА_ФП_ФондДоходовБП.Получить();
	ДоступенЗаймИзОтлДохода = Константы.КСУ_РазрешитьЗаймыИзОтложенногоДохода.Получить();
	
	Если ФП_по_ТБ Тогда
		Элементы.ГруппаЗаголовокПол2.Видимость = ложь;
		Элементы.ДеревоПолитика2.Видимость = ложь;
		//Элементы.ГруппаПолитики.ШиринаПодчиненныхЭлементов=ШиринаПодчиненныхЭлементовФормы.ЛевыйОченьУзкий;
	КонецЕсли;
	
	
	Элементы.ДоходыДерево.Отображение= ?(ИспДоходыПоПодразделениям, ОтображениеТаблицы.Дерево, ОтображениеТаблицы.Список);
	Элементы.ДоходыЧистые.Отображение= ?(ИспДоходыПоПодразделениям, ОтображениеТаблицы.Дерево, ОтображениеТаблицы.Список);
	
	Если ИспДоходыПоПодразделениям тогда
		Элементы.ДоходыДеревоВидДохода.Заголовок = "Подразделение / вид дохода";
		Элементы.ДоходыИтогоВидДохода.Заголовок =  "Подразделение / вид дохода";
	КонецЕсли;
	
	Элементы.ДоходыБППодразделение.Видимость = ИспДоходыПоПодразделениям;
	Элементы.ОтложенныйДоходПодразделение.Видимость = ИспДоходыПоПодразделениям;
	Элементы.ДоходыИтогоПодразделение.Видимость = ИспДоходыПоПодразделениям;
	Элементы.ДоходыБП_РаспределениеПодразделение.Видимость = ИспДоходыПоПодразделениям;
	Элементы.РаспределениеСредствСФондовПодразделение1.Видимость = ИспПодразделения;
	Элементы.ДеревоПолитикаПервичная1Подразделение.Видимость = ИспПодразделения;
	Элементы.ДеревоПолитикаПодразделение.Видимость = ИспПодразделения;
	Элементы.ЗаливкаФондов_ИтогоПодразделение.Видимость = ИспПодразделения;
	Элементы.ТаблицаЗНОПодразделение.Видимость = ИспПодразделения;
	Элементы.ВозвратыЗаймовСПодразделения.Видимость = ИспПодразделения;
	Элементы.ВозвратыЗаймовНаПодразделение.Видимость = ИспПодразделения;
	Элементы.ЗаймыНаПодразделение.Видимость = ИспПодразделения;
	Элементы.ЗаймыСПодразделения.Видимость = ИспПодразделения;	
	Элементы.ФП1Подразделение.Видимость = ИспПодразделения;
	Элементы.ГруппаОпПодр.Видимость = ИспПодразделения;
	
	
	Элементы.ПоказатьСкрытьСтатью.Видимость = ФП_по_ТБ;
	Элементы.ГруппаЗаголовокРасходы.Видимость = ФП_по_ТБ;
	Элементы.ЗаливкаФондов_Итого.Видимость = ФП_по_ТБ;	
	
	Элементы.ГруппаСуммаКРаспределению.Видимость = не ФП_по_ТБ;
	Элементы.ГруппаШапкаРаспр.Видимость = не ФП_по_ТБ;
	Элементы.ДеревоЗПАвтоначисление.Видимость = не ФП_по_ТБ;
	Элементы.ДеревоЗПНачислениеВФонд.Видимость = не ФП_по_ТБ;
	Элементы.ГруппаЗагП1.Видимость = не ФП_по_ТБ;
	Элементы.ДеревоПолитика1.Видимость = не ФП_по_ТБ;
	Элементы.ГруппаВалПрибыль.Видимость = не ФП_по_ТБ;	
	Элементы.ГруппаЗНО.Видимость = не ФП_по_ТБ;
	Элементы.ГруппаПланирование.Видимость = не ФП_по_ТБ;
		
	ИспользоватьРаспределениеСФондов = Константы.ИА_ИспользоватьРаспределениеСФондов.Получить();
	//ИспользоватьСпецдоход            = Константы.ИА_ИспользоватьСпецдоход.Получить();
	ИспользоватьСпецдоход = истина;
	ФППоОрганизациям              = Константы.ИА_ФП_ВестиФППоОрганизациям.Получить();
	РазделятьНалБезнал            = ложь;
	
	//ВыводитьГруппировкуПоСчетам =  Константы.ИА_ФП_ВыводитьГруппировкуПоСчетам.Получить();
	
	//Элементы.ОписаниеЗРС.Видимость = Константы.ИА_ФП_ОтображатьРасшифровкуЗВСВФП.Получить();
	//Элементы.ОписаниеЗНО.Видимость = Элементы.ОписаниеЗРС.Видимость;
	
	ИспользоватьРазделы = Константы.ИА_ФП_ИспользоватьРазделыПолитики.Получить();
	Элементы.ДеревоПолитикаПервичная1Раздел.Видимость = ИспользоватьРазделы;
	Элементы.ДеревоПолитикаРаздел.Видимость = ИспользоватьРазделы;
	
	СостояниеЗаказаОтклонен    = Перечисления.ИА_СостояниеЗаказа.Отклонен;
	ВидДенежныхСредствНаличные = Перечисления.ИА_ВидДенежныхСредств.Наличные;
	
	ЭтоРСФ = ИА_ПраваС.ЗначениеПраваТекПользователя(ПланыВидовХарактеристик.ИА_ПраваПользователей.РСФ)
				или ИА_ПраваС.ЗначениеПраваТекПользователя(ПланыВидовХарактеристик.ИА_ПраваПользователей.ФП_ПолныеПрава);
	ПравоУтверждения = ИА_ПраваС.ЗначениеПраваТекПользователя(ПланыВидовХарактеристик.ИА_ПраваПользователей.УтверждениеФП)
				или ИА_ПраваС.ЗначениеПраваТекПользователя(ПланыВидовХарактеристик.ИА_ПраваПользователей.ФП_ПолныеПрава);
	ТолькоПросмотрФП = ТолькоПросмотрФП();
	
	Элементы.РаспределениеПоФондамПогаситьЗайм.Доступность	= НЕ ТолькоПросмотрФП;
	Элементы.Группа6.Видимость = ИспользоватьРаспределениеСФондов;
	Элементы.РаспределениеСредствСФондов.Видимость = ИспользоватьРаспределениеСФондов;
	
	Элементы.ГруппаАвтосборДоходов.Видимость = объект.ЕстьАвтодоходы;
	
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Если ФППоОрганизациям Тогда
			Объект.Организация = ИА_НастройкиС.ЗначениеНастройкиТекПользователя(ПланыВидовХарактеристик.ИА_НастройкиПользователей.ОсновнаяОрганизация);
		КонецЕсли;
		Объект.НачалоПланирования   = не Константы.ИА_ФП_НачалоПланирования.Получить();
	КонецЕсли;
	
	ПредФпСтрукт = ПолучитьПоследнееФП();
	
	//
	ИА_ФПСервер.Форма_УстановитьОграничениеТипаИсточникСпецДохода(ЭтаФорма, Элементы.ДоходыБП1Источник);
	ИА_ФПСервер.Форма_УстановитьОграничениеТипаИсточникСпецДохода(ЭтаФорма, Элементы.ДоходыБП_РаспределениеИсточник1);
	
	//Элементы.Утверждено.ТолькоПросмотр = НЕ ИА_ПраваС.ЗначениеПраваТекПользователя("УтверждениеФП");
	//Элементы.УтвердитьВаловуюПрибыль.ТолькоПросмотр = НЕ ИА_ПраваС.ЗначениеПраваТекПользователя("УтверждениеВаловойПрибыли");
	
	
	КэшПроверкаИзменений = Новый Структура("ДоходыБП1, РаспределениеСредствСФондов1, ДоходыБП_Распределение1"
	, Новый Структура("ВидДохода, СуммаБезнал, СуммаНал") 
	, Новый Структура("ВидДохода, СуммаБезнал, СуммаНал") 
	, Новый Структура("ВидДохода, СуммаБезнал, СуммаНал") 
	);

	ОбновитьНадписьТБ();
	
	//ИА_КСУОбщийСервер.СделатьКнопкуОсновной(Элементы.ГруппаКП);
	
	Запрос= новый запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ИА_СостояниеЗаказа.Ссылка КАК Статус,
	               |	ИА_СостояниеЗаказа.Порядок КАК Номер
	               |ИЗ
	               |	Перечисление.ИА_СостояниеЗаказа КАК ИА_СостояниеЗаказа";
	тз = запрос.Выполнить().Выгрузить();
	ЗначениеВРеквизитФормы(тз, "НомераСтатусовЗП");
	
	РаспределитьЗаймыВозвратыПоТЧ();
	ОбновитьНадписьКнопкиОтДохода();
	
	ЕстьОшибкаВерсииТБ = ПолучитьЕстьОшибкаВерсииТБ();
	
	ВнедоходныеПоступления.Параметры.УстановитьЗначениеПараметра("Организация", объект.Организация);
	ВнедоходныеПоступления.Параметры.УстановитьЗначениеПараметра("НеПоОрг", не ФППоОрганизациям);
	ВнедоходныеПоступления.Параметры.УстановитьЗначениеПараметра("ДатаНачалаТБ", Дата(1,1,1));
	ВнедоходныеПоступления.Параметры.УстановитьЗначениеПараметра("ДатаКонцаТБ", Дата(1,1,1));

	м = ИА_ФПСервер.ПолучитьОрганизацииДляОтчетов();
	Если (не объект.Организация.Пустая()) и м.найти(объект.Организация) = Неопределено тогда
		м.добавить(объект.Организация);
	КонецЕсли;
	Элементы.Организация.СписокВыбора.ЗагрузитьЗначения(м);
	
КонецПроцедуры

&НаСервере
Функция ПолучитьЕстьОшибкаВерсииТБ()
	возврат ЗначениеЗаполнено(Объект.ДатаПроведенияТБ) и ЗначениеЗаполнено(Объект.ТБ.ДатаПроведения) и Объект.ДатаПроведенияТБ<> Объект.ТБ.ДатаПроведения;
КонецФункции
	
&НаСервере
Процедура РаспределитьЗаймыВозвратыПоТЧ()
	Для каждого стр из Объект.РаспределениеПоФондам Цикл
		Если стр.ЗаймВозврат = Перечисления.ИА_ЗаймВозврат.Возврат Тогда
			Новстр = ВозвратыЗаймов.Добавить();
		Иначе
			Новстр = Займы.Добавить();
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(новстр, стр);
		новстр.сумма = стр.СуммаБезнал;
		новстр.НаФонд = стр.Фонд;
		новстр.НаПодразделение = стр.Подразделение;
	КонецЦикла;
КонецПроцедуры
	
&НаСервере
Процедура ОбновитьНадписьТБ()
	Если Объект.тб.Пустая() ТОгда
		Элементы.ОткрытьТБ.Видимость = ложь;
	Иначе
		Элементы.ОткрытьТБ.Видимость = истина;
