&НаСервереБезКонтекста
Функция  Сумма_ИА_СредстваВРезервеНаФондах(СуммаЗаказа,Заказ, СсылкаДок)
	
	СуммаТек = СуммаЗаказа;
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ЕСТЬNULL(СУММА(ИА_СредстваВРезервеНаФондахОбороты.СуммаБезналПриход), 0) КАК Сумма
	|ИЗ
	|	РегистрНакопления.ИА_СредстваВРезервеНаФондах.Обороты(, , Регистратор, ) КАК ИА_СредстваВРезервеНаФондахОбороты
	|ГДЕ
	|	ИА_СредстваВРезервеНаФондахОбороты.ЗП = &ЗП
	|	И ИА_СредстваВРезервеНаФондахОбороты.Регистратор <> &ТекДок";
	Запрос.УстановитьПараметр("ЗП", Заказ);
	Запрос.УстановитьПараметр("ТекДок", СсылкаДок);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СуммаТек = СуммаТек - Выборка.Сумма;
	КонецЦикла;
	Возврат СуммаТек;
КонецФункции

&НаСервереБезКонтекста
Функция ТекСтрокаЗаказФонд(Заказ)
	СтруктураЗВС = ИА_ФП.ВернутьСтатусЗВС(Заказ);
	Структура = Новый Структура("Фонд,ПредметЗаказа,Сумма,Статус,ВидДС,ИсходнаяСумма,ПричинаОтказа", Заказ.Фонд, Заказ.ПредметЗаказа,Заказ.Сумма, СтруктураЗВС.Статус,Заказ.ВидДС,Заказ.Сумма, СтруктураЗВС.ПричинаОтказа);
	Возврат Структура;
КонецФункции

&НаКлиенте 
Процедура ДеревоЗПЗаказПриИзменении(ТекСтрока)
	
	Если ЗначениеЗаполнено(ТекСтрока.Заказ) Тогда
		зак = ТекСтрока.Заказ;
		ДанныеЗаказа = ТекСтрокаЗаказФонд(зак);
		Если ДанныеЗаказа.Фонд <> ТекСтрока.Фонд Тогда
			Сообщить("У заказа другой фонд!");
			ТекСтрока.Заказ = ИА_ЗаказНаПриобретениеПустаяСсылка();
			Возврат;
		КонецЕсли;
		
		ТекСтрока.ПредметЗаказа = ДанныеЗаказа.ПредметЗаказа;
		ТекСтрока.ИсходнаяСумма = ДанныеЗаказа.ИсходнаяСумма;
		
		СуммаТек = Сумма_ИА_СредстваВРезервеНаФондах(ДанныеЗаказа.Сумма,зак, Объект.Ссылка);		
		ТекСтрока.Сумма = СуммаТек;
		
		ТекСтрока.Статус = ПредопределенноеЗначение("Перечисление.ИА_СостояниеЗаказа.РассмотретьНаФП");
		ТекСтрока.СтатусИсходный = ПредопределенноеЗначение("Перечисление.ИА_СостояниеЗаказа.РассмотретьНаФП");
		
		ТекСтрока.ОстатокПоЗаказу = ТекСтрока.Сумма;
		ТекСтрока.СтатусНомер = НомерСтатуса(ТекСтрока.Статус); 
	
		ТекСтрока.ПричинаОтказа = ДанныеЗаказа.ПричинаОтказа;
		
		ДеревоЗВСИзменение();
	КонецЕсли;
	
КонецПроцедуры

