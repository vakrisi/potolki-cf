	ОткрытьФорму("Документ.ИА_ФинансовоеПланирование.Форма.ФормаВыбораПечатнойФормы",,,,,, Новый ОписаниеОповещения("КомандаПечатьЗавершение", ЭтотОбъект), РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);

КонецПроцедуры

&НаКлиенте
Процедура КомандаПечатьЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Значение = Результат;
	
	Если Значение = "Состояние фондов" Тогда
		Если Не ЗначениеЗаполнено(Объект.Ссылка) или Модифицированность или не Объект.Проведен Тогда
			ПоказатьПредупреждение(,"Необходимо сначала записать и утвердить ФП!");
			Возврат;
		КонецЕсли;
		//тд = ИА_ФинансоваяДирективаРасшифровкаСоздать();
		//тд.Показать();
		ОткрытьФорму("Документ.ИА_ФинансовоеПланирование.Форма.ФормаОтчетПоФондам", Новый Структура("ЭтоСостояние",истина), ЭтаФорма);
	ИначеЕсли Значение = "Директива ФП" Тогда
		
		Если Не ЗначениеЗаполнено(Объект.Ссылка) или Модифицированность или не Объект.Проведен Тогда
			ПоказатьПредупреждение(,"Необходимо сначала записать и утвердить ФП!");
			Возврат;
		КонецЕсли;
		
		Если ФП_по_ТБ Тогда
			ТабДок = СформироватьПФ_ДирективаФП_ТБ(Объект.Ссылка);
		Иначе
			ТабДок = СформироватьПФ_ДирективаФП(Объект.Ссылка);
		КонецЕсли;
		иа_бфкс.ТабДок_Показать(ТабДок, "Печать (Директива ФП)");
		
		
	ИначеЕсли Значение = "ФП 1" Тогда
		Если Не ЗначениеЗаполнено(Объект.Ссылка) или Модифицированность Тогда
			ПоказатьПредупреждение(,"Необходимо сначала записать документ!");
			Возврат;
		КонецЕсли;
		
		тд = ИА_ФинансовоеПланирование1Создать();
		тд.Показать();		
	ИначеЕсли Значение = "Список ЗП" Тогда
		Если ДеревоЗП.ПолучитьЭлементы().Количество() =0 Тогда
			ПоказатьПредупреждение(,"Нет ЗП на ФП!");
			Возврат;
		КонецЕсли;
		
		тд = ПечатьСпискаЗВС();
		тд.Показать();		
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ПечатьСпискаЗВС()
	тд = Новый ТабличныйДокумент;
	макет = Документы.ИА_ФинансовоеПланирование.ПолучитьМакет("СписокЗВС");
	
	дер = РеквизитФормыВЗначение("ДеревоЗП");
	
	Если ВыводитьГруппировкуПоСчетам Тогда
		Для каждого стрСчет из дер.строки Цикл
			ВывестиОтделенияВСписокЗВС(стрСчет.Строки, макет, тд, ИспПодразделения);
		КонецЦикла;
	Иначе
		ВывестиОтделенияВСписокЗВС(дер.Строки, макет, тд, ИспПодразделения);
	КонецЕсли;
	
	тд.АвтоМасштаб = Истина;
	Возврат тд;
КонецФункции

&НаСервереБезКонтекста
Процедура ВывестиОтделенияВСписокЗВС(СтрокиОтд, макет, тд, ИспПодразделения)
	Для каждого стрОтд Из СтрокиОтд Цикл
		
		Если стрОтд.Строки.Итог("ИсходнаяСумма", истина) = 0 Тогда
			Продолжить;
		КонецЕсли;
			
		Если  ИспПодразделения Тогда
			ОблОтд = макет.ПолучитьОбласть("ШапкаОтделение");
			ОблОтд.Параметры.Отделение = стрОтд.Подразделение;
			тд.Вывести(ОблОтд);
		Иначе
			ОблОтд = макет.ПолучитьОбласть("ШапкаСтатья");
			ОблОтд.Параметры.Статья = стрОтд.фонд;
			тд.Вывести(ОблОтд);
			
			Для каждого стрЗВС из стрОтд.Строки Цикл
				ОблЗВС = макет.ПолучитьОбласть("Строка");
				ЗаполнитьЗначенияСвойств(ОблЗВС.Параметры, стрЗВС);
				
				тд.Вывести(ОблЗВС);
			КонецЦикла;
			
			Продолжить;
		КонецЕсли;

		
		Для каждого стрФонд из стрОтд.Строки Цикл
			
			Если стрФонд.Строки.Итог("ИсходнаяСумма", истина) = 0 Тогда
				Продолжить;
			КонецЕсли;
		
			ОблФонд = макет.ПолучитьОбласть("ШапкаСтатья");
			ОблФонд.Параметры.Статья = стрФонд.Фонд;
			тд.Вывести(ОблФонд);
			Для каждого стрЗВС из стрФонд.Строки Цикл
				ОблЗВС = макет.ПолучитьОбласть("Строка");
				ЗаполнитьЗначенияСвойств(ОблЗВС.Параметры, стрЗВС);
				
				тд.Вывести(ОблЗВС);
			КонецЦикла;
		КонецЦикла;
		
		тд.ВывестиГоризонтальныйРазделительСтраниц();
	КонецЦикла;
КонецПроцедуры


