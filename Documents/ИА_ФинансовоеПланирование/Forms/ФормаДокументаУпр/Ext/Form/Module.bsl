&НаСервереБезКонтекста
Функция ПолучитьЗначениеСтатистики(пВидСтатистики, пДатаНачала, пДатаКонца, ДопПарам) Экспорт
	
	ДатаНач = НачалоДня(пДатаНачала);
	ДатаКон = КонецДня(пДатаКонца);
	
	Данные = Новый ТаблицаЗначений;
	Данные.Колонки.Добавить("ДатаНачала");
	Данные.Колонки.Добавить("ДатаКонца");
	Новстр = Данные.Добавить();
	Новстр.ДатаНачала = ДатаНач;
	Новстр.ДатаКонца = ДатаКон;
	СтрокаСтатистик = Новый Структура("ВидСтатистики,Аналитика1,Аналитика2,Аналитика3,Данные",пВидСтатистики, Неопределено, Неопределено, Неопределено,Данные);
	
	ТЗ = ИА_Защита_Статистика.ПолучитьТЗДанныеСтатистики(СтрокаСтатистик,ДатаНач,ДатаКон, ДопПарам);
	
	возврат тз.Итог("Количество");
КонецФункции

