&НаКлиенте
Процедура ДеревоПолитикаСуммаПриИзменении(Элемент)
	ТекДанные = Элементы.ДеревоПолитика2.ТекущиеДанные; 
	
	Отбор = Новый Структура("Раздел, Подразделение, Статья");        
    ЗаполнитьЗначенияСвойств(Отбор, ТекДанные);    
    М = Объект.Политика2.НайтиСтроки(Отбор);
    Для каждого СтрП1 Из М Цикл
        СтрП1.Сумма = ТекДанные.Сумма;
        СтрП1.Вручную = Истина;
    КонецЦикла;  
    
	ЗаполнитьДоходыИПолитикиСервер(ложь, ложь,ложь,истина, ложь, истина);
	Политика_Развернуть(2,Отбор);
	
КонецПроцедуры

&НаКлиенте
Функция ПолучитьСтрокуПолитика(раздел, фонд, подразделение, НомерПолитики)
	Если НомерПолитики = 1 Тогда
		дер = ДеревоПолитика1;
	Иначе
		дер = ДеревоПолитика2;
	КонецЕсли;
	
	Для каждого стрРаздел из дер.ПолучитьЭлементы() Цикл
		Если стрРаздел.раздел = раздел Тогда
			Если ИспользоватьРазделы Тогда
				Для каждого стрФонд из стрРаздел.ПолучитьЭлементы() Цикл
					Если стрФонд.Статья = фонд И стрФонд.подразделение = подразделение Тогда
						Возврат стрФонд.ПолучитьИдентификатор();
					КонецЕсли;			
				КонецЦикла;
			Иначе
				Если стрРаздел.Статья = фонд И стрРаздел.подразделение = подразделение Тогда
					Возврат стрРаздел.ПолучитьИдентификатор();
				КонецЕсли;			
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Неопределено;
КонецФункции

&НаКлиенте
Процедура ДеревоЗПСтатусПриИзменении(Элемент)
	
	тд = Элементы.ДеревоЗП.ТекущиеДанные;
	Если СостояниеЗаказаОдобренКлиент.Найти(тд.Статус) <> Неопределено тогда
		тд.УтвержденнаяСумма = тд.Сумма;
	Иначе
		тд.УтвержденнаяСумма = 0;
	КонецЕсли;
	
	тд.ОстатокПоЗаказу = тд.Сумма - тд.УтвержденнаяСумма;
	тд.СтатусНомер = НомерСтатуса(тд.Статус);    
КонецПроцедуры

&НаКлиенте
Процедура СохранитьДеревоЗаказов()
	Объект.ЗаказыНаПриобретение.Очистить();
	ЗаполнитьСтрокиЗаказыНаПриобретение(ДеревоЗП.ПолучитьЭлементы());
КонецПроцедуры
	
&НаКлиенте
Процедура ЗаполнениеТаблЧастей()
	
	// спец доход
	Для каждого стр из Объект.ДоходыБП Цикл
		Если не ЗначениеЗаполнено(стр.Период) Тогда
			стр.Период = Объект.Дата;
		КонецЕсли;
	КонецЦикла;
	
	//Займы
	Для каждого стр из Объект.РаспределениеПоФондам Цикл
		Если ТипЗнч(стр.ПричинаЗайма) = тип("Строка") Тогда
			стр.ПричинаЗайма = СокрЛП(стр.ПричинаЗайма);
		КонецЕсли;
	КонецЦикла;
	
	//
	
	Объект.НачисленияВФонды.Очистить();
	Объект.ПланПродаж.Очистить();
	Объект.ЗНО.Очистить();
	
	СохранитьДеревоЗаказов();
	
	// статусы зно	
	Для каждого стр из ТаблицаЗНО Цикл
		Новстр = Объект.ЗНО.Добавить();
		ЗаполнитьЗначенияСвойств(новстр, стр);
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьСтрокиЗаказыНаПриобретение(СтрокиЗП)
	
	Для каждого СтрокаЗП из СтрокиЗП ЦИкл   
		
		Если ЗначениеЗаполнено(СтрокаЗП.Заказ) Тогда
			
			СтрокаЗаказыНаПриобретение = Объект.ЗаказыНаПриобретение.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаЗаказыНаПриобретение, СтрокаЗП);
			
		ИначеЕсли ЗначениеЗаполнено(СтрокаЗП.Фонд) Тогда 	
			
			Если СтрокаЗП.НачислениеВФонд > 0 Тогда
				СтрокаНачисленияВФонды = Объект.НачисленияВФонды.Добавить();
				СтрокаНачисленияВФонды.Фонд          = СтрокаЗП.Фонд;
				СтрокаНачисленияВФонды.Подразделение = СтрокаЗП.Подразделение;
				СтрокаНачисленияВФонды.СуммаБезНал   = СтрокаЗП.НачислениеВФонд; 
			КонецЕсли;	
			ЗаполнитьСтрокиЗаказыНаПриобретение(СтрокаЗП.ПолучитьЭлементы());
		Иначе
			
			ЗаполнитьСтрокиЗаказыНаПриобретение(СтрокаЗП.ПолучитьЭлементы())	
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Функция естьОшибкиПревышенияПоЗаказам(СтрокиДер)
	ЕстьОш = ложь;
	Для каждого стр из СтрокиДер цикл
		Если ЗначениеЗаполнено(стр.заказ) и стр.ОстатокПоЗаказу < 0 тогда
			Сообщить("Обнаружено превышение доступной суммы для одобрения по заказу "+стр.Номер + " """ + стр.ПредметЗаказа + """, фонд " + стр.Фонд);
			ЕстьОш = истина;
		КонецЕсли;
		
		Если естьОшибкиПревышенияПоЗаказам(стр.ПолучитьЭлементы()) Тогда
			ЕстьОш = истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат ЕстьОш;
КонецФункции

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)	
	
	Если ПараметрыЗаписи.Режимзаписи = РежимЗаписиДокумента.Проведение и объект.Дата > КонецДня(ТекущаяДата()) ТОгда		
		ПоказатьПредупреждение(,"ФП можно сохранять как черновик с датой будущего периода. Но утверждать ФП можно не позднее текущей даты (сегодняшней даты). Измените дату ФП и повторите операцию, если вы действительно решили утвердить ФП.");
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	// проверка на превышение по заказам
	Если ПараметрыЗаписи.Режимзаписи = РежимЗаписиДокумента.Проведение ТОгда		
		Если естьОшибкиПревышенияПоЗаказам(ДеревоЗП.ПолучитьЭлементы()) Тогда
			Отказ = Истина;
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	ЗаполнениеТаблЧастей();
	
	// проверка займов
	Если ПараметрыЗаписи.Режимзаписи = РежимЗаписиДокумента.Проведение ТОгда
		Для каждого стр из Объект.РаспределениеПоФондам Цикл
			Если стр.Фонд.Пустая() или стр.СФонда.Пустая() или ((стр.Подразделение.Пустая() или стр.СПодразделения.Пустая()) и ИспПодразделения) Тогда
				ПоказатьПредупреждение(,"Заполните правильно перемещение между фондами! Должны быть заполнены фонды" + ?(ИспПодразделения, " и подразделения",""));
				Отказ = Истина;
				Возврат;
			КонецЕсли;			
		КонецЦикла;
		
		Если ЕстьМинус тогда
			ПоказатьПредупреждение(,"Невозможно утвердить ФП с минусовыми фондами!");
			Отказ = Истина;
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	
	Если ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения или ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
		Если ИА_ФПСервер.естьБудущиеДоки(Объект.организация, Объект.дата) Тогда
			отказ = Истина;
			парамФ_1 = Новый структура("Период, Организация, Действие", объект.Дата, объект.Организация);
			парамФ_1.Действие = ?(ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения, "отмены", "утверждения");
			ОткрытьФорму("ОбщаяФорма.КСУ_ПредупреждениеПриОтменеПроведения", парамФ_1, ЭтаФорма,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		КонецЕсли;
	КонецЕсли;
	
	// проверка коммента в откладывании
	Если ПараметрыЗаписи.Режимзаписи = РежимЗаписиДокумента.Проведение ТОгда
		Для каждого стр из Объект.ОтложенныйДоход Цикл
			Если стр.ТипОперации = ПредопределенноеЗначение("Перечисление.КСУ_ОперацииСОтложеннымДоходом.Отложить") и стр.Комментарий = "" Тогда
				ПоказатьПредупреждение(,"Укажите комментарий в таблице отложенного дохода для операции откладывания с дохода "+стр.ВидДохода);
				Отказ = Истина;
				Возврат;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

    
КонецПроцедуры
	
&НаКлиенте
Процедура ДеревоЗППриИзменении(Элемент)	
	
	Если Элемент.ТекущийЭлемент.Имя = "ДеревоЗПВыбрать" Тогда
		возврат;
	КонецЕсли;
	
	тд = Элементы.ДеревоЗП.ТекущиеДанные;	
	Если Элементы.ДеревоЗПАвтоначисление.Пометка И Найти(Элемент.ТекущийЭлемент.Имя,"Начисление")=0 и ЗначениеЗаполнено(тд.Заказ) и тд.Счет = ПредопределенноеЗначение("Справочник.ИА_Счета.ГлавныйСчет") Тогда
		тд.ПолучитьРодителя().НачислениеВФонд = 0;
		ПересчитатьДерево();
		ПересчитатьСальдоСредствКРаспределению();
		
		ДоначислитьАвтоматически();	
	КонецЕсли;
	
	ДеревоЗВСИзменение();
	Модифицированность = истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоЗВСИзменение()	
		
	Модифицированность = Истина;
	ПересчитатьДерево();
	ПересчитатьСальдоСредствКРаспределению();
	ОбновитьОтчетПоСотояниюФондов();
	
	ПредВыдОбл = Неопределено;
	ДеревоЗППриАктивизацииСтроки(Неопределено);	
КонецПроцедуры


&НаСервере
Процедура ДоначислитьАвтоматически()
	
	тд = ДеревоЗП.НайтиПоИдентификатору(Элементы.ДеревоЗП.ТекущаяСтрока);	
	ЕстьОшибка = ложь;
	НехваткаСуммы = 0;
	
	ОбновитьОтчетПоСотояниюФондов(ложь);
	СтрПоиска = Новый Структура("Счет,Фонд,Подразделение", тд.Счет, тд.Фонд, тд.Подразделение);
	Если не ВыводитьГруппировкуПоСчетам Тогда
		СтрПоиска.Удалить("Счет");
	КонецЕсли;

	НСтроки = ВыходнаяТаблица.НайтиСтроки(СтрПоиска); 
	Если НСтроки.Количество()>0 Тогда
		СтрокаСостояния = НСтроки[0];
		Если СтрокаСостояния.ПослеФП_Остаток < 0 Тогда
			ЕстьОшибка = Истина;
			НехваткаСуммы = -СтрокаСостояния.ПослеФП_Остаток; 
		КонецЕсли;
	КонецЕсли;
	
	СтрРод = тд.ПолучитьРодителя();
	Если ЕстьОшибка Тогда
		Добавим = мин(НехваткаСуммы,Объект.СальдоСредствКРаспределениюБезнал);

		СтрРод.НачислениеВФонд =СтрРод.НачислениеВФонд + Добавим;
	КонецЕсли;

	
КонецПроцедуры

&НаКлиенте
Процедура ВыделитьСтрокуВостатках() Экспорт
	тдЗаказы = Элементы.ДеревоЗП.ТекущиеДанные;
	
	ТекСтрокиОст = ДеревоСостояниеФондов.ПолучитьЭлементы();
	Если ВыводитьГруппировкуПоСчетам Тогда
		СтрокаНайдена = ложь;
		
		Для каждого стр из ТекСтрокиОст Цикл 
			если стр.СчетПодразделениеФонд = тдЗаказы.Счет Тогда
				ТекСтрокиОст = стр.ПолучитьЭлементы();	
				СтрокаНайдена = истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;      
		
		Если не СтрокаНайдена Тогда
			возврат;
		КонецЕсли;
	КонецЕсли;
	
	Если ИспПодразделения Тогда
		СтрокаНайдена = ложь;
		
		Для каждого стр из ТекСтрокиОст Цикл 
			если стр.СчетПодразделениеФонд = тдЗаказы.Подразделение Тогда
				ТекСтрокиОст = стр.ПолучитьЭлементы();	
				СтрокаНайдена = истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;      
		
		Если не СтрокаНайдена Тогда
			возврат;
		КонецЕсли;
	КонецЕсли;
	
	Для каждого стр из ТекСтрокиОст Цикл 
		если стр.СчетПодразделениеФонд = тдЗаказы.Фонд Тогда
			НеПозиционировать = истина;
			Элементы.ДеревоСостояниеФондов.ТекущаяСтрока = стр.ПолучитьИдентификатор();
			Возврат;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры
	
