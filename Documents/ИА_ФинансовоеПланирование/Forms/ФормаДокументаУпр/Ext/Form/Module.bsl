		фк = СтрДерП1["Сумма"+НомерТекущейНедели];
		Обл.Параметры.НедельныйПлан = пл;
		Обл.Параметры.НедельныйФакт = фк;
		Если пл > 0 Тогда
			Обл.Параметры.ПроцентНедельный = фк / пл * 100;
		КонецЕсли;
		ТабДок.Вывести(обл);
		
		// итого к распределению
		СтрДерИтогоКРаспр = ПолучитьСтрокуПоТипуСтроки(ДеревоРасходы, Перечисления.КСУ_ВидыСтрокТБ.ИтогКЗаливке);
		Если тз_ПредДанных.Количество() = 0 Тогда
			Обл = Макет.ПолучитьОбласть("ИтогоКРаспределению1");
			Обл.Параметры.Сумма = СтрДерИтогоКРаспр["Сумма"+НомерТекущейНедели];
			ТабДок.Вывести(обл);
		Иначе
			Обл = Макет.ПолучитьОбласть("ИтогоКРаспределению2");
			Обл.Параметры.Сумма = СтрДерИтогоКРаспр["Сумма"+НомерТекущейНедели] ;
			Обл.Параметры.СуммаТекФП = СтрДерИтогоКРаспр["Сумма"+НомерТекущейНедели] - тз_ПредДанных[0].ИтогоВЗаливку;
			ТабДок.Вывести(обл);
		КонецЕсли;
		
		//// Постоянные расходы
		Обл = Макет.ПолучитьОбласть("ПостоянныеРасхШапка");
		ТабДок.Вывести(обл);
		СтрДерП1 = ПолучитьСтрокуПоТипуСтроки(ДеревоРасходы, Перечисления.КСУ_ВидыСтрокТБ.ПостоянныеРасходы);
		Для каждого стр из СтрДерП1.Строки Цикл
			Обл = Макет.ПолучитьОбласть("ПостоянныеРасхСтрока" + ?(ИспПодразделения, "Подр", ""));
			ЗаполнитьЗначенияСвойств(Обл.Параметры, стр);
			пл = стр["СуммаПоФП"+НомерТекущейНедели];
			фк = стр["Сумма"+НомерТекущейНедели];
			Обл.Параметры.НедельныйПлан = пл;
			Обл.Параметры.НедельныйФакт = фк;
			Если пл > 0 Тогда
				Обл.Параметры.ПроцентНедельный = фк / пл * 100;
			КонецЕсли;
			ТабДок.Вывести(обл);
		КонецЦикла;
		Обл = Макет.ПолучитьОбласть("ПостоянныеРасхИтого");
		ЗаполнитьЗначенияСвойств(Обл.Параметры, СтрДерП1);
		Обл.Параметры.Фонд = "ИТОГО:";
		пл = СтрДерП1["СуммаПоФП"+НомерТекущейНедели];
		фк = СтрДерП1["Сумма"+НомерТекущейНедели];
		Обл.Параметры.НедельныйПлан = пл;
		Обл.Параметры.НедельныйФакт = фк;
		Если пл > 0 Тогда
			Обл.Параметры.ПроцентНедельный = фк / пл * 100;
		КонецЕсли;
		ТабДок.Вывести(обл);
		
		для счН = НомерТекущейНедели + 1 По КолНед -1 Цикл
			фк = фк + СтрДерП1["Сумма"+счН];
		КонецЦикла;
		
		Если пл <> фк Тогда
			Обл = Макет.ПолучитьОбласть("ПерелиНедолив");
			Обл.Параметры.Перелив = ?(пл > фк, "Недолив", "Перелив");			
			Если тз_ПредДанных.Количество()>0 Тогда
				Обл.Параметры.ТекстСуммарно = "(суммарно с начала недели)"; 
			КонецЕсли;
			Обл.Параметры.Сумма = ?(пл > фк, пл - фк, фк - пл);
			ТабДок.Вывести(обл);
		КонецЕсли;
		
	КонецЕсли;
	
	////// ПЕРМЕЩЕНИЯ
	
	Обл = Макет.ПолучитьОбласть("ПеремШапка");
	ТабДок.Вывести(обл);
	Если ИспПодразделения Тогда
		Обл = Макет.ПолучитьОбласть("ПеремШапкаПодр");
	Иначе
		Обл = Макет.ПолучитьОбласть("ПеремШапкаТ");
	КонецЕсли;
	ТабДок.Вывести(обл);	
	Для каждого стр из Объект.РаспределениеПоФондам Цикл
		Если ИспПодразделения Тогда
			Обл = Макет.ПолучитьОбласть("ПеремСтрокаПодр");
		Иначе
			Обл = Макет.ПолучитьОбласть("ПеремСтрока");
		КонецЕсли;
		ЗаполнитьЗначенияСвойств(Обл.Параметры, стр);
		ТабДок.Вывести(обл);
	КонецЦикла;
	Обл = Макет.ПолучитьОбласть("ПеремИтого");
	Обл.Параметры.СФонда = "ИТОГО:";
	Обл.Параметры.СуммаБезнал = Объект.РаспределениеПоФондам.итог("СуммаБезнал");
	ТабДок.Вывести(обл);
	
	
	///////////////// ЗАКАЗЫ
	
	Обл = Макет.ПолучитьОбласть("ЗаказыШапка");
	ТабДок.Вывести(обл);	
	Запрос.Текст = "ВЫБРАТЬ
	               |	ИА_ФинансовоеПланированиеЗаказыНаПриобретение.Заказ.Номер КАК Номер,
	               |	ИА_ФинансовоеПланированиеЗаказыНаПриобретение.Заказ.Сумма КАК Сумма,
	               |	ИА_ФинансовоеПланированиеЗаказыНаПриобретение.УтвержденнаяСумма КАК УтвержденнаяСумма,
	               |	ИА_ФинансовоеПланированиеЗаказыНаПриобретение.Заказ.ПредметЗаказа КАК ПредметЗаказа,
	               |	ИА_ФинансовоеПланированиеЗаказыНаПриобретение.Заказ.Фонд КАК Фонд,
	               |	ИА_ФинансовоеПланированиеЗаказыНаПриобретение.Заказ.Подразделение КАК Подразделение,
	               |	ИА_ФинансовоеПланированиеЗаказыНаПриобретение.Статус КАК Статус,
	               |	ИА_ФинансовоеПланированиеЗаказыНаПриобретение.СтатусИсходный КАК СтатусИсходный,
	               |	ИА_ФинансовоеПланированиеЗаказыНаПриобретение.Заказ.Сумма КАК ЗаказСумма,
	               |	ЕСТЬNULL(ИА_СредстваВРезервеНаФондахОбороты.СуммаБезналПриход, 0) КАК ОдобреноРанее,
	               |	ЕСТЬNULL(ИА_СредстваВРезервеНаФондахОбороты.СуммаБезналРасход, 0) КАК ВыплаченоРанее,
	               |	ИА_ФинансовоеПланированиеЗаказыНаПриобретение.Заказ.ВидДССправочно КАК ЗаказВидДССправочно
	               |ИЗ
	               |	Документ.ИА_ФинансовоеПланирование.ЗаказыНаПриобретение КАК ИА_ФинансовоеПланированиеЗаказыНаПриобретение
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ИА_СредстваВРезервеНаФондах.Обороты(,&ДатаДок) КАК ИА_СредстваВРезервеНаФондахОбороты
	               |		ПО ИА_ФинансовоеПланированиеЗаказыНаПриобретение.Заказ = ИА_СредстваВРезервеНаФондахОбороты.ЗП
	               |ГДЕ
	               |	ИА_ФинансовоеПланированиеЗаказыНаПриобретение.Ссылка = &Ссылка
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Подразделение,
	               |	Фонд";
	Запрос.УстановитьПараметр("Ссылка", Объект.Ссылка);
	Запрос.УстановитьПараметр("ДатаДок", Объект.Дата -1 );
	
	тз = запрос.Выполнить().Выгрузить();
	Если не  ИспПодразделения тогда
		тз.Сортировать("Фонд");
	КонецЕсли;
	
	СтатусыОдобрено     = ИА_ФП.СтатусыОдобрено();
	
	// отклоненные заказы
	
	ПредФонд = Неопределено;
	ПредПодр = Неопределено;
	ИтогСумма = 0;
	Для каждого Выборка из тз Цикл
		Если Выборка.Статус = Перечисления.ИА_СостояниеЗаказа.Отклонен Тогда
			Если ИспПодразделения И ПредПодр <> выборка.Подразделение Тогда
				Обл = Макет.ПолучитьОбласть("ЗаказыСтрокаФонд");
				обл.Параметры.Фонд = Выборка.Подразделение;
				
				ОтборИтогов = новый Структура("Подразделение", выборка.Подразделение);
				итДанные = ИтогТЗ(тз, ОтборИтогов, ложь);
				ЗаполнитьЗначенияСвойств(обл.Параметры, итДанные);
				
				ТабДок.Вывести(обл);
				
				ПредПодр = Выборка.Подразделение;
				
				////////////////////
				
				Обл = Макет.ПолучитьОбласть("ЗаказыСтрокаФонд");
				обл.Параметры.Фонд = ?(ИспПодразделения, "  -", "") + Выборка.Фонд;
				
				ОтборИтогов = новый Структура("Подразделение, Фонд", выборка.Подразделение, Выборка.Фонд );
				итДанные = ИтогТЗ(тз, ОтборИтогов, ложь);
				ЗаполнитьЗначенияСвойств(обл.Параметры, итДанные);
				
				ТабДок.Вывести(обл);
				
				ПредФонд = Выборка.Фонд;
			ИначеЕсли ПредФонд <> выборка.фонд Тогда
				
				Отбор = Новый Структура("Фонд", выборка.фонд);
				Если ИспПодразделения Тогда
					Отбор.Вставить("Подразделение", выборка.Подразделение);
				КонецЕсли;
				итДанные = ИтогТЗ(тз, Отбор, ложь);				
				
				Обл = Макет.ПолучитьОбласть("ЗаказыСтрокаФонд");
				обл.Параметры.Фонд = ?(ИспПодразделения, "  -", "") + Выборка.Фонд;
				ЗаполнитьЗначенияСвойств(обл.Параметры, итДанные);
				ТабДок.Вывести(обл);
				
				ПредФонд = Выборка.Фонд;
			КонецЕсли;
			
			Обл = Макет.ПолучитьОбласть("ЗаказыСтрока");
			ЗаполнитьЗначенияСвойств(Обл.Параметры, выборка);
			обл.Параметры.номер = формат(число(Выборка.номер),"ЧДЦ=0; ЧГ=");
			ТабДок.Вывести(обл);
			
			ИтогСумма = ИтогСумма +Выборка.ЗаказСумма;
		КонецЕсли;
	КонецЦикла;
	Обл = Макет.ПолучитьОбласть("ЗаказыСтрокаИтого");
	Обл.Параметры.ЗаказСумма = ИтогСумма;
	ТабДок.Вывести(обл);
	
	// одобренные заказы
	
	Обл = Макет.ПолучитьОбласть("ОдобрЗаказыШапка");
	СправочноНалБезнал = Константы.ИА_ФП_ИспользоватьВидДССправочно.Получить();
	Если СправочноНалБезнал Тогда
		Обл.Параметры.Безнал = "(безналичный расчет)";
	КонецЕсли;
	ТабДок.Вывести(обл);	
	
	ПредФонд = Неопределено;
	ПредПодр = Неопределено;
	ИтогСумма = 0;
	
	Для каждого Выборка из тз Цикл
		Если Выборка.УтвержденнаяСумма > 0 И (Выборка.ЗаказВидДССправочно = Перечисления.ИА_ВидДенежныхСредств.Безналичные ИЛИ Выборка.ЗаказВидДССправочно = Перечисления.ИА_ВидДенежныхСредств.ПустаяСсылка() ИЛИ СправочноНалБезнал = ложь) Тогда
			Если ИспПодразделения И ПредПодр <> выборка.Подразделение Тогда
				Обл = Макет.ПолучитьОбласть("ОдобрЗаказыФонд");
				обл.Параметры.Фонд = Выборка.Подразделение;
				
				ОтборИтогов = новый Структура("Подразделение", выборка.Подразделение);
				Если СправочноНалБезнал тогда
					ОтборИтогов.Вставить("ЗаказВидДССправочно", Перечисления.ИА_ВидДенежныхСредств.Безналичные);
				КонецЕсли;
				итДанные = ИтогТЗ(тз, ОтборИтогов);
				
				Если СправочноНалБезнал тогда
					ОтборИтогов.ЗаказВидДССправочно = Перечисления.ИА_ВидДенежныхСредств.ПустаяСсылка();
					итДанные1 = ИтогТЗ(тз, ОтборИтогов);
					итДанные.ЗаказСумма = итДанные.ЗаказСумма + итДанные1.ЗаказСумма;
					итДанные.УтвержденнаяСумма = итДанные.УтвержденнаяСумма + итДанные1.УтвержденнаяСумма;
				КонецЕсли;
				
				ЗаполнитьЗначенияСвойств(обл.Параметры, итДанные);
				
				ТабДок.Вывести(обл);
				
				ПредПодр = Выборка.Подразделение;
				
				///////////////
				
				Обл = Макет.ПолучитьОбласть("ОдобрЗаказыФонд");
				обл.Параметры.Фонд = ?(ИспПодразделения, "  -", "") + Выборка.Фонд;
								
				ОтборИтогов.Вставить("Фонд", Выборка.Фонд);
				итДанные = ИтогТЗ(тз, ОтборИтогов);
				ЗаполнитьЗначенияСвойств(обл.Параметры, итДанные);
				
				ТабДок.Вывести(обл);
				
				ПредФонд = Выборка.Фонд;
			ИначеЕсли ПредФонд <> выборка.фонд Тогда				
				
				Обл = Макет.ПолучитьОбласть("ОдобрЗаказыФонд");
				обл.Параметры.Фонд = ?(ИспПодразделения, "  -", "") + Выборка.Фонд;
				
				ОтборИтогов = новый Структура("Фонд", выборка.фонд);
				Если СправочноНалБезнал тогда
					ОтборИтогов.Вставить("ЗаказВидДССправочно", Перечисления.ИА_ВидДенежныхСредств.Безналичные);
				КонецЕсли;
				
				Если ИспПодразделения тогда
					ОтборИтогов.Вставить("Подразделение", выборка.Подразделение);
				КонецЕсли;
				итДанные = ИтогТЗ(тз, ОтборИтогов);
				
				Если СправочноНалБезнал тогда
					ОтборИтогов.ЗаказВидДССправочно = Перечисления.ИА_ВидДенежныхСредств.ПустаяСсылка();
					итДанные1 = ИтогТЗ(тз, ОтборИтогов);
					итДанные.ЗаказСумма = итДанные.ЗаказСумма + итДанные1.ЗаказСумма;
					итДанные.УтвержденнаяСумма = итДанные.УтвержденнаяСумма + итДанные1.УтвержденнаяСумма;
				КонецЕсли;
				
				ЗаполнитьЗначенияСвойств(обл.Параметры, итДанные);
				
				ТабДок.Вывести(обл);
				
				ПредФонд = Выборка.Фонд;
			КонецЕсли;
			
			Обл = Макет.ПолучитьОбласть("ОдобрЗаказыСтрока");
			ЗаполнитьЗначенияСвойств(Обл.Параметры, выборка);
			обл.Параметры.номер = формат(число(Выборка.номер),"ЧДЦ=0; ЧГ=");
			ТабДок.Вывести(обл);
			
			ИтогСумма = ИтогСумма +Выборка.УтвержденнаяСумма;
		КонецЕсли;
	КонецЦикла;
	Обл = Макет.ПолучитьОбласть("ОдобрЗаказыСтрокаИтого");
	Обл.Параметры.УтвержденнаяСумма = ИтогСумма;
	Если СправочноНалБезнал Тогда
		Обл.Параметры.Безнал = "(безналичный расчет)";
	КонецЕсли;
	ТабДок.Вывести(обл);
	
	Если СправочноНалБезнал Тогда
		Обл = Макет.ПолучитьОбласть("ОдобрЗаказыШапка");
		Обл.Параметры.Безнал = "(наличный расчет)";
		ТабДок.Вывести(обл);	
		
		ПредФонд = Неопределено;
		ПредПодр = Неопределено;
		ИтогСумма = 0;
		
		Для каждого Выборка из тз Цикл
			Если Выборка.УтвержденнаяСумма > 0 И Выборка.ЗаказВидДССправочно = Перечисления.ИА_ВидДенежныхСредств.Наличные Тогда
				Если ИспПодразделения И ПредПодр <> выборка.Подразделение Тогда
					Обл = Макет.ПолучитьОбласть("ОдобрЗаказыФонд");
					обл.Параметры.Фонд = Выборка.Подразделение;
					
					ОтборИтогов = новый Структура("Подразделение, ЗаказВидДССправочно", выборка.Подразделение, Перечисления.ИА_ВидДенежныхСредств.Наличные);				
					итДанные = ИтогТЗ(тз, ОтборИтогов);
					ЗаполнитьЗначенияСвойств(обл.Параметры, итДанные);
				
					ТабДок.Вывести(обл);
					
					ПредПодр = Выборка.Подразделение;
					
					///////////
					
					Обл = Макет.ПолучитьОбласть("ОдобрЗаказыФонд");
					обл.Параметры.Фонд = ?(ИспПодразделения, "  -", "") + Выборка.Фонд;
					
					ОтборИтогов.Вставить("Фонд", Выборка.Фонд);
					итДанные = ИтогТЗ(тз, ОтборИтогов);
					ЗаполнитьЗначенияСвойств(обл.Параметры, итДанные);
					
					ТабДок.Вывести(обл);
					
					ПредФонд = Выборка.Фонд;
				ИначеЕсли ПредФонд <> выборка.фонд Тогда					
					
					Обл = Макет.ПолучитьОбласть("ОдобрЗаказыФонд");
					обл.Параметры.Фонд = ?(ИспПодразделения, "  -", "") + Выборка.Фонд;
					
					ОтборИтогов = новый Структура("Фонд", выборка.фонд);
					Если СправочноНалБезнал тогда
						ОтборИтогов.Вставить("ЗаказВидДССправочно", Перечисления.ИА_ВидДенежныхСредств.Наличные);
					КонецЕсли;
					Если ИспПодразделения тогда
						ОтборИтогов.Вставить("Подразделение", выборка.Подразделение);
					КонецЕсли;
					итДанные = ИтогТЗ(тз, ОтборИтогов);
					ЗаполнитьЗначенияСвойств(обл.Параметры, итДанные);
					
					ТабДок.Вывести(обл);
					
					ПредФонд = Выборка.Фонд;
				КонецЕсли;
				
				Обл = Макет.ПолучитьОбласть("ОдобрЗаказыСтрока");
				ЗаполнитьЗначенияСвойств(Обл.Параметры, выборка);
				обл.Параметры.номер = число(Выборка.номер);
				ТабДок.Вывести(обл);
				
				ИтогСумма = ИтогСумма +Выборка.УтвержденнаяСумма;
			КонецЕсли;
		КонецЦикла;
		Обл = Макет.ПолучитьОбласть("ОдобрЗаказыСтрокаИтого");
		Обл.Параметры.Безнал = "(наличный расчет)";
		Обл.Параметры.УтвержденнаяСумма = ИтогСумма;
		ТабДок.Вывести(обл);
	КонецЕсли;
		
	Обл = Макет.ПолучитьОбласть("Подвал");
	ТабДок.Вывести(обл);
	
	ТабДок.АвтоМасштаб = Истина;
    Возврат ТабДок;
КонецФункции

&НаСервереБезКонтекста
Функция ИтогТЗ(тз, отбор, Утвержденные = истина)
	Если Утвержденные = ложь тогда
		отбор.вставить("статус", Перечисления.ИА_СостояниеЗаказа.Отклонен);
	КонецЕсли;
	
	Нстр = тз.НайтиСтроки(Отбор);				
	ИтСумма = 0;
	УтвСумма = 0;
	Для каждого стН из Нстр Цикл
		Если Утвержденные и стН.УтвержденнаяСумма = 0 Тогда
			Продолжить;
		КонецЕсли;
		ИтСумма = ИтСумма + стН.ЗаказСумма;
		УтвСумма = УтвСумма + стН.УтвержденнаяСумма;
	КонецЦикла;
	Возврат новый Структура("ЗаказСумма, УтвержденнаяСумма", ИтСумма, УтвСумма);
КонецФункции
	
	
&НаСервере
Функция СформироватьПФ_ДирективаФП(ДокФП) 
    ТабДок = Новый ТабличныйДокумент;
    
    #ЕСЛИ НЕ( Клиент или Сервер или ВнешнееСоединение ) Тогда
        ДокФП = Документы.ИА_ФинансовоеПланирование.ПустаяСсылка();
    #КОНЕЦЕСЛИ
    
    ПЗ = Новый Структура("МВ, МВВключая"
    , ДокФП.МоментВремени()
    , Новый Граница(ДокФП.МоментВремени(), ВидГраницы.Включая)
    );
    
    Данные_ДС = ПолучитьОстатокДС();
    Данные_ФП = ИА_ФПСервер.ФП_ПолучитьОстаткиНаФондах(ПЗ.МВВключая, ДокФП.Организация);
    
    отЧисло = ИА_БФКС.ОТ_Число(15, 2);
    
    ТабОформления = ИА_БФС.ТЗ_Создать("Имя,Заголовок,ТипЗначения, Ресурс"
    ,"Сумма", "Сумма", отЧисло, Истина
    ,"ВидДохода", "Вид дохода", Неопределено, Неопределено
    ,"ВидДоходаПолучатель", "Вид дохода-получатель", Неопределено, Неопределено
    );
    
    ТабОформленияБезИтогов = ИА_БФС.ТЗ_Создать("Имя,Заголовок,ТипЗначения, Ресурс"
    ,"Сумма", "Сумма", отЧисло, Ложь
    ,"ВидДохода", "Вид дохода", Неопределено, Неопределено
    ,"ВидДоходаПолучатель", "Вид дохода-получатель", Неопределено, Неопределено
    );
    
    МакетОформления = "Море";
    НастройкаОформления          = Новый Структура("МакетОформления, Поля", МакетОформления, ТабОформления);
    НастройкаОформленияБезИтогов = Новый Структура("МакетОформления, Поля", МакетОформления, ТабОформленияБезИтогов);
    НастройкаОформленияБезШапки  = Новый Структура("МакетОформления, Поля, СкрытьШапку", МакетОформления, 
    ИА_БФС.ТЗ_Создать("Имя, Заголовок, ТипЗначения, Ресурс"
    ,"Значение", "Значение", отЧисло, Ложь)
    );
    
    //{ Заголовок
    ДатаНачалаОтчета =  ?(ДокФП.НачалоПланирования, ДокФП.Дата, ДокФП.Дата + 60*60*24);
    ДатаНачала = Формат(ДатаНачалаОтчета, "ДФ='dd MMMM yyyy ""г.""'");    
    ДатаКонца = Формат(ДатаНачалаОтчета + 60*60*24*6 , "ДФ='dd MMMM yyyy ""г.""'");
    Заголовок = "Директива ФП №" + СокрЛП(ДокФП.Номер) + " за период с " + Формат(ДатаНачала, "ДЛФ=DD") + " по " + Формат(ДатаКонца, "ДЛФ=DD");
    //}
    
    ВывестиЗаголовок(ТабДок, Заголовок, ДокФП);
    
    // Денежные средства
    Таб_ПослеФП = ИА_БФС.ТЗ_Создать("Наименование, Сумма", "Остаток ДС после ФП", Данные_ДС.СуммаНал + Данные_ДС.СуммаБезНал, "Остаток по фондам после ФП", Данные_ФП.ОстатокВсего-Данные_ФП.ОстатокРезерв, "     в т.ч. Зарезервировано", Данные_ФП.ОстатокРезерв);
    Вывести_ТЗ_ВТабДок(Таб_ПослеФП, ТабДок, "Денежные средства", НастройкаОформленияБезИтогов); 
    
    // Доходы
    Таб_Доходы = ИА_БФС.ТЗ_НоваяТаблицаЗначений("ВидДохода, Сумма");
    Для каждого Стр Из ДокФП.Доходы Цикл
        НовСтрока = Таб_Доходы.Добавить();
        ЗаполнитьЗначенияСвойств(НовСтрока, Стр);
        НовСтрока.Сумма = Стр.СуммаБезнал + Стр.СуммаНал;
    КонецЦикла;  
    ИА_БФС.ТЗ_УдалитьСтрокиПоУсловию(Таб_Доходы, "СтрокаТЗ.Сумма = 0");
    Вывести_ТЗ_ВТабДок(Таб_Доходы, ТабДок, "Доход от поступления ДС за неделю", НастройкаОформления); 
    
    // Пополнение спецдохода 							
    Таб_СпецДоход = ИА_БФС.ТЗ_НоваяТаблицаЗначений("ВидДохода,Источник,Период,Сумма");
    Для каждого Стр Из ДокФП.ДоходыБП Цикл
        НовСтрока = Таб_СпецДоход.Добавить();
        ЗаполнитьЗначенияСвойств(НовСтрока, Стр);
        НовСтрока.Период = Формат(НовСтрока.Период, "ДФ=dd.MM.yyyy");
        НовСтрока.Сумма = Стр.СуммаБезнал + Стр.СуммаНал;
	КонецЦикла;
	Для каждого Стр Из ДокФП.ОтложенныйДоход Цикл
		Если стр.ТипОперации = Перечисления.КСУ_ОперацииСОтложеннымДоходом.Отложить Тогда
	        НовСтрока = Таб_СпецДоход.Добавить();
	        ЗаполнитьЗначенияСвойств(НовСтрока, Стр);
	        НовСтрока.Период = Формат(НовСтрока.ДоДаты, "ДФ=dd.MM.yyyy");
	    КонецЕсли;
    КонецЦикла;
    Вывести_ТЗ_ВТабДок(Таб_СпецДоход, ТабДок, "Пополнение спецдохода", НастройкаОформления); 
    
    // Распределение спецдохода
    Таб_СпецДоходРаспределение = ИА_БФС.ТЗ_НоваяТаблицаЗначений("ВидДохода,Источник,ВидДоходаПолучатель,Сумма");
    Для каждого Стр Из ДокФП.ДоходыБП_Распределение Цикл
        НовСтрока = Таб_СпецДоходРаспределение.Добавить();
        ЗаполнитьЗначенияСвойств(НовСтрока, Стр);
        НовСтрока.Сумма = Стр.СуммаБезнал + Стр.СуммаНал;
	КонецЦикла;
	Для каждого Стр Из ДокФП.ОтложенныйДоход Цикл
		Если стр.ТипОперации = Перечисления.КСУ_ОперацииСОтложеннымДоходом.Вернуть Тогда
	        НовСтрока = Таб_СпецДоходРаспределение.Добавить();
        	ЗаполнитьЗначенияСвойств(НовСтрока, Стр);
	    КонецЕсли;
    КонецЦикла;
    Вывести_ТЗ_ВТабДок(Таб_СпецДоходРаспределение, ТабДок, "Распределение спецдохода", НастройкаОформления); 
    
    // Распределение с фондов
    Таб_РаспределениеСоСтатей = ИА_БФС.ТЗ_НоваяТаблицаЗначений("Статья,Подразделение,ВидДохода,Сумма");
    Для каждого Стр Из ДокФП.РаспределениеСредствСФондов Цикл
        НовСтрока = Таб_РаспределениеСоСтатей.Добавить();
        ЗаполнитьЗначенияСвойств(НовСтрока, Стр);
        НовСтрока.Статья = Стр.Фонд;
        НовСтрока.Сумма = Стр.СуммаНал + Стр.СуммаБезНал;        
    КонецЦикла;
    Вывести_ТЗ_ВТабДок(Таб_РаспределениеСоСтатей, ТабДок, "Распределение ДС с фондов", НастройкаОформления); 
    
    ВывестиПоказательЗначение(ТабДок, "ИТОГО Доход за неделю:", ДокФП.ДоходыИтого.Итог("СуммаНал") + ДокФП.ДоходыИтого.Итог("СуммаБезНал"), НастройкаОформленияБезШапки);

    
    
    // Политика №1
    Таб_Пол1 = ИА_БФС.ТЗ_НоваяТаблицаЗначений("Статья, Сумма");
    ВремТаб = ДокФП.Политика1.Выгрузить();
    ВремТаб.Свернуть("Статья", "Сумма");
    Для каждого Стр Из ВремТаб Цикл
        НовСтрока = Таб_Пол1.Добавить();
        ЗаполнитьЗначенияСвойств(НовСтрока, стр);
    КонецЦикла;  
    ИА_БФС.ТЗ_УдалитьСтрокиПоУсловию(Таб_Пол1, "СтрокаТЗ.Сумма = 0");
    Вывести_ТЗ_ВТабДок(Таб_Пол1, ТабДок, "Отчисления с Дохода:", НастройкаОформления); 
    
    ВывестиПоказательЗначение(ТабДок, "ИТОГО Валовая прибыль за неделю:", ДокФП.ВаловаяПрибыльСуммаНал + ДокФП.ВаловаяПрибыльСуммаБезнал, НастройкаОформленияБезШапки);
    
    
    // Политика №2
    Таб_Пол2 = ИА_БФС.ТЗ_НоваяТаблицаЗначений("Статья, Сумма");
    ВремТаб = ДокФП.Политика2.Выгрузить();
    ВремТаб.Свернуть("Статья", "Сумма");
    Для каждого Стр Из ВремТаб Цикл
        НовСтрока = Таб_Пол2.Добавить();
        ЗаполнитьЗначенияСвойств(НовСтрока, стр);
    КонецЦикла;  
    ИА_БФС.ТЗ_УдалитьСтрокиПоУсловию(Таб_Пол2, "СтрокаТЗ.Сумма = 0");
    Вывести_ТЗ_ВТабДок(Таб_Пол2, ТабДок, "Отчисления с Валовой прибыли:", НастройкаОформления); 
    
    ВывестиПоказательЗначение(ТабДок, "Остаток средств к распределению:" , ДокФП.СуммаКРаспределениюНал + ДокФП.СуммаКРаспределениюБезнал, НастройкаОформленияБезШапки);
    
    
    Вывести_СКД(ДокФП, ТабДок, "СКД_ПЗП",               "Одобренные ЗП:");
    Вывести_СКД(ДокФП, ТабДок, "СКД_ЗНО",               "ЗНО:");
    Вывести_СКД(ДокФП, ТабДок, "СКД_ПеремещениеФонды",  "Перемещение, займ между фондами:");
    ТабДок.АвтоМасштаб = Истина;
    
    Возврат ТабДок;
КонецФункции

&НаСервереБезКонтекста
Процедура ВывестиПоказательЗначение(ТабДок, Показатель, Значение, НастройкаОформленияБезШапки)
    
    Вывести_ТЗ_ВТабДок(
    ИА_БФС.ТЗ_Создать("Показатель, Значение"
    , Показатель, Значение)
    , ТабДок, "", НастройкаОформленияБезШапки);

КонецПроцедуры

&НаСервереБезКонтекста
Процедура Вывести_СКД(ДокФП, ТабДок, ИмяСКД, Заголовок)
    ДанныеСКД = ИА_БФС.СКД_Выполнить(Документы.ИА_ФинансовоеПланирование.ПолучитьМакет(ИмяСКД), Новый Структура("Ссылка", ДокФП),,,,,,1);
    
    ДанныеСКД.ТабДок.Область().СоздатьФорматСтрок();
    ВывестиЗаголовок(ТабДок, Заголовок);
    
    
    ТабДок.НачатьГруппуСтрок();
    ТабДок.Вывести(ДанныеСКД.ТабДок);
    ТабДок.ЗакончитьГруппуСтрок();
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ВывестиЗаголовок(ТабДок, Заголовок, ПараметрРасшифровки = Неопределено)
    Макет = Новый ТабличныйДокумент;
    Обл = Макет.Область(2, 1, 2, 1);
    Обл.Текст = Заголовок;
    Обл.Шрифт = Новый Шрифт(,, Истина);    
    Обл.Расшифровка = ПараметрРасшифровки;
    ТабДок.Вывести(Макет);
КонецПроцедуры


&НаСервереБезКонтекста
Процедура Вывести_ТЗ_ВТабДок(ТЗ, Табдок, Заголовок, НастройкаОформления)
    ТабДок.Вывести(иа_бфс.ТЗ_ВывестиВТабДок(ТЗ, Заголовок, Ложь, Истина, Истина,НастройкаОформления)); 		
КонецПроцедуры

