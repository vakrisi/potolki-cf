&НаСервере
Процедура ОбновитьФинПоказатели(Очищать = истина)
	предТЗ = объект.ФинПоказатели.Выгрузить();
	
	Запрос = новый запрос;
	запрос.Текст = "ВЫБРАТЬ
	               |	тз.Показатель КАК Показатель,
	               |	тз.Значение КАК Значение
	               |ПОМЕСТИТЬ предТЗ
	               |ИЗ
	               |	&тз КАК тз
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ИА_ВидыСтатистик.Ссылка КАК Показатель,
	               |	ЕСТЬNULL(предТЗ.Значение, 0) КАК Значение,
	               |	ВЫБОР
	               |		КОГДА ИА_ВидыСтатистик.ВариантПолученияДанных = ЗНАЧЕНИЕ(Перечисление.ИА_ВариантыПолученияДанныхСтатистик.ДокументомСтатистика)
	               |			ТОГДА ИСТИНА
	               |		ИНАЧЕ ЛОЖЬ
	               |	КОНЕЦ КАК Ручная
	               |ИЗ
	               |	Справочник.ИА_ВидыСтатистик КАК ИА_ВидыСтатистик
	               |		ЛЕВОЕ СОЕДИНЕНИЕ предТЗ КАК предТЗ
	               |		ПО ИА_ВидыСтатистик.Ссылка = предТЗ.Показатель
	               |ГДЕ
	               |	ИА_ВидыСтатистик.Родитель = &Родитель
	               |	И ИА_ВидыСтатистик.ПометкаУдаления = ЛОЖЬ
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ИА_ВидыСтатистик.Порядок";
	Запрос.УстановитьПараметр("тз", предТЗ);
	Запрос.УстановитьПараметр("Дата", Объект.Дата);
	Запрос.УстановитьПараметр("Родитель", Справочники.ИА_ВидыСтатистик.СтатистикиФП);
	ТекТЗ = Запрос.Выполнить().Выгрузить();
	
	ДерДохЧистые = РеквизитФормыВЗначение("ДоходыЧистые");
	
	// статистики из тек ФП
	Если Очищать Тогда
		
		// Валовый доход план
		НСтр = ТекТЗ.Найти(Справочники.ИА_ВидыСтатистик.ВаловойДоходПлан);
		если нстр <> Неопределено тогда
			нстр.значение = ДерДохЧистые.Строки.Итог("СуммаПлан" + НомерТекущейНедели, ложь);
		КонецЕсли;
		
		// Валовый доход факт
		НСтр = ТекТЗ.Найти(Справочники.ИА_ВидыСтатистик.ВаловойДоход);
		если нстр <> Неопределено тогда
			нстр.значение = объект.Доходы.Итог("СуммаБезнал");
		КонецЕсли;
		
		// Маржинальная прибыль
		НСтр = ТекТЗ.Найти(Справочники.ИА_ВидыСтатистик.МаржинальнаяПрибыль);
		если нстр <> Неопределено тогда
			нстр.значение = объект.МаржинальнаяПрибыль;
		КонецЕсли;
	КонецЕсли;
	
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 6
	               |	ИА_РаспределениеНедель.Период КАК НачалоНедели,
	               |	ИА_РаспределениеНедель.КонецНедели КАК КонецНедели
	               |ИЗ
	               |	РегистрСведений.ИА_РаспределениеНедель КАК ИА_РаспределениеНедель
	               |ГДЕ
	               |	ИА_РаспределениеНедель.Период <= &Дата
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Период УБЫВ";
	тзНедели6 = запрос.Выполнить().Выгрузить();
	тзНедели6.Сортировать("НачалоНедели");
	КолНед6 = тзНедели6.Количество();
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	тзНед.НачалоНедели КАК НачалоНедели
	               |ПОМЕСТИТЬ тзНед
	               |ИЗ
	               |	&тзНед КАК тзНед
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ТекТЗ.Показатель КАК Показатель,
	               |	ТекТЗ.Значение КАК Значение
	               |ПОМЕСТИТЬ ТекТЗ
	               |ИЗ
	               |	&ТекТЗ КАК ТекТЗ
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	Подзапрос.НеделяТБ КАК НеделяТБ,
	               |	Подзапрос.Показатель КАК Показатель,
	               |	СУММА(Подзапрос.Значение) КАК Значение
	               |ИЗ
	               |	(ВЫБРАТЬ
	               |		ИА_ФинансовоеПланированиеФинПоказатели.Ссылка.НеделяТБ КАК НеделяТБ,
	               |		ИА_ФинансовоеПланированиеФинПоказатели.Показатель КАК Показатель,
	               |		ИА_ФинансовоеПланированиеФинПоказатели.Значение КАК Значение
	               |	ИЗ
	               |		Документ.ИА_ФинансовоеПланирование.ФинПоказатели КАК ИА_ФинансовоеПланированиеФинПоказатели
	               |			ВНУТРЕННЕЕ СОЕДИНЕНИЕ тзНед КАК тзНед
	               |			ПО (тзНед.НачалоНедели = ИА_ФинансовоеПланированиеФинПоказатели.Ссылка.НеделяТБ)
	               |	ГДЕ
	               |		ИА_ФинансовоеПланированиеФинПоказатели.Ссылка.Проведен
	               |		И ИА_ФинансовоеПланированиеФинПоказатели.Ссылка.Дата < &Дата
	               |		И ИА_ФинансовоеПланированиеФинПоказатели.Ссылка.Организация = &Организация
	               |		И НЕ(ИА_ФинансовоеПланированиеФинПоказатели.Показатель = &ПланДохода
	               |					И ИА_ФинансовоеПланированиеФинПоказатели.Ссылка.НеделяТБ = &ТекНеделяТБ)
	               |	
	               |	ОБЪЕДИНИТЬ ВСЕ
	               |	
	               |	ВЫБРАТЬ
	               |		&ТекНеделяТБ,
	               |		ТекТЗ.Показатель,
	               |		ТекТЗ.Значение
	               |	ИЗ
	               |		ТекТЗ КАК ТекТЗ) КАК Подзапрос
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	Подзапрос.НеделяТБ,
	               |	Подзапрос.Показатель";
	Запрос.УстановитьПараметр("ТекТЗ", ТекТЗ);
	Запрос.УстановитьПараметр("тзНед", тзНедели6);
	Запрос.УстановитьПараметр("ТекНеделяТБ", объект.НеделяТБ);
	Запрос.УстановитьПараметр("Организация", объект.Организация);
	Запрос.УстановитьПараметр("ПланДохода", Справочники.ИА_ВидыСтатистик.ВаловойДоходПлан);
	ДанныеПоНеделям = запрос.Выполнить().Выгрузить();
	
	Если Очищать Тогда
		Объект.ФинПоказатели.Очистить();
		Для каждого стр из ТекТЗ Цикл
			Новстр = объект.ФинПоказатели.Добавить();
			ЗаполнитьЗначенияСвойств(Новстр, стр);
		КонецЦикла;
	КонецЕсли;
	
	// очистка недельных показателей
	для каждого стр из объект.ФинПоказатели цикл
		для счКол = 1 по 12 цикл
			стр["Неделя"+счКол] = 0;
		КонецЦикла;
	КонецЦикла;
	
	// заполнение данными недельных показателей и видимость колонок
	ДопПарам = Новый Структура("Организация", объект.Организация);
	
	счНед = 1;
	
	для каждого стрнед из тзНедели6 Цикл
		// колонка
		ЭлКолонка = Элементы["ФинПоказателиНеделя"+счНед];		
		ЭлКолонка.Видимость = истина;
		ЭлКолонка.Заголовок = Формат(стрнед.НачалоНедели,"ДФ=dd.MM")+"-"+Формат(стрнед.КонецНедели,"ДФ=dd.MM");
		Если стрнед.НачалоНедели = объект.НеделяТБ Тогда
			ЭлКолонка.ШрифтЗаголовка = новый шрифт(ЭлКолонка.ШрифтЗаголовка,,, истина);
			ЭлКолонка.ЦветФонаЗаголовка = новый цвет(220,221,254);
			ЭлКолонка.Шрифт = новый шрифт(,,истина);
		Иначе
			ЭлКолонка.ШрифтЗаголовка = новый шрифт(ЭлКолонка.ШрифтЗаголовка,,, ложь);
			ЭлКолонка.ЦветФонаЗаголовка = новый цвет();
			ЭлКолонка.Шрифт = новый шрифт();
		КонецЕсли;
		
		// данные
		НСтрокиНед = ДанныеПоНеделям.НайтиСтроки(Новый Структура("НеделяТБ", стрнед.НачалоНедели));
		Для каждого стрДПоНед из НСтрокиНед цикл
			СтрПоказатель = Объект.ФинПоказатели.НайтиСтроки(Новый Структура("Показатель", стрДПоНед.Показатель));
			Если СтрПоказатель.количество()>0 Тогда
				СтрПоказатель[0]["Неделя"+счНед] = стрДПоНед.Значение;
			КонецЕсли;
		КонецЦикла;
		
		// авоматические статистики
		Для каждого стрСтат из объект.ФинПоказатели Цикл
			//Если стрСтат.Ручная и стрСтат.Показатель = Справочники.ИА_ВидыСтатистик.ВаловойДоходПлан Тогда
			//	
			//	ТекущееЗначениеСтатистики = ПолучитьТекПланДохода(стрнед.НачалоНедели);
			//	
			//	стрСтат["Неделя"+счНед] = ТекущееЗначениеСтатистики;
			//	Если стрнед.НачалоНедели = объект.НеделяТБ Тогда
			//		стрСтат.Значение = ТекущееЗначениеСтатистики;
			//	КонецЕсли;
			//КонецЕсли;
			
			Если не стрСтат.Ручная Тогда
				ТекущееЗначениеСтатистики = ПолучитьЗначениеСтатистики(стрСтат.Показатель, стрнед.НачалоНедели, стрнед.КонецНедели, ДопПарам);			
				стрСтат["Неделя"+счНед] = ТекущееЗначениеСтатистики;
				Если стрнед.НачалоНедели = объект.НеделяТБ Тогда
					стрСтат.Значение = ТекущееЗначениеСтатистики;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		
		счНед = счНед + 1;
	КонецЦикла;
	
	// скроем оставшиеся колонки
	Пока счНед <= 12 Цикл
		ЭлКолонка = Элементы["ФинПоказателиНеделя"+счНед];		
		ЭлКолонка.Видимость = ложь;
		
		счНед = счНед + 1;
	КонецЦикла;
КонецПроцедуры

