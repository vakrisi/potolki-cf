	// сохраним в объект
	тд = Элементы.ДоходыЧистые.ТекущиеДанные;
	ОтбДоход = тд.ВидДохода;
	ОтбПодр = ПредопределенноеЗначение("Справочник.ИА_ЦФО.ПустаяСсылка");
	Если ИспДоходыПоПодразделениям Тогда
		ОтбПодр = тд.ПолучитьРодителя().ВидДохода;
	КонецЕсли;
	
	Для каждого стр из Объект.Доходы Цикл
		Если стр.ВидДохода = ОтбДоход и стр.Подразделение = ОтбПодр Тогда
			стр.СуммаБезнал = тд.Сумма;
		КонецЕсли;
	КонецЦикла;
	
	//
	ПересчитатьПриИзменДоходов();
	
	Элементы.ДоходыИтого.Обновить();
КонецПроцедуры


&НаСервере
Процедура ОбновитьИтогоВЗаливку()
	
	ИтогоВЗаливку.Очистить();
	
	СтрИтого = ИтогоВЗаливку.Добавить();
	СтрИтого.Заголовок = "Сумма на заливку с учетом отложенного дохода";
	Для сч = 1 по КолНед Цикл
		СтрИтого["Неделя"+сч] = Объект.ДоходыИтого.Итог("Неделя"+сч);
	КонецЦикла;
	СтрИтого.Сумма = Объект.ДоходыИтого.Итог("СуммаБезнал");
	
КонецПроцедуры

&НаСервере
Процедура ПересчитатьДоходыИтого()
	
	Объект.ДоходыИтого.Очистить();
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	Запрос.УстановитьПараметр("ДатаДок", Объект.Дата);
	Запрос.УстановитьПараметр("Ссылка", Объект.Ссылка);
	Запрос.УстановитьПараметр("ТекМесяц", Объект.МесяцТБ);
	Запрос.УстановитьПараметр("ТекНеделя", Объект.НеделяТБ);
	Запрос.УстановитьПараметр("тзДох", Объект.Доходы.Выгрузить());
	Запрос.УстановитьПараметр("тзОтлДох", Объект.ОтложенныйДоход.Выгрузить());
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	&ТекНеделя КАК Неделя,
	               |	ТЗ_Доходы.Подразделение КАК Подразделение,
	               |	ТЗ_Доходы.ВидДохода КАК ВидДохода,
	               |	ТЗ_Доходы.СуммаБезнал КАК Сумма
	               |ПОМЕСТИТЬ ТЗ_Доходы
	               |ИЗ
	               |	&тзДох КАК ТЗ_Доходы
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	&ТекНеделя КАК Неделя,
	               |	ТЗ_ОтлДоходы.Подразделение КАК Подразделение,
	               |	ТЗ_ОтлДоходы.ВидДохода КАК ВидДохода,
	               |	ВЫБОР
	               |		КОГДА ТЗ_ОтлДоходы.ТипОперации = ЗНАЧЕНИЕ(Перечисление.КСУ_ОперацииСОтложеннымДоходом.Отложить)
	               |			ТОГДА -ТЗ_ОтлДоходы.Сумма
	               |		ИНАЧЕ ТЗ_ОтлДоходы.Сумма
	               |	КОНЕЦ КАК Сумма
	               |ПОМЕСТИТЬ ТЗ_ОтлДоходы
	               |ИЗ
	               |	&тзОтлДох КАК ТЗ_ОтлДоходы
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ИА_РаспределениеНедель.Период КАК НачалоНедели
	               |ПОМЕСТИТЬ Недели
	               |ИЗ
	               |	РегистрСведений.ИА_РаспределениеНедель КАК ИА_РаспределениеНедель
	               |ГДЕ
	               |	ИА_РаспределениеНедель.Месяц = &ТекМесяц
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ЗапросДохода.ВидДохода КАК ВидДохода,
	               |	ЗапросДохода.Подразделение КАК Подразделение,
	               |	ЗапросДохода.Неделя КАК Неделя,
	               |	ЗапросДохода.ТекДок КАК ТекДок,
	               |	СУММА(ЗапросДохода.СуммаИтого) КАК СуммаИтого,
	               |	СУММА(ЗапросДохода.СуммаЧистая) КАК СуммаЧистая,
	               |	МАКСИМУМ(НомераНедель.НомерНедели) КАК НомерНедели
	               |ИЗ
	               |	(ВЫБРАТЬ
	               |		КСУ_ФП_ДоходыИтогоОбороты.ВидДохода КАК ВидДохода,
	               |		КСУ_ФП_ДоходыИтогоОбороты.Подразделение КАК Подразделение,
	               |		КСУ_ФП_ДоходыИтогоОбороты.Неделя КАК Неделя,
	               |		ЛОЖЬ КАК ТекДок,
	               |		КСУ_ФП_ДоходыИтогоОбороты.СуммаОборот КАК СуммаИтого,
	               |		0 КАК СуммаЧистая
	               |	ИЗ
	               |		РегистрНакопления.КСУ_ФП_ДоходыИтого.Обороты(
	               |				,
	               |				&ДатаДок,
	               |				Регистратор,
	               |				Организация = &Организация
	               |					ИЛИ &Организация = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)) КАК КСУ_ФП_ДоходыИтогоОбороты
	               |			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Недели КАК Недели
	               |			ПО (Недели.НачалоНедели = КСУ_ФП_ДоходыИтогоОбороты.Неделя)
	               |	ГДЕ
	               |		КСУ_ФП_ДоходыИтогоОбороты.Регистратор <> &Ссылка
	               |	
	               |	ОБЪЕДИНИТЬ ВСЕ
	               |	
	               |	ВЫБРАТЬ
	               |		ДоходыЧистыеОбороты.ВидДохода,
	               |		ДоходыЧистыеОбороты.Подразделение,
	               |		ДоходыЧистыеОбороты.Неделя,
	               |		ЛОЖЬ,
	               |		0,
	               |		ДоходыЧистыеОбороты.СуммаРасход
	               |	ИЗ
	               |		РегистрНакопления.КСУ_РаспределениеДоходовТБ.Обороты(
	               |				,
	               |				&ДатаДок,
	               |				Регистратор,
	               |				Организация = &Организация
	               |					ИЛИ &Организация = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)) КАК ДоходыЧистыеОбороты
	               |			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Недели КАК Недели
	               |			ПО (Недели.НачалоНедели = ДоходыЧистыеОбороты.Неделя)
	               |	ГДЕ
	               |		ДоходыЧистыеОбороты.Регистратор <> &Ссылка
	               |	
	               |	ОБЪЕДИНИТЬ ВСЕ
	               |	
	               |	ВЫБРАТЬ
	               |		ТЗ_Доходы.ВидДохода,
	               |		ТЗ_Доходы.Подразделение,
	               |		ТЗ_Доходы.Неделя,
	               |		ИСТИНА,
	               |		ТЗ_Доходы.Сумма,
	               |		ТЗ_Доходы.Сумма
	               |	ИЗ
	               |		ТЗ_Доходы КАК ТЗ_Доходы
	               |	
	               |	ОБЪЕДИНИТЬ ВСЕ
	               |	
	               |	ВЫБРАТЬ
	               |		ТЗ_ОтлДоходы.ВидДохода,
	               |		ТЗ_ОтлДоходы.Подразделение,
	               |		ТЗ_ОтлДоходы.Неделя,
	               |		ИСТИНА,
	               |		ТЗ_ОтлДоходы.Сумма,
	               |		0
	               |	ИЗ
	               |		ТЗ_ОтлДоходы КАК ТЗ_ОтлДоходы) КАК ЗапросДохода
	               |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	               |			ИА_РаспределениеНедель.Период КАК Период,
	               |			КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ИА_РаспределениеНедель1.Период) КАК НомерНедели
	               |		ИЗ
	               |			РегистрСведений.ИА_РаспределениеНедель КАК ИА_РаспределениеНедель
	               |				ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИА_РаспределениеНедель КАК ИА_РаспределениеНедель1
	               |				ПО ИА_РаспределениеНедель.Месяц = ИА_РаспределениеНедель1.Месяц
	               |					И (ИА_РаспределениеНедель1.Период <= ИА_РаспределениеНедель.Период)
	               |		
	               |		СГРУППИРОВАТЬ ПО
	               |			ИА_РаспределениеНедель.Период) КАК НомераНедель
	               |		ПО (НомераНедель.Период = ЗапросДохода.Неделя)
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ЗапросДохода.ВидДохода,
	               |	ЗапросДохода.Подразделение,
	               |	ЗапросДохода.Неделя,
	               |	ЗапросДохода.ТекДок";
	Рез = Запрос.Выполнить().Выгрузить();
	
	Для каждого стр из Рез Цикл
		Если стр.НомерНедели = null Тогда
			Сообщить("Внимание! Обнаружено нарушение распределения недель! После создания ФП изменили распределение недель. Перезаполните документ или верните распределение недель.");
			Возврат;
		КонецЕсли;
		
		СтрОтбор = Новый Структура("ВидДохода,Подразделение", стр.ВидДохода, стр.Подразделение); 
		НстрД = Объект.ДоходыИтого.НайтиСтроки(СтрОтбор);
		Если НстрД.Количество() = 0 Тогда
			Текстр = Объект.ДоходыИтого.Добавить();
			ЗаполнитьЗначенияСвойств(Текстр, стр);
		Иначе
			Текстр = НстрД[0];
		КонецЕсли;
		
		Текстр["Неделя" + стр.НомерНедели] = Текстр["Неделя" + стр.НомерНедели] + стр.СуммаИтого;
		Текстр["НеделяЧистый" + стр.НомерНедели] = Текстр["НеделяЧистый" + стр.НомерНедели] + стр.СуммаЧистая;
		Текстр["НеделяОтлож" + стр.НомерНедели] = Текстр["Неделя" + стр.НомерНедели] - Текстр["НеделяЧистый" + стр.НомерНедели];
		
		Если стр.ТекДок Тогда
			Текстр.СуммаБезнал = Текстр.СуммаБезнал + стр.СуммаИтого; 
		КонецЕсли;
	КонецЦикла;
	
	// подвал
	НомерКолонки = 1;
	ТекНедНомер = 0;
	Для НомерКолонки =1 по КолНед Цикл
		Элементы["ДоходыИтогоНеделяЧистый" + НомерКолонки].ТекстПодвала = Формат(объект.ДоходыИтого.Итог("НеделяЧистый" + НомерКолонки),"ЧДЦ=2; ЧН=");
		Элементы["ДоходыИтогоНеделяОтлож" + НомерКолонки].ТекстПодвала = Формат(объект.ДоходыИтого.Итог("НеделяОтлож" + НомерКолонки),"ЧДЦ=2; ЧН=");
		Элементы["ДоходыИтогоНеделя" + НомерКолонки].ТекстПодвала = Формат(объект.ДоходыИтого.Итог("Неделя" + НомерКолонки),"ЧДЦ=2; ЧН=");
	КонецЦикла;	
КонецПроцедуры

