&НаКлиенте
Процедура ДеревоЗПВыбратьПриИзменении(Элемент)
	
	// всем подчиненным ставим галочку
	тд = Элементы.ДеревоЗП.ТекущиеДанные;
	Для каждого стр из тд.ПолучитьЭлементы() Цикл
		стр.ВыбратьСтр = тд.ВыбратьСтр;
		Для каждого стр1 из стр.ПолучитьЭлементы() Цикл
			стр1.ВыбратьСтр = тд.ВыбратьСтр;
			
			Для каждого стр2 из стр1.ПолучитьЭлементы() Цикл
				стр2.ВыбратьСтр = тд.ВыбратьСтр;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	
	// если галку сняли, то снимем и у родителей
	Если тд.ВыбратьСтр = ложь тогда
		ТекРод = тд.ПолучитьРодителя();
		Пока ТекРод <> Неопределено Цикл
			ТекРод.ВыбратьСтр = ложь;
			
			ТекРод = ТекРод.ПолучитьРодителя();
		КонецЦикла;
	КонецЕсли;
	
	ИзменениеГалочекВыбор();
КонецПроцедуры

