&НаСервере
Функция МассивОрганизацийФП()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ИА_ГруппыКомпанийДочерниеОрганизации.Организация
	|ИЗ
	|	Справочник.ИА_ГруппыКомпаний.ДочерниеОрганизации КАК ИА_ГруппыКомпанийДочерниеОрганизации
	|ГДЕ
	|	ИА_ГруппыКомпанийДочерниеОрганизации.Ссылка.ГоловнаяОрганизация = &ГоловнаяОрганизация
	|
	|СГРУППИРОВАТЬ ПО
	|	ИА_ГруппыКомпанийДочерниеОрганизации.Организация";
	
	Запрос.УстановитьПараметр("ГоловнаяОрганизация", Объект.Организация);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Массив = Новый Массив;
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Массив.Добавить(ВыборкаДетальныеЗаписи.Организация);
	КонецЦикла;
	Если Массив.Найти(Объект.Организация) = Неопределено Тогда 
		Массив.Добавить(Объект.Организация);
	КонецЕсли;
	Возврат Массив;
	
КонецФункции

&НаСервере
Функция ПолучитьПоследнееФП()
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ИА_ФинансовоеПланирование.Ссылка КАК Ссылка,
	               |	ИА_ФинансовоеПланирование.Дата КАК Дата,
	               |	ИА_ФинансовоеПланирование.Номер КАК Номер
	               |ИЗ
	               |	Документ.ИА_ФинансовоеПланирование КАК ИА_ФинансовоеПланирование
	               |ГДЕ
	               |	ИА_ФинансовоеПланирование.Проведен = ИСТИНА
	               |	И (ИА_ФинансовоеПланирование.Организация = &Организация
	               |			ИЛИ &НеРазделять)
	               |	И ИА_ФинансовоеПланирование.Дата < &Дата
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ИА_ФинансовоеПланирование.Дата УБЫВ";
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	Запрос.УстановитьПараметр("НеРазделять", не ФППоОрганизациям);
	Запрос.УстановитьПараметр("Дата", ?(ЗначениеЗаполнено(Объект.Дата) , Объект.Дата, ТекущаяДата()));
	Выборка = Запрос.Выполнить().Выбрать();
				
	Если Выборка.Следующий() Тогда
		ПредФпСтрукт = Новый структура("Ссылка, Дата, НомерПредыдущегоФП_ДляАвтодохода, ДатаПредыдущегоФП_ДляАвтодохода", 
								Выборка.Ссылка, Выборка.Дата, Выборка.Номер, Выборка.Дата);
	Иначе
		ПредФпСтрукт = Новый структура("Ссылка, Дата, НомерПредыдущегоФП_ДляАвтодохода, ДатаПредыдущегоФП_ДляАвтодохода", 
					Документы.ИА_ФинансовоеПланирование.ПустаяСсылка(), дата(1,1,1),"", дата(1,1,1));		
	КонецЕсли;
	
	// последнее фп с автодоходом
	Запрос.Текст = "ВЫБРАТЬ
	               |	ИА_ФинансовоеПланирование.Дата КАК ДатаПредыдущегоФП_ДляАвтодохода,
				   |	ИА_ФинансовоеПланирование.Номер КАК НомерПредыдущегоФП_ДляАвтодохода
	               |ИЗ
	               |	Документ.ИА_ФинансовоеПланирование КАК ИА_ФинансовоеПланирование
	               |ГДЕ
	               |	ИА_ФинансовоеПланирование.Проведен = ИСТИНА
	               |	И (ИА_ФинансовоеПланирование.Организация = &Организация
	               |			ИЛИ &НеРазделять)
	               |	И ИА_ФинансовоеПланирование.Дата < &Дата
	               |	И ИА_ФинансовоеПланирование.АвтосборДоходов
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ИА_ФинансовоеПланирование.Дата УБЫВ";
	Выборка = Запрос.Выполнить().Выбрать();				
	Если Выборка.Следующий() Тогда
		ПредФпСтрукт.ДатаПредыдущегоФП_ДляАвтодохода = выборка.ДатаПредыдущегоФП_ДляАвтодохода;
		ПредФпСтрукт.НомерПредыдущегоФП_ДляАвтодохода = выборка.НомерПредыдущегоФП_ДляАвтодохода;
	КонецЕсли;
	
	ПредФп = ПредФпСтрукт.Ссылка;
	ДатаПредыдущегоФП = ПредФпСтрукт.Дата;
	НомерПредыдущегоФП_ДляАвтодохода = ПредФпСтрукт.НомерПредыдущегоФП_ДляАвтодохода;
	ДатаПредыдущегоФП_ДляАвтодохода = ПредФпСтрукт.ДатаПредыдущегоФП_ДляАвтодохода;
	
	Возврат ПредФпСтрукт;
КонецФункции

&НаКлиенте
Функция ПолучитьДатуНачалаДоходов()
	
	Если ДатаПредыдущегоФП_ДляАвтодохода <> Дата(1,1,1) Тогда
		Возврат ДатаПредыдущегоФП_ДляАвтодохода + 1;
	Иначе
		Возврат Объект.Дата - 60*60*24*7 + 1;
	КонецЕсли;

КонецФункции

&НаКлиенте
Процедура ОбновитьПериодыДоходов(ОбновлятьЗначения = истина)
	Если объект.РучнойПериодДоходов Тогда			
		Элементы.Доходы_ДатаНачала.Подсказка = "Вы меняли интервал заполнения доходов вручную.";
	КонецЕсли;
	
	БлокНачала = ДатаПредыдущегоФП_ДляАвтодохода > объект.Дата - 60*60*24 * 10;
	//Элементы.Доходы_ДатаНачала.ТолькоПросмотр = БлокНачала;
	
	Доходы_ДатаНачала1 = ПолучитьДатуНачалаДоходов();
	
	Если ОбновлятьЗначения Тогда
		Объект.Доходы_ДатаНачала = Доходы_ДатаНачала1;
	КонецЕсли;
	
	
	Если ДатаПредыдущегоФП_ДляАвтодохода <> Дата(1,1,1) Тогда
		ЗаголовокСтрока = Новый Массив;
		ЗаголовокСтрока.Добавить("Левая граница устанавливается автоматически на основании даты последнего ФП с включенным автосбором доходов." + Символы.ПС);
		ЗаголовокСтрока.Добавить("Во избежание искажения данных по доходу в текущем ФП не рекомендуется менять это поле вручную." + Символы.ПС+ Символы.ПС);
		ЗаголовокСтрока.Добавить(Новый ФорматированнаяСтрока("Предыдущее ФП с включенным автосбором доходов: №"+НомерПредыдущегоФП_ДляАвтодохода +" от "+ ДатаПредыдущегоФП_ДляАвтодохода , , новый цвет(0,0,255)));
		
		Элементы.Доходы_ДатаНачала.РасширеннаяПодсказка.Заголовок = новый ФорматированнаяСтрока(ЗаголовокСтрока); 
		//Если БлокНачала тогда
		//	Элементы.Доходы_ДатаНачала.РасширеннаяПодсказка.Заголовок = Элементы.Доходы_ДатаНачала.РасширеннаяПодсказка.Заголовок  + "." + Символы.ПС + "Редактирование запрещено т.к. предыдущий документ находится в прошлой неделе и редактирование не требуется.";
		//КонецЕсли;
	Иначе			
		Элементы.Доходы_ДатаНачала.РасширеннаяПодсказка.Заголовок = "Предыдущее ФП не обнаружено. "+Символы.ПС+"Установите дату и время левой границы интервала для автоматического сбора дохода. "+Символы.ПС+"В дальнейшем это поле будет устанавливаться автоматически на основе даты предыдущего ФП";
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьДоходыБПСервер()
	
	Объект.ДоходыБП_Распределение.Очистить();
	
	Запрос = новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ИА_ДоходыБудущихПериодовОстатки.ВидДохода,
	|	ИА_ДоходыБудущихПериодовОстатки.Источник,
	|	ИА_ДоходыБудущихПериодовОстатки.СуммаНалОстаток КАК СуммаНал,
	|	ИА_ДоходыБудущихПериодовОстатки.СуммаБезналОстаток КАК СуммаБезнал
	|ИЗ
	|	РегистрНакопления.ИА_ДоходыБудущихПериодов.Остатки(
	|			&НаДату,
	|			Организация = &Организация
	|				ИЛИ &НеРазделять) КАК ИА_ДоходыБудущихПериодовОстатки
	|ГДЕ
	|	ИА_ДоходыБудущихПериодовОстатки.СуммаНалОстаток <> 0
	|			ИЛИ ИА_ДоходыБудущихПериодовОстатки.СуммаБезналОстаток <> 0";
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	Запрос.УстановитьПараметр("НеРазделять", не ФППоОрганизациям);
	Запрос.УстановитьПараметр("НаДату", Объект.Дата);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Новстр = Объект.ДоходыБП_Распределение.Добавить();
		ЗаполнитьЗначенияСвойств(Новстр, Выборка);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьДоходыБП()
	Если ЗначениеЗаполнено(Объект.Ссылка) и Объект.ДоходыБП_Распределение.Количество()> 0 Тогда
		ПоказатьВопрос(Новый ОписаниеОповещения("ОбновитьДоходыБПЗавершение",ЭтотОбъект),"Таблица будет очищена. Продолжить?", РежимДиалогаВопрос.ДаНет);
		Возврат;		
	КонецЕсли;	
	ОбновитьДоходыБПСервер();
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьДоходыБПЗавершение(РезультатВопроса, дп) Экспорт
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		ОбновитьДоходыБПСервер();
	КонецЕсли;
