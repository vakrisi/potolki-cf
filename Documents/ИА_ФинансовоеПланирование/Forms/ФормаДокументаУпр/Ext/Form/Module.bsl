Процедура ЗаполнитьТаблицуЗП(поТекДокументу = Ложь)
	
	ГруппЗП_Заг = "Фонд / Предмет заказа";
	Если ИспПодразделения Тогда
		ГруппЗП_Заг = "Подразделение / " + ГруппЗП_Заг;
	КонецЕсли;
	Если ВыводитьГруппировкуПоСчетам Тогда
		ГруппЗП_Заг = "Счет / " + ГруппЗП_Заг;	
	КонецЕсли;
	Элементы.ДеревоЗППодразделениеФонд.Заголовок = ГруппЗП_Заг;
	
	//
	
	Запрос = Новый Запрос;
	ТекстЗапроса = "ВЫБРАТЬ
	               |	ПодЗапрос.Заказ КАК Заказ,
	               |	ПодЗапрос.Счет КАК Счет,
	               |	ВЫБОР
	               |		КОГДА ПодЗапрос.Счет = ЗНАЧЕНИЕ(Справочник.ИА_Счета.ГлавныйСчет)
	               |			ТОГДА 0
	               |		ИНАЧЕ 200
	               |	КОНЕЦ КАК СчетПорядок,
	               |	ПодЗапрос.Фонд КАК Фонд,
	               |	ПодЗапрос.ПредметЗаказа КАК ПредметЗаказа,
	               |	ПодЗапрос.Сумма - ЕСТЬNULL(ПодЗапросРезервы.Сумма, 0) - ЕСТЬNULL(ПодЗапросЗакрытия.Сумма, 0) КАК Сумма,
	               |	ЕСТЬNULL(ПодЗапросРезервы.Сумма, 0) + ЕСТЬNULL(ПодЗапросЗакрытия.Сумма, 0) КАК РанееВыделено,
				   |	ВЫБОР КОГДА ЕСТЬNULL(ПодЗапросРезервы.Сумма, 0) + ЕСТЬNULL(ПодЗапросЗакрытия.Сумма, 0) >0 И ЕСТЬNULL(ПодЗапросРезервы.СуммаРасход, 0) = 0 ТОГДА ИСТИНА ИНАЧЕ ЛОЖЬ КОНЕЦ КАК МожноАннулировать,
	               |	ПодЗапрос.Статус КАК Статус,
	               |	ПодЗапрос.УтвержденнаяСумма КАК УтвержденнаяСумма,
	               |	ПодЗапрос.Сумма КАК ИсходнаяСумма,
	               |	ПодЗапрос.ПричинаОтказа КАК ПричинаОтказа,
	               |	ПодЗапрос.НачислениеВФондБезнал КАК НачислениеВФонд,
	               |	ПодЗапрос.Подразделение КАК Подразделение,
	               |	ПодЗапрос.Подразделение.Наименование КАК ПодразделениеФонд,
	               |	ПодЗапрос.Заказ.Ситуация КАК Ситуация,
	               |	ПодЗапрос.Заказ.Данные КАК Данные,
	               |	ПодЗапрос.Заказ.Решение КАК Решение,
	               |	ПодЗапрос.Фонд.Код КАК ФондКод,
	               |	ПодЗапрос.Заказ.Дата КАК Дата,
	               |	ПодЗапрос.Заказ.Номер КАК Номер,
	               |	ПодЗапрос.Заказ.ДатаОплаты КАК СрокОплаты
	               |ПОМЕСТИТЬ ВТСводнаяТаблица
