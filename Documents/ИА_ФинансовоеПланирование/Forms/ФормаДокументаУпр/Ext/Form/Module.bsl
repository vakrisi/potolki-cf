&НаКлиенте
Процедура ДеревоЗПУтвержденнаяСуммаПриИзменении(Элемент)
	тд = Элементы.ДеревоЗП.ТекущиеДанные;
	Если тд.УтвержденнаяСумма > тд.Сумма Тогда	
		Если тд.РанееВыделено = 0 Тогда
			//тд.УтвержденнаяСумма = тд.Сумма;
			//ПоказатьПредупреждение(,"Введенная сумма превышает потребность по заказу. Если вы хотите увеличить сумму средств по заказу, вам необходимо открыть заказ и изменить его сумму.");
			ПарамФ = новый Структура("Заказ,Одобрено,ТекИд", тд.Заказ, тд.УтвержденнаяСумма, тд.ПолучитьИдентификатор());
			Оп = новый ОписаниеОповещения("ЗакрытиеФормыПревышения", ЭтотОбъект, ПарамФ);
			ОткрытьФорму("Документ.ИА_ФинансовоеПланирование.Форма.ПревышениеCуммыЗаказа", ПарамФ, ЭтаФорма,,,, оп);
			
			возврат;
		Иначе
			ТекЗаказ = тд.заказ;
			ТекУтв = тд.УтвержденнаяСумма;
			ТекИд = тд.ПолучитьИдентификатор();
			
			Оп = новый ОписаниеОповещения("ЗавершениеВыбораПриПревышении", ЭтотОбъект, Новый структура("ТекЗаказ, ТекУтв, ТекИд",ТекЗаказ, ТекУтв, ТекИд));
			ПоказатьВопрос(Оп , "Введенная сумма превышает потребность по заказу. Если вы хотите увеличить сумму средств по заказу, вам необходимо создать новый заказ с увеличенной суммой заказа. Создать копию заказа?", РежимДиалогаВопрос.ДаНет); 
			
			возврат;
		КонецЕсли;
	КонецЕсли;
	
	тд.ОстатокПоЗаказу = тд.Сумма - тд.УтвержденнаяСумма;
	ОбработатьСменуСтатусаСтрокиЗаказа(тд, "Одобрить", тд.УтвержденнаяСумма);
	тд.СтатусНомер = НомерСтатуса(тд.Статус);
КонецПроцедуры

&НаСервереБезКонтекста
Процедура УвеличитьСуммуЗаказа(заказ, сумма)
	об = заказ.ПолучитьОбъект();
	СтараяСумма = об.Сумма;
	об.Сумма = сумма;
	об.записать(РежимЗаписиДокумента.Проведение);
	
	Движение = РегистрыСведений.КСУ_ЛентаСобытий.СоздатьМенеджерЗаписи();
	Движение.ПериодСобытия = ТекущаяДата();;
	Движение.ДатаСобытия = ТекущаяДата();
	Движение.Объект = заказ;		
	Движение.Событие = "Увеличена сумма заказа + "+формат(сумма - СтараяСумма,"ЧДЦ=2")+" руб.";
	Движение.Ответственный = ПараметрыСеанса.ТекущийПользователь;
	Движение.Записать();
КонецПроцедуры

&НаКлиенте
Процедура ЗакрытиеФормыПревышения(рез, дп) Экспорт
	тд = ДеревоЗП.НайтиПоИдентификатору(дп.ТекИд);
	Если рез = Истина Тогда
		УвеличитьСуммуЗаказа(дп.Заказ,дп.Одобрено);		
		тд.УтвержденнаяСумма = дп.Одобрено;
		тд.Сумма = дп.Одобрено;
		тд.ИсходнаяСумма = дп.Одобрено;
	Иначе
		тд.УтвержденнаяСумма = тд.Сумма;		
	КонецЕсли;
	
	тд.ОстатокПоЗаказу = тд.Сумма - тд.УтвержденнаяСумма;
	ОбработатьСменуСтатусаСтрокиЗаказа(тд, "Одобрить", тд.УтвержденнаяСумма);
	тд.СтатусНомер = НомерСтатуса(тд.Статус);
	
	ДеревоЗВСИзменение();
КонецПроцедуры
	
&НаКлиенте
Процедура ЗавершениеВыбораПриПревышении(ВыбЗн, дп) Экспорт
	
	тд = ДеревоЗП.НайтиПоИдентификатору(дп.ТекИд);
	
	Если ВыбЗн = КодВозвратаДиалога.Да Тогда
		Если тд.СтатусИсходный = ПредопределенноеЗначение("Перечисление.ИА_СостояниеЗаказа.ОдобренЧастично_ЧастичныеВыплаты") 
			ИЛИ тд.СтатусИсходный = ПредопределенноеЗначение("Перечисление.ИА_СостояниеЗаказа.ОдобренЧастично_ВсёВыплачено") Тогда
			тд.Статус = ПредопределенноеЗначение("Перечисление.ИА_СостояниеЗаказа.ОдобренЧастично_Закрыт"); 
		Иначе
			тд.Статус = ПредопределенноеЗначение("Перечисление.ИА_СостояниеЗаказа.Закрыт"); 
		КонецЕсли;
		тд.УтвержденнаяСумма = 0;
		тд.ОстатокПоЗаказу = тд.Сумма;
		
		// новый заказ
		ТекРезерв = ИА_ФПСервер.ОстатокРезерва(тд.Заказ, Объект.Дата - 1); 
		ПараметрыЗаказа = Новый Структура;	             
		ПараметрыЗаказа.Вставить("ЗаказКопия", тд.Заказ);		
		ПараметрыЗаказа.Вставить("Дата", Объект.Дата - 60);
		ПараметрыЗаказа.Вставить("Сумма", дп.ТекУтв + ТекРезерв);			
		ПараметрыЗаказа.Вставить("Статус", ПредопределенноеЗначение("Перечисление.ИА_СостояниеЗаказа.РассмотретьНаФП"));
		формаНовогоЗаказа = ОткрытьФорму("Документ.ИА_ЗаказНаПриобретение.Форма.ФормаДокументаУпр", ПараметрыЗаказа, ЭтаФорма,,,,Новый ОписаниеОповещения("КомандаДобавитьОбработчик",ЭтаФорма), РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	Иначе
		тд.УтвержденнаяСумма = тд.Сумма;
		тд.ОстатокПоЗаказу = тд.Сумма - тд.УтвержденнаяСумма;
		ОбработатьСменуСтатусаСтрокиЗаказа(тд, "Одобрить", тд.УтвержденнаяСумма);
	КонецЕсли;
	
	тд.СтатусНомер = НомерСтатуса(тд.Статус);
	ДеревоЗВСИзменение();
КонецПроцедуры
	
