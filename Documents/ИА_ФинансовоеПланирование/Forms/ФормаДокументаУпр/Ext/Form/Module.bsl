&НаКлиенте
Процедура ИзменениеЗаймовВозвратов()
	//перенесем в объект
	Объект.РаспределениеПоФондам.Очистить();
	Для каждого стр из ВозвратыЗаймов Цикл
		Новстр = Объект.РаспределениеПоФондам.Добавить();
		ЗаполнитьЗначенияСвойств(Новстр, стр);
		новстр.СуммаБезнал = стр.сумма;
		новстр.ЗаймВозврат = ПредопределенноеЗначение("Перечисление.ИА_ЗаймВозврат.Возврат");
		новстр.Фонд = стр.НаФонд;
		новстр.Подразделение = стр.НаПодразделение;
	КонецЦикла;
	
	Для каждого стр из Займы Цикл
		Новстр = Объект.РаспределениеПоФондам.Добавить();
		ЗаполнитьЗначенияСвойств(Новстр, стр);
		новстр.СуммаБезнал = стр.сумма;
		новстр.Фонд = стр.НаФонд;
		новстр.Подразделение = стр.НаПодразделение;
	КонецЦикла;
	//
	
	ОбновитьОтчетССохранениемСтрокиЗакладкаЗаймы();
КонецПроцедуры


&НаКлиенте
Процедура ОбновитьОтчетССохранениемСтрокиЗакладкаЗаймы()
	ПредФондПодр = Неопределено;
	ПредФондПодрРодитель = Неопределено;
	тдОстатки = Элементы.ДеревоСостояниеФондов1.ТекущиеДанные;
	Если тдОстатки <> Неопределено Тогда		
		ПредФондПодр = тдОстатки.СчетПодразделениеФонд;
		Если тдОстатки.ПолучитьРодителя() <> Неопределено Тогда		
			ПредФондПодрРодитель = тдОстатки.ПолучитьРодителя().СчетПодразделениеФонд;
		КонецЕсли;
	КонецЕсли;
	
	ОбновитьОтчетПоСотояниюФондов();
	
	Для каждого стр из ДеревоСостояниеФондов.ПолучитьЭлементы() цикл
		Элементы.ДеревоСостояниеФондов1.Развернуть(стр.получитьИдентификатор(), истина);
	КонецЦикла;
	
	ВыделитьСтрокуСостоянияЗаклЗаймы(ДеревоСостояниеФондов.ПолучитьЭлементы(), ПредФондПодр, ПредФондПодрРодитель);	
КонецПроцедуры

&НаКлиенте
Функция ВыделитьСтрокуСостоянияЗаклЗаймы(СтрокиДер, ПредФондПодр, ПредФондПодрРодитель)
	Для каждого стр из СтрокиДер Цикл
		Если стр.СчетПодразделениеФонд = ПредФондПодр Тогда
			Если ПредФондПодрРодитель <> Неопределено ТОгда
				Если стр.ПолучитьРодителя()<>Неопределено и стр.ПолучитьРодителя().СчетПодразделениеФонд = ПредФондПодрРодитель Тогда
					Элементы.ДеревоСостояниеФондов1.ТекущаяСтрока = стр.получитьИдентификатор();
					Возврат истина;
				КонецЕсли;
			Иначе
				Элементы.ДеревоСостояниеФондов1.ТекущаяСтрока = стр.получитьИдентификатор();
				Возврат Истина;
			КонецЕсли;
		КонецЕсли;
		
		Если ВыделитьСтрокуСостоянияЗаклЗаймы(стр.ПолучитьЭлементы(), ПредФондПодр, ПредФондПодрРодитель) Тогда 
			возврат истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат ложь;
КонецФункции


