&НаКлиенте
Процедура ИзменениеГалочекВыбор()
	Элементы.ОдобритьВыбранныеЗаказы.Доступность = ложь;
	Элементы.ОтклонитьВыбранныеЗаказы.Доступность = ложь;
	
	ОбновитьСерыйВыбор(ДеревоЗП.ПолучитьЭлементы());
КонецПроцедуры

&НаКлиенте
Процедура НовыйСтатусВыбранных(СтрокиДер, статус)
	Для каждого стр из СтрокиДер Цикл
		Если стр.ВыбратьСтр и ЗначениеЗаполнено(стр.Заказ) Тогда
			//стр.Статус = статус;
			Если статус = "Одобрить" Тогда
				ОбработатьСменуСтатусаСтрокиЗаказа(стр, статус, стр.Сумма);
			Иначе
				ОбработатьСменуСтатусаСтрокиЗаказа(стр, статус, 0);
			КонецЕсли;
			
			стр.СтатусНомер = НомерСтатуса(стр.Статус);
			
			Если СостояниеЗаказаОдобренКлиент.найти(стр.статус)<> Неопределено И статус = "Одобрить" тогда
				стр.УтвержденнаяСумма = стр.Сумма;
			Иначе
				стр.УтвержденнаяСумма = 0;
			КонецЕсли;
			
			стр.ОстатокПоЗаказу = стр.Сумма - стр.УтвержденнаяСумма;			
		КонецЕсли;
		
		НовыйСтатусВыбранных(стр.ПолучитьЭлементы(), статус);
		
		стр.ВыбратьСтр = ложь;
	КонецЦикла;	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСерыйВыбор(СтрокиДер)
	Для каждого стр из СтрокиДер Цикл
		ЕстьВыб = ложь;
		ЕстьНеВыб = ложь;
		Для каждого стрПодч из стр.ПолучитьЭлементы() Цикл
			Если стрПодч.ВыбратьСтр Тогда
				ЕстьВыб = истина;
			Иначе
				ЕстьНеВыб = истина;
			КонецЕсли;
		КонецЦикла;
		
		стр.СерыйВыбор = ЕстьВыб и ЕстьНеВыб;
		
		Если ЕстьВыб и Элементы.ОдобритьВыбранныеЗаказы.Доступность = ложь тогда
			Элементы.ОдобритьВыбранныеЗаказы.Доступность = истина;
			Элементы.ОтклонитьВыбранныеЗаказы.Доступность = Истина;
		КонецЕсли;
		
		ОбновитьСерыйВыбор(стр.ПолучитьЭлементы());
	КонецЦикла;	
КонецПроцедуры

