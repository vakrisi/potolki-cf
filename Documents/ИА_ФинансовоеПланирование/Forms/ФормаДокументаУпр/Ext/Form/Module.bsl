&НаКлиенте
Процедура ПересчитатьДерево()
	ДеревоЗПИсходнаяСумма = 0;
	ДеревоЗПНачислениеВФонд = 0;
	ДеревоЗПСумма = 0;
	ДеревоЗПУтвержденнаяСумма = 0;
	ДеревоЗПРанееВыделено = 0;
	ДеревоЗПОстатокПоЗаказу = 0;
	Для каждого стр Из  ДеревоЗП.ПолучитьЭлементы() Цикл
		ПересчитатьДеревоИтоги(стр);
		
		// для подвала:
		ДеревоЗПИсходнаяСумма = ДеревоЗПИсходнаяСумма + стр.ИсходнаяСумма;
		ДеревоЗПНачислениеВФонд = ДеревоЗПНачислениеВФонд + стр.НачислениеВФонд;
		ДеревоЗПСумма = ДеревоЗПСумма + стр.Сумма;
		ДеревоЗПУтвержденнаяСумма = ДеревоЗПУтвержденнаяСумма + стр.УтвержденнаяСумма;
		ДеревоЗПРанееВыделено = ДеревоЗПРанееВыделено + стр.РанееВыделено;
		ДеревоЗПОстатокПоЗаказу = ДеревоЗПОстатокПоЗаказу + стр.ОстатокПоЗаказу;
	КонецЦикла;
КонецПроцедуры
	
&НаКлиенте
Процедура ПересчитатьДеревоИтоги(СтрокаДерева)
	
	Если (ЗначениеЗаполнено(СтрокаДерева.Счет) или ЗначениеЗаполнено(СтрокаДерева.Подразделение)) и не ЗначениеЗаполнено(СтрокаДерева.Фонд) Тогда // группировки выше фонда
		СтрКлючи = "ИсходнаяСумма,Сумма,НачислениеВФонд,УтвержденнаяСумма,РанееВыделено,ОстатокПоЗаказу";
		ТекИтоги = новый Структура(СтрКлючи,0,0,0,0,0,0);
	Иначе
		СтрКлючи = "ИсходнаяСумма,Сумма,УтвержденнаяСумма,РанееВыделено,ОстатокПоЗаказу";
		ТекИтоги = новый Структура(СтрКлючи,0,0,0,0,0);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтрокаДерева.Заказ) Тогда
		возврат;
	Иначе
		Для каждого стр Из  СтрокаДерева.ПолучитьЭлементы() Цикл		
			ПересчитатьДеревоИтоги(стр);
			Для каждого кл из ТекИтоги Цикл
				ТекИтоги[кл.Ключ] = ТекИтоги[кл.Ключ]+стр[кл.Ключ];
			КонецЦикла;		
		КонецЦикла;
		ЗаполнитьЗначенияСвойств(СтрокаДерева,ТекИтоги);
	КонецЕсли;
	
КонецПроцедуры


