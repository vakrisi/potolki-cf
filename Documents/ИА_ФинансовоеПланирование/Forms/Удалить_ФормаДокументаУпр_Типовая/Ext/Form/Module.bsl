	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ИА_ОткорректированныйПланПродажСрезПоследних.Неделя КАК Неделя,
	|	ИА_ОткорректированныйПланПродажСрезПоследних.Контрагент,
	|	ИА_ОткорректированныйПланПродажСрезПоследних.Продукт,
	|	ИА_ОткорректированныйПланПродажСрезПоследних.Действия,
	|	ИА_ОткорректированныйПланПродажСрезПоследних.Источник,
	|	ИА_ОткорректированныйПланПродажСрезПоследних.Сумма,
	|	ИА_ОткорректированныйПланПродажСрезПоследних.Факт
	|ИЗ
	|	РегистрСведений.ИА_ОткорректированныйПланПродаж.СрезПоследних(
	|			&наДату,
	|			НаМесяц = &НаМесяц
	|				И Организация = &Организация) КАК ИА_ОткорректированныйПланПродажСрезПоследних
	|
	|УПОРЯДОЧИТЬ ПО
	|	Неделя
	|ИТОГИ
	|	МАКСИМУМ(Неделя)
	|ПО
	|	Неделя";
	Запрос.УстановитьПараметр("НаМесяц", Объект.МесяцПланирования);
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	Запрос.УстановитьПараметр("наДату", Объект.Дата);
	
	Дер = Запрос.Выполнить().Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Для каждого стрНеделя из Дер.Строки Цикл
		НовСтрНед = ДеревоПланКоррекция.ПолучитьЭлементы().Добавить();
		НовСтрНед.Неделя = стрНеделя.неделя;
		НовСтрНед.ЭтоНеделя = Истина;
		
		для каждого стрПлан из стрНеделя.Строки Цикл
			Если не ЗначениеЗаполнено(стрПлан.Сумма) и не ЗначениеЗаполнено(стрПлан.Факт) Тогда
				Продолжить;
			КонецЕсли;
			
			новСтрПлан = НовСтрНед.ПолучитьЭлементы().Добавить();
			ЗаполнитьЗначенияСвойств(новСтрПлан, стрПлан);
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры

