&НаКлиенте
Процедура ПересчитатьОтклонениеСуммуВСтроках()
	КоррПланСумма = 0;
	КоррПланФакт = 0;
	КоррПланОтклонение = 0;
	
	Для каждого стрНед из ДеревоПланКоррекция.ПолучитьЭлементы() Цикл
		ОтклИтого = 0;
		СуммаИтого = 0;
		ФактИтого = 0;
		Для каждого стрПлан из стрНед.ПолучитьЭлементы() Цикл
			стрПлан.отклонение = стрПлан.Сумма - стрПлан.Факт;
			ОтклИтого = ОтклИтого + стрПлан.отклонение;
			СуммаИтого = СуммаИтого + стрПлан.Сумма;
			ФактИтого = ФактИтого + стрПлан.Факт;
		КонецЦикла;
		стрНед.Отклонение = ОтклИтого;
		стрНед.Сумма = СуммаИтого;
		стрНед.Факт = ФактИтого;
		
		КоррПланСумма = КоррПланСумма + СуммаИтого;
		КоррПланФакт = КоррПланФакт + ФактИтого;
		КоррПланОтклонение = КоррПланОтклонение + ОтклИтого;
	КонецЦикла;
	
	Если ИтогоИсходныйПлан <> 0 Тогда
		ПроцентВыполненияПлана = КоррПланФакт / ИтогоИсходныйПлан * 100;
	Иначе
		ПроцентВыполненияПлана = 100;
	КонецЕсли;
	ОсталосьДоВыполнения = ИтогоИсходныйПлан - КоррПланФакт; 
КонецПроцедуры


