&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если не ИА_Защита_Общий.ЛицензияДоступна("ФП") Тогда
		Отказ = Истина;
		возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Объект.Дата = ТекущаяДата();
		ОбновитьДокумент();
		ОбновитьЗНО_Сервер();
	Иначе
		ПриОткрытииНаСервере1();
		
		ПересчитатьДерево();

		ПересчитатьИтогиПоЗаказам();
	КонецЕсли;
	
	//Если Объект.ПериодФП1 = Дата(1,1,1) Тогда
	//	ЗаполнитьДатуФП1();
	//КонецЕсли;
	
	
	Элементы.РаспределениеСредствСФондов.Видимость = ИспользоватьРаспределениеСФондов;
	Элементы.ГруппаЗаголовокСпецдоход.Видимость = ИспользоватьСпецдоход;
	Элементы.ДоходыБП.Видимость = ИспользоватьСпецдоход;
	Элементы.ДоходыБП_Распределение.Видимость = ИспользоватьСпецдоход;
	
	//Элементы.ГруппаЛев.Видимость = Ложь;//Без этого ФП1 не отображается
	
	Элементы.Организация.Видимость = ФППоОрганизациям;
	ОбновитьОтображениеПоНалБезнал();
	ОбновитьОтображениеИтого();
	
	ОбновитьОтчетПоСотояниюФондов(); 	
	
	ПодключитьОбработчикОжидания("ПроверитьИзменениеРазмераОкна", 1, ложь);	
	
	Попытка
		ФормаСтатистик = ПолучитьФорму("Обработка.ИА_РабочийСтолСтатистик_Упр_HTML.Форма",,, ЭтаФорма.УникальныйИдентификатор);
	Исключение
	КонецПопытки;
	
	// заглушка для отрисовки статистик
	sw = 1000;
	sw1 = 410;
	
	ИтогиФП1();
КонецПроцедуры

&НаСервере
Процедура ПриОткрытииНаСервере1()
	
	ЗаполнитьТаблицуЗП(Истина);
	ЗаполнитьЗНО_Док();
	
	ЗаполнитьТаблицуПолитика(Неопределено);
	ПересчитатьПолитику("ДеревоПолитика",,,ложь);
	
	ЗаполнитьТаблицуПолитикаПервичная(Неопределено);
	ПересчитатьПолитику("ДеревоПолитикаПервичная",,,ложь);
	
	ПересчитатьСальдоСредствКРаспределению();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьЗНО_Док()
	Для каждого стр из Объект.ЗНО Цикл
		Новстр = ТаблицаЗНО.Добавить();
		ЗаполнитьЗначенияСвойств(Новстр, стр);
		ЗаполнитьЗначенияСвойств(Новстр, стр.Заказ,,"ПричинаОтказа,Статус");
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьОтображениеИтого()
	КоллекцияДоходы = ЭтаФорма.Объект.Доходы;
	Для Каждого Стр Из КоллекцияДоходы Цикл
		Стр.Итого = Стр.СуммаНал + Стр.СуммаБезнал;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура КомандаОбновитьДокумент(Команда) Экспорт	
	ОбновитьДокумент();
	Если ИспользоватьСпецдоход тогда
		ОбновитьДоходыБП();
	КонецЕсли;
	ОсновнойПерерасчет(1);
	ОбновлениеОтображения();
КонецПроцедуры

&НаКлиенте
Процедура КомандаОбновитьПроценты1(Команда)
	
	ОбновитьПроцентыПолитикиИПересчитать(1);
КонецПроцедуры

&НаКлиенте
Процедура КомандаОбновитьПроценты2(Команда)
	
	ОбновитьПроцентыПолитикиИПересчитать(2);
КонецПроцедуры

&НаКлиенте
Процедура КомандаОбновитьРаспределениеСпецдохода(Команда)
	ОбновитьДоходыБП();
	ОсновнойПерерасчет(4);
КонецПроцедуры

&НаКлиенте
Процедура КомандаПодобрать(Команда)
	
	ф = ПолучитьФорму("Документ.ИА_ФинансовоеПланирование.Форма.ФормаПодбораДБПУпр");
	ф.Док = Объект.Ссылка;
	ф.Организация = Объект.Организация;
	рез = ф.ОткрытьМодально();
	
	Если рез = истина Тогда
		Для каждого стр из ф.ТаблицаДоходов Цикл
			Если стр.Выбрать Тогда
				Новстр = Объект.ДоходыБП_Распределение.Добавить();
				ЗаполнитьЗначенияСвойств(Новстр, стр);
			КонецЕсли;
		КонецЦикла;
		ОсновнойПерерасчет(4);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОрганизацияПриИзменении(Элемент)
	//
	Объект.Организация = ИА_ФП.ПолучитьГоловнуюОрганизацию(Объект.Организация);
	//
	
	Если ЗначениеЗаполнено(Объект.Ссылка) и Объект.ДоходыБП_Распределение.Количество()> 0 И вопрос("Таблица будет очищена. Продолжить?", РежимДиалогаВопрос.ДаНет)=КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли;
	ОбновитьДокумент();
КонецПроцедуры

&НаСервере
Процедура ОбновитьДокумент() Экспорт		
	
	ПредФп = ПолучитьПоследнееФП();
	ДатаПредыдущегоФП = ПредФп.Дата;
	//
	
	Объект.Доходы.Очистить();
	Объект.ПолитикаРаспределения.Очистить();
	Объект.ПолитикаРаспределенияПервичная.Очистить();
	
	Если ИспользоватьСлужебнуюНастройку Тогда
		НастройкаФП = Неопределено;
		СлужебнаяНастройкаФП_Стр = ЗначениеИзСтрокиВнутр(СлужебнаяНастройкаФП);
		Объект.Доходы.Загрузить(СлужебнаяНастройкаФП_Стр.Доходы);
	Иначе
		НастройкаФП = ИА_ФП.ПолучитьПоследнююНастройку(Объект.Организация, ФППоОрганизациям, ?(ЗначениеЗаполнено(Объект.Дата) , Объект.Дата, ТекущаяДата()));
		Объект.Доходы.Загрузить(НастройкаФП.Доходы.Выгрузить());
	КонецЕсли;
	
	ЗаполнитьТаблицуПолитика(НастройкаФП);
	ЗаполнитьТаблицуПолитикаПервичная(НастройкаФП);
	
	Если ИспользоватьСпецдоход Тогда
		ОбновитьДоходыБПСервер();
	КонецЕсли;
	
	//
	ПересчитатьЗапросы();
	//
	ОсновнойПерерасчет(1);
	//
	//ОбновитьСреднееФП1();
КонецПроцедуры

&НаСервере
Процедура ПересчитатьЗапросы()
	Объект.ЗапросыДанных.Очистить();
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ИА_ЗапросыДанныхФондов.Ссылка,
	|	""[Запрос:"" + ИА_ЗапросыДанныхФондов.Наименование + ""]"" КАК Наименование
	|ИЗ
	|	Справочник.ИА_ЗапросыДанныхФондов КАК ИА_ЗапросыДанныхФондов
	|ГДЕ
	|	ИА_ЗапросыДанныхФондов.ПометкаУдаления = ЛОЖЬ";
	
	тз_Запросы = Запрос.Выполнить().Выгрузить();
	
	Если тз_Запросы.Количество() = 0 Тогда
		Объект.ЗапросыДанных.Очистить();
		Возврат;	
	КонецЕсли;
	
	ИспЗапросы = Новый СписокЗначений;
	Для каждого стрР из ДеревоПолитика.ПолучитьЭлементы() Цикл
		Для каждого стрФ из стрР.ПолучитьЭлементы() Цикл
			Для каждого стрЗапр из тз_Запросы Цикл
				Если (найти(стрФ.Значение,стрЗапр.Наименование)>0 ИЛИ найти(стрФ.ЗначениеБезнал,стрЗапр.Наименование)>0) И ИспЗапросы.НайтиПоЗначению(стрЗапр.Ссылка) = Неопределено Тогда
					ИспЗапросы.Добавить(стрЗапр.Ссылка, стрЗапр.Наименование); 
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	Для каждого стрР из ДеревоПолитикаПервичная.ПолучитьЭлементы() Цикл
		Для каждого стрФ из стрР.ПолучитьЭлементы() Цикл
			Для каждого стрЗапр из тз_Запросы Цикл
				Если (найти(стрФ.Значение,стрЗапр.Наименование)>0 ИЛИ найти(стрФ.ЗначениеБезнал,стрЗапр.Наименование)>0) И ИспЗапросы.НайтиПоЗначению(стрЗапр.Ссылка) = Неопределено Тогда
					ИспЗапросы.Добавить(стрЗапр.Ссылка, стрЗапр.Наименование); 
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	
	Для каждого Запр из ИспЗапросы Цикл
		Запрос = Новый Запрос;	
		Запрос.Текст = Запр.Значение.ТекстЗапроса;
		Запрос.УстановитьПараметр("Организация", Объект.Организация);
		Запрос.УстановитьПараметр("ДатаНачала", ДатаПредыдущегоФП);
		Запрос.УстановитьПараметр("ДатаКонца", ?(ЗначениеЗаполнено(Объект.Дата) , Объект.Дата-1, ТекущаяДата()-1));
		
		парам = Запр.Значение.ТабПараметровЗапроса.Получить();
		Если парам <> Неопределено Тогда
			Для каждого стр из парам Цикл
				Запрос.УстановитьПараметр(стр.ИмяПараметра, стр.Значение);
			КонецЦикла;
		КонецЕсли;
		
		тз = Запрос.Выполнить().Выгрузить();
		
		НовСтр = Объект.ЗапросыДанных.Добавить();
		НовСтр.Запрос = Запр.Значение;
		НовСтр.ИмяПараметра = Запр.Представление;
		НовСтр.Сумма = тз.Итог("Сумма");
		Если РазделятьНалБезнал и тз.Колонки.Найти("СуммаНал")<>Неопределено Тогда
			НовСтр.СуммаНал = тз.Итог("СуммаНал");
		КонецЕсли;
		НовСтр.Расшифровка = ЗначениеВСтрокуВнутр(тз);
	КонецЦикла;
	
КонецПроцедуры

