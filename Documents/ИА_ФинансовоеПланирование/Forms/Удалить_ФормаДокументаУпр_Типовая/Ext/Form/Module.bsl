&НаКлиенте
Процедура ДеревоПолитикаПервичнаяСуммаПриИзмененииОбрабочик()
	ТекДанные = Элементы.ДеревоПолитикаПервичная.ТекущиеДанные; 
	
	ТекРаздел = ТекДанные.Раздел;	
	ТекФонд = ТекДанные.Фонд;
	ТекПодразделение = ТекДанные.Подразделение;
	
	ПересчитатьПолитику("ДеревоПолитикаПервичная",ТекРаздел,ТекФонд);
	ОсновнойПерерасчет(3);
	
	ПредСтрока = ПолучитьСтрокуПолитика1(ТекРаздел, ТекФонд, ТекПодразделение);
	Если ПредСтрока <> Неопределено Тогда
		Элементы.ДеревоПолитикаПервичная.ТекущаяСтрока = ПредСтрока;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Функция ПолучитьСтрокуПолитика1(раздел, фонд, подразделение,ФП1 = Ложь)
	Если ФП1 Тогда
		дер = ДеревоПолитикаПервичнаяФП1;
	Иначе
		дер = ДеревоПолитикаПервичная;
	КонецЕсли;
	Для каждого стрРаздел из дер.ПолучитьЭлементы() Цикл
		Если стрРаздел.раздел = раздел Тогда
			Для каждого стрФонд из стрРаздел.ПолучитьЭлементы() Цикл
				Если стрФонд.фонд = фонд И стрФонд.подразделение = подразделение Тогда
					Возврат стрФонд.ПолучитьИдентификатор();
				КонецЕсли;			
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Неопределено;
КонецФункции

