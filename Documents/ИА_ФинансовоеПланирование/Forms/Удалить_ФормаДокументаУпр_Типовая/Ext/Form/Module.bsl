Процедура ПогаситьЗайм(Команда)
	
	ф = ПолучитьФорму("Документ.ИА_ФинансовоеПланирование.Форма.ФормаПодбораЗайма");
	ф.ДатаДок = Объект.Дата;
	ф.Организация = Объект.Организация;
	рез = ф.ОткрытьМодально();
	
	Если рез = истина Тогда
		
		Для каждого стр из ф.ТаблицаЗаймов Цикл
			
			Если стр.Выбрать Тогда
				Новстр = Объект.РаспределениеПоФондам.Добавить();
				ЗаполнитьЗначенияСвойств(Новстр, стр);
				Новстр.ЗаймВозврат = ПредопределенноеЗначение("Перечисление.ИА_ЗаймВозврат.Возврат");
			КонецЕсли;
			
		КонецЦикла;
		
		ОбновитьОтчетПоСотояниюФондов();
		
	КонецЕсли;
	
КонецПроцедуры


