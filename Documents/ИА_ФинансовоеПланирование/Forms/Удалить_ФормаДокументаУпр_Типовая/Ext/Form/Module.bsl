&НаСервере
Функция ПолучитьМесяцИНеделюПланирования()
	Запрос = новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ИА_РаспределениеНедель.Месяц,
	|	ИА_РаспределениеНедель.Период
	|ИЗ
	|	РегистрСведений.ИА_РаспределениеНедель КАК ИА_РаспределениеНедель
	|ГДЕ
	|	ИА_РаспределениеНедель.Период <= &Период
	|	И ДОБАВИТЬКДАТЕ(ИА_РаспределениеНедель.Период, ДЕНЬ, 7) > &Период";
	Запрос.УстановитьПараметр("Период", НачалоДня(?(Объект.НачалоПланирования, Объект.Дата, Объект.Дата+60*60*24)));
	Выборка = Запрос.Выполнить().Выбрать();
	
	Модиф = Модифицированность;
	
	Объект.МесяцПланирования = Дата(1,1,1);
	Объект.НеделяПланирования = Дата(1,1,1);
	
	Если Выборка.Следующий() Тогда
		Объект.МесяцПланирования = Выборка.Месяц;
		Объект.НеделяПланирования = Выборка.Период;
	КонецЕсли;
	
	Модифицированность = Модиф;
КонецФункции

&НаСервере
Процедура ЗаполнитьИсходныйПлан()
	ПолучитьМесяцИНеделюПланирования();
	
	Строки = ДеревоПланИсходный.ПолучитьЭлементы();
	Строки.Очистить();
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ИА_ИсходныйПланПродаж.Период КАК Неделя,
	|	ИА_ИсходныйПланПродаж.Контрагент,
	|	ИА_ИсходныйПланПродаж.Продукт,
	|	ИА_ИсходныйПланПродаж.Действия,
	|	ИА_ИсходныйПланПродаж.Источник,
	|	ИА_ИсходныйПланПродаж.Сумма
	|ИЗ
	|	РегистрСведений.ИА_ИсходныйПланПродаж КАК ИА_ИсходныйПланПродаж
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ИА_РаспределениеНедель КАК ИА_РаспределениеНедель
	|		ПО ИА_ИсходныйПланПродаж.Период = ИА_РаспределениеНедель.Период
	|			И (ИА_РаспределениеНедель.Месяц = &Месяц)
	|ГДЕ
	|	ИА_ИсходныйПланПродаж.Организация = &Организация
	|
	|УПОРЯДОЧИТЬ ПО
	|	Неделя
	|ИТОГИ
	|	МАКСИМУМ(Неделя)
	|ПО
	|	Неделя";
	Запрос.УстановитьПараметр("Месяц", Объект.МесяцПланирования);
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	
	Дер = Запрос.Выполнить().Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Для каждого стрНеделя из Дер.Строки Цикл
		НовСтрНед = ДеревоПланИсходный.ПолучитьЭлементы().Добавить();
		НовСтрНед.Неделя = стрНеделя.неделя;
		НовСтрНед.ЭтоНеделя = Истина;
		
		для каждого стрПлан из стрНеделя.Строки Цикл
			Если не ЗначениеЗаполнено(стрПлан.Сумма) Тогда
				Продолжить;
			КонецЕсли;
			
			новСтрПлан = НовСтрНед.ПолучитьЭлементы().Добавить();
			ЗаполнитьЗначенияСвойств(новСтрПлан, стрПлан);
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры

