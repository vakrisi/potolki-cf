Процедура ДеревоПолитика2СуммаПриИзмененииОбрабочик()
	ТекДанные = Элементы.ДеревоПолитика.ТекущиеДанные; 
	
	ТекРаздел = ТекДанные.Раздел;	
	ТекФонд = ТекДанные.Фонд;
	ТекПодразделение = ТекДанные.Подразделение;
	
	ПересчитатьПолитику("ДеревоПолитика",ТекРаздел, ТекФонд);
	ОсновнойПерерасчет(5);
	ОбновлениеОтображения();
	
	ПредСтрока = ПолучитьСтрокуПолитика2(ТекРаздел, ТекФонд, ТекПодразделение);
	Если ПредСтрока <> Неопределено Тогда
		Элементы.ДеревоПолитика.ТекущаяСтрока = ПредСтрока;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Функция ПолучитьСтрокуПолитика2(раздел, фонд, подразделение,ФП1 = Ложь)
	Если ФП1 Тогда
		дер = ДеревоПолитикаФП1;
	Иначе
		дер = ДеревоПолитика;
	КонецЕсли;
	
	Для каждого стрРаздел из дер.ПолучитьЭлементы() Цикл
		Если стрРаздел.раздел = раздел Тогда
			Для каждого стрФонд из стрРаздел.ПолучитьЭлементы() Цикл
				Если стрФонд.фонд = фонд И стрФонд.подразделение = подразделение Тогда
					Возврат стрФонд.ПолучитьИдентификатор();
				КонецЕсли;			
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Неопределено;
КонецФункции

