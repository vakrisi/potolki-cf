&НаСервере
Функция ПриИзмененииВДеревеЗаказов(ИзменениеСтатусаСуммыУтв = Ложь, СтрукТекСтр = Неопределено)
	Модифицированность = Истина;
	ПересчитатьСальдоСредствКРаспределению();
	
	БылиИзменения = Ложь;
	нал = истина;
	ЕстьОшибка = Ложь;
	НехваткаСуммы = 0;
	
	Если ИзменениеСтатусаСуммыУтв и СтрукТекСтр <> Неопределено Тогда
		Если ЗначениеЗаполнено(СтрукТекСтр.Заказ) и СтрукТекСтр.Статус = ИА_СостояниеЗаказаОдобрен Тогда // проконтролируем сумму
			//ВыходнаяТаблица = Новый ТаблицаЗначений;
			ОбновитьОтчетПоСотояниюФондов(ВыходнаяТаблица);
			СтрПоиска = Новый Структура("Фонд,Подразделение", СтрукТекСтр.Фонд, СтрукТекСтр.Подразделение);
			НСтроки = ВыходнаяТаблица.НайтиСтроки(СтрПоиска); 
			Если НСтроки.Количество()>0 Тогда
				СтрокаСостояния = НСтроки[0];
				Если СтрукТекСтр.СуммаНал > 0 Тогда
					Если СтрокаСостояния.ПослеФП_ОстатокНал < 0 Тогда
						ЕстьОшибка = Истина;
						НехваткаСуммы = -СтрокаСостояния.ПослеФП_ОстатокНал; 
					КонецЕсли;
				Иначе
					Если СтрокаСостояния.ПослеФП_ОстатокБезНал < 0 Тогда
						ЕстьОшибка = Истина;
						НехваткаСуммы = -СтрокаСостояния.ПослеФП_ОстатокБезНал; 
					КонецЕсли;
					нал = Ложь;
				КонецЕсли;
				
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Струк = Новый Структура("Нал,НехваткаСуммы,ЕстьОшибка", нал, НехваткаСуммы,ЕстьОшибка);
	Возврат Струк;
	
КонецФункции

&НаКлиенте
Процедура КомандаПомощникПополненияФонда(Команда)
	
	тд = Элементы.ДеревоЗП.ТекущиеДанные;
	
	Если Элементы.ДеревоЗП.ТекущаяСтрока <> Неопределено Тогда
		СтрукТекСтр = Новый Структура("Фонд,Подразделение,Статус,Заказ,СуммаНал", Элементы.ДеревоЗП.ТекущиеДанные.Фонд, Элементы.ДеревоЗП.ТекущиеДанные.Подразделение,Элементы.ДеревоЗП.ТекущиеДанные.Статус,Элементы.ДеревоЗП.ТекущиеДанные.Заказ,Элементы.ДеревоЗП.ТекущиеДанные.СуммаНал);
		стр = ПриИзмененииВДеревеЗаказов(истина,СтрукТекСтр);
		// возвращаем текущую строку
		ИдентификаторСтроки = 0; 
		ПрекратитьПоиск = Ложь; 
		НайтиСтрокуДерева(ДеревоЗП.ПолучитьЭлементы(), тд, ИдентификаторСтроки, ПрекратитьПоиск); 
		Элементы.ДеревоЗП.ТекущаяСтрока = ИдентификаторСтроки;
		
		БылиИзменения = Ложь;
		Если стр.ЕстьОшибка Тогда
			ПараметрыИзФормы = Новый Структура;	
			ПараметрыИзФормы.Вставить("ВыходнаяТаблица", ВыходнаяТаблица);
			ПараметрыИзФормы.Вставить("Нал", стр.Нал);
			ПараметрыИзФормы.Вставить("Подразделение", Элементы.ДеревоЗП.ТекущиеДанные.Подразделение);
			ПараметрыИзФормы.Вставить("Фонд", Элементы.ДеревоЗП.ТекущиеДанные.Фонд);
			ПараметрыИзФормы.Вставить("СальдоСредствКРаспределению", ?(стр.нал, Объект.СальдоСредствКРаспределениюНал, Объект.СальдоСредствКРаспределениюБезнал));
			ПараметрыИзФормы.Вставить("ИсходнаяСумма", стр.НехваткаСуммы);
			ПараметрыОтбора = Новый Структура("ПараметрыОтбора", ПараметрыИзФормы);
			
			рез = ОткрытьФормуМодально("Документ.ИА_ФинансовоеПланирование.Форма.ФормаПомощникПоЗаказуУпр",ПараметрыОтбора);
			БылиИзменения = Ложь;
			ТекСтрока = Элементы.ДеревоЗП.ТекущиеДанные;
			Если рез <> Неопределено Тогда
				Если рез.СредстваКРаспределению тогда
					БылиИзменения = Истина;
					
					Если стр.Нал Тогда
						ТекСтрока.ПолучитьРодителя().НачислениеВФондНал = ТекСтрока.ПолучитьРодителя().НачислениеВФондНал + рез.СальдоСредствКРаспределениюВзять; 
					Иначе
						ТекСтрока.ПолучитьРодителя().НачислениеВФондБезНал = ТекСтрока.ПолучитьРодителя().НачислениеВФондБезНал + рез.СальдоСредствКРаспределениюВзять;
					КонецЕсли;
				КонецЕсли;
				
				Если рез.СДругихФондов тогда
					БылиИзменения = Истина;
					
					Для каждого стрТ из рез.ТаблицаФондов Цикл
						Если стрТ.Взять>0 Тогда
							Новстр = Объект.РаспределениеПоФондам.Добавить();
							Новстр.Подразделение = ТекСтрока.Подразделение;
							Новстр.Фонд = ТекСтрока.Фонд;
							Новстр.СПодразделения = стрТ.Подразделение;
							Новстр.СФонда = стрТ.Фонд;
							Если стр.Нал Тогда
								Новстр.СуммаНал = стрТ.Взять; 
							Иначе
								Новстр.СуммаБезНал = стрТ.Взять;
							КонецЕсли;
						КонецЕсли;
					КонецЦикла;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		Если БылиИзменения Тогда
			ПересчитатьСальдоСредствКРаспределению();
		КонецЕсли;
		ОбновитьОтчетПоСотояниюФондов();
		
		ПересчитатьДерево();
		ПересчитатьИтогиПоЗаказам();
		
		ОбновлениеОтображения();
	КонецЕсли;
КонецПроцедуры

