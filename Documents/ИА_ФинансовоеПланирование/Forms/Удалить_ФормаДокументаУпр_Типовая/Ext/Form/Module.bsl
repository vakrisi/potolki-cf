Процедура КомандаЗаполнитьДоходы(Команда)
	Объект.Доходы_Детализация.Очистить();
	Для Каждого ТекСтрока Из Объект.Доходы Цикл
		рез = КомандаЗаполнитьДоходыНаСервере(ТекСтрока.ВидДохода);
		ЗаполнитьЗначенияСвойств(ТекСтрока, рез); 
		
		ТекСтрока.Итого = ТекСтрока.СуммаБезнал + ТекСтрока.СуммаНал;
	КонецЦикла;
	
	Элементы.ДоходыИтого.ТекстПодвала = Объект.Доходы.Итог("СуммаНал") + Объект.Доходы.Итог("СуммаБезнал");
	
	СвернутьДетализацииДоходов();
	ОсновнойПерерасчет(1);
КонецПроцедуры

&НаСервере
Функция КомандаЗаполнитьДоходыНаСервере(ВидДохода)
	//Заполнение сумм по видам дохода по конструктору
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ИА_НастройкаФПДоходы.ВидДохода,
	|	ИА_НастройкаФПДоходы.ВидПолученияДанных,
	|	ИА_НастройкаФПДоходы.ТекстВыраженияЗапросаБезнал,
	|	ИА_НастройкаФПДоходы.ИмяРегистраБезнал,
	|	ИА_НастройкаФПДоходы.РесурсРегистраБезнал,
	|	ИА_НастройкаФПДоходы.Ссылка,
	|	ИА_НастройкаФПДоходы.ТекстВыраженияЗапросаНал,
	|	ИА_НастройкаФПДоходы.ИмяРегистраНал,
	|	ИА_НастройкаФПДоходы.РесурсРегистраНал,
	|	ИА_НастройкаФПДоходы.ПолеСтатьяДДСБезнал,
	|	ИА_НастройкаФПДоходы.ПолеСтатьяДДСНал
	|ИЗ
	|	Документ.ИА_НастройкаФП.Доходы КАК ИА_НастройкаФПДоходы
	|ГДЕ
	|	ИА_НастройкаФПДоходы.ВидДохода = &ВидДохода
	|	И (ИА_НастройкаФПДоходы.Ссылка.Организация = &Организация
	|			ИЛИ &НеРазделять)
	|	И ИА_НастройкаФПДоходы.Ссылка.Дата <= &Дата
	|	И ИА_НастройкаФПДоходы.Ссылка.Проведен
	|
	|УПОРЯДОЧИТЬ ПО
	|	ИА_НастройкаФПДоходы.Ссылка.Дата УБЫВ";
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	Запрос.УстановитьПараметр("НеРазделять", не ФППоОрганизациям);
	Запрос.УстановитьПараметр("Дата", ?(ЗначениеЗаполнено(Объект.Дата) , Объект.Дата, ТекущаяДата()));
	Запрос.УстановитьПараметр("ВидДохода", ВидДохода);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Количество() = 0 Тогда
		//Если попали сюда, то в последних настройках ФП не указан данный вид доходов 
		Сообщить("Вид доходов (" + ВидДохода.Наименование + ") не указан в последнем документе настройки финпланирования");
	КонецЕсли;
	
	//Определим период выборки данных
	КонецПериода = Объект.Дата;
	НачалоПериода = Дата(1,1,1);
	
	ЗапросНачПериода = Новый Запрос;
	ЗапросНачПериода.УстановитьПараметр("КонецПериода", КонецПериода);
	ЗапросНачПериода.УстановитьПараметр("Организация", Объект.Организация);
	ЗапросНачПериода.УстановитьПараметр("НеРазделять", не ФППоОрганизациям);
	
	ЗапросНачПериода.Текст =
	
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ИА_ФинансовоеПланированиеДоходы.Ссылка.Дата КАК Дата
	|ИЗ
	|	Документ.ИА_ФинансовоеПланирование.Доходы КАК ИА_ФинансовоеПланированиеДоходы
	|ГДЕ
	|	ИА_ФинансовоеПланированиеДоходы.Ссылка.Дата < &КонецПериода
	|	И (ИА_ФинансовоеПланированиеДоходы.Ссылка.Организация = &Организация
	|			ИЛИ &НеРазделять)
	|	И ИА_ФинансовоеПланированиеДоходы.Ссылка.Проведен
	|	И НЕ (ИА_ФинансовоеПланированиеДоходы.СуммаБезнал + ИА_ФинансовоеПланированиеДоходы.СуммаНал) = 0
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата УБЫВ";
	ВыборкаНачПериода = ЗапросНачПериода.Выполнить().Выбрать();
	Пока ВыборкаНачПериода.Следующий() Цикл
		НачалоПериода = ВыборкаНачПериода.Дата + 1;			
	КонецЦикла;
	
	Выборка.Следующий();
	Рез = ИА_ФП.ПолучитьСуммуПоВидуДохода(Выборка, НачалоПериода, КонецПериода, Объект.Доходы_Детализация);    
	
	Возврат Рез;
КонецФункции

&НаСервере
Процедура СвернутьДетализацииДоходов()
	ТаблицаСвертывания = Объект.Доходы_Детализация.Выгрузить();
	ТаблицаСвертывания.Свернуть("Документ, Контрагент, Ответственный, Валюта, ВидДохода", "Сумма,СуммаНал");
	Объект.Доходы_Детализация.Загрузить(ТаблицаСвертывания);
КонецПроцедуры

