&НаСервере
Процедура ОбновитьДокументФП1() 
	
	Объект.ДоходыФП1.Очистить();
	Объект.ПолитикаРаспределенияФП1.Очистить();
	Объект.ПолитикаРаспределенияПервичнаяФП1.Очистить();
	
	НастройкаФП = ИА_ФП.ПолучитьПоследнююНастройку(Объект.Организация, ФППоОрганизациям, ?(ЗначениеЗаполнено(Объект.Дата) , Объект.Дата, ТекущаяДата()));
	Объект.ДоходыФП1.Загрузить(НастройкаФП.Доходы.Выгрузить());
	
	ЗаполнитьТаблицуПолитика(НастройкаФП,Истина);
	ЗаполнитьТаблицуПолитикаПервичная(НастройкаФП,Истина);
	
	ОсновнойПерерасчетФП1(1);
	
КонецПроцедуры

&НаСервере
Процедура ОсновнойПерерасчетФП1(Глубина)
	
	Если Глубина <= 2 Тогда // изменение прямых расходов
		ПересчитатьПредварительнуюСуммуКРаспределению1ФП1();
		ПересчитатьПолитику("ДеревоПолитикаПервичная",,,,истина);
	КонецЕсли;
	
	Если Глубина <= 3 Тогда // изменение политики 1
		ПересчитатьПредварительнуюСуммуКРаспределениюФП1();
	КонецЕсли;	
	
	Если Глубина <= 4 Тогда // изменение спецдохода
		Объект.МаржинальнаяПрибыльБезналФП1 = Объект.ПредварительнаяСуммаКРаспределениюБезналФП1 ;
		ПересчитатьПолитику("ДеревоПолитика",,,,истина);
	КонецЕсли;	
	
	Если Глубина <= 5 Тогда // изменение политики
		СуммаПолитикаБезнал = 0;
		ДеревоПолитикаЗнач  = РеквизитФормыВЗначение("ДеревоПолитикаФП1");
		
		Для каждого стр из ДеревоПолитикаЗнач.Строки Цикл
			СуммаРазделБезнал = 0;
			Для каждого стр1 Из стр.Строки Цикл
				СуммаРазделБезнал = СуммаРазделБезнал + стр1.СуммаБезнал;
			КонецЦикла;
			
			Если стр.Строки.Количество()>0 Тогда // пропускаем скд
				// итоги по разделу
				стр.СуммаБезнал = СуммаРазделБезнал;
			КонецЕсли;
			СуммаПолитикаБезнал = СуммаПолитикаБезнал + СуммаРазделБезнал;
		КонецЦикла;
		
		Объект.СуммаКРаспределениюБезналФП1 = Объект.МаржинальнаяПрибыльБезналФП1 - СуммаПолитикаБезнал + Объект.НераспределяемаяСуммаБезналФП1;		
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ПересчитатьПредварительнуюСуммуКРаспределению1ФП1()
	Объект.ПредварительнаяСуммаКРаспределениюБезнал1ФП1 = 0;
	
	Для каждого стр из Объект.ДоходыФП1 Цикл
		Если стр.ВидДохода.Распределять Тогда
			Объект.ПредварительнаяСуммаКРаспределениюБезнал1ФП1 = Объект.ПредварительнаяСуммаКРаспределениюБезнал1ФП1 + стр.СуммаБезнал;
		КонецЕсли;
	КонецЦикла;
	Объект.ПредварительнаяСуммаКРаспределениюБезнал1 = Объект.ПредварительнаяСуммаКРаспределениюБезнал1;
	
КонецПроцедуры

&НаСервере
Процедура ПересчитатьПредварительнуюСуммуКРаспределениюФП1()
	
	Объект.НераспределяемаяСуммаБезналФП1 = 0;
	Для каждого стр из Объект.ДоходыФП1 Цикл
		Если не стр.ВидДохода.Распределять Тогда
			Объект.НераспределяемаяСуммаБезналФП1 = Объект.НераспределяемаяСуммаБезналФП1 + стр.СуммаБезнал;
		КонецЕсли;
	КонецЦикла;
	
	//
	СуммаПолитикаБезнал = 0;
	
	//Минаев
	ДеревоПолитикаПервичнаяЗнач = РеквизитФормыВЗначение("ДеревоПолитикаПервичнаяФП1");
	
	Для каждого стр из ДеревоПолитикаПервичнаяЗнач.Строки Цикл
		СуммаРазделБезнал = 0;
		Для каждого стр1 Из стр.Строки Цикл
			СуммаРазделБезнал = СуммаРазделБезнал + стр1.СуммаБезнал;
		КонецЦикла;
		Если стр.Строки.Количество()>0 Тогда // пропускаем скд
			стр.СуммаБезнал = СуммаРазделБезнал;
		КонецЕсли;
		СуммаПолитикаБезнал = СуммаПолитикаБезнал + СуммаРазделБезнал;
	КонецЦикла;
	
	Объект.ПредварительнаяСуммаКРаспределениюБезналФП1 = Объект.ПредварительнаяСуммаКРаспределениюБезнал1ФП1 - СуммаПолитикаБезнал;
КонецПроцедуры

&НаКлиенте
Процедура ДоходыФП1СуммаБезналПриИзменении(Элемент)
	ОсновнойПерерасчетФП1(1);
	ИтогиФП1();
КонецПроцедуры

&НаКлиенте
Процедура ПолитикаРаспределенияПервичнаяФП1СуммаБезналПриИзменении(Элемент)
	ТекДанные = Элементы.ПолитикаРаспределенияПервичнаяФП1.ТекущиеДанные; 
	
	ТекРаздел = ТекДанные.Раздел;	
	ТекФонд = ТекДанные.Фонд;
	ТекПодразделение = ТекДанные.Подразделение;
	
	ПересчитатьПолитику("ДеревоПолитикаПервичная",ТекРаздел,ТекФонд,,истина);
	ОсновнойПерерасчетФП1(3);
	
	ПредСтрока = ПолучитьСтрокуПолитика1(ТекРаздел, ТекФонд, ТекПодразделение,истина);
	Если ПредСтрока <> Неопределено Тогда
		Элементы.ПолитикаРаспределенияПервичнаяФП1.ТекущаяСтрока = ПредСтрока;
	КонецЕсли;
	
	ИтогиФП1();
КонецПроцедуры

&НаКлиенте
Процедура ПолитикаРаспределенияФП1СуммаБезналПриИзменении(Элемент)
	ТекДанные = Элементы.ПолитикаРаспределенияФП1.ТекущиеДанные; 
	
	ТекРаздел = ТекДанные.Раздел;	
	ТекФонд = ТекДанные.Фонд;
	ТекПодразделение = ТекДанные.Подразделение;
	
	ПересчитатьПолитику("ДеревоПолитика",ТекРаздел, ТекФонд,,истина);
	ОсновнойПерерасчетФП1(5);
	
	ПредСтрока = ПолучитьСтрокуПолитика2(ТекРаздел, ТекФонд, ТекПодразделение,Истина);
	Если ПредСтрока <> Неопределено Тогда
		Элементы.ПолитикаРаспределенияФП1.ТекущаяСтрока = ПредСтрока;
	КонецЕсли;
	
	ИтогиФП1();
КонецПроцедуры

&НаКлиенте
Процедура ИтогиФП1()
	сум = 0;
	ДЛя каждого стр из Объект.ФП1 Цикл
		сум = сум + стр.СуммаБезнал;
	КонецЦикла;
	
	СуммаФП1 = сум;
	РазницаФП1 = Объект.СуммаКРаспределениюБезналФП1 -  СуммаФП1;
КонецПроцедуры


