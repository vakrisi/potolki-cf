&НаКлиенте
Процедура ПересчитатьДерево()
	
	Если ВыводитьГруппировкуПоСчетам Тогда
		ЭлементыСчета = ДеревоЗП.ПолучитьЭлементы();
		Для каждого ЭлементСчета Из  ЭлементыСчета Цикл 
			
			ЭлементСчета.ИсходнаяСумма         = 0;
			ЭлементСчета.СуммаНал              = 0;
			ЭлементСчета.СуммаБезнал           = 0;
			ЭлементСчета.УтвержденнаяСумма     = 0;
			ЭлементСчета.НачислениеВФондНал    = 0;
			ЭлементСчета.НачислениеВФондБезнал = 0;
			
			ПересчитатьДеревоПодразделения(ЭлементСчета);
			
		КонецЦикла;
	Иначе
		ПересчитатьДеревоПодразделения(ДеревоЗП);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьДеревоПодразделения(СтрокаВерхнийУровень)
	
	Если ВыводитьГруппировкуПоСчетам Тогда
		
		СтрокаВерхнийУровень.ИсходнаяСумма         = 0;
		СтрокаВерхнийУровень.СуммаНал              = 0;
		СтрокаВерхнийУровень.СуммаБезнал           = 0;
		СтрокаВерхнийУровень.УтвержденнаяСумма     = 0;
		СтрокаВерхнийУровень.НачислениеВФондНал    = 0;
		СтрокаВерхнийУровень.НачислениеВФондБезнал = 0;
		
	КонецЕсли;
	
	Для каждого стрПодр из СтрокаВерхнийУровень.ПолучитьЭлементы() Цикл
		стрПодр.ИсходнаяСумма = 0;
		стрПодр.СуммаНал = 0;
		стрПодр.СуммаБезнал = 0;
		стрПодр.УтвержденнаяСумма = 0;
		стрПодр.НачислениеВФондНал = 0;
		стрПодр.НачислениеВФондБезнал = 0;
		Для каждого стрФонд из стрПодр.ПолучитьЭлементы() Цикл
			стрФонд.ИсходнаяСумма = 0;
			стрФонд.СуммаНал = 0;
			стрФонд.СуммаБезнал = 0;
			стрФонд.УтвержденнаяСумма = 0;
			Для каждого стрЗаказ из стрФонд.ПолучитьЭлементы() Цикл
				стрФонд.ИсходнаяСумма = стрФонд.ИсходнаяСумма + стрЗаказ.ИсходнаяСумма;
				стрФонд.СуммаНал =  стрФонд.СуммаНал + стрЗаказ.СуммаНал;
				стрФонд.СуммаБезнал =  стрФонд.СуммаБезнал + стрЗаказ.СуммаБезнал;
				стрФонд.УтвержденнаяСумма =  стрФонд.УтвержденнаяСумма + стрЗаказ.УтвержденнаяСумма;
			КонецЦикла;
			
			стрПодр.ИсходнаяСумма = стрПодр.ИсходнаяСумма + стрФонд.ИсходнаяСумма;
			стрПодр.СуммаНал =  стрПодр.СуммаНал + стрФонд.СуммаНал;
			стрПодр.СуммаБезнал =  стрПодр.СуммаБезнал + стрФонд.СуммаБезнал;
			стрПодр.УтвержденнаяСумма =  стрПодр.УтвержденнаяСумма + стрФонд.УтвержденнаяСумма;
			стрПодр.НачислениеВФондНал =  стрПодр.НачислениеВФондНал + стрФонд.НачислениеВФондНал;
			стрПодр.НачислениеВФондБезнал =  стрПодр.НачислениеВФондБезнал + стрФонд.НачислениеВФондБезнал;
			
		КонецЦикла;		
		
		Если ВыводитьГруппировкуПоСчетам Тогда
			
			СтрокаВерхнийУровень.ИсходнаяСумма = СтрокаВерхнийУровень.ИсходнаяСумма + стрПодр.ИсходнаяСумма;
			СтрокаВерхнийУровень.СуммаНал =  СтрокаВерхнийУровень.СуммаНал + стрПодр.СуммаНал;
			СтрокаВерхнийУровень.СуммаБезнал =  СтрокаВерхнийУровень.СуммаБезнал + стрПодр.СуммаБезнал;
			СтрокаВерхнийУровень.УтвержденнаяСумма =  СтрокаВерхнийУровень.УтвержденнаяСумма + стрПодр.УтвержденнаяСумма;
			СтрокаВерхнийУровень.НачислениеВФондНал =  СтрокаВерхнийУровень.НачислениеВФондНал + стрПодр.НачислениеВФондНал;
			СтрокаВерхнийУровень.НачислениеВФондБезнал =  СтрокаВерхнийУровень.НачислениеВФондБезнал + стрПодр.НачислениеВФондБезнал;
			
		КонецЕсли;

	КонецЦикла;
	
КонецПроцедуры

