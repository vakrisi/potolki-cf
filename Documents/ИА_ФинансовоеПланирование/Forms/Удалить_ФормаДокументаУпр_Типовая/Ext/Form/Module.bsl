&НаКлиенте
Процедура ПроверитьИзменениеРазмераОкна()
	Если ДанныеХТМЛ_Статистики <> "" ИЛИ ДанныеХТМЛ <> "" Тогда 
		предРазмер = sw;
		предРазмер1 = sw1;
		ОпределитьРазрешениеЭкрана();
		
		РазницаМеждуСтарымИНовымРазмером = предРазмер1 - sw1;
		Если Абс(РазницаМеждуСтарымИНовымРазмером) < 20 Тогда
			Возврат;
		КонецЕсли;

		Если предРазмер <> sw И sw <> 0 Тогда
			ОбновитьСтатистикиФП_Статистики();
		КонецЕсли;
		Если предРазмер1 <> sw1 И sw1 <> 0 Тогда
			ОбновитьСтатистикиФП1();
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

