Функция ПроверкаНаДобавлениеЗаказа(рез)
	
	ТекущаяСтрока =Неопределено;
	
	Если ЗначениеЗаполнено(рез) Тогда
		ТекущаяСтрока = ПолучитьСтрокуЗП(ДеревоЗП, рез);
	КонецЕсли;
	
	Если ТекущаяСтрока=Неопределено Тогда 
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Процедура КомандаДобавить(Команда)
	
	Если ФППоОрганизациям Тогда
		НастройкаОтбораПоОрганизация = Новый Структура;	
		НастройкаОтбораПоОрганизация.Вставить("ЛевоеЗначение", Новый ПолеКомпоновкиДанных("Организация"));	
		НастройкаОтбораПоОрганизация.Вставить("ВидСравнения", ВидСравненияКомпоновкиДанных.Равно);
		НастройкаОтбораПоОрганизация.Вставить("ПравоеЗначение", Объект.Организация);
		НастройкаОтбораПоОрганизация.Вставить("Использовать", Истина);
		НастройкаОтбораПоОрганизация.Вставить("РежимОтображения", РежимОтображенияЭлементаНастройкиКомпоновкиДанных.БыстрыйДоступ);
	КонецЕсли;
	
	НастройкаОтбораПоСтатус = Новый Структура;	
	СписокСтатусов = Новый СписокЗначений;
	СписокСтатусов.Добавить(ПредопределенноеЗначение("Перечисление.ИА_СостояниеЗаказа.РассмотретьНаФП"));
	СписокСтатусов.Добавить(ПредопределенноеЗначение("Перечисление.ИА_СостояниеЗаказа.Одобрен"));
	
	НастройкаОтбораПоСтатус.Вставить("ЛевоеЗначение", Новый ПолеКомпоновкиДанных("Статус"));	
	НастройкаОтбораПоСтатус.Вставить("ВидСравнения", ВидСравненияКомпоновкиДанных.ВСписке);
	НастройкаОтбораПоСтатус.Вставить("ПравоеЗначение", СписокСтатусов);
	НастройкаОтбораПоСтатус.Вставить("Использовать", Истина);
	НастройкаОтбораПоСтатус.Вставить("РежимОтображения", РежимОтображенияЭлементаНастройкиКомпоновкиДанных.БыстрыйДоступ);
	
	НастройкаОтбораПоДате = Новый Структура;	
		
	НастройкаОтбораПоДате.Вставить("ЛевоеЗначение", Новый ПолеКомпоновкиДанных("Дата"));	
	НастройкаОтбораПоДате.Вставить("ВидСравнения", ВидСравненияКомпоновкиДанных.Меньше);
	НастройкаОтбораПоДате.Вставить("ПравоеЗначение", Объект.Дата);
	НастройкаОтбораПоДате.Вставить("Использовать", Истина);
	НастройкаОтбораПоДате.Вставить("РежимОтображения", РежимОтображенияЭлементаНастройкиКомпоновкиДанных.БыстрыйДоступ);
	
	ПараметрыОтбора = Новый Структура;	
	Если ФППоОрганизациям Тогда
		ПараметрыОтбора.Вставить("Организация", НастройкаОтбораПоОрганизация);
	КонецЕсли;
	ПараметрыОтбора.Вставить("Статус", НастройкаОтбораПоСтатус);
	ПараметрыОтбора.Вставить("Дата", НастройкаОтбораПоДате);

	ПараметрыОткрытия = Новый Структура("ПараметрыОтбора", ПараметрыОтбора);
	
	рез = ОткрытьФормуМодально("Документ.ИА_ЗаказНаПриобретение.Форма.ФормаВыбораУпр",ПараметрыОткрытия);
	
	ЗаполнитьСтрокуЗППоЗВС(рез, ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьСтрокуЗППоЗВС(ЗВС, ПерезаполнитьСущестующий = Ложь)
	
	новстр = Неопределено;
	
	Если ЗначениеЗаполнено(ЗВС) Тогда
		
		Если ПроверкаНаДобавлениеЗаказа(ЗВС) Тогда
			
			ДобавитьСтрокуДереваПоЗВС(ЗВС);
			
		Иначе
			Если ПерезаполнитьСущестующий Тогда
				
				ТекущаяСтрокаЗаказа = ПолучитьСтрокуЗП(ДеревоЗП, ЗВС);
				РодительЗВС = ТекущаяСтрокаЗаказа.ПолучитьРодителя();
				РодительЗВС.ПолучитьЭлементы().Удалить(ТекущаяСтрокаЗаказа);
				
				ДобавитьСтрокуДереваПоЗВС(ЗВС);
				
			иначе
				
				Предупреждение("Заявка уже добавлена!");
				
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
	ПересчитатьСальдоСредствКРаспределению();
	ОбновитьОтчетПоСотояниюФондов();
	
	ПересчитатьДерево();
	ПересчитатьИтогиПоЗаказам(); 
	
	//Если новстр <> Неопределено Тогда
	//	Элементы.ДеревоЗП.ТекущаяСтрока = новстр.ПолучитьИдентификатор();
	//КонецЕсли;
	
	
	СпозиционироватсяНаСтрокеДереваЗП(ЗВС);

КонецПроцедуры

&НаКлиенте
Процедура ДобавитьСтрокуДереваПоЗВС(ЗВС)
	
	ПодрФонд = ПолучитьПодразделениеФондИзЗаказа(ЗВС);
	ДанныеЗП = ПолучитьДанныеИзЗаказа(ЗВС);
	Если Не (ЗначениеЗаполнено(ПодрФонд.Подразделение) и ЗначениеЗаполнено(ПодрФонд.Фонд) ) Тогда 
		Предупреждение("В заказе должны быть указаны подразделение и статья расходов!");
		Возврат;
	КонецЕсли;
	
	Если ВыводитьГруппировкуПоСчетам Тогда
		
		Счет = ПодрФонд.Счет;
		НайдСтрокаСчет = НайтиСтрокуСчетВДереверЗП(ДеревоЗП, Счет);
		НайдСтрокаПодр = НайтиСтрокуПодразделенияВДереверЗП(НайдСтрокаСчет, ПодрФонд);
		
	Иначе
		
		НайдСтрокаПодр = НайтиСтрокуПодразделенияВДереверЗП(ДеревоЗП, ПодрФонд);
		
	КонецЕсли;
	
	НайдСтрокаФонд = НайтиСтрокуФондВДереверЗП(НайдСтрокаПодр, ПодрФонд);
	
	
	// ДОБАВИМ ЗАКАЗ
	Новстр = НайдСтрокаФонд.ПолучитьЭлементы().Добавить();
	новстр.Фонд = ПодрФонд.Фонд;
	новстр.Подразделение = ПодрФонд.Подразделение;
	новстр.ПодразделениеФонд = Строка(ПодрФонд.Фонд); 
	Новстр.Заказ = ЗВС;
	Новстр.ПредметЗаказа = ДанныеЗП.ПредметЗаказа;
	Новстр.Ситуация = ДанныеЗП.Ситуация;
	Новстр.Данные = ДанныеЗП.Данные;
	Новстр.Решение = ДанныеЗП.Решение;
	Новстр.Дата = ДанныеЗП.Дата;
	Новстр.СрокОплаты = ДанныеЗП.СрокОплаты;
	Новстр.СуммаНал = 0;
	Новстр.СуммаБезнал = 0;
	Новстр.УтвержденнаяСумма = 0;
	Новстр.НачислениеВФондНал = 0;
	Новстр.НачислениеВФондБезнал = 0;
	//Элементы.ДеревоЗП.ТекущаяСтрока = Новстр;
	
	Если ВыводитьГруппировкуПоСчетам Тогда
		Новстр.Счет = Счет;
	КонецЕсли;
	
	ДеревоЗПЗаказПриИзменении(Новстр);
	
КонецПроцедуры

&НаКлиенте
Функция НайтиСтрокуФондВДереверЗП(Знач СтрокаВерхнегоУровня, Знач ПодрФонд)
	
	Перем НайдСтрокаФонд, стрФонд;
	
	НайдСтрокаФонд = Неопределено;
	Для каждого стрФонд из СтрокаВерхнегоУровня.ПолучитьЭлементы() ЦИкл
		Если стрФонд.Фонд = ПодрФонд.Фонд ТОгда
			НайдСтрокаФонд = стрФонд;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если НайдСтрокаФонд = Неопределено Тогда
		
		ЭлементыСтрокиВерхнегоУровня =  СтрокаВерхнегоУровня.ПолучитьЭлементы();
		
		НайдСтрокаФонд = ЭлементыСтрокиВерхнегоУровня.Добавить();
		НайдСтрокаФонд.Подразделение =  ПодрФонд.Подразделение;
		НайдСтрокаФонд.Фонд =  ПодрФонд.Фонд;
		НайдСтрокаФонд.ПодразделениеФонд = Строка(ПодрФонд.Фонд); 
	
КонецЕсли;
	
	Возврат НайдСтрокаФонд;
	
КонецФункции

&НаКлиенте
Функция НайтиСтрокуПодразделенияВДереверЗП(СтрокаВерхнегоУровня, ПодрФонд)
	
	
	НайдСтрокаПодр = Неопределено;
	Для каждого стрПодразделение из СтрокаВерхнегоУровня.ПолучитьЭлементы() ЦИкл
		Если стрПодразделение.Подразделение = ПодрФонд.Подразделение ТОгда
			НайдСтрокаПодр = стрПодразделение;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если НайдСтрокаПодр = Неопределено Тогда
		
		ЭлементыСтрокиВерхнегоУровня =  СтрокаВерхнегоУровня.ПолучитьЭлементы();
		
		ПодразделениеНаименование =  Строка(ПодрФонд.Подразделение);
		
		ИндексВставки = 0; 
		Для каждого ЭлементСтрокиВерхнегоУровня Из ЭлементыСтрокиВерхнегоУровня Цикл
			  ТекущееНаименованиеПодразделения = Строка(ЭлементСтрокиВерхнегоУровня.Подразделение);
			  Если ТекущееНаименованиеПодразделения > ПодразделениеНаименование Тогда
			  	   ИндексВставки = ЭлементыСтрокиВерхнегоУровня.Индекс(ЭлементСтрокиВерхнегоУровня);
				   
				   Прервать;
			  КонецЕсли;
		КонецЦикла;
		
		НайдСтрокаПодр = ЭлементыСтрокиВерхнегоУровня.Вставить(ИндексВставки);
		НайдСтрокаПодр.Счет          =  ПодрФонд.Счет;
		НайдСтрокаПодр.Подразделение =  ПодрФонд.Подразделение;
		НайдСтрокаПодр.ПодразделениеФонд = Строка(ПодрФонд.Подразделение); 
		
	КонецЕсли;
	
	Возврат НайдСтрокаПодр;
	
КонецФункции

