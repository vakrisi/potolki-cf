&НаСервере
Процедура ЗаполнениеТаблЧастей()
	
	// спец доход
	Для каждого стр из Объект.ДоходыБП Цикл
		Если не ЗначениеЗаполнено(стр.Период) Тогда
			стр.Период = Объект.Дата;
		КонецЕсли;
	КонецЦикла;
	
	//Займы
	Для каждого стр из Объект.РаспределениеПоФондам Цикл
		стр.ПричинаЗайма = СокрЛП(стр.ПричинаЗайма);
	КонецЦикла;
	
	//
	Объект.ЗаказыНаПриобретение.Очистить();
	Объект.НачисленияВФонды.Очистить();
	Объект.ПолитикаРаспределения.Очистить();
	Объект.ПолитикаРаспределенияПервичная.Очистить();
	Объект.ПланПродаж.Очистить();
	Объект.ЗНО.Очистить();
	
	ДеревоЗПЗнач = РеквизитФормыВЗначение("ДеревоЗП");
	
	// Заказы
	ЗаполнитьСтрокиЗаказыНаПриобретение(ДеревоЗПЗнач.Строки);
	
	ДеревоПолитикаПервичнаяЗнач = РеквизитФормыВЗначение("ДеревоПолитикаПервичная");
	// Политика1
	Для каждого стрРаздел из ДеревоПолитикаПервичнаяЗнач.Строки ЦИкл   
		Для каждого стр из стрРаздел.Строки Цикл
			новстр = Объект.ПолитикаРаспределенияПервичная.Добавить();
			ЗаполнитьЗначенияСвойств(новстр,стр);
		КонецЦикла;
	КонецЦикла;
	
	ДеревоПолитикаЗнач = РеквизитФормыВЗначение("ДеревоПолитика");
	// Политика
	Для каждого стрРаздел из ДеревоПолитикаЗнач.Строки ЦИкл   
		Для каждого стр из стрРаздел.Строки Цикл
			новстр = Объект.ПолитикаРаспределения.Добавить();
			ЗаполнитьЗначенияСвойств(новстр,стр);
		КонецЦикла;
	КонецЦикла;
	
	// План Продаж
	Для каждого стрНеделя из ДеревоПланКоррекция.ПолучитьЭлементы() Цикл
		Если стрНеделя.неделя = Объект.НеделяПланирования Тогда
			Для каждого стрПлан из стрНеделя.ПолучитьЭлементы() Цикл
				Новстр = Объект.ПланПродаж.Добавить();
				ЗаполнитьЗначенияСвойств(новстр, стрПлан);
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	
	// статусы зно	
	Для каждого стр из ТаблицаЗНО Цикл
		Новстр = Объект.ЗНО.Добавить();
		ЗаполнитьЗначенияСвойств(новстр, стр);
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСтрокиЗаказыНаПриобретение(СтрокиЗП)
	
	Для каждого СтрокаЗП из СтрокиЗП ЦИкл   
		
		Если ЗначениеЗаполнено(СтрокаЗП.Заказ) Тогда
			
			СтрокаЗаказыНаПриобретение = Объект.ЗаказыНаПриобретение.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаЗаказыНаПриобретение, СтрокаЗП);
			
		ИначеЕсли ЗначениеЗаполнено(СтрокаЗП.Фонд) Тогда 	
			
			Если СтрокаЗП.НачислениеВФондНал + СтрокаЗП.НачислениеВФондБезнал > 0 Тогда
				СтрокаНачисленияВФонды = Объект.НачисленияВФонды.Добавить();
				СтрокаНачисленияВФонды.Фонд          = СтрокаЗП.Фонд;
				СтрокаНачисленияВФонды.Подразделение = СтрокаЗП.Подразделение;
				СтрокаНачисленияВФонды.СуммаНал      = СтрокаЗП.НачислениеВФондНал; 
				СтрокаНачисленияВФонды.СуммаБезНал   = СтрокаЗП.НачислениеВФондБезнал; 
			КонецЕсли;	
			ЗаполнитьСтрокиЗаказыНаПриобретение(СтрокаЗП.Строки);
		Иначе
			
			ЗаполнитьСтрокиЗаказыНаПриобретение(СтрокаЗП.Строки)	
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)	
	
	ЗаполнениеТаблЧастей();
	
	// проверка займов
	Для каждого стр из Объект.РаспределениеПоФондам Цикл
		Если стр.Фонд.Пустая() или стр.СФонда.Пустая() или стр.Подразделение.Пустая() или стр.СПодразделения.Пустая() Тогда
			Предупреждение("Заполните правильно перемещение между фондами!");
			Отказ = Истина;
			Возврат;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(стр.ЗаймВозврат) и не ЗначениеЗаполнено(стр.ПричинаЗайма) Тогда
			Сообщить("Заполните причину займа/возврата!"); 
			Отказ = Истина;
			Возврат;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ОбновлениеОтображения()
	
	ПредварительнаяСуммаКРаспределениюИтого = Объект.ПредварительнаяСуммаКРаспределениюНал + Объект.ПредварительнаяСуммаКРаспределениюБезнал;
	ПредварительнаяСуммаКРаспределениюИтого1 = Объект.ПредварительнаяСуммаКРаспределениюНал1 + Объект.ПредварительнаяСуммаКРаспределениюБезнал1;
	МаржинальнаяПрибыльИтого = Объект.МаржинальнаяПрибыльНал + Объект.МаржинальнаяПрибыльБезнал;
	НераспределяемаяСуммаИтого = Объект.НераспределяемаяСуммаНал + Объект.НераспределяемаяСуммаБезнал;
	СуммаКРаспределениюИтого = Объект.СуммаКРаспределениюНал + Объект.СуммаКРаспределениюБезнал;
	СуммаКРаспределениюСОстаткомИтого  = Объект.СуммаКРаспределениюСОстаткомНал + Объект.СуммаКРаспределениюСОстаткомБезнал;
	СальдоСредствКРаспределениюИтого   = Объект.СальдоСредствКРаспределениюНал + Объект.СальдоСредствКРаспределениюБезнал;
КонецПроцедуры

&НаКлиенте
Процедура ДеревоЗППриИзменении(Элемент)	
	
	тд = Элементы.ДеревоЗП.ТекущиеДанные;	
	Если Элементы.ДеревоЗПАвтоначисление.Пометка И Найти(Элемент.ТекущийЭлемент.Имя,"Начисление")=0 и ЗначениеЗаполнено(тд.Заказ) и тд.Счет = ПредопределенноеЗначение("Справочник.ИА_Счета.ГлавныйСчет") Тогда
		ДоначислитьАвтоматически();	
	КонецЕсли;
	
	ПриИзмененииВДеревеЗаказов();
	ОбновитьОтчетПоСотояниюФондов();
	ПересчитатьДерево();
	ПересчитатьИтогиПоЗаказам();
	
КонецПроцедуры

&НаСервере
Процедура ДоначислитьАвтоматически()
	
	тд = ДеревоЗП.НайтиПоИдентификатору(Элементы.ДеревоЗП.ТекущаяСтрока);	
	ЕстьОшибка = ложь;
	нал = истина;
	НехваткаСуммы = 0;
	
	ОбновитьОтчетПоСотояниюФондов(ВыходнаяТаблица);
	СтрПоиска = Новый Структура("Счет,Фонд,Подразделение", тд.Счет, тд.Фонд, тд.Подразделение);
	НСтроки = ВыходнаяТаблица.НайтиСтроки(СтрПоиска); 
	Если НСтроки.Количество()>0 Тогда
		СтрокаСостояния = НСтроки[0];
		Если тд.СуммаНал > 0 Тогда
			Если СтрокаСостояния.ПослеФП_ОстатокНал < 0 Тогда
				ЕстьОшибка = Истина;
				НехваткаСуммы = -СтрокаСостояния.ПослеФП_ОстатокНал; 
			КонецЕсли;
		Иначе
			Если СтрокаСостояния.ПослеФП_ОстатокБезНал < 0 Тогда
				ЕстьОшибка = Истина;
				НехваткаСуммы = -СтрокаСостояния.ПослеФП_ОстатокБезНал; 
			КонецЕсли;
			нал = Ложь;
		КонецЕсли;	
	КонецЕсли;
	
	СтрРод = тд.ПолучитьРодителя();
	Если ЕстьОшибка Тогда
		Если нал Тогда
			СтрРод.НачислениеВФондНал = тд.НачислениеВФондНал + НехваткаСуммы;
		Иначе
			СтрРод.НачислениеВФондБезНал = тд.НачислениеВФондБезНал + НехваткаСуммы;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоЗППриАктивизацииСтроки(Элемент)
	
	тд = Элементы.ДеревоЗП.ТекущиеДанные;
	ОписаниеЗРС = "";
	Если тд <> Неопределено Тогда
		Элементы.ДеревоЗПКнопкаПомощникПополненияФонда.Доступность = ЗначениеЗаполнено(тд.Заказ);
		//Элементы.ДеревоЗПКнопкаДобавить.Доступность = ЗначениеЗаполнено(тд.Фонд);
		Если  ЗначениеЗаполнено(тд.Заказ) Тогда
			ОписаниеЗРС = "Заказ от " + формат(тд.дата,"ДФ=dd.MM.yyyy")+", срок оплаты " + формат(тд.СрокОплаты,"ДФ=dd.MM.yyyy") + Символы.ПС +  "Ситуация: " + тд.Ситуация + Символы.ПС + "Данные: " + тд.Данные + Символы.ПС + "Решение: " + тд.Решение;
		Иначе
			ОписаниеЗРС = "";
		КонецЕсли;
		
		/////////{ Позиционирование на подразделение/фонд
		Если ВыводитьГруппировкуПоСчетам Тогда
			ПараметрПозиционированияСчет          = "" + ТД.Счет;
			ПараметрПозиционированияПодразделение = "" + ТД.Счет + "/" + ТД.Подразделение;
			ПараметрПозиционированияФонд          = "" + ТД.Счет + "/" + ТД.Подразделение + "/" + ТД.Фонд;
		Иначе	
			ПараметрПозиционированияСчет          = "" + ТД.Счет;
			ПараметрПозиционированияПодразделение = "" + ТД.Подразделение;
			ПараметрПозиционированияФонд          = "" + ТД.Подразделение + "/" + ТД.Фонд;
		КонецЕсли;
		
		Обл = ПолеТабДок.НайтиЗначение(ПараметрПозиционированияФонд);
		ПолеТабДок.ПоказатьУровеньГруппировокСтрок(ПолеТабДок.КоличествоУровнейГруппировокСтрок());
		
		Если Обл = Неопределено Тогда
			Обл = ПолеТабДок.НайтиЗначение(ПараметрПозиционированияПодразделение);	
		КонецЕсли; 
		Если ВыводитьГруппировкуПоСчетам и Обл = Неопределено Тогда
			Обл = ПолеТабДок.НайтиЗначение(ПараметрПозиционированияСчет);	
		КонецЕсли;
		
		ЦветБелый = Новый Цвет(255,255,255);
		
		Если ПредВыдОбл <> Неопределено Тогда
			ПредВыдОбл.Шрифт = Новый Шрифт(ПредВыдОбл.Шрифт,,8,,ложь);
			
			ОбластьЦвет = ПолеТабДок.Область(ПредВыдОбл.Верх,1,ПредВыдОбл.Верх,1);
			ЦветФонаНовый = Новый Цвет(ОбластьЦвет.ЦветТекста.Красный,ОбластьЦвет.ЦветТекста.Зеленый,ОбластьЦвет.ЦветТекста.Синий);
			
			КонецОбласти = ?(РазделятьНалБезнал,14,8);
			ТекОбласть = ПолеТабДок.Область(ПредВыдОбл.Верх,2,ПредВыдОбл.Верх,КонецОбласти);
			ТекОбласть.ЦветФона = ЦветФонаНовый
		КонецЕсли;
		
		Если Обл <> Неопределено Тогда
			М = Новый Массив;
			М.Добавить(Обл);
			Элементы.ПолеТабДок.УстановитьВыделенныеОбласти(М);
			
			ПредВыдОбл = Обл;
			Обл.Шрифт = Новый Шрифт(обл.Шрифт,,10,,истина);			
			
			ЦветФонаНовый = Новый Цвет(50,255,100); 
			КонецОбласти = ?(РазделятьНалБезнал,14,8);
			ТекОбласть = ПолеТабДок.Область(ПредВыдОбл.Верх,2,ПредВыдОбл.Верх,КонецОбласти);
			Если ТекОбласть.ЦветФона = ЦветБелый ИЛИ ТекОбласть.ЦветФона = Новый Цвет() Тогда
				ТекОбласть.ЦветФона = ЦветФонаНовый;
			КонецЕсли;
		КонецЕсли; 
		///////////} 	
	КонецЕсли;
КонецПроцедуры

&НаКлиенте 
Процедура НайтиСтрокуДерева(КоллекцияЭлементовДерева, ТекущиеДанные, ИдентификаторСтроки, ПрекратитьПоиск) 
	
	Для Каждого СтрокаДерева Из КоллекцияЭлементовДерева Цикл 
		Если ПрекратитьПоиск Тогда 
			Возврат; 
		КонецЕсли; 
		
		Если СтрокаДерева = ТекущиеДанные Тогда 
			ИдентификаторСтроки = СтрокаДерева.ПолучитьИдентификатор(); 
			ПрекратитьПоиск = Истина; 
			Возврат; 
		КонецЕсли; 
		
		КоллекцияЭлементов = СтрокаДерева.ПолучитьЭлементы(); 
		
		Если КоллекцияЭлементов.Количество() > 0 Тогда 
			НайтиСтрокуДерева(КоллекцияЭлементов, ТекущиеДанные, ИдентификаторСтроки, ПрекратитьПоиск); 
		КонецЕсли; 
	КонецЦикла; 
	
КонецПроцедуры 

