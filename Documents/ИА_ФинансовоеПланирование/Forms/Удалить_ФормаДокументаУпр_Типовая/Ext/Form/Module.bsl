&НаСервере
Функция ПолучитьКоэффициентНедели()
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	СУММА(ВЫБОР
	|			КОГДА ИА_Календарь.Рабочий
	|				ТОГДА 1
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК КолРабочих,
	|	КОЛИЧЕСТВО(*) КАК КолВсего
	|ИЗ
	|	РегистрСведений.ИА_Календарь КАК ИА_Календарь
	|ГДЕ
	|	ИА_Календарь.Период МЕЖДУ &ДатаНачала И &ДатаКонца";
	ДатаДок = ?(Объект.Дата = Дата(1,1,1), ТекущаяДата(), Объект.Дата);
	Запрос.УстановитьПараметр("ДатаНачала", НачалоМесяца(ДатаДок));
	Запрос.УстановитьПараметр("ДатаКонца", КонецМесяца(ДатаДок));
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() и ЗначениеЗаполнено(Выборка.КолРабочих) Тогда
		Возврат Выборка.КолРабочих / 5;
	Иначе
		колДней = (КонецМесяца(ДатаДок) + 1 - НачалоМесяца(ДатаДок)) / (60*60*24);
		возврат колДней / 7;
	КонецЕсли;
КонецФункции

