&НаСервереБезКонтекста
Функция  Сумма_ИА_СредстваВРезервеНаФондах(СуммаТек,Заказ, СсылкаДок)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ЕСТЬNULL(СУММА(ИА_СредстваВРезервеНаФондахОбороты.СуммаНалПриход) + СУММА(ИА_СредстваВРезервеНаФондахОбороты.СуммаБезналПриход), 0) КАК Сумма
	|ИЗ
	|	РегистрНакопления.ИА_СредстваВРезервеНаФондах.Обороты(, , Регистратор, ) КАК ИА_СредстваВРезервеНаФондахОбороты
	|ГДЕ
	|	ИА_СредстваВРезервеНаФондахОбороты.ЗП = &ЗП
	|	И ИА_СредстваВРезервеНаФондахОбороты.Регистратор <> &ТекДок";
	Запрос.УстановитьПараметр("ЗП", Заказ);
	Запрос.УстановитьПараметр("ТекДок", СсылкаДок);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СуммаТек = СуммаТек - Выборка.Сумма;
	КонецЦикла;
	Возврат СуммаТек;
КонецФункции

