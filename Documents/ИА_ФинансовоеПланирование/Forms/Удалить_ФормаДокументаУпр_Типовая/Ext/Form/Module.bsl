&НаКлиенте
Перем ПредВыдОбл,ФормаСтатистик;

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ИспользоватьРаспределениеСФондов = Константы.ИА_ИспользоватьРаспределениеСФондов.Получить();
	ИспользоватьСпецдоход            = Константы.ИА_ИспользоватьСпецдоход.Получить();
	
	ФППоОрганизациям              = Константы.ИА_ФП_ВестиФППоОрганизациям.Получить();
	РазделятьНалБезнал            = Константы.ИА_ФП_РазделятьНалИБезнал.Получить();
	
	ИА_СостояниеЗаказаОдобрен     = Перечисления.ИА_СостояниеЗаказа.Одобрен;
	ИА_СостояниеЗаказаОтклонен    = Перечисления.ИА_СостояниеЗаказа.Отклонен;
	ИА_ВидДенежныхСредствНаличные = Перечисления.ИА_ВидДенежныхСредств.Наличные;
	
	ВыводитьГруппировкуПоСчетам =  Константы.ИА_ФП_ВыводитьГруппировкуПоСчетам.Получить();
	
	
	ЭтоРСФ = ИА_ПраваС.ЗначениеПраваТекПользователя(ПланыВидовХарактеристик.ИА_ПраваПользователей.РСФ);
	ТолькоПросмотрФП = ТолькоПросмотрФП();
	
	Элементы.КнопкаОбновить.Доступность			= НЕ ТолькоПросмотрФП;
	
	Элементы.РаспределениеПоФондамПогаситьЗайм.Доступность	= НЕ ТолькоПросмотрФП;
	//Элементы.КнопкаЗаполнитьПоПредыдущему.Доступность		= НЕ ТолькоПросмотрФП;
	
	Если ВыводитьГруппировкуПоСчетам Тогда
		Элементы.ДеревоЗППодразделениеФонд.Заголовок = "Счет/Подразделение/Статья";
	Иначе	
		Элементы.ДеревоЗППодразделениеФонд.Заголовок = "Подразделение/Статья";
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Если ФППоОрганизациям Тогда
			Объект.Организация = ИА_НастройкиС.ЗначениеНастройкиТекПользователя(ПланыВидовХарактеристик.ИА_НастройкиПользователей.ОсновнаяОрганизация);
		КонецЕсли;
		Объект.НачалоПланирования   = Константы.ИА_ФП_НачалоПланирования.Получить();
	КонецЕсли;
	
	ПредФп = ПолучитьПоследнееФП();
	ДатаПредыдущегоФП = ПредФп.Дата;
	
КонецПроцедуры


&НаСервере
Функция ТолькоПросмотрФП()
	
	РолиПользователя          = ПользователиИнформационнойБазы.ТекущийПользователь().Роли; 
	ЕстьПолныеПрава           = РолиПользователя.Содержит(Метаданные.Роли.ПолныеПрава); 
	
	Результат = НЕ ПравоДоступа("Редактирование", Метаданные.Документы.ИА_ФинансовоеПланирование);
	
	Если ЕстьПолныеПрава Тогда
		
		Результат = Ложь;
		
	КонецЕсли; 
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ПересчитатьИтогиПоЗаказам()
	
	СуммаВсего = 0;
	СуммаНачНал = 0;
	СуммаНачБезнал = 0;
	СуммаНал = 0;
	СуммаБезнал = 0;
	ИсхСуммаВсего = 0;
	
	Если ВыводитьГруппировкуПоСчетам Тогда
		ЭлементыСчета = ДеревоЗП.ПолучитьЭлементы();
		Для каждого ЭлементСчета Из  ЭлементыСчета Цикл 
			ПересчитатьИтогиПоЗаказамПодразделения(ЭлементСчета, ИсхСуммаВсего, СуммаБезнал, СуммаВсего, СуммаНал, СуммаНачБезнал, СуммаНачНал);
		КонецЦикла;
	Иначе
		ПересчитатьИтогиПоЗаказамПодразделения(ДеревоЗП, ИсхСуммаВсего, СуммаБезнал, СуммаВсего, СуммаНал, СуммаНачБезнал, СуммаНачНал);
	КонецЕсли;
	
	
	Элементы.ДеревоЗПУтвержденнаяСумма.ТекстПодвала   = Формат(СуммаВсего,"ЧДЦ=2; ЧН="); 
	Элементы.ДеревоЗПИсходнаяСумма.ТекстПодвала       = Формат(ИсхСуммаВсего,"ЧДЦ=2; ЧН="); 
	Элементы.ДеревоЗПСуммаНал.ТекстПодвала            = Формат(СуммаНал,"ЧДЦ=2; ЧН="); 
	Элементы.ДеревоЗПСуммаБезнал.ТекстПодвала         = Формат(СуммаБезнал,"ЧДЦ=2; ЧН="); 
	Элементы.ДеревоЗПСумма.ТекстПодвала               = Формат(СуммаБезнал,"ЧДЦ=2; ЧН="); 
	
	
	СуммаКРаспределениюСОстаткомНаличный    = Объект.СуммаКРаспределениюСОстаткомНал;
	СуммаКРаспределениюСОстаткомБезналичный = Объект.СуммаКРаспределениюСОстаткомБезнал;
	
	Если СуммаКРаспределениюСОстаткомНаличный = 0 Тогда
		Элементы.ДеревоЗПНачислениеВФондНал.ТекстПодвала = Формат(СуммаНачНал,"ЧДЦ=2; ЧН=") + " - " + Формат(0,"ЧДЦ=2; ЧН=")+"%"; 
	Иначе
		Элементы.ДеревоЗПНачислениеВФондНал.ТекстПодвала = Формат(СуммаНачНал,"ЧДЦ=2; ЧН=") + " - " + Формат(СуммаНачНал/СуммаКРаспределениюСОстаткомНаличный*100,"ЧДЦ=2; ЧН=")+"%";  
	КонецЕсли;
	
	Если СуммаКРаспределениюСОстаткомБезналичный = 0 Тогда
		Элементы.ДеревоЗПНачислениеВФондБезнал.ТекстПодвала = Формат(СуммаНачБезнал,"ЧДЦ=2; ЧН=") + " - " + Формат(0,"ЧДЦ=2; ЧН=")+"%"; 
		Элементы.ДеревоЗПНачислениеВФонд.ТекстПодвала = Элементы.ДеревоЗПНачислениеВФондБезнал.ТекстПодвала;
	Иначе   
		Элементы.ДеревоЗПНачислениеВФондБезнал.ТекстПодвала = Формат(СуммаНачБезнал,"ЧДЦ=2; ЧН=") + " - " + Формат(СуммаНачБезнал/Объект.СуммаКРаспределениюСОстаткомБезнал*100,"ЧДЦ=2; ЧН=")+"%"; 
		Элементы.ДеревоЗПНачислениеВФонд.ТекстПодвала = Элементы.ДеревоЗПНачислениеВФондБезнал.ТекстПодвала;
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьИтогиПоЗаказамПодразделения(ЭлементДерева, ИсхСуммаВсего, СуммаБезнал, СуммаВсего, СуммаНал, СуммаНачБезнал, СуммаНачНал)
	
	ЭлементыПодразделения = ЭлементДерева.ПолучитьЭлементы();
	Для каждого ЭлементПодразделения из ЭлементыПодразделения цикл
		
		ЭлементыФонды = ЭлементПодразделения.ПолучитьЭлементы();
		Для каждого ЭлементФонды из ЭлементыФонды цикл
			СуммаВсего    = СуммаВсего    + ЭлементФонды.УтвержденнаяСумма;
			ИсхСуммаВсего = ИсхСуммаВсего + ЭлементФонды.ИсходнаяСумма;
			СуммаНал      = СуммаНал      + ЭлементФонды.СуммаНал;
			СуммаБезнал   = СуммаБезнал   + ЭлементФонды.СуммаБезнал;
		КонецЦикла;
		СуммаНачНал    = СуммаНачНал    + ЭлементПодразделения.НачислениеВФондНал;
		СуммаНачБезнал = СуммаНачБезнал + ЭлементПодразделения.НачислениеВФондБезнал;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТаблицуЗП(поТекДокументу = Ложь)
	
	Запрос = Новый Запрос;
	ТекстЗапроса = "ВЫБРАТЬ
	|	ПодЗапрос.Заказ,
	|	ПодЗапрос.Счет КАК Счет,
	|	ВЫБОР
	|		КОГДА ПодЗапрос.Счет = ЗНАЧЕНИЕ(Справочник.ИА_Счета.ГлавныйСчет)
	|			ТОГДА 0
	|		КОГДА ПодЗапрос.Счет = ЗНАЧЕНИЕ(Справочник.ИА_Счета.Счет1)
	|			ТОГДА 1
	|		ИНАЧЕ 200
	|	КОНЕЦ КАК СчетПорядок,
	|	ПодЗапрос.Фонд КАК Фонд,
	|	ПодЗапрос.ПредметЗаказа,
	|	ВЫБОР
	|		КОГДА ПодЗапрос.Заказ.ВидДС = ЗНАЧЕНИЕ(Перечисление.ИА_ВидДенежныхСредств.Наличные)
	|			ТОГДА ПодЗапрос.Сумма - ЕСТЬNULL(ПодЗапросРезервы.Сумма, 0) - ЕСТЬNULL(ПодЗапросЗакрытия.Сумма, 0)
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК СуммаНал,
	|	ВЫБОР
	|		КОГДА ПодЗапрос.Заказ.ВидДС <> ЗНАЧЕНИЕ(Перечисление.ИА_ВидДенежныхСредств.Наличные)
	|			ТОГДА ПодЗапрос.Сумма - ЕСТЬNULL(ПодЗапросРезервы.Сумма, 0) - ЕСТЬNULL(ПодЗапросЗакрытия.Сумма, 0)
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК СуммаБезнал,
	|	0 КАК Сумма,
	|	ПодЗапрос.Статус КАК Статус,
	|	ПодЗапрос.УтвержденнаяСумма КАК УтвержденнаяСумма,
	|	0 КАК ИсходнаяСумма,
	|	ПодЗапрос.ПричинаОтказа КАК ПричинаОтказа,
	|	ПодЗапрос.НачислениеВФондНал КАК НачислениеВФондНал,
	|	ПодЗапрос.НачислениеВФондБезнал КАК НачислениеВФондБезнал,
	|	0 КАК НачислениеВФонд,
	|	ПодЗапрос.Подразделение КАК Подразделение,
	|	ПодЗапрос.Подразделение.Наименование КАК ПодразделениеФонд,
	|	ПодЗапрос.Заказ.Ситуация КАК Ситуация,
	|	ПодЗапрос.Заказ.Данные КАК Данные,
	|	ПодЗапрос.Заказ.Решение КАК Решение,
	|	ПодЗапрос.Фонд.Код КАК ФондКод,
	|	ПодЗапрос.Заказ.Дата КАК Дата,
	|	ПодЗапрос.Заказ.ДатаОплаты КАК СрокОплаты
	|ПОМЕСТИТЬ ВТСводнаяТаблица
	|ИЗ
	|	(ВЫБРАТЬ
	|		ЗаказыНаПриобретение.Заказ КАК Заказ,
	|		ЗаказыНаПриобретение.Заказ.Фонд.Счет КАК Счет,
	|		ЗаказыНаПриобретение.Заказ.Фонд КАК Фонд,
	|		ЗаказыНаПриобретение.Заказ.Подразделение КАК Подразделение,
	|		ЗаказыНаПриобретение.Заказ.ПредметЗаказа КАК ПредметЗаказа,
	|		ЗаказыНаПриобретение.Заказ.Сумма КАК Сумма,
	|		ЗаказыНаПриобретение.УтвержденнаяСумма КАК УтвержденнаяСумма,
	|		0 КАК НачислениеВФондНал,
	|		0 КАК НачислениеВФондБезнал,
	|		ЗаказыНаПриобретение.Статус КАК Статус,
	|		ЗаказыНаПриобретение.ПричинаОтказа КАК ПричинаОтказа
	|	ИЗ
	|		Документ.ИА_ФинансовоеПланирование.ЗаказыНаПриобретение КАК ЗаказыНаПриобретение
	|	ГДЕ
	|		ЗаказыНаПриобретение.Ссылка = &ТекДок
	|		И &ПоТекДоку = ИСТИНА
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		ЗНАЧЕНИЕ(Документ.ИА_ЗаказНаПриобретение.ПустаяСсылка),
	|		НачисленияВФонды.Фонд.Счет,
	|		НачисленияВФонды.Фонд,
	|		НачисленияВФонды.Подразделение,
	|		"""",
	|		0,
	|		0,
	|		СУММА(НачисленияВФонды.СуммаНал),
	|		СУММА(НачисленияВФонды.СуммаБезнал),
	|		NULL,
	|		NULL
	|	ИЗ
	|		Документ.ИА_ФинансовоеПланирование.НачисленияВФонды КАК НачисленияВФонды
	|	ГДЕ
	|		НачисленияВФонды.Ссылка = &ТекДок
	|		И &ПоТекДоку = ИСТИНА
	|	
	|	СГРУППИРОВАТЬ ПО
	|		НачисленияВФонды.Фонд,
	|		НачисленияВФонды.Подразделение,
	|		НачисленияВФонды.Фонд.Счет
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		ЗаявкиНаРасходованиеСредствОстатки.ЗП,
	|		ЗаявкиНаРасходованиеСредствОстатки.ЗП.Фонд.Счет,
	|		ЗаявкиНаРасходованиеСредствОстатки.ЗП.Фонд,
	|		ЗаявкиНаРасходованиеСредствОстатки.ЗП.Подразделение,
	|		ЗаявкиНаРасходованиеСредствОстатки.ЗП.ПредметЗаказа,
	|		ЗаявкиНаРасходованиеСредствОстатки.ЗП.Сумма,
	|		0,
	|		0,
	|		0,
	|		ИА_ИсторияСтатусовЗВССрезПоследних.Статус,
	|		ВЫРАЗИТЬ("""" КАК СТРОКА(100))
	|	ИЗ
	|		РегистрНакопления.ИА_ЗаказыНаПриобретение.Остатки(
	|				&Дата,
	|				Организация = &Организация
	|					ИЛИ &НеРазделять) КАК ЗаявкиНаРасходованиеСредствОстатки
	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИА_ИсторияСтатусовЗВС.СрезПоследних КАК ИА_ИсторияСтатусовЗВССрезПоследних
	|			ПО ЗаявкиНаРасходованиеСредствОстатки.ЗП = ИА_ИсторияСтатусовЗВССрезПоследних.ЗВС
	|	ГДЕ
	|		&ПоТекДоку = ЛОЖЬ
	|		И ЗаявкиНаРасходованиеСредствОстатки.СуммаОстаток > 0
	|		И (ИА_ИсторияСтатусовЗВССрезПоследних.Статус = ЗНАЧЕНИЕ(Перечисление.ИА_СостояниеЗаказа.РассмотретьНаФП)
	|				ИЛИ ИА_ИсторияСтатусовЗВССрезПоследних.Статус = ЗНАЧЕНИЕ(Перечисление.ИА_СостояниеЗаказа.Одобрен))) КАК ПодЗапрос
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			ИА_СредстваВРезервеНаФондахОбороты.ЗП КАК Ссылка,
	|			СУММА(ИА_СредстваВРезервеНаФондахОбороты.СуммаНалПриход) + СУММА(ИА_СредстваВРезервеНаФондахОбороты.СуммаБезналПриход) КАК Сумма
	|		ИЗ
	|			РегистрНакопления.ИА_СредстваВРезервеНаФондах.Обороты(, &Дата, Регистратор, ) КАК ИА_СредстваВРезервеНаФондахОбороты
	|		ГДЕ
	|			ИА_СредстваВРезервеНаФондахОбороты.Регистратор <> &ТекДок
	|		
	|		СГРУППИРОВАТЬ ПО
	|			ИА_СредстваВРезервеНаФондахОбороты.ЗП) КАК ПодЗапросРезервы
	|		ПО ПодЗапрос.Заказ = ПодЗапросРезервы.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			ИА_ЗаказыНаПриобретение.ЗП КАК Ссылка,
	|			СУММА(ИА_ЗаказыНаПриобретение.СуммаРасход) КАК Сумма
	|		ИЗ
	|			РегистрНакопления.ИА_ЗаказыНаПриобретение.Обороты(, &Дата, Регистратор, ) КАК ИА_ЗаказыНаПриобретение
	|		ГДЕ
	|			ИА_ЗаказыНаПриобретение.Регистратор <> &ТекДок
	|			И ИА_ЗаказыНаПриобретение.Регистратор ССЫЛКА Документ.ИА_ЗакрытиеЗаказаНаПриобретение
	|		
	|		СГРУППИРОВАТЬ ПО
	|			ИА_ЗаказыНаПриобретение.ЗП) КАК ПодЗапросЗакрытия
	|		ПО ПодЗапрос.Заказ = ПодЗапросЗакрытия.Ссылка
	|ГДЕ
	|	(ПодЗапрос.Сумма - ЕСТЬNULL(ПодЗапросРезервы.Сумма, 0) - ЕСТЬNULL(ПодЗапросЗакрытия.Сумма, 0) > 0
	|			ИЛИ ПодЗапрос.НачислениеВФондНал + ПодЗапрос.НачислениеВФондБезнал > 0
	|			ИЛИ &ПоТекДоку = ИСТИНА)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТСводнаяТаблица.Заказ,
	|	ВТСводнаяТаблица.Счет,
	|	ВТСводнаяТаблица.СчетПорядок КАК СчетПорядок,
	|	ВТСводнаяТаблица.Счет.Наименование КАК СчетНаименование,
	|	ВТСводнаяТаблица.Фонд КАК Фонд,
	|	ВТСводнаяТаблица.ПредметЗаказа,
	|	ВТСводнаяТаблица.СуммаНал КАК СуммаНал,
	|	ВТСводнаяТаблица.СуммаБезнал КАК СуммаБезнал,
	|	ВТСводнаяТаблица.Сумма КАК Сумма,
	|	ВТСводнаяТаблица.Статус,
	|	ВТСводнаяТаблица.УтвержденнаяСумма КАК УтвержденнаяСумма,
	|	ВТСводнаяТаблица.ИсходнаяСумма КАК ИсходнаяСумма,
	|	ВТСводнаяТаблица.ПричинаОтказа,
	|	ВТСводнаяТаблица.НачислениеВФондНал КАК НачислениеВФондНал,
	|	ВТСводнаяТаблица.НачислениеВФондБезнал КАК НачислениеВФондБезнал,
	|	ВТСводнаяТаблица.НачислениеВФонд КАК НачислениеВФонд,
	|	ВТСводнаяТаблица.Подразделение КАК Подразделение,
	|	ВТСводнаяТаблица.ПодразделениеФонд,
	|	ВТСводнаяТаблица.Ситуация,
	|	ВТСводнаяТаблица.Данные,
	|	ВТСводнаяТаблица.Решение,
	|	ВТСводнаяТаблица.ФондКод КАК ФондКод,
	|	ВТСводнаяТаблица.Дата,
	|	ВТСводнаяТаблица.СрокОплаты
	|ИЗ
	|	ВТСводнаяТаблица КАК ВТСводнаяТаблица
	|ГДЕ
	|	(ВТСводнаяТаблица.Счет <> ЗНАЧЕНИЕ(Справочник.ИА_Счета.Счет1)
	|			ИЛИ &ЭтоРСФ)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ФондКод
	|ИТОГИ
	|	СУММА(СуммаНал),
	|	СУММА(СуммаБезнал),
	|	СУММА(УтвержденнаяСумма),
	|	СУММА(ИсходнаяСумма),
	|	МАКСИМУМ(НачислениеВФондНал),
	|	МАКСИМУМ(НачислениеВФондБезнал),
	|	МАКСИМУМ(ФондКод)
	|ПО
	|	Подразделение,
	|	Фонд";
	
	
	Если ВыводитьГруппировкуПоСчетам Тогда
		
		СхемаЗапроса = Новый СхемаЗапроса;
		СхемаЗапроса.УстановитьТекстЗапроса(ТекстЗапроса);
		
		ЗапросСхемы = СхемаЗапроса.ПакетЗапросов[1];
		
		Порядок = ЗапросСхемы.Порядок;
		Порядок.Добавить(ЗапросСхемы.Колонки[2]);
		Порядок.Добавить(ЗапросСхемы.Колонки[3]);
		Порядок.Сдвинуть(1,0);
		Порядок.Сдвинуть(2,1);
		
		КонтрольныеТочкиИтогов = ЗапросСхемы.КонтрольныеТочкиИтогов;
		КонтрольныеТочкиИтогов.Добавить(ЗапросСхемы.Колонки[1]);	
		КонтрольныеТочкиИтогов.Сдвинуть(2,0);
		
		ТекстЗапроса = СхемаЗапроса.ПолучитьТекстЗапроса();
		
	КонецЕсли;
	
	Запрос.Текст = ТекстЗапроса;
	
	Запрос.УстановитьПараметр("Дата",            ?(Объект.Дата = Дата(1,1,1), ТекущаяДата(), КонецДня(Объект.Дата)));
	Запрос.УстановитьПараметр("ТекДок",          Объект.Ссылка);
	Запрос.УстановитьПараметр("ПоТекДоку",       поТекДокументу);
	Запрос.УстановитьПараметр("Организация",     Объект.Организация);
	Запрос.УстановитьПараметр("НеРазделять",     Не ФППоОрганизациям);
	Запрос.УстановитьПараметр("ЭтоРСФ",          ЭтоРСФ);
	
	//Минаев
	ДеревоЗПЗнач = Запрос.Выполнить().Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	//добавление исходной и др сумм
	СуммаВсего = 0;
	ИсхСуммаВсего = 0;
	НачислНал = 0;
	НачислБезнал = 0;
	
	Если ВыводитьГруппировкуПоСчетам Тогда
		Для каждого стрСчет из ДеревоЗПЗнач.Строки ЦИкл
			
			стрСчет.ПодразделениеФонд = стрСчет.Счет;
			стрСчет.СчетПорядок = ?(стрСчет.Счет = ПредопределенноеЗначение("Справочник.ИА_Счета.ГлавныйСчет"), 0,?(стрСчет.Счет = ПредопределенноеЗначение("Справочник.ИА_Счета.Счет1"), 1, 200));
			
			ЗаполнитьТаблицуЗППодразделения(ИсхСуммаВсего, НачислБезнал, НачислНал, стрСчет, СуммаВсего);
			
		КонецЦикла;
	Иначе
		
		ЗаполнитьТаблицуЗППодразделения(ИсхСуммаВсего, НачислБезнал, НачислНал, ДеревоЗПЗнач, СуммаВсего);
		
	КонецЕсли;
	
	// добавление пустых фондов
	ВыборкаФондовСпр = ВыбратьФонды(); //Справочники.ИА_Фонды.Выбрать( , , );
	Пока ВыборкаФондовСпр.Следующий() Цикл 
		
		СчетФонда = ВыборкаФондовСпр.Счет;
		
		ТЗ_Подр = ВыборкаФондовСпр.Подразделения.Выгрузить();
		ТЗ_Подр.Свернуть("Подразделение");
		
		Если ВыводитьГруппировкуПоСчетам Тогда
			
			СтрокаСчет = ДеревоЗПЗнач.Строки.Найти(СчетФонда, "Счет");
			
			Если СтрокаСчет = Неопределено Тогда
				
				СтрокаСчет = ДеревоЗПЗнач.Строки.Добавить();
				СтрокаСчет.Счет = СчетФонда;
				СтрокаСчет.СчетПорядок = ?(СтрокаСчет.Счет = ПредопределенноеЗначение("Справочник.ИА_Счета.ГлавныйСчет"), 0,?(СтрокаСчет.Счет = ПредопределенноеЗначение("Справочник.ИА_Счета.Счет1"), 1, 200));
				СтрокаСчет.ПодразделениеФонд = СчетФонда;
				СтрокаСчет.СуммаНал = 0;
				СтрокаСчет.СуммаБезнал = 0;
				СтрокаСчет.НачислениеВФондНал = 0;
				СтрокаСчет.НачислениеВФондБезнал = 0;
				
			КонецЕсли;
			
			СтрокиПодразделений = СтрокаСчет.Строки;
			
		Иначе	
			СтрокиПодразделений = ДеревоЗПЗнач.Строки;
		КонецЕсли;
		
		Для каждого стрПодрФ из ТЗ_Подр Цикл
			
			СтрокаПодразделения = СтрокиПодразделений.Найти(стрПодрФ.Подразделение, "Подразделение");
			Если СтрокаПодразделения = Неопределено Тогда // такого подр нет
				
				СтрокаПодразделения = СтрокиПодразделений.Добавить();
				СтрокаПодразделения.Счет = СчетФонда;
				СтрокаПодразделения.СчетПорядок = ?(СтрокаПодразделения.Счет = ПредопределенноеЗначение("Справочник.ИА_Счета.ГлавныйСчет"), 0,?(СтрокаПодразделения.Счет = ПредопределенноеЗначение("Справочник.ИА_Счета.Счет1"), 1, 200));
				СтрокаПодразделения.Подразделение = стрПодрФ.Подразделение;
				СтрокаПодразделения.ПодразделениеФонд = стрПодрФ.Подразделение;
				СтрокаПодразделения.СуммаНал = 0;
				СтрокаПодразделения.СуммаБезнал = 0;
				СтрокаПодразделения.НачислениеВФондНал = 0;
				СтрокаПодразделения.НачислениеВФондБезнал = 0;
				
			КонецЕсли;
			
			СтрокиФонд = СтрокаПодразделения.Строки;
			СтрокаФонд = СтрокиФонд.Найти(ВыборкаФондовСпр.Ссылка, "Фонд");
			
			Если СтрокаФонд = Неопределено Тогда
				
				СтрокаФонд = СтрокиФонд.Добавить();
				СтрокаФонд.Счет = СчетФонда;
				СтрокаФонд.СчетПорядок = ?(СтрокаФонд.Счет = ПредопределенноеЗначение("Справочник.ИА_Счета.ГлавныйСчет"), 0,?(СтрокаФонд.Счет = ПредопределенноеЗначение("Справочник.ИА_Счета.Счет1"), 1, 200));
				СтрокаФонд.Подразделение = стрПодрФ.Подразделение;
				СтрокаФонд.ПодразделениеФонд = Строка(ВыборкаФондовСпр.Ссылка);
				СтрокаФонд.Фонд = ВыборкаФондовСпр.Ссылка;
				СтрокаФонд.ФондКод = ВыборкаФондовСпр.Код;
				СтрокаФонд.СуммаНал = 0;
				СтрокаФонд.СуммаБезнал = 0;
				СтрокаФонд.НачислениеВФондНал = 0;
				СтрокаФонд.НачислениеВФондБезнал = 0;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Если поТекДокументу Тогда
		СтрокиДерева = ДеревоЗПЗнач.Строки;
		Если ВыводитьГруппировкуПоСчетам Тогда
			Для каждого СтрокаCчет из СтрокиДерева Цикл
				СтрокиСчет = СтрокаCчет.Строки;
				ЗаполнитьТаблицуЗПпоТекДокументуПодразделения(СтрокиСчет);
			КонецЦикла;
		Иначе
			ЗаполнитьТаблицуЗПпоТекДокументуПодразделения(СтрокиДерева);
		КонецЕсли;
	КонецЕсли;
	
	СортировкаДеревоЗПЗнач = ?(ВыводитьГруппировкуПоСчетам, "СчетПорядок, Счет, Подразделение,ФондКод", "Подразделение, ФондКод");
	ДеревоЗПЗнач.Строки.Сортировать(СортировкаДеревоЗПЗнач, истина);
	ДеревоЗПЗнач.Колонки.Удалить("ФондКод");
	
	//Минаев
	ЗначениеВРеквизитФормы(ДеревоЗПЗнач, "ДеревоЗП");
	Элементы.ДеревоЗППодразделение.Видимость = Ложь;
	Элементы.ДеревоЗПФонд.Видимость = Ложь;
	
КонецПроцедуры

&НаСервере
Функция ВыбратьФонды()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ИА_Фонды.Ссылка,
	|	ИА_Фонды.Код,
	|	ИА_Фонды.Наименование,
	|	ИА_Фонды.ОтображатьВСписке,
	|	ИА_Фонды.РазрешитьРасходВМинус,
	|	ИА_Фонды.Счет,
	|	ИА_Фонды.Подразделения.(
	|		Ссылка,
	|		НомерСтроки,
	|		Подразделение
	|	)
	|ИЗ
	|	Справочник.ИА_Фонды КАК ИА_Фонды
	|ГДЕ
	|	(ИА_Фонды.Счет <> ЗНАЧЕНИЕ(Справочник.ИА_Счета.Счет1)
	|			ИЛИ &ЭтоРСФ)
	|	И ИА_Фонды.ЭтоГруппа = ЛОЖЬ
	|	И ИА_Фонды.ОтображатьВСписке = ИСТИНА";
	
	Запрос.УстановитьПараметр("ЭтоРСФ", ЭтоРСФ);	   
	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат РезультатЗапроса.Выбрать();
	
КонецФункции

&НаСервере
Процедура ЗаполнитьТаблицуЗПпоТекДокументуПодразделения(Знач СтрокиСчет)
	
	Перем СтрокаЗП, СтрокаПодразделение, СтрокаФонд, СтрокиПодразделение, СтрокиФонд, сч;
	
	Для каждого СтрокаПодразделение из СтрокиСчет Цикл
		СтрокиПодразделение = СтрокаПодразделение.Строки;
		Для каждого СтрокаФонд из СтрокиПодразделение Цикл
			СтрокиФонд = СтрокаФонд.Строки;
			сч = СтрокиФонд.Количество() - 1;
			Пока сч >= 0 Цикл
				СтрокаЗП = СтрокиФонд[сч];
				Если не ЗначениеЗаполнено(СтрокаЗП.Заказ) Тогда
					СтрокиФонд.Удалить(сч);
				иначе
					СтрокаЗП.НачислениеВФондНал = 0;
					СтрокаЗП.НачислениеВФондБезнал = 0;
				КонецЕсли;
				сч = сч - 1;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТаблицуЗППодразделения(ИсхСуммаВсего, НачислБезнал, НачислНал, стрСчет, СуммаВсего)
	
	Для каждого стрПодр из стрСчет.Строки ЦИкл
		
		ЗаполнитьТаблицуЗПФонды(ИсхСуммаВсего, НачислБезнал, НачислНал, стрПодр, СуммаВсего);
		
		стрПодр.СчетПорядок = ?(стрПодр.Счет = ПредопределенноеЗначение("Справочник.ИА_Счета.ГлавныйСчет"), 0,?(стрПодр.Счет = ПредопределенноеЗначение("Справочник.ИА_Счета.Счет1"), 1, 200));
		стрПодр.ПодразделениеФонд = Строка(стрПодр.Подразделение);
		
		стрПодр.УтвержденнаяСумма = Формат(СуммаВсего,"ЧДЦ=2; ЧН="); 
		стрПодр.ИсходнаяСумма = Формат(ИсхСуммаВсего,"ЧДЦ=2; ЧН=");
		стрПодр.НачислениеВФондНал = Формат(НачислНал,"ЧДЦ=2; ЧН=");
		стрПодр.НачислениеВФондБезнал = Формат(НачислБезнал,"ЧДЦ=2; ЧН=");
		стрПодр.НачислениеВФонд = Формат(НачислБезнал,"ЧДЦ=2; ЧН=");
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТаблицуЗПФонды(ИсхСуммаВсего, НачислБезнал, НачислНал, стрПодр, СуммаВсего)
	
	Для каждого стр из стрПодр.Строки Цикл
		
		стр.СчетПорядок = ?(стр.Счет = ПредопределенноеЗначение("Справочник.ИА_Счета.ГлавныйСчет"), 0,?(стр.Счет = ПредопределенноеЗначение("Справочник.ИА_Счета.Счет1"), 1, 200));
		
		Если ЗначениеЗаполнено(стр.Фонд) Тогда
			стр.ПодразделениеФонд = стр.Фонд;
		КонецЕсли;
		
		СуммаВсегоСтр = 0;
		ИсхСуммаВсегоСтр = 0;
		
		Для каждого стр1 из стр.Строки Цикл
			
			Если ЗначениеЗаполнено(стр.Фонд) Тогда
				стр1.ПодразделениеФонд = стр1.Фонд;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(стр1.Заказ) Тогда
				стр1.ИсходнаяСумма = стр1.Заказ.Сумма;
			КонецЕсли;
			
			Если Объект.СуммаКРаспределениюСОстаткомНал + Объект.СуммаКРаспределениюСОстаткомБезнал > 0 Тогда
				
				СуммаВсегоСтр = СуммаВсегоСтр + стр1.УтвержденнаяСумма;
				Если ЗначениеЗаполнено(стр1.Заказ) Тогда
					ИсхСуммаВсегоСтр = ИсхСуммаВсегоСтр + стр1.Заказ.Сумма;
				КонецЕсли;
				
				СуммаВсего = СуммаВсего + стр1.УтвержденнаяСумма;
				Если ЗначениеЗаполнено(стр1.Заказ) Тогда
					ИсхСуммаВсего = ИсхСуммаВсего + стр1.Заказ.Сумма;
				КонецЕсли;
				
			КонецЕсли;	
			
		КонецЦикла;
		
		НачислНал = НачислНал + стр.НачислениеВФондНал;
		НачислБезнал = НачислБезнал + стр.НачислениеВФондБезнал;
		стр.УтвержденнаяСумма = Формат(СуммаВсегоСтр,"ЧДЦ=2; ЧН="); 
		стр.ИсходнаяСумма = Формат(ИсхСуммаВсегоСтр,"ЧДЦ=2; ЧН="); 
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТаблицуПолитика(ДокНастройка = Неопределено, ФП1 = ложь)
	Запрос = Новый Запрос;
	
	Если ИспользоватьСлужебнуюНастройку Тогда
		СлужебнаяНастройкаФП_Стр = ЗначениеИзСтрокиВнутр(СлужебнаяНастройкаФП);
		
		мен = Новый МенеджерВременныхТаблиц;
		Запрос.МенеджерВременныхТаблиц = мен;
		Запрос.Текст = "ВЫБРАТЬ
		|	ИА_НастройкаФППолитикаРаспределенияТЗ.LineNumber,
		|	ИА_НастройкаФППолитикаРаспределенияТЗ.Фонд,
		|	ИА_НастройкаФППолитикаРаспределенияТЗ.РежимРасчета,
		|	ИА_НастройкаФППолитикаРаспределенияТЗ.Значение,
		|	ИА_НастройкаФППолитикаРаспределенияТЗ.Подразделение,
		|	ИА_НастройкаФППолитикаРаспределенияТЗ.ЗначениеБезнал,
		|	ИА_НастройкаФППолитикаРаспределенияТЗ.Раздел КАК Раздел,
		|	ИА_НастройкаФППолитикаРаспределенияТЗ.ПроцентОтИтогаРаздела КАК ПроцентОтИтогаРаздела
		|ПОМЕСТИТЬ ИА_НастройкаФППолитикаРаспределения
		|ИЗ
		|	&ТЗ КАК ИА_НастройкаФППолитикаРаспределенияТЗ";
		Запрос.УстановитьПараметр("ТЗ", СлужебнаяНастройкаФП_Стр.ПолитикаРаспределения);
		Запрос.Выполнить();
		
		Запрос.Текст = "ВЫБРАТЬ
		|	ИА_НастройкаФППолитикаРаспределения.Фонд,
		|	ИА_НастройкаФППолитикаРаспределения.РежимРасчета,
		|	ИА_НастройкаФППолитикаРаспределения.Значение,
		|	ИА_НастройкаФППолитикаРаспределения.Подразделение,
		|	ИА_НастройкаФППолитикаРаспределения.ЗначениеБезнал,
		|	ИА_НастройкаФППолитикаРаспределения.Раздел КАК Раздел,
		|	ИА_НастройкаФППолитикаРаспределения.ПроцентОтИтогаРаздела КАК ПроцентОтИтогаРаздела,
		|	0 КАК СуммаНал,
		|	0 КАК СуммаБезнал,
		|	0 КАК Итого,
		|	0 КАК Сумма,
		|	"""" КАК РасчетФормулы,
		|	"""" КАК РасчетФормулыНал
		|ИЗ
		|	ИА_НастройкаФППолитикаРаспределения КАК ИА_НастройкаФППолитикаРаспределения
		|
		|УПОРЯДОЧИТЬ ПО
		|	ИА_НастройкаФППолитикаРаспределения.Раздел.Наименование,
		|	ИА_НастройкаФППолитикаРаспределения.LineNumber
		|ИТОГИ ПО
		|	Раздел";
	ИначеЕсли ДокНастройка = Неопределено Тогда // по текущему документу
		Запрос.Текст = "ВЫБРАТЬ
		|	ИА_ФинансовоеПланированиеПолитикаРаспределения.Фонд,
		|	ИА_ФинансовоеПланированиеПолитикаРаспределения.РежимРасчета,
		|	ИА_ФинансовоеПланированиеПолитикаРаспределения.Значение,
		|	ИА_ФинансовоеПланированиеПолитикаРаспределения.СуммаНал КАК СуммаНал,
