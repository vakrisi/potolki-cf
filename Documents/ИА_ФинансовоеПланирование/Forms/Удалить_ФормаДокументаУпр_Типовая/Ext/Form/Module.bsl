&НаКлиенте 
Процедура ДеревоЗПЗаказПриИзменении(ТекСтрока)
	
	//ТекСтрока = Элементы.ДеревоЗП.ТекущиеДанные;
	Если ЗначениеЗаполнено(ТекСтрока.Заказ) Тогда
		зак = ТекСтрока.Заказ;
		ДанныеЗаказа = ТекСтрокаЗаказФонд(зак);
		Если ДанныеЗаказа.Фонд <> ТекСтрока.Фонд Тогда
			Сообщить("У заявки другая статья расходов!");
			ТекСтрока.Заказ = ИА_ЗаказНаПриобретениеПустаяСсылка();
			Возврат;
		КонецЕсли;
		
		ТекСтрока.ПредметЗаказа = ДанныеЗаказа.ПредметЗаказа;
		СуммаТек = ДанныеЗаказа.Сумма;
		ТекСтрока.ИсходнаяСумма = ДанныеЗаказа.ИсходнаяСумма;
		ТекСтрока.СуммаНал = 0;
		ТекСтрока.СуммаБезнал = 0;
		
		СуммаТек = Сумма_ИА_СредстваВРезервеНаФондах(СуммаТек,зак, Объект.Ссылка);
		
		Если ДанныеЗаказа.ВидДС = ИА_ВидДенежныхСредствНаличные Тогда
			ТекСтрока.СуммаНал = СуммаТек;
		Иначе
			ТекСтрока.СуммаБезнал = СуммаТек;
		КонецЕсли;
		ТекСтрока.Статус = ДанныеЗаказа.Статус;
		ТекСтрока.ПричинаОтказа = ДанныеЗаказа.ПричинаОтказа;
	КонецЕсли;
	
КонецПроцедуры

