&НаКлиенте
Процедура ДеревоЗППриАктивизацииЯчейки(Элемент)
	тд = Элементы.ДеревоЗП.ТекущиеДанные;
	Если тд  <>  Неопределено Тогда
		
		Если  ЗначениеЗаполнено(тд.Заказ) Тогда // строка с заказом
			Если (Элемент.ТекущийЭлемент.Имя = "ДеревоЗПСуммаБезнал") или
				(Элемент.ТекущийЭлемент.Имя = "ДеревоЗПСуммаНал") или
				(Элемент.ТекущийЭлемент.Имя = "ДеревоЗПСумма") или
				(Элемент.ТекущийЭлемент.Имя = "ДеревоЗПНачислениеВФондНал") или
				(Элемент.ТекущийЭлемент.Имя = "ДеревоЗПНачислениеВФондБезнал") или
				(Элемент.ТекущийЭлемент.Имя = "ДеревоЗППодразделениеФонд") или
				(Элемент.ТекущийЭлемент.Имя = "ДеревоЗППредметЗаказа") или
				(Элемент.ТекущийЭлемент.Имя = "ДеревоЗПИсходнаяСумма") или
				(Элемент.ТекущийЭлемент.Имя = "ДеревоЗПНачислениеВФонд") Тогда
				Элемент.ТекущийЭлемент.ТолькоПросмотр = Истина;
			Иначе
				Элемент.ТекущийЭлемент.ТолькоПросмотр = Ложь;
			КонецЕсли;
		ИначеЕсли  Не ЗначениеЗаполнено(тд.Заказ) и ЗначениеЗаполнено(тд.Фонд) Тогда  // строка с фондом
			Если(Элемент.ТекущийЭлемент.Имя = "ДеревоЗПНачислениеВФондНал") или
				(Элемент.ТекущийЭлемент.Имя = "ДеревоЗПНачислениеВФондБезнал") или
				(Элемент.ТекущийЭлемент.Имя = "ДеревоЗПНачислениеВФонд") Тогда
				Элемент.ТекущийЭлемент.ТолькоПросмотр = Ложь;
			Иначе
				Элемент.ТекущийЭлемент.ТолькоПросмотр = Истина;
			КонецЕсли;
		ИначеЕсли  ЗначениеЗаполнено(тд.Подразделение) и Не ЗначениеЗаполнено(тд.Фонд) Тогда // верхний уровень - подразделение	
			Элемент.ТекущийЭлемент.ТолькоПросмотр = истина;
		ИначеЕсли ВыводитьГруппировкуПоСчетам И ЗначениеЗаполнено(тд.Счет) и Не ЗначениеЗаполнено(тд.Подразделение) Тогда // верхний уровень - счет	 если ВыводитьГруппировкуПоСчетам
			Элемент.ТекущийЭлемент.ТолькоПросмотр = истина;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

