Функция НайтиСтрокуСчетВДереверЗП(СтрокаВерхнегоУровня, Счет)
	
	НайдСтрокаСчет = Неопределено;
	Для каждого стрСчет из СтрокаВерхнегоУровня.ПолучитьЭлементы() ЦИкл
		Если стрСчет.Счет = Счет ТОгда
			НайдСтрокаСчет = стрСчет;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если НайдСтрокаСчет = Неопределено Тогда
		
		ЭлементыСтрокиВерхнегоУровня =  СтрокаВерхнегоУровня.ПолучитьЭлементы();
		
		НайдСтрокаСчет = ЭлементыСтрокиВерхнегоУровня.Добавить();
		НайдСтрокаСчет.Счет =  Счет;
		НайдСтрокаСчет.ПодразделениеФонд = Строка(Счет); 
		
	КонецЕсли;
	
	Возврат НайдСтрокаСчет;
	
