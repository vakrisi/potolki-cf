&НаСервере
Функция МассивОрганизацийФП()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ИА_ГруппыКомпанийДочерниеОрганизации.Организация
	|ИЗ
	|	Справочник.ИА_ГруппыКомпаний.ДочерниеОрганизации КАК ИА_ГруппыКомпанийДочерниеОрганизации
	|ГДЕ
	|	ИА_ГруппыКомпанийДочерниеОрганизации.Ссылка.ГоловнаяОрганизация = &ГоловнаяОрганизация
	|
	|СГРУППИРОВАТЬ ПО
	|	ИА_ГруппыКомпанийДочерниеОрганизации.Организация";
	
	Запрос.УстановитьПараметр("ГоловнаяОрганизация", Объект.Организация);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Массив = Новый Массив;
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Массив.Добавить(ВыборкаДетальныеЗаписи.Организация);
	КонецЦикла;
	Если Массив.Найти(Объект.Организация) = Неопределено Тогда 
		Массив.Добавить(Объект.Организация);
	КонецЕсли;
	Возврат Массив;
	
КонецФункции

&НаСервере
Функция ПолучитьПоследнееФП()
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ИА_ФинансовоеПланирование.Ссылка,
	|	ИА_ФинансовоеПланирование.Дата
	|ИЗ
	|	Документ.ИА_ФинансовоеПланирование КАК ИА_ФинансовоеПланирование
	|ГДЕ
	|	ИА_ФинансовоеПланирование.Проведен = ИСТИНА
	|	И (ИА_ФинансовоеПланирование.Организация = &Организация
	|			ИЛИ &НеРазделять)
	|	И ИА_ФинансовоеПланирование.Дата < &Дата
	|
	|УПОРЯДОЧИТЬ ПО
	|	ИА_ФинансовоеПланирование.Дата УБЫВ";
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	Запрос.УстановитьПараметр("НеРазделять", не ФППоОрганизациям);
	Запрос.УстановитьПараметр("Дата", ?(ЗначениеЗаполнено(Объект.Дата) , Объект.Дата, ТекущаяДата()));
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Новый структура("Ссылка,Дата", Выборка.Ссылка, Выборка.Дата);
	Иначе
		Возврат Документы.ИА_ФинансовоеПланирование.ПустаяСсылка();
	КонецЕсли;
КонецФункции

&НаСервере
Процедура ОбновитьДоходыБПСервер()
	
	Объект.ДоходыБП_Распределение.Очистить();
	
	Запрос = новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ИА_ДоходыБудущихПериодовОстатки.ВидДохода,
	|	ИА_ДоходыБудущихПериодовОстатки.Источник,
	|	ИА_ДоходыБудущихПериодовОстатки.СуммаНалОстаток КАК СуммаНал,
	|	ИА_ДоходыБудущихПериодовОстатки.СуммаБезналОстаток КАК СуммаБезнал
	|ИЗ
	|	РегистрНакопления.ИА_ДоходыБудущихПериодов.Остатки(
	|			&НаДату,
	|			Организация = &Организация
	|				ИЛИ &НеРазделять) КАК ИА_ДоходыБудущихПериодовОстатки
	|ГДЕ
	|	ИА_ДоходыБудущихПериодовОстатки.СуммаНалОстаток <> 0
	|			ИЛИ ИА_ДоходыБудущихПериодовОстатки.СуммаБезналОстаток <> 0";
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	Запрос.УстановитьПараметр("НеРазделять", не ФППоОрганизациям);
	Запрос.УстановитьПараметр("НаДату", Объект.Дата);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Новстр = Объект.ДоходыБП_Распределение.Добавить();
		ЗаполнитьЗначенияСвойств(Новстр, Выборка);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьДоходыБП()
	Если ЗначениеЗаполнено(Объект.Ссылка) и Объект.ДоходыБП_Распределение.Количество()> 0 И Вопрос("Таблица будет очищена. Продолжить?", РежимДиалогаВопрос.ДаНет)=КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли;	
	ОбновитьДоходыБПСервер();
КонецПроцедуры

&НаСервере
Процедура ПересчитатьПредварительнуюСуммуКРаспределению()
	Объект.НераспределяемаяСуммаНал = 0;
	Объект.НераспределяемаяСуммаБезнал = 0;
	
	Для каждого стр из Объект.Доходы Цикл
		Если не стр.ВидДохода.Распределять Тогда
			Объект.НераспределяемаяСуммаНал = Объект.НераспределяемаяСуммаНал + стр.СуммаНал;
			Объект.НераспределяемаяСуммаБезнал = Объект.НераспределяемаяСуммаБезнал + стр.СуммаБезнал;
		КонецЕсли;
	КонецЦикла;
	
	//
	СуммаПолитикаНал = 0;
	СуммаПолитикаБезнал = 0;
	
	//Минаев
	ДеревоПолитикаПервичнаяЗнач = РеквизитФормыВЗначение("ДеревоПолитикаПервичная");
	
	Для каждого стр из ДеревоПолитикаПервичнаяЗнач.Строки Цикл
		СуммаРазделНал = 0;
		СуммаРазделБезнал = 0;
		Для каждого стр1 Из стр.Строки Цикл
			СуммаРазделНал = СуммаРазделНал + стр1.СуммаНал;
			СуммаРазделБезнал = СуммаРазделБезнал + стр1.СуммаБезнал;
		КонецЦикла;
		Если стр.Строки.Количество()>0 Тогда // пропускаем скд
			// итоги по разделу
			стр.СуммаНал = СуммаРазделНал;
			стр.СуммаБезнал = СуммаРазделБезнал;
		КонецЕсли;
		СуммаПолитикаНал = СуммаПолитикаНал + СуммаРазделНал;
		СуммаПолитикаБезнал = СуммаПолитикаБезнал + СуммаРазделБезнал;
	КонецЦикла;
	
	Объект.ПредварительнаяСуммаКРаспределениюНал = Объект.ПредварительнаяСуммаКРаспределениюНал1 - СуммаПолитикаНал + Объект.РаспределениеСредствСФондов.Итог("СуммаНал");
	Объект.ПредварительнаяСуммаКРаспределениюБезнал = Объект.ПредварительнаяСуммаКРаспределениюБезнал1 - СуммаПолитикаБезнал + Объект.РаспределениеСредствСФондов.Итог("СуммаБезНал");
КонецПроцедуры

&НаСервере
Процедура ПересчитатьПредварительнуюСуммуКРаспределению1()
	Объект.ПредварительнаяСуммаКРаспределениюНал1 = 0;
	Объект.ПредварительнаяСуммаКРаспределениюБезнал1 = 0;
	
	Для каждого стр из Объект.Доходы Цикл
		Если стр.ВидДохода.Распределять Тогда
			Объект.ПредварительнаяСуммаКРаспределениюНал1 = Объект.ПредварительнаяСуммаКРаспределениюНал1 + стр.СуммаНал;
			Объект.ПредварительнаяСуммаКРаспределениюБезнал1 = Объект.ПредварительнаяСуммаКРаспределениюБезнал1 + стр.СуммаБезнал;
		КонецЕсли;
	КонецЦикла;
	
	Объект.ПредварительнаяСуммаКРаспределениюНал1 = Объект.ПредварительнаяСуммаКРаспределениюНал1;
	Объект.ПредварительнаяСуммаКРаспределениюБезнал1 = Объект.ПредварительнаяСуммаКРаспределениюБезнал1;
	
КонецПроцедуры

&НаСервере
Процедура ОсновнойПерерасчет(Глубина)
	
	РассчитанныеФормулы.Очистить();
	
	Если Глубина <= 1 Тогда // изменение доходов
		//ПересчитатьПрямыеРасходы();
	КонецЕсли;
	
	Если Глубина <= 2 Тогда // изменение прямых расходов
		ПересчитатьПредварительнуюСуммуКРаспределению1();
		ПересчитатьПолитику("ДеревоПолитикаПервичная");
	КонецЕсли;
	
	Если Глубина <= 3 Тогда // изменение политики 1
		ПересчитатьПредварительнуюСуммуКРаспределению();
	КонецЕсли;	
	
	Если Глубина <= 4 Тогда // изменение спецдохода
		Объект.МаржинальнаяПрибыльНал    = Объект.ПредварительнаяСуммаКРаспределениюНал    - Объект.ДоходыБП.итог("СуммаНал")    + Объект.ДоходыБП_Распределение.итог("СуммаНал");
		Объект.МаржинальнаяПрибыльБезнал = Объект.ПредварительнаяСуммаКРаспределениюБезнал - Объект.ДоходыБП.итог("СуммаБезНал") + Объект.ДоходыБП_Распределение.итог("СуммаБезНал");
		ПересчитатьПолитику("ДеревоПолитика");
	КонецЕсли;	
	
	Если Глубина <= 5 Тогда // изменение политики
		СуммаПолитикаНал    = 0;
		СуммаПолитикаБезнал = 0;
		//Минаев
		ДеревоПолитикаЗнач  = РеквизитФормыВЗначение("ДеревоПолитика");
		
		Для каждого стр из ДеревоПолитикаЗнач.Строки Цикл
			
			СуммаРазделНал    = 0;
			СуммаРазделБезнал = 0;
			
			Для каждого стр1 Из стр.Строки Цикл
				СуммаРазделНал    = СуммаРазделНал + стр1.СуммаНал;
				СуммаРазделБезнал = СуммаРазделБезнал + стр1.СуммаБезнал;
			КонецЦикла;
			
			Если стр.Строки.Количество()>0 Тогда // пропускаем скд
				// итоги по разделу
				стр.СуммаНал    = СуммаРазделНал;
				стр.СуммаБезнал = СуммаРазделБезнал;
			КонецЕсли;
			
			СуммаПолитикаНал    = СуммаПолитикаНал    + СуммаРазделНал;
			СуммаПолитикаБезнал = СуммаПолитикаБезнал + СуммаРазделБезнал;
			
		КонецЦикла;
		
		Объект.СуммаКРаспределениюНал    = Объект.МаржинальнаяПрибыльНал    - СуммаПолитикаНал    + Объект.НераспределяемаяСуммаНал;
		Объект.СуммаКРаспределениюБезнал = Объект.МаржинальнаяПрибыльБезнал - СуммаПолитикаБезнал + Объект.НераспределяемаяСуммаБезнал;
		
		Объект.СуммаКРаспределениюСОстаткомНал    = Объект.СуммаКРаспределениюНал;
		Объект.СуммаКРаспределениюСОстаткомБезнал = Объект.СуммаКРаспределениюБезнал;
		
		ПересчитатьСальдоСредствКРаспределению();
		ОбновитьОтчетПоСотояниюФондов();
		
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьПроцентыПолитикиИПересчитать(НомерПолитики)
	Если ИспользоватьСлужебнуюНастройку Тогда
		НастройкаФП = Неопределено;
	Иначе
		НастройкаФП = ИА_ФП.ПолучитьПоследнююНастройку(Объект.Организация, ФППоОрганизациям, ?(ЗначениеЗаполнено(Объект.Дата) , Объект.Дата, ТекущаяДата()));
	КонецЕсли;
	
	ПересчитатьЗапросы();
	
	Если НомерПолитики = 1 Тогда
		ЗаполнитьТаблицуПолитикаПервичная(НастройкаФП);
	ИначеЕсли НомерПолитики = 2 Тогда
		ЗаполнитьТаблицуПолитика(НастройкаФП);
	КонецЕсли;
	
	Если НомерПолитики = 1 Тогда
		ОсновнойПерерасчет(1);
	ИначеЕсли НомерПолитики = 2 Тогда
		ОсновнойПерерасчет(4);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ДоходыПриИзменении(Элемент)
	Элемент.ТекущиеДанные.Итого = Элемент.ТекущиеДанные.СуммаБезнал + Элемент.ТекущиеДанные.СуммаНал;
	Элементы.ДоходыИтого.ТекстПодвала = Объект.Доходы.Итог("СуммаНал") + Объект.Доходы.Итог("СуммаБезнал");
	ОбновитьПроцентыПолитикиИПересчитать(1);
КонецПроцедуры

&НаКлиенте
Процедура ДоходыПриАктивизацииСтроки(Элемент)
	
	Если Элемент.ТекущиеДанные <> Неопределено Тогда
		Элемент.ТекущиеДанные.Итого = Элемент.ТекущиеДанные.СуммаБезнал + Элемент.ТекущиеДанные.СуммаНал;
	КонецЕсли;
	Элементы.ДоходыИтого.ТекстПодвала = Объект.Доходы.Итог("СуммаНал") + Объект.Доходы.Итог("СуммаБезнал");
КонецПроцедуры

