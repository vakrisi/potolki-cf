&НаКлиенте
Процедура ДеревоПолитикаСуммаНалОткрытие(Элемент, СтандартнаяОбработка)
	СтандартнаяОбработка = ложь;
	
	Если  Элемент.Родитель.ТекущиеДанные.РежимРасчета <> ПредопределенноеЗначение("Перечисление.ИА_РежимРасчетаСуммы.ВычисляемоеВыражение") Тогда 
		возврат 
	КонецЕсли;
	
	формула = Элемент.Родитель.ТекущиеДанные.ЗначениеБезнал;
	расчет = Элемент.Родитель.ТекущиеДанные.РасчетФормулы;
	ИтогРасчета = Элемент.Родитель.ТекущиеДанные.СуммаБезнал;
	Если Элемент.Заголовок = "Сумма нал" Тогда
		формула = Элемент.Родитель.ТекущиеДанные.Значение;
		расчет = Элемент.Родитель.ТекущиеДанные.РасчетФормулыНал;
		ИтогРасчета = Элемент.Родитель.ТекущиеДанные.СуммаНал;
	КонецЕсли;
	
	Табдок = ПолучитьОтчетПоФормуле(формула, расчет, ИтогРасчета);
	ф = ПолучитьФорму("Документ.ИА_ФинансовоеПланирование.Форма.РасшифровкаФормулы");
	ф.ТабДок = ТабДок;
	ф.Открыть();
КонецПроцедуры

&НаСервере
Функция ПолучитьОтчетПоФормуле(формула, расчет, итогРасчета)
	Табдок = Новый ТабличныйДокумент;
	Табдок.ТолькоПросмотр = истина;
	
	Макет = Документы.ИА_ФинансовоеПланирование.ПолучитьМакет("РасшифровкаФормулы");
	ОблШапка = Макет.ПолучитьОбласть("Шапка");
	ОблШапка.Параметры.Формула = формула;
	ОблШапка.Параметры.расчет = расчет;
	ОблШапка.Параметры.ИтогРасчета = итогРасчета;
	Табдок.Вывести(ОблШапка);
	
	Для каждого стр из Объект.ЗапросыДанных Цикл
		ОблСтрока = Макет.ПолучитьОбласть("Запрос");
		ОблСтрока.Параметры.Запрос = стр.Запрос;
		ОблСтрока.Параметры.ЗапросТаб = ИА_БФС.ТЗ_ВывестиВТабДок(ЗначениеИзСтрокиВнутр(стр.Расшифровка));
		Табдок.Вывести(ОблСтрока);
	КонецЦикла;
	
	Возврат Табдок;
КонецФункции

