&НаКлиенте
Процедура КомандаПечать(Команда)
	
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Или Модифицированность И Не Объект.Проведен Тогда
		
		Если Вопрос("Перед печатью документ необходимо записать!" + Символы.ПС +"Выполнить?",РежимДиалогаВопрос.ДаНет) = КодВозвратаДиалога.Да Тогда
			Записать();
		Иначе
			Возврат;		 	
		КонецЕсли;
		
	КонецЕсли;
	
	ф = ПолучитьФорму("Документ.ИА_ФинансовоеПланирование.Форма.ФормаВыбораПечатнойФормы");
	
	// форма фозвращает строковое представление
	Значение = ф.ОткрытьМодально();
	
	Если Значение = "Состояние статей расходов" Тогда
		Если Не ЗначениеЗаполнено(Объект.Ссылка) или Модифицированность или не Объект.Проведен Тогда
			Предупреждение("Необходимо сначала записать и провести документ!");
			Возврат;
		КонецЕсли;
		тд = ИА_ФинансоваяДирективаРасшифровкаСоздать();
		тд.Показать();
	ИначеЕсли Значение = "Директива ФП" Тогда
		
		Если Не ЗначениеЗаполнено(Объект.Ссылка) или Модифицированность или не Объект.Проведен Тогда
			Предупреждение("Необходимо сначала записать и провести документ!");
			Возврат;
		КонецЕсли;
		
		тд = ИА_ФинансоваяДирективаЛист3Создать();
		
		тд.ОтображатьСетку     = Ложь;
		тд.ОтображатьЗаголовки = Ложь;
		
		тд.Показать("Печать (Директива ФП)");
		
	ИначеЕсли Значение = "ФП 1" Тогда
		Если Не ЗначениеЗаполнено(Объект.Ссылка) или Модифицированность Тогда
			Предупреждение("Необходимо сначала записать документ!");
			Возврат;
		КонецЕсли;
		
		тд = ИА_ФинансовоеПланирование1Создать();
		тд.Показать();		
	КонецЕсли;
КонецПроцедуры

