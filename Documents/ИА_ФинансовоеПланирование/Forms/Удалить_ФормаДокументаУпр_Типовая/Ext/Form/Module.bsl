Функция ПолучитьСтруктуруДанныхТекДок()
	Рез = Новый Структура;
	Рез.Вставить("ДокФП_Дата", Объект.Дата);
	Рез.Вставить("ДокФП_Ссылка", Объект.Ссылка);
	Рез.Вставить("ДокФП_Доходы", Объект.Доходы.Итог("СуммаНал")+Объект.Доходы.Итог("СуммаБезНал"));
	Рез.Вставить("ДокФП_ФП1", Объект.ФП1.Итог("СуммаНал")+Объект.ФП1.Итог("СуммаБезНал"));
	Рез.Вставить("ДокФП_ГС_Оборот", ГС_Оборот);
	возврат Рез;
КонецФункции


&НаКлиенте
Процедура ОбновитьСтатистикиФП1() Экспорт
	
	Если формаСтатистик = Неопределено ТОгда 
		Возврат;
	КонецЕсли;
	
	ДанныеХТМЛ_текст = ПолучитьТекстГрафиков_ФП1();
	РезСтраницаИмя = ИА_Статистики_Клиент.ПолучитьФайлСтраницы(ДанныеХТМЛ_текст,"FP1");		
	
	ДанныеХТМЛ = РезСтраницаИмя;
	НадоОбновить = ДанныеХТМЛ<>"";
	
	Если НадоОбновить Тогда
		Элементы.ПолеСтатистика.Документ.parentWindow.location.reload();
	КонецЕсли;
	
	//Элементы.ГруппаЛев.Видимость = Истина;
КонецПроцедуры

&НаКлиенте
Функция ПолучитьТекстГрафиков_ФП1()
	ФормаСтатистик.ТолькоЗавершПериоды = Ложь;
	
	ФормаСтатистик.Объект.Настройка = ПредопределенноеЗначение("Справочник.ИА_НастройкиРабочегоСтолаСтатистик.ФП1");     
	ФормаСтатистик.ДатаКонцаПредопределенная = Объект.Дата - 60*60*24;
	ФормаСтатистик.ЗагрузитьНастройку();
	//ФормаСтатистик.Объект.КоличествоВСтроке = 1;
	ФормаСтатистик.sw = sw1;
	
	// Подготовим данные
	ТекДанные = ПолучитьСтруктуруДанныхТекДок();
	//
	ТекстРез = ФормаСтатистик.СформироватьКартинку(истина, ложь, ложь, ложь, истина, ТекДанные);
	
	Возврат ТекстРез;
КонецФункции

