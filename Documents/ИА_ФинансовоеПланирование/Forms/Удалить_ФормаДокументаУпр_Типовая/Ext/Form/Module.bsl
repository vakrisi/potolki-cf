&НаСервере
Процедура ПересчитатьПолитику(имяПолитики,НижеРаздела = Неопределено, НижеФонда = Неопределено, Перезаполнять = истина, ФП1=ложь)
	Итоги = Новый ТаблицаЗначений;
	
	Постфикс = ?(ФП1, "ФП1","");

	КЧ = Новый КвалификаторыЧисла(15,2);
	Массив = Новый Массив;
	Массив.Добавить(Тип("Число"));
	ОписаниеТиповЧ = Новый ОписаниеТипов(Массив, , ,КЧ);

	Итоги.Колонки.Добавить("Раздел");
	Итоги.Колонки.Добавить("СуммаНал", ОписаниеТиповЧ);
	Итоги.Колонки.Добавить("СуммаБезнал", ОписаниеТиповЧ);
	НовИтог = Итоги.Добавить();
	НовИтог.Раздел = Справочники.ИА_РазделыПолитикиФП.ПустаяСсылка();
	
	Если имяПолитики = "ДеревоПолитика" Тогда
		НовИтог.СуммаНал = ?(ФП1,0,Объект.МаржинальнаяПрибыльНал);
		НовИтог.СуммаБезнал = Объект["МаржинальнаяПрибыльБезнал"+Постфикс];
	ИначеЕсли имяПолитики = "ДеревоПолитикаПервичная" Тогда
		НовИтог.СуммаНал = ?(ФП1,0,Объект.ПредварительнаяСуммаКРаспределениюНал1);
		НовИтог.СуммаБезнал = Объект["ПредварительнаяСуммаКРаспределениюБезнал1"+Постфикс];
	КонецЕсли;
	
	СтартРасчета = ложь; // для частичного расчета
	сч = 0;
	
	ДеревоПолитикаЗнач = РеквизитФормыВЗначение("ДеревоПолитика"+Постфикс);
	ДеревоПолитикаПервичнаяЗнач = РеквизитФормыВЗначение("ДеревоПолитикаПервичная"+Постфикс);
	
	ДеревоЗнач = Вычислить(имяПолитики+"Знач");
	
	Для каждого стрРаздел ИЗ ДеревоЗнач.Строки Цикл
		СуммаРазделНал = 0;
		СуммаРазделБезнал = 0;
		
		Для каждого стр из стрРаздел.Строки Цикл
			Если (НижеРаздела = Неопределено ИЛИ СтартРасчета) И Перезаполнять Тогда  // если не ограничивали или наступил момент начала расчета
				Если стр.РежимРасчета = Перечисления.ИА_РежимРасчетаСуммы.Процент Тогда
					итог = Итоги.Найти(стр.ПроцентОтИтогаРаздела, "Раздел");
					Если итог = Неопределено Тогда
						Сообщить("Политика заполнена неверно. Нельзя считать процент от более нижнего раздела! Расчет отменен!");
						Возврат;
					КонецЕсли;
					
					стр.СуммаНал = итог.СуммаНал * стр.Значение/100;
					стр.СуммаБезнал = итог.СуммаБезнал * стр.ЗначениеБезнал/100;
				ИначеЕсли стр.РежимРасчета = Перечисления.ИА_РежимРасчетаСуммы.ВычисляемоеВыражение Тогда
					Если не фп1 Тогда
						ПолучФормула = ИА_ФП.ВычислитьФормулу(ДеревоПолитикаПервичнаяЗнач, ДеревоПолитикаЗнач, Объект, стр.Значение, истина);
						стр.РасчетФормулыНал = ПолучФормула;
						стр.СуммаНал = Вычислить(ПолучФормула);
						Если не СохранятьРассчитаныеФормыПоБезнал Тогда
							НовстрСохр = РассчитанныеФормулы.Добавить();
							НовстрСохр.Формула = стр.Значение;
							НовстрСохр.ПредставлениеФормулы = ПолучФормула;
							НовстрСохр.Результат = стр.СуммаНал;
						КонецЕсли;
					КонецЕсли;
					
					ПолучФормула = ИА_ФП.ВычислитьФормулу(ДеревоПолитикаПервичнаяЗнач, ДеревоПолитикаЗнач, Объект, стр.ЗначениеБезнал, ложь,ФП1);
					стр.РасчетФормулы = ПолучФормула;
					стр.СуммаБезнал = Вычислить(ПолучФормула);					
					Если СохранятьРассчитаныеФормыПоБезнал Тогда
						НовстрСохр = РассчитанныеФормулы.Добавить();
						НовстрСохр.Формула = стр.ЗначениеБезнал;
						НовстрСохр.ПредставлениеФормулы = ПолучФормула;
						НовстрСохр.Результат = стр.СуммаБезнал;
					КонецЕсли;					
				ИначеЕсли стр.РежимРасчета = Перечисления.ИА_РежимРасчетаСуммы.ФиксированнаяСумма Тогда
					стр.СуммаНал = стр.Значение;
					стр.СуммаБезнал = стр.ЗначениеБезнал;
				КонецЕсли;				
			КонецЕсли;
			
			стр.СуммаНал = Окр(стр.СуммаНал,2);
			стр.СуммаБезнал = Окр(стр.СуммаБезнал,2); 
			
			стр.Итого = стр.СуммаНал + стр.СуммаБезнал;
			
			СуммаРазделНал = СуммаРазделНал + стр.СуммаНал;
			СуммаРазделБезнал = СуммаРазделБезнал + стр.СуммаБезнал;
			
			Если стрРаздел.Раздел = НижеРаздела и стр.Фонд = НижеФонда Тогда
				СтартРасчета = Истина;
			КонецЕсли;
			
		КонецЦикла;
		
		Если стрРаздел.Строки.Количество() > 0 Тогда // пропускаем СКД
			НовИтог = Итоги.Добавить();
			НовИтог.Раздел = стр.Раздел;
			НовИтог.СуммаНал = Итоги[сч].СуммаНал - СуммаРазделНал;
			НовИтог.СуммаБезнал = Итоги[сч].СуммаБезнал - СуммаРазделБезнал;
			
			//скд
			ДеревоЗнач.Строки[сч*2+1].СуммаНал = НовИтог.СуммаНал;
			ДеревоЗнач.Строки[сч*2+1].СуммаБезнал = НовИтог.СуммаБезнал;
			ДеревоЗнач.Строки[сч*2+1].Итого = НовИтог.СуммаБезнал + НовИтог.СуммаНал;
			ДеревоЗнач.Строки[сч*2+1].Раздел = "СКД:";
			//
			сч = сч + 1;
			
			стрРаздел.СуммаНал = СуммаРазделНал;
			стрРаздел.СуммаБезнал = СуммаРазделБезнал;
			стрРаздел.Итого =  СуммаРазделНал + СуммаРазделБезнал;
			
		КонецЕсли;
		
	КонецЦикла;
	ЗначениеВРеквизитФормы(ДеревоЗнач, имяПолитики+Постфикс);
	ОбновлениеОтображения();
КонецПроцедуры

&НаСервере
Процедура ПересчитатьСальдоСредствКРаспределению()
	
	ИтогСуммаНал = 0;
	ИтогСуммаБезнал = 0;
	
	Если ВыводитьГруппировкуПоСчетам Тогда
		ЭлементыСчета = ДеревоЗП.ПолучитьЭлементы();
		Для каждого ЭлементСчета Из  ЭлементыСчета Цикл 
			ПересчитатьСальдоСредствКРаспределениюПодразделения(ЭлементСчета, ИтогСуммаБезнал, ИтогСуммаНал);
		КонецЦикла;
	Иначе
		ПересчитатьСальдоСредствКРаспределениюПодразделения(ДеревоЗП, ИтогСуммаБезнал, ИтогСуммаНал);
	КонецЕсли;
	
	СальдоСредствКРаспределениюНалВрем = Объект.СуммаКРаспределениюСОстаткомНал - ИтогСуммаНал;
	СальдоСредствКРаспределениюБезналВрем = Объект.СуммаКРаспределениюСОстаткомБезнал - ИтогСуммаБезнал;
	
	Если Объект.СальдоСредствКРаспределениюНал <> СальдоСредствКРаспределениюНалВрем Тогда
		Объект.СальдоСредствКРаспределениюНал = СальдоСредствКРаспределениюНалВрем;
	КонецЕсли;
	
	Если Объект.СальдоСредствКРаспределениюБезнал <> СальдоСредствКРаспределениюБезналВрем Тогда
		Объект.СальдоСредствКРаспределениюБезнал = СальдоСредствКРаспределениюБезналВрем;
	КонецЕсли;
	
	Если Объект.СальдоСредствКРаспределениюНал < 0 Тогда
		Элементы.СальдоСредствКРаспределениюНал.ЦветФона = Новый Цвет(255,140,140);
	Иначе
		Элементы.СальдоСредствКРаспределениюНал.ЦветФона = Новый Цвет(255,255,255);
	КонецЕсли;
	
	Если Объект.СальдоСредствКРаспределениюБезнал < 0 Тогда
		Элементы.СальдоСредствКРаспределениюБезнал.ЦветФона = Новый Цвет(255,140,140);
	Иначе
		Элементы.СальдоСредствКРаспределениюБезнал.ЦветФона = Новый Цвет(255,255,255);
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ПересчитатьСальдоСредствКРаспределениюПодразделения(ЭлементДерева, ИтогСуммаБезнал, ИтогСуммаНал)
	
	ЭлементыПодразделения = ЭлементДерева.ПолучитьЭлементы();
	Для каждого ЭлементПодразделения из ЭлементыПодразделения цикл
		
		ЭлементыФонды = ЭлементПодразделения.ПолучитьЭлементы();
		Для каждого ЭлементФонды из ЭлементыФонды цикл
			ИтогСуммаНал = ИтогСуммаНал + ЭлементФонды.НачислениеВФондНал;
			ИтогСуммаБезнал = ИтогСуммаБезнал + ЭлементФонды.НачислениеВФондБезнал;	
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьОтчетПоСотояниюФондов(ВыходнаяТаблица = Неопределено)
	
	ДеревоЗПЗнач = РеквизитФормыВЗначение("ДеревоЗП");
	ДеревоПолитикаЗнач = РеквизитФормыВЗначение("ДеревоПолитика");
	ДеревоПолитикаПервичнаяЗнач = РеквизитФормыВЗначение("ДеревоПолитикаПервичная");
	
	РезЗапроса = ИА_Защита_ФП.ПолучитьРезультатЗапроса(Объект, ФППоОрганизациям, ДеревоЗПЗнач, ДеревоПолитикаЗнач, ДеревоПолитикаПервичнаяЗнач);
	
	Если ВыходнаяТаблица = Неопределено Тогда       
		
		ГС_Оборот = 0;
		
		Выборка = РезЗапроса.Выбрать();
		Если РазделятьНалБезнал Тогда
			Макет = ПолучитьОбщийМакет("СостояниеФондов");
		Иначе
			Макет = ПолучитьОбщийМакет("СостояниеФондовСвернуто");
		КонецЕсли;
		ТабДок = ПолеТабДок;
		ТабДок.Очистить();
		
		ОблШапка = Макет.ПолучитьОбласть("Шапка");
		
		Если ВыводитьГруппировкуПоСчетам Тогда
			ОблШапка.Параметры.СчетПодразделениеФонд = "Счет/Подразделение/Статья";
		Иначе	
			ОблШапка.Параметры.СчетПодразделениеФонд = "Подразделение/Статья";
		КонецЕсли;
		
		ТабДок.Вывести(ОблШапка);
		ТабДок.НачатьАвтогруппировкуСтрок();
		
		Если не РазделятьНалБезнал Тогда
			ТабДок.ФиксацияСверху = 2;
		Иначе
			ТабДок.ФиксацияСверху = 3;
		КонецЕсли;
		
		ВыводитьИтог =Ложь;
		ОстатокПоФондамНал = 0;
		ОстатокПоФондамБезНал = 0;
		
		Выборка.Следующий();
		
		Если Выборка.ТипЗаписи() = ТипЗаписиЗапроса.ОбщийИтог Тогда
			ВыводитьИтог = Истина;
			ОблСтрокаИтог = Макет.ПолучитьОбласть("СтрокаИтог");
			ОблСтрокаИтог.Параметры.Заполнить(Выборка);
			ОблСтрокаИтог.Параметры.Фонд = "Итог";
			ОстатокПоФондамНал = Выборка.ПослеФП_РезервНал + Выборка.ПослеФП_ОстатокНал;
			ОстатокПоФондамБезНал = Выборка.ПослеФП_РезервБезнал + Выборка.ПослеФП_ОстатокБезнал;
		КонецЕсли;
		
		Если ВыводитьГруппировкуПоСчетам Тогда
			Выборка.СледующийПоЗначениюПоля("Счет");
			Пока Выборка.СледующийПоЗначениюПоля("Счет") Цикл
				
				ОблСтрока = Макет.ПолучитьОбласть("СтрокаСчет");
				ОблСтрока.Параметры.Заполнить(Выборка);
				ОблСтрока.Параметры.Фонд = Выборка.Счет;
				ОблСтрока.Параметры.Фонд_Р = "" + Выборка.Счет;
				ТабДок.Вывести(ОблСтрока, 0);
				
				ОбновитьОтчетПоСоcтояниюФондовПодразделения(Выборка, Макет, ТабДок);
				
			КонецЦикла;
			
		Иначе
			
			ОбновитьОтчетПоСоcтояниюФондовПодразделения(Выборка, Макет, ТабДок);
			
		КонецЕсли;
		
		ТабДок.ЗакончитьАвтогруппировкуСтрок();
		Если ВыводитьИтог Тогда
			ТабДок.Вывести(ОблСтрокаИтог);
		КонецЕсли;
		
		// ОСТАТКИ ДС
		ОстаткиДС = ПолучитьОстатокДС();
		ОблСтрока = Макет.ПолучитьОбласть("Сравнение");
		Если (РазделятьНалБезнал и (ОстаткиДС.СуммаНал<> ОстатокПоФондамНал + Объект.СальдоСредствКРаспределениюНал или ОстаткиДС.СуммаБезНал<> ОстатокПоФондамБезНал + Объект.СальдоСредствКРаспределениюБезНал)) или (не РазделятьНалБезнал И ОстаткиДС.СуммаНал + ОстаткиДС.СуммаБезНал<> ОстатокПоФондамНал+ ОстатокПоФондамБезНал+ Объект.СальдоСредствКРаспределениюНал+ Объект.СальдоСредствКРаспределениюБезНал) Тогда
			ОблСтрока = Макет.ПолучитьОбласть("СравнениеКрасное");
		КонецЕсли;
		
		ОблСтрока.Параметры.СуммаФондов = ОстатокПоФондамНал + ОстатокПоФондамБезНал +  Объект.СальдоСредствКРаспределениюНал +  Объект.СальдоСредствКРаспределениюБезНал;
		ОблСтрока.Параметры.СуммаДС = ОстаткиДС.СуммаНал + ОстаткиДС.СуммаБезНал;
		
		ТабДок.Вывести(ОблСтрока);
		
		
		// ЗАЙМЫ
		ДеревоЗаймов = ПолучитьДеревоЗаймов(Объект.Дата, Объект.Организация, Объект.РаспределениеПоФондам.Выгрузить(),ФППоОрганизациям);
		Если ДеревоЗаймов.Строки.Количество() > 0 Тогда
			ОблСтрока = Макет.ПолучитьОбласть("ШапкаЗаймы");
			ТабДок.Вывести(ОблСтрока);
			ТабДок.НачатьАвтогруппировкуСтрок();  
			Для каждого стрПодр из ДеревоЗаймов.Строки Цикл
				ОблСтрока = Макет.ПолучитьОбласть("СтрокаЗаймы");
				ЗаполнитьЗначенияСвойств(ОблСтрока.Параметры, стрПодр);
				ОблСтрока.Параметры.Фонд = стрПодр.Подразделение;
				ТабДок.Вывести(ОблСтрока,0);
				
				Для каждого стрФонд из стрПодр.Строки Цикл
					ОблСтрока = Макет.ПолучитьОбласть("СтрокаЗаймы");
					ЗаполнитьЗначенияСвойств(ОблСтрока.Параметры, стрФонд);
					ОблСтрока.Параметры.Фонд = "  " + стрФонд.Фонд;
					ТабДок.Вывести(ОблСтрока,1);
					
					Для каждого стрПричина из стрФонд.Строки Цикл
						ОблСтрока = Макет.ПолучитьОбласть("СтрокаЗаймыПричина");
						ЗаполнитьЗначенияСвойств(ОблСтрока.Параметры, стрПричина);
						ОблСтрока.Параметры.Фонд = "  -" + стрПричина.ПричинаЗайма;
						ТабДок.Вывести(ОблСтрока,2);
					КонецЦикла;
				КонецЦикла;
				
			КонецЦикла;
			ТабДок.ЗакончитьАвтогруппировкуСтрок();
		КонецЕсли;
		
		ПолеТабДок1.Очистить();
		ПолеТабДок1.Вывести(ТабДок.ПолучитьОбласть());
		
	Иначе
		ВыхТаблицаЗнач = РезЗапроса.Выгрузить();
		ЗначениеВРеквизитФормы(ВыхТаблицаЗнач, "ВыходнаяТаблица");
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьОтчетПоСоcтояниюФондовПодразделения(Выборка, Макет, ТабДок)
	
	Выборка.СледующийПоЗначениюПоля("Подразделение");
	Пока Выборка.СледующийПоЗначениюПоля("Подразделение") Цикл
		
		ОблСтрока = Макет.ПолучитьОбласть("СтрокаПодразделение");
		
		Если не РазделятьНалБезнал Тогда
			Если Выборка.ПослеФП_Остаток < 0 Тогда
				ОблСтрока = Макет.ПолучитьОбласть("СтрокаКрасная");
			КонецЕсли;
		Иначе
			Если Выборка.ПослеФП_ОстатокНал < 0 ИЛИ Выборка.ПослеФП_ОстатокБезнал < 0 Тогда
				ОблСтрока = Макет.ПолучитьОбласть("СтрокаКрасная");
			КонецЕсли;
		КонецЕсли;
		
		ОблСтрока.Параметры.Заполнить(Выборка);
		ОблСтрока.Параметры.Фонд   = Выборка.Подразделение;
		
		Если ВыводитьГруппировкуПоСчетам Тогда
			ПараметрПозиционирования = "" + Выборка.Счет + "/" + Выборка.Подразделение;
		Иначе	
			ПараметрПозиционирования = "" + Выборка.Подразделение
		КонецЕсли;
		ОблСтрока.Параметры.Фонд_Р = ПараметрПозиционирования;
		
		ТабДок.Вывести(ОблСтрока, 1);
		
		Выборка.СледующийПоЗначениюПоля("Фонд");
		Пока Выборка.СледующийПоЗначениюПоля("Фонд") Цикл
			ОблСтрока = Макет.ПолучитьОбласть("СтрокаФонд");
			
			Если не РазделятьНалБезнал Тогда
				Если Выборка.ПослеФП_Остаток < 0 Тогда
					ОблСтрока = Макет.ПолучитьОбласть("СтрокаКрасная");
				КонецЕсли;
				
			Иначе
				Если Выборка.ПослеФП_ОстатокНал < 0 ИЛИ Выборка.ПослеФП_ОстатокБезнал < 0 Тогда
					ОблСтрока = Макет.ПолучитьОбласть("СтрокаКрасная");
				КонецЕсли;
			КонецЕсли;
			
			ОблСтрока.Параметры.Заполнить(Выборка);
			ОблСтрока.Параметры.Фонд = "- " + Выборка.Фонд;                
			Если ВыводитьГруппировкуПоСчетам Тогда
				ПараметрПозиционирования = "" + Выборка.Счет + "/" + Выборка.Подразделение + "/" + Выборка.Фонд;
			Иначе	
				ПараметрПозиционирования = "" + Выборка.Подразделение + "/" + Выборка.Фонд;
			КонецЕсли;
			
			ОблСтрока.Параметры.Фонд_Р = ПараметрПозиционирования; // Для позиционирования
			ТабДок.Вывести(ОблСтрока, 2);
			
			// подсчет движений по главному счету
			Если Выборка.счет = Справочники.ИА_Счета.ГлавныйСчет Тогда
				ГС_Оборот = ГС_Оборот + Выборка.ФП_Приход; // приход это оборот т.к. включает в себя и снятия
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьДеревоЗаймов(наДату, Организация, ТЗРаспредел,ФППоОрганизациям)
	Запрос = Новый Запрос;
	мен = Новый МенеджерВременныхТаблиц;
	Запрос.МенеджерВременныхТаблиц = мен;
	
	ТЗРаспредел.Свернуть("Фонд,Подразделение,СФонда,СПодразделения,ЗаймВозврат,ПричинаЗайма","СуммаНал,СуммаБезНал");
	Запрос.Текст = "ВЫБРАТЬ ТЗ.Фонд,ТЗ.Подразделение,ТЗ.СФонда,ТЗ.СПодразделения,ТЗ.ЗаймВозврат,ТЗ.ПричинаЗайма,ТЗ.СуммаНал,ТЗ.СуммаБезНал ПОМЕСТИТЬ ТЗ_Распредел ИЗ &ТЗ КАК ТЗ";
	Запрос.УстановитьПараметр("ТЗ", ТЗРаспредел);
	Запрос.Выполнить();
	
	Запрос.Текст = "ВЫБРАТЬ
	|	ЕСТЬNULL(ИА_ЗаймыСФондовОстатки.Подразделение, Займы.Подразделение) КАК Подразделение,
	|	ЕСТЬNULL(ИА_ЗаймыСФондовОстатки.Фонд, Займы.Фонд) КАК Фонд,
	|	ЕСТЬNULL(ИА_ЗаймыСФондовОстатки.ПричинаЗайма, Займы.ПричинаЗайма) КАК ПричинаЗайма,
	|	ЕСТЬNULL(ИА_ЗаймыСФондовОстатки.СуммаНалОстаток, 0) КАК ДоФП_Нал,
	|	ЕСТЬNULL(ИА_ЗаймыСФондовОстатки.СуммаБезналОстаток, 0) КАК ДоФП_Безнал,
	|	ЕСТЬNULL(Займы.СуммаНал, 0) - ЕСТЬNULL(Возвраты.СуммаНал, 0) КАК ФП_Нал,
	|	ЕСТЬNULL(Займы.СуммаБезнал, 0) - ЕСТЬNULL(Возвраты.СуммаБезнал, 0) КАК ФП_Безнал,
	|	ЕСТЬNULL(ИА_ЗаймыСФондовОстатки.СуммаНалОстаток, 0) + ЕСТЬNULL(Займы.СуммаНал, 0) - ЕСТЬNULL(Возвраты.СуммаНал, 0) КАК ПослеФП_Нал,
	|	ЕСТЬNULL(ИА_ЗаймыСФондовОстатки.СуммаБезналОстаток, 0) + ЕСТЬNULL(Займы.СуммаБезнал, 0) - ЕСТЬNULL(Возвраты.СуммаБезнал, 0) КАК ПослеФП_Безнал
	|ИЗ
	|	РегистрНакопления.ИА_ЗаймыСФондов.Остатки(
	|			&НаДату,
	|			Организация = &Организация
	|				ИЛИ &НеОграничивать) КАК ИА_ЗаймыСФондовОстатки
	|		ПОЛНОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			ТЗ_Распредел.СФонда КАК Фонд,
	|			ТЗ_Распредел.СПодразделения КАК Подразделение,
	|			ТЗ_Распредел.ПричинаЗайма КАК ПричинаЗайма,
	|			СУММА(ТЗ_Распредел.СуммаНал) КАК СуммаНал,
	|			СУММА(ТЗ_Распредел.СуммаБезнал) КАК СуммаБезнал
	|		ИЗ
	|			ТЗ_Распредел КАК ТЗ_Распредел
	|		ГДЕ
	|			ТЗ_Распредел.ЗаймВозврат = ЗНАЧЕНИЕ(Перечисление.ИА_ЗаймВозврат.Займ)
	|		
	|		СГРУППИРОВАТЬ ПО
	|			ТЗ_Распредел.СФонда,
	|			ТЗ_Распредел.СПодразделения,
	|			ТЗ_Распредел.ПричинаЗайма) КАК Займы
	|		ПО ИА_ЗаймыСФондовОстатки.Фонд = Займы.Фонд
	|			И ИА_ЗаймыСФондовОстатки.Подразделение = Займы.Подразделение
	|			И ИА_ЗаймыСФондовОстатки.ПричинаЗайма = Займы.ПричинаЗайма
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			ТЗ_Распредел.Фонд КАК Фонд,
	|			ТЗ_Распредел.Подразделение КАК Подразделение,
	|			ТЗ_Распредел.ПричинаЗайма КАК ПричинаЗайма,
	|			СУММА(ТЗ_Распредел.СуммаНал) КАК СуммаНал,
	|			СУММА(ТЗ_Распредел.СуммаБезнал) КАК СуммаБезнал
	|		ИЗ
	|			ТЗ_Распредел КАК ТЗ_Распредел
	|		ГДЕ
	|			ТЗ_Распредел.ЗаймВозврат = ЗНАЧЕНИЕ(Перечисление.ИА_ЗаймВозврат.Возврат)
	|		
	|		СГРУППИРОВАТЬ ПО
	|			ТЗ_Распредел.Фонд,
	|			ТЗ_Распредел.Подразделение,
	|			ТЗ_Распредел.ПричинаЗайма) КАК Возвраты
	|		ПО ИА_ЗаймыСФондовОстатки.Фонд = Возвраты.Фонд
	|			И ИА_ЗаймыСФондовОстатки.Подразделение = Возвраты.Подразделение
	|			И ИА_ЗаймыСФондовОстатки.ПричинаЗайма = Возвраты.ПричинаЗайма
	|ИТОГИ
	|	СУММА(ДоФП_Нал),
	|	СУММА(ДоФП_Безнал),
	|	СУММА(ФП_Нал),
	|	СУММА(ФП_Безнал),
	|	СУММА(ПослеФП_Нал),
	|	СУММА(ПослеФП_Безнал)
	|ПО
	|	Подразделение,
	|	Фонд,
	|	ПричинаЗайма";
	Запрос.УстановитьПараметр("НаДату", наДату);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("НеОграничивать", не ФППоОрганизациям);
	
	Возврат Запрос.Выполнить().Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам);
КонецФункции

&НаСервере
Функция ПолучитьОстатокДС()
	
	МассивОрганизаций = МассивОрганизацийФП();
	Запрос= Новый Запрос;
	Запрос.УстановитьПараметр("НаДату", Объект.Дата+1);
	
	Рез = Новый Структура("СуммаНал, СуммаБезнал",0,0);
	
	//Арчил Тваладзе 21.04.2016
	//настроки заполнения реквизитов, заполняются в зависимости от базовой конфигурации, в Настройки
	СтруктураНастройкиРеквизитов = ИА_ФП_ПовторИсп.ПолучитьЗначениеКонстанты_ФП_НастройкиРеквизитов(); 
	
	Если СтруктураНастройкиРеквизитов.Свойство("ТипРегистраДенежныеСредства") Тогда
		ТипРегистраДенежныеСредства = СтруктураНастройкиРеквизитов.ТипРегистраДенежныеСредства;
	Иначе
		ИА_КСУОбщийКлиентСервер.СообщитьПользователю("Заполните настройки реквизитов ФП!");
		Возврат Рез;
	КонецЕсли;
	
	Если ТипРегистраДенежныеСредства = "РегистрНакопления"  Тогда
		
		СтруктураРегистраДенежныеСредства   = СтруктураНастройкиРеквизитов.СтруктураРегистраДенежныеСредства;
		КоличествоРегистровДенежныеСредства = СтруктураРегистраДенежныеСредства.КоличествоРегистровДенежныеСредства;
		
		Если КоличествоРегистровДенежныеСредства = 2 Тогда
			ИмяРегистраНаличные               = СтруктураРегистраДенежныеСредства.ИмяРегистраДенежныеСредстваНаличные;
			ИмяРегистраБезНаличные            = СтруктураРегистраДенежныеСредства.ИмяРегистраДенежныеСредстваБезНаличные;
			ИмяРесурсаСуммаУпрНаличные        = СтруктураРегистраДенежныеСредства.ИмяРесурсаСуммаУпрНаличные;
			ИмяРесурсаСуммаУпрБезНаличные     = СтруктураРегистраДенежныеСредства.ИмяРесурсаСуммаУпрБезНаличные;
		иначе 
			
			ИмяРегистраНаличные               = СтруктураРегистраДенежныеСредства.ИмяРегистраДенежныеСредства;
			ИмяРегистраБезНаличные            = СтруктураРегистраДенежныеСредства.ИмяРегистраДенежныеСредства;
			ИмяИзмеренияТипДенежныхСредств    = СтруктураРегистраДенежныеСредства.ИмяИзмеренияТипДенежныхСредств;
			ИмяПеречисленияТипДенежныхСредств = СтруктураРегистраДенежныеСредства.ИмяПеречисленияТипДенежныхСредств;
			ИмяРесурсаСуммаУпрНаличные        = СтруктураРегистраДенежныеСредства.ИмяРесурсаСуммаУпр;
			ИмяРесурсаСуммаУпрБезНаличные     = СтруктураРегистраДенежныеСредства.ИмяРесурсаСуммаУпр;
			
		КонецЕсли;
		
		Если КоличествоРегистровДенежныеСредства = 1 Тогда
			
			ФильтрПоТипуДенежныхСредств = "" + ИмяИзмеренияТипДенежныхСредств+" = Значение(Перечисление."+ИмяПеречисленияТипДенежныхСредств+".%ШаблонТипаДС%)";
			Если ФППоОрганизациям Тогда
				ФильтрПоОрганизации = ?(ФППоОрганизациям, " И Организация В (&Организация)","");
			КонецЕсли;
			
		иначе
			
			ФильтрПоТипуДенежныхСредств = "";
			Если ФППоОрганизациям Тогда
				ФильтрПоОрганизации = ?(ФППоОрганизациям, "Организация В (&Организация)","");
			КонецЕсли;
			
		КонецЕсли;
		
		ШаблонТекстаЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДенежныеСредстваОстатки.%ШаблонИмяРесурсаСуммаУпр%Остаток
		|ИЗ
		|	РегистрНакопления.%ШаблонИмяРегистра%.Остатки(&НаДату, "+ФильтрПоТипуДенежныхСредств + ФильтрПоОрганизации + ") КАК ДенежныеСредстваОстатки";
		
		// наличные
		ТекстЗапроса = СтрЗаменить(ШаблонТекстаЗапроса, "%ШаблонИмяРесурсаСуммаУпр%", ИмяРесурсаСуммаУпрНаличные);
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса,        "%ШаблонИмяРегистра%",        ИмяРегистраНаличные);
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса,        "%ШаблонТипаДС%",             "Наличные");
		Запрос.Текст =ТекстЗапроса;
		
		Если ФППоОрганизациям Тогда
			Запрос.УстановитьПараметр("Организация", МассивОрганизаций);
		КонецЕсли;
		
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
