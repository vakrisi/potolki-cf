&НаКлиенте
Процедура ДоходыФП1ПослеУдаления(Элемент)
	ИтогиФП1();
КонецПроцедуры


&НаКлиенте
Процедура ЗаполнитьСреднееФП1(Команда)
	ДатаНачалаФп1 = ОБъект.Дата - 60*60*24 * 7 * 12;
	ДатаКонцаФп1 = ОБъект.Дата;
	
	Если (не ВвестиЗначение(ДатаНачалаФп1, "Период с")) ИЛИ (не ВвестиЗначение(ДатаКонцаФп1, "Период по")) Тогда
		возврат;
	КонецЕсли;
	ОбновитьСреднееФП1(ДатаНачалаФп1, ДатаКонцаФп1);	
	ИтогиФП1();
КонецПроцедуры

&НаСервере
Процедура ОбновитьСреднееФП1(ДатаНачалаФп1, ДатаКонцаФп1)
	
	КолДней = (НачалоДня(ДатаКонцаФп1) - НачалоДня(ДатаНачалаФп1))/ (24*60*60) + 1;
	Коэф = 7 / КолДней;

	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	СУММА(ФП.СуммаБезнал + ФП.СуммаНал)*&Коэф КАК СуммаБезнал,
	               |	ФП.Подразделение,
	               |	ФП.Фонд
	               |ИЗ
	               |	Документ.ИА_ФинансовоеПланирование.НачисленияВФонды КАК ФП
	               |ГДЕ
	               |	ФП.Ссылка.Дата МЕЖДУ &ДатаНачала И &ДатаКонца
	               |	И ФП.Ссылка.Проведен
	               |	И (ФП.Ссылка.Организация = &Организация
	               |			ИЛИ &Организация = НЕОПРЕДЕЛЕНО)
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ФП.Подразделение,
	               |	ФП.Фонд";
	Запрос.УстановитьПараметр("Организация", ?(ФППоОрганизациям, Объект.Организация, Неопределено));
	Запрос.УстановитьПараметр("ДатаНачала", ДатаНачалаФп1);
	Запрос.УстановитьПараметр("ДатаКонца", ДатаКонцаФп1);
	Запрос.УстановитьПараметр("Коэф", Коэф);

	тз = Запрос.Выполнить().Выгрузить();
	Объект.ФП1.Загрузить(тз);
	
КонецПроцедуры
