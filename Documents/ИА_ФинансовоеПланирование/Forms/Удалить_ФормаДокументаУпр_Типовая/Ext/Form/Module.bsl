&НаКлиенте
Процедура ВывестиРасшифровкуДохода(ВидДохода, нал = ложь)
	ТабДокРасшифровка = СуммаОткрытиеНаСервере(ВидДохода, нал);
	ТабДокРасшифровка.ОтображатьСетку = Ложь;
	ТабДокРасшифровка.ОтображатьЗаголовки = Ложь;
	ТабДокРасшифровка.ТолькоПросмотр = Истина;
	ТабДокРасшифровка.Показать();
КонецПроцедуры

&НаСервере
Функция СуммаОткрытиеНаСервере(ВидДохода, нал = ложь)
	Отб = Новый Структура("ВидДохода", ВидДохода);
	РезСтроки = Объект.Доходы_Детализация.НайтиСтроки(Отб);
	
	ТабДокРасшифровка = Новый ТабличныйДокумент;
	
	Макет = Документы.ИА_ФинансовоеПланирование.ПолучитьМакет("РасшифровкаВидаДоходов"); 
	
	ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
	ОбластьСтрока = Макет.ПолучитьОбласть("Строка");
	ОбластьИтог = Макет.ПолучитьОбласть("Итог");
	
	ОбластьШапка.Параметры.Заголовок = "Расшифровка по виду дохода " + ВидДохода.Наименование;
	ТабДокРасшифровка.Вывести(ОбластьШапка);
	
	СуммаИтог = 0;
	Для Каждого ТекСтрока Из РезСтроки Цикл
		ОбластьСтрока.Параметры.Заполнить(ТекСтрока);
		
		////Контекст = Новый Структура("Контрагент, Ответственный");
		////ЗаполнитьЗначенияСвойств(Контекст, ТекСтрока.Документ);
		////ОбластьСтрока.Параметры.Заполнить(Контекст);
		
		ТекСумма = ?(нал,ТекСтрока.СуммаНал,ТекСтрока.Сумма);
		Если ТекСумма = 0 Тогда 
			Продолжить;
		КонецЕсли;
		
		ОбластьСтрока.Параметры.Сумма = ТекСумма;
		ОбластьСтрока.Область(1,1,1,1).Расшифровка = ТекСтрока.Документ;
		ТабДокРасшифровка.Вывести(ОбластьСтрока);
		
		СуммаИтог = СуммаИтог + ТекСумма; 
	КонецЦикла;
	
	ОбластьИтог.Параметры.Сумма = СуммаИтог;
	
	ТабДокРасшифровка.Вывести(ОбластьИтог);
	
	Возврат ТабДокРасшифровка;
КонецФункции

