	ДеревоПолитикаЗнач = Запрос.Выполнить().Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам);
	//Добавление СКД
	колСтрок = ДеревоПолитикаЗнач.Строки.Количество();
