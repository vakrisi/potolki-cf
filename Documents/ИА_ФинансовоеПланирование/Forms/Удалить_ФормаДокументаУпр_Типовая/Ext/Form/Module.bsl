Функция ЕстьУтвержденныйПлан(пНеделя, пТекСсылка)
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ИА_УтвержденныйПланПродаж.Регистратор
	|ИЗ
	|	РегистрСведений.ИА_УтвержденныйПланПродаж КАК ИА_УтвержденныйПланПродаж
	|ГДЕ
	|	ИА_УтвержденныйПланПродаж.Период = &Период
	|	И ИА_УтвержденныйПланПродаж.Регистратор <> &Регистратор";
	Запрос.УстановитьПараметр("Период",пНеделя); 
	Запрос.УстановитьПараметр("Регистратор",пТекСсылка);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() тогда
		Возврат Выборка.Регистратор;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
КонецФункции


