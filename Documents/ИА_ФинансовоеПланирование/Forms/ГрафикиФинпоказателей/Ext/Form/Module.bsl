
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ПолеСтатистик = Параметры.ТекстХтмл;
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьИзменениеРазмераОкна()		
	предРазмер = sw;
	ОпределитьРазрешениеЭкрана();
	
	РазницаМеждуСтарымИНовымРазмером = предРазмер - sw;
	Если Абс(РазницаМеждуСтарымИНовымРазмером) < 20 Тогда
		Возврат;
	КонецЕсли;
	
	ВладелецФормы.swВнешняя = sw;
	ВладелецФормы.ОбновитьСтатистикиФП_Статистики();
	ПолеСтатистик = ВладелецФормы.ДанныеХТМЛ_Статистики;
	
	Если ПолеСтатистик<>"" Тогда
		
		Попытка
			Элементы.ПолеСтатистик.Документ.location.reload();
		Исключение
			Попытка
				Элементы.ПолеСтатистик.Документ.parentWindow.location.reload();
			Исключение
				Элементы.ПолеСтатистик.Документ.window.location.reload();
			КонецПопытки;
		КонецПопытки;
		
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОпределитьРазрешениеЭкрана()	
	sw = Элементы.ПолеСтатистик.Документ.body.clientWidth;		
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ОпределитьРазрешениеЭкрана();
	ПодключитьОбработчикОжидания("ПроверитьИзменениеРазмераОкна", 1, ложь);	
КонецПроцедуры

&НаКлиенте
Функция Абс(ч)
	Возврат МАКС(ч, -ч);
КонецФункции
