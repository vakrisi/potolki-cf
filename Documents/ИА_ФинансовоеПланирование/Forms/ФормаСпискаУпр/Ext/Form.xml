				<Field>Список.ТБ</Field>
				<Field>Список.ТочкаБезубыточности</Field>
			</UseAlways>
			<Settings xsi:type="DynamicList">
				<ManualQuery>true</ManualQuery>
				<DynamicDataRead>false</DynamicDataRead>
				<QueryText>ВЫБРАТЬ
	ДокументИА_ФинансовоеПланирование.Ссылка КАК Ссылка,
	ДокументИА_ФинансовоеПланирование.ПометкаУдаления КАК ПометкаУдаления,
	ДокументИА_ФинансовоеПланирование.Номер КАК Номер,
	ДокументИА_ФинансовоеПланирование.Дата КАК Дата,
	ДокументИА_ФинансовоеПланирование.Проведен КАК Проведен,
	ДокументИА_ФинансовоеПланирование.Организация КАК Организация,
	ДокументИА_ФинансовоеПланирование.МесяцТБ КАК МесяцТБ,
	ДокументИА_ФинансовоеПланирование.Ответственный КАК Ответственный,
	ДокументИА_ФинансовоеПланирование.НомерВеб КАК НомерВеб,
	ВЫБОР
		КОГДА ДокументИА_ФинансовоеПланирование.Проведен
			ТОГДА ДокументИА_ФинансовоеПланирование.МаржинальнаяПрибыль
		ИНАЧЕ 0
	КОНЕЦ КАК МаржинальнаяПрибыль,
	ДокументИА_ФинансовоеПланирование.Проведен КАК КартинкаСтатус,
	ДокументИА_ФинансовоеПланирование.НеделяТБ КАК НачалоНедели,
	ИА_РаспределениеНедель.КонецНедели КАК КонецНедели,
	"                                                   " КАК ГраницыНедели,
	ВЫБОР
		КОГДА ИА_РаспределениеНедель.КонецНедели ЕСТЬ NULL
			ТОГДА 0
		ИНАЧЕ РАЗНОСТЬДАТ(ДокументИА_ФинансовоеПланирование.НеделяТБ, ИА_РаспределениеНедель.КонецНедели, ДЕНЬ) + 1
	КОНЕЦ КАК КолДней,
	ВЫБОР
		КОГДА ДокументИА_ФинансовоеПланирование.Проведен
			ТОГДА ДокументИА_ФинансовоеПланирование.ИтогоЧистыйДоход
		ИНАЧЕ 0
	КОНЕЦ КАК ИтогоДоход,
	ЕСТЬNULL(ЗапросЗаказы.КоличествоЗаказов, 0) КАК Заказы,
	НомераНедель.НомерНедели КАК НомерНедели,
	НомераНедель.НомерНедели - 1 КАК НомерНедели1,
	ДокументИА_ФинансовоеПланирование.ТБ КАК ТБ,
	ДокументИА_ФинансовоеПланирование.ТБ.Номер КАК НомерТБ,
	ДокументИА_ФинансовоеПланирование.ТБ.Дата КАК ДатаТБ,
	"                                 " КАК ТочкаБезубыточности,
	ВЫБОР
		КОГДА ДокументИА_ФинансовоеПланирование.Проведен
			ТОГДА "Утвержден"
		ИНАЧЕ "Черновик"
	КОНЕЦ КАК Статус,
	ВЫБОР
		КОГДА ДокументИА_ФинансовоеПланирование.Проведен
			ТОГДА ЕСТЬNULL(КСУ_ПланФактМаржинальнойПрибылиОбороты.СуммаПриход, 0) ИНАЧЕ 0
	КОНЕЦ КАК МаржаПлан,
	ВЫБОР
		КОГДА ДокументИА_ФинансовоеПланирование.Проведен
			ТОГДА ДокументИА_ФинансовоеПланирование.ПланЧистогоДоходаТекНедели ИНАЧЕ 0
	КОНЕЦ КАК ДоходПлан
ИЗ
	Документ.ИА_ФинансовоеПланирование КАК ДокументИА_ФинансовоеПланирование
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИА_РаспределениеНедель КАК ИА_РаспределениеНедель
		ПО ДокументИА_ФинансовоеПланирование.НеделяТБ = ИА_РаспределениеНедель.Период
		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			ЗапросЗаказы.Ссылка КАК Ссылка,
			СУММА(1) КАК КоличествоЗаказов
		ИЗ
			Документ.ИА_ФинансовоеПланирование.ЗаказыНаПриобретение КАК ЗапросЗаказы
		
		СГРУППИРОВАТЬ ПО
			ЗапросЗаказы.Ссылка) КАК ЗапросЗаказы
		ПО ДокументИА_ФинансовоеПланирование.Ссылка = ЗапросЗаказы.Ссылка
		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			ИА_РаспределениеНедель.Период КАК Период,
			КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ИА_РаспределениеНедель1.Период) КАК НомерНедели
		ИЗ
			РегистрСведений.ИА_РаспределениеНедель КАК ИА_РаспределениеНедель
				ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИА_РаспределениеНедель КАК ИА_РаспределениеНедель1
				ПО ИА_РаспределениеНедель.Месяц = ИА_РаспределениеНедель1.Месяц
					И ИА_РаспределениеНедель.Период &gt;= ИА_РаспределениеНедель1.Период
		
		СГРУППИРОВАТЬ ПО
			ИА_РаспределениеНедель.Период) КАК НомераНедель
		ПО (НомераНедель.Период = ДокументИА_ФинансовоеПланирование.НеделяТБ)
		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			МАКСИМУМ(ИА_ФП_Настройка.Ссылка) КАК Ссылка,
			ИА_ФП_Настройка.Организация КАК Организация,
			ИА_ФП_Настройка.Месяц КАК Месяц
		ИЗ
			Документ.ИА_ФП_Настройка КАК ИА_ФП_Настройка
		ГДЕ
			ИА_ФП_Настройка.Проведен
			И ИА_ФП_Настройка.Месяц &lt;&gt; ДАТАВРЕМЯ(1, 1, 1)
		
		СГРУППИРОВАТЬ ПО
			ИА_ФП_Настройка.Организация,
			ИА_ФП_Настройка.Месяц) КАК НастройкиФП
		ПО (НастройкиФП.Организация = ДокументИА_ФинансовоеПланирование.Организация)
			И (НастройкиФП.Месяц = ДокументИА_ФинансовоеПланирование.МесяцТБ)
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.КСУ_ПланФактМаржинальнойПрибыли.Обороты КАК КСУ_ПланФактМаржинальнойПрибылиОбороты
		ПО ДокументИА_ФинансовоеПланирование.Организация = КСУ_ПланФактМаржинальнойПрибылиОбороты.Организация
			И ДокументИА_ФинансовоеПланирование.НеделяТБ = КСУ_ПланФактМаржинальнойПрибылиОбороты.Неделя
ГДЕ
	(ДокументИА_ФинансовоеПланирование.ПометкаУдаления = ЛОЖЬ
			ИЛИ &amp;ПоказатьПомеченные = ИСТИНА)</QueryText>
