				<Field>Список.ДатаТБ</Field>
				<Field>Список.КартинкаСтатус</Field>
				<Field>Список.КолДней</Field>
				<Field>Список.КонецНедели</Field>
				<Field>Список.МесяцТБ</Field>
				<Field>Список.НачалоНедели</Field>
