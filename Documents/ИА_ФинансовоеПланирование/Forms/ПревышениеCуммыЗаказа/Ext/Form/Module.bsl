
&НаКлиенте
Процедура УвеличитьСуммуЗаказа(Команда)
	Закрыть(Истина);
КонецПроцедуры

&НаКлиенте
Процедура УменьшитьСуммуОдобренныхСредств(Команда)
	Закрыть(Ложь);
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Параметры.Свойство("Заказ", заказ);
	Параметры.Свойство("Одобрено", Одобрено);
	СуммаЗаказа = заказ.сумма;
	Разница = Одобрено - СуммаЗаказа;
	
	Элементы.ДекорацияЗаказ.Заголовок = "Заказ № " + ИА_ФПСервер.УбратьНули(заказ.Номер)+", " + врег(заказ.ПредметЗаказа);
	
	Элементы.ДекорацияОсновная.Заголовок = СтрЗаменить(Элементы.ДекорацияОсновная.Заголовок, "[СуммаЗаказа]", формат(СуммаЗаказа, "ЧДЦ=2"));
	Элементы.ДекорацияОсновная.Заголовок = СтрЗаменить(Элементы.ДекорацияОсновная.Заголовок, "[Разница]", формат(Разница, "ЧДЦ=2"));
	Элементы.ДекорацияОсновная.Заголовок = СтрЗаменить(Элементы.ДекорацияОсновная.Заголовок, "[Одобрено]", формат(Одобрено, "ЧДЦ=2"));
	
	Элементы.ДекорацияПодробно.Заголовок = СтрЗаменить(Элементы.ДекорацияПодробно.Заголовок, "[СуммаЗаказа]", формат(СуммаЗаказа, "ЧДЦ=2"));
	Элементы.ДекорацияПодробно.Заголовок = СтрЗаменить(Элементы.ДекорацияПодробно.Заголовок, "[Разница]", формат(Разница, "ЧДЦ=2"));
	Элементы.ДекорацияПодробно.Заголовок = СтрЗаменить(Элементы.ДекорацияПодробно.Заголовок, "[Одобрено]", формат(Одобрено, "ЧДЦ=2"));
КонецПроцедуры
