&НаСервере
Процедура ДобавитьВМатериалыРулонПоНомеру(Знач НомерРулона, Знач НаименованиеРулона)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СерииНоменклатуры.Владелец КАК Владелец,
	|	СерииНоменклатуры.Ссылка КАК Ссылка,
	|	СерииНоменклатуры.Владелец.БазоваяЕдиницаИзмерения КАК БазоваяЕдиницаИзмерения,
	|	СерииНоменклатуры.Владелец.АльтернативнаяЕдиницаИзмерения КАК АльтЕдИзм,
	|	ЕСТЬNULL(СерииНоменклатуры.Владелец.АльтернативнаяЕдиницаИзмерения.Коэффициент, 0) КАК КоэффициентАльтЕдИзм
	|ИЗ
	|	Справочник.СерииНоменклатуры КАК СерииНоменклатуры
	|ГДЕ
	|	НЕ СерииНоменклатуры.ПометкаУдаления
	|	И (
	|	СерииНоменклатуры.Наименование = &Наименование
	//#5951 ищем только по наименованию
	//|			ИЛИ &Номер > 0
	//|				И СерииНоменклатуры.НомерСерии = &Номер
	|	)
	|";
	//Запрос.УстановитьПараметр("Номер", НомерРулона);
	Запрос.УстановитьПараметр("Наименование", СокрЛП(НаименованиеРулона));
	
	Выборка = Запрос.Выполнить().Выбрать();
	КоличествоРулонов = Выборка.Количество();
	
	Пока Выборка.Следующий() Цикл
		
		НоваяСтрока = Объект.Материалы.Добавить();
		НоваяСтрока.Номенклатура = Выборка.Владелец;
		НоваяСтрока.СерияНоменклатуры = Выборка.Ссылка;
		НоваяСтрока.ЕдиницаИзмерения = Выборка.БазоваяЕдиницаИзмерения;
		НоваяСтрока.Коэффициент = 1;
		
		//проверим характеристики. если только одна - укажем ее тоже
		ЗапросХарактеристики = Новый Запрос;
		ЗапросХарактеристики.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ХарактеристикиНоменклатуры.Ссылка
		|ИЗ
		|	Справочник.ХарактеристикиНоменклатуры КАК ХарактеристикиНоменклатуры
		|ГДЕ
		|	ХарактеристикиНоменклатуры.Владелец = &Владелец
		|	И ХарактеристикиНоменклатуры.ПометкаУдаления = ЛОЖЬ";
		ЗапросХарактеристики.УстановитьПараметр("Владелец",Выборка.Владелец);
		ВыборкаХарактеристики = ЗапросХарактеристики.Выполнить().Выгрузить();
		Если ВыборкаХарактеристики.Количество() = 1 Тогда
			НоваяСтрока.ХарактеристикаНоменклатуры = ВыборкаХарактеристики[0].Ссылка;
		КонецЕсли;
		
		//Количество рулона по полотну из заказа на производство с учётом коэффициента
		Если КоличествоРулонов = 1 И Объект.Материалы.Количество() = 1
			И Объект.Основание <> Неопределено
			И НЕ Объект.Основание.Пустая() Тогда
			
			//Нужно в заказе на производство, найти полотно и если есть поставить количество первого			
			Для Каждого Материал Из Объект.Основание.Материалы Цикл
				Если Материал.Номенклатура.ВидНоменклатуры = Справочники.ВидыНоменклатуры.Полотно Тогда
					//количество будет рассчитано с учетом коэффициента
					КоэффициентАльтЕдИзм = ?(Выборка.КоэффициентАльтЕдИзм > 0, Выборка.КоэффициентАльтЕдИзм, 1);					
					Если Материал.Коэффициент = 1 Тогда
						РулонКоличество = Материал.Количество;
					Иначе						
						РулонКоличество = (Материал.Количество * ?(Материал.Коэффициент > 0, Материал.Коэффициент, 1))
										/ КоэффициентАльтЕдИзм;
					КонецЕсли;
					
					Если Выборка.АльтЕдИзм <> Неопределено И НЕ Выборка.АльтЕдИзм.Пустая() Тогда
						НоваяСтрока.ЕдиницаИзмерения = Выборка.АльтЕдИзм;					
					КонецЕсли;	
					НоваяСтрока.Коэффициент = КоэффициентАльтЕдИзм;					
					НоваяСтрока.Количество = РулонКоличество;
					НоваяСтрока.КоличествоКВыработке = Материал.КоличествоКВыработке;	
					Прервать;
				КонецЕсли;	
			КонецЦикла;	
					
		КонецЕсли;	
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаменитьРулонПоНомеру(Команда)
	
	Перем ВыбЗнач;
	
	ТекущиеДанные = Элементы.Материалы.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Сообщить("Необходимо выбрать позицию для замены рулона!");
		Возврат;
	Иначе	
		
		Массив = Новый Массив;
		//Массив.Добавить(Тип("Число"));
		//КЧ = Новый КвалификаторыЧисла(12);
		//ОписаниеТипов = Новый ОписаниеТипов(Массив, КЧ);
		Массив.Добавить(Тип("Строка"));
		КС = Новый КвалификаторыСтроки(150);
		ОписаниеТипов = Новый ОписаниеТипов(Массив, , КС);
		Оповещение = Новый ОписаниеОповещения("ПослеВводаНомераРулонаЗамена", ЭтаФорма);
		// #5951 в тексте заголовка "номер/наименование" заменено на "наименование"
		ТекстЗаголовкаОкнаВвода = "Введите наименование рулона (серии номенклатуры)" + Символы.ПС + "или отсканируйте его штрих-код";
		ПоказатьВводЗначения(Оповещение, ВыбЗнач, ТекстЗаголовкаОкнаВвода, ОписаниеТипов);

	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВводаНомераРулонаЗамена(НаименованиеРулона, ДопПараметры) Экспорт
	Если НаименованиеРулона<>Неопределено Тогда
		НомерРулона = 0;
		Попытка
			НомерРулона = Число(НаименованиеРулона);
		Исключение	
		КонецПопытки;
		
		ТекущиеДанные = Элементы.Материалы.ТекущиеДанные;
		Если ЗаменитьВМатериалыРулонПоНомеру(НомерРулона, НаименованиеРулона, ТекущиеДанные.Номенклатура, ТекущиеДанные.ХарактеристикаНоменклатуры, ТекущиеДанные.СерияНоменклатуры) Тогда
			МатериалыНоменклатураПриИзменении(Неопределено);
		КонецЕсли;
    КонецЕсли;
КонецПроцедуры

&НаСервере
Функция ЗаменитьВМатериалыРулонПоНомеру(Знач НомерРулона, НаименованиеРулона, ТекущиеДанныеНоменклатура, ТекущиеДанныеХарактеристикаНоменклатуры, ТекущиеДанныеСерияНоменклатуры)	
	
	Результат = Ложь;
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СерииНоменклатуры.Владелец КАК Владелец,
	|	СерииНоменклатуры.Ссылка КАК Ссылка,
	|	СерииНоменклатуры.Владелец.БазоваяЕдиницаИзмерения КАК БазоваяЕдиницаИзмерения,
	|	СерииНоменклатуры.Владелец.АльтернативнаяЕдиницаИзмерения КАК АльтЕдИзм,
	|	ЕСТЬNULL(СерииНоменклатуры.Владелец.АльтернативнаяЕдиницаИзмерения.Коэффициент, 0) КАК КоэффициентАльтЕдИзм
	|ИЗ
	|	Справочник.СерииНоменклатуры КАК СерииНоменклатуры
	|ГДЕ
	|	НЕ СерииНоменклатуры.ПометкаУдаления
	|	И (СерииНоменклатуры.Наименование = &Наименование
	//#5951 ищем только по наименованию
	//|			ИЛИ &Номер > 0
	//|				И СерииНоменклатуры.НомерСерии = &Номер
	|	)
	|";
	//Запрос.УстановитьПараметр("Номер", НомерРулона);
	Запрос.УстановитьПараметр("Наименование", СокрЛП(НаименованиеРулона));
	
	Выборка = Запрос.Выполнить().Выбрать();	
	
	Если Выборка.Следующий() Тогда
				
		ТекущиеДанныеНоменклатура = Выборка.Владелец;
		ТекущиеДанныеХарактеристикаНоменклатуры = Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка();
		ТекущиеДанныеСерияНоменклатуры = Выборка.Ссылка;
		
		//проверим характеристики. если только одна - укажем ее тоже
		ЗапросХарактеристики = Новый Запрос;
		ЗапросХарактеристики.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ХарактеристикиНоменклатуры.Ссылка
		|ИЗ
		|	Справочник.ХарактеристикиНоменклатуры КАК ХарактеристикиНоменклатуры
		|ГДЕ
		|	ХарактеристикиНоменклатуры.Владелец = &Владелец
		|	И ХарактеристикиНоменклатуры.ПометкаУдаления = ЛОЖЬ";
		ЗапросХарактеристики.УстановитьПараметр("Владелец",Выборка.Владелец);
		ВыборкаХарактеристики = ЗапросХарактеристики.Выполнить().Выгрузить();
		Если ВыборкаХарактеристики.Количество() = 1 Тогда
			ТекущиеДанныеХарактеристикаНоменклатуры = ВыборкаХарактеристики[0].Ссылка;
		КонецЕсли;
		
		Результат = Истина;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

&НаСервере
Процедура ДобавитьОстатокВМатериалы(ЗаменитьПолотна = Ложь, Знач ЭтоОстаток = Истина)
	
	ОбщийМодульСервер.ИзменитьПолотнаВМатериалах(Объект, ЗаменитьПолотна, ЭтоОстаток);
	Модифицированность = Истина; 
		
КонецПроцедуры

&НаКлиенте
Процедура СделаноИзОстатков(Команда)
	
	Если Объект.Материалы.Количество() > 0 Тогда
		ВремПарам = Новый Структура("ЭтоОстаток",Истина);
		ПоказатьВопрос(Новый ОписаниеОповещения("ПослеОтветаНаВопросОЗаменеПолотен",ЭтаФорма, ВремПарам) ,"Заменить полотна на ""Остаток""? При нажатии ""Нет"" будет добавлена строка.", РежимДиалогаВопрос.ДаНетОтмена);
	Иначе
		ДобавитьОстатокВМатериалы(Ложь, Истина);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеОтветаНаВопросОЗаменеПолотен(Результат, Параметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
        ДобавитьОстатокВМатериалы(Истина, Параметры.ЭтоОстаток);
		
	ИначеЕсли Результат = КодВозвратаДиалога.Нет Тогда
		ДобавитьОстатокВМатериалы(Ложь, Параметры.ЭтоОстаток);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СделаноИзМатериалаЗаказчика(Команда)
	Если Объект.Материалы.Количество() > 0 Тогда
		ВремПарам = Новый Структура("ЭтоОстаток",Ложь);
		ПоказатьВопрос(Новый ОписаниеОповещения("ПослеОтветаНаВопросОЗаменеПолотен",ЭтаФорма, ВремПарам) ,"Заменить полотна на ""Материал заказчика""? При нажатии ""Нет"" будет добавлена строка.", РежимДиалогаВопрос.ДаНетОтмена);
