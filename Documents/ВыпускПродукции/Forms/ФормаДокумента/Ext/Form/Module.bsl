&НаКлиенте
Процедура ЗаполнитьИсполнителейПоСмене(Команда)
	
	ОчиститьСообщения();
	
	//++ №6687 теперь способ определяется в документе
	//Если НЕ ИсполнителиПоОперациям() Тогда
	Если Объект.СпособНачисленияВыработки = ПредопределенноеЗначение("Перечисление.СпособыНачисленияВыработки.Бригадная") Тогда
	//-- №6687
		Если Объект.Исполнители.Количество() > 0 Тогда
			Если Вопрос("Очистить табличную часть исполнителей?",РежимДиалогаВопрос.ДаНет) = КодВозвратаДиалога.Да тогда
				Объект.Исполнители.Очистить();
			КонецЕсли;
		КонецЕсли;
	Иначе
		Если Объект.ИсполнителиПоОперациям.Количество() > 0 Тогда
			Если Вопрос("Очистить табличную часть исполнителей?",РежимДиалогаВопрос.ДаНет) = КодВозвратаДиалога.Да тогда
				Объект.ИсполнителиПоОперациям.Очистить();
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	ЗаполнитьИсполнителейПоСменеНаСервере();
	ОбновитьДанныеДокумента();
	
КонецПроцедуры

