КонецФункции

&НаКлиенте
Процедура ПодобратьНоменклатуруПродукция(Команда)
	
	Если НЕ Объект.ПродукцияНоменклатура.Пустая() Тогда
		Если Вопрос("Очистить введенные ранее данные?",РежимДиалогаВопрос.ДаНет) = КодВозвратаДиалога.Нет Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	ПодобратьНоменклатуруПродукцияНаСервере();
	Если Объект.ПродукцияНоменклатура.Пустая() Тогда
		Если Вопрос("Подходящая по фактуре номенклатура не найдена, создать новую?",РежимДиалогаВопрос.ДаНет) = КодВозвратаДиалога.Да Тогда
			Результат = СоздатьНоменклатуруПродукцияНаСервере();
			Состояние(Результат);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

