	// №6687 видимость ТЧ исполнителей по способу начисления
	Элементы.ГруппаИсполнителиПоОперациям.Видимость = (Объект.СпособНачисленияВыработки = Перечисления.СпособыНачисленияВыработки.ПроизводственныеОперации);
	Элементы.ГруппаИсполнители.Видимость = (Объект.СпособНачисленияВыработки = Перечисления.СпособыНачисленияВыработки.Бригадная);
	
	ОбновитьСписокФайлов();
	
	// №12997 заказ на производство и выпуск с видом "Производство уникальной продукции" и документ основание проведен
	Элементы.Потолок.ТолькоПросмотр = (ТипЗнч(Объект.Основание) = Тип("ДокументСсылка.ЗаказНаПроизводство")
		И ЗначениеЗаполнено(Объект.Основание)
		И Объект.Основание.Проведен
		И Объект.Основание.ВидЗаказа = Перечисления.ВидыЗаказовНаПроизводство.ПроизводствоПотолка
		И Объект.ВидЗаказа = Перечисления.ВидыЗаказовНаПроизводство.ПроизводствоПотолка
	);
	
КонецПроцедуры

