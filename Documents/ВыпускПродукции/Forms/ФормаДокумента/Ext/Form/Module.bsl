&НаКлиенте
Процедура ДобавитьРулонПоНомеру(Команда)
	
	Перем ВыбЗнач;
	Массив = Новый Массив;
	//Массив.Добавить(Тип("Число"));
	//КЧ = Новый КвалификаторыЧисла(15, 0, ДопустимыйЗнак.Неотрицательный);
	//ОписаниеТипов = Новый ОписаниеТипов(Массив, КЧ);
	Массив.Добавить(Тип("Строка"));
	КС = Новый КвалификаторыСтроки(150);
	ОписаниеТипов = Новый ОписаниеТипов(Массив, , КС);

	Оповещение = Новый ОписаниеОповещения("ПослеВводаНомераРулона", ЭтаФорма, Параметры);
