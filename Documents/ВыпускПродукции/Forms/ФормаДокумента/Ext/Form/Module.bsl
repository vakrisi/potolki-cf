			КВыработкеЗаказ = Объект.Основание.Услуги.Итог("КоличествоКВыработке");
			КВыработкеВыпуск = Объект.Услуги.Итог("КоличествоКВыработке");
			Если НЕ КВыработкеВыпуск = КВыработкеЗаказ Тогда
				Отказ = Истина;
			Иначе
				Для Каждого ТекущаяСтрока Из Объект.Услуги Цикл
					Если НЕ ТекущаяСтрока.КоличествоКВыработке = 0 Тогда
						Отбор = Новый Структура;
						Отбор.Вставить("Номенклатура", ТекущаяСтрока.Номенклатура);
						Отбор.Вставить("КоличествоКВыработке", ТекущаяСтрока.КоличествоКВыработке);
						НайденныеСтроки = Объект.Основание.Услуги.НайтиСтроки(Отбор);
						Если НайденныеСтроки.Количество() = 0 Тогда
							Отказ = Истина;
						КонецЕсли;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
			
			Если Отказ Тогда
				Сообщить("Состав и количество услуг с выработкой в выпуске продукции и в заказе на производство должны совпадать.");
				Возврат;
			КонецЕсли;
		КонецЕсли;
		
		
		Если ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
			Отказ = НЕ ПраваПользователей.РазрешеноПриходоватьНаСклад(Объект.СкладПродукции);
			Если Отказ Тогда
				Сообщить("У текущего пользователя нет прав для оформления прихода на склад """ + Объект.СкладПродукции + """");
				Возврат;
			КонецЕсли;
		КонецЕсли;
		Если ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
			Отказ = НЕ ПраваПользователей.РазрешеноРасходоватьСоСклада(Объект.СкладМатериалов);
			Если Отказ Тогда
				Сообщить("У текущего пользователя нет прав для оформления расхода по складу """ + Объект.СкладМатериалов + """");
				Возврат;
			КонецЕсли;
		КонецЕсли;
	    
	КонецЕсли;
	
КонецПроцедуры

