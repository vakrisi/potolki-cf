Процедура УслугиЕдиницаИзмеренияОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	СтрокаТабличнойЧасти = Элементы.Услуги.ТекущиеДанные;
	Если ТипЗнч(ВыбранноеЗначение) = Тип("СправочникСсылка.КлассификаторЕдиницИзмерения") Тогда
		СтрокаТабличнойЧасти.Коэффициент = 1;
	Иначе
		СтрокаТабличнойЧасти.Коэффициент = ОбщийМодуль.ПолучитьКоэффициентЕдиницыИзмерения(ВыбранноеЗначение);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьУслугиПоОснованию(Команда)
	
	ЗаполнитьУслугиПоОснованиюНаСервере();
	ПоказатьПредупреждение(,"Услуги перезаполнены");
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьУслугиПоОснованиюНаСервере()
	Если ТипЗнч(Объект.Основание) = Тип("ДокументСсылка.ЗаказНаПроизводство") Тогда
		Объект.Услуги.Очистить();
		Для Каждого СтрокаЗаказа Из Объект.Основание.Услуги Цикл
			СтрокаВыпуска = Объект.Услуги.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаВыпуска, СтрокаЗаказа);
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

