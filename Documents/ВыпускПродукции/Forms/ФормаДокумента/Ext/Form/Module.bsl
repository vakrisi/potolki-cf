&НаКлиенте
Процедура МатериалыПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	мНоменклатура = ПредопределенноеЗначение("Справочник.Номенклатура.ПустаяСсылка");
КонецПроцедуры

&НаКлиенте
Процедура МатериалыПередНачаломИзменения(Элемент, Отказ)
	
	ТекущиеДанные = Элементы.Материалы.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПредыдущийМатериал = ТекущиеДанные.Номенклатура;
	мНоменклатура = ТекущиеДанные.Номенклатура;
		
КонецПроцедуры

&НаКлиенте
Процедура МатериалыНоменклатураПриИзменении(Элемент)
	
	СтрокаТабличнойЧасти = Элементы.Материалы.ТекущиеДанные;
	СтрокаТабличнойЧасти.ЕдиницаИзмерения = ОбщийМодульВызовСервера.ПолучитьЕдиницуИзмеренияДляПроизводства(СтрокаТабличнойЧасти.Номенклатура);
	
	Если ЗначениеЗаполнено(мНоменклатура) И СтрокаТабличнойЧасти.Номенклатура = ПредопределенноеЗначение("Справочник.Номенклатура.ОстаткиПленки") Тогда
		//#14457
		СтрокаТабличнойЧасти.Количество = СтрокаТабличнойЧасти.Количество * СтрокаТабличнойЧасти.Коэффициент;
		СтрокаТабличнойЧасти.Коэффициент = 1;
	Иначе				
		Если ТипЗнч(СтрокаТабличнойЧасти.ЕдиницаИзмерения) = Тип("СправочникСсылка.КлассификаторЕдиницИзмерения") Тогда
			СтрокаТабличнойЧасти.Коэффициент = 1;
		ИначеЕсли ТипЗнч(СтрокаТабличнойЧасти.ЕдиницаИзмерения) = Тип("СправочникСсылка.ЕдиницыИзмерений") Тогда
			СтрокаТабличнойЧасти.Коэффициент = ОбщийМодульВызовСервера.ПолучитьКоэффициентЕдиницыИзмерения(СтрокаТабличнойЧасти.ЕдиницаИзмерения);
		КонецЕсли;
	КонецЕсли;
	
	//++ №8266 при изменении номенклатуры пленки, если ширина предыдущей и текущей разные, то очищаем колонку "Количество"
	ПроверитьШиринуПолотнаНоменклатурыИОчиститьКоличествоПриРазличии(СтрокаТабличнойЧасти.Количество, СтрокаТабличнойЧасти.Номенклатура, ПредыдущийМатериал);
	ПредыдущийМатериал = СтрокаТабличнойЧасти.Номенклатура;
	//-- №8266

КонецПроцедуры

&НаКлиенте
Процедура МатериалыЕдиницаИзмеренияПриИзменении(Элемент)
	СтрокаТабличнойЧасти = Элементы.Материалы.ТекущиеДанные;
	Если ТипЗнч(СтрокаТабличнойЧасти.ЕдиницаИзмерения) = Тип("СправочникСсылка.КлассификаторЕдиницИзмерения") Тогда
		СтрокаТабличнойЧасти.Коэффициент = 1;
	Иначе
		СтрокаТабличнойЧасти.Коэффициент = ОбщийМодуль.ПолучитьКоэффициентЕдиницыИзмерения(СтрокаТабличнойЧасти.ЕдиницаИзмерения);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура МатериалыЕдиницаИзмеренияНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	СтрокаТабличнойЧасти = Элементы.Материалы.ТекущиеДанные;
	СписокЕдиниц = ОбщийМодуль.ПолучитьСписокЕдиницИзмеренияНоменклатуры(СтрокаТабличнойЧасти.Номенклатура);
	
	ДанныеВыбора = Новый СписокЗначений;
	Для Ном = 0 По СписокЕдиниц.Количество() - 1 Цикл
		ДанныеВыбора.Добавить(СписокЕдиниц[Ном]);
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура МатериалыЕдиницаИзмеренияОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	СтрокаТабличнойЧасти = Элементы.Материалы.ТекущиеДанные;
	Если ТипЗнч(ВыбранноеЗначение) = Тип("СправочникСсылка.КлассификаторЕдиницИзмерения") Тогда
		СтрокаТабличнойЧасти.Коэффициент = 1;
	Иначе
		СтрокаТабличнойЧасти.Коэффициент = ОбщийМодуль.ПолучитьКоэффициентЕдиницыИзмерения(ВыбранноеЗначение);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура МатериалыПродукцияНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	
	ДанныеВыбора = Новый СписокЗначений;
	Для Каждого ТекущаяСтрока Из Объект.Продукция Цикл
		ДанныеВыбора.Добавить(ТекущаяСтрока.Номенклатура);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ПодобратьМатериалы(Команда)
	
	ПараметрРежимПодбора = 0;
	
	ПараметрыПодбора = Новый Структура;
	ПараметрыПодбора.Вставить("Дата",					Объект.Дата);
	ПараметрыПодбора.Вставить("Организация",			Объект.Организация);
	ПараметрыПодбора.Вставить("Склад",					Объект.СкладМатериалов);
	ПараметрыПодбора.Вставить("ВидНоменклатуры",		ПолучитьСписокВидовНоменклатурыТовары());
	ПараметрыПодбора.Вставить("НеЗапрашиватьЦену",		Истина);
	ОткрытьФорму("ОбщаяФорма.ФормаПодбораНоменклатуры", ПараметрыПодбора, ЭтаФорма, УникальныйИдентификатор);

КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбораПодборНаКлиенте(ВыбранноеЗначение)
	
	Если Не ЗначениеЗаполнено(ВыбранноеЗначение) Тогда
		Возврат;
	КонецЕсли;
			
	ОбработкаВыбораПодборНаСервере(ВыбранноеЗначение);
		
КонецПроцедуры

&НаСервере
Функция ОбработкаВыбораПодборНаСервере(ВыбранноеЗначение)
	
	ТаблицаТоваров = ПолучитьИзВременногоХранилища(ВыбранноеЗначение.АдресВХранилище);
	
	Для Каждого ТекущаяСтрока из ТаблицаТоваров Цикл
		НоваяСтрока = Объект.Материалы.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущаяСтрока);	
	КонецЦикла;
	
КонецФункции

&НаКлиенте
Процедура ЗаполнитьМатериалыПоЗаказуНаПроизводство(Команда)
	
	Если Объект.Материалы.Количество() > 0 Тогда
		ОП = новый ОписаниеОповещения("ПослеВопросаОбОчисткеТабличнойЧастиМатериалы", ЭтотОбъект);
		ПоказатьВопрос(ОП, "При продолжении табличная часть ""Материалы"" будет очищена, продолжить?", РежимДиалогаВопрос.ДаНет);
	Иначе
		ЗаполнитьМатериалыПоЗаказуНаПроизводствоНаСервере();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВопросаОбОчисткеТабличнойЧастиМатериалы(Ответ, ДопПараметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Да Тогда
		ЗаполнитьМатериалыПоЗаказуНаПроизводствоНаСервере();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьМатериалыПоЗаказуНаПроизводствоНаСервере()
	
	Объект.Материалы.Очистить();
	
	Для Каждого ТекущаяСтрока Из Объект.Основание.Материалы Цикл
		НоваяСтрока = Объект.Материалы.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущаяСтрока);
	КонецЦикла;
	
	Модифицированность = Истина;
	
КонецПроцедуры	

&НаКлиенте
Процедура ЗаполнитьМатериалыПоСпецификациям(Команда)
	
	ЗаполнитьМатериалыПоСпецификациямНаСервере(ПолучитьСписокПозицийДляПерезаполненияМатериаловПоСпецификации());
	//ОбновитьДанныеДокумента();
	
КонецПроцедуры

// Процедура - Заполнить материалы по спецификациям на сервере
//
// Параметры:
//  СписокПозиций	 - массив структур ("Номенклатура, ХарактеристикаНоменклатуры, ЕдиницаИзмерения, Количество, Коэффициент, Спецификация" 
//  ОчиститьТЧ		 - необходимость очистки  
//
&НаСервере
Процедура ЗаполнитьМатериалыПоСпецификациямНаСервере(МассивПозиций, ОчиститьТЧ = Истина)
	
	// #15041 - добавлено заполнение колонки "Продукция" (с версии 3.0.9)

	Если ОчиститьТЧ Тогда
		Объект.Материалы.Очистить();
	КонецЕсли;
	
	ВременнаяТаблица = Новый ТаблицаЗначений; //хранит общее количество необходимых материалов по спецификации после округления общего количества товаров
	ВременнаяТаблица.Колонки.Добавить("Номенклатура");
	ВременнаяТаблица.Колонки.Добавить("ХарактеристикаНоменклатуры");
	ВременнаяТаблица.Колонки.Добавить("ОкруглятьВБольшуюСторону");
	ВременнаяТаблица.Колонки.Добавить("ПорядокОкругленияЧислом");
	ВременнаяТаблица.Колонки.Добавить("КоличествоДоОкругления");
	ВременнаяТаблица.Колонки.Добавить("КоличествоПослеОкругления");
	ВременнаяТаблица.Колонки.Добавить("Продукция"); // #15041
	
	ТаблицаМатериалов = Новый ТаблицаЗначений;
	ТаблицаМатериалов.Колонки.Добавить("Номенклатура");
	ТаблицаМатериалов.Колонки.Добавить("ХарактеристикаНоменклатуры");
	ТаблицаМатериалов.Колонки.Добавить("ЕдиницаИзмерения");
	ТаблицаМатериалов.Колонки.Добавить("Коэффициент");
	ТаблицаМатериалов.Колонки.Добавить("Количество");
	ТаблицаМатериалов.Колонки.Добавить("Продукция"); // #15041
	
	Для Каждого ТекущаяСтрока Из МассивПозиций Цикл //Объект.Продукция Цикл // #15041
		//НоваяСтрока = ТаблицаМатериалов.Добавить();
		Если НЕ ТекущаяСтрока.Спецификация.Пустая() Тогда
			Для Каждого СтрокаСпецификации Из ТекущаяСтрока.Спецификация.Состав Цикл
				КоэффициентИзменения = ?(СтрокаСпецификации.ФиксированноеКоличество, 1, ТекущаяСтрока.Количество * ТекущаяСтрока.Коэффициент);
				КоличествоКДобавлению = ОбщийМодуль.ОкруглитьЧисло(КоэффициентИзменения * СтрокаСпецификации.Количество,СтрокаСпецификации.ПорядокОкругленияЧислом,СтрокаСпецификации.ОкруглятьВБольшуюСторону); 
				Если КоличествоКДобавлению > 0 Тогда
					НоваяСтрока = ТаблицаМатериалов.Добавить();
					ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаСпецификации);
					НоваяСтрока.Количество = КоличествоКДобавлению;
					НоваяСтрока.Продукция = ТекущаяСтрока.Номенклатура;    // #15041
					
					НоваяВремСтрока = ВременнаяТаблица.Добавить();
					НоваяВремСтрока.Номенклатура = СтрокаСпецификации.Номенклатура;
					НоваяВремСтрока.ХарактеристикаНоменклатуры = СтрокаСпецификации.ХарактеристикаНоменклатуры;
					НоваяВремСтрока.ОкруглятьВБольшуюСторону = СтрокаСпецификации.ОкруглятьВБольшуюСторону;
					НоваяВремСтрока.ПорядокОкругленияЧислом = СтрокаСпецификации.ПорядокОкругленияЧислом;
					НоваяВремСтрока.КоличествоДоОкругления = КоэффициентИзменения * СтрокаСпецификации.Количество;
					НоваяВремСтрока.КоличествоПослеОкругления = 0;
					НоваяВремСтрока.Продукция = ТекущаяСтрока.Номенклатура; // #15041
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	
	ТаблицаМатериалов.Свернуть("Номенклатура, ХарактеристикаНоменклатуры, ЕдиницаИзмерения, Коэффициент, Продукция",                    // #15041 +Продукция
							   "Количество");
	ВременнаяТаблица.Свернуть("Номенклатура, ХарактеристикаНоменклатуры, ОкруглятьВБольшуюСторону, ПорядокОкругленияЧислом, Продукция", // #15041 +Продукция
							  "КоличествоДоОкругления, КоличествоПослеОкругления");
	
	//посчитаем сколько какого материала должно быть итого с применением округления
	Для Каждого ТекущаяСтрока Из ВременнаяТаблица Цикл
		ТекущаяСтрока.КоличествоПослеОкругления = ОбщийМодуль.ОкруглитьЧисло(ТекущаяСтрока.КоличествоДоОкругления,ТекущаяСтрока.ПорядокОкругленияЧислом,ТекущаяСтрока.ОкруглятьВБольшуюСторону);
	КонецЦикла;
	
	//получаем итоговое количество каждого материала после всех округлений
	ВременнаяТаблица.Свернуть("Номенклатура, ХарактеристикаНоменклатуры", "КоличествоПослеОкругления");
	
	//перезаполняем количество в результирующей таблице на основании того, сколько должно было бы получиьтся при общем итоге после округления
	Для Каждого ТекущийМатериал Из ТаблицаМатериалов Цикл
		КоличествоБыло = ТекущийМатериал.Количество;
		ТекущийМатериал.Количество = 0;
		Для Каждого ТекущийИтогМатериала Из ВременнаяТаблица Цикл
			Если ТекущийМатериал.Номенклатура = ТекущийИтогМатериала.Номенклатура 
				И ТекущийМатериал.ХарактеристикаНоменклатуры = ТекущийИтогМатериала.ХарактеристикаНоменклатуры Тогда
				
				Если ТекущийИтогМатериала.КоличествоПослеОкругления >= КоличествоБыло Тогда
					ТекущийМатериал.Количество = КоличествоБыло;
					ТекущийИтогМатериала.КоличествоПослеОкругления = ТекущийИтогМатериала.КоличествоПослеОкругления - КоличествоБыло;
				Иначе
					ТекущийМатериал.Количество = ТекущийИтогМатериала.КоличествоПослеОкругления;
					ТекущийИтогМатериала.КоличествоПослеОкругления = 0;
				КонецЕсли;
				
			КонецЕсли;
		КонецЦикла
	КонецЦикла;
	
	//переносим таблицу в документ
	Для Каждого ТекущийМатериал Из ТаблицаМатериалов Цикл
		Если НЕ ТекущийМатериал.Количество = 0 Тогда
			НоваяСтрока = Объект.Материалы.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущийМатериал);
			НоваяСтрока.КоличествоКВыработке = НоваяСтрока.Количество;
		КонецЕсли;
	КонецЦикла;
	
	// закомментировано: типовые отрезу не используются
	//находим в списке материалов типовые отрезы и меняем их на соответствующую пленку
