&НаКлиенте
Процедура ПослеОтветаНаВопросОЗаменеПолотенНаОстатокПоштучно(Результат, Параметры) Экспорт
	Если Результат = КодВозвратаДиалога.Да Тогда
        ВызватьДиалогПодбораОстатков(Истина);
	Иначе
		ВызватьДиалогПодбораОстатков(Ложь);
    КонецЕсли;
КонецПроцедуры

&НаКлиенте 
Процедура ВызватьДиалогПодбораОстатков(ЗаменитьПолотнаВДокументе)
	
	ПараметрРежимПодбора = 1;
	
	ПараметрыПодбора = Новый Структура;
	ПараметрыПодбора.Вставить("Дата",					Объект.Дата);
	ПараметрыПодбора.Вставить("Организация",			Объект.Организация);
	ПараметрыПодбора.Вставить("Склад",					Объект.СкладМатериалов);
	ПараметрыПодбора.Вставить("ВидНоменклатуры",		ПолучитьСписокВидовНоменклатурыОстаткиПленки());
	ПараметрыПодбора.Вставить("ТолькоВНаличии",			Истина);
	ПараметрыПодбора.Вставить("НеЗапрашиватьЦену",		Истина);
	ПараметрыПодбора.Вставить("ВАльтернативнойЕдиницеИзмерения",		Истина);
	ОткрытьФорму("ОбщаяФорма.ФормаПодбораНоменклатуры", ПараметрыПодбора, ЭтаФорма, УникальныйИдентификатор);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбораПодборОстатковНаКлиенте(ВыбранноеЗначение)
	
	Если Не ЗначениеЗаполнено(ВыбранноеЗначение) Тогда
		Возврат;
	КонецЕсли;
			
	ОбработкаВыбораПодборОстатковНаСервере(ВыбранноеЗначение);
		
КонецПроцедуры

&НаСервере
Функция ОбработкаВыбораПодборОстатковНаСервере(ВыбранноеЗначение)
	
	ТаблицаТоваров = ПолучитьИзВременногоХранилища(ВыбранноеЗначение.АдресВХранилище);
	
	ВременнаяТаблица = Новый ТаблицаЗначений;
	ВременнаяТаблица.Колонки.Добавить("Номенклатура");
	ВременнаяТаблица.Колонки.Добавить("Количество");
	ВременнаяТаблица.Колонки.Добавить("ЕдиницаИзмерения");
	ВременнаяТаблица.Колонки.Добавить("Коэффициент");
	ВременнаяТаблица.Колонки.Добавить("Цена");
	ВременнаяТаблица.Колонки.Добавить("Сумма");
	ВременнаяТаблица.Колонки.Добавить("ХарактеристикаНоменклатуры");
	ВременнаяТаблица.Колонки.Добавить("Фактура");
	ВременнаяТаблица.Колонки.Добавить("Цвет");
	ВременнаяТаблица.Колонки.Добавить("НоменклатураКЗамене", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	
	Для Каждого ТекСтрока Из ТаблицаТоваров Цикл
		НоваяСтрока = ВременнаяТаблица.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
	КонецЦикла;	
	
	Для Каждого ТекМатериал Из Объект.Материалы Цикл
		Если ТекМатериал.Номенклатура.ВидНоменклатуры = ПредопределенноеЗначение("Справочник.ВидыНоменклатуры.Полотно") Тогда
			Для Каждого ТекОстаток Из ВременнаяТаблица Цикл
				Если ТекОстаток.НоменклатураКЗамене.Пустая() Тогда
					ТекОстаток.НоменклатураКЗамене = ТекМатериал.Номенклатура;					
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого ТекущаяСтрока из ВременнаяТаблица Цикл
		Если ТекущаяСтрока.НоменклатураКЗамене.Пустая() Тогда
			НоваяСтрока = Объект.Материалы.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущаяСтрока);
		Иначе
			Отбор = Новый Структура;
			Отбор.Вставить("Номенклатура", ТекущаяСтрока.НоменклатураКЗамене);
			НайденныеСтроки = Объект.Материалы.НайтиСтроки(Отбор);
			Если НайденныеСтроки.Количество() > 0 Тогда
				ЗаполнитьЗначенияСвойств(НайденныеСтроки[0], ТекущаяСтрока);
				НайденныеСтроки[0].ХарактеристикаНоменклатуры = Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка();
				НайденныеСтроки[0].СерияНоменклатуры = Справочники.СерииНоменклатуры.ПустаяСсылка();
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
КонецФункции

&НаСервере
Функция ПолучитьСписокВидовНоменклатурыОстаткиПленки()
	
	Список = Новый СписокЗначений;
	Список.Добавить(Справочники.ВидыНоменклатуры.ОстатокПленки);
	Возврат Список;
	
КонецФункции

&НаКлиенте
Процедура ЗаменитьМатериал(Команда)
	
	ТекущиеДанные = Элементы.Материалы.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ОткрытьФорму("Справочник.Номенклатура.ФормаВыбора",,,,,, новый ОписаниеОповещения("ПослеВыбораНоменклатурыЗаменитьМатериал", ЭтотОбъект, новый Структура("ИдентификаторСтроки", ТекущиеДанные.ПолучитьИдентификатор())));
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораНоменклатурыЗаменитьМатериал(ВыбранноеЗначение, ДопПараметры) Экспорт
	
	Если ВыбранноеЗначение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЗаменитьМатериалНаСервере(ВыбранноеЗначение, ДопПараметры.ИдентификаторСтроки);
	МатериалыНоменклатураПриИзменении(Неопределено);
	
КонецПроцедуры	

&НаСервере
Процедура ЗаменитьМатериалНаСервере(НовыйМатериал, ИдентификаторСтроки)
	
	ТекущаяСтрока = Объект.Материалы.НайтиПоИдентификатору(ИдентификаторСтроки);
	
	//++ №8266 при изменении номенклатуры пленки, если ширина предыдущей и текущей разные, то очищаем колонку "Количество"
	ПроверитьШиринуПолотнаНоменклатурыИОчиститьКоличествоПриРазличии(ТекущаяСтрока.Количество, НовыйМатериал, ТекущаяСтрока.Номенклатура);
	//-- №8266
	
	ТекущаяСтрока.Номенклатура = НовыйМатериал;
		
	Если Справочники.ВидыНоменклатуры.ЭтоНоменклатураПотолкаИлиОтреза(ТекущаяСтрока.Номенклатура) Тогда
		ТекущаяСтрока.Количество = ТекущаяСтрока.Номенклатура.Потолок_КоличествоПродукция;
	КонецЕсли;
	
КонецПроцедуры

//++ №8266 при изменении номенклатуры пленки, если ширина предыдущей и текущей разные, то очищаем колонку "Количество"
&НаСервере
Процедура ПроверитьШиринуПолотнаНоменклатурыИОчиститьКоличествоПриРазличии(Количество, НовыйМатериал, ПредыдущийМатериал)
	
	Если Константы.ПриЗаменеПленкиВВыпускеПродукцииНаПленкуДругойШириныОчищатьКоличествоКСписанию.Получить() 
		И НовыйМатериал.ВидНоменклатуры = Справочники.ВидыНоменклатуры.Полотно
		И ПредыдущийМатериал.ВидНоменклатуры = Справочники.ВидыНоменклатуры.Полотно
		И НЕ ПредыдущийМатериал.ШиринаПолотна = НовыйМатериал.ШиринаПолотна
	Тогда	
		
		Количество = 0;
	
	КонецЕсли;
	
КонецПроцедуры	
//-- №8266

&НаКлиенте
Процедура СпособНачисленияВыработкиПриИзменении(Элемент)
	
	ОбновитьДанныеДокумента();
	
КонецПроцедуры

&НаКлиенте
Процедура СтраницыПриСменеСтраницы(Элемент, ТекущаяСтраница)
	
	Если Элементы.Страницы.ТекущаяСтраница = Элементы.ГруппаТиповаяПродукция 
		или Элементы.Страницы.ТекущаяСтраница = Элементы.ГруппаПродукция Тогда
		Элементы.ГруппаИнформацияПоПотолку.Видимость = Ложь;
	Иначе
		Элементы.ГруппаИнформацияПоПотолку.Видимость = Истина;
	КонецЕсли;
	
	Если НЕ ТекущаяСтраница.Имя = "ТаблицаФайлы" Тогда
		Элементы.Предпросмотр.Вид = ВидПоляФормы.ПолеКартинки;
	КонецЕсли;
	
КонецПроцедуры

//++ №9892
&НаКлиенте
Процедура ОбновитьИнформациюПоПотолку()
	
	ИнформацияПоПотолку.Очистить();
	
	Если Объект.ВидЗаказа = ПредопределенноеЗначение("Перечисление.ВидыЗаказовНаПроизводство.ПроизводствоПотолка") И ЗначениеЗаполнено(Объект.ПродукцияНоменклатура) Тогда
		
		// Потолок
		НоваяСтрока = ИнформацияПоПотолку.Добавить();
		НоваяСтрока.НомерРасчета = Объект.ПродукцияНомерРасчета;
		НоваяСтрока.Номенклатура = Объект.ПродукцияНоменклатура;
		НоваяСтрока.Количество = Объект.ПродукцияНоменклатураКоличество;
		НоваяСтрока.ЕдиницаИзмерения = Объект.ПродукцияНоменклатураЕдиницаИзмерения;
		
	ИначеЕсли Объект.Продукция.Количество() > 0 Тогда
		
		// Типовое производство
		НоваяСтрока = ИнформацияПоПотолку.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Объект.Продукция[0]);
		НоваяСтрока.НомерРасчета = ПолучитьНомерРасчетаПродукции(НоваяСтрока.Номенклатура);
		
	КонецЕсли;
		
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьНомерРасчетаПродукции(Номенклатура)
	
	Возврат Номенклатура.Потолок_НомерРасчета;
	
КонецФункции

&НаКлиенте
Процедура ПродукцияНоменклатураКоличествоПриИзменении(Элемент)
	
	ОбновитьИнформациюПоПотолку();
	
КонецПроцедуры

&НаКлиенте
Процедура ПродукцияНомерРасчетаПриИзменении(Элемент)
	
	ОбновитьИнформациюПоПотолку();
	
КонецПроцедуры

&НаКлиенте
Процедура ВывестиПотолокВТабличнойЧасти()
	
	Потолок.Очистить();
	
	Если Объект.ВидЗаказа = ПредопределенноеЗначение("Перечисление.ВидыЗаказовНаПроизводство.ПроизводствоПотолка") Тогда
		
		// Потолок
		НоваяСтрока = Потолок.Добавить();
		НоваяСтрока.НомерСтроки = 1;
		НоваяСтрока.НомерРасчета = Объект.ПродукцияНомерРасчета;
		НоваяСтрока.Номенклатура = Объект.ПродукцияНоменклатура;
		НоваяСтрока.Количество = Объект.ПродукцияНоменклатураКоличество;
		НоваяСтрока.ЕдиницаИзмерения = Объект.ПродукцияНоменклатураЕдиницаИзмерения;
		НоваяСтрока.Коэффициент = Объект.ПродукцияНоменклатураКоэффициент;
		
	КонецЕсли;
		
	
КонецПроцедуры

&НаКлиенте
Процедура ПеренестиПотолокИзТабличнойЧасти(ТекущиеДанные)
	
	Объект.ПродукцияНомерРасчета = ТекущиеДанные.НомерРасчета;
	Объект.ПродукцияНоменклатура = ТекущиеДанные.Номенклатура;
	Объект.ПродукцияНоменклатураКоличество = ТекущиеДанные.Количество;
	Объект.ПродукцияНоменклатураЕдиницаИзмерения = ТекущиеДанные.ЕдиницаИзмерения;
	Объект.ПродукцияНоменклатураКоэффициент = ТекущиеДанные.Коэффициент;
	
КонецПроцедуры

