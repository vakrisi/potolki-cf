
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	УстановитьУсловноеОформление();
	
	МассивЗаказов = Новый Массив;
	Для каждого СсылкаНаЗаказ из Параметры.СписокЗаказов Цикл
		НоваяСтрока = ТаблицаЗаказов.Добавить();
		НоваяСтрока.Заказ = СсылкаНаЗаказ;
		МассивЗаказов.Добавить(СсылкаНаЗаказ);
	КонецЦикла;
	ТаблицаЗаказов.Сортировать("Заказ");
	
	Если Константы.РасчетЗарплатыПроизводстваПоОперациям.Получить() Тогда
		Элементы.ГруппаИсполнителиПоОперациям.Видимость = Истина;
		Элементы.ГруппаИсполнители.Видимость 			= Ложь;
	Иначе
		Элементы.ГруппаИсполнителиПоОперациям.Видимость = Ложь;
		Элементы.ГруппаИсполнители.Видимость 			= Истина;
	КонецЕсли;
	
	Элементы.ТаблицаМатериаловЗаказ.СписокВыбора.ЗагрузитьЗначения(МассивЗаказов);
	Элементы.ИсполнителиЗаказ.СписокВыбора.ЗагрузитьЗначения(МассивЗаказов);
	Элементы.ИсполнителиПоОперациямЗаказ.СписокВыбора.ЗагрузитьЗначения(МассивЗаказов);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ПодключитьОбработчикОжидания("ЗапуститьЗаполнение", 0.1, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "ИзмененСтатусЗаказаНаПроизводство" Тогда
		ПослеСозданияВыпуска(Параметр);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ФоновоеЗаполнениеТаблиц

&НаКлиенте
Процедура ЗапуститьЗаполнение()
	
	Элементы.ГруппаФоновоеЗаполнение.Видимость = Истина;
	
	ПараметрыОбмена = Новый Структура;
	ПараметрыОбмена.Вставить("МассивЗаказов", ПолучитьМассивЗаказов());
	
	ДлительнаяОперация = ВыполнитьЗаполнениеНаСервере(ПараметрыОбмена);
	ИдентификаторЗадания = ДлительнаяОперация.ИдентификаторЗадания;
	
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ВыводитьОкноОжидания = Ложь;
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ПриЗавершенииОперацииЗаполнения", ЭтотОбъект);
	ДлительныеОперацииКлиент.ОжидатьЗавершение(ДлительнаяОперация, ОписаниеОповещения, ПараметрыОжидания);
	
КонецПроцедуры

&НаСервере
Функция ВыполнитьЗаполнениеНаСервере(ПараметрыОбмена)
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = НСтр("ru = 'Заполнение массового выпуска'");
	
	Результат = ДлительныеОперации.ВыполнитьВФоне("Документы.ВыпускПродукции.ВыполнитьЗаполнениеПоЗаказамДляМассовогоВыпускаИнтерактивно", ПараметрыОбмена, ПараметрыВыполнения);
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ПриЗавершенииОперацииЗаполнения(Результат, ДополнительныеПараметры) Экспорт
	
	Элементы.ГруппаФоновоеЗаполнение.Видимость = Ложь;
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Результат.Статус = "Ошибка" Тогда
			
		ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Заполнение прервано по причине:
				|%1'"),
			Результат.КраткоеПредставлениеОшибки);
			
		Сообщить(ТекстОшибки);
		
		Возврат;
	КонецЕсли;
	
	Элементы.ФормаСоздатьВыпуски.Доступность = Истина;
	
	ТаблицаПродукции.Очистить();
	ТаблицаМатериалов.Очистить();
	ТаблицаУслуг.Очистить();
	Исполнители.Очистить();
	ИсполнителиПоОперациям.Очистить();
	
	Данные = ПолучитьИзВременногоХранилища(Результат.АдресРезультата);
	МассивПродукции = Новый Массив;
		
	Для каждого СтрокаТЧ из Данные.ТаблицаПродукции Цикл
		НоваяСтрока = ТаблицаПродукции.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТЧ);
		МассивПродукции.Добавить(НоваяСтрока.Номенклатура);
	КонецЦикла;
	
	Для каждого СтрокаТЧ из Данные.ТаблицаМатериалов Цикл
		НоваяСтрока = ТаблицаМатериалов.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТЧ);
	КонецЦикла;
	
	Для каждого СтрокаТЧ из Данные.ТаблицаУслуг Цикл
		НоваяСтрока = ТаблицаУслуг.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТЧ);
	КонецЦикла;
		
	Для каждого СтрокаТЧ из Данные.ТаблицаИсполнителей Цикл
		НоваяСтрока = Исполнители.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТЧ);
	КонецЦикла;
	
	Для каждого СтрокаТЧ из Данные.ТаблицаИсполнителейПоОперациям Цикл
		НоваяСтрока = ИсполнителиПоОперациям.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТЧ);
	КонецЦикла;
	
	Элементы.ТаблицаМатериаловПродукция.СписокВыбора.ЗагрузитьЗначения(МассивПродукции);
	Элементы.ИсполнителиПродукция.СписокВыбора.ЗагрузитьЗначения(МассивПродукции);
	Элементы.ИсполнителиПоОперациямПродукция.СписокВыбора.ЗагрузитьЗначения(МассивПродукции);
	
	ЗаполнитьПризнакПодсветки();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийТаблицыЗаказов

