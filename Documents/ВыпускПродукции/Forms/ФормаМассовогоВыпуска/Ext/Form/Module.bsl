КонецПроцедуры

&НаКлиенте
Функция ПослеСозданияВыпуска(СсылкаЗаказ)

	КоличествоСтрок = ТаблицаЗаказов.Количество(); 
	Для Индекс = 1 По КоличествоСтрок Цикл
		СтрокаЗаказа = ТаблицаЗаказов[КоличествоСтрок-Индекс];
		Если СсылкаЗаказ = СтрокаЗаказа.Заказ Тогда
			ТекущиеДанныеПоЗаказу = ТекущиеДанныеПоЗаказу(СсылкаЗаказ);
			Если ТекущиеДанныеПоЗаказу.ТекущийСтатус = ПредопределенноеЗначение("Справочник.СтатусыЗаказовНаПроизводство.Произведен") Тогда
				ТаблицаЗаказов.Удалить(СтрокаЗаказа);
				
				УдалитьПодчиненныеСтроки(ТаблицаПродукции, СсылкаЗаказ);
				УдалитьПодчиненныеСтроки(ТаблицаМатериалов, СсылкаЗаказ);
				УдалитьПодчиненныеСтроки(ТаблицаУслуг, СсылкаЗаказ);
				УдалитьПодчиненныеСтроки(Исполнители, СсылкаЗаказ);
				УдалитьПодчиненныеСтроки(ИсполнителиПоОперациям, СсылкаЗаказ);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Если ТаблицаЗаказов.Количество() = 0 Тогда
		ПоказатьОповещениеПользователя("Созданы выпуски");
		Закрыть();
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Функция ПараметрыЗаполненияВыпуска(СсылкаЗаказ)
	
	СтруктураНовогоДокумента = Новый Структура;
	СтруктураНовогоДокумента.Вставить("Заказ", СсылкаЗаказ);
	СтруктураНовогоДокумента.Вставить("Материалы", Новый Массив);
	СтруктураНовогоДокумента.Вставить("Услуги", Новый Массив);
	СтруктураНовогоДокумента.Вставить("Исполнители", Новый Массив);
	СтруктураНовогоДокумента.Вставить("ИсполнителиПоОперациям", Новый Массив);
		
	НайденныеСтрокиПродукции = ТаблицаПродукции.НайтиСтроки(Новый Структура("Заказ", СсылкаЗаказ));	
	Если НайденныеСтрокиПродукции.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	СоздаваемаяПродукция = НайденныеСтрокиПродукции[0].Номенклатура;
	
	Для каждого СтрокаТЧ из ТаблицаМатериалов Цикл
		Если СтрокаТЧ.Заказ = СсылкаЗаказ Тогда
			СтруктураСтроки = Новый Структура("Номенклатура, ХарактеристикаНоменклатуры, СерияНоменклатуры, ЕдиницаИзмерения, Коэффициент, Количество, КоличествоКВыработке, Продукция");
			ЗаполнитьЗначенияСвойств(СтруктураСтроки, СтрокаТЧ);
			
			СтруктураНовогоДокумента.Материалы.Добавить(СтруктураСтроки);
		КонецЕсли;
	КонецЦикла;
	
	Для каждого СтрокаТЧ из ТаблицаУслуг Цикл
		Если СтрокаТЧ.Заказ = СсылкаЗаказ Тогда
			СтруктураСтроки = Новый Структура("Номенклатура, ЕдиницаИзмерения, Коэффициент, Количество, КоличествоКВыработке, Продукция");
			ЗаполнитьЗначенияСвойств(СтруктураСтроки, СтрокаТЧ);
			
			СтруктураНовогоДокумента.Услуги.Добавить(СтруктураСтроки);
		КонецЕсли;
	КонецЦикла;
	
	Для каждого СтрокаТЧ из Исполнители Цикл
		Если СтрокаТЧ.Заказ = СсылкаЗаказ Тогда
			СтруктураСтроки = Новый Структура("Сотрудник, Коэффициент, Продукция");
			ЗаполнитьЗначенияСвойств(СтруктураСтроки, СтрокаТЧ);
			
			СтруктураНовогоДокумента.Исполнители.Добавить(СтруктураСтроки);
		КонецЕсли;
	КонецЦикла;
	
	Для каждого СтрокаТЧ из ИсполнителиПоОперациям Цикл
		Если СтрокаТЧ.Заказ = СсылкаЗаказ Тогда
			СтруктураСтроки = Новый Структура("Операция, Сотрудник1, Сотрудник2, Сотрудник3, Сотрудник4, Коэффициент1, Коэффициент2, Коэффициент3, Коэффициент4, Продукция");
			ЗаполнитьЗначенияСвойств(СтруктураСтроки, СтрокаТЧ);
			
			СтруктураНовогоДокумента.ИсполнителиПоОперациям.Добавить(СтруктураСтроки);
		КонецЕсли;
	КонецЦикла;
		
	Возврат СтруктураНовогоДокумента;
	
КонецФункции

