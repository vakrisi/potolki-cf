#Область ОбработчикиСобытийТаблицыЗаказов

&НаКлиенте
Процедура ТаблицаЗаказовВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	ПоказатьЗначение(, Элементы.ТаблицаЗаказов.ТекущиеДанные.Заказ);
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаЗаказовПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	Отказ = Истина;
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаЗаказовПередНачаломИзменения(Элемент, Отказ)
	Отказ = Истина;
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаЗаказовПередУдалением(Элемент, Отказ)
	
	Отказ = Истина;
	ДополнительныеПараметры = Новый Структура("ИдентификаторСтроки", Элемент.ТекущаяСтрока);
	Оповещение = Новый ОписаниеОповещения("ТаблицаЗаказовПередУдалениемЗавершение", ЭтотОбъект, ДополнительныеПараметры);
	ПоказатьВопрос(Оповещение, "Удалить заказ?", РежимДиалогаВопрос.ДаНет);
		
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаЗаказовПередУдалениемЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если НЕ Результат = КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	СтрокаТаблицы = ТаблицаЗаказов.НайтиПоИдентификатору(ДополнительныеПараметры.ИдентификаторСтроки);
	УдаляемыйЗаказ = СтрокаТаблицы.Заказ;
	ТаблицаЗаказов.Удалить(СтрокаТаблицы);
	
	УдаляемаяПродукция = Неопределено;
	КоличествоЭлементов = ТаблицаПродукции.Количество();
	Для Индекс = 1 по КоличествоЭлементов Цикл
		СтрокаТаблицы = ТаблицаПродукции[КоличествоЭлементов-Индекс];
		Если СтрокаТаблицы.Заказ = УдаляемыйЗаказ Тогда
			УдаляемаяПродукция = СтрокаТаблицы.Номенклатура;
			ТаблицаПродукции.Удалить(СтрокаТаблицы);
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	КоличествоЭлементов = ТаблицаМатериалов.Количество();
	Для Индекс = 1 по КоличествоЭлементов Цикл
		СтрокаТаблицы = ТаблицаМатериалов[КоличествоЭлементов-Индекс];
		Если СтрокаТаблицы.Продукция = УдаляемаяПродукция ИЛИ СтрокаТаблицы.Заказ = УдаляемыйЗаказ Тогда
			ТаблицаМатериалов.Удалить(СтрокаТаблицы);
		КонецЕсли;
	КонецЦикла;
	КоличествоЭлементов = ТаблицаУслуг.Количество();
	Для Индекс = 1 по КоличествоЭлементов Цикл
		СтрокаТаблицы = ТаблицаУслуг[КоличествоЭлементов-Индекс];
		Если СтрокаТаблицы.Продукция = УдаляемаяПродукция ИЛИ СтрокаТаблицы.Заказ = УдаляемыйЗаказ Тогда
			ТаблицаУслуг.Удалить(СтрокаТаблицы);
		КонецЕсли;
	КонецЦикла;
	КоличествоЭлементов = Исполнители.Количество();
	Для Индекс = 1 по КоличествоЭлементов Цикл
		СтрокаТаблицы = Исполнители[КоличествоЭлементов-Индекс];
		Если СтрокаТаблицы.Продукция = УдаляемаяПродукция ИЛИ СтрокаТаблицы.Заказ = УдаляемыйЗаказ Тогда
			Исполнители.Удалить(СтрокаТаблицы);
		КонецЕсли;
	КонецЦикла;
	КоличествоЭлементов = ИсполнителиПоОперациям.Количество();
	Для Индекс = 1 по КоличествоЭлементов Цикл
		СтрокаТаблицы = ИсполнителиПоОперациям[КоличествоЭлементов-Индекс];
		Если СтрокаТаблицы.Продукция = УдаляемаяПродукция ИЛИ СтрокаТаблицы.Заказ = УдаляемыйЗаказ Тогда
			ИсполнителиПоОперациям.Удалить(СтрокаТаблицы);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийТабличныхЧастей

&НаКлиенте
Процедура ТаблицаМатериаловПриИзменении(Элемент)
	ЗаполнитьПризнакПодсветки();
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаМатериаловНоменклатураПриИзменении(Элемент)
	
	СтрокаТабличнойЧасти = Элементы.ТаблицаМатериалов.ТекущиеДанные;
	СтрокаТабличнойЧасти.ЕдиницаИзмерения = ОбщийМодульВызовСервера.ПолучитьБазовуюЕдиницуИзмеренияНоменклатуры(СтрокаТабличнойЧасти.Номенклатура);
	СтрокаТабличнойЧасти.Коэффициент = 1;
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаМатериаловЕдиницаИзмеренияПриИзменении(Элемент)
	СтрокаТабличнойЧасти = Элементы.ТаблицаМатериалов.ТекущиеДанные;
	Если ТипЗнч(СтрокаТабличнойЧасти.ЕдиницаИзмерения) = Тип("СправочникСсылка.КлассификаторЕдиницИзмерения") Тогда
		СтрокаТабличнойЧасти.Коэффициент = 1;
	Иначе
		СтрокаТабличнойЧасти.Коэффициент = ОбщийМодуль.ПолучитьКоэффициентЕдиницыИзмерения(СтрокаТабличнойЧасти.ЕдиницаИзмерения);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаМатериаловЕдиницаИзмеренияНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	СтрокаТабличнойЧасти = Элементы.ТаблицаМатериалов.ТекущиеДанные;
	СписокЕдиниц = ОбщийМодуль.ПолучитьСписокЕдиницИзмеренияНоменклатуры(СтрокаТабличнойЧасти.Номенклатура);
	
	ДанныеВыбора = Новый СписокЗначений;
	Для Ном = 0 По СписокЕдиниц.Количество() - 1 Цикл
		ДанныеВыбора.Добавить(СписокЕдиниц[Ном]);
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаМатериаловЕдиницаИзмеренияОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	СтрокаТабличнойЧасти = Элементы.ТаблицаМатериалов.ТекущиеДанные;
	Если ТипЗнч(ВыбранноеЗначение) = Тип("СправочникСсылка.КлассификаторЕдиницИзмерения") Тогда
		СтрокаТабличнойЧасти.Коэффициент = 1;
	Иначе
		СтрокаТабличнойЧасти.Коэффициент = ОбщийМодуль.ПолучитьКоэффициентЕдиницыИзмерения(ВыбранноеЗначение);
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыФункции

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	УсловноеОформление.Элементы.Очистить();
	
	// материалы
	Элемент = УсловноеОформление.Элементы.Добавить();

	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных("ТаблицаМатериалов");
	
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ТаблицаМатериалов.Подсвечивать");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Истина;
	
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветФона", WebЦвета.СеребристоСерый);
	
КонецПроцедуры

&НаСервере
Функция ПолучитьМассивЗаказов()
	
	Возврат ТаблицаЗаказов.Выгрузить().ВыгрузитьКолонку("Заказ");
	
КонецФункции

&НаСервере
Функция ТекущиеДанныеПоЗаказу(СсылкаЗаказ)
	Возврат ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СсылкаЗаказ, "ТекущийСтатус, Дата, Номер");
КонецФункции

&НаКлиенте
Процедура ЗаполнитьПризнакПодсветки()
	
	КоличествоЭлементов = ТаблицаМатериалов.Количество();
	Подсвечивать = Ложь;
	Для Индекс = 1 по КоличествоЭлементов-1 Цикл
		СтрокаТаблицы = ТаблицаМатериалов[Индекс];
		ПредСтрокаТаблицы = ТаблицаМатериалов[Индекс-1];
		Если НЕ (СтрокаТаблицы.Продукция = ПредСтрокаТаблицы.Продукция) Тогда
			СтрокаТаблицы.Подсвечивать = НЕ ПредСтрокаТаблицы.Подсвечивать;
		Иначе
			СтрокаТаблицы.Подсвечивать = ПредСтрокаТаблицы.Подсвечивать;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверкаЗаполнения(Отказ)
	
	// проверки
	МассивПроверяемыхРеквизитов = Новый Структура;
	МассивПроверяемыхРеквизитов.Вставить("Продукция", "Продукция");
	МассивПроверяемыхРеквизитов.Вставить("Номенклатура", "Номенклатура");
	МассивПроверяемыхРеквизитов.Вставить("Количество", "Количество");
	МассивПроверяемыхРеквизитов.Вставить("Коэффициент", "Коэффициент");
	МассивПроверяемыхРеквизитов.Вставить("ЕдиницаИзмерения", "Единица измерения");
	НомерСтроки = 0;
	Для каждого СтрокаТЧ из ТаблицаМатериалов Цикл
		НомерСтроки = НомерСтроки + 1;
		Для каждого ЭлементМассива из МассивПроверяемыхРеквизитов Цикл
			Если НЕ ЗначениеЗаполнено(СтрокаТЧ[ЭлементМассива.Ключ]) Тогда
				ТекстОшибки = НСтр("ru='Не заполнена колонка ""%ИмяКолонки%"" в строке ""%НомерСтроки%"" таблицы материалов'");
				ТекстОшибки = СтрЗаменить(ТекстОшибки, "%ИмяКолонки%", ЭлементМассива.Значение);
				ТекстОшибки = СтрЗаменить(ТекстОшибки, "%НомерСтроки%", НомерСтроки);
				
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки, ,
					ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("ТаблицаМатериалов", НомерСтроки, ЭлементМассива.Ключ), , Отказ);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	МассивПроверяемыхРеквизитов = Новый Структура;
	МассивПроверяемыхРеквизитов.Вставить("Продукция", "Продукция");
	МассивПроверяемыхРеквизитов.Вставить("Номенклатура", "Номенклатура");
	МассивПроверяемыхРеквизитов.Вставить("Количество", "Количество");
	МассивПроверяемыхРеквизитов.Вставить("Коэффициент", "Коэффициент");
	МассивПроверяемыхРеквизитов.Вставить("ЕдиницаИзмерения", "Единица измерения");
	НомерСтроки = 0;
	Для каждого СтрокаТЧ из ТаблицаУслуг Цикл
		НомерСтроки = НомерСтроки + 1;
		Для каждого ЭлементМассива из МассивПроверяемыхРеквизитов Цикл
			Если НЕ ЗначениеЗаполнено(СтрокаТЧ[ЭлементМассива.Ключ]) Тогда
				ТекстОшибки = НСтр("ru='Не заполнена колонка ""%ИмяКолонки%"" в строке ""%НомерСтроки%"" таблицы услуг'");
				ТекстОшибки = СтрЗаменить(ТекстОшибки, "%ИмяКолонки%", ЭлементМассива.Значение);
				ТекстОшибки = СтрЗаменить(ТекстОшибки, "%НомерСтроки%", НомерСтроки);
				
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки, ,
					ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("ТаблицаУслуг", НомерСтроки, ЭлементМассива.Ключ), , Отказ);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	МассивПроверяемыхРеквизитов = Новый Структура;
	МассивПроверяемыхРеквизитов.Вставить("Продукция", "Продукция");
	МассивПроверяемыхРеквизитов.Вставить("Сотрудник", "Сотрудник");
	НомерСтроки = 0;
	Для каждого СтрокаТЧ из Исполнители Цикл
		НомерСтроки = НомерСтроки + 1;
		Для каждого ЭлементМассива из МассивПроверяемыхРеквизитов Цикл
			Если НЕ ЗначениеЗаполнено(СтрокаТЧ[ЭлементМассива.Ключ]) Тогда
				ТекстОшибки = НСтр("ru='Не заполнена колонка ""%ИмяКолонки%"" в строке ""%НомерСтроки%"" таблицы исполнителей'");
				ТекстОшибки = СтрЗаменить(ТекстОшибки, "%ИмяКолонки%", ЭлементМассива.Значение);
				ТекстОшибки = СтрЗаменить(ТекстОшибки, "%НомерСтроки%", НомерСтроки);
				
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки, ,
					ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("Исполнители", НомерСтроки, ЭлементМассива.Ключ), , Отказ);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	МассивПроверяемыхРеквизитов = Новый Структура;
	МассивПроверяемыхРеквизитов.Вставить("Продукция", "Продукция");
	МассивПроверяемыхРеквизитов.Вставить("Операция", "Операция");
	НомерСтроки = 0;
	Для каждого СтрокаТЧ из ИсполнителиПоОперациям Цикл
		НомерСтроки = НомерСтроки + 1;
		Для каждого ЭлементМассива из МассивПроверяемыхРеквизитов Цикл
			Если НЕ ЗначениеЗаполнено(СтрокаТЧ[ЭлементМассива.Ключ]) Тогда
				ТекстОшибки = НСтр("ru='Не заполнена колонка ""%ИмяКолонки%"" в строке ""%НомерСтроки%"" таблицы исполнителей'");
				ТекстОшибки = СтрЗаменить(ТекстОшибки, "%ИмяКолонки%", ЭлементМассива.Значение);
				ТекстОшибки = СтрЗаменить(ТекстОшибки, "%НомерСтроки%", НомерСтроки);
				
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки, ,
					ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("ИсполнителиПоОперациям", НомерСтроки, ЭлементМассива.Ключ), , Отказ);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура УдалитьПодчиненныеСтроки(ТаблицаДанных, СсылкаЗаказ)

	КоличествоСтрок = ТаблицаДанных.Количество(); 
	Для Индекс = 1 По КоличествоСтрок Цикл
		СтрокаЗаказа = ТаблицаДанных[КоличествоСтрок-Индекс];
		Если СсылкаЗаказ = СтрокаЗаказа.Заказ Тогда
			ТаблицаДанных.Удалить(СтрокаЗаказа);
		КонецЕсли;
	КонецЦикла;
		
КонецПроцедуры

#КонецОбласти
