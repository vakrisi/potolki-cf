Функция ЗаказНаПроизводствоИсполнен(ЗаказНаПроизводство, Регистратор)
	
	Результат = Истина;
	
	Если ЗаказНаПроизводство.ВидЗаказа = Перечисления.ВидыЗаказовНаПроизводство.ПроизводствоПотолка или ЗаказНаПроизводство.ВидЗаказа.Пустая() Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЗаказыНаПроизводствоОбороты.КоличествоПриход,
		|	ЗаказыНаПроизводствоОбороты.КоличествоРасход
		|ИЗ
		|	РегистрНакопления.ЗаказыНаПроизводство.Обороты(, , Регистратор, ЗаказНаПроизводство = &ЗаказНаПроизводство) КАК ЗаказыНаПроизводствоОбороты
		|ГДЕ
		|	ЗаказыНаПроизводствоОбороты.Регистратор <> &Регистратор";
		
		Запрос.УстановитьПараметр("ЗаказНаПроизводство",ЗаказНаПроизводство);
		Запрос.УстановитьПараметр("Регистратор",Регистратор);
		РезультатЗапроса = Запрос.Выполнить().Выгрузить();
		
		Если РезультатЗапроса.Итог("КоличествоПриход") > РезультатЗапроса.Итог("КоличествоРасход") Тогда
			Результат = Ложь;
		КонецЕсли;
		
	ИначеЕсли ЗаказНаПроизводство.ВидЗаказа = Перечисления.ВидыЗаказовНаПроизводство.ТиповоеПроизводство Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЗаказыНаПроизводствоОбороты.КоличествоПриход,
		|	ЗаказыНаПроизводствоОбороты.КоличествоРасход
		|ИЗ
		|	РегистрНакопления.ЗаказыНаТиповоеПроизводство.Обороты(, , Регистратор, ЗаказНаПроизводство = &ЗаказНаПроизводство) КАК ЗаказыНаПроизводствоОбороты
		|ГДЕ
		|	ЗаказыНаПроизводствоОбороты.Регистратор <> &Регистратор";
		
		Запрос.УстановитьПараметр("ЗаказНаПроизводство",ЗаказНаПроизводство);
		Запрос.УстановитьПараметр("Регистратор",Регистратор);
		РезультатЗапроса = Запрос.Выполнить().Выгрузить();
		
		Если РезультатЗапроса.Итог("КоличествоПриход") > РезультатЗапроса.Итог("КоличествоРасход") Тогда
			Результат = Ложь;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура ЗаполнитьСтоимостьПриходаПоСписанию(ТаблицаТоваров)
	
	ОрганизацияТоваров = Организация;
	Если Константы.ОбщиеСклады.Получить() Тогда
		ОрганизацияТоваров = Справочники.Организации.ПустаяСсылка();
	КонецЕсли;
	
	Для Каждого ТекущийТовар Из ТаблицаТоваров Цикл
		Цена = Движения.ТоварыНаСкладах.ПолучитьЦенуОстаткаНоменклатуры(Дата, ОрганизацияТоваров, СкладМатериалов, ТекущийТовар.Номенклатура, ТекущийТовар.ХарактеристикаНоменклатуры, ТекущийТовар.СерияНоменклатуры);
		ТекущийТовар.Сумма = ТекущийТовар.Количество * ТекущийТовар.Коэффициент * Цена;
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьИтогПоТаблицеМатериаловПоПродукции(Знач ТаблицаМатериалов, Знач Продукция)
	
	Сумма = 0;
	Для Каждого ТекущаяСтрока Из ТаблицаМатериалов Цикл
		Если ТекущаяСтрока.Продукция = Продукция Тогда
			Сумма = Сумма + ТекущаяСтрока.Сумма;
		КонецЕсли;
	КонецЦикла;
	Возврат Сумма;
КонецФункции

Процедура ЗаполнитьИсполнителейПоСмене() Экспорт
	
	ОбщийМодульСервер.ЗаполнитьИсполнителейПроизводстваПоСмене(ЭтотОбъект);
		
КонецПроцедуры

Процедура ДополнитьТаблицуВыработки(ТаблицаПоВыработке)
	
	ТаблицаПоВыработке.Колонки.Добавить("Период");
	ТаблицаПоВыработке.Колонки.Добавить("Регистратор");
	//ТаблицаПоВыработке.Колонки.Добавить("Продукция");
	ТаблицаПоВыработке.Колонки.Добавить("НомерРасчета");
	ТаблицаПоВыработке.Колонки.Добавить("ОбъектВыработки");
	ТаблицаПоВыработке.Колонки.Добавить("Подразделение");
	
	ТаблицаПоВыработке.ЗаполнитьЗначения(?(Дата = Дата(1,1,1), ТекущаяДатаСеанса(), Дата), "Период");
	ТаблицаПоВыработке.ЗаполнитьЗначения(Ссылка, "Регистратор");
	//ТаблицаПоВыработке.ЗаполнитьЗначения(ПродукцияНоменклатура, "Продукция");
	ТаблицаПоВыработке.ЗаполнитьЗначения(ПродукцияНомерРасчета, "НомерРасчета");
	ТаблицаПоВыработке.ЗаполнитьЗначения(Ссылка, "ОбъектВыработки");
	ТаблицаПоВыработке.ЗаполнитьЗначения(Подразделение, "Подразделение");
	
КонецПроцедуры	

