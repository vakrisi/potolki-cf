Процедура СформироватьДанныеВыбораВидаДокументаОснованияПоМонтажу(ДанныеВыбора, Текст="")
	
	ПредставлениеЭлемента = Строка(ПредопределенноеЗначение("Справочник.ВидыДокументовОснованийРасчетаВыработки.ЗаказДоговор"));
	Если ПустаяСтрока(Текст) ИЛИ СтрНайти(ВРег(ПредставлениеЭлемента), ВРег(Текст)) Тогда
		ДанныеВыбора.Добавить(ПредопределенноеЗначение("Справочник.ВидыДокументовОснованийРасчетаВыработки.ЗаказДоговор"), ПредставлениеЭлемента);
	КонецЕсли;
	
	//#16346 закомментировано
	//ПредставлениеЭлемента = Строка(ПредопределенноеЗначение("Справочник.ВидыДокументовОснованийРасчетаВыработки.Лид"));
	//Если ПустаяСтрока(Текст) ИЛИ СтрНайти(ВРег(ПредставлениеЭлемента), ВРег(Текст)) Тогда
