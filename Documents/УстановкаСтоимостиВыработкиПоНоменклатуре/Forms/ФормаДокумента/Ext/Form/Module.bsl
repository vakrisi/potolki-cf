&НаСервере
Процедура ОбновитьЗаголовкиСтраниц()

	КоличествоОбщие = ?(НЕ Объект.СуммаВыработкиНеМенее = 0, 1, 0) + 
					  ?(НЕ Объект.СуммаВыработкиНеБолееПроцентаОтСуммыДокумента = 0, 1, 0) + 
					  ?(НЕ Объект.СтоимостьЗаДокумент = 0, 1, 0);
	Элементы.ГруппаОбщиеНастройки.Заголовок = "Общие" + ?(КоличествоОбщие = 0, "", " (" + КоличествоОбщие + ")");
	
КонецПроцедуры
	
&НаКлиенте
Процедура Подключаемый_ЗакрытьФорму()
	
	Закрыть();
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ОбработатьЗаписьОбъекта()
	
	ОбщийМодульКлиент.ОбработатьЗаписьОбъектаВФорме(ЭтотОбъект, ПараметрыДляЗаписи);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьПроверкиИЗадатьВопросыПередЗаписью(Отказ, ПараметрыЗаписи)
	
	// #14355
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ПараметрыЗаписи", ПараметрыЗаписи);
	ДополнительныеПараметры.Вставить("ЭтотОбъект", ЭтотОбъект);
			
	Отказ = Истина;
	ОписаниеОповещения = Новый ОписаниеОповещения("ПодтверждениеПередЗаписью", ЭтотОбъект, ДополнительныеПараметры);
	
	ТекстВопроса = СтрШаблон("Изменения ранее %1 документа ""Установка стоимости выработки"" 
					|может привести к расхождениям в начислении выработки во всех документах, 
					|оформленных датой позднее текущего документа ""Установка стоимости выработки"". 
					|Продолжить?", ?(ОбщийМодульВызовСервера.ДокументПроведен(Объект.Ссылка), "проведенного", "непроведенного"));
	ПоказатьВопрос(
		ОписаниеОповещения,
		ТекстВопроса,
		РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры

&НаКлиенте
Процедура ПодтверждениеПередЗаписью(ОтветНаВопрос, ДополнительныеПараметры) Экспорт
	
	Отказ = Ложь;
	
	Если ОтветНаВопрос = КодВозвратаДиалога.Да Тогда
		Отказ = Ложь;
	Иначе
		Возврат;
	КонецЕсли;
	
	ДополнительныеПараметры.Вставить("Отказ", Отказ);
	ОбщийМодульКлиент.ЗаписатьОбъектПриНеобходимости(ЭтотОбъект, ДополнительныеПараметры.ПараметрыЗаписи,, Истина);
	
КонецПроцедуры

