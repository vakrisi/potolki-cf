&НаКлиенте
Процедура ВыборДокументаЗавершение(Значение, ДопПараметры) Экспорт
	
    Если Значение = Неопределено Тогда
        Возврат;
    КонецЕсли;
	
	ЗаполнитьПредыдущимиЗначениямиНаСервере(Значение);

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПредыдущимиЗначениямиНаСервере(ДокументУСВ)
	
	ЗаполнитьЗначенияСвойств(Объект, ДокументУСВ, "СуммаВыработкиНеМенее, СуммаВыработкиНеБолееПроцентаОтСуммыДокумента, СтоимостьЗаДокумент"); 
	 
	Для каждого СтрокаТЧ из ДокументУСВ.ВыработкаПоВидамНоменклатуры Цикл
		СтруктураПоиска = Новый Структура("ВидНоменклатуры, Категория", СтрокаТЧ.ВидНоменклатуры, СтрокаТЧ.Категория);
		НайденныеСтроки = Объект.ВыработкаПоВидамНоменклатуры.НайтиСтроки(СтруктураПоиска);
		Если НайденныеСтроки.Количество() > 0 Тогда
			Строка = НайденныеСтроки[0]; 
		Иначе
			Строка = Объект.ВыработкаПоВидамНоменклатуры.Добавить(); 
		КонецЕсли;
		ЗаполнитьЗначенияСвойств(Строка, СтрокаТЧ);
	КонецЦикла;
	
	Для каждого СтрокаТЧ из ДокументУСВ.ВыработкаПоНоменклатуре Цикл
		СтруктураПоиска = Новый Структура("Номенклатура", СтрокаТЧ.Номенклатура);
		НайденныеСтроки = Объект.ВыработкаПоНоменклатуре.НайтиСтроки(СтруктураПоиска);
		Если НайденныеСтроки.Количество() > 0 Тогда
			Строка = НайденныеСтроки[0]; 
		Иначе
			Строка = Объект.ВыработкаПоНоменклатуре.Добавить(); 
		КонецЕсли;
		ЗаполнитьЗначенияСвойств(Строка, СтрокаТЧ);
	КонецЦикла;
	
	Для каждого СтрокаТЧ из ДокументУСВ.ВыработкаЛид Цикл
		СтруктураПоиска = Новый Структура("ВидКонтакта, ТочкаПродаж, РекламныйИсточник, РекламнаяАкция, СтатусЛида");
		ЗаполнитьЗначенияСвойств(СтруктураПоиска, СтрокаТЧ);
		НайденныеСтроки = Объект.ВыработкаЛид.НайтиСтроки(СтруктураПоиска);
		Если НайденныеСтроки.Количество() > 0 Тогда
			Строка = НайденныеСтроки[0]; 
		Иначе
			Строка = Объект.ВыработкаЛид.Добавить(); 
		КонецЕсли;
		ЗаполнитьЗначенияСвойств(Строка, СтрокаТЧ);
	КонецЦикла;
	
КонецПроцедуры

