
#Область ПеременныеФормы

&НаКлиенте
Перем ПараметрыДляЗаписи Экспорт;

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	УстановитьУсловноеОформление();
	
	ВалютаУчета = Константы.ВалютаУчета.Получить();
		
	ПраваПользователей.УстановитьТолькоПросмотрДляРеквизитаНомер(Элементы.Номер.ТолькоПросмотр);
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	// №9562
	ОпределитьВидНоменклатурыПродукции();
	
	//2019-01-18 добавлен новый элемент, заявка #3230
	Элементы.ВидСкидки.Видимость = Константы.ИспользоватьРазделениеПоВидамСкидокДляУстановкиСтоимостиВыработкиВМонтаже.Получить();
	//#6586
	Если НЕ Элементы.ВидСкидки.Видимость И ЗначениеЗаполнено(Объект.ВидСкидки) Тогда
		Элементы.ВидСкидки.Видимость = Истина;
		Элементы.ВидСкидки.ТолькоПросмотр = Истина;
	КонецЕсли;
		
	// Видимость колонки Артикул
	ОбщийМодульСервер.УстановитьВидимостьКолонкиАртикулВТабличнойЧасти(ЭтаФорма, "ВыработкаПоНоменклатуреНоменклатураАртикул");
	
	УправлениеФормойНаСервере();
	Элементы.ВыработкаПоВидамНоменклатурыСтоимостьСуммой.Заголовок = "" + ВалютаУчета + " за единицу товара";
	Элементы.ВыработкаПоНоменклатуреСтоимостьСуммой.Заголовок = "" + ВалютаУчета + " за единицу товара";
	
	ФактурностьПотолка = Неопределено;
	Если Объект.ОднофактурныйПотолок И Объект.МногофактурныйПотолок Тогда
		ФактурностьПотолка = 2;
	ИначеЕсли Объект.ОднофактурныйПотолок Тогда
		ФактурностьПотолка = 0;
	ИначеЕсли Объект.МногофактурныйПотолок Тогда
		ФактурностьПотолка = 1;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	ДатыЗапретаИзменения.ОбъектПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	// #16609
	ОбновитьПредставлениеОтклоненийОтПрайса();
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	Если НеВыполнятьПроверкуПередЗаписью Тогда
		НеВыполнятьПроверкуПередЗаписью = Ложь;
		Возврат;
	КонецЕсли;
	
	//#16609
	Для каждого СтрокаТЧ из Объект.ВыработкаПоВидамНоменклатуры Цикл
		ЗаполнитьОтклоненийОтПрайсаВСтрокеТЧПоПредставлению(СтрокаТЧ);
	КонецЦикла;
	Для каждого СтрокаТЧ из Объект.ВыработкаПоНоменклатуре Цикл
		ЗаполнитьОтклоненийОтПрайсаВСтрокеТЧПоПредставлению(СтрокаТЧ);
	КонецЦикла;
	
	// #14355
	Если ЗначениеЗаполнено(Объект.Ссылка) 
		И НЕ НачалоДня(Объект.Дата) = НачалоДня(ТекущаяДата()) Тогда
		
		ИзменяетсяСтатусПроведения = ОбщийМодульВызовСервера.ИзменяетсяСтатусПроведения(Объект, ПараметрыЗаписи.РежимЗаписи);	
		
		Если ИзменяетсяСтатусПроведения
			ИЛИ (Модифицированность
				И ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.Проведение) Тогда
			ВыполнитьПроверкиИЗадатьВопросыПередЗаписью(Отказ, ПараметрыЗаписи);
		КонецЕсли;
	КонецЕсли;

	ОбщийМодульКлиент.ЗаписатьОбъектПриНеобходимости(ЭтотОбъект, ПараметрыЗаписи, Отказ);

КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	Если Объект.ВидДокументаРасчета = Справочники.ВидыДокументовРасчетаВыработки.ВыпускПродукции 
		И Объект.ВидНоменклатурыПотолка = Справочники.ВидыНоменклатуры.Потолок Тогда
		ТекущийОбъект.ОднофактурныйПотолок  = ФактурностьПотолка = 0 ИЛИ ФактурностьПотолка = 2;
		ТекущийОбъект.МногофактурныйПотолок = ФактурностьПотолка = 1 ИЛИ ФактурностьПотолка = 2;	
	КонецЕсли;
	
	//#10991
	Если НЕ Объект.ВидИсполнителя = Справочники.ВидыИсполнителей.Менеджер Тогда
		Объект.Менеджеры.Очистить();
	КонецЕсли;
		
	//проверки перед проведением
	Если ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
		
		//проверим на задвоения - вид номенклатуры
		ВремТаблица = Новый ТаблицаЗначений;
		ВремТаблица = Объект.ВыработкаПоВидамНоменклатуры.Выгрузить();
		ВремТаблица.Колонки.Добавить("Количество");
		
		Для Каждого ТекущаяСтрока Из ВремТаблица Цикл
			ТекущаяСтрока.Количество = 1;
		КонецЦикла;
		
		// #6385
		Если Объект.ВидДокументаРасчета = Справочники.ВидыДокументовРасчетаВыработки.Монтаж 
			//++ #16579
			//И Объект.ВидДокументаОснования = Справочники.ВидыДокументовОснованийРасчетаВыработки.ЗаказДоговор
			//И ПолучитьФункциональнуюОпцию("ПриРасчетеВыработкиПоМонтажуУчитыватьПроцентОтклоненияОтПрайса")
			И Объект.УчитыватьПроцентОтклоненияОтПрайса
			//-- #16579
			Тогда
			
			//++ №14035 по монтажу появилось применение
			//ВремТаблица.Свернуть("ВидНоменклатуры, Категория, СкидкаВПроцентахОт", "Количество");
			ВремТаблица.Свернуть("ВидНоменклатуры, Категория, СкидкаВПроцентахОт, Применение", "Количество");
			//-- №14035
			
		ИначеЕсли Объект.ВидДокументаРасчета = Справочники.ВидыДокументовРасчетаВыработки.ВыпускПродукции
			Или Объект.ВидДокументаРасчета = Справочники.ВидыДокументовРасчетаВыработки.Монтаж Тогда // №14035 по монтажу появилось применение
			
			ВремТаблица.Свернуть("ВидНоменклатуры, Категория, Применение", "Количество");
			
		Иначе
			
			ВремТаблица.Свернуть("ВидНоменклатуры, Категория", "Количество");
			
		КонецЕсли;
		
		Для Каждого ТекущаяСтрока Из ВремТаблица Цикл
			Если ТекущаяСтрока.Количество > 1 Тогда
				Сообщить("В таблице выработки по видам номенклатуры задвоены записи по виду """ + ТекущаяСтрока.ВидНоменклатуры + """");
				Отказ = Истина;
			КонецЕсли;
		КонецЦикла;
		
		//проверим на задвоения - номенклатура
		ВремТаблица = Новый ТаблицаЗначений;
		ВремТаблица = Объект.ВыработкаПоНоменклатуре.Выгрузить();
		ВремТаблица.Колонки.Добавить("Количество");
		Для Каждого ТекущаяСтрока Из ВремТаблица Цикл
			ТекущаяСтрока.Количество = 1;
		КонецЦикла;
		// #6385
		Если Объект.ВидДокументаРасчета = Справочники.ВидыДокументовРасчетаВыработки.Монтаж
			//++ #16579
			//И Объект.ВидДокументаОснования = Справочники.ВидыДокументовОснованийРасчетаВыработки.ЗаказДоговор			
			//И ПолучитьФункциональнуюОпцию("ПриРасчетеВыработкиПоМонтажуУчитыватьПроцентОтклоненияОтПрайса")
			И Объект.УчитыватьПроцентОтклоненияОтПрайса
			//-- #16579
			Тогда
			ВремТаблица.Свернуть("Номенклатура, СкидкаВПроцентахОт", "Количество");
			
		ИначеЕсли Объект.ВидДокументаРасчета = Справочники.ВидыДокументовРасчетаВыработки.ВыпускПродукции Тогда
			ВремТаблица.Свернуть("Номенклатура, Применение", "Количество");
			
		Иначе
			ВремТаблица.Свернуть("Номенклатура", "Количество");
		КонецЕсли;
		Для Каждого ТекущаяСтрока Из ВремТаблица Цикл
			Если ТекущаяСтрока.Количество > 1 Тогда
				Сообщить("В таблице выработки по номенклатуре задвоены записи по """ + ТекущаяСтрока.Номенклатура + """");
				Отказ = Истина;
			КонецЕсли;
		КонецЦикла;
		
		//вид номенклатуры - в строке должно быть что-то одно - или процент или сумма
		Для Каждого ТекущаяСтрока Из Объект.ВыработкаПоВидамНоменклатуры Цикл
			Если НЕ ТекущаяСтрока.СтоимостьСуммой = 0 И (НЕ ТекущаяСтрока.СтоимостьПроцентом = 0 ИЛИ НЕ ТекущаяСтрока.СтоимостьЗаФактПрисутствия = 0) Тогда
				Сообщить("В таблице по видам номенклатуры в строке №" + СтрЗаменить(ТекущаяСтрока.НомерСтроки,Символ(160),"") + " для вида """+ТекущаяСтрока.ВидНоменклатуры+""" указана стоимость выработки и по количеству и по сумме. Необходимо оставить только один из параметров.");
				Отказ = Истина;
			КонецЕсли;
		КонецЦикла;
		
		//номенклатура - в строке должно быть что-то одно - или процент или сумма
		Для Каждого ТекущаяСтрока Из Объект.ВыработкаПоНоменклатуре Цикл
			Если НЕ ТекущаяСтрока.СтоимостьСуммой = 0 И (НЕ ТекущаяСтрока.СтоимостьПроцентом = 0 ИЛИ НЕ ТекущаяСтрока.СтоимостьЗаФактПрисутствия = 0) Тогда
				Сообщить("В таблице по номенклатуре в строке №" + СтрЗаменить(ТекущаяСтрока.НомерСтроки,Символ(160),"") + " для номенклатуры """+ТекущаяСтрока.Номенклатура+""" указана стоимость выработки и по количеству и по сумме. Необходимо оставить только один из параметров.");
				Отказ = Истина;
			КонецЕсли;
		КонецЦикла;
		
		Для Каждого ТекущаяСтрока Из Объект.ВыработкаПоВидамНоменклатуры Цикл
			Если НЕ ТекущаяСтрока.Категория.Пустая() и ТекущаяСтрока.ВидНоменклатуры.Пустая() Тогда
				Сообщить("В таблице по видам номенклатуры в строке №" + СтрЗаменить(ТекущаяСтрока.НомерСтроки,Символ(160),"") + " указана категория, но не указан вид номенклатуры. Укажите вид номенклатуры");
				Отказ = Истина;
			КонецЕсли;
		КонецЦикла;
		
		//корректность заполнения по лиду
		Если Объект.ВидДокументаРасчета = Справочники.ВидыДокументовРасчетаВыработки.Лид Тогда
			Для Каждого ТекущаяСтрока Из Объект.ВыработкаЛид Цикл
				Если ТекущаяСтрока.СтатусЛида.Пустая() Тогда
					Сообщить("В таблице по видам лидов в строке №" + СтрЗаменить(ТекущаяСтрока.НомерСтроки,Символ(160),"") + " не указан текущий статус лида");
					Отказ = Истина;
				КонецЕсли;
				Если НЕ ТекущаяСтрока.РекламнаяАкция.Пустая() И
					(ТекущаяСтрока.РекламныйИсточник.Пустая()
					ИЛИ ТекущаяСтрока.ТочкаПродаж.Пустая()
					ИЛИ ТекущаяСтрока.ВидКонтакта.Пустая()) Тогда
					Сообщить("В таблице по видам лидов в строке №" + СтрЗаменить(ТекущаяСтрока.НомерСтроки,Символ(160),"") + " заполнены не все детали лида (вид контакта, точка продаж, рекламный источник)");
					Отказ = Истина;
				ИначеЕсли НЕ ТекущаяСтрока.РекламныйИсточник.Пустая() И
					(ТекущаяСтрока.ТочкаПродаж.Пустая()
					ИЛИ ТекущаяСтрока.ВидКонтакта.Пустая()) Тогда
					Сообщить("В таблице по видам лидов в строке №" + СтрЗаменить(ТекущаяСтрока.НомерСтроки,Символ(160),"") + " заполнены не все детали лида (вид контакта, точка продаж)");
					Отказ = Истина;
				ИначеЕсли НЕ ТекущаяСтрока.ТочкаПродаж.Пустая()
					И ТекущаяСтрока.ВидКонтакта.Пустая() Тогда
					Сообщить("В таблице по видам лидов в строке №" + СтрЗаменить(ТекущаяСтрока.НомерСтроки,Символ(160),"") + " заполнены не все детали лида (вид контакта)");
					Отказ = Истина;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
		Если Объект.ВидДокументаРасчета = Справочники.ВидыДокументовРасчетаВыработки.ВыпускПродукции
			И НЕ Объект.ВидНоменклатурыПотолкаТиповоеПроизводство
			И НЕ ЗначениеЗаполнено(Объект.ВидНоменклатурыПотолка) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
				НСтр("ru = 'Не заполнено поле ""Вид номенклатуры продукции""!'"), , "ВидНоменклатурыПродукции", , Отказ);
		КонецЕсли;
			
		//#16283 
		Если Объект.ВидДокументаРасчета = Справочники.ВидыДокументовРасчетаВыработки.ВыпускПродукции
			И ВидНоменклатурыПродукции = "Продукция"
			И НЕ ЗначениеЗаполнено(Объект.ВидПродукции) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
				НСтр("ru = 'Не заполнено поле ""Вид продукции""!'"), , "Объект.ВидПродукции", , Отказ);
		КонецЕсли;
			
		
		Если Объект.ВидДокументаРасчета = Справочники.ВидыДокументовРасчетаВыработки.Монтаж Тогда
			
			// перенесено в Модуль объекта
			//	И НЕ ЗначениеЗаполнено(Объект.ВидМонтажа) Тогда
			//	ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			//		НСтр("ru = 'Не заполнен вид монтажа!'"), ТекущийОбъект,
			//		"ВидМонтажа",,Отказ);
			         			
			//#6385
			ПроверятьСкидкуВПроцентах = Объект.ВидДокументаРасчета = Справочники.ВидыДокументовРасчетаВыработки.Монтаж
			                 			//++ #16579
			                            //И Объект.ВидДокументаОснования = Справочники.ВидыДокументовОснованийРасчетаВыработки.ЗаказДоговор
										//И ПолучитьФункциональнуюОпцию("ПриРасчетеВыработкиПоМонтажуУчитыватьПроцентОтклоненияОтПрайса");
										И Объект.УчитыватьПроцентОтклоненияОтПрайса;
										//-- #16579
				
			Если ПроверятьСкидкуВПроцентах Тогда
				Для каждого СтрокаТЧ из Объект.ВыработкаПоВидамНоменклатуры Цикл
					Если СтрокаТЧ.СкидкаВПроцентахОт > СтрокаТЧ.СкидкаВПроцентахДо Тогда
						ТекстСообщения = "Неверно указан диапазон процентов скидки в строке " + СтрокаТЧ.НомерСтроки;
						ПолеОшибки = "Объект.ВыработкаПоВидамНоменклатуры[" + Формат(СтрокаТЧ.НомерСтроки-1, "ЧГ=") + "].ОтклонениеОтПрайсаОт";
						ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, , ПолеОшибки, , Отказ);
					КонецЕсли;
				КонецЦикла;
				Для каждого СтрокаТЧ из Объект.ВыработкаПоНоменклатуре Цикл
					Если СтрокаТЧ.СкидкаВПроцентахОт > СтрокаТЧ.СкидкаВПроцентахДо Тогда
						ТекстСообщения = "Неверно указан диапазон процентов скидки в строке " + СтрокаТЧ.НомерСтроки;
						ПолеОшибки = "Объект.ВыработкаПоНоменклатуре[" + Формат(СтрокаТЧ.НомерСтроки-1, "ЧГ=") + "].ОтклонениеОтПрайсаОт";
						ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, , ПолеОшибки, , Отказ);
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
		КонецЕсли;


		Если Отказ Тогда
			Сообщить("Проведение документа отменено.");
		КонецЕсли;
		
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	ОбщийМодульКлиент.ВыполнитьДействияПослеЗаписи(ЭтаФорма, Объект, ПараметрыЗаписи);
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	// #16609
	ОбновитьПредставлениеОтклоненийОтПрайса();
	
КонецПроцедуры

