&НаСервере
Процедура ВидИсполнителяПриИзмененииНаСервере()
	
	Объект.ВидНачисления = Справочники.ВидыНачислений.ПустаяСсылка();
	Если ЗначениеЗаполнено(Объект.ВидИсполнителя) Тогда
		ИмяПредопределенных = Объект.ВидИсполнителя.ИмяПредопределенныхДанных;
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ разрешенные
		|	ВидыНачислений.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ВидыНачислений КАК ВидыНачислений
		|ГДЕ
		|	ВидыНачислений.ИмяПредопределенныхДанных = &ИмяПредопределенныхДанных";
		
		Запрос.УстановитьПараметр("ИмяПредопределенныхДанных", ИмяПредопределенных);	
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Следующий() Тогда
			Объект.ВидНачисления = Выборка.Ссылка;	
		КонецЕсли; 
	КонецЕсли;	
	
	Если Объект.ВидДокументаРасчета = Справочники.ВидыДокументовРасчетаВыработки.Монтаж И объект.ВидИсполнителя = Справочники.ВидыИсполнителей.Монтажник Тогда
		Объект.СпособРаспределенияВыработкиПоМонтажникам = Перечисления.СпособыРаспределенияВыработкиПоМонтажникам.ПоКоэффициентам;
	КонецЕсли;	
		
КонецПроцедуры

