&НаКлиенте
Процедура ВыработкаПоВидамНоменклатурыПрименениеНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	//++ №14035
	СтандартнаяОбработка = Ложь;
	
	ДанныеВыбора = новый СписокЗначений;
	ДанныеВыбора.Добавить(ПредопределенноеЗначение("Перечисление.ПрименениеНоменклатурыДляВыработки.Материалы"));
	
	Если Объект.ВидДокументаРасчета = ПредопределенноеЗначение("Справочник.ВидыДокументовРасчетаВыработки.ВыпускПродукции") Тогда
		
		ДанныеВыбора.Добавить(ПредопределенноеЗначение("Перечисление.ПрименениеНоменклатурыДляВыработки.Продукция"));
		ДанныеВыбора.Добавить(ПредопределенноеЗначение("Перечисление.ПрименениеНоменклатурыДляВыработки.ПроизводственныеУслуги"));
		
	КонецЕсли;
	
	Если Объект.ВидДокументаРасчета = ПредопределенноеЗначение("Справочник.ВидыДокументовРасчетаВыработки.Монтаж") 
		//ИЛИ Объект.ВидДокументаРасчета = ПредопределенноеЗначение("Справочник.ВидыДокументовРасчетаВыработки.Продажа")
		//ИЛИ Объект.ВидДокументаРасчета = ПредопределенноеЗначение("Справочник.ВидыДокументовРасчетаВыработки.Рекламация")	
		//ИЛИ Объект.ВидДокументаРасчета = ПредопределенноеЗначение("Справочник.ВидыДокументовРасчетаВыработки.СервиснаяЗаявка")
		Тогда
		
		ДанныеВыбора.Добавить(ПредопределенноеЗначение("Перечисление.ПрименениеНоменклатурыДляВыработки.ТоварыИУслуги"));
		
	КонецЕсли;
	//-- №14035
	
КонецПроцедуры

