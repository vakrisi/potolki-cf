&НаСервере
Процедура ДобавитьВсеВидыНаСервере()
	
	СписокДействующихВидов = Справочники.ВидыНоменклатуры.СписокДействующихВидов();
	Для каждого Вид из СписокДействующихВидов Цикл	
		// Нужно проверить наличие в таблице, чтобы не добавить дубль
		Если Объект.ВыработкаПоВидамНоменклатуры.НайтиСтроки(Новый Структура("ВидНоменклатуры", Вид.Значение)).Количество() > 0 Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока = Объект.ВыработкаПоВидамНоменклатуры.Добавить();
		НоваяСтрока.ВидНоменклатуры = Вид.Значение;		
	КонецЦикла;

КонецПроцедуры

