&НаСервере
Функция ЗаполнитьВопросыПоВидуОпроса(Объект) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ВидыОбзвоновКлиентовСоставОпроса.Вопрос
		|ИЗ
		|	Справочник.ВидыОбзвоновКлиентов.СоставОпроса КАК ВидыОбзвоновКлиентовСоставОпроса
		|ГДЕ
		|	ВидыОбзвоновКлиентовСоставОпроса.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", Объект.ВидОпроса);	
	РезультатЗапроса = Запрос.Выполнить();	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		НовыйВопрос = Объект.Вопросы.Добавить();
		НовыйВопрос.Вопрос = Выборка.Вопрос;
	КонецЦикла;
КонецФункции
