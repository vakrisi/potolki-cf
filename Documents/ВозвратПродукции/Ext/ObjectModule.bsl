Процедура ЗаполнитьПоЗаказуНаПроизводство(ДокументОснование, МассивТоваров = Неопределено)
	
	Документы.ЗаказНаПроизводство.ПроверитьВозможностьВводаНаОснованииЗаказа(ДокументОснование);
	
	Если НЕ ДокументОснование.ВидЗаказа = Перечисления.ВидыЗаказовНаПроизводство.ПроизводствоПотолка Тогда
		Возврат;
	КонецЕсли;
	
	Основание 			= ДокументОснование;
	Организация 		= ДокументОснование.Организация;
	Подразделение 		= ДокументОснование.Подразделение;
	Контрагент 			= ДокументОснование.Контрагент;
	ДоговорКонтрагента 	= ДокументОснование.ДоговорКонтрагента;
	Валюта 				= ДокументОснование.Валюта;
	Склад 				= ДокументОснование.Склад;
	
	//потолок
	НоваяСтрока = Товары.Добавить();
	НоваяСтрока.Номенклатура 	= ДокументОснование.ПродукцияНоменклатура;
	НоваяСтрока.Количество 		= ДокументОснование.ПродукцияНоменклатураКоличество;
	НоваяСтрока.ЕдиницаИзмерения = ДокументОснование.ПродукцияНоменклатураЕдиницаИзмерения;
	НоваяСтрока.Коэффициент 	= ДокументОснование.ПродукцияНоменклатураКоэффициент;
	НоваяСтрока.Цена 			= ДокументОснование.ПродукцияЦена;
	НоваяСтрока.Сумма 			= ДокументОснование.ПродукцияСумма;
	//#15395 
	//НоваяСтрока.ВариантОпределенияСебестоимости = Перечисления.ВариантыОпределенияСебестоимостиПоВозвратам.РучноеУказание; // #15628 закомментировано
	
	ОснованиеЗаказПокупаетля = Документы.ЗаказПокупателя.ПустаяСсылка();
	Если ДокументОснование.ДокументОснование <> Неопределено 
		И ТипЗнч(ДокументОснование.ДокументОснование) = Тип("ДокументСсылка.ЗаказПокупателя")
		И НЕ ДокументОснование.ДокументОснование.Пустая() 
	Тогда
		ОснованиеЗаказПокупаетля = ДокументОснование.ДокументОснование;
	КонецЕсли;
	
	НоваяСтрока.ЗаказПокупателя = ОснованиеЗаказПокупаетля;
	
	//услуги потолка
	Для каждого СтрокаУслуги Из ДокументОснование.Услуги Цикл
		НоваяСтрока = Товары.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаУслуги);
		НоваяСтрока.ЗаказПокупателя = ОснованиеЗаказПокупаетля;
	КонецЦикла;

КонецПроцедуры

Процедура ЗаполнитьПоВыпуску(ДокументОснование)
	
	Основание 			= ДокументОснование;
	Организация 		= ДокументОснование.Организация;
	Подразделение 		= ДокументОснование.Подразделение;
	Склад  				= ДокументОснование.СкладПродукции;
	
	НоваяСтрока = Товары.Добавить();
	НоваяСтрока.Номенклатура = ДокументОснование.ПродукцияНоменклатура;
	НоваяСтрока.Количество = ДокументОснование.ПродукцияНоменклатураКоличество;
	НоваяСтрока.ЕдиницаИзмерения = ДокументОснование.ПродукцияНоменклатураЕдиницаИзмерения;
	НоваяСтрока.Коэффициент = ДокументОснование.ПродукцияНоменклатураКоэффициент;
	НоваяСтрока.Цена = ДокументОснование.Основание.ПродукцияЦена;
	НоваяСтрока.Сумма = ДокументОснование.Основание.ПродукцияСумма;
	//#15395 
	//НоваяСтрока.ВариантОпределенияСебестоимости = Перечисления.ВариантыОпределенияСебестоимостиПоВозвратам.РучноеУказание; // #15628 закомментировано
	
	ОснованиеЗаказПокупателя = Документы.ЗаказПокупателя.ПустаяСсылка();
	Если ДокументОснование.Основание <> Неопределено И НЕ ДокументОснование.Основание.Пустая() Тогда
		Если ДокументОснование.Основание.ДокументОснование <> Неопределено 
			И ТипЗнч(ДокументОснование.Основание.ДокументОснование) = Тип("ДокументСсылка.ЗаказПокупателя")
			И НЕ ДокументОснование.Основание.ДокументОснование.Пустая() 
			Тогда
			ОснованиеЗаказПокупателя = ДокументОснование.Основание.ДокументОснование;
		КонецЕсли;
	КонецЕсли;
	
	НоваяСтрока.ЗаказПокупателя = ОснованиеЗаказПокупателя;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыФункции

Функция ПолучитьСуммуЗачета() Экспорт
	
	Если УменьшитьДолгКонтрагента Тогда
		СуммаЗачета = СуммаДокумента;
	Иначе
		СуммаЗачета = 0;
	КонецЕсли;
	
	Возврат СуммаЗачета;
	
КонецФункции

Функция ПолучитьТаблицуПродажПоЗаказу(ЗаказПокупателя, ДокументСсылка = Неопределено)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ПродажиОбороты.Номенклатура КАК Номенклатура,
	|	ПродажиОбороты.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	|	ПродажиОбороты.СерияНоменклатуры КАК СерияНоменклатуры,
	|	ПродажиОбороты.ДокументПродажи КАК ДокументПродажи,
	|	ПродажиОбороты.ЗаказПокупателя КАК ЗаказПокупателя,
	|	СУММА(ПродажиОбороты.КоличествоОборот) КАК Количество
	|ПОМЕСТИТЬ ВТ
	|ИЗ
	|	РегистрНакопления.Продажи.Обороты(, , Регистратор, ) КАК ПродажиОбороты
	|ГДЕ
	|	ПродажиОбороты.Регистратор <> &Регистратор
	|	И ПродажиОбороты.ЗаказПокупателя = &ЗаказПокупателя
	|
	|СГРУППИРОВАТЬ ПО
	|	ПродажиОбороты.Номенклатура,
	|	ПродажиОбороты.ХарактеристикаНоменклатуры,
	|	ПродажиОбороты.СерияНоменклатуры,
	|	ПродажиОбороты.ДокументПродажи,
	|	ПродажиОбороты.ЗаказПокупателя
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ.Номенклатура КАК Номенклатура,
	|	ВТ.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	|	ВТ.СерияНоменклатуры КАК СерияНоменклатуры,
	|	ВТ.ДокументПродажи КАК ДокументПродажи,
	|	ВТ.ЗаказПокупателя КАК ЗаказПокупателя,
	|	ВТ.Количество КАК Количество
	|ИЗ
	|	ВТ КАК ВТ
	|ГДЕ
	|	ВТ.Количество > 0";
	
	Запрос.УстановитьПараметр("Регистратор", ДокументСсылка);
	Запрос.УстановитьПараметр("ЗаказПокупателя", ЗаказПокупателя);
	ТаблицаПродаж = Запрос.Выполнить().Выгрузить();
	
	Возврат ТаблицаПродаж;
	
КонецФункции

Функция НайтиДокументПродажиПоДаннымТабличнойСтроки(ТаблицаПродаж, СтрокаТабличнойЧасти, ЗаказПокупателя)
	
	СтруктураПоиска = Новый Структура;
	СтруктураПоиска.Вставить("Номенклатура", 				 СтрокаТабличнойЧасти.Номенклатура);
	СтруктураПоиска.Вставить("ХарактеристикаНоменклатуры", СтрокаТабличнойЧасти.ХарактеристикаНоменклатуры);
	СтруктураПоиска.Вставить("СерияНоменклатуры", 		 СтрокаТабличнойЧасти.СерияНоменклатуры);
	СтруктураПоиска.Вставить("ЗаказПокупателя", 				 ЗаказПокупателя);
	
	НайденныеСтроки = ТаблицаПродаж.НайтиСтроки(СтруктураПоиска);
	Если НайденныеСтроки.Количество() > 0 Тогда
		Возврат НайденныеСтроки[0].ДокументПродажи;
	КонецЕсли;
	
	Возврат Документы.РеализацияТоваровИУслуг.ПустаяСсылка();
	
КонецФункции	
	
#КонецОбласти

#КонецЕсли

