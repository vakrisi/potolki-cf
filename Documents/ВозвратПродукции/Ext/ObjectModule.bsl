#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
	
#Область ОбработчикиСобытий

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	
	Если ЭтоНовый() Тогда		
		ИнициализироватьСлужебныеРеквизиты();		
	КонецЕсли;
	
	ОбщийМодуль.ЗаполнитьШапкуДокумента(ЭтотОбъект);
		
	ТипДанныхЗаполнения = ТипЗнч(ДанныеЗаполнения);
	
	Если ТипДанныхЗаполнения = Тип("Структура") Тогда
		ДокументОснование = Неопределено;
		МассивТоваров = Неопределено;
		Если ДанныеЗаполнения.Свойство("ДокументОснование", ДокументОснование) И 
			ДанныеЗаполнения.Свойство("МассивТоваров", МассивТоваров) Тогда
			
			Если ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.ЗаказПокупателя") Тогда
				ЗаполнитьПоЗаказуПокупателя(ДокументОснование, МассивТоваров);
				
			ИначеЕсли ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.РеализацияТоваровИУслуг") Тогда
				ЗаполнитьПоРеализации(ДокументОснование, МассивТоваров);	
	
			КонецЕсли;
			
		КонецЕсли;
		
	ИначеЕсли ТипДанныхЗаполнения = Тип("ДокументСсылка.ЗаказПокупателя") Тогда
		ЗаполнитьПоЗаказуПокупателя(ДанныеЗаполнения);
		
	ИначеЕсли ТипДанныхЗаполнения = Тип("ДокументСсылка.РеализацияТоваровИУслуг") Тогда
		ЗаполнитьПоРеализации(ДанныеЗаполнения);
		
	ИначеЕсли ТипДанныхЗаполнения = Тип("ДокументСсылка.ЗаказНаПроизводство") Тогда
		ЗаполнитьПоЗаказуНаПроизводство(ДанныеЗаполнения);
		
	ИначеЕсли ТипДанныхЗаполнения = Тип("ДокументСсылка.ВыпускПродукции") Тогда
		ЗаполнитьПоВыпуску(ДанныеЗаполнения);
			
	КонецЕсли;
	
	СтатьяРасходов = ФинансыСервер.ПолучитьСтатьюДоходовРасходов(ЭтотОбъект, "Расход", Ложь);
	СтатьяДоходов  = ФинансыСервер.ПолучитьСтатьюДоходовРасходов(ЭтотОбъект, "Доход");
	
	Если ЭтоНовый() Тогда
		ДозаполнитьПоУмолчанию();
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	
	ИнициализироватьСлужебныеРеквизиты(); 
	
	ДозаполнитьПоУмолчанию();
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	// №5441
	Если НЕ ПриходоватьТоварНаСклад Тогда
		Если ПроверяемыеРеквизиты.Найти("Склад") <> Неопределено Тогда
			ПроверяемыеРеквизиты.Удалить(ПроверяемыеРеквизиты.Найти("Склад"));
		КонецЕсли;
	КонецЕсли;
	
	//проверки
	Если БракПроизводства И Ответственные.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не заполнена таблица ответственных", ЭтотОбъект, "Ответственные[0]", ,Отказ);
	КонецЕсли;
	
	//#15395 
	Если ТекущийСтатусВозврата = Справочники.СтатусыВозвратаПродукции.Проверено Тогда
		Для каждого СтрокаТабличнойЧасти из Товары Цикл
			
			Если ПриходоватьТоварНаСклад И НЕ ЗначениеЗаполнено(СтрокаТабличнойЧасти.ВариантОпределенияСебестоимости)
				Тогда
				ТекстСообщения = "В строке " + СтрокаТабличнойЧасти.НомерСтроки + " не указан вариант определения себестоимости!";
				ПолеДанных = "Товары[" + Строка(СтрокаТабличнойЧасти.НомерСтроки-1) + "].ВариантОпределенияСебестоимости";
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, ЭтотОбъект, ПолеДанных, ,Отказ);
			КонецЕсли;
			
			Если ПриходоватьТоварНаСклад И СтрокаТабличнойЧасти.ВариантОпределенияСебестоимости = Перечисления.ВариантыОпределенияСебестоимостиПоВозвратам.ПоДокументуПродажи
				И НЕ ЗначениеЗаполнено(СтрокаТабличнойЧасти.ДокументПродажи) Тогда
				ТекстСообщения = "В строке " + СтрокаТабличнойЧасти.НомерСтроки + " не указан документ продажи при варианте определения себестоимости по документу продажи!";
				ПолеДанных = "Товары[" + Строка(СтрокаТабличнойЧасти.НомерСтроки-1) + "].ДокументПродажи";
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, ЭтотОбъект, ПолеДанных, ,Отказ);
			КонецЕсли;
			
			Если БракПроизводства И НЕ ЗначениеЗаполнено(СтрокаТабличнойЧасти.ВариантОпределенияОтветственности)
				Тогда
				ТекстСообщения = "В строке " + СтрокаТабличнойЧасти.НомерСтроки + " не указан вариант определения ответственности!";
				ПолеДанных = "Товары[" + Строка(СтрокаТабличнойЧасти.НомерСтроки-1) + "].ВариантОпределенияОтветственности";
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, ЭтотОбъект, ПолеДанных, ,Отказ);
			КонецЕсли;
			
			Если БракПроизводства И СтрокаТабличнойЧасти.ВариантОпределенияОтветственности = Перечисления.ВариантыОпределенияОтветственностиПоВозвратам.ПоСебестоимости
				И НЕ ЗначениеЗаполнено(СтрокаТабличнойЧасти.ДокументПродажи)
				Тогда
				ТекстСообщения = "В строке " + СтрокаТабличнойЧасти.НомерСтроки + " не указан документ продажи при варианте определения ответственности по себестоимости документа продажи!";
				ПолеДанных = "Товары[" + Строка(СтрокаТабличнойЧасти.НомерСтроки-1) + "].ДокументПродажи";
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, ЭтотОбъект, ПолеДанных, ,Отказ);
			КонецЕсли;
			
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	// #15628 очистка полей
	Для каждого СтрокаТЧ из Товары Цикл		
		Если НЕ БракПроизводства Тогда 
			СтрокаТЧ.ВариантОпределенияОтветственности = Перечисления.ВариантыОпределенияОтветственностиПоВозвратам.ПустаяСсылка();
			СтрокаТЧ.Ответственность = 0;
		КонецЕсли;
		
		Если НЕ ПриходоватьТоварНаСклад Тогда
			СтрокаТЧ.ВариантОпределенияСебестоимости = Перечисления.ВариантыОпределенияСебестоимостиПоВозвратам.ПустаяСсылка();
			СтрокаТЧ.Себестоимость = 0; 
		КонецЕсли;		
	КонецЦикла;
		
	Если НЕ РольДоступна("ПолныеПрава") 
		И НЕ РольДоступна("АдминистраторСистемы")
		И НЕ ОбщийМодульСервер.НастройкаПользователя("РазрешеноРедактироватьВозвратыПродукцииВСтатусеПроверен")
		И ТекущийСтатусВозврата = Справочники.СтатусыВозвратаПродукции.Проверено
		И ТекущийСтатусВозврата = Ссылка.ТекущийСтатусВозврата Тогда
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Отсутствует право на изменение документа в статусе ""Проверено""",,,,Отказ);
	КонецЕсли;	
	
	//#15395
	СуммаАванса = ПолучитьСуммуЗачета();
	
	//#13710
	ОбщийМодульСервер.ПроверитьИзменениеВзаиморасчетовПередЗаписью(ЭтотОбъект, РежимЗаписи);
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, Режим)
	
	Если НЕ ТекущийСтатусВозврата = Справочники.СтатусыВозвратаПродукции.Проверено Тогда
		Возврат;
	КонецЕсли;
	
	ВалютаУчета = ПолучитьФункциональнуюОпцию("ВалютаУчета");
	
	// регистр ТоварыНаСкладах
	Если ПриходоватьТоварНаСклад Тогда
		
		ОрганизацияТоваров = Организация;
		Если Константы.ОбщиеСклады.Получить() Тогда
			ОрганизацияТоваров = Справочники.Организации.ПустаяСсылка();
		КонецЕсли;
		
		МассивДокументовПродажи = Товары.ВыгрузитьКолонку("ДокументПродажи");
		ТаблицаСебестоимости = ОбщийМодульСервер.ТаблицаСебестоимостиПродаж(МассивДокументовПродажи);
		
		Движения.ТоварыНаСкладах.Записывать = Истина;
		Для Каждого Товар Из Товары Цикл
			Если Справочники.ВидыНоменклатуры.ЭтоНоменклатураУслуга(Товар.Номенклатура) Тогда 
				Продолжить;
			КонецЕсли;
			
			Приход = Движения.ТоварыНаСкладах.Добавить();
			Приход.ВидДвижения = ВидДвиженияНакопления.Приход;
			Приход.Период = Дата;
			Приход.Организация = ОрганизацияТоваров;
			Приход.Склад = Склад;
			Приход.Номенклатура = Товар.Номенклатура;
			Приход.ХарактеристикаНоменклатуры = Товар.ХарактеристикаНоменклатуры;
			Приход.СерияНоменклатуры = Товар.СерияНоменклатуры;
			Приход.Количество = Товар.Количество * Товар.Коэффициент;
			
			//#15395 изменено
			//Приход.Сумма = РаботаСВалютой.ПолучитьСуммуВВалютеУчетаПоДокументу(Ссылка, Товар.Сумма);
			//Приход.СуммаВал = РаботаСВалютой.ПолучитьСуммуВДопВалютеУчетаПоДокументу(Ссылка, Товар.Сумма); 
						
			Если Товар.ВариантОпределенияСебестоимости = Перечисления.ВариантыОпределенияСебестоимостиПоВозвратам.ПоДокументуПродажи Тогда
				Если ТаблицаСебестоимости.Количество() > 0 Тогда
					Отбор = Новый Структура;
					Отбор.Вставить("Номенклатура", 				 Товар.Номенклатура);
					Отбор.Вставить("ХарактеристикаНоменклатуры", Товар.ХарактеристикаНоменклатуры);
					Отбор.Вставить("СерияНоменклатуры", 		 Товар.СерияНоменклатуры);
					Отбор.Вставить("Регистратор", 				 Товар.ДокументПродажи);
					
					НайденныеСтроки = ТаблицаСебестоимости.НайтиСтроки(Отбор);
					Если НайденныеСтроки.Количество() > 0 Тогда
						//Приход.Сумма = НайденныеСтроки[0].Сумма;
						//Приход.СуммаВал = НайденныеСтроки[0].СуммаВал;
						Приход.Сумма = НайденныеСтроки[0].Цена * Приход.Количество;
						Приход.СуммаВал = НайденныеСтроки[0].ЦенаВал * Приход.Количество;
					Иначе
						Приход.Сумма = 0;
						Приход.СуммаВал = 0;
					КонецЕсли;
				Иначе
					Приход.Сумма = 0;
					Приход.СуммаВал = 0;
				КонецЕсли;
			Иначе
				Приход.Сумма = РаботаСВалютой.ПолучитьСуммуВВалютеУчетаПоДокументу(Ссылка, Товар.Себестоимость);
				Приход.СуммаВал = РаботаСВалютой.ПолучитьСуммуВДопВалютеУчетаПоДокументу(Ссылка, Товар.Себестоимость);		
			КонецЕсли;
			
		КонецЦикла;
	КонецЕсли;
	
	Если УменьшитьДолгКонтрагента Тогда

		ВремСуммаДокумента = 0;
		ВремСуммаДокумента = Товары.Итог("Сумма");
		Если НЕ Движения.ВзаиморасчетыСКонтрагентами.ВыполнитьРасход(Ссылка, Организация, Контрагент, ДоговорКонтрагента, ВремСуммаДокумента) Тогда
			Отказ = Истина;
			Возврат;
		КонецЕсли;
		
		// регистр Взаиморасчеты с контрагентами в валюте
		Движения.ВзаиморасчетыСКонтрагентамиВВалюте.Записывать = Истина;
		Движение = Движения.ВзаиморасчетыСКонтрагентамиВВалюте.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
		Движение.Период = Дата;
		Движение.Организация = Организация;
		Движение.Контрагент = Контрагент;
		Движение.Договор = ДоговорКонтрагента;
		Движение.Валюта = Валюта;
		Движение.Сумма = СуммаДокумента;
		
		//#15395 
		// регистр РасчетыПоЗаказам 
		СписокВидовДокументовПоКоторымВедутсяРасчеты = ОбщийМодуль.ПолучитьМассивТиповДокументовПоКоторымВедутсяРасчетыПоЗаказам();
		Движения.РасчетыПоЗаказам.Записывать = Истина;
		Для Каждого ТекущаяСтрока Из ЗачетАванса Цикл
			Если ТекущаяСтрока.Сумма = 0 Тогда
				Продолжить;
			КонецЕсли;
			
			НайденныйВидДокумента = СписокВидовДокументовПоКоторымВедутсяРасчеты.Найти(ТипЗнч(ТекущаяСтрока.Документ));
			Если НайденныйВидДокумента = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			Движение = Движения.РасчетыПоЗаказам.Добавить();
			Движение.Период = Дата;
			Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
			Движение.Заказ = ТекущаяСтрока.Документ;
			Движение.Контрагент = Контрагент;
			Если ТекущаяСтрока.Документ.Валюта = Валюта ИЛИ ТекущаяСтрока.СуммаВВалютеДокумента = 0 Тогда 
				Движение.Сумма = ТекущаяСтрока.Сумма;
			Иначе
				Движение.Сумма = ТекущаяСтрока.СуммаВВалютеДокумента; 
			КонецЕсли; 
							
		КонецЦикла;
		
	КонецЕсли;
	
	// регистр ВыработкаИсполнителейПроизводства
	Если БракПроизводства Тогда		
		//++ №14187 выработка по ТЧ
		Движения.ВыработкаИсполнителейПроизводства.Записывать = Истина;
		
		Если РучнаяКорректировкаВыработки Тогда
			ТаблицаВыработки = Выработка;
		Иначе
			ТаблицаВыработки = Документы.ВозвратПродукции.ПолучитьТаблицуВыработки(ЭтотОбъект);
		КонецЕсли;
		
		Для Каждого СтрокаВыработки Из ТаблицаВыработки Цикл
			
			Движение = Движения.ВыработкаИсполнителейПроизводства.Добавить();
			ЗаполнитьЗначенияСвойств(Движение, СтрокаВыработки, "Сотрудник, Номенклатура, ЕдиницаИзмерения");
			
			Движение.Количество = -СтрокаВыработки.Количество;
			Движение.Цена = -СтрокаВыработки.Цена;
			Движение.Стоимость = -СтрокаВыработки.Стоимость;
			
			Движение.Период = Дата;
			Движение.ВидНачисления = Справочники.ВидыНачислений.ШтрафЗаБрак;
			Движение.Подразделение = Подразделение;
			Движение.ОбъектВыработки = Ссылка;
			
		КонецЦикла;
		//-- №14187		
	КонецЕсли;
	
	// регистр Продажи
	Движения.Продажи.Записывать = Истина;
	Для Каждого ТекущаяСтрока Из Товары Цикл
		Движение = Движения.Продажи.Добавить();
		Движение.Период = Дата;
		Движение.Организация = Организация;
		Движение.Подразделение = Подразделение;
		Движение.Склад = Склад;  //#12367
		Движение.ДоговорКонтрагента = ДоговорКонтрагента;
		Движение.ДокументПродажи = ?(ЗначениеЗаполнено(ТекущаяСтрока.ДокументПродажи), ТекущаяСтрока.ДокументПродажи, Основание);
		Движение.ЗаказПокупателя = ТекущаяСтрока.ЗаказПокупателя;
		Движение.Контрагент = Контрагент;
		Движение.Номенклатура = ТекущаяСтрока.Номенклатура;
		Движение.ХарактеристикаНоменклатуры = ТекущаяСтрока.ХарактеристикаНоменклатуры;
		Движение.СерияНоменклатуры = ТекущаяСтрока.СерияНоменклатуры;
		Движение.ЕдиницаИзмерения = ТекущаяСтрока.ЕдиницаИзмерения;         //#14300
		Движение.КоличествоВЕдиницахДокумента = -ТекущаяСтрока.Количество;	//#14300
		Движение.Количество = -ТекущаяСтрока.Количество * ТекущаяСтрока.Коэффициент;
		Движение.Сумма = -РаботаСВалютой.ПересчитатьИзВалютыВВалюту(Валюта, ВалютаУчета, Дата, ТекущаяСтрока.Сумма);
		Движение.СуммаВал = -РаботаСВалютой.ПолучитьСуммуВДопВалютеУчетаПоДокументу(Ссылка, ТекущаяСтрока.Сумма); //#8288
		
		Если ЗначениеЗаполнено(Движение.ЗаказПокупателя) Тогда
			//Движение.АдресМонтажа = Движение.ЗаказПокупателя.АдресМонтажа;
			Движение.ПодразделениеЗаказа = Движение.ЗаказПокупателя.Подразделение;		
		КонецЕсли;		
	КонецЦикла;
	
	// регистр БонусыКонтрагентов
	Если СлужебныйВидБонуснойСистемы = Перечисления.ВидыБонусныхСистем.Внутренняя 
		И СуммаБонусовКНачислениюПоДисконтнойКарте > 0 
		И ((СлужебныйУчетБонусовПоДисконтнымКартам И НЕ ДисконтнаяКарта.Пустая())
		    ИЛИ НЕ СлужебныйУчетБонусовПоДисконтнымКартам) Тогда
		
		Движения.БонусыКонтрагентов.Записывать = Истина;

		Движение = Движения.БонусыКонтрагентов.Добавить();
		Движение.Период = Дата;
		Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
		Движение.ДисконтнаяКарта = ?(СлужебныйУчетБонусовПоДисконтнымКартам, ДисконтнаяКарта, Справочники.ДисконтныеКарты.ПустаяСсылка());
		Движение.Контрагент = Контрагент;
		Движение.Сумма = -СуммаБонусовКНачислениюПоДисконтнойКарте;
		
	КонецЕсли;
	
	// регистр ДоходыРасходы
	Если ПараметрыСеанса.ФинРезультатИспользоватьВедениеУчетаДоходовРасходов 
		И ПараметрыСеанса.ФинРезультатНеКассовыйМетодВеденияУчетаДоходовРасходов
		И НЕ БракПроизводства // №10680 галочка "Назначить ответсвенных за брак" не должна формировать движений по доходам и расходам
	Тогда
			
		Метод = Перечисления.МетодыВеденияУчетаДоходовРасходов.Некассовый;
		Движения.ДоходыРасходы.Записывать = Истина;
		
		Если НЕ СтатьяДоходов.Пустая() И ПриходоватьТоварНаСклад И НЕ БракПроизводства Тогда								
			Движение = Движения.ДоходыРасходы.Добавить();
			Движение.Период 		= Дата;
			Движение.Организация 	= Организация;
			Движение.Подразделение 	= Подразделение;
			Движение.Статья 		= СтатьяДоходов;
			Движение.Метод		 	= Метод;
			Движение.СуммаДоходов 	= РаботаСВалютой.ПолучитьСуммуВВалютеУчетаПоДокументу(Ссылка, СуммаДокумента);
			Движение.СуммаРасходов 	= 0;
		КонецЕсли;
		
		Если НЕ СтатьяРасходов.Пустая() И НЕ ПриходоватьТоварНаСклад И БракПроизводства Тогда								
			Движение = Движения.ДоходыРасходы.Добавить();
			Движение.Период 		= Дата;
			Движение.Организация 	= Организация;
			Движение.Подразделение 	= Подразделение;
			Движение.Статья 		= СтатьяРасходов;
			Движение.Метод		 	= Метод;
			Движение.СуммаДоходов 	= 0;
			Движение.СуммаРасходов 	= РаботаСВалютой.ПолучитьСуммуВВалютеУчетаПоДокументу(Ссылка, СуммаДокумента);
		КонецЕсли;
		
		Если НЕ СтатьяРасходов.Пустая() И УменьшитьДолгКонтрагента Тогда								
			Движение = Движения.ДоходыРасходы.Добавить();
			Движение.Период 		= Дата;
			Движение.Организация 	= Организация;
			Движение.Подразделение 	= Подразделение;
			Движение.Статья 		= СтатьяРасходов;
			Движение.Метод		 	= Метод;
			Движение.СуммаДоходов 	= 0;
			Движение.СуммаРасходов 	= РаботаСВалютой.ПолучитьСуммуВВалютеУчетаПоДокументу(Ссылка, СуммаДокумента);
		КонецЕсли;
			
	КонецЕсли;
	
	//++ №8749
	
	//#12822 закомментировано: Документ никогда не должен делать движений по регистру "Заказы покупателей"
