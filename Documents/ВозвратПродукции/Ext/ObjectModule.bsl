Процедура ЗаполнитьПоЗаказуПокупателя(ДокументОснование, МассивТоваров = Неопределено)
	
	Документы.ЗаказПокупателя.ПроверитьВозможностьВводаНаОснованииЗаказа(ДокументОснование);

	Основание 			= ДокументОснование;
	Организация 		= ДокументОснование.Организация;
	Подразделение 		= ДокументОснование.Подразделение;
	Контрагент 			= ДокументОснование.Контрагент;
	ДоговорКонтрагента 	= ДокументОснование.ДоговорКонтрагента;
	Валюта 				= ДокументОснование.Валюта;
	Склад 				= ДокументОснование.Склад;
	
	ТаблицаПродаж = ПолучитьТаблицуПродажПоЗаказу(ДокументОснование, ЭтотОбъект.Ссылка);
	
	Если НЕ МассивТоваров = Неопределено Тогда
		Для Каждого ТекущаяСтрока Из МассивТоваров Цикл
			НоваяСтрока = Товары.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущаяСтрока);
			//НоваяСтрока.ЗаказПокупателя = ДокументОснование;
			//#15395 
			//НоваяСтрока.ВариантОпределенияСебестоимости = Перечисления.ВариантыОпределенияСебестоимостиПоВозвратам.ПоДокументуПродажи; // #15628 закомментировано
			НоваяСтрока.ДокументПродажи = НайтиДокументПродажиПоДаннымТабличнойСтроки(ТаблицаПродаж, НоваяСтрока, ДокументОснование);
		КонецЦикла;
	Иначе
		Для Каждого ТекущаяСтрока Из ДокументОснование.Товары Цикл
			Если Справочники.ВидыНоменклатуры.ЭтоНоменклатураПотолкаИлиОтреза(ТекущаяСтрока.Номенклатура) Тогда
				//потолок
				НоваяСтрока = Товары.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущаяСтрока);
				НоваяСтрока.ЗаказПокупателя = ДокументОснование;
				//#15395 
				//НоваяСтрока.ВариантОпределенияСебестоимости = Перечисления.ВариантыОпределенияСебестоимостиПоВозвратам.ПоДокументуПродажи; // #15628 закомментировано
	            НоваяСтрока.ДокументПродажи = НайтиДокументПродажиПоДаннымТабличнойСтроки(ТаблицаПродаж, НоваяСтрока, ДокументОснование);
				
				//услуги потолка
				Для каждого СтрокаУслуги Из ДокументОснование.Товары Цикл
					ЭтоУслуга = Справочники.ВидыНоменклатуры.ЭтоНоменклатураУслуга(СтрокаУслуги.Номенклатура);
					Если ЭтоУслуга и СтрокаУслуги.Потолок = ТекущаяСтрока.Номенклатура Тогда
						НоваяСтрока = Товары.Добавить();
						ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаУслуги);
						НоваяСтрока.ЗаказПокупателя = ДокументОснование;
						//#15395 
						//НоваяСтрока.ВариантОпределенияСебестоимости = Перечисления.ВариантыОпределенияСебестоимостиПоВозвратам.ПоДокументуПродажи; // #15628 закомментировано
						НоваяСтрока.ДокументПродажи = НайтиДокументПродажиПоДаннымТабличнойСтроки(ТаблицаПродаж, НоваяСтрока, ДокументОснование);
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

Процедура ЗаполнитьПоРеализации(ДокументОснование, МассивТоваров = Неопределено)
	
	Основание 			= ДокументОснование;
	Организация 		= ДокументОснование.Организация;
	Подразделение 		= ДокументОснование.Подразделение;
