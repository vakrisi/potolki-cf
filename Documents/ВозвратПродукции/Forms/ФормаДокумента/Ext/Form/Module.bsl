&НаСервере
Процедура ЗаполнитьОтветственныхПоВыпускуНаСервере()
	
	//переберем все указанные товары\продукция и по выработке найдем ответственных
	ТаблицаОтветственных = Новый ТаблицаЗначений;
	ТаблицаОтветственных.Колонки.Добавить("Сотрудник");
	ТаблицаОтветственных.Колонки.Добавить("Коэффициент");
	Для Каждого ТекущаяСтрока Из Объект.Товары Цикл
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТоварыНаСкладахОбороты.Регистратор
		|ИЗ
		|	РегистрНакопления.ТоварыНаСкладах.Обороты(, , Регистратор, Номенклатура = &Номенклатура) КАК ТоварыНаСкладахОбороты
		|ГДЕ
		|	ТоварыНаСкладахОбороты.Регистратор ССЫЛКА Документ.ВыпускПродукции
		|	И ТоварыНаСкладахОбороты.КоличествоПриход > 0";
		Запрос.УстановитьПараметр("Номенклатура",ТекущаяСтрока.Номенклатура);
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			СсылкаНаДокумент = Выборка.Регистратор;
			Для Каждого ТекущаяСтрока Из СсылкаНаДокумент.Исполнители Цикл
				НоваяСтрока = ТаблицаОтветственных.Добавить();
				НоваяСтрока.Сотрудник = ТекущаяСтрока.Сотрудник;
				НоваяСтрока.Коэффициент = ТекущаяСтрока.Коэффициент;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	
	ТаблицаОтветственных.Свернуть("Сотрудник","Коэффициент");
	Объект.Ответственные.Очистить();
	Для Каждого ТекущаяСтрока Из ТаблицаОтветственных Цикл
		НоваяСтрока = Объект.Ответственные.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущаяСтрока);
	КонецЦикла;
	
КонецПроцедуры

