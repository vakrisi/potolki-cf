Процедура ПриОткрытии(Отказ)
	ОбновитьДанныеДокумента();
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	//++ №14187
	Если НЕ Объект.РучнаяКорректировкаВыработки Тогда
		Объект.Выработка.Очистить();
	КонецЕсли;
	//-- №14187
	
	Если НЕ Объект.УменьшитьДолгКонтрагента Тогда
		Объект.ЗачетАванса.Очистить();	
	КонецЕсли;
	
	//#13359 перенесено в ПослеЗаписи
	//Если НЕ Отказ 
	//	И ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.Проведение 
	//	И UDS_ОбщийМодульВызовСервера.ИспользуетсяUDS() Тогда
	//	UDS_ОбщийМодульКлиент.ПередатьВозврат(Объект, Отказ);
	//КонецЕсли;
	
	Если НеВыполнятьПроверкуПередЗаписью Тогда
		НеВыполнятьПроверкуПередЗаписью = Ложь;
		Возврат;
	КонецЕсли;
	
	Если ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
		//ВыполнитьПроверкиИЗадатьВопросыПередЗаписью(Отказ, ПараметрыЗаписи);
	КонецЕсли;
	
	ОбщийМодульКлиент.ЗаписатьОбъектПриНеобходимости(ЭтотОбъект, ПараметрыЗаписи, Отказ);
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	ОбновитьДанныеДокумента();
	Если ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
		Отказ = НЕ ПраваПользователей.РазрешеноПриходоватьНаСклад(Объект.Склад);
		Если Отказ Тогда
			Сообщить("У текущего пользователя нет прав для оформления прихода на склад """ + Объект.Склад + """");
			Возврат;
		КонецЕсли;
		
		//Если Объект.ОтветственностьИсполнителейПоСебестоимости Тогда
		//	Для Каждого ТекущаяСтрока Из Объект.Товары Цикл
		//		Если ТекущаяСтрока.Себестоимость = 0 И НЕ Справочники.ВидыНоменклатуры.ЭтоНоменклатураУслуга(ТекущаяСтрока.Номенклатура) Тогда
		//			Сообщить("В строке " + Формат(ТекущаяСтрока.НомерСтроки,"ЧГ=") + " не указана себестоимость");
		//			Отказ = Истина;
		//		КонецЕсли;
		//	КонецЦикла;
		//КонецЕсли;
	КонецЕсли;
	
	// проверяем заполненность статей доходов/расходов
	ФинансыСервер.ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи);
	
	СуммаЗачета = ПолучитьСуммуЗачета();
	ФинансыСервер.ПроверитьСуммуРаспределенияПоТипамДокументов(Объект, "ЗачетАванса", СуммаЗачета, Отказ, ПараметрыЗаписи.РежимЗаписи);

КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	Элементы.ПодменюПечать.Доступность = ПраваПользователей.ДоступностьПечати(Объект.Ссылка);
	
	//Если Объект.ОтветственностьИсполнителейПоСебестоимости Тогда
	//	ЗаполнитьСебестоимостьПродажНаСервере();
	//	ПересчитатьСуммыПоОтветственным(); // №14125
	//КонецЕсли;
		
	Если ТекущийОбъект.ПриходоватьТоварНаСклад ИЛИ ТекущийОбъект.БракПроизводства Тогда
		ЗаполнитьСебестоимостьПродажиСервер();
	КонецЕсли;
	
	ОбновитьДанныеДокумента();		
	ОбновитьДанныеТаблицыАвансов();
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	Если ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
		//#13359
		//Если UDS_ОбщийМодульВызовСервера.ИспользуетсяUDS() Тогда
		Если Объект.СлужебныйВидБонуснойСистемы = ПредопределенноеЗначение("Перечисление.ВидыБонусныхСистем.UDS") Тогда
			СостояниеОбменаUDS = UDS_ОбщийМодульКлиент.ПередатьВозврат(Объект);
			Если СостояниеОбменаUDS = 0 Тогда // не требуется
				// продолжаем процедуру ПослеЗаписи
			ИначеЕсли СостояниеОбменаUDS = 1 Тогда 
				// успешно отправлено
				Записать(ПараметрыЗаписи);
				Возврат;
			Иначе
				// ошибка при отправке, пользователь получит сообщение
				ПараметрыЗаписи.ПринудительноЗакрытьФорму = Ложь;
				//Возврат;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	ОбщийМодульКлиент.ВыполнитьДействияПослеЗаписи(ЭтаФорма, Объект, ПараметрыЗаписи);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	
	Если ИсточникВыбора.ИмяФормы = "ОбщаяФорма.ФормаПодбораНоменклатуры" Тогда	
		ОбработкаВыбораПодборНаКлиенте(ВыбранноеЗначение);
	КонецЕсли;
	
КонецПроцедуры

