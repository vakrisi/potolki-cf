&НаСервереБезКонтекста
Функция СебестоимостьПродажи(ДокументПродажи, Номенклатура, ХарактеристикаНоменклатуры, СерияНоменклатуры, Количество)
	
	Если НЕ ЗначениеЗаполнено(ДокументПродажи) Тогда
		Возврат 0;
	КонецЕсли;
	
	МассивДокументовПродаж = Новый Массив;
	МассивДокументовПродаж.Добавить(ДокументПродажи);
	ТаблицаСебестоимости = ОбщийМодульСервер.ТаблицаСебестоимостиПродаж(МассивДокументовПродаж);
	
	Отбор = Новый Структура;
	Отбор.Вставить("Номенклатура", 				 Номенклатура);
	Отбор.Вставить("ХарактеристикаНоменклатуры", ХарактеристикаНоменклатуры);
	Отбор.Вставить("СерияНоменклатуры", 		 СерияНоменклатуры);
	Отбор.Вставить("Регистратор", 				 ДокументПродажи);
	
	НайденныеСтроки = ТаблицаСебестоимости.НайтиСтроки(Отбор);
	Если НайденныеСтроки.Количество() > 0 Тогда
		Возврат НайденныеСтроки[0].Цена * Количество;
	КонецЕсли;
	
	Возврат 0;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПоследовательностьПоСебестоимостиНаДатуДокументаНарушена(Дата)
	
	Если Дата = Дата(1,1,1) Тогда
		МоментВремениДокумента = Новый МоментВремени(КонецДня(ТекущаяДатаСеанса()));
	Иначе
		МоментВремениДокумента = Новый МоментВремени(КонецДня(Дата));
	КонецЕсли;

	Результат = Ложь;
	
	Если ОбщийМодуль.ПоследовательностьПоСебестоимостиНарушена() Тогда
		ГраницаПоследовательности = ОбщийМодуль.ПолучитьГраницуПоследовательностиПоСебестоимости();
		
		Если МоментВремениДокумента.Сравнить(ГраницаПоследовательности) = 1 Тогда			
			Результат = Истина;
		КонецЕсли;
	КонецЕсли;	
	
	Возврат Результат;
	
КонецФункции

