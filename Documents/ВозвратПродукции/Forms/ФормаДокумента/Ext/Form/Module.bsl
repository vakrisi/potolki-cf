&НаСервере
Функция ОбработкаВыбораПодборНаСервере(ВыбранноеЗначение)
	
	ТаблицаТоваров = ПолучитьИзВременногоХранилища(ВыбранноеЗначение.АдресВХранилище);
	
	Для Каждого ТекущаяСтрока из ТаблицаТоваров Цикл
		НоваяСтрока = Объект.Товары.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущаяСтрока);
	КонецЦикла;
	
	ОбновитьДанныеДокумента(); 
	
КонецФункции

&НаКлиенте
Процедура ЗаполнитьОтветственныхПоВыпуску(Команда)
		
	Если Объект.Товары.Количество() = 0 Тогда
		Состояние("В документе не указаны возвращенные товары или продукция");
		Возврат;
	КонецЕсли;
	
	Если Объект.Ответственные.Количество() > 0 Тогда
		
		ОписаниеОповещения = новый ОписаниеОповещения("ПослеВопросаОбОчисткеОтветственныхПриЗаполненииПоВыпуску", ЭтотОбъект);
		ПоказатьВопрос(ОписаниеОповещения, "При продолжении табличная часть ""Ответственные"" будет очищена, продолжить?", РежимДиалогаВопрос.ДаНетОтмена);
		
	Иначе		
		ЗаполнитьОтветственныхПоВыпускуНаСервере();
		ПересчитатьСуммыПоОтветственным();		
	КонецЕсли;
	
КонецПроцедуры

