&НаСервере
Процедура КонтрагентПриИзмененииНаСервере()
	
	Объект.ДоговорКонтрагента = Объект.Контрагент.ОсновнойДоговор;
	//Элементы.КонтрагентДополнительно.Видимость = Объект.Контрагент.ПоказыватьДопИнформацию;
	ОбщийМодульСервер.ДополнительнаяИнформацияПоКонтрагентуНаФорме(Объект.Контрагент, Элементы.ПоказатьДополнительнуюИнформацию);
	ОбщийМодульСервер.РегулировкаШириныПоляКонтрагента(Элементы, Элементы.Контрагент, Элементы.ПоказатьДополнительнуюИнформацию);
	
КонецПроцедуры

&НаКлиенте
Процедура УменьшитьДолгКонтрагентаПриИзменении(Элемент)
	
	УправлениеФормой();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриходоватьТоварНаСкладПриИзменении(Элемент)
	
	УправлениеФормой();
	Если Объект.ПриходоватьТоварНаСклад Тогда		
		Для каждого СтрокаТабличнойЧасти из Объект.Товары Цикл
			Если НЕ ЗначениеЗаполнено(СтрокаТабличнойЧасти.ВариантОпределенияСебестоимости) Тогда
				СтрокаТабличнойЧасти.ВариантОпределенияСебестоимости = ?(ЗначениеЗаполнено(СтрокаТабличнойЧасти.ДокументПродажи), 
																		ПредопределенноеЗначение("Перечисление.ВариантыОпределенияСебестоимостиПоВозвратам.ПоДокументуПродажи"),
																		ПредопределенноеЗначение("Перечисление.ВариантыОпределенияСебестоимостиПоВозвратам.РучноеУказание"));
			КонецЕсли;
		КонецЦикла;
	
		ЗаполнитьСебестоимостьПродажиСервер();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура БракПроизводстваПриИзменении(Элемент)
	
	Если Объект.БракПроизводства И ЗначениеЗаполнено(ВариантОпределенияОтветственностиПоУмолчанию) Тогда		
		Для каждого СтрокаТабличнойЧасти из Объект.Товары Цикл
			Если НЕ ЗначениеЗаполнено(СтрокаТабличнойЧасти.ВариантОпределенияОтветственности) Тогда
				СтрокаТабличнойЧасти.ВариантОпределенияОтветственности = ВариантОпределенияОтветственностиПоУмолчанию;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	ЗаполнитьСебестоимостьПродажиСервер();
	ЗаполнитьОтветственностьНаСервере();
	
	ОбновитьДанныеДокумента();
	УправлениеФормой();
	
	ПересчитатьСуммыПоОтветственным();
	
КонецПроцедуры

