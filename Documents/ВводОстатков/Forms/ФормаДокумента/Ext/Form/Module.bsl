#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗагрузитьОстаткиИзExcel(Команда)
	
	ПараметрыФормы = Новый Структура("ТипОперации, Организация", Объект.ТипОперации, Объект.Организация);
	ОткрытьФорму("Документ.ВводОстатков.Форма.ФормаЗагрузкиИзExcel", ПараметрыФормы, ЭтаФорма, УникальныйИдентификатор);
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаВыбораЗагрузитьОстаткиИзExcelНаКлиенте(АдресДанныхВХранилище)
	
	ДанныеИзХранилища = ПолучитьИзВременногоХранилища(АдресДанныхВХранилище);	
	ИмяТабличнойЧасти = Метаданные.Перечисления.ТипыОперацийВводаОстатков.ЗначенияПеречисления[Перечисления.ТипыОперацийВводаОстатков.Индекс(Объект.ТипОперации)].Имя;
	
	Для Каждого СтрокаТЗ Из ДанныеИзХранилища Цикл
		СтрокаТабличнойЧасти = Объект[ИмяТабличнойЧасти].Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаТабличнойЧасти, СтрокаТЗ);
		
		Если Объект.ТипОперации = Перечисления.ТипыОперацийВводаОстатков.ТоварыНаСкладах Тогда
			СтруктураДанные = Новый Структура;
			СтруктураДанные.Вставить("Номенклатура", СтрокаТабличнойЧасти.Номенклатура);
			СтруктураДанные = ОбщийМодульВызовСервера.ПолучитьДанныеНоменклатурыПриИзменении(СтруктураДанные);
	
			ЗаполнитьЗначенияСвойств(СтрокаТабличнойЧасти, СтруктураДанные, "ЕдиницаИзмерения, Коэффициент"); //, СтатьяДоходов");
			
		КонецЕсли;
	
	КонецЦикла;
		
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьТоварыНаСкладахПоГруппе(Команда)
	
	Если Объект.ТоварыНаСкладах.Количество() > 0 Тогда
		ОписаниеОповещения = Новый ОписаниеОповещения("ЗаполнитьТоварыНаСкладахПоГруппеФрагмент", ЭтотОбъект);
		ПоказатьВопрос(ОписаниеОповещения, "Очистить табличную часть товаров?", РежимДиалогаВопрос.ДаНет);
	Иначе
		ЗаполнитьТоварыНаСкладахПоГруппеФрагмент(КодВозвратаДиалога.Да, Неопределено);
	КонецЕсли;
		
КонецПроцедуры
			
&НаКлиенте
Процедура ЗаполнитьТоварыНаСкладахПоГруппеФрагмент(Результат, ДополнительныеПараметры) Экспорт

	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		Объект.ТоварыНаСкладах.Очистить();
	КонецЕсли;
	
	ОткрытьФорму("Справочник.Номенклатура.ФормаВыбораГруппы",,ЭтаФорма,,,,
		Новый ОписаниеОповещения("ЗаполнитьТоварыНаСкладахПоГруппеПриЗавершенииВыбора",ЭтотОбъект));
		
КонецПроцедуры
	
&НаКлиенте
Процедура ЗаполнитьТоварыНаСкладахПоГруппеПриЗавершенииВыбора(Результат, ДопПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ЗаполнитьТоварыНаСкладахПоГруппеНоменклатуры(Результат);
	
КонецПроцедуры

&НаСервере 
Процедура ЗаполнитьТоварыНаСкладахПоГруппеНоменклатуры(Знач ГруппаНоменклатуры)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Номенклатура.Ссылка КАК Номенклатура,
	|	Номенклатура.БазоваяЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	1 КАК Коэффициент,
	|	1 КАК Количество
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	Номенклатура.ЭтоГруппа = ЛОЖЬ
	|	И Номенклатура.Ссылка В ИЕРАРХИИ(&Родитель)";
	Запрос.УстановитьПараметр("Родитель", ГруппаНоменклатуры);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СтруктураОтбора = Новый Структура("Номенклатура", Выборка.Номенклатура);
		НайденныеСтроки = Объект.ТоварыНаСкладах.НайтиСтроки(СтруктураОтбора);
		Если НайденныеСтроки.Количество() = 0 Тогда
			НоваяСтрока = Объект.ТоварыНаСкладах.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьЦенуНаТоварыНаСкладах(Команда)
	
	Оповещение = Новый ОписаниеОповещения("ПослеВводаЗначенияНовойЦены", ЭтаФорма);
	ПоказатьВводЗначения(Оповещение, 0, "Введите цену", Новый ОписаниеТипов("число"));
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВводаЗначенияНовойЦены(ВыбЗнач, Параметры) Экспорт
	
	Если ВыбЗнач = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого ТекущаяСтрока Из Объект.ТоварыНаСкладах Цикл
		//ТекущаяСтрока.Цена = ВыбЗнач;
		ТекущаяСтрока.Сумма = ТекущаяСтрока.Количество * ВыбЗнач;
	КонецЦикла;
    
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьДоговоры(Команда)
	ЗаполнитьДоговорыНаСервере();
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДоговорыНаСервере()
	
	Для каждого СтрокаТЧ из Объект.ВзаиморасчетыСКонтрагентами Цикл
		Если НЕ ЗначениеЗаполнено(СтрокаТЧ.Контрагент) ИЛИ ЗначениеЗаполнено(СтрокаТЧ.Договор) Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокаТЧ.Договор = Справочники.ДоговорыКонтрагентов.ПолучитьДоговорПоУмолчанию(Объект.Организация, СтрокаТЧ.Контрагент);
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура УправлениеФормой()
	
	//++ #13511
	Элементы.Организация.Видимость = Ложь;
	Элементы.Склад.Видимость = Ложь;
	Элементы.Валюта.Видимость = Ложь;
	Если Объект.ТипОперации = Перечисления.ТипыОперацийВводаОстатков.ТоварыНаСкладах Тогда
		Элементы.Организация.Видимость = Истина;
		Элементы.Склад.Видимость = Истина;
		Элементы.Валюта.Видимость = Истина;
		
	ИначеЕсли Объект.ТипОперации = Перечисления.ТипыОперацийВводаОстатков.ВзаиморасчетыСКонтрагентами Тогда
		Элементы.Организация.Видимость = Истина;
		Элементы.Валюта.Видимость = Истина;

	ИначеЕсли Объект.ТипОперации = Перечисления.ТипыОперацийВводаОстатков.ДенежныеСредства Тогда
		Элементы.Организация.Видимость = Истина;
		Элементы.Валюта.Видимость = Истина;
		
	ИначеЕсли Объект.ТипОперации = Перечисления.ТипыОперацийВводаОстатков.РасчетыСПерсоналом Тогда
		Элементы.Организация.Видимость = Истина;
		Элементы.Валюта.Видимость = Истина;
		
	ИначеЕсли Объект.ТипОперации = Перечисления.ТипыОперацийВводаОстатков.РасчетыСПодотчетниками Тогда
		Элементы.Организация.Видимость = Истина;
		Элементы.Валюта.Видимость = Истина;
		
	ИначеЕсли Объект.ТипОперации = Перечисления.ТипыОперацийВводаОстатков.МатериалыВЭксплуатации Тогда
		Элементы.Организация.Видимость = Истина;
		//Элементы.Валюта.Видимость = Истина;

	КонецЕсли;
	//-- #13511
	
	Для Каждого ТекущаяСтраница Из Элементы.Страницы.ПодчиненныеЭлементы Цикл
		
		ТекущаяСтраница.Видимость = Ложь;
		
		Если Сред(НРег(ТекущаяСтраница.Имя), 7) = СтрЗаменить(НРег(Объект.ТипОперации), " ", "") Тогда
			
			ТекущаяСтраница.Видимость = Истина;
			
			Элементы.Страницы.ТекущаяСтраница = ТекущаяСтраница;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура РаспределениеПлатежаДокументНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
КонецПроцедуры

#КонецОбласти
