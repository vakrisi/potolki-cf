#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
	
#Область ОбработчикиСобытий

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	
	ОбщийМодуль.ЗаполнитьШапкуДокумента(ЭтотОбъект);
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	Если ТипОперации = Перечисления.ТипыОперацийВводаОстатков.ВзаиморасчетыСКонтрагентами Тогда
		ПроверяемыеРеквизиты.Добавить("Организация");
	КонецЕсли;
		
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	// Очистим лишние таблицы
	ИмяТипаОперации = "";
	Если Не ТипОперации.Пустая() Тогда
		ИмяТипаОперации = Метаданные.Перечисления.ТипыОперацийВводаОстатков.ЗначенияПеречисления.Получить(Перечисления.ТипыОперацийВводаОстатков.Индекс(ТипОперации)).Имя;
	КонецЕсли;
	
	Для Каждого ТабличнаяЧасть Из Метаданные().ТабличныеЧасти Цикл
		Если ТабличнаяЧасть.Имя = ИмяТипаОперации Тогда
			Продолжить;
		КонецЕсли;
				
		ЭтотОбъект[ТабличнаяЧасть.Имя].Очистить();		
	КонецЦикла;
		
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	ОрганизацияТоваров = Организация;
	Если Константы.ОбщиеСклады.Получить() Тогда
		ОрганизацияТоваров = Справочники.Организации.ПустаяСсылка();
	КонецЕсли;
	
	// Бонусы контрагентов
	Движения.БонусыКонтрагентов.Записывать = Истина;
	Для Каждого ТекущаяСтрока Из БонусыКонтрагентов Цикл
		
		Движение = Движения.БонусыКонтрагентов.Добавить();
		ЗаполнитьЗначенияСвойств(Движение, ТекущаяСтрока, "Контрагент, ДисконтнаяКарта, Сумма");
		
		Движение.Период = Дата;
		Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
		
	КонецЦикла;
	
	// Взаиморасчеты с контрагентами
	Движения.ВзаиморасчетыСКонтрагентами.Записывать = Истина;
	Движения.ВзаиморасчетыСКонтрагентамиВВалюте.Записывать = Истина;
	Для Каждого ТекущаяСтрока Из ВзаиморасчетыСКонтрагентами Цикл
		
		//Движение = Движения.ВзаиморасчетыСКонтрагентами.Добавить();
		//ЗаполнитьЗначенияСвойств(Движение, ТекущаяСтрока);
		//
		//Движение.Период = Дата;
		//Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
		
		СуммаВВалютеУчета = РаботаСВалютой.ПолучитьСуммуВВалютеУчетаПоДокументу(Ссылка, ТекущаяСтрока.Сумма);
		
		Движение = Движения.ВзаиморасчетыСКонтрагентами.Добавить();
		
		Движение.Период = Дата;
		Движение.Организация = Организация;
		Движение.Контрагент = ТекущаяСтрока.Контрагент;
		Движение.Договор = ТекущаяСтрока.Договор;
		//Движение.Документ = Ссылка;
		// долг покупателя или аванс поставщику (долг перед компанией)
		Если ТекущаяСтрока.Сумма > 0 Тогда
			Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
			Движение.Сумма = СуммаВВалютеУчета;
			
		// аванс покупателя или долг поставщику (долги компании)
		ИначеЕсли ТекущаяСтрока.Сумма < 0 Тогда
			Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
			Движение.Сумма = -СуммаВВалютеУчета;
		КонецЕсли;
		
		Движение = Движения.ВзаиморасчетыСКонтрагентамиВВалюте.Добавить();
		Движение.ВидДвижения =ВидДвиженияНакопления.Приход;
		Движение.Период = Дата;
		Движение.Организация = Организация;
		Движение.Контрагент = ТекущаяСтрока.Контрагент;
		Движение.Договор = ТекущаяСтрока.Договор;
		Движение.Валюта = Валюта;
		Движение.Сумма = ТекущаяСтрока.Сумма;
		
	КонецЦикла;
	
	// #14173
	//Распределение РасчетыПоЗаказам 
	// расчеты с покупателем 
	СписокВидовДокументовПоКоторымВедутсяРасчеты = ОбщийМодуль.ПолучитьМассивТиповДокументовПоКоторымВедутсяРасчетыПоЗаказам();
	Движения.РасчетыПоЗаказам.Записывать = Истина;
	Для Каждого ТекущаяСтрока Из ВзаиморасчетыСКонтрагентами Цикл
		Если ТекущаяСтрока.Сумма = 0 ИЛИ НЕ ЗначениеЗаполнено(ТекущаяСтрока.ДокументРасчета) Тогда
			Продолжить;
		КонецЕсли;
		НайденныйВидДокумента = СписокВидовДокументовПоКоторымВедутсяРасчеты.Найти(ТипЗнч(ТекущаяСтрока.ДокументРасчета));
		Если НайденныйВидДокумента = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Движение = Движения.РасчетыПоЗаказам.Добавить();
		Движение.Период = Дата;
		Движение.Заказ = ТекущаяСтрока.ДокументРасчета;
		Движение.Контрагент = ТекущаяСтрока.ДокументРасчета.Контрагент;
		Если ТекущаяСтрока.Сумма < 0 Тогда
			Движение.ВидДвижения = ВидДвиженияНакопления.Расход; // как ПКО
			Движение.Сумма = -ТекущаяСтрока.Сумма;
		Иначе 
			Движение.ВидДвижения = ВидДвиженияНакопления.Приход; // как РКО
			Движение.Сумма = ТекущаяСтрока.Сумма;
		КонецЕсли;
	КонецЦикла;
	
	// #13511 убрано
	// Взаиморасчеты с контрагентами в валюте
	//Движения.ВзаиморасчетыСКонтрагентамиВВалюте.Записывать = Истина;
	//Для Каждого ТекущаяСтрока Из УДАЛИТЬ_ВзаиморасчетыСКонтрагентамиВВалюте Цикл
	//	
	//	Движение = Движения.ВзаиморасчетыСКонтрагентамиВВалюте.Добавить();
	//	ЗаполнитьЗначенияСвойств(Движение, ТекущаяСтрока);
	//	
	//	Движение.Период = Дата;
	//	Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
	//	
	//КонецЦикла;
	
	// Денежные средства
	Движения.ДенежныеСредства.Записывать = Истина;
	Для Каждого ТекущаяСтрока Из ДенежныеСредства Цикл
		
		Движение = Движения.ДенежныеСредства.Добавить();
		ЗаполнитьЗначенияСвойств(Движение, ТекущаяСтрока, "СчетКасса, Сумма");
		
		Движение.Период = Дата;
		Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
		Движение.Организация = Организация;
		Движение.Валюта = Валюта;
		
	КонецЦикла;
	
	// Материалы в эксплуатации
	Движения.МатериалыВЭксплуатации.Записывать = Истина;		
	Для Каждого ТекущаяСтрока Из МатериалыВЭксплуатации Цикл
		
		Движение = Движения.МатериалыВЭксплуатации.Добавить();
		ЗаполнитьЗначенияСвойств(Движение, ТекущаяСтрока, "Ответственный, Номенклатура, ХарактеристикаНоменклатуры, СерияНоменклатуры, Количество, Сумма");
		
		Движение.Период = Дата;
		Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
		Движение.Организация = ОрганизацияТоваров;
		
	КонецЦикла;
	
	// Расчеты с персоналом
	Движения.РасчетыСПерсоналом.Записывать = Истина;
	Для Каждого ТекущаяСтрока Из РасчетыСПерсоналом Цикл
		
		Движение = Движения.РасчетыСПерсоналом.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
		Движение.Период = Дата;
		//Движение.ПериодРегистрации = ?(ИспользуетсяПериодРегистрации, ПериодРегистрации, Дата(1,1,1));
		Движение.Организация = Организация;
		Движение.Сотрудник = ТекущаяСтрока.Сотрудник;
		//Движение.ВидНачисления = 
		//Движение.ОбъектВыработки = 
		Движение.Сумма = РаботаСВалютой.ПолучитьСуммуВВалютеУчетаПоДокументу(Ссылка, ТекущаяСтрока.Сумма);
		
	КонецЦикла;
	
	// Расчеты с подотчетниками
	Движения.РасчетыСПодотчетниками.Записывать = Истина;
	Для Каждого ТекущаяСтрока Из РасчетыСПодотчетниками Цикл
		
		Движение = Движения.РасчетыСПодотчетниками.Добавить();		
		Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
		Движение.Период = Дата;
		Движение.Организация = Организация;
		Движение.Сотрудник = ТекущаяСтрока.Сотрудник;
		Движение.Сумма = РаботаСВалютой.ПолучитьСуммуВВалютеУчетаПоДокументу(Ссылка, ТекущаяСтрока.Сумма);

	КонецЦикла;
		
	// Товары на складах	
	Движения.ТоварыНаСкладах.Записывать = Истина;
	Для Каждого ТекущаяСтрока Из ТоварыНаСкладах Цикл
		Движение = Движения.ТоварыНаСкладах.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
		Движение.Период = Дата;
		Движение.Организация = ОрганизацияТоваров;
		Движение.Склад = Склад;
		Движение.Номенклатура = ТекущаяСтрока.Номенклатура;
		Движение.ХарактеристикаНоменклатуры = ТекущаяСтрока.ХарактеристикаНоменклатуры;
		Движение.СерияНоменклатуры = ТекущаяСтрока.СерияНоменклатуры;
		Движение.Количество = ТекущаяСтрока.Количество * ТекущаяСтрока.Коэффициент;
		Движение.Сумма = РаботаСВалютой.ПолучитьСуммуВВалютеУчетаПоДокументу(Ссылка, ТекущаяСтрока.Сумма);
		Движение.СуммаВал = РаботаСВалютой.ПолучитьСуммуВДопВалютеУчетаПоДокументу(Ссылка, ТекущаяСтрока.Сумма); //#8288
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли
