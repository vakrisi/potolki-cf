
&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ОбновитьОстаток();
	ОбновитьВидимостьЭлементов();
	ОбновитьВидимостьКнопкиПроведения();
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьОстаток() Экспорт
	остаток = Объект.СуммаДокумента;
	для каждого стр из Объект.ИА_ЗаказыНаПриобретение Цикл
		остаток = остаток - стр.Сумма;
	КонецЦикла;
	для каждого стр из Объект.ИА_Фонды Цикл
		остаток = остаток - стр.Сумма;
	КонецЦикла;
	
	//Элементы.ДекорацияОстаток.Видимость = остаток<>0;
	//Элементы.ДекорацияОстаток.Заголовок = "Остаток средств к распределению: " + формат(остаток,"ЧДЦ=2; ЧН=");
	Элементы.ОстатокТекст.Видимость = остаток<>0;
	ОстатокТекст = " Остаток средств к распределению: " + формат(остаток,"ЧДЦ=2; ЧН=");
КонецПроцедуры
 
&НаКлиенте
Процедура ОбновитьВидимостьЭлементов()
	 Элементы.Организация.Видимость = Объект.Организация <> объект.ОрганизацияДочерняя;
	 Элементы.ИА_ФондыПодразделение.Видимость = ИспПодразделения;
	 Элементы.ГруппаЗаказы.Видимость = Объект.ТипИсточникаСредств = ПредопределенноеЗначение("Справочник.КСУ_ИсточникиСредств.ВозвратОтПоставщика");
	 Элементы.Основание.Видимость = ЗначениеЗаполнено(объект.Основание);
	 
	 Элементы.ГруппаЦентр.ТолькоПросмотр = объект.Проведен;
	 Элементы.ИА_Фонды.КоманднаяПанель.Доступность = не объект.Проведен;
	 Элементы.ИА_ЗаказыНаПриобретение.КоманднаяПанель.Доступность = не объект.Проведен;
	 
	 Элементы.ОрганизацияДочерняя.ТолькоПросмотр = объект.ИА_ЗаказыНаПриобретение.Количество()>0;
	 Элементы.ТипИсточникаСредств.ТолькоПросмотр = объект.ИА_ЗаказыНаПриобретение.Количество()>0;
	 Элементы.Дата.ТолькоПросмотр = объект.ИА_ЗаказыНаПриобретение.Количество()>0;
	 
	 ЕстьОснование = ЗначениеЗаполнено(объект.Основание);
	 //Элементы.Организация.ТолькоПросмотр = ЕстьОснование;
	 Если ЕстьОснование тогда
	 	Элементы.ОрганизацияДочерняя.ТолькоПросмотр = истина;
	 	Элементы.Сумма.ТолькоПросмотр = истина;
	КонецЕсли;
КонецПроцедуры


&НаКлиенте
Процедура ОрганизацияДочерняяПриИзменении(Элемент)
	Если ИспользуютсяГруппыКомпаний Тогда
		Объект.Организация = ИА_ФП.ПолучитьГоловнуюОрганизацию(Объект.ОрганизацияДочерняя);
	Иначе
		объект.Организация = объект.ОрганизацияДочерняя;
	КонецЕсли;
	ОбновитьВидимостьЭлементов();
КонецПроцедуры


&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ИспользуютсяГруппыКомпаний = Справочники.ИА_ГруппыКомпаний.ПолучитьПризнакИспользованияГруппКомпаний();
	ИспПодразделения = Константы.КСУ_ФП_ИспользоватьПодразделения.Получить();
	ПоОрг = Константы.ИА_ФП_ВестиФППоОрганизациям.Получить();
	
	Элементы.УстановитьПометкуУдаления.Видимость = не объект.Ссылка.Пустая();
	Если ПоОрг тогда
		Элементы.ОрганизацияДочерняя.АвтоОтметкаНезаполненного = Истина;
	КонецЕсли;
	
	Если Объект.Ссылка.Пустая() тогда
		объект.Дата = ТекущаяДата();
		объект.Ответственный = ПараметрыСеанса.ТекущийПользователь;
	КонецЕсли;
КонецПроцедуры


&НаКлиенте
Процедура ТипИсточникаСредствПриИзменении(Элемент)
	ОбновитьВидимостьЭлементов();
КонецПроцедуры


&НаКлиенте
Процедура ИА_ЗаказыНаПриобретениеСуммаПриИзменении(Элемент)
	тд = Элементы.ИА_ЗаказыНаПриобретение.ТекущиеДанные;
	Если тд.Сумма > тд.Выплачено тогда
		Сообщить("Нельзя по заказу вернуть денежных средств от поставщика больше, чем было оплачено!");
		тд.Сумма = тд.Выплачено;
	КонецЕсли;
	
	ОбновитьОстаток();
КонецПроцедуры


&НаКлиенте
Процедура ИА_ФондыСуммаПриИзменении(Элемент)
	ОбновитьОстаток();
КонецПроцедуры


&НаКлиенте
Процедура ИА_ЗаказыНаПриобретениеПослеУдаления(Элемент)
	ОбновитьОстаток();
	ОбновитьВидимостьЭлементов();
КонецПроцедуры


&НаКлиенте
Процедура ИА_ФондыПослеУдаления(Элемент)
	ОбновитьОстаток();
КонецПроцедуры


&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	Если ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
		
		Если объект.Дата > КонецДня(ТекущаяДата()) ТОгда		
			ПоказатьПредупреждение(,"Внедоходное поступление можно сохранять как черновик с датой будущего периода. Но утверждать можно не позднее текущей даты (сегодняшней даты). Измените дату и повторите операцию, если вы действительно решили утвердить Внедоходное поступление.");
			Отказ = Истина;
			Возврат;
		КонецЕсли;        
		
		Если объект.СуммаДокумента = 0 Тогда
			ПоказатьПредупреждение(,"Поле ""Сумма к распределению"" не заполнено!");
			Отказ = Истина;
			возврат;
		КонецЕсли;
		
		Если объект.Организация.Пустая() Тогда
			ПоказатьПредупреждение(,"Поле ""Организация"" не заполнено!");
			Отказ = Истина;
			возврат;
		КонецЕсли;
		
		Если остаток > 0 Тогда
			ПоказатьПредупреждение(,"Распределите всю сумму!");
			Отказ = Истина;
			возврат;
		КонецЕсли;
		
		Если остаток < 0 Тогда
			ПоказатьПредупреждение(,"По фондам и заказам распределена сумма, превышающая сумму документа!");
			Отказ = Истина;
			возврат;
		КонецЕсли;
	КонецЕсли;
	
	Если ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения или ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
		Если ИА_ФПСервер.естьБудущиеДоки(Объект.организация, Объект.дата) Тогда
			отказ = Истина;
			парамФ_1 = Новый структура("Период, Организация, ИмяДока, Действие", объект.Дата, объект.Организация, "ВДПС");
			парамФ_1.Действие = ?(ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения, "отмены", "проведения");
			ОткрытьФорму("ОбщаяФорма.КСУ_ПредупреждениеПриОтменеПроведения", парамФ_1, ЭтаФорма,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры


&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	ОбновитьВидимостьЭлементов();
	ОбновитьВидимостьКнопкиПроведения();
