&НаКлиенте
Процедура ИА_ЗаказыНаПриобретениеПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	Отказ = истина;
КонецПроцедуры


&НаКлиенте
Процедура ДобавитьЗаказ(Команда)
	Если ПоОрг и объект.Организация.Пустая() Тогда
		ПоказатьПредупреждение(,"Выберите Организацию!");
		возврат;
	КонецЕсли;
	
	ИсклЗаказы = новый массив;
	Для каждого стр из объект.ИА_ЗаказыНаПриобретение Цикл
		ИсклЗаказы.Добавить(стр.ЗП);
	КонецЦикла;
	
	Парам = Новый Структура("Организация,Дата,ИсклЗаказы", объект.ОрганизацияДочерняя, ?(объект.Дата=Дата(1,1,1), ТекущаяДата(), объект.Дата),ИсклЗаказы);
	Оп = Новый ОписаниеОповещения("ЗавершениеВыбораЗаказа", ЭтотОбъект);
	ОткрытьФорму("Документ.КСУ_ВнедоходноеПоступлениеСредств.Форма.ПодборОплаченногоЗаказа", Парам, ЭтаФорма,,,, Оп, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры

&НаКлиенте
Процедура ЗавершениеВыбораЗаказа(выбЗн, дп) Экспорт
	Если выбЗн <> Неопределено Тогда
		новстр = Объект.ИА_ЗаказыНаПриобретение.Добавить();
		ЗаполнитьЗначенияСвойств(новстр, выбЗн);
		новстр.Сумма = новстр.Выплачено;
		
		ОбновитьОстаток();
		ОбновитьВидимостьЭлементов();
	КонецЕсли;
КонецПроцедуры


&НаКлиенте
Процедура ИА_ЗаказыНаПриобретениеВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	тд = Элементы.ИА_ЗаказыНаПриобретение.ТекущиеДанные;
	Если поле = Элементы.ИА_ЗаказыНаПриобретениеЗПНомер или поле = Элементы.ИА_ЗаказыНаПриобретениеЗППредметЗаказа Тогда
		СтандартнаяОбработка = ложь;
		ПоказатьЗначение(,тд.зп);		
	КонецЕсли;
КонецПроцедуры

