Процедура ОбработатьИзменениеПлощадиПотолкаНаСервере(Параметр)
	
	Для Каждого ТекущаяСтрока Из Объект.Товары Цикл
		Если ТекущаяСтрока.Номенклатура = Параметр.Номенклатура Тогда
			ТекущаяСтрока.Количество = Параметр.НоваяПлощадьПотолка;
			//ТекущаяСтрока.Сумма = ТекущаяСтрока.Количество * ТекущаяСтрока.Цена;
			ОбработкаТабличныхЧастейСервер.ПересчитатьСуммуСУчетомСкидокВСтрокеТЧ(ТекущаяСтрока, Ложь, Ложь, Ложь);
			ОбработкаТабличныхЧастейСервер.ПересчитатьСуммуНДСВСтрокеТЧ(ТекущаяСтрока, УчитыватьНДС);
		КонецЕсли;
	КонецЦикла;
	
	Модифицированность = Истина;
	
	РассчитатьИтоговыеПоказателиСервер();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьШтрихкод(Параметр)
	
	СтруктураТовара = ОбщийМодульКлиент.ПолучитьНоменклатуруПоШтрихКоду(МенеджерОборудованияКлиентПереопределяемый.ПреобразоватьДанныеСоСканераВМассив(Параметр));
	
	Если НЕ СтруктураТовара.Номенклатура = ПредопределенноеЗначение("Справочник.Номенклатура.ПустаяСсылка") Тогда
		
		//Попробуем найти в ТЧ
		СтруктураПоиска = новый Структура("Номенклатура, ХарактеристикаНоменклатуры, СерияНоменклатуры, ЕдиницаИзмерения", СтруктураТовара.Номенклатура, СтруктураТовара.ХарактеристикаНоменклатуры, СтруктураТовара.СерияНоменклатуры, СтруктураТовара.ЕдиницаИзмерения);
		НайденныеСтроки = Объект.Товары.НайтиСтроки(СтруктураПоиска);
		
		Если НайденныеСтроки.Количество() = 0 Тогда
			НоваяСтрока = Объект.Товары.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтруктураТовара);
			НоваяСтрока.Количество = 1;
			Если ТипЗнч(НоваяСтрока.ЕдиницаИзмерения) = Тип("СправочникСсылка.КлассификаторЕдиницИзмерения") Тогда
				НоваяСтрока.Коэффициент = 1;
			Иначе
				НоваяСтрока.Коэффициент = ОбщийМодуль.ПолучитьКоэффициентЕдиницыИзмерения(НоваяСтрока.ЕдиницаИзмерения);
			КонецЕсли;
			НоваяСтрока.СтавкаНДС = СтавкаНДСПоУмолчанию;
		Иначе
			НоваяСтрока = НайденныеСтроки[0];
			НоваяСтрока.Количество = НоваяСтрока.Количество + 1;
		КонецЕсли;	
		
		//НоваяСтрока.Сумма = НоваяСтрока.Цена * НоваяСтрока.Количество;
		ОбработкаТабличныхЧастейКлиент.ПересчитатьСуммуСУчетомСкидокВСтрокеТЧ(НоваяСтрока, Ложь, Ложь, Ложь);
		ОбработкаТабличныхЧастейКлиент.ПересчитатьСуммуНДСВСтрокеТЧ(НоваяСтрока, УчитыватьНДС);
	Иначе
		Сообщить("Не удалось найти номенклатуру со штрих-кодом " + СтруктураТовара.ШтрихКод);
	КонецЕсли;	
	
КонецПроцедуры

//#7805
&НаСервере
Процедура УДАЛИТЬ_УправлениеРеквизитомАдресаМонтажа()
	
	// №10128 видимость всегда Истина, было: ВидимостьЭлемента = Ложь;
	ЗначениеРеквизита = "";
	Если ЗначениеЗаполнено(Объект.Основание) Тогда
		
		Если ТипЗнч(Объект.Основание) = Тип("ДокументСсылка.ЗаказПокупателя") Тогда
			НастройкаИнтеркампани = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Основание, "НастройкаИнтеркампани");
			Если ЗначениеЗаполнено(НастройкаИнтеркампани) Тогда
				// №10128 видимость всегда Истина, было: ВидимостьЭлемента = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(НастройкаИнтеркампани, "ОтображатьАдресМонтажаВШапкеДокумента");
				ЗначениеРеквизита = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Основание, "АдресМонтажа");
			КонецЕсли;
			
		ИначеЕсли ТипЗнч(Объект.Основание) = Тип("ДокументСсылка.РеализацияТоваровИУслуг") Тогда
			//РеквизитыРеализации = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект.Основание, "Организация, Контрагент");
			//МенеджерЗаписи = РегистрыСведений.СвязкиОрганизацийПроизводстваКонтрагентРозницы.СоздатьМенеджерЗаписи();
			//МенеджерЗаписи.Организация = РеквизитыРеализации.Организация;
			//МенеджерЗаписи.Контрагент  = РеквизитыРеализации.Контрагент;
			//МенеджерЗаписи.Прочитать();
			//Если МенеджерЗаписи.Выбран() Тогда
			РеквизитыОснования = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект.Основание, "АвтоматическиСоздатьДокументПоступленияОтПроизводстваНаРозницуПоИнтеркампани, АвтоматическиСоздатьДокументПоступленияОтПроизводстваНаРозницуСозданныхВручную, АдресМонтажа");
			ПоступлениеПоИнтеркампани = РеквизитыОснования.АвтоматическиСоздатьДокументПоступленияОтПроизводстваНаРозницуПоИнтеркампани ИЛИ РеквизитыОснования.АвтоматическиСоздатьДокументПоступленияОтПроизводстваНаРозницуСозданныхВручную;
			Если ПоступлениеПоИнтеркампани Тогда
				// №10128 видимость всегда Истина, было: ВидимостьЭлемента = МенеджерЗаписи.ОтображатьАдресМонтажаВШапкеДокумента;
				ЗначениеРеквизита = РеквизитыОснования.АдресМонтажа;
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
	//#10822
	Если Объект.ПоступлениеОтПроизводстваУИБ Тогда
		ЗначениеРеквизита = Объект.АдресМонтажа;	
	КонецЕсли;
	
	АдресМонтажа = ЗначениеРеквизита;
	Элементы.АдресМонтажа.Видимость = Истина; // №10128 видимость всегда Истина, было: ВидимостьЭлемента;
	
КонецПроцедуры

