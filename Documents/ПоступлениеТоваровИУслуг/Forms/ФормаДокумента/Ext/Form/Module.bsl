&НаКлиенте
Процедура ЗаполнитьЦеныПоставщика(Команда)
	
	Если НЕ ЗначениеЗаполнено(Объект.ВидЦеныПоставщика) Тогда
		ТекстОшибки = "Не указан вид цены поставщика!";
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки, , "Объект.ВидЦеныПоставщика");
		Возврат;
	КонецЕсли;
	
	Если ПроверитьЗаполнение() Тогда 
		ИмяТабличнойЧасти = "Товары";
		Если Команда.Имя = "ЗаполнитьЦеныУслугПоставщика" Тогда
			ИмяТабличнойЧасти = "Услуги";
		КонецЕсли;
		Если Объект[ИмяТабличнойЧасти].Количество() = 0 Тогда
			Сообщить ("Таблица товаров пустая");
		Иначе
			ОП = Новый ОписаниеОповещения ("ЗаполнитьЦеныПоставщикаНаКлиенте", ЭтотОбъект, Новый Структура("ИмяТабличнойЧасти", ИмяТабличнойЧасти));
			ПоказатьВопрос(ОП, "Для каждой строки будут установлены цены поставщика, 
			|если они зарегистрированы в базе.
			|Продолжить?", РежимДиалогаВопрос.ДаНет,,,"Загрузить цены?");
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

