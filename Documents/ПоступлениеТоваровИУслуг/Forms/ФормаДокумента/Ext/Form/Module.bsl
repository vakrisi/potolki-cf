&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Ключ.Пустая() Тогда
		ПриЧтенииСозданииНаСервере();
	Иначе
		ЭтаФорма.ТолькоПросмотр = ПраваПользователей.ДокументТолькоПросмотр(Объект.Ссылка);
	КонецЕсли;
	
	УстановитьУсловноеОформление(); 
	
	//nva+++
	РеквизитыПользователя = ОбщийМодульСервер.НастройкиПользователя("ДополнительныеПраваЗапретРедактированияЦенВДокументах");
	
	ЗапретИзмененияЦен = РеквизитыПользователя.ДополнительныеПраваЗапретРедактированияЦенВДокументах;
	
	//управление доступностью элементов
	Если ЗапретИзмененияЦен Тогда
		МассивИменЭлементов = Документы.ПоступлениеТоваровИУслуг.ПолучитьМассивРеквизитовПоЦенам();
		ОбщийМодульКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы, МассивИменЭлементов, "ТолькоПросмотр", Истина);
	КонецЕсли;
	
	ИспользоватьКонтрольКратности = ПолучитьФункциональнуюОпцию("ИспользоватьКонтрольКратностиЕдиницИзмерения");
	//nva---
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	СофтФонСервер.ПриСозданииНаСервере(ЭтотОбъект);
	МессенджерыСервер.ПриСозданииНаСервере(ЭтотОбъект, Элементы.ГруппаКонтрагентКПМессенджеры);
	
	ВалютаУчета = ПолучитьФункциональнуюОпцию("ВалютаУчета");
	
	ОбновитьВидимостьИОстаткиВзаиморасчетов();
	
	//Если ПараметрыСеанса.ТекущийПользователь.ДополнительныеПраваЗапретРедактированияДокументовПоступления Тогда
	//	ЭтаФорма.ТолькоПросмотр = Истина;
	//КонецЕсли;
	
	Элементы.ПодменюПечать.Доступность = ПраваПользователей.ДоступностьПечати(Объект.Ссылка);
	ПраваПользователей.УстановитьТолькоПросмотрДляРеквизитаНомер(Элементы.Номер.ТолькоПросмотр);
	//Элементы.КонтрагентДополнительно.Видимость = Объект.Контрагент.ПоказыватьДопИнформацию;
	ОбщийМодульСервер.ДополнительнаяИнформацияПоКонтрагентуНаФорме(Объект.Контрагент, Элементы.ПоказатьДополнительнуюИнформацию);
	ОбщийМодульСервер.РегулировкаШириныПоляКонтрагента(Элементы, Элементы.Контрагент, Элементы.ПоказатьДополнительнуюИнформацию);
	
	ЭтоДокументОбеспеченияРозницы = ЗначениеЗаполнено(Объект.Основание) 
	И (ТипЗнч(Объект.Основание) = Тип("ДокументСсылка.ЗаказДоговор") ИЛИ ТипЗнч(Объект.Основание) = Тип("ДокументСсылка.Монтаж"));	
	Элементы.ТоварыГруппаРозница.Видимость = ЭтоДокументОбеспеченияРозницы;
	Если ЭтоДокументОбеспеченияРозницы Тогда
		СписокКомнатОснования.ЗагрузитьЗначения(Документы.ЗаказДоговор.ПолучитьМассивКомнатДоговора(Объект.Основание));
	КонецЕсли;
	//#14675
	Элементы.ТоварыКомната.Видимость = Объект.СозданПриИспользованииНастройкиУчетОбеспеченностиРозницыПоКомнатам;
	
	ФинансыСервер.УстановитьОтметкуНезаполненныхСтатейДоходовРасходов(Элементы);
	МассивЭлементов = Новый Массив;
	МассивЭлементов.Добавить("ТоварыСтатьяРасходов");
	МассивЭлементов.Добавить("УслугиСтатьяРасходов");
	ФинансыСервер.УстановитьВидимостьКолонокСтатейДиРВТабличнойЧасти(ЭтаФорма, МассивЭлементов, Истина);
	
	ИспользоватьПодключаемоеОборудование = Константы.ИспользоватьПодключаемоеОборудование.Получить();
	
	ОбщийМодульСервер.ДобавитьИндикаторРаботыСоСканерамиШК(ЭтотОбъект);
	
	// Видимость колонки Артикул
	МассивЭлементов = новый Массив();
	МассивЭлементов.Добавить("ТоварыНоменклатураАртикул");
	МассивЭлементов.Добавить("УслугиНоменклатураАртикул");
	ОбщийМодульСервер.УстановитьВидимостьКолонкиАртикулВТабличнойЧасти(ЭтаФорма, МассивЭлементов);
	
	//#10822
	Элементы.ПоступлениеОтПроизводстваУИБ.Видимость = Объект.ПоступлениеОтПроизводстваУИБ ИЛИ Константы.СоздаватьДокументыПоступленийПоУдаленнойБазе.Получить();
	
	//#7805
	//УправлениеРеквизитомАдресаМонтажа();  // закомментироано в рамках заявки #10837 
	
	//#9470
	ОтображатьПредыдущуюЦенуПоступления = Константы.ОтображатьПредыдущуюЦенуПоступленияВДокументахЗакупки.Получить();
	Элементы.ТоварыЦенаПредыдущегоПоступления.Видимость = ОтображатьПредыдущуюЦенуПоступления;
	Элементы.УслугиЦенаПредыдущегоПоступления.Видимость = ОтображатьПредыдущуюЦенуПоступления;
	ЗаполнитьЦеныПредыдущегоПоступления();
	
	ФинансыСервер.ОбновитьВидимостьИКурсВалюты(ЭтотОбъект);
	
	Если НЕ Константы.РазрешитьПоступлениеПоНулевойЦене.Получить() Тогда
		Элементы.ТоварыЦена.АвтоОтметкаНезаполненного = Истина;
		Элементы.УслугиЦена.АвтоОтметкаНезаполненного = Истина;
		Элементы.ТоварыСумма.АвтоОтметкаНезаполненного = Истина;
		Элементы.УслугиСумма.АвтоОтметкаНезаполненного = Истина;
	КонецЕсли;
	
	ОбщийМодульСервер.УстановитьВидимостьПодразделения(ЭтотОбъект);
	
	// №14786
	КонтролироватьПрайсЛистыПриПоступленииТоваров = ПолучитьФункциональнуюОпцию("КонтролироватьПрайсЛистыПриПоступленииТоваров");
	
	УчитыватьНДС = Истина;
	СтавкаНДСПоУмолчанию = Перечисления.СтавкиНДС.БезНДС;
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	ДатыЗапретаИзменения.ОбъектПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	ПриЧтенииСозданииНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииСозданииНаСервере()
		
	РассчитатьИтоговыеПоказателиСервер();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
		
	МенеджерОборудованияКлиентПереопределяемый.НачатьПодключениеОборудованиеПриОткрытииФормы(ЭтаФорма, "СканерШтрихкода");
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	//++ 16321
	Если Объект.Товары.Количество() > 0 И НЕ ЗначениеЗаполнено(Объект.Склад) Тогда
		Сообщить("Поле Склад не заполнено.");
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	//-- 16321
	
	Если НеВыполнятьПроверкуПередЗаписью Тогда
		НеВыполнятьПроверкуПередЗаписью = Ложь;
		Возврат;
	КонецЕсли;
	
	Если ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
		//ВыполнитьПроверкиИЗадатьВопросыПередЗаписью(Отказ, ПараметрыЗаписи);
	КонецЕсли;
	
	ОбщийМодульКлиент.ЗаписатьОбъектПриНеобходимости(ЭтотОбъект, ПараметрыЗаписи, Отказ);
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	Если ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
		Отказ = НЕ ПраваПользователей.РазрешеноПриходоватьНаСклад(Объект.Склад);
		Если Отказ Тогда
			Сообщить("У текущего пользователя нет прав для оформления прихода на склад """ + Объект.Склад + """");
			Возврат;
		КонецЕсли;
		
		// #13896 проверку на 0 цену делать из формы документа
		Если НЕ Константы.РазрешитьПоступлениеПоНулевойЦене.Получить() Тогда
			МассивТЧДляПроверки = Новый Массив;
			МассивТЧДляПроверки.Добавить("Товары");
			МассивТЧДляПроверки.Добавить("Услуги");
			Для каждого ИмяТЧ из МассивТЧДляПроверки Цикл
				Для каждого СтрокаТЧ из Объект[ИмяТЧ] Цикл
					// #14331 контролировать на нулевое значение только сумму. Цену не контролировать.
					//Если СтрокаТЧ.Цена = 0 Тогда
					//	ТекстОшибки = СтрШаблоН("Не заполнена колонка ""Цена"" в строке %1 списка ""%2""", СтрокаТЧ.НомерСтроки, ИмяТЧ);
					//	ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
					//		ТекстОшибки,
					//		Объект.Ссылка,
					//		ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("Объект." + ИмяТЧ, СтрокаТЧ.НомерСтроки, "Цена"),
					//		,
					//		Отказ);
					//КонецЕсли;
					Если СтрокаТЧ.Сумма = 0 Тогда
						ТекстОшибки = СтрШаблоН("Не заполнена колонка ""Сумма"" в строке %1 списка ""%2""", СтрокаТЧ.НомерСтроки, ИмяТЧ);
						ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
						ТекстОшибки,
						Объект.Ссылка,
						ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("Объект." + ИмяТЧ, СтрокаТЧ.НомерСтроки, "Сумма"),
						,
						Отказ);
					КонецЕсли;	
				КонецЦикла;
				
			КонецЦикла;
		КонецЕсли;
		
	КонецЕсли;
	
	// проверяем заполненность статей доходов/расходов
	ФинансыСервер.ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	Оповестить("ЗаписанПоступлениеТоваровИУслуг", Объект.Основание, "ПоступлениеТоваровИУслуг");
	Оповестить("Запись_ПоступлениеТоваровИУслуг", Объект.Ссылка);
	
	Если (ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.Проведение 
		ИЛИ ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения) 
		И ЭтоДокументОбеспеченияРозницы Тогда	
		Оповестить("ЗаписьДокументаОбеспеченияРозницы", Объект.Основание, "ПоступлениеТоваровИУслуг");
	КонецЕсли;
	
	//++ №3172
	Если ПолучитьФункциональнуюОпциюНаСервере("АвтоматическиПереводитьЗаказПоставщикуВСтатусВыполненПриПолномПоступлении")
		И ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.Проведение
		И ТипЗнч(Объект.Основание) = Тип("ДокументСсылка.ЗаказПоставщику")
		И ЗначениеЗаполнено(Объект.Основание) 
		Тогда
		Оповестить("ЗакрытиеЗаказаПоставщику", Объект.Основание, Объект.Ссылка);
	КонецЕсли;
	//-- №3172
	
	//++ №14786
	ЕстьВопросыПослеЗаписи = Ложь; 
	//ПринудительноЗакрытьФорму = ПараметрыЗаписи.ПринудительноЗакрытьФорму; // нет при отмене проведения
	Если Не ПараметрыЗаписи.Свойство("ПринудительноЗакрытьФорму", ПринудительноЗакрытьФорму) Тогда
		ПринудительноЗакрытьФорму = Ложь;
	КонецЕсли;
	Если КонтролироватьПрайсЛистыПриПоступленииТоваров И НЕ Объект.ПометкаУдаления Тогда
		
		МассивЦенКУстановке = УстановкаЦенВызовСервера.ВыполнитьКонтрольПрайсЛистов(Объект.Ссылка);
		
		// Если есть номенклатура, которая не прошла по минимальной наценке, предлагаем по ней установку цен
		Если МассивЦенКУстановке.Количество() > 0 Тогда
			
			ПараметрыФормы = новый Структура;
			ПараметрыФормы.Вставить("МассивЦен", 		МассивЦенКУстановке); 
			ПараметрыФормы.Вставить("Основание", 		Объект.Ссылка);
			ПараметрыФормы.Вставить("Валюта", 			Объект.Валюта);
			
			//ПринудительноЗакрытьФормуПослеЗаписи = Истина;
			ЕстьВопросыПослеЗаписи = Истина;
			ОписаниеОповещения = Новый ОписаниеОповещения("ПослеКонтроляПослеЗаписи", ЭтотОбъект, );
			ОткрытьФорму("Документ.НастройкиКонтроляПрайсЛистов.Форма.ВыборПозицийКУстановке", ПараметрыФормы, , , , , ОписаниеОповещения);
			
		КонецЕсли;
		
	КонецЕсли;
	//-- №14786
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеКонтроляПослеЗаписи(Результат, ДополнительныеПараметры) Экспорт
	
	//#17006 перенесено сюда из условия
	ЕстьВопросыПослеЗаписи = Ложь;
	
	Если ПринудительноЗакрытьФорму Тогда
		//ЕстьВопросыПослеЗаписи = Ложь;
		Закрыть();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	Элементы.ПодменюПечать.Доступность = ПраваПользователей.ДоступностьПечати(Объект.Ссылка);
	
	ОбновитьВидимостьИОстаткиВзаиморасчетов();
	ЗаполнитьЦеныПредыдущегоПоступления();
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	Если НЕ ЗавершениеРаботы Тогда		
		Если ЕстьВопросыПослеЗаписи Тогда
			Отказ = Истина;	
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)
	
	МенеджерОборудованияКлиентПереопределяемый.НачатьОтключениеОборудованиеПриЗакрытииФормы(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	
	Если ИсточникВыбора.ИмяФормы = "ОбщаяФорма.ФормаПодбораНоменклатуры" Тогда	
		ОбработкаВыбораПодборНаКлиенте(ВыбранноеЗначение);
		
	ИначеЕсли ИсточникВыбора.ИмяФормы = "Обработка.ЗагрузкаНоменклатурыИзExcel.Форма.ЗагрузкаВТабличнуюЧасть" Тогда
		
		ПолучитьЗагруженныеТоварыИзХранилища(ВыбранноеЗначение.АдресТоваровВХранилище);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	Если ИмяСобытия = "ИзменениеПлощадиПотолкаВКарточкеНоменклатуры" и Источник = "Номенклатура" Тогда
		ОбработатьИзменениеПлощадиПотолкаНаСервере(Параметр);
	ИначеЕсли Источник = "ПодключаемоеОборудование" И ИмяСобытия = "ScanData" И ВводДоступен() И НЕ ЭтаФорма.ТолькоПросмотр Тогда		
		ОбработатьШтрихкод(Параметр);
	КонецЕсли;
КонецПроцедуры

