				Продолжить;
			КонецЕсли;
			
			Если Справочники.ВидыНоменклатуры.ЭтоНоменклатураУслуга(ТекущаяСтрока.Номенклатура) Тогда 
				Продолжить;
			КонецЕсли;
			
			Движение = Движения.ОбеспечениеЗаказовРозницы.Добавить();
			//Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
			Движение.Заказ 			= Основание;
			Движение.Период 		= Дата;			
			Движение.Номенклатура 	= ТекущаяСтрока.Номенклатура;
			Движение.ХарактеристикаНоменклатуры 	= ТекущаяСтрока.ХарактеристикаНоменклатуры;
			Движение.Комната 		= ТекущаяСтрока.Комната;
			Движение.Назначение 	= ТекущаяСтрока.Назначение;
			Движение.Количество 	= ТекущаяСтрока.Количество;
			Движение.КоличествоПоФакту = ТекущаяСтрока.Количество;
			//#4679
			Если Справочники.ВидыНоменклатуры.ЭтоНоменклатураПотолкаИлиОтреза(ТекущаяСтрока.Номенклатура) Тогда 
				Движение.Количество = 1;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	//#16643
	Если ЗначениеЗаполнено(Основание) 
		И ТипЗнч(Основание) = Тип("ДокументСсылка.ЗаказПоставщику") Тогда		
		//#16643
		ОбщийМодульСервер.ОжидаемыеПоставки_Рассчитать(Основание);
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	
	Движения.ЗаказыПоставщикам.ОчиститьДвижения(Ссылка, Отказ); // нужно для ОжидаемыеПоставки_УдалитьЗаписиПоЗаказу
	
	//#16643
	Если ЗначениеЗаполнено(Основание) 
		И ТипЗнч(Основание) = Тип("ДокументСсылка.ЗаказПоставщику") Тогда		
		//#16643
		ОбщийМодульСервер.ОжидаемыеПоставки_Рассчитать(Основание);
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	//#13710
	ОбщийМодульСервер.ПроверитьИзменениеВзаиморасчетовПриЗаписи(ЭтотОбъект, Отказ);
	
КонецПроцедуры

