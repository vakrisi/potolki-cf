#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
	
#Область ОбработчикиСобытий

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка) 
	
	Если ЭтоНовый() Тогда		
		ИнициализироватьСлужебныеРеквизиты();		
	КонецЕсли;
	
	ОбщийМодуль.ЗаполнитьШапкуДокумента(ЭтотОбъект);
	
	ТипДанныхЗаполнения = ТипЗнч(ДанныеЗаполнения);
	
	Если ТипДанныхЗаполнения = Тип("Структура") Тогда
		Если ДанныеЗаполнения.Свойство("Основание") Тогда
			Если ТипЗнч(ДанныеЗаполнения.Основание) = Тип("ДокументСсылка.ЗаказНаПроизводство")
				И ДанныеЗаполнения.Свойство("ТолькоМатериалы") Тогда
				ЗаполнитьПоЗаказуНаПроизводство(ДанныеЗаполнения.Основание, ДанныеЗаполнения.ТолькоМатериалы);
			КонецЕсли;
		КонецЕсли;		
		
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.РеализацияТоваровИУслуг") Тогда
		// Заполнение шапки
		
		ОбщийМодуль.ЗаполнитьШапкуДокумента(ЭтотОбъект);
		
		// реквизиты ПоступлениеОтПроизводства и ПоступлениеОтПроизводстваПоРучнымЗаказам заполняются в общем модуле в процедуре СозданиеПоступленийПоРеализациямОтПроизводства
		// далее идет вызов Заполнить()
		
		Валюта = ДанныеЗаполнения.Валюта;
		ВхДата = ДанныеЗаполнения.Дата;
		ВхНомер = ДанныеЗаполнения.Номер;
		Основание = ДанныеЗаполнения.Ссылка;
		СуммаДокумента = ДанныеЗаполнения.СуммаДокумента;
		НомерРозничногоДоговора	= ДанныеЗаполнения.НомерРозничногоДоговора; //#7381
		АдресМонтажа = ДанныеЗаполнения.АдресМонтажа; //#10837
		
		//#10239 для случая ручного создания Поступления из Реализации, а не по регламенту и не из АРМ
		Если НЕ ПоступлениеОтПроизводства Тогда 
			ПоступлениеОтПроизводства = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДанныеЗаполнения, "АвтоматическиСоздатьДокументПоступленияОтПроизводстваНаРозницуПоИнтеркампани");
		КонецЕсли;
		Если НЕ ПоступлениеОтПроизводстваПоРучнымЗаказам Тогда 
			ПоступлениеОтПроизводстваПоРучнымЗаказам = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДанныеЗаполнения, "АвтоматическиСоздатьДокументПоступленияОтПроизводстваНаРозницуСозданныхВручную");
		КонецЕсли;
		
		//Если документ создается на основании РТиУ, которое было создано на основании ЗаказаПокупателя с заполненной настройкой интеркампани
		Если ПоступлениеОтПроизводства Тогда // ПоступлениеОтПроизводства = Реализация.АвтоматическиСоздатьДокументПоступленияОтПроизводстваНаРозницуПоИнтеркампани
			Если НЕ ДанныеЗаполнения.НастройкаИнтеркампани.Пустая() Тогда
				Организация = Справочники.Организации.ПолучитьОрганизациюПоКонтрагенту(ДанныеЗаполнения.Контрагент, ДанныеЗаполнения.НастройкаИнтеркампани);
				Контрагент  = Справочники.Организации.ПолучитьКонтрагентаПоОрганизации(ДанныеЗаполнения.Организация, ДанныеЗаполнения.НастройкаИнтеркампани);
				Склад 		= Справочники.НастройкиИнтеркампани.ПолучитьСкладРозницыПриПоступленииТоваров(ДанныеЗаполнения.НастройкаИнтеркампани); //#7764
			Иначе
				Организация = Справочники.Организации.ПолучитьОрганизациюПоКонтрагенту(ДанныеЗаполнения.Контрагент, Неопределено);
				Контрагент  = Справочники.Организации.ПолучитьКонтрагентаПоОрганизации(ДанныеЗаполнения.Организация, Неопределено);
			КонецЕсли;
		КонецЕсли;
		
		Если ПоступлениеОтПроизводстваПоРучнымЗаказам Тогда // ПоступлениеОтПроизводстваПоРучнымЗаказам = Реализация.АвтоматическиСоздатьДокументПоступленияОтПроизводстваНаРозницуСозданныхВручную
			
			//++ №7764 комментируем, возвращаем ранее имеющуюся логику
			//Организация = ДанныеЗаполнения.ОрганизацияПоступления;
			//Контрагент = ДанныеЗаполнения.КонтрагентПоступления;
			//Склад = ДанныеЗаполнения.СкладПоступления; 
			//#7764
			
			МенеджерЗаписи = РегистрыСведений.СвязкиОрганизацийПроизводстваКонтрагентРозницы.СоздатьМенеджерЗаписи();
			МенеджерЗаписи.Организация = ДанныеЗаполнения.Организация;
			МенеджерЗаписи.Контрагент  = ДанныеЗаполнения.Контрагент;
			МенеджерЗаписи.Прочитать();
			Если МенеджерЗаписи.Выбран() Тогда
				Организация = МенеджерЗаписи.ОрганизацияПоступления;
				Контрагент  = МенеджерЗаписи.КонтрагентПоступления;
				Склад  		= МенеджерЗаписи.СкладПоступления;
			КонецЕсли;
			
		КонецЕсли;
		
		ДоговорКонтрагента = Контрагент.ОсновнойДоговор;
		
		Если НЕ ПоступлениеОтПроизводства И НЕ ПоступлениеОтПроизводстваПоРучнымЗаказам Тогда
			ЗаполнитьТаблицыТоваровИУслугПоОснованию(ДанныеЗаполнения.Товары, ДанныеЗаполнения.Услуги, ДанныеЗаполнения);
		Иначе
			ЗаполнитьТаблицыТоваровИУслугПоИнтеркампани(ДанныеЗаполнения);			
		КонецЕсли;
		
		СуммаДокумента = Товары.Итог("Сумма") + Услуги.Итог("Сумма");
		
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ЗаказДоговор") Тогда
		
		ЗаполнитьПоЗаказДоговоруМонтажу(ДанныеЗаполнения);
		
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.Монтаж") Тогда
		
		ЗаполнитьПоЗаказДоговоруМонтажу(ДанныеЗаполнения);
		
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ЗаказПоставщику") Тогда
		
		Основание 			= ДанныеЗаполнения;
		Организация 		= ДанныеЗаполнения.Организация;
		Подразделение 		= ДанныеЗаполнения.Подразделение;
		Контрагент 			= ДанныеЗаполнения.Контрагент;
		ДоговорКонтрагента 	= ДанныеЗаполнения.ДоговорКонтрагента;
		ВидЦеныПоставщика 	= ДанныеЗаполнения.ВидЦеныПоставщика;
		Валюта 				= ДанныеЗаполнения.Валюта;
		Склад				= ДанныеЗаполнения.Склад; // №11352
		
		СтруктураПоискаСтроки = Новый Структура("Номенклатура, ХарактеристикаНоменклатуры, ЕдиницаИзмерения, Цена");
		//получим перечень товаров, которые еще не оприходованы по заказу
		НеполученныеТовары = РегистрыНакопления.ЗаказыПоставщикам.ПолучитьТоварыКСписанию(ТекущаяДатаСеанса(), ДанныеЗаполнения.Ссылка, Организация, ДанныеЗаполнения.Товары, Ссылка);
		Для Каждого ТекущаяСтрока Из НеполученныеТовары Цикл
			ЭтоУслуги = Ложь;
			Если Справочники.ВидыНоменклатуры.ЭтоНоменклатураУслуга(ТекущаяСтрока.Номенклатура) Тогда
				НоваяСтрока = Услуги.Добавить();
				ЭтоУслуги = Истина;
			Иначе
				НоваяСтрока = Товары.Добавить();
			КонецЕсли;
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущаяСтрока);
			//НоваяСтрока.Сумма = НоваяСтрока.Количество * НоваяСтрока.Цена; //#8742
			Если НоваяСтрока.Коэффициент = 0 Тогда				
				Сообщить("В документе-основании у номенклатуры " + НоваяСтрока.Номенклатура + " не указан коэффициент. Расчетное количество к поступлению может быть не верным!");
			КонецЕсли;
			
			ЗаполнитьЗначенияСвойств(СтруктураПоискаСтроки, ТекущаяСтрока);
			НайденныеСтроки = ДанныеЗаполнения.Товары.НайтиСтроки(СтруктураПоискаСтроки);
			Если НайденныеСтроки.Количество() > 0 Тогда
				НоваяСтрока.СтавкаНДС = НайденныеСтроки[0].СтавкаНДС;
				ОбработкаТабличныхЧастейСервер.ПересчитатьСуммуНДСВСтрокеТЧ(НоваяСтрока, Истина);
			КонецЕсли;

		КонецЦикла;
		
		СуммаДокумента = Товары.Итог("Сумма") + Услуги.Итог("Сумма");
		
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ЗаказНаПроизводство") Тогда
		
		ЗаполнитьПоЗаказуНаПроизводство(ДанныеЗаполнения);
		
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ЗаказПокупателя") Тогда
		
		Документы.ЗаказПокупателя.ПроверитьВозможностьВводаНаОснованииЗаказа(ДанныеЗаполнения);
		
		ОбщийМодуль.ЗаполнитьШапкуДокумента(ЭтотОбъект);
		//Комментарий = ДанныеЗаполнения.Комментарий; //#5849
		Основание = ДанныеЗаполнения.Ссылка;
		Организация = ДанныеЗаполнения.Организация;
		Подразделение = ДанныеЗаполнения.Подразделение; //#5775
		АдресМонтажа = ДанныеЗаполнения.АдресМонтажа; //#10837
		
		Для Каждого ТекущаяСтрокаТоварыОснования Из ДанныеЗаполнения.Товары Цикл
			Если Справочники.ВидыНоменклатуры.ЭтоНоменклатураУслуга(ТекущаяСтрокаТоварыОснования.Номенклатура) Тогда
				НоваяСтрока = Услуги.Добавить();			
			Иначе
				НоваяСтрока = Товары.Добавить();				
			КонецЕсли;
			ЗаполнитьЗначенияСвойств(НоваяСтрока,ТекущаяСтрокаТоварыОснования,,"Сумма");				
			Если НоваяСтрока.Количество > 0 Тогда
				НоваяСтрока.Сумма = НоваяСтрока.Цена * НоваяСтрока.Количество;
			КонецЕсли;
		КонецЦикла;
		
		СуммаДокумента = Товары.Итог("Сумма") + Услуги.Итог("Сумма");
		
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ЗаявкаНаДоставку") Тогда	
		
		Основание = ДанныеЗаполнения.Ссылка;
		Организация = Основание.Организация;
		Контрагент = Основание.Экспедитор;
		ДоговорКонтрагента = Контрагент.ОсновнойДоговор;
		Валюта = Основание.Валюта;
		
		НоваяСтрока = Услуги.Добавить();
		НоваяСтрока.Номенклатура = Константы.НоменклатураДоставки.Получить();
		НоваяСтрока.Количество = 1;
		НоваяСтрока.Цена = Основание.СтоимостьДоставки;
		НоваяСтрока.Сумма = Основание.СтоимостьДоставки;
		НоваяСтрока.ЕдиницаИзмерения = НоваяСтрока.Номенклатура.БазоваяЕдиницаИзмерения;
		НоваяСтрока.Коэффициент = 1;
		
		СуммаДокумента = Товары.Итог("Сумма") + Услуги.Итог("Сумма");
		
	КонецЕсли;
	
	СтатьяРасходов = ФинансыСервер.ПолучитьСтатьюДоходовРасходов(ЭтотОбъект, , Ложь);
	
	Если ЭтоНовый() Тогда
		ДозаполнитьПоУмолчанию();
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	
	ИнициализироватьСлужебныеРеквизиты(); 
	
	ДозаполнитьПоУмолчанию();
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	Если ТипЗнч(Основание) = Тип("ДокументСсылка.ЗаказДоговор") И НЕ Основание.Пустая() Тогда
		//Всё ок, проверяемые реквизиты комната и назначение оставляем
		
		//#4679
		Если ПолучитьФункциональнуюОпцию("КоличествоТоваровКСписаниюВРозницеНеСоответствуетКоличествуПроданногоТовара") Тогда
			РеквизитКоличество = ПроверяемыеРеквизиты.Найти("Товары.Количество");
			Если НЕ РеквизитКоличество = Неопределено Тогда
				ПроверяемыеРеквизиты.Удалить(РеквизитКоличество);
			КонецЕсли;
		КонецЕсли;
		
		Если НЕ СозданПриИспользованииНастройкиУчетОбеспеченностиРозницыПоКомнатам И ПроверяемыеРеквизиты.Найти("Товары.Комната") <> Неопределено Тогда			
			ПроверяемыеРеквизиты.Удалить(ПроверяемыеРеквизиты.Найти("Товары.Комната"));
		КонецЕсли;
		
	Иначе
		Если ПроверяемыеРеквизиты.Найти("Товары.Комната") <> Неопределено Тогда			
			ПроверяемыеРеквизиты.Удалить(ПроверяемыеРеквизиты.Найти("Товары.Комната"));
		КонецЕсли;
		Если ПроверяемыеРеквизиты.Найти("Товары.Назначение") <> Неопределено Тогда
			ПроверяемыеРеквизиты.Удалить(ПроверяемыеРеквизиты.Найти("Товары.Назначение"));
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Документы.ЗаказПокупателя.ПроверитьЗаполнениеНаОснованииЗаказа(ЭтотОбъект, Отказ, РежимЗаписи);
	
	Документы.ЗаказДоговор.ПроверитьКомнатыПоЗаказу(ЭтотОбъект, Отказ, РежимЗаписи);
	
	// №12269
	Документы.ПоступлениеТоваровИУслуг.ПроверитьКоличествоИПлощадьПотолка(ЭтотОбъект, Отказ, РежимЗаписи);
	
	//#13710
	ОбщийМодульСервер.ПроверитьИзменениеВзаиморасчетовПередЗаписью(ЭтотОбъект, РежимЗаписи);
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, Режим)
	
	ОрганизацияТоваров = Организация;
	Если Константы.ОбщиеСклады.Получить() Тогда
		ОрганизацияТоваров = Справочники.Организации.ПустаяСсылка();
	КонецЕсли;
	
	//приход на склад
	Движения.ТоварыНаСкладах.Записывать = Истина;
	Для Каждого Товар Из Товары Цикл
		Движение = Движения.ТоварыНаСкладах.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
		Движение.Период = Ссылка.Дата;
		Движение.Организация = ОрганизацияТоваров;
		Движение.Склад = Склад;
		Движение.Номенклатура = Товар.Номенклатура;
		Движение.ХарактеристикаНоменклатуры = Товар.ХарактеристикаНоменклатуры;
		Движение.СерияНоменклатуры = Товар.СерияНоменклатуры;
		Движение.Количество = Товар.Количество * Товар.Коэффициент;
		//Если не Товары.Количество() = 0 Тогда
		//	Коэффициент = 1 / Товары.Количество();
		//Иначе
		//	Коэффициент = 1;
		//КонецЕсли;
		//Если НЕ Товары.Итог("Сумма") = 0 Тогда
		//	Коэффициент = Товар.Сумма / Товары.Итог("Сумма");
		//КонецЕсли;
		СуммаСебестоимостиСУчетомДоставки = ПолучитьСуммуСУчетомДоставки(Товар); //Товар.Сумма + Окр(СтоимостьДоставки * Коэффициент,2); 
		Движение.Сумма = РаботаСВалютой.ПолучитьСуммуВВалютеУчетаПоДокументу(Ссылка, СуммаСебестоимостиСУчетомДоставки);
		Движение.СуммаВал = РаботаСВалютой.ПолучитьСуммуВДопВалютеУчетаПоДокументу(Ссылка, СуммаСебестоимостиСУчетомДоставки); //#8288 
	КонецЦикла;
	
	Для Каждого Товар Из Услуги Цикл
		Если НЕ Товар.Потолок.Пустая() Тогда
			Движение = Движения.ТоварыНаСкладах.Добавить();
			Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
			Движение.Период = Ссылка.Дата;
			Движение.Организация = ОрганизацияТоваров;
			Движение.Склад = Склад;
			Движение.Номенклатура = Товар.Потолок;
			Движение.Сумма = РаботаСВалютой.ПолучитьСуммуВВалютеУчетаПоДокументу(Ссылка, Товар.Сумма);
			Движение.СуммаВал = РаботаСВалютой.ПолучитьСуммуВДопВалютеУчетаПоДокументу(Ссылка, Товар.Сумма); //#8288
		КонецЕсли;
	КонецЦикла;
	
	//запись взаиморасчетов
	Движения.ВзаиморасчетыСКонтрагентами.Записывать = Истина;
	Движение = Движения.ВзаиморасчетыСКонтрагентами.Добавить();
	Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
