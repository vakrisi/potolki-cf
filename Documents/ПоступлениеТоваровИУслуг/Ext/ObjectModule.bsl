Процедура ЗаполнитьПоЗаказуНаПроизводство(ДанныеЗаполнения, ТолькоМатериалы = Ложь)
	
	Документы.ЗаказНаПроизводство.ПроверитьВозможностьВводаНаОснованииЗаказа(ДанныеЗаполнения);

	Валюта 			= ДанныеЗаполнения.Валюта;
	Основание 		= ДанныеЗаполнения.Ссылка;		
	Организация 	= ДанныеЗаполнения.Организация;
		
	Если НЕ ТолькоМатериалы Тогда
		ЗаполнитьТаблицыТоваровИУслугПоОснованию(ДанныеЗаполнения.Товары, ДанныеЗаполнения.Услуги, ДанныеЗаполнения);	
	Иначе	
		
		Для Каждого ТекСтрокаОснования Из ДанныеЗаполнения.Материалы Цикл
			// #13705 убрана проверка на Вид номенклатуры
			//Если ТекСтрокаОснования.Номенклатура.ВидНоменклатуры = Справочники.ВидыНоменклатуры.Полотно Тогда
				НоваяСтрока = Товары.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрокаОснования);
			//КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	СуммаДокумента = Товары.Итог("Сумма") + Услуги.Итог("Сумма");
	
КонецПроцедуры

Процедура ЗаполнитьПоЗаказДоговоруМонтажу(ДанныеЗаполнения)
	
	ОбщийМодуль.ЗаполнитьШапкуДокумента(ЭтотОбъект);
	//Комментарий = ДанныеЗаполнения.Комментарий; //#5849
	Основание 	= ДанныеЗаполнения;
	Организация = ДанныеЗаполнения.Организация;
	Валюта 		= ДанныеЗаполнения.Валюта;
	
	ДобавлятьТовары 	= Константы.ЗаказПоставщикуЗаказыватьТовары.Получить();
	ДобавлятьМатериалы 	= Константы.ЗаказПоставщикуЗаказыватьМатериалы.Получить();
	
	МенеджерВТ = Новый МенеджерВременныхТаблиц;
	РегистрыНакопления.ОбеспечениеЗаказовРозницы.ПолучитьОстаткиКОбеспечению(МенеджерВТ, ДанныеЗаполнения, Ссылка, СозданПриИспользованииНастройкиУчетОбеспеченностиРозницыПоКомнатам);
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВТ_Товары.Комната КАК Комната,
	|	ВТ_Товары.Номенклатура КАК Номенклатура,
	|	ВТ_Товары.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	|	ВТ_Товары.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	ВТ_Товары.Коэффициент КАК Коэффициент,
	|	ВТ_Товары.Назначение КАК Назначение,
	|	ВТ_Товары.НомерПотолка КАК НомерПотолка,
	|	ВТ_Товары.КоличествоКОбеспечению КАК Количество
	|ИЗ
	|	ВТ_ТоварыКОбеспечениюСвернуто КАК ВТ_Товары
	|ГДЕ
	|	ВТ_Товары.КоличествоКОбеспечению > 0
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВТ_Материалы.Комната КАК Комната,
	|	ВТ_Материалы.Номенклатура КАК Номенклатура,
	|	ВТ_Материалы.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	|	ВТ_Материалы.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	ВТ_Материалы.Коэффициент КАК Коэффициент,
	|	ВТ_Материалы.Назначение КАК Назначение,
	|	ВТ_Материалы.КоличествоКОбеспечению КАК Количество
	|ИЗ
	|	ВТ_МатериалыКОбеспечениюСвернуто КАК ВТ_Материалы
	|ГДЕ
	|	ВТ_Материалы.КоличествоКОбеспечению > 0";
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	ВыборкаТоваров = РезультатЗапроса[0].Выбрать();
	ВыборкаМатериалов = РезультатЗапроса[1].Выбрать();
	
	Пока ВыборкаТоваров.Следующий()  Цикл
		Если Справочники.ВидыНоменклатуры.ЭтоНоменклатураПотолкаИлиОтреза(ВыборкаТоваров.Номенклатура) Тогда
			НоваяСтрока = Товары.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ВыборкаТоваров);
			//#4679
			Если ПолучитьФункциональнуюОпцию("КоличествоТоваровКСписаниюВРозницеНеСоответствуетКоличествуПроданногоТовара") Тогда
				НоваяСтрока.Количество = НоваяСтрока.Номенклатура.Потолок_КоличествоПродукция;
			КонецЕсли;
		ИначеЕсли ВыборкаТоваров.Номенклатура.ВидНоменклатуры = Справочники.ВидыНоменклатуры.Материал и ДобавлятьТовары Тогда
			НоваяСтрока = Товары.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ВыборкаТоваров);
			Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ЗаказДоговор") И НЕ ПустаяСтрока(ВыборкаТоваров.НомерПотолка) Тогда
				НоваяСтрока.Потолок = Документы.ЗаказДоговор.ПолучитьПотолокОснованияПоНомеру(ДанныеЗаполнения.ТоварыУслуги, ВыборкаТоваров.НомерПотолка);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Если ДобавлятьМатериалы Тогда
		Пока ВыборкаМатериалов.Следующий() Цикл
			НоваяСтрока = Товары.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ВыборкаМатериалов);
			//НоваяСтрока.Назначение = "Материалы";
		КонецЦикла;
	КонецЕсли;
	
	СуммаДокумента = Товары.Итог("Сумма") + Услуги.Итог("Сумма");
	
КонецПроцедуры

Процедура ЗаполнитьТаблицыТоваровИУслугПоОснованию(ОснованиеТовары, ОснованиеУслуги, Основание = Неопределено)
	Для Каждого ТекСтрокаТовары Из ОснованиеТовары Цикл
		НоваяСтрока = Товары.Добавить();
		НоваяСтрока.ЕдиницаИзмерения = ТекСтрокаТовары.ЕдиницаИзмерения;
		НоваяСтрока.Количество = ТекСтрокаТовары.Количество;
		НоваяСтрока.Коэффициент = ТекСтрокаТовары.Коэффициент;
		НоваяСтрока.Номенклатура = ТекСтрокаТовары.Номенклатура;
		НоваяСтрока.СерияНоменклатуры = ТекСтрокаТовары.СерияНоменклатуры;
		НоваяСтрока.Сумма = ТекСтрокаТовары.Сумма;
		НоваяСтрока.ХарактеристикаНоменклатуры = ТекСтрокаТовары.ХарактеристикаНоменклатуры;
		НоваяСтрока.Цена = ТекСтрокаТовары.Цена;
		Если ТипЗнч(Основание) = Тип("ДокументСсылка.ЗаказНаПроизводство") Тогда 
			НоваяСтрока.Потолок = ?(Основание.ВидЗаказа = Перечисления.ВидыЗаказовНаПроизводство.ПроизводствоПотолка, Основание.ПродукцияНоменклатура, Справочники.Номенклатура.ПустаяСсылка());		
		ИначеЕсли ТипЗнч(Основание) = Тип("ДокументСсылка.РеализацияТоваровИУслуг") Тогда
			НоваяСтрока.Потолок = ТекСтрокаТовары.Потолок;
		ИначеЕсли ТипЗнч(Основание) = Тип("Структура") И Основание.Свойство("УИБ") Тогда
			НоваяСтрока.Потолок = ТекСтрокаТовары.Потолок;
		КонецЕсли;
	КонецЦикла;
	Для Каждого ТекСтрокаУслуги Из ОснованиеУслуги Цикл
		НоваяСтрока = Услуги.Добавить();
		НоваяСтрока.ЕдиницаИзмерения = ТекСтрокаУслуги.ЕдиницаИзмерения;
		НоваяСтрока.Количество = ТекСтрокаУслуги.Количество;
		НоваяСтрока.Коэффициент = ТекСтрокаУслуги.Коэффициент;
		НоваяСтрока.Номенклатура = ТекСтрокаУслуги.Номенклатура;
		НоваяСтрока.Сумма = ТекСтрокаУслуги.Сумма;
		НоваяСтрока.Цена = ТекСтрокаУслуги.Цена;
		Если ТипЗнч(Основание) = Тип("ДокументСсылка.ЗаказНаПроизводство") Тогда 
			НоваяСтрока.Потолок = ?(Основание.ВидЗаказа = Перечисления.ВидыЗаказовНаПроизводство.ПроизводствоПотолка, Основание.ПродукцияНоменклатура, Справочники.Номенклатура.ПустаяСсылка());
		ИначеЕсли ТипЗнч(Основание) = Тип("ДокументСсылка.РеализацияТоваровИУслуг") Тогда
			НоваяСтрока.Потолок = ТекСтрокаУслуги.Потолок;
		ИначеЕсли ТипЗнч(Основание) = Тип("Структура") И Основание.Свойство("УИБ") Тогда
			НоваяСтрока.Потолок = ТекСтрокаУслуги.Потолок;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Процедура ЗаполнитьТаблицыТоваровИУслугПоИнтеркампани(ДанныеЗаполнения) Экспорт
	//проверяем, нужно ли стоимость услуг отнести на потолок
	Если НЕ Константы.СтоимостьПотолкаВключаетУслугиРаскрояПриПокупкеДляРозницы.Получить() Тогда
		ЗаполнитьТаблицыТоваровИУслугПоОснованию(ДанныеЗаполнения.Товары, ДанныеЗаполнения.Услуги, ДанныеЗаполнения);
	Иначе
		
		СуммаУслугОснования = ДанныеЗаполнения.Услуги.Итог("Сумма");
		//получим общее количество потолков в документе-основании
		КоличествоПотолковВсего = 0;
		Для Каждого ТекущаяСтрока Из ДанныеЗаполнения.Товары Цикл
			Если Справочники.ВидыНоменклатуры.ЭтоНоменклатураПотолкаИлиОтреза(ТекущаяСтрока.Номенклатура) Тогда
				КоличествоПотолковВсего = КоличествоПотолковВсего + ТекущаяСтрока.Количество;
			КонецЕсли;
		КонецЦИкла;
		
		ВсегоРаспределено = 0;
		НомерСтрокиПоследнегоПотолка = 0;
		Если КоличествоПотолковВсего > 0 Тогда
			Для Каждого ТекСтрокаТовары Из ДанныеЗаполнения.Товары Цикл
				НоваяСтрока = Товары.Добавить();
				НоваяСтрока.ЕдиницаИзмерения = ТекСтрокаТовары.ЕдиницаИзмерения;
				НоваяСтрока.Количество = ТекСтрокаТовары.Количество;
				НоваяСтрока.Коэффициент = ТекСтрокаТовары.Коэффициент;
				НоваяСтрока.Номенклатура = ТекСтрокаТовары.Номенклатура;
				НоваяСтрока.СерияНоменклатуры = ТекСтрокаТовары.СерияНоменклатуры;
				НоваяСтрока.Сумма = ТекСтрокаТовары.Сумма;
				НоваяСтрока.ХарактеристикаНоменклатуры = ТекСтрокаТовары.ХарактеристикаНоменклатуры;
				НоваяСтрока.Цена = ТекСтрокаТовары.Цена;
				//добавим стоимость услуг, если это потолок
				Если Справочники.ВидыНоменклатуры.ЭтоНоменклатураПотолкаИлиОтреза(НоваяСтрока.Номенклатура) Тогда
					НомерСтрокиПоследнегоПотолка = НоваяСтрока.НомерСтроки;
					Если СуммаУслугОснования > 0 Тогда
						СуммаКРаспределению = Окр(СуммаУслугОснования * (НоваяСтрока.Количество / КоличествоПотолковВсего),2);
					Иначе
						СуммаКРаспределению = 0;
					КонецЕсли;	
					НоваяСтрока.Сумма = ТекСтрокаТовары.Сумма + СуммаКРаспределению;
					ВсегоРаспределено = ВсегоРаспределено + СуммаКРаспределению;
					Если НЕ НоваяСтрока.Количество = 0 Тогда
						НоваяСтрока.Цена = НоваяСтрока.Сумма / НоваяСтрока.Количество;
					Иначе
						НоваяСтрока.Цена = НоваяСтрока.Сумма;
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
			Если НЕ НомерСтрокиПоследнегоПотолка = 0 Тогда
				//распределим хвостик от суммы
				СуммаКРаспределению = ДанныеЗаполнения.СуммаДокумента - Товары.Итог("Сумма");
				Если НЕ СуммаКРаспределению = 0 Тогда
					Товары[НомерСтрокиПоследнегоПотолка-1].Сумма = Товары[НомерСтрокиПоследнегоПотолка-1].Сумма + СуммаКРаспределению;
					Если НЕ Товары[НомерСтрокиПоследнегоПотолка-1].Количество = 0 Тогда
						Товары[НомерСтрокиПоследнегоПотолка-1].Цена = Товары[НомерСтрокиПоследнегоПотолка-1].Сумма / Товары[НомерСтрокиПоследнегоПотолка-1].Количество;
					Иначе
						Товары[НомерСтрокиПоследнегоПотолка-1].Цена = Товары[НомерСтрокиПоследнегоПотолка-1].Сумма;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		Если НомерСтрокиПоследнегоПотолка = 0 Тогда
			Товары.Очистить();
			Услуги.Очистить();
			ЗаполнитьТаблицыТоваровИУслугПоОснованию(ДанныеЗаполнения.Товары, ДанныеЗаполнения.Услуги, ДанныеЗаполнения);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьСуммуСУчетомДоставки(ТекущаяСтрока) Экспорт
	
	СуммаСебестоимостиСУчетомДоставки = ТекущаяСтрока.Сумма;
	Если СтоимостьДоставки <> 0 Тогда
		Если ПорядокРаспределенияСтоимостиДоставки = 0 Тогда  //По доле стоимости позиции в общей сумме документа
			Если НЕ Товары.Итог("Сумма") = 0 Тогда
				СуммаСебестоимостиСУчетомДоставки = СуммаСебестоимостиСУчетомДоставки + Окр(СтоимостьДоставки * ТекущаяСтрока.Сумма / Товары.Итог("Сумма"), 2);
			Иначе
				СуммаСебестоимостиСУчетомДоставки = СуммаСебестоимостиСУчетомДоставки + Окр(СтоимостьДоставки / Товары.Количество(), 2);
			КонецЕсли;
			
		ИначеЕсли ПорядокРаспределенияСтоимостиДоставки = 1 Тогда  //Попозиционно в равных долях
			СуммаСебестоимостиСУчетомДоставки = СуммаСебестоимостиСУчетомДоставки + Окр(СтоимостьДоставки / Товары.Количество(), 2);
			
		ИначеЕсли ПорядокРаспределенияСтоимостиДоставки = 2 Тогда  //По доле стоимости позиции в общей сумме документа
			Если НЕ Товары.Итог("Количество") = 0 Тогда
				СуммаСебестоимостиСУчетомДоставки = СуммаСебестоимостиСУчетомДоставки + Окр(СтоимостьДоставки * ТекущаяСтрока.Количество / Товары.Итог("Количество"), 2);
			Иначе
				СуммаСебестоимостиСУчетомДоставки = СуммаСебестоимостиСУчетомДоставки + Окр(СтоимостьДоставки / Товары.Количество(), 2);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	Возврат СуммаСебестоимостиСУчетомДоставки;
	
