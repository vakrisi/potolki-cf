&НаСервереБезКонтекста
Функция ПолучитьСписокПоясненийРезультата()
	
	Результат = Новый СписокЗначений;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ПоясненияРезультатаВходящегоКонтакта.Ссылка
	|ИЗ
	|	Справочник.ПоясненияРезультатаВходящегоКонтакта КАК ПоясненияРезультатаВходящегоКонтакта
	|ГДЕ
	|	ПоясненияРезультатаВходящегоКонтакта.ПометкаУдаления = ЛОЖЬ";
	
	РезультатЗапроса = Запрос.Выполнить().Выбрать();
	Пока РезультатЗапроса.Следующий() Цикл
		Результат.Добавить(РезультатЗапроса.Ссылка);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

//ПРОЦЕДУРЫ И ФУНКЦИИ НА СЕРВЕРЕ
&НаСервере
Процедура ВызватьПроведениеДокумента()
	Объект.Ссылка.ПолучитьОбъект().Записать(РежимЗаписиДокумента.Проведение);
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Ключ.Пустая() Тогда
		ОбщийМодуль.ЗаполнитьШапкуДокумента(Объект);
		
		Если Параметры.ТочкаПродаж.Пустая() Тогда
			Объект.ТочкаПродаж = Справочники.Пользователи.НайтиПоНаименованию(СокрЛП(ИмяПользователя())).ТочкаПродаж;
		Иначе
			Объект.ТочкаПродаж = Параметры.ТочкаПродаж;
		КонецЕсли;
		
		Объект.СотовыйТелефонКлиента = Параметры.СотовыйТелефонКлиента;
		Объект.ВидКонтакта = Параметры.ВидКонтакта;
	Иначе
		ЭтаФорма.ТолькоПросмотр = ПраваПользователей.ДокументТолькоПросмотр(Объект.Ссылка);
	КонецЕсли;
	
	ПраваПользователей.УстановитьТолькоПросмотрДляРеквизитаНомер(Элементы.Номер.ТолькоПросмотр);
	
КонецПроцедуры

&НаСервере
Функция ПолучитьСсылкуНаОбъект()
	Возврат Объект.Ссылка;
КонецФункции

//ПРОЦЕДУРЫ И ФУНКЦИИ НА КЛИЕНТЕ
&НаКлиенте
Процедура Замер(Команда)
	
	Если ПроверитьЗаполнение() Тогда
		Объект.Результат = ПолучитьРезультатЗамер();
		Объект.ПояснениеРезультатаВходящегоКонтакта = "";
		ЭтаФорма.Записать();
		ВызватьПроведениеДокумента();
	
		ПараметрыЗамера = Новый Структура("Основание", ПолучитьСсылкуНаОбъект());
		ФормаЗамера = ПолучитьФорму("Документ.Замер.ФормаОбъекта",ПараметрыЗамера);
		ФормаЗамера.Открыть();
	
		ЭтаФорма.Закрыть();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыборРезультатаОтказ(ВыбранныйЭлемент, ДополнительныеПараметры) Экспорт 
	Попытка
		Объект.Результат = ПолучитьРезультатОтказ();
		Объект.ПояснениеРезультатаВходящегоКонтакта = ВыбранныйЭлемент.Значение;
		ЭтаФорма.Записать();
		ВызватьПроведениеДокумента();
		ЭтаФорма.Закрыть();
	Исключение
		Сообщить(ОписаниеОшибки());
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура ВыборРезультатаПерезвонить(ВыбранныйЭлемент, ДополнительныеПараметры) Экспорт 
	
КонецПроцедуры

&НаКлиенте
Процедура ВидКонтактаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = ЛОЖЬ;
	ДанныеВыбора = Новый СписокЗначений;
	МассивВыбора = ВидКонтактаНачалоВыбораНаСервере();
	
	Для Ном = 0 По МассивВыбора.Количество() - 1 Цикл
		ДанныеВыбора.Добавить(МассивВыбора[Ном]);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ВидКонтактаОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	ВидКонтакта = ВыбранноеЗначение;
КонецПроцедуры

&НаКлиенте
Процедура РекламнаяАкцияНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = ЛОЖЬ;
	ДанныеВыбора = Новый СписокЗначений;
	МассивВыбора = РекламнаяАкцияНачалоВыбораНаСервере();
	
	Для Ном = 0 По МассивВыбора.Количество() - 1 Цикл
		ДанныеВыбора.Добавить(МассивВыбора[Ном]);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура РекламнаяАкцияОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	РекламнаяАкция = ВыбранноеЗначение;
КонецПроцедуры

&НаКлиенте
Процедура Перезвонить(Команда)
	
	Если ПроверитьЗаполнение() Тогда
		СписокВариантов = ПолучитьСписокПоясненийРезультата();
		Если СписокВариантов = Неопределено Тогда
			Состояние("Ошибка получения пояснений результата контакта");
			Возврат;
		КонецЕсли;
		Если СписокВариантов.Количество() = 0 Тогда
			Состояние("Не заполнен справочник пояснений результата контакта. Документ не записан");
			Возврат;
		КонецЕсли;
		
		Оп = Новый ОписаниеОповещения("ВыборРезультатаПерезвонить", ЭтаФорма);
		ПоказатьВыборИзМеню(Оп, СписокВариантов, Элементы.Перезвонить);
	КонецЕсли
	
КонецПроцедуры

&НаКлиенте
Процедура Отказ(Команда)
	
	Если ПроверитьЗаполнение() Тогда
		СписокВариантов = ПолучитьСписокПоясненийРезультата();
		Если СписокВариантов = Неопределено Тогда
			Состояние("Ошибка получения списка причин отказа");
			Возврат;
		КонецЕсли;
		Если СписокВариантов.Количество() = 0 Тогда
			Состояние("Не заполнен справочник причин отказа. Документ не записан");
			Возврат;
		КонецЕсли;
		
		Оп = Новый ОписаниеОповещения("ВыборРезультатаОтказ", ЭтаФорма);
		ПоказатьВыборИзМеню(Оп, СписокВариантов, Элементы.Отказ);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьГрафикЗамеров(Команда)
	
	ПараметрыОтчета = Новый Структура;
	ПараметрыОтчета.Вставить("ДатаНачала", НачалоДня(ТекущаяДата()));
	ПараметрыОтчета.Вставить("ДатаОкончания", НачалоДня(ТекущаяДата())+60*60*24*7);
		
	ОткрытьФорму("Отчет.ГрафикЗамеров.Форма.ФормаОтчета", ПараметрыОтчета);
	
КонецПроцедуры

&НаКлиенте
Процедура Прочее(Команда)
	
	Если ПроверитьЗаполнение() Тогда
		Объект.Результат = ПолучитьРезультатПрочее();
		//Объект.ПояснениеРезультатаВходящегоКонтакта = "";
		ЭтаФорма.Записать();
		ВызватьПроведениеДокумента();
		ЭтаФорма.Закрыть();
	КонецЕсли;
	
КонецПроцедуры


&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	ДатыЗапретаИзменения.ОбъектПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
КонецПроцедуры

