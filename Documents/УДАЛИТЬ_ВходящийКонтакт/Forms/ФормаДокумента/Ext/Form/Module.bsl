//ПРОЦЕДУРЫ И ФУНКЦИИ НА СЕРВЕРЕ БЕЗ КОНТЕКСТА
&НаСервереБезКонтекста
Функция ВидКонтактаНачалоВыбораНаСервере()
	
	МассивРезультат = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВидыКонтактов.Ссылка
	|ИЗ
	|	Справочник.ВидыКонтактов КАК ВидыКонтактов
	|ГДЕ
	|	ВидыКонтактов.ПометкаУдаления = ЛОЖЬ";
	
	Результат = Запрос.Выполнить().Выбрать();
	Пока Результат.Следующий() Цикл
		МассивРезультат.Добавить(Результат.Ссылка);
	КонецЦикла;
	
	Возврат МассивРезультат;
	
КонецФункции

