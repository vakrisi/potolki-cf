		Движение.Год = Год;
		Движение.Месяц = НачалоМесяца(Дата(Год,НомерМесяц,1,0,0,1));
		Движение.Номенклатура = СтрокаПлан.Номенклатура;
		Движение.Количество = СтрокаПлан.Декабрь;
		
	КонецЦикла;
	
КонецПроцедуры
