Процедура ОбработкаПроведения(Отказ, Режим)
	
	//проверим, был ли введен по данному году и точке продаж документ ранее
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ПланированиеПродажПоТочкамПродаж.Ссылка
	|ИЗ
	|	Документ.ПланированиеПродажПоТочкамПродаж КАК ПланированиеПродажПоТочкамПродаж
	|ГДЕ
	|	ПланированиеПродажПоТочкамПродаж.Год = &Год
	|	И ПланированиеПродажПоТочкамПродаж.Проведен = ИСТИНА
	|	И ПланированиеПродажПоТочкамПродаж.Ссылка <> &Ссылка
	|	И ПланированиеПродажПоТочкамПродаж.ТочкаПродаж = &ТочкаПродаж";
	Запрос.УстановитьПараметр("Год",Год);
	Запрос.УстановитьПараметр("ТочкаПродаж",ТочкаПродаж);
	Запрос.УстановитьПараметр("Ссылка",Ссылка);
	ВыборкаЗапроса = Запрос.Выполнить().Выбрать();
	Пока ВыборкаЗапроса.Следующий() Цикл
		Отказ = Истина;
		Сообщить("По данному году и точке продаж уже имеется проведенный документ плана: " + ВыборкаЗапроса.Ссылка,СтатусСообщения.Важное);
	КонецЦикла;
	Если Отказ Тогда 
		Возврат;
	КонецЕсли;
	         	
	//запишем новые
	Движения.ПланПродажТочекПродаж.Записывать = Истина;
	Для Каждого СтрокаПлан Из План Цикл
		Движение = Движения.ПланПродажТочекПродаж.Добавить();
		НомерМесяц = 1;
		Движение.ТочкаПродаж = ТочкаПродаж;
		Движение.Год = Год;
		Движение.Месяц = НачалоМесяца(Дата(Год,НомерМесяц,1,0,0,1));
		Движение.Номенклатура = СтрокаПлан.Номенклатура;
		Движение.Количество = СтрокаПлан.Январь;
		
		Движение = Движения.ПланПродажТочекПродаж.Добавить();
		НомерМесяц = 2;
		Движение.ТочкаПродаж = ТочкаПродаж;
		Движение.Год = Год;
