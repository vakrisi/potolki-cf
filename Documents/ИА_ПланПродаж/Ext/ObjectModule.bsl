	ТабДок = Новый ТабличныйДокумент;
	
	Макет = Документы.ИА_КоррекцияПланаПродаж.ПолучитьМакет("ИА_КоррекцияПланаПродажПоКонтрагентам");
	Запрос = Новый Запрос;
