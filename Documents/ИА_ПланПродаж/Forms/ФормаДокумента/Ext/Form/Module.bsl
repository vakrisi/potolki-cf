&НаКлиенте
Процедура ДеревоПланПеретаскивание(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка, Строка, Поле)
	СтандартнаяОбработка = Ложь;
	ПараметрыПеретаскивания.Действие = ДействиеПеретаскивания.Перемещение;
	МассивВыбора = ПараметрыПеретаскивания.Значение;
	Если ТипЗнч(МассивВыбора) = Тип("Массив") Тогда
		Выбор = МассивВыбора[0];
	Иначе
		Выбор = МассивВыбора;
	КонецЕсли;
	
	ИсхСтрока = ДеревоПлан.НайтиПоИдентификатору(Выбор);
	РезСтрока = ДеревоПлан.НайтиПоИдентификатору(Строка);

	Если РезСтрока.ПолучитьРодителя() = Неопределено тогда // неделя
		Новстр = РезСтрока.ПолучитьЭлементы().Добавить();
		ЗаполнитьЗначенияСвойств(Новстр, ИсхСтрока);
		Новстр.неделя = РезСтрока.неделя;
		Новстр.КонецНедели = РезСтрока.КонецНедели;
		
		тс = РезСтрока.ПолучитьИдентификатор();
		Если не Элемент.Развернут(тс) Тогда
			Элемент.Развернуть(тс);
		КонецЕсли;
	Иначе // строка плана
		Новстр = РезСтрока.ПолучитьРодителя().ПолучитьЭлементы().Добавить();
		ЗаполнитьЗначенияСвойств(Новстр, ИсхСтрока);
		Новстр.неделя = РезСтрока.ПолучитьРодителя().неделя;
		Новстр.КонецНедели = РезСтрока.ПолучитьРодителя().КонецНедели;
	КонецЕсли;
	Элемент.ТекущаяСтрока = новстр.ПолучитьИдентификатор();
	
	ИсхСтрока.ПолучитьРодителя().ПолучитьЭлементы().Удалить(ИсхСтрока);
	
	ПересчетДокумента();
КонецПроцедуры


