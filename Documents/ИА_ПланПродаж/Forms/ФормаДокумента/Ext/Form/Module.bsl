Функция ПечатьКоррекцияПланаПродажПоПродуктамСервер(ВыбранныйЭлемент)
	
	Зн = РеквизитФормыВЗначение("Объект");
	ТабДок = Зн.Печать("ИА_КоррекцияПланаПродажПоПродуктам", ПолучитьСтруктуруНедель(Объект.План), ВыбранныйЭлемент); 	
	Возврат ТабДок;
	
КонецФункции

	
&НаСервереБезКонтекста
Функция ПолучитьСтруктуруНедель(План)
	
	СтруктураНедель = Новый Соответствие;
	
	тз = План.Выгрузить(, "Неделя");
	тз.Свернуть("Неделя");
	тз.Сортировать("Неделя Возр");
	
	НомерНедели = 1;
	Для каждого стр из тз Цикл
		СтруктураНедель.Вставить(стр.Неделя, НомерНедели);
		НомерНедели = НомерНедели + 1;
	КонецЦикла;	
	
	Возврат СтруктураНедель;
	
КонецФункции	

&НаСервереБезКонтекста
Функция ПолучитьСписокВыбора(Док)
	
	СписокЗначений = Новый СписокЗначений;
	
	тз = Док.ИсходныйПлан.Выгрузить(, "Неделя");
	тз.Свернуть("Неделя");
	тз.Сортировать("Неделя Возр");
	
	СписокЗначений.ЗагрузитьЗначения(тз.ВыгрузитьКолонку("Неделя"));
	СписокЗначений.Добавить("Весь месяц");
	
	Возврат СписокЗначений;
	
КонецФункции


&НаСервере
Процедура ЗаполнитьПоНастройкеНаСервере()
	
	Если Не ЗначениеЗаполнено(Объект.Дата) Тогда
		
		Сообщить("Не заполнена дата документа, документ необходимо записать.");
		Возврат;
		
	КонецЕсли;	
	
	ДокНастройкаФП = ИА_ФП.ПолучитьПоследнююНастройку(Объект.Организация, Константы.ИА_ФП_ВестиФППоОрганизациям.Получить(), Объект.Дата);
	
	Если ЗначениеЗаполнено(ДокНастройкаФП) Тогда
		
		С = ДокНастройкаФП.ИсточникХранилищеЗапросаКонстурктора.Получить();
		Если Не С = Неопределено Тогда
			тзПараметры = С.Параметры;
			ТекстЗапроса = С.Текст;
			
			Запрос = Новый Запрос;
			Запрос.Текст = С.Текст;
			Для каждого парам Из тзПараметры Цикл
				Запрос.УстановитьПараметр(парам.ИмяПараметра, парам.Значение);
			КонецЦикла; 
						
			Дерево = РеквизитФормыВЗначение("ДеревоПланИсходный");
			Для каждого с1 из Дерево.Строки Цикл
				Дата1 = с1.Неделя;
				Дата2 = КонецДня(с1.КонецНедели);
				Запрос.УстановитьПараметр("ДатаНачала", Дата1);
				Запрос.УстановитьПараметр("ДатаКонца", Дата2);
				тз = Запрос.Выполнить().Выгрузить();
				тз.Свернуть("Контрагент,  Продукт", "Сумма");
				с1.Строки.Очистить();
				Для каждого с2 Из тз Цикл	
					Стр = с1.Строки.Добавить();
					Стр.Неделя = с1.Неделя;
					Стр.НеделяПредставление = ПолучитьПредставлениеНедели(с1.Неделя, с1.КонецНедели);
					ЗаполнитьЗначенияСвойств(стр, с2);					
				КонецЦикла; 
			КонецЦикла;

			ЗначениеВРеквизитФормы(Дерево, "ДеревоПланИсходный");
			
		КонецЕсли;
	КонецЕсли;	
	
			
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПоНастройке(Команда)
	ЗаполнитьПоНастройкеНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьФакт(Команда)
	тд = Элементы.ДеревоПлан.ТекущиеДанные;
	Если тд = Неопределено Тогда
		возврат;
	КонецЕсли;
	
	Если тд.ПолучитьРодителя()<>Неопределено Тогда
		тд = тд.ПолучитьРодителя();
	КонецЕсли;
	
	ЗаполнитьФактНедели(тд.ПолучитьИдентификатор());
	
	ПересчетДокумента();
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьФактНедели(идСтрокиНедели)
	стрНед = ДеревоПлан.НайтиПоИдентификатору(идСтрокиНедели);
	
	ДатаНачала = стрНед.Неделя;
	ДатаКонца = КонецДня(стрНед.КонецНедели);
	
	ДокНастр = ИА_ФП.ПолучитьПоследнююНастройку(Объект.Организация, ФППоОрганизациям, ДатаНачала);
	
	Если не ЗначениеЗаполнено(ДокНастр) Тогда
		Возврат;
	КонецЕсли;
	
	Для каждого стрПлан из стрНед.ПолучитьЭлементы() Цикл
		стрПлан.Факт = 0;
	КонецЦикла;
	
	ТЗ_ВидыДоходов = ДокНастр.Доходы.Выгрузить();
	ТЗ_ВидыДоходов.Колонки.добавить("Ссылка");
	ТЗ_ВидыДоходов.ЗаполнитьЗначения(ДокНастр, "Ссылка");
	
	ТЗ_резДоходы = Документы.ИА_ФинансовоеПланирование.ПустаяСсылка().Доходы_Детализация.Выгрузить();
	ТЗ_резДоходы_врем = ТЗ_резДоходы.Скопировать();
	
	// получаем факт
	Для каждого стрДоход из ТЗ_ВидыДоходов Цикл
		ТЗ_резДоходы_врем.Очистить();
		ИА_ФП.ПолучитьСуммуПоВидуДохода(стрДоход, ДатаНачала, ДатаКонца, ТЗ_резДоходы_врем);
		
		Для каждого стрВрем из ТЗ_резДоходы_врем Цикл
			Новстр = ТЗ_резДоходы.Добавить();
			ЗаполнитьЗначенияСвойств(Новстр, стрВрем);
			Новстр.Сумма = Новстр.Сумма + Новстр.СуммаНал; // для плана все равно
		КонецЦикла;
	КонецЦикла;
	
	ТЗ_резДоходы.Свернуть("Контрагент,Продукт", "Сумма");
	
	сч = ТЗ_резДоходы.Количество() -1;
	
	// заполним факт
	Пока сч>=0 Цикл
		ТекСтр = ТЗ_резДоходы[сч];
		
		СтрокаНайдена = Ложь;
		Для каждого стрПлан из стрНед.ПолучитьЭлементы() Цикл
			Если стрПлан.Контрагент = ТекСтр.Контрагент и стрПлан.Продукт = ТекСтр.Продукт Тогда
				стрПлан.Факт = ТекСтр.Сумма;
				СтрокаНайдена = истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Если СтрокаНайдена Тогда
			ТЗ_резДоходы.Удалить(ТекСтр);
		КонецЕсли;
		
		сч = сч - 1;
	КонецЦикла;
	
	// добавим то, что не найдено в плане
	Для каждого стрФакт из ТЗ_резДоходы Цикл
		Новстр = стрНед.ПолучитьЭлементы().Добавить();
		Новстр.Контрагент = стрФакт.Контрагент;
		Новстр.Продукт = стрФакт.Продукт;
		Новстр.Факт = стрФакт.Сумма;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ПересчетДокумента()
	ПересчитатьОтклонениеСуммуВСтроках();
	обновитьИтого();
	Модифицированность = Истина;
КонецПроцедуры

Процедура ПересчитатьОтклонениеСуммуВСтроках()
	Для каждого стрНед из ДеревоПлан.ПолучитьЭлементы() Цикл
		ОтклИтого = 0;
		СуммаИтого = 0;
		ФактИтого = 0;
		Для каждого стрПлан из стрНед.ПолучитьЭлементы() Цикл
			стрПлан.отклонение = стрПлан.Факт - стрПлан.Сумма;
			ОтклИтого = ОтклИтого + стрПлан.отклонение;
			СуммаИтого = СуммаИтого + стрПлан.Сумма;
			ФактИтого = ФактИтого + стрПлан.Факт;
		КонецЦикла;
		стрНед.Отклонение = ОтклИтого;
		стрНед.Сумма = СуммаИтого;
		стрНед.Факт = ФактИтого;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ПредставлениеМесяцаОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	Объект.НаМесяц = Дата(ВыбранноеЗначение);
	ПредставлениеМесяца = ПолучитьПредставлениеМесяца(Объект.НаМесяц);
	ЗаполнитьНедели();
КонецПроцедуры

&НаКлиенте
Функция ПолучитьПредставлениеМесяца(пМесяц)
	Если не ЗначениеЗаполнено(пМесяц) Тогда
		Возврат "";
	Иначе
		Возврат ФОРМАТ(пМесяц, "ДФ='ММММ гггг'");
	КонецЕсли;
КонецФункции

&НаСервереБезКонтекста // т.к. вызывается с сервера
Функция ПолучитьПредставлениеНедели(пДата, пКонецНедели)
	Возврат ФОРМАТ(пДата, "ДФ=dd.MM")+"-"+ФОРМАТ(пКонецНедели, "ДФ=dd.MM");
КонецФункции


&НаКлиенте
Процедура ДатаПриИзменении(Элемент)
	ЗаполнитьВозможныеМесяцы();
КонецПроцедуры

&НаКлиенте
Процедура УтвердитьПлан(Команда)
	Если Вопрос("Вы уверены? Дальнейшее редактирование исходного плана будет запрещено.", РежимДиалогаВопрос.ДаНет)<>КодВозвратаДиалога.Да Тогда
		Возврат
	КонецЕсли;
	
	Для каждого стрНед из ДеревоПланИсходный.ПолучитьЭлементы() Цикл
		НовстрНед = ДеревоПлан.ПолучитьЭлементы().Добавить();
		ЗаполнитьЗначенияСвойств(НовстрНед, стрНед);
		
		Для каждого стрСумма из стрНед.ПолучитьЭлементы() Цикл
			НовстрСумма = НовстрНед.ПолучитьЭлементы().Добавить();
			ЗаполнитьЗначенияСвойств(НовстрСумма, стрСумма);
		КонецЦикла;
	КонецЦикла;
	
	Модифицированность = истина;
	Объект.ПланУтвержден = истина;
	обновитьИтого();
	ОбновитьДоступностьЭлементов();
КонецПроцедуры

