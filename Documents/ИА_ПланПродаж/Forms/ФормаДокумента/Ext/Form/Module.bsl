&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ФППоОрганизациям = Константы.ИА_ФП_ВестиФППоОрганизациям.Получить();
	ЕстьПравоУтверждения = ИА_ПраваС.ЗначениеПраваТекПользователя(ПланыВидовХарактеристик.ИА_ПраваПользователей.УтверждениеПланаПродаж);
	
	Если Объект.Ссылка.Пустая() тогда
		Объект.Ответственный = ПараметрыСеанса.ТекущийПользователь;
		Объект.Дата = ТекущаяДата();
		Если ФППоОрганизациям ТОгда
			Объект.Организация = ИА_НастройкиС.ЗначениеНастройкиТекПользователя(ПланыВидовХарактеристик.ИА_НастройкиПользователей.ОсновнаяОрганизация);
		КонецЕсли;
		Возврат;
	КонецЕсли;
	ЗаполнитьИсходныйПлан();	
	ЗаполнитьПлан();	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПлан()
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ИА_ПланПродажПлан.Неделя КАК Неделя,
	               |	ИА_ПланПродажПлан.Контрагент,
	               |	ИА_ПланПродажПлан.Продукт,
	               |	ИА_ПланПродажПлан.Сумма,
	               |	ИА_ПланПродажПлан.Действия,
	               |	ИА_ПланПродажПлан.Источник,
	               |	ИА_ПланПродажПлан.Факт,
	               |	ИА_ПланПродажПлан.КонецНедели
	               |ИЗ
	               |	Документ.ИА_ПланПродаж.План КАК ИА_ПланПродажПлан
	               |ГДЕ
	               |	ИА_ПланПродажПлан.Ссылка = &Ссылка
	               |ИТОГИ МАКСИМУМ(ИА_ПланПродажПлан.КонецНедели) ПО
	               |	Неделя";
	Запрос.УстановитьПараметр("Ссылка", Объект.Ссылка);
	Запрос.УстановитьПараметр("Дата", Объект.Дата);
	Дер = Запрос.Выполнить().Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Для каждого стрНеделя из Дер.Строки Цикл
		НовСтрНед = ДеревоПлан.ПолучитьЭлементы().Добавить();
		НовСтрНед.Неделя = стрНеделя.неделя;
		НовСтрНед.КонецНедели = стрНеделя.КонецНедели;
		НовСтрНед.НеделяПредставление = ПолучитьПредставлениеНедели(стрНеделя.неделя, стрНеделя.КонецНедели);
		НовСтрНед.ЭтоНеделя = Истина;
		
		для каждого стрПлан из стрНеделя.Строки Цикл
			Если не ЗначениеЗаполнено(стрПлан.Сумма) и не ЗначениеЗаполнено(стрПлан.Факт) Тогда
				Продолжить;
			КонецЕсли;
			
			новСтрПлан = НовСтрНед.ПолучитьЭлементы().Добавить();
			ЗаполнитьЗначенияСвойств(новСтрПлан, стрПлан);
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры

