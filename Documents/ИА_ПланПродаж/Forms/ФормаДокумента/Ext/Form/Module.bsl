&НаКлиенте
Процедура НаМесяцПриИзменении(Элемент)
	Объект.НаМесяц = НачалоМесяца(Объект.НаМесяц);
	ЗаполнитьНедели();
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьНедели()
	
	Источник = ?(Объект.ПланУтвержден, ДеревоПлан, ДеревоПланИсходный);
	
	Строки = Источник.ПолучитьЭлементы();
	Строки.Очистить();
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ИА_РаспределениеНедель.Период КАК Период,
	               |	ИА_РаспределениеНедель.КонецНедели
	               |ИЗ
	               |	РегистрСведений.ИА_РаспределениеНедель КАК ИА_РаспределениеНедель
	               |ГДЕ
	               |	ИА_РаспределениеНедель.Месяц = &Месяц
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Период";
	Запрос.УстановитьПараметр("Месяц", Объект.НаМесяц);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Количество() = 0 Тогда
		Сообщить("Заполните распределение недель!");
		Возврат;
	КонецЕсли;
	
	Пока Выборка.Следующий() Цикл
		новстр = Строки.Добавить();
		новстр.неделя = Выборка.Период;
		новстр.КонецНедели = Выборка.КонецНедели;
		новстр.НеделяПредставление = ПолучитьПредставлениеНедели(новстр.неделя, новстр.КонецНедели);
		новстр.ЭтоНеделя = истина; 		
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьСтроку(Команда)
	тд = Элементы.ДеревоПланИсходный.ТекущиеДанные;
	тс = Элементы.ДеревоПланИсходный.ТекущаяСтрока;
	Если тд<>Неопределено Тогда		
		Если тд.ЭтоНеделя Тогда
			новстр = тд.ПолучитьЭлементы().Добавить();
			Если не Элементы.ДеревоПланИсходный.Развернут(тс) Тогда
				Элементы.ДеревоПланИсходный.Развернуть(тс);
			КонецЕсли;
		Иначе
			новстр = тд.ПолучитьРодителя().ПолучитьЭлементы().Добавить();
		КонецЕсли;
		Элементы.ДеревоПланИсходный.ТекущаяСтрока = новстр.ПолучитьИдентификатор();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьСтрокуКорр(Команда)
	тд = Элементы.ДеревоПлан.ТекущиеДанные;
	тс = Элементы.ДеревоПлан.ТекущаяСтрока;
	Если тд<>Неопределено Тогда		
		Если тд.ЭтоНеделя Тогда
			новстр = тд.ПолучитьЭлементы().Добавить();
			новстр.Неделя = тд.неделя;
			новстр.КонецНедели = тд.КонецНедели;
			Если не Элементы.ДеревоПлан.Развернут(тс) Тогда
				Элементы.ДеревоПлан.Развернуть(тс);
			КонецЕсли;
		Иначе
			новстр = тд.ПолучитьРодителя().ПолучитьЭлементы().Добавить();
			новстр.Неделя = тд.ПолучитьРодителя().неделя;
			новстр.КонецНедели = тд.ПолучитьРодителя().КонецНедели;
		КонецЕсли;
		Элементы.ДеревоПлан.ТекущаяСтрока = новстр.ПолучитьИдентификатор();
	КонецЕсли;
КонецПроцедуры


&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	ТекущийОбъект.ИсходныйПлан.Очистить();
	
	Для каждого стрНеделя из ДеревоПланИсходный.ПолучитьЭлементы() Цикл
		текНеделя = стрНеделя.Неделя;
		текКонецНедели = стрНеделя.КонецНедели;
		Для каждого стрПлан из стрНеделя.ПолучитьЭлементы() Цикл
			Новстр = ТекущийОбъект.ИсходныйПлан.Добавить();
			ЗаполнитьЗначенияСвойств(Новстр, стрПлан);
			Новстр.неделя = текНеделя; 
			Новстр.КонецНедели = текКонецНедели; 
		КонецЦикла;
		
		Если стрНеделя.ПолучитьЭлементы().Количество() = 0 Тогда
			Новстр = ТекущийОбъект.ИсходныйПлан.Добавить();
			Новстр.неделя = текНеделя; 
			Новстр.КонецНедели = текКонецНедели; 
		КонецЕсли;
	КонецЦикла;
	
	//
	ТекущийОбъект.План.Очистить();
	Для каждого стрНеделя из ДеревоПлан.ПолучитьЭлементы() Цикл
		текНеделя = стрНеделя.Неделя;
		текКонецНедели = стрНеделя.КонецНедели;
		Для каждого стрПлан из стрНеделя.ПолучитьЭлементы() Цикл
			Новстр = ТекущийОбъект.План.Добавить();
			ЗаполнитьЗначенияСвойств(Новстр, стрПлан);
			Новстр.неделя = текНеделя; 
			Новстр.КонецНедели = текКонецНедели; 
		КонецЦикла;
		
		Если стрНеделя.ПолучитьЭлементы().Количество() = 0 Тогда
			Новстр = ТекущийОбъект.План.Добавить();
			Новстр.неделя = текНеделя; 
			Новстр.КонецНедели = текКонецНедели; 
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура обновитьИтого()
	ИтогоИсходныйПлан = 0;
	Для каждого стрНед из ДеревоПланИсходный.ПолучитьЭлементы() Цикл
		СуммаИтого = 0;
		Для каждого стрПлан из стрНед.ПолучитьЭлементы() Цикл
			СуммаИтого = СуммаИтого + стрПлан.Сумма;
		КонецЦикла;
		стрНед.Сумма = СуммаИтого;
		ИтогоИсходныйПлан = ИтогоИсходныйПлан + СуммаИтого;
	КонецЦикла;
	
	ИтогоПлан = 0;
	ИтогоФакт = 0;
	ИтогоОтклонение = 0;
	Для каждого стрНед из ДеревоПлан.ПолучитьЭлементы() Цикл
		СуммаИтого = 0;
		СуммаИтогоФакт = 0;
		СуммаИтогоОтклонение = 0;
		Для каждого стрПлан из стрНед.ПолучитьЭлементы() Цикл
			СуммаИтого = СуммаИтого + стрПлан.Сумма;
			СуммаИтогоФакт =  СуммаИтогоФакт + стрПлан.Факт;
			СуммаИтогоОтклонение =  СуммаИтогоОтклонение + стрПлан.Отклонение;
		КонецЦикла;
		стрНед.Сумма = СуммаИтого;
		ИтогоПлан = ИтогоПлан + СуммаИтого;
		
		стрНед.Факт = СуммаИтогоФакт;
		ИтогоФакт = ИтогоФакт + СуммаИтогоФакт;
		
		стрНед.Отклонение = СуммаИтогоОтклонение;
		ИтогоОтклонение = ИтогоОтклонение + СуммаИтогоОтклонение;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	Если не ИА_Защита_Общий.ЛицензияДоступна("ФП") Тогда
		Отказ = Истина;
		возврат;
	КонецЕсли;
	
	ЗаполнитьВозможныеМесяцы();
	ПредставлениеМесяца = ПолучитьПредставлениеМесяца(Объект.НаМесяц);
	
	ОбновитьДоступностьЭлементов();
	
	ПересчитатьОтклонениеСуммуВСтроках();
	обновитьИтого();
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьВозможныеМесяцы()
	Элементы.ПредставлениеМесяца.СписокВыбора.Очистить();
	ТекМесяц = НачалоМесяца(Объект.Дата);
	Для сч = 1 по 5 цикл
		Элементы.ПредставлениеМесяца.СписокВыбора.Добавить(формат(ТекМесяц, "ДФ=ггггММдд"), ПолучитьПредставлениеМесяца(ТекМесяц));
		ТекМесяц = ДобавитьМесяц(ТекМесяц, 1);
	КонецЦикла;
КонецПроцедуры
	
	
&НаКлиенте
Процедура ОбновитьДоступностьЭлементов()
	Элементы.Организация.Видимость = ФППоОрганизациям;
	Элементы.Организация.АвтоОтметкаНезаполненного = ФППоОрганизациям;
	
	Элементы.ГруппаИсходныйПлан.ТолькоПросмотр = Объект.ПланУтвержден;
	Элементы.ДеревоПланИсходный.КоманднаяПанель.Доступность = не Объект.ПланУтвержден;
	Элементы.ГруппаПлан.Видимость = Объект.ПланУтвержден;
	
	Элементы.ПредставлениеМесяца.ТолькоПросмотр = Объект.ПланУтвержден;
	
	Элементы.ФормаУтвердитьПлан.Доступность = ЕстьПравоУтверждения и не Объект.ПланУтвержден;
КонецПроцедуры

&НаКлиенте
Процедура ДеревоПланСуммаПриИзменении(Элемент)
	обновитьИтого();
КонецПроцедуры

&НаКлиенте
Процедура ДеревоПланПослеУдаления(Элемент)
	обновитьИтого();
КонецПроцедуры

&НаКлиенте
Процедура ДеревоПланПередУдалением(Элемент, Отказ)
	Если Элементы.ДеревоПланИсходный.ТекущиеДанные <> Неопределено И Элементы.ДеревоПланИсходный.ТекущиеДанные.ЭтоНеделя Тогда 
		Отказ = Истина;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПечатьПланПродажПоКонтрагентам(Команда)
	
	Если Модифицированность И Не ПерезаписатьДокумент() Тогда 
		Возврат;
	КонецЕсли;
	
	СписокЗн = ПолучитьСписокВыбора(Объект.Ссылка);
	ВыбранныйЭлемент = СписокЗн.ВыбратьЭлемент("Печать элемента", "Весь месяц");
	Если ВыбранныйЭлемент <> Неопределено Тогда
		ТабличныйДокумент = ПечатьПланПродажПоКонтрагентамСервер(ВыбранныйЭлемент.Значение);
		ТабличныйДокумент.Показать("План продаж по контрагентам");
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Функция ПерезаписатьДокумент()
	
	Если Вопрос("Для печати необходимо записать документ. Записать документ?", РежимДиалогаВопрос.ДаНет) = КодВозвратаДиалога.Да Тогда
		Записать();
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции	

&НаСервере
Функция ПечатьПланПродажПоКонтрагентамСервер(ВыбранныйЭлемент)
	
	Зн = РеквизитФормыВЗначение("Объект");
	ТабДок = Зн.Печать("ИА_ПланПродажПоКонтрагентам", ПолучитьСтруктуруНедель(Объект.ИсходныйПлан), ВыбранныйЭлемент); 	
	Возврат ТабДок;
	
КонецФункции  

