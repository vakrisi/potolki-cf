	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПечатьКоррекцияПланаПродажПоПродуктам(Команда)
	
	Если Модифицированность И Не ПерезаписатьДокумент() Тогда 
		Возврат;
	КонецЕсли;
	
	СписокЗн = ПолучитьСписокВыбора(Объект.Ссылка);
	ВыбранныйЭлемент = СписокЗн.ВыбратьЭлемент("Печать элемента", "Весь месяц");
	Если ВыбранныйЭлемент <> Неопределено Тогда
		ТабличныйДокумент = ПечатьКоррекцияПланаПродажПоПродуктамСервер(ВыбранныйЭлемент.Значение);
		ТабличныйДокумент.Показать("Коррекция плана продаж по продуктам");
	КонецЕсли;
	
КонецПроцедуры

