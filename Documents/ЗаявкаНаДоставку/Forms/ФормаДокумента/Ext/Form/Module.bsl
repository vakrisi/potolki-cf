
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Ключ.Пустая() Тогда

	Иначе
		ЭтаФорма.ТолькоПросмотр = ПраваПользователей.ДокументТолькоПросмотр(Объект.Ссылка);
	КонецЕсли;
	
	Элементы.ПодменюПечать.Доступность = ПраваПользователей.ДоступностьПечати(Объект.Ссылка);
	ПраваПользователей.УстановитьТолькоПросмотрДляРеквизитаНомер(Элементы.Номер.ТолькоПросмотр);
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	СофтФонСервер.ПриСозданииНаСервере(ЭтотОбъект);
	МессенджерыСервер.ПриСозданииНаСервере(ЭтотОбъект, Элементы.ГруппаКонтрагентКПМессенджеры);
	
	Элементы.ФормаОтправитьСМС.Видимость = Константы.АвтоматическаяРассылкаСМС.Получить();

	ОбновитьЭлементыФормы();
	ОбновитьИзображениеКомандОтправкиСообщений();
	
	// Видимость колонки Артикул
	ОбщийМодульСервер.УстановитьВидимостьКолонкиАртикулВТабличнойЧасти(ЭтаФорма);
	
	// №10663
	ПолучитьИдентификаторГородаНаселенногоПункта();
	ВремАдресДоставки = Объект.АдресДоставки;
	ПроверитьНаличиеДанныхВКлассификатореАдресов();
	
	ФинансыСервер.ОбновитьВидимостьИКурсВалюты(ЭтотОбъект);
	
	//ДоступныеТипы = Новый Массив;
	//ДоступныеТипы.Добавить("ДокументСсылка.ЗаказПокупателя");
	//ДоступныеТипы.Добавить("ДокументСсылка.РеализацияТоваровИУслуг");
	//Элементы.Основания.ПодчиненныеЭлементы.ОснованияОснование.ОграничениеТипа = Новый ОписаниеТипов(ДоступныеТипы);
	
	//nva+++
	ПредыдущаяОжидаемаяДатаОтправки = Объект.ОжидаемаяДатаОтправки;
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(ИсторияЗаявкиНаДоставку, "ЗаявкаНаДоставку", Объект.Ссылка, , , Истина, РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный);
	//nva---
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	ДатыЗапретаИзменения.ОбъектПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи) 
	
	Если Объект.ВидТранспортногоСредства.Пустая() Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Не выбран ""Вид транспортного средства!""", Объект, "ВидТранспортногоСредства", "Объект.ВидТранспортногоСредства", Отказ);
	КонецЕсли;	
	
	Если НЕ Объект.Получатель.Пустая()
		И АдресДоставкиБылИзменен // №11868
		И НЕ АдресИмеетсяВКарточкеПолучателя() Тогда
		
		ПослеВопросаОДобавленииАдресаВКарточкуПолучателя = Новый ОписаниеОповещения("ПослеВопросаОДобавленииАдресаВКарточкуПолучателя", ЭтаФорма);
		ПоказатьВопрос(ПослеВопросаОДобавленииАдресаВКарточкуПолучателя, "Указанный в документе адрес отсутствует в карточке получателя. Добавить адрес в карточку?",РежимДиалогаВопрос.ДаНет);
		
	КонецЕсли;
	
	Если НужноОтправитьУведомлениеEMail() Тогда
		Объект.ОтправленEMail = Истина;
		
		ПисьмоСНакладной = Ложь;
		Если Вопрос("Вложить печатную форму накладной в электронное письмо?", РежимДиалогаВопрос.ДаНет) = КодВозвратаДиалога.Да Тогда
			ПисьмоСНакладной = Истина;
		КонецЕсли;
		
		СсылкаНаЭлектронноеПисьмо = СформироватьЭлектронноеПисьмо(ПисьмоСНакладной);
		
		Парам = Новый Структура("Ключ",СсылкаНаЭлектронноеПисьмо);
		ОткрытьФорму("Документ.ЭлектронноеПисьмо.ФормаОбъекта",Парам);
	КонецЕсли;
	
	Если НужноОтправитьУведомлениеСМС() Тогда
		Если ОбщийМодульВызовСервера.ЕстьТелефонКонтрагента(Объект.Получатель) Тогда	
			Парам = Новый Структура;
			Парам.Вставить("Основание", Объект.Ссылка);
			ОткрытьФорму("Документ.ОтправкаСМС.Форма.ФормаДокумента",Парам,,,,,Новый ОписаниеОповещения("ПослеЗакрытияФормыНовогоСМС",ЭтаФорма));		
		Иначе
			ПоказатьОповещениеПользователя("У контрагента в карточке не указан номер телефона. СМС не создана");
		КонецЕсли;

	КонецЕсли;
	
	ОбновитьИзображениеКомандОтправкиСообщений();
	
	АдресДоставкиБылИзменен = Ложь; // №11868
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	Если ЗначениеЗаполнено(ТекущийОбъект.Ссылка) Тогда
		ТекущийОбъект.ДополнительныеСвойства.Вставить("ПредыдущаяОжидаемаяДатаОтправки", ПредыдущаяОжидаемаяДатаОтправки);
	КонецЕсли;
	
КонецПроцедуры

