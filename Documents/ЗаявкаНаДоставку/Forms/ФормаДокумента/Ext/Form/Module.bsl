&НаКлиенте
Процедура ПоказатьДополнительнуюИнформацию(Команда)
	
	ОбщийМодульКлиент.ФормаДополнительнойИнформацииКонтрагента(Объект.Контрагент);
	
КонецПроцедуры

&НаКлиенте
Процедура ОснованияПриАктивизацииЯчейки(Элемент)
	Если Элемент.ТекущийЭлемент.Имя = "ОснованияОснование" Тогда
		
		МассивОтбора = Новый Массив;
			МассивОтбора.Добавить(Тип("ДокументСсылка.ЗаказПокупателя"));
			МассивОтбора.Добавить(Тип("ДокументСсылка.РеализацияТоваровИУслуг")); 
			МассивОтбора.Добавить(Тип("ДокументСсылка.ЗаказПоставщику"));
			ДопустимыеТипы = Новый ОписаниеТипов(МассивОтбора);
			
		Элемент.ТекущийЭлемент.ОграничениеТипа = ДопустимыеТипы;
		
	КонецЕсли;
	
КонецПроцедуры

