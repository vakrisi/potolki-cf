Процедура ТекущийСтатусПриИзмененииНаСервере()
	
	Если Объект.Результат = Справочники.СтатусыЗаявокНаДоставку.Отправлено Тогда // №10663 заменено на справочник, было: Перечисления.СтатусыДоставкиТовара.ВПути
		Объект.ОтправленоДата = ТекущаяДатаСеанса();
		Объект.ОтправленоОтветственный = Пользователи.ТекущийПользователь();
	ИначеЕсли Объект.Результат = Справочники.СтатусыЗаявокНаДоставку.Доставлено Тогда // №10663 заменено на справочник, было: Перечисления.СтатусыДоставкиТовара.Доставлено Тогда
		Объект.ДоставленоДата = ТекущаяДатаСеанса();
		Объект.ДоставленоОтветственный = Пользователи.ТекущийПользователь();
	КонецЕсли;
	
КонецПроцедуры

