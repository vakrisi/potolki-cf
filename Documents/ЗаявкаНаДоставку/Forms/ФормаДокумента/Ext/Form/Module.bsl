&НаСервере
Процедура ОбновитьЭлементыФормы()
	
	Элементы.ГруппаАвтобус.Видимость = Ложь;
	Элементы.ГруппаТранспортнаяКомпания.Видимость = Ложь;
	Элементы.ГруппаСобственныйТранспорт.Видимость = Ложь;
	
	Если Объект.СпособДоставки = Справочники.СпособыДоставкиТовара.ТранспортнаяКомпания Тогда
		Элементы.ГруппаТранспортнаяКомпания.Видимость = Истина;
	ИначеЕсли Объект.СпособДоставки = Справочники.СпособыДоставкиТовара.СобственныйТранспорт Тогда
		Элементы.ГруппаСобственныйТранспорт.Видимость = Истина;
	ИначеЕсли Объект.СпособДоставки = Справочники.СпособыДоставкиТовара.Автобус или Объект.СпособДоставки = Справочники.СпособыДоставкиТовара.ПопутныйАвтомобиль Тогда
		Элементы.ГруппаАвтобус.Видимость = Истина;
	КонецЕсли;
	
	ОбновитьСписокФайлов();
	
	//nva+++ 
	Элементы.Декорация2.Заголовок = Формат(НачалоЧаса(Объект.ОжидаемаяДатаДоставки) + 3600, "ДФ=HH:mm");
	//nva---
	//Если Объект.Товары.Количество() > 0 Тогда
	//	Элементы.ГруппаТовары.Заголовок = "Товары (" + Объект.Товары.Количество() + ")";
	//Иначе
	//	Элементы.ГруппаТовары.Заголовок = "Товары";
	//КонецЕсли;
	
	//Элементы.КонтрагентДополнительно.Видимость = Объект.Получатель.ПоказыватьДопИнформацию;
	ОбщийМодульСервер.ДополнительнаяИнформацияПоКонтрагентуНаФорме(Объект.Получатель, Элементы.ПоказатьДополнительнуюИнформацию);
	ОбщийМодульСервер.РегулировкаШириныПоляКонтрагента(Элементы, Элементы.Получатель, Элементы.ПоказатьДополнительнуюИнформацию);
	
КонецПроцедуры

