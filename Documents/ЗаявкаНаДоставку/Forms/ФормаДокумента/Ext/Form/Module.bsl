&НаКлиенте
Процедура ТоварыНоменклатураПриИзменении(Элемент)
	СтрокаТабличнойЧасти = Элементы.Товары.ТекущиеДанные;
	СтрокаТабличнойЧасти.ЕдиницаИзмерения = ОбщийМодульВызовСервера.ПолучитьБазовуюЕдиницуИзмеренияНоменклатуры(СтрокаТабличнойЧасти.Номенклатура);
	СтрокаТабличнойЧасти.Количество = 1;
КонецПроцедуры

&НаКлиенте
Процедура ПрикрепитьФайл(Команда)	
	Если Объект.Ссылка.Пустая() Тогда
		//показываем что необходимо записать перед добавление файла 
		Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопросаОСохранении", ЭтотОбъект);
		
		ПоказатьВопрос(Оповещение, "Перед добавление файлов необходимо сохранить документ, сохранить документ?", РежимДиалогаВопрос.ДаНет);			
	Иначе
		//выводим диалог выбора файла
		ПрикрепитьФайлКДокументу();
	КонецЕсли;		
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияВопросаОСохранении(Результат, Параметры) Экспорт
	Если Результат = КодВозвратаДиалога.Да Тогда
		Записать();
		ПрикрепитьФайлКДокументу();
	КонецЕсли;	
КонецПроцедуры
	
&НаКлиенте
Процедура ПрикрепитьФайлКДокументу()
		
	ОписаниеОповещения = Новый ОписаниеОповещения("ПослеПрикрепленияФайлаЗавершение", ЭтотОбъект);
	ДопПараметры = Новый Структура("ДействиеПослеПрикрепления", ОписаниеОповещения);
	ОбщийМодульКлиент.ПослеВыбораСсылкиДляПрикрепленияФайла(Объект.Ссылка, ДопПараметры);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеПрикрепленияФайлаЗавершение(СтруктураРезультата, ДополнительныеПараметры) Экспорт
	
	Если СтруктураРезультата.Результат Тогда
		ОбновитьЭлементыФормы();
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ПечататьФайл(Команда)
	
	ВыбранныеЭлементы = Элементы.Файлы.ВыделенныеСтроки;
	
	Если ВыбранныеЭлементы.Количество() > 0 Тогда
		Для каждого ЭлементДляПечати из ВыбранныеЭлементы Цикл
			СтрФайл = Файлы.НайтиПоИдентификатору(ЭлементДляПечати);
			//Если СтрФайл.Номенклатура.Пустая() Тогда
				АдресФайла = ПолучитьДанные(Объект.Ссылка, СтрФайл.ИмяФайла);
			//Иначе
			//	АдресФайла = ПолучитьДанные(СтрФайл.Номенклатура, СтрФайл.ИмяФайла);
			//КонецЕсли;
			
			ВременноеИмя = ПолучитьИмяВременногоФайла(СтрФайл.Расширение);
			ПолучитьФайл(АдресФайла, ВременноеИмя, Ложь);
			
			Shell = Новый COMОбъект("Shell.Application");
			Shell.ShellExecute(ВременноеИмя, "", "", "print", 0);
		КонецЦикла;
	Иначе
		ПоказатьПредупреждение(,"Выберите файл(ы) в списке");
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОформитьПоступлениеТоваровИУслуг(Команда)
	ПараметрыНовойФормы = Новый Структура;
	ПараметрыНовойФормы.Вставить("Основание",Объект.Ссылка);
	ОткрытьФорму("Документ.ПоступлениеТоваровИУслуг.Форма.ФормаДокумента",ПараметрыНовойФормы);
КонецПроцедуры

&НаКлиенте
Процедура ОформитьРасходныйКассовыйОрдер(Команда)
	ПараметрыНовойФормы = Новый Структура;
