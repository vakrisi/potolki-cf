Функция АдресИмеетсяВКарточкеПолучателя()
	
	Результат = Ложь;
	
	Если Не ЗначениеЗаполнено(Объект.АдресДоставки) Тогда
		Возврат Истина;
	КонецЕсли;
	
	МассивОбъектов = Новый Массив;
	МассивОбъектов.Добавить(Объект.Получатель);
	
	КонтактнаяИнформацияОбъекта = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъектов(МассивОбъектов,, Справочники.ВидыКонтактнойИнформации.АдресДоставкиКонтрагента);
	
	Если КонтактнаяИнформацияОбъекта.Количество() = 0 Тогда
		Возврат Результат; 
	КонецЕсли;

	ПредставлениеАдреса = ПредставлениеАдреса(Объект.Город, Объект.АдресДоставки);
	
	Для Каждого ЭлементАдресаДоставки Из КонтактнаяИнформацияОбъекта Цикл
		Если СтрНайти(СокрЛП(ЭлементАдресаДоставки.Представление), ПредставлениеАдреса) > 0 Тогда
			Результат = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

