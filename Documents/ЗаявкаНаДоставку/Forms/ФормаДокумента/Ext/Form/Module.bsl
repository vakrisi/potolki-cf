Процедура ОтправитьПоПочте(Команда)
	Если Вопрос("Создать новое электронное письмо?",РежимДиалогаВопрос.ДаНет) = КодВозвратаДиалога.Да Тогда
		ПисьмоСНакладной = Ложь;
		Если Вопрос("Вложить печатную форму накладной в электронное письмо?", РежимДиалогаВопрос.ДаНет) = КодВозвратаДиалога.Да Тогда
			ПисьмоСНакладной = Истина;
		КонецЕсли;
		
		Объект.ОтправленEMail = Истина;
		Модифицированность = Истина;
		
		СсылкаНаЭлектронноеПисьмо = СформироватьЭлектронноеПисьмо(ПисьмоСНакладной);		
		Парам = Новый Структура("Ключ",СсылкаНаЭлектронноеПисьмо);
		ОткрытьФорму("Документ.ЭлектронноеПисьмо.ФормаОбъекта",Парам);		
	КонецЕсли;
	ОбновитьИзображениеКомандОтправкиСообщений();
КонецПроцедуры

&НаКлиенте
Процедура ОтправитьСМС(Команда)
	Если ОбщийМодульВызовСервера.ЕстьТелефонКонтрагента(Объект.Получатель) Тогда	
		Парам = Новый Структура;
		Парам.Вставить("Основание", Объект.Ссылка);
		ОткрытьФорму("Документ.ОтправкаСМС.Форма.ФормаДокумента",Парам,,,,,Новый ОписаниеОповещения("ПослеЗакрытияФормыНовогоСМС",ЭтаФорма));		
	Иначе
		ПоказатьОповещениеПользователя("У получателя в карточке не указан номер телефона. СМС не создана");
	КонецЕсли;
	ОбновитьИзображениеКомандОтправкиСообщений();
КонецПроцедуры

&НаСервере
Функция СформироватьЭлектронноеПисьмо(ПисьмоСНакладной = Ложь)
	
	//создаем письмо
	Если ПисьмоСНакладной И НЕ Объект.Ссылка.Пустая() Тогда	
		МассивДокументов = Новый Массив;
		МассивДокументов.Добавить(Объект.Ссылка);
		ОбъектыПечати = Новый СписокЗначений;
		ПечатнаяФормаНакладной = Документы.ЗаявкаНаДоставку.ПечатьНакладнаяНаДоставку(МассивДокументов, ОбъектыПечати);
		НовоеПисьмо = РаботаСЭлектроннойПочтой.СформироватьЭлектронноеПисьмоСОтчетом(ПечатнаяФормаНакладной, "Доставка товара", Объект.Получатель, "pdf");
	Иначе
		НовоеПисьмо = РаботаСЭлектроннойПочтой.СформироватьЭлектронноеПисьмо("Доставка товара", Объект.Получатель);
	КонецЕсли;		

	//прикрепляем к нему вложенные к заявке файлы
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ПрикрепленныеДанныеСрезПоследних.Период,
	|	ПрикрепленныеДанныеСрезПоследних.СсылкаНаОбъект,
	|	ПрикрепленныеДанныеСрезПоследних.ИмяФайла,
	|	ПрикрепленныеДанныеСрезПоследних.Данные,
	|	ПрикрепленныеДанныеСрезПоследних.Расширение
	|ИЗ
	|	РегистрСведений.ПрикрепленныеДанные.СрезПоследних(, СсылкаНаОбъект = &СсылкаНаОбъект) КАК ПрикрепленныеДанныеСрезПоследних";
	Запрос.УстановитьПараметр("СсылкаНаОбъект",Объект.Ссылка);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		МенеджерЗаписи = РегистрыСведений.ПрикрепленныеДанныеЭлектронныхПисем.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.Период = ТекущаяДатаСеанса();
		МенеджерЗаписи.Данные = Выборка.Данные;
		МенеджерЗаписи.ИмяФайла = Выборка.ИмяФайла;
		МенеджерЗаписи.Расширение = Выборка.Расширение;
		МенеджерЗаписи.СсылкаНаОбъект = НовоеПисьмо;
		МенеджерЗаписи.Записать(Ложь);
	КонецЦикла;
	
	Возврат НовоеПисьмо;
	
КонецФункции

