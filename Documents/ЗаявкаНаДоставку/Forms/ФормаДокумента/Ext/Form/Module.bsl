&НаСервере
Процедура ОбновитьИзображениеКомандОтправкиСообщений()
	Если Объект.ОтправленEMail Тогда
		ЭтаФорма.Элементы.ФормаОтправитьПоПочте.Картинка = БиблиотекаКартинок.ОтправленоПисьмо;
	КонецЕсли;
	
	//СМС
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ОтправкаСМС.Ссылка,
	|	1 КАК Создано,
	|	ВЫБОР
	|		КОГДА ОтправкаСМС.Отправлено
	|			ТОГДА 1
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК Отправлено
	|ИЗ
	|	Документ.ОтправкаСМС КАК ОтправкаСМС
	|ГДЕ
	|	ОтправкаСМС.Основание = &Основание";
	Запрос.УстановитьПараметр("Основание", Объект.Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	Если РезультатЗапроса.Количество() > 0 Тогда
		РезультатЗапроса.Свернуть("","Создано, Отправлено");
	КонецЕсли;
	
	Если РезультатЗапроса.Количество() = 0 Тогда
		Элементы.ФормаОтправитьСМС.Картинка = БиблиотекаКартинок.ОтправитьSMS;
	Иначе
		Если РезультатЗапроса[0].Отправлено >= РезультатЗапроса[0].Создано Тогда
			Элементы.ФормаОтправитьСМС.Картинка = БиблиотекаКартинок.ОтправленоСМС;
			ОтправленоСМС = Истина;
		Иначе
			Элементы.ФормаОтправитьСМС.Картинка = БиблиотекаКартинок.ПриготовленоСМС;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияФормыНовогоСМС(РезультатЗакрытия, ДополнительныеПараметры)Экспорт
	ОбновитьИзображениеКомандОтправкиСообщений();
КонецПроцедуры

//++ №10663
&НаСервере
Процедура ПолучитьИдентификаторГородаНаселенногоПункта()
	
	ИдентификаторНаселенногоПункта = ОбщийМодульСервер.ИдентификаторГородаНаселенногоПункта(Объект.Город);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьАдрес(Команда)
	
	Если НЕ ЗначениеЗаполнено(ИдентификаторНаселенногоПункта) Тогда
		ПредставлениеАдресаДоставки = Объект.АдресДоставки;			
	Иначе
		ПредставлениеАдресаДоставки = ПредставлениеАдреса(Объект.Город, Объект.АдресДоставки);
	КонецЕсли;
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ОбработкаВыбораАдресаФИАС", ЭтотОбъект);
	ПараметрыАдреса = Новый Структура;
	ПараметрыАдреса.Вставить("Представление", ПредставлениеАдресаДоставки);
	ПараметрыАдреса.Вставить("ОткрытаПоСценарию", Истина);
	ПараметрыАдреса.Вставить("ВидКонтактнойИнформации", Новый Структура("ПроверятьКорректность", Ложь));

	ОткрытьФорму("Обработка.РасширенныйВводКонтактнойИнформации.Форма.ВводАдреса",ПараметрыАдреса,ЭтаФорма,,,,ОписаниеОповещения);
	Модифицированность = Истина;

КонецПроцедуры

&НаСервереБезКонтекста
Функция ПредставлениеАдреса(Город, Адрес)
	
	Возврат ОбщийМодульСервер.ПредставлениеАдреса(Город, Адрес);
	
КонецФункции

&НаСервере
Процедура ПроверитьНаличиеДанныхВКлассификатореАдресов()
	
	Элементы.ДекорацияКлассификаторНеЗагружен.Видимость = Ложь;
	Элементы.ДекорацияКлассификаторНеЗагружен.Подсказка = "";
	
	//проверим наличие городов	
	Если НЕ ОбщийМодульСервер.ЕстьГородаВСправочнике() Тогда
		Элементы.ДекорацияКлассификаторНеЗагружен.Видимость = Истина;
		Элементы.ДекорацияКлассификаторНеЗагружен.Подсказка = Элементы.ДекорацияКлассификаторНеЗагружен.Подсказка + "В справочнике городов нет ни одного города" + Символы.ПС;
	КонецЕсли;
	
	//проверим наличие данных в классификаторе адресов
	Если ЗначениеЗаполнено(Объект.Город) Тогда
		Если НЕ ЗначениеЗаполнено(ИдентификаторНаселенногоПункта) Тогда
			Элементы.ДекорацияКлассификаторНеЗагружен.Видимость = Истина;		
			Элементы.ДекорацияКлассификаторНеЗагружен.Подсказка = Элементы.ДекорацияКлассификаторНеЗагружен.Подсказка + "В карточке города не указан код КЛАДР или не загружены данные по городу" + Символы.ПС;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбораАдресаФИАС(ЗначениеВыбора, ДополнительныеПараметры) Экспорт
	
	Если ЗначениеВыбора = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗначениеВыбора.ВведеноВСвободнойФорме Тогда 
		Объект.АдресДоставки = ЗначениеВыбора.Представление;
	ИначеЕсли НЕ ЗначениеЗаполнено(ИдентификаторНаселенногоПункта) Тогда
		Объект.АдресДоставки = ОбщийМодульКлиентСервер.УбратьИндексВАдресе(ЗначениеВыбора.Представление);
		ОБъект.Город = ПредопределенноеЗначение("Справочник.Города.ПустаяСсылка");
	Иначе
		ОбработкаВыбораАдресаИзКлассификатораСервер(ЗначениеВыбора.Значение, 
													Объект.Город, Объект.АдресДоставки, ИдентификаторНаселенногоПункта);
	КонецЕсли;
	
	ОбработкаСобытияАдресПриИзменении(Объект.АдресДоставки);

КонецПроцедуры

&НаСервереБезКонтекста
Функция ОбработкаВыбораАдресаИзКлассификатораСервер(АдресJSON, Город, Адрес, ИдентификаторНаселенногоПункта)

	ОбщийМодульСервер.ОбработкаВыбораАдресаИзКлассификатора(АдресJSON, Город, Адрес, ИдентификаторНаселенногоПункта);
	
КонецФункции

&НаКлиенте
Процедура ОбработкаСобытияАдресПриИзменении(Адрес)
		
	Если ПустаяСтрока(Адрес) Тогда
		Объект.ИдентификаторУлицы = ОбщегоНазначенияКлиентСервер.ПустойУникальныйИдентификатор();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СдвинутьКурсорАдресаНаПоследнийСимвол() Экспорт
	
	Элементы.АдресДоставки.ВыделенныйТекст = Объект.АдресДоставки;
	ПозицияОкончания = СтрДлина(Объект.АдресДоставки)+1;
	Элементы.АдресДоставки.УстановитьГраницыВыделения(ПозицияОкончания, ПозицияОкончания);
		
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьТоварыПоОснованиям(Команда)
	
	Если Объект.Товары.Количество() > 0 Тогда
		ПоказатьВопросОбОчищенииТабличнойЧастиТоварыПриЗаполнении();
	Иначе
		ЗаполнитьТоварыПоОснованиямНаСервере();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьВопросОбОчищенииТабличнойЧастиТоварыПриЗаполнении()
	
	ОП = Новый ОписаниеОповещения("ПослеВопросаОбОчищенииТабличнойЧастиТоварыПриЗаполнении", ЭтотОбъект);
	ПоказатьВопрос(ОП, "В табличной части ""Товары"" присутствуют позиции, табличная часть будет очищена, продолжить?", РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВопросаОбОчищенииТабличнойЧастиТоварыПриЗаполнении(Ответ, ДопПараметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Да Тогда
		ЗаполнитьТоварыПоОснованиямНаСервере();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТоварыПоОснованиямНаСервере()
	
	РеквизитОбъект = РеквизитФормыВЗначение("Объект");
	РеквизитОбъект.ЗаполнитьТоварыПоОснованиям();
	ЗначениеВРеквизитФормы(РеквизитОбъект, "Объект");
	
	Модифицированность = Истина;
	
КонецПроцедуры
