
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	УстановитьФильтрыСписка();
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьФильтрыСписка()

	// Текущий статус
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(
		Список
		, "ТекущийСтатус"
		, ФильтрТекущийСтатус
		, ВидСравненияКомпоновкиДанных.Равно
		,
		, ЗначениеЗаполнено(ФильтрТекущийСтатус)
	);
	
	// Дата доставки
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(
		Список
		, "ДатаДоставкиБезВремени"
		, ФильтрДатаДоставки
		, ВидСравненияКомпоновкиДанных.Равно
		,
		, ЗначениеЗаполнено(ФильтрДатаДоставки)
	);
	
	// Ожидаемая дата доставки
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(
		Список
		, "ОжидаемаяДатаДоставкиБезВремени"
		, ФильтрОжидаемаяДатаДоставки
		, ВидСравненияКомпоновкиДанных.Равно
		,
		, ЗначениеЗаполнено(ФильтрОжидаемаяДатаДоставки)
	);
	
	// Дата отправки
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(
		Список
		, "ДатаОтправкиБезВремени"
		, ФильтрДатаОтправки
		, ВидСравненияКомпоновкиДанных.Равно
		,
		, ЗначениеЗаполнено(ФильтрДатаОтправки)
	);
	
	// Ожидаемая дата отправки
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(
		Список
		, "ОжидаемаяДатаОтправкиБезВремени"
		, ФильтрОжидаемаяДатаОтправки
		, ВидСравненияКомпоновкиДанных.Равно
		,
		, ЗначениеЗаполнено(ФильтрОжидаемаяДатаОтправки)
	);
	
	// Получатель
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(
		Список
		, "Получатель"
		, ФильтрПолучатель
		, ВидСравненияКомпоновкиДанных.Равно
		,
		, ЗначениеЗаполнено(ФильтрПолучатель)
	);
	
	// Город
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(
		Список
		, "Город"
		, ФильтрГород
		, ВидСравненияКомпоновкиДанных.Равно
		,
		, ЗначениеЗаполнено(ФильтрГород)
	);
										
КонецПроцедуры

&НаКлиенте
Процедура ФильтрТекущийСтатусПриИзменении(Элемент)
	
	УстановитьФильтрыСписка();
	
КонецПроцедуры

&НаКлиенте
Процедура ФильтрДатаДоставкиПриИзменении(Элемент)
	
	УстановитьФильтрыСписка();
	
КонецПроцедуры

&НаКлиенте
