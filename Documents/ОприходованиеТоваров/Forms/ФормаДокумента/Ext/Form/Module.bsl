КонецПроцедуры

&НаКлиенте
Процедура ПослеВводаДанныхОстатка(Результат, Парам2) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;

	//Для Каждого Отрез из Результат Цикл
	//	ОстатокФактура = Отрез.Фактура;
	//	ОстатокЦвет = Отрез.Цвет;
	//	ОстатокКоличество = Отрез.Количество; //в м2
	//	ПродукцияНомерРасчета = ОбменСEasyCeiling.ПолучитьНомерТиповогоОтреза(Формат(Отрез.Длина,"ЧГ="),Формат(Отрез.Ширина,"ЧГ="));
	//	
	//	НоменклатураОстатка = СоздатьНоменклатуруОстаткаНаСервере(ПродукцияНомерРасчета, ОстатокЦвет, ОстатокКоличество);
	//	
	НоменклатураОстатка = Результат.Номенклатура;
	Если НЕ НоменклатураОстатка.Пустая() Тогда
		НоваяСтрока = Объект.Товары.Добавить();
		НоваяСтрока.Номенклатура = НоменклатураОстатка;
		НоваяСтрока.Количество = 1;
		НоваяСтрока.ЕдиницаИзмерения = ПолучитьАльтернативнуюЕдиницуИзмеренияНоменклатуры(НоваяСтрока.Номенклатура);
		НоваяСтрока.Коэффициент = ПолучитьКоэффициентАльтернативнойЕдиницыИзмерения(НоваяСтрока.Номенклатура);
		Модифицированность = Истина;
	КонецЕсли;			
	//КонецЦикла;	
	
КонецПроцедуры

&НаСервере
Функция ПолучитьКоэффициентАльтернативнойЕдиницыИзмерения(Номенклатура)
	Возврат Номенклатура.АльтернативнаяЕдиницаИзмерения.Коэффициент;
КонецФункции

&НаСервере
Функция СоздатьНоменклатуруОстаткаНаСервере(НомерРасчета, Цвет, Количество)
	
	Возврат ОбменСEasyCeiling.ПолучитьНоменклатуруОстатка(НомерРасчета, Цвет, Количество); 
	
КонецФункции


&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	
	//#2792
	Если ИспользоватьКонтрольКратности Тогда
		ОбщийМодульСервер.ПроверитьКратностьЕдиницИзмерения(Отказ, Объект, Перечисления.ВидыДокументовПроверкиКратности.ОприходованиеТоваров);
	КонецЕсли;
	
КонецПроцедуры

