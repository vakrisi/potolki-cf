&НаКлиенте
Процедура ПослеВводаЗначенияНовойЦены(ВыбЗнач, Параметры) Экспорт
    Если НЕ ВыбЗнач = Неопределено Тогда
		Для Каждого ТекущаяСтрока Из Объект.Товары Цикл
			ТекущаяСтрока.Цена = ВыбЗнач;
			ТекущаяСтрока.Сумма = ТекущаяСтрока.Количество * ТекущаяСтрока.Цена;
		КонецЦикла;
		Модифицированность = Истина;
		ОбновитьДанныеДокумента();
    КонецЕсли;
КонецПроцедуры
	
&НаКлиенте
Процедура ЗаполнитьЦенуПоПоступлениям(Команда)
	
	ЦеныЗаполнены = Ложь;
	ЗаполнитьЦенуПоОприходованиямПоступлениямНаСервере(ЦеныЗаполнены);
	
	Если ЦеныЗаполнены Тогда
		ПоказатьОповещениеПользователя(
			НСтр("ru = 'Цены заполнены'"),
			,
			НСтр("ru= 'В строках документа заполнены цены'"),
			БиблиотекаКартинок.Информация32);
		Модифицированность = Истина;
		ОбновитьДанныеДокумента();
	Иначе
		ПоказатьОповещениеПользователя(
			НСтр("ru = 'Цены не заполнены'"),
			,
			НСтр("ru= 'Ни в одной строке цена не заполнена'"),
			БиблиотекаКартинок.Информация32);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьЦенуПоОприходованиямПоступлениямНаСервере(ЦеныЗаполнены)
                  
	Запрос = Новый Запрос;
	Запрос.Текст = 	
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ИсходнаяТаблица.НомерСтроки КАК НомерСтроки,
	|	ИсходнаяТаблица.Номенклатура КАК Номенклатура,
	|	ИсходнаяТаблица.ХарактеристикаНоменклатуры КАК Характеристика,
	|	ИсходнаяТаблица.СерияНоменклатуры КАК Серия
	|ПОМЕСТИТЬ ТаблицаТовары
	|ИЗ
	|	&ИсходнаяТаблица КАК ИсходнаяТаблица
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ОприходованиеТоваров.Ссылка.МоментВремени КАК МоментВремени,
	|	ОприходованиеТоваров.Номенклатура КАК Номенклатура,
	|	ОприходованиеТоваров.ХарактеристикаНоменклатуры КАК Характеристика,
	|	ОприходованиеТоваров.СерияНоменклатуры КАК Серия,
	|	ОприходованиеТоваров.Цена КАК Цена,
	|	ОприходованиеТоваров.ЕдиницаИзмерения КАК ЕдиницаИзмерения
	|ПОМЕСТИТЬ ЦеныОприходований
	|ИЗ
	|	Документ.ОприходованиеТоваров.Товары КАК ОприходованиеТоваров
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТаблицаТовары КАК ТаблицаТовары
	|		ПО ОприходованиеТоваров.Номенклатура = ТаблицаТовары.Номенклатура
	|			И ОприходованиеТоваров.ХарактеристикаНоменклатуры = ТаблицаТовары.Характеристика
	|			И ОприходованиеТоваров.СерияНоменклатуры = ТаблицаТовары.Серия
	|ГДЕ
	|	ОприходованиеТоваров.Ссылка.Проведен
	|	И ОприходованиеТоваров.Ссылка.Дата < &Дата
	|	И ОприходованиеТоваров.Цена <> 0
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ПоступлениеТоваров.Ссылка.МоментВремени КАК МоментВремени,
	|	ПоступлениеТоваров.Номенклатура КАК Номенклатура,
	|	ПоступлениеТоваров.ХарактеристикаНоменклатуры КАК Характеристика,
	|	ПоступлениеТоваров.СерияНоменклатуры КАК Серия,
	|	ПоступлениеТоваров.Цена КАК Цена,
	|	ПоступлениеТоваров.ЕдиницаИзмерения КАК ЕдиницаИзмерения
	|ПОМЕСТИТЬ ЦеныПоступлений
	|ИЗ
	|	Документ.ПоступлениеТоваровИУслуг.Товары КАК ПоступлениеТоваров
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТаблицаТовары КАК ТаблицаТовары
	|		ПО ПоступлениеТоваров.Номенклатура = ТаблицаТовары.Номенклатура
	|			И ПоступлениеТоваров.ХарактеристикаНоменклатуры = ТаблицаТовары.Характеристика
	|			И ПоступлениеТоваров.СерияНоменклатуры = ТаблицаТовары.Серия
	|ГДЕ
	|	ПоступлениеТоваров.Ссылка.Проведен
	|	И ПоступлениеТоваров.Ссылка.Дата < &Дата
	|	И ПоступлениеТоваров.Цена <> 0
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЦеныОприходований.Номенклатура КАК Номенклатура,
	|	ЦеныОприходований.Характеристика КАК Характеристика,
	|	ЦеныОприходований.Серия КАК Серия,
	|	ЦеныОприходований.Цена КАК Цена,
	|	ЦеныОприходований.ЕдиницаИзмерения КАК ЕдиницаИзмерения
	|ПОМЕСТИТЬ ЦеныПоследнихОприходований
	|ИЗ
	|	ЦеныОприходований КАК ЦеныОприходований
	|		ЛЕВОЕ СОЕДИНЕНИЕ ЦеныОприходований КАК ОтборПоследних
	|		ПО ЦеныОприходований.Номенклатура = ОтборПоследних.Номенклатура
	|			И ЦеныОприходований.Характеристика = ОтборПоследних.Характеристика
	|			И ЦеныОприходований.Серия = ОтборПоследних.Серия
	|			И ЦеныОприходований.МоментВремени < ОтборПоследних.МоментВремени
	|ГДЕ
	|	ОтборПоследних.МоментВремени ЕСТЬ NULL
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЦеныПоступлений.Номенклатура КАК Номенклатура,
	|	ЦеныПоступлений.Характеристика КАК Характеристика,
	|	ЦеныПоступлений.Серия КАК Серия,
	|	ЦеныПоступлений.Цена КАК Цена,
	|	ЦеныПоступлений.ЕдиницаИзмерения КАК ЕдиницаИзмерения
	|ПОМЕСТИТЬ ЦеныПоследнихПоступлений
	|ИЗ
	|	ЦеныПоступлений КАК ЦеныПоступлений
	|		ЛЕВОЕ СОЕДИНЕНИЕ ЦеныПоступлений КАК ОтборПоследних
	|		ПО ЦеныПоступлений.Номенклатура = ОтборПоследних.Номенклатура
	|			И ЦеныПоступлений.Характеристика = ОтборПоследних.Характеристика
	|			И ЦеныПоступлений.Серия = ОтборПоследних.Серия
	|			И ЦеныПоступлений.МоментВремени < ОтборПоследних.МоментВремени
	|ГДЕ
	|	ОтборПоследних.МоментВремени ЕСТЬ NULL
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаТовары.НомерСтроки КАК НомерСтроки,
	|	ТаблицаТовары.Номенклатура КАК Номенклатура,
	|	ТаблицаТовары.Характеристика КАК Характеристика,
	|	ТаблицаТовары.Серия КАК Серия,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(ЦеныПоследнихПоступлений.Номенклатура.БазоваяЕдиницаИзмерения, ЦеныПоследнихОприходований.Номенклатура.БазоваяЕдиницаИзмерения) = ВЫБОР
	|				КОГДА ЕСТЬNULL(ЦеныПоследнихПоступлений.Цена, 0) = 0
	|					ТОГДА ЦеныПоследнихОприходований.ЕдиницаИзмерения
	|				ИНАЧЕ ЦеныПоследнихПоступлений.ЕдиницаИзмерения
	|			КОНЕЦ
	|			ТОГДА ВЫБОР
	|					КОГДА ЕСТЬNULL(ЦеныПоследнихПоступлений.Цена, 0) = 0
	|						ТОГДА ЕСТЬNULL(ЦеныПоследнихОприходований.Цена, 0)
	|					ИНАЧЕ ЕСТЬNULL(ЦеныПоследнихПоступлений.Цена, 0)
	|				КОНЕЦ
	|		ИНАЧЕ ВЫБОР
	|				КОГДА ЕСТЬNULL(ЦеныПоследнихПоступлений.Цена, 0) = 0
	|					ТОГДА ЕСТЬNULL(ЦеныПоследнихОприходований.Цена, 0)
	|				ИНАЧЕ ЕСТЬNULL(ЦеныПоследнихПоступлений.Цена, 0)
	|			КОНЕЦ / ВЫБОР
	|				КОГДА ЕСТЬNULL(ЦеныПоследнихПоступлений.Цена, 0) = 0
	|					ТОГДА ЦеныПоследнихОприходований.ЕдиницаИзмерения.Коэффициент
	|				ИНАЧЕ ЦеныПоследнихПоступлений.ЕдиницаИзмерения.Коэффициент
	|			КОНЕЦ
	|	КОНЕЦ КАК Цена,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(ЦеныПоследнихПоступлений.Цена, 0) = 0
	|			ТОГДА ЦеныПоследнихОприходований.ЕдиницаИзмерения
	|		ИНАЧЕ ЦеныПоследнихПоступлений.ЕдиницаИзмерения
	|	КОНЕЦ КАК ЕдиницаИзмерения
	|ИЗ
	|	ТаблицаТовары КАК ТаблицаТовары
	|		ЛЕВОЕ СОЕДИНЕНИЕ ЦеныПоследнихОприходований КАК ЦеныПоследнихОприходований
	|		ПО ТаблицаТовары.Номенклатура = ЦеныПоследнихОприходований.Номенклатура
	|			И ТаблицаТовары.Характеристика = ЦеныПоследнихОприходований.Характеристика
	|			И ТаблицаТовары.Серия = ЦеныПоследнихОприходований.Серия
	|		ЛЕВОЕ СОЕДИНЕНИЕ ЦеныПоследнихПоступлений КАК ЦеныПоследнихПоступлений
	|		ПО ТаблицаТовары.Характеристика = ЦеныПоследнихПоступлений.Характеристика
	|			И ТаблицаТовары.Серия = ЦеныПоследнихПоступлений.Серия
	|			И ТаблицаТовары.Номенклатура = ЦеныПоследнихПоступлений.Номенклатура";
		
	Запрос.УстановитьПараметр("ИсходнаяТаблица", Объект.Товары.Выгрузить(,"НомерСтроки, Номенклатура, ХарактеристикаНоменклатуры, СерияНоменклатуры"));
	Запрос.УстановитьПараметр("Дата", ?(ЗначениеЗаполнено(Объект.Дата), Объект.Дата, ТекущаяДатаСеанса()));

	   //Запрос.Выполнить().Выгрузить()
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		СтрокаТЧ = Объект.Товары[Выборка.НомерСтроки - 1];
		ЗаполнитьЗначенияСвойств(СтрокаТЧ, Выборка, "Цена");	
		СтрокаТЧ.Сумма = СтрокаТЧ.Количество * СтрокаТЧ.Цена;
		ЦеныЗаполнены = Истина;
		
	КонецЦикла;
	
КонецПроцедуры

