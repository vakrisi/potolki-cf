#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область Печать

Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт
	
    КомандаПечати = КомандыПечати.Добавить();
    КомандаПечати.МенеджерПечати = "Документ.ПеремещениеТоваров";
    КомандаПечати.Идентификатор = "НакладнаяНаПеремещение";
    КомандаПечати.Представление = НСтр("ru = 'Накладная на перемещение'");
    КомандаПечати.ПроверкаПроведенияПередПечатью = Истина; 
	
КонецПроцедуры

// Формирует печатные формы.
//
// Параметры:
// МассивОбъектов – Массив – ссылки на объекты, которые нужно распечатать;
// ПараметрыПечати – Структура – дополнительные настройки печати;
// КоллекцияПечатныхФорм – ТаблицаЗначений – сформированные табличные документы (выходной параметр)
// ОбъектыПечати – СписокЗначений – значение – ссылка на объект;
// представление – имя области, в которой был выведен объект (выходной параметр);
// ПараметрыВывода – Структура – дополнительные параметры сформированных табличных документов (выходной параметр).
//
Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "НакладнаяНаПеремещение") Тогда
        УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
        	КоллекцияПечатныхФорм,
        	"НакладнаяНаПеремещение",
        	НСтр("ru = 'Накладная на перемещение'"),
        	СформироватьПечатнуюФормуТоварнойНакладной(МассивОбъектов, ОбъектыПечати));
    КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьДанныеДляПечатныхФорм(МассивОбъектов) Экспорт
	
	// 1.0.8 В печатной форме документа "Перемещение товаров" реализована группировка строк по одинаковым позициям с суммированием количества товаров
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ПеремещениеТоваров.Ссылка КАК Ссылка,
	|	ПеремещениеТоваров.Номер КАК Номер,
	|	ПеремещениеТоваров.Дата КАК Дата,
	|	ПеремещениеТоваров.Основание КАК Основание,
	|	ПеремещениеТоваров.СкладОтправитель КАК СкладОтправитель,
	|	ПеремещениеТоваров.СкладПолучатель КАК СкладПолучатель,
	|	ПеремещениеТоваров.Организация КАК Организация,
	|	ПРЕДСТАВЛЕНИЕ(ПеремещениеТоваров.Организация) КАК ОрганизацияПредставление,
	|	ПеремещениеТоваров.Автор КАК Автор,
	|	ПеремещениеТоваров.Комментарий КАК Комментарий,
	|	ПеремещениеТоваров.Автор.Сотрудник КАК ОтветственныйСотрудник,
	|	ВЫБОР
	|		КОГДА ПеремещениеТоваров.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийПеремещениеТоваров.Выдача)
	|				ИЛИ ПеремещениеТоваров.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийПеремещениеТоваров.Возврат)
	|					И ПеремещениеТоваров.Основание ССЫЛКА Документ.Монтаж
	|			ТОГДА ВЫРАЗИТЬ(ПеремещениеТоваров.Основание КАК Документ.Монтаж).Адрес
	|		ИНАЧЕ """"
	|	КОНЕЦ КАК АдресМонтажа,
	|	ВЫБОР
	|		КОГДА ПеремещениеТоваров.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийПеремещениеТоваров.Выдача)
	|				ИЛИ ПеремещениеТоваров.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийПеремещениеТоваров.Возврат)
	|					И ПеремещениеТоваров.Основание ССЫЛКА Документ.Монтаж
	|			ТОГДА ВЫРАЗИТЬ(ВЫРАЗИТЬ(ПеремещениеТоваров.Основание КАК Документ.Монтаж).Основание КАК Документ.ЗаказДоговор).НомерДоговора
	|		ИНАЧЕ """"
	|	КОНЕЦ КАК НомерРозничногоДоговора,
	|	ПеремещениеТоваров.ТипПеремещения КАК ТипПеремещения
	|ИЗ
	|	Документ.ПеремещениеТоваров КАК ПеремещениеТоваров
	|ГДЕ
	|	ПеремещениеТоваров.Ссылка В(&МассивОбъектов)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ПеремещениеТоваров.Ссылка,
	|	ПеремещениеТоваров.Дата
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ДанныеДокумента.Ссылка КАК Ссылка,
	|	МИНИМУМ(ДанныеДокумента.НомерСтроки) КАК НомерСтроки,
	|	ДанныеДокумента.Номенклатура.Артикул КАК Артикул,
	|	ДанныеДокумента.Номенклатура КАК Номенклатура,
	|	ДанныеДокумента.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	|	СУММА(ДанныеДокумента.Количество) КАК Количество,
	|	ДанныеДокумента.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	ДанныеДокумента.ЯчейкаОтправитель КАК ЯчейкаОтправитель,
	|	ДанныеДокумента.ЯчейкаПолучатель КАК ЯчейкаПолучатель
	|ИЗ
	|	Документ.ПеремещениеТоваров.Товары КАК ДанныеДокумента
	|ГДЕ
	|	ДанныеДокумента.Ссылка В(&МассивОбъектов)
	|
	|СГРУППИРОВАТЬ ПО
	|	ДанныеДокумента.Ссылка,
	|	ДанныеДокумента.Номенклатура,
	|	ДанныеДокумента.ХарактеристикаНоменклатуры,
	|	ДанныеДокумента.ЕдиницаИзмерения,
	|	ДанныеДокумента.Номенклатура.Артикул,
	|	ДанныеДокумента.ЯчейкаОтправитель,
	|	ДанныеДокумента.ЯчейкаПолучатель
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДанныеДокумента.Ссылка,
	|	МИНИМУМ(ДанныеДокумента.НомерСтроки)
	|ИТОГИ ПО
	|	Ссылка";

	МассивРезультатов         = Запрос.ВыполнитьПакет();
	РезультатПоШапке          = МассивРезультатов[0];
	РезультатПоТабличнойЧастиТовары = МассивРезультатов[1];
	
	СтруктураДанныхДляПечати 	= Новый Структура("РезультатПоШапке, РезультатПоТабличнойЧастиТовары",
	                                               РезультатПоШапке, РезультатПоТабличнойЧастиТовары);
	
	Возврат СтруктураДанныхДляПечати;
	
КонецФункции

Процедура ДополнитьДанныеДляПечатныхФорм(РезультатЗапроса, ВыборкаПоТоварам = Неопределено) Экспорт
	
	ОбщийМодульСервер.ДобавитьКолонкиКонтактнойИнформации(РезультатЗапроса);
	
	Для Каждого ТекущаяСтрока Из РезультатЗапроса Цикл
		
		ОбщийМодульСервер.ДополнитьДанныеДляПечатныхФормКонтактнойИнформацией(ТекущаяСтрока, ТекущаяСтрока.Организация);
		
	КонецЦикла;
	
КонецПроцедуры

Функция СформироватьПечатнуюФормуТоварнойНакладной(МассивОбъектов, ОбъектыПечати) Экспорт
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.АвтоМасштаб         = Истина; //#14053
	ТабличныйДокумент.ИмяПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_ПеремещениеТоваров_Накладная";
	//Макет = ПолучитьОбщийМакет("ТоварнаяНакладнаяНаПеремещение");
	Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.ПеремещениеТоваров.ПФ_MXL_НакладнаяНаПеремещение");
	ВыводитьАртикул = Константы.ВыводитьАртикулНоменклатурыВПечатныхФормах.Получить();
	
	СтруктураДанныхДляПечати = ПолучитьДанныеДляПечатныхФорм(МассивОбъектов);
	ТаблицаДанныеПечати = СтруктураДанныхДляПечати.РезультатПоШапке.Выгрузить();
	ВыборкаПоТоварам = СтруктураДанныхДляПечати.РезультатПоТабличнойЧастиТовары.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	ДополнитьДанныеДляПечатныхФорм(ТаблицаДанныеПечати);
	
	ПервыйДокумент = Истина;
	Для Каждого ДанныеПечати Из ТаблицаДанныеПечати Цикл
		Если Не ПервыйДокумент Тогда
			// Все документы нужно выводить на разных страницах.
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		ПервыйДокумент = Ложь;
		// Запомним номер строки, с которой начали выводить текущий документ.
		НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы + 1;  
		
		ТекстЗаголовка = "Перемещение №" + ПрефиксацияОбъектовКлиентСервер.НомерНаПечать(ДанныеПечати.Номер) + " от " + Формат(ДанныеПечати.Дата, "ДЛф=Д");
	
		ОбластьМакета = Макет.ПолучитьОбласть("Заголовок");
		//ОбластьМакета.Параметры.Заполнить(ДанныеПечати);
		ОбластьМакета.Параметры.ТекстЗаголовка = ТекстЗаголовка;
		
		Склады = "" + Строка(ДанныеПечати.СкладОтправитель) + " >>> " + Строка(ДанныеПечати.СкладПолучатель);
		ОбластьМакета.Параметры.Склады = Склады;
				
		ТабличныйДокумент.Вывести(ОбластьМакета);
		
		ОбластьМакета = Макет.ПолучитьОбласть("ОбластьШтрихкода");
		//nva+++
		ШтрихкодированиеПечатныхФорм.ВывестиШтрихкодВТабличныйДокумент(
				ТабличныйДокумент,
				Макет,
				ОбластьМакета,
				ДанныеПечати.Ссылка);
		//nva---
		ТабличныйДокумент.Вывести(ОбластьМакета);  
		
		ОбластьМакета = Макет.ПолучитьОбласть("СкладНазначения");
		Если ЗначениеЗаполнено(ДанныеПечати.СкладПолучатель) Тогда
			Попытка
				ОбластьМакета.Параметры.СкладНазначения = ВРег(Строка(ДанныеПечати.СкладПолучатель));
			Исключение
			КонецПопытки;
			ТабличныйДокумент.Вывести(ОбластьМакета);
		КонецЕсли;
		
		ОбластьМакета = Макет.ПолучитьОбласть("ОснованиеИКонтрагент");
		Если ЗначениеЗаполнено(ДанныеПечати.Основание) ИЛИ ЗначениеЗаполнено(ДанныеПечати.Основание) 
			ИЛИ ЗначениеЗаполнено(ДанныеПечати.ТипПеремещения) Тогда
			Попытка
				ОбластьМакета.Параметры.Основание = ПрефиксацияОбъектовКлиентСервер.НомерНаПечать(ДанныеПечати.Основание.Номер);
			Исключение
			КонецПопытки;
			Попытка
				ОбластьМакета.Параметры.Контрагент = ДанныеПечати.Основание.Контрагент;
			Исключение
			КонецПопытки;
			Попытка
				ОбластьМакета.Параметры.ТипПеремещения = ВРег(Строка(ДанныеПечати.ТипПеремещения));
			Исключение
			КонецПопытки; 
			ТабличныйДокумент.Вывести(ОбластьМакета);
		КонецЕсли;
		
		//ОбластьМакета = Макет.ПолучитьОбласть("Организация");
		//ОбластьМакета.Параметры.Заполнить(ДанныеПечати);
		//ТабличныйДокумент.Вывести(ОбластьМакета);
		
		//ОбластьМакета = Макет.ПолучитьОбласть("Склады");
		//ОбластьМакета = Макет.ПолучитьОбласть("СкладОтправитель");
		//ОбластьМакета.Параметры.Заполнить(ДанныеПечати);
		//ОбластьМакета.Параметры.ТипПеремещения = ВРег(Строка(ДанныеПечати.ТипПеремещения));
		//ТабличныйДокумент.Вывести(ОбластьМакета);
		
		//ОбластьМакета = Макет.ПолучитьОбласть("СкладПолучатель");
		//ОбластьМакета.Параметры.Заполнить(ДанныеПечати);
		//ТабличныйДокумент.Вывести(ОбластьМакета);
		
		
		//#12283
		Если ЗначениеЗаполнено(ДанныеПечати.АдресМонтажа) ИЛИ ЗначениеЗаполнено(ДанныеПечати.НомерРозничногоДоговора) Тогда
			ОбластьМакета = Макет.ПолучитьОбласть("ДанныеМонтажа");
			ОбластьМакета.Параметры.Заполнить(ДанныеПечати);
			ТабличныйДокумент.Вывести(ОбластьМакета);
		КонецЕсли;
		
		// Изменения размера колоноки, в зависимости от вывода Артикула
		Если Не ВыводитьАртикул Тогда
			Попытка
				Макет.Область("ПерваяКолонкаТовара").ШиринаКолонки = Макет.Область("ПерваяКолонкаТовара").ШиринаКолонки + Макет.Область("Артикул").ШиринаКолонки;
			Исключение
			КонецПопытки;
		КонецЕсли;
		
		ОбластьМакета = Макет.ПолучитьОбласть("ШапкаТаблицы|НомерСтроки");
		ОбластьМакета.Параметры.Заполнить(ДанныеПечати);
		ТабличныйДокумент.Вывести(ОбластьМакета);
		
		Если ВыводитьАртикул Тогда
			ОбластьМакета = Макет.ПолучитьОбласть("ШапкаТаблицы|Артикул");
			ОбластьМакета.Параметры.Заполнить(ДанныеПечати);
			ТабличныйДокумент.Присоединить(ОбластьМакета);
		КонецЕсли;
		
		ОбластьМакета = Макет.ПолучитьОбласть("ШапкаТаблицы|Данные");
		ОбластьМакета.Параметры.Заполнить(ДанныеПечати);
		ТабличныйДокумент.Присоединить(ОбластьМакета);		
		
		 //подготовим табличную часть в зависимости от варианта формирования ПФ 
		ВариантФормированияПФ = Константы.ВариантФормированияПФПеремещения.Получить();
		МассивДопРеквизитов = Новый Массив;
		МассивДопРеквизитов.Добавить(Новый Структура("Имя, Тип", "Артикул", 			Новый ОписаниеТипов("Строка")));		
		МассивДопРеквизитов.Добавить(Новый Структура("Имя, Тип", "ГруппаНоменклатуры", Новый ОписаниеТипов("СправочникСсылка.Номенклатура")));

		ТаблицаТоваров = ОбщийМодульСервер.ТаблицаЗначенийПоТабличнойЧастиОбъекта("ПеремещениеТоваров", "Товары", МассивДопРеквизитов);
		СтруктураПоиска = Новый Структура("Ссылка", ДанныеПечати.Ссылка);		
		ВыборкаПоТоварам.Сбросить();
		Если ВыборкаПоТоварам.НайтиСледующий(СтруктураПоиска) Тогда			
			Выборка = ВыборкаПоТоварам.Выбрать();			
			Пока Выборка.Следующий() Цикл
				ТекущаяСтрока = ТаблицаТоваров.Добавить();
				ЗаполнитьЗначенияСвойств(ТекущаяСтрока, Выборка);				
				
				ТекущаяСтрока.ГруппаНоменклатуры = ТекущаяСтрока.Номенклатура.Родитель;
			КонецЦикла;
		КонецЕсли;
		
		ОтступНоменклатуры = "";
		//0. Без группировок
		//1. По группам номенклатуры
		Если ВариантФормированияПФ = 0 Тогда
			// ничего не делаем 		
		ИначеЕсли ВариантФормированияПФ = 1 Тогда
			ОтступНоменклатуры = "   ";
			ТаблицаТоваров.Сортировать("ГруппаНоменклатуры");
		КонецЕсли;

		НомерСтроки = 1;
		ТекущаяГруппа = Неопределено;
		Для каждого Выборка из ТаблицаТоваров Цикл
			
			//#12807
			Если ВариантФормированияПФ = 1 Тогда
				Если НЕ ТекущаяГруппа = Выборка.ГруппаНоменклатуры Тогда
					ТекущаяГруппа = Выборка.ГруппаНоменклатуры;
					ОбластьМакета = Макет.ПолучитьОбласть("Строка|НомерСтроки");
					ТабличныйДокумент.Вывести(ОбластьМакета);
					Если ВыводитьАртикул Тогда						
						ОбластьМакета = Макет.ПолучитьОбласть("Строка|Артикул");
						ТабличныйДокумент.Присоединить(ОбластьМакета);
					КонецЕсли;					
					ОбластьМакета = Макет.ПолучитьОбласть("Строка|Данные");
					ДопДанныеСтроки = Новый Структура;					
					ДопДанныеСтроки.Вставить("Номенклатура", ?(ТекущаяГруппа.Пустая(), "<...>", ТекущаяГруппа));
					ДопДанныеСтроки.Вставить("ПредставлениеНоменклатуры", ДопДанныеСтроки.Номенклатура);
					ОбластьМакета.Параметры.Заполнить(ДопДанныеСтроки);
					
					ОбластьМакета.ТекущаяОбласть = ОбластьМакета.Область(1,1,1,1);
					ШрифтПотолка = Новый Шрифт(ОбластьМакета.ТекущаяОбласть.Шрифт,,,Истина);
					ОбластьМакета.ТекущаяОбласть.Шрифт = ШрифтПотолка;
					
					ТабличныйДокумент.Присоединить(ОбластьМакета);
				КонецЕсли;
			КонецЕсли;
			
			ДопДанныеСтроки = Новый Структура("НомерСтроки", НомерСтроки);
			//++ №12909
			//ПредставлениеНоменклатуры = Строка(Выборка.Номенклатура) + Строка(УправлениеПечатью.ПредставлениеХарактеристики(Выборка.ХарактеристикаНоменклатуры));
			ПредставлениеНоменклатуры = ОтступНоменклатуры + ОбщийМодульСервер.ПредставлениеНоменклатурыДляПечати(Выборка.Номенклатура, Выборка.ХарактеристикаНоменклатуры);
			//-- №12909
			ДопДанныеСтроки.Вставить("ПредставлениеНоменклатуры", ПредставлениеНоменклатуры);
			
			ОбластьМакета = Макет.ПолучитьОбласть("Строка|НомерСтроки");
			ОбластьМакета.Параметры.Заполнить(ДанныеПечати);
			ОбластьМакета.Параметры.Заполнить(Выборка);
			ОбластьМакета.Параметры.Заполнить(ДопДанныеСтроки);
			ТабличныйДокумент.Вывести(ОбластьМакета);
			
			Если ВыводитьАртикул Тогда
				ОбластьМакета = Макет.ПолучитьОбласть("Строка|Артикул");
				ОбластьМакета.Параметры.Заполнить(ДанныеПечати);
				ОбластьМакета.Параметры.Заполнить(Выборка);
				ОбластьМакета.Параметры.Заполнить(ДопДанныеСтроки);
				ТабличныйДокумент.Присоединить(ОбластьМакета);
			КонецЕсли;
			
			ОбластьМакета = Макет.ПолучитьОбласть("Строка|Данные");
			ОбластьМакета.Параметры.Заполнить(ДанныеПечати);
			ОбластьМакета.Параметры.Заполнить(Выборка);
			ОбластьМакета.Параметры.Заполнить(ДопДанныеСтроки);

			ТабличныйДокумент.Присоединить(ОбластьМакета);
			
			НомерСтроки = НомерСтроки + 1;
		КонецЦикла;
		
		ОбластьМакета = Макет.ПолучитьОбласть("Итого|НомерСтроки");
		ОбластьМакета.Параметры.Заполнить(ДанныеПечати);
		ТабличныйДокумент.Вывести(ОбластьМакета);
		
		Если ВыводитьАртикул Тогда
			ОбластьМакета = Макет.ПолучитьОбласть("Итого|Артикул");
			ОбластьМакета.Параметры.Заполнить(ДанныеПечати);
			ТабличныйДокумент.Присоединить(ОбластьМакета);
		КонецЕсли;
		
		ОбластьМакета = Макет.ПолучитьОбласть("Итого|Данные");
		ОбластьМакета.Параметры.Заполнить(ДанныеПечати);
		ТабличныйДокумент.Присоединить(ОбластьМакета);
		
		//ОбластьМакета = Макет.ПолучитьОбласть("Подписи");
		//ОбластьМакета.Параметры.Заполнить(ДанныеПечати);
		//ТабличныйДокумент.Вывести(ОбластьМакета);
		
		// В табличном документе необходимо задать имя области, в которую был 
        // выведен объект. Нужно для возможности печати комплектов документов.
        УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабличныйДокумент, 
            НомерСтрокиНачало, ОбъектыПечати, ДанныеПечати.Ссылка);		
	КонецЦикла;
	
	ТабличныйДокумент.ТолькоПросмотр = Истина;
	ТабличныйДокумент.ОтображатьЗаголовки = Ложь;
	ТабличныйДокумент.ОтображатьСетку = Ложь;
		
	Возврат ТабличныйДокумент;
	
КонецФункции

#КонецОбласти

#Область СозданиеНаОсновании

// Определяет список команд создания на основании.
//
// Параметры:
//   КомандыСозданияНаОсновании - ТаблицаЗначений - Таблица с командами создания на основании. Для изменения.
//       См. описание 1 параметра процедуры СозданиеНаОснованииПереопределяемый.ПередДобавлениемКомандСозданияНаОсновании().
//   Параметры - Структура - Вспомогательные параметры. Для чтения.
//       См. описание 2 параметра процедуры СозданиеНаОснованииПереопределяемый.ПередДобавлениемКомандСозданияНаОсновании().
//
Процедура ДобавитьКомандыСозданияНаОсновании(КомандыСозданияНаОсновании, Параметры) Экспорт
	
	//++ №8498
	ИспользоватьЗаявкиНаРасходованиеДенежныхСредств = ПолучитьФункциональнуюОпцию("ИспользоватьЗаявкиНаРасходованиеДенежныхСредств");
	
	Если ИспользоватьЗаявкиНаРасходованиеДенежныхСредств Тогда
		Документы.ЗаявкаНаРасходованиеДенежныхСредств.ДобавитьКомандуСоздатьНаОсновании(КомандыСозданияНаОсновании);
	КонецЕсли;
	//-- №8498
	
	Документы.ПередачаМатериаловВЭксплуатацию.ДобавитьКомандуСоздатьНаОсновании(КомандыСозданияНаОсновании);
	
	Документы.ПеремещениеТоваров.ДобавитьКомандуСоздатьНаОсновании(КомандыСозданияНаОсновании);
	
	//++ №8498
	Если Не ИспользоватьЗаявкиНаРасходованиеДенежныхСредств Тогда
		Документы.РасходныйКассовыйОрдер.ДобавитьКомандуСоздатьНаОсновании(КомандыСозданияНаОсновании);
	КонецЕсли;
	//-- №8498
	
	Документы.РеализацияТоваровИУслуг.ДобавитьКомандуСоздатьНаОсновании(КомандыСозданияНаОсновании);
	
КонецПроцедуры

// Добавляет команду создания документа "Перемещение товаров"
//
// Параметры:
//   КомандыСозданияНаОсновании - ТаблицаЗначений - Таблица с командами создания на основании. Для изменения.
//       См. описание 1 параметра процедуры СозданиеНаОснованииПереопределяемый.ПередДобавлениемКомандСозданияНаОсновании().
//
Функция ДобавитьКомандуСоздатьНаОсновании(КомандыСозданияНаОсновании) Экспорт
	
	Если ПравоДоступа("Добавление", Метаданные.Документы.ПеремещениеТоваров) Тогда
		КомандаСоздатьНаОсновании = КомандыСозданияНаОсновании.Добавить();
		КомандаСоздатьНаОсновании.Менеджер = Метаданные.Документы.ПеремещениеТоваров.ПолноеИмя();
		КомандаСоздатьНаОсновании.Представление = Метаданные.Документы.ПеремещениеТоваров.Представление();
		КомандаСоздатьНаОсновании.РежимЗаписи = "Проводить";	

		Возврат КомандаСоздатьНаОсновании;
	КонецЕсли;

	Возврат Неопределено;
	
КонецФункции

#КонецОбласти

#КонецЕсли