#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	Если ЭтоНовый() Тогда		
		ИнициализироватьСлужебныеРеквизиты();
	КонецЕсли;
	
	ОбщийМодуль.ЗаполнитьШапкуДокумента(ЭтотОбъект);
	
	РеквизитыПользователя = ОбщийМодульСервер.НастройкиПользователя("СкладРозница");
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ПоступлениеТоваровИУслуг") Тогда
		// Заполнение шапки
		//Комментарий = ДанныеЗаполнения.Комментарий; //#5849
		Организация = ДанныеЗаполнения.Организация;
		СкладОтправитель = ДанныеЗаполнения.Склад;
		Основание = ДанныеЗаполнения.Ссылка;
		Для Каждого ТекСтрокаТовары Из ДанныеЗаполнения.Товары Цикл
			НоваяСтрока = Товары.Добавить();
			НоваяСтрока.ЕдиницаИзмерения = ТекСтрокаТовары.ЕдиницаИзмерения;
			НоваяСтрока.Количество = ТекСтрокаТовары.Количество;
			НоваяСтрока.Коэффициент = ТекСтрокаТовары.Коэффициент;
			НоваяСтрока.Номенклатура = ТекСтрокаТовары.Номенклатура;
			НоваяСтрока.СерияНоменклатуры = ТекСтрокаТовары.СерияНоменклатуры;
			НоваяСтрока.ХарактеристикаНоменклатуры = ТекСтрокаТовары.ХарактеристикаНоменклатуры;
		КонецЦикла;
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ЗаказДоговор") Тогда
		Организация = ДанныеЗаполнения.Организация;
		СкладОтправитель = РеквизитыПользователя.СкладРозница;
		//СкладПолучатель = 
		ВариантПеремещенияТоваровИзЗаказДоговора = Константы.ВариантПеремещенияТоваровИзЗаказДоговора.Получить();
		// 0 - только материалы 
		// 1 - материалы, товары 
		// 2 - материалы, товары, потолки
		Для Каждого ТекСтрокаТовары Из ДанныеЗаполнения.Материалы Цикл
			Если НЕ ТекСтрокаТовары.Номенклатура.Пустая() Тогда 
				НоваяСтрока = Товары.Добавить();			
				НоваяСтрока.Номенклатура 					= ТекСтрокаТовары.Номенклатура;
				//НоваяСтрока.СерияНоменклатуры 			= ТекСтрокаТовары.СерияНоменклатуры;
				НоваяСтрока.ХарактеристикаНоменклатуры 	= ТекСтрокаТовары.ХарактеристикаНоменклатуры;
				НоваяСтрока.ЕдиницаИзмерения 				= ТекСтрокаТовары.ЕдиницаИзмерения;
				НоваяСтрока.Количество 						= ТекСтрокаТовары.Количество;
				НоваяСтрока.Коэффициент 					= ТекСтрокаТовары.Коэффициент;
			КонецЕсли;	
		КонецЦикла;
				 
		Для Каждого ТекСтрокаТовары Из ДанныеЗаполнения.ТоварыУслуги Цикл
			Если НЕ ТекСтрокаТовары.Номенклатура.Пустая() И НЕ Справочники.ВидыНоменклатуры.ЭтоНоменклатураУслуга(ТекСтрокаТовары.Номенклатура) Тогда
				ЭтоПотолок = Справочники.ВидыНоменклатуры.ЭтоНоменклатураПотолкаИлиОтреза(ТекСтрокаТовары.Номенклатура);
				Если ВариантПеремещенияТоваровИзЗаказДоговора = 1 И НЕ ЭтоПотолок Тогда					
					НоваяСтрока = Товары.Добавить();			
					НоваяСтрока.Номенклатура 					= ТекСтрокаТовары.Номенклатура;
					//НоваяСтрока.СерияНоменклатуры 			= ТекСтрокаТовары.СерияНоменклатуры;
					НоваяСтрока.ХарактеристикаНоменклатуры 	= ТекСтрокаТовары.ХарактеристикаНоменклатуры;
					НоваяСтрока.ЕдиницаИзмерения 				= ТекСтрокаТовары.ЕдиницаИзмерения;
					НоваяСтрока.Количество 						= ТекСтрокаТовары.Количество;
					НоваяСтрока.Коэффициент 					= ТекСтрокаТовары.Коэффициент;					
				ИначеЕсли ВариантПеремещенияТоваровИзЗаказДоговора = 2 Тогда
					НоваяСтрока = Товары.Добавить();			
					НоваяСтрока.Номенклатура 					= ТекСтрокаТовары.Номенклатура;
					//НоваяСтрока.СерияНоменклатуры 			= ТекСтрокаТовары.СерияНоменклатуры;
					НоваяСтрока.ХарактеристикаНоменклатуры 	= ТекСтрокаТовары.ХарактеристикаНоменклатуры;
					НоваяСтрока.ЕдиницаИзмерения 				= ТекСтрокаТовары.ЕдиницаИзмерения;
					НоваяСтрока.Количество 						= ТекСтрокаТовары.Количество;
					НоваяСтрока.Коэффициент 					= ТекСтрокаТовары.Коэффициент;
				КонецЕсли;	
			КонецЕсли;
		КонецЦикла;
		
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.Монтаж") Тогда
		ВидПеремещения = Справочники.ВидыПеремещений.ПеремещениеНаСкладМонтажнойБригады;  //#14793
		Основание = ДанныеЗаполнения.Ссылка;
		Назначение = ДанныеЗаполнения.Ссылка;
		Организация = ДанныеЗаполнения.Организация;
		СкладОтправитель = РеквизитыПользователя.СкладРозница;
		//СкладПолучатель = 
		ВариантПеремещенияТоваровИзЗаказДоговора = Константы.ВариантПеремещенияТоваровИзЗаказДоговора.Получить();
		// 0 - только материалы 
		// 1 - материалы, товары 
		// 2 - материалы, товары, потолки
		Для Каждого ТекСтрокаТовары Из ДанныеЗаполнения.Материалы Цикл
			Если НЕ ТекСтрокаТовары.Номенклатура.Пустая() Тогда 
				НоваяСтрока = Товары.Добавить();			
				НоваяСтрока.Номенклатура 					= ТекСтрокаТовары.Номенклатура;
				НоваяСтрока.СерияНоменклатуры 				= ТекСтрокаТовары.СерияНоменклатуры;
				НоваяСтрока.ХарактеристикаНоменклатуры 		= ТекСтрокаТовары.ХарактеристикаНоменклатуры;
				НоваяСтрока.ЕдиницаИзмерения 				= ТекСтрокаТовары.ЕдиницаИзмерения;
				НоваяСтрока.Количество 						= ТекСтрокаТовары.Количество;
				НоваяСтрока.Коэффициент 					= ТекСтрокаТовары.Коэффициент;
			КонецЕсли;	
		КонецЦикла;
				 
		Для Каждого ТекСтрокаТовары Из ДанныеЗаполнения.ТоварыУслуги Цикл
			Если НЕ ТекСтрокаТовары.Номенклатура.Пустая() И НЕ Справочники.ВидыНоменклатуры.ЭтоНоменклатураУслуга(ТекСтрокаТовары.Номенклатура) Тогда
				ЭтоПотолок = Справочники.ВидыНоменклатуры.ЭтоНоменклатураПотолкаИлиОтреза(ТекСтрокаТовары.Номенклатура);
				Если ВариантПеремещенияТоваровИзЗаказДоговора = 1 И НЕ ЭтоПотолок Тогда					
					НоваяСтрока = Товары.Добавить();			
					НоваяСтрока.Номенклатура 					= ТекСтрокаТовары.Номенклатура;
					НоваяСтрока.СерияНоменклатуры 				= ТекСтрокаТовары.СерияНоменклатуры;
					НоваяСтрока.ХарактеристикаНоменклатуры 		= ТекСтрокаТовары.ХарактеристикаНоменклатуры;
					НоваяСтрока.ЕдиницаИзмерения 				= ТекСтрокаТовары.ЕдиницаИзмерения;
					НоваяСтрока.Количество 						= ТекСтрокаТовары.Количество;
					НоваяСтрока.Коэффициент 					= ТекСтрокаТовары.Коэффициент;					
				ИначеЕсли ВариантПеремещенияТоваровИзЗаказДоговора = 2 Тогда
					НоваяСтрока = Товары.Добавить();			
					НоваяСтрока.Номенклатура 					= ТекСтрокаТовары.Номенклатура;
					НоваяСтрока.СерияНоменклатуры 				= ТекСтрокаТовары.СерияНоменклатуры;
					НоваяСтрока.ХарактеристикаНоменклатуры 		= ТекСтрокаТовары.ХарактеристикаНоменклатуры;
					НоваяСтрока.ЕдиницаИзмерения 				= ТекСтрокаТовары.ЕдиницаИзмерения;
					НоваяСтрока.Количество 						= ТекСтрокаТовары.Количество;
					НоваяСтрока.Коэффициент 					= ТекСтрокаТовары.Коэффициент;
				КонецЕсли;	
			КонецЕсли;
		КонецЦикла;
		
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ПеремещениеТоваров") Тогда
		//Комментарий = ДанныеЗаполнения.Комментарий; //#5849
		Организация = ДанныеЗаполнения.Организация;
		СкладОтправитель = ДанныеЗаполнения.СкладПолучатель;
		СкладПолучатель = ДанныеЗаполнения.СкладОтправитель;
		Назначение = ДанныеЗаполнения.Назначение;
		Основание = ДанныеЗаполнения.Ссылка;
		Если ДанныеЗаполнения.ВидОперации = Перечисления.ВидыОперацийПеремещениеТоваров.Выдача Тогда
			ВидПеремещения = Справочники.ВидыПеремещений.ПеремещениеНаСкладМонтажнойБригады;  //#14793
			ВидОперации = Перечисления.ВидыОперацийПеремещениеТоваров.Возврат;
		КонецЕсли;
		Для Каждого ТекСтрокаТовары Из ДанныеЗаполнения.Товары Цикл
			НоваяСтрока = Товары.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрокаТовары);
		КонецЦикла;
		
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ЗаказПокупателя") Тогда
		//Комментарий = ДанныеЗаполнения.Комментарий; //#5849
		Организация = ДанныеЗаполнения.Организация;
		СкладПолучатель = ДанныеЗаполнения.Склад;
		Основание = ДанныеЗаполнения;
		
		Для Каждого ТекСтрокаТовары Из ДанныеЗаполнения.Товары Цикл
			Если НЕ Справочники.ВидыНоменклатуры.ЭтоНоменклатураУслуга(ТекСтрокаТовары.Номенклатура) Тогда
				НоваяСтрока = Товары.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрокаТовары);
			КонецЕсли;
		КонецЦикла;

	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ЗаказНаПроизводство") Тогда
		// Перемещение готовой продукции по заказу на производство:
		// со склада продукции на склад отгрузки. Переносится только продукция заказа.
		ВидПеремещения = Справочники.ВидыПеремещений.ПеремещениеГотовойПродукции;
		Организация = ДанныеЗаполнения.Организация;
		СкладОтправитель = ДанныеЗаполнения.Склад;
		СкладПолучатель = ДанныеЗаполнения.СкладОтгрузки;
		// Тип "ЗаказНаПроизводство" в реквизит "Основание" не входит — указываем заказ покупателя заказа.
		Если ТипЗнч(ДанныеЗаполнения.ДокументОснование) = Тип("ДокументСсылка.ЗаказПокупателя") Тогда
			Основание = ДанныеЗаполнения.ДокументОснование;
		КонецЕсли;

		Если ДанныеЗаполнения.ВидЗаказа = Перечисления.ВидыЗаказовНаПроизводство.ПроизводствоПотолка Тогда
			Если НЕ ДанныеЗаполнения.ПродукцияНоменклатура.Пустая() Тогда
				НоваяСтрока = Товары.Добавить();
				НоваяСтрока.Номенклатура = ДанныеЗаполнения.ПродукцияНоменклатура;
				НоваяСтрока.ЕдиницаИзмерения = ДанныеЗаполнения.ПродукцияНоменклатураЕдиницаИзмерения;
				НоваяСтрока.Коэффициент = ДанныеЗаполнения.ПродукцияНоменклатураКоэффициент;
				НоваяСтрока.Количество = ДанныеЗаполнения.ПродукцияНоменклатураКоличество;
				НоваяСтрока.Заказ = ДанныеЗаполнения.Ссылка;
			КонецЕсли;
		Иначе
			Для Каждого СтрокаПродукция Из ДанныеЗаполнения.Продукция Цикл
				Если СтрокаПродукция.Номенклатура.Пустая() Тогда
					Продолжить;
				КонецЕсли;
				НоваяСтрока = Товары.Добавить();
				НоваяСтрока.Номенклатура = СтрокаПродукция.Номенклатура;
				НоваяСтрока.ХарактеристикаНоменклатуры = СтрокаПродукция.ХарактеристикаНоменклатуры;
				НоваяСтрока.ЕдиницаИзмерения = СтрокаПродукция.ЕдиницаИзмерения;
				НоваяСтрока.Коэффициент = СтрокаПродукция.Коэффициент;
				НоваяСтрока.Количество = СтрокаПродукция.Количество;
				НоваяСтрока.Заказ = ДанныеЗаполнения.Ссылка;
			КонецЦикла;
		КонецЕсли;

	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("Структура") Тогда
		
		Если ДанныеЗаполнения.Свойство("ПоЗаказамНаПроизводство") Тогда
			// из АРМ производства
			ВидПеремещения = Справочники.ВидыПеремещений.ПеремещениеГотовойПродукции;  //#14793
			Организация = ДанныеЗаполнения.Организация;
			СкладПолучатель = ДанныеЗаполнения.СкладПолучатель;
			СкладОтправитель = ДанныеЗаполнения.СкладОтправитель;
			Для каждого СтрокаОснования из ДанныеЗаполнения.Товары Цикл
				НоваяСтрока = Товары.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаОснования);
				Если ТипЗнч(НоваяСтрока.ЕдиницаИзмерения) = Тип("СправочникСсылка.КлассификаторЕдиницИзмерения") Тогда
					НоваяСтрока.Коэффициент = 1;
				Иначе
					НоваяСтрока.Коэффициент = НоваяСтрока.ЕдиницаИзмерения.Коэффициент;
				КонецЕсли;
			КонецЦикла; 
			
		ИначеЕсли НЕ ДанныеЗаполнения.Свойство("Основание") Тогда
			ЗаполнитьЗначенияСвойств(ЭтотОбъект, ДанныеЗаполнения);	
		Иначе			
			//Основание монтаж
			ВидПеремещения = Справочники.ВидыПеремещений.ПеремещениеНаСкладМонтажнойБригады;  //#14793
			Основание = ДанныеЗаполнения.Основание;
			Назначение = ДанныеЗаполнения.Основание;
			Организация = ДанныеЗаполнения.Основание.Организация;		
			//ТаблицаНазначения = ДанныеЗаполнения.ТаблицаНазначения;  // #13841 реквизит удален
			
			Если ДанныеЗаполнения.Выдача Тогда
				ВидОперации = Перечисления.ВидыОперацийПеремещениеТоваров.Выдача;
				СкладОтправитель = Константы.СкладПриходРасходПриПеремещенииИзМонтажаБригадам.Получить();
				СкладПолучатель = ДанныеЗаполнения.Склад;
			Иначе
				ВидОперации = Перечисления.ВидыОперацийПеремещениеТоваров.Возврат;
				СкладПолучатель = Константы.СкладПриходРасходПриПеремещенииИзМонтажаБригадам.Получить();
				СкладОтправитель = ДанныеЗаполнения.Склад;
			КонецЕсли;	
			
			Для Каждого ТекущаяСтрока Из ДанныеЗаполнения.ПозицииКПеремещению Цикл
				НоваяСтрока = Товары.Добавить();			
				ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущаяСтрока);
				НоваяСтрока.ТаблицаНазначения = ТекущаяСтрока.Таблица;
			КонецЦикла;		
		КонецЕсли;
	
	КонецЕсли;
	
	Если ЭтоНовый() Тогда		
		ДозаполнитьПоУмолчанию();
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	
	ИнициализироватьСлужебныеРеквизиты();
		
	ДозаполнитьПоУмолчанию();
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	Если ЗначениеЗаполнено(СкладОтправитель) И СкладОтправитель = СкладПолучатель Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Один склад не может быть как отправителем, так и получателем. Измените один из складов.",
				ЭтотОбъект,	"СкладОтправитель", , Отказ);
	КонецЕсли;

КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;	
	КонецЕсли;
	
	//#16858 изменился статус
	Если НЕ Отказ И СозданПриИспользованииСтатусовПеремещений Тогда		
		
		Если ЗначениеЗаполнено(Ссылка) Тогда
			СостояниеПроведения = ?(РежимЗаписи = РежимЗаписиДокумента.Проведение, "проведен", "не проведен");
			Если НЕ ТекущийСтатус = Ссылка.ТекущийСтатус Тогда			
				// изменился статус
				Если НЕ ЗначениеЗаполнено(ТекущийСтатус) Тогда
					ТекстЗаписиИстории = СтрШаблон("Изменен статус с ""%1"" на пустой статус (%2)", ТекущийСтатус, СостояниеПроведения);	
				ИначеЕсли НЕ ЗначениеЗаполнено(Ссылка.ТекущийСтатус) Тогда
					ТекстЗаписиИстории = СтрШаблон("Изменен статус с пустого на ""%1"" (%2)", Ссылка.ТекущийСтатус, СостояниеПроведения);
				Иначе
					ТекстЗаписиИстории = СтрШаблон("Изменен статус с ""%1"" на ""%2"" (%3)", Ссылка.ТекущийСтатус, ТекущийСтатус, СостояниеПроведения);
				КонецЕсли;
				РегистрыСведений.ИсторияПеремещенийТоваров.ДобавитьЗапись(Ссылка, ТекущаяДатаСеанса(), Пользователи.ТекущийПользователь(), ТекстЗаписиИстории, Новый УникальныйИдентификатор);
				
			ИначеЕсли (РежимЗаписи = РежимЗаписиДокумента.Проведение И НЕ Ссылка.Проведен) 
				ИЛИ (НЕ РежимЗаписи = РежимЗаписиДокумента.Проведение И Ссылка.Проведен) Тогда
				ТекстЗаписиИстории = СтрШаблон("Изменено состояние на ""%1""", СостояниеПроведения);
				РегистрыСведений.ИсторияПеремещенийТоваров.ДобавитьЗапись(Ссылка, ТекущаяДатаСеанса(), Пользователи.ТекущийПользователь(), ТекстЗаписиИстории, Новый УникальныйИдентификатор);
			КонецЕсли;
		КонецЕсли;
	
	    // даты изменения статусов
		Если НЕ ТекущийСтатус = Ссылка.ТекущийСтатус Тогда
			Если ТекущийСтатус = Перечисления.СтатусыПеремещений.Заявка Тогда 
				ДатаОтправлено = Дата(1,1,1);
				ДатаПолучено = Дата(1,1,1);
				ДатаСобрано = Дата(1,1,1);
			ИначеЕсли ТекущийСтатус = Перечисления.СтатусыПеремещений.Собран Тогда
				ДатаОтправлено = Дата(1,1,1);
				ДатаПолучено = Дата(1,1,1);
				ДатаСобрано = ТекущаяДатаСеанса();
			ИначеЕсли ТекущийСтатус = Перечисления.СтатусыПеремещений.Отправлен Тогда
				ДатаОтправлено = ТекущаяДатаСеанса();
				ДатаПолучено = Дата(1,1,1);
			ИначеЕсли ТекущийСтатус = Перечисления.СтатусыПеремещений.Получен Тогда
				ДатаПолучено = ТекущаяДатаСеанса();
				Если ДатаОтправлено = Дата(1,1,1) Тогда
					ДатаОтправлено = ДатаПолучено;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли; 
		//nva+++
		Если НЕ ЭтоНовый() Тогда
			ДополнительныеСвойства.Вставить("ПредыдущийСтатус", Ссылка.ТекущийСтатус);
		КонецЕсли;
		//nva---
	КонецЕсли;

	// история изменений реквизитов шапки и состава товаров, ведется по всем перемещениям
	Если НЕ Отказ Тогда
		ПодготовитьЗаписиИсторииИзменений();
	КонецЕсли;

КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, Режим)
	
	Если СозданПриИспользованииСтатусовПеремещений
		И (ТекущийСтатус = Перечисления.СтатусыПеремещений.Заявка ИЛИ ТекущийСтатус = Перечисления.СтатусыПеремещений.Собран) Тогда
		Возврат;
	КонецЕсли;
	
	ТребуетсяПриходНаСклад = (НЕ СозданПриИспользованииСтатусовПеремещений
		                      ИЛИ СозданПриИспользованииСтатусовПеремещений И ТекущийСтатус = Перечисления.СтатусыПеремещений.Получен);
							  
	ОрганизацияТоваров = Организация;
	Если Константы.ОбщиеСклады.Получить() Тогда
		ОрганизацияТоваров = Справочники.Организации.ПустаяСсылка();
	КонецЕсли;
	
	//ТоварыНаСкладах (расход)
	ТоварыНаСкладахДатаРасхода = Дата;
	Если СозданПриИспользованииСтатусовПеремещений Тогда
		ТоварыНаСкладахДатаРасхода = ДатаОтправлено;
	ИначеЕсли ТоварыНаСкладахДатаРасхода = Дата(1,1,1) Тогда
		ТоварыНаСкладахДатаРасхода = ТекущаяДатаСеанса();
	КонецЕсли;
	
	Движения.ТоварыНаСкладах.Записывать = Истина;
	Отказ = НЕ Движения.ТоварыНаСкладах.КонтрольОстатков(Ссылка, ОрганизацияТоваров, СкладОтправитель, Товары, ТоварыНаСкладахДатаРасхода);
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	//++ №8793 товары нужно свернуть, чтобы корректно списать себестоимость
	мТовары = Товары.Выгрузить();
	мТовары.Свернуть("Номенклатура, ХарактеристикаНоменклатуры, СерияНоменклатуры, ЕдиницаИзмерения, Коэффициент", "Количество");
	мТовары.Колонки.Добавить("Сумма",Новый ОписаниеТипов("Число"));
	мТовары.Колонки.Добавить("СуммаВал",Новый ОписаниеТипов("Число"));
	//-- №8793
	Для Каждого СтрокаТовара Из мТовары Цикл
		Движение = Движения.ТоварыНаСкладах.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
		Движение.Период = ТоварыНаСкладахДатаРасхода;
		Движение.Организация = ОрганизацияТоваров;
		Движение.Склад = СкладОтправитель;
		Движение.Номенклатура = СтрокаТовара.Номенклатура;
		Движение.ХарактеристикаНоменклатуры = СтрокаТовара.ХарактеристикаНоменклатуры;
		Движение.СерияНоменклатуры = СтрокаТовара.СерияНоменклатуры;
		Движение.Количество = СтрокаТовара.Количество * СтрокаТовара.Коэффициент;
		//#8288
		//Расход.Сумма = Расход.Количество * Движения.ТоварыНаСкладах.ПолучитьЦенуОстаткаНоменклатуры(ТоварыНаСкладахДатаСписания, ОрганизацияТоваров, СкладОтправитель, Расход.Номенклатура, Расход.ХарактеристикаНоменклатуры, Расход.СерияНоменклатуры);
		СтруктураЦенОстатков = Движения.ТоварыНаСкладах.ПолучитьЦеныОстаткаНоменклатуры(ТоварыНаСкладахДатаРасхода, ОрганизацияТоваров, СкладОтправитель, Движение.Номенклатура, Движение.ХарактеристикаНоменклатуры, Движение.СерияНоменклатуры);
		Движение.Сумма = Движение.Количество * СтруктураЦенОстатков.Цена;
		Движение.СуммаВал = Движение.Количество * СтруктураЦенОстатков.ЦенаВал;
		
		СтрокаТовара.Сумма = Движение.Сумма;
		СтрокаТовара.СуммаВал = Движение.СуммаВал;
	КонецЦикла;
	
	//ТоварыВПутиНаСкладах (приход)
	Если СозданПриИспользованииСтатусовПеремещений Тогда
		Движения.ТоварыВПутиНаСкладах.Записывать = Истина;
		Для Каждого Товар Из мТовары Цикл
			Движение = Движения.ТоварыВПутиНаСкладах.Добавить();
			Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
			Движение.Период = ДатаОтправлено;
			Движение.СкладОтправитель = СкладОтправитель;
			Движение.СкладПолучатель = СкладПолучатель;
			Движение.Номенклатура = Товар.Номенклатура;
			Движение.ХарактеристикаНоменклатуры = Товар.ХарактеристикаНоменклатуры;
			Движение.Количество = Товар.Количество * Товар.Коэффициент;
		КонецЦикла;	
	КонецЕсли;
	
	//ТаблицаТоваров = Новый ТаблицаЗначений;
	//ТаблицаТоваров = Товары.Выгрузить();
	//ТаблицаТоваров.Колонки.Добавить("Сумма",Новый ОписаниеТипов("Число"));
	//ЗаполнитьСтоимостьПриходаПоСписанию(ТаблицаТоваров);
	
	//ТоварыНаСкладах (приход)
	Если ТребуетсяПриходНаСклад Тогда
		ТоварыНаСкладахДатаПрихода = Дата;
		Если СозданПриИспользованииСтатусовПеремещений Тогда
			ТоварыНаСкладахДатаПрихода = ДатаПолучено;
		КонецЕсли;
		//Для Каждого СтрокаТовара Из ТаблицаТоваров Цикл
		Для Каждого СтрокаТовара Из мТовары Цикл
			Движение = Движения.ТоварыНаСкладах.Добавить();
			Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
			Движение.Период = ТоварыНаСкладахДатаПрихода;
			Движение.Организация = ОрганизацияТоваров;
			Движение.Склад = СкладПолучатель;
			Движение.Номенклатура = СтрокаТовара.Номенклатура;
			Движение.ХарактеристикаНоменклатуры = СтрокаТовара.ХарактеристикаНоменклатуры;
			Движение.СерияНоменклатуры = СтрокаТовара.СерияНоменклатуры;
			Движение.Количество = СтрокаТовара.Количество * СтрокаТовара.Коэффициент;
			// #16858 исправлено на суммы списания
			//Двиижение.Сумма = РаботаСВалютой.ПолучитьСуммуВВалютеУчетаПоДокументу(Ссылка, СтрокаТовара.Сумма);
			//Движение.СуммаВал = РаботаСВалютой.ПолучитьСуммуВДопВалютеУчетаПоДокументу(Ссылка, СтрокаТовара.Сумма); //#8288
			Движение.Сумма = СтрокаТовара.Сумма;
			Движение.СуммаВал = СтрокаТовара.СуммаВал;
		КонецЦикла;
	КонецЕсли;
	
	//ТоварыВПутиНаСкладах (расход)
	Если СозданПриИспользованииСтатусовПеремещений И ТекущийСтатус = Перечисления.СтатусыПеремещений.Получен Тогда
		Движения.ТоварыВПутиНаСкладах.Записывать = Истина;
		Для Каждого Товар Из мТовары Цикл
			Движение = Движения.ТоварыВПутиНаСкладах.Добавить();
			Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
			Движение.Период = ДатаПолучено;
			Движение.СкладОтправитель = СкладОтправитель;
			Движение.СкладПолучатель = СкладПолучатель;
			Движение.Номенклатура = Товар.Номенклатура;
			Движение.ХарактеристикаНоменклатуры = Товар.ХарактеристикаНоменклатуры;
			Движение.Количество = Товар.Количество * Товар.Коэффициент;
		КонецЦикла;	
	КонецЕсли;
	
	//ТоварыПроизводстваВПути
	Движения.ТоварыПроизводстваВПути.Записывать = Истина;
	Для Каждого ТекСтрока Из Товары Цикл
		Если ТекСтрока.Заказ.Пустая() Тогда
			Продолжить;
		КонецЕсли;
		НоваяЗапись = Движения.ТоварыПроизводстваВПути.Добавить();
		НоваяЗапись.Период = Дата;
		НоваяЗапись.Активность = Истина;
		НоваяЗапись.Заказ = ТекСтрока.Заказ;					
		НоваяЗапись.СкладОтправитель = СкладОтправитель;
		НоваяЗапись.СкладПолучатель = СкладПолучатель;	
		НоваяЗапись.Номенклатура = ТекСтрока.Номенклатура;
		НоваяЗапись.КоличествоОтправлено = ТекСтрока.Количество * ТекСтрока.Коэффициент;	
	КонецЦикла;
	Если (НЕ СозданПриИспользованииСтатусовПеремещений И Получено) 
		ИЛИ (СозданПриИспользованииСтатусовПеремещений И ТекущийСтатус = Перечисления.СтатусыПеремещений.Получен) Тогда
		Для Каждого ТекСтрока Из Товары Цикл
			Если ТекСтрока.Заказ.Пустая() Тогда
				Продолжить;
			КонецЕсли;
			НоваяЗапись = Движения.ТоварыПроизводстваВПути.Добавить();
			НоваяЗапись.Период = ?(НЕ СозданПриИспользованииСтатусовПеремещений, ПолученоДата, ДатаПолучено);
			НоваяЗапись.Активность = Истина;
			НоваяЗапись.Заказ = ТекСтрока.Заказ;							
			НоваяЗапись.СкладОтправитель = СкладОтправитель;
			НоваяЗапись.СкладПолучатель = СкладПолучатель;
			НоваяЗапись.Номенклатура = ТекСтрока.Номенклатура;
			НоваяЗапись.КоличествоПолучено = ТекСтрока.Количество * ТекСтрока.Коэффициент;
		КонецЦикла;
	КонецЕсли;
	
	//ПотребностьВМатериалахДляМонтажа
	Движения.ПотребностьВМатериалахДляМонтажа.Записывать = Истина;
	Если ТипЗнч(Назначение) = Тип("ДокументСсылка.Монтаж") И НЕ Назначение.Пустая() Тогда
		Если ВидОперации = Перечисления.ВидыОперацийПеремещениеТоваров.Выдача Тогда
			Для Каждого ТекСтрокаТовары Из Товары Цикл
				Расход = Движения.ПотребностьВМатериалахДляМонтажа.Добавить();
				Расход.Период 							= Дата;
				Расход.ВидДвижения 						= ВидДвиженияНакопления.Расход;
				Расход.Монтаж 							= Назначение;
				Расход.Номенклатура 					= ТекСтрокаТовары.Номенклатура;
				Расход.Количество 						= ТекСтрокаТовары.Количество * ТекСтрокаТовары.Коэффициент;
			КонецЦикла;
		ИначеЕсли ВидОперации = Перечисления.ВидыОперацийПеремещениеТоваров.Возврат Тогда
			Для Каждого ТекСтрокаТовары Из Товары Цикл
				Расход = Движения.ПотребностьВМатериалахДляМонтажа.Добавить();
				Расход.Период 							= Дата;
				Расход.ВидДвижения 						= ВидДвиженияНакопления.Расход;
				Расход.Монтаж 							= Назначение;
				Расход.Номенклатура 					= ТекСтрокаТовары.Номенклатура;
				Расход.Количество 						= -1 * (ТекСтрокаТовары.Количество * ТекСтрокаТовары.Коэффициент);
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;

	// регистр ТоварыВРезервеНаСкладах Расход (15815)
	Движения.ТоварыВРезервеНаСкладах.Записывать = Истина;
	Если ВидОперации = Перечисления.ВидыОперацийПеремещениеТоваров.Выдача Тогда
		// Получим выборку по резерву
		Выборка = РегистрыНакопления.ТоварыВРезервеНаСкладах.КонтрольРезерва(Основание, Организация, СкладОтправитель, Дата, Товары);
		Пока Выборка.Следующий() Цикл
			Если Выборка.КоличествоРезерве > 0 Тогда
				Движение = Движения.ТоварыВРезервеНаСкладах.Добавить();
				Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
				Движение.Период = Дата;
				Движение.ВидТабличнойЧасти = Перечисления.ВидыТабличнойЧасти.Товары;
				Движение.ДокументРезерва = Основание;
				Движение.Организация = Организация;
				Движение.Склад = СкладОтправитель;
				Движение.Номенклатура = Выборка.Номенклатура;
				Движение.ХарактеристикаНоменклатуры = Выборка.ХарактеристикаНоменклатуры;
				Движение.СерияНоменклатуры = Выборка.СерияНоменклатуры;
				Движение.Количество = ?(Выборка.Количество*Выборка.Коэффициент > Выборка.КоличествоРезерве, Выборка.КоличествоРезерве, Выборка.Количество*Выборка.Коэффициент);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область Заполнение

Процедура ИнициализироватьСлужебныеРеквизиты()
		
	СозданПриИспользованииСтатусовПеремещений = Константы.ИспользоватьСтатусыПеремещений.Получить();
	Если СозданПриИспользованииСтатусовПеремещений Тогда
		ТекущийСтатус = Перечисления.СтатусыПеремещений.НачальныйСтатус();	
	КонецЕсли;
	 
КонецПроцедуры

Процедура ДозаполнитьПоУмолчанию()
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ЗаполнитьСтоимостьПриходаПоСписанию(ТаблицаТоваров)
	
	ОрганизацияТоваров = Организация;
	Если Константы.ОбщиеСклады.Получить() Тогда
		ОрганизацияТоваров = Справочники.Организации.ПустаяСсылка();
	КонецЕсли;
	
	Для Каждого ТекущийТовар Из ТаблицаТоваров Цикл
		Цена = Движения.ТоварыНаСкладах.ПолучитьЦенуОстаткаНоменклатуры(Дата, ОрганизацияТоваров, СкладОтправитель, ТекущийТовар.Номенклатура, ТекущийТовар.ХарактеристикаНоменклатуры, ТекущийТовар.СерияНоменклатуры);
		ТекущийТовар.Сумма = ТекущийТовар.Количество * ТекущийТовар.Коэффициент * Цена;
	КонецЦикла;
	
КонецПроцедуры

//nva+++
Процедура ПриЗаписи(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	Если ДополнительныеСвойства.Свойство("ПредыдущийСтатус")
		И НЕ ТекущийСтатус = ДополнительныеСвойства.ПредыдущийСтатус 
		И ДополнительныеСвойства.ПредыдущийСтатус = Перечисления.СтатусыПеремещений.Получен
		И ТекущийСтатус = Перечисления.СтатусыПеремещений.Отменен Тогда
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Нельзя менять со статуса ""Получен"" на статус ""Отменен""", , , , Отказ);
	КонецЕсли; 
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;

	ЗаписатьПодготовленныеЗаписиИстории();

КонецПроцедуры
//nva---

#Область ИсторияИзменений

// Сравнивает записываемый документ с его версией в базе и складывает описания изменений
// в ДополнительныеСвойства. В регистр они попадают в ПриЗаписи - там ссылка документа
// уже заполнена и запись гарантированно не отменена.
//
Процедура ПодготовитьЗаписиИсторииИзменений()

	ДополнительныеСвойства.Удалить("ЗаписиИсторииИзменений");

	Если ЭтоНовый() ИЛИ НЕ ЗначениеЗаполнено(Ссылка) Тогда
		// запись о создании документа добавляет форма
		Возврат;
	КонецЕсли;

	ЗаписиИстории = Новый Массив;
	ДобавитьОписанияИзмененийРеквизитов(ЗаписиИстории);
	ДобавитьОписаниеИзмененийТоваров(ЗаписиИстории);

	Если ЗаписиИстории.Количество() > 0 Тогда
		ДополнительныеСвойства.Вставить("ЗаписиИсторииИзменений", ЗаписиИстории);
	КонецЕсли;

КонецПроцедуры

Процедура ЗаписатьПодготовленныеЗаписиИстории()

	ЗаписиИстории = Неопределено;
	Если НЕ ДополнительныеСвойства.Свойство("ЗаписиИсторииИзменений", ЗаписиИстории) Тогда
		Возврат;
	КонецЕсли;

	ДатаЗаписи = ТекущаяДатаСеанса();
	ТекущийПользователь = Пользователи.ТекущийПользователь();
	Для Каждого ТекстЗаписиИстории Из ЗаписиИстории Цикл
		РегистрыСведений.ИсторияПеремещенийТоваров.ДобавитьЗапись(Ссылка, ДатаЗаписи, ТекущийПользователь, ТекстЗаписиИстории, Новый УникальныйИдентификатор);
	КонецЦикла;

	ДополнительныеСвойства.Удалить("ЗаписиИсторииИзменений");

КонецПроцедуры

Процедура ДобавитьОписанияИзмененийРеквизитов(ЗаписиИстории)

	ДобавитьОписаниеИзмененияРеквизита(ЗаписиИстории, "Изменена организация",      Ссылка.Организация,      Организация);
	ДобавитьОписаниеИзмененияРеквизита(ЗаписиИстории, "Изменен вид операции",      Ссылка.ВидОперации,      ВидОперации);
	ДобавитьОписаниеИзмененияРеквизита(ЗаписиИстории, "Изменен вид перемещения",   Ссылка.ВидПеремещения,   ВидПеремещения);
	ДобавитьОписаниеИзмененияРеквизита(ЗаписиИстории, "Изменен тип перемещения",   Ссылка.ТипПеремещения,   ТипПеремещения);
	ДобавитьОписаниеИзмененияРеквизита(ЗаписиИстории, "Изменен склад-отправитель", Ссылка.СкладОтправитель, СкладОтправитель);
	ДобавитьОписаниеИзмененияРеквизита(ЗаписиИстории, "Изменен склад-получатель",  Ссылка.СкладПолучатель,  СкладПолучатель);

КонецПроцедуры

Процедура ДобавитьОписаниеИзмененияРеквизита(ЗаписиИстории, ТекстИзменения, СтароеЗначение, НовоеЗначение)

	Если СтароеЗначение = НовоеЗначение Тогда
		Возврат;
	КонецЕсли;

	ЗаписиИстории.Добавить(СтрШаблон("%1 с ""%2"" на ""%3""",
		ТекстИзменения,
		ПредставлениеЗначенияДляИстории(СтароеЗначение),
		ПредставлениеЗначенияДляИстории(НовоеЗначение)));

КонецПроцедуры

// Добавляет одну сводную запись об изменении состава товаров: сколько позиций добавлено,
// удалено и у скольких изменилось количество. Позиции сопоставляются по номенклатуре,
// характеристике, серии, единице измерения и заказу.
//
Процедура ДобавитьОписаниеИзмененийТоваров(ЗаписиИстории)

	КолонкиКлюча = "Номенклатура,ХарактеристикаНоменклатуры,СерияНоменклатуры,ЕдиницаИзмерения,Заказ";

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТоварыВБазе.Номенклатура КАК Номенклатура,
	|	ТоварыВБазе.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	|	ТоварыВБазе.СерияНоменклатуры КАК СерияНоменклатуры,
	|	ТоварыВБазе.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	ТоварыВБазе.Заказ КАК Заказ,
	|	СУММА(ТоварыВБазе.Количество) КАК Количество
	|ИЗ
	|	Документ.ПеремещениеТоваров.Товары КАК ТоварыВБазе
	|ГДЕ
	|	ТоварыВБазе.Ссылка = &Ссылка
	|
	|СГРУППИРОВАТЬ ПО
	|	ТоварыВБазе.Номенклатура,
	|	ТоварыВБазе.ХарактеристикаНоменклатуры,
	|	ТоварыВБазе.СерияНоменклатуры,
	|	ТоварыВБазе.ЕдиницаИзмерения,
	|	ТоварыВБазе.Заказ";
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	ТоварыВБазе = Запрос.Выполнить().Выгрузить();
	ТоварыВБазе.Индексы.Добавить(КолонкиКлюча);

	ТоварыДокумента = Товары.Выгрузить();
	ТоварыДокумента.Свернуть(КолонкиКлюча, "Количество");
	ТоварыДокумента.Индексы.Добавить(КолонкиКлюча);

	Добавлено = 0;
	Удалено   = 0;
	Изменено  = 0;

	Для Каждого СтрокаДокумента Из ТоварыДокумента Цикл
		Отбор = Новый Структура(КолонкиКлюча);
		ЗаполнитьЗначенияСвойств(Отбор, СтрокаДокумента);
		НайденныеСтроки = ТоварыВБазе.НайтиСтроки(Отбор);
		Если НайденныеСтроки.Количество() = 0 Тогда
			Добавлено = Добавлено + 1;
		ИначеЕсли НЕ НайденныеСтроки[0].Количество = СтрокаДокумента.Количество Тогда
			Изменено = Изменено + 1;
		КонецЕсли;
	КонецЦикла;

	Для Каждого СтрокаБазы Из ТоварыВБазе Цикл
		Отбор = Новый Структура(КолонкиКлюча);
		ЗаполнитьЗначенияСвойств(Отбор, СтрокаБазы);
		Если ТоварыДокумента.НайтиСтроки(Отбор).Количество() = 0 Тогда
			Удалено = Удалено + 1;
		КонецЕсли;
	КонецЦикла;

	Если Добавлено = 0 И Удалено = 0 И Изменено = 0 Тогда
		Возврат;
	КонецЕсли;

	ЗаписиИстории.Добавить(СтрШаблон(
		"Изменен состав товаров: добавлено позиций - %1, удалено - %2, изменено количество - %3",
		Добавлено, Удалено, Изменено));

КонецПроцедуры

Функция ПредставлениеЗначенияДляИстории(Значение)

	Возврат ?(ЗначениеЗаполнено(Значение), Строка(Значение), "не заполнено");

КонецФункции

