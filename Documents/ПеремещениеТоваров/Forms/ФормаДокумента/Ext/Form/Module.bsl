&НаСервере
Процедура ПроверитьТолькоРедактированиеСтатуса(Отказ)
	
	Если ТолькоПросмотр Тогда
		Возврат;
	КонецЕсли;
	
	Если РольДоступна("ДокументПеремещениеТоваровРедактированиеСтатуса")
		И НЕ РольДоступна("ДокументПеремещениеТоваровРедактирование") Тогда
		
		Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
			Отказ = Истина;
			Возврат;
		КонецЕсли;
		
		Для каждого Элемент из Элементы Цикл			
			Если Элемент.Имя = "ТекущийСтатус" 
				ИЛИ Элемент.Имя = "ФормаЗаписать"
				ИЛИ СтрНайти(Элемент.Имя, "ПодменюПечать") > 1 Тогда
				Продолжить;
			КонецЕсли;
			Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Элемент, "ПодчиненныеЭлементы") Тогда
				Продолжить;
			КонецЕсли;
			Если ТипЗнч(Элемент) = Тип("ДекорацияФормы") Тогда
				Продолжить;
			КонецЕсли;
			
			ИмяСвойства = "ТолькоПросмотр";
			ЗначениеСвойства = Истина;
			Если ТипЗнч(Элемент) = Тип("КнопкаФормы") ИЛИ ТипЗнч(Элемент) = Тип("ДополнениеЭлементаФормы") Тогда
				ИмяСвойства = "Доступность";
				ЗначениеСвойства = Ложь;	
			КонецЕсли;
			Элемент[ИмяСвойства] = ЗначениеСвойства;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УправлениеФормой()
	
	//Если ТипЗнч(Объект.Основание) = Тип("ДокументСсылка.Монтаж") Тогда
	Если Объект.ВидПеремещения = Справочники.ВидыПеремещений.ПеремещениеНаСкладМонтажнойБригады Тогда
		Элементы.ВидОперации.Видимость = Истина;
		Элементы.ТоварыТаблицаНазначения.Видимость = Истина;
	Иначе
		Элементы.ВидОперации.Видимость = Ложь;
		Элементы.ТоварыТаблицаНазначения.Видимость = Ложь;
	КонецЕсли;
	
	//#16858
	Элементы.ТекущийСтатус.Видимость = Объект.СозданПриИспользованииСтатусовПеремещений;
	Элементы.ГруппаДатыСтатуса.Видимость = Объект.СозданПриИспользованииСтатусовПеремещений;
	Элементы.ГруппаОтправка.Видимость = НЕ Объект.СозданПриИспользованииСтатусовПеремещений;
	Элементы.ГруппаПолучение.Видимость = НЕ Объект.СозданПриИспользованииСтатусовПеремещений;	
	
	Элементы.ДекорацияОтступЛево.Видимость  = Элементы.ВидОперации.Видимость И Элементы.ТекущийСтатус.Видимость; // когда одновременно есть 2 поля
	Элементы.ДекорацияОтступПраво.Видимость = НЕ Элементы.ВидОперации.Видимость И НЕ Элементы.ТекущийСтатус.Видимость; // когда одновременно нет 2 полей
	
	Элементы.ТоварыЗаказ.Видимость = Объект.ВидПеремещения = Справочники.ВидыПеремещений.ПеремещениеГотовойПродукции;
	
КонецПроцедуры

&НаСервере
Процедура ПолучитьЗаписиИсторииМонтажаИзРегистраНаСервере()
	
	Если Объект.Ссылка.Пустая() Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ДанныеРегистра.Дата КАК Дата,
	|	ДанныеРегистра.Пользователь КАК Пользователь,
	|	ДанныеРегистра.Комментарий КАК Комментарий,
	|	ЛОЖЬ КАК ЭтоНоваяЗапись,
	|	ДанныеРегистра.ИДЗаписи КАК ИДЗаписи
	|ИЗ
	|	РегистрСведений.ИсторияПеремещенийТоваров КАК ДанныеРегистра
	|ГДЕ
	|	ДанныеРегистра.Перемещение = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", Объект.Ссылка);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Отбор = Новый Структура;
		Отбор.Вставить("ИДЗаписи", Выборка.ИДЗаписи);
		Отбор.Вставить("Дата", Выборка.Дата);
		НайденныеСтроки = ИсторияПеремещенияНаФорме.НайтиСтроки(Отбор);
		Если НайденныеСтроки.Количество() = 0 Тогда
			СтрокаЗаписи = ИсторияПеремещенияНаФорме.Добавить();
		Иначе
			СтрокаЗаписи = НайденныеСтроки[0];
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(СтрокаЗаписи, Выборка);
	КонецЦикла;
	
	ИсторияПеремещенияНаФорме.Сортировать("Дата Возр");
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьЗаписьВИсторию(Комментарий)
	
	НоваяСтрока = ИсторияПеремещенияНаФорме.Добавить();
	НоваяСтрока.Дата = ТекущаяДатаСеанса();
	НоваяСтрока.Пользователь = Пользователи.ТекущийПользователь();
	НоваяСтрока.Комментарий = Комментарий;
	НоваяСтрока.ЭтоНоваяЗапись = Истина;
	НоваяСтрока.ИДЗаписи = Новый УникальныйИдентификатор;
	
КонецПроцедуры

&НаСервере
Процедура ЗаписатьИсториюНаФормеВРегистр()
	
	Для Каждого ТекущаяСтрока Из ИсторияПеремещенияНаФорме Цикл
		Если ТекущаяСтрока.ЭтоНоваяЗапись Тогда
			РегистрыСведений.ИсторияПеремещенийТоваров.ДобавитьЗапись(Объект.Ссылка, ТекущаяСтрока.Дата, ТекущаяСтрока.Пользователь, ТекущаяСтрока.Комментарий, ТекущаяСтрока.ИДЗаписи);		 
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

