&НаСервере
Процедура ПослеВыбораВидаНоменклатуры(ВыбЗнач, Параметры) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТоварыНаСкладахОстатки.Номенклатура,
	|	ТоварыНаСкладахОстатки.ХарактеристикаНоменклатуры,
	|	ТоварыНаСкладахОстатки.СерияНоменклатуры,
	|	ТоварыНаСкладахОстатки.КоличествоОстаток КАК Количество,
	|	ТоварыНаСкладахОстатки.Номенклатура.БазоваяЕдиницаИзмерения КАК ЕдиницаИзмерения
	|ИЗ
	|	РегистрНакопления.ТоварыНаСкладах.Остатки(, Склад = &Склад) КАК ТоварыНаСкладахОстатки
	|ГДЕ
	|	ТоварыНаСкладахОстатки.Номенклатура.ВидНоменклатуры = &ВидНоменклатуры";
	
	Запрос.УстановитьПараметр("Склад", Объект.СкладОтправитель); 
	Запрос.УстановитьПараметр("ВидНоменклатуры", ВыбЗнач);
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда 
		Сообщить("Нет остатков на складе");
		Возврат;
	КонецЕсли;
	
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = Объект.Товары.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		НоваяСтрока.Коэффициент = 1;
	КонецЦикла;
	
	ЗаполнитьОстаткиПоТоварам(); // №11476

КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьКоличествоПоПотолкам(Команда)
	
	Если Объект.Товары.Количество() > 0 Тогда 
		ОписаниеОповещения = Новый ОписаниеОповещения ("ПослеВопросаЗаполнитьКоличествоПоПотолкам", ЭтотОбъект);
		ПоказатьВопрос(ОписаниеОповещения,"Для потолков колонка ""Количество"" будет заполнена значением площади из карточки потолка.
				|Продолжить?",РежимДиалогаВопрос.ДаНет);
	Иначе
		Сообщить("Табличная часть ""Товары"" пустая");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВопросаЗаполнитьКоличествоПоПотолкам(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Нет Тогда 
		Возврат;
	КонецЕсли;
	ЗаполнитьКоличествоПоПотолкамНаСервере();
	
КонецПроцедуры	

&НаСервере
Процедура ЗаполнитьКоличествоПоПотолкамНаСервере()
	
	Для каждого СтрокаТабличнойЧасти из объект.Товары Цикл
		Если Справочники.ВидыНоменклатуры.ЭтоНоменклатураУникальногоПотолкаИлиОтреза(СтрокаТабличнойЧасти.Номенклатура) Тогда
			Если СтрокаТабличнойЧасти.Номенклатура.Потолок_КоличествоПродукция > 0 
				И СтрокаТабличнойЧасти.Количество <> СтрокаТабличнойЧасти.Номенклатура.Потолок_КоличествоПродукция Тогда
				СтрокаТабличнойЧасти.Количество = СтрокаТабличнойЧасти.Номенклатура.Потолок_КоличествоПродукция;
				Модифицированность = Истина;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

