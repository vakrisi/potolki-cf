&НаКлиенте
Процедура ТоварыЕдиницаИзмеренияПриИзменении(Элемент)
	
	//СтрокаТабличнойЧасти = Элементы.Товары.ТекущиеДанные;
	//Если ТипЗнч(СтрокаТабличнойЧасти.ЕдиницаИзмерения) = Тип("СправочникСсылка.КлассификаторЕдиницИзмерения") Тогда
	//	СтрокаТабличнойЧасти.Коэффициент = 1;
	//Иначе
	//	СтрокаТабличнойЧасти.Коэффициент = ОбщийМодуль.ПолучитьКоэффициентЕдиницыИзмерения(СтрокаТабличнойЧасти.ЕдиницаИзмерения);
	//КонецЕсли; 
	
	СтрокаТабличнойЧасти = Элементы.Товары.ТекущиеДанные;
	Если СтрокаТабличнойЧасти = Неопределено Тогда 
		Возврат 
	КонецЕсли;
	
	СтруктураДанные = СтруктураДанныхПоСтрокеТабличнойЧасти(СтрокаТабличнойЧасти);
	СтруктураДанные = ПолучитьДанныеНоменклатурыПриИзменении(СтруктураДанные);
	
	ЗаполнитьЗначенияСвойств(СтрокаТабличнойЧасти, СтруктураДанные, "Коэффициент, Количество"); 
	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыНоменклатураПриИзменении(Элемент)
	
	СтрокаТабличнойЧасти = Элементы.Товары.ТекущиеДанные;
	Если СтрокаТабличнойЧасти = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	//СтрокаТабличнойЧасти.ЕдиницаИзмерения = ПолучитьБазовуюЕдиницуИзмеренияНоменклатуры(СтрокаТабличнойЧасти.Номенклатура);
	//СтрокаТабличнойЧасти.Коэффициент = 1;
	ОбработкаТабличныхЧастейКлиентСервер.ЗаполнитьКоэффициентЕдиницуИзмерения(СтрокаТабличнойЧасти);
	ОбработкаТабличныхЧастейКлиентСервер.ЗаполнитьКоличествоПоПризнакуПотолка(СтрокаТабличнойЧасти); // #7380 
	
	//nva+++
	СтруктураДанные = СтруктураДанныхПоСтрокеТабличнойЧасти(СтрокаТабличнойЧасти);
	СтруктураДанные = ПолучитьДанныеНоменклатурыПриИзменении(СтруктураДанные);
	
	ЗаполнитьЗначенияСвойств(СтрокаТабличнойЧасти, СтруктураДанные, "Количество");
	
	СтрокаТабличнойЧасти.ЯчейкаОтправитель = ПолучитьЯчейку(СтрокаТабличнойЧасти.Номенклатура, Объект.СкладОтправитель);
	СтрокаТабличнойЧасти.ЯчейкаПолучатель = ПолучитьЯчейку(СтрокаТабличнойЧасти.Номенклатура, Объект.СкладПолучатель);
	//nva---
	
	ЗаполнитьОстаткиПоТоварам(); // №11476
	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыЕдиницаИзмеренияНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	СтрокаТабличнойЧасти = Элементы.Товары.ТекущиеДанные;
	СписокЕдиниц = ОбщийМодуль.ПолучитьСписокЕдиницИзмеренияНоменклатуры(СтрокаТабличнойЧасти.Номенклатура);
	
	ДанныеВыбора = Новый СписокЗначений;
	Для Ном = 0 По СписокЕдиниц.Количество() - 1 Цикл
		ДанныеВыбора.Добавить(СписокЕдиниц[Ном]);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыЕдиницаИзмеренияОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	СтрокаТабличнойЧасти = Элементы.Товары.ТекущиеДанные;
	Если ТипЗнч(ВыбранноеЗначение) = Тип("СправочникСсылка.КлассификаторЕдиницИзмерения") Тогда
		СтрокаТабличнойЧасти.Коэффициент = 1;
	Иначе
		СтрокаТабличнойЧасти.Коэффициент = ОбщийМодуль.ПолучитьКоэффициентЕдиницыИзмерения(ВыбранноеЗначение);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьСписокВидовНоменклатурыТовары()
	
	Возврат Справочники.Номенклатура.ПолучитьСписокВидовНоменклатурыТовары();
	
КонецФункции

&НаКлиенте
Процедура ПодобратьТовары(Команда)
	
	ПараметрыПодбора = Новый Структура;
	ПараметрыПодбора.Вставить("Дата",					Объект.Дата);
	ПараметрыПодбора.Вставить("Организация",			Объект.Организация);
	ПараметрыПодбора.Вставить("Склад",					Объект.СкладОтправитель);
	ПараметрыПодбора.Вставить("ВидНоменклатуры",		ПолучитьСписокВидовНоменклатурыТовары());
	
	//nva+++
	Если ИспользоватьКонтрольКратности Тогда
		ПараметрыПодбора.Вставить("ВидДокументаПроверкиКратности",ПредопределенноеЗначение("Перечисление.ВидыДокументовПроверкиКратности.ПеремещениеТоваров")); //#2792
	КонецЕсли;
	//nva---
	
	ОткрытьФорму("ОбщаяФорма.ФормаПодбораНоменклатуры", ПараметрыПодбора, ЭтаФорма, УникальныйИдентификатор);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбораПодборНаКлиенте(ВыбранноеЗначение)
	
	Если Не ЗначениеЗаполнено(ВыбранноеЗначение) Тогда
		Возврат;
	КонецЕсли;
			
	ОбработкаВыбораПодборНаСервере(ВыбранноеЗначение);
		
КонецПроцедуры

&НаСервере
Функция ОбработкаВыбораПодборНаСервере(ВыбранноеЗначение)
	
	ТаблицаТоваров = ПолучитьИзВременногоХранилища(ВыбранноеЗначение.АдресВХранилище);
	
	Для Каждого ТекущаяСтрока из ТаблицаТоваров Цикл
		НоваяСтрока = Объект.Товары.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущаяСтрока);
		НоваяСтрока.ЯчейкаОтправитель = ПолучитьЯчейку(НоваяСтрока.Номенклатура, Объект.СкладОтправитель);
		НоваяСтрока.ЯчейкаПолучатель = ПолучитьЯчейку(НоваяСтрока.Номенклатура, Объект.СкладПолучатель);
	КонецЦикла;
	
	ЗаполнитьОстаткиПоТоварам(); // №11476
	
КонецФункции

&НаСервере
Процедура ЗаполнитьПоОстаткамНаСервере()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТоварыНаСкладахОстатки.Номенклатура,
	|	ТоварыНаСкладахОстатки.ХарактеристикаНоменклатуры,
	|	ТоварыНаСкладахОстатки.СерияНоменклатуры,
	|	ТоварыНаСкладахОстатки.КоличествоОстаток КАК Количество,
	|	ТоварыНаСкладахОстатки.Номенклатура.БазоваяЕдиницаИзмерения КАК ЕдиницаИзмерения
	|ИЗ
	|	РегистрНакопления.ТоварыНаСкладах.Остатки(, Склад = &Склад) КАК ТоварыНаСкладахОстатки";
	
	Запрос.УстановитьПараметр("Склад", Объект.СкладОтправитель); 
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда 
		Сообщить("Нет остатков на складе");
		Возврат;
	КонецЕсли;
	
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = Объект.Товары.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		НоваяСтрока.Коэффициент = 1;
	КонецЦикла;
	
	ЗаполнитьОстаткиПоТоварам(); // №11476
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПоОстаткам(Команда)
	
	Если объект.СкладОтправитель.Пустая() Тогда 
		ПоказатьПредупреждение(,"Не выбран склад Отправитель");
		Возврат;
	КонецЕсли;
	
	Если Объект.Товары.Количество() > 0 Тогда 
		ОП = Новый ОписаниеОповещения ("ДействиеПослеОтветаНаЗапросОбОчисткеТаблицыТовары", ЭтотОбъект, "ПоОстатку");
		ПоказатьВопрос(ОП,"Таблица товаров непустая и будет очищена.
				|Продолжить?",РежимДиалогаВопрос.ОКОтмена);
	Иначе
		ЗаполнитьПоОстаткамНаСервере();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДействиеПослеОтветаНаЗапросОбОчисткеТаблицыТовары(Результат, Допы) Экспорт
	
	Если Результат = КодВозвратаДиалога.ОК Тогда 
		Объект.Товары.Очистить();
		Если Допы = "ПоОстатку" Тогда 
			ЗаполнитьПоОстаткамНаСервере();
		ИначеЕсли Допы = "ВидНоменклатуры" Тогда 
			ПоказатьОкноВыбораОкнаВидаНоменклатуры();
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПоВидуНоменклатуры(Команда)	
	
	Если Объект.СкладОтправитель.Пустая() Тогда 
		ПоказатьПредупреждение(,"Не выбран склад Отправитель");
		Возврат;
	КонецЕсли;
	
	Если Объект.Товары.Количество() > 0 Тогда 
		ОП = Новый ОписаниеОповещения ("ДействиеПослеОтветаНаЗапросОбОчисткеТаблицыТовары", ЭтотОбъект, "ВидНоменклатуры");
		ПоказатьВопрос(ОП,"Таблица товаров непустая и будет очищена.
				|Продолжить?",РежимДиалогаВопрос.ОКОтмена);
	Иначе	
		ПоказатьОкноВыбораОкнаВидаНоменклатуры();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьОкноВыбораОкнаВидаНоменклатуры()
	
	ВидНоменклатуры = ЗначениеСправочникаВидовНоменклатуры();
	ПоказатьВводЗначения(новый ОписаниеОповещения("ПослеВыбораВидаНоменклатуры",ЭтаФорма),ВидНоменклатуры);

КонецПроцедуры

