&НаСервереБезКонтекста
Функция ПолучитьМассивЗаказовНаПроизводствоПоНомеруРасчета(Номенклатура)
	
	Если НЕ (Справочники.ВидыНоменклатуры.ЭтоНоменклатураУникальногоПотолкаИлиОтреза(Номенклатура)
			Или Справочники.ВидыНоменклатуры.ЭтоНоменклатураПродукция(Номенклатура)) Тогда
		Возврат новый Массив;
	КонецЕсли;
		
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЗаказНаПроизводство.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ЗаказНаПроизводство КАК ЗаказНаПроизводство
	|ГДЕ
	|	ЗаказНаПроизводство.ПродукцияНомерРасчета = &НомерРасчета
	|";
	Запрос.УстановитьПараметр("НомерРасчета", Номенклатура.Потолок_НомерРасчета);
	
	МассивДанных = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат МассивДанных;
	
КонецФункции

