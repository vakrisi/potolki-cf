&НаСервереБезКонтекста
Функция ПолучитьДанныеНоменклатурыПриИзменении(СтруктураДанные)
	
	ОбщиеДанныеНоменклатуры = Новый Структура;
	ОбщегоНазначенияКлиентСервер.ДополнитьСтруктуру(ОбщиеДанныеНоменклатуры, СтруктураДанные);
	ОбщиеДанныеНоменклатуры = ОбщийМодульВызовСервера.ПолучитьДанныеНоменклатурыПриИзменении(ОбщиеДанныеНоменклатуры);
	
	СтруктураДанные.Вставить("СтатьяДоходов",  ОбщиеДанныеНоменклатуры.СтатьяДоходов);
	СтруктураДанные.Вставить("СтатьяРасходов", ОбщиеДанныеНоменклатуры.СтатьяРасходов);
	
	СтруктураДанные.Вставить("Цена", 0);
	
	Если ТипЗнч(СтруктураДанные.ЕдиницаИзмерения) = Тип("СправочникСсылка.КлассификаторЕдиницИзмерения") Тогда
		СтруктураДанные.Вставить("Коэффициент", 1);
	Иначе
		СтруктураДанные.Вставить("Коэффициент", ОбщийМодуль.ПолучитьКоэффициентЕдиницыИзмерения(СтруктураДанные.ЕдиницаИзмерения));
	КонецЕсли;
		
	Если СтруктураДанные.ИспользоватьКонтрольКратности 
		И НЕ ОбщийМодульСервер.НастройкаПользователя("РазрешитьНесоответствиеКратностиЕдиницИзмерения") Тогда
		
		СтруктураПоиска = Новый Структура("ВидДокумента, ЕдиницаИзмерения", Перечисления.ВидыДокументовПроверкиКратности.РеализацияТоваровИУслуг, СтруктураДанные.ЕдиницаИзмерения);
		НайденныеСтроки = СтруктураДанные.Номенклатура.Кратность.НайтиСтроки(СтруктураПоиска);
		Если НайденныеСтроки.Количество() > 0 Тогда		
			СтруктураДанные.Вставить("Количество", 0); //#2792
		Иначе
			СтруктураДанные.Вставить("Количество", СтруктураДанные.Количество);
		КонецЕсли;
	Иначе
		СтруктураДанные.Вставить("Количество", СтруктураДанные.Количество);
	КонецЕсли;
	
	Возврат СтруктураДанные;
	
КонецФункции

&НаКлиенте
Процедура РегистрацияИзменений(Команда)
	Если Объект.Ссылка = Неопределено Тогда
		Объект.Ссылка = ЭтаФорма.Ссылка;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Сообщ = Новый СообщениеПользователю;
		Сообщ.Текст = "Объект не записан, сначала запишите объект, а потом повторите текущее действие.";
		НСтр("RU = 'Объект не записан, сначала запишите объект, а потом повторите текущее действие'; de = 'Das Objekt wird nicht aufgezeichnet, das Objekt zuerst speichern und dann die aktuelle Aktion wiederholen'");
		Сообщ.Сообщить();
		Возврат;
	КонецЕсли;
		
	ФормаОтчета = ПолучитьФорму("Отчет.Лен_ХронологияИзмененияРеквизитовУправл.Форма.ФормаОтчета1");	
	Отчет1 = ФормаОтчета.Отчет;	
	Отчет1.АнализируемыйОбъект = Объект.Ссылка;	
	Отчет1.АтоматическийРежим = Истина;	
	ФормаОтчета.Открыть();     
	
	//Никифоров
	ФормаОтчета.СформироватьОтчетИзОбъекта(ФормаОтчета.Результат, ФормаОтчета.ДанныеРасшифровки);
КонецПроцедуры

&НаКлиенте
Процедура СкладПолучательПриИзменении(Элемент)
	Для Каждого ТекущаяСтрока Из Объект.Товары Цикл
		ТекущаяСтрока.ЯчейкаПолучатель = ПолучитьЯчейку(ТекущаяСтрока.Номенклатура, Объект.СкладПолучатель);	
	КонецЦикла;
КонецПроцедуры
