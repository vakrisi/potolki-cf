#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Ключ.Пустая() Тогда
		//#16858
		ДобавитьЗаписьВИсторию("Создано новое перемещение");
	Иначе
		//#16858
		ПолучитьЗаписиИсторииМонтажаИзРегистраНаСервере();
		Если НЕ ТолькоПросмотр Тогда  // могло отработать ДатыЗапретаИзменения
			ЭтаФорма.ТолькоПросмотр = ПраваПользователей.ДокументТолькоПросмотр(Объект.Ссылка);
		КонецЕсли;
	КонецЕсли;
	
	Элементы.ПодменюПечать.Доступность = ПраваПользователей.ДоступностьПечати(Объект.Ссылка);
	ПраваПользователей.УстановитьТолькоПросмотрДляРеквизитаНомер(Элементы.Номер.ТолькоПросмотр);

	УправлениеФормой();
	
	Элементы.ТоварыЗаполнитьКоличествоПоПотолкам.Видимость = ПолучитьФункциональнуюОпцию("КоличествоТоваровКСписаниюВРозницеНеСоответствуетКоличествуПроданногоТовара") 
															И ТипЗнч(Объект.Основание) = Тип("ДокументСсылка.Монтаж");
															
	// Видимость колонки Артикул
	ОбщийМодульСервер.УстановитьВидимостьКолонкиАртикулВТабличнойЧасти(ЭтаФорма);
		
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	ЗаполнитьОстаткиПоТоварам(); // №11476
	
	// оставлять в конце (после добавдения элементов формы (программно))
	Если Параметры.Ключ.Пустая() Тогда
		ПроверитьТолькоРедактированиеСтатуса(Отказ);
	КонецЕсли; 
	
	//nva+++
	ПредыдущийСтатус = Объект.ТекущийСтатус;
	
	Если НЕ Параметры.Ключ.Пустая() И Объект.ТекущийСтатус = Перечисления.СтатусыПеремещений.Отменен Тогда
		ЭтаФорма.ТолькоПросмотр = Истина;
	КонецЕсли;
	
	ИспользоватьКонтрольКратности = ПолучитьФункциональнуюОпцию("ИспользоватьКонтрольКратностиЕдиницИзмерения");
	
	Если Параметры.Ключ.Пустая() Тогда 
		Если ЗначениеЗаполнено(ПараметрыСеанса.Пользователь) Тогда
			Пользователь = ПараметрыСеанса.Пользователь;
			Если ЗначениеЗаполнено(Пользователь.ПеремещениеСкладОтправитель) Тогда
				Объект.СкладОтправитель = Пользователь.ПеремещениеСкладОтправитель;
			КонецЕсли;
			Если ЗначениеЗаполнено(Пользователь.ПеремещениеСкладПолучатель) Тогда
				Объект.СкладПолучатель = Пользователь.ПеремещениеСкладПолучатель;
			КонецЕсли;
			Если ЗначениеЗаполнено(Пользователь.ПеремещениеСтатус) Тогда
				Объект.ТекущийСтатус = Пользователь.ПеремещениеСтатус;
			КонецЕсли;
		КонецЕсли;	
	КонецЕсли;	
	//nva---
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	ДатыЗапретаИзменения.ОбъектПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	ПроверитьТолькоРедактированиеСтатуса(Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	Если ТипЗнч(Объект.Назначение) = Тип("ДокументСсылка.Монтаж") И НЕ Объект.Назначение.Пустая() Тогда
		Если Объект.ВидОперации.Пустая() Тогда
			ПоказатьПредупреждение(,"Необходимо указать вид операции");
			Отказ = Истина;
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	Если ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда		
		Отказ = НЕ ПраваПользователей.РазрешеноПриходоватьНаСклад(Объект.СкладПолучатель);
		Если Отказ Тогда
			Сообщить("У текущего пользователя нет прав для оформления прихода на склад """ + Объект.СкладПолучатель + """");
			Возврат;
		КонецЕсли;
		Если ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
			Отказ = НЕ ПраваПользователей.РазрешеноРасходоватьСоСклада(Объект.СкладОтправитель);
			Если Отказ Тогда
				Сообщить("У текущего пользователя нет прав для оформления расхода по складу""" + Объект.СкладОтправитель + """");
				Возврат;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	ЗаписатьИсториюНаФормеВРегистр();
	ПолучитьЗаписиИсторииМонтажаИзРегистраНаСервере();
	
	Элементы.ПодменюПечать.Доступность = ПраваПользователей.ДоступностьПечати(Объект.Ссылка);
	
	Если Объект.Проведен Тогда
		ЭтаФорма.ИспользоватьРежимПроведения=ИспользованиеРежимаПроведения.Неоперативный;
	КонецЕсли;	
	
	ЗаполнитьОстаткиПоТоварам(); // №11476
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	Если Объект.ВидПеремещения = ПредопределенноеЗначение("Справочник.ВидыПеремещений.ПеремещениеГотовойПродукции") Тогда
		Оповестить("ОбновитьАРМПроизводства",,"ПеремещениеТоваров");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.Назначение) И ТипЗнч(Объект.Назначение) = Тип("ДокументСсылка.Монтаж") Тогда		
		Оповестить("ОбновитьПотребностьПоМонтажу", Объект.Назначение, Объект.Ссылка);	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	
	Если ИсточникВыбора.ИмяФормы = "ОбщаяФорма.ФормаПодбораНоменклатуры" Тогда	
		ОбработкаВыбораПодборНаКлиенте(ВыбранноеЗначение);
	КонецЕсли;
	
КонецПроцедуры

