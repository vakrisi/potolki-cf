
Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка) Экспорт
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ИА_ЗаказНаПриобретение") Тогда
		ЗаказОснование = ДанныеЗаполнения.Ссылка;
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	ЕСТЬNULL(ИА_ЗаказыНаПриобретениеОстатки.СуммаОстаток, 0) КАК ОстатокЗаказа,
		               |	ЕСТЬNULL(ИА_СредстваВРезервеНаФондахОстатки.СуммаБезналОстаток, 0) КАК ОстатокРезерва,
		               |	ИА_СредстваВРезервеНаФондахОстатки.Подразделение КАК Подразделение,
		               |	ИА_СредстваВРезервеНаФондахОстатки.Фонд КАК Фонд
		               |ИЗ
		               |	Документ.ИА_ЗаказНаПриобретение КАК ИА_ЗаказНаПриобретение
		               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ИА_ЗаказыНаПриобретение.Остатки(&НаДату, ) КАК ИА_ЗаказыНаПриобретениеОстатки
		               |		ПО ИА_ЗаказНаПриобретение.Ссылка = ИА_ЗаказыНаПриобретениеОстатки.ЗП
		               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ИА_СредстваВРезервеНаФондах.Остатки(&НаДату, ) КАК ИА_СредстваВРезервеНаФондахОстатки
		               |		ПО ИА_ЗаказНаПриобретение.Ссылка = ИА_СредстваВРезервеНаФондахОстатки.ЗП
		               |ГДЕ
		               |	ИА_ЗаказНаПриобретение.Ссылка = &Ссылка";
		Запрос.УстановитьПараметр("Ссылка", ЗаказОснование);
		Запрос.УстановитьПараметр("НаДату", ?(ЗначениеЗаполнено(ЭтотОбъект.Дата),ЭтотОбъект.Дата,ТекущаяДата()));
		Выборка = Запрос.Выполнить().Выбрать();
		ВернутьНаФонды.Очистить();
		
		Пока Выборка.Следующий() Цикл
			ЭтотОбъект.Сумма = Выборка.ОстатокЗаказа;
			Если выборка.ОстатокРезерва > 0 Тогда
				Новстр = ВернутьНаФонды.Добавить();
				Новстр.Подразделение = Выборка.Подразделение;
				Новстр.Фонд = Выборка.Фонд;
				Новстр.Сумма = Выборка.ОстатокРезерва;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ИА_СредстваВРезервеНаФондах.Регистратор КАК Регистратор
	               |ИЗ
	               |	РегистрНакопления.ИА_СредстваВРезервеНаФондах КАК ИА_СредстваВРезервеНаФондах
	               |ГДЕ
	               |	ИА_СредстваВРезервеНаФондах.ЗП = &ЗП
	               |	И ИА_СредстваВРезервеНаФондах.Период > &Период";
	Запрос.УстановитьПараметр("Период", Дата);
	Запрос.УстановитьПараметр("ЗП", ЗаказОснование);
	Выборка = запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Сообщить("Невозможно закрыть заказ т.к. по нему есть операции позже даты закрытия : " + выборка.Регистратор);
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	Движения.ИА_СредстваВРезервеНаФондах.Записывать = Истина;
	Движения.ИА_СредстваВРезервеНаФондах.Очистить();
	
	Движения.ИА_СредстваНаФондах.Записывать = Истина;
	Движения.ИА_СредстваНаФондах.Очистить();
	
	Движения.ИА_ИсторияСтатусовЗВС.Записывать = Истина;
	Движения.ИА_ИсторияСтатусовЗВС.Очистить();
	
	Движения.ИА_ЗаказыНаПриобретение.Записывать = Истина;
	Движения.ИА_ЗаказыНаПриобретение.Очистить();
		
	ФППоОрганизациям = Константы.ИА_ФП_ВестиФППоОрганизациям.Получить();
	
	// Снятие резерва
    Запрос.Текст = 
        "ВЫБРАТЬ
        |	ИА_СредстваВРезервеНаФондахОстатки.СуммаБезналОстаток КАК Остаток,
        |	ИА_СредстваВРезервеНаФондахОстатки.Подразделение КАК Подразделение,
        |	ИА_СредстваВРезервеНаФондахОстатки.Фонд КАК Фонд
        |ИЗ
        |	РегистрНакопления.ИА_СредстваВРезервеНаФондах.Остатки(&НаДату, ЗП = &ЗП) КАК ИА_СредстваВРезервеНаФондахОстатки";
    
    Запрос.УстановитьПараметр("ЗП", ЗаказОснование);
    Запрос.УстановитьПараметр("НаДату", Дата -1);
    
    Выборка = Запрос.Выполнить().Выбрать();
	ИтогоСнятоРезерва = 0;
	Если Выборка.Следующий() Тогда
		ИтогоСнятоРезерва = Выборка.Остаток;
	КонецЕсли;
	
	Если ИтогоСнятоРезерва <> ВернутьНаФонды.Итог("Сумма") ТОгда
		Сообщить("Остаток зарезервированных средств под заказ не совпадает с суммой возвратов на фонды!");
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	Если ИтогоСнятоРезерва > 0 тогда
		НомерЗаказа = ИА_ФПСервер.УбратьНули(ЗаказОснование.Номер);
		
    	Движение = Движения.ИА_СредстваВРезервеНаФондах.ДобавитьРасход();
		Движение.Период = Дата;
		Если ФППоОрганизациям Тогда
			Движение.Организация = ЗаказОснование.Организация; 
		КонецЕсли;
		Движение.Подразделение = Выборка.Подразделение; 
		Движение.Фонд = Выборка.Фонд; 
		Движение.ЗП = ЗаказОснование;
		Движение.СуммаБезнал = ИтогоСнятоРезерва;			
	
	
		Для каждого стр из ВернутьНаФонды Цикл
			Движение = Движения.ИА_СредстваНаФондах.ДобавитьРасход();
			Движение.Период = Дата;
			Если ФППоОрганизациям Тогда
				Движение.Организация = ЗаказОснование.Организация; 
			КонецЕсли;
			Движение.Подразделение = Выборка.Подразделение; 
			Движение.Фонд = Выборка.Фонд; 
			Движение.СуммаБезнал =  стр.Сумма;
			Движение.Операция = Перечисления.КСУ_ОперацииПоФондам.ЗакрытиеЗаказа;
			Движение.ПояснениеТекст = "Заказ №"+ НомерЗаказа +" на фонд " + стр.Фонд;
			
			Движение = Движения.ИА_СредстваНаФондах.ДобавитьПриход();
			Движение.Период = Дата;
			Если ФППоОрганизациям Тогда
				Движение.Организация = ЗаказОснование.Организация; 
			КонецЕсли;
			Движение.Подразделение = стр.Подразделение; 
			Движение.Фонд = стр.Фонд; 
			Движение.СуммаБезнал = стр.Сумма;
			Движение.Операция = Перечисления.КСУ_ОперацииПоФондам.ЗакрытиеЗаказа;
			Движение.ПояснениеТекст = "Заказ №"+ НомерЗаказа +" с фонда " + Выборка.Фонд;
		КонецЦикла;
	КонецЕсли;

	// закрытие заказа
	Движение = Движения.ИА_ЗаказыНаПриобретение.ДобавитьРасход();
	Движение.Период = Дата;
	Движение.Организация = ЗаказОснование.Организация; 
	Движение.ЗП = ЗаказОснование;
	Движение.Сумма = Сумма;
	
	// статус
	Запрос.Текст = 
        "ВЫБРАТЬ
        |	Резервы.СуммаБезналПриход КАК Одобрено,
        |	Резервы.СуммаБезналРасход КАК Выплачено,
        |	Резервы.ЗП.Сумма КАК СуммаЗаказа
        |ИЗ
        |	РегистрНакопления.ИА_СредстваВРезервеНаФондах.Обороты(, &НаДату, , ЗП = &ЗП) КАК Резервы";
	Выборка = Запрос.Выполнить().Выбрать();
	
	НовыйСтатус = Перечисления.ИА_СостояниеЗаказа.Закрыт;
	
	текстСтатуса =  "Закрыт без выплат";
	Если Выборка.Следующий() и Выборка.Выплачено > 0 Тогда
		Если Выборка.Одобрено >= Выборка.СуммаЗаказа Тогда  // полностью одобрен
			НовыйСтатус = Перечисления.ИА_СостояниеЗаказа.ОдобренПолностью_Закрыт;
			текстСтатуса = "Закрыт (был одобрен полностью)";
		Иначе
			НовыйСтатус = Перечисления.ИА_СостояниеЗаказа.ОдобренЧастично_Закрыт;
			текстСтатуса = "Закрыт (был одобрен частично)";
		КонецЕсли;
	КонецЕсли;
	дв = Движения.ИА_ИсторияСтатусовЗВС.Добавить();
	дв.Период = Дата;
	дв.ЗВС = ЗаказОснование;
	дв.Статус = НовыйСтатус;
	
	ЗаписьЛенты = РегистрыСведений.КСУ_ЛентаСобытий.СоздатьМенеджерЗаписи();
	ЗаписьЛенты.ПериодСобытия = Дата;
	ЗаписьЛенты.ДатаСобытия = ТекущаяДата();
	ЗаписьЛенты.Объект = ЗаказОснование;
	ЗаписьЛенты.Событие = текстСтатуса;
	Если ВернутьНаФонды.Количество()>0 Тогда
		ЗаписьЛенты.Событие  = ЗаписьЛенты.Событие + ". Возвращено зарезервированных средств: "+ формат(ВернутьНаФонды.итог("Сумма"),"ЧДЦ=2; ЧН=");
	КонецЕсли;
	ЗаписьЛенты.Событие  = ЗаписьЛенты.Событие + ". Закрытие заказа №" + Номер;
	ЗаписьЛенты.Детали = НовыйСтатус;
	ЗаписьЛенты.Ответственный = Ответственный;
	
	ЗаписьЛенты.Записать();
	
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	Движение = РегистрыСведений.КСУ_ЛентаСобытий.СоздатьМенеджерЗаписи();
	Движение.ПериодСобытия = Дата;
	Движение.ДатаСобытия = ТекущаяДата();
	Движение.Объект = ЗаказОснование;		
	Движение.Событие = "Отмена проведения Закрытия заказа №"+Номер;
	Движение.Ответственный = ПараметрыСеанса.ТекущийПользователь;
	Движение.Записать();
КонецПроцедуры
