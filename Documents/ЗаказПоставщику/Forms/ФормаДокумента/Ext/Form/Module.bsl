&НаКлиентеНаСервереБезКонтекста
Процедура РассчитатьИтоговыеПоказатели(ТаблицаТоваров, ИтогСумма, ИтогСуммаНДС, ИтогВес)
                                                                                
	ИтогСумма = 0;
	ИтогСуммаНДС = 0;
	ИтогВес = 0;

	Для каждого СтрокаТабличнойЧасти из ТаблицаТоваров Цикл
		ИтогСумма = ИтогСумма + СтрокаТабличнойЧасти.Сумма;
		ИтогСуммаНДС = ИтогСуммаНДС + СтрокаТабличнойЧасти.СуммаНДС; 
		ИтогВес = ИтогВес + СтрокаТабличнойЧасти.Вес;
	КонецЦикла;
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура РассчитатьИтоговыйВес(ТаблицаТоваров, ИтогВес)
                                                                                
	ИтогВес = 0;

	Для каждого СтрокаТабличнойЧасти из ТаблицаТоваров Цикл
		Если ТипЗнч(СтрокаТабличнойЧасти.ЕдиницаИзмерения) = Тип("СправочникСсылка.ЕдиницыИзмерений") Тогда
			СтрокаТабличнойЧасти.Вес = СтрокаТабличнойЧасти.ЕдиницаИзмерения.Вес * СтрокаТабличнойЧасти.Количество;
		Иначе
			СтрокаТабличнойЧасти.Вес = 0;
		КонецЕсли;	
		ИтогВес = ИтогВес + СтрокаТабличнойЧасти.Вес;
	КонецЦикла;
	
КонецПроцедуры

