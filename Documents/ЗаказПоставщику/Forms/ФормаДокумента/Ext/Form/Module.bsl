	ФинансыСервер.ОбновитьВидимостьИКурсВалюты(ЭтотОбъект);
КонецПроцедуры

&НаКлиенте
Процедура КонтрагентПриИзменении(Элемент)
	КонтрагентПриИзмененииНаСервере();
КонецПроцедуры

&НаСервере
Процедура КонтрагентПриИзмененииНаСервере()
	//Элементы.КонтрагентДополнительно.Видимость = Объект.Контрагент.ПоказыватьДопИнформацию;
	ОбщийМодульСервер.ДополнительнаяИнформацияПоКонтрагентуНаФорме(Объект.Контрагент, Элементы.ПоказатьДополнительнуюИнформацию);
	ОбщийМодульСервер.РегулировкаШириныПоляКонтрагента(Элементы, Элементы.Контрагент, Элементы.ПоказатьДополнительнуюИнформацию);
	
	Объект.ДоговорКонтрагента = Объект.Контрагент.ОсновнойДоговор;
	ДоговорКонтрагентаПриИзмененииНаСервере();
	
	//nva+++
	Если ЗначениеЗаполнено(Объект.Контрагент.СпособДоставкиТовара) Тогда 
		Объект.СпособДоставкиТовара = Объект.Контрагент.СпособДоставкиТовара;
	Иначе
		Объект.СпособДоставкиТовара = "";	
	КонецЕсли;
	//nva+++
КонецПроцедуры

&НаКлиенте
Процедура ДоговорКонтрагентаПриИзменении(Элемент)
	ДоговорКонтрагентаПриИзмененииНаСервере();	
КонецПроцедуры

&НаСервере
Процедура ДоговорКонтрагентаПриИзмененииНаСервере()
	Объект.ВидЦеныПоставщика = Объект.ДоговорКонтрагента.ВидЦеныПоставщика;
	ЗаполнитьЦеныПредыдущегоПоступления();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Подключаемый_ВыполнитьИсходящийЗвонок(Команда)
	СофтфонКлиент.ВыполнитьИсходящийЗвонок(Команда, ЭтаФорма, Объект);
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ВыполнитьКомандуОтправитьСообщениеМессенджер(Команда)
	МессенджерыКлиент.ВыполнитьКомандуОтправитьСообщениеМессенджер(Команда, ЭтаФорма, Объект);
КонецПроцедуры

&НаКлиенте
Процедура ПодобратьТовары(Команда)
	
	Если НЕ ЗначениеЗаполнено(Объект.Контрагент) Тогда
		Сообщение = Новый СообщениеПользователю();
		Сообщение.Текст = "Не заполнено значение Контрагента";
		Сообщение.Поле = "Объект.Контрагент";
		Сообщение.УстановитьДанные(ЭтотОбъект);
		Сообщение.Сообщить();
		Возврат;
	КонецЕсли;			
				
	ПараметрыПодбора = Новый Структура;
	ПараметрыПодбора.Вставить("Дата",					Объект.Дата);
	ПараметрыПодбора.Вставить("Организация",			Объект.Организация);
	ПараметрыПодбора.Вставить("ИспользоватьЦеныПоставщиков", Истина);
	ПараметрыПодбора.Вставить("ВидЦеныПоставщика", Объект.ВидЦеныПоставщика);
	ПараметрыПодбора.Вставить("Поставщик", Объект.Контрагент);
	ПараметрыПодбора.Вставить("ВидНоменклатуры",		ПолучитьСписокВидовНоменклатурыТовары());
	
	//nva+++
	Если ИспользоватьКонтрольКратности Тогда
		ПараметрыПодбора.Вставить("ВидДокументаПроверкиКратности",ПредопределенноеЗначение("Перечисление.ВидыДокументовПроверкиКратности.ЗаказПоставщику")); //#2792
	КонецЕсли;
	//nva---
	
	ОткрытьФорму("ОбщаяФорма.ФормаПодбораНоменклатуры", ПараметрыПодбора, ЭтаФорма, УникальныйИдентификатор);

КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбораПодборНаКлиенте(ВыбранноеЗначение)
	
	Если Не ЗначениеЗаполнено(ВыбранноеЗначение) Тогда
		Возврат;
	КонецЕсли;
			
	ОбработкаВыбораПодборНаСервере(ВыбранноеЗначение);
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаВыбораПодборНаСервере(ВыбранноеЗначение)
		
	ТаблицаТоваров = ПолучитьИзВременногоХранилища(ВыбранноеЗначение.АдресВХранилище);
	Для Каждого ТекущаяСтрока из ТаблицаТоваров Цикл
		НоваяСтрока = Объект.Товары.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущаяСтрока);
		НоваяСтрока.СтавкаНДС = СтавкаНДСПоУмолчанию;
		НоваяСтрока.Ячейка = ОбщийМодульДокументы.ПолучитьЯчейку(НоваяСтрока.Номенклатура, Объект.Склад);
		Если ТипЗнч(НоваяСтрока.ЕдиницаИзмерения) = Тип("СправочникСсылка.ЕдиницыИзмерений") Тогда
			НоваяСтрока.Вес = НоваяСтрока.ЕдиницаИзмерения.Вес * НоваяСтрока.Количество;
		Иначе
			НоваяСтрока.Вес = 0;
		КонецЕсли;	
		ОбработкаТабличныхЧастейСервер.ПересчитатьСуммуСУчетомСкидокВСтрокеТЧ(НоваяСтрока, Ложь, Ложь, Ложь);
		ОбработкаТабличныхЧастейСервер.ПересчитатьСуммуНДСВСтрокеТЧ(НоваяСтрока, УчитыватьНДС);
	КонецЦикла;
	ЗаполнитьЦеныПредыдущегоПоступления();
	РассчитатьИтоговыеПоказателиСервер();
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьЦеныПоставщика(Команда)
			
	Если НЕ ЗначениеЗаполнено(Объект.ВидЦеныПоставщика) Тогда
		ТекстОшибки = "Не указан вид цены поставщика!";
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки, , "Объект.ВидЦеныПоставщика");
		Возврат;
	КонецЕсли;
	
	Если ПроверитьЗаполнение() Тогда 	
		Если Объект.Товары.Количество() = 0 Тогда
			Сообщить ("Таблица товаров пустая");
		Иначе
			ОП = Новый ОписаниеОповещения ("ЗаполнитьЦеныПоставщикаНаКлиенте",ЭтаФорма);
			ПоказатьВопрос(ОП, "Для каждой строки будут установлены цены поставщика, 
			|если они зарегистрированы в базе.
			|Продолжить?", РежимДиалогаВопрос.ОКОтмена,,,"Загрузить цены?");
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьЦеныПоставщикаНаКлиенте(Результат, ДопПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.ОК Тогда 
		ЗаполнитьЦеныПоставщикаНаСервере();
	КонецЕсли; 	
		
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьЦеныПоставщикаНаСервере()
	
	ОбработкаТабличныхЧастейСервер.ЗаполнитьЦеныПоставщика(ЭтотОбъект, "Товары");	
	РассчитатьИтоговыеПоказателиСервер();
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьЦеныПоПредыдущимЗакупкам(Команда)
	
	Если ПроверитьЗаполнение() Тогда
		Если Объект.Товары.Количество() = 0 Тогда
			Сообщить ("Таблица товаров пустая");
		Иначе	
