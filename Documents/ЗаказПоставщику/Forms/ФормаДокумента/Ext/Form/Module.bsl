//ФУНКЦИИ РАБОТЫ С ТАБЛИЦОЙ ФАЙЛЫ
&НаСервере
Процедура ОбновитьСписокФайлов()
	
	Файлы.Очистить();
	
	МассивСсылок = Новый Массив;
	//номенклатуры
	Для Каждого СтрокаНоменклатура Из Объект.Товары Цикл
		МассивСсылок.Добавить(СтрокаНоменклатура.Номенклатура);
	КонецЦикла;
	//документ
	МассивСсылок.Добавить(Объект.Ссылка);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ПрикрепленныеДанные.СсылкаНаОбъект КАК Номенклатура,
	|	ПрикрепленныеДанные.ИмяФайла,
	|	ПрикрепленныеДанные.Расширение,
	|	ПрикрепленныеДанные.ИмяФайла + ""."" + ПрикрепленныеДанные.Расширение КАК НаименованиеФайла,
	|	ПрикрепленныеДанные.Период КАК ДатаПрикрепления
	|ИЗ
	|	РегистрСведений.ПрикрепленныеДанные КАК ПрикрепленныеДанные
	|ГДЕ
	|	ПрикрепленныеДанные.СсылкаНаОбъект В (&МассивСсылок)";
	Запрос.УстановитьПараметр("МассивСсылок", МассивСсылок);	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = Файлы.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
	КонецЦикла;
	
	Если Файлы.Количество() > 0 Тогда
		Элементы.ТаблицаФайлы.Заголовок = "Файлы (" + Файлы.Количество() + ")";
	Иначе
		Элементы.ТаблицаФайлы.Заголовок = "Файлы";
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьДанные(СсылкаНаОбъект, ИмяФайла)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ПрикрепленныеДанные.Данные
	|ИЗ
	|	РегистрСведений.ПрикрепленныеДанные КАК ПрикрепленныеДанные
	|ГДЕ
	|	ПрикрепленныеДанные.СсылкаНаОбъект = &Ссылка
	|	И ПрикрепленныеДанные.ИмяФайла = &ИмяФайла";
	Запрос.УстановитьПараметр("Ссылка",СсылкаНаОбъект);
	Запрос.УстановитьПараметр("ИмяФайла",ИмяФайла);
	
	
	Данные = Неопределено;
	Выборка = Запрос.Выполнить().Выгрузить();
	Если Выборка.Количество() > 0 тогда
		Данные = Выборка[0].Данные.Получить();
	КонецЕсли;
	 
	Возврат ПоместитьВоВременноеХранилище(Данные, ЭтаФорма.УникальныйИдентификатор);
	
КонецФункции

&НаКлиенте
Функция ПолучитьИмяВременногоФайлаСерв(Расширение)
	Возврат ПолучитьИмяВременногоФайла(Расширение);
КонецФункции

&НаКлиенте
Процедура ФайлыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Если Элементы.Файлы.ТекущиеДанные.Номенклатура.Пустая() Тогда
		АдресФайла = ПолучитьДанные(Объект.Ссылка, Элементы.Файлы.ТекущиеДанные.ИмяФайла);
	Иначе
		АдресФайла = ПолучитьДанные(Элементы.Файлы.ТекущиеДанные.Номенклатура, Элементы.Файлы.ТекущиеДанные.ИмяФайла);
	КонецЕсли;
	ВременноеИмя=ПолучитьИмяВременногоФайлаСерв(Элементы.Файлы.ТекущиеДанные.Расширение);
    ПолучитьФайл(АдресФайла, ВременноеИмя, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьФайл(Команда)
	
	СписокПотолков = ПолучитьСписокПотолков();
	Если НЕ СписокПотолков.Количество() = 0 Тогда
		Оп = Новый ОписаниеОповещения("ВыборПотолкаДляПрикрепленияФайла", ЭтаФорма);
		ПоказатьВыборИзМеню(Оп, СписокПотолков, Элементы.ФайлыДобавитьФайл);
	Иначе
		ПоказатьПредупреждение(,"В товарах и материалах нет потолков и отрезов");
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьСписокПотолков()
	
	СписокНоменклатуры = Новый СписокЗначений;
	Для Каждого СтрокаНоменклатура Из Объект.Товары Цикл
		Если Справочники.ВидыНоменклатуры.ЭтоНоменклатураПотолкаИлиОтреза(СтрокаНоменклатура.Номенклатура) Тогда
			СписокНоменклатуры.Добавить(СтрокаНоменклатура.Номенклатура);
		КонецЕсли;
	КонецЦикла;
	
	Возврат СписокНоменклатуры;
	
КонецФункции

&НаКлиенте
Процедура ВыборПотолкаДляПрикрепленияФайла(ВыбранныйЭлемент, ДополнительныеПараметры) Экспорт 
	
	Если ВыбранныйЭлемент = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ОписаниеОповещения = Новый ОписаниеОповещения("ПослеПрикрепленияФайлаЗавершение", ЭтотОбъект);
	ДопПараметры = Новый Структура("ДействиеПослеПрикрепления", ОписаниеОповещения);
	ОбщийМодульКлиент.ПослеВыбораСсылкиДляПрикрепленияФайла(ВыбранныйЭлемент.Значение, ДопПараметры);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеПрикрепленияФайлаЗавершение(СтруктураРезультата, ДополнительныеПараметры) Экспорт
	
	Если СтруктураРезультата.Результат Тогда
		ОбновитьСписокФайлов();
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ПечататьФайл(Команда)
	
	ВыбранныеЭлементы = Элементы.Файлы.ВыделенныеСтроки;
	
	Если ВыбранныеЭлементы.Количество() > 0 Тогда
		Для каждого ЭлементДляПечати из ВыбранныеЭлементы Цикл
			СтрФайл = Файлы.НайтиПоИдентификатору(ЭлементДляПечати);
			Если СтрФайл.Номенклатура.Пустая() Тогда
				АдресФайла = ПолучитьДанные(Объект.Ссылка, СтрФайл.ИмяФайла);
			Иначе
				АдресФайла = ПолучитьДанные(СтрФайл.Номенклатура, СтрФайл.ИмяФайла);
			КонецЕсли;
			
			ВременноеИмя = ПолучитьИмяВременногоФайла(СтрФайл.Расширение);
			ПолучитьФайл(АдресФайла, ВременноеИмя, Ложь);
			
			Shell = Новый COMОбъект("Shell.Application");
			Shell.ShellExecute(ВременноеИмя, "", "", "print", 0);
		КонецЦикла;
	Иначе
		ПоказатьПредупреждение(,"Выберите файл(ы) в списке");
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ОбработкаОповещенияНаСервере(Параметр)
	
	Для Каждого ТекущаяСтрока Из Объект.Товары Цикл
		Если ТекущаяСтрока.Номенклатура = Параметр.Номенклатура Тогда
			ТекущаяСтрока.Количество = Параметр.НоваяПлощадьПотолка;
			//ТекущаяСтрока.Сумма = ТекущаяСтрока.Количество * ТекущаяСтрока.Цена;
			ОбработкаТабличныхЧастейСервер.ПересчитатьСуммуСУчетомСкидокВСтрокеТЧ(ТекущаяСтрока, Ложь, Ложь, Ложь);
			ОбработкаТабличныхЧастейСервер.ПересчитатьСуммуНДСВСтрокеТЧ(ТекущаяСтрока, УчитыватьНДС);
		КонецЕсли;
	КонецЦикла;
	
	Модифицированность = Истина;
	
	ОбновитьДанныеДокумента();
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьФайлКЗаказу(Команда)
	
	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
		ПоказатьПредупреждение(, "Заказ предварительно должен быть записан");
		Возврат;
	КонецЕсли;
		
	ОписаниеОповещения = Новый ОписаниеОповещения("ПослеПрикрепленияФайлаЗавершение", ЭтотОбъект);
	ДопПараметры = Новый Структура("ДействиеПослеПрикрепления", ОписаниеОповещения);
	ОбщийМодульКлиент.ПослеВыбораСсылкиДляПрикрепленияФайла(Объект.Ссылка, ДопПараметры);
	
КонецПроцедуры

&НаКлиенте
Процедура ФайлыПриАктивизацииСтроки(Элемент)
	
	Если НЕ ВключитьПредпросмотрФайлов ИЛИ Элементы.Файлы.ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если мПредыдущийИдентификатор = Элементы.Файлы.ТекущиеДанные.ПолучитьИдентификатор() Тогда
		Возврат;
	Иначе
		мПредыдущийИдентификатор = Элементы.Файлы.ТекущиеДанные.ПолучитьИдентификатор();
	КонецЕсли;
	
	ПодключитьОбработчикОжидания("ОбработчикОжиданияФайлыПриАктивизацииСтроки", 0.1, Истина);
КонецПроцедуры

&НаКлиенте
Процедура ОбработчикОжиданияФайлыПриАктивизацииСтроки()
	
	Если Элементы.Файлы.ТекущиеДанные.Номенклатура.Пустая() Тогда
		АдресФайла = ПолучитьДанные(Объект.Ссылка, Элементы.Файлы.ТекущиеДанные.ИмяФайла);
	Иначе
		АдресФайла = ПолучитьДанные(Элементы.Файлы.ТекущиеДанные.Номенклатура, Элементы.Файлы.ТекущиеДанные.ИмяФайла);
	КонецЕсли;
	
	ОбщийМодульКлиент.ПредпросмотрФайла(АдресФайла, Элементы.Файлы.ТекущиеДанные.Расширение, Предпросмотр, Элементы.Предпросмотр);	
	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыПередУдалением(Элемент, Отказ)
	
	//ТекущиеДанные = Элементы.Товары.ТекущиеДанные;
	Для Каждого ВыделеннаяСтрока Из Элементы.Товары.ВыделенныеСтроки Цикл
		ТекущиеДанные = Объект.Товары.НайтиПоИдентификатору(ВыделеннаяСтрока);
		Если ЭтоПотолокИУНегоЕстьУслугиВТЧ(ТекущиеДанные.Номенклатура) Тогда
			//Если это потолок и у него есть услуги в ТЧ, зададим вопрос об удалении их из ТЧ
			ОП = новый ОписаниеОповещения("ПослеВопросаОУдаленииУслугиПоПотолку", ЭтотОбъект, новый Структура("Потолок", ТекущиеДанные.Номенклатура));
			ПоказатьВопрос(ОП, "В табличной части услуги есть позиции, которые привязаны к данному потолоку, удалить услуги?", РежимДиалогаВопрос.ДаНет,,, "Удаление связанных услуг по потолку");		
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыПослеУдаления(Элемент)
	
	РассчитатьИтоговыеПоказателиКлиент();
	
КонецПроцедуры

&НаСервере
Функция	ЭтоПотолокИУНегоЕстьУслугиВТЧ(Номенклатура)
	
	УсловиеВыполнено = Ложь;
	
	Если Справочники.ВидыНоменклатуры.ЭтоНоменклатураПотолкаИлиОтреза(Номенклатура) Тогда
		Для Каждого СтрокаУслуга Из Объект.Товары Цикл
			Если ЭтоУслуга(СтрокаУслуга.Номенклатура) И СтрокаУслуга.Потолок = Номенклатура И НЕ СтрокаУслуга.Потолок.Пустая() Тогда
				УсловиеВыполнено = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Возврат УсловиеВыполнено;
	
КонецФункции

&НаКлиенте
Процедура ПослеВопросаОУдаленииУслугиПоПотолку(Ответ, ДопПараметры) ЭКСПОРТ
	Если Ответ = КодВозвратаДиалога.Да Тогда
		Для Каждого СтрокаУслуга Из Объект.Товары Цикл
			Если ЭтоУслуга(СтрокаУслуга.Номенклатура) И СтрокаУслуга.Потолок = ДопПараметры.Потолок И НЕ СтрокаУслуга.Потолок.Пустая() Тогда
				Объект.Товары.Удалить(СтрокаУслуга);		
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры	

&НаСервереБезКонтекста
Функция ЭтоУслуга(Номенклатура)
	 Возврат Справочники.ВидыНоменклатуры.ЭтоНоменклатураУслуга(Номенклатура);
КонецФункции

&НаКлиенте
Процедура ЗаполнитьДокументПоЗаказу(Команда)
	
	Если  НЕ ТипЗнч(Объект.Основание) = Тип("ДокументСсылка.ЗаказПокупателя") 
		И НЕ ТипЗнч(Объект.Основание) = Тип("ДокументСсылка.ЗаказДоговор") Тогда
		ПоказатьПредупреждение(,"Документ не на основании заказа покупателя или заказ-договора");
		Возврат;
	КонецЕсли;
	
	Если Объект.Ссылка.Пустая() Тогда
		ПоказатьПредупреждение(,"Документ предварительно необходимо записать");
		Возврат;
	КонецЕсли;
	
	Оповещение = Новый ОписаниеОповещения("ПослеВопросаОЗаполненииПоЗаказу", ЭтаФорма, Параметры);
	ПоказатьВопрос(Оповещение, "Документ будет очищен и перезаполнен. Продолжить?", РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВопросаОЗаполненииПоЗаказу(Результат, Параметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнитьДокументПоЗаказуПокупателяНаСервере();
	Модифицированность = Истина;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДокументПоЗаказуПокупателяНаСервере()
	
	//ДокОбъект = Объект.Ссылка.ПолучитьОбъект();
	ДокОбъект = РеквизитФормыВЗначение("Объект");
	ДокОбъект.Товары.Очистить();		
	ДокОбъект.Заполнить(Объект.Основание);
	ЗначениеВРеквизитФормы(ДокОбъект, "Объект")
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПотолокПоОснованию(Команда)
	
		СписокВариантов = ПолучитьСписокПОтолковОснования();
		
		Если СписокВариантов.Количество() = 0 Тогда
			ПоказатьПредупреждение(,"В документе-основании нет потолков");
			Возврат;
		КонецЕсли;
			
		
		Оп = Новый ОписаниеОповещения("ВыборПотолкаДляЗаполненияПоОснованию", ЭтаФорма);
		
		СписокВариантов.ПоказатьВыборЭлемента(Оп, "Выберите потолок");

	
КонецПроцедуры

&НаСервере
Функция ПолучитьСписокПОтолковОснования()
	
	СписокПотолков = Новый СписокЗначений;
	
	Если ТипЗнч(Объект.Основание) = Тип("ДокументСсылка.ЗаказПокупателя") Тогда
		Для Каждого СтрокаОснования из Объект.Основание.Товары Цикл
			Если Справочники.ВидыНоменклатуры.ЭтоНоменклатураПотолкаИлиОтреза(СтрокаОснования.Номенклатура) Тогда
				СписокПотолков.Добавить(СтрокаОснования.Номенклатура);
			КонецЕсли;
		КонецЦикла;
	ИначеЕсли ТипЗнч(Объект.Основание) = Тип("ДокументСсылка.ЗаказДоговор") Тогда
		Для Каждого СтрокаОснования из Объект.Основание.ТоварыУслуги Цикл
			Если Справочники.ВидыНоменклатуры.ЭтоНоменклатураПотолкаИлиОтреза(СтрокаОснования.Номенклатура) Тогда
				СписокПотолков.Добавить(СтрокаОснования.Номенклатура);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Возврат СписокПотолков;
	
КонецФункции

&НаКлиенте
Процедура ВыборПотолкаДляЗаполненияПоОснованию(ВыбранныйЭлемент, ДополнительныеПараметры) Экспорт
	Если НЕ ВыбранныйЭлемент = Неопределено Тогда
		ВыборПотолкаДляЗаполненияПоОснованиюНаСервере(ВыбранныйЭлемент.Значение);
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ВыборПотолкаДляЗаполненияПоОснованиюНаСервере(ВыбранныйПотолок)
	
	//удалим выбранный потолок и все что с ним связано из ТЧ
	КопияТЧ = Объект.Товары.Выгрузить();
	Объект.Товары.Очистить();
	Для Каждого СтрокаКопии Из КопияТЧ Цикл
		Если СтрокаКопии.Номенклатура = ВыбранныйПотолок ИЛИ СтрокаКопии.Потолок = ВыбранныйПотолок Тогда
			продолжить;
		Иначе
			НоваяСтрока = Объект.Товары.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаКопии);
		КонецЕсли;
	КонецЦикла;
	
	//добавим выбранный потолок и все его подчиненные строки
	Если ТипЗнч(Объект.Основание) = Тип("ДокументСсылка.ЗаказПокупателя") Тогда
		Для Каждого ТекСтрокаОснования Из Объект.Основание.Товары Цикл
			Если ТекСтрокаОснования.Номенклатура = ВыбранныйПотолок ИЛИ ТекСтрокаОснования.Потолок = ВыбранныйПотолок Тогда
				НоваяСтрока = Объект.Товары.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрокаОснования, "Номенклатура, ХарактеристикаНоменклатуры, Количество, ЕдиницаИзмерения, Коэффициент, Потолок, Комната");
			КонецЕсли;
		КонецЦикла;
	ИначеЕсли ТипЗнч(Объект.Основание) = Тип("ДокументСсылка.ЗаказДоговор") Тогда
		Для Каждого ТекСтрокаОснования Из Объект.Основание.ТоварыУслуги Цикл
			Если ТекСтрокаОснования.Номенклатура = ВыбранныйПотолок ИЛИ ТекСтрокаОснования.НомерПотолка = ВыбранныйПотолок.Потолок_НомерРасчета Тогда
				НоваяСтрока = Объект.Товары.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрокаОснования, "Номенклатура, ХарактеристикаНоменклатуры, Количество, ЕдиницаИзмерения, Коэффициент, Комната");
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	РассчитатьИтоговыеПоказателиСервер();
	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыКомнатаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	ДанныеВыбора = Новый СписокЗначений;
	ДанныеВыбора.ЗагрузитьЗначения(СписокКомнатОснования.ВыгрузитьЗначения());
КонецПроцедуры

&НаКлиенте
Процедура РаспределитьПоПотребностиЗаказДоговора(Команда)
	
	Если НЕ ТипЗнч(Объект.Основание) = Тип("ДокументСсылка.ЗаказДоговор") ИЛИ НЕ ЗначениеЗаполнено(Объект.Основание) Тогда
		ПоказатьПредупреждение(,"Документ не на основании заказ-договора");
		Возврат;
	КонецЕсли;
	
	Режим = РежимДиалогаВопрос.ДаНет;
	Оповещение = Новый ОписаниеОповещения("ПослеВопросаОРаспределенииПоОбеспечению", ЭтаФорма);
	ПоказатьВопрос(Оповещение, "Распределить по потребности заказ-договора?", Режим, 0);

КонецПроцедуры

&НаКлиенте
Процедура ПослеВопросаОРаспределенииПоОбеспечению(Результат, Параметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
        РаспределитьПоПотребностиЗаказДоговораНаСервере();
		Модифицированность = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура РаспределитьПоПотребностиЗаказДоговораНаСервере()
	
	ТоварыДокумента = Объект.Товары.Выгрузить();
	ТоварыРаспределение = ТоварыДокумента.СкопироватьКолонки();
	ТоварыДокумента.Свернуть("Номенклатура, ХарактеристикаНоменклатуры, Спецификация, ЕдиницаИзмерения, Коэффициент, Цена, Потолок", "Количество, Сумма");
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("Основание", Объект.Основание);
	СтруктураПараметров.Вставить("Ссылка", Объект.Ссылка);
	СтруктураПараметров.Вставить("УчетОбеспеченностиРозницыПоКомнатам", Объект.СозданПриИспользованииНастройкиУчетОбеспеченностиРозницыПоКомнатам);
	
	ОбработкаТабличныхЧастейСервер.РаспределитьПоПотребностиЗаказДоговора(ТоварыДокумента, ТоварыРаспределение, СтруктураПараметров); 
		
	Объект.Товары.Загрузить(ТоварыРаспределение);
	ЗаполнитьЦеныПредыдущегоПоступления();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьШтрихкод(Параметр)
	
	СтруктураТовара = ОбщийМодульКлиент.ПолучитьНоменклатуруПоШтрихКоду(МенеджерОборудованияКлиентПереопределяемый.ПреобразоватьДанныеСоСканераВМассив(Параметр));
	
	Если НЕ СтруктураТовара.Номенклатура = ПредопределенноеЗначение("Справочник.Номенклатура.ПустаяСсылка") Тогда
		
		//Попробуем найти в ТЧ
		СтруктураПоиска = новый Структура("Номенклатура, ХарактеристикаНоменклатуры, ЕдиницаИзмерения", СтруктураТовара.Номенклатура, СтруктураТовара.ХарактеристикаНоменклатуры, СтруктураТовара.ЕдиницаИзмерения);
		НайденныеСтроки = Объект.Товары.НайтиСтроки(СтруктураПоиска);
		
		Если НайденныеСтроки.Количество() = 0 Тогда
			НоваяСтрока = Объект.Товары.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтруктураТовара);
			НоваяСтрока.Количество = 1;
			Если ТипЗнч(НоваяСтрока.ЕдиницаИзмерения) = Тип("СправочникСсылка.КлассификаторЕдиницИзмерения") Тогда
				НоваяСтрока.Коэффициент = 1;
			Иначе
				НоваяСтрока.Коэффициент = ОбщийМодуль.ПолучитьКоэффициентЕдиницыИзмерения(НоваяСтрока.ЕдиницаИзмерения);
			КонецЕсли;
			НоваяСтрока.СтавкаНДС = СтавкаНДСПоУмолчанию;
		Иначе
			НоваяСтрока = НайденныеСтроки[0];
			НоваяСтрока.Количество = НоваяСтрока.Количество + 1;
		КонецЕсли;	
		
		//НоваяСтрока.Сумма = НоваяСтрока.Цена * НоваяСтрока.Количество;
		ОбработкаТабличныхЧастейКлиент.ПересчитатьСуммуСУчетомСкидокВСтрокеТЧ(НоваяСтрока, Ложь, Ложь, Ложь);
		ОбработкаТабличныхЧастейКлиент.ПересчитатьСуммуНДСВСтрокеТЧ(НоваяСтрока, УчитыватьНДС);
	Иначе
		Сообщить("Не удалось найти номенклатуру со штрих-кодом " + СтруктураТовара.ШтрихКод);
	КонецЕсли;	
	
КонецПроцедуры

&НаСервере
Функция ПолучитьЦенуПоставщика(Номенклатура, ХарактеристикаНоменклатуры, ЕдиницаИзмерения)
	
	Отбор = Новый Структура;
	Отбор.Очистить();
	Отбор.Вставить("Поставщик",			Объект.Контрагент);
	Отбор.Вставить("Валюта",			Объект.Валюта);
	Отбор.Вставить("Номенклатура", 		Номенклатура);
	Отбор.Вставить("ХарактеристикаНоменклатуры", 		ХарактеристикаНоменклатуры);
	Отбор.Вставить("ЕдиницаИзмерения", 	ЕдиницаИзмерения);
	Отбор.Вставить("ВидЦеныПоставщика", Объект.ВидЦеныПоставщика);
	Выборка = РегистрыСведений.ЦеныПоставщиков.ПолучитьПоследнее(Объект.Дата, Отбор);
	
	Возврат Выборка.Цена;
	
