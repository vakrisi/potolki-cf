	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТабТовары", ТЗТовары);
	Запрос.Текст = "ВЫБРАТЬ
	               |	Товар.Вес КАК Вес,
	               |	Товар.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	               |	Товар.ИсходныйНомерСтроки КАК ИсходныйНомерСтроки,
	               |	Товар.Количество КАК Количество,
	               |	Товар.Комната КАК Комната,
	               |	Товар.Коэффициент КАК Коэффициент,
	               |	Товар.Назначение КАК Назначение,
	               |	Товар.Номенклатура КАК Номенклатура,
	               |	Товар.НомерСтроки КАК НомерСтроки,
	               |	Товар.Потолок КАК Потолок,
	               |	Товар.Спецификация КАК Спецификация,
	               |	Товар.СтавкаНДС КАК СтавкаНДС,
	               |	Товар.Сумма КАК Сумма,
	               |	Товар.СуммаНДС КАК СуммаНДС,
	               |	Товар.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	               |	Товар.Цена КАК Цена,
	               |	Товар.ЦенаПредыдущегоПоступления КАК ЦенаПредыдущегоПоступления,
	               |	Товар.Ячейка КАК Ячейка
	               |ПОМЕСТИТЬ ВТ_ТЧ
	               |ИЗ
	               |	&ТабТовары КАК Товар
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТ_ТЧ.Вес КАК Вес,
	               |	ВТ_ТЧ.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	               |	ВТ_ТЧ.ИсходныйНомерСтроки КАК ИсходныйНомерСтроки,
	               |	ВТ_ТЧ.Количество КАК Количество,
	               |	ВТ_ТЧ.Комната КАК Комната,
	               |	ВТ_ТЧ.Коэффициент КАК Коэффициент,
	               |	ВТ_ТЧ.Назначение КАК Назначение,
	               |	ВТ_ТЧ.Номенклатура КАК Номенклатура,
	               |	ВТ_ТЧ.НомерСтроки КАК НомерСтроки,
	               |	ВТ_ТЧ.Потолок КАК Потолок,
	               |	ВТ_ТЧ.Спецификация КАК Спецификация,
	               |	ВТ_ТЧ.СтавкаНДС КАК СтавкаНДС,
	               |	ВТ_ТЧ.Сумма КАК Сумма,
	               |	ВТ_ТЧ.СуммаНДС КАК СуммаНДС,
	               |	ВТ_ТЧ.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	               |	ВТ_ТЧ.Цена КАК Цена,
	               |	ВТ_ТЧ.ЦенаПредыдущегоПоступления КАК ЦенаПредыдущегоПоступления,
	               |	ВТ_ТЧ.Ячейка КАК Ячейка,
	               |	МинимальныеОстаткиНоменклатуры.Количество КАК МинОстаток,
	               |	МинимальныеОстаткиНоменклатуры.КоличествоМаксимум КАК МаксОстаток
	               |ИЗ
	               |	ВТ_ТЧ КАК ВТ_ТЧ
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.МинимальныеОстаткиНоменклатуры КАК МинимальныеОстаткиНоменклатуры
	               |		ПО ВТ_ТЧ.Номенклатура = МинимальныеОстаткиНоменклатуры.Номенклатура
	               |			И (МинимальныеОстаткиНоменклатуры.Склад = &Склад)
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	НомерСтроки";
	
	Запрос.Параметры.Вставить("Склад",Объект.Склад);
	Результат = Запрос.Выполнить().Выгрузить();
	//Объект.Товары.Загрузить(Результат);        
	Для Каждого СтрокаТЧТовары Из Объект.Товары Цикл
		СтрокаРезультата = Результат.Найти(СтрокаТЧТовары.НомерСтроки, "НомерСтроки"); 
