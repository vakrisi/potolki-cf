
&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ОбновитьВидимостьКнопкиПроведения();
	
	Элементы.КомментарийСФП.Видимость= ЗначениеЗаполнено(КомментарийСФП);
	
	ПолучательКонтрагент = ТипЗнч(объект.Контрагент) = тип("СправочникСсылка.Контрагенты");
	ИзменениеПолучательКонтрагент();
	ВидимостьГолОрг();
КонецПроцедуры

&НаКлиенте
Процедура ИзменениеПолучательКонтрагент(Перезаполнить = ложь)
	Элементы.ДекорацияПолучательКонтрагент.Заголовок = ?(ПолучательКонтрагент, "Из справочника ""Контрагенты""", "Свободный текст");
	Если Перезаполнить Тогда
		объект.Контрагент = ?(ПолучательКонтрагент, ПредопределенноеЗначение("Справочник.Контрагенты.ПустаяСсылка"), "" );
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьВидимостьКнопкиПроведения()
	Элементы.ОтменаПроведения.Видимость = объект.Проведен и не Элементы.Статус.ТолькоПросмотр;
КонецПроцедуры


&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	СтатусыОдобрено = ИА_ФП.СтатусыОдобрено(истина);
	
	Номер = объект.Номер + ?(Объект.НомерВеб = "", "", "/"+ Объект.НомерВеб);
	ФП_по_ТБ = ИА_ФП_ПовторИсп.ФП_по_ТБ(объект.Дата);
	ИспПодразделения = Константы.КСУ_ФП_ИспользоватьПодразделения.Получить();
	
	ПоОрг = Константы.ИА_ФП_ВестиФППоОрганизациям.Получить();
	НФ_ЗП = Константы.ИА_ИспользоватьНФЗаказНаПриобретение.Получить();

	ИспользуютсяГруппыКомпаний = Справочники.ИА_ГруппыКомпаний.ПолучитьПризнакИспользованияГруппКомпаний();
	ОбязательноеУказаниеСрокаОплатыВЗВС = Константы.ИА_ФП_ОбязательноеУказаниеСрокаОплатыВЗВС.Получить();
	
	РазделятьНалБезнал = Константы.ИА_ФП_РазделятьНалИБезнал.Получить();
	ИспользоватьВидДССправочно = Константы.ИА_ФП_ИспользоватьВидДССправочно.Получить();
	
	// Картинки статусов
	Запрос = новый запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ИА_СостояниеЗаказа.Ссылка КАК Ссылка,
	               |	ИА_СостояниеЗаказа.Порядок КАК Порядок
	               |ИЗ
	               |	Перечисление.ИА_СостояниеЗаказа КАК ИА_СостояниеЗаказа";
	Выборка = запрос.Выполнить().Выбрать();
	Пока выборка.Следующий() Цикл
		КартинкиСтатусов.Добавить(Выборка.ссылка,,,БиблиотекаКартинок["КСУ_статусЗаказа"+ строка(Выборка.Порядок+1)]); 
	КонецЦикла;
	
	//ФотоСтатусУтв = ПоместитьВоВременноеХранилище(БиблиотекаКартинок.КСУ_СтатусУтверждена, УникальныйИдентификатор);
	//
	
	Параметры.Свойство("НеОповещать", НеОповещать);
	
	Если Параметры.Свойство("Основание") Тогда
		
		Основание = Параметры.Основание;
		Если ТипЗнч(Основание) = Тип("ДокументСсылка.ИА_ЗаявкаНаОбязательства") Тогда
			Объект.Основание = Основание;
			Если Параметры.Свойство("Сумма") Тогда
				Объект.Сумма = Параметры.Сумма;
			КонецЕсли;
			
			Объект.ОрганизацияДочерняя = Основание.Организация;
			Если ИспользуютсяГруппыКомпаний ТОгда
				Объект.Организация = ИА_ФП.ПолучитьГоловнуюОрганизацию(Объект.ОрганизацияДочерняя);
			КонецЕсли;
			
			Объект.Подразделение = Основание.Подразделение;
			Объект.Фонд = Основание.Фонд;
			Объект.Организация = Основание.Организация;
			
			Объект.ПредметЗаказа = Основание.ПредметЗаказа;
			Объект.Ситуация = Основание.Ситуация;
			Объект.Данные = Основание.Данные;
			Объект.Решение = Основание.Решение;
			
		КонецЕсли; 
	КонецЕсли;

	Элементы.ГруппаНФ.Видимость = ложь;
	
	Структура = ИА_ФП.ВернутьСтатусЗВС(Объект.Ссылка);
	
	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Статус = Структура.Статус;
		ПричинаОтказа = Структура.ПричинаОтказа;
	Иначе	
		
		ПарамЗнач = Неопределено;
		
		Параметры.Свойство("ЗаказКопия", ПарамЗнач);
		Если ЗначениеЗаполнено(ПарамЗнач) тогда
			ЗаполнитьЗначенияСвойств(Объект, ПарамЗнач, "Ситуация, Данные, Решение, Организация, Фонд, Подразделение, ПредметЗаказа, ВидДС, ДатаОплаты, ОрганизацияДочерняя, ВидДССправочно, Статья, Контрагент"); 
		КонецЕсли;
		
		Статус = Перечисления.ИА_СостояниеЗаказа.Черновик;
		
		Объект.Сотрудник   = ПараметрыСеанса.ТекущийПользователь;
		Объект.Дата        = ТекущаяДата();
		Если ПоОрг и Объект.Организация.Пустая() ТОгда
			Объект.Организация = ИА_НастройкиС.ЗначениеНастройкиТекПользователя(ПланыВидовХарактеристик.ИА_НастройкиПользователей.ОсновнаяОрганизация);
			Объект.ОрганизацияДочерняя = Объект.Организация;
		КонецЕсли;
		
		Параметры.Свойство("Организация", ПарамЗнач);
		Если ЗначениеЗаполнено(ПарамЗнач) тогда
			Объект.Организация = ПарамЗнач;
			Объект.ОрганизацияДочерняя = ПарамЗнач;
		КонецЕсли;
		
		Параметры.Свойство("Фонд", ПарамЗнач);
		Если ЗначениеЗаполнено(ПарамЗнач) тогда
			Объект.Фонд = ПарамЗнач;
		КонецЕсли;
		
		Параметры.Свойство("Подразделение", ПарамЗнач);
		Если ЗначениеЗаполнено(ПарамЗнач) тогда
			Объект.Подразделение = ПарамЗнач;
		КонецЕсли;
		
		Параметры.Свойство("Статус", ПарамЗнач);
		Если ЗначениеЗаполнено(ПарамЗнач) тогда
			Статус = ПарамЗнач;
		КонецЕсли;
		
		Параметры.Свойство("Дата", ПарамЗнач);
		Если ЗначениеЗаполнено(ПарамЗнач) тогда
			Объект.Дата = ПарамЗнач;
		КонецЕсли;
		
		Параметры.Свойство("Сумма", ПарамЗнач);
		Если ЗначениеЗаполнено(ПарамЗнач) тогда
			Объект.Сумма = ПарамЗнач;
		КонецЕсли;
		
		Если ИспользуютсяГруппыКомпаний и не Объект.ОрганизацияДочерняя.Пустая() ТОгда
			Объект.Организация = ИА_ФП.ПолучитьГоловнуюОрганизацию(Объект.ОрганизацияДочерняя);
		КонецЕсли;
		
		Элементы.ГруппаФП.Доступность = ложь;
		
		Элементы.ОбщаяКомандаИА_СтруктураПодчиненностиФП.Видимость = ложь;
		Элементы.Декорация11.Видимость = ложь;
		Элементы.Группа2.Видимость = ложь;
		
	КонецЕсли;
	
	Элементы.ПричинаОтказа.Видимость = Статус = Перечисления.ИА_СостояниеЗаказа.Отклонен;
	
	Если Структура.РегистраторФП Тогда
		Элементы.ПричинаОтказа.ТолькоПросмотр   = Истина;
		Элементы.Дата.ТолькоПросмотр      		= Истина;
		Элементы.Группа11.ТолькоПросмотр      = Истина;
		Элементы.Группа12.ТолькоПросмотр      = Истина;
		Элементы.Группа13.ТолькоПросмотр      = Истина;
		Элементы.ПредметЗаказа.ТолькоПросмотр        = Истина;
		Элементы.Сотрудник.ТолькоПросмотр    	  = Истина;
		Элементы.ГруппаНФ.ТолькоПросмотр   		  = Истина;
		ЭтаФорма.КоманднаяПанель.ТолькоПросмотр   = Истина;
		Элементы.ГруппаОрганизацияДочерняя.ТолькоПросмотр = Истина;
		Элементы.ГруппаОрганизацияГоловная.ТолькоПросмотр = Истина;
		Элементы.Основание.ТолькоПросмотр 		  = Истина;
		Элементы.Сумма.ТолькоПросмотр 		  = Истина;
		
		Элементы.Контрагент.ТолькоПросмотр 		  = Истина;
		Элементы.ПолучательКонтрагент.Доступность = ложь;
		Элементы.ГруппаЗРС.ТолькоПросмотр 		  = Истина;
		Элементы.Добавить.Доступность 		  = Ложь;		
		Элементы.ДатаОплаты.ТолькоПросмотр 		  = Истина;
		
		//Элементы.Статус.ТолькоПросмотр			= НЕ ПравоФП_ОтменаОтклоненияЗаказа ИЛИ Статус <> Перечисления.ИА_СостояниеЗаказа.Отклонен;
		Элементы.Статус.ТолькоПросмотр = истина;	
	КонецЕсли;
	
		
	Если СтатусыОдобрено.найти(Статус)<>Неопределено ИЛИ Статус = Перечисления.ИА_СостояниеЗаказа.Отклонен Тогда 
		
		Элементы.Дата.ТолькоПросмотр      		  = Истина;
		Элементы.Группа11.ТолькоПросмотр      = Истина;
		Элементы.Группа12.ТолькоПросмотр      = Истина;
		Элементы.Группа13.ТолькоПросмотр      = Истина;
		Элементы.ПредметЗаказа.ТолькоПросмотр        = Истина;
		Элементы.Сотрудник.ТолькоПросмотр    	  = Истина;
		Элементы.ГруппаНФ.ТолькоПросмотр   		  = Истина;
		ЭтаФорма.КоманднаяПанель.ТолькоПросмотр   = Истина;
		Элементы.ГруппаОрганизацияДочерняя.ТолькоПросмотр = Истина;
		Элементы.ГруппаОрганизацияГоловная.ТолькоПросмотр = Истина;
		Элементы.Основание.ТолькоПросмотр 		  = Истина;
		Элементы.Сумма.ТолькоПросмотр 		  = Истина;
		
		Элементы.Контрагент.ТолькоПросмотр 		  = Истина;
		Элементы.ПолучательКонтрагент.Доступность = ложь;
		Элементы.ГруппаЗРС.ТолькоПросмотр 		  = Истина;
		Элементы.Добавить.Доступность 		  = Ложь;
		Элементы.ДатаОплаты.ТолькоПросмотр 		  = Истина;
		
		Элементы.Статус.ТолькоПросмотр = истина;	
		
		//Элементы.ГруппаНФ.Видимость = НФ_ЗП;
		Если СтатусыОдобрено.найти(Статус)<>Неопределено Тогда
            Если ИА_БФКС.РеквизитЕсть(Объект.НФ_Заказ, "Завершен") Тогда
                Если Объект.НФ_Заказ.Завершен Тогда
                    Элементы.НФ_Заказ.ЦветФона = Новый Цвет(255, 150,150);
                КонецЕсли;
            КонецЕсли; 
		Иначе
			Элементы.СоздатьЗаказНаПриобретение.Доступность = ложь;
		КонецЕсли;
		
		Элементы.КнопкаПровести.Видимость = Ложь;
		Элементы.КнопкаЗаписать.Видимость = Ложь;
		Элементы.Закрыть.Видимость = истина;
	КонецЕсли;
		
	Если РазделятьНалБезнал Тогда
		
		Элементы.ВидДС.Видимость = Истина;
		Элементы.ВидДССправочно.Видимость = ложь;
		
	Иначе	
		
		Элементы.ВидДС.Видимость = Ложь;
		Элементы.ВидДССправочно.Видимость = ИспользоватьВидДССправочно;
		Элементы.ДекорацияВидДС.Видимость = ИспользоватьВидДССправочно;
		
		Если Объект.ВидДС <> Перечисления.ИА_ВидДенежныхСредств.Безналичные Тогда 
			Объект.ВидДС = Перечисления.ИА_ВидДенежныхСредств.Безналичные;
		КонецЕсли;
	КонецЕсли;
	
	Элементы.Статья.Видимость = ФП_по_ТБ;
	
	Элементы.ГруппаОрганизацияДочерняя.Видимость = ПоОрг;
	
	Если ИспользуютсяГруппыКомпаний тогда
		Элементы.Декорация18.Заголовок = "Головная:";	
		Элементы.ГруппаОрганизацияГоловная.ТолькоПросмотр = истина;	
		Элементы.Организация.ОтображениеПодсказки=ОтображениеПодсказки.Нет;
	КонецЕсли;
	
	Элементы.ДатаОплаты.ОтметкаНезаполненного = ОбязательноеУказаниеСрокаОплатыВЗВС;
	
	/// доступность статусов	
	ПравоФП_УтверждениеЗаказовРуководителем  = ИА_ПраваС.ЗначениеПраваТекПользователя("ФП_УтверждениеЗаказовРуководителем") или ИА_ПраваС.ЗначениеПраваТекПользователя(ПланыВидовХарактеристик.ИА_ПраваПользователей.ФП_ПолныеПрава);
	ПравоФП_ОтправкаНаРассмотрениеЗаказаНаФП = ИА_ПраваС.ЗначениеПраваТекПользователя("ФП_ОтправкаНаРассмотрениеЗаказаНаФП") или ИА_ПраваС.ЗначениеПраваТекПользователя(ПланыВидовХарактеристик.ИА_ПраваПользователей.ФП_ПолныеПрава);
	//ПравоФП_ОтменаОтклоненияЗаказа			 = ИА_ПраваС.ЗначениеПраваТекПользователя("ФП_ОтменаОтклоненияЗаказа");
	
	Элементы.Статус.СписокВыбора.Очистить();
	
	Если ЗначениеЗаполнено(Статус) тогда
		Элементы.Статус.СписокВыбора.Добавить(Статус);
	КонецЕсли;

	если Объект.Ссылка.Пустая() и Элементы.Статус.СписокВыбора.НайтиПоЗначению(Перечисления.ИА_СостояниеЗаказа.Черновик) = Неопределено Тогда
		Элементы.Статус.СписокВыбора.Добавить(Перечисления.ИА_СостояниеЗаказа.Черновик);
	КонецЕсли;
	
	если Элементы.Статус.СписокВыбора.НайтиПоЗначению(Перечисления.ИА_СостояниеЗаказа.Подготовлен) = Неопределено Тогда
		Элементы.Статус.СписокВыбора.Добавить(Перечисления.ИА_СостояниеЗаказа.Подготовлен);
	КонецЕсли;
		
	Если ПравоФП_УтверждениеЗаказовРуководителем Тогда
		если Элементы.Статус.СписокВыбора.НайтиПоЗначению(Перечисления.ИА_СостояниеЗаказа.УтвержденРуководителем) = Неопределено Тогда
			Элементы.Статус.СписокВыбора.Добавить(Перечисления.ИА_СостояниеЗаказа.УтвержденРуководителем);
		КонецЕсли;
		если Элементы.Статус.СписокВыбора.НайтиПоЗначению(Перечисления.ИА_СостояниеЗаказа.ОтклоненРуководителем) = Неопределено Тогда
			Элементы.Статус.СписокВыбора.Добавить(Перечисления.ИА_СостояниеЗаказа.ОтклоненРуководителем);
		КонецЕсли;
	КонецЕсли;
	
	Если ПравоФП_ОтправкаНаРассмотрениеЗаказаНаФП Тогда
		если Элементы.Статус.СписокВыбора.НайтиПоЗначению(Перечисления.ИА_СостояниеЗаказа.РассмотретьНаФП) = Неопределено Тогда
			Элементы.Статус.СписокВыбора.Добавить(Перечисления.ИА_СостояниеЗаказа.РассмотретьНаФП);
		КонецЕсли;
	КонецЕсли;
	
	//Если Статус = Перечисления.ИА_СостояниеЗаказа.Отклонен И ПравоФП_ОтменаОтклоненияЗаказа Тогда
	//	если Элементы.Статус.СписокВыбора.НайтиПоЗначению(Перечисления.ИА_СостояниеЗаказа.РассмотретьНаФП) = Неопределено Тогда
	//		Элементы.Статус.СписокВыбора.Добавить(Перечисления.ИА_СостояниеЗаказа.РассмотретьНаФП);
	//	КонецЕсли;
	//КонецЕсли;
	
	//если Элементы.Статус.СписокВыбора.НайтиПоЗначению(Перечисления.ИА_СостояниеЗаказа.Отклонен) = Неопределено Тогда
	//	Элементы.Статус.СписокВыбора.Добавить(Перечисления.ИА_СостояниеЗаказа.Отклонен);
	//КонецЕсли;
	
	Для каждого стрСтат из Элементы.Статус.СписокВыбора Цикл
		стрСтат.Картинка = КартинкиСтатусов.НайтиПоЗначению(стрСтат.Значение).Картинка;
	КонецЦикла;
	
	//Элементы.Подразделение.Видимость = ИспПодразделения;
	
	ОдобренияВыплаты.Параметры.УстановитьЗначениеПараметра("ЗП", объект.Ссылка);
	Лента.Параметры.УстановитьЗначениеПараметра("объект", объект.Ссылка);
	ОбновитьВылатыНаСервере();
	//	
	ВидимостьПлатежек = ОсталосьВыплатить > 0;
	ВидимостьЗакрытия = ОстатокЗаказа > 0 и Статус <> Перечисления.ИА_СостояниеЗаказа.Отклонен
										  и Статус <> Перечисления.ИА_СостояниеЗаказа.ОтклоненРуководителем
										  и Статус <> Перечисления.ИА_СостояниеЗаказа.Закрыт
										  и ПравоДоступа("Добавление", Метаданные.Документы.ИА_ЗакрытиеЗаказаНаПриобретение);
	Если ВидимостьЗакрытия = ложь и ВидимостьПлатежек = ложь тогда
		Элементы.ГруппаСоздатьНаОсновании.Видимость = ложь;
	ИначеЕсли ВидимостьЗакрытия и ВидимостьПлатежек = ложь тогда
		для каждого эл из Элементы.ГруппаСоздатьНаОсновании.ПодчиненныеЭлементы Цикл
			Если эл <> Элементы.ДокументИА_ЗакрытиеЗаказаНаПриобретениеСоздатьНаОсновании Тогда
				эл.Видимость = ложь;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	//
	Элементы.Декорация11.Видимость = ОсталосьВыплатить > 0;
	
	
	Если ЗначениеЗаполнено(объект.Ссылка) Тогда
		Запрос = новый запрос;
		запрос.Текст = "ВЫБРАТЬ
		               |	КСУ_КомментарииФПСрезПоследних.Комментарий КАК Комментарий
		               |ИЗ
		               |	РегистрСведений.КСУ_КомментарииФП.СрезПоследних(, Заказ = &Заказ) КАК КСУ_КомментарииФПСрезПоследних";
		Запрос.УстановитьПараметр("Заказ", объект.Ссылка);
		выборка = запрос.Выполнить().Выбрать();
		Если выборка.Следующий() Тогда
			КомментарийСФП = выборка.Комментарий;
		КонецЕсли;
	КонецЕсли;

	Элементы.ОткрытьИнструкцию.Видимость = Константы.КСУ_ПоказыватьИнструкциюВЗаказе.Получить();
КонецПроцедуры

