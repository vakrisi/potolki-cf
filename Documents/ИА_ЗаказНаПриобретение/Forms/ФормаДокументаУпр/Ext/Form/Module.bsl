&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	Структура = ИА_ФП.ВернутьСтатусЗВС(Объект.Ссылка);
	СтатусСсылка = Структура.Статус;
		
	ТекущийОбъект.ДополнительныеСвойства.Вставить("Статус",Статус);
	ТекущийОбъект.ДополнительныеСвойства.Вставить("СтатусСсылка",СтатусСсылка);
	Если Статус = Перечисления.ИА_СостояниеЗаказа.Отклонен Тогда
		ТекущийОбъект.ДополнительныеСвойства.Вставить("ПричинаОтказа",ПричинаОтказа);
	КонецЕсли;
	
	// Лента
	Если объект.Ссылка.Пустая() Тогда
		Новстр = ТекущийОбъект.лента.Добавить();
		Новстр.Период = ТекущаяДата();
		Новстр.Ответственный = ПараметрыСеанса.ТекущийПользователь;
		Новстр.Событие = "Создан";
		Новстр.Детали = Статус;
	КонецЕсли;
	
	ПослСтатус = Перечисления.ИА_СостояниеЗаказа.ПустаяСсылка();
	Если ТекущийОбъект.Лента.Количество()>0 Тогда
		ПослСтатус = ТекущийОбъект.Лента[ТекущийОбъект.Лента.Количество()-1].Детали;
	КонецЕсли;
	
	Если (Статус <> ПослСтатус и Статус <> СтатусСсылка) или объект.Ссылка.Пустая() Тогда
		Новстр = ТекущийОбъект.лента.Добавить();
		Новстр.Период = ТекущаяДата();
		Новстр.Ответственный = ПараметрыСеанса.ТекущийПользователь;
		Новстр.Событие = строка(Статус);
		Новстр.Детали = Статус;
	КонецЕсли;

КонецПроцедуры

