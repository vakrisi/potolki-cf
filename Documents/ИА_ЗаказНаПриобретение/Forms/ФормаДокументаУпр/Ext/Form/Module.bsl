&НаСервере
Процедура ОбновитьВылатыНаСервере()
	
	Если объект.Ссылка.Пустая() Тогда
		Элементы.ГруппаФинПоказатели.Видимость = ложь;
		возврат;
	КонецЕсли;
	
	ТабДокВыплат.Очистить();
	Об = РеквизитФормыВЗначение("Объект");
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЕСТЬNULL(СУММА(Обороты.СуммаБезналПриход), 0) КАК Одобрено,
		|	ЕСТЬNULL(СУММА(ВЫБОР
		|				КОГДА Обороты.Регистратор ССЫЛКА Документ.ИА_ЗакрытиеЗаказаНаПриобретение
		|					ТОГДА 0
		|				ИНАЧЕ Обороты.СуммаБезналРасход
		|			КОНЕЦ), 0) КАК Выплачено,
		|	ЕСТЬNULL(СУММА(ВЫБОР
		|				КОГДА Обороты.Регистратор ССЫЛКА Документ.ИА_ЗакрытиеЗаказаНаПриобретение
		|					ТОГДА Обороты.СуммаБезналРасход
		|				ИНАЧЕ 0
		|			КОНЕЦ), 0) КАК Закрыто,
		|	МАКСИМУМ(ЕСТЬNULL(ИА_СредстваВРезервеНаФондахОстатки.СуммаБезналОстаток, 0)) КАК ОсталосьВыплатить,
		|	МАКСИМУМ(ЕСТЬNULL(ЗаказыОстатки.СуммаОстаток, 0)) КАК ОстатокЗаказа
		|ИЗ
		|	Документ.ИА_ЗаказНаПриобретение КАК Заказы
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ИА_ЗаказыНаПриобретение.Остатки(, ЗП = &ЗП) КАК ЗаказыОстатки
		|		ПО Заказы.Ссылка = ЗаказыОстатки.ЗП
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ИА_СредстваВРезервеНаФондах.Обороты(, , Регистратор, ЗП = &ЗП) КАК Обороты
		|		ПО (Обороты.ЗП = Заказы.Ссылка)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ИА_СредстваВРезервеНаФондах.Остатки(, ЗП = &ЗП) КАК ИА_СредстваВРезервеНаФондахОстатки
		|		ПО Заказы.Ссылка = ИА_СредстваВРезервеНаФондахОстатки.ЗП
		|ГДЕ
		|	Заказы.Ссылка = &ЗП";

	Запрос.УстановитьПараметр("ЗП",Объект.Ссылка);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если выборка.Следующий() Тогда
		Одобрено = выборка.Одобрено;		
		Выплачено = выборка.Выплачено;
		Закрыто = выборка.Закрыто;
		ОсталосьВыплатить = выборка.ОсталосьВыплатить;
		ОстатокЗаказа = выборка.ОстатокЗаказа;
	КонецЕсли;
	
	Элементы.ДекорацияСуммаЗаказа.Заголовок = ИА_ФПСервер.ПолучитьФСЧисла(Объект.Сумма);
	Элементы.ДекорацияОдобрено.Заголовок = ИА_ФПСервер.ПолучитьФСЧисла(Одобрено);
	Элементы.ДекорацияВыплачено.Заголовок = ИА_ФПСервер.ПолучитьФСЧисла(Выплачено);
	Элементы.ДекорацияЗакрыто.Заголовок = ИА_ФПСервер.ПолучитьФСЧисла(Закрыто);
	Элементы.ДекорацияОсталосьВыплатить.Заголовок = ИА_ФПСервер.ПолучитьФСЧисла(ОсталосьВыплатить);
	
	Элементы.ГруппаЗакрыто.Видимость =  Закрыто<>0;
	Элементы.ГруппаОсталосьВыплатить.Видимость =  ОсталосьВыплатить<>0;
	
КонецПроцедуры

