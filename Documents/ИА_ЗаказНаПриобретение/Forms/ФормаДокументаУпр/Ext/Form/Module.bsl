КонецПроцедуры

&НаСервере
Процедура УстановитьОграничениеСтатьи()
	НовыйМассив = Новый Массив();
	Если не объект.Фонд.Пустая() Тогда
		НоваяСвязь = Новый СвязьПараметраВыбора("Отбор.Владелец", "Объект.Фонд");		
		НовыйМассив.Добавить(НоваяСвязь);		
	КонецЕсли;
	НовыеСвязи = Новый ФиксированныйМассив(НовыйМассив);		
	Элементы.Статья.СвязиПараметровВыбора = НовыеСвязи;
КонецПроцедуры


&НаКлиенте
Процедура ВидДССправочноНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СтандартнаяОбработка = ложь;
	
	Список = Новый СписокЗначений;
	Список.Добавить(ПредопределенноеЗначение("Перечисление.ИА_ВидДенежныхСредств.Наличные"));
	Список.Добавить(ПредопределенноеЗначение("Перечисление.ИА_ВидДенежныхСредств.Безналичные"));
	
	Оп = Новый ОписаниеОповещения("ВыполнитьПослеВыбораДС", ЭтотОбъект);
	ПоказатьВыборИзСписка(Оп, Список, Элементы.ВидДССправочно);
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьПослеВыбораДС(ВыбранныйЭлемент, парам) Экспорт
	Если ВыбранныйЭлемент<>Неопределено Тогда
		Объект.ВидДССправочно = ВыбранныйЭлемент.Значение;
	КонецЕсли;
КонецПроцедуры


