
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если Параметры.Свойство("НаДату") Тогда
		Список.Параметры.УстановитьЗначениеПараметра("НаДату", Параметры.НаДату - 1);
	Иначе
		Список.Параметры.УстановитьЗначениеПараметра("НаДату", ТекущаяДата());
	КонецЕсли;
КонецПроцедуры
