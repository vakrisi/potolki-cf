	<Attributes>
		<Attribute name="Список" id="1">
			<Type>
				<v8:Type>cfg:DynamicList</v8:Type>
			</Type>
			<MainAttribute>true</MainAttribute>
			<UseAlways>
				<Field>Список.ОстатокЗП</Field>
			</UseAlways>
			<Settings xsi:type="DynamicList">
				<ManualQuery>true</ManualQuery>
				<DynamicDataRead>true</DynamicDataRead>
				<QueryText>ВЫБРАТЬ
	ИА_ЗаказНаПриобретение.Ссылка КАК Ссылка,
	ИА_ЗаказНаПриобретение.Сотрудник КАК Сотрудник,
	ИА_ЗаказНаПриобретение.Подразделение КАК Подразделение,
	ИА_ЗаказНаПриобретение.Фонд КАК Фонд,
	ЕСТЬNULL(ИА_ИсторияСтатусовЗВССрезПоследних.Статус, ЗНАЧЕНИЕ(Перечисление.ИА_СостояниеЗаказа.Подготовлен)) КАК Статус,
	ИА_ЗаказНаПриобретение.Сумма КАК СуммаЗаказа,
	ЕСТЬNULL(ВложенныйЗапросОплата.Сумма, 0) КАК СуммаОплаты,
	ИА_ЗаказНаПриобретение.ПредметЗаказа КАК ПредметЗаказа,
	ИА_ЗаказНаПриобретение.Дата КАК Дата,
	ИА_ЗаказНаПриобретение.Номер КАК Номер,
	ИА_ЗаказНаПриобретение.ПометкаУдаления КАК ПометкаУдаления,
	ИА_ЗаказНаПриобретение.Ситуация КАК Ситуация,
	ИА_ЗаказНаПриобретение.Данные КАК Данные,
	ИА_ЗаказНаПриобретение.Решение КАК Решение,
	ИА_ЗаказНаПриобретение.Организация КАК Организация,
	ИА_ЗаказНаПриобретение.ВидДС КАК ВидДС,
	ИА_ЗаказНаПриобретение.ДатаОплаты КАК ДатаОплаты,
	ИА_ЗаказНаПриобретение.ОрганизацияДочерняя КАК ОрганизацияДочерняя,
	ИА_ЗаказНаПриобретение.ВидДССправочно КАК ВидДССправочно,
	ЕСТЬNULL(ОстатокЗП.СуммаОстаток, 0) КАК ОстатокЗП,
	ИА_ЗаказНаПриобретение.Проведен КАК Проведен,
	ИА_ЗаказНаПриобретение.Контрагент КАК Контрагент
ИЗ
	Документ.ИА_ЗаказНаПриобретение КАК ИА_ЗаказНаПриобретение
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИА_ИсторияСтатусовЗВС.СрезПоследних КАК ИА_ИсторияСтатусовЗВССрезПоследних
		ПО (ИА_ИсторияСтатусовЗВССрезПоследних.ЗВС = ИА_ЗаказНаПриобретение.Ссылка)
		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			ИА_СредстваВРезервеНаФондахОбороты.ЗП КАК Ссылка,
			СУММА(ИА_СредстваВРезервеНаФондахОбороты.СуммаБезналРасход + ИА_СредстваВРезервеНаФондахОбороты.СуммаНалРасход) КАК Сумма,
			СУММА(ИА_СредстваВРезервеНаФондахОбороты.СуммаНалПриход + ИА_СредстваВРезервеНаФондахОбороты.СуммаБезналПриход) КАК ОдобреннаяСумма
		ИЗ
			РегистрНакопления.ИА_СредстваВРезервеНаФондах.Обороты(, , Авто, ) КАК ИА_СредстваВРезервеНаФондахОбороты
		ГДЕ
			НЕ ИА_СредстваВРезервеНаФондахОбороты.Регистратор ССЫЛКА Документ.ИА_ЗакрытиеЗаказаНаПриобретение
		
		СГРУППИРОВАТЬ ПО
			ИА_СредстваВРезервеНаФондахОбороты.ЗП) КАК ВложенныйЗапросОплата
		ПО ИА_ЗаказНаПриобретение.Ссылка = ВложенныйЗапросОплата.Ссылка
		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			ИА_ЗаказыНаПриобретениеОстатки.ЗП КАК ЗП,
			СУММА(ИА_ЗаказыНаПриобретениеОстатки.СуммаОстаток) КАК СуммаОстаток
		ИЗ
			РегистрНакопления.ИА_ЗаказыНаПриобретение.Остатки КАК ИА_ЗаказыНаПриобретениеОстатки
		
		СГРУППИРОВАТЬ ПО
			ИА_ЗаказыНаПриобретениеОстатки.ЗП) КАК ОстатокЗП
		ПО ИА_ЗаказНаПриобретение.Ссылка = ОстатокЗП.ЗП</QueryText>
				<MainTable>Document.ИА_ЗаказНаПриобретение</MainTable>
				<ListSettings>
					<dcsset:filter>
						<dcsset:viewMode>Normal</dcsset:viewMode>
						<dcsset:userSettingID>dfcece9d-5077-440b-b6b3-45a5cb4538eb</dcsset:userSettingID>
					</dcsset:filter>
					<dcsset:order>
						<dcsset:viewMode>Normal</dcsset:viewMode>
						<dcsset:userSettingID>88619765-ccb3-46c6-ac52-38e9c992ebd4</dcsset:userSettingID>
					</dcsset:order>
					<dcsset:conditionalAppearance>
						<dcsset:viewMode>Normal</dcsset:viewMode>
						<dcsset:userSettingID>b75fecce-942b-4aed-abc9-e6a02e460fb3</dcsset:userSettingID>
					</dcsset:conditionalAppearance>
					<dcsset:itemsViewMode>Normal</dcsset:itemsViewMode>
					<dcsset:itemsUserSettingID>911b6018-f537-43e8-a417-da56b22f9aec</dcsset:itemsUserSettingID>
				</ListSettings>
			</Settings>
		</Attribute>
		<ConditionalAppearance>
			<dcsset:item>
				<dcsset:selection>
					<dcsset:item>
						<dcsset:field>Список</dcsset:field>
					</dcsset:item>
				</dcsset:selection>
				<dcsset:filter>
					<dcsset:item xsi:type="dcsset:FilterItemGroup">
						<dcsset:groupType>AndGroup</dcsset:groupType>
						<dcsset:item xsi:type="dcsset:FilterItemComparison">
							<dcsset:left xsi:type="dcscor:Field">Список.ОстатокЗП</dcsset:left>
							<dcsset:comparisonType>Equal</dcsset:comparisonType>
							<dcsset:right xsi:type="xs:decimal">0</dcsset:right>
						</dcsset:item>
						<dcsset:item xsi:type="dcsset:FilterItemComparison">
							<dcsset:left xsi:type="dcscor:Field">Список.Проведен</dcsset:left>
							<dcsset:comparisonType>Equal</dcsset:comparisonType>
							<dcsset:right xsi:type="xs:boolean">true</dcsset:right>
						</dcsset:item>
					</dcsset:item>
				</dcsset:filter>
				<dcsset:appearance>
					<dcscor:item xsi:type="dcsset:SettingsParameterValue">
						<dcscor:parameter>ЦветФона</dcscor:parameter>
						<dcscor:value xsi:type="v8ui:Color">#DBFFE3</dcscor:value>
					</dcscor:item>
				</dcsset:appearance>
			</dcsset:item>
		</ConditionalAppearance>
	</Attributes>
