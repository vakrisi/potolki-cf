
&НаКлиенте
Процедура ВвестиНаОснованииИнкассовоеПоручениеПолученное(Команда)
	
	СтрокаСписка = Элементы.Список.ТекущиеДанные;
	
	Если не СтрокаСписка = Неопределено Тогда
		П = Новый Структура;
		
		П.Вставить("Основание", СтрокаСписка.Ссылка);
		
		ОткрытьФорму("Документ.ИнкассовоеПоручениеПолученное.ФормаОбъекта", П);
	КонецЕсли;
	
КонецПроцедуры

