Процедура ЗаписьИсторииСтатусовЗВС()
	
	НовыйСтатус = Неопределено;
	НоваяПричинаОтказа = Неопределено;
	Если НЕ ЭтотОбъект.ДополнительныеСвойства.Свойство("Статус",НовыйСтатус) Тогда 
		Возврат;
	КонецЕсли;
	ЭтотОбъект.ДополнительныеСвойства.Свойство("ПричинаОтказа",НоваяПричинаОтказа); 
	
	Движения.ИА_ИсторияСтатусовЗВС.Записывать = Истина;
	
	Новстр = Движения.ИА_ИсторияСтатусовЗВС.Добавить();	
	Если НовыйСтатус = Перечисления.ИА_СостояниеЗаказа.Отклонен Тогда
		Новстр.Период = ТекущаяДата();
	Иначе
		Новстр.Период = Дата;
	КонецЕсли;	
	Новстр.ЗВС = Ссылка;
	Новстр.Статус = НовыйСтатус;
	Новстр.ПричинаОтказа = НоваяПричинаОтказа;

КонецПроцедуры

