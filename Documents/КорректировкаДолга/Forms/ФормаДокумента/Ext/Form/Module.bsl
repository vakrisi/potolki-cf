#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗагрузитьИзExcel(Команда)
	
	ИмяТЧУвеличение = "УвеличениеДолга";
	ИмяТЧУменьшение = "УменьшениеДолга";
	
	Если Команда.Имя = "ЗагрузитьИзExcelРасчетыСПоставщиками" Тогда
		ИмяТЧУвеличение = "УвеличениеДолгаПоставщиков";
		ИмяТЧУменьшение = "УменьшениеДолгаПоставщиков";
	КонецЕсли;
		
	Если Объект[ИмяТЧУвеличение].Количество() + Объект[ИмяТЧУменьшение].Количество() > 0 Тогда
		ОписаниеОповещения = новый ОписаниеОповещения("ЗагрузитьИзExcelПослеВопроса", ЭтотОбъект);
		ПоказатьВопрос(ОписаниеОповещения, "Очистить таблицы перед загрузкой?", РежимДиалогаВопрос.ДаНетОтмена);
	Иначе
		ЗагрузитьИзExcelФрагмент();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьИзExcelПослеВопроса(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено ИЛИ Результат = КодВозвратаДиалога.Отмена Тогда
		Возврат;
	КонецЕсли;
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		Объект[ИмяТЧУвеличение].Очистить();
		Объект[ИмяТЧУменьшение].Очистить();
	КонецЕсли;
	
	ЗагрузитьИзExcelФрагмент();
	 
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьИзExcelФрагмент()
	
	ОткрытьФорму("Обработка.ЗагрузкаКонтрагентовИзExcel.Форма.ФормаЗагрузкиВзаиморасчетов", , ЭтаФорма, УникальныйИдентификатор);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьИзExcelЗавершение(ВыбранноеЗначение)
	
	Если Не ЗначениеЗаполнено(ВыбранноеЗначение) Тогда
		Возврат;
	КонецЕсли;
			
	ЗагрузитьИзExcelНаСервере(ВыбранноеЗначение);	
	
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьИзExcelНаСервере(ВыбранноеЗначение)
	
	ТаблицаДолгов = ПолучитьИзВременногоХранилища(ВыбранноеЗначение.АдресВХранилище);
	
	Для Каждого СтрокаТЗ из ТаблицаДолгов Цикл
		
		Если СтрокаТЗ.Сумма > 0 Тогда
			НоваяСтрока = Объект[ИмяТЧУвеличение].Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТЗ);
			
		ИначеЕсли СтрокаТЗ.Сумма < 0 Тогда
			НоваяСтрока = Объект[ИмяТЧУменьшение].Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТЗ);
			НоваяСтрока.Сумма = -НоваяСтрока.Сумма;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьДолгиДляУменьшения(Команда)
	
	Если Объект.Организация.Пустая() Тогда
		ПоказатьПредупреждение(, "Не указана организация");
		Возврат;
	КонецЕсли;
	
	ИмяТЧУменьшение = "УменьшениеДолга";
	Если Команда.Имя = "ЗаполнитьДолгиПоставщиковДляУменьшения" Тогда
		ИмяТЧУменьшение = "УменьшениеДолгаПоставщиков";	
	КонецЕсли;
	
	Если Объект[ИмяТЧУменьшение].Количество() > 0 Тогда
		ОписаниеОповещения = новый ОписаниеОповещения("ЗаполнитьДолгиДляУменьшенияПослеВопроса", ЭтотОбъект);
		ПоказатьВопрос(ОписаниеОповещения, "Очистить таблицу уменьшения долга?", РежимДиалогаВопрос.ДаНет);
	Иначе
		ЗаполнитьТаблицуУменьшенияПоТекущимДолгам();
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьДолгиДляУменьшенияПослеВопроса(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено ИЛИ Результат = КодВозвратаДиалога.Отмена Тогда
		Возврат;
	КонецЕсли;
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		Объект[ИмяТЧУменьшение].Очистить();
	КонецЕсли;
	
	ЗаполнитьТаблицуУменьшенияПоТекущимДолгам();
	 
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТаблицуУменьшенияПоТекущимДолгам()
	
	ВалютаУчета = Константы.ВалютаУчета.Получить();
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Период",КонецДня(ТекущаяДатаСеанса()));
	Запрос.УстановитьПараметр("Организация",Объект.Организация);
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВзаиморасчетыСКонтрагентамиОстатки.Контрагент КАК Контрагент,
	|	ВзаиморасчетыСКонтрагентамиОстатки.Договор КАК Договор,
	|	ВзаиморасчетыСКонтрагентамиОстатки.СуммаОстаток КАК Сумма
	|ИЗ
	|	РегистрНакопления.ВзаиморасчетыСКонтрагентами.Остатки(&Период, Организация = &Организация) КАК ВзаиморасчетыСКонтрагентамиОстатки
	|ГДЕ
	|	ВзаиморасчетыСКонтрагентамиОстатки.СуммаОстаток > 0";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = Объект[ИмяТЧУменьшение].Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		НоваяСтрока.Валюта = ВалютаУчета;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервереБезКонтекста
Функция ПолучитьВалютуУчета()
	Возврат Константы.ВалютаУчета.Получить();
КонецФункции

&НаСервере
Функция ПолучитьДоговорПоУмолчанию(Контрагент)
	
	Если НЕ ЗначениеЗаполнено(Контрагент) Тогда
		Возврат Справочники.ДоговорыКонтрагентов.ПустаяСсылка();
	КонецЕсли;
	
	Возврат Справочники.ДоговорыКонтрагентов.ПолучитьДоговорПоУмолчанию(Объект.Организация, Контрагент)	
	
КонецФункции

#КонецОбласти

