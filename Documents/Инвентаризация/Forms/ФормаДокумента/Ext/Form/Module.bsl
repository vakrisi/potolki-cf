Функция ПолучитьСписокЯчеекПоСкладу()
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	НоменклатураСкладскиеЯчейки.Ячейка КАК Ячейка
		|ИЗ
		|	Справочник.Номенклатура.СкладскиеЯчейки КАК НоменклатураСкладскиеЯчейки
		|ГДЕ
		|	НоменклатураСкладскиеЯчейки.Склад = &Склад
		|
		|СГРУППИРОВАТЬ ПО
		|	НоменклатураСкладскиеЯчейки.Ячейка";
	
	Запрос.УстановитьПараметр("Склад", Объект.Склад);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	СписокВыбораЯчеек = Новый СписокЗначений;
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат СписокВыбораЯчеек;
	КонецЕсли;	
		
	
	СписокВыбораЯчеек.ЗагрузитьЗначения(РезультатЗапроса.Выгрузить().ВыгрузитьКолонку("Ячейка"));
	Возврат СписокВыбораЯчеек;
КонецФункции	

&НаКлиенте
Процедура ЗаполнитьПоОстаткамПоЯчейкамНоменклатурыЗавершение(Список, ДополнительныеПараметры) Экспорт
	
	ВыбранныеЭлементы = Новый Массив;
	Для каждого Элемент из Список Цикл
    	Если Элемент.Пометка Тогда
    		ВыбранныеЭлементы.Добавить(Элемент.Значение);
    	КонецЕсли;
    КонецЦикла;
	
	Если ВыбранныеЭлементы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;	
	
	ЗаполнитьПоОстаткамНаСервере(,,,,,Истина,ВыбранныеЭлементы);
		
КонецПроцедуры

