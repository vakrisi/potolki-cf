&НаСервере
Функция ПолучитьКоличествоИСуммуОстаток(Дата, Организация, Склад, Номенклатура, ХарактеристикаНоменклатуры, СерияНоменклатуры)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТоварыНаСкладахОстатки.КоличествоОстаток КАК Количество,
	|	ТоварыНаСкладахОстатки.СуммаОстаток КАК Сумма,
	|	ВЫБОР
	|		КОГДА ТоварыНаСкладахОстатки.КоличествоОстаток <= 0
	|				ИЛИ ТоварыНаСкладахОстатки.СуммаОстаток = 0
	|			ТОГДА 0
	|		ИНАЧЕ ТоварыНаСкладахОстатки.СуммаОстаток / ТоварыНаСкладахОстатки.КоличествоОстаток
	|	КОНЕЦ КАК Цена
	|ИЗ
	|	РегистрНакопления.ТоварыНаСкладах.Остатки(
	|			&ДатаОстатков,
	|			Номенклатура = &Номенклатура
	|				И ВЫБОР
	|					КОГДА &ИспользуютсяОбщиеСклады
	|						ТОГДА ИСТИНА
	|					ИНАЧЕ Организация = &Организация
	|				КОНЕЦ
	|				И ХарактеристикаНоменклатуры = &ХарактеристикаНоменклатуры
	|				И СерияНоменклатуры = &СерияНоменклатуры
	|				И Склад = &Склад) КАК ТоварыНаСкладахОстатки";
	
	Запрос.УстановитьПараметр("ДатаОстатков",				ДатаОстатков(Дата));	
	Запрос.УстановитьПараметр("Организация",				Организация);
	Запрос.УстановитьПараметр("Склад",						Склад);
	Запрос.УстановитьПараметр("ИспользуютсяОбщиеСклады", 	Константы.ОбщиеСклады.Получить());
	Запрос.УстановитьПараметр("Номенклатура",				Номенклатура);
	Запрос.УстановитьПараметр("ХарактеристикаНоменклатуры",	ХарактеристикаНоменклатуры);
	Запрос.УстановитьПараметр("СерияНоменклатуры",			СерияНоменклатуры);
		
	Выборка = Запрос.Выполнить().Выбрать();
	СтруктураВозврата = Новый Структура("Количество, Цена, Сумма", 0, 0, 0);
	Пока Выборка.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(СтруктураВозврата, Выборка);
	КонецЦикла;
	
	Возврат СтруктураВозврата;
		
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура РассчитатьСуммуФакт(СтрокаТабличнойЧасти)

	Если НЕ СтрокаТабличнойЧасти.Количество = 0 Тогда
		СтрокаТабличнойЧасти.СуммаФакт = СтрокаТабличнойЧасти.КоличествоФакт * (СтрокаТабличнойЧасти.Сумма / СтрокаТабличнойЧасти.Количество);
	Иначе
	    СтрокаТабличнойЧасти.СуммаФакт = СтрокаТабличнойЧасти.КоличествоФакт * СтрокаТабличнойЧасти.Цена;
	КонецЕсли;

КонецПроцедуры

// Возвращает соответствие: ссылка на номенклатуру -> наименование.
// Используется для сортировки строк по представлению номенклатуры,
// так как сортировка по самой ссылке упорядочивает по внутреннему идентификатору.
&НаСервереБезКонтекста
Функция НаименованияНоменклатуры(МассивНоменклатуры)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Номенклатура.Ссылка КАК Ссылка,
		|	Номенклатура.Наименование КАК Наименование
		|ИЗ
		|	Справочник.Номенклатура КАК Номенклатура
		|ГДЕ
		|	Номенклатура.Ссылка В (&МассивНоменклатуры)";
	Запрос.УстановитьПараметр("МассивНоменклатуры", МассивНоменклатуры);
	
	Наименования = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Наименования.Вставить(Выборка.Ссылка, Выборка.Наименование);
	КонецЦикла;
	
	Возврат Наименования;
	
КонецФункции

