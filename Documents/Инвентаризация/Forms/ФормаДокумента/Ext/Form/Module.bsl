КонецПроцедуры

&НаСервере
Процедура СортироватьТоварыПоНоменклатуреНаСервере(ПоВозрастанию)
	
	ТаблицаТоваров = Объект.Товары.Выгрузить();
	Если ТаблицаТоваров.Количество() < 2 Тогда
		Возврат;
	КонецЕсли;
	
	ТаблицаТоваров.Колонки.Добавить("НаименованиеНоменклатуры", Новый ОписаниеТипов("Строка"));
	
	Наименования = НаименованияНоменклатуры(ТаблицаТоваров.ВыгрузитьКолонку("Номенклатура"));
	Для Каждого СтрокаТаблицы Из ТаблицаТоваров Цикл
		Наименование = Наименования.Получить(СтрокаТаблицы.Номенклатура);
		СтрокаТаблицы.НаименованиеНоменклатуры = ?(Наименование = Неопределено, "", Наименование);
	КонецЦикла;
	
	ТаблицаТоваров.Сортировать("НаименованиеНоменклатуры " + ?(ПоВозрастанию, "Возр", "Убыв"));
	ТаблицаТоваров.Колонки.Удалить("НаименованиеНоменклатуры");
	
	Объект.Товары.Загрузить(ТаблицаТоваров);
	
КонецПроцедуры

#КонецОбласти

