	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВЗЗаказПокупателяТовары.Организация КАК Организация,
	|	ВЗЗаказПокупателяТовары.Склад КАК Склад,
	|	ВЗЗаказПокупателяТовары.Номенклатура КАК Номенклатура,
	|	ВЗЗаказПокупателяТовары.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	|	ВЗЗаказПокупателяТовары.СерияНоменклатуры КАК СерияНоменклатуры,
	|	СУММА(ВЗЗаказПокупателяТовары.Количество) КАК Количество,
	|	СУММА(ВЗРеализацияТоваровИУслугТовары.КоличествоВРеализациях) КАК КоличествоВРеализациях
	|ПОМЕСТИТЬ ВТ_ЗаказыСобранные
	|ИЗ
	|	(ВЫБРАТЬ
	|		ЗаказПокупателяТовары.Ссылка.Организация КАК Организация,
	|		ЗаказПокупателяТовары.Ссылка.Склад КАК Склад,
	|		ЗаказПокупателяТовары.Номенклатура КАК Номенклатура,
	|		ЗаказПокупателяТовары.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	|		ЗаказПокупателяТовары.СерияНоменклатуры КАК СерияНоменклатуры,
	|		СУММА(ЗаказПокупателяТовары.Количество) КАК Количество,
	|		ЗаказПокупателяТовары.Ссылка КАК Заказ
	|	ИЗ
	|		Документ.ЗаказПокупателя.Товары КАК ЗаказПокупателяТовары
	|	ГДЕ
	|		ЗаказПокупателяТовары.Ссылка.СтатусСборки = ЗНАЧЕНИЕ(Справочник.СтатусыСборкиЗаказов.СобранПолностью)
	|		И ЗаказПокупателяТовары.Ссылка.ТекущийСтатус = ЗНАЧЕНИЕ(Справочник.СтатусыЗаказовПокупателей.ВРаботе)
	|		И ЗаказПокупателяТовары.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Справочник.ВидыНоменклатуры.Материал)
	|	
	|	СГРУППИРОВАТЬ ПО
	|		ЗаказПокупателяТовары.Ссылка.Организация,
	|		ЗаказПокупателяТовары.Ссылка.Склад,
	|		ЗаказПокупателяТовары.Номенклатура,
	|		ЗаказПокупателяТовары.ХарактеристикаНоменклатуры,
	|		ЗаказПокупателяТовары.СерияНоменклатуры,
	|		ЗаказПокупателяТовары.Ссылка) КАК ВЗЗаказПокупателяТовары
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			РеализацияТоваровИУслугТовары.Ссылка.Организация КАК Организация,
	|			РеализацияТоваровИУслугТовары.Номенклатура КАК Номенклатура,
	|			РеализацияТоваровИУслугТовары.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	|			РеализацияТоваровИУслугТовары.СерияНоменклатуры КАК СерияНоменклатуры,
	|			РеализацияТоваровИУслугТовары.Заказ КАК Заказ,
	|			СУММА(РеализацияТоваровИУслугТовары.Количество) КАК КоличествоВРеализациях
	|		ИЗ
	|			Документ.РеализацияТоваровИУслуг.Товары КАК РеализацияТоваровИУслугТовары
	|		ГДЕ
	|			РеализацияТоваровИУслугТовары.Ссылка.Проведен
	|			И НЕ РеализацияТоваровИУслугТовары.Ссылка.ПометкаУдаления
	|		
	|		СГРУППИРОВАТЬ ПО
	|			РеализацияТоваровИУслугТовары.Ссылка.Организация,
	|			РеализацияТоваровИУслугТовары.Номенклатура,
	|			РеализацияТоваровИУслугТовары.ХарактеристикаНоменклатуры,
	|			РеализацияТоваровИУслугТовары.СерияНоменклатуры,
	|			РеализацияТоваровИУслугТовары.Заказ) КАК ВЗРеализацияТоваровИУслугТовары
	|		ПО (ВЗРеализацияТоваровИУслугТовары.Номенклатура = ВЗЗаказПокупателяТовары.Номенклатура)
	|			И ВЗЗаказПокупателяТовары.ХарактеристикаНоменклатуры = ВЗРеализацияТоваровИУслугТовары.ХарактеристикаНоменклатуры
	|			И (ВЗРеализацияТоваровИУслугТовары.Заказ = ВЗЗаказПокупателяТовары.Заказ)
	|
	|СГРУППИРОВАТЬ ПО
	|	ВЗЗаказПокупателяТовары.Организация,
	|	ВЗЗаказПокупателяТовары.Склад,
	|	ВЗЗаказПокупателяТовары.Номенклатура,
	|	ВЗЗаказПокупателяТовары.ХарактеристикаНоменклатуры,
	|	ВЗЗаказПокупателяТовары.СерияНоменклатуры
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЗаказПокупателяТовары.Ссылка.Организация КАК Организация,
	|	ЗаказПокупателяТовары.Ссылка.Склад КАК Склад,
	|	ЗаказПокупателяТовары.Номенклатура КАК Номенклатура,
	|	ЗаказПокупателяТовары.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	|	ЗаказПокупателяТовары.СерияНоменклатуры КАК СерияНоменклатуры,
	|	СУММА(ЕСТЬNULL(ЗаказПокупателяТовары.Количество, 0)) КАК КоличествоВЗаказеПокупателя,
	|	СУММА(ЕСТЬNULL(ПеремещениеТоваровТовары.Количество, 0)) КАК КоличествоВПеремещениях,
	|	СУММА(ЕСТЬNULL(ЗаказПоставщикуТовары.Количество, 0)) КАК КоличествоВЗаказахПоставщику,
	|	СУММА(ЕСТЬNULL(ЗаказПокупателяТовары.Количество, 0) - ЕСТЬNULL(ЗаказПоставщикуТовары.Количество, 0) - ЕСТЬNULL(ПеремещениеТоваровТовары.Количество, 0) - ЕСТЬNULL(РеализацияТоваровИУслугТовары.Количество, 0)) КАК Количество,
	|	ЗаказПокупателяТовары.Ссылка КАК Ссылка,
	|	СУММА(ЕСТЬNULL(РеализацияТоваровИУслугТовары.Количество, 0)) КАК КоличествоВРеализациях
	|ПОМЕСТИТЬ ВТ_ЗаказыЧастиноСобранные
	|ИЗ
	|	Документ.ЗаказПокупателя.Товары КАК ЗаказПокупателяТовары
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПеремещениеТоваров.Товары КАК ПеремещениеТоваровТовары
	|		ПО (ПеремещениеТоваровТовары.Ссылка.Основание = ЗаказПокупателяТовары.Ссылка)
	|			И ЗаказПокупателяТовары.Номенклатура = ПеремещениеТоваровТовары.Номенклатура
	|			И ЗаказПокупателяТовары.ХарактеристикаНоменклатуры = ПеремещениеТоваровТовары.ХарактеристикаНоменклатуры
	|			И ЗаказПокупателяТовары.СерияНоменклатуры = ПеремещениеТоваровТовары.СерияНоменклатуры
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаказПоставщику.Товары КАК ЗаказПоставщикуТовары
	|		ПО ЗаказПокупателяТовары.Ссылка = ЗаказПоставщикуТовары.Ссылка.Основание
	|			И ЗаказПокупателяТовары.Номенклатура = ЗаказПоставщикуТовары.Номенклатура
	|			И ЗаказПокупателяТовары.ХарактеристикаНоменклатуры = ЗаказПоставщикуТовары.ХарактеристикаНоменклатуры
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РеализацияТоваровИУслуг.Товары КАК РеализацияТоваровИУслугТовары
	|		ПО (РеализацияТоваровИУслугТовары.Ссылка.Основание = ЗаказПокупателяТовары.Ссылка.Ссылка)
	|			И (РеализацияТоваровИУслугТовары.Номенклатура = ЗаказПокупателяТовары.Номенклатура)
	|			И (РеализацияТоваровИУслугТовары.ХарактеристикаНоменклатуры = ЗаказПокупателяТовары.ХарактеристикаНоменклатуры)
	|ГДЕ
	|	ЗаказПокупателяТовары.Ссылка.СтатусСборки = ЗНАЧЕНИЕ(Справочник.СтатусыСборкиЗаказов.СобранЧастично)
	|	И ЗаказПокупателяТовары.Ссылка.ТекущийСтатус = ЗНАЧЕНИЕ(Справочник.СтатусыЗаказовПокупателей.ВРаботе)
	|	И ЗаказПокупателяТовары.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Справочник.ВидыНоменклатуры.Материал)
	|	И ПеремещениеТоваровТовары.Ссылка.Проведен
	|	И ЗаказПоставщикуТовары.Ссылка.Проведен
	|	И РеализацияТоваровИУслугТовары.Ссылка.Проведен
	|
	|СГРУППИРОВАТЬ ПО
	|	ЗаказПокупателяТовары.Номенклатура,
	|	ЗаказПокупателяТовары.ХарактеристикаНоменклатуры,
	|	ЗаказПокупателяТовары.СерияНоменклатуры,
	|	ЗаказПокупателяТовары.Ссылка.Склад,
	|	ЗаказПокупателяТовары.Ссылка.Организация,
	|	ЗаказПокупателяТовары.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТоварыНаСкладахОстатки.Номенклатура КАК Номенклатура,
	|	ТоварыНаСкладахОстатки.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	|	ТоварыНаСкладахОстатки.СерияНоменклатуры КАК СерияНоменклатуры,
	|	ВЫБОР
	|		КОГДА &ИсключитьСобранныеЗаказы
	|			ТОГДА ЕСТЬNULL(ТоварыНаСкладахОстатки.КоличествоОстаток, 0) - ЕСТЬNULL(СобранныеЗаказы.Количество, 0)
	|		ИНАЧЕ ЕСТЬNULL(ТоварыНаСкладахОстатки.КоличествоОстаток, 0)
	|	КОНЕЦ КАК Количество,
	|	ВЫБОР
	|		КОГДА &ИсключитьСобранныеЗаказы
	|			ТОГДА ВЫБОР
	|					КОГДА ЕСТЬNULL(ТоварыНаСкладахОстатки.КоличествоОстаток, 0) - ЕСТЬNULL(СобранныеЗаказы.Количество, 0) = 0
	|							ИЛИ ЕСТЬNULL(ТоварыНаСкладахОстатки.КоличествоОстаток, 0) = 0
	|						ТОГДА 0
	|					ИНАЧЕ ТоварыНаСкладахОстатки.СуммаОстаток / ТоварыНаСкладахОстатки.КоличествоОстаток * (ТоварыНаСкладахОстатки.КоличествоОстаток - СобранныеЗаказы.Количество)
	|				КОНЕЦ
	|		ИНАЧЕ ТоварыНаСкладахОстатки.СуммаОстаток
	|	КОНЕЦ КАК Сумма,
	|	ВЫБОР
	|		КОГДА ТоварыНаСкладахОстатки.КоличествоОстаток <= 0
	|				ИЛИ ТоварыНаСкладахОстатки.СуммаОстаток = 0
	|			ТОГДА 0
	|		ИНАЧЕ ТоварыНаСкладахОстатки.СуммаОстаток / ТоварыНаСкладахОстатки.КоличествоОстаток
	|	КОНЕЦ КАК Цена,
	|	СобранныеЗаказы.Количество КАК КоличествоСобрано,
	|	ТоварыВРезервеНаСкладахОстатки.КоличествоОстаток КАК КоличествоРезерв,
	|	ТоварыНаСкладахОстатки.КоличествоОстаток КАК КоличествоОстаток,
	|	НоменклатураСкладскиеЯчейки.Ячейка КАК Ячейка
	|ИЗ
	|	РегистрНакопления.ТоварыНаСкладах.Остатки(
	|			&ДатаОстатков,
	|			ВЫБОР
	|					КОГДА &ИспользуютсяОбщиеСклады
	|						ТОГДА ИСТИНА
	|					ИНАЧЕ Организация = &Организация
	|				КОНЕЦ
	|				И Склад = &Склад
	|				И НЕ Номенклатура.ЭтоГруппа
	|				И ВЫБОР
	|					КОГДА &ОтборПоГруппеНоменклатуры
	|						ТОГДА Номенклатура В ИЕРАРХИИ (&ГруппаНоменклатуры)
	|					ИНАЧЕ ИСТИНА
	|				КОНЕЦ
	|				И ВЫБОР
	|					КОГДА &ОтборПоКатегорииНоменклатуры
	|						ТОГДА Номенклатура.Категория = &КатегорияНоменклатуры
	|					ИНАЧЕ ИСТИНА
	|				КОНЕЦ
	|				И ВЫБОР
	|					КОГДА &ОтборПоПоставщикуНоменклатуры
	|						ТОГДА Номенклатура.Поставщик = &ПоставщикНоменклатуры
	|					ИНАЧЕ ИСТИНА
	|				КОНЕЦ
	|				И ВЫБОР
	|					КОГДА &ОтборПоНоменклатуре
	|						ТОГДА Номенклатура В (&МассивНоменклатуры)
	|					ИНАЧЕ ИСТИНА
	|				КОНЕЦ
	|				И ВЫБОР
	|					КОГДА &ОтборПоЯчейкамНоменклатуры
	|						ТОГДА Номенклатура В (&НоменклатураПоЯчейкам)
	|					ИНАЧЕ ИСТИНА
	|				КОНЕЦ) КАК ТоварыНаСкладахОстатки
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			СобранныеЗаказы.Организация КАК Организация,
	|			СобранныеЗаказы.Склад КАК Склад,
	|			СобранныеЗаказы.Номенклатура КАК Номенклатура,
	|			СобранныеЗаказы.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	|			СобранныеЗаказы.СерияНоменклатуры КАК СерияНоменклатуры,
	|			СУММА(СобранныеЗаказы.Количество) КАК Количество
	|		ИЗ
	|			(ВЫБРАТЬ
	|				ВТ_ЗаказыСобранные.Организация КАК Организация,
	|				ВТ_ЗаказыСобранные.Склад КАК Склад,
	|				ВТ_ЗаказыСобранные.Номенклатура КАК Номенклатура,
	|				ВТ_ЗаказыСобранные.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	|				ВЫБОР
	|					КОГДА ЕСТЬNULL(ВТ_ЗаказыСобранные.Количество, 0) > ЕСТЬNULL(ВТ_ЗаказыСобранные.КоличествоВРеализациях, 0)
	|						ТОГДА ЕСТЬNULL(ВТ_ЗаказыСобранные.Количество, 0) - ЕСТЬNULL(ВТ_ЗаказыСобранные.КоличествоВРеализациях, 0)
	|					ИНАЧЕ 0
	|				КОНЕЦ КАК Количество,
	|				ВТ_ЗаказыСобранные.СерияНоменклатуры КАК СерияНоменклатуры
	|			ИЗ
	|				ВТ_ЗаказыСобранные КАК ВТ_ЗаказыСобранные
	|			
	|			ОБЪЕДИНИТЬ ВСЕ
	|			
	|			ВЫБРАТЬ
	|				ВТ_ЗаказыЧастиноСобранные.Организация,
	|				ВТ_ЗаказыЧастиноСобранные.Склад,
	|				ВТ_ЗаказыЧастиноСобранные.Номенклатура,
	|				ВТ_ЗаказыЧастиноСобранные.ХарактеристикаНоменклатуры,
	|				ВТ_ЗаказыЧастиноСобранные.Количество,
	|				ВТ_ЗаказыЧастиноСобранные.СерияНоменклатуры
	|			ИЗ
	|				ВТ_ЗаказыЧастиноСобранные КАК ВТ_ЗаказыЧастиноСобранные) КАК СобранныеЗаказы
	|		
	|		СГРУППИРОВАТЬ ПО
	|			СобранныеЗаказы.Организация,
	|			СобранныеЗаказы.Склад,
	|			СобранныеЗаказы.Номенклатура,
	|			СобранныеЗаказы.ХарактеристикаНоменклатуры,
	|			СобранныеЗаказы.СерияНоменклатуры) КАК СобранныеЗаказы
	|		ПО ТоварыНаСкладахОстатки.Номенклатура = СобранныеЗаказы.Номенклатура
	|			И ТоварыНаСкладахОстатки.ХарактеристикаНоменклатуры = СобранныеЗаказы.ХарактеристикаНоменклатуры
	|			И (СобранныеЗаказы.СерияНоменклатуры = ТоварыНаСкладахОстатки.СерияНоменклатуры)
	|			И ТоварыНаСкладахОстатки.Организация = СобранныеЗаказы.Организация
	|			И ТоварыНаСкладахОстатки.Склад = СобранныеЗаказы.Склад
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыВРезервеНаСкладах.Остатки(
	|				&ДатаОстатков,
	|				ВЫБОР
	|						КОГДА &ИспользуютсяОбщиеСклады
	|							ТОГДА ИСТИНА
	|						ИНАЧЕ Организация = &Организация
	|					КОНЕЦ
	|					И Склад = &Склад
	|					И НЕ Номенклатура.ЭтоГруппа
	|					И ВЫБОР
	|						КОГДА &ОтборПоГруппеНоменклатуры
	|							ТОГДА Номенклатура В ИЕРАРХИИ (&ГруппаНоменклатуры)
	|						ИНАЧЕ ИСТИНА
	|					КОНЕЦ
	|					И ВЫБОР
	|						КОГДА &ОтборПоКатегорииНоменклатуры
	|							ТОГДА Номенклатура.Категория = &КатегорияНоменклатуры
	|						ИНАЧЕ ИСТИНА
	|					КОНЕЦ
	|					И ВЫБОР
	|						КОГДА &ОтборПоПоставщикуНоменклатуры
	|							ТОГДА Номенклатура.Поставщик = &ПоставщикНоменклатуры
	|						ИНАЧЕ ИСТИНА
	|					КОНЕЦ
	|					И ВЫБОР
	|						КОГДА &ОтборПоНоменклатуре
	|							ТОГДА Номенклатура В (&МассивНоменклатуры)
	|						ИНАЧЕ ИСТИНА
	|					КОНЕЦ
	|					И ВЫБОР
	|						КОГДА &ОтборПоЯчейкамНоменклатуры
	|							ТОГДА Номенклатура В (&НоменклатураПоЯчейкам)
	|						ИНАЧЕ ИСТИНА
	|					КОНЕЦ) КАК ТоварыВРезервеНаСкладахОстатки
	|		ПО ТоварыНаСкладахОстатки.Номенклатура = ТоварыВРезервеНаСкладахОстатки.Номенклатура
	|			И ТоварыНаСкладахОстатки.ХарактеристикаНоменклатуры = ТоварыВРезервеНаСкладахОстатки.ХарактеристикаНоменклатуры
	|			И ТоварыНаСкладахОстатки.СерияНоменклатуры = ТоварыВРезервеНаСкладахОстатки.СерияНоменклатуры
	|			И ТоварыНаСкладахОстатки.Организация = ТоварыВРезервеНаСкладахОстатки.Организация
	|			И ТоварыНаСкладахОстатки.Склад = ТоварыВРезервеНаСкладахОстатки.Склад
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура.СкладскиеЯчейки КАК НоменклатураСкладскиеЯчейки
	|		ПО (&Склад = НоменклатураСкладскиеЯчейки.Склад)
	|			И ТоварыНаСкладахОстатки.Номенклатура = НоменклатураСкладскиеЯчейки.Ссылка";
	//nva---
	
	
	//Запрос.УстановитьПараметр("ДатаОстатков", ДатаОстатков(Объект.Дата));  
	Запрос.УстановитьПараметр("ДатаОстатков",Новый МоментВремени(Объект.Дата, Объект.Ссылка)); //nva
	Запрос.УстановитьПараметр("Организация",Объект.Организация);
	Запрос.УстановитьПараметр("Склад",Объект.Склад);
	Запрос.УстановитьПараметр("ГруппаНоменклатуры", ГруппаНоменклатуры);  
	Запрос.УстановитьПараметр("КатегорияНоменклатуры", КатегорияНоменклатуры); //nva 
	Запрос.УстановитьПараметр("НоменклатураПоЯчейкам", НоменклатураПоЯчейкам); //nva
	Запрос.УстановитьПараметр("ОтборПоГруппеНоменклатуры", ГруппаНоменклатуры <> Неопределено);
	Запрос.УстановитьПараметр("ОтборПоКатегорииНоменклатуры", КатегорияНоменклатуры <> Неопределено);  //nva
	Запрос.УстановитьПараметр("ОтборПоПоставщикуНоменклатуры", ПоставщикНоменклатуры <> Неопределено);  //nva
	Запрос.УстановитьПараметр("ОтборПоЯчейкамНоменклатуры", ЯчейкиНоменклатуры <> Неопределено);  //nva
	Запрос.УстановитьПараметр("ИсключитьСобранныеЗаказы", ИсключитьСобранныеЗаказы);  //nva
	Запрос.УстановитьПараметр("ПоставщикНоменклатуры", ПоставщикНоменклатуры);  //nva
	Запрос.УстановитьПараметр("МассивНоменклатуры", МассивНоменклатуры);
	Запрос.УстановитьПараметр("ОтборПоНоменклатуре", МассивНоменклатуры <> Неопределено);
	Запрос.УстановитьПараметр("ИспользуютсяОбщиеСклады", Константы.ОбщиеСклады.Получить());

	ТЗ_Результат = Запрос.Выполнить().Выгрузить();
	Если РежимЗаполнения = "Добавление" Тогда	
		// добавляем
		Для каждого СтрокаТЗ из ТЗ_Результат Цикл
			Если СтрокаТЗ.Количество = 0 Тогда
				Продолжить;
			КонецЕсли;
			
			НоваяСтрока = Объект.Товары.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТЗ);
			НоваяСтрока.ЕдиницаИзмерения = ОбщийМодульВызовСервера.ПолучитьБазовуюЕдиницуИзмеренияНоменклатуры(НоваяСтрока.Номенклатура);
			НоваяСтрока.Коэффициент = 1;
			
		КонецЦикла;
	Иначе
		// обновляем
		Для каждого СтрокаТабличнойЧасти из Объект.Товары Цикл
			НайденныеСтроки = ТЗ_Результат.НайтиСтроки(Новый Структура("Номенклатура,ХарактеристикаНоменклатуры,СерияНоменклатуры",
										СтрокаТабличнойЧасти.Номенклатура,СтрокаТабличнойЧасти.ХарактеристикаНоменклатуры,СтрокаТабличнойЧасти.СерияНоменклатуры));
			Если НайденныеСтроки.Количество() > 0 Тогда
				Если РежимЗаполнения = "ЗаполнениеСуммыКоличества" Тогда							
					СтрокаТабличнойЧасти.Количество = НайденныеСтроки[0].Количество;
				КонецЕсли;
				СтрокаТабличнойЧасти.Цена = НайденныеСтроки[0].Цена;
				СтрокаТабличнойЧасти.Сумма = НайденныеСтроки[0].Сумма;
			Иначе
				Если РежимЗаполнения = "ЗаполнениеСуммыКоличества" Тогда
					СтрокаТабличнойЧасти.Количество = 0;
				КонецЕсли;
				СтрокаТабличнойЧасти.Цена = 0;
				СтрокаТабличнойЧасти.Сумма = 0;
			КонецЕсли;
			Если СтрокаТабличнойЧасти.КоличествоФакт > 0 Тогда
				СтрокаТабличнойЧасти.КоличествоОтклонение = СтрокаТабличнойЧасти.КоличествоФакт - СтрокаТабличнойЧасти.Количество;
				//#16197
				//СтрокаТабличнойЧасти.СуммаФакт = СтрокаТабличнойЧасти.КоличествоФакт * СтрокаТабличнойЧасти.Цена;				
				РассчитатьСуммуФакт(СтрокаТабличнойЧасти);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

