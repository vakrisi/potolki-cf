#Область СлужебныеФункцииПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	УсловноеОформление.Элементы.Очистить();

	//Подсветка операции Отмена
	Элемент = УсловноеОформление.Элементы.Добавить();

	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.ВидОперации.Имя);
	
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.ВидОперации");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Перечисления.ВидыОперацийУстановкиИндивидуальныхЦен.Отмена;

	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветФона", WebЦвета.Персиковый);
	
	// подсветка пересекающихся диапазонов
	Элемент = УсловноеОформление.Элементы.Добавить();
	Элемент.Представление = "Пересекающиеся диапазоны";
	
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных("Углы");
	
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.Углы.ЕстьПересечение");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Истина;
	
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветФона", WebЦвета.ЛососьСветлый);
	
КонецПроцедуры

&НаСервере
Функция УстановитьВидимость()
	
	Элементы.ГруппаВкладкиДокумента.Видимость = НЕ Объект.ВидОперации = Перечисления.ВидыОперацийУстановкиИндивидуальныхЦен.Отмена;	
	Элементы.СпособУточненияЦены.Видимость = НЕ Объект.ВидОперации = Перечисления.ВидыОперацийУстановкиИндивидуальныхЦен.Отмена;
	Элементы.ГруппаВкладкиДокумента.ТекущаяСтраница = ?(СпособУточненияЦены = 0, Элементы.ВкладкаЦеныУслугРаскроя, Элементы.ВкладкаДругойВидЦены);
	
КонецФункции

