#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
		
	Если Параметры.Ключ.Пустая() Тогда
	Иначе
		ЭтаФорма.ТолькоПросмотр = ПраваПользователей.ДокументТолькоПросмотр(Объект.Ссылка);
	КонецЕсли;
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	ПраваПользователей.УстановитьТолькоПросмотрДляРеквизитаНомер(Элементы.Номер.ТолькоПросмотр);
	
	СпособУточненияЦены = ?(Объект.ВидЦеныНаУслугиПроизводства.Пустая(), 0, 1);
	
	УстановитьВидимость();
	
	УстановитьУсловноеОформление();
	
	// Видимость колонки Артикул
	МассивЭлементов = новый Массив();
	МассивЭлементов.Добавить("УглыНоменклатураАртикул");
	МассивЭлементов.Добавить("ВырезыApplyНоменклатураАртикул");
	МассивЭлементов.Добавить("ФотопечатьНоменклатураАртикул");
	МассивЭлементов.Добавить("ДлинаШвовНоменклатураАртикул");
	МассивЭлементов.Добавить("ДлинаШвовМногофактурныйНоменклатураАртикул");
	МассивЭлементов.Добавить("ДлинаПользовательскихШвовНоменклатураАртикул");
	МассивЭлементов.Добавить("ВнутренниеВырезыНоменклатураАртикул");
	МассивЭлементов.Добавить("КривыеНоменклатураАртикул");
	ОбщийМодульСервер.УстановитьВидимостьКолонкиАртикулВТабличнойЧасти(ЭтаФорма, МассивЭлементов);
	
	ФинансыСервер.ОбновитьВидимостьИКурсВалюты(ЭтотОбъект);
	
	//#12301
	Элементы.ВариантОценкиВнутренниеВырезы.Доступность = Ложь;
	Элементы.ВариантОценкиВырезыApply.Доступность = Ложь;
	Элементы.ВариантОценкиДлинаПользовательскихШвов.Доступность = Ложь;
	Элементы.ВариантОценкиДлинаШвов.Доступность = Ложь;
	Элементы.ВариантОценкиДлинаШвовМногофактурный.Доступность = Ложь;
	Элементы.ВариантОценкиКривые.Доступность = Ложь;
	Элементы.ВариантОценкиУглы.Доступность = Ложь;
	Элементы.ВариантОценкиФотопечать.Доступность = Ложь;
	
	ОбщийМодульКлиентСервер.ЗаполнитьПризнакПересеченияИнтерваловВЦенахНаУслугиПроизводства(Объект.Углы);
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	ДатыЗапретаИзменения.ОбъектПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	Если СпособУточненияЦены = 1 
		И Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийУстановкиИндивидуальныхЦен.Установка")
		И НЕ ЗначениеЗаполнено(Объект.ВидЦеныНаУслугиПроизводства) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не заполнено поле ""Вид цены на услуги производства""!", 
					, "Объект.ВидЦеныНаУслугиПроизводства", , Отказ); 
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	ОбщийМодульКлиентСервер.ЗаполнитьПризнакПересеченияИнтерваловВЦенахНаУслугиПроизводства(Объект.Углы);
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
		
КонецПроцедуры

#КонецОбласти

