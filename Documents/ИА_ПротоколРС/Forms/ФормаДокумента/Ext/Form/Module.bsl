
&НаКлиенте
Процедура НеОдобреноПредседателемИСПриИзменении(Элемент)
    Если Объект.НеОдобреноПредседателемИС Тогда
        Объект.ОдобреноПредседателемИС = Ложь;
        Пользователь = ИА_БФС.ТекущийПользователь();
        Если ИА_БФКС.РеквизитЕсть(Пользователь,"ФизЛицо") Тогда
            Объект.ОдобрилОтклонил = Пользователь.ФизЛицо;
        КонецЕсли;
        Иначе Объект.ОдобрилОтклонил = ПредопределенноеЗначение("Справочник.ФизическиеЛица.ПустаяСсылка");
    КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОдобреноПредседателемИСПриИзменении(Элемент)
    Если Объект.ОдобреноПредседателемИС Тогда
        Объект.НеОдобреноПредседателемИС = Ложь;
        Пользователь = ИА_БФС.ТекущийПользователь();
        Если ИА_БФКС.РеквизитЕсть(Пользователь,"ФизЛицо") Тогда
            Объект.ОдобрилОтклонил = Пользователь.ФизЛицо;
        КонецЕсли;
        Иначе Объект.ОдобрилОтклонил = ПредопределенноеЗначение("Справочник.ФизическиеЛица.ПустаяСсылка");
    КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если ЗначениеЗаполнено(Параметры.ЗначениеКопирования) Тогда
		Сообщить("Протоколы РС запрещено копировать");
		Отказ = истина;
		Возврат;
	КонецЕсли;
	
	ПостРекСовет = Константы.ИА_ПостРекСовет.Получить();
	
	Если Объект.Ссылка.Пустая() и Объект.БоевойПлан.Количество() = 0 Тогда
		НачальноеЗаполнение();
	Иначе
		УстановитьДатуНачала();
	КонецЕсли;
	
	ЗаполнитьБоевойПланПредыдущий();
	
	СоздатьЭлементыПрисутствуют();
	
	ИА_КСУОбщийСервер.СделатьКнопкуОсновной(Элементы.ГруппаКП);
	
	СокрВид = Константы.КСУ_СокращенныйВидПлана.Получить();
	ВидГруппировки = константы.КСУ_ГруппировкаЗадачПлана.Получить();

	Если СокрВид Тогда
		Элементы.ДеревоПланаПродукт.Видимость = ложь;
		Элементы.ДеревоПланаСрокИсполнения.Видимость = ложь;
		Элементы.ДеревоПланаВремяФакт.Видимость = ложь;
		Элементы.ДеревоПланаСодержание.Заголовок = "Задача";
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура СоздатьЭлементыПрисутствуют()
	УдРекв = новый массив;
	для сч = 0 по 20 Цикл
		попытка 
			з = ЭтаФорма["ПрисутствРук_"+сч];
			УдРекв.Добавить("ПрисутствРук_"+сч);
			Элементы.Удалить(элементы["ПрисутствРукЭл_"+сч]);
		Исключение
			Прервать;
		КонецПопытки;
	КонецЦикла;
	ИзменитьРеквизиты(,УдРекв);
	
	ТекНомер = 0;	
	Для каждого стр из объект.ПрисутствиеРуководителей Цикл
		// реквизит
		ИмяРеквЭл = "ПрисутствРук_"+ТекНомер;
		МассивРеквизитов = Новый Массив;
		МассивРеквизитов.Добавить(Новый РеквизитФормы(ИмяРеквЭл, Новый ОписаниеТипов("Булево")));
		ИзменитьРеквизиты(МассивРеквизитов);
		ЭтаФорма[ИмяРеквЭл]= стр.Присутствует;
		
		// элементы
		НовыйЭлементКоммент = Элементы.Добавить("ПрисутствРукЭл_"+ТекНомер, Тип("ПолеФормы"), Элементы.ГруппаПрисутствие);
		НовыйЭлементКоммент.Вид = ВидПоляФормы.ПолеФлажка;
		НовыйЭлементКоммент.путьКДанным = ИмяРеквЭл;
		НовыйЭлементКоммент.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Лево;
		НовыйЭлементКоммент.Заголовок = стр.Отделение.КраткоеНаименование;
		//
		ТекНомер = ТекНомер + 1;
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура УстановитьДатуНачала()
	Если Объект.БоевойПлан.Количество()> 0 И ЗначениеЗаполнено(Объект.БоевойПлан[0].План) Тогда
		ДатаНачала = НачалоДня(Объект.БоевойПлан[0].План.ДатаНачала);	
	Иначе
		ДатаНачала = ТекущаяДата();
	КонецЕсли;
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьЗначениеСтатистики(ВидСтатистики, ДатаНачала)
	
	ДатаНач = НачалоДня(ДатаНачала) - 60*60*24*7;
	ДатаКон = НачалоДня(ДатаНачала) - 1;
	
	Данные = Новый ТаблицаЗначений;
	Данные.Колонки.Добавить("ДатаНачала");
	Данные.Колонки.Добавить("ДатаКонца");
	Новстр = Данные.Добавить();
	Новстр.ДатаНачала = ДатаНач;
	Новстр.ДатаКонца = ДатаКон;
	СтрокаСтатистик = Новый Структура("ВидСтатистики,Аналитика1,Аналитика2,Аналитика3,Данные",ВидСтатистики, Неопределено, Неопределено, Неопределено,Данные);
	
	ТЗ = ИА_Защита_Статистика.ПолучитьТЗДанныеСтатистики(СтрокаСтатистик,ДатаНач,ДатаКон);
	
	возврат тз.Итог("Количество");	
КонецФункции

&НаСервере
Функция ПолучитьПланОтделения(пОтделение, ДоДаты = Неопределено)
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	ИА_ПланыДействий.Ссылка
	               |ИЗ
	               |	Справочник.ИА_ПланыДействий КАК ИА_ПланыДействий
	               |ГДЕ
	               |	ИА_ПланыДействий.Пост = &Пост
	               |	И ИА_ПланыДействий.ПометкаУдаления = ЛОЖЬ
	               |	И ИА_ПланыДействий.Родитель = &Родитель
	               |	И (ИА_ПланыДействий.ДатаНачала >= &ДатаНачала
	               |			ИЛИ &ДоДаты <> НЕОПРЕДЕЛЕНО)
	               |	И (ИА_ПланыДействий.ДатаНачала < &ДоДаты
	               |			ИЛИ &ДоДаты = НЕОПРЕДЕЛЕНО)
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ИА_ПланыДействий.ДатаНачала УБЫВ";
	Запрос.УстановитьПараметр("Пост", пОтделение);
	Запрос.УстановитьПараметр("ДатаНачала", Объект.Дата - 60*60*24*5);
	Запрос.УстановитьПараметр("ДоДаты", ДоДаты);
	Запрос.УстановитьПараметр("Родитель", Справочники.ИА_ПланыДействий.ПустаяСсылка());
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	Иначе
		Возврат Справочники.ИА_ПланыДействий.ПустаяСсылка();
	КонецЕсли;
КонецФункции	
	
&НаСервере
Процедура НачальноеЗаполнение()
	СтатистикиПоОтделам = Константы.ИА_ПротоколРССтатистикиПоОтделам.Получить();
	ПланыПоОтделам = Константы.ИА_ПротоколРСПланыПоОтделам.Получить();
	
	Объект.Дата = ТекущаяДата();
	
	Если ПостРекСовет.Пустая() ТОгда
		Сообщить("Заполните константу Пост Рекомендательный совет!");
	Иначе
		// председатель
		Если ПостРекСовет.Сотрудники.Количество()>0 Тогда
			Объект.Председатель = ПостРекСовет.Сотрудники[0].ФизЛицо;
		КонецЕсли;
		
		//статистика
		Если ПостРекСовет.НастройкаСтатистик.Статистики.Количество()>0 Тогда
			Объект.СтатистикаРС = ПостРекСовет.НастройкаСтатистик.Статистики[0].ВидСтатистики;
		КонецЕсли;
	КонецЕсли;
	
	// отделения, боевые планы
	организация = объект.Организация;
	
	Если Организация.Пустая() Тогда
		организация = ПостРекСовет; 
		Пока не организация.Родитель.Пустая() Цикл
			организация = организация.Родитель;
		КонецЦикла;
	КонецЕсли;
	
	Объект.ПрисутствиеРуководителей.Очистить();
	Объект.БоевойПлан.Очистить();
	Объект.ГлавныеСтатистики.Очистить();
	Если Организация.Пустая() Тогда
		Возврат;
	Иначе
		объект.Организация = организация; 
	КонецЕсли;
		
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ОргСхема.Ссылка
	               |ИЗ
	               |	Справочник.ОргСхема КАК ОргСхема
	               |ГДЕ
	               |	ОргСхема.Ссылка В ИЕРАРХИИ(&организация)
	               |	И ОргСхема.ТипТерминала = &Отдел
	               |	И ОргСхема.ПометкаУдаления = ЛОЖЬ
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ОргСхема.Родитель.ПорядокВСхеме,
	               |	ОргСхема.ПорядокВСхеме";
	Запрос.УстановитьПараметр("организация", организация);
	Запрос.УстановитьПараметр("Отдел", Перечисления.ТипТерминалаОргСхемы.Отдел);
	
	массивОтделов = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
	// список руководителей
	Запрос.Текст = "ВЫБРАТЬ
	               |	ОргСхема.Ссылка
	               |ИЗ
	               |	Справочник.ОргСхема КАК ОргСхема
	               |ГДЕ
	               |	ОргСхема.Ссылка В ИЕРАРХИИ(&организация)
	               |	И ОргСхема.ТипТерминала = &Отделение
	               |	И ОргСхема.ПометкаУдаления = ЛОЖЬ
	               |	И ОргСхема.Родитель.ТипТерминала <> &Учредитель
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ОргСхема.ПорядокВСхеме";
	Запрос.УстановитьПараметр("организация", организация);
	Запрос.УстановитьПараметр("Отделение", Перечисления.ТипТерминалаОргСхемы.Департамент);
	Запрос.УстановитьПараметр("Учредитель", Перечисления.ТипТерминалаОргСхемы.Учредитель);
	
	массивОтделений = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
	Для каждого стрОтд из массивОтделений Цикл
		Новстр = Объект.ПрисутствиеРуководителей.Добавить();
		Новстр.Отделение = стрОтд;
	КонецЦикла;	
	
	//БП
	ИсточникПланов = ?(ПланыПоОтделам, массивОтделов, массивОтделений);
	Для каждого стрОтд из ИсточникПланов Цикл
		Новстр = Объект.БоевойПлан.Добавить();
		Новстр.Отделение = стрОтд;
		план = ПолучитьПланОтделения(стрОтд);
		Новстр.План = план;		
	КонецЦикла;
	
	
	// статистики
	ИсточникПланов = ?(СтатистикиПоОтделам, массивОтделов, массивОтделений);
	Для каждого стрОтд из ИсточникПланов Цикл
		план = ПолучитьПланОтделения(стрОтд);
		
		//
		МассивСтрок = Новый Массив;
		МассивСтрок.Добавить(0);
		ТЗСтат = стрОтд.НастройкаСтатистик.Статистики.Выгрузить();
		ТЗСтат.Свернуть("ВидСтатистики");
		
		Для каждого стрСтатистика из ТЗСтат Цикл
			Новстр = Объект.ГлавныеСтатистики.Добавить();
			Новстр.Отделение = стрОтд;
			Новстр.ВидСтатистики = стрСтатистика.ВидСтатистики;
			
			Если ЗначениеЗаполнено(план) Тогда
				стрПлан = план.План.Найти(стрСтатистика.ВидСтатистики);
				Если ЗначениеЗаполнено(стрПлан) Тогда
					Новстр.ТекущееЗначениеСтатистики = стрПлан.ТекущееЗначениеСтатистики;			
					Новстр.Квота = стрПлан.КвотаПлан;
				КонецЕсли;
			КонецЕсли;
			Прервать;//будет только первый элемент
		КонецЦикла;
		
		Если ТЗСтат.Количество() = 0 Тогда
			Новстр = Объект.ГлавныеСтатистики.Добавить();
			Новстр.Отделение = стрОтд;
		КонецЕсли;
	КонецЦикла;
	
	// пред план организации
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ИА_ПротоколРС.Ссылка КАК Ссылка
	               |ИЗ
	               |	Документ.ИА_ПротоколРС КАК ИА_ПротоколРС
	               |ГДЕ
	               |	ИА_ПротоколРС.Проведен
	               |	И ИА_ПротоколРС.Дата < &Дата
	               |	И ИА_ПротоколРС.Организация = &Организация
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ИА_ПротоколРС.Дата УБЫВ";
	Запрос.УстановитьПараметр("Дата", ?(объект.Дата=дата(1,1,1), ТекущаяДата(), объект.Дата));
	Запрос.УстановитьПараметр("Организация", Организация);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если выборка.Следующий() Тогда
		Объект.ПредыдущийПротокол = Выборка.Ссылка;
		объект.БоевойПланОрганизацииПредыдущий.Загрузить(Выборка.Ссылка.БоевойПланОрганизации.Выгрузить());
		
		// статистики
		предКвоты = Выборка.Ссылка.ГлавныеСтатистики.Выгрузить();
		Для каждого стрПредКв из предКвоты Цикл
			СтруктПоиска = Новый Структура("Отделение,ВидСтатистики",стрПредКв.Отделение,стрПредКв.ВидСтатистики);
			НСтр = Объект.ГлавныеСтатистики.НайтиСтроки(СтруктПоиска);
			Для каждого стрТекСт из НСтр Цикл
				стрТекСт.ПредыдущаяКвота =  стрПредКв.Квота;
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;

	
	Если ЗначениеЗаполнено(Объект.СтатистикаРС) Тогда
		УстановитьДатуНачала();

		Объект.ЗначениеСтатистики = ПолучитьЗначениеСтатистики(Объект.СтатистикаРС, ДатаНачала);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьИтогиПоШагам()
	ВремяИтого = Дата(1,1,1);
	ВремяИтогоФакт = Дата(1,1,1);
	Для каждого стр из ДеревоПлана.ПолучитьЭлементы() Цикл  // шаги, типы		
		Итог11 = Дата(1,1,1);
		Итог11Ф = Дата(1,1,1);
		Для каждого стр1 из стр.ПолучитьЭлементы() Цикл // задачи
			ВремяИтого = СложитьВремя(ВремяИтого , стр1.ВремяПлан);  
			ВремяИтогоФакт = СложитьВремя(ВремяИтогоФакт , стр1.ВремяФакт);  
			
			Итог11 = СложитьВремя(Итог11 , стр1.ВремяПлан);
			Итог11Ф = СложитьВремя(Итог11Ф , стр1.ВремяФакт);
		КонецЦикла;
		стр.ВремяПлан = ФорматИтога(Итог11);
		стр.ВремяФакт = ФорматИтога(Итог11Ф);
	КонецЦикла;
	
	время = ФорматИтога(ВремяИтого);
	ВремяФакт = ФорматИтога(ВремяИтогоФакт);

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ФорматИтога(д1)
	
	Если д1 = дата(1,1,1) Тогда
		возврат "";
	КонецЕсли;
	
	КолЧасов = (День(д1)-1)*24 + Час(д1);
	возврат формат(КолЧасов,"ЧЦ=2; ЧН=; ЧВН=")+":"+формат(Минута(д1),"ЧЦ=2; ЧН=; ЧВН=");
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция СложитьВремя(в1, в2)
	Если не ЗначениеЗаполнено(в2) Тогда
		возврат в1;
	КонецЕсли;
	
	возврат в1 + (в2 - Дата(1,1,1));
КонецФункции

&НаКлиенте
Процедура БоевойПланПриАктивизацииСтроки(Элемент)
	Если Элементы.БоевойПлан.ТекущаяСтрока = ПредИДСтрокиБП И Элемент <> Неопределено Тогда  // обход глюка 1с с повторным вызовом активизации строки
		возврат;
	КонецЕсли;
	
	тд = Элементы.БоевойПлан.ТекущиеДанные;
	ПредИДСтрокиБП = Элементы.БоевойПлан.ТекущаяСтрока;
	
	ДеревоПлана.ПолучитьЭлементы().Очистить();
	Если тд<>Неопределено и ЗначениеЗаполнено(тд.Отделение) и ЗначениеЗаполнено(тд.План) Тогда
		ЗагрузитьПлан(тд.План, тд.Отделение);
	КонецЕсли;
	
	ОбновитьИтогиПоШагам();
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьПлан(План, пост)
	ДерРез = РеквизитФормыВЗначение("ДеревоПлана");
	
	ИА_Защита_БП.ПолучитьДеревоПлана(ДерРез, План, План.Состояние,,пост);
			
	ЗначениеВРеквизитФормы(ДерРез, "ДеревоПлана");
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ПредИДСтрокиБП = 10000;
