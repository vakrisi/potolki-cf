Функция ПечатьНовогоПротоколаНаСервере()
	
	
	ТабДок = Новый ТабличныйДокумент;	
	
	Макет = РеквизитФормыВЗначение("Объект").ПолучитьМакет("МакетНовый");

	ОбластьМакета = Макет.ПолучитьОбласть("Шапка");
	ОбластьМакета.Параметры.Заполнить(Объект);
	ТабДок.Вывести(ОбластьМакета);
	
	первый = истина;
    Для Каждого Стр Из Объект.ПрисутствиеРуководителей Цикл    
                
        ОбластьМакета = Макет.ПолучитьОбласть("Область2|Область1");
        ОбластьМакета.Параметры.Присутствует = Стр.Присутствует;
        ОбластьМакета.Параметры.Отделение = Стр.Отделение.КраткоеНаименование;
        
		Если первый Тогда
			ТабДок.Вывести(ОбластьМакета);                     
        Иначе 
           	ТабДок.Присоединить(ОбластьМакета); 
        КонецЕсли;  
		
		первый = ложь;
    КонецЦикла;
    
    ОбластьМакета = Макет.ПолучитьОбласть("Блок1");
	ОбластьМакета.Параметры.Заполнить(Объект);
	ТабДок.Вывести(ОбластьМакета);
        
	ОбластьМакета = Макет.ПолучитьОбласть("Блок2Шапка");
	ОбластьМакета.Параметры.Заполнить(Объект);
	ТабДок.Вывести(ОбластьМакета);
	
	ОбластьМакета = Макет.ПолучитьОбласть("Блок2Строка");
	Для Каждого Стр Из Объект.ГлавныеСтатистики Цикл
		ОбластьМакета.Параметры.Заполнить(Стр);
		ОбластьМакета.Параметры.Отделение = Стр.Отделение.Наименование;
		ТабДок.Вывести(ОбластьМакета);
	КонецЦикла;
	
	ОбластьМакета = Макет.ПолучитьОбласть("Блок2Подвал");
	ТабДок.Вывести(ОбластьМакета);
		
	ОбластьМакета = Макет.ПолучитьОбласть("Блок3Шапка");
	ТабДок.Вывести(ОбластьМакета);
	
	ОбластьМакета = Макет.ПолучитьОбласть("Блок3Строка");
	Для Каждого Стр Из Объект.ЗапланированныеЗадачиСУ Цикл
		ОбластьМакета.Параметры.Заполнить(Стр);
		ТабДок.Вывести(ОбластьМакета);
	КонецЦикла;
		
	ОбластьМакета = Макет.ПолучитьОбласть("Блок4Шапка");
	ТабДок.Вывести(ОбластьМакета);
	
	ОбластьМакета = Макет.ПолучитьОбласть("Блок4Строка");
	Для Каждого Стр Из Объект.ЗадачиПоТактическимПланам Цикл
		ОбластьМакета.Параметры.Заполнить(Стр);
		ТабДок.Вывести(ОбластьМакета);
	КонецЦикла;
		
	ОбластьМакета = Макет.ПолучитьОбласть("Блок5Шапка");
	ТабДок.Вывести(ОбластьМакета);
	
	ОбластьМакета = Макет.ПолучитьОбласть("Блок5Строка");
	ТЗЗадачиБП = ВернутьПредставлениеБП();
	Для Каждого Стр Из ТЗЗадачиБП Цикл
		ОбластьМакета.Параметры.Заполнить(Стр);
		ТабДок.Вывести(ОбластьМакета);
	КонецЦикла;
	
	ОбластьМакета = Макет.ПолучитьОбласть("Блок6");
	ОбластьМакета.Параметры.Заполнить(Объект);
	ТабДок.Вывести(ОбластьМакета);
	
	ОбластьМакета = Макет.ПолучитьОбласть("Блок7");
	ОбластьМакета.Параметры.Заполнить(Объект);
	ТабДок.Вывести(ОбластьМакета);
	
	ОбластьМакета = Макет.ПолучитьОбласть("Блок8");
    ПоощренияИНаказания = ?(ЗначениеЗаполнено(Объект.Поощряем), Объект.Поощряем,"");
	ОбластьМакета.Параметры.ПоощренияИНаказания = ПоощренияИНаказания;
	ТабДок.Вывести(ОбластьМакета);
	
	ОбластьМакета = Макет.ПолучитьОбласть("Блок9");
	ОбластьМакета.Параметры.Заполнить(Объект);
	ТабДок.Вывести(ОбластьМакета);
	
	ОбластьМакета = Макет.ПолучитьОбласть("Блок10");
	ОбластьМакета.Параметры.Заполнить(Объект);
	ТабДок.Вывести(ОбластьМакета);
	
	ОбластьМакета = Макет.ПолучитьОбласть("Блок11");
	ТабДок.Вывести(ОбластьМакета);
	
	ОбластьМакета = Макет.ПолучитьОбласть("Подвал");
    ОбластьМакета.Параметры.Председатель = Объект.Председатель;
    Если Объект.ОдобреноПредседателемИС Тогда
        ОбластьМакета.Параметры.Одобрил = Объект.ОдобрилОтклонил;
        ОбластьМакета.Параметры.НеОдобрил = "___________________";
    ИначеЕсли Объект.НеОдобреноПредседателемИС Тогда
        ОбластьМакета.Параметры.Одобрил = "___________________";
        ОбластьМакета.Параметры.НеОдобрил = Объект.ОдобрилОтклонил;    
    КонецЕсли; 
	ТабДок.Вывести(ОбластьМакета);
	
	ОбластьМакета = Макет.ПолучитьОбласть("Коррекция");
	ОбластьМакета.Параметры.Заполнить(Объект);
	ТабДок.Вывести(ОбластьМакета);
	
	ТабДок.ПолеСнизу = 10;
	
	ТабДок.ОтображатьЗаголовки = Ложь;
	ТабДок.ОтображатьСетку = Ложь;

	ТабДок.НижнийКолонтитул.НачальнаяСтраница = 1;
	ТабДок.НижнийКолонтитул.ВертикальноеПоложение = ВертикальноеПоложение.Низ;
	ТабДок.НижнийКолонтитул.ТекстСлева = "";
	ТабДок.НижнийКолонтитул.ТекстСправа = "";
	ТабДок.НижнийКолонтитул.ТекстВЦентре = "";
	ТабДок.НижнийКолонтитул.ТекстСправа = "- [&НомерСтраницы] из [&СтраницВсего] -";
	ТабДок.НижнийКолонтитул.Выводить = Истина;
	
	Возврат ТабДок;
		
КонецФункции

&НаСервере
Функция ВернутьПредставлениеБП()
	
	тзПредПланы = РеквизитФормыВЗначение("БоевойПланПредыдущий");
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	тзПредПланы.Отделение,
	|	тзПредПланы.План
	|ПОМЕСТИТЬ тзПредПланы
	|ИЗ
	|	&ТЗПред КАК тзПредПланы
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	тзТекПланы.Отделение,
	|	тзТекПланы.План
	|ПОМЕСТИТЬ тзТекПланы
	|ИЗ
	|	&ТЗТек КАК тзТекПланы
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	тзТекПланы.Отделение КАК ОтдСсылка,
	|	тзТекПланы.План КАК ТекПлан,
	|	тзПредПланы.План КАК ПредПлан
	|ИЗ
	|	тзТекПланы КАК тзТекПланы
	|		ЛЕВОЕ СОЕДИНЕНИЕ тзПредПланы КАК тзПредПланы
	|		ПО тзТекПланы.Отделение = тзПредПланы.Отделение";
	
	Запрос.УстановитьПараметр("ТЗПред", тзПредПланы);
	Запрос.УстановитьПараметр("ТЗТек", Объект.БоевойПлан.Выгрузить());
	
	Выборка = Запрос.Выполнить().Выбрать();	
	ТЗБП = Новый ТаблицаЗначений;
	ТЗБП.Колонки.Добавить("Отделение");
	ТЗБП.Колонки.Добавить("ПланПрошлый");
	ТЗБП.Колонки.Добавить("План");
	
	Пока Выборка.Следующий() Цикл
		Новстр = ТЗБП.Добавить();		
		Новстр.Отделение = Выборка.ОтдСсылка.наименование;
		Если ЗначениеЗаполнено(Выборка.ПредПлан) Тогда
			Новстр.ПланПрошлый = ВернутьЗадачиБП(Выборка.ПредПлан,Истина);
		КонецЕсли;
		Новстр.План = ВернутьЗадачиБП(Выборка.ТекПлан,Ложь);
	КонецЦикла;
	
	Возврат ТЗБП;
КонецФункции

&НаСервереБезКонтекста
Функция ВернутьЗадачиБП(ПланСсылка, ВыгружатьТолькоВыполненные);
	ЗадачиБП = "";
	Шаги = Справочники.ИА_ЗадачиПлана.Выбрать(,ПланСсылка);
	
	Пока Шаги.Следующий() Цикл
		Если не шаги.ПометкаУдаления Тогда
			Если Шаги.Выполнено ИЛИ не ВыгружатьТолькоВыполненные Тогда
				ЗадачиБП = ЗадачиБП + Шаги.Содержание + "; ";
			КонецЕсли;
		КонецЕсли;	
	КонецЦикла;
	Возврат ЗадачиБП;
КонецФункции	

&НаКлиенте
Процедура БоевойПланПланПриИзменении(Элемент)
	тд = Элементы.БоевойПлан.ТекущиеДанные;

	Если тд<>Неопределено и ЗначениеЗаполнено(тд.Отделение) и ЗначениеЗаполнено(тд.План) Тогда
		ЗагрузитьПлан(тд.План, тд.Отделение);
	Иначе
		ДеревоПлана.ПолучитьЭлементы().Очистить();
	КонецЕсли;
	
	ОбновитьИтогиПоШагам();
КонецПроцедуры

&НаСервере
Процедура ОбновитьБПНаСервере()
	Объект.Дата = ТекущаяДата();
	
	// отделения, боевые планы
	организация = ПостРекСовет; 
	Пока не организация.Родитель.Пустая() Цикл
		организация = организация.Родитель;
	КонецЦикла;	
	
	// список руководителей
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ОргСхема.Ссылка
	               |ИЗ
	               |	Справочник.ОргСхема КАК ОргСхема
	               |ГДЕ
	               |	ОргСхема.Ссылка В ИЕРАРХИИ(&организация)
	               |	И ОргСхема.ТипТерминала = &Отделение
	               |	И ОргСхема.ПометкаУдаления = ЛОЖЬ
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ОргСхема.ПорядокВСхеме";
	Запрос.УстановитьПараметр("организация", организация);
	Запрос.УстановитьПараметр("Отделение", Перечисления.ТипТерминалаОргСхемы.Департамент);
	
	массивОтделений = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
	Объект.БоевойПлан.Очистить();
	Для каждого стрОтд из массивОтделений Цикл
		план = ПолучитьПланОтделения(стрОтд);
		Новстр = Объект.БоевойПлан.Добавить();
		Новстр.Отделение = стрОтд;
		Новстр.План = план;		
	КонецЦикла;	
КонецПроцедуры

