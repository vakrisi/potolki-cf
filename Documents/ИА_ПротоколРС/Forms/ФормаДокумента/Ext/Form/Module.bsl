Процедура ЗаполнитьПредыдущиеЗадачи(ПредыдущиеЗадачи, ТекущиеЗадачи)
	
	тз = ТекущиеЗадачи.Выгрузить();
	Для Каждого Стр Из ПредыдущиеЗадачи Цикл
		Если тз.Найти(Стр.Задача) = Неопределено Тогда 
			НовСтр = тз.Добавить();
			ЗаполнитьЗначенияСвойств(НовСтр,Стр);
		КонецЕсли;
	КонецЦикла;
	ТекущиеЗадачи.Загрузить(тз);
	
КонецПроцедуры	
	
