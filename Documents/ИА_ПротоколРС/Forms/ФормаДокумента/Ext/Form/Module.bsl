Процедура ЗаполнитьЗадачиПоТактическимПланам()
	
	Объект.ЗадачиПоТактическимПланам.Очистить();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ИА_ПротоколРС.Ссылка
		|ИЗ
		|	Документ.ИА_ПротоколРС КАК ИА_ПротоколРС
		|ГДЕ
		|	ИА_ПротоколРС.Проведен
		|	И ИА_ПротоколРС.Дата < &ДатаДок
		|
		|УПОРЯДОЧИТЬ ПО
		|	ИА_ПротоколРС.Дата УБЫВ";
		
		ДатаДок = ?(ЗначениеЗаполнено(Объект.Ссылка),Объект.Дата, ТекущаяДата());
		Запрос.УстановитьПараметр("ДатаДок", ДатаДок);
		Запрос.УстановитьПараметр("Ссылка", Объект.Ссылка);
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	ПрошлыйПротокол = Неопределено;
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ПрошлыйПротокол = ВыборкаДетальныеЗаписи.Ссылка;
		Прервать;
	КонецЦикла;
	Для Каждого Стр Из ПрошлыйПротокол.ЗадачиПоТактическимПланам Цикл
		Если Стр.Выполнено И Не ЗначениеЗаполнено(СокрЛП(Стр.ЗадачиНаПредстоящуюНеделю)) Тогда
			Продолжить;
		ИначеЕсли Стр.Выполнено Тогда
			Новстр = Объект.ЗадачиПоТактическимПланам.Добавить();
			ЗаполнитьЗначенияСвойств(Новстр,Стр);
			Новстр.ЗадачиЗаПрошлуюНеделю = Стр.ЗадачиНаПредстоящуюНеделю;
			Новстр.Выполнено = Ложь;
		Иначе
			Новстр = Объект.ЗадачиПоТактическимПланам.Добавить();
			ЗаполнитьЗначенияСвойств(Новстр,Стр);
			Новстр.ЗадачиЗаПрошлуюНеделю = ?(ЗначениеЗаполнено(СокрЛП(Стр.ЗадачиЗаПрошлуюНеделю)),СокрЛП(Стр.ЗадачиЗаПрошлуюНеделю) + ". ","") + Стр.ЗадачиНаПредстоящуюНеделю;
		КонецЕсли;
		Новстр.ЗадачиНаПредстоящуюНеделю = "";
	КонецЦикла;
	
КонецПроцедуры


