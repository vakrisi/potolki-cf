&НаСервере
Функция ПоместитьТекущийФайлВБуфер(ВыбранноеИмя)
	
	КаталогФайлов = ПолучитьПутьКФайлам(объект.Номер);	
	КаталогХранения = КаталогФайлов + ВыбранноеИмя;
	ФайлДляПередачи = Новый ДвоичныеДанные(КаталогХранения);
	
	АдресВременногоХранилища = ПоместитьВоВременноеХранилище(ФайлДляПередачи, УникальныйИдентификатор);
	
	Возврат АдресВременногоХранилища;
	
КонецФункции


&НаКлиенте
Процедура СохранитьФайл(Команда)
	Режим = РежимДиалогаВыбораФайла.Сохранение;
	ДиалогОткрытияФайла = Новый ДиалогВыбораФайла(Режим);
	ДиалогОткрытияФайла.ПолноеИмяФайла = Элементы.Файлы.ТекущиеДанные.Имя;
	ДиалогОткрытияФайла.Заголовок = "Сохранение файла";
	Расширение = Сред(Элементы.Файлы.ТекущиеДанные.Имя,Найти(Элементы.Файлы.ТекущиеДанные.Имя, ".")+1);
	Фильтр = "(*."+ Расширение +")|*."+Расширение+"";
	ДиалогОткрытияФайла.Фильтр = Фильтр;
	ДиалогОткрытияФайла.Расширение = Расширение;	
	Если ДиалогОткрытияФайла.Выбрать() Тогда
		
		ВыбранныйКаталог = Новый Файл(ДиалогОткрытияФайла.Каталог);
		
		АдресВременногоХранилища = ПоместитьТекущийФайлВБуфер(Элементы.Файлы.ТекущиеДанные.Имя);
		ДвоичныеДанные = ПолучитьИзВременногоХранилища(АдресВременногоХранилища);
		
		Попытка
			ДвоичныеДанные.Записать(ДиалогОткрытияФайла.ПолноеИмяФайла);
		Исключение
			Сообщить(ОписаниеОшибки());
		КонецПопытки;
	КонецЕсли;
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьПутьКФайлам(номер)
	Возврат Константы.ИА_КаталогХраненияФайлов.Получить()+"RS\"+номер+"\";
КонецФункции

&НаКлиенте
Процедура ОчиститьПрикрепленныйОбъект(Команда)
	Объект.ПрикрепленныйОбъект = Неопределено;
	Модифицированность = Истина;
	ОбновитьНадписьПрикрОбъекта();
КонецПроцедуры

&НаКлиенте
процедура ОбновитьНадписьПрикрОбъекта()
	Если ЗначениеЗаполнено(Объект.ПрикрепленныйОбъект) ТОгда
		Элементы.ПрикрепленныйОбъект.Заголовок = Объект.ПрикрепленныйОбъект;
	Иначе
		Элементы.ПрикрепленныйОбъект.Заголовок = "Прикрепить элемент справочника, документ";
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПрикрепленныйОбъектНажатие(Элемент)
	Если ЗначениеЗаполнено(Объект.ПрикрепленныйОбъект) Тогда   // просто откроем
		ПоказатьЗначение(,Объект.ПрикрепленныйОбъект);
	Иначе
		ОткрытьФорму("Задача.ИА_ЗадачаПланаДействий.Форма.ФормаВопросаПрикрепленногоОбъекта",,,,,, Новый ОписаниеОповещения("ПрикрепленныйОбъектНажатиеЗавершение", ЭтотОбъект), РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПрикрепленныйОбъектНажатиеЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если ЗначениеЗаполнено(Результат) Тогда
		Объект.ПрикрепленныйОбъект = Результат;
		ОбновитьНадписьПрикрОбъекта();
		Модифицированность = истина;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ЗапланированныеЗадачиСУНомераВыполненныхЗадачПриИзменении(Элемент)
	тд = Элементы.ЗапланированныеЗадачиСУ.ТекущиеДанные;
	тд.ДатаВыполнения = получитьДатуЗавершения(тд.ВыполненнаяЗадача);
КонецПроцедуры

&НаСервереБезКонтекста
Функция получитьДатуЗавершения(задачаСу)
	возврат задачаСу.ДатаВыполнения;
КонецФункции

&НаКлиенте
Процедура ОрганизацияПриИзменении(Элемент)
	НачальноеЗаполнение();
	ЗаполнитьБоевойПланПредыдущий();
	СоздатьЭлементыПрисутствуют();
КонецПроцедуры

&НаСервере
Процедура ОбновитьСтатистикиНаСервере()
	Объект.ГлавныеСтатистики.Очистить();
	Для каждого стрОтд из Объект.БоевойПлан Цикл
		план = стрОтд.план;
		
		МассивСтрок = Новый Массив;
		МассивСтрок.Добавить(0);
		ТЗСтат = стрОтд.Отделение.НастройкаСтатистик.Статистики.Выгрузить();
		ТЗСтат.Свернуть("ВидСтатистики");
		
		Для каждого стрСтатистика из ТЗСтат Цикл
			Новстр = Объект.ГлавныеСтатистики.Добавить();
			Новстр.Отделение = стрОтд.Отделение;
			Новстр.ВидСтатистики = стрСтатистика.ВидСтатистики;
			
			Если ЗначениеЗаполнено(план) Тогда
				стрПлан = план.План.Найти(стрСтатистика.ВидСтатистики);
				Если ЗначениеЗаполнено(стрПлан) Тогда
					Новстр.ТекущееЗначениеСтатистики = стрПлан.ТекущееЗначениеСтатистики;			
					Новстр.Квота = стрПлан.КвотаПлан;
				КонецЕсли;
			КонецЕсли;
			Прервать;//будет только первый элемент
		КонецЦикла;
		
		Если ТЗСтат.Количество() = 0 Тогда
			Новстр = Объект.ГлавныеСтатистики.Добавить();
			Новстр.Отделение = стрОтд;
		КонецЕсли;
	КонецЦикла;
	

	предКвоты = Объект.ПредыдущийПротокол.ГлавныеСтатистики.Выгрузить();
	Для каждого стрПредКв из предКвоты Цикл
		СтруктПоиска = Новый Структура("Отделение,ВидСтатистики",стрПредКв.Отделение,стрПредКв.ВидСтатистики);
		НСтр = Объект.ГлавныеСтатистики.НайтиСтроки(СтруктПоиска);
		Для каждого стрТекСт из НСтр Цикл
			стрТекСт.ПредыдущаяКвота =  стрПредКв.Квота;
		КонецЦикла;
	КонецЦикла;

	
	Если ЗначениеЗаполнено(Объект.СтатистикаРС) Тогда
		Объект.ЗначениеСтатистики = ПолучитьЗначениеСтатистики(Объект.СтатистикаРС, ДатаНачала);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСтатистики(Команда)
	ОбновитьСтатистикиНаСервере();
КонецПроцедуры
