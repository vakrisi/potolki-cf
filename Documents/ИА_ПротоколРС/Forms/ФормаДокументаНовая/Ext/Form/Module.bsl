	ТабДокИтог.НижнийКолонтитул.ТекстСправа = "";
	ТабДокИтог.НижнийКолонтитул.ТекстВЦентре = "- [&НомерСтраницы] из [&СтраницВсего] -";
	ТабДокИтог.НижнийКолонтитул.ТекстСправа = "";
	ТабДокИтог.НижнийКолонтитул.Выводить = Истина;
	
	ТабДокИтог.РазмерСтраницы = "A4";
	ТабДокИтог.УстановитьРастягиваниеПоГоризонтали(Истина);	
	Возврат ТабДокИтог;

КонецФункции

