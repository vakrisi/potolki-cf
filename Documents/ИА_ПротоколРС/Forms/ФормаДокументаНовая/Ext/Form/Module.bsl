	ТабДокИтог.ПолеСнизу = 10;
	ТабДокИтог.ОтображатьЗаголовки = Ложь;
	ТабДокИтог.ОтображатьСетку = Ложь;
	
	ТабДокИтог.НижнийКолонтитул.НачальнаяСтраница = 1;
