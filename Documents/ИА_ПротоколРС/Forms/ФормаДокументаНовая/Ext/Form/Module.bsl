	ОбластьМакета = Макет.ПолучитьОбласть("ТабПланЗадачиШапка");
	ТабДокВрем.Вывести(ОбластьМакета);

	Для Каждого Стр Из Объект.ЗадачиНаНеделю Цикл	
	ОбластьМакета = Макет.ПолучитьОбласть("ТабПланЗадачиСтрока");
	ОбластьМакета.Параметры.Номер = Стр.НомерСтроки ;
	ОбластьМакета.Параметры.Задача = Стр.Задача ;
	ОбластьМакета.Параметры.Пост = Стр.ПостСтрока ;
	ОбластьМакета.Параметры.Срок = Стр.Срок ;
	ТабДокВрем.Вывести(ОбластьМакета);	
	КонецЦикла;	
		
	ОбластьМакета = Макет.ПолучитьОбласть("Комментарии");
	ОбластьМакета.Параметры.Комментарий = Объект.КомментариЗадачи;
	
	Если ТабДокИтог.ПроверитьВывод(ТабДокВрем) Тогда
		ТабДокИтог.Вывести(ТабДокВрем);	
	Иначе
		ТабДокИтог.Вывести(ТабДокВрем);
		ТабДокИтог.ВывестиГоризонтальныйРазделительСтраниц();
		ТабДокИтог = Новый ТабличныйДокумент;
		ТабДокИтог.Присоединить(ТабДокВрем);
	КонецЕсли;


	
	//Восьмая страница
//	ТабДокВрем.Очистить();
	
	ОбластьМакета = Макет.ПолучитьОбласть("ДопПредЗаг");
	ТабДокВрем.Вывести(ОбластьМакета);
	ОбластьМакета = Макет.ПолучитьОбласть("ДопПредТекст");
	ТабДокВрем.Вывести(ОбластьМакета);
	ОбластьМакета = Макет.ПолучитьОбласть("ПустаяСтрока");
	ТабДокВрем.Вывести(ОбластьМакета);
	
	ОбластьМакета = Макет.ПолучитьОбласть("ДопПредПредлож");
	ОбластьМакета.Параметры.Предложения = Объект.ДопПредложения;
	ТабДокВрем.Вывести(ОбластьМакета);
	
	ОбластьМакета = Макет.ПолучитьОбласть("ПустаяСтрока");
	ТабДокВрем.Вывести(ОбластьМакета);

	ОбластьМакета = Макет.ПолучитьОбласть("ВремКонц");
	ОбластьМакета.Параметры.ВремяЗавершения = Объект.ВремяЗавершения;
	ТабДокВрем.Вывести(ОбластьМакета);
	
	Если ТабДокИтог.ПроверитьВывод(ТабДокВрем) Тогда
		ТабДокИтог.Вывести(ТабДокВрем);	
	Иначе
		ТабДокИтог.Вывести(ТабДокВрем);
		ТабДокИтог.ВывестиГоризонтальныйРазделительСтраниц();
		ТабДокИтог = Новый ТабличныйДокумент;
		ТабДокИтог.Присоединить(ТабДокВрем);
