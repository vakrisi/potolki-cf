&НаКлиенте
Процедура ВидНоменклатурыНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	//++ 16338
	// СтандартнаяОбработка = Ложь;
	//-- 16338
	СтарыйВидНоменклатуры = Объект.ВидНоменклатуры;
КонецПроцедуры

&НаКлиенте
Процедура ВидНоменклатурыПриИзменении(Элемент)
	
	Если НЕ СтарыйВидНоменклатуры = Объект.ВидНоменклатуры
		//И (СтарыйВидНоменклатуры = ПредопределенноеЗначение("Справочник.ВидыНоменклатуры.Продукция")
		//	ИЛИ Объект.ВидНоменклатуры = ПредопределенноеЗначение("Справочник.ВидыНоменклатуры.Продукция")) 
			Тогда
		Если Объект.Материалы.Количество() > 0 Тогда
			ТекстВопроса = "Табличная часть с ценами будет очищена. Продолжить?";
			ОписаниеОповещения = Новый ОписаниеОповещения("ВидНоменклатурыПриИзмененииФрагмент", ЭтотОбъект);
			ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
		Иначе
			ВидНоменклатурыПриИзмененииЗавершение();
		КонецЕсли;
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура ВидНоменклатурыПриИзмененииФрагмент(Результат, ДополнительныеПарраметры) Экспорт
	
	Если Не Результат = КодВозвратаДиалога.Да Тогда
		Объект.ВидНоменклатуры = СтарыйВидНоменклатуры; 		
	Иначе 
		Объект.Материалы.Очистить();
		ВидНоменклатурыПриИзмененииЗавершение();		
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура ВидНоменклатурыПриИзмененииЗавершение() 
	
	Если НЕ Объект.ВидНоменклатуры = ПредопределенноеЗначение("Справочник.ВидыНоменклатуры.Продукция") Тогда
		Объект.ВидПродукции = ПредопределенноеЗначение("Справочник.ВидыПродукции.ПустаяСсылка");
		Объект.СпособОпределенияСтоимости = ПредопределенноеЗначение("Перечисление.СпособыОпределенияСтоимостиПродукции.ПустаяСсылка");
	КонецЕсли;
	
	УправлениеФормой();		
		
КонецПроцедуры

&НаКлиенте
Процедура ЦенаСФотопечатьюОтличаетсяПриИзменении(Элемент)
	
	УправлениеФормой();
	
КонецПроцедуры

&НаКлиенте
Процедура ВидПродукцииПриИзменении(Элемент)
	
	Объект.Материалы.Очистить();		
	ВидПродукцииПриИзмененииНаСервере();
	УправлениеФормой();
	
КонецПроцедуры

&НаСервере
Процедура ВидПродукцииПриИзмененииНаСервере()
	
	Если ЗначениеЗаполнено(Объект.ВидПродукции) Тогда
		Объект.СпособОпределенияСтоимости = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.ВидПродукции, "СпособОпределенияСтоимости");
		Если Объект.СпособОпределенияСтоимости = Перечисления.СпособыОпределенияСтоимостиПродукции.ПоПараметрам Тогда
			Для каждого СтрокаТЧ из Объект.ВидПродукции.УчитываемыеПараметрыПродукции Цикл
				НоваяСтрока = Объект.Материалы.Добавить();
	       		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТЧ);
			КонецЦикла;
		КонецЕсли;
	Иначе	
		Объект.СпособОпределенияСтоимости = Перечисления.СпособыОпределенияСтоимостиПродукции.ПустаяСсылка();
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

