&НаКлиенте
Процедура ПослеВыбораПравилОкругления(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПорядокОкругления = Результат.ПорядокОкругления;
	ОкруглятьВБольшуюСторону = Результат.ОкруглятьВБольшуюСторону;	

	ИмяКолонкиЦена = "Цена";
	ИмяКолонкиЦенаФото = "ЦенаСФотопечатью";
	
	Для Каждого ТекущаяСтрока Из Объект.Материалы Цикл
		Если ЗначениеЗаполнено(ТекущаяСтрока[ИмяКолонкиЦена]) И НЕ ЗначениеЗаполнено(ТекущаяСтрока.ВидЦены) Тогда
			ТекущаяСтрока[ИмяКолонкиЦена] = ОбщийМодуль.ОкруглитьЧисло(ТекущаяСтрока[ИмяКолонкиЦена], ПорядокОкругления, ОкруглятьВБольшуюСторону);
		КонецЕсли;
		Если ЭтоПотолокОтрез 
			И ЗначениеЗаполнено(ТекущаяСтрока[ИмяКолонкиЦенаФото]) И НЕ ЗначениеЗаполнено(ТекущаяСтрока.ВидЦеныСФотопечатью) Тогда
			ТекущаяСтрока[ИмяКолонкиЦенаФото] = ОбщийМодуль.ОкруглитьЧисло(ТекущаяСтрока[ИмяКолонкиЦенаФото], ПорядокОкругления, ОкруглятьВБольшуюСторону);
		КонецЕсли;
	КонецЦикла;
		
	Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьЦены(Команда)
	
	Если Объект.Материалы.Количество() = 0 Тогда 
		Сообщить("Таблица пустая, расчет цен не будет выполнен");
		Возврат;
	КонецЕсли;
	
	сз_ВсеВидыЦен = Новый СписокЗначений;
	Для каждого Строка Из ВидыЦен Цикл
		Если НЕ Строка.Запрещенный Тогда
			сз_ВсеВидыЦен.Добавить(Строка.ВидЦены);
		КонецЕсли;
	КонецЦикла;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("УстановкаИндивидуальныхЦенНаПродукцию",	Истина);
	ПараметрыФормы.Вставить("ВсеВидыЦен",			сз_ВсеВидыЦен);
	ПараметрыФормы.Вставить("ИспользуемыеВидыЦен",	Новый СписокЗначений);
	ПараметрыФормы.Вставить("РазрешенныеВидыЦен",	Новый СписокЗначений);
	 
	ОписаниеОповещения = Новый ОписаниеОповещения("РассчитатьЦеныФрагмент", ЭтотОбъект);
	ОткрытьФорму("Документ.УстановкаЦенНоменклатуры.Форма.ФормаРасчетаЦен", ПараметрыФормы, ЭтаФорма, , , , ОписаниеОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьЦеныФрагмент(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
		
	ОписаниеОповещения = Новый ОписаниеОповещения("РассчитатьЦеныЗавершение", ЭтотОбъект, Результат); 
	ТекстВопроса = "Цены будут перерассчитаны. Продолжить?";
	ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьЦеныЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		Модифицированность = Истина;
		РассчитатьЦеныНаСервере(ДополнительныеПараметры);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура РассчитатьЦеныНаСервере(ПараметрыРасчета)
	
	ВидИсходныхДанных = ПараметрыРасчета.ВидИсходныхДанных;
	ИсходныйВидЦен = ПараметрыРасчета.ИсходныйВидЦен;
	ПроцентНаценки = ПараметрыРасчета.ПроцентНаценки;	
	
	ИмяКолонкиПриемник = "Цена";
	ИмяКолонкиПриемникФ = "ЦенаСФотопечатью";
		
	Если ВидИсходныхДанных = 4 Тогда
		
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("ДатаЗапроса",?(Объект.Дата = Дата(1,1,1),ТекущаяДатаСеанса(),Объект.Дата));
		Запрос.УстановитьПараметр("ВидЦены", ИсходныйВидЦен);
		Запрос.УстановитьПараметр("Валюта", Объект.Валюта);
		Запрос.УстановитьПараметр("ВидНоменклатуры", Объект.ВидНоменклатуры);
		Запрос.УстановитьПараметр("ТаблицаДокумента", Объект.Материалы.Выгрузить());
		Запрос.Текст =
		"ВЫБРАТЬ
		|	ТаблицаДокумента.Фактура КАК Фактура,
		|	ТаблицаДокумента.ЦветФактуры КАК ЦветФактуры,
		|	ТаблицаДокумента.Шаблон КАК Шаблон
		|ПОМЕСТИТЬ ВТ_Позиции
		|ИЗ
		|	&ТаблицаДокумента КАК ТаблицаДокумента
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЦеныСрезПоследних.Валюта КАК Валюта,
		|	ЦеныСрезПоследних.ВидЦен КАК ВидЦены,
		|	ЦеныСрезПоследних.Фактура КАК Фактура,
		|	ЦеныСрезПоследних.ЦветФактуры КАК ЦветФактуры,
		|	ЦеныСрезПоследних.Шаблон КАК Шаблон,
		|	ЦеныСрезПоследних.Цена КАК Цена,
		|	ЦеныСрезПоследних.ЦенаСФотопечатью КАК ЦенаСФотопечатью
		|ИЗ
		|	РегистрСведений.ЦеныМатериалов.СрезПоследних(
		|			&ДатаЗапроса,
		|			ВидЦен = &ВидЦены
		|				И Валюта = &Валюта
		|				И ВидНоменклатуры = &ВидНоменклатуры
		|				И (Фактура, ЦветФактуры, Шаблон) В
		|					(ВЫБРАТЬ
		|						ВТ_Позиции.Фактура,
		|						ВТ_Позиции.ЦветФактуры,
		|						ВТ_Позиции.Шаблон
		|					ИЗ
		|						ВТ_Позиции)) КАК ЦеныСрезПоследних";
		ТаблицаИсходныхЦен = Запрос.Выполнить().Выгрузить();
		
		Для Каждого ТекСтрока Из Объект.Материалы Цикл			
			ОтборИсходные = Новый Структура;
			ОтборИсходные.Вставить("Фактура", ТекСтрока.Фактура);
			ОтборИсходные.Вставить("ЦветФактуры", ТекСтрока.ЦветФактуры);
			ОтборИсходные.Вставить("Шаблон", ТекСтрока.Шаблон);
			ТоварыИсходные = ТаблицаИсходныхЦен.НайтиСтроки(ОтборИсходные);
			
			Если ТоварыИсходные.Количество() > 0 Тогда	
				ТекСтрока[ИмяКолонкиПриемник]  = ТоварыИсходные[0].Цена * (1 + ПроцентНаценки/100);
				Если ЭтоПотолокОтрез Тогда
					ТекСтрока[ИмяКолонкиПриемникФ] = ТоварыИсходные[0].ЦенаСФотопечатью * (1 + ПроцентНаценки/100);
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
		
КонецПроцедуры		
		
#КонецОбласти

