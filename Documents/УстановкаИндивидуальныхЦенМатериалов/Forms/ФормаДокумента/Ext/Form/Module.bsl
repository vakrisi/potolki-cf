	ТекущиеДанные.ЦенаСФотопечатью = 0;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеФункцииПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	УсловноеОформление.Элементы.Очистить();

	//Подсветка операции Отмена
	Элемент = УсловноеОформление.Элементы.Добавить();

	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.ВидОперации.Имя);
	
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.ВидОперации");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Перечисления.ВидыОперацийУстановкиИндивидуальныхЦен.Отмена;

	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветФона", WebЦвета.Персиковый);
	
КонецПроцедуры

&НаСервере
Функция УправлениеФормой()
	
	Элементы.МатериалыГруппаЦены.Видимость = НЕ Объект.ВидОперации = Перечисления.ВидыОперацийУстановкиИндивидуальныхЦен.Отмена;
	
	ЭтоПродукция = Ложь;
	Если Объект.ВидНоменклатуры = ПредопределенноеЗначение("Справочник.ВидыНоменклатуры.Продукция") Тогда
		ЭтоПродукция = Истина;
		ВидПродукцииЗаполнен = ЗначениеЗаполнено(Объект.ВидПродукции);
	КонецЕсли;

	ЦеныНаПродукциюПоШаблону    = Объект.СпособОпределенияСтоимости = Перечисления.СпособыОпределенияСтоимостиПродукции.ПоШаблону;
	ЦеныНаПродукциюПоПараметрам = Объект.СпособОпределенияСтоимости = Перечисления.СпособыОпределенияСтоимостиПродукции.ПоПараметрам;
	ЦеныНаПродукциюПоНоменклатуре = Объект.СпособОпределенияСтоимости = Перечисления.СпособыОпределенияСтоимостиПродукции.ПоНоменклатуре;
	
	ЭтоПотолокОтрез = (Объект.ВидНоменклатуры = ПредопределенноеЗначение("Справочник.ВидыНоменклатуры.Потолок")
				       ИЛИ Объект.ВидНоменклатуры = ПредопределенноеЗначение("Справочник.ВидыНоменклатуры.Отрез"));
					   
	Элементы.ВидПродукции.Видимость = ЭтоПродукция;				  
	Элементы.МатериалыГруппаФактура.Видимость 		= ЭтоПотолокОтрез;
	Элементы.МатериалыГруппаЦветФактуры.Видимость   = ЭтоПотолокОтрез;
	Элементы.МатериалыГруппаШаблон.Видимость  		= ЭтоПродукция И ЦеныНаПродукциюПоШаблону;
	Элементы.МатериалыГруппаПараметрыПродукции.Видимость = ЭтоПродукция И ВидПродукцииЗаполнен И ЦеныНаПродукциюПоПараметрам;
	Элементы.МатериалыГруппаНоменклатура.Видимость = ЭтоПродукция И ВидПродукцииЗаполнен И ЦеныНаПродукциюПоНоменклатуре;
	
	Элементы.ГруппаКомандПотолки.Видимость     = ЭтоПотолокОтрез;
	Элементы.ГруппаКомандПоШаблонам.Видимость = ЭтоПродукция И ЦеныНаПродукциюПоШаблону;
	
	Элементы.МатериалыГруппаСпособУточненияЦеныСФотопечатью.Видимость = ЭтоПотолокОтрез И Объект.ЦенаСФотопечатьюОтличается;
	Элементы.МатериалыГруппаСпособУточненияЦены.Заголовок = ?(ЭтоПотолокОтрез, "Способ уточнения цены за кв. м.", "Способ уточнения цены");
	
	//#12615
	Элементы.ЦенаСФотопечатьюОтличается.Видимость = ЭтоПотолокОтрез;
	
КонецФункции

