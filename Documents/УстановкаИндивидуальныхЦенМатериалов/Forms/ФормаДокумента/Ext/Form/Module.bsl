	ПараметрыПодбора = Новый Структура;
	УстановкаЦенКлиент.ОткрытьФормуПодбораФактуры(ПараметрыПодбора, ЭтаФорма, УникальныйИдентификатор);
	
КонецПроцедуры

&НаКлиенте
Процедура ПодобратьШаблоны(Команда)
	
	ПараметрыПодбора = Новый Структура;
	УстановкаЦенКлиент.ОткрытьФормуПодбораШаблонов(ПараметрыПодбора, ЭтаФорма, УникальныйИдентификатор);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбораПодборНаКлиенте(ВыбранноеЗначение)
	
	Если Не ЗначениеЗаполнено(ВыбранноеЗначение) Тогда
		Возврат;
	КонецЕсли;
			
	ОбработкаВыбораПодборНаСервере(ВыбранноеЗначение);
		
КонецПроцедуры

&НаСервере
Функция ОбработкаВыбораПодборНаСервере(ВыбранноеЗначение)
	
	ТаблицаДанныхПодбора = ПолучитьИзВременногоХранилища(ВыбранноеЗначение.АдресВХранилище);
	Если ЭтоПотолокОтрез Тогда
		УстановкаЦенСервер.ОбработкаВыбораПодбораФактуры(ТаблицаДанныхПодбора, Объект.Материалы);
	ИначеЕсли ЭтоПродукция Тогда
		УстановкаЦенСервер.ОбработкаВыбораПодбораШаблонов(ТаблицаДанныхПодбора, Объект.Материалы);
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Процедура ЗаполнитьМатериалыПоСправочнику(Команда)
	
	УстановкаЦенКлиент.ЗаполнитьМатериалыПоСправочникуФактур(ЭтаФорма, Объект.Материалы); //, Новый Структура("КлючСвязи", ТекущиеДанные.КлючСвязи));
		
КонецПроцедуры

