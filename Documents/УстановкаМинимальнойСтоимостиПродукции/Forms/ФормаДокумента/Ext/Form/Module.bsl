	ПодключаемыеКомандыКлиент.ВыполнитьКоманду(ЭтотОбъект, Команда, Объект);
КонецПроцедуры

&НаСервере
Процедура Подключаемый_ВыполнитьКомандуНаСервере(Контекст, Результат) Экспорт
	ПодключаемыеКоманды.ВыполнитьКоманду(ЭтотОбъект, Контекст, Объект, Результат);
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ОбновитьКоманды()
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект);
КонецПроцедуры
// Конец СтандартныеПодсистемы.ПодключаемыеКоманды

#КонецОбласти

#Область ОбработчикиКоманд

&НаКлиенте
Процедура ПодобратьМатериалы(Команда)
	
	ПараметрыПодбора = Новый Структура;
	УстановкаЦенКлиент.ОткрытьФормуПодбораФактуры(ПараметрыПодбора, ЭтаФорма, УникальныйИдентификатор);
	
КонецПроцедуры

&НаКлиенте
Процедура ПодобратьШаблоны(Команда)
	
	ПараметрыПодбора = Новый Структура;
	УстановкаЦенКлиент.ОткрытьФормуПодбораШаблонов(ПараметрыПодбора, ЭтаФорма, УникальныйИдентификатор);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПоСправочнику(Команда)
	
	УстановкаЦенКлиент.ЗаполнитьМатериалыПоСправочникуФактур(ЭтаФорма, Объект.Материалы);
		
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьМатериалыПоСправочникуФактурЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если НЕ Результат = КодВозвратаДиалога.Да Тогда
        Возврат;
    КонецЕсли;
	
   	ЗаполнитьМатериалыПоСправочникуФактурНаСервере(ДополнительныеПараметры.ДополнительныеПараметрыЗаполнения);

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьМатериалыПоСправочникуФактурНаСервере(ДополнительныеПараметрыЗаполнения)
	
	УстановкаЦенСервер.ЗаполнитьМатериалыПоСправочникуФактур(Объект.Материалы, , ДополнительныеПараметрыЗаполнения);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПоСправочникуШаблонов(Команда)
	
	УстановкаЦенКлиент.ЗаполнитьМатериалыПоСправочникуШаблонов(ЭтаФорма, Объект.Материалы);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьМатериалыПоСправочникуШаблоновЗавершение(Результат, Параметры) Экспорт
	
    Если Результат = КодВозвратаДиалога.Нет Тогда
        Возврат;
    КонецЕсли;

    ЗаполнитьПоСправочникуШаблоновНаСервере();

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПоСправочникуШаблоновНаСервере()
	
	УстановкаЦенСервер.ЗаполнитьМатериалыПоСправочникуШаблонов(Объект.Материалы);
		
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПоГруппеСправочника(Команда)
	
	Если НЕ ЭтоПродукция Тогда
		УстановкаЦенКлиент.ЗаполнитьМатериалыПоГруппеФактур(ЭтаФорма, Объект.Материалы);
	Иначе
		УстановкаЦенКлиент.ЗаполнитьМатериалыПоГруппеШаблонов(ЭтаФорма, Объект.Материалы);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьМатериалыПоГруппеФактурПослеВыбораГруппы(ВыбранноеЗначение, ДополнительныеПараметры) Экспорт
	
	Если ВыбранноеЗначение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнитьМатериалыПоГруппеНаСервере(ВыбранноеЗначение, ДополнительныеПараметры);
    
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьМатериалыПоГруппеНаСервере(ГруппаФактур, ДополнительныеПараметрыЗаполнения)
	
	УстановкаЦенСервер.ЗаполнитьМатериалыПоСправочникуФактур(Объект.Материалы, ГруппаФактур, ДополнительныеПараметрыЗаполнения);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьМатериалыПоГруппеШаблоновПослеВыбораГруппы(ВыбранноеЗначение, ДополнительныеПараметры) Экспорт
	
	Если ВыбранноеЗначение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнитьПоГруппеШаблоновНаСервере(ВыбранноеЗначение);
    
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПоГруппеШаблоновНаСервере(ГруппаШаблонов)
	
	УстановкаЦенСервер.ЗаполнитьМатериалыПоСправочникуШаблонов(Объект.Материалы, , ГруппаШаблонов);
		
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьТекущимЗначением(Команда)
	
	Если Объект.ВидЦены.Пустая() Тогда
		Состояние("В документе не указан вид цен");
		Возврат;
	КонецЕсли;
	
	ОписаниеОповещенияВопрос = Новый ОписаниеОповещения("ЗаполнитьТекущимЗначениемПослеВопроса",ЭтаФорма);
	ПоказатьВопрос(ОписаниеОповещенияВопрос,"Очистить цены и заполнить текущими значениями?",РежимДиалогаВопрос.ДаНет);	
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьТекущимЗначениемПослеВопроса(Результат, Параметры) Экспорт
    Если Результат = КодВозвратаДиалога.Нет Тогда
        Возврат;
    КонецЕсли;

    ЗаполнитьТекущимЗначениемНаСервере();

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТекущимЗначениемНаСервере()
	
	Если НЕ ПроверитьЗаполнение() Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	МинимальнаяСтоимостьПродукцииСрезПоследних.Фактура КАК Фактура,
	|	МинимальнаяСтоимостьПродукцииСрезПоследних.ЦветФактуры КАК ЦветФактуры,
	|	МинимальнаяСтоимостьПродукцииСрезПоследних.Шаблон КАК Шаблон,
	|	МинимальнаяСтоимостьПродукцииСрезПоследних.Стоимость КАК МинимальнаяСтоимость,
	|	МинимальнаяСтоимостьПродукцииСрезПоследних.СпособОпределения КАК СпособОпределения,
	|	МинимальнаяСтоимостьПродукцииСрезПоследних.ПорядокНаценки КАК ПорядокНаценки
	|ИЗ
	|	РегистрСведений.МинимальнаяСтоимостьПродукции.СрезПоследних(
	|			&Период,
	|			Организация = &Организация
	|				И Валюта = &Валюта
	|				И ВидНоменклатуры = &ВидНоменклатуры
	|				И ВидЦены = &ВидЦены) КАК МинимальнаяСтоимостьПродукцииСрезПоследних";
	//++ №13380 комментируем
	//|				И ВЫБОР
	//|					КОГДА &ОтборПоПодразделению
	//|						ТОГДА Подразделение = &Подразделение
	//|					ИНАЧЕ ИСТИНА
	//|				КОНЕЦ
	//-- №13380 
	
	Запрос.УстановитьПараметр("Валюта", Объект.Валюта);
	Запрос.УстановитьПараметр("ВидНоменклатуры", Объект.ВидНоменклатуры);
	Запрос.УстановитьПараметр("ВидЦены", Объект.ВидЦены);
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	// №13380 Запрос.УстановитьПараметр("ОтборПоПодразделению", ЗначениеЗаполнено(Объект.Подразделение));
	Запрос.УстановитьПараметр("Период", Объект.Дата);
	// №13380 Запрос.УстановитьПараметр("Подразделение", Объект.Подразделение);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ТекущиеЗначения = РезультатЗапроса.Выгрузить();
	
	Если ЭтоПродукция Тогда
		СтруктураОтбора = Новый Структура("Шаблон");
	Иначе
		СтруктураОтбора = Новый Структура("Фактура, ЦветФактуры");
	КонецЕсли;
	
	Для каждого СтрокаТЧ из Объект.Материалы Цикл
		ЗаполнитьЗначенияСвойств(СтруктураОтбора, СтрокаТЧ);
		НайденныеСтроки = ТекущиеЗначения.НайтиСтроки(СтруктураОтбора);
		Если НайденныеСтроки.Количество() > 0 Тогда
			ЗаполнитьЗначенияСвойств(СтрокаТЧ, НайденныеСтроки[0]); 
		КонецЕсли;
	КонецЦикла;
		
КонецПроцедуры

&НаКлиенте
Процедура УстановитьСтоимость(Команда)
	
	ОписаниеОповещенияВопрос = Новый ОписаниеОповещения("УстановитьСтоимостьПослеВопроса",ЭтаФорма);
	ПоказатьВопрос(ОписаниеОповещенияВопрос,"Установить общую стоимость на все строки?",РежимДиалогаВопрос.ДаНет);	
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьСтоимостьПослеВопроса(Результат, Параметры) Экспорт
    Если Результат = КодВозвратаДиалога.Нет Тогда
        Возврат;
    КонецЕсли;

	ОписаниеОповещенияВыборЦены = Новый ОписаниеОповещения("УстановитьСтоимостьПослеВыбора", ЭтаФорма);
	ПоказатьВводЗначения(ОписаниеОповещенияВыборЦены, 0, "Введите стоимость");

КонецПроцедуры

&НаКлиенте
Процедура УстановитьСтоимостьПослеВыбора(ВыбЗнач, Параметры) Экспорт
    Если НЕ ВыбЗнач = Неопределено Тогда		
		Для Каждого ТекущаяСтрока Из Объект.Материалы Цикл
			ТекущаяСтрока.МинимальнаяСтоимость = ВыбЗнач;
		КонецЦикла;
    КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура УстановитьОбщийПорядокНаценки(Команда)
	
	ОписаниеОповещения = Новый ОписаниеОповещения("УстановитьОбщийПорядокНаценкиПослеВыбора", ЭтаФорма);
	СписокПорядков = Новый СписокЗначений;
	СписокПорядков.Добавить(ПредопределенноеЗначение("Перечисление.ПорядокНаценкиМинимальнойЦеныНаПродукцию.НаПолотно"));
	СписокПорядков.Добавить(ПредопределенноеЗначение("Перечисление.ПорядокНаценкиМинимальнойЦеныНаПродукцию.ПропорциональноНаВсеСоставляющиеПотолка"));
