#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
		
	Если Параметры.Ключ.Пустая() Тогда
	Иначе
		ЭтаФорма.ТолькоПросмотр = ПраваПользователей.ДокументТолькоПросмотр(Объект.Ссылка);
	КонецЕсли;
		
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	Элементы.ПодменюПечать.Доступность = ПраваПользователей.ДоступностьПечати(Объект.Ссылка);	
	ПраваПользователей.УстановитьТолькоПросмотрДляРеквизитаНомер(Элементы.Номер.ТолькоПросмотр);
	
	//УстановитьВидимость();
	
	//УстановитьУсловноеОформление();
	
	УправлениеФормойПоВидуНоменклатуры();
	
	ФинансыСервер.ОбновитьВидимостьИКурсВалюты(ЭтотОбъект);
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	ДатыЗапретаИзменения.ОбъектПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	
	Если ИсточникВыбора.ИмяФормы = "ОбщаяФорма.ФормаПодбораФактуры" Тогда	
		ОбработкаВыбораПодборНаКлиенте(ВыбранноеЗначение);
		
	ИначеЕсли ИсточникВыбора.ИмяФормы = "ОбщаяФорма.ФормаПодбораШаблоновПродукции" Тогда	
		ОбработкаВыбораПодборНаКлиенте(ВыбранноеЗначение);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ДатаПриИзменении(Элемент)
	ДатаПриИзмененииНаСервере();
КонецПроцедуры

&НаСервере
Процедура ДатаПриИзмененииНаСервере()
	
	ФинансыСервер.ОбновитьВидимостьИКурсВалюты(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ВалютаПриИзменении(Элемент)
	ВалютаПриИзмененииНаСервере();
КонецПроцедуры

&НаСервере
Процедура ВалютаПриИзмененииНаСервере()
	
	ФинансыСервер.ОбновитьВидимостьИКурсВалюты(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ВидНоменклатурыНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	//СтандартнаяОбработка = Ложь; // #16747  закомментировано
	СтарыйВидНоменклатуры = Объект.ВидНоменклатуры;
	
КонецПроцедуры

&НаКлиенте
Процедура ВидНоменклатурыПриИзменении(Элемент)
	
	Если НЕ СтарыйВидНоменклатуры = Объект.ВидНоменклатуры
		И (СтарыйВидНоменклатуры = ПредопределенноеЗначение("Справочник.ВидыНоменклатуры.Продукция")
			ИЛИ Объект.ВидНоменклатуры = ПредопределенноеЗначение("Справочник.ВидыНоменклатуры.Продукция")) Тогда
		Если Объект.Материалы.Количество() > 0 Тогда
			ТекстВопроса = "Табличная часть с ценами будет очищена. Продолжить?";
			ОписаниеОповещения = Новый ОписаниеОповещения("ВидНоменклатурыПриИзмененииЗавершение", ЭтотОбъект);
			ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
		Иначе
			УправлениеФормойПоВидуНоменклатуры();
		КонецЕсли;
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура ВидНоменклатурыПриИзмененииЗавершение(Результат, ДополнительныеПарраметры) Экспорт
	
	Если Не Результат = КодВозвратаДиалога.Да Тогда
		Объект.ВидНоменклатуры = СтарыйВидНоменклатуры;
		
	Иначе 
		Объект.Материалы.Очистить();
		УправлениеФормойПоВидуНоменклатуры();
		
	КонецЕсли;
		
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыФункции

&НаКлиенте
Процедура ОбработкаВыбораПодборНаКлиенте(ВыбранноеЗначение)
	
	Если Не ЗначениеЗаполнено(ВыбранноеЗначение) Тогда
		Возврат;
	КонецЕсли;
			
	ОбработкаВыбораПодборНаСервере(ВыбранноеЗначение);
		
КонецПроцедуры

&НаСервере
Функция ОбработкаВыбораПодборНаСервере(ВыбранноеЗначение)
		
	ТаблицаДанныхПодбора = ПолучитьИзВременногоХранилища(ВыбранноеЗначение.АдресВХранилище);
	Если Не ЭтоПродукция Тогда
		УстановкаЦенСервер.ОбработкаВыбораПодбораФактуры(ТаблицаДанныхПодбора, Объект.Материалы);
	Иначе
		УстановкаЦенСервер.ОбработкаВыбораПодбораШаблонов(ТаблицаДанныхПодбора, Объект.Материалы);
	КонецЕсли;
	
КонецФункции

&НаСервере
Процедура УправлениеФормойПоВидуНоменклатуры() 
	
	ЭтоПродукция = (Объект.ВидНоменклатуры = ПредопределенноеЗначение("Справочник.ВидыНоменклатуры.Продукция"));
	Элементы.МатериалыФактура.Видимость 			= НЕ ЭтоПродукция;
	Элементы.МатериалыЦветФактуры.Видимость    		= НЕ ЭтоПродукция;
	Элементы.МатериалыШаблон.Видимость  			= ЭтоПродукция;
	Элементы.МатериалыСпообОпределения.Видимость 	= НЕ ЭтоПродукция;
	Элементы.МатериалыПорядокНаценки.Видимость    	= НЕ ЭтоПродукция;
	
	Элементы.ГруппаКомандПотолки.Видимость     = НЕ ЭтоПродукция;
	Элементы.ГруппаКомандПродукция.Видимость = ЭтоПродукция;
		
КонецПроцедуры

#КонецОбласти

#Область СтандартныеПодсистемы

// СтандартныеПодсистемы.ПодключаемыеКоманды
&НаКлиенте
Процедура Подключаемый_ВыполнитьКоманду(Команда)
