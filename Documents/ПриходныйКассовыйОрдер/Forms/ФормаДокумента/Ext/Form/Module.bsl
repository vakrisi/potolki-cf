&НаСервере
Процедура ОбновитьДанные()
	
	Элементы.ГруппаКонтрагент.Видимость = Ложь;
	Элементы.ГруппаТекущийДолг.Видимость = Ложь;
	Элементы.ГруппаТекущийДолгПоЗаказу.Видимость = Ложь;
	Элементы.ГруппаСтоимостьЗаказовВРаботе.Видимость = Ложь;
	Элементы.ГруппаСотрудник.Видимость = Ложь;
	Элементы.ГруппаРаспределениеПлатежа.Видимость = Истина;
	Элементы.ГруппаСуммыРаспределения.Видимость = Истина;	
	Элементы.ГруппаВыданныеАвансы.Видимость = Ложь;
	Элементы.РаспределениеПлатежаДатаПлатежаПоРассрочке.Видимость = Ложь;
	Элементы.ЗаполнитьОснованияПоРаспределению.Видимость = Истина;  
	Элементы.СуммаОсновногоТелаЗайма.Видимость = Ложь;  
	Элементы.СуммаПроцентовПоЗайму.Видимость = Ложь;  
	Элементы.РаспределениеПлатежаГруппаВозврат.Видимость = Ложь; //#7080
	Элементы.РаспределениеПлатежаГруппаОплата.Видимость = Ложь;  //#7080
	
	//#9708
	Элементы.СтатьяДоходовПоНачислению.Видимость = ПолучитьФункциональнуюОпцию("НекассовыйМетодВеденияУчетаДоходовРасходов") 
									И Объект.ВидОперации = Перечисления.ВидыОперацийПриходныйКассовыйОрдер.Прочее
									//++ №13755
									И ЗначениеЗаполнено(Объект.Ссылка)
									И НЕ (Объект.СтатьяДоходов = Объект.СтатьяДоходовПоНачислению);
									//-- №13755
									
	Элементы.СтатьяДоходов.Видимость = Истина; // #12545
	
	ДокументОснование = Неопределено;
	Если Объект.Основания.Количество() > 0 Тогда
		ДокументОснование = Объект.Основания[0].Основание;
	КонецЕсли;
	
	Если Объект.ВидОперации = Перечисления.ВидыОперацийПриходныйКассовыйОрдер.Прочее Тогда
		Элементы.ГруппаРаспределениеПлатежа.Видимость = Ложь; 
		
	ИначеЕсли Объект.ВидОперации = Перечисления.ВидыОперацийПриходныйКассовыйОрдер.ПолучениеНаличныхИзБанка Тогда
		Элементы.ГруппаРаспределениеПлатежа.Видимость = Ложь; // #12545
		Элементы.СтатьяДоходов.Видимость = Ложь; // #12545
		
	ИначеЕсли Объект.ВидОперации = Перечисления.ВидыОперацийПриходныйКассовыйОрдер.ОплатаОтПокупателя Тогда
		Элементы.РаспределениеПлатежаГруппаОплата.Видимость = Истина;  //#7080
		Элементы.РаспределениеПлатежаДатаПлатежаПоРассрочке.Видимость = Истина;
		Элементы.ГруппаКонтрагент.Видимость = Истина;
		Если Объект.Контрагент.Пустая() Тогда
			Элементы.ГруппаТекущийДолг.Видимость = Ложь;
			Элементы.ГруппаСтоимостьЗаказовВРаботе.Видимость = Ложь;
		Иначе
			Элементы.ДекорацияСуммаДолга.Заголовок = ПолучитьСтоимостьЗаказовВРаботе(Объект.Контрагент, Объект.Валюта, ТекущаяДатаСеанса()) +    //nva
				ПолучитьТекущийДолгКлиента(Объект.Организация, Объект.Контрагент, Объект.Договор, Объект.Валюта, ВалютаУчета, ТекущаяДатаСеанса()); //Объект.Дата);//nva
			Элементы.ДекорацияСтоимостьЗаказовВРаботе.Заголовок = ПолучитьСтоимостьЗаказовВРаботе(Объект.Контрагент, Объект.Валюта, ТекущаяДатаСеанса()); //Объект.Дата);
			Элементы.ГруппаТекущийДолг.Видимость = Истина;
			//Если НЕ (ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.ЗаказДоговор")   // #12822 группа видима всегда
			//	или ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.Монтаж"))
			//Тогда
				Элементы.ГруппаСтоимостьЗаказовВРаботе.Видимость = Истина;
			//КонецЕсли;			
			// №7373 валюту показываем выбранную в текущем документе
			//ВалютаУчета = Константы.ВалютаУчета.Получить();
			Элементы.ДекорацияНадписьВалютаДолга1.Заголовок = Объект.Валюта; //ВалютаУчета;
			Элементы.ДекорацияНадписьВалютаДолга2.Заголовок = Объект.Валюта; //ВалютаУчета;
		КонецЕсли;
		
		Если ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.ЗаказДоговор")
			или ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.ЗаказПокупателя")
			Тогда
			
			Элементы.ГруппаТекущийДолгПоЗаказу.Видимость = Истина;
			// №7373 валюту показываем выбранную в текущем документе
			Элементы.ДекорацияНадписьВалютаДолга3.Заголовок = Объект.Валюта; //ВалютаУчета;
			Элементы.ДекорацияСуммаДолгаПоЗаказу.Заголовок = "0";
			
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	РасчетыПоЗаказамОстатки.СуммаОстаток
			|ИЗ
			|	РегистрНакопления.РасчетыПоЗаказам.Остатки(, Заказ = &Заказ) КАК РасчетыПоЗаказамОстатки";
			Запрос.УстановитьПараметр("Заказ", ДокументОснование);
			Выборка = Запрос.Выполнить().Выбрать();
			Пока Выборка.Следующий() Цикл
				СуммаОстатокПоЗаказу = Выборка.СуммаОстаток;
				// №7373 если валюта текущего документа отличается от валюты заказа, показываем сумму в валюте текущего документа
				Если НЕ Объект.Валюта = ДокументОснование.Валюта Тогда
					СуммаОстатокПоЗаказу = Окр(РаботаСВалютой.ПересчитатьИзВалютыВВалюту(ДокументОснование.Валюта, Объект.Валюта, ТекущаяДатаСеанса(), СуммаОстатокПоЗаказу), 2);
				КонецЕсли;	
				Элементы.ДекорацияСуммаДолгаПоЗаказу.Заголовок = СуммаОстатокПоЗаказу;
			КонецЦикла;
			
		ИначеЕсли ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.Монтаж") Тогда
			
			Элементы.ГруппаТекущийДолгПоЗаказу.Видимость = Истина;
			// №7373 валюту показываем выбранную в текущем документе
			Элементы.ДекорацияНадписьВалютаДолга3.Заголовок = Объект.Валюта; //ВалютаУчета;
			Элементы.ДекорацияСуммаДолгаПоЗаказу.Заголовок = "0";
			
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	РасчетыПоЗаказамОстатки.СуммаОстаток
			|ИЗ
			|	РегистрНакопления.РасчетыПоЗаказам.Остатки(, Заказ = &Заказ) КАК РасчетыПоЗаказамОстатки";
			Запрос.УстановитьПараметр("Заказ", ДокументОснование);
			Выборка = Запрос.Выполнить().Выбрать();
			Пока Выборка.Следующий() Цикл
				Элементы.ДекорацияСуммаДолгаПоЗаказу.Заголовок = Выборка.СуммаОстаток;
			КонецЦикла;
			
		Иначе
			Элементы.ГруппаТекущийДолгПоЗаказу.Видимость = Ложь;
		КонецЕсли;
		
	ИначеЕсли Объект.ВидОперации = Перечисления.ВидыОперацийПриходныйКассовыйОрдер.ВозвратОтПодотчетника Тогда
		Элементы.ГруппаСотрудник.Видимость = Истина;
		Элементы.ГруппаРаспределениеПлатежа.Видимость = Ложь;
		Элементы.ГруппаВыданныеАвансы.Видимость = Истина;
		
	//#7080
	ИначеЕсли Объект.ВидОперации = Перечисления.ВидыОперацийПриходныйКассовыйОрдер.ВозвратОтПоставщика Тогда
		Элементы.ГруппаКонтрагент.Видимость = Истина;
		Элементы.ГруппаТекущийДолг.Видимость = Истина;
		Элементы.РаспределениеПлатежаГруппаВозврат.Видимость = Истина;  
		Элементы.ГруппаРаспределениеПлатежа.Видимость = Истина;
		Элементы.ГруппаСуммыРаспределения.Видимость = Ложь;
		Элементы.ДекорацияСуммаДолга.Заголовок = ПолучитьСтоимостьЗаказовВРаботе(Объект.Контрагент, Объект.Валюта, ТекущаяДатаСеанса()) +    //nva
			ПолучитьТекущийДолгКлиента(Объект.Организация, Объект.Контрагент, Объект.Договор, Объект.Валюта, ВалютаУчета, ТекущаяДатаСеанса());
		
	//#4119
	ИначеЕсли Объект.ВидОперации = Перечисления.ВидыОперацийПриходныйКассовыйОрдер.ПолучениеКредита ИЛИ Объект.ВидОперации = Перечисления.ВидыОперацийПриходныйКассовыйОрдер.ВозвратЗайма Тогда
		Элементы.ГруппаКонтрагент.Видимость = Истина;
		Элементы.ГруппаТекущийДолг.Видимость = Истина;
		Элементы.ГруппаРаспределениеПлатежа.Видимость = Ложь;
		Элементы.РаспределениеПлатежаГруппаВозврат.Видимость = Ложь;  
		Элементы.ГруппаСуммыРаспределения.Видимость = Ложь;
		Элементы.СтатьяДоходов.Видимость = Ложь;
		Элементы.ДекорацияСуммаДолга.Заголовок = ПолучитьСтоимостьЗаказовВРаботе(Объект.Контрагент, Объект.Валюта, ТекущаяДатаСеанса()) +    //nva
			ПолучитьТекущийДолгКлиента(Объект.Организация, Объект.Контрагент, Объект.Договор, Объект.Валюта, ВалютаУчета, ТекущаяДатаСеанса());
		Элементы.ЗаполнитьОснованияПоРаспределению.Видимость = Ложь;  
	КонецЕсли;
	
	Если Объект.ВидОперации = Перечисления.ВидыОперацийПриходныйКассовыйОрдер.ВозвратЗайма Тогда
		Элементы.СтатьяДоходов.Видимость = Истина;
		Элементы.СуммаОсновногоТелаЗайма.Видимость = Истина;  
		Элементы.СуммаПроцентовПоЗайму.Видимость = Истина;  
	КонецЕсли;
	
	//Элементы.КонтрагентДополнительно.Видимость = Объект.Контрагент.ПоказыватьДопИнформацию;
	ОбщийМодульСервер.ДополнительнаяИнформацияПоКонтрагентуНаФорме(Объект.Контрагент, Элементы.ПоказатьДополнительнуюИнформацию);
	ОбщийМодульСервер.РегулировкаШириныПоляКонтрагента(Элементы, Элементы.Контрагент, Элементы.ПоказатьДополнительнуюИнформацию, , 36);
	
	СписокДокументовРаспределения = Объект.РаспределениеПлатежа.Выгрузить(,"Документ");
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	РасчетыПоЗаказамОстатки.СуммаОстаток КАК ОсталосьРаспределить,
	|	РасчетыПоЗаказамОстатки.Заказ КАК Заказ,
	|	РасчетыПоЗаказамОстатки.Заказ.СуммаДокумента КАК СуммаДокумента,
	|	РасчетыПоЗаказамОстатки.Заказ.Валюта КАК Валюта
	|ИЗ
	|	РегистрНакопления.РасчетыПоЗаказам.Остатки(, Заказ В (&Заказ)) КАК РасчетыПоЗаказамОстатки";
	Запрос.УстановитьПараметр("Заказ", СписокДокументовРаспределения);
	ТаблицаПоДокументам = Запрос.Выполнить().Выгрузить();
	
	// №7373 нужно определить различие в валютах, чтобы корректно отображать определенные колонки и суммы
	ВалютаЗаказаРавнаВалютеДокумента = ФинансыСервер.ОпределитьРазличиеВалютыЗаказаИВалютыДокумента(Объект);
	
	Для Каждого СтрокаРаспределения Из Объект.РаспределениеПлатежа Цикл
		Отбор = Новый Структура;
		Отбор.Вставить("Заказ", СтрокаРаспределения.Документ);
		НайденныеСтроки = ТаблицаПоДокументам.НайтиСтроки(Отбор);
		Если НайденныеСтроки.Количество() > 0 Тогда
			Если Объект.Валюта = ВалютаУчета И ВалютаЗаказаРавнаВалютеДокумента Тогда 
				ЗаполнитьЗначенияСвойств(СтрокаРаспределения, НайденныеСтроки[0]);
			Иначе
				СтрокаРаспределения.ВалютаДокумента = НайденныеСтроки[0].Валюта; 
				СтрокаРаспределения.СуммаДокументаВВалютеДокумента = НайденныеСтроки[0].СуммаДокумента;
				СтрокаРаспределения.СуммаДокумента = РаботаСВалютой.ПересчитатьИзВалютыВВалюту(НайденныеСтроки[0].Валюта, Объект.Валюта, Объект.Дата, НайденныеСтроки[0].СуммаДокумента);
				СтрокаРаспределения.ОсталосьРаспределить = РаботаСВалютой.ПересчитатьИзВалютыВВалюту(НайденныеСтроки[0].Валюта, Объект.Валюта, Объект.Дата, НайденныеСтроки[0].ОсталосьРаспределить);
			КонецЕсли;
		Иначе
			Попытка
				Если Объект.Валюта = ВалютаУчета И ВалютаЗаказаРавнаВалютеДокумента Тогда
					СтрокаРаспределения.СуммаДокумента = СтрокаРаспределения.Документ.СуммаДокумента;
				Иначе
					СтрокаРаспределения.ВалютаДокумента = СтрокаРаспределения.Документ.Валюта; 
					СтрокаРаспределения.СуммаДокументаВВалютеДокумента = СтрокаРаспределения.Документ.СуммаДокумента;
					СтрокаРаспределения.СуммаДокумента = РаботаСВалютой.ПересчитатьИзВалютыВВалюту(СтрокаРаспределения.Документ.Валюта, Объект.Валюта, Объект.Дата, СтрокаРаспределения.Документ.СуммаДокумента);
				КонецЕсли;
			Исключение
			КонецПопытки;
		КонецЕсли;
	КонецЦикла;
	
	ФинансыСервер.ОбновитьНадписиРаспеределениеПлатежа(ЭтаФорма, Объект, , ВалютаУчета, ВалютаЗаказаРавнаВалютеДокумента);
	ФинансыСервер.ОбновитьВидимостьИКурсВалюты(ЭтотОбъект);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСтатьюДоходовРасходовСервер()
	
	Если НЕ Объект.ВидОперации.Пустая() Тогда     	
		Объект.СтатьяДоходов = ФинансыСервер.ПолучитьСтатьюДоходовРасходов(Объект, Объект.ВидОперации);
		Объект.СтатьяДоходовПоНачислению = Объект.СтатьяДоходов; //#9708
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьКнопокРаспределения()
	Элементы.РаспределениеПлатежаРаспределение_ЗаказДоговор.Видимость 		 = Константы.ВестиРасчетыПоЗаказамПоЗаказДоговору.Получить();
	Элементы.ГруппаРаспределениеЗаказДоговор.Видимость = Элементы.РаспределениеПлатежаРаспределение_ЗаказДоговор.Видимость;
	
	Элементы.РаспределениеПлатежаРаспределение_СчетНаОплату.Видимость 		 = Константы.ВестиРасчетыПоЗаказамПоСчетуНаОплату.Получить();
	Элементы.ГруппаРаспределениеСчетНаОплату.Видимость = Элементы.РаспределениеПлатежаРаспределение_СчетНаОплату.Видимость;
	
	//НАЧАЛО: переход на 2.0
	//Элементы.РаспределениеПлатежаРаспределение_ЗаказНаПроизводство.Видимость = Константы.ВестиРасчетыПоЗаказамПоЗаказуНаПроизводство.Получить();
	//Элементы.ГруппаРаспределениеЗаказНаПроизводство.Видимость = Элементы.РаспределениеПлатежаРаспределение_ЗаказНаПроизводство.Видимость;
	//КОНЕЦ: переход на 2.0
	
	Элементы.РаспределениеПлатежаРаспределение_ЗаказПокупателя.Видимость	 = Константы.ВестиРасчетыПоЗаказамПоЗаказуПокупателя.Получить();
	Элементы.ГруппаРаспределениеЗаказПокупателя.Видимость = Элементы.РаспределениеПлатежаРаспределение_ЗаказПокупателя.Видимость;
	
	Элементы.РаспределениеПлатежаРаспределение_Реализация.Видимость 		 = Константы.ВестиРасчетыПоЗаказамПоРТиУ.Получить();
	Элементы.ГруппаРаспределенияРТИУ.Видимость = Элементы.РаспределениеПлатежаРаспределение_Реализация.Видимость;
	
	Элементы.РаспределениеПлатежаРаспределение_Монтаж.Видимость				 = Константы.ВестиРасчетыПоЗаказамПоМонтажу.Получить();
	Элементы.ГруппаРаспределениеМонтаж.Видимость = Элементы.РаспределениеПлатежаРаспределение_Монтаж.Видимость; 
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьТекущийДолгКлиента(Знач Организация, Знач Контрагент, Знач Договор, Знач ВалютаДокумента, Знач ВалютаУчета, Дата)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВзаиморасчетыСКонтрагентамиОстатки.СуммаОстаток
	|ИЗ
	|	РегистрНакопления.ВзаиморасчетыСКонтрагентами.Остатки(
	|			,
	|			Договор = &Договор
	|				И Контрагент = &Контрагент
	|				И Организация = &Организация) КАК ВзаиморасчетыСКонтрагентамиОстатки";
	Запрос.УстановитьПараметр("Организация",Организация);
	Запрос.УстановитьПараметр("Контрагент",Контрагент);
	Запрос.УстановитьПараметр("Договор",Договор);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		// №7373 сумму долга показываем в валюте текущего документа, если валюта отличается от валюты учета
		Сумма = Выборка.СуммаОстаток;
		Если НЕ ВалютаДокумента = ВалютаУчета Тогда
			Сумма = Окр(РаботаСВалютой.ПересчитатьИзВалютыВВалюту(ВалютаУчета, ВалютаДокумента, Дата, Сумма), 2);
		КонецЕсли;	
		Возврат Сумма;
	КонецЦикла;
	
	Возврат 0;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьСтоимостьЗаказовВРаботе(Знач Контрагент, Знач ВалютаДокумента, Дата)
	
	ТекущийСтатус = Новый СписокЗначений;
	ТекущийСтатус.Добавить(Справочники.СтатусыЗаказовПокупателей.ВРаботе);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	//|	ЗаказыПокупателей.ЗаказНаПроизводство КАК ЗаказНаПроизводство,
	|	ЗаказыПокупателей.ЗаказНаПроизводство.Валюта КАК Валюта,
	//|	ЗаказыПокупателей.ЗаказНаПроизводство.ТекущийСтатус КАК ТекущийСтатус,
	//|	ЗаказыПокупателей.ЗаказНаПроизводство.СуммаДокумента КАК СуммаДокумента,
	//|	ЗаказыПокупателей.ЗаказНаПроизводство.Комментарий КАК Комментарий,
	|	ЗаказыПокупателей.СуммаОстаток КАК СуммаОстаток
	|ИЗ
	|	РегистрНакопления.ЗаказыПокупателей.Остатки(
	|			&ТекущаяДата,
	|			ЗаказНаПроизводство.Контрагент = &Контрагент
	|				И ЗаказНаПроизводство.ТекущийСтатус В (&ТекущийСтатус)) КАК ЗаказыПокупателей";
	Запрос.УстановитьПараметр("ТекущаяДата",КонецДня(ТекущаяДатаСеанса()));
	Запрос.УстановитьПараметр("Контрагент",Контрагент);
	Запрос.УстановитьПараметр("ТекущийСтатус",ТекущийСтатус);
	
	// №7373 сумму долга показываем в валюте текущего документа, если валюта отличается от валюты учета
	//ОжидаемаяСумма = Запрос.Выполнить().Выгрузить().Итог("СуммаДокумента");
	ОжидаемаяСумма = 0;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ПересчитаннаяСумма = Выборка.СуммаОстаток; //Выборка.СуммаДокумента;
		Если НЕ ВалютаДокумента = Выборка.Валюта Тогда
			ПересчитаннаяСумма = Окр(РаботаСВалютой.ПересчитатьИзВалютыВВалюту(Выборка.Валюта, ВалютаДокумента, Дата, ПересчитаннаяСумма), 2);
		КонецЕсли;
		ОжидаемаяСумма = ОжидаемаяСумма + ПересчитаннаяСумма;
	КонецЦикла;	
	
	Возврат ОжидаемаяСумма;
	
КонецФункции

