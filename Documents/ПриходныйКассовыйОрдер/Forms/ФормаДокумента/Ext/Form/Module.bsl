//nva+++
&НаКлиенте
Процедура Распределение_ПоНеоплаченнымЗаказам(Команда)
	
	ТЗДолгиПоЗаказам = ПолучитьДолгиПоКонтрагентуПоЗазамСервер(Объект.Контрагент, Объект.Сумма);       
	
	Если ТЗДолгиПоЗаказам <> Неопределено И ТЗДолгиПоЗаказам.Количество() > 0 Тогда
		
		Объект.РаспределениеПлатежа.Очистить();
		РаспределениеПлатежаОбработкаВыбора(Элементы.РаспределениеПлатежаПоНеоплаченнымЗаказам, ТЗДолгиПоЗаказам, Истина);
	
		ДополнительныеПараметры = Неопределено;
		ОписаниеОповещенияОбновитьДанные = Новый ОписаниеОповещения("ОписаниеОповещенияОбновитьДанные", ЭтотОбъект);
		ФинансыКлиент.РаспределениеОплаты(ЭтаФорма, "РаспределениеПлатежа", СтрокиРаспределенияПлатежей(), Объект.Сумма, ОписаниеОповещенияОбновитьДанные, ДополнительныеПараметры);
		
	КонецЕсли;	
	
КонецПроцедуры

Функция ПолучитьДолгиПоКонтрагентуПоЗазамСервер(Контрагент, СуммаПлатежа)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЗаказПокупателя.Ссылка КАК Документ,
		|	РасчетыПоЗаказамОстатки.СуммаОстаток КАК КОплате,
		|	ВЫБОР
		|		КОГДА ЕСТЬNULL(РасчетыПоЗаказамОстатки.СуммаОстаток, 0) = 0
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК Оплачен,
		|	ВЫБОР
		|		КОГДА ЕСТЬNULL(РасчетыПоЗаказамОстатки.СуммаОстаток, 0) > 0
		|				И ЕСТЬNULL(РасчетыПоЗаказамОстатки.СуммаОстаток, 0) < ЗаказПокупателя.СуммаДокумента
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК ЧастичноОплачен
		|ИЗ
		|	Документ.ЗаказПокупателя КАК ЗаказПокупателя
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.РасчетыПоЗаказам.Остатки КАК РасчетыПоЗаказамОстатки
		|		ПО ЗаказПокупателя.Ссылка = РасчетыПоЗаказамОстатки.Заказ
		|ГДЕ
		|	ЗаказПокупателя.Контрагент = &Контрагент
		|	И ЕСТЬNULL(РасчетыПоЗаказамОстатки.СуммаОстаток, 0) > 0
		|
		|УПОРЯДОЧИТЬ ПО
		|	Ссылка";
	
	
	Запрос.Параметры.Вставить("Контрагент", Контрагент);
	ТЗОстаткиПоДолгам = Запрос.Выполнить().Выгрузить();
	
	Если ТЗОстаткиПоДолгам.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ОстатокОтСуммыПлатежа = СуммаПлатежа;
	ТЗОстаткиПоДолгам.Колонки.Добавить("Сумма");
	Для Каждого СтрокаДолга Из ТЗОстаткиПоДолгам Цикл
		Если СтрокаДолга.КОплате > ОстатокОтСуммыПлатежа Тогда
			СтрокаДолга.Сумма = ОстатокОтСуммыПлатежа;
		Иначе
			СтрокаДолга.Сумма = СтрокаДолга.КОплате;
		КонецЕсли;
		
		ОстатокОтСуммыПлатежа = ОстатокОтСуммыПлатежа - СтрокаДолга.Сумма;
	КонецЦикла;	
	
	//Нам нужны только строки с заполненной суммой
	ИтоговаяТз = ТЗОстаткиПоДолгам.СкопироватьКолонки();
	Для Каждого СтрокаТЗДолги Из ТЗОстаткиПоДолгам Цикл           
		Если СтрокаТЗДолги.Сумма > 0 Тогда
			СтрокаИтоговойТЗ = ИтоговаяТз.Добавить();                 
			ЗаполнитьЗначенияСвойств(СтрокаИтоговойТЗ, СтрокаТЗДолги);
		КонецЕсли;
	КонецЦикла;	
	
	Возврат ИтоговаяТз.ВыгрузитьКолонку("Документ");
	
КонецФункции	

