&НаКлиенте
Процедура РаспределениеПлатежаОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
//Процедура ПослеВыбораДокумента(ВыбранныйДокумент, ДополнительныеПараметры) Экспорт
	
	Для каждого ВыбранныйДокумент из ВыбранноеЗначение Цикл
		Если НЕ ВыбранныйДокумент.Пустая() Тогда
			НоваяСтрока = Объект.РаспределениеПлатежа.Добавить();
			НоваяСтрока.Документ = ВыбранныйДокумент;
			//НоваяСтрока.Сумма = ПолучитьСуммуДокумента(НоваяСтрока.Документ);
			НоваяСтрока.Сумма = Объект.Сумма;
			
			Если ДобавлятьЗаказыВторогоПорядкаВРаспределение Тогда
				ДобавитьОснованиеЗаказаСервер(НоваяСтрока.Документ);
			КонецЕсли;
			//#7709
			Если ДобавлятьДокументыПродажиПоЗаказамПокупателей ИЛИ ДобавлятьДокументыПродажиПоЗаказДоговорам Тогда
				ДобавитьДокументыПродажиПоЗаказамСервер(НоваяСтрока.Документ);	
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Если ВыбранноеЗначение.Количество() > 0 Тогда
		РаспределениеОплаты(Неопределено);
		ОбновитьДанные();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РаспределениеПлатежаПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	Если НоваяСтрока Тогда
		РаспределениеОплаты(Неопределено);
		ОбновитьДанные();
	КонецЕсли;
КонецПроцедуры

