Процедура АвансыПодбор(Команда)
	
	АдресВыданныеАвансыВХранилище = ПоместитьВыданныеАвансыВХранилище();
	
	ПараметрыПодбора = Новый Структура(
		"АдресВыданныеАвансыВХранилище,
		|Организация,
		|Период,
		|Сотрудник,
		|Валюта,
		|Ссылка",
		АдресВыданныеАвансыВХранилище,
		Объект.Организация,
		Объект.Дата,
		Объект.Сотрудник,
		Объект.Валюта,
		Объект.Ссылка
	);
	
	Результат = Неопределено;	
	ОткрытьФорму("ОбщаяФорма.ФормаПодбораАвансовПодотчетнику", ПараметрыПодбора,,,,, 
		Новый ОписаниеОповещения("АвансыПодборЗавершение", ЭтотОбъект, Новый Структура("АдресВыданныеАвансыВХранилище", АдресВыданныеАвансыВХранилище)));
		
КонецПроцедуры
	
	// Функция помещает табличную часть ВыданныеАвансы во временное хранилище
