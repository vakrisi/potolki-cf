#Область ОбработчикиСобытий
	
Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	Если ЭтоНовый() Тогда		
		ИнициализироватьСлужебныеРеквизиты();		
	КонецЕсли;
	
	ОбщийМодуль.ЗаполнитьШапкуДокумента(ЭтотОбъект);
	Статья = Автор.СтатьяДДСПКО;	
	Если Касса.Владелец <> Организация Тогда
		Касса = Справочники.Кассы.ПустаяСсылка();
	КонецЕсли;
	
	ВидОперации = Перечисления.ВидыОперацийПриходныйКассовыйОрдер.ОплатаОтПокупателя;
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("Структура") Тогда
		Если ДанныеЗаполнения.Свойство("МассивДокументов") Тогда
			
			Если ДанныеЗаполнения.МассивДокументов.Количество() > 0 Тогда
				Если ТипЗнч(ДанныеЗаполнения.МассивДокументов[0]) = Тип("ДокументСсылка.ЗаказПокупателя") Тогда
					ЗаполнитьПоЗаказуПокупателя(ДанныеЗаполнения.МассивДокументов);
				ИначеЕсли ТипЗнч(ДанныеЗаполнения.МассивДокументов[0]) = Тип("ДокументСсылка.ЗаказДоговор") Тогда
					ЗаполнитьПоЗаказДоговору(ДанныеЗаполнения.МассивДокументов);
				ИначеЕсли ТипЗнч(ДанныеЗаполнения.МассивДокументов[0]) = Тип("ДокументСсылка.Монтаж") Тогда
					ЗаполнитьПоМонтажу(ДанныеЗаполнения.МассивДокументов);
				ИначеЕсли ТипЗнч(ДанныеЗаполнения.МассивДокументов[0]) = Тип("ДокументСсылка.РеализацияТоваровИУслуг") Тогда
					ЗаполнитьПоРеализации(ДанныеЗаполнения.МассивДокументов);
				ИначеЕсли ТипЗнч(ДанныеЗаполнения.МассивДокументов[0]) = Тип("ДокументСсылка.СчетНаОплату") Тогда
					ЗаполнитьПоСчетуНаОплату(ДанныеЗаполнения.МассивДокументов);	
				КонецЕсли;
			КонецЕсли;
			
		ИначеЕсли ДанныеЗаполнения.Свойство("Основание") Тогда
			
			Если ТипЗнч(ДанныеЗаполнения.Основание) = Тип("ДокументСсылка.ЗаказДоговор")
				И ДанныеЗаполнения.Свойство("РассрочкаДатаПлатежа") 
				И ДанныеЗаполнения.Свойство("РассрочкаСумма") Тогда
				ЗаполнитьПоЗаказДоговору(ДанныеЗаполнения.Основание, ДанныеЗаполнения.РассрочкаДатаПлатежа, ДанныеЗаполнения.РассрочкаСумма);
			КонецЕсли;
			
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ЗаказПокупателя") Тогда
		ЗаполнитьПоЗаказуПокупателя(ДанныеЗаполнения);
		
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ЗаказДоговор") Тогда
		ЗаполнитьПоЗаказДоговору(ДанныеЗаполнения);
		
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.Замена") Тогда
		// Заполнение шапки
		//Комментарий = ДанныеЗаполнения.Основание.Комментарий; //#5849
		Контрагент = ДанныеЗаполнения.Основание.Контрагент;
		Договор = ДанныеЗаполнения.Основание.ДоговорКонтрагента;
		Сумма = ?(ДанныеЗаполнения.СуммаДокумента > 0, ДанныеЗаполнения.СуммаДокумента, 0);
		Валюта = ДанныеЗаполнения.Основание.Валюта;
		ДобавитьОснование(ДанныеЗаполнения);
		Организация = ДанныеЗаполнения.Основание.Организация;
		
		Если Сумма > 0 И ТипЗнч(ДанныеЗаполнения.Основание) = Тип("ДокументСсылка.ЗаказДоговор") Тогда
			НоваяСтрока = РаспределениеПлатежа.Добавить();
			НоваяСтрока.Документ = ДанныеЗаполнения.Основание;
			НоваяСтрока.Сумма = Сумма;
			НоваяСтрока.СуммаВВалютеДокумента = Сумма;
		КонецЕсли;
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.РеализацияТоваровИУслуг") Тогда
		ЗаполнитьПоРеализации(ДанныеЗаполнения);
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.Монтаж") Тогда
		ЗаполнитьПоМонтажу(ДанныеЗаполнения);
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ЗаявкаНаДоставку") Тогда
		
		ДобавитьОснование(ДанныеЗаполнения);
		Организация = ДанныеЗаполнения.Организация;
		Контрагент  = ДанныеЗаполнения.Получатель;
		Договор 	= ДанныеЗаполнения.Получатель.ОсновнойДоговор;
		Сумма  		= ДанныеЗаполнения.СтоимостьДоставки;
		Валюта 		= ДанныеЗаполнения.Валюта;
		
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.СчетНаОплату") Тогда	
		
		ЗаполнитьПоСчетуНаОплату(ДанныеЗаполнения);
		
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.РасходныйКассовыйОрдер") Тогда
		ДобавитьОснование(ДанныеЗаполнения);
		Организация 	= ДанныеЗаполнения.Организация;
		Подразделение 	= ДанныеЗаполнения.Подразделение; // № 12857
		Контрагент 		= ДанныеЗаполнения.Контрагент;
		Договор 		= ДанныеЗаполнения.Договор;
		//Комментарий = ДанныеЗаполнения.Комментарий; //#5849
		Валюта 			= ДанныеЗаполнения.Валюта;
		Сумма  			= ДанныеЗаполнения.Сумма;
		Касса  			= ДанныеЗаполнения.Касса;
		Если ДанныеЗаполнения.ВидОперации = Перечисления.ВидыОперацийРасходныйКассовыйОрдер.ВыдачаПодотчетнику Тогда
			ВидОперации = Перечисления.ВидыОперацийПриходныйКассовыйОрдер.ВозвратОтПодотчетника;
			//УДАЛИТЬ_ДокументВыдачиДС = ДанныеЗаполнения;
			Сотрудник = ДанныеЗаполнения.Сотрудник;
			
			//#14021 
			Сумма = 0;			
			ЗапросОстатка = Новый Запрос;
			ЗапросОстатка.УстановитьПараметр("ДокументВыдачиДС", ДанныеЗаполнения);
			ЗапросОстатка.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	РасчетыОстатки.ДокументВыдачиДС КАК Документ,
			|	РасчетыОстатки.СуммаОстаток КАК Сумма
			|ИЗ
			|	РегистрНакопления.РасчетыСПодотчетникамиПоДокументамАвансов.Остатки(, ДокументВыдачиДС = &ДокументВыдачиДС) КАК РасчетыОстатки";
			ВыборкаОстатка = ЗапросОстатка.Выполнить().Выбрать();
			Если ВыборкаОстатка.Следующий() Тогда
				Сумма =   ВыборкаОстатка.Сумма;
				ЗаполнитьЗначенияСвойств(ВыданныеАвансы.Добавить(), ВыборкаОстатка);
			КонецЕсли;			  
			
			//#7080	
		ИначеЕсли ДанныеЗаполнения.ВидОперации = Перечисления.ВидыОперацийРасходныйКассовыйОрдер.ОплатаПоставщику Тогда
			ВидОперации = Перечисления.ВидыОперацийПриходныйКассовыйОрдер.ВозвратОтПоставщика;
			//Основания.Очистить(); // #13456 закомментировано
			РаспределениеПлатежа.Загрузить(ДанныеЗаполнения.РаспределениеПлатежа.Выгрузить());
		КонецЕсли;
		
		//#7080
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ЗаказПоставщику") Тогда
		ВидОперации 	= Перечисления.ВидыОперацийПриходныйКассовыйОрдер.ВозвратОтПоставщика;
		Организация 	= ДанныеЗаполнения.Организация;
		Подразделение 	= ДанныеЗаполнения.Подразделение; // № 12857
		Контрагент 		= ДанныеЗаполнения.Контрагент;
		Договор 		= ДанныеЗаполнения.ДоговорКонтрагента;
		Сумма  			= ДанныеЗаполнения.СуммаДокумента;
		Валюта 			= ДанныеЗаполнения.Валюта;
		
		НоваяСтрока = РаспределениеПлатежа.Добавить();
		НоваяСтрока.Документ = ДанныеЗаполнения;
		НоваяСтрока.Сумма = ДанныеЗаполнения.СуммаДокумента;
		
		ДобавитьОснование(ДанныеЗаполнения);
		
	КонецЕсли;
	
	// №9078 определение статьи перенесено сюда сверху, т.к. вид операции может быть изменен взависимости от основания
	СтатьяДоходов = ФинансыСервер.ПолучитьСтатьюДоходовРасходов(ЭтотОбъект, ВидОперации);
	СтатьяДоходовПоНачислению = СтатьяДоходов; //#9708
	
	Если ЗначениеЗаполнено(Контрагент) Тогда
		КатегорияКонтрагента = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Контрагент, "Категория");	
	КонецЕсли;
	
	Если ЭтоНовый() Тогда
		ДозаполнитьПоУмолчанию();
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)	
	
	ИнициализироватьСлужебныеРеквизиты(); //#14482
	
	РаспределениеПлатежа.Очистить();	
	ЧекФискализирован = Ложь;
	НомерСменыККМ = 0;
	НомерЧекаККМ = 0;
	
	ДозаполнитьПоУмолчанию();
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	ПолеСтатьяДДСОбязательно = Константы.ОбязательноеЗаполнениеСтатьиВДенежныхДокументах.Получить();	
	Если НЕ ЗначениеЗаполнено(Статья) И ПолеСтатьяДДСОбязательно Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
		НСтр("ru = 'Не заполнена статья движения денежных средств!'"), ЭтотОбъект,
		"Статья",,Отказ);
	КонецЕсли;
	
	Если ВидОперации = Перечисления.ВидыОперацийПриходныйКассовыйОрдер.ВозвратОтПодотчетника Тогда
		ИзрасходованоИтог = ВыданныеАвансы.Итог("Сумма");	
		
		Если ИзрасходованоИтог > Сумма Тогда
			ТекстСообщения = НСтр("ru = 'Израсходованная сумма авансов превышает сумму по документу!'");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, ЭтотОбъект, "ВыданныеАвансы[0].Сумма", ,Отказ);
		КонецЕсли;	
	КонецЕсли;
	
	//++ №12420
	Если ВидОперации = Перечисления.ВидыОперацийПриходныйКассовыйОрдер.ОплатаОтПокупателя
		Или ВидОперации = Перечисления.ВидыОперацийПриходныйКассовыйОрдер.ВозвратОтПоставщика
		Или ВидОперации = Перечисления.ВидыОперацийПриходныйКассовыйОрдер.ПолучениеКредита
		Или ВидОперации = Перечисления.ВидыОперацийПриходныйКассовыйОрдер.ВозвратЗайма
		Тогда
		ПроверяемыеРеквизиты.Добавить("Контрагент");
		ПроверяемыеРеквизиты.Добавить("Договор");
	КонецЕсли;
	
	Если ВидОперации = Перечисления.ВидыОперацийПриходныйКассовыйОрдер.ВозвратОтПодотчетника Тогда
		ПроверяемыеРеквизиты.Добавить("Сотрудник");
	КонецЕсли;
	//-- №12420
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Документы.ЗаказПокупателя.ПроверитьЗаполнениеНаОснованииЗаказа(ЭтотОбъект, Отказ, РежимЗаписи);
	
	ФинансыСервер.ДокументПриходаПередЗаписью(ЭтотОбъект, Истина, ВидОперации, Отказ, РежимЗаписи, РежимПроведения);
	
	//#13710
	ОбщийМодульСервер.ПроверитьИзменениеВзаиморасчетовПередЗаписью(ЭтотОбъект, РежимЗаписи);
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, Режим)
	
	Если НЕ Касса.Владелец = Организация Тогда
		Сообщить("Касса " + Касса + " не принадлежит организации "+Организация+". Проведение отменено.");
		Отказ = Истина;
	КонецЕсли;
	Если НЕ Касса.Валюта = Валюта Тогда
		Если Касса.КонтролироватьВалюту Тогда
			Сообщить("Касса " + Касса + " хранит только валюту " + Касса.Валюта + ". В документе указана валюта " + Валюта + ". Проведение отменено.");
			Отказ = Истина;
			Возврат;
