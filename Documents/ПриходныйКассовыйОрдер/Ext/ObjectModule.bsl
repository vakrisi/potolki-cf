Функция ЗаменитьПараметрыВШаблоне(ТекстСМС)
	//Допустимые параметры:
	//%Организация - наименование организации
	//%Контрагент - наименование контрагента
	//%ДатаДокумента - дата ПКО
	//%НомерДокумента - номер ПКО
	//%СуммаДокумента - сумма ПКО
	//%ВалютаДокумента - валюта ПКО
	
	Если ПустаяСтрока(ТекстСМС) Тогда
		Сообщить ("ВНИМАНИЕ!!! В системе не заданы шаблоны СМС по ПКО!!!", СтатусСообщения.ОченьВажное);
		ТекстСМС = "%ДатаДокумента. Поступил платеж на сумму %СуммаДокумента. %Организация";
	КонецЕсли;
	ТекстСМС = СтрЗаменить(ТекстСМС, "%Организация",    Организация.Наименование);
	ТекстСМС = СтрЗаменить(ТекстСМС, "%Контрагент",     Контрагент.Наименование);
	ТекстСМС = СтрЗаменить(ТекстСМС, "%ДатаДокумента",  Лев(Дата, 10));
	Попытка
		ТекстСМС = СтрЗаменить(ТекстСМС, "%НомерДокумента", Формат(Число(СтрЗаменить(Номер, Организация.ПрефиксОрганизации, "")), "ЧГ=0"));
	Исключение
	КонецПопытки;
	ТекстСМС = СтрЗаменить(ТекстСМС, "%СуммаДокумента", Сумма);
	ТекстСМС = СтрЗаменить(ТекстСМС, "%ВалютаДокумента", Валюта.Наименование);
	Возврат ТекстСМС;
	
КонецФункции

Функция ПолучитьОстатокДолгаПоЗаказу(Документ) ЭКСПОРТ
		
		Заказ = Неопределено;
		Если ТипЗнч(Документ) = Тип("ДокументСсылка.Монтаж") Тогда
			Заказ = Документ.Основание;
		ИначеЕсли ТипЗнч(Документ) = Тип("ДокументСсылка.ЗаказДоговор") Тогда
			Заказ = Документ;
		ИначеЕсли ТипЗнч(Документ) = Тип("ДокументСсылка.ЗаказПокупателя") Тогда
			Заказ = Документ;
			//НАЧАЛО: Переход на 2.0
			//ИначеЕсли ТипЗнч(Документ) = Тип("ДокументСсылка.ЗаказНаПроизводство") Тогда
			//	Заказ = Документ;
			//КОНЕЦ: Переход на 2.0
		ИначеЕсли ТипЗнч(Документ) = Тип("ДокументСсылка.СчетНаОплату") Тогда
			Заказ = Документ;
		ИначеЕсли ТипЗнч(Документ) = Тип("ДокументСсылка.РеализацияТоваровИУслуг") Тогда
			Возврат Документ.СуммаДокумента;
		КонецЕсли;
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	РасчетыПоЗаказамОстатки.СуммаОстаток
		|ИЗ
		|	РегистрНакопления.РасчетыПоЗаказам.Остатки(, Заказ = &Заказ) КАК РасчетыПоЗаказамОстатки";
		Запрос.УстановитьПараметр("Заказ",Заказ);
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Возврат Выборка.СуммаОстаток;
		КонецЦикла;
		
		Возврат 0;
		
	КонецФункции
	
#КонецЕсли