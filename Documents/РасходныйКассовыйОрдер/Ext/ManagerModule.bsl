				//цену высчитаем из суммы, т.к. могли быьт скидки
				Если НЕ НоваяСтрока.Количество = 0 Тогда
					НоваяСтрока.Цена = Окр(НоваяСтрока.Сумма / НоваяСтрока.Количество,2);
				КонецЕсли;
			КонецЦикла;
			//услуги
			Для Каждого ТекущаяСтрока Из ДокументСсылкаОснование.Услуги Цикл
				НоваяСтрока = ТаблицаТоваров.Добавить();
				НоваяСтрока.Номенклатура = ТекущаяСтрока.Номенклатура;
				НоваяСтрока.Количество = ТекущаяСтрока.Количество;
				НоваяСтрока.Цена = ТекущаяСтрока.Цена;
				НоваяСтрока.Сумма = ТекущаяСтрока.Сумма;
				НоваяСтрока.НомерСекции = ДокументСсылка.Касса.СекцияПоУмолчанию;
				НоваяСтрока.СтавкаНДС = ПредопределенноеЗначение("Перечисление.СтавкиНДС.БезНДС");
				//цену высчитаем из суммы, т.к. могли быьт скидки
				Если НЕ НоваяСтрока.Количество = 0 Тогда
					НоваяСтрока.Цена = Окр(НоваяСтрока.Сумма / НоваяСтрока.Количество,2);
				КонецЕсли;
			КонецЦикла;
		ИначеЕсли ТипЗнч(ДокументСсылкаОснование) = Тип("ДокументСсылка.ЗаявкаНаДоставку")  
			Тогда
			//одна строка - доставка груза
			НоваяСтрока = ТаблицаТоваров.Добавить();
			НоваяСтрока.Количество = 1;
			НоваяСтрока.Цена = ДокументСсылка.Сумма;
			НоваяСтрока.Сумма = ДокументСсылка.Сумма;
			НоваяСтрока.НомерСекции = ДокументСсылка.Касса.СекцияПоУмолчанию;
			НоваяСтрока.СтавкаНДС = ПредопределенноеЗначение("Перечисление.СтавкиНДС.БезНДС");
		КонецЕсли;
	Иначе
		//укажем что это предоплата
		НоваяСтрока = ТаблицаТоваров.Добавить();
		НоваяСтрока.Количество = 1;
		НоваяСтрока.Цена = ДокументСсылка.Сумма;
