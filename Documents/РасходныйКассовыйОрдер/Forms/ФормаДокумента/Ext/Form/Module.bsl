&НаКлиенте
Процедура Подключаемый_ОбработатьЗаписьОбъекта()
	
	ОбщийМодульКлиент.ОбработатьЗаписьОбъектаВФорме(ЭтотОбъект, ПараметрыДляЗаписи);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьПроверкиИЗадатьВопросыПередЗаписью(Отказ, ПараметрыЗаписи)
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ПараметрыЗаписи", ПараметрыЗаписи);
	ДополнительныеПараметры.Вставить("ЭтотОбъект", ЭтотОбъект);
	
	Отказ = Ложь;
	
	Если ЗначениеЗаполнено(Объект.Ссылка)
		И Объект.СписыватьБонусы 
		И НЕ мСуммаБонусов = Объект.СуммаБонусовКСписаниюПоДисконтнойКарте Тогда
		
		Отказ = Истина;
		ОписаниеОповещения = Новый ОписаниеОповещения("ИзменениеБонусовПодтверждениеПередЗаписью", ЭтотОбъект, ДополнительныеПараметры);
		БонусыКлиент.ПодтвердитьИзменениеСуммыБонусов(ОписаниеОповещения, Объект.СуммаБонусовКСписаниюПоДисконтнойКарте, мСуммаБонусов);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ИзменениеБонусовПодтверждениеПередЗаписью(ОтветНаВопрос, ДополнительныеПараметры) Экспорт
	
	Отказ = Ложь;
	
	Если ОтветНаВопрос = КодВозвратаДиалога.Да Тогда
		Отказ = Ложь;
	Иначе
		Возврат;
	КонецЕсли;
	
	ДополнительныеПараметры.Вставить("Отказ", Отказ);
	ОбщийМодульКлиент.ЗаписатьОбъектПриНеобходимости(ЭтотОбъект, ДополнительныеПараметры.ПараметрыЗаписи,, Истина);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСтавкуНДСПоОрганизации()
	
	Если Объект.ВидОперации = Перечисления.ВидыОперацийРасходныйКассовыйОрдер.ВозвратПокупателю Тогда
		УчитыватьНДС = УчетНДС.ОрганизацияЯвляетсяПлательщикомНДС(Объект.Организация);
		Объект.СтавкаНДС = УчетНДС.СтавкаНДСПоУмолчанию(Объект.Организация);
	Иначе
		УчитыватьНДС = Истина;
	КонецЕсли;
	ФинансыКлиентСервер.ПересчитатьСуммуНДС(Объект, УчитыватьНДС);
	
КонецПроцедуры

#КонецОбласти

&НаКлиенте
Процедура ОбновитьВидимостьГруппыБонусов()
	
	Элементы.ГруппаБонусыТекущиеДанные.Видимость = Объект.СписыватьБонусы И (Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийРасходныйКассовыйОрдер.ВозвратПокупателю"));
	Элементы.ДисконтнаяКарта.Видимость = Объект.СписыватьБонусы И Объект.СлужебныйУчетБонусовПоДисконтнымКартам;
	
КонецПроцедуры

&НаСервере
Процедура ПересчитатьБонусыПоДокументу()
	
	Объект.СуммаБонусовКСписаниюПоДисконтнойКарте = 0;
	Если Объект.СписыватьБонусы Тогда		
		//Объект.СуммаБонусовКСписаниюПоДисконтнойКарте = БонусыСервер.ПолучитьСуммуБонусовКНачислениюПоДокументуОплаты(Объект.Дата, Объект.Организация, Объект.Контрагент.Категория, Объект.Касса, Объект.Сумма, Объект.Ссылка, Объект.ДисконтнаяКарта, Объект.СлужебныйУчетБонусовПоДисконтнымКартам);
		СтруктураБонусов = БонусыСервер.ПолучитьСуммуБонусовКНачислениюПоДокументуОплаты(Объект.Дата, Объект.Организация, Объект.КатегорияКонтрагента, Объект.Касса, Объект.Сумма, Объект.Ссылка, Объект.ДисконтнаяКарта, Объект.СлужебныйУчетБонусовПоДисконтнымКартам);
		Объект.СуммаБонусовКСписаниюПоДисконтнойКарте = СтруктураБонусов.СуммаБонусов;
		Объект.ДокументНАНБ = СтруктураБонусов.ДокументНАНБ;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДисконтнаяКартаПриИзменении(Элемент)
	ПересчитатьБонусыПоДокументу();
КонецПроцедуры

&НаКлиенте
Процедура Распределение_ПодобратьПоОстаткам(Команда)
	
	Оповещение = Новый ОписаниеОповещения("ПодобратьПоОстаткамЗавершение", ЭтотОбъект);
	ОбщийМодульКлиент.ПроверитьВозможностьПодбораЗаказовВДокументРасхода(Оповещение, ЭтаФорма, Объект.РаспределениеПлатежа);
	
КонецПроцедуры

&НаКлиенте
Процедура ПодобратьПоОстаткамЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	АдресПлатежейВХранилище = ПоместитьРасшифровкуПлатежаВХранилище();
	
	ПараметрыПодбора = Новый Структура;
	ПараметрыПодбора.Вставить("АдресПлатежейВХранилище", АдресПлатежейВХранилище);
	ПараметрыПодбора.Вставить("Организация", Объект.Организация);
	ПараметрыПодбора.Вставить("Контрагент", Объект.Контрагент);
	ПараметрыПодбора.Вставить("Валюта", Объект.Валюта);
	ПараметрыПодбора.Вставить("СуммаДокумента", Объект.Сумма);
	ПараметрыПодбора.Вставить("ДатаДокумента", Объект.Дата);
	
	ОткрытьФорму("ОбщаяФорма.ФормаПодбораПоРасчетамСКонтрагентами",	ПараметрыПодбора, ЭтаФорма);
	
КонецПроцедуры

&НаСервере
Функция ПоместитьРасшифровкуПлатежаВХранилище()
	
	АдресПлатежейВХранилище = ПоместитьВоВременноеХранилище(Объект.РаспределениеПлатежа.Выгрузить(), УникальныйИдентификатор);
	Возврат АдресПлатежейВХранилище;
	
КонецФункции

&НаСервере
Процедура ПолучитьРаспределениеПлатежаИзХранилища(АдресПлатежейВХранилище)
	
	Объект.РаспределениеПлатежа.Загрузить(ПолучитьИзВременногоХранилища(АдресПлатежейВХранилище));
	ОбновитьДанные();
	
КонецПроцедуры

&НаКлиенте
Процедура Распределение_Команда(Команда)
	
	ИмяФормыВыбора = "Документ." + СтрЗаменить(Команда.Имя, "Распределение_", "") + ".ФормаВыбора";
	Если Не Объект.Контрагент.Пустая() Тогда
		ЗначениеОтбора = Новый Структура("Контрагент", Объект.Контрагент);
		ПараметрВыбора = Новый Структура("Отбор", ЗначениеОтбора);
		ПараметрВыбора.Вставить("МножественныйВыбор", Истина);
		ОткрытьФорму(ИмяФормыВыбора, ПараметрВыбора, Элементы.РаспределениеПлатежа);
		// результат обрабатывается в РаспределениеПлатежаОбработкаВыбора как владельца формы выбора
	Иначе
		Состояние("Не указан контрагент");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РаспределениеПлатежаОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	Для каждого ВыбранныйДокумент из ВыбранноеЗначение Цикл
		Если НЕ ВыбранныйДокумент.Пустая() Тогда
			НоваяСтрока = Объект.РаспределениеПлатежа.Добавить();
			НоваяСтрока.Документ = ВыбранныйДокумент;
			НоваяСтрока.Сумма = Объект.Сумма;
		КонецЕсли;
	КонецЦикла;
	
	//ОбновитьДанные();
	
КонецПроцедуры

