#Область УправлениеЭлементамиФормы

&НаСервере
Процедура УстановитьДоступностьЭлементов()
	
	ТолькоПросмотрЭлементов = Ложь;
	
	ДокументОснование = Неопределено;
	Если Объект.Основания.Количество() > 0 Тогда
		ДокументОснование = Объект.Основания[0].Основание;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДокументОснование) И ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.ЗаявкаНаРасходованиеДенежныхСредств") Тогда
		ТолькоПросмотрЭлементов = Истина;
		
		Элементы.Организация.ТолькоПросмотр = НЕ ДоступноИзменениеОрганизацииВДокументахНаОснованииЗаявки;
		Элементы.Касса.ТолькоПросмотр = НЕ ДоступноИзменениеКассыВДокументахНаОснованииЗаявки;
	КонецЕсли;
	
	ЭлементыТолькоПросмотр = Новый Массив;
	ЭлементыТолькоПросмотр.Добавить(Элементы.Номер);
	//ЭлементыТолькоПросмотр.Добавить(Элементы.Организация);
	ЭлементыТолькоПросмотр.Добавить(Элементы.Подразделение);
	ЭлементыТолькоПросмотр.Добавить(Элементы.Сумма);
	ЭлементыТолькоПросмотр.Добавить(Элементы.Валюта);
	ЭлементыТолькоПросмотр.Добавить(Элементы.Статья);
	ЭлементыТолькоПросмотр.Добавить(Элементы.СтатьяРасходов);
	ЭлементыТолькоПросмотр.Добавить(Элементы.СтатьяРасходовПоНачислению);
	ЭлементыТолькоПросмотр.Добавить(Элементы.ВидОперации);
	ЭлементыТолькоПросмотр.Добавить(Элементы.Контрагент);
	ЭлементыТолькоПросмотр.Добавить(Элементы.Договор);
	ЭлементыТолькоПросмотр.Добавить(Элементы.Сотрудник);
	ЭлементыТолькоПросмотр.Добавить(Элементы.ГруппаРаспределениеПлатежа);
	ЭлементыТолькоПросмотр.Добавить(Элементы.ГруппаЗарплатаСотрудникам);
	ЭлементыТолькоПросмотр.Добавить(Элементы.ОтображениеПериодаРегистрации);
	
	Для каждого Элемент Из ЭлементыТолькоПросмотр Цикл
		Элемент.ТолькоПросмотр = ТолькоПросмотрЭлементов;
	КонецЦикла;
	
	ЭлементыДоступность = Новый Массив;
	ЭлементыДоступность.Добавить(Элементы.РаспределениеПлатежаРаспределение_ЗаказПоставщику);
	Для каждого Элемент Из ЭлементыДоступность Цикл
		Элемент.Доступность = НЕ ТолькоПросмотрЭлементов;
	КонецЦикла;	
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьТекущийДолгКлиента(Знач Организация, Знач Контрагент, Знач Договор, Знач ВалютаДокумента, Знач ВалютаУчета, Дата)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВзаиморасчетыСКонтрагентамиОстатки.СуммаОстаток
	|ИЗ
	|	РегистрНакопления.ВзаиморасчетыСКонтрагентами.Остатки(
	|			,
	|			Договор = &Договор
	|				И Контрагент = &Контрагент
	|				И Организация = &Организация) КАК ВзаиморасчетыСКонтрагентамиОстатки";
	Запрос.УстановитьПараметр("Организация",Организация);
	Запрос.УстановитьПараметр("Контрагент",Контрагент);
	Запрос.УстановитьПараметр("Договор",Договор);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		// №7942 сумму долга показываем в валюте текущего документа, если валюта отличается от валюты учета
		Сумма = Выборка.СуммаОстаток;
		Если НЕ ВалютаДокумента = ВалютаУчета Тогда
			Сумма = Окр(РаботаСВалютой.ПересчитатьИзВалютыВВалюту(ВалютаУчета, ВалютаДокумента, Дата, Сумма), 2);
		КонецЕсли;	
		Возврат Сумма;
	КонецЦикла;
	
	Возврат 0;
	
КонецФункции

&НаСервере
Процедура ОбновитьДанные()
	
	Элементы.ГруппаКонтрагент.Видимость = Ложь;
	Элементы.ГруппаСотрудник.Видимость = Ложь;
	Элементы.ГруппаЗарплатаСотрудникам.Видимость = Ложь;
	Элементы.ГруппаЗарплатаСотрудникамПериод.Видимость = Ложь;
	Элементы.ГруппаРаспределениеПлатежа.Видимость = Ложь;
	Элементы.ОснованияЗаполнитьОснованияПоРаспределению.Видимость = Ложь;
	Элементы.ГруппаРеквизитовЗайма.Видимость = Ложь;
	Элементы.Сумма.ТолькоПросмотр = Ложь;
	Элементы.Сотрудник.АвтоОтметкаНезаполненного = Ложь;
	//КоманднаяПанель.ПодчиненныеЭлементы.Найти("ФормаПечать").ПодчиненныеЭлементы.Найти("ФормаПечатьРасходноКассовыйОрдерСотрудникиОбший").Видимость = Ложь;	
	Элементы.ФормаПечатьЧека.Доступность = Ложь;
	Элементы.РаспределениеПлатежаГруппаВозвратПокупателю.Видимость = Ложь;
	Элементы.РаспределениеПлатежаГруппаОплатаПоставщику.Видимость = Ложь;
	
	//#9708
	Элементы.СтатьяРасходовПоНачислению.Видимость = ПолучитьФункциональнуюОпцию("НекассовыйМетодВеденияУчетаДоходовРасходов") 
	И Объект.ВидОперации = Перечисления.ВидыОперацийРасходныйКассовыйОрдер.ПрочееСписание
	//++ №13755
	И ЗначениеЗаполнено(Объект.Ссылка)
	И НЕ (Объект.СтатьяРасходов = Объект.СтатьяРасходовПоНачислению);
	//-- №13755
	
	Элементы.СтатьяРасходов.Видимость = Истина;	// #12545							
	//управляем видимостью элементов в зависимости от того, какой вид операции
	Если Объект.ВидОперации = Перечисления.ВидыОперацийРасходныйКассовыйОрдер.ОплатаПоставщику Тогда
		Элементы.ГруппаКонтрагент.Видимость = Истина;
		Элементы.ДекорацияСуммаДолга.Заголовок = ПолучитьТекущийДолгКлиента(Объект.Организация, Объект.Контрагент, Объект.Договор, Объект.Валюта, ВалютаУчета, ТекущаяДатаСеанса());
		// №7942 валюту показываем выбранную в текущем документе
		Элементы.ДекорацияНадписьВалютаДолга.Заголовок = Объект.Валюта; //Константы.ВалютаУчета.Получить();
		Элементы.ГруппаРаспределениеПлатежа.Видимость = Истина;
		Элементы.ОснованияЗаполнитьОснованияПоРаспределению.Видимость = Истина;
		Элементы.РаспределениеПлатежаГруппаОплатаПоставщику.Видимость = Истина;
		
		// №4119
	ИначеЕсли Объект.ВидОперации = Перечисления.ВидыОперацийРасходныйКассовыйОрдер.ВыдачаЗайма Тогда
		Элементы.ГруппаКонтрагент.Видимость = Истина;
		Элементы.ДекорацияСуммаДолга.Заголовок = ПолучитьТекущийДолгКлиента(Объект.Организация, Объект.Контрагент, Объект.Договор, Объект.Валюта, ВалютаУчета, ТекущаяДатаСеанса());
		Элементы.ДекорацияНадписьВалютаДолга.Заголовок = Объект.Валюта;
		Элементы.ГруппаРаспределениеПлатежа.Видимость = Ложь;
		Элементы.СтатьяРасходов.Видимость = Ложь;
		Элементы.РаспределениеПлатежаГруппаОплатаПоставщику.Видимость = Истина;	
		
	ИначеЕсли Объект.ВидОперации = Перечисления.ВидыОперацийРасходныйКассовыйОрдер.ВозвратКредита Тогда
		Элементы.ГруппаКонтрагент.Видимость = Истина;
		Элементы.ГруппаРеквизитовЗайма.Видимость = Истина;
		Элементы.ДекорацияСуммаДолга.Заголовок = ПолучитьТекущийДолгКлиента(Объект.Организация, Объект.Контрагент, Объект.Договор, Объект.Валюта, ВалютаУчета, ТекущаяДатаСеанса());
		Элементы.ДекорацияНадписьВалютаДолга.Заголовок = Объект.Валюта;
		Элементы.ГруппаРаспределениеПлатежа.Видимость = Ложь;
		Элементы.СтатьяРасходов.Видимость = Истина;
		Элементы.РаспределениеПлатежаГруппаОплатаПоставщику.Видимость = Истина;	
		
		
	ИначеЕсли Объект.ВидОперации = Перечисления.ВидыОперацийРасходныйКассовыйОрдер.ВозвратПокупателю Тогда
		Элементы.ГруппаКонтрагент.Видимость = Истина;
		Элементы.ДекорацияСуммаДолга.Заголовок = ПолучитьТекущийДолгКлиента(Объект.Организация, Объект.Контрагент, Объект.Договор, Объект.Валюта, ВалютаУчета, ТекущаяДатаСеанса());
		// №7942 валюту показываем выбранную в текущем документе
		Элементы.ДекорацияНадписьВалютаДолга.Заголовок = Объект.Валюта; //Константы.ВалютаУчета.Получить();
		Элементы.ГруппаРаспределениеПлатежа.Видимость = Истина;
		Элементы.ОснованияЗаполнитьОснованияПоРаспределению.Видимость = Истина;
		Элементы.ФормаПечатьЧека.Доступность = Истина;
		Элементы.РаспределениеПлатежаГруппаВозвратПокупателю.Видимость = Истина;
		
	ИначеЕсли Объект.ВидОперации = Перечисления.ВидыОперацийРасходныйКассовыйОрдер.ВыдачаПодотчетнику Тогда
		Элементы.ГруппаСотрудник.Видимость = Истина;
		Элементы.Сотрудник.АвтоОтметкаНезаполненного = Истина;
		
	ИначеЕсли Объект.ВидОперации = Перечисления.ВидыОперацийРасходныйКассовыйОрдер.ЗарплатаСотрудникам Тогда
		//КоманднаяПанель.ПодчиненныеЭлементы.Найти("ФормаПечать").ПодчиненныеЭлементы.Найти("ФормаПечатьРасходноКассовыйОрдерСотрудникиОбший").Видимость = Истина;
		Элементы.ГруппаЗарплатаСотрудникам.Видимость = Истина;
		Элементы.ГруппаЗарплатаСотрудникамПериод.Видимость = ОтображатьПериодРегистрации;
		Элементы.Сумма.ТолькоПросмотр = Истина;
		Объект.Сумма = Объект.ЗарплатаСотрудникам.Итог("Сумма");
		
	ИначеЕсли Объект.ВидОперации = Перечисления.ВидыОперацийРасходныйКассовыйОрдер.Инкассация Тогда
		Элементы.СтатьяРасходов.Видимость = Ложь; // #12545
		
	КонецЕсли;
	
	СписокДокументовРаспределения = Объект.РаспределениеПлатежа.Выгрузить(,"Документ");
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ВЫБОР КОГДА 
	|		РасчетыСКонтрагентами.СуммаОстаток < 0 
	|			ТОГДА -РасчетыСКонтрагентами.СуммаОстаток
	|		ИНАЧЕ 0 
	|	КОНЕЦ КАК ОсталосьРаспределить,
	|	РасчетыСКонтрагентами.Заказ КАК Заказ,
	|	РасчетыСКонтрагентами.Заказ.СуммаДокумента КАК СуммаДокумента
	|ИЗ
	|	РегистрНакопления.РасчетыСКонтрагентами.Остатки(, Заказ В (&Заказ)) КАК РасчетыСКонтрагентами";
	Запрос.УстановитьПараметр("Заказ", СписокДокументовРаспределения);
	ТаблицаПоДокументам = Запрос.Выполнить().Выгрузить();
	Для Каждого СтрокаРаспределения Из Объект.РаспределениеПлатежа Цикл
		Если ТипЗнч(СтрокаРаспределения.Документ) = Тип("ДокументСсылка.ЗаказПоставщику") Тогда
			СтрокаРаспределения.Поставщик = СтрокаРаспределения.Документ.Контрагент;
			СтрокаРаспределения.СрокПоставки = СтрокаРаспределения.Документ.СрокПоставки;
			Если ТипЗнч(СтрокаРаспределения.Документ.Основание) = Тип("ДокументСсылка.ЗаказДоговор") Тогда
				СтрокаРаспределения.НомерДоговора = СтрокаРаспределения.Документ.Основание.НомерДоговора;
			КонецЕсли;	
			Отбор = Новый Структура;
			Отбор.Вставить("Заказ", СтрокаРаспределения.Документ);
			НайденныеСтроки = ТаблицаПоДокументам.НайтиСтроки(Отбор);
			Если НайденныеСтроки.Количество() > 0 Тогда
				ЗаполнитьЗначенияСвойств(СтрокаРаспределения, НайденныеСтроки[0]);
			Иначе
				Попытка
					СтрокаРаспределения.СуммаДокумента = СтрокаРаспределения.Документ.СуммаДокумента;
				Исключение
				КонецПопытки;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	УстановитьДоступностьЭлементов();
	ФинансыСервер.ОбновитьВидимостьИКурсВалюты(ЭтотОбъект);
	
КонецПроцедуры

