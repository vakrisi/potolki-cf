#Область ПеременныеФормы

&НаКлиенте
Перем мСуммаБонусов;

&НаКлиенте
Перем ПараметрыДляЗаписи Экспорт;

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ВалютаУчета = Константы.ВалютаУчета.Получить();
	
	ОтображениеПериодаРегистрации = Формат(Объект.ПериодРегистрации, "ДФ='MMMM yyyy'");
	ОтображатьПериодРегистрации   = Константы.ОтражатьДвиженияПоРасчетуСПерсоналомПоПериодуРегистрации.Получить();
	
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда		
		ПриЧтенииСозданииНаСервере();
		ПересчитатьБонусыПоДокументу();		
	Иначе
		ЭтаФорма.ТолькоПросмотр = ПраваПользователей.ДокументТолькоПросмотр(Объект.Ссылка);
	КонецЕсли;
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	СофтФонСервер.ПриСозданииНаСервере(ЭтотОбъект);
	МессенджерыСервер.ПриСозданииНаСервере(ЭтотОбъект, Элементы.ГруппаКонтрагентКПМессенджеры);
	
	Элементы.ПодменюПечать.Доступность = ПраваПользователей.ДоступностьПечати(Объект.Ссылка);
	ПраваПользователей.УстановитьТолькоПросмотрДляРеквизитаНомер(Элементы.Номер.ТолькоПросмотр);
	
	Элементы.Статья.АвтоОтметкаНезаполненного = Константы.ОбязательноеЗаполнениеСтатьиВДенежныхДокументах.Получить();
	
	ДоступноИзменениеОрганизацииВДокументахНаОснованииЗаявки = Константы.ДоступноИзменениеОрганизацииВДокументахНаОснованииЗаявки.Получить();
	ДоступноИзменениеКассыВДокументахНаОснованииЗаявки = Константы.ДоступноИзменениеКассыВДокументахНаОснованииЗаявки.Получить();
	УстановитьДоступностьЭлементов();
	
	Элементы.ГруппаФискальныйРегистратор.Видимость = Константы.ИспользоватьПодключаемоеОборудование.Получить();
	Элементы.ФормаПечатьЧека.Видимость = Элементы.ГруппаФискальныйРегистратор.Видимость;
	//Элементы.КонтрагентДополнительно.Видимость = Объект.Контрагент.ПоказыватьДопИнформацию;
	ОбщийМодульСервер.ДополнительнаяИнформацияПоКонтрагентуНаФорме(Объект.Контрагент, Элементы.ПоказатьДополнительнуюИнформацию);
	ОбщийМодульСервер.РегулировкаШириныПоляКонтрагента(Элементы, Элементы.Контрагент, Элементы.ПоказатьДополнительнуюИнформацию);
	
	ОбновитьВидимостьИОстаткиДС();
	
	ОграничениеТипаДоговор = Новый ОписаниеТипов("СправочникСсылка.ДоговорыКонтрагентов");
	Элементы.Договор.ОграничениеТипа = ОграничениеТипаДоговор;
	
	ОбщийМодульСервер.УстановитьВидимостьПодразделения(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ОбновитьДанные();
	ОбновитьВидимостьГруппыБонусов();
	мСуммаБонусов = Объект.СуммаБонусовКСписаниюПоДисконтнойКарте;
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	ПриЧтенииСозданииНаСервере();
	
	ДатыЗапретаИзменения.ОбъектПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииСозданииНаСервере()
	
	ВалютаДокумента = Объект.Валюта;
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	Если НеВыполнятьПроверкуПередЗаписью Тогда
		НеВыполнятьПроверкуПередЗаписью = Ложь;
		Возврат;
	КонецЕсли;
	
	Если ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
		ВыполнитьПроверкиИЗадатьВопросыПередЗаписью(Отказ, ПараметрыЗаписи);
	КонецЕсли;
	
	ОбщийМодульКлиент.ЗаписатьОбъектПриНеобходимости(ЭтотОбъект, ПараметрыЗаписи, Отказ);
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	Если Объект.Сотрудник.Пустая() И Объект.ВидОперации = Перечисления.ВидыОперацийРасходныйКассовыйОрдер.ВыдачаПодотчетнику Тогда
		Сообщить("Не заполнен сотрудник (подотчетное лицо)");
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	Если (Объект.СуммаОсновногоТелаЗайма + Объект.СуммаПроцентовПоЗайму) <> Объект.Сумма И Объект.ВидОперации = Перечисления.ВидыОперацийРасходныйКассовыйОрдер.ВозвратКредита Тогда
		Сообщить("Сумма документа не равна сумме суммы основного долга и суммы процентов");
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	ФинансыСервер.ПроверитьСуммуРаспределенияПоТипамДокументов(Объект, , Объект.Сумма, Отказ, ПараметрыЗаписи.РежимЗаписи);	
	
	// #15647
	Если ЗаписьПослеПробития Тогда
		ЗаписьПослеПробития = Ложь;
		ТекущийОбъект.ДополнительныеСвойства.Вставить("ПропуститьПроверкуЗапретаИзмененияПроведенногоДокумента", Истина);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	мСуммаБонусов = Объект.СуммаБонусовКСписаниюПоДисконтнойКарте;
	// №11352
	Оповестить("Запись_ДокументОплаты",, Объект.Ссылка);
	
	ОбщийМодульКлиент.ВыполнитьДействияПослеЗаписи(ЭтаФорма, Объект, ПараметрыЗаписи);
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	Элементы.ПодменюПечать.Доступность = ПраваПользователей.ДоступностьПечати(Объект.Ссылка);
	ОбновитьДанные();
	ОбновитьВидимостьИОстаткиДС();
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	
	Если ТипЗнч(ИсточникВыбора) = Тип("УправляемаяФорма")
		И СтрНайти(ИсточникВыбора.ИмяФормы, "ФормаКалендаря") > 0 Тогда
		
		Объект.ПериодРегистрации 		= НачалоМесяца(ВыбранноеЗначение);
		ОтображениеПериодаРегистрации 	= Формат(Объект.ПериодРегистрации, "ДФ='MMMM yyyy'");
		Модифицированность = Истина;
		
	ИначеЕсли ИсточникВыбора.ИмяФормы = "ОбщаяФорма.ФормаПодбораПоРасчетамСКонтрагентами" Тогда
		
		ПолучитьРаспределениеПлатежаИзХранилища(ВыбранноеЗначение.АдресПлатежейВХранилище);
		
	КонецЕсли;
	
	Если Окно <> Неопределено Тогда
		Окно.Активизировать();
	КонецЕсли;
	
КонецПроцедуры // ОбработкаВыбора()

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура ДатаПриИзменении(Элемент)
	
	// #14544 на случай если включат данную настройку, чтобы в документе был корректный период = дате документа
	Если НЕ ОтображатьПериодРегистрации И ЗначениеЗаполнено(Объект.Дата) Тогда
		Объект.ПериодРегистрации = НачалоМесяца(Объект.Дата);
	КонецЕсли;
	
	ДатаПриИзмененииНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ДатаПриИзмененииНаСервере()
	
	ОбновитьДанные();
	
КонецПроцедуры

&НаКлиенте
Процедура ОрганизацияПриИзменении(Элемент)
	
	ПересчитатьБонусыПоДокументу();
	ОбновитьВидимостьИОстаткиДС();
	ЗаполнитьСтавкуНДСПоОрганизации();
	ЗаполнитьСтатьюДоходовРасходовСервер();
	
КонецПроцедуры

&НаКлиенте
Процедура ПодразделениеПриИзменении(Элемент)
	ЗаполнитьСтатьюДоходовРасходовСервер();
КонецПроцедуры

&НаКлиенте
Процедура КассаПриИзменении(Элемент)
	Если НЕ КассаПриИзмененииНаСервере() Тогда
		ПоказатьПредупреждение(,"Выбрана касса, не принадлежащая организации");
		Возврат;
	КонецЕсли;
	ПересчитатьБонусыПоДокументу();
	ОбновитьВидимостьИОстаткиДС();
КонецПроцедуры

Функция КассаПриИзмененииНаСервере()
	Если НЕ Объект.Касса.Владелец = Объект.Организация Тогда
		Объект.Касса = Неопределено;
		Возврат Ложь;
	КонецЕсли;
	Возврат Истина;
КонецФункции

&НаКлиенте
Процедура ВалютаПриИзменении(Элемент)
	
	Если ЗначениеЗаполнено(Объект.Валюта) И НЕ ВалютаДокумента = Объект.Валюта Тогда
		Если Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийРасходныйКассовыйОрдер.ЗарплатаСотрудникам") Тогда
			ТекстВопроса = "Пересчитать суммы документа по курсу новой валюты?";
			ОписаниеОповещения = Новый ОписаниеОповещения("ВалютаПриИзмененииФрагмент", ЭтотОбъект);
			ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
		Иначе
			ВалютаПриИзмененииЗавершение();
		КонецЕсли;
	Иначе
		ВалютаПриИзмененииЗавершение();
	КонецЕсли;
	
КонецПроцедуры 

&НаКлиенте
Процедура ВалютаПриИзмененииФрагмент(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		ВалютаПриИзмененииСервер(Объект.Валюта,	Истина);		
	Иначе
		Объект.Валюта = ВалютаДокумента;
	КонецЕсли;
	
	ВалютаПриИзмененииЗавершение();
	
КонецПроцедуры

&НаКлиенте
Процедура ВалютаПриИзмененииЗавершение()
	
	ВалютаДокумента = Объект.Валюта;
	
	ОбновитьДанные();
	ОбновитьВидимостьИОстаткиДС();
	
КонецПроцедуры 

&НаСервере
Процедура ВалютаПриИзмененииСервер(НоваяВалюта, ПересчитатьСуммы = Истина)
	
	Если ПересчитатьСуммы Тогда 
		СтараяВалюта = ВалютаДокумента;
		ДатаКурса    = ?(ЗначениеЗаполнено(Объект.Дата), Объект.Дата, ТекущаяДатаСеанса());
		
		Если Объект.ВидОперации = Перечисления.ВидыОперацийРасходныйКассовыйОрдер.ЗарплатаСотрудникам Тогда
			Для каждого СтрокаТЧ из Объект.ЗарплатаСотрудникам Цикл
				СтрокаТЧ.Сумма = РаботаСВалютой.ПересчитатьИзВалютыВВалюту(СтараяВалюта, НоваяВалюта, ДатаКурса, СтрокаТЧ.Сумма);	
			КонецЦикла;
			Объект.Сумма = Объект.ЗарплатаСотрудникам.Итог("Сумма");
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОснованиеПриИзменении(Элемент)
	
	Если ЗначениеЗаполнено(Объект.Основание) И ТипЗнч(Объект.Основание) = Тип("ДокументСсылка.ЗаявкаНаРасходованиеДенежныхСредств") 
		И Элементы.ГруппаРаспределениеПлатежа.Видимость Тогда
		
		НовоеОписаниеОповещения = Новый ОписаниеОповещения("ПослеВопросаОЗаполненииРаспределения",ЭтаФорма);
		ПоказатьВопрос(НовоеОписаниеОповещения, "Очистить и перезаполнить распределение платежа согласно заявке?", РежимДиалогаВопрос.ДаНет);		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВопросаОЗаполненииРаспределения(Результат, Параметры) Экспорт	
	
	Если Результат = КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли;
	
	ПерезаполнитьРаспределениеНаСервере();
	Модифицированность = Истина;
	
КонецПроцедуры

&НаСервере
Процедура ПерезаполнитьРаспределениеНаСервере()
	
	Объект.РаспределениеПлатежа.Очистить();
	Для каждого СтрокаРаспределения из Объект.Основание.РаспределениеПлатежа Цикл
		НоваяСтрока = Объект.РаспределениеПлатежа.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаРаспределения);
	КонецЦикла;
	
КонецПроцедуры 

&НаКлиенте
Процедура КонтрагентПриИзменении(Элемент)
	
	КонтрагентПриИзмененииНаСервере();
	ОбновитьДанные();
	ПересчитатьБонусыПоДокументу();
	
КонецПроцедуры

&НаСервере
Процедура КонтрагентПриИзмененииНаСервере()
	
	Если ЗначениеЗаполнено(Объект.Контрагент) Тогда
		РеквизитыКонтрагента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект.Контрагент, "ОсновнойДоговор, Категория, СтатьяРасходов");	
		Объект.Договор = РеквизитыКонтрагента.ОсновнойДоговор;
		Объект.КатегорияКонтрагента = РеквизитыКонтрагента.Категория;
		Если ЗначениеЗаполнено(РеквизитыКонтрагента.СтатьяРасходов) Тогда
			Объект.СтатьяРасходов = РеквизитыКонтрагента.СтатьяРасходов;
		КонецЕсли;	
	Иначе
		Объект.Договор = Справочники.ДоговорыКонтрагентов.ПустаяСсылка();
		Объект.КатегорияКонтрагента = Справочники.КатегорииКонтрагентов.ПустаяСсылка();
		Объект.СтатьяРасходов = Справочники.СтатьиДоходовИРасходов.ПустаяСсылка();
	КонецЕсли;
	
	//Элементы.КонтрагентДополнительно.Видимость = Объект.Контрагент.ПоказыватьДопИнформацию;
	ОбщийМодульСервер.ДополнительнаяИнформацияПоКонтрагентуНаФорме(Объект.Контрагент, Элементы.ПоказатьДополнительнуюИнформацию);
	ОбщийМодульСервер.РегулировкаШириныПоляКонтрагента(Элементы, Элементы.Контрагент, Элементы.ПоказатьДополнительнуюИнформацию);
	
КонецПроцедуры

&НаКлиенте
Процедура ВидОперацииПриИзменении(Элемент)
	
	// #14544 на случай если включат данную настройку, чтобы в документе был корректный период = дате документа
	Если НЕ ОтображатьПериодРегистрации И ЗначениеЗаполнено(Объект.Дата) Тогда
		Объект.ПериодРегистрации = НачалоМесяца(Объект.Дата);
	КонецЕсли;
	
	ЗаполнитьСтатьюДоходовРасходовСервер();
	
	ЗаполнитьСтавкуНДСПоОрганизации();
	ОбновитьВидимостьГруппыБонусов();
	ОбновитьДанные();
	
КонецПроцедуры

&НаКлиенте
Процедура ЗарплатаСотрудникамПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	Объект.Сумма = Объект.ЗарплатаСотрудникам.Итог("Сумма");
КонецПроцедуры

&НаКлиенте
Процедура СуммаПриИзменении(Элемент)
	
	Если Объект.РаспределениеПлатежа.Количество() = 1 Тогда
		Если Объект.РаспределениеПлатежа[0].Документ = Объект.Основания[0].Основание Тогда
			Объект.РаспределениеПлатежа[0].Сумма = Объект.Сумма;
		КонецЕсли;
	КонецЕсли;
	
	Объект.СуммаОсновногоТелаЗайма = Объект.Сумма - Объект.СуммаПроцентовПоЗайму;  
	
	ФинансыКлиентСервер.ПересчитатьСуммуНДС(Объект, УчитыватьНДС);
	ПересчитатьБонусыПоДокументу();
	
КонецПроцедуры

&НаКлиенте
Процедура ОтображениеПериодаРегистрацииРегулирование(Элемент, Направление, СтандартнаяОбработка)
	
	Объект.ПериодРегистрации = ?(ЗначениеЗаполнено(Объект.ПериодРегистрации), 
	ДобавитьМесяц(Объект.ПериодРегистрации, Направление),
	ДобавитьМесяц(НачалоМесяца(ТекущаяДата()), Направление));							
	Объект.ПериодРегистрации 		= НачалоМесяца(Объект.ПериодРегистрации);
	ОтображениеПериодаРегистрации 	= Формат(Объект.ПериодРегистрации, "ДФ='MMMM yyyy'");
	
	Модифицированность = Истина;
	
КонецПроцедуры

