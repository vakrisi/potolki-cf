		Ссылка,
		НомерСтроки,
		Номенклатура,
		ХарактеристикаНоменклатуры,
		СерияНоменклатуры,
		ЕдиницаИзмерения,
		Коэффициент,
		Количество,
		Цена,
		СуммаРучнойСкидки,
		Сумма,
		ПроцентРучнойСкидки
	),
	ДокументСчетНаОплату.Услуги.(
		Ссылка,
		НомерСтроки,
		Номенклатура,
		ЕдиницаИзмерения,
		Коэффициент,
		Количество,
		Цена,
		СуммаРучнойСкидки,
		Сумма,
		ПроцентРучнойСкидки
	),
	ДокументСчетНаОплату.МоментВремени,
	ЕСТЬNULL(ОплатаПоСчетамОбороты.СуммаРасход, 0) КАК Оплачено,
	ДокументСчетНаОплату.СуммаДокумента - ЕСТЬNULL(ОплатаПоСчетамОбороты.СуммаРасход, 0) КАК КОплате,
	(ВЫБОР
		КОГДА ЕСТЬNULL(ДокументСчетНаОплату.СуммаДокумента, 0) = 0 ИЛИ ЕСТЬNULL(ОплатаПоСчетамОбороты.СуммаРасход, 0) = 0
			ТОГДА 2
		ИНАЧЕ ВЫБОР
				КОГДА ЕСТЬNULL(ДокументСчетНаОплату.СуммаДокумента, 0) &lt;= ЕСТЬNULL(ОплатаПоСчетамОбороты.СуммаРасход, 0) И ЕСТЬNULL(ОплатаПоСчетамОбороты.СуммаРасход, 0) &gt; 0 
					ТОГДА 0
				ИНАЧЕ 1
			   КОНЕЦ
	КОНЕЦ) КАК СостояниеОплаты
ИЗ
	Документ.СчетНаОплату КАК ДокументСчетНаОплату
		{ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.РасчетыПоЗаказам.Обороты КАК ОплатаПоСчетамОбороты
		ПО ДокументСчетНаОплату.Ссылка = ОплатаПоСчетамОбороты.Заказ}</QueryText>
				<MainTable>Document.СчетНаОплату</MainTable>
