&НаКлиенте
Процедура ОбработкаВыбораПодборНаКлиенте(ВыбранноеЗначение)
	
	Если Не ЗначениеЗаполнено(ВыбранноеЗначение) Тогда
		Возврат;
	КонецЕсли;
			
	ОбработкаВыбораПодборНаСервере(ВыбранноеЗначение);
		
КонецПроцедуры

&НаСервере
Функция ОбработкаВыбораПодборНаСервере(ВыбранноеЗначение)
	
	ТаблицаТоваров = ПолучитьИзВременногоХранилища(ВыбранноеЗначение.АдресВХранилище);
	
	Для Каждого ТекущаяСтрока из ТаблицаТоваров Цикл
		НоваяСтрока = Объект.Товары.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущаяСтрока);
		//ПересчитатьЦенуИСуммуНоменклатурыВСтрокеПоВалюте(НоваяСтрока.НомерСтроки); //-- #7698
		
		НоваяСтрока.СтавкаНДС = СтавкаНДСПоУмолчанию;
		ОбработкаТабличныхЧастейКлиентСервер.ПересчитатьСуммуСУчетомСкидокВСтрокеТЧ(НоваяСтрока, ИспользуютсяАвтоматическиеСкидки);
		ОбработкаТабличныхЧастейКлиентСервер.ПересчитатьСуммуНДСВСтрокеТЧ(НоваяСтрока, УчитыватьНДС);
		
	КонецЦикла;
	
	РассчитатьИтоговыеПоказатели();
	
КонецФункции

&НаСервере
Процедура РассчитатьИтоговыеПоказатели()
	
	СуммаДокументаВрем = Объект.Товары.Итог("Сумма") + Объект.Услуги.Итог("Сумма");
	Если НЕ Объект.СуммаДокумента = СуммаДокументаВрем Тогда
		Объект.СуммаДокумента = СуммаДокументаВрем;
	КонецЕсли;
	
	СуммаНДС = Объект.Товары.Итог("СуммаНДС") + Объект.Услуги.Итог("СуммаНДС");
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСтавкуНДСПоОрганизации(ИзменятьСтавку = Истина)
	
	УчитыватьНДС = УчетНДС.ОрганизацияЯвляетсяПлательщикомНДС(Объект.Организация);
	СтавкаНДСПоУмолчанию = УчетНДС.СтавкаНДСПоУмолчанию(Объект.Организация);
	
	Элементы.ТоварыСуммаНДС.Видимость 	= УчитыватьНДС;
	Элементы.ТоварыСтавкаНДС.Видимость 	= УчитыватьНДС;
	Элементы.УслугиСуммаНДС.Видимость 	= УчитыватьНДС;
	Элементы.УслугиСтавкаНДС.Видимость 	= УчитыватьНДС;
	
	Если ИзменятьСтавку Тогда
		Для каждого СтрокаТабличнойЧасти из Объект.Товары Цикл
			СтрокаТабличнойЧасти.СтавкаНДС = СтавкаНДСПоУмолчанию;
			ОбработкаТабличныхЧастейКлиентСервер.ПересчитатьСуммуНДСВСтрокеТЧ(СтрокаТабличнойЧасти, УчитыватьНДС);	
		КонецЦикла;
		Для каждого СтрокаТабличнойЧасти из Объект.Услуги Цикл
			СтрокаТабличнойЧасти.СтавкаНДС = СтавкаНДСПоУмолчанию;
			ОбработкаТабличныхЧастейКлиентСервер.ПересчитатьСуммуНДСВСтрокеТЧ(СтрокаТабличнойЧасти, УчитыватьНДС);	
		КонецЦикла;
		РассчитатьИтоговыеПоказатели();
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

&НаСервереБезКонтекста
Функция ПолучитьБазовуюЕдиницуИзмеренияНоменклатуры(Знач Номенклатура)
	Возврат Номенклатура.БазоваяЕдиницаИзмерения;
КонецФункции

&НаСервере
Функция ПолучитьЦенуНоменклатуры(Номенклатура, Знач ХарактеристикаНоменклатуры = Неопределено, ЕдиницаИзмерения = Неопределено)
	
	Если ХарактеристикаНоменклатуры = Неопределено Тогда
		ХарактеристикаНоменклатуры = Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка();
	КонецЕсли;
	
	Возврат РегистрыСведений.ЦеныНоменклатуры.ПолучитьЦенуНоменклатуры(Номенклатура, ХарактеристикаНоменклатуры, ЕдиницаИзмерения, Объект.Дата, Объект.ВидЦен, Объект.Валюта, Объект.Контрагент, Объект.ДоговорКонтрагента);
	
КонецФункции

&НаСервере
Процедура УстановитьВидЦенНаОснованииДоговора()
	
	//сначала берем из карточки пользователя (низший приоритет)
	Объект.ВидЦен = ОбщийМодульСервер.НастройкаПользователя("ВидЦенПроизводство");
	//если задан вид цен в категории контрагента, то берем из него (средний приоритет)
	Если НЕ Объект.Контрагент.Категория.ВидЦен.Пустая() Тогда
		Объект.ВидЦен = Объект.Контрагент.Категория.ВидЦен;
	КонецЕсли;
	//если задан вид цен в договоре, то берем из него (высший приоритет)
	Если НЕ Объект.ДоговорКонтрагента.ВидЦен.Пустая() Тогда
		Объект.ВидЦен = Объект.ДоговорКонтрагента.ВидЦен;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Функция ПересчитатьЦеныПоВидуЦен()
	
	Для Каждого ТекущаяСтрока Из Объект.Товары Цикл
		ТекущаяСтрока.Цена = ПолучитьЦенуНоменклатуры(ТекущаяСтрока.Номенклатура, ТекущаяСтрока.ХарактеристикаНоменклатуры, ТекущаяСтрока.ЕдиницаИзмерения);
		ОбработкаТабличныхЧастейКлиент.ПересчитатьСуммуРучнойСкидкиВСтрокеТЧ(ТекущаяСтрока);
		ОбработкаТабличныхЧастейКлиент.ПересчитатьСуммуСУчетомСкидокВСтрокеТЧ(ТекущаяСтрока, ИспользуютсяАвтоматическиеСкидки);
		ОбработкаТабличныхЧастейКлиент.ПересчитатьСуммуНДСВСтрокеТЧ(ТекущаяСтрока, УчитыватьНДС);	
	КонецЦикла;
	Для Каждого ТекущаяСтрока Из Объект.Услуги Цикл
		ТекущаяСтрока.Цена = ПолучитьЦенуНоменклатуры(ТекущаяСтрока.Номенклатура, Неопределено, ТекущаяСтрока.ЕдиницаИзмерения);
		ОбработкаТабличныхЧастейКлиент.ПересчитатьСуммуРучнойСкидкиВСтрокеТЧ(ТекущаяСтрока);
		ОбработкаТабличныхЧастейКлиент.ПересчитатьСуммуСУчетомСкидокВСтрокеТЧ(ТекущаяСтрока, ИспользуютсяАвтоматическиеСкидки);
		ОбработкаТабличныхЧастейКлиент.ПересчитатьСуммуНДСВСтрокеТЧ(ТекущаяСтрока, УчитыватьНДС);
	КонецЦикла;
	РассчитатьИтоговыеПоказатели();
	
КонецФункции

