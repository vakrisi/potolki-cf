#Область ПеременныеФормы

&НаКлиенте
Перем ПараметрыДляЗаписи Экспорт;

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Ключ.Пустая() Тогда

	Иначе
		ЭтаФорма.ТолькоПросмотр = ПраваПользователей.ДокументТолькоПросмотр(Объект.Ссылка);
	КонецЕсли;
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	УправлениеФормойНаСервере();
	
	ВалютаУчета = Константы.ВалютаУчета.Получить();	
	Элементы.НастройкаПоВидамНоменклатурыБонусСуммой.Заголовок = "" + ВалютаУчета + " за единицу товара";
	Элементы.НастройкаПоНоменклатуреБонусСуммой.Заголовок = "" + ВалютаУчета + " за единицу товара";
	
	ПраваПользователей.УстановитьТолькоПросмотрДляРеквизитаНомер(Элементы.Номер.ТолькоПросмотр);
	
	// Видимость колонки Артикул
	ОбщийМодульСервер.УстановитьВидимостьКолонкиАртикулВТабличнойЧасти(ЭтаФорма, "НастройкаПоНоменклатуреНоменклатураАртикул");

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ПривестиТипКассыСчетаВСоответствие();
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	ДатыЗапретаИзменения.ОбъектПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	Если НеВыполнятьПроверкуПередЗаписью Тогда
		НеВыполнятьПроверкуПередЗаписью = Ложь;
		Возврат;
	КонецЕсли;
	
	// #14355
	Если ЗначениеЗаполнено(Объект.Ссылка) 
		И НЕ НачалоДня(Объект.Дата) = НачалоДня(ТекущаяДата()) Тогда
		
		ИзменяетсяСтатусПроведения = ОбщийМодульВызовСервера.ИзменяетсяСтатусПроведения(Объект, ПараметрыЗаписи.РежимЗаписи);	
		
		Если ИзменяетсяСтатусПроведения
			ИЛИ (Модифицированность
				И ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.Проведение) Тогда
			ВыполнитьПроверкиИЗадатьВопросыПередЗаписью(Отказ, ПараметрыЗаписи);
		КонецЕсли;
	КонецЕсли;

	ОбщийМодульКлиент.ЗаписатьОбъектПриНеобходимости(ЭтотОбъект, ПараметрыЗаписи, Отказ);
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	//проверки перед проведением
	Если ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
		
		//проверим на задвоения - вид номенклатуры
		ВремТаблица = Новый ТаблицаЗначений;
		ВремТаблица = Объект.НастройкаПоВидамНоменклатуры.Выгрузить();
		ВремТаблица.Колонки.Добавить("Количество");
		Для Каждого ТекущаяСтрока Из ВремТаблица Цикл
			ТекущаяСтрока.Количество = 1;
		КонецЦикла;
		ВремТаблица.Свернуть("ВидНоменклатуры, Категория","Количество");
		Для Каждого ТекущаяСтрока Из ВремТаблица Цикл
			Если ТекущаяСтрока.Количество > 1 Тогда
				Сообщить("В таблице настройки по видам номенклатуры задвоены записи по виду """ + ТекущаяСтрока.ВидНоменклатуры + """");
				Отказ = Истина;
			КонецЕсли;
		КонецЦикла;
		
		//проверим на задвоения - номенклатура
		ВремТаблица = Новый ТаблицаЗначений;
		ВремТаблица = Объект.НастройкаПоНоменклатуре.Выгрузить();
		ВремТаблица.Колонки.Добавить("Количество");
		Для Каждого ТекущаяСтрока Из ВремТаблица Цикл
			ТекущаяСтрока.Количество = 1;
		КонецЦикла;
		ВремТаблица.Свернуть("Номенклатура","Количество");
		Для Каждого ТекущаяСтрока Из ВремТаблица Цикл
			Если ТекущаяСтрока.Количество > 1 Тогда
				Сообщить("В таблице настройки по номенклатуре задвоены записи по """ + ТекущаяСтрока.Номенклатура + """");
				Отказ = Истина;
			КонецЕсли;
		КонецЦикла;
		
		//вид номенклатуры - в строке должно быть что-то одно - или процент или сумма
		Для Каждого ТекущаяСтрока Из Объект.НастройкаПоВидамНоменклатуры Цикл
			Если НЕ ТекущаяСтрока.БонусСуммой = 0 И НЕ ТекущаяСтрока.БонусПроцентом = 0 Тогда
				Сообщить("В таблице по видам номенклатуры в строке №" + СтрЗаменить(ТекущаяСтрока.НомерСтроки,Символ(160),"") + " для вида """+ТекущаяСтрока.ВидНоменклатуры+""" указано начислять бонусы и по сумме и по % от продаж. Необходимо оставить только один из параметров.");
				Отказ = Истина;
			КонецЕсли;
		КонецЦикла;
		
		//номенклатура - в строке должно быть что-то одно - или процент или сумма
		Для Каждого ТекущаяСтрока Из Объект.НастройкаПоНоменклатуре Цикл
			Если НЕ ТекущаяСтрока.БонусСуммой = 0 И НЕ ТекущаяСтрока.БонусПроцентом = 0 Тогда
				Сообщить("В таблице по номенклатуре в строке №" + СтрЗаменить(ТекущаяСтрока.НомерСтроки,Символ(160),"") + " для номенклатуры """+ТекущаяСтрока.Номенклатура+""" указано начислять бонусы и по сумме и по % от продаж. Необходимо оставить только один из параметров.");
				Отказ = Истина;
			КонецЕсли;
		КонецЦикла;
		
		Для Каждого ТекущаяСтрока Из Объект.НастройкаПоВидамНоменклатуры Цикл
			Если НЕ ТекущаяСтрока.Категория.Пустая() и ТекущаяСтрока.ВидНоменклатуры.Пустая() Тогда
				Сообщить("В таблице по видам номенклатуры в строке №" + СтрЗаменить(ТекущаяСтрока.НомерСтроки,Символ(160),"") + " указана категория, но не указан вид номенклатуры. Укажите вид номенклатуры");
				Отказ = Истина;
			КонецЕсли;
		КонецЦикла;
		
		Если Отказ Тогда
			Сообщить("Проведение документа отменено.");
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	ОбщийМодульКлиент.ВыполнитьДействияПослеЗаписи(ЭтаФорма, Объект, ПараметрыЗаписи);
	
КонецПроцедуры

#КонецОбласти

