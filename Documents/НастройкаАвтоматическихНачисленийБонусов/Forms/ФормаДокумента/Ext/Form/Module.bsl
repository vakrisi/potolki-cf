КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПоГруппеНоменклатуры(Команда)
	
	ОткрытьФорму("Справочник.Номенклатура.ФормаВыбораГруппы",,ЭтаФорма,,,,
		Новый ОписаниеОповещения("ЗаполнитьПоГруппеНоменклатурыПриЗавершенииВыбора",ЭтотОбъект));
			
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПоГруппеНоменклатурыПриЗавершенииВыбора(Результат, ДопПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ЗаполнитьПоГруппеНоменклатурыНаСервере(Результат);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПоГруппеНоменклатурыНаСервере(ГруппаНоменклатуры)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ГруппаНоменклатуры", ГруппаНоменклатуры);
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Номенклатура.Ссылка КАК Номенклатура
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	Номенклатура.Ссылка В ИЕРАРХИИ(&ГруппаНоменклатуры)
	|	И НЕ Номенклатура.ЭтоГруппа
	|
	|УПОРЯДОЧИТЬ ПО
	|	Номенклатура";
	
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда 
		Сообщить ("Выбранная папка Номенклатуры пустая", СтатусСообщения.Важное);
		Возврат;
	КонецЕсли;
	
	Выборка = Результат.Выбрать();
	Пока Выборка.Следующий() Цикл		
		НоваяСтрока = Объект.НастройкаПоНоменклатуре.Добавить();
		НоваяСтрока.Номенклатура = Выборка.Номенклатура;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаУстановитьСтоимостьЗаЕдиницу(Команда)
	ОповещениеПослеВВодаСтоимостиЗаЕдиницу = Новый ОписаниеОповещения("ПослеВВодаСтоимостиЗаЕдиницу",ЭтаФорма);
	ПоказатьВводЧисла(ОповещениеПослеВВодаСтоимостиЗаЕдиницу,0,"Введите сумму бонуса за единицу товара",15,2);
КонецПроцедуры

&НаКлиенте
Процедура ПослеВВодаСтоимостиЗаЕдиницу(Число, Параметры) Экспорт
    Если НЕ Число = Неопределено Тогда
		Для Каждого ТекущаяСтрока Из Объект.НастройкаПоНоменклатуре Цикл
			Если НЕ ТекущаяСтрока.НеНачислятьБонусы Тогда
				ТекущаяСтрока.БонусСуммой = Число;
			КонецЕсли;
		КонецЦикла;
    КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура КомандаУстановитьСтоимостьЗаСумму(Команда)
	ОповещениеПослеВВодаСтоимостиЗаСумму = Новый ОписаниеОповещения("ПослеВВодаСтоимостиЗаСумму",ЭтаФорма);
	ПоказатьВводЧисла(ОповещениеПослеВВодаСтоимостиЗаСумму,0,"Введите размер в % от суммы продаж для начисления бонусов",15,2);
КонецПроцедуры

&НаКлиенте
Процедура ПослеВВодаСтоимостиЗаСумму(Число, Параметры) Экспорт
	
	Если НЕ Число = Неопределено Тогда
		Для Каждого ТекущаяСтрока Из Объект.НастройкаПоНоменклатуре Цикл
			Если НЕ ТекущаяСтрока.НеНачислятьБонусы Тогда
				ТекущаяСтрока.БонусПроцентом = Число;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаНачислятьПоВсем(Команда)
	Для Каждого ТекущаяСтрока Из Объект.НастройкаПоНоменклатуре Цикл
		ТекущаяСтрока.НеНачислятьБонусы = Ложь;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура КомандаНеНачислятьВсем(Команда)
	
	Для Каждого ТекущаяСтрока Из Объект.НастройкаПоНоменклатуре Цикл
		ТекущаяСтрока.НеНачислятьБонусы = Истина;
		ТекущаяСтрока.БонусСуммой = 0;
		ТекущаяСтрока.БонусПроцентом = 0;
	КонецЦикла;
	
КонецПроцедуры

