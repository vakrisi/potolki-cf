&НаКлиенте
Процедура ВидДокументаПриИзменении(Элемент)
	УправлениеФормойНаСервере();
	ПривестиТипКассыСчетаВСоответствие();
КонецПроцедуры

&НаКлиенте
Процедура НастройкаПоВидамНоменклатурыНеНачислятьБонусыПриИзменении(Элемент)
	ТекущиеДанные = Элементы.НастройкаПоВидамНоменклатуры.ТекущиеДанные;
	Если ТекущиеДанные.НеНачислятьБонусы Тогда
		ТекущиеДанные.БонусСуммой = 0;
		ТекущиеДанные.БонусПроцентом = 0;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура НастройкаПоНоменклатуреНеНачислятьБонусыПриИзменении(Элемент)
	ТекущиеДанные = Элементы.НастройкаПоНоменклатуре.ТекущиеДанные;
	Если ТекущиеДанные.НеНачислятьБонусы Тогда
		ТекущиеДанные.БонусСуммой = 0;
		ТекущиеДанные.БонусПроцентом = 0;
	КонецЕсли;
КонецПроцедуры

