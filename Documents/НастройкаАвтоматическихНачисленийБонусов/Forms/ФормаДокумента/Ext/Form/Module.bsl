КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ОбработатьЗаписьОбъекта()
	
	ОбщийМодульКлиент.ОбработатьЗаписьОбъектаВФорме(ЭтотОбъект, ПараметрыДляЗаписи);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьПроверкиИЗадатьВопросыПередЗаписью(Отказ, ПараметрыЗаписи)
	
	// #14355
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ПараметрыЗаписи", ПараметрыЗаписи);
	ДополнительныеПараметры.Вставить("ЭтотОбъект", ЭтотОбъект);
			
	Отказ = Истина;
	ОписаниеОповещения = Новый ОписаниеОповещения("ПодтверждениеПередЗаписью", ЭтотОбъект, ДополнительныеПараметры);
	
	ТекстВопроса = СтрШаблон("Изменения ранее %1 документа ""Настройка автоматических начислений бонусов"" 
					|может привести к расхождениям в начислении бонусов во всех документах, 
					|оформленных датой позднее текущего документа ""Настройка автоматических начислений бонусов"". 
					|Продолжить?", ?(ОбщийМодульВызовСервера.ДокументПроведен(Объект.Ссылка), "проведенного", "непроведенного"));
	ПоказатьВопрос(
		ОписаниеОповещения,
		ТекстВопроса,
		РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры

&НаКлиенте
Процедура ПодтверждениеПередЗаписью(ОтветНаВопрос, ДополнительныеПараметры) Экспорт
	
	Отказ = Ложь;
	
	Если ОтветНаВопрос = КодВозвратаДиалога.Да Тогда
		Отказ = Ложь;
	Иначе
		Возврат;
	КонецЕсли;
	
	ДополнительныеПараметры.Вставить("Отказ", Отказ);
	ОбщийМодульКлиент.ЗаписатьОбъектПриНеобходимости(ЭтотОбъект, ДополнительныеПараметры.ПараметрыЗаписи,, Истина);
	
КонецПроцедуры

&НаСервере
Процедура УправлениеФормойНаСервере()
	
	Элементы.ГруппаПоОплатам.Видимость = Ложь;
	Элементы.Страницы.Видимость = Ложь;
	
	Если Объект.ВидДокумента = ПредопределенноеЗначение("Справочник.ВидыДокументовНачисленияБонусов.РеализацияТоваровИУслуг") Тогда
		Элементы.Страницы.Видимость = Истина;
	Иначе
		Элементы.ГруппаПоОплатам.Видимость = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПривестиТипКассыСчетаВСоответствие()
	
	ОписаниеТипов = новый ОписаниеТипов("СправочникСсылка.Кассы");
	Элементы.СчетаИКассыСчетКасса.Заголовок = "Касса";
	
	Если Объект.ВидДокумента = ПредопределенноеЗначение("Справочник.ВидыДокументовНачисленияБонусов.ПоступлениеНаРасчетныйСчет") Тогда
		ОписаниеТипов = новый ОписаниеТипов("СправочникСсылка.БанковскиеСчета");
		Элементы.СчетаИКассыСчетКасса.Заголовок = "Счет";
	ИначеЕсли Объект.ВидДокумента = ПредопределенноеЗначение("Справочник.ВидыДокументовНачисленияБонусов.ОплатаБанковскойКартой") Тогда	
		ОписаниеТипов = новый ОписаниеТипов("СправочникСсылка.ЭквайринговыеТерминалы");
		Элементы.СчетаИКассыСчетКасса.Заголовок = "Эквайринговый терминал";
	КонецЕсли;	
	
	Элементы.СчетаИКассыСчетКасса.ВыбиратьТип = Ложь;
	Элементы.СчетаИКассыСчетКасса.ОграничениеТипа = ОписаниеТипов;
	
КонецПроцедуры

#КонецОбласти
