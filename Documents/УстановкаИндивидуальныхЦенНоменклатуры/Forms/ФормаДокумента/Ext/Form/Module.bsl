&НаКлиенте
Перем СтараяНоменклатура; // Используется в механизмах обработчиков событий табличной части Товары
&НаКлиенте
Перем СтараяХарактеристика; // Используется в механизмах обработчиков событий табличной части Товары

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
		
	Если Параметры.Ключ.Пустая() Тогда
	Иначе
		ЭтаФорма.ТолькоПросмотр = ПраваПользователей.ДокументТолькоПросмотр(Объект.Ссылка);
	КонецЕсли;
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	ПраваПользователей.УстановитьТолькоПросмотрДляРеквизитаНомер(Элементы.Номер.ТолькоПросмотр);
	
	УстановкаЦенСервер.ЗаполнитьИспользуемыеВидыЦенПользователя(ЭтаФорма);
	
	УстановитьВидимость();
	
	УстановитьУсловноеОформление();
	ЗагрузитьТабличнуюЧастьТовары();
	
	// Видимость колонки Артикул
	МассивЭлементов = новый Массив();
	МассивЭлементов.Добавить("ДеревоЦенНоменклатураАртикул");
	ОбщийМодульСервер.УстановитьВидимостьКолонкиАртикулВТабличнойЧасти(ЭтаФорма, МассивЭлементов);
	
	ФинансыСервер.ОбновитьВидимостьИКурсВалюты(ЭтотОбъект);
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	ДатыЗапретаИзменения.ОбъектПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	ПоместитьЦеныВТабличнуюЧасть();
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	
	Если ИсточникВыбора.ИмяФормы = "ОбщаяФорма.ФормаПодбораНоменклатуры" Тогда	
		ОбработкаПодбораНоменклатурыНаКлиенте(ВыбранноеЗначение);
	//++ №14163
	ИначеЕсли ИсточникВыбора.ИмяФормы = "Обработка.ЗагрузкаНоменклатурыИзExcel.Форма.ЗагрузкаВТабличнуюЧасть" Тогда		
		ПолучитьЗагруженныеТоварыИзХранилища(ВыбранноеЗначение.АдресТоваровВХранилище);
	//-- №14163
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ДатаПриИзменении(Элемент)
	ДатаПриИзмененииНаСервере();
КонецПроцедуры

&НаСервере
Процедура ДатаПриИзмененииНаСервере()
	
	ФинансыСервер.ОбновитьВидимостьИКурсВалюты(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ВалютаПриИзменении(Элемент)
	ВалютаПриИзмененииНаСервере();
КонецПроцедуры

&НаСервере
Процедура ВалютаПриИзмененииНаСервере()
	
	ФинансыСервер.ОбновитьВидимостьИКурсВалюты(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура КонтрагентПриИзменении(Элемент)
	КонтрагентПриИзмененииНаСервере();
КонецПроцедуры

&НаСервере
Процедура КонтрагентПриИзмененииНаСервере()
	Объект.ДоговорКонтрагента = Объект.Контрагент.ОсновнойДоговор;
КонецПроцедуры

&НаКлиенте
Процедура ВидОперацииПриИзменении(Элемент)
	
	УстановитьВидимость();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаСервере
Процедура ДобавитьНоменклатуруНаСервере(Номенклатура)
	Дерево = ДанныеФормыВЗначение(ДеревоЦен, Тип("ДеревоЗначений"));
	
	ЗапросХарактеристики = Новый Запрос;
	ЗапросХарактеристики.Текст = 
	"ВЫБРАТЬ
	|	ХарактеристикиНоменклатуры.Ссылка
	|ИЗ
	|	Справочник.ХарактеристикиНоменклатуры КАК ХарактеристикиНоменклатуры
	|ГДЕ
	|	ХарактеристикиНоменклатуры.Владелец = &Владелец";
	ЗапросХарактеристики.УстановитьПараметр("Владелец", Номенклатура);
	РезультатЗапросаХарактеристики = ЗапросХарактеристики.Выполнить();
	
	//по всем единицам измерений по данной номенклатуре
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЕдиницыИзмерений.Ссылка
	|ИЗ
	|	Справочник.ЕдиницыИзмерений КАК ЕдиницыИзмерений
	|ГДЕ
	|	ЕдиницыИзмерений.Владелец = &Владелец
	|	И ЕдиницыИзмерений.ПометкаУдаления = ЛОЖЬ";
	Запрос.УстановитьПараметр("Владелец", Номенклатура);
	Выборка = Запрос.Выполнить().Выбрать();
	МассивЕдИзмерений = новый Массив;
	МассивЕдИзмерений.Добавить(ПолучитьБазовуюЕдиницуИзмеренияНоменклатуры(Номенклатура));
	Пока Выборка.Следующий() Цикл
		МассивЕдИзмерений.Добавить(Выборка.Ссылка);
	КонецЦикла;
	
	Для Каждого ЕдИзм Из МассивЕдИзмерений Цикл
		
		Если Дерево.Строки.НайтиСтроки(Новый Структура("Номенклатура, ЕдиницаИзмерения",Номенклатура, ЕдИзм)).Количество()=0 Тогда		
			Стр = Дерево.Строки.Добавить();
			Стр.Номенклатура = Номенклатура;
			Стр.ЕдиницаИзмерения = ЕдИзм;
			ВыборкаХарактеристики = РезультатЗапросаХарактеристики.Выбрать();
			ОбработкаТабличныхЧастейКлиентСервер.ЗаполнитьИндексКартинкиСтрокиДереваЦен(Стр);
			Если ВыборкаХарактеристики.Количество() > 0 Тогда								
			Стр.ХарактеристикиИспользуются = Истина;	
				Пока ВыборкаХарактеристики.Следующий() Цикл
					СтрДеревоВид = Стр.Строки.Добавить();
					СтрДеревоВид.Номенклатура = Стр.Номенклатура;
					СтрДеревоВид.ХарактеристикаНоменклатуры = ВыборкаХарактеристики.Ссылка;
					СтрДеревоВид.ЕдиницаИзмерения = Стр.ЕдиницаИзмерения;
					СтрДеревоВид.ХарактеристикиИспользуются = Истина;
					ОбработкаТабличныхЧастейКлиентСервер.ЗаполнитьИндексКартинкиСтрокиДереваЦен(СтрДеревоВид);
				КонецЦикла;
			КонецЕсли;						
		КонецЕсли;
		
	КонецЦикла;

	ЗначениеВДанныеФормы(Дерево, ДеревоЦен); 	
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьТоварамиИзДокумента(Команда)
	ОткрытьФорму("Документ.УстановкаЦенНоменклатуры.Форма.ФормаЗаполненияИзДокумента",,ЭтаФорма,,,,
		Новый ОписаниеОповещения("ЗаполнитьТоварамиИзДокументаПриЗавершенииВыбора",ЭтотОбъект));
КонецПроцедуры		

&НаКлиенте
Процедура ЗаполнитьТоварамиИзДокументаПриЗавершенииВыбора(Результат, ДопПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ЗаполнитьТоварамиИзДокументаНаСервере(Результат);
	Модифицированность = Истина;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТоварамиИзДокументаНаСервере(ВозвращенноеЗначение)
	
	//ВозвращенноеЗначение.Свернуть("Номенклатура, ХарактеристикаНоменклатуры, ЕдиницаИзмерений");
	Объект.Товары.Очистить();
	ПоместитьЦеныВТабличнуюЧасть();
	Для Каждого ТекущаяСтрока Из ВозвращенноеЗначение Цикл
		//Попробуем найти в ТЧ Товары
		Отбор = Новый Структура("Номенклатура, ХарактеристикаНоменклатуры, ЕдиницаИзмерения",
			ТекущаяСтрока.Номенклатура, ТекущаяСтрока.ХарактеристикаНоменклатуры, ТекущаяСтрока.ЕдиницаИзмерения);						
		НайденноеЗначение = Объект.Товары.НайтиСтроки(Отбор);
		Если НайденноеЗначение.Количество() > 0 Тогда
			НоваяСтрокаТЧ = НайденноеЗначение[0];
		Иначе	
			НоваяСтрокаТЧ = Объект.Товары.Добавить();
		КонецЕсли;	
		ЗаполнитьЗначенияСвойств(НоваяСтрокаТЧ, ТекущаяСтрока);
	КонецЦикла;
	ДеревоЦен.ПолучитьЭлементы().Очистить();
	ЗагрузитьТабличнуюЧастьТовары();
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьТекущимиЦенами(Команда)
	Если ДеревоЦен.ПолучитьЭлементы().Количество() = 0 Тогда 
		Сообщить("Таблица цен пуста, установка цен не выполнена");
	ИначеЕсли НЕ ЗначениеЗаполнено(Объект.Контрагент) ИЛИ НЕ ЗначениеЗаполнено(Объект.ДоговорКонтрагента) Тогда
		Сообщить("Не указан контрагент или договор контрагента");
	Иначе
		ЗаполнитьТекущимиЦенамиНаСервере();
		Модифицированность = Истина;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТекущимиЦенамиНаСервере()
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Контрагент",Объект.Контрагент);
	Запрос.УстановитьПараметр("ДоговорКонтрагента",Объект.ДоговорКонтрагента);
	Запрос.УстановитьПараметр("Дата", ТекущаяДатаСеанса());
	Запрос.УстановитьПараметр("Валюта", Объект.Валюта);
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЦенаНоменклатуры.Номенклатура КАК Номенклатура,
	|	ЦенаНоменклатуры.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	|	ЦенаНоменклатуры.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	ЦенаНоменклатуры.Цена КАК Цена,
	|	ЦенаНоменклатуры.ВидЦены КАК ВидЦены
	|ИЗ
	|	РегистрСведений.ЦеныНоменклатурыИндивидуальные.СрезПоследних(&Дата, ) КАК ЦенаНоменклатуры
	|ГДЕ
	|	ЦенаНоменклатуры.Валюта = &Валюта
	|	И ЦенаНоменклатуры.Контрагент = &Контрагент
	|	И ЦенаНоменклатуры.ДоговорКонтрагента = &ДоговорКонтрагента";
	
	ТаблицаЦен = Запрос.Выполнить().Выгрузить();
	
	Дерево = ДеревоЦен.ПолучитьЭлементы();
	Для Каждого СтрокаДерева из Дерево Цикл	
		ЭлементыСтроки = СтрокаДерева.ПолучитьЭлементы();
		Отбор = Новый Структура("Номенклатура, ХарактеристикаНоменклатуры, ЕдиницаИзмерения",
				СтрокаДерева.Номенклатура, Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка(), СтрокаДерева.ЕдиницаИзмерения);
		НайденныеСтроки = ТаблицаЦен.НайтиСтроки(Отбор);
		Если НайденныеСтроки.Количество() > 0 Тогда
			СтрокаДерева.Цена = НайденныеСтроки[0].Цена;			
			СтрокаДерева.ВидЦены = НайденныеСтроки[0].ВидЦены;
		КонецЕсли;
		// характеристики
		Для Каждого Стр из ЭлементыСтроки Цикл
			Отбор = Новый Структура("Номенклатура, ХарактеристикаНоменклатуры, ЕдиницаИзмерения",
						Стр.Номенклатура, Стр.ХарактеристикаНоменклатуры, Стр.ЕдиницаИзмерения);
			НайденныеСтроки = ТаблицаЦен.НайтиСтроки(Отбор);
			Если НайденныеСтроки.Количество() > 0 Тогда
				Стр.Цена = НайденныеСтроки[0].Цена;
				Стр.ВидЦены = НайденныеСтроки[0].ВидЦены;
			КонецЕсли; 	
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура УстановитьОбщуюЦену(Команда)
	
	Если ДеревоЦен.ПолучитьЭлементы().Количество() = 0 Тогда 
		Сообщить("Таблица цен пуста, расчет цен не будет выполнен");
		Возврат;
	КонецЕсли;
	
	ОписаниеОповещенияВыборЦены = Новый ОписаниеОповещения("УстановитьОбщуюЦенуНаНоменклатуруПослеВыбораЦены", ЭтотОбъект);
	ПоказатьВводЧисла(ОписаниеОповещенияВыборЦены, 0, "Установить общую цену", 15, 2);
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьОбщуюЦенуНаНоменклатуруПослеВыбораЦены(ВыбранноеЗначение, ДополнительныеПараметры) Экспорт
	
	Если ВыбранноеЗначение = Неопределено Тогда
		Возврат;
	КонецЕсли;
		
	ЭлементНоменклатура = ДеревоЦен.ПолучитьЭлементы();
	Для Каждого СтрокаДерева из ЭлементНоменклатура Цикл	
		
		СтрокаДерева.Цена = ВыбранноеЗначение;
		СтрокаДерева.ВидЦены = ПредопределенноеЗначение("Справочник.ВидыЦен.ПустаяСсылка");
		
		ЭлементХарактеристика = СтрокаДерева.ПолучитьЭлементы();
		// характеристики
		Для Каждого Стр из ЭлементХарактеристика Цикл
			Стр.Цена = ВыбранноеЗначение;
			Стр.ВидЦены = ПредопределенноеЗначение("Справочник.ВидыЦен.ПустаяСсылка");
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьВсеЗначенияНаСумму(Команда)
	
	ПослеВводаСуммыДляИзмененияВсехСтрок = Новый ОписаниеОповещения("ПослеВводаСуммыДляИзмененияВсехСтрок", ЭтаФорма);
	ПоказатьВводЧисла(ПослеВводаСуммыДляИзмененияВсехСтрок,0,"Введите сумму",15,2);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВводаСуммыДляИзмененияВсехСтрок(Число, Параметры) Экспорт
	Если Число = Неопределено Тогда
		Возврат;
	КонецЕсли;
		
	Дерево = ДеревоЦен.ПолучитьЭлементы();
	Для Каждого СтрокаДерева из Дерево Цикл	
		ЭлементыСтроки = СтрокаДерева.ПолучитьЭлементы();
		Если СтрокаДерева.ВидЦены = ПредопределенноеЗначение("Справочник.ВидыЦен.ПустаяСсылка") Тогда
			СтрокаДерева.Цена = СтрокаДерева.Цена + Число;
		КонецЕсли;
		
		// характеристики
		Для Каждого Стр из ЭлементыСтроки Цикл
			Если Стр.ВидЦены = ПредопределенноеЗначение("Справочник.ВидыЦен.ПустаяСсылка") Тогда
				Стр.Цена = Стр.Цена + Число;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	ПоказатьОповещениеПользователя("Цены изменены");
	
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьВсеЗначенияНаПроцент(Команда)
	ПослеВводаПроцентаДляИзмененияВсехСтрок = Новый ОписаниеОповещения("ПослеВводаПроцентаДляИзмененияВсехСтрок", ЭтаФорма);
	ПоказатьВводЧисла(ПослеВводаПроцентаДляИзмененияВсехСтрок,0,"Введите %",15,2);
КонецПроцедуры

&НаКлиенте
Процедура ПослеВводаПроцентаДляИзмененияВсехСтрок(Число, Параметры) Экспорт
	Если  Число = Неопределено Тогда
		Возврат;
	КонецЕсли;
		
	Дерево = ДеревоЦен.ПолучитьЭлементы();
	Для Каждого СтрокаДерева из Дерево Цикл	
		ЭлементыСтроки = СтрокаДерева.ПолучитьЭлементы();
		Если СтрокаДерева.ВидЦены = ПредопределенноеЗначение("Справочник.ВидыЦен.ПустаяСсылка") Тогда
			СтрокаДерева.Цена = СтрокаДерева.Цена + СтрокаДерева.Цена*(Число/100);
		КонецЕсли;
		
		// характеристики
		Для Каждого Стр из ЭлементыСтроки Цикл
			Если Стр.ВидЦены = ПредопределенноеЗначение("Справочник.ВидыЦен.ПустаяСсылка") Тогда
				Стр.Цена = СтрокаДерева.Цена + Стр.Цена*(Число/100);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	ПоказатьОповещениеПользователя("Цены изменены");
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьОбщийВидЦены(Команда)
	
	ОткрытьФорму("Справочник.ВидыЦен.ФормаВыбора",,ЭтаФорма,,,,
		Новый ОписаниеОповещения("УстановитьОбщийВидЦеныПриЗавершенииВыбора",ЭтотОбъект));
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьОбщийВидЦеныПриЗавершенииВыбора(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ОписаниеОповещения = Новый ОписаниеОповещения("УстановитьОбщийВидЦеныЗавершение", ЭтаФорма, Результат);
	ТекстВопроса = "Установить выбранный ""Вид цены"" для всех строк? При выборе ""Нет"" будет установлено только для выделенных строк.";
	ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНетОтмена);
	
КонецПроцедуры	

&НаКлиенте
Процедура УстановитьОбщийВидЦеныЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	ВидЦены = ДополнительныеПараметры;
	ТолькоВыделенныеСтроки = Ложь;	
	Если Результат = КодВозвратаДиалога.Нет Тогда
		ТолькоВыделенныеСтроки = Истина;
	ИначеЕсли Результат = КодВозвратаДиалога.Да Тогда
		ТолькоВыделенныеСтроки = Ложь;
	Иначе
		Возврат;
	КонецЕсли;
	
	Если НЕ ТолькоВыделенныеСтроки Тогда
		
		ЭлементыНоменклатура = ДеревоЦен.ПолучитьЭлементы();
		Для Каждого ЭлементНоменклатура из ЭлементыНоменклатура Цикл			
			ЭлементНоменклатура.ВидЦены = ВидЦены;
			ЭлементНоменклатура.Цена = 0;
			
			ЭлементыХарактеристики = ЭлементНоменклатура.ПолучитьЭлементы();
			Для Каждого ЭлементХарактеристика из ЭлементыХарактеристики Цикл
				ЭлементХарактеристика.ВидЦены = ВидЦены;
				ЭлементХарактеристика.Цена = 0;			
			КонецЦикла;
		КонецЦикла;
	
	Иначе
	
		Для Каждого ВыделеннаяСтрока Из Элементы.ДеревоЦен.ВыделенныеСтроки Цикл
			
			СтрокаТаблицыЦен = ДеревоЦен.НайтиПоИдентификатору(ВыделеннаяСтрока);				
			СтрокаТаблицыЦен.ВидЦены = ВидЦены;
			СтрокаТаблицыЦен.Цена = 0;
			
			Если Не ЗначениеЗаполнено(СтрокаТаблицыЦен.ХарактеристикаНоменклатуры) Тогда	
				ЭлементыХарактеристики = СтрокаТаблицыЦен.ПолучитьЭлементы();				
				Для Каждого ЭлементХарактеристика Из ЭлементыХарактеристики Цикл
					ЭлементХарактеристика.ВидЦены = ВидЦены;
					ЭлементХарактеристика.Цена = 0;
				КонецЦикла;				
			КонецЕсли;			
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

