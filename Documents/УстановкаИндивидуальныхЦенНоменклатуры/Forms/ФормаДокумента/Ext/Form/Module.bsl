&НаСервере
Процедура ЗагрузитьТабличнуюЧастьТовары()
	
	ТаблицаТоваров = Объект.Товары.Выгрузить();	
	КЭШ = СоздатьТаблицуНоменклатуры();
	КЭШ.Колонки.Добавить("СтрокаДереваЦен");
	КЭШ.Индексы.Добавить("Номенклатура, ЕдиницаИзмерения");
	
	Если ТипЗнч(ДеревоЦен) = Тип("ДанныеФормыКоллекция") Тогда
		ЭлементыДереваЦен = ДеревоЦен;
	Иначе
		ЭлементыДереваЦен = ДеревоЦен.ПолучитьЭлементы();		
	КонецЕсли;
	
	Для Каждого ТекНоменклатура Из ТаблицаТоваров Цикл
		
		ИспользуютсяХарактеристики = ИспользуютсяХарактеристикиНоменклатуры(ТекНоменклатура.Номенклатура);
		НайденнаяСтрока = НайтиСтрокуДереваЦен(ТекНоменклатура, КЭШ);
		Если НайденнаяСтрока <> Неопределено Тогда
			ЭлементНоменклатура = НайденнаяСтрока.СтрокаДереваЦен;
		Иначе
			ЭлементНоменклатура = ЭлементыДереваЦен.Добавить();
			ЗаполнитьЗначенияСвойств(ЭлементНоменклатура, ТекНоменклатура);
			ЭлементНоменклатура.ХарактеристикиИспользуются = ИспользуютсяХарактеристики;
			ЭлементНоменклатура.ХарактеристикаНоменклатуры = Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка();
			ОбработкаТабличныхЧастейКлиентСервер.ЗаполнитьИндексКартинкиСтрокиДереваЦен(ЭлементНоменклатура);
			НоваяСтрокаТЗ = КЭШ.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрокаТЗ, ЭлементНоменклатура);
			НоваяСтрокаТЗ.СтрокаДереваЦен = ЭлементНоменклатура;
		КонецЕсли;
		
		Если ИспользуютсяХарактеристики Тогда
			Родитель = ЭлементНоменклатура;
			НайденнаяСтрокаХарактеристики = НайтиСтрокуДереваЦен(ТекНоменклатура, КЭШ, Истина);
			Если НайденнаяСтрокаХарактеристики <> Неопределено Тогда
				ЭлементНоменклатура = НайденнаяСтрокаХарактеристики.СтрокаДереваЦен;
			Иначе	
				ЭлементНоменклатура = ЭлементНоменклатура.ПолучитьЭлементы().Добавить();
				ЗаполнитьЗначенияСвойств(ЭлементНоменклатура, ТекНоменклатура);
				ЭлементНоменклатура.ХарактеристикаНоменклатуры = ТекНоменклатура.ХарактеристикаНоменклатуры;
				ЭлементНоменклатура.ХарактеристикиИспользуются = ИспользуютсяХарактеристики;
				ОбработкаТабличныхЧастейКлиентСервер.ЗаполнитьИндексКартинкиСтрокиДереваЦен(ЭлементНоменклатура);
				НоваяСтрокаТЗ = КЭШ.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрокаТЗ, ЭлементНоменклатура);
				НоваяСтрокаТЗ.СтрокаДереваЦен = ЭлементНоменклатура
			КонецЕсли;		
			
		КонецЕсли;	
					
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция СоздатьТаблицуНоменклатуры() Экспорт
	
	ТаблицаЗначений = Новый ТаблицаЗначений();
	
	ТаблицаЗначений.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ТаблицаЗначений.Колонки.Добавить("ХарактеристикаНоменклатуры", Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры"));
	МассивТипов = новый Массив;
	МассивТипов.Добавить("СправочникСсылка.ЕдиницаИзмерения");
	МассивТипов.Добавить("СправочникСсылка.КлассификаторЕдиницИзмерения");
	ТаблицаЗначений.Колонки.Добавить("ЕдиницаИзмерения", Новый ОписаниеТипов(МассивТипов));	
	
	Возврат ТаблицаЗначений;
	
КонецФункции

&НаСервере
Функция НайтиСтрокуДереваЦен(ДанныеПоиска, КЭШ, ПоискХарактеристики = Ложь)

	Отбор = Новый Структура("Номенклатура, ЕдиницаИзмерения", ДанныеПоиска.Номенклатура, ДанныеПоиска.ЕдиницаИзмерения);
	Если ПоискХарактеристики Тогда
    	Отбор.Вставить("ХарактеристикаНоменклатуры", ДанныеПоиска.ХарактеристикаНоменклатуры);
	КонецЕсли;				
	
	МассивСтрок = КЭШ.НайтиСтроки(Отбор);
	Если МассивСтрок.Количество() > 0 Тогда
		Возврат МассивСтрок[0];			
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

&НаСервере
Процедура ПоместитьЦеныВТабличнуюЧасть()
	
	Объект.Товары.Очистить();	
	
	ЭлементыНоменклатура = ДеревоЦен.ПолучитьЭлементы();
	Для Каждого ТекЭлементНоменклатура Из ЭлементыНоменклатура Цикл
		
		ПоместитьСтрокуЦенВТабличнуюЧасть(ТекЭлементНоменклатура);
				
		ЭлементыХарактеристики = ТекЭлементНоменклатура.ПолучитьЭлементы();
		Для Каждого ТекЭлементХарактеристика Из ЭлементыХарактеристики Цикл
			
			ПоместитьСтрокуЦенВТабличнуюЧасть(ТекЭлементХарактеристика);
						
		КонецЦикла;
		
	КонецЦикла;		
	
КонецПроцедуры

&НаСервере
Процедура ПоместитьСтрокуЦенВТабличнуюЧасть(СтрокаЦен)
	
	НоваяСтрока = Объект.Товары.Добавить();
	ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаЦен);			
	
КонецПроцедуры

