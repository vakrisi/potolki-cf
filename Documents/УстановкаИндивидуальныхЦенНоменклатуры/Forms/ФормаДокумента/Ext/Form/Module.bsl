&НаСервере
Функция ЗаполнитьЦеныПоТаблице(ТаблицаИсточник, ПроцентНаценки, ПрименятьКоэффициентЕдиницыИзмерения = Ложь)
	
	СтрокиНоменклатуры = ДеревоЦен.ПолучитьЭлементы();
	Для Каждого СтрокаНоменклатуры из СтрокиНоменклатуры Цикл
		СтрокиХарактеристик = СтрокаНоменклатуры.ПолучитьЭлементы();
		Если СтрокиХарактеристик.Количество() = 0 Тогда
			// номенклатура
			ДопКоэффициент = 1;
			СтруктураОтбора = Новый Структура("Номенклатура, ХарактеристикаНоменклатуры, ЕдиницаИзмерения");
			Если ПрименятьКоэффициентЕдиницыИзмерения И ТипЗнч(СтрокаНоменклатуры.ЕдиницаИзмерения) = Тип("СправочникСсылка.ЕдиницыИзмерений") Тогда
				ДопКоэффициент = СтрокаНоменклатуры.ЕдиницаИзмерения.Коэффициент;					
			КонецЕсли;
			ЗаполнитьЗначенияСвойств(СтруктураОтбора, СтрокаНоменклатуры);
			НайденныеСтроки = ТаблицаИсточник.НайтиСтроки(СтруктураОтбора);					
			Если НайденныеСтроки.Количество() > 0 Тогда
				СтрокаНоменклатуры.Цена = НайденныеСтроки[0].Цена * (1 + ПроцентНаценки/100) * ДопКоэффициент;
			КонецЕсли;					
		Иначе
			// характеристики
			Для Каждого СтрокаХарактеристики из СтрокиХарактеристик Цикл
				ДопКоэффициент = 1;
				СтруктураОтбора = Новый Структура("Номенклатура, ХарактеристикаНоменклатуры, ЕдиницаИзмерения");
				Если ПрименятьКоэффициентЕдиницыИзмерения И ТипЗнч(СтрокаХарактеристики.ЕдиницаИзмерения) = Тип("СправочникСсылка.ЕдиницыИзмерений") Тогда
					ДопКоэффициент = СтрокаХарактеристики.ЕдиницаИзмерения.Коэффициент;					
				КонецЕсли;
				
				ЗаполнитьЗначенияСвойств(СтруктураОтбора, СтрокаХарактеристики);
				НайденныеСтроки = ТаблицаИсточник.НайтиСтроки(СтруктураОтбора);					
				Если НайденныеСтроки.Количество() > 0 Тогда
					СтрокаХарактеристики.Цена = НайденныеСтроки[0].Цена * (1 + ПроцентНаценки/100) * ДопКоэффициент;
				КонецЕсли;						
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	
КонецФункции
	
#КонецОбласти

