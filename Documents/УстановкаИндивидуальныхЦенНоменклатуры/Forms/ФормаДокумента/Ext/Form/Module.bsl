&НаКлиенте
Процедура ДеревоЦенПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	// для запрета ввода по Insert
	Если НЕ Копирование Тогда
		Отказ = Истина;
