&НаКлиенте
Процедура ОкруглитьЦены(Команда)

	ОписаниеОповещения = Новый ОписаниеОповещения("ПослеВыбораПравилОкругления", ЭтотОбъект);
	ПараметрыФормы = Новый Структура("ТипВладельца", "УстановкаЦенНоменклатуры");
	ОткрытьФорму("ОбщаяФорма.ФормаНастроекОкругления", ПараметрыФормы,,,,,ОписаниеОповещения);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораПравилОкругления(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПорядокОкругления = Результат.ПорядокОкругления;
	ОкруглятьВБольшуюСторону = Результат.ОкруглятьВБольшуюСторону;	

	СтрокиНоменклатуры = ДеревоЦен.ПолучитьЭлементы();
	Для Каждого СтрокаНоменклатуры из СтрокиНоменклатуры Цикл
		Если СтрокаНоменклатуры.ВидЦены = ПредопределенноеЗначение("Справочник.ВидыЦен.ПустаяСсылка")	
			И ЗначениеЗаполнено(СтрокаНоменклатуры.Цена) Тогда
			СтрокаНоменклатуры.Цена = ОбщийМодуль.ОкруглитьЧисло(СтрокаНоменклатуры.Цена, ПорядокОкругления, ОкруглятьВБольшуюСторону);	
		КонецЕсли;		
		//характеристики
		СтрокиХарактеристик = СтрокаНоменклатуры.ПолучитьЭлементы();
		Для Каждого СтрокаХарактеристики из СтрокиХарактеристик Цикл
			Если СтрокаХарактеристики.ВидЦены = ПредопределенноеЗначение("Справочник.ВидыЦен.ПустаяСсылка")	
				И ЗначениеЗаполнено(СтрокаХарактеристики.Цена) Тогда
				СтрокаХарактеристики.Цена = ОбщийМодуль.ОкруглитьЧисло(СтрокаХарактеристики.Цена, ПорядокОкругления, ОкруглятьВБольшуюСторону);
			КонецЕсли;			
		КонецЦикла;
	КонецЦикла;
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьЦены(Команда)
	
	Если ДеревоЦен.ПолучитьЭлементы().Количество()=0 Тогда 
		Сообщить("Таблица цен пуста, расчет цен не будет выполнен");
		Возврат;
	КонецЕсли;
	
	сз_ВсеВидыЦен = Новый СписокЗначений;
	Для каждого Строка Из ВидыЦен Цикл
		Если НЕ Строка.Запрещенный Тогда
			сз_ВсеВидыЦен.Добавить(Строка.ВидЦены);
		КонецЕсли;
	КонецЦикла;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("УстановкаИндивидуальныхЦенНоменклатуры", Истина);
	ПараметрыФормы.Вставить("ВсеВидыЦен",			сз_ВсеВидыЦен);
	ПараметрыФормы.Вставить("ИспользуемыеВидыЦен",	Новый СписокЗначений);
	ПараметрыФормы.Вставить("РазрешенныеВидыЦен",	Новый СписокЗначений);
	ОписаниеОповещения = Новый ОписаниеОповещения("РассчитатьЦеныФрагмент", ЭтотОбъект);
	ОткрытьФорму("Документ.УстановкаЦенНоменклатуры.Форма.ФормаРасчетаЦен", ПараметрыФормы, ЭтаФорма, , , , ОписаниеОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьЦеныФрагмент(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ОписаниеОповещения = Новый ОписаниеОповещения("РассчитатьЦеныЗавершение", ЭтотОбъект, Результат); 
	ТекстВопроса = "Цены будут перерассчитаны. Продолжить?";
	ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьЦеныЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		Модифицированность = Истина;
		РассчитатьЦеныНаСервере(ДополнительныеПараметры);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура РассчитатьЦеныНаСервере(ПараметрыРасчета)
	
	ВидИсходныхДанных = ПараметрыРасчета.ВидИсходныхДанных;
	ИсходныйВидЦен = ПараметрыРасчета.ИсходныйВидЦен;
	ПроцентНаценки = ПараметрыРасчета.ПроцентНаценки;	
		
	Объект.Товары.Очистить();
	ПоместитьЦеныВТабличнуюЧасть();
		
	Если ВидИсходныхДанных = 0 Тогда
		//наценка на себестоимость
		
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("ДатаЗапроса",?(Объект.Дата = Дата(1,1,1),ТекущаяДатаСеанса(),Объект.Дата));
		Запрос.УстановитьПараметр("МассивНоменклатуры", Объект.Товары.Выгрузить().ВыгрузитьКолонку("Номенклатура"));			
		Запрос.УстановитьПараметр("Склад", ПараметрыРасчета.СкладОстатков);
		Запрос.УстановитьПараметр("Организация", ПараметрыРасчета.Организация);
		
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТоварыНаСкладахОстатки.Номенклатура КАК Номенклатура,
		|	ТоварыНаСкладахОстатки.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
		|	ТоварыНаСкладахОстатки.Номенклатура.БазоваяЕдиницаИзмерения КАК ЕдиницаИзмерения,
		|	ВЫРАЗИТЬ(ВЫБОР
		|			КОГДА НЕ ТоварыНаСкладахОстатки.КоличествоОстаток = 0
		|				ТОГДА ТоварыНаСкладахОстатки.СуммаОстаток / ТоварыНаСкладахОстатки.КоличествоОстаток
		|			ИНАЧЕ 0
		|		КОНЕЦ КАК ЧИСЛО(15, 2)) КАК Цена
		|ИЗ
		|	РегистрНакопления.ТоварыНаСкладах.Остатки(
		|			&ДатаЗапроса,
		|			(Организация = &Организация ИЛИ &Организация = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка))
		|				И Номенклатура в (&МассивНоменклатуры)
		|				И ВЫБОР
		|					КОГДА НЕ &Склад = ЗНАЧЕНИЕ(Справочник.Склады.ПустаяСсылка)
		|						ТОГДА Склад = &Склад
		|					ИНАЧЕ ИСТИНА
		|				КОНЕЦ) КАК ТоварыНаСкладахОстатки";
		
		ТаблицаИсточник = Запрос.Выполнить().Выгрузить(); 			
		ЗаполнитьЦеныПоТаблице(ТаблицаИсточник, ПроцентНаценки, Истина);
		
	ИначеЕсли ВидИсходныхДанных = 1 Тогда
		//наценка на цену последней покупки без доставки (т.е. цена в поступлении)
			
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("ДатаЗапроса", КонецДня(?(Объект.Дата = Дата(1,1,1), ТекущаяДатаСеанса(), Объект.Дата)));
		Запрос.УстановитьПараметр("МассивНоменклатуры", Объект.Товары.Выгрузить().ВыгрузитьКолонку("Номенклатура"));			
		Запрос.УстановитьПараметр("Организация", ПараметрыРасчета.Организация);
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ПоступлениеТоваровИУслугТовары.Номенклатура КАК Номенклатура,
		|	ПоступлениеТоваровИУслугТовары.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
		|	ПоступлениеТоваровИУслугТовары.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
		|	ПоступлениеТоваровИУслугТовары.Цена
		|ИЗ
		|	Документ.ПоступлениеТоваровИУслуг.Товары КАК ПоступлениеТоваровИУслугТовары
		|ГДЕ
		|	ПоступлениеТоваровИУслугТовары.Номенклатура В (&МассивНоменклатуры)
		|	И ПоступлениеТоваровИУслугТовары.Ссылка.Проведен
		|	И ПоступлениеТоваровИУслугТовары.Ссылка.Дата <= &ДатаЗапроса
		|	И (ПоступлениеТоваровИУслугТовары.Ссылка.Организация = &Организация ИЛИ &Организация = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка))
		|
		|УПОРЯДОЧИТЬ ПО
		|	ПоступлениеТоваровИУслугТовары.Ссылка.Дата Убыв";
		
		ТаблицаИсточник = Запрос.Выполнить().Выгрузить();		
		ЗаполнитьЦеныПоТаблице(ТаблицаИсточник, ПроцентНаценки);
		
	ИначеЕсли ВидИсходныхДанных = 2 Тогда
		// наценка на цену последней покупки + доставка
			
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("ДатаЗапроса", КонецДня(?(Объект.Дата = Дата(1,1,1), ТекущаяДатаСеанса(), Объект.Дата)));
		Запрос.УстановитьПараметр("МассивНоменклатуры", Объект.Товары.Выгрузить().ВыгрузитьКолонку("Номенклатура"));			
		Запрос.УстановитьПараметр("Организация", ПараметрыРасчета.Организация);
		Запрос.Текст =	
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЗакупкиОбороты.Номенклатура КАК Номенклатура,
		|	ЗакупкиОбороты.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
		|	ЗакупкиОбороты.Номенклатура.БазоваяЕдиницаИзмерения КАК ЕдиницаИзмерения,
		|	ВЫРАЗИТЬ(ВЫБОР
		|			КОГДА НЕ ЗакупкиОбороты.КоличествоОборот = 0
		|				ТОГДА ЗакупкиОбороты.СуммаОборот / ЗакупкиОбороты.КоличествоОборот
		|			ИНАЧЕ 0
		|		КОНЕЦ КАК ЧИСЛО(15, 2)) КАК Цена
		|ИЗ
		|	РегистрНакопления.Закупки.Обороты(
		|			,
		|			&ДатаЗапроса,
		|			Регистратор,
		|			(Организация = &Организация ИЛИ &Организация = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка))
		|				И Номенклатура В (&МассивНоменклатуры)) КАК ЗакупкиОбороты
		|ГДЕ
		|	ЗакупкиОбороты.Регистратор ССЫЛКА Документ.ПоступлениеТоваровИУслуг
		|
		|УПОРЯДОЧИТЬ ПО
		|	ЗакупкиОбороты.Период Убыв";
		
		ТаблицаИсточник = Запрос.Выполнить().Выгрузить();		
		ЗаполнитьЦеныПоТаблице(ТаблицаИсточник, ПроцентНаценки, Истина);			

	ИначеЕсли ВидИсходныхДанных = 4 Тогда
		//наценка на указанный вид цен
		
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("ДатаЗапроса",?(Объект.Дата = Дата(1,1,1), ТекущаяДатаСеанса(), Объект.Дата));
		Запрос.УстановитьПараметр("ВидЦены", ИсходныйВидЦен);
		Запрос.УстановитьПараметр("Валюта",  Объект.Валюта);
		Запрос.УстановитьПараметр("МассивНоменклатуры", Объект.Товары.Выгрузить().ВыгрузитьКолонку("Номенклатура"));
		Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЦеныСрезПоследних.Валюта КАК Валюта,
		|	ЦеныСрезПоследних.ВидЦены КАК ВидЦены,
		|	ЦеныСрезПоследних.Номенклатура КАК Номенклатура,
		|	ЦеныСрезПоследних.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
		|	ЦеныСрезПоследних.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
		|	ЦеныСрезПоследних.Цена КАК Цена
		|ИЗ
		|	РегистрСведений.ЦеныНоменклатуры.СрезПоследних(
		|			&ДатаЗапроса,
		|			ВидЦены = &ВидЦены
		|				И Валюта = &Валюта
		|				И Номенклатура В (&МассивНоменклатуры)) КАК ЦеныСрезПоследних";
		
		ТаблицаИсточник = Запрос.Выполнить().Выгрузить();		
		ЗаполнитьЦеныПоТаблице(ТаблицаИсточник, ПроцентНаценки);			
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

