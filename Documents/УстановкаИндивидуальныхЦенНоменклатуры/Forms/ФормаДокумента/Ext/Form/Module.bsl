&НаКлиенте
Процедура ЗагрузитьИзExcel(Команда)
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ИспользоватьСумму", Ложь);
	ПараметрыФормы.Вставить("ИспользоватьКоличество", Ложь);
	
	ОткрытьФорму(
		"Обработка.ЗагрузкаНоменклатурыИзExcel.Форма.ЗагрузкаВТабличнуюЧасть",
		ПараметрыФормы,
		ЭтаФорма,
		УникальныйИдентификатор);
		
КонецПроцедуры
	
&НаСервере
Процедура ПолучитьЗагруженныеТоварыИзХранилища(АдресТоваровВХранилище)
	
	ТаблицаНоменклатуры = ПолучитьИзВременногоХранилища(АдресТоваровВХранилище);	
	УстановкаЦенСервер.ДобавитьНоменклатуруВДеревоЦен(ЭтаФорма, ТаблицаНоменклатуры);
	
	Дерево = ДеревоЦен.ПолучитьЭлементы();
	
	Для Каждого СтрокаНоменклатуры из Дерево Цикл		
		
		СтруктураПоиска = Новый Структура("Номенклатура, ХарактеристикаНоменклатуры, ЕдиницаИзмерения");
		ЗаполнитьЗначенияСвойств(СтруктураПоиска, СтрокаНоменклатуры);
		
		НайденныеСтроки = ТаблицаНоменклатуры.НайтиСтроки(СтруктураПоиска);
		Если НайденныеСтроки.Количество() > 0 Тогда
			
			СтрокаНоменклатуры.Цена = НайденныеСтроки[0].Цена;
			СтрокаНоменклатуры.ВидЦены = Справочники.ВидыЦен.ПустаяСсылка();
			
		КонецЕсли;
		
		СтрокиХарактеристик = СтрокаНоменклатуры.ПолучитьЭлементы();
		Для Каждого СтрокаХарактеристики из СтрокиХарактеристик Цикл
			
			СтруктураПоиска = Новый Структура("Номенклатура, ХарактеристикаНоменклатуры, ЕдиницаИзмерения");
			ЗаполнитьЗначенияСвойств(СтруктураПоиска, СтрокаХарактеристики);
			
			НайденныеСтроки = ТаблицаНоменклатуры.НайтиСтроки(СтруктураПоиска);
			Если НайденныеСтроки.Количество() > 0 Тогда
				
				СтрокаХарактеристики.Цена = НайденныеСтроки[0].Цена;
				СтрокаХарактеристики.ВидЦены = Справочники.ВидыЦен.ПустаяСсылка();
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
		
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьЦенамиПоставщика(Команда)
	
	ОповещениеОЗакрытии = Новый ОписаниеОповещения("ПослеВыбораПоставщика", ЭтаФорма);
	
	ПоказатьВводЗначения(ОповещениеОЗакрытии, ПредопределенноеЗначение("Справочник.Контрагенты.ПустаяСсылка"), "Укажите поставщика", Тип("СправочникСсылка.Контрагенты"));
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораПоставщика(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Или Не ЗначениеЗаполнено(Результат) Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнитьПоЦенамПоставщика(Результат);
	
	ПоказатьОповещениеПользователя("Цены изменены");
	
