
&НаКлиенте
Процедура ИнструкцииСданоПриИзменении(Элемент)
	тд = Элементы.Инструкции.ТекущиеДанные;
	тд.ДатаСдачи = ?(тд.Сдано, ТекущаяДата(), Дата(1,1,1));
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ТекПользователь = ПараметрыСеанса.ТекущийПользователь;
	Если объект.Ссылка.Пустая() Тогда
		объект.Автор = ТекПользователь;
	КонецЕсли;
	
	// доступность
	Если объект.Автор <> ТекПользователь Тогда
		Элементы.ГруппаШапка.ТолькоПросмотр = истина;
		
		Элементы.ИнструкцииИнструкция.ТолькоПросмотр = истина;
		Элементы.ИнструкцииСдано.ТолькоПросмотр = истина;
		Элементы.ИнструкцииДатаСдачи.ТолькоПросмотр = истина;
		
		Элементы.ВопросыВопрос.ТолькоПросмотр = истина;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ИнструкцииИнструкцияПриИзменении(Элемент)
	тд = Элементы.Инструкции.ТекущиеДанные;
	Если тд.УИДстроки = "" Тогда
		тд.УИДстроки = строка(новый УникальныйИдентификатор);
	КонецЕсли;
	ОбновитьВопросы();	
	
	УстановитьОтборВопросов();
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьВопросы()
	ТекСтрока = Элементы.Инструкции.ТекущиеДанные;
    Если ТекСтрока <> Неопределено и ЗначениеЗаполнено(ТекСтрока.УИДстроки) и ЗначениеЗаполнено(ТекСтрока.Инструкция) Тогда
        УИДстроки = ТекСтрока.УИДстроки;
		
		сч = Объект.Вопросы.Количество()-1;
		Пока сч>=0 Цикл
			если Объект.Вопросы[сч].УИДстроки = УИДстроки Тогда
				Объект.Вопросы.Удалить(сч);
			КонецЕсли;
			
			сч = сч -1;
		КонецЦикла;
		
		вопросыДИ = ПолучитьВопросыДИ(ТекСтрока.Инструкция);
		Для каждого стр из вопросыДИ Цикл
			Новстр = Объект.Вопросы.Добавить();
			Новстр.УИДстроки = УИДстроки;
			Новстр.Вопрос = стр;
		КонецЦикла;
    КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура УстановитьОтборВопросов()
	ТекСтрока = Элементы.Инструкции.ТекущиеДанные;
    Если ТекСтрока <> Неопределено и ЗначениеЗаполнено(ТекСтрока.УИДстроки) Тогда
        УИДстроки = ТекСтрока.УИДстроки;
    Иначе
        УИДстроки = "424242424242424242424242424242";
    КонецЕсли; 
    
    Элементы.Вопросы.ОтборСтрок = Новый ФиксированнаяСтруктура("УИДстроки", УИДстроки);
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьВопросыДИ(ди)
	возврат ди.Вопросы.Выгрузить().ВыгрузитьКолонку("Вопрос");
КонецФункции


&НаКлиенте
Процедура ИнструкцииПриАктивизацииСтроки(Элемент)
	УстановитьОтборВопросов();
КонецПроцедуры


&НаКлиенте
Процедура ИнструкцииПослеУдаления(Элемент)
	УстановитьОтборВопросов();
КонецПроцедуры


