Процедура ПриКопировании(ОбъектКопирования)
	вопросы.Очистить();
	
	Для каждого стрДИ из Инструкции Цикл
		стрДИ.ДатаСдачи = Дата(1,1,1);
		стрДИ.Изучено = Ложь;
		стрДИ.Сдано = Ложь;
		
		Для каждого стрВопрос из стрДИ.Инструкция.Вопросы Цикл
			новстрВопрос = Вопросы.Добавить();
			новстрВопрос.Вопрос = стрВопрос.Вопрос;
			новстрВопрос.УИДстроки = стрДИ.УИДстроки;
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры
