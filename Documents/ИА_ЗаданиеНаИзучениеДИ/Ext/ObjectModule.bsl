
Процедура ОбработкаПроведения(Отказ, Режим)
	
	Движения.ИА_ИзучениеДИ.Записывать = Истина;
	Движения.ИА_ИзучениеДИ.Очистить();
	Для Каждого ТекСтрокаИнструкции Из Инструкции Цикл
		Движение = Движения.ИА_ИзучениеДИ.Добавить();
		Движение.Период = Дата;
		Движение.Инструкция = ТекСтрокаИнструкции.Инструкция;
		Движение.Пользователь = Сотрудник;
		Движение.ДатаСдачи = ТекСтрокаИнструкции.ДатаСдачи;
		Движение.СрокСдачи = Срок;
	КонецЦикла;

КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	Если РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения и Автор <> ПараметрыСеанса.ТекущийПользователь и не ОбменДанными.Загрузка Тогда
		Сообщить("Отменить может только автор");
		Отказ = истинА;
	КонецЕсли;
	
	сч = Вопросы.Количество()-1;
	Пока сч>=0 Цикл
		если Инструкции.Найти(Вопросы[сч].УИДстроки,"УИДстроки")= Неопределено Тогда
			Вопросы.Удалить(сч);
		КонецЕсли;
		сч = сч -1;
	КонецЦикла;
КонецПроцедуры

