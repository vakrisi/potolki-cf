&НаКлиенте
Процедура ВопросыПроверочногоСпискаОтветНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	
	ТекущаяСтрока = Элементы.ВопросыПроверочногоСписка.ТекущиеДанные;
	Если ТекущаяСтрока.ВариантныйОтвет Тогда
		СтандартнаяОбработка = Ложь;
		ВыбранноеЗначение = Неопределено;
		
		ВыбранноеЗначение = ВыбратьИзСписка(ПолучитьСписокОтветов(ТекущаяСтрока.Вопрос));
		ТекущаяСтрока.Ответ = ?(ВыбранноеЗначение = Неопределено, Неопределено, ВыбранноеЗначение.Значение);
		
		ПересчитатьБаллСтроки(ТекущаяСтрока);
		
		Модифицированность = Истина;
		
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьБаллСтроки(ТекСтрока)
	
	Если ТекСтрока.Ответ <> Неопределено Тогда
		ТекСтрока.Балл = РассчитатьБаллВСтроке(ТекСтрока.Вопрос, ТекСтрока.ВариантныйОтвет, ТекСтрока.Ответ);		
	Иначе
		ТекСтрока.Балл = 0;
	КонецЕсли; 
	
	итого = 0;
	Для каждого стр из Объект.ВопросыПроверочногоСписка Цикл
		итого = итого + стр.Балл;
	КонецЦикла;
	Объект.Количество = итого;
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьСписокОтветов(Вопрос)
	
	СписокОтветов = Новый СписокЗначений;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ИА_ВопросыПроверочногоСпискаВариантыОтветов.Ответ
	|ИЗ
	|	Справочник.ИА_ВопросыПроверочногоСписка.ВариантыОтветов КАК ИА_ВопросыПроверочногоСпискаВариантыОтветов
	|ГДЕ
	|	ИА_ВопросыПроверочногоСпискаВариантыОтветов.Ссылка = &Вопрос";
	
	Запрос.УстановитьПараметр("Вопрос", Вопрос);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СписокОтветов.Добавить(Выборка.Ответ);
	КонецЦикла; 
	
	Возврат СписокОтветов;
	
КонецФункции

&НаСервереБезКонтекста
Функция РассчитатьБаллВСтроке(Вопрос, ВариантныйОтвет, Ответ)
	
	БаллВСтроке = 0;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Вопрос", Вопрос);
	Запрос.УстановитьПараметр("Ответ", Ответ);
	Запрос.УстановитьПараметр("ВариантныйОтвет", ВариантныйОтвет);
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	|	ИА_ВопросыПроверочногоСпискаВариантыОтветов.Балл
	|ИЗ
	|	Справочник.ИА_ВопросыПроверочногоСписка.ВариантыОтветов КАК ИА_ВопросыПроверочногоСпискаВариантыОтветов
	|ГДЕ
	|	ИА_ВопросыПроверочногоСпискаВариантыОтветов.Ссылка = &Вопрос
	|	И ИА_ВопросыПроверочногоСпискаВариантыОтветов.Ответ = &Ответ
	|	И &ВариантныйОтвет
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ИА_ВопросыПроверочногоСписка.БаллВопроса
	|ИЗ
	|	Справочник.ИА_ВопросыПроверочногоСписка КАК ИА_ВопросыПроверочногоСписка
	|ГДЕ
	|	ИА_ВопросыПроверочногоСписка.Ссылка = &Вопрос
	|	И НЕ &ВариантныйОтвет";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		БаллВСтроке = Выборка.Балл;		
	КонецЕсли;
	Если Не ВариантныйОтвет И (ТипЗНЧ(Ответ) = Тип("Булево") ИЛИ ТипЗНЧ(Ответ) = Тип("Число")) Тогда
		БаллВСтроке = БаллВСтроке * Ответ;		
	КонецЕсли; 
	
	Возврат БаллВСтроке;
	
КонецФункции

&НаКлиенте
Процедура ВопросыПроверочногоСпискаОтветОчистка(Элемент, СтандартнаяОбработка)
	
	ТекущаяСтрока = Элементы.ВопросыПроверочногоСписка.ТекущиеДанные;
	ТекущаяСтрока.Балл = 0;
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	ВопросыПроверочногоСпискаЗаполнитьСлужебныеРеквизиты();
	
КонецПроцедуры

&НаСервере
Процедура ВопросыПроверочногоСпискаЗаполнитьСлужебныеРеквизиты()
	
	Если Объект.ВопросыПроверочногоСписка.Количество() = 0 Тогда
		Возврат;
	КонецЕсли; 
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ИА_СтатистикаВопросыПроверочногоСписка.Вопрос,
	|	ИА_ВопросыПроверочногоСписка.ВариантныйОтвет,
	|	ИА_ВопросыПроверочногоСписка.ОтветВопроса
	|ИЗ
	|	Документ.ИА_Статистика.ВопросыПроверочногоСписка КАК ИА_СтатистикаВопросыПроверочногоСписка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ИА_ВопросыПроверочногоСписка КАК ИА_ВопросыПроверочногоСписка
	|		ПО ИА_СтатистикаВопросыПроверочногоСписка.Вопрос = ИА_ВопросыПроверочногоСписка.Ссылка
	|ГДЕ
	|	ИА_СтатистикаВопросыПроверочногоСписка.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", Объект.Ссылка);
	Выборка = Запрос.Выполнить().Выбрать();
	Отбор = Новый Структура;
	Пока Выборка.Следующий() Цикл
		Отбор.Вставить("Вопрос", Выборка.Вопрос);
		МассивСтрок = Объект.ВопросыПроверочногоСписка.НайтиСтроки(Отбор);
		Для Каждого СтрокаТЧ Из МассивСтрок Цикл
			ЗаполнитьЗначенияСвойств(СтрокаТЧ, Выборка, "ВариантныйОтвет, ОтветВопроса");
		КонецЦикла; 
	КонецЦикла; 
	
КонецПроцедуры


&НаКлиенте
Процедура ВопросыПроверочногоСпискаПриАктивизацииЯчейки(Элемент)
	эл = Элемент.ТекущийЭлемент;
	Если эл.Имя = "ВопросыПроверочногоСпискаОтвет" Тогда
		тд = Элементы.ВопросыПроверочногоСписка.ТекущиеДанные;
		Если тд<>Неопределено Тогда
			Если тд.ВариантныйОтвет Тогда
				эл.ВыбиратьТип = истина;
			Иначе
				эл.ВыбиратьТип = Ложь;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры


&НаКлиенте
Процедура ВопросыПроверочногоСпискаОтветПриИзменении(Элемент)
	ТекущаяСтрока = Элементы.ВопросыПроверочногоСписка.ТекущиеДанные;
	ПересчитатьБаллСтроки(ТекущаяСтрока);
КонецПроцедуры
