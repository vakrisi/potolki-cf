КонецФункции

//ИА_Арчил Тваладзе 2016.06.16
&НаСервере
Процедура ВопросыПроверочногоСпискаУстановитьВидимость()
	
	Если ЗначениеЗаполнено(Объект.ВидСтатистики) Тогда
		Элементы.ВопросыПроверочногоСписка.Видимость = ЗначениеЗаполнено(ИА_КСУОбщийСервер.ПолучитьЗначениеРеквизита(Объект.ВидСтатистики, "ПроверочныйСписок"));
		Элементы.Количество.ТолькоПросмотр = Элементы.ВопросыПроверочногоСписка.Видимость;
	Иначе
		Элементы.ВопросыПроверочногоСписка.Видимость = Ложь;
	КонецЕсли; 
	
КонецПроцедуры

&НаСервере
Процедура ВопросыПроверочногоСпискаЗаполнить()
	
	Если Не ЗначениеЗаполнено(Объект.ВидСтатистики) Тогда
		Объект.ВопросыПроверочногоСписка.Очистить();
		Возврат;
	КонецЕсли; 
	
	ПроверочныйСписок = ИА_КСУОбщийСервер.ПолучитьЗначениеРеквизита(Объект.ВидСтатистики, "ПроверочныйСписок");
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ИА_ВопросыПроверочногоСписка.Ссылка КАК Вопрос,
	|	ИА_ВопросыПроверочногоСписка.ВариантныйОтвет КАК ВариантныйОтвет,
	|	ИА_ВопросыПроверочногоСписка.ОтветВопроса КАК ОтветВопроса,
	|	ВЫБОР
	|		КОГДА НЕ ИА_ВопросыПроверочногоСписка.ВариантныйОтвет
	|				И ИА_ВопросыПроверочногоСписка.ОтветВопроса = 1
	|			ТОГДА 0
	|		КОГДА НЕ ИА_ВопросыПроверочногоСписка.ВариантныйОтвет
	|				И ИА_ВопросыПроверочногоСписка.ОтветВопроса = 2
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ НЕОПРЕДЕЛЕНО
	|	КОНЕЦ КАК Ответ
	|ИЗ
	|	Справочник.ИА_ВопросыПроверочногоСписка КАК ИА_ВопросыПроверочногоСписка
	|ГДЕ
	|	ИА_ВопросыПроверочногоСписка.Владелец = &ПроверочныйСписок
	|	И НЕ ИА_ВопросыПроверочногоСписка.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("ПроверочныйСписок", ПроверочныйСписок);
	Объект.ВопросыПроверочногоСписка.Загрузить(Запрос.Выполнить().Выгрузить());
	
КонецПроцедуры


