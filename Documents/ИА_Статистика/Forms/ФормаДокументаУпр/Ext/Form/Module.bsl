	для каждого стр1 из ПакетноеДерево.ПолучитьЭлементы() Цикл
		Если КоличествоАналитик = 1 Тогда
			ЗаполнитьЗначенияСвойств(Объект, стр1);
			Возврат;
		КонецЕсли;
		для каждого стр2 из стр1.ПолучитьЭлементы() Цикл
			Если КоличествоАналитик = 2 Тогда
				ЗаполнитьЗначенияСвойств(Объект, стр2);
				Возврат;
			КонецЕсли;
			для каждого стр3 из стр2.ПолучитьЭлементы() Цикл
				Если КоличествоАналитик = 3 Тогда
					ЗаполнитьЗначенияСвойств(Объект, стр3);
					Возврат;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
