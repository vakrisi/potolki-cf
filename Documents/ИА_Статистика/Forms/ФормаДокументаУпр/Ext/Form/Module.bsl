Процедура ВводНесколькихЗначенийПриИзменении(Элемент)
	Если не Объект.ВводНесколькихЗначений Тогда
		Если ПакетноеДерево.ПолучитьЭлементы().Количество()>0 тогда
			Если Вопрос("Список введенных значений будет очищен. Продолжить?", РежимДиалогаВопрос.ДаНет)=КодВозвратаДиалога.Да Тогда
				ЗаполнитьПоПервойСтроке();
				ПакетноеДерево.ПолучитьЭлементы().Очистить();
			Иначе
				Объект.ВводНесколькихЗначений = истина;
				Возврат;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	ОбновитьВидимостьПакетногоВвода();
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьЗначение(Команда)
	Модифицированность = истина;
	
	тд = Элементы.ПакетноеДерево.ТекущиеДанные;
	Если тд <> Неопределено Тогда
		ТекРод = тд.ПолучитьРодителя();
		Если ТекРод = Неопределено Тогда
			ТекРод = ПакетноеДерево;
		КонецЕсли;
	иначе
		ТекРод = ПакетноеДерево;
	КонецЕсли;	
				
	Новстр = ТекРод.ПолучитьЭлементы().Добавить();
	ЗаполнитьЗначенияСвойств(Новстр, ТекРод);
	
	СтрАн = ДобавитьСтрокиАналитик(ТекРод, Новстр);
	Элементы.ПакетноеДерево.ТекущаяСтрока = СтрАн;
КонецПроцедуры

&НаКлиенте
Функция ПолучитьУровеньСтроки(СтрокаДерева)
	ТекУровень = 1;
	ТекСтр = СтрокаДерева;
	Пока ТекСтр.ПолучитьРодителя() <> Неопределено цикл
		ТекУровень = ТекУровень + 1;
		ТекСтр = ТекСтр.ПолучитьРодителя()
	КонецЦикла;
	
	Возврат ТекУровень;
КонецФункции

&НаКлиенте
Функция ДобавитьСтрокиАналитик(КоллСтрок, ДобавленнаяСтрока)
	Рез = ДобавленнаяСтрока.ПолучитьИдентификатор();
	
	ТекУровень = ПолучитьУровеньСтроки(ДобавленнаяСтрока);
	
	ПредСтр = ДобавленнаяСтрока;
	Пока ТекУровень < КоличествоАналитик Цикл
		Новстр = ПредСтр.ПолучитьЭлементы().Добавить();
		ЗаполнитьЗначенияСвойств(Новстр, ПредСтр);
		
		рез = Новстр.ПолучитьИдентификатор();
		ТекУровень = ТекУровень + 1;	
		ПредСтр = Новстр;
	КонецЦикла;
	
	Возврат Рез;
КонецФункции

&НаСервере
Процедура УстановитьКоличествоАналитик()
	КоличествоАналитик = 0;
	КоличествоАналитик =  ?(ЗначениеЗаполнено(Объект.ВидСтатистики.Аналитика1),1,0) + ?(ЗначениеЗаполнено(Объект.ВидСтатистики.Аналитика2),1,0) + ?(ЗначениеЗаполнено(Объект.ВидСтатистики.Аналитика3),1,0);
КонецПроцедуры

&НаКлиенте
Процедура ПакетноеДеревоПриАктивизацииСтроки(Элемент)
	Элемент.ПодчиненныеЭлементы.ПакетноеДеревоАналитика1.ТолькоПросмотр = истина;
	Элемент.ПодчиненныеЭлементы.ПакетноеДеревоАналитика2.ТолькоПросмотр = истина;
	Элемент.ПодчиненныеЭлементы.ПакетноеДеревоАналитика3.ТолькоПросмотр = истина;
	Элемент.ПодчиненныеЭлементы.ПакетноеДеревоКоличество.ТолькоПросмотр = истина;
	
	тд = Элементы.ПакетноеДерево.ТекущиеДанные;
	Если тд<>Неопределено Тогда
		ТекУровень = ПолучитьУровеньСтроки(тд);
		Элемент.ПодчиненныеЭлементы["ПакетноеДеревоАналитика"+ ТекУровень].ТолькоПросмотр = ложь;
		Если ТекУровень = КоличествоАналитик Тогда
			Элемент.ПодчиненныеЭлементы.ПакетноеДеревоКоличество.ТолькоПросмотр = ложь;
		КонецЕсли;
		
		
		//
		Если ТекУровень = 1 и не ЗначениеЗаполнено(тд.Аналитика1) Тогда
			УстановитьТипНаКлиенте(ПолучитьПолныйТипАналитики(Объект.ВидСтатистики,1) ,Элемент.ПодчиненныеЭлементы.ПакетноеДеревоАналитика1, тд.Аналитика1);
			Элемент.ПодчиненныеЭлементы.ПакетноеДеревоАналитика1.ВыбиратьТип = Ложь;
		КонецЕсли;
		Если ТекУровень = 2 и не ЗначениеЗаполнено(тд.Аналитика2) Тогда
			УстановитьТипНаКлиенте(ПолучитьПолныйТипАналитики(Объект.ВидСтатистики,2) ,Элемент.ПодчиненныеЭлементы.ПакетноеДеревоАналитика2, тд.Аналитика2);
			Элемент.ПодчиненныеЭлементы.ПакетноеДеревоАналитика2.ВыбиратьТип = Ложь;
		КонецЕсли;
		Если ТекУровень = 3 и не ЗначениеЗаполнено(тд.Аналитика3) Тогда
			УстановитьТипНаКлиенте(ПолучитьПолныйТипАналитики(Объект.ВидСтатистики,3) ,Элемент.ПодчиненныеЭлементы.ПакетноеДеревоАналитика3, тд.Аналитика3);
			Элемент.ПодчиненныеЭлементы.ПакетноеДеревоАналитика3.ВыбиратьТип = Ложь;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура УстановитьТипНаКлиенте(ЗначТип,ЭлФормы,Рекв)
	Если ЗначТип = "" Тогда
		Возврат
	КонецЕсли;

    Массив = Новый Массив;
	Массив.Добавить(Тип(ЗначТип));       
	Стр = Новый ОписаниеТипов(Массив);
	ЭлФормы.ОграничениеТипа = Стр;                 
	ЭлФормы.ОграничениеТипа.ПривестиЗначение();
	
	ЗначТип1 = ЗначТип;
	ЗначТип1 = СтрЗаменить(ЗначТип1, "СправочникСсылка", "Справочники");
	ЗначТип1 = СтрЗаменить(ЗначТип1, "ДокументСсылка", "Документы");
	ЗначТип1 = СтрЗаменить(ЗначТип1, "ПеречислениеСсылка", "Перечисления");
	Если ЗначТип1 = "" Тогда 		
		Рекв = ПредопределенноеЗначение("Справочник.ИА_ЗначениеАналитики.ПустаяСсылка");
	ИначеЕсли ЗначТип1 = "Булево" тогда 
		Рекв = Ложь;
	ИначеЕсли  ЗначТип1 = "Строка" тогда	
		Рекв = "";
	ИначеЕсли ЗначТип1 = "Число" тогда
		Рекв = 0;
	ИначеЕсли ЗначТип1 = "Дата" тогда
		Рекв = Дата("01010001");
	Иначе
		Рекв = ПолучитьСсылкуПоТипу(ЗначТип1);
	КонецЕсли;
	
	ЭлФормы.ВыбиратьТип = Ложь;
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьСсылкуПоТипу(пТип)
	Возврат Вычислить(пТип+".ПустаяСсылка()");
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьПолныйТипАналитики(ВидСт, НомерАн)
	Возврат ВидСт["Аналитика"+НомерАн].ТипАналитикиПолный;
КонецФункции

&НаКлиенте 
Процедура УстановитьАналитикуВСтрокиДерева(Колл, НомерАн)
	Для каждого стр из Колл.ПолучитьЭлементы() Цикл
		стр["Аналитика"+НомерАн] = Колл["Аналитика"+НомерАн];
		Для каждого стр2 из стр.ПолучитьЭлементы() Цикл
			стр2["Аналитика"+НомерАн] = Колл["Аналитика"+НомерАн];
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ПакетноеДеревоАналитика1ПриИзменении(Элемент)
	тд = Элементы.ПакетноеДерево.ТекущиеДанные;
	УстановитьАналитикуВСтрокиДерева(тд, 1);	
КонецПроцедуры

