&НаКлиенте
Перем ПредАн1,ПредАн2;

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Объект.ВводНесколькихЗначений Тогда
		ОбновитьДеревоПакета();
	КонецЕсли;
	
	НастроитьДоступностьАналитик();
	ОбновитьДоступностьПакетногоВвода();
	УстановитьКоличествоАналитик();
	
	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Объект.Количество = 0;
		Объект.Ответственный = ПараметрыСеанса.ТекущийПользователь;
		Объект.ДатаВведения = ТекущаяДата();
	КонецЕсли;
	
	ИА_КСУОбщийСервер.СделатьКнопкуОсновной(Элементы.ГруппаКП);
	
	//
	Если Параметры.Свойство("БыстрыйРежим") Тогда 
		БыстрыйРежим = Параметры.БыстрыйРежим;
	КонецЕсли;
	Если Параметры.Свойство("ВидСтатистики") Тогда 
		Объект.ВидСтатистики = Параметры.ВидСтатистики;
		СтатистикиВидСтатистикиПриИзменении_Сервер();
	КонецЕсли;
	
	Если Параметры.Свойство("Аналитика1") Тогда 
		Объект.Аналитика1 = Параметры.Аналитика1;
	КонецЕсли;
	Если Параметры.Свойство("Аналитика2") Тогда 
		Объект.Аналитика2 = Параметры.Аналитика2;
	КонецЕсли;
	Если Параметры.Свойство("Аналитика3") Тогда 
		Объект.Аналитика3 = Параметры.Аналитика3;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьВидимостьПакетногоВвода()
	ЭтоПакет = Объект.ВводНесколькихЗначений;
	
	Элементы.ГруппаПакет.Видимость = ЭтоПакет;
	Элементы.ВидСтатистики.Доступность = не ЭтоПакет;
	
	Элементы.Аналитика1.Видимость = не ЭтоПакет и КоличествоАналитик>=1;
	Элементы.Аналитика2.Видимость = не ЭтоПакет и КоличествоАналитик>=2;
	Элементы.Аналитика3.Видимость = не ЭтоПакет и КоличествоАналитик=3;
	
	Элементы.Количество.Видимость = не ЭтоПакет;
КонецПроцедуры

&НаСервере
Процедура НастроитьДоступностьАналитик()
	
	ОбновитьВидимостьАналитикПакета();
	
	Если не Объект.ВидСтатистики.Пустая() Тогда
		Если не Объект.ВидСтатистики.Аналитика1.Пустая() Тогда
			Элементы.Аналитика1.Заголовок = Объект.ВидСтатистики.Аналитика1.Наименование;
			Элементы.Аналитика1.Видимость = Истина;
			Элементы.Аналитика1.ОтметкаНезаполненного = Не ЗначениеЗаполнено(Объект.Аналитика1);
			
			Элементы.ПакетноеДеревоАналитика1.Заголовок = Объект.ВидСтатистики.Аналитика1.Наименование;
		Конецесли;                                                                           
		
		Если не ЗначениеЗаполнено(Объект.Аналитика1) Тогда
			УстановитьТип(Объект.ВидСтатистики.Аналитика1.ТипАналитикиПолный,Элементы.Аналитика1, Объект.Аналитика1);
		КонецЕсли;
		
		Если не Объект.ВидСтатистики.Аналитика2.Пустая() Тогда
			Элементы.Аналитика2.Заголовок = Объект.ВидСтатистики.Аналитика2.Наименование;
			Элементы.Аналитика2.Видимость = Истина;
			Элементы.Аналитика2.ОтметкаНезаполненного = Не ЗначениеЗаполнено(Объект.Аналитика2);
			
			Элементы.ПакетноеДеревоАналитика2.Заголовок = Объект.ВидСтатистики.Аналитика2.Наименование;
		Конецесли;
		
		Если не ЗначениеЗаполнено(Объект.Аналитика2) Тогда
			УстановитьТип(Объект.ВидСтатистики.Аналитика2.ТипАналитикиПолный,Элементы.Аналитика2, Объект.Аналитика2);
		КонецЕсли;
		
		Если не Объект.ВидСтатистики.Аналитика3.Пустая() Тогда
			Элементы.Аналитика3.Заголовок = Объект.ВидСтатистики.Аналитика3.Наименование;
			Элементы.Аналитика3.Видимость = Истина;
			Элементы.Аналитика3.ОтметкаНезаполненного = Не ЗначениеЗаполнено(Объект.Аналитика3);
			
			Элементы.ПакетноеДеревоАналитика3.Заголовок = Объект.ВидСтатистики.Аналитика3.Наименование;
		Конецесли;
		
		Если не ЗначениеЗаполнено(Объект.Аналитика3) Тогда
			УстановитьТип(Объект.ВидСтатистики.Аналитика3.ТипАналитикиПолный,Элементы.Аналитика3, Объект.Аналитика3);
		КонецЕсли;
	Иначе
		Элементы.Аналитика1.Видимость = ложь;
		Элементы.Аналитика2.Видимость = ложь;
		Элементы.Аналитика3.Видимость = ложь;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ОбновитьДоступностьПакетногоВвода()
	Разрешено = истина;
	Если ЗначениеЗаполнено(Объект.ВидСтатистики.ПроверочныйСписок) ИЛИ не ЗначениеЗаполнено(Объект.ВидСтатистики.Аналитика1) Тогда
		Разрешено = ложь;
	КонецЕсли;
	
	Элементы.ВводНесколькихЗначений.Доступность = Разрешено;
КонецПроцедуры

&НаСервере
Процедура УстановитьТип(ЗначТип,ЭлФормы,Рекв)
	Если ЗначТип = "" Тогда
		Возврат
	КонецЕсли;

    Массив = Новый Массив;
	Массив.Добавить(Тип(ЗначТип));       
	Стр = Новый ОписаниеТипов(Массив);
	ЭлФормы.ОграничениеТипа = Стр;                 
	ЭлФормы.ОграничениеТипа.ПривестиЗначение();
	
	ЗначТип1 = ЗначТип;
	ЗначТип1 = СтрЗаменить(ЗначТип1, "СправочникСсылка", "Справочники");
	ЗначТип1 = СтрЗаменить(ЗначТип1, "ДокументСсылка", "Документы");
	ЗначТип1 = СтрЗаменить(ЗначТип1, "ПеречислениеСсылка", "Перечисления");
	Если ЗначТип1 = "" Тогда 		
		Рекв = Справочники.ИА_ЗначениеАналитики.ПустаяСсылка();
	ИначеЕсли ЗначТип1 = "Булево" тогда 
		Рекв = Ложь;
	ИначеЕсли  ЗначТип1 = "Строка" тогда	
		Рекв = "";
	ИначеЕсли ЗначТип1 = "Число" тогда
		Рекв = 0;
	ИначеЕсли ЗначТип1 = "Дата" тогда
		Рекв = Дата("01010001");
	Иначе
		Рекв = Вычислить(ЗначТип1+".ПустаяСсылка()");
	КонецЕсли;
	
	ЭлФормы.ВыбиратьТип = Ложь;
КонецПроцедуры

&НаСервере
Процедура ОбновитьВидимостьАналитикПакета()	
	Элементы.ПакетноеДеревоАналитика1.Видимость = ЗначениеЗаполнено(Объект.ВидСтатистики.Аналитика1);
	Элементы.ПакетноеДеревоАналитика2.Видимость = ЗначениеЗаполнено(Объект.ВидСтатистики.Аналитика2);
	Элементы.ПакетноеДеревоАналитика3.Видимость = ЗначениеЗаполнено(Объект.ВидСтатистики.Аналитика3);
КонецПроцедуры

&НаКлиенте
Процедура ВидСтатистикиПриИзменении(Элемент)
	
	ПакетноеДерево.ПолучитьЭлементы().Очистить();
	
	Элементы.Аналитика1.Заголовок = "Аналитика1:";
	Элементы.Аналитика2.Заголовок = "Аналитика2:";
	Элементы.Аналитика3.Заголовок = "Аналитика3:";
	Объект.Аналитика1 = Неопределено;
	Объект.Аналитика2 = Неопределено;
	Объект.Аналитика3 = Неопределено;
	Элементы.Аналитика1.Видимость = Ложь;
	Элементы.Аналитика2.Видимость = Ложь;
	Элементы.Аналитика3.Видимость = Ложь;
	
	Объект.Количество = 0;
	
	СтатистикиВидСтатистикиПриИзменении_Сервер();
	ВопросыПроверочногоСпискаУстановитьВидимость();	
КонецПроцедуры

&НаСервере
Процедура СтатистикиВидСтатистикиПриИзменении_Сервер() Экспорт
	
	НастроитьДоступностьАналитик();
	ОбновитьДоступностьПакетногоВвода();
	УстановитьКоличествоАналитик();
	
	ВопросыПроверочногоСпискаЗаполнить();
	
КонецПроцедуры

&НаКлиенте
Процедура Аналитика1НачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	НачалоВыбораАналитики(1, Элемент, Неопределено, СтандартнаяОбработка);
КонецПроцедуры

&НаКлиенте
Процедура Аналитика2НачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	НачалоВыбораАналитики(2, Элемент, Неопределено, СтандартнаяОбработка);
КонецПроцедуры

&НаКлиенте
Процедура Аналитика3НачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	НачалоВыбораАналитики(3, Элемент, Неопределено, СтандартнаяОбработка);
КонецПроцедуры

&НаКлиенте
Процедура НачалоВыбораАналитики(номерАналитики, Элемент, тд = Неопределено, СтандартнаяОбработка)
	пт = ПолучитьПолныйТип(ОБъект.ВидСтатистики, номерАналитики);
	Если пт = "СправочникСсылка.ИА_ЗначениеАналитики" или пт = "" Тогда
		СтандартнаяОбработка = Ложь;
		
		СтруктураОтбора = Новый Структура("Владелец", ПолучитьЗначениеАналитики(Объект.ВидСтатистики,номерАналитики));
		зн = Неопределено;

		ОткрытьФорму("Справочник.ИА_ЗначениеАналитики.Форма.ФормаВыбораУпр", СтруктураОтбора,,,,, Новый ОписаниеОповещения("НачалоВыбораАналитикиЗавершение", ЭтотОбъект, Новый Структура("номерАналитики, тд", номерАналитики, тд)), РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура НачалоВыбораАналитикиЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	номерАналитики = ДополнительныеПараметры.номерАналитики;
	тд = ДополнительныеПараметры.тд;
	
	
	//ПараметрыВыбора = Новый Структура("Отбор", СтруктураОтбора);
	
	зн = Результат;
	
	Если ЗначениеЗаполнено(зн) Тогда
		Если тд = Неопределено ТОгда
			Объект["Аналитика"+номерАналитики] = зн;
		Иначе
			тд["Аналитика"+номерАналитики] = зн;
			УстановитьАналитикуВСтрокиДерева(тд, номерАналитики);	
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ПолучитьПолныйТип(ВидСтатистики, номерАналитики)
	Возврат ВидСтатистики["Аналитика"+номерАналитики].ТипАналитикиПолный;
КонецФункции

&НаСервере
Функция ПолучитьЗначениеАналитики(ВидСтатистики, номерАналитики)
	Возврат ВидСтатистики["Аналитика"+номерАналитики];
КонецФункции

&НаКлиенте
Процедура ВопросыПроверочногоСпискаУстановитьВидимость()
	
	ЭтоПС = ЭтоПроверочныйСписок(Объект.ВидСтатистики);

	Элементы.ВопросыПроверочногоСписка.Видимость = ЭтоПС;
	Элементы.Количество.ТолькоПросмотр = ЭтоПС;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ЭтоПроверочныйСписок(ВидСтат)
	возврат  не ВидСтат.ПроверочныйСписок.Пустая();
КонецФункции

&НаСервере
Процедура ВопросыПроверочногоСпискаЗаполнить()
	
	Если Не ЗначениеЗаполнено(Объект.ВидСтатистики) Тогда
		Объект.ВопросыПроверочногоСписка.Очистить();
		Возврат;
	КонецЕсли; 
	
	ПроверочныйСписок = Объект.ВидСтатистики.ПроверочныйСписок;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ИА_ВопросыПроверочногоСписка.Ссылка КАК Вопрос,
	               |	ИА_ВопросыПроверочногоСписка.ВариантныйОтвет КАК ВариантныйОтвет,
	               |	ИА_ВопросыПроверочногоСписка.ОтветВопроса КАК ОтветВопроса,
	               |	ВЫБОР
	               |		КОГДА НЕ ИА_ВопросыПроверочногоСписка.ВариантныйОтвет
	               |				И ИА_ВопросыПроверочногоСписка.ОтветВопроса = 1
	               |			ТОГДА 0
	               |		КОГДА НЕ ИА_ВопросыПроверочногоСписка.ВариантныйОтвет
	               |				И ИА_ВопросыПроверочногоСписка.ОтветВопроса = 2
	               |			ТОГДА ЛОЖЬ
	               |		ИНАЧЕ НЕОПРЕДЕЛЕНО
	               |	КОНЕЦ КАК Ответ,
	               |	ИА_ВопросыПроверочногоСписка.Вопрос КАК ВопросТекст
	               |ИЗ
	               |	Справочник.ИА_ВопросыПроверочногоСписка КАК ИА_ВопросыПроверочногоСписка
	               |ГДЕ
	               |	ИА_ВопросыПроверочногоСписка.Владелец = &ПроверочныйСписок
	               |	И НЕ ИА_ВопросыПроверочногоСписка.ПометкаУдаления";
				   
	Запрос.УстановитьПараметр("ПроверочныйСписок", ПроверочныйСписок);
	Объект.ВопросыПроверочногоСписка.Загрузить(Запрос.Выполнить().Выгрузить());
		
КонецПроцедуры


&НаКлиенте
Процедура ВопросыПроверочногоСпискаВопросНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
КонецПроцедуры


&НаКлиенте
Процедура ВопросыПроверочногоСпискаВопросОчистка(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
КонецПроцедуры


&НаКлиенте
Процедура ВопросыПроверочногоСпискаПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	
	Отказ = Истина;
	
КонецПроцедуры


&НаКлиенте
Процедура ВопросыПроверочногоСпискаОтветНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	
	ТекущаяСтрока = Элементы.ВопросыПроверочногоСписка.ТекущиеДанные;
	Если ТекущаяСтрока.ВариантныйОтвет Тогда
		СтандартнаяОбработка = Ложь;
		ВыбранноеЗначение = Неопределено;
	
		ВыбранноеЗначение = ВыбратьИзСписка(ПолучитьСписокОтветов(ТекущаяСтрока.Вопрос));
		ТекущаяСтрока.Ответ = ?(ВыбранноеЗначение = Неопределено, Неопределено, ВыбранноеЗначение.Значение);
			
		ПересчитатьБаллСтроки(ТекущаяСтрока);
		
		Модифицированность = Истина;

	КонецЕсли; 
		
КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьБаллСтроки(ТекСтрока)
	
	Если ТекСтрока.Ответ <> Неопределено Тогда
		ТекСтрока.Балл = РассчитатьБаллВСтроке(ТекСтрока.Вопрос, ТекСтрока.ВариантныйОтвет, ТекСтрока.Ответ);		
	Иначе
		ТекСтрока.Балл = 0;
	КонецЕсли; 
	
	итого = 0;
	Для каждого стр из Объект.ВопросыПроверочногоСписка Цикл
		итого = итого + стр.Балл;
	КонецЦикла;
	Объект.Количество = итого;
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьСписокОтветов(Вопрос)
	
	СписокОтветов = Новый СписокЗначений;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	ИА_ВопросыПроверочногоСпискаВариантыОтветов.Ответ
	               |ИЗ
	               |	Справочник.ИА_ВопросыПроверочногоСписка.ВариантыОтветов КАК ИА_ВопросыПроверочногоСпискаВариантыОтветов
	               |ГДЕ
	               |	ИА_ВопросыПроверочногоСпискаВариантыОтветов.Ссылка = &Вопрос";
				   
	Запрос.УстановитьПараметр("Вопрос", Вопрос);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СписокОтветов.Добавить(Выборка.Ответ);
	КонецЦикла; 
	
	Возврат СписокОтветов;
	
КонецФункции

&НаСервереБезКонтекста
Функция РассчитатьБаллВСтроке(Вопрос, ВариантныйОтвет, Ответ)
	
	БаллВСтроке = 0;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Вопрос", Вопрос);
	Запрос.УстановитьПараметр("Ответ", Ответ);
	Запрос.УстановитьПараметр("ВариантныйОтвет", ВариантныйОтвет);
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	               |	ИА_ВопросыПроверочногоСпискаВариантыОтветов.Балл
	               |ИЗ
	               |	Справочник.ИА_ВопросыПроверочногоСписка.ВариантыОтветов КАК ИА_ВопросыПроверочногоСпискаВариантыОтветов
	               |ГДЕ
	               |	ИА_ВопросыПроверочногоСпискаВариантыОтветов.Ссылка = &Вопрос
	               |	И ИА_ВопросыПроверочногоСпискаВариантыОтветов.Ответ = &Ответ
	               |	И &ВариантныйОтвет
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	ИА_ВопросыПроверочногоСписка.БаллВопроса
	               |ИЗ
	               |	Справочник.ИА_ВопросыПроверочногоСписка КАК ИА_ВопросыПроверочногоСписка
	               |ГДЕ
	               |	ИА_ВопросыПроверочногоСписка.Ссылка = &Вопрос
	               |	И НЕ &ВариантныйОтвет";
				   
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		БаллВСтроке = Выборка.Балл;		
	КонецЕсли;
	Если Не ВариантныйОтвет И (ТипЗНЧ(Ответ) = Тип("Булево") ИЛИ ТипЗНЧ(Ответ) = Тип("Число")) Тогда
		БаллВСтроке = БаллВСтроке * Ответ;		
	КонецЕсли; 
	
	Возврат БаллВСтроке;
	
КонецФункции

