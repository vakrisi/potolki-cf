&НаСервере
Процедура ОбновитьДеревоПакета()
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ТЗ.Аналитика1 КАК Аналитика1,
	               |	ТЗ.Аналитика2 КАК Аналитика2,
	               |	ТЗ.Аналитика3 КАК Аналитика3,
	               |	ТЗ.Количество КАК Количество
	               |ПОМЕСТИТЬ ВТЗ
	               |ИЗ
	               |	&ТЗ КАК ТЗ
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ИА_СтатистикаПакетСтатистик.Аналитика1 КАК Аналитика1,
	               |	ИА_СтатистикаПакетСтатистик.Аналитика2 КАК Аналитика2,
	               |	ИА_СтатистикаПакетСтатистик.Аналитика3 КАК Аналитика3,
	               |	ИА_СтатистикаПакетСтатистик.Количество КАК Количество
	               |ИЗ
	               |	ВТЗ КАК ИА_СтатистикаПакетСтатистик
	               |ИТОГИ
	               |	СУММА(Количество)
	               |ПО
	               |	Аналитика1,
	               |	Аналитика2,
	               |	Аналитика3";
	Запрос.УстановитьПараметр("ТЗ", Объект.ПакетСтатистик.Выгрузить());
	
	Дер = Запрос.Выполнить().Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам);
	//
	
	РезДер = РеквизитФормыВЗначение("ПакетноеДерево");
	РезДер.Строки.Очистить();
	
	Для каждого стр1 из Дер.Строки Цикл
		Новстр1 = РезДер.Строки.Добавить();
		ЗаполнитьЗначенияСвойств(Новстр1,стр1);
		Для каждого стр2 из стр1.Строки Цикл
			Если ЗначениеЗаполнено(стр2.Аналитика2) Тогда
				Новстр2 = Новстр1.Строки.Добавить();
				ЗаполнитьЗначенияСвойств(Новстр2,стр2);
			Иначе
				Продолжить;
			КонецЕсли;
			
			Для каждого стр3 из стр2.Строки Цикл
				Если ЗначениеЗаполнено(стр3.Аналитика3) Тогда
					Новстр3 = Новстр2.Строки.Добавить();
					ЗаполнитьЗначенияСвойств(Новстр3,стр3);
				Иначе
					Продолжить;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	
	//
	ЗначениеВРеквизитФормы(РезДер, "ПакетноеДерево");
КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьИтогиДерева()
	Для каждого стр1 из ПакетноеДерево.ПолучитьЭлементы() Цикл
		Если стр1.ПолучитьЭлементы().Количество()>0 Тогда
			Итог1 = 0;
			Для каждого стр2 из стр1.ПолучитьЭлементы() Цикл
				Если стр2.ПолучитьЭлементы().Количество()>0 Тогда
					Итог2 = 0;
					Для каждого стр3 из стр2.ПолучитьЭлементы() Цикл
						Итог2 = Итог2 + стр3.Количество;
					КонецЦикла;
					стр2.Количество = Итог2;
				КонецЕсли;
				Итог1 = Итог1 + стр2.Количество;
			КонецЦикла;
			стр1.Количество = Итог1;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

