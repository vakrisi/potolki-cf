&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	Объект.ПакетСтатистик.Очистить();
	Если Объект.ВводНесколькихЗначений Тогда
		Для каждого стр1 из ПакетноеДерево.ПолучитьЭлементы() Цикл
			Если КоличествоАналитик = 1 Тогда
				Новстр = Объект.ПакетСтатистик.Добавить();
				ЗаполнитьЗначенияСвойств(Новстр, стр1);
				Продолжить;
			КонецЕсли;
			
			Для каждого стр2 из стр1.ПолучитьЭлементы() Цикл
				Если КоличествоАналитик = 2 Тогда
					Новстр = Объект.ПакетСтатистик.Добавить();
					ЗаполнитьЗначенияСвойств(Новстр, стр2);
					Продолжить;
				КонецЕсли;
				Для каждого стр3 из стр2.ПолучитьЭлементы() Цикл
					Новстр = Объект.ПакетСтатистик.Добавить();
					ЗаполнитьЗначенияСвойств(Новстр, стр3);
				КонецЦикла;	
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

