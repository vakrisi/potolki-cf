
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("СброситьПериод") Тогда
		
		ПериодСписка = Элементы.Список.Период;
		ПериодСписка.Вариант       = ВариантСтандартногоПериода.ПроизвольныйПериод;
		ПериодСписка.ДатаНачала    = Дата(1,1,1);
		ПериодСписка.ДатаОкончания = Дата(1,1,1);
		
	КонецЕсли;
	
	ИА_КСУОбщийСервер.СделатьКнопкуОсновной(Элементы.ГруппаКП);
КонецПроцедуры
