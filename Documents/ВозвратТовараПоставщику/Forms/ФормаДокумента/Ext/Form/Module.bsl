&НаКлиенте
Процедура ТоварыЕдиницаИзмеренияПриИзменении(Элемент)
	
	СтрокаТабличнойЧасти = Элементы.Товары.ТекущиеДанные;
	Если ТипЗнч(СтрокаТабличнойЧасти.ЕдиницаИзмерения) = Тип("СправочникСсылка.КлассификаторЕдиницИзмерения") Тогда
		СтрокаТабличнойЧасти.Коэффициент = 1;
	Иначе
		СтрокаТабличнойЧасти.Коэффициент = ОбщийМодуль.ПолучитьКоэффициентЕдиницыИзмерения(СтрокаТабличнойЧасти.ЕдиницаИзмерения);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыКоличествоПриИзменении(Элемент)
	
	СтрокаТабличнойЧасти = Элементы.Товары.ТекущиеДанные;
	ОбработкаТабличныхЧастейКлиент.ПересчитатьСуммуСУчетомСкидокВСтрокеТЧ(СтрокаТабличнойЧасти, Ложь, Ложь);	
	ОбработкаТабличныхЧастейКлиент.ПересчитатьСуммуНДСВСтрокеТЧ(СтрокаТабличнойЧасти, УчитыватьНДС);
	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыЦенаПриИзменении(Элемент)
	
	СтрокаТабличнойЧасти = Элементы.Товары.ТекущиеДанные;
	ОбработкаТабличныхЧастейКлиент.ПересчитатьСуммуСУчетомСкидокВСтрокеТЧ(СтрокаТабличнойЧасти, Ложь, Ложь);	
	ОбработкаТабличныхЧастейКлиент.ПересчитатьСуммуНДСВСтрокеТЧ(СтрокаТабличнойЧасти, УчитыватьНДС);
	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыСуммаПриИзменении(Элемент)
	
	СтрокаТабличнойЧасти = Элементы.Товары.ТекущиеДанные;
	Если НЕ СтрокаТабличнойЧасти.Количество = 0 Тогда
		СтрокаТабличнойЧасти.Цена = СтрокаТабличнойЧасти.Сумма / СтрокаТабличнойЧасти.Количество;
	КонецЕсли;	
	ОбработкаТабличныхЧастейКлиент.ПересчитатьСуммуНДСВСтрокеТЧ(СтрокаТабличнойЧасти, УчитыватьНДС);
	
КонецПроцедуры
												   
&НаКлиенте
Процедура ТоварыНоменклатураПриИзменении(Элемент)
	
	СтрокаТабличнойЧасти = Элементы.Товары.ТекущиеДанные;
	СтруктураДанные = Новый Структура;
	СтруктураДанные.Вставить("Номенклатура", СтрокаТабличнойЧасти.Номенклатура);
	СтруктураДанные = ОбработкаТабличныхЧастейКлиент.ПолучитьДанныеНоменклатурыПриИзменении(СтруктураДанные);	
	ЗаполнитьЗначенияСвойств(СтрокаТабличнойЧасти, СтруктураДанные, "ЕдиницаИзмерения, Коэффициент, СтатьяДоходов");
		
КонецПроцедуры

&НаКлиенте
Процедура ТоварыЕдиницаИзмеренияНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	СтрокаТабличнойЧасти = Элементы.Товары.ТекущиеДанные;
	СписокЕдиниц = ОбщийМодуль.ПолучитьСписокЕдиницИзмеренияНоменклатуры(СтрокаТабличнойЧасти.Номенклатура);
	
	ДанныеВыбора = Новый СписокЗначений;
	Для Ном = 0 По СписокЕдиниц.Количество() - 1 Цикл
		ДанныеВыбора.Добавить(СписокЕдиниц[Ном]);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыЕдиницаИзмеренияОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	СтрокаТабличнойЧасти = Элементы.Товары.ТекущиеДанные;
	Если ТипЗнч(ВыбранноеЗначение) = Тип("СправочникСсылка.КлассификаторЕдиницИзмерения") Тогда
		СтрокаТабличнойЧасти.Коэффициент = 1;
	Иначе
		СтрокаТабличнойЧасти.Коэффициент = ОбщийМодуль.ПолучитьКоэффициентЕдиницыИзмерения(ВыбранноеЗначение);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьСписокВидовНоменклатурыТовары()
	
	Возврат Справочники.Номенклатура.ПолучитьСписокВидовНоменклатурыТовары();
	
КонецФункции

&НаКлиенте
Процедура ПодобратьТовары(Команда)
	
	ПараметрыПодбора = Новый Структура;
	ПараметрыПодбора.Вставить("Дата",					Объект.Дата);
	ПараметрыПодбора.Вставить("Организация",			Объект.Организация);
	ПараметрыПодбора.Вставить("Склад",					Объект.Склад);
	ПараметрыПодбора.Вставить("ВидНоменклатуры",		ПолучитьСписокВидовНоменклатурыТовары());
	
	ОткрытьФорму("ОбщаяФорма.ФормаПодбораНоменклатуры", ПараметрыПодбора, ЭтаФорма, УникальныйИдентификатор);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбораПодборНаКлиенте(ВыбранноеЗначение)
	
	Если Не ЗначениеЗаполнено(ВыбранноеЗначение) Тогда
		Возврат;
	КонецЕсли;
			
	ОбработкаВыбораПодборНаСервере(ВыбранноеЗначение);
		
КонецПроцедуры

&НаСервере
Функция ОбработкаВыбораПодборНаСервере(ВыбранноеЗначение)
	
	ТаблицаТоваров = ПолучитьИзВременногоХранилища(ВыбранноеЗначение.АдресВХранилище);
	
	Для Каждого ТекущаяСтрока из ТаблицаТоваров Цикл
		НоваяСтрока = Объект.Товары.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущаяСтрока);
	КонецЦикла;
	
	РассчитатьИтоговыеПоказатели(); 
	
КонецФункции

&НаКлиенте
Процедура ЗаполнитьПоПоступлению(Команда)
	Если Объект.Товары.Количество() > 0 Тогда 
		ОП = Новый ОписаниеОповещения("ДействиеПослеВопросаОбОчистке", ЭтотОбъект);
		ПоказатьВопрос(ОП, "Таблица товаров будет очищена.
					|Продолжить?", РежимДиалогаВопрос.ДаНет);
	Иначе
		ПоказатьДиалогВыбораПоступления();			
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьДиалогВыбораПоступления()
	
	ВидДокумента = ПолучитьПустоеПоступление();
	ОП = Новый ОписаниеОповещения("ПослеВыбораПоступления", ЭтотОбъект);
	ПоказатьВводЗначения(ОП,ВидДокумента);

КонецПроцедуры

&НаКлиенте
Процедура ДействиеПослеВопросаОбОчистке(Результат, Допы) Экспорт
	Если Результат = КодВозвратаДиалога.Да Тогда 
		Объект.Товары.Очистить();
		ПоказатьДиалогВыбораПоступления();
	КонецЕсли;	
КонецПроцедуры

&НаСервере
Функция ПолучитьПустоеПоступление()
	Возврат Документы.ПоступлениеТоваровИУслуг.ПустаяСсылка();
КонецФункции

&НаСервере
Процедура ПослеВыбораПоступления(ВыбЗнач, Допы) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДокументПоступления", ВыбЗнач);
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ПоступлениеТоваровИУслуг.Ссылка,
	|	ПоступлениеТоваровИУслуг.Номенклатура,
	|	ПоступлениеТоваровИУслуг.ХарактеристикаНоменклатуры,
	|	ПоступлениеТоваровИУслуг.СерияНоменклатуры,
	|	ПоступлениеТоваровИУслуг.ЕдиницаИзмерения,
	|	ПоступлениеТоваровИУслуг.Коэффициент,
	|	ПоступлениеТоваровИУслуг.Количество,
	|	ПоступлениеТоваровИУслуг.Цена,
	|	ПоступлениеТоваровИУслуг.Сумма,
	|	ПоступлениеТоваровИУслуг.Ссылка.Контрагент КАК Контрагент
	|ИЗ
	|	Документ.ПоступлениеТоваровИУслуг.Товары КАК ПоступлениеТоваровИУслуг
	|ГДЕ
	|	ПоступлениеТоваровИУслуг.Ссылка = &ДокументПоступления";
	
	РезультатЗапроса = Запрос.Выполнить();
	Если не РезультатЗапроса.Пустой() Тогда 
		Выборка = РезультатЗапроса.Выбрать();
		Пока Выборка.Следующий() Цикл
			НоваяСтрока = Объект.Товары.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
			Контрик = Выборка.Контрагент;			
		КонецЦикла;
		Объект.Контрагент = Контрик;
		КонтрагентПриИзмененииНаСервере();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ТоварыСтавкаНДСПриИзменении(Элемент)
	
	СтрокаТабличнойЧасти = Элементы.Товары.ТекущиеДанные;	
	ОбработкаТабличныхЧастейКлиент.ПересчитатьСуммуНДСВСтрокеТЧ(СтрокаТабличнойЧасти, УчитыватьНДС);
	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыКомнатаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	ДанныеВыбора = Новый СписокЗначений;
	ДанныеВыбора.ЗагрузитьЗначения(СписокКомнатОснования.ВыгрузитьЗначения());
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПоПоследнимПоступлениям(Команда)
	Если НЕ ЗначениеЗаполнено(Объект.Контрагент)
		ИЛИ НЕ ЗначениеЗаполнено(Объект.Организация) Тогда
		ПоказатьПредупреждение(, "Не указана организация или контрагент");
		Возврат;
	КонецЕсли;
	
	ОписаниеОповещенияВопрос = Новый ОписаниеОповещения("ЗаполнитьЦеныПоПоступлениямПослеВопроса", ЭтаФорма);
	ПоказатьВопрос(ОписаниеОповещенияВопрос, "Цены будут изменены. Продолжить?", РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьЦеныПоПоступлениямПослеВопроса(Результат, Параметры) Экспорт
	
    Если Результат = КодВозвратаДиалога.Да Тогда
		ЗаполнитьЦеныПоПоследнимПоступлениямНаСервере();
		Модифицированность = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьЦеныПоПоследнимПоступлениямНаСервере()
	
	МассивНоменклатуры = Объект.Товары.Выгрузить().ВыгрузитьКолонку("Номенклатура");
	Если МассивНоменклатуры.Количество() = 0 Тогда
		Сообщить("Табличная часть пустая");
		Возврат;
	КонецЕсли;
	
	ТаблицаРаспределения = Новый ТаблицаЗначений;
	ТаблицаРаспределения.Колонки.Добавить("Номенклатура");
	ТаблицаРаспределения.Колонки.Добавить("ХарактеристикаНоменклатуры");
	ТаблицаРаспределения.Колонки.Добавить("СерияНоменклатуры");
	ТаблицаРаспределения.Колонки.Добавить("ЕдиницаИзмерения");
	ТаблицаРаспределения.Колонки.Добавить("Количество");
	ТаблицаРаспределения.Колонки.Добавить("Цена");
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	Запрос.УстановитьПараметр("Контрагент",  Объект.Контрагент);
	Запрос.УстановитьПараметр("МассивНоменклатуры", МассивНоменклатуры);
	Запрос.УстановитьПараметр("Дата", Объект.Дата);
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Закупки.Номенклатура КАК Номенклатура,
	|	ЕСТЬNULL(Закупки.ХарактеристикаНоменклатуры, ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)) КАК ХарактеристикаНоменклатуры,
	|	ЕСТЬNULL(Закупки.СерияНоменклатуры, ЗНАЧЕНИЕ(Справочник.СерииНоменклатуры.ПустаяСсылка)) КАК СерияНоменклатуры,
	|	Закупки.Регистратор КАК Регистратор,
	|	Закупки.Период КАК Период,
	|	Закупки.Количество КАК Количество,
	|	Закупки.Сумма / Закупки.Количество КАК Цена
	|ПОМЕСТИТЬ ВТ_Закупки
	|ИЗ
	|	РегистрНакопления.Закупки КАК Закупки
	|ГДЕ
	|	Закупки.Период < &Дата
	|	И Закупки.Организация = &Организация
	|	И Закупки.Контрагент = &Контрагент
	|	И Закупки.Номенклатура В(&МассивНоменклатуры)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Закупки.Номенклатура КАК Номенклатура,
	|	ВТ_Закупки.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	|	ВТ_Закупки.СерияНоменклатуры КАК СерияНоменклатуры,
	|	ВТ_Закупки.Период КАК Период,
	|	ВТ_Закупки.Регистратор КАК Регистратор,
	|	ВТ_Закупки.Количество КАК Количество,
	|	ВТ_Закупки.Цена КАК Цена
	|ИЗ
	|	ВТ_Закупки КАК ВТ_Закупки
	|
	|УПОРЯДОЧИТЬ ПО
	|	ВТ_Закупки.Период УБЫВ
	|ИТОГИ ПО
	|	Номенклатура,
	|	ХарактеристикаНоменклатуры,
	|	СерияНоменклатуры";
	
	ВыборкаНоменклатура = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам, "Номенклатура");
	Пока ВыборкаНоменклатура.Следующий() Цикл
		ВыборкаХарактеристика = ВыборкаНоменклатура.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам, "ХарактеристикаНоменклатуры");
		Пока ВыборкаХарактеристика.Следующий() Цикл
			ВыборкаСерия = ВыборкаХарактеристика.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам, "СерияНоменклатуры");
			Пока ВыборкаСерия.Следующий() Цикл
				
				ПараметрыОтбораСтрок = Новый Структура("Номенклатура, ХарактеристикаНоменклатуры, СерияНоменклатуры", ВыборкаНоменклатура.Номенклатура, ВыборкаХарактеристика.ХарактеристикаНоменклатуры, ВыборкаСерия.СерияНоменклатуры);		
				НайденныеСтроки = Объект.Товары.НайтиСтроки(ПараметрыОтбораСтрок);
				Если НайденныеСтроки.Количество() > 0 Тогда
					
					НакоплениеОбщее 	 = 0;
					ОстатокРаспределения = 0;
					НакоплениеПродажа 	 = 0;
					
					// определяем какое количество номенклатуры надо рапределить 
					Для каждого ЭлементМассива из НайденныеСтроки Цикл
						ОстатокРаспределения = ОстатокРаспределения + ЭлементМассива.Количество * ЭлементМассива.Коэффициент;
					КонецЦикла;
					
					ВыборкаЗакупки = ВыборкаСерия.Выбрать();					
					Пока ВыборкаЗакупки.Следующий() Цикл
						ВыборкаКоличествоВСтроке = ВыборкаЗакупки.Количество;
						НакоплениеОбщее = НакоплениеОбщее + ВыборкаКоличествоВСтроке;
						
						Если НакоплениеОбщее > 0 И ВыборкаКоличествоВСтроке > 0 Тогда
							// возможно использование документа
							КоличествоРаспределения = Мин(ОстатокРаспределения, НакоплениеОбщее, ВыборкаКоличествоВСтроке);
							
							НоваяСтрокаРаспределения = ТаблицаРаспределения.Добавить();
							НоваяСтрокаРаспределения.Номенклатура = ВыборкаНоменклатура.Номенклатура;
							НоваяСтрокаРаспределения.ХарактеристикаНоменклатуры = ВыборкаХарактеристика.ХарактеристикаНоменклатуры;
							НоваяСтрокаРаспределения.СерияНоменклатуры = ВыборкаСерия.СерияНоменклатуры;		
							
							НоваяСтрокаРаспределения.Количество = КоличествоРаспределения;
							НоваяСтрокаРаспределения.Цена = ВыборкаЗакупки.Цена;
							
							ОстатокРаспределения = ОстатокРаспределения - КоличествоРаспределения;
							
						КонецЕсли;
						
						Если ОстатокРаспределения <= 0 Тогда				
							Прервать;				
						КонецЕсли;	
					КонецЦикла;
				Иначе
					// не сошлись характеристики или серии, ничего не делаем
					Продолжить;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	
	
	Если ТаблицаРаспределения.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
		
	ТаблицаРезультата = Объект.Товары.Выгрузить();
	ТаблицаРезультата.Очистить();
	ТоварыТЧ = Объект.Товары.Выгрузить();
	ТоварыТЧ.Свернуть("Номенклатура, ХарактеристикаНоменклатуры, СерияНоменклатуры, ЕдиницаИзмерения, Коэффициент", "Количество");
	
	Для каждого СтрокаТЧ из ТоварыТЧ Цикл
		ПараметрыОтбораСтрок = Новый Структура("Номенклатура, ХарактеристикаНоменклатуры, СерияНоменклатуры", СтрокаТЧ.Номенклатура, СтрокаТЧ.ХарактеристикаНоменклатуры, СтрокаТЧ.СерияНоменклатуры);		
		НайденныеСтроки = ТаблицаРаспределения.НайтиСтроки(ПараметрыОтбораСтрок);
		Если НайденныеСтроки.Количество() > 0 Тогда
			КоличествоКРаспределению = СтрокаТЧ.Количество*СтрокаТЧ.Коэффициент;
			Для каждого ЭлементМассива из НайденныеСтроки Цикл
				НоваяСтрока = ТаблицаРезультата.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТЧ);
				НоваяСтрока.Коэффициент 		= СтрокаТЧ.Коэффициент;
				НоваяСтрока.Количество 			= ЭлементМассива.Количество / НоваяСтрока.Коэффициент;		
				НоваяСтрока.Цена 				= ЭлементМассива.Цена * НоваяСтрока.Коэффициент;
				НоваяСтрока.Сумма 				= ЭлементМассива.Количество * ЭлементМассива.Цена;
				КоличествоКРаспределению 		= КоличествоКРаспределению - НоваяСтрока.Количество*НоваяСтрока.Коэффициент;
			КонецЦикла;
			
			// не все распределилось по документам
			Если КоличествоКРаспределению > 0 Тогда
				НоваяСтрока = ТаблицаРезультата.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТЧ);
				НоваяСтрока.Количество = КоличествоКРаспределению;
				НоваяСтрока.Сумма = 0;
				НоваяСтрока.Цена = 0;
			КонецЕсли;
		Иначе
			НоваяСтрока = ТаблицаРезультата.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТЧ);
		КонецЕсли;
	КонецЦикла;
	
	Объект.Товары.Загрузить(ТаблицаРезультата);
	
	РассчитатьИтоговыеПоказатели();
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьДополнительнуюИнформацию(Команда)
	
	ОбщийМодульКлиент.ФормаДополнительнойИнформацииКонтрагента(Объект.Контрагент);
	
КонецПроцедуры

