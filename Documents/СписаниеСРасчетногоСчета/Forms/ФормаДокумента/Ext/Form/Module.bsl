&НаКлиенте
Процедура Распределение_ПодобратьПоОстаткам(Команда)
	
	Оповещение = Новый ОписаниеОповещения("ПодобратьПоОстаткамЗавершение", ЭтотОбъект);
	ОбщийМодульКлиент.ПроверитьВозможностьПодбораЗаказовВДокументРасхода(Оповещение, ЭтаФорма, Объект.РаспределениеПлатежа);
		
КонецПроцедуры

&НаКлиенте
Процедура ПодобратьПоОстаткамЗавершение(Результат, ДополнительныеПараметры) Экспорт 
	
	АдресПлатежейВХранилище = ПоместитьРасшифровкуПлатежаВХранилище();
	
	ПараметрыПодбора = Новый Структура;
	ПараметрыПодбора.Вставить("АдресПлатежейВХранилище", АдресПлатежейВХранилище);
	ПараметрыПодбора.Вставить("Организация", Объект.Организация);
	ПараметрыПодбора.Вставить("Контрагент", Объект.Контрагент);
	ПараметрыПодбора.Вставить("Валюта", Объект.Валюта);
	ПараметрыПодбора.Вставить("СуммаДокумента", Объект.Сумма);
	ПараметрыПодбора.Вставить("ДатаДокумента", Объект.Дата);
	
	ОткрытьФорму("ОбщаяФорма.ФормаПодбораПоРасчетамСКонтрагентами",	ПараметрыПодбора, ЭтаФорма);
	
КонецПроцедуры

&НаСервере
Функция ПоместитьРасшифровкуПлатежаВХранилище()
	
	АдресПлатежейВХранилище = ПоместитьВоВременноеХранилище(Объект.РаспределениеПлатежа.Выгрузить(), УникальныйИдентификатор);
	Возврат АдресПлатежейВХранилище;
	
КонецФункции

&НаСервере
Процедура ПолучитьРаспределениеПлатежаИзХранилища(АдресПлатежейВХранилище)
	
	Объект.РаспределениеПлатежа.Загрузить(ПолучитьИзВременногоХранилища(АдресПлатежейВХранилище));
	
КонецПроцедуры

&НаКлиенте
Процедура Распределение_Команда(Команда)
	
	ИмяФормыВыбора = "Документ." + СтрЗаменить(Команда.Имя, "Распределение_", "") + ".ФормаВыбора";
	Если Не Объект.Контрагент.Пустая() Тогда
		ЗначениеОтбора = Новый Структура("Контрагент", Объект.Контрагент);
		ПараметрВыбора = Новый Структура("Отбор", ЗначениеОтбора);
		ПараметрВыбора.Вставить("МножественныйВыбор", Истина);
		ОткрытьФорму(ИмяФормыВыбора, ПараметрВыбора, Элементы.РаспределениеПлатежа);
		// результат обрабатывается в РаспределениеПлатежаОбработкаВыбора как владельца формы выбора
	Иначе
		Состояние("Не указан контрагент");
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура РаспределениеПлатежаОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	Для каждого ВыбранныйДокумент из ВыбранноеЗначение Цикл
		Если НЕ ВыбранныйДокумент.Пустая() Тогда
			НоваяСтрока = Объект.РаспределениеПлатежа.Добавить();
			НоваяСтрока.Документ = ВыбранныйДокумент;
			НоваяСтрока.Сумма = Объект.Сумма;
		КонецЕсли;
	КонецЦикла;
	
	//ОбновитьДанные();
	
КонецПроцедуры

//++ №12092
&НаКлиенте
Процедура ЗарплатаСотрудникам_ЗаполнитьПоОстаткам(Команда)
	
	Если Объект.ЗарплатаСотрудникам.Количество() > 0 Тогда
		
		ОписаниеОповещения = новый ОписаниеОповещения("ПослеВопросаОбОчищенииТабличнойЧастиЗарплатаСотрудникам", ЭтотОбъект);
		ПоказатьВопрос(ОписаниеОповещения, "При продолжении табличная часть будет очищена, продолжить?", РежимДиалогаВопрос.ДаНет);
		
	Иначе
		
		ЗарплатаСотрудникам_ЗаполнитьПоОстаткамНаСервере();
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВопросаОбОчищенииТабличнойЧастиЗарплатаСотрудникам(Ответ, ДополнительныеПараметры) Экспорт
	
	Если НЕ Ответ = КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	ЗарплатаСотрудникам_ЗаполнитьПоОстаткамНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ЗарплатаСотрудникам_ЗаполнитьПоОстаткамНаСервере()
	
	Объект.ЗарплатаСотрудникам.Очистить();
	
	Запрос = новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	БанковскиеСчета.Владелец КАК Сотрудник,
	|	МАКСИМУМ(БанковскиеСчета.Ссылка) КАК Ссылка,
	|	СУММА(1) КАК КоличествоСчетов
	|ПОМЕСТИТЬ ВТ_БанковскиеСчетаСотрудников
	|ИЗ
	|	Справочник.БанковскиеСчета КАК БанковскиеСчета
	|ГДЕ
	|	НЕ БанковскиеСчета.ПометкаУдаления
	|	И БанковскиеСчета.Владелец ССЫЛКА Справочник.Сотрудники
	|	
	|СГРУППИРОВАТЬ ПО
	|	БанковскиеСчета.Владелец
	|;
	|//////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	РасчетыСПерсоналомОстатки.Сотрудник КАК Сотрудник,
	|   РасчетыСПерсоналомОстатки.СуммаОстаток КАК Сумма,
	|	ЕСТЬNULL(БанковскиеСчетаСотрудников.Ссылка, Значение(Справочник.БанковскиеСчета.ПустаяСсылка)) КАК СчетСотрудника
	|ИЗ
	|	РегистрНакопления.РасчетыСПерсоналом.Остатки(&Дата, Организация = &Организация) КАК РасчетыСПерсоналомОстатки
	|
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_БанковскиеСчетаСотрудников КАК БанковскиеСчетаСотрудников
	|      	ПО РасчетыСПерсоналомОстатки.Сотрудник = БанковскиеСчетаСотрудников.Сотрудник
	|			И БанковскиеСчетаСотрудников.КоличествоСчетов = 1
	|
	|ГДЕ
	|	РасчетыСПерсоналомОстатки.СуммаОстаток > 0
	|";
	Запрос.УстановитьПараметр("Дата", ?(ЗначениеЗаполнено(Объект.Ссылка), Объект.Дата, ТекущаяДатаСеанса()));
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		НоваяСтрока = Объект.ЗарплатаСотрудникам.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		
	КонецЦикла;
	
	Объект.Сумма = Объект.ЗарплатаСотрудникам.Итог("Сумма");
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗарплатаСотрудникамПослеУдаления(Элемент)
	
	Объект.Сумма = Объект.ЗарплатаСотрудникам.Итог("Сумма");
	
КонецПроцедуры

&НаКлиенте
Процедура СуммаПроцентовПоЗаймуПриИзменении(Элемент)
	Если Объект.Сумма > 0 И Объект.Сумма > Объект.СуммаПроцентовПоЗайму Тогда
		 Объект.СуммаОсновногоТелаЗайма = Объект.Сумма - Объект.СуммаПроцентовПоЗайму;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура СуммаОсновногоТелаЗаймаПриИзменении(Элемент)
	Если Объект.Сумма > 0 И Объект.Сумма > Объект.СуммаОсновногоТелаЗайма Тогда
		Объект.СуммаПроцентовПоЗайму = Объект.Сумма - Объект.СуммаОсновногоТелаЗайма;
	КонецЕсли;
КонецПроцедуры
