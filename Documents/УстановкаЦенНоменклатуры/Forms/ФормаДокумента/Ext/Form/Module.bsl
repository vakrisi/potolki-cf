&НаСервере
Процедура ЗаполнитьЦеныПоПоследнемуПоступлениюНаСервере(ПараметрыЗаполнения)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	ПоступлениеТоваровТовары.Номенклатура,
		|	ПоступлениеТоваровТовары.ХарактеристикаНоменклатуры,
		|	ПоступлениеТоваровТовары.ЕдиницаИзмерения,
		|	ПоступлениеТоваровТовары.Цена
		|ИЗ
		|	Документ.ПоступлениеТоваровИУслуг.Товары КАК ПоступлениеТоваровТовары
		|ГДЕ
		|	ПоступлениеТоваровТовары.Ссылка.Дата < &Период
		|	И ПоступлениеТоваровТовары.Ссылка.Организация = &Организация
		|	И ПоступлениеТоваровТовары.Номенклатура = &Номенклатура
		|	И ПоступлениеТоваровТовары.ХарактеристикаНоменклатуры = &ХарактеристикаНоменклатуры
		|	И ПоступлениеТоваровТовары.ЕдиницаИзмерения = &ЕдиницаИзмерения
		|	И ПоступлениеТоваровТовары.Ссылка.Валюта = &Валюта
		|
		|УПОРЯДОЧИТЬ ПО
		|	ПоступлениеТоваровТовары.Ссылка.Дата УБЫВ";
	Запрос.УстановитьПараметр("Период", ?(Объект.Ссылка.Пустая(), ТекущаяДатаСеанса(), Объект.Дата));
	Запрос.УстановитьПараметр("Организация", ПараметрыЗаполнения.Организация);
	Запрос.УстановитьПараметр("Валюта", Объект.Валюта);
	
	Дерево = ДеревоЦен.ПолучитьЭлементы();
	Для Каждого ТекущаяНоменклатура Из Дерево Цикл
		
		ИмяКолонки = УстановкаЦенСервер.ИмяКолонкиПоВидуЦены(ПараметрыЗаполнения.ВидЦены);
		ЕстьКолонкаЦены = ТекущаяНоменклатура.Свойство(ИмяКолонки);
		Если ЕстьКолонкаЦены Тогда
			
			ТекущаяНоменклатура[ИмяКолонки] = 0;
			
			Запрос.УстановитьПараметр("Номенклатура", ТекущаяНоменклатура.Номенклатура);
			Запрос.УстановитьПараметр("ХарактеристикаНоменклатуры", ТекущаяНоменклатура.ХарактеристикаНоменклатуры);
			Запрос.УстановитьПараметр("ЕдиницаИзмерения", ТекущаяНоменклатура.ЕдиницаИзмерения);
			
			Выборка = Запрос.Выполнить().Выбрать();
			Если Выборка.Следующий() Тогда				
				ТекущаяНоменклатура[ИмяКолонки] = Выборка.Цена;
			КонецЕсли;
			
		КонецЕсли;
		
		//с характеристиками
		ЭлементыХарактеристик = ТекущаяНоменклатура.ПолучитьЭлементы();
		Для Каждого ТекущаяСтрока Из ЭлементыХарактеристик Цикл
			ИмяКолонки = УстановкаЦенСервер.ИмяКолонкиПоВидуЦены(ПараметрыЗаполнения.ВидЦены);
			ЕстьКолонкаЦены = ТекущаяСтрока.Свойство(ИмяКолонки);
			Если ЕстьКолонкаЦены Тогда
				
				ТекущаяСтрока[ИмяКолонки] = 0;
			
				Запрос.УстановитьПараметр("Номенклатура", ТекущаяСтрока.Номенклатура);
				Запрос.УстановитьПараметр("ХарактеристикаНоменклатуры", ТекущаяСтрока.ХарактеристикаНоменклатуры);
				Запрос.УстановитьПараметр("ЕдиницаИзмерения", ТекущаяСтрока.ЕдиницаИзмерения);
				
				Выборка = Запрос.Выполнить().Выбрать();
				Если Выборка.Следующий() Тогда				
					ТекущаяСтрока[ИмяКолонки] = Выборка.Цена;
				КонецЕсли;
				
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

