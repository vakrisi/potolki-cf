&НаКлиенте
Перем СтараяНоменклатура; // Используется в механизмах обработчиков событий табличной части Товары
&НаКлиенте
Перем СтараяХарактеристика; // Используется в механизмах обработчиков событий табличной части Товары

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
		
	Если Параметры.Ключ.Пустая() Тогда

	Иначе
		ЭтаФорма.ТолькоПросмотр = ПраваПользователей.ДокументТолькоПросмотр(Объект.Ссылка);
	КонецЕсли;
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	//определим существующий вид цен и отметим тем, что используются в документе
	ЕстьИспользуемыеЦены = УстановкаЦенСервер.ЗаполнитьИспользуемыеВидыЦен(ЭтаФорма, Объект.ВидыЦен);
	
	Для Каждого ТекущаяСтрока Из Объект.ВидыЦен Цикл
		НоваяСтрока = ВремВидЦен.Добавить();
		НоваяСтрока.ВидЦены = ТекущаяСтрока.ВидЦены;
	КонецЦикла;
	
	ПраваПользователей.УстановитьТолькоПросмотрДляРеквизитаНомер(Элементы.Номер.ТолькоПросмотр);
	
	/////
	ПостроитьДеревоЦен(ЭтаФорма);	
	УстановитьУсловноеОформление();
	ЗагрузитьТабличнуюЧастьТовары();
	
	// Видимость колонки Артикул
	ОбщийМодульСервер.УстановитьВидимостьКолонкиАртикулВТабличнойЧасти(ЭтаФорма, "ДеревоЦенНоменклатураАртикул");
	
	ФинансыСервер.ОбновитьВидимостьИКурсВалюты(ЭтотОбъект);
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	ДатыЗапретаИзменения.ОбъектПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	//#13646
	РазвернутьДеревоВидовЦен();
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	ТекущийОбъект.ВидыЦен.Очистить();
	Для Каждого ТекущаяСтрока Из ВидыЦен Цикл
		Если ТекущаяСтрока.Устанавливать Тогда
			НоваяСтрока = ТекущийОбъект.ВидыЦен.Добавить();
			НоваяСтрока.ВидЦены = ТекущаяСтрока.ВидЦены;
		КонецЕсли;
	КонецЦикла;
	
	ТекущийОбъект.Товары.Очистить();
	ПоместитьЦеныВТабличнуюЧасть(ТекущийОбъект.Товары);
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	Если ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
		НомерСтроки = 0;
		Для каждого СтрокаДереваЦен из ДеревоЦен.ПолучитьЭлементы() Цикл
			НомерСтроки = НомерСтроки + 1;
			Если НЕ ЗначениеЗаполнено(СтрокаДереваЦен.Номенклатура) Тогда
				ТекстОшибки = НСтр("ru='Не заполнена колонка ""Номенклатура"" в строке ""%НомерСтроки%"" списка ""Таблица цен""'");
				ТекстОшибки = СтрЗаменить(ТекстОшибки, "%НомерСтроки%", НомерСтроки);
			
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
						ТекстОшибки,
						Объект.Ссылка,
						ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("ДеревоЦен", НомерСтроки, "Номенклатура"),
						,
						Отказ);
			КонецЕсли;
					
			ЭлементыХарактеристики = СтрокаДереваЦен.ПолучитьЭлементы();
			Для Каждого ТекЭлементХарактеристика Из ЭлементыХарактеристики Цикл
				НомерСтроки = НомерСтроки + 1;
				Если НЕ ЗначениеЗаполнено(ТекЭлементХарактеристика.ХарактеристикаНоменклатуры) Тогда
					ТекстОшибки = НСтр("ru='Не заполнена колонка ""Характеристика"" в строке ""%НомерСтроки%"" списка ""Таблица цен""'");
					ТекстОшибки = СтрЗаменить(ТекстОшибки, "%НомерСтроки%", НомерСтроки);
			
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
						ТекстОшибки,
						Объект.Ссылка,
						ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("ДеревоЦен", НомерСтроки, "Характеристика"),
						,
						Отказ);
				КонецЕсли;
				
			КонецЦикла;		
		КонецЦикла;
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	
	Если ИсточникВыбора.ИмяФормы = "ОбщаяФорма.ФормаПодбораНоменклатуры" Тогда	
		ОбработкаПодбораНоменклатурыНаКлиенте(ВыбранноеЗначение);
		
	ИначеЕсли ИсточникВыбора.ИмяФормы = "Обработка.ЗагрузкаНоменклатурыИзExcel.Форма.ЗагрузкаВТабличнуюЧасть" Тогда		
		ПолучитьЗагруженныеТоварыИзХранилища(ВыбранноеЗначение.АдресТоваровВХранилище);
		
	КонецЕсли;
	
КонецПроцедуры

