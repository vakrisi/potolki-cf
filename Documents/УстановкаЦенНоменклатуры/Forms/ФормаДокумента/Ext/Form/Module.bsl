&НаКлиенте
Процедура ПерейтиКЦенам(Команда)
	
	//СортироватьПоВидамЦен();
	ЦеныВыбраны = Ложь;
	Для Каждого ВидЦены Из ВидыЦен Цикл
		Если ВидЦены.Устанавливать Тогда
			ЦеныВыбраны = Истина;
		КонецЕсли;
	КонецЦикла;
	
	Если НЕ ЦеныВыбраны Тогда
		
		Сообщить("Для перехода к установке цен, необходимо выбрать один или несколько видов цен");
		
	Иначе
		
		ОчиститьСообщения();
	
		Если ЦеныИзменены Тогда
			ПереформироватьТаблицуЦен();			
			ЦеныИзменены = Ложь;
		КонецЕсли;	
		
		Элементы.ГруппаВидыЦен.Видимость = Ложь;
		Элементы.ГруппаЦены.Видимость = Истина;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПереместитьВидЦены(Команда)
	
	Направление = ?(Команда.Имя = "ПереместитьВидЦеныВверх", -1, 1);
		
	РезультатПроверки = УстановкаЦенКлиент.ПроверитьДоступностьСдвигаВидаЦены(ДеревоВидовЦен, Элементы.ДеревоВидовЦен, ВидыЦен, Направление);
	ЦеныИзменены = Истина;
	
	ПодключитьОбработчикОжидания("ДеревоВидовЦенПриАктивизацииСтрокиОбработчикОжидания", 0.1, Истина);
	
КонецПроцедуры

