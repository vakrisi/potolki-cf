&НаКлиенте
Процедура ЗаполнитьТекущимиЦенами(Команда)
	
	Если ДеревоЦен.ПолучитьЭлементы().Количество() = 0 Тогда 
		Сообщить("Таблица цен пуста, установка цен не выполнена");
		Возврат;
	КонецЕсли;
	
	ОписаниеОповещенияВопрос = Новый ОписаниеОповещения("ЗаполнитьТекущимиЦенамиЗавершение",ЭтаФорма);
	ПоказатьВопрос(ОписаниеОповещенияВопрос,"Очистить цены и заполнить текущими значениями?",РежимДиалогаВопрос.ДаНет);	
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьТекущимиЦенамиЗавершение(Результат, Параметры) Экспорт
	
    Если НЕ Результат = КодВозвратаДиалога.Да Тогда
        Возврат;
    КонецЕсли;

    ЗаполнитьТекущимиЦенамиНаСервере();

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТекущимиЦенамиНаСервере()
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЦенаНоменклатуры.Цена
	               |ИЗ
	               |	РегистрСведений.ЦеныНоменклатуры.СрезПоследних(
	               |			&Дата,
	               |			Номенклатура = &Номенклатура
	               |				И ХарактеристикаНоменклатуры = &ХарактеристикаНоменклатуры) КАК ЦенаНоменклатуры
	               |ГДЕ
	               |	ЦенаНоменклатуры.Валюта = &Валюта
	               |	И ЦенаНоменклатуры.ВидЦены = &ВидЦены
	               |	И ЦенаНоменклатуры.ЕдиницаИзмерения = &ЕдиницаИзмерения";
				   
	Дерево = ДеревоЦен.ПолучитьЭлементы();
	Для Каждого СтрокаДерева из Дерево Цикл
		
		Для Каждого ВидЦены Из ВидыЦен Цикл
			Если ВидЦены.Устанавливать Тогда
				
				ИмяКолонки = УстановкаЦенСервер.ИмяКолонкиПоВидуЦены(ВидЦены.ВидЦены);
				ЕстьКолонкаЦены = СтрокаДерева.Свойство(ИмяКолонки);
				Если ЕстьКолонкаЦены Тогда
					УстановитьПараметрыЗапроса(Запрос, СтрокаДерева, ВидЦены.ВидЦены);
					РезультатЗапроса = Запрос.Выполнить();
					Если не РезультатЗапроса.Пустой() Тогда 
						Выгрузка = РезультатЗапроса.Выбрать();
						Пока Выгрузка.Следующий() Цикл
							СтрокаДерева[ИмяКолонки] = Выгрузка.Цена;
						КонецЦикла;
					КонецЕсли;					
				КонецЕсли; 				
				
			КонецЕсли; 	
		КонецЦикла;	
		
		ЭлементыСтроки = СтрокаДерева.ПолучитьЭлементы();
		Для Каждого Стр из ЭлементыСтроки Цикл
			Для Каждого ВидЦены Из ВидыЦен Цикл
				Если ВидЦены.Устанавливать Тогда
					
					ИмяКолонки = УстановкаЦенСервер.ИмяКолонкиПоВидуЦены(ВидЦены.ВидЦены);
					ЕстьКолонкаЦены = Стр.Свойство(ИмяКолонки);
					Если ЕстьКолонкаЦены Тогда
						УстановитьПараметрыЗапроса(Запрос, Стр, ВидЦены.ВидЦены);
						РезультатЗапроса = Запрос.Выполнить();
						Если не РезультатЗапроса.Пустой() Тогда 
							Выгрузка = РезультатЗапроса.Выбрать();
							Пока Выгрузка.Следующий() Цикл
								Стр[ИмяКолонки] = Выгрузка.Цена;
							КонецЦикла;
						КонецЕсли;					
					КонецЕсли; 				
					
				КонецЕсли; 	
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура УстановитьПараметрыЗапроса(Запрос, Стр, ВидЦены) 
	Запрос.УстановитьПараметр("Дата", ТекущаяДатаСеанса());
	Запрос.УстановитьПараметр("Номенклатура", Стр.Номенклатура);
	Запрос.УстановитьПараметр("ХарактеристикаНоменклатуры", Стр.ХарактеристикаНоменклатуры);
	Запрос.УстановитьПараметр("ВидЦены", ВидЦены);
	Запрос.УстановитьПараметр("ЕдиницаИзмерения", Стр.ЕдиницаИзмерения);
	Запрос.УстановитьПараметр("Валюта", Объект.Валюта);
КонецПроцедуры	

&НаКлиенте
Функция ЗаполнитьСпискиВидовЦен(сз_ВидыЦен, сз_ВсеВидыЦен, сз_РазрешенныеВидыЦен)
	
	Для каждого Строка Из ВидыЦен Цикл
		сз_ВсеВидыЦен.Добавить(Строка.ВидЦены);
		Если Строка.Устанавливать тогда
			сз_видыЦен.Добавить(Строка.ВидЦены);
		КонецЕсли;
		
		Если НЕ Строка.Запрещенный И Строка.Устанавливать Тогда
			сз_РазрешенныеВидыЦен.Добавить(Строка.ВидЦены);
		КонецЕсли;
	КонецЦикла;
	
	Возврат сз_ВидыЦен;
	
КонецФункции
	
&НаКлиенте
Процедура РассчитатьЦены(Команда)
	
	Если ДеревоЦен.ПолучитьЭлементы().Количество()=0 Тогда 
		Сообщить("Таблица цен пуста, расчет цен не будет выполнен");
		Возврат;
	КонецЕсли;
	
	сз_ВидыЦен = Новый СписокЗначений;
	сз_ВсеВидыЦен = Новый СписокЗначений;
	сз_РазрешенныеВидыЦен = Новый СписокЗначений;	
	ЗаполнитьСпискиВидовЦен(сз_ВидыЦен, сз_ВсеВидыЦен, сз_РазрешенныеВидыЦен);
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ВсеВидыЦен",			сз_ВсеВидыЦен);
	ПараметрыФормы.Вставить("ИспользуемыеВидыЦен",	сз_ВидыЦен);
	ПараметрыФормы.Вставить("РазрешенныеВидыЦен",	сз_РазрешенныеВидыЦен);
	 
	ОписаниеОповещения = Новый ОписаниеОповещения("РассчитатьЦеныФрагмент", ЭтотОбъект);
	ОткрытьФорму("Документ.УстановкаЦенНоменклатуры.Форма.ФормаРасчетаЦен", ПараметрыФормы, ЭтаФорма, , , , ОписаниеОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьЦеныФрагмент(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ Результат.КонечныйВидЦен = Неопределено
		И НЕ Результат.ПроцентНаценки = Неопределено Тогда
		ОписаниеОповещения = Новый ОписаниеОповещения("РассчитатьЦеныЗавершение", ЭтотОбъект, Результат);
		//#13646
		//ТекстВопроса = "Вид цены """ + Строка(Результат.КонечныйВидЦен) + """ будет перерассчитан. Продолжить?"; 
		ТекстВопроса = "Виды цен """ + СтрСоединить(Результат.КонечныйВидЦен, ", ") + """ будут перерассчитаны. Продолжить?";
		ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьЦеныЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		Модифицированность = Истина;
		РассчитатьЦеныНаСервере(ДополнительныеПараметры);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура РассчитатьЦеныНаСервере(ПараметрыРасчета)
	
	ВидИсходныхДанных = ПараметрыРасчета.ВидИсходныхДанных;
	Склад = ПараметрыРасчета.СкладОстатков;
	ИсходныйВидЦен = ПараметрыРасчета.ИсходныйВидЦен; 
	ИсходныйВидЦенДокумента = ПараметрыРасчета.ИсходныйВидЦенДокумента;
	//#13646
	//КонечныйВидЦен = ПараметрыРасчета.КонечныйВидЦен; 
	МассивКонечныхВидовЦен = ПараметрыРасчета.КонечныйВидЦен;
	ПроцентНаценки = ПараметрыРасчета.ПроцентНаценки;	
		
	Объект.Товары.Очистить();
	ПоместитьЦеныВТабличнуюЧасть();
	
	Для каждого КонечныйВидЦен из МассивКонечныхВидовЦен Цикл
		Если ВидИсходныхДанных = 3 Тогда
			//наценка на указанный вид цен документа		
			
			ОтборКонечные = Новый Структура;
			ОтборКонечные.Вставить("ВидЦены", КонечныйВидЦен);		
			ТоварыКонечные = Объект.Товары.НайтиСтроки(ОтборКонечные);
			
			Для Каждого ТекНоменклатура Из ТоварыКонечные Цикл
				
				ОтборИсходные = Новый Структура;
				ОтборИсходные.Вставить("ВидЦены", ИсходныйВидЦенДокумента);
				ОтборИсходные.Вставить("Номенклатура", ТекНоменклатура.Номенклатура);
				ОтборИсходные.Вставить("ХарактеристикаНоменклатуры", ТекНоменклатура.ХарактеристикаНоменклатуры);
				ОтборИсходные.Вставить("ЕдиницаИзмерения", ТекНоменклатура.ЕдиницаИзмерения);
				ТоварыИсходные = Объект.Товары.НайтиСтроки(ОтборИсходные);
				
				Если ТоварыИсходные.Количество() > 0 Тогда
					ТекНоменклатура.Цена = ТоварыИсходные[0].Цена * (1 + ПроцентНаценки/100);
				КонецЕсли;
			КонецЦикла;
			
		ИначеЕсли ВидИсходныхДанных = 4 Тогда
			//наценка на указанный вид цен		
			
			ОтборКонечные = Новый Структура;
			ОтборКонечные.Вставить("ВидЦены", КонечныйВидЦен);		
			ТоварыКонечные = Объект.Товары.НайтиСтроки(ОтборКонечные);
			
			Запрос = Новый Запрос;
			Запрос.УстановитьПараметр("ДатаЗапроса",?(Объект.Дата = Дата(1,1,1),ТекущаяДатаСеанса(),Объект.Дата));
			Запрос.УстановитьПараметр("ВидЦены", ИсходныйВидЦен);
			Запрос.УстановитьПараметр("Валюта", Объект.Валюта);
			Запрос.УстановитьПараметр("МассивНоменклатуры", Объект.Товары.Выгрузить().ВыгрузитьКолонку("Номенклатура"));
			Запрос.Текст =
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ЦеныСрезПоследних.Валюта КАК Валюта,
			|	ЦеныСрезПоследних.ВидЦены КАК ВидЦены,
			|	ЦеныСрезПоследних.Номенклатура КАК Номенклатура,
			|	ЦеныСрезПоследних.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
			|	ЦеныСрезПоследних.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
			|	ЦеныСрезПоследних.Цена КАК Цена
			|ИЗ
			|	РегистрСведений.ЦеныНоменклатуры.СрезПоследних(
			|			&ДатаЗапроса,
			|			ВидЦены = &ВидЦены
			|				И Валюта = &Валюта
			|				И Номенклатура В (&МассивНоменклатуры)) КАК ЦеныСрезПоследних";
			ТаблицаИсходныхЦен = Запрос.Выполнить().Выгрузить();
			
			Для Каждого ТекНоменклатура Из ТоварыКонечные Цикл
				
				ОтборИсходные = Новый Структура;
				ОтборИсходные.Вставить("Номенклатура", ТекНоменклатура.Номенклатура);
				ОтборИсходные.Вставить("ХарактеристикаНоменклатуры", ТекНоменклатура.ХарактеристикаНоменклатуры);
				ОтборИсходные.Вставить("ЕдиницаИзмерения", ТекНоменклатура.ЕдиницаИзмерения);
				ТоварыИсходные = ТаблицаИсходныхЦен.НайтиСтроки(ОтборИсходные);
				
				Если ТоварыИсходные.Количество() > 0 Тогда
					ТекНоменклатура.Цена = ТоварыИсходные[0].Цена * (1 + ПроцентНаценки/100);
				КонецЕсли;
			КонецЦикла;
			
		ИначеЕсли ВидИсходныхДанных = 2 Тогда
			//наценка на цену последней покупки + доставка
			
			ОтборКонечные = Новый Структура;
			ОтборКонечные.Вставить("ВидЦены", КонечныйВидЦен);		
			ТоварыКонечные = Объект.Товары.НайтиСтроки(ОтборКонечные);
			
			Для Каждого ТекНоменклатура Из ТоварыКонечные Цикл
				
				Запрос = Новый Запрос;
				Запрос.Текст = 
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	ВЫРАЗИТЬ(ВЫБОР
				|			КОГДА НЕ ЗакупкиОбороты.КоличествоОборот = 0
				|				ТОГДА ЗакупкиОбороты.СуммаОборот / ЗакупкиОбороты.КоличествоОборот
				|			ИНАЧЕ 0
				|		КОНЕЦ КАК ЧИСЛО(15, 2)) КАК Цена
				|ИЗ
				|	РегистрНакопления.Закупки.Обороты(
				|			,
				|			&ДатаЗапроса,
				|			Регистратор,
				|			(Организация = &Организация ИЛИ &Организация = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка))
				|				И Номенклатура = &Номенклатура
				|				И ХарактеристикаНоменклатуры = &ХарактеристикаНоменклатуры) КАК ЗакупкиОбороты
				|ГДЕ
				|	ЗакупкиОбороты.Регистратор ССЫЛКА Документ.ПоступлениеТоваровИУслуг
				|
				|УПОРЯДОЧИТЬ ПО
				|	ЗакупкиОбороты.Период Убыв";
				Запрос.УстановитьПараметр("ДатаЗапроса", КонецДня(?(Объект.Дата = Дата(1,1,1), ТекущаяДатаСеанса(), Объект.Дата)));
				Запрос.УстановитьПараметр("Номенклатура", ТекНоменклатура.Номенклатура);
				Запрос.УстановитьПараметр("ХарактеристикаНоменклатуры", ТекНоменклатура.ХарактеристикаНоменклатуры);			
				Запрос.УстановитьПараметр("Организация", ПараметрыРасчета.Организация);
				
				Выборка = Запрос.Выполнить().Выбрать();
				Пока Выборка.Следующий() Цикл				
					
					Если ТипЗнч(ТекНоменклатура.ЕдиницаИзмерения) = Тип("СправочникСсылка.КлассификаторЕдиницИзмерения") Тогда
						ТекНоменклатура.Цена = Выборка.Цена * (1 + ПроцентНаценки/100);
					ИначеЕсли ТипЗнч(ТекНоменклатура.ЕдиницаИзмерения) = Тип("СправочникСсылка.ЕдиницыИзмерений") Тогда
						ТекНоменклатура.Цена = Выборка.Цена * (1 + ПроцентНаценки/100) * ТекНоменклатура.ЕдиницаИзмерения.Коэффициент;
					КонецЕсли;				
					
					Прервать;
					
				КонецЦикла;
			КонецЦикла;
			
		ИначеЕсли ВидИсходныхДанных = 1 Тогда
			//наценка на цену последней покупки без доставки (т.е. цена в поступлении)
			
			ОтборКонечные = Новый Структура;
			ОтборКонечные.Вставить("ВидЦены", КонечныйВидЦен);		
			ТоварыКонечные = Объект.Товары.НайтиСтроки(ОтборКонечные);
			
			Для Каждого ТекНоменклатура Из ТоварыКонечные Цикл
				
				Запрос = Новый Запрос;
				Запрос.Текст = 
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	ПоступлениеТоваровИУслугТовары.Цена
				|ИЗ
				|	Документ.ПоступлениеТоваровИУслуг.Товары КАК ПоступлениеТоваровИУслугТовары
				|ГДЕ
				|	ПоступлениеТоваровИУслугТовары.Номенклатура = &Номенклатура
				|	И ПоступлениеТоваровИУслугТовары.ХарактеристикаНоменклатуры = &ХарактеристикаНоменклатуры
				|	И ПоступлениеТоваровИУслугТовары.Ссылка.Проведен
				|	И ПоступлениеТоваровИУслугТовары.Ссылка.Дата <= &ДатаЗапроса
				|	И (ПоступлениеТоваровИУслугТовары.Ссылка.Организация = &Организация ИЛИ &Организация = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка))
				|
				|УПОРЯДОЧИТЬ ПО
				|	ПоступлениеТоваровИУслугТовары.Ссылка.Дата Убыв";
				Запрос.УстановитьПараметр("ДатаЗапроса", КонецДня(?(Объект.Дата = Дата(1,1,1), ТекущаяДатаСеанса(), Объект.Дата)));
				Запрос.УстановитьПараметр("Номенклатура", ТекНоменклатура.Номенклатура);
				Запрос.УстановитьПараметр("ХарактеристикаНоменклатуры", ТекНоменклатура.ХарактеристикаНоменклатуры);			
				Запрос.УстановитьПараметр("Организация", ПараметрыРасчета.Организация);
				
				Выборка = Запрос.Выполнить().Выбрать();
				Пока Выборка.Следующий() Цикл				
					
					Если ТипЗнч(ТекНоменклатура.ЕдиницаИзмерения) = Тип("СправочникСсылка.КлассификаторЕдиницИзмерения") Тогда
						ТекНоменклатура.Цена = Выборка.Цена * (1 + ПроцентНаценки/100);
					ИначеЕсли ТипЗнч(ТекНоменклатура.ЕдиницаИзмерения) = Тип("СправочникСсылка.ЕдиницыИзмерений") Тогда
						ТекНоменклатура.Цена = Выборка.Цена * (1 + ПроцентНаценки/100) * ТекНоменклатура.ЕдиницаИзмерения.Коэффициент;
					КонецЕсли;				
					
					Прервать;
					
				КонецЦикла;
			КонецЦикла;			
			
		ИначеЕсли ВидИсходныхДанных = 0 Тогда
			//наценка на себестоимость
			
			ОтборКонечные = Новый Структура;
			ОтборКонечные.Вставить("ВидЦены", КонечныйВидЦен);		
			ТоварыКонечные = Объект.Товары.НайтиСтроки(ОтборКонечные);
			
			Для Каждого ТекНоменклатура Из ТоварыКонечные Цикл
				
				Запрос = Новый Запрос;
				Запрос.Текст = 
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	ВЫРАЗИТЬ(ВЫБОР
				|			КОГДА НЕ ТоварыНаСкладахОстатки.КоличествоОстаток = 0
				|				ТОГДА ТоварыНаСкладахОстатки.СуммаОстаток / ТоварыНаСкладахОстатки.КоличествоОстаток
				|			ИНАЧЕ 0
				|		КОНЕЦ КАК ЧИСЛО(15, 2)) КАК Цена
				|ИЗ
				|	РегистрНакопления.ТоварыНаСкладах.Остатки(
				|			&ДатаЗапроса,
				|			(Организация = &Организация ИЛИ &Организация = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка))
				|				И Номенклатура = &Номенклатура
				|				И ХарактеристикаНоменклатуры = &ХарактеристикаНоменклатуры
				|				И ВЫБОР
				|					КОГДА НЕ &Склад = ЗНАЧЕНИЕ(Справочник.Склады.ПустаяСсылка)
				|						ТОГДА Склад = &Склад
				|					ИНАЧЕ 1 = 1
				|				КОНЕЦ) КАК ТоварыНаСкладахОстатки";
				Запрос.УстановитьПараметр("ДатаЗапроса",?(Объект.Дата = Дата(1,1,1),ТекущаяДатаСеанса(),Объект.Дата));
				Запрос.УстановитьПараметр("Номенклатура", ТекНоменклатура.Номенклатура);
				Запрос.УстановитьПараметр("ХарактеристикаНоменклатуры", ТекНоменклатура.ХарактеристикаНоменклатуры);			
				Запрос.УстановитьПараметр("Склад",Склад);
				Запрос.УстановитьПараметр("Организация", ПараметрыРасчета.Организация);
				
				Выборка = Запрос.Выполнить().Выбрать();
				Пока Выборка.Следующий() Цикл				
					
					Если ТипЗнч(ТекНоменклатура.ЕдиницаИзмерения) = Тип("СправочникСсылка.КлассификаторЕдиницИзмерения") Тогда
						ТекНоменклатура.Цена = Выборка.Цена * (1 + ПроцентНаценки/100);
					ИначеЕсли ТипЗнч(ТекНоменклатура.ЕдиницаИзмерения) = Тип("СправочникСсылка.ЕдиницыИзмерений") Тогда
						ТекНоменклатура.Цена = Выборка.Цена * (1 + ПроцентНаценки/100) * ТекНоменклатура.ЕдиницаИзмерения.Коэффициент;
					КонецЕсли;				
					
					Прервать;
					
				КонецЦикла;
			КонецЦикла;
			
		КонецЕсли;
	КонецЦикла;
	
	ДеревоЦен.ПолучитьЭлементы().Очистить();
	ЗагрузитьТабличнуюЧастьТовары(); 
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьФормуВыбораВидовЦен(ОписаниеОповещения)
	
	Если ДеревоЦен.ПолучитьЭлементы().Количество() = 0 Тогда 
		Сообщить("Таблица цен пуста, расчет цен не будет выполнен");
		Возврат;
	КонецЕсли;
	
	сз_ВидыЦен = Новый СписокЗначений;
	сз_ВсеВидыЦен = Новый СписокЗначений;
	сз_РазрешенныеВидыЦен = Новый СписокЗначений;	
	ЗаполнитьСпискиВидовЦен(сз_ВидыЦен, сз_ВсеВидыЦен, сз_РазрешенныеВидыЦен);
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ИспользуемыеВидыЦен",	сз_ВидыЦен);
	ПараметрыФормы.Вставить("ВыбранныеВидыЦен",		Новый Массив);
	
	ОткрытьФорму("Справочник.ВидыЦен.Форма.ФормаПодбора", ПараметрыФормы, ЭтаФорма, , , , ОписаниеОповещения);
	
КонецПроцедуры


&НаКлиенте
Процедура УстановитьОбщуюЦену(Команда)

	ОписаниеОповещения = Новый ОписаниеОповещения("УстановитьОбщуюЦенуЗавершение", ЭтотОбъект);
	ПоказатьФормуВыбораВидовЦен(ОписаниеОповещения);

КонецПроцедуры

&НаКлиенте
Процедура УстановитьОбщуюЦенуЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("МассивВидовЦен", Результат);
	
	ОписаниеОповещенияВыборЦены = Новый ОписаниеОповещения("УстановитьОбщуюЦенуНаНоменклатуруПослеВыбораЦены", ЭтотОбъект, ДополнительныеПараметры);
	ПоказатьВводЧисла(ОписаниеОповещенияВыборЦены, 0, "Установить общую цену", 15, 2);
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьОбщуюЦенуНаНоменклатуруПослеВыбораЦены(ВыбранноеЗначение, ДополнительныеПараметры) Экспорт
	
	Если ВыбранноеЗначение = Неопределено Тогда
		Возврат;	
	КонецЕсли;
	
	Дерево = ДеревоЦен.ПолучитьЭлементы();
	Для Каждого СтрокаДерева из Дерево Цикл
		
		ЭлементыСтроки = СтрокаДерева.ПолучитьЭлементы();
		Для Каждого ВидЦены Из ДополнительныеПараметры.МассивВидовЦен Цикл
		//Для Каждого СтрокаВидЦены Из ВидыЦен Цикл
		//	Если СтрокаВидЦены.Устанавливать Тогда					
				//ИмяКолонки = УстановкаЦенВызовСервера.ИмяКолонкиПоВидуЦены(СтрокаВидЦены.ВидЦены);
				ИмяКолонки = УстановкаЦенВызовСервера.ИмяКолонкиПоВидуЦены(ВидЦены);
				ЕстьКолонкаЦены = СтрокаДерева.Свойство(ИмяКолонки);
				Если ЕстьКолонкаЦены Тогда
					СтрокаДерева[ИмяКолонки] = ВыбранноеЗначение;
				КонецЕсли;
		//	КонецЕсли;
		КонецЦикла;	
				
		//с характеристиками
		Для Каждого Стр из ЭлементыСтроки Цикл
			Для Каждого ВидЦены Из ДополнительныеПараметры.МассивВидовЦен Цикл
			//Для Каждого СтрокаВидЦены Из ВидыЦен Цикл
			//	Если СтрокаВидЦены.Устанавливать Тогда					
					ИмяКолонки = УстановкаЦенВызовСервера.ИмяКолонкиПоВидуЦены(ВидЦены); 
					ЕстьКолонкаЦены = Стр.Свойство(ИмяКолонки);
					Если ЕстьКолонкаЦены Тогда
						Стр[ИмяКолонки] = ВыбранноеЗначение;
					КонецЕсли;
			//	КонецЕсли;
			КонецЦикла;
		КонецЦикла;
		
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьЦенамиПоставщика(Команда)
	
	СписокВидаЦен = Новый СписокЗначений;
	Для Каждого ТекущаяСтрока Из ВидыЦен Цикл
		Если ТекущаяСтрока.Устанавливать Тогда
			СписокВидаЦен.Добавить(ТекущаяСтрока.ВидЦены);
		КонецЕсли;
	КонецЦикла;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ВидыЦен", СписокВидаЦен);
	
