&НаСервере
Процедура СортироватьПоВидамЦен()
	
	//выгрузим во временную ТЗ виды цен в том порядке, которые заданы
	ВремТЗ_ВидыЦен = ВидыЦен.Выгрузить(,"ВидЦены");
	ВремТЗ_ВидыЦен.Колонки.Добавить("НомерСтроки",,"НомерСтроки");
	Сч = 0;
	Для Каждого ТекВидЦены Из ВремТЗ_ВидыЦен Цикл
		ТекВидЦены.НомерСтроки = Сч;
		Сч = Сч + 1;
	КонецЦикла;	
	
	Дерево = ДанныеФормыВЗначение(ЦеныДерево, Тип("ДеревоЗначений"));
		
	//Проставим индексы по видам цен
	Для Каждого Стр из Дерево.Строки Цикл
		Если Стр.Строки.Количество() > 0 Тогда
			Для Каждого Ст из Стр.Строки Цикл
				СтруктураПоиска = новый Структура;
				СтруктураПоиска.Вставить("ВидЦены", Ст.ВидЦены);
				Индекс = ВремТЗ_ВидыЦен.НайтиСтроки(СтруктураПоиска);
				Если Индекс.Количество() = 0 Тогда
					Индекс = 0;
				Иначе
					Индекс = Индекс[0].НомерСтроки;
				КонецЕсли;  				
				
				Ст.ВидЦеныИндекс = Индекс;
			КонецЦикла;	
		КонецЕсли;
	КонецЦикла;
	
	//отсортируем по проставленному индексу
	Для Каждого Стр из Дерево.Строки Цикл
		Если Стр.Строки.Количество() > 0 Тогда			
			Стр.Строки.Сортировать("ВидЦеныИндекс");
		КонецЕсли;
	КонецЦикла;	
	ЗначениеВДанныеФормы(Дерево, ЦеныДерево); 	
		
КонецПроцедуры	

&НаКлиенте
Процедура ДобавитьНоменклатуру(Команда)
	Номенклатура = ОткрытьФормуМодально("Справочник.Номенклатура.ФормаВыбора");
	Если ЗначениеЗаполнено(Номенклатура) Тогда
		ДобавитьНоменклатуруСервер(Номенклатура);
	КонецЕсли;	
КонецПроцедуры

&НаСервере
Процедура ДобавитьНоменклатуруСервер(Номенклатура, СтруктураЦен = Неопределено)
	Дерево = ДанныеФормыВЗначение(ДеревоЦен, Тип("ДеревоЗначений"));
	
	ЗапросХарактеристики = Новый Запрос;
	ЗапросХарактеристики.Текст = 
	"ВЫБРАТЬ
	|	ХарактеристикиНоменклатуры.Ссылка
	|ИЗ
	|	Справочник.ХарактеристикиНоменклатуры КАК ХарактеристикиНоменклатуры
	|ГДЕ
	|	ХарактеристикиНоменклатуры.Владелец = &Владелец";
	ЗапросХарактеристики.УстановитьПараметр("Владелец", Номенклатура);
	РезультатЗапросаХарактеристики = ЗапросХарактеристики.Выполнить();
	
	//по всем единицам измерений по данной номенклатуре
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЕдиницыИзмерений.Ссылка
	|ИЗ
	|	Справочник.ЕдиницыИзмерений КАК ЕдиницыИзмерений
	|ГДЕ
	|	ЕдиницыИзмерений.Владелец = &Владелец
	|	И ЕдиницыИзмерений.ПометкаУдаления = ЛОЖЬ";
	Запрос.УстановитьПараметр("Владелец", Номенклатура);
	Выборка = Запрос.Выполнить().Выбрать();
	МассивЕдИзмерений = новый Массив;
	МассивЕдИзмерений.Добавить(ПолучитьБазовуюЕдиницуИзмеренияНоменклатуры(Номенклатура));
	Пока Выборка.Следующий() Цикл
		МассивЕдИзмерений.Добавить(Выборка.Ссылка);
	КонецЦикла;
	
	Для Каждого ЕдИзм Из МассивЕдИзмерений Цикл
		
		Если Дерево.Строки.НайтиСтроки(Новый Структура("Номенклатура, ЕдиницаИзмерения",Номенклатура, ЕдИзм)).Количество()=0 Тогда		
			
			//Стр = Дерево.Строки.Добавить();
			Стр = ДеревоЦен.ПолучитьЭлементы().Добавить();
			Стр.Номенклатура = Номенклатура;
			Стр.ЕдиницаИзмерения = ЕдИзм;
			Элементы.ДеревоЦен.ТекущаяСтрока = Стр.ПолучитьИдентификатор();
			
			ВыборкаХарактеристики = РезультатЗапросаХарактеристики.Выбрать();
			ОбработкаТабличныхЧастейКлиентСервер.ЗаполнитьИндексКартинкиСтрокиДереваЦен(Стр);
			Если ВыборкаХарактеристики.Количество() > 0 Тогда								
				Стр.ХарактеристикиИспользуются = Истина;	
				Пока ВыборкаХарактеристики.Следующий() Цикл
					//СтрДеревоВид = Стр.Строки.Добавить();
					СтрДеревоВид = Стр.ПолучитьЭлементы().Добавить();
					СтрДеревоВид.Номенклатура = Стр.Номенклатура;
					СтрДеревоВид.ХарактеристикаНоменклатуры = ВыборкаХарактеристики.Ссылка;
					СтрДеревоВид.ЕдиницаИзмерения = Стр.ЕдиницаИзмерения;
					СтрДеревоВид.ХарактеристикиИспользуются = Истина;
					ОбработкаТабличныхЧастейКлиентСервер.ЗаполнитьИндексКартинкиСтрокиДереваЦен(СтрДеревоВид);
					Элементы.ДеревоЦен.ТекущаяСтрока = СтрДеревоВид.ПолучитьИдентификатор();
				КонецЦикла;
			Иначе 				
				Если НЕ СтруктураЦен = Неопределено Тогда
					ЗаполнитьЗначенияСвойств(Стр, СтруктураЦен);
				КонецЕсли; 
			КонецЕсли;						
		
		КонецЕсли;
		
	КонецЦикла;

	//ЗначениеВДанныеФормы(Дерево, ДеревоЦен); 	
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьВидЦен(Команда)
	Если Элементы.ЦеныНаФорме.ТекущиеДанные <> Неопределено И не Элементы.ЦеныНаФорме.ТекущиеДанные.Номенклатура.Пустая() Тогда
		ВидЦен = ОткрытьФормуМодально("Справочник.ВидыЦен.ФормаВыбора");
		Если ЗначениеЗаполнено(ВидЦен) Тогда
			ДобавитьВидЦенСервер(Элементы.ЦеныНаФорме.ТекущиеДанные.Номенклатура,ВидЦен);
		КонецЕсли	
	КонецЕсли;	
КонецПроцедуры

&НаСервере
Процедура ДобавитьВидЦенСервер(Номенклатура,ВидЦен)
	
	ЗапросХарактеристики = Новый Запрос;
	ЗапросХарактеристики.Текст = 
	"ВЫБРАТЬ
	|	ХарактеристикиНоменклатуры.Ссылка
	|ИЗ
	|	Справочник.ХарактеристикиНоменклатуры КАК ХарактеристикиНоменклатуры
	|ГДЕ
	|	ХарактеристикиНоменклатуры.Владелец = &Владелец";
	ЗапросХарактеристики.УстановитьПараметр("Владелец", Номенклатура);
	ТаблицаХарактеристики = ЗапросХарактеристики.Выполнить().Выгрузить();
	
	Дерево = ДанныеФормыВЗначение(ЦеныДерево, Тип("ДеревоЗначений"));
	Для Каждого Строка из Дерево.Строки Цикл
		Если Строка.Номенклатура = Номенклатура Тогда
			Если ТаблицаХарактеристики.Количество() = 0 Тогда
				Стр = Строка.Строки.Добавить();
				Стр.Номенклатура = Номенклатура;
				Стр.ВидЦены = ВидЦен;
				Стр.ЕдиницаИзмерения = ПолучитьБазовуюЕдиницуИзмеренияНоменклатуры(Стр.Номенклатура);
			Иначе
				Для Каждого Выборка Из ТаблицаХарактеристики Цикл
					Стр = Строка.Строки.Добавить();
					Стр.Номенклатура = Номенклатура;
					Стр.ХарактеристикаНоменклатуры = Выборка.ССылка;
					Стр.ВидЦены = ВидЦен;
					Стр.ЕдиницаИзмерения = ПолучитьБазовуюЕдиницуИзмеренияНоменклатуры(Стр.Номенклатура);
				КонецЦикла;
			КонецЕсли;
			ЗначениеВДанныеФормы(Дерево, ЦеныДерево);
			Возврат;
		КонецЕсли
	КонецЦикла;	
	
КонецПроцедуры

&НаКлиенте
Процедура ЦеныНаФормеНоменклатураПриИзменении(Элемент)
	СтрокаТабличнойЧасти = Элементы.ЦеныНаФорме.ТекущиеДанные;
	СтрокаТабличнойЧасти.ЕдиницаИзмерения = ПолучитьБазовуюЕдиницуИзмеренияНоменклатуры(СтрокаТабличнойЧасти.Номенклатура);
КонецПроцедуры

&НаКлиенте
Процедура ЦеныНаФормеЕдиницаИзмеренияНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	СтрокаТабличнойЧасти = Элементы.ЦеныНаФорме.ТекущиеДанные;
	СписокЕдиниц = ОбщийМодуль.ПолучитьСписокЕдиницИзмеренияНоменклатуры(СтрокаТабличнойЧасти.Номенклатура);
	
	ДанныеВыбора = Новый СписокЗначений;
	Для Ном = 0 По СписокЕдиниц.Количество() - 1 Цикл
		ДанныеВыбора.Добавить(СписокЕдиниц[Ном]);
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ЦеныНаФормеПриИзменении(Элемент)
	ЭтотОбъект.Модифицированность = Истина;
КонецПроцедуры

&НаКлиенте
Процедура ЦеныНаФормеЦенаПриИзменении(Элемент)
	//корневые строки редактировать нельзя
	Если Элементы.ЦеныНаФорме.ТекущиеДанные.ПолучитьРодителя() = Неопределено Тогда
		Элементы.ЦеныНаФорме.ТекущиеДанные.Цена = "";
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ЦеныНаФормеЕдиницаИзмеренияПриИзменении(Элемент)
	//корневые строки редактировать нельзя
	Если Элементы.ЦеныНаФорме.ТекущиеДанные.ПолучитьРодителя() = Неопределено Тогда
		Элементы.ЦеныНаФорме.ТекущиеДанные.ЕдиницаИзмерения = Неопределено;
	КонецЕсли;
КонецПроцедуры

#Область ВидыЦенВКолонках
//////////////Процедуры и функции новой таблицы дерева цен (Виды цен в колонках)

&НаСервере
Процедура ПостроитьДеревоЦен(Форма, ИмяТаблицы = "ДеревоЦен")
	
	ДобавляемыеКолонкиТаблицыЦен = Новый Массив();
	УдаляемыеКолонкиТаблицыЦен   = Новый Массив();
	УдаляемыеЭлементы            = Новый Массив();
	УсловныеОформления           = Новый Массив();
	
	Если ТипЗнч(Форма.ДеревоЦен) = Тип("ДанныеФормыКоллекция") Тогда
		ДеревоЗначений = Новый ТаблицаЗначений;
	Иначе
		ДеревоЗначений = Новый ДеревоЗначений;
	КонецЕсли;
	
	ДеревоЗначений.Колонки.Добавить("Номенклатура",               Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ДеревоЗначений.Колонки.Добавить("ХарактеристикаНоменклатуры", Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры"));	
	ДеревоЗначений.Колонки.Добавить("ИндексКартинки", 			  Новый ОписаниеТипов("Число"));	
	ДеревоЗначений.Колонки.Добавить("ЕдиницаИзмерения",           Новый ОписаниеТипов("СправочникСсылка.КлассификаторЕдиницИзмерения"));	
	ДеревоЗначений.Колонки.Добавить("ХарактеристикиИспользуются", Новый ОписаниеТипов("Булево"));
	
	Для Каждого ВидЦены Из Форма.ВидыЦен Цикл
		
		Если ВидЦены.Устанавливать Тогда
			
			ИмяКолонки = УстановкаЦенСервер.ИмяКолонкиПоВидуЦены(ВидЦены.ВидЦены);
			
			ДеревоЗначений.Колонки.Добавить(ИмяКолонки, Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2, ДопустимыйЗнак.Неотрицательный)), ВидЦены.ВидЦены);		
					
		КонецЕсли;
		
	КонецЦикла;
	
	КолонкаОтступ = ДеревоЗначений.Колонки.Добавить("Отступ", Новый ОписаниеТипов("Строка"), НСтр("ru = 'Отступ'"));
	
	РеквизитыТаблицыЦен = Форма.ПолучитьРеквизиты(ИмяТаблицы);
	Для Каждого Реквизит Из РеквизитыТаблицыЦен Цикл
		Если СтрНайти(Реквизит.Имя, "ВидЦены") ИЛИ СтрНайти(Реквизит.Имя, "Отступ") Тогда
			УдаляемыеКолонкиТаблицыЦен.Добавить(ИмяТаблицы + "." + Реквизит.Имя);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого Колонка Из ДеревоЗначений.Колонки Цикл
		Если СтрНайти(Колонка.Имя, "ВидЦены") Тогда
			УдаляемаяКолонка = УдаляемыеКолонкиТаблицыЦен.Найти(ИмяТаблицы + "." + Колонка.Имя);
			Если УдаляемаяКолонка <> Неопределено Тогда
				УдаляемыеКолонкиТаблицыЦен.Удалить(УдаляемаяКолонка);
			Иначе
				ДобавляемыеКолонкиТаблицыЦен.Добавить(Новый РеквизитФормы(Колонка.Имя, Колонка.ТипЗначения, ИмяТаблицы, Колонка.Заголовок, Истина));
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	ДобавляемыеКолонкиТаблицыЦен.Добавить(Новый РеквизитФормы(КолонкаОтступ.Имя, КолонкаОтступ.ТипЗначения, ИмяТаблицы, КолонкаОтступ.Заголовок, Истина));
	
	Если УдаляемыеКолонкиТаблицыЦен.Количество() > 0 Или ДобавляемыеКолонкиТаблицыЦен.Количество() > 0 Тогда
		Форма.ИзменитьРеквизиты(ДобавляемыеКолонкиТаблицыЦен, УдаляемыеКолонкиТаблицыЦен);
	КонецЕсли;
	
	Для Каждого ТекЭлемент Из Форма.Элементы[ИмяТаблицы].ПодчиненныеЭлементы Цикл
		Если СтрНайти(ТекЭлемент.Имя, "ВидЦены") ИЛИ СтрНайти(ТекЭлемент.Имя, "Отступ") Тогда
			УдаляемыеЭлементы.Добавить(ТекЭлемент);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого УдаляемыйЭлемент Из УдаляемыеЭлементы Цикл
		Форма.Элементы.Удалить(УдаляемыйЭлемент);
	КонецЦикла;
	
	Для Каждого Оформление Из Форма.УсловноеОформление.Элементы Цикл
		Если Оформление.Представление = "СозданоПрограммно" Тогда
			УсловныеОформления.Добавить(Оформление);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого Оформление Из УсловныеОформления Цикл
		Форма.УсловноеОформление.Элементы.Удалить(Оформление);
	КонецЦикла;
	
	Для Каждого ВидЦены Из Форма.ВидыЦен Цикл
		
		Если ВидЦены.Устанавливать Тогда 
		
			ИмяКолонки = УстановкаЦенСервер.ИмяКолонкиПоВидуЦены(ВидЦены.ВидЦены);
			
			ЦветЗаголовка = Неопределено;
			ЦветФона      = Неопределено;
			КартинкаШапки = Неопределено;
			
			ЦветФона      = WebЦвета.ШелковыйОттенок;		
			
			НоваяГруппа = ДобавитьГруппуФормы(Форма, "ГруппаЦены" + ИмяКолонки, Строка(ВидЦены.ВидЦены) + ", " + Строка(Объект.Валюта), Истина, КартинкаШапки, ГруппировкаКолонок.Горизонтальная, Неопределено);
			
			ЗаголовокКолонкиСтараяЦена = НСтр("ru='Старая цена'");		
			
					
			СтруктураПараметров = Новый Структура();
			СтруктураПараметров.Вставить("Заголовок",              НСтр("ru='Цена'"));
			СтруктураПараметров.Вставить("ОбработчикПриИзменении", "Подключаемый_ДеревоЦенЦенаПриИзменении");
			СтруктураПараметров.Вставить("ШиринаПоля",             12);
			СтруктураПараметров.Вставить("ЦветФона",               ЦветФона);
			СтруктураПараметров.Вставить("ЦветФонаЗаголовка",      ЦветЗаголовка);
			СтруктураПараметров.Вставить("Родитель",               НоваяГруппа);
			СтруктураПараметров.Вставить("ТолькоПросмотрПоля", 	   ВидЦены.Запрещенный);
			
			НовоеПоле = ДобавитьПолеФормы(Форма, ИмяКолонки, СтруктураПараметров);	
			
		КонецЕсли;	
		
	КонецЦикла;
	
	СтруктураПараметров = Новый Структура();
	СтруктураПараметров.Вставить("ШиринаПоля",             1); //3);
	СтруктураПараметров.Вставить("ТолькоПросмотрПоля",     Истина);
	
	НовоеПоле = ДобавитьПолеФормы(Форма, "Отступ", СтруктураПараметров);
	НовоеПоле.ЦветТекста = WebЦвета.Серый;
	НовоеПоле.Видимость  = Истина;
	НовоеПоле.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Нет;
	НовоеПоле.РастягиватьПоГоризонтали = Ложь; // Истина;

	
	ДеревоЦенЗначение = Форма.РеквизитФормыВЗначение(ИмяТаблицы);
	ДеревоЦенЗначение.Колонки.Очистить();
	
	Для Каждого Колонка Из ДеревоЗначений.Колонки Цикл
		ДеревоЦенЗначение.Колонки.Добавить(Колонка.Имя);
	КонецЦикла;
	
	Форма.ЗначениеВРеквизитФормы(ДеревоЦенЗначение, ИмяТаблицы);	
	
КонецПроцедуры

&НаСервере
Функция ДобавитьГруппуФормы(Форма,
	                        Имя,
	                        Заголовок,
	                        ОтображатьВШапке,
	                        КартинкаШапки,
	                        ГруппировкаКолонок,
	                        Родитель)
	
	НоваяГруппа                  = Форма.Элементы.Добавить("ДеревоЦен" + Имя, Тип("ГруппаФормы"), ?(Родитель = Неопределено, Форма.Элементы.ДеревоЦен, Родитель));
	НоваяГруппа.Заголовок        = ?(ЗначениеЗаполнено(Заголовок), Заголовок, Имя);
	НоваяГруппа.Вид              = ВидГруппыФормы.ГруппаКолонок;
	НоваяГруппа.Группировка      = ГруппировкаКолонок;
	НоваяГруппа.ОтображатьВШапке = ОтображатьВШапке;	
	
	Если ОтображатьВШапке И КартинкаШапки <> Неопределено Тогда
		НоваяГруппа.КартинкаШапки = КартинкаШапки;
	КонецЕсли;
	
	Возврат НоваяГруппа;
	
КонецФункции

&НаСервере
Функция ДобавитьПолеФормы(Форма, Имя, ДополнительныеПараметры)
	
	СтруктураПараметров = Новый Структура();
	СтруктураПараметров.Вставить("Заголовок",              Неопределено);
	СтруктураПараметров.Вставить("ОбработчикПриИзменении", "");
	СтруктураПараметров.Вставить("ОбработчикНачалоВыбора", "");
	СтруктураПараметров.Вставить("ШиринаПоля",             0);
	СтруктураПараметров.Вставить("ЦветФона",               Неопределено);
	СтруктураПараметров.Вставить("ЦветФонаЗаголовка",      Неопределено);
	СтруктураПараметров.Вставить("Родитель",               Неопределено);
	СтруктураПараметров.Вставить("КартинкаШапки",          Неопределено);
	СтруктураПараметров.Вставить("ПутьКДанным",            Неопределено);
	СтруктураПараметров.Вставить("ТолькоПросмотрПоля",     Ложь);
	СтруктураПараметров.Вставить("СвязиПараметровВыбора",  Неопределено);
	СтруктураПараметров.Вставить("ОтображатьВШапке",       Истина);
	
	ЗаполнитьЗначенияСвойств(СтруктураПараметров, ДополнительныеПараметры);
	
	НовоеПоле                     = Форма.Элементы.Добавить("ДеревоЦен" + Имя, Тип("ПолеФормы"), ?(СтруктураПараметров.Родитель = Неопределено, Форма.Элементы.ДеревоЦен, СтруктураПараметров.Родитель));
	НовоеПоле.ПутьКДанным         = ?(ЗначениеЗаполнено(СтруктураПараметров.ПутьКДанным), СтруктураПараметров.ПутьКДанным, "ДеревоЦен." + Имя);
	НовоеПоле.Заголовок           = ?(ЗначениеЗаполнено(СтруктураПараметров.Заголовок), СтруктураПараметров.Заголовок, Имя);
	НовоеПоле.РежимРедактирования = РежимРедактированияКолонки.ВходПриВводе;
	НовоеПоле.Вид                 = ВидПоляФормы.ПолеВвода;
	НовоеПоле.ТолькоПросмотр      = СтруктураПараметров.ТолькоПросмотрПоля;
	НовоеПоле.Ширина              = СтруктураПараметров.ШиринаПоля;
	НовоеПоле.ОтображатьВШапке    = СтруктураПараметров.ОтображатьВШапке;
	
	НовоеПоле.РастягиватьПоГоризонтали = Ложь;
	
	Если СтруктураПараметров.СвязиПараметровВыбора <> Неопределено Тогда
		НовоеПоле.СвязиПараметровВыбора = СтруктураПараметров.СвязиПараметровВыбора;
	КонецЕсли;
	
	Если СтруктураПараметров.ЦветФонаЗаголовка <> Неопределено Тогда
		НовоеПоле.ЦветФонаЗаголовка = СтруктураПараметров.ЦветФонаЗаголовка;
	КонецЕсли;
	
	Если СтруктураПараметров.ЦветФона <> Неопределено Тогда
		НовоеПоле.ЦветФона = СтруктураПараметров.ЦветФона;
	КонецЕсли;
		
	Если СтруктураПараметров.КартинкаШапки <> Неопределено Тогда
		НовоеПоле.КартинкаШапки = СтруктураПараметров.КартинкаШапки;
	КонецЕсли;
		
	Если ЗначениеЗаполнено(СтруктураПараметров.ОбработчикПриИзменении) Тогда
		НовоеПоле.УстановитьДействие("ПриИзменении", СтруктураПараметров.ОбработчикПриИзменении);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтруктураПараметров.ОбработчикНачалоВыбора) Тогда
		НовоеПоле.УстановитьДействие("НачалоВыбора", СтруктураПараметров.ОбработчикНачалоВыбора);
	КонецЕсли;
	
	Возврат НовоеПоле;
	
КонецФункции

&НаКлиенте
Процедура Подключаемый_ДеревоЦенЦенаПриИзменении(Элемент)
			
	ДеревоЦенЦенаПриИзмененииКлиент(Элемент);
	
КонецПроцедуры 

&НаКлиенте
Процедура ДеревоЦенЦенаПриИзмененииКлиент(Элемент)
	
	ТекущиеДанные = Элементы.ДеревоЦен.ТекущиеДанные;
	ТекущаяСтрока = ДеревоЦен.НайтиПоИдентификатору(ТекущиеДанные.ПолучитьИдентификатор());
	ИмяТекущейКолонки  = СтрЗаменить(Элемент.Имя, "ДеревоЦен", "");
	
	Если ТекущиеДанные.ПолучитьРодителя() = Неопределено Тогда
		//Цену поставили у родителя, нужно проставить у подчиненных
		ТекущееЗначение = ТекущиеДанные[ИмяТекущейКолонки];
		ЭлементыХарактеристики = ТекущаяСтрока.ПолучитьЭлементы();
		
		Для Каждого ЭлементХарактеристика Из ЭлементыХарактеристики Цикл
			
			ЭлементХарактеристика[ИмяТекущейКолонки] = ТекущееЗначение;
			
		КонецЦикла;
		
	КонецЕсли;
	
	
КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	УсловноеОформление.Элементы.Очистить();

	//Отметка незаполненного у номенклатур с характеристиками
	Элемент = УсловноеОформление.Элементы.Добавить();

	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.ДеревоЦенХарактеристикаНоменклатуры.Имя);
	
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ДеревоЦен.ИндексКартинки");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = 2;

	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ДеревоЦен.ХарактеристикаНоменклатуры");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено;
	Элемент.Оформление.УстановитьЗначениеПараметра("ОтметкаНезаполненного", Истина); 
	
	//Только просмотр для номенклатуры подчиненных элементов, чтобы только характеристику можно было изменить
	Элемент = УсловноеОформление.Элементы.Добавить();

	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.ДеревоЦенНоменклатура.Имя);
	
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ДеревоЦен.ИндексКартинки");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = 2;

	Элемент.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
	
	//Только просмотр для характеристики у родителя
	Элемент = УсловноеОформление.Элементы.Добавить();

	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.ДеревоЦенХарактеристикаНоменклатуры.Имя);
	
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ДеревоЦен.ИндексКартинки");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = 0;
	
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ДеревоЦен.ХарактеристикиИспользуются");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Истина;

	Элемент.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
	
	//Характеристика не используется
	//УстановитьУсловноеОформлениеХарактеристикНоменклатуры(ЭтаФорма, "ДеревоЦенХарактеристикаНоменклатуры", "ДеревоЦен.ХарактеристикиИспользуются");
	УстановитьУсловноеОформлениеХарактеристикНоменклатуры(ЭтаФорма, "ДеревоЦенХарактеристикаНоменклатуры", "ДеревоЦен.ХарактеристикаНоменклатуры");
	
	// №6823 помеченный на удаление
	Элемент = УсловноеОформление.Элементы.Добавить();

	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.ВидыЦенВидЦены.Имя);

	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ВидыЦен.ПометкаУдаления");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Истина;

	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ТекстЗапрещеннойЯчейкиЦвет);
	
	УстановкаЦенСервер.УстановитьУсловноеОформление(УсловноеОформление.Элементы);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформлениеХарактеристикНоменклатуры(Форма, ИмяПоляВводаХарактеристики, ПутьКПолюОтбора) Экспорт
						
	НовУсловноеОформление = Форма.УсловноеОформление;
	ЭлементыФормы = Форма.Элементы;
	
	ЭлементУсловногоОформления = НовУсловноеОформление.Элементы.Добавить();
	
	ПолеЭлемента = ЭлементУсловногоОформления.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(ЭлементыФормы[ИмяПоляВводаХарактеристики].Имя);
	
	ОтборЭлемента = ЭлементУсловногоОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ПутьКПолюОтбора);
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	//ОтборЭлемента.ПравоеЗначение = Ложь;
	ОтборЭлемента.ПравоеЗначение = Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка();

	ЭлементУсловногоОформления.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ТекстЗапрещеннойЯчейкиЦвет);
	ЭлементУсловногоОформления.Оформление.УстановитьЗначениеПараметра("ОтметкаНезаполненного", Ложь);
	//ЭлементУсловногоОформления.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru = '<характеристики не используются>'"));
	ЭлементУсловногоОформления.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru = '<без характеристики>'"));
	ЭлементУсловногоОформления.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
	
КонецПроцедуры

&НаСервере
Процедура ПереформироватьТаблицуЦен()
	
	ПоместитьЦеныВТабличнуюЧасть();
	ПостроитьДеревоЦенНаСервере();
	ЗагрузитьТабличнуюЧастьТовары();
	
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьТабличнуюЧастьТовары()
	
	ТаблицаТоваров = Объект.Товары.Выгрузить();	
	КЭШ = СоздатьТаблицуНоменклатуры();
	КЭШ.Колонки.Добавить("СтрокаДереваЦен");
	КЭШ.Индексы.Добавить("Номенклатура, ЕдиницаИзмерения");
	
	Если ТипЗнч(ДеревоЦен) = Тип("ДанныеФормыКоллекция") Тогда
		ЭлементыДереваЦен = ДеревоЦен;
	Иначе
		ЭлементыДереваЦен = ДеревоЦен.ПолучитьЭлементы();		
	КонецЕсли;
	
	Для Каждого ТекНоменклатура Из ТаблицаТоваров Цикл
		
		ИспользуютсяХарактеристики = ИспользуютсяХарактеристикиНоменклатуры(ТекНоменклатура.Номенклатура);
		НайденнаяСтрока = НайтиСтрокуДереваЦен(ТекНоменклатура, КЭШ);
		Если НайденнаяСтрока <> Неопределено Тогда
			ЭлементНоменклатура = НайденнаяСтрока.СтрокаДереваЦен;
		Иначе
			ЭлементНоменклатура = ЭлементыДереваЦен.Добавить();
			ЗаполнитьЗначенияСвойств(ЭлементНоменклатура, ТекНоменклатура);
			ЭлементНоменклатура.ХарактеристикиИспользуются = ИспользуютсяХарактеристики;
			ЭлементНоменклатура.ХарактеристикаНоменклатуры = Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка();
			ОбработкаТабличныхЧастейКлиентСервер.ЗаполнитьИндексКартинкиСтрокиДереваЦен(ЭлементНоменклатура);
			НоваяСтрокаТЗ = КЭШ.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрокаТЗ, ЭлементНоменклатура);
			НоваяСтрокаТЗ.СтрокаДереваЦен = ЭлементНоменклатура;
		КонецЕсли;
		
		Если ИспользуютсяХарактеристики Тогда
			Родитель = ЭлементНоменклатура;
			НайденнаяСтрокаХарактеристики = НайтиСтрокуДереваЦен(ТекНоменклатура, КЭШ, Истина);
			Если НайденнаяСтрокаХарактеристики <> Неопределено Тогда
				ЭлементНоменклатура = НайденнаяСтрокаХарактеристики.СтрокаДереваЦен;
			Иначе	
				ЭлементНоменклатура = ЭлементНоменклатура.ПолучитьЭлементы().Добавить();
				ЗаполнитьЗначенияСвойств(ЭлементНоменклатура, ТекНоменклатура);
				ЭлементНоменклатура.ХарактеристикаНоменклатуры = ТекНоменклатура.ХарактеристикаНоменклатуры;
				ЭлементНоменклатура.ХарактеристикиИспользуются = ИспользуютсяХарактеристики;
				ОбработкаТабличныхЧастейКлиентСервер.ЗаполнитьИндексКартинкиСтрокиДереваЦен(ЭлементНоменклатура);
				НоваяСтрокаТЗ = КЭШ.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрокаТЗ, ЭлементНоменклатура);
				НоваяСтрокаТЗ.СтрокаДереваЦен = ЭлементНоменклатура
			КонецЕсли;		
			
		КонецЕсли;	
		
		Если Не ЗначениеЗаполнено(ТекНоменклатура.ВидЦены) Тогда
			Продолжить;
		КонецЕсли;
		
		Если ЭлементНоменклатура = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ИмяКолонки = УстановкаЦенСервер.ИмяКолонкиПоВидуЦены(ТекНоменклатура.ВидЦены);
		
		ЭлементНоменклатура[ИмяКолонки] = ТекНоменклатура.Цена;	
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция НайтиСтрокуДереваЦен(ДанныеПоиска, КЭШ, ПоискХарактеристики = Ложь)

	Отбор = Новый Структура("Номенклатура, ЕдиницаИзмерения", ДанныеПоиска.Номенклатура, ДанныеПоиска.ЕдиницаИзмерения);
	Если ПоискХарактеристики Тогда
    	Отбор.Вставить("ХарактеристикаНоменклатуры", ДанныеПоиска.ХарактеристикаНоменклатуры);
	КонецЕсли;				
	
	МассивСтрок = КЭШ.НайтиСтроки(Отбор);
	Если МассивСтрок.Количество() > 0 Тогда
		Возврат МассивСтрок[0];			
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

&НаСервере
Функция СоздатьТаблицуНоменклатуры() Экспорт
	
	ТаблицаЗначений = Новый ТаблицаЗначений();
	
	ТаблицаЗначений.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ТаблицаЗначений.Колонки.Добавить("ХарактеристикаНоменклатуры", Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры"));
	МассивТипов = новый Массив;
	МассивТипов.Добавить("СправочникСсылка.ЕдиницаИзмерения");
	МассивТипов.Добавить("СправочникСсылка.КлассификаторЕдиницИзмерения");
	ТаблицаЗначений.Колонки.Добавить("ЕдиницаИзмерения", Новый ОписаниеТипов(МассивТипов));	
	
	Возврат ТаблицаЗначений;
	
КонецФункции

&НаСервере
Функция ИспользуютсяХарактеристикиНоменклатуры(Номенклатура)
	УстановитьПривилегированныйРежим(Истина);
	Запрос = новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	Характеристики.Ссылка
			|ИЗ 
			|   Справочник.ХарактеристикиНоменклатуры КАК Характеристики
			|ГДЕ
			|   Характеристики.Владелец = &Владелец
			|";
	Запрос.УстановитьПараметр("Владелец", Номенклатура);
	Выборка = Запрос.Выполнить().Выбрать();
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат ?(Выборка.Количество() = 0, Ложь, Истина);	
	
КонецФункции

&НаСервере
Процедура ПоместитьЦеныВТабличнуюЧасть(ТабличнаяЧасть=Неопределено)
	
	Если ТабличнаяЧасть=Неопределено Тогда
		ТабличнаяЧасть = Объект.Товары;
	КонецЕсли;
	
	ТабличнаяЧасть.Очистить();	
	
	ЭлементыНоменклатура = ДеревоЦен.ПолучитьЭлементы();
	Для Каждого ТекЭлементНоменклатура Из ЭлементыНоменклатура Цикл
		
		ПоместитьСтрокуЦенВТабличнуюЧасть(ТабличнаяЧасть, ТекЭлементНоменклатура);
				
		ЭлементыХарактеристики = ТекЭлементНоменклатура.ПолучитьЭлементы();
		Для Каждого ТекЭлементХарактеристика Из ЭлементыХарактеристики Цикл
			
			ПоместитьСтрокуЦенВТабличнуюЧасть(ТабличнаяЧасть, ТекЭлементХарактеристика);
						
		КонецЦикла;
		
	КонецЦикла;		
	
КонецПроцедуры

&НаСервере
Процедура ПоместитьСтрокуЦенВТабличнуюЧасть(ТабличнаяЧасть, СтрокаЦен)
	
	Для Каждого ВидЦены Из ВидыЦен Цикл
		
		Если ВидЦены.Устанавливать Тогда
			
			ИмяКолонки = УстановкаЦенСервер.ИмяКолонкиПоВидуЦены(ВидЦены.ВидЦены);
			ЕстьКолонкаЦены = СтрокаЦен.Свойство(ИмяКолонки);
			Если ЕстьКолонкаЦены Тогда
				Цена = СтрокаЦен[ИмяКолонки];
			КонецЕсли;			
			
			НоваяСтрока = ТабличнаяЧасть.Добавить();
			НоваяСтрока.Номенклатура = СтрокаЦен.Номенклатура;
			НоваяСтрока.ХарактеристикаНоменклатуры = СтрокаЦен.ХарактеристикаНоменклатуры;
			НоваяСтрока.ЕдиницаИзмерения = СтрокаЦен.ЕдиницаИзмерения;
			НоваяСтрока.ВидЦены = ВидЦены.ВидЦены;			
			
			Если ЕстьКолонкаЦены Тогда
				НоваяСтрока.Цена = Цена;								
			КонецЕсли;		
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ПостроитьДеревоЦенНаСервере()
	ПостроитьДеревоЦен(ЭтаФорма);	
КонецПроцедуры

