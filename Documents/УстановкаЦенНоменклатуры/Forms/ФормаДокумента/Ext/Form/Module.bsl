Процедура ПослеВыбораВидаЦеныДляЗагрузки(Результат, ДополнительныеПараметры) Экспорт

	Если ТипЗнч(Результат) = Тип("Структура") Тогда
		ЗагрузитьИзExcelЗавершение(Результат.ВидЦены);	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьИзExcelЗавершение(ВидЦены)

	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ИспользоватьСумму", Ложь);
	ПараметрыФормы.Вставить("ИспользоватьКоличество", Ложь);
	ПараметрыФормы.Вставить("ИспользоватьСтатьи", Ложь);
	ЗагружаемыйВидЦены = ВидЦены;

	ОткрытьФорму(
		"Обработка.ЗагрузкаНоменклатурыИзExcel.Форма.ЗагрузкаВТабличнуюЧасть",
		ПараметрыФормы,
		ЭтаФорма,
		УникальныйИдентификатор);

КонецПроцедуры

&НаСервере
Процедура ПолучитьЗагруженныеТоварыИзХранилища(АдресТоваровВХранилище)
	
	ТаблицаНоменклатуры = ПолучитьИзВременногоХранилища(АдресТоваровВХранилище);	
	УстановкаЦенСервер.ДобавитьНоменклатуруВДеревоЦен(ЭтаФорма, ТаблицаНоменклатуры);
	
	ИмяКолонки = УстановкаЦенСервер.ИмяКолонкиПоВидуЦены(ЗагружаемыйВидЦены);
	Дерево = ДеревоЦен.ПолучитьЭлементы();
	Для Каждого СтрокаНоменклатуры из Дерево Цикл		
		СтруктураПоиска = Новый Структура("Номенклатура, ХарактеристикаНоменклатуры, ЕдиницаИзмерения");
		ЗаполнитьЗначенияСвойств(СтруктураПоиска, СтрокаНоменклатуры);
		НайденныеСтроки = ТаблицаНоменклатуры.НайтиСтроки(СтруктураПоиска);
		Если НайденныеСтроки.Количество() > 0 Тогда
			СтрокаНоменклатуры[ИмяКолонки] = НайденныеСтроки[0].Цена;
		КонецЕсли;	
		
		СтрокиХарактеристик = СтрокаНоменклатуры.ПолучитьЭлементы();
		Для Каждого СтрокаХарактеристики из СтрокиХарактеристик Цикл			
			СтруктураПоиска = Новый Структура("Номенклатура, ХарактеристикаНоменклатуры, ЕдиницаИзмерения");
			ЗаполнитьЗначенияСвойств(СтруктураПоиска, СтрокаХарактеристики);
			НайденныеСтроки = ТаблицаНоменклатуры.НайтиСтроки(СтруктураПоиска);
			Если НайденныеСтроки.Количество() > 0 Тогда
				СтрокаХарактеристики[ИмяКолонки] = НайденныеСтроки[0].Цена;
			КонецЕсли;	
		КонецЦикла;
	КонецЦикла;
		
КонецПроцедуры

&НаКлиенте
Процедура ОкруглитьЦены(Команда)
	
	СписокВидовЦен = Новый СписокЗначений;
	Для Каждого ТекущаяСтрока Из ВидыЦен Цикл
		Если ТекущаяСтрока.Устанавливать Тогда
			СписокВидовЦен.Добавить(ТекущаяСтрока.ВидЦены);
		КонецЕсли;
	КонецЦикла;
	
	Если СписокВидовЦен.Количество() = 0 Тогда
		ПоказатьПредупреждение(, "Не выбраны виды цен");
		Возврат;
		
	ИначеЕсли СписокВидовЦен.Количество() = 1 Тогда
		ОкруглитьЦеныФрагмент(СписокВидовЦен[0].Значение);
		
	Иначе
		
		ПараметрыФормыВыбора = Новый Структура;
		ПараметрыФормыВыбора.Вставить("ВидыЦен", СписокВидовЦен);
		ПараметрыФормыВыбора.Вставить("ПоказыватьОрганизацию", Ложь);
		
		ОповещениеОЗакрытии = Новый ОписаниеОповещения("ПослеВыбораВидаЦеныДляОкругления", ЭтаФорма);
		
		ОткрытьФорму("Документ.УстановкаЦенНоменклатуры.Форма.ФормаВыборВидаЦен", ПараметрыФормыВыбора, ЭтаФорма, ,,, ОповещениеОЗакрытии);
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораВидаЦеныДляОкругления(Результат, ДополнительныеПараметры) Экспорт

	Если ТипЗнч(Результат) = Тип("Структура") Тогда
		ОкруглитьЦеныФрагмент(Результат.ВидЦены);	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОкруглитьЦеныФрагмент(ВидЦены)

	ОписаниеОповещения = Новый ОписаниеОповещения("ПослеВыбораПравилОкругления", ЭтаФорма, ВидЦены);
	ПараметрыФормы = Новый Структура("ТипВладельца", "УстановкаЦенНоменклатуры");
	ОткрытьФорму("ОбщаяФорма.ФормаНастроекОкругления", ПараметрыФормы,,,,,ОписаниеОповещения);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораПравилОкругления(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИмяКолонкиВидаЦены = УстановкаЦенВызовСервера.ИмяКолонкиПоВидуЦены(ДополнительныеПараметры);
	ПорядокОкругления = Результат.ПорядокОкругления;
	ОкруглятьВБольшуюСторону = Результат.ОкруглятьВБольшуюСторону;

	СтрокиНоменклатуры = ДеревоЦен.ПолучитьЭлементы();
	Для Каждого СтрокаНоменклатуры из СтрокиНоменклатуры Цикл
		Если ЗначениеЗаполнено(СтрокаНоменклатуры[ИмяКолонкиВидаЦены]) Тогда
			СтрокаНоменклатуры[ИмяКолонкиВидаЦены] = ОбщийМодуль.ОкруглитьЧисло(СтрокаНоменклатуры[ИмяКолонкиВидаЦены], ПорядокОкругления, ОкруглятьВБольшуюСторону);	
		КонецЕсли;		
		//характеристики
		СтрокиХарактеристик = СтрокаНоменклатуры.ПолучитьЭлементы();
		Для Каждого СтрокаХарактеристики из СтрокиХарактеристик Цикл
			Если ЗначениеЗаполнено(СтрокаХарактеристики[ИмяКолонкиВидаЦены]) Тогда
				СтрокаХарактеристики[ИмяКолонкиВидаЦены] = ОбщийМодуль.ОкруглитьЧисло(СтрокаХарактеристики[ИмяКолонкиВидаЦены], ПорядокОкругления, ОкруглятьВБольшуюСторону);
			КонецЕсли;			
		КонецЦикла;
	КонецЦикла;
	
	Модифицированность = Истина;
	
КонецПроцедуры

