
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ВидыЦен.Очистить();
	ВидыЦен.ЗагрузитьЗначения(Параметры.ВидыЦен.ВыгрузитьЗначения());
	
	Если Параметры.Свойство("ПоказыватьОрганизацию", ПоказыватьОрганизацию) Тогда
		ПоказыватьОрганизацию = Параметры.ПоказыватьОрганизацию;
		Элементы.Организация.Видимость = ПоказыватьОрганизацию;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВидЦенНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ДанныеВыбора = Новый СписокЗначений;
	Для НомерЭлемента = 0 По ВидыЦен.Количество()-1 Цикл
		ДанныеВыбора.Добавить(ВидыЦен.Получить(НомерЭлемента).Значение);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаОтмена(Команда)
	Закрыть(Неопределено);
КонецПроцедуры

&НаКлиенте
Процедура КомандаОК(Команда)
	
	Если ВидЦены.Пустая() Тогда
		ПоказатьПредупреждение(,"Укажите вид цен для заполнения");
		Возврат;
	КонецЕсли;
	Если ПоказыватьОрганизацию И Организация.Пустая() Тогда
		ПоказатьПредупреждение(,"Укажите организацию для поиска последних поступлений");
		Возврат;
	КонецЕсли;
	
	ПараметрыОтвета = Новый Структура;
	ПараметрыОтвета.Вставить("ВидЦены", ВидЦены);
	ПараметрыОтвета.Вставить("Организация", Организация);
	Закрыть(ПараметрыОтвета);
	
КонецПроцедуры
