&НаСервере
Функция КоличествоСтрокВДеревеЦен()
	
	Дерево = ДанныеФормыВЗначение(ЦеныДерево, Тип("ДеревоЗначений"));
	Возврат Дерево.Строки.Количество(); 
	
КонецФункции

&НаСервере
Процедура ДобавитьВидЦенВСтроки(ВидЦен)
	
	Дерево = ДанныеФормыВЗначение(ЦеныДерево, Тип("ДеревоЗначений"));
	Для Каждого Строка из Дерево.Строки Цикл
		
		ЗапросХарактеристики = Новый Запрос;
		ЗапросХарактеристики.Текст = 
		"ВЫБРАТЬ
		|	ХарактеристикиНоменклатуры.Ссылка
		|ИЗ
		|	Справочник.ХарактеристикиНоменклатуры КАК ХарактеристикиНоменклатуры
		|ГДЕ
		|	ХарактеристикиНоменклатуры.Владелец = &Владелец";
		ЗапросХарактеристики.УстановитьПараметр("Владелец", Строка.Номенклатура);
		РезультатЗапросаХарактеристики = ЗапросХарактеристики.Выполнить();
	   	ВыборкаХарактеристики = РезультатЗапросаХарактеристики.Выбрать();
		Если ВыборкаХарактеристики.Количество() = 0 Тогда

			Стр = Строка.Строки.Добавить();
			Стр.Номенклатура = Строка.Номенклатура;
			Стр.ВидЦены = ВидЦен;
			Стр.ЕдиницаИзмерения = ПолучитьБазовуюЕдиницуИзмеренияНоменклатуры(Стр.Номенклатура);
			
			//теперь добавим по всем единицам измерений по данной номенклатуре
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ЕдиницыИзмерений.Ссылка
			|ИЗ
			|	Справочник.ЕдиницыИзмерений КАК ЕдиницыИзмерений
			|ГДЕ
			|	ЕдиницыИзмерений.Владелец = &Владелец
			|	И ЕдиницыИзмерений.ПометкаУдаления = ЛОЖЬ";
			Запрос.УстановитьПараметр("Владелец", Строка.Номенклатура);
			Выборка = Запрос.Выполнить().Выбрать();
			Пока Выборка.Следующий() Цикл
				СтрДеревоВид = Строка.Строки.Добавить();
				СтрДеревоВид.Номенклатура = Стр.Номенклатура;
				СтрДеревоВид.ЕдиницаИзмерения = Выборка.Ссылка;
				СтрДеревоВид.ВидЦены = ВидЦен;
			КонецЦикла;
		Иначе
			
			Пока ВыборкаХарактеристики.Следующий() Цикл
				СтрДеревоВид = Строка.Строки.Добавить();
				СтрДеревоВид.Номенклатура = Строка.Номенклатура;
				СтрДеревоВид.ХарактеристикаНоменклатуры = ВыборкаХарактеристики.Ссылка;
				СтрДеревоВид.ЕдиницаИзмерения = ПолучитьБазовуюЕдиницуИзмеренияНоменклатуры(СтрДеревоВид.Номенклатура);
				СтрДеревоВид.ВидЦены = ВидЦен;
				
				//теперь добавим по всем единицам измерений по данной номенклатуре
				Запрос = Новый Запрос;
				Запрос.Текст = 
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	ЕдиницыИзмерений.Ссылка
				|ИЗ
				|	Справочник.ЕдиницыИзмерений КАК ЕдиницыИзмерений
				|ГДЕ
				|	ЕдиницыИзмерений.Владелец = &Владелец
				|	И ЕдиницыИзмерений.ПометкаУдаления = ЛОЖЬ";
				Запрос.УстановитьПараметр("Владелец", Строка.Номенклатура);
				Выборка = Запрос.Выполнить().Выбрать();
				Пока Выборка.Следующий() Цикл
					СтрДеревоВид = Строка.Строки.Добавить();
					СтрДеревоВид.Номенклатура = Строка.Номенклатура;
					СтрДеревоВид.ХарактеристикаНоменклатуры = ВыборкаХарактеристики.Ссылка;
					СтрДеревоВид.ЕдиницаИзмерения = Выборка.Ссылка;
					СтрДеревоВид.ВидЦены = ВидЦен;
				КонецЦикла;
			КонецЦикла;
			
		КонецЕсли;	
		
	КонецЦикла;	
	ЗначениеВДанныеФормы(Дерево, ЦеныДерево);
	
КонецПроцедуры

&НаСервере
Процедура УдалитьВидЦенИзСтрок(ВидЦен)
	
	Дерево = ДанныеФормыВЗначение(ЦеныДерево, Тип("ДеревоЗначений"));
	
	ТЗ = Новый ТаблицаЗначений;
	ТЗ.Колонки.Добавить("стр");
	ТЗ.Колонки.Добавить("стрДерева");
	
	Для Каждого стрДерева Из Дерево.Строки Цикл 
		Для Каждого стр Из стрДерева.Строки Цикл 
			
			Если стр.ВидЦены = ВидЦен Тогда
				НовСтр = ТЗ.Добавить();
				НовСтр.стр = стр;
				НовСтр.СтрДерева = стрДерева;
			КонецЕсли;
			
		КонецЦикла;
	КонецЦикла;
	
	Для Каждого стр из ТЗ Цикл
		стр.стрДерева.Строки.Удалить(стр.стр);
	КонецЦикла;
	
	ЗначениеВДанныеФормы(Дерево, ЦеныДерево);
	
КонецПроцедуры

&НаКлиенте
Процедура ВидыЦенУстанавливатьПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ВидыЦен.ТекущиеДанные;
	
	Если КоличествоСтрокВДеревеЦен() > 0 Тогда
		Если ТекущиеДанные.Устанавливать Тогда
			Если Вопрос("Добавить вид цен " + ТекущиеДанные.ВидЦены + " в строки документа?", РежимДиалогаВопрос.ДаНет) = КодВозвратаДиалога.Да Тогда
				ДобавитьВидЦенВСтроки(ТекущиеДанные.ВидЦены);
			Иначе
				ТекущиеДанные.Устанавливать = Ложь;
			КонецЕсли;
		Иначе
			Если Вопрос("Удалить вид цен " + ТекущиеДанные.ВидЦены + " из строк документа?", РежимДиалогаВопрос.ДаНет) = КодВозвратаДиалога.Да Тогда
				УдалитьВидЦенИзСтрок(ТекущиеДанные.ВидЦены);
			Иначе
				ТекущиеДанные.Устанавливать = Истина;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

