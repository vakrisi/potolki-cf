#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЭтоНовый = Ложь;
	
	Если Параметры.Ключ.Пустая() И Параметры.ЗначениеКопирования.Пустая() И НЕ ЗначениеЗаполнено(Параметры.Основание) Тогда
		ОбщийМодуль.ЗаполнитьШапкуДокумента(Объект);
		Объект.НеРегистрировытьНулевыеЦены = Истина;
		ЭтоНовый = Истина;
	Иначе
		ЭтаФорма.ТолькоПросмотр = ПраваПользователей.ДокументТолькоПросмотр(Объект.Ссылка);
	КонецЕсли;
	
	//определим существующий вид цен и отметим тем, что используются в документе
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВидыЦен.Ссылка,
	|	ВидыЦен.Код,
	|	ВидыЦен.Архивный
	|ИЗ
	|	Справочник.ВидыЦен КАК ВидыЦен
	|ГДЕ
	|	ВидыЦен.ПометкаУдаления = ЛОЖЬ
	|
	|УПОРЯДОЧИТЬ ПО
	|	ВидыЦен.Наименование";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если ПраваПользователей.ВидЦенДоступенПользователю(Выборка.Ссылка) Тогда
			НоваяСтрока = ВидыЦен.Добавить();
			НоваяСтрока.ВидЦены = Выборка.Ссылка;
			НоваяСтрока.Код = Выборка.Код;
			НоваяСтрока.Архивный = Выборка.Архивный;
		Иначе
		КонецЕсли;
	КонецЦикла;
	
	Если НЕ Объект.Ссылка.Пустая() ИЛИ НЕ Параметры.ЗначениеКопирования.Пустая() ИЛИ ЗначениеЗаполнено(Параметры.Основание) Тогда
		Для Каждого ТекущаяСтрока Из Объект.ВидыЦен Цикл
			Для Каждого ТекущийВидЦен Из ВидыЦен Цикл
				Если ТекущаяСтрока.ВидЦены = ТекущийВидЦен.ВидЦены Тогда
					ТекущийВидЦен.Устанавливать = Истина;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;
	
	//отсекаем архивные
	ВременнаяТаблица = ВидыЦен.Выгрузить();
	ВидыЦен.Очистить();
	Для Каждого ТекущаяСтрока Из ВременнаяТаблица Цикл
		Если ТекущаяСтрока.Архивный и НЕ ТекущаяСтрока.Устанавливать Тогда
			//пропускаем
		Иначе
			НоваяСтрока = ВидыЦен.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущаяСтрока);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого ТекущаяСтрока Из Объект.ВидыЦен Цикл
		НоваяСтрока = ВремВидЦен.Добавить();
		НоваяСтрока.ВидЦены = ТекущаяСтрока.ВидЦены;
	КонецЦикла;
	
	Номенклатура = Справочники.Номенклатура.ПустаяСсылка();
	Дерево = ДанныеФормыВЗначение(ЦеныДерево, Тип("ДеревоЗначений"));
	Для Каждого Стр из Объект.Товары Цикл
		Если Стр.Номенклатура <> Номенклатура Тогда
			СтрДерево = Дерево.Строки.Добавить();
			СтрДерево.Номенклатура = Стр.Номенклатура;
			Номенклатура = Стр.Номенклатура;
		КонецЕсли;
		СтрДеревоВид = СтрДерево.Строки.Добавить();
		СтрДеревоВид.Номенклатура = Стр.Номенклатура;
		СтрДеревоВид.ХарактеристикаНоменклатуры = Стр.ХарактеристикаНоменклатуры;
		СтрДеревоВид.ЕдиницаИзмерения = Стр.ЕдиницаИзмерения;
		СтрДеревоВид.Цена = Стр.Цена;
		СтрДеревоВид.ВидЦены = Стр.ВидЦены;
	КонецЦикла;
	ЗначениеВДанныеФормы(Дерево, ЦеныДерево);
	
	Элементы.ЦеныНаФормеЦена.Заголовок = "Цена, " + Объект.Валюта.Наименование;
	
	ПраваПользователей.УстановитьТолькоПросмотрДляРеквизитаНомер(Элементы.Номер.ТолькоПросмотр);

КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ПараметрыЗаписи)
	
	Объект.ВидыЦен.Очистить();
	Для Каждого ТекущаяСтрока Из ВидыЦен Цикл
		Если ТекущаяСтрока.Устанавливать Тогда
			НоваяСтрока = Объект.ВидыЦен.Добавить();
			НоваяСтрока.ВидЦены = ТекущаяСтрока.ВидЦены;
		КонецЕсли;
	КонецЦикла;
	
	Объект.Товары.Очистить();
	Дерево = ДанныеФормыВЗначение(ЦеныДерево, Тип("ДеревоЗначений"));
	Для Каждого Строка из Дерево.Строки Цикл
		Для Каждого СтрНоменклатура из Строка.Строки Цикл
			Если (НЕ СтрНоменклатура.Номенклатура.Пустая()) И (НЕ СтрНоменклатура.ВидЦены.Пустая()) Тогда
				Стр = Объект.Товары.Добавить();
				Стр.Номенклатура = СтрНоменклатура.Номенклатура;
				Стр.ХарактеристикаНоменклатуры = СтрНоменклатура.ХарактеристикаНоменклатуры;
				Стр.ЕдиницаИзмерения = СтрНоменклатура.ЕдиницаИзмерения;
				Стр.Цена = СтрНоменклатура.Цена;
				Стр.ВидЦены = СтрНоменклатура.ВидЦены;
			КонецЕсли;
		КонецЦикла;	
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	ПередЗаписьюНаСервере(Отказ, ПараметрыЗаписи);
	
КонецПроцедуры

#КонецОбласти

