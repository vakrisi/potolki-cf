&НаКлиенте
Процедура СотрудникиСотрудникПриИзменении(Элемент)
	ТекущиеДанные = Элементы.Сотрудники.ТекущиеДанные;
	Если ТекущиеДанные.Коэффициент = 0 Тогда
		ТекущиеДанные.Коэффициент = 1;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ИсполнителиПоУчасткамПриИзменении(Элемент)
	
	ПересчитатьПроцентУчастияИсполнителейПоОперациям();
	
КонецПроцедуры

&НаКлиенте
Процедура ИсполнителиПоУчасткамСотрудникПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ИсполнителиПоУчасткам.ТекущиеДанные;
	
	НомерСотрудника = Прав(Элемент.Имя, 1);
	
	Если ТекущиеДанные["Коэффициент" + НомерСотрудника] = 0 Тогда
		ТекущиеДанные["Коэффициент" + НомерСотрудника] = 1;
	КонецЕсли;
	
	
КонецПроцедуры

