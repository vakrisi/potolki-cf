&НаСервере
Процедура ЗаполнитьТаблицуВидовПродукции()
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТаблицаДокумента", Объект.ВидыПродукции.Выгрузить());
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	ТаблицаДокумента.ВидПроизводства КАК ВидПроизводства,
	|	ТаблицаДокумента.ВидПродукции КАК ВидПродукции
	|ПОМЕСТИТЬ ВТ_ТаблицаДокумента
	|ИЗ
	|	&ТаблицаДокумента КАК ТаблицаДокумента
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЗНАЧЕНИЕ(Перечисление.ВидыПроизводства.Потолок) КАК ВидПроизводства,
	|	ЗНАЧЕНИЕ(Справочник.ВидыПродукции.ПустаяСсылка) КАК ВидПродукции,
	|	ПРЕДСТАВЛЕНИЕ(ЗНАЧЕНИЕ(Перечисление.ВидыПроизводства.Потолок)) КАК Представление,
	|	ЛОЖЬ КАК ПометкаУдаления,
	|	10 КАК Порядок
	|ПОМЕСТИТЬ ВТ
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(Перечисление.ВидыПроизводства.Отрез),
	|	ЗНАЧЕНИЕ(Справочник.ВидыПродукции.ПустаяСсылка),
	|	ПРЕДСТАВЛЕНИЕ(ЗНАЧЕНИЕ(Перечисление.ВидыПроизводства.Отрез)),
	|	ЛОЖЬ,
	|	20
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(Перечисление.ВидыПроизводства.ТиповоеПроизводство),
	|	ЗНАЧЕНИЕ(Справочник.ВидыПродукции.ПустаяСсылка),
	|	ПРЕДСТАВЛЕНИЕ(ЗНАЧЕНИЕ(Перечисление.ВидыПроизводства.ТиповоеПроизводство)),
	|	ЛОЖЬ,
	|	30
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(Перечисление.ВидыПроизводства.Продукция),
	|	ВидыПродукции.Ссылка,
	|	ПРЕДСТАВЛЕНИЕ(ВидыПродукции.Ссылка),
	|	ВидыПродукции.ПометкаУдаления,
	|	40
	|ИЗ
	|	Справочник.ВидыПродукции КАК ВидыПродукции
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВТ.ВидПроизводства КАК ВидПроизводства,
	|	ВТ.ВидПродукции КАК ВидПродукции,
	|	ВТ.Представление КАК Представление,
	|	ВЫБОР
	|		КОГДА ВТ_ТаблицаДокумента.ВидПроизводства ЕСТЬ NULL
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ КАК Пометка
	|ИЗ
	|	ВТ КАК ВТ
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ТаблицаДокумента КАК ВТ_ТаблицаДокумента
	|		ПО (ВТ_ТаблицаДокумента.ВидПроизводства = ВТ.ВидПроизводства)
	|			И (ВТ_ТаблицаДокумента.ВидПродукции = ВТ.ВидПродукции)
	|ГДЕ
	|	(НЕ ВТ.ПометкаУдаления
	|			ИЛИ НЕ ВТ_ТаблицаДокумента.ВидПроизводства ЕСТЬ NULL)
	|	И ВЫБОР
	|			КОГДА ВТ.ВидПроизводства = ЗНАЧЕНИЕ(Перечисление.ВидыПроизводства.ТиповоеПроизводство)
	|				ТОГДА НЕ ВТ_ТаблицаДокумента.ВидПроизводства ЕСТЬ NULL
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|
	|УПОРЯДОЧИТЬ ПО
	|	ВТ.Порядок,
	|	ВидПродукции
	|АВТОУПОРЯДОЧИВАНИЕ";
	
	РезультатЗапроса = Запрос.Выполнить();
	ТаблицаВидыПродукции.Загрузить(РезультатЗапроса.Выгрузить());
	
КонецПроцедуры

