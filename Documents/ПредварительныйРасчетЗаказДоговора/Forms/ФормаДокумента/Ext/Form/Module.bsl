Процедура ЗаполнитьМатериалыПоСпецификацииНаСервере()
	
	Дерево = ДанныеФормыВЗначение(ДеревоТоваров, Тип("ДеревоЗначений"));
	
	Объект.Материалы.Очистить();
	
	ВременнаяТаблица = Новый ТаблицаЗначений; //хранит общее количество необходимых материалов по спецификации после округления общего количества товаров
	ВременнаяТаблица.Колонки.Добавить("Номенклатура");
	ВременнаяТаблица.Колонки.Добавить("ХарактеристикаНоменклатуры");
	ВременнаяТаблица.Колонки.Добавить("ОкруглятьВБольшуюСторону");
	ВременнаяТаблица.Колонки.Добавить("ПорядокОкругленияЧислом");
	ВременнаяТаблица.Колонки.Добавить("КоличествоДоОкругления");
	ВременнаяТаблица.Колонки.Добавить("КоличествоПослеОкругления");
	ВременнаяТаблица.Колонки.Добавить("УИСтроки");
	
	ТаблицаМатериалов = Новый ТаблицаЗначений;
	ТаблицаМатериалов.Колонки.Добавить("Комната");
	ТаблицаМатериалов.Колонки.Добавить("Номенклатура");
	ТаблицаМатериалов.Колонки.Добавить("ХарактеристикаНоменклатуры");
	ТаблицаМатериалов.Колонки.Добавить("ЕдиницаИзмерения");
	ТаблицаМатериалов.Колонки.Добавить("Коэффициент");
	ТаблицаМатериалов.Колонки.Добавить("Количество");
	ТаблицаМатериалов.Колонки.Добавить("УИСтроки");

	Для Каждого ТекущаяСтрокаКомнаты Из Дерево.Строки Цикл
		Для Каждого ТекущаяСтрока Из ТекущаяСтрокаКомнаты.Строки Цикл
			НоваяСтрока = ТаблицаМатериалов.Добавить();
			НоваяСтрока.Комната = ТекущаяСтрока.Комната;
			Если НЕ ТекущаяСтрока.Спецификация.Пустая() Тогда
				Для Каждого СтрокаСпецификации Из ТекущаяСтрока.Спецификация.Состав Цикл
					КоэффициентИзменения = ?(СтрокаСпецификации.ФиксированноеКоличество, 1, ТекущаяСтрока.Количество * ТекущаяСтрока.Коэффициент);
					КоличествоКДобавлению = ОбщийМодуль.ОкруглитьЧисло(КоэффициентИзменения * СтрокаСпецификации.Количество,СтрокаСпецификации.ПорядокОкругленияЧислом,СтрокаСпецификации.ОкруглятьВБольшуюСторону); 
					Если КоличествоКДобавлению > 0 Тогда
						НоваяСтрока = ТаблицаМатериалов.Добавить();
						ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаСпецификации);
						НоваяСтрока.Комната = ТекущаяСтрока.Комната;
						НоваяСтрока.Количество = КоличествоКДобавлению;
						НоваяСтрока.УИСтроки = ТекущаяСтрока.УИСтроки;
						
						НоваяВремСтрока = ВременнаяТаблица.Добавить();
						НоваяВремСтрока.Номенклатура = СтрокаСпецификации.Номенклатура;
						НоваяВремСтрока.ХарактеристикаНоменклатуры = СтрокаСпецификации.ХарактеристикаНоменклатуры;
						НоваяВремСтрока.ОкруглятьВБольшуюСторону = СтрокаСпецификации.ОкруглятьВБольшуюСторону;
						НоваяВремСтрока.ПорядокОкругленияЧислом = СтрокаСпецификации.ПорядокОкругленияЧислом;
						НоваяВремСтрока.КоличествоДоОкругления = КоэффициентИзменения * СтрокаСпецификации.Количество;
						НоваяВремСтрока.КоличествоПослеОкругления = 0;
						НоваяВремСтрока.УИСтроки = ТекущаяСтрока.УИСтроки;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	ТаблицаМатериалов.Свернуть("Комната, Номенклатура, ХарактеристикаНоменклатуры, ЕдиницаИзмерения, Коэффициент, УИСтроки","Количество");
	ВременнаяТаблица.Свернуть("Номенклатура, ХарактеристикаНоменклатуры, ОкруглятьВБольшуюСторону, ПорядокОкругленияЧислом, УИСтроки", "КоличествоДоОкругления, КоличествоПослеОкругления");
	
	//посчитаем сколько какого материала должно быть итого с применением округления
	Для Каждого ТекущаяСтрока Из ВременнаяТаблица Цикл
		ТекущаяСтрока.КоличествоПослеОкругления = ОбщийМодуль.ОкруглитьЧисло(ТекущаяСтрока.КоличествоДоОкругления,ТекущаяСтрока.ПорядокОкругленияЧислом,ТекущаяСтрока.ОкруглятьВБольшуюСторону);
	КонецЦикла;
	
	//получаем итоговое количество каждого материала после всех округлений
	ВременнаяТаблица.Свернуть("Номенклатура, ХарактеристикаНоменклатуры", "КоличествоПослеОкругления");
	
	//перезаполняем количество в результирующей таблице на основании того, сколько должно было бы получиьтся при общем итоге после округления
	Для Каждого ТекущийМатериал Из ТаблицаМатериалов Цикл
		КоличествоБыло = ТекущийМатериал.Количество;
		ТекущийМатериал.Количество = 0;
		Для Каждого ТекущийИтогМатериала Из ВременнаяТаблица Цикл
			Если ТекущийМатериал.Номенклатура = ТекущийИтогМатериала.Номенклатура Тогда
				Если ТекущийИтогМатериала.КоличествоПослеОкругления >= КоличествоБыло Тогда
					ТекущийМатериал.Количество = КоличествоБыло;
					ТекущийИтогМатериала.КоличествоПослеОкругления = ТекущийИтогМатериала.КоличествоПослеОкругления - КоличествоБыло;
				Иначе
					ТекущийМатериал.Количество = ТекущийИтогМатериала.КоличествоПослеОкругления;
					ТекущийИтогМатериала.КоличествоПослеОкругления = 0;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла
	КонецЦикла;
	
	//переносим таблицу в документ
	Для Каждого ТекущийМатериал Из ТаблицаМатериалов Цикл
		Если НЕ ТекущийМатериал.Количество = 0 Тогда
			НоваяСтрока = Объект.Материалы.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущийМатериал);
		КонецЕсли;
	КонецЦикла;
	
	ПерестроитьДеревоНаФорме();
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВопросаОбОчисткеМатериалов(Результат, Параметры) Экспорт
    Если Результат = КодВозвратаДиалога.Нет Тогда
        Возврат;
    КонецЕсли;

    ЗаполнитьМатериалыПоСпецификацииНаСервере();
	РазвернутьДеревоМатериалов();
	РазвернутьДеревоТоваров();
	ОбновитьЭлементыФормы();

КонецПроцедуры

&НаКлиенте
Процедура ДеревоТоваровСпецификацияПриИзменении(Элемент)
		//корневые строки редактировать нельзя
	Если Элементы.ДеревоТоваров.ТекущиеДанные.ПолучитьРодителя() = Неопределено Тогда
		Элементы.ДеревоТоваров.ТекущиеДанные.Сумма = 0;
		Возврат;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораМатериала(ВыбЗнач, ДопПараметры) Экспорт
	Если НЕ ВыбЗнач = Неопределено Тогда
		ПослеВыбораМатериалаНаСервере(ВыбЗнач, ДопПараметры);
		ПеренестиДеревоВТабличнуюЧасть();
		РазвернутьДеревоМатериалов();
		ДобавленнаяСтрока = НайтиСтрокуДерева(ДеревоМатериалов, ДопПараметры, ВыбЗнач);
		Если НЕ ДобавленнаяСтрока = Неопределено Тогда
			Элементы.ДеревоМатериалов.ТекущаяСтрока = ДобавленнаяСтрока.ПолучитьИдентификатор();
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ПослеВыбораМатериалаНаСервере(ВыбЗнач, ДопПараметры)
	
	Дерево = ДанныеФормыВЗначение(ДеревоМатериалов, Тип("ДеревоЗначений"));
	Для Каждого Строка из Дерево.Строки Цикл
		Если Строка.Комната = ДопПараметры Тогда
			Стр = Строка.Строки.Добавить();
			Стр.Номенклатура = ВыбЗнач;
			Стр.Комната = ДопПараметры;			
			
			Стр.ЕдиницаИзмерения = ПолучитьБазовуюЕдиницуИзмеренияНоменклатуры(Стр.Номенклатура);
			Стр.Коэффициент = 1;			
			Стр.Количество = 1;
			Стр.УИСтроки = Новый УникальныйИдентификатор;
			
			ЗначениеВДанныеФормы(Дерево, ДеревоМатериалов);
			Возврат;
		КонецЕсли
	КонецЦикла;	
	
КонецПроцедуры

&НаКлиенте
Процедура СкопироватьВДругуюКомнату(Команда)
		
	ВыделенныеСтроки = Элементы.ДеревоТоваров.ВыделенныеСтроки;
	Если ВыделенныеСтроки.Количество() = 0 Тогда
		ПоказатьПредупреждение(, "Выберите товар или услугу комнаты, который нужно скопировать");
		Возврат;
	КонецЕсли;
	
	Для каждого ТекущаяСтрока из ВыделенныеСтроки Цикл
		СтрокаТЧ = ДеревоТоваров.НайтиПоИдентификатору(ТекущаяСтрока);
		
		Если СтрокаТЧ.Номенклатура.Пустая() Тогда
			ПоказатьПредупреждение(,"Выберите товар или услугу комнаты, который нужно скопировать");
			Возврат;
		КонецЕсли;
	
		ДанныеНоменклатуры = ПолучитьДанныеНоменклатуры(СтрокаТЧ.Номенклатура);
		Если ДанныеНоменклатуры.ЭтоУникальныйПотолок Тогда
			ПоказатьПредупреждение(,"Копирование потолков запрещено!");
			Возврат;
		КонецЕсли;
	КонецЦикла;	
	
	СписокКомнат = ОбщийМодульКлиент.ПолучитьСписокКомнатПоДереву(ДеревоТоваров);	
	ДопПараметры = Новый Структура;
	
	СкопироватьВДругуюКомнатуПодтверждение = Новый ОписаниеОповещения("СкопироватьВДругуюКомнатуПодтверждение", ЭтаФорма, ДопПараметры);
	СписокКомнат.ПоказатьВыборЭлемента(СкопироватьВДругуюКомнатуПодтверждение, "Выберите комнату");
	
КонецПроцедуры

&НаКлиенте
Процедура СкопироватьВДругуюКомнатуПодтверждение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИмяКомнаты = Результат.Значение;
	Если ИмяКомнаты = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	НоваяСтрока = Неопределено;
	ЭлементыДерева = ДеревоТоваров.ПолучитьЭлементы();
	Для Каждого ТекЭлемент из ЭлементыДерева Цикл
		Если СокрЛП(ТекЭлемент.Комната) = СокрЛП(ИмяКомнаты) Тогда			
			ВыделенныеСтроки = Элементы.ДеревоТоваров.ВыделенныеСтроки;	
			Для каждого ТекущаяСтрока из ВыделенныеСтроки Цикл
				СтрокаТЧ = ДеревоТоваров.НайтиПоИдентификатору(ТекущаяСтрока);
				
				НоваяСтрока = ТекЭлемент.ПолучитьЭлементы().Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТЧ, , "Комната, УИСтроки");
				НоваяСтрока.Комната = ИмяКомнаты;
				НоваяСтрока.УИСтроки = Новый УникальныйИдентификатор;
				
				Если НЕ НоваяСтрока.Спецификация.Пустая() Тогда
				//	ПерезаполнитьМатериалыПоСпецификации(НоваяСтрока, , "ДобавлениеНоменклатуры");
				КонецЕсли;
			КонецЦикла;
			
			// на случай, если в комнате не было позиций
			ИдентификаторСтроки = ТекЭлемент.ПолучитьИдентификатор();
			Элементы.ДеревоТоваров.Развернуть(ИдентификаторСтроки);
			
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	РассчитатьИтоговыеПоказателиКлиент();
	
КонецПроцедуры

&НаКлиенте
Процедура СкопироватьМатериалыВДругуюКомнату(Команда)
		
	ВыделенныеСтроки = Элементы.ДеревоМатериалов.ВыделенныеСтроки;
	Если ВыделенныеСтроки.Количество() = 0 Тогда
		ПоказатьПредупреждение(, "Выберите материалы, которые нужно скопировать");
		Возврат;
	КонецЕсли;
	
	Для каждого ТекущаяСтрока из ВыделенныеСтроки Цикл
		СтрокаТЧ = ДеревоМатериалов.НайтиПоИдентификатору(ТекущаяСтрока);
		
		Если СтрокаТЧ.Номенклатура.Пустая() Тогда
			ПоказатьПредупреждение(,"Выберите материалы, которые нужно скопировать");
			Возврат;
		КонецЕсли;
	
		//ДанныеНоменклатуры = ПолучитьДанныеНоменклатуры(СтрокаТЧ.Номенклатура);
		//Если ДанныеНоменклатуры.ЭтоУникальныйПотолок Тогда
		//	ПоказатьПредупреждение(,"Копирование потолков запрещено!");
		//	Возврат;
		//КонецЕсли;
	КонецЦикла;	
	
	СписокКомнат = ОбщийМодульКлиент.ПолучитьСписокКомнатПоДереву(ДеревоТоваров);	
	ДопПараметры = Новый Структура;
	
	СкопироватьВДругуюКомнатуПодтверждение = Новый ОписаниеОповещения("СкопироватьМатериалыВДругуюКомнатуПодтверждение", ЭтаФорма, ДопПараметры);
	СписокКомнат.ПоказатьВыборЭлемента(СкопироватьВДругуюКомнатуПодтверждение, "Выберите комнату");
	
КонецПроцедуры

&НаКлиенте
Процедура СкопироватьМатериалыВДругуюКомнатуПодтверждение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИмяКомнаты = Результат.Значение;
	Если ИмяКомнаты = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	НоваяСтрока = Неопределено;
	ЭлементыДерева = ДеревоМатериалов.ПолучитьЭлементы();
	Для Каждого ТекЭлемент из ЭлементыДерева Цикл
		Если СокрЛП(ТекЭлемент.Комната) = СокрЛП(ИмяКомнаты) Тогда			
			ВыделенныеСтроки = Элементы.ДеревоМатериалов.ВыделенныеСтроки;	
			Для каждого ТекущаяСтрока из ВыделенныеСтроки Цикл
				СтрокаТЧ = ДеревоМатериалов.НайтиПоИдентификатору(ТекущаяСтрока);
				
				НоваяСтрока = ТекЭлемент.ПолучитьЭлементы().Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТЧ, , "Комната, УИСтроки, КоличествоВМонтажах");
				НоваяСтрока.Комната = ИмяКомнаты;
				НоваяСтрока.УИСтроки = Новый УникальныйИдентификатор;
			КонецЦикла;
			
			// на случай, если в комнате не было позиций
			ИдентификаторСтроки = ТекЭлемент.ПолучитьИдентификатор();
			Элементы.ДеревоМатериалов.Развернуть(ИдентификаторСтроки);
			
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	ПеренестиДеревоВТабличнуюЧасть();
	
	Если НоваяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьЭлементыФормы(Знач ТекущаяКомната = Неопределено, Знач ТекущаяНоменклатура = Неопределено)
	
	// обновим отображение деревьев
	РассчитатьИтогиПоКомнатам();
	
	Если НЕ Элементы.ДеревоТоваров.ТекущиеДанные = Неопределено Тогда
		Если ТекущаяКомната = Неопределено Тогда
			ТекущаяКомната = Элементы.ДеревоТоваров.ТекущиеДанные.Комната;
		КонецЕсли;
		Если ТекущаяНоменклатура = Неопределено Тогда
			ТекущаяНоменклатура = Элементы.ДеревоТоваров.ТекущиеДанные.Номенклатура;
		КонецЕсли;
	КонецЕсли;
	РазвернутьДеревоТоваров(ТекущаяКомната,ТекущаяНоменклатура);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьДанныеНоменклатуры(ПозицияНоменклатуры)
	
	СтруктураОтвета = Новый Структура;
	СтруктураОтвета.Вставить("ЭтоПотолок", Справочники.ВидыНоменклатуры.ЭтоНоменклатураПотолкаИлиОтреза(ПозицияНоменклатуры));
	СтруктураОтвета.Вставить("ЭтоУникальныйПотолок", Справочники.ВидыНоменклатуры.ЭтоНоменклатураУникальногоПотолкаИлиОтреза(ПозицияНоменклатуры));
	СтруктураОтвета.Вставить("Потолок_КоличествоПродукция", ПозицияНоменклатуры.Потолок_КоличествоПродукция);
	Возврат СтруктураОтвета;
	
КонецФункции

&НаКлиенте
Процедура РассчитатьИтоговыеПоказателиКлиент(ФормаТолькоПросмотр = Ложь) Экспорт
	//#7556
		
	ИтогСумма = 0;
	ИтогСуммаБезСкидки = 0;
	ИтогСуммаПоПрайсу = 0;
	ИтогСуммаНДС = 0;
	ИтогСуммаСкидки = 0;
	ИтогКоличествоКомнат = 0;
	
	ИтогКоличествоПотолков = 0; // реквизит формы
	ИтогПлощадьПотолков = 0; // реквизит формы
	
	ЭлементыДерева = ДеревоТоваров.ПолучитьЭлементы();
	ИтогКоличествоКомнат = ЭлементыДерева.Количество();
	
	Для Каждого СтрокаКомнаты из ЭлементыДерева Цикл
		
		СуммаПоКомнате = 0;
		СуммаПоПрайсуКомнате = 0;
		ИтогБесплатноПоКомнате = 0;
		ИтогПлатноПоКомнате = 0;
		
		Для Каждого СтрокаТовара Из СтрокаКомнаты.ПолучитьЭлементы() Цикл
			ИтогСумма = ИтогСумма + СтрокаТовара.Сумма;
			ИтогСуммаБезСкидки = ИтогСуммаБезСкидки + СтрокаТовара.Количество * СтрокаТовара.Цена;
			ИтогСуммаПоПрайсу = ИтогСуммаПоПрайсу + СтрокаТовара.СуммаПоПрайсу;
			ИтогСуммаНДС = ИтогСуммаНДС + СтрокаТовара.СуммаНДС;
			ИтогСуммаСкидки = ИтогСуммаСкидки + СтрокаТовара.СуммаСкидки;			
			Если ЗначениеЗаполнено(СтрокаТовара.Номенклатура) И ОбщийМодульВызовСервера.ЭтоНоменклатураПотолкаРозницы(СтрокаТовара.Номенклатура) Тогда
				ИтогКоличествоПотолков = ИтогКоличествоПотолков + 1; 
				ИтогПлощадьПотолков = ИтогПлощадьПотолков + СтрокаТовара.Количество;	
			КонецЕсли;
			
			СуммаПоКомнате = СуммаПоКомнате + СтрокаТовара.Сумма;
			СуммаПоПрайсуКомнате = СуммаПоПрайсуКомнате + СтрокаТовара.СуммаПоПрайсу;			
			ИтогБесплатноПоКомнате = ИтогБесплатноПоКомнате + ?(СтрокаТовара.Бесплатно, 1, 0);
			ИтогПлатноПоКомнате    = ИтогПлатноПоКомнате    + ?(СтрокаТовара.Бесплатно, 0, 1);
		КонецЦикла;
		
		СтрокаКомнаты.Сумма = СуммаПоКомнате;
		СтрокаКомнаты.СуммаПоПрайсу = СуммаПоПрайсуКомнате;
		СтрокаКомнаты.Бесплатно = (ИтогБесплатноПоКомнате > 0 И ИтогПлатноПоКомнате = 0);
	КонецЦикла;
	ИтогОтклонениеОтПрайса = ИтогСумма - ИтогСуммаПоПрайсу; //как в отчете по эффективностям
	
	Если НЕ ФормаТолькоПросмотр Тогда
		//Если Объект.КоличествоКомнат <> ИтогКоличествоКомнат Тогда
		//	Объект.КоличествоКомнат = ИтогКоличествоКомнат;
		//	Модифицированность = Истина;
		//КонецЕсли;
		
		Если Объект.СуммаДокумента <> ИтогСумма Тогда
			Объект.СуммаДокумента = ИтогСумма;
			Модифицированность = Истина;
		КонецЕсли;
		Если Объект.СуммаДокументаПоПрайсу <> ИтогСуммаПоПрайсу Тогда
			Объект.СуммаДокументаПоПрайсу = ИтогСуммаПоПрайсу;
			Модифицированность = Истина;
		КонецЕсли;
		//Если Объект.ОтклонениеОтПрайса <> ИтогОтклонениеОтПрайса Тогда
		//	Объект.ОтклонениеОтПрайса = ИтогОтклонениеОтПрайса;
		//	Модифицированность = Истина;
		//КонецЕсли;
		//Если Объект.СуммаСкидки <> ИтогСуммаСкидки Тогда
		//	Объект.СуммаСкидки = ИтогСуммаСкидки;
		//	Объект.ПроцентСкидки = ИтогСуммаСкидки;
		//	Если ИтогСуммаБезСкидки <> 0 Тогда
		//		Объект.ПроцентСкидки = Окр(100*ИтогСуммаСкидки / (ИтогСуммаБезСкидки), 2);
		//	Иначе
		//		Объект.ПроцентСкидки = 0;
		//	КонецЕсли;
		//	Модифицированность = Истина;
		//КонецЕсли;
	КонецЕсли;

	СуммаНДС = ИтогСуммаНДС;	
	//Если УчитыватьНДС Тогда
	//	Элементы.ИтогиВсегоНДС.Заголовок = Формат(ИтогСуммаНДС, "ЧРГ=; ЧН=0,00");
	//КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьКонструкцию(Команда)
	
	ПараметрыФормы = Новый Структура("РежимДобавленияКонструкции", Истина);
	ОписаниеОповещения = Новый ОписаниеОповещения("ПослеВводаДанныхПродукцииПоВиду", ЭтотОбъект);
	ОткрытьФорму("ОбщаяФорма.ФормаДобавленияПродукцииПоВиду", ПараметрыФормы, ЭтотОбъект,,,, ОписаниеОповещения);
	
КонецПроцедуры

