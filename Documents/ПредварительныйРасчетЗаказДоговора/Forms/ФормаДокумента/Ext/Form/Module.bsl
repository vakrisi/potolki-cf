Процедура ПослеИзмененияКоличестваТоваров(ТекущаяСтрока, Знач ПерезаполнитьСкидки = Истина)
	
	//проставим автоматическую скидку + скидку вида
	Если ПерезаполнитьСкидки Тогда
		ТекущаяСтрока.ПроцентСкидки = ПолучитьПроцентАвтоматическойСкидкиСервер(ИспользоватьАвтоматическиеСкидки, Объект.Дата, ТекущаяСтрока.Номенклатура, ТекущаяСтрока.Количество) + ПолучитьПроцентВидаСкидки(Объект.ВидСкидки);
	КонецЕсли;
	
	//Если мИспользоватьАвтоматическиеСкидки Тогда
	//	Если ИспользоватьАвтоматическиеСкидкиВРазрезеКомнат() Тогда 
	//		РассчитатьСуммуСтроки(Элементы.ДеревоТоваров.ТекущиеДанные);
	//	Иначе			
	//		РасчетПроцентаАвтоматическойСкидки(Элементы.ДеревоТоваров.ТекущиеДанные);
	//	КонецЕсли;		
	//Иначе
		РассчитатьСуммуСтроки(ТекущаяСтрока);
	//КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПеренестиВДругуюКомнату(Команда)
	
	ВыделенныеСтроки = Элементы.ДеревоТоваров.ВыделенныеСтроки;
	Если ВыделенныеСтроки.Количество() = 0 Тогда
		ПоказатьПредупреждение(, "Выберите товар или услугу комнаты, который нужно перенести");
		Возврат;
	КонецЕсли;
	
	ТекущаяКомната = Неопределено;
	
	Для каждого ТекущаяСтрока из ВыделенныеСтроки Цикл
		СтрокаТЧ = ДеревоТоваров.НайтиПоИдентификатору(ТекущаяСтрока);

		Если ТекущаяКомната = Неопределено Тогда
			ТекущаяКомната = СтрокаТЧ.Комната;
		КонецЕсли;
		Если НЕ ТекущаяКомната = СтрокаТЧ.Комната Тогда
			ПоказатьПредупреждение(,"Выберите товары / услуги из одной комнаты!");
			Возврат;
		КонецЕсли;
		
		СтрокаТЧ = ДеревоТоваров.НайтиПоИдентификатору(ТекущаяСтрока);
		
		Если СтрокаТЧ.Номенклатура.Пустая() Тогда
			ПоказатьПредупреждение(,"Выберите товар или услугу комнаты, который нужно скопировать");
			Возврат;
		КонецЕсли;	
	КонецЦикла;		
	
	ПараметрыПереносаПозиции = Новый Структура;
	ПараметрыПереносаПозиции.Вставить("Форма", ЭтаФорма);
	ПараметрыПереносаПозиции.Вставить("ВыделенныеСтроки", ВыделенныеСтроки);
	ПараметрыПереносаПозиции.Вставить("ТекущаяКомната",  ТекущаяКомната);
		
	ОбщийМодульКлиент.Розница_ПеренестиПозициюВДругуюКомнату(ПараметрыПереносаПозиции);
	
КонецПроцедуры

