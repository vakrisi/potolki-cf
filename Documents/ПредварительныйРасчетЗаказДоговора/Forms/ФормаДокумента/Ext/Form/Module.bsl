&НаКлиенте
Функция ДобавитьСопутствующуюНоменклатуру(Номенклатура, Характеристика = Неопределено, УИСтрокиРодителя, Количество = 1, ИДкомнаты, Уровень, МассивДобавленнойСП = Неопределено)
		Если МассивДобавленнойСП = Неопределено Тогда
		МассивДобавленнойСП = Новый Массив;
	КонецЕсли;	
	Если Уровень < СтруктураДействийПоСТ.ДопустимаяГлубинаВложенностиСопутствующихТоваров Тогда
		МассивЗаписей = ОбщийМодульВызовСервера.ПолучитьСписокСопутствующихТоваров(Номенклатура, Характеристика, Количество);
		Если МассивЗаписей.Количество() > 0 Тогда
			Для Каждого Запись из МассивЗаписей Цикл
				ВозвращеннаяСтрока = ДобавитьНоменклатуруВДеревоТоваровКлиент(Запись.Номенклатура, Запись.Характеристика, Запись.Количество, УИСтрокиРодителя, ИДкомнаты);
				Если ВозвращеннаяСтрока.Новая  Тогда
					ДобавленнаяСтрока = ВозвращеннаяСтрока.Строка;
					МассивДобавленнойСП.Добавить(ДобавленнаяСтрока);
					ДобавитьСопутствующуюНоменклатуру(ДобавленнаяСтрока.Номенклатура, ДобавленнаяСтрока.ХарактеристикаНоменклатуры, ДобавленнаяСтрока.УИСтроки, ДобавленнаяСтрока.Количество, ИДкомнаты, Уровень+1, МассивДобавленнойСП);
				Иначе
					СуществующаяСтрока = ВозвращеннаяСтрока.Строка;
					ДобавитьСопутствующуюНоменклатуру(СуществующаяСтрока.Номенклатура, СуществующаяСтрока.ХарактеристикаНоменклатуры, СуществующаяСтрока.УИСТроки, СуществующаяСтрока.Количество, ИДкомнаты, Уровень+1, МассивДобавленнойСП);
				КонецЕсли;		
			КонецЦикла;	
		КонецЕсли;	
	КонецЕсли;
	Возврат МассивДобавленнойСП;
КонецФункции

//#16036
&НаСервереБезКонтекста
Функция ПолучитьСписокСопутствующихТоваров(Родитель, Характеристика = Неопределено, Количество)
	
	НаборЗаписей = РегистрыСведений.СопутствующиеТоварыИУслуги.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Номенклатура.Установить(Родитель, Истина);
	НаборЗаписей.Отбор.Характеристика.Установить(Характеристика, Истина);
	НаборЗаписей.Прочитать();
	МассивЗаписей = Новый Массив;	
	
	Для Каждого Запись из НаборЗаписей Цикл
		
		СтруктураЗаписи =  Новый Структура;
		СтруктураЗаписи.Вставить("Номенклатура", Запись.СопутствующийТовар);
		СтруктураЗаписи.Вставить("Характеристика", Запись.ХарактеристикаСопутствующегоТовара);
		Если Запись.ФиксированноеКоличество Тогда
			СтруктураЗаписи.Вставить("Количество", Запись.Количество);
		ИначеЕсли Запись.ПорядокОкругленияЧислом > 0 Тогда
			//Округляем до точности указанной в "ПорядокОкругленияЧислом" 
			РасчетноеКоличество = Запись.Количество * Количество;
			КратПоПорядкуОкругления = Окр(РасчетноеКоличество/Запись.ПорядокОкругленияЧислом, 0);
			ОкругленноеКоличество = КратПоПорядкуОкругления * Запись.ПорядокОкругленияЧислом;
			Остаток = РасчетноеКоличество - ОкругленноеКоличество;
			Если Остаток > 0 И (Остаток > Запись.ПорядокОкругленияЧислом/2 ИЛИ Запись.ОкруглятьВБольшуюСторону) Тогда
				ОкругленноеКоличество = ОкругленноеКоличество + Запись.ПорядокОкругленияЧислом;
			КонецЕсли;	
			СтруктураЗаписи.Вставить("Количество", ОкругленноеКоличество);
		Иначе
			СтруктураЗаписи.Вставить("Количество", Запись.Количество * Количество);
		КонецЕсли;
		МассивЗаписей.Добавить(СтруктураЗаписи);
		
	КонецЦикла;	
	
	Возврат МассивЗаписей;
	
КонецФункции

