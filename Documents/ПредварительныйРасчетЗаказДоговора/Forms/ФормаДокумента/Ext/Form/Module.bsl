Процедура ПредварительныйРасчет(Команда)
	
	//++ №14357 открываем по предварительному расчету а не лиду
	//ПараметрыОтчета = Новый Структура;
	//ПараметрыОтчета.Вставить("ЗаказДоговор", Объект.Основание);
	//ОткрытьФорму("Отчет.ПредварительнаяСебестоимостьЗаказДоговора.ФормаОбъекта", ПараметрыОтчета);
	
	Если Модифицированность Или Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		
		ОписаниеОповещения = новый ОписаниеОповещения("ОткрытьОтчетПредварительныйРасчетФрагмент", ЭтотОбъект);
		ПоказатьВопрос(ОписаниеОповещения, "Для продолжения документ следует записать. 
			|Записать документ?", РежимДиалогаВопрос.ДаНет);
		
	Иначе
		
		ОткрытьОтчетПредварительныйРасчетЗавершение();
		
	КонецЕсли;
	//-- №14357
	
КонецПроцедуры

