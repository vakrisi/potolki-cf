&НаСервере
Функция ДобавитьПотолокНаСервере(ДопПараметры, Номенклатура, Количество, НомерПотолка = "") //, Фактура = "", Цвет = "")
	
	Дерево = ДанныеФормыВЗначение(ДеревоТоваров, Тип("ДеревоЗначений"));
	Для Каждого Строка из Дерево.Строки Цикл
		Если Строка.Комната = ДопПараметры Тогда
			СтрокаТабличнойЧасти = Строка.Строки.Добавить();
			
			СтрокаТабличнойЧасти.Уровень = 1;
			//Если НЕ ПустаяСтрока(Номенклатура) Тогда
			СтрокаТабличнойЧасти.Номенклатура = Номенклатура;
			//Иначе
			//	СтрокаТабличнойЧасти.Номенклатура = Справочники.Номенклатура.Потолок; // #12540 удалено
			//КонецЕсли;
			СтрокаТабличнойЧасти.Комната = ДопПараметры;
			
			СтрокаТабличнойЧасти.НомерПотолка = НомерПотолка;
			//Стр.НомерПотолка = Фактура;
			//Стр.ЦветФактуры = Цвет; // #12539
			
			СтруктураДанные = Новый Структура("Номенклатура, ВидСпецификации", СтрокаТабличнойЧасти.Номенклатура, ВидСпецификацииПоУмолчанию);
			СтруктураДанные = ОбщийМодульВызовСервера.ПолучитьДанныеНоменклатурыПриИзменении(СтруктураДанные);	
			ЗаполнитьЗначенияСвойств(СтрокаТабличнойЧасти, СтруктураДанные, "ЕдиницаИзмерения, Коэффициент, ВидНоменклатуры, Спецификация, УчитыватьКакПотолок");
			
			//Стр.ЕдиницаИзмерения = ПолучитьБазовуюЕдиницуИзмеренияНоменклатуры(Стр.Номенклатура);
			//Стр.Коэффициент = 1;
			//Стр.Спецификация = ОбщийМодульСервер.ПолучитьОсновнуюСпецификациюНоменклатуры(Стр.Номенклатура, ВидСпецификацииПоУмолчанию);
			СтрокаТабличнойЧасти.Количество = Количество;
			СтрокаТабличнойЧасти.Цена = ПолучитьЦенуНоменклатуры(СтрокаТабличнойЧасти.Номенклатура, СтрокаТабличнойЧасти.ХарактеристикаНоменклатуры, СтрокаТабличнойЧасти.ЕдиницаИзмерения); //, Цвет.Владелец, Цвет);
			СтрокаТабличнойЧасти.ПроцентСкидки = ПолучитьПроцентВидаСкидки(Объект.ВидСкидки);
			СтрокаТабличнойЧасти.ЦенаПоПрайсу = СтрокаТабличнойЧасти.Цена;
			СтрокаТабличнойЧасти.УИСтроки = Новый УникальныйИдентификатор;
			РассчитатьСуммуСтрокиНаСервере(СтрокаТабличнойЧасти);
			
			ЗначениеВДанныеФормы(Дерево, ДеревоТоваров);
			Возврат СтрокаТабличнойЧасти.Номенклатура;
		КонецЕсли
	КонецЦикла;
	
КонецФункции

&НаСервере
Функция ПолучитьКоличествоПотолковВДокументе()
	Результат = 0;
	Для Каждого ТекущаяСтрока Из Объект.ТоварыУслуги Цикл
		Если ТекущаяСтрока.Номенклатура.ВидНоменклатуры = Справочники.ВидыНоменклатуры.Потолок
			или ТекущаяСтрока.Номенклатура.ВидНоменклатуры = Справочники.ВидыНоменклатуры.Отрез Тогда
			Результат = Результат + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

&НаСервере
Функция НаименованиеПотолкаСодержитНомерДоговора()
	Если Константы.ПорядокФормированияНаименованияПотолкаРозницы.Получить() = 1 Тогда
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;
КонецФункции

