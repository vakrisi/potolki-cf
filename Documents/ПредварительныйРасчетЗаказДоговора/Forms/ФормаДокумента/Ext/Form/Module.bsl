&НаСервере
Процедура УстановитьУсловноеОформление()
	
	УсловноеОформление.Элементы.Очистить();
	
	// оформление строки комнаты в дереве товаров
	Элемент = УсловноеОформление.Элементы.Добавить();

	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.ДеревоТоваров.Имя);
	
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ДеревоТоваров.Уровень");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = 0;

	Элемент.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
	//Элемент.Оформление.УстановитьЗначениеПараметра("Доступность", Ложь);
	Элемент.Оформление.УстановитьЗначениеПараметра("Шрифт", Новый Шрифт(,, Истина)); // жирным
	
	// представление вида номенклатуры "Товар"
	Элемент = УсловноеОформление.Элементы.Добавить();

	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.ДеревоТоваровВидНоменклатуры.Имя);
	
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ДеревоТоваров.ВидНоменклатуры");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Справочники.ВидыНоменклатуры.Материал;

	Элемент.Оформление.УстановитьЗначениеПараметра("Текст", "Товар");

КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьСтавкуНДСПоОрганизацииКлиент(ИзменятьСтавку = Истина)
	
	ЗаполнитьСтавкуНДСПоОрганизацииСервер();
	Если ИзменятьСтавку Тогда		
		СтрокиКомнат = ДеревоТоваров.ПолучитьЭлементы();
		Для Каждого СтрокаКомнаты из СтрокиКомнат Цикл
			СтрокиТоваров = СтрокаКомнаты.ПолучитьЭлементы();	
			Для Каждого СтрокаТовара Из СтрокиТоваров Цикл
				СтрокаТовара.СтавкаНДС = СтавкаНДСПоУмолчанию;
				ОбработкаТабличныхЧастейКлиентСервер.ПересчитатьСуммуНДСВСтрокеТЧ(СтрокаТовара, УчитыватьНДС);
			КонецЦикла;
		КонецЦикла;	
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСтавкуНДСПоОрганизацииСервер()
	
	УчитыватьНДС = УчетНДС.ОрганизацияЯвляетсяПлательщикомНДС(Объект.Организация);
	СтавкаНДСПоУмолчанию = УчетНДС.СтавкаНДСПоУмолчанию(Объект.Организация);
	
	Элементы.ДеревоТоваровСтавкаНДС.Видимость 	= УчитыватьНДС;
	Элементы.ДеревоТоваровСуммаНДС.Видимость 	= УчитыватьНДС;
	
КонецПроцедуры

//++ №14089
&НаСервере
Функция ПроверитьИспользованиеРасчетаКакОсновного(ДокументОснование)
	
	КВозврату = Истина;
	
	Если Не ЗначениеЗаполнено(ДокументОснование) Или Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Возврат КВозврату;
	КонецЕсли;
	
	Запрос = новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Лид.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.Лид КАК Лид
	|ГДЕ
	|	Лид.ОсновнойПредварительныйРасчет = &ДокументСсылка
	|";
	Запрос.УстановитьПараметр("ДокументСсылка", Объект.Ссылка);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Сообщить("Данный предварительный расчет является основным для лида: " + Выборка.Ссылка + " Предварительно следует снять отметку ""Основной"" для данного расчета в лиде.");
		
		КВозврату = Ложь;
		
	КонецЦикла;
	
	Возврат КВозврату;
	
КонецФункции
//-- №14089

&НаСервере
Функция ПолучитьДанныеНоменклатурыПриИзменении(СтруктураДанные)
	
	СтруктураДанные.Вставить("Цена", ПолучитьЦенуНоменклатуры(СтруктураДанные.Номенклатура, СтруктураДанные.ХарактеристикаНоменклатуры, СтруктураДанные.ЕдиницаИзмерения));
	СтруктураДанные.Вставить("ЦенаПоПрайсу", СтруктураДанные.Цена);
	СтруктураДанные.Вставить("СтавкаНДС", ?(УчитыватьНДС, Объект.СтавкаНДС, Перечисления.СтавкиНДС.ПустаяСсылка()));
	
	//#16345
	Если СтруктураДанные.ИспользоватьКонтрольКратности 
		И НЕ ОбщийМодульСервер.НастройкаПользователя("РазрешитьНесоответствиеКратностиЕдиницИзмерения") Тогда
		
		СтруктураПоиска = Новый Структура("ВидДокумента, ЕдиницаИзмерения", Перечисления.ВидыДокументовПроверкиКратности.ПредварительныйРасчет, СтруктураДанные.ЕдиницаИзмерения);
		НайденныеСтроки = СтруктураДанные.Номенклатура.Кратность.НайтиСтроки(СтруктураПоиска);
		Если НайденныеСтроки.Количество() > 0 Тогда		
			СтруктураДанные.Вставить("Количество", 0); //#16345
		Иначе
			СтруктураДанные.Вставить("Количество", СтруктураДанные.Количество);
		КонецЕсли;
	Иначе
		СтруктураДанные.Вставить("Количество", СтруктураДанные.Количество);
	КонецЕсли;
	
	СтруктураДанные.Вставить("ПроцентСкидки", ПолучитьПроцентСкидки(СтруктураДанные.ИспользоватьАвтоматическиеСкидки, СтруктураДанные.ВидСкидки, СтруктураДанные.Дата, СтруктураДанные.Номенклатура, СтруктураДанные.Количество));
	
	Возврат СтруктураДанные;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьПроцентСкидки(ИспользоватьАвтоматическиеСкидки, ВидСкидки, Дата, Номенклатура, Количество)
	Возврат ПолучитьПроцентВидаСкидки(ВидСкидки) + ПолучитьПроцентАвтоматическойСкидкиСервер(ИспользоватьАвтоматическиеСкидки, Дата, Номенклатура, Количество);
КонецФункции

&НаКлиенте
Функция СтруктураДанныхПоСтрокеТабличнойЧасти(СтрокаТабличнойЧасти)
	
	СтруктураДанные = Новый Структура;
	СтруктураДанные.Вставить("ИмяТаблицы",						"ТоварыУслуги");                          
	//СтруктураДанные.Вставить("НомерСтроки",			СтрокаТабличнойЧасти.НомерСтроки);  
	СтруктураДанные.Вставить("ВидСпецификации",					ВидСпецификацииПоУмолчанию); 	
	СтруктураДанные.Вставить("Номенклатура",					СтрокаТабличнойЧасти.Номенклатура);
	СтруктураДанные.Вставить("ХарактеристикаНоменклатуры", 		СтрокаТабличнойЧасти.ХарактеристикаНоменклатуры);
	СтруктураДанные.Вставить("ЕдиницаИзмерения", 				СтрокаТабличнойЧасти.ЕдиницаИзмерения);
	СтруктураДанные.Вставить("Количество", 						СтрокаТабличнойЧасти.Количество);
	СтруктураДанные.Вставить("Дата", 							Объект.Дата);
	//СтруктураДанные.Вставить("ВидЦен", 				Объект.ВидЦен);
