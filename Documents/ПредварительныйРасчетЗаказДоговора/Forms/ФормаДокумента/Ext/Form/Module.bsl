&НаСервере
Процедура ПеренестиДеревоВТабличнуюЧасть()
	
	//ТОВАРЫ И УСЛУГИ
	СуммаДокумента = 0;
	Объект.ТоварыУслуги.Очистить();
	Дерево = ДанныеФормыВЗначение(ДеревоТоваров, Тип("ДеревоЗначений"));
	Для Каждого Строка из Дерево.Строки Цикл
		Для Каждого СтрНоменклатура из Строка.Строки Цикл
			Если НЕ СтрНоменклатура.Номенклатура.Пустая() Тогда
				Стр = Объект.ТоварыУслуги.Добавить();
				ЗаполнитьЗначенияСвойств(Стр, СтрНоменклатура);
				СуммаДокумента = СуммаДокумента + СтрНоменклатура.Сумма;
				Стр.СуммаПоПрайсу = Стр.ЦенаПоПрайсу * Стр.Количество;
			КонецЕсли;
		КонецЦикла;	
	КонецЦикла;
	Объект.СуммаДокумента = СуммаДокумента;
	
	ПересчитатьСуммуДокументаНаСервере();
	
	КомнатыТоваров = Объект.ТоварыУслуги.Выгрузить(); //нужна для отслеживания удаленных комнат в товарах
	КомнатыТоваров.Свернуть("Комната");
	
	//МАТЕРИАЛЫ
	Объект.Материалы.Очистить();
	Дерево = ДанныеФормыВЗначение(ДеревоМатериалов, Тип("ДеревоЗначений"));
	Для Каждого Строка из Дерево.Строки Цикл
		НайденнаяКомната = КомнатыТоваров.Найти(Строка.Комната, "Комната");
		Если НЕ НайденнаяКомната = Неопределено Тогда //переносим данные только по тем комнатам, что есть в товарах
			Стр = Объект.Материалы.Добавить();
			Стр.Комната = Строка.Комната;
			Для Каждого СтрНоменклатура из Строка.Строки Цикл
				Если НЕ СтрНоменклатура.Номенклатура.Пустая() Тогда
					Стр = Объект.Материалы.Добавить();
					ЗаполнитьЗначенияСвойств(Стр, СтрНоменклатура);
				КонецЕсли;
			КонецЦикла;	
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ПерестроитьДеревоНаФорме()
	
	//ТОВАРЫ И УСЛУГИ
	//ключ строки дерева: комната
	//Объект.ТоварыУслуги.Сортировать("Комната Возр");
	Комната = Неопределено;
	Дерево = ДанныеФормыВЗначение(ДеревоТоваров, Тип("ДеревоЗначений"));
	Дерево.Строки.Очистить();
	Для Каждого Стр из Объект.ТоварыУслуги Цикл
		Если Стр.Комната <> Комната Тогда
			СтрДерево = Дерево.Строки.Добавить();
			СтрДерево.Комната = Стр.Комната;
			Комната = Стр.Комната;
		КонецЕсли;
		Если НЕ Стр.Номенклатура.Пустая() Тогда
			СтрДеревоВид = СтрДерево.Строки.Добавить();
			СтрДеревоВид.Уровень = 1;
			ЗаполнитьЗначенияСвойств(СтрДеревоВид, Стр);
			СтрДеревоВид.ВидНоменклатуры = Стр.Номенклатура.ВидНоменклатуры;
			СтрДеревоВид.УчитыватьКакПотолок = Стр.Номенклатура.УчитыватьКакПотолокВОтчетахПоЭффективности; // №14690
			Если ПустаяСтрока(Стр.УИСтроки) Тогда
				//по какой-то причине УИ пустой - заполним
				Стр.УИСтроки = Новый УникальныйИдентификатор;
				СтрДерево.УИСтроки = Стр.УИСтроки;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	ЗначениеВДанныеФормы(Дерево, ДеревоТоваров);
	
	//МАТЕРИАЛЫ
	Комната = "";
	Дерево = ДанныеФормыВЗначение(ДеревоМатериалов, Тип("ДеревоЗначений"));
	Дерево.Строки.Очистить();
	Для Каждого Стр из Объект.Материалы Цикл
		Если Стр.Комната <> Комната Тогда
			СтрДерево = Дерево.Строки.Добавить();
			СтрДерево.Комната = Стр.Комната;
			Комната = Стр.Комната;
		КонецЕсли;
		Если НЕ Стр.Номенклатура.Пустая() Тогда
			СтрДеревоВид = СтрДерево.Строки.Добавить();
			СтрДеревоВид.Уровень = 1;
			ЗаполнитьЗначенияСвойств(СтрДеревоВид, Стр);
			Если ПустаяСтрока(Стр.УИСтроки) Тогда
				//по какой-то причине УИ пустой - заполним
				Стр.УИСтроки = Новый УникальныйИдентификатор;
				СтрДерево.УИСтроки = Стр.УИСтроки;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	ЗначениеВДанныеФормы(Дерево, ДеревоМатериалов);
	
КонецПроцедуры

