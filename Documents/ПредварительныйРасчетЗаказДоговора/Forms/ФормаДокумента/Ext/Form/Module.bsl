
&НаСервере
Перем ТекстФайлIni;

&НаКлиенте
Перем ПредыдущееОснование; // №14089

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	УстановитьУсловноеОформление();
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	// СтандартныеПодсистемы.Свойства
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ИмяЭлементаДляРазмещения", "ГруппаДополнительныеРеквизиты");
	ДополнительныеПараметры.Вставить("ОтложеннаяИнициализация", Ложь);
	УправлениеСвойствами.ПриСозданииНаСервере(ЭтотОбъект, ДополнительныеПараметры);
	// Конец СтандартныеПодсистемы.Свойства
	
	ИспользоватьАвтоматическиеСкидки = Константы.ИспользоватьАвтоматическиеСкидки.Получить();
	ИспользоватьКонтрольКратности = ПолучитьФункциональнуюОпцию("ИспользоватьКонтрольКратностиЕдиницИзмерения");
	
	Если Параметры.Ключ.Пустая() Тогда
		ПриСозданииЧтенииНаСервере();
		
	ИначеЕсли НЕ ЭтаФорма.ТолькоПросмотр Тогда
		ЭтаФорма.ТолькоПросмотр = ПраваПользователей.ДокументТолькоПросмотр(Объект.Ссылка);
	КонецЕсли;
	
	// управление доступностью элементов
	ПраваПользователей.УстановитьТолькоПросмотрДляРеквизитаНомер(Элементы.Номер.ТолькоПросмотр);
	
	РеквизитыПользователя = ОбщийМодульСервер.НастройкиПользователя("ДополнительныеПраваЗапретРедактированияЦенВДокументах, ДополнительныеПраваЗапретПримененияСкидок");
	
	Если РеквизитыПользователя.ДополнительныеПраваЗапретРедактированияЦенВДокументах Тогда
		
		МассивИменЭлементов = Документы.ПредварительныйРасчетЗаказДоговора.ПолучитьМассивРеквизитовПоЦенам();
		ОбщийМодульКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы, МассивИменЭлементов, "ТолькоПросмотр", Истина);
		
	КонецЕсли;
	
	//#7771
	Если РеквизитыПользователя.ДополнительныеПраваЗапретПримененияСкидок Тогда
		
		МассивИменЭлементов = Документы.ПредварительныйРасчетЗаказДоговора.ПолучитьМассивРеквизитовПоСкидкам();
		ОбщийМодульКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы, МассивИменЭлементов, "ТолькоПросмотр", Истина);
		
	КонецЕсли;
	
	Элементы.ПодменюПечать.Доступность = ПраваПользователей.ДоступностьПечати(Объект.Ссылка);
	
	ПереключательНаНазваниеКомнат = Константы.ИспользоватьСправочникКомнатВРознице.Получить();
	
	СофтФонСервер.ПриСозданииНаСервере(ЭтотОбъект);
	МессенджерыСервер.ПриСозданииНаСервере(ЭтотОбъект, Элементы.ГруппаКонтрагентКПМессенджеры);
	
	ОбщийМодульСервер.ДополнительнаяИнформацияПоКонтрагентуНаФорме(Объект.Контрагент, Элементы.ПоказатьДополнительнуюИнформацию);
	ОбщийМодульСервер.РегулировкаШириныПоляКонтрагента(Элементы, Элементы.Контрагент, Элементы.ПоказатьДополнительнуюИнформацию, , 36);
	
	// Видимость колонки Артикул
	МассивЭлементов = новый Массив();
	МассивЭлементов.Добавить("ДеревоТоваровНоменклатураАртикул");
	МассивЭлементов.Добавить("ДеревоМатериаловНоменклатураАртикул");
	МассивЭлементов.Добавить("ВыработкаНоменклатураАртикул");
	МассивЭлементов.Добавить("ОбъектВыработкаНоменклатураАртикул");
	МассивЭлементов.Добавить("ВыработкаПлановаяНоменклатураАртикул");
	ОбщийМодульСервер.УстановитьВидимостьКолонкиАртикулВТабличнойЧасти(ЭтаФорма, МассивЭлементов);
	
	ЗаполнитьСтавкуНДСПоОрганизацииСервер();
	
	//Если Объект.ТоварыУслуги.Количество() = 0 Тогда
	//	
	//	// добавим первую комнату
	//	НоваяСтрока = Объект.ТоварыУслуги.Добавить();
	//	НоваяСтрока.Комната = "Комната 1";
	//	
	//КонецЕсли;
	
	// проверим и перезаполним комнаты в материалах, если их там нет
	Если Объект.Материалы.Количество() = 0 Тогда
		
		ВременнаяТаблица = Объект.ТоварыУслуги.Выгрузить();
		ВременнаяТаблица.Свернуть("Комната");
		
		Для Каждого ТекущаяСтрока Из ВременнаяТаблица Цикл
			
			Если НЕ ПустаяСтрока(ТекущаяСтрока.Комната) Тогда
				НоваяСтрока = Объект.Материалы.Добавить();
				НоваяСтрока.Комната = ТекущаяСтрока.Комната;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	СтруктураДействийПоСТ = СопутствующиеТоварыСервер.СтруктураДействийПоСопутствующимТоварамВРознице();
	
	//++15925
	СтруктураСпособовДобавленияПродукции = ОбщийМодульСервер.СтруктураСпособовДобавленияПродукции();
	Элементы.ДеревоТоваровЗагрузитьПотолокИзEasyCeiling.Видимость = СтруктураСпособовДобавленияПродукции.СпособДобавленияПродукцииЗагрузитьИзПостроителя; 
	Элементы.ДеревоТоваровДобавитьУстановкуПотолка.Видимость = СтруктураСпособовДобавленияПродукции.СпособДобавленияПродукцииВыбратьПотолок;
	Элементы.ДеревоТоваровДобавитьПотолок.Видимость = СтруктураСпособовДобавленияПродукции.СпособДобавленияПродукцииСоздатьПотолок;
	Элементы.ДеревоТоваровДобавитьПродукцию.Видимость = СтруктураСпособовДобавленияПродукции.СпособДобавленияПродукцииСоздатьПродукцию;
	Элементы.ДеревоТоваровДобавитьКонструкцию.Видимость = СтруктураСпособовДобавленияПродукции.СпособДобавленияПродукцииСоздатьКонструкцию;
	//--15925
	
	// построим дерево
	ПерестроитьДеревоНаФорме();
	
	Если РольДоступна("ОтчетПредварительнаяСебестоимостьЗаказДоговораПросмотр") 
		или РольДоступна("АдминистраторСистемы") 
		или РольДоступна("ПолныеПрава") Тогда
		Элементы.ПредварительныйРасчет.Видимость = Истина;
	Иначе
		Элементы.ПредварительныйРасчет.Видимость = Ложь;
	КонецЕсли;
	
	ОбновитьДопИнформацию();
	
	ФинансыСервер.ОбновитьВидимостьИКурсВалюты(ЭтотОбъект);
	
	ВидСпецификацииПоУмолчанию = Перечисления.ВидыСпецификации.СопутствующиеМатериалы;
	
	ОбщийМодульСервер.УстановитьВидимостьПодразделения(ЭтотОбъект);
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	ДатыЗапретаИзменения.ОбъектПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	
	// СтандартныеПодсистемы.Свойства
	УправлениеСвойствами.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	// Конец СтандартныеПодсистемы.Свойства
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды

	ПриСозданииЧтенииНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ПриСозданииЧтенииНаСервере()
	
	ЗаполнитьСтавкуНДСПоОрганизацииСервер();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	// СтандартныеПодсистемы.Свойства
    УправлениеСвойствамиКлиент.ПослеЗагрузкиДополнительныхРеквизитов(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.Свойства

	ОбновитьЭлементыФормы();
	
	РассчитатьИтоговыеПоказателиКлиент(ТолькоПросмотр);
	
	ПредыдущееОснование = Объект.Основание; // №14089
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	ПеренестиДеревоВТабличнуюЧасть();
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	// СтандартныеПодсистемы.Свойства
	УправлениеСвойствами.ПередЗаписьюНаСервере(ЭтотОбъект, ТекущийОбъект);
	// Конец СтандартныеПодсистемы.Свойства
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	
	// СтандартныеПодсистемы.Свойства
	УправлениеСвойствами.ОбработкаПроверкиЗаполнения(ЭтотОбъект, Отказ, ПроверяемыеРеквизиты);
	// Конец СтандартныеПодсистемы.Свойства
	
	//#16345
	Если ИспользоватьКонтрольКратности Тогда
		ОбщийМодульСервер.ПроверитьКратностьЕдиницИзмерения(Отказ, Объект, Перечисления.ВидыДокументовПроверкиКратности.ПредварительныйРасчет);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	Элементы.ПодменюПечать.Доступность = ПраваПользователей.ДоступностьПечати(Объект.Ссылка);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	Оповестить("СозданПредварительныйРасчет", Объект.Основание);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	// СтандартныеПодсистемы.Свойства 
	Если УправлениеСвойствамиКлиент.ОбрабатыватьОповещения(ЭтотОбъект, ИмяСобытия, Параметр) Тогда
		ОбновитьЭлементыДополнительныхРеквизитов();
		УправлениеСвойствамиКлиент.ПослеЗагрузкиДополнительныхРеквизитов(ЭтотОбъект);
	КонецЕсли;
	// Конец СтандартныеПодсистемы.Свойства
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	
	Если ИсточникВыбора.ИмяФормы = "ОбщаяФорма.ФормаПодбораНоменклатуры" Тогда
		Если НЕ ПодборВМатериалы Тогда
			ОбработкаВыбораПодборНаКлиенте(ВыбранноеЗначение, "Подбор");
		Иначе
			ПодборВМатериалы = Ложь;
			ОбработкаВыбораПодборМатериаловНаКлиенте(ВыбранноеЗначение);
		КонецЕсли;
		
	ИначеЕсли ИсточникВыбора.ИмяФормы = "Справочник.ШаблоныКомнатДляЗаказДоговора.Форма.ФормаПодбора" Тогда	
		ОповещениеЗаполнитьКомнатуПоШаблонуЗавершение = Новый ОписаниеОповещения("ЗаполнитьКомнатуПоШаблонуЗавершение", ЭтотОбъект);
		ОбщийМодульКлиент.Розница_ОбработкаВыбораЗаполненияПоШаблону(ЭтотОбъект, ОповещениеЗаполнитьКомнатуПоШаблонуЗавершение, ВыбранноеЗначение);
		
	// #10992
	ИначеЕсли ИсточникВыбора.ИмяФормы = "Справочник.НазваниеКомнат.Форма.ФормаВыбора" И ТипЗнч(ВыбранноеЗначение) = Тип("Структура") Тогда
		//ДобавитьКомнатуЗавершение(ВыбранноеЗначение);
		ОбщийМодульКлиент.Розница_ДобавитьКомнатуЗавершение(Новый Структура("Форма", ЭтаФорма), ВыбранноеЗначение);
		
	ИначеЕсли ТипЗнч(ВыбранноеЗначение) = Тип("СправочникСсылка.Контрагенты") Тогда
		Объект.Контрагент = ВыбранноеЗначение;
		КонтрагентПриИзменении(Неопределено);
		
	ИначеЕсли ИсточникВыбора.ИмяФормы = "РегистрСведений.СопутствующиеТоварыИУслуги.Форма.ФормаПодбора" Тогда	
		
		//Удаляем сопутствующие товары для текущей номенклатуры без подтверждения
		МассивСопутствующихТоваровНаУдаление = ОбщийМодульКлиент.ПолучитьСвязанныеСопутствующиеТоварыПоВыделеннымСтрокам(Элементы.ДеревоТоваров, ДеревоТоваров);
		ОбщийМодульКлиент.УдалитьСопутствующиеТовары(ДеревоТоваров, МассивСопутствующихТоваровНаУдаление);
	
		ОбработкаВыбораПодборНаКлиенте(ВыбранноеЗначение, "ДобавлениеСопутки", Истина);
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

