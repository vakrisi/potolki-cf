&НаКлиенте
Процедура ЗагрузитьПотолокИзПостроителяЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Модифицированность = Истина;
	
	ПерестроитьДеревоНаФорме();
	
	//ЗаполнитьДанныеКОтгрузкеИОстаткиПоТоварам();
	Если ТипЗнч(Результат) = Тип("СправочникСсылка.Номенклатура") Тогда
		РазвернутьДеревоТоваров(ДополнительныеПараметры.ТекущаяКомната, Результат);
		//РассчитатьИтоговыеПоказателиКлиент();
		ДобавленнаяСтрока = НайтиСтрокуДерева(ДеревоТоваров, ДополнительныеПараметры.ТекущаяКомната, Результат);
		Если НЕ ДобавленнаяСтрока = Неопределено Тогда
			Элементы.ДеревоТоваров.ТекущаяСтрока = ДобавленнаяСтрока.ПолучитьИдентификатор();
		КонецЕсли;
		
		//Оповестить("ОбновитьСписокФайлов", Результат);
	КонецЕсли;
		
	ПоказатьОповещениеПользователя("Данные загружены");
		
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьПродукцию(Команда)
	
	//ВМатериалы = (СтрНайти(Команда.Имя, "ВМатериалы") > 0);
	
	ТекущиеДанные = Элементы.ДеревоТоваров.ТекущиеДанные;	
	//Если ВМатериалы Тогда
	//	ТекущиеДанные = Элементы.ДеревоМатериалов.ТекущиеДанные;
	//КонецЕсли;
	
	Если НЕ ОбщийМодульКлиент.Розница_КомнатаЗаполнена(ТекущиеДанные) Тогда
		ПоказатьОповещениеПользователя("Выберите комнату");
		Возврат;
	КонецЕсли;	
		
	СтруктураПараметров = Новый Структура;	
	ОписаниеОповещения = Новый ОписаниеОповещения("ПослеВводаДанныхПродукцииПоВиду", ЭтотОбъект);
	ОткрытьФорму("ОбщаяФорма.ФормаДобавленияПродукцииПоВиду", СтруктураПараметров, ЭтотОбъект,,,, ОписаниеОповещения);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВводаДанныхПродукцииПоВиду(СтруктураОтвета, ДополнительныеПараметры) Экспорт
	
	Если СтруктураОтвета = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Модифицированность = Истина;
	
	ТекущиеДанные = Элементы.ДеревоТоваров.ТекущиеДанные;	
	ТекущаяКомната = ТекущиеДанные.Комната;
	
	УИСтроки = Новый УникальныйИдентификатор;
	СтруктураОтвета.Вставить("УИСтроки", УИСтроки);
	ВидЗаказа = ПредопределенноеЗначение("Перечисление.ВидыЗаказов.ЗаказДоговор");
	
	СтрокаКомнаты = ТекущиеДанные;
	Если НЕ ТекущиеДанные.ПолучитьРодителя() = Неопределено Тогда	
		СтрокаКомнаты = ТекущиеДанные.ПолучитьРодителя();
	КонецЕсли;
	
	ИдКомнаты = СтрокаКомнаты.ПолучитьИдентификатор();
	
	ДополнительныеПараметрыДобавления = Новый Структура("Комната, Количество", ТекущаяКомната, СтруктураОтвета.Количество);
	
	// №13814
	ОбщийМодульКлиент.РасширеннаяОбработкаДобавленнойПродукции(ЭтаФорма, ВидЗаказа, Ложь, ТекущаяКомната, СтруктураОтвета, Истина);
	
	ПослеВыбораНоменклатуры(СтруктураОтвета, ИдКомнаты);
			
КонецПроцедуры

&НаКлиенте
Функция ПараметрыПодбора()
	
	ПараметрыПодбора = Новый Структура;
	ПараметрыПодбора.Вставить("Дата",				Объект.Дата);
	ПараметрыПодбора.Вставить("Организация",		Объект.Организация);
	ПараметрыПодбора.Вставить("ВидЦены",			Объект.ВидЦен);
	ПараметрыПодбора.Вставить("Валюта",				Объект.Валюта);
	ПараметрыПодбора.Вставить("ТипДокумента",		"ПредварительныйРасчет");
	Если НЕ ПодборВМатериалы Тогда
		ПараметрыПодбора.Вставить("Склад",				ПолучитьСкладТоваровПользователяПоУмолчанию()); 		
		//#16345
		Если ИспользоватьКонтрольКратности Тогда
			ПараметрыПодбора.Вставить("ВидДокументаПроверкиКратности",ПредопределенноеЗначение("Перечисление.ВидыДокументовПроверкиКратности.ПредварительныйРасчет")); 
		КонецЕсли;
	Иначе
		ПараметрыПодбора.Вставить("Склад",				ПолучитьСкладМатериаловПользователяПоУмолчанию());
		ПараметрыПодбора.Вставить("НеЗапрашиватьЦену",  Истина);
	КонецЕсли;	
	Возврат ПараметрыПодбора;
	
КонецФункции
	
&НаКлиенте
Процедура ПодобратьНоменклатуру(Команда)
	
	ТекущиеДанные = Элементы.ДеревоТоваров.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		ПоказатьОповещениеПользователя("Выберите комнату");
		Возврат;
	КонецЕсли;	
	
	Если ПустаяСтрока(ТекущиеДанные.Комната) Тогда		
		ПоказатьОповещениеПользователя("Выберите комнату");
		Возврат;
	КонецЕсли;
	
	ПараметрыПодбора = ПараметрыПодбора();
	ОткрытьФорму("ОбщаяФорма.ФормаПодбораНоменклатуры", ПараметрыПодбора, ЭтаФорма, УникальныйИдентификатор);
	
КонецПроцедуры

// вызывается:
// - по ОбработкаВыбора из формы подбора                      ИсточникВызова = "Подбор"
// - по ЗаполнитьКомнатуПоШаблонуЗавершение                                    "ЗаполнениеПоШаблону"
// - по ОбработкаВыбора из формы СопутствующиеТоварыИУслуги                    "ДобавлениеСопутки"
&НаКлиенте
Процедура ОбработкаВыбораПодборНаКлиенте(ВыбранноеЗначение, ИсточникВызова, ПерезаполнятьЦены = Ложь)

	Если Не ЗначениеЗаполнено(ВыбранноеЗначение) Тогда
		Возврат;
	КонецЕсли;
	
	ТекущаяСтрока = Элементы.ДеревоТоваров.ТекущиеДанные;
	ТекущаяКомната = ТекущаяСтрока.Комната;

	ОбработатьПодборНаСервере(ВыбранноеЗначение, ТекущаяКомната, ИсточникВызова, ПерезаполнятьЦены);
	
	ПеренестиДеревоВТабличнуюЧасть();
	РазвернутьДеревоТоваров();
	ОбновитьЭлементыФормы(ТекущаяКомната, Неопределено);

КонецПроцедуры

&НаСервере
Процедура ОбработатьПодборНаСервере(ВыбранноеЗначение, ИмяТекущейКомнаты, ИсточникВызова, ПерезаполнятьЦены)
	
	ТаблицаТоваров = ПолучитьИзВременногоХранилища(ВыбранноеЗначение.АдресВХранилище);
	
	Дерево = ДанныеФормыВЗначение(ДеревоТоваров, Тип("ДеревоЗначений"));
	СтрокиКомнат = Дерево.Строки;
	
	СтрокаКомнаты = СтрокиКомнат.Найти(ИмяТекущейКомнаты, "Комната", Ложь);
	
	УИСтрокиПодбора = Неопределено;
	
	//Для Каждого Строка из Дерево.Строки Цикл
	Для Каждого ТекущаяСтрока из ТаблицаТоваров Цикл
		Если ИсточникВызова = "ДобавлениеСопутки" Тогда
			// комнату определяем на каждом шаге, так как могла выделить разные позиции разных комнат
			СтрокаРодителяСТ = СтрокиКомнат.Найти(ТекущаяСтрока.УИСтрокиРодителя, "УИСтроки", Истина);
			СтрокаКомнаты = СтрокаРодителяСТ.Родитель;
			
			Если НЕ ТекущаяСтрока.УИСтрокиПодбора = УИСтрокиПодбора Тогда
				УИСтрокиПодбора = ТекущаяСтрока.УИСтрокиПодбора;
				ИндексСтроки = СтрокаКомнаты.Строки.Индекс(СтрокаРодителяСТ) + 1;
			Иначе
				ИндексСтроки = ИндексСтроки + 1;
			КонецЕсли;			
		КонецЕсли;
		
		СтрокиПозиций = СтрокаКомнаты.Строки;
		
		Если ИсточникВызова = "ДобавлениеСопутки" Тогда
			СтрокаТабличнойЧасти = СтрокиПозиций.Вставить(ИндексСтроки);
		Иначе
			СтрокаТабличнойЧасти = СтрокиПозиций.Добавить();			
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(СтрокаТабличнойЧасти, ТекущаяСтрока);
		СтрокаТабличнойЧасти.Комната = СтрокаКомнаты.Комната;
		
		СтрокаТабличнойЧасти.Уровень = 1;
		
		СтруктураДанные = СтруктураДанныхПоСтрокеТабличнойЧастиСервер(СтрокаТабличнойЧасти);
		СтруктураДанные = ОбщийМодульВызовСервера.ПолучитьДанныеНоменклатурыПриИзменении(СтруктураДанные);	
		ЗаполнитьЗначенияСвойств(СтрокаТабличнойЧасти, СтруктураДанные, "ВидНоменклатуры, Спецификация, УчитыватьКакПотолок");
		
		СтруктураДанные = ПолучитьДанныеНоменклатурыПриИзменении(СтруктураДанные);
		
		Если ИсточникВызова = "Подбор" ИЛИ ИсточникВызова = "ДобавлениеСопутки" Тогда
			ЗаполнитьЗначенияСвойств(СтрокаТабличнойЧасти, СтруктураДанные, "ЦенаПоПрайсу, ПроцентСкидки");
		Иначе
			ЗаполнитьЗначенияСвойств(СтрокаТабличнойЧасти, СтруктураДанные, "ЦенаПоПрайсу, ПроцентСкидки, Количество"); //#16345 добавлено количество
		КонецЕсли;		
		Если ПерезаполнятьЦены Тогда
			СтрокаТабличнойЧасти.Цена = СтруктураДанные.Цена;
		КонецЕсли;
		
		РассчитатьСуммуСтрокиНаСервере(СтрокаТабличнойЧасти);
		
		Если ПустаяСтрока(СтрокаТабличнойЧасти.УИСтроки) Тогда
			// при подборе сопутствующих уже заполнено
			СтрокаТабличнойЧасти.УИСтроки = Новый УникальныйИдентификатор;
		КонецЕсли;
		
	КонецЦикла;
	
	ЗначениеВДанныеФормы(Дерево, ДеревоТоваров);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьКомнатуПоШаблону(Команда)
		
	ОбщийМодульКлиент.Розница_ЗаполнитьКомнатуПоШаблону(ЭтотОбъект, Ложь);
	
КонецПроцедуры

