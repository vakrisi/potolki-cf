Процедура РазвернутьДеревоМатериалов(Комната = Неопределено, Номенклатура = Неопределено)
	ИдТекущейСтроки = Неопределено;
	КоллекцияЭлементовДерева = ЭтаФорма.ДеревоМатериалов.ПолучитьЭлементы();
    Для Каждого Строка Из КоллекцияЭлементовДерева Цикл    
        ИдентификаторСтроки = Строка.ПолучитьИдентификатор();
		Если Строка.Комната = Комната И Строка.Номенклатура = Номенклатура Тогда
			ИдТекущейСтроки = ИдентификаторСтроки;
		КонецЕсли;
        Элементы.ДеревоМатериалов.Развернуть(ИдентификаторСтроки, Истина);
	КонецЦикла;
	Элементы.ДеревоМатериалов.ТекущаяСтрока = ИдТекущейСтроки;
КонецПроцедуры

