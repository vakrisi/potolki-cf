&НаКлиенте
Процедура ОткрытьОтчетПредварительныйРасчетФрагмент(Результат, ДопПараметры) Экспорт
	
	Если НЕ Результат = КодВозвратаДиалога.Да Тогда
		Возврат;	
	КонецЕсли;
	
	ОчиститьСообщения();
	
	Если Записать(новый Структура("РежимЗаписи", РежимЗаписиДокумента.Запись)) Тогда
		ОткрытьОтчетПредварительныйРасчетЗавершение();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьОтчетПредварительныйРасчетЗавершение()
	
	ПараметрыОтчета = Новый Структура;
	ПараметрыОтчета.Вставить("ЗаказДоговор", Объект.Ссылка);
	
	ОткрытьФорму("Отчет.ПредварительнаяСебестоимостьЗаказДоговора.ФормаОбъекта", ПараметрыОтчета);
	
КонецПроцедуры
