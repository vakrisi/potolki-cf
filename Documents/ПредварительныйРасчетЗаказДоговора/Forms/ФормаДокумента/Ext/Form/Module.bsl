&НаКлиенте
Процедура ДеревоТоваровПередУдалением(Элемент, Отказ)
	
	Для Каждого ВыделеннаяСтрока Из Элементы.ДеревоТоваров.ВыделенныеСтроки Цикл
		ТекущиеДанные = ДеревоТоваров.НайтиПоИдентификатору(ВыделеннаяСтрока);
		Если ТекущиеДанные.ПолучитьЭлементы().Количество() > 0 Тогда
			//не даем удалить саму комнату, иначе нижние проверки не сработают
			Отказ = Истина;
			Возврат;
		КонецЕсли;
	КонецЦикла;
	
	Если НЕ Отказ И СтруктураДействийПоСТ.АвтоматическиДобавлятьСопутствующиеТоварыИУслуги Тогда
		МассивСопутствующихТоваровНаУдаление = ОбщийМодульКлиент.ПолучитьСвязанныеСопутствующиеТоварыПоВыделеннымСтрокам(Элементы.ДеревоТоваров, ДеревоТоваров);
		Если МассивСопутствующихТоваровНаУдаление.Количество() > 0 Тогда 		
			Если СтруктураДействийПоСТ.ЗапрашиватьПодтверждениеПриУдаленииНоменклатуры Тогда
				ДопПараметры = Новый Структура("МассивСопутствующихТоваровНаУдаление", МассивСопутствующихТоваровНаУдаление);
				Если ЗначениеЗаполнено(ТекущиеДанные.ХарактеристикаНоменклатуры) Тогда
					ДляВопросаОНоменклатуре = ", характеристика: """ + ТекущиеДанные.ХарактеристикаНоменклатуры + """";
				Иначе
					ДляВопросаОНоменклатуре = "";
				КонецЕсли;
				ПоказатьВопрос(Новый ОписаниеОповещения("ВопросУдалениеСопутствующейНоменклатуры", ЭтотОбъект, ДопПараметры), "Удалить сопутствующие товары и услуги для номенклатуры: """ + ТекущиеДанные.Номенклатура + """" + ДляВопросаОНоменклатуре + "?", РежимДиалогаВопрос.ДаНет);			
			Иначе
				ОбщийМодульКлиент.УдалитьСопутствующиеТовары(ДеревоТоваров, МассивСопутствующихТоваровНаУдаление);
				МассивСопутствующихТоваровНаУдаление.Очистить();
				РассчитатьИтоговыеПоказателиКлиент();
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ВопросУдалениеСопутствующейНоменклатуры(РезультатВопроса, ДополнительныеПараметры) Экспорт	
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		ОбщийМодульКлиент.УдалитьСопутствующиеТовары(ДеревоТоваров, ДополнительныеПараметры.МассивСопутствующихТоваровНаУдаление);
		РассчитатьИтоговыеПоказателиКлиент();
	КонецЕсли;
	Если ДополнительныеПараметры.Свойство("СтрокаТабличнойЧасти") Тогда
		    Элементы.ДеревоТоваров.ТекущаяСтрока = ДополнительныеПараметры.СтрокаТабличнойЧасти.ПолучитьИдентификатор();
			ДеревоТоваровНоменклатураПриИзменении(ДополнительныеПараметры.СтрокаТабличнойЧасти);
	КонецЕсли;	
	Если ДополнительныеПараметры.Свойство("СтрокаХарактеристикиТабличнойЧасти") Тогда
		    Элементы.ДеревоТоваров.ТекущаяСтрока = ДополнительныеПараметры.СтрокаХарактеристикиТабличнойЧасти.ПолучитьИдентификатор();
			ДеревоТоваровХарактеристикаНоменклатурыПриИзменении(ДополнительныеПараметры.СтрокаХарактеристикиТабличнойЧасти);
	КонецЕсли;	
КонецПроцедуры

