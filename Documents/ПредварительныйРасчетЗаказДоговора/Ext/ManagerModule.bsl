			КонецЦикла;
		КонецЕсли;
		
		//подвал
		Попытка
			ОбластьМакета = Макет.ПолучитьОбласть("Подвал");
			ОбластьМакета.Параметры.Заполнить(ДанныеПечати);
			Если ЕстьСкидка Тогда
				Попытка
					ОбластьМакета.Параметры.ШаблонСуммаСкидки = "Скидка: " + Формат(ДанныеПечати.СуммаСкидки, "ЧДЦ=2") + " " + Строка(ДанныеПечати.Валюта);				
					ОбластьМакета.Параметры.ШаблонСуммаБезСкидки = "Сумма без скидки: " + Формат(ДанныеПечати.СуммаБезСкидки, "ЧДЦ=2") + " " + Строка(ДанныеПечати.Валюта);				
				Исключение
				КонецПопытки;
			КонецЕсли;	
			ТабличныйДокумент.Вывести(ОбластьМакета);
		Исключение
		КонецПопытки;
		
        // В табличном документе необходимо задать имя области, в которую был 
        // выведен объект. Нужно для возможности печати комплектов документов.
        УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабличныйДокумент, 
            НомерСтрокиНачало, ОбъектыПечати, ДанныеПечати.Ссылка);
    КонецЦикла;
	
	Возврат ТабличныйДокумент;
	
КонецФункции

#КонецОбласти

#Область Прочее

