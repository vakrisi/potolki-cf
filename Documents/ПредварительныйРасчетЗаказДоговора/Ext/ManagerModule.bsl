								ОбластьМакета.Параметры.НомерСтроки = НомерСтроки;
								ТабличныйДокумент.Вывести(ОбластьМакета);
								
								Если ВыводитьАртикул Тогда
									ОбластьМакета = Макет.ПолучитьОбласть("СтрокаНоменклатура"+ВставкаСкидок+"|Артикул");
									ОбластьМакета.Параметры.Заполнить(ДанныеПечати); 
									ОбластьМакета.Параметры.Заполнить(ВыборкаПоТоварам);
									ТабличныйДокумент.Присоединить(ОбластьМакета);
								КонецЕсли;
								
								ОбластьМакета = Макет.ПолучитьОбласть("СтрокаНоменклатура"+ВставкаСкидок+"|Данные");
								ОбластьМакета.Параметры.Заполнить(ДанныеПечати); 
