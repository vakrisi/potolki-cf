	|	СУММА(ПлощадьПотолков),
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ КоличествоКомнат)
	|ПО
	|	Ссылка,
	|	Комната
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ДанныеДокумента.Ссылка КАК Ссылка,
	|	ДанныеДокумента.НомерСтроки КАК НомерСтроки,
	|	ДанныеДокумента.Номенклатура КАК Номенклатура,
	|	ДанныеДокумента.Номенклатура.Артикул КАК Артикул,
	|	ДанныеДокумента.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	|	ДанныеДокумента.Количество КАК Количество,
	|	ДанныеДокумента.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	ДанныеДокумента.Коэффициент КАК Коэффициент,
	|	ДанныеДокумента.Комната КАК Комната
	|ИЗ
	|	Документ.ПредварительныйРасчетЗаказДоговора.Материалы КАК ДанныеДокумента
	|ГДЕ
	|	ДанныеДокумента.Ссылка В(&МассивОбъектов)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДанныеДокумента.Ссылка,
	|	ДанныеДокумента.НомерСтроки
	|ИТОГИ ПО
	|	Ссылка";

	МассивРезультатов         = Запрос.ВыполнитьПакет();
	РезультатПоШапке          = МассивРезультатов[0];
	РезультатПоТабличнойЧастиТовары  = МассивРезультатов[1];
	РезультатПоТабличнойЧастиТоварыПоКомнатам = МассивРезультатов[2];
	РезультатПоТабличнойЧастиМатериалы        = МассивРезультатов[3];
	
	СтруктураДанныхДляПечати 	= Новый Структура("РезультатПоШапке, РезультатПоТабличнойЧастиТовары, РезультатПоТабличнойЧастиТоварыПоКомнатам, РезультатПоТабличнойЧастиМатериалы",
	                                               РезультатПоШапке, РезультатПоТабличнойЧастиТовары, РезультатПоТабличнойЧастиТоварыПоКомнатам, РезультатПоТабличнойЧастиМатериалы);
	
	Возврат СтруктураДанныхДляПечати;
	
КонецФункции

Процедура ДополнитьДанныеДляПечатныхФорм(РезультатЗапроса, ВыборкаПоТоварам = Неопределено) Экспорт
	
	ОбщийМодульСервер.ДобавитьКолонкиКонтактнойИнформации(РезультатЗапроса);
	РезультатЗапроса.Колонки.Добавить("ЗамерщикКонтактныйТелефон");
	РезультатЗапроса.Колонки.Добавить("ЗамерщикЛичныйТелефон");
	
	РезультатЗапроса.Колонки.Добавить("НомерДокумента", Новый ОписаниеТипов("Строка", , , , Новый КвалификаторыСтроки(11)));
	РезультатЗапроса.Колонки.Добавить("СуммаСтрокой", Новый ОписаниеТипов("строка"));
	
	Для Каждого ТекущаяСтрока Из РезультатЗапроса Цикл
		ТекущаяСтрока.Дата = Формат(ТекущаяСтрока.ДатаДокумента,"ДЛФ=Д");
		Попытка
			ТекущаяСтрока.Номер = ПрефиксацияОбъектовКлиентСервер.НомерНаПечать(ТекущаяСтрока.Номер);
		Исключение
		КонецПопытки;
		ТекущаяСтрока.НомерДокумента = ТекущаяСтрока.Номер;
		Попытка
			ТекущаяСтрока.СуммаСтрокой = РаботаСВалютой.СформироватьЧислоПрописью(ТекущаяСтрока.СуммаДокумента, ТекущаяСтрока.Валюта);
		Исключение
		КонецПопытки;
		
		Если НЕ ВыборкаПоТоварам = Неопределено Тогда
			СтруктураПоиска = Новый Структура("Ссылка", ТекущаяСтрока.Ссылка);
			ВыборкаПоТоварам.Сбросить();
			Если ВыборкаПоТоварам.НайтиСледующий(СтруктураПоиска) Тогда
				ТекущаяСтрока.СуммаСкидки = ВыборкаПоТоварам.СуммаСкидки;
				ТекущаяСтрока.СуммаБезСкидки = ВыборкаПоТоварам.Сумма + ВыборкаПоТоварам.СуммаСкидки;
				ТекущаяСтрока.СуммаТоваров = ВыборкаПоТоварам.СуммаТоваров;
				ТекущаяСтрока.СуммаУслуг = ВыборкаПоТоварам.СуммаУслуг;
				ТекущаяСтрока.ПлощадьПотолков = ВыборкаПоТоварам.ПлощадьПотолков;
				ТекущаяСтрока.СуммаНДС = ВыборкаПоТоварам.СуммаНДС;
				//ТекущаяСтрока.ИтогоСуммаБезНДС = ВыборкаПоТоварам.Сумма - ВыборкаПоТоварам.СуммаНДС;
				ТекущаяСтрока.КоличествоКомнат = ВыборкаПоТоварам.КоличествоКомнат;	
				ТекущаяСтрока.КолвоПозиций = ВыборкаПоТоварам.НомерСтроки;
				
				ТекущаяСтрока.ИтогоСуммаНДС = ВыборкаПоТоварам.СуммаНДС;
			КонецЕсли;						
		КонецЕсли;
				
		ОбщийМодульСервер.ДополнитьДанныеДляПечатныхФормКонтактнойИнформацией(ТекущаяСтрока, ТекущаяСтрока.Организация);
		Если ЗначениеЗаполнено(ТекущаяСтрока.ПоследнийИсполнительЗамера) Тогда
			ТекущаяСтрока.ЗамерщикКонтактныйТелефон = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(ТекущаяСтрока.ПоследнийИсполнительЗамера, Справочники.ВидыКонтактнойИнформации.ТелефонСотрудника);
			ТекущаяСтрока.ЗамерщикЛичныйТелефон     = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(ТекущаяСтрока.ПоследнийИсполнительЗамера, Справочники.ВидыКонтактнойИнформации.ЛичныйТелефонСотрудника);
		КонецЕсли;
		
	КонецЦикла;
		
КонецПроцедуры

Функция ПечатьКоммерческоеПредложение(МассивОбъектов, ОбъектыПечати) Экспорт
	
	// Создаем табличный документ и устанавливаем имя параметров печати.
    ТабличныйДокумент = Новый ТабличныйДокумент;
    ТабличныйДокумент.ИмяПараметровПечати = "ПараметрыПечати_КоммерческоеПредложение";
	ТабличныйДокумент.АвтоМасштаб         = Истина;
	ВыводитьАртикул = Константы.ВыводитьАртикулНоменклатурыВПечатныхФормах.Получить();
	
	СтруктураДанныхДляПечати = ПолучитьДанныеДляПечатныхФорм(МассивОбъектов);
	ТаблицаДанныеПечати = СтруктураДанныхДляПечати.РезультатПоШапке.Выгрузить();	
	ВыборкаПоТоварам = СтруктураДанныхДляПечати.РезультатПоТабличнойЧастиТовары.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	ВыборкаПоТоварамПоКомнатамГруппировка = СтруктураДанныхДляПечати.РезультатПоТабличнойЧастиТоварыПоКомнатам.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	ВыборкаПоМатериалам = СтруктураДанныхДляПечати.РезультатПоТабличнойЧастиМатериалы.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);	
	ДополнитьДанныеДляПечатныхФорм(ТаблицаДанныеПечати, ВыборкаПоТоварам);
	
    ПервыйДокумент = Истина;
    Для Каждого ДанныеПечати Из ТаблицаДанныеПечати Цикл
        Если Не ПервыйДокумент Тогда
            // Все документы нужно выводить на разных страницах.
            ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
        КонецЕсли;
        ПервыйДокумент = Ложь;
        // Запомним номер строки, с которой начали выводить текущий документ.
        НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы + 1;
		
		ЕстьСкидка = (ДанныеПечати.СуммаСкидки > 0);
		ВставкаСкидок = ?(ЕстьСкидка, "Скидка","");
		
		Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.ПредварительныйРасчетЗаказДоговора.ПФ_MXL_КоммерческоеПредложение");
		
		//шапка макета
		Попытка
			ОбластьМакета = Макет.ПолучитьОбласть("Шапка");
			ОбластьМакета.Параметры.Заполнить(ДанныеПечати);
			ТабличныйДокумент.Вывести(ОбластьМакета);
		Исключение
		КонецПопытки;
		
		// Изменения размера колоноки, в зависимости от вывода Артикула
		Если Не ВыводитьАртикул Тогда
			Попытка
				Макет.Область("ПерваяКолонкаТовара").ШиринаКолонки = Макет.Область("ПерваяКолонкаТовара").ШиринаКолонки + Макет.Область("Артикул").ШиринаКолонки;
			Исключение
			КонецПопытки;
		КонецЕсли;
		
		//// Изменения размера колонки, в зависимости от вывода Артикула, Скидки
		//ШиринаУвеличенияКолонкиТовар = 0;
		//Попытка
		//	Если НЕ ЕстьСкидка Тогда
		//		ШиринаУвеличенияКолонкиТовар = ШиринаУвеличенияКолонкиТовар + (Макет.Область("Скидка").ШиринаКолонки * 2); // умножаем на две колонки
		//	КонецЕсли;		
		//	Если Не ВыводитьАртикул Тогда
		//		ШиринаУвеличенияКолонкиТовар = ШиринаУвеличенияКолонкиТовар + Макет.Область("Артикул").ШиринаКолонки;
		//	КонецЕсли;
		//Исключение
		//КонецПопытки;
		//
		//Если Не ШиринаУвеличенияКолонкиТовар = 0 Тогда
		//	Попытка
		//		Макет.Область("ПерваяКолонкаТовара").ШиринаКолонки = Макет.Область("ПерваяКолонкаТовара").ШиринаКолонки + ШиринаУвеличенияКолонкиТовар;
		//	Исключение
		//	КонецПопытки;
		//КонецЕсли;
				
		//шапка таблицы
		Попытка
			ОбластьМакета = Макет.ПолучитьОбласть("ШапкаТаблицы"+ВставкаСкидок+"|НомерСтроки");
			ОбластьМакета.Параметры.Заполнить(ДанныеПечати);
			ТабличныйДокумент.Вывести(ОбластьМакета);
			
			Если ВыводитьАртикул Тогда
				ОбластьМакета = Макет.ПолучитьОбласть("ШапкаТаблицы"+ВставкаСкидок+"|Артикул");
				ОбластьМакета.Параметры.Заполнить(ДанныеПечати);
				ТабличныйДокумент.Присоединить(ОбластьМакета);
			КонецЕсли;
			
			ОбластьМакета = Макет.ПолучитьОбласть("ШапкаТаблицы"+ВставкаСкидок+"|Данные");
			ОбластьМакета.Параметры.Заполнить(ДанныеПечати);
			ТабличныйДокумент.Присоединить(ОбластьМакета);
			
			//Если ЕстьСкидка Тогда
			//	ОбластьМакета = Макет.ПолучитьОбласть("ШапкаТаблицы|Скидка");
			//	ОбластьМакета.Параметры.Заполнить(ДанныеПечати);
			//	ТабличныйДокумент.Присоединить(ОбластьМакета);
			//КонецЕсли;	
			//
			//ОбластьМакета = Макет.ПолучитьОбласть("ШапкаТаблицы|Сумма");
			//ОбластьМакета.Параметры.Заполнить(ДанныеПечати);
			//ТабличныйДокумент.Присоединить(ОбластьМакета);
		Исключение
		КонецПопытки;
		
		//Комнаты
		СтруктураПоиска = Новый Структура("Ссылка", ДанныеПечати.Ссылка);		
		ВыборкаПоТоварамПоКомнатамГруппировка.Сбросить();
		Если ВыборкаПоТоварамПоКомнатамГруппировка.НайтиСледующий(СтруктураПоиска) Тогда			
			ВыборкаПоКомнатам = ВыборкаПоТоварамПоКомнатамГруппировка.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);			
			Пока ВыборкаПоКомнатам.Следующий() Цикл
				Попытка
					
					НомерСтроки = 1;
					
					ОбластьМакета = Макет.ПолучитьОбласть("СтрокаКомната"+ВставкаСкидок+"|НомерСтроки");
					ОбластьМакета.Параметры.Заполнить(ДанныеПечати);
					ОбластьМакета.Параметры.Заполнить(ВыборкаПоКомнатам);
					ТабличныйДокумент.Вывести(ОбластьМакета);
					
					Если ВыводитьАртикул Тогда
						ОбластьМакета = Макет.ПолучитьОбласть("СтрокаКомната"+ВставкаСкидок+"|Артикул");
						ОбластьМакета.Параметры.Заполнить(ДанныеПечати);
						ОбластьМакета.Параметры.Заполнить(ВыборкаПоКомнатам);
						ТабличныйДокумент.Присоединить(ОбластьМакета);
					КонецЕсли;
					
					ОбластьМакета = Макет.ПолучитьОбласть("СтрокаКомната"+ВставкаСкидок+"|Данные");
					ОбластьМакета.Параметры.Заполнить(ДанныеПечати);
					ОбластьМакета.Параметры.Заполнить(ВыборкаПоКомнатам);
					ТабличныйДокумент.Присоединить(ОбластьМакета);
					
