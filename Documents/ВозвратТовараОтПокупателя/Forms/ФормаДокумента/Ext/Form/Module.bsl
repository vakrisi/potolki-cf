Процедура ВыполнитьРаспределениеОплаты(ДополнительныеПараметры=Неопределено)

	ОчиститьСообщения();
	СуммаЗачета = ПолучитьСуммуЗачета();
	Если СуммаЗачета = 0 Тогда
		Сообщить("Нет суммы к распределению! Сумма формируется по строкам с видом компенсации ""Зачесть как аванс / вернуть оплату""");
		Возврат;
	КонецЕсли;
	
	ОписаниеОповещенияОбновитьДанные = Новый ОписаниеОповещения("ОписаниеОповещенияОбновитьДанные", ЭтотОбъект);
	ФинансыКлиент.РаспределениеОплаты(ЭтаФорма, "ЗачетАванса", СтрокиРаспределенияПлатежей(), СуммаЗачета, ОписаниеОповещенияОбновитьДанные);
	
