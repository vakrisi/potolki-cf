&НаКлиенте
Процедура ПослеПолученияКонтрагентаПоДисконтноКарте(Результат, ДопПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Объект.Контрагент = Результат.Контрагент;
	Объект.ДисконтнаяКарта = Результат.ДисконтнаяКарта;
		
	КонтрагентПриИзмененииНаСервере();
	РассчитатьИтоговыеПоказатели();
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПоОснованию(Команда)
	
	Если НЕ ЗначениеЗаполнено(Объект.Основание) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Основание документа не заполнено", , , "Объект.Основание");
		Возврат;
	КонецЕсли;
	
	ОписаниеОповещенияВопрос = Новый ОписаниеОповещения("ЗаполнитьПоОснованиюПослеВопроса", ЭтаФорма);
	ПоказатьВопрос(ОписаниеОповещенияВопрос, "Табличная часть будет очищена и заполнена по основанию. Продолжить?", РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПоОснованиюПослеВопроса(Результат, Параметры) Экспорт
	
    Если Результат = КодВозвратаДиалога.Да Тогда
		ЗаполнитьПоОснованиюНаСервере();
		Модифицированность = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПоОснованиюНаСервере()
	
	ТекущийОбъект = РеквизитФормыВЗначение("Объект");
	ТекущийОбъект.Товары.Очистить();		
	ТекущийОбъект.ЗаполнитьТабличнуюЧастьПоОснованию(Объект.Основание);
	ЗначениеВРеквизитФормы(ТекущийОбъект, "Объект");
	
	РассчитатьИтоговыеПоказатели();
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьДокументыПродажиПоПоследнимПродажам(Команда)
	
	ТекстСообщения = "Будет выполнена процедура заполнения колонок ""Документ продажи"" и ""Заказ покупателя"" по позициям, где обе колонки не заполнены. Продолжить?";
	Оповещение = Новый ОписаниеОповещения("ПослеВопросаЗаполнитьДокументыПродажиПоПоследнимПродажам", ЭтаФорма);
	ПоказатьВопрос(Оповещение, ТекстСообщения, РежимДиалогаВопрос.ДаНет, 0);

КонецПроцедуры

&НаКлиенте
Процедура ПослеВопросаЗаполнитьДокументыПродажиПоПоследнимПродажам(Результат, ДополнительныеПараметры) Экспорт
	
    Если НЕ Результат = КодВозвратаДиалога.Да Тогда
        Возврат;
    КонецЕсли;
	ЗаполнитьДокументыПродажиПоПоследнимПродажамНаСервере();
	Модифицированность = Истина;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДокументыПродажиПоПоследнимПродажамНаСервере()
	
	РеквизитОбъект = РеквизитФормыВЗначение("Объект");
	РеквизитОбъект.ЗаполнитьДокументыПродажиПоПоследнимПродажамНаСервере();
	
	ЗначениеВРеквизитФормы(РеквизитОбъект, "Объект");
	
	РассчитатьИтоговыеПоказатели();
	
КонецПроцедуры

&НаКлиенте
Процедура ПодобратьТовары(Команда)
	
	ПараметрыПодбора = Новый Структура;
	ПараметрыПодбора.Вставить("Дата",					Объект.Дата);
	ПараметрыПодбора.Вставить("Организация",			Объект.Организация);
	ПараметрыПодбора.Вставить("Склад",					Объект.Склад);
	ПараметрыПодбора.Вставить("ВидНоменклатуры",		ПолучитьСписокВидовНоменклатурыТовары());
	ПараметрыПодбора.Вставить("Валюта",					Объект.Валюта);
	
	ОткрытьФорму("ОбщаяФорма.ФормаПодбораНоменклатуры", ПараметрыПодбора, ЭтаФорма, УникальныйИдентификатор);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбораПодборНаКлиенте(ВыбранноеЗначение)
	
	Если Не ЗначениеЗаполнено(ВыбранноеЗначение) Тогда
		Возврат;
	КонецЕсли;
			
	ОбработкаВыбораПодборНаСервере(ВыбранноеЗначение);
	РассчитатьИтоговыеПоказатели();
	
КонецПроцедуры

&НаСервере
Функция ОбработкаВыбораПодборНаСервере(ВыбранноеЗначение)
	
	ТаблицаТоваров = ПолучитьИзВременногоХранилища(ВыбранноеЗначение.АдресВХранилище);	
	Для Каждого ТекущаяСтрока из ТаблицаТоваров Цикл
		НоваяСтрока = Объект.Товары.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущаяСтрока);
		НоваяСтрока.СтавкаНДС = СтавкаНДСПоУмолчанию;
		ОбработкаТабличныхЧастейКлиентСервер.ПересчитатьСуммуНДСВСтрокеТЧ(НоваяСтрока, УчитыватьНДС);
	КонецЦикла;
	
КонецФункции

