КонецПроцедуры

&НаКлиенте
Процедура ТоварыЕдиницаИзмеренияПриИзменении(Элемент)
	
	СтрокаТабличнойЧасти = Элементы.Товары.ТекущиеДанные;
	Если ТипЗнч(СтрокаТабличнойЧасти.ЕдиницаИзмерения) = Тип("СправочникСсылка.КлассификаторЕдиницИзмерения") Тогда
		СтрокаТабличнойЧасти.Коэффициент = 1;
	Иначе
		СтрокаТабличнойЧасти.Коэффициент = ОбщийМодуль.ПолучитьКоэффициентЕдиницыИзмерения(СтрокаТабличнойЧасти.ЕдиницаИзмерения);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыКоличествоПриИзменении(Элемент)
	
	СтрокаТабличнойЧасти = Элементы.Товары.ТекущиеДанные;
	Если СтрокаТабличнойЧасти = Неопределено Тогда 
		Возврат; 
	КонецЕсли;
	
	//++ №13812 пересчитаем скидку бонусами пропорционально
	Если НЕ мПредыдущееКоличество = Неопределено И мПредыдущееКоличество > 0 Тогда
		СтрокаТабличнойЧасти.БонусыКНачислению = (СтрокаТабличнойЧасти.БонусыКНачислению / мПредыдущееКоличество) * СтрокаТабличнойЧасти.Количество;
	КонецЕсли;
	//-- №13812
	
	СтрокаТабличнойЧасти.Сумма = СтрокаТабличнойЧасти.Количество * СтрокаТабличнойЧасти.Цена - СтрокаТабличнойЧасти.БонусыКНачислению;
	ОбработкаТабличныхЧастейКлиент.ПересчитатьСуммуНДСВСтрокеТЧ(СтрокаТабличнойЧасти, УчитыватьНДС);
	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыЦенаПриИзменении(Элемент)
	
	СтрокаТабличнойЧасти = Элементы.Товары.ТекущиеДанные;
	Если СтрокаТабличнойЧасти = Неопределено Тогда 
		Возврат; 
	КонецЕсли;
	Элементы.Товары.ТекущиеДанные.Сумма = СтрокаТабличнойЧасти.Количество * СтрокаТабличнойЧасти.Цена - СтрокаТабличнойЧасти.БонусыКНачислению;
	ОбработкаТабличныхЧастейКлиент.ПересчитатьСуммуНДСВСтрокеТЧ(СтрокаТабличнойЧасти, УчитыватьНДС);
	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыСуммаПриИзменении(Элемент)
	
	СтрокаТабличнойЧасти = Элементы.Товары.ТекущиеДанные;
	Если СтрокаТабличнойЧасти = Неопределено Тогда 
		Возврат; 
	КонецЕсли;
	СтрокаТабличнойЧасти.Цена = (СтрокаТабличнойЧасти.Сумма + СтрокаТабличнойЧасти.БонусыКНачислению) / СтрокаТабличнойЧасти.Количество;
	ОбработкаТабличныхЧастейКлиент.ПересчитатьСуммуНДСВСтрокеТЧ(СтрокаТабличнойЧасти, УчитыватьНДС);
	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыСтавкаНДСПриИзменении(Элемент)
		
	СтрокаТабличнойЧасти = Элементы.Товары.ТекущиеДанные;
	Если СтрокаТабличнойЧасти = Неопределено Тогда 
		Возврат; 
	КонецЕсли;
	
	ОбработкаТабличныхЧастейКлиент.ПересчитатьСуммуНДСВСтрокеТЧ(СтрокаТабличнойЧасти, УчитыватьНДС);
	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыНоменклатураПриИзменении(Элемент)
	
	СтрокаТабличнойЧасти = Элементы.Товары.ТекущиеДанные;
	СтруктураДанные = Новый Структура;
	СтруктураДанные.Вставить("Номенклатура", СтрокаТабличнойЧасти.Номенклатура);
	СтруктураДанные = ОбработкаТабличныхЧастейКлиент.ПолучитьДанныеНоменклатурыПриИзменении(СтруктураДанные);
	
	ЗаполнитьЗначенияСвойств(СтрокаТабличнойЧасти, СтруктураДанные, "ЕдиницаИзмерения, Коэффициент, СтатьяРасходов");
		
КонецПроцедуры

&НаКлиенте
Процедура ТоварыЕдиницаИзмеренияНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	СтрокаТабличнойЧасти = Элементы.Товары.ТекущиеДанные;
	СписокЕдиниц = ОбщийМодуль.ПолучитьСписокЕдиницИзмеренияНоменклатуры(СтрокаТабличнойЧасти.Номенклатура);
	
	ДанныеВыбора = Новый СписокЗначений;
	Для Ном = 0 По СписокЕдиниц.Количество() - 1 Цикл
		ДанныеВыбора.Добавить(СписокЕдиниц[Ном]);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыЕдиницаИзмеренияОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	СтрокаТабличнойЧасти = Элементы.Товары.ТекущиеДанные;
	Если ТипЗнч(ВыбранноеЗначение) = Тип("СправочникСсылка.КлассификаторЕдиницИзмерения") Тогда
		СтрокаТабличнойЧасти.Коэффициент = 1;
	Иначе
		СтрокаТабличнойЧасти.Коэффициент = ОбщийМодуль.ПолучитьКоэффициентЕдиницыИзмерения(ВыбранноеЗначение);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыВариантОпределенияСебестоимостиПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.Товары.ТекущиеДанные;
	ТекущиеДанные.СебестоимостьЗаЕдиницу = 0; // #12822
	ТекущиеДанные.ДокументПродажи = ПредопределенноеЗначение("Документ.РеализацияТоваровИУслуг.ПустаяСсылка"); // #12822
	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыСебестоимостьПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.Товары.ТекущиеДанные;
	Если ЗначениеЗаполнено(ТекущиеДанные.ДокументПродажи) Тогда
		ТекущиеДанные.СебестоимостьЗаЕдиницу = 0;
		Сообщить("Себестоимость будет определена по документу продажи!");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыДокументПродажиПриИзменении(Элемент)
	
	ТекущаяСтрока = Элементы.Товары.ТекущиеДанные;
	Если НЕ ТекущаяСтрока = Неопределено Тогда
		Если ЗначениеЗаполнено(ТекущаяСтрока.ДокументПродажи) Тогда
			ТекущаяСтрока.ВариантОпределенияСебестоимости = ПредопределенноеЗначение("Перечисление.ВариантыОпределенияСебестоимостиПоВозвратам.ПоДокументуПродажи");
			ТекущаяСтрока.СебестоимостьЗаЕдиницу = 0;
		Иначе
			ТекущаяСтрока.ВариантОпределенияСебестоимости = ПредопределенноеЗначение("Перечисление.ВариантыОпределенияСебестоимостиПоВозвратам.РучноеУказание");
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ТекущаяСтрока.ДокументПродажи) И НЕ ЗначениеЗаполнено(ТекущаяСтрока.ЗаказПокупателя) Тогда
			СписокЗаказовПокупателей = Новый СписокЗначений;
			ПодготовитьСписокЗаказовПокупателей(Объект.Ссылка, ТекущаяСтрока.ДокументПродажи, ТекущаяСтрока.Номенклатура, ТекущаяСтрока.ХарактеристикаНоменклатуры, ТекущаяСтрока.СерияНоменклатуры, СписокЗаказовПокупателей);	
			Если СписокЗаказовПокупателей.Количество() > 0 Тогда
				ТекущаяСтрока.ЗаказПокупателя = СписокЗаказовПокупателей.Получить(0).Значение;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыЗаказПокупателяПриИзменении(Элемент)
	
	ТекущаяСтрока = Элементы.Товары.ТекущиеДанные;
	Если НЕ ТекущаяСтрока = Неопределено Тогда		
		Если НЕ ЗначениеЗаполнено(ТекущаяСтрока.ДокументПродажи) И ЗначениеЗаполнено(ТекущаяСтрока.ЗаказПокупателя) Тогда			
			СписокРеализацийПоЗаказу = Новый СписокЗначений;
			ПодготовитьСписокРеализацийПоЗаказу(Объект.Ссылка, ТекущаяСтрока.ЗаказПокупателя, ТекущаяСтрока.Номенклатура, ТекущаяСтрока.ХарактеристикаНоменклатуры, ТекущаяСтрока.СерияНоменклатуры, СписокРеализацийПоЗаказу);	
			Если СписокРеализацийПоЗаказу.Количество() > 0 Тогда
				ТекущаяСтрока.ДокументПродажи = СписокРеализацийПоЗаказу.Получить(0).Значение;
			КонецЕсли;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ТекущаяСтрока.ЗаказПокупателя) Тогда
			ТекущаяСтрока.КомпенсацияПоВозврату = ПолучитьСпособКомпенсации(); // №13856
		Иначе
			ТекущаяСтрока.КомпенсацияПоВозврату = ПредопределенноеЗначение("Перечисление.ВариантыКомпенсацииПоВозврату.ПустаяСсылка");	
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыДокументПродажиНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ТекущаяСтрока = Элементы.Товары.ТекущиеДанные;
	
	Если ЗначениеЗаполнено(ТекущаяСтрока.ЗаказПокупателя) Тогда
		СтандартнаяОбработка = Ложь;
		СписокРеализацийПоЗаказу = Новый СписокЗначений;
		ПодготовитьСписокРеализацийПоЗаказу(Объект.Ссылка, ТекущаяСтрока.ЗаказПокупателя, ТекущаяСтрока.Номенклатура, ТекущаяСтрока.ХарактеристикаНоменклатуры, ТекущаяСтрока.СерияНоменклатуры, СписокРеализацийПоЗаказу);	
		
		Отбор = Новый Структура;
		Отбор.Вставить("Ссылка", СписокРеализацийПоЗаказу);
		
		ОткрытьФорму("Документ.РеализацияТоваровИУслуг.ФормаВыбора", Новый Структура("Отбор, ТекущаяСтрока", Отбор, ТекущаяСтрока.ЗаказПокупателя), Элемент);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ТоварыЗаказПокупателяНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ТекущаяСтрока = Элементы.Товары.ТекущиеДанные;
	
	Если ЗначениеЗаполнено(ТекущаяСтрока.ДокументПродажи) Тогда	
		СтандартнаяОбработка = Ложь;	
		СписокЗаказовПокупателей = Новый СписокЗначений;
		ПодготовитьСписокЗаказовПокупателей(Объект.Ссылка, ТекущаяСтрока.ДокументПродажи, ТекущаяСтрока.Номенклатура, ТекущаяСтрока.ХарактеристикаНоменклатуры, ТекущаяСтрока.СерияНоменклатуры, СписокЗаказовПокупателей);		
		
		Отбор = Новый Структура;
		Отбор.Вставить("Ссылка", СписокЗаказовПокупателей);
		
		ОткрытьФорму("Документ.ЗаказПокупателя.ФормаВыбора", Новый Структура("Отбор, ТекущаяСтрока", Отбор, ТекущаяСтрока.ЗаказПокупателя), Элемент);
	КонецЕсли;

КонецПроцедуры

