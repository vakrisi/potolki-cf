&НаСервере
Процедура РассчитатьИтоговыеПоказатели()
	
	СуммаДокументаВрем = Объект.Товары.Итог("Сумма");
	Если НЕ Объект.СуммаДокумента = СуммаДокументаВрем Тогда
		Объект.СуммаДокумента = СуммаДокументаВрем;
	КонецЕсли;
	
	СуммаНДС = Объект.Товары.Итог("СуммаНДС");
	
	Если Объект.СлужебныйУчитыватьБонусы Тогда		
		//ОпределитьОстатокПоДисконтнойКарте();
		БонусыСервер.ОпределитьОстатокПоДисконтнойКарте(ЭтаФорма);
		БонусыКНачислениюИтог = Объект.Товары.Итог("БонусыКНачислению");
		Если Не Объект.СуммаБонусовКНачислениюПоДисконтнойКарте = БонусыКНачислениюИтог Тогда
			Объект.СуммаБонусовКНачислениюПоДисконтнойКарте = БонусыКНачислениюИтог;
		КонецЕсли;
	Иначе
		//Если НЕ Объект.СуммаБонусовКНачислениюПоДисконтнойКарте = 0 Тогда
		Объект.СуммаБонусовКНачислениюПоДисконтнойКарте = 0;
		//КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСтавкуНДСПоОрганизации(ИзменятьСтавку = Истина)
	
	УчитыватьНДС = УчетНДС.ОрганизацияЯвляетсяПлательщикомНДС(Объект.Организация);
	СтавкаНДСПоУмолчанию = УчетНДС.СтавкаНДСПоУмолчанию(Объект.Организация);
	
	Элементы.ТоварыСуммаНДС.Видимость 	= УчитыватьНДС;
	Элементы.ТоварыСтавкаНДС.Видимость 	= УчитыватьНДС;
	
	Если ИзменятьСтавку Тогда
		Для каждого СтрокаТабличнойЧасти из Объект.Товары Цикл
			СтрокаТабличнойЧасти.СтавкаНДС = СтавкаНДСПоУмолчанию;
			ОбработкаТабличныхЧастейКлиентСервер.ПересчитатьСуммуНДСВСтрокеТЧ(СтрокаТабличнойЧасти, УчитыватьНДС);	
		КонецЦикла;
		РассчитатьИтоговыеПоказатели();
	КонецЕсли;	
	
КонецПроцедуры

