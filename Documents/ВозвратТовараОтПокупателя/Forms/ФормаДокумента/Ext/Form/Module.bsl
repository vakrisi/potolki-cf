&НаКлиенте
Процедура ТоварыПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Если НоваяСтрока И Копирование Тогда
		Элемент.ТекущиеДанные.ДокументПродажи = ПредопределенноеЗначение("Документ.РеализацияТоваровИУслуг.ПустаяСсылка"); 
		Элемент.ТекущиеДанные.ЗаказПокупателя = ПредопределенноеЗначение("Документ.ЗаказПокупателя.ПустаяСсылка");
		Элемент.ТекущиеДанные.КомпенсацияПоВозврату = ПредопределенноеЗначение("Перечисление.ВариантыКомпенсацииПоВозврату.ПустаяСсылка");
	КонецЕсли;
	
	Если НоваяСтрока Тогда
		Элемент.ТекущиеДанные.ВариантОпределенияСебестоимости = ПредопределенноеЗначение("Перечисление.ВариантыОпределенияСебестоимостиПоВозвратам.ПоДокументуПродажи");//nva
	КонецЕсли;
	
	Если НоваяСтрока И Не Копирование Тогда
        Элемент.ТекущиеДанные.СтавкаНДС = СтавкаНДСПоУмолчанию;
	КонецЕсли;
	
	//++ №13299
	мПредыдущееКоличество = Элемент.ТекущиеДанные.Количество;
	//-- №13299
	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	
	Если НоваяСтрока И НЕ ОтменаРедактирования Тогда
		ТекущиеДанные = Элемент.ТекущиеДанные;
		Если НЕ ТекущиеДанные = Неопределено Тогда
			ТекущиеДанные.ВариантОпределенияСебестоимости = ПредопределенноеЗначение("Перечисление.ВариантыОпределенияСебестоимостиПоВозвратам.ПоДокументуПродажи");//nva
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

