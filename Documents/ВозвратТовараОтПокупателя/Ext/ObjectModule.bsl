Функция ПревышенСрокВозврата()
	
	ПревышенСрокВозврата = Ложь;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ВозвратТовараОтПокупателяТовары.Ссылка.Дата КАК ДатаВозврата,
		|	ВозвратТовараОтПокупателяТовары.ДокументПродажи.Дата КАК ДатаПродажи,
		|	РАЗНОСТЬДАТ(ВозвратТовараОтПокупателяТовары.ДокументПродажи.Дата, ВозвратТовараОтПокупателяТовары.Ссылка.Дата, ДЕНЬ) КАК ПрошлоДней,
		|	ВозвратТовараОтПокупателяТовары.НомерСтроки КАК НомерСтроки,
		|	ВозвратТовараОтПокупателяТовары.Номенклатура КАК Номенклатура
		|ИЗ
		|	Документ.ВозвратТовараОтПокупателя.Товары КАК ВозвратТовараОтПокупателяТовары
		|ГДЕ
		|	ВозвратТовараОтПокупателяТовары.Ссылка = &Ссылка
		|	И ВозвратТовараОтПокупателяТовары.ВариантОпределенияСебестоимости = ЗНАЧЕНИЕ(Перечисление.ВариантыОпределенияСебестоимостиПоВозвратам.ПоДокументуПродажи)";
	
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Если Выборка.ПрошлоДней > 14 Тогда
			ПревышенСрокВозврата = Истина;
			Сообщить("В строке с номером " + Выборка.НомерСтроки + " по номенклатуре " + Выборка.Номенклатура + " превышение срока возврата, с момента покупки прошло " + Выборка.ПрошлоДней + " дней!");
		КонецЕсли;	
	КонецЦикла;
	
	Возврат ПревышенСрокВозврата;
	
КонецФункции	
