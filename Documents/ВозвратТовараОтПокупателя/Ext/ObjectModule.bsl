	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыФункции

Функция ПолучитьСуммуЗачета() Экспорт
	
	СуммаЗачета = 0;
	Для каждого СтрокаТЧ из Товары Цикл
		Если СтрокаТЧ.КомпенсацияПоВозврату = ПредопределенноеЗначение("Перечисление.ВариантыКомпенсацииПоВозврату.ЗачестьВернуть")
			//#15885
			ИЛИ СтрокаТЧ.КомпенсацияПоВозврату = Перечисления.ВариантыКомпенсацииПоВозврату.ПустаяСсылка() Тогда
			СуммаЗачета = СуммаЗачета + СтрокаТЧ.Сумма;	
		КонецЕсли;
	КонецЦикла;
	
	Возврат СуммаЗачета;
	
КонецФункции

Функция ПолучитьТаблицуПоЗаказамВПродажах(МассивРеализаций)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Продажи.ЗаказНаПроизводство КАК ЗаказНаПроизводство,
	|	Продажи.ЗаказПокупателя КАК ЗаказПокупателя,
	|	Продажи.Номенклатура КАК Номенклатура,
	|	Продажи.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	|	Продажи.СерияНоменклатуры КАК СерияНоменклатуры,
	|	Продажи.Регистратор КАК Регистратор
	|ИЗ
	|	РегистрНакопления.Продажи КАК Продажи
	|ГДЕ
	|	Продажи.Регистратор В(&МассивРеализаций)";
	
	Запрос.УстановитьПараметр("МассивРеализаций", МассивРеализаций);
	
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

//++ №14054 перенесено и адаптировано из модуля формы
Процедура ЗаполнитьДокументыПродажиПоПоследнимПродажамНаСервере(ЗаказПокупателя = Неопределено) Экспорт
	
	Если Товары.Количество() = 0 Тогда
		Сообщить("Табличная часть пустая");
		Возврат;
	КонецЕсли;
	
	УчитыватьНДС = УчетНДС.ОрганизацияЯвляетсяПлательщикомНДС(Организация);
	СтавкаНДСПоУмолчанию = УчетНДС.СтавкаНДСПоУмолчанию(Организация);
	
	ТаблицаРаспределенных = Товары.Выгрузить();
	КоличествоРаспределенных = ТаблицаРаспределенных.Количество();
	
	// для уменьшения количества распределения
	Для Индекс = 1 по КоличествоРаспределенных Цикл
		СтрокаТаблицы = ТаблицаРаспределенных[КоличествоРаспределенных - Индекс];	
		Если НЕ ЗначениеЗаполнено(СтрокаТаблицы.ЗаказПокупателя) ИЛИ НЕ ЗначениеЗаполнено(СтрокаТаблицы.ДокументПродажи) Тогда
			 ТаблицаРаспределенных.Удалить(СтрокаТаблицы);			
		КонецЕсли;
	КонецЦикла;
		
	//МассивНоменклатуры = Товары.Выгрузить().ВыгрузитьКолонку("Номенклатура");
	//Если МассивНоменклатуры.Количество() = 0 Тогда
	//	Сообщить("Табличная часть пустая");
	//	Возврат;
	//КонецЕсли;
	// #15886 переделано на таблицу
	ТаблицаДанных = Товары.Выгрузить(, "НомерСтроки, Номенклатура, ХарактеристикаНоменклатуры, СерияНоменклатуры, ЗаказПокупателя, ДокументПродажи");
	
	ТаблицаРаспределения = Новый ТаблицаЗначений;
	ТаблицаРаспределения.Колонки.Добавить("НомерСтроки", Новый ОписаниеТипов("Число"));
	ТаблицаРаспределения.Колонки.Добавить("Номенклатура");
	ТаблицаРаспределения.Колонки.Добавить("ХарактеристикаНоменклатуры");
	ТаблицаРаспределения.Колонки.Добавить("СерияНоменклатуры");
	ТаблицаРаспределения.Колонки.Добавить("ДокументПродажи");
	ТаблицаРаспределения.Колонки.Добавить("ЗаказПокупателя");
	ТаблицаРаспределения.Колонки.Добавить("Количество");
	ТаблицаРаспределения.Колонки.Добавить("Цена");
	ТаблицаРаспределения.Колонки.Добавить("Бонусы");
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Контрагент",  Контрагент);
	//Запрос.УстановитьПараметр("МассивНоменклатуры", МассивНоменклатуры);
	Запрос.УстановитьПараметр("ТаблицаДанных", ТаблицаДанных);
	
	//#13323
	//Запрос.УстановитьПараметр("Дата", Объект.Дата);
	Запрос.УстановитьПараметр("Дата", ?(ЗначениеЗаполнено(Ссылка), Дата, КонецДня(ТекущаяДатаСеанса())));
	
	//++ №14054 если заполняем по заказу покупателя, то документы продажи отбираем по этому заказу
	Запрос.УстановитьПараметр("ОтборПоЗаказу", ЗначениеЗаполнено(ЗаказПокупателя));
	Запрос.УстановитьПараметр("ЗаказПокупателя", ЗаказПокупателя);
	//-- №14054
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТаблицаДанных.НомерСтроки КАК НомерСтроки,
	|	ТаблицаДанных.Номенклатура КАК Номенклатура,
	|	ТаблицаДанных.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	|	ТаблицаДанных.СерияНоменклатуры КАК СерияНоменклатуры,
	|	ТаблицаДанных.ЗаказПокупателя КАК ЗаказПокупателя,
	|	ТаблицаДанных.ДокументПродажи КАК ДокументПродажи
	|ПОМЕСТИТЬ ВТ
	|ИЗ
	|	&ТаблицаДанных КАК ТаблицаДанных
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ.НомерСтроки КАК НомерСтроки,
	|	ВТ.Номенклатура КАК Номенклатура,
	|	ВТ.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	|	ВТ.СерияНоменклатуры КАК СерияНоменклатуры
	|ИЗ
	|	ВТ КАК ВТ
	|ГДЕ
	|	(ВТ.ДокументПродажи = ЗНАЧЕНИЕ(Документ.РеализацияТоваровИУслуг.ПустаяСсылка)
	|			ИЛИ ВТ.ЗаказПокупателя = ЗНАЧЕНИЕ(Документ.ЗаказПокупателя.ПустаяСсылка))
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВТ.НомерСтроки КАК НомерСтроки,
	|	Продажи.Номенклатура КАК Номенклатура,
	|	ЕСТЬNULL(Продажи.ХарактеристикаНоменклатуры, ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)) КАК ХарактеристикаНоменклатуры,
	|	ЕСТЬNULL(Продажи.СерияНоменклатуры, ЗНАЧЕНИЕ(Справочник.СерииНоменклатуры.ПустаяСсылка)) КАК СерияНоменклатуры,
	|	Продажи.Регистратор КАК Регистратор,
	|	Продажи.ЗаказПокупателя КАК ЗаказПокупателя,
	|	Продажи.Период КАК Период,
	|	Продажи.Количество КАК Количество,
	|	Продажи.Сумма / Продажи.Количество КАК ЦенаПродажи
	|ПОМЕСТИТЬ ВТ_Продажи
	|ИЗ
	|	РегистрНакопления.Продажи КАК Продажи
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ КАК ВТ
	|		ПО (ВТ.Номенклатура = Продажи.Номенклатура)
	|			И (ВТ.ХарактеристикаНоменклатуры = Продажи.ХарактеристикаНоменклатуры)
	|			И (ВТ.СерияНоменклатуры = Продажи.СерияНоменклатуры)
	|ГДЕ
	|	Продажи.Период < &Дата
	|	И Продажи.Организация = &Организация
	|	И Продажи.Контрагент = &Контрагент
	|	И (ТИПЗНАЧЕНИЯ(Продажи.Регистратор) = ТИП(Документ.РеализацияТоваровИУслуг)
	|			ИЛИ ТИПЗНАЧЕНИЯ(Продажи.Регистратор) = ТИП(Документ.ВозвратТовараОтПокупателя))
	|	И ВЫБОР
	|			КОГДА &ОтборПоЗаказу
	|				ТОГДА Продажи.ЗаказПокупателя = &ЗаказПокупателя
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Продажи.НомерСтроки КАК НомерСтроки,
	|	ВТ_Продажи.Номенклатура КАК Номенклатура,
	|	ВТ_Продажи.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	|	ВТ_Продажи.СерияНоменклатуры КАК СерияНоменклатуры,
	|	ВТ_Продажи.Период КАК Период,
	|	ВТ_Продажи.Регистратор КАК Регистратор,
	|	ВТ_Продажи.ЗаказПокупателя КАК ЗаказПокупателя,
	|	ВТ_Продажи.Количество КАК Количество,
	|	ВТ_Продажи.ЦенаПродажи КАК ЦенаПродажи
	|ИЗ
	|	ВТ_Продажи КАК ВТ_Продажи
	|
	|УПОРЯДОЧИТЬ ПО
	|	ВТ_Продажи.Период УБЫВ
	|ИТОГИ ПО
	|	Номенклатура,
	|	ХарактеристикаНоменклатуры,
	|	СерияНоменклатуры";
	
	ВыборкаНоменклатура = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам, "Номенклатура");
	Пока ВыборкаНоменклатура.Следующий() Цикл
		ВыборкаХарактеристика = ВыборкаНоменклатура.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам, "ХарактеристикаНоменклатуры");
		Пока ВыборкаХарактеристика.Следующий() Цикл
			ВыборкаСерия = ВыборкаХарактеристика.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам, "СерияНоменклатуры");
			Пока ВыборкаСерия.Следующий() Цикл
				
				ПараметрыОтбораСтрок = Новый Структура("Номенклатура, ХарактеристикаНоменклатуры, СерияНоменклатуры", ВыборкаНоменклатура.Номенклатура, ВыборкаХарактеристика.ХарактеристикаНоменклатуры, ВыборкаСерия.СерияНоменклатуры);		
				НайденныеСтроки = Товары.НайтиСтроки(ПараметрыОтбораСтрок);
				Если НайденныеСтроки.Количество() > 0 Тогда
					
					НакоплениеОбщее 	 = 0;
					ОстатокРаспределения = 0;
					НакоплениеПродажа 	 = 0;
					// определяем какое количество номенклатуры надо распределить по продажам
					Для каждого ЭлементМассива из НайденныеСтроки Цикл
						// оставляем только те строки где заполнен и заказ, и реализация	
						Если НЕ ЗначениеЗаполнено(ЭлементМассива.ЗаказПокупателя) ИЛИ НЕ ЗначениеЗаполнено(ЭлементМассива.ДокументПродажи) Тогда
							ОстатокРаспределения = ОстатокРаспределения + ЭлементМассива.Количество;
						КонецЕсли;
					КонецЦикла;
					// если распределять нечего, то идем дальше
					Если ОстатокРаспределения = 0 Тогда				
						Прервать;				
					КонецЕсли;
					
					ВыборкаПродаж = ВыборкаСерия.Выбрать();
					Пока ВыборкаПродаж.Следующий() Цикл
						НакоплениеОбщее = НакоплениеОбщее + ВыборкаПродаж.Количество;
						
						ВыборкаПродажКоличество = ВыборкаПродаж.Количество;
						// проверим уже распределенные в документе
						// на это количество уменьшим
						КоличествоРаспределенных = ТаблицаРаспределенных.Количество();
						Для Индекс = 1 по КоличествоРаспределенных Цикл
							СтрокаТаблицы = ТаблицаРаспределенных[КоличествоРаспределенных - Индекс];						
							Если СтрокаТаблицы.Номенклатура = ВыборкаНоменклатура.Номенклатура 
								И СтрокаТаблицы.ХарактеристикаНоменклатуры = ВыборкаХарактеристика.ХарактеристикаНоменклатуры 
								И СтрокаТаблицы.СерияНоменклатуры = ВыборкаСерия.СерияНоменклатуры 
								И СтрокаТаблицы.ДокументПродажи =  ВыборкаПродаж.Регистратор 
								И СтрокаТаблицы.ЗаказПокупателя = ВыборкаПродаж.ЗаказПокупателя Тогда		
								
								КоличествоУменьшения = Мин(СтрокаТаблицы.Количество, ВыборкаПродажКоличество);	
								СтрокаТаблицы.Количество = СтрокаТаблицы.Количество - КоличествоУменьшения;
								ВыборкаПродажКоличество  = ВыборкаПродажКоличество - КоличествоУменьшения;
							КонецЕсли;
							Если СтрокаТаблицы.Количество = 0 Тогда
								ТаблицаРаспределенных.Удалить(СтрокаТаблицы);
							КонецЕсли;							
						КонецЦикла;
												
						Если НакоплениеОбщее > 0 И ВыборкаПродажКоличество > 0 Тогда
							// возможно использование документа
							КоличествоРаспределения = Мин(ОстатокРаспределения, НакоплениеОбщее, ВыборкаПродажКоличество);
							
							НоваяСтрокаРаспределения = ТаблицаРаспределения.Добавить();
							НоваяСтрокаРаспределения.НомерСтроки = ВыборкаПродаж.НомерСтроки;
							НоваяСтрокаРаспределения.Номенклатура = ВыборкаНоменклатура.Номенклатура;
							НоваяСтрокаРаспределения.ХарактеристикаНоменклатуры = ВыборкаХарактеристика.ХарактеристикаНоменклатуры;
							НоваяСтрокаРаспределения.СерияНоменклатуры = ВыборкаСерия.СерияНоменклатуры;		
							
							НоваяСтрокаРаспределения.ДокументПродажи = ВыборкаПродаж.Регистратор;
							НоваяСтрокаРаспределения.ЗаказПокупателя = ВыборкаПродаж.ЗаказПокупателя;
							НоваяСтрокаРаспределения.Количество = КоличествоРаспределения;
							НоваяСтрокаРаспределения.Цена = ВыборкаПродаж.ЦенаПродажи; 							
							
							ОстатокРаспределения = ОстатокРаспределения - КоличествоРаспределения;
							
						КонецЕсли;
						
						Если ОстатокРаспределения <= 0 Тогда				
							Прервать;				
						КонецЕсли;	
					КонецЦикла;
				Иначе
					// не сошлись характеристики или серии, ничего не делаем
					Продолжить;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	
	
	Если ТаблицаРаспределения.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	РассчитатьБонусыКВозврату(ТаблицаРаспределения);
	
	ТаблицаРезультата = Товары.Выгрузить();
	ТоварыТЧ = Товары.Выгрузить();
	ТоварыТЧ.Очистить();

	//ТаблицаРезультата.Очистить();
	КоличествоРаспределенных = ТаблицаРезультата.Количество();
	Для Индекс = 1 по КоличествоРаспределенных Цикл
		СтрокаТаблицы = ТаблицаРезультата[КоличествоРаспределенных - Индекс];	
		Если НЕ ЗначениеЗаполнено(СтрокаТаблицы.ЗаказПокупателя) ИЛИ НЕ ЗначениеЗаполнено(СтрокаТаблицы.ДокументПродажи) Тогда
			
			НоваяСтрока = ТоварыТЧ.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы);
			
			ТаблицаРезультата.Удалить(СтрокаТаблицы);
				
		КонецЕсли;
	КонецЦикла;
	
	ТоварыТЧ.Свернуть("Номенклатура, ХарактеристикаНоменклатуры, СерияНоменклатуры, ЕдиницаИзмерения, Коэффициент", "Количество");
	
	Для каждого СтрокаТЧ из ТоварыТЧ Цикл
		ПараметрыОтбораСтрок = Новый Структура("Номенклатура, ХарактеристикаНоменклатуры, СерияНоменклатуры", СтрокаТЧ.Номенклатура, СтрокаТЧ.ХарактеристикаНоменклатуры, СтрокаТЧ.СерияНоменклатуры);		
		НайденныеСтроки = ТаблицаРаспределения.НайтиСтроки(ПараметрыОтбораСтрок);
		Если НайденныеСтроки.Количество() > 0 Тогда
			КоличествоКРаспределению = СтрокаТЧ.Количество;
			Для каждого ЭлементМассива из НайденныеСтроки Цикл
				НоваяСтрока = ТаблицаРезультата.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТЧ);
				НоваяСтрока.НомерСтроки 		= ЭлементМассива.НомерСтроки; // #15886
				НоваяСтрока.ДокументПродажи 	= ЭлементМассива.ДокументПродажи;
				НоваяСтрока.ЗаказПокупателя 	= ЭлементМассива.ЗаказПокупателя;
				НоваяСтрока.Количество 			= ЭлементМассива.Количество;
				НоваяСтрока.Цена 				= ЭлементМассива.Цена;
				НоваяСтрока.Сумма 				= ЭлементМассива.Количество * ЭлементМассива.Цена;
				НоваяСтрока.БонусыКНачислению 	= ЭлементМассива.Бонусы; 
				КоличествоКРаспределению 		= КоличествоКРаспределению - НоваяСтрока.Количество;	
				НоваяСтрока.ВариантОпределенияСебестоимости = Перечисления.ВариантыОпределенияСебестоимостиПоВозвратам.ПоДокументуПродажи;
				ОбработкаТабличныхЧастейКлиентСервер.ПересчитатьСуммуНДСВСтрокеТЧ(НоваяСтрока, УчитыватьНДС);
			КонецЦикла;
			
			// не все распределилось по документам
			Если КоличествоКРаспределению > 0 Тогда
				НоваяСтрока = ТаблицаРезультата.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТЧ);
				НоваяСтрока.Количество = КоличествоКРаспределению;
				НоваяСтрока.Сумма = 0;
				НоваяСтрока.Цена = 0;
				НоваяСтрока.ВариантОпределенияСебестоимости = Перечисления.ВариантыОпределенияСебестоимостиПоВозвратам.РучноеУказание;
				ОбработкаТабличныхЧастейКлиентСервер.ПересчитатьСуммуНДСВСтрокеТЧ(НоваяСтрока, УчитыватьНДС);
			КонецЕсли;
		Иначе
			НоваяСтрока = ТаблицаРезультата.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТЧ);
			НоваяСтрока.ВариантОпределенияСебестоимости = Перечисления.ВариантыОпределенияСебестоимостиПоВозвратам.ПоДокументуПродажи;
			ОбработкаТабличныхЧастейКлиентСервер.ПересчитатьСуммуНДСВСтрокеТЧ(НоваяСтрока, УчитыватьНДС);
		КонецЕсли;
	КонецЦикла;
	
	ТаблицаРезультата.Сортировать("НомерСтроки"); // #15886
	Товары.Загрузить(ТаблицаРезультата);
	
	//#13323
	Для каждого СтрокаТабличнойЧасти из Товары Цикл
		
		//++ №13856 способ компенсации смотрим по настройкам
		//СтрокаТабличнойЧасти.КомпенсацияПоВозврату = Перечисления.ВариантыКомпенсацииПоВозврату.ОтгрузитьПовторно;
		Если ЗначениеЗаполнено(СтрокаТабличнойЧасти.ЗаказПокупателя) Тогда
			СтрокаТабличнойЧасти.КомпенсацияПоВозврату = ОбщийМодульСервер.ПолучитьСпособКомпенсацииПоВозвратуТоваровОтПокупателя();
		Иначе
			СтрокаТабличнойЧасти.КомпенсацияПоВозврату = ПредопределенноеЗначение("Перечисление.ВариантыКомпенсацииПоВозврату.ПустаяСсылка");	
		КонецЕсли;
		//-- №13856
		
		СтрокаТабличнойЧасти.СтавкаНДС = СтавкаНДСПоУмолчанию;
		
		ОбработкаТабличныхЧастейКлиентСервер.ПересчитатьСуммуНДСВСтрокеТЧ(СтрокаТабличнойЧасти, УчитыватьНДС);	
		
	КонецЦикла;
	
КонецПроцедуры

Процедура РассчитатьБонусыКВозврату(ТаблицаРаспределенияПоПродажам)
	
	МассивРегистраторов = ТаблицаРаспределенияПоПродажам.ВыгрузитьКолонку("ДокументПродажи"); 
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РеализацияТоваровИУслугТовары.Номенклатура,
		|	РеализацияТоваровИУслугТовары.ХарактеристикаНоменклатуры,
		|	РеализацияТоваровИУслугТовары.СерияНоменклатуры,
		|	СУММА(РеализацияТоваровИУслугТовары.Количество) КАК Количество,
		|	СУММА(РеализацияТоваровИУслугТовары.Сумма) КАК Сумма,
		|	СУММА(РеализацияТоваровИУслугТовары.СкидкаБонусами) КАК СкидкаБонусами
		|ИЗ
		|	Документ.РеализацияТоваровИУслуг.Товары КАК РеализацияТоваровИУслугТовары
		|ГДЕ
		|	РеализацияТоваровИУслугТовары.Ссылка В(&МассивРегистраторов)
		|	И РеализацияТоваровИУслугТовары.СкидкаБонусами > 0
		|
		|СГРУППИРОВАТЬ ПО
		|	РеализацияТоваровИУслугТовары.Номенклатура,
		|	РеализацияТоваровИУслугТовары.ХарактеристикаНоменклатуры,
		|	РеализацияТоваровИУслугТовары.СерияНоменклатуры";
	
	Запрос.УстановитьПараметр("МассивРегистраторов", МассивРегистраторов);	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Если Выборка.Количество > 0 Тогда
			Коэф = Выборка.СкидкаБонусами / Выборка.Количество;
			ПараметрыОтбораСтрок = Новый Структура("Номенклатура, ХарактеристикаНоменклатуры, СерияНоменклатуры", Выборка.Номенклатура, Выборка.ХарактеристикаНоменклатуры, Выборка.СерияНоменклатуры);		
			НайденныеСтроки = ТаблицаРаспределенияПоПродажам.НайтиСтроки(ПараметрыОтбораСтрок);
			
			Если НайденныеСтроки.Количество() > 0 Тогда
				НайденныеСтроки[0].Бонусы = Коэф * НайденныеСтроки[0].Количество;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры
