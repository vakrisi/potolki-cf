#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
	
#Область ОбработчикиСобытий

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	
	Если ЭтоНовый() Тогда		
		ИнициализироватьСлужебныеРеквизиты();		
	КонецЕсли;
	
	ОбщийМодуль.ЗаполнитьШапкуДокумента(ЭтотОбъект);
		
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.РеализацияТоваровИУслуг") Тогда
		ЗаполнитьПоРеализации(ДанныеЗаполнения);
		
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ЗаказПокупателя") Тогда 
		ЗаполнитьПоЗаказуПокупателя(ДанныеЗаполнения);		
		
	//#12229
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ПриходныйКассовыйОрдер") Тогда
		ЗаполнитьПоПКО(ДанныеЗаполнения);
		
	КонецЕсли;
	
	СтатьяРасходов = ФинансыСервер.ПолучитьСтатьюДоходовРасходов(ЭтотОбъект, , Ложь);

	Если ЭтоНовый() Тогда
		ДозаполнитьПоУмолчанию();
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	
	ИнициализироватьСлужебныеРеквизиты(); 
	
	ДозаполнитьПоУмолчанию();
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)

	Если НЕ ЗначениеЗаполнено(Склад) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не заполнено поле ""Склад""!", ЭтотОбъект, "Склад", , Отказ);
	КонецЕсли;

	Для каждого СтрокаТабличнойЧасти из Товары Цикл
		Если СтрокаТабличнойЧасти.ВариантОпределенияСебестоимости = Перечисления.ВариантыОпределенияСебестоимостиПоВозвратам.ПоДокументуПродажи Тогда   // #12822
			Если ЗначениеЗаполнено(СтрокаТабличнойЧасти.ЗаказПокупателя) И НЕ ЗначениеЗаполнено(СтрокаТабличнойЧасти.ДокументПродажи) Тогда
				ТекстСообщения = "В строке " + СтрокаТабличнойЧасти.НомерСтроки + " не указан документ продажи при заполненном заказе покупателя!";
				ПолеДанных = "Товары[" + Строка(СтрокаТабличнойЧасти.НомерСтроки-1) + "].ДокументПродажи";
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, ЭтотОбъект, ПолеДанных, ,Отказ);
			КонецЕсли;
		КонецЕсли;
	
		Если СтрокаТабличнойЧасти.ВариантОпределенияСебестоимости = Перечисления.ВариантыОпределенияСебестоимостиПоВозвратам.ПоДокументуПродажи
			И НЕ ЗначениеЗаполнено(СтрокаТабличнойЧасти.ДокументПродажи) Тогда
			ТекстСообщения = "В строке " + СтрокаТабличнойЧасти.НомерСтроки + " не указан документ продажи при варианте определения себестоимости по документу продажи!";
			ПолеДанных = "Товары[" + Строка(СтрокаТабличнойЧасти.НомерСтроки-1) + "].ДокументПродажи";
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, ЭтотОбъект, ПолеДанных, ,Отказ);
		КонецЕсли;
		
		// #12822
		Если ЗначениеЗаполнено(СтрокаТабличнойЧасти.ЗаказПокупателя) И НЕ ЗначениеЗаполнено(СтрокаТабличнойЧасти.КомпенсацияПоВозврату) Тогда
			ТекстСообщения = "В строке " + СтрокаТабличнойЧасти.НомерСтроки + " не указан вариант компенсации по возврату при заполненном заказе покупателя!";
			ПолеДанных = "Товары[" + Строка(СтрокаТабличнойЧасти.НомерСтроки-1) + "].КомпенсацияПоВозврату";
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, ЭтотОбъект, ПолеДанных, ,Отказ);
		КонецЕсли;
		
		//++ #13232
		Если СтрокаТабличнойЧасти.Номенклатура.ВидНоменклатуры = Справочники.ВидыНоменклатуры.Услуга Тогда
			ТекстСообщения = "В строке " + СтрокаТабличнойЧасти.НомерСтроки + " выбрана номенклатура-услуга!";
			ПолеДанных = "Товары[" + Строка(СтрокаТабличнойЧасти.НомерСтроки-1) + "].Номенклатура";
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, ЭтотОбъект, ПолеДанных, ,Отказ);
		КонецЕсли;
		//-- #13232

	КонецЦикла;

КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	СуммаАванса = ПолучитьСуммуЗачета();
	
	Документы.ЗаказПокупателя.ПроверитьЗаполнениеНаОснованииЗаказа(ЭтотОбъект, Отказ, РежимЗаписи);
	
	// контроль остатков
	Если РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
		ВозвратПоПродажамИЗаказам = Товары.Выгрузить();
		ВозвратПоПродажамИЗаказам.Свернуть("Номенклатура,ХарактеристикаНоменклатуры,СерияНоменклатуры,ДокументПродажи,ЗаказПокупателя,Коэффициент", "Количество");
		ВозвратПоПродажам = ВозвратПоПродажамИЗаказам.Скопировать();
		ВозвратПоПродажам.Свернуть("Номенклатура,ХарактеристикаНоменклатуры,СерияНоменклатуры,ДокументПродажи,Коэффициент", "Количество");
		ВозвратПоЗаказам = ВозвратПоПродажамИЗаказам.Скопировать();
		ВозвратПоЗаказам.Свернуть("Номенклатура,ХарактеристикаНоменклатуры,СерияНоменклатуры,ЗаказПокупателя,Коэффициент", "Количество");

		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ПродажиОбороты.Номенклатура КАК Номенклатура,
		|	ПродажиОбороты.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
		|	ПродажиОбороты.СерияНоменклатуры КАК СерияНоменклатуры,
		|	ПродажиОбороты.ДокументПродажи КАК ДокументПродажи,
		|	ПродажиОбороты.ЗаказПокупателя КАК ЗаказПокупателя,
		|	СУММА(ПродажиОбороты.КоличествоОборот) КАК Количество
		|ИЗ
		|	РегистрНакопления.Продажи.Обороты(, , Регистратор, ) КАК ПродажиОбороты
		|ГДЕ
		|	ПродажиОбороты.Регистратор <> &Регистратор
		|	И (ПродажиОбороты.ДокументПродажи В (&МассивДокументовПродажи)
		//#12822 Разрешить проводить возврат если не указан заказ покупателя в строках, даже если РТиУ по заказу покупателя
		//|	И ПродажиОбороты.ЗаказПокупателя В (&МассивЗаказов))
		|	ИЛИ ПродажиОбороты.ЗаказПокупателя В (&МассивЗаказов))
		|
		|СГРУППИРОВАТЬ ПО
		|	ПродажиОбороты.Номенклатура,
		|	ПродажиОбороты.ХарактеристикаНоменклатуры,
		|	ПродажиОбороты.СерияНоменклатуры,
		|	ПродажиОбороты.ДокументПродажи,
		|	ПродажиОбороты.ЗаказПокупателя";
		
		Запрос.УстановитьПараметр("Регистратор", Ссылка);
		Запрос.УстановитьПараметр("МассивДокументовПродажи", ВозвратПоПродажам.ВыгрузитьКолонку("ДокументПродажи"));
		Запрос.УстановитьПараметр("МассивЗаказов", ВозвратПоЗаказам.ВыгрузитьКолонку("ЗаказПокупателя"));
		ТаблицаПродажРЗ = Запрос.Выполнить().Выгрузить();

		// сначала проверяем по связке РТИУ - ЗП
		Для каждого СтрокаТабличнойЧасти из ВозвратПоПродажамИЗаказам Цикл
			Если ЗначениеЗаполнено(СтрокаТабличнойЧасти.ЗаказПокупателя) И ЗначениеЗаполнено(СтрокаТабличнойЧасти.ДокументПродажи) Тогда
				Отбор = Новый Структура;
				Отбор.Вставить("Номенклатура", 				 СтрокаТабличнойЧасти.Номенклатура);
				Отбор.Вставить("ХарактеристикаНоменклатуры", СтрокаТабличнойЧасти.ХарактеристикаНоменклатуры);
				Отбор.Вставить("СерияНоменклатуры", 		 СтрокаТабличнойЧасти.СерияНоменклатуры);
				Отбор.Вставить("ДокументПродажи", 			 СтрокаТабличнойЧасти.ДокументПродажи);
				Отбор.Вставить("ЗаказПокупателя", 			 СтрокаТабличнойЧасти.ЗаказПокупателя);
				
				НайденныеСтроки = ТаблицаПродажРЗ.НайтиСтроки(Отбор);
				Если НайденныеСтроки.Количество() > 0 Тогда
					Если СтрокаТабличнойЧасти.Количество*СтрокаТабличнойЧасти.Коэффициент > НайденныеСтроки[0].Количество Тогда
						ТекстОшибки = "По позиции """ + СтрокаТабличнойЧасти.Номенклатура + ОбщийМодульСервер.ПредставлениеХарактеристики(СтрокаТабличнойЧасти.ХарактеристикаНоменклатуры) + 
									  """ возвращается (" + СтрокаТабличнойЧасти.Количество*СтрокаТабличнойЧасти.Коэффициент + ") больше, чем продано (" + НайденныеСтроки[0].Количество + ")";
						ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки, ЭтотОбъект, , ,Отказ);
					КонецЕсли;
				Иначе
					ТекстОшибки = "По позиции """ + СтрокаТабличнойЧасти.Номенклатура + ОбщийМодульСервер.ПредставлениеХарактеристики(СтрокаТабличнойЧасти.ХарактеристикаНоменклатуры) + 
									  """ отсутствуют данные по продажам в указанных документах";
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки, ЭтотОбъект, , ,Отказ);
				КонецЕсли;
			КонецЕсли;	
		КонецЦикла;
		
		// проверяем по РТИУ
		Если НЕ Отказ Тогда
			ТаблицаПродаж = ТаблицаПродажРЗ.Скопировать();
			ТаблицаПродаж.Свернуть("Номенклатура,ХарактеристикаНоменклатуры,СерияНоменклатуры,ДокументПродажи", "Количество");
			Для каждого СтрокаТабличнойЧасти из ВозвратПоПродажам Цикл
				Если ЗначениеЗаполнено(СтрокаТабличнойЧасти.ДокументПродажи) Тогда
					Отбор = Новый Структура;
					Отбор.Вставить("Номенклатура", 				 СтрокаТабличнойЧасти.Номенклатура);
					Отбор.Вставить("ХарактеристикаНоменклатуры", СтрокаТабличнойЧасти.ХарактеристикаНоменклатуры);
					Отбор.Вставить("СерияНоменклатуры", 		 СтрокаТабличнойЧасти.СерияНоменклатуры);
					Отбор.Вставить("ДокументПродажи", 			 СтрокаТабличнойЧасти.ДокументПродажи);
					
					НайденныеСтроки = ТаблицаПродаж.НайтиСтроки(Отбор);
					Если НайденныеСтроки.Количество() > 0 Тогда
						Если СтрокаТабличнойЧасти.Количество*СтрокаТабличнойЧасти.Коэффициент > НайденныеСтроки[0].Количество Тогда
							ТекстОшибки = "По позиции """ + СтрокаТабличнойЧасти.Номенклатура + ОбщийМодульСервер.ПредставлениеХарактеристики(СтрокаТабличнойЧасти.ХарактеристикаНоменклатуры) + 
											""" возвращается (" + СтрокаТабличнойЧасти.Количество*СтрокаТабличнойЧасти.Коэффициент + ") больше, чем продано (" + НайденныеСтроки[0].Количество + ")";
							ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки, ЭтотОбъект, , ,Отказ);
						КонецЕсли;
					Иначе
						ТекстОшибки = "По позиции """ + СтрокаТабличнойЧасти.Номенклатура + ОбщийМодульСервер.ПредставлениеХарактеристики(СтрокаТабличнойЧасти.ХарактеристикаНоменклатуры) + 
										""" отсутствуют данные по продажам в указанных документах";
						ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки, ЭтотОбъект, , ,Отказ);
					КонецЕсли;
				КонецЕсли;	
			КонецЦикла;
		КонецЕсли;
		
		// проверяем по ЗП
		Если НЕ Отказ Тогда
			ТаблицаПродаж = ТаблицаПродажРЗ.Скопировать();
			ТаблицаПродаж.Свернуть("Номенклатура,ХарактеристикаНоменклатуры,СерияНоменклатуры,ЗаказПокупателя", "Количество");
			Для каждого СтрокаТабличнойЧасти из ВозвратПоЗаказам Цикл
				Если ЗначениеЗаполнено(СтрокаТабличнойЧасти.ЗаказПокупателя) Тогда
					Отбор = Новый Структура;
					Отбор.Вставить("Номенклатура", 				 СтрокаТабличнойЧасти.Номенклатура);
					Отбор.Вставить("ХарактеристикаНоменклатуры", СтрокаТабличнойЧасти.ХарактеристикаНоменклатуры);
					Отбор.Вставить("СерияНоменклатуры", 		 СтрокаТабличнойЧасти.СерияНоменклатуры);
					Отбор.Вставить("ЗаказПокупателя", 			 СтрокаТабличнойЧасти.ЗаказПокупателя);
					
					НайденныеСтроки = ТаблицаПродаж.НайтиСтроки(Отбор);
					Если НайденныеСтроки.Количество() > 0 Тогда
						Если СтрокаТабличнойЧасти.Количество*СтрокаТабличнойЧасти.Коэффициент > НайденныеСтроки[0].Количество Тогда
							ТекстОшибки = "По позиции """ + СтрокаТабличнойЧасти.Номенклатура + ОбщийМодульСервер.ПредставлениеХарактеристики(СтрокаТабличнойЧасти.ХарактеристикаНоменклатуры) + 
											""" возвращается (" + СтрокаТабличнойЧасти.Количество*СтрокаТабличнойЧасти.Коэффициент + ") больше, чем продано (" + НайденныеСтроки[0].Количество + ")";
							ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки, ЭтотОбъект, , ,Отказ);
						КонецЕсли;
					Иначе
						ТекстОшибки = "По позиции """ + СтрокаТабличнойЧасти.Номенклатура + ОбщийМодульСервер.ПредставлениеХарактеристики(СтрокаТабличнойЧасти.ХарактеристикаНоменклатуры) + 
										""" отсутствуют данные по продажам в указанных документах";
						ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки, ЭтотОбъект, , ,Отказ);
					КонецЕсли;
				КонецЕсли;	
			КонецЦикла;
		КонецЕсли;
	
	КонецЕсли;
	
	//#13710
	ОбщийМодульСервер.ПроверитьИзменениеВзаиморасчетовПередЗаписью(ЭтотОбъект, РежимЗаписи);
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, Режим)

	// Проверка заполненности склада при проведении (в т.ч. при программном проведении).
	Если НЕ ЗначениеЗаполнено(Склад) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не заполнено поле ""Склад""!", ЭтотОбъект, "Склад", , Отказ);
		Возврат;
	КонецЕсли;

	ВалютаУчета = ПолучитьФункциональнуюОпцию("ВалютаУчета"); //Константы.ВалютаУчета.Получить();
	
	ОрганизацияТоваров = Организация;
	Если Константы.ОбщиеСклады.Получить() Тогда
		ОрганизацияТоваров = Справочники.Организации.ПустаяСсылка();
	КонецЕсли;     
	
	РеквизитыПользователя = ОбщийМодульСервер.НастройкиПользователя("РазрешеноПроводитьДокументВозвратТоваровОтПокупателяБезПроверкиСроковВозврата");  //nva
	//nva+++
	Если ПревышенСрокВозврата() И НЕ РеквизитыПользователя.РазрешеноПроводитьДокументВозвратТоваровОтПокупателяБезПроверкиСроковВозврата Тогда
		Отказ = Истина;
		Возврат;       
	КонецЕсли;
	//nva---
	МассивДокументовПродажи = Товары.ВыгрузитьКолонку("ДокументПродажи");
	ТаблицаСебестоимости = ОбщийМодульСервер.ТаблицаСебестоимостиПродаж(МассивДокументовПродажи);
	//ТаблицаСебестоимости = Новый ТаблицаЗначений;
	//Если МассивДокументовПродажи.Количество() > 0 Тогда
	//	Запрос = Новый Запрос;
	//	Запрос.Текст = 
	//	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	//	|	ТоварыНаСкладахОбороты.Номенклатура КАК Номенклатура,
	//	|	ТоварыНаСкладахОбороты.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	//	|	ТоварыНаСкладахОбороты.СерияНоменклатуры КАК СерияНоменклатуры,
	//	|	ТоварыНаСкладахОбороты.Регистратор КАК Регистратор,
	//	|	ТоварыНаСкладахОбороты.КоличествоРасход КАК Количество,
	//	|	ТоварыНаСкладахОбороты.СуммаРасход КАК Сумма,
	//	|	ВЫБОР
	//	|		КОГДА НЕ ТоварыНаСкладахОбороты.КоличествоРасход = 0
	//	|			ТОГДА ТоварыНаСкладахОбороты.СуммаРасход / ТоварыНаСкладахОбороты.КоличествоРасход
	//	|		ИНАЧЕ 0
	//	|	КОНЕЦ КАК Цена,
	//	|	ВЫБОР
	//	|		КОГДА НЕ ТоварыНаСкладахОбороты.КоличествоРасход = 0
	//	|			ТОГДА ТоварыНаСкладахОбороты.СуммаВалРасход / ТоварыНаСкладахОбороты.КоличествоРасход
	//	|		ИНАЧЕ 0
	//	|	КОНЕЦ КАК ЦенаВал
	//	|ИЗ
	//	|	РегистрНакопления.ТоварыНаСкладах.Обороты(, , Регистратор, ) КАК ТоварыНаСкладахОбороты
	//	|ГДЕ
	//	|	ТоварыНаСкладахОбороты.Регистратор В(&МассивДокументовПродажи)";
	//	
	//	Запрос.УстановитьПараметр("МассивДокументовПродажи", МассивДокументовПродажи);
	//	ТаблицаСебестоимости = Запрос.Выполнить().Выгрузить();
	//КонецЕсли;

	// регистр ТоварыНаСкладах
	Движения.ТоварыНаСкладах.Записывать = Истина;
	Для Каждого Товар Из Товары Цикл
		Если Справочники.ВидыНоменклатуры.ЭтоНоменклатураУслуга(Товар.Номенклатура) Тогда
			Продолжить;
		КонецЕсли;
		Приход = Движения.ТоварыНаСкладах.Добавить();
		Приход.ВидДвижения = ВидДвиженияНакопления.Приход;
		Приход.Период = Дата;
		Приход.Организация = ОрганизацияТоваров;
		Приход.Склад = Склад;
		Приход.Номенклатура = Товар.Номенклатура;
		Приход.ХарактеристикаНоменклатуры = Товар.ХарактеристикаНоменклатуры;
		Приход.СерияНоменклатуры = Товар.СерияНоменклатуры;
		Приход.Количество = Товар.Количество * Товар.Коэффициент;
		
		//Если ЗначениеЗаполнено(Товар.ДокументПродажи) Тогда
		Если Товар.ВариантОпределенияСебестоимости = Перечисления.ВариантыОпределенияСебестоимостиПоВозвратам.ПоДокументуПродажи Тогда
			Если ТаблицаСебестоимости.Количество() > 0 Тогда
				Отбор = Новый Структура;
				Отбор.Вставить("Номенклатура", 				 Товар.Номенклатура);
				Отбор.Вставить("ХарактеристикаНоменклатуры", Товар.ХарактеристикаНоменклатуры);
				Отбор.Вставить("СерияНоменклатуры", 		 Товар.СерияНоменклатуры);
				Отбор.Вставить("Регистратор", 				 Товар.ДокументПродажи);
				
				НайденныеСтроки = ТаблицаСебестоимости.НайтиСтроки(Отбор);
				Если НайденныеСтроки.Количество() > 0 Тогда
					Приход.Сумма = НайденныеСтроки[0].Цена * Приход.Количество;
					Приход.Суммавал = НайденныеСтроки[0].ЦенаВал * Приход.Количество;
				Иначе
					Приход.Сумма = 0; //РаботаСВалютой.ПолучитьСуммуВВалютеУчетаПоДокументу(Ссылка, Товар.Сумма);
				КонецЕсли;
			Иначе
				Приход.Сумма = 0; //РаботаСВалютой.ПолучитьСуммуВВалютеУчетаПоДокументу(Ссылка, Товар.Сумма);
			КонецЕсли;
		Иначе
			Если Товар.СебестоимостьЗаЕдиницу <> 0 Тогда
				Приход.Сумма = РаботаСВалютой.ПолучитьСуммуВВалютеУчетаПоДокументу(Ссылка, Товар.СебестоимостьЗаЕдиницу * Приход.Количество);
				Приход.СуммаВал = РаботаСВалютой.ПолучитьСуммуВДопВалютеУчетаПоДокументу(Ссылка, Товар.СебестоимостьЗаЕдиницу * Приход.Количество); //#8288
			Иначе
				Приход.Сумма = 0; //РаботаСВалютой.ПолучитьСуммуВВалютеУчетаПоДокументу(Ссылка, Товар.Сумма);
			КонецЕсли;			
		КонецЕсли;
		
	КонецЦикла;
	
	//запись взаиморасчетов
	ВремСуммаДокумента = 0;
	ВремСуммаДокумента = Товары.Итог("Сумма");
	Если НЕ Движения.ВзаиморасчетыСКонтрагентами.ВыполнитьРасход(Ссылка, Организация, Контрагент, ДоговорКонтрагента, ВремСуммаДокумента) Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	//Взаиморасчеты с контрагентами в валюте
	Движения.ВзаиморасчетыСКонтрагентамиВВалюте.Записывать = Истина;
	Движение = Движения.ВзаиморасчетыСКонтрагентамиВВалюте.Добавить();
	Движение.ВидДвижения =ВидДвиженияНакопления.Расход;
	Движение.Период = Дата;
	Движение.Организация = Организация;
	Движение.Контрагент = Контрагент;
	Движение.Договор = ДоговорКонтрагента;
	Движение.Валюта = Валюта;
	Движение.Сумма = СуммаДокумента;
	
	//продажи
	//ТаблицаПоЗаказам = ПолучитьТаблицуПоЗаказамВПродажах(Товары.ВыгрузитьКолонку("ДокументПродажи"));
	Движения.Продажи.Записывать = Истина;
	Для Каждого ТекущаяСтрока Из Товары Цикл
		Движение = Движения.Продажи.Добавить();
		Движение.Период = Дата;
		Движение.Организация = Организация;
		Движение.Подразделение = Подразделение;
		Движение.Склад = Склад;
		Движение.ДоговорКонтрагента = ДоговорКонтрагента;
		Движение.ДокументПродажи = ТекущаяСтрока.ДокументПродажи; //?(ЗначениеЗаполнено(ТекущаяСтрока.ДокументПродажи), ТекущаяСтрока.ДокументПродажи, Основание);
		Движение.ЗаказПокупателя = ТекущаяСтрока.ЗаказПокупателя;
		Движение.Контрагент = Контрагент;
		Движение.Номенклатура = ТекущаяСтрока.Номенклатура;
		Движение.ХарактеристикаНоменклатуры = ТекущаяСтрока.ХарактеристикаНоменклатуры;
		Движение.СерияНоменклатуры = ТекущаяСтрока.СерияНоменклатуры;
		Движение.ЕдиницаИзмерения = ТекущаяСтрока.ЕдиницаИзмерения;         //#14300
		Движение.КоличествоВЕдиницахДокумента = -ТекущаяСтрока.Количество;	//#14300
		Движение.Количество = -ТекущаяСтрока.Количество * ТекущаяСтрока.Коэффициент;	
		Движение.Сумма = -РаботаСВалютой.ПересчитатьИзВалютыВВалюту(Валюта, ВалютаУчета, Дата, ТекущаяСтрока.Сумма);
		Движение.СуммаВал = -РаботаСВалютой.ПолучитьСуммуВДопВалютеУчетаПоДокументу(Ссылка, ТекущаяСтрока.Сумма); //#8288
	КонецЦикла;
	
	//БонусыКонтрагентов
	Если СлужебныйВидБонуснойСистемы = Перечисления.ВидыБонусныхСистем.Внутренняя 
		И СуммаБонусовКНачислениюПоДисконтнойКарте > 0 
		И ((СлужебныйУчетБонусовПоДисконтнымКартам И НЕ ДисконтнаяКарта.Пустая())
		    ИЛИ НЕ СлужебныйУчетБонусовПоДисконтнымКартам) Тогда
		
		Движения.БонусыКонтрагентов.Записывать = Истина;

		Движение = Движения.БонусыКонтрагентов.Добавить();
		Движение.Период = Дата;
		Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
		Движение.ДисконтнаяКарта = ?(СлужебныйУчетБонусовПоДисконтнымКартам, ДисконтнаяКарта, Справочники.ДисконтныеКарты.ПустаяСсылка());
		Движение.Контрагент = Контрагент;
		Движение.Сумма = -СуммаБонусовКНачислениюПоДисконтнойКарте;
		
	КонецЕсли;
	
	// регистр ДоходыРасходы
	Если ПараметрыСеанса.ФинРезультатИспользоватьВедениеУчетаДоходовРасходов Тогда
		Если ПараметрыСеанса.ФинРезультатНеКассовыйМетодВеденияУчетаДоходовРасходов Тогда
			//некассовый метод			
			Метод = Перечисления.МетодыВеденияУчетаДоходовРасходов.Некассовый;
			Движения.ДоходыРасходы.Записывать = Истина;
			Для Каждого ТекущаяСтрока Из Товары Цикл
				Статья = ?(НЕ ТекущаяСтрока.СтатьяРасходов.Пустая(), ТекущаяСтрока.СтатьяРасходов, СтатьяРасходов);
				Если Статья.Пустая() ИЛИ ТекущаяСтрока.Сумма = 0 Тогда
					Продолжить;
				КонецЕсли;				
				Движение = Движения.ДоходыРасходы.Добавить();
				Движение.Период 		= Дата;
				Движение.Организация 	= Организация;
				Движение.Подразделение 	= Подразделение;
				Движение.Статья 		= Статья;
				Движение.Метод		 	= Метод;
				Движение.СуммаДоходов 	= 0;
				Движение.СуммаРасходов 	= РаботаСВалютой.ПолучитьСуммуВВалютеУчетаПоДокументу(Ссылка, ТекущаяСтрока.Сумма);				
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	
	//++ №8749
	Движения.ЗаказыПокупателей.Записывать = Истина;
	Для Каждого ТекущаяСтрока Из Товары Цикл
		
		Если ТекущаяСтрока.ЗаказПокупателя.Пустая() 
			ИЛИ ТекущаяСтрока.КомпенсацияПоВозврату = Перечисления.ВариантыКомпенсацииПоВозврату.ЗачестьВернуть //#12822
			Тогда
			Продолжить;
		КонецЕсли;	
			
		Движение = Движения.ЗаказыПокупателей.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
		Движение.Период = Дата;
		Движение.ЗаказНаПроизводство = ТекущаяСтрока.ЗаказПокупателя;
		Движение.Организация = Организация;
		Движение.Контрагент = Контрагент;
		Движение.Номенклатура = ТекущаяСтрока.Номенклатура;
		Движение.ХарактеристикаНоменклатуры = ТекущаяСтрока.ХарактеристикаНоменклатуры;
		Движение.СерияНоменклатуры = ТекущаяСтрока.СерияНоменклатуры;
		Движение.Количество = -(ТекущаяСтрока.Количество * ТекущаяСтрока.Коэффициент);
		Движение.Сумма = -(ТекущаяСтрока.Сумма + ТекущаяСтрока.БонусыКНачислению); //#9777, #10397
		
	КонецЦикла;
	
	// РасчетыПоЗаказам
	Движения.РасчетыПоЗаказам.Записывать = Истина;
	СписокВидовДокументовПоКоторымВедутсяРасчеты = ОбщийМодуль.ПолучитьМассивТиповДокументовПоКоторымВедутсяРасчетыПоЗаказам();
	
	//#12822 убрано движение  #15471 возвращено с допусловием
	Если НЕ СписокВидовДокументовПоКоторымВедутсяРасчеты.Найти(Тип("ДокументСсылка.РеализацияТоваровИУслуг")) = Неопределено Тогда
		Для Каждого ТекущаяСтрока из Товары Цикл			
			Если НЕ ТекущаяСтрока.ДокументПродажи.Пустая()
				И НЕ ТекущаяСтрока.ЗаказПокупателя.Пустая()
				И ТекущаяСтрока.КомпенсацияПоВозврату = Перечисления.ВариантыКомпенсацииПоВозврату.ОтгрузитьПовторно  //#15471
				Тогда				
				Движение = Движения.РасчетыПоЗаказам.Добавить();
				Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
				Движение.Период 	 = Дата;
				Движение.Заказ 		 = ТекущаяСтрока.ДокументПродажи;			
				Движение.Контрагент  = Контрагент;
				Движение.Сумма 		 = ТекущаяСтрока.Сумма;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	//++ #12822 в таблице указываются заказы, которые будут созданы после возврата
	// и данная таблица выступает как зачет оплаты	
	Для Каждого ТекущаяСтрока Из ЗачетАванса Цикл
		Если ТекущаяСтрока.Сумма = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		НайденныйВидДокумента = СписокВидовДокументовПоКоторымВедутсяРасчеты.Найти(ТипЗнч(ТекущаяСтрока.Документ));
		Если НайденныйВидДокумента = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Движение = Движения.РасчетыПоЗаказам.Добавить();
		Движение.Период = Дата;
		Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
		Движение.Заказ = ТекущаяСтрока.Документ;
		Движение.Контрагент = Контрагент;
		Если ТекущаяСтрока.Документ.Валюта = Валюта ИЛИ ТекущаяСтрока.СуммаВВалютеДокумента = 0 Тогда 
			Движение.Сумма = ТекущаяСтрока.Сумма;
		Иначе
			Движение.Сумма = ТекущаяСтрока.СуммаВВалютеДокумента; 
		КонецЕсли; 
		
	КонецЦикла;
	//-- #12822
	
КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	//#13710
	ОбщийМодульСервер.ПроверитьИзменениеВзаиморасчетовПриЗаписи(ЭтотОбъект, Отказ);
	
КонецПроцедуры

#КонецОбласти

#Область Заполнение

Процедура ИнициализироватьСлужебныеРеквизиты()
	
	//#14828
	СозданПриИспользованииПодразделений  = Константы.ИспользоватьПодразделения.Получить();
	
	Если ПолучитьФункциональнуюОпцию("УчетБонусов") Тогда
		СлужебныйУчитыватьБонусы 				= Константы.УчитыватьБонусы.Получить();
		СлужебныйУчетБонусовПоДисконтнымКартам 	= Константы.УчетБонусовПоДисконтнымКартам.Получить();
		СлужебныйВидБонуснойСистемы 			= Константы.ВидБонуснойСистемы.Получить();
	КонецЕсли;
		
КонецПроцедуры

Процедура ДозаполнитьПоУмолчанию()

	// Склад по умолчанию из настроек текущего пользователя (реквизит "Склад" справочника Пользователи).
	// Имеет приоритет, в том числе при вводе на основании; если у пользователя склад не задан,
	// остаётся склад из документа-основания.
	РеквизитыПользователя = ОбщийМодульСервер.НастройкиПользователя("Склад");
	Если ЗначениеЗаполнено(РеквизитыПользователя.Склад) Тогда
		Склад = РеквизитыПользователя.Склад;
	КонецЕсли;

КонецПроцедуры

Процедура ЗаполнитьПоРеализации(ДанныеЗаполнения)
	
	Основание 			= ДанныеЗаполнения.Ссылка;
	Валюта 				= ДанныеЗаполнения.Валюта;
	Организация 		= ДанныеЗаполнения.Организация;
	Контрагент 			= ДанныеЗаполнения.Контрагент;
	ДоговорКонтрагента 	= ДанныеЗаполнения.ДоговорКонтрагента;
	Склад 				= ДанныеЗаполнения.Склад;
	Подразделение 		= ДанныеЗаполнения.Подразделение;
	ДисконтнаяКарта 	= ДанныеЗаполнения.ДисконтнаяКарта;
	ЗаполнитьТабличнуюЧастьПоОснованию(ДанныеЗаполнения)
	
КонецПроцедуры

Процедура ЗаполнитьПоЗаказуПокупателя(ДанныеЗаполнения)
	
	Документы.ЗаказПокупателя.ПроверитьВозможностьВводаНаОснованииЗаказа(ДанныеЗаполнения);
	
	Основание = ДанныеЗаполнения;
	Организация = ДанныеЗаполнения.Организация;
	Контрагент = ДанныеЗаполнения.Контрагент;
	ДоговорКонтрагента = ДанныеЗаполнения.ДоговорКонтрагента;
	Склад = ДанныеЗаполнения.Склад;
	Подразделение = ДанныеЗаполнения.Подразделение;
	ЗаполнитьТабличнуюЧастьПоОснованию(ДанныеЗаполнения);
	
	ЗаполнитьДокументыПродажиПоПоследнимПродажамНаСервере(ДанныеЗаполнения); // №14054
	
КонецПроцедуры

Процедура ЗаполнитьПоПКО(ДанныеЗаполнения)
	
	Если НЕ ДанныеЗаполнения.ВидОперации = Перечисления.ВидыОперацийПриходныйКассовыйОрдер.ОплатаОтПокупателя Тогда
		ВызватьИсключение "Не предусмотрен ввод на основании документа с этим видом операции";
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	ДанныеДокумента.Документ КАК Документ,
	|	ВЫБОР
