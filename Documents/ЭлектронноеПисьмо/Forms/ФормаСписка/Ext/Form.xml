	ДокументЭлектронноеПисьмо.Проведен КАК Проведен,
	ДокументЭлектронноеПисьмо.IDПисьма КАК IDПисьма,
	ВЫБОР
		КОГДА ДокументЭлектронноеПисьмо.АдресОтправителя = ""
			ТОГДА ДокументЭлектронноеПисьмо.Отправитель
		ИНАЧЕ ДокументЭлектронноеПисьмо.АдресОтправителя
	КОНЕЦ КАК АдресОтправителя,
	ДокументЭлектронноеПисьмо.АдресПолучателя КАК АдресПолучателя,
	ДокументЭлектронноеПисьмо.Входящее КАК Входящее,
	//ДокументЭлектронноеПисьмо.ДатаОтправки КАК ДатаОтправки,
	ДокументЭлектронноеПисьмо.Заголовок КАК Заголовок,
	ДокументЭлектронноеПисьмо.Комментарий КАК Комментарий,
	ДокументЭлектронноеПисьмо.Контрагент КАК Контрагент,
	ДокументЭлектронноеПисьмо.Лид КАК Лид,
	ДокументЭлектронноеПисьмо.Обработан КАК Обработан,
	ДокументЭлектронноеПисьмо.Основание КАК Основание,
	ДокументЭлектронноеПисьмо.Автор КАК Автор,
	ДокументЭлектронноеПисьмо.Отправитель КАК Отправитель,
	ДокументЭлектронноеПисьмо.Отправлен КАК Отправлен,
	ДокументЭлектронноеПисьмо.ТекстПисьма КАК ТекстПисьма,
	ДокументЭлектронноеПисьмо.ТекстHTML КАК ТекстHTML,
	//ДокументЭлектронноеПисьмо.Получатели.(
	//	Ссылка КАК Ссылка,
	//	НомерСтроки КАК НомерСтроки,
	//	Контрагент КАК Контрагент,
	//	Email КАК Email
	//) КАК Получатели,
	ДокументЭлектронноеПисьмо.МоментВремени КАК МоментВремени,
	//++ №8201
	ВЫБОР
		КОГДА ЕСТЬNULL(ЭлектронноеПисьмоПолучатели.ЧислоСтрок, 0) &gt; 0
			ТОГДА ЭлектронноеПисьмоПолучатели.ДатаОтправки
		ИНАЧЕ ДокументЭлектронноеПисьмо.ДатаОтправки
	КОНЕЦ КАК ДатаОтправки,
	ВЫБОР
		КОГДА ДокументЭлектронноеПисьмо.Отправлен ИЛИ (ЕСТЬNULL(ЭлектронноеПисьмоПолучатели.ЧислоСтрок, 0) &gt; 0 И ЕСТЬNULL(ЭлектронноеПисьмоПолучатели.ЧислоСтрок, 0) = ЕСТЬNULL(ЭлектронноеПисьмоПолучатели.СтрокОтправлено, 0))
			ТОГДА 0 // Полностью отправлено
		КОГДА (ЕСТЬNULL(ЭлектронноеПисьмоПолучатели.ЧислоСтрок, 0) &gt; 0 И ЕСТЬNULL(ЭлектронноеПисьмоПолучатели.ЧислоСтрок, 0) &gt; ЕСТЬNULL(ЭлектронноеПисьмоПолучатели.СтрокОтправлено, 0))
			ТОГДА 1 // Частично отправлено
		ИНАЧЕ 2 // Не отправлено
	КОНЕЦ КАК ИндикаторОтправки
	//-- №8201
ИЗ
	Документ.ЭлектронноеПисьмо КАК ДокументЭлектронноеПисьмо
	
		//++ №8201
		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
				ЭлектронноеПисьмоПолучатели.Ссылка,
				СУММА(1) КАК ЧислоСтрок,
				СУММА(ВЫБОР
					КОГДА ЭлектронноеПисьмоПолучатели.Отправлено
						ТОГДА 1
					ИНАЧЕ 0
				КОНЕЦ) КАК СтрокОтправлено,
				МАКСИМУМ(ЭлектронноеПисьмоПолучатели.ДатаОтправки) КАК ДатаОтправки
			ИЗ
				Документ.ЭлектронноеПисьмо.Получатели КАК ЭлектронноеПисьмоПолучатели
			
			СГРУППИРОВАТЬ ПО
				ЭлектронноеПисьмоПолучатели.Ссылка) КАК ЭлектронноеПисьмоПолучатели
		ПО ДокументЭлектронноеПисьмо.Ссылка = ЭлектронноеПисьмоПолучатели.Ссылка	
		//-- №8201
		</QueryText>
