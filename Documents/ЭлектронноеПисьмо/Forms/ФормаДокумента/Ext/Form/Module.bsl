&НаКлиенте
Процедура Отправить(Команда)
	
	Отказ = Ложь;
	Если Объект.Отправитель.Пустая() Тогда
		Сообщение = Новый СообщениеПользователю();
		Сообщение.Текст = "Не указан отправитель";
		Сообщение.Поле = "Объект.Отправитель";
		Сообщение.УстановитьДанные(ЭтотОбъект);
		Сообщение.Сообщить();
		Отказ = Истина;
	КонецЕсли;
	//Если Объект.Получатели.Количество() > 1 Тогда 
	//Сделали >= 1 потому, что если клиент установит галочку Несколько получателей, тогда 
	//Проверка на валидность email будет проходить в поле Получатель, хотя будет показана таблица 
	//со списком получателей, даже если там он один
	Если Объект.Получатели.Количество() >= 1 Тогда
		Для Каждого Строка Из Объект.Получатели Цикл
			Если ПустаяСтрока(Строка.Email) Тогда
				Сообщение = Новый СообщениеПользователю();
				Сообщение.Текст = "Не указан получатель";
				Сообщение.Поле = "Объект.Получатели";
				Сообщение.УстановитьДанные(ЭтотОбъект);
				Сообщение.Сообщить();
				Отказ = Истина;
			КонецЕсли;
			
			Если Не АдресВалидный(Строка.Email) И Не ПустаяСтрока(Строка.Email) Тогда
				Сообщение = Новый СообщениеПользователю();
				Сообщение.Текст = "Неверный email адрес получателя"; 
				Сообщение.Поле = "Объект.Получатели";
				Сообщение.УстановитьДанные(ЭтотОбъект);
				Сообщение.Сообщить();
				Отказ = Истина;
			КонецЕсли;				
		КонецЦикла;
	Иначе
		Если ПустаяСтрока(Объект.АдресПолучателя) Тогда
			Сообщение = Новый СообщениеПользователю();
			Сообщение.Текст = "Не указан получатель";
			Сообщение.Поле = "Объект.АдресПолучателя";
			Сообщение.УстановитьДанные(ЭтотОбъект);
			Сообщение.Сообщить();
			Отказ = Истина;
		КонецЕсли;
		
		Если Не АдресВалидный(Объект.АдресПолучателя) И Не ПустаяСтрока(Объект.АдресПолучателя) Тогда
			Сообщение = Новый СообщениеПользователю();
			Сообщение.Текст = "Не верно указан email получателя";
			Сообщение.Поле = "Объект.АдресПолучателя";
			Сообщение.УстановитьДанные(ЭтотОбъект);
			Сообщение.Сообщить();
			Отказ = Истина;
		КонецЕсли;
	КонецЕсли;
	Если ПустаяСтрока(Объект.Заголовок) Тогда
		Сообщение = Новый СообщениеПользователю();
		Сообщение.Текст = "Не указан заголовок письма";
		Сообщение.Поле = "Объект.Заголовок";
		Сообщение.УстановитьДанные(ЭтотОбъект);
		Сообщение.Сообщить();
		Отказ = Истина;
	КонецЕсли;
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	ЭтаФорма.Записать();
	РезультатОтправки = ОтправитьНаСервере();
	Если НЕ ПустаяСтрока(РезультатОтправки) Тогда
		Сообщить(РезультатОтправки);
		Прочитать(); //++ №8201 чтобы данные перечитались, т.к. модификация объекта происходит вне формы
		ОбновитьФорму();
	Иначе
		ЭтаФорма.Закрыть();
	КонецЕсли;

КонецПроцедуры

