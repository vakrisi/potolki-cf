
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Ключ.Пустая() Тогда
		
		Если НЕ Объект.Автор.УчетнаяЗаписьЭлектроннойПочты.Пустая() Тогда
			Объект.Отправитель = Объект.Автор.УчетнаяЗаписьЭлектроннойПочты;
			ОтправительПриИзмененииНаСервере();
		Иначе
			Объект.Отправитель = Константы.УчетнаяЗаписьЭлектроннойПочтыПоУмолчанию.Получить();
			ОтправительПриИзмененииНаСервере();
		КонецЕсли;
		
	Иначе
		ЭтаФорма.ТолькоПросмотр = ПраваПользователей.ДокументТолькоПросмотр(Объект.Ссылка);
	КонецЕсли;
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
		
	//Если ТипЗнч(Объект.Контрагент) = Тип("СправочникСсылка.Контрагенты") Тогда
	//	Элементы.КонтрагентДополнительно.Видимость = Объект.Контрагент.ПоказыватьДопИнформацию;
	//	КонтрагентДополнительно = Объект.Контрагент.Дополнительно;
	//Иначе
	//	Элементы.КонтрагентДополнительно.Видимость = Ложь;
	//КонецЕсли;
	
	Элементы.ФормаГруппаПодменю.Видимость = Объект.Входящее;
	
	Элементы.ГруппаТекстHTML.Видимость = НЕ ПустаяСтрока(Объект.ТекстHTML);
	Элементы.ГруппаПростойТекст.Видимость = НЕ Элементы.ГруппаТекстHTML.Видимость;
	
	УстановитьУсловноеОформление(); // №8201 добавили УФ
	
	Элементы.ФормаТекстовоеСодержимоеПисьма.Видимость = НЕ ПустаяСтрока(Объект.ТекстHTML);
	
	Элементы.ФормаВложитьФайлИзОснования.Видимость = ЗначениеЗаполнено(Объект.Основание);
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	ДатыЗапретаИзменения.ОбъектПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
КонецПроцедуры

