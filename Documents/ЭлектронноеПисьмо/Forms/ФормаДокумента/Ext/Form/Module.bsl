&НаСервере
Функция ПолучитьКоличествоВложений()
	
	Запрос = Новый Запрос;
	Запрос.Текст = Вложения.ТекстЗапроса;
	Запрос.УстановитьПараметр("СсылкаНаОбъект",Объект.Ссылка);
	Возврат Запрос.Выполнить().Выбрать().Количество();
	
КонецФункции

&НаКлиенте
Процедура ОбновитьФорму()
	
	//++ №8201
	НесколькоПолучателей = Объект.Получатели.Количество() > 0;
	ПризнакиПолучателей = ОпределитьПризнакиПолучателей();
	РазрешеноИзменениеГалочкиНесколькоПолучателей = ПризнакиПолучателей.РазрешеноИзменениеГалочкиНесколькоПолучателей И НЕ Объект.Отправлен;
	ПолностьюОтправлено = ПризнакиПолучателей.ПолностьюОтправлено ИЛИ Объект.Отправлен;
	//-- №8201
	
	Вложения.Параметры.УстановитьЗначениеПараметра("СсылкаНаОбъект",Объект.Ссылка);
	
	Элементы.ДатаОтправки.Видимость = Объект.Отправлен;
	//ЭтаФорма.ТолькоПросмотр = ПолностьюОтправлено; //Объект.Отправлен;
	ТолькоПросмотр = (НЕ Объект.Входящее И ПолностьюОтправлено);
	Элементы.ФормаЗаписать.Доступность = НЕ ПолностьюОтправлено; //Объект.Отправлен;
	Элементы.ФормаОтправить.Доступность = НЕ ПолностьюОтправлено; //Объект.Отправлен;
	Элементы.ФормаВложитьФайл.Доступность = НЕ ПолностьюОтправлено; //Объект.Отправлен;
	Элементы.Вложения.ТолькоПросмотр = ТолькоПросмотр; //ПолностьюОтправлено; //Объект.Отправлен;	
	Элементы.ГруппаВходящее.Видимость = Объект.Входящее;
	Элементы.Отправитель.Видимость = НЕ Объект.Входящее;
	Элементы.АдресОтправителя.Видимость = Объект.Входящее;
	Элементы.ГруппаСтатусПисьма.Видимость = НЕ Объект.Входящее;
	Элементы.ФормаОтправить.Видимость = НЕ Объект.Входящее;
	Элементы.ФормаГруппаПодменю.Видимость = Объект.Входящее;
	
	КоличествоВложений = ПолучитьКоличествоВложений();
	Если КоличествоВложений > 0 Тогда
		Элементы.ГруппаВложения.Заголовок = "Вложения ("+КоличествоВложений+")";
	Иначе
		Элементы.ГруппаВложения.Заголовок = "Вложения";
	КонецЕсли;
	
	//++ №8201
	Элементы.ПолучателиЗаполнитьПоГруппе.Доступность = НЕ ЭтаФорма.ТолькоПросмотр;
	Элементы.ПолучателиОчиститьТаблицуПолучателей.Доступность = НЕ ЭтаФорма.ТолькоПросмотр;
	Элементы.Контрагент.Видимость = НЕ Объект.Входящее И НЕ НесколькоПолучателей;
	Элементы.АдресПолучателя.Видимость = НЕ НесколькоПолучателей;
	Элементы.НесколькоПолучателей.Доступность = РазрешеноИзменениеГалочкиНесколькоПолучателей;
	Элементы.ГруппаНесколькоПолучателей.Видимость = НесколькоПолучателей И НЕ Объект.Входящее;
	Элементы.Отправлен.Видимость = НЕ НесколькоПолучателей;
	//-- №8201
	
	Если Объект.Входящее Тогда
		Элементы.ТекстПисьма.ТолькоПросмотр = Истина;
		Элементы.ФормаВложитьФайл.Доступность = Ложь;
		Элементы.ГруппаШапкаПисьма.ТолькоПросмотр = Истина;
		Элементы.Вложения.ТолькоПросмотр = Истина;
		Элементы.ГруппаДополнительно.ТолькоПросмотр = Истина;		
	КонецЕсли;
	
КонецПроцедуры

