&НаКлиенте
Процедура ВложитьФайл(Команда)
	
	ЭтаФорма.Записать();
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ВложитьФайлЗавершение", ЭтотОбъект);
	
	Режим = РежимДиалогаВыбораФайла.Открытие;
	ДиалогОткрытияФайла = Новый ДиалогВыбораФайла(Режим);
	ДиалогОткрытияФайла.ПолноеИмяФайла = "";
	ДиалогОткрытияФайла.МножественныйВыбор = Истина;
	ДиалогОткрытияФайла.Заголовок = "Выберите файлы";
	ДиалогОткрытияФайла.Показать(ОписаниеОповещения);
	
КонецПроцедуры

&НаКлиенте
Процедура ВложитьФайлЗавершение(ВыбранныеФайлы, ДополнительныеПараметры) Экспорт
	
	Если ВыбранныеФайлы = Неопределено Тогда
		ПоказатьОповещениеПользователя(НСтр("ru = 'Файл(ы) не выбран!'; en = 'File(s) not selected!'"));
		Возврат;
	КонецЕсли;
		
	МассивФайлов = ВыбранныеФайлы;
	Для Каждого ИмяФайла Из МассивФайлов Цикл
		ВыбФайл = Новый Файл(ИмяФайла);
		Если ВложитьФайлНаСервере(Объект.Ссылка,ВыбФайл.ИмяБезРасширения,ВыбФайл.Расширение, ОбщийМодуль.Сериализовать(Новый ДвоичныеДанные(ИмяФайла))) Тогда
			ПоказатьОповещениеПользователя("Файлы успешно прикреплены");
		Иначе
			Сообщить("Не удалось прикрепить файлы!",СтатусСообщения.Важное);
		КонецЕсли;
	КонецЦикла;	
	
	ОбновитьФорму();
	
КонецПроцедуры

//++ #12700
&НаКлиенте
Процедура ВложитьФайлИзОснования(Команда)
	
	ЭтаФорма.Записать();
	
	Если ЗначениеЗаполнено(Объект.Основание) Тогда
		ПараметрыФормы = Новый Структура("Основание", Объект.Основание);
		ОписаниеОповещения = Новый ОписаниеОповещения("ВложитьФайлИзОснованияЗавершение", ЭтотОбъект);
		ОткрытьФорму("Документ.ЭлектронноеПисьмо.Форма.ФормаВложенияИзОснования", ПараметрыФормы, ЭтотОбъект, , , , ОписаниеОповещения);
	Иначе
		ПоказатьПредупреждение(, "У письма нет основания");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВложитьФайлИзОснованияЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда		
		Возврат;
	КонецЕсли;
	
	АдресФайла = ОбщийМодульВызовСервера.ПолучитьДанныеФайла(Результат.Документ, Результат.ИмяФайла, , ЭтотОбъект.УникальныйИдентификатор);	
	Если АдресФайла = Неопределено Тогда
		Сообщить("Ошибка получения содержимого файла!", СтатусСообщения.Важное);
		Возврат;	
	КонецЕсли;
	
	Если ВложитьФайлИзОснованияНаСервере(Результат, АдресФайла) Тогда
		ПоказатьОповещениеПользователя("Файлы успешно прикреплены");
	Иначе
		Сообщить("Не удалось прикрепить файлы!", СтатусСообщения.Важное);
	КонецЕсли;
	
	ОбновитьФорму();
	
КонецПроцедуры

&НаСервере
Функция ВложитьФайлИзОснованияНаСервере(Результат, АдресФайла)
	
	ДвоичныеДанные = ПолучитьИзВременногоХранилища(АдресФайла);
	Возврат ВложитьФайлНаСервере(Объект.Ссылка, Результат.ИмяФайла, "." + Результат.Расширение, ОбщийМодуль.Сериализовать(ДвоичныеДанные));
	
КонецФункции
