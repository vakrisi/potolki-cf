&НаСервере
Процедура ПослеВыбораГруппыКонтрагентов(ЗначениеВыбора, ДопПараметры) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Контрагенты.Ссылка
	|ИЗ
	|	Справочник.Контрагенты КАК Контрагенты
	|ГДЕ
	|	Контрагенты.ЭтоГруппа = ЛОЖЬ
	|	И (Контрагенты.Родитель = &Родитель
	|			ИЛИ Контрагенты.Родитель.Родитель = &Родитель
	|			ИЛИ Контрагенты.Родитель.Родитель.Родитель = &Родитель
	|			ИЛИ Контрагенты.Родитель.Родитель.Родитель.Родитель = &Родитель
	|			ИЛИ Контрагенты.Родитель.Родитель.Родитель.Родитель.Родитель = &Родитель)";
	Запрос.УстановитьПараметр("Родитель",ЗначениеВыбора);
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда 
		Сообщить("Группа """ + ЗначениеВыбора + """ пустая");
		Возврат;
	КонецЕсли;
	
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = Объект.Получатели.Добавить();
		НоваяСтрока.Контрагент = Выборка.Ссылка;
		НоваяСтрока.Email = ОбщийМодульСервер.ПолучитьЭлектроннуюПочтуИзКонтактнойИнформации(НоваяСтрока.Контрагент);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьТаблицуПолучателей(Команда)
	
	//++ №8201 очистку делаем не полностью, т.к. по каким-то строкам письма, могли быть отправлены
	//Объект.Получатели.Очистить();
	
	КоличествоСтрок = Объект.Получатели.Количество()-1;
	Для Сч = 0 По КоличествоСтрок Цикл
		
		Если НЕ Объект.Получатели[КоличествоСтрок-Сч].Отправлено Тогда
			Объект.Получатели.Удалить(КоличествоСтрок-Сч);
		КонецЕсли;
		
	КонецЦикла;
	
	//-- №8201
	
КонецПроцедуры

&НаКлиенте
Функция АдресВалидный(Email)
	
	ПозицияСобаки = Найти(Email, "@");
	
	Если Не ПозицияСобаки = 0 И Не ПозицияСобаки = 1 Тогда		
		Если Найти(Сред(Email, ПозицияСобаки + 1), ".") = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
	
	// Проверим адрес на допустимые символы
	ДопустимыеСимволы = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789._-@";
	
	Позиция = 1;
	
	Пока Позиция <= СтрДлина(Email) Цикл
		
		ТекущийСимвол = ВРег(Сред(Email, Позиция, 1));
		
		Если Найти(ДопустимыеСимволы, ТекущийСимвол) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
		
		Позиция = Позиция + 1;
		
	КонецЦикла;
	
	Возврат Истина;

КонецФункции

