&НаСервере
Процедура ИндивидуальныеЦеныНаПродукциюПриИзмененииНаСервере()
	
	УстановитьВидимость();
	
	МассивВидов = Новый Массив;
	МассивВидов.Добавить(Справочники.ВидыНоменклатуры.Отрез);
	МассивВидов.Добавить(Справочники.ВидыНоменклатуры.ТиповойОтрез);
	МассивВидов.Добавить(Справочники.ВидыНоменклатуры.Потолок);
	
	Для каждого ЭлементМассива из МассивВидов Цикл
		НайденныеСтроки = Объект.ВидыНоменклатурыПотолка.НайтиСтроки(Новый Структура("ВидНоменклатуры", ЭлементМассива));
		Если НайденныеСтроки.Количество() = 0 Тогда
			НоваяСтрока = Объект.ВидыНоменклатурыПотолка.Добавить();	
			НоваяСтрока.ВидНоменклатуры = ЭлементМассива;
			НоваяСтрока.КлючСвязи = Строка(Новый УникальныйИдентификатор);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

