&НаКлиенте
Процедура ЗаполнитьЦеныМатериаловТекущимиЦенами(Команда)
	
	Если НЕ ЗначениеЗаполнено(Объект.Контрагент) ИЛИ НЕ ЗначениеЗаполнено(Объект.ДоговорКонтрагента) Тогда
		Сообщить("Не указан контрагент или договор контрагента");
		Возврат;
	КонецЕсли;
	
	ТекущиеДанные = Элементы.ВидыНоменклатурыПотолка.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Сообщить("Не выбран вид номенклатуры потолка!");
		Возврат;
	КонецЕсли;
	
	СтруктураОтбораСтрок = Новый Структура("КлючСвязи", ТекущиеДанные.КлючСвязи);
	КоллекцияДанных = Объект.Материалы.НайтиСтроки(СтруктураОтбораСтрок);
	Если КоллекцияДанных.Количество() = 0 Тогда
		Сообщить("Не заполнена таблица фактур и цветов!");
		Возврат;
	КонецЕсли;
	
	ОписаниеОповещенияВопрос = Новый ОписаниеОповещения("ЗаполнитьЦеныМатериаловТекущимиЦенамиЗавершение", ЭтаФорма, СтруктураОтбораСтрок);
	ПоказатьВопрос(ОписаниеОповещенияВопрос, "Очистить цены и заполнить текущими значениями?", РежимДиалогаВопрос.ДаНет);	
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьЦеныМатериаловТекущимиЦенамиЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
    Если НЕ Результат = КодВозвратаДиалога.Да Тогда
        Возврат;
    КонецЕсли;

    ЗаполнитьЦеныМатериаловТекущимиЦенамиНаСервере(ДополнительныеПараметры);

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьЦеныМатериаловТекущимиЦенамиНаСервере(СтруктураОтбораСтрок)
	
	//ДатаЦены = Объект.Дата;
	//Если ДатаЦены = Дата(1,1,1) Тогда
	//	ДатаЦены = ТекущаяДатаСеанса();
	//КонецЕсли;
	
	КоллекцияДанных = Объект.Материалы.НайтиСтроки(СтруктураОтбораСтрок);
	Для Каждого ТекущаяСтрока Из КоллекцияДанных Цикл
		ТекущаяСтрока.Цена 				= 0;
		ТекущаяСтрока.ЦенаСФотопечатью  = 0;
	КонецЦикла;

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Контрагент",			Объект.Контрагент);
	Запрос.УстановитьПараметр("ДоговорКонтрагента", Объект.ДоговорКонтрагента);
	Запрос.УстановитьПараметр("Дата", 				ТекущаяДатаСеанса());
	Запрос.УстановитьПараметр("Валюта", 			Объект.Валюта);
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЦеныМатериалов.Фактура КАК Фактура,
	|	ЦеныМатериалов.ЦветФактуры КАК ЦветФактуры,
	|	ЦеныМатериалов.Цена КАК Цена,
	|	ЦеныМатериалов.ЦенаСФотопечатью КАК ЦенаСФотопечатью,
	|	ЦеныМатериалов.Отменена КАК Отменена
	|ИЗ
	|	РегистрСведений.ЦеныМатериаловИндивидуальные.СрезПоследних(
	|			&Дата,
	|			Валюта = &Валюта
	|				И Контрагент = &Контрагент
	|				И ДоговорКонтрагента = &ДоговорКонтрагента) КАК ЦеныМатериалов";
	
	ТаблицаЦен = Запрос.Выполнить().Выгрузить();
	
	Для Каждого ТекущаяСтрока Из КоллекцияДанных Цикл
		Отбор = Новый Структура("Фактура, ЦветФактуры", ТекущаяСтрока.Фактура, ТекущаяСтрока.ЦветФактуры);
		НайденныеСтроки = ТаблицаЦен.НайтиСтроки(Отбор);
		Если НайденныеСтроки.Количество() > 0 Тогда
			Если НЕ НайденныеСтроки[0].Отменена Тогда
				ТекущаяСтрока.Цена = НайденныеСтроки[0].Цена;			
				ТекущаяСтрока.ЦенаСФотопечатью = НайденныеСтроки[0].ЦенаСФотопечатью;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

