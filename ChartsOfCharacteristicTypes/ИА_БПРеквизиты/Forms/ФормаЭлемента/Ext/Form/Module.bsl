
&НаКлиенте
Процедура Значения(Команда)
    Если Объект.Ссылка.Пустая() Тогда
    	ЭтаФорма.Записать();
    КонецЕсли; 
    Если НЕ Объект.Ссылка.Пустая() Тогда
        ОткрытьФорму("Справочник.ИА_БПДополнительныеЗначенияРеквизитов.ФормаСписка"
        , Новый Структура("Отбор", Новый Структура("Владелец", Объект.Ссылка) ) );
    КонецЕсли; 
КонецПроцедуры

&НаКлиенте
Процедура УстановитьВидимость()
    ЕстьДоп = Объект.ТипЗначения.СодержитТип(Тип("СправочникСсылка.ИА_БПДополнительныеЗначенияРеквизитов"));
    Элементы.Значения.Видимость = ЕстьДоп;
КонецПроцедуры


&НаКлиенте
Процедура ПриОткрытии(Отказ)
    УстановитьВидимость();
КонецПроцедуры


&НаКлиенте
Процедура ТипЗначенияПриИзменении(Элемент)
    УстановитьВидимость();
КонецПроцедуры


&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
    УстановитьВидимость();
КонецПроцедуры
 