
Процедура ПередЗаписью(Отказ)
    Если ОбменДанными.Загрузка Тогда Возврат КонецЕсли;
    
    Если НЕ ЭтоГруппа Тогда
        ЗначениеПоУмолчанию = ТипЗначения.ПривестиЗначение(ЗначениеПоУмолчанию);	
    КонецЕсли; 
    
    Стр = СокрЛП(Код);
    
    Пока Лев(Стр, 1) = "0" Цикл
    	Стр = Сред(Стр, 2);
    КонецЦикла; 
    
    УниКод = Стр;
КонецПроцедуры
