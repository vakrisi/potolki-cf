&НаКлиенте
Процедура ОткрытьФайл(Команда)
	
	АдресФайла = ПолучитьДанные(Элементы.Список.ТекущиеДанные.СсылкаНаОбъект, Элементы.Список.ТекущиеДанные.ИмяФайла);
	ВременноеИмя=ПолучитьИмяВременногоФайлаСерв(Элементы.Список.ТекущиеДанные.Расширение);
    ПолучитьФайл(АдресФайла, ВременноеИмя, Истина);
	
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если НЕ Параметры.ОбъектОтбор = Неопределено Тогда
		ЭО=Список.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭО.ВидСравнения=ВидСравненияКомпоновкиДанных.Равно;
		ЭО.ЛевоеЗначение=Новый ПолеКомпоновкиДанных("СсылкаНаобъект");
		ЭО.ПравоеЗначение=Параметры.ОбъектОтбор.Ссылка;
		ЭО.Использование=Истина;
	КонецЕсли;
	
КонецПроцедуры
