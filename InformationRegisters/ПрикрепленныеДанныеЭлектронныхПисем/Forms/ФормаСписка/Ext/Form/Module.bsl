&НаСервере
Функция ПолучитьДанные(СсылкаНаОбъект, ИмяФайла)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ПрикрепленныеДанныеЭлектронныхПисем.Данные
	|ИЗ
	|	РегистрСведений.ПрикрепленныеДанныеЭлектронныхПисем КАК ПрикрепленныеДанныеЭлектронныхПисем
	|ГДЕ
	|	ПрикрепленныеДанныеЭлектронныхПисем.СсылкаНаОбъект = &Ссылка
	|	И ПрикрепленныеДанныеЭлектронныхПисем.ИмяФайла = &ИмяФайла";
	Запрос.УстановитьПараметр("Ссылка",СсылкаНаОбъект);
	Запрос.УстановитьПараметр("ИмяФайла",ИмяФайла);
	
	
	Данные = Неопределено;
	Выборка = Запрос.Выполнить().Выгрузить();
	Если Выборка.Количество() > 0 тогда
		Данные = Выборка[0].Данные.Получить();
	КонецЕсли;
	 
	Возврат ПоместитьВоВременноеХранилище(Данные, ЭтаФорма.УникальныйИдентификатор);
	
КонецФункции

