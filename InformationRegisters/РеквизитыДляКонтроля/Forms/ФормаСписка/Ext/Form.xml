		<Attribute name="НаборыОбъектов" id="2">
			<Title>
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Наборы объектов</v8:content>
				</v8:item>
			</Title>
			<Type>
				<v8:Type>cfg:DynamicList</v8:Type>
			</Type>
			<UseAlways>
				<Field>НаборыОбъектов.Ref</Field>
			</UseAlways>
			<Settings xsi:type="DynamicList">
				<ManualQuery>true</ManualQuery>
				<DynamicDataRead>true</DynamicDataRead>
				<QueryText>ВЫБРАТЬ
	Наборы.Ссылка,
	Наборы.ВерсияДанных,
	Наборы.ПометкаУдаления,
	Наборы.Предопределенный,
	//Наборы.Родитель,
	Наборы.ЭтоГруппа,
	Наборы.Наименование,
	Наборы.Наименование КАК Представление,
	//Наборы.Используется,
	//ВЫБОР
	//	КОГДА Наборы.ЭтоГруппа
	//		ТОГДА Наборы.Наименование
	//	КОГДА &amp;ЭтоНаборыДополнительныхСведений
	//		ТОГДА ВЫБОР
	//				КОГДА Наборы.КоличествоСведений = ""
	//					ТОГДА Наборы.Наименование
	//				ИНАЧЕ Наборы.Наименование + " (" + Наборы.КоличествоСведений + ")"
	//			КОНЕЦ
	//	ИНАЧЕ ВЫБОР
	//			КОГДА Наборы.КоличествоРеквизитов = ""
	//				ТОГДА Наборы.Наименование
	//			ИНАЧЕ Наборы.Наименование + " (" + Наборы.КоличествоРеквизитов + ")"
	//		КОНЕЦ
	//КОНЕЦ КАК Представление,
	ВЫБОР
		КОГДА Наборы.ПометкаУдаления
			ТОГДА 1
		ИНАЧЕ 0
	КОНЕЦ + ВЫБОР
		КОГДА Наборы.Предопределенный
			ТОГДА 2
		ИНАЧЕ 0
	КОНЕЦ КАК НомерКартинки
ИЗ
	Справочник.НаборыРеквизитовДляКонтроля КАК Наборы
//ГДЕ
//	ВЫБОР
//			КОГДА Наборы.Родитель = ЗНАЧЕНИЕ(Справочник.НаборыДополнительныхРеквизитовИСведений.ПустаяСсылка)
//				ТОГДА Наборы.Ссылка В (&amp;Наборы)
//			ИНАЧЕ Наборы.Родитель В (&amp;Наборы)
//		КОНЕЦ
//	И Наборы.Используется
//			И ЕСТЬNULL(Наборы.Родитель.Используется, ИСТИНА)</QueryText>
				<MainTable>Catalog.НаборыРеквизитовДляКонтроля</MainTable>
				<ListSettings>
					<dcsset:filter>
						<dcsset:viewMode>Normal</dcsset:viewMode>
						<dcsset:userSettingID>dfcece9d-5077-440b-b6b3-45a5cb4538eb</dcsset:userSettingID>
					</dcsset:filter>
					<dcsset:order>
						<dcsset:viewMode>Normal</dcsset:viewMode>
						<dcsset:userSettingID>88619765-ccb3-46c6-ac52-38e9c992ebd4</dcsset:userSettingID>
					</dcsset:order>
					<dcsset:conditionalAppearance>
						<dcsset:viewMode>Normal</dcsset:viewMode>
						<dcsset:userSettingID>b75fecce-942b-4aed-abc9-e6a02e460fb3</dcsset:userSettingID>
					</dcsset:conditionalAppearance>
					<dcsset:itemsViewMode>Normal</dcsset:itemsViewMode>
					<dcsset:itemsUserSettingID>911b6018-f537-43e8-a417-da56b22f9aec</dcsset:itemsUserSettingID>
