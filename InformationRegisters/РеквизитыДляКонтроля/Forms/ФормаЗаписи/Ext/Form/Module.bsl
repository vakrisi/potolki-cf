
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если НЕ ЗначениеЗаполнено(Запись.Объект) ИЛИ ЗначениеЗаполнено(Параметры.ЗначениеКопирования) Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	ЭтоКонтактнаяИнформация = Ложь;
	УсловиеЗаполнятьОбязательно = Ложь;
	ТипРеквизитаБулево = Ложь;

	Если Запись.Объект = Справочники.НаборыРеквизитовДляКонтроля.Справочник_Номенклатура
		ИЛИ Запись.Объект.Родитель = Справочники.НаборыРеквизитовДляКонтроля.Справочник_Номенклатура Тогда
		Если Запись.ИмяРеквизита = "Родитель" Тогда
			Реквизит = Метаданные.Справочники.Номенклатура.СтандартныеРеквизиты[Запись.ИмяРеквизита];
		Иначе	
			Реквизит = Метаданные.Справочники.Номенклатура.Реквизиты[Запись.ИмяРеквизита];
		КонецЕсли;
		
	ИначеЕсли Запись.Объект = Справочники.НаборыРеквизитовДляКонтроля.Справочник_Контрагенты
		ИЛИ Запись.Объект.Родитель = Справочники.НаборыРеквизитовДляКонтроля.Справочник_Контрагенты Тогда
		Если Запись.ИмяРеквизита = "Родитель" Тогда
			Реквизит = Метаданные.Справочники.Контрагенты.СтандартныеРеквизиты[Запись.ИмяРеквизита];
		ИначеЕсли Запись.ИмяРеквизита = "Контактная информация.Телефон" ИЛИ Запись.ИмяРеквизита = "Контактная информация.Email" Тогда
		    ЭтоКонтактнаяИНформация = Истина;
		Иначе	
			Реквизит = Метаданные.Справочники.Контрагенты.Реквизиты[Запись.ИмяРеквизита];
		КонецЕсли;		
	Иначе
		Возврат;
	КонецЕсли;
	
	Если НЕ ЭтоКонтактнаяИнформация Тогда
		ТипРеквизитаБулево = (Реквизит.Тип = Новый ОписаниеТипов("Булево"));
		УсловиеЗаполнятьОбязательно = (Реквизит.ПроверкаЗаполнения = ПроверкаЗаполнения.ВыдаватьОшибку);
	КонецЕсли;
	
	Элементы.ЗаполнятьОбязательно.Доступность = НЕ ТипРеквизитаБулево И НЕ УсловиеЗаполнятьОбязательно;
	Элементы.ДекорацияЗаполнятьОбязательно.Видимость = УсловиеЗаполнятьОбязательно;
		
	Элементы.Уникален.Доступность = НЕ ТипРеквизитаБулево;
	
КонецПроцедуры
