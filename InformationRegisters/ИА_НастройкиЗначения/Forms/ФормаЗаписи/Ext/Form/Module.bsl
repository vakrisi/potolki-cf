
&НаКлиенте
Процедура ПриЗакрытии()
    Оповестить("ЗначениеНастройкиИзменено", Запись.Пользователь);
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
    Если Параметры.Свойство("ТолькоВвод")
        И Параметры.ТолькоВвод Тогда
        Элементы.Пользователь.Доступность = Ложь;
        Элементы.Настройка.Доступность = Ложь;
    КонецЕсли;
КонецПроцедуры
