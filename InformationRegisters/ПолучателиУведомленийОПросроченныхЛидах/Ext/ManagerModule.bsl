Процедура СохранитьСписокПользователей(ПолучателиУведомленийОПросроченныхЛидах) Экспорт
	
	НаборЗаписей = РегистрыСведений.ПолучателиУведомленийОПросроченныхЛидах.СоздатьНаборЗаписей();
	НаборЗаписей.Очистить();
	
	Для Каждого ТекущаяСтрока Из ПолучателиУведомленийОПросроченныхЛидах Цикл
		
		НоваяСтрока = НаборЗаписей.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущаяСтрока);
		
	КонецЦикла;
	
	НаборЗаписей.Записать();
	
КонецПроцедуры
