
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если НЕ РольДоступна("АдминистраторСистемы") Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	// новые строки создаются только программно
	Если Параметры.Ключ.ТипОбъекта.Пустая()  Тогда
		Отказ = Истина;
	КонецЕсли;
	
КонецПроцедуры
