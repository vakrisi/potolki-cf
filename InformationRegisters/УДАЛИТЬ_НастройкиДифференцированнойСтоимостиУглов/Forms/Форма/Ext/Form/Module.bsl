&НаКлиенте
Процедура СписокНастроекПередНачаломИзменения(Элемент, Отказ)
	ПредКолво = Элемент.ТекущиеДанные.КоличествоОт;
	ПредЦена = Элемент.ТекущиеДанные.Цена;
КонецПроцедуры

&НаСервере
Функция Минимум()
	Возврат Константы.УДАЛИТЬ_КоличествоУгловПриБесплатномРаскрое.Получить(); //!!!
КонецФункции

&НаКлиенте
Процедура СписокНастроекПередОкончаниемРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования, Отказ)
	Если ОтменаРедактирования Тогда
		Элемент.ТекущиеДанные.КоличествоОт = ПредКолво;
		Элемент.ТекущиеДанные.Цена = ПредЦена;
	Иначе
		Для Каждого Стр из СписокНастроек Цикл
			Если Элемент.ТекущиеДанные.КоличествоОт <= Минимум() Тогда
				ПоказатьПредупреждение(, "Количество должно быть больше количества углов при бесплатном раскрое!");
				Отказ = Истина;
				Прервать;
			КонецЕсли;
			
			Если Не СписокНастроек.Индекс(Стр) = Элемент.ТекущаяСтрока Тогда
				Если Элемент.ТекущиеДанные.КоличествоОт = Стр.КоличествоОт Тогда
					ПоказатьПредупреждение(, "Количество уже есть в настройках!");
					Отказ = Истина;
					Прервать;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры
