&НаСервере
Процедура ЗаписатьНаСервере()
	Записи = РегистрыСведений.УДАЛИТЬ_НастройкиДифференцированнойСтоимостиУглов.СоздатьНаборЗаписей();
	Для каждого Стр из СписокНастроек Цикл
		Запись = Записи.Добавить();
		ЗаполнитьЗначенияСвойств(Запись, Стр);
	КонецЦикла;
	Записи.Записать(Истина);
КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьНастройки(Команда)
	ЗаписатьНаСервере();
	Закрыть();
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	НастройкиДифференцированнойСтоимостиУглов.КоличествоОт,
	|	НастройкиДифференцированнойСтоимостиУглов.Цена
	|ИЗ
	|	РегистрСведений.НастройкиДифференцированнойСтоимостиУглов КАК НастройкиДифференцированнойСтоимостиУглов";
	СписокНастроек.Загрузить(Запрос.Выполнить().Выгрузить());
КонецПроцедуры

