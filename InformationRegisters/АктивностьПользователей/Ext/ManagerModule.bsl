Функция ПолучитьДатуПоследнейАктивности(Пользователь, Знач НомерСессии = 0) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	АктивностьПользователей.ДатаПоследнегоДействия КАК ДатаПоследнегоДействия
	|ИЗ
	|	РегистрСведений.АктивностьПользователей КАК АктивностьПользователей
	|ГДЕ
	|	АктивностьПользователей.Пользователь = &Пользователь
	|	И ВЫБОР
	|			КОГДА &НомерСессии = 0
	|				ТОГДА 1 = 1
	|			ИНАЧЕ АктивностьПользователей.НомерСессии = &НомерСессии
	|		КОНЕЦ";
	Запрос.УстановитьПараметр("Пользователь", Пользователь);
	Запрос.УстановитьПараметр("НомерСессии", НомерСессии);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Возврат Выборка.ДатаПоследнегоДействия;
	КонецЦикла;
	
	Возврат Дата(1,1,1);
	
КонецФункции