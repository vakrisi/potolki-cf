
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Реквизиты = ПотолкиКассыОнлайн.ДанныеЖурналаФискальныхОпераций(Запись.ДокументОснование);
	
	ТекстСообщенияXML = Реквизиты.Данные.Получить();
	Если ЗначениеЗаполнено(ТекстСообщенияXML) Тогда		
		ТекстXML.УстановитьТекст(ФорматироватьXMLСПараметрами(ТекстСообщенияXML));		
		Элементы.Страницы.ОтображениеСтраниц = ОтображениеСтраницФормы.ЗакладкиСверху;		
	Иначе		
		Элементы.Страницы.ОтображениеСтраниц = ОтображениеСтраницФормы.Нет;		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ФорматироватьXMLСПараметрами(ТекстСообщенияXML) 
	
	ПараметрыЗаписи = Новый ПараметрыЗаписиXML("UTF-8", "1.0", Истина, Истина, " ");
	
	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.УстановитьСтроку(ТекстСообщенияXML);
	
	ПостроительDOM = Новый ПостроительDOM;
	ДокументDOM = ПостроительDOM.Прочитать(ЧтениеXML);
	
	ЗаписьXML = Новый ЗаписьXML;
	ЗаписьXML.УстановитьСтроку(ПараметрыЗаписи);
	
	ЗаписьDOM = Новый ЗаписьDOM;
	ЗаписьDOM.Записать(ДокументDOM, ЗаписьXML);
	
	Возврат ЗаписьXML.Закрыть();
	
КонецФункции

