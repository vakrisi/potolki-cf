&НаКлиенте
Перем уид1, уид2;

&НаКлиенте
Процедура СписокПриАктивизацииСтроки(Элемент)
	
	ПодключитьОбработчикОжидания("СписокПриАктивизацииСтрокиОбработчикОжидания",0.2,Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура СписокПриАктивизацииСтрокиОбработчикОжидания()
	
	ТекущаяСтрока = Элементы.Список.ТекущиеДанные;
	Если ТекущаяСтрока = Неопределено Тогда
		возврат
	КонецЕсли;
	
	АдресКартинки = ИА_КСУОбщийСервер.ОбновитьИзображение(ТекущаяСтрока.ФизЛицо,,уид1);
	АдресКартинкиАватар = ИА_КСУОбщийСервер.ОбновитьИзображение(ТекущаяСтрока.ФизЛицо, "Аватар",уид2);
	
КонецПроцедуры



&НаКлиенте
Процедура ФотоФизЛицаНажатие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка =Ложь;
	ДобавитьИзображение(Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьИзображение(ТекущийЭлемент)
	
	ТекущаяСтрока = Элементы.Список.ТекущиеДанные;
	ДополнительныеПараметры = Новый Структура("ТекущаяСтрока", ТекущаяСтрока);
	ДополнительныеПараметры.Вставить("Аватар", ТекущийЭлемент = Элементы.ФотоФизЛицаАватар);
	
	Оповещение = Новый ОписаниеОповещения("ДобавитьИзображениеЗавершение", ЭтаФорма, ДополнительныеПараметры);
	НачатьПомещениеФайла(Оповещение,,, Истина, УникальныйИдентификатор);	
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьИзображениеЗавершение(Результат, Адрес, ВыбранноеИмя, ДополнительныеПараметры) Экспорт
	
	Если Результат Тогда
		ЗаписатьФотоВРегистр(ДополнительныеПараметры.ТекущаяСтрока.ФизЛицо, Адрес, ДополнительныеПараметры.Аватар);
		Если ДополнительныеПараметры.Аватар Тогда
			ИА_КСУОбщийСервер.ОбновитьАватар(ДополнительныеПараметры.ТекущаяСтрока.ФизЛицо, истина);
		Иначе 
			дп = Новый Структура("ФизЛицо", ДополнительныеПараметры.ТекущаяСтрока.ФизЛицо);
			ПоказатьВопрос(Новый ОписаниеОповещения("ДобавитьИзображениеЗавершениеЗавершение", ЭтотОбъект, дп), "Обновить аватар?",РежимДиалогаВопрос.ДаНет);
			Возврат;
		КонецЕсли;
		
		СписокПриАктивизацииСтрокиОбработчикОжидания();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьИзображениеЗавершениеЗавершение(РезультатВопроса, ДополнительныеПараметры1) Экспорт
	
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		ИА_КСУОбщийСервер.ОбновитьАватар(ДополнительныеПараметры1.ФизЛицо);
		АдресКартинки = ИА_КСУОбщийСервер.ОбновитьИзображение(ДополнительныеПараметры1.ФизЛицо,,уид1);
		АдресКартинкиАватар = ИА_КСУОбщийСервер.ОбновитьИзображение(ДополнительныеПараметры1.ФизЛицо, "Аватар",уид2);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьФизЛица(Команда)
	
	ФормаПодбора = ПолучитьФорму("РегистрСведений.ИА_ДанныеФизЛиц.Форма.ФормаПодбораФизическихЛиц", , ЭтаФорма, УникальныйИдентификатор);
	ФормаПодбора.Открыть();
	
	ЗаполнитьФизЛицаНаСервере();
	СписокПриАктивизацииСтрокиОбработчикОжидания();

КонецПроцедуры

