КонецПроцедуры

&НаСервереБезКонтекста
Процедура ЗаполнитьАватарыНаСервере()
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ИА_ДанныеФизЛиц.ФизЛицо
	               |ИЗ
	               |	РегистрСведений.ИА_ДанныеФизЛиц КАК ИА_ДанныеФизЛиц";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ИА_КСУОбщийСервер.ОбновитьАватар(Выборка.ФизЛицо);
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьАватарЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		ЗаполнитьАватарыНаСервере();
		СписокПриАктивизацииСтрокиОбработчикОжидания();	
		ПоказатьПредупреждение(,"Выполнено");
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьАватары(Команда)
	ПоказатьВопрос(Новый ОписаниеОповещения("ЗаполнитьАватарЗавершение", ЭтаФорма), "Аватары будут перезаполнены. Продолжить?", РежимДиалогаВопрос.ДаНет);
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТелефонИПочтуИзФизЛицаНаСервере()
	ПутьКДанным = "";
	ПолеСвязи = "";
	Попытка
		сс = Справочники["ФизическиеЛица"].ПустаяСсылка()["КонтактнаяИнформация"].Ссылка;
		ПутьКДанным = "Справочник.ФизическиеЛица.КонтактнаяИнформация";
		ПолеСвязи = "Ссылка";
	Исключение
		Попытка
			м = РегистрыСведений["КонтактнаяИнформация"].СоздатьМенеджерЗаписи();
			ПутьКДанным = "РегистрСведений.КонтактнаяИнформация";
			ПолеСвязи = "Объект";
		Исключение
		КонецПопытки;
	КонецПопытки;
	
	Если ПутьКДанным = "" Тогда
		Сообщить("Невозможно определить источник для заполнения.");
		Возврат;
	КонецЕсли;
	
	Запрос = Новый запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ИА_ДанныеФизЛиц.ФизЛицо,
	               |	МАКСИМУМ(ВЫРАЗИТЬ(ЕСТЬNULL(КонтактнаяИнформация.Представление, """") КАК СТРОКА(100))) КАК Телефон,
	               |	МАКСИМУМ(ВЫРАЗИТЬ(ЕСТЬNULL(КонтактнаяИнформация1.Представление, """") КАК СТРОКА(100))) КАК Почта
	               |ИЗ
	               |	РегистрСведений.ИА_ДанныеФизЛиц КАК ИА_ДанныеФизЛиц
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
	               |		ПО ИА_ДанныеФизЛиц.ФизЛицо = КонтактнаяИнформация.Объект
	               |			И (КонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Телефон))
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация1
	               |		ПО ИА_ДанныеФизЛиц.ФизЛицо = КонтактнаяИнформация1.Объект
	               |			И (КонтактнаяИнформация1.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.АдресЭлектроннойПочты))
	               |ГДЕ
	               |	(НЕ КонтактнаяИнформация.Представление ЕСТЬ NULL 
	               |			ИЛИ НЕ КонтактнаяИнформация1.Представление ЕСТЬ NULL )
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ИА_ДанныеФизЛиц.ФизЛицо";
				   
	Запрос.Текст = СтрЗаменить(Запрос.Текст,"РегистрСведений.КонтактнаяИнформация", ПутьКДанным); 
	Запрос.Текст = СтрЗаменить(Запрос.Текст,"Объект", ПолеСвязи);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		мен = РегистрыСведений.ИА_ДанныеФизЛиц.СоздатьМенеджерЗаписи();
		мен.ФизЛицо = Выборка.ФизЛицо;
		мен.Прочитать();
		
		мен.ЭлектроннаяПочта = Выборка.Почта;
		мен.Телефон = Выборка.Телефон;
		
		мен.Записать();
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьТелефонИПочтуИзФизЛица(Команда)
	ЗаполнитьТелефонИПочтуИзФизЛицаНаСервере();
	
	Элементы.Список.Обновить();
КонецПроцедуры

