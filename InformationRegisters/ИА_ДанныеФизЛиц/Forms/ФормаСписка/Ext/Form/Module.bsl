КонецПроцедуры

&НаСервереБезКонтекста
Процедура ЗаполнитьПользователейНаСервере()
	
	имяРекв = "";
	
	Если Метаданные.Справочники.Пользователи.Реквизиты.Найти("ФизЛицо") <> Неопределено Тогда
		имяРекв = "ФизЛицо";
	ИначеЕсли Метаданные.Справочники.Пользователи.Реквизиты.Найти("ФизическоеЛицо") <> Неопределено Тогда
		имяРекв = "ФизическоеЛицо";
	КонецЕсли;
	
	Если имяРекв <> ""  Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	Пользователи.Ссылка КАК Пользователь,
		|	Пользователи."+имяРекв+" КАК ФизЛицо
		|ИЗ
		|	Справочник.Пользователи КАК Пользователи";
		
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			
			ФизЛицо      = ВыборкаДетальныеЗаписи.ФизЛицо;
			Пользователь = ВыборкаДетальныеЗаписи.Пользователь;
			
			Если ЗначениеЗаполнено(ФизЛицо) И ЗначениеЗаполнено(Пользователь) Тогда
				
				ЗаписатьПользователяВРегистр(ФизЛицо, Пользователь)
				
			КонецЕсли;
			
		КонецЦикла;
	Иначе
		
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "В справочнике Пользователи не найден реквизит ФизЛицо.";
		Сообщение.Сообщить();

	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ЗаписатьФотоВРегистр(ФизЛицо, АдресФото, ЭтоАватар = ложь)
	
	Если ТипЗнч(АдресФото) = Тип("ХранилищеЗначения") Тогда
		Фото = АдресФото.Получить();
	ИначеЕсли  ЭтоАдресВременногоХранилища(АдресФото) Тогда
		Фото = ПолучитьИзВременногоХранилища(АдресФото);
	Иначе
		Фото = АдресФото;
	КонецЕсли;
	
	
	Если не ЭтоАватар Тогда
    	Данные = ИА_КСУОбщийСервер.Картинки_ИзменитьРазмер(Фото, 220, 220, 0.75);
	
		Если Данные.Выполнено Тогда
			Фото = Данные.ДДКартинки;
		КонецЕсли;
	КонецЕсли;
	
	Менедж = РегистрыСведений.ИА_ДанныеФизЛиц.СоздатьМенеджерЗаписи();
	Менедж.ФизЛицо = ФизЛицо;	
	Менедж.Прочитать();
	Если ЭтоАватар Тогда
		Менедж.ФотоАватар = Новый ХранилищеЗначения(Фото);
	Иначе
		Менедж.Фото = Новый ХранилищеЗначения(Фото);
	КонецЕсли;
	Менедж.Записать();
		
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ЗаписатьПользователяВРегистр(ФизЛицо, Пользователь)
	
	НаборЗаписей = РегистрыСведений.ИА_ДанныеФизЛиц.СоздатьНаборЗаписей();

	НаборЗаписей.Отбор.ФизЛицо.Установить(ФизЛицо);
	НаборЗаписей.Прочитать();
	
	Если НаборЗаписей.Количество() = 0 Тогда
		
		ЗаписьНабора = НаборЗаписей.Добавить();
		ЗаписьНабора.ФизЛицо = ФизЛицо;
		
	Иначе
		
		ЗаписьНабора = НаборЗаписей[0];
		
	КонецЕсли; 
	
	Если ЗаписьНабора.Пользователь <> Пользователь Тогда
		
		ЗаписьНабора.Пользователь = Пользователь;
		НаборЗаписей.Записать();
		
	КонецЕсли;
		
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьФотоНаСервере()
	
	Если Метаданные.Справочники.ФизическиеЛица.Реквизиты.Найти("ОсновноеИзображение") <> Неопределено  Тогда
	
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ИА_ДанныеФизЛиц.ФизЛицо,
		|	ФизическиеЛица.ОсновноеИзображение
		|ИЗ
		|	РегистрСведений.ИА_ДанныеФизЛиц КАК ИА_ДанныеФизЛиц
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ФизическиеЛица КАК ФизическиеЛица
		|		ПО ИА_ДанныеФизЛиц.ФизЛицо = ФизическиеЛица.Ссылка";
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			
			ФизЛицо             = ВыборкаДетальныеЗаписи.ФизЛицо;
			ОсновноеИзображение = ВыборкаДетальныеЗаписи.ОсновноеИзображение;

			Если ЗначениеЗаполнено(ФизЛицо) И ЗначениеЗаполнено(ОсновноеИзображение) Тогда
				 ЗаписатьФотоВРегистр(ФизЛицо, ОсновноеИзображение.Хранилище)
			 КонецЕсли;
			 
		 КонецЦикла;
	 Иначе
		 
		 Сообщение = Новый СообщениеПользователю;
		 Сообщение.Текст = "В справочнике Физические лица не найден реквизит ОсновноеИзображение";
		 Сообщение.Сообщить();
		
	КонецЕсли;

КонецПроцедуры

