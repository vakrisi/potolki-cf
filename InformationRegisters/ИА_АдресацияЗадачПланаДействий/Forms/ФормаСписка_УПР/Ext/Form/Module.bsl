&НаКлиенте
Процедура ЗаполнитьПоОргсхемеОбработчик(реЗ, допПарам) Экспорт
	
	Если реЗ = КодВозвратаДиалога.Да Тогда
		ЗаполнитьПоОргсхеме_Сервер();
		Элементы.Список.Обновить();
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПоОргсхеме_Сервер()
	Набор = РегистрыСведений.ИА_АдресацияЗадачПланаДействий.СоздатьНаборЗаписей();
	Набор.Прочитать();
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ОргСхемаСотрудники.Ссылка КАК Пост,
	               |	ИА_ДанныеФизЛиц.Пользователь
	               |ИЗ
	               |	Справочник.ОргСхема.Сотрудники КАК ОргСхемаСотрудники
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ИА_ДанныеФизЛиц КАК ИА_ДанныеФизЛиц
	               |		ПО ОргСхемаСотрудники.ФизЛицо = ИА_ДанныеФизЛиц.ФизЛицо
	               |ГДЕ
	               |	ОргСхемаСотрудники.Ссылка.ПометкаУдаления = ЛОЖЬ
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ОргСхемаСотрудники.Ссылка,
	               |	ИА_ДанныеФизЛиц.Пользователь";
				   				   
	Набор.Загрузить(Запрос.Выполнить().Выгрузить());
	Набор.Записать(Истина);
						
КонецПроцедуры

