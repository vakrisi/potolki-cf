
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЭтоЗаполнениеПоСтруктуре = Параметры.ЗначенияЗаполнения.Свойство("ВидОперации");
	
	Если НЕ ЗначениеЗаполнено(Параметры.Ключ) И НЕ ЭтоЗаполнениеПоСтруктуре Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Параметры.Ключ) 
		И ЗначениеЗаполнено(Запись.Организация) И ЗначениеЗаполнено(Запись.Подразделение) Тогда
		НастройкаПоУмолчаниюДляВсех = Истина;
	КонецЕсли;
	
	Если Параметры.Свойство("ПерваяСтрока") И Параметры.ПерваяСтрока Тогда
		НастройкаПоУмолчаниюДляВсех = Истина;
	КонецЕсли;
	
	Если НастройкаПоУмолчаниюДляВсех Тогда
		Элементы.Организация.Доступность   = Ложь;	
		Элементы.Подразделение.Доступность = Ложь;
	КонецЕсли;
		
	ТипВидаОперации = Строка(ТипЗнч(Запись.ВидОперации));
	
	// установить параметры выбора.
	НовыйПараметр = Новый ПараметрВыбора("Отбор.ИспользуетсяВУчетеДоходов", Истина);
	Если Запись.ТипСтатьи = Перечисления.ТипыСтатейДоходовРасходов.Расход Тогда	
		НовыйПараметр = Новый ПараметрВыбора("Отбор.ИспользуетсяВУчетеРасходов", Истина);
	КонецЕсли;	
	НовыйМассив = Новый Массив();
	НовыйМассив.Добавить(НовыйПараметр);
	НовыеПараметры = Новый ФиксированныйМассив(НовыйМассив);
	Элементы.СтатьяДоходовРасходов.ПараметрыВыбора = НовыеПараметры;
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	Если НЕ НастройкаПоУмолчаниюДляВсех Тогда
		Если НЕ ЗначениеЗаполнено(Запись.Организация) И НЕ ЗначениеЗаполнено(Запись.Подразделение) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Должно быть заполнено поле ""Организация"" или ""Подразделение""!", , , , Отказ);	
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьСтатьейПоУмолчанию(Команда)
	
	ПредСтатья = Запись.СтатьяДоходовРасходов;
	Запись.СтатьяДоходовРасходов = Запись.СтатьяДоходовРасходовПоУмолчанию;
	Если Запись.СтатьяДоходовРасходов <> ПредСтатья Тогда
		Модифицированность = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	Оповестить("Запись_НастройкиСтатейДоходовРасходовПоУмолчанию");
КонецПроцедуры

