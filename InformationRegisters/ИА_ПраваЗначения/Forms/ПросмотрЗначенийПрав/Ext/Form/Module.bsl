
&НаКлиенте
Процедура Обновить(Команда)
    ОбновитьНаСервере();
КонецПроцедуры

&НаСервере
Процедура ОбновитьНаСервере()
    Таб = ИА_БФС.Запрос_ВыполнитьВТЗ(
    "ВЫБРАТЬ
    |   Т.Ссылка КАК Право,
    |   Т.ЗначениеПоУмолчанию КАК Значение
    |ИЗ
    |   ПланВидовХарактеристик.ИА_ПраваПользователей КАК Т
    |ГДЕ
    |   НЕ Т.ЭтоГруппа");
    Для каждого Стр Из Таб Цикл
        Стр.Значение = ИА_ПраваС.ЗначениеПрава(Пользователь, Стр.Право)
    КонецЦикла; 
    
    ЗначенияПрав.Загрузить(Таб);
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
    
    Параметры.Свойство("Пользователь", Пользователь);
    
    ОбновитьНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ПользовательПриИзменении(Элемент)
    ОбновитьНаСервере();
КонецПроцедуры
