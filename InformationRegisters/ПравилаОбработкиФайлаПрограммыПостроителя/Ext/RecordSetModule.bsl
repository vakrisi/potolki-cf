
Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	Для каждого Запись из ЭтотОбъект Цикл
		Если Запись.ВидПравила = Перечисления.ВидыПравилОбработкиФайлаПрограммыПостроителя.ДобавлениеНоменклатурыВДокумент Тогда
			Если Запись.ОкруглятьКоличество Тогда
				ПроверяемыеРеквизиты.Добавить("ПорядокОкругленияЧислом");
			КонецЕсли;
			
			//++ №11727
			Если ЗначениеЗаполнено(Запись.Номенклатура) Тогда
				ПроверяемыеРеквизиты.Добавить("ЕдиницаИзмерения");
			КонецЕсли;
			//-- №11727
			
			Если Запись.ЭтоПравилоБезПараметра Тогда
				ПроверяемыеРеквизиты.Удалить(ПроверяемыеРеквизиты.Найти("ПараметрФайла"));
			КонецЕсли;
			
		Иначе
			ПроверяемыеРеквизиты.Удалить(ПроверяемыеРеквизиты.Найти("Номенклатура"));
			ПроверяемыеРеквизиты.Удалить(ПроверяемыеРеквизиты.Найти("ТабличнаяЧастьЗаказа"));
			//ПроверяемыеРеквизиты.Удалить(ПроверяемыеРеквизиты.Найти("ВидСоздаваемойНоменклатуры"));
			ПроверяемыеРеквизиты.Удалить(ПроверяемыеРеквизиты.Найти("ПараметрФайла"));
		КонецЕсли;
		
		Если НЕ Запись.ВидСоздаваемойНоменклатуры = Справочники.ВидыНоменклатуры.Продукция Тогда
			ПроверяемыеРеквизиты.Удалить(ПроверяемыеРеквизиты.Найти("ВидПродукции"));
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, Замещение)
	Для каждого Запись из ЭтотОбъект Цикл
		Если НЕ ЗначениеЗаполнено(Запись.КлючУникальности) Тогда
			Запись.КлючУникальности = Новый УникальныйИдентификатор;
		КонецЕсли;		
	КонецЦикла;
КонецПроцедуры
