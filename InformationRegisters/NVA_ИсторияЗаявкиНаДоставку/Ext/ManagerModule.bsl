Процедура ДобавитьЗаписьВИсторию(Заявка, Дата, Пользователь, Комментарий) Экспорт
	
	МенеджерЗаписи = РегистрыСведений.NVA_ИсторияЗаявкиНаДоставку.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.ЗаявкаНаДоставку = Заявка;
	МенеджерЗаписи.Дата = Дата;
	МенеджерЗаписи.Пользователь = Пользователь;	
	МенеджерЗаписи.Комментарий 	= Комментарий;
	
	МенеджерЗаписи.Записать();
	
КонецПроцедуры