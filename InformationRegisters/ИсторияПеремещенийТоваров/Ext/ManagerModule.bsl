
Процедура ДобавитьЗапись(ПеремещениеСсылка, Дата, Пользователь, Комментарий, ИДЗаписи) Экспорт
		
	МенеджерЗаписи = РегистрыСведений.ИсторияПеремещенийТоваров.СоздатьМенеджерЗаписи();		 
	МенеджерЗаписи.Перемещение = ПеремещениеСсылка; 
	МенеджерЗаписи.Дата = Дата;
	МенеджерЗаписи.Пользователь = Пользователь;
	МенеджерЗаписи.Комментарий = Комментарий;
	МенеджерЗаписи.ИДЗаписи = ИДЗаписи;
	
	МенеджерЗаписи.Записать();
	
КонецПроцедуры
