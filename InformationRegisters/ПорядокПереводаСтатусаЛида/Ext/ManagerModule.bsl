Функция ДоступныеДляПереводаСтатусы(ТекущийСтатус) Экспорт

	МассивДоступныхСтатусов = Новый Массив;
	
	РазрешеноПереводитьЛидыВЛюбыеСтатусы = ПараметрыСеанса.ТекущийПользователь.РазрешеноПереводитьЛидыВЛюбыеСтатусы;
	
	НеДоступенНеЦелевой = ПараметрыСеанса.ТекущийПользователь.НеДоступенПереводЛидаВНеЦелевой;
	НеДоступенОтказ     = ПараметрыСеанса.ТекущийПользователь.НеДоступенПереводЛидаВОтказ;
		
	НаборЗаписей = РегистрыСведений.ПорядокПереводаСтатусаЛида.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.ТекущийСтатус.Установить(ТекущийСтатус);
	НаборЗаписей.Прочитать();
	Для каждого ЗаписьРегистра из НаборЗаписей Цикл
		Если ЗаписьРегистра.Разрешено ИЛИ РазрешеноПереводитьЛидыВЛюбыеСтатусы Тогда
			Если НЕ (ЗаписьРегистра.СледующийСтатус = Справочники.СтатусыЛида.НеЦелевой И НеДоступенНеЦелевой) 
				И НЕ (ЗаписьРегистра.СледующийСтатус = Справочники.СтатусыЛида.Отказ И НеДоступенОтказ) Тогда
			
				МассивДоступныхСтатусов.Добавить(ЗаписьРегистра.СледующийСтатус);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	МассивДоступныхСтатусов.Добавить(ТекущийСтатус); //++ №10183 текущий статус
			
	Возврат МассивДоступныхСтатусов;
		
КонецФункции


