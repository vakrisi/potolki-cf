Процедура ДобавитьЗаписьВИсторию(Заказ, Дата, Пользователь, Комментарий, ИДЗаписи = Неопределено, Знач ДатаСледующегоКонтакта = Неопределено) Экспорт
		
	Если ДатаСледующегоКонтакта = Неопределено Тогда 
		ДатаСледующегоКонтакта = Дата(1,1,1)
	КонецЕсли;
	
	МенеджерЗаписи = РегистрыСведений.ИсторияЗаказа.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Заказ = Заказ;
	МенеджерЗаписи.Дата = Дата;
	МенеджерЗаписи.Пользователь = Пользователь;	
	МенеджерЗаписи.Комментарий 	= Комментарий;
	МенеджерЗаписи.ИДЗаписи 	= ИДЗаписи;
	МенеджерЗаписи.ДатаСледующегоКонтакта = ДатаСледующегоКонтакта;
	
	МенеджерЗаписи.Записать();
	
КонецПроцедуры