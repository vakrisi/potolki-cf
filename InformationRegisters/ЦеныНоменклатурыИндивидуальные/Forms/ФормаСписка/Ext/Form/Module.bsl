&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ОтборФормы = Новый Структура; 
	Если Параметры.Свойство("Отбор", ОтборФормы) Тогда
		ОтборФормы.Свойство("Номенклатура", ОтборНоменклатура);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановкаЦенНоменклатуры(Команда)
	
	ПараметрыЗаполнения = Новый Структура;
 	ПараметрыЗаполнения.Вставить("Номенклатура", ОтборНоменклатура); 
 	ПараметрыФормыУЦН = Новый Структура("ЗначенияЗаполнения", ПараметрыЗаполнения);
 	ОткрытьФорму("Документ.УстановкаИндивидуальныхЦенНоменклатуры.ФормаОбъекта", ПараметрыФормыУЦН, ЭтаФорма);
	
КонецПроцедуры

