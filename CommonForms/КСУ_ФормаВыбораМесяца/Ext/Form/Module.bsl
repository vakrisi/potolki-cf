
&НаКлиенте
Процедура Выбрать(Команда)
	тд = Элементы.Месяцы.ТекущиеДанные;
	Если тд<>Неопределено Тогда
		Закрыть(тд.Дата);
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ТекМесяц = Неопределено;
	Параметры.Свойство("ТекМесяц", ТекМесяц);
	
	Если не ЗначениеЗаполнено(ТекМесяц) Тогда
		ТекМесяц = НачалоМесяца(ДобавитьМесяц(ТекущаяДата(),1));
	КонецЕсли;
	
	Запрос = новый запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	ИА_РаспределениеНедель.Месяц КАК Месяц
	               |ИЗ
	               |	РегистрСведений.ИА_РаспределениеНедель КАК ИА_РаспределениеНедель
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Месяц УБЫВ";
	Выборка = запрос.Выполнить().Выбрать();
	
	ТекСтрока = Неопределено;
	пока выборка.Следующий() Цикл
		новстр = Месяцы.Добавить();
		новстр.Дата = Выборка.месяц;
		новстр.Представление = формат(Выборка.месяц, "ДФ='yyyy, MMMM'");
		
		Если ТекМесяц <> Неопределено и ТекМесяц = новстр.Дата Тогда
			ТекСтрока = новстр.ПолучитьИдентификатор();
		КонецЕсли;
	КонецЦикла;
	
	Если ТекСтрока <> Неопределено ТОгда
		Элементы.Месяцы.ТекущаяСтрока = ТекСтрока;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура МесяцыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	Выбрать(Неопределено);
КонецПроцедуры
