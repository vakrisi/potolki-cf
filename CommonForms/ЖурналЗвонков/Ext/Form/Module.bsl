
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ОбновитьСостояние();
	
	//
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	ИсторияЗвонковАТС.Статус КАК Статус
	|ИЗ
	|	РегистрСведений.ИсторияЗвонковАТС КАК ИсторияЗвонковАТС
	|";
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	Выборка = РезультатЗапроса[0].Выбрать();	
	Пока Выборка.Следующий() Цикл
		Элементы.ИсторияОтборПоСтатусу.СписокВыбора.Добавить(Выборка.Статус);
	КонецЦикла;
	
	//#16249
	//ДатаЗапросаИстории = Константы.ТелефонияДатаПоследнегоПолученияИсторииИзАТС.Получить();
	ИнтервалЗапросаИсторииЗвонков = Константы.ИнтервалЗапросаИсторииЗвонков.Получить();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если ИнтервалЗапросаИсторииЗвонков > 1 Тогда
		ПодключитьОбработчикОжидания("ПроверитьОбновлениеИсторииОбработчикОжидания", ИнтервалЗапросаИсторииЗвонков, Ложь);	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "ЗагруженаИсторияАТС" Тогда
		Элементы.ИсторияЗвонковАТС.Обновить();
		ОбновитьСостояние();
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

&НаКлиенте
Процедура ПроверитьОбновлениеИсторииОбработчикОжидания()
	
	Если ПроверитьОбновлениеИсторииСервер() Тогда
		Элементы.ИсторияЗвонковАТС.Обновить();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПроверитьОбновлениеИсторииСервер()
	
	ДатаЗапросаИстории = Константы.ТелефонияДатаПоследнегоПолученияИсторииИзАТС.Получить();
	Если НЕ ДатаЗапросаИстории = ИсторияАТС_ДатаПоследнегоПолучения Тогда
		ОбновитьСостояние();
		Возврат Истина;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

&НаСервере
Процедура ОбновитьСостояние()
	
	ИсторияАТС_ДатаПоследнегоПолучения = Константы.ТелефонияДатаПоследнегоПолученияИсторииИзАТС.Получить();
	Если ТекущаяДатаСеанса() - ИсторияАТС_ДатаПоследнегоПолучения > 86400 Тогда
		Элементы.ИсторияАТС_ДатаПоследнегоПолучения.ЦветТекста = WebЦвета.Красный;
		Элементы.ИсторияАТС_ДатаПоследнегоПолучения.Шрифт = Новый Шрифт(Элементы.ИсторияАТС_ДатаПоследнегоПолучения.Шрифт,,,Истина);
	Иначе
		Элементы.ИсторияАТС_ДатаПоследнегоПолучения.ЦветТекста = ЦветаСтиля.ЦветТекстаФормы;
		Элементы.ИсторияАТС_ДатаПоследнегоПолучения.Шрифт = Новый Шрифт(Элементы.ИсторияАТС_ДатаПоследнегоПолучения.Шрифт,,,Ложь);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УстановкаФильтраИсторияЗвонковАТС()
	
	ИсторияЗвонковАТС.Отбор.Элементы.Очистить();
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(ИсторияЗвонковАТС, "НомерФормат", 		ИсторияОтборПоНомеру,    		ВидСравненияКомпоновкиДанных.Равно, , НЕ ПустаяСтрока(ИсторияОтборПоНомеру));
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(ИсторияЗвонковАТС, "ДатаС", 			НачалоДня(ИсторияДатаНачала),  	ВидСравненияКомпоновкиДанных.БольшеИлиРавно, , ЗначениеЗаполнено(ИсторияДатаНачала));
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(ИсторияЗвонковАТС, "Дата", 				КонецДня(ИсторияДатаОкончания), ВидСравненияКомпоновкиДанных.МеньшеИлиРавно, , ЗначениеЗаполнено(ИсторияДатаОкончания));
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(ИсторияЗвонковАТС, "ВнутреннийНомер", 	ИсторияОтборПоВнНомеру,			ВидСравненияКомпоновкиДанных.Равно, , ЗначениеЗаполнено(ИсторияОтборПоВнНомеру));
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(ИсторияЗвонковАТС, "Статус", 			ИсторияОтборПоСтатусу,			ВидСравненияКомпоновкиДанных.Равно, , ЗначениеЗаполнено(ИсторияОтборПоСтатусу));
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(ИсторияЗвонковАТС, "Направление", 		ИсторияОтборПоНаправлению,		ВидСравненияКомпоновкиДанных.Равно, , ЗначениеЗаполнено(ИсторияОтборПоНаправлению));

КонецПроцедуры

&НаКлиенте
Процедура ИсторияДатаНачалаПриИзменении(Элемент)
	УстановкаФильтраИсторияЗвонковАТС();
КонецПроцедуры

&НаКлиенте
Процедура ИсторияДатаОкончанияПриИзменении(Элемент)
	УстановкаФильтраИсторияЗвонковАТС();
КонецПроцедуры

&НаКлиенте
Процедура ИсторияОтборПоНомеруПриИзменении(Элемент)
	ИсторияОтборПоНомеру = СофтФон.ПолучитьНомерТелефонаВМеждународномФорматеПользователя(ИсторияОтборПоНомеру);
	УстановкаФильтраИсторияЗвонковАТС();
КонецПроцедуры

&НаКлиенте
Процедура ИсторияОтборПоВнНомеруПриИзменении(Элемент)
	УстановкаФильтраИсторияЗвонковАТС();	
КонецПроцедуры

&НаКлиенте
Процедура ИсторияОтборПоСтатусуПриИзменении(Элемент)
	УстановкаФильтраИсторияЗвонковАТС();	
КонецПроцедуры

&НаКлиенте
Процедура ИсторияОтборПоНаправлениюПриИзменении(Элемент)
	УстановкаФильтраИсторияЗвонковАТС();	
КонецПроцедуры

&НаКлиенте
Процедура ОтметитьЗвонокОбработанным(Команда)
	
	ТекДанные = Элементы.ИсторияЗвонковАТС.ТекущиеДанные;	
	Если ТекДанные = Неопределено Тогда
		Сообщить("Не выделена строка истории");
		Возврат;
	КонецЕсли;
	Если ТекДанные.Обработан Тогда
		Сообщить("Строка истории уже обработана");
		Возврат;
	КонецЕсли;
	ДополнительныеПараметры = Новый Структура("КлючРегистра", Элементы.ИсторияЗвонковАТС.ТекущаяСтрока);
	ОписаниеОповещенияОЗавершении = Новый ОписаниеОповещения("ПослеЗакрытияВопросаОбработкиЗвонка", ЭтаФорма, ДополнительныеПараметры);
	ПоказатьВопрос(ОписаниеОповещенияОЗавершении, "Отметить звонок как обработанный?", РежимДиалогаВопрос.ДаНет);
		
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияВопросаОбработкиЗвонка(Результат, ДополнительныеПараметры) Экспорт
    Если Результат = КодВозвратаДиалога.Нет Тогда
        Возврат;
    КонецЕсли;

    ОтметитьЗвонокОбработаннымНаСервере(ДополнительныеПараметры.КлючРегистра);

КонецПроцедуры

&НаСервере
Процедура ОтметитьЗвонокОбработаннымНаСервере(КлючРегистра)
	МенеджерЗаписи = РегистрыСведений.ИсторияЗвонковАТС.СоздатьМенеджерЗаписи();
	ЗаполнитьЗначенияСвойств(МенеджерЗаписи, КлючРегистра);
	МенеджерЗаписи.Прочитать(); 
	МенеджерЗаписи.Обработан = Истина;
	МенеджерЗаписи.Пользователь  = Пользователи.ТекущийПользователь();
	МенеджерЗаписи.ДатаОбработки = ТекущаяДатаСеанса();
				
	МенеджерЗаписи.Записать(Истина);
	
	Элементы.ИсторияЗвонковАТС.Обновить();
КонецПроцедуры

&НаКлиенте
Процедура СоздатьЛидПоЗвонку(Команда)
	ТекДанные = Элементы.ИсторияЗвонковАТС.ТекущиеДанные;	
	Если ТекДанные = Неопределено Тогда
		Сообщить("Не выделена строка истории");
		Возврат;
	КонецЕсли;
	Если ЗначениеЗаполнено(ТекДанные.Лид) Тогда
		Сообщить("По выбранному звонку уже имеется созданный лид");
		Возврат;
	КонецЕсли;
	ДополнительныеПараметры = Новый Структура("КлючРегистра", Элементы.ИсторияЗвонковАТС.ТекущаяСтрока);
	ОписаниеОповещенияОЗавершении = Новый ОписаниеОповещения("ПослеЗакрытияВопросаСозданияЛидаПоЗвонку", ЭтаФорма, ДополнительныеПараметры);
	ПоказатьВопрос(ОписаниеОповещенияОЗавершении, "Создать лид по выбранному звонку?", РежимДиалогаВопрос.ДаНет);
		
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияВопросаСозданияЛидаПоЗвонку(Результат, ДополнительныеПараметры) Экспорт
    Если Результат = КодВозвратаДиалога.Нет Тогда
        Возврат;
    КонецЕсли;

	ЛидСсылка = СоздатьЛидПоЗвонкуНаСервере(ДополнительныеПараметры.КлючРегистра);
	Если НЕ ЛидСсылка = Неопределено Тогда
		ПараметрыФормы = Новый Структура("Ключ", ЛидСсылка);
		ОткрытьФорму("Документ.Лид.ФормаОбъекта", ПараметрыФормы);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция СоздатьЛидПоЗвонкуНаСервере(КлючРегистра)
	
	//++ №7190 читаем из регистра запись сразу, чтобы обращаться к ресурсам и реквизитам
	МенеджерЗаписи = РегистрыСведений.ИсторияЗвонковАТС.СоздатьМенеджерЗаписи();
	ЗаполнитьЗначенияСвойств(МенеджерЗаписи, КлючРегистра);
	МенеджерЗаписи.Прочитать();
	//-- №7190
	
	//++#6672
	РекламныйИсточник = Справочники.РекламныеИсточники.ПустаяСсылка();
	Если Не ПустаяСтрока(МенеджерЗаписи.ЛинияНомер) Тогда
		РекламныйИсточник = Справочники.РекламныеИсточники.ПолучитьРекламныйИсточникПоНомеруТелефонаНаСервере(МенеджерЗаписи.ЛинияНомер);
	КонецЕсли;
	//--#6672
	
	ЗвонокОффлайн = Ложь;
	Если НЕ МенеджерЗаписи.Пропущен
		И МенеджерЗаписи.Направление = Перечисления.НаправлениеЗвонка.Входящий
		И ЗначениеЗаполнено(МенеджерЗаписи.ВнутреннийНомер)					 
		Тогда
		МассивВН = СофтФон.ВнутренниеНомераПринимающиеЗвонки();
		ЗвонокОффлайн = (НЕ МассивВН.Найти(МенеджерЗаписи.ВнутреннийНомер) = Неопределено);
	КонецЕсли;					
	
	ДанныеЗвонка = Новый Структура("ИДЗвонка, ИДСессииЗвонка, ИДВАТС, НомерКлиента, ВнешняяЛиния, Пропущен, НовыйЗвонок, ЗвонокОффлайн",
									МенеджерЗаписи.ИД, "", МенеджерЗаписи.ИДВАТС, МенеджерЗаписи.НомерФормат, МенеджерЗаписи.ЛинияНомер, МенеджерЗаписи.Пропущен, Ложь, ЗвонокОффлайн);
											
	РеквизитыНовогоЛида = Новый Структура("РекламныйИсточник, СпособСоздания, ДатаЗвонкаСоздавшегоЛид", 
										   РекламныйИсточник, Перечисления.СпособыСозданияЛида.АвтоматическиПриРазбореИсторииАТС, МенеджерЗаписи.Дата); //#8090
	ЛидСсылка = ОбщийМодуль.ПолучитьЛидВРаботе(ДанныеЗвонка, РеквизитыНовогоЛида, Истина);
	
	Если ЗначениеЗаполнено(ЛидСсылка) Тогда
		
		//++ №7190 комментируем, т.к. выше сразу будет чтение записи
		//МенеджерЗаписи = РегистрыСведений.ИсторияЗвонковАТС.СоздатьМенеджерЗаписи();
		//ЗаполнитьЗначенияСвойств(МенеджерЗаписи, КлючРегистра);
		//МенеджерЗаписи.Прочитать();
		//-- №7190
		МенеджерЗаписи.Лид 			 = ЛидСсылка;
		МенеджерЗаписи.Действие 	 = Справочники.АвтоматическиеДействия.СозданНовыйЛид;
		МенеджерЗаписи.Обработан 	 = Истина;
		МенеджерЗаписи.Пользователь  = Пользователи.ТекущийПользователь();
		МенеджерЗаписи.ДатаОбработки = ТекущаяДатаСеанса();	
		МенеджерЗаписи.Записать(Истина);
		
		Элементы.ИсторияЗвонковАТС.Обновить();

		Возврат ЛидСсылка;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

