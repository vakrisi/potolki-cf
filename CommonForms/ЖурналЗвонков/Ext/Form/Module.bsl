		Возврат;
	КонецЕсли; 
	
	//СофтФонКлиент.ПрослушатьЗаписьЗвонка(ТекДанные.ИДВАТС, ТекДанные.ИД, ТекДанные.ЕстьЗапись, ТекДанные.ФайлЗаписиСсылка);  // 2021-12-22 Ильнур
	СофтФонКлиент.ОткрытьЗаписьЗвонкаПоСсылке(ТекДанные.ИДВАТС, ТекДанные.ИД, ТекДанные.ЕстьЗапись, ТекДанные.ФайлЗаписиСсылка);
	
