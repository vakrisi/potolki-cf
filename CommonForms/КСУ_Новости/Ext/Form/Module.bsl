КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Содержание = ЗначениеИзСтрокиВнутр(параметры.новость);
КонецПроцедуры

&НаСервере
Процедура ОтправитьНаСервере()
	имяОрг = сокрлп(Константы.КСУ_НазваниеОрганизации.Получить());
	Если имяОрг = "" Тогда
		Сообщить("Заполните константу ""Название организации"" в настройках КСУ.");
		возврат;
	КонецЕсли;
	
	
	АдресСервера = Константы.КСУ_АдресСервераНовостей.Получить();
	текПольз = ПараметрыСеанса.ТекущийПользователь;
	 Попытка
		Соединение = Новый HTTPСоединение(АдресСервера,,"KSU","BycfqnPfobnf");
	Исключение
		сообщить(ОписаниеОшибки());
		возврат;
	КонецПопытки;
	
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();	
	ЗаписатьJSON(ЗаписьJSON, новый структура("Company,Text,User",имяОрг,Сообщение,строка(ПараметрыСеанса.ТекущийПользователь)));
	СтрокаДляЗапроса = ЗаписьJSON.Закрыть();
	
	HTTPЗапрос = Новый HTTPЗапрос("/ksu_news/hs/Support/Comment");
	HTTPЗапрос.УстановитьТелоИзСтроки(СтрокаДляЗапроса);
	
	Попытка
		HTTPОтвет = Соединение.ОтправитьДляОбработки(HTTPЗапрос);
		Ответ = HTTPОтвет.ПолучитьТелоКакСтроку();
	Исключение
		сообщить(ОписаниеОшибки());
		возврат;
	КонецПопытки;
	
	Если HTTPОтвет.КодСостояния = 200 Тогда
		Сообщить("Сообщение отправлено!");
	Иначе
		сообщить(Ответ);
	КонецЕсли; 
КонецПроцедуры

&НаКлиенте
Процедура Отправить(Команда)
	ОтправитьНаСервере();
КонецПроцедуры

