
&НаКлиенте
Процедура КомандаОК(Команда)
	Закрыть(Элементы.СписокСтатистик.ТекущиеДанные);
КонецПроцедуры

&НаКлиенте
Процедура СписокСтатистикВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	Закрыть(Элементы.СписокСтатистик.ТекущиеДанные);
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если Параметры.Свойство("СписокСтатистик") Тогда
		СписокСтатистик = Параметры.СписокСтатистик;
	КонецЕсли;
КонецПроцедуры
