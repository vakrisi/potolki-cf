//++ №13850 поиск существующей карточки номенклатуры по номеру расчета, если найдётся, то все поля заполняем по ней и делаем все поля только для просмотра
&НаСервере
Процедура ВыполнитьПоискСуществующейКарточкиНоменклатуры()
	
	МассивЭлементов = новый Массив;
	
	// По потолку
	МассивЭлементов.Добавить("ГруппаФактура");
	МассивЭлементов.Добавить("Цвет");
	
	// По отрезу
	МассивЭлементов.Добавить("ГруппаФактура1");
	МассивЭлементов.Добавить("Цвет1");
	МассивЭлементов.Добавить("Длина3");
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Номенклатура.Ссылка КАК Ссылка,
	|	Номенклатура.ВидНоменклатуры КАК ВидНоменклатуры
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	Номенклатура.ВидНоменклатуры В (ЗНАЧЕНИЕ(Справочник.ВидыНоменклатуры.Потолок), 
	|									ЗНАЧЕНИЕ(Справочник.ВидыНоменклатуры.Отрез), 
	|									ЗНАЧЕНИЕ(Справочник.ВидыНоменклатуры.Продукция))
	|	И Номенклатура.Потолок_НомерРасчета = &Потолок_НомерРасчета";
	
	Запрос.УстановитьПараметр("Потолок_НомерРасчета", НомерПотолка);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	ПозицияНайдена = Ложь;
	
	Если Выборка.Следующий() Тогда
		
		// Если добавляем например Потолок, а нашли Отрез, то поля соответственно не заполняем по карточке номенклатуры
		// выводим сообщение и возвращаем номер расчета предыдущий
		Если ((РежимДобавленияПотолка И Выборка.ВидНоменклатуры = Справочники.ВидыНоменклатуры.Потолок)
			Или (РежимДобавленияОтреза И Выборка.ВидНоменклатуры = Справочники.ВидыНоменклатуры.Отрез)) Тогда
		
			ПозицияНайдена = Истина;
		
			Номенклатура = Выборка.Ссылка;
		
			Фактуры = Номенклатура.Потолок_Фактура;
			ШиринаПолотна = 0;
			
			Если Фактуры.Количество() > 0 Тогда
				
				Фактура = Фактуры[0].ПродукцияФактура;
				Цвет = Фактуры[0].ПродукцияЦвет;
				ШиринаПолотна = Фактуры[0].Фактура_ШиринаПолотна;
				
			КонецЕсли;
			
			// для отреза рассчитаем длину
			Если РежимДобавленияОтреза И ШиринаПолотна > 0 Тогда
				
				Длина = ((Номенклатура.Потолок_КоличествоПродукция * 100) / ШиринаПолотна) * 100;
				
				// рассчитываем площадь в кв.м.
				Количество = (ШиринаПолотна * Длина) / 10000;
				
			КонецЕсли;
			
			НомерПотолкаПредыдущий = НомерПотолка;
			
		Иначе
			
			НомерПотолка = НомерПотолкаПредыдущий;
			Сообщить(СтрШаблон("Введенный номер расчёта используется у номенклатуры %1 с видом номенклатуры %2, номер расчёта возвращен к исходному.", Выборка.Ссылка, Выборка.ВидНоменклатуры));
			
		КонецЕсли;
			
	КонецЕсли;
		
	Если НЕ ПозицияНайдена Тогда
		
		НомерПотолкаПредыдущий = НомерПотолка;
		
		Номенклатура = Справочники.Номенклатура.ПустаяСсылка();
		ПолучитьНаименованиеПродукции();
		
	КонецЕсли;
	
	// Меняем свойство "Только просмотр" по результатам поиска
	Для Каждого ЭлементМассива Из МассивЭлементов Цикл
		
		Элементы[ЭлементМассива].ТолькоПросмотр = ПозицияНайдена;
		
	КонецЦикла;
	
	ОбновитьВидимостьВГруппеНоменклатура();
	
КонецПроцедуры
//-- №13850

#КонецОбласти
