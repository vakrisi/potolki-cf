//Начало добавлен при переходе на 2.0 - Нужно проверить наличие в ЗП
&НаСервере
Функция РазрешеноДобавлятьПотолок()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЗаказПокупателя.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.ЗаказПокупателя.Товары КАК ЗаказПокупателя
		|ГДЕ
		|	ЗаказПокупателя.Номенклатура = &Номенклатура
		|	И НЕ ЗаказПокупателя.Ссылка.ПометкаУдаления
		|	И НЕ ЗаказПокупателя.Ссылка.ТекущийСтатус = Значение(Справочник.СтатусыЗаказовПокупателей.Отменен)";
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Выборка = Запрос.Выполнить().Выбрать();		
	
	Пока Выборка.Следующий() Цикл
		Сообщить("Внимание! Данный " + Номенклатура + " уже указан в документе " + Выборка.Ссылка + " Добавление отменено.");
	КонецЦикла;
	
	Если Выборка.Количество() > 0 Тогда 
		Возврат Ложь;
	Иначе
		Возврат Истина;
	КонецЕсли; 	
	
КонецФункции
//Конец добавлен при переходе на 2.0 - Нужно проверить наличие в ЗП

&НаСервере
Процедура ПолучитьНаименованиеПродукции()
	
	Если РежимДобавленияПотолка Тогда	
		НаименованиеПотолка = ОбменСEasyCeiling.ПолучитьНаименованиеПотолка(НомерПотолка, Цвет, Фактура, , , Фактура.ШиринаПолотна);

	ИначеЕсли РежимДобавленияОтреза Тогда	
		
		//++ №12523
		//НаименованиеПотолка = ОбменСEasyCeiling.ПолучитьНаименованиеОтреза(НомерПотолка, Цвет, Фактура);
		НаименованиеПотолка = ОбменСEasyCeiling.ПолучитьНаименованиеОтреза(НомерПотолка, Цвет, Фактура, Количество);
		//-- №12523

	//ИначеЕсли РежимДобавленияТиповогоОтреза Тогда
	//	НаименованиеПотолка = ОбменСEasyCeiling.ПолучитьНаименованиеТиповогоОтреза(НомерПотолка, Цвет, Фактура);
		
	ИначеЕсли РежимДобавленияОстаткаПленки Тогда
		НаименованиеПотолка = ОбменСEasyCeiling.ПолучитьНаименованиеОстатка(НомерПотолка, Цвет, Фактура);
		
	КонецЕсли;
	
	Номенклатура = Справочники.Номенклатура.НайтиПоНаименованию(НаименованиеПотолка, Истина, ГруппаНоменклатурыДляПоиска);
	
	ОбновитьВидимостьВГруппеНоменклатура();
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьВидимостьВГруппеНоменклатура()
	
	Если НЕ Номенклатура.Пустая() Тогда		
		
		Элементы.Номенклатура.Видимость = Истина;
		Элементы.НаименованиеПотолка.Видимость = Ложь;
		
	Иначе
		
		Элементы.Номенклатура.Видимость = Ложь;
		Элементы.НаименованиеПотолка.Видимость = Истина;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьПлощадь()
	
	// площадь в кв.м.
	Количество = (ШиринаПолотна * Длина) / 10000;
	
КонецПроцедуры

