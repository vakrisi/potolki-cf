
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	РежимДобавленияОтреза = Параметры.РежимДобавленияОтреза;
	//РежимДобавленияТиповогоОтреза = Параметры.РежимДобавленияТиповогоОтреза;
	РежимДобавленияОстаткаПленки = Параметры.РежимДобавленияОстаткаПленки;
	РежимДобавленияПотолка = НЕ РежимДобавленияОтреза И НЕ РежимДобавленияТиповогоОтреза И НЕ РежимДобавленияОстаткаПленки;
	
	ГруппаНоменклатурыДляПоиска = Константы.ГруппаНоменклатурыПродукция.Получить();
	
	// #11670 - доработки в рамках заявки
	Если Параметры.ПоНомеруДоговора Тогда
		Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.ГруппаПотолок;
		НомерПотолка = СокрЛП(Параметры.НомерДоговора) + "-" + СтрЗаменить(Строка(Параметры.КоличествоПотолковВДокументе+1), Символ(160),"");
		
	ИначеЕсли РежимДобавленияПотолка Тогда
		Заголовок = "Добавление простого потолка";
		Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.ГруппаПотолок;
		НомерПотолка = ОбщийМодуль.ПолучитьНомерНовогоРасчета(Справочники.ВидыНоменклатуры.Потолок); // №13851 было: ОбщийМодуль.ПолучитьНомерНовогоРасчетаПотолка();
		
	ИначеЕсли РежимДобавленияОтреза Тогда
		Заголовок = "Добавление отреза";
		Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.ГруппаОтрез;
		НомерПотолка = ОбщийМодуль.ПолучитьНомерНовогоРасчета(Справочники.ВидыНоменклатуры.Отрез); // №13851 было: ОбщийМодуль.ПолучитьНомерНовогоРасчетаПотолка();
		
	//ИначеЕсли РежимДобавленияТиповогоОтреза Тогда
	//	Заголовок = "Добавление типового отреза";
	//	Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.ГруппаТиповойОтрез;
	//	НомерПотолка = ОбменСEasyCeiling.ПолучитьНомерТиповогоОтреза(0, 0);
		
	ИначеЕсли РежимДобавленияОстаткаПленки Тогда
		ГруппаНоменклатурыДляПоиска = Константы.ГруппаНоменклатурыДляОстатков.Получить();
		Заголовок = "Добавление остатка пленки";
		Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.ГруппаОстатокПленки;		
		НомерПотолка = ОбменСEasyCeiling.ПолучитьНомерОстатковПленки(0, 0);
		
	КонецЕсли;
	
	НомерПотолкаПредыдущий = НомерПотолка; // №13850
	
	Если Параметры.Свойство("Фактура") И Параметры.Свойство("Цвет") Тогда
		Фактура = Параметры.Фактура;	
		Цвет = Параметры.Цвет;
	КонецЕсли;
	Если Параметры.Свойство("Длина") Тогда
		Длина = Параметры.Длина;
	КонецЕсли;
	ПолучитьНаименованиеПродукции();
		
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если ЗначениеЗаполнено(Фактура) Тогда
		ФактураПриИзменении(Неопределено);	
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийКомандФормы

&НаКлиенте
Процедура ВыбратьПоНоменклатуреПолотна(Команда)
	
	Отбор = Новый Структура;
	Отбор.Вставить("ВидНоменклатуры", ПредопределенноеЗначение("Справочник.ВидыНоменклатуры.Полотно"));
	
	ПараметрыФормыВыбора = Новый Структура;
	ПараметрыФормыВыбора.Вставить("МножественныйВыбор", Ложь);
	ПараметрыФормыВыбора.Вставить("Отбор",              Отбор);
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ВыбратьПоНоменклатуреПолотнаЗавершение", ЭтотОбъект);	
	ОткрытьФорму("Справочник.Номенклатура.ФормаВыбора", ПараметрыФормыВыбора, ЭтотОБъект, , , , ОписаниеОповещения);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьПоНоменклатуреПолотнаЗавершение(ВыбранноеЗначение, ДополнительныеПараметры) Экспорт
	
	Если ВыбранноеЗначение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Результат = ФактураИЦветПоНоменклатуреПолотнаСервер(ВыбранноеЗначение);
	Если ЗначениеЗаполнено(Результат.Фактура) Тогда
		Фактура = Результат.Фактура;
		Цвет = Результат.ЦветФактуры;
		ФактураПриИзменении(Неопределено);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Отмена(Команда)
	Закрыть();
КонецПроцедуры

&НаКлиенте
Процедура ОК(Команда)
	
	//#12089
	Если НЕ ПроверитьЗаполнение() Тогда
		Возврат;
	КонецЕсли;
	
	Если Номенклатура.Пустая() Тогда
		Номенклатура = СоздатьНоменклатуруПродукцияНаСервере(НомерПотолка, Цвет, Фактура, Количество, РежимДобавленияПотолка, РежимДобавленияОтреза, РежимДобавленияТиповогоОтреза, РежимДобавленияОстаткаПленки);	
	КонецЕсли;
	
	Если Номенклатура.Пустая() Тогда
		Возврат;	
	КонецЕсли;
	
	//++ №12523 комментируем, т.к. отрез тоже нужно проверять
	//РазрешеноДобавлять = Истина;
	//Если НЕ РежимДобавленияОтреза Тогда
	//-- №12523
		РазрешеноДобавлять = РазрешеноДобавлятьПотолок();
	//КонецЕсли;
	
	Если НЕ Номенклатура.Пустая() И РазрешеноДобавлять Тогда		
				
		СтруктураОтвета = Новый Структура;
		СтруктураОтвета.Вставить("НомерПотолка",НомерПотолка);
		СтруктураОтвета.Вставить("Фактура",Фактура);
		СтруктураОтвета.Вставить("Цвет",Цвет);
		СтруктураОтвета.Вставить("Номенклатура",Номенклатура);
		СтруктураОтвета.Вставить("Количество", Количество);	
		Закрыть(СтруктураОтвета);
			
	КонецЕсли;
		
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура НомерПотолкаПриИзменении(Элемент)
	
	//++ №13850 поиск существующей карточки номенклатуры по номеру расчета, если найдётся, то все поля заполняем по ней и делаем все поля только для просмотра
	Если ЗначениеЗаполнено(НомерПотолка) И (РежимДобавленияПотолка Или РежимДобавленияОтреза) Тогда
		
		ВыполнитьПоискСуществующейКарточкиНоменклатуры();
		
	Иначе
	//-- №13850
		
		ПолучитьНаименованиеПродукции();
		НомерПотолкаПредыдущий = НомерПотолка; // №13850
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ФактураПриИзменении(Элемент)
	
	ШиринаПолотна = ПолучитьШиринуФактуры(Фактура);
	РассчитатьПлощадь();
	ПриИзмененииПараметровПродукции();
	
КонецПроцедуры

&НаКлиенте
Процедура ЦветПриИзменении(Элемент)
	
	ПолучитьНаименованиеПродукции();
	
КонецПроцедуры

&НаКлиенте
Процедура КоличествоПриИзменении(Элемент)
	
	ПриИзмененииПараметровПродукции();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриИзмененииПараметровПродукции()
	
	//Если РежимДобавленияТиповогоОтреза Тогда
	//	ДлинаТиповогоОтреза  = Формат(Длина, "ЧДЦ=; ЧГ=0");
	//	ШиринаТиповогоОтреза = Формат(ПолучитьШиринуФактуры(Фактура), "ЧДЦ=; ЧГ=0");
	//	НомерПотолка = ОбменСEasyCeiling.ПолучитьНомерТиповогоОтреза(ДлинаТиповогоОтреза, ШиринаТиповогоОтреза);
	//	
	//Иначе
		
	Если РежимДобавленияОстаткаПленки Тогда
		ДлинаОстатка  = Формат(Длина, "ЧДЦ=; ЧГ=0");
		ШиринаОстатка = Формат(ШиринаПолотна, "ЧДЦ=; ЧГ=0");
		НомерПотолка = ОбменСEasyCeiling.ПолучитьНомерОстатковПленки(ДлинаОстатка, ШиринаОстатка);
		
	КонецЕсли;
	ПолучитьНаименованиеПродукции();

КонецПроцедуры

&НаКлиенте
Процедура ДлинаПриИзменении(Элемент)
	
	РассчитатьПлощадь();
	ПриИзмененииПараметровПродукции();
	
КонецПроцедуры

&НаКлиенте
Процедура ШиринаПриИзменении(Элемент)
	
	РассчитатьПлощадь();
	ПриИзмененииПараметровПродукции();
	
КонецПроцедуры

&НаКлиенте
Процедура ПлощадьПриИзменении(Элемент)
	
	Если НЕ ШиринаПолотна = 0 Тогда
		Длина = Количество * 10000 / ШиринаПолотна;
		ПриИзмененииПараметровПродукции();
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

