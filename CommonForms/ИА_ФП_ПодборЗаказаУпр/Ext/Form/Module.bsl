
&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ПриОткрытииНаСервере();
КонецПроцедуры

&НаСервере
Процедура ПриОткрытииНаСервере()
	
	МассивОрганизаций = ИА_ФП.ПолучитьСписокОрганизацийГК(Организация);
	РазделятьНалБезнал = ИА_ФП.ИА_ПолучитьКонстантуРазделятьНалИБезнал();
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ИА_СредстваВРезервеНаФондахОстатки.ЗП КАК Заказ,
	               |	ЕСТЬNULL(ИА_СредстваВРезервеНаФондахОстатки.СуммаБезналОстаток, 0) * &Безнал + ЕСТЬNULL(ИА_СредстваВРезервеНаФондахОстатки.СуммаНалОстаток, 0) * &Нал КАК Сумма,
	               |	ИА_СредстваВРезервеНаФондахОстатки.ЗП.ПредметЗаказа КАК ПредметЗаказа,
	               |	ИА_СредстваВРезервеНаФондахОстатки.ЗП.Фонд КАК Фонд,
	               |	ИА_СредстваВРезервеНаФондахОстатки.ЗП.Сумма КАК СуммаЗаявки,
	               |	ИА_СредстваВРезервеНаФондахОстатки.ЗП.Дата КАК Дата,
	               |	ИА_СредстваВРезервеНаФондахОстатки.ЗП.Номер КАК Номер,
	               |	ИА_СредстваВРезервеНаФондахОстатки.ЗП.Организация КАК Организация,
	               |	ИА_СредстваВРезервеНаФондахОстатки.ЗП.ОрганизацияДочерняя КАК ОрганизацияДочерняя
	               |ИЗ
	               |	РегистрНакопления.ИА_СредстваВРезервеНаФондах.Остатки(
	               |			&НаДату,
	               |			ВЫБОР
	               |					КОГДА &РазделятьНалБезнал = ЛОЖЬ
	               |						ТОГДА ИСТИНА
	               |					ИНАЧЕ ВЫБОР
	               |							КОГДА ЗП.ВидДС = ЗНАЧЕНИЕ(Перечисление.ИА_ВидДенежныхСредств.Безналичные)
	               |									И &ОтображатьНал = ЛОЖЬ
	               |								ТОГДА ИСТИНА
	               |							КОГДА ЗП.ВидДС = ЗНАЧЕНИЕ(Перечисление.ИА_ВидДенежныхСредств.Наличные)
	               |									И &ОтображатьНал = ИСТИНА
	               |								ТОГДА ИСТИНА
	               |							КОГДА ЗП.ВидДС = ЗНАЧЕНИЕ(Перечисление.ИА_ВидДенежныхСредств.ПустаяСсылка)
	               |								ТОГДА ИСТИНА
	               |							ИНАЧЕ ЛОЖЬ
	               |						КОНЕЦ
	               |				КОНЕЦ
	               |				И ВЫБОР
	               |					КОГДА &ВестиФППоОрганизациям = ИСТИНА
	               |						ТОГДА Организация В (&МассивОрганизаций)
	               |					ИНАЧЕ ИСТИНА
	               |				КОНЕЦ) КАК ИА_СредстваВРезервеНаФондахОстатки";
				   
	Запрос.УстановитьПараметр("НаДату", КонецДня(НаДату));
	Запрос.УстановитьПараметр("Нал", ?(Нал,1,0));
	Запрос.УстановитьПараметр("Безнал", ?(Нал,0,1));
	Запрос.УстановитьПараметр("МассивОрганизаций", МассивОрганизаций);
	Запрос.УстановитьПараметр("ВестиФППоОрганизациям", Константы.ИА_ФП_ВестиФППоОрганизациям.Получить());

	Запрос.УстановитьПараметр("РазделятьНалБезнал", РазделятьНалБезнал);
	Запрос.УстановитьПараметр("ОтображатьНал", Нал);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока выборка.Следующий() Цикл
		новстр = тз.Добавить();
		ЗаполнитьЗначенияСвойств(новстр, Выборка);
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ТЗВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	Стр = Новый Структура("ЗП, Сумма", Элемент.ТекущиеДанные.Заказ, Элемент.ТекущиеДанные.Сумма);
	Закрыть(Стр);
КонецПроцедуры

&НаКлиенте
Процедура КомандаОК(Команда)
	Если Элементы.ТЗ.ТекущиеДанные <> Неопределено Тогда
		Стр = Новый Структура("ЗП, Сумма", Элементы.ТЗ.ТекущиеДанные.Заказ, Элементы.ТЗ.ТекущиеДанные.Сумма);
		Закрыть(Стр);
	Иначе
		Закрыть();
	КонецЕсли;

КонецПроцедуры

