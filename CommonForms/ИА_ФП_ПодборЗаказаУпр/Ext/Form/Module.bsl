&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Организация = Параметры.Организация;
	НаДату = Параметры.НаДату;
	
	ИА_ФП.ВидимостьЭлементовФормыНастройкиОрганизаций(ЭтаФорма);
	ВидимостьЭлементовФорм();
	
КонецПроцедуры

&НаСервере
Процедура ВидимостьЭлементовФорм()
	
	РазделятьНалБезнал = Константы.ИА_ФП_РазделятьНалИБезнал.Получить();
	ИспользоватьВидДССправочно = Константы.ИА_ФП_ИспользоватьВидДССправочно.Получить();

	Если РазделятьНалБезнал Тогда
		
		Элементы.ТЗВидДС.Видимость = Истина;
		Элементы.ТЗВидДССправочно.Видимость = ложь;
		
	Иначе	
		
		Элементы.ТЗВидДС.Видимость = Ложь;
		Элементы.ТЗВидДССправочно.Видимость = ИспользоватьВидДССправочно;
		
	КонецЕсли;

КонецПроцедуры

