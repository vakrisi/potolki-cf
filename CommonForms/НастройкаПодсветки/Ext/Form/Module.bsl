		Элементы[ИмяЭлементаСоЦветом].ЦветФона = ЭлементМассива.Цвет;
		Элементы[ИмяЭлементаСоЦветом].ЦветТекста = ЭлементМассива.Цвет;		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура Добавленный_УстановитьЦветПоУмолчаниюЗамера(Элемент)
	
	ИмяНастройки = СтрЗаменить(Элемент.Имя, "УстановитьЦвет", "");	
	ИмяЭлементаСоЦветом = "ГЗДекорацияЦвет" + ИмяНастройки;
	
	НастройкиОформления = ПолучитьНастройкиОформленияГрафикаЗамеров();
