			Элементы[ИмяЭлементаСоЦветом].ЦветФона = ЭлементМассива.Цвет;
			Элементы[ИмяЭлементаСоЦветом].ЦветТекста = ЭлементМассива.Цвет;
			Прервать;
		КонецЕсли;		
	КонецЦикла;
		
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыФункции

&НаСервере
Функция ПолучитьНастройкиОформленияГрафикаЗамеров()
	
	Возврат ОбщийМодульСервер.ПолучитьНастройкиОформленияГрафикаЗамеров();
			
КонецФункции

&НаСервере
Функция ПолучитьНастройкиОформленияГрафикаМонтажей()
	
	Возврат ОбщийМодульСервер.ПолучитьНастройкиОформленияГрафикаМонтажей();
			
КонецФункции

#КонецОбласти
