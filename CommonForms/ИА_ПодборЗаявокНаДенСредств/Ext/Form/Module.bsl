&НаКлиенте
Процедура ПеренестиВДокумент(Команда)
	Парам = ПеренестиВДокументНаСервере();
	ЭтаФорма.ВладелецФормы.ОбработкаПодбораЗаказовФондов(Парам); 
	ЭтаФорма.Закрыть();
КонецПроцедуры

&НаКлиенте
Процедура СписокЗаявокВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	Данные = Элементы.СписокЗаявок.ТекущиеДанные;   
	Если НЕ Данные = Неопределено Тогда 
		СписокЗаявокВыборНаСервере(Данные); 
	КонецЕсли; 		
КонецПроцедуры

&НаКлиенте
Процедура ИА_ЗаказыНаПриобретениеСуммаПриИзменении(Элемент)
	Данные = Элементы.ИА_ЗаказыНаПриобретение.ТекущиеДанные;
	Если НЕ Данные = Неопределено Тогда
		Если (Данные.Остаток < Данные.Сумма)  Тогда
			Сообщить("Введена сумма больше доступной к выплате!");
			Данные.Сумма = Данные.Остаток;
		КонецЕсли;	
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ИА_ЗаказыНаПриобретениеПослеУдаления(Элемент)
	ОбновитьСписокЗаявок();	
КонецПроцедуры

