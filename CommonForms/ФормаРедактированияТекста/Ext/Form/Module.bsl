&НаКлиенте
Процедура ОК(Кнопка)
    // Возвращаем изменённый текст и закрываем форму
    Закрыть(ПолеТекста);
КонецПроцедуры

&НаКлиенте
Процедура Отмена(Кнопка)
    // Закрываем форму без возврата значения
    Закрыть(Ложь);
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ПолеТекста = Параметры.Текст;
    ЗаголовокФормы = Параметры.Заголовок;
КонецПроцедуры
