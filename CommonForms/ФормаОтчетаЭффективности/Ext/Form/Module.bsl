// Выполняет расчет и вывод показателей выделенной области ячеек.
// См. обработчик события ОтчетТабличныйДокументПриАктивизацииОбласти.
//
&НаКлиенте
Процедура РассчитатьПоказателиДинамически()
	Перем ТекущаяКоманда;
	
	КомандыПоказателей = КомандыПоказателей();
	Для Каждого Команда Из КомандыПоказателей Цикл 
		Если Элементы[Команда.Ключ].Пометка Тогда 
			ТекущаяКоманда = Команда.Ключ;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	РассчитатьПоказатели(ТекущаяКоманда);
КонецПроцедуры

// Выполняет расчет и вывод показателей выделенных областей ячеек табличного документа.
//
// Параметры:
//  ТекущаяКоманда - Строка - имя команды расчета показателя, например, "РассчитатьСумму".
//                      Определяет, какой показатель является основным.
//
&НаКлиенте
Процедура РассчитатьПоказатели(ТекущаяКоманда = "РассчитатьСумму")
	// Расчет показателей.
	ПараметрыРасчета = ОбщегоНазначенияСлужебныйКлиент.ПараметрыРасчетаПоказателейЯчеек(ТабличныйДокумент);
	Если ПараметрыРасчета.РассчитатьНаСервере Тогда 
		РасчетныеПоказатели = РасчетныеПоказателиСервер(ПараметрыРасчета);
	Иначе
		РасчетныеПоказатели = ОбщегоНазначенияСлужебныйКлиентСервер.РасчетныеПоказателиЯчеек(
			ТабличныйДокумент, ПараметрыРасчета.ВыделенныеОбласти);
	КонецЕсли;
	
	// Установка значений показателей.
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, РасчетныеПоказатели);
	
	// Переключение и форматирование показателей.
	КомандыПоказателей = КомандыПоказателей();
	Для Каждого Команда Из КомандыПоказателей Цикл 
		Элементы[Команда.Ключ].Пометка = Ложь;
		
		ЗначениеПоказателя = РасчетныеПоказатели[Команда.Значение];
		РазрядностьПоказателя = Мин(СтрДлина(Макс(ЗначениеПоказателя, -ЗначениеПоказателя) % 1) - 2, 4);
		
		Элементы[Команда.Значение].ФорматРедактирования = "ЧДЦ=" + РазрядностьПоказателя + "; ЧРГ=' '; ЧН=0";
	КонецЦикла;
	Элементы[ТекущаяКоманда].Пометка = Истина;
	
	// Вывод основного показателя.
	ТекущийПоказатель = КомандыПоказателей[ТекущаяКоманда];
	Показатель = ЭтотОбъект[ТекущийПоказатель];
	Элементы.Показатель.ФорматРедактирования = Элементы[ТекущийПоказатель].ФорматРедактирования;
	Элементы.ГруппаВидыПоказателей.Картинка = БиблиотекаКартинок[ТекущийПоказатель];
	//Элементы.ГруппаВидыПоказателейЕще.Картинка = БиблиотекаКартинок[ТекущийПоказатель];
	
КонецПроцедуры

// Рассчитывает показатели числовых ячеек в табличном документе.
//  см. ОтчетыКлиентСервер.РасчетныеПоказателиЯчеек.
//
&НаСервере
Функция РасчетныеПоказателиСервер(ПараметрыРасчета)
	Возврат ОбщегоНазначенияСлужебныйКлиентСервер.РасчетныеПоказателиЯчеек(ТабличныйДокумент, ПараметрыРасчета.ВыделенныеОбласти);
КонецФункции

// Определяет соответствие между командами расчета показателей и показателями.
//
// Возвращаемое значение:
//   Соответствие - Ключ - имя команды, Значение - имя показателя.
//
&НаКлиенте
Функция КомандыПоказателей()
	КомандыПоказателей = Новый Соответствие();
	КомандыПоказателей.Вставить("РассчитатьСумму", "Сумма");
	КомандыПоказателей.Вставить("РассчитатьКоличество", "Количество");
	КомандыПоказателей.Вставить("РассчитатьСреднее", "Среднее");
	КомандыПоказателей.Вставить("РассчитатьМинимум", "Минимум");
	КомандыПоказателей.Вставить("РассчитатьМаксимум", "Максимум");
	
	Возврат КомандыПоказателей;
КонецФункции

// Управляет признаком видимости панели расчетных показателей.
//
// Параметры:
//  Видимость - Булево - Признак включения / выключения видимости панели показателей.
//              См. также Синтакс-помощник: ГруппаФормы.Видимость.
//
&НаКлиенте
Процедура УстановитьВидимостьПоказателей(Видимость)
	Элементы.ОбластьПоказателей.Видимость = Видимость;
	Элементы.РассчитатьВсеПоказатели.Пометка = Видимость;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыФункции

&НаСервере
Процедура УстановитьКлючТекущегоВарианта(ОтчетПолноеИмя, СсылкаТекущийВариант)
	
	Если СсылкаТекущийВариант = Неопределено Тогда
		// вызов только ПриСозданииНаСервере - КлючТекущегоВарианта сохраняем / загружаем сами
		Если ЗначениеЗаполнено(ДополнительныйКлючОтчета) Тогда 
			КлючОбъекта = ОтчетПолноеИмя + "/" + ДополнительныйКлючОтчета + "/КлючТекущегоВарианта";
		Иначе
			КлючОбъекта = ОтчетПолноеИмя + "/КлючТекущегоВарианта";
		КонецЕсли;		
		КлючТекущегоВарианта = ОбщегоНазначения.ХранилищеСистемныхНастроекЗагрузить(КлючОбъекта, "");
	
		НайденныеСтроки = ВариантыОтчета.НайтиСтроки(Новый Структура("КлючВарианта", КлючТекущегоВарианта));		
	Иначе
		НайденныеСтроки = ВариантыОтчета.НайтиСтроки(Новый Структура("Ссылка", СсылкаТекущийВариант));	
	КонецЕсли;
	
	Если НайденныеСтроки.Количество() = 0 Тогда
		// данный вариант отчета не поддерживается
		КлючТекущегоВарианта = ВариантыОтчета[0].КлючВарианта;
		ИмяКоманды = ВариантыОтчета[0].ИмяКоманды;
		Предопределенный = Истина;
	Иначе
		КлючТекущегоВарианта = НайденныеСтроки[0].КлючВарианта; // для случая когда СсылкаТекущийВариант <> Неопределено
		ИмяКоманды = НайденныеСтроки[0].ИмяКоманды;
		Предопределенный = НайденныеСтроки[0].Предопределенный;
	КонецЕсли;	
	
	ЗагрузитьНастройкиВариантаОтчета(ИмяКоманды, КлючТекущегоВарианта, Предопределенный);
	
КонецПроцедуры

&НаСервере
Функция АдресНастроек()
	
	// структура настроек пользовательского варианта отчета
	НовыеНастройки = Новый Структура;
	НовыеНастройки.Вставить("ТаблицаПоказателей", ТаблицаТекущихПоказателей.Выгрузить(, "ИдПоказателя"));
	//НовыеНастройки.Вставить("ДополнительныйКлючОтчета", ДополнительныйКлючОтчета);
	
	АдресНастроек = ПоместитьВоВременноеХранилище(НовыеНастройки, УникальныйИдентификатор);
	
	Возврат АдресНастроек;
	
КонецФункции

&НаСервере
Процедура ДобавитьВариантОтчета(ВариантыОтчета, Вариант, Предопределенный)
	
	НоваяСтрока = ВариантыОтчета.Добавить();
	НоваяСтрока.КлючВарианта 		= Вариант.КлючВарианта;
	НоваяСтрока.ИмяКоманды 			= Вариант.ИмяКоманды;
	НоваяСтрока.Представление 		= Вариант.Представление;
	НоваяСтрока.Предопределенный 	= Предопределенный;
	НоваяСтрока.ТолькоДляАвтора 	= Вариант.ТолькоДляАвтора;
	НоваяСтрока.Автор 				= Вариант.Автор;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьКомандыВыбораВариантов()
	
	// выводим варианты в подменю		
	Для Каждого СтрокаТаблицы Из ВариантыОтчета Цикл
		Если СтрокаТаблицы.ТолькоДляАвтора = Истина
			И СтрокаТаблицы.Автор <> Пользователи.АвторизованныйПользователь() Тогда
			Продолжить;
		КонецЕсли;
		
		Найденные = ВариантыФормы.НайтиСтроки(Новый Структура("КлючВарианта", СтрокаТаблицы.КлючВарианта));
		Если Найденные.Количество() = 0 Тогда
		
			Команда = Команды.Добавить(СтрокаТаблицы.ИмяКоманды);
			Команда.Действие = "Подключаемый_ЗагрузитьВариантОтчета";
			
			Кнопка = Элементы.Добавить(СтрокаТаблицы.ИмяКоманды, Тип("КнопкаФормы"), Элементы.ГруппаВариантыОтчета);
			Кнопка.Вид = ВидКнопкиФормы.КнопкаКоманднойПанели;
			Кнопка.ИмяКоманды = СтрокаТаблицы.ИмяКоманды;
			Кнопка.Заголовок = СтрокаТаблицы.Представление;	
			
			ВариантФормы = ВариантыФормы.Добавить();
			ЗаполнитьЗначенияСвойств(ВариантФормы, СтрокаТаблицы);
			
		Иначе
			
			Кнопка = Элементы.Найти(СтрокаТаблицы.ИмяКоманды);
			Элементы.Переместить(Кнопка, Элементы.ГруппаВариантыОтчета);
			
		КонецЕсли;
		
		Кнопка.Пометка = (КлючТекущегоВарианта = СтрокаТаблицы.КлючВарианта);
	КонецЦикла;
	
КонецПроцедуры
	
&НаСервере
Функция ТаблицаТекущихПоказателей()
	Возврат ОбщегоНазначения.ТаблицаЗначенийВМассив(ТаблицаТекущихПоказателей.Выгрузить());
КонецФункции

&НаСервере
Процедура ЗагрузитьНастройкиВариантаОтчета(ИмяКоманды, КлючТекущегоВарианта, Предопределенный)
	
	// Заголовок.
	Найденные = ВариантыОтчета.НайтиСтроки(Новый Структура("КлючВарианта", КлючТекущегоВарианта));
	Если Найденные.Количество() > 0 Тогда
		Заголовок = СтрШаблон("%1 (%2)", ОтчетНаименование, Найденные[0].Представление);
	Иначе
		Заголовок = ОтчетНаименование;
	КонецЕсли;
	
	// сохраняем выбранный вариант отчета в настройках пользователя
	Если ЗначениеЗаполнено(ДополнительныйКлючОтчета) Тогда 
		КлючОбъекта = ОтчетПолноеИмя + "/" + ДополнительныйКлючОтчета + "/КлючТекущегоВарианта";
	Иначе
		КлючОбъекта = ОтчетПолноеИмя + "/КлючТекущегоВарианта";
	КонецЕсли;		
	ОбщегоНазначения.ХранилищеСистемныхНастроекСохранить(КлючОбъекта, "", КлючТекущегоВарианта);
	
	// загрузить таблицу выводимых показателей
	ОтчетОбъект = РеквизитФормыВЗначение("Отчет");
	ТаблицаПоказателей = ОтчетОбъект.НастройкиВариантаОтчета(ОтчетСсылка, КлючТекущегоВарианта, Предопределенный); //ДополнительныйКлючОтчета, Предопределенный);
		
	ТаблицаТекущихПоказателей.Очистить();
	
	Для Каждого ТекущаяСтрока из ТаблицаПоказателей Цикл
		НоваяСтрока = ТаблицаТекущихПоказателей.Добавить();	
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущаяСтрока);
	КонецЦикла;
	
	// обновляем наименование показателя, если оно зависит от варианта отчета 
	ПредставлениеПоказателя = ОтчетОбъект.ПредставлениеПоказателя(КлючТекущегоВарианта);
	
КонецПроцедуры

&НаСервере
Процедура СохранитьПользовательскиеНастройкиНаСервере()
	ОтчетыЭффективности.СохранитьПользовательскиеНастройки(ЭтаФорма); //, ДополнительныйКлючОтчета);	
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьПользовательскиеНастройкиНаСервере()
	ОтчетыЭффективности.ЗагрузитьПользовательскиеНастройки(ЭтаФорма); //, ДополнительныйКлючОтчета);	
КонецПроцедуры

&НаСервере
Функция ЗначениеПоказателя(ТаблицаДанныхДляПоиска, СтруктураПоиска)
	
	ЗначениеПоказателя = 0;

	НайденныеСтроки = ТаблицаДанныхДляПоиска.НайтиСтроки(СтруктураПоиска);
	Если НайденныеСтроки.Количество() > 0 Тогда
		ЗначениеПоказателя = НайденныеСтроки[0].ЗначениеПоказателя;
	КонецЕсли;
	
	Возврат ЗначениеПоказателя;
	
КонецФункции

&НаСервере
Функция ФорматЯчейки(Значение, Формат)
	
	Если Формат = "Сумма" Тогда
		Возврат Формат(Значение, "ЧДЦ=2");
	ИначеЕсли Формат = "Количество" Тогда
		Возврат Формат(Значение, "ЧДЦ=0");
	Иначе
		Возврат Значение;		
	КонецЕсли;
	
КонецФункции

&НаСервере
Функция ФорматСумм(Значение)
		
	Возврат Формат(Значение, "ЧДЦ=2");
	
КонецФункции

&НаКлиенте
Процедура ОбработкаИзмененияНастроекКлиент(ВыбранноеЗначение)
	
	Если Не ЗначениеЗаполнено(ВыбранноеЗначение) Тогда
		Возврат;
	КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.УстановитьСостояниеПоляТабличногоДокумента(Элементы.ТабличныйДокумент, "НеАктуальность");
	ОбработкаИзмененияНастроекСервер(ВыбранноеЗначение);
	Сформировать();
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаИзмененияНастроекСервер(ВыбранноеЗначение)
	
	ТаблицаПоказателей = ПолучитьИзВременногоХранилища(ВыбранноеЗначение.АдресВХранилище);
	
	ТаблицаТекущихПоказателей.Очистить();
	
	Для Каждого ТекущаяСтрока из ТаблицаПоказателей Цикл
		НоваяСтрока = ТаблицаТекущихПоказателей.Добавить();	
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущаяСтрока);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ТекстЗапросаОтчета()

	ТекстЗапроса = "";
	Первый = Истина;
	
	Для каждого СтрокаПоказателя из ТаблицаТекущихПоказателей Цикл
		
		Если НЕ Первый Тогда
			ТекстЗапроса = ТекстЗапроса + "
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|";
		КонецЕсли;
		
		ТекстЗапроса = ТекстЗапроса + СтрокаПоказателя.ТекстЗапроса;
		Если Первый Тогда
			//ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ВЫБРАТЬ", "ВЫБРАТЬ РАЗРЕШЕННЫЕ");
			ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ" + Сред(ТекстЗапроса, 8);
			
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, Символы.ПС + "ИЗ", Символы.ПС + "ПОМЕСТИТЬ ВТ" + Символы.ПС + "ИЗ");
			Первый = Ложь;
		КонецЕсли;
		
	КонецЦикла;
	
	// из-за отборов сначала помещаем все во временную таблицу, а затем применяем отборы
	ТекстЗапроса = ТекстЗапроса + 
	";
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВТ.*
	|ИЗ
	|	ВТ КАК ВТ
	|ГДЕ
	|	ВЫБОР 
	|		КОГДА &ОтборПоПоказателю 
	|			ТОГДА ВТ.Исполнитель = &Показатель
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ

	|	И ВЫБОР 
	|		КОГДА &ОтборПоОрганизации 
	|			ТОГДА ВТ.Организация = &Организация
	// так как для отдельных показателей отбор по организации применяется сразу, то в итоговой таблице Организация = НЕОПРЕДЕЛЕНО
	|				ИЛИ ВТ.Организация = НЕОПРЕДЕЛЕНО
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ
	|
	|;
	|";	
	
	ОтчетОбъект = РеквизитФормыВЗначение("Отчет");
	ОтчетОбъект.ДополнитьТекстЗапросаВТ(ТекстЗапроса);
	
	Возврат ТекстЗапроса;
	
КонецФункции
	
#КонецОбласти

