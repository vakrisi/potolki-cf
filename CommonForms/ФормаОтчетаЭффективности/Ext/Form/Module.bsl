&НаКлиенте
Процедура Настройки(Команда)
			
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ОтчетИмя", ОтчетИмя);
	ПараметрыФормы.Вставить("ТаблицаВыбранныхПоказателей", ТаблицаТекущихПоказателей());
	
	//ПараметрыФормы.Вставить("ДополнительныйКлючОтчета", ДополнительныйКлючОтчета);
	
	ИмяФормыФ = ОтчетПолноеИмя + ".ФормаНастроек";
	ОткрытьФорму(ИмяФормыФ, ПараметрыФормы, ЭтаФорма, УникальныйИдентификатор);
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьВариантОтчета(Команда)
	
	ПараметрыСохранения = Новый Структура(ВариантыОтчетовКлиентСервер.СвойстваСохраненияВариантаОтчета());
	ЗаполнитьЗначенияСвойств(ПараметрыСохранения, ЭтотОбъект);
	
	//ПараметрыСохранения.ВариантОтчета = НастройкиОтчета.ВариантСсылка;
	ПараметрыСохранения.ИмяОтчета = ОтчетПолноеИмя;
	//ПараметрыСохранения.НастройкиВариантаОтчета = Отчет.КомпоновщикНастроек.Настройки;
		
	ПараметрыСохранения.Вставить("КлючОбъекта", ОтчетПолноеИмя);
	ПараметрыСохранения.Вставить("КлючТекущихНастроек", КлючТекущегоВарианта);
	//ПараметрыСохранения.Вставить("ДополнительныйКлючОтчета", ДополнительныйКлючОтчета);	
	ПараметрыСохранения.Вставить("АдресНастроек", АдресНастроек());
	
	ОписаниеОповещения = Новый ОписаниеОповещения("СохранитьВариантОтчетаЗавершение", ЭтотОбъект);
	
	ОткрытьФорму(
		"ОбщаяФорма.СохранениеВариантаОтчетаЭффективности",
		ПараметрыСохранения,
		ЭтотОбъект, ,,, ОписаниеОповещения);
		
КонецПроцедуры

&НаКлиенте
Процедура СохранитьВариантОтчетаЗавершение(Результат, ДополнительныеПараметры) Экспорт

	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	КлючТекущегоВарианта = Результат.КлючНастроек;	
	СохранитьВариантОтчетаЗавершениеСервер();
	 
КонецПроцедуры

&НаСервере
Процедура СохранитьВариантОтчетаЗавершениеСервер()

	// загружаем настройки сохраненного варианта
	ОтчетОбъект = РеквизитФормыВЗначение("Отчет");
	// получаем пользовательские варианты отчета
	//ВариантыНастроек = ОтчетОбъект.ВариантыОтчета(ОтчетСсылка, ДополнительныйКлючОтчета, Ложь);	
	ВариантыНастроек = ОтчетыЭффективности.ВариантыОтчета(ОтчетСсылка);
	Для Каждого Вариант Из ВариантыНастроек Цикл
		СтруктураВарианта = Новый Структура("КлючВарианта", Вариант.КлючВарианта);
		Найденные = ВариантыОтчета.НайтиСтроки(СтруктураВарианта);
		Если Найденные.Количество() = 0 Тогда
			ДобавитьВариантОтчета(ВариантыОтчета, Вариант, Ложь);
		КонецЕсли;
		
		Если Вариант.КлючВарианта = КлючТекущегоВарианта Тогда
			ИмяКоманды = Вариант.ИмяКоманды;
		КонецЕсли;
	КонецЦикла;
	
	ВариантыОтчета.Сортировать("Представление");
	
	ОбновитьКомандыВыбораВариантов();
	
	ЗагрузитьНастройкиВариантаОтчета(ИмяКоманды, КлючТекущегоВарианта, Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ЗагрузитьВариантОтчета(Команда)
	
	// выбор варианта отчета в меню
	Найденные = ВариантыОтчета.НайтиСтроки(Новый Структура("ИмяКоманды", Команда.Имя));
	Если Найденные.Количество() = 0 Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Вариант отчета не найден.'"));
		Возврат;
	КонецЕсли;
	
	УстановитьТекущийВариант(Найденные[0].КлючВарианта);
	
	ЗагрузитьНастройкиВариантаОтчета(Найденные[0].ИмяКоманды, КлючТекущегоВарианта, Найденные[0].Предопределенный);
	ОбщегоНазначенияКлиентСервер.УстановитьСостояниеПоляТабличногоДокумента(Элементы.ТабличныйДокумент, "НеАктуальность");	
	
КонецПроцедуры

