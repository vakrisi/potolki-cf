		Элементы.ОтборПоПоказателю.Заголовок = ПредставлениеПоказателя;
		
		Элементы.ПоказательОтчета.ОграничениеТипа = Новый ОписаниеТипов(ТипДанныхПоказателяСтрокой);	
	Иначе
		Элементы.ГруппаОтборПоПоказателю.Видимость = Ложь;
	КонецЕсли;

	//	
	Информация = ВариантыОтчетов.СформироватьИнформациюОбОтчетеПоПолномуИмени(ОтчетПолноеИмя);
	ОтчетСсылка = Информация.Отчет; // строка, если внешний 
	ЭтоВнешнийОтчет = (Информация.ТипОтчета = Перечисления.ТипыОтчетов.Внешний);
	Если ЭтоВнешнийОтчет Тогда	
		ИмяОтчетаДляЗадания = ОтчетОбъект.ИспользуемоеИмяФайла;
	КонецЕсли;
	
	// получаем варианты отчета
	ВариантыНастроек = ОтчетыЭффективности.ВариантыОтчета(ОтчетСсылка);
	Для Каждого Вариант Из ВариантыНастроек Цикл
		НоваяСтрока = ВариантыОтчета.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Вариант);
	КонецЦикла;
		
	//// получаем предопределенные варианты отчета
	//ВариантыНастроек = ОтчетОбъект.ВариантыОтчета(ОтчетСсылка, ДополнительныйКлючОтчета, Истина);	
	//Для Каждого Вариант Из ВариантыНастроек Цикл
	//	НоваяСтрока = ВариантыОтчета.Добавить();
	//	НоваяСтрока = ВариантыОтчета.Добавить();
	//	НоваяСтрока.КлючВарианта = Вариант.КлючВарианта;
	//	НоваяСтрока.ИмяКоманды = Вариант.КлючВарианта;
	//	НоваяСтрока.Представление = Вариант.Представление;
	//	НоваяСтрока.Предопределенный = Истина;
	//	НоваяСтрока.ТолькоДляАвтора = Ложь;
	//КонецЦикла;
	//
	//// получаем пользовательские варианты отчета
	//ВариантыНастроек = ОтчетОбъект.ВариантыОтчета(ОтчетСсылка, ДополнительныйКлючОтчета, Ложь);	
	//Для Каждого Вариант Из ВариантыНастроек Цикл
	//	ДобавитьВариантОтчета(ВариантыОтчета, Вариант, Ложь);
	//КонецЦикла;
	
	// при открытии из формы элемента Вариант отчета или из панели отчеты (Избранное)
	СсылкаТекущийВариант = Неопределено;
	Параметры.Свойство("Ссылка", СсылкаТекущийВариант);
	
	УстановитьКлючТекущегоВарианта(ОтчетПолноеИмя, СсылкаТекущийВариант);
	
	ВариантыОтчета.Сортировать("Представление");
	// выводим варианты в подменю		
	ОбновитьКомандыВыбораВариантов();
	
	ЗагрузитьПользовательскиеНастройкиНаСервере();
	
КонецПроцедуры

