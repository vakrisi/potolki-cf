	//КонецЕсли;
	//ПараметрыФормированияОтчета.Вставить("ИмяМетода", "СформироватьТабличныйДокумент");
	//ПараметрыФормированияОтчета.Вставить("ПараметрыВыполнения", СтруктураПараметров);
	ПараметрыФормированияОтчета.Вставить("ЭтоВнешнийОтчет", ЭтоВнешнийОтчет);
	
	ИнформацияОбОшибке = Неопределено;
	Попытка
		ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
		ПараметрыВыполнения.ЗапуститьВФоне = Истина;
		
		//ВыполняемыйМетод = "ДлительныеОперации.ВыполнитьПроцедуруМодуляОбъектаОтчета";
		ВыполняемыйМетод = "ОтчетыЭффективности.СформироватьТабличныйДокумент";
		
		РезультатФоновогоЗадания = ДлительныеОперации.ВыполнитьВФоне(
			ВыполняемыйМетод,
			ПараметрыФормированияОтчета,
			ПараметрыВыполнения);
	Исключение
		ИнформацияОбОшибке = ИнформацияОбОшибке();
	КонецПопытки;
	
	Если ИнформацияОбОшибке <> Неопределено Тогда
		ПоказатьОшибкиФормирования(ПоляПредставлениеОшибки(ИнформацияОбОшибке));
		Возврат Неопределено;
	КонецЕсли;
	
	Если РезультатФоновогоЗадания.Статус = "Выполнено" Тогда
		
		ФоновоеЗаданиеЗагрузитьРезультат(РезультатФоновогоЗадания);
		
	ИначеЕсли РезультатФоновогоЗадания.Статус = "Ошибка" Тогда
		
		ПоказатьОшибкиФормирования(РезультатФоновогоЗадания);
		
	ИначеЕсли РезультатФоновогоЗадания.Статус = "Выполняется" Тогда
		
		ОтображениеСостояния = Элементы.ТабличныйДокумент.ОтображениеСостояния;
		ОтображениеСостояния.Видимость                      = Истина;
		ОтображениеСостояния.ДополнительныйРежимОтображения = ДополнительныйРежимОтображения.Неактуальность;
		ОтображениеСостояния.Картинка                       = БиблиотекаКартинок.ДлительнаяОперация48;
		ОтображениеСостояния.Текст                          = НСтр("ru = 'Отчет формируется...'");
		
	КонецЕсли;
	
	Возврат РезультатФоновогоЗадания;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПоляПредставлениеОшибки(Знач ИнформацияОбОшибке)
	
	Результат = Новый Структура;
	КраткоеПредставлениеОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке);
	ПодробноеПредставлениеОшибки = НСтр("ru = 'Ошибка при формировании:'") + Символы.ПС + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке);
	Если ПустаяСтрока(КраткоеПредставлениеОшибки) Тогда
		КраткоеПредставлениеОшибки = ПодробноеПредставлениеОшибки;
	КонецЕсли;
	Результат.Вставить("КраткоеПредставлениеОшибки", КраткоеПредставлениеОшибки);
	Результат.Вставить("ПодробноеПредставлениеОшибки", ПодробноеПредставлениеОшибки);
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура ПоказатьОшибкиФормирования(Знач ДанныеОшибки)
	
	Если ТипЗнч(ДанныеОшибки) = Тип("Структура") Тогда
		КраткоеПредставлениеОшибки = ДанныеОшибки.КраткоеПредставлениеОшибки;
		ПодробноеПредставлениеОшибки = ДанныеОшибки.ПодробноеПредставлениеОшибки;
	Иначе
		КраткоеПредставлениеОшибки = ДанныеОшибки;
		ПодробноеПредставлениеОшибки = "";
	КонецЕсли;
	
	ОтображениеСостояния = Элементы.ТабличныйДокумент.ОтображениеСостояния;
	ОтображениеСостояния.Видимость                      = Истина;
	ОтображениеСостояния.ДополнительныйРежимОтображения = ДополнительныйРежимОтображения.Неактуальность;
	ОтображениеСостояния.Картинка                       = Новый Картинка;
	ОтображениеСостояния.Текст                          = КраткоеПредставлениеОшибки;
	
	Если ПустаяСтрока(ПодробноеПредставлениеОшибки) Тогда
		Возврат;
	КонецЕсли; 
	
КонецПроцедуры

#КонецОбласти

#Область Расшифровка

&НаКлиенте
Процедура ТабличныйДокументОбработкаРасшифровки(Элемент, Расшифровка, СтандартнаяОбработка, ДополнительныеПараметры)
	
	СтандартнаяОбработка = Ложь;
	
	// описание показателя
	Если ТипЗнч(Расшифровка) = Тип("Строка") Тогда
		 //ПоказатьЗначение(, Расшифровка);
		 ПараметрыФормы = Новый Структура;
		 ПараметрыФормы.Вставить("Заголовок", "Описание показателя");	
		 ПараметрыФормы.Вставить("Текст", Расшифровка);
		 ПараметрыФормы.Вставить("ТолькоПросмотр", Истина);
		 
		 ОткрытьФорму("ОбщаяФорма.ВводМногострочногоТекста", ПараметрыФормы, ЭтаФорма);
		 
	// 
	ИначеЕсли ТипЗнч(Расшифровка) = Тип("СправочникСсылка.Сотрудники") Тогда
		 ПоказатьЗначение(, Расшифровка);	

	// расшифровка показателя по исполнителю
	ИначеЕсли ТипЗнч(Расшифровка) = Тип("Структура") Тогда
		
		ПараметрыФормы = Новый Структура;
		//Если СтрНайти(ОтчетПолноеИмя, "ЭффективностьЗамерщиков") > 0 Тогда
		//	ЗаголовокФормыРасшифровки = НСтр("ru = 'Эффективность замерщиков: лиды'");
		//	ТекстОтборов = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Документы по замерщику: %1, за период: с %2 по %3'"),
		//		?(ЗначениеЗаполнено(Расшифровка.Исполнитель), Расшифровка.Исполнитель, НСтр("ru = '<не указан>'")),
		//		Формат(Период.ДатаНачала, "ДФ=dd.MM.yyyy"),
		//		Формат(Период.ДатаОкончания, "ДФ=dd.MM.yyyy"));
		//Иначе
			ЗаголовокФормыРасшифровки = ОтчетНаименование + " (расшифровка)";
			ТекстОтборов = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Период: с %1 по %2'"),
				Формат(Период.ДатаНачала, "ДФ=dd.MM.yyyy"),
				Формат(Период.ДатаОкончания, "ДФ=dd.MM.yyyy"));
		//КонецЕсли;
		
		ПараметрыФормы.Вставить("ЗаголовокФормы", ЗаголовокФормыРасшифровки);
		ПараметрыФормы.Вставить("ПредставлениеОтборов", Новый ФорматированнаяСтрока(ТекстОтборов, Новый Шрифт(,,Истина)));
		ПараметрыФормы.Вставить("АдресТабличногоДокумента", СформироватьРасшифровку(Расшифровка, УникальныйИдентификатор));
		
		//ИмяФормыФ = ОтчетПолноеИмя + ".Форма.ДополнительнаяРасшифровка";
		ИмяФормыФ = "ОбщаяФорма.ДополнительнаяРасшифровка";
		ОткрытьФорму(ИмяФормыФ, ПараметрыФормы, ЭтаФорма, Истина);
		
	КонецЕсли;
		
КонецПроцедуры

