
#Область ОбработчикиСобытийФормы

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)
	
	Если ПеренестиВДокумент И НЕ ЭтаФорма.ВладелецФормы = Неопределено Тогда
		АдресВХранилище = ЗаписатьПодборВХранилище(ЭтаФорма.ВладелецФормы.УникальныйИдентификатор);
	Иначе
		АдресВХранилище = Неопределено;
	КонецЕсли;
	
	Если АдресВХранилище <> Неопределено Тогда
		Структура = Новый Структура("АдресВХранилище", АдресВХранилище);
		ОповеститьОВыборе(Структура);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти 

#Область ОбработчикиЭлементовФормы

&НаКлиенте
Процедура ФактураПриАктивизацииСтроки(Элемент)
	
	ТекущиеДанные = Элементы.Фактура.ТекущиеДанные;
		
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(ЦветаФактуры,
								"Владелец", ТекущиеДанные.Ссылка,
								ВидСравненияКомпоновкиДанных.Равно,	, Истина); 
									
	//Элементы.ЦветаФактуры.Обновить();
	
КонецПроцедуры

&НаКлиенте
Процедура ЦветаФактурыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	НоваяСтрока = ВыбранныеЗначения.Добавить();
	НоваяСтрока.Фактура = Элементы.Фактура.ТекущиеДанные.Ссылка;
	НоваяСтрока.ЦветФактуры = Элементы.ЦветаФактуры.ТекущиеДанные.Ссылка;
	
КонецПроцедуры

#КонецОбласти 

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПеренестиВДокумент(Команда)
		
	ПеренестиВДокумент = Истина;
	Закрыть(КодВозвратаДиалога.OK); 
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыФункции

&НаСервере
Функция ЗаписатьПодборВХранилище(УникальныйИдентификаторВладельца) 
		
	АдресВХранилище = Неопределено;	
	Если ПеренестиВДокумент Тогда
		
		ВременнаяТаблица = ВыбранныеЗначения.Выгрузить();
		ВременнаяТаблица.Свернуть("Фактура, ЦветФактуры");
	
		АдресВХранилище = ПоместитьВоВременноеХранилище(ВременнаяТаблица, УникальныйИдентификаторВладельца);	
	КонецЕсли;
	
	Возврат АдресВХранилище;
	
КонецФункции

#КонецОбласти


