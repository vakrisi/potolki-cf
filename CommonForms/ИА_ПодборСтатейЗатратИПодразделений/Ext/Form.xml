	<Attributes>
		<Attribute name="СписокФондов" id="1">
			<Title>
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Список фондов</v8:content>
				</v8:item>
			</Title>
			<Type>
				<v8:Type>cfg:DynamicList</v8:Type>
			</Type>
			<MainAttribute>true</MainAttribute>
			<Settings xsi:type="DynamicList">
				<ManualQuery>true</ManualQuery>
				<DynamicDataRead>false</DynamicDataRead>
				<QueryText>ВЫБРАТЬ РАЗРЕШЕННЫЕ
	Фонды.Подразделение КАК Подразделение,
	Фонды.Фонд КАК Фонд,
	ЕСТЬNULL(Фонды.СуммаНалОстаток, 0) - ЕСТЬNULL(ФондыРезерв.СуммаНалОстаток, 0) КАК СуммаНал,
	ЕСТЬNULL(Фонды.СуммаБезналОстаток, 0) - ЕСТЬNULL(ФондыРезерв.СуммаБезналОстаток, 0) КАК Сумма,
	ЕСТЬNULL(Фонды.СуммаБезналОстаток, 0) КАК СуммаФонда,
	ЕСТЬNULL(ФондыРезерв.СуммаБезналОстаток, 0) КАК СуммаРезерва,
	Фонды.Организация КАК Организация,
	ФондыРезерв.ЗП.ПредметЗаказа КАК ПредметЗаказа,
	ФондыРезерв.ЗП.Сотрудник КАК Отвественный
ИЗ
	РегистрНакопления.ИА_СредстваНаФондах.Остатки(
			,
