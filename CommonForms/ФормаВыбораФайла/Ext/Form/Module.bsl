&НаКлиенте
Процедура ПолучитьСписокЛогическихДисков()
	
	ТаблицаФайлов.Очистить();
	#Если НЕ ВебКлиент Тогда	
		ИмяКомпьютера = ИмяКомпьютера(); //нна	
	#Иначе
		ИмяКомпьютера = ннаАдаптацияВебКлиента.ИмяКомпьютераСервер();	
	#КонецЕсли
	 
	ServicesSet = ПолучитьCOMОбъект("winmgmts:\\" + ИмяКомпьютера + "\root\cimv2");
	MyItems = ServicesSet.ExecQuery("Select * From Win32_LogicalDisk");// WHERE DriveType=2""");
	Для Каждого MyItem Из MyItems Цикл		
		Имя = ""; ОбщийРазмер = "";	Тип = "";  СвободноеМесто = ""; ПолныйПуть = "";		
		For Each objClassProperty In MyItem.Properties_ Цикл
			Если objClassProperty.Name = "Name" Тогда				
				Имя = Лев(objClassProperty.value,Найти(objClassProperty.value,":")-1);				
			ИначеЕсли objClassProperty.Name = "Caption" Тогда				
				ПолныйПуть = objClassProperty.value;				
			ИначеЕсли objClassProperty.Name = "Size" Тогда					
				Если objClassProperty.value = null Тогда					
					ОбщийРазмер = "";					
				Иначе						
					ОбщийРазмер = Строка(Окр(Число(objClassProperty.value)/1000000000)) + " Гб";
				КонецЕсли;					
			ИначеЕсли objClassProperty.Name = "Description" Тогда					
				Тип = objClassProperty.value;				
			ИначеЕсли objClassProperty.Name = "FreeSpace" Тогда					
				Если objClassProperty.value = null Тогда					
					СвободноеМесто = "";					
				Иначе						
					СвободноеМесто = Строка(Окр(Число(objClassProperty.value)/1000000000)) + " Гб";					
				КонецЕсли;					
			КонецЕсли;			
		КонецЦикла;
		
		НоваяСтрока = ТаблицаФайлов.Добавить();
		НоваяСтрока.Имя = "Диск "+Имя + " (Свободно:"+СвободноеМесто+")";
		НоваяСтрока.Тип = Тип;
		НоваяСтрока.Размер= ОбщийРазмер;
		НоваяСтрока.ПолноеИмя = ПолныйПуть;//+"/"; // заранее поставим чтоб переходы работали
		НоваяСтрока.Картинка=БиблиотекаКартинок.ЖесткийДиск32;
		НоваяСтрока.ЭтоПапка=Истина;	
	КонецЦикла;		

КонецПроцедуры

&НаКлиенте
Функция ПрочитатьФайл(ПолноеИмяФайла)
	
	ДвоичныеДанные = Новый ДвоичныеДанные(ПолноеИмяФайла);
	АдресВХ = ПоместитьВоВременноеХранилище(ДвоичныеДанные, Новый УникальныйИдентификатор());
	Возврат АдресВХ;
	
КонецФункции

&НаКлиенте
Функция ПолучитьСтруктуруФайла(ПолноеИмяФайла, РасширениеФайла)
	
	Потолок = Новый Структура;
		
	СтруктураФайлов = ОбменСEasyCeiling.ПолучитьСтруктуруДляЗагрузкиПриложенныхФайловПостроителя();
	ОбщегоНазначенияКлиентСервер.ДополнитьСтруктуру(Потолок, СтруктураФайлов);
	
	Потолок.Вставить("ЧертежПокупатель", 						""); 
	Потолок.Вставить("НомерРасчета", 							"");
	Потолок.Вставить("Макет",		 							""); //++ №8265
	Потолок.Вставить("Контрагент",                              "");
	
	Потолок.Вставить("Адрес",                              "");
	Потолок.Вставить("Дилер",                              );
	
	СекцияКонтрагент = Новый Структура;
	СекцияКонтрагент.Вставить("Наименование","");
	СекцияКонтрагент.Вставить("АдресМонтажа","");
	Потолок.Вставить("СекцияКонтрагент", СекцияКонтрагент);
	
	СекцияДилер = Новый Структура;
	СекцияДилер.Вставить("ПечатаемоеНазвание","");
	Потолок.Вставить("СекцияДилер", СекцияДилер);
	
	СтруктураФайла = ОбменСПостроителемКлиентСервер.ПрочитатьФайлПостроителя(ПолноеИмяФайла);
	
	Если РасширениеФайла = ".json" Тогда
		ОбщегоНазначенияКлиентСервер.ДополнитьСтруктуру(Потолок, СтруктураФайла, Истина);
		Для Каждого КлючЗначение Из СтруктураФайла Цикл				
			Если Потолок.Свойство(КлючЗначение.Ключ) Тогда
				Потолок.Вставить(КлючЗначение.Ключ, КлючЗначение.Значение);
			КонецЕсли;	
		КонецЦикла;
		
	ИначеЕсли РасширениеФайла = ".ini" Тогда
		ТекущаяСекция = "";
		Для каждого КлючЗначениеСтруктуры из СтруктураФайла Цикл
			СписокЭлементовСекцииФайла = КлючЗначениеСтруктуры.Значение;
			Если НЕ ТипЗнч(СписокЭлементовСекцииФайла) = Тип("СписокЗначений") Тогда
				Продолжить;
			КонецЕсли;
			
			Если Потолок.Свойство("Секция" + КлючЗначениеСтруктуры.Ключ) Тогда
				ТекущаяСекция = "Секция" + КлючЗначениеСтруктуры.Ключ;
			Иначе
				ТекущаяСекция = "";
			КонецЕсли;
				
			// перебор элементов списка
			Для каждого ЭлементСписка из СписокЭлементовСекцииФайла Цикл
				Если ПустаяСтрока(ЭлементСписка.Значение) Тогда
					Продолжить;
				КонецЕсли;
				
				Если ПустаяСтрока(ТекущаяСекция) Тогда
					Если Потолок.Свойство(ЭлементСписка.Значение) Тогда
						Потолок.Вставить(ЭлементСписка.Значение, ЭлементСписка.Представление);
					КонецЕсли;
				Иначе
					Если Потолок[ТекущаяСекция].Свойство(ЭлементСписка.Значение) Тогда
						Потолок[ТекущаяСекция].Вставить(ЭлементСписка.Значение, ЭлементСписка.Представление);
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
		
	КонецЕсли;
		
	Возврат Потолок;
	
КонецФункции

&НаКлиенте
Процедура ПоказатьСписокФайловКаталога(ПолныйПуть)
	
	Элементы.ДекорацияТекущийКаталог.Заголовок = ПолныйПуть;
	
	Если Не ЗначениеЗаполнено(ПолныйПуть) тогда
		ПолучитьСписокЛогическихДисков();
		Возврат;
	КонецЕсли;
	
	ТаблицаФайлов.Очистить();	
	
	// строка возврата в предыдущий каталог
	НоваяСтрока = ТаблицаФайлов.Добавить();
	НоваяСтрока.Имя = "...";
	НоваяСтрока.Размер= "Папка";
	НоваяСтрока.ПолноеИмя = ПолучитьРодителя(ПолныйПуть);
	НоваяСтрока.Картинка=БиблиотекаКартинок.Выбрать;
	НоваяСтрока.ЭтоПапка=Истина; 
	
	#Если НЕ ВебКлиент Тогда	
		МассивВсехФайлов = НайтиФайлы(ПолныйПуть,"*"); //нна	
	#Иначе
		//МассивВсехФайлов = НайтиФайлы(ПолныйПуть,"*");
		МассивВсехФайлов = Новый Массив;
	#КонецЕсли
		
	
	// нужна группировка и сортировка
	СписокКаталогов=Новый СписокЗначений;
	СписокФайлов=Новый СписокЗначений;
	
	Для каждого Файл из  МассивВсехФайлов цикл
			Попытка
				Если Файл.ЭтоКаталог() тогда
					СписокКаталогов.Добавить(Файл,Файл.Имя);
				Иначе
					СписокФайлов.Добавить(Файл,Файл.Имя);
				конецЕсли;
			Исключение
			КонецПопытки;
	КонецЦикла;
	
	СписокКаталогов.СортироватьПоПредставлению(НаправлениеСортировки.Возр);
	СписокФайлов.СортироватьПоПредставлению(НаправлениеСортировки.Возр);
	
	Для каждого Файл из  СписокФайлов цикл
		СписокКаталогов.Добавить(Файл.Значение);
	КонецЦикла;	
		
	Для каждого Файл из  СписокКаталогов цикл		
		Если НЕ Файл.Значение.ЭтоКаталог() и ПоказыватьТолькоФайлыВыгрузкиИзПостроителя и НЕ (Файл.Значение.Расширение = ".ini" Или Файл.Значение.Расширение = ".json") Тогда
			Продолжить;
		КонецЕсли;
		НоваяСтрока = ТаблицаФайлов.Добавить();
		НоваяСтрока.Имя = Файл.Значение.Имя;
		НоваяСтрока.Тип = ?(Файл.Значение.ЭтоКаталог(),"",Файл.Значение.Расширение);
		НоваяСтрока.Размер= ?(Файл.Значение.ЭтоКаталог(),"Папка",Строка(Файл.Значение.Размер()));
		НоваяСтрока.Дата = Файл.Значение.ПолучитьВремяИзменения();
		НоваяСтрока.ПолноеИмя = СтрЗаменить(Файл.Значение.ПолноеИмя,"\","/");
		Если Файл.Значение.ЭтоКаталог() Тогда
			НоваяСтрока.Картинка = БиблиотекаКартинок.Папка;
		ИначеЕсли НоваяСтрока.Тип = ".ini" Тогда
			НоваяСтрока.Картинка = БиблиотекаКартинок.Шестеренки;
		ИначеЕсли НоваяСтрока.Тип = ".json" Тогда
			НоваяСтрока.Картинка = БиблиотекаКартинок.ФорматJSON;
		ИначеЕсли НоваяСтрока.Тип = ".pdf" Тогда
			НоваяСтрока.Картинка = БиблиотекаКартинок.ФорматPDF;
		ИначеЕсли	НоваяСтрока.Тип = ".png"  
			или НоваяСтрока.Тип = ".bmp"  
			или НоваяСтрока.Тип = ".jpg"  
			или НоваяСтрока.Тип = ".jpeg"  
			Тогда
			НоваяСтрока.Картинка = БиблиотекаКартинок.ФорматPNG;
		ИначеЕсли	НоваяСтрока.Тип = ".xls"  
			или НоваяСтрока.Тип = ".xlsx"  
			Тогда
			НоваяСтрока.Картинка = БиблиотекаКартинок.ФорматExcel2007;
		ИначеЕсли	НоваяСтрока.Тип = ".doc"  
			или НоваяСтрока.Тип = ".docx"  
			Тогда
			НоваяСтрока.Картинка = БиблиотекаКартинок.ФорматWord2007;
		Иначе
			НоваяСтрока.Картинка = БиблиотекаКартинок.ФорматПустой;
		КонецЕсли;
		НоваяСтрока.ЭтоПапка=?(Файл.Значение.ЭтоКаталог(),Истина,Ложь);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте	
Функция ПолучитьРодителя(ПолныйПуть)
	
	Родитель="";
	МассивКаталогов = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ПолныйПуть,"/");
	ц=0;
	Пока ц+1<МассивКаталогов.Количество() цикл		
		Родитель=Родитель+?(Родитель="","","/")+МассивКаталогов[ц];
		ц=ц+1;
	КонецЦикла;
	
	Возврат Родитель;
	
КонецФункции

&НаКлиенте
Процедура ВыполнитьВыборФайлов()
	
	МассивФайлов = Новый Массив;
	
	ТекущиеДанные = Элементы.ТаблицаФайлов.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	// #13248 схема с пометками
	//Для каждого СтрокаТЗ из ТаблицаФайлов Цикл
	//	Если СтрокаТЗ.Выбран И СтрокаТЗ.Тип = ".ini"  тогда
	//		МассивФайлов.Добавить(СтрокаТЗ.ПолноеИмя);
	//	КонецЕсли;	
	//КонецЦикла;
	//
	//Если НЕ МассивФайлов.Количество() = 0 Тогда
	//	Закрыть(МассивФайлов);
	//КонецЕсли;	
	
	ВыбранныйФайл = ТаблицаФайлов.НайтиПоИдентификатору(ТекущиеДанные.ПолучитьИдентификатор());
	Если ВыбранныйФайл = Неопределено тогда
		Возврат;
		
	ИначеЕсли НЕ ПустаяСтрока(ВыбранныйФайл.ПолноеИмя) И НЕ ВыбранныйФайл.ЭтоПапка тогда
		
		Для НомерСтроки = 0 По Элементы.ТаблицаФайлов.ВыделенныеСтроки.Количество()-1 Цикл
			Попытка
				ВыбранныйФайл = ТаблицаФайлов.НайтиПоИдентификатору(Элементы.ТаблицаФайлов.ВыделенныеСтроки.Получить(НомерСтроки));
				
				Если ВыбранныйФайл = Неопределено Тогда
					//
				ИначеЕсли ВыбранныйФайл.Тип = ".ini" Или ВыбранныйФайл.Тип = ".json" Тогда
					МассивФайлов.Добавить(ВыбранныйФайл.ПолноеИмя);
				КонецЕсли;
			Исключение
			КонецПопытки;
			
			Если НЕ МножественныйВыбор Тогда
				Прервать;
			КонецЕсли;
			
		КонецЦикла;
		
		Закрыть(МассивФайлов);
		
	Иначе
		ПоказатьСписокФайловКаталога(ВыбранныйФайл.ПолноеИмя);
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти 

