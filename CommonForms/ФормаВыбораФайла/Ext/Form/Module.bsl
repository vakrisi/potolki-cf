&НаКлиенте
Процедура ТаблицаФайловПриАктивизацииСтроки(Элемент)
	
	Если мПредыдущийИдентификатор = Элементы.ТаблицаФайлов.ТекущиеДанные.ПолучитьИдентификатор() Тогда
		Возврат;
	Иначе
		мПредыдущийИдентификатор = Элементы.ТаблицаФайлов.ТекущиеДанные.ПолучитьИдентификатор();
	КонецЕсли;
	
	ПодключитьОбработчикОжидания("ОбработчикОжиданияТаблицаФайловПриАктивизацииСтроки", 0.1, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработчикОжиданияТаблицаФайловПриАктивизацииСтроки()
	
	Элементы.АдресМонтажа.Видимость = Ложь;
	Элементы.Контрагент.Видимость = Ложь;
	Элементы.НомерРасчета.Видимость = Ложь;
	Элементы.ВидФайлаПредпросмотраЗаказа.Видимость = Ложь;
	
	ТекущиеДанные = Элементы.ТаблицаФайлов.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ВыбранныйФайл=ТаблицаФайлов.НайтиПоИдентификатору(ТекущиеДанные.ПолучитьИдентификатор());
	Если ВыбранныйФайл=Неопределено тогда
		Возврат;
	ИначеЕсли ВыбранныйФайл.Тип = ".ini" ИЛИ ВыбранныйФайл.Тип = ".json" Тогда
		
		Потолок = Неопределено;
		Попытка
			Потолок = ПолучитьСтруктуруФайла(ВыбранныйФайл.ПолноеИмя, ВыбранныйФайл.Тип);
			
			Если НЕ Потолок = Неопределено Тогда
				ЭтаФорма.Элементы.Просмотр.Вид =   ВидПоляФормы.ПолеКартинки;
				ЭтаФорма.Элементы.Просмотр.РазмерКартинки = РазмерКартинки.АвтоРазмер;
				
				Попытка
					//Если Потолок.ЧертежПокупатель <> "" И Потолок.ЧертежПокупатель <> Неопределено Тогда
					Если Потолок[ВидФайлаПредпросмотраЗаказа] <> "" И Потолок[ВидФайлаПредпросмотраЗаказа] <> Неопределено Тогда
						АдресВХ = ПрочитатьФайл(Потолок[ВидФайлаПредпросмотраЗаказа]);
						ЭтаФорма.Просмотр = АдресВХ;
					Иначе
						ЭтаФорма.Просмотр = "";
					КонецЕсли;	
				Исключение
				КонецПопытки;
				
				Если Потолок.Свойство("Адрес") Тогда
					АдресМонтажа = Потолок.Адрес;					
				Иначе
					Попытка
						//АдресМонтажа = Потолок.Потолок_Адрес;
						АдресМонтажа = Потолок.СекцияКонтрагент.АдресМонтажа;
					Исключение
					КонецПопытки;
				КонецЕсли;
				НомерРасчета = Потолок.НомерРасчета;
				
				Если ЗначениеЗаполнено(Потолок.Контрагент) Тогда					
					Контрагент = Потолок.Контрагент;				
				ИначеЕсли Потолок.Свойство("СекцияДилер") Тогда
					Если НЕ ПустаяСтрока(Потолок.СекцияДилер.ПечатаемоеНазвание) Тогда 
						Контрагент = Потолок.СекцияДилер.ПечатаемоеНазвание;
					Иначе
						Контрагент = Потолок.СекцияКонтрагент.Наименование;
					КонецЕсли;
				КонецЕсли;				
				Если НЕ ЗначениеЗаполнено(Контрагент) И Потолок.Свойство("СекцияКонтрагент") Тогда
					Контрагент = Потолок.СекцияКонтрагент.Наименование;
				КонецЕсли;
				Если НЕ ЗначениеЗаполнено(Контрагент) И Потолок.Свойство("Дилер") И ТипЗнч(Потолок.Дилер) = Тип("Структура") Тогда
					Контрагент = Потолок.Дилер.Наименование;
				КонецЕсли;
				
				Элементы.АдресМонтажа.Видимость = Истина;
				Элементы.Контрагент.Видимость = Истина;
				Элементы.НомерРасчета.Видимость = Истина;
				Элементы.ВидФайлаПредпросмотраЗаказа.Видимость = Истина;
				
			КонецЕсли;
		Исключение
			
			ЭтаФорма.Элементы.Просмотр.Вид =   ВидПоляФормы.ПолеТекстовогоДокумента;
			ЭтаФорма.Просмотр = ОписаниеОшибки();
			
		КонецПопытки;
		
	ИначеЕсли ВыбранныйФайл.Тип = ".pdf"  тогда
		
		ЭтаФорма.Элементы.Просмотр.Вид =   ВидПоляФормы.ПолеHTMLДокумента;
		ЭтаФорма.Просмотр = ВыбранныйФайл.ПолноеИмя;

	ИначеЕсли ВыбранныйФайл.Тип = ".txt"  тогда
		//файл выгрузки из построителя. попробуем в нем найти путь к файлу чертежа
		ЭтаФорма.Элементы.Просмотр.Вид =   ВидПоляФормы.ПолеТекстовогоДокумента;
		ТекстовыйФайл = Новый ТекстовыйДокумент;
		ТекстовыйФайл.Прочитать(ВыбранныйФайл.ПолноеИмя);
		ЭтаФорма.Просмотр = ТекстовыйФайл.ПолучитьТекст();
		
	ИначеЕсли ВыбранныйФайл.Тип = ".png"  
		или ВыбранныйФайл.Тип = ".bmp"  
		или ВыбранныйФайл.Тип = ".jpg"  
		или ВыбранныйФайл.Тип = ".jpeg"  
		тогда
		
		ЭтаФорма.Элементы.Просмотр.Вид =   ВидПоляФормы.ПолеКартинки;
		ЭтаФорма.Элементы.Просмотр.РазмерКартинки = РазмерКартинки.АвтоРазмер;
		АдресВХ= ПрочитатьФайл(ВыбранныйФайл.ПолноеИмя);
		ЭтаФорма.Просмотр = АдресВХ;
		
	Иначе
		
		ЭтаФорма.Элементы.Просмотр.Вид =   ВидПоляФормы.ПолеТекстовогоДокумента;
		ЭтаФорма.Просмотр = "";
		
	КонецЕсли;
	
КонецПроцедуры

