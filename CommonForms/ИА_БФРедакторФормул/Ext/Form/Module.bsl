&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
    ДанныеФормулы = ИА_БФКС.РедакторФормул_СформироватьПустуюФормулу();
    Если Параметры.Свойство("ДанныеФормулы") Тогда
        ЗаполнитьЗначенияСвойств(ДанныеФормулы, Параметры.ДанныеФормулы);
    КонецЕсли; 
    
    РежимРаботы = ДанныеФормулы.Вид;
    // 15.04.2015 ИА_ Аврамов (1) ToDo: Перечисления.ИА_БФФормулыТип обработать разные режимы работы: строки, число и т.п.
    
    Параметры.Свойство("Уникальность", Уникальность);
    
    ИсходныеДанныеФормулы = ДанныеФормулы;
    
    ДЗ = ИА_БФС.ДЗФ2ДЗ(ДанныеФормулы.Переменные);
    ЗначениеВРеквизитФормы(ДЗ, "Переменные");
    
    ТЗ = ИА_БФС.ТЗФ2ТЗ(ДанныеФормулы.СоставФормулы);
    ТабФормула.Загрузить(ТЗ);
    СкомпоноватьФормулу();
    УстановитьВидимостьДоступность();
КонецПроцедуры

&НаКлиенте
Процедура ТабФормулаПеретаскивание(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка, Строка, Поле)
    Если Строка = Неопределено Тогда
        Индекс = -1;
    Иначе
        Индекс = ТабФормула.Индекс(ТабФормула.НайтиПоИдентификатору(Строка)) + 1;
    КонецЕсли; 
    
    ПараметрыПеретаскивания.Действие = ДействиеПеретаскивания.Копирование;
    СтандартнаяОбработка = Ложь;
    
    Для каждого Эл Из ПараметрыПеретаскивания.Значение Цикл
        Если НЕ ИА_БФКС.РеквизитЕсть(Эл, "Вид") Тогда
            Продолжить;
        КонецЕсли; 
        ДобавитьЭлементВФормулу(Эл, Индекс);
    КонецЦикла; 
    СкомпоноватьФормулу();
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьЭлементВФормулу(СтрокаПеременной, Индекс)
    Если СтрокаПеременной.Вид = 0 Тогда
        Если Индекс < 0 Тогда
            НовСтрока = ТабФормула.Добавить();	
        Иначе
            НовСтрока = ТабФормула.Вставить(Индекс);
        КонецЕсли; 
        
        ЗаполнитьЗначенияСвойств(НовСтрока, СтрокаПеременной);
        НовСтрока.Данные         = "<" + НовСтрока.Представление + ">";
        НовСтрока.Представление  = НовСтрока.Данные;
    КонецЕсли;
КонецПроцедуры


&НаКлиенте
Процедура ДобавитьСтроку(Команда)
    стр = "";
    ПоказатьВводСтроки(Новый ОписаниеОповещения("ДобавитьСтрокуЗавершение", ЭтотОбъект, Новый Структура("стр", стр)), стр, "Введите строку:"); 
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьСтрокуЗавершение(Строка, ДополнительныеПараметры) Экспорт
	
	стр = ?(Строка = Неопределено, ДополнительныеПараметры.стр, Строка);
	
	
	Если (Строка <> Неопределено) Тогда
		ДобавитьЭлемент(Стр, Стр, 2);
	КонецЕсли;

КонецПроцедуры

