&НаКлиенте
Процедура ОК(Команда)
    Отказ = Ложь;
    Данные = Новый Структура("ДанныеФормулы, Вид, Уникальность"
    , СобратьДанныеДляВозврата(Отказ)
    , "РедакторФормул"
    , Уникальность);
    Если НЕ Отказ Тогда
        ОповеститьОВыборе(Данные);
    КонецЕсли; 
КонецПроцедуры

&НаКлиенте
Процедура ТабФормулаПриИзменении(Элемент)
    СкомпоноватьФормулу();
КонецПроцедуры

&НаКлиенте
Процедура ПеременныеПередРазворачиванием(Элемент, Строка, Отказ)
    ПеременныеПередРазворачиваниемНаСервере(Строка);
КонецПроцедуры

&НаСервере
Процедура ПеременныеПередРазворачиваниемНаСервере(Строка)
    ТекСтрока = Переменные.НайтиПоИдентификатору(Строка);
    Если ТекСтрока <> Неопределено Тогда
        Ветки = ТекСтрока.ПолучитьЭлементы();        
        Если Ветки.Количество() = 1 И Ветки[0].Представление="стаб" Тогда
            Ветки.Очистить();
            ТабТипов = ПолучитьТипыНаСервере(ТекСтрока.ОписаниеТипа);
            
            
            ТолькоОдинТип = ТабТипов.Количество() = 1;
            
            Если ТолькоОдинТип Тогда
                ДостроитьДерево(Ветки
                , ТабТипов[0].ИмяДляЗапроса
                , ТекСтрока.ПутьДанных
                , ТабТипов[0].МенеджерМД
                , ТабТипов[0].ИмяМД);
            Иначе
                Для каждого СтрТипа Из ТабТипов Цикл
                    Если ЗначениеЗаполнено(СтрТипа.ИмяДляЗапроса) Тогда
                        НовВеткаТипа = Ветки.Добавить();
                        НовВеткаТипа.Представление = СтрТипа.ИмяДляЗапроса;
                        Ветки2 = НовВеткаТипа.ПолучитьЭлементы();
                        
                        ДостроитьДерево(Ветки2
                        , СтрТипа.ИмяДляЗапроса
                        , ТекСтрока.ПутьДанных
                        , СтрТипа.МенеджерМД
                        , СтрТипа.ИмяМД);
                    КонецЕсли; 
                КонецЦикла; 
            КонецЕсли; 
            
            
            Эл = ТекСтрока.ПутьДанных;
        КонецЕсли; 
    КонецЕсли;
    
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьТипыНаСервере(ОписаниеТипа)
    ТабТипов = ИА_БФС.Типы_ОписаниеТипов2ТаблицаСтроковыхТипов(ОписаниеТипа);
    ТабТипов = ИА_БФС.ТЗ2ТЗФ(ТабТипов);
    Возврат ТабТипов;
КонецФункции

//&НаКлиенте
&НаСервере
Процедура ДостроитьДерево(Ветки, ИмяДляЗапроса, ПутьДо, МенеджерМД, ИмяМД)
    
    ТабРеквизиты = ИА_БФС.Запрос_ВыполнитьВТЗ("ВЫБРАТЬ ТаблицаВсехРеквизитов.* ИЗ " + ИмяДляЗапроса + " как ТаблицаВсехРеквизитов ГДЕ ЛОЖЬ");
    Для каждого Стр Из ТабРеквизиты.Колонки Цикл
        Таб  = ИА_БФС.Типы_ОписаниеТипов2ТаблицаСтроковыхТипов(Стр.ТипЗначения);
        ЭтоСсылочныйТип = ИА_БФС.ТЗ_ФильтрПоОтбору(Таб, Новый Структура("Ссылочный", Истина)).Количество() > 0;
        ЭтоТЗ           = ИА_БФС.ТЗ_ФильтрПоОтбору(Таб, Новый Структура("Имя", "ТаблицаЗначений")).Количество() > 0;
        Если ЭтоТЗ Тогда
            Продолжить;
        КонецЕсли; 
        
        ПредставлениеРеквизита = ДостроитьДеревоПолучитьДанныхМД(ИмяМД, МенеджерМД, Стр);
        
        
        
        НовВетка = Ветки.Добавить();
        НовВетка.Представление = ПредставлениеРеквизита;
        НовВетка.ПутьДанных    = ПутьДо + "." + Стр.Имя;
        НовВетка.ОписаниеТипа  = Стр.ТипЗначения;
        
        Если ЭтоСсылочныйТип Тогда
            ВеткаСтаб = НовВетка.ПолучитьЭлементы().Добавить();
            ВеткаСтаб.Представление = "стаб";
        КонецЕсли; 
        
    КонецЦикла;
    
КонецПроцедуры

&НаСервереБезКонтекста
Функция ДостроитьДеревоПолучитьДанныхМД(ИмяМД, МенеджерМД, Стр)
    ПредставлениеРеквизита = Стр.Имя;
    Попытка
        Реквизит = Метаданные[МенеджерМД][ИмяМД].Реквизиты.Найти(Стр.Имя);
        Если Реквизит <> Неопределено Тогда
            ПредставлениеРеквизита  = Реквизит.Синоним;
        КонецЕсли; 
    Исключение
        ТекстОшибки = ОписаниеОшибки();
    КонецПопытки;
    Возврат ПредставлениеРеквизита;
    
КонецФункции

