//_____________________________________________________________
// Вид:
// 0 - Элементы дерева переменных
// 1 - Нельзя выбрать в формулу, используется для группировки
// 2 - строковые выражения, к-е можно редактировать
// 3 - строковые константы

&НаСервере
Процедура СкомпоноватьФормулу()
    Если РежимРаботы = Перечисления.ИА_БФФормулыТип.ОдноЗначение Тогда
        Пока ТабФормула.Количество() > 1 Цикл
            ТабФормула.Удалить(0);
        КонецЦикла; 
    КонецЕсли; 
    
    Текст = "";
    Для каждого Стр Из ТабФормула Цикл
        ЭтоОперация = Истина; // 13.04.2015 ИА_ Аврамов (1) ToDo:  
        ПредставлениеЭлемента = Стр.Данные;
        Текст = Текст + ПредставлениеЭлемента;
    КонецЦикла; 
    ПредставлениеФормулы = Текст;
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьЭлемент(Представление, Данные, Вид = 2)
    НС = ТабФормула.Добавить();
    НС.Представление = Представление;
    НС.Данные = Данные;
    НС.Вид = Вид;
    
    СкомпоноватьФормулу();
КонецПроцедуры

&НаСервере
Функция СобратьДанныеДляВозврата(Отказ)
    СкомпоноватьФормулу();
    
    Контекст = ИА_БФКС.РедакторФормул_СформироватьПустуюФормулу();
    Контекст.Вид                   = ИсходныеДанныеФормулы.Вид;
    Контекст.Переменные            = ИА_БФС.ДЗ2ДЗФ(РеквизитФормыВЗначение("Переменные"));
    Контекст.СоставФормулы         = ИА_БФС.ТЗ2ТЗФ(ТабФормула.Выгрузить());
    Контекст.ПредставлениеФормулы  = ПредставлениеФормулы;
    Контекст.ОбработкаПроверкиФормулы = ИсходныеДанныеФормулы.ОбработкаПроверкиФормулы;
    
    Если ЗначениеЗаполнено(Контекст.ОбработкаПроверкиФормулы) Тогда
        Попытка
            ФормулаВерна = Вычислить(Контекст.ОбработкаПроверкиФормулы);
        Исключение
            ФормулаВерна = Ложь;
            ТекстОшибки = ОписаниеОшибки();
            ИА_БФКС.СообщениеОбОшибке("Ошибка проверки формулы: " + ТекстОшибки, Отказ); 
        КонецПопытки; 
        Отказ = НЕ ФормулаВерна;
    КонецЕсли; 
    
    Возврат Контекст;
КонецФункции

&НаСервере
Процедура УстановитьВидимостьДоступность()
    Элементы.ОперацииСтрока.Видимость = РежимРаботы = Перечисления.ИА_БФФормулыТип.Строка;
КонецПроцедуры

