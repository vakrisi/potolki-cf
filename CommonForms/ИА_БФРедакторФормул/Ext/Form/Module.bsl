&НаКлиенте
Процедура ТабФормулаПередНачаломИзменения(Элемент, Отказ)
    ТекСтрока = Элементы.ТабФормула.ТекущиеДанные;
    Если ТекСтрока <> Неопределено Тогда
        Отказ = ТекСтрока.Вид = 0 ИЛИ ТекСтрока.Вид = 1 ИЛИ ТекСтрока.Вид = 3;
    КонецЕсли; 
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьПереводСтроки(Команда)
    ДобавитьЭлемент("<<Перевод строки>>", Символы.ПС, 3);
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьПробел(Команда)
    ДобавитьЭлемент("<<Пробел>>", " ", 3);
КонецПроцедуры

&НаКлиенте
Процедура ПеременныеВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
    ТекСтрока = Элемент.ТекущиеДанные;
    Если ТекСтрока <> Неопределено Тогда
        СтандартнаяОбработка = Ложь;
        ДобавитьЭлементВФормулу(ТекСтрока, -1);
        СкомпоноватьФормулу();
    КонецЕсли; 
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьВсеДанные(Команда)
    Элементы.ТабФормулаПутьДанных.Видимость = Истина;
    Элементы.ПеременныеПутьДанных.Видимость = Истина;
КонецПроцедуры

&НаКлиенте
Процедура ТабФормулаПредставлениеПриИзменении(Элемент)
    ТекСтрока = Элементы.ТабФормула.ТекущиеДанные;
    Если ТекСтрока <> Неопределено Тогда
        Если ТекСтрока.Вид = 2 Тогда
            ТекСтрока.Данные = ТекСтрока.Представление;
        КонецЕсли; 
    КонецЕсли; 
КонецПроцедуры
