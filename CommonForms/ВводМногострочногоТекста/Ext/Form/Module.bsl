
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Заголовок = Параметры.Заголовок;
	Если Параметры.Свойство("ЗаголовокТекста") Тогда
		Элементы.Текст.Заголовок = Параметры.ЗаголовокТекста;
	Иначе
		Элементы.Текст.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Нет;
	КонецЕсли;
	
	Если Параметры.Свойство("ТолькоПросмотр") И Параметры.ТолькоПросмотр = Истина Тогда // может быть Неопределено
		Элементы.Текст.ТолькоПросмотр = Истина;
		Элементы.ФормаОтмена.Видимость = Ложь;
	КонецЕсли;
	
	Если Параметры.Свойство("Текст") Тогда
		Текст = Параметры.Текст;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаОК(Команда)
	
	Закрыть(Текст);
	
КонецПроцедуры

