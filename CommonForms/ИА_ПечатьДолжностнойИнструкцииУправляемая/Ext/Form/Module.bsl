&НаКлиенте
Процедура ПолеHTMLПриНажатии(Элемент, ДанныеСобытия, СтандартнаяОбработка)
	эл = ИА_ОбщиеПроцедуры_Технология.ИА_ПолучитьСсылкуOnClickПоляHTML(
		Неопределено, 
		Новый Структура("srcElement,returnValue",ДанныеСобытия.Element,Неопределено));
