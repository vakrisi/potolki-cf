КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьДанныеПодписанта(Инструкция)
	// возращает структуру ФИО, Подпись, Должность
	Результат = Новый Структура("ФИО, Подпись, Должность");

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ИА_ПодписиСотрудников.Должность,
		|	ИА_ПодписиСотрудников.ФИО,
		|	ИА_ПодписиСотрудников.Подпись
		|ИЗ
		|	РегистрСведений.ИА_ПодписиСотрудников КАК ИА_ПодписиСотрудников
		|ГДЕ
		|	ИА_ПодписиСотрудников.Сотрудник = &Сотрудник";

	Запрос.УстановитьПараметр("Сотрудник", Инструкция.Подписант);

	ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();

	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Результат.ФИО = ВыборкаДетальныеЗаписи.ФИО;
		Результат.Должность = ВыборкаДетальныеЗаписи.Должность;
		Результат.Подпись = Base64Строка(ВыборкаДетальныеЗаписи.Подпись.Получить());
	Иначе
		Сообщить("Не найдены параметры подписи подписанта.")
		
	КонецЕсли;
	
	Возврат  Результат;
 	
КонецФункции

