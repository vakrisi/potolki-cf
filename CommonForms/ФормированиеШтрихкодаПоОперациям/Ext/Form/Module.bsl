
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Параметры.Свойство("Сотрудник",   Сотрудник);
	Параметры.Свойство("РежимПечати", РежимПечати);	

	//Элементы.ПроизводственнаяОперация.Видимость = (РежимПечати = 3);
	//Элементы.ОперацияНадДокументами.Видимость = (РежимПечати = 4);
	Если РежимПечати = 3 Тогда
		Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.ГруппаПроизводственнаяОперация;

	//#14908 закомментировано
	//ИначеЕсли РежимПечати = 4 Тогда
	//	Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.ГруппаОперацияНадДокументами;
	//	ОперацияНадДокументами = Справочники.ОперацииНадДокументами.СборкаЗаказаПокупателя;
		
	ИначеЕсли РежимПечати = 50 Тогда
		Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.ГруппаРабочееМесто;
		ДействиеРМ = "Кнопка по умолчанию";
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	
	Если РежимПечати = 3 Тогда
		ПроверяемыеРеквизиты.Удалить(ПроверяемыеРеквизиты.Найти("ОперацияНадДокументами"));
		ПроверяемыеРеквизиты.Удалить(ПроверяемыеРеквизиты.Найти("ДействиеРМ"));
	ИначеЕсли РежимПечати = 4 Тогда
		ПроверяемыеРеквизиты.Удалить(ПроверяемыеРеквизиты.Найти("ПроизводственнаяОперация"));
		ПроверяемыеРеквизиты.Удалить(ПроверяемыеРеквизиты.Найти("ДействиеРМ"));
	ИначеЕсли РежимПечати = 50 Тогда
		ПроверяемыеРеквизиты.Удалить(ПроверяемыеРеквизиты.Найти("ПроизводственнаяОперация"));
		ПроверяемыеРеквизиты.Удалить(ПроверяемыеРеквизиты.Найти("ОперацияНадДокументами"));
		ПроверяемыеРеквизиты.Удалить(ПроверяемыеРеквизиты.Найти("Сотрудник"));
	КонецЕсли;

КонецПроцедуры

