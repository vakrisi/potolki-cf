&НаКлиенте
Процедура ПрисвоитьШК(Команда)
	
	Если НЕ ПроверитьЗаполнение() Тогда		
		Возврат;
	КонецЕсли;
	
	//ПараметрыШК = ПараметрыШК();
	Если РежимПечати = 3 Тогда
		ПараметрыШК = ШтрихкодированиеПотолкиКлиент.ПараметрыШК(3, Сотрудник, ПроизводственнаяОперация);
	ИначеЕсли РежимПечати = 4 Тогда
		ПараметрыШК = ШтрихкодированиеПотолкиКлиент.ПараметрыШК(4, Сотрудник, ОперацияНадДокументами);
	ИначеЕсли РежимПечати = 50 Тогда
		ПараметрыШК = ШтрихкодированиеПотолкиКлиент.ПараметрыШК(50, , ДействиеРМ);
	КонецЕсли;
	ОбщийМодульКлиент.ОткрытьФормуПечатиШК(ПараметрыШК.ЗначениеКода, , ПараметрыШК.Заголовок);
	
КонецПроцедуры





