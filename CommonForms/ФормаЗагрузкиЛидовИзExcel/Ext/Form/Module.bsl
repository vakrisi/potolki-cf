
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ПравилоПоискаИсторииОбращений = Константы.ПравилоПоискаИсторииОбращений.Получить().Получить();
	Если ПравилоПоискаИсторииОбращений = Неопределено Тогда
		ПравилоПоискаИсторииОбращений = Новый Структура("ПоТелефону, ПоАдресуЭлектроннойПочты", Ложь, Ложь);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПрочитатьФайл(Команда)
	
	Отказ = Ложь;
	Если НомерКолонкиИмяКлиента = 0 Тогда 
		Сообщить("Колонка ""Имя клиента"" обязательная, необходимо задать её номер");
		Отказ = Истина;
	КонецЕсли;
	Если НомерКолонкиОсновнойТелефон = 0 Тогда 
		Сообщить("Колонка ""Основной телефон"" обязательная, необходимо задать её номер");
		Отказ = Истина;
	КонецЕсли;
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;

	ТабЗнач.Очистить();
	
	Попытка
		ExcelПриложение = Новый COMОбъект("Excel.Application");
	Исключение
		Сообщить("Ошибка работы с Excel." + Символы.ПС + ОписаниеОшибки(), СтатусСообщения.Внимание);
		Возврат;
	КонецПопытки;
	Попытка
		Файл = ExcelПриложение.WorkBooks.Open(ПутьКФайлу);
	Исключение
		Сообщить("Ошибка открытия файла." + Символы.ПС + ОписаниеОшибки(), СтатусСообщения.Внимание);
		Возврат;
	КонецПопытки;
	
	Попытка
		Лист = Файл.Sheets(1);
		xlCellTypeLastCell = 11;
		ПоследняяСтрока = Лист.Cells.SpecialCells(xlCellTypeLastCell).Row;
	Исключение
		Сообщить("Ошибка открытия листа №1." + Символы.ПС + ОписаниеОшибки(), СтатусСообщения.Внимание);
		ExcelПриложение.Quit();
		Возврат;
	КонецПопытки;
	
	МассивОповещенийНеНайдено = новый Массив;
	
	Для Строка = НачСтр По ПоследняяСтрока Цикл
		Попытка
			ОсновнойТелефон = СокрЛП(Лист.Cells(Строка, НомерКолонкиОсновнойТелефон).Text);
			Если ЗначениеЗаполнено(ОсновнойТелефон) Тогда 
				Стр = ТабЗнач.Добавить();
				Стр.ОсновнойТелефон = СофтФон.ПолучитьНомерТелефонаВМеждународномФОрматеПользователя(ОсновнойТелефон);
				Стр.ИмяКлиента = СокрЛП(Лист.Cells(Строка, НомерКолонкиИмяКлиента).Text);
				Если НомерКолонкиДополнительныйТелефон <> 0 Тогда					
					Стр.ДополнительныйТелефон = СофтФон.ПолучитьНомерТелефонаВМеждународномФОрматеПользователя(СокрЛП(Лист.Cells(Строка, НомерКолонкиДополнительныйТелефон).Text));
				КонецЕсли;
				Если НомерКолонкиЭлектроннаяПочта <> 0 Тогда
					Стр.ЭлектроннаяПочта = СокрЛП(Лист.Cells(Строка, НомерКолонкиЭлектроннаяПочта).Text);
				КонецЕсли;
				Если НомерКолонкиВидКонтакта <> 0 Тогда
					ВидКонтакта = СокрЛП(Лист.Cells(Строка, НомерКолонкиВидКонтакта).Text);
					Если ЗначениеЗаполнено(ВидКонтакта) Тогда
						Стр.ВидКонтакта = НайтиВидКонтакта(ВидКонтакта, МассивОповещенийНеНайдено);
					КонецЕсли;	
				КонецЕсли;
				Если НомерКолонкиРекламнаяАкция <> 0 Тогда
					РекламнаяАкция = СокрЛП(Лист.Cells(Строка, НомерКолонкиРекламнаяАкция).Text);					
					Если ЗначениеЗаполнено(РекламнаяАкция) Тогда
						Стр.РекламнаяАкция = НайтиРекламнуюАкцию(РекламнаяАкция, МассивОповещенийНеНайдено);
					КонецЕсли;	
				КонецЕсли;
				Если НомерКолонкиТочкаПродаж <> 0 Тогда
					ТочкаПродаж = СокрЛП(Лист.Cells(Строка, НомерКолонкиТочкаПродаж).Text);
					Если ЗначениеЗаполнено(ТочкаПродаж) Тогда
						Стр.ТочкаПродаж = НайтиТочкуПродаж(ТочкаПродаж, МассивОповещенийНеНайдено);
					КонецЕсли;
				КонецЕсли;
				Если НомерКолонкиРекламныйИсточник <> 0 Тогда
					РекламныйИсточник = СокрЛП(Лист.Cells(Строка, НомерКолонкиРекламныйИсточник).Text);
					Если ЗначениеЗаполнено(РекламныйИсточник) Тогда
						Стр.РекламныйИсточник = НайтиРекламныйИсточник(РекламныйИсточник, МассивОповещенийНеНайдено);
					КонецЕсли;
				КонецЕсли;
				
				Если НомерКолонкиГород <> 0 Тогда
					Город = СокрЛП(Лист.Cells(Строка, НомерКолонкиГород).Text);
					Если ЗначениеЗаполнено(Город) Тогда
						Стр.Город = НайтиГород(Город, МассивОповещенийНеНайдено);
					КонецЕсли;
				КонецЕсли;
				Если НомерКолонкиАдрес <> 0 Тогда
					Стр.Адрес = СокрЛП(Лист.Cells(Строка, НомерКолонкиАдрес).Text);
				КонецЕсли;

				Если НомерКолонкиАвтор <> 0 Тогда
					Автор = СокрЛП(Лист.Cells(Строка, НомерКолонкиАвтор).Text);
					Если ЗначениеЗаполнено(Автор) Тогда
						Стр.Автор = НайтиПользователя(Автор);
					КонецЕсли;
				КонецЕсли;
				Если НомерКолонкиПримечание <> 0 Тогда
					Стр.Примечание = СокрЛП(Лист.Cells(Строка, НомерКолонкиПримечание).Text);
				КонецЕсли;
				Если НомерКолонкиЗаписьВИсторию <> 0 Тогда
					Стр.ЗаписьВИсторию = СокрЛП(Лист.Cells(Строка, НомерКолонкиЗаписьВИсторию).Text);
				КонецЕсли;
				Стр.Пометка = Истина;
			конецесли;
		Исключение
			Сообщить("Ошибка чтения строки файла." + Строка + Символы.ПС + ОписаниеОшибки(), СтатусСообщения.Внимание);
		КонецПопытки;
	КонецЦикла;
	ExcelПриложение.Quit();
	
	//Оповещаем о не найденных элементах
	МассивПовтояющихсяОповещений = новый Массив;
	Для Каждого Оповещение Из МассивОповещенийНеНайдено Цикл
		Если МассивПовтояющихсяОповещений.Найти(Оповещение) = Неопределено Тогда
			Сообщить(Оповещение);
			МассивПовтояющихсяОповещений.Добавить(Оповещение);
		КонецЕсли;
	КонецЦикла;
	
	НайтиСуществующихЛидов();
	
	ПоказатьОповещениеПользователя ("Чтение файла завершено");
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция НайтиВидКонтакта(Наименование, МассивОповещенийНеНайдено)
	ОбъектКВозврату = Справочники.ВидыКонтактов.НайтиПоНаименованию(Наименование);
	Если ОбъектКВозврату.Пустая() Тогда
		МассивОповещенийНеНайдено.Добавить("Не найден вид контакта с наименованием " + Наименование);
	КонецЕсли;
	Возврат ОбъектКВозврату;
КонецФункции

