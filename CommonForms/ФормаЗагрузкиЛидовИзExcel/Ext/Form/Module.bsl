&НаКлиенте
Процедура ПутьКФайлуНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	Режим = РежимДиалогаВыбораФайла.Открытие;
	ДиалогОткрытияФайла = Новый ДиалогВыбораФайла(Режим);
	ДиалогОткрытияФайла.ПолноеИмяФайла = "";
	Фильтр =  "Файлы Excel|*.xls;*.xlsx";
	ДиалогОткрытияФайла.Фильтр = Фильтр;
	ДиалогОткрытияФайла.МножественныйВыбор = Ложь;
	ДиалогОткрытияФайла.Заголовок = "Выберите файл Excel";
	ДиалогОткрытияФайла.Выбрать();
	ПутьКФайлу = ДиалогОткрытияФайла.ПолноеИмяФайла;
КонецПроцедуры

&НаСервере
Процедура НайтиСуществующихЛидов()
	
	Для Каждого ТекущаяСтрока Из ТабЗнач Цикл
		ПолучитьДублирующиеЛиды(ТекущаяСтрока);		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ПолучитьДублирующиеЛиды(ТекущаяСтрока)
	
	Если НЕ ЗначениеЗаполнено(ТекущаяСтрока.ОсновнойТелефон) 
		И НЕ ЗначениеЗаполнено(ТекущаяСтрока.ДополнительныйТелефон) 
		И НЕ ЗначениеЗаполнено(ТекущаяСтрока.ЭлектроннаяПочта) Тогда
		Возврат;
	КонецЕсли;
	
	ТелефоныКлиента = Новый Массив;
	Если ЗначениеЗаполнено(ТекущаяСтрока.ОсновнойТелефон) Тогда
		ТелефоныКлиента.Добавить(ТекущаяСтрока.ОсновнойТелефон);	
	КонецЕсли;
	Если ЗначениеЗаполнено(ТекущаяСтрока.ДополнительныйТелефон) Тогда
		ТелефоныКлиента.Добавить(ТекущаяСтрока.ДополнительныйТелефон);	
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ПоискПоТелефону", ПравилоПоискаИсторииОбращений.ПоТелефону);
	Запрос.УстановитьПараметр("ПоискПоПочте", ПравилоПоискаИсторииОбращений.ПоАдресуЭлектроннойПочты);
	Запрос.УстановитьПараметр("ТелефоныКлиента", ТелефоныКлиента);
	Запрос.УстановитьПараметр("ЭлектроннаяПочтаКлиента", ТекущаяСтрока.ЭлектроннаяПочта);	

	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	Лид.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.Лид КАК Лид
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Лид.ДополнительнаяКонтактнаяИнформация КАК ЛидКИ
	|		ПО (ЛидКИ.Ссылка = Лид.Ссылка)
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаказДоговор КАК ЗаказДоговор
	|		ПО Лид.Ссылка = ЗаказДоговор.Основание
	|			И (ЗаказДоговор.ТекущийСтатус = ЗНАЧЕНИЕ(Справочник.СтатусыЗаказДоговоров.Выполнен))
	|ГДЕ
	|	(ВЫБОР
	|				КОГДА &ПоискПоТелефону
	|					ТОГДА ЛидКИ.Представление В (&ТелефоныКлиента)
	|							И ЛидКИ.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Телефон)
	|				ИНАЧЕ ЛОЖЬ
	|			КОНЕЦ
	|			ИЛИ ВЫБОР
	|				КОГДА &ПоискПоПочте
	|					ТОГДА НЕ &ЭлектроннаяПочтаКлиента ПОДОБНО """"
	|							И ЛидКИ.Представление ПОДОБНО &ЭлектроннаяПочтаКлиента
	|							И ЛидКИ.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.АдресЭлектроннойПочты)
	|				ИНАЧЕ ЛОЖЬ
	|			КОНЕЦ)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Лид.Дата";
		
	Результат = Запрос.Выполнить();
	
	ТекущаяСтрока.ДублирующийЛид.ЗагрузитьЗначения(Результат.Выгрузить().ВыгрузитьКолонку("Ссылка"));
	ТекущаяСтрока.ЕстьДубли = (ТекущаяСтрока.ДублирующийЛид.Количество() > 0);
	ТекущаяСтрока.Пометка = НЕ ТекущаяСтрока.ЕстьДубли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьЛиды(Команда)
	ЗагрузитьЛидыНаСервере();	
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьЛидыНаСервере()	
	
	Для Каждого ТекущаяСтрока Из ТабЗнач Цикл
		Если НЕ ТекущаяСтрока.Пометка Тогда
			Продолжить;
		КонецЕсли;
		
		//#14718 сначала заполняем структуру , потом объект согласно порядку
		СтруктураПолей = ОбщийМодульСервер.СтруктураПолейЛидаПриАвтоматическомСоздании();
	
		ДокументОбъект = Документы.Лид.СоздатьДокумент();
		ДокументОбъект.Заполнить(Неопределено);
		ДокументОбъект.СпособСоздания = Перечисления.СпособыСозданияЛида.ЗагруженИзExcel; //#8090
		ДокументОбъект.Дата = ТекущаяДатаСеанса();		
		ДокументОбъект.ТекущийСтатус = Справочники.СтатусыЛида.НазначитьЗамер;
		
		//Поля из таблицы		
		//ДокументОбъект.ВидКонтакта 		 = ТекущаяСтрока.ВидКонтакта;
		//ДокументОбъект.РекламнаяАкция 	 = ТекущаяСтрока.РекламнаяАкция;
		//ДокументОбъект.ТочкаПродаж 		 = ТекущаяСтрока.ТочкаПродаж;
		//ДокументОбъект.РекламныйИсточник = ТекущаяСтрока.РекламныйИсточник;		
		//ДокументОбъект.ОсновнойТелефонКлиента = СофтФон.ПолучитьНомерТелефонаВМеждународномФОрматеПользователя(ТекущаяСтрока.ОсновнойТелефон);
		//ДокументОбъект.ИмяКлиента = ТекущаяСтрока.ИмяКлиента;
		СтруктураПолей.ВидКонтакта 		 = ТекущаяСтрока.ВидКонтакта;
		СтруктураПолей.РекламнаяАкция 	 = ТекущаяСтрока.РекламнаяАкция;
		СтруктураПолей.ТочкаПродаж 		 = ТекущаяСтрока.ТочкаПродаж;
		СтруктураПолей.РекламныйИсточник = ТекущаяСтрока.РекламныйИсточник;		
		СтруктураПолей.ТелефонКлиента 	 = СофтФон.ПолучитьНомерТелефонаВМеждународномФОрматеПользователя(ТекущаяСтрока.ОсновнойТелефон);
		СтруктураПолей.ИмяКлиента = ТекущаяСтрока.ИмяКлиента;
		
		ОбщийМодульСервер.ЗаполнитьПоляЛидаПриАвтоматическомСоздании(ДокументОбъект, СтруктураПолей);
		
		Если НомерКолонкиДополнительныйТелефон <> 0 И ЗначениеЗаполнено(ТекущаяСтрока.ДополнительныйТелефон) Тогда
			ДополнительныйТелефонКлиента = СофтФон.ПолучитьНомерТелефонаВМеждународномФОрматеПользователя(ТекущаяСтрока.ДополнительныйТелефон);
			УправлениеКонтактнойИнформациейПотолки.ЗаписатьКонтактнуюИнформацию(ДокументОбъект, ДополнительныйТелефонКлиента, 
			 																	 Справочники.ВидыКонтактнойИнформации.ТелефонКонтрагента, 
																				 Перечисления.ТипыКонтактнойИнформации.Телефон, Новый УникальныйИдентификатор);
		КонецЕсли;
		Если НомерКолонкиЭлектроннаяПочта <> 0 И ЗначениеЗаполнено(ТекущаяСтрока.ЭлектроннаяПочта) Тогда
			УправлениеКонтактнойИнформациейПотолки.ЗаписатьКонтактнуюИнформацию(ДокументОбъект, ТекущаяСтрока.ЭлектроннаяПочта, 
			 															    Справочники.ВидыКонтактнойИнформации.EmailКонтрагента, 
																			Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты, Новый УникальныйИдентификатор);
		КонецЕсли;		
		ДокументОбъект.Комментарий 		 = "#Создан обработкой загрузки Лидов#" + " " + ТекущаяСтрока.Примечание;	
			
		ДокументОбъект.Город 			 = ТекущаяСтрока.Город;
		ДокументОбъект.Адрес 			 = ТекущаяСтрока.Адрес;
		ДокументОбъект.Автор 	 		 = ТекущаяСтрока.Автор;	
		
		Попытка
			ДокументОбъект.Записать();			
			
			Комментарий = "Создан Лид обработкой загрузки Лидов ";
			РегистрыСведений.ИсторияЛида.ДобавитьЗаписьВИсториюЛида(ДокументОбъект.Ссылка, ТекущаяДатаСеанса(), ДокументОбъект.Автор, Новый УникальныйИдентификатор, Комментарий);
			
			//Запись в историю из таблицы, если поле заполнено
			Если ЗначениеЗаполнено(ТекущаяСтрока.ЗаписьВИсторию) Тогда
				РегистрыСведений.ИсторияЛида.ДобавитьЗаписьВИсториюЛида(ДокументОбъект.Ссылка, ТекущаяДатаСеанса(), ДокументОбъект.Автор, Новый УникальныйИдентификатор, ТекущаяСтрока.ЗаписьВИсторию);
			КонецЕсли;
			
			Сообщить("Создан " + ДокументОбъект.Ссылка + " по основному номеру телефона " + ТекущаяСтрока.ОсновнойТелефон);
			ОбщийМодуль.УстановитьНеобходимостьОбновленияАРМРозницы();			
		Исключение
			Сообщить("Не удалось записать Лид с основным номером телефона " +  ТекущаяСтрока.ОсновнойТелефон);
		КонецПопытки;
		
	КонецЦикла;
	
	НайтиСуществующихЛидов();
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьПометки(Команда)
	Для Каждого ТекущаяСтрока Из ТабЗнач Цикл
		ТекущаяСтрока.Пометка = Истина;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура СнятьПометки(Команда)
	Для Каждого ТекущаяСтрока Из ТабЗнач Цикл
		ТекущаяСтрока.Пометка = Ложь;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьДублирующиеЛиды(Команда)
	
	ТекущиеДанные = Элементы.ТабЗнач.ТекущиеДанные;
	
	Если ТекущиеДанные <> Неопределено И ТекущиеДанные.ДублирующийЛид.Количество() > 0 Тогда
		ПараметрыФормы = ПолучитьНастройкиОткрытияСписка(ТекущиеДанные.ДублирующийЛид);
		ОткрытьФорму("Документ.Лид.ФормаСписка", новый Структура("ФиксированныеНастройки", ПараметрыФормы), ЭтотОбъект);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьНастройкиОткрытияСписка(СписокДокументов)

	КомпоновщикНастроек = Новый КомпоновщикНастроекКомпоновкиДанных;	

	Элт = КомпоновщикНастроек.ФиксированныеНастройки.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Элт.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Ссылка");
	Элт.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке;
	Элт.Использование = Истина;
	Элт.ПравоеЗначение = СписокДокументов;

	Возврат КомпоновщикНастроек.ФиксированныеНастройки

КонецФункции

&НаКлиенте
Процедура ПоказатьТолькоСДублями(Команда)
	Элементы.ТабЗнач.ОтборСтрок = новый ФиксированнаяСтруктура(новый Структура("ЕстьДубли", Истина));	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьБезДублей(Команда)
	Элементы.ТабЗнач.ОтборСтрок = новый ФиксированнаяСтруктура(новый Структура("ЕстьДубли", Ложь));
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьВсе(Команда)
	Элементы.ТабЗнач.ОтборСтрок = Неопределено;
КонецПроцедуры


