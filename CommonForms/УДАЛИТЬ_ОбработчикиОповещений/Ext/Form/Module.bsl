&НаСервере
Функция УведомлятьОПросроченныхЛидах()
	Возврат ПараметрыСеанса.УведомлятьОПросроченныхЛидах;
КонецФункции

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если УведомлятьОПросроченныхЛидах() Тогда
		ПодключитьОбработчикОжидания("ПроверкаПросроченныхЛидов",600, Ложь);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверкаПросроченныхЛидов()
	ПолучитьПросроченныеЛиды();
	КоличествоПросроченных = МассивПросроченныхЛидов.Количество();
	Если КоличествоПросроченных > 0 Тогда 
		ПараметрыНовойФормы = Новый Структура;
		ПараметрыНовойФормы.Вставить("КоличествоПросроченных", 0);
		ПараметрыНовойФормы.Вставить("СписокПросроченных", МассивПросроченныхЛидов);
		ОткрытьФорму("Обработка.РабочееМестоМенеджераРозничныхПродаж.Форма.ФормаПредупреждениеОПросроченныхЛидах",ПараметрыНовойФормы, ЭтаФорма, Ложь);
	КонецЕсли;
КонецПроцедуры

