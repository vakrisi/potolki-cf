&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ДоступностьПОПолнымПравам();
КонецПроцедуры

&НаКлиенте
Процедура ДоступностьПОПолнымПравам()
	Элементы.УтверждениеТБ.Доступность = не ФП_ПолныеПрава;
	Элементы.УтверждениеФП.Доступность = не ФП_ПолныеПрава;
	Элементы.РСФ.Доступность = не ФП_ПолныеПрава;
	Элементы.ВыплатаНапрямуюСФондов.Доступность = не ФП_ПолныеПрава;
	Элементы.ФП_ОтправкаНаРассмотрениеЗаказаНаФП.Доступность = не ФП_ПолныеПрава;
	Элементы.ФП_УтверждениеЗаказовРуководителем.Доступность = не ФП_ПолныеПрава;
КонецПроцедуры

&НаКлиенте
Процедура ФП_ПолныеПраваПриИзменении(Элемент)
	ДоступностьПОПолнымПравам();
КонецПроцедуры
