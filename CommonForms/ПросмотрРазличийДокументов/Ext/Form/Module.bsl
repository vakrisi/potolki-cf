&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	//СброситьРазмерыИПоложениеОкна
	ИмяПользователя = ПользователиИнформационнойБазы.ТекущийПользователь().Имя;
	УстановитьПривилегированныйРежим(Истина);
	ХранилищеСистемныхНастроек.Удалить("ОбщаяФорма.ПросмотрРазличийДокументов/Такси/НастройкиОкна", "", "");
	УстановитьПривилегированныйРежим(Ложь);
	КлючСохраненияПоложенияОкна = Строка(Новый УникальныйИдентификатор);

	Параметры.Свойство("ТекстСообщения", Элементы.ДекорацияТекстСообщения.Заголовок);
	
	СкрыватьКнопки = Ложь;
	Параметры.Свойство("ТолькоПросмотр", СкрыватьКнопки);
	
	Если НЕ СкрыватьКнопки Тогда
		Если Параметры.Свойство("ЕстьВыпуск") И Параметры.Свойство("ДоступноИзменениеПриНаличииВыпуска") Тогда
			Если Параметры.ЕстьВыпуск И НЕ Параметры.ДоступноИзменениеПриНаличииВыпуска Тогда
				СкрыватьКнопки = Истина;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Элементы.КомандаДа.Видимость = НЕ СкрыватьКнопки;
	Элементы.КомандаНет.Заголовок = ?(НЕ СкрыватьКнопки, "Нет", "Закрыть");
	
	Если Параметры.ВидДокумента = "Монтаж" Тогда
		СформироватьМакетРазличийПоМонтажу(Параметры.МассивДокумента1, Параметры.МассивДокумента2, Параметры.Документ1, Параметры.Документ2);
	Иначе
		
		//++ №14311 показываем различия сразу по нескольким документам (используется из Заказа покупателя)
		Если Параметры.Свойство("МассивДокументов") Тогда
			
			Для Каждого ТекущийДокумент Из Параметры.МассивДокументов Цикл
				СформироватьМакетРазличий(ТекущийДокумент.МассивСравнения, ТекущийДокумент.ЗаказПокупателя, ТекущийДокумент.ЗаказНаПроизводство, ТекущийДокумент.МассивРазличийРеквизитов);
			КонецЦикла;
			
		Иначе
		//-- №14311
		
			//++ №13466
			//СформироватьМакетРазличий(Параметры.МассивДокумента1, Параметры.МассивДокумента2, Параметры.Документ1, Параметры.Документ2, Параметры.МассивРазличийРеквизитов);
			СформироватьМакетРазличий(Параметры.МассивСравнения, Параметры.Документ1, Параметры.Документ2, Параметры.МассивРазличийРеквизитов);
			//-- №13466
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаНет(Команда)
	Закрыть();
КонецПроцедуры

&НаКлиенте
Процедура КомандаДа(Команда)
	Закрыть(Истина);
КонецПроцедуры

&НаКлиенте
Процедура КомандаПодробно(Команда)
	
	Элементы.КомандаПодробно.Пометка  = НЕ Элементы.КомандаПодробно.Пометка;
	Элементы.ГруппаПодробно.Видимость = Элементы.КомандаПодробно.Пометка;
	
КонецПроцедуры

