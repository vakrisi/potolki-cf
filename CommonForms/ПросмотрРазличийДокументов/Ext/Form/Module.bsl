			Иначе
				ОбластьСтрокаРеквизитов.Параметры.Реквизит = "" + ДанныеРеквизита.Реквизит1 + "/" + ДанныеРеквизита.Реквизит2;
			КонецЕсли;
			ОбластьСтрокаРеквизитов.Параметры.ЗначениеРеквизита1 = ДанныеРеквизита.Значение1;
			ОбластьСтрокаРеквизитов.Параметры.ЗначениеРеквизита2 = ДанныеРеквизита.Значение2;
