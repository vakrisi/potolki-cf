&НаСервере
Процедура РазукраситьСтроки(ОбластьМакета, БезПроверки = Ложь)
	
	ВысотаТаблицы = ОбластьМакета.ВысотаТаблицы;
	ЦветОшибки = WebЦвета.ЛососьСветлый;
	
	Если БезПроверки Тогда
		Ячейка = ОбластьМакета.Область(ВысотаТаблицы-1, 1, ВысотаТаблицы, ОбластьМакета.ШиринаТаблицы);
		//Ячейка = ОбластьМакета.Область(1, 2);
		Ячейка.ЦветФона = ЦветОшибки;
		
		//Для НомерСтолбца = 3 По ОбластьМакета.ШиринаТаблицы Цикл
		//	Ячейка1 = ОбластьМакета.Область(ВысотаТаблицы-1, НомерСтолбца);
		//	Ячейка2 = ОбластьМакета.Область(ВысотаТаблицы, НомерСтолбца);
		//				
		//		Ячейка1.ЦветФона = ЦветОшибки;
		//		Ячейка2.ЦветФона = ЦветОшибки;
		//	
		//	
		//КонецЦикла;
	Иначе
		
		Для НомерСтолбца = 3 По ОбластьМакета.ШиринаТаблицы Цикл
			Ячейка1 = ОбластьМакета.Область(ВысотаТаблицы-1, НомерСтолбца);
			Ячейка2 = ОбластьМакета.Область(ВысотаТаблицы, НомерСтолбца);
			
			Если Ячейка1.СодержитЗначение Тогда
				ЗначениеЯчейки1 = Ячейка1.Значение;
			Иначе
				ЗначениеЯчейки1 = Ячейка1.Текст;
			КонецЕсли;
			
			Если Ячейка2.СодержитЗначение Тогда
				ЗначениеЯчейки2 = Ячейка2.Значение;
			Иначе
				ЗначениеЯчейки2 = Ячейка2.Текст;
			КонецЕсли;
			
			Если ЗначениеЯчейки1 <> ЗначениеЯчейки2 Тогда
				Ячейка1.ЦветФона = ЦветОшибки;
				Ячейка2.ЦветФона = ЦветОшибки;
			КонецЕсли;
			
		КонецЦикла;		
	КонецЕсли;
	
КонецПроцедуры

//Различия Монтаж - Заказ-договор
&НаСервере
Процедура СформироватьМакетРазличийПоМонтажу(МассивДокумента1, МассивДокумента2, Документ1, Документ2)
	
	// при сравнении ЗП и ЗНП : 1 - ЗП, 2 - ЗНП
	
	//развернем массивы в таблицу значений
	ТаблицаДокумента1 = ОбщийМодуль.ПустаяТаблицаДляСравненияЗаказов();	
	ТаблицаДокумента2 = ОбщийМодуль.ПустаяТаблицаДляСравненияЗаказов();
	Для Каждого ЭлементМассива Из МассивДокумента1 Цикл
	 	НоваяСтрока = ТаблицаДокумента1.Добавить();
        Для Каждого ЗначениеСтруктуры Из ЭлементМассива Цикл
            НоваяСтрока[ЗначениеСтруктуры.Ключ] = ЗначениеСтруктуры.Значение;
		КонецЦикла;
	КонецЦикла;
	Для Каждого ЭлементМассива Из МассивДокумента2 Цикл
	 	НоваяСтрока = ТаблицаДокумента2.Добавить();
        Для Каждого ЗначениеСтруктуры Из ЭлементМассива Цикл
            НоваяСтрока[ЗначениеСтруктуры.Ключ] = ЗначениеСтруктуры.Значение;
		КонецЦикла;
	КонецЦикла;
	Для каждого КолонкаТЗ из ТаблицаДокумента2.Колонки Цикл
		КолонкаТЗ.Имя = КолонкаТЗ.Имя + "1";
	КонецЦикла;
	
	//в заказе покупателя у услуг и товаров УИСтроки свой - уникальный, а в Заказе на производство он равен УИСтроки продукции
	//заменим УИСтроки товара или услуги в заказе покупателя на УИСтрокиРодителя, чтобы соответствовать заказу на производство
	Для Каждого ТекущаяСтрока Из ТаблицаДокумента1 Цикл
		ТекущаяСтрока.УИСтроки = ТекущаяСтрока.УИСтрокиРодителя;		
	КонецЦикла;
	
	//возможна такая ситуация, то во второй таблице (ЗНП) вовсе нет продукции, услуг или материалов
	//поэтому вывод секций присоединением будет кривой
	//дозаполим отсутствующие строки в ЗНП заглушками
	//продукция	
	ОтборПоГруппировке1 = Новый Структура("Назначение", "Продукция");
	СтрокиПродукцияЗП  = ТаблицаДокумента1.НайтиСтроки(ОтборПоГруппировке1);
	Для чНом=0 По СтрокиПродукцияЗП.Количество()-1 Цикл
		ОтборПоГруппировке2 = Новый Структура("Назначение1, Номенклатура1", "Продукция",СтрокиПродукцияЗП[чНом].Номенклатура);
		Если ТаблицаДокумента2.НайтиСтроки(ОтборПоГруппировке2).Количество()=0 Тогда
			//не нашли во второй таблице - добавляем
			НоваяСтрока = ТаблицаДокумента2.Добавить();
			НоваяСтрока.Номенклатура1 = СтрокиПродукцияЗП[чНом].Номенклатура;
			НоваяСтрока.Назначение1 = "Продукция";
			НоваяСтрока.УИСтроки1 = СтрокиПродукцияЗП[чНом].УИСтроки;
		КонецЕсли;
	КонецЦикла;
	//услуги	
	ОтборПоГруппировке1 = Новый Структура("Назначение", "Услуги");
	СтрокиПродукцияЗП  = ТаблицаДокумента1.НайтиСтроки(ОтборПоГруппировке1);
	Для чНом=0 По СтрокиПродукцияЗП.Количество()-1 Цикл
		ОтборПоГруппировке2 = Новый Структура("Назначение1, Номенклатура1", "Услуги",СтрокиПродукцияЗП[чНом].Номенклатура);
		Если ТаблицаДокумента2.НайтиСтроки(ОтборПоГруппировке2).Количество()=0 Тогда
			//не нашли во второй таблице - добавляем
			НоваяСтрока = ТаблицаДокумента2.Добавить();
			НоваяСтрока.Номенклатура1 = СтрокиПродукцияЗП[чНом].Номенклатура;
			НоваяСтрока.Назначение1 = "Услуги";
			НоваяСтрока.УИСтроки1 = СтрокиПродукцияЗП[чНом].УИСтроки;
		КонецЕсли;
	КонецЦикла;
	//Материалы	
	ОтборПоГруппировке1 = Новый Структура("Назначение", "Материалы");
	СтрокиПродукцияЗП  = ТаблицаДокумента1.НайтиСтроки(ОтборПоГруппировке1);
	Для чНом=0 По СтрокиПродукцияЗП.Количество()-1 Цикл
		ОтборПоГруппировке2 = Новый Структура("Назначение1, Номенклатура1", "Материалы",СтрокиПродукцияЗП[чНом].Номенклатура);
		Если ТаблицаДокумента2.НайтиСтроки(ОтборПоГруппировке2).Количество()=0 Тогда
			//не нашли во второй таблице - добавляем
			НоваяСтрока = ТаблицаДокумента2.Добавить();
			НоваяСтрока.Номенклатура1 = СтрокиПродукцияЗП[чНом].Номенклатура;
			НоваяСтрока.Назначение1 = "Материалы";
			НоваяСтрока.УИСтроки1 = СтрокиПродукцияЗП[чНом].УИСтроки;
		КонецЕсли;
	КонецЦикла;
	
	
	Макет = ПолучитьОбщийМакет("ПросмотрРазличийДокументов");
	
	ОбластьЗаголовокДокумент 	= Макет.ПолучитьОбласть("Заголовок");
	ОбластьШапкаТаблицы 		= Макет.ПолучитьОбласть("ШапкаТаблицы");
	ОбластьСтрокаГруппировка 	= Макет.ПолучитьОбласть("СтрокаГруппировка");
	//ОбластьСтрокаДокумента		= Макет.ПолучитьОбласть("СтрокаДокумента");
	ОбластьПустаяСтрока			= Макет.ПолучитьОбласть("ПустаяСтрока");
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	
	//ОбластьЗаголовокДокумент.Параметры.Документ = Документ1;
	//ТабличныйДокумент.Вывести(ОбластьЗаголовокДокумент);
	//ТабличныйДокумент.Вывести(ОбластьШапкаТаблицы);
	//
	//Для каждого ЭлементМассива из МассивРазличийДокумента1 Цикл
	//	ОбластьСтрокаДокумента.Параметры.Заполнить(ЭлементМассива);
	//	ТабличныйДокумент.Вывести(ОбластьСтрокаДокумента);
	//КонецЦикла;
	//
	//ТабличныйДокумент.Вывести(ОбластьПустаяСтрока);
	//
	//ОбластьЗаголовокДокумент.Параметры.Документ = Документ2;
	//ТабличныйДокумент.Вывести(ОбластьЗаголовокДокумент);
	//ТабличныйДокумент.Вывести(ОбластьШапкаТаблицы);
	//Для каждого ЭлементМассива из МассивРазличийДокумента2 Цикл
	//	ОбластьСтрокаДокумента.Параметры.Заполнить(ЭлементМассива);
	//	ТабличныйДокумент.Вывести(ОбластьСтрокаДокумента);
	//КонецЦикла;
	
	ОбластьЗаголовокДокумент.Параметры.Документ1 = Документ1;
	ОбластьЗаголовокДокумент.Параметры.Документ2 = Документ2;
	ТабличныйДокумент.Вывести(ОбластьЗаголовокДокумент);
		
	ТабличныйДокумент.Вывести(ОбластьШапкаТаблицы);	
	
	//сравнение по продукции
	ОтборПоГруппировке = Новый Структура("Назначение", "Продукция");
	ОтборПоГруппировке1 = Новый Структура("Назначение1", "Продукция");
