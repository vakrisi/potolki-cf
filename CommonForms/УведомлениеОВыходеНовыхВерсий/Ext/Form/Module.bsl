&НаСервере
Процедура СфорироватьТабличныйДокуент()
	
	Макет = ПолучитьОбщийМакет("УведомлениеОВыходеНовойВерсии");
	Таб = Новый ТабличныйДокумент;	
	//ТаблицаДанных.Сортировать("ДатаВыхода Убыв");
	
	Для Каждого ТекСтрока Из ТаблицаДанных Цикл
		Если НЕ ТекСтрока.НеПоказывать Тогда
			ОбластьМакета = Макет.ПолучитьОбласть("Версия");
			ОбластьМакета.Параметры.НомерВерсии = ТекСтрока.НомерВерсии;
			ОбластьМакета.Параметры.ДатаВыхода = Формат(ТекСтрока.ДатаВыхода,"ДЛФ=Д");
			ОбластьМакета.Параметры.Описание = СтрЗаменить(ТекСтрока.Описание,"<br/>",Символы.ПС);
			Таб.Вывести(ОбластьМакета);
		КонецЕсли;
	КонецЦикла;
	
	Результат.Очистить();
	Результат.Вывести(Таб);
	
КонецПроцедуры

&НаСервере
Процедура ПриЗакрытииНаСервере()
	
	Если НеПоказывать Тогда
		Для Каждого ТекЗапись Из ТаблицаДанных Цикл
			МенеджерЗаписи = РегистрыСведений.УведомлениеОВыходеНовыхВерсий.СоздатьМенеджерЗаписи();
			
			МенеджерЗаписи.Версия = ТекЗапись.НомерВерсии;
			МенеджерЗаписи.Пользователь = Пользователи.ТекущийПользователь();
			МенеджерЗаписи.НеПоказывать = НеПоказывать;
			МенеджерЗаписи.Описание = ТекЗапись.Описание;
			МенеджерЗаписи.ДатаВыхода = ТекЗапись. ДатаВыхода;
			
			МенеджерЗаписи.Записать();
		КонецЦикла;
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)
	Если ЗавершениеРаботы Тогда
		Возврат;
	КонецЕсли;
	
	ПриЗакрытииНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ОтправитьЗаявкуНаОбновление(Команда)
	
	Парам = Новый Структура;
	Парам.Вставить("ТекстЗапроса","Прошу обновить нашу конфигурацию до самой последней версии");
	ОткрытьФорму("ОбщаяФорма.ФормаОтправкиЗапроса", Парам,,,,,Новый ОписаниеОповещения("ПослеОтправкиЗапроса",ЭтаФорма),РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеОтправкиЗапроса(Успешно) Экспорт
	
	Если Успешно Тогда
		НеПоказывать = Истина;
		Закрыть();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	РезультатПроверки = ОбщийМодуль.ОпределитьМассивПеременныхСеанса();
	Если РезультатПроверки.Лицензия и НЕ РезультатПроверки.Поддержка  Тогда
		Если РезультатПроверки.Коробка = 0 Тогда
				//коробка
				Элементы.ИнформационныйТекстНетПоддержки.Заголовок = "ВНИМАНИЕ! У Вас завершился срок действия договора сопровождения!
					|
					|При отсутствии действующего договора сопровождения не доступны:
					|* обновления программы
