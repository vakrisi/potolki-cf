&НаКлиенте
Перем мРасписание;

&НаКлиенте
Перем РасписаниеОповещений;

&НаКлиенте
Процедура Оргсхема_ЗаполнитьПоУмолчанию(Команда)
	НаборКонстант.ИА_ВысотаПодписиВБлокеСекцияИСотрудник = 10;
	НаборКонстант.РасстояниеМеждуБлокамиГоризонтальное = 2;
	НаборКонстант.РасстояниеМеждуБлокамиВертикальное = 8;
	НаборКонстант.РасстояниеМеждуСекциями = 0;
	НаборКонстант.ПоднятиеСекции = 3;
	ПолеШрифт = Новый Шрифт("Times New Roman",10 , истина, Истина);
	
	Если НаборКонстант.КСУ_ВидОргсхемы = ПредопределенноеЗначение("Перечисление.КСУ_ВидОргсхемы.EM") Тогда
		НаборКонстант.ИА_ВариантыОформленияДепартаментов = ПредопределенноеЗначение("Перечисление.ИА_ВариантыОформленияДепартаментов.Отдельно");
	Иначе
		НаборКонстант.ИА_ВариантыОформленияДепартаментов = ПредопределенноеЗначение("Перечисление.ИА_ВариантыОформленияДепартаментов.СлитноСОтделами");
	КонецЕсли;
	 
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	#ЕСЛИ ВебКлиент ТОГДА
		Элементы.РасширениеРаботыСФайлами.Видимость = истина;
		ПодключитьРасширениеРаботыСФайлами();
	#КОНЕЦЕСЛИ
	
	Если ЕстьПравоАдминистрирование Тогда
		
		мРасписание = ПолучитьРасписание();
		
		Если  мРасписание<> Неопределено Тогда
			УстановитьТекстНадписиРегламентнойНастройки();
			Авторасчет = ПолучитьАвторасчет();
		КонецЕсли;   	
		
		РасписаниеОповещений = ПолучитьРасписаниеОповещений();
		Если РасписаниеОповещений <> Неопределено Тогда
			ИспользоватьОповещения = ПолучитьИспользованиеОповещений();
		КонецЕсли;
	КонецЕсли;
	
	ВидимостьЭлементовНастройкиЗаполненияРеквизитов();
	ОбновитьДоступностьДоходыПоПодр();
	ВидимостьНастроекДИ();
	
	ЗаблокироватьПоля(Неопределено);
КонецПроцедуры

&НаСервере
Функция ПолучитьРасписаниеОповещений()
	Попытка
		рез = РегламентныеЗадания.НайтиПредопределенное(Метаданные.РегламентныеЗадания.ИА_ОповещениеОНезаполненныхСтатистиках);
		рез = рез.Расписание;
	Исключение
		Рез = Неопределено;
	КонецПопытки;	
	
	Возврат Рез;
КонецФункции

&НаСервере
Функция ПолучитьИспользованиеОповещений()
	Попытка
		рез = РегламентныеЗадания.НайтиПредопределенное(Метаданные.РегламентныеЗадания.ИА_ОповещениеОНезаполненныхСтатистиках);
		рез = рез.Использование;
	Исключение
		Рез = Ложь;
	КонецПопытки;	
	
	Возврат Рез;

КонецФункции



&НаКлиенте
Процедура УстановитьТекстНадписиРегламентнойНастройки()
	
	Перем ТекстЗаголовка, ТекстРасписания, РасписаниеАктивно;
	
	ПолучитьТекстЗаголовкаИРасписанияРегламентнойНастройки(Авторасчет, мРасписание, ТекстЗаголовка, ТекстРасписания, РасписаниеАктивно);
	Элементы.НадписьРасписаниеРегламентногоЗаданияНастройки.Заголовок = ТекстРасписания;
    	
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	текШрифт = Константы.ИА_ШрифтПодписиСотрудника.Получить().Получить();
	
	Если текШрифт <> Неопределено Тогда
		ПолеШрифт = Новый Шрифт(текШрифт);
	КонецЕсли;
	
	// Версия КСУ
	Макет = ПолучитьОбщийМакет("КСУ_ВерсияРелиза");
	НомерРелиза = Макет.ПолучитьСтроку(1);
	ЭтаФорма.Заголовок = "Настройки КСУ (релиз "+НомерРелиза+")";
    
    Если НЕ ИА_БФКС.РеквизитЕсть(Метаданные.БизнесПроцессы, "ИА_БПНоситель") Тогда
    	Элементы.ГруппаНФ.Видимость = Ложь;
    КонецЕсли; 
	
	ПолучитьНастройкиЗаполненияРеквизитовНаСервере();
	//Элементы.ИА_ФП_ИспользоватьВидДССправочно.Доступность = Не НаборКонстант.ИА_ФП_РазделятьНалИБезнал; 

	ЕстьПравоАдминистрирование = ПравоДоступа("Администрирование", Метаданные);
	
	// логотип
	уид1 = новый УникальныйИдентификатор;
	Попытка
		логоДанные = Константы.ИА_ЛоготипКомпании.Получить();
		Если ЗначениеЗаполнено(логоДанные) Тогда
			дд = логоДанные.Получить();
			АдресКартинкиЛоготип = ПоместитьВоВременноеХранилище(дд,уид1);
		КонецЕсли;
	Исключение
	КонецПопытки;

	//ИА_КСУОбщийСервер.СделатьКнопкуОсновной(Элементы.ГруппаКП);
	
	Элементы.ИА_ВариантыОформленияДепартаментов.Доступность = НаборКонстант.КСУ_ВидОргсхемы <> Перечисления.КСУ_ВидОргсхемы.EM;
	
	Попытка
		а = Константы.КСУ_ДатаПоследнегоОбмена1с_Веб.Получить();
	Исключение
		Элементы.НастройкиВебСистемы.Видимость = ложь;
	КонецПопытки;
	
	ЕстьПодразделения = Ложь;
	Если Метаданные.Справочники.Найти("Подразделения")<> Неопределено тогда
		ЕстьПодразделения = Истина;
	ИначеЕсли Метаданные.Справочники.Найти("СтруктурныеЕдиницы")<> Неопределено тогда
		ЕстьПодразделения = Истина;
	ИначеЕсли Метаданные.Справочники.Найти("СтруктураПредприятия")<> Неопределено тогда
		ЕстьПодразделения = Истина;
	КонецЕсли;
	ЕстьДДС = Ложь;
	Если Метаданные.Справочники.Найти("СтатьиДвиженияДенежныхСредств") <> Неопределено Тогда
		ЕстьДДС = Истина;
	КонецЕсли;
	
	Элементы.КСУ_СинхронизацияСтатейИПодразделений.Видимость = ЕстьПодразделения И ЕстьДДС;
	Элементы.ГруппаСинхр.Видимость = ЕстьПодразделения И ЕстьДДС;
	
	Если НЕ ИА_Защита_Общий.ЛицензияДоступна("НФ",,истина) Тогда 
		Элементы.Группа_НФ.Доступность = ложь;
	КонецЕсли;
	
	Если Параметры.Свойство("Страница") Тогда
		Элементы.ГруппаГлавная.ТекущаяСтраница = Элементы[Параметры.Страница];
	КонецЕсли;
КонецПроцедуры

