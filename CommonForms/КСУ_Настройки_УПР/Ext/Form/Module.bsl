&НаКлиенте
Процедура ЗаполнитьНастройкиЗаполненияРеквизитовПоШаблону(Конф)
	
	Если Конф ="КА" Тогда
		
		ИмяРеквизитаВалютаУПР       = "ВалютаРегламентированногоУчета";
		ИмяРеквизитаВалютаДокумента = "ВалютаДокумента";
		
		ИмяРеквизитаРасшифровкаПлатежаСумма    = "СуммаПлатежа";
		ПересчитатьСуммуНДСВРасшифровкеПлатежа = Истина;
		
        НаборКонстант.ИА_ПроизводственныйКалендарьИмяРегистра   = "РегламентированныйПроизводственныйКалендарь";
        НаборКонстант.ИА_ПроизводственныйКалендарьИзмерениеДата = "ДатаКалендаря";
		
		ТипРегистраДенежныеСредства    = "РегистрНакопления";
		
		КоличествоРегистровДенежныеСредства    = 1;
		ИмяРегистраДенежныеСредства ="ДенежныеСредства";
		
		ИмяИзмеренияТипДенежныхСредств = "ВидДенежныхСредств";
		ИмяПеречисленияТипДенежныхСредств = "ВидыДенежныхСредств";
		ИмяРесурсаСуммаУпр = "СуммаУпр";
		
	ИначеЕсли Конф ="БП" Тогда
		
		ИмяРеквизитаВалютаУПР       = "ВалютаРегламентированногоУчета";
		ИмяРеквизитаВалютаДокумента = "ВалютаДокумента";
		
		ИмяРеквизитаРасшифровкаПлатежаСумма    = "СуммаПлатежа";
		ПересчитатьСуммуНДСВРасшифровкеПлатежа = Истина;
		
        НаборКонстант.ИА_ПроизводственныйКалендарьИмяРегистра   = "ДанныеПроизводственногоКалендаря";
        НаборКонстант.ИА_ПроизводственныйКалендарьИзмерениеДата = "Дата";
		
		ТипРегистраДенежныеСредства    = "РегистрБухгалтерии";
		
		ИмяРегистраБухгалтерии    = "Хозрасчетный";
	
	ИначеЕсли Конф ="УТ" Тогда

		ИмяРеквизитаВалютаУПР       = "ВалютаРегламентированногоУчета";
		ИмяРеквизитаВалютаДокумента = "Валюта";
		
		ИмяРеквизитаРасшифровкаПлатежаСумма    = "Сумма";
		ПересчитатьСуммуНДСВРасшифровкеПлатежа = Ложь;
		
        НаборКонстант.ИА_ПроизводственныйКалендарьИмяРегистра   = "ДанныеПроизводственногоКалендаря";
        НаборКонстант.ИА_ПроизводственныйКалендарьИзмерениеДата = "Дата";
		
		ТипРегистраДенежныеСредства         = "РегистрНакопления";
		
		ИмяРегистраДенежныеСредстваНаличные    = "ДенежныеСредстваНаличные";
		ИмяРегистраДенежныеСредстваБезНаличные = "ДенежныеСредстваБезНаличные";

		КоличествоРегистровДенежныеСредства    = 2;
		
		ИмяРесурсаСуммаУпрНаличные    = "СуммаУпр";
		ИмяРесурсаСуммаУпрБезНаличные = "СуммаУпр";

	ИначеЕсли Конф ="УНФ" Тогда

		ИмяРеквизитаВалютаУПР       = "ВалютаУчета";
		ИмяРеквизитаВалютаДокумента = "ВалютаДенежныхСредств";
		
		ИмяРеквизитаРасшифровкаПлатежаСумма    = "СуммаПлатежа";
		ПересчитатьСуммуНДСВРасшифровкеПлатежа = Истина;
		
        НаборКонстант.ИА_ПроизводственныйКалендарьИмяРегистра   = "ДанныеПроизводственногоКалендаря";
        НаборКонстант.ИА_ПроизводственныйКалендарьИзмерениеДата = "Дата";
		
		ТипРегистраДенежныеСредства    = "РегистрНакопления";
		
		КоличествоРегистровДенежныеСредства    = 1;
		
		ИмяРегистраДенежныеСредства = "ДенежныеСредства";

		ИмяИзмеренияТипДенежныхСредств    = "ТипДенежныхСредств";
		ИмяПеречисленияТипДенежныхСредств ="ТипыДенежныхСредств";
		
		ИмяРесурсаСуммаУпр = "Сумма";

	КонецЕсли;
	
	ВидимостьЭлементовНастройкиЗаполненияРеквизитов();

КонецПроцедуры

