Процедура ЗаполнитьСпискиВыбора()
	
	ЗаполнитьСписокВыбораИмяРегистраДенежныеСредства();
	ЗаполнитьСписокВыбораИмяРегистраДенежныеСредстваНаличные();
	ЗаполнитьСписокВыбораИмяРегистраДенежныеСредстваБезНаличные();
	ЗаполнитьСписокВыбораИмяИзмеренияТипДенежныхСредств();
	ЗаполнитьСписокВыбораИмяРесурсаСуммаУпр();
	ЗаполнитьСписокВыбораИмяРесурсаСуммаУпрНаличные();
	ЗаполнитьСписокВыбораИмяРесурсаСуммаУпрБезНаличные();

КонецПроцедуры

&НаКлиенте
Процедура ВидимостьЭлементовНастройкиЗаполненияРеквизитов()

	Если ТипРегистраДенежныеСредства = "РегистрНакопления" Тогда
		
		Элементы.ГруппаТипРегистраДСНакопления.Видимость    = Истина;
		Элементы.ГруппаТипРегистраДСБухгалтерский.Видимость = Ложь;
		
		Если КоличествоРегистровДенежныеСредства = 2 Тогда
			Элементы.Группа1РегистрДС.Видимость = Ложь;
			Элементы.Группа2РегистрДС.Видимость = Истина;
		Иначе
			Элементы.Группа1РегистрДС.Видимость = Истина;
			Элементы.Группа2РегистрДС.Видимость = Ложь;
		КонецЕсли;
		
	КонецЕсли;
	
	Если ТипРегистраДенежныеСредства = "РегистрБухгалтерии" Тогда
		
		Элементы.ГруппаТипРегистраДСНакопления.Видимость    = Ложь;
		Элементы.ГруппаТипРегистраДСБухгалтерский.Видимость = Истина;
		
		Элементы.Группа1РегистрДС.Видимость = Ложь;
		Элементы.Группа2РегистрДС.Видимость = Ложь;
		
	КонецЕсли;
	
	Элементы.Группа1.Видимость = ЕстьПравоАдминистрирование;

КонецПроцедуры

&НаСервере
Процедура СохранитьНастройкиЗаполненияРеквизитовНаСервере()
	
	СохраняемоеЗначение = Новый Структура;
	
	СохраняемоеЗначение.Вставить("ИмяРеквизитаВалютаУПР", ИмяРеквизитаВалютаУПР);
	СохраняемоеЗначение.Вставить("ИмяРеквизитаВалютаДокумента", ИмяРеквизитаВалютаДокумента);
	
	СохраняемоеЗначение.Вставить("ИмяРеквизитаРасшифровкаПлатежаСумма", ИмяРеквизитаРасшифровкаПлатежаСумма);
	СохраняемоеЗначение.Вставить("ПересчитатьСуммуНДСВРасшифровкеПлатежа", ПересчитатьСуммуНДСВРасшифровкеПлатежа);
	
    //СохраняемоеЗначение.Вставить("ИмяРегистраПроизводственногоКалендаря", ИмяРегистраПроизводственногоКалендаря);
    //СохраняемоеЗначение.Вставить("ИмяИзмеренияДатаПроизводственногоКалендаря", ИмяИзмеренияДатаПроизводственногоКалендаря);
	
	СохраняемоеЗначение.Вставить("ТипРегистраДенежныеСредства", ТипРегистраДенежныеСредства);
	
	СтруктураРегистраДенежныеСредства = Новый Структура;
	
	Если ТипРегистраДенежныеСредства = "РегистрНакопления" Тогда
		
		СтруктураРегистраДенежныеСредства.Вставить("КоличествоРегистровДенежныеСредства", КоличествоРегистровДенежныеСредства);
		
		Если КоличествоРегистровДенежныеСредства =2 Тогда
			
			СтруктураРегистраДенежныеСредства.Вставить("ИмяРегистраДенежныеСредстваНаличные", ИмяРегистраДенежныеСредстваНаличные);
			СтруктураРегистраДенежныеСредства.Вставить("ИмяРегистраДенежныеСредстваБезНаличные", ИмяРегистраДенежныеСредстваБезНаличные);
			СтруктураРегистраДенежныеСредства.Вставить("ИмяРесурсаСуммаУпрНаличные", ИмяРесурсаСуммаУпрНаличные);
			СтруктураРегистраДенежныеСредства.Вставить("ИмяРесурсаСуммаУпрБезНаличные", ИмяРесурсаСуммаУпрБезНаличные);
			
		ИначеЕсли КоличествоРегистровДенежныеСредства =1 Тогда
			
			СтруктураРегистраДенежныеСредства.Вставить("ИмяРегистраДенежныеСредства", ИмяРегистраДенежныеСредства);
			СтруктураРегистраДенежныеСредства.Вставить("ИмяИзмеренияТипДенежныхСредств", ИмяИзмеренияТипДенежныхСредств);
			СтруктураРегистраДенежныеСредства.Вставить("ИмяПеречисленияТипДенежныхСредств", ИмяПеречисленияТипДенежныхСредств);
			СтруктураРегистраДенежныеСредства.Вставить("ИмяРесурсаСуммаУпр", ИмяРесурсаСуммаУпр);
			
						 			
		КонецЕсли;
		
	иначе
		
		СтруктураРегистраДенежныеСредства.Вставить("ИмяРегистраБухгалтерии", ИмяРегистраБухгалтерии);
		
		Если ИмяРегистраБухгалтерии = "Хозрасчетный" Тогда
		
			СтруктураРегистраДенежныеСредства.Вставить("КодСчетаНаличные", "50");
			СтруктураРегистраДенежныеСредства.Вставить("КодСчетаБезНаличные", "51");
		
		КонецЕсли;
		
	КонецЕсли;
	
	СохраняемоеЗначение.Вставить("СтруктураРегистраДенежныеСредства", СтруктураРегистраДенежныеСредства);
	
	Хранилище = Новый ХранилищеЗначения(СохраняемоеЗначение);
	Константы.ИА_ФП_НастройкиРеквизитов.Установить(Хранилище);

КонецПроцедуры

&НаСервере
Процедура ПолучитьНастройкиЗаполненияРеквизитовНаСервере()
	
	СтруктураНастроек = ИА_ФП_ПовторИсп.ПолучитьЗначениеКонстанты_ФП_НастройкиРеквизитов();
	Если ТипЗнч(СтруктураНастроек) <> Тип("Структура")  Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнитьНастройкиЗаполненияРеквизитовНаСервере(СтруктураНастроек);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьНастройкиЗаполненияРеквизитовНаСервере(СтруктураНастроек)
	
	Для каждого Настройка Из СтруктураНастроек Цикл
		                                                                             
		Если ТипЗнч(Настройка.Значение) = Тип("Структура") Тогда
			ЗаполнитьНастройкиЗаполненияРеквизитовНаСервере(Настройка.Значение);
		Иначе	 
			
			Попытка
				ЭтаФорма[Настройка.Ключ] = Настройка.Значение;
			Исключение
			
			КонецПопытки;
			
		КонецЕсли;
		
	КонецЦикла;
	
	ЗаполнитьСпискиВыбора();
	
КонецПроцедуры

