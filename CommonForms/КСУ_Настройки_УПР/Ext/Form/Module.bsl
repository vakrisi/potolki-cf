		ВызватьИсключение "Произошла ошибка при сохранении расписания. Возможно данные расписания были изменены. Закройте форму настройки и повторите попытку изменения расписания еще раз.
		|Подробное описание ошибки: " + ОписаниеОшибки();
	КонецПопытки;
КонецПроцедуры


&НаКлиенте
Процедура НадписьРасписаниеРегламентногоЗаданияНастройкиНажатие(Элемент)
	Если мРасписание = Неопределено Тогда
		Возврат
	КонецЕсли;
	Диалог = Новый ДиалогРасписанияРегламентногоЗадания(мРасписание);
		
	Диалог.Показать(Новый ОписаниеОповещения("НадписьРасписаниеРегламентногоЗаданияНастройкиНажатиеЗавершение", ЭтотОбъект, Новый Структура("Диалог", Диалог)));
КонецПроцедуры

&НаКлиенте
Процедура НадписьРасписаниеРегламентногоЗаданияНастройкиНажатиеЗавершение(Расписание1, ДополнительныеПараметры) Экспорт
	
	Диалог = ДополнительныеПараметры.Диалог;
	
	
	Если Расписание1<>Неопределено Тогда
		
		//РаспВр = Новый РасписаниеРегламентногоЗадания(Диалог.Расписание);
		УстановитьРасписание(Расписание1);
		
	КонецЕсли;
	
	УстановитьТекстНадписиРегламентнойНастройки();

КонецПроцедуры

&НаКлиенте
Процедура АвторасчетПриИзменении(Элемент)
	Если мРасписание = Неопределено Тогда
		Возврат
	КонецЕсли;
	УстановитьИспользование(Авторасчет);
	УстановитьТекстНадписиРегламентнойНастройки();
КонецПроцедуры

&НаКлиенте
Процедура ПолучитьТекстЗаголовкаИРасписанияРегламентнойНастройки(Использование,Расписание, ТекстЗаголовка, ТекстРасписания, РасписаниеАктивно) Экспорт
	
	РасписаниеАктивно = Ложь;
	
	ТекстЗаголовка = "Дополнительные настройки расписания ...";
	
	Если Расписание = Неопределено Тогда
		
		//ТекстЗаголовка = "Создать регламентную настройку ...";	
		ТекстРасписания = "<Расписание не задано>";
		
	Иначе
		
		//ТекстЗаголовка = "Дополнительные настройки расписания ...";
		Если Использование Тогда
			ПрефиксРасписания = "Расписание: ";
			РасписаниеАктивно = Истина;
		Иначе
			ПрефиксРасписания = "Расписание (НЕ АКТИВНО): ";
		КонецЕсли;
		
		ТекстРасписания = ПрефиксРасписания + Строка(Расписание);
		
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ПодписиСотрудников(Команда)
	ОткрытьФорму("РегистрСведений.ИА_ПодписиСотрудников.ФормаСписка");
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	ПослеЗаписиНаСервере();
	
	Если (ШрифтИзменен или ВысотаПодписиИзменена или СпособВыводаФИОИзменен) Тогда
		ПоказатьВопрос(Новый ОписаниеОповещения("ПослеЗаписиЗавершение", ЭтотОбъект), "Изменен шрифт или высота подписи сотрудников или способ представления ФИО. Пересчитать автоматически высоту блоков?", РежимДиалогаВопрос.ДаНет);
        Возврат;
	КонецЕсли;
	
	ПослеЗаписиФрагмент();
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписиЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса=КодВозвратаДиалога.Да Тогда
		ПересчитатьВысотуОргсхема();
	КонецЕсли;
	
	ПослеЗаписиФрагмент();

КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписиФрагмент()
	
	Если ДоступДИИзменен Тогда
		ПоказатьВопрос(Новый ОписаниеОповещения("ПослеЗаписиФрагментЗавершение", ЭтотОбъект), "Изменены настройки доступа к должностным инструкциям. Для вступления в силу изменений необходимо выполнить процедуру обновления доступа (это может занять несколько минут). Продолжить?", РежимДиалогаВопрос.ДаНет);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписиФрагментЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса=КодВозвратаДиалога.Да Тогда
		ПерезаписатьДИ();
	КонецЕсли;

КонецПроцедуры

&НаСервереБезКонтекста
Процедура ПерезаписатьДИ()
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ИА_Инструкции.Ссылка
	               |ИЗ
	               |	Справочник.ИА_Инструкции КАК ИА_Инструкции
	               |ГДЕ
	               |	ИА_Инструкции.ЭтоГруппа = ложь
	               |	И ИА_Инструкции.ПометкаУдаления = ложь";
				   
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		об = Выборка.Ссылка.Получитьобъект();
		об.Записать();
	КонецЦикла;
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ПересчитатьВысотуОргсхема()
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ОргСхема.Ссылка,
	               |	0 КАК Уровень
	               |ИЗ
	               |	Справочник.ОргСхема КАК ОргСхема
	               |ГДЕ
	               |	ОргСхема.ПометкаУдаления = ЛОЖЬ";
	ТЗ = Запрос.Выполнить().Выгрузить();

	Для каждого стр из ТЗ Цикл
		стр.Уровень = Стр.Ссылка.Уровень();
	КонецЦикла;
	ТЗ.Сортировать("Уровень УБЫВ");
	
	Для каждого стр из ТЗ Цикл
		о = стр.Ссылка.ПолучитьОбъект();
		о.Записать();
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере()
	
	Константы.ИА_ШрифтПодписиСотрудника.Установить(Новый ХранилищеЗначения(ПолеШрифт));
	
	СохранитьНастройкиЗаполненияРеквизитовНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ПолеШрифтПриИзменении(Элемент)
	Модифицированность = истина;
	ШрифтИзменен = Истина;
КонецПроцедуры

&НаКлиенте
Процедура ИА_ВысотаПодписиВБлокеСекцияИСотрудникПриИзменении(Элемент)
	ВысотаПодписиИзменена = истина;
КонецПроцедуры

&НаКлиенте
Процедура ИА_ПечатьСтатистикВЭксельПриИзменении(Элемент)
	Если НаборКонстант.ИА_ПечатьСтатистикВЭксель И Не ЗначениеЗаполнено(НаборКонстант.ИА_ТипДиаграммыВЭксель) Тогда
		НаборКонстант.ИА_ТипДиаграммыВЭксель = ПредопределенноеЗначение("Перечисление.ИА_ТипыДиаграммыВЭксель.Графики");
	КонецЕсли;		
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	Если НаборКонстант.ИА_ПечатьСтатистикВЭксель И Не ЗначениеЗаполнено(НаборКонстант.ИА_ТипДиаграммыВЭксель) Тогда
		Сообщить("Не выбран тип диаграммы в эксель!");
		Отказ = Истина;
	КонецЕсли;
	
	Если НаборКонстант.КСУ_СинхронизацияСтатейИПодразделений И Не ЗначениеЗаполнено(НаборКонстант.КСУ_ФондДляНовыхСтатей) Тогда
		Сообщить("Укажите фонд для новых статей!");
		Отказ = Истина;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура КаталогХраненияФайловНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	
	КаталогХранения = НаборКонстант["ИА_"+Элемент.Имя];	
	
	ВыборКаталогаДляХранения(КаталогХранения);
	
    НаборКонстант["ИА_"+Элемент.Имя] = КаталогХранения;
	
КонецПроцедуры



&НаКлиенте
Процедура ВыборКаталогаДляХранения(КаталогХранения)
	
  ОчиститьСообщения();	
  СтароеЗначениеКаталога = КаталогХранения;
	
  Режим = РежимДиалогаВыбораФайла.ВыборКаталога;
  ДиалогВыбораКаталога= Новый ДиалогВыбораФайла(Режим);
  ДиалогВыбораКаталога.Каталог = КаталогХранения;
  
  Если ДиалогВыбораКаталога.Выбрать() Тогда
	  
	 КаталогХранения = ДиалогВыбораКаталога.Каталог+"\";
	 
	 Попытка
		 ПроверкаПравНаЗаписи = Новый ТекстовыйДокумент;
		 ПроверкаПравНаЗаписи.Записать(КаталогХранения+"Test.txt");
		 УбратьФайл = Новый Файл(КаталогХранения+"Test.txt");
		 Если УбратьФайл.Существует() Тогда
			 УдалитьФайлы(КаталогХранения+"Test.txt");
		 КонецЕсли;
	 Исключение      
		 
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "У вас нет прав для записи в каталог : "+КаталогХранения +" !" ;
		Сообщение.Сообщить(); 
		
		КаталогХранения = СтароеЗначениеКаталога;
		
	 КонецПопытки;
	Иначе
	  
	 КаталогХранения = "";
	  
  КонецЕсли;  
  
  
    
КонецПроцедуры



