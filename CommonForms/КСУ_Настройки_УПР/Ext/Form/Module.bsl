Процедура КСУ_ВидОргсхемыПриИзмененииНаСервере()
	Элементы.ИА_ВариантыОформленияДепартаментов.Доступность = НаборКонстант.КСУ_ВидОргсхемы <> Перечисления.КСУ_ВидОргсхемы.EM;	
	Если НаборКонстант.КСУ_ВидОргсхемы = Перечисления.КСУ_ВидОргсхемы.EM Тогда
		НаборКонстант.ИА_ВариантыОформленияДепартаментов = Перечисления.ИА_ВариантыОформленияДепартаментов.Отдельно;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура КСУ_ВидОргсхемыПриИзменении(Элемент)
	КСУ_ВидОргсхемыПриИзмененииНаСервере();
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьРасписаниеРассылки()
	Отбор = Новый Структура;
	Отбор.Вставить("Метаданные",      Метаданные.РегламентныеЗадания.КСУ_Рассылка_РС_Владельца);
	Отбор.Вставить("Использование",   Истина);                               
	ФоновоеЗадание = РегламентныеЗадания.ПолучитьРегламентныеЗадания(Отбор);
	возврат ФоновоеЗадание[0].Расписание;
КонецФункции

&НаСервереБезКонтекста
Процедура УстановитьРаспианиеРассылки(расп)
	Отбор = Новый Структура;
	Отбор.Вставить("Метаданные",      Метаданные.РегламентныеЗадания.КСУ_Рассылка_РС_Владельца);
	Отбор.Вставить("Использование",   Истина);                               
	ФоновоеЗадание = РегламентныеЗадания.ПолучитьРегламентныеЗадания(Отбор);
	ф = ФоновоеЗадание[0];
	ф.расписание = расп;
	ф.Записать();
КонецПроцедуры

&НаКлиенте
Процедура ДекРасписаниеНажатие(Элемент)
	
	Попытка
		расп = ПолучитьРасписаниеРассылки();
			
		Диалог = Новый ДиалогРасписанияРегламентногоЗадания(расп);  		
		Диалог.Показать(Новый ОписаниеОповещения("ДекРасписаниеНажатиеЗавершение", ЭтотОбъект));		
	Исключение
		Сообщить(ОписаниеОшибки());
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура ДекРасписаниеНажатиеЗавершение(Расписание11, ДополнительныеПараметры) Экспорт
		
	Если Расписание11<>Неопределено Тогда
		УстановитьРаспианиеРассылки(Расписание11);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура НастройкиВебСистемы(Команда)
	ОткрытьФорму("ОбщаяФорма.КСУ_НастройкиВеб");
КонецПроцедуры

&НаКлиенте
Процедура КСУ_КЦ_ИспользоватьВзаимодействия1СПриИзменении(Элемент)
	Если НаборКонстант.КСУ_КЦ_ИспользоватьВзаимодействия1С Тогда
		Если НЕ СистемаВзаимодействия.ИспользованиеДоступно() Тогда
			ПоказатьПредупреждение(,"База не зарегистрирована в системе взаимодействий! Обратитесь к администратору");
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура КСУ_ФП_ИспользоватьПодразделенияПриИзменении(Элемент)
	Если НаборКонстант.КСУ_ФП_ИспользоватьПодразделения <> ЗначениеВедениеПОподр() Тогда
		ОпОп = новый ОписаниеОповещения("ВыборВопросПодр", ЭтотОбъект);
		СтрокаСообщ = "Внимание! 
                       |
                       |Изменение режима ведения учета по подразделениям 
					   |повлияет на корректность работы ФП. Могут быть 
					   |искажены остатки по фондам, резервам, неверно 
					   |работать уже настроенные точки безубыточности.
                       |
                       |Проконсультируйтесь со специалистом 
					   |компании Инсайт 
					   |(тел. 8-495-9894340). 
                       |
                       |Отменить изменение?";
		ПоказатьВопрос(ОпОп, СтрокаСообщ, РежимДиалогаВопрос.ДаНет);
	Иначе
		ОбновитьДоступностьДоходыПоПодр();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ВыборВопросПодр(выбзн, дп) экспорт
	Если выбзн = КодВозвратаДиалога.Да тогда
		НаборКонстант.КСУ_ФП_ИспользоватьПодразделения = ЗначениеВедениеПОподр();
	КонецЕсли;
		
	ОбновитьДоступностьДоходыПоПодр();
КонецПроцедуры
	
&НаСервереБезКонтекста
Функция ЗначениеВедениеПОподр()
	возврат Константы.КСУ_ФП_ИспользоватьПодразделения.Получить();
КонецФункции

&НаКлиенте
Процедура ОбновитьДоступностьДоходыПоПодр()
	Элементы.КСУ_ДоходыПоПодразделениям.Доступность = НаборКонстант.КСУ_ФП_ИспользоватьПодразделения  ;
	Если не Элементы.КСУ_ДоходыПоПодразделениям.Доступность и НаборКонстант.КСУ_ДоходыПоПодразделениям Тогда
		НаборКонстант.КСУ_ДоходыПоПодразделениям = ложь;
		Модифицированность = Истина;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура СнятьБлокировкуПолей(Команда)
	ПоляЗаблокированы = Ложь;
	ОбновитьБлокПолей();
КонецПроцедуры

&НаКлиенте
Процедура ЗаблокироватьПоля(Команда)
	ПоляЗаблокированы = Истина;
	ОбновитьБлокПолей();
КонецПроцедуры


&НаКлиенте
Процедура ОбновитьБлокПолей()
	Элементы.ГруппаРекв.ТолькоПросмотр = ПоляЗаблокированы;
	Элементы.ГруппаЗаполнитьПоШаблону.Видимость = не ПоляЗаблокированы;
	Элементы.ЗаблокироватьПоля.Видимость = не ПоляЗаблокированы;
	Элементы.СнятьБлокировкуПолей.Видимость = ПоляЗаблокированы;
КонецПроцедуры


#КонецОбласти



