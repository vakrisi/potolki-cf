	Возврат Рез;
КонецФункции

&НаСервере
Функция ПолучитьАвторасчет()
	Попытка
		рез = РегламентныеЗадания.НайтиПредопределенное(Метаданные.РегламентныеЗадания.КСУ_ПересчетКубов);
		рез = рез.Использование;
	Исключение
		Рез = Ложь;
