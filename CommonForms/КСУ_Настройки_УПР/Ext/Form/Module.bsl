&НаСервере
Процедура ЗаполнитьСписокВыбораПоСпискуРегистровНакопления(Элемент)
	
	Элемент.СписокВыбора.Очистить();
	Для каждого МетаданныеРН Из Метаданные.РегистрыНакопления Цикл
	  	Элемент.СписокВыбора.Добавить(МетаданныеРН.Имя, МетаданныеРН.Синоним);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокВыбораПоСпискуИзмеренийРегистраНакопления(ИмяРегистра, Элемент)
	
	Элемент.СписокВыбора.Очистить();
	Если ЗначениеЗаполнено(ИмяРегистра) и Метаданные.РегистрыНакопления.Найти(ИмяРегистра)<>Неопределено Тогда
		Для каждого РеквизитРН Из Метаданные.РегистрыНакопления[ИмяРегистра].Измерения Цикл
			Элемент.СписокВыбора.Добавить(РеквизитРН.Имя, РеквизитРН.Синоним);
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокВыбораПоСпискуРесурсовРегистраНакопления(ИмяРегистра, Элемент)
	
	Элемент.СписокВыбора.Очистить();
	Если ЗначениеЗаполнено(ИмяРегистра) И Метаданные.РегистрыНакопления.Найти(ИмяРегистра)<>Неопределено Тогда
		Для каждого РеквизитРН Из Метаданные.РегистрыНакопления[ИмяРегистра].Ресурсы Цикл
			Элемент.СписокВыбора.Добавить(РеквизитРН.Имя, РеквизитРН.Синоним);
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

