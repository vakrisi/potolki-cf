	//ВывестиТабличныйДокумент();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ПодключитьОбработчикОжидания("ЗапуститьЗаполнение", 0.1, Истина);
	
КонецПроцедуры

#КонецОбласти

#Область ФоновоеЗаполнение

&НаКлиенте
Процедура ЗапуститьЗаполнение()
	
	ОчиститьСообщения();	
	ЗапуститьРасчетСледующегоЭтапаВФоне();
	
КонецПроцедуры

&НаКлиенте
Функция ЗапуститьРасчетСледующегоЭтапаВФоне()
	
	// Инициализируем расчет.
	ПрерватьРасчет = Ложь;
	РасчетЗапущен = Истина;
	РасчетЗавершен = Ложь;
	
	СостояниеРасчета = ИнициализироватьСтруктуруСостоянияРасчетаЭтапов();
	
	СтрокиЗаказов = ДеревоЗаказов.ПолучитьЭлементы();
	ПрерватьЦиклЗаказов = Ложь;
	Для каждого СтрокаЗаказа из СтрокиЗаказов Цикл
		Если СтрокаЗаказа.Выполнен Тогда
		Иначе
			ВывестиВТабличныйДокумент(СтрокаЗаказа.ЗаказПокупателя);
			СтрокаЗаказа.Выполнен = Истина;
		КонецЕсли;
		
		СтрокиНоменклатуры = СтрокаЗаказа.ПолучитьЭлементы();
		
		Для каждого СтрокаПродукции из СтрокиНоменклатуры Цикл
			
			Если СтрокаПродукции.Выполнен Тогда				
				Если СтрокаПродукции.ИндексМассива = КоличествоПозиций-1 Тогда
					РасчетЗавершен = Истина;
				КонецЕсли;
				Продолжить;
			КонецЕсли;
			
			//ТекущийРассчитываемыйЭтап = СтрокаДерева.Код;
			
			СостояниеРасчета.ПредставлениеЭтапа = СтрокаПродукции.Номенклатура;
			
			ИДЗадания = Неопределено;
			
			ПараметрыЗапуска = Новый Структура;
			ПараметрыЗапуска.Вставить("ИмяМетода", СтрокаПродукции.Код);
			ПараметрыЗапуска.Вставить("Заказ", СтрокаЗаказа.ЗаказПокупателя);
			ПараметрыЗапуска.Вставить("Продукция", СписокНоменклатуры.Получить(СтрокаПродукции.ИндексМассива).Значение);
			ПараметрыЗапуска.Вставить("УникальныйИдентификатор", УникальныйИдентификатор);
			
			СтруктураФоновогоЗадания = ВыполнитьФоновоеЗаданиеНаСервере(ПараметрыЗапуска, УникальныйИдентификатор);
			ИДЗадания = СтруктураФоновогоЗадания.ИдентификаторЗадания;
			
			ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
			ПараметрыОжидания.ВыводитьОкноОжидания = Ложь;
			ПараметрыОжидания.ВыводитьПрогрессВыполнения = Истина;
			ПараметрыОжидания.Интервал = 2;
			
			ДлительныеОперацииКлиент.ОжидатьЗавершение(СтруктураФоновогоЗадания, Новый ОписаниеОповещения("ОбработатьДанные", ЭтотОбъект, СтрокаПродукции.ПолучитьИдентификатор()), ПараметрыОжидания);
			
			//ПодключитьОбработчикОжидания("ПроверитьАктивностьФоновогоЗаданияРасчета", 1);
			//ПроверитьАктивностьФоновогоЗаданияРасчета();
			
			ПрерватьЦиклЗаказов = Истина;
			Прервать;			
		КонецЦикла;
		
		Если ПрерватьЦиклЗаказов Тогда 
			Прервать;
		КонецЕсли;		
	КонецЦикла;
	
	Если РасчетЗавершен Тогда
		//ТекущийРассчитываемыйЭтап = Неопределено;
		СостояниеРасчета.РасчетЗавершен = Истина;
		//ОтключитьОбработчикОжидания("ПроверитьАктивностьФоновогоЗаданияРасчета");
		
		Оповестить("ОбновитьАРМПроизводства",,"ЗаказНаПроизводство");
		Оповестить("ОбновитьАРМПроизводства",,"ЗаказПокупателя");
	КонецЕсли;
	
	НастроитьЭлементыВЗависимостиОтНаличияФоновыхЗаданий();
	
	Возврат РасчетЗапущен;
	
КонецФункции

&НаСервереБезКонтекста
Функция ВыполнитьФоновоеЗаданиеНаСервере(ПараметрыЗапуска, УникальныйИдентификатор)

	НаименованиеЗадания = НСтр("ru = 'Запуск длительной операции'");
	
	ВыполняемыйМетод = "ОбщийМодульСервер.СозданиеЗаказаНаПроизводствоПоФоновомуЗаданию";
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = НаименованиеЗадания;
	ПараметрыВыполнения.ЗапуститьВФоне = Истина;
	ПараметрыВыполнения.Вставить("ИдентификаторФормы", УникальныйИдентификатор); 
	
	СтруктураФоновогоЗадания = ДлительныеОперации.ВыполнитьВФоне(ВыполняемыйМетод, ПараметрыЗапуска, ПараметрыВыполнения);
	
	Возврат СтруктураФоновогоЗадания;
	
КонецФункции

&НаКлиенте
Процедура ОбработатьДанные(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
		
	ИначеЕсли Результат.Статус = "Ошибка" Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Результат.ПодробноеПредставлениеОшибки);
		//ЗафиксироватьПроблемуРасчета(ДополнительныеПараметры);
		
	ИначеЕсли Результат.Статус = "Выполнено" Тогда
		// обрабатываем результат
		РезультатЭтапа = ПолучитьИзВременногоХранилища(Результат.АдресРезультата);
		
		Для Каждого ЭлементМассива Из РезультатЭтапа.СозданоНовых Цикл
			//МассивСозданныхИОбновленныхЗаказов.Добавить(Новый Структура("ЗаказПокупателя, ЗаказНаПроизводство, Создан, ПроведенВыпуск", ОбъектОтбора, ТекущаяСтрока, Истина, СтруктураВозврата.ПроведенВыпуск));
			ЦветОбласти = WebЦвета.ЛимонноЗеленый;
			Если Элементы.ГруппаОшибкаПроведенияВыпуска.Видимость И НЕ РезультатЭтапа.ПроведенВыпуск Тогда
				ЦветОбласти = WebЦвета.ОранжевоКрасный;
			КонецЕсли;
			ВывестиВТабличныйДокумент(ЭлементМассива, ЦветОбласти);
		КонецЦикла;
		
		Для Каждого ЭлементМассива Из РезультатЭтапа.Обновлено Цикл
			//МассивСозданныхИОбновленныхЗаказов.Добавить(Новый Структура("ЗаказПокупателя, ЗаказНаПроизводство, Создан, ПроведенВыпуск", ОбъектОтбора, ТекущаяСтрока, Ложь, СтруктураВозврата.ПроведенВыпуск));			
			ЦветОбласти = WebЦвета.Золотой;
			Если Элементы.ГруппаОшибкаПроведенияВыпуска.Видимость И НЕ РезультатЭтапа.ПроведенВыпуск Тогда
				ЦветОбласти = WebЦвета.ОранжевоКрасный;
			КонецЕсли;
			ВывестиВТабличныйДокумент(ЭлементМассива, ЦветОбласти);
		КонецЦикла;

		Если Элементы.ГруппаОшибкаПроведенияВыпуска.Видимость Тогда
			Для Каждого ЭлементМассива Из РезультатЭтапа.Выпуски Цикл						
				ЦветОбласти = ?(ЭлементМассива.Новый, WebЦвета.ЛимонноЗеленый, WebЦвета.Золотой);
				Если НЕ РезультатЭтапа.ПроведенВыпуск Тогда
					ЦветОбласти = WebЦвета.ОранжевоКрасный;
				КонецЕсли;
				ВывестиВТабличныйДокумент(ЭлементМассива.Документ, ЦветОбласти);
			КонецЦикла;
		КонецЕсли;
		
		Для Каждого ЭлементМассива Из РезультатЭтапа.МассивСообщений Цикл
			ВывестиВТабличныйДокумент(ЭлементМассива.Текст);
		КонецЦикла;
	   	ВывестиВТабличныйДокумент("");
	   
		СтрокаДерева = ДеревоЗаказов.НайтиПоИдентификатору(ДополнительныеПараметры);
		СтрокаДерева.Выполнен = Истина;
		
		Если ВызовИзФормыОбъекта Тогда
			Оповестить("ОбновитьЗаказПокупателяПослеСозданияЗаказовНаПроизводство", СтрокаДерева.ЗаказПокупателя);
		КонецЕсли;
		
		ЗапуститьРасчетСледующегоЭтапаВФоне();
		
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ИнициализироватьСтруктуруСостоянияРасчетаЭтапов() Экспорт
	
	СостояниеРасчета = Новый Структура;
	СостояниеРасчета.Вставить("ПредставлениеЭтапа", 	   "");
	СостояниеРасчета.Вставить("РасчетЗавершен", Ложь);
	
	Возврат СостояниеРасчета;
	
КонецФункции

&НаСервереБезКонтекста
Функция ТекущееСостояниеФоновогоЗадания(ИдентификаторЗадания, ДляЧтенияНаКлиенте = Истина)
	
	СостояниеЗадания = ОбщийМодульСервер.ТекущееСостояниеФоновогоЗадания(ИдентификаторЗадания);
	
	Если ДляЧтенияНаКлиенте Тогда
		СостояниеЗадания.Удалить("Задание"); // тип значения этого свойства недоступен на клиенте
	КонецЕсли;
	
	Возврат СостояниеЗадания;
	
КонецФункции

