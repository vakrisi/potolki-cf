	//	
	//	Для Каждого ТекущаяСтрока Из Параметры.МассивСозданныхИОбновленныхЗаказов Цикл
	//		НоваяСтрока = СтруктураСозданныхИОбновленныхЗаказовНаПроизводство.Добавить();
	//		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущаяСтрока);
	//	КонецЦикла;
