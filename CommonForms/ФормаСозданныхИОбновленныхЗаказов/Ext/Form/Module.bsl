&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Элементы.ГруппаОшибкаПроведенияВыпуска.Видимость = ПолучитьФункциональнуюОпцию("АвтоматическиРегистрироватьВыпускПриЗаказеНаПроизводство");
	
	//#10918 изменена схема
	ВызовИзФормыОбъекта = Параметры.ЭтоФормаОбъекта;
	ВызовИзАРМПроизводства = НЕ Параметры.ЭтоФормаОбъекта;
	
	КоличествоПозиций = 0;
	Для каждого ЭлементМассива из Параметры.МассивНоменклатур Цикл
		ИскомаяСтрокаЗаказа = Неопределено;
		СтрокиЗаказов = ДеревоЗаказов.ПолучитьЭлементы();
		Для каждого СтрокаЗаказа из СтрокиЗаказов Цикл
			Если СтрокаЗаказа.ЗаказПокупателя = ЭлементМассива.Заказ Тогда
				ИскомаяСтрокаЗаказа = СтрокаЗаказа;
			КонецЕсли;
		КонецЦикла;
		Если ИскомаяСтрокаЗаказа = Неопределено Тогда
			ИскомаяСтрокаЗаказа = СтрокиЗаказов.Добавить();
			ИскомаяСтрокаЗаказа.ЗаказПокупателя = ЭлементМассива.Заказ;
		КонецЕсли;
		
		НоваяСтрока = ИскомаяСтрокаЗаказа.ПолучитьЭлементы().Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ЭлементМассива);
		НоваяСтрока.ЗаказПокупателя = ЭлементМассива.Заказ;
		НоваяСтрока.Код = НоваяСтрока.Номенклатура.Код;
		НоваяСтрока.ИндексМассива = КоличествоПозиций;
		КоличествоПозиций = КоличествоПозиций + 1;
		
		СписокНоменклатуры.Добавить(ЭлементМассива);
	КонецЦикла;
	
