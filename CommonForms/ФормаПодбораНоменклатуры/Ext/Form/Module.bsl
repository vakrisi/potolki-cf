&НаСервере
Функция ПоместитьДанныеВХранилище(ТекущиеДанные)
	
	Данные = новый Структура();
	Данные.Вставить("ЕстьИзображение", (НЕ ТекущиеДанные.НоменклатураСсылка.ФайлКартинки.ФайлХранилище.Получить() = Неопределено));
	Данные.Вставить("Хранилище", ПоместитьВоВременноеХранилище(ТекущиеДанные.НоменклатураСсылка.ФайлКартинки.ФайлХранилище.Получить(), ЭтаФорма.УникальныйИдентификатор));
	Данные.Вставить("Расширение", ТекущиеДанные.НоменклатураСсылка.ФайлКартинки.Расширение);
	
	Возврат Данные;
	
КонецФункции

