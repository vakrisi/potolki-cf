	ДинамическийСписок.Параметры.УстановитьЗначениеПараметра("ТолькоВНаличии", ТолькоВНаличии);
	ДинамическийСписок.Параметры.УстановитьЗначениеПараметра("ВАльтернативнойЕдиницеИзмерения", ВАльтернативнойЕдиницеИзмерения);
	
	ДинамическийСписок.Параметры.УстановитьЗначениеПараметра("ДатаЦен", ДатаЦен); // #15122
	ДинамическийСписок.Параметры.УстановитьЗначениеПараметра("ВидЦены", ВидЦены);	
	ДинамическийСписок.Параметры.УстановитьЗначениеПараметра("Валюта", Валюта);
	ДинамическийСписок.Параметры.УстановитьЗначениеПараметра("ХарактеристикаНоменклатуры", Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка());	
	ДинамическийСписок.Параметры.УстановитьЗначениеПараметра("Поставщик", Поставщик);
	ДинамическийСписок.Параметры.УстановитьЗначениеПараметра("ВидЦеныПоставщика", ВидЦеныПоставщика);
	ДинамическийСписок.Параметры.УстановитьЗначениеПараметра("ИспользуютсяОбщиеСклады", Константы.ОбщиеСклады.Получить());
	
	ДинамическийСписок.Параметры.УстановитьЗначениеПараметра("ИспользоватьИндивидуальныеЦены", ПолучитьФункциональнуюОпцию("ИспользоватьИндивидуальныеЦены"));
	ДинамическийСписок.Параметры.УстановитьЗначениеПараметра("Контрагент", Контрагент);
	ДинамическийСписок.Параметры.УстановитьЗначениеПараметра("ДоговорКонтрагента", ДоговорКонтрагента);
	
	Если ДинамическийСписок = СписокАналогов Тогда
		ДинамическийСписок.Параметры.УстановитьЗначениеПараметра("НоменклатураРодительАналога", Справочники.Номенклатура.ПустаяСсылка());	
	КонецЕсли;
	
	// №6193
	Если НЕ ДинамическийСписок = СписокАналогов Тогда
		ДинамическийСписок.Параметры.УстановитьЗначениеПараметра("ИспользоватьРезервирование", Константы.ИспользоватьРезервирование.Получить());
	КонецЕсли;	
	
КонецПроцедуры

