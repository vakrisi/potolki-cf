Функция ПолучитьЦенуЗакупки(Данные)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Закупки.Период КАК Период,
		|	Закупки.Номенклатура КАК Номенклатура,
		|	Закупки.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
		|	Закупки.Контрагент КАК Контрагент,
		|	Закупки.Количество КАК Количество,
		|	Закупки.Сумма КАК Сумма,
		|	ВЫБОР
		|		КОГДА Закупки.Количество > 0
		|			ТОГДА ЕСТЬNULL(Закупки.Сумма, 0) / Закупки.Количество
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК Цена
		|ИЗ
		|	РегистрНакопления.Закупки КАК Закупки
		|ГДЕ
		|	Закупки.Номенклатура = &Номенклатура
		|	И Закупки.ХарактеристикаНоменклатуры = &ХарактеристикаНоменклатуры
		|	И Закупки.Контрагент = &Контрагент
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ ПЕРВЫЕ 1
		|	Закупки.Период,
		|	Закупки.Номенклатура,
		|	Закупки.ХарактеристикаНоменклатуры,
		|	Закупки.Контрагент,
		|	Закупки.Количество,
		|	Закупки.Сумма,
		|	ВЫБОР
		|		КОГДА Закупки.Количество > 0
		|			ТОГДА ЕСТЬNULL(Закупки.Сумма, 0) / Закупки.Количество
		|		ИНАЧЕ 0
		|	КОНЕЦ
		|ИЗ
		|	РегистрНакопления.Закупки КАК Закупки
		|ГДЕ
		|	Закупки.Номенклатура = &Номенклатура
		|	И Закупки.ХарактеристикаНоменклатуры = &ХарактеристикаНоменклатуры
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ ПЕРВЫЕ 5
		|	ТоварыНаСкладах.Период,
		|	ТоварыНаСкладах.Номенклатура,
		|	ТоварыНаСкладах.ХарактеристикаНоменклатуры,
		|	"""",
		|	ТоварыНаСкладах.Количество,
		|	ТоварыНаСкладах.Сумма,
		|	ВЫБОР
		|		КОГДА ТоварыНаСкладах.Количество > 0
		|			ТОГДА ЕСТЬNULL(ТоварыНаСкладах.Сумма, 0) / ТоварыНаСкладах.Количество
		|		ИНАЧЕ 0
		|	КОНЕЦ
		|ИЗ
		|	РегистрНакопления.ТоварыНаСкладах КАК ТоварыНаСкладах
		|ГДЕ
		|	ТоварыНаСкладах.Номенклатура = &Номенклатура
		|	И ТоварыНаСкладах.ХарактеристикаНоменклатуры = &ХарактеристикаНоменклатуры
		|	И ТИПЗНАЧЕНИЯ(ТоварыНаСкладах.Регистратор) = ТИП(Документ.ОприходованиеТоваров)
		|	И ВЫБОР
		|			КОГДА ТоварыНаСкладах.Количество > 0
		|				ТОГДА ЕСТЬNULL(ТоварыНаСкладах.Сумма, 0) / ТоварыНаСкладах.Количество
		|			ИНАЧЕ 0
		|		КОНЕЦ > 0
		|
		|УПОРЯДОЧИТЬ ПО
		|	Период УБЫВ";
	
	Запрос.УстановитьПараметр("Контрагент", Справочники.Контрагенты.ПустаяСсылка()); //поставщики могут быть разные, а не только те, которые выбраны в номенклатуре
	Запрос.УстановитьПараметр("Номенклатура", Данные.НоменклатураСсылка);
	Запрос.УстановитьПараметр("ХарактеристикаНоменклатуры", Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка()); //Характеристики не учитываем
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Возврат ВыборкаДетальныеЗаписи.Цена;
	Иначе
		Возврат 0;
	КонецЕсли;
	
КонецФункции	
