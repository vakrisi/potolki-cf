#КонецОбласти

#Область ГруппаНоменклатура

&НаКлиенте
Процедура СписокНоменклатурыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТекущиеДанные = Элемент.ТекущиеДанные;
	
	Если ЭтоГруппа(ТекущиеДанные.НоменклатураСсылка) Тогда
		Возврат;
	Иначе
		СтандартнаяОбработка = Ложь;
	КонецЕсли;
	
	Если ПодборТиповых Тогда
		ДобавитьОтрезВКорзину(ТекущиеДанные);
	Иначе	
		Если ТекущиеДанные.ИмеютсяХарактеристики Тогда
			ПерейтиКСпискуХарактеристикНоменклатуры(ТекущиеДанные.НоменклатураСсылка);
		Иначе
			ДобавитьНоменклатуруВКорзину(ТекущиеДанные);
		КонецЕсли;
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ПерейтиКСпискуНоменклатуры()
	
	Элементы.СтраницыНоменклатураХарактеристики.ТекущаяСтраница = Элементы.СтраницаНоменклатура;
	Элементы.НавигацияСписковНоменклатураХарактеристики.Заголовок = НСтр("ru ='Характеристики'");
	
КонецПроцедуры

&НаКлиенте
Процедура ПерейтиКСпискуХарактеристикНоменклатуры(НоменклатураСсылка, ПоАналогам = Ложь)
	
	ПолеОтбора = "НоменклатураСсылка";
	ЭлементОтбора = Неопределено;
	Список = ?(НЕ ПоАналогам, СписокХарактеристик, СписокХарактеристикАналогов);
	
	Для каждого ЭлементФиксОтбора Из Список.КомпоновщикНастроек.ФиксированныеНастройки.Отбор.Элементы Цикл	
		Если ТипЗнч(ЭлементФиксОтбора) = Тип("ЭлементОтбораКомпоновкиДанных") Тогда
			Если ЭлементФиксОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ПолеОтбора) Тогда
				ЭлементОтбора = ЭлементФиксОтбора;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Элемент = ?(НЕ ЭлементОтбора = Неопределено, ЭлементОтбора, Список.КомпоновщикНастроек.ФиксированныеНастройки.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных")));
	Элемент.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ПолеОтбора);
	Элемент.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	Элемент.ПравоеЗначение = НоменклатураСсылка;	
	Элемент.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный;
	Элемент.Использование = Истина;
	
	Если НЕ ПоАналогам Тогда
		Элементы.СтраницыНоменклатураХарактеристики.ТекущаяСтраница = Элементы.СтраницаХарактеристики;
		Элементы.НавигацияСписковНоменклатураХарактеристики.Заголовок = НСтр("ru ='Номенклатура'");
	Иначе
		Элементы.СтраницыАналогов.ТекущаяСтраница = Элементы.СтраницаАналогиХарактеристики;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СписокНоменклатурыПриАктивизацииСтроки(Элемент)
	ПодключитьОбработчикОжидания("ПодборТаблицаПриАктивизацииСтрокиОбработчикОжидания", 0.1, Истина);
КонецПроцедуры

&НаКлиенте
Процедура ПодборТаблицаПриАктивизацииСтрокиОбработчикОжидания()
	
	ТекущиеДанные = Элементы.СписокНоменклатуры.ТекущиеДанные;

	Если НЕ ТекущиеДанные = Неопределено Тогда
		
		Если НЕ ТекущиеДанные.НоменклатураСсылка = ТекущаяНоменклатура Тогда
			
			ТекущаяНоменклатура = ТекущиеДанные.НоменклатураСсылка;
			
			Если ПоказыватьАналоги Тогда
				ВернутьсяКСпискуАналогов(Неопределено);
				УстановитьОтборПоАналогам(ТекущиеДанные.НоменклатураСсылка);
			КонецЕсли;
			
			//++ №9160
			Если ПоказыватьИзображенияНоменклатуры Тогда
				ПодключитьОбработчикОжидания("ОбработчикОжиданияФайлыПриАктивизацииСтроки", 0.1, Истина);
			КонецЕсли;	
			//-- №9160
			
		КонецЕсли;	
			
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СписокНоменклатурыПриСменеТекущегоРодителя(Элемент)
	// фикс для платформы 8.3.10: не работает прокрутка колесиком мыши, недоступны кнопки управления списком в правом нижнем углу	
	Если Элемент.ТекущиеДанные <> Неопределено Тогда // по заявке №4797, добавлена проверка, что в группе есть элементы, иначе курсор сбивается
		Элементы.СписокНоменклатуры.Обновить();
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура СписокХарактеристикВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТекущиеДанные = Элемент.ТекущиеДанные;
	ДобавитьНоменклатуруВКорзину(ТекущиеДанные, Истина);

КонецПроцедуры

#КонецОбласти

#Область ГруппаВыбраннаяНоменклатура

&НаКлиенте
Процедура ВыбраннаяНоменклатураПередНачаломИзменения(Элемент, Отказ)
	
	ТекущиеДанные = Элементы.ВыбраннаяНоменклатура.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	мНоменклатура = ТекущиеДанные.Номенклатура;
	мХарактеристика = ТекущиеДанные.ХарактеристикаНоменклатуры;
	мКоличество = ТекущиеДанные.Количество;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыбраннаяНоменклатураПередУдалением(Элемент, Отказ)
	
	Если НЕ Отказ
		И ИспользуетсяПодборСТ
		И СтруктураДействийПоСТ.АвтоматическиДобавлятьСопутствующиеТоварыИУслуги Тогда
		
		МассивСопутствующихТоваровНаУдаление = Новый Массив;
		ВыбранныеСтроки = Элементы.ВыбраннаяНоменклатура.ВыделенныеСтроки;
		
		Для Каждого ВыделеннаяСтрока Из ВыбранныеСтроки Цикл
			ТекущиеДанные = ВыбраннаяНоменклатура.НайтиПоИдентификатору(ВыделеннаяСтрока);			
			СопутствующиеТоварыКлиент.НайтиСвязанныеСтрокиПоСопуствующимТоварамПоТаблице(ВыбраннаяНоменклатура, ВыбранныеСтроки, ТекущиеДанные.УИСтроки, МассивСопутствующихТоваровНаУдаление);
		КонецЦикла;
			
		Если МассивСопутствующихТоваровНаУдаление.Количество() > 0 Тогда 		
			Если СтруктураДействийПоСТ.ЗапрашиватьПодтверждениеПриУдаленииНоменклатуры Тогда
				ДопПараметры = Новый Структура("МассивСопутствующихТоваровНаУдаление", МассивСопутствующихТоваровНаУдаление);
				ПоказатьВопрос(Новый ОписаниеОповещения("ВопросУдалениеСопутствующейНоменклатуры", ЭтотОбъект, ДопПараметры), "Удалить сопутствующие товары и услуги для выбранных строк?", РежимДиалогаВопрос.ДаНет);			
			Иначе
				СопутствующиеТоварыКлиент.УдалитьСопутствующиеТоварыПоТаблице(ВыбраннаяНоменклатура, МассивСопутствующихТоваровНаУдаление);
				МассивСопутствующихТоваровНаУдаление.Очистить();
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура ВыбраннаяНоменклатураНоменклатураПриИзменении(Элемент)
	
	СтрокаТабличнойЧасти = Элементы.ВыбраннаяНоменклатура.ТекущиеДанные;
	
	Если СтрокаТабличнойЧасти = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СтруктураДанные = СтруктураДанныхПоСтрокеТабличнойЧасти(СтрокаТабличнойЧасти);
	СтруктураДанные = ПолучитьДанныеНоменклатурыПриИзменении(СтруктураДанные);
	ЗаполнитьЗначенияСвойств(СтрокаТабличнойЧасти, СтруктураДанные, "Цена");		
	СтрокаТабличнойЧасти.Сумма = СтрокаТабличнойЧасти.Цена * СтрокаТабличнойЧасти.Количество;
	
	//++ #16835
	Если НЕ мНоменклатура = СтрокаТабличнойЧасти.Номенклатура 
		И ИспользуетсяПодборСТ		
		И СтруктураДействийПоСТ.АвтоматическиДобавлятьСопутствующиеТоварыИУслуги Тогда
		
		МассивСопутствующихТоваровНаУдаление = Новый Массив;
		ВыбранныеСтроки = Элементы.ВыбраннаяНоменклатура.ВыделенныеСтроки;
		
		СопутствующиеТоварыКлиент.НайтиСвязанныеСтрокиПоСопуствующимТоварамПоТаблице(ВыбраннаяНоменклатура, ВыбранныеСтроки, СтрокаТабличнойЧасти.УИСтроки, МассивСопутствующихТоваровНаУдаление);
		
		Если МассивСопутствующихТоваровНаУдаление.Количество() > 0 Тогда 
			Если СтруктураДействийПоСТ.ЗапрашиватьПодтверждениеПриИзмененииНоменклатуры Тогда
				ДопПараметры = Новый Структура;
				ДопПараметры.Вставить("МассивСопутствующихТоваровНаУдаление", МассивСопутствующихТоваровНаУдаление);
				ДопПараметры.Вставить("СтрокаТабличнойЧасти", СтрокаТабличнойЧасти);
				ОписаниеОповещения = Новый ОписаниеОповещения("ДобавлениеСопутствующейНоменклатурыПриИзмененииНоменклатуры", ЭтотОбъект, ДопПараметры);
				ДопПараметры.Вставить("ОписаниеОповещения", ОписаниеОповещения);
				
				ОписаниеОповещения = Новый ОписаниеОповещения("ВопросУдалениеСопутствующейНоменклатуры", ЭтотОбъект, ДопПараметры);
				
				ТекстВопроса = СтрШаблон("Удалить сопутствующие товары и услуги %1 измененной номенклатуры ""%2""?", Символы.ПС, 
								СопутствующиеТоварыКлиентСервер.ПредставлениеНоменклатуры(мНоменклатура, мХарактеристика));
				ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет);							

			Иначе
				СопутствующиеТоварыКлиент.УдалитьСопутствующиеТоварыПоТаблице(ВыбраннаяНоменклатура, МассивСопутствующихТоваровНаУдаление);
				МассивСопутствующихТоваровНаУдаление.Очистить();
				
				НоменклатураПриИзмененииЗавершение(СтрокаТабличнойЧасти);
			КонецЕсли; 
		Иначе
			НоменклатураПриИзмененииЗавершение(СтрокаТабличнойЧасти);
		КонецЕсли;
				
	КонецЕсли;
	//-- #16835
	
КонецПроцедуры

&НаКлиенте
Процедура НоменклатураПриИзмененииЗавершение(СтрокаТабличнойЧасти)

	Если ИспользуетсяПодборСТ Тогда
		
		// если номенклатуру изменили, то отвязываем ее от "родителя"
		Если ЗначениеЗаполнено(СтрокаТабличнойЧасти.УИСтрокиРодителя) Тогда
			СтрокаТабличнойЧасти.УИСтроки = Строка(Новый УникальныйИдентификатор);
			СтрокаТабличнойЧасти.УИСтрокиРодителя = Неопределено;
		КонецЕсли;
		ДобавитьСопутствующиеТовары("Изменение", СтрокаТабличнойЧасти);
				
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыбраннаяНоменклатураХарактеристикаПриИзменении(Элемент)
	
	СтрокаТабличнойЧасти = Элементы.ВыбраннаяНоменклатура.ТекущиеДанные;
	
	Если СтрокаТабличнойЧасти = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СтруктураДанные = СтруктураДанныхПоСтрокеТабличнойЧасти(СтрокаТабличнойЧасти);
	СтруктураДанные = ПолучитьДанныеНоменклатурыПриИзменении(СтруктураДанные);
	ЗаполнитьЗначенияСвойств(СтрокаТабличнойЧасти, СтруктураДанные, "Цена");		
	СтрокаТабличнойЧасти.Сумма = СтрокаТабличнойЧасти.Цена * СтрокаТабличнойЧасти.Количество;
	
	//++ #16835
	Если НЕ мХарактеристика = СтрокаТабличнойЧасти.ХарактеристикаНоменклатуры 
		И ИспользуетсяПодборСТ		
		И СтруктураДействийПоСТ.АвтоматическиДобавлятьСопутствующиеТоварыИУслуги Тогда
		
		МассивСопутствующихТоваровНаУдаление = Новый Массив;
		ВыбранныеСтроки = Элементы.ВыбраннаяНоменклатура.ВыделенныеСтроки;
		
		СопутствующиеТоварыКлиент.НайтиСвязанныеСтрокиПоСопуствующимТоварамПоТаблице(ВыбраннаяНоменклатура, ВыбранныеСтроки, СтрокаТабличнойЧасти.УИСтроки, МассивСопутствующихТоваровНаУдаление);
		
		Если МассивСопутствующихТоваровНаУдаление.Количество() > 0 Тогда 
			Если СтруктураДействийПоСТ.ЗапрашиватьПодтверждениеПриИзмененииНоменклатуры Тогда
				ДопПараметры = Новый Структура;
				ДопПараметры.Вставить("МассивСопутствующихТоваровНаУдаление", МассивСопутствующихТоваровНаУдаление);
				ДопПараметры.Вставить("СтрокаТабличнойЧасти", СтрокаТабличнойЧасти);
				ОписаниеОповещения = Новый ОписаниеОповещения("ДобавлениеСопутствующейНоменклатурыПриИзмененииХарактеристики", ЭтотОбъект, ДопПараметры);
				ДопПараметры.Вставить("ОписаниеОповещения", ОписаниеОповещения);
				
				ОписаниеОповещения = Новый ОписаниеОповещения("ВопросУдалениеСопутствующейНоменклатуры", ЭтотОбъект, ДопПараметры);
				
				ТекстВопроса = СтрШаблон("Удалить сопутствующие товары и услуги %1 измененной номенклатуры ""%2""?", Символы.ПС, 
								СопутствующиеТоварыКлиентСервер.ПредставлениеНоменклатуры(СтрокаТабличнойЧасти.Номенклатура, мХарактеристика));
				ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет);							

			Иначе
				СопутствующиеТоварыКлиент.УдалитьСопутствующиеТоварыПоТаблице(ВыбраннаяНоменклатура, МассивСопутствующихТоваровНаУдаление);
				МассивСопутствующихТоваровНаУдаление.Очистить();
				
				ХарактеристикаПриИзмененииЗавершение(СтрокаТабличнойЧасти);
			КонецЕсли; 
		Иначе
			ХарактеристикаПриИзмененииЗавершение(СтрокаТабличнойЧасти);
		КонецЕсли;
				
	КонецЕсли;
	//-- #16835
	
КонецПроцедуры

&НаКлиенте
Процедура ХарактеристикаПриИзмененииЗавершение(СтрокаТабличнойЧасти)

	Если ИспользуетсяПодборСТ Тогда
		
		// если характеристику изменили, то отвязываем ее от "родителя"
		Если ЗначениеЗаполнено(СтрокаТабличнойЧасти.УИСтрокиРодителя) Тогда
			СтрокаТабличнойЧасти.УИСтроки = Строка(Новый УникальныйИдентификатор);
			СтрокаТабличнойЧасти.УИСтрокиРодителя = Неопределено;
		КонецЕсли;
		ДобавитьСопутствующиеТовары("Изменение", СтрокаТабличнойЧасти);
				
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыбраннаяНоменклатураКоличествоПриИзменении(Элемент)
	
	ОчиститьСообщения();
	СтрокаТабличнойЧасти = Элементы.ВыбраннаяНоменклатура.ТекущиеДанные;
	
	//#2792
	Если ЗначениеЗаполнено(ВидДокументаПроверкиКратности) Тогда
		СтруктураДанные = СтруктураДанныхПоСтрокеТабличнойЧасти(СтрокаТабличнойЧасти);
		ОтказВИзмененииКоличества = Ложь;
		КоличествоПриИзмененииНаСервере(СтруктураДанные, ОтказВИзмененииКоличества);
		Если ОтказВИзмененииКоличества Тогда
			СтрокаТабличнойЧасти.Количество = 0;
		КонецЕсли;
	КонецЕсли;
	
	ПослеИзмененияКоличестваТоваров(СтрокаТабличнойЧасти);
	
	//++ #16835
	Если НЕ мКоличество = СтрокаТабличнойЧасти.Количество 
		И ИспользуетсяПодборСТ		
		И СтруктураДействийПоСТ.АвтоматическиДобавлятьСопутствующиеТоварыИУслуги Тогда
		
		МассивСопутствующихТоваров = Новый Массив;
		ВыбранныеСтроки = Элементы.ВыбраннаяНоменклатура.ВыделенныеСтроки;
		
		СопутствующиеТоварыКлиент.НайтиСвязанныеСтрокиПоСопуствующимТоварамПоТаблице(ВыбраннаяНоменклатура, ВыбранныеСтроки, СтрокаТабличнойЧасти.УИСтроки, МассивСопутствующихТоваров);
		
		КоличествоСопутствующихТоваровВРегистре = ОбщийМодульВызовСервера.ЕстьСопутствующаяНоменклатураВРегистре(СтрокаТабличнойЧасти.Номенклатура, СтрокаТабличнойЧасти.ХарактеристикаНоменклатуры, Истина);
		
		ТребуетсяДополнить = ?(МассивСопутствующихТоваров.Количество() < КоличествоСопутствующихТоваровВРегистре, Истина, Ложь);
		
		Если МассивСопутствующихТоваров.Количество() > 0 Тогда
			// если есть сопутствующие товары
			Если СтруктураДействийПоСТ.ЗапрашиватьПодтверждениеПриИзмененииКоличества Тогда
				ДопПараметры = Новый Структура;
				ДопПараметры.Вставить("Номенклатура", 					СтрокаТабличнойЧасти.Номенклатура); 
				ДопПараметры.Вставить("ХарактеристикаНоменклатуры", 	СтрокаТабличнойЧасти.ХарактеристикаНоменклатуры); 
				ДопПараметры.Вставить("УИСтроки", 						СтрокаТабличнойЧасти.УИСтроки); 
				ДопПараметры.Вставить("Количество", 					СтрокаТабличнойЧасти.Количество); 
				
				ДопПараметры.Вставить("ТребуетсяДополнить", ТребуетсяДополнить);
				
				ОписаниеОповещения = Новый ОписаниеОповещения("ВопросИзменениеКоличестваСопутствующейНоменклатуры", ЭтотОбъект, ДопПараметры);
				
				ТекстВопроса = СтрШаблон("Изменить количество сопутствующих товаров и услуг %1 для номенклатуры ""%2""?", Символы.ПС, 
								СопутствующиеТоварыКлиентСервер.ПредставлениеНоменклатуры(СтрокаТабличнойЧасти.Номенклатура, СтрокаТабличнойЧасти.ХарактеристикаНоменклатуры));
								
				ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
			Иначе
				Если ТребуетсяДополнить Тогда
					ДобавитьСопутствующиеТовары("Добавление", СтрокаТабличнойЧасти, Истина);
				КонецЕсли;	
				// Изменяем количество сопутсвующей номенклатуры с дополнением отсутствующей
				ИзмененныеСтроки = СопутствующиеТоварыКлиент.ИзменитьКоличествоСопутствущихТоваровПоТаблице(ВыбраннаяНоменклатура, СтрокаТабличнойЧасти.Номенклатура, СтрокаТабличнойЧасти.ХарактеристикаНоменклатуры, СтрокаТабличнойЧасти.Количество, СтрокаТабличнойЧасти.УИСтроки);
				Для каждого СтрокаТовара Из ИзмененныеСтроки Цикл
					ПослеИзмененияКоличестваТоваров(СтрокаТовара);
				КонецЦикла;	
			КонецЕсли;
		Иначе
			Если ОбщийМодульВызовСервера.ЕстьСопутствующаяНоменклатураВРегистре(СтрокаТабличнойЧасти.Номенклатура, СтрокаТабличнойЧасти.ХарактеристикаНоменклатуры) Тогда
				ДобавитьСопутствующиеТовары("Добавление", СтрокаТабличнойЧасти, Истина);				
			КонецЕсли;	
		КонецЕсли;
	
	КонецЕсли;
	//-- #16835
	
КонецПроцедуры

&НаСервере
Процедура КоличествоПриИзмененииНаСервере(СтруктураДанные, ОтказВИзмененииКоличества)
		
	ОбщийМодульСервер.ПроверитьКратностьЕдиницИзмерения(ОтказВИзмененииКоличества, СтруктураДанные, ВидДокументаПроверкиКратности);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеИзмененияКоличестваТоваров(СтрокаТабличнойЧасти)
	
	СтрокаТабличнойЧасти.Сумма = СтрокаТабличнойЧасти.Количество * СтрокаТабличнойЧасти.Цена;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыбраннаяНоменклатураЦенаПриИзменении(Элемент)
	ТекущиеДанные = Элементы.ВыбраннаяНоменклатура.ТекущиеДанные;
	ТекущиеДанные.Сумма = ТекущиеДанные.Количество * ТекущиеДанные.Цена;
КонецПроцедуры

&НаКлиенте
Процедура ВыбраннаяНоменклатураСуммаПриИзменении(Элемент)
	ТекущиеДанные = Элементы.ВыбраннаяНоменклатура.ТекущиеДанные;
	Если НЕ ТекущиеДанные.Количество = 0 Тогда
		ТекущиеДанные.Цена = ТекущиеДанные.Сумма / ТекущиеДанные.Количество;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ГруппаАналоговНоменклатуры

&НаКлиенте
Процедура СписокАналоговВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
		
	ТекущиеДанные = Элемент.ТекущиеДанные;
	
	Если ЭтоГруппа(ТекущиеДанные.НоменклатураСсылка) Тогда
		Возврат;
	Иначе
		СтандартнаяОбработка = Ложь;
	КонецЕсли;
	
	Если ПодборТиповых Тогда
		ДобавитьОтрезВКорзину(ТекущиеДанные);
	Иначе	
		Если ТекущиеДанные.ИмеютсяХарактеристики Тогда
			ПерейтиКСпискуХарактеристикНоменклатуры(ТекущиеДанные.НоменклатураСсылка, Истина);
		Иначе
			ДобавитьНоменклатуруВКорзину(ТекущиеДанные);
		КонецЕсли;
	КонецЕсли;	
	
КонецПроцедуры

&НаСервере
Процедура УстановитьОтборПоАналогам(НоменклатураСсылка)

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	АналогиНоменклатуры.Аналог КАК Номенклатура
	|ИЗ
	|	РегистрСведений.АналогиНоменклатуры КАК АналогиНоменклатуры
	|ГДЕ
	|	АналогиНоменклатуры.Номенклатура = &Номенклатура
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	АналогиНоменклатуры.Номенклатура
	|ИЗ
	|	РегистрСведений.АналогиНоменклатуры КАК АналогиНоменклатуры
	|ГДЕ
	|	АналогиНоменклатуры.Аналог = &Номенклатура";
	
	Запрос.УстановитьПараметр("Номенклатура", НоменклатураСсылка);
	МассивНоменклатуры = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Номенклатура");;
	
	СписокАналогов.Параметры.УстановитьЗначениеПараметра("НоменклатураРодительАналога", НоменклатураСсылка);
	
	// фильтр удаляем/добавляем, поскольку УстановитьЭлементОтбораДинамическогоСписка затирает другие наложенные фильтры по НоменклатураСсылка (например отбор по разрешенной в рознице)
	// при удалении не передаем ИмяПоля, поиск только по наименованию отбора, иначе тоже затирает
	ОбластьОтбора = СписокАналогов.КомпоновщикНастроек.ФиксированныеНастройки.Отбор;
	ОбщегоНазначенияКлиентСервер.УдалитьЭлементыГруппыОтбораДинамическогоСписка(СписокАналогов, , "ОтборПоАналогам");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ОбластьОтбора, "НоменклатураСсылка", ВидСравненияКомпоновкиДанных.ВСписке, МассивНоменклатуры, "ОтборПоАналогам", Истина, РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный);
	
КонецПроцедуры

&НаКлиенте
Процедура СписокХарактеристикАналоговВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	ТекущиеДанные = Элемент.ТекущиеДанные;
	ДобавитьНоменклатуруВКорзину(ТекущиеДанные, Истина);
КонецПроцедуры

&НаСервереБезКонтекста
Процедура СписокХарактеристикПриПолученииДанныхНаСервере(ИмяЭлемента, Настройки, Строки)
	
	// №6193
	Для Каждого ТекущаяСтрока Из Строки Цикл
		ТекущаяСтрока.Значение.Данные["КоличествоДоступно"] = ТекущаяСтрока.Значение.Данные["Количество"] - Макс(ТекущаяСтрока.Значение.Данные["КоличествоВРезерве"], 0);
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область Прочее

#КонецОбласти

#Область СопутствующиеТовары
// #16835

&НаКлиенте
Процедура ВопросДобавлениеСопутствующейНоменклатуры(РезультатВопроса, ДополнительныеПараметры) Экспорт	
	
	Если НЕ РезультатВопроса = КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	МассивДобавленнойСП = ДобавитьСопутствующуюНоменклатуру(ДополнительныеПараметры.Номенклатура, ДополнительныеПараметры.ХарактеристикаНоменклатуры, 
															ДополнительныеПараметры.Количество, ДополнительныеПараметры.УИСтроки, 0);
	
КонецПроцедуры

&НаКлиенте
Функция ДобавитьСопутствующуюНоменклатуру(Номенклатура, 
										  Характеристика = Неопределено,										   
										  Количество = 1,
										  УИСтрокиРодителя,
										  Уровень, 
										  МассивДобавленнойСП = Неопределено)
	
	Если МассивДобавленнойСП = Неопределено Тогда
		МассивДобавленнойСП = Новый Массив;
	КонецЕсли;
	
	Если Уровень < СтруктураДействийПоСТ.ДопустимаяГлубинаВложенностиСопутствующихТоваров Тогда
		МассивЗаписей = ОбщийМодульВызовСервера.ПолучитьСписокСопутствующихТоваров(Номенклатура, Характеристика, Количество);
		Для Каждого Запись из МассивЗаписей Цикл
			ВозвращеннаяСтрока = ДобавитьСопутствующуюНоменклатуруВКорзину(Запись, УИСтрокиРодителя);
			Если ВозвращеннаяСтрока.Новая  Тогда
				ДобавленнаяСтрока = ВозвращеннаяСтрока.Строка;
				МассивДобавленнойСП.Добавить(ДобавленнаяСтрока);
				ДобавитьСопутствующуюНоменклатуру(ДобавленнаяСтрока.Номенклатура, ДобавленнаяСтрока.ХарактеристикаНоменклатуры, ДобавленнаяСтрока.Количество, 
												  ДобавленнаяСтрока.УИСтроки, Уровень+1, МассивДобавленнойСП);
			Иначе
				СуществующаяСтрока = ВозвращеннаяСтрока.Строка;
				ДобавитьСопутствующуюНоменклатуру(СуществующаяСтрока.Номенклатура, СуществующаяСтрока.ХарактеристикаНоменклатуры, СуществующаяСтрока.Количество, 
												  СуществующаяСтрока.УИСТроки, Уровень+1, МассивДобавленнойСП);
			КонецЕсли;		
		КонецЦикла;		
	КонецЕсли;
	Возврат МассивДобавленнойСП;
	
КонецФункции

&НаКлиенте
Функция ДобавитьСопутствующуюНоменклатуруВКорзину(ДанныеСтроки, УИСтрокиРодителя)

	ВозвращаемСтроку = Новый Структура;
	
	// Проверяем наличие сопуствующей номенклатуры, чтобы не добавить дубликат или чтобы не затереть параметры номенклатуры
	Для каждого СтрокаТЗ Из ВыбраннаяНоменклатура Цикл 
		Если СтрокаТЗ.Номенклатура = ДанныеСтроки.Номенклатура 
			И СтрокаТЗ.ХарактеристикаНоменклатуры = ДанныеСтроки.Характеристика 
			И СтрокаТЗ.ЕдиницаИзмерения = ДанныеСтроки.ЕдиницаИзмерения
			И СтрокаТЗ.УИСтрокиРодителя = УИСтрокиРодителя Тогда
			ВозвращаемСтроку.Вставить("Строка", СтрокаТЗ);
			ВозвращаемСтроку.Вставить("Новая", Ложь);
			Возврат ВозвращаемСтроку;
		КонецЕсли;	
	КонецЦикла;
	
	СтрокаТабличнойЧасти = ВыбраннаяНоменклатура.Добавить();
	СтрокаТабличнойЧасти.Номенклатура = ДанныеСтроки.Номенклатура;
	СтрокаТабличнойЧасти.ХарактеристикаНоменклатуры = ДанныеСтроки.Характеристика;
	СтрокаТабличнойЧасти.ЕдиницаИзмерения = ДанныеСтроки.ЕдиницаИзмерения;
	СтрокаТабличнойЧасти.Коэффициент = ДанныеСтроки.Коэффициент;
	
	СтрокаТабличнойЧасти.УИСтроки = Строка(Новый УникальныйИдентификатор);
	СтрокаТабличнойЧасти.УИСтрокиРодителя = УИСтрокиРодителя;
	СтрокаТабличнойЧасти.Количество = ДанныеСтроки.Количество;
	
	СтруктураДанные = СтруктураДанныхПоСтрокеТабличнойЧасти(СтрокаТабличнойЧасти);

	//СтруктураДанные = ОбщийМодульВызовСервера.ПолучитьДанныеНоменклатурыПриИзменении(СтруктураДанные);	
	//ЗаполнитьЗначенияСвойств(СтрокаТабличнойЧасти, СтруктураДанные, "ЕдиницаИзмерения, Коэффициент, Количество, ВидНоменклатуры, Спецификация, УчитыватьКакПотолок");
	
	СтруктураДанные = ПолучитьДанныеНоменклатурыПриИзменении(СтруктураДанные);
	ЗаполнитьЗначенияСвойств(СтрокаТабличнойЧасти, СтруктураДанные, "Цена"); 
		
	СтрокаТабличнойЧасти.Сумма = СтрокаТабличнойЧасти.Цена * СтрокаТабличнойЧасти.Количество;
	
	ВозвращаемСтроку.Вставить("Строка", СтрокаТабличнойЧасти);
	ВозвращаемСтроку.Вставить("Новая", Истина);
	
	Возврат ВозвращаемСтроку;

КонецФункции

