&НаКлиенте
Процедура ДобавитьСопутствующиеТовары(ОписаниеДействия, СтрокаТабличнойЧасти, БезПроверкиУсловий = Ложь)
	
	Если НЕ ИспользуетсяПодборСТ Тогда
		Возврат;	
	КонецЕсли;
	
	ЗапрашиватьПодтверждение = Неопределено;
	Если ОписаниеДействия = "Добавление" Тогда
		ЗапрашиватьПодтверждение = СтруктураДействийПоСТ.ЗапрашиватьПодтверждениеПриДобавленииНоменклатуры;
		
	ИначеЕсли ОписаниеДействия = "Изменение" Тогда 
		ЗапрашиватьПодтверждение = СтруктураДействийПоСТ.ЗапрашиватьПодтверждениеПриИзмененииНоменклатуры;
		
	КонецЕсли;
	
	Если БезПроверкиУсловий
		ИЛИ (СтруктураДействийПоСТ.АвтоматическиДобавлятьСопутствующиеТоварыИУслуги
		     И ОбщийМодульВызовСервера.ЕстьСопутствующаяНоменклатураВРегистре(СтрокаТабличнойЧасти.Номенклатура, СтрокаТабличнойЧасти.ХарактеристикаНоменклатуры)) Тогда
		
		Если ЗапрашиватьПодтверждение Тогда
			ДопПараметры = Новый Структура;
			ДопПараметры.Вставить("Номенклатура", СтрокаТабличнойЧасти.Номенклатура); 
			ДопПараметры.Вставить("ХарактеристикаНоменклатуры", СтрокаТабличнойЧасти.ХарактеристикаНоменклатуры); 
			ДопПараметры.Вставить("УИСтроки", СтрокаТабличнойЧасти.УИСтроки); 
			ДопПараметры.Вставить("Количество", СтрокаТабличнойЧасти.Количество); 
			
			ОписаниеОповещения = Новый ОписаниеОповещения("ВопросДобавлениеСопутствующейНоменклатуры", ЭтотОбъект, ДопПараметры);
			ТекстВопроса = СтрШаблон("Добавить сопутствующие товары и услуги %1 для номенклатуры: ""%2""?", 
									  Символы.ПС, СопутствующиеТоварыКлиентСервер.ПредставлениеНоменклатуры(СтрокаТабличнойЧасти.Номенклатура, СтрокаТабличнойЧасти.ХарактеристикаНоменклатуры));
			ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
		Иначе
			МассивДобавленнойСП = ДобавитьСопутствующуюНоменклатуру(СтрокаТабличнойЧасти.Номенклатура, СтрокаТабличнойЧасти.ХарактеристикаНоменклатуры, СтрокаТабличнойЧасти.Количество, СтрокаТабличнойЧасти.УИСтроки, 0);										  
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВопросИзменениеКоличестваСопутствующейНоменклатуры(РезультатВопроса, ДополнительныеПараметры) Экспорт	
	
	// Если не нужно изменять количество сопутствующей номенклатуры и не требуется дополнять недостающую номенклатуру
	Если НЕ РезультатВопроса = КодВозвратаДиалога.Да 
		И НЕ ДополнительныеПараметры.ТребуетсяДополнить Тогда
		Возврат;
	КонецЕсли;
	
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		ИзмененныеСтроки = СопутствующиеТоварыКлиент.ИзменитьКоличествоСопутствущихТоваровПоТаблице(ВыбраннаяНоменклатура, 
														ДополнительныеПараметры.Номенклатура, ДополнительныеПараметры.ХарактеристикаНоменклатуры, 
														ДополнительныеПараметры.Количество, ДополнительныеПараметры.УИСтроки);
		Для каждого СтрокаТовара Из ИзмененныеСтроки Цикл
			ПослеИзмененияКоличестваТоваров(СтрокаТовара);
		КонецЦикла;	
	КонецЕсли;
	
	Если ДополнительныеПараметры.ТребуетсяДополнить Тогда
		ОписаниеОповещения = Новый ОписаниеОповещения("ВопросДобавлениеНедостающейСопутствующейНоменклатуры", ЭтотОбъект, ДополнительныеПараметры);
		ТекстВопроса = СтрШаблон("Добавить недостающие сопутствующие товары и услуги %1 для номенклатуры: ""%2""?", 
									  Символы.ПС, СопутствующиеТоварыКлиентСервер.ПредставлениеНоменклатуры(ДополнительныеПараметры.Номенклатура, ДополнительныеПараметры.ХарактеристикаНоменклатуры));
		ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	КонецЕсли;
	
КонецПроцедуры

