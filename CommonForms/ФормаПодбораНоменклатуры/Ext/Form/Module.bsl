&НаКлиенте
Перем мНоменклатура, мХарактеристика, мКоличество;

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	КодФормы = "ФормаПодбораНоменклатуры";
	УстановитьЗначенияПоНастройкамФормы();
	
	Организация = Параметры.Организация;
	ОрганизацияЦены = Параметры.Организация;
	Склад = Параметры.Склад;
	//ВидЦены = Параметры.ВидЦены;	
	
	//#15122
	ДатаЦен = КонецДня(ТекущаяДатаСеанса());
	Если Параметры.Свойство("Дата") И ЗначениеЗаполнено(Параметры.Дата) Тогда
		ДатаЦен = КонецДня(Параметры.Дата);
	КонецЕсли;
	
	ВидЦены = Параметры.ВидЦены;
	Если ВидЦены.Пустая() Тогда
		ВидЦены = ПолучитьОсновнойТипЦенПродажи();
	КонецЕсли;
	
	ВидЦеныПоставщика = Параметры.ВидЦеныПоставщика;
	Если ВидЦеныПоставщика.Пустая() Тогда
		ВидЦеныПоставщика = Справочники.ВидыЦенПоставщиков.ПустаяСсылка();
	КонецЕсли;
	
	Валюта = Параметры.Валюта;
	Если Валюта.Пустая() Тогда
		Валюта = Константы.ВалютаУчета.Получить();
	КонецЕсли;
	
	Подразделение = Параметры.Подразделение;
	
	Поставщик = Параметры.Поставщик;
	ИспользоватьЦеныПоставщиков = Параметры.ИспользоватьЦеныПоставщиков;
	
	Если Константы.ОбщиеСклады.Получить() Тогда
		Организация = Неопределено;
		Элементы.Организация.Доступность = Ложь;
	КонецЕсли;
	
	// определяется настройкой пользователя или параметром вызова формы	
	Если НЕ ТолькоВНаличии Тогда // если выше не было получено значение из настроек пользователя
		ТолькоВНаличии = Параметры.ТолькоВНаличии; //#12555
	КонецЕсли;
	ТолькоВНаличииПриИзмененииНаСервере();
	
	МассивВидовНоменклатур = новый Массив;
	ОтборПоВидуНоменклатуры = Ложь;
	Если ТипЗнч(Параметры.ВидНоменклатуры) = Тип("СписокЗначений") Тогда
		Если Параметры.ВидНоменклатуры.Количество() > 0 Тогда
			ОтборПоВидуНоменклатуры = Истина;
			МассивВидовНоменклатур = Параметры.ВидНоменклатуры.ВыгрузитьЗначения();
		КонецЕсли;
	КонецЕсли;
	Элементы.ДекорацияОтборПоВидамНоменклатуры.Видимость = ОтборПоВидуНоменклатуры;
	Элементы.ДекорацияОтборПоВидамНоменклатуры.Заголовок = "Отбор по видам номенклатуры: " + СтрСоединить(МассивВидовНоменклатур, ",");	
	
	Контрагент = Параметры.Контрагент;
	ДоговорКонтрагента = Параметры.ДоговорКонтрагента;
		
	ВАльтернативнойЕдиницеИзмерения = Параметры.ВАльтернативнойЕдиницеИзмерения;
	Элементы.ДекорацияОстаткиВАльтернативнойЕдиницеИзмерения.Видимость = ВАльтернативнойЕдиницеИзмерения;
	
	УстановитьЗначенияПараметровСпискаНоменклатуры(СписокНоменклатуры, МассивВидовНоменклатур);
	УстановитьЗначенияПараметровСпискаНоменклатуры(СписокАналогов, МассивВидовНоменклатур);
	
		
	УстановитьЗначенияПараметровСпискаХарактеристик(СписокХарактеристик);
	УстановитьЗначенияПараметровСпискаХарактеристик(СписокХарактеристикАналогов);
	
	//++ №12232 не даем выбрать "Типовой отрез"
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(СписокНоменклатуры
		, "ВидНоменклатуры"
		, Справочники.ВидыНоменклатуры.ТиповойОтрез
		, ВидСравненияКомпоновкиДанных.НеРавно
		,
		, Истина);
		
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(СписокАналогов
		, "ВидНоменклатуры"
		, Справочники.ВидыНоменклатуры.ТиповойОтрез
		, ВидСравненияКомпоновкиДанных.НеРавно
		,
		, Истина);
	//-- №12232

	Элементы.СписокНоменклатурыЦена.Заголовок = "Цена, " + Валюта.Наименование;
	
	ЗапрашиватьЦену = НЕ Параметры.НеЗапрашиватьЦену;
	ЗапрашиватьКоличество = НЕ Параметры.НеЗапрашиватьКоличество;
	ЗапретРедактированияЦен = Параметры.ЗапретРедактированияЦен;
	
	ПодборТиповых = Параметры.ПодборТиповых;
	
	Параметры.Свойство("ТипДокумента", ТипДокумента);
	
	Если Параметры.Свойство("ТипДокумента") И Параметры.Свойство("Назначение") Тогда
		
		Если Параметры.ТипДокумента = "ЗаказДоговор"
			И Параметры.Назначение = "Товары"
			И ПолучитьФункциональнуюОпцию("ОграничитьВыборТоваровВЗаказДоговор")
		Тогда
					
			РегистрыСведений.РазрешеннаяНоменклатураРозницы.УстановитьОтбор(1, СписокНоменклатуры, "НоменклатураСсылка");	
			РегистрыСведений.РазрешеннаяНоменклатураРозницы.УстановитьОтбор(1, СписокАналогов, "НоменклатураСсылка");
			
			////++ №11160
			//Если ПолучитьФункциональнуюОпцию("ВариантОтображенияСпискаТоваровПриОграниченииВЗаказДоговоре") = Перечисления.ВариантОтображенияСпискаПриОграничении.ВВидеСпискаБезИерархии Тогда
			//	ВыводитьСписокБезИерархии = Истина;
			//КонецЕсли;
			РегистрыСведений.РазрешеннаяНоменклатураРозницы.УстановитьУсловноеОформлениеНедоступныеГруппы(1, СписокНоменклатуры, "НоменклатураСсылка");
			РегистрыСведений.РазрешеннаяНоменклатураРозницы.УстановитьУсловноеОформлениеНедоступныеГруппы(1, СписокАналогов, "НоменклатураСсылка");
			////-- №11160
			
		ИначеЕсли (Параметры.ТипДокумента = "ЗаказДоговор"
				Или Параметры.ТипДокумента = "Монтаж") // №11160
			И Параметры.Назначение = "Материалы"
			И ПолучитьФункциональнуюОпцию("ОграничитьВыборМатериаловВЗаказДоговор")
		Тогда
				
			РегистрыСведений.РазрешеннаяНоменклатураРозницы.УстановитьОтбор(2, СписокНоменклатуры, "НоменклатураСсылка");
			РегистрыСведений.РазрешеннаяНоменклатураРозницы.УстановитьОтбор(2, СписокАналогов, "НоменклатураСсылка");
			
			//++ №11160
			//Если ПолучитьФункциональнуюОпцию("ВариантОтображенияСпискаМатериаловПриОграниченииВЗаказДоговоре") = Перечисления.ВариантОтображенияСпискаПриОграничении.ВВидеСпискаБезИерархии Тогда
			//	
			//	ВыводитьСписокБезИерархии = Истина;
			//	
			//ИначеЕсли ПолучитьФункциональнуюОпцию("ВариантОтображенияСпискаМатериаловПриОграниченииВЗаказДоговоре") = Перечисления.ВариантОтображенияСпискаПриОграничении.ИерархияТолькоДоступныхПапок Тогда
			//	
			//	
			//	РегистрыСведений.РазрешеннаяНоменклатураРозницы.УстановитьУсловноеОформлениеНедоступныеГруппы(2, Список);
			//	
			//КонецЕсли;
			
			РегистрыСведений.РазрешеннаяНоменклатураРозницы.УстановитьУсловноеОформлениеНедоступныеГруппы(2, СписокНоменклатуры, "НоменклатураСсылка");
			РегистрыСведений.РазрешеннаяНоменклатураРозницы.УстановитьУсловноеОформлениеНедоступныеГруппы(2, СписокАналогов, "НоменклатураСсылка");
			
			//-- №11160
				
		КонецЕсли;
			
	КонецЕсли;
	
	//#2792
	ВидДокументаПроверкиКратности = Параметры.ВидДокументаПроверкиКратности;
	
	Элементы.ПоказыватьАналоги.Пометка = ПоказыватьАналоги;
	Элементы.ГруппаАналоги.Видимость = ПоказыватьАналоги;
	
	Элементы.ВыбраннаяНоменклатураЦена.ТолькоПросмотр  = ЗапретРедактированияЦен;
	Элементы.ВыбраннаяНоменклатураСумма.ТолькоПросмотр = ЗапретРедактированияЦен;
	
	// №6193
	ИспользуетсяРезервирование = Константы.ИспользоватьРезервирование.Получить();
	
	//++ №6744
	УстановитьОтборАрхивнаяНоменклатура(ЭтотОбъект);
	УстановитьОтборАрхивнаяХарактеристика(ЭтотОбъект);
	//-- №6744
	
	МассивЭлементов = Новый Массив;
	МассивЭлементов.Добавить("ВыбраннаяНоменклатураСтатьяДоходов");
	МассивЭлементов.Добавить("ВыбраннаяНоменклатураСтатьяРасходов");
	ФинансыСервер.УстановитьВидимостьКолонокСтатейДиРВТабличнойЧасти(ЭтаФорма, МассивЭлементов);
	
	// №14840
	Параметры.Свойство("ПредлагатьСопутствующиеТоварыПриПодборе", ПредлагатьСопутствующиеТоварыПриПодборе);
	
	//#16835 
	Если ТипДокумента = "ЗаказДоговор" ИЛИ ТипДокумента = "ПредварительныйРасчет" Тогда
		ПодборВРозницу = Истина;
		ИспользуетсяПодборСТ = Истина;
		СтруктураДействийПоСТ = СопутствующиеТоварыСервер.СтруктураДействийПоСопутствующимТоварамВРознице();	
	КонецЕсли;
	//nva+++
	НачалоПериода = ДобавитьМесяц(НачалоДня(ТекущаяДата())-60*60*24,- 3);
	КонецПериода = КонецДня(ТекущаяДата()) - 60*60*24;
	НачалоПериодаПоследнийМесяц = НачалоМесяца(КонецПериода);
	НачалоПериодаПоследнийМесяц_1 = ДобавитьМесяц(НачалоПериодаПоследнийМесяц,-1);
	НачалоПериодаПоследнийМесяц_2 = ДобавитьМесяц(НачалоПериодаПоследнийМесяц_1,-1);
	НачалоПериодаПоследнийМесяц_3 = ДобавитьМесяц(НачалоПериодаПоследнийМесяц_2,-1);
	ГоризонтПланирования = КонецДня(ДобавитьМесяц(ТекущаяДата(),1));
	//nva---
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ОбновитьПараметрыЗапроса();
	ОбновитьЭлементыФормы();
	
	ОбновитьВидимостьГруппыПредпросмотрИзображения(); // №9160
	
	//++ №11160
	Если ВыводитьСписокБезИерархии Тогда
		
		Элементы.СписокНоменклатуры.Отображение = ОтображениеТаблицы.Список;
		Элементы.СписокНоменклатурыРежимПросмотра.Видимость = Ложь;
		Элементы.СписокНоменклатурыКонтекстноеМенюРежимПросмотра.Видимость = Ложь;
		Элементы.СписокНоменклатурыИерархическийСписок.Видимость = Ложь;
		Элементы.СписокНоменклатурыСписок.Видимость = Ложь;
		Элементы.СписокАналоговКонтекстноеМенюРежимПросмотра.Видимость = Ложь;
		
	КонецЕсли;
	//-- №11160
	
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)
	
	СохранитьНастройкиФормыНаСервере();
	Если ПеренестиВДокумент И НЕ ЭтаФорма.ВладелецФормы = Неопределено Тогда
		АдресВХранилище = ЗаписатьПодборВХранилище(ЭтаФорма.ВладелецФормы.УникальныйИдентификатор);
	Иначе
		АдресВХранилище = Неопределено;
	КонецЕсли;
	
	Если АдресВХранилище <> Неопределено Тогда
		Структура = Новый Структура("АдресВХранилище", АдресВХранилище);
		ОповеститьОВыборе(Структура);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	
	// №14840
	Если ИсточникВыбора.ИмяФормы = "РегистрСведений.СопутствующиеТоварыИУслуги.Форма.ФормаПодбора" Тогда
		ОбработкаПодбораСопутствующихТоваров(ВыбранноеЗначение);
	КонецЕсли;
	
КонецПроцедуры
	
#КонецОбласти 

#Область ОбработчикиЭлементовФормы
&НаКлиенте
Процедура ОрганизацияПриИзменении(Элемент)
	ОбновитьПараметрыЗапроса()
КонецПроцедуры

&НаКлиенте
Процедура СкладПриИзменении(Элемент)
	ОбновитьПараметрыЗапроса()
КонецПроцедуры

&НаКлиенте
Процедура ТолькоВНаличииПриИзменении(Элемент)
	
	ТолькоВНаличииПриИзмененииНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ТолькоВНаличииПриИзмененииНаСервере()
	
	// Для списка номенклатуры
	СписокНоменклатуры.Параметры.УстановитьЗначениеПараметра("ТолькоВНаличии", ТолькоВНаличии);
		
	// Для списка характеристик	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(
		СписокХарактеристик.Отбор,
		"Количество", 0, ВидСравненияКомпоновкиДанных.Больше,,ТолькоВНаличии);
		
	// Для списка аналогов номенклатуры
	СписокАналогов.Параметры.УстановитьЗначениеПараметра("ТолькоВНаличии", ТолькоВНаличии);
	
	// Для списка характеристик	аналогов
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(
		СписокХарактеристикАналогов.Отбор,
		"Количество", 0, ВидСравненияКомпоновкиДанных.Больше,,ТолькоВНаличии);
	
КонецПроцедуры

#КонецОбласти 

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ДобавитьВКорзину(Команда)
	
	ТекущиеДанные = Элементы.СписокНоменклатуры.ТекущиеДанные;
	
	Если ЭтоГруппа(ТекущиеДанные.НоменклатураСсылка) Тогда
		Возврат;
	Иначе
		СтандартнаяОбработка = Ложь;
	КонецЕсли;
		
	ДобавитьНоменклатуруВКорзину(ТекущиеДанные);
		
КонецПроцедуры

&НаКлиенте
Процедура ПеренестиВДокумент(Команда)
		
	ПеренестиВДокумент = Истина;
	Закрыть(ВыбраннаяНоменклатура);  //Закрыть(КодВозвратаДиалога.OK); если будет убрано модальной открытие 
	
КонецПроцедуры

&НаКлиенте
Процедура НавигацияСписковНоменклатураХарактеристики(Команда)
	Если Элементы.СтраницыНоменклатураХарактеристики.ТекущаяСтраница = Элементы.СтраницаНоменклатура Тогда		
		ДанныеТекущейСтроки = Элементы.СписокНоменклатуры.ТекущиеДанные;
		Если НЕ ДанныеТекущейСтроки = Неопределено Тогда
			Если ДанныеТекущейСтроки.ИмеютсяХарактеристики Тогда		
				ПерейтиКСпискуХарактеристикНоменклатуры(ДанныеТекущейСтроки.НоменклатураСсылка);			
			КонецЕсли;	
		КонецЕсли;	
	Иначе		
		ПерейтиКСпискуНоменклатуры();		
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ВернутьсяКСпискуНоменклатуры(Команда)
	ПерейтиКСпискуНоменклатуры();
КонецПроцедуры

&НаКлиенте
Процедура ВернутьсяКСпискуАналогов(Команда)
	Элементы.СтраницыАналогов.ТекущаяСтраница = Элементы.СтраницаАналогиНоменклатура;
КонецПроцедуры

&НаКлиенте
Процедура ПоказыватьАналоги(Команда)
	
	ПоказыватьАналоги = НЕ ПоказыватьАналоги;
	Элементы.ПоказыватьАналоги.Пометка = ПоказыватьАналоги;
	Элементы.ГруппаАналоги.Видимость = ПоказыватьАналоги;
	
	ПодключитьОбработчикОжидания("ПодборТаблицаПриАктивизацииСтрокиОбработчикОжидания", 0.1, Истина);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция НастройкиФормыПодбора()
	
	НастройкиФормы = Новый Структура;	
	НастройкиФормы.Вставить("ПоказыватьАналоги", ПоказыватьАналоги);
	НастройкиФормы.Вставить("ТолькоВНаличии", ТолькоВНаличии); // #14376
	
	Возврат НастройкиФормы;
	
КонецФункции

&НаСервере
Процедура УстановитьЗначенияПоНастройкамФормы();
	// Если есть сохраненные настройки, то установить значения по настройкам.
	Настройки = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить(КодФормы,  "");
	
	Если Настройки <> Неопределено Тогда
		
		Если Настройки.Свойство("ПоказыватьАналоги") Тогда
			ПоказыватьАналоги = Настройки.ПоказыватьАналоги;
