&НаКлиенте
Процедура ДобавитьНоменклатуруВКорзинуПослеВыбораКоличества(Результат, ДополнительныеПараметры) Экспорт 
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	НоваяСтрока = ПараметрыТовара();
	НоваяСтрока.Номенклатура = ДополнительныеПараметры.Номенклатура;
	НоваяСтрока.Цена = Результат.Цена;
	Если ДополнительныеПараметры.СХарактеристикой Тогда
		НоваяСтрока.ХарактеристикаНоменклатуры = ДополнительныеПараметры.ХарактеристикаНоменклатуры;	
	КонецЕсли;
	НоваяСтрока.Количество = Результат.Количество;
	Если НЕ ВАльтернативнойЕдиницеИзмерения Тогда
		НоваяСтрока.ЕдиницаИзмерения = ПолучитьБазовуюЕдиницуИзмерения(НоваяСтрока.Номенклатура);
		НоваяСтрока.Коэффициент = 1;
	Иначе
		НоваяСтрока.ЕдиницаИзмерения = ПолучитьАльтернативнуюЕдиницуИзмерения(НоваяСтрока.Номенклатура);
		НоваяСтрока.Коэффициент = ПолучитьКоэффициентАльтернативнойЕдиницыИзмерения(НоваяСтрока.Номенклатура);
	КонецЕсли;
	НоваяСтрока.Сумма = НоваяСтрока.Цена * НоваяСтрока.Количество;
		
	СтруктураДанные = Новый Структура;
	СтруктураДанные.Вставить("Номенклатура", НоваяСтрока.Номенклатура);
	СтруктураДанные = ОбработкаТабличныхЧастейКлиент.ПолучитьДанныеНоменклатурыПриИзменении(СтруктураДанные);	
	ЗаполнитьЗначенияСвойств(НоваяСтрока, СтруктураДанные, "СтатьяДоходов, СтатьяРасходов");
	
	ДобавитьНоменклатуруВКорзинуЗавершение(НоваяСтрока);
	
КонецПроцедуры
	
&НаКлиенте
Процедура ДобавитьНоменклатуруВКорзинуЗавершение(ПараметрыТовара, СопутствующийТовар = Ложь)
	
	ОчиститьСообщения();
	
	НоваяСтрока = ВыбраннаяНоменклатура.Добавить();
	ЗаполнитьЗначенияСвойств(НоваяСтрока, ПараметрыТовара);	
	
	// #16835
	Если ПодборВРозницу Тогда
		НоваяСтрока.УИСтроки = Строка(Новый УникальныйИдентификатор);
	КонецЕсли;

	СвернутьТаблицуВыбранныхНоменклатур();
	 
	//#2792
	Если ЗначениеЗаполнено(ВидДокументаПроверкиКратности) Тогда
		Для Индекс = 1 По ВыбраннаяНоменклатура.Количество() Цикл
			СтрокаТабличнойЧасти = ВыбраннаяНоменклатура[Индекс-1];
			СтруктураДанные = СтруктураДанныхПоСтрокеТабличнойЧасти(СтрокаТабличнойЧасти, Индекс);
			ОтказВИзмененииКоличества = Ложь;
			КоличествоПриИзмененииНаСервере(СтруктураДанные, ОтказВИзмененииКоличества);
			Если ОтказВИзмененииКоличества Тогда
				СтрокаТабличнойЧасти.Количество = 0;
			КонецЕсли;
			СтрокаТабличнойЧасти.Сумма = СтрокаТабличнойЧасти.Количество * СтрокаТабличнойЧасти.Цена;
		КонецЦикла;
	КонецЕсли;
	
	// №14840
	Если ПредлагатьСопутствующиеТоварыПриПодборе И НЕ СопутствующийТовар Тогда
		
		ПараметрыПодбора = Новый Структура;
		ПараметрыПодбора.Вставить("Номенклатура",				НоваяСтрока.Номенклатура);
		ПараметрыПодбора.Вставить("ХарактеристикаНоменклатуры",	НоваяСтрока.ХарактеристикаНоменклатуры);
		ПараметрыПодбора.Вставить("Количество",					НоваяСтрока.Количество);
		ПараметрыПодбора.Вставить("СФормыПодбора",				Истина);
		
		ОткрытьФорму("РегистрСведений.СопутствующиеТоварыИУслуги.Форма.ФормаПодбора", ПараметрыПодбора, ЭтаФорма, УникальныйИдентификатор);
		
	КонецЕсли;
	
	//++ #16835
	ДобавитьСопутствующиеТовары("Добавление", НоваяСтрока);	
	//-- #16835 
	
КонецПроцедуры

