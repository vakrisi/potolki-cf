Функция ПараметрыТовара() 
	
	ПараметрыТовара = Новый Структура();
	ПараметрыТовара.Вставить("Номенклатура", ПредопределенноеЗначение("Справочник.Номенклатура.ПустаяСсылка"));
	ПараметрыТовара.Вставить("ХарактеристикаНоменклатуры", ПредопределенноеЗначение("Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка"));
	ПараметрыТовара.Вставить("СХарактеристикой", Ложь);
	ПараметрыТовара.Вставить("ЕдиницаИзмерения");
	ПараметрыТовара.Вставить("Количество",0);
	ПараметрыТовара.Вставить("Коэффициент",1);
	ПараметрыТовара.Вставить("Цена",0);
	ПараметрыТовара.Вставить("Сумма",0);
	ПараметрыТовара.Вставить("Фактура", ПредопределенноеЗначение("Справочник.Фактура.ПустаяСсылка"));
	ПараметрыТовара.Вставить("Цвет", ПредопределенноеЗначение("Справочник.ЦветФактуры.ПустаяСсылка"));
	ПараметрыТовара.Вставить("СтатьяРасходов", ПредопределенноеЗначение("Справочник.СтатьиДоходовИРасходов.ПустаяСсылка"));
	ПараметрыТовара.Вставить("СтатьяДоходов", ПредопределенноеЗначение("Справочник.СтатьиДоходовИРасходов.ПустаяСсылка"));
	ПараметрыТовара.Вставить("ЭтоСопутствующийТовар", Ложь);
	
	Возврат ПараметрыТовара;
	
КонецФункции

&НаКлиенте
Процедура ДобавитьНоменклатуруВКорзину(ТекущиеДанные, СХарактеристикой = Ложь)
	
	Если ЗапрашиватьКоличество ИЛИ ЗапрашиватьЦену Тогда 	
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("Номенклатура",			 ТекущиеДанные.НоменклатураСсылка); 
		
		//nva+++                      
		Если ИспользоватьПланирование Тогда
			Если ТекущиеДанные.ОжидаемыйОстаток < 0 Тогда
				ЗапрашиваемоеКоличество = (-1) * ТекущиеДанные.ОжидаемыйОстаток;
			Иначе
				ЗапрашиваемоеКоличество = ТекущиеДанные.ОжидаемыйОстаток;
			КонецЕсли;
			Кратность = ПолучитьКратностьЕдиницыИзмерения(ТекущиеДанные.НоменклатураСсылка, ТекущиеДанные.ЕдиницаИзмерения);
			Если Цел(ЗапрашиваемоеКоличество/Кратность) = ЗапрашиваемоеКоличество/Кратность И ЗапрашиваемоеКоличество <> 0 Тогда 
				ЗапрашиваемоеКоличество = Цел(ЗапрашиваемоеКоличество/Кратность) * Кратность
			Иначе
				ЗапрашиваемоеКоличество = (Цел(ЗапрашиваемоеКоличество/Кратность) + 1) * Кратность;
			КонецЕсли;	
		Иначе
			ЗапрашиваемоеКоличество = 1;
		КонецЕсли;
		//nva---
		ПараметрыФормы.Вставить("Количество",			 ЗапрашиваемоеКоличество);
		Если ЗапрашиватьЦену Тогда
			//nva+++
			ЦенаЗакупки = ПолучитьЦенуЗакупки(ТекущиеДанные);
			Если ЦенаЗакупки = 0 И ЗапрашиватьЦену И ИспользоватьЦеныПоставщиков Тогда
				ЦенаЗакупки = ТекущиеДанные.СписокНоменклатурыЦенаПоставщика;
			КонецЕсли;
			//nva---
			ПараметрыФормы.Вставить("Цена",					 ?(НЕ ИспользоватьЦеныПоставщиков, ТекущиеДанные.Цена, ЦенаЗакупки));//nva	ТекущиеДанные.ЦенаПоставщика		
		КонецЕсли;
