Процедура ЗаполнитьФактуруИЦветПоНоменклатуре(Цвет, Фактура, Номенклатура)
	
	Если Номенклатура.Пустая() Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЦветФактуры.Ссылка,
	|	ЦветФактуры.Владелец
	|ИЗ
	|	Справочник.ЦветФактуры КАК ЦветФактуры
	|ГДЕ
	|	ЦветФактуры.Номенклатура = &Номенклатура";
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Цвет = Выборка.Ссылка;
		Фактура = Выборка.Владелец;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте 
Функция СтруктураДанныхПоСтрокеТабличнойЧасти(СтрокаТабличнойЧасти, НомерСтроки=-1)
	
	СтруктураДанные = Новый Структура;
	СтруктураДанные.Вставить("ИмяТаблицы",			"ВыбраннаяНоменклатура");
	СтруктураДанные.Вставить("ПредставлениеТаблицы","Выбранная номенклатура");
	СтруктураДанные.Вставить("ПолеДанныхПрефикс", 	"");
	СтруктураДанные.Вставить("НомерСтроки",			?(НЕ НомерСтроки=-1, НомерСтроки, ВыбраннаяНоменклатура.Индекс(СтрокаТабличнойЧасти)+1));
	СтруктураДанные.Вставить("Номенклатура",		СтрокаТабличнойЧасти.Номенклатура);
	СтруктураДанные.Вставить("ХарактеристикаНоменклатуры", СтрокаТабличнойЧасти.ХарактеристикаНоменклатуры);
	СтруктураДанные.Вставить("ЕдиницаИзмерения", 	СтрокаТабличнойЧасти.ЕдиницаИзмерения);
	СтруктураДанные.Вставить("Количество", 			СтрокаТабличнойЧасти.Количество);
	СтруктураДанные.Вставить("Дата", 				ТекущаяДата());
	СтруктураДанные.Вставить("ВидЦен", 				ВидЦены);
	СтруктураДанные.Вставить("Валюта", 				Валюта);
	СтруктураДанные.Вставить("Организация",			Организация);
	//СтруктураДанные.Вставить("Подразделение",		Объект.Подразделение);
	СтруктураДанные.Вставить("Контрагент",			Контрагент);
	СтруктураДанные.Вставить("ДоговорКонтрагента", 	ДоговорКонтрагента);

	Возврат СтруктураДанные;
	
КонецФункции

&НаСервере
Функция ПолучитьДанныеНоменклатурыПриИзменении(СтруктураДанные)
	
	СтруктураДанные.Вставить("Цена", ПолучитьЦенуНоменклатуры(СтруктураДанные.Номенклатура, СтруктураДанные.ХарактеристикаНоменклатуры, СтруктураДанные.ЕдиницаИзмерения, СтруктураДанные.Количество));
	
	Возврат СтруктураДанные;
	
КонецФункции

&НаСервере
Функция ПолучитьЦенуНоменклатуры(Номенклатура, ХарактеристикаНоменклатуры = Неопределено, ЕдиницаИзмерения = Неопределено, Количество = 1)
													
	Возврат ЦеныКомпании.ПолучитьЦенуНоменклатуры(Номенклатура, ХарактеристикаНоменклатуры, ЕдиницаИзмерения, Количество,
												ДатаЦен, ВидЦены, Валюта, 												 
												ОрганизацияЦены, Подразделение, 
												Контрагент, ДоговорКонтрагента);
												
КонецФункции

//++ №14840
&НаКлиенте
Процедура ОбработкаПодбораСопутствующихТоваров(ВыбранноеЗначение)
	
	Если Не ЗначениеЗаполнено(ВыбранноеЗначение) Тогда
		Возврат;
	КонецЕсли;
	
	МассивТоваров = ПолучитьСопутствующиеТоварыИзВременногоХранилища(ВыбранноеЗначение.АдресВХранилище);
	
	Для Каждого ТекущаяСтрока из МассивТоваров Цикл
		
		НоваяСтрока = ПараметрыТовара();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущаяСтрока);
		
		СтруктураДанные = Новый Структура;
		СтруктураДанные.Вставить("Номенклатура", НоваяСтрока.Номенклатура);
		СтруктураДанные = ОбработкаТабличныхЧастейКлиент.ПолучитьДанныеНоменклатурыПриИзменении(СтруктураДанные);	
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтруктураДанные, "СтатьяДоходов, СтатьяРасходов");
		
		НоваяСтрока.ЭтоСопутствующийТовар = Истина;
		
		ДобавитьНоменклатуруВКорзинуЗавершение(НоваяСтрока, Истина);
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьСопутствующиеТоварыИзВременногоХранилища(АдресВХранилище)
	
	ТаблицаТоваров = ПолучитьИзВременногоХранилища(АдресВХранилище);
	
	Для Каждого ТекущаяСтрока Из ТаблицаТоваров Цикл
		
		ТекущаяСтрока.Цена = РегистрыСведений.ЦеныНоменклатуры.ПолучитьЦенуНоменклатуры(
			ТекущаяСтрока.Номенклатура,
			ТекущаяСтрока.ХарактеристикаНоменклатуры,
			ТекущаяСтрока.ЕдиницаИзмерения,
			ТекущаяДатаСеанса(),
			ВидЦены,
			Валюта,
			Контрагент,
			ДоговорКонтрагента
		);
		
		ТекущаяСтрока.Сумма = ТекущаяСтрока.Цена * ТекущаяСтрока.Количество;
																		   
	КонецЦикла;
	
	Возврат ОбщегоНазначения.ТаблицаЗначенийВМассив(ТаблицаТоваров);
	
КонецФункции
